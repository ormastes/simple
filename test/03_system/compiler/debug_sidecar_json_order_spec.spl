"""
## Purpose and audience
For hardware/RTL engineers verifying the MDSOC capsule reorganization did not
disturb the `*.debug.json` sidecar contract emitted by the FPGA Linux
generation scripts. The `debug_sidecar_json` function in
`fpga_linux_manifest.spl` emits JSON via string concatenation in literal
source order — this is an immutable contract, no serializer, no key
shuffling allowed.
## Operator workflow
Run `./src/compiler_rust/target/bootstrap/simple run
test/03_system/compiler/debug_sidecar_json_order_spec.spl`. The first
describe block (source contract) always runs against the tracked manifest
source; the generated-output and baseline-comparison blocks additionally need
the SA-3 split build output and the SA-1 baseline respectively.
## Compatibility and limitations
`src/hardware/fpga_linux/fpga_linux_manifest.spl` and
`fpga_linux_orchestrator.spl` do not exist in this tree yet (SA-3 has not
split them out) — every scenario in the source-contract block is a real,
currently-failing assertion documenting that gap, not a placeholder.
Generated-output scenarios likewise fail closed (never silently pending)
until `build/rtl_linux/generated_rv32`/`generated_rv64` exist.
## Verification guidance and troubleshooting
A failure names the missing file/dir or the out-of-order key. Re-run after
SA-3 lands the split manifest/orchestrator files or after a real build
populates the generated directories.
"""
# Lifecycle: doc/01_research/hardware/riscv/riscv_fpga_linux.md ;
# doc/03_plan/hardware/riscv/riscv_fpga_linux_rtl_completion.md ;
# doc/04_architecture/hardware/riscv/riscv_fpga_linux.md ;
# doc/05_design/app/riscv/rtl_riscv_mdsoc_capsules.md
# @manual_section: debug_sidecar_json_key_order
# @cover src/hardware/fpga_linux/fpga_linux_manifest.spl 80%
# @cover src/compiler/35.semantics/lint/riscv_rtl_debuggability_lint.spl 80%
#
# Debug Sidecar JSON Key-Order Specification
#
# Feature IDs: #rtl-mdsoc-reorg
# Category: Infrastructure
# Requirements: doc/02_requirements/feature/rtl_riscv_mdsoc_reorg.md
# Design: doc/05_design/app/riscv/rtl_riscv_mdsoc_capsules.md
# Artifacts: doc/09_report/verify/rtl_mdsoc_baseline_2026-05-02.md
#
# Key Order Contract (AC-3, D-4): the generated debug.json sidecar must emit
# reportMarkers, then runnerSuccessMarkers, then sourceMap, then proofLane
# (header field), in that literal source order.
#
# Acceptance Criteria
# - AC-3: *.debug.json sidecar contract preserved (reportMarkers,
#   runnerSuccessMarkers byte-equivalent)
# - AC-8: Verify in interpreter mode

use std.spec.{describe, it, expect, step}

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_text(path: text) -> text?
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn check_msg(condition: bool, msg: text):
    if not condition:
        expect(msg).to_equal("")

fn read_file(path: text) -> text:
    rt_file_read_text(path) ?? ""

fn baseline_path() -> text:
    "doc/09_report/verify/rtl_mdsoc_baseline_2026-05-02.md"

fn rv32_build_dir() -> text:
    "build/rtl_linux/generated_rv32"

fn rv64_build_dir() -> text:
    "build/rtl_linux/generated_rv64"

fn manifest_src_path() -> text:
    "src/hardware/fpga_linux/fpga_linux_manifest.spl"

fn orchestrator_src_path() -> text:
    "src/hardware/fpga_linux/fpga_linux_orchestrator.spl"

fn json_key_byte_offset(file_path: text, key: text) -> i64:
    # Use grep to find the byte offset of `"key":` in file_path.
    # Returns -1 if not found or on error.
    val search = "\"" + key + "\":"
    val cmd = "grep -boa '" + search + "' '" + file_path + "' 2>/dev/null | head -1 | cut -d: -f1"
    val (stdout, _stderr, code) = rt_process_run("sh", ["-c", cmd])
    if code != 0:
        return -1
    val trimmed = stdout.trim()
    if trimmed == "":
        return -1
    trimmed.to_i64() ?? -1

fn source_key_offset(key: text) -> i64:
    # Find byte offset of `"key":` in fpga_linux_manifest.spl source.
    val path = manifest_src_path()
    if not rt_file_exists(path):
        return -1
    json_key_byte_offset(path, key)

fn find_first_debug_json(dir: text) -> text:
    # Returns the path of the first *.debug.json file found in dir, or "".
    val cmd = "find '" + dir + "' -name '*.debug.json' 2>/dev/null | sort | head -1"
    val (stdout, _stderr, _code) = rt_process_run("sh", ["-c", cmd])
    stdout.trim()

fn debug_json_key_offset(dir: text, key: text) -> i64:
    # Find byte offset of key in first debug.json under dir. Returns -1 if absent.
    val json_path = find_first_debug_json(dir)
    if json_path == "":
        return -1
    json_key_byte_offset(json_path, key)

describe "Debug Sidecar JSON Key Order: source contract (AC-3, D-4)":
    """
    ## JSON Key-Order Source Contract

    Verifies that the manifest source file (fpga_linux_manifest.spl)
    contains `reportMarkers` before `runnerSuccessMarkers` before `sourceMap`
    in the `debug_sidecar_json` function body.
    These are static text-grep assertions that do not require SA-1 baseline.
    """

    it "AC-3: fpga_linux_manifest.spl contains reportMarkers key string":
        # @req REQ-DBGJ-001
        # @capture(bit_table): whether the manifest source contains the reportMarkers key literal
        step("Read the manifest source and search for the reportMarkers key literal")
        val path = manifest_src_path()
        # NOTE: genuine pre-existing failure — src/hardware/fpga_linux/
        # fpga_linux_manifest.spl does not exist in this tree yet (SA-3 split
        # not run). Confirmed absent 2026-09-06. Left RED per testing rules.
        check_msg(rt_file_exists(path), "file not found (SA-3 not run yet): " + path)
        val content = read_file(path)
        val has_key = content.contains("reportMarkers")
        expect(has_key).to_equal(true)

    it "AC-3: fpga_linux_manifest.spl contains runnerSuccessMarkers key string":
        # @req REQ-DBGJ-002
        # @capture(bit_table): whether the manifest source contains the runnerSuccessMarkers key literal
        step("Read the manifest source and search for the runnerSuccessMarkers key literal")
        val path = manifest_src_path()
        # NOTE: same genuine pre-existing manifest-file-absent failure as
        # debug_sidecar_json_order_spec.spl:131 above — see that NOTE.
        check_msg(rt_file_exists(path), "file not found (SA-3 not run yet): " + path)
        val content = read_file(path)
        val has_key = content.contains("runnerSuccessMarkers")
        expect(has_key).to_equal(true)

    it "AC-3: reportMarkers appears before runnerSuccessMarkers in manifest source":
        # @req REQ-DBGJ-003
        # @capture(bit_table): the byte offsets of the two keys, compared
        step("Compare the byte offsets of reportMarkers and runnerSuccessMarkers in the manifest source")
        val path = manifest_src_path()
        # NOTE: same genuine pre-existing manifest-file-absent failure as
        # debug_sidecar_json_order_spec.spl:131 above — see that NOTE.
        check_msg(rt_file_exists(path), "file not found (SA-3 not run yet): " + path)
        val pos_report = source_key_offset("reportMarkers")
        val pos_runner = source_key_offset("runnerSuccessMarkers")
        check_msg(pos_report >= 0, "reportMarkers not found in manifest source")
        check_msg(pos_runner >= 0, "runnerSuccessMarkers not found in manifest source")
        check_msg(pos_report < pos_runner, "reportMarkers must appear before runnerSuccessMarkers in source")
        expect(pos_report).to_be_less_than(pos_runner)

    it "AC-3: sourceMap appears after runnerSuccessMarkers in manifest source":
        # @req REQ-DBGJ-004
        # @capture(bit_table): the byte offsets of runnerSuccessMarkers and sourceMap, compared
        step("Compare the byte offsets of runnerSuccessMarkers and sourceMap in the manifest source")
        val path = manifest_src_path()
        # NOTE: same genuine pre-existing manifest-file-absent failure as
        # debug_sidecar_json_order_spec.spl:131 above — see that NOTE.
        check_msg(rt_file_exists(path), "file not found (SA-3 not run yet): " + path)
        val pos_runner = source_key_offset("runnerSuccessMarkers")
        val pos_source_map = source_key_offset("sourceMap")
        check_msg(pos_runner >= 0, "runnerSuccessMarkers not found in manifest source")
        check_msg(pos_source_map >= 0, "sourceMap not found in manifest source")
        check_msg(pos_runner < pos_source_map, "runnerSuccessMarkers must appear before sourceMap in source")
        expect(pos_runner).to_be_less_than(pos_source_map)

    it "AC-3: D-4 invariant — no json_ helper functions exist outside fpga_linux_manifest.spl":
        # @req REQ-DBGJ-005
        # @capture(bit_table): whether the orchestrator source defines any json_ helper function
        step("Read the orchestrator source and search for a forbidden json_ helper definition")
        # The D-4 decision states all json_* helpers live exclusively in
        # fpga_linux_manifest.spl. Verify that fpga_linux_orchestrator.spl
        # does not contain json_ helper definitions.
        val path = orchestrator_src_path()
        # NOTE: genuine pre-existing failure — src/hardware/fpga_linux/
        # fpga_linux_orchestrator.spl does not exist in this tree yet (SA-3
        # split not run). Confirmed absent 2026-09-06. Left RED per testing
        # rules.
        check_msg(rt_file_exists(path), "file not found (SA-3 not run yet): " + path)
        val content = read_file(path)
        val has_json_helper = content.contains("fn json_")
        check_msg(not has_json_helper, "D-4 violation: json_ helper defined in orchestrator, must be in manifest only")
        expect(has_json_helper).to_equal(false)

describe "Debug Sidecar JSON Key Order: generated output (AC-3)":
    """
    ## Generated JSON Key Order in Build Output

    Tests that parse actual generated *.debug.json files from the build
    directory and verify key ordering. Every scenario here is a real,
    fail-closed assertion — none of them is masked behind a pending()
    placeholder, so each stays genuinely RED until SA-1 baseline exists and
    the SA-3 split build actually produces the directory it inspects.
    """

    it "AC-3: RV32 generated debug.json key-order check is pending until SA-3 complete":
        # @req REQ-DBGJ-006
        # @capture(bit_table): whether the RV32 generated build directory exists yet
        step("Check whether the RV32 split-build output directory exists")
        # NOTE: genuine pre-existing gap, converted from a pending() scaffold
        # to a real fail-closed tripwire 2026-09-06 (a pending marker can
        # never itself be the oracle — see .spipe skill checklist SSDOC-ORA-001).
        # Confirmed absent: build/rtl_linux/generated_rv32 does not exist.
        # Turns green automatically once SA-3 populates it.
        expect(rt_file_exists(rv32_build_dir())).to_equal(true)

    it "AC-3: RV32 generated debug.json has reportMarkers key":
        # @req REQ-DBGJ-007
        # @capture(bit_table): the byte offset of reportMarkers in the first generated RV32 debug.json
        step("Search the first RV32 generated debug.json for the reportMarkers key")
        # NOTE: same genuine pre-existing RV32-build-dir-absent failure as
        # debug_sidecar_json_order_spec.spl:189 above — see that NOTE.
        val pos = debug_json_key_offset(rv32_build_dir(), "reportMarkers")
        check_msg(pos >= 0, "reportMarkers missing from generated debug.json in " + rv32_build_dir())
        expect(pos).to_be_greater_than(-1)

    it "AC-3: RV32 generated debug.json has runnerSuccessMarkers key":
        # @req REQ-DBGJ-008
        # @capture(bit_table): the byte offset of runnerSuccessMarkers in the first generated RV32 debug.json
        step("Search the first RV32 generated debug.json for the runnerSuccessMarkers key")
        # NOTE: same genuine pre-existing RV32-build-dir-absent failure as
        # debug_sidecar_json_order_spec.spl:189 above — see that NOTE.
        val pos = debug_json_key_offset(rv32_build_dir(), "runnerSuccessMarkers")
        check_msg(pos >= 0, "runnerSuccessMarkers missing from generated debug.json in " + rv32_build_dir())
        expect(pos).to_be_greater_than(-1)

    it "AC-3: RV32 generated debug.json reportMarkers precedes runnerSuccessMarkers":
        # @req REQ-DBGJ-009
        # @capture(bit_table): the compared byte offsets of both keys in the first generated RV32 debug.json
        step("Compare the byte offsets of reportMarkers and runnerSuccessMarkers in the first RV32 generated debug.json")
        # NOTE: same genuine pre-existing RV32-build-dir-absent failure as
        # debug_sidecar_json_order_spec.spl:189 above — see that NOTE.
        val pos_report = debug_json_key_offset(rv32_build_dir(), "reportMarkers")
        val pos_runner = debug_json_key_offset(rv32_build_dir(), "runnerSuccessMarkers")
        check_msg(pos_report >= 0, "reportMarkers not found in generated json")
        check_msg(pos_runner >= 0, "runnerSuccessMarkers not found in generated json")
        expect(pos_report).to_be_less_than(pos_runner)

    it "AC-3: RV64 generated debug.json key-order check is pending until SA-3 complete":
        # @req REQ-DBGJ-010
        # @capture(bit_table): whether the RV64 generated build directory exists yet
        step("Check whether the RV64 split-build output directory exists")
        # NOTE: genuine pre-existing gap, converted from a pending() scaffold
        # to a real fail-closed tripwire 2026-09-06 — same rationale as
        # debug_sidecar_json_order_spec.spl:189 above. Confirmed absent:
        # build/rtl_linux/generated_rv64 does not exist. Turns green
        # automatically once SA-3 populates it.
        expect(rt_file_exists(rv64_build_dir())).to_equal(true)

    it "AC-3: RV64 generated debug.json has reportMarkers key":
        # @req REQ-DBGJ-011
        # @capture(bit_table): the byte offset of reportMarkers in the first generated RV64 debug.json
        step("Search the first RV64 generated debug.json for the reportMarkers key")
        # NOTE: same genuine pre-existing RV64-build-dir-absent failure as
        # debug_sidecar_json_order_spec.spl:222 above — see that NOTE.
        val pos = debug_json_key_offset(rv64_build_dir(), "reportMarkers")
        check_msg(pos >= 0, "reportMarkers missing from generated debug.json in " + rv64_build_dir())
        expect(pos).to_be_greater_than(-1)

    it "AC-3: RV64 generated debug.json reportMarkers precedes runnerSuccessMarkers":
        # @req REQ-DBGJ-012
        # @capture(bit_table): the compared byte offsets of both keys in the first generated RV64 debug.json
        step("Compare the byte offsets of reportMarkers and runnerSuccessMarkers in the first RV64 generated debug.json")
        # NOTE: same genuine pre-existing RV64-build-dir-absent failure as
        # debug_sidecar_json_order_spec.spl:222 above — see that NOTE.
        val pos_report = debug_json_key_offset(rv64_build_dir(), "reportMarkers")
        val pos_runner = debug_json_key_offset(rv64_build_dir(), "runnerSuccessMarkers")
        check_msg(pos_report >= 0, "reportMarkers not found in generated json")
        check_msg(pos_runner >= 0, "runnerSuccessMarkers not found in generated json")
        expect(pos_report).to_be_less_than(pos_runner)

describe "Debug Sidecar JSON Order: baseline comparison (AC-3)":
    """
    ## Baseline sha256 Comparison for Sidecar Files

    Compares sha256 of generated debug.json files against the SA-1 baseline.
    """

    it "AC-3: debug.json sha256 comparison is pending until SA-1 baseline exists":
        # @req REQ-DBGJ-013
        # @capture(bit_table): whether both RV32 and RV64 generated build directories exist for sha256 comparison
        step("Check whether both split-build output directories exist for a real sha256 comparison")
        # NOTE: genuine pre-existing gap, converted from a pending() scaffold
        # to a real fail-closed tripwire 2026-09-06 — same rationale as
        # debug_sidecar_json_order_spec.spl:189 above. The SA-1 baseline
        # document itself already exists (doc/09_report/verify/
        # rtl_mdsoc_baseline_2026-05-02.md, confirmed present 2026-09-06);
        # what remains missing is the generated build output to compare
        # against it. Turns green automatically once SA-3 populates both dirs.
        expect(rt_file_exists(rv32_build_dir()) and rt_file_exists(rv64_build_dir())).to_equal(true)

    it "AC-3: baseline contains debug.json section when present":
        # @req REQ-DBGJ-014
        # @capture(bit_table): whether the SA-1 baseline document's text mentions debug.json
        step("Read the SA-1 baseline document and search for a debug.json section")
        val path = baseline_path()
        check_msg(rt_file_exists(path), "file not found: " + path)
        val baseline = read_file(path)
        val has_json_section = baseline.contains("debug.json")
        check_msg(has_json_section, "baseline missing debug.json section — SA-1 must record sidecar sha256")
        expect(has_json_section).to_equal(true)
