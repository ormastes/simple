# @req REQ-R8KC-004 REQ-R8KC-006 NFR-R8KC-004 NFR-R8KC-006
# @evidence-display: links
# codex-system-test

"""
# Render 8K80 A1 adapter attribution

## Purpose and audience

This system specification protects the completed A1 physical-adapter
attribution criterion. It is for rendering operators and reviewers who must
distinguish stable device identity from physical-display or scanout proof.

## Preconditions

- Run from the repository root with an admitted pure-Simple CLI.
- `sh`, `grep`, and the checked-in render wrappers must be available.
- GPU hardware and an 8K display are not required for these bounded contract
  scenarios.

## Operator workflow

1. Run the real physical-wrapper self-test and require its positive and
   deliberate-red identity-correlation matrix to pass.
2. Read the durable report and acceptance ledger, then bind the exact RTX
   A6000 fingerprint to stable selected-device identity hash `666008366`.
3. Confirm A6 and A8 remain open and Xvfb remains inadmissible as physical
   display or scanout evidence.
4. Force an unreachable display and require the production wrapper to return
   the typed blocked result rather than PASS.

## Compatibility and limitations

This specification proves A1 attribution and fail-closed classification. It
does not prove A4/A5 performance, a physical 8K80 mode, presentation, or
captured scanout. Runtime execution, docgen, and maintenance evidence remain
`TEST_BLOCKED` until an admitted pure-Simple CLI is available.
"""

use std.io_runtime.{file_read, process_run}
use std.spec.*

val A1_PLAN = "doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md"
val A1_REPORT = "doc/09_report/engine2d_vulkan_clear_8k_evidence_2026-08-12.md"
val PHYSICAL_WRAPPER = "scripts/check/check-render-perf-physical-8k80-hardware.shs"

describe "Render 8K80 A1 adapter attribution":

    # @req REQ-R8KC-004 REQ-R8KC-006 NFR-R8KC-004 NFR-R8KC-006
    it "should verify the durable adapter identity through the real wrapper self-test":
        step("Run the physical-wrapper identity correlation self-test")
        val (stdout, stderr, code) = process_run(
            "/bin/sh", [PHYSICAL_WRAPPER, "--self-test"])
        expect(code).to_equal(0)
        expect(stdout).to_contain("engine2d_vulkan_window_8k_selftest=pass")
        expect(stdout).to_contain("render_perf_physical_8k80_hardware_selftest=pass")
        expect(stderr).to_equal("")

        step("Bind the exact adapter fingerprint to its stable selected-device identity")
        val report = file_read(A1_REPORT)
        expect(report).to_contain("NVIDIA RTX A6000")
        expect(report).to_contain("vendor=000010de")
        expect(report).to_contain("device=00002230")
        expect(report).to_contain("driver `911f8400`")
        expect(report).to_contain("identity hash: `666008366`.")

    # @req REQ-R8KC-004 REQ-R8KC-006 NFR-R8KC-004 NFR-R8KC-006
    it "should keep adapter attribution separate from physical display promotion":
        step("Read the canonical A1 through A8 acceptance ledger")
        val plan = file_read(A1_PLAN)
        expect(plan).to_contain("- [x] **A1 — physical adapter attribution:**")
        expect(plan).to_contain("selected-device identity hash `666008366`")

        step("Confirm the physical presentation and display rows remain open")
        expect(plan).to_contain("- [ ] **A6 — physical presentation:**")
        expect(plan).to_contain("- [ ] **A8 — physical 80 Hz display evidence:**")
        expect(plan).to_contain(
            "Xvfb remains inadmissible as physical-display or scanout evidence")

        step("Confirm the durable report preserves the same scope boundary")
        val report = file_read(A1_REPORT)
        expect(report).to_contain("closes adapter attribution only")
        expect(report).to_contain(
            "does not\npromote Xvfb to physical-display or scanout evidence")

    # @req REQ-R8KC-004 REQ-R8KC-006 NFR-R8KC-004 NFR-R8KC-006
    it "should report a typed blocker when the physical display is unreachable":
        step("Invoke the production wrapper with a deliberately unreachable display")
        val command = "DISPLAY=render-8k80-a1-unreachable sh " + PHYSICAL_WRAPPER
        val (stdout, _stderr, code) = process_run("/bin/sh", ["-c", command])

        step("Require blocked classification instead of a fabricated pass")
        expect(code).to_equal(2)
        expect(stdout).to_contain("render_perf_physical_8k80_hardware_status=blocked")
        expect(stdout).to_contain("todo=TODO684")
        expect(stdout).to_contain("reason=physical-x11-display-unreachable")
