# @tag: sys, wm_compare, emulated, screenshot, bitwise

"""
## Purpose and audience
Purpose: returns a screenshot-shaped pixel buffer for a corpus sample
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-GUI-EmulCapt-001

use std.spec.{describe, context, it, expect}
use app.wm_compare.emulated_capture.{
    capture_simple_web_emulated,
    capture_engine2d_software_emulated,
    compare_emulated_screenshots_exact}
use app.wm_compare.site_corpus.{build_famous_site_sample_corpus}

use std.spec.step
describe "wm_compare emulated screenshot capture":

    context "Simple Web Renderer capture":

        it "returns a screenshot-shaped pixel buffer for a corpus sample":
            step("Verify: returns a screenshot-shaped pixel buffer for a corpus sample")
            # @req: REQ-GUI-EmulCapt-001
            val sample = build_famous_site_sample_corpus()[0]
            val result = capture_simple_web_emulated(sample.html, 40, 30)
            expect(result.success).to_equal(true)
            expect(result.width).to_equal(40)  # oracle: value fixed by the spec contract
            expect(result.height).to_equal(30)  # oracle: value fixed by the spec contract
            expect(result.pixels.len()).to_equal(40 * 30)

        it "rejects invalid viewport dimensions":
            step("Verify: rejects invalid viewport dimensions")
            # @req: REQ-GUI-EmulCapt-001
            val sample = build_famous_site_sample_corpus()[0]
            val result = capture_simple_web_emulated(sample.html, 0, 30)
            expect(result.success).to_equal(false)
            expect(result.error).to_contain("invalid viewport dimensions")

    context "Engine2D software capture":

        it "returns the deterministic software backend result":
            step("Verify: returns the deterministic software backend result")
            # @req: REQ-GUI-EmulCapt-001
            val sample = build_famous_site_sample_corpus()[44]
            val result = capture_engine2d_software_emulated(sample.html, 40, 30)
            expect(result.success).to_equal(true)
            expect(result.backend_name).to_equal("engine2d_software_emulated")
            expect(result.pixels.len()).to_equal(40 * 30)

    context "bitwise comparison":

        it "compares Simple and Engine2D emulated screenshots exactly":
            step("Verify: compares Simple and Engine2D emulated screenshots exactly")
            # @req: REQ-GUI-EmulCapt-001
            val sample = build_famous_site_sample_corpus()[99]
            val cmp = compare_emulated_screenshots_exact(sample.html, 40, 30)
            expect(cmp.different_pixels).to_equal(0)  # oracle: value fixed by the spec contract
            expect(cmp.match_percentage).to_equal(10000)  # oracle: value fixed by the spec contract

        it "does not report capture failures as exact matches":
            step("Verify: does not report capture failures as exact matches")
            # @req: REQ-GUI-EmulCapt-001
            val sample = build_famous_site_sample_corpus()[99]
            val cmp = compare_emulated_screenshots_exact(sample.html, 0, 30)
            expect(cmp.different_pixels).to_be_greater_than(0)
            expect(cmp.match_percentage).to_equal(0)  # oracle: value fixed by the spec contract
