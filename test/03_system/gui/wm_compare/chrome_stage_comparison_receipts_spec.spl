# @tag: sys, wm_compare, chrome_parity, comparison_integrity
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl 20%
#
# Per-stage Simple<->Chrome comparison receipts.
#
# Contract: doc/04_architecture/ui/chrome_stage_correspondence.md
#
# Two of these examples assert that Simple's layout stage MATCHES Chrome's
# recorded geometry. The rest assert something the matching examples cannot:
# that when a match is reported, a comparison actually HAPPENED.
#
# The failure this guards is specific and was reproduced in this tree. A Draw IR
# composition truncated by budget exhaustion holds exactly one command -- the
# canvas rect, which is emitted unconditionally -- because layout zeroes bw/bh
# for every subtree it did not reach and the paint walk then treats every such
# node as invisible. That composition is well-formed and is shaped exactly like
# a successful render of an empty document. Diffing it against Chrome produces a
# confident "layout mismatch" for a render that never laid anything out; and had
# the Chrome box ever been absent or zero, the two would have compared EQUAL and
# this file would have passed while measuring nothing.
#
# Every degraded case below is produced DELIBERATELY, by arming a 1ms render
# budget through SIMPLE_WEB_RENDER_BUDGET_MS, which _web_budget_begin re-reads on
# every render. Nothing here waits for a truncation to happen by chance.

use std.spec.{describe, it, expect}
use app.wm_compare.site_corpus.{
    build_famous_site_sample_corpus,
    famous_site_sample_chrome_metrics_path}
use app.wm_compare.site_corpus_layout_report.{
    site_corpus_simple_div,
    site_corpus_chrome_div_box,
    build_site_corpus_div_geometry_report}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir_result,
    simple_web_layout_draw_ir_comparable,
    simple_web_layout_draw_ir_compare_decision}
use std.nogc_sync_mut.io.file_ops.{file_exists, file_read_text}
use std.nogc_sync_mut.io_runtime.{env_set}

# Budget large enough that a complete render finishes inside it. Also used to
# warm the font cache: the FIRST render in a process pays a one-time default-face
# load (dlopen + TTF parse) that is charged against the render budget, so a cold
# render can trip its deadline where an identical warm one does not. That is a
# real open defect, recorded in the contract doc; these examples warm explicitly
# rather than depending on execution order to hide it.
val COMPLETE_BUDGET_MS: text = "600000"
# Small enough that any real render trips it during the style/layout walk.
val EXHAUSTED_BUDGET_MS: text = "1"

fn _warm_render_cache():
    env_set("SIMPLE_WEB_RENDER_BUDGET_MS", COMPLETE_BUDGET_MS)
    val sample = build_famous_site_sample_corpus()[0]
    simple_web_layout_render_html_draw_ir_result(sample.html, 160, 120)

describe "Chrome per-stage comparison receipts":

    it "reports a comparable display list when the render completes":
        _warm_render_cache()
        val sample = build_famous_site_sample_corpus()[0]
        val result = simple_web_layout_render_html_draw_ir_result(sample.html, 160, 120)
        expect(simple_web_layout_draw_ir_comparable(result)).to_equal(true)
        expect(simple_web_layout_draw_ir_compare_decision(result)).to_equal(
            "draw-ir:comparable:full-display-list:reason=budget-complete")

    it "declines to compare a budget-truncated display list and names the phase":
        # The anti-vacuity proof, produced on purpose. Without this the receipt
        # fields below could be constants and no example would notice.
        _warm_render_cache()
        env_set("SIMPLE_WEB_RENDER_BUDGET_MS", EXHAUSTED_BUDGET_MS)
        val sample = build_famous_site_sample_corpus()[0]
        val result = simple_web_layout_render_html_draw_ir_result(sample.html, 160, 120)
        val decision = simple_web_layout_draw_ir_compare_decision(result)
        env_set("SIMPLE_WEB_RENDER_BUDGET_MS", COMPLETE_BUDGET_MS)
        expect(simple_web_layout_draw_ir_comparable(result)).to_equal(false)
        expect(decision).to_contain("draw-ir:declined:compared=none:reason=budget-exhausted:")
        # A decline must name the budget site, not merely declare failure. An
        # unattributed exit is how exhaustion became invisible in the first place.
        expect(decision.len()).to_be_greater_than(
            "draw-ir:declined:compared=none:reason=budget-exhausted:".len())

    it "states comparison_ran: true only when the display list carried the div":
        _warm_render_cache()
        val sample = build_famous_site_sample_corpus()[0]
        val metrics_path = famous_site_sample_chrome_metrics_path(sample.id)
        expect(file_exists(metrics_path)).to_equal(true)
        val simple = site_corpus_simple_div(sample, 160, 120)
        expect(simple.comparable).to_equal(true)
        expect(simple.div_present).to_equal(true)
        val report = build_site_corpus_div_geometry_report(
            sample, file_read_text(metrics_path), 160, 120)
        expect(report).to_contain("site_corpus_div_geometry")
        expect(report).to_contain("simple_draw_ir_comparable: true")
        expect(report).to_contain("simple_div_present: true")
        expect(report).to_contain("comparison_ran: true")

    it "states comparison_ran: false when the render was truncated":
        # Same report builder, same fixture, same Chrome sidecar -- only the
        # budget differs. If the receipt were hardcoded this example fails.
        _warm_render_cache()
        val sample = build_famous_site_sample_corpus()[0]
        val metrics = file_read_text(famous_site_sample_chrome_metrics_path(sample.id))
        env_set("SIMPLE_WEB_RENDER_BUDGET_MS", EXHAUSTED_BUDGET_MS)
        val report = build_site_corpus_div_geometry_report(sample, metrics, 160, 120)
        env_set("SIMPLE_WEB_RENDER_BUDGET_MS", COMPLETE_BUDGET_MS)
        expect(report).to_contain("comparison_ran: false")
        expect(report).to_contain("simple_draw_ir_comparable: false")
        expect(report).to_contain("reason=budget-exhausted:")

    it "never presents an absent div as a real zero-sized box":
        # The all-zero fallback box is byte-identical to a genuine 0x0 div.
        # `div_present` is the only field that separates them.
        _warm_render_cache()
        env_set("SIMPLE_WEB_RENDER_BUDGET_MS", EXHAUSTED_BUDGET_MS)
        val sample = build_famous_site_sample_corpus()[0]
        val simple = site_corpus_simple_div(sample, 160, 120)
        env_set("SIMPLE_WEB_RENDER_BUDGET_MS", COMPLETE_BUDGET_MS)
        expect(simple.div_present).to_equal(false)
        expect(simple.box.width).to_equal(0)
        expect(simple.box.height).to_equal(0)
        expect(simple.box.background_color).to_equal("")

    it "matches Chrome's recorded div geometry exactly when the render completes":
        # The actual per-stage LAYOUT comparison. Equivalence is exact integers:
        # the fixture's div carries explicit integral px width/height, so its
        # used geometry is fully determined by CSS 2.1 box rules with no font
        # dependence. A tolerance here would be tolerance for a layout bug.
        # Chrome's values come from the committed sidecar, never from Simple.
        _warm_render_cache()
        val sample = build_famous_site_sample_corpus()[0]
        val metrics = file_read_text(famous_site_sample_chrome_metrics_path(sample.id))
        val chrome_box = site_corpus_chrome_div_box(metrics)
        val simple = site_corpus_simple_div(sample, 160, 120)
        expect(simple.comparable).to_equal(true)
        expect(simple.div_present).to_equal(true)
        expect(simple.box.x).to_equal(chrome_box.x)
        expect(simple.box.y).to_equal(chrome_box.y)
        expect(simple.box.width).to_equal(chrome_box.width)
        expect(simple.box.height).to_equal(chrome_box.height)
        expect(simple.box.background_color).to_equal(chrome_box.background_color)

    it "pins the Chrome baseline as a captured artifact, not a computed one":
        # Guards the rule this campaign exists under: never fabricate a Chrome
        # baseline. Every Chrome value must come from the committed sidecar, so
        # the sidecar's presence and shape are load-bearing.
        val sample = build_famous_site_sample_corpus()[0]
        val metrics_path = famous_site_sample_chrome_metrics_path(sample.id)
        expect(file_exists(metrics_path)).to_equal(true)
        val metrics = file_read_text(metrics_path)
        expect(metrics).to_contain("\"canvasTextMetrics\"")
        val chrome_box = site_corpus_chrome_div_box(metrics)
        expect(chrome_box.width).to_equal(120)
        expect(chrome_box.height).to_equal(40)
        expect(chrome_box.background_color).to_equal("rgb(37, 99, 235)")
