# reftest_spec — Chromium parity reftest suite, Phase 8 drawing-stack
# @cover src/lib/skia/entity/picture.spl 20%

use std.spipe.*
use std.skia.entity.picture.{SkPicture, SkPictureRecorder, SkPictureOp, sk_picture_op_draw_rect}
use std.skia.entity.paint.{SkPaint, sk_paint_fill}
use std.skia.entity.color.{sk_color_argb}
use std.skia.entity.geometry.{SkRect}
use test.system.reftest.parity.harness.{ReftestHarness, SceneManifest, scene_signature, reftest_harness_new}
use test.system.reftest.parity.pixel_diff.{compare_pictures, PixelDiffResult}
use test.system.reftest.parity.scenes.path_winding.{scene as winding_scene}
use test.system.reftest.parity.scenes.path_evenodd.{scene as evenodd_scene}
use test.system.reftest.parity.scenes.dashed_strokes.{scene as dashed_scene}
use test.system.reftest.parity.scenes.gradient_linear.{scene as gradient_scene}
use test.system.reftest.parity.scenes.text_arabic.{scene as arabic_scene}
use test.system.reftest.parity.scenes.porter_duff.{scene as porterduff_scene}
use test.system.reftest.parity.scenes.mix_blend_mode.{scene as mixblend_scene}
use test.system.reftest.parity.scenes.backdrop_filter.{scene as backdrop_scene}
use test.system.reftest.parity.scenes.scroll_damage.{scene as scroll_scene}
use test.system.reftest.parity.scenes.transform_tree.{scene as transform_scene}
use test.system.reftest.parity.scenes.opacity_layer.{scene as opacity_scene}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

fn _manifest(name: text, desc: text) -> SceneManifest:
    SceneManifest(name: name, description: desc, chromium_ref_file: "")

fn _mk_rect(r: f64, b: f64) -> SkRect:
    SkRect(left: 0.0, top: 0.0, right: r, bottom: b)

fn _mk_pic(r: f64, b: f64) -> SkPicture:
    val bounds = _mk_rect(r, b)
    val rec = SkPictureRecorder(recording: false, cull_rect: bounds, ops: 0)
    val started = rec.begin_recording(bounds)
    started.finish_recording()

# ---------------------------------------------------------------------------
# Harness lifecycle
# ---------------------------------------------------------------------------

describe "Drawing parity reftest suite":
    it "harness starts empty":
        val h = reftest_harness_new()
        expect(h.result_count()).to_equal(0)

    it "runs one scene and records result":
        var h = reftest_harness_new()
        val pic = winding_scene()
        val m = _manifest("path_winding", "winding fill rule")
        val r = h.run(m, pic)
        expect(r.op_count >= 0).to_equal(true)

    it "result_count increases after each scene":
        var h = reftest_harness_new()
        val m1 = _manifest("path_winding", "winding fill")
        val m2 = _manifest("path_evenodd", "even-odd fill")
        h.run(m1, winding_scene())
        h.run(m2, evenodd_scene())
        expect(h.result_count()).to_equal(2)

    it "find returns Some for registered scene":
        var h = reftest_harness_new()
        val m = _manifest("dashed_strokes", "dashed path effect")
        h.run(m, dashed_scene())
        val found = h.find("dashed_strokes")
        expect(found.is_some()).to_equal(true)

    it "find returns None for unknown scene":
        val h = reftest_harness_new()
        val found = h.find("nonexistent")
        expect(found.is_none()).to_equal(true)

# ---------------------------------------------------------------------------
# Signature distinctness
# ---------------------------------------------------------------------------

describe "10 scenes produce distinct signatures":
    it "all 10 scene signatures are unique":
        val s0 = scene_signature(winding_scene())
        val s1 = scene_signature(evenodd_scene())
        val s2 = scene_signature(dashed_scene())
        val s3 = scene_signature(gradient_scene())
        val s4 = scene_signature(arabic_scene())
        val s5 = scene_signature(porterduff_scene())
        val s6 = scene_signature(mixblend_scene())
        val s7 = scene_signature(backdrop_scene())
        val s8 = scene_signature(scroll_scene())
        val s9 = scene_signature(transform_scene())
        val s10 = scene_signature(opacity_scene())
        # Each cull_rect differs, so coord_sum differs, so signature differs.
        expect(s0).to_not_equal(s1)
        expect(s1).to_not_equal(s2)
        expect(s2).to_not_equal(s3)
        expect(s3).to_not_equal(s4)
        expect(s4).to_not_equal(s5)
        expect(s5).to_not_equal(s6)
        expect(s6).to_not_equal(s7)
        expect(s7).to_not_equal(s8)
        expect(s8).to_not_equal(s9)
        expect(s9).to_not_equal(s10)

    it "same scene produces same signature when called twice":
        val a = scene_signature(winding_scene())
        val b = scene_signature(winding_scene())
        expect(a).to_equal(b)

# ---------------------------------------------------------------------------
# PixelDiffResult contract
# ---------------------------------------------------------------------------

# Small inline pictures keep these contract tests inside the interpreter's
# CPU-raster budget; the scenes above still cover full-scene signatures.
fn _diff_probe_picture(fill_left: bool) -> SkPicture:
    val cull = SkRect(left: 0.0, top: 0.0, right: 16.0, bottom: 16.0)
    val rect = if fill_left:
        SkRect(left: 1.0, top: 1.0, right: 8.0, bottom: 15.0)
    else:
        SkRect(left: 8.0, top: 1.0, right: 15.0, bottom: 15.0)
    val paint = sk_paint_fill(sk_color_argb(255, 200, 40, 40))
    var ops = [SkPictureOp]()
    ops.push(sk_picture_op_draw_rect(rect, paint))
    SkPicture(cull_rect: cull, op_count: ops.len() as i64, ops: ops)

describe "compare_pictures (real CPU raster diff)":
    it "identical pictures return ratio 0":
        val pic = _diff_probe_picture(true)
        val diff = compare_pictures(pic, pic, pic.cull_rect, 0)
        expect(diff.ratio).to_equal(0.0)

    it "identical pictures return max_delta 0":
        val pic = _diff_probe_picture(false)
        val diff = compare_pictures(pic, pic, pic.cull_rect, 0)
        expect(diff.max_delta).to_equal(0)

    it "different pictures report a non-zero diff ratio":
        val a = _diff_probe_picture(true)
        val b = _diff_probe_picture(false)
        val diff = compare_pictures(a, b, a.cull_rect, 0)
        expect(diff.ratio > 0.0).to_equal(true)

    it "different pictures report a non-zero max channel delta":
        val a = _diff_probe_picture(true)
        val b = _diff_probe_picture(false)
        val diff = compare_pictures(a, b, a.cull_rect, 0)
        expect(diff.max_delta > 0).to_equal(true)

# ---------------------------------------------------------------------------
# Chromium name spot-checks
# ---------------------------------------------------------------------------

describe "Scene cull rects match Chromium spec":
    it "path_winding cull is 200x200":
        val pic = winding_scene()
        val r = pic.cull_rect
        expect(r.right).to_equal(200.0)
        expect(r.bottom).to_equal(200.0)

    it "porter_duff cull is 300x300":
        val pic = porterduff_scene()
        val r = pic.cull_rect
        expect(r.right).to_equal(300.0)
        expect(r.bottom).to_equal(300.0)

    it "scroll_damage cull is 400x400":
        val pic = scroll_scene()
        val r = pic.cull_rect
        expect(r.right).to_equal(400.0)
        expect(r.bottom).to_equal(400.0)
