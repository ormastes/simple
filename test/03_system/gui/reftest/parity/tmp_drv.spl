use std.skia.backend.cpu.raster_prims.{Bitmap, fill_path_aa}
use std.skia.entity.path.{SkPath, sk_path_new}
use std.skia.entity.color.{sk_color_argb}
use std.skia.entity.enums.{SkPathFillType}
fn main():
    var b = Bitmap.zeros(16, 16)
    val p = sk_path_new().move_to(1.0, 1.0).line_to(10.0, 1.0).line_to(5.0, 10.0).close().with_fill_type(SkPathFillType.Winding)
    val c = sk_color_argb(255, 30, 80, 200)
    fill_path_aa(b, p, c)
    print "fill ok"
