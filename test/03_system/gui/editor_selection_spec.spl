# editor_selection_spec
#
# Tests SelectionState from std.nogc_sync_mut.editor.selection
# Verifies multi-select, deselect, clear, and primary node tracking.

"""
## Purpose and audience
Purpose: empty selection is_empty is true
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-GUI-EditSele-001

use std.spec
use std.nogc_sync_mut.editor.selection.{NodeId, SelectionState}

use std.spec.step
describe "SelectionState — empty":

    it "empty selection is_empty is true":
        step("Verify: empty selection is_empty is true")
        # @req: REQ-GUI-EditSele-001
        val sel = SelectionState.empty()
        expect(sel.is_empty()).to_equal(true)

    it "empty selection count is 0":
        step("Verify: empty selection count is 0")
        # @req: REQ-GUI-EditSele-001
        val sel = SelectionState.empty()
        expect(sel.count()).to_equal(0)  # oracle: value fixed by the spec contract

describe "SelectionState — select":

    it "select node sets count to 1":
        step("Verify: select node sets count to 1")
        # @req: REQ-GUI-EditSele-001
        var sel = SelectionState.empty()
        val node = NodeId(id: 1)
        sel.select(node)
        expect(sel.count()).to_equal(1)  # oracle: value fixed by the spec contract

    it "select node makes contains return true":
        step("Verify: select node makes contains return true")
        # @req: REQ-GUI-EditSele-001
        var sel = SelectionState.empty()
        val node = NodeId(id: 1)
        sel.select(node)
        expect(sel.contains(node)).to_equal(true)

describe "SelectionState — add to selection":

    it "add_to_selection increases count":
        step("Verify: add_to_selection increases count")
        # @req: REQ-GUI-EditSele-001
        var sel = SelectionState.empty()
        val n1 = NodeId(id: 1)
        val n2 = NodeId(id: 2)
        sel.select(n1)
        sel.add_to_selection(n2)
        expect(sel.count()).to_equal(2)  # oracle: value fixed by the spec contract

describe "SelectionState — deselect":

    it "deselect decreases count":
        step("Verify: deselect decreases count")
        # @req: REQ-GUI-EditSele-001
        var sel = SelectionState.empty()
        val n1 = NodeId(id: 1)
        val n2 = NodeId(id: 2)
        sel.select(n1)
        sel.add_to_selection(n2)
        sel.deselect(n1)
        expect(sel.count()).to_equal(1)  # oracle: value fixed by the spec contract

    it "deselect makes contains return false":
        step("Verify: deselect makes contains return false")
        # @req: REQ-GUI-EditSele-001
        var sel = SelectionState.empty()
        val node = NodeId(id: 1)
        sel.select(node)
        sel.deselect(node)
        expect(sel.contains(node)).to_equal(false)

describe "SelectionState — clear":

    it "clear makes is_empty true":
        step("Verify: clear makes is_empty true")
        # @req: REQ-GUI-EditSele-001
        var sel = SelectionState.empty()
        val node = NodeId(id: 1)
        sel.select(node)
        sel.clear()
        expect(sel.is_empty()).to_equal(true)

describe "SelectionState — primary node":

    it "primary node tracks first selected":
        step("Verify: primary node tracks first selected")
        # @req: REQ-GUI-EditSele-001
        var sel = SelectionState.empty()
        val n1 = NodeId(id: 42)
        sel.select(n1)
        expect(sel.primary_node.id).to_equal(42)  # oracle: value fixed by the spec contract
