    it "recognizes Simple types":
        # @req REQ-SSPEC-SYSTEM
        # @capture(statistics): evidence for scenario "recognizes Simple types"
        step("recognizes Simple types")
        val src = read_text("src/lib/editor/buffer/syntax_highlight.spl")
