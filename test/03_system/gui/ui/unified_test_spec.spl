# @tag:system
# @req REQ-SSPEC-SYSTEM
# @cover src/app/ui.web/backend.spl 80%
# @cover src/app/ui.tui_web/backend.spl 80%
# Shared fixture and headless backend contract; live HTTP/event delivery is separate.
# Coverage percentages are targets, not measured results.

use std.spec.{describe, it, expect, step, fail}
use nogc_sync_mut.ui.parse.sdn_tree.{parse_ui_to_tree}
use common.ui.state.{init_state, update_state}
use common.ui.widget.{UIEvent}
use app.ui.web.backend.{WebBackend, web_semantic_snapshot}
use app.ui.tui_web.backend.{TuiWebBackend, tui_web_semantic_snapshot}

describe "Unified UI backend fixture contract":
    it "should render shared fixture controls through both backends":
        step("Load the shared UI fixture")
        match parse_ui_to_tree("test/fixtures/ui/test_app.ui.sdn"):
            Err(message):
                fail("Shared UI fixture could not be parsed: {message}")
            Ok(tree):
                val state = init_state(tree)
                val web = WebBackend.new(0)
                val tui_web = TuiWebBackend.new()
                step("Render HTML through both backend adapters")
                val web_html = web.render_html(state)
                val tui_html = tui_web.render_html(state)
                for html in [web_html, tui_html]:
                    expect(html).to_contain("id=\"action_btn\"")
                    expect(html).to_contain("Click Me")
                    expect(html).to_contain("id=\"search_input\"")
                    expect(html).to_contain("Search...")
                    expect(html).to_contain("Ready")

    it "should expose the same nonempty semantic fixture on both surfaces":
        step("Load the fixture into the shared UI state")
        match parse_ui_to_tree("test/fixtures/ui/test_app.ui.sdn"):
            Err(message):
                fail("Shared UI fixture could not be parsed: {message}")
            Ok(tree):
                val state = init_state(tree)
                step("Read web and TUI-web semantic snapshots")
                val web = web_semantic_snapshot(state)
                val tui_web = tui_web_semantic_snapshot(state)
                expect(web.state.title).to_equal("Test App")
                expect(tui_web.state.title).to_equal("Test App")
                expect(web.state.mode).to_equal("NORMAL")
                expect(tui_web.state.mode).to_equal("NORMAL")
                expect(web.elements.len()).to_be_greater_than(0)
                expect(tui_web.elements.len()).to_equal(web.elements.len())
                var saw_button = false
                if tui_web.elements.len() == web.elements.len():
                    for i in 0..web.elements.len():
                        expect(tui_web.elements[i].canonical_id).to_equal(web.elements[i].canonical_id)
                        expect(tui_web.elements[i].kind).to_equal(web.elements[i].kind)
                        expect(tui_web.elements[i].text).to_equal(web.elements[i].text)
                for element in web.elements:
                    if element.widget_id == "action_btn":
                        saw_button = true
                        expect(element.kind).to_equal("button")
                        var saw_label = false
                        for prop in element.props:
                            if prop.key == "label":
                                saw_label = true
                                expect(prop.value).to_equal("Click Me")
                        expect(saw_label).to_equal(true)
                expect(saw_button).to_equal(true)

    it "should reflect input and focus actions in both backend snapshots":
        step("Load a fresh shared fixture")
        match parse_ui_to_tree("test/fixtures/ui/test_app.ui.sdn"):
            Err(message):
                fail("Shared UI fixture could not be parsed: {message}")
            Ok(tree):
                var state = init_state(tree)
                step("Apply focus and input events through the UI state owner")
                state = update_state(state, UIEvent.FocusEvent(target_id: "search_input", kind: "focus"))
                state = update_state(state, UIEvent.InputChange(target_id: "search_input", value: "phase one"))
                step("Observe the changed input on both semantic surfaces")
                val web = web_semantic_snapshot(state)
                val tui_web = tui_web_semantic_snapshot(state)
                for snapshot in [web, tui_web]:
                    expect(snapshot.state.focused_id).to_equal("main#search_input")
                    var saw_input = false
                    for element in snapshot.elements:
                        if element.widget_id == "search_input":
                            saw_input = true
                            expect(element.focused).to_equal(true)
                            var saw_value = false
                            for prop in element.props:
                                if prop.key == "value":
                                    saw_value = true
                                    expect(prop.value).to_equal("phase one")
                            expect(saw_value).to_equal(true)
                    expect(saw_input).to_equal(true)
