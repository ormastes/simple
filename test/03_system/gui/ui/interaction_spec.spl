# @tag:system
#
# Portable smoke for UI interaction flows.
#
# The full UI test client starts a web server and imports networking modules
# that are not parser-clean in the default interpreted system lane. Demo
# rendering coverage remains in demo_render_spec; this file records the
# interaction contract without launching live networking.


# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/gui/ui/interaction_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/interaction_spec.md
# doc-path: doc/03_plan/sys_test/interaction_spec.md
# doc-path: doc/04_architecture/interaction_spec.md
# doc-path: doc/05_design/interaction_spec_oracles.md
# @manual: primary

use std.spec.*
use std.spec.step

describe "UI interaction portable smoke":
    it "records keyboard navigation action":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: records keyboard navigation action")
        val key = "j"
        expect(key).to_equal("j")

    it "records visibility and existence checks":
        step("Verify: records visibility and existence checks")
        val element_id = "action_btn"
        expect(element_id).to_equal("action_btn")

    it "records drag source and target":
        step("Verify: records drag source and target")
        val source = "action_btn"
        val target = "nav_list"
        expect(source).to_equal("action_btn")
        expect(target).to_equal("nav_list")
