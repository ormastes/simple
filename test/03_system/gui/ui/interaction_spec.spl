# @tag:system
# @req REQ-SSPEC-SYSTEM
# @cover src/lib/common/ui/event.spl 80%
# @cover src/lib/common/ui/access_snapshot.spl 80%
# @cover src/lib/common/ui/access_query.spl 80%
# @cover src/lib/common/ui/web_render_api.spl 80%
# Coverage percentages are targets, not measured results.
# In-process integration; live browser delivery remains unqualified.

use std.spec.{describe, it, expect, step, fail}
use common.ui.widget.{WidgetNode, UIState, UIEvent}
use common.ui.builder.{column, button, text_input, build_tree}
use common.ui.state.{init_state, update_state}
use common.ui.widget_hit.{widget_hit_test}
use common.ui.access_query.{ui_access_query, ui_access_ensure_result}
use common.ui.access_snapshot.{ui_access_snapshot_from_state, ui_access_record_event, ui_access_recent_events}
use common.ui.web_render_api.{web_render_input_envelope_from_event, web_render_input_envelope_to_json}

fn _interaction_state(prefix: text) -> UIState:
    val source = button("{prefix}_source", "Drag me", "noop")
    val target = text_input("{prefix}_target", "Drop here")
    val other = text_input("{prefix}_other", "Other input")
    target.set_prop("value", "target before")
    other.set_prop("value", "other before")
    val root = column("{prefix}_root", [source, target, other])
    init_state(build_tree(root))

fn _interaction_expect_focus(state: UIState, widget_id: text):
    expect(state.focused_id).to_equal(widget_id)
    val snapshot = ui_access_snapshot_from_state(state, [])
    val focused = ui_access_query(snapshot, "main", "", "", "", true, 10)
    expect(focused.ok).to_equal(true)
    if focused.nodes.len() == 1:
        expect(focused.nodes[0].widget_id).to_equal(widget_id)
        expect(focused.nodes[0].canonical_id).to_equal("main#{widget_id}")
    else:
        fail("Expected exactly one focused node, got {focused.nodes.len()}")

describe "UI interaction state and access integration":
    it "should move focus forward and backward through real keyboard events":
        step("Build an unfocused-control tree with root focus")
        var state = _interaction_state("interaction_keys")
        _interaction_expect_focus(state, "interaction_keys_root")
        step("Encode a navigation key and dispatch it through the state owner")
        val key = UIEvent.KeyPress(key: "j")
        val envelope = web_render_input_envelope_from_event("electron", "main", key)
        expect(envelope.event_type).to_equal("key")
        expect(envelope.key).to_equal("j")
        val wire = web_render_input_envelope_to_json(envelope)
        expect(wire).to_contain("\"event_type\":\"key\"")
        expect(wire).to_contain("\"key\":\"j\"")
        state = update_state(state, key)
        _interaction_expect_focus(state, "interaction_keys_source")
        step("Advance to the input and return to the action button")
        state = update_state(state, UIEvent.KeyPress(key: "j"))
        _interaction_expect_focus(state, "interaction_keys_target")
        state = update_state(state, UIEvent.KeyPress(key: "k"))
        _interaction_expect_focus(state, "interaction_keys_source")

    it "should distinguish a hidden widget from a missing widget after visibility changes":
        step("Snapshot the initially visible action button")
        val state = _interaction_state("interaction_visibility")
        val before = ui_access_snapshot_from_state(state, [])
        val visible = ui_access_ensure_result(before, "main", "main#interaction_visibility_source", "", "", false, 10, "visible", "")
        expect(visible.satisfied).to_equal(true)
        step("Hide the real widget and rebuild its access snapshot")
        val source = WidgetNode(id: "interaction_visibility_source")
        source.set_visible(false)
        val hidden = ui_access_snapshot_from_state(state, [])
        val existence = ui_access_ensure_result(hidden, "main", "main#interaction_visibility_source", "", "", false, 10, "exists", "")
        val hidden_visible = ui_access_ensure_result(hidden, "main", "main#interaction_visibility_source", "", "", false, 10, "visible", "")
        expect(existence.satisfied).to_equal(true)
        expect(hidden_visible.satisfied).to_equal(false)
        step("Require missing identity to fail existence, then show the widget again")
        val missing = ui_access_ensure_result(hidden, "main", "main#interaction_visibility_missing", "", "", false, 10, "exists", "")
        expect(missing.satisfied).to_equal(false)
        source.set_visible(true)
        val restored = ui_access_snapshot_from_state(state, [])
        val restored_visible = ui_access_ensure_result(restored, "main", "main#interaction_visibility_source", "", "", false, 10, "visible", "")
        expect(restored_visible.satisfied).to_equal(true)

    it "should deliver a dragged payload to the hit input and clear interaction state":
        step("Build three vertical controls and confirm the drop coordinate hits the target")
        var state = _interaction_state("interaction_drag")
        val root = state.tree.root_node()
        val source = WidgetNode(id: "interaction_drag_source")
        val target = WidgetNode(id: "interaction_drag_target")
        val other = WidgetNode(id: "interaction_drag_other")
        # Event-owner viewport defaults to 640x480; second flex row contains
        # (10, 200). Assert the actual hit before dispatching the drag.
        val hit = widget_hit_test(root, 640, 480, 10, 200)
        expect(hit.found).to_equal(true)
        expect(hit.id).to_equal("interaction_drag_target")
        expect(target.get_prop("value")).to_equal("target before")
        step("Start a real content drag and preserve its transport envelope")
        val start = UIEvent.DragStart(source_id: "interaction_drag_source", mime: "text/plain", data: "row-1")
        val start_envelope = web_render_input_envelope_from_event("electron", "main", start)
        expect(start_envelope.event_type).to_equal("drag_start")
        expect(start_envelope.target_id).to_equal("interaction_drag_source")
        state = update_state(state, start)
        expect(source.get_prop("ui_dragging")).to_equal("true")
        expect(root.get_prop("ui_drag_active")).to_equal("true")
        step("Move over the target and drop through the production state owner")
        state = update_state(state, UIEvent.DragMove(x: 10, y: 200))
        expect(target.get_prop("ui_drop_target")).to_equal("true")
        expect(other.get_prop("ui_drop_target")).to_equal("false")
        val drop = UIEvent.DragDrop(mime: "text/plain", data: "row-1", x: 10, y: 200, source_id: "interaction_drag_source")
        val drop_envelope = web_render_input_envelope_from_event("electron", "main", drop)
        expect(drop_envelope.event_type).to_equal("drag_drop")
        # Envelope target_id carries the source; hit testing selects the receiver.
        expect(drop_envelope.target_id).to_equal("interaction_drag_source")
        expect(drop_envelope.value).to_equal("text/plain:row-1")
        val wire = web_render_input_envelope_to_json(drop_envelope)
        expect(wire).to_contain("\"event_type\":\"drag_drop\"")
        state = update_state(state, drop)
        step("Observe the changed input, untouched sibling, and cleared drag flags")
        expect(target.get_prop("value")).to_equal("row-1")
        expect(other.get_prop("value")).to_equal("other before")
        expect(source.get_prop("ui_dragging")).to_equal("false")
        expect(target.get_prop("ui_drop_target")).to_equal("false")
        expect(other.get_prop("ui_drop_target")).to_equal("false")
        expect(root.get_prop("ui_drag_active")).to_equal("false")
        val snapshot = ui_access_snapshot_from_state(state, [])
        val delivered = ui_access_ensure_result(snapshot, "main", "main#interaction_drag_target", "", "", false, 10, "value", "row-1")
        expect(delivered.satisfied).to_equal(true)

    it "should retain ordered source and target history records at the model level":
        step("Append source and target records to the access history model")
        # Explicit model calls do not establish automatic recording by the
        # reducer or live drag delivery to a list widget.
        val started = ui_access_record_event([], 1, "main", "action_btn", "drag_start", "row-1")
        val dropped = ui_access_record_event(started, 2, "main", "nav_list", "drop", "row-1")
        val recent = ui_access_recent_events(dropped, 8)
        step("Read both retained history entries in their original order")
        if recent.len() == 2:
            expect(recent[0].widget_id).to_equal("action_btn")
            expect(recent[0].event_kind).to_equal("drag_start")
            expect(recent[0].sequence).to_equal(1)
            expect(recent[1].widget_id).to_equal("nav_list")
            expect(recent[1].event_kind).to_equal("drop")
            expect(recent[1].sequence).to_equal(2)
            expect(recent[1].payload).to_equal("row-1")
        else:
            fail("Expected two retained interaction events, got {recent.len()}")
