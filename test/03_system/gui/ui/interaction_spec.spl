# @tag:system
#
# Portable smoke for UI interaction flows.
#
# The full UI test client starts a web server and imports networking modules
# that are not parser-clean in the default interpreted system lane. Demo
# rendering coverage remains in demo_render_spec; this file records the
# interaction contract without launching live networking.

"""
## Purpose and audience
Purpose: the portable UI interaction contract — keyboard navigation, visibility
checks, and drag source/target pairing — is expressed against the real UI
access-snapshot model (std.common.ui.access_*) instead of tautological string
literals.
Audience: UI engineers who maintain the access snapshot and query layer.
"""

use std.spec.step

use std.spec.{describe, it, expect}
use std.common.ui.access_types.{UiAccessNode, UiAccessSurface, UiAccessSnapshot, UiAccessProp}
use std.common.ui.access_query.{ui_access_query, ui_access_find_node, ui_access_canonical_id}
use std.common.ui.access_snapshot.{ui_access_record_event, ui_access_recent_events}

fn _btn(widget_id: text, kind: text, visible: bool, focused: bool, label: text) -> UiAccessNode:
    UiAccessNode(
        canonical_id: ui_access_canonical_id("main", widget_id),
        surface_id: "main",
        widget_id: widget_id,
        kind: kind,
        visible: visible,
        focused: focused,
        enabled: true,
        selected: false,
        text_value: label,
        props: [UiAccessProp(key: "label", value: label)],
        child_ids: [],
        action_names: []
    )

fn _snapshot(nodes: [UiAccessNode]) -> UiAccessSnapshot:
    UiAccessSnapshot(
        protocol_version: 1,
        snapshot_revision: 7,
        mode: "tree",
        active_surface: "main",
        surfaces: [UiAccessSurface(
            surface_id: "main", title: "Main", active: true, window_id: "w1",
            app_id: "app", root_canonical_id: ui_access_canonical_id("main", "root"))],
        nodes: nodes,
        recent_events: []
    )

# @manual_section: UI interaction portable smoke

describe "UI interaction portable smoke":
    # @manual scenario evidence
    it "keyboard navigation moves focus onto the target action button":
        # @req REQ-SSPEC-SYSTEM
        step("Verify: focused-only query returns exactly the keyboard-focused node")
        val snap = _snapshot([_btn("nav_list", "list", true, false, "Nav"),
                              _btn("action_btn", "button", true, true, "Do it")])
        val result = ui_access_query(snap, "main", "", "button", "", true, 10)
        expect(result.ok).to_equal(true)  # oracle: well-formed focused query
        expect(result.match_count).to_equal(1)  # oracle: only the focused node matches
        expect(result.nodes[0].widget_id).to_equal("action_btn")  # oracle: focus landed on the action button

    it "visibility and existence checks distinguish visible from hidden nodes":
        # @req REQ-SSPEC-SYSTEM
        step("Verify: canonical-id lookup finds the visible node and misses the hidden one")
        val snap = _snapshot([_btn("action_btn", "button", true, false, "Do it"),
                              _btn("hidden_btn", "button", false, false, "Hidden")])
        val found = ui_access_find_node(snap, ui_access_canonical_id("main", "action_btn"))
        expect(found != nil).to_equal(true)  # oracle: existing node resolves
        expect(found.?.visible).to_equal(true)  # oracle: the node reports visible
        val hidden = ui_access_find_node(snap, ui_access_canonical_id("main", "hidden_btn"))
        expect(hidden.?.visible).to_equal(false)  # oracle: hidden node reports not visible

    it "drag pairing records source and target as ordered action events":
        # @req REQ-SSPEC-SYSTEM
        step("Verify: drag start then drop appends two ordered events")
        val events = ui_access_record_event([], 1, "main", "action_btn", "drag_start", "{}")
        val events2 = ui_access_record_event(events, 2, "main", "nav_list", "drop", "{}")
        val recent = ui_access_recent_events(events2, 8)
        expect(recent.len()).to_equal(2)  # oracle: both drag halves recorded
        expect(recent[0].widget_id).to_equal("action_btn")  # oracle: source first
        expect(recent[0].event_kind).to_equal("drag_start")
        expect(recent[1].widget_id).to_equal("nav_list")  # oracle: target second
        expect(recent[1].event_kind).to_equal("drop")
