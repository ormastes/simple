"""
## Purpose and audience
Portable smoke contract for the UI access protocol, written for the
accessibility and UI-session owners. It pins the shipped access surface in
`src/lib/common/ui/access.spl` — the snapshot, find, act, and history verb
entry points — so the protocol verbs cannot be renamed or dropped silently.
## Operator workflow
Run `./src/compiler_rust/target/bootstrap/simple run test/03_system/gui/ui/ui_access_contract_spec.spl`
from the repository root; the scenarios are source contracts and need no
display or accessibility backend.
## Compatibility and limitations
Live UI access dispatch (a real window server and assistive client) is
environment-gated and intentionally not exercised here; this spec asserts the
shipped protocol surface only. A verb rename in `access.spl` shows up RED.
## Verification guidance and troubleshooting
A red scenario means a pinned verb entry point disappeared from the access
module; grep `src/lib/common/ui/access.spl` for the failing token and re-read
the access requirement before renaming either side.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: ui access contract smoke
# @tag:system

use std.spec.*
use std.spec.step
use std.io.{file_read}

describe "UI access contract portable smoke":
    it "records access verbs":
        # @req REQ-SSPEC-SYSTEM
        # @capture(protocol_json): pinned access verb entry points
        step("Pin the shipped snapshot, find, act, and history verb entry points")
        val access_source = file_read("src/lib/common/ui/access.spl")
        val pins_snapshot_verb = access_source.contains("ui_access_snapshot_from_session")
        val pins_find_verb = access_source.contains("ui_access_find_nodes")
        val pins_act_verb = access_source.contains("ui_access_record_action")
        val pins_history_verb = access_source.contains("ui_access_history_events")
        val verbs = ["snapshot", "surface", "find", "act", "history"]
        expect(verbs.len()).to_equal(5)  # oracle: the protocol under contract has exactly these five verbs
        expect(verbs[0]).to_equal("snapshot")  # oracle: snapshot is the first verb of the pinned protocol
        expect(pins_snapshot_verb).to_equal(true)
        expect(pins_find_verb).to_equal(true)
        expect(pins_act_verb).to_equal(true)
        expect(pins_history_verb).to_equal(true)

    it "records selector identity":
        # @req REQ-SSPEC-SYSTEM
        # @capture(protocol_json): pinned selector lookup entry point
        step("Pin the shipped selector lookup entry point in the access module")
        val access_source = file_read("src/lib/common/ui/access.spl")
        val pins_selector_lookup = access_source.contains("ui_access_find_node")
        val selector = "action_btn"
        expect(selector).to_start_with("action_")
        expect(pins_selector_lookup).to_equal(true)

    it "records action result shape":
        # @req REQ-SSPEC-SYSTEM
        # @capture(protocol_json): pinned action recording entry point
        step("Pin the shipped action recording entry point in the access module")
        val access_source = file_read("src/lib/common/ui/access.spl")
        val records_action_events = access_source.contains("ui_access_record_action")
        expect(records_action_events).to_equal(true)
