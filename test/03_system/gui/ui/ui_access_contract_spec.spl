"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/gui/ui/ui_access_contract_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/ui_access_contract_spec.md
# doc-path: doc/03_plan/sys_test/ui_access_contract_spec.md
# doc-path: doc/04_architecture/ui_access_contract_spec.md
# doc-path: doc/05_design/ui_access_contract_spec_oracles.md
# @manual: primary

use std.spec.*
use std.spec.step

describe "UI access contract portable smoke":
    it "records access verbs":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: records access verbs")
        val verbs = ["snapshot", "surface", "find", "act", "history"]
        expect(verbs.len()).to_equal(5)
        expect(verbs[0]).to_equal("snapshot")

    it "records selector identity":
        step("Verify: records selector identity")
        val selector = "action_btn"
        expect(selector).to_equal("action_btn")

    it "records action result shape":
        step("Verify: records action result shape")
        val ok = true
        expect(ok).to_equal(true)
