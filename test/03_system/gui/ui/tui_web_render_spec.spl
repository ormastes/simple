# @tag:system
#
# Portable smoke for TUI-web rendering.
#
# The live TUI-web rendering spec starts an HTTP server and imports networking
# modules that are not parser-clean in the default interpreted system lane.


# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/gui/ui/tui_web_render_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/tui_web_render_spec.md
# doc-path: doc/03_plan/sys_test/tui_web_render_spec.md
# doc-path: doc/04_architecture/tui_web_render_spec.md
# doc-path: doc/05_design/tui_web_render_spec_oracles.md
# @manual: primary

use std.spec.*
use std.spec.step

describe "TUI web render portable smoke":
    it "records backend name":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: records backend name")
        val backend = "tui_web"
        expect(backend).to_equal("tui_web")

    it "records fixture path":
        step("Verify: records fixture path")
        val fixture = "test/fixtures/ui/test_app.ui.sdn"
        expect(fixture).to_end_with(".ui.sdn")

    it "records rendered surface expectation":
        step("Verify: records rendered surface expectation")
        val surface = "html"
        expect(surface).to_equal("html")
