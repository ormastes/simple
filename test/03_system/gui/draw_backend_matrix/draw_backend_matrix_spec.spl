# @cover src/lib/gc_async_mut/gpu/engine2d/engine.spl
# @cover src/lib/gc_async_mut/gpu/engine2d/backend_directx.spl
# @cover src/lib/gc_async_mut/gpu/engine2d/backend_vulkan.spl
# @cover src/lib/gc_async_mut/gpu/engine2d/backend_metal.spl
# @tag: system, ui, engine2d, backend, drawing, matrix
"""
# Per-Backend Drawing Matrix — System-Specific Checkpoints

**Category:** Testing | **Status:** Implemented
**Requirements:** N/A
**Design:** N/A
**Research:** N/A
**Plan:** doc/03_plan/ui/testing/gpu_draw_event_intensive_tests.md

## Overview

One SHARED body — probe, create-success, draw-apply, readback-verify — run
against every 2D drawing backend key Engine2D exposes: `software` (the
absolute reference), `cpu`, `directx`, `vulkan`, and `metal`. Availability is
never silently skipped: a backend that cannot init on this host reports a
concrete `host-unavailable(reason)`, and asserting that classification IS the
system-specific checkpoint's pass condition (fail-closed, per the intensive
GPU/draw/event test plan).

Every readback assertion is an ABSOLUTE oracle — a known drawn pixel equals
the draw color, a known background pixel equals the clear color — never a
cross-backend diff alone. This avoids the false-green history documented in
`doc/07_guide/ui/engine2d_cpu_metal_bit_parity.md` (software-vs-itself
tautology, MATCH-only comparisons, memorized pixel tables).

## Key Concepts

| Concept | Description |
|---------|-------------|
| Probe | `Engine2D.probe_backend(w, h, key)` — native-only availability (no emulation fallback), so `metal` reports honestly `Unavailable` off macOS. It runs its own create+init+shutdown and throws it away, so its answer is a PREDICTION: only its SELF-consistency is asserted, never the create outcome |
| Create-attempt | `Engine2D.create_requested_backend` is a SECOND, INDEPENDENT create and is attempted regardless of the probe. On success it must resolve to the backend's own honest self-reported name (`directx` → `directx-software-emulation`), catching alias dishonesty; a probe/create divergence is disclosed on a `[toctou]` line |
| Readback provenance | `read_pixels_with_source()` feeds `assert_provenance_invariants` unconditionally on every backend and outcome, and `report_outcome` prints `GPU-PROVEN` or an explicit `GPU BRANCH SKIPPED … proves NOTHING about the GPU path` |
| Draw-apply | one filled rect + one line drawn on a real framebuffer |
| Readback-verify | `read_pixels()` download; rect interior == rect color, line pixel == line color, far pixel == background — an absolute pixel oracle, fed through the shared `read_pixels_ppm` (P6) encoder |
| Vulkan device lane | `bin/simple test` runs specs in the classic interpreter, so real `vkCreateInstance`/`vkCmdDispatch` execute without any extra env var (see `doc/07_guide/ui/gpu_backends/vulkan_backed_rendering.md`) |

## Related Specifications

- `test/01_unit/lib/gc_async_mut/gpu/engine2d/engine2d_env_backend_select_spec.spl` — the `SIMPLE_2D_BACKEND` override model this spec's shared checkpoint follows
- `test/01_unit/lib/gc_async_mut/gpu/engine2d/backend_vulkan_drawing_spec.spl` — Vulkan lane hardening (structured error classification)
- `test/01_unit/lib/gc_async_mut/gpu/engine2d/vulkan_compute_oracle_spec.spl` — the honest device-count-zero gate this spec's Vulkan lane mirrors
- `test/02_integration/lib/gpu/cpu_sw_primitive_readback_spec.spl` — the shared per-primitive readback body this spec reuses

## Syntax

Steps are grouped `probe` → `create-success` → `draw-apply` → `readback-verify`
per backend `it`. `std.spec` matchers only; facades only (`std.io_runtime`
`env_set`), no raw `rt_*` externs.
"""

use std.spec.*
use std.io_runtime.{env_set}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.color.{rgba}
use std.gc_async_mut.gpu.engine2d.backend_directx.{DirectXBackend}
use std.gc_async_mut.gpu.engine2d.backend_vulkan.{VulkanBackend}
use test.helpers.gpu_draw_event_shared.{
    assert_color_eq, read_pixels_ppm, assert_provenance_invariants, report_outcome,
    report_no_frame}

val CANVAS_W: i32 = 32
val CANVAS_H: i32 = 24
val BG: u32 = rgba(3, 5, 7, 255)
val RECT_COLOR: u32 = rgba(255, 0, 0, 255)
val LINE_COLOR: u32 = rgba(0, 255, 0, 255)

fn px_at(pixels: [u32], w: i32, x: i32, y: i32) -> u32:
    pixels[(y * w + x) as i64]

# ---------------------------------------------------------------------------
# Shared draw-apply + readback-verify body (steps 3-4), reused by every
# available backend lane below. Absolute oracle only.
#
# The readback goes through read_pixels_with_source() so provenance is checked
# from the SAME download the pixel oracle reads. Both the provenance invariants
# and the pixel oracle run UNCONDITIONALLY on whichever backend actually served
# the frame; only the `proven` extra hangs off the fact a device produced it.
# ---------------------------------------------------------------------------
val CANVAS_PX: i64 = (CANVAS_W as i64) * (CANVAS_H as i64)

# Whether the backend publishes a device identity on its readback at all. A
# deterministic contract claim read off the construction site, NOT a device
# prediction: backend_vulkan.spl:823/836, backend_metal and backend_cuda call
# `engine2d_readback_with_identity`; the DirectX DXVK lane
# (backend_directx.spl:452/454) calls `engine2d_readback_with_handle` and
# publishes none, so it is honestly device-SOURCED but never device-PROVEN.
fn backend_attests_device_identity(key: text) -> bool:
    key == "vulkan" or key == "metal" or key == "cuda"

# A successful vulkan create may NEVER report `cpu_mirror`. Verified in source:
# backend_vulkan.spl contains no `cpu_mirror` site at all — when the device
# degrades it sets the sticky `cpu_fallback_used` flag and reports `cpu_fallback`
# (a disclosed skip). So `cpu_mirror` out of a vulkan lane is a silent CPU
# reclassification, a bookkeeping defect, and must FAIL rather than disclose.
# Not applied to directx: its native path legitimately reports `cpu_mirror`
# (backend_directx.spl:447).
fn backend_forbids_cpu_mirror(key: text) -> bool:
    key == "vulkan"

# ---------------------------------------------------------------------------
# Honest-provenance vocabulary and disclosure.
#
# Defined spec-locally on purpose: test/helpers/gpu_draw_event_shared.spl is a
# pure caps function shared by 7 specs and does no device work, so provenance
# helpers do not belong there.
#
# The label set is the authoritative one, enumerated from the construction sites
# rather than from memory:
#   /usr/bin/grep -rhoE 'engine2d_readback(_with_handle|_with_identity)?\([^,]+, *"[a-z_]+"' src/lib/ \
#     | /usr/bin/grep -oE '"[a-z_]+"$' | sort -u
# ---------------------------------------------------------------------------

fn source_is_device(source: text) -> bool:
    source == "device_readback" or source == "host_cache_after_device_present" or
        source == "swapchain_present" or source == "framebuffer_surface"

fn source_is_cpu(source: text) -> bool:
    source == "cpu_mirror" or source == "cpu_fallback"

# All of these carry an EMPTY pixel array, so no frame-content assertion is
# meaningful on them. `device_identity_unknown` (backend_cuda.spl:1050) means the
# device->host copy SUCCEEDED but the identity lookup returned <= 0 — a host
# condition, not a fabricated-provenance defect, so it must be classified rather
# than left to fail closed.
fn source_is_no_frame(source: text) -> bool:
    source == "completion_unknown" or source == "readback_failed" or
        source == "not_requested" or source == "device_identity_unknown" or
        source == "preflight_rejected" or source == "unavailable"

fn source_is_known(source: text) -> bool:
    source_is_device(source) or source_is_cpu(source) or source_is_no_frame(source)

fn device_proven(source: text, handle: i64, identity: i64, pixel_count: i64, expected_px: i64) -> bool:
    source == "device_readback" and handle > 0 and identity > 0 and
        pixel_count == expected_px

# Asserted UNCONDITIONALLY on every backend and every outcome — this is where the
# lane keeps its teeth. A device label without its credentials, or a CPU frame
# carrying device credentials, fails here regardless of which backend served it.
fn assert_provenance_invariants(label: text, source: text, handle: i64, identity: i64, pixel_count: i64, expected_px: i64, attests_identity: bool):
    if not source_is_known(source):
        print "[probe-provenance] {label}: UNKNOWN READBACK SOURCE '{source}' — outside the honest vocabulary, failing closed"
    expect(source_is_known(source)).to_equal(true)
    if source == "device_readback":
        expect(handle).to_be_greater_than(0)
        expect(pixel_count).to_equal(expected_px)
        # Only backends that actually publish an identity are held to one; the
        # DirectX DXVK lane is honestly device-SOURCED but never device-PROVEN.
        if attests_identity:
            expect(identity).to_be_greater_than(0)
    if source_is_cpu(source):
        # Deliberately NOT asserting handle == 0 / identity == 0: under fd
        # exhaustion the seed surfaces those as nil rather than 0.
        expect(source_is_device(source)).to_equal(false)
        expect(device_proven(source, handle, identity, pixel_count, expected_px)).to_equal(false)

# Discloses what actually happened and returns whether a device is PROVEN, so
# callers assert against a fact rather than the probe's prediction.
fn report_outcome(label: text, source: text, handle: i64, identity: i64, pixel_count: i64, expected_px: i64) -> bool:
    if device_proven(source, handle, identity, pixel_count, expected_px):
        print "[probe-gpu] {label}: GPU-PROVEN — a device produced this frame (source={source} handle={handle} identity={identity} pixels={pixel_count})"
        return true
    if source_is_device(source):
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — device-sourced but not device-PROVEN (source={source} handle={handle} identity={identity} pixels={pixel_count}); this example proves NOTHING about the GPU path"
    else if source == "cpu_fallback":
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — the device was unavailable at use time (source=cpu_fallback); the probe's prediction did not survive to the create. This example proves NOTHING about the GPU path"
    else if source == "cpu_mirror":
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — CPU/software lane (source=cpu_mirror); this example proves NOTHING about the GPU path"
    else:
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — no frame produced (source={source}); this example proves NOTHING about the GPU path"
    false

# True when no frame came back at all, so the caller can skip frame-content
# assertions that would otherwise false-red on an empty pixel array.
fn report_no_frame(label: text, source: text) -> bool:
    if source_is_no_frame(source):
        print "[probe-gpu] {label}: FRAME ASSERTIONS SKIPPED — no frame was produced (source={source}); this example proves NOTHING about rendering correctness"
        return true
    false

fn draw_apply_and_verify(label: text, eng: Engine2D):
    step("draw-apply: clear + filled rect + line on a real framebuffer")
    eng.clear(BG)
    eng.draw_rect_filled(4, 4, 10, 6, RECT_COLOR)
    eng.draw_line(0, 18, 31, 18, LINE_COLOR, 1)
    eng.present()

    step("readback-verify: read_pixels_with_source() — provenance and pixels from one download")
    val rb = eng.read_pixels_with_source()
    val px = rb.pixels

    step("provenance invariants — unconditional, every backend, every outcome")
    assert_provenance_invariants(label, rb.source, rb.backend_handle, rb.device_identity, rb.pixel_count, CANVAS_PX, backend_attests_device_identity(label))
    val proven = report_outcome(label, rb.source, rb.backend_handle, rb.device_identity, rb.pixel_count, CANVAS_PX)

    if backend_forbids_cpu_mirror(label):
        step("a successful {label} create may never silently reclassify to cpu_mirror")
        expect(rb.source == "cpu_mirror").to_equal(false)

    if report_no_frame(label, rb.source):
        eng.shutdown()
        return

    step("absolute pixel oracle (rect/line/background) — holds on WHICHEVER backend served this frame")
    expect(px.len()).to_equal(CANVAS_W * CANVAS_H)
    assert_color_eq(px_at(px, CANVAS_W, 8, 6), RECT_COLOR)
    assert_color_eq(px_at(px, CANVAS_W, 15, 18), LINE_COLOR)
    assert_color_eq(px_at(px, CANVAS_W, 1, 1), BG)

    if proven:
        step("device-proven frame: the download carries the drawn content, not a blank surface")
        expect(rb.checksum).to_be_greater_than(0)

    step("the shared read_pixels_ppm oracle wrapper encodes a valid P6 header")
    val ppm = read_pixels_ppm(CANVAS_W, CANVAS_H, px)
    expect(ppm.len()).to_be_greater_than(CANVAS_W * CANVAS_H * 3)
    expect(ppm[0]).to_equal(80u8)
    expect(ppm[1]).to_equal(54u8)

    eng.shutdown()

# ---------------------------------------------------------------------------
# Extended-primitive parity body (DirectX/Vulkan drawing-op parity with the
# checked Metal surface): rounded_rect outline, gradient linear-H, radial
# gradient, shadow, and scaled/transform image. Coordinates are picked from
# the shared backend_emu.spl/backend_emu_adv.spl per-pixel algorithms so every
# assertion is an EXACT absolute oracle, not a "some pixel changed" proxy:
#   - gradient_rect_h: column 0 == left_color exactly, last column ==
#     right_color exactly (backend_emu.spl:585-590, lerp reaches the endpoint
#     exactly at col=0 and col=w-1).
#   - radial_gradient: center pixel (dist=0) == center_color exactly
#     (backend_emu.spl:613-621).
#   - shadow_rect with blur_r=0: a flat offset rect_filled, interior == color
#     exactly, and the un-offset corner stays background (backend_emu_adv.spl
#     emu_draw_shadow_rect).
#   - image_scaled / image_transform with a uniform source block: every
#     covered destination pixel == that source color exactly.
val EXT_W: i32 = 40
val EXT_H: i32 = 30
val EXT_BG: u32 = rgba(2, 2, 2, 255)
val EXT_A: u32 = rgba(200, 0, 0, 255)
val EXT_B: u32 = rgba(0, 0, 200, 255)
val EXT_C: u32 = rgba(0, 200, 0, 255)
val EXT_D: u32 = rgba(220, 220, 0, 255)
val EXT_E: u32 = rgba(0, 220, 220, 255)
val EXT_PX: i64 = (EXT_W as i64) * (EXT_H as i64)

fn assert_directx_extended_ops():
    var b = DirectXBackend.create()
    if not b.init(EXT_W, EXT_H):
        step("host-unavailable(directx): fail-closed checkpoint, not a silent skip")
        expect(b.last_error.len()).to_be_greater_than(0)
        print "[probe-gpu] directx-extended: GPU BRANCH SKIPPED — init failed ({b.last_error}); this example proves NOTHING about the GPU path"
        return
    b.clear(EXT_BG)
    b.draw_rounded_rect_outline(2, 2, 10, 8, 2, EXT_A, 1)
    b.draw_gradient_rect_h(14, 2, 8, 6, EXT_A, EXT_B)
    b.draw_radial_gradient(28, 5, 4, EXT_C, EXT_B)
    b.draw_shadow_rect(2, 14, 6, 6, 1, 1, 0, EXT_D)
    b.draw_image_scaled(10, 14, 4, 4, 2, 2, [EXT_E, EXT_E, EXT_E, EXT_E])
    b.draw_image_transform(20, 14, 2, 2, 256, 0, 0, 256, 0, 0, [EXT_D, EXT_D, EXT_D, EXT_D])
    b.present()
    val rb = b.read_pixels_with_source()
    val px = rb.pixels
    assert_provenance_invariants("directx-extended", rb.source, rb.backend_handle, rb.device_identity, rb.pixel_count, EXT_PX, false)
    report_outcome("directx-extended", rb.source, rb.backend_handle, rb.device_identity, rb.pixel_count, EXT_PX)
    if report_no_frame("directx-extended", rb.source):
        b.shutdown()
        return
    assert_color_eq(px_at(px, EXT_W, 6, 2), EXT_A)            # rounded_rect_outline straight top edge
    assert_color_eq(px_at(px, EXT_W, 7, 6), EXT_BG)           # interior stays background (outline only)
    assert_color_eq(px_at(px, EXT_W, 14, 4), EXT_A)           # gradient_h left column == left_color exactly
    assert_color_eq(px_at(px, EXT_W, 21, 4), EXT_B)           # gradient_h right column == right_color exactly
    assert_color_eq(px_at(px, EXT_W, 28, 5), EXT_C)           # radial gradient center == center_color exactly
    assert_color_eq(px_at(px, EXT_W, 5, 17), EXT_D)           # shadow interior (offset by 1,1)
    assert_color_eq(px_at(px, EXT_W, 2, 14), EXT_BG)          # pre-offset corner stays background
    assert_color_eq(px_at(px, EXT_W, 11, 15), EXT_E)          # image_scaled uniform block
    assert_color_eq(px_at(px, EXT_W, 21, 15), EXT_D)          # image_transform identity-mapped pixel
    b.shutdown()

fn assert_vulkan_extended_ops():
    var b = VulkanBackend.create()
    if not b.init(EXT_W, EXT_H):
        step("host-unavailable(vulkan): fail-closed checkpoint, not a silent skip")
        expect(b.last_error.len()).to_be_greater_than(0)
        print "[probe-gpu] vulkan-extended: GPU BRANCH SKIPPED — init failed ({b.last_error}); this example proves NOTHING about the GPU path"
        return
    b.clear(EXT_BG)
    b.draw_rounded_rect_outline(2, 2, 10, 8, 2, EXT_A, 1)
    b.draw_gradient_rect_h(14, 2, 8, 6, EXT_A, EXT_B)
    b.draw_radial_gradient(28, 5, 4, EXT_C, EXT_B)
    b.draw_shadow_rect(2, 14, 6, 6, 1, 1, 0, EXT_D)
    b.draw_image_scaled(10, 14, 4, 4, 2, 2, [EXT_E, EXT_E, EXT_E, EXT_E])
    b.draw_image_transform(20, 14, 2, 2, 256, 0, 0, 256, 0, 0, [EXT_D, EXT_D, EXT_D, EXT_D])
    b.present()
    val rb = b.read_pixels_with_source()
    val px = rb.pixels
    assert_provenance_invariants("vulkan-extended", rb.source, rb.backend_handle, rb.device_identity, rb.pixel_count, EXT_PX, true)
    report_outcome("vulkan-extended", rb.source, rb.backend_handle, rb.device_identity, rb.pixel_count, EXT_PX)
    # A successful VulkanBackend init may never silently reclassify to cpu_mirror
    # (backend_vulkan.spl has no cpu_mirror site; degradation is cpu_fallback).
    expect(rb.source == "cpu_mirror").to_equal(false)
    if report_no_frame("vulkan-extended", rb.source):
        b.shutdown()
        return
    assert_color_eq(px_at(px, EXT_W, 6, 2), EXT_A)
    assert_color_eq(px_at(px, EXT_W, 7, 6), EXT_BG)
    assert_color_eq(px_at(px, EXT_W, 14, 4), EXT_A)
    assert_color_eq(px_at(px, EXT_W, 21, 4), EXT_B)
    assert_color_eq(px_at(px, EXT_W, 28, 5), EXT_C)
    assert_color_eq(px_at(px, EXT_W, 5, 17), EXT_D)
    assert_color_eq(px_at(px, EXT_W, 2, 14), EXT_BG)
    assert_color_eq(px_at(px, EXT_W, 11, 15), EXT_E)
    assert_color_eq(px_at(px, EXT_W, 21, 15), EXT_D)
    b.shutdown()

# ---------------------------------------------------------------------------
# Shared per-backend lane: probe (PREDICTION ONLY) -> create-attempt (always) ->
# draw-apply -> readback-verify. Never a silent skip().
#
# `Engine2D.probe_backend` runs a full create+init+shutdown and throws it away;
# `create_requested_backend` is a SECOND, INDEPENDENT create with nothing cached
# between them. Branching the create assertion on the stored probe answer made
# this lane fail BOTH ways: probe=ok + a create that then lost the device gave a
# false red (`called unwrap on Err: backend unavailable: vulkan`, 6/6 at
# `ulimit -n 44`), and probe=unavailable skipped the entire device branch while
# still printing a clean pass. Nothing below is asserted from the probe; a
# divergence is DISCLOSED on a [toctou] line instead.
# ---------------------------------------------------------------------------
fn is_pure_software_key(key: text) -> bool:
    key == "software" or key == "cpu"

fn run_backend_lane(key: text, expected_name: text):
    step("probe {key} — a PREDICTION about a create that has not happened yet")
    val probe = Engine2D.probe_backend(CANVAS_W, CANVAS_H, key)

    step("probe SELF-consistency: available/status/reason must agree with each other")
    expect(probe.available).to_equal(probe.is_ok())
    if not probe.is_ok():
        step("host-unavailable({key}): fail-closed classification, not a silent skip")
        expect(probe.reason.len()).to_be_greater_than(0)

    step("create-attempt: the create runs REGARDLESS of what the probe predicted")
    val created = Engine2D.create_requested_backend(CANVAS_W, CANVAS_H, key)
    if probe.is_ok() != created.is_ok():
        print "[toctou] {key}: probe predicted ready={probe.is_ok()} but the independent create returned ok={created.is_ok()} — disclosed, never asserted"

    if is_pure_software_key(key):
        step("{key} is pure software and owes no device: its create must ALWAYS succeed")
        assert_true(created.is_ok())

    match created:
        Ok(engine):
            step("create-success: requested backend resolves to its own honest name")
            var eng = engine
            expect(eng.backend_name()).to_equal(expected_name)
            draw_apply_and_verify(key, eng)
        Err(message):
            step("create-failed({key}): fail-closed checkpoint carrying a concrete reason")
            expect(message.len()).to_be_greater_than(0)
            print "[probe-gpu] {key}: GPU BRANCH SKIPPED — the independent create failed ({message}); this example proves NOTHING about the GPU path"

describe "Draw backend matrix — per-combination system-specific checkpoints":

    it "software (baseline): always available, honest name, draw-apply, readback-verify":
        run_backend_lane("software", "software")

    it "cpu: always available, honest name, draw-apply, readback-verify":
        run_backend_lane("cpu", "cpu")

    it "directx: honest CPU software-emulation name, draw-apply, readback-verify (or host-unavailable)":
        # Never claims a native D3D11 driver: create_requested_backend stamps
        # the backend's own self-reported "directx-software-emulation" name,
        # not the requested "directx" key.
        run_backend_lane("directx", "directx-software-emulation")

    it "vulkan: real device draw-apply + readback-verify under the classic interpreter (or host-unavailable)":
        # bin/simple test runs in the classic interpreter, so real
        # vkCreateInstance/vkCmdDispatch execute here when a device is
        # present — no extra env var needed (see vulkan_backed_rendering.md).
        run_backend_lane("vulkan", "vulkan")

    it "metal: honest host-unavailable classification off macOS (or native draw-apply on macOS)":
        # Engine2D.probe_backend("metal", ...) tries ONLY native MetalBackend
        # (no metal-on-vulkan emulation fallback), so on this Linux host it
        # must report Unavailable with a concrete reason — the system-specific
        # checkpoint behavior the plan asks for. On macOS it would report
        # Initialized and the shared body runs the real GPU draw-apply path.
        run_backend_lane("metal", "metal")

    it "directx: extended drawing-op parity with checked Metal surface (rounded_rect outline, gradient linear/radial, shadow, scaled+transform image) — absolute pixel oracle (or host-unavailable)":
        # Confirms DirectXBackend forwards these extended ops to the same
        # honest internal SoftwareBackend that already rasterizes its base
        # RenderBackend ops, closing the delta against Metal's inherent-method
        # surface (see backend_directx.spl impl Engine2DExtended).
        assert_directx_extended_ops()

    it "vulkan: extended drawing-op parity with checked Metal surface (rounded_rect outline, gradient linear/radial, shadow, scaled+transform image) — absolute pixel oracle (or host-unavailable)":
        # Confirms VulkanBackend's existing emu-composed extended ops (already
        # present pre-change) produce the same exact pixels as the shared
        # backend_emu.spl/backend_emu_adv.spl algorithm DirectX/software use.
        assert_vulkan_extended_ops()

    it "SIMPLE_2D_BACKEND override selects software when it initializes (model: engine2d_env_backend_select_spec)":
        step("set SIMPLE_2D_BACKEND=software and confirm auto-detect honors it")
        env_set("SIMPLE_2D_BACKEND", "software")
        expect(Engine2D.detect_best_backend()).to_equal("software")
        step("clear the override so later runs auto-probe again")
        env_set("SIMPLE_2D_BACKEND", "")

        step("RUN VERDICT reading rule")
        # Deliberately NOT quoting the literal marker tokens: a verdict line that
        # contains them is counted by `grep -c` and inflates the very number it
        # is explaining (this turned a true 0 into a reported 1).
        print "[RUN VERDICT] A green run of this spec does NOT by itself mean a GPU was exercised."
        print "[RUN VERDICT] Count the per-lane GPU/PROVEN disclosure lines: those, and only those, are"
        print "[RUN VERDICT] frames a device produced (device_readback + handle > 0 + identity > 0 + full frame)."
        print "[RUN VERDICT] Every GPU/BRANCH/SKIPPED line proves NOTHING about the GPU path, and a"
        print "[RUN VERDICT] '[toctou]' line means the probe's prediction did not survive to the create."
