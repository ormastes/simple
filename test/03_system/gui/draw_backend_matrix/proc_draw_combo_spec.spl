# @cover src/lib/gc_async_mut/gpu/engine2d/engine.spl
# @cover src/lib/gc_async_mut/gpu/engine2d/backend_vulkan.spl
# @cover src/lib/gc_async_mut/gpu/engine2d/backend_cuda.spl
# @cover src/lib/gc_async_mut/gpu/engine2d/backend_metal.spl
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_renderer.spl
# @cover src/lib/common/ui/event.spl
# @tag: system, ui, engine2d, gpu, combination, headless
"""
# Processing × Drawing combination runs — headless offscreen readback

**Category:** Testing | **Status:** Implemented
**Plan:** doc/03_plan/ui/testing/gpu_draw_event_intensive_tests.md
**Requirements:** N/A
**Research:** N/A
**Design:** N/A

## Overview

`draw_backend_matrix_spec.spl` (this dir) pins ONE drawing backend at a time.
This spec instead runs full **processing × drawing COMBINATION** lanes on a
headless host, for three combos — **cuda/vulkan**, **vulkan/vulkan**, and **metal/vulkan**
(processing / drawing) — across three surfaces plus event handling:

1. **2D** — filled rect + line on a real vulkan framebuffer, `read_pixels()`
   absolute oracle.
2. **Web** — a styled-box HTML fixture rendered headlessly through the
   `simple_web_render_html_to_pixels_with_engine2d_backend(..., "vulkan")` lane;
   the box background AND the styled-box border color must both appear in the
   framebuffer (absolute-color oracle).
3. **GUI** — a widget-layer scene (titlebar bar + button rect) drawn through the
   `Engine2D` facade on vulkan, `read_pixels()` absolute oracle.
4. **Event** — a pointer `TouchPress` dispatched through the real
   `process_event` reducer moves `focused_id`; the button is re-rendered and the
   changed pixel flips from the NORMAL color to the FOCUSED color (both frames
   asserted against absolute values), while the background pixel is unchanged.

## Headless strategy (host has no display)

Every lane uses OFFSCREEN readback (`read_pixels()` → P6 PPM) — the established
oracle that needs no window, no `xvfb-run`, no container, no QEMU. Availability
is never a silent skip: a lane whose device is absent asserts the concrete
fail-closed classification instead.

## Honest processing/drawing split

- **cuda processing half** uses the real host probe `probe_cuda_processing()`
  and asserts EITHER outcome honestly, never a silent skip: if a CUDA device is
  present it must report `has_compute` (gate `cuda_2d_render`); if absent it must
  fail-closed with a concrete `feature_gate` (`cuda-device-unavailable` /
  `cuda_runtime` / `cuda_init`) and a non-empty reason. Whichever branch this
  host lands in, the vulkan drawing half runs in the same `it`. (On the host this
  was authored against, the probe reported `Initialized` / `cuda_2d_render`.)
- **vulkan processing half** exercises the payload-gated compute/offload lane
  (`assert_payload_gating(ComputeBackend.Vulkan)`): the reduce value equals the
  CPU oracle (60) in both gate branches while only the payload gate flips
  `ran_on_cpu` — an absolute oracle, not a masquerade.
- **metal processing half** exercises the same payload-gated compute/offload
  lane for `ComputeBackend.Metal`, so Metal cannot disappear from the processing
  matrix on non-macOS hosts.
- **vulkan drawing half** goes through `Engine2D.probe_backend`/
  `create_requested_backend("vulkan")`; if no Vulkan device is present it
  fail-closes on a concrete `reason` (never a silent skip).

## Syntax

`std.spec` matchers only; facades only (no raw `rt_*`); shared
`assert_color_eq` / `read_pixels_ppm` / `assert_payload_gating` helpers reused
from `test/helpers/gpu_draw_event_shared.spl`.

## Coverage matrix

| Processing | Drawing | 2D | GUI | Web | Event |
|------------|---------|----|-----|-----|-------|
| CUDA | Vulkan | real probe or fail-closed | real probe or fail-closed | real probe or fail-closed | real probe or fail-closed |
| Vulkan | Vulkan | payload gate + readback | payload gate + readback | payload gate + PPM oracle | payload gate + reducer-driven re-render |
| Metal | Vulkan | payload gate + readback | payload gate + readback | payload gate + PPM oracle | payload gate + reducer-driven re-render |
"""

use std.spec.*
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.color.{rgba}
use std.gpu.engine2d.backend_cuda.{probe_cuda_processing}
use std.gpu.engine2d.backend_probe.{BackendStatus}
use std.nogc_async_mut.compute.exec_target.{ComputeBackend}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_render_html_to_pixels_with_engine2d_backend}
use common.ui.widget.{WidgetNode, UIEvent, UIState}
use common.ui.builder.{column, button, build_tree}
use common.ui.event.{process_event}
use test.helpers.gpu_draw_event_shared.{
    assert_color_eq, read_pixels_ppm, assert_payload_gating,
    assert_provenance_invariants, report_outcome, report_no_frame}

val DRAW_W: i32 = 32
val DRAW_H: i32 = 24
val BG: u32 = rgba(3, 5, 7, 255)
val RECT_COLOR: u32 = rgba(255, 0, 0, 255)
val LINE_COLOR: u32 = rgba(0, 255, 0, 255)
val BTN_NORMAL: u32 = rgba(80, 80, 80, 255)
val BTN_FOCUSED: u32 = rgba(0, 120, 255, 255)

fn px_at(pixels: [u32], w: i32, x: i32, y: i32) -> u32:
    return pixels[(y * w + x) as i64]

fn count_color(pixels: [u32], color: u32) -> i32:
    var n = 0
    var i = 0
    while i < pixels.len():
        if pixels[i] == color:
            n = n + 1
        i = i + 1
    return n

# ---------------------------------------------------------------------------
# Processing halves.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Honest-provenance vocabulary and disclosure.
#
# Defined spec-locally on purpose: test/helpers/gpu_draw_event_shared.spl is a
# pure caps function shared by 7 specs and does no device work, so provenance
# helpers do not belong there.
#
# The label set is the authoritative one, enumerated from the construction sites
# rather than from memory:
#   /usr/bin/grep -rhoE 'engine2d_readback(_with_handle|_with_identity)?\([^,]+, *"[a-z_]+"' src/lib/ \
#     | /usr/bin/grep -oE '"[a-z_]+"$' | sort -u
# ---------------------------------------------------------------------------

fn source_is_device(source: text) -> bool:
    source == "device_readback" or source == "host_cache_after_device_present" or
        source == "swapchain_present" or source == "framebuffer_surface"

fn source_is_cpu(source: text) -> bool:
    source == "cpu_mirror" or source == "cpu_fallback"

# All of these carry an EMPTY pixel array, so no frame-content assertion is
# meaningful on them. `device_identity_unknown` (backend_cuda.spl:1050) means the
# device->host copy SUCCEEDED but the identity lookup returned <= 0 — a host
# condition, not a fabricated-provenance defect, so it must be classified rather
# than left to fail closed.
fn source_is_no_frame(source: text) -> bool:
    source == "completion_unknown" or source == "readback_failed" or
        source == "not_requested" or source == "device_identity_unknown" or
        source == "preflight_rejected" or source == "unavailable"

fn source_is_known(source: text) -> bool:
    source_is_device(source) or source_is_cpu(source) or source_is_no_frame(source)

fn device_proven(source: text, handle: i64, identity: i64, pixel_count: i64, expected_px: i64) -> bool:
    source == "device_readback" and handle > 0 and identity > 0 and
        pixel_count == expected_px

# Asserted UNCONDITIONALLY on every backend and every outcome — this is where the
# lane keeps its teeth. A device label without its credentials, or a CPU frame
# carrying device credentials, fails here regardless of which backend served it.
fn assert_provenance_invariants(label: text, source: text, handle: i64, identity: i64, pixel_count: i64, expected_px: i64, attests_identity: bool):
    if not source_is_known(source):
        print "[probe-provenance] {label}: UNKNOWN READBACK SOURCE '{source}' — outside the honest vocabulary, failing closed"
    expect(source_is_known(source)).to_equal(true)
    if source == "device_readback":
        expect(handle).to_be_greater_than(0)
        expect(pixel_count).to_equal(expected_px)
        # Only backends that actually publish an identity are held to one.
        if attests_identity:
            expect(identity).to_be_greater_than(0)
    if source_is_cpu(source):
        # Deliberately NOT asserting handle == 0 / identity == 0: under fd
        # exhaustion the seed surfaces those as nil rather than 0.
        expect(source_is_device(source)).to_equal(false)
        expect(device_proven(source, handle, identity, pixel_count, expected_px)).to_equal(false)

# Discloses what actually happened and returns whether a device is PROVEN, so
# callers assert against a fact rather than the probe's prediction.
fn report_outcome(label: text, source: text, handle: i64, identity: i64, pixel_count: i64, expected_px: i64) -> bool:
    if device_proven(source, handle, identity, pixel_count, expected_px):
        print "[probe-gpu] {label}: GPU-PROVEN — a device produced this frame (source={source} handle={handle} identity={identity} pixels={pixel_count})"
        return true
    if source_is_device(source):
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — device-sourced but not device-PROVEN (source={source} handle={handle} identity={identity} pixels={pixel_count}); this example proves NOTHING about the GPU path"
    else if source == "cpu_fallback":
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — the device was unavailable at use time (source=cpu_fallback); the probe's prediction did not survive to the create. This example proves NOTHING about the GPU path"
    else if source == "cpu_mirror":
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — CPU/software lane (source=cpu_mirror); this example proves NOTHING about the GPU path"
    else:
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — no frame produced (source={source}); this example proves NOTHING about the GPU path"
    false

# True when no frame came back at all, so the caller can skip frame-content
# assertions that would otherwise false-red on an empty pixel array.
fn report_no_frame(label: text, source: text) -> bool:
    if source_is_no_frame(source):
        print "[probe-gpu] {label}: FRAME ASSERTIONS SKIPPED — no frame was produced (source={source}); this example proves NOTHING about rendering correctness"
        return true
    false

fn assert_cuda_processing_half():
    step("processing=cuda: honest host probe (probe_cuda_processing), fail-closed")
    val p = probe_cuda_processing()
    expect(p.api_name).to_equal("cuda")
    if p.status == BackendStatus.Initialized:
        step("cuda device present: probe reports compute capability")
        expect(p.has_compute).to_equal(true)
    else:
        step("host-unavailable(cuda): concrete feature_gate classification, not silent skip")
        val gate = p.feature_gate
        val ok = (gate == "cuda-device-unavailable" or
                  gate == "cuda_runtime" or
                  gate == "cuda_init")
        assert_true(ok)
        expect(p.reason.len()).to_be_greater_than(0)

fn assert_vulkan_processing_half():
    step("processing=vulkan: payload-gated offload lane, absolute oracle (60==60, gate flips ran_on_cpu)")
    assert_payload_gating(ComputeBackend.Vulkan)

fn assert_metal_processing_half():
    step("processing=metal: payload-gated offload lane, absolute oracle (60==60, gate flips ran_on_cpu)")
    assert_payload_gating(ComputeBackend.Metal)

# ---------------------------------------------------------------------------
# Vulkan drawing half via the Engine2D facade. Returns true when a DEVICE was
# proven to have produced the frame — a FACT read off the readback, never the
# probe's prediction.
#
# `Engine2D.probe_backend` runs its own create+init+shutdown and throws it away;
# `create_requested_backend` is a SECOND, INDEPENDENT create with nothing cached
# between them, so the probe answer is only a PREDICTION. Branching the create
# assertion on it broke this lane both ways: at `ulimit -n 96` the probe said
# ready, the create returned Err and `created.unwrap()` blew up with
# `semantic: called unwrap on Err: backend unavailable: vulkan` (6/6 runs) — a
# false red; and a probe that says unavailable skipped the whole device branch
# while still printing a clean pass. Nothing below is asserted from the probe.
# Refs doc/08_tracking/bug/gpu_probe_then_create_toctou_2026-08-04.md
# ---------------------------------------------------------------------------
val DRAW_PX: i64 = (DRAW_W as i64) * (DRAW_H as i64)

fn vulkan_draw_scene_or_unavailable(scene: text) -> bool:
    step("drawing=vulkan: probe via Engine2D facade — a PREDICTION, not a fact")
    val probe = Engine2D.probe_backend(DRAW_W, DRAW_H, "vulkan")

    step("probe SELF-consistency: available/status/reason must agree with each other")
    expect(probe.available).to_equal(probe.is_ok())
    if not probe.is_ok():
        step("host-unavailable(vulkan): fail-closed classification (concrete reason, not a skip)")
        expect(probe.reason.len()).to_be_greater_than(0)

    step("create-attempt: the create runs REGARDLESS of what the probe predicted")
    val created = Engine2D.create_requested_backend(DRAW_W, DRAW_H, "vulkan")
    if probe.is_ok() != created.is_ok():
        print "[toctou] vulkan-{scene}: probe predicted ready={probe.is_ok()} but the independent create returned ok={created.is_ok()} — disclosed, never asserted"

    var eng: Engine2D? = nil
    match created:
        Ok(engine):
            eng = engine
        Err(message):
            step("create-failed(vulkan): fail-closed checkpoint carrying a concrete reason")
            expect(message.len()).to_be_greater_than(0)
            print "[probe-gpu] vulkan-{scene}: GPU BRANCH SKIPPED — the independent create failed ({message}); this example proves NOTHING about the GPU path"
            return false

    var e = eng.?
    step("create-success: requested vulkan resolves to its honest name")
    expect(e.backend_name()).to_equal("vulkan")

    e.clear(BG)
    if scene == "2d":
        step("draw 2D: filled rect + line on a real framebuffer")
        e.draw_rect_filled(4, 4, 10, 6, RECT_COLOR)
        e.draw_line(0, 18, 31, 18, LINE_COLOR, 1)
    else:
        step("draw GUI widget-layer scene: titlebar bar + button rect")
        e.draw_rect_filled(0, 0, DRAW_W, 4, LINE_COLOR)   # titlebar bar
        e.draw_rect_filled(8, 10, 10, 8, RECT_COLOR)      # button
    e.present()

    step("readback: read_pixels_with_source() — provenance and pixels from one download")
    val rb = e.read_pixels_with_source()
    val px = rb.pixels

    step("provenance invariants — unconditional, every outcome")
    val label = "vulkan-{scene}"
    assert_provenance_invariants(label, rb.source, rb.backend_handle, rb.device_identity, rb.pixel_count, DRAW_PX, true)
    val proven = report_outcome(label, rb.source, rb.backend_handle, rb.device_identity, rb.pixel_count, DRAW_PX)

    step("a successful vulkan create may never silently reclassify to cpu_mirror")
    # Verified in source: backend_vulkan.spl has no `cpu_mirror` site at all. A
    # degrading device sets the sticky `cpu_fallback_used` flag and reports
    # `cpu_fallback`, which stays a disclosed skip. `cpu_mirror` out of a vulkan
    # lane is therefore a silent CPU reclassification and must FAIL.
    expect(rb.source == "cpu_mirror").to_equal(false)

    if report_no_frame(label, rb.source):
        e.shutdown()
        return false

    step("absolute pixel oracle — holds on WHICHEVER backend served this frame")
    expect(px.len()).to_equal(DRAW_W * DRAW_H)
    if scene == "2d":
        assert_color_eq(px_at(px, DRAW_W, 8, 6), RECT_COLOR)
        assert_color_eq(px_at(px, DRAW_W, 15, 18), LINE_COLOR)
        assert_color_eq(px_at(px, DRAW_W, 1, 1), BG)
    else:
        assert_color_eq(px_at(px, DRAW_W, 12, 13), RECT_COLOR)   # button interior
        assert_color_eq(px_at(px, DRAW_W, 1, 1), LINE_COLOR)     # titlebar
        assert_color_eq(px_at(px, DRAW_W, 25, 20), BG)           # empty area

    if proven:
        step("device-proven frame: the download carries the drawn content, not a blank surface")
        expect(rb.checksum).to_be_greater_than(0)

    step("P6 PPM wrapper encodes a valid header")
    val ppm = read_pixels_ppm(DRAW_W, DRAW_H, px)
    expect(ppm.len()).to_be_greater_than(DRAW_W * DRAW_H * 3)
    expect(ppm[0]).to_equal(80u8)   # 'P'
    expect(ppm[1]).to_equal(54u8)   # '6'
    e.shutdown()
    return proven

# ---------------------------------------------------------------------------
# Web surface: styled-box HTML fixture rendered headlessly, vulkan drawing lane.
# ---------------------------------------------------------------------------
fn assert_web_vulkan_render():
    step("web: render a styled-box HTML fixture headlessly via the vulkan Engine2D web lane")
    val html = "<html><head><style>.card{width:40px;height:18px;background-color:#1d4ed8;border:2px solid #f59e0b}</style></head><body><div class='card'></div></body></html>"
    val w: i32 = 80
    val h: i32 = 48
    val pixels = simple_web_render_html_to_pixels_with_engine2d_backend(html, w, h, "vulkan")
    expect(pixels.len()).to_equal(w * h)
    step("PPM oracle: box background #1d4ed8 AND styled-box border #f59e0b both render (post Draw-IR fix)")
    expect(count_color(pixels, 0xFF1D4ED8u32)).to_be_greater_than(0)   # box background
    expect(count_color(pixels, 0xFFF59E0Bu32)).to_be_greater_than(0)   # styled-box border
    val ppm = read_pixels_ppm(w, h, pixels)
    expect(ppm[0]).to_equal(80u8)
    expect(ppm[1]).to_equal(54u8)

# ---------------------------------------------------------------------------
# Event surface: real reducer drives a re-render pixel change.
# ---------------------------------------------------------------------------
# Offscreen drawing surface: vulkan preferred, honest software offscreen
# fallback (always available, same absolute oracle) when no Vulkan device — the
# event chain, not the GPU device, is what this lane verifies.
fn open_draw_surface(w: i32, h: i32) -> Engine2D:
    # The vulkan create is attempted REGARDLESS of the probe: gating it on the
    # probe's prediction is what let a probe=unavailable run silently take the
    # software path and still print a clean pass. A divergence is disclosed, and
    # the software fallback create is kept HARD (pure software, owes no device,
    # so it must always succeed) rather than being unwrapped on faith.
    val vprobe = Engine2D.probe_backend(w, h, "vulkan")
    val cv = Engine2D.create_requested_backend(w, h, "vulkan")
    if vprobe.is_ok() != cv.is_ok():
        print "[toctou] event-surface: probe predicted ready={vprobe.is_ok()} but the independent create returned ok={cv.is_ok()} — disclosed, never asserted"
    if cv.is_ok():
        return cv.unwrap()
    print "[probe-gpu] event-surface: GPU BRANCH SKIPPED — no vulkan surface, using the software offscreen lane; this example proves NOTHING about the GPU path"
    val cs = Engine2D.create_requested_backend(w, h, "software")
    assert_true(cs.is_ok())
    return cs.unwrap()

fn render_button(eng: Engine2D, focused: bool):
    eng.clear(BG)
    var col = BTN_NORMAL
    if focused:
        col = BTN_FOCUSED
    # Button rect covers x 4..19, y 4..15 — press point (10,10) is inside.
    eng.draw_rect_filled(4, 4, 16, 12, col)
    eng.present()

fn assert_event_render_chain():
    step("build a one-button UI tree (real widget/builder path)")
    val root = column("combo_root", [button("combo_btn", "Click", "act")])
    val state0 = UIState.new(build_tree(root))

    step("frame 1: render button in NORMAL color (state not focused)")
    val w: i32 = 24
    val h: i32 = 16
    val event_px: i64 = (w as i64) * (h as i64)
    var s1 = open_draw_surface(w, h)
    render_button(s1, state0.focused_id == "combo_btn")
    val rb1 = s1.read_pixels_with_source()
    val f1 = rb1.pixels
    # `attests_identity` is read off the surface that ACTUALLY served the frame,
    # not off any probe: only the vulkan backend publishes a device identity.
    assert_provenance_invariants("event-frame1", rb1.source, rb1.backend_handle, rb1.device_identity, rb1.pixel_count, event_px, s1.backend_name() == "vulkan")
    report_outcome("event-frame1", rb1.source, rb1.backend_handle, rb1.device_identity, rb1.pixel_count, event_px)
    if s1.backend_name() == "vulkan":
        expect(rb1.source == "cpu_mirror").to_equal(false)
    val f1_no_frame = report_no_frame("event-frame1", rb1.source)
    s1.shutdown()

    step("dispatch TouchPress inside the button rect — real reducer moves focus")
    val pressed = process_event(state0, UIEvent.TouchPress(x: 10, y: 10))
    expect(pressed.focused_id).to_equal("combo_btn")

    step("frame 2: re-render; button pixel now FOCUSED color, driven by the new state")
    var s2 = open_draw_surface(w, h)
    render_button(s2, pressed.focused_id == "combo_btn")
    val rb2 = s2.read_pixels_with_source()
    val f2 = rb2.pixels
    assert_provenance_invariants("event-frame2", rb2.source, rb2.backend_handle, rb2.device_identity, rb2.pixel_count, event_px, s2.backend_name() == "vulkan")
    report_outcome("event-frame2", rb2.source, rb2.backend_handle, rb2.device_identity, rb2.pixel_count, event_px)
    if s2.backend_name() == "vulkan":
        expect(rb2.source == "cpu_mirror").to_equal(false)
    val f2_no_frame = report_no_frame("event-frame2", rb2.source)
    s2.shutdown()

    if f1_no_frame or f2_no_frame:
        return

    step("verify: changed pixel flips NORMAL -> FOCUSED (absolute both frames); background unchanged")
    assert_color_eq(px_at(f1, w, 10, 10), BTN_NORMAL)
    assert_color_eq(px_at(f2, w, 10, 10), BTN_FOCUSED)
    assert_false(px_at(f1, w, 10, 10) == px_at(f2, w, 10, 10))
    assert_color_eq(px_at(f1, w, 1, 1), BG)
    assert_color_eq(px_at(f2, w, 1, 1), BG)

describe "Processing × Drawing combination runs — headless offscreen (cuda/vulkan, vulkan/vulkan, metal/vulkan)":

    it "cuda/vulkan — 2D: cuda processing honest probe (device or fail-closed) + vulkan drawing readback":
        assert_cuda_processing_half()
        vulkan_draw_scene_or_unavailable("2d")

    it "vulkan/vulkan — 2D: vulkan payload-gated processing + vulkan drawing readback":
        assert_vulkan_processing_half()
        vulkan_draw_scene_or_unavailable("2d")

    it "metal/vulkan — 2D: metal payload-gated processing + vulkan drawing readback":
        assert_metal_processing_half()
        vulkan_draw_scene_or_unavailable("2d")

    it "cuda/vulkan — GUI widget-layer scene: cuda processing honest probe + vulkan drawing readback":
        assert_cuda_processing_half()
        vulkan_draw_scene_or_unavailable("gui")

    it "vulkan/vulkan — GUI widget-layer scene: vulkan processing + vulkan drawing readback":
        assert_vulkan_processing_half()
        vulkan_draw_scene_or_unavailable("gui")

    it "metal/vulkan — GUI widget-layer scene: metal processing + vulkan drawing readback":
        assert_metal_processing_half()
        vulkan_draw_scene_or_unavailable("gui")

    it "cuda/vulkan — Web: cuda processing honest probe + vulkan-drawn HTML fixture PPM oracle":
        assert_cuda_processing_half()
        assert_web_vulkan_render()

    it "vulkan/vulkan — Web: vulkan processing + vulkan-drawn HTML fixture PPM oracle":
        assert_vulkan_processing_half()
        assert_web_vulkan_render()

    it "metal/vulkan — Web: metal processing + vulkan-drawn HTML fixture PPM oracle":
        assert_metal_processing_half()
        assert_web_vulkan_render()

    it "cuda/vulkan — Event: pointer press moves focus, re-render flips the button pixel":
        assert_cuda_processing_half()
        assert_event_render_chain()

    it "vulkan/vulkan — Event: pointer press moves focus, re-render flips the button pixel":
        assert_vulkan_processing_half()
        assert_event_render_chain()

    it "metal/vulkan — Event: pointer press moves focus, re-render flips the button pixel":
        assert_metal_processing_half()
        assert_event_render_chain()

        step("RUN VERDICT reading rule")
        # Deliberately NOT quoting the literal marker tokens: a verdict line that
        # contains them is counted by `grep -c` and inflates the very number it
        # is explaining.
        print "[RUN VERDICT] A green run of this spec does NOT by itself mean a GPU was exercised."
        print "[RUN VERDICT] Count the per-lane GPU/PROVEN disclosure lines: those, and only those, are"
        print "[RUN VERDICT] frames a device produced (device_readback + handle > 0 + identity > 0 + full frame)."
        print "[RUN VERDICT] Every GPU/BRANCH/SKIPPED line proves NOTHING about the GPU path, and a"
        print "[RUN VERDICT] '[toctou]' line means the probe's prediction did not survive to the create."
