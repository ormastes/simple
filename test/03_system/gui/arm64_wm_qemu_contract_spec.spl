# @tag:system
# @tag:gui
# @tag:arm64
#
# Source-contract coverage for the ARM64 SimpleOS WM QEMU lane.
#
# This source-contract coverage complements the live ramfb screendump proof. It
# keeps the documented ARM64 path tied to the actual entry source and acceptance
# markers so the multi-arch GUI plan cannot drift.

use std.spec.*
use os.qemu_runner.{
    build_scenario_command,
    build_qemu_command,
    get_scenario,
    get_arm64_wm_qemu_target,
    arm64_wm_qemu_cpu_for_host,
    arm64_wm_qemu_extra_for_host,
    os_native_build_args,
    qemu_scenario_serial_acceptance_reason,
    scenario_test_timeout_ms,
    scenario_target
}
use app.io.mod.{file_exists, file_read_text, process_run_timeout}

fn _guide_path() -> text:
    "doc/07_guide/platform/simpleos_arm64_wm_qemu.md"

fn _entry_path() -> text:
    "examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl"

fn _desktop_shell_path() -> text:
    "src/os/desktop/shell.spl"

fn _ramfb_path() -> text:
    "src/os/kernel/arch/arm64/ramfb.spl"

fn _console_path() -> text:
    "src/os/kernel/arch/arm64/console.spl"

fn _arm64_boot_stubs_path() -> text:
    "examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c"

fn _freestanding_engine_path() -> text:
    "src/lib/gc_async_mut/gpu/engine2d/engine_baremetal.spl"

fn _freestanding_backend_path() -> text:
    "src/lib/gc_async_mut/gpu/engine2d/backend_baremetal.spl"

fn _font_registry_path() -> text:
    "src/lib/common/encoding/font_registry.spl"

fn _simple_web_env_target_path() -> text:
    "src/lib/gc_async_mut/gpu/browser_engine/simple_web_env_target.spl"

fn _draw_ir_executor_path() -> text:
    "src/lib/gc_async_mut/gpu/engine2d/draw_ir_adv.spl"

fn _readiness_script_path() -> text:
    "scripts/check/check-simpleos-arm64-wm-qemu-readiness.shs"

fn _attested_builder_path() -> text:
    "scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs"

fn _qmp_evidence_path() -> text:
    "scripts/check/check-simpleos-arm64-qmp-input-evidence.shs"

fn _cli_path() -> text:
    "src/app/cli/_CliMain/args_and_os_commands.spl"

fn _complete_arm64_wm_serial() -> text:
    "[desktop-gui-arm64] boot\n" +
    "[WM] fw_cfg sig: 81 69 77 85\n" +
    "[WM] Found etc/ramfb in fw_cfg\n" +
    "[WM] ramfb configured successfully via fw_cfg DMA\n" +
    "[desktop-gui-arm64] desktop-ready revision=1\n"

describe "ARM64 SimpleOS WM QEMU contract":

    it "uses real map-backed dictionary views and stable backend receivers":
        val runtime = file_read_text(_arm64_boot_stubs_path())
        val engine = file_read_text(_freestanding_engine_path())
        val draw_ir = file_read_text(_draw_ir_executor_path())

        expect(runtime).to_contain(
            "RuntimeValue rt_dict_keys(RuntimeValue d) { return rt_map_keys(d); }")
        expect(runtime).to_contain(
            "RuntimeValue rt_dict_values(RuntimeValue d) { return rt_map_values(d); }")
        expect(runtime).not_to_contain(
            "RuntimeValue rt_dict_keys(RuntimeValue d) { (void)d; return NIL_VALUE; }")
        expect(engine).not_to_contain("self.software = Some(backend)")
        expect(engine).not_to_contain("self.baremetal = Some(backend)")
        expect(draw_ir).not_to_contain(
            "_engine2d_embed_offscreen_acquire(owner: Engine2D, w: i32, h: i32) -> Result<Engine2D, text>")
        expect(draw_ir).to_contain("return cached")
        expect(draw_ir).not_to_contain(" = outcome.engine")
        expect(draw_ir).not_to_contain(" = inner.engine")

    it "keeps the guide bound to the canonical ARM64 desktop entry and ramfb target":
        expect(file_exists(_guide_path())).to_equal(true)
        expect(file_exists(_entry_path())).to_equal(true)
        expect(file_exists(_ramfb_path())).to_equal(true)
        expect(file_exists(_console_path())).to_equal(true)
        val guide = file_read_text(_guide_path())
        expect(guide).to_contain("examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl")
        expect(guide.contains("examples/09_embedded/simple_os/arch/arm64/wm_entry.spl")).to_equal(false)
        expect(guide).to_contain("--target aarch64-unknown-none")
        expect(guide).to_contain("qemu-system-aarch64")
        expect(guide).to_contain("-machine virt")
        expect(guide).to_contain("-serial file:build/os/arm64_wm_serial.log")
        expect(guide).to_contain("-kernel build/os/simpleos_arm64_wm.elf")
        expect(guide).to_contain("-device ramfb")
        expect(guide).to_contain("build/os/simpleos_arm64_wm.elf")
        expect(guide).to_contain("bin/simple os build --scenario=arm64-wm-ramfb")
        expect(guide).to_contain("bin/simple os run --scenario=arm64-wm-ramfb")
        expect(guide).to_contain("bin/simple os test --scenario=arm64-wm-ramfb")

    it "keeps documented serial markers present in the ARM64 WM source":
        val guide = file_read_text(_guide_path())
        val entry = file_read_text(_entry_path())
        val ramfb = file_read_text(_ramfb_path())
        expect(guide).to_contain("[desktop-gui-arm64] boot")
        expect(guide).to_contain("[WM] fw_cfg sig: 81 69 77 85")
        expect(guide).to_contain("[WM] Found etc/ramfb in fw_cfg")
        expect(guide).to_contain("[WM] ramfb configured successfully via fw_cfg DMA")
        expect(guide).to_contain("[desktop-gui-arm64] desktop-ready revision=")
        expect(entry).to_contain("[desktop-gui-arm64] boot")
        expect(entry).to_contain("[desktop-gui-arm64] desktop-ready revision=")

    it "initializes entry-closure module globals exactly before spl_start":
        val boot = file_read_text(_arm64_boot_stubs_path())
        expect(boot).to_contain("extern void __simple_call_module_inits(void) __attribute__((weak));")
        expect(boot).to_contain("if (__simple_call_module_inits) {")
        expect(boot).to_contain("__simple_call_module_inits();")
        expect(boot.index_of("__simple_call_module_inits();") < boot.index_of("spl_start();")).to_equal(true)

    it "uses the raw freestanding integer ABI for text slicing":
        val stubs = file_read_text(_arm64_boot_stubs_path())
        expect(stubs).to_contain("int64_t a = (int64_t)start;")
        expect(stubs).to_contain("int64_t b = (int64_t)end;")
        expect(stubs.contains("int64_t a = DECODE_INT(start);")).to_be(false)

    it "keeps ARM64 evidence UART and local WM independent of unavailable host services":
        val console = file_read_text(_console_path())
        val shell = file_read_text("src/os/desktop/shell.spl")
        val wm = file_read_text("src/os/services/wm/wm_service.spl")
        expect(console).to_contain("val PL011_BASE: u64 = 0x09000000u64")
        expect(console).to_contain("serial_println(msg)")
        expect(shell).to_contain("self.wm.init_local()")
        expect(wm).to_contain("me init_local() -> bool:")
        expect(wm).to_contain("if not self.initialized or self.local_only:")

    it "keeps small frame scratch arrays bounded on the non-reclaiming ARM heap":
        val boot = file_read_text(_arm64_boot_stubs_path())
        expect(boot).to_contain("if (cap <= 0) cap = 16;")
        expect(boot).to_contain("if (cap < 16) cap = 16;")
        expect(boot).to_contain("static RuntimeValue _single_byte_text_cache[256];")
        expect(boot).to_contain("return arm64_single_byte_text((uint8_t)s->data[i]);")
        expect(boot).to_contain("RuntimeValue ch = arm64_single_byte_text((uint8_t)s->data[i]);")
        expect(boot).to_contain("? arm64_single_byte_text(lead)")
        expect(boot).to_contain("return arm64_single_byte_text((uint8_t)c);")
        expect(boot).to_contain("#define ARM64_LITERAL_CACHE_CAPACITY 32768U")
        expect(boot).to_contain("#define ARM64_LITERAL_CACHE_MAX_PROBES 128U")
        expect(boot).to_contain("[heap-string-progress] count=")
        expect(boot).to_contain("[literal-cache-fallback] count=")
        expect(boot).to_contain("RuntimeValue rt_array_repeat(RuntimeValue v, RuntimeValue n) {")
        expect(boot).to_contain("array->len = (uint64_t)count;")
        expect(boot).to_contain("size_t bytes = sizeof(RuntimeArray) + (size_t)capacity * sizeof(RuntimeValue);")
        expect(boot.contains("RuntimeValue result = rt_array_new((RuntimeValue)count);")).to_equal(false)
        expect(boot.contains("rt_array_repeat(RuntimeValue v, RuntimeValue n) { (void)v; (void)n; return NIL_VALUE; }")).to_equal(false)
        expect(boot).to_contain("if (entry->data == ptr && entry->len == len) return entry->value;")

    it "reuses retained web pixel caches before allocating frame surfaces":
        val shell = file_read_text("src/os/desktop/shell.spl")
        val lookup = shell.index_of("var cache_index = -1")
        val create = shell.index_of("var cache = if cache_index >= 0:")
        expect(lookup >= 0).to_equal(true)
        expect(create > lookup).to_equal(true)

    it "keeps Simple Web child links at the canonical signed index width":
        val foundation = file_read_text("src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_foundation.spl")
        expect(foundation).to_contain("first_child: [i64]")
        expect(foundation).to_contain("next_sibling: [i64]")
        expect(foundation).to_contain("var first_child: [i64] = [-1; node_count]")
        expect(foundation).to_contain("var next_sibling: [i64] = [-1; node_count]")

    it "skips collapsed-border style traversal for documents without tables":
        val layout = file_read_text("src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout.spl")
        val resolver = layout.index_of("fn simple_web_resolve_collapsed_table_borders(")
        val guard = layout.index_of("if not has_table:")
        val style_scan = layout.index_of("var resolved = styles")
        expect(resolver >= 0).to_equal(true)
        expect(guard > resolver).to_equal(true)
        expect(style_scan > guard).to_equal(true)

    it "allocates independent mutable paint-context buckets":
        val paint = file_read_text("src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_layout.spl")
        expect(paint).to_contain("while context_slot < node_count + 1:")
        expect(paint).to_contain("members.push([])")
        expect(paint).to_contain("child_contexts.push([])")
        expect(paint.contains("var members: [[i32]] = [[]; node_count + 1]")).to_equal(false)
        expect(paint.contains("var child_contexts: [[i32]] = [[]; node_count + 1]")).to_equal(false)

    it "attributes strict WM content-frame admission failures":
        val executor = file_read_text("src/os/compositor/engine2d_wm_frame_executor.spl")
        expect(executor).to_contain("[wm-frame-candidate] window_id=")
        expect(executor).to_contain("checksum={candidate.checksum}/{candidate_checksum}")

    it "routes target-neutral file probes and font byte reads through the guest VFS":
        val entry = file_read_text(_entry_path())
        expect(entry).to_contain("@export(\"C\", name: \"rt_file_exists\")")
        expect(entry).to_contain("g_vfs_file_exists(path)")
        expect(entry).to_contain("@export(\"C\", name: \"rt_file_read_bytes\")")
        expect(entry).to_contain("g_vfs_read_file_bytes(path)")

    it "keeps SimpleOS selected-font configuration independent of host environment ABI":
        val registry = file_read_text(_font_registry_path())
        expect(registry).to_contain("@cfg(\"os\", \"simpleos\")\nfn _font_registry_asset_root()")
        expect(registry).to_contain("@cfg(\"os\", \"simpleos\")\nfn _font_registry_runtime_mode()")
        expect(registry).to_contain("_selected_font_asset_candidate_for_path_with_root(path, _font_registry_asset_root())")

    it "unwraps the optional rasterizer before calling class methods":
        val renderer = file_read_text("src/lib/nogc_sync_mut/text_layout/font_renderer.spl")
        expect(renderer).to_contain("val active = rasterizer.unwrap()")
        expect(renderer).to_contain("val face_generation = active.cache_identity_generation()")
        expect(renderer).to_contain("val face_identity = active.cache_identity()")

    it "owns the Simple Web environment facade instead of re-exporting a private host alias":
        val target = file_read_text(_simple_web_env_target_path())
        expect(target).to_contain("fn env_get(key: text) -> text?:")
        expect(target).to_contain("_simple_web_env_get_target(key)")
        expect(target).to_contain("simple_web_env_simpleos.{simple_web_env_get as _simple_web_env_get_target}")
        expect(entry.contains("[WM] Glass desktop rendered!")).to_equal(false)
        expect(ramfb).to_contain("[WM] fw_cfg sig:")
        expect(ramfb).to_contain("[WM] Found etc/ramfb in fw_cfg")
        expect(ramfb).to_contain("[WM] ramfb configured successfully via fw_cfg DMA")

    it "documents the platform-specific adapter boundary and canonical Engine2D executor":
        val entry = file_read_text(_entry_path())
        val ramfb = file_read_text(_ramfb_path())
        val console = file_read_text(_console_path())
        expect(entry).to_contain("Canonical ARM64 production desktop entry for QEMU virt ramfb")
        expect(entry).to_contain("FramebufferDriver.from_scanout_raw(")
        expect(entry).to_contain("Engine2dWmFrameExecutor.create(")
        expect(entry).to_contain("uart_data_ready()")
        expect(entry).to_contain("uart_read_char()")
        expect(entry.contains("wm_entry_io")).to_equal(false)
        expect(entry.contains("extern fn rt_")).to_equal(false)
        expect(ramfb).to_contain("fn _fw_cfg_data() -> u64: 0x09020000u64")
        expect(ramfb).to_contain("fn _fw_cfg_selector() -> u64: 0x09020008u64")
        expect(ramfb).to_contain("fn _fw_cfg_dma() -> u64: 0x09020010u64")
        expect(ramfb).to_contain("etc/ramfb")
        expect(ramfb).to_contain("mmio_memory_barrier()")
        expect(console).to_contain("pl011_data_ready")

    it "selects a concrete freestanding Engine2D without replacing Draw IR":
        val target = file_read_text(_freestanding_engine_path())
        val executor = file_read_text(_draw_ir_executor_path())
        val package_root = file_read_text("src/lib/gc_async_mut/gpu/engine2d/mod.spl")
        val os_root = file_read_text("src/os/mod.spl")
        expect(target).to_contain("baremetal: BaremetalBackend?")
        expect(target).to_contain("software: SoftwareBackend?")
        expect(target.contains("backend: RenderBackend")).to_equal(false)
        expect(target.contains("backend_metal")).to_equal(false)
        expect(target.contains("backend_vulkan")).to_equal(false)
        expect(target).to_contain("fn current_font_identity() -> text:")
        expect(target).to_contain("\"bitmap-5x7\"")
        expect(target.contains("if val Some(backend) = self.baremetal:")).to_equal(false)
        expect(target.contains("if val Some(backend) = self.software:")).to_equal(false)
        expect(target).to_contain("var backend = self.software.unwrap()")
        expect(target).to_contain("static fn create_requested_backend(")
        expect(target).to_contain("Err(\"backend-unavailable-on-simpleos\")")
        expect(target.contains("backend_cuda")).to_equal(false)
        expect(executor).to_contain("@cfg(\"os\", \"simpleos\")")
        expect(executor.contains("@cfg(unix or windows)")).to_equal(false)
        expect(executor).to_contain("engine_baremetal.{Engine2D}")
        expect(executor).to_contain("engine2d_draw_ir_adv_composition_present_with_images")
        expect(package_root).to_contain("ENGINE2D_SIMPLEOS_TARGET_ROOT")
        expect(package_root).to_contain("@when(os = \"simpleos\")")
        expect(os_root).to_contain("SIMPLEOS_TARGET_ROOT")

    it "attests the selected compiler and Simple-core runtime without fabricated stubs":
        val builder = file_read_text(_attested_builder_path())
        val consumer = file_read_text(_qmp_evidence_path())
        expect(builder).to_contain("SIMPLEOS_ATTESTED_COMPILER")
        expect(builder).to_contain("SIMPLE_SIMPLE_CORE_PATH=$SIMPLE_CORE_DIR")
        expect(builder).to_contain("SIMPLE_NATIVE_RUNTIME_BUNDLE=simple-core")
        expect(builder).to_contain("SIMPLE_NATIVE_BUILD_ENTRY=$ENTRY")
        expect(builder).to_contain("--runtime-bundle simple-core")
        expect(builder).to_contain("SIMPLE_NO_STUB_FALLBACK=1")
        expect(builder).to_contain("SIMPLE_STRICT_FABRICATED_STUB_RATCHET=1")
        expect(builder).to_contain("simple_core_sha256=$PRE_SIMPLE_CORE_SHA256")
        expect(consumer).to_contain("MANIFEST_SIMPLE_CORE_SHA256")
        expect(consumer).to_contain("canonical-simple-core-mutated-during-run")
        expect(consumer).to_contain("except (ConnectionRefusedError, FileNotFoundError) as exc:")
        expect(consumer).to_contain("qmp connect timeout")

    it "admits at least 39 guest-timed canonical WM frames per second":
        val entry = file_read_text(_entry_path())
        val shell = file_read_text(_desktop_shell_path())
        val consumer = file_read_text(_qmp_evidence_path())
        expect(entry).to_contain("while warmup_frame < 4:")
        expect(entry).to_contain("while measured_frame < 64:")
        expect(entry).to_contain("shell.replay_baremetal_prepared_frame(wm_frame_executor)")
        expect(shell).to_contain("me replay_baremetal_prepared_frame(executor: Engine2dWmFrameExecutor) -> i64:")
        expect(shell).to_contain("val rendered_revision = executor.render(")
        expect(shell).to_contain("executor.set_repeated_evidence(false)")
        expect(shell).to_contain("self.baremetal_prepared_content_frames")
        expect(entry).to_contain("rt_simpleos_frame_heap_checkpoint()")
        expect(entry).to_contain("rt_simpleos_frame_heap_restore(")
        expect(entry).to_contain("boot_monotonic_elapsed_us(measured_started_us, measured_finished_us)")
        expect(entry).to_contain("measured_fps_x1000 < 39000")
        expect(entry).to_contain("[engine2d-fps] path=shared-wm-draw-ir-engine2d backend=baremetal")
        expect(entry).to_contain("simd_fill_hits_delta={measured_simd_hits_delta}")
        expect(entry).to_contain("simd_fill_chunks_delta={measured_simd_chunks_delta}")
        expect(consumer).to_contain("def require_fps_receipt(text):")
        expect(consumer).to_contain("SIMPLEOS_QMP_READY_TIMEOUT_SECONDS")
        expect(consumer).to_contain("minimum_fps_x1000 != 39000")
        expect(consumer).to_contain("fps_x1000 < minimum_fps_x1000")
        expect(consumer).to_contain("arm64_qmp_input_fps_x1000=$(field fps_x1000)")

    it "routes flat opaque image rows through the bounded SIMD fill owner":
        val backend = file_read_text(_freestanding_backend_path())
        val surface = file_read_text("src/lib/gc_async_mut/gpu/engine2d/framebuffer_surface.spl")
        val driver = file_read_text("src/os/drivers/framebuffer/fb_driver.spl")
        val runtime = file_read_text(_arm64_boot_stubs_path())
        val entry = file_read_text(_entry_path())
        expect(surface).to_contain("fn framebuffer_blit_row_argb(pixels: [u32]")
        expect(driver).to_contain("extern fn rt_gui_blit_row4")
        expect(backend).to_contain("self.fb.framebuffer_blit_row_argb(")
        expect(runtime).to_contain("RuntimeValue rt_gui_blit_row4(")
        expect(runtime).to_contain("arm64_blit_raw_pixel(")
        expect(runtime).to_contain("while (i + 16u <= count)")
        expect(runtime).to_contain("trusted_opaque")
        expect(runtime).to_contain("ld2 {v0.4s, v1.4s}")
        expect(runtime).to_contain("if (opaque) {")
        expect(runtime).to_contain("rt_gui_store4(dst + i, packed)")
        expect(runtime).to_contain("arm64_blend_pixel(src, dst[i + lane])")
        expect(runtime).to_contain("scaled_alpha = source_alpha * opacity_milli / 1000u")
        expect(runtime).to_contain("g_gui_simd_fill_scalar_parity_checks < 64u")
        expect(runtime).to_contain("while (remaining >= 16u)")
        expect(runtime).to_contain("if (da == 255u)")
        expect(runtime).to_contain("RuntimeValue rt_gui_blit_row_calls(void)")
        expect(entry).to_contain("[engine2d-blit-profile]")
        val executor = file_read_text("src/os/compositor/engine2d_wm_frame_executor.spl")
        expect(executor).to_contain("[wm-exec-profile]")
        val blur_target = file_read_text("src/lib/gc_async_mut/gpu/engine2d/blur_pixels_target.spl")
        expect(blur_target).to_contain("rt_engine2d_box_blur_region")
        expect(runtime).to_contain("RuntimeValue rt_engine2d_box_blur_region(")
        expect(runtime).to_contain("static RuntimeArray *arm64_blit_pixel_array(")
        expect(runtime).to_contain("RuntimeValue rt_gui_blit_rect4(")
        expect(backend).to_contain("framebuffer_blit_rect_argb(pixels, source, xy, wh)")
        expect(backend).to_contain("me draw_ir_image_exact_status(")
        expect(runtime).to_contain("array->len > array->cap")
        expect(runtime).to_contain("uint64_t *prefix = (uint64_t *)malloc")
        val draw_ir = file_read_text(_draw_ir_executor_path())
        expect(draw_ir).to_contain("_engine2d_parent_material_cache_key(")
        expect(draw_ir).to_contain("batch, visual_key, parent_padding")
        expect(draw_ir).to_contain("composition.scene_key")
        expect(draw_ir).to_contain("if visual_key != \"\" and material_cache_slot >= 0:")
        expect(draw_ir).to_contain("engine2d_draw_ir_adv_composition_present_prepared_with_images_evidence")
        expect(draw_ir).to_contain("transport, composition.scene_key")
        expect(executor).to_contain("if self.emit_repeated_evidence:")
        expect(executor).to_contain("engine2d_draw_ir_adv_composition_present_prepared_with_images_evidence(")
        expect(executor).to_contain("prepared_composition: DrawIrComposition")
        expect(executor).to_contain("prepared_images: [Engine2dResolvedDrawIrImage]")
        expect(executor).to_contain("if prepared_replay_eligible:")
        expect(executor).to_contain("self.prepared_composition = local_composition")
        expect(draw_ir).to_contain("cached_pixels.len() == embedding.width.to_i64() * embedding.height.to_i64()")
        expect(draw_ir).to_contain("eng.draw_ir_composite_readback(")
        expect(draw_ir).to_contain("_engine2d_parent_material_key_c")
        expect(draw_ir).to_contain("if samples_parent:")
        val engine = file_read_text(_freestanding_engine_path())
        expect(engine).to_contain("backend.draw_image_opacity_status(")
        expect(engine).to_contain("me draw_ir_blit_image_exact_status(")
        expect(draw_ir).to_contain("eng.draw_ir_blit_image_exact_status(")
        expect(draw_ir).to_contain("offsets: [i32]")
        expect(draw_ir).to_contain("direct_offsets: [i32] = [embedding.x, embedding.y]")
        expect(draw_ir).to_contain("batch_offsets: [i32] = [batch.embedding.x, batch.embedding.y]")
        val wm_projection = file_read_text("src/lib/common/ui/window_scene_draw_ir.spl")
        expect(wm_projection).to_contain("draw_ir_embedding_config_geometry")
        expect(wm_projection).not.to_contain("draw_ir_embedding_config(")
        expect(wm_projection).to_contain("content.x, content.y, content.width, content.height")
        expect(wm_projection).to_contain("draw_ir_style_prop(\"wm-absolute-x\"")
        expect(wm_projection).to_contain("wmabs:{content.x}:{content.y}")
        expect(draw_ir).to_contain("command.component_id.starts_with(\"wmabs:\")")
        expect(draw_ir).to_contain("command.image_uri.starts_with(\"wmabs:\")")
        expect(draw_ir).to_contain("image_xy_index = image_index * 2")
        expect(draw_ir).to_contain("_e2d_prepared_image_xy_active")
        expect(executor).to_contain("prepared_image_xy")
        expect(executor).to_contain("prepared_image_x0")
        expect(executor).to_contain("replay_image_xy")
        expect(executor).to_contain("set_top_content_positions(")
        expect(shell).to_contain("executor.set_top_content_positions(")
        expect(executor).to_contain("self.engine.copy_pixels_region_into(")
        expect(executor).to_contain("self.prepared_images = replay_images")
        expect(executor).to_contain("[wm-prepared-capture]")
        expect(executor).to_contain("engine2d_draw_ir_adv_composition_present_prepared_with_images_xy_evidence(")
        expect(executor).to_contain("shared_wm_content_frame_positioned_image_uri(")
        expect(draw_ir).to_contain("command.computed_style, \"wm-absolute-x\"")
        expect(draw_ir).to_contain("batch.batch_id.starts_with(\"content-\")")
        expect(draw_ir).to_contain("if eng.backend_name() == \"baremetal\":")
        expect(draw_ir).to_contain("[engine2d-image-profile]")
        expect(backend).to_contain("val opaque_runs_enabled = self.mask_w <= 0 or self.mask_h <= 0")
        expect(backend).to_contain("if next_idx >= pixel_count or pixels[next_idx] != c:")
        expect(backend).to_contain("if run_len >= 4:")
        expect(backend).to_contain("self.draw_rect_filled(px, py, run_len, 1, c)")
        expect(backend).to_contain("else if color_a(c) > 0:")
        expect(backend).to_contain("blend(c, dst)")

    it "has a host readiness probe for the live ARM64 QEMU ramfb lane":
        val guide = file_read_text(_guide_path())
        expect(file_exists(_readiness_script_path())).to_equal(true)
        expect(guide).to_contain("scripts/check/check-simpleos-arm64-wm-qemu-readiness.shs")
        val result = process_run_timeout("sh", [_readiness_script_path()], 10000)
        if result[2] != 0:
            print "[arm64_wm_qemu_contract_spec] readiness probe failed:\n{result[0]}{result[1]}"
        expect(result[2]).to_equal(0)
        expect(result[0]).to_contain("arm64_wm_qemu_readiness: ready")
        expect(result[0]).to_contain("qemu_system: qemu-system-aarch64")
        expect(result[0]).to_contain("machine_virt: true")
        expect(result[0]).to_contain("ramfb_device: true")
        expect(result[0]).to_contain("dry_run_parse: true")
        expect(result[0].contains("accelerator: hvf") or result[0].contains("accelerator: kvm") or
            result[0].contains("accelerator: tcg")).to_equal(true)
        expect(result[0].contains("cpu: host") or result[0].contains("cpu: cortex-a57")).to_equal(true)

    it "keeps the runner portable across Darwin and Linux hosts":
        expect(arm64_wm_qemu_cpu_for_host("macos", "aarch64")).to_equal("host")
        expect(arm64_wm_qemu_extra_for_host("macos", "aarch64")).to_contain("hvf")
        expect(arm64_wm_qemu_cpu_for_host("linux", "x86_64")).to_equal("cortex-a57")
        expect(arm64_wm_qemu_extra_for_host("linux", "x86_64")).to_contain("tcg")

    it "defines a host-runnable ARM64 WM QEMU target and launch command":
        val target = get_arm64_wm_qemu_target()
        val build_args = os_native_build_args(target, "llvm")
        expect(build_args).to_contain("examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl")
        expect(build_args).to_contain("aarch64-unknown-none")
        expect(build_args).to_contain("examples/09_embedded/simple_os/arch/arm64/linker.ld")
        expect(build_args).to_contain("build/os/simpleos_arm64_wm.elf")
        expect(build_args).to_contain("--entry-closure")
        expect(build_args).to_contain("--timeout")
        expect(build_args).to_contain("180")

        val qemu_args = build_qemu_command(target)
        expect(qemu_args).to_contain("qemu-system-aarch64")
        expect(qemu_args).to_contain("-machine")
        expect(qemu_args).to_contain("virt")
        expect(qemu_args).to_contain("-accel")
        expect(qemu_args).to_contain(target.qemu_extra[1])
        expect(qemu_args).to_contain("-cpu")
        expect(qemu_args).to_contain(target.qemu_cpu)
        expect(qemu_args).to_contain("-kernel")
        expect(qemu_args).to_contain("build/os/simpleos_arm64_wm.elf")
        expect(qemu_args).to_contain("-device")
        expect(qemu_args).to_contain("ramfb")
        expect(qemu_args).to_contain("-display")
        expect(qemu_args).to_contain("none")
        expect(qemu_args).to_contain("-serial")
        expect(qemu_args).to_contain("stdio")

    it "exposes the ARM64 WM ramfb lane as a named QEMU scenario":
        val scenario_opt = get_scenario("arm64-wm-ramfb")
        assert_not_equal(scenario_opt, nil)
        if scenario_opt == nil:
            return
        val scenario = scenario_opt
        val target = scenario_target(scenario)
        expect(target.entry).to_equal("examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl")
        expect(target.output).to_equal("build/os/simpleos_arm64_wm.elf")
        val cmd = build_scenario_command(scenario, target.output)
        expect(cmd).to_contain("qemu-system-aarch64")
        expect(cmd).to_contain("-machine")
        expect(cmd).to_contain("virt")
        expect(cmd).to_contain("-cpu")
        expect(cmd).to_contain(target.qemu_cpu)
        expect(cmd).to_contain("-accel")
        expect(cmd).to_contain(target.qemu_extra[1])
        expect(cmd).to_contain("-m")
        expect(cmd).to_contain("384M")
        expect(cmd).to_contain("-kernel")
        expect(cmd).to_contain("build/os/simpleos_arm64_wm.elf")
        expect(cmd).to_contain("-device")
        expect(cmd).to_contain("ramfb")

    it "uses documented ARM64 WM markers for scenario acceptance":
        val scenario_opt = get_scenario("arm64-wm-ramfb")
        assert_not_equal(scenario_opt, nil)
        if scenario_opt == nil:
            return
        val scenario = scenario_opt
        val complete = _complete_arm64_wm_serial()
        expect(qemu_scenario_serial_acceptance_reason(scenario, "", complete)).to_equal("ready")
        expect(qemu_scenario_serial_acceptance_reason(scenario, "off", complete)).to_equal("ready")
        val missing_ramfb = "[desktop-gui-arm64] boot\n" +
            "[WM] fw_cfg sig: 81 69 77 85\n" +
            "[WM] Found etc/ramfb in fw_cfg\n" +
            "[desktop-gui-arm64] desktop-ready revision=1\n"
        expect(qemu_scenario_serial_acceptance_reason(scenario, "", missing_ramfb)).to_equal(
            "missing-marker:[WM] ramfb configured successfully via fw_cfg DMA"
        )
        expect(scenario_test_timeout_ms(scenario)).to_equal(120000)

    it "keeps SimpleOS CLI scenario dispatch wired to the ARM64 WM scenario":
        val cli = file_read_text(_cli_path())
        expect(cli).to_contain("os_parse_scenario_arg(args)")
        expect(cli).to_contain("get_scenario(scenario_name)")
        expect(cli).to_contain("val ok = build_scenario(scenario)")
        expect(cli).to_contain("val built = build_scenario(scenario)")
        expect(cli).to_contain("val ok = run_scenario(scenario)")
        expect(cli).to_contain("val ok = test_scenario(scenario, scenario_test_timeout_ms(scenario))")
