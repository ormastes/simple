# command_history_spec
# @cover src/lib/common/command/history.spl 20%
#
# Tests CommandHistory from std.common.command.history
# Verifies undo/redo stack, max size, and empty-state behaviour.

use std.spec
use std.common.command.history.{CommandHistory}

describe "CommandHistory — empty state":

    it "can_undo is false on empty history":
        val h = CommandHistory.with_defaults()
        expect(h.can_undo()).to_equal(false)

    it "can_redo is false on empty history":
        val h = CommandHistory.with_defaults()
        expect(h.can_redo()).to_equal(false)

    it "undo on empty history returns empty label":
        var h = CommandHistory.with_defaults()
        expect(h.undo()).to_equal("")

describe "CommandHistory — push and undo":

    it "push one command makes can_undo true":
        var h = CommandHistory.with_defaults()
        h.push_command("draw")
        expect(h.can_undo()).to_equal(true)

    it "undo returns the pushed label":
        var h = CommandHistory.with_defaults()
        h.push_command("draw")
        expect(h.undo()).to_equal("draw")

    it "undo makes can_redo true":
        var h = CommandHistory.with_defaults()
        h.push_command("draw")
        h.undo()
        expect(h.can_redo()).to_equal(true)

    it "push clears the redo stack":
        var h = CommandHistory.with_defaults()
        h.push_command("a")
        h.undo()
        h.push_command("b")
        expect(h.can_redo()).to_equal(false)

describe "CommandHistory — redo":

    it "redo returns the undone label":
        var h = CommandHistory.with_defaults()
        h.push_command("stroke")
        h.undo()
        expect(h.redo()).to_equal("stroke")

    it "redo restores can_undo":
        var h = CommandHistory.with_defaults()
        h.push_command("stroke")
        h.undo()
        h.redo()
        expect(h.can_undo()).to_equal(true)

describe "CommandHistory — max size":

    it "history is trimmed to max_size, keeping the newest":
        var h = CommandHistory.new(3)
        var i = 0
        while i < 5:
            h.push_command("op" + i.to_text())
            i = i + 1
        expect(h.undo()).to_equal("op4")
        expect(h.undo()).to_equal("op3")
        expect(h.undo()).to_equal("op2")
        expect(h.can_undo()).to_equal(false)
