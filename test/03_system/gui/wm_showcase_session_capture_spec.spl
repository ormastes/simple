# WM Showcase gate — five windows, a DERIVED taskbar, capture-verified.
# @cover src/app/wm_showcase/run.spl 20%
#
# What this gate is for
# ---------------------
# A showcase that renders the same picture regardless of window state is
# decoration, not evidence. So the derivation is sabotage-verified here: a
# window is closed, the taskbar entry must vanish AND the captured desktop
# must change; then the window is restored and the entry must come back.
#
# Honest provenance
# -----------------
# `resolved_backend` is only what the resolver SELECTED. A frame may be called
# GPU-rendered only when the readback proves a device produced it — the same
# predicate the renderer uses internally: source == device_readback AND
# handle > 0 AND identity > 0 AND pixel_count == frame pixels. This gate
# asserts the DISCLOSURE is consistent, never that the lane is GPU; on a CPU
# lane it records "cpu" and says so. See the `wm_showcase_lane` receipt.
#
# Windows rendered vs declared
# ---------------------------
# `rendered` is not a count of windows the session asked for. A window counts
# as rendered only when the exact content pixels the producer handed the
# compositor are found byte-identical at that window's content rect in the
# composited desktop, so a producer that never ran cannot be counted.
#
# Receipts are per-example prints: cross-example tallying does not work on
# this runtime (a module var and a class field both read back 0 immediately
# after the bump).

use std.spec.*
use app.wm_showcase.run.{
    WmShowcaseRunResult,
    wm_showcase_run,
    wm_showcase_run_report,
}
use app.wm_showcase.session.{wm_showcase_count_color}

# 2D showcase palette, pinned from common.ui.wm_full_stack_demo's scene.
val PROBE_2D_RECT: u32 = 0xFFFFA000u32
val PROBE_2D_FIELD: u32 = 0xFF15304Au32

# One scripted session shared by every example. An array cache, not a nullable
# field: `var x: SomeStruct? = nil` trips a JIT closure bail on this runtime.
var _run_cache: [WmShowcaseRunResult] = []

fn _run() -> WmShowcaseRunResult:
    # Capacity is exactly one: the cache holds the single scripted run, never
    # a growing history.
    if _run_cache.len() == 0:
        _run_cache.push(wm_showcase_run())
    _run_cache[0]

describe "WM showcase session capture":
    """A WM session opens a GUI widget, a web-render, a Simple Browser, a
    Simple Terminal, and a 2D showcase window, projects a taskbar from the
    windows that are actually open, and proves the projection by closing a
    window and re-capturing."""

    # `slow_it`, not `it`: this example is the one that actually pays for the
    # scripted session (`_run()` renders five real windows through the
    # interpreted browser-engine cascade, ~410s on an unloaded machine); every
    # later example reads the cached result. Declared with plain `it` the file
    # got the child runner's 120s default budget and was killed mid-render,
    # which surfaced as `error: test-runner: file timed out` on the direct path
    # and as a bare `no examples executed` through the session daemon — a spec
    # that never executed an example while reading like a normal failure.
    # `slow_it` is the sanctioned declaration (test_runner_single.spl raises the
    # file budget to 600s and process_limits selects the slow resource profile);
    # it is otherwise identical to `it` and weakens no assertion. See
    # doc/08_tracking/bug/wm_showcase_session_capture_spec_no_examples_executed_2026-08-06.md
    slow_it "opens the five declared showcase windows":
        val r = _run()
        print wm_showcase_run_report(r)
        expect(r.declared_windows).to_equal(5)
        expect(r.opened_windows).to_equal(5)
        expect(r.accepted_frames).to_equal(5)
        print "wm_showcase_open declared={r.declared_windows} open={r.opened_windows} accepted={r.accepted_frames} rejects={r.reject_reasons}"

    it "renders every declared window into the composited desktop":
        val r = _run()
        # Byte-identical content-rect match, so this cannot pass by declaration.
        expect(r.base.rendered_windows).to_equal(r.declared_windows)
        print "wm_showcase_rendered rendered={r.base.rendered_windows} declared={r.declared_windows} open={r.base.open_windows}"

    it "derives the taskbar from the live window list":
        val r = _run()
        expect(r.base.taskbar_entries).to_equal(r.base.open_windows)
        expect(r.base.taskbar_entries).to_equal(5)
        assert_true(r.base.taskbar_titles.contains(r.web_title))
        print "wm_showcase_derived entries={r.base.taskbar_entries} open={r.base.open_windows} titles={r.base.taskbar_titles}"

    it "drops the taskbar entry when a window is closed":
        val r = _run()
        expect(r.closed.open_windows).to_equal(4)
        expect(r.closed.taskbar_entries).to_equal(4)
        assert_false(r.closed.taskbar_titles.contains(r.web_title))
        print "wm_showcase_sabotage_taskbar before={r.base.taskbar_entries} after={r.closed.taskbar_entries} before_titles={r.base.taskbar_titles} after_titles={r.closed.taskbar_titles}"

    it "changes the captured desktop when a window is closed":
        val r = _run()
        assert_true(r.closed.checksum != r.base.checksum)
        expect(r.closed.rendered_windows).to_equal(4)
        print "wm_showcase_sabotage_capture base={r.base.checksum} closed={r.closed.checksum} rendered_before={r.base.rendered_windows} rendered_after={r.closed.rendered_windows}"

    it "restores the taskbar entry when the window re-opens":
        val r = _run()
        assert_true(r.web_reopened)
        expect(r.restored.open_windows).to_equal(5)
        expect(r.restored.taskbar_entries).to_equal(5)
        assert_true(r.restored.taskbar_titles.contains(r.web_title))
        print "wm_showcase_restore entries={r.restored.taskbar_entries} titles={r.restored.taskbar_titles}"

    it "is sensitive to a scene change that leaves window state untouched":
        val r = _run()
        assert_true(r.scene_moved)
        assert_true(r.mutated.checksum != r.restored.checksum)
        expect(r.mutated.taskbar_entries).to_equal(r.restored.taskbar_entries)
        expect(r.mutated.open_windows).to_equal(r.restored.open_windows)
        print "wm_showcase_mutation restored={r.restored.checksum} mutated={r.mutated.checksum} entries={r.mutated.taskbar_entries}"

    it "captures a non-degenerate full-size desktop frame":
        val r = _run()
        expect(r.base.pixels.len()).to_equal(r.base.width * r.base.height)
        expect(r.base.width).to_be_greater_than(0)
        expect(r.base.height).to_be_greater_than(0)
        # A blank frame — the CPU oracle's budget-exhaustion failure mode —
        # collapses to one or two colours. A real desktop does not.
        expect(r.base.distinct_colors).to_be_greater_than(2)
        print "wm_showcase_frame w={r.base.width} h={r.base.height} pixels={r.base.pixels.len()} checksum={r.base.checksum} distinct={r.base.distinct_colors}"

    it "finds the pinned 2D showcase palette in the captured desktop":
        val r = _run()
        val rect = wm_showcase_count_color(r.base.pixels, PROBE_2D_RECT)
        val field = wm_showcase_count_color(r.base.pixels, PROBE_2D_FIELD)
        expect(rect).to_be_greater_than(0)
        expect(field).to_be_greater_than(0)
        print "wm_showcase_palette rect_px={rect} field_px={field}"

    it "moves the pinned 2D palette when the scene moves":
        val r = _run()
        # Same colour budget, different placement: the rect count is stable,
        # the frame is not. This separates "scene changed" from "frame broke".
        val before = wm_showcase_count_color(r.restored.pixels, PROBE_2D_RECT)
        val after = wm_showcase_count_color(r.mutated.pixels, PROBE_2D_RECT)
        expect(before).to_be_greater_than(0)
        expect(after).to_be_greater_than(0)
        print "wm_showcase_palette_moved before={before} after={after}"

    it "discloses the lane that produced the frame without overclaiming":
        val r = _run()
        val p = r.provenance
        # device_proven is the ONLY licence to call a frame GPU-rendered.
        if p.device_proven:
            expect(p.readback_source).to_equal("device_readback")
            expect(p.lane).to_equal("gpu-device")
            assert_true(p.backend_handle > 0)
            assert_true(p.device_identity > 0)
            expect(p.readback_pixel_count).to_equal(p.expected_pixel_count)
        else:
            expect(p.lane).to_equal("cpu")
            assert_true(p.readback_source != "device_readback")
        print "wm_showcase_provenance lane={p.lane} resolved={p.resolved_backend} source={p.readback_source} handle={p.backend_handle} identity={p.device_identity} proven={p.device_proven} degraded={p.render_degraded} reason={p.degrade_reason}"

    it "writes a viewable capture artifact with a provenance sidecar":
        val r = _run()
        assert_true(r.ppm_written)
        assert_true(r.provenance_written)
        print "wm_showcase_artifact_written ppm={r.ppm_path} provenance={r.provenance_path}"
