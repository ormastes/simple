# @tag:system
#
# Portable smoke for the browser open/snapshot contract.


# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/gui/ui_browser/browser_open_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/browser_open_spec.md
# doc-path: doc/03_plan/sys_test/browser_open_spec.md
# doc-path: doc/04_architecture/browser_open_spec.md
# doc-path: doc/05_design/browser_open_spec_oracles.md
# @manual: primary

use std.spec.*
use std.spec.step

describe "Browser Engine portable snapshot smoke":
    it "records snapshot path and format":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: records snapshot path and format")
        val snapshot = ".build/ui_browser/test_hello.ppm"
        val format = "P3"
        expect(snapshot).to_end_with(".ppm")
        expect(format).to_equal("P3")

    it "records default snapshot dimensions":
        step("Verify: records default snapshot dimensions")
        val width = 1280
        val height = 720
        expect(width).to_equal(1280)
        expect(height).to_equal(720)

    it "records non-background paint colors":
        step("Verify: records non-background paint colors")
        val panel_rgb = "45 45 45"
        val text_rgb = "224 224 224"
        expect(panel_rgb).to_contain("45")
        expect(text_rgb).to_contain("224")

describe "Browser Engine portable GUI gate":
    it "keeps GUI open behavior opt-in":
        step("Verify: keeps GUI open behavior opt-in")
        val env_name = "SIMPLE_GUI_TEST"
        expect(env_name).to_equal("SIMPLE_GUI_TEST")
