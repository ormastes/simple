# editor_settings_schema_spec
#
# Phase A verification: settings schema module and config get/set/save functions.
# Text-grep pattern — reads source and verifies signatures and struct fields exist.

use std.spec
use app.io.mod.{file_read_text}

fn read_text(path: text) -> text:
    file_read_text(path) ?? ""

describe "settings descriptor type":

    it "uses the shared config_core descriptor instead of a local record":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("struct SettingDescriptor:")).to_equal(false)
        expect(src.contains("use std.common.config_core.schema.{ConfigFieldDescriptor")).to_equal(true)
        expect(src.contains("config_ui_field")).to_equal(true)
        expect(src.contains("config_with_ui")).to_equal(true)

describe "editor_settings_schema function":

    it "defines editor_settings_schema returning descriptor list":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("fn editor_settings_schema() -> [ConfigFieldDescriptor]")).to_equal(true)

    it "includes theme enum descriptor":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("\"theme\"")).to_equal(true)
        expect(src.contains("\"enum\"")).to_equal(true)
        expect(src.contains("[\"dark\", \"light\", \"solarized\"]")).to_equal(true)

    it "includes font_size i64 descriptor in Appearance category":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("\"font_size\"")).to_equal(true)
        expect(src.contains("\"i64\"")).to_equal(true)

    it "includes tab_size in Editor category":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("\"tab_size\"")).to_equal(true)
        expect(src.contains("\"Editor\"")).to_equal(true)

    it "includes insert_spaces bool in Editor category":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("\"insert_spaces\"")).to_equal(true)
        expect(src.contains("\"bool\"")).to_equal(true)

    it "includes minimap with desktop platform":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("\"minimap\"")).to_equal(true)
        expect(src.contains("\"desktop\"")).to_equal(true)

    it "includes auto_save and auto_save_delay_ms in Files category":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("\"auto_save\"")).to_equal(true)
        expect(src.contains("\"auto_save_delay_ms\"")).to_equal(true)
        expect(src.contains("\"Files\"")).to_equal(true)

    it "includes configurable LSP hover delay in Editor category":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("\"hover_delay_ms\"")).to_equal(true)
        expect(src.contains("\"Hover Delay\"")).to_equal(true)
        expect(src.contains("\"inlay_hint_refresh_delay_ms\"")).to_equal(true)
        expect(src.contains("\"Inlay Hint Refresh Delay\"")).to_equal(true)
        expect(src.contains("\"300\"")).to_equal(true)

describe "schema utility functions":

    it "defines keybinding_settings_schema returning empty placeholder":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("fn keybinding_settings_schema() -> [ConfigFieldDescriptor]")).to_equal(true)

    it "defines full_settings_schema combining both schemas":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("fn full_settings_schema() -> [ConfigFieldDescriptor]")).to_equal(true)

    it "defines settings_categories returning category list":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("fn settings_categories() -> [text]")).to_equal(true)
        expect(src.contains("\"Editor\"")).to_equal(true)
        expect(src.contains("\"Appearance\"")).to_equal(true)
        expect(src.contains("\"Keybindings\"")).to_equal(true)

    it "defines settings_filter_by_category":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("fn settings_filter_by_category(schema: [ConfigFieldDescriptor], category: text) -> [ConfigFieldDescriptor]")).to_equal(true)

    it "defines settings_filter_by_platform with all-platform fallback":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("fn settings_filter_by_platform(schema: [ConfigFieldDescriptor], platform: text) -> [ConfigFieldDescriptor]")).to_equal(true)
        expect(src.contains("config_filter_by_platform(schema, platform)")).to_equal(true)

    it "defines settings_search":
        val src = read_text("src/lib/editor/00.common/settings_schema.spl")
        expect(src.contains("fn settings_search(schema: [ConfigFieldDescriptor], query: text) -> [ConfigFieldDescriptor]")).to_equal(true)

describe "editor_config get set save functions":

    it "defines editor_config_get_by_key":
        val src = read_text("src/lib/editor/00.common/config.spl")
        expect(src.contains("fn editor_config_get_by_key(config: EditorConfig, key: text) -> text")).to_equal(true)

    it "defines editor_config_set_by_key returning EditorConfig":
        val src = read_text("src/lib/editor/00.common/config.spl")
        expect(src.contains("fn editor_config_set_by_key(config: EditorConfig, key: text, value: text) -> EditorConfig")).to_equal(true)

    it "defines editor_config_save with path parameter":
        val src = read_text("src/lib/editor/00.common/config.spl")
        expect(src.contains("fn editor_config_save(config: EditorConfig, path: text) -> bool")).to_equal(true)
        expect(src.contains("file_write(path, content)")).to_equal(true)

    it "writes through the std.io_runtime file_write facade":
        val src = read_text("src/lib/editor/00.common/config.spl")
        expect(src.contains("use std.io_runtime.{file_read, file_write}")).to_equal(true)

    it "applies font_size in _ec_apply_line":
        val src = read_text("src/lib/editor/00.common/config.spl")
        expect(src.contains("key == \"font_size\"")).to_equal(true)

    it "applies insert_spaces in _ec_apply_line":
        val src = read_text("src/lib/editor/00.common/config.spl")
        expect(src.contains("key == \"insert_spaces\"")).to_equal(true)

    it "applies word_wrap in _ec_apply_line":
        val src = read_text("src/lib/editor/00.common/config.spl")
        expect(src.contains("key == \"word_wrap\"")).to_equal(true)

    it "applies minimap in _ec_apply_line":
        val src = read_text("src/lib/editor/00.common/config.spl")
        expect(src.contains("key == \"minimap\"")).to_equal(true)

    it "applies auto_save_delay_ms in _ec_apply_line":
        val src = read_text("src/lib/editor/00.common/config.spl")
        expect(src.contains("key == \"auto_save_delay_ms\"")).to_equal(true)
