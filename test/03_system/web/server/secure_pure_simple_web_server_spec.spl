# Secure Pure-Simple production web server (AC-1..AC-3).
#
# The operator vocabulary is frozen in
# `.spipe/secure_pure_simple_servers/state.md`. These scenarios exercise the
# production policy and the same parser/router/TLS owners used by the listener.

"""
## Purpose and audience
Purpose: AC-1 Bind the production listener
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-WEB-SecuPureSimpWebServ-001

use std.spec.*
use std.common.net.http_core.{header_field_line_decision}
use std.nogc_sync_mut.http_server.parser.{headers_decision, parse_request_line, request_line_without_terminator, sync_header_field_line_decision, RUNTIME_READ_LINE_CAP}
use std.nogc_sync_mut.http_server.router.{Router, path_is_safe}
use std.nogc_sync_mut.http_server.server.{SimpleHttpServer, SecureServerPolicy, ConnectionAdmission, plaintext_development_capability, secure_server_policy_error}
use std.nogc_sync_mut.http_server.response.{with_default_security_headers, serialize_response, serialize_response_for_method_connection}
use std.nogc_sync_mut.http_server.types.{HttpResponse, HttpStatus}
use std.common.net.http_core.{response_body_framing_decision}
use std.nogc_sync_mut.http_server.tls_server.{tls_server_config_new, tls_server_config_error, tls_server_accept, tls_conn_is_h2, tls_conn_is_http1}
use std.nogc_sync_mut.io.tcp.{TcpStream}

fn secure_web_server_fixture() -> SecureServerPolicy:
    SecureServerPolicy.production()

fn expect_web_request_rejected(headers: [(text, text)], expected: text):
    val decision = headers_decision(headers, 1024)
    expect(decision.0).to_contain(expected)

describe "Secure Pure-Simple production web routing":
    it "AC-1 Bind the production listener":
        step("Bind the production listener")
        val policy = secure_web_server_fixture()
        expect(secure_server_policy_error(policy)).to_equal("")
        expect(policy.plaintext_development).to_be(false)
        expect(policy.max_keep_alive_requests).to_equal(1)
        expect(policy.max_connections).to_be_greater_than(0)
        expect(policy.max_response_bytes).to_be_greater_than(0)
        var invalid = SecureServerPolicy.production()
        invalid.max_connections = 0
        expect(secure_server_policy_error(invalid)).to_contain("max_connections must be positive")
        invalid = SecureServerPolicy.production()
        invalid.max_response_bytes = 0
        expect(secure_server_policy_error(invalid)).to_contain("max_response_bytes must be positive")

    it "AC-2 Reject an unsafe web request before dispatch":
        step("Reject an unsafe web request before dispatch")
        expect(path_is_safe("/assets/%2e%2e/secrets.txt")).to_be(false)
        expect_web_request_rejected([("Content-Length", "3"), ("Content-Length", "4")], "Duplicate Content-Length")
        val gzip = headers_decision([("Transfer-Encoding", "gzip")], 1024)
        expect(gzip.0).to_equal("501 Transfer-Encoding is not supported")
        val identity = headers_decision([("Transfer-Encoding", "identity")], 1024)
        expect(identity.0).to_equal("501 Transfer-Encoding is not supported")
        val absent = headers_decision([("Host", "example.test")], 1024)
        expect(absent.0).to_equal("")
        expect(absent.1).to_equal(0)
        expect_web_request_rejected([("Authorization", "one"), ("authorization", "two")], "Conflicting duplicate security header")
        expect(parse_request_line("GET / HTTP/1.1 extra").0).to_equal("")
        expect(parse_request_line(" GET / HTTP/1.1").0).to_equal("")
        expect(header_field_line_decision("Content-Length : 4").0).to_contain("Invalid header name")
        expect(header_field_line_decision("Host\t: example.test").0).to_contain("Invalid header name")
        expect(header_field_line_decision("Bad(Name: value").0).to_contain("Invalid header name")
        expect(header_field_line_decision("Bad@Name: value").0).to_contain("Invalid header name")
        expect(header_field_line_decision("X-Test: safe\x00smuggled").0).to_contain("Invalid header value")
        expect(header_field_line_decision("X-Test: safe\x01smuggled").0).to_contain("Invalid header value")
        expect(header_field_line_decision("X-Test: safe\x7fsmuggled").0).to_contain("Invalid header value")
        expect(header_field_line_decision("X-Test: safe\rsmuggled").0).to_contain("Invalid header value")
        expect(header_field_line_decision("X-Test: safe\nsmuggled").0).to_contain("Invalid header value")
        expect(sync_header_field_line_decision("X-Test: safe\r").0).to_contain("Invalid header value")
        expect(sync_header_field_line_decision("Bad(Name: value").0).to_contain("Invalid header name")
        val valid_header = header_field_line_decision("Content-Length: 4")
        expect(valid_header.0).to_equal("")
        expect(valid_header.1).to_equal("Content-Length")
        expect(valid_header.2).to_equal("4")
        expect(header_field_line_decision("X-Trace: one\ttwo").0).to_equal("")
        expect(sync_header_field_line_decision("X-Trace: one\ttwo").0).to_equal("")
        expect(request_line_without_terminator("GET / HTTP/1.1\r\n")).to_equal("GET / HTTP/1.1")
        expect(RUNTIME_READ_LINE_CAP).to_equal(4096)  # oracle: value fixed by the spec contract

    it "AC-3 refuses missing or invalid production TLS material":
        step("Verify: AC-3 refuses missing or invalid production TLS material")
        # @req: REQ-WEB-SecuPureSimpWebServ-001
        val missing = tls_server_config_new("", "", ["http/1.1"])
        expect(tls_server_config_error(missing)).to_contain("certificate material is missing")
        val invalid = tls_server_config_new("00", "11", ["http/1.1"])
        expect(tls_server_config_error(invalid)).to_contain("certificate material is invalid")
        match plaintext_development_capability(""):
            Err(e): expect(e).to_contain("non-empty audit reason")
            Ok(_): fail("empty audit reason unexpectedly minted plaintext authority")
        match plaintext_development_capability("system-test explicit development mode"):
            Err(e): fail("unexpected plaintext development capability failure: {e}")
            Ok(capability):
                val dev = SecureServerPolicy.plaintext_dev(capability)
                expect(dev.plaintext_development).to_be(true)

    it "AC-1 attaches default security headers before writing":
        step("Verify: AC-1 attaches default security headers before writing")
        # @req: REQ-WEB-SecuPureSimpWebServ-001
        val secured = with_default_security_headers(HttpResponse.ok("ok"), false)
        val wire = serialize_response(secured)
        expect(wire).to_contain("X-Content-Type-Options: nosniff")
        expect(wire).to_contain("X-Frame-Options: DENY")
        expect(wire.contains("Strict-Transport-Security")).to_be(false)

    it "NFR-002 bounds a complete response at boundary and boundary plus one":
        val secured = with_default_security_headers(HttpResponse.ok("ok"), false)
        val exact_size = response_wire_size(secured)
        expect(response_wire_fits(secured, exact_size)).to_be(true)
        expect(response_wire_fits(secured, exact_size - 1)).to_be(false)
        var oversized_body = ""
        var i = 0
        while i < 2048:
            oversized_body = "{oversized_body}x"
            i = i + 1
        val fallback = bounded_response_wire(
            with_default_security_headers(HttpResponse.ok(oversized_body), false),
            1024
        )
        expect(fallback).to_start_with("HTTP/1.1 500 Internal Server Error")
        expect(fallback).to_contain("X-Content-Type-Options: nosniff")
        expect(fallback).to_contain("X-Frame-Options: DENY")
        expect(fallback).to_end_with("response exceeds configured byte limit")
        expect(fallback.len()).to_be_less_than(1025)

    it "AC-2 keeps bodyless responses aligned for connection reuse":
        step("Verify: AC-2 Keep HEAD and status-forbidden response bodies off the wire")
        # @req: REQ-WEB-SecuPureSimpWebServ-001
        val payload = "selected-representation"
        val ok = HttpResponse(status: HttpStatus.Ok,
            headers: [("Transfer-Encoding", "chunked"), ("Trailer", "Digest")],
            body: payload)
        val head_wire = serialize_response_for_method_connection(ok, "HEAD", false)
        expect(head_wire).to_contain("Content-Length: 23\r\n")
        expect(head_wire.contains(payload)).to_equal(false)
        expect(head_wire.contains("Transfer-Encoding:")).to_equal(false)
        expect(head_wire.contains("Trailer:")).to_equal(false)
        expect(head_wire).to_contain("Connection: keep-alive\r\n")

        val no_content = HttpResponse(status: HttpStatus.NoContent,
            headers: [("Content-Length", "999"), ("Trailer", "Digest")],
            body: payload)
        val no_content_wire = serialize_response_for_method_connection(
            no_content, "GET", false)
        expect(no_content_wire.contains(payload)).to_equal(false)
        expect(no_content_wire.contains("Content-Length:")).to_equal(false)
        expect(no_content_wire.contains("Trailer:")).to_equal(false)

        val not_modified = HttpResponse(status: HttpStatus.NotModified,
            headers: [], body: payload)
        val not_modified_wire = serialize_response_for_method_connection(
            not_modified, "GET", false)
        expect(not_modified_wire).to_contain("Content-Length: 23\r\n")
        expect(not_modified_wire.contains(payload)).to_equal(false)
        val metadata_only = HttpResponse(status: HttpStatus.NotModified,
            headers: [
                ("Content-Length", "321"),
                ("Keep-Alive", "timeout=999"),
                ("Proxy-Connection", "keep-alive"),
                ("Upgrade", "unsafe")
            ], body: "")
        val metadata_only_wire = serialize_response_for_method_connection(
            metadata_only, "GET", false)
        expect(metadata_only_wire).to_contain("Content-Length: 321\r\n")
        expect(metadata_only_wire.contains("Keep-Alive:")).to_equal(false)
        expect(metadata_only_wire.contains("Proxy-Connection:")).to_equal(false)
        expect(metadata_only_wire.contains("Upgrade:")).to_equal(false)

        val early = response_body_framing_decision("GET", 103, true)
        expect(early.transfer_body).to_equal(false)
        expect(early.emit_content_length).to_equal(false)
        expect(early.emit_transfer_encoding).to_equal(false)
        expect(early.emit_trailer_declaration).to_equal(false)
        val reset_content = response_body_framing_decision("GET", 205, false)
        expect(reset_content.transfer_body).to_equal(false)
        expect(reset_content.emit_content_length).to_equal(true)
        expect(reset_content.content_length_must_be_zero).to_equal(true)
        val connect_tunnel = response_body_framing_decision("CONNECT", 200, true)
        expect(connect_tunnel.transfer_body).to_equal(false)
        expect(connect_tunnel.emit_content_length).to_equal(false)
        expect(connect_tunnel.emit_transfer_encoding).to_equal(false)

    it "AC-3 closes a connection when TLS cannot be established":
        step("Verify: AC-3 closes a connection when TLS cannot be established")
        # @req: REQ-WEB-SecuPureSimpWebServ-001
        val stream = TcpStream.from_accepted_fd(-1)
        val config = tls_server_config_new("3000000000000000", "3000000000000000", ["http/1.1"])
        val conn = tls_server_accept(stream, config)
        expect(conn.tls_active).to_be(false)
        expect(conn.error).to_contain("GAP-TLS-3")
        expect(conn.negotiated_protocol).to_equal("")
        expect(tls_conn_is_http1(conn)).to_be(false)
        expect(tls_conn_is_h2(conn)).to_be(false)
        expect(conn.tcp.is_open()).to_be(false)

    it "AC-3 binds HTTP dispatch to a successful exact ALPN selection":
        step("Verify: AC-3 accepts only clean h2 or HTTP/1 ALPN dispatch")
        # @req: REQ-WEB-SecuPureSimpWebServ-001
        val h2 = TlsServerConn(tcp: TcpStream.from_accepted_fd(-1),
            negotiated_protocol: "h2", tls_active: true, error: "")
        expect(tls_conn_is_h2(h2)).to_equal(true)
        expect(tls_conn_is_http1(h2)).to_equal(false)

        val http1 = TlsServerConn(tcp: TcpStream.from_accepted_fd(-1),
            negotiated_protocol: "http/1.1", tls_active: true, error: "")
        expect(tls_conn_is_http1(http1)).to_equal(true)
        expect(tls_conn_is_h2(http1)).to_equal(false)

        val failed_h2 = TlsServerConn(tcp: TcpStream.from_accepted_fd(-1),
            negotiated_protocol: "h2", tls_active: false, error: "handshake failed")
        expect(tls_conn_is_h2(failed_h2)).to_equal(false)
        expect(tls_conn_is_http1(failed_h2)).to_equal(false)

        val unsupported = TlsServerConn(tcp: TcpStream.from_accepted_fd(-1),
            negotiated_protocol: "h3", tls_active: true, error: "")
        expect(tls_conn_is_h2(unsupported)).to_equal(false)
        expect(tls_conn_is_http1(unsupported)).to_equal(false)

    it "AC-3 returns a production startup failure instead of opening plaintext":
        step("Verify: AC-3 returns a production startup failure instead of opening plaintext")
        # @req: REQ-WEB-SecuPureSimpWebServ-001
        val server = SimpleHttpServer.new("127.0.0.1", 0, Router.new())
        match server.start():
            Err(e): expect(e).to_contain("production policy requires TLS")
            Ok(_): fail("production start unexpectedly opened plaintext")

    it "AC-2 admits the configured connection boundary and rejects boundary plus one":
        step("Verify: AC-2 admits the configured connection boundary and rejects boundary plus one")
        # @req: REQ-WEB-SecuPureSimpWebServ-001
        val admission = ConnectionAdmission.new(2)
        expect(admission.try_acquire()).to_be(true)
        expect(admission.try_acquire()).to_be(true)
        expect(admission.count()).to_equal(2)
        expect(admission.try_acquire()).to_be(false)
        admission.release()
        expect(admission.count()).to_equal(1)
        expect(admission.try_acquire()).to_be(true)
