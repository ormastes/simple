# Purpose: L07-A08 RR atomic-generation V2 acceptance.  Plan/model behavior is
# not live publication evidence; every scenario fails closed until the owner
# exposes a durable publisher authority.
# @req REQ-CSM-008 REQ-CSM-023 REQ-CSM-024

use std.spec.*
use std.spec.step
use compiler.driver.cache.reference.reverse_reference_atomic_generation_v2.{
    rr_atomic_generation_publisher_authority_available_v2
}

fn require_rr_atomic_publisher_v2(scenario: text):
    if not rr_atomic_generation_publisher_authority_available_v2():
        fail("MissingEvidence: RR atomic generation V2 durable publisher authority unavailable: " + scenario)
    # Availability alone is not an observation.  Keep this acceptance surface
    # RED until it owns a retained live receipt and scenario-specific oracle.
    fail("MissingEvidence: RR atomic generation V2 live receipt/assertion oracle unavailable: " + scenario)

describe "L07-A08 RR atomic generation V2 [importance=critical; importance_weight=3]":
    it "should require complete old-read authority [importance=critical; importance_weight=3]":
        step("Require a live durable owner to bind complete prior outgoing reads")
        require_rr_atomic_publisher_v2("complete-old-read-authority")

    it "should refuse nil or partial old history [importance=critical; importance_weight=3]":
        step("Require a live durable owner to reject nil and partial prior state")
        require_rr_atomic_publisher_v2("nil-partial-old-history-refusal")

    it "should roll back a stale removal [importance=critical; importance_weight=3]":
        step("Require a live durable owner to preserve the active generation after stale removal")
        require_rr_atomic_publisher_v2("stale-removal-rollback")

    it "should preserve producer digest for a consumer-only update [importance=critical; importance_weight=3]":
        step("Require a live durable owner to preserve producer semantic identity")
        require_rr_atomic_publisher_v2("consumer-only-producer-digest")

    it "should recover one coherent generation at every crash point [importance=critical; importance_weight=3]":
        step("Require a live durable owner to recover after each publication crash point")
        require_rr_atomic_publisher_v2("crash-point-recovery")

    it "should refuse a manifest digest cycle [importance=critical; importance_weight=3]":
        step("Require a live durable owner to reject cyclic generation closure identity")
        require_rr_atomic_publisher_v2("manifest-digest-cycle")
