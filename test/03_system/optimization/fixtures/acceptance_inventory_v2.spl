"""
Frozen optimization acceptance inventory (v2) for the L06 dynload acceptance spec.

Lists only the L06 items that spec asserts: the work lane, accounting lane and
the evidence class each item requires. Evidence admission stays with the
lane-progress evaluator; this fixture carries no outcome.
"""

class OptimizationAcceptanceItemV2:
    item_id: text
    work_lane_id: text
    accounting_lane_id: text
    required_evidence_class: text

fn load_optimization_acceptance_inventory_v2() -> [OptimizationAcceptanceItemV2]:
    [
        OptimizationAcceptanceItemV2(item_id: "L06-A01", work_lane_id: "L6",
            accounting_lane_id: "L06", required_evidence_class: "host_behavior"),
        OptimizationAcceptanceItemV2(item_id: "L06-A02", work_lane_id: "L6",
            accounting_lane_id: "L06", required_evidence_class: "physical_worker"),
        OptimizationAcceptanceItemV2(item_id: "L06-A03", work_lane_id: "L6",
            accounting_lane_id: "L06", required_evidence_class: "physical_worker"),
        OptimizationAcceptanceItemV2(item_id: "L06-A04", work_lane_id: "L6",
            accounting_lane_id: "L06", required_evidence_class: "integration"),
        OptimizationAcceptanceItemV2(item_id: "L06-A05", work_lane_id: "L6",
            accounting_lane_id: "L06", required_evidence_class: "physical_worker")
    ]

fn optimization_item_index_v2(items: [OptimizationAcceptanceItemV2], item_id: text) -> i64:
    var idx = 0
    while idx < items.len():
        if items[idx].item_id == item_id:
            return idx
        idx = idx + 1
    -1

export OptimizationAcceptanceItemV2, load_optimization_acceptance_inventory_v2, optimization_item_index_v2
