"""
V3 owner-lifecycle acceptance accounting helpers.

No helper manufactures a `LiveSemanticScopeV2`, a grant, an opaque V3 result,
or a cancellation/revocation event.  Until the production issuer installation
can create a live scope and drive it through the owner, primary lifecycle
scenarios are intentionally `MissingEvidence` failures.
"""

use std.spec.{fail}

pub struct L07WorkerLifecycleEvidenceV3:
    acceptance_id: text
    importance_weight: i64
    status: text
    missing_owner: text
    resume: text

pub fn l07_worker_lifecycle_missing_evidence_v3(
    acceptance_id: text,
    missing_owner: text,
    resume: text,
) -> L07WorkerLifecycleEvidenceV3:
    L07WorkerLifecycleEvidenceV3(acceptance_id: acceptance_id,
        importance_weight: 3, status: "MissingEvidence",
        missing_owner: missing_owner, resume: resume)

pub fn l07_require_live_worker_lifecycle_v3(
    evidence: L07WorkerLifecycleEvidenceV3,
):
    # The test must be replaced by real calls to begin_scope_v2, seal_scope_v2,
    # the five issuer ports, preflight_three_payload_parse_v3, cancellation,
    # and revocation hooks. A fixture-only grant or copied opaque token is not
    # a substitute and may not turn this failure into a pass.
    fail("MissingEvidence: " + evidence.acceptance_id + ": owner=" +
        evidence.missing_owner + "; resume=" + evidence.resume)
