"""
L08 durable-recovery acceptance helpers.

This bridge intentionally owns no fabricated cache service, SQL replacement,
journal, epoch, pin, root, process crash, or admission receipt. It can only
prepare isolated PureDatabase fixture paths and fail explicitly when the
missing physical owner boundary is required. A future implementation must
replace the failing bridge with calls into that production owner, not a test
model or arbitrary receipt parser.
"""

use std.spec.{fail}
use std.io_runtime.{file_delete, getpid, time_now_unix_micros}

pub fn l08_fixture_path_v2(label: text) -> text:
    "/tmp/simple-l08-" + label + "-" + getpid().to_text() + "-" +
        time_now_unix_micros().to_text() + ".db"

pub fn l08_remove_fixture_v2(path: text):
    file_delete(path)
    file_delete(path + ".tmp")
    file_delete(path + ".lock")
    file_delete(path + ".journal")
    file_delete(path + ".commit.lock")
    file_delete(path + ".context.lock")

pub fn l08_require_live_durable_owner_v2(requirement: text):
    # No production endpoint currently joins the existing PureDatabase owner
    # with immutable journal/CAS roots, cross-process epoch/pin/GC authority,
    # actual process-crash injection, and a signed admission receipt. Do not
    # test a reimplementation or accept an SDN/JSON row in its place.
    fail("MissingEvidence: " + requirement + ": production durable owner endpoint is absent; " +
        "no physical admission outcome is asserted by this bridge")
