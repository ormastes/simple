        # @scenario: L06-A06-boundary class=blocked owner=app.io.context_store_v1 reason=no-persistent-contextstore-owner-entrypoint resume=bind-to-persistent-contextstore-owner
        it "should reject a destination conflict through the durable ContextStore owner [importance=critical; importance_weight=3]":
            step("Require a persistent ContextStore destination-conflict receipt")
            l08_require_live_durable_owner_v2("L06-A06 persistent ContextStore destination conflict")

        # @scenario: L06-A06-refusal class=blocked owner=app.io.context_store_v1 reason=no-persistent-contextstore-owner-entrypoint resume=bind-to-persistent-contextstore-owner
        it "should refuse an unsupported SQL or native backend substitute [importance=critical; importance_weight=3]":
            step("Require durable ContextStore backend-identity refusal evidence")
            l08_require_live_durable_owner_v2("L06-A06 ContextStore backend substitute refusal")

