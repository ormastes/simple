    describe "L08-A06 cross-process pin GC and recovery [importance=critical; importance_weight=3]":
        # @scenario: L08-A06-success class=blocked owner=compiler.cache.reader_gc reason=no-cross-process-pin-gc-entrypoint resume=bind-live-reader-gc-worker
        it "should retain a live object while a cross-process reader pin is active [importance=critical; importance_weight=3]":
            step("Require the production cross-process reader/pin/GC owner")
            l08_require_live_durable_owner_v2("L08-A06 live reader pin")

        # @scenario: L08-A06-boundary class=blocked owner=compiler.cache.reader_gc reason=no-cross-process-pin-gc-entrypoint resume=bind-live-reader-gc-worker
        it "should delete expired or tombstoned objects only after required generations [importance=critical; importance_weight=3]":
            step("Require the production GC generations and expiry observation")
            l08_require_live_durable_owner_v2("L08-A06 expiry and tombstone")

        # @scenario: L08-A06-refusal class=blocked owner=compiler.cache.reader_gc reason=no-cross-process-pin-gc-entrypoint resume=bind-live-reader-gc-worker
        it "should quarantine corruption rather than promote missing durable evidence [importance=critical; importance_weight=3]":
            step("Require the production quarantine observation after corrupt durable bytes")
            l08_require_live_durable_owner_v2("L08-A06 corruption quarantine")
