"""
## Purpose and audience
Pins observable outcomes of the smoke system lane
(smoke_9_system_spec.spl): every scenario asserts a concrete language/stdlib result the runner
must report green before the lane can be trusted as a smoke signal.
Audience: compiler and test-infrastructure engineers triaging smoke runs.
## Operator workflow
Run `bin/simple test test/03_system/infrastructure/smoke/smoke_9_system_spec.spl` and read the per-scenario verdicts in the
`Results:` summary; each scenario asserts one externally visible outcome.
## Compatibility and limitations
Covers interpreter-path semantics exercised by this lane; native codegen
and performance envelopes are out of scope.
# @manual: primary
REQ-SYS-SMOKE-001
doc/01_research/local/smoke_lane.md
doc/03_plan/sys_test/smoke_lane.md
doc/04_architecture/smoke_lane.md
doc/05_design/smoke_lane.md
"""
# @req: REQ-SYS-SMOKE-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%

use std.spec

describe "smoke system lane execution contract":
    it "arithmetic precedence binds multiplication before addition":
        step("Verify: arithmetic precedence binds multiplication before addition")
        # @req: REQ-SYS-SMOKE-001
        expect(2 + 3 * 4).to_equal(14) # oracle: precedence, not left-to-right (would be 20)
        expect((2 + 3) * 4).to_equal(20) # oracle: parenthesised grouping

    it "reversal via index walk yields the mirrored array":
        step("Verify: reversal via index walk yields the mirrored array")
        # @req: REQ-SYS-SMOKE-002
        val src = [1, 2, 3, 4]
        var rev = []
        var i = src.len() - 1
        while i >= 0:
            rev.push(src[i])
            i = i - 1
        expect(rev.len()).to_equal(4) # oracle: reversal preserves length
        expect(rev[0]).to_equal(4) # oracle: last becomes first
        expect(rev[3]).to_equal(1)

    it "trim removes surrounding padding only":
        step("Verify: trim removes surrounding padding only")
        # @req: REQ-SYS-SMOKE-003
        val padded = "  payload  "
        expect(padded.trim()).to_equal("payload") # oracle: exact trimmed value
        expect(padded.trim().len()).to_equal(7) # oracle: "payload" has 7 chars

    it "conditional branches select exactly one arm":
        step("Verify: conditional branches select exactly one arm")
        # @req: REQ-SYS-SMOKE-004
        val n = 7
        var tag = ""
        if n % 2 == 0:
            tag = "even"
        else:
            tag = "odd"
        expect(tag).to_equal("odd") # oracle: 7 is odd

    it "split reports every separator occurrence":
        step("Verify: split reports every separator occurrence")
        # @req: REQ-SYS-SMOKE-005
        val parts = "alpha,beta,gamma".split(",")
        expect(parts.len()).to_equal(3) # oracle: 2 separators split into 3 fields
        expect(parts[0]).to_equal("alpha")
        expect(parts[2]).to_equal("gamma")

