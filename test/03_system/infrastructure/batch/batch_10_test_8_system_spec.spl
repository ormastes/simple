"""
## Purpose and audience
Documents the synthetic system-test-batch execution contract (batch 10,
shard 8): a fixed set of small, independent language-feature checks (Option
match, nested collection lookup, string concatenation, integer division)
plus a `slow_it` smoke suite covering ten more core-language shapes, for
infra maintainers validating the batch test-runner harness itself.

## Operator workflow
`bin/simple test test/03_system/infrastructure/batch/batch_10_test_8_system_spec.spl`
runs the fast scenarios; add `--only-slow` to also run the ten `slow_it`
smoke checks below.

## Compatibility and limitations
This file is one of 500 generated members of the
`batch_N_test_M_system_spec.spl` synthetic family sharing one shape and one
deduction set; it exercises core language/runtime behavior only, not any
product-specific API.

## Verification guidance and troubleshooting
Rerun the command above after any interpreter or runtime change touching
`Option`, nested dicts, string concatenation, integer division, arrays,
recursion, or pattern matching. A failure means one of those core behaviors
regressed.
"""
# Lifecycle: doc/01_research/local/sspec_documentization_maintenance.md ;
# doc/03_plan/agent_tasks/sspec_documentization_maintenance.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/sspec_documentization_maintenance.md
# @manual_section: batch_execution_contract

# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%
# @cover src/compiler/80.driver/pipeline.spl 60%

use std.spec

fn verify(condition: bool):
    expect(condition).to_equal(true)

describe "system test batch execution contract":
    it "option match binds the carried payload":
        # @req: REQ-SYS-BATCH-032-001
        step("Verify: option match binds the carried payload")
        # @capture(statistics): value bound by the Some(v) match arm
        val opt = Some(41)
        match opt:
            Some(v):
                expect(v + 1).to_equal(42) # oracle: payload is 41
            nil:
                expect(false).to_equal(true) # oracle: nil arm must not run

    it "nested collection read goes through both keys":
        # @req: REQ-SYS-BATCH-032-002
        step("Verify: nested collection read goes through both keys")
        # @capture(statistics): value retrieved via the two-level key path
        val table = {"outer": {"inner": 9}}
        expect(table["outer"]["inner"]).to_equal(9) # oracle: nested lookup path

    it "string concatenation length is the sum of parts":
        # @req: REQ-SYS-BATCH-032-003
        step("Verify: string concatenation length is the sum of parts")
        # @capture(statistics): concatenated string and its length
        val joined = "foo" + "bar"
        expect(joined).to_equal("foobar")
        expect(joined.len()).to_equal(6) # oracle: 3 + 3 chars

    it "integer division and remainder follow truncation":
        # @req: REQ-SYS-BATCH-032-004
        step("Verify: integer division and remainder follow truncation")
        # @capture(statistics): quotient and remainder of 17 / 5
        expect(17 / 5).to_equal(3) # oracle: truncated quotient
        expect(17 % 5).to_equal(2) # oracle: remainder

    it "dict lookup returns the stored value per key":
        # @req: REQ-SYS-BATCH-032-005
        step("Verify: dict lookup returns the stored value per key")
        # @capture(statistics): dict values retrieved by key
        val d = {"alpha": 1, "beta": 2}
        expect(d["beta"]).to_equal(2) # oracle: value stored under "beta"
        expect(d["alpha"]).to_equal(1) # oracle: value stored under "alpha"

describe "System Test":
    slow_it "integer addition satisfies 1 + 1 == 2":
        # @req: REQ-SYS-BATCH-032-006
        step("Verify: integer addition satisfies 1 + 1 == 2")
        # @capture(statistics): boolean result of the addition check
        verify(1 + 1 == 2) # oracle: 1 + 1 evaluates to 2

    slow_it "string equality holds for two identical single-character strings":
        # @req: REQ-SYS-BATCH-032-007
        step("Verify: string equality holds for two identical single-character strings")
        # @capture(statistics): boolean result of the string equality check
        verify("a" == "a")

    slow_it "a positive local variable satisfies a greater-than-zero check":
        # @req: REQ-SYS-BATCH-032-008
        step("Verify: a positive local variable satisfies a greater-than-zero check")
        # @capture(statistics): boolean result of the greater-than-zero check
        val x = 5
        verify(x > 0) # oracle: 5 is greater than 0

    slow_it "array literal with three elements reports length 3":
        # @req: REQ-SYS-BATCH-032-009
        step("Verify: array literal with three elements reports length 3")
        # @capture(statistics): reported length of the array literal
        val arr = [1, 2, 3]
        verify(arr.len() == 3) # oracle: three elements were listed

    slow_it "every index in a 0..10 range satisfies a non-negative check":
        # @req: REQ-SYS-BATCH-032-010
        step("Verify: every index in a 0..10 range satisfies a non-negative check")
        # @capture(statistics): boolean result for each iterated index
        for i in 0..10:
            verify(i >= 0)

    slow_it "Some(42) satisfies the Option presence check":
        # @req: REQ-SYS-BATCH-032-011
        step("Verify: Some(42) satisfies the Option presence check")
        # @capture(statistics): presence-check result for a populated Option
        val opt = Some(42)
        verify(opt.?)

    slow_it "pattern match on Some(1) binds x to 1":
        # @req: REQ-SYS-BATCH-032-012
        step("Verify: pattern match on Some(1) binds x to 1")
        # @capture(statistics): value bound by the Some(x) match arm
        match Some(1):
            Some(x): verify(x == 1) # oracle: the wrapped value is 1
            nil: verify(false)

    slow_it "an if-true branch executes the true arm":
        # @req: REQ-SYS-BATCH-032-013
        step("Verify: an if-true branch executes the true arm")
        # @capture(statistics): which branch of the if executed
        if true:
            verify(true)
        else:
            verify(false)

    slow_it "dict lookup by key returns the stored string value":
        # @req: REQ-SYS-BATCH-032-014
        step("Verify: dict lookup by key returns the stored string value")
        # @capture(statistics): dict value retrieved by key
        val d = {"k": "v"}
        verify(d["k"] == "v")

    slow_it "summing a 0..5 range accumulates to 10":
        # @req: REQ-SYS-BATCH-032-015
        step("Verify: summing a 0..5 range accumulates to 10")
        # @capture(statistics): accumulated sum over the range
        var sum = 0
        for i in 0..5:
            sum = sum + i
        verify(sum == 10) # oracle: 0+1+2+3+4 = 10
