# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%
# @cover src/compiler/80.driver/pipeline.spl 60%

use std.spec

fn verify(condition: bool):
    expect(condition).to_equal(true)

describe "system test batch execution contract":
    it "trim removes surrounding padding only":
        step("Verify: trim removes surrounding padding only")
        # @req: REQ-SYS-BATCH-027-001
        val padded = "  payload  "
        expect(padded.trim()).to_equal("payload") # oracle: exact trimmed value
        expect(padded.trim().len()).to_equal(7) # oracle: "payload" has 7 chars

describe "System Test":
    slow_it "test 1":
        verify(1 + 1 == 2)
    slow_it "test 2":
        verify("a" == "a")
    slow_it "test 3":
        val x = 5
        verify(x > 0)
    slow_it "test 4":
        val arr = [1, 2, 3]
        verify(arr.len() == 3)
    slow_it "test 5":
        for i in 0..10:
            verify(i >= 0)
    slow_it "test 6":
        val opt = Some(42)
        verify(opt.?)
    slow_it "test 7":
        match Some(1):
            Some(x): verify(x == 1)
            nil: verify(false)
    slow_it "test 8":
        if true:
            verify(true)
        else:
            verify(false)
    slow_it "test 9":
        val d = {"k": "v"}
        verify(d["k"] == "v")
    slow_it "test 10":
        var total = 0
        for i in 0..5:
            total = total + i
        expect(total).to_equal(10) # oracle: 0+1+2+3+4 = 10

    it "boolean operators short-circuit to the pinned result":
        step("Verify: boolean operators short-circuit to the pinned result")
        # @req: REQ-SYS-BATCH-027-005
        expect(true and false).to_equal(false)
        expect(true or false).to_equal(true)
        expect(not false).to_equal(true)

