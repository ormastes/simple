"""
## Purpose and audience
Pins the observable execution contract of the system spec batch harness
(batch_3_test_45_system_spec.spl): every scenario asserts a concrete language/stdlib outcome that the
spec runner must report green for the batch lane to be trusted.
Audience: compiler and test-infrastructure engineers triaging batch runs.
## Operator workflow
Run `bin/simple test test/03_system/infrastructure/batch/batch_3_test_45_system_spec.spl` and read the per-scenario verdicts in the
`Results:` summary; each scenario asserts one externally visible outcome.
## Compatibility and limitations
Covers interpreter-path semantics exercised by batch lanes; native codegen
and performance envelopes are out of scope.
# @manual: primary
REQ-SYS-BATCH-009-001
doc/01_research/local/spec_batch.md
doc/03_plan/sys_test/spec_batch.md
doc/04_architecture/spec_batch.md
doc/05_design/spec_batch.md
"""
# @req: REQ-SYS-BATCH-009-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%
# @cover src/compiler/80.driver/pipeline.spl 60%

use std.spec

describe "system test batch execution contract":
    it "conditional branches select exactly one arm":
        step("Verify: conditional branches select exactly one arm")
        # @req: REQ-SYS-BATCH-009-001
        val n = 7
        var tag = ""
        if n % 2 == 0:
            tag = "even"
        else:
            tag = "odd"
        expect(tag).to_equal("odd") # oracle: 7 is odd

    it "split reports every separator occurrence":
        step("Verify: split reports every separator occurrence")
        # @req: REQ-SYS-BATCH-009-002
        val parts = "alpha,beta,gamma".split(",")
        expect(parts.len()).to_equal(3) # oracle: 2 separators split into 3 fields
        expect(parts[0]).to_equal("alpha")
        expect(parts[2]).to_equal("gamma")

    it "loop accumulation sums the inclusive range 0..4":
        step("Verify: loop accumulation sums the inclusive range 0..4")
        # @req: REQ-SYS-BATCH-009-003
        var total = 0
        for i in 0..5:
            total = total + i
        expect(total).to_equal(10) # oracle: 0+1+2+3+4 = 10

    it "boolean operators short-circuit to the pinned result":
        step("Verify: boolean operators short-circuit to the pinned result")
        # @req: REQ-SYS-BATCH-009-004
        expect(true and false).to_equal(false)
        expect(true or false).to_equal(true)
        expect(not false).to_equal(true)

    it "option match binds the carried payload":
        step("Verify: option match binds the carried payload")
        # @req: REQ-SYS-BATCH-009-005
        val opt = Some(41)
        match opt:
            Some(v):
                expect(v + 1).to_equal(42) # oracle: payload is 41
            nil:
                expect(false).to_equal(true) # oracle: nil arm must not run

