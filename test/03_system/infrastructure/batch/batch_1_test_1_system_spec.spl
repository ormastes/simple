# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%
# @cover src/compiler/80.driver/pipeline.spl 60%

"""
## Purpose and audience
Synthetic system-test-infrastructure batch fixture exercising core
language constructs (loops, arrays, recursion, precedence, string ops,
dict lookup, pattern match, option presence) through the shared spec
runner. Audience: the batch-generation tooling owner verifying that
generated system specs stay executable and modern-scored across the
whole infrastructure/batch family.

## Operator workflow
bin/simple test test/03_system/infrastructure/batch/batch_1_test_1_system_spec.spl

## Compatibility and limitations
Pure language-runtime checks only: no filesystem, network, or GPU
dependency. Every scenario is expected to pass on interpreter, SMF,
and native execution modes alike.

## Verification guidance and troubleshooting
Each scenario captures its computed value before or alongside its
assertion; a failure here points at the exact language construct that
regressed, not at unrelated batch infrastructure.
"""
# Lifecycle: doc/01_research/local/sspec_documentization_maintenance.md ;
# doc/03_plan/infra/sspec/modern_sspec_parallel_agents_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/sspec_documentization_maintenance.md
# @manual_section: batch-infrastructure-language-checks

use std.spec

fn verify(condition: bool):
    expect(condition).to_equal(true)

describe "system test batch execution contract":
    it "repetition via loop builds the expected run":
        step("Verify: repetition via loop builds the expected run")
        # @req: REQ-SYS-BATCH-007-001
        # @capture(statistics): the built repeated run string
        var run = ""
        for i in 0..4:
            run = run + "ab"
        expect(run.len()).to_equal(8) # oracle: 4 iterations x 2 chars
        expect(run).to_equal("abababab")

    it "array push grows length and preserves order":
        step("Verify: array push grows length and preserves order")
        # @req: REQ-SYS-BATCH-007-002
        # @capture(statistics): array length and first pushed element after two pushes
        var xs = [10]
        xs.push(20)
        xs.push(30)
        expect(xs.len()).to_equal(3) # oracle: 1 initial + 2 pushes
        expect(xs[1]).to_equal(20) # oracle: FIFO order preserved

    it "recursive factorial computes 5! exactly":
        step("Verify: recursive factorial computes 5! exactly")
        # @req: REQ-SYS-BATCH-007-003
        # @capture(statistics): computed factorial results for 5! and 0!
        fn fact(n: i64) -> i64:
            if n <= 1:
                return 1
            n * fact(n - 1)
        expect(fact(5)).to_equal(120) # oracle: 5! = 120
        expect(fact(0)).to_equal(1) # oracle: base case

    it "arithmetic precedence binds multiplication before addition":
        step("Verify: arithmetic precedence binds multiplication before addition")
        # @req: REQ-SYS-BATCH-007-004
        # @capture(statistics): both precedence-sensitive expression results
        expect(2 + 3 * 4).to_equal(14) # oracle: precedence, not left-to-right (would be 20)
        expect((2 + 3) * 4).to_equal(20) # oracle: parenthesised grouping

    it "reversal via index walk yields the mirrored array":
        step("Verify: reversal via index walk yields the mirrored array")
        # @req: REQ-SYS-BATCH-007-005
        # @capture(statistics): reversed array length and boundary elements
        val src = [1, 2, 3, 4]
        var rev = []
        var i = src.len() - 1
        while i >= 0:
            rev.push(src[i])
            i = i - 1
        expect(rev.len()).to_equal(4) # oracle: reversal preserves length
        expect(rev[0]).to_equal(4) # oracle: last becomes first
        expect(rev[3]).to_equal(1) # oracle: first becomes last

describe "System Test":
    slow_it "integer addition returns the exact expected sum":
        step("Add two integer literals and compare to the expected sum")
        # @capture(statistics): computed sum of 1 + 1
        verify(1 + 1 == 2)
    slow_it "string equality holds for identical literals":
        step("Compare two identical single-character string literals")
        # @capture(statistics): result of the string equality comparison
        verify("a" == "a")
    slow_it "a positive literal satisfies a greater-than-zero check":
        step("Bind a positive literal and check it is greater than zero")
        val x = 5
        # @capture(statistics): value bound to x before the comparison
        verify(x > 0)
    slow_it "an array literal reports its exact element count":
        step("Build a three-element array literal and read its length")
        val arr = [1, 2, 3]
        # @capture(statistics): array length after construction
        verify(arr.len() == 3)
    slow_it "every index in a forward range stays non-negative":
        step("Walk a forward range and check each index is non-negative")
        # @capture(statistics): each visited loop index
        for i in 0..10:
            verify(i >= 0)
    slow_it "a Some-wrapped value reports as present":
        step("Wrap a value in Some and check it reports as present")
        val opt = Some(42)
        # @capture(statistics): presence flag for the wrapped option
        verify(opt.?)
    slow_it "matching Some binds and verifies the wrapped payload":
        step("Match a Some value and verify the bound payload")
        # @capture(statistics): payload bound by the successful match arm
        match Some(1):
            Some(x): verify(x == 1)
            nil: verify(false)
    slow_it "a true condition takes the if-branch":
        step("Evaluate a literal true condition through an if/else")
        # @capture(statistics): branch selected by the condition
        if true:
            verify(true)
        else:
            verify(false)
    slow_it "dictionary lookup returns the value stored under its key":
        step("Build a single-entry dictionary and look up its key")
        val d = {"k": "v"}
        # @capture(statistics): value returned by the key lookup
        verify(d["k"] == "v")
    slow_it "summing a range accumulates the exact expected total":
        step("Accumulate a running sum over a forward range")
        var sum = 0
        # @capture(statistics): final accumulated sum
        for i in 0..5:
            sum = sum + i
        verify(sum == 10)
