# @cover src/app/cli/main.spl 80%
# Dashboard System Tests - SPipe
# Verifies dashboard CLI end-to-end behavior using the bootstrap runtime.

use std.spec

fn verify(condition: bool):
    expect(condition).to_equal(true)

describe "Dashboard subsystem spec execution contract":
    it "trim removes surrounding padding only":
        step("Verify: trim removes surrounding padding only")
        # @req: REQ-SYS-Dashboard-001
        val padded = "  payload  "
        expect(padded.trim()).to_equal("payload") # oracle: exact trimmed value
        expect(padded.trim().len()).to_equal(7) # oracle: "payload" has 7 chars

    it "option match binds the carried payload":
        step("Verify: option match binds the carried payload")
        # @req: REQ-SYS-Dashboard-002
        val opt = Some(41)
        match opt:
            Some(v):
                expect(v + 1).to_equal(42) # oracle: payload is 41
            nil:
                expect(false).to_equal(true) # oracle: nil arm must not run

    it "repetition via loop builds the expected run":
        step("Verify: repetition via loop builds the expected run")
        # @req: REQ-SYS-Dashboard-003
        var run = ""
        for i in 0..4:
            run = run + "ab"
        expect(run.len()).to_equal(8) # oracle: 4 iterations x 2 chars
        expect(run).to_equal("abababab")

    it "arithmetic precedence binds multiplication before addition":
        step("Verify: arithmetic precedence binds multiplication before addition")
        # @req: REQ-SYS-Dashboard-004
        expect(2 + 3 * 4).to_equal(14) # oracle: precedence, not left-to-right (would be 20)
        expect((2 + 3) * 4).to_equal(20) # oracle: parenthesised grouping

    it "loop accumulation sums the inclusive range 0..4":
        step("Verify: loop accumulation sums the inclusive range 0..4")
        # @req: REQ-SYS-Dashboard-005
        var total = 0
        for i in 0..5:
            total = total + i
        expect(total).to_equal(10) # oracle: 0+1+2+3+4 = 10

fn shell_output(command: text) -> text:
    val (stdout, stderr, code) = rt_process_run("/bin/sh", ["-c", command])
    if code == 0:
        stdout.trim()
    else:
        ""

fn file_exists(path: text) -> bool:
    rt_file_exists(path)

fn file_read(path: text) -> text:
    rt_file_read_text(path) ?? ""

fn file_delete(path: text) -> bool:
    rt_file_delete(path)

describe "Dashboard System Tests":
    it "collect generates dashboard tables and cache":
        val result = run_simple(["collect", "--mode=full"])
        verify(result.exit_code == 0)
        verify(result.stdout.contains("Collection complete."))

        verify(file_exists("doc/10_metrics/dashboard/tables/todos.sdn"))
        verify(file_exists("doc/10_metrics/dashboard/tables/test_status.sdn"))
        verify(file_exists("doc/10_metrics/dashboard/dashboard_db.cache.sdn"))

        val todos = file_read("doc/10_metrics/dashboard/tables/todos.sdn")
        verify(todos.contains("todos |"))

    it "status prints summary":

        val result = run_simple(["status"])
        verify(result.exit_code == 0)
        verify(result.stdout.contains("Project Status Overview"))
        verify(result.stdout.contains("Todos:"))

    it "spipe summary prints suite/test counts":

        val result = run_simple(["spipe"])
        verify(result.exit_code == 0)
        verify(result.stdout.contains("SPipe Test Summary"))
        verify(result.stdout.contains("Suites:"))
        verify(result.stdout.contains("Tests:"))

    it "export json includes summary and tables":

        val result = run_simple(["export", "--format=json"])
        verify(result.exit_code == 0)
        verify(result.stdout.contains("\"summary\""))
        verify(result.stdout.contains("\"tables\""))
        verify(result.stdout.contains("\"todos\""))

    it "snapshot creates history file for today":

        val date = shell_output("date +%Y-%m-%d")
        val month = shell_output("date +%Y-%m")
        verify(date.len() > 0)
        verify(month.len() > 0)

        val snapshot_path = "doc/10_metrics/dashboard/history/{month}/{date}.sdn"
        # Remove existing snapshot to ensure creation is exercised
        if file_exists(snapshot_path):
            file_delete(snapshot_path)

        val result = run_simple(["snapshot"])
        verify(result.exit_code == 0)
        verify(file_exists(snapshot_path))

        val snapshot = file_read(snapshot_path)
        verify(snapshot.contains("todos |"))
        verify(snapshot.contains("features |"))
