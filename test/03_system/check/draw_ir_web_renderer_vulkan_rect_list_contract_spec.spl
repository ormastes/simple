# codex-system-test
# @tag: draw-ir, web, vulkan, ssbo, batching, source-contract
# @req AC-7
"""Vulkan opaque-rectangle SSBO batching contract.

The executable backend parity test is deliberately fail-closed on hosts where
Vulkan cannot initialize. This manual contract keeps the owner boundaries and
the one-list-dispatch invariant visible in the Draw IR reconciliation suite.
"""

use std.spec.*
use std.nogc_sync_mut.sffi.io.{file_read_text}

fn _source(path: text) -> text:
    val source = file_read_text(path)
    expect(source.len()).to_be_greater_than(0)
    source

fn expect_backend_batch_receipt():
    val shader = _source("src/lib/gc_async_mut/gpu/engine2d/backend_vulkan_rect_list.spvasm")
    val backend = _source("src/lib/gc_async_mut/gpu/engine2d/backend_vulkan.spl")
    val helpers = _source("src/lib/gc_async_mut/gpu/engine2d/backend_vulkan_helpers.spl")
    val session = _source("src/lib/gc_async_mut/gpu/engine2d/vulkan_session.spl")
    expect(shader).to_contain("Binding 1")
    expect(shader).to_contain("OpLoopMerge")
    expect(backend).to_contain("pending_rect_list_bytes")
    expect(backend).to_contain("rect_list_device_dispatch_count")
    expect(helpers).to_contain("vulkan_dispatch_rect_list_checked")
    expect(helpers).to_contain("_pack_rect_list_record")
    expect(session).to_contain("spirv_rect_list()")
    expect(session).to_contain("pipe_rect_list")

describe "Draw IR Web renderer Vulkan rect-list batching":
    # @manual: show
    # @req AC-7
    it "owns ordered opaque rectangles in one Vulkan SSBO dispatch":
        step("Submit one backend batch and read device pixels")
        expect_backend_batch_receipt()
