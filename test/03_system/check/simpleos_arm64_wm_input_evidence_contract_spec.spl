"""
# SimpleOS ARM64 WM Input Evidence Source Contract

Non-admission inspection of the live ARM64 wrapper and QMP oracle. This spec
can prove that the lane is wired fail-closed, but it never substitutes for the
live acceptance scenario or a host-green `evidence.env`.
"""

# @tag: system, check, arm64, simpleos, qmp, source-contract

use app.io.mod.{file_read_text}
use std.spec.*

describe "SimpleOS ARM64 WM input evidence source contract":
    it "keeps static inspection separate from live production admission":
        val live_spec = file_read_text(
            "test/03_system/os/wm/arm64_simpleos_qmp_input_spec.spl"
        )
        expect(live_spec).to_contain(
            "fn require_arm64_live_qmp_input_evidence():"
        )
        expect(live_spec).to_contain(
            "source-contract assertions never satisfy this live scenario"
        )
        expect(live_spec).to_contain(
            "require_arm64_live_qmp_input_evidence()"
        )

    it "defines an owned bounded canonical ARM64 launch":
        val wrapper = file_read_text(
            "scripts/check/check-simpleos-arm64-wm-input-evidence.shs"
        )
        expect(wrapper).to_contain("BUILD_DIR=")
        expect(wrapper).to_contain("REPORT_PATH=")
        expect(wrapper).to_contain("SIMPLE_BIN_INPUT=")
        expect(wrapper).to_contain("SIMPLE_BINARY_INPUT=")
        expect(wrapper).to_contain("simple-bin-rust-seed-forbidden")
        expect(wrapper).to_contain("SIMPLE_NO_STUB_FALLBACK=1")
        expect(wrapper).to_contain(
            "examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl"
        )
        expect(wrapper).to_contain("--entry \"$ENTRY_REL\"")
        expect(wrapper).to_contain("--target aarch64-unknown-none")
        expect(wrapper).to_contain("-machine virt -cpu cortex-a72 -accel tcg")
        expect(wrapper).to_contain("-device ramfb")
        expect(wrapper).to_contain("-device virtio-keyboard-device")
        expect(wrapper).to_contain("-device virtio-mouse-device")
        expect(wrapper).to_contain("-qmp \"unix:$QMP_SOCKET,server=on,wait=off\"")
        expect(wrapper).to_contain("unsafe-qmp-socket-override-rejected")
        expect(wrapper).to_contain(
            "unsafe-build-or-report-path-rejected"
        )
        expect(wrapper).to_contain("os.path.realpath(sys.argv[1])")
        expect(wrapper).to_contain("mktemp -d")
        expect(wrapper).to_contain("--run-bounded")
        expect(wrapper).to_contain("--terminate-process-group")
        expect(wrapper).to_contain(
            "canonical-arm64-desktop-build-external-timeout"
        )
        expect(wrapper).to_contain("source-changed-during-build")
        expect(wrapper).to_contain("source-changed-during-capture")
        expect(wrapper).to_contain(
            "canonical-arm64-desktop-media-build-timeout"
        )
        expect(wrapper).to_contain(
            "validate_positive_bounded build-timeout"
        )
        expect(wrapper).to_contain(
            "simpleos_arm64_wm_input_source_manifest_before_build_sha256="
        )
        expect(wrapper).to_contain(
            "simpleos_arm64_wm_input_source_manifest_after_build_sha256="
        )
        expect(wrapper).to_contain(
            "simpleos_arm64_wm_input_source_manifest_after_capture_sha256="
        )
        expect(wrapper).to_contain(
            "simpleos_arm64_wm_input_configured_boot=direct-kernel"
        )
        expect(wrapper).to_contain(
            "simpleos_arm64_wm_input_configured_firmware=none"
        )
        expect(wrapper).to_contain(
            "simpleos_arm64_wm_input_observed_ramfb="
        )
        expect(wrapper).to_contain(
            "simpleos_arm64_wm_input_observed_virtio_keyboard="
        )
        expect(wrapper).to_contain(
            "simpleos_arm64_wm_input_observed_virtio_mouse="
        )
        expect(wrapper).to_contain(
            "OBSERVED_BOOT=guest-desktop-ready-after-direct-kernel-launch"
        )
        expect(wrapper).to_contain(
            "OBSERVED_FIRMWARE=not-guest-reported"
        )

    it "requires ordered native QMP input and capture evidence":
        val wrapper = file_read_text(
            "scripts/check/check-simpleos-arm64-wm-input-evidence.shs"
        )
        val capture = file_read_text(
            "scripts/check/simpleos_arm64_wm_qmp_input_capture.py"
        )
        expect(capture).to_contain("\"qmp_capabilities\"")
        expect(capture).to_contain(
            "qmp.command(\"screendump\", {\"filename\": path})"
        )
        expect(capture).to_contain("\"input-send-event\"")
        expect(capture).to_contain("\"down\": True")
        expect(capture).to_contain("\"down\": False")
        expect(capture).to_contain("\"type\": \"rel\"")
        expect(capture).to_contain("\"type\": \"btn\"")
        expect(capture).to_contain(
            "type=2 code=0 value=32 frame=raw-summary"
        )
        expect(capture).to_contain(
            "type=2 code=1 value=18 frame=raw-summary"
        )
        expect(capture).to_contain(
            "serial_path, key_up_sequence, 3, 0, \"move\", 544, 402"
        )
        expect(capture).to_contain(
            "device.start() < poll.start() < state.start() < frame.start()"
        )
        expect(capture).to_contain("max(raw_positions)")
        expect(capture).to_contain("< sync.start()")
        expect(capture).to_contain("< poll.start()")
        expect(capture).to_contain("< state.start()")
        expect(capture).to_contain("< frame.start()")
        expect(capture).to_contain("settle_ramfb")
        expect(capture).to_contain("ppm-blank-or-uniform")
        expect(capture).to_contain("baseline-post-captures-identical")
        expect(capture).to_contain("qmp.command_count != 8")
        expect(capture).to_contain("emit(\"status\", \"PASS\")")
        expect(capture).to_contain(
            "\"scripts/os/make_os_disk.shs\""
        )
        expect(capture).to_contain("\"scripts/os/make_os_disk.c\"")
        expect(capture).to_contain("\"assets/fonts\"")
        expect(capture.contains("frame_generation")).to_be(false)
        expect(wrapper.contains("frame_generation")).to_be(false)
        expect(wrapper).to_contain(
            "simpleos_arm64_wm_input_baseline_ppm_sha256="
        )
        expect(wrapper).to_contain(
            "simpleos_arm64_wm_input_post_input_ppm_sha256="
        )
        expect(wrapper).to_contain(
            "simpleos_arm64_wm_input_qmp_command_count="
        )
        expect(wrapper).to_contain(
            "Static/source evidence is never promoted to live evidence."
        )
