# codex-system-test
# @evidence-display: embed_tui
# @req REQ-RENDER-CLI-002
"""
# Cached Render Entry Closure Runtime Selection

This executable contract covers only the lightweight native-build worker
selection boundary. It does not admit a Stage 4 CLI, execute native-build, or
claim sparse 8K runtime evidence. Run it only with a provenance-qualified
pure-Simple test runtime; a Rust seed or the known-bad release artifact is not
test evidence.
"""

use app.cli.bootstrap_identity.{native_build_runtime_is_rust_seed, native_build_select_worker_runtime, native_build_worker_preflight_code}
use std.spec.*

fn setup_cached_render_entry_closure(
    configured_binary: text,
    configured_binary_available: bool,
    configured_bin: text,
    configured_bin_available: bool,
    invoking_binary: text,
    invoking_binary_available: bool,
) -> text:
    native_build_select_worker_runtime(
        configured_binary,
        configured_binary_available,
        configured_bin,
        configured_bin_available,
        invoking_binary,
        invoking_binary_available,
    )

fn check_cached_render_entry_closure(selected_runtime: text) -> i64:
    native_build_worker_preflight_code(selected_runtime)

describe "CachedRenderEntryClosureV1 worker runtime selection":
    # @req REQ-RENDER-CLI-002
    it "should select the first available explicit pure-Simple candidate":
        step("Admit the exact Stage 4 CLI")
        val selected = setup_cached_render_entry_closure(
            "/opt/simple/admitted-stage4", true,
            "/opt/simple/secondary", true,
            "/opt/simple/invoking", true,
        )
        expect(selected).to_equal("/opt/simple/admitted-stage4")
        expect(check_cached_render_entry_closure(selected)).to_equal(0)

    # @req REQ-RENDER-CLI-002
    it "should reject canonical Rust seed candidates before worker spawn":
        step("Admit the exact Stage 4 CLI")
        val selected = setup_cached_render_entry_closure(
            "src/compiler_rust/target/bootstrap/simple", true,
            "", false,
            "", false,
        )
        expect(native_build_runtime_is_rust_seed("src/compiler_rust/target/bootstrap/simple")).to_equal(true)
        expect(selected).to_equal("")
        expect(check_cached_render_entry_closure(selected)).to_equal(1)

    # @req REQ-RENDER-CLI-002
    it "should fail closed when only an unavailable implicit path remains":
        step("Admit the exact Stage 4 CLI")
        val selected = setup_cached_render_entry_closure(
            "bin/simple", false,
            "", false,
            "", false,
        )
        expect(selected).to_equal("")
        expect(check_cached_render_entry_closure(selected)).to_equal(1)
