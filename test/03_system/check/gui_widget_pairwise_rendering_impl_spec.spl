# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""GUI widget pairwise evidence status.

The rows below are a sample matrix. Count their actual dimension pairs before
reporting coverage. A separate widget-to-DrawIR witness proves the GUI uses the
shared drawing path; this spec does not verify final pixels or backend parity.
"""

use std.spec.*
use common.ui.builder.{button}
use common.ui.widget_draw_ir.{widget_tree_to_draw_ir_cpu}


# =========================================================================
# Sample matrix row
# =========================================================================

struct WidgetRenderTest:
    test_id: i64
    widget_name: text
    layout: text
    system: text
    device: text


fn count_unique_dimension_pairs(tests: [WidgetRenderTest]) -> i64:
    var seen: [text] = []
    for test in tests:
        val pairs = [
            "widget-layout:{test.widget_name}:{test.layout}",
            "widget-system:{test.widget_name}:{test.system}",
            "widget-device:{test.widget_name}:{test.device}",
            "layout-system:{test.layout}:{test.system}",
            "layout-device:{test.layout}:{test.device}",
            "system-device:{test.system}:{test.device}"
        ]
        for pair in pairs:
            var found = false
            for existing in seen:
                if existing == pair:
                    found = true
            if not found:
                seen.push(pair)
    seen.len

fn pairwise_coverage_status(tests: [WidgetRenderTest], required_pairs: i64) -> text:
    if count_unique_dimension_pairs(tests) == required_pairs:
        "complete"
    else:
        "incomplete"


# =========================================================================
# Sample matrix rows
#
# Thirty sample rows. This is not a covering array and does not establish
# widget rendering, final pixels, or coverage of every dimension pair.
# =========================================================================

fn generate_pairwise_test_cases() -> [WidgetRenderTest]:
    """Return the thirty sample rows used by this evidence audit."""
    var tests: [WidgetRenderTest] = []
    var id = 0

    # Test case group 1: Panel widget with layout variations
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Panel", layout: "Block", system: "Glass", device: "Phone"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Panel", layout: "Inline", system: "iOS", device: "Tablet"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Panel", layout: "Float", system: "TUI", device: "Desktop"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Panel", layout: "Table", system: "Browser", device: "Phone"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Panel", layout: "Flex", system: "Office", device: "Tablet"))
    id = id + 1

    # Test case group 2: Button widget
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Button", layout: "Block", system: "iOS", device: "Phone"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Button", layout: "Inline", system: "TUI", device: "Tablet"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Button", layout: "Float", system: "Browser", device: "Desktop"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Button", layout: "Table", system: "Office", device: "Phone"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Button", layout: "Grid", system: "Glass", device: "Tablet"))
    id = id + 1

    # Test case group 3: Input widget
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Input", layout: "Block", system: "TUI", device: "Phone"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Input", layout: "Inline", system: "Browser", device: "Tablet"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Input", layout: "Float", system: "Office", device: "Desktop"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Input", layout: "Table", system: "Glass", device: "Phone"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Input", layout: "Flex", system: "iOS", device: "Tablet"))
    id = id + 1

    # Test case group 4: List widget
    tests.push(WidgetRenderTest(test_id: id, widget_name: "List", layout: "Block", system: "Browser", device: "Phone"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "List", layout: "Inline", system: "Office", device: "Tablet"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "List", layout: "Float", system: "Glass", device: "Desktop"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "List", layout: "Table", system: "iOS", device: "Phone"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "List", layout: "Grid", system: "TUI", device: "Tablet"))
    id = id + 1

    # Test case group 5: Dialog widget
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Dialog", layout: "Block", system: "Office", device: "Desktop"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Dialog", layout: "Inline", system: "Glass", device: "Phone"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Dialog", layout: "Float", system: "iOS", device: "Tablet"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Dialog", layout: "Table", system: "TUI", device: "Desktop"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Dialog", layout: "Paint", system: "Browser", device: "Phone"))
    id = id + 1

    # Test case group 6: Text widget
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Text", layout: "Inline", system: "Glass", device: "Phone"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Text", layout: "Block", system: "iOS", device: "Desktop"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Text", layout: "Float", system: "Browser", device: "Tablet"))
    id = id + 1

    # Test case group 7: Grid widget
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Grid", layout: "Grid", system: "Office", device: "Desktop"))
    id = id + 1
    tests.push(WidgetRenderTest(test_id: id, widget_name: "Grid", layout: "Flex", system: "Glass", device: "Tablet"))
    id = id + 1

    # A full covering array requires separately generated and executed rows.

    tests


# =========================================================================
# Truthful evidence checks
# =========================================================================

describe "GUI widget pairwise evidence status":
    # @manual show

    it "reports the sample matrix as incomplete against its advertised target":
        # @req REQ-SSPEC-SYSTEM
        step("Count distinct pairs represented by the sample rows")
        val tests = generate_pairwise_test_cases()
        val covered_pairs = count_unique_dimension_pairs(tests)
        expect(tests.len).to_equal(30)
        expect(covered_pairs).to_equal(134)
        expect(covered_pairs).to_be_less_than(831)
        expect(pairwise_coverage_status(tests, 831)).to_equal("incomplete")

    it "keeps duplicate rows from inflating covered pair count":
        # @req REQ-SSPEC-SYSTEM
        step("Duplicate one row and compare distinct pair counts")
        val tests = generate_pairwise_test_cases()
        val first = tests[0]
        expect(count_unique_dimension_pairs([first, first])).to_equal(6)
        expect(pairwise_coverage_status([first, first], 831)).to_equal("incomplete")

    it "emits a real GUI button command through shared DrawIR":
        # @req REQ-SSPEC-SYSTEM
        step("Project a button widget through the GUI DrawIR producer")
        val root = button("pairwise-drawir-witness", "Open", "open")
        val draw = widget_tree_to_draw_ir_cpu(root, 120, 32)
        var found_button = false
        for batch in draw.batches:
            for command in batch.commands:
                if command.component_id == "pairwise-drawir-witness":
                    found_button = true
        expect(found_button).to_equal(true)
