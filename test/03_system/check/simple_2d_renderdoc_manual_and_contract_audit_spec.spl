# codex-system-test
# @req REQ-010 REQ-014 REQ-015
"""# Simple 2D RenderDoc Manual and Contract Audit

Keeps executable modern SSpec, generated manuals, guides, cooperative review,
and source-layout contracts synchronized.
"""
use std.spec.*
use std.io_runtime.{file_exists, file_read, process_run}
use common.renderdoc.backend_render_record.{compare_backend_render_records, parse_backend_render_record, serialize_backend_render_record}
use test.helpers.backend_render_record_fixture.{BACKEND_RENDER_FIXTURE_HASH, backend_render_fixture, backend_render_fixture_replace}

val SPECS = [
    "test/01_unit/lib/common/renderdoc/backend_render_record_spec.spl",
    "test/01_unit/lib/common/renderdoc/backend_render_receipt_wire_spec.spl",
    "test/01_unit/lib/common/renderdoc/simpleos_render_evidence_spec.spl",
    "test/02_integration/rendering/backend_render_equivalence_spec.spl",
    "test/02_integration/rendering/engine2d_backend_provenance_matrix_spec.spl",
    "test/02_integration/rendering/engine2d_render_surface_matrix_spec.spl",
    "test/02_integration/rendering/engine2d_x86_simd_execution_spec.spl",
    "test/03_system/check/renderdoc_capture_replay_inspection_spec.spl",
    "test/03_system/gui/wm_compare/simple_web_backend_equivalence_spec.spl",
    "test/03_system/check/simple_2d_renderdoc_backend_equivalence_aggregate_spec.spl",
    "test/03_system/check/simple_2d_renderdoc_manual_and_contract_audit_spec.spl",
    "test/03_system/os/qemu/simpleos_render_evidence_protocol_spec.spl",
    "test/03_system/os/simpleos_physical_board_render_evidence_spec.spl"
]

val MANUALS = [
    "doc/06_spec/01_unit/lib/common/renderdoc/backend_render_record_spec.md",
    "doc/06_spec/01_unit/lib/common/renderdoc/backend_render_receipt_wire_spec.md",
    "doc/06_spec/01_unit/lib/common/renderdoc/simpleos_render_evidence_spec.md",
    "doc/06_spec/02_integration/rendering/backend_render_equivalence_spec.md",
    "doc/06_spec/02_integration/rendering/engine2d_backend_provenance_matrix_spec.md",
    "doc/06_spec/02_integration/rendering/engine2d_render_surface_matrix_spec.md",
    "doc/06_spec/02_integration/rendering/engine2d_x86_simd_execution_spec.md",
    "doc/06_spec/03_system/check/renderdoc_capture_replay_inspection_spec.md",
    "doc/06_spec/03_system/gui/wm_compare/simple_web_backend_equivalence_spec.md",
    "doc/06_spec/03_system/check/simple_2d_renderdoc_backend_equivalence_aggregate_spec.md",
    "doc/06_spec/03_system/check/simple_2d_renderdoc_manual_and_contract_audit_spec.md",
    "doc/06_spec/03_system/os/qemu/simpleos_render_evidence_protocol_spec.md",
    "doc/06_spec/03_system/os/simpleos_physical_board_render_evidence_spec.md"
]

describe "Simple 2D RenderDoc documentation contract":
    # @capture(exec)
    it "mirrors every executable scenario into an operator manual":
        step("Inspect all backend-equivalence spec and manual pairs")
        expect(SPECS.len()).to_equal(MANUALS.len())
        expect(SPECS.len()).to_equal(13)
        var index = 0
        while index < SPECS.len():
            expect(file_exists(SPECS[index])).to_be(true)
            expect(file_exists(MANUALS[index])).to_be(true)
            expect(file_read(MANUALS[index]).len()).to_be_greater_than(0)
            val legacy = MANUALS[index].replace("doc/06_spec/", "doc/06_spec/test/")
            expect(file_exists(legacy)).to_be(true)
            expect(file_read(legacy).len()).to_be_greater_than(0)
            index = index + 1

    # @capture(exec)
    it "keeps modern steps requirements direct matchers and no fail placeholders":
        step("Audit scenario source quality")
        for path in SPECS:
            val source = file_read(path)
            expect(source).to_contain("# @req")
            expect(source).to_contain("step(")
            expect(source).to_contain("expect(")
            if path != "test/03_system/check/simple_2d_renderdoc_manual_and_contract_audit_spec.spl":
                expect(source.contains("pass_todo")).to_be(false)
                expect(source.contains("expect(true).to_equal(true)")).to_be(false)
                expect(source.contains("pending_")).to_be(false)

    # @capture(exec)
    it "requires complete ordered backend render records at every canonical producer":
        step("Inspect the pure record owner and canonical producers")
        val owner = file_read("src/lib/common/renderdoc/backend_render_record.spl")
        val vulkan = file_read("src/app/test/renderdoc_vulkan_capture.spl")
        val translated = file_read("src/app/test/engine2d_vulkan_translation_probe.spl")
        val compare_app = file_read("src/app/test/backend_render_record_compare.spl")
        val evidence_helper = file_read("scripts/lib/renderdoc-evidence-common.shs")
        val required = [
            "commands.000.identity", "pipelines.000.pipeline_id",
            "pipelines.000.vertex_shader_id", "pipelines.000.fragment_shader_id",
            "resources.000.binding", "transitions.000.identity",
            "synchronization.000.identity", "state.viewport.width",
            "state.scissor.width"
        ]
        for field in required:
            expect(vulkan).to_contain(field)
            expect(translated).to_contain(field)
        step("Require fail-closed identity validation without transient GPU state")
        expect(owner).to_contain("duplicate-id")
        expect(owner).to_contain("invalid-viewport")
        expect(owner).to_contain("invalid-scissor")
        expect(owner.contains("Engine2D")).to_be(false)
        expect(owner.contains("Vulkan")).to_be(false)
        step("Require both real producers to cross the shared serialized boundary")
        expect(vulkan).to_contain("simple_renderdoc_record_begin=capture")
        expect(translated).to_contain("simple_renderdoc_record_begin=translation")
        expect(compare_app).to_contain("parse_backend_render_record")
        expect(compare_app).to_contain("verify_backend_render_equivalence")
        expect(evidence_helper).to_contain("rdoc_extract_simple_render_record")
        expect(evidence_helper).to_contain("backend_render_record_compare.spl")
        step("Execute the same serialized validator and comparison consumed by Simple RenderDoc")
        val left = backend_render_fixture("simple-renderdoc", "vulkan", "vulkan", "vulkan", "native", "none", 42, "device_readback", BACKEND_RENDER_FIXTURE_HASH, 12)
        val right = backend_render_fixture("translation-probe", "directx", "vulkan", "vulkan", "translated", "directx-on-vulkan", 73, "device_readback", BACKEND_RENDER_FIXTURE_HASH, 12)
        var parsed_left = left
        var parsed_right = right
        match serialize_backend_render_record(left):
            case Err(err): fail("Simple RenderDoc serialization failed: {err.code}")
            case Ok(wire):
                match parse_backend_render_record(wire):
                    case Err(err): fail("Simple RenderDoc parse failed: {err.code}")
                    case Ok(record): parsed_left = record
        match serialize_backend_render_record(right):
            case Err(err): fail("Translation serialization failed: {err.code}")
            case Ok(wire):
                match parse_backend_render_record(wire):
                    case Err(err): fail("Translation parse failed: {err.code}")
                    case Ok(record): parsed_right = record
        expect(compare_backend_render_records(parsed_left, parsed_right).semantic_equal).to_be(true)
        val reordered = backend_render_fixture_replace(right, "commands.000.identity", "command-present")
        expect(compare_backend_render_records(left, reordered).semantic_equal).to_be(false)

    # @manual: folded
    # @capture(exec)
    it "rejects executable specs under the generated manual tree":
        step("Scan doc/06_spec for executable Simple files")
        val (out, _err, code) = process_run(
            "/bin/sh", ["-c", "find doc/06_spec -name '*_spec.spl' -print"])
        expect(code).to_equal(0)
        expect(out).to_equal("")

    # @manual: folded
    # @capture(exec)
    it "requires sidecar merge and highest-capability review ownership":
        step("Inspect cooperative review completion")
        val plan = file_read(
            "doc/03_plan/agent_tasks/simple_2d_renderdoc_backend_equivalence.md")
        expect(plan).to_contain("Merge owner: primary Codex `/root`")
        expect(plan).to_contain("Final reviewer: highest available normal Codex")
        expect(plan).to_contain("Generated-manual review owner: primary Codex")
        expect(plan).to_contain("Sidecars were read-only design auditors")
