        expect(empty_items).to_contain("chrome_simple_web_layout_geometry_producer=chrome-headless-geometry")
        expect(empty_items).to_contain("chrome_simple_web_layout_geometry_item_count=0")
        expect(empty_items).to_contain("chrome_simple_web_layout_geometry_measured_item_count=0")
        expect(placeholder_item).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(placeholder_item).to_contain("chrome_simple_web_layout_validation_reason=missing-chrome-geometry-measured-items")
        expect(placeholder_item).to_contain("chrome_simple_web_layout_geometry_item_count=1")
        expect(placeholder_item).to_contain("chrome_simple_web_layout_geometry_measured_item_count=0")
        expect(offscreen_item).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(offscreen_item).to_contain("chrome_simple_web_layout_validation_reason=missing-chrome-geometry-measured-items")
        expect(offscreen_item).to_contain("chrome_simple_web_layout_geometry_item_count=1")
        expect(offscreen_item).to_contain("chrome_simple_web_layout_geometry_measured_item_count=0")

    it "rejects Chrome geometry viewport that differs from captured pixels":
        # @req: REQ-CHECK-ChroSimpWebLayProoVali-019
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-chrome-layout-validator-geometry-viewport"
        _prepare_dir(root, true)
        _write_proof(root + "/proof.json", [_kv("geometry_path", "\"geom_95.json\"")])
        expect(file_write_exact(root + "/geom_95.json", _geometry_json("95", 64, "chrome-headless-geometry", "[{{\"label\":\"root\",\"tag\":\"div\",\"x\":0,\"y\":0,\"width\":95,\"height\":64}}]"))).to_equal(true)
        val (evidence, code) = _run_validator(root + "/proof.json")
        expect(code).to_equal(1)  # oracle: validator exits 1 on the injected defect (fail-closed reject contract)

        step("Confirm geometry viewport must match captured Chrome ARGB dimensions")
        expect(evidence).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(evidence).to_contain("chrome_simple_web_layout_validation_reason=chrome-geometry-viewport-mismatch")
        expect(evidence).to_contain("chrome_simple_web_layout_capture_width=96")
        expect(evidence).to_contain("chrome_simple_web_layout_geometry_viewport_width=95")

    it "rejects missing or fractional capture viewport proof rows":
        # @req: REQ-CHECK-ChroSimpWebLayProoVali-020
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-chrome-layout-validator-viewport-proof"
        _prepare_dir(root, true)
        _write_proof(root + "/missing.json", [_kv("width", "__OMIT__")])
        _write_proof(root + "/fractional.json", [_kv("height", "64.5")])
        val (missing, c1) = _run_validator(root + "/missing.json")
        val (fractional, c2) = _run_validator(root + "/fractional.json")
        expect(c1).to_equal(1)
        expect(c2).to_equal(1)

        step("Confirm capture dimensions are explicit integer proof rows")
        expect(missing).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(missing).to_contain("chrome_simple_web_layout_validation_reason=missing-capture-viewport")
        expect(missing).to_contain("chrome_simple_web_layout_capture_width=")
        expect(fractional).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(fractional).to_contain("chrome_simple_web_layout_validation_reason=missing-capture-viewport")
        expect(fractional).to_contain("chrome_simple_web_layout_capture_height=")
        expect_not(fractional.contains("chrome_simple_web_layout_capture_height=64.5"))

    it "rejects stringified Chrome viewport geometry and timing proof rows":
        # @req: REQ-CHECK-ChroSimpWebLayProoVali-021
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-chrome-layout-validator-string-numeric-proof"
        _prepare_dir(root, true)
        _write_proof(root + "/capture.json", [_kv("width", "\"96\"")])
        _write_proof(root + "/mismatch.json", [_kv("mismatch_count", "\"0\"")])
        _write_proof(root + "/argb.json", [_kv("captured_argb_path", "\"argb_str.json\"")])
        expect(file_write_exact(root + "/argb_str.json", _argb_json("\"96\"", 64, "argb-u32", "chrome-headless-screenshot", "4294967295", 96 * 64))).to_equal(true)
        _write_proof(root + "/geometry_proof.json", [_kv("geometry_path", "\"geom_str.json\"")])
        expect(file_write_exact(root + "/geom_str.json", _geometry_json("\"96\"", 64, "chrome-headless-geometry", "[{{\"label\":\"root\",\"tag\":\"div\",\"x\":0,\"y\":0,\"width\":96,\"height\":64}}]"))).to_equal(true)
        _write_proof(root + "/timing.json", [_kv("frame_us", "\"1250\"")])

        val (capture, c1) = _run_validator(root + "/capture.json")
        val (mismatch, c2) = _run_validator(root + "/mismatch.json")
        val (argb, c3) = _run_validator(root + "/argb.json")
        val (geometry, c4) = _run_validator(root + "/geometry_proof.json")
        val (timing, c5) = _run_validator(root + "/timing.json")
        expect(c1).to_equal(1)
        expect(c2).to_equal(1)
        expect(c3).to_equal(1)
        expect(c4).to_equal(1)
        expect(c5).to_equal(1)

        step("Confirm Chrome live numeric proof cannot be stringified")
        expect(capture).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(capture).to_contain("chrome_simple_web_layout_validation_reason=missing-capture-viewport")
        expect(capture).to_contain("chrome_simple_web_layout_capture_width=")
        expect_not(capture.contains("chrome_simple_web_layout_capture_width=96"))
        expect(mismatch).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(mismatch).to_contain("chrome_simple_web_layout_validation_reason=malformed-mismatch-count")
        expect(mismatch).to_contain("chrome_simple_web_layout_mismatch_count=")
        expect_not(mismatch.contains("chrome_simple_web_layout_mismatch_count=0"))
        expect(argb).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(argb).to_contain("chrome_simple_web_layout_validation_reason=captured-argb-viewport-mismatch")
        expect(argb).to_contain("chrome_simple_web_layout_captured_argb_width=")
        expect_not(argb.contains("chrome_simple_web_layout_captured_argb_width=96"))
        expect(geometry).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(geometry).to_contain("chrome_simple_web_layout_validation_reason=chrome-geometry-viewport-mismatch")
        expect(geometry).to_contain("chrome_simple_web_layout_geometry_viewport_width=")
        expect_not(geometry.contains("chrome_simple_web_layout_geometry_viewport_width=96"))
        expect(timing).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(timing).to_contain("chrome_simple_web_layout_validation_reason=missing-chrome-timing")
        expect(timing).to_contain("chrome_simple_web_layout_chrome_frame_us=")
        expect_not(timing.contains("chrome_simple_web_layout_chrome_frame_us=1250"))

