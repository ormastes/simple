# @cover scripts/check/check-chrome-simple-web-layout-bitmap-evidence.shs 80%
"""
## Purpose and audience
Purpose: accepts complete Chrome timing capture and checksum proof
Audience: compiler and tooling engineers who maintain this spec

# Chrome Simple Web layout proof validator

## Overview

Validates the Chrome/Chromium Simple Web layout proof validator used by the
Chrome headless/DevTools bitmap capture wrapper.

**Plan:** doc/03_plan/ui/tui/production_gui_web_renderer_parity_hardening.md
**Requirements:** N/A
**Research:** N/A
**Design:** doc/07_guide/tooling/renderdoc_capture_infra.md

## Syntax

```sh
SIMPLE_LIB=src bin/simple test test/03_system/check/chrome_simple_web_layout_proof_validator_spec.spl --mode=interpreter --clean --fail-fast
```

## Acceptance

- Complete Chrome layout proof JSON, ARGB readback, and measured geometry
  validate cleanly and emit normalized `chrome_simple_web_layout_*` rows.
- Unexpected proof-source, missing/hardlinked/non-regular/markerless producer
  source artifacts, missing DevTools runtime metadata, and blur/tolerance use
  fail closed.
- Missing, empty, self-referential, symlinked, hardlinked, malformed, or
  dimension/checksum-mismatched ARGB or geometry artifacts fail closed.
- Stringified numeric rows and string booleans fail closed without coercion.
- The live Chrome wrapper preserves diagnostics on early missing-artifact exits
  and maps real mismatches to `divergent`.
"""

# @tag: system, gui, chrome, renderer, capture, performance

use std.io_runtime.{dir_create_all, dir_remove_all, file_copy, file_exists, file_read, file_write_exact, process_run}
use std.spec.*

struct KV:
    key: text
    value: text

fn _kv(key: text, value: text) -> KV:
    KV(key: key, value: value)

fn _repeat_csv(elem: text, count: i64) -> text:
    if count <= 0:
        return ""
    var result = ""
    var block = elem
    var remaining = count
    while remaining > 0:
        if remaining % 2 == 1:
            if result == "":
                result = block
            else:
                result = result + "," + block
        remaining = remaining / 2
        if remaining > 0:
            block = block + "," + block
    result

fn _argb_json(width_json: text, height: i64, format_str: text, producer: text, pixel_val: text, pixel_count: i64) -> text:
    "{{\"width\":" + width_json + ",\"height\":" + height.to_string() + ",\"format\":\"" + format_str + "\",\"producer\":\"" + producer + "\",\"pixels\":[" + _repeat_csv(pixel_val, pixel_count) + "]}}"

fn _geometry_json(width_json: text, height: i64, producer: text, items_json: text) -> text:
    "{{\"producer\":\"" + producer + "\",\"viewport\":{{\"width\":" + width_json + ",\"height\":" + height.to_string() + "}},\"items\":" + items_json + "}}"

fn _write_defaults(dir: text):
    val tmpl_argb = "build/.tmp_chrome_default_argb.json"
    val tmpl_geom = "build/.tmp_chrome_default_geom.json"
    if not file_exists(tmpl_argb):
        expect(dir_create_all("build")).to_equal(true)
        expect(file_write_exact(tmpl_argb, _argb_json("96", 64, "argb-u32", "chrome-headless-screenshot", "4294967295", 96 * 64))).to_equal(true)
    if not file_exists(tmpl_geom):
        expect(dir_create_all("build")).to_equal(true)
        expect(file_write_exact(tmpl_geom, _geometry_json("96", 64, "chrome-headless-geometry", "[{{\"label\":\"root\",\"tag\":\"div\",\"x\":0,\"y\":0,\"width\":96,\"height\":64}}]"))).to_equal(true)
    expect(file_copy(tmpl_argb, dir + "/captured.json")).to_equal(true)
    expect(file_copy(tmpl_geom, dir + "/geometry.json")).to_equal(true)

fn _prepare_dir(root: text, with_artifacts: bool):
    val _removed = dir_remove_all(root)
    expect(dir_create_all(root)).to_equal(true)
    if with_artifacts:
        _write_defaults(root)

fn _find_override(overrides: [KV], key: text) -> text:
    for item in overrides:
        if item.key == key:
            return item.value
    "__DEFAULT__"

fn _write_proof(proof_path: text, overrides: [KV]):
    val defaults = [
        _kv("proof_source", "\"tools/chrome-live-bitmap/capture_html_argb.js\""),
        _kv("capture_mode", "\"chrome-devtools-screenshot\""),
        _kv("chrome_user_agent", "\"Mozilla/5.0 Chrome/142.0.0.0 Safari/537.36\""),
        _kv("chrome_product", "\"Chrome/142.0.0.0\""),
        _kv("chrome_protocol_version", "\"1.3\""),
        _kv("checksum", "\"26388279060480\""),
        _kv("expected_checksum", "\"26388279060480\""),
        _kv("weighted_checksum", "\"81077987413324800\""),
        _kv("expected_weighted_checksum", "\"81077987413324800\""),
        _kv("mismatch_count", "0"),
        _kv("width", "96"),
        _kv("height", "64"),
        _kv("frame_us", "1250"),
        _kv("captured_argb_path", "\"captured.json\""),
        _kv("captured_argb_written", "true"),
        _kv("geometry_path", "\"geometry.json\""),
        _kv("geometry_written", "true"),
        _kv("blur_or_tolerance_used", "false"),
        _kv("chrome_bin", "\"/usr/bin/google-chrome\"")
    ]
    var out = "{{"
    var first = true
    for item in defaults:
        val ov = _find_override(overrides, item.key)
        if ov != "__OMIT__":
            val value = if ov == "__DEFAULT__": item.value else: ov
            if not first:
                out = out + ","
            out = out + "\"" + item.key + "\":" + value
            first = false
    for extra in overrides:
        if _find_override(defaults, extra.key) == "__DEFAULT__" and extra.value != "__OMIT__":
            if not first:
                out = out + ","
            out = out + "\"" + extra.key + "\":" + extra.value
            first = false
    out = out + "}}"
    expect(file_write_exact(proof_path, out)).to_equal(true)

fn _run_validator(proof_path: text) -> (text, i64):
    val (stdout, _stderr, code) = process_run("node", ["scripts/check/validate-chrome-simple-web-layout-proof.js", proof_path])
    (stdout, code)

fn _run_validator_in_dir(work_dir: text, proof_name: text) -> (text, i64):
    val js = "const path=require('path');const s=path.resolve(process.argv[2]);process.chdir(process.argv[1]);process.argv=[process.argv[0],s,process.argv[3]];require(s)"
    val (stdout, _stderr, code) = process_run("node", ["-e", js, work_dir, "scripts/check/validate-chrome-simple-web-layout-proof.js", proof_name])
    (stdout, code)

fn _create_symlink(target: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').symlinkSync(process.argv[1], process.argv[2])", target, link_path])
    code

fn _create_hardlink(existing_path: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').linkSync(process.argv[1], process.argv[2])", existing_path, link_path])
    code

# Lifecycle: doc/01_research/ui/render_path/electron_tauri_vulkan_enablement_2026-06-16.md ;
# doc/03_plan/ui/tui/production_gui_web_renderer_parity_hardening.md ;
# doc/04_architecture/ui/simple_gui_stack.md ;
# doc/05_design/browser_wasm_webgpu_infra.md
# @manual_section: proof validators

describe "Chrome Simple Web layout proof validator":

    it "accepts complete Chrome timing capture and checksum proof":
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        step("Verify: accepts complete Chrome timing capture and checksum proof")
        # @req: REQ-CHECK-ChroSimpWebLayoProoVali-001
        val root = "build/test-chrome-layout-validator-pass"
        _prepare_dir(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, [])
        val (evidence, code) = _run_validator(proof_path)
        expect(code).to_equal(0)  # oracle: validator exits 0 only for a complete well-formed proof (fail-closed exit contract)

        step("Inspect normalized Chrome layout proof rows")
        expect(evidence).to_contain("chrome_simple_web_layout_validation_status=pass")
        expect(evidence).to_contain("chrome_simple_web_layout_validation_reason=pass")
        expect(evidence).to_contain("chrome_simple_web_layout_mismatch_count=0")
        expect(evidence).to_contain("chrome_simple_web_layout_chrome_frame_us=1250")
        expect(evidence).to_contain("chrome_simple_web_layout_captured_argb_written=true")
        expect(evidence).to_contain("chrome_simple_web_layout_geometry_written=true")
        expect(evidence).to_contain("chrome_simple_web_layout_blur_or_tolerance_used=false")

    it "rejects proof without the live Chrome capture source marker":
        # @req: REQ-CHECK-ChroSimpWebLayProoVali-002
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-chrome-layout-validator-source"
        _prepare_dir(root, true)
        _write_proof(root + "/missing.json", [_kv("proof_source", "__OMIT__")])
        _write_proof(root + "/wrong.json", [_kv("proof_source", "\"tools/manual/chrome-proof.json\"")])
        val (missing, m_code) = _run_validator(root + "/missing.json")
        val (wrong, w_code) = _run_validator(root + "/wrong.json")
        expect(m_code).to_equal(1)  # oracle: validator exits 1 on the injected defect (fail-closed reject contract)
        expect(w_code).to_equal(1)  # oracle: validator exits 1 on the injected defect (fail-closed reject contract)

        step("Confirm Chrome proof must identify the live capture producer")
        expect(missing).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(missing).to_contain("chrome_simple_web_layout_validation_reason=unexpected-chrome-proof-source")
        expect(missing).to_contain("chrome_simple_web_layout_proof_source=")
        expect(wrong).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(wrong).to_contain("chrome_simple_web_layout_validation_reason=unexpected-chrome-proof-source")
        expect(wrong).to_contain("chrome_simple_web_layout_proof_source=tools/manual/chrome-proof.json")

    it "rejects proof when the live Chrome capture source artifact is missing or hardlinked":
        # @req: REQ-CHECK-ChroSimpWebLayProoVali-003
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-chrome-layout-validator-source-artifact"
        _prepare_dir(root, true)
        _write_proof(root + "/proof.json", [])
        val (missing, missing_code) = _run_validator_in_dir(root, "proof.json")
        expect(missing_code).to_equal(1)

        step("Confirm Chrome proof source marker fails closed when missing")
        expect(missing).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(missing).to_contain("chrome_simple_web_layout_validation_reason=unexpected-chrome-proof-source-file-missing")
        expect(missing).to_contain("chrome_simple_web_layout_proof_source=tools/chrome-live-bitmap/capture_html_argb.js")
        expect(missing).to_contain("chrome_simple_web_layout_proof_source_file_status=missing")
        expect(missing).to_contain("chrome_simple_web_layout_proof_source_size_bytes=")
        expect(missing).to_contain("chrome_simple_web_layout_proof_source_actual_size_bytes=")
        expect(missing).to_contain("chrome_simple_web_layout_proof_source_file_reason=missing")
        expect(missing).to_contain("chrome_simple_web_layout_proof_source_artifact_status=fail")

        expect(dir_create_all(root + "/hardlink/tools/chrome-live-bitmap")).to_equal(true)
        _write_defaults(root + "/hardlink")
        _write_proof(root + "/hardlink/proof.json", [])
        val capture_src = file_read("tools/chrome-live-bitmap/capture_html_argb.js")
        expect(file_write_exact(root + "/hardlink/original-capture.js", capture_src)).to_equal(true)
        expect(_create_hardlink(root + "/hardlink/original-capture.js", root + "/hardlink/tools/chrome-live-bitmap/capture_html_argb.js")).to_equal(0)
        val (hardlink, hardlink_code) = _run_validator_in_dir(root + "/hardlink", "proof.json")
        expect(hardlink_code).to_equal(1)

        step("Confirm Chrome proof source marker fails closed when hardlinked")
        expect(hardlink).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(hardlink).to_contain("chrome_simple_web_layout_validation_reason=unexpected-chrome-proof-source-file-hardlink")
        expect(hardlink).to_contain("chrome_simple_web_layout_proof_source=tools/chrome-live-bitmap/capture_html_argb.js")
        expect(hardlink).to_contain("chrome_simple_web_layout_proof_source_file_status=hardlink")
        expect(hardlink).to_contain("chrome_simple_web_layout_proof_source_file_reason=hardlink")
        expect(hardlink).to_contain("chrome_simple_web_layout_proof_source_artifact_status=fail")

    it "rejects substituted Chrome capture source artifacts":
        # @req: REQ-CHECK-ChroSimpWebLayProoVali-004
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-chrome-layout-validator-source-artifact-substituted"
        _prepare_dir(root, false)
        expect(dir_create_all(root + "/directory/tools/chrome-live-bitmap/capture_html_argb.js")).to_equal(true)
        expect(dir_create_all(root + "/markerless/tools/chrome-live-bitmap")).to_equal(true)
        expect(dir_create_all(root + "/hardlink/tools/chrome-live-bitmap")).to_equal(true)

        _write_defaults(root + "/directory")
        _write_proof(root + "/directory/proof.json", [])
        val (directory, directory_code) = _run_validator_in_dir(root + "/directory", "proof.json")
        expect(directory_code).to_equal(1)

        _write_defaults(root + "/markerless")
        _write_proof(root + "/markerless/proof.json", [])
        expect(file_write_exact(root + "/markerless/tools/chrome-live-bitmap/capture_html_argb.js", "module.exports = {{}};\n")).to_equal(true)
        val (markerless, markerless_code) = _run_validator_in_dir(root + "/markerless", "proof.json")
        expect(markerless_code).to_equal(1)

        step("Confirm non-regular and markerless Chrome proof source evidence is rejected")
        expect(directory).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(directory).to_contain("chrome_simple_web_layout_validation_reason=unexpected-chrome-proof-source-file-not-regular")
        expect(directory).to_contain("chrome_simple_web_layout_proof_source_file_status=not-regular")
        expect(directory).to_contain("chrome_simple_web_layout_proof_source_file_reason=not-regular")
        expect(directory).to_contain("chrome_simple_web_layout_proof_source_artifact_status=fail")
        expect(markerless).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(markerless).to_contain("chrome_simple_web_layout_validation_reason=unexpected-chrome-proof-source-file-marker-missing")
        expect(markerless).to_contain("chrome_simple_web_layout_proof_source_file_status=marker-missing")
        expect(markerless).to_contain("chrome_simple_web_layout_proof_source_file_reason=marker-missing")
        expect(markerless).to_contain("chrome_simple_web_layout_proof_source_artifact_status=fail")

        _write_defaults(root + "/hardlink")
        _write_proof(root + "/hardlink/proof.json", [])
        val capture_src = file_read("tools/chrome-live-bitmap/capture_html_argb.js")
        expect(file_write_exact(root + "/hardlink/original-capture.js", capture_src)).to_equal(true)
        expect(_create_hardlink(root + "/hardlink/original-capture.js", root + "/hardlink/tools/chrome-live-bitmap/capture_html_argb.js")).to_equal(0)
        val (hardlink, hardlink_code) = _run_validator_in_dir(root + "/hardlink", "proof.json")
        expect(hardlink_code).to_equal(1)

        expect(hardlink).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(hardlink).to_contain("chrome_simple_web_layout_validation_reason=unexpected-chrome-proof-source-file-hardlink")
        expect(hardlink).to_contain("chrome_simple_web_layout_proof_source_file_status=hardlink")
        expect(hardlink).to_contain("chrome_simple_web_layout_proof_source_file_reason=hardlink")
        expect(hardlink).to_contain("chrome_simple_web_layout_proof_source_artifact_status=fail")

    it "rejects proof without Chrome DevTools runtime evidence":
        # @req: REQ-CHECK-ChroSimpWebLayProoVali-005
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-chrome-layout-validator-runtime"
        _prepare_dir(root, true)
        _write_proof(root + "/mode.json", [_kv("capture_mode", "\"chrome-headless-screenshot\"")])
        _write_proof(root + "/ua.json", [_kv("chrome_user_agent", "\"Mozilla/5.0 Safari/537.36\"")])
        _write_proof(root + "/product.json", [_kv("chrome_product", "\"\"")])
        _write_proof(root + "/protocol.json", [_kv("chrome_protocol_version", "\"devtools\"")])
        _write_proof(root + "/missing-bin.json", [_kv("chrome_bin", "__OMIT__")])
        _write_proof(root + "/blank-bin.json", [_kv("chrome_bin", "\"   \"")])

        val (mode, c1) = _run_validator(root + "/mode.json")
        val (ua, c2) = _run_validator(root + "/ua.json")
        val (product, c3) = _run_validator(root + "/product.json")
        val (protocol, c4) = _run_validator(root + "/protocol.json")
        val (missing_bin, c5) = _run_validator(root + "/missing-bin.json")
        val (blank_bin, c6) = _run_validator(root + "/blank-bin.json")
        expect(c1).to_equal(1)
        expect(c2).to_equal(1)
        expect(c3).to_equal(1)
        expect(c4).to_equal(1)
        expect(c5).to_equal(1)
        expect(c6).to_equal(1)

        step("Confirm Chrome proof needs DevTools capture mode and runtime user agent")
        expect(mode).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(mode).to_contain("chrome_simple_web_layout_validation_reason=unexpected-chrome-capture-mode")
        expect(mode).to_contain("chrome_simple_web_layout_capture_mode=chrome-headless-screenshot")
        expect(ua).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(ua).to_contain("chrome_simple_web_layout_validation_reason=missing-chrome-runtime-user-agent")
        expect(ua).to_contain("chrome_simple_web_layout_capture_mode=chrome-devtools-screenshot")
        expect(ua).to_contain("chrome_simple_web_layout_chrome_user_agent=Mozilla/5.0 Safari/537.36")
        expect(product).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(product).to_contain("chrome_simple_web_layout_validation_reason=missing-chrome-product-version")
        expect(product).to_contain("chrome_simple_web_layout_chrome_product=")
        expect(protocol).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(protocol).to_contain("chrome_simple_web_layout_validation_reason=missing-chrome-protocol-version")
        expect(protocol).to_contain("chrome_simple_web_layout_chrome_protocol_version=devtools")
        expect(missing_bin).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(missing_bin).to_contain("chrome_simple_web_layout_validation_reason=missing-chrome-bin")
        expect(missing_bin).to_contain("chrome_simple_web_layout_chrome_bin=")
        expect(blank_bin).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(blank_bin).to_contain("chrome_simple_web_layout_validation_reason=missing-chrome-bin")
        expect(blank_bin).to_contain("chrome_simple_web_layout_chrome_bin=   ")

    it "compares large Chrome checksum proof values exactly":
        # @req: REQ-CHECK-ChroSimpWebLayProoVali-006
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-chrome-layout-validator-large-integers"
        _prepare_dir(root, true)
        _write_proof(root + "/pass.json", [])
        _write_proof(root + "/fail.json", [_kv("weighted_checksum", "\"81077987413324799\"")])
        val (pass_evidence, p_code) = _run_validator(root + "/pass.json")
        val (fail_evidence, f_code) = _run_validator(root + "/fail.json")
        expect(p_code).to_equal(0)
        expect(f_code).to_equal(1)

        step("Inspect exact decimal checksum rows")
        expect(pass_evidence).to_contain("chrome_simple_web_layout_validation_status=pass")
        expect(pass_evidence).to_contain("chrome_simple_web_layout_simple_checksum=26388279060480")
        expect(pass_evidence).to_contain("chrome_simple_web_layout_chrome_weighted_checksum=81077987413324800")
        expect(pass_evidence).to_contain("chrome_simple_web_layout_captured_argb_weighted_checksum=81077987413324800")
        expect(fail_evidence).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(fail_evidence).to_contain("chrome_simple_web_layout_validation_reason=weighted-checksum-mismatch")
        expect(fail_evidence).to_contain("chrome_simple_web_layout_chrome_weighted_checksum=81077987413324799")

    it "rejects checksum rows that do not match captured Chrome ARGB":
        # @req: REQ-CHECK-ChroSimpWebLayProoVali-007
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-chrome-layout-validator-artifact-checksum"
        _prepare_dir(root, true)
        _write_proof(root + "/checksum.json", [_kv("checksum", "\"100\""), _kv("expected_checksum", "\"100\"")])
        _write_proof(root + "/weighted.json", [_kv("weighted_checksum", "\"500\""), _kv("expected_weighted_checksum", "\"500\"")])
        val (checksum, c1) = _run_validator(root + "/checksum.json")
        val (weighted, c2) = _run_validator(root + "/weighted.json")
        expect(c1).to_equal(1)
        expect(c2).to_equal(1)

        step("Confirm internally matching proof checksums must still match captured ARGB")
        expect(checksum).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(checksum).to_contain("chrome_simple_web_layout_validation_reason=captured-argb-checksum-mismatch")
        expect(checksum).to_contain("chrome_simple_web_layout_chrome_checksum=100")
        expect(checksum).to_contain("chrome_simple_web_layout_captured_argb_checksum=26388279060480")
        expect(weighted).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(weighted).to_contain("chrome_simple_web_layout_validation_reason=captured-argb-weighted-checksum-mismatch")
        expect(weighted).to_contain("chrome_simple_web_layout_chrome_weighted_checksum=500")
        expect(weighted).to_contain("chrome_simple_web_layout_captured_argb_weighted_checksum=81077987413324800")

    it "rejects malformed Chrome frame timing":
        # @req: REQ-CHECK-ChroSimpWebLayProoVali-008
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        step("Verify: rejects malformed Chrome frame timing")
        val root = "build/test-chrome-layout-validator-bad-frame"
        _prepare_dir(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, [_kv("frame_us", "\"not-a-number\"")])
        val (evidence, code) = _run_validator(proof_path)
        expect(code).to_equal(1)  # oracle: validator exits 1 on the injected defect (fail-closed reject contract)

        expect(evidence).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(evidence).to_contain("chrome_simple_web_layout_validation_reason=missing-chrome-timing")
        expect(evidence).to_contain("chrome_simple_web_layout_chrome_frame_us=")
        expect_not(evidence.contains("chrome_simple_web_layout_chrome_frame_us=not-a-number"))

    it "rejects implausibly high Chrome frame timing":
        # @req: REQ-CHECK-ChroSimpWebLayProoVali-009
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        step("Verify: rejects implausibly high Chrome frame timing")
        val root = "build/test-chrome-layout-validator-slow-frame"
        _prepare_dir(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, [_kv("frame_us", "60000001")])
        val (evidence, code) = _run_validator(proof_path)
        expect(code).to_equal(1)  # oracle: validator exits 1 on the injected defect (fail-closed reject contract)

        expect(evidence).to_contain("chrome_simple_web_layout_validation_status=fail")
        expect(evidence).to_contain("chrome_simple_web_layout_validation_reason=missing-chrome-timing")
        expect(evidence).to_contain("chrome_simple_web_layout_chrome_frame_us=60000001")

    it "rejects missing capture and geometry proof rows":
        # @req: REQ-CHECK-ChroSimpWebLayProoVali-010
