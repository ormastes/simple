    it "rejects stringified live layout viewport provenance and timing proof rows":
        # @capture(protocol_json): evidence rows for stringified numeric proof rejections
        val root = "build/test-electron-layout-validator-string-numeric-proof"
        _prepare_dir(root, true)
        _write_proof(root + "/requested.json", [_kv("width", "\"96\"")])
        _write_proof(root + "/argb.json", [_kv("captured_argb_path", "\"argb_str.json\"")])
