        expect(string_pixels).to_contain("electron_simple_web_layout_validation_reason=captured-argb-pixel-type-mismatch")
        expect(fractional_pixels).to_contain("electron_simple_web_layout_validation_reason=captured-argb-pixel-type-mismatch")
        expect(range_pixels).to_contain("electron_simple_web_layout_validation_reason=captured-argb-pixel-type-mismatch")
        expect(blank).to_contain("electron_simple_web_layout_validation_reason=blank-captured-argb")
        expect(blank).to_contain("electron_simple_web_layout_captured_argb_nonzero_pixel_count=0")

    it "rejects missing, malformed, mismatched, and unmeasured Electron geometry":
        # @capture(protocol_json): evidence rows for the six malformed-geometry rejection classes
        val root = "build/test-electron-layout-validator-geometry"
        _prepare_dir(root, true)
        _write_proof(root + "/missing.json", [_kv("geometry_path", "\"missing.json\"")])
        _write_proof(root + "/empty.json", [_kv("geometry_path", "\"empty_geom.json\"")])
        expect(file_write_exact(root + "/empty_geom.json", "")).to_equal(true)
        _write_proof(root + "/malformed.json", [_kv("geometry_path", "\"malformed_geom.json\"")])
        expect(file_write_exact(root + "/malformed_geom.json", _geometry_json("96", 64, "manual", "[{{\"x\":0,\"y\":0,\"width\":96,\"height\":64}}]"))).to_equal(true)
        _write_proof(root + "/viewport.json", [_kv("geometry_path", "\"viewport_geom.json\"")])
        expect(file_write_exact(root + "/viewport_geom.json", _geometry_json("95", 64, "electron-offscreen-geometry", "[{{\"x\":0,\"y\":0,\"width\":95,\"height\":64}}]"))).to_equal(true)
        _write_proof(root + "/items.json", [_kv("geometry_path", "\"items_geom.json\"")])
        expect(file_write_exact(root + "/items_geom.json", _geometry_json("96", 64, "electron-offscreen-geometry", "[]"))).to_equal(true)
        _write_proof(root + "/measured.json", [_kv("geometry_path", "\"measured_geom.json\"")])
        expect(file_write_exact(root + "/measured_geom.json", _geometry_json("96", 64, "electron-offscreen-geometry", "[{{\"label\":\"placeholder\"}},{{\"x\":120,\"y\":80,\"width\":10,\"height\":10}}]"))).to_equal(true)

        val res = _run_validator_many([
            root + "/missing.json",
            root + "/empty.json",
            root + "/malformed.json",
            root + "/viewport.json",
            root + "/items.json",
            root + "/measured.json"
        ])
        val (missing, c1) = res[0]
        val (empty, c2) = res[1]
        val (malformed, c3) = res[2]
        val (viewport, c4) = res[3]
        val (items, c5) = res[4]
        val (measured, c6) = res[5]
        expect(c1).to_equal(1)
        expect(c2).to_equal(1)
        expect(c3).to_equal(1)
        expect(c4).to_equal(1)
        expect(c5).to_equal(1)
        expect(c6).to_equal(1)

        step("Confirm Electron geometry must be a measured offscreen DOM artifact")
        expect(missing).to_contain("electron_simple_web_layout_validation_reason=missing-electron-geometry-file")
        expect(missing).to_contain("electron_simple_web_layout_geometry_file_status=missing")
        expect(missing).to_contain("electron_simple_web_layout_geometry_file_reason=missing")
        expect(missing).to_contain("electron_simple_web_layout_geometry_artifact_status=fail")
        expect(empty).to_contain("electron_simple_web_layout_validation_reason=empty-electron-geometry-file")
        expect(empty).to_contain("electron_simple_web_layout_geometry_file_status=empty")
        expect(empty).to_contain("electron_simple_web_layout_geometry_file_reason=empty")
        expect(empty).to_contain("electron_simple_web_layout_geometry_artifact_status=fail")
        expect(malformed).to_contain("electron_simple_web_layout_validation_reason=malformed-electron-geometry")
        expect(viewport).to_contain("electron_simple_web_layout_validation_reason=electron-geometry-viewport-mismatch")
        expect(viewport).to_contain("electron_simple_web_layout_geometry_viewport_width=95")
        expect(items).to_contain("electron_simple_web_layout_validation_reason=missing-electron-geometry-items")
        expect(items).to_contain("electron_simple_web_layout_geometry_item_count=0")
        expect(measured).to_contain("electron_simple_web_layout_validation_reason=missing-electron-geometry-measured-items")
        expect(measured).to_contain("electron_simple_web_layout_geometry_item_count=2")
        expect(measured).to_contain("electron_simple_web_layout_geometry_measured_item_count=0")

    it "rejects missing requested viewport and native capture viewport mismatch":
        # @capture(protocol_json): evidence rows for missing-width and viewport-mismatch rejections
