        expect(file_copy("build/.tmp_electron_layout_cap_frac.json", root + "/fractional_cap.json")).to_equal(true)
        _write_proof(root + "/range-pixels.json", [_kv("captured_argb_path", "\"range_cap.json\"")])
        expect(file_copy("build/.tmp_electron_layout_cap_range.json", root + "/range_cap.json")).to_equal(true)
        _write_proof(root + "/blank.json", [_kv("captured_argb_path", "\"blank_cap.json\"")])
        expect(file_copy("build/.tmp_electron_layout_cap_blank.json", root + "/blank_cap.json")).to_equal(true)

        val res = _run_validator_many([
            root + "/malformed.json",
            root + "/viewport.json",
            root + "/pixels.json",
            root + "/string-pixels.json",
            root + "/fractional-pixels.json",
