        _write_proof(root + "/downsampled.json", [_kv("capture_downsampled", "\"false\"")])
        _write_proof(root + "/geometry_proof.json", [_kv("geometry_written", "\"true\"")])
        _write_proof(root + "/blur.json", [_kv("blur_or_tolerance_used", "\"false\"")])

        val res = _run_validator_many([root + "/capture.json", root + "/downsampled.json", root + "/geometry_proof.json", root + "/blur.json"])
        val (capture, c1) = res[0]
