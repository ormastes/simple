    it "catches a corrupted GUI pixel artifact and passes after the pixel is restored":
        # @capture(protocol_json): evidence rows for the corrupt-then-repaired pixel artifact cycle
        val root = "build/test-electron-layout-validator-corrupt-then-fix"
        _prepare_dir(root, true)
        _write_proof(root + "/bug.json", [_kv("captured_argb_path", "\"bug_cap.json\"")])
        expect(file_copy("build/.tmp_electron_layout_cap_corr.json", root + "/bug_cap.json")).to_equal(true)
        _write_proof(root + "/fixed.json", [])

        val res = _run_validator_many([root + "/bug.json", root + "/fixed.json"])
        val (bug, c1) = res[0]
