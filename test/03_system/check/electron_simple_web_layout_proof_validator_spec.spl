        _write_proof(root + "/timing.json", [_kv("frame_us", "\"1250\"")])

        val res = _run_validator_many([root + "/requested.json", root + "/argb.json", root + "/native.json", root + "/timing.json"])
        val (requested, c1) = res[0]
