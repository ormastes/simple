# @cover scripts/check/check-electron-simple-web-layout-bitmap-evidence.shs 80%
# @req: REQ-CHECK-001
"""
## Purpose and audience
Purpose: accepts complete Electron layout timing capture and exact checksum proof
Audience: compiler and tooling engineers who maintain this spec

# Electron Simple Web layout proof validator

## Overview

Validates the Electron Simple Web layout proof validator. The layout wrapper
captures Chromium pixels for Simple Web layout scenes, writes
`electron-proof.json`, and consumes normalized validator rows before claiming
pass or divergent layout evidence.

**Plan:** doc/03_plan/ui/tui/production_gui_web_renderer_parity_hardening.md
**Requirements:** N/A
**Research:** N/A
**Design:** doc/07_guide/tooling/renderdoc_capture_infra.md

## Syntax

```sh
SIMPLE_LIB=src bin/simple test test/03_system/check/electron_simple_web_layout_proof_validator_spec.spl --mode=interpreter --clean --fail-fast
```

## Acceptance

- Complete Electron layout proof JSON validates and emits normalized
  `electron_simple_web_layout_*` rows.
- Large integer checksum values compare exactly, without JavaScript number
  rounding.
- Checksum proof rows must match the recomputed captured ARGB artifact
  checksum, not only each other.
- Malformed `frame_us`, malformed mismatch counts, blur/tolerance use, missing
  ARGB capture, missing capture provenance, missing viewport proof, and capture
  viewport mismatches are rejected.
- Implausibly high `frame_us` values fail closed instead of counting as valid
  Electron layout timing proof.
- ARGB capture proof paths must resolve to nonempty files instead of relying
  on `captured_argb_written=true` alone.
- ARGB capture file-status rows distinguish `missing`, `empty`, and `pass` so
  diagnostics cannot treat a zero-byte artifact as a valid capture file.
- ARGB capture proof paths must not resolve back to the top-level proof JSON
  even if the proof contains artifact-shaped fields.
- Captured ARGB files must parse as `argb-u32` Electron live-capture artifacts,
  match the proof viewport, include the expected pixel count, and contain
  nonzero pixels with numeric uint32 JSON pixel values.
- Electron geometry proof must parse as offscreen Electron geometry, match the
  proof viewport, and include at least one measured layout item with numeric
  bounds intersecting the captured viewport.
- Requested viewport, native capture provenance, ARGB readback dimensions,
  mismatch counts, and frame timing values must be real JSON numbers, not
  stringified rows, and malformed live numeric rows must not be re-emitted as
  normalized numeric evidence.
- Capture provenance, geometry-written, ARGB-written, and blur/tolerance proof
  rows must be real JSON booleans; string booleans are rejected and not
  re-emitted as normalized boolean evidence.
- The live Electron layout wrapper must print validator env rows before
  deriving wrapper status, preserving exact failure diagnostics in check output.
- Proof renderer must be the live Electron capture page, the proof must carry
  the live Electron capture source marker, and scenes must stay within the
  Simple Web layout scene family.
- The Electron capture source marker must resolve to a single-link regular
  nonempty producer source file with expected offscreen capture markers so
  stale JSON cannot be paired with a missing, substituted, or aliased capture
  script.
- The Electron capture producer source proof must emit both the expected
  `lstat` size and actual bytes read from the producer, and fail closed when
  those sizes diverge.
- Complete proofs must identify the Electron offscreen capture backend,
  compositor mode, Electron/Chromium runtime identity, Chromium GPU
  feature-status diagnostics, and at least two measured capture iterations.
- The proof JSON, captured ARGB artifact, and geometry artifact must be single
  regular files, not symlinks or hardlinks to mutable or substituted evidence.
- The live Electron layout wrapper consumes the validator and still maps real
  pixel mismatches to `divergent` evidence.

## Operator workflow

Run the spec with the command in the Syntax section. Each scenario builds a
fixture proof JSON plus ARGB/geometry artifacts via `_proof_command`, invokes
`node scripts/check/validate-electron-simple-web-layout-proof.js` or the live
wrapper, and asserts on the normalized `electron_simple_web_layout_*` rows.

## Compatibility and limitations

Requires `node` on PATH and write access to `build/`. The wrapper scenarios
never launch Electron; capture and geometry are fixture artifacts. Timing
budgets are pinned by the validator's fps-floor rule, not by wall-clock
measurement.

## Verification guidance and troubleshooting

A failed `rejects...` scenario means forged or malformed layout proof was
accepted — read the retained evidence row named in the assertion for the
`validation_reason` and file a product defect; never soften the assertion. A
failed `accepts...` or `catches...then passes` scenario means a valid fixture
was rejected: compare the retained rows against the fixture fields.
"""

# Lifecycle: doc/01_research/domain/chromium_web_renderer_primitive_differential.md ;
# doc/03_plan/ui/tui/production_gui_web_renderer_parity_hardening.md ;
# doc/04_architecture/chromium_web_renderer_primitive_differential.md ;
# doc/05_design/browser_wasm_webgpu_infra.md

# @tag: system, gui, electron, renderer, layout, capture, performance

use std.io_runtime.{dir_create_all, dir_remove_all, file_copy, file_delete, file_exists, file_read, file_write_exact, process_run}
use std.spec.*

struct KV:
    key: text
    value: text

fn _kv(key: text, value: text) -> KV:
    KV(key: key, value: value)

fn _repeat_csv(elem: text, count: i64) -> text:
    if count <= 0:
        return ""
    var result = ""
    var block = elem
    var remaining = count
    while remaining > 0:
        if remaining % 2 == 1:
            if result == "":
                result = block
            else:
                result = result + "," + block
        remaining = remaining / 2
        if remaining > 0:
            block = block + "," + block
    result

fn _argb_json_pixels(width_json: text, height: i64, format_str: text, producer: text, pixels_csv: text) -> text:
    "{{\"width\":" + width_json + ",\"height\":" + height.to_string() + ",\"format\":\"" + format_str + "\",\"producer\":\"" + producer + "\",\"pixels\":[" + pixels_csv + "]}}"

fn _argb_json(width_json: text, height: i64, format_str: text, producer: text, pixel_val: text, pixel_count: i64) -> text:
    _argb_json_pixels(width_json, height, format_str, producer, _repeat_csv(pixel_val, pixel_count))

fn _geometry_json(width_json: text, height: i64, producer: text, items_json: text) -> text:
    "{{\"producer\":\"" + producer + "\",\"viewport\":{{\"width\":" + width_json + ",\"height\":" + height.to_string() + "}},\"items\":" + items_json + "}}"

fn _ensure_templates():
    val tmpl_argb = "build/.tmp_electron_layout_default_argb.json"
    val tmpl_geom = "build/.tmp_electron_layout_default_geom.json"
    val tmpl_wt = "build/.tmp_electron_layout_cap_wt.json"
    if not file_exists(tmpl_argb) or not file_exists(tmpl_geom) or not file_exists(tmpl_wt):
        expect(dir_create_all("build")).to_equal(true)
        val gen_js_clean = "const fs=require('fs');const w=(p,o)=>fs.writeFileSync(p,JSON.stringify(o));const fill=(v,n)=>Array(n).fill(v);const mk=(wd,px)=>(__LB__width:wd,height:64,format:'argb-u32',producer:'electron-live-capture-page',pixels:px__RB__);w('build/.tmp_electron_layout_default_argb.json',mk(96,fill(4294967295,96*64)));w('build/.tmp_electron_layout_default_geom.json',__LB__producer:'electron-offscreen-geometry',viewport:__LB__width:96,height:64__RB__,items:[__LB__label:'root',tag:'div',x:0,y:0,width:96,height:64__RB__]__RB__);w('build/.tmp_electron_layout_cap_w95.json',mk(95,fill(4294967295,95*64)));w('build/.tmp_electron_layout_cap_strp.json',mk(96,fill('4294967295',96*64)));w('build/.tmp_electron_layout_cap_frac.json',mk(96,fill(1.5,96*64)));w('build/.tmp_electron_layout_cap_range.json',mk(96,fill(4294967296,96*64)));w('build/.tmp_electron_layout_cap_blank.json',mk(96,fill(0,96*64)));w('build/.tmp_electron_layout_cap_wstr.json',mk('96',fill(4294967295,96*64)));const cp=fill(4294967295,96*64);cp[0]=4294967294;w('build/.tmp_electron_layout_cap_corr.json',mk(96,cp));const wp=fill(1,96*64);wp[0]=2;wp[1]=0;w('build/.tmp_electron_layout_cap_wt.json',mk(96,wp));".replace("__LB__", "{{").replace("__RB__", "}}")
        val (_out, _err, code) = process_run("node", ["-e", gen_js_clean])
        expect(code).to_equal(0)

fn _write_defaults(dir: text):
    _ensure_templates()
    expect(file_copy("build/.tmp_electron_layout_default_argb.json", dir + "/captured.json")).to_equal(true)
    expect(file_copy("build/.tmp_electron_layout_default_geom.json", dir + "/geometry.json")).to_equal(true)

fn _prepare_dir(root: text, with_artifacts: bool):
    val _removed = dir_remove_all(root)
    expect(dir_create_all(root)).to_equal(true)
    if with_artifacts:
        _write_defaults(root)

fn _find_override(overrides: [KV], key: text) -> text:
    for item in overrides:
        if item.key == key:
            return item.value
    "__DEFAULT__"

fn _default_proof_text() -> text:
    "{{\"renderer\":\"electron-live-capture-page\",\"proof_source\":\"tools/electron-live-bitmap/exact_fixture.js\",\"capture_backend\":\"electron-offscreen-capture-page\",\"compositor_mode\":\"offscreen-osr-exact-srgb\",\"browser_engine\":\"chromium\",\"electron_user_agent\":\"Mozilla/5.0 Chrome/142.0.0.0 Electron/42.5.0 Safari/537.36\",\"electron_process_version\":\"42.5.0\",\"chrome_process_version\":\"142.0.0.0\",\"gpu_feature_status\":{{\"gpu_compositing\":\"disabled_software\",\"rasterization\":\"disabled_software\"}},\"gpu_compositing\":\"disabled_software\",\"gpu_rasterization\":\"disabled_software\",\"scene\":\"simple-web-layout-text-flow\",\"width\":96,\"height\":64,\"iterations\":3,\"checksum\":\"26388279060480\",\"expected_checksum\":\"26388279060480\",\"weighted_checksum\":\"81077987413324800\",\"expected_weighted_checksum\":\"81077987413324800\",\"mismatch_count\":0,\"frame_us\":1250,\"capture_native_width\":96,\"capture_native_height\":64,\"capture_downsampled\":false,\"captured_argb_path\":\"captured.json\",\"captured_argb_written\":true,\"geometry_path\":\"geometry.json\",\"geometry_written\":true,\"blur_or_tolerance_used\":false}}"

fn _text_in(xs: [text], target: text) -> bool:
    for x in xs:
        if x == target:
            return true
    false

fn _write_proof(proof_path: text, overrides: [KV]):
    val tmpl_proof = "build/.tmp_electron_layout_default_proof.json"
    if not file_exists(tmpl_proof):
        expect(dir_create_all("build")).to_equal(true)
        expect(file_write_exact(tmpl_proof, _default_proof_text())).to_equal(true)
    val n_ov = overrides.len()
    if n_ov == 0:
        expect(file_copy(tmpl_proof, proof_path)).to_equal(true)
        return
    val defaults = [
        "renderer", "\"electron-live-capture-page\"",
        "proof_source", "\"tools/electron-live-bitmap/exact_fixture.js\"",
        "capture_backend", "\"electron-offscreen-capture-page\"",
        "compositor_mode", "\"offscreen-osr-exact-srgb\"",
        "browser_engine", "\"chromium\"",
        "electron_user_agent", "\"Mozilla/5.0 Chrome/142.0.0.0 Electron/42.5.0 Safari/537.36\"",
        "electron_process_version", "\"42.5.0\"",
        "chrome_process_version", "\"142.0.0.0\"",
        "gpu_feature_status", "{{\"gpu_compositing\":\"disabled_software\",\"rasterization\":\"disabled_software\"}}",
        "gpu_compositing", "\"disabled_software\"",
        "gpu_rasterization", "\"disabled_software\"",
        "scene", "\"simple-web-layout-text-flow\"",
        "width", "96",
        "height", "64",
        "iterations", "3",
        "checksum", "\"26388279060480\"",
        "expected_checksum", "\"26388279060480\"",
        "weighted_checksum", "\"81077987413324800\"",
        "expected_weighted_checksum", "\"81077987413324800\"",
        "mismatch_count", "0",
        "frame_us", "1250",
        "capture_native_width", "96",
        "capture_native_height", "64",
        "capture_downsampled", "false",
        "captured_argb_path", "\"captured.json\"",
        "captured_argb_written", "true",
        "geometry_path", "\"geometry.json\"",
        "geometry_written", "true",
        "blur_or_tolerance_used", "false"
    ]
    var parts: [text] = []
    var seen_ov: [text] = []
    val n_def = defaults.len()
    var i = 0
    if n_ov == 1:
        val k0 = overrides[0].key
        val v0 = overrides[0].value
        while i < n_def:
            val dk = defaults[i]
            if dk == k0:
                seen_ov.push(dk)
                if v0 != "__OMIT__":
                    parts.push("\"" + dk + "\":" + v0)
            else:
                parts.push("\"" + dk + "\":" + defaults[i + 1])
            i = i + 2
    else:
        while i < n_def:
            val dk = defaults[i]
            val ov = _find_override(overrides, dk)
            if ov != "__DEFAULT__":
                seen_ov.push(dk)
            if ov != "__OMIT__":
                val value = if ov == "__DEFAULT__": defaults[i + 1] else: ov
                parts.push("\"" + dk + "\":" + value)
            i = i + 2
    for extra in overrides:
        if extra.value != "__OMIT__" and not _text_in(seen_ov, extra.key):
            parts.push("\"" + extra.key + "\":" + extra.value)
    expect(file_write_exact(proof_path, "{{" + parts.join(",") + "}}")).to_equal(true)

fn _ensure_batch_runner() -> text:
    val runner = "build/.tmp_val_batch_runner.js"
    if not file_exists(runner):
        expect(dir_create_all("build")).to_equal(true)
        val raw = "const fs=require('fs'),path=require('path'),Module=require('module');const script=path.resolve(process.argv[2]);const origCwd=process.cwd();const src=fs.readFileSync(script,'utf8').replace(/^#![^\\n]*\\n/,'');const fn=new Function('require','process','console','__filename','__dirname',src);const req=Module.createRequire(script);const results=[];for(const raw of process.argv.slice(3))__LB__ const parts=raw.split('@@SEP@@');const workDir=parts[0];const envSpec=parts[1];const args=parts.slice(2);let out='';let code=0;const fakeEnv=Object.assign(__LB____RB__,process.env);if(envSpec)for(const kv of envSpec.split(';'))__LB__ const eq=kv.indexOf('=');if(eq>0)__LB__ const k=kv.slice(0,eq),v=kv.slice(eq+1);if(v)fakeEnv[k]=v;else delete fakeEnv[k];__RB__ __RB__;const fakeProc=Object.create(process);fakeProc.env=fakeEnv;fakeProc.argv=[process.execPath,script,...args];fakeProc.exit=(c=0)=>__LB__ code=c;throw __LB____exit:true__RB__;__RB__;const fakeCon=__LB__ log:(...a)=>__LB__ out+=a.map(String).join(' ')+'\\n';__RB__,error:()=>__LB____RB__ __RB__;try__LB__ if(workDir)process.chdir(workDir);fn(req,fakeProc,fakeCon,script,path.dirname(script));__RB__ catch(e)__LB__ if(!e||!e.__exit)code=1;__RB__ finally__LB__ if(workDir)process.chdir(origCwd);__RB__;results.push(String(code)+'<<<CODE_END>>>'+out);__RB__;process.stdout.write(results.join('<<<BATCH_SEP>>>'));"
        val js = raw.replace("__LB__", "{{").replace("__RB__", "}}")
        expect(file_write_exact(runner, js)).to_equal(true)
    runner

fn _run_validator_many(proof_paths: [text]) -> [(text, i64)]:
    val runner = _ensure_batch_runner()
    var cmd_args = [runner, "scripts/check/validate-electron-simple-web-layout-proof.js"]
    for p in proof_paths:
        cmd_args.push("@@SEP@@@@SEP@@" + p)
    val (stdout, _stderr, _code) = process_run("node", cmd_args)
    var out: [(text, i64)] = []
    for chunk in stdout.split("<<<BATCH_SEP>>>"):
        val pair = chunk.split("<<<CODE_END>>>")
        val c = if pair[0].trim() == "0": 0 else: 1
        val body = if pair.len() > 1: pair[1] else: ""
        out.push((body, c))
    out

fn _run_validator(proof_path: text) -> (text, i64):
    val (stdout, _stderr, code) = process_run("node", ["scripts/check/validate-electron-simple-web-layout-proof.js", proof_path])
    (stdout, code)

fn _run_validator_in_dir(work_dir: text, proof_name: text) -> (text, i64):
    val js = "const path=require('path');const s=path.resolve(process.argv[2]);process.chdir(process.argv[1]);process.argv=[process.argv[0],s,process.argv[3]];require(s)"
    val (stdout, _stderr, code) = process_run("node", ["-e", js, work_dir, "scripts/check/validate-electron-simple-web-layout-proof.js", proof_name])
    (stdout, code)

fn _create_symlink(target: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').symlinkSync(process.argv[1], process.argv[2])", target, link_path])
    code

fn _create_hardlink(existing_path: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').linkSync(process.argv[1], process.argv[2])", existing_path, link_path])
    code

# @manual_section: Electron Simple Web layout proof validation

describe "Electron Simple Web layout proof validator":

    it "accepts complete Electron layout timing capture and exact checksum proof":
        # @req: REQ-CHECK-001
        # @capture(protocol_json): evidence rows for the accepted full layout proof fixture
        step("Verify: accepts complete Electron layout timing capture and exact checksum proof")
        # @req: REQ-CHECK-ElecSimpWebLayoProoVali-001
        val root = "build/test-electron-layout-validator-pass"
        _prepare_dir(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, [])
        val (evidence, code) = _run_validator(proof_path)
        expect(code).to_equal(0)  # oracle: harness exit 0 proves the wrapper ran; the verdict is asserted from the evidence rows

        step("Inspect normalized Electron layout proof rows")
        expect(evidence).to_contain("electron_simple_web_layout_validation_status=pass")
        expect(evidence).to_contain("electron_simple_web_layout_validation_reason=pass")
        expect(evidence).to_contain("electron_simple_web_layout_proof_symlink_status=pass")
        expect(evidence).to_contain("electron_simple_web_layout_proof_hardlink_status=pass")
        expect(evidence).to_contain("electron_simple_web_layout_renderer=electron-live-capture-page")
        expect(evidence).to_contain("electron_simple_web_layout_proof_source=tools/electron-live-bitmap/exact_fixture.js")
        expect(evidence).to_contain("electron_simple_web_layout_proof_source_file_status=pass")
        expect(evidence).to_contain("electron_simple_web_layout_proof_source_size_bytes=")
        expect(evidence).to_contain("electron_simple_web_layout_proof_source_actual_size_bytes=")
        expect(evidence).to_contain("electron_simple_web_layout_proof_source_file_reason=pass")
        expect(evidence).to_contain("electron_simple_web_layout_proof_source_artifact_status=pass")
        expect(evidence).to_contain("electron_simple_web_layout_capture_backend=electron-offscreen-capture-page")
        expect(evidence).to_contain("electron_simple_web_layout_compositor_mode=offscreen-osr-exact-srgb")
        expect(evidence).to_contain("electron_simple_web_layout_browser_engine=chromium")
        expect(evidence).to_contain("electron_simple_web_layout_electron_user_agent=Mozilla/5.0 Chrome/142.0.0.0 Electron/42.5.0 Safari/537.36")
        expect(evidence).to_contain("electron_simple_web_layout_electron_process_version=42.5.0")
        expect(evidence).to_contain("electron_simple_web_layout_chrome_process_version=142.0.0.0")
