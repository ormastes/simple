# @req: REQ-CHECK-STAGE4-MEMORY-001


# @cover src/app/memstat/main.spl 60%
# @req REQ-STAGE4-MEMORY-GATE-001
"""
# Stage-4 Memory Gate Sampler

**Feature IDs:** #stage4-memory-gate
**Category:** Infrastructure
**Status:** In Progress
**Requirements:** doc/03_plan/compiler/bootstrap/stage4_memory_parallel_agent_plan_2026-07-29.md (lane L5)
**Design:** doc/01_research/compiler/bootstrap/stage4_memory_ownership_research_2026-07-29.md

## Overview

Operators attach the out-of-process `memstat` sampler (src/app/memstat) to a
running PID to record an OS-truth memory profile: /proc/<pid>/smaps_rollup
(Rss, Pss, Pss_Anon, Private_Dirty, Swap) plus /proc/<pid>/stat fault
counters, one CSV row per interval. `scripts/check/check-stage4-memory-gate.shs`
wraps the same sampler around a fixed workload and gates on peak RSS. This
spec proves the sampler contract on a short-lived target: the CSV exists,
carries the fixed header plus at least one data row, the RSS column parses as
a positive integer, and a missing-argument invocation fails with usage help.

## Key Concepts

| Concept | Description |
|---------|-------------|
| smaps_rollup | Kernel-aggregated per-process memory truth (kB values) |
| memstat | Pure-Simple sampler app; exits cleanly when the target PID dies |
| RSS gate | check-stage4-memory-gate.shs fails when peak rss_kb exceeds STAGE4_MEM_GATE_RSS_KB |

## Related Specifications

- doc/03_plan/compiler/bootstrap/stage4_memory_parallel_agent_plan_2026-07-29.md — lane map
"""

use std.spec.*
use std.io_runtime.{file_read, file_exists, process_run, dir_create_all, env_get}

val ARTIFACT_DIR = "build/test-artifacts/stage4_memory_gate"
val CSV_PATH = "build/test-artifacts/stage4_memory_gate/memstat.csv"
val CSV_HEADER = "timestamp_us,rss_kb,pss_kb,pss_anon_kb,private_dirty_kb,swap_kb,minflt,majflt"

# Decimal parser over short tokens; avoids `parse_int() ?? -1` (the `??`
# nil-sentinel-is-3 landmine on raw i64). Returns -1 when no digits found.
fn parse_dec(s: text) -> i64:
    var i = 0
    var n = 0
    var found = false
    val len = s.len()
    while i < len:
        val c = s.char_code_at(i)
        if c >= 48 and c <= 57:
            found = true
            n = n * 10 + (c - 48)
        elif found:
            return n
        i = i + 1
    if found:
        return n
    -1

fn non_empty_lines(content: text) -> [text]:
    var out: [text] = []
    for line in content.split("\n"):
        if line.trim().len() > 0:
            out = out.push(line)
    out

# @step: Start a short-lived background target process
fn start_short_lived_target(seconds: text) -> text:
    val (out, _err, code) = process_run("/bin/sh", ["-c", "sleep {seconds} >/dev/null 2>&1 & echo $!"])
    if code != 0:
        return ""
    out.trim()

# @step: Sample the target with memstat until it exits
fn sample_with_memstat(pid: text, csv: text) -> i64:
    val (_out, _err, code) = process_run("bin/simple", ["run", "src/app/memstat/main.spl", pid, csv, "300"])
    code

# Mirrors the SIMPLE_TEST_BINARY override convention used by the sibling
# mem_attr_report_spec.spl: defaults to the deployed bin/simple, but honors
# an explicit override so this spec can be re-run against a specific seed.
fn contract_binary() -> text:
    val override = env_get("SIMPLE_TEST_BINARY")
    if override != "" and override != nil:
        return override
    "bin/simple"

# @step: Run memstat --by-owner in a child process with a chosen SIMPLE_MEM_ATTR.
# Two landmines make a plain `process_run(binary, args)` unrepresentative here:
#  1. `bin/simple test` scrubs env vars from spec bodies via the session
#     daemon, so setting SIMPLE_MEM_ATTR in the spec's own process env would
#     never reach a directly-exec'd child.
#  2. The test runner's own process carries SIMPLE_EXECUTION_MODE=interpret
#     in its env, which a directly-exec'd `process_run("bin/simple", ...)`
#     child inherits verbatim and which forces the interpreter's stricter
#     *compile-time* "unknown extern function" abort (exit 1, no in-band
#     message) instead of the JIT's runtime soft-fail-and-continue path a
#     real interactive shell invocation gets. `env -u` strips it so this
#     spec exercises the same engine path an operator actually hits.
fn run_by_owner_with(binary: text, attr_on: bool) -> (text, text, i64):
    val attr_prefix = if attr_on: "SIMPLE_MEM_ATTR=1 " else: ""
    val cmd = "env -u SIMPLE_EXECUTION_MODE {attr_prefix}'{binary}' run src/app/memstat/main.spl --by-owner"
    process_run("/bin/sh", ["-c", cmd])

# Self-heals onto a fresher seed binary (mirroring mem_attr_report_spec.spl)
# when the deployed bin/simple predates the rt_mem_attr_* extern wiring, so
# this spec proves the real per-owner-rows path whenever ANY available
# binary supports it, instead of red-lining on deploy staleness alone.
fn run_by_owner_attr_on() -> (text, text, i64):
    val (out, err, code) = run_by_owner_with(contract_binary(), true)
    if out.contains("OWNER\tLIVE\tPEAK\tALLOCS"):
        return (out, err, code)
    val (probe, _pe, _pc) = process_run("/bin/sh",
        ["-c", "test -x src/compiler_rust/target/release/simple && echo yes || echo no"])
    if probe.contains("yes"):
        val (out2, err2, code2) = run_by_owner_with("src/compiler_rust/target/release/simple", true)
        if out2.contains("OWNER\tLIVE\tPEAK\tALLOCS"):
            return (out2, err2, code2)
    val (probe2, _pe2, _pc2) = process_run("/bin/sh",
        ["-c", "test -x src/compiler_rust/target/debug/simple && echo yes || echo no"])
    if probe2.contains("yes"):
        return run_by_owner_with("src/compiler_rust/target/debug/simple", true)
    (out, err, code)

use std.spec.step

describe "Stage-4 memory gate sampler":
    it "records a header plus data rows with positive RSS for a short-lived process":
        # @req: REQ-CHECK-STAGE4-MEMORY-001
        step("Verify: records a header plus data rows with positive RSS for a short-lived process")
        step("Prepare a clean artifact directory")
        dir_create_all(ARTIFACT_DIR)

        step("Start a short-lived background target process")
        val pid = start_short_lived_target("8")
        val pid_num = parse_dec(pid)
        expect(pid_num).to_be_greater_than(0)

        step("Sample the target with memstat until it exits")
        val rc = sample_with_memstat(pid, CSV_PATH)
        assert_equal(rc, 0)

        step("Read back the recorded CSV profile")
        assert_true(file_exists(CSV_PATH))
        val lines = non_empty_lines(file_read(CSV_PATH))
        expect(lines.len()).to_be_greater_than(1)
        assert_equal(lines[0], CSV_HEADER)

        step("Parse the RSS column of the first data row")
        val cols = lines[1].split(",")
        assert_equal(cols.len(), 8)
        val rss_kb = parse_dec(cols[1])
        expect(rss_kb).to_be_greater_than(0)

    it "rejects an invocation without arguments and prints usage help":
        # @req: REQ-CHECK-STAGE4-MEMORY-001
        step("Verify: rejects an invocation without arguments and prints usage help")
        step("Run memstat with no arguments")
        val (out, _err, code) = process_run("bin/simple", ["run", "src/app/memstat/main.spl"])
        expect(code).to_equal(2)  # oracle: 2 — pinned expected value for this behavior
        expect(out).to_contain("usage: memstat")

    it "--by-owner degrades to a clear status instead of a crash or silent empty output when attribution is off":
        # @req: REQ-CHECK-STAGE4-MEMORY-001
        step("Verify: --by-owner degrades to a clear status instead of a crash or silent empty output when attribution is off")
        step("Run memstat --by-owner without SIMPLE_MEM_ATTR set")
        val (out, _err, code) = run_by_owner_with(contract_binary(), false)

        step("Confirm memstat exits cleanly and always prints the mode banner")
        assert_equal(code, 0)
        expect(out).to_contain("memstat --by-owner: per-owner memory report")

        step("Confirm a clear STATUS line is printed: off or extern-unavailable, never a silent empty body")
        val degraded = out.contains("STATUS\tATTRIBUTION_OFF") or out.contains("STATUS\tEXTERN_UNAVAILABLE")
        assert_true(degraded)

    it "--by-owner prints real per-owner rows when SIMPLE_MEM_ATTR=1 and the extern is available":
        # @req: REQ-CHECK-STAGE4-MEMORY-001
        step("Verify: --by-owner prints real per-owner rows when SIMPLE_MEM_ATTR=1 and the extern is available")
        step("Run memstat --by-owner in a child process with SIMPLE_MEM_ATTR=1 (self-heals onto a seed with the extern wired if needed)")
        val (out, _err, code) = run_by_owner_attr_on()

        step("Confirm the subprocess exited cleanly")
        assert_equal(code, 0)

        if out.contains("OWNER\tLIVE\tPEAK\tALLOCS"):
            step("Confirm at least one per-owner data row printed under the header")
            expect(out).to_contain("<unattributed>")
        else:
            step("No available binary in this environment has rt_mem_attr_* wired yet; confirm the blocked-dependency status instead of a crash or silent empty output")
            expect(out).to_contain("STATUS\tEXTERN_UNAVAILABLE")
