# @req: REQ-CHECK-001
"""
## Purpose and audience
Purpose: accepts complete event capture performance and animation proof
Audience: compiler and tooling engineers who maintain this spec

# Electron MDI proof validator

## Overview

Validates the standalone Electron MDI proof validator. The live wrapper writes
an Electron/Chromium MDI JSON proof and screenshot, and this validator fails
closed unless event routing, screenshot binding, performance timing, and
animation details are all present.

**Plan:** doc/03_plan/ui/web_browser/mdi_platform_completion_plan_2026-06-14.md
**Requirements:** N/A
**Research:** N/A
**Design:** doc/07_guide/tooling/renderdoc_capture_infra.md

## Syntax

```sh
SIMPLE_LIB=src bin/simple test test/03_system/check/electron_mdi_proof_validator_spec.spl --mode=interpreter --clean --fail-fast
```

## Acceptance

- Complete Electron MDI proof JSON validates and emits normalized
  `electron_mdi_*` rows.
- Event routing pass requires DOM events and Electron bridge IPC frames.
- Capture pass requires the proof screenshot path to match the captured
  screenshot artifact.
- Performance and animation pass require `performance.now()`, an explicit
  non-negative timing delta, at least two animation frames, and a CSS animation
  probe.
"""

# @tag: system, gui, electron, mdi, event-routing, performance, animation

use std.io_runtime.{dir_create_all, dir_remove_all, file_read, file_write_bytes, file_write_exact, process_run}
use std.spec.*

struct ProofField:
    key: text
    default_val: text

fn _pf(key: text, default_val: text) -> ProofField:
    ProofField(key: key, default_val: default_val)

fn _valid_png_bytes() -> [u8]:
    var bytes: [u8] = [0x89u8, 0x50u8, 0x4eu8, 0x47u8, 0x0du8, 0x0au8, 0x1au8, 0x0au8, 0x00u8, 0x00u8, 0x00u8, 0x0du8, 0x49u8, 0x48u8, 0x44u8, 0x52u8, 0x00u8, 0x00u8, 0x00u8, 0x01u8, 0x00u8, 0x00u8, 0x00u8, 0x01u8, 0x08u8, 0x04u8, 0x00u8, 0x00u8, 0x00u8, 0xb5u8, 0x1cu8, 0x0cu8, 0x02u8, 0x00u8, 0x00u8, 0x00u8, 0x0bu8, 0x49u8, 0x44u8, 0x41u8, 0x54u8, 0x78u8, 0xdau8, 0x63u8, 0xfcu8, 0xffu8, 0x1fu8, 0x00u8, 0x03u8, 0x03u8, 0x02u8, 0x00u8, 0xefu8, 0xbfu8, 0xa7u8, 0xdbu8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x49u8, 0x45u8, 0x4eu8, 0x44u8, 0xaeu8, 0x42u8, 0x60u8, 0x82u8]
    bytes

fn _forged_png_bytes() -> [u8]:
    var bytes: [u8] = [0x89u8, 0x50u8, 0x4eu8, 0x47u8, 0x0du8, 0x0au8, 0x1au8, 0x0au8, 0x00u8, 0x00u8, 0x00u8, 0x0du8, 0x49u8, 0x48u8, 0x44u8, 0x52u8, 0x00u8, 0x00u8, 0x00u8, 0x01u8, 0x00u8, 0x00u8, 0x00u8, 0x01u8, 0x08u8, 0x03u8, 0x00u8, 0x00u8, 0x00u8, 0x28u8, 0xcbu8, 0x34u8, 0xbbu8, 0x00u8, 0x00u8, 0x00u8, 0x12u8, 0x54u8, 0x94u8, 0x44u8, 0x15u8, 0x44u8, 0x94u8, 0x54u8, 0xe4u8]
    bytes

fn _sig_only_png_bytes() -> [u8]:
    var bytes: [u8] = [0x89u8, 0x50u8, 0x4eu8, 0x47u8, 0x0du8, 0x0au8, 0x1au8, 0x0au8, 0x70u8, 0x72u8, 0x6fu8, 0x6fu8, 0x66u8]
    bytes

fn _mdi_proof_json(screenshot_path: text, k1: text, v1: text, k2: text, v2: text) -> text:
    val fields = [
        _pf("count", "4"),
        _pf("hasDesktop", "true"),
        _pf("imageCount", "1"),
        _pf("hasDragRuntime", "true"),
        _pf("hasDragEvents", "true"),
        _pf("dragMoved", "true"),
        _pf("hasWindowEventRuntime", "true"),
        _pf("appActionControlFound", "true"),
        _pf("appInputControlFound", "true"),
        _pf("bodyClickRouted", "true"),
        _pf("bodyInputRouted", "true"),
        _pf("bodyKeyRouted", "true"),
        _pf("trafficMinimizeRouted", "true"),
        _pf("trafficMaximizeRouted", "true"),
        _pf("trafficCloseRouted", "true"),
        _pf("bridgeIpcFrameCount", "8"),
        _pf("bridgeBodyActionFrameRouted", "true"),
        _pf("bridgeBodyInputFrameRouted", "true"),
        _pf("bridgeBodyKeyFrameRouted", "true"),
        _pf("bridgeMouseDownFrameRouted", "true"),
        _pf("bridgeMouseUpFrameRouted", "true"),
        _pf("bridgeMinimizeFrameRouted", "true"),
        _pf("bridgeMaximizeFrameRouted", "true"),
        _pf("bridgeCloseFrameRouted", "true"),
        _pf("taskbarItemCount", "4"),
        _pf("taskbarIconCount", "4"),
        _pf("taskbarIconsVisible", "true"),
        _pf("taskbarLabelsVisible", "true"),
        _pf("htmlRenderable", "true"),
        _pf("screenshotPath", "\"" + screenshot_path + "\""),
        _pf("performanceNowAvailable", "true"),
        _pf("performanceNowDeltaMs", "16.7"),
        _pf("inputToPaintMs", "18.4"),
        _pf("animationFrameAvailable", "true"),
        _pf("animationFrameCount", "2"),
        _pf("cssAnimationProbe", "true")
    ]
    var out = "{{"
    var first = true
    for f in fields:
        var emit = true
        var value = f.default_val
        if f.key == k1:
            if v1 == "__OMIT__":
                emit = false
            else:
                value = v1
        elif f.key == k2:
            if v2 == "__OMIT__":
                emit = false
            else:
                value = v2
        if emit:
            if not first:
                out = out + ","
            out = out + "\"" + f.key + "\":" + value
            first = false
    out + "}}"

fn _prepare_root(root: text, write_valid_png: bool) -> text:
    val _removed = dir_remove_all(root)
    expect(dir_create_all(root)).to_equal(true)
    val screen_path = root + "/screen.png"
    if write_valid_png:
        expect(file_write_bytes(screen_path, _valid_png_bytes())).to_equal(true)
    screen_path

fn _write_proof(proof_path: text, screenshot_path: text, k1: text, v1: text, k2: text, v2: text):
    val content = _mdi_proof_json(screenshot_path, k1, v1, k2, v2)
    expect(file_write_exact(proof_path, content)).to_equal(true)

fn _run_validator(proof_path: text, screen_path: text) -> (text, i64):
    val (stdout, _stderr, code) = process_run("node", ["scripts/check/validate-electron-mdi-proof.js", proof_path, screen_path])
    (stdout, code)

fn _create_symlink(target: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').symlinkSync(process.argv[1], process.argv[2])", target, link_path])
    code

fn _create_hardlink(existing_path: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').linkSync(process.argv[1], process.argv[2])", existing_path, link_path])
    code

describe "Electron MDI proof validator":

    it "accepts complete event capture performance and animation proof":
        step("Verify: accepts complete event capture performance and animation proof")
        # @req: REQ-CHECK-ElecMdiProoVali-001
        val root = "build/test-electron-mdi-validator-pass"
        val screen_path = _prepare_root(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, screen_path, "", "", "", "")
        val (evidence, code) = _run_validator(proof_path, screen_path)
        expect(code).to_equal(0)

        step("Inspect normalized proof rows")
        expect(evidence).to_contain("electron_mdi_json_proof=pass")
        expect(evidence).to_contain("electron_mdi_event_status=pass")
        expect(evidence).to_contain("electron_mdi_capture_status=pass")
        expect(evidence).to_contain("electron_mdi_performance_status=pass")
        expect(evidence).to_contain("electron_mdi_animation_status=pass")
        expect(evidence).to_contain("electron_mdi_performance_now_delta_ms=16.7")
        expect(evidence).to_contain("electron_mdi_animation_frame_count=2")
        expect(evidence).to_contain("electron_mdi_css_animation_probe=true")

    it "rejects stale event proof that lacks bridge routed frames":
        val root = "build/test-electron-mdi-validator-event"
        val screen_path = _prepare_root(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, screen_path, "bridgeMouseUpFrameRouted", "false", "", "")
        val (evidence, code) = _run_validator(proof_path, screen_path)
        expect(code).to_equal(1)

        expect(evidence).to_contain("electron_mdi_json_proof=fail")
        expect(evidence).to_contain("electron_mdi_event_status=fail")
        expect(evidence).to_contain("event-contract-missing")
        expect(evidence).to_contain("bridgeMouseUpFrameRouted")
        expect(evidence).to_contain("electron_mdi_bridge_mouse_up_frame_routed=false")

    it "emits detailed Electron DOM event routing failures":
        val root = "build/test-electron-mdi-validator-event-detail"
        val screen_path = _prepare_root(root, true)
        val body_json = root + "/body.json"
        val taskbar_json = root + "/taskbar.json"
        _write_proof(body_json, screen_path, "bodyClickRouted", "false", "", "")
        _write_proof(taskbar_json, screen_path, "taskbarLabelsVisible", "false", "", "")
        val (body, body_code) = _run_validator(body_json, screen_path)
        val (taskbar, taskbar_code) = _run_validator(taskbar_json, screen_path)
        expect(body_code).to_equal(1)
        expect(taskbar_code).to_equal(1)

        step("Confirm detailed Electron event diagnostics survive validation")
        expect(body).to_contain("electron_mdi_json_proof=fail")
        expect(body).to_contain("electron_mdi_event_status=fail")
        expect(body).to_contain("electron_mdi_event_body_click_routed=false")
        expect(body).to_contain("electron_mdi_event_body_input_routed=true")
        expect(taskbar).to_contain("electron_mdi_json_proof=fail")
        expect(taskbar).to_contain("electron_mdi_event_status=fail")
        expect(taskbar).to_contain("electron_mdi_event_taskbar_labels_visible=false")
        expect(taskbar).to_contain("electron_mdi_event_taskbar_icons_visible=true")

    it "rejects string booleans without normalizing them as false diagnostics":
        val root = "build/test-electron-mdi-validator-string-booleans"
        val screen_path = _prepare_root(root, true)
        val event_json = root + "/event.json"
        val html_json = root + "/html.json"
        val perf_json = root + "/perf.json"
        val anim_json = root + "/animation.json"
        _write_proof(event_json, screen_path, "bodyClickRouted", "\"true\"", "", "")
        _write_proof(html_json, screen_path, "htmlRenderable", "\"true\"", "", "")
        _write_proof(perf_json, screen_path, "performanceNowAvailable", "\"true\"", "", "")
        _write_proof(anim_json, screen_path, "animationFrameAvailable", "\"true\"", "cssAnimationProbe", "\"true\"")
        val (event, event_code) = _run_validator(event_json, screen_path)
        val (html, html_code) = _run_validator(html_json, screen_path)
        val (perf, perf_code) = _run_validator(perf_json, screen_path)
        val (animation, anim_code) = _run_validator(anim_json, screen_path)
        expect(event_code).to_equal(1)
        expect(html_code).to_equal(1)
        expect(perf_code).to_equal(1)
        expect(anim_code).to_equal(1)

        step("Confirm string booleans remain malformed diagnostics")
        expect(event).to_contain("electron_mdi_json_proof=fail")
        expect(event).to_contain("electron_mdi_json_proof_reason=event-contract-missing:bodyClickRouted")
        expect(event).to_contain("electron_mdi_event_body_click_routed=")
        expect_not(event.contains("electron_mdi_event_body_click_routed=false"))
        expect(html).to_contain("electron_mdi_json_proof=fail")
        expect(html).to_contain("electron_mdi_json_proof_reason=event-contract-missing:htmlRenderable")
        expect(html).to_contain("electron_mdi_render_html_renderable=")
        expect_not(html.contains("electron_mdi_render_html_renderable=false"))
        expect(perf).to_contain("electron_mdi_json_proof=fail")
        expect(perf).to_contain("electron_mdi_json_proof_reason=performance-contract-missing:performanceNowAvailable")
        expect(perf).to_contain("electron_mdi_performance_now_available=")
        expect_not(perf.contains("electron_mdi_performance_now_available=false"))
        expect(animation).to_contain("electron_mdi_json_proof=fail")
        expect(animation).to_contain("electron_mdi_animation_status=fail")
        expect(animation).to_contain("electron_mdi_animation_frame_available=")
        expect(animation).to_contain("electron_mdi_css_animation_probe=")
        expect_not(animation.contains("electron_mdi_animation_frame_available=false"))
        expect_not(animation.contains("electron_mdi_css_animation_probe=false"))

    it "rejects proof bound to a different screenshot artifact":
        val root = "build/test-electron-mdi-validator-capture"
        val screen_path = _prepare_root(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, root + "/old.png", "", "", "", "")
        val (evidence, code) = _run_validator(proof_path, screen_path)
        expect(code).to_equal(1)

        expect(evidence).to_contain("electron_mdi_json_proof=fail")
        expect(evidence).to_contain("electron_mdi_capture_status=fail")
        expect(evidence).to_contain("electron_mdi_screenshot_path_matches=false")
        expect(evidence).to_contain("electron_mdi_screenshot_file_status=pass")
        expect(evidence).to_contain("electron_mdi_screenshot_artifact_status=pass")
        expect(evidence).to_contain("electron_mdi_screenshot_png_magic_status=pass")

    it "rejects symlinked Electron MDI proof and screenshot artifacts":
        val root = "build/test-electron-mdi-validator-symlink-artifacts"
        val screen_path = _prepare_root(root, false)
        val real_png = root + "/real.png"
        val proof_json = root + "/proof.json"
        val linked_proof = root + "/linked-proof.json"
        expect(file_write_bytes(real_png, _valid_png_bytes())).to_equal(true)
        expect(_create_symlink("real.png", screen_path)).to_equal(0)
        _write_proof(proof_json, screen_path, "", "", "", "")
        expect(_create_symlink("proof.json", linked_proof)).to_equal(0)
        val (proof, proof_code) = _run_validator(linked_proof, screen_path)
        val (screenshot, shot_code) = _run_validator(proof_json, screen_path)
        expect(proof_code).to_equal(1)
        expect(shot_code).to_equal(1)

        step("Confirm proof JSON and screenshot paths cannot be symlinked capture evidence")
        expect(proof).to_contain("electron_mdi_json_proof=fail")
        expect(proof).to_contain("electron_mdi_json_proof_reason=proof-json-symlink")
        expect(proof).to_contain("electron_mdi_proof_symlink_status=fail")
        expect(screenshot).to_contain("electron_mdi_json_proof=fail")
        expect(screenshot).to_contain("electron_mdi_capture_status=fail")
        expect(screenshot).to_contain("screenshotNotSymlink")
        expect(screenshot).to_contain("electron_mdi_proof_symlink_status=pass")
        expect(screenshot).to_contain("electron_mdi_screenshot_symlink_status=fail")
        expect(screenshot).to_contain("electron_mdi_screenshot_file_status=pass")
        expect(screenshot).to_contain("electron_mdi_screenshot_file_reason=symlink")
        expect(screenshot).to_contain("electron_mdi_screenshot_artifact_status=fail")
        expect(screenshot).to_contain("electron_mdi_screenshot_size_bytes=68")

    it "rejects hardlinked Electron MDI proof and screenshot artifacts":
        val root = "build/test-electron-mdi-validator-hardlink-artifacts"
        val screen_path = _prepare_root(root, false)
        val real_png = root + "/real.png"
        val proof_json = root + "/proof.json"
        val proof_alias = root + "/proof-alias.json"
        val shot_proof = root + "/screenshot-proof.json"
        expect(file_write_bytes(real_png, _valid_png_bytes())).to_equal(true)
        expect(_create_hardlink(real_png, screen_path)).to_equal(0)
        _write_proof(proof_json, screen_path, "", "", "", "")
        expect(_create_hardlink(proof_json, proof_alias)).to_equal(0)
        _write_proof(shot_proof, screen_path, "", "", "", "")
        val (proof, proof_code) = _run_validator(proof_json, real_png)
        val (screenshot, shot_code) = _run_validator(shot_proof, screen_path)
        expect(proof_code).to_equal(1)
        expect(shot_code).to_equal(1)

        step("Confirm hardlinked proof JSON and screenshot capture artifacts cannot satisfy Electron MDI proof")
        expect(proof).to_contain("electron_mdi_json_proof=fail")
        expect(proof).to_contain("electron_mdi_json_proof_reason=proof-json-hardlink")
        expect(proof).to_contain("electron_mdi_proof_symlink_status=pass")
        expect(proof).to_contain("electron_mdi_proof_hardlink_status=fail")
        expect(screenshot).to_contain("electron_mdi_json_proof=fail")
        expect(screenshot).to_contain("electron_mdi_json_proof_reason=capture-contract-missing:screenshotNotHardlink")
        expect(screenshot).to_contain("electron_mdi_capture_status=fail")
        expect(screenshot).to_contain("electron_mdi_proof_hardlink_status=pass")
        expect(screenshot).to_contain("electron_mdi_screenshot_symlink_status=pass")
        expect(screenshot).to_contain("electron_mdi_screenshot_hardlink_status=fail")
        expect(screenshot).to_contain("electron_mdi_screenshot_file_status=pass")
        expect(screenshot).to_contain("electron_mdi_screenshot_file_reason=hardlink")
        expect(screenshot).to_contain("electron_mdi_screenshot_artifact_status=fail")
        expect(screenshot).to_contain("electron_mdi_screenshot_png_magic_status=pass")
        expect(screenshot).to_contain("electron_mdi_screenshot_png_structure_status=pass")

    it "rejects matching screenshot path when the artifact is missing or empty":
        val root = "build/test-electron-mdi-validator-capture-file"
        val screen_path = _prepare_root(root, false)
        val missing_json = root + "/missing.json"
        val empty_json = root + "/empty.json"
        _write_proof(missing_json, screen_path, "", "", "", "")
        val (missing, missing_code) = _run_validator(missing_json, screen_path)
        expect(missing_code).to_equal(1)

        expect(file_write_exact(screen_path, "")).to_equal(true)
        _write_proof(empty_json, screen_path, "", "", "", "")
        val (empty, empty_code) = _run_validator(empty_json, screen_path)
        expect(empty_code).to_equal(1)

        expect(missing).to_contain("electron_mdi_json_proof=fail")
        expect(missing).to_contain("electron_mdi_json_proof_reason=capture-contract-missing:screenshotFileExists,screenshotFileNonempty,screenshotPngMagic,screenshotPngStructure")
        expect(missing).to_contain("electron_mdi_capture_status=fail")
        expect(missing).to_contain("electron_mdi_screenshot_path_matches=true")
        expect(missing).to_contain("electron_mdi_screenshot_file_status=fail")
        expect(missing).to_contain("electron_mdi_screenshot_file_reason=missing")
        expect(missing).to_contain("electron_mdi_screenshot_artifact_status=fail")
        expect(missing).to_contain("electron_mdi_screenshot_size_bytes=")
        expect(missing).to_contain("electron_mdi_screenshot_png_magic_status=fail")
        expect(missing).to_contain("electron_mdi_screenshot_png_structure_status=fail")
        expect(empty).to_contain("electron_mdi_json_proof=fail")
        expect(empty).to_contain("electron_mdi_json_proof_reason=capture-contract-missing:screenshotFileNonempty,screenshotPngMagic,screenshotPngStructure")
        expect(empty).to_contain("electron_mdi_capture_status=fail")
        expect(empty).to_contain("electron_mdi_screenshot_path_matches=true")
        expect(empty).to_contain("electron_mdi_screenshot_file_status=pass")
        expect(empty).to_contain("electron_mdi_screenshot_file_reason=empty")
        expect(empty).to_contain("electron_mdi_screenshot_artifact_status=fail")
        expect(empty).to_contain("electron_mdi_screenshot_size_bytes=0")
        expect(empty).to_contain("electron_mdi_screenshot_png_magic_status=fail")
        expect(empty).to_contain("electron_mdi_screenshot_png_structure_status=fail")

    it "rejects non-PNG screenshot artifacts even when they are nonempty":
        val root = "build/test-electron-mdi-validator-capture-magic"
        val screen_path = _prepare_root(root, false)
        val proof_path = root + "/proof.json"
        expect(file_write_exact(screen_path, "not-a-png-but-nonempty")).to_equal(true)
        _write_proof(proof_path, screen_path, "", "", "", "")
        val (evidence, code) = _run_validator(proof_path, screen_path)
        expect(code).to_equal(1)

        step("Confirm screenshot capture proof requires PNG signature bytes")
        expect(evidence).to_contain("electron_mdi_json_proof=fail")
        expect(evidence).to_contain("electron_mdi_json_proof_reason=capture-contract-missing:screenshotPngMagic")
        expect(evidence).to_contain("electron_mdi_capture_status=fail")
        expect(evidence).to_contain("electron_mdi_screenshot_file_status=pass")
        expect(evidence).to_contain("electron_mdi_screenshot_file_reason=pass")
        expect(evidence).to_contain("electron_mdi_screenshot_artifact_status=pass")
        expect(evidence).to_contain("electron_mdi_screenshot_png_magic_status=fail")
        expect(evidence).to_contain("electron_mdi_screenshot_png_structure_status=fail")

    it "rejects PNG-signature-only Electron screenshot artifacts":
        val root = "build/test-electron-mdi-validator-capture-signature-only"
        val screen_path = _prepare_root(root, false)
        val proof_path = root + "/proof.json"
        expect(file_write_bytes(screen_path, _sig_only_png_bytes())).to_equal(true)
        _write_proof(proof_path, screen_path, "", "", "", "")
        val (evidence, code) = _run_validator(proof_path, screen_path)
        expect(code).to_equal(1)

        step("Confirm screenshot capture proof requires PNG structure beyond the magic bytes")
        expect(evidence).to_contain("electron_mdi_json_proof=fail")
        expect(evidence).to_contain("electron_mdi_json_proof_reason=capture-contract-missing:screenshotPngStructure")
        expect(evidence).to_contain("electron_mdi_capture_status=fail")
        expect(evidence).to_contain("electron_mdi_screenshot_file_status=pass")
        expect(evidence).to_contain("electron_mdi_screenshot_file_reason=pass")
        expect(evidence).to_contain("electron_mdi_screenshot_artifact_status=pass")
        expect(evidence).to_contain("electron_mdi_screenshot_size_bytes=13")
        expect(evidence).to_contain("electron_mdi_screenshot_png_magic_status=pass")
        expect(evidence).to_contain("electron_mdi_screenshot_png_structure_status=fail")

    it "rejects forged PNG chunk text in Electron screenshot artifacts":
        val root = "build/test-electron-mdi-validator-capture-forged-chunks"
        val screen_path = _prepare_root(root, false)
        val proof_path = root + "/proof.json"
        expect(file_write_bytes(screen_path, _forged_png_bytes())).to_equal(true)
        _write_proof(proof_path, screen_path, "", "", "", "")
        val (evidence, code) = _run_validator(proof_path, screen_path)
        expect(code).to_equal(1)

        step("Confirm Electron screenshot proof needs structured PNG chunks, not bare IDAT/IEND text")
        expect(evidence).to_contain("electron_mdi_json_proof=fail")
        expect(evidence).to_contain("electron_mdi_json_proof_reason=capture-contract-missing:screenshotPngStructure")
        expect(evidence).to_contain("electron_mdi_capture_status=fail")
        expect(evidence).to_contain("electron_mdi_screenshot_file_status=pass")
        expect(evidence).to_contain("electron_mdi_screenshot_file_reason=pass")
        expect(evidence).to_contain("electron_mdi_screenshot_artifact_status=pass")
        expect(evidence).to_contain("electron_mdi_screenshot_png_magic_status=pass")
        expect(evidence).to_contain("electron_mdi_screenshot_png_structure_status=fail")

    it "rejects performance availability without explicit timing delta":
        val root = "build/test-electron-mdi-validator-performance"
        val screen_path = _prepare_root(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, screen_path, "performanceNowDeltaMs", "__OMIT__", "", "")
        val (evidence, code) = _run_validator(proof_path, screen_path)
        expect(code).to_equal(1)

        expect(evidence).to_contain("electron_mdi_json_proof=fail")
        expect(evidence).to_contain("electron_mdi_performance_status=fail")
        expect(evidence).to_contain("electron_mdi_performance_now_delta_ms=")
        expect_not(evidence.contains("electron_mdi_performance_now_delta_ms=0"))

    it "rejects performance timing that does not advance or exceeds budget":
        val root = "build/test-electron-mdi-validator-zero-performance"
        val screen_path = _prepare_root(root, true)
        val proof_path = root + "/proof.json"
        val slow_path = root + "/slow.json"
        _write_proof(proof_path, screen_path, "performanceNowDeltaMs", "0", "", "")
        _write_proof(slow_path, screen_path, "performanceNowDeltaMs", "1001", "", "")
        val (evidence, proof_code) = _run_validator(proof_path, screen_path)
        val (slow, slow_code) = _run_validator(slow_path, screen_path)
        expect(proof_code).to_equal(1)
        expect(slow_code).to_equal(1)

        expect(evidence).to_contain("electron_mdi_json_proof=fail")
        expect(evidence).to_contain("electron_mdi_json_proof_reason=performance-contract-missing:performanceNowDeltaMs")
        expect(evidence).to_contain("electron_mdi_performance_status=fail")
        expect(evidence).to_contain("electron_mdi_performance_now_available=true")
        expect(evidence).to_contain("electron_mdi_performance_now_delta_ms=0")
        expect(slow).to_contain("electron_mdi_json_proof=fail")
        expect(slow).to_contain("electron_mdi_json_proof_reason=performance-contract-missing:performanceNowDeltaMsWithinBudget")
        expect(slow).to_contain("electron_mdi_performance_status=fail")
        expect(slow).to_contain("electron_mdi_performance_now_delta_ms=1001")

    it "rejects missing zero over-budget or stringified input-to-paint latency":
        val root = "build/test-electron-mdi-validator-input-latency"
        val screen_path = _prepare_root(root, true)
        val missing_json = root + "/missing.json"
        val zero_json = root + "/zero.json"
        val string_json = root + "/string.json"
        val slow_json = root + "/slow.json"
        _write_proof(missing_json, screen_path, "inputToPaintMs", "__OMIT__", "", "")
        _write_proof(zero_json, screen_path, "inputToPaintMs", "0", "", "")
        _write_proof(string_json, screen_path, "inputToPaintMs", "\"18.4\"", "", "")
        _write_proof(slow_json, screen_path, "inputToPaintMs", "1001", "", "")
        val (missing, missing_code) = _run_validator(missing_json, screen_path)
        val (zero, zero_code) = _run_validator(zero_json, screen_path)
        val (string_latency, string_code) = _run_validator(string_json, screen_path)
        val (slow, slow_code) = _run_validator(slow_json, screen_path)
        expect(missing_code).to_equal(1)
        expect(zero_code).to_equal(1)
        expect(string_code).to_equal(1)
        expect(slow_code).to_equal(1)

        expect(missing).to_contain("electron_mdi_json_proof=fail")
        expect(missing).to_contain("electron_mdi_json_proof_reason=interaction-latency-contract-missing:inputToPaintMs")
        expect(missing).to_contain("electron_mdi_interaction_latency_status=fail")
        expect(missing).to_contain("electron_mdi_input_to_paint_ms=")
        expect(zero).to_contain("electron_mdi_json_proof=fail")
        expect(zero).to_contain("electron_mdi_interaction_latency_status=fail")
        expect(zero).to_contain("electron_mdi_input_to_paint_ms=0")
        expect(string_latency).to_contain("electron_mdi_json_proof=fail")
        expect(string_latency).to_contain("electron_mdi_interaction_latency_status=fail")
        expect(string_latency).to_contain("electron_mdi_input_to_paint_ms=")
        expect_not(string_latency.contains("electron_mdi_input_to_paint_ms=18.4"))
        expect(slow).to_contain("electron_mdi_json_proof=fail")
        expect(slow).to_contain("electron_mdi_json_proof_reason=interaction-latency-contract-missing:inputToPaintMsWithinBudget")
        expect(slow).to_contain("electron_mdi_interaction_latency_status=fail")
        expect(slow).to_contain("electron_mdi_input_to_paint_ms=1001")

    it "rejects missing animation frame proof":
        val root = "build/test-electron-mdi-validator-animation"
        val screen_path = _prepare_root(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, screen_path, "animationFrameCount", "1", "cssAnimationProbe", "false")
        val (evidence, code) = _run_validator(proof_path, screen_path)
        expect(code).to_equal(1)

        expect(evidence).to_contain("electron_mdi_json_proof=fail")
        expect(evidence).to_contain("electron_mdi_animation_status=fail")
        expect(evidence).to_contain("electron_mdi_animation_frame_count=1")
        expect(evidence).to_contain("electron_mdi_css_animation_probe=false")

    it "rejects fractional event and animation count proof values":
        val root = "build/test-electron-mdi-validator-fractional-counts"
        val screen_path = _prepare_root(root, true)
        val event_json = root + "/event.json"
        val anim_json = root + "/animation.json"
        _write_proof(event_json, screen_path, "bridgeIpcFrameCount", "8.5", "", "")
        _write_proof(anim_json, screen_path, "animationFrameCount", "2.5", "", "")
        val (event, event_code) = _run_validator(event_json, screen_path)
        val (animation, anim_code) = _run_validator(anim_json, screen_path)
        expect(event_code).to_equal(1)
        expect(anim_code).to_equal(1)

        step("Confirm fractional count values are not accepted as Electron MDI proof")
        expect(event).to_contain("electron_mdi_json_proof=fail")
        expect(event).to_contain("electron_mdi_event_status=fail")
        expect(event).to_contain("bridgeIpcFrameCount")
        expect(event).to_contain("electron_mdi_bridge_ipc_frame_count=")
        expect_not(event.contains("electron_mdi_bridge_ipc_frame_count=8.5"))
        expect(animation).to_contain("electron_mdi_json_proof=fail")
        expect(animation).to_contain("electron_mdi_animation_status=fail")
        expect(animation).to_contain("animationFrameCount")
        expect(animation).to_contain("electron_mdi_animation_frame_count=")
        expect_not(animation.contains("electron_mdi_animation_frame_count=2.5"))

    it "rejects stringified numeric event performance latency and animation proof values":
        val root = "build/test-electron-mdi-validator-string-numbers"
        val screen_path = _prepare_root(root, true)
        val window_json = root + "/window.json"
        val bridge_json = root + "/bridge.json"
        val taskbar_json = root + "/taskbar.json"
        val perf_json = root + "/performance.json"
        val latency_json = root + "/latency.json"
        val anim_json = root + "/animation.json"
        _write_proof(window_json, screen_path, "count", "\"4\"", "", "")
        _write_proof(bridge_json, screen_path, "bridgeIpcFrameCount", "\"8\"", "", "")
        _write_proof(taskbar_json, screen_path, "taskbarItemCount", "\"4\"", "", "")
        _write_proof(perf_json, screen_path, "performanceNowDeltaMs", "\"16.7\"", "", "")
        _write_proof(latency_json, screen_path, "inputToPaintMs", "\"18.4\"", "", "")
        _write_proof(anim_json, screen_path, "animationFrameCount", "\"2\"", "", "")
        val (window, w_code) = _run_validator(window_json, screen_path)
        val (bridge, b_code) = _run_validator(bridge_json, screen_path)
        val (taskbar, t_code) = _run_validator(taskbar_json, screen_path)
        val (performance, p_code) = _run_validator(perf_json, screen_path)
        val (latency, l_code) = _run_validator(latency_json, screen_path)
        val (animation, a_code) = _run_validator(anim_json, screen_path)
        expect(w_code).to_equal(1)
        expect(b_code).to_equal(1)
        expect(t_code).to_equal(1)
        expect(p_code).to_equal(1)
        expect(l_code).to_equal(1)
        expect(a_code).to_equal(1)

        step("Confirm stringified numeric evidence is not accepted as live Electron MDI proof")
        expect(window).to_contain("electron_mdi_json_proof=fail")
        expect(window).to_contain("electron_mdi_json_proof_reason=event-contract-missing:count")
        expect(window).to_contain("electron_mdi_window_count=")
        expect_not(window.contains("electron_mdi_window_count=4"))
        expect(bridge).to_contain("electron_mdi_json_proof=fail")
        expect(bridge).to_contain("bridgeIpcFrameCount")
        expect(bridge).to_contain("electron_mdi_bridge_ipc_frame_count=")
        expect_not(bridge.contains("electron_mdi_bridge_ipc_frame_count=8"))
        expect(taskbar).to_contain("electron_mdi_json_proof=fail")
        expect(taskbar).to_contain("taskbarItemCount")
        expect(performance).to_contain("electron_mdi_json_proof=fail")
        expect(performance).to_contain("electron_mdi_json_proof_reason=performance-contract-missing:performanceNowDeltaMs")
        expect(performance).to_contain("electron_mdi_performance_now_delta_ms=")
        expect_not(performance.contains("electron_mdi_performance_now_delta_ms=16.7"))
        expect(latency).to_contain("electron_mdi_json_proof=fail")
        expect(latency).to_contain("electron_mdi_json_proof_reason=interaction-latency-contract-missing:inputToPaintMs")
        expect(latency).to_contain("electron_mdi_input_to_paint_ms=")
        expect_not(latency.contains("electron_mdi_input_to_paint_ms=18.4"))
        expect(animation).to_contain("electron_mdi_json_proof=fail")
        expect(animation).to_contain("electron_mdi_json_proof_reason=animation-contract-missing:animationFrameCount")
        expect(animation).to_contain("electron_mdi_animation_frame_count=")
        expect_not(animation.contains("electron_mdi_animation_frame_count=2"))

    it "keeps the live Electron producer and shell wrapper wired to timing proof":
        val bridge = file_read("src/app/ui.electron/bridge.js")
        val wrapper = file_read("scripts/check/check-electron-mdi-evidence.shs")
        expect(bridge).to_contain("performanceNowAvailable")
        expect(bridge).to_contain("animationFrameCount")
        expect(bridge).to_contain("cssAnimationProbe")
        expect(wrapper).to_contain("validate-electron-mdi-proof.js")
