# @req: REQ-SSPEC-SYSTEM
"""
# UI showcase exact backend matrix

The matrix wrapper performs one strict native build and requires exact
software, CPU, CPU-SIMD, Metal, and Vulkan receipts without fabricated stubs.
"""

use std.spec.*
use std.io_runtime.{file_read}

describe "UI showcase exact backend matrix wrapper":

    it "builds once with strict no-stub admission":
        step("Inspect the native build contract")
        val source = file_read("scripts/check/check-ui-showcase-exact-backend-matrix.shs")
        expect(source).to_contain("SIMPLE_NO_STUB_FALLBACK=1")
        expect(source).to_contain("--entry src/app/ui_showcase/hosts/main_2d_engine.spl")
        expect(source).to_contain("--entry-closure")
        expect(source).to_contain("fabricated-stub evidence")
        expect(source).to_contain("build-vulkan-drawir-showcase-native.shs")
        expect(source).to_contain("ui-showcase-vulkan")

    it "requires backend-specific native receipts and captures":
        step("Inspect exact backend result gates")
        val source = file_read("scripts/check/check-ui-showcase-exact-backend-matrix.shs")
        expect(source).to_contain("renderer=$backend")
        expect(source).to_contain("fallback=false")
        expect(source).to_contain("native_simd_hits=[1-9][0-9]*")
        expect(source).to_contain("source=device_readback")
        expect(source).to_contain("backend_handle=[1-9][0-9]*")
        expect(source).to_contain("device_identity=[1-9][0-9]*")
        expect(source).to_contain("SIMPLE_SHOWCASE_FRAMES=2")
        expect(source).to_contain("SIMPLE_SHOWCASE_SCRIPT='click 80,10;resize 400,300'")
        expect(source).to_contain("capture did not use resized viewport")
        expect(source).to_contain("font_identity=[^ ]+")
        expect(source).to_contain("font_target=vulkan")
        expect(source).to_contain("font_target=metal")
        expect(source).to_contain("font_device_checksum=-?[1-9][0-9]*")
        expect(source).to_contain("font_oracle_checksum=-?[1-9][0-9]*")
        expect(source).to_contain("font_atlas_sha256=[0-9a-f]{64}")
        expect(source).to_contain("font_parity=true")
        expect(source).to_contain("capture is not binary PPM")
