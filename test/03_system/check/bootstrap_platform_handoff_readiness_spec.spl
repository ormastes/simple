# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Bootstrap platform handoff readiness

Exercises the checker self-test and its default blocked report. This lane
proves checker wiring and the claim boundary only; it does not execute a
platform bootstrap or provide platform acceptance evidence.
"""

# codex-system-test
# @tag: system, bootstrap, platform, handoff, readiness, evidence

use std.spec.step

use std.io_runtime.{process_run}
use std.spec.*

fn step_bootstrap_platform_handoff_readiness() -> [String]:
    [
        "BPHR-001",
        "BPHR-002",
        "BPHR-003",
        "BPHR-004",
        "BPHR-005",
        "BPHR-006",
        "BPHR-007",
        "BPHR-008",
        "BPHR-009",
        "BPHR-010",
        "BPHR-011",
        "scripts/check/check-bootstrap-platform-handoff-readiness.shs",
        "bootstrap_handoff_readiness_status=blocked",
        "platform_acceptance_claimed=false"
    ]

describe "Bootstrap platform handoff readiness":
    # @manual scenario evidence
    describe "BPHR-001/BPHR-002: checker self-test claim boundary":
        it "should execute the checker self-test without a platform PASS claim":
            # @req REQ-SSPEC-SYSTEM
            step("should execute the checker self-test without a platform PASS claim")
            step("Run the bootstrap platform handoff checker self-test")
            val readiness = step_bootstrap_platform_handoff_readiness()
            expect(readiness).to_contain("BPHR-001")
            expect(readiness).to_contain("BPHR-002")
            val (stdout, _stderr, code) = process_run(
                "/bin/sh",
                ["-c", "sh scripts/check/check-bootstrap-platform-handoff-readiness.shs --self-test"]
            )
            expect(code).to_equal(0)
            expect(stdout).to_contain("bootstrap_handoff_self_test=pass")
            expect(stdout).to_contain("bootstrap_handoff_identity_guard_self_test=pass")
            expect(stdout).to_contain("bootstrap_handoff_stage2_stage3_guard_self_test=pass")
            expect(stdout).to_contain("bootstrap_handoff_no_seed_no_stub_guard_self_test=pass")
            expect(stdout).to_contain("bootstrap_handoff_atomic_rollback_guard_self_test=pass")
            expect(stdout).to_contain("bootstrap_handoff_stage4_execution_guard_self_test=pass")
            expect(stdout).to_contain("bootstrap_handoff_current_tree_guard_self_test=pass")
            expect(stdout).to_contain("bootstrap_handoff_wrong_worktree_guard_self_test=pass")
            expect(stdout).to_contain("platform_acceptance_claimed=false")

    describe "BPHR-003/BPHR-004: default blocked handoff":
        it "should report the default handoff as blocked and not platform PASS":
            # @req REQ-SSPEC-SYSTEM
            step("should report the default handoff as blocked and not platform PASS")
            step("Run the default bootstrap platform handoff readiness check")
            val readiness = step_bootstrap_platform_handoff_readiness()
            expect(readiness).to_contain("BPHR-003")
            expect(readiness).to_contain("BPHR-004")
            val (stdout, _stderr, code) = process_run(
                "/bin/sh",
                ["-c", "sh scripts/check/check-bootstrap-platform-handoff-readiness.shs"]
            )
            expect(code).to_equal(1)
            expect(stdout).to_contain("bootstrap_handoff_readiness_status=blocked")
            expect(stdout).to_contain("bootstrap_handoff_readiness_reason=stage3_candidate:")
            expect(stdout).to_contain("bootstrap_handoff_remaining_gate_count=")
            expect(stdout).to_contain("platform_acceptance_claimed=false")
