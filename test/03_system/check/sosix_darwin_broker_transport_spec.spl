"""
# Darwin launch and broker peer observations

Native adversarial evidence for in-memory launchd CDHash admission, mutual Unix
stream peer identity, incarnation pinning, and asynchronous registration
cleanup. A pre-observation job takeover exposes the unavailable original-job
admission proof. This primitive does not qualify a generic V4 process owner.
"""

use std.io_runtime.{process_run}
use std.spec.*

describe "Darwin launch and broker peer observations":
    it "observes kernel peers and exposes the unavailable original-job admission proof":
        val (stdout, stderr, code) = process_run("/bin/sh", [
            "scripts/check/check-sosix-darwin-broker-transport.shs"
        ])
        if code != 0:
            print(stderr)
        expect(code).to_equal(0)
        expect(stdout).to_contain("mutual_kernel_peer_identity: observed")
        expect(stdout).to_contain("wrong_pid_version_and_cdhash: rejected")
        expect(stdout).to_contain("getjob_argument_and_incarnation_substitution: rejected")
        expect(stdout).to_contain("same_uid_same_image_unrelated_peer: rejected")
        expect(stdout).to_contain("post_exec_socket_token: rejected")
        expect(stdout).to_contain("asynchronous_registration_removal: no_reap_claim")
        expect(stdout).to_contain("same_label_recreated_job: rejected")
        expect(stdout).to_contain("same_uid_socket_path_substitution: no_protocol_bytes")
        expect(stdout).to_contain("wrong_spawn_cdhash: rejected_before_constructor")
        expect(stdout).to_contain("unbound_replacement_control: enters_constructor")
        expect(stdout).to_contain("same_path_replacement: rejected_before_constructor")
        expect(stdout).to_contain("preauthentication_environment_takeover: observation_cannot_attest_admission")
        expect(stdout).to_contain("original_job_admission_authority: unavailable")
        expect(stdout).to_contain("generic_v4_capability: not_claimed")
        expect(stdout).to_contain("darwin_broker_transport: pass")
