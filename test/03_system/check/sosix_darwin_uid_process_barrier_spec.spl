"""
# Darwin conservative UID process-record barrier

The native probe holds real live processes and unreaped zombies and verifies
that a UID/unique-id census cannot report their absence. It also covers a session-changing descendant
whose PID was never supplied to the observer, bounded snapshot retries, errors,
reaping between snapshot and lookup, and expiry before successful observation.

This component is not a generic reap capability: authenticated root identity,
immutable descendant UID, closed admission, and zero live coalition tasks are
prerequisites for a future broker to use its observation as a reap proof.
"""

use std.io_runtime.{process_run}
use std.spec.*

describe "Darwin UID process-record observation":
    it "rejects retained and unobserved descendant zombies without inventing reap authority":
        val (stdout, stderr, code) = process_run("/bin/sh", [
            "scripts/check/check-sosix-darwin-uid-process.shs"
        ])
        if code != 0:
            print(stderr)
        expect(code).to_equal(0)
        expect(stdout).to_contain("new_unreaped_uid_process: blocks")
        expect(stdout).to_contain("non_zombie_exit_transition: blocks")
        expect(stdout).to_contain("new_live_uid_record: blocks_until_reaped")
        expect(stdout).to_contain("short_census: retried_without_false_absence")
        expect(stdout).to_contain("census_permission_failure: closed")
        expect(stdout).to_contain("old_unrelated_zombie: excluded_by_kernel_unique_id")
        expect(stdout).to_contain("reaped_after_snapshot: safely_resolved")
        expect(stdout).to_contain("post_snapshot_deadline: closed")
        expect(stdout).to_contain("unobserved_session_descendant_zombie: blocks_until_reaped")
        expect(stdout).to_contain("generic_reap_capability: not_claimed")
        expect(stdout).to_contain("darwin_uid_process_barrier: pass")
