# @cover scripts/check/check-tauri-simple-web-layout-bitmap-evidence.shs 80%
"""
## Purpose and audience
Purpose: accepts complete Tauri timing capture and checksum proof
Audience: compiler and tooling engineers who maintain this spec

# Tauri Simple Web layout proof validator

## Overview

Validates the Tauri Simple Web layout proof validator used by the Tauri/WebKit
bitmap capture wrapper. The wrapper captures a live Tauri window, converts the
RGBA screenshot to ARGB JSON, and consumes normalized validator rows before
claiming pass or divergent evidence.

**Plan:** doc/03_plan/ui/tui/production_gui_web_renderer_parity_hardening.md
**Requirements:** N/A
**Research:** N/A
**Design:** doc/07_guide/tooling/renderdoc_capture_infra.md

## Syntax

```sh
SIMPLE_LIB=src bin/simple test test/03_system/check/tauri_simple_web_layout_proof_validator_spec.spl --mode=interpreter --clean --fail-fast
```

## Acceptance

- Complete Tauri layout proof JSON validates and emits normalized
  `tauri_simple_web_layout_*` rows.
- Malformed `frame_us` fails closed instead of relying on shell integer
  comparison behavior.
- Blur/tolerance use, missing ARGB capture, malformed mismatch counts, and
  malformed WebKit expected-profile metadata are rejected.
- ARGB capture proof paths must resolve to nonempty files instead of relying
  on `captured_argb_written=true` alone.
- ARGB capture file-status rows distinguish `missing`, `empty`, and `pass` so
  diagnostics cannot treat a zero-byte artifact as a valid capture file.
- ARGB capture file-reason and artifact-status rows normalize missing, empty,
  symlink, hardlink, and pass cases for downstream renderer evidence gates.
- Tauri layout proof JSON and captured ARGB artifacts must be single regular
  files, not symlinks or hardlinks to mutable or substituted evidence.
- ARGB capture proof paths must not resolve back to the top-level proof JSON
  even if the proof contains artifact-shaped fields.
- ARGB capture files must parse as `argb-u32` artifacts from the Tauri window
  screenshot converter, match the requested viewport, contain the exact pixel
  count, and include nonzero pixels.
- Captured ARGB pixels must be real JSON numeric uint32 values; string,
  fractional, or out-of-range values are not valid screenshot readback proof.
- Checksum proof rows must match the recomputed captured ARGB artifact
  checksum, not only each other.
- Requested viewport, ARGB readback dimensions, frame timing, overlay counts,
  and mismatch counts must be real JSON numbers, not stringified rows.
- Capture-written and blur/tolerance proof rows must be real JSON booleans;
  string booleans are rejected and not normalized as valid `true` or `false`
  diagnostics.
- The live Tauri wrapper consumes the validator and still maps real pixel
  mismatches to `divergent` evidence.
## Operator workflow

Each scenario runs the packaged validator (via `node scripts/check/...` or a
direct process invocation) against a complete proof document or a proof mutated
in exactly one field, and asserts the validator exit code and normalized rows.

## Compatibility and limitations

Scenarios that replay a Tauri WebGPU capture need the captured frame log; validator-only scenarios run from a plain repo checkout.

## Verification guidance and troubleshooting

A RED reject scenario is the fail-closed contract working: rerun the scenario and
inspect the cited validator command with the mutated field restored to confirm the
regression. A RED accept scenario means the packaged proof itself regressed;
recapture it with the scripts/check command named in the scenario before shipping.

"""

# @tag: system, gui, tauri, webkit, renderer, capture, performance

use std.io_runtime.{dir_create_all, dir_remove_all, file_copy, file_exists, file_read, file_write_exact, process_run}
use std.spec.*

struct KV:
    key: text
    value: text

fn _kv(key: text, value: text) -> KV:
    KV(key: key, value: value)

fn _repeat_csv(elem: text, count: i64) -> text:
    if count <= 0:
        return ""
    var result = ""
    var block = elem
    var remaining = count
    while remaining > 0:
        if remaining % 2 == 1:
            if result == "":
                result = block
            else:
                result = result + "," + block
        remaining = remaining / 2
        if remaining > 0:
            block = block + "," + block
    result

fn _argb_json(width_json: text, height: i64, format_str: text, producer: text, pixel_val: text, pixel_count: i64) -> text:
    "{{\"width\":" + width_json + ",\"height\":" + height.to_string() + ",\"format\":\"" + format_str + "\",\"producer\":\"" + producer + "\",\"pixels\":[" + _repeat_csv(pixel_val, pixel_count) + "]}}"

fn _write_default_argb(dir: text):
    val tmpl = "build/.tmp_tauri_layout_default_argb.json"
    if not file_exists(tmpl):
        expect(dir_create_all("build")).to_equal(true)
        expect(file_write_exact(tmpl, _argb_json("96", 64, "argb-u32", "tauri-x11-window-screenshot", "4294967295", 96 * 64))).to_equal(true)
    expect(file_copy(tmpl, dir + "/captured.json")).to_equal(true)

fn _prepare_dir(root: text, with_argb: bool):
    val _removed = dir_remove_all(root)
    expect(dir_create_all(root)).to_equal(true)
    if with_argb:
        _write_default_argb(root)

fn _find_override(overrides: [KV], key: text) -> text:
    for item in overrides:
        if item.key == key:
            return item.value
    "__DEFAULT__"

fn _write_proof(proof_path: text, overrides: [KV]):
    val defaults = [
        _kv("status", "\"pass\""),
        _kv("reason", "\"pass\""),
        _kv("width", "96"),
        _kv("height", "64"),
        _kv("checksum", "\"26388279060480\""),
        _kv("expected_checksum", "\"26388279060480\""),
        _kv("weighted_checksum", "\"81077987413324800\""),
        _kv("expected_weighted_checksum", "\"81077987413324800\""),
        _kv("mismatch_count", "0"),
        _kv("frame_us", "1250"),
        _kv("captured_argb_path", "\"captured.json\""),
        _kv("captured_argb_written", "true"),
        _kv("blur_or_tolerance_used", "false"),
        _kv("expected_profile", "\"webkitgtk\""),
        _kv("expected_overlay_pixel_count", "12")
    ]
    var out = "{{"
    var first = true
    for item in defaults:
        val ov = _find_override(overrides, item.key)
        if ov != "__OMIT__":
            val value = if ov == "__DEFAULT__": item.value else: ov
            if not first:
                out = out + ","
            out = out + "\"" + item.key + "\":" + value
            first = false
    for extra in overrides:
        if _find_override(defaults, extra.key) == "__DEFAULT__" and extra.value != "__OMIT__":
            if not first:
                out = out + ","
            out = out + "\"" + extra.key + "\":" + extra.value
            first = false
    out = out + "}}"
    expect(file_write_exact(proof_path, out)).to_equal(true)

fn _run_validator(proof_path: text) -> (text, i64):
    val (stdout, _stderr, code) = process_run("node", ["scripts/check/validate-tauri-simple-web-layout-proof.js", proof_path])
    (stdout, code)

fn _run_validator_producer(proof_path: text, expected_producer: text) -> (text, i64):
    val js = "process.env.TAURI_SIMPLE_WEB_LAYOUT_EXPECTED_PRODUCER=process.argv[1];process.argv=[process.argv[0],'scripts/check/validate-tauri-simple-web-layout-proof.js',process.argv[2]];require('./scripts/check/validate-tauri-simple-web-layout-proof.js')"
    val (stdout, _stderr, code) = process_run("node", ["-e", js, expected_producer, proof_path])
    (stdout, code)

fn _create_symlink(target: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').symlinkSync(process.argv[1], process.argv[2])", target, link_path])
    code

fn _create_hardlink(existing_path: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').linkSync(process.argv[1], process.argv[2])", existing_path, link_path])
    code

# Lifecycle: doc/01_research/ui/render_path/electron_tauri_vulkan_enablement_2026-06-16.md ;
# doc/03_plan/platform/mobile_tauri_gui_parallel_2026-05-29.md ;
# doc/04_architecture/ui/simple_gui_stack.md ;
# doc/05_design/browser_wasm_webgpu_infra.md
# @manual_section: proof validators

describe "Tauri Simple Web layout proof validator":

    it "accepts complete Tauri timing capture and checksum proof":
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        step("Verify: accepts complete Tauri timing capture and checksum proof")
        # @req: REQ-CHECK-TaurSimpWebLayoProoVali-001
        val root = "build/test-tauri-layout-validator-pass"
        _prepare_dir(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, [])
        val (evidence, code) = _run_validator(proof_path)
        expect(code).to_equal(0)  # oracle: validator exits 0 only for a complete well-formed proof (fail-closed exit contract)

        step("Inspect normalized Tauri layout proof rows")
        expect(evidence).to_contain("tauri_simple_web_layout_validation_status=pass")
        expect(evidence).to_contain("tauri_simple_web_layout_validation_reason=pass")
        expect(evidence).to_contain("tauri_simple_web_layout_mismatch_count=0")
        expect(evidence).to_contain("tauri_simple_web_layout_tauri_frame_us=1250")
        expect(evidence).to_contain("tauri_simple_web_layout_captured_argb_written=true")
        expect(evidence).to_contain("tauri_simple_web_layout_blur_or_tolerance_used=false")
        expect(evidence).to_contain("tauri_simple_web_layout_expected_profile=webkitgtk")
        expect(evidence).to_contain("tauri_simple_web_layout_expected_overlay_pixel_count=12")

    it "accepts macOS WKWebView snapshot producer when the wrapper requires it":
        # @req: REQ-CHECK-TaurSimpWebLayProoVali-002
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-tauri-layout-validator-macos-producer"
        _prepare_dir(root, false)
        expect(file_write_exact(root + "/captured.json", _argb_json("96", 64, "argb-u32", "macos-wkwebview-snapshot", "4294967295", 96 * 64))).to_equal(true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, [_kv("expected_profile", "\"none\""), _kv("expected_overlay_pixel_count", "0")])
        val (evidence, code) = _run_validator_producer(proof_path, "macos-wkwebview-snapshot")
        expect(code).to_equal(0)  # oracle: validator exits 0 only for a complete well-formed proof (fail-closed exit contract)

        step("Inspect macOS WKWebView ARGB producer provenance")
        expect(evidence).to_contain("tauri_simple_web_layout_validation_status=pass")
        expect(evidence).to_contain("tauri_simple_web_layout_captured_argb_producer=macos-wkwebview-snapshot")
        expect(evidence).to_contain("tauri_simple_web_layout_expected_profile=none")
        expect(evidence).to_contain("tauri_simple_web_layout_expected_overlay_pixel_count=0")

    it "applies macOS WKWebView expected overlay without tolerance":
        # @req: REQ-CHECK-TaurSimpWebLayProoVali-003
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-tauri-layout-validator-wkwebview-overlay"
        _prepare_dir(root, false)
        expect(dir_create_all(root + "/css_box_matrix")).to_equal(true)
        val gen_js = "const fs=require('fs');const helper=require('./tools/tauri-live-bitmap/webkitgtk_expected_overlays');const root=process.argv[1];const w=96,h=64;const expectedPath=root+'/css_box_matrix/expected.json';const base=Array(w*h).fill(4294967295);fs.writeFileSync(expectedPath,JSON.stringify(__LB__width:w,height:h,format:'argb-u32',producer:'fixture',pixels:base__RB__));const pixels=helper.applyTauriExpectedOverlay(expectedPath,base,'wkwebview').pixels;const raw=Buffer.alloc(w*h*4);for(let i=0;i<pixels.length;i++)__LB__const p=pixels[i]>>>0;raw[i*4]=(p>>>16)&255;raw[i*4+1]=(p>>>8)&255;raw[i*4+2]=p&255;raw[i*4+3]=(p>>>24)&255;__RB__fs.writeFileSync(root+'/raw.rgba',raw);".replace("__LB__", "{{").replace("__RB__", "}}")
        val (_g_out, _g_err, g_code) = process_run("node", ["-e", gen_js, root])
        expect(g_code).to_equal(0)
        val conv_js = "const r=process.argv[1];process.env.TAURI_CAPTURE_RAW_RGBA=r+'/raw.rgba';process.env.TAURI_CAPTURE_WIDTH='96';process.env.TAURI_CAPTURE_HEIGHT='64';process.env.TAURI_CAPTURE_OUTPUT=r+'/captured.json';process.env.TAURI_CAPTURE_EXPECTED_ARGB_PATH=r+'/css_box_matrix/expected.json';process.env.TAURI_CAPTURE_EXPECTED_PROFILE='wkwebview';process.env.TAURI_CAPTURE_PRODUCER='macos-wkwebview-snapshot';process.env.TAURI_CAPTURE_PROOF_PATH=r+'/proof.json';process.env.TAURI_CAPTURE_FRAME_US='1250';require('./tools/tauri-live-bitmap/raw_rgba_to_argb.js')"
        val (converted, _c_err, conv_code) = process_run("node", ["-e", conv_js, root])
        expect(conv_code).to_equal(0)
        val (evidence, code) = _run_validator_producer(root + "/proof.json", "macos-wkwebview-snapshot")
        expect(code).to_equal(0)  # oracle: validator exits 0 only for a complete well-formed proof (fail-closed exit contract)

        step("Confirm WKWebView overlay is exact-profile evidence, not tolerance")
        expect(converted).to_contain("mismatch_count=0")
        expect(converted).to_contain("blur_or_tolerance_used=false")
        expect(evidence).to_contain("tauri_simple_web_layout_validation_status=pass")
        expect(evidence).to_contain("tauri_simple_web_layout_captured_argb_producer=macos-wkwebview-snapshot")
        expect(evidence).to_contain("tauri_simple_web_layout_expected_profile=tauri-wkwebview-macos:css_box_matrix")
        expect(evidence).to_contain("tauri_simple_web_layout_expected_overlay_pixel_count=43")
        expect(evidence).to_contain("tauri_simple_web_layout_blur_or_tolerance_used=false")

    it "rejects large checksum values that differ past JavaScript number precision":
        # @req: REQ-CHECK-TaurSimpWebLayProoVali-004
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-tauri-layout-validator-large-checksum"
        _prepare_dir(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, [
            _kv("checksum", "\"9007199254740993\""),
            _kv("expected_checksum", "\"9007199254740992\""),
            _kv("weighted_checksum", "\"18014398509481985\""),
            _kv("expected_weighted_checksum", "\"18014398509481985\"")
        ])
        val (evidence, code) = _run_validator(proof_path)
        expect(code).to_equal(1)  # oracle: validator exits 1 on the injected defect (fail-closed reject contract)

        step("Assert decimal integer text is preserved for large checksum proof")
        expect(evidence).to_contain("tauri_simple_web_layout_validation_status=fail")
        expect(evidence).to_contain("tauri_simple_web_layout_validation_reason=checksum-mismatch")
        expect(evidence).to_contain("tauri_simple_web_layout_tauri_checksum=9007199254740993")
        expect(evidence).to_contain("tauri_simple_web_layout_simple_checksum=9007199254740992")
        expect(evidence).to_contain("tauri_simple_web_layout_tauri_weighted_checksum=18014398509481985")
        expect(evidence).to_contain("tauri_simple_web_layout_simple_weighted_checksum=18014398509481985")

    it "rejects malformed Tauri frame timing":
        # @req: REQ-CHECK-TaurSimpWebLayProoVali-005
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        step("Verify: rejects malformed Tauri frame timing")
        val root = "build/test-tauri-layout-validator-bad-frame"
        _prepare_dir(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, [_kv("frame_us", "\"not-a-number\"")])
        val (evidence, code) = _run_validator(proof_path)
        expect(code).to_equal(1)  # oracle: validator exits 1 on the injected defect (fail-closed reject contract)

        expect(evidence).to_contain("tauri_simple_web_layout_validation_status=fail")
        expect(evidence).to_contain("tauri_simple_web_layout_validation_reason=missing-tauri-timing")
        expect(evidence).to_contain("tauri_simple_web_layout_tauri_frame_us=")
        expect_not(evidence.contains("tauri_simple_web_layout_tauri_frame_us=not-a-number"))

    it "rejects missing capture and malformed WebKit metadata":
        # @req: REQ-CHECK-TaurSimpWebLayProoVali-006
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        step("Verify: rejects missing capture and malformed WebKit metadata")
        val root = "build/test-tauri-layout-validator-missing-artifacts"
        _prepare_dir(root, true)
        _write_proof(root + "/capture.json", [_kv("captured_argb_written", "false")])
        _write_proof(root + "/profile.json", [_kv("expected_profile", "\"\"")])
        _write_proof(root + "/overlay.json", [_kv("expected_overlay_pixel_count", "\"bad\"")])
        val (capture, c1) = _run_validator(root + "/capture.json")
        val (profile, c2) = _run_validator(root + "/profile.json")
        val (overlay, c3) = _run_validator(root + "/overlay.json")
        expect(c1).to_equal(1)
        expect(c2).to_equal(1)
        expect(c3).to_equal(1)

        expect(capture).to_contain("tauri_simple_web_layout_validation_reason=missing-captured-argb")
        expect(capture).to_contain("tauri_simple_web_layout_captured_argb_written=false")
        expect(profile).to_contain("tauri_simple_web_layout_validation_reason=missing-expected-profile")
        expect(overlay).to_contain("tauri_simple_web_layout_validation_reason=malformed-expected-overlay-pixel-count")

    it "rejects missing and empty captured ARGB files":
        # @req: REQ-CHECK-TaurSimpWebLayProoVali-007
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-tauri-layout-validator-captured-files"
        _prepare_dir(root, false)
        _write_proof(root + "/missing.json", [_kv("captured_argb_path", "\"missing.json\"")])
        val (missing, c1) = _run_validator(root + "/missing.json")
        expect(c1).to_equal(1)

        expect(file_write_exact(root + "/captured.json", "")).to_equal(true)
        _write_proof(root + "/empty.json", [])
        val (empty, c2) = _run_validator(root + "/empty.json")
        expect(c2).to_equal(1)

        step("Confirm boolean Tauri capture flags are not enough without file evidence")
        expect(missing).to_contain("tauri_simple_web_layout_validation_status=fail")
        expect(missing).to_contain("tauri_simple_web_layout_validation_reason=missing-captured-argb-file")
        expect(missing).to_contain("tauri_simple_web_layout_captured_argb_file_status=missing")
        expect(missing).to_contain("tauri_simple_web_layout_captured_argb_file_reason=missing")
        expect(missing).to_contain("tauri_simple_web_layout_captured_argb_artifact_status=fail")
        expect(missing).to_contain("tauri_simple_web_layout_captured_argb_size_bytes=")
        expect(empty).to_contain("tauri_simple_web_layout_validation_status=fail")
        expect(empty).to_contain("tauri_simple_web_layout_validation_reason=empty-captured-argb-file")
        expect(empty).to_contain("tauri_simple_web_layout_captured_argb_file_status=empty")
        expect(empty).to_contain("tauri_simple_web_layout_captured_argb_file_reason=empty")
        expect(empty).to_contain("tauri_simple_web_layout_captured_argb_artifact_status=fail")
        expect(empty).to_contain("tauri_simple_web_layout_captured_argb_size_bytes=0")

    it "rejects captured ARGB paths that point back at the proof JSON":
        # @req: REQ-CHECK-TaurSimpWebLayProoVali-008
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-tauri-layout-validator-self-artifact"
        _prepare_dir(root, false)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, [
            _kv("captured_argb_path", "\"proof.json\""),
            _kv("format", "\"argb-u32\""),
            _kv("producer", "\"tauri-x11-window-screenshot\""),
            _kv("pixels", "[" + _repeat_csv("4294967295", 96 * 64) + "]")
        ])
        val (evidence, code) = _run_validator(proof_path)
        expect(code).to_equal(1)  # oracle: validator exits 1 on the injected defect (fail-closed reject contract)

        step("Confirm the proof JSON cannot be reused as its own Tauri ARGB artifact")
        expect(evidence).to_contain("tauri_simple_web_layout_validation_status=fail")
        expect(evidence).to_contain("tauri_simple_web_layout_validation_reason=missing-captured-argb-file")
        expect(evidence).to_contain("tauri_simple_web_layout_captured_argb_path=proof.json")
        expect(evidence).to_contain("tauri_simple_web_layout_captured_argb_file_status=missing")
        expect(evidence).to_contain("tauri_simple_web_layout_captured_argb_file_reason=missing")
        expect(evidence).to_contain("tauri_simple_web_layout_captured_argb_artifact_status=fail")
        expect(evidence).to_contain("tauri_simple_web_layout_captured_argb_size_bytes=")

    it "rejects symlinked Tauri layout proof and captured ARGB artifacts":
        # @req: REQ-CHECK-TaurSimpWebLayProoVali-009
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-tauri-layout-validator-symlinks"
        _prepare_dir(root, true)
        _write_proof(root + "/proof-real.json", [])
        expect(_create_symlink("proof-real.json", root + "/proof-link.json")).to_equal(0)
        val (proof, c1) = _run_validator(root + "/proof-link.json")
        expect(c1).to_equal(1)

        expect(file_copy(root + "/captured.json", root + "/captured-real.json")).to_equal(true)
        expect(_create_symlink("captured-real.json", root + "/captured-link.json")).to_equal(0)
        _write_proof(root + "/argb.json", [_kv("captured_argb_path", "\"captured-link.json\"")])
        val (argb, c2) = _run_validator(root + "/argb.json")
        expect(c2).to_equal(1)

        step("Confirm Tauri layout evidence cannot be substituted through symlinks")
        expect(proof).to_contain("tauri_simple_web_layout_validation_status=fail")
        expect(proof).to_contain("tauri_simple_web_layout_validation_reason=proof-json-symlink")
        expect(proof).to_contain("tauri_simple_web_layout_proof_symlink_status=fail")
        expect(proof).to_contain("tauri_simple_web_layout_proof_hardlink_status=unknown")
        expect(argb).to_contain("tauri_simple_web_layout_validation_status=fail")
        expect(argb).to_contain("tauri_simple_web_layout_validation_reason=captured-argb-symlink")
        expect(argb).to_contain("tauri_simple_web_layout_proof_symlink_status=pass")
        expect(argb).to_contain("tauri_simple_web_layout_proof_hardlink_status=pass")
        expect(argb).to_contain("tauri_simple_web_layout_captured_argb_file_status=symlink")
        expect(argb).to_contain("tauri_simple_web_layout_captured_argb_file_reason=symlink")
        expect(argb).to_contain("tauri_simple_web_layout_captured_argb_artifact_status=fail")
        expect(argb).to_contain("tauri_simple_web_layout_captured_argb_symlink_status=fail")
        expect(argb).to_contain("tauri_simple_web_layout_captured_argb_hardlink_status=pass")

    it "rejects hardlinked Tauri layout proof and captured ARGB artifacts":
        # @req: REQ-CHECK-TaurSimpWebLayProoVali-010
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-tauri-layout-validator-hardlinks"
        _prepare_dir(root, false)
        _write_proof(root + "/proof-real.json", [])
        expect(_create_hardlink(root + "/proof-real.json", root + "/proof-link.json")).to_equal(0)
        val (proof, c1) = _run_validator(root + "/proof-link.json")
        expect(c1).to_equal(1)

        expect(file_write_exact(root + "/captured-real.json", _argb_json("96", 64, "argb-u32", "tauri-x11-window-screenshot", "4294967295", 96 * 64))).to_equal(true)
