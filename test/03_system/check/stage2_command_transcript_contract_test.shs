#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
producer="$root/scripts/bootstrap/bootstrap-from-scratch.sh"
verifier="$root/scripts/check/lib/bootstrap-stage3/manifest-verify.shs"
facade="$root/scripts/check/lib/bootstrap-stage3-provenance.shs"
fail() { echo "FAIL: $*" >&2; exit 1; }

stage2_hash=$(sed -n '/stage2_build_args_sha256=$(/,/^  )$/p' "$producer")
stage3_hash=$(sed -n '/stage3_build_args_sha256=$(/,/^  )$/p' "$producer")
stage2_run=$(sed -n '/bootstrap_run_stage2_native()/,/^  }/p' "$producer")
stage3_run=$(sed -n '/bootstrap_stage3_run_transcribed \\/,/^  stage3_status=/p' "$producer")

for required in \
  'SIMPLE_ABI_POLICY=${simple_abi_policy}' \
  'SIMPLE_PLUGIN_MANIFEST_POLICY=${SIMPLE_PLUGIN_MANIFEST_POLICY}' \
  'SIMPLE_KERNEL_K1_POLICY=${SIMPLE_KERNEL_K1_POLICY}' \
  'SIMPLE_COVERAGE_CUTOVER_STATE=${SIMPLE_COVERAGE_CUTOVER_STATE}' \
  'SIMPLE_K1_COMPOSITION_SHA256_BEFORE=${k1_composition_sha256_before}' \
  'SIMPLE_FRONTEND_CACHE=1' \
  'SIMPLE_PHASE3_COMPATIBILITY_CACHE_ROOT=${stage3_cache_absolute}'; do
  printf '%s\n' "$stage2_hash" | grep -Fq "$required" || fail "Stage 2 hash lost $required"
  printf '%s\n' "$stage2_run" | grep -Fq "$required" || fail "Stage 2 transcript lost $required"
  printf '%s\n' "$stage3_hash" | grep -Fq "$required" || fail "Stage 3 hash lost $required"
  printf '%s\n' "$stage3_run" | grep -Fq "$required" || fail "Stage 3 transcript lost $required"
done
printf '%s\n' "$stage3_hash" | grep -Fq 'SIMPLE_BOOTSTRAP_STAGE3=1' || fail 'Stage 3 hash lost route authority'
printf '%s\n' "$stage3_run" | grep -Fq 'SIMPLE_BOOTSTRAP_STAGE3=1' || fail 'Stage 3 transcript lost route authority'
printf '%s\n' "$stage3_hash" | grep -Fq '${k1_composition_source_args}' || fail 'Stage 3 hash lost selected source root'
printf '%s\n' "$stage3_run" | grep -Fq '${k1_composition_source_args}' || fail 'Stage 3 transcript lost selected source root'
grep -Fq 'bootstrap_stage3_transcript_args_sha256' "$verifier" || fail 'verifier does not hash the retained transcript'
grep -Fq 'src/compositions/kernel_llvm_cranelift' "$verifier" || fail 'verifier does not reconstruct the selected composition root'
if grep -Fq 'SIMPLE_FRONTEND_CACHE=0' "$verifier"; then fail 'stale cache-off reconstruction remains'; fi

scratch=$(mktemp -d "${TMPDIR:-/tmp}/stage3-transcript-contract.XXXXXX") || fail scratch
trap 'rm -rf -- "$scratch"' EXIT HUP INT TERM
mkdir -p "$scratch/home" "$scratch/tmp"
BOOTSTRAP_STAGE3_FACADE_PATH="$facade"
export BOOTSTRAP_STAGE3_FACADE_PATH
. "$facade"
transcript="$scratch/stage3-command.transcript"
bootstrap_stage3_write_command_transcript "$transcript" "$root" "$scratch/home" "$scratch/tmp" \
  /usr/bin:/bin SIMPLE_BOOTSTRAP=1 SIMPLE_BOOTSTRAP_STAGE3=1 \
  SIMPLE_ABI_POLICY=v1 SIMPLE_FRONTEND_CACHE=1 -- /bin/true native-build \
  --source "$root/src/compositions/kernel_llvm_cranelift" --source src/compiler || fail writer
hash_before=$(bootstrap_stage3_transcript_args_sha256 "$transcript") || fail transcript_hash
sed 's/SIMPLE_FRONTEND_CACHE=1/SIMPLE_FRONTEND_CACHE=0/' "$transcript" >"$scratch/mutated"
hash_after=$(bootstrap_stage3_transcript_args_sha256 "$scratch/mutated") || fail mutated_hash
[ "$hash_before" != "$hash_after" ] || fail 'transcript mutation did not change command identity'

echo 'PASS: Stage 2/3 producer and verifier bind the exact canonical transcript'
