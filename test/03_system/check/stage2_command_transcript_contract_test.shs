#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
producer="$root/scripts/bootstrap/bootstrap-from-scratch.sh"
resume="$root/scripts/bootstrap/resume-stage3-from-admitted.sh"
verifier="$root/scripts/check/lib/bootstrap-stage3/manifest-verify.shs"
facade="$root/scripts/check/lib/bootstrap-stage3-provenance.shs"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

stage2_hash_block=$(sed -n \
  '/stage2_build_args_sha256=$(/,/^  )$/p' "$producer")
stage2_run_block=$(sed -n \
  '/bootstrap_stage3_run_transcribed \\/,/^  stage2_status=/p' "$producer")

[ "$(grep -Fxc '  stage2_compile_stack_mib=64' "$producer")" -eq 1 ] ||
  fail "canonical Stage 2 must bind exactly one 64 MiB compile-stack value"
[ "$(printf '%s\n' "$stage2_hash_block" |
  grep -Fc -- '--compile-stack-mib "${stage2_compile_stack_mib}"')" -eq 1 ] ||
  fail "Stage 2 args hash omits or duplicates the compile-stack value"
[ "$(printf '%s\n' "$stage2_run_block" |
  grep -Fc -- '--compile-stack-mib "${stage2_compile_stack_mib}"')" -eq 1 ] ||
  fail "Stage 2 transcribed execution omits or duplicates the compile-stack value"

grep -Fq '"$stage2_transcript" --compile-stack-mib' "$resume" ||
  fail "Stage 3 resume no longer derives compile-stack from the Stage 2 transcript"
grep -Fq '"$bootstrap_stage3_stage2_transcript" --compile-stack-mib' "$verifier" ||
  fail "manifest verification no longer derives compile-stack from the Stage 2 transcript"

scratch=$(mktemp -d "${TMPDIR:-/tmp}/stage2-transcript-contract.XXXXXX") ||
  fail "could not create scratch directory"
trap 'rm -rf -- "$scratch"' EXIT HUP INT TERM
mkdir -p "$scratch/home" "$scratch/tmp"

BOOTSTRAP_STAGE3_FACADE_PATH="$facade"
export BOOTSTRAP_STAGE3_FACADE_PATH
. "$facade"

transcript="$scratch/stage2-command.transcript"
bootstrap_stage3_write_command_transcript \
  "$transcript" "$root" "$scratch/home" "$scratch/tmp" "/usr/bin:/bin" \
  "SIMPLE_NO_STUB_FALLBACK=1" -- /bin/true native-build \
  --threads 1 --compile-stack-mib 64 --cache-dir "$scratch/cache" ||
  fail "canonical transcript writer rejected the Stage 2 argv"

[ "$(bootstrap_stage3_transcript_argv_value_after \
  "$transcript" --compile-stack-mib)" = 64 ] ||
  fail "canonical transcript schema did not retain the exact 64 MiB value"
bootstrap_stage3_verify_command_transcript \
  "$transcript" "$root" "SIMPLE_NO_STUB_FALLBACK=1" -- \
  /bin/true native-build --threads 1 --compile-stack-mib 64 \
  --cache-dir "$scratch/cache" ||
  fail "canonical transcript verifier rejected the exact Stage 2 argv"

echo "PASS: Stage 2 producer, transcript schema, resume, and manifest verifier agree on 64 MiB"
