"""
# Darwin strict descendant authority

Negative qualification of the unprivileged native process-group foundation.
The live native probe creates session, process-group, and double-fork escapes,
checks survival after leader exit and group kill, then retires each fixture.
Kernel exit notification is observed separately from wait/reap authority.
The strict acceptance command must fail instead of advertising V4 support.

This specification is macOS-only and requires a native C compiler. A non-macOS
exit 77 is not a successful strict-qualification result.
"""

use std.io_runtime.{process_run}
use std.spec.*

describe "Darwin all-descendant authority":
    it "keeps strict qualification closed when native escape probes reproduce":
        val (stdout, stderr, code) = process_run("/bin/sh", [
            "scripts/check/check-sosix-darwin-strict-tree.shs", "--require-strict"
        ])
        expect(code).to_equal(78)
        expect(stdout).to_contain("escape_setsid_exit: reproduced")
        expect(stdout).to_contain("escape_setsid_kill: reproduced")
        expect(stdout).to_contain("escape_setpgid_exit: reproduced")
        expect(stdout).to_contain("escape_setpgid_kill: reproduced")
        expect(stdout).to_contain("escape_double-fork_exit: reproduced")
        expect(stdout).to_contain("escape_double-fork_kill: reproduced")
        expect(stdout).to_contain("recursive_kqueue: unsupported")
        expect(stdout).to_contain("strict_tree_authority: unavailable")
        expect(stderr).to_contain("no OS-enforced all-descendant owner")
