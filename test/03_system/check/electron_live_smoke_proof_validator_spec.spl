    it "keeps Electron live smoke diagnostics on early dependency failures":
        # @req: REQ-CHECK-ElecLiveSmokProoVali-021
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-electron-live-smoke-wrapper-early-fail"
        val command = "rm -rf " + root + " && mkdir -p " + root + " && " +
            "mkdir -p " + root + "/bin && " +
            "for cmd in dirname mkdir rm cat sed tail; do resolved=$(command -v \"$cmd\") || exit 1; printf '#!/bin/sh\\nexec \"%s\" \"$@\"\\n' \"$resolved\" > " + root + "/bin/$cmd && chmod +x " + root + "/bin/$cmd; done && " +
            "rc=0; PATH=\"$PWD/" + root + "/bin\" SIMPLE_ELECTRON_PROOF_PATH=" + root + "/proof.json /bin/sh scripts/check/check-electron-live-smoke.shs > " + root + "/stdout.env 2> " + root + "/stderr.log || rc=$?; test \"$rc\" -eq 1"
        val (_stdout, _stderr, code) = process_run("/bin/sh", ["-c", command])
        expect(code).to_equal(0)  # oracle: shell harness exits 0 only after dependency shims resolve cleanly and check-electron-live-smoke.shs exits 1 on missing node

