# @cover scripts/check/check-electron-live-smoke.shs 80%
"""
## Purpose and audience
Purpose: accepts complete Electron live DOM timing and animation proof
Audience: compiler and tooling engineers who maintain this spec

# Electron live smoke proof validator

## Overview

Validates the live Electron smoke proof used by the package CI wrapper. The
proof must show that Chromium received the Simple render envelope, populated a
nonempty DOM, executed renderer event handlers, and exposed browser timing and
animation APIs.

**Plan:** doc/03_plan/os/wm/shared_wm_renderer_unification_completion_audit.md
**Requirements:** N/A
**Research:** N/A
**Design:** doc/04_architecture/ui/simple_gui_stack.md

## Syntax

```sh
SIMPLE_LIB=src bin/simple test test/03_system/check/electron_live_smoke_proof_validator_spec.spl --mode=interpreter --clean --fail-fast
```

## Acceptance

- A complete live Electron proof validates and emits normalized
  `electron_live_smoke_*` rows.
- Missing DOM render text, missing CSS envelope, missing rendered text sample,
  missing `performance.now`, zero timing deltas, missing two animation frames,
  over-budget multi-second timing deltas, missing CSS animation support, and
  blur/tolerance use fail closed.
- Viewport dimensions, DOM length counters, performance timing deltas, and
  animation frame counts must be live numeric JSON values; decimal strings are
  rejected as stale or hand-authored proof and are not re-emitted as normalized
  numeric rows.
- DOM presence, performance availability, animation availability, CSS animation,
  event dispatch availability, and tolerance flags must be real JSON booleans;
  string booleans are rejected and are not re-emitted as normalized boolean
  rows.
- The proof must include a renderer-side event dispatch result with the expected
  live smoke event type and detail so passive DOM snapshots cannot stand in for
  event handling proof.
- Renderer-side event dispatch proof must not carry a nonempty dispatch error;
  event counts, types, and details are not enough if the bridge recorded an
  event error.
- Renderer-side event dispatch proof must include a live bounded
  event-to-paint timing row.
- The rendered text sample must include the live-smoke entry text and must not
  exceed the reported rendered text length.
- Requested capture viewport dimensions must be explicit decimal integers; the
  proof validator must not accept exponent or fractional notation as a capture
  size contract.
- The proof must carry the Electron bridge live-smoke source marker so a
  generic hand-authored JSON object cannot stand in for the renderer bridge
  probe.
- The bridge source marker must resolve to a single-link regular nonempty
  bridge source file that still contains the live smoke proof producer and
  marker. Symlinked, hardlinked, empty, non-regular, or markerless bridge source
  artifacts fail closed, and the validator must expose both reported and actual
  bridge source byte-size rows.
- The proof must include Chromium/Electron runtime evidence from the renderer
  user agent and Electron/Chrome process versions, not only a hand-authored
  source marker.
- The proof must include a regular single-link PNG screenshot artifact plus
  viewport, bitmap-byte, checksum, nontransparent-pixel, and distinct-color
  rows so DOM-only evidence cannot stand in for a rendered capture.
- Screenshot validation must bound compressed and inflated allocations while
  retaining enough capacity for a UHD 8K RGBA capture.
- The validator and wrapper must emit normalized proof-source and screenshot
  artifact reason/status rows so downstream GUI gates can distinguish valid
  live artifacts from missing, aliased, malformed, or substituted files.
- The proof target and surface must identify the live Electron main surface,
  and early wrapper diagnostics must preserve those identity rows.
- The proof JSON path itself must be a single-link file, never a
  symlink to a stale or attacker-controlled proof, a hardlinked reusable proof,
  or a non-file artifact.
- The live smoke shell wrapper delegates JSON validation to the proof validator.
- The package live smoke script must launch the built local Simple compiler, or
  a caller-provided `SIMPLE_BIN`, instead of a non-existent package-local
  placeholder binary.
- The live smoke shell wrapper keeps the full validator diagnostic row surface
  on early unavailable/fail exits, including DOM, CSS, rendered text, viewport,
  performance, animation, and tolerance rows.
- The live smoke shell wrapper prints validator-derived failure rows before
  exiting nonzero when a produced proof fails validation.

## Operator workflow

Each scenario runs the packaged validator (via `node scripts/check/...` or a
direct process invocation) against a complete proof document or a proof mutated
in exactly one field, and asserts the validator exit code and normalized rows.

## Compatibility and limitations

Scenarios that invoke the live Electron wrapper need a graphical host with the packaged proof present; validator-only scenarios run from a plain repo checkout.

## Verification guidance and troubleshooting

A RED reject scenario is the fail-closed contract working: rerun the scenario and
inspect the cited validator command with the mutated field restored to confirm the
regression. A RED accept scenario means the packaged proof itself regressed;
recapture it with the scripts/check command named in the scenario before shipping.

"""

# @tag: system, gui, electron, smoke, renderer, animation

use std.io_runtime.{dir_create_all, dir_remove_all, file_copy, file_delete, file_exists, file_read, file_write_exact, process_run}
use std.spec.*

struct KV:
    key: text
    value: text

fn _kv(key: text, value: text) -> KV:
    KV(key: key, value: value)

fn _ensure_png_template():
    val tmpl_png = "build/.tmp_electron_live_smoke.png"
    val tmpl_size = "build/.tmp_electron_live_smoke.size"
    if not file_exists(tmpl_png) or not file_exists(tmpl_size):
        expect(dir_create_all("build")).to_equal(true)
        val gen_js = "const fs=require('fs'),zlib=require('zlib');function crc32(b)__LB__let c=0xffffffff;for(const v of b)__LB__c^=v;for(let i=0;i<8;i++)c=(c>>>1)^(c&1?0xedb88320:0)__RB__return(c^0xffffffff)>>>0__RB__function chunk(t,d)__LB__const n=Buffer.from(t),b=Buffer.alloc(d.length+12);b.writeUInt32BE(d.length,0);n.copy(b,4);d.copy(b,8);b.writeUInt32BE(crc32(Buffer.concat([n,d])),d.length+8);return b__RB__const h=Buffer.alloc(13);h.writeUInt32BE(1280,0);h.writeUInt32BE(720,4);h[8]=8;h[9]=6;const raw=Buffer.alloc((1280*4+1)*720);for(let y=0;y<720;y++)for(let x=0;x<1280;x++)__LB__const o=y*(1280*4+1)+1+x*4;raw[o]=x<640?255:0;raw[o+2]=x<640?0:255;raw[o+3]=255;__RB__const png=Buffer.concat([Buffer.from('89504e470d0a1a0a','hex'),chunk('IHDR',h),chunk('IDAT',zlib.deflateSync(raw)),chunk('IEND',Buffer.alloc(0))]);fs.writeFileSync(process.argv[1],png);fs.writeFileSync(process.argv[2],String(png.length));".replace("__LB__", "{{").replace("__RB__", "}}")
        val (_out, _err, code) = process_run("node", ["-e", gen_js, tmpl_png, tmpl_size])
        expect(code).to_equal(0)

fn _png_size_str() -> text:
    _ensure_png_template()
    file_read("build/.tmp_electron_live_smoke.size").trim()

fn _prepare_dir(root: text):
    val _removed = dir_remove_all(root)
    expect(dir_create_all(root)).to_equal(true)

fn _copy_png(dst: text):
    _ensure_png_template()
    expect(file_copy("build/.tmp_electron_live_smoke.png", dst)).to_equal(true)

fn _find_override(overrides: [KV], key: text) -> text:
    for item in overrides:
        if item.key == key:
            return item.value
    "__DEFAULT__"

fn _text_in(xs: [text], target: text) -> bool:
    for x in xs:
        if x == target:
            return true
    false

fn _write_proof_with_png(proof_path: text, png_path: text, create_png: bool, overrides: [KV]):
    if create_png:
        _copy_png(png_path)
    val png_len = _png_size_str()
    val n_ov = overrides.len()
    if n_ov == 0:
        val out = "{{\"target\":\"electron\",\"surface_id\":\"main\",\"proof_source\":\"src/app/ui.electron/bridge.js:electronLiveSmokeProofScript\",\"browser_engine\":\"chromium\",\"electron_user_agent\":\"Mozilla/5.0 Chrome/142.0.0.0 Electron/42.5.0 Safari/537.36\",\"electron_process_version\":\"42.5.0\",\"chrome_process_version\":\"142.0.0.0\",\"width\":1280,\"height\":720,\"body_html_length\":64,\"css_length\":12,\"app_element_present\":true,\"body_text_length\":23,\"body_text_sample\":\"Hello World from Web!\",\"performance_now_available\":true,\"performance_now_delta_ms\":1.25,\"animation_frame_available\":true,\"animation_frame_count\":2,\"css_animation_probe\":true,\"event_dispatch_available\":true,\"event_dispatch_count\":1,\"event_dispatch_type\":\"simple-electron-live-smoke-event\",\"event_dispatch_detail\":\"live-smoke-input\",\"event_dispatch_error\":\"\",\"event_dispatch_to_paint_ms\":1.5,\"screenshot_path\":\"" + png_path + "\",\"screenshot_width\":1280,\"screenshot_height\":720,\"screenshot_png_size_bytes\":" + png_len + ",\"screenshot_bitmap_byte_count\":3686400,\"screenshot_pixel_checksum\":1668317184,\"screenshot_nontransparent_pixel_count\":921600,\"screenshot_distinct_color_count\":2,\"screenshot_error\":\"\",\"blur_or_tolerance_used\":false}}"
        expect(file_write_exact(proof_path, out)).to_equal(true)
        return
    val defaults = [
        "target", "\"electron\"",
        "surface_id", "\"main\"",
        "proof_source", "\"src/app/ui.electron/bridge.js:electronLiveSmokeProofScript\"",
        "browser_engine", "\"chromium\"",
        "electron_user_agent", "\"Mozilla/5.0 Chrome/142.0.0.0 Electron/42.5.0 Safari/537.36\"",
        "electron_process_version", "\"42.5.0\"",
        "chrome_process_version", "\"142.0.0.0\"",
        "width", "1280",
        "height", "720",
        "body_html_length", "64",
        "css_length", "12",
        "app_element_present", "true",
        "body_text_length", "23",
        "body_text_sample", "\"Hello World from Web!\"",
        "performance_now_available", "true",
        "performance_now_delta_ms", "1.25",
        "animation_frame_available", "true",
        "animation_frame_count", "2",
        "css_animation_probe", "true",
        "event_dispatch_available", "true",
        "event_dispatch_count", "1",
        "event_dispatch_type", "\"simple-electron-live-smoke-event\"",
        "event_dispatch_detail", "\"live-smoke-input\"",
        "event_dispatch_error", "\"\"",
        "event_dispatch_to_paint_ms", "1.5",
        "screenshot_path", "\"" + png_path + "\"",
        "screenshot_width", "1280",
        "screenshot_height", "720",
        "screenshot_png_size_bytes", png_len,
        "screenshot_bitmap_byte_count", "3686400",
        "screenshot_pixel_checksum", "1668317184",
        "screenshot_nontransparent_pixel_count", "921600",
        "screenshot_distinct_color_count", "2",
        "screenshot_error", "\"\"",
        "blur_or_tolerance_used", "false"
    ]
    var parts: [text] = []
    var seen_ov: [text] = []
    val n_def = defaults.len()
    var i = 0
    if n_ov == 1:
        val k0 = overrides[0].key
        val v0 = overrides[0].value
        while i < n_def:
            val dk = defaults[i]
            if dk == k0:
                seen_ov.push(dk)
                if v0 != "__OMIT__":
                    parts.push("\"" + dk + "\":" + v0)
            else:
                parts.push("\"" + dk + "\":" + defaults[i + 1])
            i = i + 2
    else:
        while i < n_def:
            val dk = defaults[i]
            val ov = _find_override(overrides, dk)
            if ov != "__DEFAULT__":
                seen_ov.push(dk)
            if ov != "__OMIT__":
                val value = if ov == "__DEFAULT__": defaults[i + 1] else: ov
                parts.push("\"" + dk + "\":" + value)
            i = i + 2
    for extra in overrides:
        if extra.value != "__OMIT__" and not _text_in(seen_ov, extra.key):
            parts.push("\"" + extra.key + "\":" + extra.value)
    expect(file_write_exact(proof_path, "{{" + parts.join(",") + "}}")).to_equal(true)

fn _write_proof(proof_path: text, overrides: [KV]):
    _write_proof_with_png(proof_path, proof_path + ".png", true, overrides)

fn _ensure_batch_runner() -> text:
    val runner = "build/.tmp_val_batch_runner.js"
    if not file_exists(runner):
        expect(dir_create_all("build")).to_equal(true)
        val raw = "const fs=require('fs'),path=require('path'),Module=require('module');const script=path.resolve(process.argv[2]);const origCwd=process.cwd();const src=fs.readFileSync(script,'utf8').replace(/^#![^\\n]*\\n/,'');const fn=new Function('require','process','console','__filename','__dirname',src);const req=Module.createRequire(script);const results=[];for(const raw of process.argv.slice(3))__LB__ const parts=raw.split('@@SEP@@');const workDir=parts[0];const envSpec=parts[1];const args=parts.slice(2);let out='';let code=0;const fakeEnv=Object.assign(__LB____RB__,process.env);if(envSpec)for(const kv of envSpec.split(';'))__LB__ const eq=kv.indexOf('=');if(eq>0)__LB__ const k=kv.slice(0,eq),v=kv.slice(eq+1);if(v)fakeEnv[k]=v;else delete fakeEnv[k];__RB__ __RB__;const fakeProc=Object.create(process);fakeProc.env=fakeEnv;fakeProc.argv=[process.execPath,script,...args];fakeProc.exit=(c=0)=>__LB__ code=c;throw __LB____exit:true__RB__;__RB__;const fakeCon=__LB__ log:(...a)=>__LB__ out+=a.map(String).join(' ')+'\\n';__RB__,error:()=>__LB____RB__ __RB__;try__LB__ if(workDir)process.chdir(workDir);fn(req,fakeProc,fakeCon,script,path.dirname(script));__RB__ catch(e)__LB__ if(!e||!e.__exit)code=1;__RB__ finally__LB__ if(workDir)process.chdir(origCwd);__RB__;results.push(String(code)+'<<<CODE_END>>>'+out);__RB__;process.stdout.write(results.join('<<<BATCH_SEP>>>'));"
        val js = raw.replace("__LB__", "{{").replace("__RB__", "}}")
        expect(file_write_exact(runner, js)).to_equal(true)
    runner

fn _run_validator_many(arg_specs: [text]) -> [(text, i64)]:
    val runner = _ensure_batch_runner()
    var cmd_args = [runner, "scripts/check/validate-electron-live-smoke-proof.js"]
    for s in arg_specs:
        cmd_args.push("@@SEP@@@@SEP@@" + s)
    val (stdout, _stderr, _code) = process_run("node", cmd_args)
    var out: [(text, i64)] = []
    for chunk in stdout.split("<<<BATCH_SEP>>>"):
        val pair = chunk.split("<<<CODE_END>>>")
        val c = if pair[0].trim() == "0": 0 else: 1
        val body = if pair.len() > 1: pair[1] else: ""
        out.push((body, c))
    out

fn _run_validator_many_default(proof_paths: [text]) -> [(text, i64)]:
    var specs: [text] = []
    for p in proof_paths:
        specs.push(p + "@@SEP@@1280@@SEP@@720")
    _run_validator_many(specs)

fn _run_validator(proof_path: text, width: text, height: text) -> (text, i64):
    val (stdout, _stderr, code) = process_run("node", ["scripts/check/validate-electron-live-smoke-proof.js", proof_path, width, height])
    (stdout, code)

fn _run_validator_in_dir(work_dir: text, proof_name: text, width: text, height: text) -> (text, i64):
    val js = "const path=require('path');const s=path.resolve(process.argv[2]);process.chdir(process.argv[1]);process.argv=[process.argv[0],s,process.argv[3],process.argv[4],process.argv[5]];require(s)"
    val (stdout, _stderr, code) = process_run("node", ["-e", js, work_dir, "scripts/check/validate-electron-live-smoke-proof.js", proof_name, width, height])
    (stdout, code)

fn _create_symlink(target: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').symlinkSync(process.argv[1], process.argv[2])", target, link_path])
    code

fn _create_hardlink(existing_path: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').linkSync(process.argv[1], process.argv[2])", existing_path, link_path])
    code

