"""
## Purpose and audience
Purpose: Prove that simpleos arm64 evidence tooling.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
# @manual: primary
REQ-CHECK-ARM64-EVIDENCE-001
doc/01_research/check/REQ-CHECK-ARM64-EVIDENCE-001.md
doc/03_plan/check/REQ-CHECK-ARM64-EVIDENCE-001.md
doc/04_architecture/check/REQ-CHECK-ARM64-EVIDENCE-001.md
doc/05_design/check/REQ-CHECK-ARM64-EVIDENCE-001.md
"""
# @req: REQ-CHECK-ARM64-EVIDENCE-001


use std.test { expect }
use std.fs as fs

const PRODUCER = "scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs"
const CONSUMER = "scripts/check/check-simpleos-arm64-qmp-input-evidence.shs"

fn source(path: String) -> String {
    fs.read_file(path)
}

fn step_simpleos_platform_evidence() {
    val producer = source(PRODUCER)
    val consumer = source(CONSUMER)

    # Stale manifests and artifacts are invalidated before admission/preflight.
    expect(producer).to_contain("stale-attestation-invalidation-failed")
    expect(producer).to_contain("rm -f \"$BUILD_MANIFEST\" \"$FROZEN_BUILD_MANIFEST\" \"$MANIFEST_TMP\"")
    expect(producer).to_contain("resolve_compiler()")
    expect(producer.find("rm -f \"$BUILD_MANIFEST\" \"$FROZEN_BUILD_MANIFEST\" \"$MANIFEST_TMP\"")).to_be_less_than(producer.find("resolve_compiler()"))

    # A compatible compiler receipt is mandatory and is checked again after build.
    expect(producer).to_contain("compiler-receipt-missing")
    expect(producer).to_contain("simpleos-arm64-compiler-receipt-v1")
    expect(producer).to_contain("POST_COMPILER_RECEIPT_SHA256")
    expect(producer).to_contain("post-build-compiler-receipt-revalidation-failed")
    expect(consumer).to_contain("'schema=simpleos-arm64-compiler-receipt-v1'")
    expect(consumer).to_contain("\"compiler_path=$MANIFEST_COMPILER_PATH\"")
    expect(consumer).to_contain("\"compiler_sha256=$MANIFEST_COMPILER_SHA256\"")
    expect(consumer).to_contain("\"compiler_version=$MANIFEST_COMPILER_VERSION\"")
    expect(consumer).to_contain("'native_smoke_status=pass'")
    expect(consumer).to_contain("'stub_fallback=forbidden'")
    expect(consumer).to_contain("'fabricated_stub_status=none'")
    expect(consumer).to_contain("'measurement_status=measured'")

    # Manifest provenance binds producer, host, build log, and schema.
    expect(producer).to_contain("schema=$MANIFEST_SCHEMA")
    expect(producer).to_contain("producer_script_sha256=$POST_PRODUCER_SCRIPT_SHA256")
    expect(producer).to_contain("host_identity=$HOST_IDENTITY")
    expect(producer).to_contain("build_log_sha256=$BUILD_LOG_SHA256")
    expect(consumer).to_contain("canonical-build-manifest-schema-mismatch")
    expect(consumer).to_contain("canonical-build-manifest-producer-script-sha256-mismatch")
    expect(consumer).to_contain("canonical-build-manifest-host-identity-mismatch")
    expect(consumer).to_contain("canonical-build-manifest-build-log-sha256-mismatch")
    expect(producer).to_contain("[ ! -L \"$KERNEL\" ]")
    expect(producer).to_contain("[ ! -L \"$DISK\" ]")
    expect(consumer).to_contain("[ ! -L \"$KERNEL\" ]")
    expect(consumer).to_contain("[ ! -L \"$DISK\" ]")

    # Producer manifests and consumer evidence are atomically published.
    expect(producer).to_contain("MANIFEST_TMP")
    expect(producer).to_contain("mv \"$MANIFEST_TMP\" \"$BUILD_MANIFEST\"")
    expect(consumer).to_contain("EVIDENCE_ENV_TMP")
    expect(consumer).to_contain("EVIDENCE_REPORT_TMP")
    expect(consumer).to_contain("mv \"$EVIDENCE_ENV_TMP\" \"$EVIDENCE_ENV\"")
    expect(consumer).to_contain("mv \"$EVIDENCE_REPORT_TMP\" \"$EVIDENCE_REPORT\"")
    expect(consumer.find("mv \"$EVIDENCE_REPORT_TMP\" \"$EVIDENCE_REPORT\"")).to_be_less_than(consumer.find("mv \"$EVIDENCE_ENV_TMP\" \"$EVIDENCE_ENV\""))

    # Every injected event must search only serial data after its watermark.
    expect(consumer).to_contain("serial_watermark = len(serial_text())")
    expect(consumer.find("serial_watermark = len(serial_text())")).to_be_less_than(consumer.find("qmp(\"input-send-event\""))
    expect(consumer).to_contain("compiled.search(text, watermark)")
    expect(consumer).to_contain("poll, _ = wait_serial(poll_pattern, 10, serial_watermark)")
    expect(consumer).to_contain("frame, serial = wait_serial(frame_receipt_pattern, 15, serial_watermark)")
    expect(consumer).to_contain("_, serial = wait_serial(commit_receipt_pattern, 15, serial_watermark)")
    expect(consumer).to_contain("commit_for_sequence(serial, seq, serial_watermark)")
    expect(consumer).to_contain("input_serial_watermarks")

    # Guest-owned BGRA checksums must equal the corresponding RAMFB captures.
    expect(consumer).to_contain("def ramfb_checksum(pixels):")
    expect(consumer).to_contain("guest baseline checksum does not equal RAMFB capture")
    expect(consumer).to_contain("guest final checksum does not equal RAMFB capture")
    expect(consumer).to_contain("baseline_commit[\"checksum\"].lower() != before_ramfb_checksum")
    expect(consumer).to_contain("final_commit[\"checksum\"].lower() != after_ramfb_checksum")
    expect(consumer).to_contain("before_ramfb_checksum")
    expect(consumer).to_contain("after_ramfb_checksum")

    # Signals clean up temporary evidence and terminate with signal status.
    expect(producer).to_contain("trap 'on_signal 130' INT")
    expect(producer).to_contain("trap 'on_signal 143' TERM")
    expect(producer).to_contain("cleanup\n    exit \"$signal_code\"")
    expect(consumer).to_contain("trap 'on_signal 130' INT")
    expect(consumer).to_contain("trap 'on_signal 143' TERM")
    expect(consumer).to_contain("exit \"$signal_code\"")

    # Platform boundaries are explicit: these scripts never claim bootstrap or
    # physical-board completion.
    expect(producer).to_contain("bootstrap_status=not-claimed")
    expect(producer).to_contain("physical_board_status=not-claimed")
    expect(consumer).to_contain("arm64_qmp_input_bootstrap_status=not-claimed")
    expect(consumer).to_contain("arm64_qmp_input_physical_board_status=not-claimed")
}

fn main() {
    step_simpleos_platform_evidence()
}
