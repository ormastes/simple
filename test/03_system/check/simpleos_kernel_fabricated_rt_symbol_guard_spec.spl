fn debt_tls() -> [text]:
    # OUTSTANDING: TLS client connect/read/write fabricated. Security-relevant: a guest TLS connect appears to succeed.
    [
        "rt_tls_client_close",
        "rt_tls_client_connect",
        "rt_tls_client_read",
        "rt_tls_client_write"
    ]

fn debt_sync() -> [text]:
    # OUTSTANDING: the remaining barriers/safepoint are inert. ARM64 mutexes
    # have a real single-core cooperative value-cell implementation.
    [
        "rt_load_barrier",
        "rt_pool_safepoint",
        "rt_store_barrier"
    ]

fn debt_core() -> [text]:
    # OUTSTANDING core runtime: rt_free leaks, rt_string_join returns nil, rt_env_get/rt_file_exists always report absent, the flushes drop buffered output. rt_stdout_flush/rt_stderr_flush are strong T aliases at one address -- proof that strong binding is not evidence of a real body.
    [
        "rt_cstring_to_text",
        "rt_dma_bytes_to_array",
        "rt_env_get",
        "rt_file_exists",
        "rt_file_hash_sha256",
        "rt_free",
        "rt_is_interpreter_runtime",
        "rt_log_target_semihost_write_bytes",
        "rt_stderr_flush",
        "rt_stdout_flush",
        "rt_string_join"
    ]

# Weak-bound `rt_*` symbols whose body is REAL. Weak binding here is a
# deliberate override point, not a fabrication -- each body was disassembled
# and confirmed to do real work. They are listed separately from the
# fabricated set on purpose: if any of them ever degrades into a constant
# return it moves into the fabricated set, where it is NOT allowlisted, and
# this spec fails. That is the fail-open this split exists to close.
fn allow_weak_real_bodies() -> [text]:
    [
        "rt_memcpy",
        "rt_memset",
        "rt_dma_alloc",
        "rt_dma_phys_of"
    ]

fn fabrication_allowlist() -> [text]:
    allow_vulkan() + allow_cuda() + allow_metal() + allow_rocm() +
        allow_oneapi() + allow_opencl() + allow_directx() +
        allow_host_gpu_queue() + allow_arm_virtio() +
        debt_sqlite() + debt_opengl() + debt_webgpu() +
        debt_intel_engine2d() + debt_rocm_engine2d() + debt_font() +
        debt_simd() + debt_tls() + debt_sync() + debt_core()

# ---------------------------------------------------------------- helpers

fn tool_available(tool: text) -> bool:
    val result = rt_process_run(tool, ["--version"])
    result.2 == 0

# Collapse runs of whitespace so nm/objdump column padding stops mattering.
fn squeeze(raw: text) -> text:
    var kept: [text] = []
    for part in raw.replace("\t", " ").split(" "):
        if part != "":
            kept = kept.push(part)
    kept.join(" ")

fn membership_blob(names: [text]) -> text:
    " " + names.join(" ") + " "

fn blob_has(blob: text, name: text) -> bool:
    (blob.index_of(" " + name + " ")) >= 0

# Pull the mnemonic out of an `objdump -d` line, which looks like
#   "  8009120:\t55                   \tpush   %rbp"
# Byte-continuation lines have only two tab fields and carry no mnemonic.
fn instruction_of(line: text) -> text:
    val parts = line.split("\t")
    if parts.len() < 3:
        return ""
    squeeze(parts[parts.len() - 1])

# True when the instruction cannot make the function do anything observable:
# frame setup/teardown, stack adjustment, a dead spill of an argument into the
# frame that is never read back, or loading a constant into the return
# register. Anything else -- a call, a branch, a real load, arithmetic on data
# -- means the function does real work.
fn is_inert(ins: text) -> bool:
    if ins == "ret":
        return true
    if ins == "leave":
        return true
    if ((ins == "endbr64") or (ins == "endbr32")):
        return true
    if ins.starts_with("nop"):
        return true
    if ins.starts_with("int3"):
        return true
    if ((ins.starts_with("push %r")) or (ins.starts_with("pop %r"))):
        return true
    if ins == "mov %rsp,%rbp":
        return true
    if ((ins == "xor %eax,%eax") or (ins == "xor %rax,%rax")):
        return true
    if (ins.starts_with("mov $0x") and (ins.ends_with(",%eax") or ins.ends_with(",%rax"))):
        return true
    if (ins.starts_with("movabs $0x") and ins.ends_with(",%rax")):
        return true
    if ((ins.starts_with("sub $0x") or ins.starts_with("add $0x")) and ins.ends_with(",%rsp")):
        return true
    # Dead argument spill: `mov %rdi,-0x8(%rbp)`.
    if (ins.starts_with("mov %") and ins.ends_with("(%rbp)") and ((ins.index_of(",-0x")) >= 0)):
        return true
    false

fn is_constant_return(elf: text, start: i64, size: i64) -> bool:
    val stop = start + size
    val result = rt_process_run("objdump",
        ["-m", OBJDUMP_ARCH, "-d",
         "--start-address=" + start.to_text(),
         "--stop-address=" + stop.to_text(),
         elf])
    if result.2 != 0:
        return false
    var seen = 0
    for line in result.0.split("\n"):
        val ins = instruction_of(line)
        if ins == "":
            continue
        seen = seen + 1
        if not is_inert(ins):
            return false
    # An empty disassembly proves nothing, so never call it fabricated.
    seen > 0

# ---------------------------------------------------------------- the spec

describe "SimpleOS guest kernel fabricated rt_* symbol guard":
    val elf = KERNEL_ELF
    val have_nm: bool = tool_available("nm")
    val have_objdump: bool = tool_available("objdump")
    val have_elf: bool = rt_file_exists(elf)

    if not have_elf:
        skip("rejects any fabricated rt_* symbol outside the allowlist",
            "no prebuilt guest kernel at " + elf +
            " -- build it with scripts/check/check-simpleos-wm-fullscreen-evidence.shs;" +
            " NOT passing by default")
        skip("keeps weak-bound rt_* symbols confined to deliberate override points",
            "no prebuilt guest kernel at " + elf)
    else:
        if ((not have_nm) or (not have_objdump)):
            skip("rejects any fabricated rt_* symbol outside the allowlist",
                "binutils nm/objdump not on PATH -- cannot classify symbol bodies;" +
                " NOT passing by default")
            skip("keeps weak-bound rt_* symbols confined to deliberate override points",
                "binutils nm/objdump not on PATH")
        else:
            # nm -t d prints value and size in decimal, which objdump's
            # --start-address/--stop-address accept directly.
            val nm_result = rt_process_run("nm", ["-S", "-t", "d", elf])
            val allow_fabricated = membership_blob(fabrication_allowlist())
            val allow_weak = membership_blob(allow_weak_real_bodies())

            var inspected = 0
            var fabricated_total = 0
            var new_fabricated: [text] = []
            var new_weak: [text] = []

            for raw_line in nm_result.0.split("\n"):
                val parts = squeeze(raw_line).split(" ")
                # Defined symbols print 4 columns: value size type name.
                # Undefined ones print fewer and are irrelevant here.
                if parts.len() != 4:
                    continue
                val name = parts[3]
                if not name.starts_with("rt_"):
                    continue
                val binding = parts[2]
                val start = parts[0].to_i64() ?? -1
                val size = parts[1].to_i64() ?? -1
                if ((start < 0) or (size <= 0)):
                    continue

                var fabricated: bool = false
                if size <= MAX_FABRICATED_BODY_BYTES:
                    inspected = inspected + 1
                    fabricated = is_constant_return(elf, start, size)

                if fabricated:
                    fabricated_total = fabricated_total + 1
                    if not blob_has(allow_fabricated, name):
                        new_fabricated = new_fabricated.push(name)
                else:
                    if binding == "W":
                        if not blob_has(allow_weak, name):
                            new_weak = new_weak.push(name)

            it "proves it actually inspected the kernel image":
                # Without this the two assertions below could pass on an empty
                # symbol table -- the same do-nothing pass this spec exists to
                # forbid.
                print "    audited image: {elf}"
                print "    rt_* bodies disassembled: {inspected}, fabricated: {fabricated_total}"
                expect(nm_result.2).to_equal(0)
                expect(inspected).to_be_greater_than(0)
                expect(fabricated_total).to_be_greater_than(0)

            it "rejects any fabricated rt_* symbol outside the allowlist":
                # Subset assertion, never a count: a NEW fabrication fails here
                # while a fixed one can be deleted from the allowlist alone.
                expect(new_fabricated.join(" ")).to_equal("")

            it "keeps weak-bound rt_* symbols confined to deliberate override points":
                expect(new_weak.join(" ")).to_equal("")
