    ]

fn debt_simd() -> [text]:
    # OUTSTANDING: SIMD capability probes report false and the NEON hit counter reports 0. Adjacent to the rt_engine2d_simd_* blitters that caused the blank screen -- do NOT collapse these into an rt_simd_ prefix rule.
    [
        "rt_gui_simd_fill_enabled",
        "rt_simd_engine2d_neon_hits",
        "rt_simd_has_avx2",
        "rt_simd_has_neon",
        "rt_simd_has_rvv",
