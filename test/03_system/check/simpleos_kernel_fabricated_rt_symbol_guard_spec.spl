# Guard: a SimpleOS guest kernel must contain no NEW fabricated `rt_*` symbol.
#
# WHY THIS EXISTS
#   The freestanding SimpleOS link binds any `rt_*` symbol that has no real
#   baremetal implementation to a fabricated body that just returns a constant
#   -- `xor %eax,%eax; ret` (zero) or `mov $0x3,%eax; ret` (the runtime's nil
#   tag). There is no link error and no runtime diagnostic. The guest then
#   reads 0/empty far downstream of the cause and presents as a mysterious hang
#   or a blank screen rather than as an error.
#
#   Damage already found and fixed this way: `rt_array_copy` made every
#   array-typed variable read return empty; three `rt_engine2d_simd_*` blitters
#   made every framebuffer span write a no-op (a blank screen); the memory
#   barriers were absent so drivers had no MMIO ordering; every u32 array
#   element read 0; a clock returned a constant. Until this spec there was NO
#   test that caught a new instance.
#
# WHAT IT CHECKS
#   Every defined `rt_*` symbol in the kernel image is classified from its
#   actual machine code. A symbol is FABRICATED when its whole body is a
#   constant return: after the frame prologue/epilogue and dead argument
#   spills, nothing remains but `xor %eax,%eax` or `mov $imm,%eax` (or nothing
#   at all). Binding is irrelevant to this test -- `rt_stdout_flush`,
#   `rt_stderr_flush` and `rt_pool_safepoint` are strong `T` symbols whose
#   bodies are exactly that, and they are just as dangerous as the weak ones.
#   Separately, weak-bound `rt_*` symbols are reported, because weak binding is
#   the mechanism by which a fabricated body gets substituted at link time.
#
#   Both found sets are asserted to be a SUBSET of an allowlist. A subset check
#   (not a count) means a NEW fabrication fails immediately while known ones can
#   be retired from the list one at a time.
#
# WHY THE ALLOWLIST IS BY EXACT NAME
#   A prefix allowlist is itself a fail-open mechanism. An `rt_simd_*` prefix
#   rule nearly hid `rt_engine2d_simd_*` -- the real framebuffer span blitters,
#   where nil means a blank screen. `rt_engine2d_rocm_*` is likewise NOT
#   covered by an `rt_rocm_` prefix. Every entry below is spelled out in full.
#
# HONESTY
#   This spec needs a prebuilt kernel ELF and binutils. When either is missing
#   it SKIPS with the reason. It never passes by doing nothing -- a test that
#   passes because it did nothing is precisely the bug class being eliminated.

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_file_exists(path: text) -> bool


use std.spec.{describe, it, expect, skip}

# The x86_64 guest kernel produced by scripts/check/check-simpleos-wm-fullscreen-evidence.shs.
# The allowlists below are the measured baseline of THIS image, so the path is
# pinned rather than configurable. To audit a different image, edit this
# constant and re-baseline. (An env-var override was tried first and removed:
# rt_env_get does not see the caller's environment under `simple test`, so the
# knob silently audited the default image anyway -- a fail-open of exactly the
# kind this spec exists to prevent.)
val KERNEL_ELF: text = "build/simpleos_wm_fullscreen_evidence/simpleos_wm_production_desktop.elf"

# The image is an ELF32 container holding x86-64 code, so objdump's autodetect
# picks 32-bit and mis-decodes every REX prefix (each 0x48 becomes `dec %eax`).
# Force the real architecture. Change this when re-baselining on a non-x86 image.
val OBJDUMP_ARCH: text = "i386:x86-64"

# A pure constant-return body cannot exceed ~37 bytes: 4 (prologue) + 1 (push)
# + 24 (six 4-byte register spills) + 5 (mov $imm,%eax) + 4 (add $imm,%rsp)
# + 1 (pop) + 1 (ret). 48 is that bound with margin. Anything larger is doing
# real work and is skipped without disassembly, purely to keep the spec fast.
val MAX_FABRICATED_BODY_BYTES: i64 = 48

fn allow_vulkan() -> [text]:
    # Host Vulkan ICD shims. A freestanding guest has no Vulkan loader, driver or WSI; nothing on the guest display path calls these -- the guest renders through Engine2D span blitters, not Vulkan.
    [
        "rt_vulkan_alloc_buffer",
        "rt_vulkan_begin_compute",
        "rt_vulkan_bind_buffer",
        "rt_vulkan_bind_descriptors",
        "rt_vulkan_bind_pipeline",
        "rt_vulkan_compile_glsl",
        "rt_vulkan_compile_spirv",
        "rt_vulkan_compile_spirv_raw",
        "rt_vulkan_copy_from_buffer_raw",
        "rt_vulkan_copy_to_buffer",
        "rt_vulkan_copy_to_buffer_raw",
        "rt_vulkan_create_compute_pipeline",
        "rt_vulkan_create_descriptor_set",
        "rt_vulkan_dependency_quarantine_lock",
        "rt_vulkan_dependency_quarantine_unlock",
        "rt_vulkan_destroy_descriptor_set",
        "rt_vulkan_destroy_fence",
        "rt_vulkan_destroy_pipeline",
        "rt_vulkan_destroy_shader",
        "rt_vulkan_device_count",
        "rt_vulkan_device_driver_identity",
        "rt_vulkan_device_name",
        "rt_vulkan_device_type",
        "rt_vulkan_discard_command",
        "rt_vulkan_dispatch",
        "rt_vulkan_end_compute",
        "rt_vulkan_fence_submission_supported",
        "rt_vulkan_free_buffer",
        "rt_vulkan_get_device",
        "rt_vulkan_get_last_error",
        "rt_vulkan_init",
        "rt_vulkan_is_available",
        "rt_vulkan_push_constants",
        "rt_vulkan_push_constants_raw",
        "rt_vulkan_read_buffer_bytes",
        "rt_vulkan_select_device",
        "rt_vulkan_submit_and_wait_fence",
        "rt_vulkan_wait_fence",
        "rt_vulkan_wait_idle"
    ]

fn allow_cuda() -> [text]:
    # Host CUDA driver-API shims. No NVIDIA driver exists in the guest; every guest GPU path checks rt_cuda_available() first, which inertly reports "unavailable".
    [
