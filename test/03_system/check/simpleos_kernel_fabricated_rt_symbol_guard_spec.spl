fn allow_arm_virtio() -> [text]:
    # aarch64 virtio-blk MMIO shims. This is the x86_64 guest kernel; the aarch64 transport is not wired here. NOTE: these become correctness-class the moment an aarch64 guest is built -- retire them from this list then.
    # MUST stay identical to the exact-name `rt_arm_virtio_blk_*` arm in
    # `simpleos_rt_symbol_is_optional_backend`
    # (src/compiler/70.backend/backend/llvm_native_link.spl). Both lists are the
    # MMIO transport / capability probes ONLY. The sector data path
    # (_dma_base, _prepare_read, _read_sector_direct, _sector_bytes, _status_u8,
    # _wait_completion, _read_prefix, _read_hello_smf) is deliberately absent
    # from both: `virtio_blk_arm_read_sector_bytes` reads status 0 as SUCCESS
    # (VIRTIO_BLK_S_OK), so a zero-returning fake reports a successful read of
    # an empty buffer and FAT32 metadata mis-parses silently. Never add one of
    # those here to make a build pass -- define the symbol instead.
    # doc/08_tracking/bug/rt_arm_virtio_blk_prefix_allowlist_defeats_fabrication_guard_2026-07-28.md
    [
        "rt_arm_virtio_blk_configure_queue",
        "rt_arm_virtio_blk_mmio_read_u32",
        "rt_arm_virtio_blk_mmio_read_u64",
        "rt_arm_virtio_blk_mmio_write_u32",
        "rt_arm_virtio_blk_queue_base",
        "rt_arm_virtio_blk_set_mmio_base"
    ]

