fn debt_font() -> [text]:
    # OUTSTANDING and high risk: glyph lookup, metrics and bitmaps all fabricated -- guest text renders as nothing. Sibling class to the rt_engine2d_simd_* blank-screen bug already fixed.
    [
        "rt_font_bitmap_free",
        "rt_font_bitmap_get_pixel",
        "rt_font_bitmap_height",
        "rt_font_bitmap_width",
        "rt_font_bitmap_xoff",
