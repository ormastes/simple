use std.io.{file_read}
use std.spec.{describe, it, expect}

val PRODUCER = "scripts/check/build-core-c-bootstrap-runtime-capsule.shs"

fn expect_core_c_io_providers(source: text):
    val prefix = "CORE_IO_SYMBOLS=\""
    expect(source).to_contain(prefix)
    val declared = source.split(prefix)[1].split("\"")[0].split(" ")
    val expected = ["rt_file_copy", "rt_file_rename", "rt_file_hash_sha256",
        "rt_process_exists", "rt_dir_list", "rt_dir_remove"]
    expect(declared).to_equal(expected)
    expect(source).to_contain("nm_has_text_symbol \"$TMP_DIR/archive.nm.txt\" \"$symbol\"")
    expect(source).to_contain("nm_has_text_symbol \"$TMP_DIR/runtime_native.nm.txt\" \"$symbol\"")
    expect(source).to_contain("die \"archive-$symbol-provider-missing\"")
    expect(source).to_contain("die \"runtime-native-$symbol-provider-missing\"")
    expect(source).to_contain("require_unique_text_provider \"$symbol\" runtime_native.o")
    expect(source).to_contain("printf '%s\\n' \"$symbol\"_archive_symbol=T")
    expect(source).to_contain("printf '%s\\n' \"$symbol\"_provider=runtime_native.o")

describe "direct core-C bootstrap runtime capsule producer":
    it "uses the canonical ordered core-C source graph":
        val source = file_read(PRODUCER)
        for input in [
            "runtime_native.c",
            "runtime_contracts.c",
            "runtime_framebuffer.c",
            "runtime_directx_core.c",
            "runtime_legacy_core.c",
            "runtime_mcp_core.c",
            "runtime_fork.c",
            "runtime_memtrack.c",
            "runtime_process.c",
            "runtime_font.c",
            "runtime_pool.c",
            "runtime_simd_utf8.c",
            "runtime_simd_dispatch.c"
        ]:
            expect(source).to_contain(input)
        expect(source).to_contain("hosted_cocoa.c")
        expect(source).to_contain("hosted_win32.c")
        expect(source).to_contain("platform/platform_macos.h")
        expect(source).to_contain("platform/unix_common.h")
        expect(source).to_contain("stb_truetype.h")
        expect(source.contains("runtime_https_openssl_core.c")).to_equal(false)

    it "builds a deterministic archive without a language compiler lane":
        val source = file_read(PRODUCER)
        expect(source).to_contain("\"$CC_PATH\" $COMMON_FLAGS $TARGET_FLAGS")
        expect(source).to_contain("\"$AR_PATH\" rcsD \"$ARCHIVE\"")
        expect(source).to_contain("ZERO_AR_DATE=1 \"$AR_PATH\" rcs \"$ARCHIVE\"")
        expect(source).to_contain("-MMD -MF \"$depfile\"")
        expect(source).to_contain("for declared_input in $SOURCE_FILES $HEADER_FILES")
        expect(source).to_contain("repeat-compile-failed")
        expect(source).to_contain("repeat-build-archive-mismatch")
        expect(source).to_contain("-DSIMPLE_CORE_C_STANDALONE=1")
        expect(source).to_contain("-mno-outline-atomics")
        expect(source.contains("bin/" + "simple")).to_equal(false)
        expect(source.contains("native-" + "build")).to_equal(false)
        expect(source.contains("car" + "go")).to_equal(false)
        expect(source.contains("SIMPLE_ALLOW_" + "FREESTANDING_STUBS")).to_equal(false)

    it "fails closed on dirty input and existing output":
        val source = file_read(PRODUCER)
        expect(source).to_contain("git status --porcelain --untracked-files=all")
        expect(source).to_contain("runtime-source-dirty")
        expect(source).to_contain("output-already-exists")
        expect(source).to_contain("missing-runtime-input")
        expect(source).to_contain("archive-empty")

    it "requires the contract ABI from the canonical runtime-contracts provider":
        val producer = file_read(PRODUCER)
        val runtime = file_read("src/runtime/runtime_contracts.c")
        val header = file_read("src/runtime/runtime.h")
        for symbol in ["simple_contract_check", "simple_contract_check_msg"]:
            expect(runtime).to_contain("void {symbol}(")
            expect(header).to_contain("void     {symbol}(")
            expect(producer).to_contain("{symbol}_archive_symbol=T")
            expect(producer).to_contain("{symbol}_provider=runtime_contracts.o")

    it "requires the six frozen core I/O providers from runtime-native":
        val producer = file_read(PRODUCER)
        val verifier = file_read(
            "scripts/check/build-stage2-font-scoped-tools.shs"
        )
        expect_core_c_io_providers(producer)
        expect(producer).to_contain(
            "require_unique_text_provider rt_file_create_excl runtime_legacy_core.o"
        )
        expect(verifier).to_contain(
            "\"T runtime_legacy_core.o\""
        )
        expect(verifier).to_contain(
            "rt_file_create_excl.providers.txt"
        )

    it "guards recursive removal and self-checks core I/O behavior":
        val runtime = file_read("src/runtime/runtime_native.c")
        val selfcheck = file_read(
            "src/runtime/test/rt_string_free_selfcheck.c"
        )
        val remove_provider = runtime.split("int8_t rt_dir_remove(")[1]
            .split("int8_t rt_process_exists(")[0]

        val before_canonical = remove_provider.split("realpath(path")[0]
        expect(before_canonical).to_contain("lstat(path")
        expect(before_canonical).to_contain("!S_ISDIR")
        for guard in [
            "realpath(path",
            "realpath(home",
            "home && !canonical_home",
            "protected_paths",
            "components <= 2",
            "strcmp(canonical, canonical_home)",
            "rt_dir_remove_all(canonical)"
        ]:
            expect(remove_provider).to_contain(guard)

        val windows_scope = remove_provider.split("#if defined(_WIN32)")[1]
            .split("#else")[0]
        expect(windows_scope).to_contain("reparse-aware canonical path guards")
        expect(windows_scope).to_contain("ok = 0")
        expect(windows_scope.contains("rt_dir_remove_all")).to_equal(false)

        for refusal in [
            "setenv(\"HOME\", root",
            "recursive directory remove refuses HOME",
            "symlink(root, alias)",
            "recursive directory remove refuses top-level symlink",
            "symlink refusal leaves target directory intact"
        ]:
            expect(selfcheck).to_contain(refusal)
        for behavior in [
            "file copy provider succeeds",
            "file hash provider matches SHA-256 of abc",
            "directory list provider returns fixture entries",
            "nonrecursive directory remove succeeds",
            "recursive directory remove succeeds",
            "current process exists"
        ]:
            expect(selfcheck).to_contain(behavior)

    it "attests immutable inputs tools archive provider and self-check":
        val source = file_read(PRODUCER)
        for field in [
            "schema=core-c-bootstrap-runtime-capsule-v1",
            "head_revision=",
            "runtime_tree=",
            "cc_path=",
            "cc_binary_sha256=",
            "cc_version_sha256=",
            "ar_path=",
            "ar_binary_sha256=",
            "ar_version_sha256=",
            "nm_binary_sha256=",
            "nm_version_sha256=",
            "common_flags=",
            "target_flags=",
            "archive_mode=",
            "source_list_sha256=",
            "header_list_sha256=",
            "local_input_list_sha256=",
            "archive_sha256=",
            "repeat_archive_sha256=",
            "repeated_build_equal=true",
            "repeated_build_receipt_sha256=",
            "archive_members_sha256=",
            "producer_script_sha256="
        ]:
            expect(source).to_contain(field)
        expect(source).to_contain("rt_string_free_archive_symbol=T")
        expect(source).to_contain("rt_string_free_provider=runtime_native.o")
        expect(source).to_contain("require_unique_text_provider()")
        expect(source).to_contain("require_unique_text_provider rt_string_free runtime_native.o")
        expect(source).to_contain("(type == \"T\" || type == \"W\") && symbol == expected")
        expect(source).to_contain("print type, member")
        expect(source).to_contain("\"T $unique_expected_provider\"")
        expect(source).to_contain("die \"$unique_reason-provider-count\"")
        expect(source).to_contain("die \"$unique_reason-provider-not-$unique_expected_reason\"")
        expect(source).to_contain("NF >= 3")
        expect(source).to_contain("rt_string_free_selfcheck=pass")
        expect(source).to_contain("rt_string_free_selfcheck.c")
        expect(source).to_contain("SELFCHECK PASSED (0 failures)")
