use std.io.{file_read}
use std.spec.{describe, it, expect}

val PROBE = "test/02_integration/rendering/macos_vulkan_provider_micro_probe.spl"
val CHECKER = "scripts/check/check-macos-vulkan-provider-micro-probe.shs"

describe "macOS Vulkan provider micro probe":
    it "stays below Engine2D and resolves the exact provider aliases":
        val probe = file_read(PROBE)
        expect(probe).to_contain("DynLib.open(provider_path)")
        expect(probe).to_contain("rt_vulkan_provider_is_available")
        expect(probe).to_contain("rt_vulkan_provider_device_count")
        expect(probe).to_contain("rt_vulkan_get_last_error")
        expect(probe).to_contain("rt_cstring_to_text(error_pointer)")
        expect(probe).to_contain("vulkan_provider_probe_provider_error=")
        expect(probe.contains("Engine2D")).to_equal(false)
        expect(probe.contains("VulkanBackend")).to_equal(false)
        expect(probe.contains("winit")).to_equal(false)

    it "uses the canonical self-hosted compiler and records dyld resolution":
        val checker = file_read(CHECKER)
        expect(checker).to_contain("bin/release/aarch64-apple-darwin-macho/simple")
        expect(checker).to_contain("SIMPLE_NO_STUB_FALLBACK=1")
        expect(checker).to_contain("--runtime-bundle core-c-bootstrap")
        expect(checker).to_contain("DYLD_PRINT_LIBRARIES=1")
        expect(checker).to_contain("vulkan_provider_probe_dyld_resolution_status=")
        expect(checker).to_contain("VULKAN_PROVIDER_DYLIB")
        expect(checker).to_contain("VULKAN_PROVIDER_PROBE_COMPILER")
        expect(checker).to_contain("*compiler_rust/target/*) return 1")
        expect(checker.contains("src/compiler_rust/target/bootstrap/simple")).to_equal(false)
        expect(checker.contains("check-macos-vulkan-2d-live-evidence.shs")).to_equal(false)
