use std.io.{file_read}
use std.spec.{describe, it, expect}

val PROBE = "test/02_integration/rendering/macos_vulkan_provider_micro_probe.spl"
val CHECKER = "scripts/check/check-macos-vulkan-provider-micro-probe.shs"
val ADMISSION = "scripts/check/lib/macos-gpu-trusted-build-admission.shs"
val BUILDER = "scripts/check/build-macos-gpu-2d-live-native.shs"

describe "macOS Vulkan provider micro probe":
    it "stays below Engine2D and resolves the exact provider aliases":
        val probe = file_read(PROBE)
        expect(probe).to_contain("DynLib.open(provider_path)")
        expect(probe).to_contain("rt_vulkan_provider_is_available")
        expect(probe).to_contain("rt_vulkan_provider_device_count")
        expect(probe).to_contain("rt_vulkan_get_last_error")
        expect(probe.contains("rt_cstring_to_text")).to_equal(false)
        expect(probe).to_contain("vulkan_provider_probe_provider_error_abi=blocked")
        expect(probe).to_contain("if is_available == 0:")
        expect(probe).to_contain("if initialized == 0:")
        expect(probe).to_contain("val device_count = provider.call0")
        expect(probe.contains("Engine2D")).to_equal(false)
        expect(probe.contains("VulkanBackend")).to_equal(false)
        expect(probe.contains("winit")).to_equal(false)

    it "uses the canonical self-hosted compiler and records dyld resolution":
        val checker = file_read(CHECKER)
        val admission = file_read(ADMISSION)
        val builder = file_read(BUILDER)
        expect(checker).to_contain("macos_gpu_trusted_manifest_admit")
        expect(checker).to_contain("MACOS_GPU_ADMISSION_COMPILER")
        expect(checker).to_contain("MACOS_GPU_ADMISSION_PROVIDER")
        expect(checker).to_contain("SIMPLE_NO_STUB_FALLBACK=1")
        expect(checker).to_contain("--runtime-bundle core-c-bootstrap")
        expect(checker).to_contain("DYLD_PRINT_LIBRARIES=1")
        expect(checker).to_contain("vulkan_provider_probe_dyld_resolution_status=")
        expect(checker.contains("VULKAN_PROVIDER_DYLIB")).to_equal(false)
        expect(checker.contains("VULKAN_PROVIDER_PROBE_COMPILER")).to_equal(false)
        expect(checker.contains("VULKAN_PROVIDER_PROBE_COMPILER_MANIFEST")).to_equal(false)
        expect(checker).to_contain("verify_compiler_provenance")
        expect(builder).to_contain("COMPILER_IDENTITY=\"canonical-pure-simple-stage3-with-bound-backfill-v1\"")
        expect(builder).to_contain("build_compiler_source_kind=canonical-pure-simple-bootstrap-stage3")
        expect(admission).to_contain("build-macos-gpu-2d-live-native.shs")
        expect(admission).to_contain("--verify \"$macos_gpu_admission_backend\"")
        expect(admission).to_contain("source_input_file_count")
        expect(admission).to_contain("source_input_fingerprint")
        expect(admission).to_contain("repo_revision")
        expect(admission).to_contain("repo_fingerprint")
        expect(builder).to_contain("build_args_sha256")
        expect(builder).to_contain("build_environment_sha256")
        expect(admission).to_contain("compiler_abs_path")
        expect(admission).to_contain("compiler_sha256")
        expect(admission).to_contain("[ -x \"$MACOS_GPU_ADMISSION_COMPILER\" ]")
        expect(admission).to_contain("[ ! -L \"$MACOS_GPU_ADMISSION_COMPILER\" ]")
        expect(admission).to_contain("grep -Fqx")
        expect(admission).to_contain("WARNING: this Rust-built Simple binary is a bootstrap seed only")
        expect(admission.contains("Rust-built|bootstrap seed only|debug build")).to_equal(false)
        expect(checker).to_contain("provider-init-symbol-missing")
        expect(checker).to_contain("provider-shutdown-symbol-missing")
        expect(checker).to_contain("vulkan_provider_probe_native_build_log_sha256=")
        expect(checker).to_contain("vulkan_provider_probe_native_build_command=")
        expect(checker).to_contain("bounded_native_build_log")
        expect(checker).to_contain("NATIVE_LOG_MAX_BYTES=8256")
        expect(checker).to_contain("native-build-log-unbounded")
        expect(checker).to_contain("my ($head, $tail, $full, $total)")
        expect(checker).to_contain("if ($total <= $head_max + $tail_max)")
        expect(checker).to_contain("printf '%s")
        expect(checker.contains("printf '%s\\\\n'")).to_equal(false)
        expect(checker).to_contain("omitted ")
        expect(checker).to_contain("probe-output-schema-invalid-or-unbounded")
        expect(checker.contains(">\"$NATIVE_LOG\" 2>&1")).to_equal(false)
        expect(checker.contains("cat \"$RAW_STDOUT\"")).to_equal(false)
        expect(checker.contains("src/compiler_rust/target/bootstrap/simple")).to_equal(false)
        expect(checker.contains("check-macos-vulkan-2d-live-evidence.shs")).to_equal(false)
