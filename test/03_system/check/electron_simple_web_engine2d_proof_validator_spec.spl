# @cover scripts/check/check-electron-simple-web-engine2d-bitmap-evidence.shs 80%
"""
## Purpose and audience
Purpose: accepts complete Electron Engine2D timing capture and exact checksum proof
Audience: compiler and tooling engineers who maintain this spec

# Electron Simple Web Engine2D proof validator

## Overview

Validates the Electron Engine2D proof validator (`validate-electron-simple-web-engine2d-proof.js`)
which checks captured ARGB evidence, GPU compositing/rasterization feature
status, Chromium runtime identity, exact checksums, and frame timing budgets
before the live Electron Engine2D wrapper emits `pass` or `divergent`.

**Plan:** doc/03_plan/ui/tui/production_gui_web_renderer_parity_hardening.md
**Requirements:** N/A
**Research:** N/A
**Design:** doc/07_guide/tooling/renderdoc_capture_infra.md

## Syntax

```sh
SIMPLE_LIB=src bin/simple test test/03_system/check/electron_simple_web_engine2d_proof_validator_spec.spl --mode=interpreter --clean --fail-fast
```

## Acceptance

- Complete Electron Engine2D proof JSON + ARGB artifact is accepted and emits
  normalized `electron_simple_web_engine2d_*` rows.
- Unexpected renderer, proof-source, or scene identity is rejected fail-closed.
- Missing, hardlinked, non-regular, or markerless proof-source artifacts fail
  closed.
- Missing capture backend, compositor mode, Chromium runtime identity, or GPU
  feature status rows fail closed.
- Missing, empty, symlinked, hardlinked, self-referencing, stale-cwd, malformed,
  nonblank/blank, stringified, or checksum-mismatched ARGB captures fail closed.
- Malformed, implausible, or stringified timing/iteration/boolean fields fail
  closed without coercion.

## Operator workflow

Run each scenario through the runner's `test` command. Rejection scenarios build
a proof JSON under `build/test-electron-engine2d-validator-*`, invoke
`scripts/check/validate-electron-simple-web-engine2d-proof.js`, and assert on
the normalized rows plus the validator exit code.

## Compatibility and limitations

The scenarios require `node` on PATH and the validator script plus the live
capture fixture `tools/electron-live-bitmap/exact_fixture.js` in the repo. Only
the exact normalized `electron_simple_web_engine2d_*` rows are pinned, not the
full validator output.

## Verification guidance and troubleshooting

A failed acceptance scenario means the validator rejects a complete proof;
inspect the validator output for the offending reason row. A failed rejection
scenario means the validator accepted a malformed proof — treat that as a
fail-open defect; never soften the mutated fixture.
"""

# Lifecycle: doc/01_research/domain/chromium_web_renderer_primitive_differential.md ;
# doc/03_plan/ui/tui/production_gui_web_renderer_parity_hardening.md ;
# doc/04_architecture/chromium_web_renderer_primitive_differential.md ;
# doc/05_design/browser_wasm_webgpu_infra.md

# @tag: system, gui, electron, engine2d, renderer, capture, performance

use std.io_runtime.{dir_create_all, dir_remove_all, file_copy, file_delete, file_exists, file_read, file_write_exact, process_run}
use std.spec.*

struct KV:
    key: text
    value: text

fn _kv(key: text, value: text) -> KV:
    KV(key: key, value: value)

fn _repeat_csv(elem: text, count: i64) -> text:
    if count <= 0:
        return ""
    var result = ""
    var block = elem
    var remaining = count
    while remaining > 0:
        if remaining % 2 == 1:
            if result == "":
                result = block
            else:
                result = result + "," + block
        remaining = remaining / 2
        if remaining > 0:
            block = block + "," + block
    result

fn _argb_json(width_json: text, height_json: text, producer: text, pixel_val: text, pixel_count: i64) -> text:
    "{{\"width\":" + width_json + ",\"height\":" + height_json + ",\"format\":\"argb-u32\",\"producer\":\"" + producer + "\",\"pixels\":[" + _repeat_csv(pixel_val, pixel_count) + "]}}"

fn _ensure_templates():
    val tmpl = "build/.tmp_electron_engine2d_default_argb.json"
    val tmpl_wt = "build/.tmp_electron_engine2d_cap_wt.json"
    if not file_exists(tmpl) or not file_exists(tmpl_wt):
        expect(dir_create_all("build")).to_equal(true)
        val raw = "const fs=require('fs');const w=(p,o)=>fs.writeFileSync(p,JSON.stringify(o));const fill=(v,n)=>Array(n).fill(v);const mk=(h,px)=>(__LB__width:96,height:h,format:'argb-u32',producer:'electron-live-capture-page',pixels:px__RB__);w('build/.tmp_electron_engine2d_default_argb.json',mk(64,fill(4294967295,96*64)));w('build/.tmp_electron_engine2d_cap_h63.json',mk(63,fill(4294967295,96*63)));w('build/.tmp_electron_engine2d_cap_strp.json',mk(64,fill('4294967295',96*64)));w('build/.tmp_electron_engine2d_cap_frac.json',mk(64,fill(1.5,96*64)));w('build/.tmp_electron_engine2d_cap_range.json',mk(64,fill(4294967296,96*64)));w('build/.tmp_electron_engine2d_cap_blank.json',mk(64,fill(0,96*64)));w('build/.tmp_electron_engine2d_cap_hstr.json',mk('64',fill(4294967295,96*64)));const cp=fill(4294967295,96*64);cp[0]=4294967294;w('build/.tmp_electron_engine2d_cap_corr.json',mk(64,cp));const wp=fill(1,96*64);wp[0]=2;wp[1]=0;w('build/.tmp_electron_engine2d_cap_wt.json',mk(64,wp));"
        val js = raw.replace("__LB__", "{{").replace("__RB__", "}}")
        val (_out, _err, code) = process_run("node", ["-e", js])
        expect(code).to_equal(0)

fn _write_default_argb(dir: text):
    _ensure_templates()
    expect(file_copy("build/.tmp_electron_engine2d_default_argb.json", dir + "/captured.json")).to_equal(true)

fn _prepare_dir(root: text, with_argb: bool):
    val _removed = dir_remove_all(root)
    expect(dir_create_all(root)).to_equal(true)
    if with_argb:
        _write_default_argb(root)

fn _find_override(overrides: [KV], key: text) -> text:
    for item in overrides:
        if item.key == key:
            return item.value
    "__DEFAULT__"

fn _text_in(xs: [text], target: text) -> bool:
    for x in xs:
        if x == target:
            return true
    false

fn _write_proof(proof_path: text, overrides: [KV]):
    val n_ov = overrides.len()
    if n_ov == 0:
        val out = "{{\"renderer\":\"electron-live-capture-page\",\"proof_source\":\"tools/electron-live-bitmap/exact_fixture.js\",\"capture_backend\":\"electron-offscreen-capture-page\",\"compositor_mode\":\"offscreen-osr-exact-srgb\",\"browser_engine\":\"chromium\",\"electron_user_agent\":\"Mozilla/5.0 Chrome/142.0.0.0 Electron/42.5.0 Safari/537.36\",\"electron_process_version\":\"42.5.0\",\"chrome_process_version\":\"142.0.0.0\",\"gpu_feature_status\":{{\"gpu_compositing\":\"disabled_software\",\"rasterization\":\"disabled_software\"}},\"gpu_compositing\":\"disabled_software\",\"gpu_rasterization\":\"disabled_software\",\"scene\":\"simple-web-engine2d-image-taskbar-command\",\"width\":96,\"height\":64,\"iterations\":5,\"checksum\":\"26388279060480\",\"expected_checksum\":\"26388279060480\",\"weighted_checksum\":\"81077987413324800\",\"expected_weighted_checksum\":\"81077987413324800\",\"mismatch_count\":0,\"frame_us\":1250,\"capture_native_width\":96,\"capture_native_height\":64,\"capture_downsampled\":false,\"captured_argb_path\":\"captured.json\",\"captured_argb_written\":true,\"blur_or_tolerance_used\":false}}"
        expect(file_write_exact(proof_path, out)).to_equal(true)
        return
    val defaults = [
        "renderer", "\"electron-live-capture-page\"",
        "proof_source", "\"tools/electron-live-bitmap/exact_fixture.js\"",
        "capture_backend", "\"electron-offscreen-capture-page\"",
        "compositor_mode", "\"offscreen-osr-exact-srgb\"",
        "browser_engine", "\"chromium\"",
        "electron_user_agent", "\"Mozilla/5.0 Chrome/142.0.0.0 Electron/42.5.0 Safari/537.36\"",
        "electron_process_version", "\"42.5.0\"",
        "chrome_process_version", "\"142.0.0.0\"",
        "gpu_feature_status", "{{\"gpu_compositing\":\"disabled_software\",\"rasterization\":\"disabled_software\"}}",
        "gpu_compositing", "\"disabled_software\"",
        "gpu_rasterization", "\"disabled_software\"",
        "scene", "\"simple-web-engine2d-image-taskbar-command\"",
        "width", "96",
        "height", "64",
        "iterations", "5",
        "checksum", "\"26388279060480\"",
        "expected_checksum", "\"26388279060480\"",
        "weighted_checksum", "\"81077987413324800\"",
        "expected_weighted_checksum", "\"81077987413324800\"",
        "mismatch_count", "0",
        "frame_us", "1250",
        "capture_native_width", "96",
        "capture_native_height", "64",
        "capture_downsampled", "false",
        "captured_argb_path", "\"captured.json\"",
        "captured_argb_written", "true",
        "blur_or_tolerance_used", "false"
    ]
    var parts: [text] = []
    var seen_ov: [text] = []
    val n_def = defaults.len()
    var i = 0
    if n_ov == 1:
        val k0 = overrides[0].key
        val v0 = overrides[0].value
        while i < n_def:
            val dk = defaults[i]
            if dk == k0:
                seen_ov.push(dk)
                if v0 != "__OMIT__":
                    parts.push("\"" + dk + "\":" + v0)
            else:
                parts.push("\"" + dk + "\":" + defaults[i + 1])
            i = i + 2
    else:
        while i < n_def:
            val dk = defaults[i]
            val ov = _find_override(overrides, dk)
            if ov != "__DEFAULT__":
                seen_ov.push(dk)
            if ov != "__OMIT__":
                val value = if ov == "__DEFAULT__": defaults[i + 1] else: ov
                parts.push("\"" + dk + "\":" + value)
            i = i + 2
    for extra in overrides:
        if extra.value != "__OMIT__" and not _text_in(seen_ov, extra.key):
            parts.push("\"" + extra.key + "\":" + extra.value)
    expect(file_write_exact(proof_path, "{{" + parts.join(",") + "}}")).to_equal(true)

fn _ensure_batch_runner() -> text:
    val runner = "build/.tmp_val_batch_runner.js"
    if not file_exists(runner):
        expect(dir_create_all("build")).to_equal(true)
        val raw = "const fs=require('fs'),path=require('path'),Module=require('module');const script=path.resolve(process.argv[2]);const origCwd=process.cwd();const src=fs.readFileSync(script,'utf8').replace(/^#![^\\n]*\\n/,'');const fn=new Function('require','process','console','__filename','__dirname',src);const req=Module.createRequire(script);const results=[];for(const raw of process.argv.slice(3))__LB__ const parts=raw.split('@@SEP@@');const workDir=parts[0];const envSpec=parts[1];const args=parts.slice(2);let out='';let code=0;const fakeEnv=Object.assign(__LB____RB__,process.env);if(envSpec)for(const kv of envSpec.split(';'))__LB__ const eq=kv.indexOf('=');if(eq>0)__LB__ const k=kv.slice(0,eq),v=kv.slice(eq+1);if(v)fakeEnv[k]=v;else delete fakeEnv[k];__RB__ __RB__;const fakeProc=Object.create(process);fakeProc.env=fakeEnv;fakeProc.argv=[process.execPath,script,...args];fakeProc.exit=(c=0)=>__LB__ code=c;throw __LB____exit:true__RB__;__RB__;const fakeCon=__LB__ log:(...a)=>__LB__ out+=a.map(String).join(' ')+'\\n';__RB__,error:()=>__LB____RB__ __RB__;try__LB__ if(workDir)process.chdir(workDir);fn(req,fakeProc,fakeCon,script,path.dirname(script));__RB__ catch(e)__LB__ if(!e||!e.__exit)code=1;__RB__ finally__LB__ if(workDir)process.chdir(origCwd);__RB__;results.push(String(code)+'<<<CODE_END>>>'+out);__RB__;process.stdout.write(results.join('<<<BATCH_SEP>>>'));"
        val js = raw.replace("__LB__", "{{").replace("__RB__", "}}")
        expect(file_write_exact(runner, js)).to_equal(true)
    runner

fn _run_validator_many(proof_paths: [text]) -> [(text, i64)]:
    val runner = _ensure_batch_runner()
    var cmd_args = [runner, "scripts/check/validate-electron-simple-web-engine2d-proof.js"]
    for p in proof_paths:
        cmd_args.push("@@SEP@@@@SEP@@" + p)
    val (stdout, _stderr, _code) = process_run("node", cmd_args)
    var out: [(text, i64)] = []
    for chunk in stdout.split("<<<BATCH_SEP>>>"):
        val pair = chunk.split("<<<CODE_END>>>")
        val c = if pair[0].trim() == "0": 0 else: 1
        val body = if pair.len() > 1: pair[1] else: ""
        out.push((body, c))
    out

fn _run_validator(proof_path: text) -> (text, i64):
    val (stdout, _stderr, code) = process_run("node", ["scripts/check/validate-electron-simple-web-engine2d-proof.js", proof_path])
    (stdout, code)

fn _run_validator_in_dir(work_dir: text, proof_name: text) -> (text, i64):
    val js = "const path=require('path');const s=path.resolve(process.argv[2]);process.chdir(process.argv[1]);process.argv=[process.argv[0],s,process.argv[3]];require(s)"
    val (stdout, _stderr, code) = process_run("node", ["-e", js, work_dir, "scripts/check/validate-electron-simple-web-engine2d-proof.js", proof_name])
    (stdout, code)

fn _create_symlink(target: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').symlinkSync(process.argv[1], process.argv[2])", target, link_path])
    code

fn _create_hardlink(existing_path: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').linkSync(process.argv[1], process.argv[2])", existing_path, link_path])
    code

# @manual_section: Electron Simple Web Engine2D proof validation

describe "Electron Simple Web Engine2D proof validator":

    it "accepts complete Electron Engine2D timing capture and exact checksum proof":
        step("Verify: accepts complete Electron Engine2D timing capture and exact checksum proof")
        # @req: REQ-CHECK-001
        # @req: REQ-CHECK-ElecSimpWebEngiProoVali-001
        # @capture(protocol_json): normalized validator evidence.env rows for the accepted Engine2D proof
        val root = "build/test-electron-engine2d-validator-pass"
        _prepare_dir(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, [])
        val (evidence, code) = _run_validator(proof_path)
        expect(code).to_equal(0)  # oracle: validator exit 0 proves the complete Engine2D proof is accepted

        step("Inspect normalized Electron Engine2D proof rows")
        expect(evidence).to_contain("electron_simple_web_engine2d_validation_status=pass")
        expect(evidence).to_contain("electron_simple_web_engine2d_validation_reason=pass")
        expect(evidence).to_contain("electron_simple_web_engine2d_simple_checksum=26388279060480")
        expect(evidence).to_contain("electron_simple_web_engine2d_electron_weighted_checksum=81077987413324800")
        expect(evidence).to_contain("electron_simple_web_engine2d_mismatch_count=0")
        expect(evidence).to_contain("electron_simple_web_engine2d_electron_frame_us=1250")
        expect(evidence).to_contain("electron_simple_web_engine2d_capture_native_width=96")
        expect(evidence).to_contain("electron_simple_web_engine2d_capture_native_height=64")
        expect(evidence).to_contain("electron_simple_web_engine2d_capture_downsampled=false")
        expect(evidence).to_contain("electron_simple_web_engine2d_captured_argb_written=true")

    it "rejects unexpected Electron renderer or non-Engine2D scene identity":
        # @capture(protocol_json): renderer, proof-source, and scene rejection rows
        val root = "build/test-electron-engine2d-validator-identity"
        _prepare_dir(root, true)
        _write_proof(root + "/renderer.json", [_kv("renderer", "\"static-fixture\"")])
        _write_proof(root + "/source.json", [_kv("proof_source", "\"tools/manual/proof.json\"")])
        _write_proof(root + "/scene.json", [_kv("scene", "\"simple-web-layout-text-flow\"")])
        val res = _run_validator_many([root + "/renderer.json", root + "/source.json", root + "/scene.json"])
        val (renderer, r_code) = res[0]
        val (source, so_code) = res[1]
        val (scene, sc_code) = res[2]
        expect(r_code).to_equal(1)  # oracle: the validator must exit 1 (fail closed) on this rejection
        expect(so_code).to_equal(1)  # oracle: the validator must exit 1 (fail closed) on this rejection
        expect(sc_code).to_equal(1)  # oracle: the validator must exit 1 (fail closed) on this rejection

        step("Confirm Engine2D proof is tied to live Electron Engine2D scenes")
        expect(renderer).to_contain("electron_simple_web_engine2d_validation_reason=unexpected-electron-renderer")
        expect(source).to_contain("electron_simple_web_engine2d_validation_reason=unexpected-proof-source")
        expect(source).to_contain("electron_simple_web_engine2d_proof_source=tools/manual/proof.json")
        expect(scene).to_contain("electron_simple_web_engine2d_validation_reason=unexpected-electron-scene")

    it "rejects proof when the live Electron Engine2D capture source artifact is missing":
        # @capture(protocol_json): missing proof source artifact reason rows
        val root = "build/test-electron-engine2d-validator-source-artifact"
        _prepare_dir(root, true)
        _write_proof(root + "/proof.json", [])
        val (evidence, code) = _run_validator_in_dir(root, "proof.json")
        expect(code).to_equal(1)  # oracle: the validator must exit 1 (fail closed) on this rejection

        step("Confirm Engine2D proof source marker is bound to the producer source file")
        expect(evidence).to_contain("electron_simple_web_engine2d_validation_status=fail")
        expect(evidence).to_contain("electron_simple_web_engine2d_validation_reason=unexpected-proof-source-file-missing")
        expect(evidence).to_contain("electron_simple_web_engine2d_proof_source=tools/electron-live-bitmap/exact_fixture.js")
        expect(evidence).to_contain("electron_simple_web_engine2d_proof_source_file_status=missing")
        expect(evidence).to_contain("electron_simple_web_engine2d_proof_source_size_bytes=")
        expect(evidence).to_contain("electron_simple_web_engine2d_proof_source_actual_size_bytes=")
        expect(evidence).to_contain("electron_simple_web_engine2d_proof_source_file_reason=missing")
        expect(evidence).to_contain("electron_simple_web_engine2d_proof_source_artifact_status=fail")

    it "rejects substituted Electron Engine2D proof source artifacts":
        # @capture(protocol_json): hardlink, non-regular, and markerless rejection rows
        val root = "build/test-electron-engine2d-validator-source-artifact-substituted"
        _prepare_dir(root, false)
        expect(dir_create_all(root + "/hardlink/tools/electron-live-bitmap")).to_equal(true)
        expect(dir_create_all(root + "/directory/tools/electron-live-bitmap/exact_fixture.js")).to_equal(true)
        expect(dir_create_all(root + "/markerless/tools/electron-live-bitmap")).to_equal(true)

        _write_default_argb(root + "/directory")
        _write_proof(root + "/directory/proof.json", [])
        val (directory, directory_code) = _run_validator_in_dir(root + "/directory", "proof.json")
        expect(directory_code).to_equal(1)

        _write_default_argb(root + "/markerless")
        _write_proof(root + "/markerless/proof.json", [])
        expect(file_write_exact(root + "/markerless/tools/electron-live-bitmap/exact_fixture.js", "module.exports = {{}};\n")).to_equal(true)
        val (markerless, markerless_code) = _run_validator_in_dir(root + "/markerless", "proof.json")
        expect(markerless_code).to_equal(1)

        step("Confirm non-regular and markerless proof sources are rejected")
        expect(directory).to_contain("electron_simple_web_engine2d_validation_status=fail")
        expect(directory).to_contain("electron_simple_web_engine2d_validation_reason=unexpected-proof-source-file-not-regular")
        expect(directory).to_contain("electron_simple_web_engine2d_proof_source_file_status=not-regular")
        expect(directory).to_contain("electron_simple_web_engine2d_proof_source_file_reason=not-regular")
        expect(directory).to_contain("electron_simple_web_engine2d_proof_source_artifact_status=fail")
        expect(markerless).to_contain("electron_simple_web_engine2d_validation_status=fail")
        expect(markerless).to_contain("electron_simple_web_engine2d_validation_reason=unexpected-proof-source-file-marker-missing")
        expect(markerless).to_contain("electron_simple_web_engine2d_proof_source_file_status=marker-missing")
        expect(markerless).to_contain("electron_simple_web_engine2d_proof_source_actual_size_bytes=")
        expect(markerless).to_contain("electron_simple_web_engine2d_proof_source_file_reason=marker-missing")
        expect(markerless).to_contain("electron_simple_web_engine2d_proof_source_artifact_status=fail")

        _write_default_argb(root + "/hardlink")
        _write_proof(root + "/hardlink/proof.json", [])
        val exact_src = file_read("tools/electron-live-bitmap/exact_fixture.js")
        expect(file_write_exact(root + "/hardlink/original-exact-fixture.js", exact_src)).to_equal(true)
        expect(_create_hardlink(root + "/hardlink/original-exact-fixture.js", root + "/hardlink/tools/electron-live-bitmap/exact_fixture.js")).to_equal(0)
        val (hardlink, hardlink_code) = _run_validator_in_dir(root + "/hardlink", "proof.json")
        expect(hardlink_code).to_equal(1)

        expect(hardlink).to_contain("electron_simple_web_engine2d_validation_status=fail")
        expect(hardlink).to_contain("electron_simple_web_engine2d_validation_reason=unexpected-proof-source-file-hardlink")
        expect(hardlink).to_contain("electron_simple_web_engine2d_proof_source_file_status=hardlink")
        expect(hardlink).to_contain("electron_simple_web_engine2d_proof_source_actual_size_bytes=")
        expect(hardlink).to_contain("electron_simple_web_engine2d_proof_source_file_reason=hardlink")
        expect(hardlink).to_contain("electron_simple_web_engine2d_proof_source_artifact_status=fail")

    it "rejects missing Electron capture backend and GPU feature diagnostics":
        # @capture(protocol_json): capture backend and GPU diagnostic rows
        val root = "build/test-electron-engine2d-validator-backend"
        _prepare_dir(root, true)
        _write_proof(root + "/backend.json", [_kv("capture_backend", "\"manual-json\"")])
        _write_proof(root + "/mode.json", [_kv("compositor_mode", "\"unknown\"")])
        _write_proof(root + "/gpu.json", [_kv("gpu_feature_status", "__OMIT__")])
        _write_proof(root + "/gpu-mismatch.json", [_kv("gpu_feature_status", "{{\"gpu_compositing\":\"enabled\",\"rasterization\":\"disabled_software\"}}")])
        _write_proof(root + "/gpu-raster-mismatch.json", [_kv("gpu_feature_status", "{{\"gpu_compositing\":\"disabled_software\",\"rasterization\":\"enabled\"}}")])
        val res = _run_validator_many([
            root + "/backend.json",
            root + "/mode.json",
            root + "/gpu.json",
            root + "/gpu-mismatch.json",
            root + "/gpu-raster-mismatch.json"
        ])
        val (backend, c1) = res[0]
        val (mode, c2) = res[1]
        val (gpu_env, c3) = res[2]
        val (gpu_mismatch, c4) = res[3]
        val (gpu_raster_mismatch, c5) = res[4]
        expect(c1).to_equal(1)
        expect(c2).to_equal(1)
        expect(c3).to_equal(1)
        expect(c4).to_equal(1)
        expect(c5).to_equal(1)

        step("Confirm Engine2D proof carries capture backend and GPU diagnostics")
        expect(backend).to_contain("electron_simple_web_engine2d_validation_reason=unexpected-capture-backend")
        expect(backend).to_contain("electron_simple_web_engine2d_capture_backend=manual-json")
        expect(mode).to_contain("electron_simple_web_engine2d_validation_reason=unexpected-compositor-mode")
        expect(mode).to_contain("electron_simple_web_engine2d_compositor_mode=unknown")
        expect(gpu_env).to_contain("electron_simple_web_engine2d_validation_reason=missing-gpu-feature-status")
        expect(gpu_env).to_contain("electron_simple_web_engine2d_gpu_compositing=disabled_software")
        expect(gpu_mismatch).to_contain("electron_simple_web_engine2d_validation_reason=missing-gpu-feature-status")
        expect(gpu_mismatch).to_contain("electron_simple_web_engine2d_gpu_compositing=disabled_software")
        expect(gpu_raster_mismatch).to_contain("electron_simple_web_engine2d_validation_reason=missing-gpu-feature-status")
        expect(gpu_raster_mismatch).to_contain("electron_simple_web_engine2d_gpu_rasterization=disabled_software")

    it "rejects proof without live Electron Chromium runtime identity":
        # @capture(protocol_json): electron and chromium runtime identity rows
        val root = "build/test-electron-engine2d-validator-runtime"
        _prepare_dir(root, true)
        _write_proof(root + "/engine.json", [_kv("browser_engine", "\"webkit\"")])
        _write_proof(root + "/ua.json", [_kv("electron_user_agent", "\"Mozilla/5.0 Chrome/142.0.0.0 Safari/537.36\"")])
        _write_proof(root + "/electron-version.json", [_kv("electron_process_version", "\"\"")])
        _write_proof(root + "/chrome-version.json", [_kv("chrome_process_version", "\"dev\"")])
        val res = _run_validator_many([root + "/engine.json", root + "/ua.json", root + "/electron-version.json", root + "/chrome-version.json"])
        val (engine, c1) = res[0]
        val (ua, c2) = res[1]
        val (electron_version, c3) = res[2]
        val (chrome_version, c4) = res[3]
        expect(c1).to_equal(1)
        expect(c2).to_equal(1)
        expect(c3).to_equal(1)
        expect(c4).to_equal(1)

        step("Confirm Engine2D proof needs Electron and Chromium runtime rows")
        expect(engine).to_contain("electron_simple_web_engine2d_validation_reason=missing-electron-runtime-identity")
        expect(engine).to_contain("electron_simple_web_engine2d_browser_engine=webkit")
        expect(ua).to_contain("electron_simple_web_engine2d_validation_reason=missing-electron-runtime-identity")
        expect(ua).to_contain("electron_simple_web_engine2d_electron_user_agent=Mozilla/5.0 Chrome/142.0.0.0 Safari/537.36")
        expect(electron_version).to_contain("electron_simple_web_engine2d_validation_reason=missing-electron-runtime-identity")
        expect(electron_version).to_contain("electron_simple_web_engine2d_electron_process_version=")
        expect(chrome_version).to_contain("electron_simple_web_engine2d_validation_reason=missing-electron-runtime-identity")
        expect(chrome_version).to_contain("electron_simple_web_engine2d_chrome_process_version=dev")

    it "rejects malformed Electron Engine2D performance timing":
        # @capture(protocol_json): malformed frame timing reason rows
        step("Run the mutated Engine2D timing proof through the validator")
        val root = "build/test-electron-engine2d-validator-bad-frame"
        _prepare_dir(root, true)
        _write_proof(root + "/proof.json", [_kv("frame_us", "\"not-a-number\"")])
        _write_proof(root + "/iterations.json", [_kv("iterations", "1")])
        val res = _run_validator_many([root + "/proof.json", root + "/iterations.json"])
        val (evidence, c1) = res[0]
        val (iterations, c2) = res[1]
        expect(c1).to_equal(1)  # oracle: the validator must exit 1 (fail closed) on this rejection
        expect(c2).to_equal(1)  # oracle: the validator must exit 1 (fail closed) on this rejection

        expect(evidence).to_contain("electron_simple_web_engine2d_validation_status=fail")
        expect(evidence).to_contain("electron_simple_web_engine2d_validation_reason=missing-electron-timing")
        expect(evidence).to_contain("electron_simple_web_engine2d_electron_frame_us=")
        expect_not(evidence.contains("electron_simple_web_engine2d_electron_frame_us=not-a-number"))
        expect(iterations).to_contain("electron_simple_web_engine2d_validation_reason=missing-performance-iterations")
        expect(iterations).to_contain("electron_simple_web_engine2d_proof_iterations=1")

    it "rejects implausibly high Electron Engine2D frame timing":
