        expect(file_copy("build/.tmp_electron_engine2d_cap_h63.json", root + "/viewport_cap.json")).to_equal(true)
        _write_proof(root + "/pixels.json", [_kv("captured_argb_path", "\"pixels_cap.json\"")])
        expect(file_write_exact(root + "/pixels_cap.json", "{{\"width\":96,\"height\":64,\"format\":\"argb-u32\",\"producer\":\"electron-live-capture-page\",\"pixels\":[0,0,0,0]}}")).to_equal(true)
        _write_proof(root + "/string-pixels.json", [_kv("captured_argb_path", "\"string_cap.json\"")])
        expect(file_copy("build/.tmp_electron_engine2d_cap_strp.json", root + "/string_cap.json")).to_equal(true)
        _write_proof(root + "/fractional-pixels.json", [_kv("captured_argb_path", "\"frac_cap.json\"")])
        expect(file_copy("build/.tmp_electron_engine2d_cap_frac.json", root + "/frac_cap.json")).to_equal(true)
        _write_proof(root + "/range-pixels.json", [_kv("captured_argb_path", "\"range_cap.json\"")])
        expect(file_copy("build/.tmp_electron_engine2d_cap_range.json", root + "/range_cap.json")).to_equal(true)
        _write_proof(root + "/blank.json", [_kv("captured_argb_path", "\"blank_cap.json\"")])
