"""
# Darwin direct-child broker admission

The native fixture admits an AMFI-bound canonical helper after a kernel-created
empty environment and descriptor closure. A hostile dyld constructor provides
a working RED control. A direct child does not establish a disjoint coalition
or generic V4 workload provider.
"""

use std.io_runtime.{process_run}
use std.spec.*

describe "Darwin direct-child broker admission":
    it "excludes pre-main environment takeover and authenticates the direct child":
        val (stdout, stderr, code) = process_run("/bin/sh", [
            "scripts/check/check-sosix-darwin-broker-admission.shs"
        ])
        if code != 0:
            print(stderr)
        expect(code).to_equal(0)
        expect(stdout).to_contain("unbound_dyld_constructor_control: executes_before_main")
        expect(stdout).to_contain("direct_child_impostor: rejected_before_admission")
        expect(stdout).to_contain("canonical_helper_empty_environment_and_closed_descriptors: admitted")
        expect(stdout).to_contain("direct_child_wrong_hash_and_incarnation: rejected")
        expect(stdout).to_contain("direct_child_shutdown: bounded_reap_receipt")
        expect(stdout).to_contain("dyld_injected_constructor: excluded_before_main")
        expect(stdout).to_contain("direct_child_socket_replacement: no_protocol_bytes")
        expect(stdout).to_contain("lost_child_authority: no_signal")
        expect(stdout).to_contain("direct_child_wrong_spawn_hash: rejected_before_constructor")
        expect(stdout).to_contain("unbound_image: admission_rejected")
        expect(stdout).to_contain("closed_gate_silence_and_stopped_child: timeout_and_reap")
        expect(stdout).to_contain("saturated_endpoint_connect: bounded")
        expect(stdout).to_contain("disjoint_coalition_authority: unavailable")
        expect(stdout).to_contain("generic_v4_capability: not_claimed")
        expect(stdout).to_contain("darwin_broker_admission: pass")
