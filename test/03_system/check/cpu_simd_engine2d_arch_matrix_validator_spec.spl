"""
# CPU SIMD Engine2D Architecture Matrix Validator

Exercises the retained-evidence admission path with bounded synthetic files.
It does not execute Simple, a native test binary, a cross build, or QEMU.
"""

# @tag: system, gui, engine2d, simd, evidence, req-007

use std.io_runtime.process_run_timeout
use std.spec.*

describe "CPU SIMD Engine2D architecture matrix validator":

    # @req REQ-007
    it "accepts a current receipt and rejects every provenance path and parity mutation":
        step("Run the validation-only fixture with a 30-second hard bound")
        val (stdout, stderr, code) = process_run_timeout(
            "/bin/sh",
            ["-c", "sh scripts/check/check-cpu-simd-engine2d-arch-matrix.shs --self-test"],
            30000
        )
        expect(code).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_valid=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_duplicate_key=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_changed_source=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_changed_compiler=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_wrong_feature=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_runtime_arch_mismatch=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_simple_bin_path_mismatch=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_emulated_environment=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_native_executed_false=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_bit_exact_false=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_zero_hits=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_scalar_mismatch=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_forged_receipt=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_source_symlink=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_compiler_symlink=pass")
        expect(stdout).to_contain("cpu_simd_arch_matrix_self_test_status=pass")
