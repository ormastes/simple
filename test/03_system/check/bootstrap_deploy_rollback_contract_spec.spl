"""
## Purpose and audience
Purpose: retains a known-good backup and atomically publishes scoped deployment evidence
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-CHECK-BootDeplRollCont-001

use std.io.{file_read}
use std.io_runtime.{process_run}
use std.spec.*

val DEPLOY = "scripts/bootstrap/bootstrap-from-scratch.sh"
val ROLLBACK = "scripts/bootstrap/bootstrap-from-scratch.sh"

fn step_bootstrap_deploy_rollback() -> (text, text):
    step("Inspect durable bootstrap deployment rollback contracts")
    (file_read(DEPLOY), file_read(ROLLBACK))

fn step_run_rollback_fixture(tamper_backup: bool) -> (text, text, i64):
    step("Run rollback against an isolated compiler deployment fixture")
    val tamper = if tamper_backup: "printf tampered >> bin/release/test-platform/simple.pre_deploy; " else: ""
    val command =
        "set -eu; root=/tmp/bootstrap-rollback-contract-$$; " +
        "trap 'rm -rf \"$root\"' EXIT; mkdir -p \"$root/scripts/bootstrap\" \"$root/scripts/setup\" \"$root/bin/release/test-platform\"; " +
        "cp " + ROLLBACK + " \"$root/scripts/bootstrap/bootstrap-from-scratch.sh\"; " +
        "printf '%s\\n' '#!/bin/sh' 'exit 0' > \"$root/scripts/setup/setup.shs\"; chmod 755 \"$root/scripts/setup/setup.shs\"; " +
        "printf '%s\\n' '#!/bin/sh' '# enum construction: unregistered enum' '# current-generation' 'echo 2' > \"$root/bin/release/test-platform/simple\"; " +
        "printf '%s\\n' '#!/bin/sh' '# enum construction: unregistered enum' '# backup-generation' 'echo 2' > \"$root/bin/release/test-platform/simple.pre_deploy\"; " +
        "chmod 755 \"$root/bin/release/test-platform/simple\" \"$root/bin/release/test-platform/simple.pre_deploy\"; cd \"$root\"; " +
        "if command -v sha256sum >/dev/null 2>&1; then hash='sha256sum'; elif command -v shasum >/dev/null 2>&1; then hash='shasum -a 256'; else hash='sha256 -q'; fi; " +
        "cur=$(eval $hash bin/release/test-platform/simple | awk '{print $1}'); back=$(eval $hash bin/release/test-platform/simple.pre_deploy | awk '{print $1}'); " +
        "printf '%s\\n' schema=bootstrap-deploy-receipt-v1 platform=test-platform current_path=bin/release/test-platform/simple current_sha256=$cur backup_path=bin/release/test-platform/simple.pre_deploy backup_sha256=$back deployment_status=pass > bin/release/test-platform/bootstrap-deploy-receipt.env; " +
        tamper + "set +e; sh scripts/bootstrap/bootstrap-from-scratch.sh rollback-deploy test-platform; rc=$?; set -e; " +
        "if grep -q backup-generation bin/release/test-platform/simple; then echo active_generation=backup; else echo active_generation=current; fi; " +
        "if grep -q current-generation bin/release/test-platform/simple.pre_deploy; then echo backup_generation=current; else echo backup_generation=backup; fi; exit $rc"
    process_run("/bin/sh", ["-c", command])

describe "Bootstrap deployment rollback contract":
    it "retains a known-good backup and atomically publishes scoped deployment evidence":
        step("Verify: retains a known-good backup and atomically publishes scoped deployment evidence")
        # @req: REQ-CHECK-BootDeplRollCont-001
        val (deploy, _rollback) = step_bootstrap_deploy_rollback()
        expect(deploy).to_contain("bootstrap-deploy-receipt-v1")
        expect(deploy).to_contain("mv \"${receipt_tmp}\" \"${deploy_receipt}\"")
        expect(deploy).to_contain("platform_acceptance_claimed=false")
        expect(deploy).to_contain("backup_created=0")
        expect(deploy).to_contain("else\n    rm -f \"${prev_bin}\"")
        expect(deploy).to_contain("[ \"${backup_created}\" -eq 1 ]")

    it "rejects unconfined paths symlinks and tampered hashes before swapping":
        step("Verify: rejects unconfined paths symlinks and tampered hashes before swapping")
        # @req: REQ-CHECK-BootDeplRollCont-001
        val (_deploy, rollback) = step_bootstrap_deploy_rollback()
        expect(rollback).to_contain("fail_receipt current_path")
        expect(rollback).to_contain("fail_receipt backup_path")
        expect(rollback).to_contain("[ ! -L \"${backup}\" ]")
        expect(rollback).to_contain("fail_receipt current_hash")
        expect(rollback).to_contain("fail_receipt backup_hash")

    it "prevalidates the backup and restores the old compiler when setup fails":
        step("Verify: prevalidates the backup and restores the old compiler when setup fails")
        # @req: REQ-CHECK-BootDeplRollCont-001
        val (_deploy, rollback) = step_bootstrap_deploy_rollback()
        expect(rollback).to_contain("bounded_smoke \"${candidate}\"")
        expect(rollback).to_contain("mv \"${candidate}\" \"${current}\"")
        expect(rollback).to_contain("mv \"${old}\" \"${current}\"")
        expect(rollback).to_contain("fail_receipt rollback_smoke")
        expect(rollback).to_contain("rollback_status=pass")
        expect(rollback).to_contain("platform_acceptance_claimed=false")

    it "executes a valid confined rollback and publishes scoped evidence":
        step("Verify: executes a valid confined rollback and publishes scoped evidence")
        # @req: REQ-CHECK-BootDeplRollCont-001
        val (stdout, stderr, code) = step_run_rollback_fixture(false)
        expect(code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(stderr).to_equal("")
        expect(stdout).to_contain("rollback_status=pass")
        expect(stdout).to_contain("active_generation=backup")
        expect(stdout).to_contain("backup_generation=current")

    it "rejects a tampered backup without replacing the active compiler":
        step("Verify: rejects a tampered backup without replacing the active compiler")
        # @req: REQ-CHECK-BootDeplRollCont-001
        val (stdout, stderr, code) = step_run_rollback_fixture(true)
        expect(code).to_equal(1)  # oracle: value fixed by the spec contract
        expect(stderr).to_contain("rollback failed: backup_hash")
        expect(stdout).to_contain("active_generation=current")
        expect(stdout).to_contain("backup_generation=backup")

    it "rejects parent-directory platform traversal before touching deployment state":
        step("Verify: rejects parent-directory platform traversal before touching deployment state")
        # @req: REQ-CHECK-BootDeplRollCont-001
        val (stdout, stderr, code) = process_run("/bin/sh", [ROLLBACK, ".."])
        expect(code).to_equal(2)  # oracle: value fixed by the spec contract
        expect(stdout).to_equal("")
        expect(stderr).to_contain("invalid platform")
