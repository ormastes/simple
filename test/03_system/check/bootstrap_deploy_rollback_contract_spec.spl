"""
## Purpose and audience
Purpose: proves compiler and companion deployment use one provenance-bound transaction
Audience: compiler and tooling engineers who maintain bootstrap deployment
"""

# @req: REQ-CHECK-BootDeplRollCont-001

use std.io.{file_read}
use app.io.mod.{process_run_timeout}
use std.spec.*

val DEPLOY = "scripts/bootstrap/bootstrap-from-scratch.sh"
val TRANSACTION = "scripts/bootstrap/bootstrap-deploy-transaction.shs"
val ROLLBACK = "scripts/bootstrap/rollback-bootstrap-deploy.shs"
val SETUP = "scripts/setup/setup.shs"
val MUTATIONS = "test/01_unit/scripts/bootstrap_deploy_transaction_test.shs"

describe "Bootstrap deployment rollback contract":
    it "publishes compiler MCP LSP and authority as one v3 generation":
        step("Verify: deployment seals one immutable generation before one pointer swap")
        val deploy = file_read(DEPLOY)
        expect(deploy).to_contain("bootstrap_deploy_tx_begin")
        expect(deploy).to_contain("bootstrap_deploy_tx_add simple")
        expect(deploy).to_contain("simple_mcp_server simple_lsp_mcp_server")
        expect(deploy).to_contain("authority.phase7.env")
        expect(deploy).to_contain("bootstrap_deploy_tx_seal")
        expect(deploy).to_contain("bootstrap_deploy_tx_apply")
        expect(deploy).to_contain("schema=bootstrap-deploy-receipt-v3")
        expect(deploy).to_contain("transaction_entries_sha256")

    it "recovers or rolls back the exact provenance-bound generation":
        step("Verify: recovery and rollback use a CAS-protected generation pointer")
        val transaction = file_read(TRANSACTION)
        val rollback = file_read(ROLLBACK)
        expect(transaction).to_contain("bootstrap_deploy_tx_recover")
        expect(transaction).to_contain("bootstrap_deploy_tx_pointer_swap")
        expect(transaction).to_contain("bootstrap_deploy_tx_write_receipt_entries")
        expect(transaction).to_contain("bootstrap-deploy-receipt-v3")
        expect(transaction).to_contain("bootstrap_deploy_tx_validate_generation")
        expect(rollback).to_contain("bootstrap_deploy_tx_rollback_generation")

    it "reverifies locked Stage 4 and requires canonical Phase 7 authority":
        step("Verify: no pre-lock or unselected policy receipt can authorize deployment")
        val deploy = file_read(DEPLOY)
        expect(deploy).to_contain("locked_stage4_output_sha")
        expect(deploy).to_contain("stage4_verify_candidate_provenance")
        expect(deploy).to_contain("simple-kernel-phase7-qualification-v2")
        expect(deploy).to_contain("performance_baseline_receipt_sha256")
        expect(deploy).to_contain("performance_measurement_receipt_sha256")

    it "uses only the canonical macOS Simple-native release directory":
        step("Verify: setup cannot silently prefer a stale three-part macOS binary")
        val setup = file_read(SETUP)
        expect(setup).to_contain("simple_release_platform_dir")
        expect(setup).to_contain("candidate=\"${release_dir}/simple_mcp_server\"")
        expect(setup).to_contain("candidate=\"${release_dir}/simple_lsp_mcp_server\"")

    it "rejects symlinks digest drift partial swaps and stale receipts":
        step("Run: adversarial transaction mutation matrix")
        val (_stdout, _stderr, status) = process_run_timeout(
            "/bin/sh",
            [MUTATIONS],
            30000
        )
        expect(status).to_equal(0)
