# codex-system-test
# @req REQ-RLMS-001 REQ-RLMS-002 REQ-RLMS-003
# @evidence-display: links
"""# Render Lane Mission Showcase Admission

Exercises the production mission-gate script with isolated evidence fixtures.
It proves fail-closed admission semantics only; a synthetic fixture is never
live-guest, QEMU, allocation, or Vulkan execution evidence.
"""
use std.io_runtime.{file_read, process_run}
use std.spec.*

fn run_showcase_gate(root: text, receipt_backend: text, duplicate: bool, degraded: bool, unbound: bool) -> (text, text, i64):
    val duplicate_copy = if duplicate: "cp " + root + "/wm.ppm " + root + "/gui.ppm" else: "printf 'P6\\n64 64\\n255\\n' >" + root + "/gui.ppm; dd if=/dev/zero bs=12288 count=1 status=none >>" + root + "/gui.ppm; printf G >>" + root + "/gui.ppm"
    val serial_suffix = if degraded: "FATAL: injected fixture fault\\n" else: ""
    val receipt_mutation = if unbound: " && sed -i 's/^wm_sha256=.*/wm_sha256=0/' " + root + "/vulkan.env" else: ""
    val command = "rm -rf " + root + " && mkdir -p " + root +
        " && printf 'P6\\n64 64\\n255\\n' >" + root + "/wm.ppm; dd if=/dev/zero bs=12288 count=1 status=none >>" + root + "/wm.ppm; printf W >>" + root + "/wm.ppm" +
        " && " + duplicate_copy +
        " && printf 'P6\\n64 64\\n255\\n' >" + root + "/web.ppm; dd if=/dev/zero bs=12288 count=1 status=none >>" + root + "/web.ppm; printf B >>" + root + "/web.ppm" +
        " && printf 'P6\\n64 64\\n255\\n' >" + root + "/engine2d.ppm; dd if=/dev/zero bs=12288 count=1 status=none >>" + root + "/engine2d.ppm; printf E >>" + root + "/engine2d.ppm" +
        " && printf '[desktop-gui] first-frame-rendered 1\\n[desktop-gui] engine2d-ready backend=vulkan\\n[desktop-gui] spawn return app=Browser Demo pid=7\\n[production-readiness] wm=live simple_gui=object-tree simple_web=content-frame renderer=engine2d process_owned_surfaces=4\\n" + serial_suffix + "' >" + root + "/serial.log" +
        " && printf qemu >" + root + "/qemu.env && printf container >" + root + "/container.env && printf admitted >" + root + "/simple && printf image >" + root + "/guest.img" +
        " && printf 'schema_version=1\\nstatus=pass\\nbackend=" + receipt_backend + "\\nvulkan_submit=pass\\nvulkan_fence=pass\\nvulkan_readback=pass\\nallocation_cap_bytes=65536\\nallocation_peak_bytes=4096\\nwm_sha256='$(sha256sum " + root + "/wm.ppm | awk '{print $1}')'\\ngui_sha256='$(sha256sum " + root + "/gui.ppm | awk '{print $1}')'\\nweb_sha256='$(sha256sum " + root + "/web.ppm | awk '{print $1}')'\\nengine2d_sha256='$(sha256sum " + root + "/engine2d.ppm | awk '{print $1}')'\\nguest_serial_sha256='$(sha256sum " + root + "/serial.log | awk '{print $1}')'\\nqemu_producer_receipt_sha256='$(sha256sum " + root + "/qemu.env | awk '{print $1}')'\\ncontainer_producer_receipt_sha256='$(sha256sum " + root + "/container.env | awk '{print $1}')'\\nadmitted_simple_bin_sha256='$(sha256sum " + root + "/simple | awk '{print $1}')'\\nguest_image_sha256='$(sha256sum " + root + "/guest.img | awk '{print $1}')'\\n' >" + root + "/vulkan.env" +
        receipt_mutation + " && WM_CAPTURE=" + root + "/wm.ppm GUI_CAPTURE=" + root + "/gui.ppm WEB_CAPTURE=" + root + "/web.ppm ENGINE2D_CAPTURE=" + root + "/engine2d.ppm GUEST_SERIAL_LOG=" + root + "/serial.log VULKAN_RECEIPT=" + root + "/vulkan.env QEMU_PRODUCER_RECEIPT=" + root + "/qemu.env CONTAINER_PRODUCER_RECEIPT=" + root + "/container.env ADMITTED_SIMPLE_BIN=" + root + "/simple GUEST_IMAGE=" + root + "/guest.img ALLOCATION_CAP_BYTES=65536 REPORT_PATH=" + root + "/report.env sh scripts/check/check-render-lane-mission-showcase.shs"
    return process_run("/bin/sh", ["-c", command])

describe "Render lane mission showcase admission":
    # @capture(artifact)
    it "should accept four distinct capture artifacts bound to a Vulkan receipt":
        step("Create isolated WM GUI Web and Engine2D capture artifacts")
        val (_out, _err, code) = run_showcase_gate("build/test-render-lane-mission-showcase/pass", "vulkan", false, false, false)
        expect(code).to_equal(0)
        val report = file_read("build/test-render-lane-mission-showcase/pass/report.env")
        expect(report).to_contain("render_lane_mission_showcase_status=pass")
        expect(report).to_contain("render_lane_mission_showcase_distinct_capture_count=4")
        expect(report).to_contain("render_lane_mission_showcase_vulkan_backend_count=1")

    it "should reject captures that are not distinct across the four render lanes":
        step("Reuse the WM capture as the GUI capture")
        val (_out, _err, code) = run_showcase_gate("build/test-render-lane-mission-showcase/duplicate", "vulkan", true, false, false)
        expect(code).to_equal(1)
        val report = file_read("build/test-render-lane-mission-showcase/duplicate/report.env")
        expect(report).to_contain("render_lane_mission_showcase_reason=captures-not-distinct")

    it "should reject a receipt that does not bind the showcase to Vulkan":
        step("Submit a receipt with a CPU backend")
        val (_out, _err, code) = run_showcase_gate("build/test-render-lane-mission-showcase/non-vulkan", "cpu", false, false, false)
        expect(code).to_equal(1)
        val report = file_read("build/test-render-lane-mission-showcase/non-vulkan/report.env")
        expect(report).to_contain("render_lane_mission_showcase_reason=vulkan-backend-not-bound")

    it "should reject a guest transcript that reports a rendering fault":
        step("Append a fatal marker to an otherwise complete guest transcript")
        val (_out, _err, code) = run_showcase_gate("build/test-render-lane-mission-showcase/degraded", "vulkan", false, true, false)
        expect(code).to_equal(1)
        val report = file_read("build/test-render-lane-mission-showcase/degraded/report.env")
        expect(report).to_contain("render_lane_mission_showcase_reason=degraded-or-faulted-guest")

    it "should reject a Vulkan receipt whose capture hash is not bound":
        step("Replace the WM hash in an otherwise valid receipt")
        val (_out, _err, code) = run_showcase_gate("build/test-render-lane-mission-showcase/unbound", "vulkan", false, false, true)
        expect(code).to_equal(1)
        val report = file_read("build/test-render-lane-mission-showcase/unbound/report.env")
        expect(report).to_contain("render_lane_mission_showcase_reason=vulkan-wm_sha256-unbound")
