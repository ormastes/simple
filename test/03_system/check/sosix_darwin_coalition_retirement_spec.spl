"""
# Darwin coalition retirement primitives

Runs actual launchd user jobs and native kernel identity/coalition APIs. The
same fixtures that escape process groups remain in their resource coalition.
Retirement must cover a fork deliberately created after the first census.
Known fixture reaping is verified separately from coalition task accounting.

This is a bounded primitive qualification, not full V4 process admission. It
requires macOS, a GUI launchd domain, a C compiler, and Python for plist encoding.
"""

use std.io_runtime.{process_run}
use std.spec.*

describe "Darwin kernel coalition retirement":
    it "retires escaped members while keeping generic reap capability unclaimed":
        val (stdout, stderr, code) = process_run("/bin/sh", [
            "scripts/check/check-sosix-darwin-coalition.shs"
        ])
        if code != 0:
            print(stderr)
        expect(code).to_equal(0)
        expect(stdout).to_contain("coalition_leader_kill: escaped_members_killed_and_fixture_reap_observed")
        expect(stdout).to_contain("coalition_leader_exit: escaped_members_killed_and_fixture_reap_observed")
        expect(stdout).to_contain("post_census_fork: retired_on_later_pass")
        expect(stdout).to_contain("watchdog_orphan_cleanup: confirmed")
        expect(stdout).to_contain("expired_deadline: rejected_before_signalling")
        expect(stdout).to_contain("census_deadline: enforced_before_signalling")
        expect(stdout).to_contain("audit_token_stale_signal: rejected")
        expect(stdout).to_contain("self_coalition_retirement: rejected")
        expect(stdout).to_contain("unknown_coalition_retirement: rejected")
        expect(stdout).to_contain("zombie_accounting_is_not_reap: verified")
        expect(stdout).to_contain("generic_reap_capability: not_claimed")
        expect(stdout).to_contain("darwin_coalition_retirement: pass")
