    it "rejects conflicting MDI proof markers across requested mobile logs":
        # @req: REQ-CHECK-TaurMobiMdiProoVali-008
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-tauri-mobile-mdi-validator-conflicting-source-proof"
        _prepare_dir(root)
        _write_proof_log(root + "/dev.log", [])
        _write_proof_log(root + "/stream.log", [_kv("inputToPaintMs", "7.5")])
        val (evidence, code) = _run_validator("ios", root + "/proof.json", [root + "/dev.log", root + "/stream.log"])
        expect(code).to_equal(1)  # oracle: validator exits 1 on the injected defect (fail-closed reject contract)

        step("Confirm one requested mobile log cannot shadow conflicting MDI proof from another")
        expect(evidence).to_contain("ios_mdi_proof_status=fail")
        expect(evidence).to_contain("ios_mdi_proof_reason=conflicting-mdi-proof-log")
        expect(evidence).to_contain("ios_mdi_proof_requested_source_count=2")
        expect(evidence).to_contain("ios_mdi_proof_source_count=2")
        expect(evidence).to_contain("ios_mdi_proof_marker_source_count=2")
