    it "rejects missing pending mismatched or unavailable invoke() round-trip proof":
        # @req: REQ-CHECK-TaurMobiMdiProoVali-028
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-tauri-mobile-mdi-validator-invoke-roundtrip"
        _prepare_dir(root)
        _write_proof_log(root + "/missing.log", [_kv("invokeRoundtripStatus", "__OMIT__")])
        _write_proof_log(root + "/pending.log", [_kv("invokeRoundtripStatus", "\"pending\"")])
        _write_proof_log(root + "/mismatch.log", [_kv("invokeRoundtripStatus", "\"mismatch\""), _kv("invokeRoundtripReply", "\"pong:999\"")])
        _write_proof_log(root + "/unavailable.log", [_kv("invokeRoundtripStatus", "\"unavailable\""), _kv("invokeRoundtripReply", "\"\"")])
        val (missing, c1) = _run_validator("ios", root + "/missing.json", [root + "/missing.log"])
        val (pending, c2) = _run_validator("android", root + "/pending.json", [root + "/pending.log"])
        val (mismatch, c3) = _run_validator("ios", root + "/mismatch.json", [root + "/mismatch.log"])
        val (unavailable, c4) = _run_validator("android", root + "/unavailable.json", [root + "/unavailable.log"])
        expect(c1).to_equal(1)
        expect(c2).to_equal(1)
        expect(c3).to_equal(1)
        expect(c4).to_equal(1)

        step("Confirm the two-way invoke() return path must be proven with a real matching value, not just eval OK")
        expect(missing).to_contain("ios_mdi_proof_status=fail")
        expect(missing).to_contain("ios_mdi_invoke_roundtrip_status=fail")
        expect(missing).to_contain("ios_mdi_render_status=pass")
        expect(missing).to_contain("ios_mdi_event_status=pass")
        expect(pending).to_contain("android_mdi_proof_status=fail")
        expect(pending).to_contain("android_mdi_invoke_roundtrip_status=fail")
        expect(mismatch).to_contain("ios_mdi_proof_status=fail")
        expect(mismatch).to_contain("ios_mdi_invoke_roundtrip_status=fail")
        expect(mismatch).to_contain("ios_mdi_invoke_roundtrip_reply=pong:999")
        expect(unavailable).to_contain("android_mdi_proof_status=fail")
        expect(unavailable).to_contain("android_mdi_invoke_roundtrip_status=fail")

