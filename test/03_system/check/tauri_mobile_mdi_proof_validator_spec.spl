"""
## Purpose and audience
Purpose: accepts complete mobile event capture performance and animation proof
Audience: compiler and tooling engineers who maintain this spec

# Tauri mobile MDI proof validator

## Overview

Validates the shared Tauri mobile MDI proof validator used by both iOS
WKWebView/Metal and Android WebView/Vulkan renderer evidence. The validator
parses `[tauri-shell] mdi proof:` JSON from device logs and must fail closed
when event, capture, performance, or animation details are missing.

**Plan:** doc/03_plan/platform/mobile_tauri_gui_parallel_2026-05-29.md
**Requirements:** N/A
**Research:** N/A
**Design:** doc/07_guide/tooling/renderdoc_capture_infra.md

## Syntax

```sh
SIMPLE_LIB=src bin/simple test test/03_system/check/tauri_mobile_mdi_proof_validator_spec.spl --mode=interpreter --clean --fail-fast
```

## Acceptance

- Complete mobile MDI proof logs validate and emit normalized
  `{prefix}_mdi_*` rows.
- Explicitly requested mobile MDI proof source paths must exist and be
  nonempty regular files; a valid companion device log cannot hide a missing,
  empty, symlinked, hardlinked, duplicated, or non-regular requested source
  artifact.
- When multiple requested device logs contain MDI proof markers, their latest
  proof JSON must agree; conflicting render/event/capture/performance/
  animation proof payloads fail closed instead of letting one log shadow
  another.
- The extracted proof JSON output path must not overlap any requested device
  log source path, including hard-linked aliases, so validation cannot overwrite
  the source evidence it just consumed.
- The extracted proof JSON output path must also be a regular destination, not
  a symlink to another artifact outside the requested device logs.
- Existing extracted proof JSON output paths must not be hardlinked aliases of
  unrelated artifacts outside the requested device logs.
- Existing extracted proof JSON output paths must not be directories or other
  non-regular artifacts.
- `performanceNowAvailable=true` is not enough: the proof must include an
  explicit finite positive `performanceNowDeltaMs` from distinct samples, and
  multi-second timing does not prove responsive mobile rendering.
- Mobile interaction latency must include an explicit positive
  `inputToPaintMs` sample after routed MDI input and a following paint; an
  over-budget multi-second latency sample fails the contract.
- Capture viewport, device pixel ratio, orientation, and animation-frame details
  must also be explicit structured proof values, not defaulted placeholders.
- Render proof must include an explicit rendered image count and HTML render
  marker; event routing alone is not enough to prove the mobile MDI surface
  actually rendered.
- Event proof emits an ordered routed-event sequence plus individual routed
  click/input/key, drag, window-runtime, control-discovery, and
  taskbar-visibility rows rather than only a coarse event status.
- Render counts, event counts, viewport dimensions, device pixel ratio,
  performance timing deltas, and animation-frame counts must be real JSON
  numbers; stringified, fractional, unsafe, or exponential integer values do not
  prove routed events, capture, performance, or full animation frames.
- Renderability, event-routing, performance, and animation booleans must be
  real JSON booleans; string booleans are rejected and not normalized as
  `false` diagnostics.
- Runtime failure markers in any requested device log fail the MDI proof even
  when the JSON counters otherwise prove render, event, capture, performance,
  and animation detail.
- Passing MDI proof emits the exact marker source path, recorded byte size,
  actual byte size, and file status so mobile event/capture/performance/
  animation evidence is bound to a concrete log artifact.
- Unsupported platform prefixes fail closed with neutral diagnostics instead
  of minting misleading `ios_mdi_*` or `android_mdi_*` evidence rows.

## Operator workflow

Each scenario runs the packaged validator (via `node scripts/check/...` or a
direct process invocation) against a complete proof document or a proof mutated
in exactly one field, and asserts the validator exit code and normalized rows.

## Compatibility and limitations

Scenarios that drive the mobile MDI harness need the captured event trace; validator-only scenarios run from a plain repo checkout.

## Verification guidance and troubleshooting

A RED reject scenario is the fail-closed contract working: rerun the scenario and
inspect the cited validator command with the mutated field restored to confirm the
regression. A RED accept scenario means the packaged proof itself regressed;
recapture it with the scripts/check command named in the scenario before shipping.

"""

# @tag: system, gui, tauri, mobile, ios, android, evidence

use std.io_runtime.{dir_create_all, dir_remove_all, file_copy, file_exists, file_read, file_write_exact, process_run}
use std.spec.*

struct KV:
    key: text
    value: text

fn _kv(key: text, value: text) -> KV:
    KV(key: key, value: value)

fn _default_log_line() -> text:
    "[tauri-shell] mdi proof: {{\"count\":4,\"imageCount\":1,\"taskbarItemCount\":4,\"taskbarIconCount\":4,\"viewportWidth\":390,\"viewportHeight\":844,\"devicePixelRatio\":3,\"screenOrientation\":\"portrait\",\"performanceNowAvailable\":true,\"performanceNowDeltaMs\":1.25,\"inputToPaintMs\":2.5,\"animationFrameAvailable\":true,\"animationFrameCount\":2,\"cssAnimationProbe\":true,\"hasDesktop\":true,\"hasDragRuntime\":true,\"hasDragEvents\":true,\"dragMoved\":true,\"hasWindowEventRuntime\":true,\"appActionControlFound\":true,\"appInputControlFound\":true,\"bodyClickRouted\":true,\"bodyInputRouted\":true,\"bodyKeyRouted\":true,\"eventSequence\":[\"window_drag:move\",\"app_action:body_click\",\"app_input:body_input\",\"app_key:body_key\"],\"taskbarIconsVisible\":true,\"taskbarLabelsVisible\":true,\"htmlRenderable\":true,\"invokeRoundtripStatus\":\"pass\",\"invokeRoundtripReply\":\"pong:1\"}}\n"

fn _prepare_dir(root: text):
    val _removed = dir_remove_all(root)
    expect(dir_create_all(root)).to_equal(true)

fn _find_override(overrides: [KV], key: text) -> text:
    for item in overrides:
        if item.key == key:
            return item.value
    "__DEFAULT__"

fn _write_proof_log(log_path: text, overrides: [KV]):
    val tmpl = "build/.tmp_tauri_mobile_mdi_default.log"
    if not file_exists(tmpl):
        expect(dir_create_all("build")).to_equal(true)
        expect(file_write_exact(tmpl, _default_log_line())).to_equal(true)
    if overrides.len() == 0:
        expect(file_copy(tmpl, log_path)).to_equal(true)
        return
    val defaults = [
        _kv("count", "4"),
        _kv("imageCount", "1"),
        _kv("taskbarItemCount", "4"),
        _kv("taskbarIconCount", "4"),
        _kv("viewportWidth", "390"),
        _kv("viewportHeight", "844"),
        _kv("devicePixelRatio", "3"),
        _kv("screenOrientation", "\"portrait\""),
        _kv("performanceNowAvailable", "true"),
        _kv("performanceNowDeltaMs", "1.25"),
        _kv("inputToPaintMs", "2.5"),
        _kv("animationFrameAvailable", "true"),
        _kv("animationFrameCount", "2"),
        _kv("cssAnimationProbe", "true"),
        _kv("hasDesktop", "true"),
        _kv("hasDragRuntime", "true"),
        _kv("hasDragEvents", "true"),
        _kv("dragMoved", "true"),
        _kv("hasWindowEventRuntime", "true"),
        _kv("appActionControlFound", "true"),
        _kv("appInputControlFound", "true"),
        _kv("bodyClickRouted", "true"),
        _kv("bodyInputRouted", "true"),
        _kv("bodyKeyRouted", "true"),
        _kv("eventSequence", "[\"window_drag:move\",\"app_action:body_click\",\"app_input:body_input\",\"app_key:body_key\"]"),
        _kv("taskbarIconsVisible", "true"),
        _kv("taskbarLabelsVisible", "true"),
        _kv("htmlRenderable", "true"),
        _kv("invokeRoundtripStatus", "\"pass\""),
        _kv("invokeRoundtripReply", "\"pong:1\"")
    ]
    var json_out = "{{"
    var first = true
    for item in defaults:
        val ov = _find_override(overrides, item.key)
        if ov != "__OMIT__":
            val value = if ov == "__DEFAULT__": item.value else: ov
            if not first:
                json_out = json_out + ","
            json_out = json_out + "\"" + item.key + "\":" + value
            first = false
    json_out = json_out + "}}"
    expect(file_write_exact(log_path, "[tauri-shell] mdi proof: " + json_out + "\n")).to_equal(true)

fn _run_validator(prefix: text, json_path: text, files: [text]) -> (text, i64):
    var args = ["scripts/check/validate-tauri-mobile-mdi-proof.js", prefix, json_path]
    for f in files:
        args.push(f)
    val (stdout, _stderr, code) = process_run("node", args)
    (stdout, code)

fn _create_symlink(target: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').symlinkSync(process.argv[1], process.argv[2])", target, link_path])
    code

fn _create_hardlink(existing_path: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').linkSync(process.argv[1], process.argv[2])", existing_path, link_path])
    code

