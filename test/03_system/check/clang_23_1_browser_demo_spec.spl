use std.spec.*
use std.io_runtime.{file_read}

describe "Clang 23.1 browser demo migration":
    describe "REQ-001, REQ-002, REQ-007: coherent provider admission":
        it "prefers explicit prefix and rejects non-23.1 versions":
            step("Inspect the installed Clang 23.1 toolchain")
            val resolver = file_read("scripts/check/lib/clang-23-1-toolchain.shs")
            expect(resolver).to_contain("LLVM_23_1_PREFIX")
            expect(resolver).to_contain("observed_version")
            expect(resolver).to_contain("[ \"$observed_version\" = \"23.1\" ]")
            expect(resolver).to_contain("rejected $tool_role")

        it "installs and exports one coherent nine-tool provider family":
            val provider = file_read("scripts/setup/build-llvm-23-1-provider.shs")
            expect(provider).to_contain("clang;lld;llc;opt;llvm-ar;llvm-nm;llvm-objdump;llvm-objcopy;llvm-config")
            expect(provider).to_contain("SIMPLE_LLVM_PREFIX=%s")
            expect(provider).to_contain("SIMPLE_CLANG=%s")
            expect(provider).to_contain("SIMPLE_LINKER=%s")
            expect(provider).to_contain("SIMPLE_LLC=%s")
            expect(provider).to_contain("SIMPLE_OPT=%s")
            expect(provider).to_contain("SIMPLE_AR=%s")
            expect(provider).to_contain("SIMPLE_NM=%s")
            expect(provider).to_contain("SIMPLE_OBJDUMP=%s")
            expect(provider).to_contain("SIMPLE_OBJCOPY=%s")
            expect(provider).to_contain("LLVM_CONFIG=%s")
            expect(provider).to_contain("provider_prefix=$($llvm_config_bin --prefix)")
            expect(provider).to_contain("provider_bindir=$($llvm_config_bin --bindir)")

    describe "REQ-003, REQ-004, REQ-008: browser client build":
        it "uses the admitted compiler for the client and libc":
            step("Build the browser demo with the admitted compiler")
            val build = file_read("scripts/os/build_browser_demo_client.shs")
            expect(build).to_contain("validate_clang_23_1_toolchain")
            expect(build).to_contain("make CC=\"$CLANG\" AR=\"$AR\"")
            expect(build).to_contain("--target=x86_64-unknown-simpleos")
            expect(build).to_contain("browser-demo ELF has unresolved getpid")

        it "retains tool and output identity evidence":
            val build = file_read("scripts/os/build_browser_demo_client.shs")
            expect(build).to_contain("simpleos-browser-demo-clang-23.1-v1")
            expect(build).to_contain("clang_version=")
            expect(build).to_contain("lld_version=")
            expect(build).to_contain("sha256")

    describe "REQ-009, REQ-010: bootstrap and QEMU evidence":
        it "admits only the full Stage4 CLI and LLVM backend profile":
            step("Run the ad-hoc bootstrap smoke")
            val gate = file_read("scripts/check/check-simpleos-wm-fullscreen-evidence.shs")
            val provenance = file_read("scripts/check/lib/stage4-candidate-provenance.shs")
            expect(gate).to_contain("SIMPLEOS_WM_NATIVE_BACKEND:-llvm")
            expect(gate).to_contain("NATIVE_BUILD_SIMPLE_BOOTSTRAP=0")
            expect(gate).to_contain("SIMPLE_BOOTSTRAP=\"$NATIVE_BUILD_SIMPLE_BOOTSTRAP\"")
            expect(gate).to_contain("NATIVE_CACHE_DIR=\"$BUILD_DIR/native-cache/$NATIVE_BACKEND\"")
            expect(gate).to_contain("stage4_verify_candidate_provenance")
            expect(gate).to_contain("Diagnostic compatibility only")
            expect(gate).to_contain("SIMPLE_CLANG=\"$LLVM_CLANG\"")
            expect(gate).to_contain("SIMPLE_LINKER=\"$LLVM_LLD\"")
            expect(gate).to_contain("SIMPLE_LLC=\"$LLVM_LLC\"")
            expect(gate).to_contain("SIMPLE_OPT=\"$LLVM_OPT\"")
            expect(gate).to_contain("SIMPLE_AR=\"$LLVM_AR\"")
            expect(gate).to_contain("SIMPLE_NM=\"$LLVM_NM\"")
            expect(gate).to_contain("SIMPLE_OBJDUMP=\"$LLVM_OBJDUMP\"")
            expect(gate).to_contain("SIMPLE_OBJCOPY=\"$LLVM_OBJCOPY\"")
            expect(provenance).to_contain("artifact_kind=pure-simple-full-cli")
            expect(provenance).to_contain("essential_tools_log_path")
            expect(provenance).to_contain("completed_gate")
            expect(provenance).to_contain("stage4-essential-tools-smoke")

        it "retains exact browser bytes and interactive rendering evidence":
            step("Boot SimpleOS and exercise browser content")
            val gate = file_read("scripts/check/check-simpleos-wm-fullscreen-evidence.shs")
            expect(gate).to_contain("browser_demo_disk_payload_status")
            expect(gate).to_contain("input_state_marker")
            expect(gate).to_contain("pointer_state_marker")
            expect(gate).to_contain("browser_content_presented_generation_status")
            expect(gate).to_contain("path=software window_id=$remote_browser_window status=engine2d_rendered backend=[^ ]+ fallback=(solid-material|cpu-composited-material)")
            expect(gate).to_contain("path=host-gpu window_id=$remote_browser_window status=engine2d_rendered backend=[^ ]+ fallback=(solid-material|cpu-composited-material|metal-device-composited-material)")
            expect(gate).to_contain("material=[0-9a-f]{64} theme=$EXPECTED_THEME_ID source=$EXPECTED_THEME_SOURCE_MANIFEST_SHA256$")
            expect(gate).to_contain("content-provenance-rejected|backend=native-safe-fallback")
            step("Validate retained rendering and input evidence")
