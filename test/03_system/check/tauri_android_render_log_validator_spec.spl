        expect(file_write_exact(log_path, "[tauri-shell] render, html_len=4096\nplain WebView log\n")).to_equal(true)
        val (evidence, code) = _run_validator([log_path])
        expect(code).to_equal(1)  # oracle: validator exits 1 on the injected defect (fail-closed reject contract)

        expect(evidence).to_contain("android_render_log_validation_reason=android-vulkan-log-marker-missing")
        expect(evidence).to_contain("android_render_log_marker_status=pass")
        expect(evidence).to_contain("android_render_log_vulkan_marker_status=fail")

