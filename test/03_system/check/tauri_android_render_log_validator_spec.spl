"""
## Purpose and audience
Purpose: accepts complete Android WebView Vulkan render-log proof
Audience: compiler and tooling engineers who maintain this spec

# Tauri Android render-log validator

## Overview

Validates the Android mobile render-log proof used by the Tauri renderer
evidence wrappers. A pass must include a clean Tauri render marker, Android
Vulkan/HWUI evidence, coherent source proof, and no failure markers.

**Plan:** doc/03_plan/platform/mobile_tauri_gui_parallel_2026-05-29.md
**Requirements:** N/A
**Research:** N/A
**Design:** doc/07_guide/tooling/renderdoc_capture_infra.md

## Syntax

```sh
SIMPLE_LIB=src bin/simple test test/03_system/check/tauri_android_render_log_validator_spec.spl --mode=interpreter --clean --fail-fast
```

## Acceptance

- Complete Android Tauri WebView/Vulkan logs validate and emit normalized rows.
- The Tauri render marker must include a clean positive decimal `html_len`.
- Implausibly high Android render `html_len` values fail closed instead of
  counting as valid rendered-surface proof.
- Render-only or generic Vulkan-only logs fail closed.
- Render and Vulkan markers must be coherent within one source log.
- Passing validation binds `html_len` to the coherent Vulkan-backed render-log
  source instead of an unrelated companion render marker.
- The direct Android renderer wrapper emits coherent render-log source actual
  byte size plus file status/reason rows and fails closed when that artifact is
  missing, symlinked, hardlinked, or size-mutated after validation.
- Explicitly requested Android log source paths must exist and be nonempty; a
  valid companion log cannot hide a missing or empty render-log source artifact.
- Explicitly requested Android log source paths must not be symlinks or
  hardlinks to stale or attacker-controlled render-log artifacts.
- Explicitly requested Android log source paths must not duplicate the same
  canonical render-log artifact.
- Failure markers fail closed even when render and Vulkan markers are present.
- The Android renderer wrapper and mobile aggregate are wired to the validator
  contract.
- The Android renderer wrapper persists render-log and MDI validator output and
  re-emits validator-derived event/capture/performance/input-to-paint/animation
  rows.
## Operator workflow

Each scenario runs the packaged validator (via `node scripts/check/...` or a
direct process invocation) against a complete proof document or a proof mutated
in exactly one field, and asserts the validator exit code and normalized rows.

## Compatibility and limitations

Scenarios that replay the Android WebView render log need the captured log artifact; validator-only scenarios run from a plain repo checkout.

## Verification guidance and troubleshooting

A RED reject scenario is the fail-closed contract working: rerun the scenario and
inspect the cited validator command with the mutated field restored to confirm the
regression. A RED accept scenario means the packaged proof itself regressed;
recapture it with the scripts/check command named in the scenario before shipping.

"""

# @tag: system, gui, tauri, android, vulkan, renderer

use std.io_runtime.{dir_create_all, dir_remove_all, file_read, file_write_exact, process_run}
use std.spec.*

# Lifecycle: doc/01_research/ui/render_path/electron_tauri_vulkan_enablement_2026-06-16.md ;
# doc/03_plan/platform/mobile_tauri_gui_parallel_2026-05-29.md ;
# doc/04_architecture/ui/simple_gui_stack.md ;
# doc/05_design/gpu_renderer_processing_backends_metal.md
# @manual_section: proof validators

fn _valid_android_log() -> text:
    "[tauri-shell] render, html_len=4096\nHWUI Vulkan renderer ready VK_ANDROID_native_buffer\nforeground=com.simple.ui\n"

fn _prepare_dir(root: text):
    val _removed = dir_remove_all(root)
    expect(dir_create_all(root)).to_equal(true)

fn _run_validator(logs: [text]) -> (text, i64):
    var args: [text] = ["scripts/check/validate-tauri-android-render-log-proof.js"]
    for log_path in logs:
        args.push(log_path)
    val (stdout, _stderr, code) = process_run("node", args)
    (stdout, code)

fn _create_symlink(target: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').symlinkSync(process.argv[1], process.argv[2])", target, link_path])
    code

fn _create_hardlink(existing_path: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').linkSync(process.argv[1], process.argv[2])", existing_path, link_path])
    code

describe "Tauri Android render-log validator":

    it "accepts complete Android WebView Vulkan render-log proof":
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        step("Verify: accepts complete Android WebView Vulkan render-log proof")
        # @req: REQ-CHECK-TaurAndrRendLogVali-001
        val root = "build/test-tauri-android-render-log-validator-pass"
        _prepare_dir(root)
        val log_path = root + "/android.log"
        expect(file_write_exact(log_path, _valid_android_log())).to_equal(true)
        val (evidence, code) = _run_validator([log_path])
        expect(code).to_equal(0)  # oracle: validator exits 0 only for a complete well-formed proof (fail-closed exit contract)

        step("Inspect normalized Android render-log rows")
        expect(evidence).to_contain("android_render_log_validation_status=pass")
        expect(evidence).to_contain("android_render_log_validation_reason=pass")
        expect(evidence).to_contain("android_render_log_requested_source_count=1")
        expect(evidence).to_contain("android_render_log_source_count=1")
        expect(evidence).to_contain("android_render_log_missing_source_count=0")
        expect(evidence).to_contain("android_render_log_empty_source_count=0")
        expect(evidence).to_contain("android_render_log_symlink_source_count=0")
        expect(evidence).to_contain("android_render_log_hardlink_source_count=0")
        expect(evidence).to_contain("android_render_log_duplicate_source_count=0")
        expect(evidence).to_contain("android_render_log_html_len=4096")
        expect(evidence).to_contain("android_render_log_source_coherence_status=pass")
        expect(evidence).to_contain("android_render_log_coherent_source_path=" + log_path)
        expect(evidence).to_contain("android_render_log_coherent_source_size_bytes=113")
        expect(evidence).to_contain("android_render_log_marker_status=pass")
        expect(evidence).to_contain("android_render_log_vulkan_marker_status=pass")
        expect(evidence).to_contain("android_render_log_foreground_marker_status=pass")
        expect(evidence).to_contain("android_render_log_failure_marker_status=pass")

    it "binds html length evidence to the coherent Android Vulkan source":
        # @req: REQ-CHECK-TaurAndrRendLogVali-002
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        val root = "build/test-tauri-android-render-log-validator-coherent-html-len"
        _prepare_dir(root)
        val render_only = root + "/render-only.log"
        val android_log = root + "/android.log"
        expect(file_write_exact(render_only, "[tauri-shell] render, html_len=999\n")).to_equal(true)
        expect(file_write_exact(android_log, _valid_android_log())).to_equal(true)
        val (evidence, code) = _run_validator([render_only, android_log])
        expect(code).to_equal(0)  # oracle: validator exits 0 only for a complete well-formed proof (fail-closed exit contract)

        step("Confirm html_len is emitted from the coherent Vulkan source")
        expect(evidence).to_contain("android_render_log_validation_status=pass")
        expect(evidence).to_contain("android_render_log_requested_source_count=2")
        expect(evidence).to_contain("android_render_log_source_count=2")
        expect(evidence).to_contain("android_render_log_duplicate_source_count=0")
        expect(evidence).to_contain("android_render_log_source_coherence_status=pass")
        expect(evidence).to_contain("android_render_log_coherent_source_path=" + android_log)
        expect(evidence).to_contain("android_render_log_coherent_source_size_bytes=113")
        expect(evidence).to_contain("android_render_log_html_len=4096")
        expect_not(evidence.contains("android_render_log_html_len=999"))

    it "rejects malformed Android render html length markers":
        # @req: REQ-CHECK-TaurAndrRendLogVali-003
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        step("Verify: rejects malformed Android render html length markers")
        val root = "build/test-tauri-android-render-log-validator-html-len"
        _prepare_dir(root)
        val suffix_log = root + "/suffix.log"
        val zero_log = root + "/zero.log"
        val huge_log = root + "/huge.log"
        expect(file_write_exact(suffix_log, "[tauri-shell] render, html_len=4096px\nHWUI Vulkan renderer ready\n")).to_equal(true)
        expect(file_write_exact(zero_log, "[tauri-shell] render, html_len=0\nHWUI Vulkan renderer ready\n")).to_equal(true)
        expect(file_write_exact(huge_log, "[tauri-shell] render, html_len=10000001\nHWUI Vulkan renderer ready VK_ANDROID_native_buffer\n")).to_equal(true)
        val (suffix, suffix_code) = _run_validator([suffix_log])
        val (zero, zero_code) = _run_validator([zero_log])
        val (huge, huge_code) = _run_validator([huge_log])
        expect(suffix_code).to_equal(1)  # oracle: validator exits 1 on the injected defect (fail-closed reject contract)
        expect(zero_code).to_equal(1)  # oracle: validator exits 1 on the injected defect (fail-closed reject contract)
        expect(huge_code).to_equal(1)  # oracle: validator exits 1 on the injected defect (fail-closed reject contract)

        expect(suffix).to_contain("android_render_log_validation_reason=android-render-log-html-len-malformed")
        expect(suffix).to_contain("android_render_log_marker_status=fail")
        expect(suffix).to_contain("android_render_log_html_len=")
        expect(zero).to_contain("android_render_log_validation_reason=android-render-log-html-len-malformed")
        expect(zero).to_contain("android_render_log_marker_status=fail")
        expect(zero).to_contain("android_render_log_html_len=")
        expect(huge).to_contain("android_render_log_validation_reason=android-render-log-html-len-malformed")
        expect(huge).to_contain("android_render_log_marker_status=fail")
        expect(huge).to_contain("android_render_log_html_len=")
        expect_not(huge.contains("android_render_log_html_len=10000001"))

    it "rejects missing Vulkan render backing markers":
        # @req: REQ-CHECK-TaurAndrRendLogVali-004
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        step("Verify: rejects missing Vulkan render backing markers")
