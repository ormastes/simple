    it "rejects Android render-log failure markers":
        # @req: REQ-CHECK-TaurAndrRendLogVali-012
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        step("Verify: rejects Android render-log failure markers")
        val root = "build/test-tauri-android-render-log-validator-failure"
        _prepare_dir(root)
        val android_log = root + "/android.log"
        expect(file_write_exact(android_log, "[tauri-shell] render, html_len=4096\nHWUI Vulkan renderer ready\nFatal signal 11\n")).to_equal(true)
        val (evidence, code) = _run_validator([android_log])
