    it "keeps the Android renderer wrapper and mobile aggregate wired to the validator":
        # @req: REQ-CHECK-TaurAndrRendLogVali-013
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        step("Verify: keeps the Android renderer wrapper and mobile aggregate wired to the validator")
        val direct = file_read("scripts/check/check-tauri-android-mobile-renderer-evidence.shs")
        val aggregate = file_read("scripts/check/check-tauri-mobile-renderer-parity-evidence.shs")
