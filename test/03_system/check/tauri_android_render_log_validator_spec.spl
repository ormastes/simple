    it "rejects symlinked requested Android log source paths":
        # @req: REQ-CHECK-TaurAndrRendLogVali-008
        # @capture(protocol_json): validator exit code and normalized verdict rows retained for review
        step("Verify: rejects symlinked requested Android log source paths")
        val root = "build/test-tauri-android-render-log-validator-symlink-source"
        val external = "build/test-tauri-android-render-log-validator-symlink-source-external"
        _prepare_dir(root)
        _prepare_dir(external)
        val android_log = root + "/android.log"
        val ext_log = external + "/android.log"
        val linked_log = root + "/linked.log"
        expect(file_write_exact(android_log, _valid_android_log())).to_equal(true)
        expect(file_write_exact(ext_log, _valid_android_log())).to_equal(true)
        expect(_create_symlink("../test-tauri-android-render-log-validator-symlink-source-external/android.log", linked_log)).to_equal(0)
        val (evidence, code) = _run_validator([android_log, linked_log])
        expect(code).to_equal(1)  # oracle: validator exits 1 on the injected defect (fail-closed reject contract)

        expect(evidence).to_contain("android_render_log_validation_status=fail")
        expect(evidence).to_contain("android_render_log_validation_reason=android-render-log-source-symlink")
        expect(evidence).to_contain("android_render_log_requested_source_count=2")
        expect(evidence).to_contain("android_render_log_source_count=1")
        expect(evidence).to_contain("android_render_log_missing_source_count=0")
        expect(evidence).to_contain("android_render_log_empty_source_count=0")
