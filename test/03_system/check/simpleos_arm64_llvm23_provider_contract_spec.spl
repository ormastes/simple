
# @cover src/lib/nogc_sync_mut/io/process_ops.spl 60%
# @cover scripts/check/check-llvm-23-1-provider-builder-contract.shs
# @cover scripts/check/check-llvm-23-1-provider-snapshot-contract.shs
# @cover scripts/check/check-simpleos-arm64-llvm23-provider-contract.shs
# @cover scripts/check/check-freebsd-llvm-23-1-provider-contract.shs

"""Executable, fail-closed LLVM 23.1 provider evidence for SimpleOS ARM64."""

use app.io.process_ops.{process_run_timeout}
use std.spec.*

val CONTRACT_TIMEOUT_MS: i64 = 120000
val BUILDER_CONTRACT: text = "scripts/check/check-llvm-23-1-provider-builder-contract.shs"
val SNAPSHOT_CONTRACT: text = "scripts/check/check-llvm-23-1-provider-snapshot-contract.shs"
val ARM_CONTRACT: text = "scripts/check/check-simpleos-arm64-llvm23-provider-contract.shs"
val FREEBSD_CONTRACT: text = "scripts/check/check-freebsd-llvm-23-1-provider-contract.shs"

fn run_contract(path: text) -> (text, text, i32):
    process_run_timeout("/bin/sh", [path], CONTRACT_TIMEOUT_MS)

fn combined_output(stdout: text, stderr: text) -> text:
    stdout + "\n" + stderr

fn assert_required_pass(output: text, exit_code: i32, pass_marker: text):
    expect(exit_code).to_equal(0)
    expect(output).to_contain(pass_marker)
    expect(output.contains("FAIL:")).to_equal(false)

describe "SimpleOS ARM64 LLVM 23.1 provider evidence":
    it "executes the signed builder receipt contract within the test deadline":
        step("Run the bounded builder contract")
        val (stdout, stderr, exit_code) = run_contract(BUILDER_CONTRACT)
        val output = combined_output(stdout, stderr)
        assert_required_pass(
            output,
            exit_code,
            "PASS: LLVM 23.1 provider builder is pinned, explicit, and fail-closed")

    it "executes the private snapshot sealing and reuse contract":
        step("Run the bounded snapshot contract")
        val (stdout, stderr, exit_code) = run_contract(SNAPSHOT_CONTRACT)
        val output = combined_output(stdout, stderr)
        assert_required_pass(
            output,
            exit_code,
            "PASS: LLVM 23.1 provider snapshots are locked, atomic, immutable, and reusable")

    it "executes ARM receipt admission, allowing only explicit missing-checkout unavailability":
        step("Run the bounded ARM provider contract")
        val (stdout, stderr, exit_code) = run_contract(ARM_CONTRACT)
        val output = combined_output(stdout, stderr)
        if output.contains("UNAVAILABLE:"):
            expect(exit_code).to_equal(2)
            expect(output).to_contain("SIMPLE_LLVM_23_1_TEST_SOURCE_DIR")
            expect(output.contains("PASS:")).to_equal(false)
        else:
            assert_required_pass(
                output,
                exit_code,
                "PASS: ARM64 LLVM 23.1 provider rejects escaped tools, LLVM 18 tools, and retargeted tag receipts")
            for receipt in [
                "arm64_llvm_provider_canonical_rejection_status=pass",
                "arm64_llvm_provider_version_rejection_status=pass",
                "arm64_llvm_provider_tag_commit_rejection_status=pass",
                "arm64_llvm_provider_contract_self_test_status=pass",
                "arm64_llvm_provider_isolated_keyring_status=pass",
                "arm64_llvm_provider_untrusted_signer_rejection_status=pass",
                "arm64_llvm_provider_isolated_builder_verify_tag_status=pass"
            ]:
                expect(output).to_contain(receipt)

    it "executes the FreeBSD provider receipt contract with the complete tool set":
        step("Run the bounded FreeBSD receipt contract")
        val (stdout, stderr, exit_code) = run_contract(FREEBSD_CONTRACT)
        val output = combined_output(stdout, stderr)
        assert_required_pass(
            output,
            exit_code,
            "PASS: FreeBSD QEMU bootstrap requires one complete explicit LLVM 23.1 provider")
