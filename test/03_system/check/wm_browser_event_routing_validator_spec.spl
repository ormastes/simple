        _write_proof(info, root + "/proof.json", [
            _kv("css_animation_final_opacity", "0.25"),
            _kv("css_animation_final_current_time_ms", "0"),
            _kv("css_animation_motion_observed", "true"),
            _kv("css_animation_probe", "true")
        ])
        val (evidence, code) = _run_validator(root + "/proof.json")
        expect(code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence
        expect(evidence).to_contain("wm_browser_event_routing_validation_reason=event-routing-performance-animation-contract-missing")

