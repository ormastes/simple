# @cover scripts/check/check-simple-web-browser-conformance-contract.shs 80%
# @cover scripts/check/check-wm-browser-event-routing-evidence.shs 80%
# @req: REQ-CHECK-001
"""
## Purpose and audience
Purpose: accepts complete event timing animation payload and UI proof
Audience: compiler and tooling engineers who maintain this spec

# WM browser event-routing proof validator

## Overview

Validates the standalone WM browser event-routing proof validator. The
validator consumes the raw Electron probe JSON and fails closed when a stale or
forged `pass=true` row omits Chromium event, timing, animation, payload, or UI
details.

**Plan:** doc/03_plan/ui/tui/production_gui_web_renderer_parity_hardening.md
**Requirements:** doc/02_requirements/feature/simple_web_browser_engine_production_hardening.md
**NFR:** doc/02_requirements/nfr/simple_web_browser_engine_production_hardening.md
**Research:** N/A
**Design:** doc/07_guide/tooling/renderdoc_capture_infra.md

## Syntax

```sh
SIMPLE_LIB=src bin/simple test test/03_system/check/wm_browser_event_routing_validator_spec.spl --mode=interpreter --clean --fail-fast
```

## Acceptance

- Complete Electron WM event-routing JSON validates and emits normalized
  `wm_browser_event_routing_*` rows.
- `pass=true` JSON still fails when event counts, Chromium timing, animation,
  payload details, or UI proof rows are missing or malformed.
- The raw frame stream must include the canonical event sequence from host pointer, focus,
  drag move, title command, maximize, text input, pointer down, and pointer up;
  counts alone are not enough event-routing proof.
- Aggregate window-command and input-event counts must match the canonical
  frame stream so a forged proof cannot hide dropped or extra frames behind a
  matching event sequence.
- The internal window panel must expose a real vertical scroll policy, content
  taller than its viewport, a 0-to-40 scroll transition, and a delivered DOM
  scroll event.
- Chromium timing must include an explicit positive `performance.now()` delta;
  `0` does not prove distinct timing samples, and multi-second timing does not
  prove responsive event-loop progress.
- Input handling must include an explicit positive input-to-paint measurement
  sampled after a dispatched DOM interaction and a following animation frame;
  multi-second latency fails the event contract.
- Boolean readiness, timing, animation, and CSS probe fields must be real JSON
  booleans; string values like `"true"` are not structured event proof and are
  not re-emitted as normalized boolean rows.
- Event counts, animation frame counts, traffic button counts, timing deltas,
  and dispatched move coordinates must be real JSON numbers; stringified,
  fractional, unsafe, or exponential integer values are not valid DOM
  event-routing proof and are not re-emitted as normalized numeric rows.
- Live numeric UI readback rows such as title font weight and title input width
  must be real JSON numbers; stringified CSS measurements are not valid browser
  style proof.
- The proof must carry the live WM browser event-check surface identity and
  source marker; a hand-authored JSON object with matching counters is not
  sufficient.
- The proof source marker must resolve to a single-link regular nonempty
  producer source file with expected event, timing, and animation markers so
  stale JSON cannot be paired with a missing, substituted, or aliased
  event-check script.
- The proof source validator must report both the expected producer `lstat`
  size and the actual bytes read from that producer, and fail closed if those
  sizes diverge.
- The proof source validator and live shell wrapper must emit normalized
  source artifact reason/status rows so production gates can distinguish a
  valid producer file from substituted, missing, or aliased event-check source.
- The proof must carry live Electron/Chromium runtime identity, including browser
  engine, Electron user-agent, Electron process version, and Chrome process
  version.
- The proof JSON path itself must be a single regular file, never a symlink or
  hardlink to stale or attacker-controlled event-routing evidence.
- The live shell evidence wrapper consumes the standalone validator instead of
  trusting only the probe's top-level `pass` flag.

## Operator workflow

Run the spec with the command in the Syntax section. Each scenario builds a
fixture proof JSON under `build/test-wm-browser-event-validator-*`, invokes the
standalone validator via `node scripts/check/validate-wm-browser-event-routing-proof.js`,
and asserts on the normalized evidence rows the validator emits.

## Compatibility and limitations

Requires `node` on PATH and write access to `build/`. Reject scenarios assert
exit code 1 from the validator, so any validator crash (not clean reject) also
fails the scenario. Browser runtime fields are fixture-stamped; only the
producer source contract is read from the real tree.

## Verification guidance and troubleshooting

A failed `accepts complete...` scenario means the happy-path fixture was
rejected: read the retained `evidence.env` capture for the failing
`wm_browser_event_routing_validation_reason` row. A failed `rejects...`
scenario means the validator accepted forged evidence — treat as a real
product defect and file it; never soften the assertion.
"""

# Lifecycle: doc/01_research/domain/chromium_web_renderer_primitive_differential.md ;
# doc/03_plan/ui/tui/production_gui_web_renderer_parity_hardening.md ;
# doc/04_architecture/chromium_web_renderer_primitive_differential.md ;
# doc/05_design/browser_wasm_webgpu_infra.md

# @tag: system, gui, renderer, event-routing, electron, evidence

use std.io_runtime.{dir_create_all, dir_remove_all, file_copy, file_exists, file_read, file_write_bytes, file_write_exact, process_run}
use std.spec.*

struct KV:
    key: text
    value: text

fn _kv(key: text, value: text) -> KV:
    KV(key: key, value: value)

fn _aetheric_html_text() -> text:
    "<html><body><main data-aetheric-production-surface=\"true\"></main></body></html>"

fn _simple_argb_text() -> text:
    "{{\"width\":1,\"height\":1,\"format\":\"argb-u32\",\"producer\":\"pure-simple-html-webir-drawir-engine2d\",\"pixels\":[1]}}"

fn _ensure_meta() -> [text]:
    val meta_path = "build/.tmp_wm_browser_meta.txt"
    if not file_exists(meta_path):
        expect(dir_create_all("build")).to_equal(true)
        val ah_tmp = "build/.tmp_wm_browser_aetheric.html"
        val sa_tmp = "build/.tmp_wm_browser_simple.argb.json"
        expect(file_write_exact(ah_tmp, _aetheric_html_text())).to_equal(true)
        expect(file_write_exact(sa_tmp, _simple_argb_text())).to_equal(true)
        val js = "const fs=require('fs'),path=require('path'),crypto=require('crypto');const snap=fs.readFileSync('src/lib/common/ui/generated/aetheric_dark_theme_snapshot.spl','utf8');const m1=(snap.match(/source_manifest_sha256: .([0-9a-f]+)/)||[])[1]||'';const m2=(snap.match(/material_sha256: .([0-9a-f]+)/)||[])[1]||'';const ah=crypto.createHash('sha256').update(fs.readFileSync(process.argv[1])).digest('hex');const sab=fs.readFileSync(process.argv[2]);const sash=crypto.createHash('sha256').update(sab).digest('hex');fs.writeFileSync(process.argv[3],[process.cwd(),path.sep,m1,m2,ah,String(sab.length),sash].join('\\n'));"
        val (_out, _err, code) = process_run("node", ["-e", js, ah_tmp, sa_tmp, meta_path])
        expect(code).to_equal(0)
    file_read(meta_path).split("\n")

fn _json_escape(s: text) -> text:
    s.replace("\\", "\\\\").replace("\"", "\\\"")

fn _prepare_dir(root: text) -> (text, text, text, text, text, text):
    val _removed = dir_remove_all(root)
    expect(dir_create_all(root)).to_equal(true)
    val meta = _ensure_meta()
    val cwd = meta[0].trim()
    val sep = meta[1].trim()
    val manifest = meta[2].trim()
    val material = meta[3].trim()
    val ahs = meta[4].trim()
    val sab_len = meta[5].trim()
    val sash = meta[6].trim()
    val norm_root = if sep == "\\": root.replace("/", "\\") else: root
    val abs_dir = cwd + sep + norm_root
    val ah = abs_dir + sep + "aetheric.html"
    val ae = abs_dir + sep + "aetheric.env"
    val sap = abs_dir + sep + "simple-frame.argb.json"
    val srp = abs_dir + sep + "simple-composition.env"
    val frame_path = abs_dir + sep + "wm-font-frame.bgra"

    expect(file_write_exact(root + "/aetheric.html", _aetheric_html_text())).to_equal(true)
    val aetheric_env = "schema=aetheric-host-web-gui-v1\nstatus=pass\nproducer=production-html-webir-drawir-electron\ntheme_id=aetheric_dark\ntheme_source_manifest_sha256=" + manifest + "\ntheme_material_sha256=" + material + "\nhtml_path=" + ah + "\nhtml_sha256=" + ahs + "\npost_action_semantic_state=text-mutated-and-focused\nblur_or_tolerance_used=false\nsynthetic_fixture=false\nraw_source_execution=false\ncompatibility_renderer=false\ncomputed_window_background=rgba(31, 31, 33, 0.8)\ncomputed_window_border_color=rgba(139, 144, 160, 0.2)\ncomputed_window_border_radius=18px\ncomputed_window_box_shadow=0 28px 76px rgba(0, 0, 0, 0.46)\ncomputed_titlebar_backdrop_filter=blur(30px) saturate(170%)\ncomputed_titlebar_webkit_backdrop_filter=blur(30px) saturate(170%)\ncomputed_inactive_border=rgba(139, 144, 160, 0.2)\ncomputed_inactive_shadow=0 18px 46px rgba(0, 0, 0, 0.34)\ncomputed_active_border=rgba(193, 198, 215, 0.3)\ncomputed_active_shadow=0 28px 76px rgba(0, 0, 0, 0.46)\n"
    expect(file_write_exact(root + "/aetheric.env", aetheric_env)).to_equal(true)
    expect(file_write_exact(root + "/simple-frame.argb.json", _simple_argb_text())).to_equal(true)
    val comp_env = "schema=simple-web-font-composition-v1\nstatus=pass\nrun_id=fixture-run\nproducer=pure-simple-html-webir-drawir-engine2d\nsurface_id=simple-web-font-proof\ncomposition_id=html-layout\ntext=WEB\nfont_identity=sha256=2cb2adb378a8f574213e23df697050b83c54c27df465a2015552740b2769a081;axes=wght=400,wdth=100\nfont_advance_widths=1,1,1\nviewport_width=1\nviewport_height=1\npixel_count=1\npixel_checksum=1\npixel_artifact_path=" + sap + "\npixel_artifact_size_bytes=" + sab_len + "\npixel_artifact_sha256=" + sash + "\n"
    expect(file_write_exact(root + "/simple-composition.env", comp_env)).to_equal(true)
    expect(file_write_bytes(root + "/wm-font-frame.bgra", [0u8, 0u8, 0u8, 255u8])).to_equal(true)
    (abs_dir, sep, manifest, material, ahs, sab_len + "|" + sash)

fn _find_override(overrides: [KV], key: text) -> text:
    for item in overrides:
        if item.key == key:
            return item.value
    "__DEFAULT__"

fn _write_proof(root_info: (text, text, text, text, text, text), proof_path: text, overrides: [KV]):
    val abs_dir = root_info.0
    val sep = root_info.1
    val manifest = root_info.2
    val material = root_info.3
    val ahs = root_info.4
    val sab_parts = root_info.5.split("|")
    val sab_len = sab_parts[0]
    val sash = sab_parts[1]
    val ah = _json_escape(abs_dir + sep + "aetheric.html")
    val ae = _json_escape(abs_dir + sep + "aetheric.env")
    val sap = _json_escape(abs_dir + sep + "simple-frame.argb.json")
    val srp = _json_escape(abs_dir + sep + "simple-composition.env")
    val frame_path = _json_escape(abs_dir + sep + "wm-font-frame.bgra")

    val defaults = [
        "pass", "true",
        "target", "\"electron\"",
        "surface_id", "\"wm-browser-event-routing\"",
        "proof_source", "\"tools/web-render-backend/wm_event_check.js\"",
        "browser_engine", "\"chromium\"",
        "electron_user_agent", "\"Mozilla/5.0 Chrome/142.0.0.0 Electron/42.5.0 Safari/537.36\"",
        "electron_process_version", "\"42.5.0\"",
        "chrome_process_version", "\"142.0.0.0\"",
        "renderer_sandboxed", "true",
        "gpu_feature_status", "{{\"gpu_compositing\":\"enabled\",\"webgl\":\"enabled\"}}",
        "ready", "true",
        "wm_found", "true",
        "window_cmd_count", "4",
        "input_event_count", "3",
        "focus_count", "1",
        "move_count", "1",
        "maximize_count", "1",
        "title_command_count", "1",
        "text_input_count", "1",
        "pointer_down_count", "1",
        "pointer_up_count", "1",
        "scroll_panel_overflow_y", "\"scroll\"",
        "scroll_panel_client_height", "48",
        "scroll_panel_scroll_height", "160",
        "scroll_panel_before", "0",
        "scroll_panel_after", "40",
        "scroll_panel_event_count", "1",
        "event_sequence", "[\"host_wm_pointer:down\",\"window_cmd:focus\",\"window_cmd:move\",\"window_cmd:title_command\",\"window_cmd:maximize\",\"input_event:text_input\",\"input_event:pointer_down\",\"input_event:pointer_up\"]",
        "performance_now_available", "true",
        "performance_now_delta_ms", "16.7",
        "input_to_paint_ms", "18.4",
        "animation_frame_available", "true",
        "animation_frame_count", "2",
        "css_animation_initial_opacity", "0.25",
        "css_animation_final_opacity", "0.5",
        "css_animation_initial_current_time_ms", "0",
        "css_animation_final_current_time_ms", "32",
        "css_animation_motion_observed", "true",
        "css_animation_probe", "true",
        "title_text", "\"Terminal\"",
        "title_context_text", "\"terminal\"",
        "traffic_button_count", "3",
        "title_input_tag", "\"input\"",
        "titlebar_height", "\"34px\"",
        "titlebar_display", "\"flex\"",
        "titlebar_cursor", "\"grab\"",
        "titlebar_background", "\"rgb(229, 231, 235)\"",
        "title_color", "\"rgb(17, 24, 39)\"",
        "title_font_weight", "700",
        "title_input_min_width", "\"142px\"",
        "title_input_width", "\"158px\"",
        "title_input_width_px", "158",
        "title_input_height", "\"24px\"",
        "title_input_cursor", "\"text\"",
        "title_input_background", "\"rgb(241, 245, 249)\"",
        "close_button_background", "\"rgb(239, 68, 68)\"",
        "minimize_button_background", "\"rgb(234, 179, 8)\"",
        "maximize_button_background", "\"rgb(34, 197, 94)\"",
        "expected_move_x", "86",
        "expected_move_y", "86",
        "move_payload", "{{\"window_id_hint\":\"win1\",\"source\":\"native_event\",\"x\":86,\"y\":86}}",
        "title_payload", "{{\"command_text\":\"/tmp/project\"}}",
        "text_payload", "{{\"event\":{{\"text\":\"Hello Simple\"}}}}",
        "font_text", "\"WEB\"",
        "font_composition_id", "\"html-layout\"",
        "font_identity", "\"sha256=2cb2adb378a8f574213e23df697050b83c54c27df465a2015552740b2769a081;axes=wght=400,wdth=100\"",
        "font_family", "\"SimplePinnedMono, monospace\"",
        "font_loaded", "true",
        "font_frame_event_count", "8",
        "font_frame_correlation_id", "\"wm-browser-event-routing|fixture-run|html-layout|sha256=2cb2adb378a8f574213e23df697050b83c54c27df465a2015552740b2769a081;axes=wght=400,wdth=100|WEB|1|8\"",
        "font_frame_path", "\"" + frame_path + "\"",
        "font_frame_width", "1",
        "font_frame_height", "1",
        "font_frame_byte_count", "4",
        "font_frame_pixel_checksum", "1785",
        "font_frame_nonbackground_pixels", "1",
        "simple_composition_receipt_path", "\"" + srp + "\"",
        "simple_composition_run_id", "\"fixture-run\"",
        "simple_composition_artifact_path", "\"" + sap + "\"",
        "simple_composition_pixel_count", "1",
        "simple_composition_pixel_checksum", "1",
        "simple_composition_artifact_size_bytes", sab_len,
        "simple_composition_artifact_sha256", "\"" + sash + "\"",
        "production_envelope_schema", "\"aetheric-host-web-gui-v1\"",
        "production_envelope_producer", "\"production-html-webir-drawir-electron\"",
        "production_envelope_path", "\"" + ae + "\"",
        "production_html_path", "\"" + ah + "\"",
        "production_html_sha256", "\"" + ahs + "\"",
        "theme_id", "\"aetheric_dark\"",
        "theme_source_manifest_sha256", "\"" + manifest + "\"",
        "theme_material_sha256", "\"" + material + "\"",
        "production_post_action_semantic_state", "\"text-mutated-and-focused\"",
        "post_action_semantic_state", "\"maximized-and-text-input\"",
        "production_blur_or_tolerance_used", "\"false\"",
        "production_synthetic_fixture", "\"false\"",
        "production_raw_source_execution", "\"false\"",
        "production_compatibility_renderer", "\"false\"",
        "computed_window_background", "\"rgba(31, 31, 33, 0.8)\"",
        "computed_window_border_color", "\"rgba(139, 144, 160, 0.2)\"",
        "computed_window_border_radius", "\"18px\"",
        "computed_window_box_shadow", "\"0 28px 76px rgba(0, 0, 0, 0.46)\"",
        "computed_titlebar_backdrop_filter", "\"blur(30px) saturate(170%)\"",
        "computed_titlebar_webkit_backdrop_filter", "\"blur(30px) saturate(170%)\"",
        "computed_inactive_border", "\"rgba(139, 144, 160, 0.2)\"",
        "computed_inactive_shadow", "\"0 18px 46px rgba(0, 0, 0, 0.34)\"",
        "computed_active_border", "\"rgba(193, 198, 215, 0.3)\"",
        "computed_active_shadow", "\"0 28px 76px rgba(0, 0, 0, 0.46)\""
    ]
    var parts: [text] = []
    val n_ov = overrides.len()
    val n_def = defaults.len()
    var i = 0
    if n_ov == 0:
        while i < n_def:
            parts.push("\"" + defaults[i] + "\":" + defaults[i + 1])
            i = i + 2
    else if n_ov == 1:
        val k0 = overrides[0].key
        val v0 = overrides[0].value
        while i < n_def:
            val dk = defaults[i]
            if dk == k0:
                if v0 != "__OMIT__":
                    parts.push("\"" + dk + "\":" + v0)
            else:
                parts.push("\"" + dk + "\":" + defaults[i + 1])
            i = i + 2
    else:
        while i < n_def:
            val dk = defaults[i]
            val ov = _find_override(overrides, dk)
            if ov != "__OMIT__":
                val value = if ov == "__DEFAULT__": defaults[i + 1] else: ov
                parts.push("\"" + dk + "\":" + value)
            i = i + 2
    val out = "{{" + parts.join(",") + "}}"
    expect(file_write_exact(proof_path, out)).to_equal(true)

fn _ensure_batch_runner() -> text:
    val runner = "build/.tmp_val_batch_runner.js"
    if not file_exists(runner):
        expect(dir_create_all("build")).to_equal(true)
        val raw = "const fs=require('fs'),path=require('path'),Module=require('module');const script=path.resolve(process.argv[2]);const origCwd=process.cwd();const src=fs.readFileSync(script,'utf8').replace(/^#![^\\n]*\\n/,'');const fn=new Function('require','process','console','__filename','__dirname',src);const req=Module.createRequire(script);const results=[];for(const raw of process.argv.slice(3))__LB__ const parts=raw.split('@@SEP@@');const workDir=parts[0];const envSpec=parts[1];const args=parts.slice(2);let out='';let code=0;const fakeEnv=Object.assign(__LB____RB__,process.env);if(envSpec)for(const kv of envSpec.split(';'))__LB__ const eq=kv.indexOf('=');if(eq>0)__LB__ const k=kv.slice(0,eq),v=kv.slice(eq+1);if(v)fakeEnv[k]=v;else delete fakeEnv[k];__RB__ __RB__;const fakeProc=Object.create(process);fakeProc.env=fakeEnv;fakeProc.argv=[process.execPath,script,...args];fakeProc.exit=(c=0)=>__LB__ code=c;throw __LB____exit:true__RB__;__RB__;const fakeCon=__LB__ log:(...a)=>__LB__ out+=a.map(String).join(' ')+'\\n';__RB__,error:()=>__LB____RB__ __RB__;try__LB__ if(workDir)process.chdir(workDir);fn(req,fakeProc,fakeCon,script,path.dirname(script));__RB__ catch(e)__LB__ if(!e||!e.__exit)code=1;__RB__ finally__LB__ if(workDir)process.chdir(origCwd);__RB__;results.push(String(code)+'<<<CODE_END>>>'+out);__RB__;process.stdout.write(results.join('<<<BATCH_SEP>>>'));"
        val js = raw.replace("__LB__", "{{").replace("__RB__", "}}")
        expect(file_write_exact(runner, js)).to_equal(true)
    runner

fn _run_validator_many(proof_paths: [text]) -> [(text, i64)]:
    val runner = _ensure_batch_runner()
    var cmd_args = [runner, "scripts/check/validate-wm-browser-event-routing-proof.js"]
    for p in proof_paths:
        cmd_args.push("@@SEP@@SIMPLE_WEB_FONT_RUN_ID=fixture-run@@SEP@@" + p)
    val (stdout, _stderr, _code) = process_run("node", cmd_args)
    var out: [(text, i64)] = []
    for chunk in stdout.split("<<<BATCH_SEP>>>"):
        val pair = chunk.split("<<<CODE_END>>>")
        val c = if pair[0].trim() == "0": 0 else: 1
        val body = if pair.len() > 1: pair[1] else: ""
        out.push((body, c))
    out

fn _run_validator_env(proof_path: text, receipt_env: text) -> (text, i64):
    val js = "process.env.SIMPLE_WEB_FONT_RUN_ID='fixture-run';if(process.argv[2])process.env.SIMPLE_WEB_FONT_COMPOSITION_RECEIPT=process.argv[2];process.argv=[process.argv[0],process.argv[1],process.argv[3]];require('./scripts/check/validate-wm-browser-event-routing-proof.js')"
    val (stdout, _stderr, code) = process_run("node", ["-e", js, "scripts/check/validate-wm-browser-event-routing-proof.js", receipt_env, proof_path])
    (stdout, code)

fn _run_validator(proof_path: text) -> (text, i64):
    _run_validator_env(proof_path, "")

fn _run_validator_in_dir(work_dir: text, proof_name: text) -> (text, i64):
    val js = "const path=require('path');process.env.SIMPLE_WEB_FONT_RUN_ID='fixture-run';const s=path.resolve(process.argv[2]);process.chdir(process.argv[1]);process.argv=[process.argv[0],s,process.argv[3]];require(s)"
    val (stdout, _stderr, code) = process_run("node", ["-e", js, work_dir, "scripts/check/validate-wm-browser-event-routing-proof.js", proof_name])
    (stdout, code)

fn _create_symlink(target: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').symlinkSync(process.argv[1], process.argv[2])", target, link_path])
    code

fn _create_hardlink(existing_path: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').linkSync(process.argv[1], process.argv[2])", existing_path, link_path])
    code

fn expect_motion_evidence(evidence: text):
    expect(evidence).to_contain("wm_browser_event_routing_css_animation_initial_opacity=0.25")
    expect(evidence).to_contain("wm_browser_event_routing_css_animation_final_opacity=0.5")
    expect(evidence).to_contain("wm_browser_event_routing_css_animation_initial_current_time_ms=0")
    expect(evidence).to_contain("wm_browser_event_routing_css_animation_final_current_time_ms=32")
    expect(evidence).to_contain("wm_browser_event_routing_css_animation_motion_observed=true")

# @manual_section: WM browser event-routing proof validation

describe "WM browser event-routing proof validator":

    it "accepts complete event timing animation payload and UI proof":
        # @req: REQ-CHECK-001
        # @capture(protocol_json): validator evidence.env rows for the accepted full proof fixture
        step("Verify: accepts complete event timing animation payload and UI proof")
        # @req: REQ-CHECK-WmBrowEvenRoutVali-001
        step("Accept current Stage4 motion evidence")
        val root = "build/test-wm-browser-event-validator-pass"
        val info = _prepare_dir(root)
        _write_proof(info, root + "/proof.json", [])
        val (evidence, code) = _run_validator(root + "/proof.json")
        expect(code).to_equal(0)  # oracle: harness exit 0 proves the wrapper ran; the verdict is asserted from the evidence rows

        expect(evidence).to_contain("wm_browser_event_routing_validation_status=pass")
