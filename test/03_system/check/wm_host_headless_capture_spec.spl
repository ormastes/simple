# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Host-WM Headless Capture Lane Contract

Pins the headless capture lane added to the three host-WM showcase wrappers
(widget, graphics-2D, web-standards) so the matrix's `widget x host-WM`,
`2D x host-WM`, and `web x host-WM` cells can collect evidence without owning
the single physical-window capture lane (see
`doc/08_tracking/bug/wm_showcase_no_headless_lane_2026-07-25.md`).

Static-contract style, matching
`test/03_system/check/wm_production_fullscreen_evidence_spec.spl`: it greps
each wrapper source for the exact env gate, the reused (not reinvented)
compose/blit/PPM-encode calls, and the honest-fail status keys, so a future
edit that silently drops the gate or swaps in fabricated pixels fails this
spec instead of only showing up as a missing matrix cell.
"""

# @tag: system, gui, wm, headless, evidence, pure-simple

use std.spec.step

use std.io_runtime.{file_read}
use std.spec.*

fn expect_headless_lane_contract(script: text, prefix: text, compose_call: text, blit_call: text):
    # Gate: headless mode is checked before the window-only SIMPLE_GUI gate,
    # so it never needs GuiRenderer.create / a physical window.
    expect(script).to_contain("SIMPLE_WM_HEADLESS_CAPTURE")
    expect(script).to_contain("run_headless_capture")
    expect(script).to_contain("if (env_get(\"SIMPLE_WM_HEADLESS_CAPTURE\") ?? \"\") == \"1\":")

    # Reuse, not reinvention: same compositor scene + the same real showcase
    # child content the windowed lane presents (the blit call pulls in the
    # actual child app's rendered frame — never a synthetic fill). Callers
    # pass the exact compose/blit call text for their wrapper's lane: the
    # pixel-array wrappers reuse compose_pixels/blit_child_frame_pixels, the
    # Engine2D-pipeline wrapper reuses compose_scene/blit_child_frame.
    expect(script).to_contain(compose_call)
    expect(script).to_contain(blit_call)
    expect(script).to_contain("wait_for_first_child_frame")

    # PPM output goes through the same encoder/writer the child showcase
    # itself already uses (std.common.image.ppm_decode.encode_ppm_p6 +
    # std.io_runtime.file_write_bytes) — not a bespoke/ad-hoc byte dump.
    expect(script).to_contain("use std.common.image.ppm_decode.{decode_ppm_to_argb, encode_ppm_p6}")
    expect(script).to_contain("use std.io_runtime.{env_get, file_exists, file_read, file_read_bytes, file_write, file_write_bytes")
    expect(script).to_contain("encode_ppm_p6(W.to_u32(), H.to_u32(), present_pixels)")
    expect(script).to_contain("file_write_bytes(ppm_path, ppm_bytes)")

    # Honest-fail gates: fail-closed reasons for every way the lane can fail
    # to produce real pixels, never a fabricated pass.
    expect(script).to_contain("child-spawn-failed")
    expect(script).to_contain("child-bridge-timeout")
    expect(script).to_contain("compositor-window-count")
    expect(script).to_contain("child-frame-timeout")
    expect(script).to_contain("compose-short")
    expect(script).to_contain("ppm-write-failed")
    expect(script).to_contain("blank-or-uniform")
    expect(script).to_contain("HeadlessCaptureMetrics")
    expect(script).to_contain("metrics.varied")
    expect(script).to_contain("metrics.nonzero")
    expect(script).to_contain("metrics.checksum")

    # Status/reason/metrics/provenance are all emitted through the shared
    # `headless_status(prefix, key, value)` helper, which prints
    # "{prefix}_{key}={value}" — the wrapper-specific prefix (asserted by the
    # caller below) fans out to every key at runtime, so the source only needs
    # to route each concern through this one emitter, not spell out every
    # concatenated key literally.
    expect(script).to_contain("fn headless_status(prefix: text, key: text, value: text):")
    expect(script).to_contain("print \"{{prefix}}_{{key}}={{value}}\"")
    expect(script).to_contain("headless_status(prefix, \"status\", \"fail\")")
    expect(script).to_contain("headless_status(prefix, \"status\", \"pass\")")
    expect(script).to_contain("headless_status(prefix, \"reason\", \"blank-or-uniform\")")
    expect(script).to_contain("headless_status(prefix, \"pixels\", present_pixels.len().to_text())")
    expect(script).to_contain("headless_status(prefix, \"nonzero\", metrics.nonzero.to_text())")
    expect(script).to_contain("headless_status(prefix, \"checksum\", metrics.checksum.to_text())")
    expect(script).to_contain("headless_status(prefix, \"ppm_path\", ppm_path)")
    expect(script).to_contain("headless_status(prefix, \"provenance\", \"host-wm-headless-compose\")")

describe "Host-WM headless capture lane contract":
    # @manual scenario evidence

    it "widget showcase host-WM wrapper implements the headless capture lane":
        # @req REQ-SSPEC-SYSTEM
        step("widget showcase host-WM wrapper implements the headless capture lane")
        step("Inspect the widget showcase host-WM wrapper source")
        val script = file_read("examples/06_io/ui/wm_widget_showcase_gui.spl")
        expect_headless_lane_contract(script, "wm_widget_showcase_host_headless", "compose_pixels(comp, trace_path)", "blit_child_frame_pixels(base_pixels, comp, child.pixels, child.w, child.h)")
        expect(script).to_contain("val prefix = \"wm_widget_showcase_host_headless\"")

    it "graphics 2D showcase host-WM wrapper implements the headless capture lane via the shared Engine2D pipeline":
        step("Inspect the graphics 2D showcase host-WM wrapper source")
        val script = file_read("examples/06_io/ui/wm_graphics_2d_showcase_gui.spl")
        expect_headless_lane_contract(script, "wm_graphics_2d_showcase_host_headless", "compose_scene(b, comp, trace_path)", "blit_child_frame(b, comp, child.pixels, child.w, child.h)")
        expect(script).to_contain("val prefix = \"wm_graphics_2d_showcase_host_headless\"")
        # Migrated off the hand-rolled [u32] framebuffer onto the shared
        # Engine2D/DrawIR HAL: chrome via draw_rect_filled, the child app's
        # already-rendered frame via draw_image, single readback via
        # read_pixels() feeding both gui.present_rgba and the PPM encoder.
        expect(script).to_contain('use std.gpu.engine2d.engine.{Engine2D}')
        expect(script).to_contain("b.draw_rect_filled(")
        expect(script).to_contain("b.draw_image(win.x + 4, win.y + 28, child_w, child_h, child_pixels)")
        expect(script).to_contain("b.read_pixels()")

    it "web standards showcase host-WM wrapper implements the headless capture lane":
        # @req REQ-SSPEC-SYSTEM
        step("web standards showcase host-WM wrapper implements the headless capture lane")
        step("Inspect the web standards showcase host-WM wrapper source")
        val script = file_read("examples/06_io/ui/wm_web_standards_showcase_gui.spl")
        expect_headless_lane_contract(script, "wm_web_standards_showcase_host_headless", "compose_scene(b, comp, trace_path)", "blit_child_frame(b, comp, child.pixels, child.w, child.h)")
        expect(script).to_contain("val prefix = \"wm_web_standards_showcase_host_headless\"")

describe "wm web standards child-frame budget regression (wm_web_standards_showcase_child_frame_timeout_2026-08-06)":
    # @req REQ-SSPEC-SYSTEM
    # Regression pin for doc/08_tracking/bug/wm_web_standards_showcase_child_frame_timeout_2026-08-06.md:
    # the headless lane must be reachable without a GUI session and the spawned
    # child's bridge + first-frame handoff must sit under bounded, env-tunable
    # budgets that fail closed with a truthful reason (never a silent hang).

    it "dispatches the headless lane before the GUI gate and bounds the child's bridge and first-frame waits":
        step("Inspect the web standards showcase host-WM wrapper source")
        val script = file_read("examples/06_io/ui/wm_web_standards_showcase_gui.spl")
        # Reachability: headless capture dispatches from main() before the
        # window-only SIMPLE_GUI gate, so the lane runs with no display.
        expect(script).to_contain("if (env_get(\"SIMPLE_WM_HEADLESS_CAPTURE\") ?? \"\") == \"1\":")
        expect(script).to_contain("return run_headless_capture(resolve_repo_root())")
        # Bounded budgets: both handoff waits are deadline-bound and their
        # budgets are env-tunable (defaults: bridge 300s, first frame 180s).
        expect(script).to_contain("val bridge_timeout_ms = env_i64(\"SIMPLE_WM_HEADLESS_CAPTURE_BRIDGE_TIMEOUT_MS\", 300000)")
        expect(script).to_contain("val frame_timeout_ms = env_i64(\"SIMPLE_WM_HEADLESS_CAPTURE_FRAME_TIMEOUT_MS\", 180000)")
        expect(script).to_contain("fn wait_for_first_child_frame(frame_path: text, timeout_ms: i64) -> ChildFrame:")
        expect(script).to_contain("while not child.ok and time_now_unix_micros() < deadline:")
        # Truthful timeout diagnostics: the reason carries the underlying
        # child-frame failure detail, not a bare "timeout".
        expect(script).to_contain("child-frame-timeout:{{child.reason}}")
        # The child's own example watchdog is disabled so the host's bounded
        # budget (not an unbounded wait) governs the handoff.
        expect(script).to_contain("env[\"SIMPLE_TIMEOUT_SECONDS\"] = \"0\"")
        # Windows child launch: the env-overlay native spawn refuses the
        # interpreted/JIT lane (-95), so the wrapper publishes the client env
        # in-process and uses the plain async spawn the interpreter supports.
        expect(script).to_contain("use app.io.env_ops.{{host_os, cwd, env_set}}")
        expect(script).to_contain("return process_spawn_async(simple_bin, [\"run\", showcase_source_path])")
