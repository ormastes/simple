# @cover scripts/check/check-electron-generated-gui-web-parity-evidence.shs 80%
# @req: REQ-CHECK-001
"""
## Purpose and audience
Purpose: selects only self hosted Simple driver candidates in live wrapper
Audience: compiler and tooling engineers who maintain this spec

# Electron generated GUI Web proof validator

## Overview

Validates the Electron generated-GUI Web parity proof validator. The Electron
wrapper captures ARGB pixels through a real Electron Chromium surface, writes
`electron-proof.json`, and consumes normalized validator rows before claiming
pass or divergent evidence.

**Plan:** doc/03_plan/ui/tui/production_gui_web_renderer_parity_hardening.md
**Requirements:** N/A
**Research:** N/A
**Design:** doc/07_guide/tooling/renderdoc_capture_infra.md

## Syntax

```sh
SIMPLE_LIB=src bin/simple test test/03_system/check/electron_generated_gui_web_proof_validator_spec.spl --mode=interpreter --clean --fail-fast
```

## Acceptance

- Complete Electron generated-GUI proof JSON validates and emits normalized
  `electron_generated_gui_web_*` rows.
- Malformed `frame_us` fails closed instead of relying on shell integer
  comparison behavior.
- Blur/tolerance use, missing ARGB capture, missing capture provenance,
  malformed mismatch counts, and checksum mismatches are rejected.
- The live Electron wrapper consumes the validator and still maps real pixel
  mismatches to `divergent` evidence.

## Operator workflow

Run the spec with the command in the Syntax section. Each scenario builds a
fixture proof JSON via `_write_proof`, invokes the validator
(`node scripts/check/validate-electron-generated-gui-web-proof.js`) or the live
wrapper, and asserts on the normalized `electron_generated_gui_web_*` rows.

## Compatibility and limitations

Requires `node` on PATH and write access to `build/`. The live-wrapper
scenarios shell out to `scripts/check/check-electron-generated-gui-web-parity-evidence.shs`
without launching Electron; pixel capture itself is exercised only through
fixture ARGB JSON.

## Verification guidance and troubleshooting

A failed `rejects...` scenario means forged or malformed proof was accepted —
read the retained evidence row named in the assertion for the
`validation_reason` and file a product defect; never soften the assertion. A
failed `accepts...` scenario means the happy-path fixture was rejected: compare
the retained rows against the fixture fields.
"""

# Lifecycle: doc/01_research/domain/chromium_web_renderer_primitive_differential.md ;
# doc/03_plan/ui/tui/production_gui_web_renderer_parity_hardening.md ;
# doc/04_architecture/chromium_web_renderer_primitive_differential.md ;
# doc/05_design/browser_wasm_webgpu_infra.md

# @tag: system, gui, electron, renderer, capture, performance

use std.io_runtime.{dir_create_all, dir_remove_all, file_copy, file_exists, file_read, file_write_exact, process_run}
use std.spec.*

struct KV:
    key: text
    value: text

fn _kv(key: text, value: text) -> KV:
    KV(key: key, value: value)

fn _repeat_csv(elem: text, count: i64) -> text:
    if count <= 0:
        return ""
    var result = ""
    var block = elem
    var remaining = count
    while remaining > 0:
        if remaining % 2 == 1:
            if result == "":
                result = block
            else:
                result = result + "," + block
        remaining = remaining / 2
        if remaining > 0:
            block = block + "," + block
    result

fn _argb_json(width_json: text, height: i64, producer: text, pixel_val: text, pixel_count: i64) -> text:
    "{{\"width\":" + width_json + ",\"height\":" + height.to_string() + ",\"format\":\"argb-u32\",\"producer\":\"" + producer + "\",\"pixels\":[" + _repeat_csv(pixel_val, pixel_count) + "]}}"

fn _write_default_argb(dir: text):
    val tmpl = "build/.tmp_electron_generated_gui_default_argb.json"
    if not file_exists(tmpl):
        expect(dir_create_all("build")).to_equal(true)
        expect(file_write_exact(tmpl, _argb_json("96", 72, "electron-live-capture-page", "4294967295", 96 * 72))).to_equal(true)
    expect(file_copy(tmpl, dir + "/captured.json")).to_equal(true)

fn _prepare_dir(root: text, with_argb: bool):
    val _removed = dir_remove_all(root)
    expect(dir_create_all(root)).to_equal(true)
    if with_argb:
        _write_default_argb(root)

fn _find_override(overrides: [KV], key: text) -> text:
    for item in overrides:
        if item.key == key:
            return item.value
    "__DEFAULT__"

fn _text_in(xs: [text], target: text) -> bool:
    for x in xs:
        if x == target:
            return true
    false

fn _write_proof(proof_path: text, overrides: [KV]):
    val n_ov = overrides.len()
    if n_ov == 0:
        val out = "{{\"renderer\":\"electron-live-capture-page\",\"proof_source\":\"tools/electron-live-bitmap/exact_fixture.js\",\"capture_backend\":\"electron-offscreen-capture-page\",\"compositor_mode\":\"offscreen-osr-exact-srgb\",\"browser_engine\":\"chromium\",\"electron_user_agent\":\"Mozilla/5.0 Chrome/142.0.0.0 Electron/42.5.0 Safari/537.36\",\"electron_process_version\":\"42.5.0\",\"chrome_process_version\":\"142.0.0.0\",\"gpu_feature_status\":{{\"gpu_compositing\":\"disabled_software\",\"rasterization\":\"disabled_software\"}},\"gpu_compositing\":\"disabled_software\",\"gpu_rasterization\":\"disabled_software\",\"scene\":\"generated-gui-widget-html\",\"width\":96,\"height\":72,\"iterations\":3,\"checksum\":\"29686813943040\",\"expected_checksum\":\"29686813943040\",\"weighted_checksum\":\"102612472394117760\",\"expected_weighted_checksum\":\"102612472394117760\",\"mismatch_count\":0,\"frame_us\":1250,\"capture_native_width\":96,\"capture_native_height\":72,\"capture_downsampled\":false,\"captured_argb_path\":\"captured.json\",\"captured_argb_written\":true,\"generated_gui_text_normalization_pixels\":0,\"blur_or_tolerance_used\":false}}"
        expect(file_write_exact(proof_path, out)).to_equal(true)
        return
    val defaults = [
        "renderer", "\"electron-live-capture-page\"",
        "proof_source", "\"tools/electron-live-bitmap/exact_fixture.js\"",
        "capture_backend", "\"electron-offscreen-capture-page\"",
        "compositor_mode", "\"offscreen-osr-exact-srgb\"",
        "browser_engine", "\"chromium\"",
        "electron_user_agent", "\"Mozilla/5.0 Chrome/142.0.0.0 Electron/42.5.0 Safari/537.36\"",
        "electron_process_version", "\"42.5.0\"",
        "chrome_process_version", "\"142.0.0.0\"",
        "gpu_feature_status", "{{\"gpu_compositing\":\"disabled_software\",\"rasterization\":\"disabled_software\"}}",
        "gpu_compositing", "\"disabled_software\"",
        "gpu_rasterization", "\"disabled_software\"",
        "scene", "\"generated-gui-widget-html\"",
        "width", "96",
        "height", "72",
        "iterations", "3",
        "checksum", "\"29686813943040\"",
        "expected_checksum", "\"29686813943040\"",
        "weighted_checksum", "\"102612472394117760\"",
        "expected_weighted_checksum", "\"102612472394117760\"",
        "mismatch_count", "0",
        "frame_us", "1250",
        "capture_native_width", "96",
        "capture_native_height", "72",
        "capture_downsampled", "false",
        "captured_argb_path", "\"captured.json\"",
        "captured_argb_written", "true",
        "generated_gui_text_normalization_pixels", "0",
        "blur_or_tolerance_used", "false"
    ]
    var parts: [text] = []
    var seen_ov: [text] = []
    val n_def = defaults.len()
    var i = 0
    if n_ov == 1:
        val k0 = overrides[0].key
        val v0 = overrides[0].value
        while i < n_def:
            val dk = defaults[i]
            if dk == k0:
                seen_ov.push(dk)
                if v0 != "__OMIT__":
                    parts.push("\"" + dk + "\":" + v0)
            else:
                parts.push("\"" + dk + "\":" + defaults[i + 1])
            i = i + 2
    else:
        while i < n_def:
            val dk = defaults[i]
            val ov = _find_override(overrides, dk)
            if ov != "__DEFAULT__":
                seen_ov.push(dk)
            if ov != "__OMIT__":
                val value = if ov == "__DEFAULT__": defaults[i + 1] else: ov
                parts.push("\"" + dk + "\":" + value)
            i = i + 2
    for extra in overrides:
        if extra.value != "__OMIT__" and not _text_in(seen_ov, extra.key):
            parts.push("\"" + extra.key + "\":" + extra.value)
    expect(file_write_exact(proof_path, "{{" + parts.join(",") + "}}")).to_equal(true)

fn _ensure_batch_runner() -> text:
    val runner = "build/.tmp_val_batch_runner.js"
    if not file_exists(runner):
        expect(dir_create_all("build")).to_equal(true)
        val raw = "const fs=require('fs'),path=require('path'),Module=require('module');const script=path.resolve(process.argv[2]);const origCwd=process.cwd();const src=fs.readFileSync(script,'utf8').replace(/^#![^\\n]*\\n/,'');const fn=new Function('require','process','console','__filename','__dirname',src);const req=Module.createRequire(script);const results=[];for(const raw of process.argv.slice(3))__LB__ const parts=raw.split('@@SEP@@');const workDir=parts[0];const envSpec=parts[1];const args=parts.slice(2);let out='';let code=0;const fakeEnv=Object.assign(__LB____RB__,process.env);if(envSpec)for(const kv of envSpec.split(';'))__LB__ const eq=kv.indexOf('=');if(eq>0)__LB__ const k=kv.slice(0,eq),v=kv.slice(eq+1);if(v)fakeEnv[k]=v;else delete fakeEnv[k];__RB__ __RB__;const fakeProc=Object.create(process);fakeProc.env=fakeEnv;fakeProc.argv=[process.execPath,script,...args];fakeProc.exit=(c=0)=>__LB__ code=c;throw __LB____exit:true__RB__;__RB__;const fakeCon=__LB__ log:(...a)=>__LB__ out+=a.map(String).join(' ')+'\\n';__RB__,error:()=>__LB____RB__ __RB__;try__LB__ if(workDir)process.chdir(workDir);fn(req,fakeProc,fakeCon,script,path.dirname(script));__RB__ catch(e)__LB__ if(!e||!e.__exit)code=1;__RB__ finally__LB__ if(workDir)process.chdir(origCwd);__RB__;results.push(String(code)+'<<<CODE_END>>>'+out);__RB__;process.stdout.write(results.join('<<<BATCH_SEP>>>'));"
        val js = raw.replace("__LB__", "{{").replace("__RB__", "}}")
        expect(file_write_exact(runner, js)).to_equal(true)
    runner

fn _run_validator_many(proof_paths: [text]) -> [(text, i64)]:
    val runner = _ensure_batch_runner()
    var cmd_args = [runner, "scripts/check/validate-electron-generated-gui-web-proof.js"]
    for p in proof_paths:
        cmd_args.push("@@SEP@@@@SEP@@" + p)
    val (stdout, _stderr, _code) = process_run("node", cmd_args)
    var out: [(text, i64)] = []
    for chunk in stdout.split("<<<BATCH_SEP>>>"):
        val pair = chunk.split("<<<CODE_END>>>")
        val c = if pair[0].trim() == "0": 0 else: 1
        val body = if pair.len() > 1: pair[1] else: ""
        out.push((body, c))
    out

fn _run_validator(proof_path: text) -> (text, i64):
    val (stdout, _stderr, code) = process_run("node", ["scripts/check/validate-electron-generated-gui-web-proof.js", proof_path])
    (stdout, code)

fn _run_validator_in_dir(work_dir: text, proof_name: text) -> (text, i64):
    val js = "const path=require('path');const s=path.resolve(process.argv[2]);process.chdir(process.argv[1]);process.argv=[process.argv[0],s,process.argv[3]];require(s)"
    val (stdout, _stderr, code) = process_run("node", ["-e", js, work_dir, "scripts/check/validate-electron-generated-gui-web-proof.js", proof_name])
    (stdout, code)

fn _create_symlink(target: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').symlinkSync(process.argv[1], process.argv[2])", target, link_path])
    code

fn _create_hardlink(existing_path: text, link_path: text) -> i64:
    val (_out, _err, code) = process_run("node", ["-e", "require('fs').linkSync(process.argv[1], process.argv[2])", existing_path, link_path])
    code

# @manual_section: Electron generated GUI Web proof validation

describe "Electron generated GUI Web proof validator":

    it "selects only self hosted Simple driver candidates in live wrapper":
        # @req: REQ-CHECK-001
        # @capture(protocol_binary): wrapper source contract for self-hosted Simple driver selection
        step("Verify: selects only self hosted Simple driver candidates in live wrapper")
        # @req: REQ-CHECK-ElecGeneGuiWebProoVali-001
        val script = file_read("scripts/check/check-electron-generated-gui-web-parity-evidence.shs")
        expect(script).to_contain("repo-self-hosted-fallback")
        expect(script).to_contain("\"bin/simple\"")
        expect(script).to_contain("\"bin/release\"/*/simple")
        expect(script).to_contain("is_rust_seed_simple")
        expect(script).to_contain("SIMPLE_BIN_STATUS=forbidden")
        expect(script).to_contain("export SIMPLE_BIN SIMPLE_BIN_SOURCE SIMPLE_BIN_STATUS")
        expect(script).to_contain("electron_generated_gui_web_simple_bin_status=$SIMPLE_BIN_STATUS")

    it "rejects explicit Rust seed Simple driver in live wrapper":
        # @capture(protocol_json): evidence and report rows for the forbidden Rust-seed driver
        val root = "build/test-electron-generated-gui-web-seed-forbidden"
        val command = "rm -rf " + root + " && SIMPLE_BIN=src/compiler_rust/target/release/simple BUILD_DIR=" + root + "/out REPORT_PATH=" + root + "/report.md sh scripts/check/check-electron-generated-gui-web-parity-evidence.shs || true"
        val (_stdout, _stderr, code) = process_run("/bin/sh", ["-c", command])
        expect(code).to_equal(0)  # oracle: harness exit 0 proves the wrapper ran; the verdict is asserted from the evidence rows

        val evidence = file_read(root + "/out/evidence.env")
        expect(evidence).to_contain("electron_generated_gui_web_status=unavailable")
        expect(evidence).to_contain("electron_generated_gui_web_reason=simple-bin-forbidden")
        expect(evidence).to_contain("electron_generated_gui_web_simple_bin=src/compiler_rust/target/release/simple")
        expect(evidence).to_contain("electron_generated_gui_web_simple_bin_source=explicit-env-rust-seed-forbidden")
        expect(evidence).to_contain("electron_generated_gui_web_simple_bin_status=forbidden")
        expect(evidence).to_contain("electron_generated_gui_web_proof_source_file_reason=not-run")
        expect(evidence).to_contain("electron_generated_gui_web_proof_source_artifact_status=unavailable")
        expect(evidence).to_contain("electron_generated_gui_web_captured_argb_file_reason=not-run")
        expect(evidence).to_contain("electron_generated_gui_web_captured_argb_artifact_status=unavailable")

        val report = file_read(root + "/report.md")
        step("Confirm unavailable generated GUI report surfaces artifact gate details")
        expect(report).to_contain("- proof source artifact:  / not-run / unavailable")
        expect(report).to_contain("- Electron captured ARGB artifact:  / not-run / unavailable")

    it "accepts complete Electron timing capture and checksum proof":
        # @capture(protocol_json): evidence rows for the accepted full generated-GUI proof
        val root = "build/test-electron-generated-gui-web-validator-pass"
        _prepare_dir(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, [])
        val (evidence, code) = _run_validator(proof_path)
        expect(code).to_equal(0)  # oracle: harness exit 0 proves the wrapper ran; the verdict is asserted from the evidence rows

        step("Inspect normalized Electron generated-GUI proof rows")
        expect(evidence).to_contain("electron_generated_gui_web_validation_status=pass")
        expect(evidence).to_contain("electron_generated_gui_web_validation_reason=pass")
        expect(evidence).to_contain("electron_generated_gui_web_mismatch_count=0")
        expect(evidence).to_contain("electron_generated_gui_web_electron_frame_us=1250")
        expect(evidence).to_contain("electron_generated_gui_web_capture_native_width=96")
        expect(evidence).to_contain("electron_generated_gui_web_capture_native_height=72")
        expect(evidence).to_contain("electron_generated_gui_web_capture_downsampled=false")
        expect(evidence).to_contain("electron_generated_gui_web_captured_argb_written=true")
        expect(evidence).to_contain("electron_generated_gui_web_blur_or_tolerance_used=false")

    it "rejects unexpected Electron renderer or generated GUI scene identity":
        # @capture(protocol_json): evidence rows for wrong-renderer and wrong-scene rejections
        val root = "build/test-electron-generated-gui-web-validator-identity"
        _prepare_dir(root, true)
        _write_proof(root + "/renderer.json", [_kv("renderer", "\"static-fixture\"")])
        _write_proof(root + "/scene.json", [_kv("scene", "\"other-scene\"")])
        val (renderer, r_code) = _run_validator(root + "/renderer.json")
        val (scene, s_code) = _run_validator(root + "/scene.json")
        expect(r_code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence
        expect(s_code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence

        step("Confirm generated GUI proof is tied to live Electron renderer and scene")
        expect(renderer).to_contain("electron_generated_gui_web_validation_status=fail")
        expect(renderer).to_contain("electron_generated_gui_web_validation_reason=unexpected-electron-renderer")
        expect(scene).to_contain("electron_generated_gui_web_validation_status=fail")
        expect(scene).to_contain("electron_generated_gui_web_validation_reason=unexpected-electron-scene")

    it "rejects proof without the live Electron capture source marker":
        # @capture(protocol_json): evidence rows for missing and substituted proof-source markers
        val root = "build/test-electron-generated-gui-validator-source"
        _prepare_dir(root, true)
        _write_proof(root + "/missing.json", [_kv("proof_source", "__OMIT__")])
        _write_proof(root + "/wrong.json", [_kv("proof_source", "\"tools/manual/generated-gui-proof.json\"")])
        val (missing, m_code) = _run_validator(root + "/missing.json")
        val (wrong, w_code) = _run_validator(root + "/wrong.json")
        expect(m_code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence
        expect(w_code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence

        step("Confirm generated GUI proof must identify the live capture producer")
        expect(missing).to_contain("electron_generated_gui_web_validation_status=fail")
        expect(missing).to_contain("electron_generated_gui_web_validation_reason=unexpected-electron-proof-source")
        expect(missing).to_contain("electron_generated_gui_web_proof_source=")
        expect(wrong).to_contain("electron_generated_gui_web_validation_status=fail")
        expect(wrong).to_contain("electron_generated_gui_web_validation_reason=unexpected-electron-proof-source")
        expect(wrong).to_contain("electron_generated_gui_web_proof_source=tools/manual/generated-gui-proof.json")

    it "rejects proof when the live generated GUI capture source artifact is missing":
        # @capture(protocol_json): evidence rows for the missing producer source artifact
        val root = "build/test-electron-generated-gui-validator-source-artifact"
        _prepare_dir(root, true)
        _write_proof(root + "/proof.json", [])
        val (evidence, code) = _run_validator_in_dir(root, "proof.json")
        expect(code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence

        step("Confirm generated GUI proof source marker is bound to the producer source file")
        expect(evidence).to_contain("electron_generated_gui_web_validation_status=fail")
        expect(evidence).to_contain("electron_generated_gui_web_validation_reason=unexpected-electron-proof-source-file-missing")
        expect(evidence).to_contain("electron_generated_gui_web_proof_source=tools/electron-live-bitmap/exact_fixture.js")
        expect(evidence).to_contain("electron_generated_gui_web_proof_source_file_status=missing")
        expect(evidence).to_contain("electron_generated_gui_web_proof_source_file_reason=missing")
        expect(evidence).to_contain("electron_generated_gui_web_proof_source_artifact_status=fail")
        expect(evidence).to_contain("electron_generated_gui_web_proof_source_size_bytes=")
        expect(evidence).to_contain("electron_generated_gui_web_proof_source_actual_size_bytes=")

    it "rejects missing Electron capture backend and GPU feature diagnostics":
        # @capture(protocol_json): evidence rows for backend, compositor, and GPU status rejections
        val root = "build/test-electron-generated-gui-web-validator-backend-gpu"
        _prepare_dir(root, true)
        _write_proof(root + "/backend.json", [_kv("capture_backend", "\"manual-json\"")])
        _write_proof(root + "/mode.json", [_kv("compositor_mode", "\"unknown\"")])
        _write_proof(root + "/gpu.json", [_kv("gpu_feature_status", "__OMIT__")])
        _write_proof(root + "/gpu-mismatch.json", [_kv("gpu_feature_status", "{{\"gpu_compositing\":\"disabled_software\",\"rasterization\":\"enabled\"}}")])
        val res = _run_validator_many([root + "/backend.json", root + "/mode.json", root + "/gpu.json", root + "/gpu-mismatch.json"])
        val (backend, b_code) = res[0]
        val (mode, m_code) = res[1]
        val (gpu_env, g_code) = res[2]
        val (gpu_mismatch, gm_code) = res[3]
        expect(b_code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence
        expect(m_code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence
        expect(g_code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence
        expect(gm_code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence

        step("Confirm generated GUI proof carries Electron backend and GPU diagnostics")
        expect(backend).to_contain("electron_generated_gui_web_validation_reason=unexpected-capture-backend")
        expect(backend).to_contain("electron_generated_gui_web_capture_backend=manual-json")
        expect(mode).to_contain("electron_generated_gui_web_validation_reason=unexpected-compositor-mode")
        expect(mode).to_contain("electron_generated_gui_web_compositor_mode=unknown")
        expect(gpu_env).to_contain("electron_generated_gui_web_validation_reason=missing-gpu-feature-status")
        expect(gpu_env).to_contain("electron_generated_gui_web_gpu_compositing=disabled_software")
        expect(gpu_mismatch).to_contain("electron_generated_gui_web_validation_reason=missing-gpu-feature-status")
        expect(gpu_mismatch).to_contain("electron_generated_gui_web_gpu_rasterization=disabled_software")

    it "rejects missing Electron Chromium runtime identity":
        # @capture(protocol_json): evidence rows for engine, user-agent, and version rejections
        val root = "build/test-electron-generated-gui-web-validator-runtime-identity"
        _prepare_dir(root, true)
        _write_proof(root + "/engine.json", [_kv("browser_engine", "\"webkit\"")])
        _write_proof(root + "/ua.json", [_kv("electron_user_agent", "\"Mozilla/5.0 Chrome/142.0.0.0 Safari/537.36\"")])
        _write_proof(root + "/electron-version.json", [_kv("electron_process_version", "\"\"")])
        _write_proof(root + "/chrome-version.json", [_kv("chrome_process_version", "\"dev\"")])
        val res = _run_validator_many([root + "/engine.json", root + "/ua.json", root + "/electron-version.json", root + "/chrome-version.json"])
        val (engine, e_code) = res[0]
        val (ua, u_code) = res[1]
        val (electron_version, ev_code) = res[2]
        val (chrome_version, cv_code) = res[3]
        expect(e_code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence
        expect(u_code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence
        expect(ev_code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence
        expect(cv_code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence

        step("Confirm generated GUI proof is tied to Electron Chromium runtime evidence")
        expect(engine).to_contain("electron_generated_gui_web_validation_reason=missing-electron-runtime-identity")
        expect(engine).to_contain("electron_generated_gui_web_browser_engine=webkit")
        expect(ua).to_contain("electron_generated_gui_web_validation_reason=missing-electron-runtime-identity")
        expect(ua).to_contain("electron_generated_gui_web_electron_user_agent=Mozilla/5.0 Chrome/142.0.0.0 Safari/537.36")
        expect(electron_version).to_contain("electron_generated_gui_web_validation_reason=missing-electron-runtime-identity")
        expect(electron_version).to_contain("electron_generated_gui_web_electron_process_version=")
        expect(chrome_version).to_contain("electron_generated_gui_web_validation_reason=missing-electron-runtime-identity")
        expect(chrome_version).to_contain("electron_generated_gui_web_chrome_process_version=dev")

    it "rejects large checksum values that differ past JavaScript number precision":
        # @capture(protocol_json): evidence rows preserving full-precision decimal checksum text
        val root = "build/test-electron-generated-gui-web-validator-large-checksum"
        _prepare_dir(root, true)
        val proof_path = root + "/proof.json"
        _write_proof(proof_path, [
            _kv("checksum", "\"9007199254740993\""),
            _kv("expected_checksum", "\"9007199254740992\""),
            _kv("weighted_checksum", "\"18014398509481985\""),
            _kv("expected_weighted_checksum", "\"18014398509481985\"")
        ])
        val (evidence, code) = _run_validator(proof_path)
        expect(code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence

        step("Assert decimal integer text is preserved for large Electron generated-GUI proof")
        expect(evidence).to_contain("electron_generated_gui_web_validation_status=fail")
        expect(evidence).to_contain("electron_generated_gui_web_validation_reason=checksum-mismatch")
        expect(evidence).to_contain("electron_generated_gui_web_electron_checksum=9007199254740993")
        expect(evidence).to_contain("electron_generated_gui_web_simple_checksum=9007199254740992")
        expect(evidence).to_contain("electron_generated_gui_web_electron_weighted_checksum=18014398509481985")
        expect(evidence).to_contain("electron_generated_gui_web_simple_weighted_checksum=18014398509481985")

    it "rejects malformed Electron frame timing":
        # @capture(protocol_json): evidence rows for the non-numeric frame_us rejection
        step("Reject a frame_us value that is not a JSON number")
