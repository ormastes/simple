        val (provenance, p_code) = _run_validator(root + "/provenance.json")
        expect(c_code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence
        expect(p_code).to_equal(1)  # oracle: validator exit 1 is the fail-closed reject signal for forged evidence

