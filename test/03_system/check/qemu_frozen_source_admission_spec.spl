use std.io.{file_read}
use std.spec.{describe, expect, it}

val ADMISSION = "scripts/check/lib/qemu-frozen-source-admission.shs"
val X86 = "scripts/check/check-simpleos-wm-fullscreen-evidence.shs"
val ARM_BUILD = "scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs"
val ARM_QMP = "scripts/check/check-simpleos-arm64-qmp-input-evidence.shs"

describe "QEMU frozen-source admission":
    it "requires a linked clean worktree and records reproducible producer identity":
        val source = file_read(ADMISSION)
        expect(source).to_contain("qemu_admission_require_linked_worktree")
        expect(source).to_contain("[ -f \"$QEMU_ADMISSION_ROOT/.git\" ]")
        expect(source).to_contain("--untracked-files=all")
        expect(source).to_contain("repo_revision=")
        expect(source).to_contain("QEMU_ADMISSION_DIRTY_POLICY=scoped-tracked-and-untracked-clean")
        expect(source).to_contain("entry_sha256=")
        expect(source).to_contain("source_fingerprint=")
        expect(source).to_contain("compiler_sha256=")
        expect(source).to_contain("build_command=")
        expect(source).to_contain("output_sha256=")
        expect(source).to_contain("qemu_admission_publish")

    it "keeps x86 render and ARM input evidence behind admitted producers":
        val x86 = file_read(X86)
        val arm_build = file_read(ARM_BUILD)
        val arm_qmp = file_read(ARM_QMP)
        expect(x86).to_contain("qemu-frozen-source-admission.shs")
        expect(x86).to_contain("KERNEL_FROZEN_ADMISSION")
        expect(x86).to_contain("qemu_admission_publish")
        expect(arm_build).to_contain("qemu-frozen-source-admission.shs")
        expect(arm_build).to_contain("FROZEN_BUILD_MANIFEST")
        expect(arm_build).to_contain("qemu_admission_publish")
        expect(arm_qmp).to_contain("canonical-frozen-source-admission-missing")
        expect(arm_qmp).to_contain("canonical-frozen-source-admission-output-sha256-mismatch")
        expect(x86).to_contain("input-send-event")
        expect(arm_qmp).to_contain("input-send-event")
