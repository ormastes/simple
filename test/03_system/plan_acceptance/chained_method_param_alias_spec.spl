# Regression: chained method call on a function PARAMETER must not alias or
# clobber the caller's argument.
# doc/08_tracking/bug/chained_method_on_param_aliases_caller_argument_2026-09-05.md
use std.spec.{describe, it, expect}
use std.linalg.*
use std.ndarray.*

fn chained_on_param(alpha: Float64, x: NDArray, y: NDArray) -> NDArray:
    x.mul_scalar(alpha).add(y)

fn chained_in_ok(alpha: Float64, x: NDArray, y: NDArray) -> Result<NDArray, LinalgError>:
    Ok(x.mul_scalar(alpha).add(y))

describe "chained method on parameter":
    it "does not clobber the caller's argument (plain chain)":
        val a = vector_from([Float64.new(1.0), Float64.new(2.0)])
        val b = vector_from([Float64.new(3.0), Float64.new(4.0)])
        val r = chained_on_param(Float64.new(2.0), a, b)
        expect(r.get_at([Index.new(0)])).to_equal(Float64.new(5.0))
        expect(a.get_at([Index.new(0)])).to_equal(Float64.new(1.0))
        expect(a.get_at([Index.new(1)])).to_equal(Float64.new(2.0))
    it "does not clobber the caller's argument (chain inside Ok)":
        val a = vector_from([Float64.new(1.0), Float64.new(2.0)])
        val b = vector_from([Float64.new(3.0), Float64.new(4.0)])
        val r = chained_in_ok(Float64.new(2.0), a, b)
        expect(r.is_ok()).to_equal(true)
        expect(a.get_at([Index.new(0)])).to_equal(Float64.new(1.0))
        expect(a.get_at([Index.new(1)])).to_equal(Float64.new(2.0))
