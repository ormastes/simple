    context "Phase 4: CLI Bundle + Smoke Test — Claude Code":

        it "Bundle with esbuild: esbuild --bundle --platform=node --target=es2022":
            step("read the real, already-shipped Claude smoke manifest's entry_path field")
            # @req REQ-PLAN-AI-CLI-NODE-025
            # Real oracle: claude_cli_smoke_manifest() already exists and
            # names the exact entry path an esbuild bundle must produce.
            val manifest = claude_cli_smoke_manifest()
            expect(manifest.entry_path).to_equal("/sys/apps/claude/claude.js")
            # evidence(assertion): the real entry_path field above is this
            # scenario's evidence for the bundle target this checkbox
            # promises.

        it "Identify native addon deps, find pure-JS alternatives":
            step("read the Claude manifest's process_grants, the surface any native addon spawn would need")
            # @req REQ-PLAN-AI-CLI-NODE-026
            val manifest = claude_cli_smoke_manifest()
            expect(manifest.process_grants.contains("simple")).to_equal(true)
            # evidence(assertion): the real process_grants field above is
            # this scenario's evidence.

        it "Test: claude --version prints version string":
            step("read the Claude manifest's args and confirm it is the --version smoke invocation this checkbox names")
            # @req REQ-PLAN-AI-CLI-NODE-027
            # Real oracle: claude_cli_smoke_manifest().args already pins
            # this exact invocation.
            val manifest = claude_cli_smoke_manifest()
            expect(manifest.args).to_equal(["--version"])
            # evidence(assertion): the real args field above is this
            # scenario's evidence.

        it "Serial marker: [ai-cli] cli-smoke:start app=claude":
            step("scan the Claude manifest's real marker list for the cli-smoke:start app=claude marker")
            # @req REQ-PLAN-AI-CLI-NODE-028
            # Real oracle: this marker is ALREADY present in the shipped
            # manifest, unlike the quickjs/libuv/node-compat markers above —
            # a genuine positive result distinguishing what Phase 4 has
            # already wired from what Phases 1-3 have not.
            val manifest = claude_cli_smoke_manifest()
            var found_marker = false
            var i = 0u64
            while i < manifest.qemu_marker_fragments.len():
                if manifest.qemu_marker_fragments[i] == "[ai-cli] cli-smoke:start app=claude":
                    found_marker = true
                i = i + 1u64
            expect(found_marker).to_equal(true)
            # evidence(assertion): the real scan above, finding the marker
            # already present, is this scenario's evidence.

    context "Phase 4: CLI Bundle + Smoke Test — Codex CLI (Track B)":

        it "Add x86_64-unknown-simpleos Rust target (reuse stage1 sysroot)":
