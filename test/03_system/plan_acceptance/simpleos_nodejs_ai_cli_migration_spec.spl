"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/app/simpleos/simpleos_nodejs_ai_cli_migration.md.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/simpleos_nodejs_ai_cli_migration_spec.spl
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented.

AUDIT 2026-09-05 — this file previously reported 43/43 GREEN against a plan
with 44 open boxes, which contradicted its own docstring above. Root cause:
18 of the 43 scenarios asserted a substring of ai_cli_full_node_blocker(),
which is a single hardcoded string literal at
src/os/ai_cli_js_node_contract.spl:709. That is a literal compared with
itself through a function call: it holds whether or not a single syscall,
QuickJS build, or libuv file exists, so those scenarios could not fail. A
further group asserted the NOT-done state (marker absent, runtime_status ==
"blocked-runtime-artifact") — green there means the box is still OPEN, which
is an inverted acceptance oracle, and runtime_status is itself a hardcoded
literal in _ai_cli_qemu_lane (contract :489-524).

Every scenario now additionally asserts the DONE state its checkbox
promises, read out of real tree state (kernel syscall-handler source, the
POSIX honesty matrix, Rust target specs, staged bundles, captured serial
logs). Original assertions are retained, never deleted. Scenarios whose box
is genuinely open are therefore RED — that is the honest result the
@tag:in-development marker exists for. Scenarios that go GREEN name a box
that is closeable with the cited evidence.
## Verification guidance / troubleshooting
A load failure on the os.ai_cli_js_node_contract import means the manifest
contract module moved; re-grep src/os/ai_cli_js_node_contract.spl for the
listed symbols before assuming a real regression. A failure reading
kernel_abi_files means src/os/kernel/abi/ was reorganised — re-list that
directory and update the constant, do not weaken the oracle.
"""
# @tag:in-development
# doc-path: doc/03_plan/app/simpleos/simpleos_nodejs_ai_cli_migration.md
# @manual_section SimpleOS Node.js AI CLI migration remains

use std.spec.{step}
use std.spec.{describe, context, it, expect}
use os.ai_cli_js_node_contract.{
    AiCliManifest, AiCliQemuLane,
    ai_cli_full_node_blocker,
    bun_informed_simple_js_runtime_profile,
    claude_cli_smoke_manifest,
    codex_cli_smoke_manifest,
    gemini_cli_smoke_manifest,
    ai_cli_qemu_lane,
    ai_cli_qemu_lanes,
    ai_cli_qemu_missing_markers,
    ai_cli_qemu_serial_accepts_lane
}
use std.nogc_sync_mut.io.file_ops.{file_read, file_exists}

val posix_profiles_path = "doc/02_requirements/os/posix_profiles.md"

# The complete kernel ABI syscall-shim surface. Phase 0's already-closed
# boxes (plan lines 134/136/138/140) cite `spl_handle_*` functions in exactly
# these files as their evidence, so the same grep is the honest oracle for
# the boxes that are still open.
val kernel_abi_files = [
    "src/os/kernel/abi/syscall_shim.spl",
    "src/os/kernel/abi/syscall_shim_device.spl",
    "src/os/kernel/abi/syscall_shim_file.spl",
    "src/os/kernel/abi/syscall_shim_g11g12g13.spl",
    "src/os/kernel/abi/syscall_shim_ipc.spl",
    "src/os/kernel/abi/syscall_shim_net.spl",
    "src/os/kernel/abi/syscall_shim_positioned.spl",
    "src/os/kernel/abi/syscall_shim_process.spl",
    "src/os/kernel/abi/syscall_shim_time_log_sysinfo.spl"
]

# Phase 2's first checkbox names this exact path.
val libuv_core_path = "src/runtime/vendor/libuv/simpleos-core.c"

# check-ai-cli-qemu-lanes.shs:30 stages host-side package files under this
# root, mirroring the guest paths the manifests declare.
val ai_cli_staging_root = "build/os/ai-cli-runtime-staging"

fn read_if_exists(path: text) -> text:
    if file_exists(path):
        return file_read(path)
    ""

fn kernel_abi_source() -> text:
    var joined = ""
    for p in kernel_abi_files:
        joined = joined + read_if_exists(p)
    joined

fn handlers_present(src: text, names: [text]) -> u64:
    var n = 0u64
    for name in names:
        if src.contains("fn spl_handle_" + name + "("):
            n = n + 1u64
    n

fn manifest_marker_hits(manifest: AiCliManifest, fragment: text) -> u64:
    var n = 0u64
    for m in manifest.qemu_marker_fragments:
        if m.contains(fragment):
            n = n + 1u64
    n

fn lane_serial_capture(lane: AiCliQemuLane) -> text:
    read_if_exists(lane.serial_log_path)

fn staged_guest_path(guest_path: text) -> text:
    ai_cli_staging_root + guest_path

describe "plan: app/simpleos/simpleos_nodejs_ai_cli_migration remains":

    context "Phase 0: Kernel Syscall Surface Audit":

        it "open, read, write, close, stat, fstat, lstat":
            step("grep the real kernel ABI syscall-shim source for a spl_handle_* implementation of each of the seven file-I/O calls this checkbox names")
            # @req REQ-PLAN-AI-CLI-NODE-001
            # AUDIT 2026-09-05, verdict 2 (vacuous): the previous oracle
            # asserted ai_cli_full_node_blocker().contains(...) — a literal
            # compared with itself, green whether or not any syscall exists.
            # Real oracle: the same spl_handle_* grep the plan's own CLOSED
            # Phase 0 boxes cite as evidence (plan lines 134/136/138/140).
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            val abi = kernel_abi_source()
            # non-vacuity: the search space must be real and the matcher must
            # be able to find something, otherwise "0 found" proves nothing.
            expect(abi.len() > 20000u64).to_equal(true)
            expect(handlers_present(abi, ["file_open", "file_read", "file_write", "file_close", "file_stat"])).to_equal(5u64)
            # the discriminating half: fstat and lstat are named by the box
            # and have no handler anywhere in the ABI surface.
            expect(handlers_present(abi, ["fstat", "lstat"])).to_equal(2u64)
            # @capture(assertion): the two handler counts read out of the real
            # kernel ABI source, plus the non-vacuity length guard, are this
            # scenario's retained evidence.

        it "socket, connect, bind, listen, accept, send, recv":
            step("grep the kernel ABI source for the seven networking spl_handle_net_* handlers the plan's already-closed line 134 cites")
            # @req REQ-PLAN-AI-CLI-NODE-002
            # AUDIT 2026-09-05, verdict 2 -> now a real oracle. This box is
            # already [x] in the plan (line 134) with named evidence; the
            # oracle re-derives that evidence instead of trusting it.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            val abi = kernel_abi_source()
            expect(abi.len() > 20000u64).to_equal(true)
            expect(handlers_present(abi, ["net_socket", "net_connect", "net_bind", "net_listen", "net_accept", "net_send_to", "net_recv_from"])).to_equal(7u64)
            # @capture(assertion): the seven-handler count read out of the
            # real kernel ABI source is this scenario's retained evidence.

        it "poll (or select — libuv posix-poll.c needs one)":
            step("grep the kernel ABI source for spl_handle_poll, the handler the plan's already-closed line 136 cites")
            # @req REQ-PLAN-AI-CLI-NODE-003
            # AUDIT 2026-09-05, verdict 2 -> real oracle re-deriving the
            # evidence the plan's [x] on line 136 claims.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("libuv-artifact")).to_equal(true)
            val abi = kernel_abi_source()
            expect(abi.len() > 20000u64).to_equal(true)
            expect(handlers_present(abi, ["poll"])).to_equal(1u64)
            # @capture(assertion): the poll-handler count read out of the real
            # kernel ABI source is this scenario's retained evidence.

        it "pipe, dup2, fcntl (O_NONBLOCK, F_GETFL, F_SETFL)":
            step("grep the kernel ABI source for the pipe/dup2/fcntl handlers AND for the three fcntl commands the checkbox names in its parenthetical")
            # @req REQ-PLAN-AI-CLI-NODE-004
            # AUDIT 2026-09-05, verdict 2 -> real oracle. Note the box names
            # not just fcntl but three specific commands; a handler that
            # exists without them does not satisfy the box.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            val abi = kernel_abi_source()
            expect(abi.len() > 20000u64).to_equal(true)
            expect(handlers_present(abi, ["pipe", "dup2", "fcntl"])).to_equal(3u64)
            expect(abi.contains("F_GETFL")).to_equal(true)
            expect(abi.contains("F_SETFL")).to_equal(true)
            expect(abi.contains("O_NONBLOCK")).to_equal(true)
            # @capture(assertion): the three-handler count plus the three
            # fcntl-command greps over the real kernel ABI source are this
            # scenario's retained evidence.

        it "mmap, mprotect, munmap (for QuickJS memory)":
            step("grep the kernel ABI source for the mmap/mprotect/munmap handlers the plan's already-closed line 138 cites")
            # @req REQ-PLAN-AI-CLI-NODE-005
            # AUDIT 2026-09-05, verdict 2 -> real oracle re-deriving the
            # evidence the plan's [x] on line 138 claims.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            val abi = kernel_abi_source()
            expect(abi.len() > 20000u64).to_equal(true)
            expect(handlers_present(abi, ["sys_mmap", "mprotect", "munmap"])).to_equal(3u64)
            # @capture(assertion): the three-handler count read out of the
            # real kernel ABI source is this scenario's retained evidence.

        it "pthread_create, pthread_join, pthread_mutex_*, pthread_cond_*":
            step("grep the kernel ABI source for pthread handlers and cross-check the POSIX honesty matrix, which records these as ENOSYS stubs")
            # @req REQ-PLAN-AI-CLI-NODE-006
            # AUDIT 2026-09-05, verdict 2 -> real oracle. The honesty matrix
            # already records these as ENOSYS, so a green here would have to
            # come from a real handler landing, not from a constant.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("libuv-artifact")).to_equal(true)
            val abi = kernel_abi_source()
            expect(abi.len() > 20000u64).to_equal(true)
            # non-vacuity: prove the matcher finds handlers in this same source
            expect(handlers_present(abi, ["yield"])).to_equal(1u64)
            expect(handlers_present(abi, ["pthread_create", "pthread_join"])).to_equal(2u64)
            val profiles = read_if_exists(posix_profiles_path)
            expect(profiles.contains("pthread_create/join/detach")).to_equal(true)
            # the box is satisfied only once the matrix stops saying ENOSYS
            var pthread_enosys_rows = 0u64
            for line in profiles.split("\n"):
                if line.contains("pthread") and line.contains("ENOSYS"):
                    pthread_enosys_rows = pthread_enosys_rows + 1u64
            expect(pthread_enosys_rows).to_equal(0u64)
            # @capture(assertion): the pthread handler count and the count of
            # surviving ENOSYS rows in the real honesty matrix are this
            # scenario's retained evidence.

        it "clock_gettime, nanosleep":
            step("grep the kernel ABI source for the clock_gettime and sleep handlers the plan's already-closed line 140 cites")
            # @req REQ-PLAN-AI-CLI-NODE-007
            # AUDIT 2026-09-05, verdict 2 -> real oracle re-deriving the
            # evidence the plan's [x] on line 140 claims. The plan closed this
            # box as "clock_gettime, sleep", not nanosleep — assert what the
            # kernel actually provides and record the naming divergence.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            val abi = kernel_abi_source()
            expect(abi.len() > 20000u64).to_equal(true)
            expect(handlers_present(abi, ["clock_gettime", "sleep"])).to_equal(2u64)
            # @capture(assertion): the two-handler count read out of the real
            # kernel ABI source is this scenario's retained evidence.

        it "getenv, getcwd, getpid, getuid":
            step("grep the kernel ABI source for a spl_handle_* implementation of each of the four process-identity calls this checkbox names")
            # @req REQ-PLAN-AI-CLI-NODE-008
            # AUDIT 2026-09-05, verdict 2 -> real oracle. getcwd and getpid
            # have handlers; getenv and getuid do not, and the honesty matrix
            # (posix_profiles.md:55) records getuid/getgid as a stub.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            val abi = kernel_abi_source()
            expect(abi.len() > 20000u64).to_equal(true)
            expect(handlers_present(abi, ["getcwd", "getpid"])).to_equal(2u64)
            expect(handlers_present(abi, ["getenv", "getuid"])).to_equal(2u64)
            # @capture(assertion): the two handler counts read out of the real
            # kernel ABI source are this scenario's retained evidence.

        it "Document gaps as concrete implementation tasks":
            step("read the POSIX honesty matrix this checkbox delivers and count its documented pthread gap rows, each of which must name an owning source file and an honest ENOSYS status")
            # @req REQ-PLAN-AI-CLI-NODE-009
            # AUDIT 2026-09-05, verdict 1 (genuinely passing) — retained
            # unchanged. Real, tree-state oracle on the actual deliverable:
            # the plan records this box as shipped as the POSIX honesty matrix
            # doc/02_requirements/os/posix_profiles.md. A "documented gap" is
            # only concrete if the row states BOTH the honest failure mode
            # (ENOSYS) and the owning file; a row that merely names a call is
            # not a task. Every value below is read out of that file.
            expect(file_exists(posix_profiles_path)).to_equal(true)
            val profiles = file_read(posix_profiles_path)
            val required_pthread_rows = [
                "pthread_create/join/detach",
                "pthread mutex/rwlock/attr",
                "pthread_cond_*",
                "pthread_rwlock_*"
            ]
            var documented_gap_rows = 0u64
            for row_name in required_pthread_rows:
                for line in profiles.split("\n"):
                    if line.contains(row_name) and line.contains("ENOSYS") and line.contains("src/os/libc/"):
                        documented_gap_rows = documented_gap_rows + 1u64
            expect(documented_gap_rows).to_equal(4u64)  # oracle: the plan's Phase 0 gap line cites four pthread_* row families in posix_profiles.md
            # @capture(assertion): the matching honesty-matrix rows counted
            # above are this scenario's retained evidence.

    context "Phase 1: QuickJS on SimpleOS":

        it "Cross-compile QuickJS to x86_64-simpleos, riscv64-simpleos, aarch64-simpleos":
            step("require a cross-compiled QuickJS artifact for each of the three *-simpleos triples the checkbox names")
            # @req REQ-PLAN-AI-CLI-NODE-010
            # AUDIT 2026-09-05, verdict 3 (testing the wrong thing): the
            # previous oracle asserted the shipped runtime profile does NOT
            # say "quickjs" — a true and interesting divergence, but it is
            # evidence that the box will never close, not that it has. Both
            # halves are kept: the divergence is retained as context, and the
            # checkbox's own promise (three cross-compiled artifacts) is now
            # the discriminating assertion.
            val profile = bun_informed_simple_js_runtime_profile()
            expect(profile.js_engine_strategy.contains("quickjs")).to_equal(false)
            # non-vacuity: the strategy field must be real, non-empty text
            expect(profile.js_engine_strategy.len() > 10u64).to_equal(true)
            var quickjs_artifacts = 0u64
            for triple in ["x86_64-simpleos", "riscv64-simpleos", "aarch64-simpleos"]:
                if file_exists("build/os/quickjs/" + triple + "/qjs"):
                    quickjs_artifacts = quickjs_artifacts + 1u64
            expect(quickjs_artifacts).to_equal(3u64)
            # @capture(assertion): the real profile field plus the per-triple
            # artifact count are this scenario's retained evidence.

        it "Boot in QEMU, run qjs -e \"console.log('hello')\" via serial":
            step("read the real captured x86 serial log and require the qjs console.log output the checkbox names")
            # @req REQ-PLAN-AI-CLI-NODE-011
            # AUDIT 2026-09-05, verdict 2 -> real oracle on the actual
            # serial capture the checkbox promises.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            val lane = ai_cli_qemu_lane(claude_cli_smoke_manifest(), "x86")
            val serial = lane_serial_capture(lane)
            expect(lane.serial_log_path.len() > 0u64).to_equal(true)
            expect(file_exists(lane.serial_log_path)).to_equal(true)
            expect(serial.contains("hello")).to_equal(true)
            # @capture(assertion): the existence of the real serial log at the
            # lane's own path and its captured content are this scenario's
            # retained evidence.

        it "Verify: ES2023 features work (async/await, modules, generators)":
            step("read the real captured x86 serial log and require an ES2023 conformance marker for each of the three feature families the checkbox names")
            # @req REQ-PLAN-AI-CLI-NODE-012
            # AUDIT 2026-09-05, verdict 2 -> real oracle on captured serial.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            val lane = ai_cli_qemu_lane(claude_cli_smoke_manifest(), "x86")
            val serial = lane_serial_capture(lane)
            var es2023_features = 0u64
            for feature in ["async-await", "modules", "generators"]:
                if serial.contains("es2023:" + feature):
                    es2023_features = es2023_features + 1u64
            expect(es2023_features).to_equal(3u64)
            # @capture(assertion): the per-feature marker count read out of
            # the real serial capture is this scenario's retained evidence.

        it "Serial marker: [ai-cli] quickjs:hello target=<arch>":
            step("require the quickjs:hello marker both DECLARED in the shipped manifest contract and EMITTED into the real captured serial log")
            # @req REQ-PLAN-AI-CLI-NODE-013
            # AUDIT 2026-09-05, verdict 3 (inverted oracle): the previous
            # assertion required the marker to be ABSENT, so green meant the
            # box was still open — an acceptance oracle that can never accept.
            # The absence check is retained as a state record; the checkbox's
            # own promise (marker present, and actually emitted) is now the
            # discriminating assertion.
            val manifest = claude_cli_smoke_manifest()
            # non-vacuity: the marker list must be a real, non-empty list
            expect(manifest.qemu_marker_fragments.len() > 0u64).to_equal(true)
            val lane = ai_cli_qemu_lane(manifest, "x86")
            val serial = lane_serial_capture(lane)
            expect(manifest_marker_hits(manifest, "quickjs:hello")).to_equal(1u64)
            expect(serial.contains("[ai-cli] quickjs:hello target=")).to_equal(true)
            # @capture(assertion): the marker-hit count over the shipped
            # manifest list and the serial-capture containment check are this
            # scenario's retained evidence.

        # "Binary size target: <2MB per arch" has NO observable oracle in this
        # tree: no QuickJS artifact is built for any *-simpleos triple, and the
        # plan names no output path, size-budget field or gate script to measure
        # against — AiCliRuntimeProfile carries no size budget. Measuring a
        # nonexistent binary against a path we invented would be a fabricated
        # test, so it is recorded in
        # scripts/check/plan_acceptance_exemptions.txt instead.

    context "Phase 2: libuv Port":

        it "Create src/runtime/vendor/libuv/simpleos-core.c (~150 lines)":
            step("require the exact file path this checkbox names to exist and to be a non-trivial C source, not an empty placeholder")
            # @req REQ-PLAN-AI-CLI-NODE-015
            # AUDIT 2026-09-05, verdict 2 -> real oracle. The checkbox names
            # an exact path and an approximate size; both are checkable.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("libuv-artifact")).to_equal(true)
            expect(file_exists(libuv_core_path)).to_equal(true)
            val core = read_if_exists(libuv_core_path)
            expect(core.len() > 1000u64).to_equal(true)
            expect(core.contains("uv_")).to_equal(true)
            # @capture(assertion): the existence, size, and content of the
            # real file at the checkbox's own path are this scenario's
            # retained evidence.

        it "Use posix-poll.c backend, disable epoll/kqueue":
            step("read the real simpleos-core.c and require the posix-poll backend to be selected and epoll/kqueue to be disabled")
            # @req REQ-PLAN-AI-CLI-NODE-016
            # AUDIT 2026-09-05, verdict 2 -> real oracle on the port's own
            # source. Non-vacuity is enforced by requiring the file to exist
            # first, so an absent file FAILS rather than silently matching
            # nothing.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("libuv-artifact")).to_equal(true)
            expect(file_exists(libuv_core_path)).to_equal(true)
            val core = read_if_exists(libuv_core_path)
            expect(core.contains("posix-poll")).to_equal(true)
            expect(core.contains("UV_HAVE_KQUEUE")).to_equal(false)
            # @capture(assertion): the backend-selection and
            # epoll/kqueue-exclusion greps over the real port source are this
            # scenario's retained evidence.

        it "Build flags: -U__linux__ -DSIMPLEOS":
            step("require both build flags the checkbox names to appear in a real build file for the libuv port")
            # @req REQ-PLAN-AI-CLI-NODE-017
            # AUDIT 2026-09-05, verdict 2 -> real oracle over the port's build
            # description.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("libuv-artifact")).to_equal(true)
            val build_desc = read_if_exists("src/runtime/vendor/libuv/Makefile") + read_if_exists("src/runtime/vendor/libuv/CMakeLists.txt") + read_if_exists("src/runtime/vendor/libuv/build.shs")
            expect(build_desc.len() > 0u64).to_equal(true)
            expect(build_desc.contains("-U__linux__")).to_equal(true)
            expect(build_desc.contains("-DSIMPLEOS")).to_equal(true)
            # @capture(assertion): the two flag greps over the real build
            # description, guarded by a non-empty length check, are this
            # scenario's retained evidence.

        it "Stub non-critical: uv_interface_addresses -> UV_ENOSYS":
            step("read the real simpleos-core.c and require uv_interface_addresses to be defined and to return UV_ENOSYS")
            # @req REQ-PLAN-AI-CLI-NODE-018
            # AUDIT 2026-09-05, verdict 2 -> real oracle on the stub itself.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("libuv-artifact")).to_equal(true)
            expect(file_exists(libuv_core_path)).to_equal(true)
            val core = read_if_exists(libuv_core_path)
            expect(core.contains("uv_interface_addresses")).to_equal(true)
            expect(core.contains("UV_ENOSYS")).to_equal(true)
            # @capture(assertion): the symbol and return-code greps over the
            # real port source are this scenario's retained evidence.

        it "Stub non-critical: uv_resident_set_memory -> 0":
            step("read the real simpleos-core.c and require uv_resident_set_memory to be defined")
            # @req REQ-PLAN-AI-CLI-NODE-019
            # AUDIT 2026-09-05, verdict 2 -> real oracle on the stub itself.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("libuv-artifact")).to_equal(true)
            expect(file_exists(libuv_core_path)).to_equal(true)
            val core = read_if_exists(libuv_core_path)
            expect(core.contains("uv_resident_set_memory")).to_equal(true)
            # @capture(assertion): the symbol grep over the real port source
            # is this scenario's retained evidence.

        it "Real impl: uv_exepath, uv_uptime, uv_hrtime, uv_cpu_info":
            step("read the real simpleos-core.c and require a definition for each of the four functions this checkbox names")
            # @req REQ-PLAN-AI-CLI-NODE-020
            # AUDIT 2026-09-05, verdict 2 -> real oracle counting the four
            # named symbols in the port source.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("libuv-artifact")).to_equal(true)
            expect(file_exists(libuv_core_path)).to_equal(true)
            val core = read_if_exists(libuv_core_path)
            var real_impls = 0u64
            for sym in ["uv_exepath", "uv_uptime", "uv_hrtime", "uv_cpu_info"]:
                if core.contains(sym):
                    real_impls = real_impls + 1u64
            expect(real_impls).to_equal(4u64)
            # @capture(assertion): the four-symbol count over the real port
            # source is this scenario's retained evidence.

        it "Thread pool: verify pthreads work under SimpleOS":
            step("require real pthread kernel handlers, since the honesty matrix currently records every pthread family as an ENOSYS stub")
            # @req REQ-PLAN-AI-CLI-NODE-021
            # AUDIT 2026-09-05, verdict 2 -> real oracle. This is the same
