        it "Serial marker: [ai-cli] libuv:ready target=<arch>":
            step("confirm no shipped CLI smoke manifest yet carries a libuv:ready marker")
            # @req REQ-PLAN-AI-CLI-NODE-023
            val manifest = codex_cli_smoke_manifest()
