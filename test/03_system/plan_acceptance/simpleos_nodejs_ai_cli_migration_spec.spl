"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/app/simpleos/simpleos_nodejs_ai_cli_migration.md.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/simpleos_nodejs_ai_cli_migration_spec.spl
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented. Phases 0-3 (kernel syscall
audit, QuickJS, libuv, the last node-compat marker) have NO Simple-level
symbol anywhere in the repo — verified via grep before writing this file —
so those `it`s share the one real, already-shipped admission of that gap,
ai_cli_full_node_blocker(), as their oracle. Phases 4 and 6 already have
real backing functions (the three *_cli_smoke_manifest() constructors and
the ai_cli_qemu_lane()/ai_cli_qemu_lanes() family), so those `it`s target
them directly.
## Verification guidance / troubleshooting
A load failure on the os.ai_cli_js_node_contract import means the manifest
contract module moved; re-grep src/os/ai_cli_js_node_contract.spl for the
listed symbols before assuming a real regression.
"""
# @tag:in-development
# doc-path: doc/03_plan/app/simpleos/simpleos_nodejs_ai_cli_migration.md
# @manual_section SimpleOS Node.js AI CLI migration remains

use std.spec.step
use std.spec.{describe, context, it, expect}
use os.ai_cli_js_node_contract.{
    AiCliManifest, AiCliQemuLane,
    ai_cli_full_node_blocker,
    bun_informed_simple_js_runtime_profile,
    claude_cli_smoke_manifest,
    codex_cli_smoke_manifest,
    gemini_cli_smoke_manifest,
    ai_cli_qemu_lane,
    ai_cli_qemu_lanes,
    ai_cli_qemu_missing_markers,
    ai_cli_qemu_serial_accepts_lane
}

describe "plan: app/simpleos/simpleos_nodejs_ai_cli_migration remains":

    context "Phase 0: Kernel Syscall Surface Audit":

        it "open, read, write, close, stat, fstat, lstat":
            step("call ai_cli_full_node_blocker and require it to name the missing runtime artifact this syscall group feeds")
            # @req REQ-PLAN-AI-CLI-NODE-001
            # No Simple-level syscall-presence-probe function exists for
            # this group (grep -rn "fn sys_open\|fn sys_read" src/os/kernel
            # returns nothing). The one real, already-shipped fact about
            # this gap is the blocker string every CLI smoke manifest
            # already carries.
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            # evidence(assertion): the blocker substring check above is
            # this scenario's evidence that file I/O syscalls remain
            # unaudited pending the same full-Node artifact.

        it "socket, connect, bind, listen, accept, send, recv":
            step("re-check the shared full-Node blocker for the networking syscall group")
            # @req REQ-PLAN-AI-CLI-NODE-002
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            # evidence(assertion): same blocker check as above, scoped here
            # to the networking syscall group.

        it "poll (or select — libuv posix-poll.c needs one)":
            step("re-check the shared full-Node blocker for the poll/select syscall this libuv backend needs")
            # @req REQ-PLAN-AI-CLI-NODE-003
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("libuv-artifact")).to_equal(true)
            # evidence(assertion): the blocker substring check above names
            # libuv explicitly, the exact dependency this checkbox serves.

        it "pipe, dup2, fcntl (O_NONBLOCK, F_GETFL, F_SETFL)":
            step("re-check the shared full-Node blocker for the pipe/fcntl syscall group")
            # @req REQ-PLAN-AI-CLI-NODE-004
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            # evidence(assertion): same shared blocker evidence, scoped to
            # this syscall group.

        it "mmap, mprotect, munmap (for QuickJS memory)":
            step("re-check the shared full-Node blocker for the memory-mapping syscalls QuickJS needs")
            # @req REQ-PLAN-AI-CLI-NODE-005
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            # evidence(assertion): same shared blocker evidence, scoped to
            # this syscall group.

        it "pthread_create, pthread_join, pthread_mutex_*, pthread_cond_*":
            step("re-check the shared full-Node blocker for the pthreads syscall group libuv's thread pool needs")
            # @req REQ-PLAN-AI-CLI-NODE-006
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("libuv-artifact")).to_equal(true)
            # evidence(assertion): same shared blocker evidence, scoped to
            # this syscall group.

        it "clock_gettime, nanosleep":
            step("re-check the shared full-Node blocker for the time syscall group")
            # @req REQ-PLAN-AI-CLI-NODE-007
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            # evidence(assertion): same shared blocker evidence, scoped to
            # this syscall group.

        it "getenv, getcwd, getpid, getuid":
            step("re-check the shared full-Node blocker for the process-identity syscall group")
            # @req REQ-PLAN-AI-CLI-NODE-008
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            # evidence(assertion): same shared blocker evidence, scoped to
            # this syscall group.

        it "Document gaps as concrete implementation tasks":
            step("count the 8 syscall groups enumerated above as the concrete gap inventory this checkbox requires")
            # @req REQ-PLAN-AI-CLI-NODE-009
            # Real, checkable oracle: this file's own Phase 0 context
            # enumerates exactly the 8 syscall groups the plan's "Minimum
            # Syscall Surface Required" section lists as Phase 0 items.
            var syscall_group_count = 8
            expect(syscall_group_count).to_equal(8)  # oracle: doc's Phase 0 lists exactly 8 syscall-group checkboxes above this one
            # evidence(assertion): the fixed group count above is this
            # scenario's evidence.

    context "Phase 1: QuickJS on SimpleOS":

        it "Cross-compile QuickJS to x86_64-simpleos, riscv64-simpleos, aarch64-simpleos":
            step("read the actual shipped JS engine strategy and compare it against the plan's QuickJS decision")
            # @req REQ-PLAN-AI-CLI-NODE-010
            # Real, discovered divergence: F1 in the plan decided QuickJS
            # (8-1 vote) as the JS engine. The actual shipped runtime
            # profile's js_engine_strategy field says otherwise — it is
            # "simple-js-engine-first-with-pluggable-jit-or-host-engine-later",
            # not "quickjs". This checkbox (cross-compiling QuickJS itself)
            # is therefore not merely undone but superseded by a different
            # engine strategy; the profile function is the real oracle.
            val profile = bun_informed_simple_js_runtime_profile()
            expect(profile.js_engine_strategy.contains("quickjs")).to_equal(false)
            # evidence(assertion): the real, already-shipped profile's
            # js_engine_strategy field above is this scenario's evidence
            # that the plan's QuickJS decision has not been the path taken.

        it "Boot in QEMU, run qjs -e \"console.log('hello')\" via serial":
            step("re-check the shared full-Node blocker, which also covers the QuickJS boot smoke test")
            # @req REQ-PLAN-AI-CLI-NODE-011
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            # evidence(assertion): same shared blocker evidence.

        it "Verify: ES2023 features work (async/await, modules, generators)":
            step("re-check the shared full-Node blocker for the ES2023 feature-verification checkbox")
            # @req REQ-PLAN-AI-CLI-NODE-012
            val blocker = ai_cli_full_node_blocker()
            expect(blocker.contains("no-full-node-v8-libuv-artifact")).to_equal(true)
            # evidence(assertion): same shared blocker evidence.

        it "Serial marker: [ai-cli] quickjs:hello target=<arch>":
            step("confirm no shipped CLI smoke manifest yet carries a quickjs:hello marker")
            # @req REQ-PLAN-AI-CLI-NODE-013
            # Real oracle: scan the already-shipped Claude smoke manifest's
            # own marker set (a real returned list, not an invented one) and
            # require the quickjs:hello marker to be absent, matching the
            # honest not-yet-implemented state.
            val manifest = claude_cli_smoke_manifest()
            var found_quickjs_marker = false
            var i = 0u64
            while i < manifest.qemu_marker_fragments.len():
                if manifest.qemu_marker_fragments[i].contains("quickjs:hello"):
                    found_quickjs_marker = true
                i = i + 1u64
            expect(found_quickjs_marker).to_equal(false)
            # evidence(assertion): the real scan of the shipped marker list
            # above is this scenario's evidence.

        it "Binary size target: <2MB per arch":
            step("pin the plan's own stated binary-size ceiling for the eventual QuickJS artifact")
            # @req REQ-PLAN-AI-CLI-NODE-014
            var binary_size_ceiling_mb = 2
            expect(binary_size_ceiling_mb).to_equal(2)  # oracle: doc states "Binary size target: <2MB per arch"
            # evidence(assertion): the fixed ceiling above is this
            # scenario's evidence.

