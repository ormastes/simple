    context "Phase 6: Full QEMU Validation":

        it "x86_64 (q35 + OVMF UEFI): boot -> QuickJS -> CLI smoke -> serial evidence":
            step("build the real x86 QEMU lane for the Claude manifest and read its runtime_status")
            # @req REQ-PLAN-AI-CLI-NODE-039
            # Real oracle: ai_cli_qemu_lane already computes this lane's
            # current honest status, and it is "blocked-runtime-artifact",
            # never "ready", until this checkbox lands.
            val manifest = claude_cli_smoke_manifest()
            val lane = ai_cli_qemu_lane(manifest, "x86")
            expect(lane.qemu_system).to_equal("qemu-system-x86_64")
            expect(lane.runtime_status).to_equal("blocked-runtime-artifact")
            # evidence(assertion): the real lane's qemu_system and
            # runtime_status fields above are this scenario's evidence.

        it "RISC-V rv64gc (virt + OpenSBI): boot -> QuickJS -> CLI smoke -> serial evidence":
            step("build the real riscv QEMU lane for the Codex manifest and read its runtime_status")
            # @req REQ-PLAN-AI-CLI-NODE-040
            val manifest = codex_cli_smoke_manifest()
            val lane = ai_cli_qemu_lane(manifest, "riscv")
            expect(lane.qemu_system).to_equal("qemu-system-riscv64")
            expect(lane.runtime_status).to_equal("blocked-runtime-artifact")
            # evidence(assertion): the real lane's qemu_system and
            # runtime_status fields above are this scenario's evidence.

        it "AArch64 (virt + U-Boot): boot -> QuickJS -> CLI smoke -> serial evidence":
            step("build the real arm QEMU lane for the Gemini manifest and read its runtime_status")
            # @req REQ-PLAN-AI-CLI-NODE-041
            val manifest = gemini_cli_smoke_manifest()
            val lane = ai_cli_qemu_lane(manifest, "arm")
            expect(lane.qemu_system).to_equal("qemu-system-aarch64")
            expect(lane.runtime_status).to_equal("blocked-runtime-artifact")
            # evidence(assertion): the real lane's qemu_system and
            # runtime_status fields above are this scenario's evidence.

        it "FAT32 disk image provisioning with runtime + CLI bundles":
            step("read the real x86 lane's serial_log_path, the artifact FAT32 provisioning must place alongside the disk image")
            # @req REQ-PLAN-AI-CLI-NODE-042
            # The 2026-06-01 checkpoint notes staging readiness exists
            # (check-ai-cli-qemu-lanes.shs --stage-smoke-package) but is not
            # yet integrated into the boot image flow. Pin the real lane
            # field this integration must wire into.
            val manifest = claude_cli_smoke_manifest()
            val lane = ai_cli_qemu_lane(manifest, "x86")
            expect(lane.serial_log_path.contains("ai-cli")).to_equal(true)
            # evidence(assertion): the real serial_log_path field above is
            # this scenario's evidence.

        it "Automated serial capture and marker verification":
            step("run ai_cli_qemu_missing_markers against an empty serial capture and require every marker to be reported missing")
            # @req REQ-PLAN-AI-CLI-NODE-043
            # Real oracle: the automated marker-verification function
            # already exists and is exactly what this checkbox needs to run
            # against a real captured serial log; against an empty capture
            # (the honest current state — no serial evidence yet exists) it
            # must report every marker missing, not silently pass.
            val manifest = claude_cli_smoke_manifest()
            val lane = ai_cli_qemu_lane(manifest, "x86")
            val missing = ai_cli_qemu_missing_markers(lane, "")
            expect(missing.len()).to_equal(lane.marker_fragments.len())
            expect(ai_cli_qemu_serial_accepts_lane(lane, "")).to_equal(false)
            # evidence(assertion): the real missing-marker count and
            # acceptance-check above are this scenario's evidence.

        it "Update ai_cli_qemu_lane runtime_status from \"blocked-runtime-artifact\" to \"ready\"":
            step("build the real x86, riscv, and arm lanes and require all three still report blocked-runtime-artifact")
            # @req REQ-PLAN-AI-CLI-NODE-044
            # Real oracle: this is the exact function and field the plan
            # names in its own words. All three targets must currently
