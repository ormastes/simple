    context "Phase 3: Node.js Compat Layer":

        it "Serial marker: [ai-cli] node-compat:ready target=<arch>":
            step("confirm no shipped CLI smoke manifest yet carries a node-compat:ready marker, though every other Phase 3 line is already checked off")
            # @req REQ-PLAN-AI-CLI-NODE-024
            # Every other Phase 3 line in the doc is already [x]-checked;
