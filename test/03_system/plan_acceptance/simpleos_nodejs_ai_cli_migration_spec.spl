        it "Test: codex --version":
            step("read the Codex manifest's args and confirm it is the --version smoke invocation this checkbox names")
            # @req REQ-PLAN-AI-CLI-NODE-031
            val manifest = codex_cli_smoke_manifest()
            expect(manifest.args).to_equal(["--version"])
