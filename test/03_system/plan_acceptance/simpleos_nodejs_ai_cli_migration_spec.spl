        it "Add RISC-V and AArch64 targets":
            step("build the QEMU lane list for the Codex manifest and require both riscv and arm targets are present")
            # @req REQ-PLAN-AI-CLI-NODE-032
            # Real oracle: ai_cli_qemu_lanes already enumerates exactly the
            # riscv/x86/arm target set this checkbox needs to also cover.
            val manifest = codex_cli_smoke_manifest()
            val lanes = ai_cli_qemu_lanes(manifest)
            var has_riscv = false
            var has_arm = false
            var i = 0u64
            while i < lanes.len():
                if lanes[i].target == "riscv":
                    has_riscv = true
                if lanes[i].target == "arm":
                    has_arm = true
                i = i + 1u64
            expect(has_riscv and has_arm).to_equal(true)
            # evidence(assertion): the real lane scan above is this
            # scenario's evidence.

        it "Serial marker: [ai-cli] cli-smoke:start app=codex":
            step("scan the Codex manifest's real marker list for the cli-smoke:start app=codex marker")
