"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/language/gpu_fpga/sycl_parity_unified_kernel_plan_2026-06-13.md,
for the plan-acceptance lane defined in
doc/03_plan/agent_tasks/plan_remains_acceptance_2026-09-05.md. Audience: the
compiler-frontend implementer picking up W2.1/W3.x, and the FPGA/board
implementer picking up W3.4/G4.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/sycl_parity_unified_kernel_plan_spec.spl
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented. `parse_descriptive_gpu_kernel`,
`generate_riscv_fpga_bundle_gpu_target`, and `emit_kernel_all_backends` do
not exist anywhere in the tree yet (grep census, 2026-09-05); those `it`s
import them directly so the unresolved symbol becomes the forcing function
per the lane contract.
## Lifecycle
Research
doc/01_research/language/gpu_fpga/sycl_vs_simple_unified_accelerator_research_2026-06-13.md,
plan doc/03_plan/language/gpu_fpga/sycl_parity_unified_kernel_plan_2026-06-13.md,
architecture doc/04_architecture/, and design doc/05_design/ records for the
GPU/FPGA parity effort are the umbrella lifecycle folders this spec traces to.
"""
# @tag:in-development
# doc-path: doc/03_plan/language/gpu_fpga/sycl_parity_unified_kernel_plan_2026-06-13.md
# @cover src/lib/nogc_sync_mut/gpu/queue.spl
# @cover src/lib/nogc_sync_mut/gpu/usm.spl
# @cover src/compiler/10.frontend/lexer_types.spl
# @manual_section "SYCL parity + unified GPU/FPGA kernel plan — W2/W3/W4 remains"

use std.spec.{step}
use std.spec.{describe, it, expect}
use std.fs.{read_file}
use std.common.gpu.device.{gpu_cuda, gpu_none}
use std.nogc_sync_mut.gpu.usm.{usm_malloc_shared}
# Hoisted from the `it` blocks below: a `use` nested inside an `it` cannot
# resolve enums reached transitively by the imported module (`MirTypeKind`,
# `Xlen`). See doc/08_tracking/bug/nested_use_in_it_block_cannot_resolve_transitive_enums_2026-09-05.md
use compiler.driver.riscv_fpga_bundle.{generate_riscv_fpga_bundle_gpu_target}
use compiler.backend.unified_kernel_emit.{emit_kernel_all_backends}

describe "SYCL parity + unified GPU/FPGA kernel plan (doc/03_plan/language/gpu_fpga/sycl_parity_unified_kernel_plan_2026-06-13.md)":

    it "W2.1 descriptive kernel lowering — pending (compiler frontend; library parallel_for+CPU executor cover the productivity gap meanwhile)":
        # @req REQ-SYCL-W2-1
        step("Read the real frontend lexer keyword source under test")
        # Real, checked fact: the frontend lexer has no `parallel` keyword
        # token, so `parallel fn k(i: idx, ...)` cannot lex today -- this is
        # the compiler-frontend half W2.1 still owes (the library-level
        # `GpuQueue.parallel_for` sugar already landed under W1.3/W4.1).
        val lexer_module = read_file("src/compiler/10.frontend/lexer_types.spl")
        step("Assert the frontend does not yet lex a `parallel` keyword token")
        # @capture the lexer's own keyword-token source text is the
        # retained evidence for the still-missing frontend half of W2.1.
        expect(lexer_module.contains("\"parallel\"")).to_equal(false)  # oracle: W2.1 promises a `parallel fn` frontend form; grep census 2026-09-05 found none
        step("Request the promised compiler-level descriptive-kernel parse entry point")
        # Pin the promised compiler-level entry point directly: an
        # unresolved import here is the forcing function for W2.1.
        use compiler.frontend.descriptive_kernel_lowering.{parse_descriptive_gpu_kernel}
        val lowered = parse_descriptive_gpu_kernel("parallel fn k(i: idx):\n    pass\n")
        step("Assert the compiler injects the promised implicit bounds guard")
        expect(lowered.injects_bounds_guard).to_equal(true)  # oracle: W2.1 text, "compiler injects idx = block*dim+thread + bounds guard"

    it "W3.4 board flow, G4 shared/managed seed externs, W3.2 frontend decorator wiring — follow-ups":
        # @req REQ-SYCL-W34-G4-W32
        step("Allocate USM shared memory on a real CUDA-backed Gpu target")
        # G4 (real, checked): usm_malloc_shared never routes through the
        # CUDA managed-memory path even when given a CUDA device -- ptr
        # stays 0 (deterministic host fallback) regardless of backend,
        # because rt_cuda_malloc_managed/rt_cuda_host_alloc do not exist as
        # seed externs anywhere in the tree.
        val shared_on_cuda = usm_malloc_shared(gpu_cuda(0), 64)
        val shared_on_none = usm_malloc_shared(gpu_none(), 64)
        step("Assert the shared allocation still falls back to host storage regardless of the requested backend")
        # @capture shared_on_cuda.ptr/shared_on_none.ptr are the retained
        # evidence: both are 0 (host fallback) even though one requested a
        # real CUDA device, proving the managed-memory path is unwired.
        expect(shared_on_cuda.ptr).to_equal(0)  # oracle: G4 text, "shared/managed still needs seed externs"; usm.spl TODO(W1.2-native)
        expect(shared_on_none.ptr).to_equal(0)  # oracle: same TODO, deterministic host fallback on GpuBackend.None_
        step("Request the promised board-flow bundle generator for the FPGA target")
        # W3.4 board flow (pin the promised entry point directly).
        val bundle = generate_riscv_fpga_bundle_gpu_target("vhdl", "kv260")
        step("Assert the generated bundle names the requested board")
        expect(bundle.board).to_equal("kv260")  # oracle: W3.4 text, "bin/simple build --gpu-target=vhdl --board=kv260"

    it "W3.x — pending (headline)":
        # @req REQ-SYCL-W3-X
        step("Request the promised unified multi-backend kernel emission for vector_add")
        # The headline exit criterion is one MIR emitting PTX, OpenCL C, AND
        # synthesizable VHDL from the SAME kernel. No such unified
        # multi-backend emission entry point exists yet -- pin it directly.
        val emitted = emit_kernel_all_backends("vector_add")
        step("Assert all three sibling backends emit non-empty, backend-shaped output from the SAME kernel")
        # @capture the three emitted artifacts (ptx/opencl/vhdl) are the
        # retained evidence for the headline "same kernel, all backends"
        # exit criterion.
        expect(emitted.ptx.len() > 0).to_equal(true)  # oracle: W3 headline text, "same vector_add kernel emits PTX"
        expect(emitted.opencl.len() > 0).to_equal(true)  # oracle: W3 headline text, "... OpenCL C"
        expect(emitted.vhdl.contains("entity")).to_equal(true)  # oracle: W3 headline text, "... synthesizable VHDL", a VHDL entity keyword

    it "W4.x — pending":
        # @req REQ-SYCL-W4-X
        step("Read the real GpuQueue profiling source under test")
        # Real, checked gap: W4.2's own status note says device timers are
        # "pending native stream binding" -- GpuQueue._elapsed_since always
        # uses CPU wall-clock (time_now_nanos), never a device-side
        # cuEventElapsedTime call, even though every W4 line item is
        # otherwise marked [x] in the plan's own status list.
        val queue_module = read_file("src/lib/nogc_sync_mut/gpu/queue.spl")
        step("Assert profiling still runs on CPU wall-clock, never a device-side elapsed-time call")
        # @capture the queue module's own profiling implementation is the
        # retained evidence for the still-open device-timer gap W4.2 names.
        expect(queue_module.contains("time_now_nanos")).to_equal(true)  # oracle: W4.2 status note, "wall-clock on the CPU path"
        expect(queue_module.contains("cuEventElapsedTime")).to_equal(false)  # oracle: W4.2 status note, "device timers pending native stream binding"
