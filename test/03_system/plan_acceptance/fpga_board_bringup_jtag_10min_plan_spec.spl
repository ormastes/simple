"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/hardware/riscv/fpga_board_bringup_jtag_10min_plan_2026-07-24.md.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/fpga_board_bringup_jtag_10min_plan_spec.spl
Optional: SIMPLE_FPGA_OPENOCD_TRANSCRIPT=<path> names the board-origin
OpenOCD transcript; default build/fpga/evidence/openocd_halt_regs_step.log.
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkbox is implemented. Board/JTAG evidence per
.claude/rules/board-runnable.md: the codec oracle targets the real Simple
TAP/DTM bit-level protocol shared by the already-PASSing Vivado hw_jtag
raw-mode path and the still-blocked OpenOCD-specific path, not a
QEMU/simulation shortcut. No KV260 board or BSCANE2 tunnel is attached to
the host this spec is authored on, so the transcript scenario is RED here by
design until a board run produces the transcript; that is the checkbox's
honest state, not a harness defect.
AUDIT 2026-09-05: the previous single oracle decoded a reply stream the
spec had encoded from its own constant, so it could never disagree with
itself (it stayed green when the IDCODE constant was changed). The codec
scenario now pins the exact remote_bitbang byte stream against the
protocol, decodes a corrupted capture as a control, and the checkbox's
actual deliverable — a board-origin OpenOCD halt/regs/step transcript — has
its own scenario that reads a real file.
## Verification guidance / troubleshooting
If the codec scenario fails to load, jtag_route.spl's TAP codec functions
have been renamed or removed — re-grep src/lib/hardware/link_mux/jtag_route.spl
for jtag_read_idcode_cmds/jtag_decode_idcode before assuming a real board
regression. If the transcript scenario fails on "file missing", no board
run has been recorded yet: run the OpenOCD attach per
src/lib/hardware/debug/openocd_attach.md against the real board and save
the full OpenOCD + gdb session output to the transcript path.
"""
# @tag:in-development
# doc-path: doc/03_plan/hardware/riscv/fpga_board_bringup_jtag_10min_plan_2026-07-24.md
# @manual_section FPGA board bring-up remains

use std.spec.{step}
use std.spec.{describe, context, it, expect}
use std.io_runtime.{env_get, file_exists, file_read}
use std.hardware.link_mux.jtag_route.{jtag_read_idcode_cmds, jtag_decode_idcode}

# Real board oracle recorded in the plan's own evidence: the KV260's inner
# TAP IDCODE, confirmed through the BSCANE2 tunnel via Vivado hw_jtag raw
# mode on 2026-07-24 (Lane B soak PASS section).
# oracle: 0x15350067 is the literal IDCODE the plan's own 2026-07-24
# evidence section records reading back from the real board, not an
# invented constant.
val KV260_INNER_TAP_IDCODE: i64 = 0x15350067

# remote_bitbang wire encoding (OpenOCD remote_bitbang protocol, mirrored
# by jtag_route.spl:18-19): '0'..'7' = write {tck,tms,tdi}, 'R' = sample TDO.
# oracle: cmd_clock(tms, tdi) is two bytes, tck=0 then tck=1, so the
# byte pair for a TMS=1 clock is (0x30+2, 0x34+2) = (0x32, 0x36) and for a
# TMS=0 clock (0x30, 0x34); 'R' is 0x52.
fn expected_idcode_stream() -> [u8]:
    var out: [u8] = []
    var r = 0
    while r < 5:
        out.push(0x32u8)
        out.push(0x36u8)
        r = r + 1
    # TMS=0 -> RUN_TEST_IDLE
    out.push(0x30u8)
    out.push(0x34u8)
    # TMS=1 -> SELECT_DR ; TMS=0 -> CAPTURE_DR ; TMS=0 -> SHIFT_DR
    out.push(0x32u8)
    out.push(0x36u8)
    out.push(0x30u8)
    out.push(0x34u8)
    out.push(0x30u8)
    out.push(0x34u8)
    var bit = 0
    while bit < 32:
        out.push(0x52u8)
        if bit == 31:
            out.push(0x32u8)
            out.push(0x36u8)
        else:
            out.push(0x30u8)
            out.push(0x34u8)
        bit = bit + 1
    out

fn encode_replies(value: i64) -> [u8]:
    # LSB-first ASCII '0'/'1', matching jtag_decode_idcode's own convention.
    var replies: [u8] = []
    var bit = 0
    while bit < 32:
        if ((value >> bit) & 1) == 1:
            replies.push(0x31u8)
        else:
            replies.push(0x30u8)
        bit = bit + 1
    replies

fn transcript_path() -> text:
    val configured = env_get("SIMPLE_FPGA_OPENOCD_TRANSCRIPT") ?? ""
    if configured != "":
        return configured
    "build/fpga/evidence/openocd_halt_regs_step.log"

describe "plan: hardware/riscv/fpga_board_bringup_jtag_10min_plan remains":

    context "Exit Criteria":

        it "JTAG: board-origin OpenOCD halt/regs/step transcript through the Simple TAP/DTM/DM (rv32 satisfied this via Vivado hw_jtag raw mode; the OpenOCD-specific path stays blocked on the tunnel-framing interop bug)":
            step("read the board-origin OpenOCD transcript named by SIMPLE_FPGA_OPENOCD_TRANSCRIPT (default build/fpga/evidence/openocd_halt_regs_step.log)")
            # @req REQ-PLAN-FPGA-BRINGUP-001
            # The checkbox's deliverable is a TRANSCRIPT, so the oracle reads
            # one. Structure alone cannot prove provenance (a fabricated file
            # would pass these substring checks); the board-identity and
            # IDCODE lines are the minimum a reviewer needs to cross-check
            # against the plan's evidence directory, and are what makes this
            # scenario RED on any host that has not run the board.
            val path = transcript_path()
            # @capture path is the transcript location actually read
            expect(file_exists(path)).to_equal(true)  # oracle: the checkbox names a transcript; no file means no board run
            val transcript = if file_exists(path): file_read(path) else: ""
            step("require the OpenOCD TAP discovery line to carry the board's recorded inner-TAP IDCODE")
            # @capture transcript is the full board-origin OpenOCD/gdb session text
            expect(transcript).to_contain("tap/device found: 0x15350067")  # oracle: OpenOCD's own TAP discovery line for the plan's recorded IDCODE 0x15350067
            step("require the halt, register read, step, and resume phases the checkbox names")
            expect(transcript).to_contain("halted")  # oracle: OpenOCD prints "halted" on a successful debug-request halt
            expect(transcript).to_contain("pc ")  # oracle: a register dump names pc; without it "regs" was not read
            expect(transcript).to_contain("step")  # oracle: gdb/OpenOCD echo of the single-step command
            expect(transcript).to_contain("resume")  # oracle: the hart must be resumed after the step
            step("require a board identity so the transcript cannot be a simulation log")
            val names_board = transcript.contains("KV260") or transcript.contains("xck26")
            # @capture names_board is whether the transcript names the physical board (KV260 / xck26 part)
            expect(names_board).to_equal(true)  # oracle: board-runnable rule — board identity is mandatory evidence; GHDL sim logs carry neither token

        it "JTAG codec: the remote_bitbang IDCODE walk and TDO decode agree with the protocol, and a corrupted capture is rejected":
            step("build the remote_bitbang command stream jtag_read_idcode_cmds() emits for walking the TAP to SHIFT_DR")
            # @req REQ-PLAN-FPGA-BRINGUP-002
            # The shared TAP codec is the interface both the PASSing raw-mode
            # path and the blocked OpenOCD path must agree on; pin its exact
            # byte stream against the protocol, not against itself.
            val cmds = jtag_read_idcode_cmds()
            val want = expected_idcode_stream()
            # @capture cmds is the real emitted stream; want is derived independently from the remote_bitbang encoding
            expect(cmds.len()).to_equal(114u64)  # oracle: 5 reset + 1 idle + 3 navigate clocks = 9*2 bytes, plus 32*(R + 2 clock bytes) = 96, total 114
            expect(cmds.len()).to_equal(want.len())
            var mismatches = 0
            var i = 0u64
            while i < cmds.len() and i < want.len():
                if cmds[i] != want[i]:
                    mismatches = mismatches + 1
                i = i + 1u64
            # @capture mismatches is the byte-wise disagreement count between emitted and protocol-derived streams
            expect(mismatches).to_equal(0)  # oracle: zero disagreement — any TMS/TDI/tck ordering change goes red here
            step("decode a 32-bit TDO capture of the board's recorded IDCODE and require the exact value back")
            val decoded = jtag_decode_idcode(encode_replies(KV260_INNER_TAP_IDCODE))
            # @capture decoded is the real decoder's output for the board's recorded IDCODE
            expect(decoded).to_equal(KV260_INNER_TAP_IDCODE)  # oracle: 0x15350067, the plan's 2026-07-24 board readback
            step("control: flip TDO bit 3 of the capture and require the decoder to report a DIFFERENT value")
            var corrupted = encode_replies(KV260_INNER_TAP_IDCODE)
            corrupted[3] = if corrupted[3] == 0x31u8: 0x30u8 else: 0x31u8
            val decoded_corrupt = jtag_decode_idcode(corrupted)
            # @capture decoded_corrupt is the decoder's output for the single-bit-corrupted capture
            expect(decoded_corrupt).to_equal(KV260_INNER_TAP_IDCODE ^ 0x8)  # oracle: LSB-first decode — flipping reply[3] flips value bit 3 (0x8) and nothing else
