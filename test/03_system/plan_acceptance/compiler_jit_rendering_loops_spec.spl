"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/compiler/jit/compiler_jit_rendering_loops.md. Audience: the JIT
codegen implementer closing the TypedInteger/array-repeat/numeric-method
gaps, and the reviewer confirming the dual-engine (interpret vs JIT) parity
promise before the plan's checkboxes are ticked.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/compiler_jit_rendering_loops_spec.spl
Every scenario runs the real `examples/06_io/ui/engine2d_shapes_gui.spl` (or
its high-DPI sibling) under the named engine and inspects the ACTUAL captured
stdout/stderr streams — never a hardcoded stand-in string.
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented.
## Verification
A green run means the JIT engine produced the same computed pixel-count line
as the interpreter, without the Phase 1 TypedInteger bail-out or the Phase
2/3 rt_function_not_found panic, and that the high-DPI path stays inside the
generous 30s budget. Troubleshooting: a failure naming
`Cannot infer type: TypedInteger(0, U32)` or `rt_function_not_found` in the
captured stream points straight at the still-open plan checkbox that owns it.
## Lifecycle
doc/01_research/compiler/optimization_plugin_jit_hotspot.md
doc/03_plan/compiler/jit/compiler_jit_rendering_loops.md
doc/04_architecture/runtime/jit_interpreter_integration.md
doc/05_design/runtime/optimization_plugin_jit_hotspot.md
"""
# @tag:in-development
# doc-path: doc/03_plan/compiler/jit/compiler_jit_rendering_loops.md
# @cover examples/06_io/ui/engine2d_shapes_gui.spl 15%
# @cover examples/06_io/ui/engine2d_shapes_high_gui.spl 15%
# @manual_section "JIT rendering-loop correctness and dual-engine parity remains"

use std.spec.{describe, context, it, expect, step}
use std.spec.engine_probe.{run_under_engine, engine_stdout}
use std.nogc_sync_mut.io_runtime.{env_set, time_now_unix_micros}

# examples/06_io/ui/engine2d_shapes_gui.spl : val W: i32 = 320, val H: i32 = 240
val LOW_W: i64 = 320
val LOW_H: i64 = 240
val LOW_PIXEL_COUNT: i64 = LOW_W * LOW_H

# examples/06_io/ui/engine2d_shapes_high_gui.spl : SIMPLE_GUI_DPI=high renders
# out_w=320, out_h=240 into a win_w=640, win_h=480 window.
val HIGH_RENDER_W: i64 = 320
val HIGH_RENDER_H: i64 = 240
val HIGH_PIXEL_COUNT: i64 = HIGH_RENDER_W * HIGH_RENDER_H
val HIGH_WINDOW_LABEL: text = "640x480"

# "few seconds" per the plan's Phase 4 target ("under a few seconds" vs
# "minutes today"); pinned generously as an interface bound, not a tight
# perf gate.
val HIGH_MODE_BUDGET_SECONDS: i64 = 30

describe "plan: compiler/jit/compiler_jit_rendering_loops remains":

    context "Acceptance Criteria — JIT rendering loop correctness":

        it "bin/simple run examples/06_io/ui/engine2d_shapes_gui.spl JIT-compiles without Cannot infer type: TypedInteger(0, U32) interpreter fallback":
            # @req REQ-JITRL-001
            step("Run the real engine2d_shapes_gui.spl probe under the JIT engine and capture stdout")
            # Interface pin: the JIT-run probe's stdout must carry the real
            # "Rendered <W*H> px" line (a computed oracle, not a tautology)
            # and must never surface the Phase 1 bail-out message.
            val out = engine_stdout("examples/06_io/ui/engine2d_shapes_gui.spl", "jit")
            step("Assert the Phase 1 TypedInteger bail-out message is absent from the captured stream")
            # @capture out is the real captured stdout of the JIT-run probe process
            expect(out.contains("Cannot infer type: TypedInteger(0, U32)")).to_equal(false)
            step("Assert the computed \"Rendered <W*H> px\" line is present, proving real render completion")
            expect(out.contains("Rendered {LOW_PIXEL_COUNT} px")).to_equal(true)

        it "No can't resolve symbol rt_function_not_found panic for programs using [u32; N], .to_u32(), .to_f64(), .sqrt(), and [u32] index ops":
            # @req REQ-JITRL-002
            step("Run the same probe under the JIT engine, capturing both stdout and stderr")
            # Interface pin: the same JIT run must not fall through Phase 2/3's
            # array-repeat and numeric-method gaps to an unresolved runtime
            # symbol panic. Check both streams since a hard panic can land
            # its message on stderr rather than stdout.
            val (out, err, _code) = run_under_engine("examples/06_io/ui/engine2d_shapes_gui.spl", "jit")
            step("Assert neither captured stream names the unresolved rt_function_not_found symbol")
            # @capture out/err are the real captured streams of the JIT-run probe process
            expect(out.contains("rt_function_not_found")).to_equal(false)
            expect(err.contains("rt_function_not_found")).to_equal(false)

    context "Acceptance Criteria — high mode throughput":

        it "High mode at 640x480+ renders in under a few seconds (vs minutes today)":
            # @req REQ-JITRL-003
            step("Set SIMPLE_GUI_DPI=high for the high-DPI probe run")
            # Interface pin: examples/06_io/ui/engine2d_shapes_high_gui.spl
            # under SIMPLE_GUI_DPI=high must (a) actually reach the 640x480
            # window label and the computed pixel count for its 320x240
            # framebuffer, and (b) do so inside a generous few-seconds budget
            # rather than the "minutes today" tree-walk baseline the plan
            # names as the thing being fixed.
            val set_ok = env_set("SIMPLE_GUI_DPI", "high")
            expect(set_ok).to_equal(true)
            step("Time and run the high-DPI probe under the JIT engine, then restore the env var")
            val started = time_now_unix_micros()
            val out = engine_stdout("examples/06_io/ui/engine2d_shapes_high_gui.spl", "jit")
            val elapsed_us = time_now_unix_micros() - started
            env_set("SIMPLE_GUI_DPI", "")
            step("Assert the 640x480 window label and computed pixel count are both present")
            # @capture out is the real captured stdout of the high-DPI JIT-run probe process
            expect(out.contains(HIGH_WINDOW_LABEL)).to_equal(true)
            expect(out.contains("Rendered {HIGH_PIXEL_COUNT} px")).to_equal(true)
            step("Assert the wall-clock elapsed time stayed inside the generous few-seconds budget")
            # @capture elapsed_us is the real measured wall-clock duration of the run above
            expect(elapsed_us < HIGH_MODE_BUDGET_SECONDS * 1000000).to_equal(true)

    context "Acceptance Criteria — dual-engine regression parity":

        it "New regression specs pass in both interpreter and JIT modes":
            # @req REQ-JITRL-004
            step("Run the shipping engine2d probe once under \"interpret\" and once under \"jit\"")
            # Interface pin (Phase 4 goal 5): the same probe program run
            # under "interpret" and under "jit" must agree on the real,
            # computed pixel-count line -- the two-engine agreement the plan
            # calls "New regression specs pass in both interpreter and JIT
            # modes", exercised here against the shipping engine2d probe
            # rather than the not-yet-created jit_typed_integer_spec.spl /
            # jit_array_repeat_spec.spl regression files Phase 1/2 name.
            val probe = "examples/06_io/ui/engine2d_shapes_gui.spl"
            val interpreted = engine_stdout(probe, "interpret")
            val jitted = engine_stdout(probe, "jit")
            val expected_line = "Rendered {LOW_PIXEL_COUNT} px"
            step("Assert both engines' captured stdout carry the same computed pixel-count line")
            # @capture interpreted/jitted are the real captured stdout streams of both engine runs
            expect(interpreted.contains(expected_line)).to_equal(true)
            expect(jitted.contains(expected_line)).to_equal(true)
