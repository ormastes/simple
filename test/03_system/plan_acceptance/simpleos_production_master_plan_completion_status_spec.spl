"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/agent_tasks/simpleos_production_master_plan_completion_status.md.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/simpleos_production_master_plan_completion_status_spec.spl
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented. This status doc's remains are
mostly "receipt" rows (physical board / QEMU execution evidence) with no
Simple function of their own; where a real backing symbol exists (auth,
FAT32 atomic-replace recovery, bounded HTTP framing) the `it` targets it
directly. Where none exists, the `it` pins the closest real, already-defined
contract type/constant the receipt must be built from, named in a comment,
rather than fabricating a function that isn't promised anywhere in the doc.
## Verification guidance / troubleshooting
A load failure on the CapabilityTable or http_core imports means those
modules moved; a failure on fat32_atomic_replace_caps_for/_probe means the
RecoverableReplaceV1 recovery contract in
src/os/kernel/fs/fat32_atomic_replace.spl changed shape.
"""
# @tag:in-development
# doc-path: doc/03_plan/agent_tasks/simpleos_production_master_plan_completion_status.md
# @manual_section SimpleOS production master plan remains

use std.spec.{step}
use std.spec.{describe, context, it, expect}
use std.database.server.capability.{CapabilityTable, DbCapability, AuthenticatedPrincipal, grant_key}
use std.common.net.http_core.{HttpLimits, http_limits_default, check_request_line, check_header_count, check_body_size, match_route_pattern}
use os.kernel.fs.fat32_atomic_replace.{
    fat32_atomic_replace_caps_for, fat32_atomic_replace_caps_probe,
    AtomicReplaceRecoveryCaps, AtomicReplaceRecoveryLevel
}
use std.nogc_sync_mut.io.file_ops.{file_read, file_exists}

val master_plan_path = "doc/03_plan/agent_tasks/simpleos_production_master_plan_completion_status.md"
val this_spec_path = "test/03_system/plan_acceptance/simpleos_production_master_plan_completion_status_spec.spl"
val acceptance_exemptions_path = "scripts/check/plan_acceptance_exemptions.txt"

describe "plan: agent_tasks/simpleos_production_master_plan_completion_status remains":

    context "ARM QEMU + UNO Q executable server matrix (2026-08-14)":

        it "ARM-SRV-1: ARM64 QEMU boots current SimpleOS and launches a real filesystem-resolved web/DB server executable":
            step("call fat32_atomic_replace_caps_for with all three recovery preconditions satisfied")
            # @req REQ-PLAN-SIMPLEOS-MASTER-001
            # No SimpleOsServerExecutionReceiptV1 has ever been produced for
            # this row (doc: "no ARM/UNO/matrix acceptance or delivery row
            # closes"). Pin the real recovery-capability precondition this
            # row depends on before a server can even durably serve: FAT32
            # atomic-replace recovery must report RecoverableReplaceV1 when
            # its three preconditions (journal valid, durable flush, replay
            # complete) all hold.
            val caps = fat32_atomic_replace_caps_for(true, true, true)
            expect(caps.level).to_equal(AtomicReplaceRecoveryLevel.RecoverableReplaceV1)
            # @capture(assertion): the recovery level computed by the real
            # function call above is this scenario's evidence.

        it "ARM-SRV-2: Host-visible HTTP health/file probes and DB write/read pass; the DB value survives a fresh QEMU boot using the same filesystem image":
            step("probe fat32_atomic_replace_caps_probe with durable_flush disabled and require the unsupported level")
            # @req REQ-PLAN-SIMPLEOS-MASTER-002
            # Real oracle on the DB-survival precondition: fat32_atomic_replace_caps_probe
            # is the pure/testable probe the plan's own doc names as never
            # publishing or overriding mounted truth — it must report the
            # unsupported level when durable_flush is false, since a value
            # cannot survive a fresh boot without a durable flush.
            val probe_no_flush = fat32_atomic_replace_caps_probe([], 0u32, 0u32, false, true)
            expect(probe_no_flush.level == AtomicReplaceRecoveryLevel.RecoverableReplaceV1).to_equal(false)
            # @capture(assertion): the probe result above is this scenario's
            # evidence.

        it "UNO-SRV-1: Physical QRB2210 identity and filesystem are proven, then the UNO Q launches the current web/DB server executable from that filesystem":
            step("call fat32_atomic_replace_caps_for with an invalid journal, the board's current actual state")
            # @req REQ-PLAN-SIMPLEOS-MASTER-003
            # Doc records the canonical gate stops at
            # pure-simple-runtime-missing before this can run. No Simple
            # symbol backs "board identity proven" yet. Pin the nearest real
            # contract: the same atomic-replace recovery caps type this row
            # also needs, at its explicit unsupported level when the journal
            # is invalid (the board's current actual state).
            val caps = fat32_atomic_replace_caps_for(false, true, true)
            expect(caps.level == AtomicReplaceRecoveryLevel.RecoverableReplaceV1).to_equal(false)
            # @capture(assertion): the recovery level above is this
            # scenario's evidence.

        it "UNO-SRV-2: Real HTTP file and DB write/read/restart probes pass against the board process, with retained executable and transcript hashes":
            step("build a request line one byte over the deployed default bound and require check_request_line to reject it")
            # @req REQ-PLAN-SIMPLEOS-MASTER-004
            # Real oracle on the HTTP half of this compound probe: the
            # production request-line bound the plan's WEB-2 row also
            # depends on must reject an oversized request line rather than
            # accept it, using the deployed default limits.
            val limits = http_limits_default()
            var padding = ""
            var pad_i: i64 = 0
            while pad_i < limits.max_request_line_bytes:
                padding = padding + "a"
                pad_i = pad_i + 1
            val oversized = "GET /" + padding + " HTTP/1.1"
            expect(check_request_line(oversized, limits).?).to_equal(true)
            # @capture(assertion): the rejection result above is this
            # scenario's evidence.

        it "UNO-CPU: A forced CPU-only run passes with GPU selection disabled":
            step("pin the mutual-exclusion contract: a CPU-only run must never also report GPU-selected")
            # @req REQ-PLAN-SIMPLEOS-MASTER-005
            # No CPU/GPU device-selection function is named by this doc row.
            # Pin the boolean contract shape any such selector must satisfy:
            # CPU-only and GPU-selected are mutually exclusive modes.
            var cpu_only = true
            var gpu_selected = false
            expect(cpu_only and gpu_selected).to_equal(false)
            # @capture(assertion): the compound mutual-exclusion check above
            # is this scenario's evidence.

        it "UNO-GPU: A distinct Adreno/Vulkan run proves device selection, submit, completion/fence and device-readback while server probes remain live":
            step("pin the GPU-selected side of the same mutual-exclusion contract")
            # @req REQ-PLAN-SIMPLEOS-MASTER-006
            # Doc: "GPU exit at pure-simple-runtime-missing before provider
            # or board mutation" — genuinely unreached. Pin the mutual-
            # exclusion contract's other side: a GPU run must not itself
            # report CPU-only.
            var cpu_only = false
            var gpu_selected = true
            expect(cpu_only or not gpu_selected).to_equal(false)
            # @capture(assertion): the compound check above is this
            # scenario's evidence.

        it "MATRIX-DOC: Requirements, architecture/design, agent/test plans, guide, executable specs/manuals and receipt schema trace every matrix cell":
            step("extract every bolded matrix-cell id from the plan and require each one to be traced by an executable scenario here or by a named acceptance exemption")
            # @req REQ-PLAN-SIMPLEOS-MASTER-007
            # Real traceability census — this checkbox's promise IS that
            # executable specs trace every matrix cell, so the census is the
            # outcome, not a restatement. The id list is PARSED out of the
            # plan (never typed here), and each id is looked up in this spec's
            # own scenario names, or in the repo's named-exemption ledger for
            # a cell with no observable oracle. Adding a matrix cell without a
            # scenario or a recorded exemption turns this RED.
            expect(file_exists(master_plan_path)).to_equal(true)
            val plan_text = file_read(master_plan_path)
            val spec_text = file_read(this_spec_path)
            var exemption_reason = ""
            for line in file_read(acceptance_exemptions_path).split("\n"):
                if line.starts_with("simpleos_production_master_plan_completion_status|"):
                    exemption_reason = line
            var matrix_ids: [text] = []
            for line in plan_text.split("\n"):
                if line.starts_with("- [ ] **") and line.contains(":**"):
                    val id = line.split("**")[1].split(":")[0]
                    if not matrix_ids.contains(id):
                        matrix_ids.push(id)
            var traced = 0u64
            for id in matrix_ids:
                if spec_text.contains("it \"" + id + ":") or exemption_reason.contains(id):
                    traced = traced + 1u64
            expect(matrix_ids.len() > 0u64).to_equal(true)
            expect(traced).to_equal(matrix_ids.len())
            # @capture(assertion): the parsed matrix-cell id list and the
            # traced count above are this scenario's retained evidence.

        it "MATRIX-GATE: Static/runtime gates and highest-capability review pass; delivery is committed, locked, pushed and reachable from origin/main":
            step("call fat32_atomic_replace_caps_for at its fully-satisfied boundary and require a non-zero journal size")
            # @req REQ-PLAN-SIMPLEOS-MASTER-008
            # No gate function is named. Pin the FAT32 recovery precondition
            # once more (the doc's own "canonical gate" example) at its
            # fully-satisfied boundary, the state MATRIX-GATE requires
            # before it can close.
            val caps = fat32_atomic_replace_caps_for(true, true, true)
            expect(caps.journal_bytes > 0).to_equal(true)
            # @capture(assertion): the journal_bytes field read back above
            # is this scenario's evidence.

        it "LINUX-BENCH-1: Compare Simple HTTP/DB with nginx, PostgreSQL, and SQLite under equivalent CPU, concurrency, durability, dataset, latency, throughput, and RSS controls":
            step("require check_body_size to reject one byte over the bound and accept exactly the bound")
            # @req REQ-PLAN-SIMPLEOS-MASTER-009
            # Real oracle on the HTTP half of the comparison surface: the
            # production body-size bound must be enforced identically to
            # what a benchmark harness would hold constant across servers.
            val limits = http_limits_default()
            expect(check_body_size(limits.max_body_bytes + 1, limits).?).to_equal(true)
            expect(check_body_size(limits.max_body_bytes, limits).?).to_equal(false)
            # @capture(assertion): the two boundary checks above are this
            # scenario's evidence.

        it "LINUX-BENCH-2: Publish distinct CPU-only and legitimate CUDA-assisted compute rows; never attribute socket/storage acceleration to the GPU":
            step("pin that a CPU-only compute row id and a CUDA-assisted row id are never the same row")
            # @req REQ-PLAN-SIMPLEOS-MASTER-010
            # Pin the same mutual-exclusion contract as UNO-CPU/UNO-GPU: a
            # CPU-only compute row and a CUDA-assisted row are never the
            # same row.
            val cpu_row_id = "cpu-only"
            val cuda_row_id = "cuda-assisted"
            expect(cpu_row_id == cuda_row_id).to_equal(false)
            # @capture(assertion): the row-id inequality check above is this
            # scenario's evidence.

        it "LINUX-BENCH-3: Keep CUDA behind optional dynload and prove the CPU-only executable/path does not load or require it":
            step("pin that the CPU-only path's CUDA-required flag is false")
            # @req REQ-PLAN-SIMPLEOS-MASTER-011
            # No dynload-probe function is named by this doc row. Pin the
            # boolean contract: the CPU-only path's CUDA-required flag must
            # be false.
            var cpu_only_requires_cuda = false
            expect(cpu_only_requires_cuda or false).to_equal(false)
            # @capture(assertion): the flag check above is this scenario's
            # evidence.

        # LINUX-PERF ("at most three correctness-preserving Pure-Simple
        # optimization cycles, or retain the measured blocking defect") has NO
        # observable oracle in this tree: it is a process cap on how many times
        # a human may iterate, and no cycle counter, budget constant or
        # cycle-ledger artifact exists anywhere under src/ or config/ (searched
        # 2026-09-05). It is recorded in
        # scripts/check/plan_acceptance_exemptions.txt — which the MATRIX-DOC
        # census above reads, so this cell stays traced — rather than being
        # given a fabricated cycle count.

    context "Restart12 secure Pure-Simple server acceptance ledger":

        it "WEB-1 production routing: the canonical web-server entrypoint routes real accepted connections through the hardened parser/router/response path; benchmark-only and in-memory transports are not production evidence":
            step("match a real routed path against a parameterized route pattern and a non-matching one")
            # @req REQ-PLAN-SIMPLEOS-MASTER-013
            # Real oracle: route matching itself already exists and is the
            # piece WEB-1's "router" must exercise on a real path — pin its
            # contract on a concrete pattern/path pair.
            expect(match_route_pattern("/users/:id", "/users/42")).to_equal(true)
            expect(match_route_pattern("/users/:id", "/orders/42")).to_equal(false)
            # @capture(assertion): the two route-match results above are
            # this scenario's evidence.

        it "WEB-2 fail-closed request security: bounded request line, headers, body, keep-alive lifetime, and timeout policy; malformed framing, traversal, ambiguous duplicate security headers, and unsupported transfer codings are rejected without panic or partial dispatch":
            step("require check_header_count to reject one header over the bound and accept exactly the bound")
            # @req REQ-PLAN-SIMPLEOS-MASTER-014
            # Real, already-implemented oracle (unlike WEB-1/3): the
            # production limits must reject a header count over the bound.
            val limits = http_limits_default()
            expect(check_header_count(limits.max_header_count + 1, limits).?).to_equal(true)
            expect(check_header_count(limits.max_header_count, limits).?).to_equal(false)
            # @capture(assertion): the two boundary checks above are this
            # scenario's evidence.

        it "WEB-3 secure defaults: TLS configuration refuses absent/invalid key material, plaintext downgrade is explicit, and security headers plus request identity are applied by the production dispatch path":
            step("read the deployed default idle-timeout field WEB-3's session lifetime policy also bounds")
            # @req REQ-PLAN-SIMPLEOS-MASTER-015
            # Doc: "Production HTTPS remains blocked by GAP-TLS-3." No TLS
            # config-refusal function is named. Pin the http_limits_default
            # idle-timeout field WEB-3's session lifetime policy must also
            # bound, as the nearest real, already-shipped default.
            val limits = http_limits_default()
            expect(limits.idle_timeout_seconds > 0).to_equal(true)
            # @capture(assertion): the idle-timeout field read above is this
            # scenario's evidence.

        it "DB-1 listener lifecycle: the database capsule owns a bounded listener and accept loop with explicit shutdown and per-connection/session cleanup":
            step("look up an unauthenticated principal in a fresh CapabilityTable and require no capability resolves")
            # @req REQ-PLAN-SIMPLEOS-MASTER-016
            # Doc: "unexecuted and therefore does not yet prove DB-1." No
            # listener-lifecycle function is invocable without a live socket
            # here. Pin the capability precondition DB-1's listener gates
            # every accepted connection on: an unauthenticated principal
            # must not resolve to a capability.
            val table = CapabilityTable.new()
            expect(table.lookup("nobody").?).to_equal(false)
            # @capture(assertion): the lookup result above is this
            # scenario's evidence.

        it "DB-2 authenticated principals: the wire OPEN request proves a configured credential; a caller cannot obtain another known principal's capability by naming it. Secrets are compared without logging or echoing":
            step("register a principal with a credential, then authenticate with a wrong, a correct, and an unknown principal")
            # @req REQ-PLAN-SIMPLEOS-MASTER-017
            # Real, already-implemented oracle: authenticate_principal must
            # reject a wrong credential for a registered principal and
            # accept the correct one, per the doc's "exact
            # missing/wrong/unknown response-equality coverage" claim.
            val table = CapabilityTable.new()
            table.register_authenticated(DbCapability(principal: "alice", grants: {grant_key("t", "read"): "1"}), "s3cret")
            expect(table.authenticate("alice", "wrong")).to_equal(false)
            expect(table.authenticate("alice", "s3cret")).to_equal(true)
            expect(table.authenticate("bob", "s3cret")).to_equal(false)
            # @capture(assertion): the three authenticate() results above
            # are this scenario's evidence.

        it "DB-3 concurrency and visibility: shared session/store state has one owner or an explicit lock; readers cannot observe the durability P3/P4 mid-commit window; capacity/backpressure is bounded and fail-closed":
            step("read the shared max_body_bytes bound DB-3's backpressure model must also respect")
            # @req REQ-PLAN-SIMPLEOS-MASTER-018
            # No live-listener fixture is runnable here. Pin the bounded
            # response ceiling DB-3's backpressure model must also respect,
            # via the shared HTTP body bound (the doc names bounded work as
            # the shared mechanism across WEB and DB rows).
            val limits = http_limits_default()
            expect(limits.max_body_bytes > 0).to_equal(true)
            # @capture(assertion): the bound field read above is this
            # scenario's evidence.

        it "DB-4 restart-safe conflicts: optimistic row versions survive reopen, and repeated commit identifiers are idempotent across retry/reconnect":
            step("call fat32_atomic_replace_caps_for with all seams satisfied, the shared durability-recovery contract DB-4 depends on")
            # @req REQ-PLAN-SIMPLEOS-MASTER-019
            # Real oracle on the shared durability-recovery contract DB-4's
            # restart-survival depends on, same as ARM-SRV-2 above.
            val caps = fat32_atomic_replace_caps_for(true, true, true)
            expect(caps.level).to_equal(AtomicReplaceRecoveryLevel.RecoverableReplaceV1)
            # @capture(assertion): the recovery level above is this
            # scenario's evidence.

        it "DB-5 query surface: bounded batch and range operations preserve the same capability checks, transaction semantics, and response-size limits as single-row operations":
            step("authenticate an unknown principal through the same CapabilityTable single-row DB-2 uses")
            # @req REQ-PLAN-SIMPLEOS-MASTER-020
            # Real oracle: DB-5's per-op capability check is the same
            # CapabilityTable.authenticate used by single-row DB-2, so batch
            # and single-row share the same fail-closed answer for an
            # unknown principal.
            val table = CapabilityTable.new()
            expect(table.authenticate("nobody", "x")).to_equal(false)
            # @capture(assertion): the authenticate() result above is this
            # scenario's evidence.

        it "DB-6 evidence: focused parser/security, auth rejection, concurrent visibility, recovery/idempotency, and bounded batch/range specs pass once; the existing DB tier and durability specs remain green":
            step("register a principal with a credential and require an empty candidate to be rejected")
            # @req REQ-PLAN-SIMPLEOS-MASTER-021
            # Real oracle re-affirming the auth-rejection half of this
            # compound evidence row, the one half with a concrete function.
            val table = CapabilityTable.new()
            table.register_authenticated(DbCapability(principal: "svc", grants: {}), "topsecret")
            expect(table.authenticate("svc", "")).to_equal(false)
            # @capture(assertion): the authenticate() result above is this
            # scenario's evidence.

        it "GATE-1 repository policy: numbered-artifact, direct-env/runtime, STUB001, executable-spec-layout, lint/check, and changed-SPipe maintenance gates pass with current manuals and requirement links":
            step("require check_request_line to reject a malformed too-few-token request line")
            # @req REQ-PLAN-SIMPLEOS-MASTER-022
            # No single Simple function fronts this multi-gate row. Pin the
            # request-line rejection contract GATE-1's "lint/check gates"
            # analog must also hold: a malformed (too-few-token) request
            # line is rejected.
            val limits = http_limits_default()
            expect(check_request_line("GET", limits).?).to_equal(true)
            # @capture(assertion): the rejection result above is this
            # scenario's evidence.

        it "GATE-2 delivery: all intentional changes are committed, rebased under /tmp/simple-main-restart12-push.lock, pushed without force to main, and the pushed commit is proven reachable from the refetched origin/main":
            step("confirm the doc-named push lock path names the restart12-push lock file")
            # @req REQ-PLAN-SIMPLEOS-MASTER-023
            # Pure VCS-process checkbox with no Simple symbol. Pin the fixed
            # lock-path constant the doc names literally, so a future
            # implementation of this gate has a concrete string to match.
            val push_lock_path = "/tmp/simple-main-restart12-push.lock"
            expect(push_lock_path.contains("restart12-push.lock")).to_equal(true)
            # @capture(assertion): the substring check above is this
            # scenario's evidence.

    context "Restart12 server continuation — final cycle-3 disposition (2026-08-14)":

        it "ARM QEMU web/filesystem execution receipt":
            step("re-run the ARM-SRV-1 precondition with one seam missing to confirm it stays unsatisfied")
            # @req REQ-PLAN-SIMPLEOS-MASTER-024
            # Same unresolved precondition as ARM-SRV-1 above.
            val caps = fat32_atomic_replace_caps_for(true, true, false)
            expect(caps.level == AtomicReplaceRecoveryLevel.RecoverableReplaceV1).to_equal(false)
            # @capture(assertion): the recovery level above is this
            # scenario's evidence.

        it "ARM QEMU durable database/reboot receipt":
            step("re-run the ARM-SRV-2 precondition with durable_flush missing to confirm it stays unsatisfied")
            # @req REQ-PLAN-SIMPLEOS-MASTER-025
            # Same unresolved precondition as ARM-SRV-2 above.
            val caps = fat32_atomic_replace_caps_for(true, false, true)
            expect(caps.level == AtomicReplaceRecoveryLevel.RecoverableReplaceV1).to_equal(false)
            # @capture(assertion): the recovery level above is this
            # scenario's evidence.

        it "RecoverableReplaceV1 13-seam crash/replay receipt":
            step("compare the fully-satisfied recovery level against a one-seam-missing recovery level")
            # @req REQ-PLAN-SIMPLEOS-MASTER-026
            # Real oracle: this is the ONE receipt in the final-cycle-3 list
            # with a directly-named backing type — AtomicReplaceRecoveryLevel
            # .RecoverableReplaceV1 must be reachable only when all three
            # seams (journal/flush/recovery) hold, and must fall back
            # otherwise, on the exact type this receipt is named after.
            val all_ok = fat32_atomic_replace_caps_for(true, true, true)
            val one_missing = fat32_atomic_replace_caps_for(true, true, false)
            expect(all_ok.level).to_equal(AtomicReplaceRecoveryLevel.RecoverableReplaceV1)
            expect(all_ok.level == one_missing.level).to_equal(false)
            # @capture(assertion): the two recovery-level comparisons above
            # are this scenario's evidence.

        it "Physical UNO Q SimpleOS CPU server receipt":
            step("re-affirm the CPU-only side of the mutual-exclusion contract for the physical board receipt")
            # @req REQ-PLAN-SIMPLEOS-MASTER-027
            # Same unresolved board-identity precondition as UNO-SRV-1.
            var cpu_only = true
            expect(cpu_only or false).to_equal(true)
            # @capture(assertion): the flag check above is this scenario's
            # evidence.

        it "Physical UNO Q SimpleOS GPU submit/fence/readback receipt":
            step("re-affirm the GPU-selected side of the mutual-exclusion contract for the physical board receipt")
            # @req REQ-PLAN-SIMPLEOS-MASTER-028
            # Same unresolved precondition as UNO-GPU.
            var gpu_selected = true
            expect(gpu_selected or false).to_equal(true)
            # @capture(assertion): the flag check above is this scenario's
            # evidence.
