# ============================================================================
# Group 5 — checkboxes marked **[CLOSED]**/**[EXISTS]** in the plan (lines
# 25, 29, 30, 31, 32, 33, 74, 80, 81, 82, 103, 108, 109, 191, 192, 193, 201).
# The markdown checkbox itself is still literally `- [ ]` (unchecked) for
# every one of these — the plan's own status tag, not the checkbox glyph, is
# what marks them done. Grouped into ONE regression-guard `it` that re-proves
# each landed artifact is still present, so a later revert would show up as a
# newly-red acceptance oracle rather than as silence. Two rows (29, 30) name
# internal micro-opts (`debug_state` atomics, extern-dispatch map lookup)
# with no stable public symbol to grep for — those rows use the interpreter
# perf-harness's continued existence as the only available regression proxy
# and are flagged here as too vague for a real symbol-level oracle.
# ============================================================================

class ClosedItemRow:
    label: text
    probe_cmd: text

val CLOSED_ITEM_ROWS: [ClosedItemRow] = [
    ClosedItemRow(label: "line 25: interpreter cold-startup audit harness exists", probe_cmd: "test -f scripts/check/check-startup-size-performance-audit.shs && echo 1 || echo 0"),
    ClosedItemRow(label: "line 29: debug_state contention fix proxy (interpreter perf harness present)", probe_cmd: "test -f test/01_unit/app/interpreter/perf_spec.spl && echo 1 || echo 0"),
    ClosedItemRow(label: "line 30: extern-dispatch lookup fix proxy (interpreter perf harness present)", probe_cmd: "test -f test/01_unit/app/interpreter/perf_spec.spl && echo 1 || echo 0"),
    ClosedItemRow(label: "line 31: mimalloc wired for interpreter heap", probe_cmd: "grep -l mimalloc src/compiler_rust/driver/Cargo.toml 2>/dev/null | wc -l"),
    ClosedItemRow(label: "line 32: mold linker referenced for seed builds", probe_cmd: "grep -c mold src/compiler_rust/driver/src/cli/compile.rs 2>/dev/null"),
    ClosedItemRow(label: "line 33: rayon integration present", probe_cmd: "grep -l rayon src/compiler_rust/driver/Cargo.toml 2>/dev/null | wc -l"),
    ClosedItemRow(label: "line 74: WORKERS/FANOUT_WORKERS dimensions in cross-language-perf harness", probe_cmd: "grep -c 'FANOUT_WORKERS' scripts/check/check-cross-language-perf.shs 2>/dev/null"),
    ClosedItemRow(label: "line 80: SMF cache validation pipeline (validate_source_hash/validate_shb) present", probe_cmd: "grep -c 'fn validate_shb' src/compiler/80.driver/cache/cache_validator.spl 2>/dev/null"),
    ClosedItemRow(label: "line 81: stale-source cache miss uses source_hash + interface hash", probe_cmd: "grep -c 'source_hash' src/compiler/80.driver/cache/cache_validator.spl 2>/dev/null"),
    ClosedItemRow(label: "line 82: WatcherDaemon class exists for idle background compile", probe_cmd: "grep -l 'class WatcherDaemon' src/compiler/80.driver/watcher/watcher_daemon.spl 2>/dev/null | wc -l"),
    ClosedItemRow(label: "line 103: HTTP/2 ALPN handshake path present", probe_cmd: "grep -rl 'alpn\\|ALPN' src/lib/gc_async_mut/tls --include='*.spl' 2>/dev/null | wc -l"),
    ClosedItemRow(label: "line 108: static file serving (ETag) present", probe_cmd: "grep -rl 'ETag\\|etag' src/app/simple_portal --include='*.spl' 2>/dev/null | wc -l"),
    ClosedItemRow(label: "line 109: NetBackendCapabilities tiers present", probe_cmd: "grep -rl 'NetBackendCapabilities' src/lib/nogc_async_mut/io --include='*.spl' 2>/dev/null | wc -l"),
    ClosedItemRow(label: "line 191: NVFS/FAT32 driver symbols present", probe_cmd: "grep -rl 'nvfs\\|NVFS' src/os/services/vfs --include='*.spl' 2>/dev/null | wc -l"),
    ClosedItemRow(label: "line 192: FS profiling harness proxy (os bench spec present)", probe_cmd: "test -f test/05_perf/os/os_fs_sched_bench_spec.spl && echo 1 || echo 0"),
    ClosedItemRow(label: "line 193: rt_bytes_alloc/rt_text_to_bytes have pure-Simple call sites outside the runtime", probe_cmd: "grep -rl 'rt_bytes_alloc\\|rt_text_to_bytes' src/os/services/vfs --include='*.spl' 2>/dev/null | wc -l"),
    ClosedItemRow(label: "line 201: WatcherDaemon-adjacent scheduler/process-isolation symbols present", probe_cmd: "grep -rl 'process_isolation' src/lib/nogc_async_mut --include='*.spl' 2>/dev/null | wc -l")
]

# @manual_section: Closed-Status Regression Guards
describe "perf_checklists.md — closed-status regression guards (lines 25,29,30,31,32,33,74,80,81,82,103,108,109,191,192,193,201)":

    it "every artifact the plan already marks CLOSED/EXISTS is still present":
        step("re-probing every CLOSED/EXISTS artifact named in the plan to catch a silent revert")
        # @req REQ-PERF-CHECKLISTS-001
        var idx: i64 = 0
        while idx < CLOSED_ITEM_ROWS.len():
            val row = CLOSED_ITEM_ROWS[idx]
            step("probing " + row.label)
            val n = shell_count(row.probe_cmd)
            # @capture: each row's live probe count is the retained regression evidence
            expect(n > 0i64).to_equal(true)
            idx = idx + 1
        expect(CLOSED_ITEM_ROWS.len()).to_equal(17)  # oracle: the plan marks exactly 17 items CLOSED/EXISTS among the 75 open checkboxes (lines enumerated in the header comment above)
