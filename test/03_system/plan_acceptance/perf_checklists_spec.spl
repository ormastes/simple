# @manual_section: AC-8 Arch Guard
describe "perf_checklists.md — AC-8 arch-guard contract (lines 42,85,120,144,173,208)":

    it "check-api-arch-guard.shs exposes the promised three-marker verdict contract for every domain":
        step("reading check-api-arch-guard.shs and confirming its verdict-marker contract holds for each AC-8 domain")
        # @req REQ-PERF-CHECKLISTS-001
        val guard_src = read_or_empty("scripts/check/check-api-arch-guard.shs")
        expect(rt_file_exists("scripts/check/check-api-arch-guard.shs")).to_equal(true)
        val has_ok_marker = guard_src.contains("api_arch_guard_ok=")
        val has_symbols_marker = guard_src.contains("api_arch_guard_symbols=")
        val has_arch_marker = guard_src.contains("api_arch_guard_arch=")
        # @capture: the three verdict-marker booleans read from the live guard script are the retained evidence
        var i: i64 = 0
        while i < AC8_DOMAINS.len():
            val domain = AC8_DOMAINS[i]
            step("checking AC-8 verdict contract for " + domain)
            # Each domain's checkbox promises the SAME guard stays green for
            # that domain's public surface; the guard script itself carries
            # exactly one verdict contract, asserted once per named domain.
            expect(has_ok_marker).to_equal(true)
            expect(has_symbols_marker).to_equal(true)
            expect(has_arch_marker).to_equal(true)
            i = i + 1
        expect(AC8_DOMAINS.len()).to_equal(6)  # oracle: the plan names exactly 6 domain sections (1-6), copied verbatim above

    it "AC-8 public-API snapshot directory exists for recording per-domain diffs":
        step("confirming the doc/08_tracking/api_surface snapshot directory the plan requires exists")
        # @req REQ-PERF-CHECKLISTS-001
        # @capture: the snapshot directory's on-disk existence is the retained evidence
        expect(rt_file_exists("doc/08_tracking/api_surface")).to_equal(true)

# @manual_section: AC-9 rt_* Reduction
describe "perf_checklists.md — AC-9 rt_* reduction (lines 45,46,88,123,147,176,212)":

    it "measures current rt_* call-site count per domain tree against the plan's named baseline":
        step("running the plan's own grep formula against every AC-9 source tree")
        # @req REQ-PERF-CHECKLISTS-001
        var idx: i64 = 0
        while idx < AC9_ROWS.len():
            val row = AC9_ROWS[idx]
            step("measuring rt_* call-site count for " + row.domain)
            if rt_file_exists(row.path):
                val cmd = "grep -r 'rt_' " + row.path + " --include='*.spl' 2>/dev/null | grep -v '^[[:space:]]*//' | wc -l"
                val measured = shell_count(cmd)
                # @capture: the measured rt_* call-site count per tree is the retained evidence
                # A real count must have been produced.
                expect(measured >= 0i64).to_equal(true)
                if row.baseline >= 0i64:
                    # Reduction-target rows (interp nogc_sync_mut=7974, OS
                    # noalloc=358, both named verbatim in the plan): the
                    # acceptance bar is "no growth vs the recorded baseline".
                    val within_budget = measured <= row.baseline
                    expect(within_budget).to_equal(true)  # expected FAIL until the rt_* sweep lands
            idx = idx + 1
        expect(AC9_ROWS.len()).to_equal(6)  # oracle: the plan names 6 rt_* reduction rows across the 6 domains (7 checkboxes, 2 combined for the interpreter domain)

