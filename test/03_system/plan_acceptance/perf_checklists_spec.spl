# doc-path: doc/03_plan/infra/perf_umbrella/perf_checklists.md
# @manual_section: Perf Umbrella Plan Acceptance
# lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md doc/04_architecture/sspec_documentization_maintenance.md doc/05_design/app/testing/in_development_tag.md
# @req REQ-PERF-CHECKLISTS-001 — every scenario in this file binds to that one
# requirement id: acceptance evidence for the perf-umbrella plan's open items.

use std.nogc_sync_mut.io.process_ops.{process_run}
use std.spec.{step}

use std.nogc_sync_mut.io.process_ops.{process_run}
use std.spec.{describe, it, expect}

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_text(path: text) -> text
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn read_or_empty(path: text) -> text:
    if rt_file_exists(path):
        return rt_file_read_text(path)
    ""

fn _digit_value(ch: text) -> i64:
    if ch == "0": 0
    elif ch == "1": 1
    elif ch == "2": 2
    elif ch == "3": 3
    elif ch == "4": 4
    elif ch == "5": 5
    elif ch == "6": 6
    elif ch == "7": 7
    elif ch == "8": 8
    elif ch == "9": 9
    else: -1

fn shell_count(cmd: text) -> i64:
    # Runs a shell pipeline and parses a trailing integer count from stdout.
    # Mirrors the exact `grep -r 'rt_' <path> --include='*.spl' | grep -v ... | wc -l`
    # measurement literally named in the plan (line 45).
    val (stdout, _stderr, _code) = rt_process_run("sh", ["-c", cmd])
    var digits = ""
    var i: i64 = 0
    while i < stdout.len():
        val ch = stdout.char_at(i)
        val dv = _digit_value(ch)
        if dv >= 0:
            digits = digits + ch
        elif digits.len() > 0:
            i = stdout.len()
        i = i + 1
    if digits.len() == 0:
        return -1
    var result: i64 = 0
    var j: i64 = 0
    while j < digits.len():
        result = result * 10 + _digit_value(digits.char_at(j))
        j = j + 1
    result

# ============================================================================
# Group 1 — AC-8 "check-api-arch-guard.shs must stay green" (checklist lines
# 42, 85, 120, 144, 173, 208): the SAME guard script and SAME verdict
# contract, repeated once per domain section. Grouped into one table-driven
# `it` iterating the domain list verbatim from the plan, checking the guard
# script's real, promised verdict-marker contract (api_arch_guard_ok=,
# api_arch_guard_symbols=, api_arch_guard_arch=) rather than re-running the
# (baseline-diffing, snapshot-mutating) script six times in a loop.
# ============================================================================

val AC8_DOMAINS: [text] = [
    "Language — Script (Interpreter) (line 42)",
    "Language — Compiler (SMF + Native) (line 85)",
    "Web Server (line 120)",
    "Database — RAM-Only (line 144)",
    "Database — Persistent (line 173)",
    "OS (x86_64) (line 208)"
]

# ============================================================================
# Group 2 — AC-9 "rt_* count measured vs baseline; reduction recorded"
# (checklist lines 45, 46, 88, 123, 147, 176, 212): the same
# grep-count-vs-baseline pattern applied to seven different source trees.
# Grouped into one table-driven `it` iterating {domain, path, baseline}
# rows copied verbatim from the plan's own numbers (7,974 / 358) where the
# plan names one, and left as a presence-only proxy (baseline: -1) where the
# plan does not yet name a captured baseline for that tree (compiler sweep
# line 88, web line 123, db-ram line 147, db-persistent line 176 — these are
# flagged explicitly in the report as too vague for a numeric budget).
# ============================================================================

class RtReductionRow:
    domain: text
    path: text
    baseline: i64

val AC9_ROWS: [RtReductionRow] = [
    RtReductionRow(domain: "Language — Script (Interpreter) (lines 45,46)", path: "src/lib/nogc_sync_mut", baseline: 7974),
    RtReductionRow(domain: "Language — Compiler (SMF + Native) (line 88)", path: "src/lib/nogc_sync_mut", baseline: -1),
    RtReductionRow(domain: "Web Server (line 123)", path: "src/lib/nogc_sync_mut/src/net", baseline: -1),
    RtReductionRow(domain: "Database — RAM-Only (line 147)", path: "database/pure_sql", baseline: -1),
    RtReductionRow(domain: "Database — Persistent (line 176)", path: "database/pure_sql", baseline: -1),
    RtReductionRow(domain: "OS x86_64 (line 212)", path: "src/lib/nogc_async_mut_noalloc", baseline: 358)
]

