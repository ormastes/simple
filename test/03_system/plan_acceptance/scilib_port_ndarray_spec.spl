"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/lib/scilib/ports/scilib_port_ndarray.md (final AC-7 audit
sweep). Audience: the scilib-port implementer closing out the ndarray area
and any reviewer verifying the v1 gate before ml/blas/lapack build on it.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/scilib_port_ndarray_spec.spl
SIMPLE_BINARY=<path> names the Simple binary the mock-backend scenario runs
each ndarray spec through (default bin/simple).
## Verification and troubleshooting guidance
A failing scenario names the exact audit it violates. Re-run the quoted
grep/shell command by hand against the real tree to see the offending
lines, or re-run the numeric NDArray oracle directly in a REPL to confirm
`std.linalg`/`std.ndarray` still compute the hand-checked value.
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented. Scans the real ndarray source
tree (`src/lib/nogc_async_mut/ndarray/`, `src/lib/common/science_math/ndarray.spl`)
and the real spec locations (`test/03_system/feature/scilib/ndarray_*_spec.spl`).
AUDIT 2026-09-05: every count was `grep -rc ... 2>/dev/null | awk` — a
nonexistent path produced 0 and therefore a pass, and the primitive-type
audit grepped for `pub fn`, which this tree never writes (it uses bare
`fn`), so it matched nothing while 10 function signatures and 3 struct
fields carry primitives. Every count below is now paired with a scanned-file
control that MUST be non-zero, the primitive audit matches the tree's real
syntax (and is honestly RED), and the mock-backend audit RUNS every ndarray
spec under SIMPLE_BLAS_BACKEND=mock in interpreter mode instead of grepping
for a string no spec contains.
"""
# @tag:in-development
# doc-path: doc/03_plan/lib/scilib/ports/scilib_port_ndarray.md
# @cover src/lib/nogc_async_mut/ndarray/
# @cover src/lib/common/science_math/ndarray.spl

use std.spec.{step}
use std.spec.{describe, context, it, expect}
use std.io_runtime.{process_run, env_get, file_exists, dir_list}
use std.linalg.*
use std.ndarray.*

val NDARRAY_SRC: text = "src/lib/nogc_async_mut/ndarray src/lib/common/science_math/ndarray.spl"
val NDARRAY_SPEC_DIR: text = "test/03_system/feature/scilib"

fn shell_count(cmd: text) -> i64:
    """Run a counting pipeline; -1 when the output is not a number, so a
    broken pipeline can never read as zero occurrences."""
    val (out, _err, _code) = process_run("/bin/sh", ["-c", cmd])
    out.trim().to_i64() ?? -1

fn files_scanned(paths: text) -> i64:
    """Control for every grep-based audit: the number of `.spl` files the
    audit's path set actually resolves to. Zero means the audit scanned
    nothing and its count is meaningless (testing.md measurement trap)."""
    shell_count("find " + paths + " -name '*.spl' 2>/dev/null | wc -l | tr -d ' '")

fn ndarray_spec_files() -> [text]:
    var out: [text] = []
    for entry in dir_list(NDARRAY_SPEC_DIR):
        if entry.starts_with("ndarray_") and entry.ends_with("_spec.spl"):
            out.push(NDARRAY_SPEC_DIR + "/" + entry)
    out

fn simple_binary() -> text:
    val configured = env_get("SIMPLE_BINARY") ?? ""
    if configured != "" and file_exists(configured):
        return configured
    "bin/simple"

describe "plan: lib/scilib/ports/scilib_port_ndarray remains (final audit sweep)":

    # @manual_section AC-7 final compliance audit
    context "AC-7 final compliance audit":

        it "No `nvfortran` dependency added":
            # @req REQ-SCILIB-NDARRAY-01
            step("Control: the ndarray source path set must resolve to real files")
            val scanned = files_scanned(NDARRAY_SRC)
            # @capture scanned is the number of .spl files the audit path set resolves to
            expect(scanned > 0).to_equal(true)  # oracle: a count over zero files is not a count
            step("Count nvfortran references across the real ndarray source tree")
            val n = shell_count("grep -rc 'nvfortran' " + NDARRAY_SRC + " | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): occurrence count from the real ndarray tree
            expect(n).to_equal(0)  # oracle: 0 — the ndarray area must not pull in a Fortran toolchain dependency

        it "No DataFrame ops or `Symbol` intern added (df scope)":
            # @req REQ-SCILIB-NDARRAY-02
            step("Control: the ndarray source path set must resolve to real files")
            expect(files_scanned(NDARRAY_SRC) > 0).to_equal(true)  # oracle: non-vacuity control
            step("Count DataFrame/Symbol-intern references leaking into the ndarray area")
            val n = shell_count("grep -rEc 'DataFrame|SymbolIntern|Symbol\\.intern' " + NDARRAY_SRC + " | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): occurrence count from the real ndarray tree
            expect(n).to_equal(0)  # oracle: 0 — df scope is disjoint from ndarray by architecture

        it "No acceptance criterion written as \"passes `--mode=native`\"":
            # @req REQ-SCILIB-NDARRAY-03
            step("Control: the ndarray spec set must be non-empty")
            val specs = ndarray_spec_files()
            # @capture specs is the real list of ndarray_*_spec.spl files under the scilib feature dir
            expect(specs.len() > 0u64).to_equal(true)  # oracle: non-vacuity control
            step("Count --mode=native bypass mentions inside the real ndarray specs' own run instructions")
            val n = shell_count("grep -rc -- '--mode=native' " + NDARRAY_SPEC_DIR + "/ndarray_*_spec.spl | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): occurrence count from the real spec tree
            expect(n).to_equal(0)  # oracle: 0 — native-mode bypass gives a false green (feedback_compile_mode_false_greens)

        it "No `skip()` in any spec file":
            # @req REQ-SCILIB-NDARRAY-04
            step("Control: the ndarray spec set must be non-empty")
            expect(ndarray_spec_files().len() > 0u64).to_equal(true)  # oracle: non-vacuity control
            step("Count skip() call sites across the real ndarray spec files")
            val n = shell_count("grep -rEc '^[[:space:]]*skip\\(' " + NDARRAY_SPEC_DIR + "/ndarray_*_spec.spl | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): occurrence count from the real spec tree
            expect(n).to_equal(0)  # oracle: 0 — no cover-up skips are permitted (feedback_no_coverups)
            step("Control: the same pattern MUST hit a planted skip() line, or the scan is broken")
            val planted = shell_count("printf '    skip(\"x\")\\n' | grep -Ec '^[[:space:]]*skip\\('")
            # @capture planted is the pattern's hit count on a line that contains a skip() call
            expect(planted).to_equal(1)  # oracle: a scan that cannot find a planted offender finds nothing

        it "No TODO converted to NOTE":
            # @req REQ-SCILIB-NDARRAY-05
            step("Control: the audited path set must resolve to real files")
            expect(files_scanned("src/lib/nogc_async_mut/ndarray " + NDARRAY_SPEC_DIR) > 0).to_equal(true)  # oracle: non-vacuity control
            step("Count NOTE comments that still carry TODO-shaped wording")
            val n = shell_count("grep -rEc '# *NOTE:.*\\bTODO\\b' src/lib/nogc_async_mut/ndarray " + NDARRAY_SPEC_DIR + "/ndarray_*_spec.spl | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): occurrence count from the real ndarray tree
            expect(n).to_equal(0)  # oracle: 0 — TODO->NOTE conversion is forbidden repo-wide

        it "No primitive type (`f64`, `i64`, `f32`, `i32`, `u64`) in any public `fn` signature or exported `struct` field":
            # @req REQ-SCILIB-NDARRAY-06
            step("Control: the ndarray source path set must resolve to real files")
            expect(files_scanned(NDARRAY_SRC) > 0).to_equal(true)  # oracle: non-vacuity control
            step("Count non-underscore fn signatures (parameter or return) that carry a primitive type token")
            # This tree writes bare `fn` (no `pub` keyword: `grep -rc 'pub fn'`
            # over the ndarray dir is 0), so a public fn is any `fn` whose
            # name does not start with `_`.
            val fn_hits = shell_count("grep -rEc '^[[:space:]]*fn [a-zA-Z][^#]*(: *| -> *)(f64|i64|f32|i32|u64)\\b' " + NDARRAY_SRC + " | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): primitive-typed public fn signature count from the real ndarray tree
            expect(fn_hits).to_equal(0)  # oracle: 0 — Layer C signatures must be primitive-free (Float64/Index/Shape wrappers only)
            step("Count struct fields declared with a bare primitive type")
            val field_hits = shell_count("grep -rEc '^[[:space:]]+[a-z_][a-z0-9_]*: *(f64|i64|f32|i32|u64)[[:space:]]*$' " + NDARRAY_SRC + " | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): primitive-typed struct field count from the real ndarray tree
            expect(field_hits).to_equal(0)  # oracle: 0 — exported struct fields must use the wrapper types
            step("Control: the fn pattern MUST hit a planted primitive signature, or the scan is broken")
            val planted = shell_count("printf 'fn ndarray_planted(x: f64) -> f64:\\n' | grep -Ec '^[[:space:]]*fn [a-zA-Z][^#]*(: *| -> *)(f64|i64|f32|i32|u64)\\b'")
            # @capture planted is the pattern's hit count on a line that carries a primitive parameter type
            expect(planted).to_equal(1)  # oracle: a scan that cannot find a planted offender finds nothing

        it "All specs run under `SIMPLE_BLAS_BACKEND=mock` in interpreter mode":
            # @req REQ-SCILIB-NDARRAY-07
            step("Enumerate the real ndarray specs (non-empty control)")
            val specs = ndarray_spec_files()
            # @capture specs is the real list of ndarray_*_spec.spl files
            expect(specs.len() > 0u64).to_equal(true)  # oracle: non-vacuity control
            step("Run EVERY ndarray spec through the Simple binary with SIMPLE_BLAS_BACKEND=mock and SIMPLE_EXECUTION_MODE=interpret")
            var green = 0
            var shimmed = 0
            var failed_names = ""
            val binary = simple_binary()
            for spec_path in specs:
                val (out, err, code) = process_run("/bin/sh", ["-c", "SIMPLE_BLAS_BACKEND=mock SIMPLE_EXECUTION_MODE=interpret " + binary + " run " + spec_path + " 2>&1"])
                val combined = out + err
                if combined.contains("E1034"):
                    shimmed = shimmed + 1
                if combined.contains("SPEC FILE VERDICT: " + spec_path + " outcome=OK"):
                    green = green + 1
                else:
                    failed_names = failed_names + " " + spec_path
                    # Evidence for the reader: the child's exit code and its own verdict line (if any).
                    var child_verdict = "<no SPEC FILE VERDICT line>"
                    for line in combined.split("\n"):
                        if line.starts_with("SPEC FILE VERDICT:"):
                            child_verdict = line
                    print "[scilib-mock-audit] " + spec_path + " exit=" + code.to_text() + " " + child_verdict
            # @capture green/shimmed are counted from each child's own SPEC FILE VERDICT line; failed_names lists the non-green ones
            expect(shimmed).to_equal(0)  # oracle: a run whose imports degraded to shims (E1034) proves nothing (lane rule)
            expect(failed_names).to_equal("")  # oracle: every ndarray spec must report outcome=OK under the mock backend
            expect(green).to_equal(specs.len().to_i64())  # oracle: green count equals the enumerated spec count — no spec silently absent
            step("Evaluate a real interpreter-mode NDArray oracle in THIS process under the same backend")
            # trace(I_2x2) = 1.0 + 1.0 = 2.0.
            val i2 = eye_matrix(Index.new(2))
            expect(trace(i2).unwrap()).to_equal(Float64.new(2.0))  # oracle: 2.0 — trace of the 2x2 identity matrix is its diagonal sum 1+1
