# @cover src/lib/editor/view/md_editing.spl 15%
# @cover src/lib/editor/extensions/roots.spl 10%
# @manual_section: Editor markdown editing subsystem plan remains
"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/app/editor/editor_markdown_editing_subsystem.md.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/editor_markdown_editing_subsystem_spec.spl
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented.
"""
# @tag:in-development
# doc-path: doc/03_plan/app/editor/editor_markdown_editing_subsystem.md

use std.spec.{step}
use std.spec.*
use std.io_runtime.{env_get, file_exists, file_write, dir_create_all, process_run}
use std.editor.view.md_editing.{
    MdEditorState, MdMotionResult, MdCommandResult,
    md_editor_state_new, md_dispatch_motion, md_commands_dispatch,
    md_table_insert_row_after, md_table_next_cell, md_callout_toggle_fold,
    md_table_delete_row, md_table_auto_format,
    md_callout_insert, md_callout_change_type
}
use std.editor.extensions.roots.{discover_extensions}

fn _simple_binary() -> text:
    val configured = env_get("SIMPLE_BINARY")
    if configured != "": return configured
    "bin/simple"

describe "Editor markdown editing subsystem plan: open remains":

    it "checkbox: `MdEditorState`, `MdMotionResult`, `MdCommandResult` types exist and compile":
        # @req REQ-EDITOR-MD-001
        step("Construct one value of each promised type and read a real field back")
        val state: MdEditorState = md_editor_state_new()
        expect(state.preview_visible).to_equal(false)
        val motion: MdMotionResult = md_dispatch_motion("z", "z", "one\ntwo", 0, 0)
        expect(motion.found).to_equal(false)
        val result: MdCommandResult = md_commands_dispatch("markdown.togglePreview", state, "one\ntwo", 0, 0)
        expect(result.preview_visible).to_equal(true)

    it "checkbox: `md_commands_dispatch` routes at least 10 commands (enter, tab, shift-tab, delete-line, duplicate-line, move-up, move-down, heading-toggle, bold, italic)":
        # @req REQ-EDITOR-MD-002
        step("Dispatch every named command and require each to be recognised, not echoed back unhandled")
        val state = md_editor_state_new()
        val content = "- item one\n- item two"
        val commands: [text] = [
            "enter", "tab", "shift-tab", "delete-line", "duplicate-line",
            "move-up", "move-down", "heading-toggle", "bold", "italic"
        ]
        var recognised = 0
        var i = 0
        while i < commands.len():
            val r = md_commands_dispatch(commands[i], state, content, 0, 0)
            # evidence(pinned oracle): the fallback arm of md_commands_dispatch
            # echoes the command name back verbatim as status_message when it
            # is NOT recognised; a routed command must produce something else.
            if r.status_message != commands[i]:
                recognised = recognised + 1
            i = i + 1
        step("Assert all 10 named commands were recognised")
        expect(recognised).to_equal(10) # oracle: the checkbox names exactly 10 commands to route

    it "checkbox: Vim motions: w, b, e, W, B, E, 0, $, ^, gg, G, {, }, [[, ]] all produce correct `MdMotionResult`":
        # @req REQ-EDITOR-MD-003
        step("Dispatch gg/G on a 3-line document and expect real line targets")
        val content = "# heading\nsecond line\nthird line"
        val gg = md_dispatch_motion("g", "g", content, 2, 0)
        val cap_g = md_dispatch_motion("", "G", content, 0, 0)
        step("Assert gg lands on the first line and G on the last line of the 3-line fixture")
        # evidence(pinned oracle): gg must land on line 0, G on the last line
        # (index 2) of the 3-line fixture -- real, hand-countable targets.
        expect(gg.found).to_equal(true)
        expect(gg.line).to_equal(0) # oracle: gg moves to the first line, index 0, of the 3-line fixture
        expect(cap_g.found).to_equal(true)
        expect(cap_g.line).to_equal(2) # oracle: G moves to the last line, index 2, of the 3-line fixture

    it "checkbox: Table editing: add/delete row/col, tab navigation, auto-format":
        # @req REQ-EDITOR-MD-004
        step("Insert a row (real), then require a delete-row counterpart and an auto-format pass")
        val table = "| A | B |\n| --- | --- |\n| 1 | 2 |"
        val inserted = md_table_insert_row_after(table, 2)
        expect(inserted.changed).to_equal(true)
        expect(inserted.content.split("\n").len()).to_equal(4) # oracle: the 3-line fixture plus one inserted row = 4 lines
        val next_cell = md_table_next_cell(table, 2, 2)
        expect(next_cell.found).to_equal(true)
        step("Delete the row just inserted and require the table returns to its original shape")
        # evidence(pinned oracle): the plan promises delete-row/col and an
        # auto-format re-pad; call the promised names directly so a missing
        # symbol is the forcing function for the interface.
        val deleted = md_table_delete_row(inserted.content, 2)
        expect(deleted.changed).to_equal(true)
        # evidence(pinned oracle): deleting the row just inserted must return
        # the table to its original 3-line shape.
        expect(deleted.content.split("\n").len()).to_equal(3) # oracle: deleting the inserted row returns the fixture to its original 3 lines
        val formatted = md_table_auto_format(inserted.content)
        expect(formatted.split("\n").len()).to_equal(4) # oracle: auto-format re-pads columns but must not add or drop rows from the 4-line table

    it "checkbox: Callout insert/fold/change-type":
        # @req REQ-EDITOR-MD-005
        step("Fold an existing callout (real), then require insert and change-type counterparts")
        val callout = "> [!note]\n> body text"
        val folded = md_callout_toggle_fold(callout, 0)
        expect(folded.changed).to_equal(true)
        expect(folded.content.contains("[!note]-")).to_equal(true)
        step("Insert a new warning callout and change an existing one to tip")
        val inserted = md_callout_insert("warning")
        expect(inserted.insert_text.contains("[!warning]")).to_equal(true)
        val changed = md_callout_change_type(callout, 0, "tip")
        expect(changed.content.contains("[!tip]")).to_equal(true)
        expect(changed.content.contains("[!note]")).to_equal(false)

    it "checkbox: `str.slice` works in interpreter mode":
        # @req REQ-EDITOR-MD-006
        step("Slice a known literal and compare against a hand-computed substring")
        val greeting = "hello world"
        expect(greeting.slice(0, 5)).to_equal("hello") # oracle: characters 0..5 of "hello world" spell "hello"
        expect(greeting.slice(6, 11)).to_equal("world") # oracle: characters 6..11 of "hello world" spell "world"

    it "checkbox: `discover_extensions` returns manifests from a scan directory":
        # @req REQ-EDITOR-MD-007
        step("Write one real manifest into a scratch scan directory, then require it comes back")
        val scan_root = "build/test-artifacts/03_system/plan_acceptance/editor_markdown_editing_subsystem/discover_extensions"
        dir_create_all(scan_root + "/demo")
        file_write(scan_root + "/demo/extension.sdn", "id: demo\nname: Demo Extension\nversion: 1.0.0\n")
        val manifests = discover_extensions(scan_root)
        step("Assert exactly the one written manifest comes back")
        # evidence(pinned oracle): exactly one manifest was written into the
        # scan root, so exactly one must come back -- not a vacuous
        # non-negative-length check.
        expect(manifests.len()).to_equal(1) # oracle: exactly one extension.sdn manifest was written into scan_root above

    it "checkbox: `bin/simple check src/app/editor/` passes with zero HIR type-inference failures":
        # @req REQ-EDITOR-MD-008
        step("Run the real type checker over the editor app tree and count HIR failures in its own output")
        val simple_binary = _simple_binary()
        val (stdout, stderr, code) = process_run(simple_binary, ["check", "src/app/editor/"])
        val combined = stdout + stderr
        # evidence(pinned oracle): counting the literal failure marker in the
        # checker's own transcript, not trusting a bare exit code alone.
        expect(combined.contains("HIR type-inference failure")).to_equal(false)
        expect(code).to_equal(0) # oracle: process_run exit code; 0 == the deployed type checker reported no failures

    it "checkbox: the four Phase 7 spec files the plan promises all EXIST (their passing is asserted by running them, not here)":
        # @req REQ-EDITOR-MD-009
        step("The four Phase 7 spec files the plan promises to create must exist and pass")
        val specs: [text] = [
            "test/01_unit/lib/editor/md_block_model_spec.spl",
            "test/01_unit/lib/editor/md_command_dispatch_spec.spl",
            "test/01_unit/lib/editor/md_vim_motions_spec.spl",
            "test/01_unit/lib/editor/md_table_ops_spec.spl"
        ]
        var existing = 0
        var i = 0
        while i < specs.len():
            if file_exists(specs[i]):
                existing = existing + 1
            i = i + 1
        step("Assert all four Phase 7 spec files exist")
        expect(existing).to_equal(4) # oracle: the plan's Phase 7 lists exactly 4 spec files to create
        # NOTE(2026-09-05): this scenario checks EXISTENCE only. It was previously
        # named "All spec files pass in interpreter mode", which it never asserted —
        # a green here said nothing about whether any of the four passes. Their
        # passing is established by running them directly; see the plan's citation.
