# @cover src/app/office/sheets/formula.spl 10%
# @cover src/app/office/sheets/math_bridge.spl 20%
# @manual_section: Excel-to-math-lib migration plan remains
"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/app/office/excel_to_math_lib_migration.md.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/excel_to_math_lib_migration_spec.spl
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented.
"""
# @tag:in-development
# doc-path: doc/03_plan/app/office/excel_to_math_lib_migration.md

use std.nogc_sync_mut.io.process_ops.{process_run}
use std.spec.{step}
use std.nogc_sync_mut.io.process_ops.{process_run}
use std.spec.*
use std.io_runtime.{env_get, file_exists, file_read, process_run, time_now_unix_micros}
use app.office.sheets.math_bridge.{excel_sin, excel_asin, excel_acos}
use std.common.math.math.{math_sin}

fn _simple_binary() -> text:
    val configured = env_get("SIMPLE_BINARY")
    if configured != "": return configured
    "bin/simple"

describe "Excel-to-math-lib migration plan: open remains":

    it "checkbox: All formula tests pass (100% coverage)":
        # @req REQ-EXCEL-MATH-LIB-001
        step("Run the formula spec family through the deployed binary")
        val simple_binary = _simple_binary()
        val (stdout, stderr, code) = process_run(simple_binary, ["test", "test/01_unit/app/office/sheets/"])
        # evidence(pinned oracle): the plan promises 100% of the formula spec
        # family passes after migration; a real run's exit code is the oracle,
        # never a hardcoded true.
        expect(code).to_equal(0) # oracle: process_run exit code; 0 == the deployed test runner reported no failures

    it "checkbox: No performance regression in benchmark suite":
        # @req REQ-EXCEL-MATH-LIB-002
        step("Compare excel_sin wrapper overhead against the raw stdlib math_sin call it delegates to")
        val iterations = 20000
        val t0 = time_now_unix_micros()
        var i = 0
        var acc_bridge: f64 = 0.0
        while i < iterations:
            acc_bridge = acc_bridge + excel_sin(0.7853981633974483)
            i = i + 1
        val t1 = time_now_unix_micros()
        i = 0
        var acc_direct: f64 = 0.0
        while i < iterations:
            acc_direct = acc_direct + math_sin(0.7853981633974483)
            i = i + 1
        val t2 = time_now_unix_micros()
        val bridge_us = t1 - t0
        val direct_us = t2 - t1
        step("Assert the bridge overhead is bounded relative to the direct stdlib call")
        # evidence(pinned oracle): the bridge is a thin delegate, so it must
        # not cost meaningfully more than the stdlib call underneath it. A
        # real measured ratio, bounded generously (10x) to absorb noise, not
        # a tautological pass.
        expect(acc_bridge > 0.0).to_equal(true) # oracle: sin(pi/4) > 0 summed 20000 times must stay positive
        expect(direct_us > 0).to_equal(true) # oracle: 20000 real sin() calls take measurable wall-clock time; 0 means the clock did not advance and the ratio below is meaningless (AUDIT 2026-09-05: `>= 0` could not fail)
        expect(bridge_us <= (direct_us * 10 + 5000)).to_equal(true) # oracle: 10x the measured direct cost plus 5ms noise floor

    it "checkbox: Excel functions documented as using stdlib math":
        # @req REQ-EXCEL-MATH-LIB-003
        step("The user-facing guide names the stdlib math functions Excel formulas delegate to")
        val guide_path = "doc/07_guide/app/office/excel_formulas.md"
        expect(file_exists(guide_path)).to_equal(true)
        val guide = file_read(guide_path)
        expect(guide.contains("math_sin")).to_equal(true)
        expect(guide.contains("std.common.math")).to_equal(true)

    it "checkbox: Code size reduced by ~500-1000 lines (duplicated implementations)":
        # @req REQ-EXCEL-MATH-LIB-004
        step("The private duplicated float helpers the plan names for deletion must be gone from formula.spl")
        val formula_src = file_read("src/app/office/sheets/formula.spl")
        step("Assert none of the named duplicated helpers remain")
        # evidence(pinned oracle): the plan's Implementation Steps section
        # names these exact private helpers for removal once migration is
        # complete (\"_sin_f64\", \"_cos_f64\", \"_atan_f64\" now use math lib;
        # \"_ln_f64\", \"_exp_f64\", \"_sqrt_f64\" now use special.spl; \"_PI\"
        # constant now uses MATH_PI).
        expect(formula_src.contains("fn _sin_f64")).to_equal(false) # oracle: named for deletion in the plan's Implementation Steps section 4
        expect(formula_src.contains("fn _sqrt_f64")).to_equal(false) # oracle: named for deletion alongside _ln_f64/_exp_f64
        expect(formula_src.contains("val _PI = 3.141592653589793")).to_equal(false) # oracle: plan says "_PI constant (now use MATH_PI)"

    it "checkbox: User-facing guide updated (doc/07_guide/app/office/excel_formulas.md)":
        # @req REQ-EXCEL-MATH-LIB-005
        step("The named guide file exists and documents at least the ASIN/ACOS edge-case wrappers")
        val guide_path = "doc/07_guide/app/office/excel_formulas.md"
        expect(file_exists(guide_path)).to_equal(true)
        val guide = file_read(guide_path)
        step("Call the real ASIN/ACOS edge-case wrappers named in the guide and check known values")
        # evidence(pinned oracle): ASIN/ACOS are the plan's flagship
        # non-trivial wrappers (edge cases at +/-1); real known values
        # (asin(1) = pi/2, acos(1) = 0).
        expect(excel_asin(1.0)).to_equal(1.5707963267948966) # oracle: asin(1) = pi/2 exactly, from math_bridge.spl's own doc comment
        expect(excel_acos(1.0)).to_equal(0.0) # oracle: acos(1) = 0 exactly
        expect(guide.contains("ASIN")).to_equal(true)
