# @cover src/lib/common/math/bigint.spl 30%
# @cover src/os/crypto/rsa_pss.spl 5%
# @cover src/os/crypto/rsa_fallback.spl 5%
# @manual_section: RSA modexp Montgomery/Barrett reducer plan remains
"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/lib/crypto/rsa_modexp_montgomery_barrett.md.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/rsa_modexp_montgomery_barrett_spec.spl
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE (the not-yet-created
`src/lib/common/math/bigint.spl` module) and fail until the plan's remaining
checkboxes are implemented. Every Montgomery/Barrett oracle is checked
against a plain modular-exponentiation computed independently in this spec,
using a small hand-verifiable modulus.
"""
# @tag:in-development
# doc-path: doc/03_plan/lib/crypto/rsa_modexp_montgomery_barrett.md

use std.spec.step
use std.spec.*
use std.io_runtime.{env_get, file_exists, file_read, process_run, time_now_unix_micros}
use std.common.math.bigint.{
    bi_mul, bi_cmp, bi_normalize,
    MontgomeryCtx, bi_montgomery_setup, bi_montgomery_mul,
    bi_to_montgomery, bi_from_montgomery, bi_mod_exp_montgomery
}

fn _simple_binary() -> text:
    val configured = env_get("SIMPLE_BINARY")
    if configured != "": return configured
    "bin/simple"

# Plain schoolbook modexp over ordinary i64 arithmetic -- the independent
# oracle every promised bigint function is checked against. n=13, so every
# intermediate product fits in i64 with no risk of overflow.
fn _plain_mod_exp(base: i64, exp: i64, modulus: i64) -> i64:
    var result: i64 = 1
    var b = base % modulus
    var e = exp
    while e > 0:
        if e % 2 == 1:
            result = (result * b) % modulus
        b = (b * b) % modulus
        e = e / 2
    result

describe "RSA modexp Montgomery/Barrett reducer plan: open remains":

    it "checkbox: `test/01_unit/lib/crypto/rsa_pss_sha256_roundtrip_slow_spec.spl` completes within 60s in interpreter mode (RSA-2048 sign + verify)":
        # @req REQ-RSA-MODEXP-001
        step("Run the real slow roundtrip spec and measure real wall-clock time against the plan's stated 60s budget")
        val spec_path = "test/01_unit/lib/crypto/rsa_pss_sha256_roundtrip_slow_spec.spl"
        expect(file_exists(spec_path)).to_equal(true)
        val simple_binary = _simple_binary()
        val t0 = time_now_unix_micros()
        val (stdout, stderr, code) = process_run(simple_binary, ["test", "--only-slow", spec_path, "--mode=interpreter"])
        val t1 = time_now_unix_micros()
        val elapsed_s = (t1 - t0) / 1000000
        step("Assert the real run finished inside the plan's 60s budget")
        expect(code).to_equal(0) # oracle: process_run exit code; 0 == the roundtrip spec passed
        expect(elapsed_s < 60).to_equal(true) # oracle: the plan's Acceptance Criteria states "completes within 60s in interpreter mode"

    it "checkbox: `test/01_unit/lib/crypto/rsa_pkcs1_v15_spec.spl` passes via PureSimple backend in interpreter mode (not HostedReference)":
        # @req REQ-RSA-MODEXP-002
        step("The spec source must select the PureSimple backend, not HostedReference")
        val spec_src = file_read("test/01_unit/lib/crypto/rsa_pkcs1_v15_spec.spl")
        # evidence(pinned oracle): today the spec explicitly signs with
        # RsaSignBackend.HostedReference because the PureSimple backend needs
        # rt_tls13_sha256 which is unregistered in interpreter mode -- the
        # plan requires this to flip to PureSimple.
        expect(spec_src.contains("RsaSignBackend.PureSimple")).to_equal(true)
        expect(spec_src.contains("RsaSignBackend.HostedReference")).to_equal(false)

    it "checkbox: No new dependency on `rt_embedded_host_rsa_component`":
        # @req REQ-RSA-MODEXP-003
        step("Grep the RSA modules for the discouraged extern component")
        val pss_src = file_read("src/os/crypto/rsa_pss.spl")
        val fallback_src = file_read("src/os/crypto/rsa_fallback.spl")
        expect(pss_src.contains("rt_embedded_host_rsa_component")).to_equal(false)
        expect(fallback_src.contains("rt_embedded_host_rsa_component")).to_equal(false)

    it "checkbox: Shared `src/lib/common/math/bigint.spl` with full test coverage":
        # @req REQ-RSA-MODEXP-004
        step("The shared bigint module and its unit spec must both exist, and its public API must compute a known 30-bit-limb product")
        expect(file_exists("src/lib/common/math/bigint.spl")).to_equal(true)
        expect(file_exists("test/01_unit/lib/math/bigint_spec.spl")).to_equal(true)
        step("Multiply two single-limb bigints and compare against the hand-computed product")
        # 6 * 7 = 42, encoded as single-limb bigints.
        val a = bi_normalize([6])
        val b = bi_normalize([7])
        val product = bi_mul(a, b)
        expect(bi_cmp(product, [42])).to_equal(0) # oracle: 6 * 7 = 42, hand-computed; bi_cmp returns 0 for equal bigints

    it "checkbox: Montgomery multiply round-trips correctly for random inputs":
        # @req REQ-RSA-MODEXP-005
        step("Montgomery-encode 7 and 3 mod 13, multiply in Montgomery form, decode, and compare to plain 7*3 mod 13")
        val modulus = bi_normalize([13])
        val ctx: MontgomeryCtx = bi_montgomery_setup(modulus)
        val a = bi_to_montgomery(bi_normalize([7]), ctx)
        val b = bi_to_montgomery(bi_normalize([3]), ctx)
        val product_mont = bi_montgomery_mul(a, b, ctx)
        val product_plain = bi_from_montgomery(product_mont, ctx)
        # evidence(pinned oracle): 7*3 mod 13 = 21 mod 13 = 8, computed by hand
        # independently of the Montgomery machinery under test.
        expect(bi_cmp(product_plain, [8])).to_equal(0) # oracle: 7*3 mod 13 = 21 mod 13 = 8, hand-computed
        step("Round-trip: decoding an encoded value must return the original value")
        val round_tripped = bi_from_montgomery(bi_to_montgomery(bi_normalize([11]), ctx), ctx)
        expect(bi_cmp(round_tripped, [11])).to_equal(0) # oracle: encode-then-decode must return the original value, 11, unchanged
        step("bi_mod_exp_montgomery must agree with a plain schoolbook modexp for a small known modulus (7^3 mod 13)")
        val expected = _plain_mod_exp(7, 3, 13)
        expect(expected).to_equal(5) # oracle: 7^3 mod 13 = 343 mod 13 = 5, hand-computed (7^2=49 mod13=10, 7^3=70 mod13=5)
        val result = bi_mod_exp_montgomery(bi_normalize([7]), bi_normalize([3]), modulus)
        expect(bi_cmp(result, [expected])).to_equal(0) # oracle: bi_mod_exp_montgomery must match the independently computed _plain_mod_exp oracle above

    it "checkbox: All existing RSA/crypto specs pass without regression":
        # @req REQ-RSA-MODEXP-006
        step("Run the full crypto spec directory and require zero failures")
        val simple_binary = _simple_binary()
        val (stdout, stderr, code) = process_run(simple_binary, ["test", "test/01_unit/lib/crypto/"])
        expect(code).to_equal(0) # oracle: process_run exit code; 0 == the deployed test runner reported no failures
