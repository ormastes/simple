"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/lib/gpu_containers_unified/unified_compute_stdlib_rollout_2026-06-16.md,
for the plan-acceptance lane defined in
doc/03_plan/agent_tasks/plan_remains_acceptance_2026-09-05.md. Audience: the
implementer picking up the SPipe phases 3-arch through 8-ship for this
feature, and the reviewer checking each phase against a real callable
interface before marking it done.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/unified_compute_stdlib_rollout_spec.spl
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented. The pre-work resolver (P1/P2)
and the `transform` cell already exist at
src/lib/nogc_async_mut/compute/exec_target.spl and
src/lib/gc_async_mut/compute/compute_run.spl; the cell-grid algorithms
(reduce/scan/sort/...) beyond `transform` do not exist anywhere in the tree
yet (grep census, 2026-09-05), so those `it`s pin a forcing-function import.
## Lifecycle
Research
doc/01_research/lib/gpu_containers_unified/gpu_containers_algorithms_stdlib_cuda_parity_2026-06-16.md,
plan
doc/03_plan/lib/gpu_containers_unified/unified_compute_stdlib_rollout_2026-06-16.md,
architecture doc/04_architecture/, and design doc/05_design/ records for this
feature are the umbrella lifecycle folders this spec traces to.
"""
# @tag:in-development
# doc-path: doc/03_plan/lib/gpu_containers_unified/unified_compute_stdlib_rollout_2026-06-16.md
# @cover src/lib/nogc_async_mut/compute/exec_target.spl
# @cover src/lib/gc_async_mut/compute/compute_run.spl
# @manual_section "Unified CPU/GPU compute stdlib — SPipe phases 3-arch..8-ship"

use std.spec.{step}
use std.spec.{describe, it, expect}
use std.fs.{read_file}
use std.nogc_async_mut.compute.exec_target.{
    DeviceClass, ComputeBackend, EnforceMode, BackendCaps, ExecTarget, resolve_exec_target
}
use std.gc_async_mut.compute.compute_run.{
    cpu_transform_scale_f32, run_transform_scale_f32, ComputeRunResult
}

extern fn rt_file_exists(path: text) -> bool

describe "Unified CPU/GPU compute stdlib rollout (doc/03_plan/lib/gpu_containers_unified/unified_compute_stdlib_rollout_2026-06-16.md)":

    it "3-arch — resolve Q1/Q3/Q4; module list + interfaces + ≥1 SDN component diagram":
        # @req REQ-UNIFIEDCOMPUTE-3ARCH
        step("Check for a dedicated architecture record for this feature")
        # No architecture doc directory exists for this feature yet (real,
        # checked): the plan's own SDN diagram lives inline in the plan
        # file itself (§0), not in a dedicated doc/04_architecture record.
        val has_arch_dir = rt_file_exists("doc/04_architecture/lib/gpu_containers_unified")
        step("Assert no dedicated architecture record exists yet, matching the unchecked SPipe phase")
        # @capture the filesystem presence check is the retained evidence:
        # there is no computable interface for "has 3-arch landed", only
        # the artifact the phase promises to produce.
        expect(has_arch_dir).to_equal(false)  # oracle: SPipe phase checklist, "3-arch" is unchecked; census 2026-09-05 found no such directory

    it "4-spec — failing SSpec .spl per AC (discriminating GPU-offload + parity oracles)":
        # @req REQ-UNIFIEDCOMPUTE-4SPEC
        step("Check for a dedicated spec directory tracing this feature's AC-1..AC-7 identities")
        # No spec directory names this feature's AC-1..AC-7 traceability yet.
        val has_spec_dir = rt_file_exists("test/01_unit/lib/gpu_containers_unified")
        step("Assert no dedicated AC-traced spec directory exists yet, matching the unchecked SPipe phase")
        expect(has_spec_dir).to_equal(false)  # oracle: SPipe phase checklist, "4-spec" is unchecked; census 2026-09-05 found no such directory

    it "5-implement — pre-work P1–P5, then cell-grid waves W1→W4":
        # @req REQ-UNIFIEDCOMPUTE-5IMPLEMENT
        step("Resolve a CPU ExecTarget and run the transform cell through the real policy-switch pipeline")
        # Real, callable proof of the ONLY milestone that is genuinely
        # landed (M0): P1's single ExecTarget resolver + P2's for_each-shaped
        # transform cell running CPU-by-policy with an honest computed
        # oracle (bit-exact against the pure-Simple reference).
        val cpu_target = resolve_exec_target(DeviceClass.Cpu, ComputeBackend.NoneBackend, EnforceMode.Suggest, BackendCaps.none())
        val data: [f32] = [1.0, 2.0, 3.0, 4.0]
        val expected = cpu_transform_scale_f32(data, 2.0)
        val result: ComputeRunResult = run_transform_scale_f32(data, 2.0, cpu_target)
        step("Assert the runtime result is bit-exact against the pure-Simple CPU reference")
        # @capture result.data compared element-wise against the
        # independently-computed CPU reference is the retained evidence for
        # M0's "switchability proven" milestone.
        expect(result.ran_on_cpu).to_equal(true)  # oracle: M0 exit criterion, CPU device class always executes on CPU
        expect(result.data.len()).to_equal(4)  # oracle: input data has 4 elements
        expect(result.data[2]).to_equal(expected[2])  # oracle: bit-exact against cpu_transform_scale_f32, the plan's own differential oracle
        step("Request the promised reduce cell beyond `transform`, which the cell grid still owes")
        # The cell grid beyond `transform` (reduce/scan/sort/copy_if/unique/
        # find/reduce_by_key, §2's 9x4 grid) has no unified entry point at
        # all yet -- pin the promised `reduce` cell directly.
        use std.gc_async_mut.compute.compute_run.{run_reduce_i64}
        val reduced = run_reduce_i64([1, 2, 3, 4], 0, cpu_target)
        step("Assert the reduce cell computes the correct sum once it exists")
        expect(reduced.data[0]).to_equal(10)  # oracle: sum(1,2,3,4) = 10, independently computable

    it "6-refactor — dedup, ≤800-line files, naming, doc/wiki pass":
        # @req REQ-UNIFIEDCOMPUTE-6REFACTOR
        step("Read the two landed pre-work modules and count their lines")
        # Real, checked: the two landed modules already sit well under the
        # 800-line budget (274 and 101 lines respectively), so the size
        # constraint itself has not been violated by the pre-work landed so
        # far -- but no dedicated feature-expert wiki page exists yet for
        # this plan's own naming/honesty pass (checked separately below).
        val resolver_module = read_file("src/lib/nogc_async_mut/compute/exec_target.spl")
        var resolver_lines: i64 = 1
        var i: i64 = 0
        while i < resolver_module.len():
            if resolver_module.char_at(i) == "\n":
                resolver_lines = resolver_lines + 1
            i = i + 1
        val has_wiki_page = rt_file_exists("doc/00_llm_process/feature_expert/gpu_containers_unified")
        step("Assert the landed module stays within the plan's line budget, and the wiki pass is still open")
        # @capture resolver_lines (a real computed line count) and the
        # wiki-page filesystem check together are the retained evidence.
        expect(resolver_lines <= 800).to_equal(true)  # oracle: plan §2 refactor rule, "≤800-line files"
        expect(has_wiki_page).to_equal(false)  # oracle: SPipe phase checklist, "6-refactor" (doc/wiki pass) is unchecked

    it "7-verify — differential vs CUDA oracle, full suite, docgen scenario manuals":
        # @req REQ-UNIFIEDCOMPUTE-7VERIFY
        step("Run the transform cell requesting CUDA on a host with no CUDA capability")
        # The landed transform cell's own fallback path is honest (no false
        # "gpu-ran" claim) -- real computed check on a requested-but-absent
        # CUDA backend.
        var caps = BackendCaps.none()
        val cuda_target = resolve_exec_target(DeviceClass.Gpu, ComputeBackend.Cuda, EnforceMode.Suggest, caps)
        val data: [f32] = [1.0, 2.0, 3.0]
        val result: ComputeRunResult = run_transform_scale_f32(data, 3.0, cuda_target)
        step("Assert the cell honestly reports the CPU-reference path, never a false GPU claim")
        # @capture result.ran_on_cpu/result.note are the retained evidence
        # for NFR-3's naming-honesty rule.
        expect(result.ran_on_cpu).to_equal(true)  # oracle: NFR-3 honesty rule, no GPU capability present
        expect(result.note).to_equal("cpu-reference")  # oracle: compute_run.spl's own documented note for the no-GPU path
        step("Request the promised differential comparator against the CUDA oracle for the reduce cell")
        # No CUDA-oracle differential comparator exists yet for the cell
        # grid beyond transform -- pin it directly.
        use std.gc_async_mut.compute.differential_oracle.{differential_compare_against_cuda}
        val verdict = differential_compare_against_cuda("reduce", [1, 2, 3, 4])
        step("Assert the differential comparator reports bit-exact parity once it exists")
        expect(verdict.bit_exact).to_equal(true)  # oracle: plan §4 verification gate, NFR-1 "bit-exact int/sort"

    it "8-ship — jj commit per cell (≤5 files), tracking docs":
        # @req REQ-UNIFIEDCOMPUTE-8SHIP
        step("Read the real SPipe tracking state file for this feature")
        # SPipe tracking state exists (real, checked) but names no landed
        # cell commits yet -- this is a process gate this lane cannot
        # satisfy with a computed pixel/value oracle.
        val tracking_state = read_file(".spipe/gpu_containers_unified/state.md")
        step("Assert the tracking state has not yet recorded any AC-1..AC-7 cell commit")
        # @capture the tracking file's own content is the retained evidence
        # -- there is no runtime function to call for "has a cell shipped".
        expect(tracking_state.contains("AC-1")).to_equal(false)  # oracle: SPipe phase checklist, "8-ship" is unchecked; state.md has no AC-tagged commit entries yet
