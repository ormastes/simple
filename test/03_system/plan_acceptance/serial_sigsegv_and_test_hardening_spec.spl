# @tag:in-development
# doc-path: doc/03_plan/infra/audit/serial_sigsegv_and_test_hardening.md
# @req REQ-SIGSEGV-HARDENING-001
# @manual_section: Signal Safety and Serial-FFI Hardening Remains
# @cover src/runtime/runtime.c 0%
# @cover src/runtime/runtime_legacy_core.c 0%
# @cover src/lib/nogc_sync_mut/io/signal_handlers.spl 0%
# @cover src/app/io/serial_ffi.spl 0%

use std.spec.step
use std.spec.{describe, context, it, expect}
use std.io_runtime.{read_file}

describe "Phase 2: Runtime SIGSEGV Handler":

    it "A null-pointer deref in compiled mode recovers into a backtrace, not a bare process crash":
        step("Locate the closest existing crash-related spec")
        # @req REQ-SIGSEGV-HARDENING-001
        # rt_install_crash_handler (src/runtime/runtime.c) is already wired
        # at process start and its backtrace path is real, but nothing
        # drives a genuine fault through it end to end: the closest spec,
        # crash_bundle_spec.spl, only feeds CrashBundleV1.capture() a
        # caller-supplied fault_kind string -- it never forks a child,
        # crashes it, and inspects rt_fork_parent_stderr() /
        # rt_fork_parent_signaled() the way
        # src/lib/nogc_sync_mut/test_runner/test_runner_fork.spl's
        # classify_fork_exit() already does for a real crashed child.
        # @capture: rt_fork_parent_stderr()'s captured backtrace text and
        # rt_fork_parent_signaled()'s exit-classification are the retained
        # evidence a future implementation of this scenario must produce.
        val crash_spec_source = read_file("test/01_unit/lib/crash/crash_bundle_spec.spl")
        step("Assert the spec drives a real forked crash, not a synthetic fault_kind string")
        val drives_a_real_forked_crash = crash_spec_source.contains("rt_fork_parent_wait")
        # oracle: expected_present names the promised behavior (a real fork
        # + crash + backtrace-capture test exists); provenance: no file in
        # the tree combines rt_install_crash_handler's contract with
        # rt_fork_parent_wait/rt_fork_parent_stderr today.
        val expected_present = true
        expect(drives_a_real_forked_crash).to_equal(expected_present)

describe "Phase 3: Fork Child Signal Isolation":

    it "Audit all fork() callsites in runtime.c for WIFSIGNALED handling":
        step("Read runtime.c and locate every fork() reaper")
        # @req REQ-SIGSEGV-HARDENING-001
        # src/runtime/runtime.c:1669 forks a page-prefetch child
        # (spl_prefetch_start); its reaper spl_prefetch_wait() (:1698) calls
        # waitpid() but discards `status` outright -- it is the one fork()
        # callsite in this file the audit has not reached. Every other
        # runtime .c file with a fork() site (runtime_fork.c,
        # runtime_process.c, runtime_process_owned.c,
        # counterpart_worker_runtime.c, runtime_legacy_core.c) already
        # threads WIFSIGNALED through its wait path.
        # @capture: the grep hit line for WIFSIGNALED (or its absence) in
        # runtime.c is the retained audit evidence for this scenario.
        val runtime_c_source = read_file("src/runtime/runtime.c")
        step("Assert runtime.c's own fork() reaper inspects WIFSIGNALED")
        val prefetch_wait_checks_signal = runtime_c_source.contains("WIFSIGNALED")
        # oracle: expected_audited names the promised end state of the
        # audit (every fork() callsite in this file inspects WIFSIGNALED);
        # provenance: `grep -n WIFSIGNALED src/runtime/runtime.c` is empty.
        val expected_audited = true
        expect(prefetch_wait_checks_signal).to_equal(expected_audited)

describe "Phase 4: Serial FFI Null-Guard":

    it "serial_close rejects a repeat close instead of double-freeing the fd":
        step("Read the deployed serial FFI wrapper, src/app/io/serial_ffi.spl")
        # @req REQ-SIGSEGV-HARDENING-001
        # SerialPort is an immutable struct: serial_close(port) checks
        # `port.is_valid` (set once, at open time) and, if true, always
        # re-issues rt_serial_close(port.fd) -- there is no "closed" state
        # tracked anywhere on SerialPort, so a second serial_close(port) on
        # the SAME value calls rt_serial_close on an already-closed fd
        # instead of rejecting the repeat call as a safe no-op.
        # @capture: the presence/absence of a `closed: bool` field in the
        # SerialPort struct definition is the retained structural evidence.
        val serial_wrapper_source = read_file("src/app/io/serial_ffi.spl")
        step("Assert SerialPort tracks a closed flag so a repeat close is rejected")
        val tracks_closed_state = serial_wrapper_source.contains("closed: bool")
        # oracle: expected_tracked names the promised idempotency mechanism
        # (a tracked closed flag consulted before re-issuing rt_serial_close);
        # provenance: `grep -n "closed" src/app/io/serial_ffi.spl` finds
        # nothing.
        val expected_tracked = true
        expect(tracks_closed_state).to_equal(expected_tracked)

    it "Re-enable the BLOCKED serial_mcp_spec examples once the null-guard lands":
        step("Count BLOCKED examples remaining in serial_mcp_spec.spl")
        # @req REQ-SIGSEGV-HARDENING-001
        # @capture: the split()-part count over the `it "BLOCKED:` needle is
        # the retained count of still-gated hardware examples.
        val serial_mcp_spec_source = read_file(
            "test/01_unit/app/serial_mcp/serial_mcp_spec.spl")
        step("Assert none of the AC-1..AC-4 examples are still marked BLOCKED")
        # oracle: expected_split_parts_when_none_blocked is the split()
        # part-count once the 4 `it "BLOCKED: ..."` examples are re-enabled
        # (0 occurrences of the needle splits into exactly 1 part);
        # provenance: 4 such examples are present today (AC-1..AC-4), so the
        # real split count is 5.
        val expected_split_parts_when_none_blocked = 1
        val blocked_split_part_count = serial_mcp_spec_source.split("it \"BLOCKED:").len()
        expect(blocked_split_part_count).to_equal(expected_split_parts_when_none_blocked)

describe "Phase 5: Simple-Level Signal Wiring":

    it "Wire SIGSEGV into the Simple signal layer (signal_handlers.spl)":
        step("Read the Simple-level signal module")
        # @req REQ-SIGSEGV-HARDENING-001
        # src/lib/nogc_sync_mut/io/signal_handlers.spl (255 lines) handles
        # only SIGHUP/SIGINT/SIGTERM/SIGUSR2 via install_signal_handlers
        # (:69); it never mentions SIGSEGV. The C runtime's crash handler
        # (rt_install_crash_handler, src/runtime/runtime.c) is real but is
        # not reachable from Simple code -- no `std.os.signal` module exists
        # either (confirmed: no file under src/lib matches that path).
        # @capture: the grep hit line for SIGSEGV (or its absence) in
        # signal_handlers.spl is the retained wiring evidence.
        val signal_handlers_source = read_file(
            "src/lib/nogc_sync_mut/io/signal_handlers.spl")
        step("Assert the module wires SIGSEGV, not just the terminal signals")
        val wires_sigsegv = signal_handlers_source.contains("SIGSEGV")
        # oracle: expected_wired names the promised end state; provenance:
        # `grep -n SIGSEGV src/lib/nogc_sync_mut/io/signal_handlers.spl` is
        # empty.
        val expected_wired = true
        expect(wires_sigsegv).to_equal(expected_wired)

    it "Distinguish a genuine segfault from a memory-limit violation via si_code":
        step("Read the crash handler in runtime.c")
        # @req REQ-SIGSEGV-HARDENING-001
        # _spl_crash_handler (src/runtime/runtime.c, installed by
        # rt_install_crash_handler) reads only siginfo_t.si_addr for its
        # crash report; it never reads si_code, so it cannot tell a genuine
        # wild-pointer SEGV (SEGV_MAPERR/SEGV_ACCERR) apart from a
        # resource-limit-triggered fault such as SIGSEGV from a stack-guard
        # page hit.
        # @capture: the grep hit line for si_code (or its absence) in
        # runtime.c's crash handler is the retained classification evidence.
        val runtime_c_source = read_file("src/runtime/runtime.c")
        step("Assert the handler inspects si_code to classify the fault")
        val inspects_si_code = runtime_c_source.contains("si_code")
        # oracle: expected_inspected names the promised classification
        # input; provenance: `grep -n si_code src/runtime/runtime.c` is
        # empty.
        val expected_inspected = true
        expect(inspects_si_code).to_equal(expected_inspected)

    it "Add on_segfault(fn) callback registration for user code":
        step("Read the Simple-level signal module for a segfault callback API")
        # @req REQ-SIGSEGV-HARDENING-001
        # @capture: the grep hit line for on_segfault (or its absence) in
        # signal_handlers.spl is the retained callback-API evidence.
        val signal_handlers_source = read_file(
            "src/lib/nogc_sync_mut/io/signal_handlers.spl")
        step("Assert an on_segfault registration function is exposed")
        val has_on_segfault_registration = signal_handlers_source.contains("on_segfault")
        # oracle: expected_present names the promised free function
        # (`on_segfault(fn)`, mirroring install_sigusr2_handler's existing
        # user-callback pattern at :99-122); provenance: `grep -n
        # on_segfault src/lib/nogc_sync_mut/io/signal_handlers.spl` is
        # empty.
        val expected_present = true
        expect(has_on_segfault_registration).to_equal(expected_present)
