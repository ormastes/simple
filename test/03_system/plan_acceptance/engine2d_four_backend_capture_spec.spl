"""
## Purpose and audience
Acceptance oracle for the single open remain of
doc/03_plan/agent_tasks/engine2d_four_backend_capture.md § Execution status,
for the plan-acceptance lane defined in
doc/03_plan/agent_tasks/plan_remains_acceptance_2026-09-05.md. Audience: the
merge owner who eventually runs the deferred focused contract verification
this plan's own status list defers.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/engine2d_four_backend_capture_spec.spl
## Compatibility and limitations
Tagged in-development: this pins the promised INTERFACE and fails until the
plan's remaining checkbox is implemented. The plan's own text for this
checkbox ("Focused contract verification is blocked by the full data volume
and unrelated active compiler/parser changes; do not push as verified.") and
its linked detail design (doc/05_design/engine2d_four_backend_capture.md,
doc/04_architecture/engine2d_four_backend_capture.md) name no concrete
public function for a "focused contract verification" -- it is a status/
process statement, not an interface promise. This `it` therefore anchors to
the one real, callable admissibility gate the plan's merge lane actually
depends on (graphical_capture_metadata_valid, used by the cross-backend
comparison this plan's own Execution status already marks [x]) at a small,
bounded ("focused") scope, and is flagged in the task report as the weakest
anchor of the six plans in this lane.
## Lifecycle
Research doc/01_research/, plan
doc/03_plan/agent_tasks/engine2d_four_backend_capture.md, architecture
doc/04_architecture/engine2d_four_backend_capture.md, and design
doc/05_design/engine2d_four_backend_capture.md records for this capture
effort are the umbrella lifecycle folders this spec traces to.
"""
# @tag:in-development
# doc-path: doc/03_plan/agent_tasks/engine2d_four_backend_capture.md
# @cover src/app/wm_compare/graphical_backend_equality.spl
# @manual_section "Engine2D four-backend capture — focused contract verification"

use std.spec.{describe, it, expect}
use app.wm_compare.graphical_backend_equality.{
    graphical_capture, graphical_capture_metadata_valid, surface_geometry
}

describe "Engine2D four-backend capture plan (doc/03_plan/agent_tasks/engine2d_four_backend_capture.md)":

    it "Focused contract verification is blocked by the full data volume and unrelated active compiler/parser changes; do not push as verified.":
        # @req REQ-ENGINE2D-4BACKEND-FOCUSEDVERIFY
        step("Build a small, bounded 2x2 capture with a pixel count that matches its declared geometry")
        # A "focused" verification is exactly the OPPOSITE of "full data
        # volume": a small, bounded scope. Real, computed pixel property
        # (pixel count vs width*height), never a hardcoded backend name.
        val geometry = surface_geometry(2, 2, 2, 2, 1.0, "srgb")
        val consistent_pixels: [u32] = [0xff000000, 0xffffffff, 0xff0000ff, 0xff00ff00]
        val admissible = graphical_capture("vulkan:primary", "device_readback", consistent_pixels, geometry, true, "")
        step("Assert the small, bounded capture passes the real admissibility gate")
        # @capture graphical_capture_metadata_valid(admissible) is the
        # retained evidence: a real computed boolean over real pixel/
        # geometry fields, proving a focused (small-scope) verification CAN
        # run cleanly when it is not drowned by the full data volume.
        expect(graphical_capture_metadata_valid(admissible)).to_equal(true)  # oracle: graphical_backend_equality.spl's own pixel-count == width*height rule

        step("Build the same small capture with a pixel count that does NOT match its declared geometry")
        val inconsistent_pixels: [u32] = [0xff000000, 0xffffffff, 0xff0000ff]
        val inadmissible = graphical_capture("vulkan:primary", "device_readback", inconsistent_pixels, geometry, true, "")
        step("Assert the admissibility gate rejects the mismatched capture, matching the plan's do-not-push-as-verified rule")
        expect(graphical_capture_metadata_valid(inadmissible)).to_equal(false)  # oracle: same rule, 3 pixels != 2*2 declared geometry -- unverified data must not be admitted
