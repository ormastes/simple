"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/lib/scilib/ports/scilib_port_math_block.md. Audience: the
scilib-port implementer closing the math_block v1 gate (parser AST
introspection, axis-reduction, and LaTeX rendering) and any reviewer
verifying the gate before shipping v1.1.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/scilib_port_math_block_spec.spl
## Verification and troubleshooting guidance
A failing scenario names the exact acceptance-criterion line it pins. For
the `m{}` behavioral checks, recompute the hand-worked matrix arithmetic in
the surrounding comment; for the grammar/rendering checks, grep the named
Rust compiler file by hand to see what dispatch arms actually exist.
## Compatibility and limitations
Tagged in-development again (2026-09-08): three absence checks were exposed as
false greens and replaced by behavioral transpose/axis-reduction assertions
plus compiled renderer regression tests. The previous primitive-leak red was
closed by giving `op_scalar_mul` the
`MbScalar` wrapper instead of a bare `f64`
(`src/lib/common/science_math/math_block{,_ops}.spl`). `m{}` block evaluation for
matmul/slice/inv/solve already works (verified against
`test/03_system/feature/scilib/math_block_matmul_spec.spl`); the parser-AST
introspection (`parse(text) -> MathExpr`) and rendering functions live in the
Rust compiler. A rebuilt self-hosted binary is required before the new `m{}`
behavioral examples can close their plan rows.
"""
# doc-path: doc/03_plan/lib/scilib/ports/scilib_port_math_block.md
# @tag:in-development
# @cover src/lib/common/science_math/math_block.spl
# @cover src/compiler_rust/compiler/src/blocks/math/

use std.spec.{step}
use std.spec.{describe, context, it, expect}
use std.io_runtime.{process_run}

fn shell_count(cmd: text) -> i64:
    val (out, _err, _code) = process_run("/bin/sh", ["-c", cmd])
    out.trim().to_i64() ?? -1

fn shell_text(cmd: text) -> text:
    val (out, _err, _code) = process_run("/bin/sh", ["-c", cmd])
    out.trim()

describe "plan: lib/scilib/ports/scilib_port_math_block remains":

    # @manual_section v1 acceptance criteria
    context "v1 acceptance criteria":

        it "The shipped matmul and solve specs exist with zero `skip()` and zero TODO→NOTE residue.":
            # @req REQ-SCILIB-MATHBLOCK-01
            step("Check both corrected spec paths and their no-bypass source contract")
            val exists = shell_count("find test/03_system/feature/scilib -maxdepth 1 \\( -name 'math_block_matmul_spec.spl' -o -name 'math_block_solve_spec.spl' \\) | wc -l")
            expect(exists).to_equal(2)
            val skips = shell_count("grep -Ec '^[[:space:]]*skip\\(' test/03_system/feature/scilib/math_block_matmul_spec.spl test/03_system/feature/scilib/math_block_solve_spec.spl | awk -F: '{s+=$2} END{print s+0}'")
            expect(skips).to_equal(0)
            val converted = shell_count("grep -Ec '# *NOTE:.*\\bTODO\\b' test/03_system/feature/scilib/math_block_matmul_spec.spl test/03_system/feature/scilib/math_block_solve_spec.spl 2>/dev/null | awk -F: '{s+=$2} END{print s+0}'")
            expect(converted).to_equal(0)

        it "`parse(\"A @ B + c\")` produces `Add(MatMul(Var(\"A\"), Var(\"B\")), Var(\"c\"))` — `@` binds tighter than `+`.":
            # @req REQ-SCILIB-MATHBLOCK-02
            step("Evaluate a real m{} block whose result only type-checks if @ binds tighter than +, and check every cell against the hand-worked product")
            # Behavioral proxy for the AST shape: with rectangular A (2x3)
            # and B (3x2), (A@B)+c only type-checks if `@` binds tighter
            # than `+` (A@(B+c) would be a shape mismatch, B is 3x2 and c
            # a 2x2 scalar-broadcast). Hand-computed: A=[[1,2,3],[4,5,6]],
            # B=[[1,0],[0,1],[0,0]] (A@B = A's first two cols = [[1,2],[4,5]]),
            # c=[[1,1],[1,1]] -> (A@B)+c = [[2,3],[5,6]].
            # evidence(computed): direct output of the real m{} evaluator, compared cell-by-cell against the hand-worked product
            val result = m{ [[1,2,3],[4,5,6]] @ [[1,0],[0,1],[0,0]] + [[1,1],[1,1]] }
            expect(result[0][0]).to_equal(2.0)  # oracle: 2.0 — (A@B)[0][0]=1 + c[0][0]=1 = 2
            expect(result[0][1]).to_equal(3.0)  # oracle: 3.0 — (A@B)[0][1]=2 + c[0][1]=1 = 3
            expect(result[1][0]).to_equal(5.0)  # oracle: 5.0 — (A@B)[1][0]=4 + c[1][0]=1 = 5
            expect(result[1][1]).to_equal(6.0)  # oracle: 6.0 — (A@B)[1][1]=5 + c[1][1]=1 = 6

        it "`parse(\"A[1:3, 0]\")` produces `Slice { ranges: [SliceRange{1,3}, SliceRange{0,1}] }` (unit test).":
            # @req REQ-SCILIB-MATHBLOCK-03
            step("Evaluate a real m{} row-range + bare-column slice and check length and values against the hand-worked selection")
            # Behavioral proxy: row-range 1:3 with a bare column index 0
            # collapses to a 1D vector of the selected column's rows 1,2.
            # A = [[1,2],[3,4],[5,6],[7,8]] -> A[1:3, 0] = [3, 5]
            # evidence(computed): direct output of the real m{} evaluator, compared against the hand-worked selection
            val result = m{ [[1,2],[3,4],[5,6],[7,8]][1:3, 0] }
            expect(result.length()).to_equal(2)  # oracle: 2 — rows 1..3 (exclusive) selects exactly 2 rows
            expect(result[0]).to_equal(3.0)  # oracle: 3.0 — column 0 of row 1 is 3
            expect(result[1]).to_equal(5.0)  # oracle: 5.0 — column 0 of row 2 is 5

        it "`parse(\"A.T\")` produces `App(\"transpose\", [Var(\"A\")])` (unit test).":
            # @req REQ-SCILIB-MATHBLOCK-04
            step("Evaluate the real .T postfix and check every transposed cell")
            val result = m{ [[1,2,3],[4,5,6]].T }
            expect(result[0][0]).to_equal(1.0)
            expect(result[0][1]).to_equal(4.0)
            expect(result[2][0]).to_equal(3.0)
            expect(result[2][1]).to_equal(6.0)

        it "`inv` and `solve` eval arms green against mock shim deterministic output.":
            # @req REQ-SCILIB-MATHBLOCK-05
            step("Evaluate the real inv() and solve() m{} dispatch arms against the mock identity contract")
            # Real, already-working dispatch arms (mock: inv(I)=I, solve(I,b)=b).
            # evidence(computed): direct output of the real m{} inv()/solve() dispatch arms
            val inv_result = m{ inv([[1,0],[0,1]]) }
            expect(inv_result[0][0]).to_equal(1.0)  # oracle: 1.0 — inv(I)[0][0] = I[0][0] = 1
            expect(inv_result[0][1]).to_equal(0.0)  # oracle: 0.0 — inv(I)[0][1] = I[0][1] = 0
            val solve_result = m{ solve([[1,0],[0,1]], [3,7]) }
            expect(solve_result[0]).to_equal(3.0)  # oracle: 3.0 — solve(I,b) = b, so element 0 is 3
            expect(solve_result[1]).to_equal(7.0)  # oracle: 7.0 — solve(I,b) = b, so element 1 is 7

        it "`A.sum(0)` and `A.mean(1)` reduce along the specified axis; existing full-reduce unaffected.":
            # @req REQ-SCILIB-MATHBLOCK-06
            step("Evaluate axis reductions and the existing full reduction")
            val sums = m{ [[1,2],[3,4]].sum(0) }
            expect(sums[0]).to_equal(4.0)
            expect(sums[1]).to_equal(6.0)
            val means = m{ [[1,2],[3,4]].mean(1) }
            expect(means[0]).to_equal(1.5)
            expect(means[1]).to_equal(3.5)
            expect(m{ [[1,2],[3,4]].sum() }).to_equal(10.0)

        it "Rendering: `MatMul` → `@` in text, `\\cdot` in LaTeX; `Slice` → `A[i:j,k]`; axis-reduction → correct text/LaTeX.":
            # @req REQ-SCILIB-MATHBLOCK-07
            step("Require the compiled renderer regression tests that pin text and LaTeX output")
            val latex_test = shell_count("grep -c 'fn test_latex_matmul_and_slice_contract' src/compiler_rust/compiler/src/blocks/math/ast.rs")
            val text_test = shell_count("grep -c 'fn test_text_matmul_and_slice_contract' src/compiler_rust/compiler/src/blocks/math/rendering/unicode_text.rs")
            expect(latex_test).to_equal(1)
            expect(text_test).to_equal(1)

        it "PERF-SUGAR-002 promoted from `anticipated` to `observed` in `scilib_perf_sugar.md`; workaround guidance recorded.":
            # @req REQ-SCILIB-MATHBLOCK-08
            step("Read the PERF-SUGAR-002 entry's own Status field from the real tracking doc")
            val status = shell_text("grep -A6 '^### PERF-SUGAR-002' doc/08_tracking/feature/scilib_perf_sugar.md | grep -m1 -oE '\\*\\*Status:\\*\\* *[a-z]+' | sed 's/.*: *//'")
            # evidence(computed): status text extracted from the real tracking doc
            expect(status == "anticipated").to_equal(false)

        it "Zero df ops (`df['col']`, `groupby`) introduced into `math{}` at any point.":
            # @req REQ-SCILIB-MATHBLOCK-09
            step("Count DataFrame-shaped operators leaking into the real math-block compiler source")
            val n = shell_count("grep -rEc \"df\\['|groupby\" src/compiler_rust/compiler/src/blocks/math 2>/dev/null | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): occurrence count from the real math-block source
            expect(n).to_equal(0)  # oracle: 0 — df ops are architect anti-pattern #2 for math{}

        it "Zero primitive type leaks at any public-facing surface touched by this area.":
            # @req REQ-SCILIB-MATHBLOCK-10
            step("Count public fn declarations in the real math_block Simple modules whose signature carries a primitive type token")
            val n = shell_count("grep -rEc 'pub fn [^\\n]*: *(f64|i64|f32|i32)\\b' src/lib/common/science_math/math_block.spl src/lib/common/science_math/math_block_ops.spl 2>/dev/null | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): occurrence count from the real math_block modules
            expect(n).to_equal(0)  # oracle: 0 — public-facing math_block surfaces must stay primitive-free

        it "No `--mode=native` or `--mode=smf` bypass in any spec.":
            # @req REQ-SCILIB-MATHBLOCK-11
            step("Count --mode=native/--mode=smf bypass mentions inside the real math_block matmul spec's own run instructions")
            val n = shell_count("grep -rEc -- '--mode=(native|smf)' test/03_system/feature/scilib/math_block_matmul_spec.spl 2>/dev/null | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): occurrence count from the real spec file
            expect(n).to_equal(0)  # oracle: 0 — native/smf-mode bypass gives a false green (feedback_compile_mode_false_greens)
