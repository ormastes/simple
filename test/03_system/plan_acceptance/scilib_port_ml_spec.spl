"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/lib/scilib/ports/scilib_port_ml.md (T-ML-18 AC-7 compliance
sweep). Audience: the scilib-port implementer picking up T-ML-18 and any
reviewer verifying the sweep before the v1.1 gate closes.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/scilib_port_ml_spec.spl
## Verification and troubleshooting guidance
A failing scenario names the exact audit it violates (skip() count, TODO
residue, primitive leak, re-export gap, cuML reference, or an
unpromoted PERF-SUGAR entry). Re-run the quoted grep/shell command by hand
against the real tree to see the offending lines before editing source.
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented. The plan's stated physical
location `src/lib/gc_async_mut/ml/` does not exist on disk; the real ml
source lives at `src/lib/nogc_async_mut/ml/` (verified 2026-09-05), so the
audits below scan the real path and the real spec locations
(`test/03_system/feature/scilib/ml_*_spec.spl`, `test/feature/ml`).
"""
# @tag:in-development
# doc-path: doc/03_plan/lib/scilib/ports/scilib_port_ml.md
# @cover src/lib/nogc_async_mut/ml/
# @cover doc/08_tracking/feature/scilib_perf_sugar.md

use std.spec.{step}
use std.spec.{describe, context, it, expect}
use std.io_runtime.{process_run}

fn shell_count(cmd: text) -> i64:
    val (out, _err, _code) = process_run("/bin/sh", ["-c", cmd])
    out.trim().to_i64() ?? -1

fn shell_text(cmd: text) -> text:
    val (out, _err, _code) = process_run("/bin/sh", ["-c", cmd])
    out.trim()

describe "plan: lib/scilib/ports/scilib_port_ml remains (T-ML-18 AC-7 sweep)":

    # @manual_section T-ML-18 AC-7 compliance sweep
    context "T-ML-18: AC-7 compliance sweep":

        it "Zero `skip()` calls in any ml spec":
            # @req REQ-SCILIB-ML-01
            step("Count skip() call sites across the real ml spec locations")
            val n = shell_count("grep -rc 'skip(' test/03_system/feature/scilib/ml_*_spec.spl test/feature/ml 2>/dev/null | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): occurrence count from the real spec tree
            expect(n).to_equal(0)  # oracle: 0 — the plan requires zero skip() sites; any positive count is a real violation

        it "Zero TODO→NOTE conversions anywhere in ml source or specs":
            # @req REQ-SCILIB-ML-02
            step("Count NOTE comments that still carry TODO-shaped wording, the residue a lazy TODO->NOTE rewrite leaves behind")
            val n = shell_count("grep -rEc '# *NOTE:.*\\bTODO\\b' src/lib/nogc_async_mut/ml test/03_system/feature/scilib/ml_*_spec.spl test/feature/ml 2>/dev/null | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): occurrence count from the real ml tree
            expect(n).to_equal(0)  # oracle: 0 — no converted-TODO residue is permitted

        it "Zero primitive types (`f64`, `i64`, `bool`, `str`) in any public function signature or exported struct field":
            # @req REQ-SCILIB-ML-03
            step("Count public fn/struct declarations in ml/ whose signature carries a primitive type token")
            val n = shell_count("grep -rEc 'pub (fn|struct)[^\\n]*: *(f64|i64|bool|str)\\b' src/lib/nogc_async_mut/ml 2>/dev/null | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): occurrence count from the real ml tree
            expect(n).to_equal(0)  # oracle: 0 — Layer C signatures must be primitive-free

        it "`nn/loss` and `nn/norm` are re-exported (grep for `pub use common.pure.nn`); no duplicate definition":
            # @req REQ-SCILIB-ML-04
            step("Count the re-export line and count any local re-definition of loss/norm")
            val reexports = shell_count("grep -rc 'pub use common.pure.nn' src/lib/nogc_async_mut/ml 2>/dev/null | awk -F: '{s+=$2} END{print s+0}'")
            val duplicate_defs = shell_count("grep -rEc '^ *(pub )?fn (loss|norm)\\(' src/lib/nogc_async_mut/ml 2>/dev/null | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): two occurrence counts from the real ml tree
            expect(reexports >= 1).to_equal(true)
            expect(duplicate_defs).to_equal(0)  # oracle: 0 — no shadow definition of loss/norm inside ml/

        it "`DType` and `Device` not defined in ml/ — only re-exported":
            # @req REQ-SCILIB-ML-05
            step("Count local struct/enum declarations of DType or Device inside ml/")
            val n = shell_count("grep -rEc '^ *(pub )?(struct|enum) (DType|Device)\\b' src/lib/nogc_async_mut/ml 2>/dev/null | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): occurrence count from the real ml tree
            expect(n).to_equal(0)  # oracle: 0 — these types must come only from std.ndarray re-export

        it "cuML not referenced anywhere in ml/ source":
            # @req REQ-SCILIB-ML-06
            step("Count literal cuML references inside ml/ source")
            val n = shell_count("grep -rc 'cuML' src/lib/nogc_async_mut/ml 2>/dev/null | awk -F: '{s+=$2} END{print s+0}'")
            # evidence(computed): occurrence count from the real ml tree
            expect(n).to_equal(0)  # oracle: 0 — cuML is deferred to v2, anti-pattern for v1.1

        it "PERF-SUGAR-003 observation entry promoted from `anticipated` to `observed` or `fixed` in `doc/08_tracking/feature/scilib_perf_sugar.md`":
            # @req REQ-SCILIB-ML-07
            step("Read the PERF-SUGAR-003 entry's own Status field from the real tracking doc")
            val status = shell_text("grep -A6 '^### PERF-SUGAR-003' doc/08_tracking/feature/scilib_perf_sugar.md | grep -m1 -oE '\\*\\*Status:\\*\\* *[a-z]+' | sed 's/.*: *//'")
            # evidence(computed): status text extracted from the real tracking doc
            expect(status == "anticipated").to_equal(false)
