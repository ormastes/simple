"""
## Purpose and audience
Acceptance oracles for the open remains of doc/03_plan/sys_test/compiler_loader_script_crosslang_perf.md.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/compiler_loader_script_crosslang_perf_spec.spl
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented.
"""
# @tag:in-development
# doc-path: doc/03_plan/sys_test/compiler_loader_script_crosslang_perf.md
# @manual_section: compiler_loader_script_crosslang_perf remains
# lifecycle: research doc/01_research/domain/sspec_documentization_maintenance.md ; architecture doc/04_architecture/sspec_documentization_maintenance.md ; design doc/05_design/app/testing/in_development_tag.md
# @req REQ-COMPILER-LOADER-PERF-001: candidate admission, focused perf spec, and compiler/lib/MCP/LSP checks bind to this identity in every scenario below.

use std.spec.{describe, context, it, expect}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_time_now_monotonic_ms() -> i64
extern fn rt_file_exists(path: text) -> bool

# Deployed candidate the plan's "One-pass verification order" step 1 admits or
# rejects. The plan is explicit: "Any nonzero exit, seed identity, missing
# target, or crash rejects admission."
val CANDIDATE_BINARY: text = "release/x86_64-unknown-linux-gnu/simple"
val EXPECTED_ADMITTED_EXIT: i64 = 0i64
val CRASH_EXIT_SIGSEGV_STYLE: i64 = 139i64

val PERF_SPEC_PATH: text = "test/05_perf/compiler_loader_script_crosslang_perf_spec.spl"

describe "plan: compiler_loader_script_crosslang_perf remains":

    context "unchecked — remove the remaining in-scope Build11 compiler/loader/script blocker without seed fallback, disabled checks, reduced workload, or fabricated evidence":

        it "the admitted candidate binary exists, is executable, and --version does not crash or report seed identity":
            step("admit the candidate binary and confirm --version does not crash or report seed identity")
            # @req REQ-COMPILER-LOADER-PERF-001
            # @capture: process exit code and stdout of `--version` are the retained evidence for this oracle
            # Interface pin: the plan's step 1 tooling-identity gate is
            # `test -x <candidate>` followed by `<candidate> --version`. A
            # missing/non-executable binary or a nonzero/crash exit is an
            # explicit rejection per the plan text, never a soft pass.
            val exists = rt_file_exists(CANDIDATE_BINARY)
            expect(exists).to_equal(true)
            val (stdout, stderr, code) = rt_process_run(CANDIDATE_BINARY, ["--version"])
            expect(code).to_equal(EXPECTED_ADMITTED_EXIT)
            expect(code == CRASH_EXIT_SIGSEGV_STYLE).to_equal(false)
            expect(stdout.contains("seed")).to_equal(false)

        it "the admitted candidate's test --help path does not exit 139 (the exact rejection the plan records for the current WARN state)":
            step("run the candidate's test --help path and reject the exact crash exit the plan records")
            # @req REQ-COMPILER-LOADER-PERF-001
            # @capture: process exit code of `test --help` is the retained evidence for this oracle
            # The plan's acceptance accounting states the retained baseline
            # "was retained as status 139 in rt_env_set" — i.e. the ABI/help
            # path crashed. This checkbox is closed only once that exact exit
            # code is no longer produced.
            val (stdout, stderr, code) = rt_process_run(CANDIDATE_BINARY, ["test", "--help"])
            expect(code == CRASH_EXIT_SIGSEGV_STYLE).to_equal(false)
            expect(code).to_equal(EXPECTED_ADMITTED_EXIT)

    context "unchecked — pass the focused SPipe performance specification with real assertions":

        it "compiler_loader_script_crosslang_perf_spec.spl runs to completion under the admitted candidate with --mode=interpreter --no-session-daemon and exits 0":
            step("run the focused SPipe performance spec under the admitted candidate and require exit 0")
            # @req REQ-COMPILER-LOADER-PERF-001
            # @capture: measured exit code and wall-clock elapsed_ms of the focused perf spec run are the retained evidence for this oracle
            # Interface pin: the plan's step 4 admission-dependent command is
            # `<candidate> test <PERF_SPEC_PATH> --mode=interpreter
            # --no-session-daemon`, required to "require the authoritative
            # file verdict with no dropped examples." The oracle is the
            # MEASURED exit code and wall time of that exact invocation, not
            # an asserted boolean.
            val spec_present = rt_file_exists(PERF_SPEC_PATH)
            expect(spec_present).to_equal(true)
            val started_ms = rt_time_now_monotonic_ms()
            val (stdout, stderr, code) = rt_process_run(
                CANDIDATE_BINARY,
                ["test", PERF_SPEC_PATH, "--mode=interpreter", "--no-session-daemon"]
            )
            val elapsed_ms = rt_time_now_monotonic_ms() - started_ms
            expect(code).to_equal(EXPECTED_ADMITTED_EXIT)
            expect(elapsed_ms >= 0i64).to_equal(true)
            expect(stdout.contains("dropped")).to_equal(false)

    context "unchecked — pass the compiler/core/lib and MCP/LSP checks required for compiler or library changes":

        it "`simple check src/compiler` exits 0 under the admitted candidate":
            step("run `simple check src/compiler` under the admitted candidate and require exit 0")
            # @req REQ-COMPILER-LOADER-PERF-001
            # @capture: process exit code of `check src/compiler` is the retained evidence for this oracle
            val (stdout, stderr, code) = rt_process_run(CANDIDATE_BINARY, ["check", "src/compiler"])
            expect(code).to_equal(EXPECTED_ADMITTED_EXIT)

        it "`simple check src/lib` exits 0 under the admitted candidate":
            step("run `simple check src/lib` under the admitted candidate and require exit 0")
            # @req REQ-COMPILER-LOADER-PERF-001
            # @capture: process exit code of `check src/lib` is the retained evidence for this oracle
            val (stdout, stderr, code) = rt_process_run(CANDIDATE_BINARY, ["check", "src/lib"])
            expect(code).to_equal(EXPECTED_ADMITTED_EXIT)

        it "`simple check src/app/mcp` exits 0 under the admitted candidate (MCP native smoke surface)":
            step("run `simple check src/app/mcp` under the admitted candidate and require exit 0")
            # @req REQ-COMPILER-LOADER-PERF-001
            # @capture: process exit code of `check src/app/mcp` is the retained evidence for this oracle
            val (stdout, stderr, code) = rt_process_run(CANDIDATE_BINARY, ["check", "src/app/mcp"])
            expect(code).to_equal(EXPECTED_ADMITTED_EXIT)

        it "`simple check src/app/simple_lsp_mcp` exits 0 under the admitted candidate (LSP smoke surface)":
            step("run `simple check src/app/simple_lsp_mcp` under the admitted candidate and require exit 0")
            # @req REQ-COMPILER-LOADER-PERF-001
            # @capture: process exit code of `check src/app/simple_lsp_mcp` is the retained evidence for this oracle
            val (stdout, stderr, code) = rt_process_run(CANDIDATE_BINARY, ["check", "src/app/simple_lsp_mcp"])
            expect(code).to_equal(EXPECTED_ADMITTED_EXIT)

        it "the MCP stdio integration spec exits 0 under SIMPLE_LIB=src with the admitted candidate":
            step("run the MCP stdio integration spec under the admitted candidate and require exit 0")
            # @req REQ-COMPILER-LOADER-PERF-001
            # @capture: presence of the target spec file plus its measured exit code are the retained evidence for this oracle
            # The plan's step 6 pins the exact invocation
            # `SIMPLE_LIB=src <candidate> test
            # test/02_integration/app/mcp_stdio_integration_spec.spl
            # --mode=interpreter`. rt_process_run does not thread env vars, so
            # this pins presence of the target spec file plus the candidate's
            # exit code on the same test subcommand shape as a proxy for the
            # gated surface; SIMPLE_LIB wiring is exercised by the harness
            # itself once step 1 admits the candidate.
            val mcp_stdio_spec = "test/02_integration/app/mcp_stdio_integration_spec.spl"
            val spec_present = rt_file_exists(mcp_stdio_spec)
            expect(spec_present).to_equal(true)
            val (stdout, stderr, code) = rt_process_run(
                CANDIDATE_BINARY,
                ["test", mcp_stdio_spec, "--mode=interpreter"]
            )
            expect(code).to_equal(EXPECTED_ADMITTED_EXIT)
