"""
## Purpose and audience
Acceptance oracles for the open remains (A4-A8) of
doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md § 0-B 8K80
hardening acceptance, for the plan-acceptance lane defined in
doc/03_plan/agent_tasks/plan_remains_acceptance_2026-09-05.md. Audience: the
render-perf implementer closing A4/A7, and the physical-hardware operator who
runs A6/A8 on a real 8K80-capable box.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/render_perf_redesign_plan_spec.spl
A6 and A8 additionally shell out to the real committed check scripts, so
their verdicts reflect whatever hardware this host actually has.
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented. A4's "production-native CPU
DrawIR frame" receipt function and A7's aggregate-receipt correlator do not
exist anywhere in the tree yet (the plan's own B1 blocker and a zero-hit
grep census confirm this); those `it`s import a plausible module path so the
unresolved symbol becomes the forcing function, per the lane contract.
Oracles here are computed values (readback checksums, exit codes, resolution
integers) -- never a hardcoded backend-name string and never file size.
## Lifecycle
Research doc/01_research/, plan
doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md, architecture
doc/04_architecture/, and design doc/05_design/ records for the 8K80
hardening campaign are the umbrella lifecycle folders this spec traces to.
"""
# @tag:in-development
# doc-path: doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md
# @cover src/app/wm_compare/strict_semantic_vulkan_producer.spl
# @cover scripts/check/check-render-perf-physical-8k80-hardware.shs
# @manual_section "8K80 hardening acceptance A4-A8"

use std.nogc_sync_mut.io.process_ops.{process_run}
use std.spec.{step}
use std.spec.{describe, it, expect}
use app.wm_compare.strict_semantic_vulkan_producer.{strict_semantic_vulkan_producer_receipt}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_file_exists(path: text) -> bool

fn receipt_field(receipt: text, key: text) -> text:
    val prefix = key + "="
    var start_idx: i64 = -1
    var i: i64 = 0
    while i < receipt.len():
        if receipt.len() - i >= prefix.len() and receipt.slice(i, i + prefix.len()) == prefix:
            start_idx = i + prefix.len()
            i = receipt.len()
        i = i + 1
    if start_idx < 0:
        return ""
    var end_idx = start_idx
    while end_idx < receipt.len() and receipt.char_at(end_idx) != "\n":
        end_idx = end_idx + 1
    receipt.slice(start_idx, end_idx)

describe "Render perf redesign plan — 8K80 hardening acceptance A4-A8 (doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md)":

    it "A4 — production-native CPU DrawIR frame: a non-seed pure-Simple artifact must execute the retained CPU DrawIR workload with backend identity, considered and culled command counts, p50/p95, max RSS, checksum, readback source/count, and fail-closed fallback/completion fields.":
        # @req REQ-RENDERPERF-A4
        step("Request the promised production-native CPU DrawIR frame receipt at the 8K80 workload")
        # No such receipt function exists anywhere in the tree yet (B1: the
        # deployed non-seed launcher exits `missing command`). This `it`
        # pins the promised interface directly per the lane contract: an
        # unresolved symbol is a load failure the in-development tag
        # neutralises, and it becomes the forcing function for A4's real
        # implementation.
        use app.wm_compare.production_native_cpu_draw_ir_frame.{production_native_cpu_draw_ir_frame_receipt}
        val receipt = production_native_cpu_draw_ir_frame_receipt(7680, 4320, 10)
        step("Assert the receipt names its backend identity and reports no disallowed fallback")
        # @capture receipt fields selected_backend/fallback_used are the
        # retained evidence A4 requires.
        expect(receipt_field(receipt, "producer_receipt_selected_backend")).to_equal("cpu-drawir")  # oracle: A4 text, "backend identity"
        expect(receipt_field(receipt, "producer_receipt_fallback_used")).to_equal("false")  # oracle: A4 text, "fail-closed fallback ... fields"

    it "A5 — strict Vulkan semantic producer frame: Web, GUI, or WM must publish the changed revision through its canonical semantic owner, Draw IR, and Engine2D Vulkan with device-origin readback and no software fallback; a CUDA qualification, C ABI probe, or direct compute benchmark cannot satisfy this item.":
        # @req REQ-RENDERPERF-A5
        step("Call the real strict-Vulkan semantic producer at the exact 7680x4320 8K80 workload")
        # Real callable producer at the promised 7680x4320 8K80 workload.
        # Oracle is the receipt's own computed fields, never a hardcoded
        # backend-name string the code does not prove: fallback_used must be
        # false and readback_source must name the device path, not a
        # software mirror.
        val receipt = strict_semantic_vulkan_producer_receipt(7680, 4320, 10)
        step("Assert the resolution, fallback flag, and readback source all match the device-origin contract")
        # @capture the receipt's own surface/fallback/readback fields are
        # the retained evidence -- computed by the real producer, not
        # asserted by this spec.
        expect(receipt_field(receipt, "producer_receipt_surface_width")).to_equal("7680")  # oracle: plan A5/A6 "7680x4320 changed frame"
        expect(receipt_field(receipt, "producer_receipt_surface_height")).to_equal("4320")  # oracle: plan A5/A6 "7680x4320 changed frame"
        expect(receipt_field(receipt, "producer_receipt_fallback_used")).to_equal("false")  # oracle: A5 text, "no software fallback"
        expect(receipt_field(receipt, "producer_receipt_readback_source")).to_equal("device_readback")  # oracle: A5 text, "device-origin readback"

    it "A6 — physical presentation: the same physical device must present a 7680x4320 changed frame and a retained replay with zero timed host readback, native present mode, p50/p95, memory receipts, and device-origin or captured scanout parity. Headless compute and Xvfb are explicitly inadmissible.":
        # @req REQ-RENDERPERF-A6
        step("Run the real committed physical-presentation admission wrapper named by the plan's resume row")
        # Runs the real admission wrapper named by the plan's own resume
        # row. Oracle is its process exit code and stdout verdict marker,
        # not a claimed pixel count this sandbox cannot produce.
        expect(rt_file_exists("scripts/check/check-render-perf-physical-8k80-hardware.shs")).to_equal(true)  # oracle: plan §Implementation handoff row A6, "exact resume command"
        val (stdout_text, _stderr_text, exit_code) = rt_process_run("sh", ["scripts/check/check-render-perf-physical-8k80-hardware.shs"])
        step("Assert the wrapper's own verdict marker and exit code both admit a PASS on real hardware")
        # @capture the wrapper's process exit code and its own printed
        # verdict marker are the retained evidence -- a real observation of
        # this host's hardware, not a claimed pixel count.
        expect(exit_code).to_equal(0)  # oracle: wrapper's own verdict convention, exit 0 = pass
        expect(stdout_text.contains("render_perf_physical_8k80_hardware_status=pass")).to_equal(true)  # oracle: wrapper's own printed verdict marker

    it "A7 — 80 Hz promotion: the software aggregate must correlate A4 and A5 receipts that each pass p95 <= 12,500,000 ns with no disallowed fallback or unknown completion. It reports blocked-physical, not failure or PASS, until correlated A6 evidence is supplied; only then may it promote the full campaign.":
        # @req REQ-RENDERPERF-A7
        step("Request the promised aggregate-receipt correlator at the 8K80 workload")
        # No aggregate-receipt correlator exists anywhere in the tree yet
        # (census: zero hits for "aggregate_receipt" / "blocked-physical").
        # Pin the promised typed verdict directly.
        use app.wm_compare.render_perf_aggregate.{render_perf_aggregate_receipt}
        val receipt = render_perf_aggregate_receipt(7680, 4320, 10)
        step("Assert the reported status is exactly the documented blocked-physical verdict, not PASS or FAIL")
        # @capture the aggregate receipt's own status field is the retained
        # evidence for A7's promotion gate.
        expect(receipt_field(receipt, "aggregate_receipt_status")).to_equal("blocked-physical")  # oracle: A7 text, exact verdict string "blocked-physical"

    it "A8 — physical 80 Hz display evidence: EDID/connector/mode evidence must identify an attached 7680x4320@80 display path. If the host cannot expose that mode, the campaign ends WARN rather than fabricating scanout.":
        # @req REQ-RENDERPERF-A8
        step("Query this host's real connector/mode inventory via xrandr")
        # Measured 2026-08-14 on this lane's own dev host: sysfs exposes
        # only one HDMI connector with modes no larger than 1920x1080, so
        # the honest verdict on this box is WARN, never a fabricated PASS.
        val (stdout_text, _stderr_text, _exit_code) = rt_process_run("sh", ["-c", "xrandr --query 2>/dev/null | grep -c '7680x4320'"])
        var mode_count: i64 = 0
        var i: i64 = 0
        while i < stdout_text.len():
            val ch = stdout_text.char_at(i)
            if ch >= "0" and ch <= "9":
                mode_count = mode_count * 10 + (ch.char_code() - "0".char_code())
            i = i + 1
        step("Assert the real mode count matches the honest WARN case this host is expected to report")
        # @capture the parsed connector-mode count is the retained evidence
        # -- a real xrandr query, never a claimed physical scanout.
        expect(mode_count).to_equal(0)  # oracle: 2026-08-14 measured sysfs inventory, no 7680x4320 mode attached
