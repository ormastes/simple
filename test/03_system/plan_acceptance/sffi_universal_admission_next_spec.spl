            val status = rocm_engine2d_upload_pixels(0, [0u32, 0u32, 0u32, 0u32], 4)
            expect(status <= 4).to_equal(true)

    context "3D GPU raw-owner deduplication":

        it "Replace the providerless/legacy 3D ABI names with versioned typed contracts and exact signed provider admission":
            # @req REQ-SFFI-ADMIT-036
            step("call the real rt_cuda3d_available compatibility re-export the plan says the four ffi_*3d modules now provide")
            # oracle: this test host has no CUDA 3D provider; a genuine
