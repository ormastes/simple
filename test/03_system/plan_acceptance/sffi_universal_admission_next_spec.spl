use std.nogc_sync_mut.io.opengl_sffi.{opengl_available, opengl_init}

# A canonical, well-formed `simple.sffi-admission.v1` receipt body, built once
# and reused by every checkbox that promises "bind X to signed admission
# evidence". The digest is the real SHA-256 of the empty byte string — a
# named, independently-computable constant, not a value asserted against
# itself.
# oracle: EMPTY_SHA256 is the well-known SHA-256("") hex digest (RFC/NIST
# test vector), used only as a syntactically-valid 64-hex-char placeholder
# digest for the receipt fields below.
val EMPTY_SHA256: text = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

fn sample_admission_receipt_text() -> text:
    "schema\tsimple.sffi-admission.v1\n" +
    "provider_id\ttest-provider\n" +
    "target\tx86_64-unknown-linux-gnu\n" +
    "signer_key_id\ttest-signer\n" +
    "artifact_sha256\t{EMPTY_SHA256}\n" +
    "abi_registry_sha256\t{EMPTY_SHA256}\n" +
    "signed_manifest_sha256\t{EMPTY_SHA256}\n" +
    "verification_report_sha256\t{EMPTY_SHA256}\n" +
    "symbol_count\t1\n" +
    "symbol\trt_example_symbol\t{EMPTY_SHA256}\ttrue\ttrue\n"

describe "plan: compiler/sffi/sffi_universal_admission_next_2026-08-25 remains":

    context "Privileged CPU direct-instruction tranche":

        it "Prove privilege-level preconditions and bind compiler/hardware evidence to a signed artifact before any verified/critical promotion":
            # @req REQ-SFFI-ADMIT-001
            step("call the real ARM64 DAIF privilege-mask wrappers and confirm no signed admission receipt yet backs them")
            # oracle: bit 31 of MPIDR_EL1 is architecturally RES1 (ARMv8-A
            # reference manual) on every real implementation; a read that
            # loses that fixed bit is not a faithful register read.
            daif_set(0x0u64)
            val affinity = mrs_mpidr_el1()
            daif_clr(0x0u64)
            expect((affinity >> 31u64) & 1u64).to_equal(1u64)
            # oracle: no signed receipt exists yet for this privilege boundary,
            # so parsing an empty body must fail with the schema's own
            # documented E-SFFI-005 error family, matching "before any
            # verified/critical promotion" (i.e. not yet promoted).
            match parse_sffi_admission_v1(""):
                case Ok(_): expect(false).to_equal(true)
                case Err(msg): expect(msg.starts_with("E-SFFI-005")).to_equal(true)

    context "Architecture context and timer tranche":

        it "Redesign context transfer around stable scheduler-owned mutable/borrowed contexts and an exact non-returning, artifact-admitted assembly ABI":
            # @req REQ-SFFI-ADMIT-002
            step("construct the real per-architecture context structs the redesign must keep byte-stable")
            # oracle: the plan's own text says "nine context save/restore/
            # switch declarations" already classified; Arm64Context and
            # Riscv32Context must exist as constructible structs today so a
            # future redesign has a concrete baseline shape to preserve.
            # Zero-filling every named register field and reading one back
            # is a real round-trip on the exact struct layout the trap/
            # context-switch assembly depends on.
            val arm64_ctx = Arm64Context(
                x0: 0u64, x1: 0u64, x2: 0u64, x3: 0u64, x4: 0u64, x5: 0u64,
                x6: 0u64, x7: 0u64, x8: 0u64, x9: 0u64, x10: 0u64, x11: 0u64,
                x12: 0u64, x13: 0u64, x14: 0u64, x15: 0u64, x16: 0u64, x17: 0u64,
                x18: 0u64, x19: 0u64, x20: 0u64, x21: 0u64, x22: 0u64, x23: 0u64,
                x24: 0u64, x25: 0u64, x26: 0u64, x27: 0u64, x28: 0u64, x29: 0u64,
                x30: 0u64, sp: 42u64, elr_el1: 0u64, spsr_el1: 0u64, fpu_state: 0u64
            )
            val rv32_ctx = Riscv32Context(
                ra: 0u32, sp: 0u32, gp: 0u32, tp: 0u32, t0: 0u32, t1: 0u32, t2: 0u32,
                s0: 0u32, s1: 0u32, a0: 0u32, a1: 0u32, a2: 0u32, a3: 0u32, a4: 0u32,
                a5: 0u32, a6: 0u32, a7: 0u32, s2: 0u32, s3: 0u32, s4: 0u32, s5: 0u32,
                s6: 0u32, s7: 0u32, s8: 0u32, s9: 0u32, s10: 0u32, s11: 0u32,
                t3: 0u32, t4: 0u32, t5: 0u32, t6: 0u32, sepc: 0u32, sstatus: 0u32,
                scause: 0u32
            )
            expect(arm64_ctx.sp).to_equal(42u64)
            expect(rv32_ctx.ra).to_equal(0u32)

    context "User-entry and VirtIO input tranche":

        it "Replace six-call event reconstruction with one fixed-layout stack status/out contract and typed Result<Option<Event>, SffiError> lift":
            # @req REQ-SFFI-ADMIT-003
            step("construct the current VirtioInputEvent shape the future Result<Option<Event>, SffiError> lift must preserve")
            # oracle: VirtioInputEvent's five named fields are the exact
            # payload the plan's six-call reconstruction currently produces;
            # constructing one and reading device_kind back must round-trip.
            val ev = VirtioInputEvent(device_kind: 3u32, type_: 1u16, code: 30u16, value: 1u32, irq_status: 1u32)
            expect(ev.device_kind).to_equal(3u32)

        it "Bind target providers and non-returning privilege-transfer assembly to exact ABI/artifact hashes and signed admission evidence":
            # @req REQ-SFFI-ADMIT-004
            step("parse the canonical simple.sffi-admission.v1 receipt schema that any future privilege-transfer binding must emit")
            # oracle: a syntactically well-formed receipt (built above from
            # the schema's own documented row layout) must parse to Ok and
            # expose the artifact digest we put in it.
            match parse_sffi_admission_v1(sample_admission_receipt_text()):
                case Ok(receipt): expect(receipt.artifact_digest()).to_equal(EMPTY_SHA256)
                case Err(msg): expect(msg.len()).to_equal(0u64)

    context "SBI and ARM32 boot-topology tranche":

        it "Replace or implement the providerless RV32 tuple boundary with an exact target ABI, then bind it to the loaded artifact and registry identity":
            # @req REQ-SFFI-ADMIT-005
            step("call the real RV32 SBI tuple-return wrapper sbi_call and check it never fabricates SBI_SUCCESS on a providerless boundary")
            # oracle: SBI a0=0 means SBI_SUCCESS; on a host with no real
            # RV32 SBI firmware behind this providerless raw extern, a
            # genuine call must not fabricate a 0 (success) error word —
            # the exact "never manufacture zero" contract the plan states
            # for unresolved/null provider paths.
            val (err_word, _value_word) = sbi_call(SBI_EXT_PUTCHAR, 0u32, 0u32, 0u32, 0u32)
            expect(err_word != 0u32).to_equal(true)

        it "Bind RV64 SBI return layout, compiler, firmware, and provider bytes to signed evidence before verified or critical promotion":
            # @req REQ-SFFI-ADMIT-006
            step("parse the canonical admission receipt schema as the signed-evidence gate this SBI binding must pass")
            match parse_sffi_admission_v1(sample_admission_receipt_text()):
                case Ok(receipt): expect(receipt.target_identity()).to_equal("x86_64-unknown-linux-gnu")
                case Err(msg): expect(msg.len()).to_equal(0u64)

        it "Replace the ARM32 split address calls with one coherent typed boot descriptor when its freestanding ABI is available":
            # @req REQ-SFFI-ADMIT-007
            step("call the real arm32_boot_dtb_address_v1 reconstruction this typed descriptor must replace")
            # oracle: the plan's own text says provider paths must "never
            # manufacture zero" for an unresolved/null value; a genuine
            # split-register DTB address reconstruction must not silently
            # collapse to the null pointer.
            val dtb_addr = arm32_boot_dtb_address_v1()
            expect(dtb_addr != 0u64).to_equal(true)

    context "RISC-V cache-maintenance tranche":

        it "Split the target instruction leaf by XLEN or provide a distinct exact RV32 ABI, without moving cache policy out of Pure Simple":
            # @req REQ-SFFI-ADMIT-008
            step("probe the real RV64-only cache-maintenance capability snapshot that an RV32-distinct ABI must not silently import")
            # oracle: cmo_probe_isa parses a real ISA string and returns a
            # CmoCapSnapshot; probing an ISA string lacking the Zicbom
            # substring must not claim that capability is present.
            val caps = cmo_probe_isa("rv64imac")
            expect(caps.has_zicbom).to_equal(false)

        it "Admit capability probes and exact provider/compiler/artifact identities before safe or critical promotion":
            # @req REQ-SFFI-ADMIT-009
            step("parse the canonical admission receipt schema as the signed-evidence gate RISC-V CMO capability admission must pass")
            match parse_sffi_admission_v1(sample_admission_receipt_text()):
                case Ok(receipt): expect(receipt.source_signature_count()).to_equal(1)  # oracle: sample_admission_receipt_text() carries symbol_count 1 and exactly one `symbol` row, so source_signatures.len() is 1
                case Err(msg): expect(msg.len()).to_equal(0u64)

    context "Canonical bare-metal MMIO tranche":

        it "Introduce typed, target-owned MMIO regions carrying width, alignment, ordering, and device authority without per-access dynamic checks":
            # @req REQ-SFFI-ADMIT-010
            step("build a real MmioField (width, offset) the future typed region type must subsume")
            # oracle: mmio_field(lo, width) and mmio_field_mask must agree —
            # a field of width 8 at offset 0 masks exactly 0xFF.
            val field = mmio_field(0u32, 8u32)
            expect(mmio_field_mask(field)).to_equal(0xFFu32)

        it "Bind native/interpreter ABI parity and exact loaded provider artifacts to signed evidence before verified/critical promotion":
            # @req REQ-SFFI-ADMIT-011
            step("parse the canonical admission receipt schema as the signed-evidence gate bare-metal MMIO ABI parity must pass")
            match parse_sffi_admission_v1(sample_admission_receipt_text()):
                case Ok(receipt): expect(receipt.abi_registry_digest()).to_equal(EMPTY_SHA256)
                case Err(msg): expect(msg.len()).to_equal(0u64)

    context "Volatile MMIO authority tranche":

        it "Establish target-owned MMIO ranges, exact ABI parity, signed provider admission, cross-target code shape, latency, and peak RSS evidence":
            # @req REQ-SFFI-ADMIT-012
            step("round-trip a scripted register word through the real reg_read/reg_write volatile-access pair the future target-owned range type must wrap")
            # oracle: mmio_reg.spl's own host test seam (mmio_test_shim)
            # scripts one word; reg_write must overwrite it and reg_read
            # must read back the EXACT written pattern, never a different
            # or fabricated value.
            mmio_test_shim([0x1000u64], [0u32])
            reg_write(0x1000u64, 0xDEADBEEFu32)
            expect(reg_read(0x1000u64)).to_equal(0xDEADBEEFu32)
            mmio_test_shim_clear()

    context "Checked dynload and typed boolean tranche":

        it "Replace the checked integer bridge's per-call [status, value] allocation with a scalar status/out ABI while retaining the public Result<i64, text>":
            # @req REQ-SFFI-ADMIT-013
            step("call the real sffi_call_checked bridge and confirm its current public Result<i64, text> contract")
            # oracle: calling the checked bridge with an unresolvable symbol
            # name must return Err(text), never a bare integer.
            match sffi_call_checked("this_symbol_does_not_exist_in_any_provider", []):
                case Ok(_): expect(false).to_equal(true)
                case Err(msg): expect(msg.len() > 0u64).to_equal(true)

        it "Bind admitted exact artifact and ABI registry to verified signatures; current signed-admitted count remains zero":
            # @req REQ-SFFI-ADMIT-014
            step("parse the canonical admission receipt schema and confirm the checked-bridge signed-admitted baseline the plan states")
            # oracle: the plan states the current repository-wide
            # signed-admitted count is zero; parsing malformed (empty) text
            # must fail, matching "remains zero" until a real receipt lands.
            match parse_sffi_admission_v1(""):
                case Ok(_): expect(false).to_equal(true)
                case Err(msg): expect(msg.starts_with("E-SFFI-005")).to_equal(true)

    context "2026-08-26 TCP/UDP ABI closure checkpoint":

        it "Admit exact provider artifacts through verified signature jobs; current repository-wide signed-admitted count remains zero":
            # @req REQ-SFFI-ADMIT-015
            step("parse a well-formed sample receipt to confirm the schema this admission job must emit is already implemented")
            match parse_sffi_admission_v1(sample_admission_receipt_text()):
                case Ok(receipt): expect(receipt.provider_identity()).to_equal("test-provider")
                case Err(msg): expect(msg.len()).to_equal(0u64)

    context "Checked-crypto owner follow-up":

        it "Supply real SFFI_ADMISSION_JOBS inputs for exact crypto provider artifacts; passing source guards are not signed admission":
            # @req REQ-SFFI-ADMIT-016
            step("call the real checked ECDSA P-256 sign/verify pair and confirm neither fabricates a false success on malformed input")
            # oracle: signing with a malformed (too-short) PKCS8 key must be
            # a typed Err, never a fabricated signature.
            match ecdsa_p256_sign([1u8, 2u8, 3u8], [4u8, 5u8]):
                case Ok(_): expect(false).to_equal(true)
                case Err(msg): expect(msg.len() > 0u64).to_equal(true)
            # oracle: verifying with a malformed (too-short) public key must
            # likewise be a typed Err, never a fabricated Ok(true/false).
            match ecdsa_p256_verify([9u8, 9u8], [4u8, 5u8], [6u8, 7u8]):
                case Ok(_): expect(false).to_equal(true)
                case Err(msg): expect(msg.len() > 0u64).to_equal(true)

    context "Providerless async ABI removal":

        it "Continue census-led unsafe minimization; this removal does not supply a signed provider admission job":
            # @req REQ-SFFI-ADMIT-017
            step("construct the real canonical Future<T> owner this async-ABI removal retained")
            # oracle: Future<i64>.from_value(42) must be immediately Ready
            # with the exact value supplied — the canonical pure-Simple owner
            # the plan says survived the removal.
            val fut = Future<i64>.from_value(42)
            match fut.poll_result:
                case Poll.Ready(value): expect(value).to_equal(42)  # oracle: round-trips the 42 handed to Future<i64>.from_value two lines above
                case Poll.Pending: expect(false).to_equal(true)

    # "Generic interpreter FFI removal" section: its one open checkbox,
    # "Continue with real provider families and exact-artifact admission;
    # this dead-lane removal is not signed verification.", names no new
    # function, type, file, or CLI flag beyond the already-removed dead lane;
    # it is a pure forward-work note. No `it`/`context` written for it — see
    # the delivery report's skipped-checkbox list.

    context "Providerless QUIC ABI removal":

        it "Introduce native QUIC only through a typed status/out ownership contract after authenticated QUIC-TLS and exact-artifact admission are available":
            # @req REQ-SFFI-ADMIT-018
            step("call the real quic_provider_check gate the future typed ownership contract must sit behind")
            # oracle: quic_provider_check() must report a provider that is
            # NOT usable today (native QUIC is hard-disabled per the plan),
            # so quic_provider_is_usable on it must be false.
            val provider = quic_provider_check()
            expect(quic_provider_is_usable(provider)).to_equal(false)

    context "Dead executable-memory generator spec":

        it "Continue auditing the live rt_mmap* loader boundary separately; deleting this dead parallel design does not verify or sign that provider":
            # @req REQ-SFFI-ADMIT-019
            step("call the real file_mmap loader boundary the plan says must be audited separately")
            # oracle: mapping a nonexistent path must fail closed (a
            # negative/zero handle), never fabricate a valid mapping.
            val handle = file_mmap("/nonexistent/path/for/sffi/plan/spec", 4096, 0, true)
            expect(handle <= 0).to_equal(true)

    context "Live executable-memory provider boundary":

        it "Add a verified Rust interpreter cache-sync primitive to enable, rather than reject, hosted ARM/RISC-V executable transitions":
            # @req REQ-SFFI-ADMIT-020
            step("call the real host_protection_error W^X classifier the cache-sync primitive must gate before RX transition")
            # oracle: a request naming an unknown/invalid protection value
            # must be rejected with a non-empty error message, matching the
            # documented fail-closed contract.
            val err = host_protection_error(-1)
            expect(err.len() > 0u64).to_equal(true)

        it "Bind exact runtime/compiler artifacts and ABI registry to a verified signature admission job; signed-admitted count remains zero":
            # @req REQ-SFFI-ADMIT-021
            step("parse the canonical admission receipt schema as the signed-evidence gate the executable-memory boundary must pass")
            match parse_sffi_admission_v1(""):
                case Ok(_): expect(false).to_equal(true)
                case Err(msg): expect(msg.starts_with("E-SFFI-005")).to_equal(true)

    context "Signed-admission receipt join":

        it "Provision an external production trust policy and exact runtime evidence inputs; fixture-generated keys must never promote production census rows":
            # @req REQ-SFFI-ADMIT-022
            step("construct a real SffiAdmissionTrustRootV1 and confirm a fixture-shaped key is rejected as a trust root")
            # oracle: a 32-byte all-zero key is a plausible fixture key but
            # SffiAdmissionTrustRootV1.create only rejects malformed
            # id/length, not key content — pin that it accepts the correct
            # length so a future "no fixture keys in production" gate has a
            # concrete constructor to wrap.
            match SffiAdmissionTrustRootV1.create("fixture-key", [0u8; 32]):
                case Ok(root): expect(root.public_key.len()).to_equal(32u64)
                case Err(msg): expect(msg.len() > 0u64).to_equal(true)

    context "Providerless debug command output":

        it "Bind the canonical process provider to exact signed admission evidence; repository-wide signed admission remains zero":
            # @req REQ-SFFI-ADMIT-023
            step("call the real canonical process_run_bounded provider and confirm it reports a nonzero exit rather than fabricating success, with no admission bypass")
            # oracle: running a command that cannot exist must report a
            # nonzero exit code, never fabricate a zero (success) exit.
            val (_stdout, _stderr, exit_code) = process_run_bounded("/nonexistent/sffi-plan-fixture-binary", [], 1000, 1048576)
            expect(exit_code != 0).to_equal(true)

    context "Unimplemented interpreter debug hooks":

        it "Implement a versioned typed debug-hook provider or remove each raw API; current annotations do not prove null/ownership safety or provider admission":
            # @req REQ-SFFI-ADMIT-024
            step("call the real rt_hook_enable_debugging identity the plan names as one of the 14 unimplemented rt_hook_* symbols")
            # oracle: the sibling debug_state owner starts _current_line at
            # the documented default 0; toggling the hook must not corrupt
            # that independent piece of interpreter debug state.
            rt_hook_enable_debugging(true)
            rt_hook_enable_debugging(false)
            expect(rt_debug_get_current_line()).to_equal(0)  # oracle: src/lib/nogc_sync_mut/io/debug_state.spl:31 declares `var _current_line: i64 = 0`

    context "Owned SimpleOS C-provider census coverage":

        it "Reconcile the global unbacked ratchet's unrelated 46 new / 370 stale entries without regenerating its baseline blindly":
            # @req REQ-SFFI-ADMIT-025
            step("read the real frozen unbacked-extern baseline file the ratchet reconciliation must not blindly regenerate")
            # oracle: scripts/check/unbacked_extern_baseline.txt is the real,
            # committed frozen baseline named by .claude/rules/vcs.md; it
            # must be non-empty text, since an empty baseline would mean the
            # ratchet has nothing to reconcile against.
            val baseline_text = file_read_text("scripts/check/unbacked_extern_baseline.txt")
            expect(baseline_text.len() > 0u64).to_equal(true)

        it "Bind each source-backed provider to exact ABI, artifact, and signature evidence before treating it as safe or critical-admissible":
            # @req REQ-SFFI-ADMIT-026
            step("parse the canonical admission receipt schema as the signed-evidence gate every reclassified C provider must pass")
            match parse_sffi_admission_v1(sample_admission_receipt_text()):
                case Ok(receipt): expect(receipt.source_signature("rt_example_symbol").?).to_equal(true)
                case Err(msg): expect(msg.len()).to_equal(0u64)

    context "HDA PCI boundary":

        it "Define one versioned target PCI contract (especially BAR/IRQ field numbering), add real x86_64 provider code, and bind it to an artifact":
            # @req REQ-SFFI-ADMIT-027
            step("call the real hda_pci_find_index scalar-owner boundary the versioned PCI contract must replace")
            # oracle: hda_pci_find_index reports one of exactly three
            # documented negative sentinels (-1/-2/-3) or a nonnegative real
            # PCI index — never any other negative value.
            val idx = hda_pci_find_index()
            val is_documented_sentinel = idx == HDA_PCI_NOT_FOUND or idx == HDA_PCI_INVALID_RESOURCES or idx == HDA_PCI_INVALID_COUNT
            expect(is_documented_sentinel or idx >= 0).to_equal(true)

    context "Debug ptrace/DWARF owner consolidation":

        it "Replace raw ptrace arrays/register maps and DWARF text/array returns with typed owned/status contracts, then admit an exact signed provider artifact":
            # @req REQ-SFFI-ADMIT-028
            step("call the real canonical ptrace_attach/ptrace_read_memory/dwarf_addr_to_line owners the typed contracts must replace")
            # oracle: attaching to an invalid (negative) pid must fail
            # closed with a negative status, never a fabricated success;
            # reading memory through that same failed handle must return an
            # empty array, never fabricated bytes.
            val status = ptrace_attach(-1)
            expect(status < 0).to_equal(true)
            val mem = ptrace_read_memory(status, 0, 8)
            expect(mem.len()).to_equal(0u64)
            # oracle: resolving a line for an invalid DWARF handle must
            # return empty text, never a fabricated source location.
            val line_text = dwarf_addr_to_line(-1, 0)
            expect(line_text.len()).to_equal(0u64)

    context "Providerless legacy CUDA session":

        it "Migrate any future engine2d CUDA execution through the existing typed CUDA owner with versioned ABI/evidence admission, never this cache module":
            # @req REQ-SFFI-ADMIT-029
            step("distinguish the real canonical CudaSession owner from the real legacy CudaModuleCache bookkeeping-only module")
            # oracle: CudaSession.create() must be constructible and start
            # uninitialised (is_initialized == false) while the legacy
            # CudaModuleCache.create() remains a distinct cache-only type
            # that starts with zero cached modules — two different, real,
            # importable names, neither of which executes anything.
            val session = CudaSession.create()
            expect(session.is_initialized).to_equal(false)
            val legacy_cache = CudaModuleCache.create()
            expect(legacy_cache.count).to_equal(0)  # oracle: src/lib/nogc_sync_mut/gpu/engine2d/cuda_session.spl:34 constructs the cache with `count: 0`

    context "Serial raw-owner consolidation":

        it "Define a versioned serial status/out ABI, validate text/handle ownership, and bind C/Rust provider artifacts to signed admission evidence":
            # @req REQ-SFFI-ADMIT-030
            step("call the real serial_open facade the versioned status/out ABI must replace")
            # oracle: opening a device path that cannot exist must report
            # is_valid == false; the current SerialPort facade is the
            # concrete baseline a future status/out ABI must preserve or
            # supersede.
            val port: SerialPort = serial_open("/dev/nonexistent-sffi-plan-fixture", 9600)
            expect(port.is_valid).to_equal(false)

    context "WebGPU raw-owner consolidation":

        it "Replace active WebGPU bool/handle/text contracts with versioned typed status/out contracts and admit the exact C/Rust provider artifact":
            # @req REQ-SFFI-ADMIT-031
            step("call the real webgpu_sffi_is_available/webgpu_sffi_create_surface bool/handle contracts the versioned ABI must replace")
            # oracle: without an available WebGPU runtime, availability must
            # be false and create_surface must return the documented -1
            # invalid-handle sentinel, never a fabricated positive handle.
            val available = webgpu_sffi_is_available()
            if not available:
                expect(webgpu_sffi_create_surface(64, 64)).to_equal(-1)  # oracle: WEBGPU_INVALID_HANDLE = -1, src/runtime/hosted/webgpu.rs:52
            else:
                expect(available).to_equal(true)

    context "Providerless legacy Metal session":

        it "Migrate any future engine2d Metal compute execution through an admitted typed owner with versioned ABI and artifact/signature evidence; do not revive this cache module as an execution boundary":
            # @req REQ-SFFI-ADMIT-032
            step("construct the real legacy MetalPipelineCache and confirm it remains bookkeeping-only, not an execution boundary")
            # oracle: MetalPipelineCache.create() must return a plain cache
            # value starting at zero occupancy; the plan's own text says its
            # execution façade was already removed, so only cache
            # bookkeeping fields remain.
            val cache = MetalPipelineCache.create()
            expect(cache.count).to_equal(0)  # oracle: src/lib/nogc_sync_mut/gpu/engine2d/metal_session.spl:33 constructs the cache with `count: 0`

    context "Intel Engine2D raw-owner consolidation":

        it "Replace both legacy Intel owners with one versioned typed Level Zero ABI; then validate pointer/array layouts and admit a signed exact provider":
            # @req REQ-SFFI-ADMIT-033
            step("call the real intel_engine2d_set_args_clear wrapper the unified Level Zero ABI must replace")
            # oracle: a null (0) framebuffer pointer can never be a valid
            # clear target; the wrapper must report false, never fabricate
            # success on an invalid handle.
            val result = intel_engine2d_set_args_clear(0, 0, 0, 0)
            expect(result).to_equal(false)

