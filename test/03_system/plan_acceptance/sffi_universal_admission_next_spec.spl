                case Err(msg): expect(msg.len()).to_equal(0u64)

    context "ROCm Engine2D raw-boundary classification":

        it "Replace legacy dispatch façades with one typed ROCm ABI, validate array/handle ownership and status semantics, and admit an exact signed provider":
            # @req REQ-SFFI-ADMIT-035
            step("call the real rocm_engine2d_upload_pixels façade the unified typed ROCm ABI must replace")
            # oracle: uploading a real bounded pixel array to a null device
