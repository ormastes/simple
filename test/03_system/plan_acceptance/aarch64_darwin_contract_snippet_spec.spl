"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/os/multiarch_qemu_systest/aarch64_darwin_contract_snippet.md.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/aarch64_darwin_contract_snippet_spec.spl
SIMPLE_BINARY=<path> names the Simple binary the "no errors" scenarios
compile with (default bin/simple); it must be able to `run` a `.spl`.
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented.
AUDIT 2026-09-05: the two `bin/simple check ... — no errors` checkboxes were
previously "verified" by comparing accessor literals to the same literals,
and the RED-with-missing-media checkbox by asserting that the darwin binary
is absent — the NOT-done state. Each scenario now runs a real tool: the
check scenarios compile and execute a generated driver through the Simple
binary (a real exit code, with a control driver that must fail), the
missing-media scenario runs the actual sibling system spec as a subprocess
and reads ITS verdict, host-conditionally (Linux: RED with the exact
missing-media path the checkbox quotes; darwin: the lane's own target OS,
where the staged binary must make it GREEN), and the classification
scenario proves the verdict carries its argument with a bogus path.
## Verification guidance / troubleshooting
A failure on the first scenario means the driver importing
src/os/qemu_systest_contract.spl no longer compiles/runs (or the six
aarch64_darwin_* accessors were renamed); on the second, that
simpleos_platform_targets() in
src/os/port/_SimpleosMultiplatformBuild/platform_target_catalog.spl still
lacks the aarch64-apple-darwin entry the merge snippet inserts. A failure on
the third scenario on a darwin host means build/os/darwin-aarch64/ has not
been staged — build it per the plan before reading the red as a regression.
"""
# @tag:in-development
# doc-path: doc/03_plan/os/multiarch_qemu_systest/aarch64_darwin_contract_snippet.md
# @manual_section aarch64-darwin contract snippet remains

use std.spec.{step}
use std.spec.{describe, context, it, expect}
use std.io_runtime.{env_get, file_exists, file_write, dir_create_all, process_run}
use std.platform.{host_os}
use os.qemu_systest_contract.{
    run_qemu_systest,
    aarch64_darwin_binary_path,
    aarch64_darwin_app_path,
    aarch64_darwin_qemu_bin,
    aarch64_darwin_qemu_args,
    aarch64_darwin_markers,
    aarch64_darwin_timeout_ms
}
use os.port.simpleos_multiplatform_build_part2.{simpleos_platform_targets}

val DRIVER_DIR: text = "build/plan_acceptance/aarch64_darwin"
val SYS_SPEC: text = "test/03_system/os/qemu/sys_qemu_aarch64_darwin_fs_exec_spec.spl"

fn simple_binary() -> text:
    val configured = env_get("SIMPLE_BINARY") ?? ""
    if configured != "" and file_exists(configured):
        return configured
    "bin/simple"

fn run_driver(name: text, source: text) -> (text, i64):
    """Write a one-file driver and run it through the Simple binary. Returns
    (combined stdout+stderr, exit code) — the surfaces a human reads."""
    dir_create_all(DRIVER_DIR)
    val path = DRIVER_DIR + "/" + name + ".spl"
    file_write(path, source)
    val (out, err, code) = process_run(simple_binary(), ["run", path])
    (out + "\n" + err, code)

fn is_darwin_host() -> bool:
    val os = host_os()
    os == "darwin" or os == "macos"

describe "plan: os/multiarch_qemu_systest/aarch64_darwin_contract_snippet remains":

    context "verification checklist (post-merge)":

        it "`bin/simple check src/os/qemu_systest_contract.spl` — no errors":
            step("compile and run a driver that imports the contract module and calls the six aarch64_darwin_* accessors")
            # @req REQ-PLAN-AARCH64-DARWIN-001
            # "no errors" is a tool verdict, so ask the tool: the driver must
            # load the real module through the Simple binary and CALL the
            # accessors (the seed degrades an unresolved import to a
            # `[use-warning]` shim, so a driver that only imports could still
            # exit 0 — calling is what makes the exit code discriminate).
            # Driver sources use wildcard imports on purpose: a `{...}` inside
            # a text literal is string interpolation in Simple, so a braced
            # import list cannot be written into a generated file.
            val driver = "use os.qemu_systest_contract.*\nfn main():\n    print \"markers=\" + aarch64_darwin_markers().len().to_text()\n    print \"timeout=\" + aarch64_darwin_timeout_ms().to_text()\n    print \"args=\" + aarch64_darwin_qemu_args().len().to_text()\n    print \"bin=\" + aarch64_darwin_binary_path()\n    print \"app=\" + aarch64_darwin_app_path()\n    print \"qemu=\" + aarch64_darwin_qemu_bin()\n"
            val (out, code) = run_driver("check_contract", driver)
            # @capture(assertion): out/code are the real Simple binary's own output and exit status for the driver
            expect(code).to_equal(0)  # oracle: exit 0 = the module and every accessor compiled and ran
            expect(out.contains("use-warning")).to_equal(false)  # oracle: a degraded import prints [use-warning]; that is an error the checkbox forbids
            expect(out.contains("E1034")).to_equal(false)  # oracle: E1034 = import degraded to built-in shims (lane rule)
            expect(out).to_contain("markers=5")  # oracle: doc lines 56-62 list exactly five HOSTED_* markers
            expect(out).to_contain("timeout=15000")  # oracle: doc line 65, the 15 s timeout literal
            expect(out).to_contain("args=0")  # oracle: hosted lane spawns no QEMU, so the arg list is empty
            expect(out).to_contain("bin=build/os/darwin-aarch64/simpleos_aarch64_darwin_fs_exec")  # oracle: doc-specified staged binary path
            expect(out).to_contain("app=build/os/darwin-aarch64/hello_world.smf")  # oracle: doc-specified staged app path
            step("control: a driver that CALLS an accessor the module does not provide must not run clean")
            val control = "use os.qemu_systest_contract.*\nfn main():\n    print \"markers=\" + aarch64_darwin_nonexistent_accessor_2026_09_05().len().to_text()\n"
            val (ctl_out, ctl_code) = run_driver("check_contract_control", control)
            val control_ran_clean = ctl_code == 0 and ctl_out.contains("markers=") and not ctl_out.contains("use-warning")
            # @capture control_ran_clean is whether the deliberately broken driver produced a clean run
            expect(control_ran_clean).to_equal(false)  # oracle: if the tool cannot tell a missing accessor from a present one, its exit code proves nothing
            step("assert the in-process accessor values agree with the driver's")
            expect(aarch64_darwin_markers()).to_equal(
                ["HOSTED_FS_READ_OK",
                 "HOSTED_APP_PARSE_OK",
                 "HOSTED_PROCESS_LAUNCH_OK",
                 "HOSTED_EXIT_OK",
                 "TEST PASSED"])  # oracle: doc lines 56-62, the exact five-element HOSTED_* set
            var forbidden = 0u64
            for m in aarch64_darwin_markers():
                if m == "ELF_LOAD_OK" or m == "user-svc-exit:ok" or m == "SMF_WM_GUI_LAUNCH_OK" or m == "NATIVE_GUI_PROCESS_RENDER_OK":
                    forbidden = forbidden + 1u64
            expect(forbidden).to_equal(0u64)  # oracle: the doc explicitly forbids the bare-metal marker set in the hosted lane
            expect(aarch64_darwin_qemu_bin()).to_equal(aarch64_darwin_binary_path())  # oracle: hosted lane executes the binary itself as its "qemu"

        it "`bin/simple check src/os/port/simpleos_multiplatform_build_part2.spl` — no errors":
            step("compile and run a driver that imports the platform catalog module and calls simpleos_platform_targets()")
            # @req REQ-PLAN-AARCH64-DARWIN-002
            val driver = "use os.port.simpleos_multiplatform_build_part2.*\nfn main():\n    val targets = simpleos_platform_targets()\n    var found = 0\n    for t in targets:\n        if t.name == \"aarch64-apple-darwin\":\n            found = found + 1\n    print \"targets=\" + targets.len().to_text()\n    print \"darwin_entries=\" + found.to_text()\n"
            val (out, code) = run_driver("check_part2", driver)
            # @capture(assertion): out/code are the real Simple binary's own output and exit status for the driver
            expect(code).to_equal(0)  # oracle: exit 0 = the catalog module compiled and ran through the tool
            expect(out.contains("use-warning")).to_equal(false)  # oracle: a degraded import is an error the checkbox forbids
            expect(out).to_contain("darwin_entries=1")  # oracle: the snippet appends exactly one aarch64-apple-darwin entry
            step("scan the in-process catalog for the aarch64-apple-darwin entry and pin its concrete fields")
            val targets = simpleos_platform_targets()
            expect(targets.len() >= 7u64).to_equal(true)  # oracle: six pre-existing targets plus the appended darwin entry
            var checked_fields = 0u64
            var i2 = 0u64
            while i2 < targets.len():
                if targets[i2].name == "aarch64-apple-darwin":
                    expect(targets[i2].native_target).to_equal("aarch64-apple-darwin")
                    expect(targets[i2].clang_target).to_equal("aarch64-apple-darwin")
                    expect(targets[i2].platform_slug).to_equal("aarch64-darwin")
                    expect(targets[i2].qemu_system).to_equal("")
                    expect(targets[i2].bits).to_equal(64)  # oracle: doc line ~150, aarch64 is a 64-bit target
                    expect(targets[i2].output).to_equal(aarch64_darwin_binary_path())
                    expect(targets[i2].disk_image_output).to_equal(aarch64_darwin_app_path())
                    checked_fields = checked_fields + 1u64
                i2 = i2 + 1u64
            # non-vacuity: the field block above must have executed exactly once
            expect(checked_fields).to_equal(1u64)  # oracle: doc lines 118-193 insert one entry; zero means the field checks never ran
            # @capture(assertion): the seven per-field equalities and the
            # checked_fields non-vacuity counter are computed by scanning the
            # real catalog return value, not local constants.

        it "`bin/simple test test/03_system/os/qemu/sys_qemu_aarch64_darwin_fs_exec_spec.spl` — RED with missing-media:build/os/darwin-aarch64/simpleos_aarch64_darwin_fs_exec (expected on Linux)":
            step("run the real sibling system spec through the Simple binary and read its own verdict line")
            # @req REQ-PLAN-AARCH64-DARWIN-003
            # The checkbox is about the SIBLING spec's behaviour, so run it.
            # Host-conditional oracle, both branches discriminating:
            #   Linux  — the lane is documented RED there: the sibling must
            #            report ERROR and name the binary path on its own
            #            "MISSING BINARY" line.
            #   darwin — this IS the lane's target OS; the staged binary must
            #            exist and the sibling must go GREEN. A darwin host
            #            without the staged build is honestly RED here.
            val (out, err, code) = process_run(simple_binary(), ["run", SYS_SPEC])
            val combined = out + "\n" + err
            # Evidence for the reader: the sibling's own verdict and diagnostic lines.
            for line in combined.split("\n"):
                if line.starts_with("SPEC FILE VERDICT:") or line.starts_with("[sys_qemu_aarch64_darwin]"):
                    print "[aarch64-darwin-sibling] exit=" + code.to_text() + " " + line
            # @capture(assertion): combined/code are the sibling spec's own printed lines and exit status
            expect(combined.contains("E1034")).to_equal(false)  # oracle: a shimmed run proves nothing (lane rule)
            expect(combined).to_contain("SPEC FILE VERDICT: " + SYS_SPEC)  # oracle: the sibling must have produced its verdict line at all
            if is_darwin_host():
                step("darwin host: the staged binary must exist and the sibling spec must pass")
                expect(file_exists(aarch64_darwin_binary_path())).to_equal(true)  # oracle: doc §build — build/os/darwin-aarch64/ is staged on the target OS
                expect(combined).to_contain("outcome=OK")  # oracle: on its target OS the hosted fs-exec lane is GREEN, not missing-media
                expect(code).to_equal(0)  # oracle: a green sibling run exits 0
            else:
                step("Linux host: the sibling spec must be RED and name the missing binary path")
                expect(combined).to_contain("MISSING BINARY (expected RED on Linux): " + aarch64_darwin_binary_path())  # oracle: the sibling's own diagnostic line, quoting the checkbox's path
                expect(combined).to_contain("outcome=ERROR")  # oracle: checkbox text "RED"
                expect(code == 0).to_equal(false)

        it "the missing-media classification contains the binary path, not a nil/crash":
            step("classify a deliberately bogus kernel path and require the verdict to carry THAT path")
            # @req REQ-PLAN-AARCH64-DARWIN-004
            # A verdict that merely contains the real binary path could be a
            # constant. Feeding a path that cannot exist proves the
            # classification is computed from its argument.
            val bogus = "build/os/darwin-aarch64/does_not_exist_2026-09-05"
            val verdict = run_qemu_systest(
                "aarch64-darwin",
                bogus,
                aarch64_darwin_app_path(),
                aarch64_darwin_qemu_bin(),
                aarch64_darwin_qemu_args(),
                aarch64_darwin_markers(),
                aarch64_darwin_timeout_ms()
            )
            # @capture(assertion): verdict is the live classification for the bogus kernel path
            expect(verdict).to_equal("missing-media:" + bogus)  # oracle: qemu_systest_contract.spl:439 returns SYSTEST_PREFIX_MISSING_MEDIA + kernel_path for the FIRST missing path
            expect(verdict.contains("hello_world.smf")).to_equal(false)  # oracle: kernel_path is checked before image_path, so the image must not be named
            step("classify with the real descriptors and require a non-empty, non-crash verdict")
            val real = run_qemu_systest(
                "aarch64-darwin",
                aarch64_darwin_binary_path(),
                aarch64_darwin_app_path(),
                aarch64_darwin_qemu_bin(),
                aarch64_darwin_qemu_args(),
                aarch64_darwin_markers(),
                aarch64_darwin_timeout_ms()
            )
            # @capture(assertion): real is the live classification for the real descriptors on this host
            expect(real.len() > 0u64).to_equal(true)  # oracle: a nil/crash would yield no classification at all
            val admissible = real.starts_with("missing-media:") or real == "pass"
            expect(admissible).to_equal(true)  # oracle: only the two documented outcomes exist for the hosted lane; boot-fail/nonce/accelerator classes are QEMU-only
            if real.starts_with("missing-media:"):
                expect(real).to_equal("missing-media:" + aarch64_darwin_binary_path())  # oracle: when media is missing the FIRST missing path is the binary, per :439
