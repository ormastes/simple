# @cover src/lib/nogc_sync_mut/web_db_offload/contract.spl 0%
# @req REQ-003 REQ-004 REQ-005 REQ-011 REQ-012 REQ-013 NFR-003 NFR-004 NFR-005 NFR-006 NFR-010

"""Paired ABBA performance comparison acceptance.

Linux and SimpleOS results are separate; absent nginx, h2load, PostgreSQL,
pgbench, OpenSSH, crypto-library, or physical-GPU receipts are hard failures.
"""

use std.spec.*
use std.web_db_offload.contract.{
    GpuWdbWorkKind, GpuWdbDecisionPath, GpuWdbRequest,
    gpu_wdb_default_budget, gpu_wdb_decide
}

fn accelerator_request(kind: GpuWdbWorkKind, batch_bytes: i64,
        generation_current: bool, gpu_available: bool = true) -> GpuWdbRequest:
    GpuWdbRequest(kind: kind, batch_bytes: batch_bytes, queue_depth: 0,
        gpu_available: gpu_available, generation_current: generation_current,
        cpu_fallback_available: true)

# @inline
fn setup_linux_fixture():
    fail("UNRESOLVED ORACLE: pinned Linux benchmark environment and incumbents")

# @inline
fn run_paired_abba():
    fail("UNRESOLVED ORACLE: at least 32 paired ABBA benchmark samples")

# @inline
fn load_benchmark_receipt():
    fail("UNRESOLVED ORACLE: raw JSONL summary manifest hashes CPU RSS errors and latency receipt")

fn check_benchmark_contract():
    fail("UNRESOLVED ORACLE: nginx h2load PostgreSQL pgbench OpenSSH and crypto benchmark contract")

fn check_gpu_admission():
    fail("UNRESOLVED ORACLE: physical GPU crossover correctness and p99 comparison")

fn check_cpu_fallback_selected():
    val unavailable = gpu_wdb_decide(accelerator_request(
        GpuWdbWorkKind.DbVectorSearch, 65536, true, false),
        gpu_wdb_default_budget())
    expect(unavailable.path).to_equal(GpuWdbDecisionPath.CpuFallback)
    expect(unavailable.reason).to_equal("gpu-unavailable")
    expect(unavailable.gpu_hit_count).to_equal(0)
    expect(unavailable.cpu_fallback_count).to_equal(1)

fn check_resource_counters():
    fail("UNRESOLVED ORACLE: web SSR DB SSH crypto CPU and RSS counters")

describe "secure web and database server incumbent comparison":
    describe "REQ-011: bounded accelerator policy before physical admission":
        it "should keep parsing control-plane and small interactive work on CPU":
            step("Keep CPU selected when accelerator admission fails")
            val budget = gpu_wdb_default_budget()
            val control = gpu_wdb_decide(accelerator_request(
                GpuWdbWorkKind.HttpControlPlane, 65536, true), budget)
            expect(control.path).to_equal(GpuWdbDecisionPath.CpuFallback)
            expect(control.reason).to_equal("control-plane-stays-on-cpu")
            val small_query = gpu_wdb_decide(accelerator_request(
                GpuWdbWorkKind.DbScanFilterProject, 1024, true), budget)
            expect(small_query.path).to_equal(GpuWdbDecisionPath.CpuFallback)
            expect(small_query.reason).to_equal("batch-too-small")
            val stale = gpu_wdb_decide(accelerator_request(
                GpuWdbWorkKind.DbVectorSearch, 65536, false), budget)
            expect(stale.path).to_equal(GpuWdbDecisionPath.CpuFallback)
            expect(stale.reason).to_equal("stale-generation")

        it "should expose a GPU candidate only for an eligible coarse batch":
            step("Compare CPU, SIMD, and physical-GPU providers")
            val decision = gpu_wdb_decide(accelerator_request(
                GpuWdbWorkKind.DbVectorSearch, 65536, true),
                gpu_wdb_default_budget())
            expect(decision.path).to_equal(GpuWdbDecisionPath.GpuEvidence)
            expect(decision.reason).to_equal("gpu-evidence")

    describe "REQ-013: reproducible paired comparison":
        it "should compare matched web database SSH SSR and crypto workloads":
            setup_linux_fixture()
            step("Run warm paired ABBA benchmark samples")
            run_paired_abba()
            step("Validate correctness, resource, latency, and throughput receipts")
            load_benchmark_receipt()
            check_benchmark_contract()
            check_resource_counters()

        it "should report unsupported incumbent features without false parity":
            step("Validate correctness, resource, latency, and throughput receipts")
            check_benchmark_contract()

    describe "REQ-011: CPU SIMD and GPU admission":
        it "should retain CPU when physical GPU admission does not improve the crossover":
            step("Keep CPU selected when accelerator admission fails")
            check_cpu_fallback_selected()
            step("Compare CPU, SIMD, and physical-GPU providers")
            check_gpu_admission()
