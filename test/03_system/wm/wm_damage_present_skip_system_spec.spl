"""
## Purpose and audience
Purpose: Prove that WM damage present skip.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
# @manual: primary
REQ-WM-WM-DAMAGE-001
doc/01_research/wm/REQ-WM-WM-DAMAGE-001.md
doc/03_plan/wm/REQ-WM-WM-DAMAGE-001.md
doc/04_architecture/wm/REQ-WM-WM-DAMAGE-001.md
doc/05_design/wm/REQ-WM-WM-DAMAGE-001.md
"""
# @req: REQ-WM-WM-DAMAGE-001


# @cover src/os/compositor/host_compositor_core.spl
# @req REQ-WM-SYS-003
# @gui: headless
"""
As a WM developer I need proof that the compositor's damage/present-skip
mechanics (`host_compositor_core.spl:1698-1713`) actually gate presentation
on real accumulated damage, not just that `render_frame()` returns without
raising. Every example below reads the real composited pixel buffer
(`pure_simple_pixel_buffer()`) and the compositor's own
`skipped_frame_count` bookkeeping, so an implementation that always
presents, always skips, or lets damage in one window bleed a redundant
redraw into another window's untouched pixels cannot pass by declaration.
"""
use std.spec.*
use common.ui.pixel_surface_content_frame.{pixel_surface_content_frame}
use common.window_protocol.geometry.{Size}
use os.compositor.host_compositor_entry.{HostCompositor}
use os.compositor.wm_action_lifecycle.{wm_move_action}
use os.userlib.ipc_protocol.{COMP_CREATE_WINDOW}

# Pinned probe colours: same orange convention as
# `wm_window_lifecycle_system_spec.spl` / `wm_showcase_session_capture_spec.spl`
# for window A, plus a distinct blue for window B so the two windows' pixels
# can never be confused with each other or the desktop background.
val PROBE_COLOR_A: u32 = 0xFFFFA000u32
val PROBE_COLOR_B: u32 = 0xFF00A0FFu32

fn _solid(width: i32, height: i32, color: u32) -> [u32]:
    var pixels: [u32] = []
    var i = 0
    while i < width * height:
        pixels.push(color)
        i = i + 1
    pixels

fn _count_color(pixels: [u32], color: u32) -> i32:
    var count = 0
    var i = 0
    val n = pixels.len()
    while i < n:
        if pixels[i] == color:
            count = count + 1
        i = i + 1
    count

# Content-rect checksum for one window: offset x+4,y+32 per
# `shared_wm_scene_window_content_rect_with_titlebar` (same convention noted
# in `wm_window_lifecycle_system_spec.spl`'s move example).
fn _content_checksum(pixels: [u32], stride: i32, win_x: i32, win_y: i32, win_w: i32, win_h: i32) -> i64:
    val content_x = win_x + 4
    val content_y = win_y + 32
    val content_w = win_w - 8
    val content_h = win_h - 36
    var sum: i64 = 0
    var row = 0
    while row < content_h:
        var col = 0
        while col < content_w:
            val idx = (content_y + row) * stride + (content_x + col)
            if idx >= 0 and idx < pixels.len():
                sum = sum + (pixels[idx] as i64) * ((row * content_w + col + 1) as i64)
            col = col + 1
        row = row + 1
    sum

# Builds a headless compositor with one window whose entire content is
# filled with the pinned probe colour A. Mirrors
# `wm_window_lifecycle_system_spec.spl`'s `_lifecycle_compositor` helper.
fn _single_window_compositor(desktop_w: i32, desktop_h: i32, win_w: i32, win_h: i32) -> HostCompositor:
    var comp = HostCompositor.new_headless(Size.wh(desktop_w, desktop_h))
    comp.apply_bridge_request(
        1, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Damage Window",
        20, 20, win_w, win_h, "", 99, "wm.damage.demo"
    )
    val window_id = comp.windows[0].id
    val content_w = comp.windows[0].w - 8
    val content_h = comp.windows[0].h - 36
    comp.require_external_web_frame(window_id)
    val pixels = _solid(content_w, content_h, PROBE_COLOR_A)
    val frame = pixel_surface_content_frame(
        "{window_id}", "", 0, 0, content_w, content_h, pixels, 1, 1
    )
    comp.set_external_web_frame(window_id, frame)
    comp

# Builds a headless compositor with two non-overlapping windows: A (orange,
# top-left) and B (blue, top-right).
fn _two_window_compositor(desktop_w: i32, desktop_h: i32, win_w: i32, win_h: i32) -> HostCompositor:
    var comp = HostCompositor.new_headless(Size.wh(desktop_w, desktop_h))
    comp.apply_bridge_request(
        1, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Damage Window A",
        20, 20, win_w, win_h, "", 99, "wm.damage.demo.a"
    )
    comp.apply_bridge_request(
        2, 11, COMP_CREATE_WINDOW.to_i64(), 0, "Damage Window B",
        320, 20, win_w, win_h, "", 98, "wm.damage.demo.b"
    )
    val id_a = comp.windows[0].id
    val id_b = comp.windows[1].id
    val content_w = comp.windows[0].w - 8
    val content_h = comp.windows[0].h - 36
    comp.require_external_web_frame(id_a)
    comp.set_external_web_frame(
        id_a, pixel_surface_content_frame("{id_a}", "", 0, 0, content_w, content_h, _solid(content_w, content_h, PROBE_COLOR_A), 1, 1)
    )
    comp.require_external_web_frame(id_b)
    comp.set_external_web_frame(
        id_b, pixel_surface_content_frame("{id_b}", "", 0, 0, content_w, content_h, _solid(content_w, content_h, PROBE_COLOR_B), 1, 1)
    )
    comp

# @manual_section "Damage-driven present skip"
use std.spec.step

describe "WM damage present skip":
    """A headless compositor presents only when real damage has
    accumulated (`host_compositor_core.spl:1698-1713`): a damaged frame
    presents fresh pixels without moving `skipped_frame_count`, a
    no-op frame skips and increments the counter, damage confined to one
    window never disturbs another window's content-rect pixels, and once
    damage returns the skip counter stops climbing."""

    slow_it "a frame with reported damage presents and clears had_damage":
        # @req: REQ-WM-WM-DAMAGE-001
        step("Verify: a frame with reported damage presents and clears had_damage")
        step("Create a compositor with one pinned-colour window (creation itself is damage)")
        var compositor = _single_window_compositor(640, 600, 208, 196)
        val skipped_before = compositor.skipped_frame_count

        step("Present the damaged frame")
        compositor.render_frame()
        val desktop = compositor.pure_simple_pixel_buffer()
        val probe_count = _count_color(desktop, PROBE_COLOR_A)

        step("The frame presented: pixels are visible and the skip counter did not move")
        expect(probe_count).to_be_greater_than(0)
        expect(compositor.skipped_frame_count).to_equal(skipped_before)
        print "wm_damage_present probe_px={probe_count} skipped={compositor.skipped_frame_count}"

    slow_it "a frame with no damage is skipped and skipped_frame_count increments":
        # @req: REQ-WM-WM-DAMAGE-001
        step("Verify: a frame with no damage is skipped and skipped_frame_count increments")
        step("Create and present the initial (damaged) frame")
        var compositor = _single_window_compositor(640, 600, 208, 196)
        compositor.render_frame()
        val skipped_before = compositor.skipped_frame_count

        step("Present again with no state change")
        compositor.render_frame()

        step("The no-op frame was skipped: the counter incremented by exactly one")
        expect(compositor.skipped_frame_count).to_equal(skipped_before + 1)
        print "wm_damage_noop_skip skipped={compositor.skipped_frame_count}"

    slow_it "damage in one window does not force redraw pixels of another":
        # @req: REQ-WM-WM-DAMAGE-001
        step("Verify: damage in one window does not force redraw pixels of another")
        step("Create two non-overlapping windows and present the initial frame")
        var compositor = _two_window_compositor(640, 600, 208, 196)
        compositor.render_frame()
        val win_b = compositor.windows[1]
        val before = compositor.pure_simple_pixel_buffer()
        val before_b_checksum = _content_checksum(before, compositor.width, win_b.x, win_b.y, win_b.w, win_b.h)

        step("Move window A only, damaging just its rect")
        val win_a = compositor.windows[0]
        compositor.apply_wm_action(wm_move_action(win_a.id, win_a.x + 40, win_a.y + 20))
        compositor.render_frame()

        step("Window B's content-rect pixels are byte-identical across the present")
        val after = compositor.pure_simple_pixel_buffer()
        val after_b_checksum = _content_checksum(after, compositor.width, win_b.x, win_b.y, win_b.w, win_b.h)
        expect(after_b_checksum).to_equal(before_b_checksum)
        # Sanity: A's own move really did change the desktop, otherwise this
        # example would pass vacuously because nothing moved at all.
        val before_a_checksum = _content_checksum(before, compositor.width, win_a.x, win_a.y, win_a.w, win_a.h)
        val after_a_checksum = _content_checksum(after, compositor.width, win_a.x, win_a.y, win_a.w, win_a.h)
        assert_true(before_a_checksum != after_a_checksum)
        print "wm_damage_isolated b_before={before_b_checksum} b_after={after_b_checksum} a_before={before_a_checksum} a_after={after_a_checksum}"

    slow_it "skipped_frame_count stops incrementing once damage arrives":
        # @req: REQ-WM-WM-DAMAGE-001
        step("Verify: skipped_frame_count stops incrementing once damage arrives")
        step("Create and present the initial (damaged) frame")
        var compositor = _single_window_compositor(640, 600, 208, 196)
        compositor.render_frame()

        step("Present twice more with no state change: the counter climbs by two")
        compositor.render_frame()
        compositor.render_frame()
        val skipped_after_noops = compositor.skipped_frame_count
        expect(skipped_after_noops).to_be_greater_than(0)

        step("Move the window, then present: damage arrived, so the counter must not move")
        val win = compositor.windows[0]
        compositor.apply_wm_action(wm_move_action(win.id, win.x + 30, win.y + 15))
        compositor.render_frame()
        expect(compositor.skipped_frame_count).to_equal(skipped_after_noops)
        print "wm_damage_stops_skipping skipped={compositor.skipped_frame_count}"
