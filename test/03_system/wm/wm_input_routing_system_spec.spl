"""
## Purpose and audience
Purpose: Prove that WM input routing.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
# @manual: primary
REQ-WM-WM-INPUT-001
doc/01_research/wm/REQ-WM-WM-INPUT-001.md
doc/03_plan/wm/REQ-WM-WM-INPUT-001.md
doc/04_architecture/wm/REQ-WM-WM-INPUT-001.md
doc/05_design/wm/REQ-WM-WM-INPUT-001.md
"""
# @req: REQ-WM-WM-INPUT-001


# @cover src/os/compositor/host_gui_event_router.spl
# @cover src/os/compositor/host_compositor_core.spl
# @req REQ-WM-SYS-004
# @gui: headless
"""
As a WM developer I need proof that `HostGuiEventRouter` really turns desktop
pixel coordinates into the client-local coordinates a GUI session receives --
not just that `route()` returns a boolean. Every example below reads
`router.last_local_x` / `last_local_y` (the exact values the router hands to
`session.dispatch(UIEvent.MouseEvent(...))`) and the `route()` boolean itself,
against real `HostCompositor` window geometry, so a router that silently
mis-offsets a click, routes it to the wrong window, or keeps routing it to a
window that has moved away cannot pass by declaration.
"""
use std.spec.*
use common.io.window_event.{
    WINDOW_ACTION_PRESS,
    WINDOW_EVENT_POINTER_BUTTON,
    WINDOW_EVENT_POINTER_MOVE,
    WindowEventRecord,
    window_event_pointer,
}
use common.ui.builder.{build_tree, column, text_field, with_height}
use common.window_protocol.geometry.{Size}
use nogc_sync_mut.ui.session.{UISession}
use os.compositor.host_compositor_entry.{HostCompositor, HeadlessHostCompositorBackend, SimpleOsGuiAdapter}
use os.compositor.host_gui_event_router.{HostGuiEventRouter}
use os.compositor.wm_action_lifecycle.{wm_move_action}
use os.userlib.ipc_protocol.{COMP_CREATE_WINDOW}

fn _move_event(seq: i64, x: i32, y: i32) -> WindowEventRecord:
    window_event_pointer(
        1, seq, seq, WINDOW_EVENT_POINTER_MOVE,
        x.to_i64() * 1000, y.to_i64() * 1000, 0, 0
    )

fn _button_event(seq: i64, x: i32, y: i32, down: bool) -> WindowEventRecord:
    window_event_pointer(
        1, seq, seq, WINDOW_EVENT_POINTER_BUTTON,
        x.to_i64() * 1000, y.to_i64() * 1000,
        if down: WINDOW_ACTION_PRESS else: 0, 0
    )

# Minimal client-side tree: routing only needs a UISession that accepts
# `dispatch()` without crashing, not any particular widget reaction.
fn _routing_session() -> UISession:
    val tree = build_tree(column("root", [
        with_height(text_field("name", "", "Name"), 24)
    ]))
    UISession.new(tree)

# @manual_section "Input routing"
use std.spec.step

describe "WM input routing":
    """A headless compositor's windows are clicked, moved, and overlapped;
    every example checks `HostGuiEventRouter`'s real translated coordinates
    and routed-or-not boolean against known window geometry, never against
    "the call didn't crash"."""

    slow_it "desktop coordinates translate to client coordinates through the router":
        # @req: REQ-WM-WM-INPUT-001
        step("Verify: desktop coordinates translate to client coordinates through the router")
        step("Create a 640x600 compositor with one window at (40,40,300,300)")
        var compositor = HostCompositor.new_headless(Size.wh(640, 600))
        compositor.apply_bridge_request(
            1, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Routing Window",
            40, 40, 300, 300, "", 99, "wm.input.routing.demo"
        )
        val window_id = compositor.windows[0].id
        var router = HostGuiEventRouter.new(window_id)
        var session = _routing_session()

        step("Move the pointer to a desktop point inside the content rect (44,72)-(336,336)")
        val routed = router.route(_move_event(1, 100, 150), compositor, session)
        expect(routed).to_be(true)
        assert_equal(router.last_local_x, 56)
        assert_equal(router.last_local_y, 78)
        print "wm_input_translate local_x={router.last_local_x} local_y={router.last_local_y}"

    slow_it "clicks outside every window hit the desktop, not a client":
        # @req: REQ-WM-WM-INPUT-001
        step("Verify: clicks outside every window hit the desktop, not a client")
        step("Same single-window compositor; the window's content rect ends at (336,336)")
        var compositor = HostCompositor.new_headless(Size.wh(640, 600))
        compositor.apply_bridge_request(
            1, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Routing Window",
            40, 40, 300, 300, "", 99, "wm.input.routing.desktop.demo"
        )
        val window_id = compositor.windows[0].id
        var router = HostGuiEventRouter.new(window_id)
        var session = _routing_session()

        step("Move, press, and release at (500,500) -- well outside the window rect")
        val move_routed = router.route(_move_event(1, 500, 500), compositor, session)
        val press_routed = router.route(_button_event(2, 500, 500, true), compositor, session)
        val release_routed = router.route(_button_event(3, 500, 500, false), compositor, session)
        assert_false(move_routed)
        assert_false(press_routed)
        assert_false(release_routed)
        # Both directions: the same point INSIDE the window rect must still
        # route, proving `route()` isn't just returning false unconditionally.
        val inside_routed = router.route(_move_event(4, 100, 150), compositor, session)
        assert_true(inside_routed)
        print "wm_input_desktop_only move={move_routed} press={press_routed} release={release_routed} inside={inside_routed}"

    slow_it "a moved window receives clicks at its new position and not its old one":
        # @req: REQ-WM-WM-INPUT-001
        step("Verify: a moved window receives clicks at its new position and not its old one")
        step("Create a 900x600 compositor with one window at (40,40,300,300)")
        var compositor = HostCompositor.new_headless(Size.wh(900, 600))
        compositor.apply_bridge_request(
            1, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Routing Window",
            40, 40, 300, 300, "", 99, "wm.input.routing.move.demo"
        )
        val window_id = compositor.windows[0].id
        var router = HostGuiEventRouter.new(window_id)
        var session = _routing_session()
        # old_only sits in the original content rect (44,72)-(336,336) only.
        val old_only_x = 100
        val old_only_y = 150
        # new_only sits in the post-move content rect (344,72)-(636,336) only
        # -- outside the original rect, which ends at x=336.
        val new_only_x = 400
        val new_only_y = 150

        step("Before the move: old_only routes, new_only does not")
        assert_true(router.route(_move_event(1, old_only_x, old_only_y), compositor, session))
        assert_false(router.route(_move_event(2, new_only_x, new_only_y), compositor, session))

        step("Move the window to (340,40) -- new content rect starts at x=344")
        compositor.apply_wm_action(wm_move_action(window_id, 340, 40))

        step("After the move: old_only no longer routes, new_only now does at the correct local coords")
        assert_false(router.route(_move_event(3, old_only_x, old_only_y), compositor, session))
        val new_routed = router.route(_move_event(4, new_only_x, new_only_y), compositor, session)
        assert_true(new_routed)
        assert_equal(router.last_local_x, new_only_x - 344)
        assert_equal(router.last_local_y, new_only_y - 72)
        print "wm_input_moved new_routed={new_routed} new_local_x={router.last_local_x} new_local_y={router.last_local_y}"

    slow_it "pointer-events pass through a window region marked non-interactive":
        # @req: REQ-WM-WM-INPUT-001
        step("Verify: pointer-events pass through a window region marked non-interactive")
        """`HostedWindow` carries a window-local-content-coordinate
        `passthrough_x/y/w/h` dead rect, set via
        `HostCompositor.set_window_pointer_passthrough`, that
        `HostGuiEventRouter.update_client_target` skips when hit-testing --
        a click landing inside a window's declared dead rect falls through
        to whatever window is underneath instead of being claimed by the
        (topmost) window that owns the rect. This example marks the topmost
        window's overlap corner as its dead rect and checks that a click
        there is claimed by the window underneath, not the topmost window.
        See doc/08_tracking/bug/wm_hit_test_pointer_events_missing_2026-08.md.
        """
        step("Two overlapping windows: A (bottom) and B (top, overlap corner meant to be click-through)")
        var compositor = HostCompositor.new_headless(Size.wh(640, 600))
        compositor.apply_bridge_request(
            1, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Window A",
            20, 20, 300, 300, "", 99, "wm.input.routing.passthrough.a"
        )
        val a_id = compositor.windows[0].id
        compositor.apply_bridge_request(
            2, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Window B",
            160, 160, 300, 300, "", 99, "wm.input.routing.passthrough.b"
        )
        val b_id = compositor.windows[1].id
        var router_a = HostGuiEventRouter.new(a_id)
        var router_b = HostGuiEventRouter.new(b_id)
        var session = _routing_session()
        # Overlap of A's content rect (24,52)-(316,316) and B's content rect
        # (164,192)-(456,456): (164,192)-(316,316).
        val overlap_x = 220
        val overlap_y = 230

        step("Mark B's overlap corner (B-local (0,0)-(152,124)) as click-through")
        compositor.set_window_pointer_passthrough(b_id, 0, 0, 152, 124)

        step("A click in the declared-non-interactive overlap corner of B should fall through to A")
        val routed_to_a = router_a.route(_move_event(1, overlap_x, overlap_y), compositor, session)
        val routed_to_b = router_b.route(_move_event(2, overlap_x, overlap_y), compositor, session)
        # B (topmost, created last) declared its overlap corner click-through,
        # so the hit-test in update_client_target skips B there and A (the
        # window underneath) claims the click instead.
        assert_true(routed_to_a)
        assert_false(routed_to_b)
        print "wm_input_passthrough routed_to_a={routed_to_a} routed_to_b={routed_to_b}"

    slow_it "a passthrough dead rect survives a pointer move delivered through the SimpleOS GUI adapter":
        # @req: REQ-WM-WM-INPUT-001
        step("Verify: a passthrough dead rect survives a pointer move delivered through the SimpleOS GUI adapter")
        """`SimpleOsGuiAdapter.deliver_pointer_move` -- the on-device path a
        real SimpleOS pointer-move IPC event takes -- calls the lower-level
        `host_compositor_pointer_move` directly, bypassing
        `HostCompositor.pointer_move`'s own call chain. That free function
        round-trips window state through `WmLifecycleWindowState`, which
        doesn't carry `passthrough_x/y/w/h`, so a naive implementation would
        silently erase a window's declared click-through region on the very
        first pointer move delivered through the adapter -- even though the
        same erasure was already fixed for `HostCompositor.pointer_move`
        directly. This example marks a dead rect, delivers a pointer move
        through the adapter (not through `HostCompositor.pointer_move`
        directly), and checks routing still falls through to the window
        underneath afterward.
        See doc/08_tracking/bug/wm_hit_test_pointer_events_missing_2026-08.md.
        """
        step("Two overlapping windows behind a SimpleOsGuiAdapter: A (bottom) and B (top)")
        val backend = HeadlessHostCompositorBackend.new(640, 600)
        var adapter = SimpleOsGuiAdapter.new(backend, Size.wh(640, 600))
        adapter.compositor.apply_bridge_request(
            1, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Window A",
            20, 20, 300, 300, "", 99, "wm.input.routing.adapter.passthrough.a"
        )
        val a_id = adapter.compositor.windows[0].id
        adapter.compositor.apply_bridge_request(
            2, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Window B",
            160, 160, 300, 300, "", 99, "wm.input.routing.adapter.passthrough.b"
        )
        val b_id = adapter.compositor.windows[1].id
        var router_a = HostGuiEventRouter.new(a_id)
        var router_b = HostGuiEventRouter.new(b_id)
        var session = _routing_session()
        # Same overlap geometry as the direct-call example above.
        val overlap_x = 220
        val overlap_y = 230

        step("Mark B's overlap corner (B-local (0,0)-(152,124)) as click-through")
        adapter.compositor.set_window_pointer_passthrough(b_id, 0, 0, 152, 124)

        step("Deliver a pointer move THROUGH THE ADAPTER (not HostCompositor.pointer_move directly)")
        adapter.deliver_pointer_move(overlap_x, overlap_y)

        step("The dead rect must still be honored after the adapter-path move: A claims the click, not B")
        val routed_to_a = router_a.route(_move_event(1, overlap_x, overlap_y), adapter.compositor, session)
        val routed_to_b = router_b.route(_move_event(2, overlap_x, overlap_y), adapter.compositor, session)
        assert_true(routed_to_a)
        assert_false(routed_to_b)
        print "wm_input_adapter_passthrough routed_to_a={routed_to_a} routed_to_b={routed_to_b}"

    slow_it "a maximized window's maximized/restore_* fields survive a pointer move, through both call paths":
        # @req: REQ-WM-WM-INPUT-001
        step("Verify: a maximized window's maximized/restore_* fields survive a pointer move, through both call paths")
        """`host_compositor_pointer_move` round-trips window state through
        `WmLifecycleWindowState`, which -- like `passthrough_x/y/w/h` --
        doesn't carry `maximized`/`restore_x/y/w/h` either. A naive fix that
        only restores the passthrough family would leave a maximized window's
        `maximized` flag reset to false and its `restore_*` geometry zeroed
        out on the very first pointer move after maximizing, so a later
        unmaximize would restore the window to (0,0,0,0) instead of its
        pre-maximize rect. This example maximizes a window, delivers a
        pointer move through BOTH `HostCompositor.pointer_move` (the direct
        call path apply_wm_action already gets right) AND
        `SimpleOsGuiAdapter.deliver_pointer_move` (the on-device IPC path,
        which calls `host_compositor_pointer_move` directly), and checks the
        maximize/restore bookkeeping survives each.
        See doc/08_tracking/bug/wm_hit_test_pointer_events_missing_2026-08.md.
        """
        step("A window, maximized directly on HostCompositor")
        var compositor = HostCompositor.new(HeadlessHostCompositorBackend.new(640, 600), Size.wh(640, 600))
        compositor.apply_bridge_request(
            1, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Window A",
            20, 20, 300, 300, "", 99, "wm.input.routing.maximize.a"
        )
        val a_id = compositor.windows[0].id
        compositor.maximize_window(a_id)
        val before = compositor.windows[0]
        assert_true(before.maximized)
        assert_equal(before.restore_x, 20)
        assert_equal(before.restore_y, 20)
        assert_equal(before.restore_w, 300)
        assert_equal(before.restore_h, 300)

        step("Deliver a pointer move through HostCompositor.pointer_move")
        compositor.pointer_move(50, 50)
        val after_direct = compositor.windows[0]
        assert_true(after_direct.maximized)
        assert_equal(after_direct.restore_x, 20)
        assert_equal(after_direct.restore_y, 20)
        assert_equal(after_direct.restore_w, 300)
        assert_equal(after_direct.restore_h, 300)
        print "wm_maximize_survives_pointer_move maximized={after_direct.maximized} restore_x={after_direct.restore_x} restore_y={after_direct.restore_y} restore_w={after_direct.restore_w} restore_h={after_direct.restore_h}"

        step("A second window, maximized then moved through the SimpleOS GUI adapter's on-device path")
        val backend = HeadlessHostCompositorBackend.new(640, 600)
        var adapter = SimpleOsGuiAdapter.new(backend, Size.wh(640, 600))
        adapter.compositor.apply_bridge_request(
            2, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Window B",
            40, 40, 250, 250, "", 99, "wm.input.routing.maximize.adapter.b"
        )
        val b_id = adapter.compositor.windows[0].id
        adapter.compositor.maximize_window(b_id)
        val before_b = adapter.compositor.windows[0]
        assert_true(before_b.maximized)
        assert_equal(before_b.restore_x, 40)
        assert_equal(before_b.restore_y, 40)
        assert_equal(before_b.restore_w, 250)
        assert_equal(before_b.restore_h, 250)

        step("Deliver a pointer move THROUGH THE ADAPTER (not HostCompositor.pointer_move directly)")
        adapter.deliver_pointer_move(60, 60)
        val after_adapter = adapter.compositor.windows[0]
        assert_true(after_adapter.maximized)
        assert_equal(after_adapter.restore_x, 40)
        assert_equal(after_adapter.restore_y, 40)
        assert_equal(after_adapter.restore_w, 250)
        assert_equal(after_adapter.restore_h, 250)
        print "wm_maximize_survives_adapter_pointer_move maximized={after_adapter.maximized} restore_x={after_adapter.restore_x} restore_y={after_adapter.restore_y} restore_w={after_adapter.restore_w} restore_h={after_adapter.restore_h}"

        step("Unmaximize now restores to the ORIGINAL rect, not (0,0,0,0)")
        adapter.compositor.restore_window(b_id)
        val restored_b = adapter.compositor.windows[0]
        assert_false(restored_b.maximized)
        assert_equal(restored_b.x, 40)
        assert_equal(restored_b.y, 40)
        assert_equal(restored_b.w, 250)
        assert_equal(restored_b.h, 250)
        print "wm_maximize_unmaximize_after_pointer_move x={restored_b.x} y={restored_b.y} w={restored_b.w} h={restored_b.h}"
