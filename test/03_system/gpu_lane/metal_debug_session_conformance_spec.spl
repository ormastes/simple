# Metal DBG-1 / PROF-1 conformance: the D3 debug vector table, run on a LIVE
# Metal device through the real svmg_metal_kernel.metal, diffed FIELD FOR
# FIELD against the host reference VM (ref_vm.spl) for the same vector.
#
# Stream P8. Twin of vulkan_debug_session_conformance_spec.spl (Metal is
# architecturally closer to Vulkan than to CUDA: a pipeline is built once at
# init and then dispatched, with no resident submode).
#
# ===========================================================================
# THIS SPEC HAS NEVER RUN ITS DEVICE BRANCH -- AND CANNOT, HERE
# ===========================================================================
# The repo's hosts are Linux. `rt_metal_is_available()` is behind
# `#[cfg(target_os = "macos")]` in the Rust runtime, so it hard-returns false
# and `MetalLaneSession.probe()` returns "skip:metal-unavailable-not-macos".
# Everything below the probe is therefore UNREACHED here. That skip is
# CORRECT: it is not a failure to repair, and a fabricated device result
# would be strictly worse than no result. Nothing in this file is evidence
# that the Metal kernel computes correct debug state. Tracked in
# doc/08_tracking/bug/metal_gpu_lane_device_verification_pending_2026-08-09.md.
#
# HOW A READER TELLS WHICH BRANCH RAN
# -----------------------------------
# Both branches PRINT a line: "[metal_debug_session_conformance] SKIPPED: ..."
# or "... DEVICE-RAN: ...". `print`, not `step(...)` -- step text is swallowed
# on a PASSING run, i.e. invisible exactly on the green run being interpreted
# (found independently by N3 and P13). Grep for `SKIPPED:` / `DEVICE-RAN:`.
#
# WHY THE DIFF IS AGAINST ref_vm AND NOT ONLY THE TABLE
# -----------------------------------------------------
# The vector table carries expected values, and ref_vm_debug_spec.spl asserts
# them host-side. What THIS spec adds is cross-engine equivalence: the device
# kernel is a completely separate implementation of the same semantics, so
# every field is checked twice -- against the declared expectation, and
# against what ref_vm actually produced. A shared misreading of the table
# cannot pass both.
#
# FRESH SESSION PER VECTOR -- DELIBERATE
# --------------------------------------
# A vector that exercises budget expiry drives the lane's timeout path, which
# latches dispatch state by design. Each vector gets its own session so that
# latch can never be mistaken for a kernel defect.

use std.spipe.*
use std.common.debug.session_core.{AttachOpts}
use std.common.svmg.assembler.{svmg_asm}
use std.common.svmg.mailbox_const.{
    DEFAULT_LOG_CAP, DBG_FLAG_ENABLED, DBG_FLAG_RESUME, DBG_FLAG_SINGLE_STEP,
}
use std.common.svmg.ref_vm.{
    build_arena, run_arena, dbg_set_flags, dbg_set_breakpoints,
    dbg_read_saved_pc, dbg_read_saved_sp, dbg_read_saved_csp,
    dbg_read_step_count, dbg_read_saved_stack_slot, dbg_read_saved_call_slot,
    read_log, read_records,
}
use std.gc_async_mut.gpu_lane.metal_debug_session.{MetalDebugSession, MetalDebugOutcome}
use std.gc_async_mut.gpu_lane.metal_lane_session.{MetalLaneSession}
use std.sffi.io.{file_read_text}
use std.common.test_env_gate.{test_env_available}
use test.fixtures.svmg.debug_conformance_vectors.{DebugVector, DebugLaunch, all_debug_vectors}

# MSL SOURCE, not a compiled artifact -- Metal compiles the kernel at runtime
# through rt_metal_compile_shader, and there is no offline metal/metallib
# toolchain on a non-macOS build host. This is the ONE structural difference
# from the .ptx/.spv siblings.
val _KERNEL_MSL_PATH: text = "src/lib/gc_async_mut/gpu_lane/svmg_metal_kernel.metal"

# The one skip reason this host is expected to produce. Any other skip string
# stays visible as its own value rather than being accepted as equivalent.
val _EXPECTED_HOST_SKIP: text = "skip:metal-unavailable-not-macos"

# The one vector whose stop reason the Metal lane layer cannot surface; see
# the long note at its use site.
val _BUDGET_EXPIRY_VECTOR: text = "budget_expiry_while_debugging"

fn _probe() -> text:
    var session = MetalLaneSession.create()
    session.probe()

# Opt-in strictness switch. Default (unset/"0") keeps this spec host-aware
# skip-clean. SIMPLE_REQUIRE_GPU=1 turns a skip into a FAILURE so CI or a
# human can DEMAND real device evidence. The value reaches this body only
# because the runner BYPASSES the light daemon when it is set
# (test_runner_client.spl); the daemon's environment is frozen, so a bare
# read would observe it as unset and fail OPEN.
fn _require_gpu() -> bool:
    test_env_available("SIMPLE_REQUIRE_GPU")

# Positive device proof: on a skipping host the device launch count is 0, so
# this floor CANNOT be satisfied by the skip branch.
val _MIN_DEVICE_LAUNCHES: i64 = 20

# --- host reference: replay one launch through ref_vm on `arena_in` -------
struct RefLaunchResult:
    arena: [u8]
    debug_break: bool
    trapped: bool
    timed_out: bool
    sentinel: i64
    saved_pc: i64
    saved_sp: i64
    saved_csp: i64
    stack: [i64]
    calls: [i64]
    step_count: i64
    log_text: text

fn _ref_launch(code: [u8], arena_in: [u8], lch: DebugLaunch) -> RefLaunchResult:
    var arena = arena_in
    if lch.set_breakpoints:
        arena = dbg_set_breakpoints(arena, lch.breakpoints)
    var flags = DBG_FLAG_ENABLED
    if lch.resume:
        flags = flags | DBG_FLAG_RESUME
    if lch.single_step:
        flags = flags | DBG_FLAG_SINGLE_STEP
    arena = dbg_set_flags(arena, flags)

    val r = run_arena(code, arena)
    val out = r.arena
    val sp = dbg_read_saved_sp(out)
    val csp = dbg_read_saved_csp(out)
    var stack: [i64] = []
    var i = 0
    while i < sp:
        stack.push(dbg_read_saved_stack_slot(out, i))
        i = i + 1
    var calls: [i64] = []
    i = 0
    while i < csp:
        calls.push(dbg_read_saved_call_slot(out, i))
        i = i + 1
    RefLaunchResult(
        arena: out, debug_break: r.debug_break, trapped: r.trapped,
        timed_out: r.timed_out, sentinel: r.sentinel,
        saved_pc: dbg_read_saved_pc(out), saved_sp: sp, saved_csp: csp,
        stack: stack, calls: calls, step_count: dbg_read_step_count(out),
        log_text: read_log(out),
    )

# --- the field-for-field diff -------------------------------------------
fn _diff_device_vs_ref(vname: text, li: i64, dev: MetalDebugOutcome, ref_r: RefLaunchResult, lch: DebugLaunch):
    # 1. device vs the DECLARED expectation
    assert_equal(dev.debug_break, lch.expect_debug_break)
    assert_equal(dev.trapped, lch.expect_trapped)
    assert_equal(dev.timed_out, lch.expect_timed_out)
    assert_equal(dev.sentinel, lch.expect_sentinel)
    assert_equal(dev.saved_pc, lch.expect_saved_pc)
    assert_equal(dev.saved_sp, lch.expect_saved_sp)
    assert_equal(dev.saved_csp, lch.expect_saved_csp)
    assert_equal(dev.step_count, lch.expect_step_count)
    assert_equal(dev.log_text, lch.expect_log)

    # 2. device vs the REFERENCE VM, field for field
    assert_equal(dev.debug_break, ref_r.debug_break)
    assert_equal(dev.trapped, ref_r.trapped)
    assert_equal(dev.timed_out, ref_r.timed_out)
    assert_equal(dev.sentinel, ref_r.sentinel)
    assert_equal(dev.saved_pc, ref_r.saved_pc)
    assert_equal(dev.saved_sp, ref_r.saved_sp)
    assert_equal(dev.saved_csp, ref_r.saved_csp)
    assert_equal(dev.step_count, ref_r.step_count)
    assert_equal(dev.log_text, ref_r.log_text)

    # 3. saved operand stack and call stack, slot by slot
    assert_equal(dev.stack.len(), lch.expect_stack.len())
    assert_equal(dev.stack.len(), ref_r.stack.len())
    var i = 0
    while i < lch.expect_stack.len() and i < dev.stack.len():
        assert_equal(dev.stack[i], lch.expect_stack[i])
        i = i + 1
    i = 0
    while i < ref_r.stack.len() and i < dev.stack.len():
        assert_equal(dev.stack[i], ref_r.stack[i])
        i = i + 1

    assert_equal(dev.calls.len(), lch.expect_calls.len())
    assert_equal(dev.calls.len(), ref_r.calls.len())
    i = 0
    while i < lch.expect_calls.len() and i < dev.calls.len():
        assert_equal(dev.calls[i], lch.expect_calls[i])
        i = i + 1
    i = 0
    while i < ref_r.calls.len() and i < dev.calls.len():
        assert_equal(dev.calls[i], ref_r.calls[i])
        i = i + 1

    # 4. RECORD ring -- the thing a rewound record_count would corrupt
    assert_equal(dev.records.len(), lch.expect_records.len())
    i = 0
    while i < lch.expect_records.len() and i < dev.records.len():
        assert_equal(dev.records[i].passed, lch.expect_records[i].passed)
        assert_equal(dev.records[i].value, lch.expect_records[i].value)
        i = i + 1
    print "[metal_debug_session_conformance] DEVICE-RAN: diffed {vname}/launch{li}: device == declared == ref_vm on every field"

describe "MetalDebugSession -- DBG-1/PROF-1 debug vectors on a live device":
    """
    Runs every D3 debug conformance vector's full launch SEQUENCE (break,
    inspect, resume, single-step) through the real svmg_metal_kernel.metal on
    a live Metal device, and diffs each launch field-for-field against both
    the declared expectation and the host reference VM. Skips cleanly, and
    says so, on any host without Metal.
    """

    it "should ship an MSL kernel and a non-empty debug vector table on every host":
        # Runs EVERYWHERE, including this Linux host -- so this file is not
        # purely a skip. It checks the two inputs the device branch depends
        # on, which are host-readable even though the device is not.
        val kernel_msl = file_read_text(_KERNEL_MSL_PATH)
        expect(kernel_msl.len()).to_be_greater_than(1000)
        # The MSL entry point the pipeline is created for must be present in
        # the source. This is a TEXT check, not a compile: there is no MSL
        # compiler on this host, so a syntax error elsewhere in the kernel
        # remains invisible here. See the tracking doc.
        expect(kernel_msl.contains("svmg_interpret")).to_equal(true)
        val vectors = all_debug_vectors()
        expect(vectors.len()).to_be_greater_than(0)

    it "should skip cleanly, or match ref_vm on every debug vector field":
        val probe_result = _probe()

        if probe_result.starts_with("skip:"):
            print "[metal_debug_session_conformance] SKIPPED: {probe_result} -- the DEVICE-RAN branch did NOT run"
            if _require_gpu():
                assert_equal("SKIPPED: " + probe_result, "DEVICE-RAN: metal")
            expect(probe_result).to_equal(_EXPECTED_HOST_SKIP)
        else:
            print "[metal_debug_session_conformance] DEVICE-RAN: probe() returned no skip reason; the live-device branch is executing"
            val kernel_msl = file_read_text(_KERNEL_MSL_PATH)
            expect(kernel_msl.len()).to_be_greater_than(0)

            val vectors = all_debug_vectors()
            expect(vectors.len()).to_be_greater_than(0)
            var checked = 0

            for v in vectors:
                step("Vector: " + v.name)
                # Fresh session per vector -- see the header note on the
                # dispatch-timeout latch.
                var sess = MetalDebugSession.create()
                val opts = AttachOpts(
                    step_budget: v.step_budget, entry_pc: v.entry_pc,
                    log_cap: DEFAULT_LOG_CAP, profile: true)
                val err = sess.attach_kernel(kernel_msl, v.source, opts)
                assert_equal(err, "")

                val code = svmg_asm(v.source)
                var ref_arena = build_arena(code, [], v.step_budget, v.entry_pc, DEFAULT_LOG_CAP)

                if v.name == _BUDGET_EXPIRY_VECTOR:
                    # NOT a skip, and NOT a kernel defect: an explicit,
                    # asserted statement of a known LANE-LAYER limitation,
                    # the exact Metal analogue of the CUDA and Vulkan ones.
                    #
                    # The kernel correctly writes SENTINEL_TIMEOUT
                    # (0xDEAD0000) on budget exhaustion -- a normal, expected
                    # SVM-G outcome. But MetalLaneSession decodes that same
                    # sentinel as a DEVICE timeout
                    # (METAL_LANE_TIMEOUT_SENTINEL is the same constant), so
                    # the SVM-G budget sentinel is indistinguishable from a
                    # real device hang at the lane layer.
                    #
                    # Asserting the exact failure mode (rather than skipping)
                    # means this test goes RED the moment the conflation is
                    # fixed, which is when the real diff below should start
                    # running. Do NOT "fix" the lane to make this pass.
                    print "[metal_debug_session_conformance] DEVICE-RAN: known lane-layer limitation -- SVM-G budget sentinel is read as a device timeout"
                    val lone = v.launches[0]
                    val devt = sess.launch(lone.resume, lone.single_step, lone.set_breakpoints, lone.breakpoints)
                    assert_true(devt.timed_out or not devt.ok)
                    sess.shutdown()
                    continue

                var li = 0
                for lch in v.launches:
                    val dev = sess.launch(lch.resume, lch.single_step, lch.set_breakpoints, lch.breakpoints)
                    assert_equal(dev.error, "")
                    assert_true(dev.ok)
                    val ref_r = _ref_launch(code, ref_arena, lch)
                    ref_arena = ref_r.arena
                    _diff_device_vs_ref(v.name, li, dev, ref_r, lch)
                    li = li + 1
                    checked = checked + 1

                val shut = sess.shutdown()
                assert_equal(shut, "")

            print "[metal_debug_session_conformance] DEVICE-RAN: total launches diffed device-vs-ref: {checked}"
            expect(checked).to_be_greater_than(0)
            # Launch-count floor -- unreachable from the skip branch (count 0).
            expect(checked).to_be_greater_than(_MIN_DEVICE_LAUNCHES - 1)
