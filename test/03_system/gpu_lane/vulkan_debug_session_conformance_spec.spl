# Vulkan DBG-1 / PROF-1 conformance: the D3 debug vector table, run on a LIVE
# Vulkan device through the real svmg_vulkan_kernel.spv, diffed FIELD FOR
# FIELD against the host reference VM (ref_vm.spl) for the same vector.
#
# WHY THE DIFF IS AGAINST ref_vm AND NOT ONLY THE TABLE
# -----------------------------------------------------
# The vector table already carries expected values, and the ref-VM spec
# (test/01_unit/lib/svmg/ref_vm_debug_spec.spl) asserts them host-side. What
# THIS spec adds is the cross-engine equivalence that neither of those can
# see: the device kernel is a completely separate implementation of the same
# semantics, so every field is checked twice -- once against the declared
# expectation, and once against what ref_vm actually produced. A shared
# misreading of the table cannot pass both.
#
# This is the Vulkan twin of cuda_debug_session_conformance_spec.spl. Until
# it existed, the Vulkan kernel's DBG-1/PROF-1 code was validated only by
# spirv-val and by mirroring ref_vm.spl -- the two green Vulkan gates run
# with DBG_FLAGS == 0 and prove INERTNESS ONLY. See
# doc/08_tracking/bug/vulkan_vm_executor_missing_run_source_persisting_data_blocks_dbg1_resume_2026-08-09.md
#
# FRESH SESSION PER VECTOR -- DELIBERATE
# --------------------------------------
# A vector that exercises budget expiry drives the lane's timeout path, which
# latches dispatch state by design. Each vector gets its own session so that
# latch can never be mistaken for a kernel defect (and so it is never "fixed"
# away).

use std.spipe.*
use std.common.debug.session_core.{AttachOpts}
use std.common.svmg.assembler.{svmg_asm}
use std.common.svmg.mailbox_const.{
    DEFAULT_LOG_CAP, DBG_FLAG_ENABLED, DBG_FLAG_RESUME, DBG_FLAG_SINGLE_STEP,
}
use std.common.svmg.ref_vm.{
    build_arena, run_arena, dbg_set_flags, dbg_set_breakpoints,
    dbg_read_saved_pc, dbg_read_saved_sp, dbg_read_saved_csp,
    dbg_read_step_count, dbg_read_saved_stack_slot, dbg_read_saved_call_slot,
    read_log, read_records,
}
use std.gc_async_mut.gpu_lane.vulkan_debug_session.{VulkanDebugSession, VulkanDebugOutcome}
use std.gc_async_mut.gpu_lane.vulkan_lane_session.{VulkanLaneSession}
use std.sffi.io.{file_read_bytes}
use std.common.test_env_gate.{test_env_available}
use std.gc_async_mut.gpu_lane.lane_probe_verdict.{
    gpu_lane_probe_verdict, gpu_lane_probe_verdict_reason, gpu_lane_report_skip}
use test.fixtures.svmg.debug_conformance_vectors.{DebugVector, DebugLaunch, all_debug_vectors}

val _KERNEL_SPV: text = "src/lib/gc_async_mut/gpu_lane/svmg_vulkan_kernel.spv"

# The one vector whose stop reason the Vulkan lane layer cannot surface; see
# the long note at its use site.
val _BUDGET_EXPIRY_VECTOR: text = "budget_expiry_while_debugging"

fn _probe() -> text:
    var session = VulkanLaneSession.create()
    session.probe()

# Opt-in strictness switch. Default (unset/"0") keeps this spec host-aware
# skip-clean so it stays green on machines with no GPU. Setting
# SIMPLE_REQUIRE_GPU=1 turns a skip into a FAILURE, so CI or a human can
# DEMAND real device evidence rather than accepting an ambiguous green.
fn _require_gpu() -> bool:
    test_env_available("SIMPLE_REQUIRE_GPU")

# Positive device proof: on a skipping host the device launch count is 0, so
# this floor CANNOT be satisfied by the skip branch.
val _MIN_DEVICE_LAUNCHES: i64 = 20

# --- host reference: replay one launch through ref_vm on `arena_in` -------
struct RefLaunchResult:
    arena: [u8]
    debug_break: bool
    trapped: bool
    timed_out: bool
    sentinel: i64
    saved_pc: i64
    saved_sp: i64
    saved_csp: i64
    stack: [i64]
    calls: [i64]
    step_count: i64
    log_text: text

fn _ref_launch(code: [u8], arena_in: [u8], lch: DebugLaunch) -> RefLaunchResult:
    var arena = arena_in
    if lch.set_breakpoints:
        arena = dbg_set_breakpoints(arena, lch.breakpoints)
    var flags = DBG_FLAG_ENABLED
    if lch.resume:
        flags = flags | DBG_FLAG_RESUME
    if lch.single_step:
        flags = flags | DBG_FLAG_SINGLE_STEP
    arena = dbg_set_flags(arena, flags)

    val r = run_arena(code, arena)
    val out = r.arena
    val sp = dbg_read_saved_sp(out)
    val csp = dbg_read_saved_csp(out)
    var stack: [i64] = []
    var i = 0
    while i < sp:
        stack.push(dbg_read_saved_stack_slot(out, i))
        i = i + 1
    var calls: [i64] = []
    i = 0
    while i < csp:
        calls.push(dbg_read_saved_call_slot(out, i))
        i = i + 1
    RefLaunchResult(
        arena: out, debug_break: r.debug_break, trapped: r.trapped,
        timed_out: r.timed_out, sentinel: r.sentinel,
        saved_pc: dbg_read_saved_pc(out), saved_sp: sp, saved_csp: csp,
        stack: stack, calls: calls, step_count: dbg_read_step_count(out),
        log_text: read_log(out),
    )

# --- the field-for-field diff -------------------------------------------
fn _diff_device_vs_ref(vname: text, li: i64, dev: VulkanDebugOutcome, ref_r: RefLaunchResult, lch: DebugLaunch):
    val tag = "{vname}/launch{li}"

    # 1. device vs the DECLARED expectation
    assert_equal(dev.debug_break, lch.expect_debug_break)
    assert_equal(dev.trapped, lch.expect_trapped)
    assert_equal(dev.timed_out, lch.expect_timed_out)
    assert_equal(dev.sentinel, lch.expect_sentinel)
    assert_equal(dev.saved_pc, lch.expect_saved_pc)
    assert_equal(dev.saved_sp, lch.expect_saved_sp)
    assert_equal(dev.saved_csp, lch.expect_saved_csp)
    assert_equal(dev.step_count, lch.expect_step_count)
    assert_equal(dev.log_text, lch.expect_log)

    # 2. device vs the REFERENCE VM, field for field
    assert_equal(dev.debug_break, ref_r.debug_break)
    assert_equal(dev.trapped, ref_r.trapped)
    assert_equal(dev.timed_out, ref_r.timed_out)
    assert_equal(dev.sentinel, ref_r.sentinel)
    assert_equal(dev.saved_pc, ref_r.saved_pc)
    assert_equal(dev.saved_sp, ref_r.saved_sp)
    assert_equal(dev.saved_csp, ref_r.saved_csp)
    assert_equal(dev.step_count, ref_r.step_count)
    assert_equal(dev.log_text, ref_r.log_text)

    # 3. saved operand stack and call stack, slot by slot
    assert_equal(dev.stack.len(), lch.expect_stack.len())
    assert_equal(dev.stack.len(), ref_r.stack.len())
    var i = 0
    while i < lch.expect_stack.len() and i < dev.stack.len():
        assert_equal(dev.stack[i], lch.expect_stack[i])
        i = i + 1
    i = 0
    while i < ref_r.stack.len() and i < dev.stack.len():
        assert_equal(dev.stack[i], ref_r.stack[i])
        i = i + 1

    assert_equal(dev.calls.len(), lch.expect_calls.len())
    assert_equal(dev.calls.len(), ref_r.calls.len())
    i = 0
    while i < lch.expect_calls.len() and i < dev.calls.len():
        assert_equal(dev.calls[i], lch.expect_calls[i])
        i = i + 1
    i = 0
    while i < ref_r.calls.len() and i < dev.calls.len():
        assert_equal(dev.calls[i], ref_r.calls[i])
        i = i + 1

    # 4. RECORD ring -- the thing a rewound record_count would corrupt
    assert_equal(dev.records.len(), lch.expect_records.len())
    i = 0
    while i < lch.expect_records.len() and i < dev.records.len():
        assert_equal(dev.records[i].passed, lch.expect_records[i].passed)
        assert_equal(dev.records[i].value, lch.expect_records[i].value)
        i = i + 1
    step("diffed {tag}: device == declared == ref_vm on every field")

describe "VulkanDebugSession -- DBG-1/PROF-1 debug vectors on a live device":
    """
    Runs every D3 debug conformance vector's full launch SEQUENCE (break,
    inspect, resume, single-step) through the real svmg_vulkan_kernel.spv on
    a live Vulkan device, and diffs each launch field-for-field against both
    the declared expectation and the host reference VM.
    """
    it "should skip cleanly, or match ref_vm on every debug vector field":
        step("Probe for a Vulkan-capable device")
        val probe_result = _probe()

        # SELF-DESCRIBING EVIDENCE: a green used to be ambiguous -- it proved
        # either that a device ran clean OR that no device existed. Both
        # branches now EMIT which one they took, so the verdict names its own
        # evidence (the assert message carries it even when step() is not
        # surfaced by the runner).
        if probe_result.starts_with("skip:"):
            step("SKIPPED: no usable Vulkan device/ICD on this host: " + probe_result)
            if _require_gpu():
                step("SIMPLE_REQUIRE_GPU=1 -- a skip is a FAILURE in this lane")
                assert_equal("SKIPPED: " + probe_result, "DEVICE-RAN: vulkan")
            # Fail closed independently of SIMPLE_REQUIRE_GPU. The old
            # `assert_true(probe_result.starts_with("skip:"))` passed BECAUSE
            # the probe skipped, so unless the operator remembered the env var
            # a device-less run was indistinguishable from a real one.
            step(gpu_lane_probe_verdict_reason("vulkan", probe_result))
            gpu_lane_report_skip("vulkan debug session lane", probe_result)
            assert_equal(gpu_lane_probe_verdict("vulkan", probe_result), "skip")
        else:
            step("DEVICE-RAN: vulkan -- probe() returned no skip reason; the live-device branch is executing")
            step("Load the checked-in svmg_vulkan_kernel.spv artifact")
            val kernel_bytes = file_read_bytes(_KERNEL_SPV)
            expect(kernel_bytes.len()).to_be_greater_than(0)

            val vectors = all_debug_vectors()
            expect(vectors.len()).to_be_greater_than(0)
            var checked = 0

            for v in vectors:
                step("Vector: " + v.name)
                # Fresh session per vector -- see the header note on the
                # dispatch-timeout latch.
                var sess = VulkanDebugSession.create()
                val opts = AttachOpts(
                    step_budget: v.step_budget, entry_pc: v.entry_pc,
                    log_cap: DEFAULT_LOG_CAP, profile: true)
                val err = sess.attach_kernel(kernel_bytes, v.source, opts)
                assert_equal(err, "")

                val code = svmg_asm(v.source)
                var ref_arena = build_arena(code, [], v.step_budget, v.entry_pc, DEFAULT_LOG_CAP)

                if v.name == _BUDGET_EXPIRY_VECTOR:
                    # NOT a skip, and NOT a kernel defect: an explicit,
                    # asserted statement of a known LANE-LAYER limitation,
                    # the exact Vulkan analogue of the CUDA one.
                    #
                    # The kernel correctly writes SENTINEL_TIMEOUT (0xDEAD0000)
                    # on budget exhaustion -- a normal, expected SVM-G
                    # outcome. But VulkanLaneSession decodes that same
                    # sentinel as a DEVICE timeout
                    # (VULKAN_LANE_TIMEOUT_SENTINEL is the same constant), so
                    # the SVM-G budget sentinel is indistinguishable from a
                    # real device hang at the lane layer.
                    #
                    # Asserting the exact failure mode (rather than skipping)
                    # means this test goes RED the moment the conflation is
                    # fixed, which is when the real diff below should start
                    # running. Do NOT "fix" the lane to make this pass -- it
                    # is deliberate, and the existing D3 conformance spec
                    # skips its own budget vector for the same reason.
                    step("Known lane-layer limitation: SVM-G budget sentinel is read as a device timeout")
                    val lone = v.launches[0]
                    val devt = sess.launch(lone.resume, lone.single_step, lone.set_breakpoints, lone.breakpoints)
                    assert_true(devt.timed_out or not devt.ok)
                    sess.shutdown()
                    continue

                var li = 0
                for lch in v.launches:
                    val dev = sess.launch(lch.resume, lch.single_step, lch.set_breakpoints, lch.breakpoints)
                    assert_equal(dev.error, "")
                    assert_true(dev.ok)
                    val ref_r = _ref_launch(code, ref_arena, lch)
                    ref_arena = ref_r.arena
                    _diff_device_vs_ref(v.name, li, dev, ref_r, lch)
                    li = li + 1
                    checked = checked + 1

                val shut = sess.shutdown()
                assert_equal(shut, "")

            step("DEVICE-RAN: vulkan -- total launches diffed device-vs-ref: {checked}")
            expect(checked).to_be_greater_than(0)
            # Launch-count floor -- unreachable from the skip branch (count 0).
            expect(checked).to_be_greater_than(_MIN_DEVICE_LAUNCHES - 1)
