"""
## Purpose and audience
Purpose: contains exactly 5 rows
Audience: compiler and tooling engineers who maintain this spec

# GPU Lane Matrix Status System Spec
# @session:mutating
#
# @cover src/lib/nogc_sync_mut/test_runner/gpu_lane_common.spl 60%
#
# Task E2 of doc/03_plan/agent_tasks/gpu_remote_interpreter_parallel_plan_2026-08-07.md.
#
# Extends the `remote_baremetal_lane_status_spec.spl` style (row-per-lane
# descriptor + readiness-probing assertions) to the 5 GPU remote-interpreter
# lanes from design §7 (`doc/05_design/runtime/gpu_remote_interpreter_architecture.md`):
# `cuda_jit`, `cuda_vm`, `cuda_vm_resident`, `vulkan_jit`, `vulkan_vm`. Full
# lane detail (executor/spec file paths, current per-host status) lives in
# `doc/08_tracking/lane_matrix.md`; this spec only asserts the
# skip:/blocked: readiness-probing CONTRACT (A3's `route_gpu_lane`), not the
# real executors themselves (those have their own dedicated specs — see the
# lane matrix doc).
#
# Portability requirement (plan §6 E2 "Verify"): the pure-function scenarios
# below pin `driver_present: false` explicitly, so they assert the
# no-GPU-host contract (every GPU lane reports `skip:`) regardless of what
# hardware the host actually running this spec has. A separate host-aware
# `slow_it` block probes the REAL host and reports informationally — it never
# hard-requires `skip:` on a host that does have GPU hardware, since
# `route_gpu_lane` legitimately does not return skip on such a host (see the
# "generic routing not wired to real executors" gap noted in
# doc/08_tracking/lane_matrix.md and filed as a bug).
"""

# @req: REQ-GPU_LANE-GpuLaneMatrStat-001

use std.test_runner.gpu_lane_common.{
    route_gpu_lane, gpu_required_symbols, gpu_driver_probe_cmd,
    probe_gpu_driver_present, probe_gpu_symbols
}
use std.gc_async_mut.gpu_lane.cuda_resident_session.{resident_refusal_gate, WATCHDOG_UNKNOWN, WATCHDOG_DISABLED, WATCHDOG_ENABLED}
use std.io_runtime.{env_get}


class GpuLaneRow:
    """One row of the GPU lane matrix (design §7 table), for status-spec use."""
    lane_id: text
    spec_string: text
    backend: text
    submode: text


fn gpu_lane_matrix_rows() -> [GpuLaneRow]:
    """The 5 GPU lanes from design §7 — kept in the same order as the table
    in doc/08_tracking/lane_matrix.md and the design doc."""
    [
        GpuLaneRow(lane_id: "cuda_jit", spec_string: "jit(remote(cuda(sm80)))", backend: "cuda", submode: "launch"),
        GpuLaneRow(lane_id: "cuda_vm", spec_string: "interpreter(remote(cuda(sm80)))", backend: "cuda", submode: "launch"),
        GpuLaneRow(lane_id: "cuda_vm_resident", spec_string: "interpreter(remote(cuda(sm80(resident))))", backend: "cuda", submode: "resident"),
        GpuLaneRow(lane_id: "vulkan_jit", spec_string: "jit(remote(vulkan(spv15)))", backend: "vulkan", submode: "dispatch"),
        GpuLaneRow(lane_id: "vulkan_vm", spec_string: "interpreter(remote(vulkan(spv15)))", backend: "vulkan", submode: "dispatch"),
    ]


# ============================================================================
# GpuLaneRow — matrix shape
# ============================================================================

use std.spec.step
describe "GpuLaneRow matrix (design §7)":
    it "contains exactly 5 rows":
        step("Verify: contains exactly 5 rows")
        # @req: REQ-GPU_LANE-GpuLaneMatrStat-001
        expect(gpu_lane_matrix_rows().len()).to_equal(5)  # oracle: value fixed by the spec contract

    it "has 3 cuda rows and 2 vulkan rows":
        step("Verify: has 3 cuda rows and 2 vulkan rows")
        # @req: REQ-GPU_LANE-GpuLaneMatrStat-001
        val rows = gpu_lane_matrix_rows()
        var cuda_count = 0
        var vulkan_count = 0
        for row in rows:
            if row.backend == "cuda": cuda_count = cuda_count + 1
            if row.backend == "vulkan": vulkan_count = vulkan_count + 1
        expect(cuda_count).to_equal(3)  # oracle: value fixed by the spec contract
        expect(vulkan_count).to_equal(2)  # oracle: value fixed by the spec contract

    it "has exactly one resident-submode row":
        step("Verify: has exactly one resident-submode row")
        # @req: REQ-GPU_LANE-GpuLaneMatrStat-001
        val rows = gpu_lane_matrix_rows()
        var resident_count = 0
        for row in rows:
            if row.submode == "resident": resident_count = resident_count + 1
        expect(resident_count).to_equal(1)  # oracle: value fixed by the spec contract

    it "matches design §7's exact spec strings":
        step("Verify: matches design §7's exact spec strings")
        # @req: REQ-GPU_LANE-GpuLaneMatrStat-001
        val rows = gpu_lane_matrix_rows()
        expect(rows[0].spec_string).to_equal("jit(remote(cuda(sm80)))")
        expect(rows[1].spec_string).to_equal("interpreter(remote(cuda(sm80)))")
        expect(rows[2].spec_string).to_equal("interpreter(remote(cuda(sm80(resident))))")
        expect(rows[3].spec_string).to_equal("jit(remote(vulkan(spv15)))")
        expect(rows[4].spec_string).to_equal("interpreter(remote(vulkan(spv15)))")


# ============================================================================
# Readiness-probing contract: no-GPU-host portability (plan §6 E2 Verify bar)
# ============================================================================

describe "GPU lane matrix readiness probing (no-GPU host contract)":
    """Pins driver_present: false so this scenario asserts the same contract
    on every host, independent of whatever GPU hardware the runner has."""

    it "reports skip: for every one of the 5 GPU lane rows when no driver/ICD is present":
        step("Verify: reports skip: for every one of the 5 GPU lane rows when no driver/ICD is present")
        # @req: REQ-GPU_LANE-GpuLaneMatrStat-001
        val rows = gpu_lane_matrix_rows()
        for row in rows:
            val result = route_gpu_lane(file_path: "lane_matrix:{row.lane_id}", setup_ms: 0,
                remote_backend: row.backend, driver_present: false, missing_symbol: "")
            expect(result.skipped).to_equal(1)  # oracle: value fixed by the spec contract
            expect(result.failed).to_equal(0)  # oracle: value fixed by the spec contract
            expect(result.error.starts_with("skip:")).to_equal(true)

    it "reports blocked: <symbol> for every row when a required rt_* symbol is unresolved, taking precedence over skip":
        step("Verify: reports blocked: <symbol> for every row when a required rt_* symbol is unresolved, taking precedence over skip")
        # @req: REQ-GPU_LANE-GpuLaneMatrStat-001
        val rows = gpu_lane_matrix_rows()
        for row in rows:
            val symbols = gpu_required_symbols(row.backend)
            expect(symbols.len() > 0).to_equal(true)
            val result = route_gpu_lane(file_path: "lane_matrix:{row.lane_id}", setup_ms: 0,
                remote_backend: row.backend, driver_present: false, missing_symbol: symbols[0])
            expect(result.skipped).to_equal(0)  # oracle: value fixed by the spec contract
            expect(result.failed).to_equal(1)  # oracle: value fixed by the spec contract
            expect(result.error).to_equal("blocked: {symbols[0]}")

    it "every row's backend has a non-empty driver probe command":
        step("Verify: every row's backend has a non-empty driver probe command")
        # @req: REQ-GPU_LANE-GpuLaneMatrStat-001
        val rows = gpu_lane_matrix_rows()
        for row in rows:
            expect(gpu_driver_probe_cmd(row.backend) != "").to_equal(true)


# ============================================================================
# cuda_vm_resident's extra gate (B4 design §5.3) — the one row with novel
# logic beyond A3's generic route_gpu_lane contract.
# ============================================================================

describe "cuda_vm_resident's extra watchdog-refusal gate (B4, design §5.3)":
    it "refuses when the watchdog attribute is unavailable (fail-safe: unknown is never assumed safe)":
        step("Verify: refuses when the watchdog attribute is unavailable (fail-safe: unknown is never assumed safe)")
        # @req: REQ-GPU_LANE-GpuLaneMatrStat-001
        expect(resident_refusal_gate(WATCHDOG_UNKNOWN, "0")).to_start_with("refuse:")

    it "refuses when the watchdog is enabled":
        step("Verify: refuses when the watchdog is enabled")
        # @req: REQ-GPU_LANE-GpuLaneMatrStat-001
        expect(resident_refusal_gate(WATCHDOG_ENABLED, "0")).to_start_with("refuse:")

    it "proceeds when the watchdog is confirmed disabled":
        step("Verify: proceeds when the watchdog is confirmed disabled")
        # @req: REQ-GPU_LANE-GpuLaneMatrStat-001
        expect(resident_refusal_gate(WATCHDOG_DISABLED, "0")).to_equal("")

    it "proceeds when CUDA_RESIDENT_FORCE=1 overrides an unknown watchdog attribute":
        step("Verify: proceeds when CUDA_RESIDENT_FORCE=1 overrides an unknown watchdog attribute")
        # @req: REQ-GPU_LANE-GpuLaneMatrStat-001
        expect(resident_refusal_gate(WATCHDOG_UNKNOWN, "1")).to_equal("")


# ============================================================================
# Real host-aware probe — informational only, matches remote_baremetal's
# "probes all lanes without crashing" style. Never hard-requires skip:,
# since a host WITH GPU hardware legitimately does not get skip: from
# route_gpu_lane today (see doc/08_tracking/lane_matrix.md's routing gap
# note) -- this only asserts the probe completes and returns a well-formed
# TestFileResult (never crashes, never silently blank).
# ============================================================================

describe "Real host probe (informational)":
    slow_it "probes every GPU lane row on this host without crashing":
        step("Verify: probes every GPU lane row on this host without crashing")
        # @req: REQ-GPU_LANE-GpuLaneMatrStat-001
        val rows = gpu_lane_matrix_rows()
        for row in rows:
            val missing_symbol = probe_gpu_symbols(row.backend)
            val driver_present = if missing_symbol != "": false else: probe_gpu_driver_present(row.backend)
            val result = route_gpu_lane(file_path: "lane_matrix:{row.lane_id}", setup_ms: 0,
                remote_backend: row.backend, driver_present: driver_present, missing_symbol: missing_symbol)
            # Well-formed: exactly one of skipped/failed is 1, never both, never neither.
            expect(result.skipped + result.failed).to_equal(1)  # oracle: value fixed by the spec contract
            expect(result.error.len() > 0).to_equal(true)
