# @req: REQ-IO_AUDIO-AUDIO-Q15-001


# @req REQ-001 REQ-004 REQ-005
"""Q15 audio work has deterministic bounds, convolution, checksum, and parity."""

use std.spec.*
use std.common.engine.audio.simple_audio_q15.*

use std.spec.step

describe "Simple audio Q15 work":
    it "rejects empty and oversized work before dispatch":
        # @req: REQ-IO_AUDIO-AUDIO-Q15-001 REQ-004 REQ-005
        # @req: REQ-001
        step("Verify: rejects empty and oversized work before dispatch")
        expect(simple_audio_q15_work_status([], [32768u32])).to_equal("empty-audio-work")
        expect(simple_audio_q15_work_status([32768u32], [])).to_equal("empty-audio-work")

    it "computes signed Q15 convolution with a deterministic checksum":
        # @req: REQ-IO_AUDIO-AUDIO-Q15-001
        step("Verify: computes signed Q15 convolution with a deterministic checksum")
        val result = simple_audio_q15_convolve_reference([32768u32, 16384u32, 4294959104u32], [16384u32, 8192u32])
        expect(result.len()).to_equal(4)  # oracle: 4 — pinned expected value for this behavior
        expect(simple_audio_q15_decode(result[0])).to_equal(16384)  # oracle: 16384 — pinned expected value for this behavior
        expect(simple_audio_q15_decode(result[1])).to_equal(16384)  # oracle: 16384 — pinned expected value for this behavior
        expect(simple_audio_q15_decode(result[2])).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(simple_audio_q15_decode(result[3])).to_equal(-2048)  # oracle: -2048 — pinned expected value for this behavior
        expect(simple_audio_q15_checksum(result)).to_be_greater_than(0)

    it "detects exact and divergent device readback":
        # @req: REQ-IO_AUDIO-AUDIO-Q15-001
        step("Verify: detects exact and divergent device readback")
        val reference = [1u32, 2u32, 3u32]
        expect(simple_audio_q15_max_error_millionths(reference, reference)).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(simple_audio_q15_max_error_millionths(reference, [1u32, 2u32])).to_equal(1000000)  # oracle: 1000000 — pinned expected value for this behavior
        expect(simple_audio_q15_max_error_millionths(reference, [1u32, 2u32, 100u32])).to_be_greater_than(10)
