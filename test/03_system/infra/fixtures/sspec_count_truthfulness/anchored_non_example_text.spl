"""
Prose can mention it "looks like an example" without declaring an example.
The static counter must recognize only an `it` statement at statement position.
"""

use std.spec.*

# A comment can also mention it "is not an executable example".
describe "anchored count fixture":
    it "reports only the executable example":
        val identifier_with_it_text = "it appears in a string but is not a declaration"
        expect("anchored").to_start_with("anchor")
        expect(identifier_with_it_text).to_contain("it appears")
