class Box:
    n: i64

    me bump(s: text):
        self.n = self.n + s.len()

struct Cell:
    n: i64

    me bump(s: text):
        self.n = self.n + s.len()

class Holder:
    inner: Box
    cell: Cell

fn main():
    var b = Box(n: 2)
    b.bump("xyz")
    var c = Cell(n: 2)
    c.bump("xyz")
    var h = Holder(inner: Box(n: 2), cell: Cell(n: 2))
    h.inner.bump("xyz")
    h.cell.bump("xyz")
    var arr = [Box(n: 2)]
    arr[0].bump("xyz")
    var carr = [Cell(n: 2)]
    carr[0].bump("xyz")
    print "b={b.n} c={c.n} hi={h.inner.n} hc={h.cell.n} a={arr[0].n} ca={carr[0].n}"
