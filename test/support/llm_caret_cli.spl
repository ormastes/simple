# Shared launcher for specs that drive the llm_caret CLI as a child process.
# The same scenarios run against the interpreter
# (`<simple> run src/app/llm_caret/main.spl <args>`) and, when env
# LLM_CARET_NATIVE_BIN names a prebuilt native binary, against that binary.
use std.io_runtime.{env_get}

val CARET_MAIN = "src/app/llm_caret/main.spl"

fn caret_native_bin() -> text:
    env_get("LLM_CARET_NATIVE_BIN") ?? ""

# Program to spawn: the native binary when the knob is set, else `simple_bin`.
fn caret_cli_program(simple_bin: text) -> text:
    val native = caret_native_bin()
    if native != "":
        return native
    simple_bin

# Argument vector for `caret_cli_program`: caret's own args, prefixed with
# `run <main.spl>` only on the interpreter lane.
fn caret_cli_args(args: [text]) -> [text]:
    if caret_native_bin() != "":
        return args
    ["run", CARET_MAIN] + args

export caret_native_bin, caret_cli_program, caret_cli_args
