# Shared helpers for the dense DevHub Messenger encrypted-database test layers.
#
# The database is test/fixtures/database/sqlcipher4/dense_multipage.sqlcipher4,
# generated by gen_dense_messenger_fixture.py with a PUBLIC synthetic passphrase
# (see dense_ground_truth.json).  Expected values are read from that ground-truth
# file, which Python's sqlite3/hashlib/json produced -- never from the code under
# test.
use std.io_runtime.{env_get_opt, file_read_bytes_result, file_hash_sha256_or_empty}
use std.env.{env_set, env_unset}
use std.common.json.value.{
    JsonValue, json_parse_value, json_value_field, json_value_items, json_value_at,
    json_value_len, json_value_text_or
}
use std.nogc_sync_mut.io.file_ops.{file_read}
use app.devhub.messenger.config.{MessengerTarget, MessengerPolicy, MessengerDbConfig}
use app.devhub.messenger.schema_profile.{SchemaProfile}
use app.devhub.messenger.plugin_access.{MessengerPortResult}

val DENSE_DIR: text = "test/fixtures/database/sqlcipher4/"
val DENSE_BASE: text = "dense_multipage.sqlcipher4"
val DENSE_REF: text = "secret://messenger/dense"
val DENSE_ENV: text = "SIMPLE_SECRET_MESSENGER_DENSE"
val DENSE_TRUTH_PATH: text = "test/fixtures/database/sqlcipher4/dense_ground_truth.json"

fn lb() -> text:
    "{"

fn rb() -> text:
    "}"

fn dense_path(name: text) -> text:
    DENSE_DIR + name

# Ground truth parsed once by the caller (`val truth = dense_truth()`).
fn dense_truth() -> JsonValue:
    val raw: text = file_read(DENSE_TRUTH_PATH)
    match json_parse_value(raw):
        case Ok(value): value
        case Err(_): JsonValue.Null

fn tf(node: JsonValue, key: text) -> text:
    json_value_text_or(json_value_field(node, key), "")

fn tn(node: JsonValue, key: text) -> i64:
    match json_value_field(node, key):
        case JsonValue.Int(value): value
        case _: -1

fn truth_passphrase(truth: JsonValue) -> text:
    tf(truth, "passphrase")

fn dense_set_secret(value: text) -> bool:
    env_set(DENSE_ENV, value)

fn dense_unset_secret() -> bool:
    env_unset(DENSE_ENV)

fn dense_file_bytes(name: text) -> [u8]:
    match file_read_bytes_result(dense_path(name)):
        case Ok(bytes): bytes
        case Err(_): []

fn dense_schema() -> SchemaProfile:
    SchemaProfile(profile_id: "messenger.schema_profile.v1",
        room_table: "room", room_id: "id", room_name: "title", room_created_at: "created_at",
        member_table: "room_member", member_room_id: "room_id", member_identity_id: "user_id",
        member_joined_at: "joined_at", member_left_at: "", member_role: "",
        message_table: "messages", message_id: "id", message_room_id: "room_id",
        message_sender_id: "sender_id", message_body: "body", message_created_at: "created_at",
        message_updated_at: "", message_sequence: "seq", message_reply_to_id: "reply_to_id",
        timestamp_unit: "s", sequence_kind: "monotonic_within_room")

fn dense_target_with(path: text, secret_ref: text, expose_bodies: bool) -> MessengerTarget:
    val db = MessengerDbConfig(path: path, format: "sqlcipher4", access: "read_only",
        snapshot_mode: "frozen_snapshot", profile: "sqlcipher4_4k_sha512", key_kind: "passphrase",
        secret_ref: secret_ref, cipher_page_size: 4096, cipher_kdf_iter: 256000,
        cipher_kdf_algorithm: "pbkdf2_hmac_sha512", cipher_hmac_algorithm: "hmac_sha512",
        cipher_page_hmac: true, cipher_hmac_pgno: "little_endian", cipher_reserved_bytes: 80,
        cipher_plaintext_header_bytes: 0, immutable: true)
    var policy = MessengerPolicy.deny_all()
    policy.expose_message_body_to_agents = expose_bodies
    MessengerTarget(name: "dense-public-fixture", read_provider: "sqlcipher4_database",
        send_provider: "none", send_enabled: false, source_kind: "external_owned_by_messenger",
        schema_profile_name: "messenger.schema_profile.v1", content_pipeline: "none",
        cache_mode: "none", sync_policy: "on_demand", db: db, api: nil,
        schema: dense_schema(), policy: policy)

fn dense_target(file_name: text) -> MessengerTarget:
    dense_target_with(dense_path(file_name), DENSE_REF, false)

# One-line outcome of a port result: status:exit:payload-empty?
fn outcome_line(r: MessengerPortResult) -> text:
    val empty = if r.payload == "": "empty" else: "payload"
    "{r.status}:{r.exit_code}:{empty}"

# Expected history payload built from ground-truth message objects (json.dumps
# output) in ground-truth order, truncated to `limit` rows (limit > count = all).
fn expected_history(truth: JsonValue, room: text, limit: i64) -> text:
    val order = json_value_field(json_value_field(truth, "history_order"), room)
    val objects = json_value_field(truth, "message_object")
    val overflow = json_value_field(truth, "overflow")
    val total = json_value_len(order)
    var take = total
    if limit < total:
        take = limit
    var body = ""
    var i = 0
    while i < take:
        val id = match json_value_at(order, i):
            case JsonValue.Int(value): "{value}"
            case _: ""
        if i > 0:
            body = body + ","
        if id == "15":
            body = body + expected_overflow_object(overflow)
        else:
            body = body + tf(objects, id)
        i = i + 1
    lb() + "\"room\":\"" + room + "\",\"messages\":[" + body + "],\"count\":" + "{take}" + rb()

fn expected_overflow_object(overflow: JsonValue) -> text:
    val repeat = tn(overflow, "repeat")
    val unit = tf(overflow, "unit")
    var middle = ""
    var i = 0
    while i < repeat:
        middle = middle + unit
        i = i + 1
    tf(overflow, "object_head") + middle + tf(overflow, "object_tail")

# Text form of one ground-truth cell.
fn cell_at(table: JsonValue, row: i64, col: i64) -> text:
    json_value_text_or(json_value_at(json_value_at(json_value_field(table, "rows"), row), col), "")

fn rows_in(table: JsonValue) -> i64:
    json_value_len(json_value_field(table, "rows"))

fn cols_in(table: JsonValue) -> i64:
    json_value_len(json_value_field(table, "columns"))

export DENSE_DIR, DENSE_BASE, DENSE_REF, DENSE_ENV
export lb, rb, dense_path, dense_truth, tf, tn, truth_passphrase
export dense_set_secret, dense_unset_secret, dense_file_bytes
export dense_schema, dense_target_with, dense_target, outcome_line
export expected_history, expected_overflow_object, cell_at, rows_in, cols_in

# ---- codec-level helpers (one key session serves many page checks) ----------

use nogc_sync_mut.database.codec.codec_registry.{CodecSessionV1}
use nogc_sync_mut.database.codec.sqlcipher4.{sqlcipher4_error_code}
use nogc_sync_mut.database.codec.sqlcipher4_page.{
    sqlcipher4_page_open_key, sqlcipher4_page_decode_with_session, sqlcipher4_page1_salt
}

val AUTH_CODE: text = "SQLCIPHER4_AUTHENTICATION_FAILED"
val GEOMETRY_CODE: text = "SQLCIPHER4_INVALID_PAGE_GEOMETRY"

# Copy of page `n` (1-based) of a whole-file byte image; push-built so no alias.
fn page_slice(file: [u8], n: i64) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < 4096 and (n - 1) * 4096 + i < file.len():
        out.push(file[(n - 1) * 4096 + i])
        i = i + 1
    out

# Copy of `page` with one byte XOR-flipped; the caller's array is untouched.
fn page_flipped(page: [u8], offset: i64) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < page.len():
        if i == offset:
            out.push(page[i] ^ 1u8)
        else:
            out.push(page[i])
        i = i + 1
    out

# Key session over the file's own page-1 salt; the secret env var must be set.
fn dense_session(file: [u8]) -> CodecSessionV1?:
    match sqlcipher4_page1_salt(page_slice(file, 1)):
        case Ok(salt):
            match sqlcipher4_page_open_key(DENSE_REF, salt):
                case Ok(session): Some(session)
                case Err(_): nil
        case Err(_): nil

# "OK:<plaintext length>" or the stable error code of the rejection.
fn decode_verdict(page_no: i64, page: [u8], session: CodecSessionV1) -> text:
    match sqlcipher4_page_decode_with_session(page_no, page, session):
        case Ok(body): "OK:{body.len()}"
        case Err(problem): sqlcipher4_error_code(problem)

fn be32(bytes: [u8], at: i64) -> i64:
    bytes[at].to_i64() * 16777216 + bytes[at + 1].to_i64() * 65536 + bytes[at + 2].to_i64() * 256 + bytes[at + 3].to_i64()

export AUTH_CODE, GEOMETRY_CODE, page_slice, page_flipped, dense_session, decode_verdict, be32

# Plaintext page body, or [] when the page is rejected.
fn decode_body(page_no: i64, page: [u8], session: CodecSessionV1) -> [u8]:
    match sqlcipher4_page_decode_with_session(page_no, page, session):
        case Ok(body): body
        case Err(_): []

# i-th integer of a ground-truth array stored under node[key], -1 when absent.
fn list_int(node: JsonValue, key: text, index: i64) -> i64:
    match json_value_at(json_value_field(node, key), index):
        case JsonValue.Int(value): value
        case _: -1

# SHA-256 (hex) of a committed fixture file, "" when unreadable.
fn dense_file_sha256(name: text) -> text:
    file_hash_sha256_or_empty(dense_path(name))

export decode_body, list_int, dense_file_sha256

# ---- storage-port helpers --------------------------------------------------

use std.database.server.storage_port.{
    database_storage_port_v1, DatabaseStoragePortV1, StorageOpenResult
}

# "OK|" after opening and releasing the view, or "<CODE>|<message>" on rejection.
fn port_verdict(path: text, format_name: text, secret_ref: text) -> text:
    val port: DatabaseStoragePortV1 = database_storage_port_v1()
    match port.open(path, format_name, secret_ref):
        case Ok(opened):
            match opened:
                case StorageOpenResult.SqliteView(view):
                    val _wiped = port.close_view(view)
                    "OK|"
                case StorageOpenResult.NativeStore(_):
                    "NATIVE|"
        case Err(problem):
            "{problem.code()}|{problem.message()}"

fn verdict_code(verdict: text) -> text:
    val cut = verdict.index_of("|") ?? 0
    verdict.substring(0, cut)

fn verdict_message(verdict: text) -> text:
    val cut = verdict.index_of("|") ?? -1
    verdict.substring(cut + 1, verdict.len())

# port_verdict under a temporary secret value, then the public one is restored.
fn port_verdict_with_secret(secret: text, path: text, secret_ref: text, public_secret: text) -> text:
    val _set = dense_set_secret(secret)
    val verdict = port_verdict(path, "sqlcipher4", secret_ref)
    val _back = dense_set_secret(public_secret)
    verdict

fn port_verdict_without_secret(path: text, public_secret: text) -> text:
    val _gone = dense_unset_secret()
    val verdict = port_verdict(path, "sqlcipher4", DENSE_REF)
    val _back = dense_set_secret(public_secret)
    verdict

# True when no needle (non-empty) occurs in the text.
fn leaks_none(haystack: text, needles: [text]) -> bool:
    for needle in needles:
        if needle != "" and haystack.contains(needle):
            return false
    true

export port_verdict, verdict_code, verdict_message
export port_verdict_with_secret, port_verdict_without_secret, leaks_none
