# Shared scenario driver for the devhub messenger CLI read verbs (rooms/messages)
# over the dense sqlcipher4 fixture. The same scenarios run against the interpreter
# (`bin/simple.exe run src/app/devhub/main.spl`) and the native binary.
use std.io_runtime.{process_run, file_write}
use std.env.{env_set}
use test.support.devhub_messenger_dense.*

fn cli_sdn_text(db_path: text) -> text:
    "messenger:\n    schema_version: 1\n    default_target: dense\n\n" +
    "messenger.dense:\n    read_provider: sqlcipher4_database\n    send_provider: none\n    send_enabled: false\n    cache_mode: none\n    sync_policy: on_demand\n\n" +
    "messenger.dense.db:\n    path: {db_path}\n    format: sqlcipher4\n    access: read_only\n    snapshot_mode: frozen_snapshot\n    profile: sqlcipher4_4k_sha512\n    key_kind: passphrase\n    secret_ref: {DENSE_REF}\n    cipher_page_size: 4096\n    cipher_kdf_iter: 256000\n    cipher_kdf_algorithm: pbkdf2_hmac_sha512\n    cipher_hmac_algorithm: hmac_sha512\n    cipher_page_hmac: true\n    cipher_hmac_pgno: little_endian\n    cipher_reserved_bytes: 80\n    cipher_plaintext_header_bytes: 0\n    immutable: true\n\n" +
    "messenger.dense.schema:\n    profile_id: dense_v1\n    room_table: room\n    room_id: id\n    room_name: title\n    room_created_at: created_at\n    member_table: room_member\n    member_room_id: room_id\n    member_identity_id: user_id\n    member_joined_at: joined_at\n    message_table: messages\n    message_id: id\n    message_room_id: room_id\n    message_sender_id: sender_id\n    message_body: body\n    message_created_at: created_at\n    message_sequence: seq\n    message_reply_to_id: reply_to_id\n    timestamp_unit: s\n    sequence_kind: monotonic_within_room\n"

# Points HOME at `home` (relative to cwd) with a messenger.sdn naming the dense fixture.
fn cli_prepare_home(home: text) -> bool:
    val _mk = process_run("mkdir", ["-p", home + "/.config/devhub"])
    val cwd = process_run("pwd", []).0.trim()
    val db = cwd + "/" + dense_path(DENSE_BASE)
    val _w = file_write(home + "/.config/devhub/messenger.sdn", cli_sdn_text(db))
    val _h = env_set("HOME", cwd + "/" + home)
    val _p = env_set("USERPROFILE", cwd + "/" + home)
    true

export cli_sdn_text, cli_prepare_home
