describe "Concurrency Mode - Actor":
    # ## Default Actor Mode
    #
    # Tests that actor mode (default) only allows iso T.

    it "defaults to actor mode":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-019
        step("Verify: defaults to actor mode")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn process(x: i64) -> i64:
            x

        expect process(42) == 42

    it "actor mode allows iso":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: actor mode allows iso")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn transfer(data: iso i64) -> i64:
            data

        expect transfer(42) == 42

    it "actor mode rejects mut in params":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-021
        step("Verify: actor mode rejects mut in params")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # This would be a compile error:
        # fn update(x: mut i64) -> i64:  # Error in actor mode
