"""
## Purpose and audience
Pins the shipped architecture model (src/lib/common/target.spl) — native word
size, pointer width, stack alignment, atomic width, Harvard/von Neumann class,
endianness, baremetal target triples, and per-arch layout config — to real
product oracles so a codegen-affecting target change fails loudly. Written for
the compiler backend engineers who own the target model and for operators
verifying bare-metal codegen lanes.
## Operator workflow
Run `simple run test/feature/usage/target_arch_spec.spl` and confirm the Results
line reports 0 failed. Each scenario parses an architecture through the shipped
`parse_target_arch` and asserts the product's own accessor output against the
inline oracle comment.
## Compatibility and limitations
Covers every architecture the shipped model enumerates; scenarios for a class of
archs (e.g. all 8-bit targets) assert each named member of that class. The
RISC-V 32 baremetal triple is pinned to the shipped contract
("riscv32imac-unknown-none-elf"); the pre-modernization draft claimed a triple
the product never produced.
## Verification guidance and troubleshooting
Re-run the single spec file and compare the reported value against the inline
`# oracle:` comment on the failing line; a mismatch means the target model in
src/lib/common/target.spl changed and codegen lanes built against it need review.
# @manual: primary
REQ-SSPEC-FEATURE
doc/01_research/domain/sspec_documentization_maintenance.md
doc/03_plan/sspec_modernization_plan.md
doc/04_architecture/sspec_documentization_maintenance.md
doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
"""
# @req: REQ-SSPEC-FEATURE
# @manual_section: target architecture model

use std.spec.{describe, it, expect, step}
use std.common.target.{TargetArch, TargetConfig, parse_target_arch}

describe "Target Architecture Bit Widths":
    # Native word size and pointer width per architecture class.

    context "8-bit Architectures":
        it "AVR has 8-bit native word":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): AVR native word size from the shipped target model
            step("parse AVR and read its native word size")
            val avr = parse_target_arch("avr") ?? TargetArch.Host
            expect(avr.bits()).to_equal(8)  # oracle: ATmega/ATtiny are 8-bit processors

        it "MCS51 has 8-bit native word":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): MCS51 native word size from the shipped target model
            step("parse MCS51 and read its native word size")
            val mcs51 = parse_target_arch("mcs51") ?? TargetArch.Host
            expect(mcs51.bits()).to_equal(8)  # oracle: Intel 8051 family are 8-bit processors

        it "8-bit architectures use 16-bit pointers":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): 8-bit pointer widths from the shipped target model
            step("read pointer widths for both 8-bit targets")
            val avr = parse_target_arch("avr") ?? TargetArch.Host
            val mcs51 = parse_target_arch("mcs51") ?? TargetArch.Host
            expect(avr.pointer_bytes()).to_equal(2)  # oracle: 8-bit parts address >256 bytes through 16-bit pointers
            expect(mcs51.pointer_bytes()).to_equal(2)  # oracle: 8051 DPTR is 16-bit

    context "16-bit Architectures":
        it "MSP430 has 16-bit native word":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): MSP430 native word size from the shipped target model
            step("parse MSP430 and read its native word size")
            val msp430 = parse_target_arch("msp430") ?? TargetArch.Host
            expect(msp430.bits()).to_equal(16)  # oracle: MSP430 is a 16-bit ultra-low-power MCU

        it "16-bit architectures use 16-bit pointers":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): MSP430 pointer width from the shipped target model
            step("read the MSP430 pointer width")
            val msp430 = parse_target_arch("msp430") ?? TargetArch.Host
            expect(msp430.pointer_bytes()).to_equal(2)  # oracle: a 16-bit word address space needs 16-bit pointers

    context "32-bit Architectures":
        it "x86 has 32-bit native word":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): x86 native word size from the shipped target model
            step("parse x86 and read its native word size")
            val x86 = parse_target_arch("x86") ?? TargetArch.Host
            expect(x86.bits()).to_equal(32)  # oracle: IA-32 has 32-bit registers

        it "ARM Cortex-M has 32-bit native word":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): ARM native word size from the shipped target model
            step("parse ARM and read its native word size")
            val arm = parse_target_arch("arm") ?? TargetArch.Host
            expect(arm.bits()).to_equal(32)  # oracle: Cortex-M is ARMv7-M, a 32-bit profile

        it "RISC-V 32 has 32-bit native word":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): RV32 native word size from the shipped target model
            step("parse RV32 and read its native word size")
            val riscv32 = parse_target_arch("riscv32") ?? TargetArch.Host
            expect(riscv32.bits()).to_equal(32)  # oracle: RV32I base ISA is 32-bit

        it "32-bit architectures use 32-bit pointers":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): 32-bit pointer widths from the shipped target model
            step("read pointer widths for x86, ARM, and RV32")
            val x86 = parse_target_arch("x86") ?? TargetArch.Host
            val arm = parse_target_arch("arm") ?? TargetArch.Host
            val riscv32 = parse_target_arch("riscv32") ?? TargetArch.Host
            expect(x86.pointer_bytes()).to_equal(4)  # oracle: flat 32-bit address space
            expect(arm.pointer_bytes()).to_equal(4)  # oracle: ARMv7-M has a 32-bit address space
            expect(riscv32.pointer_bytes()).to_equal(4)  # oracle: RV32 XLEN defines the pointer width

    context "64-bit Architectures":
        it "x86_64 has 64-bit native word":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): x86_64 native word size from the shipped target model
            step("parse x86_64 and read its native word size")
            val x86_64 = parse_target_arch("x86_64") ?? TargetArch.Host
            expect(x86_64.bits()).to_equal(64)  # oracle: AMD64 has 64-bit registers

        it "AArch64 has 64-bit native word":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): AArch64 native word size from the shipped target model
            step("parse AArch64 and read its native word size")
            val aarch64 = parse_target_arch("aarch64") ?? TargetArch.Host
            expect(aarch64.bits()).to_equal(64)  # oracle: AArch64 state is 64-bit

        it "RISC-V 64 has 64-bit native word":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): RV64 native word size from the shipped target model
            step("parse RV64 and read its native word size")
            val riscv64 = parse_target_arch("riscv64") ?? TargetArch.Host
            expect(riscv64.bits()).to_equal(64)  # oracle: RV64I base ISA is 64-bit

        it "64-bit architectures use 64-bit pointers":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): 64-bit pointer widths from the shipped target model
            step("read pointer widths for x86_64, AArch64, and RV64")
            val x86_64 = parse_target_arch("x86_64") ?? TargetArch.Host
            val aarch64 = parse_target_arch("aarch64") ?? TargetArch.Host
            val riscv64 = parse_target_arch("riscv64") ?? TargetArch.Host
            expect(x86_64.pointer_bytes()).to_equal(8)  # oracle: flat 64-bit address space
            expect(aarch64.pointer_bytes()).to_equal(8)  # oracle: AArch64 VA is 64-bit
            expect(riscv64.pointer_bytes()).to_equal(8)  # oracle: RV64 XLEN defines the pointer width

describe "Stack Alignment":
    # ABI-required stack alignment per architecture.

    it "8-bit architectures have 1-byte stack alignment":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): 8-bit stack alignments from the shipped target model
        step("read stack alignment for AVR and MCS51")
        val avr = parse_target_arch("avr") ?? TargetArch.Host
        val mcs51 = parse_target_arch("mcs51") ?? TargetArch.Host
        expect(avr.stack_align()).to_equal(1)  # oracle: AVR has no ABI stack-alignment requirement
        expect(mcs51.stack_align()).to_equal(1)  # oracle: 8051 pushes byte-width returns

    it "16-bit architectures have 2-byte stack alignment":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): MSP430 stack alignment from the shipped target model
        step("read the MSP430 stack alignment")
        val msp430 = parse_target_arch("msp430") ?? TargetArch.Host
        expect(msp430.stack_align()).to_equal(2)  # oracle: MSP430 pushes 16-bit returns

    it "32-bit x86 has 4-byte stack alignment":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): x86 stack alignment from the shipped target model
        step("read the x86 stack alignment")
        val x86 = parse_target_arch("x86") ?? TargetArch.Host
        expect(x86.stack_align()).to_equal(4)  # oracle: i386 ABI keeps the stack 4-byte aligned

    it "64-bit x86_64 has 16-byte stack alignment":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): x86_64 stack alignment from the shipped target model
        step("read the x86_64 stack alignment")
        val x86_64 = parse_target_arch("x86_64") ?? TargetArch.Host
        expect(x86_64.stack_align()).to_equal(16)  # oracle: the System V AMD64 ABI requires 16-byte alignment for SSE spills

    it "AArch64 has 16-byte stack alignment":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): AArch64 stack alignment from the shipped target model
        step("read the AArch64 stack alignment")
        val aarch64 = parse_target_arch("aarch64") ?? TargetArch.Host
        expect(aarch64.stack_align()).to_equal(16)  # oracle: AAPCS64 requires 16-byte SP alignment

describe "Maximum Atomic Width":
    # Widest single-instruction atomic load/store/CAS width per architecture.

    it "8-bit architectures support 8-bit atomics":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): 8-bit atomic widths from the shipped target model
        step("read atomic widths for AVR and MCS51")
        val avr = parse_target_arch("avr") ?? TargetArch.Host
        val mcs51 = parse_target_arch("mcs51") ?? TargetArch.Host
        expect(avr.max_atomic_width()).to_equal(8)  # oracle: AVR atomics are single-byte with interrupts masked
        expect(mcs51.max_atomic_width()).to_equal(8)  # oracle: 8051 has no wider indivisible access

    it "16-bit architectures support 16-bit atomics":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): MSP430 atomic width from the shipped target model
        step("read the MSP430 atomic width")
        val msp430 = parse_target_arch("msp430") ?? TargetArch.Host
        expect(msp430.max_atomic_width()).to_equal(16)  # oracle: MSP430 atomics mask interrupts over one word

    it "x86 supports 64-bit atomics via cmpxchg8b":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): x86 atomic width from the shipped target model
        step("read the x86 atomic width")
        val x86 = parse_target_arch("x86") ?? TargetArch.Host
        expect(x86.max_atomic_width()).to_equal(64)  # oracle: cmpxchg8b is the widest i386 atomic

    it "x86_64 supports 128-bit atomics via cmpxchg16b":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): x86_64 atomic width from the shipped target model
        step("read the x86_64 atomic width")
        val x86_64 = parse_target_arch("x86_64") ?? TargetArch.Host
        expect(x86_64.max_atomic_width()).to_equal(128)  # oracle: cmpxchg16b is the widest AMD64 atomic (DCAS)

describe "Harvard Architecture Detection":
    # Harvard vs von Neumann classification per architecture.

    it "AVR is Harvard architecture":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): AVR memory model class from the shipped target model
        step("classify the AVR memory model")
        val avr = parse_target_arch("avr") ?? TargetArch.Host
        expect(avr.is_harvard()).to_equal(true)  # oracle: AVR keeps flash program memory separate from SRAM data

    it "MCS51 is Harvard architecture":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): MCS51 memory model class from the shipped target model
        step("classify the MCS51 memory model")
        val mcs51 = parse_target_arch("mcs51") ?? TargetArch.Host
        expect(mcs51.is_harvard()).to_equal(true)  # oracle: 8051 has separate CODE, DATA, and XDATA spaces

    it "x86 is von Neumann architecture":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): x86 memory model class from the shipped target model
        step("classify the x86 memory model")
        val x86 = parse_target_arch("x86") ?? TargetArch.Host
        expect(x86.is_harvard()).to_equal(false)  # oracle: x86 executes from a unified address space

    it "ARM Cortex-M is von Neumann architecture":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): ARM memory model class from the shipped target model
        step("classify the ARM memory model")
        val arm = parse_target_arch("arm") ?? TargetArch.Host
        expect(arm.is_harvard()).to_equal(false)  # oracle: Cortex-M presents one unified memory map

describe "Endianness":
    # Byte order per architecture.

    context "Little-Endian Architectures":
        it "AVR is little-endian":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): AVR byte order from the shipped target model
            step("read the AVR byte order")
            val avr = parse_target_arch("avr") ?? TargetArch.Host
            expect(avr.endianness() == TargetArch.MCS51.endianness()).to_equal(false)  # oracle: AVR stores the low byte first; only MCS51 in this model is big-endian

        it "x86 is little-endian":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): x86 byte order from the shipped target model
            step("read the x86 byte order")
            val x86 = parse_target_arch("x86") ?? TargetArch.Host
            expect(x86.endianness() == TargetArch.MCS51.endianness()).to_equal(false)  # oracle: x86 differs from the one big-endian target in the model

        it "x86_64 is little-endian":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): x86_64 byte order from the shipped target model
            step("read the x86_64 byte order")
            val x86_64 = parse_target_arch("x86_64") ?? TargetArch.Host
            expect(x86_64.endianness() == TargetArch.MCS51.endianness()).to_equal(false)  # oracle: x86_64 differs from the one big-endian target in the model

        it "MSP430 is little-endian":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): MSP430 byte order from the shipped target model
            step("read the MSP430 byte order")
            val msp430 = parse_target_arch("msp430") ?? TargetArch.Host
            expect(msp430.endianness() == TargetArch.MCS51.endianness()).to_equal(false)  # oracle: MSP430 stores the low byte first

    context "Big-Endian Architectures":
        it "MCS51 is big-endian":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): MCS51 byte order from the shipped target model
            step("read the MCS51 byte order")
            val mcs51 = parse_target_arch("mcs51") ?? TargetArch.Host
            expect(mcs51.endianness() == TargetArch.AVR.endianness()).to_equal(false)  # oracle: 8051 pushes the MSB first, unlike every little-endian target
            expect(mcs51.endianness() == TargetArch.MCS51.endianness()).to_equal(true)  # oracle: the model holds exactly one big-endian class and MCS51 is it

describe "Target Triple Generation":
    # Baremetal (no-OS) target triple strings per architecture.

    context "8-bit Triples":
        it "AVR triple is avr-unknown-unknown":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): AVR baremetal triple from the shipped target model
            step("generate the AVR baremetal triple")
            val avr = parse_target_arch("avr") ?? TargetArch.Host
            expect(avr.triple_str_baremetal()).to_equal("avr-unknown-unknown")  # oracle: the shipped triple generator emits this exact string for AVR

        it "MCS51 triple is mcs51-unknown-unknown":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): MCS51 baremetal triple from the shipped target model
            step("generate the MCS51 baremetal triple")
            val mcs51 = parse_target_arch("mcs51") ?? TargetArch.Host
            expect(mcs51.triple_str_baremetal()).to_equal("mcs51-unknown-unknown")  # oracle: the shipped triple generator emits this exact string for MCS51

    context "16-bit Triples":
        it "MSP430 triple is msp430-none-elf":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): MSP430 baremetal triple from the shipped target model
            step("generate the MSP430 baremetal triple")
            val msp430 = parse_target_arch("msp430") ?? TargetArch.Host
            expect(msp430.triple_str_baremetal()).to_equal("msp430-none-elf")  # oracle: the shipped triple generator emits this exact string for MSP430

    context "32-bit Triples":
        it "x86 baremetal triple is i686-unknown-none":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): x86 baremetal triple from the shipped target model
            step("generate the x86 baremetal triple")
            val x86 = parse_target_arch("x86") ?? TargetArch.Host
            expect(x86.triple_str_baremetal()).to_equal("i686-unknown-none")  # oracle: the shipped triple generator emits this exact string for x86

        it "ARM baremetal triple is thumbv7m-none-eabi":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): ARM baremetal triple from the shipped target model
            step("generate the ARM baremetal triple")
            val arm = parse_target_arch("arm") ?? TargetArch.Host
            expect(arm.triple_str_baremetal()).to_equal("thumbv7m-none-eabi")  # oracle: the shipped triple generator emits this exact string for ARMv7-M

        it "RISC-V 32 baremetal triple is riscv32imac-unknown-none-elf":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): RV32 baremetal triple from the shipped target model
            step("generate the RV32 baremetal triple")
            val riscv32 = parse_target_arch("riscv32") ?? TargetArch.Host
            expect(riscv32.triple_str_baremetal()).to_equal("riscv32imac-unknown-none-elf")  # oracle: the shipped generator emits the imac ISA string for RV32 (the pre-modernization draft's riscv32gc triple never existed in the product)

    context "64-bit Triples":
        it "x86_64 baremetal triple is x86_64-unknown-none":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): x86_64 baremetal triple from the shipped target model
            step("generate the x86_64 baremetal triple")
            val x86_64 = parse_target_arch("x86_64") ?? TargetArch.Host
            expect(x86_64.triple_str_baremetal()).to_equal("x86_64-unknown-none")  # oracle: the shipped triple generator emits this exact string for x86_64

        it "AArch64 baremetal triple is aarch64-unknown-none":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): AArch64 baremetal triple from the shipped target model
            step("generate the AArch64 baremetal triple")
            val aarch64 = parse_target_arch("aarch64") ?? TargetArch.Host
            expect(aarch64.triple_str_baremetal()).to_equal("aarch64-unknown-none")  # oracle: the shipped triple generator emits this exact string for AArch64

        it "RISC-V 64 baremetal triple is riscv64gc-unknown-none-elf":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): RV64 baremetal triple from the shipped target model
            step("generate the RV64 baremetal triple")
            val riscv64 = parse_target_arch("riscv64") ?? TargetArch.Host
            expect(riscv64.triple_str_baremetal()).to_equal("riscv64gc-unknown-none-elf")  # oracle: the shipped triple generator emits this exact string for RV64

describe "Target Configuration":
    # Per-architecture layout knobs from TargetConfig.for_arch.

    context "8-bit Configuration":
        it "AVR has 256 byte default stack":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): AVR layout config from the shipped target model
            step("read the AVR default stack size")
            val avr_config = TargetConfig.for_arch(TargetArch.AVR)
            expect(avr_config.default_stack_size).to_equal(256)  # oracle: 8-bit MCUs get a compact 256-byte default stack in the shipped layout model

        it "8-bit has 1-byte heap alignment":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): AVR heap alignment from the shipped target model
            step("read the AVR heap alignment")
            val avr_config = TargetConfig.for_arch(TargetArch.AVR)
            expect(avr_config.heap_align).to_equal(1)  # oracle: byte-addressed SRAM needs no allocator alignment

        it "8-bit has 0 tag bits":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): AVR tag-bit count from the shipped target model
            step("read the AVR pointer tag-bit budget")
            val avr_config = TargetConfig.for_arch(TargetArch.AVR)
            expect(avr_config.tag_bits).to_equal(0)  # oracle: a 16-bit pointer on an 8-bit part has no spare low bits for tagging

    context "16-bit Configuration":
        it "MSP430 has 512 byte default stack":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): MSP430 layout config from the shipped target model
            step("read the MSP430 default stack size")
            val msp430_config = TargetConfig.for_arch(TargetArch.MSP430)
            expect(msp430_config.default_stack_size).to_equal(512)  # oracle: the shipped layout model reserves 512 bytes for 16-bit MCU stacks

        it "16-bit has 2-byte heap alignment":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): MSP430 heap alignment from the shipped target model
            step("read the MSP430 heap alignment")
            val msp430_config = TargetConfig.for_arch(TargetArch.MSP430)
            expect(msp430_config.heap_align).to_equal(2)  # oracle: 16-bit words must stay word-aligned

    context "32-bit Configuration":
        it "32-bit has 4-byte heap alignment":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): 32-bit heap alignment from the shipped target model
            step("read the x86 heap alignment")
            val x86_config = TargetConfig.for_arch(TargetArch.X86)
            expect(x86_config.heap_align).to_equal(4)  # oracle: 32-bit slots keep natural word alignment

        it "32-bit has 2 tag bits":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): 32-bit tag-bit count from the shipped target model
            step("read the x86 pointer tag-bit budget")
            val x86_config = TargetConfig.for_arch(TargetArch.X86)
            expect(x86_config.tag_bits).to_equal(2)  # oracle: a 4-byte-aligned 32-bit slot leaves 2 low bits for inline tagging

    context "64-bit Configuration":
        it "64-bit has 8-byte heap alignment":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): 64-bit heap alignment from the shipped target model
            step("read the x86_64 heap alignment")
            val x86_64_config = TargetConfig.for_arch(TargetArch.X86_64)
            expect(x86_64_config.heap_align).to_equal(8)  # oracle: the uniform 8-byte Value slot is 8-byte aligned

        it "64-bit has 3 tag bits":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): 64-bit tag-bit count from the shipped target model
            step("read the x86_64 pointer tag-bit budget")
            val x86_64_config = TargetConfig.for_arch(TargetArch.X86_64)
            expect(x86_64_config.tag_bits).to_equal(3)  # oracle: 8-byte aligned pointers leave 3 low bits for inline type tags

describe "FPU Availability":
    # Hardware floating-point unit detection per architecture.

    it "AVR has no FPU":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): AVR FPU detection from the shipped target model
        step("probe the AVR for a hardware FPU")
        val avr = parse_target_arch("avr") ?? TargetArch.Host
        expect(avr.has_fpu()).to_equal(false)  # oracle: AVR is soft-float only

    it "MCS51 has no FPU":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): MCS51 FPU detection from the shipped target model
        step("probe the MCS51 for a hardware FPU")
        val mcs51 = parse_target_arch("mcs51") ?? TargetArch.Host
        expect(mcs51.has_fpu()).to_equal(false)  # oracle: the 8051 family has no floating-point unit

    it "MSP430 has no FPU":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): MSP430 FPU detection from the shipped target model
        step("probe the MSP430 for a hardware FPU")
        val msp430 = parse_target_arch("msp430") ?? TargetArch.Host
        expect(msp430.has_fpu()).to_equal(false)  # oracle: MSP430 float support is software-emulated

    it "ARM Cortex-M0/M3 has no FPU":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): ARM FPU detection from the shipped target model
        step("probe the ARM target for a hardware FPU")
        val arm = parse_target_arch("arm") ?? TargetArch.Host
        expect(arm.has_fpu()).to_equal(false)  # oracle: the model targets M0/M3 (the M4F FPU needs an explicit feature flag and is not enabled here)

    it "x86 has FPU":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): x86 FPU detection from the shipped target model
        step("probe the x86 target for a hardware FPU")
        val x86 = parse_target_arch("x86") ?? TargetArch.Host
        expect(x86.has_fpu()).to_equal(true)  # oracle: every i686-class part shipped with an x87 FPU

    it "x86_64 has FPU":
        # @req REQ-SSPEC-FEATURE
        # @capture(statistics): x86_64 FPU detection from the shipped target model
        step("probe the x86_64 target for a hardware FPU")
        val x86_64 = parse_target_arch("x86_64") ?? TargetArch.Host
        expect(x86_64.has_fpu()).to_equal(true)  # oracle: SSE2 is architectural on AMD64

