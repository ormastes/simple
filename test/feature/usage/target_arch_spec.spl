describe "Target Configuration":
    # Verify target configuration for resource-limited devices.

    context "8-bit Configuration":
        it "AVR has 256 byte default stack":
            # @req: REQ-FEATURE-USAGE-041
            step("Verify: AVR has 256 byte default stack")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val AVR_DEFAULT_STACK = 256
            expect(AVR_DEFAULT_STACK).to_equal(256)  # oracle: expected value 256 is the behavior asserted by this regression spec

        it "8-bit has 1-byte heap alignment":
            # @req: REQ-FEATURE-USAGE-042
            step("Verify: 8-bit has 1-byte heap alignment")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val HEAP_ALIGN_8BIT = 1
            expect(HEAP_ALIGN_8BIT).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "8-bit has 0 tag bits":
            # @req: REQ-FEATURE-USAGE-043
            step("Verify: 8-bit has 0 tag bits")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # No room for tagged pointers.
            val TAG_BITS_8BIT = 0
            expect(TAG_BITS_8BIT).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    context "16-bit Configuration":
        it "MSP430 has 512 byte default stack":
            # @req: REQ-FEATURE-USAGE-044
            step("Verify: MSP430 has 512 byte default stack")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val MSP430_DEFAULT_STACK = 512
            expect(MSP430_DEFAULT_STACK).to_equal(512)  # oracle: expected value 512 is the behavior asserted by this regression spec

        it "16-bit has 2-byte heap alignment":
            # @req: REQ-FEATURE-USAGE-045
            step("Verify: 16-bit has 2-byte heap alignment")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val HEAP_ALIGN_16BIT = 2
            expect(HEAP_ALIGN_16BIT).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    context "32-bit Configuration":
        it "32-bit has 4-byte heap alignment":
            # @req: REQ-FEATURE-USAGE-046
            step("Verify: 32-bit has 4-byte heap alignment")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val HEAP_ALIGN_32BIT = 4
            expect(HEAP_ALIGN_32BIT).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

        it "32-bit has 2 tag bits":
            # @req: REQ-FEATURE-USAGE-047
            step("Verify: 32-bit has 2 tag bits")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val TAG_BITS_32BIT = 2
            expect(TAG_BITS_32BIT).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    context "64-bit Configuration":
        it "64-bit has 8-byte heap alignment":
            # @req: REQ-FEATURE-USAGE-048
            step("Verify: 64-bit has 8-byte heap alignment")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val HEAP_ALIGN_64BIT = 8
            expect(HEAP_ALIGN_64BIT).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

        it "64-bit has 3 tag bits":
            # @req: REQ-FEATURE-USAGE-049
            step("Verify: 64-bit has 3 tag bits")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # 8-byte aligned pointers allow 3 low bits.
            val TAG_BITS_64BIT = 3
            expect(TAG_BITS_64BIT).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

describe "FPU Availability":
    # Verify hardware FPU detection.

    it "AVR has no FPU":
        # @req: REQ-FEATURE-USAGE-050
        step("Verify: AVR has no FPU")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val AVR_HAS_FPU = false
        expect(AVR_HAS_FPU).to_equal(false)

    it "MCS51 has no FPU":
        # @req: REQ-FEATURE-USAGE-051
        step("Verify: MCS51 has no FPU")
        # @capture: assertion outcomes retained in the spec Results output as evidence
