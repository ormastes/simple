        expect(MCS51_HAS_FPU).to_equal(false)

    it "MSP430 has no FPU":
        # @req: REQ-FEATURE-USAGE-052
        step("Verify: MSP430 has no FPU")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val MSP430_HAS_FPU = false
        expect(MSP430_HAS_FPU).to_equal(false)

    it "ARM Cortex-M0/M3 has no FPU":
        # @req: REQ-FEATURE-USAGE-053
        step("Verify: ARM Cortex-M0/M3 has no FPU")
