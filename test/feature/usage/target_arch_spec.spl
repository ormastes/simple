"""
## Purpose and audience

# Target Architecture Specification

**Feature IDs:** #BM-ARCH-001
**Category:** Bare-Metal / Architecture
**Difficulty:** 2/5
**Status:** In Progress

## Overview

Multi-architecture support for bare-metal development including:
- 8-bit architectures (AVR, MCS51)
- 16-bit architectures (MSP430)
- 32-bit architectures (x86, ARM, RISC-V 32)
- 64-bit architectures (x86_64, AArch64, RISC-V 64)

## Key Concepts

| Concept | Description |
|---------|-------------|
| bits() | Native word size: 8, 16, 32, or 64 |
| pointer_bytes() | Pointer size in bytes (2/4/8) |
| stack_align() | Stack alignment requirement |
| is_harvard() | Harvard vs von Neumann architecture |
| endianness() | Little or Big endian |

## Implementation Notes

- 8-bit architectures use 16-bit pointers for >256 byte addressing
- Stack alignment varies by architecture (1/2/4/16 bytes)
- Harvard architectures have separate code/data memory

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/target_arch_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Target Architecture Bit Widths":
    # Verify correct bit width for each architecture class.

    context "8-bit Architectures":
        # AVR and MCS51 are 8-bit microcontrollers.

        it "AVR has 8-bit native word":
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: AVR has 8-bit native word")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # ATmega/ATtiny are 8-bit processors.
            val AVR_BITS = 8
            expect(AVR_BITS).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

        it "MCS51 has 8-bit native word":
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: MCS51 has 8-bit native word")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Intel 8051 family are 8-bit processors.
            val MCS51_BITS = 8
            expect(MCS51_BITS).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

        it "8-bit architectures use 16-bit pointers":
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: 8-bit architectures use 16-bit pointers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # For >256 byte address space.
            val POINTER_BYTES_8BIT = 2
            expect(POINTER_BYTES_8BIT).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    context "16-bit Architectures":
        # MSP430 is a 16-bit ultra-low-power microcontroller.

        it "MSP430 has 16-bit native word":
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: MSP430 has 16-bit native word")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val MSP430_BITS = 16
            expect(MSP430_BITS).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec

        it "16-bit architectures use 16-bit pointers":
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: 16-bit architectures use 16-bit pointers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val POINTER_BYTES_16BIT = 2
            expect(POINTER_BYTES_16BIT).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    context "32-bit Architectures":
        # x86, ARM Cortex-M, RISC-V 32.

        it "x86 has 32-bit native word":
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: x86 has 32-bit native word")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val X86_BITS = 32
            expect(X86_BITS).to_equal(32)  # oracle: expected value 32 is the behavior asserted by this regression spec

        it "ARM Cortex-M has 32-bit native word":
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: ARM Cortex-M has 32-bit native word")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ARM_BITS = 32
            expect(ARM_BITS).to_equal(32)  # oracle: expected value 32 is the behavior asserted by this regression spec

        it "RISC-V 32 has 32-bit native word":
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: RISC-V 32 has 32-bit native word")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val RISCV32_BITS = 32
            expect(RISCV32_BITS).to_equal(32)  # oracle: expected value 32 is the behavior asserted by this regression spec

        it "32-bit architectures use 32-bit pointers":
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: 32-bit architectures use 32-bit pointers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val POINTER_BYTES_32BIT = 4
            expect(POINTER_BYTES_32BIT).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

    context "64-bit Architectures":
        # x86_64, AArch64, RISC-V 64.

        it "x86_64 has 64-bit native word":
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: x86_64 has 64-bit native word")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val X86_64_BITS = 64
            expect(X86_64_BITS).to_equal(64)  # oracle: expected value 64 is the behavior asserted by this regression spec

        it "AArch64 has 64-bit native word":
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: AArch64 has 64-bit native word")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val AARCH64_BITS = 64
            expect(AARCH64_BITS).to_equal(64)  # oracle: expected value 64 is the behavior asserted by this regression spec

        it "RISC-V 64 has 64-bit native word":
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: RISC-V 64 has 64-bit native word")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val RISCV64_BITS = 64
            expect(RISCV64_BITS).to_equal(64)  # oracle: expected value 64 is the behavior asserted by this regression spec

        it "64-bit architectures use 64-bit pointers":
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: 64-bit architectures use 64-bit pointers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val POINTER_BYTES_64BIT = 8
            expect(POINTER_BYTES_64BIT).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

describe "Stack Alignment":
    # Verify correct stack alignment for each architecture.

    it "8-bit architectures have 1-byte stack alignment":
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: 8-bit architectures have 1-byte stack alignment")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val AVR_STACK_ALIGN = 1
        val MCS51_STACK_ALIGN = 1
        expect(AVR_STACK_ALIGN).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(MCS51_STACK_ALIGN).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "16-bit architectures have 2-byte stack alignment":
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: 16-bit architectures have 2-byte stack alignment")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val MSP430_STACK_ALIGN = 2
        expect(MSP430_STACK_ALIGN).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it "32-bit x86 has 4-byte stack alignment":
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: 32-bit x86 has 4-byte stack alignment")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val X86_STACK_ALIGN = 4
        expect(X86_STACK_ALIGN).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

    it "64-bit x86_64 has 16-byte stack alignment":
        # @req: REQ-FEATURE-USAGE-017
        step("Verify: 64-bit x86_64 has 16-byte stack alignment")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # SSE requires 16-byte alignment.
        val X86_64_STACK_ALIGN = 16
        expect(X86_64_STACK_ALIGN).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec

    it "AArch64 has 16-byte stack alignment":
        # @req: REQ-FEATURE-USAGE-018
        step("Verify: AArch64 has 16-byte stack alignment")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val AARCH64_STACK_ALIGN = 16
        expect(AARCH64_STACK_ALIGN).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec

describe "Maximum Atomic Width":
    # Verify maximum atomic operation width for each architecture.

    it "8-bit architectures support 8-bit atomics":
        # @req: REQ-FEATURE-USAGE-019
        step("Verify: 8-bit architectures support 8-bit atomics")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val AVR_MAX_ATOMIC = 8
        expect(AVR_MAX_ATOMIC).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

    it "16-bit architectures support 16-bit atomics":
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: 16-bit architectures support 16-bit atomics")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val MSP430_MAX_ATOMIC = 16
        expect(MSP430_MAX_ATOMIC).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec

    it "x86 supports 64-bit atomics via cmpxchg8b":
        # @req: REQ-FEATURE-USAGE-021
        step("Verify: x86 supports 64-bit atomics via cmpxchg8b")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val X86_MAX_ATOMIC = 64
        expect(X86_MAX_ATOMIC).to_equal(64)  # oracle: expected value 64 is the behavior asserted by this regression spec

    it "x86_64 supports 128-bit atomics via cmpxchg16b":
        # @req: REQ-FEATURE-USAGE-022
        step("Verify: x86_64 supports 128-bit atomics via cmpxchg16b")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val X86_64_MAX_ATOMIC = 128
        expect(X86_64_MAX_ATOMIC).to_equal(128)  # oracle: expected value 128 is the behavior asserted by this regression spec

describe "Harvard Architecture Detection":
    # Verify Harvard vs von Neumann architecture detection.

    it "AVR is Harvard architecture":
        # @req: REQ-FEATURE-USAGE-023
        step("Verify: AVR is Harvard architecture")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # AVR has separate program (flash) and data (SRAM) memory.
        val AVR_IS_HARVARD = true
        expect(AVR_IS_HARVARD).to_equal(true)

    it "MCS51 is Harvard architecture":
        # @req: REQ-FEATURE-USAGE-024
        step("Verify: MCS51 is Harvard architecture")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # 8051 has separate CODE, DATA, XDATA spaces.
        val MCS51_IS_HARVARD = true
        expect(MCS51_IS_HARVARD).to_equal(true)

    it "x86 is von Neumann architecture":
        # @req: REQ-FEATURE-USAGE-025
        step("Verify: x86 is von Neumann architecture")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # x86 has unified address space.
        val X86_IS_HARVARD = false
        expect(X86_IS_HARVARD).to_equal(false)

    it "ARM Cortex-M is von Neumann architecture":
        # @req: REQ-FEATURE-USAGE-026
        step("Verify: ARM Cortex-M is von Neumann architecture")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val ARM_IS_HARVARD = false
        expect(ARM_IS_HARVARD).to_equal(false)

describe "Endianness":
    # Verify byte order for each architecture.

    context "Little-Endian Architectures":
        it "AVR is little-endian":
            # @req: REQ-FEATURE-USAGE-027
            step("Verify: AVR is little-endian")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val AVR_LITTLE_ENDIAN = true
            expect(AVR_LITTLE_ENDIAN).to_equal(true)

        it "x86 is little-endian":
            # @req: REQ-FEATURE-USAGE-028
            step("Verify: x86 is little-endian")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val X86_LITTLE_ENDIAN = true
            expect(X86_LITTLE_ENDIAN).to_equal(true)

        it "x86_64 is little-endian":
            # @req: REQ-FEATURE-USAGE-029
            step("Verify: x86_64 is little-endian")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val X86_64_LITTLE_ENDIAN = true
            expect(X86_64_LITTLE_ENDIAN).to_equal(true)

        it "MSP430 is little-endian":
            # @req: REQ-FEATURE-USAGE-030
            step("Verify: MSP430 is little-endian")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val MSP430_LITTLE_ENDIAN = true
            expect(MSP430_LITTLE_ENDIAN).to_equal(true)

    context "Big-Endian Architectures":
        it "MCS51 is big-endian":
            # @req: REQ-FEATURE-USAGE-031
            step("Verify: MCS51 is big-endian")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # 8051 stores MSB first.
            val MCS51_BIG_ENDIAN = true
            expect(MCS51_BIG_ENDIAN).to_equal(true)

