"""
## Purpose and audience

# Existence Check Operator (.?) Specification

**Feature IDs:** #2100
**Category:** Syntax
**Difficulty:** 3/5
**Status:** Implemented
**Research:** doc/01_research/text_validity_presence_pattern_2026-02-24.md

## Overview

The `.?` operator checks if a value is "present" (non-nil AND non-empty).
Returns `T?` — the value itself if present, `nil` if absent.

After compiler rebuild, `.?` returns `T?` instead of `bool`, enabling
pattern binding (`if val x = expr.?:`) and nil coalescing (`expr.? ?? default`).

## Behavior

- Option types: pass-through (Some stays Some, nil stays nil)
- Collections: returns value if non-empty, nil if empty
- Strings: returns value if non-empty, nil if ""
- Primitives: always returns value (0, false are still present)

## Related

- `presence(text) -> text?` — named equivalent for text
- `presence_trimmed(text) -> text?` — blank-aware variant

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/exists_check_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Existence Check Operator .?":
    """
    ## Existence Check

    Verifies the `.?` operator that tests whether a value is
    "present" (non-nil AND non-empty). Works across Option, collections,
    strings, and primitives. Integrates with no-paren method calls.
    """

    context "Option type":
        """
        ### Option Presence

        `Some(x).?` is truthy (value exists), `None.?` is falsy.
        """

        it "returns true for Some":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: returns true for Some")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val some_val: Option<i32> = Some(42)
            expect some_val.? != nil

        it "returns true for Some(0)":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: returns true for Some(0)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val some_zero: Option<i32> = Some(0)
            expect some_zero.? != nil

        it "returns false for None":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: returns false for None")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val none_val: Option<i32> = None
            expect none_val.? == nil

    context "List type":
        """
        ### List Presence

        Non-empty lists are present, empty lists are absent.
        """

        it "returns false for empty list":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: returns false for empty list")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val empty: List<i32> = []
            expect empty.? == nil

        it "returns true for non-empty list":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: returns true for non-empty list")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val items = [1, 2, 3]
            expect items.? != nil

    context "Dict type":
        """
        ### Dict Presence

        Non-empty dicts are present, empty dicts are absent.
        """

        it "returns false for empty dict":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: returns false for empty dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val empty: Dict<text, i32> = {}
            expect empty.? == nil

        it "returns true for non-empty dict":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: returns true for non-empty dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val items = {"a": 1}
            expect items.? != nil

    context "String type":
        """
        ### String Presence

        Non-empty strings are present, `""` is absent.
        """

        it "returns false for empty string":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: returns false for empty string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val empty = ""
            expect empty.? == nil

        it "returns true for non-empty string":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: returns true for non-empty string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = "hello"
            expect s.? != nil

    context "Primitive types":
        """
        ### Primitive Presence

        Primitives always exist — even `0` and `false` are present values.
        """

        it "returns true for positive number":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: returns true for positive number")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val num = 42
            expect num.? != nil

        it "returns true for zero":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: returns true for zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val zero = 0
            expect zero.? != nil

        it "returns true for false":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: returns true for false")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val flag = false
            expect flag.? != nil

    context "with no-paren method calls":
        """
        ### No-Paren + Existence

        `.?` chains with no-paren method calls for idiomatic patterns.
        """

        it "works with list.first.?":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: works with list.first.?")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val items = [1, 2, 3]
            expect items.first.? != nil

        it "returns false for empty list.first.?":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: returns false for empty list.first.?")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val empty: List<i32> = []
            expect empty.first.? == nil

        it "works with string.trim.?":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: works with string.trim.?")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = "  hello  "
            expect s.trim.? != nil

        it "works with chained no-paren methods":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: works with chained no-paren methods")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = "  HELLO  "
            expect s.trim.lower.? != nil

        it "returns false for empty result":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: returns false for empty result")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val empty = ""
            expect empty.trim.? == nil
