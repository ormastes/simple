"""
## Purpose and audience

# Primitive Types Specification

**Feature ID:** #PRIM-001
**Category:** Language | Types
**Status:** Implemented

## Overview

Tests for primitive types, type suffixes, union types, type aliases,
and generic types.

## Syntax

```simple
val x = 42i32                             # Type suffix
type Number = i64                         # Type alias
fn process(x: i64 | str) -> i64: ...      # Union type
fn identity<T>(x: T) -> T: x              # Generic function
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/primitive_types_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Enum Types
# ============================================================================

describe "Enum Types":
    # ## Enum Comparison and Matching
    #
    # Tests for enum type operations.

    it "compares enum variants":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: compares enum variants")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        enum Color:
            Red
            Green
        val c = Color.Green
        var result = 0
        if c == Color.Red:
            result = 1
        else:
            result = 0
        expect result == 0


# ============================================================================
# Test Group 2: Union Types
# ============================================================================

describe "Union Types":
    # ## Union Type Annotations
    #
    # Tests for union types in function signatures.

    it "accepts union type parameter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: accepts union type parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn test(x: i64 | str) -> i64:
            return 42
        expect test(10) == 42

    # TODO: Type-based pattern matching on union types not yet implemented
    # it "matches int in union":
    #     fn process(x: i64 | str) -> i64:
    #         match x:
    #             case n: i64: return n * 2
    #             case s: str: return 0
    #         return -1
    #     expect process(21) == 42

    # it "matches str in union":
    #     ...

    # it "handles three-type union":
    #     ...


# ============================================================================
# Test Group 3: Type Aliases
# ============================================================================

describe "Type Aliases":
    # ## Type Alias Definitions
    #
    # Tests for type alias declarations.

    it "uses simple type alias":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: uses simple type alias")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        type Number = i64
        fn double(x: Number) -> Number:
            return x * 2
        expect double(21) == 42


# ============================================================================
# Test Group 4: Optional Types
# ============================================================================

describe "Optional Types":
    # ## Optional Type Syntax (T?)
    #
    # Tests for optional type annotations.

    it "accepts optional parameter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: accepts optional parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn maybe_value(x: i64?) -> i64:
            return 5
        expect maybe_value(10) == 5


# ============================================================================
# Test Group 5: Generic Functions
# ============================================================================

describe "Generic Functions":
    # ## Generic Function Definitions
    #
    # Tests for generic functions with type parameters.

    it "defines identity function":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: defines identity function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn identity<T>(x: T) -> T:
            return x
        expect identity(42) == 42

    it "uses two type parameters":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: uses two type parameters")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn first<A, B>(a: A, b: B) -> A:
            return a
        fn second<A, B>(a: A, b: B) -> B:
            return b
        val x = first(10, 20)
        val y = second(30, 40)
        expect x + y == 50


# ============================================================================
# Test Group 6: Generic Structs
# ============================================================================

describe "Generic Structs":
    # ## Generic Struct Definitions
    #
    # Tests for generic structs with type parameters.

    it "creates generic struct":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: creates generic struct")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        struct Box<T>:
            value: T
        val b = Box { value: 42 }
        expect b.value == 42


# ============================================================================
# Test Group 7: Option Type
# ============================================================================

describe "Option Type Operations":
    # ## Option Some/None Operations
    #
    # Tests for Option type methods.

    it "unwraps Some value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: unwraps Some value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt = Some(42)
        expect opt.unwrap() == 42

    it "unwraps None with default":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: unwraps None with default")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt = None
        expect opt.unwrap_or(99) == 99

    it "checks is_some":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: checks is_some")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt = Some(1)
        var result = 0
        if opt.is_some():
            result = 1
        expect result == 1

    it "checks is_none":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: checks is_none")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt = None
        var result = 0
        if opt.is_none():
            result = 1
        expect result == 1

    it "maps Some value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: maps Some value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt = Some(10)
        val res = opt.map(_1 * 2)
        expect res.unwrap() == 20


# ============================================================================
# Test Group 8: Type Suffixes
# ============================================================================

describe "Type Suffixes":
    # ## Numeric Type Suffixes
    #
    # Tests for numeric literals with type suffixes.

    it "uses i32 suffix":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: uses i32 suffix")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 42i32
        expect x == 42

    it "uses i64 suffix":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: uses i64 suffix")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 100i64
        expect x == 100

    it "uses u32 suffix":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: uses u32 suffix")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 255u32
        expect x == 255

    it "uses unit suffix km":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: uses unit suffix km")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val distance = 100_km
        expect distance.value() == 100

    it "uses unit suffix in expression":
        # @req: REQ-FEATURE-USAGE-017
        step("Verify: uses unit suffix in expression")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 50_m
        val b = 30_m
        expect (a + b).value() == 80

    it "uses f64 suffix":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-018
        step("Verify: uses f64 suffix")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 3.15f64
        expect 1 == 1  # parsing test

    it "uses f32 suffix":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-019
        step("Verify: uses f32 suffix")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 1.5f32
        expect 1 == 1  # parsing test


# ============================================================================
# Test Group 9: Strong Enums
# ============================================================================

describe "Strong Enums":
    # ## Strong Enum Exhaustive Matching
    #
    # Tests for @strong enum attribute.

    it "matches exhaustively without wildcard":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: matches exhaustively without wildcard")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @strong
        enum Status:
            Active
            Inactive
            Pending
        val s = Status.Active
        var r = 0
        match s:
            case Status.Active:
                r = 1
            case Status.Inactive:
                r = 2
            case Status.Pending:
                r = 3
        expect r == 1

    it "allows wildcard in weak enum":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-021
        step("Verify: allows wildcard in weak enum")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        enum Status:
            Active
            Inactive
            Pending
        val s = Status.Active
        var result = 0
        match s:
            case Status.Active:
                result = 1
            case _:
                result = 0
        expect result == 1
