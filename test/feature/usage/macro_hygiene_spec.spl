"""
## Purpose and audience

# Macro Hygiene Specification

**Feature ID:** #MACRO-001
**Category:** Language | Macros
**Status:** Implemented

## Overview

Tests for macro hygiene system that prevents variable capture through
gensym renaming. Covers variable isolation, nested scopes, gensym uniqueness,
and pattern matching with hygiene.

## Syntax

```simple
macro make_ten() -> (returns result: Int):
emit result:
val x = 10
x

val x = 5
val result = make_ten!()
# x is still 5, result is 10
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/macro_hygiene_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Basic Hygiene
# ============================================================================

describe "Basic Macro Hygiene":
    # ## Variable Capture Prevention
    #
    # Tests for basic macro variable isolation.

    it "prevents variable capture":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: prevents variable capture")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro make_ten() -> (returns result: Int):
            emit result:
                val x = 10
                x
        val x = 5
        val result = make_ten!()
        expect x + result == 15

    it "isolates macro internal variables":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: isolates macro internal variables")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro increment() -> (returns result: Int):
            emit result:
                val temp = 1
                temp
        val a = increment!()
        val b = increment!()
        expect a + b == 2

    it "preserves outer variable after macro":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: preserves outer variable after macro")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro do_nothing() -> (returns result: Int):
            emit result:
                val value = 100
                value
        val value = 42
        val _ = do_nothing!()
        expect value == 42


# ============================================================================
# Test Group 2: Nested Scopes
# ============================================================================

describe "Nested Scope Hygiene":
    # ## Nested Scopes in Macros
    #
    # Tests for hygiene with nested scopes.

    it "handles nested scopes in macro":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: handles nested scopes in macro")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro nested_scopes() -> (returns result: Int):
            emit result:
                val x = 10
                val inner = if true: 20 else: 0
                x + inner
        expect nested_scopes!() == 30

    it "handles nested macro calls":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: handles nested macro calls")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro inner() -> (returns result: Int):
            emit result:
                val x = 5
                x
        macro outer() -> (returns result: Int):
            emit result:
                val x = 10
                x + inner!()
        expect outer!() == 15

    it "handles nested blocks":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: handles nested blocks")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro nested_blocks() -> (returns result: Int):
            emit result:
                val a = 1
                val b = if true: 2 + 3 else: 0
                a + b
        expect nested_blocks!() == 6


# ============================================================================
# Test Group 3: Gensym Uniqueness
# ============================================================================

describe "Gensym Uniqueness":
    # ## Unique Variable Names per Invocation
    #
    # Tests for gensym'd variable uniqueness.

    it "creates unique names across calls":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: creates unique names across calls")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro counter() -> (returns result: Int):
            emit result:
                val count = 1
                count
        val first = counter!()
        val second = counter!()
        val third = counter!()
        expect first + second + third == 3

    it "gensyms multiple variables":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: gensyms multiple variables")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro multi_vars() -> (returns result: Int):
            emit result:
                val a = 1
                val b = 2
                val c = 3
                a + b + c
        val x = 10
        val y = 20
        val z = 30
        val result = multi_vars!()
        expect x + y + z + result == 66


# ============================================================================
# Test Group 4: Pattern Matching
# ============================================================================

describe "Pattern Matching Hygiene":
    # ## Pattern Variables in Macros
    #
    # Tests for hygiene with pattern matching.

    it "isolates pattern variables":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: isolates pattern variables")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro make_pair() -> (returns result: Int):
            emit result:
                val (x, y) = (10, 20)
                x + y
        val x = 100
        val y = 200
        val result = make_pair!()
        expect x + y + result == 330

    it "isolates tuple destructuring":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: isolates tuple destructuring")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro swap_values() -> (returns result: Int):
            emit result:
                val (a, b) = (5, 10)
                b - a
        val a = 1
        val b = 2
        val result = swap_values!()
        expect a + b + result == 8

    it "isolates array destructuring":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: isolates array destructuring")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro sum_array() -> (returns result: Int):
            emit result:
                val [x, y, z] = [1, 2, 3]
                x + y + z
        val x = 10
        val y = 20
        val z = 30
        val result = sum_array!()
        expect x + y + z + result == 66


# ============================================================================
# Test Group 5: Function Parameters
# ============================================================================

describe "Function Parameter Hygiene":
    # ## Function Parameters in Macros
    #
    # Tests for hygiene with function definitions.

    it "isolates function parameters":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: isolates function parameters")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro func_test() -> (returns result: Int):
            emit result:
                fn add(x: Int, y: Int) -> Int:
                    return x + y
                add(3, 7)
        expect func_test!() == 10

    it "isolates function from outer scope":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: isolates function from outer scope")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro func_macro() -> (returns result: Int):
            emit result:
                fn multiplier(x: Int) -> Int:
                    return x * 2
                multiplier(5)
        val x = 100
        val result = func_macro!()
        expect x + result == 110

    it "handles nested functions":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: handles nested functions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro nested_func() -> (returns result: Int):
            emit result:
                fn outer(x: Int) -> Int:
                    fn inner(y: Int) -> Int:
                        return x + y
                    return inner(5)
                outer(10)
        expect nested_func!() == 15


# ============================================================================
# Test Group 6: Complex Integration
# ============================================================================

describe "Complex Macro Hygiene":
    # ## Complex Scenarios
    #
    # Tests for complex hygiene scenarios.

    it "handles complex multi-scope macro":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: handles complex multi-scope macro")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro complex() -> (returns result: Int):
            emit result:
                val temp = 1
                val sum1 = if true: 2 else: 0
                val sum2 = if true: 3 else: 0
                val sum3 = if true: 4 else: 0
                sum1 + sum2 + sum3 + temp
        expect complex!() == 10

    it "handles macro parameters":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: handles macro parameters")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro use_param(value: Int) -> (returns result: Int):
            emit result:
                val x = value + 10
                x
        val x = 5
        val result = use_param!(32)
        expect x + result == 47

    it "handles nested macros with same names":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-017
        step("Verify: handles nested macros with same names")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro base(n: Int) -> (returns result: Int):
            emit result:
                val temp = n * 2
                temp
        macro wrapper() -> (returns result: Int):
            emit result:
                val temp = 5
                val a = base!(temp)
                val b = base!(10)
                temp + a + b
        expect wrapper!() == 35


# ============================================================================
# Test Group 7: Edge Cases
# ============================================================================

describe "Macro Hygiene Edge Cases":
    # ## Edge Cases
    #
    # Tests for edge case scenarios.

    it "handles empty macro":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-018
        step("Verify: handles empty macro")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro empty() -> (returns result: Int):
            emit result:
                0
        expect empty!() == 0

    it "handles macro with early return":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-019
        step("Verify: handles macro with early return")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro early_return(cond: Bool) -> (returns result: Int):
            emit result:
                if cond:
                    return 100
                val x = 42
                x
        expect early_return!(false) == 42

    it "handles variable shadowing":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: handles variable shadowing")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro shadow_test() -> (returns result: Int):
            emit result:
                val x = 10
                val x = x + 5
                val x = x * 2
                x
        expect shadow_test!() == 30

