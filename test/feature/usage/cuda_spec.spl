"""
## Purpose and audience

# CUDA Backend

Real CUDA backend checks through the Simple `std.nogc_async_mut.cuda` surface.
These tests run against the compiled runtime rather than stub helpers.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/cuda_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec
use std.nogc_async_mut.cuda
use std.common.test_env_gate.{test_env_cuda_available, test_env_gate_skip}

fn invalid_ptx() -> text:
    "this is not valid PTX"

describe "CUDA runtime surface":
    if not test_env_cuda_available():
        it "env_skip: CUDA not available":
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: env_skip: CUDA not available")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val reason = test_env_gate_skip("SIMPLE_CUDA_TEST")
            expect(reason).to_contain("Skipped")
        return
    it "reports an internally consistent availability state":
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: reports an internally consistent availability state")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val available = cuda.cuda_available()
        val count = cuda.cuda_device_count()

        if available:
            expect(count).to_be_greater_than(0)
        else:
            expect(count).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "returns a stable init result":
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: returns a stable init result")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val init_rc = cuda.cuda_init()
        val available = cuda.cuda_available()
        val count = cuda.cuda_device_count()

        if available:
            expect(init_rc).to_equal(cuda.CUDA_SUCCESS)
            expect(count).to_be_greater_than(0)
        else:
            expect(count).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(init_rc == cuda.CUDA_SUCCESS or init_rc == cuda.CUDA_ERROR_NOT_INITIALIZED or init_rc == cuda.CUDA_ERROR_NO_DEVICE).to_equal(true)

    it "reports device metadata when CUDA is available":
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: reports device metadata when CUDA is available")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        if cuda.cuda_available():
            val device = cuda.cuda_device_get(0)
            val name = cuda.cuda_device_name(device)
            val cc = cuda.cuda_device_compute_capability(device)
            expect(device).to_be_greater_than(-1)
            expect(name.len()).to_be_greater_than(0)
            expect(cc).to_be_greater_than(0)
        else:
            expect(cuda.cuda_device_count()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "maps known error codes to text":
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: maps known error codes to text")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val msg = cuda.cuda_get_error_string(cuda.CUDA_ERROR_NOT_INITIALIZED)
        # When CUDA is compiled in, the message contains "NOT_INITIALIZED".
        # When CUDA support is disabled in the runtime, the stub returns a
        # fixed "CUDA support disabled" string instead.
        val has_info = msg.contains("NOT_INITIALIZED") or msg.contains("CUDA support disabled")
        expect(has_info).to_equal(true)

    it "rejects invalid PTX when CUDA is available":
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: rejects invalid PTX when CUDA is available")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val module = cuda.cuda_module_load_data(invalid_ptx())
        if cuda.cuda_available():
            expect(module).to_be_less_than(0)
        else:
            expect(module).to_equal(cuda.CUDA_ERROR_NOT_INITIALIZED)
