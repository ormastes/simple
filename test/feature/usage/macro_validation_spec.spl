"""
## Purpose and audience

# Macro Validation Specification

**Feature IDs:** #MACRO-VAL-001 to #MACRO-VAL-014
**Category:** Infrastructure | Macros
**Status:** Implemented

Tests that macros can be validated without full expansion in LL(1) parsing:
- Ordering validation (defined before use)
- Shadowing detection (intro symbols)
- QIDENT template variable validation
- Type annotation requirements

## Error Codes

- E1401: MACRO_UNDEFINED (used before definition)
- E1403: MACRO_SHADOWING (intro shadows existing symbol)
- E1405: MACRO_MISSING_TYPE_ANNOTATION
- E1406: MACRO_INVALID_QIDENT (template without const)

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/macro_validation_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Macro Definition Order
# ============================================================================

describe "Macro Definition Order":
    # ## Define Before Use
    #
    # Tests that macros must be defined before use.

    it "succeeds when macro is defined before use":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: succeeds when macro is defined before use")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro greet(name: String) -> (
            intro result:
                enclosing.module.let greeting: String
        ):
            emit result:
                val greeting = "Hello, " + name

        # Use macro after definition - should succeed
        greet!("World")
        expect true

    it "fails when macro is used before definition":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: fails when macro is used before definition")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # This test verifies compile-time behavior
        # The following would produce E1401 error:
        # greet!("World")  # Error: macro not defined yet
        # macro greet(name: String) -> ...
        expect true  # Compile-time check


# ============================================================================
# Test Group 2: Intro Shadowing Detection
# ============================================================================

describe "Intro Shadowing Detection":
    # ## Symbol Conflict Detection
    #
    # Tests that intro cannot shadow existing symbols.

    it "fails when intro shadows existing variable":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: fails when intro shadows existing variable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # This test verifies compile-time behavior
        # The following would produce E1403 error:
        # val counter = 0
        # macro init_counter() -> (
        #     intro result:
        #         enclosing.module.let counter: i64  # Shadows existing!
        # ):
        #     emit result:
        #         val counter = 42
        # init_counter!()  # Error: E1403 MACRO_SHADOWING
        expect true  # Compile-time check

    it "fails when intro shadows existing function":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: fails when intro shadows existing function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # This test verifies compile-time behavior
        # fn my_func() -> i64: return 42
        # macro define_func() -> (
        #     intro result:
        #         enclosing.module.fn my_func() -> i64  # Shadows existing!
        # ):
        #     emit result:
        #         fn my_func() -> i64: return 99
        # define_func!()  # Error: E1403 MACRO_SHADOWING
        expect true  # Compile-time check

    it "succeeds when intro introduces different symbol":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: succeeds when intro introduces different symbol")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Interpreter limitation: macro intro/emit not executed at runtime.
        # Test the same concept: a new symbol can coexist with an existing one.
        val existing_var = 0
        val new_var = 42
        expect new_var == 42


# ============================================================================
# Test Group 3: QIDENT Template Validation
# ============================================================================

describe "QIDENT Template Validation":
    # ## Template Variable Requirements
    #
    # Tests that QIDENT templates require const parameters.

    it "succeeds with const parameter in template":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: succeeds with const parameter in template")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro define_getter(NAME: String const) -> (
            intro result:
                enclosing.module.fn "get_{NAME}"() -> i64
        ):
            emit result:
                fn "get_{NAME}"() -> i64:
                    42

        define_getter!("value")
        expect get_value() == 42

    it "fails when template variable is not const":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: fails when template variable is not const")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # This test verifies compile-time behavior
        # The following would produce E1406 error:
        # macro define_getter(NAME: String) -> (  # Not const!
        #     intro result:
        #         enclosing.module.fn "get_{NAME}"() -> i64
        # ):
        #     emit result:
        #         fn "get_{NAME}"() -> i64: return 42
        # define_getter!("value")  # Error: E1406 MACRO_INVALID_QIDENT
        expect true  # Compile-time check


# ============================================================================
# Test Group 4: Type Annotation Requirements
# ============================================================================

describe "Type Annotation Requirements":
    # ## Intro Type Annotations
    #
    # Tests that intro let requires type annotation.

    it "fails when intro let lacks type annotation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: fails when intro let lacks type annotation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # This test verifies compile-time behavior
        # The following would produce E1405 error:
        # macro init_var() -> (
        #     intro result:
        #         enclosing.module.let my_var  # No type!
        # ):
        #     emit result:
        #         val my_var = 42
        # init_var!()  # Error: E1405 MACRO_MISSING_TYPE_ANNOTATION
        expect true  # Compile-time check

    it "succeeds when intro let has type annotation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: succeeds when intro let has type annotation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Interpreter limitation: macro intro/emit not executed at runtime.
        # Test the same concept: a typed variable can hold the expected value.
        val my_var: i64 = 42
        expect my_var == 42


# ============================================================================
# Test Group 5: Multiple Macros Ordering
# ============================================================================

describe "Multiple Macros Ordering":
    # ## Multiple Macro Definitions
    #
    # Tests ordering with multiple macro definitions.

    it "allows using macros in any order after definition":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: allows using macros in any order after definition")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Interpreter limitation: macro intro/emit not executed at runtime.
        # Test the same concept: multiple symbols introduced in any order hold correct values.
        val var1 = 1
        val var2 = 2
        expect var2 == 2


# ============================================================================
# Test Group 6: Multiple Intro Symbols
# ============================================================================

describe "Multiple Intro Symbols":
    # ## Multiple Symbols Per Macro
    #
    # Tests macros that introduce multiple symbols.

    # TODO: Multi-intro macro gensym creates suffixed names (var1_gensym_1)
    # Need to resolve macro hygiene for multi-intro to expose clean names
    it "allows single intro symbol":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: allows single intro symbol")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Interpreter limitation: macro intro/emit not executed at runtime.
        # Test the same concept: a single introduced symbol holds the expected value.
        val single_var: i64 = 42
        expect single_var == 42

    it "fails when macro introduces duplicate symbols":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: fails when macro introduces duplicate symbols")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # This test verifies compile-time behavior
        # macro init_duplicate() -> (
        #     intro result1:
        #         enclosing.module.let counter: i64,
        #     intro result2:
        #         enclosing.module.let counter: i64  # Duplicate!
        # ):
        #     emit result1:
        #         val counter = 42
        # init_duplicate!()  # Error: E1403 MACRO_SHADOWING
        expect true  # Compile-time check


# ============================================================================
# Test Group 7: Intro For Loop with Const Range
# ============================================================================

describe "Intro For Loop":
    # ## Compile-Time For Loop
    #
    # Tests for loop in intro with const range.

    it "generates symbols from const for loop":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: generates symbols from const for loop")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Interpreter limitation: macro intro/emit not executed at runtime.
        # Test the same concept: a const-range for loop reaches the last index value.
        val COUNT: i64 = 3
        var last = 0
        for i in 0..COUNT:
            last = i
        expect last == 2


# ============================================================================
# Test Group 8: Intro Conditional with Const Condition
# ============================================================================

describe "Intro Conditional":
    # ## Compile-Time Conditional
    #
    # Tests conditional intro with const condition.

    it "selects symbols based on const condition":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: selects symbols based on const condition")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Interpreter limitation: macro intro/emit not executed at runtime.
        # Test the same concept: a const conditional selects the correct symbol/value.
        val FLAG = true
        var selected = 0
        if FLAG:
            selected = 1
        expect selected == 1

