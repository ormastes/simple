describe "Array Aggregation":
    # ## Sum, Min, Max, Count
    #
    # Tests numeric aggregation methods.

    it "sums numeric array":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: sums numeric array")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [1, 2, 3, 4]
        expect arr.sum() == 10

    it "sum of empty array is zero":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: sum of empty array is zero")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr: [i64] = []
        expect arr.sum() == 0

    it "finds minimum value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: finds minimum value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [3, 1, 4, 1, 5]
        expect arr.min() == 1

    it "finds maximum value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: finds maximum value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [3, 1, 4, 1, 5]
        expect arr.max() == 5

    it "min of empty array is nil":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-017
        step("Verify: min of empty array is nil")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr: [i64] = []
        expect arr.min() == nil

    it "max of empty array is nil":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-018
        step("Verify: max of empty array is nil")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr: [i64] = []
        expect arr.max() == nil

    it "counts occurrences":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-019
        step("Verify: counts occurrences")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [1, 2, 1, 3, 1]
        expect arr.count_of(1) == 3
        expect arr.count_of(2) == 1
        expect arr.count_of(99) == 0


# ============================================================================
# Test Group 6: Array Transformation
# ============================================================================

describe "Array Transformation":
    # ## Zip, Enumerate, Flatten, Unique
    #
    # Tests array transformation methods.

    it "zips two arrays into tuples":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: zips two arrays into tuples")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = [1, 2, 3]
        val b = [10, 20, 30]
        val z = a.zip(b)
        expect z[0] == (1, 10)
        expect z.len() == 3
        expect z[1] == (2, 20)
        expect z[2] == (3, 30)

    it "enumerates array with indices":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-021
        step("Verify: enumerates array with indices")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [10, 20, 30]
        val e = arr.enumerate()
        expect e[0] == (0, 10)
        expect e.len() == 3
        expect e[1] == (1, 20)
        expect e[2] == (2, 30)

    it "flattens nested arrays":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-022
        step("Verify: flattens nested arrays")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val nested = [[1, 2], [3, 4], [5]]
        val result = nested.flatten()
        expect result[0] == 1
        expect result.len() == 5
        expect result[2] == 3
        expect result[4] == 5

    it "removes duplicates":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-023
        step("Verify: removes duplicates")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [1, 2, 1, 3, 2, 1]
        val u = arr.unique()
        expect u[0] == 1
        expect u.len() == 3
        expect u[1] == 2
        expect u[2] == 3


