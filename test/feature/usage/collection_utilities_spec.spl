# ============================================================================
# Test Group 12: Dictionary Operations
# ============================================================================

describe "Dictionary Operations":
    # ## Dictionary Creation and Manipulation
    #
    # Tests dictionary functionality.

    it "creates empty dict":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-037
        step("Verify: creates empty dict")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val d = {}
        expect d.len() == 0

    it "sets and gets values":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-038
        step("Verify: sets and gets values")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var d = {}
        d["name"] = "Alice"
        d["age"] = 30
        expect d.len() == 2
        expect d["age"] == 30

    it "overwrites existing key":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-039
        step("Verify: overwrites existing key")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var d = {"counter": 1}
        d["counter"] = 2
        expect d.len() == 1
        expect d["counter"] == 2

    it "returns nil for missing key":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-040
        step("Verify: returns nil for missing key")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val d = {"a": 1}
        expect d["missing"] == nil

