"""
## Purpose and audience

# Collection Utilities Specification


**Feature IDs:** #COLL-UTIL-001 to #COLL-UTIL-052
**Category:** Runtime | Collections
**Status:** Implemented

Tests collection utility functions including:
- Array sorting and reversing
- Array aggregation (sum, min, max, count)
- Array transformation (zip, enumerate, flatten, unique)
- Array slicing (take, drop)
- Array predicates (all_truthy, any_truthy)
- Tuple operations
- String operations
- Dictionary operations

## Array Utility Methods

```simple
# Sorting (returns new array)
val sorted = arr.sort()      # Returns new sorted array
val sorted = arr.sorted()    # Alias for sort

# Reversing (returns new array)
val rev = arr.reverse()      # Returns new reversed array
val rev = arr.reversed()     # Alias for reverse

# Access
arr.first()             # First element or nil
arr.last()              # Last element or nil
arr.index_of(value)     # Index or -1 if not found

# Aggregation
arr.sum()               # Sum of numeric elements
arr.min()               # Minimum value or nil
arr.max()               # Maximum value or nil
arr.count_of(value)     # Count occurrences of specific value

# Transformation
arr.concat(other)       # Concatenate arrays
arr.copy()              # Shallow copy
arr.zip(other)          # Zip into tuples
arr.enumerate()         # Add indices as tuples
arr.flatten()           # Flatten nested arrays
arr.unique()            # Remove duplicates
arr.take(n)             # First n elements
arr.drop(n)             # Skip first n elements

# Predicates
arr.all_truthy()        # All elements truthy?
arr.any_truthy()        # Any element truthy?
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/collection_utilities_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Array Sorting
# ============================================================================

describe "Array Sorting":
    # ## Sorting Returns New Array
    #
    # Tests sort() and sorted() methods.

    it "sort returns new sorted array":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: sort returns new sorted array")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [3, 1, 4, 1, 5]
        val s = arr.sort()
        expect s[0] == 1
        expect s[1] == 1
        expect s[2] == 3
        expect s[3] == 4
        expect s[4] == 5

    it "sorted returns new sorted array":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: sorted returns new sorted array")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [3, 1, 2]
        val s = arr.sorted()
        # Original unchanged
        expect arr[0] == 3
        # New array sorted
        expect s[0] == 1
        expect s[1] == 2
        expect s[2] == 3


# ============================================================================
# Test Group 2: Array Reversing
# ============================================================================

describe "Array Reversing":
    # ## Reversing Returns New Array
    #
    # Tests reverse() and reversed() methods.

    it "reverse returns new reversed array":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: reverse returns new reversed array")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [1, 2, 3]
        val r = arr.reverse()
        expect r[0] == 3
        expect r[1] == 2
        expect r[2] == 1

    it "reversed returns new reversed array":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: reversed returns new reversed array")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [1, 2, 3]
        val r = arr.reversed()
        # Original unchanged
        expect arr[0] == 1
        # New array reversed
        expect r[0] == 3
        expect r[1] == 2
        expect r[2] == 1


# ============================================================================
# Test Group 3: Array Access Methods
# ============================================================================

describe "Array Access Methods":
    # ## First, Last, Index Lookup
    #
    # Tests array element access methods.

    it "first returns first element":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: first returns first element")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [10, 20, 30]
        expect arr.first() == 10

    it "last returns last element":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: last returns last element")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [10, 20, 30]
        expect arr.last() == 30

    it "first returns nil for empty array":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: first returns nil for empty array")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr: [i64] = []
        expect arr.first() == nil

    it "last returns nil for empty array":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: last returns nil for empty array")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr: [i64] = []
        expect arr.last() == nil

    it "index_of finds element":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: index_of finds element")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [10, 20, 30, 20]
        expect arr.index_of(20) == 1  # First occurrence

    it "index_of returns -1 when not found":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: index_of returns -1 when not found")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [10, 20, 30]
        expect arr.index_of(99) == -1


