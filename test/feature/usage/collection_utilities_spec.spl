# Test Group 8: Array Predicates
# ============================================================================

describe "Array Predicates":
    # ## All and Any Truthy
    #
    # Tests array truthiness predicates.

    it "all_truthy returns true when all truthy":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-026
        step("Verify: all_truthy returns true when all truthy")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [1, 2, 3]
        expect arr.all_truthy()

    it "all_truthy returns false with zero":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-027
        step("Verify: all_truthy returns false with zero")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [1, 0, 3]
        expect not arr.all_truthy()

    it "any_truthy returns true with some truthy":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-028
        step("Verify: any_truthy returns true with some truthy")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [0, 0, 1]
        expect arr.any_truthy()

    it "any_truthy returns false when all zero":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-029
        step("Verify: any_truthy returns false when all zero")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [0, 0, 0]
        expect not arr.any_truthy()


