describe "Array Concatenation and Copy":
    # ## Combining and Duplicating Arrays
    #
    # Tests concat() and copy() methods.

    it "concatenates two arrays":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: concatenates two arrays")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = [1, 2]
        val b = [3, 4]
        val c = a.concat(b)
        expect c[0] == 1
        expect c.len() == 4
        expect c[2] == 3
        expect c[3] == 4

    it "creates shallow copy":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: creates shallow copy")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [1, 2, 3]
        val c = arr.copy()
        expect c[0] == 1
        expect c.len() == 3
        expect c[1] == 2
        expect c[2] == 3


