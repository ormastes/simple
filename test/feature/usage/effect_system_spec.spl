# Test Group 3: @async Effect
# ============================================================================

describe "@async Effect":
    # ## Async Function Semantics
    #
    # Tests that @async decorator works like async fn.

    it "async decorator syntax works":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: async decorator syntax works")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @async
        fn compute(x: i64) -> i64:
            x * 2

        expect await compute(21) == 42

    it "async allows non-blocking io":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: async allows non-blocking io")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @async
        fn greet() -> i64:
            print("hello")
            42

        expect await greet() == 42


