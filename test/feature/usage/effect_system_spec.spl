        # @req: REQ-FEATURE-USAGE-004
        step("Verify: io function can do computation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @io
        fn compute_and_return(x: i64) -> i64:
            x * 2

        expect compute_and_return(21) == 42


