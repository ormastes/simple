# ============================================================================
# Test Group 7: Stacked Effects
# ============================================================================

describe "Stacked Effects":
    # ## Multiple Effect Decorators
    #
    # Tests that multiple effects can be stacked on one function.

    it "pure and async together":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: pure and async together")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @pure
        @async
        fn fast_compute(x: i64) -> i64:
            x * 2

        expect await fast_compute(21) == 42

    it "io and net together":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: io and net together")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @io
        @net
        fn network_logger(x: i64) -> i64:
            x * 2

        expect network_logger(21) == 42

    it "all effects together":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: all effects together")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @io
        @net
        @fs
        fn full_access(x: i64) -> i64:
            x * 2

        expect full_access(21) == 42

    it "all effects parsed":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: all effects parsed")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @pure
        @io
        @net
        @fs
        @unsafe
        fn all_effects(x: i64) -> i64:
            x

        expect all_effects(42) == 42


