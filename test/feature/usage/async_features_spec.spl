"""
## Purpose and audience

async features - runtime parser cannot handle async/await/spawn/yield/generator syntax
Tests using unsupported syntax converted to itstubs
# Async Features Specification


**Feature IDs:** #ASYNC-001 to #ASYNC-063
**Category:** Runtime | Async
**Status:** Implemented

Tests async features including:
- Lambda expressions
- Future creation and await
- Async functions
- Generators and yield
- Codegen/interpreter parity

Features not supported by runtime parser:
- async fn syntax
- await keyword
- spawn keyword
- yield keyword
- generator() function

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/async_features_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")

# ============================================================================
# Test Group 1: Lambda Expressions
# ============================================================================

describe "Lambda Expressions":
    # ## Lambda Syntax
    #
    # Tests lambda expression parsing and execution.

    it "basic lambda with single param":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: basic lambda with single param")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val double = \x: x * 2
        check(double(21) == 42)

    it "lambda with multiple params":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: lambda with multiple params")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val add = \x, y: x + y
        check(add(15, 27) == 42)

    it "lambda capturing outer variable":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: lambda capturing outer variable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val multiplier = 10
        val multiply = \x: x * multiplier
        check(multiply(4) == 40)

    it "immediately invoked lambda":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: immediately invoked lambda")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check((\x: x + 5)(37) == 42)

    it "nested lambda calls":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: nested lambda calls")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val double = \x: x * 2
        val add_one = \x: x + 1
        check(add_one(double(20)) == 41)

    it "lambda with no params":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: lambda with no params")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val answer = \: 42
        check(answer() == 42)


