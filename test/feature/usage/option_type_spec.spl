"""
## Purpose and audience

# Option Type Specification

**Feature ID:** #OPT-001
**Category:** Language
**Difficulty:** 2/5
**Status:** Implemented

## Overview

Tests for the Option type representing values that may or may not be present,
including constructors, pattern matching, and safe unwrapping mechanisms.

## Syntax

```simple
val maybe_value: Option<i32> = Some(42)
val no_value: Option<text> = nil

match maybe_value:
Some(x) => print "Value is {x}"
None => print "No value"

val unwrapped = maybe_value.unwrap()           # Raises if None
val safe = maybe_value.unwrap_or(0)            # Default if None
val mapped = maybe_value.map(_1 * 2)           # Transform if Some
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Some | Option containing a value |
| None | Option representing absence of value |
| Unwrapping | Extracting value from Option |
| Safe Unwrap | Get value or default/error handling |
| Composition | Chaining operations on Options |

## Behavior

- Option<T> is generic over type T
- Some(value) contains a value of type T
- None represents absence (no value)
- Pattern matching provides exhaustive case handling
- map/filter/flat_map for functional composition
- unwrap() raises error, unwrap_or() provides default value
- Existence check with .? operator

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/option_type_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Basic Option Usage
# ============================================================================

describe "Option Type Basic Usage":
    # ## Option Construction and Access
    #
    # Verifies creation of Some/None values, basic unwrapping,
    # and pattern matching with Option types.

    context "Some values":
        it "creates Some with value":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: creates Some with value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val opt = Some(42)
            expect opt.unwrap() == 42

        it "checks Some is some":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: checks Some is some")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val opt = Some(1)
            expect opt.is_some()

    context "None values":
        it "creates None":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: creates None")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val opt = nil
            expect opt.is_none()

        it "uses unwrap_or for None":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: uses unwrap_or for None")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val opt = nil
            expect opt.unwrap_or(99) == 99


# ============================================================================
# Test Group 2: Option Transformations
# ============================================================================

describe "Option Type Transformations":
    # ## Functional Composition
    #
    # Tests map, filter, flat_map, and other functional operations
    # on Option values for elegant chaining and composition.

    it "maps Some value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: maps Some value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt = Some(10)
        val res = opt.map(_1 * 2)
        expect res.unwrap() == 20

    it "maps None returns None":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: maps None returns None")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt: Option<i64> = nil
        val res = opt.map(_1 * 2)
        expect res.is_none()


# ============================================================================
# Test Group 3: Existence Check Operator
# ============================================================================

describe "Existence Check Operator":
    # ## .? Operator for Option
    #
    # Tests the existence check operator for concise Option handling.

    it "returns true for Some":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: returns true for Some")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt = Some(42)
        expect opt.?

    it "returns false for None":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: returns false for None")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt: Option<i64> = nil
        expect not opt.?
