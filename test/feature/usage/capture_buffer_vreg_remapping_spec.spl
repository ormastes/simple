describe "Register Spillage":
    # ## Register Spillage
    #
    # Tests behavior when too many values are live (spillage to stack/memory).

    it "handles many live values":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-032
        step("Verify: handles many live values")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 1
        val b = 2
        val c = 3
        val d = 4
        val e = 5
        val result = a + b + c + d + e
        expect result == 15

    it "handles complex expressions with many values":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-033
        step("Verify: handles complex expressions with many values")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = ((1 + 2) * (3 + 4)) + ((5 + 6) * (7 + 8))
        expect result == 186


