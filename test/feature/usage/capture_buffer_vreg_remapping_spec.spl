# ============================================================================
# Test Group 4: Virtual Register Reuse Across Scopes
# ============================================================================

describe "Virtual Register Reuse":
    # ## Virtual Register Reuse
    #
    # Tests that virtual registers are reused when values don't interfere.

    it "reuses vreg in sequential statements":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: reuses vreg in sequential statements")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 10
        val b = 20          # a is dead, can reuse its vreg
        expect b == 20

    it "reuses vreg after value is no longer needed":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: reuses vreg after value is no longer needed")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var x = 5
        x = x + 10          # Old value can be reused
        expect x == 15

    it "does not reuse interfering vregs":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: does not reuse interfering vregs")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 10
        val b = a + 20      # a is still live, must use different vreg
        expect b == 30

    it "reuses vregs in branches":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: reuses vregs in branches")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cond = true
        val x = if cond: 10 else: 20
        expect x == 10


