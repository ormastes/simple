describe "Live Range Analysis":
    # ## Live Range Analysis
    #
    # Tests correct identification of variable live ranges.

    it "detects live range of simple variable":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: detects live range of simple variable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 5
        val y = x + 1       # x is live here
        expect y == 6

    it "detects live range extends to final use":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-017
        step("Verify: detects live range extends to final use")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 10
        val b = 20
        val c = a + b       # Both a and b are live
        expect c == 30

    it "detects live range ends after last use":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-018
        step("Verify: detects live range ends after last use")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val temp = 100
        val result = temp * 2  # temp is dead after this
        expect result == 200

    it "handles nested live ranges":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-019
        step("Verify: handles nested live ranges")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val outer = 5
        val inner = outer + 10
        val combined = outer + inner
        expect combined == 20


# ============================================================================
# Test Group 6: Register Remapping in Loops
# ============================================================================

describe "Register Remapping in Loops":
    # ## Register Remapping in Loops
    #
    # Tests virtual register remapping optimization in loop contexts.

    it "remaps vregs in loop iterations":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: remaps vregs in loop iterations")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var sum = 0
        for i in [1, 2, 3]:
            val local = i * 2    # Can reuse vreg each iteration
            sum = sum + local
        expect sum == 12

    it "handles nested loops with remapping":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-021
        step("Verify: handles nested loops with remapping")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var count = 0
        for i in [0, 1]:
            for j in [0, 1]:
                count = count + 1
        expect count == 4

    it "preserves values across loop iterations":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-022
        step("Verify: preserves values across loop iterations")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var accumulated = []
        for i in [1, 2, 3]:
            accumulated.push(i)
        expect accumulated.len() == 3


