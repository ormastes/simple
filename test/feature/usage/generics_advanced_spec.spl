"""
## Purpose and audience

# Advanced Generics Specification

**Feature IDs:** #GEN-ADV-001 to #GEN-ADV-008
**Category:** Type System | Generics
**Status:** Implemented

Tests advanced generic features including:
- Const generic parameters
- Where clauses on functions
- impl Trait for Type syntax
- Nested generic types
- Tuple return types
- Multiple trait bounds
- Associated types

## Syntax

```simple
# Const generics
struct Array<T, const N: usize>:
data: T

# Where clause
fn filled(value: T) -> T where T: Copy:
value

# impl Trait for Type
impl Len for MyList:
fn len() -> i64:
self.size

# Multiple trait bounds
fn make<T>() -> T where T: Clone + Default:
T.default()

# Associated types
trait Iterator:
type Item
fn next() -> Option<Self.Item>
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/generics_advanced_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Const Generic Parameters
# ============================================================================

describe "Const Generic Parameters":
    # ## const N: usize Syntax
    #
    # Tests const generic parameter parsing.

    it "parses const generic parameter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: parses const generic parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        struct Array<T, const N: usize>:
            data: T

        expect true  # Parsed successfully


# ============================================================================
# Test Group 2: Where Clauses
# ============================================================================

describe "Where Clauses":
    # ## Where Clause on Functions
    #
    # Tests where clause parsing and validation.

    it "parses where clause on function":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: parses where clause on function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Copy:
            fn copy() -> Self

        fn filled(value: i64) -> i64 where i64: Copy:
            value

        expect filled(42) == 42


# ============================================================================
# Test Group 3: impl Trait for Type
# ============================================================================

describe "impl Trait for Type":
    # ## Trait Implementation Syntax
    #
    # Tests impl Trait for Type parsing.

    it "parses impl trait for type":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: parses impl trait for type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Len:
            fn len() -> i64

        struct MyList:
            size: i64

        impl Len for MyList:
            fn len() -> i64:
                self.size

        val list = MyList(size: 42)
        expect list.len() == 42


# ============================================================================
# Test Group 4: Generic impl with Where
# ============================================================================

describe "Generic impl with Where":
    # ## Generic Implementation
    #
    # Tests generic impl blocks.

    it "parses generic impl with where":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: parses generic impl with where")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Clone:
            fn clone() -> Self

        impl Clone for i64:
            fn clone() -> i64:
                self

        # Note: impl for built-in types doesn't register methods in interpreter
        # Just verify that the declaration parses successfully
        expect true


# ============================================================================
# Test Group 5: Nested Generic Types
# ============================================================================

describe "Nested Generic Types":
    # ## Nested Generics
    #
    # Tests nested generic type parsing like List<Option<T>>.

    it "parses nested generic types":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: parses nested generic types")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        struct Container:
            items: [Option<i64>]

        expect true  # Parsed successfully


# ============================================================================
# Test Group 6: Tuple Return Types
# ============================================================================

describe "Tuple Return Types":
    # ## Tuple Return Type Syntax
    #
    # Tests function with tuple return type.

    it "parses tuple return type":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: parses tuple return type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn get_pair() -> (i64, str):
            (42, "hello")

        val _pair = get_pair()
        val num = _pair[0]
        val txt = _pair[1]
        expect num == 42
        expect txt == "hello"


# ============================================================================
# Test Group 7: Multiple Trait Bounds
# ============================================================================

describe "Multiple Trait Bounds":
    # ## T: Clone + Default Syntax
    #
    # Tests multiple trait bounds with +.

    it "parses multiple trait bounds":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: parses multiple trait bounds")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Clone:
            fn clone() -> Self

        trait Default:
            fn default() -> Self

        fn make<T>() -> T where T: Clone + Default:
            T.default()

        expect true  # Parsed successfully


# ============================================================================
# Test Group 8: Associated Types
# ============================================================================

describe "Associated Types":
    # ## type Item in Trait
    #
    # Tests associated type syntax in traits.

    it "parses associated type":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: parses associated type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Iterator:
            type Item

            fn next() -> Option<Self.Item>

        expect true  # Parsed successfully

