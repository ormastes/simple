"""
## Purpose and audience

# CLI Args Migration Compatibility Specification

**Feature ID:** #CLI-011
**Category:** Language | CLI
**Status:** Draft

## Overview

Tests compatibility between the new cli keyword and the existing manual
argument parsing pattern. Projects using manual arg parsing should be
able to incrementally migrate to the cli keyword without breaking
existing functionality.

## Manual Pattern (Before)

```simple
val args = get_args()
var verbose = false
var output = "default.txt"
for arg in args:
    if arg == "--verbose":
        verbose = true
    elif arg == "--output":
        output = next_arg()
```

## CLI Keyword (After)

```simple
cli:
    verbose: false
    output: "default.txt"
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/cli_args_migration_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# CLI Args Migration Compatibility
# ============================================================================

describe "CLI Args Migration Compatibility":
    # ## Compatibility with Manual Parsing Pattern
    #
    # Tests that the cli keyword produces equivalent results to manual parsing.

    context "equivalent behavior":
        it "produces same defaults as manual parsing":
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: produces same defaults as manual parsing")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Manual pattern:
            # var verbose = false
            # var output = "default.txt"
            #
            # CLI keyword:
            # cli:
            #     verbose: false
            #     output: "default.txt"
            #
            # Both should yield the same default values
            val manual_verbose = false
            val manual_output = "default.txt"
            val cli_verbose = false
            val cli_output = "default.txt"
            expect(cli_verbose).to_equal(manual_verbose)
            expect(cli_output).to_equal(manual_output)

        it "produces same parsed values as manual parsing":
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: produces same parsed values as manual parsing")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Given args: ["--verbose", "--output", "custom.txt"]
            # Manual: loops and matches each arg
            # CLI: cli.parse(args) returns struct
            # Both should produce verbose=true, output="custom.txt"
            val manual_verbose = true
            val manual_output = "custom.txt"
            val cli_verbose = true
            val cli_output = "custom.txt"
            expect(cli_verbose).to_equal(manual_verbose)
            expect(cli_output).to_equal(manual_output)

    context "incremental migration":
        it "can coexist with manual parsing in same project":
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: can coexist with manual parsing in same project")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Some modules use cli keyword, others use manual parsing
            # No conflicts between the two approaches
            val cli_module_works = true
            val manual_module_works = true
            expect(cli_module_works).to_equal(true)
            expect(manual_module_works).to_equal(true)

        it "supports gradual option-by-option migration":
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: supports gradual option-by-option migration")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # A project can migrate one option at a time from manual to cli
            # The cli keyword does not require all-or-nothing adoption
            val partial_migration = true
            expect(partial_migration).to_equal(true)
