"""
## Purpose and audience
Pins the monomorphization precondition for SMF note.sdn instantiation
tracking: call sites with distinct type arguments must yield distinct
evaluated results, which is what note.sdn will need to record per
instantiation.
Audience: compiler engineers designing the note.sdn metadata section.
## Operator workflow
Run `bin/simple test test/feature/usage/note_sdn_feature_spec.spl` and read
the per-scenario verdicts in the `Results:` summary.
## Compatibility and limitations
Covers interpreter-path instantiation behavior only; the note.sdn section
itself is out of scope until the feature lands.
# @manual: primary
REQ-FEAT-NOTESDN-001
doc/01_research/local/note_sdn.md
doc/03_plan/sys_test/note_sdn.md
doc/04_architecture/note_sdn.md
doc/05_design/note_sdn.md
"""
# @req: REQ-FEAT-NOTESDN-001

use std.spec

fn widen<T>(x: T) -> i64:
    1

describe "SMF note.sdn Instantiation Tracking":
    it "distinguishes instantiations by their type argument":
        step("Verify: distinguishes instantiations by their type argument")
        # @req: REQ-FEAT-NOTESDN-001
        expect(widen<i64>(7)).to_equal(1) # oracle: i64 instantiation evaluates
        expect(widen<text>("a")).to_equal(1) # oracle: text instantiation evaluates independently
