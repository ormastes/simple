describe "Arithmetic Practical Examples":
    # ## Practical Examples
    #
    # Real-world arithmetic scenarios.

    it "calculates average":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-079
        step("Verify: calculates average")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val sum = 10 + 20 + 30
        val avg = sum / 3
        expect avg == 20

    it "calculates compound interest":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-080
        step("Verify: calculates compound interest")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val principal = 1000
        val rate = 5
        val years = 2
        val interest = principal * rate / 100 * years
        expect interest == 100

    it "calculates area of rectangle":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-081
        step("Verify: calculates area of rectangle")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val width = 10
        val height = 5
        val area = width * height
        expect area == 50

    it "converts between units":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-082
        step("Verify: converts between units")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val kilometers = 5
        val meters = kilometers * 1000
        expect meters == 5000

    it "calculates percentage":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-083
        step("Verify: calculates percentage")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val total = 200
        val part = 50
        val percent = part * 100 / total
        expect percent == 25
