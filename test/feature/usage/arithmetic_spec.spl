        # @req: REQ-FEATURE-USAGE-072
        step("Verify: sums array with loop")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [1, 2, 3, 4, 5]
        var sum = 0
        for i in arr:
            sum = sum + i
        expect sum == 15

    it "multiply each element":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-073
        step("Verify: multiply each element")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [1, 2, 3]
        var product = 1
        for i in arr:
            product = product * i
        expect product == 6

    it "arithmetic on array indices":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-074
        step("Verify: arithmetic on array indices")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [10, 20, 30, 40, 50]
        expect arr[2 + 1] == 40


