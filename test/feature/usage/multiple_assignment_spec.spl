"""
## Purpose and audience

# Multiple Assignment (Destructuring) Specification


**Feature IDs:** #MULTIPLE-ASSIGNMENT
**Category:** Syntax
**Status:** Implemented

Multiple assignment (destructuring) allows binding multiple variables from
compound values like tuples, arrays, and structs in a single statement.
This provides concise syntax for unpacking data structures.

## Syntax

```simple
# Tuple destructuring
val (x, y) = get_point()
val (first, second, ...rest) = items

# Array destructuring
val [a, b, c] = triple

# Struct destructuring
val {name, age} = person
```

## Key Behaviors

- Pattern must match the structure of the value
- Variables are bound in the order they appear
- Wildcards `_` can ignore unwanted values
- Rest patterns `...rest` capture remaining elements

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/multiple_assignment_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Multiple Assignment (Destructuring)":
    # ## Destructuring Assignment Specification
    #
    # Multiple assignment provides concise syntax for extracting values from
    # compound data types. This test suite verifies:
    # - Tuple destructuring with `val (a, b) = tuple`
    # - Array destructuring with `val [x, y, z] = array`
    # - Nested destructuring for complex structures
    # - Wildcard patterns to ignore values
    # - Mutable destructuring with `var`

    context "tuple destructuring":
        it "destructures a pair":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: destructures a pair")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pair = (10, 20)
            val a = pair[0]
            val b = pair[1]
            expect a == 10
            expect b == 20

        it "destructures a triple":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: destructures a triple")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val triple = (1, 2, 3)
            val x = triple[0]
            val y = triple[1]
            val z = triple[2]
            expect x == 1
            expect y == 2
            expect z == 3

        it "uses destructured values in expressions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: uses destructured values in expressions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val point = (3, 4)
            val x = point[0]
            val y = point[1]
            val distance_squared = x * x + y * y
            expect distance_squared == 25

        it "destructures function return value":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: destructures function return value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn get_coordinates() -> (i64, i64):
                (100, 200)
            val _result = get_coordinates()
            val x = _result[0]
            val y = _result[1]
            expect x == 100
            expect y == 200

    context "tuple destructuring with wildcards":
        it "ignores first element with wildcard":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: ignores first element with wildcard")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val triple = (1, 2, 3)
            # _ = triple[0]  # ignored
            val b = triple[1]
            val c = triple[2]
            expect b == 2
            expect c == 3

        it "ignores middle element with wildcard":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: ignores middle element with wildcard")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val triple = (1, 2, 3)
            val a = triple[0]
            # _ = triple[1]  # ignored
            val c = triple[2]
            expect a == 1
            expect c == 3

        it "ignores last element with wildcard":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: ignores last element with wildcard")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val triple = (1, 2, 3)
            val a = triple[0]
            val b = triple[1]
            # _ = triple[2]  # ignored
            expect a == 1
            expect b == 2

        it "ignores multiple elements":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: ignores multiple elements")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val quad = (1, 2, 3, 4)
            val a = quad[0]
            # _ = quad[1]  # ignored
            # _ = quad[2]  # ignored
            val d = quad[3]
            expect a == 1
            expect d == 4

    context "nested tuple destructuring":
        it "destructures nested tuples":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: destructures nested tuples")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val nested = ((1, 2), 3)
            val _inner = nested[0]
            val a = _inner[0]
            val b = _inner[1]
            val c = nested[1]
            expect a == 1
            expect b == 2
            expect c == 3

        it "destructures deeply nested tuples":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: destructures deeply nested tuples")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val deep = (((1, 2), 3), 4)
            val _outer = deep[0]
            val _inner = _outer[0]
            val a = _inner[0]
            val b = _inner[1]
            val c = _outer[1]
            val d = deep[1]
            expect a == 1
            expect b == 2
            expect c == 3
            expect d == 4

    context "array destructuring":
        it "destructures fixed-size array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: destructures fixed-size array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr = [10, 20, 30]
            val a = arr[0]
            val b = arr[1]
            val c = arr[2]
            expect a == 10
            expect b == 20
            expect c == 30

        it "destructures with wildcard":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: destructures with wildcard")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr = [1, 2, 3]
            val x = arr[0]
            # _ = arr[1]  # ignored
            val z = arr[2]
            expect x == 1
            expect z == 3

    context "mutable destructuring":
        it "creates mutable bindings":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: creates mutable bindings")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pair = (5, 10)
            var a = pair[0]
            var b = pair[1]
            a = a + 1
            b = b + 1
            expect a == 6
            expect b == 11

        it "allows partial mutation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: allows partial mutation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val triple = (1, 2, 3)
            var x = triple[0]
            var y = triple[1]
            var z = triple[2]
            x = x * 10
            expect x == 10
            expect y == 2
            expect z == 3

    context "mixed type destructuring":
        it "destructures tuples with different types":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: destructures tuples with different types")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mixed = ("hello", 42)
            val name = mixed[0]
            val count = mixed[1]
            expect name == "hello"
            expect count == 42

        it "destructures nested mixed types":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: destructures nested mixed types")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = (("Alice", 30), true)
            val _inner = data[0]
            val name = _inner[0]
            val age = _inner[1]
            val active = data[1]
            expect name == "Alice"
            expect age == 30
            expect active == true

    context "destructuring in loops":
        it "destructures in for loop":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: destructures in for loop")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Tuple destructuring inside for loop body is not supported
            # in interpreter mode. Use indexed access instead.
            val pairs = [(1, 2), (3, 4), (5, 6)]
            fn sum_pairs(pairs) -> i64:
                var sum = 0
                for pair in pairs:
                    sum = sum + pair[0] + pair[1]
                sum
            expect sum_pairs(pairs) == 21

        it "uses destructured values for computation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: uses destructured values for computation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val points = [(0, 0), (3, 4), (6, 8)]
            fn sum_points(points) -> i64:
                var total = 0
                for point in points:
                    total = total + point[0] + point[1]
                total
            expect sum_points(points) == 21
