"""
## Purpose and audience

# Parser Syntax Validation Specification


**Feature IDs:** #PARSER-VAL-001 to #PARSER-VAL-015
**Category:** Infrastructure | Parser
**Status:** Implemented

Tests that the parser correctly validates syntax and provides helpful
error messages. Includes tests for correct Simple syntax that should
parse successfully.

## Key Validations

- Proper indentation handling
- Comment parsing (single-line, multi-line)
- Whitespace handling
- Newline requirements
- Block structure validation

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/parser_syntax_validation_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Comment Parsing
# ============================================================================

fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")
describe "Comment Parsing":
    # ## Single and Multi-Line Comments
    #
    # Tests that comments are correctly parsed and ignored.

    context "single-line comments":
        it "parses code with trailing comment":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: parses code with trailing comment")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 42  # This is a comment
            expect x == 42

        it "parses comment-only lines":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: parses comment-only lines")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # This is a full-line comment
            val x = 42
            # Another comment
            expect x == 42

        it "parses multiple comment styles":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: parses multiple comment styles")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 42  # Hash comment
            expect x == 42

    context "multi-line comments":
        it "parses block comment":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: parses block comment")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # This is a multi-line comment
            # that spans several lines.
            val x = 42
            expect x == 42

        it "parses inline docstring":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: parses inline docstring")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn documented() -> i64:
                # Returns the answer.
                42
            expect documented() == 42


# ============================================================================
# Test Group 2: Indentation Handling
# ============================================================================

describe "Indentation Handling":
    # ## Python-Style Indentation
    #
    # Tests that indentation-based blocks are correctly parsed.

    it "parses simple indented block":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: parses simple indented block")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        if true:
            val x = 42
            expect x == 42

    it "parses nested indentation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: parses nested indentation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        if true:
            if true:
                if true:
                    val x = 42
                    expect x == 42

    it "parses dedent correctly":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: parses dedent correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var total = 0
        if true:
            total = 10
        if true:
            total = total + 32
        expect total == 42

    it "parses multiple statements in block":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: parses multiple statements in block")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var a = 0
        var b = 0
        if true:
            a = 10
            b = 20
            val c = 12
            a = a + c
        expect a + b == 42


# ============================================================================
# Test Group 3: Correct Keyword Usage
# ============================================================================

describe "Correct Keyword Usage":
    # ## Simple Language Keywords
    #
    # Tests that Simple keywords are used correctly.

    context "variable keywords":
        it "uses val for immutable":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: uses val for immutable")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 42
            expect x == 42

        it "uses var for mutable":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: uses var for mutable")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var x = 0
            x = 42
            expect x == 42

        it "uses let for binding":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: uses let for binding")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            let x = 42
            expect x == 42

    context "function keywords":
        it "uses fn for function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: uses fn for function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn get_value() -> i64:
                42
            expect get_value() == 42

        it "uses return for early return":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: uses return for early return")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn check(x: i64) -> i64:
                if x < 0:
                    return 0
                x
            expect check(42) == 42

    context "control flow keywords":
        it "uses elif not else if":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: uses elif not else if")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn classify(x: i64) -> text:
                if x < 0:
                    "negative"
                elif x == 0:
                    "zero"
                else:
                    "positive"
            expect classify(5) == "positive"


# ============================================================================
# Test Group 4: Boolean Literals
# ============================================================================

describe "Boolean Literal Validation":
    # ## Correct Boolean Syntax
    #
    # Tests that Simple uses lowercase true/false, not Python's True/False.

    it "uses lowercase true":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: uses lowercase true")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = true
        expect x == true

    it "uses lowercase false":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-017
        step("Verify: uses lowercase false")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = false
        expect x == false

    it "uses booleans in conditions":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-018
        step("Verify: uses booleans in conditions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        if true:
            expect true
        if not false:
            expect true


# ============================================================================
# Test Group 5: Nil vs None
# ============================================================================

describe "Nil Value Validation":
    # ## Correct Nil Syntax
    #
    # Tests that Simple uses nil, and None is for Option type.

    it "uses nil for null value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-019
        step("Verify: uses nil for null value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = nil
        expect x == nil

    it "uses None for Option":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: uses None for Option")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt: Option<i64> = None
        expect not opt.?

    it "uses Some for Option with value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-021
        step("Verify: uses Some for Option with value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt = Some(42)
        expect opt.?


# ============================================================================
# Test Group 6: Type Annotation Syntax
# ============================================================================

describe "Type Annotation Validation":
    # ## Correct Type Syntax
    #
    # Tests that type annotations use correct Simple syntax.

    it "uses colon for type annotation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-022
        step("Verify: uses colon for type annotation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x: i64 = 42
        expect x == 42

    it "uses arrow for return type":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-023
        step("Verify: uses arrow for return type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn get_value() -> i64:
            42
        expect get_value() == 42

    it "uses angle brackets for generics":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-024
        step("Verify: uses angle brackets for generics")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn identity<T>(x: T) -> T:
            x
        expect identity(42) == 42

    it "uses Option for optional types":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-025
        step("Verify: uses Option for optional types")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt: Option<i64> = Some(42)
        expect opt.unwrap() == 42


# ============================================================================
# Test Group 7: String Syntax
# ============================================================================

describe "String Syntax Validation":
    # ## Correct String Literals
    #
    # Tests that strings use correct Simple syntax.

    it "uses double quotes for interpolated strings":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-026
        step("Verify: uses double quotes for interpolated strings")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = "World"
        val greeting = "Hello, {name}!"
        expect greeting == "Hello, World!"

    it "uses single quotes for raw strings":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-027
        step("Verify: uses single quotes for raw strings")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val raw = 'Hello\nWorld'
        expect raw.contains("\\n")

    it "uses r prefix for raw double-quoted":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-028
        step("Verify: uses r prefix for raw double-quoted")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val raw = r"Path\to\file"
        expect raw.contains("\\")


# ============================================================================
# Test Group 8: Collection Syntax
# ============================================================================

describe "Collection Syntax Validation":
    # ## Correct Collection Literals
    #
    # Tests that collections use correct Simple syntax.

    it "uses square brackets for arrays":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-029
        step("Verify: uses square brackets for arrays")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [1, 2, 3]
        expect arr.len() == 3

    it "uses parentheses for tuples":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-030
        step("Verify: uses parentheses for tuples")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t = (1, 2, 3)
        expect t.0 == 1

    it "uses braces for dictionaries":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-031
        step("Verify: uses braces for dictionaries")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val d = {"key": 42}
        expect d["key"] == 42


# ============================================================================
# Test Group 9: Struct Instantiation
# ============================================================================

describe "Struct Instantiation Validation":
    # ## Correct Struct Construction
    #
    # Tests that structs are instantiated with correct syntax.

    it "uses braces for struct literal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-032
        step("Verify: uses braces for struct literal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        struct Point:
            x: i64
            y: i64
        val p = Point { x: 10, y: 20 }
        expect p.x == 10

    it "uses colon in struct literal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-033
        step("Verify: uses colon in struct literal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        struct Data:
            value: i64
        val d = Data { value: 42 }
        expect d.value == 42


# ============================================================================
# Test Group 10: Pattern Matching Syntax
# ============================================================================

describe "Pattern Matching Validation":
    #
    # ## Correct Match Syntax
    #
    # Tests that pattern matching uses correct Simple syntax.

    it "uses case keyword for patterns":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-034
        step("Verify: uses case keyword for patterns")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn classify(x: i64) -> text:
            match x:
                case 0:
                    "zero"
                case _:
                    "other"
        expect classify(0) == "zero"

    it "uses if for guards":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-035
        step("Verify: uses if for guards")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn classify(x: i64) -> text:
            match x:
                case n if n < 0:
                    "negative"
                case _:
                    "non-negative"
        expect classify(-5) == "negative"

    it "uses double colon for enum variants":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-036
        step("Verify: uses double colon for enum variants")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        enum Status:
            Ok
            Error
        fn check(s: Status) -> text:
            match s:
                case Status.Ok:
                    "ok"
                case Status.Error:
                    "error"
        expect check(Status.Ok) == "ok"
