"""
## Purpose and audience

# Traits Specification

**Feature IDs:** #TBD
**Category:** Language
**Difficulty:** 3/5
**Status:** Implemented

## Overview

Traits define shared behavior that types can implement, enabling polymorphism
and code reuse. They are similar to interfaces in other languages but support
default implementations, associated types, and trait bounds for generics.

## Syntax

```simple
trait Printable:
fn print(self)

trait Addable:
fn add(self, other: Self) -> Self

fn double(self) -> Self:  # Default implementation
self.add(self)

impl Printable for Point:
fn print(self):
print("({x}, {y})")
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Trait | Interface defining shared behavior |
| Implementation | Concrete behavior for a specific type |
| Default Method | Trait method with provided implementation |
| Trait Bound | Generic constraint requiring trait implementation |

## Behavior

- Traits define method signatures types must implement
- Default methods provide optional implementations
- Types can implement multiple traits
- Trait bounds constrain generic type parameters

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/traits_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Trait Basics
# ============================================================================

describe "Traits":
    # ## Core Trait Functionality
    #
    # Tests for trait definition, implementation, and usage including
    # default methods, trait bounds, and multiple trait implementations.

    context "basic trait implementation":
        # ### Scenario: Trait Implementation
        #
        # Tests implementing traits for structs.

        it "implements trait for struct":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: implements trait for struct")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            trait Summable:
                fn sum(self):
                    return 0

            struct Point:
                x: i64
                y: i64

            impl Summable for Point:
                fn sum(self):
                    return self.x + self.y

            val p = Point { x: 10, y: 20 }
            expect p.sum() == 30

        it "implements trait with arguments":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: implements trait with arguments")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            trait Calculator:
                fn add(self, n):
                    return 0

            struct Counter:
                value: i64

            impl Calculator for Counter:
                fn add(self, n):
                    return self.value + n

            val c = Counter { value: 50 }
            expect c.add(25) == 75

    context "multiple trait implementations":
        # ### Scenario: Multiple Types Implementing Same Trait
        #
        # Tests polymorphism through trait implementations.

        it "allows multiple types to implement same trait":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: allows multiple types to implement same trait")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            trait Valuable:
                fn value(self):
                    return 0

            struct Coin:
                amount: i64

            struct Bill:
                amount: i64

            impl Valuable for Coin:
                fn value(self):
                    return self.amount

            impl Valuable for Bill:
                fn value(self):
                    return self.amount * 100

            val c = Coin { amount: 5 }
            val b = Bill { amount: 2 }
            expect c.value() + b.value() == 205

    context "multiple traits on one type":
        it "type implements two different traits":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: type implements two different traits")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            trait Nameable:
                fn get_name(self) -> text:
                    return ""

            trait Scorable:
                fn get_score(self) -> i64:
                    return 0

            struct Player:
                name: text
                score: i64

            impl Nameable for Player:
                fn get_name(self) -> text:
                    return self.name

            impl Scorable for Player:
                fn get_score(self) -> i64:
                    return self.score

            val p = Player { name: "Alice", score: 99 }
            expect p.get_name() == "Alice"
            expect p.get_score() == 99

        it "type implements three traits":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: type implements three traits")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            trait HasId:
                fn id(self) -> i64:
                    return 0

            trait HasLabel:
                fn label(self) -> text:
                    return ""

            trait HasPriority:
                fn priority(self) -> i64:
                    return 0

            struct Task:
                tid: i64
                name: text
                prio: i64

            impl HasId for Task:
                fn id(self) -> i64:
                    return self.tid

            impl HasLabel for Task:
                fn label(self) -> text:
                    return self.name

            impl HasPriority for Task:
                fn priority(self) -> i64:
                    return self.prio

            val t = Task { tid: 1, name: "deploy", prio: 5 }
            expect t.id() == 1
            expect t.label() == "deploy"
            expect t.priority() == 5


# ============================================================================
# Default Trait Methods
# ============================================================================

describe "Default Trait Methods":
    # ## Default Method Implementations
    #
    # Tests for traits with default method implementations.

    it "uses default trait method when not overridden":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: uses default trait method when not overridden")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Greeter:
            fn greet(self) -> i64
            fn farewell(self) -> i64:
                return 99

        struct Person:
            name: str

        impl Greeter for Person:
            fn greet(self) -> i64:
                return 42

        val p = Person { name: "Alice" }
        expect p.farewell() == 99

    it "allows overriding default trait method":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: allows overriding default trait method")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Greeter:
            fn greet(self) -> i64
            fn farewell(self) -> i64:
                return 99

        struct Person:
            name: str

        impl Greeter for Person:
            fn greet(self) -> i64:
                return 42
            fn farewell(self) -> i64:
                return 7

        val p = Person { name: "Bob" }
        expect p.farewell() == 7

    it "default method can call abstract method":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: default method can call abstract method")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Calculator:
            fn compute(self) -> i64
            fn double(self) -> i64:
                return self.compute() * 2

        struct Value:
            n: i64

        impl Calculator for Value:
            fn compute(self) -> i64:
                return self.n

        val v = Value { n: 21 }
        expect v.double() == 42

    it "default method can call other default method":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: default method can call other default method")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Chainable:
            fn base(self) -> i64:
                return 1
            fn step(self) -> i64:
                return self.base() * 10
            fn final_val(self) -> i64:
                return self.step() + 5

        struct Unit:
            x: i64

        impl Chainable for Unit:
            fn base(self) -> i64:
                return self.x

        val u = Unit { x: 3 }
        expect u.base() == 3
        expect u.step() == 30
        expect u.final_val() == 35


# ============================================================================
# Dynamic Trait Objects
# ============================================================================

describe "Dynamic Trait Objects":
    # ## dyn Trait for Dynamic Dispatch
    #
    # Tests for trait objects enabling runtime polymorphism.

    it "coerces concrete type to dyn Trait via let binding":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: coerces concrete type to dyn Trait via let binding")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Drawable:
            fn draw(self) -> i64

        struct Circle:
            radius: i64

        impl Drawable for Circle:
            fn draw(self) -> i64:
                return self.radius * 3

        val c = Circle { radius: 7 }
        val drawable: dyn Drawable = c
        expect drawable.draw() == 21

    it "passes concrete type to dyn Trait parameter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: passes concrete type to dyn Trait parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Shape:
            fn area(self) -> i64

        struct Square:
            side: i64

        impl Shape for Square:
            fn area(self) -> i64:
                return self.side * self.side

        fn process_shape(s: dyn Shape) -> i64:
            return s.area()

        val sq = Square { side: 6 }
        expect process_shape(sq) == 36

    it "handles multiple types via dyn Trait":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: handles multiple types via dyn Trait")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Describable:
            fn value(self) -> i64

        struct A:
            x: i64

        struct B:
            y: i64

        impl Describable for A:
            fn value(self) -> i64:
                return self.x * 10

        impl Describable for B:
            fn value(self) -> i64:
                return self.y + 100

        fn get_value(d: dyn Describable) -> i64:
            return d.value()

        val a = A { x: 5 }
        val b = B { y: 7 }
        expect get_value(a) + get_value(b) == 157

    it "dyn Trait with default method":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: dyn Trait with default method")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Greetable:
            fn hello(self) -> i64:
                return 42
            fn custom(self) -> i64

        struct Greeter:
            n: i64

        impl Greetable for Greeter:
            fn custom(self) -> i64:
                return self.n

        val g = Greeter { n: 7 }
        val dg: dyn Greetable = g
        expect dg.hello() == 42
        expect dg.custom() == 7


# ============================================================================
# Trait + Mixin Integration
# ============================================================================

describe "Trait and Mixin Integration":
    # ## Traits Applied to Classes with Mixins
    #
    # Tests that traits work correctly on classes that use mixins.

    it "trait impl accesses mixin fields":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: trait impl accesses mixin fields")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Computable:
            fn compute(self) -> i64:
                return 0

        mixin HasData:
            data: i64

        class Worker:
            use HasData
            factor: i64

        impl Computable for Worker:
            fn compute(self) -> i64:
                return self.data * self.factor

        val w = Worker(data: 7, factor: 3)
        expect w.compute() == 21

    it "multiple traits on class with mixin":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: multiple traits on class with mixin")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Labelable:
            fn get_label(self) -> text:
                return ""

        trait Rankable:
            fn get_rank(self) -> i64:
                return 0

        mixin Identified:
            id: i64

        class Hero:
            use Identified
            name: text
            power: i64

        impl Labelable for Hero:
            fn get_label(self) -> text:
                return "{self.name} #{self.id}"

        impl Rankable for Hero:
            fn get_rank(self) -> i64:
                return self.power

        val h = Hero(id: 1, name: "Zara", power: 95)
        expect h.get_label() == "Zara #1"
        expect h.get_rank() == 95

    it "dyn Trait dispatch on mixin class":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: dyn Trait dispatch on mixin class")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Measurable:
            fn measure(self) -> i64:
                return 0

        mixin Sized:
            width: i64
            height: i64

        class Rect:
            use Sized

        impl Measurable for Rect:
            fn measure(self) -> i64:
                return self.width * self.height

        fn get_measure(m: dyn Measurable) -> i64:
            return m.measure()

        val r = Rect(width: 5, height: 8)
        expect get_measure(r) == 40

    it "mixin method and trait method coexist":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-017
        step("Verify: mixin method and trait method coexist")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Taggable:
            fn tag(self) -> text:
                return ""

        mixin Scored:
            score: i64

            fn get_score() -> i64:
                return self.score

        class Entry:
            use Scored
            label: text

        impl Taggable for Entry:
            fn tag(self) -> text:
                return self.label

        val e = Entry(score: 88, label: "gold")
        expect e.get_score() == 88
        expect e.tag() == "gold"
