"""
## Purpose and audience

# Lambdas and Closures Specification


**Feature IDs:** #2300
**Category:** Language
**Status:** Implemented

Lambdas (anonymous functions) and closures enable functional programming patterns.

## Key Concepts

| Concept | Description |
|---------|-------------|
| Lambda | Anonymous function defined inline with `\` syntax |
| Closure | Function that captures variables from enclosing scope |
| Higher-Order Function | Function taking or returning other functions |

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/lambdas_closures_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Basic Lambdas
# ============================================================================

describe "Basic Lambdas":
    # ## Basic Lambda Definition
    #
    # Tests simple lambda creation and invocation.

    it "creates simple lambda":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: creates simple lambda")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val double = \x: x * 2
        expect double(21) == 42

    it "creates lambda with multiple params":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: creates lambda with multiple params")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val add = \x, y: x + y
        expect add(15, 27) == 42

    it "creates lambda with no params":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: creates lambda with no params")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val answer = \: 42
        expect answer() == 42

    it "invokes lambda immediately":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: invokes lambda immediately")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = (\x: x + 5)(37)
        expect result == 42


# ============================================================================
# Test Group 2: Closures
# ============================================================================

describe "Closures":
    # ## Closure Variable Capture
    #
    # Tests closures capturing variables from outer scope.

    it "captures outer variable":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: captures outer variable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val multiplier = 10
        val multiply = \x: x * multiplier
        expect multiply(4) == 40

    it "captures multiple variables":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: captures multiple variables")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 10
        val b = 5
        val calc = \x: x * a + b
        expect calc(3) == 35

    it "nested lambda calls":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: nested lambda calls")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val double = \x: x * 2
        val add_one = \x: x + 1
        expect add_one(double(20)) == 41


# ============================================================================
# Test Group 3: Lambdas with Collections
# ============================================================================

describe "Lambdas with Collections":
    # ## Higher-Order Functions
    #
    # Tests lambdas with collection methods.

    it "maps with lambda":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: maps with lambda")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val numbers = [1, 2, 3]
        val doubled = numbers.map(_ * 2)
        expect doubled[0] == 2
        expect doubled[1] == 4
        expect doubled[2] == 6

    it "filters with lambda":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: filters with lambda")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val numbers = [1, 2, 3, 4, 5, 6]
        val evens = numbers.filter(_ % 2 == 0)
        expect evens.len() == 3

    it "reduces with lambda":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: reduces with lambda")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val numbers = [1, 2, 3, 4]
        val sum = numbers.reduce(0, \acc, x: acc + x)
        expect sum == 10


# ============================================================================
# Test Group 4: Lambda Edge Cases
# ============================================================================

describe "Lambda Edge Cases":
    # ## Special Cases
    #
    # Tests edge cases for lambda behavior.

    it "lambda returning lambda":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: lambda returning lambda")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn make_adder(n):
            return \x: x + n
        val add_five = make_adder(5)
        expect add_five(10) == 15

    it "lambda as function parameter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: lambda as function parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn apply(f, x):
            return f(x)
        expect apply(\x: x * 2, 21) == 42

    it "lambda with conditional":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: lambda with conditional")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val abs = \x: if x < 0: -x else: x
        expect abs(-5) == 5
        expect abs(5) == 5
