"""
## Purpose and audience

# Parser Edge Cases for Operators, Keywords, and Type Syntax

**Feature ID:** #PARSER-015
**Category:** Syntax
**Status:** In Progress

## Overview

The Simple parser must handle several non-trivial syntactic forms that are easy to
mis-parse: the matrix-multiplication operator `@`, the keyword-style bitwise `xor`
operator, and bracket-based array type annotations `[T]`. This spec exercises each
form in isolation and in combination, verifying correct tokenisation, operator
precedence, and type annotation parsing. A `super` keyword test is planned but
commented out pending interpreter support for inheritance dispatch.

## Syntax

```simple
# Matrix multiplication operator (@)
val result = 3 @ 4          # => 12

# Bitwise XOR keyword operator
val bits = 5 xor 3          # => 6

# Array type annotations with square brackets
fn takes_array(items: [i64]) -> [i64]:
return items

# Combined precedence
val c = (a xor b) @ 2       # xor first, then @
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| `@` operator | Matrix multiplication infix operator parsed as a binary expression |
| `xor` keyword operator | Bitwise XOR expressed as an alphabetic keyword, not a symbol |
| Array type syntax | `[T]` bracket notation used in parameter and return type positions |
| Operator precedence | Verifies correct evaluation order when `@` and `xor` appear together |

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/parser_edge_cases_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Parser Edge Cases":
    # Tests for parser edge cases and bug fixes.

    context "Matrix Multiplication Operator":
        it "parses @ operator in expressions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: parses @ operator in expressions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 3 @ 4
            expect result == 12

        it "parses @ operator with variables":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: parses @ operator with variables")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val a = 2
            val b = 5
            val result = a @ b
            expect result == 10

    context "Bitwise XOR Keyword":
        it "parses xor keyword in expressions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: parses xor keyword in expressions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 5 xor 3
            expect result == 6

        it "parses xor keyword with variables":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: parses xor keyword with variables")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val a = 12
            val b = 7
            val result = a xor b
            expect result == 11

        it "parses xor in complex expressions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: parses xor in complex expressions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = (5 xor 3) xor 1
            expect result == 7

    # NOTE: No inheritance or super keyword — by design.
    # Use composition + alias forwarding, traits, or mixins instead.

    context "Array Type Syntax":
        it "parses array types with square brackets":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: parses array types with square brackets")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn takes_array(items: [i64]) -> [i64]:
                return items

            val nums = [1, 2, 3]
            val result = takes_array(nums)
            expect result.length() == 3

        it "parses array return types":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: parses array return types")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn make_array() -> [text]:
                return ["a", "b", "c"]

            val result = make_array()
            expect result[0] == "a"

    context "Operator Precedence":
        it "handles @ and xor together":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: handles @ and xor together")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = (3 @ 2) xor 5
            expect result == 3  # (3 @ 2) = 6, 6 xor 5 = 3

        it "handles multiple operators":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: handles multiple operators")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val a = 10
            val b = 3
            val c = (a xor b) @ 2
            expect c == 18  # 10 xor 3 = 9, 9 @ 2 = 18
