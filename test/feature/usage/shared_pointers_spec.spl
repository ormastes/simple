"""
## Purpose and audience

# Reference Counted Pointers Specification


**Feature IDs:** #SHARED-PTR
**Category:** Runtime
**Status:** Implemented

Reference counted pointers provide safe sharing of data with automatic
memory management through reference counting.

## Key Behaviors

- Reference count incremented on clone, decremented on drop
- Value is deallocated when reference count reaches zero
- Cloning creates shallow copy with incremented reference count

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/shared_pointers_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Basic Pointer Operations
# ============================================================================

describe "Reference Counted Pointers":
    # ## Basic Pointer Operations
    #
    # Tests basic reference counted pointer creation and usage.

    it "creates pointer":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: creates pointer")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val ptr = new * 42
        expect ptr == 42

    it "pointer arithmetic":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: pointer arithmetic")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = new * 10
        val b = new * 5
        expect a + b == 15

    it "multiple references":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: multiple references")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = new * 42
        val b = a
        expect a + b == 84


# ============================================================================
# Test Group 2: Reference Semantics
# ============================================================================

describe "Reference Semantics":
    # ## Reference Counting Semantics
    #
    # Tests reference counting behavior.

    it "tracks multiple references":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: tracks multiple references")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val list = [1, 2, 3]
        val ref1 = list
        val ref2 = list
        expect ref1.len() == 3
        expect ref2.len() == 3

    it "clones underlying data":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: clones underlying data")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val original = [1, 2, 3]
        val cloned = original
        expect cloned[0] == 1
        expect cloned.len() == 3

    it "dict references work correctly":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: dict references work correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val data = {"key": 42}
        val ref = data
        expect ref["key"] == 42


# ============================================================================
# Test Group 3: Memory Safety
# ============================================================================

describe "Memory Safety":
    # ## Memory Safety Guarantees
    #
    # Tests that references maintain memory safety.

    it "data remains valid while referenced":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: data remains valid while referenced")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val data = [1, 2, 3]
        val r1 = data
        expect r1[0] == 1

    it "strings are valid":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: strings are valid")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val s = "hello"
        val ref = s
        expect ref.len() == 5

    it "nested data structures work":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: nested data structures work")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val outer = [[1, 2], [3, 4]]
        val ref = outer
        expect ref[0][0] == 1
        expect ref[1][1] == 4

