"""
## Purpose and audience

# Parser Keywords Specification

**Feature IDs:** #PARSER-KW-001 to #PARSER-KW-020
**Category:** Infrastructure | Parser
**Status:** Implemented

Tests that all Simple language keywords are correctly recognized and
parsed in their appropriate contexts.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/parser_keywords_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Module-level test type definitions
struct TestPoint:
    x: i64
    y: i64

impl TestPoint:
    fn get_x() -> i64:
        self.x

    fn get_y() -> i64:
        self.y


# ============================================================================
# Test Group 1: Variable Keywords
# ============================================================================

describe "Variable Keyword Parsing":
    it "val declares immutable variable":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: val declares immutable variable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 42
        expect x == 42

    it "var declares mutable variable":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: var declares mutable variable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var x = 0
        x = 42
        expect x == 42


# ============================================================================
# Test Group 2: Control Flow Keywords
# ============================================================================

describe "Control Flow Keyword Parsing":
    it "parses if statement":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: parses if statement")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = if true:
            1
        else:
            0
        expect result == 1

    it "parses elif statement":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: parses elif statement")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 2
        val result = if x == 1:
            "one"
        elif x == 2:
            "two"
        else:
            "other"
        expect result == "two"

    it "parses while loop":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: parses while loop")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var x = 0
        while x < 3:
            x = x + 1
        expect x == 3

    it "parses for loop":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: parses for loop")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var sum = 0
        for i in [1, 2, 3]:
            sum = sum + i
        expect sum == 6

    it "parses break in loop":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: parses break in loop")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var x = 0
        while true:
            x = x + 1
            if x >= 5:
                break
        expect x == 5

    it "parses continue in loop":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: parses continue in loop")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var sum = 0
        for i in [1, 2, 3, 4, 5]:
            if i == 3:
                continue
            sum = sum + i
        expect sum == 12

    it "parses return statement":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: parses return statement")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn early_return(x: i64) -> i64:
            if x < 0:
                return 0
            x
        expect early_return(-1) == 0
        expect early_return(5) == 5

    it "parses match expression":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: parses match expression")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = match 42:
            case 0 => "zero"
            case 42 => "forty-two"
            case _ => "other"
        expect result == "forty-two"


# ============================================================================
# Test Group 3: Logic Keywords
# ============================================================================

describe "Logic Keyword Parsing":
    it "parses and operator":
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: parses and operator")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(true and true) == true
        expect(true and false) == false
        expect(false and true) == false

    it "parses or operator":
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: parses or operator")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(true or true) == true
        expect(true or false) == true
        expect(false or false) == false

    it "parses not operator":
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: parses not operator")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(not false) == true
        expect(not true) == false

    it "parses in operator":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: parses in operator")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect 2 in [1, 2, 3]
        expect not (5 in [1, 2, 3])


# ============================================================================
# Test Group 4: Special Keywords
# ============================================================================

describe "Special Keyword Parsing":
    it "parses true":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: parses true")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = true
        expect x

    it "parses false":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: parses false")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = false
        expect not x

    it "parses nil":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-017
        step("Verify: parses nil")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = nil
        expect x == nil

    it "parses self in method":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-018
        step("Verify: parses self in method")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val p = TestPoint(x: 42, y: 10)
        expect p.get_x() == 42
        expect p.get_y() == 10


# ============================================================================
# Test Group 5: Function Keywords
# ============================================================================

describe "Function Keyword Parsing":
    it "parses fn declaration":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-019
        step("Verify: parses fn declaration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn add(a: i64, b: i64) -> i64:
            a + b
        expect add(3, 4) == 7

    it "parses nested function":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: parses nested function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn outer(x: i64) -> i64:
            fn inner(y: i64) -> i64:
                y * 2
            inner(x) + 1
        expect outer(5) == 11

    it "parses lambda expression":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-021
        step("Verify: parses lambda expression")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val double = \x: x * 2
        expect double(5) == 10

    it "parses higher-order function":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-022
        step("Verify: parses higher-order function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn apply(f: fn(i64) -> i64, x: i64) -> i64:
            f(x)
        expect apply(\n: n + 1, 5) == 6
