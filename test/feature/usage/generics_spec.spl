"""
## Purpose and audience

# Generic Types Specification

**Feature IDs:** #1005
**Category:** Language
**Status:** In Progress

Tests for generic type parameters and constraints.
Verifies generic function definitions, generic struct/class types, and type bounds.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/generics_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Generic Types":
    # Tests for generic/parametric types and their usage.
    # Verifies generic function definitions, generic structs, generic classes,
    # and type parameter instantiation and inference.

    context "generic functions":
        # ### Scenario: Parameterized Functions
        #
        # Tests generic functions with type parameters.

        it "defines generic identity function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: defines generic identity function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn identity<T>(value: T) -> T:
                value
            expect identity(42) == 42
            expect identity("hello") == "hello"

        it "uses generic function with inference":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: uses generic function with inference")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn first<T>(items: List<T>) -> Option<T>:
                items.first
            val result = first([1, 2, 3])
            expect result == Some(1)

        it "uses multiple type parameters":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: uses multiple type parameters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn pair<A, B>(a: A, b: B) -> text:
                "pair"
            expect pair(1, "string") == "pair"
            expect pair(true, 3.14) == "pair"

    context "generic structs":
        # ### Scenario: Generic Structures
        #
        # Tests struct types with type parameters.

        it "defines generic struct":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: defines generic struct")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            struct Container<T>:
                value: T
            expect 1 == 1  # parsing test

        it "creates instance of generic struct":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: creates instance of generic struct")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            struct Box<T>:
                item: T
            val b = Box { item: 42 }
            expect b.item == 42

        it "uses nested generic types":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: uses nested generic types")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            struct Container:
                items: List<Option<i64>>
            expect 1 == 1  # parsing test

        it "uses tuple return type":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: uses tuple return type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn get_pair() -> (i64, text):
                return (42, "hello")
            expect 1 == 1  # parsing test

    context "generic classes":
        # ### Scenario: Generic Classes
        #
        # Tests class types with type parameters.

        it "defines generic class":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: defines generic class")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            class Stack<T>:
                items: List<T>
            expect 1 == 1  # parsing test

        it "creates generic enum":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: creates generic enum")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            enum Result<T, E>:
                Ok(T)
                Err(E)
            expect 1 == 1  # parsing test

        it "uses generic field type":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: uses generic field type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            struct Container:
                value: Option<text>
            expect 1 == 1  # parsing test

        it "uses list generic type":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: uses list generic type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            struct Example:
                items: List<text>
            expect 1 == 1  # parsing test

    context "generic with constraints":
        # ### Scenario: Type Bounds and Constraints
        #
        # Tests generic types with constraints on type parameters.

        it "uses where clause on function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: uses where clause on function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn filled(value: i64) -> i64 where i64: Copy:
                return value
            expect filled(42) == 42

        it "uses impl Trait for Type":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: uses impl Trait for Type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            trait Len:
                fn len(self) -> i64

            struct MyList:
                size: i64

            impl Len for MyList:
                fn len(self) -> i64:
                    return self.size
            expect 1 == 1  # parsing test

        it "uses multiple trait bounds":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: uses multiple trait bounds")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            trait Clone:
                fn clone(self) -> Self

            trait Default:
                fn default() -> Self

            fn make<T>() -> T where T: Clone + Default:
                return T.default()
            expect 1 == 1  # parsing test

        it "uses associated type":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: uses associated type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            trait Iterator:
                type Item
                fn next(self) -> Option<Self.Item>
            expect 1 == 1  # parsing test

    context "generic collections":
        # ### Scenario: Built-in Generic Types
        #
        # Tests built-in generic collection types.

        it "creates generic list":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: creates generic list")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val numbers: List<i32> = [1, 2, 3]
            expect numbers.first == Some(1)

        it "creates generic dictionary":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: creates generic dictionary")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mapping: Dict<text, i32> = {"a": 1}
            expect mapping["a"] == 1

        it "creates generic option":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: creates generic option")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val some_value: Option<text> = Some("hello")
            val no_value: Option<text> = nil
            expect some_value.is_some() == true

        it "creates generic result":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-019
            step("Verify: creates generic result")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ok_result: Result<i32, text> = Ok(42)
            val err_result: Result<i32, text> = Err("failed")
            expect ok_result.is_ok() == true
            expect err_result.is_err() == true

    context "generic with variance":
        # ### Scenario: Type Parameter Variance
        #
        # Tests covariance and contravariance in generic types.

        it "uses const generic parameter":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-020
            step("Verify: uses const generic parameter")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            struct Array<T, const N: usize>:
                data: T
            expect 1 == 1  # parsing test

        it "uses generic impl with where":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-021
            step("Verify: uses generic impl with where")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            trait Clone:
                fn clone(self) -> Self

            impl Clone for i64:
                fn clone(self) -> i64:
                    return self
            expect 1 == 1  # parsing test

        it "uses function type syntax":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-022
            step("Verify: uses function type syntax")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn apply(f: fn(i64) -> i64, x: i64) -> i64:
                return f(x)

            fn double(n: i64) -> i64:
                return n * 2

            expect apply(double, 21) == 42

    context "higher-order generic functions":
        # ### Scenario: Complex Generic Patterns
        #
        # Tests complex patterns with nested generics.

        it "defines function returning generic type":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-023
            step("Verify: defines function returning generic type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn make_list<T>(item: T) -> List<T>:
                [item]
            val result = make_list(42)
            expect result.first == Some(42)

        it "uses function with generic result":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-024
            step("Verify: uses function with generic result")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn map_list<T, U>(f: fn(T) -> U, items: List<T>) -> List<U>:
                []
            expect 1 == 1  # parsing test

        it "chains generic function calls":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-025
            step("Verify: chains generic function calls")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn id<T>(x: T) -> T:
                x
            val result = id(id(42))
            expect result == 42

    context "generic instantiation":
        # ### Scenario: Type Instantiation
        #
        # Tests explicit and implicit type instantiation of generics.

        it "implicitly infers type parameters":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-026
            step("Verify: implicitly infers type parameters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn wrap<T>(x: T) -> List<T>:
                [x]
            val result = wrap(10)
            expect result.first == Some(10)

        it "explicitly specifies type parameters":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-027
            step("Verify: explicitly specifies type parameters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn create<T>() -> Option<T>:
                None
            val result: Option<i32> = create()
            expect result == nil

        it "uses generic in method":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-028
            step("Verify: uses generic in method")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            struct Wrapper<T>:
                value: T

            fn wrap<T>(x: T) -> Wrapper<T>:
                Wrapper { value: x }
            expect 1 == 1  # parsing test
