"""
## Purpose and audience

# Guard Clause Specification


**Feature IDs:** #GUARD-CLAUSE
**Category:** Syntax
**Status:** Implemented

Guard clauses (pattern guards) allow conditional matching within pattern match arms.
They combine pattern matching with boolean conditions using the `if` keyword after
the pattern to provide additional filtering before the arm body executes.

## Syntax

```simple
match value:
case pattern if condition:
body
```

## Key Behaviors

- Guard conditions are evaluated after pattern matching succeeds
- Variables bound in the pattern are available in the guard condition
- If the guard evaluates to false, matching continues to the next arm
- Guards can reference external variables from the enclosing scope

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/guard_clause_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Module-level enum for guard clause tests (block-scoped enums can't be found in closures)
enum GuardValue:
    Num(i64)
    Empty

describe "Guard Clauses":
    # ## Pattern Guard Specification
    #
    # Guard clauses provide conditional matching within match expressions.
    # This test suite verifies:
    # - Basic guard syntax with `case pattern if condition`
    # - Variable binding access within guards
    # - Guard evaluation order and fallthrough behavior
    # - Interaction with different pattern types (literals, tuples, enums)
    # - Complex guard expressions including comparisons and logical operators

    context "basic integer guards":
        it "matches when guard is true":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: matches when guard is true")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn classify(x: i64) -> text:
                match x:
                    case n if n > 10:
                        "large"
                    case n if n > 0:
                        "small"
                    case _:
                        "non-positive"
            expect classify(15) == "large"

        it "falls through when guard is false":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: falls through when guard is false")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn classify(x: i64) -> text:
                match x:
                    case n if n > 10:
                        "large"
                    case n if n > 0:
                        "small"
                    case _:
                        "non-positive"
            expect classify(5) == "small"

        it "reaches default case when all guards fail":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: reaches default case when all guards fail")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn classify(x: i64) -> text:
                match x:
                    case n if n > 10:
                        "large"
                    case n if n > 0:
                        "small"
                    case _:
                        "non-positive"
            expect classify(-5) == "non-positive"

    context "guards with equality checks":
        it "matches exact value via guard":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: matches exact value via guard")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn identify(x: i64) -> text:
                match x:
                    case n if n == 0:
                        "zero"
                    case n if n == 42:
                        "answer"
                    case _:
                        "other"
            expect identify(0) == "zero"
            expect identify(42) == "answer"
            expect identify(99) == "other"

    context "guards with tuple patterns":
        it "uses bound variables in guard":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: uses bound variables in guard")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn check_sum(pair: (i64, i64)) -> text:
                match pair:
                    case (a, b) if a + b > 100:
                        "big sum"
                    case (a, b) if a == b:
                        "equal"
                    case _:
                        "other"
            expect check_sum((60, 50)) == "big sum"
            expect check_sum((5, 5)) == "equal"
            expect check_sum((1, 2)) == "other"

        it "guards with multiple comparisons":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: guards with multiple comparisons")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn check_range(pair: (i64, i64)) -> text:
                match pair:
                    case (a, b) if a > 0 && b > 0:
                        "both positive"
                    case (a, b) if a < 0 && b < 0:
                        "both negative"
                    case _:
                        "mixed"
            expect check_range((5, 10)) == "both positive"
            expect check_range((-5, -10)) == "both negative"
            expect check_range((5, -10)) == "mixed"

    context "guards with enum patterns":
        it "filters enum payload with guard":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: filters enum payload with guard")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn categorize(v: GuardValue) -> text:
                match v:
                    case GuardValue.Num(n) if n > 100:
                        "large number"
                    case GuardValue.Num(n) if n > 0:
                        "small number"
                    case GuardValue.Num(n):
                        "non-positive"
                    case GuardValue.Empty:
                        "empty"
            expect categorize(GuardValue.Num(200)) == "large number"
            expect categorize(GuardValue.Num(50)) == "small number"
            expect categorize(GuardValue.Num(-5)) == "non-positive"
            expect categorize(GuardValue.Empty) == "empty"

    context "guards with external variables":
        it "references variables from outer scope":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: references variables from outer scope")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn above_threshold(x: i64, threshold: i64) -> bool:
                match x:
                    case n if n > threshold:
                        true
                    case _:
                        false
            expect above_threshold(75, 50) == true
            expect above_threshold(25, 50) == false

    context "guards with complex expressions":
        it "uses modulo in guard":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: uses modulo in guard")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn parity(x: i64) -> text:
                match x:
                    case n if n % 2 == 0:
                        "even"
                    case _:
                        "odd"
            expect parity(10) == "even"
            expect parity(7) == "odd"

        it "uses logical or in guard":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: uses logical or in guard")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn is_special(x: i64) -> bool:
                match x:
                    case n if n == 1 || n == 42 || n == 100:
                        true
                    case _:
                        false
            expect is_special(1) == true
            expect is_special(42) == true
            expect is_special(100) == true
            expect is_special(50) == false
