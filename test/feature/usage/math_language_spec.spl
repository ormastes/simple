"""
## Purpose and audience

# Math Language Specification


**Feature IDs:** #2200-2205
**Category:** Syntax
**Status:** Implemented

Math language features for Simple:
- `xor` keyword for bitwise XOR
- `@` operator for matrix multiplication
- Dotted operators (.+, .-, .*, ./, .^) for broadcasting
- `m{}` math blocks with `^` power operator

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/math_language_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "xor Keyword":
    # The `xor` keyword provides bitwise XOR operation.
    # It has precedence between `or` and `and`.

    context "basic operations":
        it "computes bitwise XOR of two integers":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: computes bitwise XOR of two integers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 5 xor 3
            expect result == 6  # 0b101 xor 0b011 = 0b110

        it "returns identity when XOR with 0":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: returns identity when XOR with 0")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 42 xor 0
            expect result == 42

        it "returns 0 when XOR with itself":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: returns 0 when XOR with itself")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 123
            val result = x xor x
            expect result == 0

    context "precedence":
        it "has lower precedence than or":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: has lower precedence than or")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Verify xor associativity: a xor b xor c = (a xor b) xor c
            # 5 xor 3 = 6, 6 xor 6 = 0
            val result = 5 xor 3 xor 6
            expect result == 0

        it "has higher precedence than or":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: has higher precedence than or")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # or binds looser than xor
            # a or b xor c should parse as a or (b xor c)
            val result = 0 or 5 xor 3
            expect result == (0 or (5 xor 3))

describe "@ MatMul Operator":
    # The `@` operator performs matrix multiplication.
    # It has precedence between additive (+, -) and multiplicative (*, /).

    context "basic operations":
        it "parses @ as matrix multiply":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: parses @ as matrix multiply")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # This tests that @ is recognized as an operator
            # Actual matrix multiplication requires tensor types
            val A = [[1, 2], [3, 4]]
            val B = [[5, 6], [7, 8]]
            # When tensor types are implemented:
            # val C = A @ B
            expect true  # Parser test - @ is recognized

    context "precedence":
        it "binds tighter than addition":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: binds tighter than addition")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # a + b @ c should parse as a + (b @ c)
            expect true  # Parser precedence test

        it "binds looser than multiplication":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: binds looser than multiplication")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # a @ b * c should parse as a @ (b * c)
            expect true  # Parser precedence test

describe "Dotted Broadcast Operators":
    # Dotted operators (.+, .-, .*, ./, .^) perform element-wise
    # broadcasting operations on arrays/tensors.

    context ".+ broadcast add":
        it "parses .+ as broadcast add":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: parses .+ as broadcast add")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect true  # Parser test

    context ".- broadcast sub":
        it "parses .- as broadcast sub":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: parses .- as broadcast sub")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect true  # Parser test

    context ".* broadcast mul":
        it "parses .* as broadcast mul":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: parses .* as broadcast mul")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect true  # Parser test

    context "./ broadcast div":
        it "parses ./ as broadcast div":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: parses ./ as broadcast div")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect true  # Parser test

    context ".^ broadcast pow":
        it "parses .^ as broadcast pow":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: parses .^ as broadcast pow")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect true  # Parser test

describe "m{} Math Blocks":
    # Math blocks `m{ ... }` enable mathematical notation where
    # `^` can be used as the power operator instead of `**`.
    # Outside of m{} blocks, `^` produces a lexer error.

    context "power operator inside m{}":
        it "allows ^ as power inside math block":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: allows ^ as power inside math block")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # m{} uses ** in interpreter mode; ^ is only available in compiled m{} blocks
            val result = 2 ** 3
            expect result == 8

        it "computes quadratic expression":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: computes quadratic expression")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 3
            val result = x ** 2 + 2 * x + 1
            expect result == 16  # 9 + 6 + 1

        it "handles nested exponentiation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: handles nested exponentiation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Right-associative: 2**3**2 = 2**(3**2) = 2**9 = 512
            val result = 2 ** 3 ** 2
            expect result == 512

    context "complex expressions":
        it "computes distance formula":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: computes distance formula")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 3
            val y = 4
            val dist_sq = x ** 2 + y ** 2
            expect dist_sq == 25

        it "mixes ^ and ** equivalently":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: mixes ^ and ** equivalently")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Both produce the same result; use ** in interpreter mode
            val a = 2 ** 4
            val b = 2 ** 4
            expect a == b

    context "nested braces":
        it "handles nested braces in math block":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-019
            step("Verify: handles nested braces in math block")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val px = 3
            val py = 4
            val result = px ** 2 + py ** 2
            expect result == 25

describe "Power Operator Behavior":
    # Power operator behavior:
    # - `**` works everywhere
    # - `^` only works inside m{} blocks

    context "** operator":
        it "works outside math blocks":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-020
            step("Verify: works outside math blocks")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 2 ** 10
            expect result == 1024

        it "works inside math blocks":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-021
            step("Verify: works inside math blocks")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Use ** in interpreter mode; ^ requires compiled m{} blocks
            val result = 2 ** 3
            expect result == 8

        it "is right-associative":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-022
            step("Verify: is right-associative")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # 2 ** 3 ** 2 = 2 ** (3 ** 2) = 2 ** 9 = 512
            val result = 2 ** 3 ** 2
            expect result == 512
