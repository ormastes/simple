"""
## Purpose and audience
Pins the generic-function instantiation contract the SMF bytecode feature
depends on: a generic fn must instantiate and evaluate correctly at distinct
type arguments before it can be serialized into .smf templates.
Audience: compiler engineers working on SMF generic template storage.
## Operator workflow
Run `bin/simple test test/feature/usage/generic_bytecode_spec.spl` and read
the per-scenario verdicts in the `Results:` summary.
## Compatibility and limitations
Covers interpreter-path instantiation semantics; .smf serialization itself
is out of scope until the feature lands.
# @manual: primary
REQ-FEAT-GENSMF-001
doc/01_research/local/generic_smf.md
doc/03_plan/sys_test/generic_smf.md
doc/04_architecture/generic_smf.md
doc/05_design/generic_smf.md
"""
# @req: REQ-FEAT-GENSMF-001

use std.spec

fn identity<T>(x: T) -> T:
    x

describe "Generic Template Bytecode in SMF":
    it "instantiates a generic identity at i64":
        step("Verify: instantiates a generic identity at i64")
        # @req: REQ-FEAT-GENSMF-001
        val n = identity<i64>(41)
        expect(n).to_equal(41) # oracle: identity returns its argument unchanged

    it "instantiates the same generic at text without cross-talk":
        step("Verify: instantiates the same generic at text without cross-talk")
        # @req: REQ-FEAT-GENSMF-001
        val s = identity<text>("smf")
        expect(s).to_equal("smf") # oracle: second instantiation is independent of the first
