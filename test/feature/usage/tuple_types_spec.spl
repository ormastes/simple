"""
## Purpose and audience

# Tuple Types Specification

**Feature IDs:** #TBD
**Category:** Language
**Difficulty:** 2/5
**Status:** Implemented

## Overview

Tuple types are ordered collections of heterogeneous values with fixed length.
They allow grouping multiple values of different types without defining a
named struct, useful for returning multiple values or temporary groupings.

## Syntax

```simple
val point = (3, 4)
val mixed = ("hello", 42, true)
val (x, y) = point  # Destructuring
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Tuple | Fixed-size heterogeneous collection |
| Tuple Type | Type annotation like `(T1, T2, T3)` |
| Destructuring | Pattern matching to extract tuple elements |
| Unit Type | Empty tuple `()` representing no value |

## Behavior

- Tuples have fixed length determined at compile time
- Elements accessed by index: `tuple[0]`, `tuple[1]`
- Support pattern matching and destructuring
- Unit type `()` is the zero-element tuple

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/tuple_types_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Tuple Type Basics
# ============================================================================

describe "Tuple Types":
    # ## Core Tuple Functionality
    #
    # Tests for tuple creation, access, destructuring, and type annotations.
    # Validates tuple behavior with various element types.

    context "tuple creation":
        # ### Scenario: Tuple Creation
        #
        # Creates tuples with various element types and sizes.

        it "creates tuple literal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: creates tuple literal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val t = (10, 20, 30)
            expect t[1] == 20

        it "gets tuple length":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: gets tuple length")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val t = (1, 2, 3, 4)
            expect t.len() == 4

    context "tuple access":
        # ### Scenario: Tuple Element Access
        #
        # Accesses individual tuple elements by index.

        it "accesses elements by index":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: accesses elements by index")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val t = (5, 10, 15)
            expect t[0] == 5
            expect t[2] == 15

    context "tuple destructuring":
        # ### Scenario: Tuple Destructuring
        #
        # Extracts tuple elements into variables.

        it "destructures tuple into variables":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: destructures tuple into variables")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val (a, b, c) = (10, 20, 30)
            expect a + b + c == 60

        it "swaps values with tuple destructuring":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: swaps values with tuple destructuring")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val a = 10
            val b = 20
            val (x, y) = (b, a)
            expect x == 20

        it "destructures from array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: destructures from array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr = [5, 10, 15]
            val (first, second, third) = arr
            expect second == 10


# ============================================================================
# Tuple Pattern Matching
# ============================================================================

describe "Tuple Pattern Matching":
    # ## Pattern Matching with Tuples
    #
    # Tests for tuple patterns in match expressions.

    it "matches tuple pattern":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: matches tuple pattern")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t = (1, 2)
        val result = match t:
            (1, x) => x * 10
            _ => 0
        expect result == 20

    it "uses wildcard for unmatched tuples":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: uses wildcard for unmatched tuples")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t = (5, 5)
        val result = match t:
            (1, x) => x
            _ => 99
        expect result == 99
