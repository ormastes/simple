"""
## Purpose and audience

# Tensor Operations Specification


**Feature IDs:** #2210-2230
**Category:** Syntax / Stdlib
**Status:** Implemented

Tensor operations for mathematical computing:
- Tensor<T, N>, Matrix<T>, Vector<T> type aliases
- Transpose operators (' in m{}, .T outside)
- Reduction operations (sum, mean, std, etc.)
- Axis-aware operations

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/tensor_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.src.{Device, DType, zeros, ones}
use std.spec.{step}

describe "Tensor Type Aliases", tag: ["only-compiled"]:
    # skip: tensor runtime functions not available in interpreter
    # Type aliases for common tensor ranks.

    context "Matrix<T>":
        it "is alias for Tensor<T, 2>":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: is alias for Tensor<T, 2>")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = zeros<f64>([3, 4], Device.cpu())
            expect A.ndim == 2

    context "Vector<T>":
        it "is alias for Tensor<T, 1>":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: is alias for Tensor<T, 1>")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = zeros<f64>([5], Device.cpu())
            expect x.ndim == 1

    context "concrete aliases":
        it "provides Mat as Matrix<f64>":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: provides Mat as Matrix<f64>")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = zeros<f64>([2, 3], Device.cpu())
            expect A.shape == [2, 3]

        it "provides Vec as Vector<f64>":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: provides Vec as Vector<f64>")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = ones<f64>([4], Device.cpu())
            expect x.shape == [4]

describe "Transpose Operators", tag: ["only-compiled"]:
    # skip: tensor runtime functions not available in interpreter
    # Transpose operations:
    # - ' (postfix) inside m{} blocks
    # - .T / .t() outside m{} blocks

    context "property transpose .T":
        it "transposes 2D matrix":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: transposes 2D matrix")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1, 2, 3], [4, 5, 6]]
            val At = A.T
            expect At.shape == [3, 2]
            expect At[0][0] == 1
            expect At[0][1] == 4

        it "is equivalent to .t()":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: is equivalent to .t()")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1, 2], [3, 4]]
            expect A.T == A.t()

    context "postfix transpose ' in m{}":
        it "transposes matrix":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: transposes matrix")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1, 2], [3, 4]]
            val At = m{ A' }
            expect At == [[1, 3], [2, 4]]

        it "chains with matmul":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: chains with matmul")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1, 2], [3, 4]]
            val x = [1, 1]
            val y = m{ A' @ x }
            expect y == [4, 6]

        it "works in complex expressions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: works in complex expressions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1, 0], [0, 1]]
            val b = [1, 2]
            # (A'A)^-1 A'b for A=I is just b
            val result = m{ (A' @ A) @ A' @ b }
            expect result == [1, 2]

    context "general transpose":
        it "swaps specified dimensions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: swaps specified dimensions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val T = zeros<f64>([2, 3, 4])
            val Tt = T.transpose(0, 2)
            expect Tt.shape == [4, 3, 2]

        it "permutes multiple dimensions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: permutes multiple dimensions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val T = zeros<f64>([2, 3, 4, 5])
            val Tp = T.permute([3, 1, 2, 0])
            expect Tp.shape == [5, 3, 4, 2]

describe "Global Reductions", tag: ["only-compiled"]:
    # skip: tensor runtime functions not available in interpreter
    # Reduction operations over all elements.

    context "sum":
        it "sums all elements":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: sums all elements")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [1.0, 2.0, 3.0, 4.0]
            expect x.sum == 10.0

        it "sums matrix elements":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: sums matrix elements")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1, 2], [3, 4]]
            expect A.sum == 10

    context "mean":
        it "computes mean":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: computes mean")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [1.0, 2.0, 3.0, 4.0]
            expect x.mean == 2.5

    context "product":
        it "multiplies all elements":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: multiplies all elements")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [1.0, 2.0, 3.0, 4.0]
            expect x.prod == 24.0

    context "min/max":
        it "finds minimum":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: finds minimum")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [3.0, 1.0, 4.0, 1.0, 5.0]
            expect x.min == 1.0

        it "finds maximum":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: finds maximum")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [3.0, 1.0, 4.0, 1.0, 5.0]
            expect x.max == 5.0

    context "standard deviation":
        it "computes std":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: computes std")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
            expect x.std.approx(2.0, epsilon: 0.1)

    context "variance":
        it "computes var":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-019
            step("Verify: computes var")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
            expect x.var.approx(4.0, epsilon: 0.1)

    context "norm":
        it "computes L2 norm":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-020
            step("Verify: computes L2 norm")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [3.0, 4.0]
            expect x.norm() == 5.0

        it "computes L1 norm":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-021
            step("Verify: computes L1 norm")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [3.0, -4.0]
            expect x.norm(1) == 7.0

describe "Axis Reductions", tag: ["only-compiled"]:
    # skip: tensor runtime functions not available in interpreter
    # Reduction operations along specific axes.

    context "sum along axis":
        it "sums columns (axis=0)":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-022
            step("Verify: sums columns (axis=0)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1, 2], [3, 4], [5, 6]]
            expect A.sum(axis: 0) == [9, 12]

        it "sums rows (axis=1)":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-023
            step("Verify: sums rows (axis=1)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1, 2], [3, 4], [5, 6]]
            expect A.sum(axis: 1) == [3, 7, 11]

        it "keeps dimension with keepdim":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-024
            step("Verify: keeps dimension with keepdim")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1, 2], [3, 4]]
            val s = A.sum(axis: 0, keepdim: true)
            expect s.shape == [1, 2]

    context "mean along axis":
        it "means columns":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-025
            step("Verify: means columns")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1.0, 2.0], [3.0, 4.0]]
            expect A.mean(axis: 0) == [2.0, 3.0]

    context "min/max along axis":
        it "finds min with indices":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-026
            step("Verify: finds min with indices")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[3, 1], [4, 2]]
            val (vals, idx) = A.min(axis: 1)
            expect vals == [1, 2]
            expect idx == [1, 1]

        it "finds max with indices":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-027
            step("Verify: finds max with indices")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[3, 1], [4, 2]]
            val (vals, idx) = A.max(axis: 1)
            expect vals == [3, 4]
            expect idx == [0, 0]

    context "argmin/argmax":
        it "returns indices of min":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-028
            step("Verify: returns indices of min")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[3, 1, 4], [1, 5, 9]]
            expect A.argmin(axis: 1) == [1, 0]

        it "returns indices of max":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-029
            step("Verify: returns indices of max")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[3, 1, 4], [1, 5, 9]]
            expect A.argmax(axis: 1) == [2, 2]

describe "Axis-Aware Slicing", tag: ["only-compiled"]:
    # skip: tensor runtime functions not available in interpreter
    # Multi-dimensional slicing with :, ..., and ranges.

    context "single axis slice":
        it "slices first axis":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-030
            step("Verify: slices first axis")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1, 2, 3], [4, 5, 6]]
            expect A[0] == [1, 2, 3]

        it "slices second axis":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-031
            step("Verify: slices second axis")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1, 2, 3], [4, 5, 6]]
            expect A.column(0) == [1, 4]

    context "range slices":
        it "slices range on both axes":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-032
            step("Verify: slices range on both axes")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
            expect A[0:2].map(_1[1:3]) == [[2, 3], [5, 6]]

    context "ellipsis":
        it "expands to fill dimensions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-033
            step("Verify: expands to fill dimensions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val T = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]  # 2x2x2
            expect T.map(_1.column(0)) == [[1, 3], [5, 7]]
            expect T[0] == [[1, 2], [3, 4]]

    context "step slicing":
        it "takes every nth element":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-034
            step("Verify: takes every nth element")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [0, 1, 2, 3, 4, 5]
            expect x[::2] == [0, 2, 4]

        it "reverses via .reversed(), not a negative-step slice":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-035
            step("Verify: reverses via .reversed(), not a negative-step slice")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [0, 1, 2, 3, 4, 5]
            expect x.reversed() == [5, 4, 3, 2, 1, 0]

describe "Shape Manipulation", tag: ["only-compiled"]:
    # skip: tensor runtime functions not available in interpreter
    # Reshape, squeeze, unsqueeze operations.

    context "reshape":
        it "reshapes to new dimensions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-036
            step("Verify: reshapes to new dimensions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1, 2, 3], [4, 5, 6]]
            expect A.reshape([6]).shape == [6]
            expect A.reshape([3, 2]).shape == [3, 2]

        it "infers dimension with -1":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-037
            step("Verify: infers dimension with -1")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1, 2, 3], [4, 5, 6]]
            expect A.reshape([-1]).shape == [6]
            expect A.reshape([3, -1]).shape == [3, 2]

    context "squeeze":
        it "removes size-1 dimensions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-038
            step("Verify: removes size-1 dimensions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = zeros<f64>([1, 3, 1, 4])
            expect A.squeeze().shape == [3, 4]

        it "removes specific dimension":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-039
            step("Verify: removes specific dimension")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = zeros<f64>([1, 3, 1, 4])
            expect A.squeeze(0).shape == [3, 1, 4]

    context "unsqueeze":
        it "adds dimension at position":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-040
            step("Verify: adds dimension at position")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [1, 2, 3]
            expect x.unsqueeze(0).shape == [1, 3]
            expect x.unsqueeze(1).shape == [3, 1]

describe "Tensor Construction", tag: ["only-compiled"]:
    # skip: tensor runtime functions not available in interpreter
    # Factory functions for creating tensors.

    context "zeros/ones":
        it "creates zero tensor":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-041
            step("Verify: creates zero tensor")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = zeros<f64>([2, 3])
            expect A.sum == 0.0

        it "creates ones tensor":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-042
            step("Verify: creates ones tensor")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = ones<f64>([2, 3])
            expect A.sum == 6.0

    context "eye":
        it "creates identity matrix":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-043
            step("Verify: creates identity matrix")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val I = eye<f64>(3)
            expect I[0][0] == 1.0
            expect I[0][1] == 0.0
            expect I.trace() == 3.0

    context "arange":
        it "creates range tensor":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-044
            step("Verify: creates range tensor")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = arange(0, 5, 1)
            expect x == [0, 1, 2, 3, 4]

        it "creates stepped range":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-045
            step("Verify: creates stepped range")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = arange(0, 10, 2)
            expect x == [0, 2, 4, 6, 8]

    context "linspace":
        it "creates linearly spaced values":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-046
            step("Verify: creates linearly spaced values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = linspace(0.0, 1.0, 5)
            expect x[0] == 0.0
            expect x[4] == 1.0
            expect x.len() == 5

describe "Elementwise Math", tag: ["only-compiled"]:
    # skip: tensor runtime functions not available in interpreter
    # Elementwise mathematical functions.

    context "basic functions":
        it "computes absolute value":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-047
            step("Verify: computes absolute value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [-1.0, 2.0, -3.0]
            expect x.abs() == [1.0, 2.0, 3.0]

        it "computes square root":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-048
            step("Verify: computes square root")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [1.0, 4.0, 9.0]
            expect x.sqrt() == [1.0, 2.0, 3.0]

        it "computes exponential":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-049
            step("Verify: computes exponential")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [0.0, 1.0]
            expect x.exp()[0].approx(1.0)
            expect x.exp()[1].approx(2.718, epsilon: 0.01)

    context "trigonometric":
        it "computes sin/cos":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-050
            step("Verify: computes sin/cos")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [0.0]
            expect x.sin()[0].approx(0.0)
            expect x.cos()[0].approx(1.0)

    context "clamp":
        it "clamps to range":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-051
            step("Verify: clamps to range")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = [-1.0, 0.5, 2.0]
            expect x.clamp(min: 0.0, max: 1.0) == [0.0, 0.5, 1.0]

describe "Linear Algebra", tag: ["only-compiled"]:
    # skip: tensor runtime functions not available in interpreter
    # Linear algebra operations.

    context "determinant":
        it "computes 2x2 determinant":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-052
            step("Verify: computes 2x2 determinant")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1.0, 2.0], [3.0, 4.0]]
            expect A.det().approx(-2.0)

    context "inverse":
        it "computes matrix inverse":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-053
            step("Verify: computes matrix inverse")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[1.0, 2.0], [3.0, 4.0]]
            val Ainv = A.inv()
            val I = A @ Ainv
            expect I[0][0].approx(1.0)
            expect I[0][1].approx(0.0)

    context "solve":
        it "solves linear system":
            # @req: REQ-FEATURE-USAGE-054
            step("Verify: solves linear system")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val A = [[2.0, 1.0], [1.0, 3.0]]
            val b = [4.0, 5.0]
            val x = A.solve(b)
            expect (A @ x)[0].approx(4.0)
            expect (A @ x)[1].approx(5.0)

    context "trace":
        it "sums diagonal elements":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-055
            step("Verify: sums diagonal elements")
