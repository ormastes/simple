describe "PTX Builder - Control Flow":
    if not test_env_cuda_available():
        it "env_skip: CUDA not available":
            # @req: REQ-FEATURE-USAGE-060
            step("Verify: env_skip: CUDA not available")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val reason = test_env_gate_skip("SIMPLE_CUDA_TEST")
            expect(reason).to_contain("Skipped")
        return
    # ## Branch and Label Generation
    #
    # Tests control flow instruction generation.

    it "generates unconditional branch":
        # @req: REQ-FEATURE-USAGE-061
        step("Verify: generates unconditional branch")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var builder = PtxBuilder__create((8, 6))
        builder.emit_branch("BB1")
        val ptx = builder.build()

        expect(ptx).to_contain("bra BB1;")

    it "generates conditional branch":
        # @req: REQ-FEATURE-USAGE-062
        step("Verify: generates conditional branch")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var builder = PtxBuilder__create((8, 6))
        builder.emit_branch_if("%p0", "BB_true")
        val ptx = builder.build()

        expect(ptx).to_contain("@%p0 bra BB_true;")

    it "generates negated conditional branch":
        # @req: REQ-FEATURE-USAGE-063
        step("Verify: generates negated conditional branch")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var builder = PtxBuilder__create((8, 6))
        builder.emit_branch_if_not("%p0", "BB_false")
        val ptx = builder.build()

        expect(ptx).to_contain("@!%p0 bra BB_false;")

    it "generates labels":
        # @req: REQ-FEATURE-USAGE-064
        step("Verify: generates labels")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var builder = PtxBuilder__create((8, 6))
        builder.emit_label("BB0")
        builder.emit_line("nop;")
        val ptx = builder.build()

        expect(ptx).to_contain("BB0:")

    it "generates return instruction":
        # @req: REQ-FEATURE-USAGE-065
        step("Verify: generates return instruction")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var builder = PtxBuilder__create((8, 6))
        builder.emit_ret()
        val ptx = builder.build()

        expect(ptx).to_contain("ret;")

    it "generates exit instruction":
        # @req: REQ-FEATURE-USAGE-066
        step("Verify: generates exit instruction")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var builder = PtxBuilder__create((8, 6))
        builder.emit_exit()
        val ptx = builder.build()

        expect(ptx).to_contain("exit;")

