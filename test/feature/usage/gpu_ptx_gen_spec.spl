describe "Launch Configuration", tag: ["only-compiled"]:
    if not test_env_cuda_available():
        it "env_skip: CUDA not available":
            # @req: REQ-FEATURE-USAGE-087
            step("Verify: env_skip: CUDA not available")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val reason = test_env_gate_skip("SIMPLE_CUDA_TEST")
            expect(reason).to_contain("Skipped")
        return
    # ## Kernel Launch Configuration
    #
    # Tests launch configuration validation and computation.

    it "creates 1D launch config":
        # @req: REQ-FEATURE-USAGE-088
        step("Verify: creates 1D launch config")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val config = LaunchConfig.for_1d(1024, 256)
        expect(config.grid_x).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(config.grid_y).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(config.grid_z).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(config.block_x).to_equal(256)  # oracle: expected value 256 is the behavior asserted by this regression spec
        expect(config.total_threads()).to_equal(1024)  # oracle: expected value 1024 is the behavior asserted by this regression spec

    it "rounds up grid size for non-divisible total":
        # @req: REQ-FEATURE-USAGE-089
        step("Verify: rounds up grid size for non-divisible total")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val config = LaunchConfig.for_1d(1000, 256)
        expect(config.grid_x).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(config.total_threads()).to_be_greater_than(999)

    it "creates 2D launch config":
        # @req: REQ-FEATURE-USAGE-090
        step("Verify: creates 2D launch config")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val config = LaunchConfig.for_2d(512, 512, 16, 16)
        expect(config.grid_x).to_equal(32)  # oracle: expected value 32 is the behavior asserted by this regression spec
        expect(config.grid_y).to_equal(32)  # oracle: expected value 32 is the behavior asserted by this regression spec
        expect(config.block_x).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec
        expect(config.block_y).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec

    it "computes total blocks":
        # @req: REQ-FEATURE-USAGE-091
        step("Verify: computes total blocks")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val config = LaunchConfig.for_2d(512, 512, 16, 16)
        expect(config.total_blocks()).to_equal(1024)  # oracle: expected value 1024 is the behavior asserted by this regression spec

    it "computes threads per block":
        # @req: REQ-FEATURE-USAGE-092
        step("Verify: computes threads per block")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val config = LaunchConfig.for_2d(512, 512, 16, 16)
        expect(config.threads_per_block()).to_equal(256)  # oracle: expected value 256 is the behavior asserted by this regression spec

    it "validates valid config":
        # @req: REQ-FEATURE-USAGE-093
        step("Verify: validates valid config")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val config = LaunchConfig.for_1d(1024, 256)
        val err = config.validate()
        expect(err).to_be_nil()

    it "rejects zero block size":
        # @req: REQ-FEATURE-USAGE-094
        step("Verify: rejects zero block size")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val config = LaunchConfig.for_1d(1024, 0)
        val err = config.validate()
        expect(err).to_be_nil()  # for_1d with 0 produces invalid config
        # The grid would be computed with division by zero;
        # real validation catches block dims

    it "adds shared memory to config":
        # @req: REQ-FEATURE-USAGE-095
        step("Verify: adds shared memory to config")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val config = LaunchConfig.for_1d(1024, 256).with_shared_mem(4096)
        expect(config.shared_mem_bytes).to_equal(4096)  # oracle: expected value 4096 is the behavior asserted by this regression spec
        expect(config.block_x).to_equal(256)  # oracle: expected value 256 is the behavior asserted by this regression spec

