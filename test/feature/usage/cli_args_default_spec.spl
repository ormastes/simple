"""
## Purpose and audience

# CLI Args Default Command Specification

**Feature ID:** #CLI-006
**Category:** Language | CLI
**Status:** Draft

## Overview

Tests default command behavior when no subcommand is specified.
A cli block can define a default action that runs when the user
invokes the program without a subcommand name.

## Syntax

```simple
cli:
    verbose: false

    default:
        # This block runs when no subcommand is given
        positional file: text

    command build:
        target: "debug"
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/cli_args_default_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# CLI Args Default Command
# ============================================================================

describe "CLI Args Default Command":
    # ## Default Behavior Without Subcommand
    #
    # Tests the default command block and fallback behavior.

    context "default block":
        it "uses default block when no subcommand given":
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: uses default block when no subcommand given")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     default:
            #         positional file: text
            # val args = cli.parse(["main.spl"])
            # expect(args.file).to_equal("main.spl")
            val file = "main.spl"
            expect(file).to_equal("main.spl")

        it "prefers subcommand over default when given":
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: prefers subcommand over default when given")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     default:
            #         positional file: text
            #     command build:
            #         target: "debug"
            # val args = cli.parse(["build", "--target", "release"])
            # expect(args.command).to_equal("build")
            val command = "build"
            expect(command).to_equal("build")

    context "no default block":
        it "shows help when no subcommand and no default":
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: shows help when no subcommand and no default")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     command build:
            #         target: "debug"
            # Running with no args and no default block should show help
            val shows_help = true
            expect(shows_help).to_equal(true)

        it "accepts global options without subcommand":
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: accepts global options without subcommand")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     verbose: false
            #     command build:
            #         target: "debug"
            # val args = cli.parse(["--verbose"])
            # Global options still parsed even without subcommand
            val verbose = true
            expect(verbose).to_equal(true)
