"""
## Purpose and audience

# LLVM Backend Codegen Specification


**Feature IDs:** #4000
**Category:** Infrastructure
**Difficulty:** 5/5
**Status:** In Progress

The LLVM backend provides high-performance native code generation for the Simple language
compiler. It converts the compiler's Intermediate Representation (MIR) to LLVM IR, enabling
optimized machine code generation for multiple target platforms. This specification covers
LLVM IR generation, optimization passes, linking, and target-specific code generation.

## Key Concepts

| Concept | Description |
|---------|-------------|
| LLVM IR | Intermediate representation compatible with LLVM compiler framework |
| MIR to LLVM | Conversion pipeline from Simple's MIR to LLVM IR |
| Optimization Passes | LLVM-level optimizations (inlining, dead code elimination, etc) |
| Code Generation | Conversion of LLVM IR to native machine code |
| Target Platform | Architecture and OS-specific code generation (x86_64, ARM, etc) |
| Linking | Integration with system linker and native libraries |

## Behavior

The LLVM backend:
- Translates MIR instructions to equivalent LLVM IR constructs
- Preserves type information and memory semantics
- Enables high-level optimizations through LLVM optimization passes
- Generates platform-specific machine code
- Integrates with native linkers for final executable generation
- Supports multiple target architectures and operating systems

## Implementation Notes

- LLVM IR generation uses the `inkwell` Rust bindings
- Optimization level controlled via compiler flags
- Target triple determines platform-specific behavior
- Function attributes affect code generation and optimization
- Debug information preserved for debugging support

## Related Specifications

- Intermediate Representation (MIR format specification)
- Memory Model (reference capabilities and ownership rules)
- FFI Integration (native function calling conventions)
- Type System (type information preservation in codegen)

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/llvm_backend_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use compiler.backend.llvm_ir_builder.{LlvmIRBuilder, LlvmIRBuilder__create, MirToLlvm, MirToLlvm__create, LlvmPass, passes_for_level}
use compiler.backend.llvm_target.{LlvmTargetTriple, LlvmTargetTriple__from_target, LlvmTargetTriple__from_target_with_mode, LlvmTargetConfig, LlvmTargetConfig__for_target, LlvmTargetConfig__compatibility_build}
use compiler.backend.llvm_type_mapper.{LlvmTypeMapper, LlvmTypeMapper__create_for_target}
use compiler.backend.backend_api.{CodegenTarget, OptimizationLevel}
use std.common.test_env_gate.{test_env_llvm_available, test_env_gate_skip}
use std.spec.{step}

describe "LLVM Backend Codegen":
    if not test_env_llvm_available():
        it "env_skip: LLVM not available":
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: env_skip: LLVM not available")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val reason = test_env_gate_skip("SIMPLE_LLVM_TEST")
            expect(reason).to_contain("Skipped")
        return
    # ## LLVM Backend Codegen Specification
    #
    # This test suite verifies LLVM backend code generation including:
    # - Correct MIR to LLVM IR translation
    # - Function prologue/epilogue generation
    # - Stack frame management and calling conventions
    # - Memory operations and pointer handling
    # - Optimization level preservation
    # - Platform-specific code generation

    context "basic arithmetic operations":
        it "generates code for integer addition":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: generates code for integer addition")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn add(a: i32, b: i32) -> i32:
                a + b
            expect add(5, 3) == 8

        it "generates code for integer multiplication":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: generates code for integer multiplication")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn multiply(a: i32, b: i32) -> i32:
                a * b
            expect multiply(5, 3) == 15

        it "generates code for floating-point operations":
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: generates code for floating-point operations")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn divide(a: f64, b: f64) -> f64:
                a / b
            val result = divide(10.0, 2.0)
            expect((result - 5.0).abs()).to_be_less_than(0.001)

    context "control flow generation":
        it "generates code for if-else branches":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: generates code for if-else branches")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn classify(x: i32) -> text:
                if x > 0:
                    "positive"
                else:
                    "non-positive"
            expect classify(5) == "positive"
            expect classify(-3) == "non-positive"

        it "generates code for loops":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: generates code for loops")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn count_up(n: i32) -> i32:
                var sum = 0
                var i = 0
                while i < n:
                    sum = sum + i
                    i = i + 1
                sum
            expect count_up(5) == 10

    context "function calls and stack management":
        it "handles function calls":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: handles function calls")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn outer(x: i32) -> i32:
                fn inner(y: i32) -> i32:
                    y * 2
                inner(x) + 5
            expect outer(3) == 11

        it "handles recursive function calls":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: handles recursive function calls")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn fibonacci(n: i32) -> i32:
                if n <= 1:
                    n
                else:
                    fibonacci(n - 1) + fibonacci(n - 2)
            expect fibonacci(6) == 8

    context "memory operations":
        it "generates code for variable assignment":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: generates code for variable assignment")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn variable_ops():
                var x = 5
                x = x + 3
                x
            expect variable_ops() == 8

        it "handles mutable struct fields":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: handles mutable struct fields")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            class Point:
                x: i32
                y: i32
            fn move_point():
                var p = Point(x: 0, y: 0)
                p.x = 10
                p.y = 20
                (p.x, p.y)
            val (x, y) = move_point()
            expect x == 10
            expect y == 20

    context "collection operations":
        it "generates code for list operations":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: generates code for list operations")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn list_ops():
                val items = [1, 2, 3, 4, 5]
                items.length
            expect list_ops() == 5

        it "generates code for map operations":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: generates code for map operations")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn map_ops():
                val items = {"a": 1, "b": 2}
                items["a"]
            expect map_ops() == 1

    context "type operations":
        it "generates code for type conversions":
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: generates code for type conversions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn convert():
                val i = 42
                val f = i.to_f64()
                f
            val result = convert()
            expect((result - 42.0).abs()).to_be_less_than(0.001)

    context "optimization preservation":
        it "preserves correct semantics under optimization":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: preserves correct semantics under optimization")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn optimizable(n: i32) -> i32:
                val x = 5
                val y = 3
                x + y + n
            expect optimizable(2) == 10

        it "maintains correct results with loop optimization":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: maintains correct results with loop optimization")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn loop_opt(n: i32) -> i32:
                var result = 1
                var i = 1
                while i <= n:
                    result = result * i
                    i = i + 1
                result
            expect loop_opt(5) == 120

    context "optimization":
        it "generates passes for optimization levels":
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: generates passes for optimization levels")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val debug_passes = passes_for_level(OptimizationLevel.Debug)
            expect(debug_passes.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            val speed_passes = passes_for_level(OptimizationLevel.Speed)
            expect(speed_passes.len()).to_be_greater_than(4)
            val aggressive_passes = passes_for_level(OptimizationLevel.Aggressive)
            expect(aggressive_passes.len()).to_be_greater_than(8)

    context "debug info", tag: ["only-compiled"]:
        it "emits debug info header":
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: emits debug info header")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val target = LlvmTargetTriple__from_target(CodegenTarget.X86_64)
            var builder = LlvmIRBuilder__create("test", target)
            builder.emit_debug_info_header("test.spl", "/home/user")
            val ir = builder.build()
            expect(ir).to_contain("DICompileUnit")
            expect(ir).to_contain("test.spl")

    context "ABI", tag: ["only-compiled"]:
        it "emits typed function calls":
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: emits typed function calls")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val target = LlvmTargetTriple__from_target(CodegenTarget.X86_64)
            var builder = LlvmIRBuilder__create("test", target)
            builder.emit_module_header()
            builder.start_function("main", [], "i64")
            builder.emit("  %0 = call i64 @add(i32 1, i64 2)")
            builder.end_function()
            val ir = builder.build()
            expect(ir).to_contain("call i64 @add")

    context "target datalayout", tag: ["only-compiled"]:
        it "emits datalayout for x86_64":
            # @req: REQ-FEATURE-USAGE-019
            step("Verify: emits datalayout for x86_64")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val target = LlvmTargetTriple__from_target(CodegenTarget.X86_64)
            var builder = LlvmIRBuilder__create("test", target)
            builder.emit_module_header()
            val ir = builder.build()
            expect(ir).to_contain("target datalayout")
            expect(ir).to_contain("n8:16:32:64-S128")

        it "emits datalayout for i686":
            # @req: REQ-FEATURE-USAGE-020
            step("Verify: emits datalayout for i686")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val target = LlvmTargetTriple__from_target(CodegenTarget.X86)
            var builder = LlvmIRBuilder__create("test", target)
            builder.emit_module_header()
            val ir = builder.build()
            expect(ir).to_contain("target datalayout")
            expect(ir).to_contain("p:32:32")

        it "emits datalayout for aarch64":
            # @req: REQ-FEATURE-USAGE-021
            step("Verify: emits datalayout for aarch64")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val target = LlvmTargetTriple__from_target(CodegenTarget.AArch64)
            var builder = LlvmIRBuilder__create("test", target)
            builder.emit_module_header()
            val ir = builder.build()
            expect(ir).to_contain("target datalayout")
            expect(ir).to_contain("n32:64-S128")

        it "emits datalayout before target triple":
            # @req: REQ-FEATURE-USAGE-022
            step("Verify: emits datalayout before target triple")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val target = LlvmTargetTriple__from_target(CodegenTarget.X86_64)
            var builder = LlvmIRBuilder__create("test", target)
            builder.emit_module_header()
            val ir = builder.build()
            val dl_pos = ir.find("target datalayout")
            val tt_pos = ir.find("target triple")
            expect(dl_pos).to_be_less_than(tt_pos)

    context "32-bit type handling", tag: ["only-compiled"]:
        it "native_int_type is i32 for 32-bit targets":
            # @req: REQ-FEATURE-USAGE-023
            step("Verify: native_int_type is i32 for 32-bit targets")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var translator = MirToLlvm__create("test", CodegenTarget.X86, nil)
            expect(translator.native_int()).to_equal("i32")

        it "native_int_type is i64 for 64-bit targets":
            # @req: REQ-FEATURE-USAGE-024
            step("Verify: native_int_type is i64 for 64-bit targets")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var translator = MirToLlvm__create("test", CodegenTarget.X86_64, nil)
            expect(translator.native_int()).to_equal("i64")

        it "type mapper uses 32-bit pointers for i686":
            # @req: REQ-FEATURE-USAGE-025
            step("Verify: type mapper uses 32-bit pointers for i686")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mapper = LlvmTypeMapper__create_for_target(CodegenTarget.X86)
            expect(mapper.target_bits).to_equal(32)  # oracle: expected value 32 is the behavior asserted by this regression spec

        it "type mapper uses 64-bit pointers for x86_64":
            # @req: REQ-FEATURE-USAGE-026
            step("Verify: type mapper uses 64-bit pointers for x86_64")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mapper = LlvmTypeMapper__create_for_target(CodegenTarget.X86_64)
            expect(mapper.target_bits).to_equal(64)  # oracle: expected value 64 is the behavior asserted by this regression spec

        it "builder size_type is i32 for 32-bit targets":
            # @req: REQ-FEATURE-USAGE-027
            step("Verify: builder size_type is i32 for 32-bit targets")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val target = LlvmTargetTriple__from_target(CodegenTarget.X86)
            var builder = LlvmIRBuilder__create("test", target)
            expect(builder.size_type).to_equal("i32")

        it "builder size_type is i64 for 64-bit targets":
            # @req: REQ-FEATURE-USAGE-028
            step("Verify: builder size_type is i64 for 64-bit targets")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val target = LlvmTargetTriple__from_target(CodegenTarget.X86_64)
            var builder = LlvmIRBuilder__create("test", target)
            expect(builder.size_type).to_equal("i64")

    context "compatibility build", tag: ["only-compiled"]:
        it "selects correct CPU for x86_64":
            # @req: REQ-FEATURE-USAGE-029
            step("Verify: selects correct CPU for x86_64")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = LlvmTargetConfig__compatibility_build(CodegenTarget.X86_64)
            expect(config.cpu).to_equal("x86-64")

        it "selects correct CPU for i686":
            # @req: REQ-FEATURE-USAGE-030
            step("Verify: selects correct CPU for i686")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = LlvmTargetConfig__compatibility_build(CodegenTarget.X86)
            expect(config.cpu).to_equal("i686")

        it "selects correct CPU for aarch64":
            # @req: REQ-FEATURE-USAGE-031
            step("Verify: selects correct CPU for aarch64")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = LlvmTargetConfig__compatibility_build(CodegenTarget.AArch64)
            expect(config.cpu).to_equal("generic")

        it "selects correct CPU for riscv64":
            # @req: REQ-FEATURE-USAGE-032
            step("Verify: selects correct CPU for riscv64")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = LlvmTargetConfig__compatibility_build(CodegenTarget.Riscv64)
            expect(config.cpu).to_equal("generic-rv64")

        it "selects correct CPU for riscv32":
            # @req: REQ-FEATURE-USAGE-033
            step("Verify: selects correct CPU for riscv32")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = LlvmTargetConfig__compatibility_build(CodegenTarget.Riscv32)
            expect(config.cpu).to_equal("generic-rv32")
