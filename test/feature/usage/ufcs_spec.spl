"""
## Purpose and audience

# UFCS (Uniform Function Call Syntax) Specification

**Feature IDs:** #3100-3120
**Category:** Syntax
**Difficulty:** 4/5
**Status:** Implemented

## Overview

UFCS (Uniform Function Call Syntax) allows calling free functions using method syntax.
When `x.method()` is called, the compiler resolves in priority order:
1. Instance method on x's type (highest priority)
2. Trait method implemented by x's type
3. Free function `method(x)` where first param matches x's type (UFCS)

This enables fluent API chaining without requiring methods to be defined on types.

## Syntax

```simple
# Free function
fn double(x: i64) -> i64:
x * 2

# Usage via UFCS
val n = 5
val result = n.double()    # Resolves to: double(n)
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| UFCS | Uniform Function Call Syntax - call free functions as methods |
| Resolution Priority | Instance > Trait > FreeFunction |
| Type Matching | First parameter type must be compatible with receiver |

## Implementation Notes

Files involved:
- `simple/compiler/hir.spl` - MethodResolution enum
- `simple/compiler/resolve.spl` - Resolution pass
- `simple/compiler/mir.spl` - Codegen support
- `simple/compiler/driver.spl` - Pipeline integration

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/ufcs_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Basic UFCS Functionality
# ============================================================================

describe "UFCS Basic Functionality":
    # ## Basic UFCS Usage
    #
    # Tests basic UFCS functionality where free functions are called
    # using method syntax on values.

    context "with integer values":
        it "calls math.abs via dot notation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: calls math.abs via dot notation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val n = -5
            val result = n.abs()
            expect result == 5

        it "calls math.sqrt via dot notation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: calls math.sqrt via dot notation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 16.0
            val result = x.sqrt()
            expect result == 4.0

    context "with array values":
        it "calls array.len via dot notation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: calls array.len via dot notation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3, 4, 5]
            val result = arr.len()
            expect result == 5

        it "calls array.first via dot notation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: calls array.first via dot notation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [10, 20, 30]
            val result = arr.first()
            expect result == 10

        it "calls array.last via dot notation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: calls array.last via dot notation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [10, 20, 30]
            val result = arr.last()
            expect result == 30

# ============================================================================
# Test Group 2: Method Chaining
# ============================================================================

describe "UFCS Method Chaining":
    # ## Chaining UFCS Calls
    #
    # Multiple UFCS calls can be chained together for fluent APIs.

    context "chaining multiple UFCS calls":
        it "chains abs and to_string":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: chains abs and to_string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val n = -42
            val result = n.abs().to_string()
            expect result == "42"

        it "chains array operations":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: chains array operations")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            val result = arr.len().to_string()
            expect result == "3"

# ============================================================================
# Test Group 3: Priority Ordering
# ============================================================================

describe "UFCS Priority Ordering":
    # ## Resolution Priority
    #
    # Method calls resolve in priority order:
    # 1. Instance method on receiver's type (highest)
    # 2. Trait method implemented by receiver's type
    # 3. Free function (UFCS) (lowest)
    #
    # This ensures existing methods are not accidentally overridden.

    context "instance method takes priority":
        it "calls string.len method not free function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: calls string.len method not free function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = "hello"
            val result = s.len()
            expect result == 5

        it "calls array.push method":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: calls array.push method")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            arr = arr.push(4)
            expect arr.len() == 4

# ============================================================================
# Test Group 4: Type Matching
# ============================================================================

describe "UFCS Type Matching":
    # ## Type Compatibility
    #
    # For UFCS, the receiver type must be compatible with the
    # first parameter type of the free function.

    context "exact type matching":
        it "matches i64 receiver with i64 parameter":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: matches i64 receiver with i64 parameter")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val n: i64 = -5
            val result = n.abs()
            expect result == 5

        it "matches f64 receiver with f64 parameter":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: matches f64 receiver with f64 parameter")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x: f64 = 16.0
            val result = x.sqrt()
            expect result == 4.0

# ============================================================================
# Test Group 5: Edge Cases
# ============================================================================

describe "UFCS Edge Cases":
    # ## Edge Cases and Special Scenarios
    #
    # Tests for edge cases in UFCS resolution and usage.

    context "with zero and negative values":
        it "works with zero":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: works with zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val n = 0
            val result = n.abs()
            expect result == 0

        it "works with negative float":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: works with negative float")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = -3.14
            val result = x.abs()
            expect result == 3.14

    context "with empty collections":
        it "len of empty array is zero":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: len of empty array is zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr: [i64] = []
            val result = arr.len()
            expect result == 0

        it "first of empty array is None":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: first of empty array is None")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr: [i64] = []
            val result = arr.first()
            expect result == nil

    context "receiver as expression":
        it "works with literal receiver":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: works with literal receiver")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = (-5).abs()
            expect result == 5

        it "works with arithmetic expression receiver":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: works with arithmetic expression receiver")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = (3 - 8).abs()
            expect result == 5
