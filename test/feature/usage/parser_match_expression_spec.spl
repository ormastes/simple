"""
## Purpose and audience

# Match Expression Separator Specification

**Feature IDs:** #PARSER-ME-001 to #PARSER-ME-010
**Category:** Infrastructure | Parser
**Status:** In Progress

## Bug: Match arm separators in expression context

The runtime has two match parsers:
1. Statement-level: `case` keyword + `:` (works, but no return value)
2. Expression-level: only `=>` works (returns value, rejects `:` and `case`)

The expression-level parser should also accept `:` and `case` keyword.
Fix: src/app/parser/expr/control.spl lines 78-94

Broken syntax (expression context):
val y = match x:
42: "found"           # error: expected FatArrow, found Colon
val y = match x:
case 42: "found"     # error: expected pattern, found Case

After rebuild, uncomment skipped tests in Group 3 below.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/parser_match_expression_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")

fn match_side_effect(x: i64) -> text:
    var out = ""
    match x:
        case 0:
            out = "zero"
        case 1:
            out = "one"
        case _:
            out = "other"
    out

fn match_guard_side_effect(x: i64) -> text:
    var out = ""
    match x:
        case n if n < 0:
            out = "negative"
        case n if n == 0:
            out = "zero"
        case _:
            out = "positive"
    out

describe "Match Statement case+colon":

    it "executes matching arm for integer patterns":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: executes matching arm for integer patterns")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect match_side_effect(0) == "zero"
        expect match_side_effect(1) == "one"
        expect match_side_effect(99) == "other"

    it "executes arm with guard clauses":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: executes arm with guard clauses")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect match_guard_side_effect(-5) == "negative"
        expect match_guard_side_effect(0) == "zero"
        expect match_guard_side_effect(42) == "positive"

describe "Match Expression FatArrow":

    it "single-expression arms return values":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: single-expression arms return values")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val v1 = match 42:
            42 => "found"
            _ => "other"
        expect v1 == "found"
        val v2 = match 99:
            42 => "found"
            _ => "other"
        expect v2 == "other"

    it "multi-line arm bodies return last expression":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: multi-line arm bodies return last expression")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val output = match 42:
            42 =>
                val x = 42 + 1
                x
            _ =>
                0
        expect output == 43

    it "multiple statements in arm body":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: multiple statements in arm body")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val output = match 10:
            10 =>
                val a = 10 * 2
                val b = a + 5
                b
            _ =>
                -1
        expect output == 25

    it "guard clauses select correct arm":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: guard clauses select correct arm")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val output = match 42:
            x if x > 100 => "big"
            x if x > 0 => "positive"
            _ => "other"
        expect output == "positive"

    it "nested match expressions return values":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: nested match expressions return values")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 1
        val output = match a:
            1 =>
                val inner = match 2:
                    2 => "one-two"
                    _ => "one-other"
                inner
            _ =>
                "other"
        expect output == "one-two"

# ============================================================================
# Bug Fix Tests: Expression-Level Colon Separator (#PARSER-ME-008..010)
# ============================================================================
# After rebuild with src/app/parser/expr/control.spl fix, uncomment these
# and add a new describe block:
#
# describe "Match Expression Colon Separator BugFix":
