"""
## Purpose and audience

# Fixed-Size Array Edge Cases and Boundary Conditions

**Feature ID:** #LANG-008b
**Category:** Language
**Status:** Active

## Overview

This spec exercises the boundary conditions and edge cases of fixed-size arrays that go
beyond typical usage. It tests zero-length arrays, single-element arrays, negative indexing
on various sizes, and fixed-size arrays of non-numeric types (text, bool). It also verifies
that functional operations like `map`, `filter`, and `reduce` behave correctly when applied
to fixed-size arrays, including cases where `filter` produces a result smaller than the
original size.

## Syntax

```simple
val empty: [i64; 0] = []
val single: [i64; 1] = [42]
val names: [text; 3] = ["alice", "bob", "charlie"]
val flags: [bool; 2] = [true, false]
val big = arr.filter(_1 > 3)
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Zero-Size Array | `[T; 0]` is a valid empty fixed-size array that supports iteration |
| Boundary Indexing | Single and two-element arrays test the smallest non-trivial sizes |
| Multi-Type Support | Fixed-size arrays work with `i64`, `f64`, `text`, and `bool` element types |
| Size-Changing Ops | `filter` on a fixed-size array returns a dynamic array that may be smaller |

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/fixed_size_edge_cases_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Fixed-Size Array Edge Cases":

    context "Size Zero":
        it "allows size-zero arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: allows size-zero arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val empty: [i64; 0] = []
            expect empty.len() == 0

        it "iterates over size-zero arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: iterates over size-zero arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val empty: [i64; 0] = []
            var count = 0
            for _ in empty:
                count = count + 1
            expect count == 0

    context "Negative Indexing":
        it "supports negative indices":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: supports negative indices")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr: [i64; 5] = [1, 2, 3, 4, 5]
            expect arr[-1] == 5
            expect arr[-2] == 4
            expect arr[-3] == 3

    context "Boundary Conditions":
        it "handles single element arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: handles single element arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val single: [i64; 1] = [42]
            expect single[0] == 42
            expect single.len() == 1

        it "handles two element arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: handles two element arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pair: [i64; 2] = [10, 20]
            expect pair[0] == 10
            expect pair[1] == 20
            expect pair.len() == 2

    context "Mixed Types":
        it "works with string arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: works with string arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val names: [text; 3] = ["alice", "bob", "charlie"]
            expect names[0] == "alice"
            expect names.len() == 3

        it "works with boolean arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: works with boolean arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val flags: [bool; 2] = [true, false]
            expect flags[0] == true
            expect flags[1] == false

    context "Functional Operations on Fixed":
        it "map preserves values":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: map preserves values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr: [i64; 4] = [1, 2, 3, 4]
            val doubled = arr.map(_1 * 2)
            expect doubled[0] == 2
            expect doubled.len() == 4
            expect doubled[3] == 8

        it "filter may reduce size":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: filter may reduce size")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr: [i64; 5] = [1, 2, 3, 4, 5]
            val big = arr.filter(_1 > 3)
            expect big[0] == 4
            expect big.len() == 2
            expect big[1] == 5

        it "reduce works on fixed arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: reduce works on fixed arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr: [i64; 3] = [10, 20, 30]
            val total = arr.reduce(0, \acc, x: acc + x)
            expect total == 60
