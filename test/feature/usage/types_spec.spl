"""
## Purpose and audience

# Simple Language Type System - Test Specification

**Status:** Stable (Basic Features)
**Feature IDs:** #20-29
**Keywords:** types, mutability, type-inference
**Last Updated:** 2026-02-08
**Topics:** type-system
**Migrated From:** doc/06_spec/types.md

## Overview

Executable tests for Simple's type system basics: primitives, mutability, generics, and type inference.

Note: Advanced features (unit types, capability effects, suspension operators) are not yet implemented.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/types_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")

describe "Types Spec":
    it "basic type literals":
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: basic type literals")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # String, integer, boolean, float literals
        val s = "hello"
        val i = 42
        val b = true
        val f = 3.14
        expect(s).to_equal("hello")
        expect(i).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec
        expect(b).to_equal(true)

    it "mutability rules - val and const":
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: mutability rules - val and const")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val y = 20
        const MAX = 100
        expect(y).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec
        expect(MAX).to_equal(100)  # oracle: expected value 100 is the behavior asserted by this regression spec

    it "mutable variables":
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: mutable variables")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var count = 0
        count = count + 1
        count = count + 1
        expect(count).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it "generic container - array":
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: generic container - array")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Array is a generic type [T]
        val numbers = [1, 2, 3, 4, 5]
        val strings = ["a", "b", "c"]
        expect(numbers[0]).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(strings[1]).to_equal("b")

    it "option type basic usage":
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: option type basic usage")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Option is a built-in generic type
        val some_val = 42
        val none_val = nil

        # Basic Option behavior
        if some_val != nil:
            expect(some_val).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

        if none_val == nil:
            check(true)
