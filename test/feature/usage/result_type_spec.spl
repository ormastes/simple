"""
## Purpose and audience

# Result Type Specification


**Feature ID:** #RESULT-001
**Category:** Language | Types
**Status:** Implemented

## Overview

Tests for the Result type representing success or error outcomes,
including constructors, pattern matching, and safe unwrapping mechanisms.

## Syntax

```simple
val success: Result<i32, text> = Ok(42)
val failure: Result<i32, text> = Err("error")

match result:
Ok(value) => print "Success: {value}"
Err(msg) => print "Error: {msg}"

val unwrapped = result.unwrap()              # Raises if Err
val safe = result.unwrap_or(0)               # Default if Err
val propagated = fallible_operation()?       # Early return on Err
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/result_type_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Basic Result Usage
# ============================================================================

describe "Result Type Basic Usage":
    # ## Result Construction and Access
    #
    # Verifies creation of Ok/Err values, basic unwrapping,
    # and pattern matching with Result types.

    context "Ok values":
        it "creates Ok with value":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: creates Ok with value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val res = Ok(42)
            expect res.unwrap() == 42

        it "checks Ok is ok":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: checks Ok is ok")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val res = Ok(10)
            expect res.ok.?

        it "checks Ok is not err":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: checks Ok is not err")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val res = Ok(5)
            expect not res.err.?

    context "Err values":
        it "creates Err with error":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: creates Err with error")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val res = Err("error message")
            expect res.err.?

        it "checks Err is not ok":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: checks Err is not ok")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val res = Err("oops")
            expect not res.ok.?

        it "uses unwrap_or for Err":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: uses unwrap_or for Err")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val res = Err("error")
            expect res.unwrap_or(99) == 99


# ============================================================================
# Test Group 2: Result from Functions
# ============================================================================

describe "Result from Functions":
    # ## Functions Returning Result
    #
    # Tests for functions that return Result types for error handling.

    it "returns Ok from function":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: returns Ok from function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn safe_divide(a, b):
            if b == 0:
                return Err("division by zero")
            return Ok(a / b)

        val r = safe_divide(20, 4)
        expect r.unwrap() == 5

    it "returns Err from function":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: returns Err from function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn safe_divide(a, b):
            if b == 0:
                return Err("division by zero")
            return Ok(a / b)

        val r = safe_divide(10, 0)
        expect r.unwrap_or(-1) == -1

    it "chains Result operations":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: chains Result operations")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn step1(x):
            if x < 0:
                return Err("negative")
            return Ok(x + 10)

        fn step2(x):
            if x > 100:
                return Err("too large")
            return Ok(x * 2)

        val r1 = step1(5)
        val r2 = r1.map(step2(_1).unwrap_or(-1))
        expect r2.unwrap() == 30  # (5 + 10) * 2


# ============================================================================
# Test Group 3: Question Mark Operator
# ============================================================================

describe "Question Mark Operator":
    # ## ? Operator for Error Propagation
    #
    # Tests the ? operator that propagates errors by early return.

    it "propagates Ok value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: propagates Ok value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn may_fail(x) -> Result<i64, text>:
            if x < 0:
                return Err("negative")
            return Ok(x * 2)

        fn caller(x):
            val result = may_fail(x)?
            return Ok(result + 1)

        val res = caller(5)
        expect res.unwrap() == 11  # 5 * 2 + 1

    it "propagates Err to caller":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: propagates Err to caller")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn may_fail(x) -> Result<i64, text>:
            if x < 0:
                return Err("negative")
            return Ok(x * 2)

        fn caller(x):
            val result = may_fail(x)?
            return Ok(result + 1)

        val res = caller(-5)
        expect res.unwrap_or(-99) == -99

    it "chains multiple ? operators":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: chains multiple ? operators")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn step1(x):
            if x < 0:
                return Err("step1 failed")
            return Ok(x + 10)

        fn step2(x):
            if x > 100:
                return Err("step2 failed")
            return Ok(x * 2)

        fn pipeline(x):
            val a = step1(x)?
            val b = step2(a)?
            return Ok(b)

        val res = pipeline(5)
        expect res.unwrap() == 30  # (5 + 10) * 2


# ============================================================================
# Test Group 4: Result Pattern Matching
# ============================================================================

describe "Result Pattern Matching":
    # ## Pattern Matching with Result
    #
    # Tests pattern matching on Result types with Ok and Err variants.

    it "matches Ok variant":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: matches Ok variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val res = Ok(100)
        var output = 0
        match res:
            case Ok(value):
                output = value
            case Err(_):
                output = -1
        expect output == 100

    it "matches Err variant":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: matches Err variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val res = Err("failure")
        var output = 0
        match res:
            case Ok(value):
                output = value
            case Err(_):
                output = -1
        expect output == -1

    it "uses if let with Ok":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: uses if let with Ok")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val res = Ok(100)
        var output = 0
        if let Ok(value) = res:
            output = value
        expect output == 100

    it "uses if let with Err else":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: uses if let with Err else")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val res: Result<i64, text> = Err("error")
        var output = 0
        if let Ok(value) = res:
            output = value
        else:
            output = -1
        expect output == -1
