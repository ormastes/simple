# Test Group 3: Heuristic Struct Parsing
# ============================================================================

describe "Heuristic Struct Parsing", tag: ["only-compiled"]:
    # skip: TreeSitter API not available in interpreter mode
    # Tests parsing struct declarations in heuristic mode.

    it "parses struct declaration":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: parses struct declaration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "struct Vec2:\n    x: f64\n    y: f64"
        var ts = make_heuristic_ts(source)
        val outline = ts.parse_outline()
        expect outline.structs.len() to_equal 1


