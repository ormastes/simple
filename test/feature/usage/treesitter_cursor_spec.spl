# ============================================================================
# Test Group 6: Heuristic Impl Parsing
# ============================================================================

describe "Heuristic Impl Parsing", tag: ["only-compiled"]:
    # skip: TreeSitter API not available in interpreter mode
    # Tests parsing impl blocks with nested methods in heuristic mode.

    it "parses impl block":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: parses impl block")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "impl Point:\n    fn get_x() -> i64:\n        self.x"
        var ts = make_heuristic_ts(source)
        val outline = ts.parse_outline()
        expect outline.impls.len() to_equal 1

    it "parses impl with multiple members":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: parses impl with multiple members")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "impl Point:\n    fn get_x() -> i64:\n        self.x\n    fn get_y() -> i64:\n        self.y"
        var ts = make_heuristic_ts(source)
        val outline = ts.parse_outline()
        expect outline.impls.len() to_equal 1
        # Methods inside impl are collected separately as functions
        expect outline.functions.len() >= 2


