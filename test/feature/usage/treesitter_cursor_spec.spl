"""
## Purpose and audience

# TreeSitter Heuristic Mode Specification

**Feature IDs:** #TS-CURSOR-001 to #TS-CURSOR-015
**Category:** Infrastructure | Parser
**Status:** Implemented

Tests heuristic (line-based) parsing mode of the TreeSitter parser.
Heuristic mode uses simple line scanning instead of full tokenization,
providing error-tolerant results even with malformed input.

## API

```simple
use compiler.treesitter.*
use compiler.core.lexer.*

# Create heuristic-mode parser
var ts = TreeSitter(
lexer: lexer_new(source),
current: lex_token_eof(1),
previous: lex_token_eof(1),
errors: [],
doc_comment: nil,
inline_blocks: [],
current_context: nil,
fast_mode: false,
heuristic_mode: true,
registry: nil
)
val outline = ts.parse_outline()
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/treesitter_cursor_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use compiler.treesitter.*
use compiler.frontend.core.lexer.*
use compiler.frontend.core.lexer_types.{lex_token_eof}
use std.spec.{step}


# Helper to create a heuristic-mode TreeSitter
fn make_heuristic_ts(source: text) -> TreeSitter:
    TreeSitter(
        lexer: lexer_new(source),
        current: lex_token_eof(1),
        previous: lex_token_eof(1),
        errors: [],
        doc_comment: nil,
        inline_blocks: [],
        current_context: nil,
        fast_mode: false,
        heuristic_mode: true,
        registry: nil
    )


# ============================================================================
# Test Group 1: Heuristic Function Parsing
# ============================================================================

describe "Heuristic Function Parsing", tag: ["only-compiled"]:
    # skip: TreeSitter API not available in interpreter mode
    # Tests parsing function declarations in heuristic mode.

    it "parses fn declaration":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: parses fn declaration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "fn hello():\n    42"
        var ts = make_heuristic_ts(source)
        val outline = ts.parse_outline()
        expect outline.functions.len() to_equal 1

    it "parses multiple functions":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: parses multiple functions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "fn foo():\n    1\nfn bar():\n    2"
        var ts = make_heuristic_ts(source)
        val outline = ts.parse_outline()
        expect outline.functions.len() to_equal 2


# ============================================================================
# Test Group 2: Heuristic Class Parsing
# ============================================================================

describe "Heuristic Class Parsing", tag: ["only-compiled"]:
    # skip: TreeSitter API not available in interpreter mode
    # Tests parsing class declarations in heuristic mode.

    it "parses class declaration":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: parses class declaration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "class Point:\n    x: i64\n    y: i64"
        var ts = make_heuristic_ts(source)
        val outline = ts.parse_outline()
        expect outline.classes.len() to_equal 1


