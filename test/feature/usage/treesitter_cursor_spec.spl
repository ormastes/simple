# ============================================================================
# Test Group 8: Heuristic Error Tolerance
# ============================================================================

describe "Heuristic Error Tolerance", tag: ["only-compiled"]:
    # skip: TreeSitter API not available in interpreter mode
    # Tests that heuristic mode handles malformed input gracefully.

    it "handles empty source":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: handles empty source")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = ""
        var ts = make_heuristic_ts(source)
        val outline = ts.parse_outline()
        expect outline.functions.len() to_equal 0

    it "skips unrecognized lines":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: skips unrecognized lines")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "some random text\nfn valid():\n    42"
        var ts = make_heuristic_ts(source)
        val outline = ts.parse_outline()
        # Should still find the valid function
        expect outline.functions.len() to_equal 1

    it "parses mixed valid and invalid":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: parses mixed valid and invalid")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "fn first():\n    1\n??? invalid ???\nfn second():\n    2"
        var ts = make_heuristic_ts(source)
        val outline = ts.parse_outline()
        expect outline.functions.len() to_equal 2
