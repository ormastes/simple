"""
## Purpose and audience

# Skip Keyword - Basic Functionality

**Feature ID:** #PARSER-002
**Category:** Syntax
**Status:** Active

## Overview

Tests basic parsing and runtime behavior of the `skip` keyword as a standalone
statement. Verifies that skip can be used in various contexts (if blocks,
function bodies, loops), that it does not prevent subsequent code execution,
does not affect return values, and does not alter variable scope.

## Syntax

```simple
skip
fn test_function():
skip
return "completed"
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/parser_skip_basic_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Skip keyword - basic functionality":
    it "parses skip as standalone statement":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: parses skip as standalone statement")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var executed = true
        skip
        expect executed == true

    it "parses skip with pass":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: parses skip with pass")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        skip
        pass
        expect true

    it "parses skip in if block":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: parses skip in if block")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val condition = true
        if condition:
            skip
        expect true

    it "parses skip in function body":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: parses skip in function body")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn test_function():
            skip
            return "completed"
        expect test_function() == "completed"

    it "parses multiple skip statements":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: parses multiple skip statements")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        skip
        skip
        skip
        expect true

    it "parses skip before expression":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: parses skip before expression")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        skip
        val result = 2 + 2
        expect result == 4

    it "parses skip in loop":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: parses skip in loop")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var count = 0
        for i in 0..3:
            skip
            count = count + 1
        expect count == 3

    it "skip does not prevent execution":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: skip does not prevent execution")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var executed = false
        skip
        executed = true
        expect executed == true

    it "skip does not affect return value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: skip does not affect return value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn returns_with_skip():
            skip
            return "value"
        expect returns_with_skip() == "value"

    it "skip does not affect variable scope":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: skip does not affect variable scope")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        skip
        val scoped = 100
        expect scoped == 100
