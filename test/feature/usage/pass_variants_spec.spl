"""
## Purpose and audience
Executable contract for the four pass-statement variants of the language:
`pass`, `pass_todo`, `pass_do_nothing`, and `pass_dn`. Each variant must
execute as a bare statement and with a descriptive message, must work inside
functions, control flow, and loops, and must fall through to the following
statement. For language engineers changing statement lowering and for
contributors writing stubs.
## Operator workflow
./src/compiler_rust/target/bootstrap/simple run test/feature/usage/pass_variants_spec.spl
A healthy run reports 20 executed, 0 failed, exit 0.
## Compatibility and limitations
The pass forms under test live in module-level helper functions so each
scenario asserts an observable tail value through a real product execution;
bare statement forms are exercised exactly where they are legal. No
compile-fail or diagnostics behavior is covered here.
## Verification guidance and troubleshooting
Rerun with the command above. A failure means a pass variant no longer falls
through to the next statement or return expression — check statement lowering
in the compiler front end before touching this spec.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.{describe, it, expect, step}

# --- Module-level helpers: each executes its pass variant for real and
# --- returns an observable value the scenarios can assert on.

fn pass_statement_reaches_tail() -> bool:
    var completed = false
    pass
    completed = true
    completed

fn pass_message_reaches_tail(message: text) -> bool:
    var completed = false
    pass(message)
    completed = true
    completed

fn pass_todo_statement_reaches_tail() -> bool:
    var completed = false
    pass_todo
    completed = true
    completed

fn pass_todo_message_reaches_tail(message: text) -> bool:
    var completed = false
    pass_todo(message)
    completed = true
    completed

fn pass_do_nothing_statement_reaches_tail() -> bool:
    var completed = false
    pass_do_nothing
    completed = true
    completed

fn pass_do_nothing_message_reaches_tail(message: text) -> bool:
    var completed = false
    pass_do_nothing(message)
    completed = true
    completed

fn pass_dn_statement_reaches_tail() -> bool:
    var completed = false
    pass_dn
    completed = true
    completed

fn pass_dn_message_reaches_tail(message: text) -> bool:
    var completed = false
    pass_dn(message)
    completed = true
    completed

fn pass_returns_after_statement() -> i64:
    pass
    7

fn pass_todo_returns_after_statement() -> i64:
    pass_todo("not yet implemented")
    11

fn pass_do_nothing_returns_after_statement() -> i64:
    pass_do_nothing
    13

fn pass_dn_returns_after_statement() -> i64:
    pass_dn
    17

fn pass_message_returns_after_statement() -> i64:
    pass("waiting for API design")
    19

fn pass_todo_reason_returns_after_statement() -> i64:
    pass_todo("implement caching layer")
    23

fn pass_do_nothing_explanation_returns_after_statement() -> i64:
    pass_do_nothing("event intentionally ignored")
    29

fn pass_dn_context_returns_after_statement() -> i64:
    pass_dn("placeholder for future expansion")
    31

fn pass_todo_else_branch_taken() -> text:
    var result = "default"
    if false:
        result = "if"
    else:
        pass_todo("handle else case")
        result = "else"
    result

fn loop_with_pass_do_nothing_counts() -> i64:
    var count = 0
    var i = 0
    while i < 3:
        pass_do_nothing
        count = count + 1
        i = i + 1
    count

fn pass_dn_conditional_taken() -> text:
    var result = "none"
    if true:
        pass_dn
        result = "done"
    result

# @manual_section: pass statement variants
describe "Pass Variants as Statements":
    # @manual scenario evidence
    it "pass as statement":
        # @req REQ-SYNTAX-002
        # @capture(statistics): fall-through verdict for the bare pass statement
        step("Execute a bare pass statement and continue to the next statement")
        var executed = false
        pass
        executed = true
        expect(executed).to_equal(true)  # oracle: the statement after bare pass executed

    it "pass with message":
        # @req REQ-SYNTAX-002
        # @capture(statistics): fall-through verdict for pass with a message
        step("Execute pass with a descriptive message and continue to the next statement")
        var executed = false
        pass("temporary placeholder")
        executed = true
        expect(executed).to_equal(true)  # oracle: the statement after pass(message) executed

    it "pass_todo as statement":
        # @req REQ-SYNTAX-002
        # @capture(statistics): fall-through verdict for the bare pass_todo statement
        step("Execute a bare pass_todo statement and continue to the next statement")
        val completed = pass_todo_statement_reaches_tail()
        expect(completed).to_equal(true)  # oracle: the statement after bare pass_todo executed

    it "pass_todo with message":
        # @req REQ-SYNTAX-002
        # @capture(statistics): fall-through verdict for pass_todo with a message
        step("Execute pass_todo with a reason and continue to the next statement")
        val completed = pass_todo_message_reaches_tail("implement error handling")
        expect(completed).to_equal(true)  # oracle: the statement after pass_todo(message) executed

    it "pass_do_nothing as statement":
        # @req REQ-SYNTAX-002
        # @capture(statistics): fall-through verdict for the bare pass_do_nothing statement
        step("Execute a bare pass_do_nothing statement and continue to the next statement")
        val completed = pass_do_nothing_statement_reaches_tail()
        expect(completed).to_equal(true)  # oracle: the statement after bare pass_do_nothing executed

    it "pass_do_nothing with message":
        # @req REQ-SYNTAX-002
        # @capture(statistics): fall-through verdict for pass_do_nothing with a message
        step("Execute pass_do_nothing with an explanation and continue to the next statement")
        val completed = pass_do_nothing_message_reaches_tail("intentional stub for interface")
        expect(completed).to_equal(true)  # oracle: the statement after pass_do_nothing(message) executed

    it "pass_dn as statement":
        # @req REQ-SYNTAX-002
        # @capture(statistics): fall-through verdict for the bare pass_dn statement
        step("Execute a bare pass_dn statement and continue to the next statement")
        val completed = pass_dn_statement_reaches_tail()
        expect(completed).to_equal(true)  # oracle: the statement after bare pass_dn executed

    it "pass_dn with message":
        # @req REQ-SYNTAX-002
        # @capture(statistics): fall-through verdict for pass_dn with a message
        step("Execute pass_dn with context and continue to the next statement")
        val completed = pass_dn_message_reaches_tail("short form no-op")
        expect(completed).to_equal(true)  # oracle: the statement after pass_dn(message) executed

describe "Pass Variants in Functions":
    it "function with pass":
        # @req REQ-SYNTAX-002
        # @capture(statistics): return sentinel observed after the pass statement
        step("Call a function whose body holds a bare pass before its return expression")
        val returned = pass_returns_after_statement()
        expect(returned).to_equal(7)  # oracle: the return expression after bare pass is observed

    it "function with pass_todo":
        # @req REQ-SYNTAX-002
        # @capture(statistics): return sentinel observed after the pass_todo statement
        step("Call a function whose body holds pass_todo before its return expression")
        val returned = pass_todo_returns_after_statement()
        expect(returned).to_equal(11)  # oracle: the return expression after pass_todo is observed

    it "function with pass_do_nothing":
        # @req REQ-SYNTAX-002
        # @capture(statistics): return sentinel observed after the pass_do_nothing statement
        step("Call a function whose body holds pass_do_nothing before its return expression")
        val returned = pass_do_nothing_returns_after_statement()
        expect(returned).to_equal(13)  # oracle: the return expression after pass_do_nothing is observed

    it "function with pass_dn":
        # @req REQ-SYNTAX-002
        # @capture(statistics): return sentinel observed after the pass_dn statement
        step("Call a function whose body holds pass_dn before its return expression")
        val returned = pass_dn_returns_after_statement()
        expect(returned).to_equal(17)  # oracle: the return expression after pass_dn is observed

describe "Pass Variants in Control Flow":
    it "pass in if branch":
        # @req REQ-SYNTAX-002
        # @capture(statistics): branch-result sentinel after pass in the if branch
        step("Run a bare pass inside a taken if branch and read the branch result")
        var result = ""
        if true:
            pass
            result = "executed"
        expect(result).to_equal("executed")  # oracle: statements after pass in the branch executed

    it "pass_todo in else branch":
        # @req REQ-SYNTAX-002
        # @capture(statistics): branch-result sentinel after pass_todo in the else branch
        step("Run pass_todo inside the else branch and read the branch result")
        val result = pass_todo_else_branch_taken()
        expect(result).to_equal("else")  # oracle: the else branch after pass_todo completed

    it "pass_do_nothing in loop":
        # @req REQ-SYNTAX-002
        # @capture(statistics): iteration count observed around pass_do_nothing in the loop body
        step("Loop three times over a pass_do_nothing body and count the iterations")
        val count = loop_with_pass_do_nothing_counts()
        expect(count).to_equal(3)  # oracle: all three iterations ran around the no-op

    it "pass_dn in conditional":
        # @req REQ-SYNTAX-002
        # @capture(statistics): branch-result sentinel after pass_dn in the conditional
        step("Run pass_dn inside a taken conditional and read the branch result")
        val result = pass_dn_conditional_taken()
        expect(result).to_equal("done")  # oracle: statements after pass_dn in the branch executed

describe "Pass Variants with Messages":
    it "pass with descriptive message":
        # @req REQ-SYNTAX-002
        # @capture(statistics): return sentinel observed after pass with a message
        step("Call a function holding pass with a descriptive message before its return")
        val returned = pass_message_returns_after_statement()
        expect(returned).to_equal(19)  # oracle: the return expression after pass(message) is observed

    it "pass_todo with reason":
        # @req REQ-SYNTAX-002
        # @capture(statistics): return sentinel observed after pass_todo with a reason
        step("Call a function holding pass_todo with a reason before its return")
        val returned = pass_todo_reason_returns_after_statement()
        expect(returned).to_equal(23)  # oracle: the return expression after pass_todo(reason) is observed

    it "pass_do_nothing with explanation":
        # @req REQ-SYNTAX-002
        # @capture(statistics): return sentinel observed after pass_do_nothing with an explanation
        step("Call a function holding pass_do_nothing with an explanation before its return")
        val returned = pass_do_nothing_explanation_returns_after_statement()
        expect(returned).to_equal(29)  # oracle: the return expression after pass_do_nothing(text) is observed

    it "pass_dn with context":
        # @req REQ-SYNTAX-002
        # @capture(statistics): return sentinel observed after pass_dn with context
        step("Call a function holding pass_dn with context before its return")
        val returned = pass_dn_context_returns_after_statement()
        expect(returned).to_equal(31)  # oracle: the return expression after pass_dn(text) is observed
