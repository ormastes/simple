"""
## Purpose and audience

# Dictionary Grammar and Syntax Specification


**Feature IDs:** #1002, #1018
**Category:** Language, Syntax
**Status:** Complete

Tests for dictionary literal syntax, ensuring correct grammar is used.
Verifies that {"key": value} syntax works correctly.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/dict_grammar_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Dictionary Grammar":
    # Tests for dictionary literal syntax and grammar.
    # Ensures proper key-value syntax is enforced.

    context "basic dict syntax":
        # ### Scenario: Dictionary Literal Syntax
        #
        # Dictionaries use {"key": value} syntax with quoted keys.

        it "creates dict with string keys":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: creates dict with string keys")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = {"name": "Alice", "age": 30}
            expect config["name"] == "Alice"
            expect config["age"] == 30

        it "creates dict with integer values":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: creates dict with integer values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val scores = {"math": 95, "science": 87, "history": 92}
            expect scores["math"] == 95

        it "creates dict with mixed value types":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: creates dict with mixed value types")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = {"count": 42, "name": "test", "active": true}
            expect data["count"] == 42
            expect data["active"] == true

        it "creates nested dicts":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: creates nested dicts")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val nested = {"outer": {"inner": 123}}
            expect nested["outer"]["inner"] == 123

        it "creates empty dict":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: creates empty dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val empty: Dict<text, i32> = {}
            expect empty.len() == 0

    context "dict with arrays":
        # ### Scenario: Dictionaries Containing Arrays
        #
        # Tests dicts with array values.

        it "stores arrays as values":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: stores arrays as values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = {"numbers": [1, 2, 3], "letters": ["a", "b", "c"]}
            expect data["numbers"][0] == 1
            expect data["letters"][2] == "c"

        it "stores nested structures":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: stores nested structures")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val complex = {
                "users": [
                    {"name": "Alice", "id": 1},
                    {"name": "Bob", "id": 2}
                ]
            }
            expect complex["users"][0]["name"] == "Alice"

    context "dict operations":
        # ### Scenario: Dictionary Operations
        #
        # Tests insertion, update, deletion, and iteration.

        it "inserts new key-value pair":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: inserts new key-value pair")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var dict = {"a": 1}
            dict["b"] = 2
            expect dict["b"] == 2

        it "updates existing value":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: updates existing value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var dict = {"x": 10}
            dict["x"] = 20
            expect dict["x"] == 20

        it "checks key existence":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: checks key existence")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"key": "value"}
            expect dict.has("key")
            expect not dict.has("missing")

        it "gets keys":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: gets keys")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"a": 1, "b": 2, "c": 3}
            val keys = dict.keys()
            expect keys.len() == 3

        it "gets values":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: gets values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"a": 1, "b": 2}
            val values = dict.values()
            expect values.len() == 2

    context "dict with optional chaining":
        # ### Scenario: Dict with Optional Values
        #
        # Using dicts with Option types and optional chaining.

        it "stores optional values":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: stores optional values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"present": Some(42), "absent": nil}
            expect dict["present"] == Some(42)

        it "uses optional chaining with dict access":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: uses optional chaining with dict access")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"key": Some("value")}
            expect dict["key"]?.to_string() == Some("value")

        it "returns nil for missing key with ?":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: returns nil for missing key with ?")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"a": 1}
            expect dict.get("missing") == nil

    context "dict type annotations":
        # ### Scenario: Dict Type Annotations
        #
        # Explicit type annotations for dictionaries.

        it "annotates string to int dict":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: annotates string to int dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict: Dict<text, i32> = {"one": 1, "two": 2}
            expect dict["one"] == 1

        it "annotates string to string dict":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: annotates string to string dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict: Dict<text, text> = {"greeting": "hello"}
            expect dict["greeting"] == "hello"

        it "annotates complex value types":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: annotates complex value types")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict: Dict<text, [i32]> = {"nums": [1, 2, 3]}
            expect dict["nums"].len() == 3
