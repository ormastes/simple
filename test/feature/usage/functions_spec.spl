"""
## Purpose and audience

# Function Definitions Specification


**Feature IDs:** #1004
**Category:** Language
**Status:** In Progress

Tests for function definition and invocation.
Verifies function parameters, return types, implicit returns, and various calling patterns.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/functions_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Function Definitions":
    # Tests for function definitions, parameter handling, and return behavior.
    # Verifies function signatures, parameter passing, type inference, and implicit returns.

    context "basic function definition":
        # ### Scenario: Simple Functions
        #
        # Tests basic function definitions with parameters and return types.

        it "defines function with explicit return type":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: defines function with explicit return type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn add(a: i32, b: i32) -> i32:
                return a + b
            expect add(2, 3) == 5

        it "uses implicit return of last expression":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: uses implicit return of last expression")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn multiply(a: i32, b: i32) -> i32:
                a * b
            expect multiply(3, 4) == 12

        it "calls function with no parameters":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: calls function with no parameters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn get_greeting() -> text:
                "Hello, World!"
            expect get_greeting() == "Hello, World!"

    context "function parameters":
        # ### Scenario: Parameter Handling
        #
        # Tests various parameter styles and type inference.

        it "passes multiple parameters":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: passes multiple parameters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn combine(x: i32, y: i32, z: i32) -> i32:
                x + y + z
            expect combine(1, 2, 3) == 6

        it "uses type inference for parameters":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: uses type inference for parameters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn double(x):
                x * 2
            expect double(5) == 10

        it "uses named arguments":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: uses named arguments")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn create_point(x: i32, y: i32) -> text:
                "{x}, {y}"
            expect create_point(x: 3, y: 4) == "3, 4"

    context "function return types":
        # ### Scenario: Return Behavior
        #
        # Tests function return types and implicit returns.

        it "returns single value":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: returns single value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn square(x: i32) -> i32:
                x * x
            expect square(5) == 25

        it "returns early with explicit return":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: returns early with explicit return")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn get_sign(x: i32) -> text:
                if x < 0:
                    return "negative"
                "positive"
            expect get_sign(-5) == "negative"

        it "returns without explicit type annotation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: returns without explicit type annotation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn concat(a: text, b: text):
                a + b
            expect concat("hello", "world") == "helloworld"

    context "function with no return":
        # ### Scenario: Void Functions
        #
        # Tests functions that perform actions without returning values.

        it "executes function with side effects":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: executes function with side effects")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var counter = 0
            counter = counter + 1
            expect counter == 1

        it "calls function multiple times":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: calls function multiple times")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn set_value(x: i32) -> i32:
                x
            val result = set_value(42)
            expect result == 42

    context "higher-order functions":
        # ### Scenario: Functions as Arguments
        #
        # Tests passing functions as parameters and returning functions.

        it "accepts function parameter":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: accepts function parameter")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn apply(f: fn(i32) -> i32, x: i32) -> i32:
                f(x)
            fn double(n: i32) -> i32:
                n * 2
            expect apply(double, 5) == 10

        it "uses lambda function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: uses lambda function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn apply(f: fn(i32) -> i32, x: i32) -> i32:
                f(x)
            expect apply(\n: n + 10, 5) == 15

        it "returns function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: returns function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn make_adder(x: i32) -> fn(i32) -> i32:
                \y: x + y
            val add_five = make_adder(5)
            expect add_five(3) == 8

    context "generic functions":
        # ### Scenario: Parametric Functions
        #
        # Tests generic functions with type parameters.

        it "defines generic function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: defines generic function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn identity<T>(x: T) -> T:
                x
            expect identity(42) == 42

        it "uses generic with constraints":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: uses generic with constraints")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn get_first<T>(items: List<T>) -> Option<T>:
                items.first
            val result = get_first([1, 2, 3])
            expect result == 1

        it "uses multiple type parameters":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: uses multiple type parameters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn pair<A, B>(a: A, b: B) -> text:
                "pair"
            expect pair(1, "hello") == "pair"

    context "recursive functions":
        # ### Scenario: Recursion
        #
        # Tests recursive function definitions and termination.

        it "defines recursive factorial function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: defines recursive factorial function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn factorial(n: i32) -> i32:
                if n <= 1:
                    1
                else:
                    n * factorial(n - 1)
            expect factorial(5) == 120

        it "uses tail recursion":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-019
            step("Verify: uses tail recursion")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn sum_to(n: i32) -> i32:
                if n <= 0:
                    0
                else:
                    n + sum_to(n - 1)
            expect sum_to(10) == 55
