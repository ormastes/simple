"""
## Purpose and audience

# Fixed-Size Array Types

**Feature ID:** #LANG-008
**Category:** Language
**Status:** Active

## Overview

Fixed-size arrays use the `[T; N]` syntax to declare arrays whose length is known at
declaration time and enforced at runtime. Unlike dynamic arrays, fixed-size arrays carry
their size as part of the type annotation, enabling stronger guarantees about buffer
lengths. This spec validates creation, indexing (including negative indices), read
operations like `first()`/`last()`/`contains()`, iteration with `for`, and functional
methods (`map`, `filter`, `reduce`) that return dynamic arrays.

## Syntax

```simple
val vec3: [f64; 3] = [1.0, 2.0, 3.0]
val arr: [i64; 5] = [1, 2, 3, 4, 5]
expect arr[-1] == 5
val doubled = vec3.map(_1 * 2)
val sum = arr.reduce(0, \acc, x: acc + x)
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| `[T; N]` Syntax | Declares a fixed-size array of type T with exactly N elements |
| Runtime Size Check | Array size is validated at creation to match the declared N |
| Negative Indexing | `arr[-1]` accesses the last element, `arr[-2]` the second-to-last |
| Functional Methods | `map`, `filter`, `reduce` work on fixed arrays but return dynamic arrays |

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/fixed_size_arrays_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Fixed-Size Arrays":

    context "Basic Syntax":
        it "creates fixed-size array with type annotation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: creates fixed-size array with type annotation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val vec3: [f64; 3] = [1.0, 2.0, 3.0]
            expect vec3.len() == 3

        it "creates fixed-size int array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: creates fixed-size int array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr: [i64; 5] = [1, 2, 3, 4, 5]
            expect arr.len() == 5

        it "creates single element fixed-size array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: creates single element fixed-size array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr: [i64; 1] = [42]
            expect arr[0] == 42
            expect arr.len() == 1

    context "Indexing":
        it "allows indexing read":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: allows indexing read")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val vec3: [f64; 3] = [1.0, 2.0, 3.0]
            expect vec3[0] == 1.0
            expect vec3[1] == 2.0
            expect vec3[2] == 3.0

        it "allows negative indexing":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: allows negative indexing")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr: [i64; 3] = [10, 20, 30]
            expect arr[-1] == 30
            expect arr[-2] == 20
            expect arr[-3] == 10

    context "Read Operations":
        it "allows len":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: allows len")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val vec3: [f64; 3] = [1.0, 2.0, 3.0]
            expect vec3.len() == 3

        it "allows first and last":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: allows first and last")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr: [i64; 4] = [10, 20, 30, 40]
            expect arr.first() == 10
            expect arr.last() == 40

        it "allows contains":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: allows contains")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr: [i64; 3] = [1, 2, 3]
            expect arr.contains(2)
            expect not arr.contains(5)

        it "allows iteration":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: allows iteration")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val vec3: [i64; 3] = [1, 2, 3]
            var sum = 0
            for x in vec3:
                sum = sum + x
            expect sum == 6

    context "Functional Operations":
        it "allows map (returns dynamic array)":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: allows map (returns dynamic array)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val vec3: [i64; 3] = [1, 2, 3]
            val doubled = vec3.map(_ * 2)
            expect doubled[0] == 2
            expect doubled[1] == 4
            expect doubled[2] == 6

        it "allows filter (returns dynamic array)":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: allows filter (returns dynamic array)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr: [i64; 5] = [1, 2, 3, 4, 5]
            val evens = arr.filter(_ % 2 == 0)
            expect evens[0] == 2
            expect evens.len() == 2

        it "allows reduce":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: allows reduce")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr: [i64; 4] = [1, 2, 3, 4]
            val sum = arr.reduce(0, \acc, x: acc + x)
            expect sum == 10

    context "Display Format":
        it "displays with size annotation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: displays with size annotation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val vec3: [i64; 3] = [1, 2, 3]
            # FixedSizeArray displays as [items; size]
            expect vec3.len() == 3
