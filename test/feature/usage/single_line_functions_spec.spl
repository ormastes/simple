"""
## Purpose and audience

# Single-Line Function Definitions Specification

**Feature IDs:** #SYNTAX-INLINE
**Category:** Syntax
**Status:** Implemented

Single-line (inline) function definitions allow functions to be defined with
an implicit return expression on the same line as the function signature.
The syntax replaces the indented block with an expression that is automatically
returned.

## Syntax

```simple
fn name(): implicit_return_expr
fn name(param: Type) -> ReturnType: expr
```

## Key Behaviors

- Single-line functions have an implicit return expression (no explicit `return` needed)
- The expression is evaluated and returned automatically
- Explicit return types are optional but supported
- Works with zero, one, or multiple parameters
- Compatible with class methods and static functions
- Traditional block syntax is still supported and can be mixed in the same file

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/single_line_functions_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Single-Line Function Definitions":
    # Verifies that inline expression body syntax works correctly for function
    # definitions. Tests cover basic single-line syntax, return types,
    # method definitions, and interaction with traditional block syntax.

    context "basic syntax":
        it "parses inline expression body":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: parses inline expression body")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn double(x): x * 2
            expect double(5) == 10

        it "parses with multiple parameters":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: parses with multiple parameters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn add(a, b): a + b
            expect add(3, 4) == 7

        it "parses with no parameters":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: parses with no parameters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn get_answer(): 42
            expect get_answer() == 42

        it "handles complex expressions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: handles complex expressions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn complex(x): (x * 2) + (x / 2)
            expect complex(10) == 25

        it "returns immediately without explicit return":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: returns immediately without explicit return")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn square(x): x * x
            expect square(4) == 16

    context "with explicit return types":
        it "supports explicit return type annotation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: supports explicit return type annotation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn typed_double(x: i64) -> i64: x * 2
            expect typed_double(5) == 10

        it "works with function parameter types":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: works with function parameter types")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn typed_add(a: i64, b: i64) -> i64: a + b
            expect typed_add(10, 20) == 30

        it "infers return type from expression":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: infers return type from expression")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn inferred(x): x + 1
            expect inferred(41) == 42

    context "with method definitions":
        it "works with class methods":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: works with class methods")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            class Counter:
                count: i64

                fn get_count(): self.count

            val c = Counter(count: 42)
            expect c.get_count() == 42

        it "works with mutable methods":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: works with mutable methods")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            class Accumulator:
                total: i64

                me add(value: i64):
                    self.total = self.total + value

            val acc = Accumulator(total: 0)
            acc.add(5)
            acc.add(10)
            expect acc.total == 15

        it "works with static functions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: works with static functions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            class MathHelper:
                static fn pi_approximation(): 3.14159

            expect MathHelper.pi_approximation() == 3.14159

    context "with collection operations":
        it "works with lambda-like expressions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: works with lambda-like expressions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn twice_each(items: List<i64>): items.map(_ * 2)
            expect twice_each([1, 2, 3]) == [2, 4, 6]

        it "handles filtering in single line":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: handles filtering in single line")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn evens_only(items: List<i64>): items.filter(_ % 2 == 0)
            expect evens_only([1, 2, 3, 4, 5]) == [2, 4]

    context "mixing with block syntax":
        it "can coexist with traditional block functions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: can coexist with traditional block functions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn inline(x): x * 2
            fn block(x):
                val doubled = inline(x)
                doubled + 1
            expect block(5) == 11

        it "block functions still work normally":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: block functions still work normally")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn block_complex(x):
                val y = x * 2
                y + 1
            expect block_complex(5) == 11

        it "allows either style in same module":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: allows either style in same module")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn style1(x): x + 1
            fn style2(x):
                x + 2
            expect style1(10) == 11
            expect style2(10) == 12

    context "edge cases":
        it "works with nested function calls":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: works with nested function calls")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn inner(x): x + 1
            fn outer(x):
                inner(x * 2)
            expect outer(5) == 11

        it "handles string expressions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: handles string expressions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn greeting(name): "Hello, {name}!"
            expect greeting("World") == "Hello, World!"

        it "works with conditional expressions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-019
            step("Verify: works with conditional expressions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn max_of_two(a, b): if a > b: a else: b
            expect max_of_two(10, 5) == 10
            expect max_of_two(3, 8) == 8
