"""
## Purpose and audience

# TreeSitter Advanced Outline Parsing Specification

**Feature IDs:** #TS-QUERY-001 to #TS-QUERY-020
**Category:** Infrastructure | Parser
**Status:** Implemented

Tests advanced outline features: type parameters, traits, impls,
type aliases, and constants.

## API

```simple
use compiler.treesitter.*

var ts = TreeSitter.new(source)
val outline = ts.parse_outline()
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/treesitter_query_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use compiler.treesitter.*
use std.spec.{step}


# ============================================================================
# Test Group 1: Type Parameters
# ============================================================================

describe "OutlineModule Type Parameters", tag: ["only-compiled"]:
    # skip: TreeSitter API not available in interpreter mode
    # Tests parsing generic type parameters on declarations.

    it "parses struct with type parameter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: parses struct with type parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "struct Box<T>:\n    value: T"
        var ts = TreeSitter.new(source)
        val outline = ts.parse_outline()
        expect outline.structs.len() to_equal 1
        val s = outline.structs[0]
        expect s.name to_equal "Box"
        expect s.type_params.len() to_equal 1

    it "parses class with multiple type parameters":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: parses class with multiple type parameters")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "class Pair<A, B>:\n    first: A\n    second: B"
        var ts = TreeSitter.new(source)
        val outline = ts.parse_outline()
        expect outline.classes.len() to_equal 1
        val c = outline.classes[0]
        expect c.name to_equal "Pair"
        expect c.type_params.len() to_equal 2


# ============================================================================
# Test Group 2: Trait Outline
# ============================================================================

describe "OutlineModule Trait Parsing", tag: ["only-compiled"]:
    # skip: TreeSitter API not available in interpreter mode
    # Tests parsing trait declarations.

    it "parses trait with methods":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: parses trait with methods")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "trait Drawable:\n    fn draw():\n        pass\n    fn area() -> f64:\n        0.0"
        var ts = TreeSitter.new(source)
        val outline = ts.parse_outline()
        expect outline.traits.len() to_equal 1
        val t = outline.traits[0]
        expect t.name to_equal "Drawable"

    it "parses empty trait":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: parses empty trait")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "trait Marker:\n    pass"
        var ts = TreeSitter.new(source)
        val outline = ts.parse_outline()
        expect outline.traits.len() to_equal 1
        val t = outline.traits[0]
        expect t.name to_equal "Marker"


# ============================================================================
# Test Group 3: Impl Outline
# ============================================================================

describe "OutlineModule Impl Parsing", tag: ["only-compiled"]:
    # skip: TreeSitter API not available in interpreter mode
    # Tests parsing impl blocks.

    it "parses impl with methods":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: parses impl with methods")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "impl Point:\n    fn get_x() -> i64:\n        self.x\n    fn get_y() -> i64:\n        self.y"
        var ts = TreeSitter.new(source)
        val outline = ts.parse_outline()
        expect outline.impls.len() to_equal 1

    it "parses impl with static method":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: parses impl with static method")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "impl Point:\n    static fn origin() -> Point:\n        Point(x: 0, y: 0)"
        var ts = TreeSitter.new(source)
        val outline = ts.parse_outline()
        expect outline.impls.len() to_equal 1


# ============================================================================
# Test Group 4: Type Alias Outline
# ============================================================================

describe "OutlineModule Type Alias Parsing", tag: ["only-compiled"]:
    # skip: TreeSitter API not available in interpreter mode
    # Tests parsing type alias declarations.

    it "parses type alias":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: parses type alias")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "type Point2D = Point"
        var ts = TreeSitter.new(source)
        val outline = ts.parse_outline()
        expect outline.type_aliases.len() to_equal 1
        val ta = outline.type_aliases[0]
        expect ta.name to_equal "Point2D"


# ============================================================================
# Test Group 5: Const Outline
# ============================================================================

describe "OutlineModule Const Parsing", tag: ["only-compiled"]:
    # skip: TreeSitter API not available in interpreter mode
    # Tests parsing val/var at module level.

    it "parses val declaration":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: parses val declaration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "val PI = 3.14"
        var ts = TreeSitter.new(source)
        val outline = ts.parse_outline()
        expect outline.constants.len() to_equal 1
        val c = outline.constants[0]
        expect c.name to_equal "PI"
        expect c.is_mutable to_equal false

    it "parses var declaration":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: parses var declaration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "var counter = 0"
        var ts = TreeSitter.new(source)
        val outline = ts.parse_outline()
        expect outline.constants.len() to_equal 1
        val c = outline.constants[0]
        expect c.name to_equal "counter"
        expect c.is_mutable to_equal true


# ============================================================================
# Test Group 6: Multiple Advanced Declarations
# ============================================================================

describe "OutlineModule Mixed Advanced Declarations", tag: ["only-compiled"]:
    # skip: TreeSitter API not available in interpreter mode
    # Tests parsing multiple advanced declaration types together.

    it "parses traits and impls together":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: parses traits and impls together")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "trait Shape:\n    fn area() -> f64:\n        0.0\n\nimpl Circle:\n    fn area() -> f64:\n        3.14"
        var ts = TreeSitter.new(source)
        val outline = ts.parse_outline()
        expect outline.traits.len() to_equal 1
        expect outline.impls.len() to_equal 1
