"""
## Purpose and audience

# Default Parameter Values

**Feature ID:** #PARSER-001
**Category:** Syntax
**Status:** Active

## Overview

Tests the `default` keyword for function parameter default values using `=`
syntax. Covers basic defaults, typed parameters, methods (instance and static),
collection defaults, edge cases (booleans, negatives, expressions), and
combinations of required and default parameters across functions, classes,
and nested scopes.

## Syntax

```simple
fn greet(name = "World"):
return "Hello, {name}"
fn typed_default(count: i32 = 0):
return count
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/parser_default_keyword_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Default keyword in function parameters":
    it "parses default parameter value with = syntax":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: parses default parameter value with = syntax")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn greet(name = "World"):
            return "Hello, {name}"
        expect greet() == "Hello, World"
        expect greet("Alice") == "Hello, Alice"

    it "parses multiple default parameters":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: parses multiple default parameters")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn create_range(min = 0, max = 100):
            return [min, max]
        val range = create_range()
        expect range[0] == 0
        expect range[1] == 100

    it "overrides single default parameter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: overrides single default parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn with_defaults(x = 1, y = 2):
            return x + y
        expect with_defaults() == 3
        expect with_defaults(5) == 7
        expect with_defaults(5, 10) == 15

    it "parses default with expressions":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: parses default with expressions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn with_expr_default(size = 2 ** 10):
            return size
        expect with_expr_default() == 1024

    it "parses default with arithmetic":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: parses default with arithmetic")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn compute(base = 100, offset = 10 + 5):
            return base + offset
        expect compute() == 115

    it "uses default in nested function":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: uses default in nested function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn outer():
            fn inner(value = 42):
                return value
            return inner()
        expect outer() == 42

describe "Default keyword with types":
    it "parses default parameter with type annotation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: parses default parameter with type annotation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn typed_default(count: i32 = 0):
            return count
        expect typed_default() == 0
        expect typed_default(5) == 5

    it "parses default text parameter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: parses default text parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn with_text(message: text = "default"):
            return message
        expect with_text() == "default"
        expect with_text("custom") == "custom"

    it "parses default float parameter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: parses default float parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn with_float(value: f64 = 3.14):
            return value
        expect with_float() > 3.0

describe "Default keyword in methods":
    it "parses default in class method":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: parses default in class method")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        class Counter:
            value: i32

            me increment(amount = 1):
                self.value = self.value + amount

        var c = Counter(value: 10)
        c.increment()
        expect c.value == 11

    it "parses default in static method":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: parses default in static method")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        class Factory:
            static fn create(size = 10) -> i32:
                return size

        expect Factory.create() == 10
        expect Factory.create(20) == 20

describe "Default keyword with collections":
    it "parses default empty array":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: parses default empty array")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn with_array(items = []):
            return items.len()
        expect with_array() == 0
        expect with_array([1, 2, 3]) == 3

    it "parses default array literal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: parses default array literal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn with_values(data = [1, 2, 3]):
            return data.len()
        expect with_values() == 3

describe "Default keyword edge cases":
    it "parses default with boolean":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: parses default with boolean")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn with_flag(enabled = true):
            return enabled
        expect with_flag() == true
        expect with_flag(false) == false

    it "parses default with negative number":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: parses default with negative number")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn with_negative(value = -10):
            return value
        expect with_negative() == -10

    it "parses default with string interpolation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: parses default with string interpolation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val default_name = "World"
        fn greet_default(name = default_name):
            return "Hello, {name}"
        expect greet_default() == "Hello, World"

describe "Default keyword combinations":
    it "parses mix of required and default parameters":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-017
        step("Verify: parses mix of required and default parameters")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn mixed(required, optional = 5):
            return required + optional
        expect mixed(10) == 15
        expect mixed(10, 20) == 30

    it "parses multiple functions with defaults":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-018
        step("Verify: parses multiple functions with defaults")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn first(x = 1):
            return x
        fn second(y = 2):
            return y
        expect first() == 1
        expect second() == 2

    # TODO: Lambda default parameters not yet supported
    # it "parses default in lambda", skip:
    #     val lambda_default = \x = 10: x * 2
    #     expect lambda_default() == 20
    #     expect lambda_default(5) == 10
