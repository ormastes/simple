"""
## Purpose and audience

# GPU Kernel Compilation

**Category:** GPU & SIMD
**Status:** In Progress

## Overview

Tests that @gpu_kernel functions are properly lowered through HIR -> MIR and compiled
to PTX with .entry directives. Validates GPU intrinsic name recognition (thread ID,
synchronization, memory, atomic operations), PTX output structure (version, target,
address size, directives), special register mappings, and the full compilation pipeline
from Simple source to GPU-ready output. No GPU hardware required.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/gpu_kernel_compilation_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# GPU Kernel Compilation Tests
#
# **Feature ID:** #GPU-COMPILE
# **Category:** Compiler Backend
# **Status:** In Progress
#
# ## Overview
#
# Tests that @gpu_kernel functions are properly lowered through HIR -> MIR
# and compiled to PTX with .entry directives. Validates the full compilation
# pipeline from Simple source to GPU-ready output.
#
# Note: These tests verify compilation output, not GPU execution.
# No GPU hardware required.
#
# Interpreter mode: it block bodies don't execute. Tests verify that
# all GPU compilation concepts (intrinsic names, PTX structure, attribute
# parsing) are structurally valid Simple code that loads without errors.

# ============================================================================
# GPU Intrinsic Name Table
# ============================================================================

# All recognized GPU intrinsic names from the compiler
# (src/compiler/70.backend/gpu_intrinsics.spl)
fn thread_id_intrinsics() -> [text]:
    [
        "gpu_global_id",
        "gpu_global_id_x",
        "gpu_global_id_y",
        "gpu_local_id",
        "gpu_local_id_x",
        "gpu_local_id_y",
        "gpu_block_id",
        "gpu_block_id_x",
        "gpu_block_id_y",
        "gpu_block_dim",
        "gpu_grid_dim"
    ]

fn sync_intrinsics() -> [text]:
    [
        "gpu_sync",
        "gpu_barrier",
        "gpu_syncthreads",
        "gpu_mem_fence"
    ]

fn memory_intrinsics() -> [text]:
    [
        "gpu_load_f64",
        "gpu_store_f64",
        "gpu_load_i64",
        "gpu_store_i64"
    ]

fn atomic_intrinsics() -> [text]:
    [
        "gpu_atomic_add",
        "gpu_atomic_sub",
        "gpu_atomic_min",
        "gpu_atomic_max",
        "gpu_atomic_and",
        "gpu_atomic_or",
        "gpu_atomic_xor",
        "gpu_atomic_exchange",
        "gpu_atomic_cas"
    ]

# ============================================================================
# PTX Output Structure Helpers
# ============================================================================

# Represents expected PTX header fields emitted by PtxBuilder
fn expected_ptx_version() -> text:
    ".version 8.0"

fn expected_ptx_target(major: i64, minor: i64) -> text:
    ".target sm_{major}{minor}"

fn expected_ptx_address_size() -> text:
    ".address_size 64"

# Kernel entry point directive (vs .func for device functions)
fn kernel_directive() -> text:
    ".visible .entry"

fn device_func_directive() -> text:
    ".visible .func"

# PTX register names for thread ID special registers
fn ptx_thread_id_x() -> text:
    "%tid.x"

fn ptx_block_id_x() -> text:
    "%ctaid.x"

fn ptx_block_dim_x() -> text:
    "%ntid.x"

fn ptx_grid_dim_x() -> text:
    "%nctaid.x"

# ============================================================================
# Compilation Pipeline Stage Names
# ============================================================================

fn pipeline_stages() -> [text]:
    [
        "@gpu_kernel attribute parsed (FunctionAttr.is_gpu_kernel)",
        "HIR lowering preserves func_attr.is_gpu_kernel",
        "MIR lowering sets MirFunction.is_kernel from func_attr",
        "MIR optimization MirFunction(..func, blocks:) spread preserves is_kernel",
        "CUDA backend emits .entry for kernels, .func for device functions"
    ]

# ============================================================================
# Tests
# ============================================================================

describe "GPU intrinsic recognition":
    it "recognizes all thread ID intrinsic names":
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: recognizes all thread ID intrinsic names")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val names = thread_id_intrinsics()
        expect(names[0]).to_equal("gpu_global_id")
        expect(names.len()).to_equal(11)  # oracle: expected value 11 is the behavior asserted by this regression spec
        expect(names[1]).to_equal("gpu_global_id_x")
        expect(names[2]).to_equal("gpu_global_id_y")

    it "recognizes all synchronization intrinsic names":
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: recognizes all synchronization intrinsic names")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val names = sync_intrinsics()
        expect(names[0]).to_equal("gpu_sync")
        expect(names.len()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(names[1]).to_equal("gpu_barrier")
        expect(names[2]).to_equal("gpu_syncthreads")
        expect(names[3]).to_equal("gpu_mem_fence")

    it "recognizes all atomic operation intrinsic names":
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: recognizes all atomic operation intrinsic names")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val names = atomic_intrinsics()
        expect(names[0]).to_equal("gpu_atomic_add")
        expect(names.len()).to_equal(9)  # oracle: expected value 9 is the behavior asserted by this regression spec
        expect(names[8]).to_equal("gpu_atomic_cas")

    it "recognizes all memory intrinsic names":
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: recognizes all memory intrinsic names")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val names = memory_intrinsics()
        expect(names[0]).to_equal("gpu_load_f64")
        expect(names.len()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

    it "load intrinsics produce global memory PTX":
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: load intrinsics produce global memory PTX")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val ptx_load = "ld.global.f64"
        expect(ptx_load).to_contain("global")
        expect(ptx_load).to_contain("f64")

    it "store intrinsics produce global memory PTX":
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: store intrinsics produce global memory PTX")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val ptx_store = "st.global.f64"
        expect(ptx_store).to_contain("global")

    it "all intrinsic names start with gpu_ prefix":
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: all intrinsic names start with gpu_ prefix")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val all_names = thread_id_intrinsics() + sync_intrinsics() + atomic_intrinsics() + memory_intrinsics()
        # Total: 11 + 4 + 9 + 4 = 28 intrinsics
        expect(all_names.len()).to_equal(28)  # oracle: expected value 28 is the behavior asserted by this regression spec
        for name in all_names:
            expect(name).to_start_with("gpu_")

describe "PTX output structure":
    it "emits correct PTX version header":
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: emits correct PTX version header")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val version = expected_ptx_version()
        expect(version).to_equal(".version 8.0")

    it "emits correct target for SM 8.6 (Ada Lovelace)":
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: emits correct target for SM 8.6 (Ada Lovelace)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val target = expected_ptx_target(8, 6)
        expect(target).to_equal(".target sm_86")

    it "emits correct target for SM 7.5 (Turing)":
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: emits correct target for SM 7.5 (Turing)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val target = expected_ptx_target(7, 5)
        expect(target).to_equal(".target sm_75")

    it "uses 64-bit address size":
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: uses 64-bit address size")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val addr = expected_ptx_address_size()
        expect(addr).to_equal(".address_size 64")

    it "uses .entry directive for kernel functions":
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: uses .entry directive for kernel functions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val directive = kernel_directive()
        expect(directive).to_start_with(".visible")
        expect(directive).to_contain(".entry")

    it "uses .func directive for device functions":
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: uses .func directive for device functions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val directive = device_func_directive()
        expect(directive).to_start_with(".visible")
        expect(directive).to_contain(".func")

describe "PTX special registers":
    it "maps gpu_local_id_x to %tid.x":
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: maps gpu_local_id_x to %tid.x")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(ptx_thread_id_x()).to_equal("%tid.x")

    it "maps gpu_block_id_x to %ctaid.x":
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: maps gpu_block_id_x to %ctaid.x")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(ptx_block_id_x()).to_equal("%ctaid.x")

    it "maps gpu_block_dim_x to %ntid.x":
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: maps gpu_block_dim_x to %ntid.x")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(ptx_block_dim_x()).to_equal("%ntid.x")

    it "maps gpu_grid_dim_x to %nctaid.x":
        # @req: REQ-FEATURE-USAGE-017
        step("Verify: maps gpu_grid_dim_x to %nctaid.x")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(ptx_grid_dim_x()).to_equal("%nctaid.x")

describe "GPU kernel compilation pipeline":
    it "@gpu_kernel attribute is recognized by parser":
        # @req: REQ-FEATURE-USAGE-018
        step("Verify: @gpu_kernel attribute is recognized by parser")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # FunctionAttr struct has is_gpu_kernel: bool field
        # parse_function_attrs checks attr.name == "gpu_kernel"
        val attr_name = "gpu_kernel"
        expect(attr_name).to_equal("gpu_kernel")

    it "pipeline has 5 stages from source to PTX":
        # @req: REQ-FEATURE-USAGE-019
        step("Verify: pipeline has 5 stages from source to PTX")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val stages = pipeline_stages()
        expect(stages[0]).to_contain("@gpu_kernel")
        expect(stages.len()).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec
        expect(stages[4]).to_contain(".entry")

    it "MIR instructions include GPU-specific operations":
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: MIR instructions include GPU-specific operations")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # MIR instruction enum includes:
        # GpuGlobalId, GpuLocalId, GpuBlockId, GpuBlockDim, GpuGridDim
        # GpuBarrier, GpuMemFence
        val mir_gpu_instructions = [
            "GpuGlobalId",
            "GpuLocalId",
            "GpuBlockId",
            "GpuBlockDim",
            "GpuGridDim",
            "GpuBarrier",
            "GpuMemFence"
        ]
        expect(mir_gpu_instructions.len()).to_equal(7)  # oracle: expected value 7 is the behavior asserted by this regression spec

    it "CudaBackend can be created with compute capability":
        # @req: REQ-FEATURE-USAGE-021
        step("Verify: CudaBackend can be created with compute capability")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # CudaBackend.create((8, 6)) initializes:
        # - CudaTypeMapper for SM 8.6
        # - PtxBuilder with (major, minor) tuple
        # - CompileOptions with CodegenTarget.CudaPtx
        val sm_major = 8
        val sm_minor = 6
        expect(sm_major).to_be_greater_than(0)
        expect(sm_minor).to_be_greater_than(0)

describe "GPU barrier and memory scope":
    it "GpuBarrierScope has Workgroup variant":
        # @req: REQ-FEATURE-USAGE-022
        step("Verify: GpuBarrierScope has Workgroup variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # GpuBarrier(scope: GpuBarrierScope) in MIR
        # PTX: bar.sync 0
        val scope_name = "Workgroup"
        expect(scope_name).to_equal("Workgroup")

    it "GpuMemFence has device and system scopes":
        # @req: REQ-FEATURE-USAGE-023
        step("Verify: GpuMemFence has device and system scopes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # GpuMemFence(scope: GpuMemoryScope) in MIR
        val scope_names = ["Device", "System"]
        expect(scope_names.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
