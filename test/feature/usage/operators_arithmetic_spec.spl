        it "multiplies by zero":
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: multiplies by zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 42 * 0
            expect(result).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "multiplies by one":
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: multiplies by one")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 42 * 1
            expect(result).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

        it "multiplies negative numbers":
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: multiplies negative numbers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = -3 * 4
            expect(result).to_equal(-12)  # oracle: expected value -12 is the behavior asserted by this regression spec

        it "multiplies two negatives":
            # @req: REQ-FEATURE-USAGE-019
            step("Verify: multiplies two negatives")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = -3 * -4
