# ============================================================================
# Operator Precedence
# ============================================================================

describe "Arithmetic Operators - Precedence":
    # ## Operator Precedence
    #
    # Operators are evaluated in precedence order:
    # 1. ** (exponentiation)
    # 2. *, /, % (multiplication, division, modulo)
    # 3. +, - (addition, subtraction)
    #
    # Note: Floor division is now a method (.fdiv), not an operator.
    # The // operator is now used for parallel execution.

    context "multiplication before addition":
        # ### Scenario: Multiplication Precedence
        #
        # Multiplication has higher precedence than addition.
        #
        # ```simple
        # 2 + 3 * 4  # 14, not 20
        # ```

        it "evaluates multiplication first":
            # @req: REQ-FEATURE-USAGE-047
            step("Verify: evaluates multiplication first")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 2 + 3 * 4
            expect(result).to_equal(14)  # oracle: expected value 14 is the behavior asserted by this regression spec

        it "uses parentheses to override":
            # @req: REQ-FEATURE-USAGE-048
            step("Verify: uses parentheses to override")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = (2 + 3) * 4
            expect(result).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec

    context "exponentiation before multiplication":
        # ### Scenario: Exponentiation Precedence
        #
        # Exponentiation has higher precedence than multiplication.
        #
        # ```simple
        # 2 * 3 ** 2  # 18, not 36
        # ```

        it "evaluates exponentiation first":
            # @req: REQ-FEATURE-USAGE-049
            step("Verify: evaluates exponentiation first")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 2 * 3 ** 2
            expect(result).to_equal(18)  # oracle: expected value 18 is the behavior asserted by this regression spec

        it "uses parentheses to override":
            # @req: REQ-FEATURE-USAGE-050
            step("Verify: uses parentheses to override")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = (2 * 3) ** 2
            expect(result).to_equal(36)  # oracle: expected value 36 is the behavior asserted by this regression spec

    context "complex expressions":
        # ### Scenario: Complex Precedence
        #
        # Multiple operators with different precedence.

        it "evaluates complex expression correctly":
            # @req: REQ-FEATURE-USAGE-051
            step("Verify: evaluates complex expression correctly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 2 + 3 * 4 - 5
            expect(result).to_equal(9)  # oracle: expected value 9 is the behavior asserted by this regression spec

        it "evaluates with division":
            # @req: REQ-FEATURE-USAGE-052
            step("Verify: evaluates with division")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 20 / 4 + 3 * 2
            expect(result).to_equal(11)  # oracle: expected value 11 is the behavior asserted by this regression spec


# ============================================================================
# Type Coercion
# ============================================================================

describe "Arithmetic Operators - Type Coercion":
    # ## Automatic Type Coercion
    #
    # When mixing Int and Float in arithmetic operations, Int is automatically
    # promoted to Float, and the result is Float.

    context "in complex expressions":
        # ### Scenario: Mixed Type Expressions
        #
        # Complex expressions with mixed Int and Float types.

        it "promotes in nested expressions":
            # @req: REQ-FEATURE-USAGE-053
            step("Verify: promotes in nested expressions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 10 + 5 * 2.0
            expect(result).to_equal(20.0)

        it "promotes across multiple operations":
            # @req: REQ-FEATURE-USAGE-054
            step("Verify: promotes across multiple operations")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 1 + 2 + 3.0
            expect(result).to_equal(6.0)


