# Edge Cases
# ============================================================================

describe "Arithmetic Operators - Edge Cases":
    # ## Edge Case Handling
    #
    # Tests for special cases and boundaries.

    context "with zero":
        # ### Scenario: Operations with Zero
        #
        # Zero has special properties in arithmetic.

        it "multiplies by zero":
            # @req: REQ-FEATURE-USAGE-055
            step("Verify: multiplies by zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 42 * 0
            expect(result).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "adds zero (identity)":
            # @req: REQ-FEATURE-USAGE-056
            step("Verify: adds zero (identity)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 42 + 0
            expect(result).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    context "with one":
        # ### Scenario: Operations with One
        #
        # One is the multiplicative identity.

        it "multiplies by one":
            # @req: REQ-FEATURE-USAGE-057
            step("Verify: multiplies by one")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 42 * 1
            expect(result).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

        it "divides by one":
            # @req: REQ-FEATURE-USAGE-058
            step("Verify: divides by one")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 42 / 1
            expect(result).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

        it "raises to power of zero":
            # @req: REQ-FEATURE-USAGE-059
            step("Verify: raises to power of zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 42 ** 0
            expect(result).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
