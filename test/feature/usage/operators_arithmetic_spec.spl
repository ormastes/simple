# ============================================================================
# Division Operator (/)
# ============================================================================

describe "Arithmetic Operators - Division":
    # ## Division Operator (/)
    #
    # The division operator performs numeric division on Int and Float types.
    # Division by zero produces an error.

    context "with integers":
        # ### Scenario: Integer Division
        #
        # Dividing two integers produces a numeric result.
        #
        # ```simple
        # val quotient = 20 / 4  # 5
        # ```

        it "divides evenly":
            # @req: REQ-FEATURE-USAGE-023
            step("Verify: divides evenly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 20 / 4
            expect(result).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

        it "divides with remainder":
            # @req: REQ-FEATURE-USAGE-024
            step("Verify: divides with remainder")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 17 / 5
            expect(result).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

        it "divides one by itself":
            # @req: REQ-FEATURE-USAGE-025
            step("Verify: divides one by itself")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 42 / 42
            expect(result).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    context "with floats":
        # ### Scenario: Float Division
        #
        # Dividing floats produces a float result.

        it "divides floats":
            # @req: REQ-FEATURE-USAGE-026
            step("Verify: divides floats")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 10.0 / 4.0
            expect(result).to_equal(2.5)

    context "with mixed types":
        # ### Scenario: Mixed Type Division
        #
        # Dividing Int and Float promotes Int to Float.

        it "promotes int to float (int / float)":
            # @req: REQ-FEATURE-USAGE-027
            step("Verify: promotes int to float (int / float)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 10 / 4.0
            expect(result).to_equal(2.5)

        it "promotes int to float (float / int)":
            # @req: REQ-FEATURE-USAGE-028
            step("Verify: promotes int to float (float / int)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 10.0 / 4
            expect(result).to_equal(2.5)


# ============================================================================
# Modulo Operator (%)
# ============================================================================

describe "Arithmetic Operators - Modulo":
    # ## Modulo Operator (%)
    #
    # The modulo operator computes the remainder of integer division.

    context "with positive integers":
        # ### Scenario: Positive Integer Modulo
        #
        # Modulo with positive integers returns the remainder.
        #
        # ```simple
        # val remainder = 17 % 5  # 2
        # ```

        it "computes remainder":
            # @req: REQ-FEATURE-USAGE-029
            step("Verify: computes remainder")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 17 % 5
            expect(result).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        it "returns zero for even division":
            # @req: REQ-FEATURE-USAGE-030
            step("Verify: returns zero for even division")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 20 % 4
            expect(result).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "returns operand when divisor is larger":
            # @req: REQ-FEATURE-USAGE-031
            step("Verify: returns operand when divisor is larger")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 3 % 5
            expect(result).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    context "with negative integers":
        # ### Scenario: Negative Integer Modulo
        #
        # Modulo with negative integers follows language semantics.

        it "handles negative dividend":
            # @req: REQ-FEATURE-USAGE-032
            step("Verify: handles negative dividend")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = -17 % 5
            expect(result).to_equal(-2)  # oracle: expected value -2 is the behavior asserted by this regression spec

        it "handles negative divisor":
            # @req: REQ-FEATURE-USAGE-033
            step("Verify: handles negative divisor")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 17 % -5
            expect(result).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec


# ============================================================================
# Exponentiation Operator (**)
# ============================================================================

describe "Arithmetic Operators - Exponentiation":
    # ## Exponentiation Operator (**)
    #
    # The exponentiation operator raises a number to a power.
    # Right-associative: 2 ** 3 ** 2 means 2 ** (3 ** 2).

    context "with integers":
        # ### Scenario: Integer Exponentiation
        #
        # Raising an integer to an integer power.
        #
        # ```simple
        # val squared = 5 ** 2  # 25
        # ```

        it "computes square":
            # @req: REQ-FEATURE-USAGE-034
            step("Verify: computes square")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 5 ** 2
            expect(result).to_equal(25)  # oracle: expected value 25 is the behavior asserted by this regression spec

        it "computes cube":
            # @req: REQ-FEATURE-USAGE-035
            step("Verify: computes cube")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 2 ** 3
            expect(result).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

        it "computes power of zero":
            # @req: REQ-FEATURE-USAGE-036
            step("Verify: computes power of zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 42 ** 0
            expect(result).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "computes power of one":
            # @req: REQ-FEATURE-USAGE-037
            step("Verify: computes power of one")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 42 ** 1
            expect(result).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    context "with floats":
        # ### Scenario: Float Exponentiation
        #
        # Raising floats to powers.

        it "computes float power":
            # @req: REQ-FEATURE-USAGE-038
            step("Verify: computes float power")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 2.0 ** 3.0
            expect(result).to_equal(8.0)

    context "with right associativity":
        # ### Scenario: Right Associativity
        #
        # Exponentiation is right-associative.
        #
        # ```simple
        # 2 ** 3 ** 2  # 2 ** (3 ** 2) = 2 ** 9 = 512
        # ```

        it "evaluates right to left":
            # @req: REQ-FEATURE-USAGE-039
            step("Verify: evaluates right to left")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 2 ** 3 ** 2
            expect(result).to_equal(512)  # oracle: expected value 512 is the behavior asserted by this regression spec


# ============================================================================
# Floor Division Operator (//)
