describe "Arithmetic Operators - Floor Division":
    # ## Floor Division Operator (//)
    #
    # Floor division divides and rounds toward negative infinity.
    # Uses Euclidean division semantics.

    context "with positive integers":
        # ### Scenario: Positive Floor Division
        #
        # Floor division with positive integers.
        #
        # ```simple
        # val result = 17 // 5  # 3
        # ```

        it "divides and floors":
            # @req: REQ-FEATURE-USAGE-040
            step("Verify: divides and floors")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 17.fdiv(5)
            expect(result).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

        it "returns exact result for even division":
            # @req: REQ-FEATURE-USAGE-041
            step("Verify: returns exact result for even division")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 20.fdiv(4)
            expect(result).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec


