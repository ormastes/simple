"""
## Purpose and audience

# Symbols and Atoms Specification

**Feature IDs:** #SYMBOLS-001
**Category:** Language | Types
**Status:** Implemented

## Overview

Symbols (also called atoms) are immutable, interned identifiers that are
compared by identity rather than value. They provide efficient comparison
operations and are commonly used for keys, tags, and enum-like values.

## Syntax

```simple
val status = :ok
val error = :not_found

if status is :ok:
handle_success()
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Symbol | Interned identifier compared by identity |
| Atom | Alternative name for symbol (Erlang terminology) |
| Interning | Process of storing unique string once |
| Symbol Table | Runtime storage for interned symbols |

## Behavior

- Symbols are prefixed with colon: `:name`
- Symbol comparison is O(1) pointer equality
- All occurrences of same symbol share memory
- Symbols are immutable and cannot be modified

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/symbols_atoms_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Symbol Creation
# ============================================================================

describe "Symbol Creation":
    # ## Creating Symbols
    #
    # Tests for symbol creation using colon prefix syntax.

    it "creates simple symbol":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: creates simple symbol")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val status = :ok
        var result = 0
        if status is :ok:
            result = 1
        expect result == 1

    it "creates symbol with underscore":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: creates symbol with underscore")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val err = :not_found
        var result = 0
        if err is :not_found:
            result = 1
        expect result == 1

    it "creates multiple distinct symbols":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: creates multiple distinct symbols")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = :hello
        val b = :world
        var result = 0
        if a is :hello:
            if b is :world:
                result = 1
        expect result == 1


# ============================================================================
# Test Group 2: Symbol Comparison
# ============================================================================

describe "Symbol Comparison":
    # ## Comparing Symbols
    #
    # Tests for symbol comparison by identity.

    it "compares equal symbols":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: compares equal symbols")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = :hello
        val b = :hello
        var result = 0
        if a is b:
            result = 10
        expect result == 10

    it "distinguishes different symbols":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: distinguishes different symbols")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = :hello
        val b = :world
        var result = 1
        if a is b:
            result = 0
        expect result == 1

    it "compares symbol in if-else":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: compares symbol in if-else")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val status = :ok
        val result = if status is :ok: 42 else: 0
        expect result == 42

    it "compares symbol with not equal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: compares symbol with not equal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = :hello
        val b = :world
        var result = 0
        if not (a is b):
            result = 1
        expect result == 1


# ============================================================================
# Test Group 3: Symbol Use Cases
# ============================================================================

describe "Symbol Use Cases":
    # ## Practical Symbol Usage
    #
    # Tests for common symbol usage patterns.

    it "uses symbol as return value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: uses symbol as return value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn get_status():
            return :success
        val result = get_status()
        var r = 0
        if result is :success:
            r = 1
        expect r == 1

    it "uses symbol as function parameter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: uses symbol as function parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn process(status):
            if status is :ok:
                return 42
            return 0
        expect process(:ok) == 42

    it "uses symbol in conditional logic":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: uses symbol in conditional logic")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val state = :running
        var code = 0
        if state is :stopped:
            code = 1
        else:
            if state is :running:
                code = 2
            else:
                code = 3
        expect code == 2

    it "chains symbol checks":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: chains symbol checks")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = :first
        val b = :second
        var result = 0
        if a is :first:
            if b is :second:
                result = 100
        expect result == 100
