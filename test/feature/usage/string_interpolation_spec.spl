"""
## Purpose and audience

# String Interpolation Specification

**Feature IDs:** #INTERP-001 to #INTERP-020
**Category:** Language | Syntax
**Status:** Implemented

## Overview

String interpolation allows embedding expressions directly in string literals
using curly braces. Simple treats interpolation as the default for regular
strings, with raw strings available when needed.

## Syntax

```simple
# Default interpolation (no special prefix needed)
val name = "Alice"
print "Hello, {name}!"          # Output: Hello, Alice!

# Expressions in braces
print "Result: {2 + 3}"         # Output: Result: 5

# Raw strings (no interpolation)
val regex = r"pattern: \d+"     # Backslashes not escaped, no interpolation
```

## Key Concepts

| Concept | Syntax | Escaping | Interpolation |
|---------|--------|----------|---------------|
| Default String | `"..."` | Standard | Yes |
| Raw String | `r"..."` | None | No |
| Expression | `{expr}` | Within braces | Yes |
| Escape Sequence | `\n, \t, \\` | Standard | Processed |

## Behavior

- Expressions in braces are evaluated at runtime
- Any expression can appear in braces, not just variables
- Raw strings skip interpolation and escape processing

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/string_interpolation_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Basic String Interpolation
# ============================================================================

describe "Basic String Interpolation":
    # ## Basic String Interpolation
    #
    # Tests simple variable interpolation in strings.

    it "interpolates variable in string":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: interpolates variable in string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = "Alice"
        val result = "Hello, {name}!"
        var r = 0
        if result == "Hello, Alice!":
            r = 1
        expect r == 1

    it "interpolates multiple variables":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: interpolates multiple variables")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val first = "John"
        val last = "Doe"
        val result = "{first} {last}"
        var r = 0
        if result == "John Doe":
            r = 1
        expect r == 1

    it "interpolates at start of string":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: interpolates at start of string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val value = 42
        val result = "{value} is the answer"
        var r = 0
        if result == "42 is the answer":
            r = 1
        expect r == 1

    it "interpolates at end of string":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: interpolates at end of string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val value = 42
        val result = "The answer is {value}"
        var r = 0
        if result == "The answer is 42":
            r = 1
        expect r == 1


# ============================================================================
# Test Group 2: Expression Interpolation
# ============================================================================

describe "Expression Interpolation":
    # ## Expression Interpolation
    #
    # Tests that arbitrary expressions can be interpolated.

    it "interpolates arithmetic expression":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: interpolates arithmetic expression")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 10
        val b = 20
        val result = "Sum: {a + b}"
        var r = 0
        if result == "Sum: 30":
            r = 1
        expect r == 1

    it "interpolates multiplication expression":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: interpolates multiplication expression")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 5
        val y = 3
        val result = "Product: {x * y}"
        var r = 0
        if result == "Product: 15":
            r = 1
        expect r == 1

    it "interpolates inline conditional expressions without treating colons as formatting":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: interpolates inline conditional expressions without treating colons as formatting")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val enabled = true
        val disabled = false
        val result = "values={if enabled: 1 else: 0}/{if disabled: 1 else: 0}"
        expect result == "values=1/0"

    it "interpolates boolean value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: interpolates boolean value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val b = true
        val result = "flag: {b}"
        var r = 0
        if result == "flag: true":
            r = 1
        expect r == 1

    it "interpolates false boolean value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: interpolates false boolean value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val b = false
        val result = "flag: {b}"
        var r = 0
        if result == "flag: false":
            r = 1
        expect r == 1


# ============================================================================
# Test Group 3: Raw Strings
# ============================================================================

describe "Raw Strings":
    # ## Raw Strings
    #
    # Tests raw strings with no interpolation.

    it "raw string preserves braces":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: raw string preserves braces")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val template = r"{name}"
        expect template.len() == 6

    it "raw string preserves backslashes":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: raw string preserves backslashes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val path = r"C:\Users\test"
        expect path.len() == 13


# ============================================================================
# Test Group 4: F-String Explicit Syntax
# ============================================================================

describe "F-String Syntax":
    # ## F-String Explicit Syntax
    #
    # Tests explicit f-string prefix (legacy compatibility).

    it "f-string basic interpolation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: f-string basic interpolation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 42
        val s = f"value is {x}"
        var r = 0
        if s == "value is 42":
            r = 1
        expect r == 1

    it "f-string with expression":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: f-string with expression")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 10
        val b = 20
        val s = f"sum is {a + b}"
        var r = 0
        if s == "sum is 30":
            r = 1
        expect r == 1

    it "f-string multiple interpolations":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: f-string multiple interpolations")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = "world"
        val count = 3
        val s = f"hello {name}, count={count}"
        var r = 0
        if s == "hello world, count=3":
            r = 1
        expect r == 1

    it "f-string no interpolation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: f-string no interpolation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val s = f"just a string"
        var r = 0
        if s == "just a string":
            r = 1
        expect r == 1
