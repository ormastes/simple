"""
## Purpose and audience

# Line Continuation Specification

**Feature IDs:** #2400
**Category:** Syntax
**Status:** Implemented

Line continuation allows long expressions and function calls to span multiple lines
using explicit backslash (`\`) at end of line. This enables clean formatting of
complex expressions without exceeding line length limits.

## Syntax

```simple
# Explicit continuation with backslash
val sum = value1 + \
value2 + \
value3

# Function call with continuation
val result = add(1, \
2, \
3)
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Explicit Continuation | Backslash at line end forces continuation to next line |
| Nesting | Multiple levels of continuation allowed |
| Indentation | Improves readability but not required for continuation |

## Behavior

Line continuation:
- Backslash at end of line continues expression to next line
- Multiple continuations can be chained
- Works in expressions and function calls
- Preserves semantic meaning across line boundaries

## Note

Implicit continuation (just newlines inside parentheses/brackets/braces) is not
currently supported. Use explicit backslash continuation instead.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/line_continuation_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Line Continuation":
    # ## Line Continuation Specification
    #
    # This test suite verifies explicit backslash line continuation behavior.

    context "explicit continuation with backslash":
        # ### Scenario: Backslash Line Continuation
        #
        # Tests explicit line continuation using backslash at end of line.

        it "continues expression with backslash":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: continues expression with backslash")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 1 + 2 + \
                3 + 4
            expect result == 10

        it "continues function call with backslash":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: continues function call with backslash")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn add(a, b, c):
                a + b + c
            val result = add(1, \
                2, \
                3)
            expect result == 6

        it "combines backslash and arithmetic":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: combines backslash and arithmetic")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val a = 10
            val b = 20
            val c = 30
            val result = a + \
                b + \
                c
            expect result == 60

        it "chains multiple continuations":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: chains multiple continuations")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 1 + \
                2 + \
                3 + \
                4 + \
                5
            expect result == 15

    context "continuation in various expressions":
        it "continues binary operation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: continues binary operation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 100 + \
                200
            expect x == 300

        it "continues comparison":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: continues comparison")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val a = 5
            val b = 10
            val result = a < \
                b
            var r = 0
            if result:
                r = 1
            expect r == 1

        it "continues string concatenation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: continues string concatenation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = "Hello" + \
                " " + \
                "World"
            var result = 0
            if s == "Hello World":
                result = 1
            expect result == 1

    context "continuation with indentation":
        it "works with any indentation level":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: works with any indentation level")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 10 + \
                        20 + \
                30
            expect result == 60

        it "continues deeply indented code":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: continues deeply indented code")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn outer():
                fn inner():
                    val x = 1 + \
                        2
                    return x
                return inner()
            expect outer() == 3

    context "practical examples":
        it "formats long arithmetic expression":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: formats long arithmetic expression")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val total = 100 + \
                200 + \
                300 + \
                400
            expect total == 1000

        it "formats function with many arguments":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: formats function with many arguments")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn sum5(a, b, c, d, e):
                a + b + c + d + e
            val result = sum5(1, \
                2, \
                3, \
                4, \
                5)
            expect result == 15
