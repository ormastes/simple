describe "Attribute Declaration Parsing":
    # ## Decorator Syntax
    #
    # Tests parsing of attributes/decorators on declarations.

    it "parses attribute on function":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-035
        step("Verify: parses attribute on function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @deprecated
        fn old_function() -> i64:
            42
        expect true

    it "parses attribute with args":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-036
