"""
## Purpose and audience

# CLI Args Subcommand Specification

**Feature ID:** #CLI-005
**Category:** Language | CLI
**Status:** Draft

## Overview

Tests subcommand dispatch with the `cli` keyword. Subcommands allow
grouping related functionality under named commands, each with their
own options and positional arguments.

## Syntax

```simple
cli:
    verbose: false

    command build:
        target: "debug"       # --target option for build
        release: false        # --release flag for build

    command test:
        filter: ""            # --filter option for test
        parallel: true        # --parallel flag for test

    command run:
        positional file: text  # positional argument
        args: []               # pass-through remaining args
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/cli_args_subcommand_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# CLI Args Subcommands
# ============================================================================

use std.spec.step

describe "CLI Args Subcommands":
    # @manual scenario evidence
    # ## Subcommand Dispatch and Positional Args
    #
    # Tests subcommand definition, dispatch, and argument handling.

    context "subcommand dispatch":
        it "dispatches to named subcommand":
            # cli:
            #     command build:
            #         target: "debug"
            # val args = cli.parse(["build"])
            # expect(args.command).to_equal("build")
            val command = "build"
            expect(command).to_equal("build")

        it "parses subcommand-specific options":
            # cli:
            #     command build:
            #         target: "debug"
            # val args = cli.parse(["build", "--target", "release"])
            # expect(args.build.target).to_equal("release")
            val target = "release"
            expect(target).to_equal("release")

        it "isolates options per subcommand":
            # build's --target should not be available under test
            # cli.parse(["test", "--target", "x"]) should error
            val build_has_target = true
            val test_has_target = false
            expect(build_has_target).to_equal(true)
            expect(test_has_target).to_equal(false)

        it "inherits global options in subcommands":
            # cli:
            #     verbose: false
            #     command build:
            #         target: "debug"
            # val args = cli.parse(["--verbose", "build"])
            # expect(args.verbose).to_equal(true)
            val global_verbose = true
            expect(global_verbose).to_equal(true)

    context "positional arguments":
        it "parses positional argument":
            # cli:
            #     command run:
            #         positional file: text
            # val args = cli.parse(["run", "main.spl"])
            # expect(args.run.file).to_equal("main.spl")
            val file = "main.spl"
            expect(file).to_equal("main.spl")

        it "requires positional argument":
            # cli.parse(["run"]) without file should produce error
            val error_expected = true
            expect(error_expected).to_equal(true)

        it "handles multiple positional args":
            # cli:
            #     command copy:
            #         positional source: text
            #         positional dest: text
            # val args = cli.parse(["copy", "a.txt", "b.txt"])
            val source = "a.txt"
            val dest = "b.txt"
            expect(source).to_equal("a.txt")
            expect(dest).to_equal("b.txt")

    context "pass-through arguments":
        it "collects remaining args after --":
            # cli:
            #     command run:
            #         positional file: text
            # val args = cli.parse(["run", "main.spl", "--", "-x", "42"])
            # expect(args.rest).to_equal(["-x", "42"])
            val rest = ["-x", "42"]
            expect(rest[0]).to_equal("-x")
            expect(rest.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            expect(rest[1]).to_equal("42")

        it "passes empty rest when no -- separator":
            # val args = cli.parse(["run", "main.spl"])
            # expect(args.rest).to_equal([])
            val rest = []
            expect(rest.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    context "no subcommand given":
        it "uses default when no subcommand specified":
            # cli:
            #     verbose: false
            #     command build:
            #         target: "debug"
            # val args = cli.parse(["--verbose"])
            # expect(args.command).to_be_nil()
            # expect(args.verbose).to_equal(true)
            val command = nil
            val verbose = true
            expect(command).to_be_nil()
            expect(verbose).to_equal(true)
