# ============================================================================
# Test Group 5: Dict Methods
# ============================================================================

describe "Dict Methods":
    # ## Dictionary Operations
    #
    # Tests dict length, keys, values, contains_key.

    it "dict length":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: dict length")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val d = {"a": 1, "b": 2, "c": 3}
        expect d.len() == 3

    it "dict keys":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: dict keys")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val d = {"x": 10, "y": 20}
        val keys = d.keys()
        expect keys.len() == 2

    it "dict values":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-017
        step("Verify: dict values")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val d = {"a": 5, "b": 10}
        val vals = d.values()
        expect vals[0] + vals[1] == 15

    it "dict contains_key":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-018
        step("Verify: dict contains_key")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val d = {"hello": 1}
        expect d.has("hello")


# ============================================================================
# Test Group 6: Bitwise Operators
# ============================================================================

describe "Bitwise Operators":
    # ## &, |, ^, <<, >>, ~
    #
    # Tests bitwise operations.

    it "bitwise AND":
        # @req: REQ-FEATURE-USAGE-019
        step("Verify: bitwise AND")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(12 & 10) == 8  # 1100 & 1010 = 1000

    it "bitwise OR":
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: bitwise OR")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(12 | 10) == 14  # 1100 | 1010 = 1110

    it "bitwise XOR":
        # @req: REQ-FEATURE-USAGE-021
        step("Verify: bitwise XOR")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(12 xor 10) == 6  # 1100 ^ 1010 = 0110

    it "left shift":
        # @req: REQ-FEATURE-USAGE-022
        step("Verify: left shift")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(1 << 4) == 16

    it "right shift":
        # @req: REQ-FEATURE-USAGE-023
        step("Verify: right shift")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(16 >> 2) == 4

    it "bitwise NOT":
        # @req: REQ-FEATURE-USAGE-024
        step("Verify: bitwise NOT")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(~0) == -1


