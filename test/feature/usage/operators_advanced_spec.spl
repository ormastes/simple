describe "Logical Operators":
    # ## and, or, not
    #
    # Tests logical operations.

    it "and operator":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-031
        step("Verify: and operator")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect true and true
        expect not (true and false)

    it "or operator":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-032
        step("Verify: or operator")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect true or false
        expect not (false or false)

    it "not operator":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-033
        step("Verify: not operator")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect not false
        expect not (not true)


# ============================================================================
# Test Group 9: Power Operator
# ============================================================================

describe "Power Operator":
    # ## ** Exponentiation
    #
    # Tests power operator.

    it "power of zero":
        # @req: REQ-FEATURE-USAGE-034
        step("Verify: power of zero")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(2 ** 0) == 1

    it "power of one":
        # @req: REQ-FEATURE-USAGE-035
        step("Verify: power of one")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(2 ** 1) == 2

    it "power of three":
        # @req: REQ-FEATURE-USAGE-036
        step("Verify: power of three")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(2 ** 3) == 8

    it "power of ten":
        # @req: REQ-FEATURE-USAGE-037
        step("Verify: power of ten")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(2 ** 10) == 1024

    it "three to fourth":
        # @req: REQ-FEATURE-USAGE-038
        step("Verify: three to fourth")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(3 ** 4) == 81


# ============================================================================
# Test Group 10: Floor Division
# ============================================================================

describe "Floor Division":
    # ## .fdiv() Method
    #
    # Tests floor division method (// operator is now for parallel execution).

    it "positive floor division":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-039
        step("Verify: positive floor division")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect 7.fdiv(2) == 3

    it "another floor division":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-040
        step("Verify: another floor division")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect 10.fdiv(3) == 3

    it "negative floor division":
        # @req: REQ-FEATURE-USAGE-041
        step("Verify: negative floor division")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect (-7).fdiv(2) == -4  # rounds toward negative infinity

    it "exact division":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-042
        step("Verify: exact division")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect 8.fdiv(4) == 2


# ============================================================================
# Test Group 11: In Operator
# ============================================================================

describe "In Operator":
    # ## x in collection
    #
    # Tests membership operator.

    it "in array present":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-043
        step("Verify: in array present")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect 2 in [1, 2, 3]

    it "in array absent":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-044
        step("Verify: in array absent")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect not (5 in [1, 2, 3])

    it "in string present":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-045
        step("Verify: in string present")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect "ell" in "hello"

    it "in string absent":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-046
        step("Verify: in string absent")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect not ("xyz" in "hello")


# ============================================================================
# Test Group 12: Recursive Functions
# ============================================================================

describe "Recursive Functions":
    # ## Function Recursion
    #
    # Tests recursive function calls.

    it "factorial":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-047
        step("Verify: factorial")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn factorial(n: i64) -> i64:
            if n <= 1:
                1
            else:
                n * factorial(n - 1)

        expect factorial(3) == 6


# ============================================================================
# Test Group 13: Nested Data Structures
# ============================================================================

describe "Nested Data Structures":
    # ## Nested Arrays and Structs
    #
    # Tests nested data access.

    it "nested arrays":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-048
        step("Verify: nested arrays")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [[1, 2], [3, 4], [5, 6]]
        expect arr[0][0] + arr[1][1] + arr[2][0] == 10

    it "nested structs":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-049
        step("Verify: nested structs")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        struct Inner:
            value: i64

        struct Outer:
            inner: Inner

        val o = Outer(inner: Inner(value: 42))
        expect o.inner.value == 42


