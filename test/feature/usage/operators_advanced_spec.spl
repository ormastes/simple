"""
## Purpose and audience

# Advanced Operators Specification


**Feature IDs:** #OP-ADV-001 to #OP-ADV-030
**Category:** Language | Operators
**Status:** Implemented

Tests advanced operators and language features including:
- Mutability control (let, let mut, var, const, static)
- Lambda expressions
- String operations
- Array and dict methods
- Bitwise operators
- Comparison and logical operators
- Power and floor division
- In operator
- Symbols

## Syntax

```simple
# Mutability
let x = 10       # immutable
let mut y = 10   # mutable with let mut
var z = 10       # mutable with var
const MAX = 100  # constant
static counter = 0  # static variable

# Operators
val a = 12 & 10    # bitwise AND
val b = 2 ** 10    # power
val c = 7.fdiv(2)  # floor division (// is now parallel operator)
val d = "ell" in "hello"  # in operator
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/operators_advanced_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Mutability Control
# ============================================================================

describe "Mutability Control":
    # ## let, let mut, var, const, static
    #
    # Tests variable mutability declarations.

    it "let is immutable":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: let is immutable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 10
        # x = 20  # Would be error
        expect x == 10

    it "var is mutable":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: var is mutable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var y = 10
        y = 30
        expect y == 30

    it "var in loop":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: var in loop")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var sum = 0
        var i = 0
        while i < 5:
            sum = sum + i
            i = i + 1
        expect sum == 10  # 0+1+2+3+4

    it "const declaration":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: const declaration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        const MAX = 100
        expect MAX == 100

    it "const with arithmetic":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: const with arithmetic")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        const BASE = 10
        const MULTIPLIER = 5
        expect BASE * MULTIPLIER == 50

    it "const with type annotation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: const with type annotation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        const SIZE: i64 = 256
        expect SIZE == 256

    it "static variable":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: static variable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        static counter = 42
        expect counter == 42


# ============================================================================
# Test Group 2: Lambda Expressions
# ============================================================================

describe "Lambda Expressions":
    # ## Lambda Syntax
    #
    # Tests lambda creation and usage.

    it "basic lambda":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: basic lambda")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val double = \x: x * 2
        expect double(21) == 42

    it "lambda with multiple params":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: lambda with multiple params")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val add = \a, b: a + b
        expect add(10, 32) == 42

    it "lambda as higher-order":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: lambda as higher-order")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn apply(f, x):
            f(x)

        val inc = \n: n + 1
        expect apply(inc, 41) == 42


# ============================================================================
# Test Group 3: String Operations
# ============================================================================

describe "String Operations":
    # ## String Methods
    #
    # Tests string length, concatenation, interpolation.

    it "string length":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: string length")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val s = "hello"
        expect s.len() == 5

    it "string concatenation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: string concatenation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = "hello"
        val b = "world"
        val c = a + " " + b
        expect c.len() == 11

    it "string interpolation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: string interpolation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 42
        val s = "value is {x}"
        expect s.len() == 11


