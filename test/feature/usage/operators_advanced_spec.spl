describe "Early Return":
    # ## Multiple Return Paths
    #
    # Tests functions with multiple returns.

    it "early return based on condition":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-050
        step("Verify: early return based on condition")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn verify(x: i64) -> i64:
            if x > 10:
                return 1
            if x > 5:
                return 2
            3

        expect verify(7) == 2


