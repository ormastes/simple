    # Tests comparison operations.

    it "less than":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-025
        step("Verify: less than")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect 1 < 2

    it "greater than":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-026
        step("Verify: greater than")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect 2 > 1

    it "less than or equal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-027
        step("Verify: less than or equal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect 2 <= 2

    it "greater than or equal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-028
        step("Verify: greater than or equal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect 2 >= 2

    it "equal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-029
        step("Verify: equal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect 2 == 2

    it "not equal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-030
        step("Verify: not equal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect 2 != 3


