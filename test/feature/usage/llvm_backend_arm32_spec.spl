"""
## Purpose and audience

# LLVM Backend ARM 32-bit Specification


**Feature IDs:** #4004
**Category:** Infrastructure
**Difficulty:** 3/5
**Status:** In Progress

Validates that the LLVM backend correctly generates code for ARM 32-bit (ARMv7) targets.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/llvm_backend_arm32_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use compiler.backend.llvm_ir_builder.{LlvmIRBuilder, LlvmIRBuilder__create, MirToLlvm, MirToLlvm__create}
use compiler.backend.llvm_target.{LlvmTargetTriple, LlvmTargetTriple__from_target, LlvmTargetConfig, LlvmTargetConfig__for_target}
use compiler.backend.llvm_type_mapper.{LlvmTypeMapper, LlvmTypeMapper__create_for_target}
use compiler.backend.entry_point.halt_instruction_for_target
use compiler.backend.backend_types.{CodegenTarget, OptimizationLevel}
use std.common.test_env_gate.{test_env_llvm_available, test_env_gate_skip}
use std.spec.{step}

describe "LLVM Backend ARM32":
    if not test_env_llvm_available():
        it "env_skip: LLVM not available":
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: env_skip: LLVM not available")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val reason = test_env_gate_skip("SIMPLE_LLVM_TEST")
            expect(reason).to_contain("Skipped")
        return

    context "target triple":
        it "generates correct armv7 triple":
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: generates correct armv7 triple")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val triple = LlvmTargetTriple__from_target(CodegenTarget.Arm)
            expect(triple.arch).to_equal("armv7")
            expect(triple.to_text()).to_contain("armv7")

        it "includes gnueabihf env on linux":
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: includes gnueabihf env on linux")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val triple = LlvmTargetTriple__from_target(CodegenTarget.Arm)
            val text = triple.to_text()
            expect(text).to_contain("armv7")

    context "datalayout":
        it "contains correct arm32 layout":
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: contains correct arm32 layout")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val triple = LlvmTargetTriple__from_target(CodegenTarget.Arm)
            val dl = triple.datalayout()
            expect(dl).to_contain("p:32:32")

    context "CPU defaults":
        it "defaults to cortex-a7":
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: defaults to cortex-a7")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = LlvmTargetConfig__for_target(CodegenTarget.Arm, nil)
            expect(config.cpu).to_equal("cortex-a7")

        it "includes neon feature":
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: includes neon feature")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = LlvmTargetConfig__for_target(CodegenTarget.Arm, nil)
            expect(config.features).to_contain("+neon")

        it "includes vfp4 feature":
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: includes vfp4 feature")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = LlvmTargetConfig__for_target(CodegenTarget.Arm, nil)
            expect(config.features).to_contain("+vfp4")

    context "native integer type", tag: ["only-compiled"]:
        it "native_int_type is i32":
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: native_int_type is i32")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var translator = MirToLlvm__create("test", CodegenTarget.Arm, nil)
            expect(translator.native_int()).to_equal("i32")

    context "type mapping", tag: ["only-compiled"]:
        it "uses 32-bit target_bits":
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: uses 32-bit target_bits")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mapper = LlvmTypeMapper__create_for_target(CodegenTarget.Arm)
            expect(mapper.target_bits).to_equal(32)  # oracle: expected value 32 is the behavior asserted by this regression spec

    context "bare-metal entry":
        it "uses wfi instruction for halt":
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: uses wfi instruction for halt")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val halt = halt_instruction_for_target(CodegenTarget.Arm)
            expect(halt).to_equal("wfi")

    context "builder size type":
        it "uses i32 size type":
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: uses i32 size type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val triple = LlvmTargetTriple__from_target(CodegenTarget.Arm)
            var builder = LlvmIRBuilder__create("test", triple)
            expect(builder.size_type).to_equal("i32")
