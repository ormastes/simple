"""
## Purpose and audience

# Placeholder Lambda Expressions

**Feature ID:** #SYNTAX-009
**Category:** Syntax
**Status:** Active

## Overview

Placeholder lambdas let the programmer write concise anonymous functions by using
`_` as a stand-in for each successive parameter. The compiler desugars `_ * 2`
into `\__p0: __p0 * 2` and `_ + _` into `\__p0, __p1: __p0 + __p1`. This spec
covers the full surface area: comparison operators, arithmetic (including unary
negation), method access on the placeholder (`_.len()`), chaining of `filter` and
`map`, compound expressions like `_ * 2 + 1`, and quantifier methods (`any`,
`all`). Edge cases for empty and single-element collections are also tested.

## Syntax

```simple
# Filter with comparison placeholder
val evens = [1, 2, 3, 4, 5].filter(_ % 2 == 0)   # => [2, 4, 6]

# Map with arithmetic placeholder
val doubled = [1, 2, 3].map(_ * 10)                # => [10, 20, 30]

# Unary negation placeholder
val negated = [1, 2, 3].map(-_)                    # => [-1, -2, -3]

# Method call on placeholder
val long = ["hi", "hello", "hey"].filter(_.len() > 3)  # => ["hello"]

# Chained placeholders
val result = [1, 2, 3, 4, 5].filter(_ > 2).map(_ * 2)  # => [6, 8, 10]
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Placeholder `_` | Each `_` in an expression becomes a new auto-named lambda parameter |
| Desugaring | `_ op expr` is rewritten to `\__pN: __pN op expr` before evaluation |
| Method access | `_.method()` desugars to `\__p0: __p0.method()` for member calls |
| Chaining | Successive `.filter(_)` and `.map(_)` calls each introduce independent lambdas |

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/placeholder_lambda_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Placeholder Lambda":

    context "filter with comparison":
        it "filters with less than":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: filters with less than")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [1, 2, 3, 4, 5]
            val result = data.filter(_ < 3)
            expect result == [1, 2]

        it "filters with greater than":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: filters with greater than")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [1, 2, 3, 4, 5]
            val result = data.filter(_ > 3)
            expect result == [4, 5]

        it "filters with less than or equal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: filters with less than or equal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [1, 2, 3, 4, 5]
            val result = data.filter(_ <= 3)
            expect result == [1, 2, 3]

        it "filters with greater than or equal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: filters with greater than or equal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [1, 2, 3, 4, 5]
            val result = data.filter(_ >= 3)
            expect result == [3, 4, 5]

        it "filters with equality":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: filters with equality")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [1, 2, 3, 2, 1]
            val result = data.filter(_ == 2)
            expect result == [2, 2]

        it "filters with not equal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: filters with not equal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [1, 2, 3, 2, 1]
            val result = data.filter(_ != 2)
            expect result == [1, 3, 1]

    context "map with arithmetic":
        it "maps with multiply":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: maps with multiply")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [1, 2, 3]
            val result = data.map(_ * 10)
            expect result == [10, 20, 30]

        it "maps with add":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: maps with add")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [1, 2, 3]
            val result = data.map(_ + 100)
            expect result == [101, 102, 103]

        it "maps with subtract":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: maps with subtract")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [10, 20, 30]
            val result = data.map(_ - 5)
            expect result == [5, 15, 25]

        it "maps with negate":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: maps with negate")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [1, 2, 3]
            val result = data.map(-_)
            expect result == [-1, -2, -3]

    context "chaining":
        it "chains filter then map":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: chains filter then map")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [1, 2, 3, 4, 5]
            val result = data.filter(_ > 2).map(_ * 2)
            expect result == [6, 8, 10]

        it "chains map then filter":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: chains map then filter")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [1, 2, 3, 4, 5]
            val result = data.map(_ * 2).filter(_ > 5)
            expect result == [6, 8, 10]

    context "string operations":
        it "filters strings by length":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: filters strings by length")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val words = ["hi", "hello", "hey", "howdy"]
            val result = words.filter(_.len() > 3)
            expect result == ["hello", "howdy"]

    context "complex expressions":
        it "uses placeholder in modulo":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: uses placeholder in modulo")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [1, 2, 3, 4, 5, 6]
            val result = data.filter(_ % 2 == 0)
            expect result == [2, 4, 6]

        it "uses placeholder in compound expression":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: uses placeholder in compound expression")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [1, 2, 3, 4, 5]
            val result = data.map(_ * 2 + 1)
            expect result == [3, 5, 7, 9, 11]

    context "with different collection methods":
        it "works with any":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: works with any")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [1, 2, 3]
            val result = data.any(_ > 2)
            expect result == true

        it "works with all":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: works with all")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [2, 4, 6]
            val result = data.all(_ % 2 == 0)
            expect result == true

        it "works with all returning false":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: works with all returning false")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [2, 3, 6]
            val result = data.all(_ % 2 == 0)
            expect result == false

    context "empty collections":
        it "filter on empty returns empty":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-019
            step("Verify: filter on empty returns empty")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data: [i64] = []
            val result = data.filter(_ > 0)
            expect result == []

        it "map on empty returns empty":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-020
            step("Verify: map on empty returns empty")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data: [i64] = []
            val result = data.map(_ * 2)
            expect result == []

    context "single element":
        it "filter matching single element":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-021
            step("Verify: filter matching single element")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [42]
            val result = data.filter(_ == 42)
            expect result == [42]

        it "filter non-matching single element":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-022
            step("Verify: filter non-matching single element")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = [42]
            val result = data.filter(_ == 0)
            expect result == []

    context "string template placeholder scoping (bug wildcard_import_c_backend_stubs_function_to_int, 2026-07-30 bonus-find)":
        # A string-template interpolation region (`"{...}"`) is sub-parsed on
        # its own; a bare `_` inside it already refers to the value bound by
        # the enclosing .map() call (the current tuple element here). When a
        # nested plain function or method call appears in a later `{...}`
        # slot of the SAME template, its `_`-argument must still refer to
        # that same outer element -- not be hijacked into its own unapplied
        # `\__p0: ...` closure by the ordinary call-argument placeholder
        # shorthand (which is correct for a REAL higher-order callback like
        # `.any(_ > 3)`, but wrong here since `double_val`/`.apply` are plain
        # value-taking functions, not callbacks).
        it "keeps `_` bound to the outer tuple when a template slot calls a plain function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-023
            step("Verify: keeps `_` bound to the outer tuple when a template slot calls a plain function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pairs = [("count", 1), ("ready", 2)]
            val result = pairs.map("{_.0}: {double_val(_.1)}")
            expect result == ["count: 2", "ready: 4"]

        it "keeps `_` bound to the outer tuple when a template slot calls a method (type_mapper map_struct shape)":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-024
            step("Verify: keeps `_` bound to the outer tuple when a template slot calls a method (type_mapper map_struct shape)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pairs = [("count", 1), ("ready", 2)]
            val doubler = Doubler.create()
            val result = pairs.map("{_.0}: {doubler.apply(_.1)}")
            expect result == ["count: 2", "ready: 4"]

        it "registers `_1` from an interpolated ordinary call argument after module assembly":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-025
            step("Verify: registers `_1` from an interpolated ordinary call argument after module assembly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val values = [1, 2, 3]
            val result = values.map("{double_val(_1)}")
            expect result == ["2", "4", "6"]

        it "registers `_1` through an ordinary nested call argument after module assembly":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-026
            step("Verify: registers `_1` through an ordinary nested call argument after module assembly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val values = [1, 2, 3]
            val result = values.map(double_val(_1))
            expect result == [2, 4, 6]

        it "preserves match bindings after interpolation rewrite without transforming wildcard patterns":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-027
            step("Verify: preserves match bindings after interpolation rewrite without transforming wildcard patterns")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val rendered = [1].map("{double_val(_1)}")
            val result = Ok((rendered[0], "ignored"))
            val projected = match result:
                case Ok((selected, _)):
                    Ok(selected)
                case Err(_):
                    Ok("")
            val selected_value = match projected:
                case Ok(selected):
                    selected
                case Err(_):
                    ""
            expect selected_value == "2"

fn double_val(x: i64) -> i64:
    x * 2

class Doubler:
    static fn create() -> Doubler:
        Doubler()

    me apply(x: i64) -> i64:
        x * 2
