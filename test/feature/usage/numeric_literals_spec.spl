"""
## Purpose and audience

# Numeric Literals Specification

**Feature ID:** #NUM-001
**Category:** Language | Literals
**Status:** Implemented

## Overview

Tests for various numeric literal formats including hexadecimal, binary,
octal, and numeric separators with underscores.

## Syntax

```simple
val hex = 0xFF         # Hexadecimal (255)
val bin = 0b1010       # Binary (10)
val oct = 0o755        # Octal (493)
val sep = 1_000_000    # Underscores for readability
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/numeric_literals_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Hexadecimal Literals
# ============================================================================

describe "Hexadecimal Literals":
    # ## Hex Numeric Literals
    #
    # Tests for hexadecimal numeric literals using 0x prefix.

    it "parses basic hex literal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: parses basic hex literal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 0xFF
        expect x == 255

    it "parses lowercase hex":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: parses lowercase hex")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 0xff
        expect x == 255

    it "parses mixed case hex":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: parses mixed case hex")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 0xAb
        expect x == 171

    it "performs hex arithmetic":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: performs hex arithmetic")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 0x10 + 0x20
        expect x == 48  # 16 + 32

    it "compares hex and decimal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: compares hex and decimal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect 0x10 == 16
        expect 0x100 == 256


# ============================================================================
# Test Group 2: Binary Literals
# ============================================================================

describe "Binary Literals":
    # ## Binary Numeric Literals
    #
    # Tests for binary numeric literals using 0b prefix.

    it "parses basic binary literal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: parses basic binary literal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 0b1010
        expect x == 10

    it "parses binary with underscores":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: parses binary with underscores")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 0b1111_0000
        expect x == 240

    it "performs binary arithmetic":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: performs binary arithmetic")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 0b1000 + 0b0100
        expect x == 12  # 8 + 4

    it "uses binary for bit patterns":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: uses binary for bit patterns")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val flags = 0b0101
        expect flags == 5


# ============================================================================
# Test Group 3: Octal Literals
# ============================================================================

describe "Octal Literals":
    # ## Octal Numeric Literals
    #
    # Tests for octal numeric literals using 0o prefix.

    it "parses basic octal literal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: parses basic octal literal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 0o755
        expect x == 493  # 7*64 + 5*8 + 5

    it "parses small octal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: parses small octal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 0o10
        expect x == 8

    it "performs octal arithmetic":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: performs octal arithmetic")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 0o10 + 0o10
        expect x == 16  # 8 + 8


# ============================================================================
# Test Group 4: Numeric Separators
# ============================================================================

describe "Numeric Separators":
    # ## Underscore Separators
    #
    # Tests for using underscores as separators in numeric literals.

    it "parses decimal with separators":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: parses decimal with separators")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 1_000_000
        expect x == 1000000

    it "parses hex with separators":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: parses hex with separators")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 0xFF_FF
        expect x == 65535

    it "parses binary with separators":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: parses binary with separators")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 0b1010_1010
        expect x == 170

    it "allows multiple underscores":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: allows multiple underscores")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 100__000
        expect x == 100000

