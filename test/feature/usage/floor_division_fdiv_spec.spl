describe "Floor Division (i64.fdiv) - Division Algorithm":
    # Verifies the division algorithm: a = b * fdiv(a,b) + a % b

    it "satisfies division algorithm for positive numbers":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: satisfies division algorithm for positive numbers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 17
        val b = 5
        val q = a.fdiv(b)
        val r = a % b
        expect a == b * q + r
        expect q == 3
        expect r == 2

    it "satisfies division algorithm for negative dividend":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-021
        step("Verify: satisfies division algorithm for negative dividend")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = -17
        val b = 5
        val q = a.fdiv(b)
        val r = a - b * q
        expect a == b * q + r
        expect q == (-4)
        expect r == 3

    it "satisfies division algorithm for negative divisor":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-022
        step("Verify: satisfies division algorithm for negative divisor")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 17
        val b = -5
        val q = a.fdiv(b)
        val r = a - b * q
        expect a == b * q + r
        expect q == (-4)

    it "satisfies division algorithm for both negative":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-023
        step("Verify: satisfies division algorithm for both negative")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = -17
        val b = -5
        val q = a.fdiv(b)
        val r = a % b
        expect a == b * q + r
        expect q == 3

