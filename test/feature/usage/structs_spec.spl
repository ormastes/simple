"""
## Purpose and audience

# Structs Specification

**Feature IDs:** #TBD
**Category:** Language
**Difficulty:** 2/5
**Status:** Implemented

## Overview

Structs are user-defined data types that group related fields together.
They support named fields with type annotations, default values, and can
have methods defined via impl blocks. Structs are the primary way to
define custom data structures in Simple.

## Syntax

```simple
struct Point:
x: i64
y: i64

struct Config:
host: String = "localhost"
port: i64 = 8080

val p = Point { x: 3, y: 4 }
val c = Config { port: 9000 }  # host uses default
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Struct | User-defined data type with named fields |
| Field | Named member of a struct with type annotation |
| Default Value | Optional value used when field not provided |
| Construction | Creating struct instance with field values |

## Behavior

- Fields are accessed using dot notation: `point.x`
- Construction requires all fields without defaults
- Fields can have default values
- Structs are value types (copied by default)

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/structs_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Struct Basics
# ============================================================================

describe "Structs":
    # ## Core Struct Functionality
    #
    # Tests for struct definition, construction, field access, and default values.
    # Validates struct behavior as value types with named fields.

    context "struct definition and construction":
        # ### Scenario: Struct Creation
        #
        # Defines and constructs structs with typed fields.

        it "defines struct with fields":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: defines struct with fields")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            struct Point:
                x: i64
                y: i64

            val p = Point { x: 10, y: 20 }
            expect p.x + p.y == 30

        it "constructs struct with all fields":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: constructs struct with all fields")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            struct Config:
                host: str
                port: i64

            val c = Config { host: "localhost", port: 8080 }
            expect c.port == 8080

    context "struct field access":
        # ### Scenario: Accessing Struct Fields
        #
        # Reads field values using dot notation.

        it "accesses struct fields":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: accesses struct fields")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            struct Rectangle:
                width: i64
                height: i64

            val r = Rectangle { width: 10, height: 5 }
            expect r.width * r.height == 50


# ============================================================================
# Impl Blocks
# ============================================================================

describe "Impl Blocks":
    # ## Methods via Impl Blocks
    #
    # Tests for adding methods to structs using impl blocks.

    it "adds method to struct":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: adds method to struct")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        struct Point:
            x: i64
            y: i64

        impl Point:
            fn sum(self):
                return self.x + self.y

        val p = Point { x: 15, y: 25 }
        expect p.sum() == 40

    it "adds method with arguments":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: adds method with arguments")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        struct Counter:
            value: i64

        impl Counter:
            fn add(self, n):
                return self.value + n

        val c = Counter { value: 10 }
        expect c.add(5) == 15


# ============================================================================
# Classes with Static Methods
# ============================================================================

describe "Classes":
    # ## Class Definitions
    #
    # Tests for classes with static methods.

    it "defines class with static method":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: defines class with static method")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        class Calculator:
            static fn add(a, b):
                return a + b

        expect Calculator.add(3, 4) == 7


# ============================================================================
# Context Blocks
# ============================================================================

describe "Context Blocks":
    # ## Context Block Syntax
    #
    # Tests for context blocks that provide implicit receiver.

    it "dispatches methods to context object":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: dispatches methods to context object")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        class Calculator:
            fn double(self, x):
                return x * 2

        val calc = Calculator {}
        var res = 0
        context calc:
            res = double(21)
        expect res == 42

    it "accesses self fields in context":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: accesses self fields in context")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        class Adder:
            base: i64 = 10

            fn add(self, x):
                return self.base + x

        val a = Adder { base: 30 }
        var res = 0
        context a:
            res = add(12)
        expect res == 42


# ============================================================================
# Method Missing
# ============================================================================

describe "Method Missing":
    # ## Dynamic Method Handling
    #
    # Tests for method_missing to handle undefined methods.

    it "calls method_missing for unknown method":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: calls method_missing for unknown method")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        class DSL:
            fn method_missing(self, name, args, block):
                return 42

        val d = DSL {}
        expect d.unknown_method() == 42

    it "passes arguments to method_missing":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: passes arguments to method_missing")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        class Multiplier:
            factor: i64 = 10

            fn method_missing(self, name, args, block):
                val x = args[0]
                return self.factor * x

        val m = Multiplier { factor: 7 }
        expect m.any_method(6) == 42
