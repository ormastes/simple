"""
## Purpose and audience

# Freeze and Unfreeze Collections for Immutability

**Feature ID:** #LANG-025
**Category:** Language
**Status:** Active

## Overview

The `freeze()` function converts mutable collections (arrays and dicts) into immutable
snapshots that support read operations but prevent modification. Frozen collections
retain full access to non-mutating operations like indexing, iteration, `map`, `filter`,
`reduce`, `keys`, `values`, and `contains`. This spec validates freeze behavior on arrays
and dicts, confirms idempotence (freezing an already-frozen collection is a no-op),
and verifies that functional operations produce correct results on frozen data.

## Syntax

```simple
var arr = [1, 2, 3]
val frozen = freeze(arr)           # immutable snapshot
frozen.map(_1 * 2)                # [2, 4, 6] - functional ops work
frozen.filter(_1 % 2 == 0)        # filtering works on frozen

var dict = {"a": 1, "b": 2}
val frozen_dict = freeze(dict)     # frozen dict
frozen_dict.keys()                 # read-only access to keys
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| `freeze()` | Converts a mutable collection into an immutable copy |
| Idempotence | Calling `freeze()` on an already-frozen collection returns an equivalent value |
| Read-only access | Frozen collections support indexing, `len`, `first`, `last`, negative indexing |
| Functional operations | `map`, `filter`, `reduce`, `contains` all work on frozen collections |
| Dict freeze | Frozen dicts support `keys`, `values`, `contains_key`, and key-based access |

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/freeze_unfreeze_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Freeze and Unfreeze":

    context "Freeze Function":
        it "freezes mutable array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: freezes mutable array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            val frozen = freeze(arr)
            expect frozen[0] == 1
            expect frozen.len() == 3

        it "freezes mutable dict":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: freezes mutable dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var dict = {"a": 1}
            val frozen = freeze(dict)
            expect frozen["a"] == 1

        it "is idempotent":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: is idempotent")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr = freeze([1, 2, 3])
            val frozen_again = freeze(arr)
            expect frozen_again[0] == arr[0]
            expect frozen_again.len() == arr.len()

        it "freezes empty array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: freezes empty array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze([])
            expect frozen.len() == 0

        it "freezes empty dict":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: freezes empty dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze({})
            expect frozen.len() == 0

    context "Frozen Array Operations":
        it "allows reads on frozen array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: allows reads on frozen array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze([1, 2, 3])
            expect frozen[0] == 1
            expect frozen[2] == 3

        it "allows len on frozen array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: allows len on frozen array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze([1, 2, 3])
            expect frozen.len() == 3

        it "allows iteration on frozen array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: allows iteration on frozen array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze([1, 2, 3])
            var sum = 0
            for x in frozen:
                sum = sum + x
            expect sum == 6

        it "allows first and last on frozen array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: allows first and last on frozen array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze([1, 2, 3])
            expect frozen.first() == 1
            expect frozen.last() == 3

        it "allows negative indexing on frozen array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: allows negative indexing on frozen array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze([1, 2, 3])
            expect frozen[-1] == 3
            expect frozen[-2] == 2

    context "Functional Operations on Frozen":
        it "allows map on frozen array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: allows map on frozen array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze([1, 2, 3])
            val doubled = frozen.map(_1 * 2)
            expect doubled[0] == 2
            expect doubled[1] == 4
            expect doubled[2] == 6

        it "allows filter on frozen array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: allows filter on frozen array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze([1, 2, 3, 4, 5])
            val evens = frozen.filter(_1 % 2 == 0)
            expect evens[0] == 2
            expect evens.len() == 2
            expect evens[1] == 4

        it "allows reduce on frozen array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: allows reduce on frozen array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze([1, 2, 3, 4])
            val sum = frozen.reduce(0, \acc, x: acc + x)
            expect sum == 10

        it "allows contains on frozen array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: allows contains on frozen array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze([1, 2, 3])
            expect frozen.contains(2)
            expect not frozen.contains(5)

    context "Frozen Dict Operations":
        it "allows reads on frozen dict":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: allows reads on frozen dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze({"a": 1, "b": 2})
            expect frozen["a"] == 1
            expect frozen["b"] == 2

        it "allows len on frozen dict":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: allows len on frozen dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze({"a": 1, "b": 2})
            expect frozen.len() == 2

        it "allows keys on frozen dict":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: allows keys on frozen dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze({"a": 1, "b": 2})
            val keys = frozen.keys()
            expect keys.len() == 2

        it "allows values on frozen dict":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: allows values on frozen dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze({"a": 1, "b": 2})
            val values = frozen.values()
            expect values.len() == 2

        it "allows contains_key on frozen dict":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-019
            step("Verify: allows contains_key on frozen dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze({"a": 1})
            expect frozen.has("a")
            expect not frozen.has("b")

    context "Type Behavior":
        it "treats frozen arrays as arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-020
            step("Verify: treats frozen arrays as arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze([1, 2, 3])
            expect frozen[0] == 1
            expect frozen.len() == 3

        it "treats frozen dicts as dicts":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-021
            step("Verify: treats frozen dicts as dicts")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frozen = freeze({"a": 1})
            expect frozen["a"] == 1
