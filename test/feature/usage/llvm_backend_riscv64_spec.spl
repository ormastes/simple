"""
## Purpose and audience

# LLVM Backend RISC-V 64-bit Specification


**Feature IDs:** #4005
**Category:** Infrastructure
**Difficulty:** 3/5
**Status:** In Progress

Validates that the LLVM backend correctly generates code for RISC-V 64-bit targets.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/llvm_backend_riscv64_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use compiler.backend.llvm_ir_builder.{LlvmIRBuilder, LlvmIRBuilder__create, MirToLlvm, MirToLlvm__create}
use compiler.backend.llvm_target.{LlvmTargetTriple, LlvmTargetTriple__from_target, LlvmTargetConfig, LlvmTargetConfig__for_target}
use compiler.backend.llvm_type_mapper.{LlvmTypeMapper, LlvmTypeMapper__create_for_target}
use compiler.backend.entry_point.halt_instruction_for_target
use compiler.backend.backend_api.{CodegenTarget, OptimizationLevel}
use compiler.backend.backend.riscv_target.{riscv_linux_target_contract}
use std.common.test_env_gate.{test_env_llvm_available, test_env_gate_skip}
use std.spec.step
use std.spec.{step}

describe "LLVM Backend RISC-V 64":
    if not test_env_llvm_available():
        it "env_skip: LLVM not available":
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: env_skip: LLVM not available")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val reason = test_env_gate_skip("SIMPLE_LLVM_TEST")
            expect(reason).to_contain("Skipped")
        return

    context "target triple":
        it "generates correct riscv64 triple":
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: generates correct riscv64 triple")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val triple = LlvmTargetTriple__from_target(CodegenTarget.Riscv64)
            expect(triple.arch).to_equal("riscv64")
            expect(triple.to_text()).to_equal("riscv64-unknown-linux-gnu")

    context "datalayout":
        it "contains correct riscv64 layout":
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: contains correct riscv64 layout")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val triple = LlvmTargetTriple__from_target(CodegenTarget.Riscv64)
            val dl = triple.datalayout()
            expect(dl).to_contain("p:64:64")

    context "CPU defaults":
        it "defaults to generic-rv64":
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: defaults to generic-rv64")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = LlvmTargetConfig__for_target(CodegenTarget.Riscv64, nil)
            expect(config.cpu).to_equal("generic-rv64")
            expect(config.abi.unwrap()).to_equal("lp64d")

        it "includes standard extensions":
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: includes standard extensions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = LlvmTargetConfig__for_target(CodegenTarget.Riscv64, nil)
            expect(config.features).to_contain("+m")
            expect(config.features).to_contain("+a")
            expect(config.features).to_contain("+f")
            expect(config.features).to_contain("+d")
            expect(config.features).to_contain("+c")

        it "matches the shared RV64 Linux target contract":
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: matches the shared RV64 Linux target contract")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val contract = riscv_linux_target_contract(CodegenTarget.Riscv64)
            expect(contract.triple()).to_equal("riscv64-unknown-linux-gnu")
            expect(contract.abi.to_text()).to_equal("lp64d")
            expect(contract.march).to_equal("rv64gc")

    context "native integer type", tag: ["only-compiled"]:
        it "native_int_type is i64":
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: native_int_type is i64")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var translator = MirToLlvm__create("test", CodegenTarget.Riscv64, nil)
            expect(translator.native_int()).to_equal("i64")

    context "type mapping", tag: ["only-compiled"]:
        it "uses 64-bit target_bits":
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: uses 64-bit target_bits")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mapper = LlvmTypeMapper__create_for_target(CodegenTarget.Riscv64)
            expect(mapper.target_bits).to_equal(64)  # oracle: expected value 64 is the behavior asserted by this regression spec

    context "bare-metal entry":
        it "uses wfi instruction for halt":
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: uses wfi instruction for halt")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val halt = halt_instruction_for_target(CodegenTarget.Riscv64)
            expect(halt).to_equal("wfi")

    context "builder size type":
        it "uses i64 size type":
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: uses i64 size type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val triple = LlvmTargetTriple__from_target(CodegenTarget.Riscv64)
            var builder = LlvmIRBuilder__create("test", triple)
            expect(builder.size_type).to_equal("i64")
