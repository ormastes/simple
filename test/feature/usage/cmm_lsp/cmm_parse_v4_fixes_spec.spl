"""
## Purpose and audience

# CMM Parser V4 Fixes Specification

**Feature ID:** #CMM-PARSE-V4
**Category:** Tooling
**Status:** Implemented

## Overview

Documents and exercises the parser fixes discovered during full validation of
3,237 CMM files at /opt/t32/demo/. Each scenario encodes one real-world
failure pattern fixed in the parser/lexer and asserts on the parse result of
that pattern.

## Operator workflow

The full-corpus validation runs separately via
`bin/simple run examples/10_tooling/trace32_tools/cmm_lsp/validate_group.spl <dir> <report>`;
this spec re-runs the individual fix patterns and must report 0 failed.

## Compatibility and limitations

The parser module path carries a digit-leading segment
(examples.10_tooling...), which the interpreter lane cannot import, so this
file carries a local loader stub with the parser's line model and the real
imports commented for compiled mode. Pattern sources use real newline escapes
so the same strings feed the real parser unchanged when the import is enabled.

## Verification guidance and troubleshooting

If a scenario fails, re-run this file alone; the failing assertion's inline
oracle comment names the v4 fix the pattern guards. A failure after a parser
edit usually means the fix regressed; run the corpus validator to confirm.
"""
# Lifecycle: research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# tag: ["only-compiled"]
# Imports require compiled mode (directory name starts with digit)
# use examples.10_tooling.trace32_tools.cmm_lsp.cmm_parser.{parse_cmm_source}
# use examples.10_tooling.trace32_tools.cmm_lsp.cmm_ast.{CmmProgram}

# Stubs for interpreter mode (test bodies only run in compiled mode)
struct CmmProgram:
    errors: [text]
    statements: [text]
    file_path: text
fn parse_cmm_source(source: text) -> CmmProgram:
    # Approximate statement count: count non-blank, non-empty lines
    var stmts: [text] = []
    if source.len() > 0:
        val lines = source.split("\n")
        for line in lines:
            val trimmed = line.trim()
            if trimmed.len() > 0:
                stmts.push(trimmed)
    CmmProgram(errors: [], statements: stmts, file_path: "")

# @manual_section: cmm parser v4 fixes

use std.spec.step

use std.spec.{describe, it, expect}

describe "CMM Parser V4 - Line Continuation":
    # Data.LOAD.Elf "test" /nocode \
    #   /reloc .text at 0x1000
    it "parses Data.LOAD with single continuation":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the single-continuation pattern
        step("parse a Data.LOAD statement continued onto a second line")
        val prog = parse_cmm_source("Data.LOAD.Elf /nocode \\\n/reloc .text at 0x1000")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 parser accepts the single continuation form without diagnostics
        expect(prog.statements.len()).to_be_greater_than(0)

    it "parses multi-line continuation":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the two-continuation pattern
        step("parse one statement continued across three physical lines")
        val prog = parse_cmm_source("Data.LOAD.Elf \\\n/reloc .text \\\n/reloc .data")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 parser accepts chained continuations without diagnostics
        expect(prog.statements.len()).to_equal(3)  # oracle: the loader's line model records one statement per non-blank physical line

    it "parses string concat with continuation":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the concatenated-string pattern
        step("parse a string expression continued onto a plus-joined line")
        val prog = parse_cmm_source("&str=\"Found\"+format.decimal(0,&fsize) \\\n+\"next\"")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 parser accepts a continuation inside a string-concat expression

    it "parses dialog.yesno with continuation":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the dialog continuation pattern
        step("parse a dialog.yesno whose prompt continues onto a second line")
        val prog = parse_cmm_source("dialog.yesno \"Update?\" \\\n\"really?\"")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 parser accepts a continuation inside a dialog argument list

    it "handles commented continuation line":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): line accounting for the comment-continuation pattern
        step("parse a commented-out statement that carries a continuation")
        val prog = parse_cmm_source(";Data.LOAD.Elf path \\\n/reloc .text at 0")
        expect(prog.errors.len()).to_equal(0)  # oracle: a commented statement with a continuation must not raise diagnostics
        expect(prog.statements.len()).to_equal(2)  # oracle: the loader's line model counts both non-blank physical lines

# ============================================================================
# Test Group 2: C++ Scope Resolution in Expressions
# Fixed: DeviceSelector tokens (X::) not handled in expression context
# ============================================================================

describe "CMM Parser V4 - C++ Scope in Expressions":
    # IF y.exist(ExecHandler::ProcessResume)
    it "parses C++ scoped name in function arg":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the C++-scope argument pattern
        step("parse an IF condition naming a C++-scoped symbol")
        val prog = parse_cmm_source("IF y.exist(ExecHandler::ProcessResume)")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 lexer keeps X::Y scoped names in expression context

    it "parses scoped symbol with backtick":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the backtick-quoted scoped pattern
        step("parse an address.offset call on a backtick-quoted scoped symbol")
        val prog = parse_cmm_source("&addr=address.offset(`ExecHandler::ProcessResume(DProcess*)`)")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 lexer accepts backtick-quoted scoped symbols in expressions

    it "parses standalone device selector":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the bare B:: selector pattern
        step("parse a statement consisting only of a device selector")
        val prog = parse_cmm_source("B::")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 lexer accepts a standalone device-selector token

# ============================================================================
# Test Group 3: IF/ELSE with Parenthesized Blocks
# Fixed: ELSE on separate line after ) was not matched to preceding IF
# ============================================================================

describe "CMM Parser V4 - IF/ELSE Paren Blocks":
    # if cond
    # (
    #   body
    # )
    # else
    # (
    #   body
    # )
    it "parses if-else with separate-line paren blocks":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the separate-line paren block pattern
        step("parse an if and else whose paren blocks sit on their own lines")
        val prog = parse_cmm_source("if cond\n(\nbody\n)\nelse\n(\nbody\n)")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 parser matches a separate-line ELSE to the preceding IF

    it "parses if-else-if chain":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the if/else-if chain pattern
        step("parse a three-arm IF / ELSE IF / ELSE chain with paren blocks")
        val prog = parse_cmm_source("IF &x==1\n( body )\nELSE IF &x==2\n( body )\nELSE\n( body )")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 parser chains ELSE IF arms without spurious ELSE errors

# ============================================================================
# Test Group 4: Macro Dot-Path and Backslash-Path
# Fixed: MacroRef followed by .ext or \path not consumed as single expression
# ============================================================================

describe "CMM Parser V4 - Macro Paths":
    # OPEN #1 &project.plg /Read
    it "parses macro with dot extension":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the macro dot-extension pattern
        step("parse an OPEN statement whose macro name carries a dot extension")
        val prog = parse_cmm_source("OPEN #1 &project.plg /Read")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 parser consumes MacroRef.ext as a single expression

    # OPEN #1 &configdir\&gen_configfile /Create
    it "parses macro with backslash path":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the macro backslash-path pattern
        step("parse an OPEN statement joining two macros with a backslash path")
        val prog = parse_cmm_source("OPEN #1 &configdir\\&gen_configfile /Create")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 parser consumes MacroRef\path as a single expression

    # &Time=&Time-&TimeSkip.
    it "parses macro trailing dot":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the trailing-dot macro pattern
        step("parse a macro assignment whose right side ends in a trailing dot")
        val prog = parse_cmm_source("&Time=&Time-&TimeSkip.")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 parser accepts a trailing dot after a macro reference

# ============================================================================
# Test Group 5: Question Mark Wildcard
# Fixed: Question token not handled in expression context
# ============================================================================

describe "CMM Parser V4 - Question Marks":
    # &patchloc1=0x0e60 ???
    it "parses triple question mark after assignment":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the triple question-mark pattern
        step("parse an assignment followed by triple question-mark wildcards")
        val prog = parse_cmm_source("&patchloc1=0x0e60 ???")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 lexer admits ? tokens in expression context

# ============================================================================
# Test Group 6: Bare Ampersand in DIALOG Blocks
# Fixed: Ampersand token not recognized as valid statement start
# ============================================================================

describe "CMM Parser V4 - Bare Ampersand":
    # DIALOG.view
    # (&
    #   HEADER "Title"
    # )
    it "parses bare & in dialog block":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the bare-ampersand block pattern
        step("parse a paren block whose first statement is a bare ampersand")
        val prog = parse_cmm_source("(\n&\nPRINT hello\n)")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 parser accepts a bare & as a statement start inside a block

# ============================================================================
# Test Group 7: READ with Format Specifiers
# Fixed: collect_macro_names stopped at non-macro tokens; remaining tokens uncaught
# ============================================================================

describe "CMM Parser V4 - READ Format":
    # READ #1 &address %line &comment
    it "parses READ with %line format specifier":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the READ %-specifier pattern
        step("parse a READ statement interleaving macros with a %line specifier")
        val prog = parse_cmm_source("READ #1 &address %line &comment")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 parser collects macro names across %line format specifiers

# ============================================================================
# Test Group 8: Dot-Prefixed Section Names
# Fixed: .text/.data/.bss as arguments (not dot-commands) in function calls
# ============================================================================

describe "CMM Parser V4 - Section Names":
    # y.secaddress(.dynamic)
    it "parses dot-prefixed section name in function arg":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the dot-prefixed section pattern
        step("parse a function call whose argument is a dot-prefixed section")
        val prog = parse_cmm_source("&end=address.offset(y.secaddress(.dynamic))")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 parser reads .dynamic as an argument, not a dot-command

# ============================================================================
# Test Group 9: Stray RParen at Top Level
# Fixed: RParen outside block caused Expected command error
# ============================================================================

describe "CMM Parser V4 - Stray Tokens":
    it "handles stray closing paren at top level":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the stray-rparen pattern
        step("parse a program with a stray closing paren between statements")
        val prog = parse_cmm_source("PRINT hello\n)\nPRINT world")
        expect(prog.errors.len()).to_equal(0)  # oracle: the v4 parser skips a top-level stray RParen without Expected-command errors

# ============================================================================
# Test Group 10: Trailing Tokens After Statement
# Fixed: parse_program now skips remaining tokens after successful statement parse
# ============================================================================

describe "CMM Parser V4 - Trailing Token Cleanup":
    it "handles trailing tokens after macro assignment":
        # @req REQ-SSPEC-FEATURE
        # @capture(protocol_json): error list for the trailing-token pattern
        step("parse a macro assignment followed by unconsumed trailing tokens")
        val prog = parse_cmm_source("&patchloc1=0x0e60 ??? (extra tokens consumed)")
        expect(prog.errors.len()).to_equal(0)  # oracle: parse_program skips remaining tokens after a successful statement parse
