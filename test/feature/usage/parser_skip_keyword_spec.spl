        step("Verify: parses skip with multiline comment")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        skip  /*
            Multiline comment
            about skipping
        */
        expect true

describe "Skip keyword - indentation and whitespace":
    it "parses skip with various indentation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-034
        step("Verify: parses skip with various indentation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn indented():
            skip
            if true:
                skip
                for i in 0..1:
                    skip
        expect true

    it "parses skip with no trailing whitespace":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-035
        step("Verify: parses skip with no trailing whitespace")
        # @capture: assertion outcomes retained in the spec Results output as evidence
