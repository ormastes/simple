describe "Skip keyword - semantics and runtime behavior":
    it "skip statement does not prevent execution":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-037
        step("Verify: skip statement does not prevent execution")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var executed = false
        skip
        executed = true
        expect executed == true

    it "skip does not affect variable scope":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-038
        step("Verify: skip does not affect variable scope")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        skip
        val scoped = 100
        expect scoped == 100

    it "skip does not affect return value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-039
        step("Verify: skip does not affect return value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn returns_with_skip():
            skip
            return "value"
        expect returns_with_skip() == "value"

    it "skip does not affect loop iteration":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-040
        step("Verify: skip does not affect loop iteration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var iterations = 0
        for i in 0..5:
            skip
            iterations = iterations + 1
        expect iterations == 5

