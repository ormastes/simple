"""
## Purpose and audience

# Existence Check Value Return (.? → T?) Specification

**Feature IDs:** #2100-VALUE-RETURN
**Category:** Syntax
**Difficulty:** 3/5
**Status:** Implemented (requires compiler rebuild)
**Research:** doc/01_research/text_validity_presence_pattern_2026-02-24.md

## Overview

After the `.?` return-type change, the operator returns `T?` instead of `bool`.
This enables pattern binding (`if val x = expr.?:`) and nil coalescing
(`expr.? ?? default`).

## Behavior

`.?` returns `T?` — value if present, nil if absent. Option types pass through
without double-wrapping. See `doc/06_spec/app/compiler/feature/exists_check_spec.md` for the
full type/return table.

## Related

- `exists_check_spec.spl` — boolean truthiness tests
- `elif_val_pattern_binding_spec.spl` — `if val` / `elif val` patterns

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/exists_check_value_return_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Existence Check Value Return (.? -> T?)":
    """
    ## Value Return Semantics

    Verifies that `.?` returns `T?` (value if present, nil if absent),
    enabling pattern binding and nil coalescing. These tests require a
    compiler rebuild to pass — the pre-built binary returns `bool`.
    """

    context "nil coalescing with text":
        """
        ### Text Nil Coalescing

        `.?` on text returns `text?`, enabling `?? default` patterns.
        Non-empty strings return the value, empty strings return nil.
        """

        it "returns value for non-empty string via ??":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: returns value for non-empty string via ??")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = "hello"
            val result = s.? ?? "default"
            expect result == "hello"

        it "returns default for empty string via ??":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: returns default for empty string via ??")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = ""
            val result = s.? ?? "default"
            expect result == "default"

        it "chains multiple ?? fallbacks":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: chains multiple ?? fallbacks")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val a = ""
            val b = ""
            val c = "found"
            val result = a.? ?? b.? ?? c.? ?? "none"
            expect result == "found"

    context "nil coalescing with collections":
        """
        ### Collection Nil Coalescing

        `.?` on lists/dicts returns the collection wrapped in `T?`.
        Empty collections yield nil, enabling `?? default` fallback.
        """

        it "returns list for non-empty list via ??":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: returns list for non-empty list via ??")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val items = [1, 2, 3]
            val result = items.? ?? [0]
            expect result == [1, 2, 3]

        it "returns default for empty list via ??":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: returns default for empty list via ??")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val empty: List<i32> = []
            val result = empty.? ?? [0]
            expect result == [0]

    context "pattern binding with if val":
        """
        ### Pattern Binding

        `.?` returns `T?`, which can be destructured with `if val`.
        The bound variable is guaranteed non-empty.
        """

        it "binds non-empty string":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: binds non-empty string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val input = "hello"
            var result = "unset"
            if val name = input.?:
                result = name
            expect result == "hello"

        it "skips binding for empty string":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: skips binding for empty string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val input = ""
            var result = "default"
            if val name = input.?:
                result = name
            expect result == "default"

        it "binds non-empty list":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: binds non-empty list")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val items = [10, 20]
            var result = "unset"
            if val bound = items.?:
                result = "bound"
            expect result == "bound"

        it "skips binding for empty list":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: skips binding for empty list")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val empty: List<i32> = []
            var result = "default"
            if val bound = empty.?:
                result = "bound"
            expect result == "default"

    context "Option pass-through":
        """
        ### Option Pass-Through

        `.?` on `T?` does not double-wrap. `Some(x).?` returns `Some(x)`,
        `nil.?` returns `nil`.
        """

        it "passes through Some value":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: passes through Some value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val opt: Option<i32> = Some(42)
            val result = opt.? ?? 0
            expect result == 42

        it "returns default for None":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: returns default for None")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val opt: Option<i32> = None
            val result = opt.? ?? 0
            expect result == 0

        it "binds Some value with if val":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: binds Some value with if val")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val opt: Option<text> = Some("hi")
            var result = "unset"
            if val s = opt.?:
                result = s
            expect result == "hi"

    context "primitive values":
        """
        ### Primitive Pass-Through

        Primitives are always present — `.?` wraps them in `T?`.
        Even `0` and `false` are present values.
        """

        it "returns number via ??":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: returns number via ??")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val n = 42
            val result = n.? ?? 0
            expect result == 42

        it "returns zero via ??":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: returns zero via ??")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val n = 0
            val result = n.? ?? -1
            expect result == 0

    context "chained with methods":
        """
        ### Method Chaining

        `.?` integrates with no-paren method calls and chaining.
        """

        it "works with trim and ??":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: works with trim and ??")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = "  hello  "
            val result = s.trim.? ?? "empty"
            expect result == "hello"

        it "returns default for empty trim result":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: returns default for empty trim result")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = ""
            val result = s.trim.? ?? "empty"
            expect result == "empty"

        it "works with list.first and ??":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: works with list.first and ??")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val items = [42, 99]
            val result = items.first.? ?? 0
            expect result == 42

        it "returns default for empty list.first":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: returns default for empty list.first")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val empty: List<i32> = []
            val result = empty.first.? ?? 0
            expect result == 0
