"""
## Purpose and audience

# CLI Args File Extension Detection Specification

**Feature ID:** #CLI-007
**Category:** Language | CLI
**Status:** Draft

## Overview

Tests file extension detection and the prefetch directive in the cli keyword.
When a positional argument ends with a recognized file extension (.spl, .json,
.csv, etc.), the cli system can auto-detect the type and optionally prefetch
the file content before the main function runs.

## Syntax

```simple
cli:
    command run:
        positional file: text, ext: [".spl", ".shs"]
        prefetch: true     # read file content before dispatch

    command convert:
        positional input: text, ext: [".json", ".csv", ".sdn"]
        positional output: text
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/cli_args_file_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# CLI Args File Extension Detection
# ============================================================================

describe "CLI Args File Extension Detection":
    # ## File Extension Matching and Prefetch
    #
    # Tests that the cli keyword can validate file extensions
    # and optionally prefetch file content.

    context "extension detection":
        it "accepts file with matching extension":
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: accepts file with matching extension")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     command run:
            #         positional file: text, ext: [".spl", ".shs"]
            # val args = cli.parse(["run", "main.spl"])
            # expect(args.run.file).to_equal("main.spl")
            val file = "main.spl"
            val ext = ".spl"
            val allowed = [".spl", ".shs"]
            expect(file).to_end_with(ext)
            expect(allowed).to_contain(".spl")

        it "rejects file with wrong extension":
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: rejects file with wrong extension")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli.parse(["run", "data.json"]) should error
            # because .json is not in [".spl", ".shs"]
            val file = "data.json"
            val ext = ".json"
            val allowed = [".spl", ".shs"]
            val is_valid = false
            expect(is_valid).to_equal(false)

        it "handles file without extension":
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: handles file without extension")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli.parse(["run", "Makefile"]) should error
            # when ext filter is specified
            val file = "Makefile"
            val has_ext = false
            expect(has_ext).to_equal(false)

    context "prefetch directive":
        it "prefetches file content when enabled":
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: prefetches file content when enabled")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     command run:
            #         positional file: text, ext: [".spl"]
            #         prefetch: true
            # val args = cli.parse(["run", "hello.spl"])
            # args.file_content should contain the file contents
            val prefetch_enabled = true
            expect(prefetch_enabled).to_equal(true)

        it "skips prefetch when disabled":
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: skips prefetch when disabled")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     command run:
            #         positional file: text
            # No prefetch directive means file_content is nil
            val prefetch_enabled = false
            val file_content = nil
            expect(prefetch_enabled).to_equal(false)
            expect(file_content).to_be_nil()

        it "handles missing file gracefully":
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: handles missing file gracefully")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli.parse(["run", "nonexistent.spl"]) with prefetch: true
            # should produce a clear error about missing file
            val error_msg = "file not found: nonexistent.spl"
            expect(error_msg).to_start_with("file not found")
