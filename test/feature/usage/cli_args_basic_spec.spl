"""
## Purpose and audience

Exercises the `cli` keyword's argument parsing contract (bool flags, string
options, int options, default values) through the real parser
(std.cli.cli_parser) for language engineers and CLI authors. Every scenario
declares a real CLI surface with the builder and parses a concrete argv, so a
failure names the exact parser behavior that moved.

## Operator workflow

Run this spec and confirm the Results line reports 0 failed. Each scenario
builds a spec with cli_spec* builders, calls parse_cli_args on a literal argv,
and asserts on the parsed_* accessor output.

## Compatibility and limitations

The parser is text-typed: int options are declared and asserted in their
decimal text form. Subcommand and default-command routing are covered by the
sibling default-command spec, not here.

## Verification guidance and troubleshooting

If a scenario fails, re-run this file alone; the failing accessor call plus
its inline oracle comment identify which parse_cli_args contract regressed.
"""
# Lifecycle: research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @manual_section: cli args basic

use std.spec.step

use std.spec.{describe, it, expect}
use std.cli.cli_parser.{cli_spec, cli_spec_flag, cli_spec_option, parse_cli_args, parsed_flag, parsed_option}

describe "CLI Args Basic":

    context "bool flags":
        it "parses bool flag default":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): parsed verbose verdict for the empty argv
            step("parse an empty argv against a spec declaring the verbose flag")
            val spec = cli_spec_flag(cli_spec(), "verbose", "v", "Show detailed output")
            val parsed = parse_cli_args(spec, [])
            expect(parsed_flag(parsed, "verbose")).to_equal(false)  # oracle: parse_cli_args seeds every declared flag to false

        it "parses bool flag when set":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): parsed verbose verdict for the --verbose argv
            step("parse an argv carrying --verbose and read the flag back")
            val spec = cli_spec_flag(cli_spec(), "verbose", "v", "Show detailed output")
            val parsed = parse_cli_args(spec, ["--verbose"])
            expect(parsed_flag(parsed, "verbose")).to_equal(true)  # oracle: the long form --verbose flips the declared flag to true

    context "string options":
        it "parses string option default":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): output option value for the empty argv
            step("parse an empty argv against a spec declaring the output option default")
            val spec = cli_spec_option(cli_spec(), "output", "o", "Output file path", "result.txt", [])
            val parsed = parse_cli_args(spec, [])
            expect(parsed_option(parsed, "output")).to_equal("result.txt")  # oracle: parse_cli_args seeds every declared option with its default

        it "parses string option with value":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): output option value for the spaced argv form
            step("parse --output with a separate value token")
            val spec = cli_spec_option(cli_spec(), "output", "o", "Output file path", "result.txt", [])
            val parsed = parse_cli_args(spec, ["--output", "custom.txt"])
            expect(parsed_option(parsed, "output")).to_equal("custom.txt")  # oracle: the spaced form --output VALUE binds the next token

        it "parses string option with equals syntax":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): output option value for the equals argv form
            step("parse --output= with the value joined by an equals sign")
            val spec = cli_spec_option(cli_spec(), "output", "o", "Output file path", "result.txt", [])
            val parsed = parse_cli_args(spec, ["--output=custom.txt"])
            expect(parsed_option(parsed, "output")).to_equal("custom.txt")  # oracle: the joined form --output=VALUE splits on the first equals sign

    context "int options":
        it "parses int option default":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): count option value for the empty argv
            step("parse an empty argv against a spec declaring the count option default")
            val spec = cli_spec_option(cli_spec(), "count", "c", "Repeat count", "1", [])
            val parsed = parse_cli_args(spec, [])
            expect(parsed_option(parsed, "count")).to_equal("1")  # oracle: the parser is text-typed and returns the declared default verbatim

        it "parses int option with value":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): count option value for the --count 5 argv
            step("parse --count with the decimal value 5")
            val spec = cli_spec_option(cli_spec(), "count", "c", "Repeat count", "1", [])
            val parsed = parse_cli_args(spec, ["--count", "5"])
            expect(parsed_option(parsed, "count")).to_equal("5")  # oracle: the parser stores option values as text and must not reformat them

    context "multiple options together":
        it "handles multiple options together":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): flag, option, and count values for the combined argv
            step("parse one argv mixing a flag, a spaced option, and a spaced count")
            val spec = cli_spec_option(cli_spec_flag(cli_spec(), "verbose", "v", "Show detailed output"), "output", "o", "Output file", "out.txt", [])
            val spec2 = cli_spec_option(spec, "count", "c", "Repeat count", "1", [])
            val parsed = parse_cli_args(spec2, ["--verbose", "--output", "result.txt", "--count", "3"])
            expect(parsed_flag(parsed, "verbose")).to_equal(true)  # oracle: the flag still binds when later options follow it
            expect(parsed_option(parsed, "output")).to_equal("result.txt")  # oracle: the spaced option binds its own next token, not a neighbor's
            expect(parsed_option(parsed, "count")).to_equal("3")  # oracle: each spaced option consumes exactly one value token
