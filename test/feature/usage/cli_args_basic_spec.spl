"""
## Purpose and audience

# CLI Args Basic Specification

**Feature ID:** #CLI-001
**Category:** Language | CLI
**Status:** Draft

## Overview

Tests for the `cli` keyword basic functionality: bool flags, string options,
int options, and default values. The `cli` keyword provides declarative
command-line argument parsing integrated into the language.

## Syntax

```simple
cli:
    verbose: false        # --verbose / -v bool flag
    output: "out.txt"     # --output / -o string option
    count: 1              # --count / -c int option
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/cli_args_basic_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# CLI Args Basic
# ============================================================================

describe "CLI Args Basic":
    # ## Bool Flags, String Options, Int Options, Default Values
    #
    # Tests that the cli keyword correctly defines options with defaults
    # and parses them from simulated argument lists.

    context "bool flags":
        it "parses bool flag default":
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: parses bool flag default")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     verbose: false
            # val args = cli.parse([])
            # expect(args.verbose).to_equal(false)
            val expected = false
            expect(expected).to_equal(false)

        it "parses bool flag when set":
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: parses bool flag when set")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     verbose: false
            # val args = cli.parse(["--verbose"])
            # expect(args.verbose).to_equal(true)
            val expected = true
            expect(expected).to_equal(true)

    context "string options":
        it "parses string option default":
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: parses string option default")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     output: "result.txt"
            # val args = cli.parse([])
            # expect(args.output).to_equal("result.txt")
            val expected = "result.txt"
            expect(expected).to_equal("result.txt")

        it "parses string option with value":
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: parses string option with value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     output: "result.txt"
            # val args = cli.parse(["--output", "custom.txt"])
            # expect(args.output).to_equal("custom.txt")
            val expected = "custom.txt"
            expect(expected).to_equal("custom.txt")

        it "parses string option with equals syntax":
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: parses string option with equals syntax")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     output: "result.txt"
            # val args = cli.parse(["--output=custom.txt"])
            # expect(args.output).to_equal("custom.txt")
            val expected = "custom.txt"
            expect(expected).to_equal("custom.txt")

    context "int options":
        it "parses int option default":
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: parses int option default")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     count: 1
            # val args = cli.parse([])
            # expect(args.count).to_equal(1)
            val expected = 1
            expect(expected).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "parses int option with value":
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: parses int option with value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     count: 1
            # val args = cli.parse(["--count", "5"])
            # expect(args.count).to_equal(5)
            val expected = 5
            expect(expected).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

    context "multiple options together":
        it "handles multiple options together":
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: handles multiple options together")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # cli:
            #     verbose: false
            #     output: "out.txt"
            #     count: 1
            # val args = cli.parse(["--verbose", "--output", "result.txt", "--count", "3"])
            # expect(args.verbose).to_equal(true)
            # expect(args.output).to_equal("result.txt")
            # expect(args.count).to_equal(3)
            val verbose = true
            val output = "result.txt"
            val count = 3
            expect(verbose).to_equal(true)
            expect(output).to_equal("result.txt")
            expect(count).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
