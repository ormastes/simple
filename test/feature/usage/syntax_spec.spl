"""
## Purpose and audience

# Simple Language Syntax Specification - Test Specification

**Status:** Stable
**Feature IDs:** #10-19
**Keywords:** syntax, lexical, operators, indentation
**Last Updated:** 2026-02-08
**Topics:** syntax, type-system
**Symbols:** Token, Operator, Parser, Lexer
**Module:** simple_parser
**Migrated From:** doc/06_spec/feature/usage/syntax_spec.md

## Overview

Comprehensive tests for Simple's syntax, including literals, string interpolation,
operators, and indentation-based parsing.

Simple uses Python-like indentation with type annotations and explicit execution mode control.

## Related Specifications

- **Types** - Type annotations and type syntax
- **Functions** - Function definition syntax
- **Parser** - Parser implementation details

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/syntax_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")

describe "Syntax Spec":
    it "syntax overview - if/else":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: syntax overview - if/else")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # An if/else example with indentation
        val x = 1
        if x > 0:
            check(true)
        else:
            check(false)

    it "syntax overview - iteration":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: syntax overview - iteration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Iterating with a trailing block
        val list = [1, 2, 3]
        check(true)

    it "literals - integer formats":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: literals - integer formats")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val count = 1_000_000
        val color = 0xFF5733
        val mask = 0x0000_FFFF
        val flags = 0b1010_0101
        val permissions = 0o755
        check(true)

    it "literals - floating point":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: literals - floating point")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val pi = 3.14159
        check(true)

    it "literals - typed suffixes":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: literals - typed suffixes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Typed suffixes for clarity
        check(true)

    it "string literals - interpolation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: string literals - interpolation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = "world"
        val count = 42
        val msg = "Hello, {name}! Count is {count + 1}"
        check(true)

    it "string literals - raw strings":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: string literals - raw strings")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val regex = '[a-z]+\d{2,3}'
        val path = 'C:\Users\name'
        check(true)

    it "string literals - basic interpolation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: string literals - basic interpolation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = "world"
        val msg = "Hello, {name}!"
        check(true)

    it "functional update syntax - arrays":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: functional update syntax - arrays")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var data = [1, 2, 3]
        check(true)

    it "functional update syntax - basic":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: functional update syntax - basic")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(true)

    it "functional update syntax - lists":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: functional update syntax - lists")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var list = [1, 2, 3]
        check(true)

    it "functional update syntax - pattern 1":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: functional update syntax - pattern 1")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(true)

    it "functional update syntax - pattern 2":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: functional update syntax - pattern 2")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(true)

    it "parsing design rationale - simplicity":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: parsing design rationale - simplicity")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(true)

    it "parsing design rationale - lambdas":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: parsing design rationale - lambdas")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val double = \x: x * 2
        check(true)
