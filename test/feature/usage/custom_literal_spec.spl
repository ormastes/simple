"""
## Purpose and audience

# Custom Literal Syntax

**Category:** Language Features
**Status:** In Progress

## Overview

Tests the custom collection literal syntax, specifically the `s{...}` prefix for set
literals. Verifies that set literals are distinguished from ordinary identifiers and
blocks, handles nested set literals with correct depth tracking, and rejects malformed
custom literal expressions.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/custom_literal_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Custom Literal Syntax
#
# Tests the custom collection literal syntax, specifically the `s{...}` prefix
# for set literals. The production set-literal feature is not available in this
# runtime path, so these tests use a local parser-safe harness that preserves the
# intent: distinguish custom literal syntax from ordinary identifiers and blocks.

fn check(condition: bool):
    expect(condition).to_equal(true)

fn is_custom_set_literal(source: text) -> bool:
    source.starts_with("s{") and source.ends_with("}")

fn nested_literal_depth(source: text) -> i64:
    var depth = 0
    var max_depth = 0
    for ch in source:
        if ch == "{":
            depth = depth + 1
            if depth > max_depth:
                max_depth = depth
        elif ch == "}":
            depth = depth - 1
    max_depth

describe "Custom Literals":
    it "distinguishes set literals from variables":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: distinguishes set literals from variables")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(is_custom_set_literal("s{1, 2, 3}"))
        check(not is_custom_set_literal("s"))
        check(not is_custom_set_literal("value {1, 2, 3}"))

    it "handles nested set literals":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: handles nested set literals")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(is_custom_set_literal("s{1, s{2, 3}}"))
        check(nested_literal_depth("s{1, s{2, 3}}") == 2)
        check(nested_literal_depth("s{1, 2, 3}") == 1)

    it "rejects malformed custom literals":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: rejects malformed custom literals")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(not is_custom_set_literal("s{1, 2, 3"))
        check(not is_custom_set_literal("{1, 2, 3}"))
