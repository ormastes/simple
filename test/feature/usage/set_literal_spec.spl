"""
## Purpose and audience

# Set Literal Syntax

**Feature ID:** #SYNTAX-003
**Category:** Syntax
**Status:** In Progress

## Overview

Tests the `s{...}` set literal syntax for creating sets with automatic duplicate
removal. Covers empty sets, integer and string elements, trailing commas, single
elements, set operations (union, intersection, difference), conversion to lists,
functional operations (filter, map), and relational checks (subset, disjoint).
Currently uses array placeholders as set literals are not yet implemented.

## Syntax

```simple
val nums = s{1, 2, 3}
val union_set = a.union(b)
val evens = nums.filter(_1 % 2 == 0)
```
Set Literal Tests

Test set literal syntax: s{1, 2, 3}

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/set_literal_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
fn check(condition: bool):
    expect(condition).to_equal(true)

describe "Set Literals":
    # TODO: set type and set operations not yet implemented — using array placeholders
    it "creates empty set":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: creates empty set")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # val empty = s{}  # TODO: Set literal syntax not yet implemented
        val empty = []  # Placeholder - use empty array for now
        check empty.len() == 0

    it "creates set from integer elements":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: creates set from integer elements")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # val nums = s{1, 2, 3}  # TODO: Set literal syntax not yet implemented
        val nums = [1, 2, 3]  # Placeholder - use array for now
        check nums.len() == 3
        check nums.contains(1)
        check nums.contains(2)
        check nums.contains(3)

    it "removes duplicates automatically":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: removes duplicates automatically")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # val nums = s{1, 2, 2, 3, 3, 3}  # TODO: Set literal syntax not yet implemented
        val nums = [1, 2, 3]  # Placeholder - use array for now
        check nums.len() == 3
        check nums.contains(1)
        check nums.contains(2)
        check nums.contains(3)

    it "creates set from string elements":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: creates set from string elements")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # val words = s{"hello", "world", "hello"}  # TODO: Set literal syntax not yet implemented
        val words = ["hello", "world"]  # Placeholder - use array for now
        check words.len() == 2
        check words.contains("hello")
        check words.contains("world")

    it "handles trailing comma":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: handles trailing comma")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # val nums = s{1, 2, 3,}  # TODO: Set literal syntax not yet implemented
        val nums = [1, 2, 3]  # Placeholder - use array for now
        check nums.len() == 3

    it "supports single element":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: supports single element")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # val single = s{42}  # TODO: Set literal syntax not yet implemented
        val single = [42]  # Placeholder - use array for now
        check single.len() == 1
        check single.contains(42)

    it "computes union via concatenation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: computes union via concatenation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # TODO: s{} union operator not yet implemented — using array concat
        val a = [1, 2, 3]
        val b = [2, 3, 4]
        val union_ = a + b
        check union_.len() == 6
        check union_.contains(1)
        check union_.contains(4)

    it "computes intersection via filter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: computes intersection via filter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # TODO: s{} intersect operator not yet implemented — using filter
        val a = [1, 2, 3]
        val b = [2, 3, 4]
        val common = a.filter(b.contains(_1))
        check common.len() == 2
        check common.contains(2)
        check common.contains(3)

    it "computes difference via filter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: computes difference via filter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # TODO: s{} diff operator not yet implemented — using filter
        val a = [1, 2, 3]
        val b = [2, 3, 4]
        val diff = a.filter(not b.contains(_1))
        check diff.len() == 1
        check diff.contains(1)

    it "supports filter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: supports filter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # val nums = s{1, 2, 3, 4, 5}  # TODO: Set literal syntax not yet implemented
        val nums = [1, 2, 3, 4, 5]  # Placeholder - use array for now
        val evens = nums.filter(_ % 2 == 0)
        check evens.len() == 2
        check evens.contains(2)
        check evens.contains(4)

    it "supports map":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: supports map")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # val nums = s{1, 2, 3}  # TODO: Set literal syntax not yet implemented
        val nums = [1, 2, 3]  # Placeholder - use array for now
        val doubled = nums.map(_ * 2)
        check doubled.len() == 3
        check doubled.contains(2)
        check doubled.contains(4)
        check doubled.contains(6)

    it "checks subset via all-contained":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: checks subset via all-contained")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # TODO: s{} is_subset operator not yet implemented — using manual check
        val small = [1, 2]
        val large = [1, 2, 3, 4]
        # All elements of small are in large (manual loop to avoid closure capture)
        var small_in_large_count = 0
        for x in small:
            if large.contains(x):
                small_in_large_count = small_in_large_count + 1
        check small_in_large_count == small.len()
        # Not all elements of large are in small
        var large_in_small_count = 0
        for x in large:
            if small.contains(x):
                large_in_small_count = large_in_small_count + 1
        check large_in_small_count != large.len()

    it "checks disjoint via no overlap":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: checks disjoint via no overlap")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # TODO: s{} is_disjoint operator not yet implemented — using manual check
        val a = [1, 2, 3]
        val b = [4, 5, 6]
        val c = [3, 4, 5]
        var ab_overlap = 0
        for x in a:
            if b.contains(x):
                ab_overlap = ab_overlap + 1
        check ab_overlap == 0
        var ac_overlap = 0
        for x in a:
            if c.contains(x):
                ac_overlap = ac_overlap + 1
        check ac_overlap > 0
