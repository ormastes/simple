# Test Group 11: Async Functions
# ============================================================================

describe "Async Function Parsing":
    # ## Async/Await Syntax
    #
    # Tests parsing of async function definitions.

    it "parses async function":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-032
        step("Verify: parses async function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        async fn fetch_value() -> i64:
            42
        expect true  # Compiles successfully

    it "parses await expression":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-033
        step("Verify: parses await expression")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        async fn get_data() -> i64:
            42
        async fn use_data() -> i64:
            val x = await get_data()
            x * 2
        expect true  # Compiles successfully
