"""
## Purpose and audience

# Parser Function Definition Specification

**Feature IDs:** #PARSER-FN-001 to #PARSER-FN-020
**Category:** Infrastructure | Parser
**Status:** Implemented

Tests that the parser correctly parses function definitions including
parameters, return types, generics, where clauses, and various function forms.

## Syntax

```simple
fn name(params) -> ReturnType:
body

fn generic<T>(x: T) -> T where T: Trait:
body

extern fn ffi_func(x: i64) -> i64

macro name(params) -> (contract):
body
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/parser_functions_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Basic Function Definitions
# ============================================================================

describe "Basic Function Definition Parsing":
    # ## Simple Function Syntax
    #
    # Tests parsing of basic function definitions.

    context "minimal functions":
        it "parses function without params":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: parses function without params")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn get_value() -> i64:
                42
            expect get_value() == 42

        it "parses function with single param":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: parses function with single param")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn double(x: i64) -> i64:
                x * 2
            expect double(21) == 42

        it "parses function with multiple params":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: parses function with multiple params")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn add(a: i64, b: i64) -> i64:
                a + b
            expect add(20, 22) == 42

    context "return types":
        it "parses explicit return type":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: parses explicit return type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn typed() -> i64:
                42
            expect typed() == 42

        it "parses inferred return":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: parses inferred return")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn inferred():
                42
            expect inferred() == 42

        it "parses unit return":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: parses unit return")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn unit_fn():
                val x = 1
            unit_fn()
            expect true

    context "function body":
        it "parses multi-statement body":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: parses multi-statement body")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn complex(x: i64) -> i64:
                val doubled = x * 2
                val incremented = doubled + 1
                incremented
            expect complex(20) == 41

        it "parses recursive function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: parses recursive function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn fib(n: i64) -> i64:
                if n <= 1:
                    n
                else:
                    fib(n - 1) + fib(n - 2)
            expect fib(10) == 55


# ============================================================================
# Test Group 2: Generic Functions
# ============================================================================

describe "Generic Function Parsing":
    # ## Type Parameters with Angle Brackets
    #
    # Tests parsing of generic function definitions.

    it "parses single type parameter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: parses single type parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn identity<T>(x: T) -> T:
            x
        expect identity(42) == 42

    it "parses multiple type parameters":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: parses multiple type parameters")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn pair<T, U>(a: T, b: U) -> (T, U):
            (a, b)
        val p = pair(1, "hello")
        expect p.0 == 1

    it "parses nested generic types":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: parses nested generic types")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn wrap<T>(x: T) -> Option<T>:
            Some(x)
        expect wrap(42).unwrap() == 42


# ============================================================================
# Test Group 3: Where Clauses
# ============================================================================

describe "Where Clause Parsing":
    # ## Type Constraints
    #
    # Tests parsing of where clauses with trait bounds.

    it "parses single where clause":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: parses single where clause")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Show:
            fn show() -> text
        fn display<T>(x: T) -> text where T: Show:
            x.show()
        struct Number:
            value: i64
        impl Show for Number:
            fn show() -> text:
                "{self.value}"
        expect display(Number { value: 42 }) == "42"

    it "parses multiple bounds":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: parses multiple bounds")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Clone:
            fn clone() -> Self
        trait Debug:
            fn debug() -> text
        fn process<T>(x: T) where T: Clone + Debug:
            x
        expect true  # Compiles successfully

    it "parses multiple where clauses":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: parses multiple where clauses")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Cloneable:
            fn clone() -> Self
        fn combine<T, U>(a: T, b: U) where T: Cloneable, U: Cloneable:
            a
        expect true  # Compiles successfully


# ============================================================================
# Test Group 4: Default Parameters
# ============================================================================

describe "Default Parameter Parsing":
    # ## Parameters with Default Values
    #
    # Tests parsing of function parameters with defaults.

    it "parses default parameter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: parses default parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn greet(name: text = "World") -> text:
            "Hello, {name}!"
        expect greet() == "Hello, World!"
        expect greet("Alice") == "Hello, Alice!"

    it "parses multiple defaults":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: parses multiple defaults")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn create_point(x: i64 = 0, y: i64 = 0) -> (i64, i64):
            (x, y)
        val p1 = create_point()
        val p2 = create_point(5)
        val p3 = create_point(5, 10)
        expect p1.0 == 0
        expect p2.0 == 5
        expect p3.1 == 10

    it "parses mixed required and default":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-017
        step("Verify: parses mixed required and default")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn format(value: i64, prefix: text = "", suffix: text = "") -> text:
            "{prefix}{value}{suffix}"
        expect format(42) == "42"
        expect format(42, "<<") == "<<42"


# ============================================================================
# Test Group 5: Named Arguments
# ============================================================================

describe "Named Argument Parsing":
    # ## Calling Functions with Named Arguments
    #
    # Tests parsing of function calls with named argument syntax.

    it "parses named arguments":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-018
        step("Verify: parses named arguments")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn point(x: i64, y: i64) -> (i64, i64):
            (x, y)
        val p = point(x = 10, y = 20)
        expect p.0 == 10

    it "parses mixed positional and named":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-019
        step("Verify: parses mixed positional and named")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn format_person(name: text, age: i64, city: text) -> text:
            "{name}, {age}, from {city}"
        val result = format_person("Alice", age = 30, city = "NYC")
        expect result == "Alice, 30, from NYC"

    it "parses named arguments in any order":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: parses named arguments in any order")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn subtract(a: i64, b: i64) -> i64:
            a - b
        expect subtract(b = 10, a = 52) == 42


# ============================================================================
# Test Group 6: Extern Functions
# ============================================================================

describe "Extern Function Parsing":
    # ## External Function Declarations
    #
    # Tests parsing of extern function declarations.

    it "parses extern function":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-021
        step("Verify: parses extern function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        extern fn strlen(s: text) -> i64

        # Extern functions may not be callable without FFI setup
        # but should parse correctly
        expect true

    it "parses extern with multiple params":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-022
        step("Verify: parses extern with multiple params")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        extern fn add_external(a: i64, b: i64) -> i64
        expect true


# ============================================================================
# Test Group 7: Macro Definitions
# ============================================================================

describe "Macro Definition Parsing":
    # ## Compile-Time Code Generation
    #
    # Tests parsing of macro definitions.

    it "parses macro definition":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-023
        step("Verify: parses macro definition")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        macro double_emit(x: i64) -> (returns result: i64):
            emit result:
                x + x
        val value = double_emit!(21)
        expect value == 42


# ============================================================================
# Test Group 8: Actor Definitions
# ============================================================================

describe "Actor Definition Parsing":
    # ## Concurrent Actor Syntax
    #
    # Tests parsing of actor definitions.

    it "parses actor definition":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-024
        step("Verify: parses actor definition")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        actor Counter:
            count: i64 = 0

            fn increment():
                self.count = self.count + 1

            fn get() -> i64:
                self.count

        expect true  # Compiles successfully


# ============================================================================
# Test Group 9: Method Definitions
# ============================================================================

describe "Method Definition Parsing":
    # ## Methods in Impl Blocks
    #
    # Tests parsing of methods defined in impl blocks.

    context "instance methods":
        it "parses method with self":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-025
            step("Verify: parses method with self")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            class Point:
                x: i64
                y: i64

                fn sum() -> i64:
                    self.x + self.y

            val p = Point(x: 20, y: 22)
            expect p.sum() == 42

        it "parses mutable method":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-026
            step("Verify: parses mutable method")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            class Counter:
                value: i64

                me increment():
                    self.value = self.value + 1

            var c = Counter(value: 0)
            c.increment()
            expect c.value == 1

    context "static methods":
        it "parses static method":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-027
            step("Verify: parses static method")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            class Point:
                x: i64
                y: i64

                static fn origin() -> Point:
                    Point(x: 0, y: 0)

            val p = Point.origin()
            expect p.x == 0


# ============================================================================
# Test Group 10: Closure/Lambda Forms
# ============================================================================

describe "Lambda Expression Parsing":
    # ## Anonymous Function Syntax
    #
    # Tests parsing of lambda expressions.

    it "parses simple lambda":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-028
        step("Verify: parses simple lambda")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val f = \x: x * 2
        expect f(21) == 42

    it "parses multi-param lambda":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-029
        step("Verify: parses multi-param lambda")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val f = \a, b, c: a + b + c
        expect f(10, 20, 12) == 42

    it "parses typed lambda":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-030
        step("Verify: parses typed lambda")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Typed lambda syntax not yet supported
        val f = \x: x * 2
        expect f(21) == 42

    it "parses lambda in higher-order context":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-031
        step("Verify: parses lambda in higher-order context")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn apply(f, x: i64) -> i64:
            f(x)
        expect apply(\x: x + 1, 41) == 42


