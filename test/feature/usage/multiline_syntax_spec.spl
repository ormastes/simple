"""
## Purpose and audience

# Multi-line Syntax Specification


**Feature ID:** #MULTI-001
**Category:** Language | Syntax
**Status:** Implemented

## Overview

Tests for multi-line syntax patterns including function calls spanning
multiple lines, array literals, and continuation lines.

## Syntax

```simple
# Multi-line function call
val result = function_name(
arg1,
arg2,
arg3
)

# Multi-line array
val items = [
1,
2,
3
]

# Line continuation with backslash
val sum = 1 + 2 + \
3 + 4
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/multiline_syntax_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Multi-line Function Calls
# ============================================================================

describe "Multi-line Function Calls":
    # ## Function Calls Spanning Multiple Lines
    #
    # Tests for calling functions with arguments on separate lines.

    context "basic multi-line calls":
        it "calls function with arguments on multiple lines":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: calls function with arguments on multiple lines")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn add(a, b):
                return a + b

            val result = add(
                1,
                2
            )
            expect result == 3

        it "calls function with named arguments on multiple lines":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: calls function with named arguments on multiple lines")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn greet(name, msg):
                return 42

            val result = greet(
                name: "test",
                msg: "hello"
            )
            expect result == 42

    context "nested function calls":
        it "nests function calls on single line":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: nests function calls on single line")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn inner(x):
                return x * 2

            fn outer(a, b):
                return a + b

            expect outer(inner(5), inner(3)) == 16

        it "nests function calls on multiple lines":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: nests function calls on multiple lines")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn inner(x):
                return x * 2

            fn outer(a, b):
                return a + b

            val result = outer(
                inner(5),
                inner(3)
            )
            expect result == 16


# ============================================================================
# Multi-line Arrays and Structs
# ============================================================================

describe "Multi-line Literals":
    # ## Array and Struct Literals Spanning Lines
    #
    # Tests for multi-line array and struct initialization.

    it "creates multi-line array literal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: creates multi-line array literal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [
            1,
            2,
            3
        ]
        expect arr[0] + arr[1] + arr[2] == 6

    it "creates multi-line struct initialization":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: creates multi-line struct initialization")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        struct Config:
            name: str
            value: i64

        fn Config_new(name, value):
            return Config { name: name, value: value }

        val c = Config_new(
            "test",
            42
        )
        expect c.value == 42


# ============================================================================
# Continuation Lines
# ============================================================================

describe "Continuation Lines":
    # ## Line Continuation with Implicit Join
    #
    # Tests for implicit line continuation inside brackets/parens.

    it "continues function call to next line":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: continues function call to next line")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn match_exception(a, b, c):
            return 42

        val result = match_exception("ValueError", "some message",
                           "expected")
        expect result == 42

    it "continues call at same indent level":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: continues call at same indent level")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn match_exception(a, b, c):
            return 42

        val result = match_exception("ValueError", "some message",
"expected")
        expect result == 42


# ============================================================================
# Tuple Destructuring
# ============================================================================

describe "Tuple Destructuring in Assignments":
    # ## Multi-line Tuple Patterns
    #
    # Tests for tuple destructuring assignments.

    it "destructures tuple from array element":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: destructures tuple from array element")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [(10, 20)]
        val _pair = arr[0]
        val a = _pair[0]
        val b = _pair[1]
        expect a + b == 30

    it "accesses tuple elements with dot notation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: accesses tuple elements with dot notation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [(10, 20)]
        expect arr[0].0 + arr[0].1 == 30

    it "destructures nested tuple data":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: destructures nested tuple data")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val docstrings = [("content", 1), ("other", 2)]
        val _pair = docstrings[0]
        val content = _pair[0]
        val line = _pair[1]
        expect line == 1
