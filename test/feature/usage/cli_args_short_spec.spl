"""

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/cli_args_short_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
# CLI Args Short Names Specification

**Feature ID:** #CLI-003
**Category:** Language | CLI
**Status:** Draft

## Overview

Tests short name generation and explicit short name overrides for CLI options.
The cli keyword auto-generates single-character short names from the first
letter of the option name, with conflict resolution when multiple options
share the same first letter.

## Syntax

```simple
cli:
    verbose: false                # auto-short: -v
    output: "out.txt"             # auto-short: -o
    count: 1, short: "c"         # explicit short: -c
    color: true, short: "C"      # explicit short: -C (avoids conflict with count)
```

"""



# ============================================================================
# CLI Args Short Names
# ============================================================================

describe "CLI Args Short Names":
    # ## Short Name Generation and Conflict Resolution
    #
    # Tests auto-generation of short names and explicit overrides.

    context "auto-generated short names":
        it "generates short from first letter":
            # cli:
            #     verbose: false
            # cli.parse(["-v"]) should set verbose = true
            val short_name = "v"
            expect(short_name).to_equal("v")

        it "generates short for string option":
            # cli:
            #     output: "default.txt"
            # cli.parse(["-o", "file.txt"]) should set output = "file.txt"
            val short_name = "o"
            expect(short_name).to_equal("o")

        it "generates short for int option":
            # cli:
            #     count: 1
            # cli.parse(["-c", "5"]) should set count = 5
            val short_name = "c"
            expect(short_name).to_equal("c")

    context "explicit short names":
        it "uses explicit short name":
            # cli:
            #     threads: 4, short: "t"
            # cli.parse(["-t", "8"]) should set threads = 8
            val explicit_short = "t"
            expect(explicit_short).to_equal("t")

        it "allows uppercase short name":
            # cli:
            #     color: true, short: "C"
            # cli.parse(["-C"]) should toggle color
            val explicit_short = "C"
            expect(explicit_short).to_equal("C")

    context "conflict resolution":
        it "skips short when conflict exists":
            # cli:
            #     count: 1
            #     color: true
            # First option gets -c, second has no auto-short (conflict)
            val first_short = "c"
            val second_short = ""
            expect(first_short).to_equal("c")
            expect(second_short).to_equal("")

        it "resolves conflict with explicit short":
            # cli:
            #     count: 1
            #     color: true, short: "C"
            # count gets -c, color gets -C (explicit)
            val count_short = "c"
            val color_short = "C"
            expect(count_short).to_equal("c")
            expect(color_short).to_equal("C")

        it "handles no available short name":
            # cli:
            #     alpha: false
            #     append: true
            # alpha gets -a, append gets no short (conflict, no explicit)
            val alpha_short = "a"
            val append_short = ""
            expect(alpha_short).to_equal("a")
            expect(append_short).to_equal("")
