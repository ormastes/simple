"""
## Purpose and audience

# Default Arguments Specification

**Feature ID:** #DEFARG-001
**Category:** Language | Functions
**Status:** Implemented

## Overview

Tests for function default argument values.

## Syntax

```simple
fn greet(name, greeting="Hello"):
print "{greeting}, {name}!"

greet("Alice")           # Uses default: "Hello, Alice!"
greet("Bob", "Hi")       # Override: "Hi, Bob!"
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/default_arguments_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Default Arguments
# ============================================================================

describe "Default Arguments":
    # ## Function Default Parameter Values
    #
    # Tests for default values in function parameters.

    it "uses default argument when not provided":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: uses default argument when not provided")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn add(a, b=10):
            return a + b

        expect add(5) == 15

    it "overrides default argument when provided":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: overrides default argument when provided")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn add(a, b=10):
            return a + b

        expect add(5, b=20) == 25

    it "uses multiple default arguments":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: uses multiple default arguments")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn calc(a, b=2, c=3):
            return a + b * c

        expect calc(1) == 7

    it "overrides some default arguments":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: overrides some default arguments")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn calc(a, b=2, c=3):
            return a + b * c

        expect calc(1, c=10) == 21
