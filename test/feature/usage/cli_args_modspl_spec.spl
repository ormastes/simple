"""
## Purpose and audience

# CLI Args mod.spl Embedding Specification

**Feature ID:** #CLI-010
**Category:** Language | CLI
**Status:** Draft

## Overview

Tests embedding the cli keyword in mod.spl module files. When a module's
mod.spl contains a cli block, the module becomes an executable entry point
that can be run directly. This enables self-contained CLI tools as modules.

## Syntax

```simple
# src/app/my_tool/mod.spl
cli:
    verbose: false
    output: "result.txt"

fn main(args: CliArgs):
    if args.verbose:
        print "Verbose mode enabled"
    process(args.output)
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/cli_args_modspl_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# CLI Args mod.spl Embedding
# ============================================================================

describe "CLI Args mod.spl Embedding":
    # ## CLI Blocks in Module Entry Points
    #
    # Tests that cli blocks work correctly when placed in mod.spl files.

    context "module entry point":
        it "defines cli in mod.spl":
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: defines cli in mod.spl")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # A mod.spl file with a cli block should be treated as
            # an executable module entry point
            val is_entry_point = true
            expect(is_entry_point).to_equal(true)

        it "generates CliArgs struct in module scope":
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: generates CliArgs struct in module scope")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # The generated struct should be accessible within the module
            val struct_name = "CliArgs"
            val scope = "module"
            expect(struct_name).to_equal("CliArgs")
            expect(scope).to_equal("module")

    context "module interaction":
        it "allows importing module functions alongside cli":
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: allows importing module functions alongside cli")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Other modules can import functions from a module that has cli
            # use my_tool.{process, format_output}
            val can_import = true
            expect(can_import).to_equal(true)

        it "does not export CliArgs struct by default":
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: does not export CliArgs struct by default")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # The generated CliArgs struct is private to the module
            # External modules should not see it
            val is_exported = false
            expect(is_exported).to_equal(false)
