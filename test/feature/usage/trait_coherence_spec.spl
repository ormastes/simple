# ============================================================================
# Test Group 13: Extension Trait Pattern
# ============================================================================

describe "Extension Trait Pattern":
    # ## Local Trait Extending Foreign Type
    #
    # Tests the extension trait pattern.

    it "extension trait on foreign type":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-018
        step("Verify: extension trait on foreign type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait StringExt:
            fn shout() -> text

        impl StringExt for text:
            fn shout() -> text:
                self.upper() + "!"

        expect "hello".shout() == "HELLO!"

    it "generic extension trait":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-019
        step("Verify: generic extension trait")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait SliceExt<T>:
            fn first_or_default(default: T) -> T

        impl<T> SliceExt<T> for [T]:
            fn first_or_default(default: T) -> T:
                if self.?:
                    self[0]
                else:
                    default

        val arr = [1, 2, 3]
        expect arr.first_or_default(0) == 1

        val empty: [i64] = []
        expect empty.first_or_default(42) == 42


