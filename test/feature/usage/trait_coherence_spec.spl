# ============================================================================

describe "Blanket Impl Conflict":
    # ## Generic Impl Conflicts
    #
    # Tests that blanket impls conflict with specific impls.

    it "specific impl alone works":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: specific impl alone works")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Serialize:
            fn serialize() -> text

        impl Serialize for i64:
            fn serialize() -> text:
                "i64"

        val x: i64 = 42
        expect x.serialize() == "i64"


