        step("Verify: impl on generic type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait Container:
            fn size() -> i64

        impl<T> Container for [T]:
            fn size() -> i64:
                self.len()

        val arr = [1, 2, 3, 4, 5]
        expect arr.size() == 5


