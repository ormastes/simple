"""
## Purpose and audience

# Trait Coherence Specification

**Feature IDs:** #TRAIT-COH-001 to #TRAIT-COH-017
**Category:** Type System | Traits
**Status:** Implemented

Tests trait coherence rules including:
- Orphan rule enforcement
- Overlap detection
- Blanket impl conflicts
- Associated type coherence
- Specialization with @default

## Coherence Rules

1. **Orphan Rule**: Either trait OR type must be local
2. **Overlap Rule**: No two impls for same trait+type
3. **Blanket Conflict**: Generic impl conflicts with specific
4. **Associated Types**: Same type must be declared consistently

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/trait_coherence_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Orphan Rule - Allowed Cases
# ============================================================================

describe "Orphan Rule - Allowed Cases":
    # ## Local Trait or Local Type
    #
    # Tests that orphan rule allows local trait + foreign type.

    it "allows local trait on foreign type":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: allows local trait on foreign type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait MyTrait:
            fn process() -> i64

        impl MyTrait for text:
            fn process() -> i64:
                42

        expect "test".process() == 42

    it "allows foreign trait on local type":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: allows foreign trait on local type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        struct MyType:
            value: i64

        impl Display for MyType:
            fn to_string() -> text:
                "MyType"

        val t = MyType(value: 42)
        expect t.to_string() == "MyType"

    it "allows local trait on local type":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: allows local trait on local type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        trait LocalTrait:
            fn get() -> i64

        struct LocalType:
            x: i64

        impl LocalTrait for LocalType:
            fn get() -> i64:
                self.x

        val t = LocalType(x: 42)
        expect t.get() == 42


