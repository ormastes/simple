describe "Negative Indexing":
    # ## Negative Index Access
    #
    # Tests for arr[-1] style negative indexing.

    it "accesses last element with -1":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-038
        step("Verify: accesses last element with -1")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [10, 20, 30, 40, 50]
        expect arr[-1] == 50

    it "accesses second from end with -2":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-039
        step("Verify: accesses second from end with -2")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [1, 2, 3, 4, 5]
        expect arr[-2] == 4

    it "accesses string with negative index":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-040
        step("Verify: accesses string with negative index")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val s = "hello"
        val c = s[-1]
        var result = 0
        if c == "o":
            result = 1
        expect result == 1


