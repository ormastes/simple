describe "Tuple Basics":
    # ## Tuple Literal and Operations
    #
    # Tests for tuple creation and access.

    it "creates tuple literal and accesses by index":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: creates tuple literal and accesses by index")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t = (10, 20, 30)
        expect t[1] == 20

    it "gets tuple length":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: gets tuple length")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t = (1, 2, 3, 4)
        expect t.len() == 4

    it "destructures tuple":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: destructures tuple")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val _tuple = (10, 20, 30)
        val a = _tuple[0]
        val b = _tuple[1]
        val c = _tuple[2]
        expect a + b + c == 60


