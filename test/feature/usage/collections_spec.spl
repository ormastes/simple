describe "Slicing":
    # ## Array and String Slicing
    #
    # Tests for [start:end:step] slice syntax.

    it "slices with start and end":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-034
        step("Verify: slices with start and end")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [0, 1, 2, 3, 4, 5]
        val sub = arr[1:4]
        expect sub.len() == 3

    it "slices from start index to end":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-035
        step("Verify: slices from start index to end")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [0, 1, 2, 3, 4]
        val sub = arr[2:]
        expect sub[0] == 2

    it "slices from beginning to end index":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-036
        step("Verify: slices from beginning to end index")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [0, 1, 2, 3, 4]
        val sub = arr[:3]
        expect sub.len() == 3

    it "slices with step":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-037
        step("Verify: slices with step")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [0, 1, 2, 3, 4, 5, 6, 7]
        val evens = arr[::2]
        expect evens.len() == 4


