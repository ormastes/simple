describe "Dictionary Methods":
    # ## Dict Set, Remove, Merge, and Get Operations
    #
    # Tests for dictionary modification and access.

    it "sets new key in dict":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-026
        step("Verify: sets new key in dict")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var d = {"a": 1}
        d = d.set("b", 2)
        expect d["b"] == 2

    it "removes key from dict":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-027
        step("Verify: removes key from dict")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var d = {"a": 1, "b": 2}
        d = d.remove("a")
        expect d.len() == 1

    it "merges two dicts":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-028
        step("Verify: merges two dicts")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var d1 = {"a": 1}
        val d2 = {"b": 2}
        val d = d1.merge(d2)
        expect d.len() == 2

    it "gets with default value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-029
        step("Verify: gets with default value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val d = {"a": 10}
        expect d.get_or("b", 99) == 99


# ============================================================================
# Test Group 8: List Comprehension
