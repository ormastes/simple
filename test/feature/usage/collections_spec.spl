# ============================================================================
# Test Group 6: Array Functional Methods
# ============================================================================

describe "Array Functional Methods":
    # ## Map, Filter, Reduce, and Other Functional Operations
    #
    # Tests for functional array methods.

    it "maps array elements":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-019
        step("Verify: maps array elements")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [1, 2, 3]
        val doubled = arr.map(_ * 2)
        expect doubled[1] == 4

    it "filters array elements":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: filters array elements")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [1, 2, 3, 4, 5]
        val evens = arr.filter(_ % 2 == 0)
        expect evens.len() == 2

    it "reduces array to single value":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-021
        step("Verify: reduces array to single value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [1, 2, 3, 4, 5]
        val sum = arr.reduce(0, \acc, x: acc + x)
        expect sum == 15

    it "checks all elements match predicate":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-022
        step("Verify: checks all elements match predicate")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [2, 4, 6]
        val all_even = arr.all(_1 % 2 == 0)
        var result = 0
        if all_even:
            result = 1
        expect result == 1

    it "joins array elements to string":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-023
        step("Verify: joins array elements to string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [1, 2, 3]
        val s = arr.join("-")
        var result = 0
        if s == "1-2-3":
            result = 1
        expect result == 1

    it "sums array elements":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-024
        step("Verify: sums array elements")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [1, 2, 3, 4, 5]
        expect arr.sum() == 15

    it "reverses array":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-025
        step("Verify: reverses array")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [1, 2, 3]
        val rev = arr.reverse()
        expect rev[0] == 3


