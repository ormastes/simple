        expect c.len() == 5

    it "spreads with mixed elements":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-042
        step("Verify: spreads with mixed elements")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = [2, 3]
        var arr = [1, *a, 4]
        expect arr[2] == 3


# ============================================================================
# Test Group 13: Tuple Unpacking
# ============================================================================

describe "Tuple Unpacking":
    # ## Tuple Destructuring Assignment
    #
    # Tests for let (a, b) = tuple syntax.

    it "unpacks basic tuple":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-043
        step("Verify: unpacks basic tuple")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val _pair = (1, 2)
        val x = _pair[0]
        val y = _pair[1]
        expect x + y == 3

    it "unpacks with swap pattern":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-044
        step("Verify: unpacks with swap pattern")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 10
        val b = 20
        val _swap = (b, a)
        val x = _swap[0]
        val y = _swap[1]
        expect x == 20

    it "unpacks array to tuple":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-045
        step("Verify: unpacks array to tuple")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [5, 10, 15]
        val first = arr[0]
        val second = arr[1]
        val third = arr[2]
        expect second == 10


# ============================================================================
# Test Group 14: Chained Comparisons
# ============================================================================

describe "Chained Comparisons":
    # ## Python-style Chained Comparisons
    #
    # Tests for a < x < b style comparisons.

    it "evaluates basic chained comparison":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-046
        step("Verify: evaluates basic chained comparison")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 5
        var result = 0
        if 0 < x < 10:
            result = 1
        expect result == 1

    it "evaluates false chained comparison":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-047
        step("Verify: evaluates false chained comparison")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 15
        var result = 0
        if 0 < x < 10:
            result = 1
        expect result == 0

    it "evaluates three-way comparison":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-048
        step("Verify: evaluates three-way comparison")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 1
        val b = 5
        val c = 10
        var result = 0
        if a < b < c:
            result = 1
        expect result == 1

    it "evaluates mixed comparison operators":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-049
        step("Verify: evaluates mixed comparison operators")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 5
        var result = 0
        if 0 <= x <= 10:
            result = 1
        expect result == 1


# ============================================================================
# Test Group 15: Context Managers
# ============================================================================

describe "Context Managers":
    # ## With Statement
    #
    # Tests for with statement context managers.

    it "executes basic with block":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-050
        step("Verify: executes basic with block")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var counter = 0
        with 42:
            counter = 1
        expect counter == 1

    it "binds resource with as":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-051
        step("Verify: binds resource with as")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        with 42 as x:
            val value = x + 1
        expect value == 43

    it "calls __enter__ and __exit__ on class":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-052
        step("Verify: calls __enter__ and __exit__ on class")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        class Resource:
            value: i64 = 0

            fn __enter__(self):
                return self.value + 10

            fn __exit__(self):
                return 0

        val r = Resource(value: 5)
        with r as v:
            val ret_value = v
        expect ret_value == 15


# ============================================================================
# Test Group 16: Decorators
# ============================================================================

describe "Decorators":
    # ## Function Decorators
    #
    # Tests for @decorator syntax.

    it "applies basic decorator":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-053
        step("Verify: applies basic decorator")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn double_result(f):
            fn wrapper(x):
                return f(x) * 2
            return wrapper

        @double_result
        fn add_one(x):
            return x + 1

        expect add_one(5) == 12

    it "applies decorator with arguments":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-054
        step("Verify: applies decorator with arguments")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn multiply_by(factor):
            fn decorator(f):
                fn wrapper(x):
                    return f(x) * factor
                return wrapper
            return decorator

        @multiply_by(3)
        fn increment(x):
            return x + 1

        expect increment(10) == 33
