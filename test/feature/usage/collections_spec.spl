"""
## Purpose and audience

# Collections Specification


**Feature ID:** #COLLECTIONS-001
**Category:** Language | Collections
**Status:** Implemented

## Overview

Tests for collection types including arrays, tuples, dictionaries, and strings.
Covers basic operations, functional methods, comprehensions, slicing, and spread operators.

## Syntax

```simple
var arr = [1, 2, 3]                    # Array literal
val t = (10, 20, 30)                   # Tuple literal
val d = {"a": 1, "b": 2}               # Dictionary literal
val doubled = arr.map(_1 * 2)          # Functional method
val squares = [x * x for x in arr]    # List comprehension
val sub = arr[1:4]                     # Slicing
val last = arr[-1]                     # Negative indexing
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/collections_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Array Basics
# ============================================================================

describe "Array Basics":
    # ## Array Literal and Basic Operations
    #
    # Tests for array creation and basic access methods.

    it "creates array literal and accesses by index":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: creates array literal and accesses by index")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [1, 2, 3, 4, 5]
        expect arr[2] == 3

    it "gets array length":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: gets array length")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [10, 20, 30]
        expect arr.len() == 3

    it "gets first and last elements":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: gets first and last elements")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [5, 10, 15, 20]
        expect arr.first() + arr.last() == 25

    it "checks if array contains element":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: checks if array contains element")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [1, 2, 3]
        var result = 0
        if arr.contains(2):
            result = 1
        expect result == 1

    it "checks if array is empty":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: checks if array is empty")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = []
        var result = 0
        if arr.is_empty():
            result = 1
        expect result == 1


