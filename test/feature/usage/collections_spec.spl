describe "List Comprehension":
    # ## List Comprehension Syntax
    #
    # Tests for [expr for x in iterable] syntax.

    it "creates list with basic comprehension":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-030
        step("Verify: creates list with basic comprehension")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [1, 2, 3, 4, 5]
        val doubled = [x * 2 for x in arr]
        expect doubled[2] == 6

    it "creates list with condition":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-031
        step("Verify: creates list with condition")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [1, 2, 3, 4, 5, 6]
        val evens = [x for x in arr if x % 2 == 0]
        expect evens.len() == 3

    it "creates squares list":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-032
        step("Verify: creates squares list")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val squares = [x * x for x in [1, 2, 3, 4]]
        expect squares[3] == 16


