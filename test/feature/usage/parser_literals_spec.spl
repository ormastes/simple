"""
## Purpose and audience

# Parser Literal Tokenization Specification


**Feature IDs:** #PARSER-LIT-001 to #PARSER-LIT-020
**Category:** Infrastructure | Parser
**Status:** Implemented

Tests that the parser correctly tokenizes and parses various literal types
including integers, floats, strings, booleans, symbols, and nil.

## Syntax

```simple
42              # Integer
0xFF            # Hex integer
0b1010          # Binary integer
0o77            # Octal integer
3.14            # Float
1.0e10          # Scientific notation
"hello"         # Interpolated string
'raw'           # Raw string
r"raw\n"        # Raw string (r prefix)
true false      # Booleans
nil             # Nil value
:symbol         # Symbol literal
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/parser_literals_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Integer Literals
# ============================================================================

describe "Integer Literal Parsing":
    # ## Decimal, Hex, Binary, Octal
    #
    # Tests that integer literals in various bases are correctly parsed.

    context "decimal integers":
        it "parses simple decimal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: parses simple decimal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 42
            expect x == 42

        it "parses zero":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: parses zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 0
            expect x == 0

        it "parses with underscores":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: parses with underscores")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 1_000_000
            expect x == 1000000

        it "parses large numbers":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: parses large numbers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 9_223_372_036_854_775_807
            expect x > 0

    context "hexadecimal integers":
        it "parses hex with lowercase":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: parses hex with lowercase")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 0xff
            expect x == 255

        it "parses hex with uppercase":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: parses hex with uppercase")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 0xFF
            expect x == 255

        it "parses complex hex":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: parses complex hex")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 0x1A2B
            expect x == 6699

    context "binary integers":
        it "parses simple binary":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: parses simple binary")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 0b1010
            expect x == 10

        it "parses binary with underscores":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: parses binary with underscores")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 0b1111_0000
            expect x == 240

        it "parses single bit":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: parses single bit")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 0b1
            expect x == 1

    context "octal integers":
        it "parses octal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: parses octal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 0o77
            expect x == 63

        it "parses octal with zeros":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: parses octal with zeros")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 0o755
            expect x == 493


# ============================================================================
# Test Group 2: Float Literals
# ============================================================================

describe "Float Literal Parsing":
    # ## Decimal and Scientific Notation
    #
    # Tests floating point literal parsing including scientific notation.

    context "simple floats":
        it "parses decimal float":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: parses decimal float")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 3.14
            expect x > 3.0
            expect x < 4.0

        it "parses float with leading zero":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: parses float with leading zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 0.5
            expect x == 0.5

        it "parses whole number float":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: parses whole number float")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 1.0
            expect x == 1.0

    context "scientific notation":
        it "parses positive exponent":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: parses positive exponent")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 1.0e10
            expect x == 10000000000.0

        it "parses negative exponent":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: parses negative exponent")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 2.5e-3
            expect x < 0.003

        it "parses uppercase E":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: parses uppercase E")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 1.5E5
            expect x == 150000.0


# ============================================================================
# Test Group 3: String Literals
# ============================================================================

describe "String Literal Parsing":
    # ## Interpolated, Raw, and Triple-Quoted Strings
    #
    # Tests string literal parsing with escape sequences and interpolation.

    context "double-quoted strings (interpolated)":
        it "parses simple string":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-019
            step("Verify: parses simple string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = "hello"
            expect s == "hello"

        it "parses escape sequences":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-020
            step("Verify: parses escape sequences")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = "hello\nworld"
            expect s.contains("\n")

        it "parses tab escape":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-021
            step("Verify: parses tab escape")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = "tab\there"
            expect s.contains("\t")

        it "interpolates variables":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-022
            step("Verify: interpolates variables")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val name = "Alice"
            val s = "hello {name}"
            expect s == "hello Alice"

        it "interpolates expressions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-023
            step("Verify: interpolates expressions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 6
            val y = 7
            val s = "result: {x * y}"
            expect s == "result: 42"

        it "escapes braces":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-024
            step("Verify: escapes braces")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = "literal {{braces}}"
            expect s == r"literal {braces}"

    context "single-quoted strings (raw)":
        it "parses raw string":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-025
            step("Verify: parses raw string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = 'hello'
            expect s == "hello"

        it "does not process escapes":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-026
            step("Verify: does not process escapes")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = 'hello\nworld'
            expect s.contains("\\n")

        it "does not interpolate":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-027
            step("Verify: does not interpolate")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = '{name}'
            expect s == r"{name}"

    context "raw prefix strings":
        it "parses r-prefix string":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-028
            step("Verify: parses r-prefix string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = r"hello"
            expect s == "hello"

        it "keeps backslashes literal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-029
            step("Verify: keeps backslashes literal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = r"hello\nworld"
            expect s.contains("\\n")

        it "keeps braces literal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-030
            step("Verify: keeps braces literal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = r"{name}"
            expect s == r"{name}"

    context "triple-quoted strings":
        it "parses triple-quoted":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-031
            step("Verify: parses triple-quoted")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = """hello"""
            expect s == "hello"

        it "preserves newlines":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-032
            step("Verify: preserves newlines")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = """line1
line2"""
            expect s.contains("\n")

        it "does not interpolate by default":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-033
            step("Verify: does not interpolate by default")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = """{name}"""
            expect s == r"{name}"

    context "triple-quoted f-strings":
        it "parses f-prefix triple-quoted":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-034
            step("Verify: parses f-prefix triple-quoted")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = f"""hello"""
            expect s == "hello"

        it "interpolates in f-strings":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-035
            step("Verify: interpolates in f-strings")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val name = "world"
            val s = f"""hello {name}"""
            expect s == "hello world"


# ============================================================================
# Test Group 4: Boolean Literals
# ============================================================================

describe "Boolean Literal Parsing":
    # ## true and false Keywords
    #
    # Tests that boolean literals are correctly parsed.

    it "parses true":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-036
        step("Verify: parses true")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = true
        expect x == true

    it "parses false":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-037
        step("Verify: parses false")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = false
        expect x == false

    it "uses booleans in conditions":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-038
        step("Verify: uses booleans in conditions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val condition = true
        if condition:
            expect true
        else:
            expect false  # Should not reach


