        # @req: REQ-FEATURE-USAGE-040
        step("Verify: nil equals nil")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect nil == nil


# ============================================================================
# Test Group 6: Symbol Literals
# ============================================================================

describe "Symbol Literal Parsing":
    # ## :symbol Syntax
    #
    # Tests that symbol literals with colon prefix are correctly parsed.

    it "parses simple symbol":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-041
        step("Verify: parses simple symbol")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val s = :ok
        expect s == :ok

    it "parses symbol with underscore":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-042
        step("Verify: parses symbol with underscore")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val s = :error_code
        expect s == :error_code

    it "symbols are comparable":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-043
        step("Verify: symbols are comparable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect :ok == :ok
        expect :ok != :error


# ============================================================================
# Test Group 7: Collection Literals
# ============================================================================

describe "Collection Literal Parsing":
    # ## Arrays, Tuples, and Dictionaries
    #
    # Tests parsing of collection literal syntax.

    context "array literals":
        it "parses array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-044
            step("Verify: parses array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr = [1, 2, 3]
            expect arr.len() == 3

        it "parses empty array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-045
            step("Verify: parses empty array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr = []
            expect arr.len() == 0

        it "parses nested array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-046
            step("Verify: parses nested array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr = [[1, 2], [3, 4]]
            expect arr[0][1] == 2

    context "tuple literals":
        it "parses tuple":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-047
            step("Verify: parses tuple")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val t = (1, 2, 3)
            expect t.0 == 1

        it "parses unit tuple":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-048
            step("Verify: parses unit tuple")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val t = ()
            expect true  # Compiles successfully

        it "parses two-element tuple":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-049
            step("Verify: parses two-element tuple")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val t = (42, "hello")
            expect t.0 == 42

    context "dictionary literals":
        it "parses dictionary":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-050
            step("Verify: parses dictionary")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val d = {"a": 1, "b": 2}
            expect d["a"] == 1

        it "parses empty dictionary":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-051
            step("Verify: parses empty dictionary")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val d = {}
            expect d.len() == 0


# ============================================================================
# Test Group 8: Numeric Literal Edge Cases
# ============================================================================

describe "Numeric Literal Edge Cases":
    # ## Special Cases and Boundaries
    #
    # Tests edge cases in numeric literal parsing.

    it "parses negative integers":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-052
        step("Verify: parses negative integers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = -42
        expect x == -42

    it "parses negative floats":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-053
        step("Verify: parses negative floats")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = -3.14
        expect x < 0.0

    it "parses very small float":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-054
        step("Verify: parses very small float")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 0.000001
        expect x > 0.0

    it "parses integer with many underscores":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-055
        step("Verify: parses integer with many underscores")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 1_2_3_4_5
        expect x == 12345
