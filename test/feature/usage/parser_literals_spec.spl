describe "Nil Literal Parsing":
    # ## nil Keyword
    #
    # Tests that the nil literal is correctly parsed.

    it "parses nil":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
