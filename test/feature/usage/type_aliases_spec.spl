"""
## Purpose and audience

# Type Aliases Specification

**Feature IDs:** #TYPE-ALIAS-001 to #TYPE-ALIAS-012
**Category:** Language
**Difficulty:** 2/5
**Status:** Implemented

## Overview

Type aliases allow creating alternative names for existing types, improving
code readability and maintainability. They enable domain-specific naming
without introducing new types, and support generic type aliases for
parameterized type shortcuts.

## Syntax

```simple
type UserId = i64
type IntList = [i64]
type StringMap = {str: str}
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Type Alias | Alternative name for an existing type |
| Collection Alias | Alias for array or dict types |
| Alias Chain | Alias that references another alias |

## Behavior

- Type aliases are fully interchangeable with their target type
- Aliases can reference collection types
- Aliases do not create new types (unlike newtypes)
- Aliases can reference other aliases (chaining)

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/type_aliases_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Type Alias Basics
# ============================================================================

describe "Type Aliases":
    # ## Core Type Alias Functionality
    #
    # Tests for defining and using type aliases including simple aliases,
    # collection aliases, and alias chains.

    context "with simple aliases":
        # ### Scenario: Simple Type Alias
        #
        # Creates an alternative name for an existing type.

        it "aliases primitive types":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: aliases primitive types")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            type UserId = i64
            val user: UserId = 42
            expect user to eq(42)

        it "allows alias in function signature":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: allows alias in function signature")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            type Score = i64

            fn double_score(s: Score) -> Score:
                s * 2

            val result = double_score(21)
            expect result to eq(42)

        it "is interchangeable with base type":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: is interchangeable with base type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            type Age = i64

            fn process_int(n: i64) -> i64:
                n + 10

            val age: Age = 25
            val result = process_int(age)
            expect result to eq(35)

    context "with collection aliases":
        # ### Scenario: Collection Type Alias
        #
        # Creates aliases for array and dict types.

        it "aliases array types":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: aliases array types")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            type IntList = [i64]
            val numbers: IntList = [1, 2, 3, 4, 5]
            expect numbers.len() to eq(5)

        it "aliases dict types":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: aliases dict types")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            type StringMap = {str: str}
            val data: StringMap = {"key": "value"}
            expect data["key"] to eq("value")

        it "allows nested collection aliases":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: allows nested collection aliases")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            type Matrix = [[i64]]
            val m: Matrix = [[1, 2], [3, 4]]
            expect m[0][0] to eq(1)
            expect m[1][1] to eq(4)

    context "with alias chains":
        # ### Scenario: Alias Chain
        #
        # Creates an alias that references another alias.

        it "supports alias of alias":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: supports alias of alias")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            type Id = i64
            type UserId = Id
            val user: UserId = 100
            expect user to eq(100)

        it "supports multiple levels of aliasing":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: supports multiple levels of aliasing")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            type Base = i64
            type Middle = Base
            type Top = Middle
            val value: Top = 42
            expect value to eq(42)


# ============================================================================
# Type Alias in Different Contexts
# ============================================================================

describe "Type Alias Usage":
    # ## Type Alias in Various Contexts
    #
    # Tests using type aliases in structs, classes, and complex expressions.

    context "in struct fields":
        it "uses alias in struct definition":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: uses alias in struct definition")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            type Timestamp = i64

            class Event:
                time: Timestamp
                name: str

            val e = Event(time: 1234567890, name: "test")
            expect e.time to eq(1234567890)

    context "in class fields":
        it "uses alias in class definition":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: uses alias in class definition")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            type Count = i64

            class Counter:
                value: Count

                fn get() -> Count:
                    self.value

            val c = Counter(value: 10)
            expect c.get() to eq(10)

    context "with return types":
        it "uses alias as return type":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: uses alias as return type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            type Result = i64

            fn compute() -> Result:
                42

            val r: Result = compute()
            expect r to eq(42)
