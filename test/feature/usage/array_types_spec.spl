"""
## Purpose and audience

# Array Type System and Operations

**Feature ID:** #LANG-003
**Category:** Language
**Status:** Active

## Overview

Arrays are Simple's primary ordered collection type, supporting literal construction,
positive and negative indexing, slicing with `start:end:step` notation, and a full suite
of functional methods (`map`, `filter`, `reduce`, `all`, `join`, `sum`). This comprehensive
spec covers eight aspects of array behavior: basic creation and queries, mutation via `push`
and `concat`, functional transformations, Python-style slicing, negative indexing, the
spread operator (`*`) for array merging, list comprehensions with optional filter clauses,
and chained comparison expressions.

## Syntax

```simple
var arr = [1, 2, 3, 4, 5]
val doubled = arr.map(_1 * 2)
val sub = arr[1:4]
val evens = [x for x in arr if x % 2 == 0]
val merged = [*a, *b]
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Array Literal | `[1, 2, 3]` creates a dynamic array with inferred element type |
| Slicing | `arr[start:end:step]` extracts sub-arrays using Python-style notation |
| Spread Operator | `[*a, *b]` unpacks arrays inline to build a new merged array |
| List Comprehension | `[expr for x in iter if cond]` builds arrays with inline loops and filters |
| Functional Methods | `map`, `filter`, `reduce`, `all`, `join`, `sum` for declarative transforms |
| Negative Indexing | `arr[-1]` accesses elements from the end of the array |

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/array_types_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Array Basics
# ============================================================================

describe "Array Basics":
    # ## Array Literal and Indexing
    #
    # Tests for array creation, indexing, and basic operations.

    context "array literals":
        it "creates array from literal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: creates array from literal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3, 4, 5]
            expect arr[2] == 3

        it "gets array length":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: gets array length")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [10, 20, 30]
            expect arr.len() == 3

        it "gets first and last elements":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: gets first and last elements")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [5, 10, 15, 20]
            expect arr.first() + arr.last() == 25

    context "array queries":
        it "checks if array contains element":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: checks if array contains element")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            expect arr.contains(2)

        it "checks if array is empty":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: checks if array is empty")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = []
            expect arr.is_empty()

        it "checks non-empty array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: checks non-empty array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1]
            expect not arr.is_empty()


# ============================================================================
# Test Group 2: Array Modification
# ============================================================================

describe "Array Modification":
    # ## Array Mutation Operations
    #
    # Tests for push, concat, and other modifying operations.

    context "push and concat":
        it "pushes element to array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: pushes element to array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            arr = arr.push(4)
            expect arr[3] == 4

        it "concatenates two arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: concatenates two arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val a = [1, 2]
            val b = [3, 4]
            val c = a.concat(b)
            expect c.len() == 4

    context "reverse":
        it "reverses array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: reverses array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            val rev = arr.reverse()
            expect rev[0] == 3


# ============================================================================
# Test Group 3: Functional Methods
# ============================================================================

describe "Array Functional Methods":
    # ## Functional Programming on Arrays
    #
    # Tests for map, filter, reduce, and other functional operations.

    context "map":
        it "maps function over array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: maps function over array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            val doubled = arr.map(_ * 2)
            expect doubled[1] == 4

    context "filter":
        it "filters array by predicate":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: filters array by predicate")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3, 4, 5]
            val evens = arr.filter(_ % 2 == 0)
            expect evens.len() == 2

    context "reduce":
        it "reduces array with accumulator":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: reduces array with accumulator")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3, 4, 5]
            val sum = arr.reduce(0, \acc, x: acc + x)
            expect sum == 15

    context "all and any":
        it "checks all elements match predicate":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: checks all elements match predicate")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [2, 4, 6]
            val all_even = arr.all(_1 % 2 == 0)
            expect all_even

    context "join":
        it "joins array elements with separator":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: joins array elements with separator")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            val s = arr.join("-")
            expect s == "1-2-3"

    context "sum":
        it "sums numeric array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: sums numeric array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3, 4, 5]
            expect arr.sum() == 15


# ============================================================================
# Test Group 4: Slicing
# ============================================================================

describe "Array Slicing":
    # ## Python-Style Slice Syntax
    #
    # Tests for array slicing with start:end:step notation.

    context "basic slicing":
        it "slices with start and end":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: slices with start and end")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [0, 1, 2, 3, 4, 5]
            val sub = arr[1:4]
            expect sub.len() == 3

        it "slices from start index to end":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: slices from start index to end")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [0, 1, 2, 3, 4]
            val sub = arr[2:]
            expect sub[0] == 2

        it "slices from beginning to end index":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: slices from beginning to end index")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [0, 1, 2, 3, 4]
            val sub = arr[:3]
            expect sub.len() == 3

    context "step slicing":
        it "slices with step":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-019
            step("Verify: slices with step")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [0, 1, 2, 3, 4, 5, 6, 7]
            val evens = arr[::2]
            expect evens.len() == 4


# ============================================================================
# Test Group 5: Negative Indexing
# ============================================================================

describe "Negative Indexing":
    # ## Python-Style Negative Indices
    #
    # Tests for accessing elements from end of array.

    it "gets last element with -1":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: gets last element with -1")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [10, 20, 30, 40, 50]
        expect arr[-1] == 50

    it "gets second from end with -2":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-021
        step("Verify: gets second from end with -2")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [1, 2, 3, 4, 5]
        expect arr[-2] == 4


# ============================================================================
# Test Group 6: Spread Operator
# ============================================================================

describe "Array Spread Operator":
    # ## Spread Syntax for Arrays
    #
    # Tests for spreading arrays into other arrays.

    it "spreads arrays with *":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-022
        step("Verify: spreads arrays with *")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = [1, 2, 3]
        val b = [4, 5]
        val c = [*a, *b]
        expect c.len() == 5

    it "spreads array mixed with elements":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-023
        step("Verify: spreads array mixed with elements")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = [2, 3]
        var arr = [1, *a, 4]
        expect arr[2] == 3


# ============================================================================
# Test Group 7: List Comprehension
# ============================================================================

describe "List Comprehension":
    # ## Comprehension Syntax
    #
    # Tests for creating arrays with comprehension expressions.

    it "creates list from comprehension":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-024
        step("Verify: creates list from comprehension")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [1, 2, 3, 4, 5]
        val doubled = [x * 2 for x in arr]
        expect doubled[2] == 6

    it "filters with comprehension condition":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-025
        step("Verify: filters with comprehension condition")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = [1, 2, 3, 4, 5, 6]
        val evens = [x for x in arr if x % 2 == 0]
        expect evens.len() == 3

    it "creates squares with comprehension":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-026
        step("Verify: creates squares with comprehension")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val squares = [x * x for x in [1, 2, 3, 4]]
        expect squares[3] == 16


# ============================================================================
# Test Group 8: Chained Comparisons
# ============================================================================

describe "Chained Comparisons":
    # ## Python-Style Chained Comparisons
    #
    # Tests for a < b < c style comparisons.

    it "evaluates basic chained comparison":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-027
        step("Verify: evaluates basic chained comparison")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 5
        expect 0 < x and x < 10

    it "evaluates false chained comparison":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-028
        step("Verify: evaluates false chained comparison")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 15
        expect not (0 < x and x < 10)

    it "evaluates three-way comparison":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-029
        step("Verify: evaluates three-way comparison")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 1
        val b = 5
        val c = 10
        expect a < b and b < c

    it "evaluates mixed comparison operators":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-030
        step("Verify: evaluates mixed comparison operators")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 5
        expect 0 <= x and x <= 10
