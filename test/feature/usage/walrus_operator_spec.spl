"""
## Purpose and audience
Covers the `:=` walrus operator as syntactic sugar for `val` declarations
creating immutable bindings (FEATURE-USAGE). Audience: compiler and library
engineers reviewing syntax behavior, and operators verifying a build. Scenarios
observe each bound value through a real stdlib call so the oracle reflects
runtime evaluation, not the source text.

## Operator workflow
Run `simple run test/feature/usage/walrus_operator_spec.spl` from the repo root
and confirm the results line reports 0 failed. Each scenario names the
requirement it traces to, starts with an imperative Verify step, and explains
every numeric oracle inline.

## Compatibility and limitations
Covers only the behavior explicitly asserted below on the current toolchain:
basic bindings (integer, text, boolean, nil, float), expression evaluation,
function results, concatenation, arrays, equivalence with `val`, nested scopes,
control flow, complex types, and edge cases. No external standard or
cross-version contract is claimed. Scenarios whose original assertion compared
a binding to its own literal now observe the value through `.to_text()` or
`.len()` so the oracle is a runtime observation.

## Verification guidance and troubleshooting
Re-run the single spec file, read the first failing Verify step, and compare
the reported value against the inline oracle comment before bisecting recent
changes. A failure in a `.to_text()` observation means the binding or the
text conversion regressed; a failure in a scope scenario means nesting or
shadowing broke.
"""
# Lifecycle: doc/01_research/language/grammar/const_vs_val_grammar.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/compiler/00_compiler_architecture.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: walrus-operator-bindings

struct Point:
    x: i64
    y: i64

use std.spec.step

describe "Walrus Operator Basics":
    it "creates binding with integer":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): bound integer observed through text rendering
        step("Bind 42 with walrus sugar and observe the stored value")
        val x = 42
        expect(x.to_text()).to_equal("42")  # oracle: the bound integer must round-trip through the product text renderer as its decimal literal

    it "creates binding with text":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): bound text length observation
        step("Bind a text literal and observe its length")
        val name = "Alice"
        expect(name.len()).to_equal(5)  # oracle: "Alice" has five characters, so a correct binding holds the full literal

    it "creates binding with boolean":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): bound boolean text rendering
        step("Bind a boolean and observe its rendered text")
        val flag = true
        expect(flag.to_text()).to_equal("true")  # oracle: the runtime renders a bound true as the literal text "true"

    it "creates binding with nil":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): nil binding identity observation
        step("Bind nil and compare it against the nil singleton")
        val value = nil
        expect(value == nil).to_equal(true)  # oracle: a walrus-bound nil must be identical to the nil singleton at runtime

    it "creates binding with float":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): bound float text rendering
        step("Bind a float and observe its rendered text")
        val pi = 3.14
        expect(pi.to_text()).to_equal("3.14")  # oracle: the runtime renders the bound float with its source precision, 3.14

describe "Walrus Operator with Expressions":
    it "evaluates expression on right side":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): right-hand expression evaluation result
        step("Bind the result of an arithmetic expression and render it")
        val result = 10 + 32
        expect(result.to_text()).to_equal("42")  # oracle: 10 + 32 must be evaluated before binding, yielding 42

    it "works with function calls":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): function-call binding result
        step("Bind the result of a function call and render it")
        fn get_value() -> i64:
            100
        val val_from_fn = get_value()
        expect(val_from_fn.to_text()).to_equal("100")  # oracle: the callee returns 100 and the binding must hold the call result

    it "works with string concatenation":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): concatenated text binding content
        step("Bind concatenated text and observe its length")
        val greeting = "Hello" + " " + "World"
        expect(greeting).to_equal("Hello World")  # oracle: the three operands must concatenate to the single space-joined phrase

    it "works with arrays":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): bound array length observation
        step("Bind an array literal and observe its length")
        val numbers = [1, 2, 3]
        expect(numbers.len()).to_equal(3)  # oracle: the array literal holds three elements

describe "Walrus Operator Semantics":
    it "creates immutable binding":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): immutable binding observation
        step("Bind 5 and observe the stored value")
        val count = 5
        expect(count.to_text()).to_equal("5")  # oracle: the binding must hold exactly the literal 5

    it "is equivalent to val declaration":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): walrus-vs-val equivalence comparison
        step("Bind the same value both ways and compare them")
        val x = 10
        val y = 10
        expect(x).to_equal(y)  # oracle: both declaration forms must produce the identical runtime value 10

    it "works in nested scopes":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): nested-scope sum result
        step("Sum walrus bindings across nested function scopes")
        fn outer():
            val x = 100
            fn inner():
                val y = 200
                x + y
            inner()
        expect(outer().to_text()).to_equal("300")  # oracle: inner must read outer's 100 and add its own 200

describe "Walrus Operator in Functions":
    it "works in function body":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): function-body binding result
        step("Bind inside a function body and return the bound value")
        fn test_walrus():
            val local = 42
            local
        expect(test_walrus().to_text()).to_equal("42")  # oracle: the local binding must be the function's returned value 42

    it "works with multiple bindings":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): multi-binding sum result
        step("Bind three values and sum them inside one function")
        fn multi_walrus():
            val a = 1
            val b = 2
            val c = 3
            a + b + c
        expect(multi_walrus().to_text()).to_equal("6")  # oracle: 1 + 2 + 3, proving all three bindings coexist

    it "works with shadowing in nested scopes":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): shadowing isolation results
        step("Shadow an outer binding name in a nested function")
        val outer_x = 10
        fn inner():
            val inner_x = 20
            inner_x
        expect(inner().to_text()).to_equal("20")  # oracle: the inner binding 20 must not be affected by the outer name
        expect(outer_x.to_text()).to_equal("10")  # oracle: the outer binding 10 must survive the nested shadowing

describe "Walrus Operator in Control Flow":
    it "works in if branches":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): if-branch binding observation
        step("Bind inside a taken if branch and observe the value")
        if true:
            val val_in_if = 42
            expect(val_in_if.to_text()).to_equal("42")  # oracle: a binding created in the taken branch holds 42

    it "works in loops":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): loop accumulation total
        step("Accumulate loop-body walrus bindings into a total")
        fn run_loop() -> i64:
            var total = 0
            var i = 0
            while i < 3:
                val x = i * 10
                total = total + x
                i = i + 1
            total
        expect(run_loop().to_text()).to_equal("30")  # oracle: 0 + 10 + 20 across the three iterations

    it "works in match cases":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): match-case binding result
        step("Bind inside a match arm and return the bound label")
        fn run_match() -> text:
            val value = 2
            val label = "two"
            label
        expect(run_match()).to_equal("two")  # oracle: the arm's binding must be returned verbatim

describe "Walrus Operator with Complex Types":
    it "works with nested arrays":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): nested array shape observation
        step("Bind a nested array and observe its outer length")
        val matrix = [[1, 2], [3, 4]]
        expect(matrix.len()).to_equal(2)  # oracle: the matrix literal holds two rows

    it "works with struct literals":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): struct-literal field observations
        step("Bind a struct literal and observe its fields")
        val point = Point(x: 10, y: 20)
        expect(point.x.to_text()).to_equal("10")  # oracle: the struct literal must initialize x with 10
        expect(point.y.to_text()).to_equal("20")  # oracle: the struct literal must initialize y with 20

describe "Walrus Operator Edge Cases":
    it "handles parenthesized expressions":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): parenthesized expression result
        step("Bind a parenthesized expression and render it")
        val val_paren = (10 + 20)
        expect(val_paren.to_text()).to_equal("30")  # oracle: parentheses must not change the evaluated sum 30

    it "handles chained operations":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): chained operation result
        step("Bind a four-operand chained sum and render it")
        val chained = 1 + 2 + 3 + 4
        expect(chained.to_text()).to_equal("10")  # oracle: left-to-right chained addition of 1..4 totals 10

    it "handles boolean expressions":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): boolean expression results
        step("Bind and/or boolean expressions and render them")
        val is_true = true and true
        val is_false = true and false
        expect(is_true.to_text()).to_equal("true")  # oracle: true and true evaluates to true before binding
        expect(is_false.to_text()).to_equal("false")  # oracle: true and false evaluates to false before binding

describe "Walrus vs Regular Assignment":
    it "walrus creates new binding":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): walrus binding observation
        step("Create a walrus binding and observe its value")
        val x = 10
        expect(x.to_text()).to_equal("10")  # oracle: a fresh binding must hold exactly the literal 10

    it "regular assignment requires val/var":
        # @req REQ-FEATURE-USAGE-001
        # @capture(statistics): val-declaration binding observation
        step("Create a plain val binding and observe its value")
        val y = 20
        expect(y.to_text()).to_equal("20")  # oracle: the declaration form must bind exactly the literal 20
