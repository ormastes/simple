            skip

    context "Setup and teardown":
        it "runs setup before and teardown after context":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: runs setup before and teardown after context")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            skip

    context "Nested contexts":
        it "supports properly nested context blocks":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: supports properly nested context blocks")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            skip

    context "Exception handling in contexts":
        it "ensures cleanup even when exceptions occur":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: ensures cleanup even when exceptions occur")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            skip

    context "Context variables":
        it "maintains context-scoped variables":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: maintains context-scoped variables")
            # @capture: assertion outcomes retained in the spec Results output as evidence
