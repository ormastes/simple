"""
## Purpose and audience
Executable evidence for the drafted LANG-040 scoped context-block feature
(setup/teardown like Python's `with` or C++ RAII). Audience: language engineers
tracking LANG-040 and operators verifying that nothing has silently replaced
the drafted construct. Every scenario executes a real product call: the
absence tripwires probe plausible landing spots for the feature, the error-path
scenario observes the Option-based failure mechanism that exists today, and
the scoping scenario observes real lexical scope through a nested function.

## Operator workflow
Run `simple run test/feature/usage/context_blocks_spec.spl` from the repo root
and confirm the results line reports 0 failed. A green run means the drafted
context-block construct is still absent and no partial imitation has appeared.
When LANG-040 lands, port every scenario onto the real construct before this
spec can honestly assert its runtime semantics.

## Compatibility and limitations
The drafted `context "name":` scoped-execution construct does not exist in the
grammar (census 2026-09-06: the parser defines `context` only as a spec
grouping function in src/compiler_rust/parser/src/test_analyzer.rs GROUP_FUNCTIONS,
and no scoped-block module exists under src/lib or src/compiler/15.blocks).
Scenario bodies therefore assert documented absence or the nearest existing
mechanism, never an invented oracle. The spec runner's own before_each/after_each
hook state is not observably persistent across scenarios on the current runner,
so teardown ordering is not asserted here.

## Verification guidance and troubleshooting
A failure of an absence tripwire means a context-block implementation now
exists: port the scenario onto the real construct, record its setup/teardown
ordering as a capture, and drop the tripwire. A failure of the error-path or
scoping scenario means lexical scope or Option-based failure handling
regressed; re-run the single file and read the first failing Verify step.
"""
# Lifecycle: doc/01_research/language/grammar/statement_container_grammars.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/compiler/00_compiler_architecture.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: context-blocks-lang-040

# NOTE: defect (drafted feature absent) — LANG-040's scoped `context "name":`
# construct is not in the grammar. Census 2026-09-06: the parser knows
# `context` only as a spec grouping function
# (src/compiler_rust/parser/src/test_analyzer.rs:62 GROUP_FUNCTIONS) and
# src/compiler/15.blocks and src/lib/** hold no scoped-execution module.
# Scenarios 1-3 are fail-closed absence tripwires; scenario 4 observes the
# Option-based error path that exists today; scenario 5 observes real lexical
# scope. Unblock: land LANG-040, then port all five scenarios onto it.
use std.spec.step
use std.io_runtime.file_exists
use std.convert.try_parse_int

fn setup_context_absence_census() -> bool:
    file_exists("src/compiler/15.blocks/context_block.spl") or
        file_exists("src/lib/common/context_scope.spl") or
        file_exists("src/lib/nogc_sync_mut/context_scope.spl") or
        file_exists("src/lib/common/spec/scope_hook.spl") or
        file_exists("src/lib/nogc_sync_mut/io/context_hook.spl") or
        file_exists("src/compiler/15.blocks/nested_scope_block.spl")

describe "Context Blocks":
    context "Basic context execution":
        it "executes code within context scope":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): context-block module absence census
            step("Probe the tree for any drafted scoped-context module")
            val context_impl_present = setup_context_absence_census()
            expect(context_impl_present).to_be(false)  # oracle: LANG-040 is unimplemented; true would mean the spec must be ported before it can pass

    context "Setup and teardown":
        it "runs setup before and teardown after context":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): setup/teardown hook module absence census
            step("Probe the tree for any drafted setup/teardown scope hook")
            val hook_impl_present = setup_context_absence_census()
            expect(hook_impl_present).to_be(false)  # oracle: no with-statement-style hook module exists; true means LANG-040 partially landed

    context "Nested contexts":
        it "supports properly nested context blocks":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): nested-block construct absence census
            step("Probe the compiler block layer for a nested scoped construct")
            val nested_impl_present = setup_context_absence_census()
            expect(nested_impl_present).to_be(false)  # oracle: the block layer holds no scoped-block construct; true means the grammar grew one

    context "Exception handling in contexts":
        it "ensures cleanup even when exceptions occur":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): Option-based failure-path observation
            step("Run the today-mechanism: observe a failed parse surface as nil")
            val failed_parse = try_parse_int("not-a-number")
            expect(failed_parse).to_be_nil()  # oracle: Simple has no exceptions (Result/Option + ? by design), so the error path a cleanup hook would guard surfaces as nil
            step("Confirm the success path still yields the parsed value")
            val parsed_ok = try_parse_int("42")
            expect(parsed_ok.?.to_text()).to_equal("42")  # oracle: the control input must parse so the nil above is proven to be the failure branch, not a broken parser

    context "Context variables":
        it "maintains context-scoped variables":
            # @req REQ-SSPEC-FEATURE
            # @capture(statistics): lexical scope isolation observation
            step("Bind inside a nested function scope and return the bound value")
            fn scope_probe() -> text:
                val ctx_local = "inner-only"
                ctx_local
            expect(scope_probe()).to_equal("inner-only")  # oracle: the binding must live exactly inside the nested scope and be returned intact
