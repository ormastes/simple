"""
## Purpose and audience

# Mutable Collections by Default

**Feature ID:** #LANG-024
**Category:** Language
**Status:** Active

## Overview

Simple follows the design decision that collections (arrays and dicts) are mutable by
default, consistent with Python, JavaScript, and Java. Variables declared with `var`
can freely `push`, `pop`, `insert`, `remove`, `clear`, and use index assignment on
arrays and dicts without any special annotation. Even `val` bindings to collections
allow mutation of the collection contents (the binding is immutable, not the data).
This spec comprehensively validates all mutation operations on arrays and dicts,
sequential borrow patterns (read after write), and edge cases like empty collections.

## Syntax

```simple
var arr = [1, 2, 3]
arr.push(4)                # append element
arr.pop()                  # remove and return last
arr.insert(1, 2)           # insert at index
arr.remove(0)              # remove at index
arr[1] = 10                # index assignment
arr.clear()                # remove all elements

var dict = {"a": 1}
dict["b"] = 2              # add new key
dict["a"] = 10             # update existing key
dict.remove("a")           # remove key
dict.clear()               # remove all entries
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Mutable by default | Arrays and dicts support mutation without explicit mutability annotations |
| `var` vs `val` binding | `var` allows rebinding; `val` prevents rebinding but both allow collection mutation |
| Array mutations | `push`, `pop`, `insert`, `remove`, `clear`, and index assignment |
| Dict mutations | Key assignment (`dict[k] = v`), `remove`, and `clear` |
| Sequential borrows | Reading after writing (e.g., `arr.push(4)` then `arr[3]`) works correctly |
| Empty collection edge cases | Pushing to `[]`, popping from `[1]`, inserting into `{}` all behave correctly |

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/mutable_by_default_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Mutable Collections by Default":

    context "Array Mutability":
        it "allows push on default arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: allows push on default arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            arr.push(4)
            expect arr[3] == 4
            expect arr.len() == 4

        it "allows pop on default arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: allows pop on default arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            val last = arr.pop()
            expect last == 3
            expect arr.len() == 2

        it "allows multiple pops":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: allows multiple pops")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3, 4, 5]
            arr.pop()
            arr.pop()
            expect arr[2] == 3
            expect arr.len() == 3

        it "allows insert on default arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: allows insert on default arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 3]
            arr.insert(1, 2)
            expect arr[1] == 2
            expect arr.len() == 3

        it "allows insert at beginning":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: allows insert at beginning")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [2, 3]
            arr.insert(0, 1)
            expect arr[0] == 1

        it "allows insert at end":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: allows insert at end")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2]
            arr.insert(2, 3)
            expect arr[2] == 3

        it "allows remove on default arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: allows remove on default arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            val removed = arr.remove(1)
            expect removed == 2
            expect arr.len() == 2

        it "allows remove first element":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: allows remove first element")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            val removed = arr.remove(0)
            expect removed == 1
            expect arr[0] == 2

        it "allows remove last element":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: allows remove last element")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            val removed = arr.remove(2)
            expect removed == 3
            expect arr.len() == 2

        it "allows clear on default arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: allows clear on default arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            arr.clear()
            expect arr.len() == 0

        it "allows indexing assignment":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: allows indexing assignment")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            arr[1] = 10
            expect arr[1] == 10

        it "allows indexing assignment at boundaries":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: allows indexing assignment at boundaries")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            arr[0] = 10
            arr[2] = 30
            expect arr[0] == 10
            expect arr[2] == 30

    context "Dict Mutability":
        it "allows insert on default dicts":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: allows insert on default dicts")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var dict = {"a": 1}
            dict["b"] = 2
            expect dict["b"] == 2

        it "allows update existing key":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: allows update existing key")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var dict = {"a": 1}
            dict["a"] = 10
            expect dict["a"] == 10

        it "allows remove on default dicts":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: allows remove on default dicts")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var dict = {"a": 1, "b": 2}
            dict.remove("a")
            expect dict.len() == 1

        it "allows clear on default dicts":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: allows clear on default dicts")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var dict = {"a": 1, "b": 2}
            dict.clear()
            expect dict.len() == 0

    context "var binding with mutable collection":
        it "allows mutation with var binding":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: allows mutation with var binding")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            arr.push(4)
            expect arr[3] == 4
            expect arr.len() == 4

        it "allows pop with var binding":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: allows pop with var binding")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            arr.pop()
            expect arr.len() == 2

        it "works with dict and val binding":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-019
            step("Verify: works with dict and val binding")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"a": 1}
            dict["b"] = 2
            expect dict["b"] == 2

    context "Sequential operations":
        it "handles sequential borrows":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-020
            step("Verify: handles sequential borrows")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            val len = arr.len()
            expect len == 3
            arr.push(4)
            expect arr.len() == 4

        it "allows read after write":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-021
            step("Verify: allows read after write")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1, 2, 3]
            arr.push(4)
            val last = arr[3]
            expect last == 4

    context "Empty collection mutations":
        it "allows push to empty array":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-022
            step("Verify: allows push to empty array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = []
            arr.push(1)
            expect arr[0] == 1
            expect arr.len() == 1

        it "handles pop from singleton":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-023
            step("Verify: handles pop from singleton")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = [1]
            val elem = arr.pop()
            expect elem == 1
            expect arr.len() == 0

        it "allows insert into empty dict":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-024
            step("Verify: allows insert into empty dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var dict = {}
            dict["key"] = "value"
            expect dict["key"] == "value"
