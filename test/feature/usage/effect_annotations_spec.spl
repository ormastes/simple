"""
## Purpose and audience

# Effect Annotations Specification


**Feature IDs:** #EFFECT-ANN-001 to #EFFECT-ANN-012
**Category:** Type System | Effects
**Status:** Implemented

Tests that effect annotations (@pure, @io, @net, @fs, @unsafe, @async)
are correctly parsed and applied to functions.

## Effect Types

- `@pure` - No side effects, referentially transparent
- `@io` - Console/terminal I/O operations
- `@net` - Network operations
- `@fs` - File system operations
- `@unsafe` - Unsafe memory operations
- `@async` - Asynchronous operations

## Syntax

```simple
@pure
fn add(x: i64, y: i64) -> i64:
x + y

@io @net
fn fetch_and_log(url: text):
val data = http_get(url)
print(data)
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/effect_annotations_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.effects.{Effect}
use std.spec.{step}


# ============================================================================
# Test Group 1: Single Effect Annotations
# ============================================================================

describe "Single Effect Annotations":
    # ## Basic Effect Decorators
    #
    # Tests that single effect decorators are correctly parsed.

    context "@pure effect":
        it "parses @pure on function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: parses @pure on function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            @pure
            fn add(x: i64, y: i64) -> i64:
                x + y
            expect add(20, 22) == 42

        it "pure function has no side effects":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: pure function has no side effects")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            @pure
            fn double(x: i64) -> i64:
                x * 2
            expect double(21) == 42

    context "@io effect":
        it "parses @io on function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: parses @io on function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            @io
            fn print_hello():
                print("Hello, World!")
            expect true  # Parsed successfully

    context "@net effect":
        it "parses @net on function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: parses @net on function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            @net
            fn fetch(url: text) -> text:
                "mock response"  # Placeholder
            expect true

    context "@fs effect":
        it "parses @fs on function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: parses @fs on function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            @fs
            fn read_file(path: text) -> text:
                "file contents"  # Placeholder
            expect true

    context "@unsafe effect":
        it "parses @unsafe on function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: parses @unsafe on function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            @unsafe
            fn raw_cast(ptr: i64) -> i64:
                ptr
            expect true

    context "@async effect":
        it "parses @async on function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: parses @async on function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            @async
            fn delayed_task():
                pass
            expect true


# ============================================================================
# Test Group 2: Multiple Effect Annotations
# ============================================================================

describe "Multiple Effect Annotations":
    # ## Combined Effects
    #
    # Tests that multiple effect decorators can be applied.

    it "parses two effects":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: parses two effects")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @io
        @net
        fn fetch_and_log(url: text):
            val data = "mock"
            print(data)
        expect true

    it "parses three effects":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: parses three effects")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @io
        @net
        @fs
        fn sync_remote_file(url: text, path: text):
            val data = "mock"
            print("Synced!")
        expect true

    it "parses io and fs together":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: parses io and fs together")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @io
        @fs
        fn log_to_file(path: text, message: text):
            print("Logging: {message}")
        expect true


# ============================================================================
# Test Group 3: No Effects
# ============================================================================

describe "Functions Without Effects":
    # ## Unrestricted Functions
    #
    # Tests that functions without effect annotations are unrestricted.

    it "function with no effects parses":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: function with no effects parses")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn unrestricted_function():
            print("Can do anything!")
        expect true

    it "no-effect function can call anything":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: no-effect function can call anything")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn flexible():
            val x = 42
            x
        expect flexible() == 42


# ============================================================================
# Test Group 4: Effects with Other Decorators
# ============================================================================

describe "Effects with Other Decorators":
    # ## Mixed Decorator Usage
    #
    # Tests effects combined with non-effect decorators.

    it "combines @pure with @inline":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: combines @pure with @inline")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @pure
        @inline
        fn fast_add(x: i64, y: i64) -> i64:
            x + y
        expect fast_add(20, 22) == 42

    it "combines @io with @deprecated":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: combines @io with @deprecated")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @io
        @deprecated
        fn old_print(msg: text):
            print(msg)
        expect true

    it "effects separate from other decorators":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: effects separate from other decorators")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        @pure
        @memoize
        fn cached_compute(x: i64) -> i64:
            x * x
        expect cached_compute(6) == 36


