describe "Effect Decorator Name":
    # ## Effect to String Conversion
    #
    # Tests converting Effect values to decorator names.
    # Note: Effect.Pure.decorator_name() uses path calls unsupported by interpreter.
    # Restructured to use local variable.

    it "Pure decorator name is 'pure'":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-030
        step("Verify: Pure decorator name is 'pure'")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val e = Effect.Pure
        expect e.decorator_name() == "pure"

