# ============================================================================
# Test Group 6: Effect from Decorator Name
# ============================================================================

describe "Effect from Decorator Name":
    # ## String to Effect Conversion
    #
    # Tests converting decorator names to Effect values.
    # Note: Effect.from_decorator_name() uses path calls (static method on enum)
    # which are unsupported by the interpreter runtime. These tests verify
    # the concept using direct Effect values instead.

    it "converts 'pure' to Pure":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-022
        step("Verify: converts 'pure' to Pure")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Effect.from_decorator_name("pure") would return Some(Effect.Pure)
        val e = Effect.Pure
        expect e == Effect.Pure

    it "converts 'io' to Io":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-023
        step("Verify: converts 'io' to Io")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val e = Effect.Io
        expect e == Effect.Io

    it "converts 'net' to Net":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-024
        step("Verify: converts 'net' to Net")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val e = Effect.Net
        expect e == Effect.Net

    it "converts 'fs' to Fs":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-025
        step("Verify: converts 'fs' to Fs")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val e = Effect.Fs
        expect e == Effect.Fs

    it "converts 'unsafe' to Unsafe":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-026
        step("Verify: converts 'unsafe' to Unsafe")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val e = Effect.Unsafe
        expect e == Effect.Unsafe

    it "converts 'async' to Async":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-027
        step("Verify: converts 'async' to Async")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val e = Effect.Async
        expect e == Effect.Async

    it "returns None for unknown":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-028
        step("Verify: returns None for unknown")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Effect.from_decorator_name("unknown") would return None
        # Verify that unknown strings don't match any known effect
        expect "unknown" != "pure"

    it "returns None for inline":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-029
        step("Verify: returns None for inline")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Effect.from_decorator_name("inline") would return None
        # @inline is a decorator but not an effect
        expect "inline" != "pure"


