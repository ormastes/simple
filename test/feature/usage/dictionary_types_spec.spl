"""
## Purpose and audience

# Dictionary Types Specification


**Feature IDs:** #1002
**Category:** Language
**Status:** In Progress

Tests for dictionary (map) types and their operations.
Verifies dictionary creation, access, modification, and iteration.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/dictionary_types_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
describe "Dictionary Types":
    # Tests for dictionary/map types and their fundamental operations.
    # Verifies creation, key-value access, modification, and iteration over dictionaries.

    context "dictionary creation":
        # ### Scenario: Creating Dictionaries
        #
        # Tests various ways to create dictionaries with different types.

        it "creates empty dictionary":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: creates empty dictionary")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val empty: Dict<text, i32> = {}
            expect empty.len() == 0

        it "creates dictionary with initial values":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: creates dictionary with initial values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"a": 1, "b": 2, "c": 3}
            expect dict.len() == 3

        it "creates dictionary with string keys and values":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: creates dictionary with string keys and values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"name": "Alice", "city": "NYC"}
            expect dict.len() == 2

    context "dictionary access":
        # ### Scenario: Accessing Dictionary Values
        #
        # Tests retrieving values by key and checking key existence.

        it "retrieves value by key":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: retrieves value by key")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"a": 1, "b": 2}
            expect dict["a"] == 1

        it "returns null for missing key":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: returns null for missing key")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"a": 1}
            val value = dict.get("missing")
            expect value == nil

        it "checks key existence":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: checks key existence")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"a": 1, "b": 2}
            expect dict.contains("a") == true
            expect dict.contains("c") == false

    context "dictionary modification":
        # ### Scenario: Modifying Dictionary Content
        #
        # Tests adding, updating, and removing entries.

        it "adds new key-value pair":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: adds new key-value pair")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var dict = {"a": 1}
            dict["b"] = 2
            expect dict["b"] == 2
            expect dict.len() == 2

        it "updates existing value":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: updates existing value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var dict = {"a": 1}
            dict["a"] = 10
            expect dict["a"] == 10
            expect dict.len() == 1

        it "removes entry by key":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: removes entry by key")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var dict = {"a": 1, "b": 2}
            dict.remove("a")
            expect dict.contains("a") == false
            expect dict.len() == 1

    context "dictionary iteration":
        # ### Scenario: Iterating Over Dictionaries
        #
        # Tests various ways to iterate through dictionary entries.

        it "iterates over keys":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: iterates over keys")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"a": 1, "b": 2, "c": 3}
            var count = 0
            for key in dict.keys():
                count = count + 1
            expect count == 3

        it "iterates over values":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-011
            step("Verify: iterates over values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"a": 1, "b": 2, "c": 3}
            var sum = 0
            for value in dict.values():
                sum = sum + value
            expect sum == 6

        it "iterates over entries":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-012
            step("Verify: iterates over entries")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"a": 1, "b": 2}
            var count = 0
            for entry in dict:
                count = count + 1
            expect count == 2

    context "dictionary methods":
        # ### Scenario: Dictionary Utility Methods
        #
        # Tests built-in dictionary methods for manipulation and inspection.

        it "gets dictionary size":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-013
            step("Verify: gets dictionary size")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"a": 1, "b": 2, "c": 3}
            expect dict.len() == 3

        it "checks if dictionary is empty":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-014
            step("Verify: checks if dictionary is empty")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val empty: Dict<text, i32> = {}
            val full = {"a": 1}
            expect empty.is_empty() == true
            expect full.is_empty() == false

        it "clears dictionary":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-015
            step("Verify: clears dictionary")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var dict = {"a": 1, "b": 2}
            dict.clear()
            expect dict.len() == 0
            expect dict.is_empty() == true

        it "creates copy of dictionary":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-016
            step("Verify: creates copy of dictionary")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val original = {"a": 1, "b": 2}
            val copy = original.clone()
            expect copy["a"] == 1
            expect copy.len() == original.len()

    context "dictionary with multiple types":
        # ### Scenario: Mixed Value Types
        #
        # Tests dictionaries with different value types.

        it "stores different value types":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-017
            step("Verify: stores different value types")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mixed = {"int": 1, "text": "hello", "float": 3.14}
            expect mixed.len() == 3

        it "accesses values with correct types":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-018
            step("Verify: accesses values with correct types")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"count": 5}
            val value = dict["count"]
            expect value == 5


# ============================================================================
# Functional Dictionary Methods
# ============================================================================

describe "Functional Dictionary Methods":
    # Tests for functional-style dictionary operations.

    context "set and merge":
        it "sets key with functional update":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-019
            step("Verify: sets key with functional update")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var d = {"a": 1}
            d["b"] = 2
            expect d["b"] == 2

        it "merges two dictionaries":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-020
            step("Verify: merges two dictionaries")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var d1 = {"a": 1}
            val d2 = {"b": 2}
            d1 = d1.merge(d2)
            expect d1.len() == 2

    context "get with default":
        it "gets value or default":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-021
            step("Verify: gets value or default")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val d = {"a": 10}
            expect d.get_or("b", 99) == 99

        it "gets existing value instead of default":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-022
            step("Verify: gets existing value instead of default")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val d = {"a": 10}
            expect d.get_or("a", 99) == 10


# ============================================================================
# Dictionary Comprehension
# ============================================================================

describe "Dictionary Comprehension":
    # Tests for dict comprehension syntax.

    it "creates dict from comprehension":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-023
        step("Verify: creates dict from comprehension")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val arr = [1, 2, 3]
        val d = {x: x * x for x in arr}
        expect d[2] == 4
