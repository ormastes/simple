        expect(gpu_stub_skip()).to_equal(true)

describe "GPU Info":
    it "generates GPU info string":
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: generates GPU info string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # GPU info generation requires GPU runtime
        expect(gpu_stub_skip()).to_equal(true)

    it "runs GPU smoke test":
        # @req: REQ-FEATURE-USAGE-017
        step("Verify: runs GPU smoke test")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(gpu_stub_skip()).to_equal(true)

    it "reports GPU is ready":
