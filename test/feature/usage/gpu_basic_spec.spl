        step("Verify: reports device validity correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(gpu_stub_skip()).to_equal(true)

    it "gets device name":
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: gets device name")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(gpu_stub_skip()).to_equal(true)

    it "gets device memory":
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: gets device memory")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(gpu_stub_skip()).to_equal(true)

