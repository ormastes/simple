        expect(gpu_stub_skip()).to_equal(true)

    it "allocates typed arrays":
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: allocates typed arrays")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(gpu_stub_skip()).to_equal(true)

describe "GPU Data Transfer":
    it "copies data to device":
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: copies data to device")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(gpu_stub_skip()).to_equal(true)

    it "copies data from device":
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: copies data from device")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(gpu_stub_skip()).to_equal(true)

describe "GPU Synchronization":
    it "synchronizes device":
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: synchronizes device")
