"""
## Purpose and audience

# Pattern Matching Specification

**Feature IDs:** #PATTERN-MATCH
**Category:** Language
**Status:** Implemented

Pattern matching provides a way to extract and deconstruct values using patterns.

## Key Behaviors

- Pattern matching deconstructs values into their components
- Variables bound in patterns are available in match arm bodies
- Patterns include literals, enums, tuples, records, and wildcards

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/pattern_matching_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Test Group 1: Basic Pattern Matching
# ============================================================================

describe "Basic Pattern Matching":
    # ## Literal and Wildcard Patterns
    #
    # Tests fundamental pattern matching with literals and wildcards.

    it "matches exact literal values":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: matches exact literal values")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn classify(x):
            match x:
                0 =>
                    return 0
                1 =>
                    return 1
                _ =>
                    return 99
        expect classify(0) == 0
        expect classify(1) == 1
        expect classify(42) == 99

    it "matches with wildcard pattern":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: matches with wildcard pattern")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn always_match(x):
            match x:
                _ =>
                    return 42
        expect always_match(100) == 42
        expect always_match(-1) == 42

    it "binds value to variable":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: binds value to variable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn double_it(x):
            match x:
                n =>
                    return n * 2
        expect double_it(5) == 10
        expect double_it(0) == 0


# ============================================================================
# Test Group 2: Tuple Pattern Matching
# ============================================================================

describe "Tuple Pattern Matching":
    # ## Tuple Destructuring
    #
    # Tests pattern matching on tuples.

    it "matches tuple and extracts elements":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: matches tuple and extracts elements")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn sum_pair(pair):
            match pair:
                (a, b) =>
                    return a + b
        expect sum_pair((10, 20)) == 30

    it "matches nested tuples":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: matches nested tuples")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn extract_first(nested):
            match nested:
                ((a, _), _) =>
                    return a
        expect extract_first(((5, 10), 20)) == 5

    it "matches with partial wildcard":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: matches with partial wildcard")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn get_first(pair):
            match pair:
                (x, _) =>
                    return x
        expect get_first((42, 100)) == 42


# ============================================================================
# Test Group 3: Enum Pattern Matching
# ============================================================================

describe "Enum Pattern Matching":
    # ## Enum Variant Matching
    #
    # Tests pattern matching on enum variants.

    it "matches Option Some variant":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: matches Option Some variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt = Some(42)
        var result = 0
        match opt:
            Some(x) =>
                result = x
            None =>
                result = -1
        expect result == 42

    it "matches Option None variant":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: matches Option None variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt = nil
        var result = 0
        match opt:
            Some(x) =>
                result = x
            None =>
                result = -1
        expect result == -1

    it "matches Result Ok variant":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: matches Result Ok variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val res = Ok(100)
        var result = 0
        match res:
            Ok(x) =>
                result = x
            Err(_) =>
                result = -1
        expect result == 100


# ============================================================================
# Test Group 4: Pattern Matching in Functions
# ============================================================================

describe "Pattern Matching in Functions":
    # ## Function Return with Match
    #
    # Tests pattern matching integrated with function returns.

    it "uses match as expression":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: uses match as expression")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn sign(x):
            return match x:
                n if n > 0 =>
                    1
                n if n < 0 =>
                    -1
                _ =>
                    0
        expect sign(10) == 1
        expect sign(-5) == -1
        expect sign(0) == 0

    it "matches multiple patterns":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: matches multiple patterns")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn is_special(x):
            match x:
                0 =>
                    return true
                1 =>
                    return true
                _ =>
                    return false
        expect is_special(0) == true
        expect is_special(1) == true
        expect is_special(5) == false

