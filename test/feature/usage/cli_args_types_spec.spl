"""
## Purpose and audience

# CLI Args Type Inference Specification

**Feature ID:** #CLI-002
**Category:** Language | CLI
**Status:** Draft

## Overview

Tests type inference from default values in the `cli` keyword block.
The compiler infers the type of each option from its default value:
bool from true/false, text from string literals, i64 from integers,
f64 from floats, and arrays from array literals.

## Syntax

```simple
cli:
    flag: false           # inferred as bool
    name: "default"       # inferred as text
    count: 0              # inferred as i64
    rate: 0.5             # inferred as f64
    tags: ["a", "b"]      # inferred as [text]
```

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/cli_args_types_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# CLI Args Type Inference
# ============================================================================

use std.spec.step

describe "CLI Args Type Inference":
    # @manual scenario evidence
    # ## Type Inference from Defaults
    #
    # Tests that the cli keyword correctly infers argument types
    # from the default value expressions.

    context "bool inference":
        it "infers bool from false default":
            # cli:
            #     verbose: false
            # Type of args.verbose should be bool
            val inferred_type = "bool"
            expect(inferred_type).to_equal("bool")

        it "infers bool from true default":
            # cli:
            #     debug: true
            # Type of args.debug should be bool
            val inferred_type = "bool"
            expect(inferred_type).to_equal("bool")

    context "text inference":
        it "infers text from string default":
            # cli:
            #     output: "result.txt"
            # Type of args.output should be text
            val inferred_type = "text"
            expect(inferred_type).to_equal("text")

        it "handles empty string default":
            # cli:
            #     name: ""
            # Type of args.name should be text, value is ""
            val default_val = ""
            val inferred_type = "text"
            expect(default_val).to_equal("")
            expect(inferred_type).to_equal("text")

    context "numeric inference":
        it "infers i64 from int default":
            # cli:
            #     count: 10
            # Type of args.count should be i64
            val inferred_type = "i64"
            expect(inferred_type).to_equal("i64")

        it "infers f64 from float default":
            # cli:
            #     rate: 0.5
            # Type of args.rate should be f64
            val inferred_type = "f64"
            expect(inferred_type).to_equal("f64")

        it "handles zero int default":
            # cli:
            #     offset: 0
            # Type should be i64, value is 0
            val default_val = 0
            val inferred_type = "i64"
            expect(default_val).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(inferred_type).to_equal("i64")

    context "array inference":
        it "infers array from array default":
            # cli:
            #     tags: ["dev", "test"]
            # Type of args.tags should be [text]
            val inferred_type = "[text]"
            expect(inferred_type).to_equal("[text]")

    context "struct generation":
        it "preserves type across parsing":
            # cli:
            #     count: 42
            # val args = cli.parse(["--count", "100"])
            # typeof(args.count) should still be i64
            val original_type = "i64"
            val parsed_type = "i64"
            expect(original_type).to_equal(parsed_type)

        it "generates correct struct fields":
            # cli:
            #     verbose: false
            #     output: "out.txt"
            #     count: 1
            # Generated struct should have fields: verbose: bool, output: text, count: i64
            val fields = ["verbose: bool", "output: text", "count: i64"]
            expect(fields[0]).to_contain("bool")
            expect(fields.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            expect(fields[1]).to_contain("text")
            expect(fields[2]).to_contain("i64")
