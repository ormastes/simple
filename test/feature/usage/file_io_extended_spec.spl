"""
## Purpose and audience

# Extended File I/O Specification

**Feature IDs:** #700-715
**Category:** Infrastructure
**Status:** Implemented

Extended File I/O operations including line-based reading, append operations,
binary I/O, file moving, recursive directory operations, and path utilities.

Self-contained: all I/O functions defined inline via extern fn declarations.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/file_io_extended_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# ============================================================================
# Extern Function Declarations (runtime built-ins)
# ============================================================================

extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_file_move(src: text, dst: text) -> bool
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

# ============================================================================
# Shell helper — calls rt_process_run and returns exit code, stdout, stderr
# ============================================================================

fn _shell_code(command: text) -> i64:
    val result = rt_process_run("/bin/sh", ["-c", command])
    result.2

fn _shell_out(command: text) -> text:
    val result = rt_process_run("/bin/sh", ["-c", command])
    result.0

# ============================================================================
# Error type
# ============================================================================

struct IoError:
    message: text

# ============================================================================
# File Operations (matching infra.* API)
# ============================================================================

fn write_file(path: text, content: text):
    rt_file_write_text(path, content)

fn read_file(path: text) -> Result<text, IoError>:
    if not rt_file_exists(path):
        return Err(IoError(message: "File not found: {path}"))
    val content = rt_file_read_text(path)
    Ok(content ?? "")

fn file_exist(path: text) -> bool:
    rt_file_exists(path)

fn remove_file(path: text):
    rt_file_delete(path)

fn read_lines(path: text) -> Result<[text], IoError>:
    if not rt_file_exists(path):
        return Err(IoError(message: "File not found: {path}"))
    val content = rt_file_read_text(path) ?? ""
    if content.len() == 0:
        return Ok([])
    Ok(content.split("\n"))

fn append_file(path: text, content: text) -> Result<(), IoError>:
    val escaped = content.replace("'", "'\\''")
    val code = _shell_code("printf '%s' '{escaped}' >> '{path}' 2>&1")
    if code == 0:
        Ok(())
    else:
        Err(IoError(message: "Failed to append to {path}"))

fn read_bytes(path: text) -> Result<[i64], IoError>:
    if not rt_file_exists(path):
        return Err(IoError(message: "File not found: {path}"))
    val code = _shell_code("od -An -td1 -v '{path}' 2>&1")
    if code != 0:
        return Err(IoError(message: "Failed to read bytes from {path}"))
    val output = _shell_out("od -An -td1 -v '{path}' 2>&1").trim()
    if output.len() == 0:
        return Ok([])
    var bytes: [i64] = []
    val parts = output.split(" ")
    for part in parts:
        val trimmed = part.trim()
        if trimmed.len() > 0:
            val byte_val = int(trimmed)
            if byte_val < 0:
                bytes.push(byte_val + 256)
            else:
                bytes.push(byte_val)
    Ok(bytes)

fn write_bytes(path: text, data: [i64]) -> Result<(), IoError>:
    var octal_str = ""
    for byte in data:
        val b = if byte < 0: byte + 256 else: byte
        val b_mod = b % 256
        val octal = _to_octal(b_mod)
        octal_str = octal_str + "\\{octal}"
    val code = _shell_code("printf '{octal_str}' > '{path}' 2>&1")
    if code == 0:
        Ok(())
    else:
        Err(IoError(message: "Failed to write bytes to {path}"))

fn _to_octal(n: i64) -> text:
    var num = n
    var digits: [i64] = []
    if num == 0:
        return "000"
    while num > 0:
        digits.push(num % 8)
        num = num / 8
    var result = ""
    var i = digits.len() - 1
    while i >= 0:
        result = result + "{digits[i]}"
        i = i - 1
    while result.len() < 3:
        result = "0" + result
    result

fn move_file(src: text, dest: text) -> Result<(), IoError>:
    if not rt_file_exists(src):
        return Err(IoError(message: "Source file not found: {src}"))
    val code = _shell_code("mv '{src}' '{dest}' 2>&1")
    if code == 0:
        Ok(())
    else:
        Err(IoError(message: "Failed to move {src} to {dest}"))

fn create_dir_all(path: text) -> Result<(), IoError>:
    val code = _shell_code("mkdir -p '{path}' 2>&1")
    if code == 0:
        Ok(())
    else:
        Err(IoError(message: "Failed to create directory {path}"))

fn create_dir(path: text) -> Result<(), IoError>:
    val code = _shell_code("mkdir '{path}' 2>&1")
    if code == 0:
        Ok(())
    else:
        Err(IoError(message: "Failed to create directory {path}"))

fn walk_dir(path: text) -> Result<[text], IoError>:
    val code = _shell_code("find '{path}' 2>&1")
    if code != 0:
        return Err(IoError(message: "Failed to walk directory {path}"))
    val out = _shell_out("find '{path}' 2>&1")
    val lines = out.split("\n")
    var entries: [text] = []
    for line in lines:
        val trimmed = line.trim()
        if trimmed.len() > 0 and trimmed != path:
            entries.push(trimmed)
    Ok(entries)

fn current_dir() -> text:
    val out = _shell_out("pwd 2>&1")
    out.trim()

fn remove_dir(path: text) -> Result<(), IoError>:
    val code = _shell_code("rmdir '{path}' 2>&1")
    if code == 0:
        Ok(())
    else:
        Err(IoError(message: "Failed to remove directory {path}"))

fn remove_dir_all(path: text) -> Result<(), IoError>:
    val code = _shell_code("rm -rf '{path}' 2>&1")
    if code == 0:
        Ok(())
    else:
        Err(IoError(message: "Failed to remove directory {path}"))

fn stem(path: text) -> text:
    # Use shell to extract filename without extension
    val base = _shell_out("basename '{path}'").trim()
    val has_dot = base.contains(".")
    if has_dot:
        # Get part before last dot
        val without_ext = _shell_out("echo '{base}' | rev | cut -d. -f2- | rev").trim()
        without_ext
    else:
        base

fn relative_path(target: text, base: text) -> text:
    if target == base:
        return ""
    if target.starts_with(base):
        val rel = target[base.len():]
        if rel.starts_with("/"):
            rel[1:]
        else:
            rel
    else:
        target

fn path_join(dir: text, file: text) -> text:
    if dir.ends_with("/"):
        dir + file
    else:
        dir + "/" + file

# ============================================================================
# Test Group 1: Line-Based File Reading
# ============================================================================

describe "read_lines":
    # Verifies line-based file reading that returns content as a list of strings,
    # splitting on newline characters. Handles both multi-line content and empty
    # files (returning an empty list).

    it "reads multiple lines correctly":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-001
        step("Verify: reads multiple lines correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val test_path = "/tmp/simple_test_multiline.txt"
        val content = "line1\nline2\nline3"
        write_file(test_path, content)

        val result = read_lines(test_path)
        expect result.is_ok() == true

        match result:
            Ok(lines):
                expect lines[0] == "line1"
                expect lines.len() == 3
                expect lines[1] == "line2"
                expect lines[2] == "line3"
            Err(_):
                fail("Should have read lines successfully")

        remove_file(test_path)

    it "reads empty file as empty list":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-002
        step("Verify: reads empty file as empty list")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val test_path = "/tmp/simple_test_empty_lines.txt"
        write_file(test_path, "")

        val result = read_lines(test_path)
        expect result.is_ok() == true

        match result:
            Ok(lines):
                expect lines.len() == 0
            Err(_):
                fail("Should have read empty file")

        remove_file(test_path)

# ============================================================================
# Test Group 2: Append File Operations
# ============================================================================

describe "append_file":
    # Verifies file append operations that add content to the end of existing
    # files or create new files if they don't exist. This enables log-style
    # writing and incremental file building.

    it "appends to existing file":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-003
        step("Verify: appends to existing file")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val test_path = "/tmp/simple_test_append.txt"
        write_file(test_path, "Hello")

        val result = append_file(test_path, ", World!")
        expect result.is_ok() == true

        val content = read_file(test_path)
        match content:
            Ok(text):
                expect text == "Hello, World!"
            Err(_):
                fail("Should have read appended file")

        remove_file(test_path)

    it "creates file if not exists":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-004
        step("Verify: creates file if not exists")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val test_path = "/tmp/simple_test_append_new.txt"

        if file_exist(test_path):
            remove_file(test_path)

        val result = append_file(test_path, "New content")
        expect result.is_ok() == true
        expect file_exist(test_path) == true

        val content = read_file(test_path)
        match content:
            Ok(text):
                expect text == "New content"
            Err(_):
                fail("Should have read new file")

        remove_file(test_path)

# ============================================================================
# Test Group 3: Binary I/O
# ============================================================================

describe "binary I/O":
    # Verifies binary file I/O operations (read_bytes and write_bytes) that
    # handle raw byte arrays without text encoding/decoding. Critical for
    # working with non-text files like images, executables, and data files.

    it "preserves binary data exactly":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-005
        step("Verify: preserves binary data exactly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val test_path = "/tmp/simple_test_binary.bin"
        val data = [0, 127, 255, 1, 128]

        val write_result = write_bytes(test_path, data)
        expect write_result.is_ok() == true

        val read_result = read_bytes(test_path)
        expect read_result.is_ok() == true

        match read_result:
            Ok(bytes):
                expect bytes[0] == 0
                expect bytes.len() == 5
                expect bytes[1] == 127
                expect bytes[2] == 255
                expect bytes[3] == 1
                expect bytes[4] == 128
            Err(_):
                fail("Should have read bytes")

        remove_file(test_path)

# ============================================================================
# Test Group 4: Move File
# ============================================================================

describe "move_file":
    # Verifies file move operations that atomically relocate a file from source
    # to destination path. The source file is removed after successful move.

    it "moves file to new location":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-006
        step("Verify: moves file to new location")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val src_path = "/tmp/simple_test_move_src.txt"
        val dest_path = "/tmp/simple_test_move_dest.txt"
        write_file(src_path, "content to move")

        if file_exist(dest_path):
            remove_file(dest_path)

        val result = move_file(src_path, dest_path)
        expect result.is_ok() == true
        expect file_exist(src_path) == false
        expect file_exist(dest_path) == true

        val content = read_file(dest_path)
        match content:
            Ok(text):
                expect text == "content to move"
            Err(_):
                fail("Should read moved file")

        remove_file(dest_path)

# ============================================================================
# Test Group 5: Directory Operations
# ============================================================================

describe "create_dir_all":
    # Verifies recursive directory creation that creates all missing parent
    # directories in a path. Similar to `mkdir -p` in shell.

    it "creates nested directories":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-007
        step("Verify: creates nested directories")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val nested_path = "/tmp/simple_test_nested/a/b/c"

        val result = create_dir_all(nested_path)
        expect result.is_ok() == true
        expect file_exist(nested_path) == true

        # Cleanup
        remove_dir("/tmp/simple_test_nested/a/b/c")
        remove_dir("/tmp/simple_test_nested/a/b")
        remove_dir("/tmp/simple_test_nested/a")
        remove_dir("/tmp/simple_test_nested")

describe "walk_dir":
    # Verifies recursive directory traversal that returns all files and
    # subdirectories under a given path. Useful for file discovery and
    # batch operations.

    it "returns all files recursively":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-008
        step("Verify: returns all files recursively")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val base = "/tmp/simple_test_walk"
        create_dir_all(base)
        write_file(base + "/file1.txt", "1")
        create_dir(base + "/sub")
        write_file(base + "/sub/file2.txt", "2")

        val result = walk_dir(base)
        expect result.is_ok() == true

        match result:
            Ok(entries):
                expect entries.len() >= 3
            Err(_):
                fail("Should walk directory")

        # Cleanup
        remove_file(base + "/sub/file2.txt")
        remove_dir(base + "/sub")
        remove_file(base + "/file1.txt")
        remove_dir(base)

describe "current_dir and set_current_dir":
    # Verifies working directory operations that get and set the current
    # working directory. Returns absolute paths for reliable path resolution.

    it "gets absolute path":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-009
        step("Verify: gets absolute path")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cwd = current_dir()
        expect cwd.len() > 0
        expect cwd.starts_with("/") == true

describe "remove_dir_all":
    # Verifies recursive directory removal that deletes a directory and all
    # its contents (files and subdirectories). Similar to `rm -rf` in shell.

    it "removes directory and contents":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-010
        step("Verify: removes directory and contents")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val base = "/tmp/simple_test_rmall"
        create_dir_all(base + "/sub/deep")
        write_file(base + "/file.txt", "content")
        write_file(base + "/sub/file2.txt", "content2")

        val result = remove_dir_all(base)
        expect result.is_ok() == true
        expect file_exist(base) == false

# ============================================================================
# Test Group 6: Path Operations
# ============================================================================

describe "stem":
    # Verifies path stem extraction that returns the filename without its
    # extension. Handles multiple dots and files without extensions.

    it "extracts filename without extension":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-011
        step("Verify: extracts filename without extension")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect stem("file.txt") == "file"

    it "handles multiple dots":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-012
        step("Verify: handles multiple dots")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect stem("archive.tar.gz") == "archive.tar"

    it "handles no extension":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-013
        step("Verify: handles no extension")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect stem("README") == "README"

describe "relative_path":
    # Verifies relative path computation that calculates the path from a base
    # directory to a target path. Returns empty string when paths are identical.

    it "computes relative path":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-014
        step("Verify: computes relative path")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect relative_path("/a/b/c/file.txt", "/a/b") == "c/file.txt"

    it "handles same path":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-015
        step("Verify: handles same path")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect relative_path("/a/b", "/a/b") == ""

describe "path_join":
    # Verifies path joining that combines directory and file components into
    # a complete path, handling separator insertion correctly.

    it "joins two paths":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-016
        step("Verify: joins two paths")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect path_join("/home/user", "file.txt") == "/home/user/file.txt"

# ============================================================================
# Error Handling Tests
# ============================================================================

describe "Error Handling":
    # Verifies proper error propagation for file I/O operations when files
    # or directories don't exist. All operations return Result types that
    # indicate failure with meaningful error information.

    it "read_lines fails for non-existent file":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-017
        step("Verify: read_lines fails for non-existent file")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = read_lines("/tmp/nonexistent_file_12345.txt")
        expect result.is_err() == true

    it "read_bytes fails for non-existent file":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-018
        step("Verify: read_bytes fails for non-existent file")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = read_bytes("/tmp/nonexistent_file_12345.bin")
        expect result.is_err() == true

    it "move_file fails for non-existent source":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-019
        step("Verify: move_file fails for non-existent source")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = move_file("/tmp/nonexistent_12345.txt", "/tmp/dest.txt")
        expect result.is_err() == true

    it "walk_dir fails for non-existent directory":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-USAGE-020
        step("Verify: walk_dir fails for non-existent directory")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = walk_dir("/tmp/nonexistent_dir_12345")
        expect result.is_err() == true
