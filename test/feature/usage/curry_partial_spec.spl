"""
## Purpose and audience

Curry and Partial Application

**Feature ID:** #FUNC-010
**Category:** Functional Programming
**Status:** Active

Standard library functions for currying and partial application.
`curry2(f)` converts a 2-arg function into nested single-arg lambdas.
`partial1(f, a)` fixes the first argument of a 2-arg function.

This specification is maintained for compiler and library engineers reviewing FEATURE-USAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/usage/curry_partial_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-FEATURE-USAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.common.functions.{curry2, curry3, partial1, partial2}
use std.spec.{step}

fn add(a: i64, b: i64) -> i64:
    a + b

fn mul(a: i64, b: i64) -> i64:
    a * b

fn triple_add(a: i64, b: i64, c: i64) -> i64:
    a + b + c

describe "Curry and Partial Application":

    context "curry2":
        it "curries a two-argument function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-001
            step("Verify: curries a two-argument function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val curried = curry2(add)
            val add5 = curried(5)
            expect add5(3) == 8

        it "curries multiply":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-002
            step("Verify: curries multiply")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val curried = curry2(mul)
            val double = curried(2)
            expect double(7) == 14

        it "applies both arguments":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-003
            step("Verify: applies both arguments")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val curried = curry2(add)
            expect curried(10)(20) == 30

    context "curry3":
        it "curries a three-argument function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-004
            step("Verify: curries a three-argument function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val curried = curry3(triple_add)
            expect curried(1)(2)(3) == 6

        it "partial application of curry3":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-005
            step("Verify: partial application of curry3")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val curried = curry3(triple_add)
            val add1 = curried(1)
            val add1_2 = add1(2)
            expect add1_2(10) == 13

    context "partial1":
        it "fixes first argument":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-006
            step("Verify: fixes first argument")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val add10 = partial1(add, 10)
            expect add10(5) == 15

        it "creates increment function":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-007
            step("Verify: creates increment function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val inc = partial1(add, 1)
            expect inc(99) == 100

        it "works with map":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-008
            step("Verify: works with map")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val add100 = partial1(add, 100)
            val data = [1, 2, 3]
            val result = data.map(add100)
            expect result == [101, 102, 103]

    context "partial2":
        it "fixes first two arguments":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-009
            step("Verify: fixes first two arguments")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val add1_2 = partial2(triple_add, 1, 2)
            expect add1_2(3) == 6

        it "fixes different values":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-FEATURE-USAGE-010
            step("Verify: fixes different values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val add10_20 = partial2(triple_add, 10, 20)
            expect add10_20(30) == 60
