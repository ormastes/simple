# Test that optimized bootstrap imports work

use std.mcp.session.{McpState}
use std.mcp.helpers.{LB, RB, get_clean_args, jp, js, jo3, extract_json_string_v2, extract_json_value, extract_nested_string, extract_arguments_dict, make_error_response, make_result_response}
use std.mcp.schema.{get_all_tool_schemas, init_core_schemas}
use std.text.{NL}

describe "MCP bootstrap imports":
    it "initializes the core tool schemas":
        init_core_schemas()
        val schemas = get_all_tool_schemas()
        expect(schemas.len() > 0).to_equal(true)

    it "creates an McpState":
        val state = McpState.create()
        expect(state != nil).to_equal(true)

    it "builds a JSON pair through the helpers surface":
        val pair = jp("key", "value")
        expect(pair.contains("key")).to_equal(true)
        expect(pair.contains("value")).to_equal(true)
