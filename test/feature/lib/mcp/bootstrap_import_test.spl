# Bootstrap import-surface checks for the optimized MCP server modules
#
# Converted 2026-08-17 from a print-only script whose "✗" branches printed and
# then exited 0, so every check was vacuous and the file could never go RED.
# Same checks, now asserted.

use std.nogc_async_mut.mcp.session.{McpState}
use std.nogc_async_mut.mcp.helpers.{LB, RB, get_clean_args, jp, js, jo3, extract_json_string_v2, extract_json_value, extract_nested_string, extract_arguments_dict, make_error_response, make_result_response}
use std.nogc_async_mut.mcp.schema.{get_all_tool_schemas, init_core_schemas}
use std.text.{NL}

describe "MCP bootstrap imports":
    it "returns a non-empty schema payload after init":
        init_core_schemas()
        expect(get_all_tool_schemas().len() > 0).to_equal(true)

    it "constructs an McpState":
        val state = McpState.create()
        expect(state).to_be_truthy()

    it "exposes working JSON helpers":
        val pair = jp("key", "value")
        expect(pair.contains("key")).to_equal(true)
        expect(pair.contains("value")).to_equal(true)
