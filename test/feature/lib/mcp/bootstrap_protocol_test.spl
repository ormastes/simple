# Real JSON-RPC protocol round-trip against the MCP bootstrap server
#
# Converted 2026-08-17 from a print-only script whose "✗" branches printed and
# then exited 0, so every check was vacuous and the file could never go RED.
# Same checks, now asserted.

use app.io.mod (file_write, shell)

describe "MCP bootstrap JSON-RPC protocol":
    it "answers initialize, tools/list and tools/call over stdio":
        val test_input = """Content-Length: 123

{"jsonrpc":"2.0","id":"1","method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{}}}
Content-Length: 50

{"jsonrpc":"2.0","id":"2","method":"tools/list"}
Content-Length: 145

{"jsonrpc":"2.0","id":"3","method":"tools/call","params":{"name":"simple_status","arguments":{"directory":"src/"}}}
"""
        file_write("/tmp/mcp_test_input.txt", test_input)
        val result = shell("bin/simple run src/app/mcp/main.spl < /tmp/mcp_test_input.txt 2>&1")
        val output = result.stdout ?? ""
        val exit_code = result.exit_code ?? 1

        expect(exit_code).to_equal(0)

        # initialize response
        expect(output.contains("protocolVersion")).to_equal(true)
        expect(output.contains("capabilities")).to_equal(true)
        # tools/list response
        expect(output.contains("tools")).to_equal(true)
        expect(output.contains("[")).to_equal(true)
        # tools/call response
        expect(output.contains("result") or output.contains("content")).to_equal(true)
        # no error lines
        expect(output.contains("error: ")).to_equal(false)
