# End-to-end checks of the optimized MCP bootstrap components
#
# Converted 2026-08-17 from a print-only script whose "✗" branches printed and
# then exited 0, so every check was vacuous and the file could never go RED.
# Same checks, now asserted.

use std.nogc_async_mut.mcp.session.{McpState}
use std.nogc_async_mut.mcp.helpers.{LB, RB, jp, js, jo3, extract_json_string_v2, extract_json_value, extract_nested_string, make_error_response, make_result_response}
use std.nogc_async_mut.mcp.schema.{get_all_tool_schemas, init_core_schemas}

describe "MCP bootstrap end-to-end components":
    it "initializes schemas into a substantial payload":
        init_core_schemas()
        expect(get_all_tool_schemas().len() > 100).to_equal(true)

    it "constructs an McpState":
        val state = McpState.create()
        expect(state).to_be_truthy()

    it "extracts a top-level string field":
        val test_json = """{"jsonrpc":"2.0","id":"1","method":"initialize","params":{"protocolVersion":"2024-11-05"}}"""
        expect(extract_json_string_v2(test_json, "method")).to_equal("initialize")

    it "extracts a raw top-level value":
        val test_json = """{"jsonrpc":"2.0","id":"1","method":"initialize","params":{"protocolVersion":"2024-11-05"}}"""
        expect(extract_json_value(test_json, "id").contains("1")).to_equal(true)

    it "extracts a nested string field":
        val test_json = """{"jsonrpc":"2.0","id":"1","method":"initialize","params":{"protocolVersion":"2024-11-05"}}"""
        expect(extract_nested_string(test_json, "params", "protocolVersion")).to_equal("2024-11-05")

    it "builds a jsonrpc response via the object builders":
        val init_result = """{"protocolVersion":"2025-06-18","capabilities":{"tools":{}}}"""
        val response = jo3(jp("jsonrpc", js("2.0")), jp("id", "1"), jp("result", init_result))
        expect(response.contains("jsonrpc")).to_equal(true)
        expect(response.contains("protocolVersion")).to_equal(true)

    it "builds an error response carrying the JSON-RPC code":
        val error_resp = make_error_response("1", -32601, "Method not found")
        expect(error_resp.contains("error")).to_equal(true)
        expect(error_resp.contains("-32601")).to_equal(true)

    it "builds a tool result response carrying content":
        val tool_resp = make_result_response("1", LB() + jp("content", "[{\"type\":\"text\",\"text\":\"test\"}]") + RB())
        expect(tool_resp.contains("result")).to_equal(true)
        expect(tool_resp.contains("content")).to_equal(true)
