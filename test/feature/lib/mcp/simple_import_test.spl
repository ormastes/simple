# Direct-submodule import checks for std.nogc_async_mut.mcp.helpers
#
# Converted 2026-08-17 from a print-only script whose "✗" branches printed and
# then exited 0, so every check was vacuous and the file could never go RED.
# Same checks, now asserted.

use std.nogc_async_mut.mcp.helpers.{jp, js, make_result_response, make_error_response, extract_arg}

describe "MCP helpers import surface":
    it "builds a JSON pair with jp":
        val pair = jp("key", "value")
        expect(pair.contains("key")).to_equal(true)
        expect(pair.contains("value")).to_equal(true)

    it "builds a JSON string with js":
        expect(js("text").contains("text")).to_equal(true)

    it "builds a result response carrying the payload":
        val response = make_result_response("1", """{"status":"ok"}""")
        expect(response.contains("result")).to_equal(true)
        expect(response.contains("status")).to_equal(true)

    it "builds an error response carrying the code":
        val error = make_error_response("2", -32600, "Test error")
        expect(error.contains("error")).to_equal(true)
        expect(error.contains("-32600")).to_equal(true)
