# MCP helper import tests (direct submodule imports)
#
# Converted from an ad-hoc `fn main()` script that printed ✗ markers and still
# exited 0, so none of its checks were ever enforced. Same checks, now real
# assertions under the spec runner.

use std.spec.step
use std.nogc_async_mut.mcp.helpers.{jp, js, make_result_response, make_error_response, extract_arg}

describe "MCP Library - Direct Helper Imports":
    it "jp builds a JSON key/value pair":
        step("jp builds a JSON key/value pair")
        val pair = jp("key", "value")
        expect(pair).to_contain("key")
        expect(pair).to_contain("value")

    it "js quotes a JSON string value":
        step("js quotes a JSON string value")
        val str_val = js("text")
        expect(str_val).to_contain("text")

    it "make_result_response wraps a payload in a result envelope":
        step("make_result_response wraps a payload in a result envelope")
        val response = make_result_response("1", """{"status":"ok"}""")
        expect(response).to_contain("result")
        expect(response).to_contain("status")

    it "make_error_response carries the error code":
        step("make_error_response carries the error code")
        val error = make_error_response("2", -32600, "Test error")
        expect(error).to_contain("error")
        expect(error).to_contain("-32600")
