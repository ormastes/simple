# MCP schema module tests
#
# Converted from an ad-hoc `fn main()` script that printed ✗ markers and still
# exited 0, so none of its checks were ever enforced. Same checks, now real
# assertions under the spec runner.

use std.spec.step
use std.nogc_async_mut.mcp.schema.{get_all_tool_schemas, get_tool_count, init_core_schemas}

describe "MCP Library - Schema":
    it "init_core_schemas registers the core tool count":
        step("init_core_schemas registers the core tool count")
        init_core_schemas()
        expect(get_tool_count()).to_equal(8)

    it "get_all_tool_schemas returns a JSON array":
        step("get_all_tool_schemas returns a JSON array")
        init_core_schemas()
        val schemas = get_all_tool_schemas()
        expect(schemas.starts_with("[")).to_equal(true)
        expect(schemas.ends_with("]")).to_equal(true)

    it "schemas contain the expected core tools":
        step("schemas contain the expected core tools")
        init_core_schemas()
        val schemas = get_all_tool_schemas()
        expect(schemas).to_contain("read_code")
        expect(schemas).to_contain("list_files")
