# MCP Lazy Loading v2 Tests
#
# Converted from an ad-hoc `fn main()` script that printed ✗ markers and still
# exited 0, so none of its checks were ever enforced. Same checks, now real
# assertions under the spec runner. The registry and loader flags are process
# singletons, so every `it` re-initialises them explicitly.

use std.spec.step
use std.nogc_async_mut.mcp.lazy_registry_v2.{
    init_registry,
    register_handler_metadata,
    get_tool_category,
    is_category_loaded,
    mark_category_loaded,
    get_registry_stats
}
use std.nogc_async_mut.mcp.category_loaders_v2.{
    load_category,
    load_fileio_category,
    reset_loaders,
    is_fileio_loaded,
    is_edit_loaded
}

describe "MCP Library - Lazy Loading v2":
    it "registry initializes empty":
        step("registry initializes empty")
        init_registry()
        expect(get_registry_stats()).to_contain("0 handlers")

    it "register_handler_metadata records a handler":
        step("register_handler_metadata records a handler")
        init_registry()
        register_handler_metadata("test_tool", "test_cat")
        expect(get_registry_stats()).to_contain("1 handlers")

    it "get_tool_category returns the registered category":
        step("get_tool_category returns the registered category")
        init_registry()
        register_handler_metadata("test_tool", "test_cat")
        expect(get_tool_category("test_tool")).to_equal("test_cat")

    it "mark_category_loaded flips the loaded flag":
        step("mark_category_loaded flips the loaded flag")
        init_registry()
        reset_loaders()
        register_handler_metadata("test_tool", "test_cat")
        expect(is_category_loaded("test_cat")).to_equal(false)
        mark_category_loaded("test_cat")
        expect(is_category_loaded("test_cat")).to_equal(true)

    it "load_fileio_category loads and records the fileio category":
        step("load_fileio_category loads and records the fileio category")
        init_registry()
        reset_loaders()
        register_handler_metadata("simple_read", "fileio")
        expect(is_fileio_loaded()).to_equal(false)
        load_fileio_category()
        expect(is_fileio_loaded()).to_equal(true)
        expect(is_category_loaded("fileio")).to_equal(true)

    it "load_category loads a category by name":
        step("load_category loads a category by name")
        init_registry()
        reset_loaders()
        expect(is_edit_loaded()).to_equal(false)
        load_category("edit")
        expect(is_edit_loaded()).to_equal(true)

    it "unknown tool maps to the 'unknown' category":
        step("unknown tool maps to the 'unknown' category")
        init_registry()
        expect(get_tool_category("nonexistent")).to_equal("unknown")

    it "multiple handlers register with their own categories":
        step("multiple handlers register with their own categories")
        init_registry()
        register_handler_metadata("tool1", "cat1")
        register_handler_metadata("tool2", "cat1")
        register_handler_metadata("tool3", "cat2")
        expect(get_registry_stats()).to_contain("3 handlers")
        expect(get_tool_category("tool1")).to_equal("cat1")
        expect(get_tool_category("tool2")).to_equal("cat1")
        expect(get_tool_category("tool3")).to_equal("cat2")
