# MCP handler helper import tests
#
# Converted from an ad-hoc `fn main()` script that printed ✗ markers and still
# exited 0, so none of its checks were ever enforced. Same checks, now real
# assertions under the spec runner.

use std.spec.step
use std.nogc_async_mut.mcp.helpers.{jp, js, make_tool_result, make_error_response}

describe "MCP Library - Handler Imports":
    it "jp builds a JSON key/value pair":
        step("jp builds a JSON key/value pair")
        val pair = jp("key", "value")
        expect(pair).to_contain("key")
        expect(pair).to_contain("value")

    it "make_tool_result wraps content in a result envelope":
        step("make_tool_result wraps content in a result envelope")
        val result = make_tool_result("1", "test content")
        expect(result).to_contain("result")
        expect(result).to_contain("test content")

    it "make_error_response carries the error code":
        step("make_error_response carries the error code")
        val error = make_error_response("2", -32601, "test error")
        expect(error).to_contain("error")
        expect(error).to_contain("-32601")
