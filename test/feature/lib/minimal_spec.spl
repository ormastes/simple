"""
## Purpose and audience
Pins the minimal file-existence helper contract used by feature specs:
rt_file_exists reflects the real filesystem for present and absent paths.
Audience: compiler and test-infrastructure engineers using the helper.
## Operator workflow
Run `bin/simple test test/feature/lib/minimal_spec.spl` and read the
per-scenario verdicts in the `Results:` summary.
## Compatibility and limitations
Covers interpreter-path FFI to rt_file_exists only.
# @manual: primary
REQ-FEAT-MINHELPER-001
doc/01_research/local/minimal_helper.md
doc/03_plan/sys_test/minimal_helper.md
doc/04_architecture/minimal_helper.md
doc/05_design/minimal_helper.md
"""
# @req: REQ-FEAT-MINHELPER-001

use std.spec

extern fn rt_file_exists(path: text) -> bool

fn test_file_exists(path: text) -> bool:
    rt_file_exists(path)

describe "Test helper import":
    it "reports an existing file as present":
        step("Verify: reports an existing file as present")
        # @req: REQ-FEAT-MINHELPER-001
        expect(test_file_exists("test/feature/lib/minimal_spec.spl")).to_equal(true) # oracle: this spec file itself exists

    it "reports an absent path as missing":
        step("Verify: reports an absent path as missing")
        # @req: REQ-FEAT-MINHELPER-001
        expect(test_file_exists("/tmp/definitely_missing_w6_probe")).to_equal(false) # oracle: no such file exists
