# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-FEATURE
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# GC-Mode Module Resolution

**Feature IDs:** N/A
**Category:** Infrastructure
**Difficulty:** 4/5
**Status:** Implemented
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A

## Overview

Verifies that the module loader resolves modules from the correct
variant directories. Tests that common/ modules are accessible
and that the fallback chain works after migration.
"""

use std.spec.step

use std.spec

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

# Returns the number of `*.spl` files under `dir`, or -1 if `dir` does not
# exist. A missing directory must never read as "zero files, therefore fine" —
# a vanished tree has to fail differently from a merely small one.
fn _spl_file_count(dir: text) -> i64:
    val (_stdout, _stderr, exists_code) = rt_process_run("/bin/sh", ["-c", "test -d " + dir])
    if exists_code != 0:
        return -1
    val (stdout, _stderr2, _code2) = rt_process_run("/bin/sh", ["-c", "find " + dir + " -name '*.spl' | wc -l"])
    stdout.trim().parse_int() ?? -1

# ============================================================================
# Module Resolution Verification
# ============================================================================

describe "Module Resolution Fallback":
    # @manual scenario evidence
    """
    ## Fallback Chain

    Modules in common/ should be accessible from any variant context.
    Modules migrated from nogc_sync_mut to common/ must still resolve.
    """

    context "when importing array utilities from common":
        """
        ### Migrated Module Access

        array.spl was moved from nogc_sync_mut to common/.
        It should still be importable via the standard path.
        """

        it "accesses array utilities after migration":
            # @req REQ-SSPEC-FEATURE
            step("accesses array utilities after migration")
            """
            Basic array operations should work after migration.
            """
            val items = [3, 1, 2]
            expect(items[0]).to_equal(3)
            expect(items.len()).to_equal(3)

    context "when verifying the realized sync GC family":
        """
        ### Realized Variant Directory

        gc_sync_mut/ is a realized runtime-family directory, mirrored into
        the std resolution root the same way every other variant family is.
        This gate used to assert the directory's ABSENCE (a "not yet
        designed" stub fence); the tree outgrew that fence long ago
        (866+ `.spl` files under `src/lib/gc_sync_mut`), so the gate now
        checks the invariant that actually matters: the family is real
        source, not an empty placeholder, and it is mirror-synced into
        `src/std/` (since `use std.X` resolves from that mirror).
        """

        it "exposes gc_sync_mut as a realized variant family":
            # @req REQ-SSPEC-FEATURE
            step("exposes gc_sync_mut as a realized variant family")
            """
            The family must contain substantially more than a handful of
            placeholder files. `_spl_file_count` returns -1 for a missing
            directory, so a vanished tree can never read as "empty but
            fine".
            """
            val lib_count = _spl_file_count("src/lib/gc_sync_mut")
            expect(lib_count > 100).to_equal(true)

        it "mirrors gc_sync_mut into the std resolution root":
            # @req REQ-SSPEC-FEATURE
            step("mirrors gc_sync_mut into the std resolution root")
            """
            `use std.X` resolves from `src/std/`, so a lib-only family
            would be unimportable. The mirror must exist and carry the
            same file count as the lib source.
            """
            val lib_count = _spl_file_count("src/lib/gc_sync_mut")
            val std_count = _spl_file_count("src/std/gc_sync_mut")
            expect(std_count > 100).to_equal(true)
            expect(std_count).to_equal(lib_count)
