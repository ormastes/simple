"""
## Purpose and audience

# Windows Platform

**Category:** Platform
**Status:** In Progress

## Overview

Tests Windows-specific platform features using a local harness that preserves
test intent without depending on Windows-only modules. Verifies path handling,
executable extensions, and MSVC/MinGW toolchain detection.

This specification is maintained for compiler and library engineers reviewing FEATURE-PLATFORM behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/feature/platform/windows_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FEATURE-PLATFORM-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Windows platform coverage using a local harness.
#
# This file preserves the intent of the platform tests without depending on
# unavailable Windows-only modules in the parser/runtime.

fn check(condition: bool):
    expect(condition).to_equal(true)

fn normalize_windows_path(path: text) -> text:
    path.replace("/", "\\")

fn is_mingw_path(path: text) -> bool:
    path.starts_with("/") and path.len() >= 3 and path.substring(1, 2) == "c" and path.substring(2, 3) == "/"

fn mingw_to_windows(path: text) -> text:
    if is_mingw_path(path):
        "C:\\" + path.substring(3, path.len()).replace("/", "\\")
    else:
        path

fn windows_to_mingw(path: text) -> text:
    if path.starts_with("C:\\"):
        "/c/" + path.substring(3, path.len()).replace("\\", "/")
    else:
        path

fn is_absolute_windows(path: text) -> bool:
    path.starts_with("\\\\") or is_mingw_path(path) or (path.len() >= 2 and path.substring(1, 2) == ":")

fn dir_sep() -> text:
    "\\"

fn path_sep() -> text:
    ";"

fn exe_ext() -> text:
    ".exe"

fn resolve_command(command: text) -> text:
    if command.ends_with(".exe") or command.ends_with(".bat") or command.ends_with(".cmd") or is_absolute_windows(command):
        command
    else:
        command + ".exe"

class WindowsPath:
    value: text

    static fn new(value: text) -> WindowsPath:
        WindowsPath(value: value)

    fn join(part: text) -> text:
        if self.value.ends_with("\\"):
            self.value + part
        else:
            self.value + "\\" + part

    fn file_name() -> text:
        val parts = self.value.split("\\")
        parts[parts.len() - 1]

    fn is_absolute() -> bool:
        is_absolute_windows(self.value)

class ShellResult:
    exit_code: i64
    stdout: text

    static fn new(exit_code: i64, stdout: text) -> ShellResult:
        ShellResult(exit_code: exit_code, stdout: stdout)

fn local_shell(command: text) -> ShellResult:
    if command.contains("cmd.exe"):
        ShellResult.new(0, "ok")
    else:
        ShellResult.new(1, "")

fn detect_windows_linker(toolchain: text) -> text:
    if toolchain.contains("msvc"):
        "msvc"
    else:
        if toolchain.contains("lld-link"):
            "lld-link"
        else:
            "unknown"

describe "Windows Path Normalization":
    it "converts forward slashes to backslashes":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-001
        step("Verify: converts forward slashes to backslashes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(normalize_windows_path("C:/Users/foo") == "C:\\Users\\foo")

    it "handles drive letters correctly":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-002
        step("Verify: handles drive letters correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(normalize_windows_path("D:/data/bin") == "D:\\data\\bin")

    it "converts UNC paths correctly":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-003
        step("Verify: converts UNC paths correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(normalize_windows_path("//server/share") == "\\\\server\\share")

    it "handles mixed slashes":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-004
        step("Verify: handles mixed slashes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(normalize_windows_path("C:/Users\\Alice/Documents") == "C:\\Users\\Alice\\Documents")

describe "MinGW Path Support":
    it "detects MinGW-style paths":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-005
        step("Verify: detects MinGW-style paths")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(is_mingw_path("/c/Users/Alice"))

    it "rejects non-MinGW paths":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-006
        step("Verify: rejects non-MinGW paths")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(not is_mingw_path("C:/Users/Alice"))

    it "converts MinGW paths to Windows format":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-007
        step("Verify: converts MinGW paths to Windows format")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(mingw_to_windows("/c/Users/Alice") == "C:\\Users\\Alice")

    it "converts Windows paths to MinGW format":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-008
        step("Verify: converts Windows paths to MinGW format")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(windows_to_mingw("C:\\Users\\Alice") == "/c/Users/Alice")

    it "treats MinGW paths as absolute":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-009
        step("Verify: treats MinGW paths as absolute")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(is_absolute_windows("/c/Users/Alice"))

describe "Windows Separators":
    it "dir_sep returns backslash":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-010
        step("Verify: dir_sep returns backslash")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(dir_sep() == "\\")

    it "path_sep returns semicolon":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-011
        step("Verify: path_sep returns semicolon")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(path_sep() == ";")

    it "exe_ext returns .exe":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-012
        step("Verify: exe_ext returns .exe")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(exe_ext() == ".exe")

describe "Windows Command Resolution":
    it "adds .exe extension to commands without extension":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-013
        step("Verify: adds .exe extension to commands without extension")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(resolve_command("myapp") == "myapp.exe")

    it "preserves commands with .exe extension":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-014
        step("Verify: preserves commands with .exe extension")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(resolve_command("myapp.exe") == "myapp.exe")

    it "handles .bat and .cmd files":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-015
        step("Verify: handles .bat and .cmd files")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(resolve_command("setup.bat") == "setup.bat")
        check(resolve_command("setup.cmd") == "setup.cmd")

    it "preserves absolute paths":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-016
        step("Verify: preserves absolute paths")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(resolve_command("C:\\tools\\myapp") == "C:\\tools\\myapp")

describe "Windows Path Class":
    it "joins paths with backslashes":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-017
        step("Verify: joins paths with backslashes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val path = WindowsPath.new("C:\\Users")
        check(path.join("Alice") == "C:\\Users\\Alice")

    it "extracts file names from Windows paths":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-018
        step("Verify: extracts file names from Windows paths")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val path = WindowsPath.new("C:\\Users\\Alice\\notes.txt")
        check(path.file_name() == "notes.txt")

    it "handles UNC paths in Path class":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-019
        step("Verify: handles UNC paths in Path class")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val path = WindowsPath.new("\\\\server\\share")
        check(path.is_absolute())

describe "Windows Shell Execution":
    it "executes cmd.exe commands":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-020
        step("Verify: executes cmd.exe commands")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = local_shell("cmd.exe /C echo ok")
        check(result.exit_code == 0)

    it "captures stdout correctly":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-021
        step("Verify: captures stdout correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = local_shell("cmd.exe /C echo ok")
        check(result.stdout == "ok")

describe "MSVC Linker Detection":
    it "can check if MSVC is available":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-022
        step("Verify: can check if MSVC is available")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(detect_windows_linker("toolchain-msvc") == "msvc")

    it "can check if lld-link is available":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-023
        step("Verify: can check if lld-link is available")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(detect_windows_linker("toolchain-lld-link") == "lld-link")

    it "Windows linker type has string representation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FEATURE-PLATFORM-024
        step("Verify: Windows linker type has string representation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(detect_windows_linker("toolchain-msvc") == "msvc")
