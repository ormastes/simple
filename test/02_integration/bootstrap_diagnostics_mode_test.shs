#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
bootstrap_script="${repo_root}/scripts/bootstrap/bootstrap-from-scratch.sh"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

help=$(sh "${bootstrap_script}" --help)
printf '%s\n' "${help}" | grep -q -- '--diagnostics\[=MODE\]' ||
  fail "diagnostics mode is absent from bootstrap help"
printf '%s\n' "${help}" | grep -q -- 'bare --diagnostics selects debug' ||
  fail "bare debug alias is undocumented"

grep -Fq 'diagnostics_mode="${SIMPLE_BOOTSTRAP_DIAGNOSTICS_MODE:-off}"' \
  "${bootstrap_script}" || fail "diagnostics are not default-off"
grep -Fq 'SIMPLE_BOOTSTRAP_DIAG=${SIMPLE_BOOTSTRAP_DIAG:-1}' \
  "${bootstrap_script}" || fail "debug diagnostics are not enabled"
grep -Fq 'SIMPLE_KEEP_LLVM_IR=${SIMPLE_KEEP_LLVM_IR:-1}' \
  "${bootstrap_script}" || fail "debug LLVM IR retention is not enabled"
grep -Fq 'SIMPLE_MEM_SNAPSHOT=${SIMPLE_MEM_SNAPSHOT:-1}' \
  "${bootstrap_script}" || fail "debug memory snapshots are not enabled"
test_branch=$(sed -n '/^  test)/,/^    ;;/p' "${bootstrap_script}")
if printf '%s\n' "${test_branch}" | grep -Fq 'SIMPLE_BOOTSTRAP_DIAG='; then
  fail "test mode enables verbose parser diagnostics"
fi
printf '%s\n' "${test_branch}" | grep -Fq 'SIMPLE_COMPILER_PHASE_PROFILE' ||
  fail "test mode does not enable coarse phase timing"

diagnostics_forward_count=$(grep -Fc \
  'SIMPLE_BOOTSTRAP_DIAGNOSTICS_MODE="${diagnostics_mode}"' \
  "${bootstrap_script}")
[ "${diagnostics_forward_count}" -eq 2 ] ||
  fail "diagnostics mode is not forwarded into both transcribed bootstrap stages"
phase_profile_forward_count=$(grep -Fc \
  'SIMPLE_COMPILER_PHASE_PROFILE="${SIMPLE_COMPILER_PHASE_PROFILE:-0}"' \
  "${bootstrap_script}")
[ "${phase_profile_forward_count}" -eq 2 ] ||
  fail "phase profiling is not forwarded into both transcribed bootstrap stages"

invalid_log=${TMPDIR:-/tmp}/bootstrap-diagnostics-invalid.$$.log
trap 'rm -f "${invalid_log}"' EXIT HUP INT TERM
if sh "${bootstrap_script}" --diagnostics=invalid >"${invalid_log}" 2>&1; then
  fail "invalid diagnostics mode was accepted"
fi
grep -Fq -- '--diagnostics requires off, debug, or test' "${invalid_log}" ||
  fail "invalid diagnostics mode did not explain accepted values"

echo "bootstrap_diagnostics_mode=true"
