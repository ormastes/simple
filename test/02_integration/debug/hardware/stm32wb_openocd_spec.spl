# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# STM32WB OpenOCD Integration Test
# Verifies the repo-managed STM32WB OpenOCD smoke lane is prepared.

use std.spec.step

extern fn rt_file_exists(path: text) -> bool

class OpenocdWbConfig:
    interface_cfg: text
    target_cfg: text
    gdb_port: i32
    telnet_port: i32
    fixture_asm: text
    fixture_ld: text

impl OpenocdWbConfig:
    static fn default_config() -> OpenocdWbConfig:
        OpenocdWbConfig(
            interface_cfg: "interface/stlink.cfg",
            target_cfg: "target/stm32wbx.cfg",
            gdb_port: 3334,
            telnet_port: 4334,
            fixture_asm: "test/fixtures/baremetal/stm_semihost_smoke.s",
            fixture_ld: "test/fixtures/baremetal/stm_semihost_smoke.ld"
        )

    fn launch_command() -> text:
        "openocd -f {self.interface_cfg} -f {self.target_cfg} -c gdb_port {self.gdb_port} -c telnet_port {self.telnet_port}"

describe "STM32WB OpenOCD repo readiness":
    # @manual scenario evidence
    it "uses the expected ST-LINK interface config":
        # @req REQ-SSPEC-INTEGRATION
        step("uses the expected ST-LINK interface config")
        val cfg = OpenocdWbConfig.default_config()
        expect(cfg.interface_cfg).to_equal("interface/stlink.cfg")

    it "uses the expected STM32WB target config":
        # @req REQ-SSPEC-INTEGRATION
        step("uses the expected STM32WB target config")
        val cfg = OpenocdWbConfig.default_config()
        expect(cfg.target_cfg).to_equal("target/stm32wbx.cfg")

    it "uses the expected ports":
        # @req REQ-SSPEC-INTEGRATION
        step("uses the expected ports")
        val cfg = OpenocdWbConfig.default_config()
        expect(cfg.gdb_port).to_equal(3334)
        expect(cfg.telnet_port).to_equal(4334)

    it "ships the shared STM smoke fixture":
        # @req REQ-SSPEC-INTEGRATION
        step("ships the shared STM smoke fixture")
        val cfg = OpenocdWbConfig.default_config()
        expect(rt_file_exists(cfg.fixture_asm)).to_equal(true)
        expect(rt_file_exists(cfg.fixture_ld)).to_equal(true)

    it "launch command is well-formed":
        # @req REQ-SSPEC-INTEGRATION
        step("launch command is well-formed")
        val cfg = OpenocdWbConfig.default_config()
        val cmd = cfg.launch_command()
        expect(cmd.contains("openocd")).to_equal(true)
        expect(cmd.contains("interface/stlink.cfg")).to_equal(true)
        expect(cmd.contains("target/stm32wbx.cfg")).to_equal(true)
