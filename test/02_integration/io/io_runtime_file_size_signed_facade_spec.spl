"""
# Signed file size through the public std.io_runtime facade

## Overview

Verifies the public facade exposes the existing signed file-size operation.

## Acceptance

- A real nonempty source file has a positive signed size.
- A missing file has a negative signed size.
"""

use std.spec.{describe, it, expect, step}
use std.io_runtime.{file_size_signed, getpid, time_now_unix_micros}

describe "std.io_runtime signed file size facade":
    it "reports the size of an existing file":
        step("Read a real nonempty file through the public facade")
        expect(file_size_signed("src/lib/nogc_sync_mut/io_runtime.spl")).to_be_greater_than(0)

    it "preserves the negative status for a missing file":
        step("Preserve missing-file signed status")
        val missing = "build/object-campaign/missing-size-signed-{getpid()}-{time_now_unix_micros()}"
        expect(file_size_signed(missing)).to_be_less_than(0)
