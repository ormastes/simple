"""Distinguish actual file-provider failure from EOF without changing ownership.

REQ-FILE-NULLABLE-READ-001: nil is an I/O failure before array access.
REQ-FILE-NULLABLE-READ-002: present empty arrays remain successful EOF.
REQ-FILE-NULLABLE-READ-003: borrowed reads preserve descriptor ownership/cursor.
Execution is UNRUN until the admitted pure-Simple runtime exercises these files.

## Compatibility and limitations

EOF, short-exact-read, borrowed-cursor and negative-request oracles run on
every host. "keeps native read failures distinct from EOF through all text
and byte facades" asserts the POSIX contract that reading a write-only
descriptor fails with a typed access error (EBADF); the Windows file
provider collapses that read to EOF instead, so the example is skipped on
Windows with an explicit reason (oracle unchanged, qualified on POSIX
hosts).
"""

use std.spec.*
use std.io.types.{IoErrorKind}
use std.nogc_sync_mut.io.file.{FileHandle, file_read_borrowed_bytes}
use std.nogc_sync_mut.io_runtime.{file_write_bytes, file_delete, getpid, time_now_unix_micros}
use std.env.platform.{get_temp_dir}
use std.nogc_sync_mut.env.platform.{is_windows}
use std.nogc_sync_mut.spec.{skip}
use std.nogc_sync_mut.sffi.fs.{io_file_open, io_file_close}

fn nullable_read_scratch() -> text:
    get_temp_dir() + "/file-nullable-read-{getpid()}-{time_now_unix_micros()}.bin"

fn nullable_read_failure_unsupported() -> text:
    if is_windows():
        return "Windows file provider collapses a read on a write-only descriptor to EOF instead of a typed access error; the failure-vs-EOF distinction remains qualified on POSIX hosts"
    ""

describe "FileHandle nullable native read boundary":
    val read_failure_unsupported = nullable_read_failure_unsupported()
    if read_failure_unsupported != "":
        skip("keeps native read failures distinct from EOF through all text and byte facades", read_failure_unsupported)
    else:
        it "keeps native read failures distinct from EOF through all text and byte facades":
            # @req: REQ-FILE-NULLABLE-READ-001
            step("Open a real write-only file descriptor")
            val path = nullable_read_scratch()
            var writer = FileHandle.create(path).unwrap()
            step("Reading a write-only descriptor fails without examining nil as an array")
            match writer.read(1):
                case Ok(_): fail("write-only descriptor read unexpectedly succeeded")
                case Err(error): expect(error.kind).to_equal(IoErrorKind.Other)
            match writer.read_exact(1):
                case Ok(_): fail("write-only exact read unexpectedly succeeded")
                case Err(error): expect(error.kind).to_equal(IoErrorKind.Other)
            match writer.read_all():
                case Ok(_): fail("write-only read_all unexpectedly succeeded")
                case Err(error): expect(error.kind).to_equal(IoErrorKind.Other)
            match writer.read_text():
                case Ok(_): fail("provider failure became successful internal text")
                case Err(error): expect(error.kind).to_equal(IoErrorKind.Other)
            expect(writer.close().is_ok()).to_equal(true)
            expect(file_delete(path)).to_equal(true)

    it "preserves successful EOF and reports a short exact read separately":
        # @req: REQ-FILE-NULLABLE-READ-002
        step("Open an actual empty file for reading")
        val path = nullable_read_scratch()
        expect(file_write_bytes(path, [])).to_equal(true)
        var reader = FileHandle.read_file(path).unwrap()
        expect(reader.read(1).unwrap()).to_equal([])
        expect(reader.read_all().unwrap()).to_equal([])
        match reader.read_exact(1):
            case Ok(_): fail("empty file unexpectedly satisfied exact one-byte read")
            case Err(error): expect(error.kind).to_equal(IoErrorKind.UnexpectedEof)
        expect(reader.close().is_ok()).to_equal(true)
        expect(file_delete(path)).to_equal(true)

    it "leaves a borrowed descriptor open and preserves partial-read cursor semantics":
        # @req: REQ-FILE-NULLABLE-READ-003
        step("Continue a caller-owned borrowed descriptor, then inspect the separate handle cursor")
        val path = nullable_read_scratch()
        expect(file_write_bytes(path, [65u8, 66u8, 67u8])).to_equal(true)
        var reader = FileHandle.read_file(path).unwrap()
        val descriptor = io_file_open(path, 0)
        expect(descriptor).to_be_greater_than(-1)
        expect(file_read_borrowed_bytes(descriptor, 1).unwrap()).to_equal([65u8])
        expect(file_read_borrowed_bytes(descriptor, 1).unwrap()).to_equal([66u8])
        expect(io_file_close(descriptor)).to_equal(true)
        expect(reader.read(2).unwrap()).to_equal([65u8, 66u8])
        step("An exact short read consumes the available suffix and reports UnexpectedEof")
        match reader.read_exact(2):
            case Ok(_): fail("one-byte suffix unexpectedly satisfied two-byte read")
            case Err(error): expect(error.kind).to_equal(IoErrorKind.UnexpectedEof)
        expect(reader.read(1).unwrap()).to_equal([])
        expect(reader.close().is_ok()).to_equal(true)
        expect(file_delete(path)).to_equal(true)

    it "rejects negative requests without consuming the descriptor":
        # @req: REQ-FILE-NULLABLE-READ-003
        step("Reject an invalid request before reading a real file")
        val path = nullable_read_scratch()
        expect(file_write_bytes(path, [90u8])).to_equal(true)
        var reader = FileHandle.read_file(path).unwrap()
        val descriptor = io_file_open(path, 0)
        expect(descriptor).to_be_greater_than(-1)
        expect(file_read_borrowed_bytes(descriptor, -1).is_err()).to_equal(true)
        expect(file_read_borrowed_bytes(descriptor, 1).unwrap()).to_equal([90u8])
        expect(io_file_close(descriptor)).to_equal(true)
        expect(reader.read_exact(0).unwrap()).to_equal([])
        expect(reader.read(1).unwrap()).to_equal([90u8])
        expect(reader.close().is_ok()).to_equal(true)
        expect(file_delete(path)).to_equal(true)
