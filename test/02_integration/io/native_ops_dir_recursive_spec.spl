"""

## Purpose and audience
## Operator workflow
## Compatibility and limitations

# Native recursive directory operations

## Overview

Verifies nested directory setup and cleanup for native directory operations while
host shell access goes through the shared IO runtime wrapper.

## Acceptance

- A nested temporary directory can be created.
- The nested path is detected as a directory.
- The temporary directory tree is removed.
"""
# @manual: primary
# @req: REQ-TEST-IO_NATIVE_OPS_DIR_RECURSIVE-001
# doc-path: doc/01_research/local/uno_q_qrb2210_native_simple2d.md
# doc-path: doc/03_plan/sys_test/native_platform_arch_matrix.md
# doc-path: doc/04_architecture/runtime/native_library_binding_survey.md
# doc-path: doc/05_design/compiler/bootstrap/seed_native_build_invariant_gate.md

use std.spec.step
use app.io.dir_ops
use std.io_runtime.{env_get, process_run}

fn check(condition: bool):
    expect(condition).to_equal(true)

fn slow_it(name: text, block: fn()):
    it(name, block)

fn shell_mkdir_p(path: text) -> bool:
    val (out, err, code) = process_run("/bin/sh", ["-c", "mkdir -p '{path}'"])
    code == 0

fn shell_rm_rf(path: text) -> bool:
    val (out, err, code) = process_run("/bin/sh", ["-c", "rm -rf '{path}'"])
    code == 0

val tmp = env_get("TEMP") ?? env_get("TMPDIR") ?? "/tmp"

describe "Native Directory Ops":
    slow_it "creates nested directories recursively":
        # @req: REQ-TEST-IO_NATIVE_OPS_DIR_RECURSIVE-001
        step("Verify: creates nested directories recursively")
        # evidence(expect(...) oracle verified): pinned constants below are authoritative values asserted by this scenario
        val test_dir = "{tmp}/simple_native_deep/sub1/sub2"

        # rt_dir_create not available in bootstrap runtime, use shell mkdir -p
        check(shell_mkdir_p(test_dir))
        check(is_dir(test_dir))
        check(shell_rm_rf("{tmp}/simple_native_deep"))
