use std.spec
use std.common.encoding.external_text.{Encoding, ByteOrder, BomPolicy, CodecErrorKind}
use std.nogc_sync_mut.io.external_text_io.{TextIoError}
use std.nogc_sync_mut.io.text_session.{text_session_codec, utf8_text_session_codec, TEXT_SESSION_BYTE_LIMIT}

describe "SOSIX text session codec selection":
    it "retains different typed input and output encodings":
        val codec = text_session_codec(Encoding.Utf16, ByteOrder.LittleEndian, BomPolicy.Require, Encoding.Utf16, ByteOrder.BigEndian, BomPolicy.Forbid, 4096, 8192).unwrap()
        expect(codec.read_encoding()).to_equal(Encoding.Utf16)
        expect(codec.read_byte_order()).to_equal(ByteOrder.LittleEndian)
        expect(codec.read_bom()).to_equal(BomPolicy.Require)
        expect(codec.write_encoding()).to_equal(Encoding.Utf16)
        expect(codec.write_byte_order()).to_equal(ByteOrder.BigEndian)
        expect(codec.write_bom()).to_equal(BomPolicy.Forbid)
        expect(codec.input_byte_limit()).to_equal(4096)
        expect(codec.output_byte_limit()).to_equal(8192)

    it "selects explicit UTF-8 compatibility without inferring host encoding":
        val codec = utf8_text_session_codec(128, 256).unwrap()
        expect(codec.read_encoding()).to_equal(Encoding.Utf8)
        expect(codec.read_byte_order()).to_equal(ByteOrder.NotApplicable)
        expect(codec.read_bom()).to_equal(BomPolicy.Preserve)
        expect(codec.write_encoding()).to_equal(Encoding.Utf8)
        expect(codec.write_byte_order()).to_equal(ByteOrder.NotApplicable)
        expect(codec.write_bom()).to_equal(BomPolicy.Preserve)

    it "rejects unknown input encoding with the original typed diagnostic":
        val result = text_session_codec(Encoding.Unknown("not-a-codec"), ByteOrder.NotApplicable, BomPolicy.Preserve, Encoding.Utf8, ByteOrder.NotApplicable, BomPolicy.Preserve, 16, 16)
        match result:
            case Err(TextIoError.Codec(error)):
                expect(error.kind).to_equal(CodecErrorKind.UnknownEncoding)
                expect(error.byte_offset).to_equal(-1)
            case _: assert(false)

    it "rejects inconsistent output byte order before any resource is opened":
        val result = text_session_codec(Encoding.Utf8, ByteOrder.NotApplicable, BomPolicy.Preserve, Encoding.Utf16, ByteOrder.NotApplicable, BomPolicy.Require, 16, 16)
        match result:
            case Err(TextIoError.Codec(error)):
                expect(error.kind).to_equal(CodecErrorKind.InvalidFormat)
                expect(error.byte_offset).to_equal(-1)
            case _: assert(false)

    it "rejects zero input and excessive output limits with actionable diagnostics":
        match utf8_text_session_codec(0, 1):
            case Err(TextIoError.Io(message)): expect(message).to_contain("input byte limit must be")
            case _: assert(false)
        match utf8_text_session_codec(1, TEXT_SESSION_BYTE_LIMIT + 1):
            case Err(TextIoError.Io(message)): expect(message).to_contain("output byte limit must be")
            case _: assert(false)

    it "keeps codec profiles independent":
        val first = utf8_text_session_codec(10, 20).unwrap()
        val second = text_session_codec(Encoding.Utf16, ByteOrder.BigEndian, BomPolicy.Require, Encoding.Utf16, ByteOrder.LittleEndian, BomPolicy.Preserve, 30, 40).unwrap()
        expect(first.input_byte_limit()).to_equal(10)
        expect(second.input_byte_limit()).to_equal(30)
        expect(first.read_encoding()).to_equal(Encoding.Utf8)
        expect(second.read_encoding()).to_equal(Encoding.Utf16)

    it "accepts both inclusive byte-limit endpoints":
        val minimum = utf8_text_session_codec(1, 1).unwrap()
        val maximum = utf8_text_session_codec(TEXT_SESSION_BYTE_LIMIT, TEXT_SESSION_BYTE_LIMIT).unwrap()
        expect(minimum.input_byte_limit()).to_equal(1)
        expect(minimum.output_byte_limit()).to_equal(1)
        expect(maximum.input_byte_limit()).to_equal(16777216)
        expect(maximum.output_byte_limit()).to_equal(16777216)
        expect(minimum.validate().is_ok()).to_equal(true)
        expect(maximum.validate().is_ok()).to_equal(true)

    it "rejects negative zero and over-limit values independently on either side":
        for limit in [-1, 0, TEXT_SESSION_BYTE_LIMIT + 1, 9223372036854775807]:
            match utf8_text_session_codec(limit, 1):
                case Err(TextIoError.Io(message)): expect(message).to_contain("input byte limit must be")
                case _: assert(false)
            match utf8_text_session_codec(1, limit):
                case Err(TextIoError.Io(message)): expect(message).to_contain("output byte limit must be")
                case _: assert(false)

    it "preserves unknown output and inconsistent input metadata diagnostics":
        match text_session_codec(Encoding.Utf8, ByteOrder.NotApplicable, BomPolicy.Preserve, Encoding.Unknown("output-codec"), ByteOrder.NotApplicable, BomPolicy.Preserve, 1, 1):
            case Err(TextIoError.Codec(error)):
                expect(error.kind).to_equal(CodecErrorKind.UnknownEncoding)
                expect(error.byte_offset).to_equal(-1)
                expect(error.reason).to_equal("output-codec")
            case _: assert(false)
        match text_session_codec(Encoding.Utf8, ByteOrder.BigEndian, BomPolicy.Preserve, Encoding.Utf8, ByteOrder.NotApplicable, BomPolicy.Preserve, 1, 1):
            case Err(TextIoError.Codec(error)):
                expect(error.kind).to_equal(CodecErrorKind.InvalidFormat)
                expect(error.byte_offset).to_equal(-1)
            case _: assert(false)

    it "validates required BOM policy as metadata without demanding payload bytes":
        val codec = text_session_codec(Encoding.Utf8, ByteOrder.NotApplicable, BomPolicy.Require, Encoding.Utf16, ByteOrder.BigEndian, BomPolicy.Require, 8, 16).unwrap()
        expect(codec.validate().is_ok()).to_equal(true)
        expect(codec.read_bom()).to_equal(BomPolicy.Require)
        expect(codec.write_bom()).to_equal(BomPolicy.Require)
        expect(codec.input_byte_limit()).to_equal(8)
        expect(codec.output_byte_limit()).to_equal(16)
