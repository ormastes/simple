"""Actual SOSIX environment/directory/process/console APIs; authored UNRUN.

POSIX native fixture required via SIMPLE_SOSIX_TEXT_FIXTURE (absolute path).
Missing fixture is a failure, not a skipped or fabricated native pass.
"""
use std.spec
use std.common.text_bytes.{text_to_utf8_bytes}
use std.common.encoding.external_text.{external_text, external_text_from_internal, utf8_format}
use std.nogc_sync_mut.io_runtime.{env_get_nullable, env_set_process, env_remove_process}
use std.common.text_bytes.{bytes_to_text}
use std.nogc_sync_mut.io_runtime.{getpid, time_now_unix_micros, file_write_bytes, file_delete}
use std.nogc_sync_mut.io.dir_ops.{dir_create, dir_remove}
use std.nogc_async_mut.sosix.environment.{sosix_env_get_checked, sosix_env_get_nullable,
    sosix_env_set_checked, sosix_env_set, sosix_env_remove_checked, sosix_cwd_checked}
use std.nogc_async_mut.sosix.host_facade.{sosix_run, sosix_run_checked, sosix_run_bounded_checked,
    sosix_which_checked, sosix_dir_list_checked, sosix_spawn_checked}

fn sosix_tool_scratch() -> text:
    "/tmp/sosix-tool-text-{getpid()}-{time_now_unix_micros()}"

fn sosix_text_fixture() -> text:
    val fixture = sosix_env_get_checked("SIMPLE_SOSIX_TEXT_FIXTURE").unwrap().unwrap()
    assert(fixture.starts_with("/"))
    fixture

fn sosix_tool_expect_bytes(actual: [u8], expected: [u8]):
    expect(actual.len()).to_equal(expected.len())
    for index in 0..expected.len(): expect(actual[index]).to_equal(expected[index])

describe "Tool-facing SOSIX UTF8 admission on real providers":
    it "preserves missing, empty, Unicode and malformed environment distinctions":
        val key = "SIMPLE_SOSIX_NORMALIZED_{getpid()}"
        val prior = env_get_nullable(key)
        sosix_env_remove_checked(key).unwrap()
        expect(sosix_env_get_checked(key).unwrap()).to_be_nil()
        sosix_env_set_checked(key, "").unwrap()
        expect(sosix_env_get_nullable(key).unwrap()).to_equal("")
        sosix_env_set_checked(key, "한é🙂").unwrap()
        expect(sosix_env_get_checked(key).unwrap().unwrap()).to_equal("한é🙂")
        expect(sosix_env_set(key, "bad\0suffix")).to_equal(false)
        expect(sosix_env_get_nullable(key).unwrap()).to_equal("한é🙂")
        assert(env_set_process(key, bytes_to_text([255u8])))
        expect(sosix_env_get_checked(key).is_err()).to_equal(true)
        if val saved = prior: assert(env_set_process(key, saved))
        else: assert(env_remove_process(key))

    it "returns normalized current directory and nonASCII directory names":
        expect(sosix_cwd_checked().unwrap().len()).to_be_greater_than(0)
        val path = sosix_tool_scratch()
        expect(dir_create(path, false)).to_equal(true)
        expect(file_write_bytes(path + "/한🙂", [0u8, 255u8])).to_equal(true)
        expect(sosix_dir_list_checked(path).unwrap()).to_contain("한🙂")
        expect(sosix_dir_list_checked(path + "\0suffix").is_err()).to_equal(true)
        expect(file_delete(path + "/한🙂")).to_equal(true)
        expect(dir_remove(path, false)).to_equal(true)

    it "normalizes bare resolution before returning a path and then executes it":
        val path = sosix_which_checked("sh").unwrap().unwrap()
        expect(path.contains("/")).to_equal(true)
        expect(path.contains("\n")).to_equal(false)
        val result = sosix_run_checked("sh", ["-c", "printf '한🙂'; exit 7"]).unwrap()
        expect(result.stdout).to_equal("한🙂")
        expect(result.exit_code).to_equal(7)
        expect(sosix_which_checked("simple_sosix_missing_zzzzz").unwrap()).to_be_nil()

    it "returns checked malformed output errors and explicit legacy process failure":
        val script = r"printf '\377'"
        expect(sosix_run_checked("/bin/sh", ["-c", script]).is_err()).to_equal(true)
        val legacy = sosix_run("/bin/sh", ["-c", script])
        expect(legacy.exit_code).to_equal(-1)
        expect(legacy.stderr).to_contain("external text")
        expect(sosix_run_checked("/bin/sh", ["-c", "printf 'A\0B'"]).is_err()).to_equal(true)
        expect(sosix_spawn_checked("/bin/sh", ["bad\0argument"]).is_err()).to_equal(true)

    it "preserves NUL in length-delimited child capture and validates bounded options":
        val result = sosix_run_bounded_checked("/bin/sh", ["-c", r"printf '\101\000\102'"], 1000, 64).unwrap()
        val bytes = text_to_utf8_bytes(result.stdout)
        expect(bytes.len()).to_equal(3)
        expect(bytes[0]).to_equal(65u8)
        expect(bytes[1]).to_equal(0u8)
        expect(bytes[2]).to_equal(66u8)
        expect(result.exit_code).to_equal(0)
        expect(sosix_run_bounded_checked("/bin/sh", [], -1, 64).is_err()).to_equal(true)
        expect(sosix_run_bounded_checked("/bin/sh", [], 1000, 16777217).is_err()).to_equal(true)

    it "captures exact ordinary SOSIX stdout and stderr from the native fixture":
        val result = sosix_run_checked(sosix_text_fixture(), ["emit"]).unwrap()
        sosix_tool_expect_bytes(text_to_utf8_bytes(result.stdout), [65u8, 0u8, 0xF0u8, 0x9Fu8, 0x99u8, 0x82u8])
        sosix_tool_expect_bytes(text_to_utf8_bytes(result.stderr), [0xC3u8, 0xA9u8, 0u8, 66u8, 10u8])
        expect(result.exit_code).to_equal(0)

    it "observes explicit legacy failure for malformed environment through a native child":
        val result = sosix_run_checked(sosix_text_fixture(), ["legacy-invalid-env"]).unwrap()
        expect(result.stdout).to_equal("legacy-invalid-env-ready")
        expect(result.stderr).to_contain("external text at byte 0:")
        expect(result.exit_code == 0).to_equal(false)

    it "executes bounded repeated conversion and oversized-admission oracles":
        val result = sosix_run_bounded_checked(sosix_text_fixture(), ["bounded-repeat"], 30000, 1024).unwrap()
        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_equal("bounded-repeat-ok")

    it "rejects a real undecodable directory entry inside SOSIX":
        val result = sosix_run_checked(sosix_text_fixture(), ["invalid-directory"]).unwrap()
        expect(result.exit_code).to_equal(0)

    it "rejects malformed resolver output before trimming or path interpretation":
        val result = sosix_run_checked(sosix_text_fixture(), ["invalid-resolver"]).unwrap()
        expect(result.exit_code).to_equal(0)

    it "retains real provider timeout and capture-truncation diagnostics":
        val timeout = sosix_run_bounded_checked("/bin/sh", ["-c", "sleep 2"], 20, 64).unwrap()
        expect(timeout.exit_code == 0).to_equal(false)
        expect(timeout.stderr).to_contain("TIMEOUT")
        val limited = sosix_run_bounded_checked("/bin/sh", ["-c", "printf 'abcdefghijklmnopqrstuvwxyz'"], 2000, 4).unwrap()
        expect(limited.exit_code).to_equal(0)
        expect(limited.stdout).to_contain("output truncated")
