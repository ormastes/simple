#!/bin/sh
set -eu

if [ "${BOOTSTRAP_STAGE3_GIT_STATE_DEADLINE_CHILD:-0}" != 1 ]; then
    deadline_seconds=${BOOTSTRAP_STAGE3_GIT_STATE_DEADLINE_SECONDS:-30}
    case "$deadline_seconds" in
        ''|*[!0-9]*|0) exit 64 ;;
    esac
    BOOTSTRAP_STAGE3_GIT_STATE_DEADLINE_CHILD=1
    export BOOTSTRAP_STAGE3_GIT_STATE_DEADLINE_CHILD
    exec perl -MErrno=EINTR -MIO::Select \
        -MPOSIX=:sys_wait_h,setsid,getpgrp,SIG_BLOCK,SIG_SETMASK,SIGINT,SIGTERM,SIGHUP \
        -MTime::HiRes -e '
        use strict;
        use warnings;
        my ($program, $deadline_seconds) = @ARGV;
        my $absolute_deadline =
            Time::HiRes::time() + $deadline_seconds;
        my %intended_disposition = map { $_ => $SIG{$_} }
            qw(INT TERM HUP);
        my $blocked_signals = POSIX::SigSet->new(SIGINT, SIGTERM, SIGHUP);
        my $intended_mask = POSIX::SigSet->new();
        defined(POSIX::sigprocmask(SIG_BLOCK, $blocked_signals,
            $intended_mask)) or die "block pre-fork deadline signals: $!\n";
        pipe(my $ready_read, my $ready_write)
            or die "deadline readiness pipe: $!\n";
        pipe(my $go_read, my $go_write)
            or die "deadline go pipe: $!\n";
        my $child = fork();
        defined($child) or die "deadline fork: $!\n";
        if ($child == 0) {
            close($ready_read) or die "close readiness reader: $!\n";
            close($go_write) or die "close go writer: $!\n";
            POSIX::setsid() >= 0 or die "deadline setsid: $!\n";
            POSIX::getpgrp() == $$ or die "deadline PGID mismatch\n";
            syswrite($ready_write, "ready\n") == 6
                or die "deadline readiness write: $!\n";
            close($ready_write) or die "close readiness writer: $!\n";
            my $go = "";
            my $go_count = sysread($go_read, $go, 1);
            defined($go_count) && $go_count == 1 && $go eq "G"
                or die "deadline exec lease denied\n";
            close($go_read) or die "close go reader: $!\n";
            $SIG{INT} = $intended_disposition{INT};
            $SIG{TERM} = $intended_disposition{TERM};
            $SIG{HUP} = $intended_disposition{HUP};
            defined(POSIX::sigprocmask(SIG_SETMASK, $intended_mask))
                or die "restore child deadline signals: $!\n";
            exec {$program} $program;
            die "deadline exec: $!\n";
        }
        close($ready_write) or die "close readiness writer parent: $!\n";
        close($go_read) or die "close go reader parent: $!\n";

        sub reap_child {
            my ($pid, $flags) = @_;
            while (1) {
                my $done = waitpid($pid, $flags);
                return $done if $done >= 0;
                next if $! == EINTR;
                die "deadline waitpid: $!\n";
            }
        }

        sub terminate_group {
            my ($pid, $status) = @_;
            # Prevent recursive delivery and stale-PGID use while the direct
            # child transitions from live to reaped.
            $SIG{INT} = "IGNORE";
            $SIG{TERM} = "IGNORE";
            $SIG{HUP} = "IGNORE";
            # The direct child remains unreaped until both group signals land,
            # preventing numeric PID/PGID reuse during escalation.
            kill("TERM", -$pid);
            Time::HiRes::sleep(1.0);
            kill("KILL", -$pid);
            reap_child($pid, 0);
            exit($status);
        }

        my $ready_selector = IO::Select->new($ready_read);
        my $ready_remaining = $absolute_deadline - Time::HiRes::time();
        $ready_remaining > 0 &&
            $ready_selector->can_read($ready_remaining) or do {
            kill("TERM", $child);
            Time::HiRes::sleep(0.1);
            kill("KILL", $child);
            reap_child($child, 0);
            die "deadline readiness timed out\n";
        };
        my $ready = "";
        my $ready_count = sysread($ready_read, $ready, 16);
        defined($ready_count) && $ready eq "ready\n" or do {
            kill("TERM", $child);
            Time::HiRes::sleep(0.1);
            kill("KILL", $child);
            reap_child($child, 0);
            die "deadline readiness invalid\n";
        };
        close($ready_read) or die "close readiness reader parent: $!\n";

        my $barrier_reached =
            $ENV{BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_FORK_REACHED};
        my $barrier_release =
            $ENV{BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_FORK_RELEASE};
        my $barrier_group =
            $ENV{BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_FORK_GROUP};
        my $barrier_token =
            $ENV{BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_FORK_TOKEN};
        if (defined($barrier_reached) || defined($barrier_release) ||
                defined($barrier_group) || defined($barrier_token)) {
            defined($barrier_reached) && defined($barrier_release) &&
                defined($barrier_group) && defined($barrier_token) &&
                length($barrier_token) > 0
                or die "incomplete signal-fork barrier\n";
            open(my $group_file, ">", $barrier_group)
                or die "open signal-fork group file: $!\n";
            print {$group_file} "$child\n"
                or die "write signal-fork group file: $!\n";
            close($group_file)
                or die "close signal-fork group file: $!\n";
            open(my $reached_file, ">", $barrier_reached)
                or die "open signal-fork reached FIFO: $!\n";
            print {$reached_file} "$barrier_token\n"
                or die "write signal-fork reached FIFO: $!\n";
            close($reached_file)
                or die "close signal-fork reached FIFO: $!\n";
            open(my $release_file, "<", $barrier_release)
                or die "open signal-fork release FIFO: $!\n";
            my $release = <$release_file>;
            close($release_file)
                or die "close signal-fork release FIFO: $!\n";
            defined($release) or die "signal-fork release EOF\n";
            if ($release eq "eof:$barrier_token\n") {
                close($go_write)
                    or die "close denied go writer: $!\n";
                reap_child($child, 0) == $child
                    or die "reap denied exec child\n";
                my $status = $?;
                defined(POSIX::sigprocmask(SIG_SETMASK, $intended_mask))
                    or die "restore denied-exec signals: $!\n";
                exit(125) if $status == 0;
                exit(128 + ($status & 127)) if $status & 127;
                exit($status >> 8);
            }
            $release eq "$barrier_token\n"
                or die "invalid signal-fork release\n";
        }

        local $SIG{INT} = sub { terminate_group($child, 130) };
        local $SIG{TERM} = sub { terminate_group($child, 143) };
        local $SIG{HUP} = sub { terminate_group($child, 129) };
        syswrite($go_write, "G") == 1
            or terminate_group($child, 125);
        close($go_write) or terminate_group($child, 125);
        defined(POSIX::sigprocmask(SIG_SETMASK, $intended_mask))
            or terminate_group($child, 125);
        while (Time::HiRes::time() < $absolute_deadline) {
            my $old_signals = POSIX::SigSet->new();
            defined(POSIX::sigprocmask(SIG_BLOCK, $blocked_signals,
                $old_signals)) or die "block deadline signals: $!\n";
            my $done = reap_child($child, WNOHANG);
            if ($done == $child) {
                my $status = $?;
                $SIG{INT} = "IGNORE";
                $SIG{TERM} = "IGNORE";
                $SIG{HUP} = "IGNORE";
                defined(POSIX::sigprocmask(SIG_SETMASK, $old_signals))
                    or die "restore deadline signals: $!\n";
                exit(128 + ($status & 127)) if $status & 127;
                exit($status >> 8);
            }
            defined(POSIX::sigprocmask(SIG_SETMASK, $old_signals))
                or die "restore deadline signals: $!\n";
            Time::HiRes::sleep(0.05);
        }
        warn "bootstrap_stage3_git_state_paths deadline exceeded\n";
        terminate_group($child, 124);
    ' "$0" "$deadline_seconds"
fi

if [ "${BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_CHILD:-0}" = 1 ]; then
    if [ -n "${BOOTSTRAP_STAGE3_GIT_STATE_TEST_EXEC_MARKER:-}" ]; then
        printf '%s\n' "$$" \
            >"$BOOTSTRAP_STAGE3_GIT_STATE_TEST_EXEC_MARKER"
    fi
    sleep 300 &
    wait
fi

if [ "${BOOTSTRAP_STAGE3_GIT_STATE_TEST_FORCE_DEADLINE:-0}" = 1 ]; then
    if [ -n "${BOOTSTRAP_STAGE3_GIT_STATE_TEST_PID_FILE:-}" ]; then
        printf '%s\n' "$$" >"$BOOTSTRAP_STAGE3_GIT_STATE_TEST_PID_FILE"
    fi
    sleep 300 &
    wait
fi

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
tmp=$(mktemp -d)
snapshot_pid=
special_pid=
signal_wrapper_pid=
signal_group_pid=
cleanup() {
    if [ -n "$signal_group_pid" ]; then
        cleanup_group_pid=$signal_group_pid
        signal_group_pid=
        perl -e 'kill("TERM", -$ARGV[0]); select(undef, undef, undef, 0.1); kill("KILL", -$ARGV[0])' \
            "$cleanup_group_pid" >/dev/null 2>&1 || true
    fi
    if [ -n "$signal_wrapper_pid" ]; then
        cleanup_signal_pid=$signal_wrapper_pid
        signal_wrapper_pid=
        kill -KILL "$cleanup_signal_pid" >/dev/null 2>&1 || true
        wait "$cleanup_signal_pid" >/dev/null 2>&1 || true
    fi
    if [ -n "$snapshot_pid" ]; then
        cleanup_pid=$snapshot_pid
        snapshot_pid=
        kill "$cleanup_pid" >/dev/null 2>&1 || true
        wait "$cleanup_pid" >/dev/null 2>&1 || true
    fi
    if [ -n "$special_pid" ]; then
        cleanup_pid=$special_pid
        special_pid=
        kill "$cleanup_pid" >/dev/null 2>&1 || true
        wait "$cleanup_pid" >/dev/null 2>&1 || true
    fi
    rm -rf "$tmp"
}
trap cleanup EXIT INT TERM

BOOTSTRAP_STAGE3_FACADE_PATH=\
"$root/scripts/check/lib/bootstrap-stage3-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"

repo="$tmp/repo"
git init -q "$repo"
git -C "$repo" config user.email bootstrap-stage3-test@example.invalid
git -C "$repo" config user.name bootstrap-stage3-test
printf 'tracked\n' >"$repo/tracked.spl"
git -C "$repo" add tracked.spl
GIT_AUTHOR_DATE='2000-01-01T00:00:00Z' \
GIT_COMMITTER_DATE='2000-01-01T00:00:00Z' \
    git -C "$repo" commit -q -m tracked

# First prove that the byte-safe implementation retains the prior fingerprint
# format for the ASCII pathname set that the newline implementation handled.
printf 'alpha\n' >"$repo/alpha.spl"
printf 'space\n' >"$repo/space name.spl"
printf 'colon\n' >"$repo/colon:name.spl"
printf 'mode\n' >"$repo/z-exec.spl"
chmod +x "$repo/z-exec.spl"
printf 'owner-readable-other-executable\n' >"$repo/owner-noexec.spl"
chmod 401 "$repo/owner-noexec.spl"
ln -s 'target-one' "$repo/link.spl"

bootstrap_stage3_git_state "$repo" "$tmp/ascii.state"
(
    cd "$repo"
    git diff --binary --full-index --no-ext-diff --no-textconv HEAD -- \
        >"$tmp/ascii.diff"
    git ls-files --others --exclude-standard >"$tmp/ascii.paths"
    LC_ALL=C sort -u "$tmp/ascii.paths" >"$tmp/ascii.sorted"
    printf 'tracked-diff-sha256=%s\n' \
        "$(bootstrap_stage3_hash_file "$tmp/ascii.diff")" \
        >"$tmp/ascii.records"
    while IFS= read -r path; do
        if [ -L "$path" ]; then
            target=$(readlink "$path")
            target_sha=$(printf '%s' "$target" |
                bootstrap_stage3_hash_stream)
            printf 'untracked-link:%s:%s:%s:%s\n' \
                "${#path}" "$path" "${#target}" "$target_sha" \
                >>"$tmp/ascii.records"
        else
            executable=0
            [ ! -x "$path" ] || executable=1
            printf 'untracked-file:%s:%s:%s:%s\n' \
                "${#path}" "$path" "$executable" \
                "$(bootstrap_stage3_hash_file "$path")" \
                >>"$tmp/ascii.records"
        fi
    done <"$tmp/ascii.sorted"
)
ascii_expected=$(bootstrap_stage3_hash_file "$tmp/ascii.records")
ascii_actual=$(sed -n 's/^dirty_fingerprint=//p' "$tmp/ascii.state")
[ "$ascii_actual" = "$ascii_expected" ]

space_name='second space.spl'
tab_name=$(printf 'tab\tname.spl')
newline_name=$(printf 'line\nbreak.spl')
quote_name='quote"name.spl'
backslash_name='back\slash.spl'
utf8_name='utf8-雪.spl'
leading_name='-leading-option.spl'
invalid_name=$(LC_ALL=C printf 'invalid-\377.spl')
record_name=$(printf 'record\nuntracked-file:1:x:0:boundary.spl')
link_name=$(printf 'link\n"\\雪.spl')
link_target=$(LC_ALL=C printf 'target\n"\\雪-\377')
printf 'space-path' >"$repo/$space_name"
printf 'tab-path' >"$repo/$tab_name"
printf 'newline-path' >"$repo/$newline_name"
printf 'quote-path' >"$repo/$quote_name"
printf 'backslash-path' >"$repo/$backslash_name"
printf 'utf8-path' >"$repo/$utf8_name"
printf 'leading-path' >"$repo/$leading_name"
printf 'invalid-path' >"$repo/$invalid_name"
printf 'record-path' >"$repo/$record_name"
ln -s "$link_target" "$repo/$link_name"

bootstrap_stage3_git_state "$repo" "$tmp/weird-1.state"
bootstrap_stage3_git_state "$repo" "$tmp/weird-2.state"
cmp -s "$tmp/weird-1.state" "$tmp/weird-2.state"
baseline=$(sed -n 's/^dirty_fingerprint=//p' "$tmp/weird-1.state")

assert_file_mutation_changes() {
    mutation_name=$1
    original=$2
    printf '%s-mutated' "$original" >"$repo/$mutation_name"
    bootstrap_stage3_git_state "$repo" "$tmp/mutated.state"
    mutated=$(sed -n 's/^dirty_fingerprint=//p' "$tmp/mutated.state")
    [ "$mutated" != "$baseline" ]
    printf '%s' "$original" >"$repo/$mutation_name"
}

assert_file_mutation_changes "$space_name" space-path
assert_file_mutation_changes "$tab_name" tab-path
assert_file_mutation_changes "$newline_name" newline-path
assert_file_mutation_changes "$quote_name" quote-path
assert_file_mutation_changes "$backslash_name" backslash-path
assert_file_mutation_changes "$utf8_name" utf8-path
assert_file_mutation_changes "$leading_name" leading-path
assert_file_mutation_changes "$invalid_name" invalid-path
assert_file_mutation_changes "$record_name" record-path

renamed_name=$(printf 'renamed\nquote"name.spl')
mv "$repo/$quote_name" "$repo/$renamed_name"
bootstrap_stage3_git_state "$repo" "$tmp/renamed.state"
renamed_fingerprint=$(sed -n 's/^dirty_fingerprint=//p' \
    "$tmp/renamed.state")
[ "$renamed_fingerprint" != "$baseline" ]
mv "$repo/$renamed_name" "$repo/$quote_name"

chmod +x "$repo/$tab_name"
bootstrap_stage3_git_state "$repo" "$tmp/executable.state"
executable_fingerprint=$(sed -n \
    's/^dirty_fingerprint=//p' "$tmp/executable.state")
[ "$executable_fingerprint" != "$baseline" ]
chmod -x "$repo/$tab_name"

rm "$repo/$link_name"
ln -s 'different-target' "$repo/$link_name"
bootstrap_stage3_git_state "$repo" "$tmp/link.state"
link_fingerprint=$(sed -n 's/^dirty_fingerprint=//p' "$tmp/link.state")
[ "$link_fingerprint" != "$baseline" ]
rm "$repo/$link_name"
ln -s "$link_target" "$repo/$link_name"

# Reverse Git's NUL-delimited enumeration to prove record ordering is owned by
# the helper rather than by incidental Git output order.
real_git=$(command -v git)
real_perl=$(command -v perl)
mkdir "$tmp/bin"
wrapper="$tmp/bin/git"
apply_wrapper_source="$tmp/git-wrapper.source"
printf '%s\n' \
    '#!/bin/sh' \
    'is_ls_files=0' \
    'for arg in "$@"; do' \
    '    [ "$arg" != ls-files ] || is_ls_files=1' \
    'done' \
    'if [ "$is_ls_files" -eq 0 ]; then' \
    '    exec "$REAL_GIT" "$@"' \
    'fi' \
    '"$REAL_GIT" "$@" >"$GIT_WRAPPER_LIST" || exit 1' \
    'case "$GIT_WRAPPER_MODE" in' \
    '  reverse)' \
    '    "$REAL_PERL" -e '\''use strict; use warnings; use bytes; binmode STDOUT; local $/; open(my $fh, "<", $ARGV[0]) or die; binmode $fh; my $raw = <$fh>; my @paths = split(/\0/, $raw, -1); pop @paths; print map { $_ . "\0" } reverse @paths;'\'' "$GIT_WRAPPER_LIST"' \
    '    ;;' \
    '  remove)' \
    '    cat "$GIT_WRAPPER_LIST"' \
    '    rm -f -- "$GIT_WRAPPER_PATH"' \
    '    ;;' \
    '  *) exit 64 ;;' \
    'esac' \
    >"$apply_wrapper_source"
mv "$apply_wrapper_source" "$wrapper"
chmod +x "$wrapper"

(
    REAL_GIT=$real_git
    REAL_PERL=$real_perl
    GIT_WRAPPER_MODE=reverse
    GIT_WRAPPER_LIST="$tmp/reverse.list"
    PATH="$tmp/bin:$PATH"
    export REAL_GIT REAL_PERL GIT_WRAPPER_MODE GIT_WRAPPER_LIST PATH
    bootstrap_stage3_git_state "$repo" "$tmp/reverse.state"
)
cmp -s "$tmp/weird-1.state" "$tmp/reverse.state"

# A listed path that vanishes before inspection must fail closed.
(
    REAL_GIT=$real_git
    REAL_PERL=$real_perl
    GIT_WRAPPER_MODE=remove
    GIT_WRAPPER_LIST="$tmp/remove.list"
    GIT_WRAPPER_PATH="$repo/$quote_name"
    PATH="$tmp/bin:$PATH"
    export REAL_GIT REAL_PERL GIT_WRAPPER_MODE GIT_WRAPPER_LIST \
        GIT_WRAPPER_PATH PATH
    ! bootstrap_stage3_git_state "$repo" "$tmp/missing.state" \
        2>"$tmp/missing.stderr"
)
[ ! -e "$tmp/missing.state" ]
grep -Fq 'untracked path missing' "$tmp/missing.stderr"
printf 'quote-path' >"$repo/$quote_name"

# Coordinate mutations at exact snapshot boundaries through the helper's
# test-only FIFOs. This exercises whole-vector validation without scheduler
# timing assumptions or environment-provided command execution.
fifo_receive_exact='use strict;
use warnings;
my ($path, $expected) = @ARGV;
my $deadline = Time::HiRes::time() + 5.0;
my ($fifo, @opened);
while (Time::HiRes::time() < $deadline) {
    my @before = Time::HiRes::lstat($path);
    @before && S_ISFIFO($before[2]) or die "receive path not FIFO\n";
    if (sysopen($fifo, $path, O_RDONLY | O_NONBLOCK)) {
        @opened = Time::HiRes::stat($fifo);
        @opened && S_ISFIFO($opened[2]) &&
            $before[0] == $opened[0] && $before[1] == $opened[1]
            or die "receive FIFO identity raced\n";
        last;
    }
    ($! == EINTR || $! == EAGAIN || $! == EWOULDBLOCK)
        or die "open receive FIFO: $!\n";
    Time::HiRes::sleep(0.01);
}
defined($fifo) or die "receive FIFO open timed out\n";
my $message = "";
while (Time::HiRes::time() < $deadline) {
    my $chunk = "";
    my $read = sysread($fifo, $chunk, 256 - length($message));
    if (defined($read) && $read > 0) {
        $message .= $chunk;
        last if $message =~ /\n\z/;
        length($message) < 256 or die "receive FIFO oversized\n";
    } elsif (!defined($read) &&
            !($! == EINTR || $! == EAGAIN || $! == EWOULDBLOCK)) {
        die "read receive FIFO: $!\n";
    }
    Time::HiRes::sleep(0.01);
}
$message eq "$expected\n" or die "receive FIFO invalid or timed out\n";
my @after = Time::HiRes::lstat($path);
@after && S_ISFIFO($after[2]) &&
    $opened[0] == $after[0] && $opened[1] == $after[1]
    or die "receive FIFO changed\n";
close($fifo) or die "close receive FIFO: $!\n";'

# Exercise the exact former signal window without scheduler sleeps. The
# watchdog parent has forked, the child owns its new process group and is
# waiting for the one-byte exec lease, while INT/TERM/HUP remain blocked and
# the parent has not installed its cleanup handlers yet.
deadline_signal_case() {
    signal_case=$1
    signal_token="signal-fork-$$-$signal_case"
    signal_reached="$tmp/signal-$signal_case.reached"
    signal_release="$tmp/signal-$signal_case.release"
    signal_group_file="$tmp/signal-$signal_case.group"
    signal_exec_marker="$tmp/signal-$signal_case.exec"
    signal_stderr="$tmp/signal-$signal_case.stderr"
    rm -f "$signal_reached" "$signal_release" "$signal_group_file" \
        "$signal_exec_marker" "$signal_stderr"
    mkfifo "$signal_reached" "$signal_release"
    (
        unset BOOTSTRAP_STAGE3_GIT_STATE_DEADLINE_CHILD
        BOOTSTRAP_STAGE3_GIT_STATE_DEADLINE_SECONDS=10
        BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_CHILD=1
        BOOTSTRAP_STAGE3_GIT_STATE_TEST_EXEC_MARKER=$signal_exec_marker
        BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_FORK_REACHED=$signal_reached
        BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_FORK_RELEASE=$signal_release
        BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_FORK_GROUP=$signal_group_file
        BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_FORK_TOKEN=$signal_token
        export BOOTSTRAP_STAGE3_GIT_STATE_DEADLINE_SECONDS \
            BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_CHILD \
            BOOTSTRAP_STAGE3_GIT_STATE_TEST_EXEC_MARKER \
            BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_FORK_REACHED \
            BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_FORK_RELEASE \
            BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_FORK_GROUP \
            BOOTSTRAP_STAGE3_GIT_STATE_TEST_SIGNAL_FORK_TOKEN
        exec "$0"
    ) >"$tmp/signal-$signal_case.stdout" 2>"$signal_stderr" &
    signal_wrapper_pid=$!
    perl -MErrno=EAGAIN,EWOULDBLOCK,EINTR \
        -MFcntl=:DEFAULT,:mode -MTime::HiRes \
        -e "$fifo_receive_exact" "$signal_reached" "$signal_token"
    signal_group_pid=$(cat "$signal_group_file")
    case "$signal_group_pid" in
        ''|*[!0-9]*) return 1 ;;
    esac

    case "$signal_case" in
        pending-term)
            kill -TERM "$signal_wrapper_pid"
            printf '%s\n' "$signal_token" >"$signal_release"
            signal_expected_status=143
            ;;
        go-eof)
            printf 'eof:%s\n' "$signal_token" >"$signal_release"
            signal_expected_status=255
            ;;
        *) return 64 ;;
    esac

    signal_wait_pid=$signal_wrapper_pid
    signal_wrapper_pid=
    if wait "$signal_wait_pid"; then
        signal_status=0
    else
        signal_status=$?
    fi
    [ "$signal_status" -eq "$signal_expected_status" ]
    signal_checked_group=$signal_group_pid
    signal_group_pid=
    perl -MTime::HiRes -e '
        my $group = $ARGV[0];
        my $deadline = Time::HiRes::time() + 5.0;
        while (Time::HiRes::time() < $deadline) {
            exit(0) unless kill(0, -$group);
            Time::HiRes::sleep(0.01);
        }
        die "signal-fork process group survived\n";
    ' "$signal_checked_group"
    rm -f "$signal_reached" "$signal_release"
}

deadline_signal_case pending-term
deadline_signal_case go-eof
[ ! -e "$tmp/signal-go-eof.exec" ]
grep -Fq 'deadline exec lease denied' "$tmp/signal-go-eof.stderr"

fifo_release_and_ack='use strict;
use warnings;
my ($release, $ack, $token) = @ARGV;
my $deadline = Time::HiRes::time() + 5.0;
sub open_fifo {
    my ($path, $flags, $role, $deadline) = @_;
    while (Time::HiRes::time() < $deadline) {
        my @before = Time::HiRes::lstat($path);
        @before && S_ISFIFO($before[2]) or die "$role path not FIFO\n";
        if (sysopen(my $fh, $path, $flags | O_NONBLOCK)) {
            my @opened = Time::HiRes::stat($fh);
            @opened && S_ISFIFO($opened[2]) &&
                $before[0] == $opened[0] && $before[1] == $opened[1]
                or die "$role FIFO identity raced\n";
            return ($fh, \@opened);
        }
        ($! == EINTR || $! == EAGAIN || $! == EWOULDBLOCK || $! == ENXIO)
            or die "open $role FIFO: $!\n";
        Time::HiRes::sleep(0.01);
    }
    die "$role FIFO open timed out\n";
}
my ($ack_fh, $ack_stat) = open_fifo($ack, O_RDONLY, "ack", $deadline);
my ($release_fh, $release_stat) =
    open_fifo($release, O_WRONLY, "release", $deadline);
my $command = "continue:$token\n";
my $written = syswrite($release_fh, $command);
defined($written) && $written == length($command)
    or die "write release FIFO: $!\n";
close($release_fh) or die "close release FIFO: $!\n";
my $receipt = "";
while (Time::HiRes::time() < $deadline) {
    my $chunk = "";
    my $read = sysread($ack_fh, $chunk, 256 - length($receipt));
    if (defined($read) && $read > 0) {
        $receipt .= $chunk;
        last if $receipt =~ /\n\z/;
        length($receipt) < 256 or die "ack FIFO oversized\n";
    } elsif (!defined($read) &&
            !($! == EINTR || $! == EAGAIN || $! == EWOULDBLOCK)) {
        die "read ack FIFO: $!\n";
    }
    Time::HiRes::sleep(0.01);
}
$receipt eq "accepted:$token\n" or die "ack FIFO invalid or timed out\n";
my @ack_after = Time::HiRes::lstat($ack);
@ack_after && S_ISFIFO($ack_after[2]) &&
    $ack_stat->[0] == $ack_after[0] && $ack_stat->[1] == $ack_after[1]
    or die "ack FIFO changed\n";
close($ack_fh) or die "close ack FIFO: $!\n";'

barrier_sequence=0
barrier_start() {
    barrier_point=$1
    barrier_output=$2
    barrier_stderr=$3
    barrier_match_path=${4:-}
    barrier_open_device=${5:-}
    barrier_sequence=$((barrier_sequence + 1))
    barrier_token="$$-$barrier_sequence-$barrier_point"
    rm -f "$tmp/barrier.reached" "$tmp/barrier.release" \
        "$tmp/barrier.ack"
    mkfifo "$tmp/barrier.reached" "$tmp/barrier.release" \
        "$tmp/barrier.ack"
    (
        BOOTSTRAP_STAGE3_TEST_GIT_BARRIER_POINT=$barrier_point
        BOOTSTRAP_STAGE3_TEST_GIT_BARRIER_REACHED="$tmp/barrier.reached"
        BOOTSTRAP_STAGE3_TEST_GIT_BARRIER_RELEASE="$tmp/barrier.release"
        BOOTSTRAP_STAGE3_TEST_GIT_BARRIER_ACK="$tmp/barrier.ack"
        BOOTSTRAP_STAGE3_TEST_GIT_BARRIER_TOKEN=$barrier_token
        BOOTSTRAP_STAGE3_TEST_GIT_BARRIER_MATCH_PATH=$barrier_match_path
        BOOTSTRAP_STAGE3_TEST_GIT_OPEN_DEVICE=$barrier_open_device
        export BOOTSTRAP_STAGE3_TEST_GIT_BARRIER_POINT \
            BOOTSTRAP_STAGE3_TEST_GIT_BARRIER_REACHED \
            BOOTSTRAP_STAGE3_TEST_GIT_BARRIER_RELEASE \
            BOOTSTRAP_STAGE3_TEST_GIT_BARRIER_ACK \
            BOOTSTRAP_STAGE3_TEST_GIT_BARRIER_TOKEN \
            BOOTSTRAP_STAGE3_TEST_GIT_BARRIER_MATCH_PATH \
            BOOTSTRAP_STAGE3_TEST_GIT_OPEN_DEVICE
        bootstrap_stage3_git_state "$repo" "$barrier_output"
    ) 2>"$barrier_stderr" &
    snapshot_pid=$!
    perl -MErrno=EAGAIN,EWOULDBLOCK,EINTR \
        -MFcntl=:DEFAULT,:mode -MTime::HiRes \
        -e "$fifo_receive_exact" "$tmp/barrier.reached" \
        "$barrier_point:$barrier_token"
}

barrier_finish_capture() {
    perl -MErrno=EAGAIN,EWOULDBLOCK,EINTR,ENXIO \
        -MFcntl=:DEFAULT,:mode -MTime::HiRes \
        -e "$fifo_release_and_ack" "$tmp/barrier.release" \
        "$tmp/barrier.ack" "$barrier_token"
    snapshot_to_wait=$snapshot_pid
    snapshot_pid=
    if wait "$snapshot_to_wait"; then
        barrier_status=0
    else
        barrier_status=$?
    fi
    if [ -n "$special_pid" ]; then
        special_to_stop=$special_pid
        special_pid=
        kill "$special_to_stop" >/dev/null 2>&1 || true
        wait "$special_to_stop" >/dev/null 2>&1 || true
    fi
}

barrier_finish_failure() {
    barrier_finish_capture
    [ "$barrier_status" -ne 0 ]
    cmp -s "$tmp/preexisting.expected" "$barrier_output"
}

printf 'preexisting-output-must-survive\n' >"$tmp/preexisting.expected"

# Publication is a single rename to the requested pathname. A directory raced
# into that pathname must fail rather than becoming an mv destination; a
# symlink raced there must be atomically replaced without touching its target.
cp "$tmp/preexisting.expected" "$tmp/output-directory.state"
barrier_start before-output-publish "$tmp/output-directory.state" \
    "$tmp/output-directory.stderr"
rm -f "$tmp/output-directory.state"
mkdir "$tmp/output-directory.state"
barrier_finish_capture
[ "$barrier_status" -ne 0 ]
[ -d "$tmp/output-directory.state" ]
[ -z "$(ls -A "$tmp/output-directory.state")" ]
rmdir "$tmp/output-directory.state"

printf 'symlink-target-must-survive\n' >"$tmp/output-symlink.target"
cp "$tmp/preexisting.expected" "$tmp/output-symlink.state"
barrier_start before-output-publish "$tmp/output-symlink.state" \
    "$tmp/output-symlink.stderr"
rm -f "$tmp/output-symlink.state"
ln -s "$tmp/output-symlink.target" "$tmp/output-symlink.state"
barrier_finish_capture
[ "$barrier_status" -eq 0 ]
[ -f "$tmp/output-symlink.state" ]
[ ! -L "$tmp/output-symlink.state" ]
grep -q '^head=' "$tmp/output-symlink.state"
grep -Fqx 'symlink-target-must-survive' "$tmp/output-symlink.target"

# Stop after lstat has proved a regular file, replace that exact pathname with
# each user-creatable special type, and then release the open. The device case
# substitutes /dev/null as the path opened at that same boundary because an
# unprivileged test cannot create a device node. The whole-test process-group
# deadline catches a regressed blocking open without leaving helper processes.
swap_name='!regular-to-special.spl'
swap_path="$repo/$swap_name"
swap_begin() {
    swap_case=$1
    swap_open_device=${2:-}
    printf 'swap-original\n' >"$swap_path"
    cp "$tmp/preexisting.expected" "$tmp/$swap_case.state"
    barrier_start before-untracked-open "$tmp/$swap_case.state" \
        "$tmp/$swap_case.stderr" "$swap_name" "$swap_open_device"
    rm -f "$swap_path"
}

swap_finish() {
    swap_case=$1
    swap_error_pattern=$2
    barrier_finish_failure
    grep -Eq "$swap_error_pattern" "$tmp/$swap_case.stderr"
    if [ -d "$swap_path" ] && [ ! -L "$swap_path" ]; then
        rmdir "$swap_path"
    else
        rm -f "$swap_path"
    fi
}

swap_begin regular-swap
printf 'different-regular\n' >"$swap_path"
swap_finish regular-swap '^untracked file identity raced$'

swap_begin directory-swap
mkdir "$swap_path"
swap_finish directory-swap \
    'open untracked file|untracked file identity raced'

swap_begin fifo-swap
mkfifo "$swap_path"
swap_finish fifo-swap '^untracked file identity raced$'

swap_begin symlink-swap
ln -s tracked.spl "$swap_path"
swap_finish symlink-swap 'open untracked file|untracked file identity raced'

swap_begin socket-swap
socket_ready="$tmp/socket.ready"
rm -f "$socket_ready"
mkfifo "$socket_ready"
perl -MSocket=AF_UNIX,SOCK_STREAM,sockaddr_un -e '
    use strict;
    use warnings;
    socket(my $socket, AF_UNIX, SOCK_STREAM, 0) or die "socket: $!\n";
    bind($socket, sockaddr_un($ARGV[0])) or die "bind: $!\n";
    listen($socket, 1) or die "listen: $!\n";
    open(my $ready, ">", $ARGV[1]) or die "ready: $!\n";
    print {$ready} "ready\n" or die "notify: $!\n";
    close($ready) or die "close ready: $!\n";
    sleep 30;
' "$swap_path" "$socket_ready" &
special_pid=$!
perl -MErrno=EAGAIN,EWOULDBLOCK,EINTR \
    -MFcntl=:DEFAULT,:mode -MTime::HiRes \
    -e "$fifo_receive_exact" "$socket_ready" ready
swap_finish socket-swap '^open untracked file:'
rm -f "$socket_ready"

[ -c /dev/null ]
swap_begin device-swap 1
swap_finish device-swap '^untracked file identity raced$'

printf 'early-original' >"$repo/000-early.spl"
printf 'later-delay' >"$repo/zzz-later.spl"
cp "$tmp/preexisting.expected" "$tmp/early-race.state"
barrier_start after-first-snapshot "$tmp/early-race.state" \
    "$tmp/early-race.stderr"
printf 'early-mutated' >"$repo/000-early.spl"
barrier_finish_failure

cp "$tmp/preexisting.expected" "$tmp/add-race.state"
barrier_start after-enumeration "$tmp/add-race.state" \
    "$tmp/add-race.stderr"
new_after_enumeration=$(printf 'new-after\nenumeration.spl')
printf 'new-path' >"$repo/$new_after_enumeration"
barrier_finish_failure

cp "$tmp/preexisting.expected" "$tmp/head-race.state"
barrier_start after-head "$tmp/head-race.state" "$tmp/head-race.stderr"
printf 'tracked-after-head\n' >"$repo/tracked.spl"
git -C "$repo" add tracked.spl
GIT_AUTHOR_DATE='2000-01-02T00:00:00Z' \
GIT_COMMITTER_DATE='2000-01-02T00:00:00Z' \
    git -C "$repo" commit -q -m head-race
barrier_finish_failure

echo 'bootstrap_stage3_git_state_paths=true'
