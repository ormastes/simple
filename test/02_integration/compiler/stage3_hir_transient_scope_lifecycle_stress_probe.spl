use compiler.common.driver_core_types.{
    SourceFile,
    driver_core_compile_options_default
}
use compiler.driver.driver.{CompilerDriver}
use compiler.driver.driver_types.{CompileMode}

extern fn rt_env_set(key: text, value: text) -> bool
extern fn rt_process_hwm_kib() -> i64

val SUCCESS_ATTEMPTS: i64 = 64
val MIXED_ATTEMPTS: i64 = 128
val MAX_WINDOW_KIB: i64 = 512 * 1024

fn fail(reason: text) -> i32:
    print("stage3_hir_transient_scope_lifecycle_stress=FAIL reason=" + reason)
    1

fn stress_driver(attempts: i64, poison_odd: bool) -> CompilerDriver:
    var options = driver_core_compile_options_default()
    options.mode = CompileMode.Aot
    options.low_memory = true
    options.backend = "llvm"
    var driver = CompilerDriver.create(options)
    var sources: [SourceFile] = []
    var index: i64 = 0
    while index < attempts:
        val poisoned = poison_odd and index % 2 == 1
        val content = if poisoned:
            "fn poison_" + index.to_string() +
                "(value: MissingStrictLifecycleType) -> i64:\n    0\n"
        else:
            "fn retained_" + index.to_string() +
                "() -> i64:\n    " + index.to_string() + "\n"
        sources.push(SourceFile(
            path: "build/hir-transient-stress/module_" + index.to_string() + ".spl",
            content: content,
            module_name: "hir.transient.stress.module_" + index.to_string()))
        index = index + 1
    driver.ctx.sources = sources
    driver

fn run_success_stress() -> bool:
    var driver = stress_driver(SUCCESS_ATTEMPTS, false)
    val before_hwm = rt_process_hwm_kib()
    if not driver.parse_all_streaming_surfaces_impl():
        return false
    if not driver.lower_and_check_streaming_surfaces_impl():
        return false
    val after_hwm = rt_process_hwm_kib()
    if after_hwm - before_hwm > MAX_WINDOW_KIB:
        return false
    if driver.ctx.hir_module_count_value != SUCCESS_ATTEMPTS:
        return false
    if driver.ctx.hir_modules.keys().len() != SUCCESS_ATTEMPTS:
        return false
    if driver.ctx.poisoned_module_count_value != 0:
        return false
    if not driver.ctx.hir_modules.contains_key("hir.transient.stress.module_0"):
        return false
    if not driver.ctx.hir_modules.contains_key("hir.transient.stress.module_63"):
        return false
    driver.ctx.hir_modules["hir.transient.stress.module_0"].functions.keys().len() > 0 and
        driver.ctx.hir_modules["hir.transient.stress.module_63"].functions.keys().len() > 0

fn run_mixed_stress() -> bool:
    var driver = stress_driver(MIXED_ATTEMPTS, true)
    val before_hwm = rt_process_hwm_kib()
    if not driver.parse_all_streaming_surfaces_impl():
        return false
    # Sixty-four strict HIR diagnostics are expected, so the phase result is
    # false even though collect-all must close all 128 scopes.
    if driver.lower_and_check_streaming_surfaces_impl():
        return false
    val after_hwm = rt_process_hwm_kib()
    if after_hwm - before_hwm > MAX_WINDOW_KIB:
        return false
    if driver.ctx.poisoned_module_count_value != MIXED_ATTEMPTS / 2:
        return false
    if driver.ctx.hir_module_count_value != MIXED_ATTEMPTS / 2:
        return false
    if driver.ctx.hir_modules.keys().len() != MIXED_ATTEMPTS / 2:
        return false
    if not driver.ctx.hir_modules.contains_key("hir.transient.stress.module_126"):
        return false
    if driver.ctx.hir_modules.contains_key("hir.transient.stress.module_127"):
        return false
    driver.ctx.hir_modules["hir.transient.stress.module_126"].functions.keys().len() > 0

fn run_imported_trait_reexport_case() -> bool:
    var options = driver_core_compile_options_default()
    options.mode = CompileMode.Aot
    options.low_memory = true
    options.backend = "llvm"
    var driver = CompilerDriver.create(options)
    driver.ctx.sources = [
        SourceFile(
            path: "build/hir-transient-stress/trait_owner.spl",
            content: "pub trait SharedLifecycleTrait:\n    fn inherited(self) -> i64: 41\npub fn retained_answer() -> i64:\n    41\n",
            module_name: "hir.transient.trait_owner"),
        SourceFile(
            path: "build/hir-transient-stress/trait_impl.spl",
            content: "use hir.transient.trait_owner.\{SharedLifecycleTrait\}\nstruct LifecycleItem:\n    value: i64\nimpl SharedLifecycleTrait for LifecycleItem:\n    pass_dn\n",
            module_name: "hir.transient.trait_impl"),
        SourceFile(
            path: "build/hir-transient-stress/facade.spl",
            content: "use hir.transient.trait_owner.\{retained_answer\}\nexport retained_answer\n",
            module_name: "hir.transient.facade"),
        SourceFile(
            path: "build/hir-transient-stress/consumer.spl",
            content: "use hir.transient.facade.\{retained_answer\}\nfn consume_retained() -> i64:\n    retained_answer()\n",
            module_name: "hir.transient.consumer")
    ]
    if not driver.parse_all_streaming_surfaces_impl():
        return false
    if not driver.lower_and_check_streaming_surfaces_impl():
        return false
    if driver.ctx.hir_modules.keys().len() != 4:
        return false
    driver.ctx.hir_modules["hir.transient.consumer"].functions.keys().len() > 0

fn main() -> i32:
    val _strict = rt_env_set("SIMPLE_NO_STUB_FALLBACK", "1")
    val _unstub = rt_env_set("SIMPLE_STUB_HIR", "0")
    if not run_success_stress():
        return fail("success-64")
    if not run_mixed_stress():
        return fail("mixed-128")
    if not run_imported_trait_reexport_case():
        return fail("imported-trait-reexport")
    print("stage3_hir_transient_scope_lifecycle_stress=PASS success=64 mixed=128 poison=64 ends=192 max_window_kib=524288 imported_trait=1 reexport=1 no_stub=1")
    0
