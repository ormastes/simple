use std.nogc_sync_mut.src.collections.adaptive_text_set.{
    AdaptiveSetAlgorithm, AdaptiveTextSet
}
use std.nogc_sync_mut.src.collections.adaptive_text_map.AdaptiveTextMap

fn main():
    @collection_algorithm("auto")
    var hot = AdaptiveTextSet.new()
    @collection_algorithm("auto")
    var cold = AdaptiveTextSet.new()
    @collection_algorithm("linear")
    var forced = AdaptiveTextSet.new()
    @collection_algorithm("auto")
    var hot_map = AdaptiveTextMap.new()
    val hot_hash_before_insert = hot.selected_algorithm() == AdaptiveSetAlgorithm.Hash
    val cold_hash_before_insert = cold.selected_algorithm() == AdaptiveSetAlgorithm.Hash
    val forced_hash_before_insert = forced.selected_algorithm() == AdaptiveSetAlgorithm.Hash
    val map_hash_before_insert = hot_map.selected_algorithm() == AdaptiveSetAlgorithm.Hash
    hot.insert("alpha")
    cold.insert("alpha")
    forced.insert("alpha")
    hot_map.put("alpha", "value")
    val hot_was_hash_after_first_insert = hot.selected_algorithm() == AdaptiveSetAlgorithm.Hash
    val map_was_hash_after_first_put = hot_map.selected_algorithm() == AdaptiveSetAlgorithm.Hash
    for i in 0..100:
        hot.contains("alpha")
        hot_map.get("alpha")
    val hot_values = hot.snapshot_values()
    val map_keys = hot_map.keys()
    val map_entries = hot_map.entries()
    val measured = hot.observation()
    val measured_map = hot_map.observation()
    val hot_hash_after_load = hot.selected_algorithm() == AdaptiveSetAlgorithm.Hash
    val map_hash_after_load = hot_map.selected_algorithm() == AdaptiveSetAlgorithm.Hash
    print "COLLECTION_HOT_PREINSERT_HASH:{hot_hash_before_insert}"
    print "COLLECTION_COLD_PREINSERT_HASH:{cold_hash_before_insert}"
    print "COLLECTION_FORCED_PREINSERT_HASH:{forced_hash_before_insert}"
    print "COLLECTION_MAP_PREINSERT_HASH:{map_hash_before_insert}"
    print "COLLECTION_HOT_AFTER_FIRST_HASH:{hot_was_hash_after_first_insert}"
    print "COLLECTION_MAP_AFTER_FIRST_HASH:{map_was_hash_after_first_put}"
    print "COLLECTION_HOT_AFTER_LOAD_HASH:{hot_hash_after_load}"
    print "COLLECTION_MAP_AFTER_LOAD_HASH:{map_hash_after_load}"
    print "COLLECTION_HOT_SITE:{measured.site_id}"
    print "COLLECTION_FORCED_SITE:{forced.observation().site_id}"
    print "COLLECTION_HOT_PEAK:{measured.peak_size}"
    print "COLLECTION_HOT_LOOKUPS:{measured.lookups}"
    print "COLLECTION_HOT_HITS:{measured.hits}"
    print "COLLECTION_HOT_MISSES:{measured.misses}"
    print "COLLECTION_MAP_SITE:{measured_map.site_id}"
    print "COLLECTION_MAP_PEAK:{measured_map.peak_size}"
    print "COLLECTION_MAP_LOOKUPS:{measured_map.lookups}"
    print "COLLECTION_MAP_HITS:{measured_map.hits}"
    print "COLLECTION_MAP_MISSES:{measured_map.misses}"
    if hot_values.len() == 1 and map_keys.len() == 1 and map_entries.len() == 1 and
            hot_hash_after_load and map_hash_after_load and
            cold.selected_algorithm() == AdaptiveSetAlgorithm.Linear and
            forced.selected_algorithm() == AdaptiveSetAlgorithm.Linear:
        print "COLLECTION_PROFILE_CLI: PASS"
    else:
        print "COLLECTION_PROFILE_CLI: FAIL"
