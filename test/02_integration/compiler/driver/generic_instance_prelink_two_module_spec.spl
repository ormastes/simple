# @tag:in-development
# Precondition: needs the self-hosted stage3 binary (bin/release/<triple>/simple).
# The Rust seed interprets the whole driver for native-build and exceeds the
# budget (>600s on this 3-file fixture). Proven green in the stage3 self-build lane.
use std.spec
use std.io_runtime.{dir_create_all}
use app.io.sysinfo_ops.{getpid}

# Generic instances defined in module A (Box<T>, box_get<T>) and instantiated
# for i64 and text by module B must be generated by the per-file worker
# instance step (run_file_worker_instances_v1) before link, so the exe runs.

val FIXTURE_ROOT = "test/fixtures/compiler/generic_instance_prelink"

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_env_set(key: text, value: text) -> bool

fn run_build(cache_dir: text, output: text) -> (text, i64):
    rt_env_set("SIMPLE_FILE_WORKERS", "1")
    val (out, err, code) = rt_process_run("bin/simple",
        ["native-build", "--source", FIXTURE_ROOT, "--entry-closure", "--threads", "2",
         "--cache-dir", cache_dir, "--entry", "{FIXTURE_ROOT}/main.spl", "--output", output])
    (out + "\n" + err, code)

fn receipt_line(blob: text) -> text:
    for line in blob.split("\n"):
        if line.contains("[file-worker] instances complete="):
            return line.trim()
    ""

describe "generic instance pre-link generation across two modules":
    slow_it "builds, generates instances before link, and runs":
        val root = "build/tmp/geninst_prelink_{getpid()}"
        expect(dir_create_all(root)).to_equal(true)
        val exe = "{root}/out.exe"
        val (blob, code) = run_build("{root}/cache", exe)
        expect(code).to_equal(0)
        val line = receipt_line(blob)
        expect(line.contains("complete=true")).to_equal(true)
        expect(line.contains("failed=0")).to_equal(true)
        val (out, _err, rc) = rt_process_run(exe, [])
        expect(rc).to_equal(0)
        expect(out.trim()).to_equal("42 hello")
