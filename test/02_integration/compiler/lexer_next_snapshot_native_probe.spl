use compiler.frontend.core.lexer.{lex_init, lex_next_snapshot, lexer_release_parse_source_globals}
use compiler.core.tokens.{TOK_IDENT, TOK_EOF}

fn probe_fail(reason: text) -> i32:
    print("lexer_next_snapshot_probe=FAIL reason=" + reason)
    1

fn expect_ident(expected: text) -> bool:
    val snapshot = lex_next_snapshot()
    snapshot.kind == TOK_IDENT and snapshot.text == expected and snapshot.line == 1 and snapshot.col > 0

fn main() -> i32:
    lex_init("alpha beta")
    if not expect_ident("alpha"):
        return probe_fail("first-token-before-release")
    if not expect_ident("beta"):
        return probe_fail("second-token-before-release")
    if lex_next_snapshot().kind != TOK_EOF:
        return probe_fail("eof-before-release")

    lexer_release_parse_source_globals()

    lex_init("gamma delta")
    if not expect_ident("gamma"):
        return probe_fail("first-token-after-release")
    if not expect_ident("delta"):
        return probe_fail("second-token-after-release")
    if lex_next_snapshot().kind != TOK_EOF:
        return probe_fail("eof-after-release")

    lexer_release_parse_source_globals()
    print("lexer_next_snapshot_probe=PASS tokens_before=2 tokens_after=2")
    0
