# @engine-reach: native-by-compile — compiles and executes primitive float
# rounding methods with stub fallback disabled.
"""
# Native primitive float rounding method resolution

Proves `f64.floor`, `f64.ceil`, and `f64.round` lower to the typed math runtime
ABI instead of reaching LLVM as non-linkable builtin receiver qualifiers.
"""

extern fn rt_process_run(program: text, args: [text]) -> (text, text, i64)

describe "Native primitive float rounding method resolution":
    it "compiles and executes all three zero-argument rounding methods":
        val candidate = "build/native_float_rounding_method_resolution_probe"
        val (build_out, build_err, build_status) = rt_process_run("env", [
            "SIMPLE_NO_STUB_FALLBACK=1", "bin/simple", "compile",
            "test/fixtures/native_float_rounding_method_resolution/main.spl",
            "--native", "-o", candidate,
        ])
        val build_log = build_out + build_err
        expect(build_status).to_equal(0)
        expect(build_log.contains("cannot resolve method call")).to_equal(false)
        expect(build_log.contains("f64.floor")).to_equal(false)
        expect(build_log.contains("f64.ceil")).to_equal(false)
        expect(build_log.contains("f64.round")).to_equal(false)

        val (run_out, run_err, run_status) = rt_process_run(candidate, [])
        expect(run_status).to_equal(0)
        expect(run_err).to_equal("")
        expect(run_out).to_contain("floor=3.0 ceil=-3.0 round=3.0")
