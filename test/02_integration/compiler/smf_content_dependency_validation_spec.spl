use std.spec
use std.io_runtime.{file_read, file_write, file_delete, getpid, cwd}
use compiler.common.driver_core_types.{CompileMode, CompileResult, driver_core_compile_options_default, driver_output_format_smf}
use compiler.driver.driver.{compiler_driver_create, compiler_driver_run_compile}
use compiler.driver.cache.cache_validator.{validate_smf}
use compiler.driver.cache.compile_options_hash.{compile_options_hash_zero}

val ROOT = cwd()
val ENTRY = ROOT + "/src/test_fixture/smf_dep_entry.spl"
val DEP = ROOT + "/src/test_fixture/smf_dep_leaf.spl"

describe "production SMF content dependency validation":
    it "passes Level 1 then rejects a body-only imported-source mutation":
        val output = "/tmp/simple_smf_content_dep_{getpid()}.smf"
        val original = file_read(DEP)
        file_delete(output)
        var options = driver_core_compile_options_default()
        options.input_files = [ENTRY, DEP]
        options.output_file = output
        options.mode = CompileMode.Aot
        options.output_format = driver_output_format_smf()
        val driver = compiler_driver_create(options)
        val built = compiler_driver_run_compile(driver)
        val built_ok = match built:
            case CompileResult.Success(_): true
            case _: false
        if not built_ok:
            print "AOT_FIXTURE_BUILD_ERROR: {built.get_errors().join("\n")}"
        expect(built_ok).to_equal(true)
        if not built_ok:
            file_write(DEP, original)
            return
        val fresh = validate_smf(ENTRY, output, compile_options_hash_zero())
        print "INITIAL_VALIDATE status={fresh.status} source={fresh.source_hash} cached={fresh.cached_source_hash} detail={fresh.detail}"
        expect(fresh.status).to_equal(0)
        file_write(DEP, original.replace("41", "42"))
        val stale = validate_smf(ENTRY, output, compile_options_hash_zero())
        expect(stale.status).to_equal(2)
        file_write(DEP, original)
        file_delete(output)
