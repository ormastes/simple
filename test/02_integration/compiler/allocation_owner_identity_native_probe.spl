# Common process/transient contract only. Pure-Simple does not provide session
# machinery; the separate full-native C fixture tests actual session ownership.
# Execute with an admitted selected provider, never backfilled externs.
use std.nogc_sync_mut.sffi.allocation_owner.{allocation_owner_identity_v1, AllocationOwnerDomainV1}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_identity_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end}

fn main() -> i64:
    val process = allocation_owner_identity_v1().unwrap()
    assert(process.domain == AllocationOwnerDomainV1.Process)
    assert(process.incarnation == 0)
    assert(transient_scope_begin())
    val scope = transient_array_scope_identity_v1()
    val running = allocation_owner_identity_v1().unwrap()
    assert(running.domain == AllocationOwnerDomainV1.Transient)
    assert(running.incarnation == scope)
    assert(transient_scope_pause())
    val paused = allocation_owner_identity_v1().unwrap()
    assert(paused.domain == AllocationOwnerDomainV1.Process)
    assert(paused.incarnation == 0)
    assert(transient_array_scope_identity_v1() == scope)
    assert(transient_scope_end())
    val inactive = allocation_owner_identity_v1().unwrap()
    assert(inactive.domain == AllocationOwnerDomainV1.Process)
    assert(inactive.incarnation == 0)
    0
