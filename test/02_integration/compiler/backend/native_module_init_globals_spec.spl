# Bug windows_cranelift_weak_module_initializer_2026-10-04: Cranelift emitted
# every `__module_init_*` as a COFF WeakExternal, so the /ALTERNATENAME empty
# stub won and module globals stayed raw 0. A Stage 2 compiler built that way
# died parsing a 3-line hello world: `ast_reset()` cleared a never-initialized
# AST pool and rt_clear refused receiver 0x0 as "str.clear ... dispatch gap".
# The fixture had no runner; this spec native-builds and executes it so an
# initializer that silently resolves to the stub fails here, on every target.
use std.spec
use std.io_runtime.{process_run, env_get, dir_create_all}
use app.io.sysinfo_ops.{getpid}

val FIXTURE_DIR = "test/fixtures/compiler/native_module_init_globals"

fn simple_bin() -> text:
    val b = env_get("SIMPLE_BIN")
    if b == "": "bin/simple" else: b

describe "native module global initializers":
    slow_it "cranelift-built imported globals are initialized before main":
        val root = "build/tmp/native_module_init_globals_{getpid()}"
        expect(dir_create_all(root)).to_equal(true)
        val out = root + "/probe"
        val build = process_run("sh", ["-c", simple_bin() + " native-build --backend cranelift --runtime-bundle core-c-bootstrap --threads 2 --source " + FIXTURE_DIR + " --entry-closure -o " + out + " " + FIXTURE_DIR + "/main.spl 2>&1"])
        expect(build.2).to_equal(0)

        val run = process_run("sh", ["-c", out + " 2>&1"])
        expect(run.0.contains("null receiver")).to_equal(false)
        expect(run.0).to_contain("PASS native module global initialization")
        expect(run.2).to_equal(0)
