# Probe for P3 (stage2_cli_link_undefined.md): a file-local (non-`pub`)
# top-level function referenced as a first-class VALUE (assigned into a
# struct field of function type, never called directly by name). Run both
# interpreted and native-built; the native lane is the one that used to
# fall to "undefined variable" -> `Const(Int(0))`, so the field silently held
# a null function pointer instead of referencing the function's own symbol.

fn unavailable_spawn(x: i64) -> i64: 0 - 1
fn unavailable_join(x: i64) -> i64: 0 - 2

struct HalPort:
    spawn_fn: fn(i64) -> i64
    join_fn: fn(i64) -> i64

pub fn unavailable_port() -> HalPort:
    HalPort(spawn_fn: unavailable_spawn, join_fn: unavailable_join)

fn main():
    val port = unavailable_port()
    print "spawn {port.spawn_fn(1)}"
    print "join {port.join_fn(1)}"
    val f = unavailable_spawn
    print "direct {f(7)}"
