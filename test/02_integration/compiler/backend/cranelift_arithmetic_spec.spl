# SIMPLE_BINARY must name the rebuilt, admitted pure-Simple producer.
# These native regressions remain unexecuted until that producer is available.
use std.spec.*
use std.spec.step
use std.io.{file_exists}
use app.io.env_ops.{env_get}
use app.io.process_ops.{process_run_timeout}
use app.io.sysinfo_ops.{getpid}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}

fn execute_cranelift_arithmetic_fixture(name: text) -> text:
    val producer = env_get("SIMPLE_BINARY")
    expect(producer != "").to_equal(true)
    expect(file_exists(producer)).to_equal(true)
    val root = "build/tmp/cranelift_arithmetic_{getpid()}/{name}"
    expect(dir_create_all(root)).to_equal(true)
    val output = root + "/probe.exe"
    val source = "test/fixtures/compiler/cranelift_arithmetic/{name}.spl"
    val build = process_run_timeout(producer, ["native-build", "--backend", "cranelift",
        "--opt-level=0",
        "--source", "src/lib", "--entry-closure", "--entry", source,
        "--cache-dir", root + "/cache", "--output", output], 300000)
    expect(build.2).to_equal(0)
    val run = process_run_timeout(output, [], 30000)
    expect(run.2).to_equal(0)
    expect(run.1).to_equal("")
    run.0

describe "Cranelift power and remainder dispatch":
    slow_it "executes integer and floating power plus signed floating remainder":
        step("Compile and execute parameterized power, remainder and mixed numeric controls")
        val output = execute_cranelift_arithmetic_fixture("power_remainder")
        expect(output).to_contain("PASS power remainder checks=33")
