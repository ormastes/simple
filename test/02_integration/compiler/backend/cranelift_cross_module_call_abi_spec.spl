# @req: REQ-CRANELIFT-VERIFIER-TYPES-001
# End-to-end: two Cranelift-built modules (provider + caller) linked with a C
# harness and RUN (bug p4p2_cranelift_verifier_types_2026-10-20, cluster A1).
# The import signature must come from the CALLEE's declaration. Before the
# fix it came from the caller's operands, so `take_i64(2.0)` printed 2,
# `half_f64(3)` printed 0.000 and `take(2.0)` printed 1 -- silent garbage.
# Fixture: test/fixtures/compiler/cranelift_cross_module_call_abi/
use std.spec.*
use std.io_runtime.{process_run, env_get}

fn cv_simple_bin() -> text:
    val override = env_get("SIMPLE_BIN")
    if override != "":
        return override
    "bin/simple"

fn cv_case_line(output: text, case_name: text) -> text:
    for line in output.split("\n"):
        if line.starts_with("{case_name} "):
            return line
    ""

describe "Cranelift cross-module call ABI (two modules, built and run)":
    it "runs matching calls and rejects register-class mismatches at compile time":
        step("Build every case with the Cranelift adapter, link and run it")
        val result = process_run("sh", ["test/fixtures/compiler/cranelift_cross_module_call_abi/run.shs",
            "build/test/cranelift_cross_module_call_abi", cv_simple_bin()])
        val output = result.0
        step("matching f64 -> f64 call computes the right value")
        expect(cv_case_line(output, "match")).to_equal("match value=cv=1.500 rc=0")
        step("matching i64 -> i64 call computes the right value")
        expect(cv_case_line(output, "match_i64")).to_equal("match_i64 value=cv=42 rc=0")
        step("2.0 to a declared i64 callee is a clear compile error, not garbage")
        expect(cv_case_line(output, "i64")).to_contain("E-BACKEND-CRANELIFT-CALL-ABI")
        expect(cv_case_line(output, "i64")).to_contain("arg 0 is f64 but the callee declares i64")
        step("an int to a declared f64 callee is a clear compile error")
        expect(cv_case_line(output, "int_to_f64")).to_contain("arg 0 is i64 but the callee declares f64")
        step("2.0 to an untyped callee is rejected, never inferred from the caller")
        expect(cv_case_line(output, "untyped")).to_contain("E-BACKEND-CRANELIFT-CALL-ABI")
