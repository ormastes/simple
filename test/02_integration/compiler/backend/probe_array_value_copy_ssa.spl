# Probe: `val t = xs` copies an array by value through a per-element copy
# LOOP whose counter local is defined in two blocks (preheader + latch).
# Pre-fix the alloca SSA transform refused every value-returning function,
# so the text LLVM backend emitted that counter as two SSA definitions
# (llc: multiple definition of local value). Run under native-build and
# interpret; outputs must match.
# doc/08_tracking/bug/llvm_text_backend_array_copy_loop_ssa_redefinition_2026-08-22.md
struct Pt:
    x: i64
    y: i64

fn copy_in_value_fn(src: [i64]) -> i64:
    val t = src
    t.len() * 10 + t[0]

fn main() -> i64:
    var xs = [1, 2]
    val t = xs
    xs.push(9)
    print "ints {t.len()} {xs.len()} {t[1]} {xs[2]}"
    var ss = ["a", "b"]
    val ts = ss
    ss.push("c")
    print "texts {ts.len()} {ss.len()} {ts[1]}"
    var ps = [Pt(x: 1, y: 2)]
    val tp = ps
    ps.push(Pt(x: 3, y: 4))
    print "structs {tp.len()} {ps.len()} {tp[0].y}"
    print "valuefn {copy_in_value_fn(xs)}"
    0
