# Native source probe for typed bool array push/index_of RuntimeValue tags.

extern fn rt_exit(code: i32)

fn fail(message: text):
    print "FAIL array bool tagging: {message}"
    rt_exit(1)

var checks: i64 = 0

fn check_bool(actual: bool, expected: bool, label: text):
    if actual != expected:
        fail(label)
    checks = checks + 1

fn check_i64(actual: i64, expected: i64, label: text):
    if actual != expected:
        fail(label)
    checks = checks + 1

print "BEGIN array bool tagging fixture"

var flags: [bool] = []
flags.push(false)
flags.push(true)
check_bool(flags[0], false, "pushed false retrieval")
check_bool(flags[1], true, "pushed true retrieval")
check_i64(flags.index_of(false), 0, "false index_of")
check_i64(flags.index_of(true), 1, "true index_of")

val literal_flags: [bool] = [false, true]
check_i64(literal_flags.index_of(false), 0, "false literal index_of control")
check_i64(literal_flags.index_of(true), 1, "true literal index_of control")

var only_false: [bool] = []
only_false.push(false)
check_i64(only_false.index_of(true), -1, "missing true")

var only_true: [bool] = []
only_true.push(true)
check_i64(only_true.index_of(false), -1, "missing false")

var numbers: [i64] = []
numbers.push(37)
check_i64(numbers.index_of(37), 0, "numeric control found")
check_i64(numbers.index_of(91), -1, "numeric control missing")

if checks != 10:
    fail("expected exactly ten checks")
print "END array bool tagging fixture checks={checks}"
rt_exit(0)
