# Regression spec for
# doc/08_tracking/bug/run_path_extern_text_corruption_causes_false_gpu_skip_2026-08-20.md
#
# The bug: `bin/simple run` corrupted `extern fn ... -> text` RETURN values on
# the compiled run path -- `val`-bound extern text read back as the native
# codegen corruption sentinel `len() == -1`, values passed across a
# function-parameter boundary corrupted, and concatenation with a literal
# collapsed (silently discarding the literal prefix). The downstream effect
# was a FALSE `skip:vulkan-physical-device-required` from a probe whose
# extern-read device type was "discrete" -- recorded as a PASS.
#
# This spec builds a device-free fixture (test/fixtures/compiler/
# run_path_extern_text_return/main.spl) through the selected producer's
# `native-build` and executes the resulting binary, asserting the exact
# expected stdout -- the same (a) inline val binding, (b) function-parameter
# boundary, (b-direct) call-result-as-argument, and (c) literal-concatenation
# shapes the bug doc recorded, on both runtime text-ABI families
# (rt_text_to_lower_ascii boxed-value ABI, rt_path_basename ptr+len ABI).
#
# Authored evidence contract (same as
# llvm_env_get_local_owner_native_spec.spl): the compiled codegen path this
# bug lived on is only implemented by the rebuilt pure-Simple producer; the
# Rust bootstrap seed lacks the LLVM native backend. Skipping (not failing)
# when the selected producer is the seed matches that contract. The fixture
# itself was additionally verified green on the seed's own `run` path
# (compiled mode) during the 2026-11-27 re-measurement of the bug doc.
#
# Requires SIMPLE_BINARY to select a rebuilt admitted pure-Simple producer.

use std.spec.*
use std.io_runtime.{env_get_opt, env_set, env_remove_process, file_exists, dir_create_all}
use app.io.process_ops.{process_run_timeout}
use app.io.sysinfo_ops.{getpid}
use std.nogc_sync_mut.spec.{skip}

# The LLVM native backend these examples exercise is only implemented by the
# rebuilt pure-Simple producer; the Rust bootstrap seed lacks it. Skipping
# (not failing) when the selected producer is unavailable matches this file's
# authored evidence contract. The `--version` identity check mirrors the test
# runner's MC/DC degrade decision.
fn rust_seed_toolchain(binary: text) -> bool:
    val (out, err, code) = process_run_timeout(binary, ["--version"], 10000)
    if code != 0:
        return false
    val identity = out + "\n" + err
    identity.contains("bootstrap seed only") or identity.contains("Simple Language v")

fn producer_unsupported_reason() -> text:
    val producer = env_get_opt("SIMPLE_BINARY") ?? ""
    if producer == "":
        return "SIMPLE_BINARY is unset; this regression spec requires the rebuilt pure-Simple producer"
    if rust_seed_toolchain(producer):
        return "the selected SIMPLE_BINARY is the Rust bootstrap seed, which lacks the LLVM native backend"
    ""

fn check_text_return_fixture(expected: text):
    val producer = env_get_opt("SIMPLE_BINARY") ?? ""
    expect(producer != "").to_equal(true)
    expect(file_exists(producer)).to_equal(true)
    val root = "build/tmp/run_path_text_abi_{getpid()}"
    expect(dir_create_all(root)).to_equal(true)
    val output = root + "/probe.exe"
    val fixture = "test/fixtures/compiler/run_path_extern_text_return"
    # Fail loudly on any link/ABI gap: a stub fallback could mask exactly the
    # corruption this spec guards against, so it must be disabled for the
    # build and asserted absent from the build output.
    val old_no_stub = env_get_opt("SIMPLE_NO_STUB_FALLBACK")
    val no_stub = env_set("SIMPLE_NO_STUB_FALLBACK", "1")
    val build = if no_stub:
        process_run_timeout(producer, ["native-build", "--backend", "llvm",
            "--source", "src/lib", "--source", fixture, "--entry-closure",
            "--entry", fixture + "/main.spl", "--cache-dir", root + "/cache",
            "--output", output], 300000)
    else:
        ("", "failed to configure SIMPLE_NO_STUB_FALLBACK regression environment", -1)
    val run = if build.2 == 0 and file_exists(output):
        process_run_timeout(output, [], 30000)
    else:
        ("", "text-extern fixture did not produce an executable", -1)
    val restored_no_stub = if old_no_stub == nil: env_remove_process("SIMPLE_NO_STUB_FALLBACK") else: env_set("SIMPLE_NO_STUB_FALLBACK", old_no_stub!)
    expect(no_stub).to_equal(true)
    expect(restored_no_stub).to_equal(true)
    expect(build.2).to_equal(0)
    expect((build.0 + build.1).contains("stub fallback")).to_equal(false)
    expect(run.2).to_equal(0)
    expect(run.1.trim()).to_equal("")
    expect(run.0.replace("\r\n", "\n").trim()).to_equal(expected)

describe "run-path extern text return ABI (device-free)":
    slow_it "extern fn -> text survives val binding, parameter boundary, and literal concat":
        val unsupported = producer_unsupported_reason()
        if unsupported != "":
            skip("extern fn -> text survives val binding, parameter boundary, and literal concat", unsupported)
            return
        step("Build the device-free text-extern fixture and run it; a corrupted extern text return flips len to -1, eq to false, or collapses the concat lines")
        check_text_return_fixture(
            "inline len=8 eq=true\n" +
            "param len=8 eq=true\n" +
            "param len=8 eq=true\n" +
            "concat discrete\n" +
            "basename-inline len=8 eq=true\n" +
            "param len=8 eq=true\n" +
            "concat discrete\n" +
            "TEXT-EXTERN OK")
