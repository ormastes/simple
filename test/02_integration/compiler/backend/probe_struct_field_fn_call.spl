# Probe for P2 (stage2_cli_link_undefined.md): call through a struct FIELD
# that holds a function value (`port.op_fn(x)`, where `op_fn: fn(i64) -> i64`
# is a field, not a method). Run both interpreted and native-built; the
# native lane is the one that used to lower this call as a bogus
# `Type.op_fn` METHOD symbol instead of an indirect call through the field.

fn add_one(x: i64) -> i64: x + 1
fn add_two(x: i64) -> i64: x + 2
fn default_tag() -> text: "port"

struct FnPort:
    op_fn: fn(i64) -> i64
    tag_fn: fn() -> text

fn make_port(which: bool) -> FnPort:
    if which:
        FnPort(op_fn: add_one, tag_fn: default_tag)
    else:
        FnPort(op_fn: add_two, tag_fn: default_tag)

fn main():
    val port_a = make_port(true)
    val port_b = make_port(false)
    print "opfn_a {port_a.op_fn(10)}"
    print "opfn_b {port_b.op_fn(10)}"
    print "tagfn {port_a.tag_fn()}"
