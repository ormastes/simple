# @req REQ-SSPEC-COMPILER
# Bug: mir_match_lambda_capture_scope_2026_10_17
# Execution/docgen: TEST_BLOCKED pending qualified producer.
use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}

fn match_closure_mir(source: text) -> MirModule:
    val ast = parse_full_frontend(source, "match_closure.spl", "match_closure", Logger(level: 0))
    var frontend = HirLowering.with_filename("match_closure.spl")
    val hir = frontend.lower_module(ast)
    expect(frontend.errors.len()).to_equal(0)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    expect(lowering.errors.len()).to_equal(0)
    mir

fn match_closure_calls(module: MirModule, target: text) -> i64:
    var count = 0
    for function in module.functions.values():
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Call(_, operand, _):
                        match operand.kind:
                            case MirOperandKind.Const(MirConstValue.Str(name), _):
                                if name == target: count = count + 1
                            case _: ()
                    case _: ()
    count

describe "parsed match lambdas preserve real closure environments", tag: ["only-compiled"]:
    it "lifts a noncapturing match without manufacturing an environment":
        val source = "fn make() -> fn(i64) -> i64:\n    \\value:\n        match value:\n            case 0: 11\n            case other: other + 1\n"
        val mir = match_closure_mir(source)
        expect(match_closure_calls(mir, "rt_closure_new")).to_equal(0)

    it "captures an outer value used only in an arm body":
        val source = "fn make(bias: i64) -> fn(i64) -> i64:\n    \\value:\n        match value:\n            case 0: bias\n            case other: other + bias\n"
        val mir = match_closure_mir(source)
        expect(match_closure_calls(mir, "rt_closure_new")).to_equal(1)
        expect(match_closure_calls(mir, "rt_closure_set_capture")).to_equal(1)
        expect(match_closure_calls(mir, "rt_closure_get_capture")).to_equal(1)

    it "captures guard-only state and excludes its arm-local binder":
        val source = "fn make(limit: i64) -> fn(i64) -> i64:\n    \\value:\n        match value:\n            case local if local > limit: local\n            case other: 0 - other\n"
        val mir = match_closure_mir(source)
        expect(match_closure_calls(mir, "rt_closure_set_capture")).to_equal(1)

    it "does not capture a same-spelling outer value shadowed by an arm":
        val source = "fn make(local: i64) -> fn(i64) -> i64:\n    \\value:\n        match value:\n            case local: local + 1\n"
        val mir = match_closure_mir(source)
        expect(match_closure_calls(mir, "rt_closure_new")).to_equal(0)

    it "normalizes parsed Or pattern binders before capturing arm state":
        val source = "enum Choice:\n    Left(i64)\n    Right(i64)\nfn make(bias: i64) -> fn(Choice) -> i64:\n    \\value:\n        match value:\n            case Choice.Left(local) | Choice.Right(local): local + bias\n"
        val mir = match_closure_mir(source)
        expect(match_closure_calls(mir, "rt_closure_set_capture")).to_equal(1)

    it "keeps nested match pattern and guard binders local":
        val source = "fn make(bias: i64) -> fn(i64) -> i64:\n    \\value:\n        match value:\n            case outer:\n                match outer:\n                    case inner if inner > 0: inner + bias\n                    case rest: bias - rest\n"
        val mir = match_closure_mir(source)
        expect(match_closure_calls(mir, "rt_closure_set_capture")).to_equal(1)

    it "captures a match scrutinee from the factory activation":
        val source = "fn make(selected: i64) -> fn(i64) -> i64:\n    \\value:\n        match selected:\n            case 0: value\n            case other: other + value\n"
        val mir = match_closure_mir(source)
        expect(match_closure_calls(mir, "rt_closure_set_capture")).to_equal(1)
