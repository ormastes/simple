# Purpose: L7 P5 coordinator-owned RR persistence and reevaluation transition.
# @req REQ-CSM-016 REQ-CSM-017 REQ-CSM-023 REQ-CSM-024

use std.spec.*
use std.spec.step
use std.io_runtime.{dir_create_all, dir_remove_all, file_write}
use std.nogc_sync_mut.io.file_ops.{file_read}
use std.common.crypto.sha256.{sha256_text}
use compiler.common.cache_contract.semantic_query_read_manifest_v1.{
    SemanticCoverageV1, SemanticQueryKeyV1, SemanticQueryReadV1,
    SemanticQueryReadManifestV1,
}
use compiler.common.cache_contract.reverse_reference_shard_v1.{
    ReverseReferenceShardV1,
}
use compiler.driver.cache.reference.reverse_reference_coordinator_v1.{
    OldNewMembershipV1, old_new_membership_union_v1,
    old_new_membership_zero_match_witness_valid_v1,
    seed_reverse_shards_v1, stage_reverse_shards_v1,
    persist_reverse_reference_shard_v1, read_reverse_reference_shard_v1,
}
use compiler.driver.cache.cas.verified_cas_store.{verified_cas_object_path_v1}

extern fn rt_getpid() -> i64

fn digest(label: text) -> text: sha256_text(label)

fn query(label: text) -> SemanticQueryKeyV1:
    SemanticQueryKeyV1(kind: "resolve", stable_entity_id: label,
        semantic_profile_digest: digest("profile"),
        parameter_digest: digest(label))

fn read(producer: SemanticQueryKeyV1, consumer: SemanticQueryKeyV1,
        facet: text, fingerprint: text, ordinal: i64) -> SemanticQueryReadV1:
    SemanticQueryReadV1(producer: producer, consumer: consumer,
        facet: facet, ordinal: ordinal, consumed_fingerprint: fingerprint,
        witness_digest: digest("witness-" + facet), partition_id: "partition-a",
        completeness: SemanticCoverageV1.Complete)

fn manifest(consumer: SemanticQueryKeyV1,
            reads: [SemanticQueryReadV1]) -> SemanticQueryReadManifestV1:
    SemanticQueryReadManifestV1(schema: 1, consumer: consumer,
        ordered_reads: reads)

describe "L7 P5 reverse-reference coordinator persistence":
    it "unions old and new membership and retains an explicit zero-match witness":
        step("Union old and new candidates before scheduling removed and added matches")
        val owner = query("owner")
        val old_only = query("old-only")
        val shared = query("shared")
        val new_only = query("new-only")
        val transition = OldNewMembershipV1(owner: owner, dimension: "aspects",
            old_candidates: [shared, old_only], new_candidates: [new_only, shared],
            absence_witness_digest: digest("nonempty-domain"),
            coverage: SemanticCoverageV1.Complete)
        val union = old_new_membership_union_v1(transition)
        expect(union.len()).to_equal(4)
        expect(union.map(_.stable_entity_id).contains("owner")).to_be(true)
        expect(union.map(_.stable_entity_id).contains("old-only")).to_be(true)
        expect(union.map(_.stable_entity_id).contains("shared")).to_be(true)
        expect(union.map(_.stable_entity_id).contains("new-only")).to_be(true)

        val zero_match = OldNewMembershipV1(owner: owner, dimension: "aspects",
            old_candidates: [old_only], new_candidates: [],
            absence_witness_digest: digest("zero-match-domain"),
            coverage: SemanticCoverageV1.Complete)
        expect(old_new_membership_zero_match_witness_valid_v1(zero_match)).to_be(true)
        var missing_witness = zero_match
        missing_witness.absence_witness_digest = ""
        expect(old_new_membership_zero_match_witness_valid_v1(missing_witness)).to_be(false)

    it "persists a canonical shard through verified CAS and reads the typed shard back":
        step("Persist and read a real reverse-reference shard through existing CAS owners")
        val root = "/tmp/simple-l7-p5-rr-{rt_getpid()}"
        dir_remove_all(root)
        expect(dir_create_all(root)).to_be(true)
        val producer = query("producer")
        val consumer = query("consumer")
        val old_manifest = manifest(consumer,
            [read(producer, consumer, "membership", digest("old"), 0)])
        val new_manifest = manifest(consumer,
            [read(producer, consumer, "membership", digest("new"), 0)])
        val staged = seed_reverse_shards_v1(old_manifest)
        expect(staged.accepted).to_be(true)
        expect(staged.shards.len()).to_equal(1)

        val persisted = persist_reverse_reference_shard_v1(root, staged.shards[0])
        expect(persisted.ok).to_be(true)
        expect(persisted.digest.len()).to_equal(64)
        val loaded = read_reverse_reference_shard_v1(root, persisted.digest)
        expect(loaded.ok).to_be(true)
        expect(loaded.present).to_be(true)
        match loaded.shard:
            case Some(shard):
                expect(shard).to_equal(staged.shards[0])
            case nil: fail("verified CAS omitted the persisted RR shard")

        val replaced = stage_reverse_shards_v1(staged.shards, Some(old_manifest), new_manifest, true)
        expect(replaced.accepted).to_be(true)
        expect(replaced.shards[0].sorted_edges.len()).to_equal(1)
        expect(replaced.shards[0].sorted_edges[0].consumed_fingerprint).to_equal(digest("new"))
        dir_remove_all(root)

    it "preserves old admitted edges when reevaluation fails":
        step("Retain the old RR shard until reevaluation and publication both succeed")
        val producer = query("producer")
        val consumer = query("consumer")
        val old_manifest = manifest(consumer,
            [read(producer, consumer, "membership", digest("old"), 0)])
        val new_manifest = manifest(consumer, [])
        val old_stage = seed_reverse_shards_v1(old_manifest)
        expect(old_stage.accepted).to_be(true)
        val failed = stage_reverse_shards_v1(old_stage.shards, Some(old_manifest),
            new_manifest, false)
        expect(failed.accepted).to_be(false)
        expect(failed.rejection_reason).to_equal("reevaluation_failed")
        expect(failed.shards).to_equal(old_stage.shards)
        expect(failed.shards[0].sorted_edges.len()).to_equal(1)

    it "routes only mutations and rejects nil history even for a zero-edge consumer [importance=critical; importance_weight=3]":
        step("Require complete old history for every post-genesis RR mutation")
        val old_producer = query("producer-old-history")
        val new_producer = query("producer-new-history")
        val consumer = query("consumer-with-history")
        val old_manifest = manifest(consumer,
            [read(old_producer, consumer, "membership", digest("old-history"), 0)])
        val admitted = seed_reverse_shards_v1(old_manifest)
        expect(admitted.accepted).to_be(true)

        val replacement = manifest(consumer,
            [read(new_producer, consumer, "membership", digest("new-history"), 0)])
        val missing = stage_reverse_shards_v1(admitted.shards, nil,
            replacement, true)
        expect(missing.accepted).to_be(false)
        expect(missing.rejection_reason).to_equal("rr_old_history_missing")
        expect(missing.shards).to_equal(admitted.shards)
        expect(missing.shards[0].sorted_edges.len()).to_equal(1)
        expect(missing.shards[0].sorted_edges[0].producer).to_equal(old_producer)

        val fresh_consumer = query("consumer-without-history")
        val fresh = stage_reverse_shards_v1(admitted.shards, nil,
            manifest(fresh_consumer, [read(new_producer, fresh_consumer,
                "membership", digest("fresh-history"), 0)]), true)
        expect(fresh.accepted).to_be(false)
        expect(fresh.rejection_reason).to_equal("rr_old_history_missing")
        expect(fresh.shards).to_equal(admitted.shards)

        val zero_edge_consumer = query("consumer-with-complete-empty-history")
        val empty_history = manifest(zero_edge_consumer, [])
        val first_edge = manifest(zero_edge_consumer,
            [read(new_producer, zero_edge_consumer, "membership",
                digest("first-history"), 0)])
        val missing_empty = stage_reverse_shards_v1(admitted.shards, nil,
            first_edge, true)
        expect(missing_empty.accepted).to_be(false)
        expect(missing_empty.rejection_reason).to_equal("rr_old_history_missing")
        expect(missing_empty.shards).to_equal(admitted.shards)
        val authenticated_empty = stage_reverse_shards_v1(admitted.shards,
            Some(empty_history), first_edge, true)
        expect(authenticated_empty.accepted).to_be(true)
        expect(authenticated_empty.shards[0].sorted_edges.len()).to_equal(2)

    it "preserves a nonempty admitted shard after a partially staged stale removal":
        step("Discard all in-memory mutations when a later removal is stale")
        val producer = query("producer-stale")
        val consumer = query("consumer-stale")
        val old_manifest = manifest(consumer,
            [read(producer, consumer, "membership", digest("old-stale"), 0)])
        val empty_manifest = manifest(consumer, [])
        val admitted = seed_reverse_shards_v1(old_manifest)
        expect(admitted.accepted).to_be(true)
        var mismatched_old = old_manifest
        mismatched_old.consumer = query("other-consumer")
        val stale = stage_reverse_shards_v1(admitted.shards, Some(mismatched_old),
            empty_manifest, true)
        expect(stale.accepted).to_be(false)
        expect(stale.rejection_reason).to_equal("rr_manifest_incomplete")
        expect(stale.shards).to_equal(admitted.shards)
        expect(stale.shards[0].sorted_edges.len()).to_equal(1)
        var incomplete_old = old_manifest
        incomplete_old.schema = 0
        val incomplete = stage_reverse_shards_v1(admitted.shards, Some(incomplete_old),
            empty_manifest, true)
        expect(incomplete.accepted).to_be(false)
        expect(incomplete.rejection_reason).to_equal("rr_manifest_incomplete")
        expect(incomplete.shards).to_equal(admitted.shards)

    it "preflights aggregate raw bounds before canonical edge validation":
        step("Keep oversized RR collections from reaching canonical identity construction")
        val source = file_read(
            "src/compiler/80.driver/cache/reference/reverse_reference_coordinator_v1.spl")
        val delta_stage = source.substring(source.index_of("fn _stage_reverse_shards_delta_v1"),
            source.index_of("pub fn stage_reverse_shards_v1"))
        expect(delta_stage.index_of("_reverse_stage_preflight_v1(prior, delta)") <
            delta_stage.index_of("_shards_valid_unique_v1(prior)")).to_be(true)
        val membership = source.substring(source.index_of("fn _membership_scheduler_preflight_v1"),
            source.index_of("pub fn old_new_membership_union_v1"))
        expect(membership.index_of("value.old_candidates.len() >") <
            membership.index_of("_query_list_valid_unique_v1")).to_be(true)

    it "reports an absent digest as a typed cache miss":
        step("Keep a missing RR object distinct from a corrupt or rejected read")
        val root = "/tmp/simple-l7-p5-rr-miss-{rt_getpid()}"
        dir_remove_all(root)
        expect(dir_create_all(root)).to_be(true)
        val loaded = read_reverse_reference_shard_v1(root, digest("not-persisted"))
        expect(loaded.ok).to_be(true)
        expect(loaded.present).to_be(false)
        expect(loaded.shard).to_be_nil()
        dir_remove_all(root)

    it "rejects a corrupt persisted RR object through the verified CAS owner":
        step("Treat a changed canonical object as corruption, not a typed cache miss")
        val root = "/tmp/simple-l7-p5-rr-corrupt-{rt_getpid()}"
        dir_remove_all(root)
        expect(dir_create_all(root)).to_be(true)
        val producer = query("producer-corrupt")
        val consumer = query("consumer-corrupt")
        val staged = seed_reverse_shards_v1(manifest(consumer,
            [read(producer, consumer, "membership", digest("corrupt"), 0)]))
        expect(staged.accepted).to_be(true)
        val persisted = persist_reverse_reference_shard_v1(root, staged.shards[0])
        expect(persisted.ok).to_be(true)
        val path = verified_cas_object_path_v1(root, "reverse_reference_shard",
            persisted.digest).unwrap()
        expect(file_write(path, "00")).to_be(true)
        val loaded = read_reverse_reference_shard_v1(root, persisted.digest)
        expect(loaded.ok).to_be(false)
        expect(loaded.present).to_be(false)
        expect(loaded.error).to_equal("rr_shard_read_rejected")
        dir_remove_all(root)
