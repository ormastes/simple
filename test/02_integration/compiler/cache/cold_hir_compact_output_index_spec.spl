use std.spec.*
use compiler.hir.hir_types.{HirModule, HirImport, SymbolTable}
use compiler.hir.abi_interface.{hir_abi_interface_encoded_v1}
use compiler.common.diagnostics.span.{Span}
use compiler.driver.cache.cold_hir_semantic_seed_v1.{ColdHirSemanticSeedV1, cold_hir_semantic_seed_v1}
use compiler.driver.cache.cold_hir_package_drafts_v1.{ColdHirPackageOutputV1, cold_hir_package_index_from_outputs_v1}
use compiler.driver.cache.cold_hir_package_publication_v1.{cold_hir_package_publish_verified_v1}
use compiler.driver.cache.package_archive_cache.{PackageArchiveAuthorityV1, PackageArchivePublishInputV1, package_archive_publish_scc_v1}
use compiler.driver.cache.package_module_index.{package_module_index_read_current_v1}
use compiler.driver.cache.package_module_index_builder.{PackageModuleIndexBuildAuthorityV1, PACKAGE_MODULE_INDEX_NO_MANIFEST_DIGEST_V1}
use compiler.driver.cache.package_tldr_metadata.{ConfigVariantKeyV1}
use std.scv.compile_source_inventory_core.{CompileSourceInventoryEntryV1, CompileSourceInventoryV1, compile_source_inventory_digest_v1}
use std.common.crypto.sha256.{sha256_text}

extern fn rt_getpid() -> i64
extern fn rt_time_now_unix_micros() -> i64

fn compact_module(name: text, imports: [HirImport]) -> HirModule:
    HirModule(name: name, path: "/frozen/{name}.spl", imports: imports,
        exports: [], domain_blocks: [], symbols: SymbolTable.new(),
        functions: {}, gpu_function_targets: {},
        gpu_function_backend_orders: {}, classes: {}, structs: {}, enums: {},
        bitfields: {}, traits: {}, impls: [], constants: {},
        static_asserts: [], aop_advices: [], di_bindings: [], arch_rules: [],
        mock_decls: [], types: [], extend_enums: [])

fn compact_inventory() -> CompileSourceInventoryV1:
    val empty = sha256_text("")
    CompileSourceInventoryV1(1, 1, [
        CompileSourceInventoryEntryV1("a.spl", sha256_text("source-a"),
            empty, empty, empty, empty, 8),
        CompileSourceInventoryEntryV1("b.spl", sha256_text("source-b"),
            empty, empty, empty, empty, 8)])

fn compact_authority(digest: text) -> PackageModuleIndexBuildAuthorityV1:
    PackageModuleIndexBuildAuthorityV1(
        sha256_text("producer"), "root", "revision", "commit", "tree",
        digest, ConfigVariantKeyV1("aarch64-unknown-linux-gnu", "llvm-lib",
            [], "debug", "abi-v1", [], []))

fn compact_output(module: HirModule, inventory: CompileSourceInventoryV1,
    digest: text) -> ColdHirPackageOutputV1:
    val source = "source-{module.name}"
    val seed: ColdHirSemanticSeedV1 = cold_hir_semantic_seed_v1(
        module, "/frozen", "{module.name}.spl", source,
        inventory, digest).unwrap()
    ColdHirPackageOutputV1(seed, hir_abi_interface_encoded_v1(module).unwrap(),
        "package-{module.name}", sha256_text(source),
        sha256_text("export-{module.name}"),
        sha256_text("initializer-{module.name}"),
        sha256_text("provider-{module.name}"), sha256_text(""),
        sha256_text("interface-archive-{module.name}"),
        sha256_text("action-archive-{module.name}"), "",
        PACKAGE_MODULE_INDEX_NO_MANIFEST_DIGEST_V1)

fn compact_persisted_archive_fixture(root: text) ->
        (PackageModuleIndexBuildAuthorityV1, CompileSourceInventoryV1,
         ColdHirPackageOutputV1, bool):
    val empty = sha256_text("")
    val inventory = CompileSourceInventoryV1(1, 1, [
        CompileSourceInventoryEntryV1("a.spl", sha256_text("source-a"),
            empty, empty, empty, empty, 8)])
    val authority = compact_authority(
        compile_source_inventory_digest_v1(inventory))
    val module = compact_module("a", [])
    var output = compact_output(
        module, inventory, authority.inventory_digest)
    val symbol_digest = sha256_text("foo")
    val compile_digest = sha256_text("compile")
    val interface_content = "symbol|foo|function|i64|{symbol_digest}"
    val action_content = "action|compile|function|foo|{compile_digest}"
    output.interface_archive_digest = sha256_text(interface_content)
    output.action_archive_digest = sha256_text(action_content)
    val preview = cold_hir_package_index_from_outputs_v1(
        authority, inventory, [output])
    if preview.is_err():
        return (authority, inventory, output, false)
    val generation = preview.unwrap()
    val entry = generation.entries[0]
    val archive_authority = PackageArchiveAuthorityV1(
        generation.producer_digest, generation.root_generation,
        generation.variant_digest, generation.scv_revision_id,
        generation.scv_tree_id, generation.inventory_digest)
    val published = package_archive_publish_scc_v1(
        root, entry.scc_identity, archive_authority,
        [PackageArchivePublishInputV1(
            entry, [], interface_content, action_content, true)])
    (authority, inventory, output, published)

describe "compact typed-HIR outputs to complete V2 index":
    it "derives reverse edges and builds a complete graph without HIR bodies":
        val inventory = compact_inventory()
        val digest = compile_source_inventory_digest_v1(inventory)
        val a = compact_module("a", [HirImport("b", [], false, Span.empty())])
        val b = compact_module("b", [])
        val built = cold_hir_package_index_from_outputs_v1(
            compact_authority(digest), inventory,
            [compact_output(a, inventory, digest),
             compact_output(b, inventory, digest)])
        expect(built.is_ok()).to_be(true)
        if built.is_err():
            print "compact-index-error={built.unwrap_err()}"
        else:
            val generation = built.unwrap()
            expect(generation.schema_version).to_equal(2)
            expect(generation.entries.len()).to_equal(2)
            expect(generation.entries[0].direct_imports).to_equal(["b"])
            expect(generation.entries[1].reverse_dependents).to_equal(["a"])

    it "rejects stale ABI bytes and incomplete source coverage":
        val inventory = compact_inventory()
        val digest = compile_source_inventory_digest_v1(inventory)
        val a = compact_module("a", [])
        val b = compact_module("b", [])
        var bad = compact_output(a, inventory, digest)
        bad.abi_payload = "stale"
        val stale = cold_hir_package_index_from_outputs_v1(
            compact_authority(digest), inventory,
            [bad, compact_output(b, inventory, digest)])
        expect(stale.is_err()).to_be(true)
        expect(stale.unwrap_err()).to_equal("cold-export-smf-typed-abi-mismatch")
        val incomplete = cold_hir_package_index_from_outputs_v1(
            compact_authority(digest), inventory,
            [compact_output(b, inventory, digest)])
        expect(incomplete.is_err()).to_be(true)
        expect(incomplete.unwrap_err()).to_equal(
            "index-builder-source-coverage-incomplete")

    it "publishes only after decoding a persisted package archive":
        val root = "build/tmp/cold-hir-publish/{rt_getpid()}-{rt_time_now_unix_micros()}"
        val (authority, inventory, output, archive_published) =
            compact_persisted_archive_fixture(root)
        expect(archive_published).to_be(true)
        val published = cold_hir_package_publish_verified_v1(
            root, authority, inventory, [output], "")
        expect(published.is_ok()).to_be(true)
        if published.is_err():
            print "cold-publish-error={published.unwrap_err()}"
        val current = package_module_index_read_current_v1(root)
        expect(current.valid).to_be(true)
        if current.valid:
            expect(current.generation!.entries.len()).to_equal(1)

    it "rejects mismatched archive payload before moving CURRENT":
        val root = "build/tmp/cold-hir-reject/{rt_getpid()}-{rt_time_now_unix_micros()}"
        val (authority, inventory, output, archive_published) =
            compact_persisted_archive_fixture(root)
        expect(archive_published).to_be(true)
        var stale = output
        stale.interface_archive_digest = sha256_text("stale-interface")
        val rejected = cold_hir_package_publish_verified_v1(
            root, authority, inventory, [stale], "")
        expect(rejected.is_err()).to_be(true)
        if rejected.is_err():
            expect(rejected.unwrap_err()).to_equal(
                "cold-publish-archive-payload-mismatch:a")
        expect(package_module_index_read_current_v1(root).valid).to_be(false)
