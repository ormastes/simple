# @req REQ-CSM-007 REQ-CSM-008 REQ-CSM-009
# @cover src/compiler/80.driver/cache/journal/action_root_journal_v1.spl 85%
# @cover src/compiler/80.driver/cache/journal/checkpoint_superblock_v1.spl 85%
# @cover src/compiler/80.driver/cache/catalog/cache_catalog_projection.spl 85%
# @cover src/compiler/80.driver/cache/gateway/cache_writer_v1.spl 85%
# @cover src/compiler/80.driver/cache/gateway/cache_gateway_adapter.spl 85%

use std.spec.{describe, it, expect}
use std.spec.step
use std.common.crypto.sha256 (sha256_text)
use compiler.common.cache_contract.cache_gateway_v1.*
use compiler.common.cache_contract.errors_v1 (CacheErrorCodeV1)
use compiler.driver.cache.journal.action_root_journal_v1.*
use compiler.driver.cache.journal.checkpoint_superblock_v1.*
use compiler.driver.cache.catalog.cache_catalog_projection.*
use compiler.driver.cache.gateway.cache_writer_v1.*
use compiler.driver.cache.gateway.cache_gateway_adapter.*
use compiler.driver.cache.summary.summary_store_v1.{SummaryStoreV1, VirtualSourceStoreAdapterV1}

fn digest(ch: text) -> text:
    ch.repeat(64)

fn epoch(generation: i64) -> CacheWriterEpochV1:
    CacheWriterEpochV1(epoch_uuid: digest("1"), owner_instance_nonce: digest("2"),
        peer_user_id: "local-user", boot_identity_digest: digest("3"), acquired_monotonic_nonce: 1,
        protocol_digest: digest("4"), expires_or_lease_generation: generation,
        authentication_digest: digest("5"))

describe "action-root journal recovery":
    it "accepts a checksummed prefix and quarantines a torn tail":
        step("Recover only complete ordered journal records")
        val journal = ActionRootJournalV1.empty(7)
        journal.append(digest("a"), "file_ast", digest("b"), digest("c")).unwrap()
        journal.append(digest("d"), "public_summary", digest("e"), digest("f")).unwrap()
        val recovered = recover_action_root_journal_v1(journal.bytes + "2|torn", 7)
        expect(recovered.records.len()).to_equal(2)
        expect(recovered.accepted_bytes).to_equal(journal.bytes.len())
        expect(recovered.quarantined_tail).to_equal(true)

    it "rejects checksum corruption without accepting later records":
        step("Stop recovery at the first corrupt record")
        val journal = ActionRootJournalV1.empty(2)
        journal.append(digest("a"), "file_ast", digest("b"), digest("c")).unwrap()
        val corrupt = journal.bytes.slice(0, journal.bytes.len() - 2) + "0\n"
        val recovered = recover_action_root_journal_v1(corrupt, 2)
        expect(recovered.records.len()).to_equal(0)
        expect(recovered.quarantined_tail).to_equal(true)

describe "two-generation checkpoint selection":
    it "falls back to the prior valid generation after a torn newest slot":
        step("Select the highest checksum-valid superblock slot")
        val journal = "record-one\n"
        val superblock = CheckpointSuperblockV1.empty()
        val first = superblock.publish(journal, digest("a"))
        val second = superblock.publish(journal, digest("b"))
        superblock.slot_b = Some(CheckpointSlotV1(generation: second.generation,
            journal_bytes: second.journal_bytes, journal_digest: second.journal_digest,
            catalog_digest: second.catalog_digest, checksum: digest("0")))
        val selected = superblock.select(journal)
        expect(selected.present).to_equal(true)
        expect(selected.slot?.generation).to_equal(first.generation)

describe "rebuildable catalog and private writer authority":
    it "rebuilds equivalent projection state from authoritative journal records":
        step("Discard and replay the PureDB catalog projection")
        val journal = ActionRootJournalV1.empty(9)
        val first = journal.append(digest("a"), "file_ast", digest("b"), digest("c")).unwrap()
        val second = journal.append(digest("d"), "public_summary", digest("e"), digest("f")).unwrap()
        val catalog = CacheCatalogProjectionV1.memory().unwrap()
        catalog.rebuild([first, second], 9).unwrap()
        val before = catalog.digest().unwrap()
        catalog.clear().unwrap()
        catalog.rebuild(journal.recover().records, 9).unwrap()
        expect(catalog.digest().unwrap()).to_equal(before)
        expect(catalog.lookup(digest("d")).unwrap().object_digest).to_equal(digest("e"))

    it "quarantines same-action different-output nondeterminism":
        step("Make conflicting action roots permanently non-authoritative")
        val journal = ActionRootJournalV1.empty(3)
        val catalog = CacheCatalogProjectionV1.memory().unwrap()
        val owner = epoch(3)
        val writer = cache_writer_token_v1(owner)
        cache_writer_append_v1(writer, owner, journal, catalog,
            digest("a"), "file_ast", digest("b"), digest("c")).unwrap()
        val conflict = cache_writer_append_v1(writer, owner, journal, catalog,
            digest("a"), "file_ast", digest("d"), digest("c"))
        expect(conflict.is_err()).to_equal(true)
        expect(conflict.unwrap_err().code).to_equal(CacheErrorCodeV1.CacheNondeterminism)
        expect(catalog.lookup(digest("a")).unwrap().quarantined).to_equal(true)

    it "rejects a stale writer epoch before journal mutation":
        step("Require the exact opaque writer epoch binding")
        val journal = ActionRootJournalV1.empty(4)
        val catalog = CacheCatalogProjectionV1.memory().unwrap()
        val admitted = epoch(4)
        val stale = cache_writer_token_v1(epoch(3))
        val result = cache_writer_append_v1(stale, admitted, journal, catalog,
            digest("a"), "file_ast", digest("b"), digest("c"))
        expect(result.is_err()).to_equal(true)
        expect(journal.bytes).to_equal("")

describe "generation-first cache gateway":
    it "never promotes a catalog row to a hit without anchored CAS bytes":
        step("Validate the extended pin then fail closed as a typed miss")
        val catalog = CacheCatalogProjectionV1.memory().unwrap()
        catalog.apply(ActionRootRecordV1(sequence: 0, action_digest: digest("a"),
            object_kind: "file_ast", object_digest: digest("b"), manifest_digest: digest("c")), 6).unwrap()
        val summary = SummaryStoreV1.memory().unwrap()
        val gateway = CacheGatewayAdapterV1(catalog: catalog,
            summaries: VirtualSourceStoreAdapterV1.new(summary, digest("9")),
            process_instance_nonce: digest("1"), boot_identity_digest: digest("2"),
            reader_admission_epoch: 8, journal_generation: 6,
            pinned_manifest_digest: digest("3"), monotonic_now: 100, next_pin: 0)
        val pin = gateway.begin_direct_read(10).unwrap()
        val lookup = gateway.lookup_verified_action(digest("a"), pin).unwrap()
        expect(lookup.present).to_equal(false)
        expect(lookup.canonical_bytes.len()).to_equal(0)

    it "rejects a pin from a different journal generation":
        step("Compare generation before consulting the catalog")
        val catalog = CacheCatalogProjectionV1.memory().unwrap()
        val summary = SummaryStoreV1.memory().unwrap()
        val gateway = CacheGatewayAdapterV1(catalog: catalog,
            summaries: VirtualSourceStoreAdapterV1.new(summary, digest("9")),
            process_instance_nonce: digest("1"), boot_identity_digest: digest("2"),
            reader_admission_epoch: 8, journal_generation: 6,
            pinned_manifest_digest: digest("3"), monotonic_now: 100, next_pin: 0)
        var pin = gateway.begin_direct_read(10).unwrap()
        pin.journal_superblock_generation = 5
        expect(gateway.lookup_verified_action(digest("a"), pin).is_err()).to_equal(true)
