# @req PSI-REQ-007
# Content-owner evidence only: full local semantic admission remains separate.
use std.spec.{describe, it, expect, step}
use std.common.crypto.sha256.{sha256_text}
use app.test.package_index_acceptance_remote.{package_index_acceptance_remote_v1}

describe "remote acceptance content owner adapter":
    it "reports exact locally authenticated payload evidence":
        step("Admit untrusted remote content locally")
        val observed = package_index_acceptance_remote_v1("remote-cache-local-admission")
        expect(observed.supported).to_equal(true)
        expect(observed.content_verified).to_equal(true)
        expect(observed.reason).to_equal("content-verified")
        expect(observed.expected_manifest_digest.len()).to_equal(64)
        expect(observed.observed_manifest_digest).to_equal(observed.expected_manifest_digest)
        expect(observed.artifact_count).to_equal(1)
        expect(observed.observed_artifact_digest).to_equal(
            sha256_text("package-index-acceptance-remote-artifact"))

    it "reports poisoned bytes rejected despite a lying transport hash":
        step("Admit untrusted remote content locally")
        val observed = package_index_acceptance_remote_v1("remote-cache-poison-denied")
        expect(observed.supported).to_equal(true)
        expect(observed.content_verified).to_equal(false)
        expect(observed.reason).to_equal("artifact-digest-mismatch:" +
            sha256_text("package-index-acceptance-remote-artifact"))
        expect(observed.observed_manifest_digest).to_equal("")
        expect(observed.artifact_count).to_equal(0)
        expect(observed.observed_artifact_digest).to_equal(sha256_text("poisoned-remote-artifact"))

    it "does not relabel an unknown scenario as successful content admission":
        val observed = package_index_acceptance_remote_v1("unknown")
        expect(observed.supported).to_equal(false)
        expect(observed.content_verified).to_equal(false)
        expect(observed.reason).to_equal("unsupported-remote-scenario")
        expect(observed.expected_manifest_digest).to_equal("")
        expect(observed.artifact_count).to_equal(0)
