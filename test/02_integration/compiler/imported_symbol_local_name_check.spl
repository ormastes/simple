# Native component: the three compatibility imports must resolve real source
# declarations. No seed intrinsic, source scan or process fallback is an oracle.
use compiler.hir.hir_lowering._Items.lowering_helpers.{imported_symbol_local_name}
use compiler.hir.hir_lowering.items.{imported_symbol_local_name as items_local_name}
use compiler.hir.hir.{imported_symbol_local_name as hir_local_name}
use compiler.hir.hir_lowering.{imported_symbol_local_name as package_local_name}

fn main() -> i32:
    assert(imported_symbol_local_name("probe", true, "aliased_probe") == "aliased_probe")
    assert(items_local_name("probe", true, "aliased_probe") == "aliased_probe")
    assert(hir_local_name("probe", true, "aliased_probe") == "aliased_probe")
    assert(package_local_name("probe", true, "aliased_probe") == "aliased_probe")
    assert(imported_symbol_local_name("probe", false, "ignored_alias") == "probe")
    assert(items_local_name("probe", false, "ignored_alias") == "probe")
    assert(hir_local_name("probe", false, "ignored_alias") == "probe")
    assert(package_local_name("probe", false, "ignored_alias") == "probe")
    assert(imported_symbol_local_name("probe", true, "") == "")
    assert(imported_symbol_local_name("probe", true, "probe") == "probe")
    print "IMPORTED_SYMBOL_LOCAL_NAME_COMPONENT_PASS"
    0
