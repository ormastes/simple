# Bounded native reproducer for the CAS batch generation serializer.
fn main() -> i64:
    val schema = "simple-cas-batch-v1"
    val generation = "generation=0123456789abcdef"
    val parent = "parent="
    val scc = "scc=probe"
    val inherited: [text] = []
    val mappings = ["pkg|action-digest|receipt-digest"]
    val content = [schema, generation, parent, scc].concat(inherited).concat(mappings).join("\n")
    val expected = "simple-cas-batch-v1\ngeneration=0123456789abcdef\nparent=\nscc=probe\npkg|action-digest|receipt-digest"
    print "generation-bytes={content.bytes().len()} expected-bytes={expected.bytes().len()}"
    val direct = [schema, generation, parent, scc, mappings[0]].join("\n")
    var pushed = [schema, generation, parent, scc]
    pushed = pushed.push(mappings[0])
    val pushed_text = pushed.join("\n")
    val plus = schema + "\n" + generation + "\n" + parent + "\n" + scc + "\n" + mappings[0]
    val interpolated = "{schema}\n{generation}\n{parent}\n{scc}\n{mappings[0]}"
    print "direct={direct.bytes().len()} pushed={pushed_text.bytes().len()} plus={plus.bytes().len()} interpolated={interpolated.bytes().len()}"
    if direct != expected or pushed_text != expected or plus != expected or interpolated != expected:
        print "generation-alternative-mismatch"
        return 1
    print "generation-alternatives-ok"
    0
