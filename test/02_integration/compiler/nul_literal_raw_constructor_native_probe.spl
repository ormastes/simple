# Independent byte assertions, without JSON or slicing. Run with an actually
# rebuilt candidate compiler; the historical d356 producer remains defective.
fn unchanged(value: text) -> text:
    value

fn returned() -> text:
    "A\0é"

fn bytes_equal(value: text, expected: [i64]) -> bool:
    if value.len() != expected.len():
        return false
    for i in 0..expected.len():
        if value.byte_at(i) as i64 != expected[i]:
            return false
    true

fn main() -> i64:
    val local = "A\0é"
    if not bytes_equal(local, [65, 0, 195, 169]):
        print "FAIL NUL literal local"
        return 1
    if not bytes_equal(unchanged("A\0é"), [65, 0, 195, 169]):
        print "FAIL NUL literal argument"
        return 2
    if not bytes_equal(returned(), [65, 0, 195, 169]):
        print "FAIL NUL literal return"
        return 3
    if not bytes_equal("\0A", [0, 65]):
        print "FAIL leading NUL"
        return 4
    if not bytes_equal("A\0", [65, 0]):
        print "FAIL trailing NUL"
        return 5
    if not bytes_equal("", []):
        return 6
    if not bytes_equal("ABC", [65, 66, 67]):
        return 7
    if not bytes_equal("é", [195, 169]):
        return 8
    print "NUL literal constructor probe: PASS"
    0
