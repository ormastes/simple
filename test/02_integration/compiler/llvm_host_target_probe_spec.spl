use std.spec.{describe, it, expect}
use std.io_runtime.{host_arch, host_os}
use compiler_shared.interpreter.llvm.target.{
    detect_host_arch_string, detect_host_os_string
}

describe "LLVM host target detection":
    it "uses the host architecture and OS on Linux":
        expect(detect_host_arch_string().len()).to_be_greater_than(0)
        expect(detect_host_os_string().len()).to_be_greater_than(0)
        if host_os() == "linux":
            expect(detect_host_arch_string()).to_equal(host_arch())
            expect(detect_host_os_string()).to_equal("linux")
