"""Fresh-process production probe for standalone lint parser preparation.

The first parser action in main is lint_cli_source.  No parser init or frontend
streaming preparation is allowed before it, so a native run proves the direct
lint entry prepares persistent parser owners outside transient scopes.
"""

use std.spec.{describe, it, expect}
use compiler.tools.lint._LintMain.config_and_model.{Linter, LintRunResult}
use compiler.tools.lint._LintMain.entry_and_fixes.{lint_cli_source}
use compiler.core.ast.{
    EXPR_IDENT, STMT_BLOCK, STMT_IF, STMT_MATCH,
    arm_get_pattern, arm_get_rationale, decl_get_body,
    expr_get_str, expr_get_tag, module_get_decls,
    stmt_get_body, stmt_get_if_single_else, stmt_get_name,
    stmt_get_tag, stmt_is_if_val_decl
}

fn diagnostic_count(results: [LintRunResult], code: text) -> i64:
    var count = 0
    for result in results:
        if result.lint.code == code:
            count = count + 1
    count

fn binding_metadata_is_well_formed(arm_offset: i64) -> bool:
    val decls = module_get_decls()
    if decls.len() != 1:
        return false
    val body = decl_get_body(decls[0])
    if body.len() < 1:
        return false
    var current_stmt = body[0]
    var offset = 0
    while offset < arm_offset:
        if stmt_get_tag(current_stmt) == STMT_IF:
            current_stmt = stmt_get_if_single_else(current_stmt)
        else:
            return false
        if current_stmt < 0:
            return false
        offset = offset + 1
    if stmt_get_tag(current_stmt) != STMT_BLOCK:
        return false
    val block_stmts = stmt_get_body(current_stmt)
    if block_stmts.len() != 2:
        return false
    val bind_stmt = block_stmts[0]
    val branch_stmt = block_stmts[1]
    stmt_is_if_val_decl(bind_stmt) and
        stmt_get_name(bind_stmt) == "_" and
        stmt_get_tag(branch_stmt) == STMT_IF

fn run_binding_case(label: text, source: text, arm_offset: i64) -> bool:
    var linter = Linter.new()
    val results = lint_cli_source(linter, label + ".spl", source)
    val parse001 = diagnostic_count(results, "PARSE001")
    val metadata_ok = binding_metadata_is_well_formed(arm_offset)
    if parse001 != 0 or not metadata_ok:
        print("case=" + label +
            " PARSE001=" + parse001.to_text() +
            " metadata=" + metadata_ok.to_text())
        return false
    true

fn run_wildcard_match_cases() -> bool:
    var linter = Linter.new()
    val warn_results = lint_cli_source(
        linter,
        "unrationalized_match.spl",
        "fn f(value: i64) -> i64:\n    match value:\n        case 0: 1\n        case _: 2\n")
    val decls_warn = module_get_decls()
    if decls_warn.len() != 1:
        return false
    val match_body_warn = decl_get_body(decls_warn[0])
    if match_body_warn.len() != 1 or stmt_get_tag(match_body_warn[0]) != STMT_MATCH:
        return false
    val warn_arms = stmt_get_body(match_body_warn[0])
    if warn_arms.len() != 2:
        return false
    val warn_pat = arm_get_pattern(warn_arms[1])
    val warn_ast_ok = (expr_get_tag(warn_pat) == EXPR_IDENT and
        expr_get_str(warn_pat) == "_" and
        arm_get_rationale(warn_arms[1]) == "")
    if diagnostic_count(warn_results, "REQC004") != 1 or
            diagnostic_count(warn_results, "PARSE001") != 0 or not warn_ast_ok:
        return false

    var clean_linter = Linter.new()
    val clean_results = lint_cli_source(
        clean_linter,
        "rationalized_match.spl",
        "fn f(value: i64) -> i64:\n    match value:\n        case 0: 1\n        case _(\"all non-zero values intentionally map to 2\"): 2\n")
    diagnostic_count(clean_results, "REQC004") == 0 and
        diagnostic_count(clean_results, "PARSE001") == 0

fn run_rationalized_if_val_case() -> bool:
    var linter = Linter.new()
    val results = lint_cli_source(
        linter,
        "rationalized_wildcard.spl",
        "fn f(value: i64?):\n    if val _(\"all values intentionally ignored here\") = value:\n        return\n")
    val decls = module_get_decls()
    if decls.len() != 1:
        return false
    val body = decl_get_body(decls[0])
    if body.len() != 1 or stmt_get_tag(body[0]) != STMT_MATCH:
        return false
    val arms = stmt_get_body(body[0])
    if arms.len() < 1:
        return false
    diagnostic_count(results, "REQC004") == 0 and
        diagnostic_count(results, "PARSE001") == 0 and
        arm_get_rationale(arms[0]) == "all values intentionally ignored here"

fn run_malformed_case() -> bool:
    var linter = Linter.new()
    val results = lint_cli_source(linter, "malformed.spl", "fn broken(")
    diagnostic_count(results, "REQC004") == 0 and
        diagnostic_count(results, "PARSE001") == 1

fn run_lint_cli_parser_prepare_probe() -> i32:
    # Keep this as the first runtime parser action: the native executable must
    # start without any prior parser_init/frontend preparation call.
    if not run_wildcard_match_cases():
        return 1
    if not run_binding_case(
        "if_val_canonical",
        "fn f(value: i64?):\n    if val _ = value:\n        return\n",
        0):
        return 1
    if not run_binding_case(
        "if_val_double_space",
        "fn f(value: i64?):\n    if  val _ = value:\n        return\n",
        0):
        return 1
    if not run_binding_case(
        "if_val_tab",
        "fn f(value: i64?):\n    if\tval _ = value:\n        return\n",
        0):
        return 1
    if not run_binding_case(
        "if_var_canonical",
        "fn f(value: i64?):\n    if var _ = value:\n        return\n",
        0):
        return 1
    if not run_binding_case(
        "if_var_double_space",
        "fn f(value: i64?):\n    if  var _ = value:\n        return\n",
        0):
        return 1
    if not run_binding_case(
        "if_var_tab",
        "fn f(value: i64?):\n    if\tvar _ = value:\n        return\n",
        0):
        return 1
    if not run_binding_case(
        "elif_var_canonical",
        "fn f(value: i64?):\n    if false:\n        return\n    elif var _ = value:\n        return\n",
        1):
        return 1
    if not run_binding_case(
        "elif_var_double_space",
        "fn f(value: i64?):\n    if false:\n        return\n    elif  var _ = value:\n        return\n",
        1):
        return 1
    if not run_binding_case(
        "elif_var_tab",
        "fn f(value: i64?):\n    if false:\n        return\n    elif\tvar _ = value:\n        return\n",
        1):
        return 1
    if not run_rationalized_if_val_case():
        print("case=rationalized_wildcard expected=REQC004:0,PARSE001:0")
        return 1
    if not run_malformed_case():
        print("case=malformed expected=REQC004:0,PARSE001:1")
        return 1
    print("lint_cli_parser_prepare_probe=PASS binding_cases=9 metadata_cases=9 rationalized=1 malformed=1")
    0

fn main() -> i32:
    run_lint_cli_parser_prepare_probe()

describe "lint_cli_source standalone parser preparation probe":
    it "prepares persistent parser owners and validates REQC004, PARSE001, and binding AST metadata":
        expect(run_lint_cli_parser_prepare_probe()).to_equal(0)
