"""
## Purpose and audience
Proves the Rust seed accepts the node-attribute surface syntax without a compile
error: `@node_tree` classes, `@attr_storage` class hints and field pins, and the
`compiler.ast` SDN data-policy rule file. The seed does not implement the
storage; the pure-Simple compiler does. Readers are bootstrap maintainers.
Category: Infrastructure.
## Operator workflow
bin/simple test test/02_integration/compiler/data/node_attr_seed_acceptance_spec.spl
## Compatibility and limitations
Seed interpreter lane only. Acceptance is parse/load, not storage behaviour.
## Verification guidance and troubleshooting
A RED here means a seed regression on annotation syntax; fix the seed parser,
never remove the annotation from the compiler sources.
"""
# @req NODEATTR-SEED-01 NODEATTR-SEED-02 NODEATTR-SEED-03
# @manual_section: Seed acceptance of node attribute annotations

use std.spec.*
use std.nogc_sync_mut.io.file.{file_read}
use std.common.sdn.parser.{parse_with_spans_and_issues}
use compiler.frontend.generated.binary_expr_view.{BinaryExprView}

@node_tree("seed.accept")
@attr_storage("column")
class SeedAcceptNode:
    @attr_storage("sparse_hash")
    inferred: text
    @attr_storage("direct")
    span: i64
    op: i64

describe "seed acceptance of node attribute annotations":
    it "loads an annotated @node_tree class with class hint and field pins":
        val n = SeedAcceptNode(inferred: "t", span: 3, op: 7)
        expect(n.span).to_equal(3)
        expect(n.op).to_equal(7)
        expect(n.inferred).to_equal("t")

    it "loads the committed generated @node_tree view":
        val v = BinaryExprView(node: 0)
        expect(v.node).to_equal(0)

    it "parses the compiler.ast SDN data-policy rule file without error":
        val text = file_read("config/data_policy/compiler_ast_binary_expr.sdn")
        match parse_with_spans_and_issues(text):
            case Ok((root, _spans, _issues)):
                expect(root.get("data_policy").?).to_equal(true)
            case Err(e):
                fail("SDN rule file rejected: {e}")
