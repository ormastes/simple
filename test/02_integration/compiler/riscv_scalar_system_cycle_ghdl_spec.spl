use std.spec.*
use app.io.vhdl_ffi.{ghdl_available, ghdl_analyze, ghdl_elaborate,
    ghdl_run, vhdl_write_file}
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.backend.backend.riscv_scalar_product_to_vhdl.{
    compile_strict_riscv_scalar_product}

fn system_product_testbench(entity_name: text, tb_name: text,
    privilege: text, expected_cause: text, expected_tval: text) -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n" +
    "use std.env.all; entity " + tb_name + " is end entity;\n" +
    "architecture sim of " + tb_name + " is\n" +
    " signal clk,rst,in_valid,retire_ready: std_logic := '0';\n" +
    " signal in_ready,retire_valid,retire_trap,retire_interrupt,protocol_fault: std_logic;\n" +
    " signal retire_order: std_logic_vector(63 downto 0);\n" +
    " signal retire_original,retire_canonical,retire_pc_before,retire_pc_after: std_logic_vector(31 downto 0);\n" +
    " signal retire_length: std_logic_vector(2 downto 0); signal retire_rd: std_logic_vector(4 downto 0);\n" +
    " signal retire_rd_write: std_logic; signal retire_read_mask,retire_write_mask: std_logic_vector(31 downto 0);\n" +
    " signal retire_cause,retire_tval: std_logic_vector(31 downto 0); begin\n" +
    " clk <= not clk after 5 ns;\n" +
    " dut: entity work." + entity_name + " port map(clk=>clk,rst=>rst,retire_ready=>retire_ready," +
    "illegal_valid=>'0',interrupt_valid=>'0',interrupt_cause=>(others=>'0')," +
    "interrupt_event_id=>(others=>'0'),provider_event_id=>std_logic_vector(to_unsigned(7,64))," +
    "decode_event_id=>std_logic_vector(to_unsigned(7,64)),interrupt_held=>'0',between_events=>'0'," +
    "in_order=>std_logic_vector(to_unsigned(7,64)),in_privilege=>\"" + privilege + "\"," +
    "in_pc=>x\"00000100\",in_valid=>in_valid,in_ready=>in_ready," +
    "dispatch_accept=>open,retire_valid=>retire_valid,retire_order=>retire_order," +
    "protocol_fault=>protocol_fault,retire_xlen=>open,retire_privilege=>open," +
    "retire_original_instruction=>retire_original,retire_canonical_instruction=>retire_canonical," +
    "retire_instruction_length_bytes=>retire_length,retire_pc_before=>retire_pc_before,retire_pc_after=>retire_pc_after," +
    "retire_rd=>retire_rd,retire_rd_write=>retire_rd_write,retire_rd_value=>open,retire_memory_address=>open," +
    "retire_memory_read_mask=>retire_read_mask,retire_memory_write_mask=>retire_write_mask,retire_memory_read_data=>open," +
    "retire_memory_write_data=>open,retire_trap=>retire_trap,retire_interrupt=>retire_interrupt," +
    "retire_cause=>retire_cause,retire_tval=>retire_tval);\n" +
    " process begin rst<='1'; wait until rising_edge(clk); wait until rising_edge(clk); rst<='0'; wait for 1 ns;\n" +
    " assert in_ready='1' report \"system product not ready after reset\" severity failure;\n" +
    " in_valid<='1'; wait until rising_edge(clk); in_valid<='0'; wait for 1 ns;\n" +
    " for i in 0 to 4 loop exit when retire_valid='1'; wait until rising_edge(clk); wait for 1 ns; end loop;\n" +
    " assert retire_valid='1' and retire_trap='1' and retire_interrupt='0' report \"system trap missing\" severity failure;\n" +
    " assert retire_cause=x\"" + expected_cause + "\" and retire_tval=x\"" + expected_tval + "\" report \"system trap payload mismatch\" severity failure;\n" +
    " assert retire_original=retire_canonical and retire_length=\"100\" report \"system instruction lineage mismatch\" severity failure;\n" +
    " assert retire_pc_before=x\"00000100\" and retire_pc_after=x\"00000104\" report \"system PC lineage mismatch\" severity failure;\n" +
    " assert retire_rd=\"00000\" and retire_rd_write='0' and retire_read_mask=x\"00000000\" and retire_write_mask=x\"00000000\" report \"system side effect was not suppressed\" severity failure;\n" +
    " assert retire_order=std_logic_vector(to_unsigned(0,64)) report \"retirement owner did not assign first order\" severity failure;\n" +
    " wait until rising_edge(clk); wait for 1 ns; assert retire_valid='1' and retire_cause=x\"" + expected_cause + "\" and retire_tval=x\"" + expected_tval + "\" report \"system trap payload was not held\" severity failure;\n" +
    " retire_ready<='1'; wait until rising_edge(clk); retire_ready<='0'; wait for 1 ns;\n" +
    " assert retire_valid='0' report \"system trap did not consume exactly once\" severity failure;\n" +
    " assert protocol_fault='0' report \"unexpected system protocol fault\" severity failure; finish; end process;\n" +
    "end architecture;\n"

fn run_system_case(entity_name: text, tb_name: text, instruction: u32,
    privilege: text, cause: text, tval: text) -> bool:
    val emitted = compile_strict_riscv_scalar_product(entity_name, CoreConfig.rv32(),
        instruction, LsuConfig.rv32_product_default())
    if not emitted.is_success(): return false
    val path = "/tmp/" + entity_name + ".vhd"
    if not vhdl_write_file(path, emitted.vhdl + "\n" +
        system_product_testbench(entity_name, tb_name, privilege, cause, tval)): return false
    if not ghdl_analyze(path).success: return false
    if not ghdl_elaborate(tb_name).success: return false
    ghdl_run(tb_name, Some("500ns")).success

describe "RISC-V Gen2 closed system-exception cycle evidence":
    # @req REQ-G2-012 REQ-G2-014 NFR-G2-015
    slow_it "retires ECALL and EBREAK once through skid trap and retirement ownership when GHDL exists":
        if not ghdl_available():
            print "SKIP: GHDL not available"
            return
        expect(run_system_case("scalar_system_ecall_cycle", "scalar_system_ecall_cycle_tb",
            0x00000073, "00", "00000008", "00000000")).to_equal(true)
        expect(run_system_case("scalar_system_ebreak_cycle", "scalar_system_ebreak_cycle_tb",
            0x00100073, "11", "00000003", "00000000")).to_equal(true)
        expect(run_system_case("scalar_system_reserved_priv_cycle",
            "scalar_system_reserved_priv_cycle_tb", 0x00000073, "10",
            "00000002", "00000073")).to_equal(true)
