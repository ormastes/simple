# @engine-reach: native-by-compile — the checker invokes `compile --native`
# and executes the resulting standalone candidate before returning a verdict.
"""
# Native method-resolution compiler integration

Runs the real compiler boundary with stub fallback disabled. This is distinct
from the unit match matrix: it catches representation mistakes introduced while
the compiler lowers a payload enum, recovers a static type owner, and lowers an
inferred array receiver in the same native module.
"""

extern fn rt_process_run(program: text, args: [text]) -> (text, text, i64)

describe "Native method-resolution compiler integration":
    it "should compile and execute the payload-enum receiver fixture":
        val (stdout, stderr, status) = rt_process_run("sh", [
            "scripts/check/check-native-method-resolution-payload-enum.shs"
        ])
        expect(status).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("STATUS: PASS native-method-resolution")
        expect(stdout).to_contain("payload-variants=5")
        expect(stdout).to_contain("static-factory=pass")
        expect(stdout).to_contain("inferred-push=pass")
        expect(stdout).to_contain("constant-inference=pass")
        expect(stdout).to_contain("const:41:2.5:true:folded:42")
