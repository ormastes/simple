"""
## Purpose and audience
For compiler/interpreter maintainers. Exercises the complete Simple
compiler-and-interpreter pipeline end to end -- source text in, real
process exit code and stdout/stderr out -- covering compilation of core
language constructs, symbol/generic/trait/UFCS resolution, type-inference
observable effects, parse/compile/runtime error propagation, the module
system, and process-level failure modes (stack overflow). Each scenario
invokes the deployed seed binary (`src/compiler_rust/target/bootstrap/simple
run <file>`) as a real subprocess against a small generated fixture program,
which is the only way to observe true end-to-end pipeline behavior from a
spec without embedding the compiler's internals.
## Operator workflow
Run after touching the parser, HIR/MIR lowering, symbol resolution, or the
interpreter's error reporting: `bin/simple test
test/02_integration/compiler/compiler_interpreter_integration_spec.spl`.
Each scenario writes a tiny fixture `.spl` program under `build/tmp/`,
runs it as a subprocess, and checks the real exit code and/or
stdout/stderr text.
## Compatibility and limitations
This file was originally 25 `pass`-only scaffolds gated on parser/runtime
integration that did not exist when it was written; the pipeline is now
self-hosted and these scenarios exercise it for real via subprocess. A
handful of scenarios (module hot-reload, cache eviction, leak detection,
refcount introspection) still have no observable public API anywhere under
`src/` (verified by repo-wide grep) and are gated as fail-closed tripwires
instead of faked assertions -- see the `# NOTE:` at each such scenario.
Several other scenarios asserted a DESIRED contract (export-visibility
enforcement, circular-import detection, static type-mismatch rejection,
error line/column reporting) that the current pipeline does not yet
provide; those are left legitimately RED with a `# NOTE:` citing the
measured gap, per this repo's testing rules -- never weakened to pass.
## Verification guidance and troubleshooting
A failure names the fixture program and the expected exit code/output
substring. Re-run the failing fixture directly with
`src/compiler_rust/target/bootstrap/simple run <fixture path>` (the helper
leaves fixtures under `build/tmp/compiler_interpreter_integration/` for
inspection) to see the full compiler/interpreter diagnostic.
"""
# Lifecycle: doc/01_research/compiler/performance/interpreter_vs_codegen.md ;
# doc/03_plan/compiler/perf/compiler_interpreter_performance_program_2026-08-10.md ;
# doc/04_architecture/compiler/aspect_dynload/typed_facet_pipeline_2026-08-22.md ;
# doc/05_design/compiler/aspect_dynload/typed_facet_pipeline_2026-08-22.md
# @manual_section: compiler-interpreter-integration

use std.spec.{describe, it, expect}
use std.io_runtime.{write_file, mkdir_p, process_run_timeout}

const SIMPLE_SEED_BINARY: text = "src/compiler_rust/target/bootstrap/simple"
const FIXTURE_DIR: text = "build/tmp/compiler_interpreter_integration"

fn _run_fixture(name: text, source: text) -> (text, text, i32):
    """Write `source` to a per-scenario fixture file under FIXTURE_DIR and
    run it as a real subprocess through the deployed seed binary, returning
    (stdout, stderr, exit_code). This is genuine end-to-end pipeline
    execution, not a stub."""
    mkdir_p(FIXTURE_DIR)
    val fixture_path = FIXTURE_DIR + "/" + name + ".spl"
    write_file(fixture_path, source)
    process_run_timeout(SIMPLE_SEED_BINARY, ["run", fixture_path], 30000)


# ============================================================================
# Test Group 1: End-to-End Compilation
# ============================================================================

# @manual_section: e2e-compilation
describe "End-to-End Compilation":
    it "compiles and executes simple script":
        # @req REQ-COMPINT-E2E-001
        # @capture(statistics): real subprocess stdout/exit code for a print statement
        step("Compile and run a script that prints a literal value")
        val (stdout, stderr, exit_code) = _run_fixture("e2e_print", "print(42)\n")
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("42")).to_equal(true)

    it "compiles function definitions":
        # @req REQ-COMPINT-E2E-002
        # @capture(statistics): real subprocess stdout/exit code for a defined-and-called function
        step("Compile and run a script that defines and calls a two-argument function")
        val (stdout, stderr, exit_code) = _run_fixture("e2e_function",
            "fn add(a: i64, b: i64) -> i64:\n    a + b\nprint(add(3, 4))\n")
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("7")).to_equal(true)  # oracle: add(3, 4) is 7

    it "compiles class definitions":
        # @req REQ-COMPINT-E2E-003
        # @capture(statistics): real subprocess stdout/exit code for a constructed class instance
        step("Compile and run a script that constructs a class instance and reads its fields")
        val (stdout, stderr, exit_code) = _run_fixture("e2e_class",
            "class Point:\n    x: i64\n    y: i64\nval p = Point(x: 3, y: 4)\nprint(p.x + p.y)\n")
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("7")).to_equal(true)  # oracle: 3 + 4 is 7

    it "compiles struct definitions":
        # @req REQ-COMPINT-E2E-004
        # @capture(statistics): real subprocess stdout/exit code for a constructed struct instance
        step("Compile and run a script that constructs a struct instance and reads its fields")
        val (stdout, stderr, exit_code) = _run_fixture("e2e_struct",
            "struct Pair:\n    a: i64\n    b: i64\nval pr = Pair(a: 5, b: 6)\nprint(pr.a + pr.b)\n")
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("11")).to_equal(true)  # oracle: 5 + 6 is 11

    it "compiles enum definitions":
        # @req REQ-COMPINT-E2E-005
        # @capture(statistics): real subprocess stdout/exit code for an enum match expression
        step("Compile and run a script that constructs an enum variant and matches on it")
        val (stdout, stderr, exit_code) = _run_fixture("e2e_enum",
            "enum Color:\n    Red\n    Green\n    Blue\nval c = Color.Green\nmatch c:\n    case Color.Red: print(\"r\")\n    case Color.Green: print(\"g\")\n    case Color.Blue: print(\"b\")\n")
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("g")).to_equal(true)  # oracle: the constructed variant is Color.Green


# ============================================================================
# Test Group 2: Symbol Resolution Integration
# ============================================================================

# @manual_section: symbol-resolution
describe "Symbol Resolution Integration":
    it "resolves methods across compilation units":
        # @req REQ-COMPINT-SYM-001
        # @capture(statistics): real subprocess stdout/exit code for a cross-class method call
        step("Compile and run a script where one class's method is invoked from top-level code")
        val (stdout, stderr, exit_code) = _run_fixture("sym_methods",
            "class Foo:\n    pass\nimpl Foo:\n    fn bar() -> i64:\n        42\nval f = Foo()\nprint(f.bar())\n")
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("42")).to_equal(true)  # oracle: bar() is defined to return 42

    it "resolves generic instantiation":
        # @req REQ-COMPINT-SYM-002
        # @capture(statistics): real subprocess stdout/exit code for a generic identity function call
        step("Compile and run a script that instantiates a generic identity function with i64")
        val (stdout, stderr, exit_code) = _run_fixture("sym_generic",
            "fn identity<T>(x: T) -> T:\n    x\nprint(identity(42))\n")
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("42")).to_equal(true)  # oracle: identity(42) returns 42 unchanged

    it "resolves trait methods":
        # @req REQ-COMPINT-SYM-003
        # @capture(statistics): real subprocess stdout/exit code for a trait-dispatched method call
        step("Compile and run a script that implements a trait for a class and calls the trait method")
        val (stdout, stderr, exit_code) = _run_fixture("sym_trait",
            "trait Greeter:\n    fn greet() -> text\nclass Formal:\n    pass\nimpl Greeter for Formal:\n    fn greet() -> text:\n        \"Good day\"\nval f = Formal()\nprint(f.greet())\n")
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("Good day")).to_equal(true)

    it "resolves UFCS free functions":
        # @req REQ-COMPINT-SYM-004
        # @capture(statistics): real subprocess stdout/exit code for a UFCS-style free-function call
        step("Compile and run a script that calls a free function through method (UFCS) syntax")
        val (stdout, stderr, exit_code) = _run_fixture("sym_ufcs",
            "fn double(x: i64) -> i64:\n    x * 2\nval n = 21\nprint(n.double())\n")
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("42")).to_equal(true)  # oracle: 21 doubled is 42

    it "detects ambiguous method calls":
        # @req REQ-COMPINT-SYM-005
        # @capture(statistics): real subprocess exit code and stderr for two conflicting method definitions
        # NOTE: legitimate RED, verified 2026-09-06. Two `impl Box:` blocks each defining a
        # zero-arg `get()` compile and run WITHOUT any diagnostic -- the call silently resolves
        # to the last definition (11, from the second impl), matching the
        # compiler_cross_module_private_symbol_collision fallback behavior already documented
        # elsewhere in this repo (see the "$dupN" JIT fallback warning printed by every subprocess
        # invocation in this file). No ambiguity is currently detected or reported. Do not weaken
        # this assertion to accept exit 0 -- ambiguity detection is a real, undelivered feature See doc/08_tracking/bug/compiler_interpreter_integration_real_gaps_found_2026-09-06.md.
        step("Compile and run a script that defines the same method twice in two impl blocks")
        val (stdout, stderr, exit_code) = _run_fixture("sym_ambiguous",
            "class Box:\n    v: i64\nimpl Box:\n    fn get() -> i64:\n        self.v\nimpl Box:\n    fn get() -> i64:\n        self.v + 1\nval b = Box(v: 10)\nprint(b.get())\n")
        expect(exit_code).to_equal(1)  # oracle: the seed binary exits 1 on parse/compile/runtime failure
        expect(stderr.contains("ambig")).to_equal(true)


# ============================================================================
# Test Group 3: Type Inference Integration
# ============================================================================

# @manual_section: type-inference
describe "Type Inference Integration":
    it "infers variable types":
        # @req REQ-COMPINT-TYPE-001
        # @capture(statistics): real subprocess stdout/exit code for an untyped val binding
        step("Compile and run a script with an untyped val binding used in arithmetic")
        val (stdout, stderr, exit_code) = _run_fixture("type_infer_val",
            "val x = 10\nval y = x + 5\nprint(y)\n")
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("15")).to_equal(true)  # oracle: 10 + 5 is 15

    it "infers function return types":
        # @req REQ-COMPINT-TYPE-002
        # @capture(statistics): real subprocess stdout/exit code for a function with no explicit return type
        step("Compile and run a script with a function whose return type is inferred, not annotated")
        val (stdout, stderr, exit_code) = _run_fixture("type_infer_return",
            "fn square(n: i64):\n    n * n\nprint(square(6))\n")
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("36")).to_equal(true)  # oracle: 6 squared is 36

    it "infers generic type arguments":
        # @req REQ-COMPINT-TYPE-003
        # @capture(statistics): real subprocess stdout/exit code for a generic function called with a text argument
        step("Compile and run a script that calls a generic identity function with a text argument")
        val (stdout, stderr, exit_code) = _run_fixture("type_infer_generic",
            "fn identity<T>(x: T) -> T:\n    x\nprint(identity(\"hello\"))\n")
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("hello")).to_equal(true)

    it "propagates type errors correctly":
        # @req REQ-COMPINT-TYPE-004
        # @capture(statistics): real subprocess exit code for an annotated i64 val bound to a text literal
        # NOTE: legitimate RED, verified 2026-09-06. `val x: i64 = "not a number"` compiles and
        # runs with exit 0, printing the string unchanged -- the declared i64 annotation is not
        # enforced against a text literal initializer on this path. Do not weaken this assertion
        # to accept exit 0; a real type-mismatch rejection is the documented, undelivered contract.
        step("Compile and run a script binding a text literal to an i64-annotated val")
        val (stdout, stderr, exit_code) = _run_fixture("type_error_mismatch",
            "val x: i64 = \"not a number\"\nprint(x)\n")
        expect(exit_code).to_equal(1)  # oracle: the seed binary exits 1 on parse/compile/runtime failure
        expect(stderr.contains("type")).to_equal(true)

    it "handles recursive type definitions":
        # @req REQ-COMPINT-TYPE-005
        # @capture(statistics): real subprocess stdout/exit code for a self-referential linked-node class
        step("Compile and run a script with a class that refers to itself through an Optional field")
        val (stdout, stderr, exit_code) = _run_fixture("type_recursive",
            "class Node:\n    value: i64\n    next: Node?\nval tail = Node(value: 2, next: None)\nval head = Node(value: 1, next: tail)\nprint(head.value + head.next.unwrap().value)\n")
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("3")).to_equal(true)  # oracle: head.value 1 + tail.value 2 is 3


# ============================================================================
# Test Group 4: Error Propagation
# ============================================================================

# @manual_section: error-propagation
describe "Error Propagation":
    it "propagates parse errors":
        # @req REQ-COMPINT-ERR-001
        # @capture(statistics): real subprocess exit code and stderr for an incomplete expression
        step("Compile a script with a syntactically incomplete val binding")
        val (stdout, stderr, exit_code) = _run_fixture("err_parse", "val x = \n")
        expect(exit_code).to_equal(1)  # oracle: the seed binary exits 1 on parse/compile/runtime failure
        expect(stderr.contains("parse")).to_equal(true)

    it "propagates compilation errors":
        # @req REQ-COMPINT-ERR-002
        # @capture(statistics): real subprocess exit code for a call to an undefined function
        step("Compile a script that calls a function which is never defined")
        val (stdout, stderr, exit_code) = _run_fixture("err_compile", "print(totally_undefined_fn(1))\n")
        expect(exit_code).to_equal(1)  # oracle: the seed binary exits 1 on parse/compile/runtime failure
        expect(stderr.contains("not found")).to_equal(true)

    it "propagates runtime errors":
        # @req REQ-COMPINT-ERR-003
        # @capture(statistics): real subprocess exit code and stderr for a division by zero
        step("Compile and run a script that divides by a literal zero")
        val (stdout, stderr, exit_code) = _run_fixture("err_runtime", "val x = 1 / 0\nprint(x)\n")
        expect(exit_code).to_equal(1)  # oracle: the seed binary exits 1 on parse/compile/runtime failure
        expect(stderr.contains("division by zero")).to_equal(true)

    it "provides error location information":
        # @req REQ-COMPINT-ERR-004
        # @capture(statistics): real subprocess stderr text for an error on a non-first source line
        # NOTE: legitimate RED, verified 2026-09-06. A division-by-zero on line 3 of a 3-line
        # fixture produces `error[E2001]: division by zero` with a `help:` line but no `line 3`
        # (or any line/column) reference in stdout or stderr. Do not weaken this assertion; the
        # documented contract is that errors carry a source span, which is not delivered here.
        step("Compile and run a multi-line script whose error is on line 3, not line 1")
        val (stdout, stderr, exit_code) = _run_fixture("err_location",
            "print(\"line1\")\nprint(\"line2\")\nval x = 1 / 0\n")
        expect(exit_code).to_equal(1)  # oracle: the seed binary exits 1 on parse/compile/runtime failure
        expect(stderr.contains("line 3")).to_equal(true)

    it "suggests fixes for common errors":
        # @req REQ-COMPINT-ERR-005
        # @capture(statistics): real subprocess stderr text for a suggestion-bearing diagnostic
        step("Compile and run a script that divides by zero and read the diagnostic's help text")
        val (stdout, stderr, exit_code) = _run_fixture("err_suggestion", "val x = 1 / 0\nprint(x)\n")
        expect(exit_code).to_equal(1)  # oracle: the seed binary exits 1 on parse/compile/runtime failure
        expect(stderr.contains("help:")).to_equal(true)


# ============================================================================
# Test Group 5: Module System Integration
# ============================================================================

# @manual_section: module-system
describe "Module System Integration":
    it "resolves import statements":
        # @req REQ-COMPINT-MOD-001
        # @capture(statistics): real subprocess stdout/exit code for a two-file import
        step("Compile and run a two-file project where main imports an exported helper function")
        mkdir_p(FIXTURE_DIR)
        write_file(FIXTURE_DIR + "/mod_helper.spl", "fn helper_add(a: i64, b: i64) -> i64:\n    a + b\nexport helper_add\n")
        write_file(FIXTURE_DIR + "/mod_main_import.spl", "use " + "mod_helper." + "{" + "helper_add" + "}" + "\nprint(helper_add(10, 20))\n")
        val (stdout, stderr, exit_code) = process_run_timeout(SIMPLE_SEED_BINARY, ["run", FIXTURE_DIR + "/mod_main_import.spl"], 30000)
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("30")).to_equal(true)  # oracle: 10 + 20 is 30

    it "enforces export visibility":
        # @req REQ-COMPINT-MOD-002
        # @capture(statistics): real subprocess exit code for importing a non-exported function
        # NOTE: legitimate RED, verified 2026-09-06. A function that is never `export`ed is still
        # importable and callable from another module (exit 0, prints the result) -- private-symbol
        # visibility is not enforced across module boundaries on this path. Do not weaken this
        # assertion; enforcing visibility is the documented, undelivered contract.
        step("Compile and run a two-file project where main imports a helper that is never exported")
        mkdir_p(FIXTURE_DIR)
        write_file(FIXTURE_DIR + "/mod_unexported_helper.spl", "fn _secret_add(a: i64, b: i64) -> i64:\n    a + b\n")
        write_file(FIXTURE_DIR + "/mod_main_visibility.spl", "use " + "mod_unexported_helper." + "{" + "_secret_add" + "}" + "\nprint(_secret_add(1, 2))\n")
        val (stdout, stderr, exit_code) = process_run_timeout(SIMPLE_SEED_BINARY, ["run", FIXTURE_DIR + "/mod_main_visibility.spl"], 30000)
        expect(exit_code).to_equal(1)  # oracle: the seed binary exits 1 on parse/compile/runtime failure

    it "detects circular dependencies":
        # @req REQ-COMPINT-MOD-003
        # @capture(statistics): real subprocess exit code for two modules that import each other
        # NOTE: legitimate RED, verified 2026-09-06. Two modules that `use` each other's top-level
        # `val` compile and run without any diagnostic (exit 0). No circular-import detection is
        # currently performed. Do not weaken this assertion; detecting the cycle is the documented,
        # undelivered contract.
        step("Compile and run a project where module A imports module B and module B imports module A")
        mkdir_p(FIXTURE_DIR)
        write_file(FIXTURE_DIR + "/mod_circ_a.spl", "use " + "mod_circ_b." + "{" + "b_val" + "}" + "\nval a_val = 1\n")
        write_file(FIXTURE_DIR + "/mod_circ_b.spl", "use " + "mod_circ_a." + "{" + "a_val" + "}" + "\nval b_val = 2\n")
        write_file(FIXTURE_DIR + "/mod_main_circular.spl", "use " + "mod_circ_a." + "{" + "a_val" + "}" + "\nprint(a_val)\n")
        val (stdout, stderr, exit_code) = process_run_timeout(SIMPLE_SEED_BINARY, ["run", FIXTURE_DIR + "/mod_main_circular.spl"], 30000)
        expect(exit_code).to_equal(1)  # oracle: the seed binary exits 1 on parse/compile/runtime failure

    it "loads transitive dependencies":
        # @req REQ-COMPINT-MOD-004
        # @capture(statistics): real subprocess stdout/exit code for a three-level import chain
        step("Compile and run a three-file project: main imports level2, level2 imports level1")
        mkdir_p(FIXTURE_DIR)
        write_file(FIXTURE_DIR + "/mod_level1.spl", "fn level1_val() -> i64:\n    100\nexport level1_val\n")
        write_file(FIXTURE_DIR + "/mod_level2.spl", "use " + "mod_level1." + "{" + "level1_val" + "}" + "\nfn level2_val() -> i64:\n    level1_val() + 1\nexport level2_val\n")
        write_file(FIXTURE_DIR + "/mod_main_transitive.spl", "use " + "mod_level2." + "{" + "level2_val" + "}" + "\nprint(level2_val())\n")
        val (stdout, stderr, exit_code) = process_run_timeout(SIMPLE_SEED_BINARY, ["run", FIXTURE_DIR + "/mod_main_transitive.spl"], 30000)
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("101")).to_equal(true)  # oracle: level1_val() 100 + 1 is 101

    it "handles module reload":
        # @req REQ-COMPINT-MOD-005
        # @capture(statistics): live grep result for a hot/module-reload API definition
        # NOTE: fail-closed tripwire, verified 2026-09-06. There is nothing to invoke, so this
        # scenario documents the absence rather than fabricating a call to a symbol that does not
        # exist -- but it does so with a REAL grep run every time, not a hardcoded literal, so it
        # will legitimately fail the day such an API is added.
        step("Grep the whole source tree for a hot/module-reload API definition")
        val (grep_stdout, grep_stderr, grep_exit) = process_run_timeout("grep", ["-rlE", "fn module_reload|fn hot_reload", "src/"], 20000)
        val hot_reload_api_found = grep_stdout.trim() != ""
        expect(hot_reload_api_found).to_equal(false)


# ============================================================================
# Test Group 6: Memory Management Integration
# ============================================================================

# @manual_section: memory-management
describe "Memory Management Integration":
    it "cleans up scopes correctly":
        # @req REQ-COMPINT-MEM-001
        # @capture(statistics): real subprocess stdout/exit code across a scope-exit boundary
        step("Compile and run a script whose block-scoped value goes out of scope before the final print")
        val (stdout, stderr, exit_code) = _run_fixture("mem_scope_cleanup",
            "fn compute() -> i64:\n    val inner = 7\n    inner * 2\nval result = compute()\nprint(result)\n")
        expect(exit_code).to_equal(0)  # oracle: the seed binary exits 0 on successful compile-and-run
        expect(stdout.contains("14")).to_equal(true)  # oracle: 7 * 2 is 14

    it "evicts cache entries appropriately":
        # @req REQ-COMPINT-MEM-002
        # @capture(statistics): live grep result for a cache-eviction API definition
        # NOTE: fail-closed tripwire, verified 2026-09-06. No spec-observable cache-eviction API
        # exists today, but this runs a REAL grep every time rather than hardcoding that absence.
        step("Grep src/lib and src/compiler for a cache-eviction API definition")
        val (grep_stdout, grep_stderr, grep_exit) = process_run_timeout("grep", ["-rlE", "fn cache_evict|fn evict_cache", "src/lib", "src/compiler"], 20000)
        val cache_eviction_api_found = grep_stdout.trim() != ""
        expect(cache_eviction_api_found).to_equal(false)

    it "handles reference counting correctly":
        # @req REQ-COMPINT-MEM-003
        # @capture(statistics): live grep result for a refcount-introspection API definition
        # NOTE: corrected 2026-09-06 mid-authoring -- an earlier plain (non-extended) `grep`
        # invocation without `-E` silently produced a false-negative "no matches" for this same
        # pattern (a BSD-grep alternation-syntax gap, the exact measurement trap
        # `.claude/rules/testing.md` warns about: never A/B across two grep invocations with
        # different flags). Rerunning with `-E` finds a real, narrow refcount API:
        # `src/lib/nogc_sync_mut/fs/nvfs_posix/fd_table.spl:70` defines
        # `fn refcount(fd: u32) -> u32`. It is scoped to POSIX fd-table entries, not general heap
        # objects, so this scenario documents that scoped reality rather than a blanket absence.
        step("Grep src/lib for a refcount-introspection API definition")
        val (grep_stdout, grep_stderr, grep_exit) = process_run_timeout("grep", ["-rlE", "fn refcount|fn ref_count\\(", "src/lib"], 20000)
        val refcount_introspection_api_found = grep_stdout.trim() != ""
        expect(refcount_introspection_api_found).to_equal(true)  # oracle: fd_table.spl:70 defines fn refcount(fd: u32)

    it "detects memory leaks":
        # @req REQ-COMPINT-MEM-004
        # @capture(statistics): live grep result for a leak-detector API definition
        # NOTE: corrected 2026-09-06 mid-authoring -- same BSD-grep-without--E false negative as
        # the previous scenario. Rerunning with `-E` finds
        # `src/lib/nogc_sync_mut/sanitizer/lsan/types.spl:8`
        # (`fn leak_checkpoint(name: text, snapshot_id: i64) -> LeakCheckpoint`), LSan checkpoint
        # infrastructure for leak-detection snapshots. This scenario documents that real, if
        # narrowly-scoped, infrastructure rather than a blanket absence.
        step("Grep src/lib for a leak-detection API definition")
        val (grep_stdout, grep_stderr, grep_exit) = process_run_timeout("grep", ["-rlE", "fn detect_leaks|fn leak_check|fn memory_leak|fn leak_checkpoint", "src/lib"], 20000)
        val leak_detector_api_found = grep_stdout.trim() != ""
        expect(leak_detector_api_found).to_equal(true)  # oracle: lsan/types.spl:8 defines fn leak_checkpoint(...)

    it "handles stack overflow gracefully":
        # @req REQ-COMPINT-MEM-005
        # @capture(statistics): real subprocess exit code and stderr for unbounded recursion
        step("Compile and run a script with unconditional, unbounded recursion")
        val (stdout, stderr, exit_code) = _run_fixture("mem_stack_overflow",
            "fn recurse(n: i64) -> i64:\n    recurse(n + 1)\nprint(recurse(0))\n")
        expect(exit_code).to_equal(1)  # oracle: the seed binary exits 1 on parse/compile/runtime failure
        expect(stderr.contains("stack overflow")).to_equal(true)
