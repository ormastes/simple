# @tag:in-development
# Tracks: doc/08_tracking/bug/pr1870_pr1830_unreviewed_merge_fallout_2026-09-28.md
use std.spec.*
use std.io_runtime.{process_run, env_get, env_set, file_exists, file_delete, getpid}
use app.optimize.sprof_collection_profile.{sprof_source_module_identity}

val NATIVE_COLLECTION_PROBE = "test/02_integration/compiler/probe_profile_switchable_cli_feedback.spl"

fn native_probe_value(output: text, prefix: text) -> text:
    for line in output.split("\n"):
        val trimmed = line.trim()
        if trimmed.starts_with(prefix):
            return trimmed.substring(prefix.len(), trimmed.len())
    ""

describe "native collection build consumes admitted exact-site feedback":
    it "rejects collection profile flags without a value before compiling":
        var simple_bin = env_get("SIMPLE_BIN") ?? ""
        if simple_bin == "":
            simple_bin = if file_exists("bin/simple.exe"): "bin/simple.exe" else: "bin/simple"
        for flag in ["--collection-profile", "--collection-workload", "--collection-target"]:
            val (_, error, code) = process_run(simple_bin, ["native-build", flag])
            expect(code).to_equal(1)
            expect(error).to_contain("{flag} requires an argument")

    it "embeds measured auto storage while preserving forced and cold containers":
        var simple_bin = env_get("SIMPLE_BIN") ?? ""
        if simple_bin == "":
            simple_bin = if file_exists("bin/simple.exe"): "bin/simple.exe" else: "bin/simple"
        val previous_delegate = env_get("SIMPLE_NO_BOOTSTRAP_DELEGATE") ?? ""
        expect(env_set("SIMPLE_NO_BOOTSTRAP_DELEGATE", "1")).to_be(true)
        val previous_no_stub = env_get("SIMPLE_NO_STUB_FALLBACK") ?? ""
        expect(env_set("SIMPLE_NO_STUB_FALLBACK", "1")).to_be(true)
        val profile_path = "build/collection_native_{getpid()}.sprof"
        val binary_path = "build/collection_native_{getpid()}.exe"
        val identity = sprof_source_module_identity(NATIVE_COLLECTION_PROBE)
        val (capture_out, capture_err, capture_code) = process_run(simple_bin, [
            "run", NATIVE_COLLECTION_PROBE,
            "--collection-profile-out=" + profile_path,
            "--collection-module=" + identity,
            "--collection-workload=lookup-workload",
            "--collection-target=x86_64-v3"
        ])
        expect(capture_code).to_equal(0)
        expect(capture_out + capture_err).to_contain("COLLECTION_PROFILE_CLI: PASS")
        expect(file_exists(profile_path)).to_be(true)

        val (build_out, build_err, build_code) = process_run(simple_bin, [
            "native-build", "--backend=llvm", "--mode=one-binary",
            "--entry-closure", "--entry", NATIVE_COLLECTION_PROBE,
            "--source", "src/lib", "--output", binary_path,
            "--collection-profile=" + profile_path,
            "--collection-workload=lookup-workload",
            "--collection-target=x86_64-v3"
        ])
        expect(build_code).to_equal(0)
        expect(file_exists(binary_path)).to_be(true)
        val (native_out, native_err, native_code) = process_run(binary_path, [])
        expect(native_code).to_equal(0)
        val output = native_out + native_err
        expect(output).to_contain("COLLECTION_PROFILE_CLI: PASS")
        expect(native_probe_value(output, "COLLECTION_HOT_PREINSERT_HASH:")).to_equal("true")
        expect(native_probe_value(output, "COLLECTION_MAP_PREINSERT_HASH:")).to_equal("true")
        expect(native_probe_value(output, "COLLECTION_COLD_PREINSERT_HASH:")).to_equal("false")
        expect(native_probe_value(output, "COLLECTION_FORCED_PREINSERT_HASH:")).to_equal("false")

        val (_, rejected_err, rejected_code) = process_run(simple_bin, [
            "native-build", "--backend=llvm", "--entry-closure",
            "--entry", NATIVE_COLLECTION_PROBE, "--source", "src/lib",
            "--output", binary_path,
            "--collection-profile=" + profile_path,
            "--collection-workload=lookup-workload",
            "--collection-target=aarch64-neon"
        ])
        expect(rejected_code).to_equal(1)
        expect(rejected_err).to_contain("no samples for target")
        expect(file_exists(binary_path)).to_be(true)
        file_delete(binary_path)
        file_delete(profile_path)
        expect(env_set("SIMPLE_NO_BOOTSTRAP_DELEGATE", previous_delegate)).to_be(true)
        expect(env_set("SIMPLE_NO_STUB_FALLBACK", previous_no_stub)).to_be(true)
