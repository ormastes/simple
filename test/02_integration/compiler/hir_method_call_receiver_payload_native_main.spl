use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_definitions.*
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.common.config.{Logger}

fn hmcrp_lowering_error_kind_name(kind: LoweringErrorKind) -> text:
    match kind:
        case LoweringErrorKind.UnresolvedName:
            "UnresolvedName"
        case LoweringErrorKind.DuplicateDefinition:
            "DuplicateDefinition"
        case LoweringErrorKind.TypeMismatch:
            "TypeMismatch"
        case LoweringErrorKind.InvalidPattern:
            "InvalidPattern"
        case LoweringErrorKind.InvalidExpression:
            "InvalidExpression"
        case LoweringErrorKind.Other:
            "Other"
        case LoweringErrorKind.Recovered:
            "Recovered"

fn hmcrp_expr_kind_name(expr: HirExpr) -> text:
    match expr.kind:
        case HirExprKind.NamedVar(_, _):
            "NamedVar"
        case HirExprKind.Var(_):
            "Var"
        case HirExprKind.Index(_, _):
            "Index"
        case HirExprKind.MethodCall(_, _, _, _):
            "MethodCall"
        case HirExprKind.Call(_, _, _):
            "Call"
        case HirExprKind.StringLit(_, _):
            "StringLit"
        case HirExprKind.Error:
            "Error"
        case _:
            "Other"

fn hmcrp_print_receiver(expr: HirExpr):
    print "hir_method_call_receiver_payload_nested_receiver_kind={hmcrp_expr_kind_name(expr)}"
    match expr.kind:
        case HirExprKind.Index(base, index):
            print "hir_method_call_receiver_payload_nested_index_base_kind={hmcrp_expr_kind_name(base)}"
            print "hir_method_call_receiver_payload_nested_index_base_args={hmcrp_named_var_is(base, \"args\")}"
            print "hir_method_call_receiver_payload_nested_index_index_kind={hmcrp_expr_kind_name(index)}"
            print "hir_method_call_receiver_payload_nested_index_index_i={hmcrp_named_var_is(index, \"i\")}"
        case HirExprKind.NamedVar(_, name):
            print "hir_method_call_receiver_payload_nested_receiver_named={name}"
        case _:
            pass_do_nothing("receiver kind line is sufficient for this diagnostic")

fn hmcrp_print_nested_shape(hir: HirModule, lowering: HirLowering):
    var found = false
    for fn_ in hir.functions.values():
        if fn_.name == "nested":
            found = true
            print "hir_method_call_receiver_payload_nested_function_found=true"
            print "hir_method_call_receiver_payload_nested_param_count={fn_.params.len()}"
            if fn_.params.len() > 0:
                print "hir_method_call_receiver_payload_nested_param_0={fn_.params[0].name}"
            if fn_.params.len() > 1:
                print "hir_method_call_receiver_payload_nested_param_1={fn_.params[1].name}"
                val nested_param_1: HirParam = fn_.params[1]
                val nested_symbol_id: SymbolId = nested_param_1.symbol
                print "hir_method_call_receiver_payload_nested_param_1_symbol_id={nested_symbol_id.id}"
                if val nested_symbol = lowering.symbols.get_symbol_raw(nested_symbol_id.id):
                    val nested_scope_id = nested_symbol.scope.id
                    val nested_scope = lowering.symbols.scopes[nested_scope_id]
                    print "hir_method_call_receiver_payload_nested_scope_id={nested_scope_id}"
                    print "hir_method_call_receiver_payload_nested_scope_has_args={nested_scope.symbols.has(\"args\")}"
                    print "hir_method_call_receiver_payload_nested_scope_has_i={nested_scope.symbols.has(\"i\")}"
                    print "hir_method_call_receiver_payload_nested_scope_get_args={nested_scope.symbols.get(\"args\") != nil}"
                    print "hir_method_call_receiver_payload_nested_scope_get_i={nested_scope.symbols.get(\"i\") != nil}"
                else:
                    print "hir_method_call_receiver_payload_nested_param_1_symbol_missing=true"
            print "hir_method_call_receiver_payload_nested_body_has={fn_.body.has}"
            print "hir_method_call_receiver_payload_nested_body_stmt_count={fn_.body.stmts.len()}"
            if fn_.body.has:
                print "hir_method_call_receiver_payload_nested_body_value_kind={hmcrp_expr_kind_name(fn_.body.value)}"
                match fn_.body.value.kind:
                    case HirExprKind.MethodCall(receiver, method, args, _):
                        print "hir_method_call_receiver_payload_nested_method={method}"
                        print "hir_method_call_receiver_payload_nested_arg_count={args.len()}"
                        hmcrp_print_receiver(receiver)
                    case HirExprKind.Call(callee, args, _):
                        print "hir_method_call_receiver_payload_nested_call_arg_count={args.len()}"
                        print "hir_method_call_receiver_payload_nested_callee_kind={hmcrp_expr_kind_name(callee)}"
                    case _:
                        pass_do_nothing("body value kind line is sufficient for this diagnostic")
    if not found:
        print "hir_method_call_receiver_payload_nested_function_found=false"

fn hmcrp_named_var_is(expr: HirExpr, expected: text) -> bool:
    match expr.kind:
        case HirExprKind.NamedVar(_, name):
            name == expected
        case _:
            false

fn hmcrp_string_arg_is(args: [HirCallArg], expected: text) -> bool:
    if args.len() != 1:
        return false
    match args[0].value.kind:
        case HirExprKind.StringLit(value, _):
            value == expected
        case _:
            false

fn hmcrp_direct_ok(hir: HirModule) -> bool:
    for fn_ in hir.functions.values():
        if fn_.name == "direct":
            if not fn_.body.has:
                return false
            match fn_.body.value.kind:
                case HirExprKind.MethodCall(receiver, method, args, _):
                    return (method == "starts_with" and
                        hmcrp_named_var_is(receiver, "arg") and
                        hmcrp_string_arg_is(args, "--output="))
                case _:
                    return false
    false

fn hmcrp_nested_ok(hir: HirModule) -> bool:
    for fn_ in hir.functions.values():
        if fn_.name == "nested":
            if fn_.params.len() != 2:
                return false
            if fn_.params[0].name != "args" or fn_.params[1].name != "i":
                return false
            if not fn_.body.has:
                return false
            match fn_.body.value.kind:
                case HirExprKind.MethodCall(receiver, method, args, _):
                    if method != "starts_with" or not hmcrp_string_arg_is(args, "-o"):
                        return false
                    match receiver.kind:
                        case HirExprKind.Index(base, index):
                            return hmcrp_named_var_is(base, "args") and hmcrp_named_var_is(index, "i")
                        case _:
                            return false
                case _:
                    return false
    false

fn main() -> i32:
    val source =
        "fn direct(arg: text) -> bool:\n" +
        "    arg.starts_with(\"--output=\")\n" +
        "\n" +
        "fn nested(args: [text], i: i64) -> bool:\n" +
        "    args[i].starts_with(\"-o\")\n"
    val logger = Logger(level: 0)
    val module = parse_full_frontend(source, "hir_method_call_receiver_payload_native", "hir_method_call_receiver_payload_native", logger)
    var lowering = HirLowering.with_filename("hir_method_call_receiver_payload_native")
    val hir = lowering.lower_module(module)
    val direct_ok = hmcrp_direct_ok(hir)
    val nested_ok = hmcrp_nested_ok(hir)
    val no_errors = lowering.errors.len() == 0

    hmcrp_print_nested_shape(hir, lowering)
    print "hir_method_call_receiver_payload_direct={direct_ok}"
    print "hir_method_call_receiver_payload_nested={nested_ok}"
    print "hir_method_call_receiver_payload_error_count={lowering.errors.len()}"
    var error_index = 0
    for lowering_error in lowering.errors:
        print "hir_method_call_receiver_payload_error_{error_index}_kind={hmcrp_lowering_error_kind_name(lowering_error.kind)}"
        print "hir_method_call_receiver_payload_error_{error_index}_message={lowering_error.message}"
        error_index = error_index + 1
    if direct_ok and nested_ok and no_errors:
        return 0
    1
