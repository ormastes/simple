use std.nogc_sync_mut.compression.gzip.compress.{
    gzip_compression_ratio, gzip_space_savings, gzip_efficiency, gzip_analyze_data
}

extern fn rt_exit(code: i32)

fn close_f64(actual: f64, expected: f64) -> bool:
    var delta = actual - expected
    if delta < 0.0:
        delta = 0.0 - delta
    return delta < 0.000001

val ratio = gzip_compression_ratio(100, 25)
val savings = gzip_space_savings(100, 25)
val efficiency = gzip_efficiency([1, 2, 3, 4], [1])
val analysis = gzip_analyze_data([65, 65, 65, 65])

if not close_f64(ratio, 0.25):
    print "FAIL: gzip_compression_ratio did not return f64"
    rt_exit(1)
if not close_f64(savings, 75.0):
    print "FAIL: gzip_space_savings did not return f64"
    rt_exit(1)
if not close_f64(efficiency, 75.0):
    print "FAIL: gzip_efficiency did not return f64"
    rt_exit(1)
if analysis == nil:
    print "FAIL: gzip_analyze_data did not execute log2_approx"
    rt_exit(1)

print "PASS: gzip metrics and log2 approximation preserve f64 native signatures"
rt_exit(0)
