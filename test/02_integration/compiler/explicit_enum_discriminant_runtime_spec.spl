use std.spec.{describe, it, expect, step}

enum SparseDiscriminant:
    Start = 4
    Next
    Sparse = 23
    AfterSparse
    Rewind = 2

enum ConstantDiscriminant:
    Four = 2 + 2

fn matched_discriminant(value: SparseDiscriminant) -> i64:
    match value:
        case SparseDiscriminant.Start: 4
        case SparseDiscriminant.Next: 5
        case SparseDiscriminant.Sparse: 23
        case SparseDiscriminant.AfterSparse: 24
        case SparseDiscriminant.Rewind: 2

describe "explicit enum discriminant runtime":
    it "evaluates constant-expression discriminants":
        expect(ConstantDiscriminant.Four as i64).to_equal(4)

    it "casts a direct variant and an enum local":
        expect(SparseDiscriminant.Sparse as i64).to_equal(23)
        val local = SparseDiscriminant.AfterSparse
        expect(local as i64).to_equal(24)

    it "preserves sparse values through construction, casts, and matches":
        step("Construct every explicit or inferred variant")
        val values = [
            SparseDiscriminant.Start,
            SparseDiscriminant.Next,
            SparseDiscriminant.Sparse,
            SparseDiscriminant.AfterSparse,
            SparseDiscriminant.Rewind
        ]
        val expected = [4, 5, 23, 24, 2]

        step("Observe the same ABI values through casts and matches")
        var i = 0
        while i < values.len():
            expect(values[i] as i64).to_equal(expected[i])
            expect(matched_discriminant(values[i])).to_equal(expected[i])
            i = i + 1
