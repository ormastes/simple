# Real LLVM toolchain required. No missing-tool success or privileged execution.
# @cover src/compiler/70.backend/backend/llvm_backend_tools.spl
use std.spec.*
use std.nogc_sync_mut.io.file_ops.{file_exists, file_delete, file_read_text, file_write_bytes, file_write}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.nogc_sync_mut.io_runtime.{process_run}
use compiler.backend.llvm_capability.{find_objdump_portable}
use compiler.interp.interpreter.llvm.tools.{find_llc}
use compiler.backend.llvm_diagnostic_admission.{llvm_llc_error_diagnostic}
use compiler.backend.backend.backend_types.{CodegenTarget, OptimizationLevel}
use compiler.backend.llvm_target.{LlvmTargetConfig}
use compiler.backend.llvm_backend_tools.{compile_ir_to_object, compile_ir_to_object_path, llvm_object_code_bytes}

fn port_probe_ir(template: text, dialect: text, constraints: text, arguments: text, result_type: text) -> text:
    val assignment = if result_type == "void": "" else: "%result = "
    "target triple = \"x86_64-unknown-linux-gnu\"\ndefine void @inline_asm_probe() {{\n  " + assignment + "call " + result_type + " asm sideeffect" + dialect + " \"" + template + "\", \"" + constraints + "\"(" + arguments + ")\n  ret void\n}}\n"

fn assert_rejected_port_probe(ir: text, port_loss_probe: bool = false):
    val config = LlvmTargetConfig.for_target_portable_numeric(CodegenTarget.X86_64, nil)
    # Observe the actual selected LLVM producer first. Never synthesize a
    # zero exit or claim its partial-object failure from a nonzero tool exit.
    val raw_prefix = "/tmp/inline-asm-tool-result-{getpid()}-{time_now_unix_micros()}"
    val raw_ir_path = raw_prefix + ".ll"
    val raw_object_path = raw_prefix + ".o"
    expect(file_write(raw_ir_path, ir)).to_equal(true)
    val llc = find_llc()
    if llc == "": fail("qualified LLVM producer unavailable")
    val (raw_stdout, raw_stderr, raw_status) = process_run(llc, ["--filetype=obj", "-mtriple=x86_64-unknown-linux-gnu", "-O0", "-o", raw_object_path, raw_ir_path])
    expect(llvm_llc_error_diagnostic(raw_status, raw_stdout, raw_stderr, llc, raw_ir_path) != "").to_equal(true)
    var qualification = "EXIT_ZERO_PARTIAL_OBJECT_UNQUALIFIED_NONZERO_TOOL_STATUS"
    if raw_status == 0 and port_loss_probe:
        expect(file_exists(raw_object_path)).to_equal(true)
        # The producer reported a successful process but omitted the port op.
        assert_port_disassembly(raw_object_path, "ee", "out", 0)
        qualification = "EXIT_ZERO_PARTIAL_OBJECT_OBSERVED"
    elif raw_status == 0:
        # This fixture requests no port instruction. Do not describe the
        # absence of ee/out as evidence that an instruction was dropped.
        qualification = "EXIT_ZERO_ASSEMBLY_ERROR_NO_PORT_LOSS_ORACLE"
        file_delete(raw_object_path)
    else:
        file_delete(raw_object_path)
    expect(file_write(raw_prefix + ".tool-result", "tool=" + llc + "\nstatus={raw_status}\nqualification=" + qualification + "\nstdout:\n" + raw_stdout + "\nstderr:\n" + raw_stderr)).to_equal(true)
    file_delete(raw_ir_path)
    match compile_ir_to_object(ir, config, OptimizationLevel.None_, true):
        case Err(message): expect(message).to_contain("error:")
        case Ok(_): fail("invalid inline assembly was admitted as an object")
    val prefix = "/tmp/inline-asm-rejected-{getpid()}-{time_now_unix_micros()}"
    val object_path = prefix + ".o"
    val diagnostic_path = prefix + ".diagnostic"
    expect(file_exists(object_path)).to_equal(false)
    val status = compile_ir_to_object_path(ir, config, OptimizationLevel.None_, object_path, diagnostic_path, true)
    expect(status).to_be_greater_than(0)
    expect(file_exists(object_path)).to_equal(false)
    expect(file_read_text(diagnostic_path)).to_contain("error:")
    file_delete(diagnostic_path)
    file_delete(diagnostic_path + ".module.ll")

fn assert_port_probe_bytes(template: text, dialect: text, constraints: text, arguments: text, result_type: text, opcode: text, mnemonic: text, instruction_count: i64 = 1):
    val config = LlvmTargetConfig.for_target_portable_numeric(CodegenTarget.X86_64, nil)
    val ir = port_probe_ir(template, dialect, constraints, arguments, result_type)
    match compile_ir_to_object(ir, config, OptimizationLevel.None_, true):
        case Err(message): fail(message)
        case Ok(object_code):
            val path = "/tmp/inline-asm-bytes-{getpid()}-{time_now_unix_micros()}.o"
            expect(file_write_bytes(path, llvm_object_code_bytes(object_code))).to_equal(true)
            assert_port_disassembly(path, opcode, mnemonic, instruction_count)

fn assert_port_disassembly(path: text, opcode: text, mnemonic: text, instruction_count: i64 = 1):
    val objdump = find_objdump_portable()
    if objdump == "": fail("qualified disassembler unavailable")
    val (stdout, stderr, status) = process_run(objdump, ["-d", "-M", "intel", path])
    expect(file_write(path + ".disassembly", stdout)).to_equal(true)
    file_delete(path)
    expect(status).to_equal(0)
    expect(stderr).to_equal("")
    # Check the opcode at an instruction boundary in the named symbol,
    # never arbitrary object bytes or object existence alone.
    var normalized = ""
    var found_symbol = false
    for line in stdout.split("\n"):
        if line.contains("<inline_asm_probe>:"):
            found_symbol = true
            continue
        if not found_symbol: continue
        if line.trim() == "" or line.contains(">:"): break
        for token in line.replace("\t", " ").split(" "):
            if token != "": normalized = normalized + token + " "
    expect(found_symbol).to_equal(true)
    val instruction_marker = ": " + opcode + " " + mnemonic + " "
    expect(normalized.split(instruction_marker).len() - 1).to_equal(instruction_count)

describe "LLVM port instruction object admission":
    it "rejects bare Intel ports in the default AT&T dialect and malformed Intel assembly":
        assert_rejected_port_probe(port_probe_ir("out dx, al", "", r"{dx},{al}", "i16 128, i8 0", "void"), true)
        assert_rejected_port_probe(port_probe_ir("__simple_invalid_inline_asm_opcode__", " inteldialect", "", "", "void"))

    it "retains all three widths in both directions for explicit Intel dialect":
        assert_port_probe_bytes("out dx, al", " inteldialect", r"{dx},{al}", "i16 128, i8 0", "void", "ee", "out")
        assert_port_probe_bytes("in al, dx", " inteldialect", r"={al},{dx}", "i16 128", "i8", "ec", "in")
        assert_port_probe_bytes("out dx, ax", " inteldialect", r"{dx},{ax}", "i16 128, i16 0", "void", "66 ef", "out")
        assert_port_probe_bytes("in ax, dx", " inteldialect", r"={ax},{dx}", "i16 128", "i16", "66 ed", "in")
        assert_port_probe_bytes("out dx, eax", " inteldialect", r"{dx},{eax}", "i16 128, i32 0", "void", "ef", "out")
        assert_port_probe_bytes("in eax, dx", " inteldialect", r"={eax},{dx}", "i16 128", "i32", "ed", "in")

    it "retains valid AT&T and explicit syntax restoration controls":
        assert_port_probe_bytes("outb %al, %dx", "", r"{dx},{al}", "i16 128, i8 0", "void", "ee", "out")
        assert_port_probe_bytes(".intel_syntax noprefix\\0Aout dx, al\\0A.att_syntax prefix\\0Aoutb %al, %dx", "", r"{dx},{al}", "i16 128, i8 0", "void", "ee", "out", 2)

    it "admits real warning-producing Intel objects through both production APIs":
        val warning_asm = r".warning \22example: error: text\22\0Aout dx, al"
        assert_port_probe_bytes(warning_asm, " inteldialect", r"{dx},{al}", "i16 128, i8 0", "void", "ee", "out")
        # The label makes the raw echoed source start with `error:`. Located
        # warning context must consume the source line before parsing headers.
        val labeled_warning_asm = r"error: .warning \22example: error: text\22\0Aout dx, al"
        assert_port_probe_bytes(labeled_warning_asm, " inteldialect", r"{dx},{al}", "i16 128, i8 0", "void", "ee", "out")
        val ir = port_probe_ir(labeled_warning_asm, " inteldialect", r"{dx},{al}", "i16 128, i8 0", "void")
        val config = LlvmTargetConfig.for_target_portable_numeric(CodegenTarget.X86_64, nil)
        val prefix = "/tmp/inline-asm-warning-published-{getpid()}-{time_now_unix_micros()}"
        val object_path = prefix + ".o"
        val diagnostic_path = prefix + ".diagnostic"
        expect(file_exists(object_path)).to_equal(false)
        val status = compile_ir_to_object_path(ir, config, OptimizationLevel.None_, object_path, diagnostic_path, true)
        expect(status).to_equal(0)
        expect(file_exists(object_path)).to_equal(true)
        assert_port_disassembly(object_path, "ee", "out")
        file_delete(diagnostic_path)
