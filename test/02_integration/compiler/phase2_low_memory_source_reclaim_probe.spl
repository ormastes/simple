# Direct post-parse ownership probe. The shell gate supplies process bounds.
#
# This intentionally avoids `std.spec`, the broad `std.io` facade, and the
# heavyweight compiler graph. The original focused driver spec owns the full
# parse/HIR runtime path; this split probe executes alias-safe freeing and
# checks exact function bodies in the concrete lexer and driver sources.

use std.nogc_sync_mut.io.file_ops.{file_read}

extern fn rt_string_free(value: text) -> i64

fn probe_bool(value: bool) -> text:
    if value:
        return "true"
    "false"

fn line_indent(line: text) -> i64:
    var indent: i64 = 0
    while indent < line.len() and line.slice(indent, indent + 1) == " ":
        indent = indent + 1
    indent

fn triple_quote_count(line: text) -> i64:
    var count: i64 = 0
    var index: i64 = 0
    while index + 2 < line.len():
        if line.slice(index, index + 3) == "\"\"\"":
            count = count + 1
            index = index + 3
        else:
            index = index + 1
    count

fn exact_indented_body(source: text, signature: text) -> text:
    val lines = source.split("\n")
    var signature_index: i64 = -1
    var signature_count: i64 = 0
    var index: i64 = 0
    var in_triple_string = false
    while index < lines.len():
        val trimmed = lines[index].trim()
        val comment = trimmed.starts_with("#")
        if not in_triple_string and not comment and trimmed == signature:
            signature_index = index
            signature_count = signature_count + 1
        if not comment and triple_quote_count(lines[index]) % 2 == 1:
            in_triple_string = not in_triple_string
        index = index + 1
    if signature_count != 1:
        return ""

    val signature_indent = line_indent(lines[signature_index])
    var body_lines: [text] = []
    index = signature_index + 1
    while index < lines.len():
        val line = lines[index]
        if line.trim() != "" and line_indent(line) <= signature_indent:
            break
        body_lines.push(line)
        index = index + 1
    body_lines.join("\n")

fn exact_line_position(body: text, statement: text) -> i64:
    val lines = body.split("\n")
    var found: i64 = -1
    var count: i64 = 0
    var index: i64 = 0
    var in_triple_string = false
    while index < lines.len():
        val trimmed = lines[index].trim()
        val comment = trimmed.starts_with("#")
        if not in_triple_string and not comment and trimmed == statement:
            found = index
            count = count + 1
        if not comment and triple_quote_count(lines[index]) % 2 == 1:
            in_triple_string = not in_triple_string
        index = index + 1
    if count == 1:
        return found
    -1

fn exact_line_present(body: text, statement: text) -> bool:
    exact_line_position(body, statement) >= 0

fn source_has_ordered_post_parse_reclaim(driver: text) -> bool:
    val body = exact_indented_body(driver, "me compile() -> CompileResult:")
    val parse_pos = exact_line_position(body, "val (parsed_ctx, parse_ok) = self.parse_all_impl()")
    val gate_pos = exact_line_position(body, "if self.ctx.source_contents_reclaimable():")
    val trace_start_pos = exact_line_position(body, "log_phase(\"phase2:source_reclaim:start low_memory=true\")")
    val reset_pos = exact_line_position(body, "lexer_release_parse_source_globals()")
    val reclaim_pos = exact_line_position(body, "val reclaimed_sources = self.ctx.reclaim_source_contents()")
    val evict_pos = exact_line_position(body, "self.ctx.evict_sources()")
    val trace_done_pos = exact_line_position(body, "log_phase(\"phase2:source_reclaim:done reclaimed={{reclaimed_sources}}\")")
    val hir_pos = exact_line_position(body, "val (analyzed_ctx, analyze_ok) = self.lower_and_check_impl()")
    (parse_pos >= 0 and gate_pos > parse_pos and trace_start_pos > gate_pos and
        reset_pos > trace_start_pos and reclaim_pos > reset_pos and
        evict_pos > reclaim_pos and trace_done_pos > evict_pos and
        hir_pos > trace_done_pos)

fn source_has_low_memory_non_vhdl_guard(driver_types: text) -> bool:
    val body = exact_indented_body(
        driver_types,
        "me source_contents_reclaimable() -> bool:"
    )
    exact_line_present(
        body,
        "self.options.low_memory and self.options.backend != \"vhdl\""
    )

fn source_has_complete_lexer_release(lexer: text) -> bool:
    val body = exact_indented_body(
        lexer,
        "pub fn lexer_release_parse_source_globals():"
    )
    (exact_line_present(body, "current_core_lexer_slot = []") and
        exact_line_present(body, "lex_inline_source_slot = [\"\"]") and
        exact_line_present(body, "lex_source_codes = []") and
        exact_line_present(body, "lex_source_char_count_slot = [0]") and
        exact_line_present(body, "lex_source_code_base_slot = [0]") and
        exact_line_present(body, "rt_env_set(\"SIMPLE_BOOTSTRAP_LEX_SOURCE\", \"\")") and
        exact_line_present(body, "rt_env_set(\"SIMPLE_BOOTSTRAP_LEX_PATH\", \"\")"))

fn source_contract_negative_control() -> bool:
    # Every cleanup token is in the exact body, but only inside a docstring.
    val false_lexer = (
        "pub fn lexer_release_parse_source_globals():\n" +
        "    \"\"\"\n" +
        "    current_core_lexer_slot = []\n" +
        "    lex_inline_source_slot = [\"\"]\n" +
        "    lex_source_codes = []\n" +
        "    lex_source_char_count_slot = [0]\n" +
        "    lex_source_code_base_slot = [0]\n" +
        "    rt_env_set(\"SIMPLE_BOOTSTRAP_LEX_SOURCE\", \"\")\n" +
        "    rt_env_set(\"SIMPLE_BOOTSTRAP_LEX_PATH\", \"\")\n" +
        "    \"\"\"\n" +
        "    pass\n"
    )
    # Every ordered token exists globally, but only parse is in compile().
    val false_driver_scope = (
        "class FalseDriverScope:\n" +
        "    me compile() -> CompileResult:\n" +
        "        val (parsed_ctx, parse_ok) = self.parse_all_impl()\n" +
        "    me unrelated() -> CompileResult:\n" +
        "        if self.ctx.source_contents_reclaimable():\n" +
        "            log_phase(\"phase2:source_reclaim:start low_memory=true\")\n" +
        "            lexer_release_parse_source_globals()\n" +
        "            val reclaimed_sources = self.ctx.reclaim_source_contents()\n" +
        "            self.ctx.evict_sources()\n" +
        "            log_phase(\"phase2:source_reclaim:done reclaimed={{reclaimed_sources}}\")\n" +
        "        val (analyzed_ctx, analyze_ok) = self.lower_and_check_impl()\n"
    )
    # Every ordered token is in compile(), but only inside a docstring.
    val false_driver_string = (
        "class FalseDriver:\n" +
        "    me compile() -> CompileResult:\n" +
        "        \"\"\"\n" +
        "        val (parsed_ctx, parse_ok) = self.parse_all_impl()\n" +
        "        if self.ctx.source_contents_reclaimable():\n" +
        "        log_phase(\"phase2:source_reclaim:start low_memory=true\")\n" +
        "        lexer_release_parse_source_globals()\n" +
        "        val reclaimed_sources = self.ctx.reclaim_source_contents()\n" +
        "        self.ctx.evict_sources()\n" +
        "        log_phase(\"phase2:source_reclaim:done reclaimed={{reclaimed_sources}}\")\n" +
        "        val (analyzed_ctx, analyze_ok) = self.lower_and_check_impl()\n" +
        "        \"\"\"\n" +
        "        pass\n"
    )
    val false_guard = (
        "class FalseContext:\n" +
        "    me source_contents_reclaimable() -> bool:\n" +
        "        \"\"\"\n" +
        "        self.options.low_memory and self.options.backend != \"vhdl\"\n" +
        "        \"\"\"\n" +
        "        false\n"
    )
    (not source_has_complete_lexer_release(false_lexer) and
        not source_has_ordered_post_parse_reclaim(false_driver_scope) and
        not source_has_ordered_post_parse_reclaim(false_driver_string) and
        not source_has_low_memory_non_vhdl_guard(false_guard))

fn main() -> i32:
    val fixture_path = "test/02_integration/compiler/phase2_low_memory_source_reclaim_fixture.spl"
    val source = file_read(fixture_path)
    val alias = source

    # Do not read either source alias after this point: the registry accepts the
    # first allocation release and safely refuses its copied RuntimeValue alias.
    val alias_first_free = rt_string_free(source)
    val alias_second_free = rt_string_free(alias)
    val driver_ordered = source_has_ordered_post_parse_reclaim(file_read("src/compiler/80.driver/driver.spl"))
    val lexer_complete = source_has_complete_lexer_release(file_read("src/compiler/10.frontend/core/lexer.spl"))
    val low_memory_non_vhdl = source_has_low_memory_non_vhdl_guard(file_read("src/compiler/80.driver/driver_types.spl"))
    val negative_control = source_contract_negative_control()
    val passed = (
        alias_first_free == 1 and alias_second_free == 0 and
        driver_ordered and lexer_complete and low_memory_non_vhdl and
        negative_control
    )

    print("phase2_low_memory_probe_alias_first_free=" + alias_first_free.to_text())
    print("phase2_low_memory_probe_alias_second_free=" + alias_second_free.to_text())
    print("phase2_low_memory_probe_lexer_release_complete=" + probe_bool(lexer_complete))
    print("phase2_low_memory_probe_parse_release_reclaim_evict_lower_ordered=" + probe_bool(driver_ordered))
    print("phase2_low_memory_probe_low_memory_non_vhdl_guard=" + probe_bool(low_memory_non_vhdl))
    print("phase2_low_memory_probe_source_contract_negative_control=" + probe_bool(negative_control))
    print("phase2_low_memory_probe_status=" + if passed: "pass" else: "fail")
    if passed:
        return 0
    1
