# Execute only with an admitted selected runtime providing the real externs.
# This checks the single-thread common contract; native C additionally has
# an independent foreign-thread and exhaustion test. No provider substitute.
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_identity_v1, transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end}

fn main() -> i64:
    assert(transient_array_scope_identity_v1() == 0)
    assert(transient_array_scope_state_v1() == 0)
    assert(transient_scope_begin())
    val first = transient_array_scope_identity_v1()
    assert(first > 0)
    assert(transient_array_scope_state_v1() == 1)
    assert(not transient_scope_begin())
    assert(transient_array_scope_identity_v1() == first)
    assert(transient_scope_pause())
    assert(transient_array_scope_state_v1() == 2)
    assert(transient_array_scope_identity_v1() == first)
    assert(not transient_scope_begin())
    assert(transient_array_scope_identity_v1() == first)
    assert(transient_scope_end())
    assert(transient_array_scope_identity_v1() == 0)
    assert(transient_array_scope_state_v1() == 0)
    assert(transient_scope_begin())
    val second = transient_array_scope_identity_v1()
    assert(second > first)
    assert(transient_array_scope_state_v1() == 1)
    assert(transient_scope_end())
    assert(transient_array_scope_identity_v1() == 0)
    0
