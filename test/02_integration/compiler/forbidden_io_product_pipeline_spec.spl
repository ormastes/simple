# E-APACK008 product-pipeline integration gate.
#
# Stage ownership: run this with the pure-Simple Stage4 compiler. The Rust seed
# reaches phase-3 HIR setup and then stops earlier in the driver memory snapshot
# with `unknown extern function: rt_heap_peak_bytes`; that is not an E-APACK008
# result and must not be reported as product-path evidence.

use std.spec.{describe, it, expect}
use compiler.common.driver_core_types.{
    SourceFile, driver_core_compile_options_default
}
use compiler.driver.driver.{CompilerDriver}
use compiler.driver.driver_types.{CompileMode}

fn forbidden_io_product_driver(context_marker: text) -> CompilerDriver:
    var options = driver_core_compile_options_default()
    options.mode = CompileMode.Aot
    options.low_memory = true
    options.backend = "llvm"
    var driver = CompilerDriver.create(options)
    val source = (
        "fn facet_lookup_lazy() -> i64:\n" +
        "    return 1\n" +
        context_marker +
        "fn trace() -> i64:\n" +
        "    return facet_lookup_lazy()\n")
    driver.ctx.sources = [SourceFile(
        path: "build/forbidden_io/facet_runtime.spl",
        content: source,
        module_name: "common.facet_runtime")]
    driver

fn forbidden_io_product_error_count(errors: [text]) -> i64:
    var count = 0
    for error in errors:
        if error.contains("error[E-APACK008]"):
            count = count + 1
    count

describe "E-APACK008 product HIR pipeline":
    it "rejects exactly once for @realtime":
        var driver = forbidden_io_product_driver("@realtime\n")
        expect(driver.parse_all_streaming_surfaces_impl()).to_equal(true)
        expect(driver.lower_and_check_streaming_surfaces_impl()).to_equal(false)
        expect(forbidden_io_product_error_count(driver.ctx.errors)).to_equal(1)

    it "accepts the identical source when @realtime is removed":
        var driver = forbidden_io_product_driver("")
        expect(driver.parse_all_streaming_surfaces_impl()).to_equal(true)
        expect(driver.lower_and_check_streaming_surfaces_impl()).to_equal(true)
        expect(forbidden_io_product_error_count(driver.ctx.errors)).to_equal(0)
