struct Stage3PlainStructNativeControl:
    value: i64

fn main() -> i32:
    # Deliberately no compiler import, array, push, or method receiver.
    # It isolates construction and direct field projection from aggregate push.
    val item = Stage3PlainStructNativeControl(value: 42)
    val struct_ok = item.value == 42
    print "stage3_plain_struct_native_control={struct_ok}"
    if struct_ok:
        return 0
    1
