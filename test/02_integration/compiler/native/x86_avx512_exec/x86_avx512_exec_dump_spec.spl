"""
Purpose: build every AVX-512 frame-vector MIR operation family (f32x16,
f64x8, i32x16: arithmetic, unary, compare+select, mask logic, reductions,
permute, shuffles, gather, scatter, splat+copy, FMA, the frame-vector call
ABI, and GPR spills) through x86 isel -> regalloc -> encode, once with
AVX-512 admitted and once with the scalar fallback.

In every run it pins that each function decodes, that the AVX-512 build
really contains ZMM instructions and that the scalar build contains no EVEX
instruction at all. With SIMPLE_AVX512_EXEC_DUMP=<path> it also writes the
encoded functions for run_x86_avx512_exec.shs, which executes both builds
and compares every output byte against an independent C reference.
"""

use std.spec.*
use std.io_runtime.{file_write, env_get_or}
use compiler.mir.mir_data.*
use compiler.backend.native.isel_x86_64.{isel_module_with_x86_simd_capability}
use compiler.backend.native.native_avx2_capability.{native_avx2_denied_v1}
use compiler.backend.native.native_avx512_capability.{native_avx512_capability_v1, native_avx512_denied_v1}
use compiler.backend.native.regalloc.{regalloc_module}
use compiler.backend.native.encode_x86_64.{encode_module}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.backend.native.x86_64_avx512_receipt.{x86_zmm_evidence}

fn ty(shape: text) -> MirType:
    if shape == "f32": MirType(kind: MirTypeKind.Vec16f)
    elif shape == "f64": MirType(kind: MirTypeKind.Vec8d)
    else: MirType(kind: MirTypeKind.Vec16i)

fn l(id: i64) -> LocalId:
    LocalId(id: id)

fn c(id: i64) -> MirOperand:
    MirOperand.copy(LocalId(id: id))

fn i(kind: MirInstKind) -> MirInst:
    MirInst(kind: kind, span: nil)

fn func(name: text, sym: i64, extra: [MirType], insts: [MirInst]) -> MirFunction:
    val i64t = MirType.i64()
    val ptr = MirType(kind: MirTypeKind.Ptr(pointee: i64t, mutable: true))
    var locals = [
        MirLocal(id: LocalId(id: 0), name: Some("a"), type_: ptr, kind: LocalKind.Arg(0)),
        MirLocal(id: LocalId(id: 1), name: Some("b"), type_: ptr, kind: LocalKind.Arg(1)),
        MirLocal(id: LocalId(id: 2), name: Some("out"), type_: ptr, kind: LocalKind.Arg(2))
    ]
    for k in 0..extra.len():
        locals.push(MirLocal(id: LocalId(id: 3 + k), name: Some("t{3 + k}"), type_: extra[k], kind: LocalKind.Temp))
    val block = MirBlock(id: BlockId.new(0), label: Some("entry"), instructions: insts, terminator: MirTerminator.Ret(nil))
    MirFunction(
        symbol: SymbolId.new(sym), name: name,
        signature: MirSignature(params: [ptr, ptr, ptr], return_type: MirType.unit(), is_variadic: false),
        locals: locals, blocks: [block], entry_block: BlockId.new(0),
        span: Span(start: 0, end: 0, line: 1, col: 1), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {})

fn module_of(name: text, functions_list: [MirFunction]) -> MirModule:
    var functions: Dict<SymbolId, MirFunction> = {}
    for f in functions_list:
        functions[f.symbol] = f
    MirModule(name: name, functions: functions, statics: {}, constants: {}, types: {})

fn hex(code: [i64]) -> text:
    val digits = "0123456789abcdef"
    var out = ""
    for b in code:
        out = out + digits[(b >> 4) & 15] + digits[b & 15]
    out

struct Case:
    group: text
    atag: text
    btag: text
    module: MirModule

struct Emitted:
    text_: text
    evidence_ok: bool

fn emit_case(mode: text, case_: Case) -> Emitted:
    val cap = if mode == "avx": native_avx512_capability_v1("x86_64-avx512-linux", "integration-injected", "fixture-avx512-v1", true, false, true) else: native_avx512_denied_v1()
    val encoded = encode_module(regalloc_module(isel_module_with_x86_simd_capability(case_.module, native_avx2_denied_v1(), cap)))
    var out = "G {case_.group} {mode} {case_.atag} {case_.btag}\n"
    var evidence_ok = encoded.len() > 0
    for f in encoded:
        val ev = x86_zmm_evidence(f.code)
        if not ev.decoded: evidence_ok = false
        if mode == "avx" and ev.zmm_instructions == 0: evidence_ok = false
        if mode == "scalar" and ev.evex_instructions != 0: evidence_ok = false
        out = out + "F {f.name} {hex(f.code)}\n"
        out = out + "V {f.name} {mode} decoded={ev.decoded} insts={ev.instructions} evex={ev.evex_instructions} zmm={ev.zmm_instructions} {ev.reason}\n"
        for r in f.relocations:
            out = out + "R {f.name} {r.offset} {r.symbol_name} {r.addend}\n"
    Emitted(text_: out + "E\n", evidence_ok: evidence_ok)

fn simple_case(group: text, atag: text, btag: text, extra: [MirType], insts: [MirInst]) -> Case:
    Case(group: group, atag: atag, btag: btag, module: module_of(group, [func(group, 0, extra, insts)]))

fn binop_case(shape: text, op: text, btag: text) -> Case:
    val t = ty(shape)
    simple_case("bin_{op}_{shape}", shape, btag, [t, t, t], [
        i(MirInstKind.MirSimdLoad(l(3), c(0), true, t)),
        i(MirInstKind.MirSimdLoad(l(4), c(1), true, t)),
        i(MirInstKind.MirSimdBinop(l(5), c(3), c(4), op)),
        i(MirInstKind.MirSimdStore(c(5), c(2), true))])

fn unop_case(shape: text, op: text) -> Case:
    val t = ty(shape)
    simple_case("un_{op}_{shape}", shape, shape, [t, t, t], [
        i(MirInstKind.MirSimdLoad(l(3), c(0), true, t)),
        i(MirInstKind.MirSimdUnop(l(5), c(3), op)),
        i(MirInstKind.MirSimdStore(c(5), c(2), true))])

fn cmp_case(shape: text, op: text) -> Case:
    val t = ty(shape)
    simple_case("cmp_{op}_{shape}", shape, shape, [t, t, t, t], [
        i(MirInstKind.MirSimdLoad(l(3), c(0), true, t)),
        i(MirInstKind.MirSimdLoad(l(4), c(1), true, t)),
        i(MirInstKind.MirSimdCmp(l(5), c(3), c(4), op)),
        i(MirInstKind.MirSimdSelect(l(6), c(5), c(3), c(4))),
        i(MirInstKind.MirSimdStore(c(6), c(2), true))])

fn mask_case(shape: text, op: text) -> Case:
    val t = ty(shape)
    simple_case("mask_{op}_{shape}", shape, shape, [t, t, t, t, t, t], [
        i(MirInstKind.MirSimdLoad(l(3), c(0), true, t)),
        i(MirInstKind.MirSimdLoad(l(4), c(1), true, t)),
        i(MirInstKind.MirSimdCmp(l(5), c(3), c(4), "Lt")),
        i(MirInstKind.MirSimdCmp(l(6), c(3), c(4), "Le")),
        i(MirInstKind.MirSimdMaskOp(l(7), c(5), if op == "Not": c(5) else: c(6), op)),
        i(MirInstKind.Copy(l(8), l(7))),
        i(MirInstKind.MirSimdSelect(l(4), c(8), c(3), c(4))),
        i(MirInstKind.MirSimdStore(c(4), c(2), true))])

fn reduce_case(shape: text, op: text) -> Case:
    val t = ty(shape)
    simple_case("red_{op}_{shape}", shape, shape, [t, MirType.i64()], [
        i(MirInstKind.MirSimdLoad(l(3), c(0), true, t)),
        i(MirInstKind.MirSimdReduce(l(4), c(3), op)),
        i(MirInstKind.Store(c(2), c(4)))])

fn permute_case(shape: text, idx8: MirType) -> Case:
    val t = ty(shape)
    val it = if shape == "f64": idx8 else: ty("i32")
    simple_case("perm_{shape}", shape, "perm_" + shape, [t, it, t], [
        i(MirInstKind.MirSimdLoad(l(3), c(0), true, t)),
        i(MirInstKind.MirSimdLoad(l(4), c(1), true, it)),
        i(MirInstKind.MirSimdPermute(l(5), c(3), c(4))),
        i(MirInstKind.MirSimdStore(c(5), c(2), true))])

fn shuffle_case(shape: text, kind: text) -> Case:
    val t = ty(shape)
    val rhs = if kind == "BroadcastLane": MirOperand.const_int(3) else: c(4)
    simple_case("shuf_{kind}_{shape}", shape, shape, [t, t, t], [
        i(MirInstKind.MirSimdLoad(l(3), c(0), true, t)),
        i(MirInstKind.MirSimdLoad(l(4), c(1), true, t)),
        i(MirInstKind.MirSimdShuffle(l(5), c(3), rhs, kind)),
        i(MirInstKind.MirSimdStore(c(5), c(2), true))])

fn gather_case(shape: text, idx8: MirType) -> Case:
    val t = ty(shape)
    val it = if shape == "f64": idx8 else: ty("i32")
    simple_case("gather_{shape}", shape, "perm_" + shape, [t, it, t], [
        i(MirInstKind.MirSimdLoad(l(4), c(1), true, it)),
        i(MirInstKind.MirSimdGather(l(5), c(0), c(4), t)),
        i(MirInstKind.MirSimdStore(c(5), c(2), true))])

fn scatter_case(shape: text, idx8: MirType) -> Case:
    val t = ty(shape)
    val it = if shape == "f64": idx8 else: ty("i32")
    simple_case("scatter_{shape}", shape, "perm_" + shape, [t, it], [
        i(MirInstKind.MirSimdLoad(l(3), c(0), true, t)),
        i(MirInstKind.MirSimdLoad(l(4), c(1), true, it)),
        i(MirInstKind.MirSimdScatter(c(3), c(2), c(4)))])

fn splat_copy_case(shape: text) -> Case:
    val t = ty(shape)
    val value = if shape == "f32": MirOperand(kind: MirOperandKind.Const(MirConstValue.Float(-2.5), MirType(kind: MirTypeKind.F32))) elif shape == "f64": MirOperand(kind: MirOperandKind.Const(MirConstValue.Float(-2.5), MirType(kind: MirTypeKind.F64))) else: MirOperand.const_int(-7)
    simple_case("splatcopy_{shape}", shape, shape, [t, t, t], [
        i(MirInstKind.MirSimdSplat(l(3), value, t)),
        i(MirInstKind.MirSimdLoad(l(4), c(0), true, t)),
        i(MirInstKind.MirSimdBinop(l(5), c(3), c(4), if shape == "i32": "Xor" else: "Add")),
        i(MirInstKind.Copy(l(4), l(5))),
        i(MirInstKind.MirSimdStore(c(4), c(2), true))])

fn fma_case(shape: text, op: text) -> Case:
    val t = ty(shape)
    simple_case("fma_{op}_{shape}", shape, shape, [t, t, t], [
        i(MirInstKind.MirSimdLoad(l(3), c(0), true, t)),
        i(MirInstKind.MirSimdLoad(l(4), c(1), true, t)),
        i(MirInstKind.MirSimdTernop(l(5), c(3), c(4), c(3), op)),
        i(MirInstKind.MirSimdStore(c(5), c(2), true))])

fn abi_case(shape: text) -> Case:
    # callee(v, w) -> v * w - v ; caller(a, b, out): out = callee(load a, load b)
    val t = ty(shape)
    val callee_locals = [
        MirLocal(id: LocalId(id: 0), name: Some("v"), type_: t, kind: LocalKind.Arg(0)),
        MirLocal(id: LocalId(id: 1), name: Some("w"), type_: t, kind: LocalKind.Arg(1)),
        MirLocal(id: LocalId(id: 2), name: Some("p"), type_: t, kind: LocalKind.Temp),
        MirLocal(id: LocalId(id: 3), name: Some("r"), type_: t, kind: LocalKind.Temp)
    ]
    val callee_block = MirBlock(id: BlockId.new(0), label: Some("entry"), instructions: [
        i(MirInstKind.MirSimdBinop(l(2), c(0), c(1), "Mul")),
        i(MirInstKind.MirSimdBinop(l(3), c(2), c(0), "Sub"))], terminator: MirTerminator.Ret(Some(c(3))))
    val callee = MirFunction(
        symbol: SymbolId.new(1), name: "abi_callee_{shape}",
        signature: MirSignature(params: [t, t], return_type: t, is_variadic: false),
        locals: callee_locals, blocks: [callee_block], entry_block: BlockId.new(0),
        span: Span(start: 0, end: 0, line: 1, col: 1), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {})
    val name = MirOperand(kind: MirOperandKind.Const(MirConstValue.Str("abi_callee_{shape}"), MirType.i64()))
    val caller = func("abi_{shape}", 0, [t, t, t], [
        i(MirInstKind.MirSimdLoad(l(3), c(0), true, t)),
        i(MirInstKind.MirSimdLoad(l(4), c(1), true, t)),
        i(MirInstKind.Call(Some(l(5)), name, [c(3), c(4)])),
        i(MirInstKind.MirSimdStore(c(5), c(2), true))])
    Case(group: "abi_{shape}", atag: shape, btag: shape, module: module_of("abi_{shape}", [caller, callee]))

fn spill_case() -> Case:
    # 20 scalar values stay live across AVX-512 frame operations.
    val t = ty("i32")
    var extra: [MirType] = [t, t, t]
    for k in 0..21:
        extra.push(MirType.i64())
    var insts: [MirInst] = [i(MirInstKind.MirSimdLoad(l(3), c(0), true, t))]
    for k in 0..20:
        insts.push(i(MirInstKind.Const(l(6 + k), MirConstValue.Int(1000 + k * 7), MirType.i64())))
    insts.push(i(MirInstKind.MirSimdBinop(l(4), c(3), c(3), "Add")))
    insts.push(i(MirInstKind.MirSimdSplat(l(5), c(6 + 19), t)))
    insts.push(i(MirInstKind.MirSimdBinop(l(4), c(4), c(5), "Add")))
    insts.push(i(MirInstKind.MirSimdStore(c(4), c(2), true)))
    for k in 1..20:
        insts.push(i(MirInstKind.BinOp(l(6), MirBinOp.Add, c(6), c(6 + k))))
    insts.push(i(MirInstKind.Store(c(1), c(6))))
    simple_case("spill_i32", "i32", "i32", extra, insts)

describe "x86 AVX-512 frame-vector backend, both capability modes":
    it "encodes every operation family with ZMM when admitted and without any EVEX in the scalar fallback":
        val idx8 = MirType(kind: MirTypeKind.Vec8i)
        var cases: [Case] = []
        for shape in ["f32", "f64"]:
            for op in ["Add", "Sub", "Mul", "Div", "Min", "Max"]:
                cases.push(binop_case(shape, op, shape))
            for op in ["Neg", "Abs", "Sqrt", "Recip", "RecipSqrt"]:
                cases.push(unop_case(shape, op))
            for op in ["Sum", "Min", "Max"]:
                cases.push(reduce_case(shape, op))
            cases.push(fma_case(shape, "Fma"))
            cases.push(fma_case(shape, "Fnmadd"))
        for op in ["Add", "Sub", "Mul", "Min", "Max", "And", "Or", "Xor", "Andnot"]:
            cases.push(binop_case("i32", op, "i32"))
        for op in ["Shl", "ShrLogical", "ShrArith"]:
            cases.push(binop_case("i32", op, "shift"))
        for op in ["Neg", "Not"]:
            cases.push(unop_case("i32", op))
        for op in ["Sum", "Min", "Max", "And", "Or", "Xor"]:
            cases.push(reduce_case("i32", op))
        for shape in ["f32", "f64", "i32"]:
            for op in ["Eq", "Ne", "Lt", "Le", "Gt", "Ge"]:
                cases.push(cmp_case(shape, op))
            for op in ["And", "Or", "Xor", "Andnot", "Not"]:
                cases.push(mask_case(shape, op))
            cases.push(permute_case(shape, idx8))
            for kind in ["Reverse", "InterleaveLo", "InterleaveHi", "BroadcastLane"]:
                cases.push(shuffle_case(shape, kind))
            cases.push(gather_case(shape, idx8))
            cases.push(scatter_case(shape, idx8))
            cases.push(splat_copy_case(shape))
            cases.push(abi_case(shape))
        cases.push(spill_case())
        var out = ""
        var bad: [text] = []
        var emitted = 0
        for case_ in cases:
            # FMA has no exact scalar fallback; it is refused by name there.
            val modes = if case_.group.starts_with("fma_"): ["avx"] else: ["avx", "scalar"]
            for mode in modes:
                val result = emit_case(mode, case_)
                emitted = emitted + 1
                if not result.evidence_ok: bad.push("{case_.group}:{mode}")
                out = out + result.text_
        val dump = env_get_or("SIMPLE_AVX512_EXEC_DUMP", "")
        if dump != "": expect(file_write(dump, out)).to_equal(true)
        expect(emitted).to_equal(222)
        expect(bad).to_equal([])
