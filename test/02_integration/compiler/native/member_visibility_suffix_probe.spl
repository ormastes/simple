# Native regression probe: expected exit 77 AND member_visibility_cases=18 failures=0.
# Source-import execution in the repository remains pending; private native evidence is in the bug report.
use compiler.common.dependency.member_visibility.{member_layer_and_tail}

fn check_layer(label: text, path: text, expected_layer: text, expected_tail: text) -> i64:
    val actual = member_layer_and_tail(path)
    if actual.0 != expected_layer or actual.1 != expected_tail:
        print "FAIL {label}: layer={actual.0} tail={actual.1}"
        return 1
    0

fn main() -> i64:
    var failures = 0
    failures = failures + check_layer("empty", "", "", "")
    failures = failures + check_layer("single", "one", "", "")
    failures = failures + check_layer("compiler-only", "compiler", "", "")
    failures = failures + check_layer("two-components", "app/main.spl", "app", "main.spl")
    failures = failures + check_layer("compiler-short-boundary", "compiler/20.hir", "compiler", "20.hir")
    failures = failures + check_layer("compiler-minimum", "compiler/20.hir/node.spl", "20.hir", "node.spl")
    failures = failures + check_layer("complete-tail", "compiler/20.hir/one/two/node.spl", "20.hir", "one/two/node.spl")
    failures = failures + check_layer("empty-tail", "app/", "app", "")
    failures = failures + check_layer("compiler-empty-tail", "compiler/20.hir/", "20.hir", "")
    failures = failures + check_layer("empty-interior-and-end", "compiler/20.hir//node/", "20.hir", "/node/")
    failures = failures + check_layer("leading-empty-segment", "/app/main.spl", "", "app/main.spl")
    failures = failures + check_layer("korean", "compiler/계층/경로/파일.spl", "계층", "경로/파일.spl")
    failures = failures + check_layer("supplementary-unicode", "app/😀/é.spl", "app", "😀/é.spl")
    failures = failures + check_layer("absolute-src-marker", "/work/src/compiler/50.mir/lower.spl", "50.mir", "lower.spl")
    failures = failures + check_layer("relative-src-marker", "src/lib/foo/bar.spl", "lib", "foo/bar.spl")
    failures = failures + check_layer("two-empty-tail-segments", "app//", "app", "/")
    failures = failures + check_layer("empty-compiler-layer", "compiler//node.spl", "", "node.spl")
    failures = failures + check_layer("delimiter-only", "/", "", "")
    print "member_visibility_cases=18 failures={failures}"
    if failures != 0:
        return 100 + failures
    # A false zero-return native function cannot satisfy this sentinel.
    return 77
