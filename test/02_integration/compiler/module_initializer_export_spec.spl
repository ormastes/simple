# Requires an admitted pure compiled test host. Authored; execution pending.
use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_verify.{mir_verify_module}
use compiler.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.backend.common.mir_text_codegen.{MirTextCodegen}

describe "Native module initializer export authority", tag: ["only-compiled"]:
    it "preserves the startup ABI while qualifying ordinary library functions":
        # @req REQ-MODULE-INIT-EXPORT-001
        step("Parse a library global initialized by an ordinary function")
        val path = "initializer_export_owner.spl"
        val source = "fn initial_value() -> i64:\n    23\n\nvar stored: i64 = initial_value()\n"
        val parsed = parse_full_frontend(source, path, path, Logger(level: 0))
        var hir_lowering = HirLowering.with_filename(path)
        val hir = hir_lowering.lower_module(parsed)
        expect(hir_lowering.errors.len()).to_equal(0)
        var lowering = MirLowering.new(hir.symbols)
        val mir = lowering.lower_module(hir, is_entry_module: false)
        expect(lowering.errors.len()).to_equal(0)
        expect(mir_verify_module(mir).fatal_count()).to_equal(0)

        step("Require the real generated initializer to declare its canonical export")
        var initializer_name = ""
        var initializer_count = 0
        var ordinary_name = ""
        for function in mir.functions.values():
            if function.name.starts_with("__module_init_"):
                initializer_count = initializer_count + 1
                initializer_name = function.name
                expect(function.is_export_c).to_equal(true)
                expect(function.export_name).to_equal(function.name)
            elif function.name == "initial_value" or function.name.ends_with(".initial_value"):
                ordinary_name = function.name
                expect(function.is_export_c).to_equal(false)
        expect(initializer_count).to_equal(1)
        expect(ordinary_name != "").to_equal(true)

        step("Translate the nonentry module and inspect actual LLVM definitions")
        var translator = MirToLlvm.create(mir.name, CodegenTarget.X86_64, nil)
        translator.no_mangle = false
        val ir = translator.translate_module_with_entry(mir, false)
        var init_definitions = 0
        var qualified_init_definitions = 0
        var ordinary_definitions = 0
        val ordinary_symbol = if ordinary_name.contains("."): ordinary_name else: "{mir.name}.{ordinary_name}"
        for line in ir.split("\n"):
            if not line.starts_with("define "): continue
            if line.contains("@{initializer_name}("): init_definitions = init_definitions + 1
            if line.contains("@{mir.name}.{initializer_name}("): qualified_init_definitions = qualified_init_definitions + 1
            if line.contains("@{ordinary_symbol}("): ordinary_definitions = ordinary_definitions + 1
        expect(init_definitions).to_equal(1)
        expect(qualified_init_definitions).to_equal(0)
        expect(ordinary_definitions).to_equal(1)
