# Requires an admitted pure compiled test host; bootstrap CLI is not a test host.
# Authored regression, UNRUN until such a host executes these real helpers.
use std.spec
use mcdc_required_token_probe.{check_mcdc_shared_lowerer, check_mcdc_nested_early_return, check_mcdc_entry_configuration}

describe "MC/DC token stack ownership", tag: ["only-compiled"]:
    it "closes nested decisions and isolates later functions and excluded modules":
        # @req REQ-MCDC-TOKEN-STACK-001
        step("Lower nested decisions then excluded helpers with the same lowering owner")
        expect(check_mcdc_shared_lowerer(1)).to_equal(true)
        expect(check_mcdc_shared_lowerer(2)).to_equal(true)

    it "aborts active nested tokens once each from inner to outer on early return":
        # @req REQ-MCDC-TOKEN-STACK-002
        step("Lower a real HIR return and verify its MIR cleanup token order")
        expect(check_mcdc_nested_early_return(1)).to_equal(true)
        expect(check_mcdc_nested_early_return(2)).to_equal(true)

    it "configures only an enabled program entry before its first decision":
        # @req REQ-MCDC-ENTRY-CONFIGURATION-003
        step("Lower entry and library main functions in off, static and dynamic modes")
        for mode in [0, 1, 2]:
            expect(check_mcdc_entry_configuration(mode, true)).to_equal(true)
            expect(check_mcdc_entry_configuration(mode, false)).to_equal(true)
