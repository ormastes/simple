use std.nogc_sync_mut.io.file_ops.{file_read}

fn fail(reason: text) -> i32:
    print("streaming_phase_boundary_owner_probe=FAIL reason=" + reason)
    1

fn between(source: text, start_marker: text, end_marker: text) -> text:
    val start_parts = source.split(start_marker)
    if start_parts.len() < 2:
        return ""
    val tail = start_parts[1]
    val end_parts = tail.split(end_marker)
    if end_parts.len() < 2:
        return tail
    end_parts[0]

fn line_position(source: text, needle: text) -> i64:
    val lines = source.split("\n")
    var index: i64 = 0
    while index < lines.len():
        if lines[index].contains(needle):
            return index
        index = index + 1
    -1

fn main() -> i32:
    val orchestration = file_read("src/compiler/80.driver/driver_orchestration.spl")
    val parsing = file_read("src/compiler/80.driver/driver_source_pipeline_parsing.spl")
    val lowering = file_read("src/compiler/80.driver/driver_hir_pipeline_lowering.spl")
    val compile_body = between(
        orchestration,
        "    me compile() -> CompileResult:",
        "    me compile_vhdl_only() -> CompileResult:")
    val parse_body = between(
        parsing,
        "    me parse_all_streaming_surfaces_impl() -> bool:",
        "    me parse_all_impl() -> (CompileContext, bool):")
    val hir_body = between(
        lowering,
        "    me lower_and_check_streaming_surfaces_impl() -> bool:",
        "    me lower_and_check_impl() -> (CompileContext, bool):")
    val hir_file_body = between(
        lowering,
        "    me lower_streaming_surface_source(",
        "    me lower_and_check_streaming_surfaces_impl() -> bool:")
    if not hir_file_body.contains(
        ") -> Result<HirModule, DriverStage3HirFailure>:") or
       not hir_file_body.contains("evidence_source_index: i64"):
        return fail("phase3-hir-file-owner-signature-stale")

    val selector = line_position(compile_body,
        "val streaming_pipeline = driver_streaming_surface_enabled(self.ctx)")
    val phase2 = line_position(compile_body, "log_phase(\"phase2:parse:start\")")
    val stream_parse = line_position(compile_body,
        "parse_ok = self.parse_all_streaming_surfaces_impl()")
    val tuple_parse = line_position(compile_body,
        "val (parsed_ctx, returned_parse_ok) = self.parse_all_impl()")
    val stream_hir = line_position(compile_body,
        "analyze_ok = self.lower_and_check_streaming_surfaces_impl()")
    val tuple_hir = line_position(compile_body,
        "val (analyzed_ctx, returned_analyze_ok) = self.lower_and_check_impl()")
    if selector < 0 or selector > phase2:
        return fail("selector-not-captured-before-phase2")
    if stream_parse < phase2 or tuple_parse < stream_parse:
        return fail("streaming-parse-not-selected-in-place")
    if stream_hir < tuple_parse or tuple_hir < stream_hir:
        return fail("streaming-hir-not-selected-in-place")
    if not compile_body.contains(
        "if self.ctx.source_contents_reclaimable() and not streaming_pipeline:"):
        return fail("source-reclaim-recomputes-selector")

    if not parse_body.contains(
        "self.ctx.module_surfaces = Some(finished_surfaces.unwrap())"):
        return fail("phase2-surfaces-not-committed-in-place")
    if not parse_body.contains("self.ctx.modules = {}"):
        return fail("phase2-modules-not-cleared-in-place")
    if parse_body.contains("streaming_ctx") or parse_body.contains("return (self.ctx"):
        return fail("phase2-context-copy-remains")

    if not hir_body.contains("self.ctx.hir_modules = phase_hir_modules"):
        return fail("phase3-hir-not-committed-in-place")
    if not hir_body.contains("self.ctx.hir_module_count_value = streaming_hir_module_count"):
        return fail("phase3-hir-count-not-committed-in-place")
    if hir_body.contains("phase_ctx") or hir_body.contains("return (self.ctx"):
        return fail("phase3-context-copy-remains")
    if not hir_body.contains(
        "phase3:streaming_boundary selector=true sources={{self.ctx.sources.len()}} surfaces={{surfaces.surfaces.len()}} first_hir_file={{first_hir_file}} hir_done=0"):
        return fail("phase3-boundary-receipt-missing")
    if line_position(hir_body, "phase3:streaming_boundary") >
            line_position(hir_body, "while source_index < self.ctx.sources.len()"):
        return fail("phase3-boundary-receipt-after-first-hir")

    val state_owner = line_position(hir_body,
        "var state_by_surface: [text] = []")
    val new_state = line_position(hir_body,
        "state_by_surface.push(\"new\")")
    val bounds_check = line_position(hir_body,
        "if surface_index < 0 or surface_index >= surfaces.surfaces.len():")
    val lowered_gate = line_position(hir_body,
        "if surface_state == \"lowered\":")
    val poisoned_gate = line_position(hir_body,
        "if surface_state == \"poisoned\":")
    val attempted_gate = line_position(hir_body,
        "if surface_state == \"attempted\":")
    val unknown_gate = line_position(hir_body,
        "if surface_state != \"new\":")
    val scalar_check = line_position(hir_body,
        "if not driver_stage3_surface_identity_matches(")
    val attempt_commit = line_position(hir_body,
        "state_by_surface[surface_index] = \"attempted\"")
    val physical_lower = line_position(hir_body,
        "self.lower_streaming_surface_source(")
    val store_hir = line_position(hir_body,
        "lowered_by_surface[surface_index] = hir_module")
    val lowered_commit = line_position(hir_body,
        "state_by_surface[surface_index] = \"lowered\"")
    if state_owner < 0 or new_state <= state_owner:
        return fail("phase3-bootstrap-safe-state-owner-missing")
    if bounds_check < new_state or lowered_gate <= bounds_check:
        return fail("phase3-state-read-not-bounds-guarded")
    if (poisoned_gate <= lowered_gate or attempted_gate <= poisoned_gate or
            unknown_gate <= attempted_gate):
        return fail("phase3-state-gates-not-explicit-and-ordered")
    if (scalar_check <= unknown_gate or attempt_commit <= scalar_check or
            physical_lower <= attempt_commit):
        return fail("phase3-first-owner-transition-order-invalid")
    if lowered_commit != store_hir + 1:
        return fail("phase3-lowered-state-not-committed-with-hir")
    if (hir_body.contains("attempted_by_surface") or
            hir_body.contains("poisoned_by_surface") or
            hir_body.contains(": [bool]")):
        return fail("phase3-staged-unsafe-bool-state-remains")
    val poison_transition = "state_by_surface[surface_index] = \"poisoned\""
    if hir_body.split(poison_transition).len() != 3:
        return fail("phase3-poison-transition-not-on-both-failure-paths")
    if not hir_body.contains(
        "alias_poison_ctx.mark_module_poisoned(source.module_name)"):
        return fail("phase3-poisoned-alias-diagnostic-skip-missing")
    if not hir_body.contains(
        "phase_hir_modules[source.module_name] = alias_hir"):
        return fail("phase3-successful-alias-reuse-missing")

    val scope_begin = line_position(hir_file_body,
        "if not rt_transient_array_scope_begin():")
    val parse = line_position(hir_file_body,
        "val module = parse_full_frontend(")
    val lower = line_position(hir_file_body,
        "val hir_module = lowering.lower_parser_module_unstub(module, is_entry)")
    val pause = line_position(hir_file_body,
        "if not rt_transient_array_scope_pause():")
    val hir_promote = line_position(hir_file_body,
        "if not rt_transient_heap_promote(hir_module):")
    val owner_promote = line_position(hir_file_body,
        "if not lowering.promote_transient_compilation_roots():")
    val bootstrap_promote = line_position(hir_file_body,
        "if not bootstrap_hir_modules_promote_transient_roots():")
    val detach = line_position(hir_file_body,
        "lowering.detach_transient_module_scratch()")
    if (scope_begin < 0 or parse <= scope_begin or lower <= parse or
            pause <= lower or hir_promote <= pause or
            owner_promote <= hir_promote or
            bootstrap_promote <= owner_promote or detach <= bootstrap_promote):
        return fail("phase3-hir-active-pause-promote-detach-order-invalid")
    val detach_tail = hir_file_body.split(
        "lowering.detach_transient_module_scratch()")
    if detach_tail.len() < 2:
        return fail("phase3-hir-detach-tail-missing")
    val end_after_detach = line_position(detach_tail[1],
        "if not driver_end_transient_parse_scope():")
    val released_after_detach = line_position(detach_tail[1],
        "log_hir_transient_scope_released(")
    if end_after_detach < 0 or released_after_detach <= end_after_detach:
        return fail("phase3-hir-end-release-order-invalid")
    if hir_file_body.contains("rt_transient_heap_promote(lowering)"):
        return fail("phase3-whole-lowering-promotion-returned")

    print("streaming_phase_boundary_owner_probe=PASS selector_once=1 phase2_in_place=1 phase3_in_place=1 boundary_receipt=1 hir_surface_state=text hir_scope_order=active-pause-promote-detach-end")
    0
