"""Actual Optional text equality semantics; native-backend execution required.
Execution UNRUN. This fixture does not replace the database alias/persistence probe.
"""
use std.spec.*

struct OptionalTextStoreV1:
    fields: Dict<text, text>

    fn lookup(key: text) -> text?:
        if self.fields.contains_key(key):
            Some(self.fields[key])
        else:
            nil

describe "Optional text equality uses presence and content":
    it "compares method-return raw text and tagged Some by content in both directions":
        val store = OptionalTextStoreV1(fields: {"key": "word"})
        val value: text? = store.lookup("key")
        expect(value == Some("word")).to_be(true)
        expect(Some("word") == value).to_be(true)
        expect(value != Some("other")).to_be(true)
        expect(value == Some("other")).to_be(false)

    it "distinguishes absent, present-empty and nonempty values":
        val store = OptionalTextStoreV1(fields: {"empty": ""})
        val absent: text? = store.lookup("missing")
        val other_absent: text? = nil
        val empty: text? = store.lookup("empty")
        expect(absent == other_absent).to_be(true)
        expect(empty == absent).to_be(false)
        expect(absent == empty).to_be(false)
        expect(empty == Some("")).to_be(true)

    it "compares UTF8 content and preserves nested absence layers":
        val store = OptionalTextStoreV1(fields: {"key": "Ω漢字"})
        val value: text? = store.lookup("key")
        expect(value == Some("Ω漢字")).to_be(true)
        expect(value == Some("Ω漢詞")).to_be(false)
        val absent: text? = nil
        val outer_none: Option<Option<text>> = nil
        val inner_none: Option<Option<text>> = Some(absent)
        val second_inner_none: Option<Option<text>> = Some(absent)
        val nested: Option<Option<text>> = Some(value)
        val expected: Option<Option<text>> = Some(Some("Ω漢字"))
        expect(inner_none == outer_none).to_be(false)
        expect(inner_none != outer_none).to_be(true)
        expect(inner_none == second_inner_none).to_be(true)
        expect(nested == expected).to_be(true)
        expect(inner_none == nested).to_be(false)
