#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
lexer="$root/src/compiler/10.frontend/core/lexer.spl"
runtime="$root/src/compiler/10.frontend/lexer/lexical_scan_runtime.spl"
simd="$root/src/compiler/10.frontend/lexer/lexical_scan_simd.spl"
counters="$root/src/compiler/80.driver/perf/demand_compile_counters.spl"

grep -Fq 'use compiler.frontend.lexer.lexical_scan_runtime.{lexical_scan_runtime_scan_v1}' "$lexer"
grep -Fq 'lexical_scan_runtime_scan_v1(core_source)' "$lexer"
grep -Fq 'make_core_lexer_with_marks(core_source, lexical_scan.scan.marks)' "$lexer"
grep -Fq 'me lexical_class_at_pos() -> LexicalScanClass:' "$root/src/compiler/10.frontend/core/lexer_struct.spl"
grep -Fq 'lexical_class == LexicalScanClass.Newline' "$root/src/compiler/10.frontend/core/lexer_struct.spl"
grep -Fq 'lexical_scan_capability_scalar()' "$runtime"
grep -Fq 'lexical_scan_admit_cpu_simd' "$runtime"
grep -Fq 'if scan.divergence_fallback:' "$runtime"
grep -Fq 'gpu_notification_count' "$runtime"
grep -Fq 'divergence_fallback: provider == LexicalScanProvider.CpuSimd' "$simd"
grep -Fq 'demand_compile_counters_capture_lexical_v1' "$counters"
grep -Fq 'lexical-divergence-fallback=' "$counters"

if grep -Eq 'Gpu|GPU' "$runtime" && grep -Eq 'used_provider:.*Gpu|LexicalScanProvider\.Gpu' "$runtime"; then
    echo 'GPU must remain notification-only' >&2
    exit 1
fi

echo 'LEXICAL_SCAN_ENTRYPOINT_STATIC_PASS'
