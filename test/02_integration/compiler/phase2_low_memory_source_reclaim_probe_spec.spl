use phase2_low_memory_source_reclaim_probe.{
    source_has_ordered_post_parse_reclaim,
    source_has_low_memory_non_vhdl_guard,
    source_has_complete_lexer_release,
    source_contract_negative_control
}
use std.nogc_sync_mut.io.file_ops.{file_read}
use std.spec.{describe, it, expect}

describe "Phase-2 source-reclaim exact-body contracts":
    it "accepts the current exact production bodies":
        expect(source_has_ordered_post_parse_reclaim(
            file_read("src/compiler/80.driver/driver.spl")
        )).to_equal(true)
        expect(source_has_low_memory_non_vhdl_guard(
            file_read("src/compiler/80.driver/driver_types.spl")
        )).to_equal(true)
        expect(source_has_complete_lexer_release(
            file_read("src/compiler/10.frontend/core/lexer.spl")
        )).to_equal(true)

    it "rejects tokens placed outside their target bodies":
        expect(source_contract_negative_control()).to_equal(true)
