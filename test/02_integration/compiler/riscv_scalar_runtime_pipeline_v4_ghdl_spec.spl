# codex-system-test
use std.spec.*
use app.io.vhdl_ffi.{ghdl_available, ghdl_unique_workdir, ghdl_analyze_in,
    ghdl_elaborate_in, ghdl_run_in, vhdl_write_file}
use compiler.mir.hwir.types.{CoreConfig}
use compiler.backend.backend.riscv_scalar_runtime_pipeline_v4_to_vhdl.{
    compile_strict_riscv_scalar_runtime_pipeline_v4}

fn runtime_pipeline_v4_testbench(entity_name: text, xlen: i32,
    vectors: text) -> text:
    """
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use std.env.all;
entity {entity_name}_tb is end entity;
architecture sim of {entity_name}_tb is
  signal clk : std_logic := '0';
  signal rst : std_logic := '0';
  signal in_valid : std_logic := '0';
  signal in_ready : std_logic := '0';
  signal instruction : std_logic_vector(31 downto 0) := (others => '0');
  signal instruction_length_bytes : std_logic_vector(2 downto 0) := (others => '0');
  signal rs1_value : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal rs2_value : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal pc_before : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal fallthrough_pc : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal privilege : std_logic_vector(1 downto 0) := (others => '0');
  signal provider_event_id : std_logic_vector(63 downto 0) := (others => '0');
  signal decode_event_id : std_logic_vector(63 downto 0) := (others => '0');
  signal completion_ready : std_logic := '0';
  signal completion_valid : std_logic := '0';
  signal completion_rd : std_logic_vector(4 downto 0) := (others => '0');
  signal completion_rd_write : std_logic := '0';
  signal completion_rd_value : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal completion_pc_after : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal completion_execute_trap_valid : std_logic := '0';
  signal completion_execute_trap_cause : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal completion_execute_trap_tval : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal completion_redirect_valid : std_logic := '0';
  signal completion_redirect_target : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal completion_provider_event_id : std_logic_vector(63 downto 0) := (others => '0');
  signal completion_decode_event_id : std_logic_vector(63 downto 0) := (others => '0');
  signal completion_illegal_valid : std_logic := '0';
  signal runtime_protocol_fault : std_logic := '0';
begin
  dut: entity work.{entity_name} port map(
    clk => clk, rst => rst, in_valid => in_valid, in_ready => in_ready,
    instruction => instruction,
    instruction_length_bytes => instruction_length_bytes,
    rs1_value => rs1_value, rs2_value => rs2_value,
    pc_before => pc_before, fallthrough_pc => fallthrough_pc,
    privilege => privilege, provider_event_id => provider_event_id,
    decode_event_id => decode_event_id, completion_ready => completion_ready,
    completion_valid => completion_valid, completion_rd => completion_rd,
    completion_rd_write => completion_rd_write,
    completion_rd_value => completion_rd_value,
    completion_pc_after => completion_pc_after,
    completion_execute_trap_valid => completion_execute_trap_valid,
    completion_execute_trap_cause => completion_execute_trap_cause,
    completion_execute_trap_tval => completion_execute_trap_tval,
    completion_redirect_valid => completion_redirect_valid,
    completion_redirect_target => completion_redirect_target,
    completion_provider_event_id => completion_provider_event_id,
    completion_decode_event_id => completion_decode_event_id,
    completion_illegal_valid => completion_illegal_valid,
    runtime_protocol_fault => runtime_protocol_fault);
  process
    procedure tick is
    begin
      wait for 1 ns; clk <= '1'; wait for 1 ns; clk <= '0'; wait for 1 ns;
    end procedure;
    procedure drive(
      constant insn : std_logic_vector(31 downto 0);
      constant lhs : std_logic_vector({xlen - 1} downto 0);
      constant rhs : std_logic_vector({xlen - 1} downto 0);
      constant pc_value : std_logic_vector({xlen - 1} downto 0);
      constant event_id : std_logic_vector(63 downto 0)) is
    begin
      in_valid <= '1'; instruction <= insn; instruction_length_bytes <= "100";
      rs1_value <= lhs; rs2_value <= rhs; pc_before <= pc_value;
      fallthrough_pc <= std_logic_vector(unsigned(pc_value) + 4);
      privilege <= "11"; provider_event_id <= event_id; decode_event_id <= event_id;
    end procedure;
  begin
    rst <= '1'; tick; rst <= '0'; wait for 1 ns;
    assert in_ready = '1' and completion_valid = '0' and
      runtime_protocol_fault = '0'
      report "pipeline v4 reset state is invalid" severity failure;
{vectors}    finish;
  end process;
end architecture;
"""

fn runtime_pipeline_v4_rv32_vectors() -> text:
    """
    completion_ready <= '0';
    -- Minimal v3 ALU regression.
    drive(x"007302B3", x"00000011", x"00000022", x"00000100",
      x"0000000000000007");
    tick; in_valid <= '0'; tick;
    assert completion_valid = '1' and completion_rd = "00101" and
      completion_rd_write = '1' and completion_rd_value = x"00000033" and
      runtime_protocol_fault = '0'
      report "pipeline v4 regressed the v3 ALU lane" severity failure;
    completion_ready <= '1'; tick; completion_ready <= '0';

    -- ECALL cause is privilege-derived: U=8, S=9, M=11.
    drive(x"00000073", x"00000000", x"00000000", x"00000200",
      x"0000000000000008"); privilege <= "00";
    tick; in_valid <= '0'; tick;
    assert completion_valid = '1' and completion_execute_trap_valid = '1' and
      completion_execute_trap_cause = x"00000008" and
      completion_execute_trap_tval = x"00000000" and completion_illegal_valid = '0'
      report "U-mode ECALL completion is invalid" severity failure;
    completion_ready <= '1'; tick; completion_ready <= '0';

    drive(x"00000073", x"00000000", x"00000000", x"00000300",
      x"0000000000000009"); privilege <= "01";
    tick; in_valid <= '0'; tick;
    assert completion_valid = '1' and completion_execute_trap_cause = x"00000009" and
      completion_illegal_valid = '0'
      report "S-mode ECALL completion is invalid" severity failure;
    completion_ready <= '1'; tick; completion_ready <= '0';

    drive(x"00000073", x"00000000", x"00000000", x"00000400",
      x"000000000000000A"); privilege <= "11";
    tick; in_valid <= '0'; tick;
    assert completion_valid = '1' and completion_execute_trap_cause = x"0000000B" and
      completion_illegal_valid = '0'
      report "M-mode ECALL completion is invalid" severity failure;
    completion_ready <= '1'; tick; completion_ready <= '0';

    drive(x"00100073", x"00000000", x"00000000", x"00000500",
      x"000000000000000B"); privilege <= "11";
    tick; in_valid <= '0'; tick;
    assert completion_valid = '1' and completion_execute_trap_valid = '1' and
      completion_execute_trap_cause = x"00000003" and
      completion_execute_trap_tval = x"00000000" and completion_illegal_valid = '0'
      report "EBREAK completion is invalid" severity failure;
    completion_ready <= '1'; tick; completion_ready <= '0';

    drive(x"00000073", x"00000000", x"00000000", x"00000600",
      x"000000000000000C"); privilege <= "10";
    tick; in_valid <= '0'; tick;
    assert completion_valid = '1' and completion_execute_trap_valid = '1' and
      completion_execute_trap_cause = x"00000002" and
      completion_execute_trap_tval = x"00000073" and completion_illegal_valid = '0'
      report "reserved-privilege SYSTEM completion is invalid" severity failure;
    completion_ready <= '1'; tick; completion_ready <= '0';

    -- Hold a SYSTEM completion while every live input changes, then consume once.
    drive(x"00100073", x"00000000", x"00000000", x"00000700",
      x"000000000000000D"); privilege <= "11";
    tick; in_valid <= '0'; tick;
    instruction <= x"007302B3"; privilege <= "00"; pc_before <= x"DEADBEEF";
    fallthrough_pc <= x"DEADBEF3"; provider_event_id <= x"0000000000000063";
    decode_event_id <= x"0000000000000063"; tick;
    assert completion_valid = '1' and completion_execute_trap_cause = x"00000003" and
      completion_pc_after = x"00000704" and
      completion_provider_event_id = x"000000000000000D" and
      completion_decode_event_id = x"000000000000000D"
      report "backpressured SYSTEM completion changed with live inputs" severity failure;
    completion_ready <= '1'; tick;
    assert completion_valid = '0' report "SYSTEM completion was not consumed" severity failure;
    completion_ready <= '0'; tick;
    assert completion_valid = '0' report "SYSTEM completion was consumed twice" severity failure;

    -- Malformed lineage is sticky and reset recovers it.
    drive(x"00000073", x"00000000", x"00000000", x"00000800",
      x"000000000000000E"); decode_event_id <= x"000000000000000F";
    tick; in_valid <= '0'; tick;
    assert completion_valid = '0' and runtime_protocol_fault = '1'
      report "malformed SYSTEM lineage did not fault closed" severity failure;
    rst <= '1'; tick; rst <= '0'; wait for 1 ns;
    assert runtime_protocol_fault = '0' and in_ready = '1'
      report "reset did not clear malformed SYSTEM fault" severity failure;

    drive(x"0000000F", x"00000000", x"00000000", x"00000400",
      x"0000000000000010");
    tick; in_valid <= '0'; tick;
    assert completion_valid = '0' and runtime_protocol_fault = '1'
      report "legal unsupported FENCE did not fault closed" severity failure;
    instruction <= x"007302B3"; wait for 1 ns; tick;
    assert runtime_protocol_fault = '1' and completion_valid = '0'
      report "unsupported semantic fault was not sticky" severity failure;

    rst <= '1'; tick; rst <= '0'; wait for 1 ns;
    assert runtime_protocol_fault = '0' and in_ready = '1' and
      completion_valid = '0'
      report "reset did not recover the faulted RV32 pipeline v4" severity failure;
"""

fn runtime_pipeline_v4_rv64_vectors() -> text:
    """
    completion_ready <= '0';
    drive(x"0010819B", x"000000007FFFFFFF", x"0000000000000000",
      x"0000000000000100", x"0000000000000011");
    tick; in_valid <= '0'; tick;
    assert completion_valid = '1' and completion_rd = "00011" and
      completion_rd_write = '1' and
      completion_rd_value = x"FFFFFFFF80000000" and
      completion_pc_after = x"0000000000000104" and
      completion_redirect_valid = '0' and
      completion_provider_event_id = x"0000000000000011" and
      completion_decode_event_id = x"0000000000000011" and
      runtime_protocol_fault = '0'
      report "RV64 ADDIW completion or sign extension is invalid" severity failure;
    completion_ready <= '1'; tick;
    assert completion_valid = '0'
      report "RV64 ADDIW completion was not consumed once" severity failure;
    completion_ready <= '0';
    drive(x"00000073", x"0000000000000000", x"0000000000000000",
      x"0000000000000200", x"0000000000000012"); privilege <= "11";
    tick; in_valid <= '0'; tick;
    assert completion_valid = '1' and completion_execute_trap_valid = '1' and
      completion_execute_trap_cause = x"000000000000000B" and
      completion_execute_trap_tval = x"0000000000000000" and
      completion_pc_after = x"0000000000000204" and completion_illegal_valid = '0' and
      runtime_protocol_fault = '0'
      report "RV64 M-mode ECALL completion is invalid" severity failure;
    completion_ready <= '1'; tick;
"""

fn simulate_runtime_pipeline_v4(entity_name: text, config: CoreConfig,
    vectors: text) -> bool:
    val emitted = compile_strict_riscv_scalar_runtime_pipeline_v4(entity_name, config)
    if not emitted.is_success(): return false
    val workdir = ghdl_unique_workdir(entity_name)
    if not workdir.?: return false
    val isolated = workdir.unwrap()
    val path = isolated + "/" + entity_name + ".vhd"
    if not vhdl_write_file(path, emitted.vhdl + "\n" +
        runtime_pipeline_v4_testbench(entity_name, config.xlen, vectors)):
        return false
    if not ghdl_analyze_in(path, isolated).success: return false
    if not ghdl_elaborate_in(entity_name + "_tb", isolated).success: return false
    ghdl_run_in(entity_name + "_tb", Some("180ns"), isolated).success

describe "closed runtime scalar pipeline v4 VHDL protocol":
    slow_it "smokes ALU, holds SYSTEM traps, and latches protocol faults until reset":
        val available = ghdl_available()
        expect(available).to_equal(true)
        if not available: return
        expect(simulate_runtime_pipeline_v4("runtime_pipeline_v4_ghdl_rv32",
            CoreConfig.rv32(), runtime_pipeline_v4_rv32_vectors())).to_equal(true)
        expect(simulate_runtime_pipeline_v4("runtime_pipeline_v4_ghdl_rv64",
            CoreConfig.rv64(), runtime_pipeline_v4_rv64_vectors())).to_equal(true)
