use std.spec.{describe, it, expect}
use app.io.process_ops.{shell}

val TYPED_TEXT_FIXTURE = "test/02_integration/compiler/fixtures/typed_text_runtime_symbols.spl"

describe "typed text runtime symbol execution receipt":
    it "executes the provenance-bound strip-lines fixture":
        val result = shell("env -u SIMPLE_BOOTSTRAP -u SIMPLE_RUNTIME_PATH SIMPLE_LIB=src bin/simple run {TYPED_TEXT_FIXTURE}")

        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_contain("typed-text-runtime-symbols: PASS")
        expect(result.stdout.contains("typed-text-runtime-symbols: FAIL")).to_equal(false)
