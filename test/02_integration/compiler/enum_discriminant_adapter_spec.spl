# REQ-MC-003: source -> parser -> HIR -> declaration report -> real driver receipt.
use std.spec.*
use std.spec.step
use compiler.common.config.{Logger}
use compiler.common.assurance.policy_schema.{AssuranceStrictness}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_definitions.{HirEnum, HirExprKind}
use compiler.semantics.enum_contract.{
    EnumDiscriminantFailureKindV1, enum_contract_declaration_report_v1,
    enum_contract_check, enum_contract_check_module
}
use compiler.driver.hir_semantic_consumer_v1.{collect_module_enum_contract_receipt_v1}

fn adapter_lower_v1(source: text, enum_count: i64) -> HirModule:
    val parsed = parse_full_frontend(source, "enum_adapter.spl", "enum_adapter", Logger(level: 0))
    expect(parsed.enums.len()).to_equal(enum_count)
    var lowering = HirLowering.with_filename("enum_adapter.spl")
    val module = lowering.lower_module(parsed)
    expect(lowering.errors.len()).to_equal(0)
    expect(module.enums.len()).to_equal(enum_count)
    module

fn adapter_enum_v1(module: HirModule, name: text) -> HirEnum:
    var found: HirEnum? = nil
    for key in module.enums.keys():
        val enum_: HirEnum = module.enums[key]
        if enum_.name == name:
            found = Some(enum_)
    expect(found == nil).to_equal(false)
    found.unwrap()

fn adapter_first_kind_v1(module: HirModule, name: text) -> text:
    val enum_ = adapter_enum_v1(module, name)
    expect(enum_.variants.len()).to_be_greater_than(0)
    expect(enum_.variants[0].has_discriminant).to_equal(true)
    match enum_.variants[0].discriminant.kind:
        case HirExprKind.Binary(op, left, right): "binary"
        case HirExprKind.Unary(op, operand): "unary"
        case HirExprKind.BoolLit(value): "bool"
        case HirExprKind.FloatLexeme(value, suffix): "float-lexeme"
        case HirExprKind.StringLit(value, interpolations): "string"
        case HirExprKind.Var(symbol): "variable"
        case HirExprKind.NamedVar(symbol, text_name): "variable"
        case HirExprKind.Call(callee, args, type_args): "call"
        case _: "other"

fn expect_adapter_constant_failure_v1(source: text, kind: EnumDiscriminantFailureKindV1,
        expected_hir_kind: text, message: text):
    val module = adapter_lower_v1(source, 1)
    expect(adapter_first_kind_v1(module, "Code")).to_equal(expected_hir_kind)
    val enum_ = adapter_enum_v1(module, "Code")
    expect(enum_.variants.len()).to_equal(2)
    expect(enum_.variants[1].has_discriminant).to_equal(true)
    val report = enum_contract_declaration_report_v1(module, AssuranceStrictness.Critical)
    expect(report.diags.len()).to_equal(0)
    expect(report.constant_failures.len()).to_equal(1)
    val failure = report.constant_failures[0]
    expect(failure.enum_name).to_equal("Code")
    expect(failure.variant_name).to_equal("A")
    expect(failure.kind).to_equal(kind)
    expect(failure.span.line).to_equal(enum_.variants[0].span.line)
    expect(failure.span.col).to_equal(enum_.variants[0].span.col)
    expect(failure.message()).to_equal(message)
    val full = enum_contract_check_module(module, AssuranceStrictness.Critical)
    expect(full.constant_failures.len()).to_equal(1)
    expect(full.constant_failures[0].message()).to_equal(message)
    expect(full.diags.len()).to_equal(0)
    for profile in [AssuranceStrictness.Moderate, AssuranceStrictness.Strict,
                    AssuranceStrictness.Robust, AssuranceStrictness.Critical]:
        val receipt = collect_module_enum_contract_receipt_v1("fixture", module, profile)
        expect(receipt.errors.len()).to_equal(1)
        expect(receipt.warnings.len()).to_equal(0)
        expect(receipt.messages.len()).to_equal(1)
        expect(receipt.errors[0]).to_equal(message)
        expect(receipt.messages[0]).to_equal(message)

fn expect_adapter_integer_v1(expression: text, kind: text, expected: i64):
    val collision = expected + 1
    val source = "@closed\nenum Code:\n    A = " + expression + "\n    B\n    C = " + collision.to_text() + "\n"
    val module = adapter_lower_v1(source, 1)
    expect(adapter_first_kind_v1(module, "Code")).to_equal(kind)
    val report = enum_contract_declaration_report_v1(module, AssuranceStrictness.Critical)
    expect(report.constant_failures.len()).to_equal(0)
    expect(report.diags.len()).to_equal(1)
    expect(report.diags[0].code).to_equal("E-CLOSED-002")
    expect(report.diags[0].detail).to_equal("B / C = " + collision.to_text())

describe "folded enum discriminants retain their declaration identity":
    it "detects a folded explicit value followed by an implicit collision":
        step("Parse a real enum with binary A, implicit B, and explicit C")
        val source = "@closed\nenum Code:\n    A = 2 + 3\n    B\n    C = 6\n"
        val parsed = parse_full_frontend(source, "enum_adapter.spl", "enum_adapter", Logger(level: 0))
        expect(parsed.enums.len()).to_equal(1)
        expect(parsed.enums[0].variants.len()).to_equal(3)
        expect(parsed.enums[0].variants[0].has_discriminant).to_equal(true)
        expect(parsed.enums[0].variants[1].has_discriminant).to_equal(false)
        val module = adapter_lower_v1(source, 1)
        expect(adapter_first_kind_v1(module, "Code")).to_equal("binary")
        val enum_ = adapter_enum_v1(module, "Code")
        expect(enum_.variants[1].has_discriminant).to_equal(false)
        val report = enum_contract_declaration_report_v1(module, AssuranceStrictness.Critical)
        expect(report.constant_failures.len()).to_equal(0)
        expect(report.diags.len()).to_equal(1)
        expect(report.diags[0].code).to_equal("E-CLOSED-002")
        expect(report.diags[0].detail).to_equal("B / C = 6")

    it "does not turn a folded value into implicit zero":
        val module = adapter_lower_v1("@closed\nenum Code:\n    A = 1 + 4\n    B = 0\n", 1)
        expect(adapter_first_kind_v1(module, "Code")).to_equal("binary")
        val report = enum_contract_declaration_report_v1(module, AssuranceStrictness.Critical)
        expect(report.constant_failures.len()).to_equal(0)
        expect(report.diags.len()).to_equal(0)
        val receipt = collect_module_enum_contract_receipt_v1("fixture", module, AssuranceStrictness.Critical)
        expect(receipt.errors.len()).to_equal(0)
        expect(receipt.messages.len()).to_equal(0)

    it "folds nested arithmetic before numbering the next implicit variant":
        val module = adapter_lower_v1("@closed\nenum Code:\n    A = (2 + 3) * 4\n    B\n    C = 21\n", 1)
        expect(adapter_first_kind_v1(module, "Code")).to_equal("binary")
        val report = enum_contract_declaration_report_v1(module, AssuranceStrictness.Critical)
        expect(report.constant_failures.len()).to_equal(0)
        expect(report.diags.len()).to_equal(1)
        expect(report.diags[0].detail).to_equal("B / C = 21")

    it "preserves every supported operator through parsed declarations":
        expect_adapter_integer_v1("7 + 3", "binary", 10)
        expect_adapter_integer_v1("7 - 3", "binary", 4)
        expect_adapter_integer_v1("7 * 3", "binary", 21)
        expect_adapter_integer_v1("7 / 3", "binary", 2)
        expect_adapter_integer_v1("7 % 3", "binary", 1)
        expect_adapter_integer_v1("7 << 2", "binary", 28)
        expect_adapter_integer_v1("28 >> 2", "binary", 7)
        expect_adapter_integer_v1("7 & 3", "binary", 3)
        expect_adapter_integer_v1("4 | 3", "binary", 7)
        expect_adapter_integer_v1("7 ^ 3", "binary", 4)
        expect_adapter_integer_v1("-~1", "unary", 2)

    it "applies the existing evolving range rule to a folded overflow":
        val source = "@evolving(repr: u8, unknown: Other)\nenum Wire:\n    Known = 128 + 128\n    Other(raw: u8)\n"
        val module = adapter_lower_v1(source, 1)
        expect(adapter_first_kind_v1(module, "Wire")).to_equal("binary")
        val report = enum_contract_declaration_report_v1(module, AssuranceStrictness.Critical)
        expect(report.constant_failures.len()).to_equal(0)
        expect(report.diags.len()).to_equal(1)
        expect(report.diags[0].code).to_equal("E-EVOLVING-002")
        expect(report.diags[0].detail).to_equal("Known = 256")

    it "applies the existing unsigned rule to a folded negative integer":
        val source = "@evolving(repr: u8, unknown: Other)\nenum Wire:\n    Known = 0 - 1\n    Other(raw: u8)\n"
        val module = adapter_lower_v1(source, 1)
        expect(adapter_first_kind_v1(module, "Wire")).to_equal("binary")
        val report = enum_contract_declaration_report_v1(module, AssuranceStrictness.Critical)
        expect(report.constant_failures.len()).to_equal(0)
        expect(report.diags.len()).to_equal(1)
        expect(report.diags[0].code).to_equal("E-EVOLVING-002")
        expect(report.diags[0].detail).to_equal("Known = -1")

    it "retains contract diagnostic severity in the actual consumer":
        val module = adapter_lower_v1("@closed\nenum Code:\n    A = 2 + 3\n    B\n    C = 6\n", 1)
        val moderate = collect_module_enum_contract_receipt_v1("fixture", module, AssuranceStrictness.Moderate)
        expect(moderate.warnings.len()).to_equal(1)
        expect(moderate.errors.len()).to_equal(0)
        expect(moderate.warnings[0]).to_contain("[E-CLOSED-002]")
        val critical = collect_module_enum_contract_receipt_v1("fixture", module, AssuranceStrictness.Critical)
        expect(critical.warnings.len()).to_equal(0)
        expect(critical.errors.len()).to_equal(1)
        expect(critical.errors[0]).to_contain("[E-CLOSED-002]")

    it "routes division and modulo by zero as explicit unavailable failures":
        step("Retain explicit fold failure through the full report and receipt under every profile")
        for expression in ["1 / 0", "1 % 0"]:
            val source = "@closed\nenum Code:\n    A = " + expression + "\n    B = 0\n"
            expect_adapter_constant_failure_v1(source, EnumDiscriminantFailureKindV1.Unavailable,
                "binary", "enum variant 'Code.A' discriminant must be a constant integer expression")

    it "distinguishes available noninteger literals from unavailable expressions":
        for expression in ["true", "1.25", "\"plain\"", "-1.25"]:
            val source = "@closed\nenum Code:\n    A = " + expression + "\n    B = 0\n"
            val hir_kind = match expression:
                case "true": "bool"
                case "1.25": "float-lexeme"
                case "-1.25": "unary"
                case _: "string"
            expect_adapter_constant_failure_v1(source, EnumDiscriminantFailureKindV1.NonInteger,
                hir_kind, "enum variant 'Code.A' discriminant must be an integer constant")

    it "does not accept a resolved module constant through the wider general evaluator":
        val source = "val LIMIT: i64 = 7\n@closed\nenum Code:\n    A = LIMIT\n    B = 0\n"
        expect_adapter_constant_failure_v1(source, EnumDiscriminantFailureKindV1.Unavailable,
            "variable", "enum variant 'Code.A' discriminant must be a constant integer expression")

    it "does not accept a call as a literal constant":
        val source = "fn value() -> i64:\n    7\n@closed\nenum Code:\n    A = value()\n    B = 0\n"
        expect_adapter_constant_failure_v1(source, EnumDiscriminantFailureKindV1.Unavailable,
            "call", "enum variant 'Code.A' discriminant must be a constant integer expression")

    it "validates explicit constants on undecorated enums as MIR already does":
        val source = "enum Code:\n    A = true\n    B = 0\n"
        expect_adapter_constant_failure_v1(source, EnumDiscriminantFailureKindV1.NonInteger,
            "bool", "enum variant 'Code.A' discriminant must be an integer constant")

    it "retains each explicit failure while skipping only its unknown value sequence":
        val module = adapter_lower_v1("@closed\nenum Code:\n    A = 1 / 0\n    B = true\n    C = 0\n", 1)
        val report = enum_contract_declaration_report_v1(module, AssuranceStrictness.Critical)
        expect(report.constant_failures.len()).to_equal(2)
        expect(report.constant_failures[0].variant_name).to_equal("A")
        expect(report.constant_failures[1].variant_name).to_equal("B")
        expect(report.diags.len()).to_equal(0)
        val receipt = collect_module_enum_contract_receipt_v1("fixture", module, AssuranceStrictness.Moderate)
        expect(receipt.errors.len()).to_equal(2)
        expect(receipt.warnings.len()).to_equal(0)

    it "preserves independent condition checks and successful neighboring enums after a failed fold":
        step("Check every enum once without suppressing the reviewed condition packet")
        val source = "@condition\nenum Switch:\n    Only\n\n@closed\nenum Good:\n    A = 2 + 3\n    B\n    C = 6\n\n@closed\nenum Code:\n    A = 1 / 0\n    B = 0\n"
        val module = adapter_lower_v1(source, 3)
        expect(adapter_first_kind_v1(module, "Code")).to_equal("binary")
        expect(adapter_first_kind_v1(module, "Good")).to_equal("binary")
        val report = enum_contract_declaration_report_v1(module, AssuranceStrictness.Critical)
        expect(report.constant_failures.len()).to_equal(1)
        expect(report.diags.len()).to_equal(2)
        var condition_seen = false
        var duplicate_seen = false
        for diagnostic in report.diags:
            if diagnostic.code == "E-CONDITION-001":
                expect(diagnostic.enum_name).to_equal("Switch")
                condition_seen = true
            if diagnostic.code == "E-CLOSED-002":
                expect(diagnostic.enum_name).to_equal("Good")
                expect(diagnostic.detail).to_equal("B / C = 6")
                duplicate_seen = true
        expect(condition_seen).to_equal(true)
        expect(duplicate_seen).to_equal(true)
        val full = enum_contract_check_module(module, AssuranceStrictness.Critical)
        expect(full.constant_failures.len()).to_equal(1)
        expect(full.diags.len()).to_equal(2)
        val receipt = collect_module_enum_contract_receipt_v1("fixture", module, AssuranceStrictness.Critical)
        expect(receipt.errors.len()).to_equal(3)
        expect(receipt.warnings.len()).to_equal(0)

    it "keeps legacy diagnostic-array APIs as diagnostic collectors only":
        val module = adapter_lower_v1("@closed\nenum Code:\n    A = 1 / 0\n    B = 0\n", 1)
        expect(enum_contract_check(module, AssuranceStrictness.Critical).len()).to_equal(0)
        expect(enum_contract_declaration_report_v1(module, AssuranceStrictness.Critical).constant_failures.len()).to_equal(1)
        expect(collect_module_enum_contract_receipt_v1("fixture", module, AssuranceStrictness.Critical).errors.len()).to_equal(1)
