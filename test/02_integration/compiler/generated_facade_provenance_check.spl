use compiler.common.generated_facade_provenance.{generated_facade_export_pairs}

fn main() -> i32:
    val real = generated_facade_export_pairs("# Re-exported from owner.spl\nexport call, Kind, COUNT\n")
    assert(real.len() == 2)
    assert(real[0] == "owner")
    assert(real[1] == "call, Kind, COUNT")
    val alias = generated_facade_export_pairs("# Re-exported from nested/owner.spl\nexport source: local\n")
    assert(alias.len() == 2)
    assert(alias[0] == "nested/owner")
    assert(alias[1] == "source: local")
    assert(generated_facade_export_pairs("# Re-exported from absent.spl\n").len() == 0)
    assert(generated_facade_export_pairs("# Re-exported from absent.spl\nval unrelated = 1\nexport call\n").len() == 0)
    assert(generated_facade_export_pairs("# Re-exported from absent.spl\nexport use explicit.owner.{call}\n").len() == 0)
    assert(generated_facade_export_pairs("# Re-exported from absent.spl\nexport call from explicit.owner\n").len() == 0)
    assert(generated_facade_export_pairs("# Re-exported from absent.spl\nexport member.*\n").len() == 0)
    assert(generated_facade_export_pairs("# Re-exported from absent.spl\nexport call + other\n").len() == 0)
    assert(generated_facade_export_pairs("    # Re-exported from absent.spl\n    export call\n").len() == 0)
    val quotes = "\"" + "\"" + "\""
    val doc = quotes + "\n# Re-exported from absent.spl\nexport call\n" + quotes + "\nexport other\n"
    assert(generated_facade_export_pairs(doc).len() == 0)
    val crossing_doc = "# Re-exported from absent.spl\n" + quotes + "docs" + quotes + "\nexport call\n"
    assert(generated_facade_export_pairs(crossing_doc).len() == 0)
    val comment = generated_facade_export_pairs("# Re-exported from owner.spl\n# unrelated \"\"\" comment\nexport call\n")
    assert(comment.len() == 2)
    assert(comment[0] == "owner")
    val hash_prefix = "val docs = \"#\" + " + quotes + "\n# Re-exported from absent.spl\nexport call\n" + quotes + "\nexport other\n"
    assert(generated_facade_export_pairs(hash_prefix).len() == 0)
    val hash_doc = quotes + "doc # text" + quotes + "\n# Re-exported from owner.spl\nexport call\n"
    val after_hash_doc = generated_facade_export_pairs(hash_doc)
    assert(after_hash_doc.len() == 2)
    assert(after_hash_doc[0] == "owner")
    val embedded_quote = "val quoted = \"\\\"\" # " + quotes + "\n# Re-exported from owner.spl\nexport call\n"
    assert(generated_facade_export_pairs(embedded_quote).len() == 2)
    print "GENERATED_FACADE_PROVENANCE_COMPONENT_PASS"
    0
