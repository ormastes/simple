# codex-system-test
use std.spec.*
use app.io.vhdl_ffi.{ghdl_available, ghdl_analyze, ghdl_elaborate, ghdl_run,
    vhdl_write_file}
use compiler.mir.hwir.types.{CoreConfig, HwPort}
use compiler.mir.hwir.riscv_scalar_runtime_alu.{strict_riscv_scalar_runtime_alu_hwir}
use compiler.backend.backend.hwir_to_vhdl.{render_strict_hwir_vhdl}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan,
    riscv_scalar_decoder_plan, riscv_scalar_semantic_opcode}

fn runtime_alu_row_for(plan: RiscvScalarDecoderPlan, instruction: u32) -> i32:
    var index = 0
    for entry in plan.entries:
        if entry.matches(instruction, plan.xlen): return index + 1
        index = index + 1
    0

fn runtime_alu_signal_type(port: HwPort) -> text:
    if port.bit_width == 1: return "std_logic"
    "std_logic_vector(" + (port.bit_width - 1).to_text() + " downto 0)"

fn runtime_alu_signal_default(port: HwPort) -> text:
    if port.bit_width == 1: return "'0'"
    "(others => '0')"

fn runtime_alu_testbench(entity_name: text, ports: [HwPort], xlen: i32,
    vectors: text) -> text:
    var declarations = ""
    var mappings = ""
    var index = 0
    for port in ports:
        declarations = declarations + "  signal " + port.name + " : " +
            runtime_alu_signal_type(port) + " := " +
            runtime_alu_signal_default(port) + ";\n"
        mappings = mappings + "    " + port.name + " => " + port.name
        if index + 1 < ports.len(): mappings = mappings + ","
        mappings = mappings + "\n"
        index = index + 1
    """
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use std.env.all;
entity {entity_name}_tb is end entity;
architecture sim of {entity_name}_tb is
{declarations}begin
  dut: entity work.{entity_name} port map(
{mappings}  );
  process
    procedure drive(
      constant instruction : std_logic_vector(31 downto 0);
      constant row_id : natural;
      constant semantic_id : natural;
      constant width32 : std_logic;
      constant lhs : std_logic_vector({xlen - 1} downto 0);
      constant rhs : std_logic_vector({xlen - 1} downto 0);
      constant pc_value : std_logic_vector({xlen - 1} downto 0)) is
    begin
      uop_valid <= '1'; decode_legal <= '1';
      decoded_row_index <= std_logic_vector(to_unsigned(row_id, decoded_row_index'length));
      decoded_execution_class <= "001"; decoded_memory_effect <= "000";
      decoded_semantic_opcode <= std_logic_vector(to_unsigned(semantic_id, 6));
      decoded_declared_operand_width_is_32 <= width32;
      canonical_instruction <= instruction; original_instruction <= instruction;
      instruction_length_bytes <= "100";
      instruction_rd_field <= instruction(11 downto 7);
      instruction_rs1_field <= instruction(19 downto 15);
      instruction_rs2_field <= instruction(24 downto 20);
      rs1_value <= lhs; rs2_value <= rhs;
      pc_before <= pc_value;
      fallthrough_pc <= std_logic_vector(unsigned(pc_value) + 4);
      privilege <= "11";
      provider_event_id <= x"0000000000000007";
      decode_event_id <= x"0000000000000007";
      lineage_valid <= '1';
      wait for 1 ns;
    end procedure;
  begin
{vectors}    finish;
  end process;
end architecture;
"""

fn runtime_alu_rv32_vectors(plan: RiscvScalarDecoderPlan) -> text:
    val slli_row = runtime_alu_row_for(plan, 0x01F31293)
    val sll_row = runtime_alu_row_for(plan, 0x007312B3)
    val srl_row = runtime_alu_row_for(plan, 0x007352B3)
    val srai_row = runtime_alu_row_for(plan, 0x41F35293)
    val sra_row = runtime_alu_row_for(plan, 0x407352B3)
    val slli = riscv_scalar_semantic_opcode("shift_left_logical_immediate")
    val sll = riscv_scalar_semantic_opcode("shift_left_logical")
    val srl = riscv_scalar_semantic_opcode("shift_right_logical")
    val srai = riscv_scalar_semantic_opcode("shift_right_arithmetic_immediate")
    val sra = riscv_scalar_semantic_opcode("shift_right_arithmetic")
    """
    drive(x"007302B3", 28, 1, '0', x"FFFFFFFF", x"00000001", x"00000100");
    assert retire_valid = '1' and protocol_fault = '0' and
      retire_rd_value = x"00000000" report "RV32 ADD failed" severity failure;
    drive(x"FFF30293", 19, 1, '0', x"00000001", x"00000000", x"00000100");
    assert retire_valid = '1' and retire_rd_value = x"00000000"
      report "RV32 ADDI sign extension failed" severity failure;
    drive(x"007322B3", 31, 39, '0', x"FFFFFFFF", x"00000001", x"00000100");
    assert retire_valid = '1' and retire_rd_value = x"00000001"
      report "RV32 SLT signed comparison failed" severity failure;
    drive(x"800002B7", 1, 31, '0', x"00000000", x"00000000", x"00000100");
    assert retire_valid = '1' and retire_rd_value = x"80000000"
      report "RV32 LUI failed" severity failure;
    drive(x"00001297", 2, 3, '0', x"00000000", x"00000000", x"00000100");
    assert retire_valid = '1' and retire_rd_value = x"00001100" and
      retire_pc_after = x"00000104" report "RV32 AUIPC failed" severity failure;
    drive(x"00730033", 28, 1, '0', x"00000001", x"00000002", x"00000100");
    assert retire_valid = '1' and retire_rd_write = '0' and
      retire_rd = "00000" and retire_rd_value = x"00000000"
      report "RV32 x0 write suppression failed" severity failure;
    drive(x"007302B3", 29, 1, '0', x"00000001", x"00000002", x"00000100");
    assert retire_valid = '0' and protocol_fault = '1'
      report "RV32 row mismatch did not fail closed" severity failure;
    drive(x"007302B3", 28, 2, '0', x"00000001", x"00000002", x"00000100");
    assert retire_valid = '0' and protocol_fault = '1'
      report "RV32 semantic mismatch did not fail closed" severity failure;
    drive(x"01F31293", {slli_row}, {slli}, '0', x"00000001", x"00000000", x"00000100");
    assert retire_valid = '1' and protocol_fault = '0' and
      retire_rd_value = x"80000000" report "RV32 SLLI immediate count failed" severity failure;
    drive(x"007312B3", {sll_row}, {sll}, '0', x"00000001", x"00000003", x"00000100");
    assert retire_valid = '1' and retire_rd_value = x"00000008"
      report "RV32 SLL did not use the rs2 value count" severity failure;
    drive(x"007352B3", {srl_row}, {srl}, '0', x"80000000", x"00000004", x"00000100");
    assert retire_valid = '1' and retire_rd_value = x"08000000"
      report "RV32 SRL logical fill or rs2 count failed" severity failure;
    drive(x"41F35293", {srai_row}, {srai}, '0', x"80000000", x"00000000", x"00000100");
    assert retire_valid = '1' and retire_rd_value = x"FFFFFFFF"
      report "RV32 SRAI arithmetic fill failed" severity failure;
    drive(x"407352B3", {sra_row}, {sra}, '0', x"80000000", x"00000004", x"00000100");
    assert retire_valid = '1' and retire_rd_value = x"F8000000"
      report "RV32 SRA did not use the rs2 value count" severity failure;
"""

fn runtime_alu_rv64_vectors(plan: RiscvScalarDecoderPlan) -> text:
    val slli_row = runtime_alu_row_for(plan, 0x03F31293)
    val srli_row = runtime_alu_row_for(plan, 0x03F35293)
    val srai_row = runtime_alu_row_for(plan, 0x43F35293)
    val sllw_row = runtime_alu_row_for(plan, 0x007312BB)
    val srlw_row = runtime_alu_row_for(plan, 0x007352BB)
    val sraw_row = runtime_alu_row_for(plan, 0x407352BB)
    val slli = riscv_scalar_semantic_opcode("shift_left_logical_immediate")
    val srli = riscv_scalar_semantic_opcode("shift_right_logical_immediate")
    val srai = riscv_scalar_semantic_opcode("shift_right_arithmetic_immediate")
    val sllw = riscv_scalar_semantic_opcode("shift_left_logical")
    val srlw = riscv_scalar_semantic_opcode("shift_right_logical")
    val sraw = riscv_scalar_semantic_opcode("shift_right_arithmetic")
    """
    drive(x"0013029B", 44, 1, '1', x"000000007FFFFFFF",
      x"0000000000000000", x"0000000000000100");
    assert retire_valid = '1' and protocol_fault = '0' and
      retire_rd_value = x"FFFFFFFF80000000"
      report "RV64 ADDIW sign extension failed" severity failure;
    drive(x"007302BB", 48, 1, '1', x"000000007FFFFFFF",
      x"0000000000000001", x"0000000000000100");
    assert retire_valid = '1' and retire_rd_value = x"FFFFFFFF80000000"
      report "RV64 ADDW sign extension failed" severity failure;
    drive(x"407302BB", 49, 51, '1', x"0000000000000000",
      x"0000000000000001", x"0000000000000100");
    assert retire_valid = '1' and retire_rd_value = x"FFFFFFFFFFFFFFFF"
      report "RV64 SUBW sign extension failed" severity failure;
    drive(x"007302BB", 49, 1, '1', x"0000000000000001",
      x"0000000000000002", x"0000000000000100");
    assert retire_valid = '0' and protocol_fault = '1'
      report "RV64 row mismatch did not fail closed" severity failure;
    drive(x"03F31293", {slli_row}, {slli}, '0', x"0000000000000001",
      x"0000000000000000", x"0000000000000100");
    assert retire_valid = '1' and protocol_fault = '0' and
      retire_rd_value = x"8000000000000000" report "RV64 SLLI six-bit count failed" severity failure;
    drive(x"03F35293", {srli_row}, {srli}, '0', x"8000000000000000",
      x"0000000000000000", x"0000000000000100");
    assert retire_valid = '1' and retire_rd_value = x"0000000000000001"
      report "RV64 SRLI six-bit logical fill failed" severity failure;
    drive(x"43F35293", {srai_row}, {srai}, '0', x"8000000000000000",
      x"0000000000000000", x"0000000000000100");
    assert retire_valid = '1' and retire_rd_value = x"FFFFFFFFFFFFFFFF"
      report "RV64 SRAI six-bit arithmetic fill failed" severity failure;
    drive(x"007312BB", {sllw_row}, {sllw}, '1', x"0000000000000001",
      x"000000000000001F", x"0000000000000100");
    assert retire_valid = '1' and retire_rd_value = x"FFFFFFFF80000000"
      report "RV64 SLLW rs2 count or sign extension failed" severity failure;
    drive(x"007352BB", {srlw_row}, {srlw}, '1', x"0000000080000000",
      x"000000000000001F", x"0000000000000100");
    assert retire_valid = '1' and retire_rd_value = x"0000000000000001"
      report "RV64 SRLW logical fill failed" severity failure;
    drive(x"407352BB", {sraw_row}, {sraw}, '1', x"0000000080000000",
      x"000000000000001F", x"0000000000000100");
    assert retire_valid = '1' and retire_rd_value = x"FFFFFFFFFFFFFFFF"
      report "RV64 SRAW arithmetic fill or sign extension failed" severity failure;
"""

describe "runtime scalar ALU VHDL behavior":
    slow_it "simulates admitted arithmetic and shift rows for uncompressed RV32 and RV64":
        if not ghdl_available():
            print "SKIP: GHDL not available"
            return
        val rv32_plan = riscv_scalar_decoder_plan("rv32i").unwrap()
        val rv64_plan = riscv_scalar_decoder_plan("rv64i").unwrap()
        val products = [("scalar_runtime_alu_ghdl_rv32", CoreConfig.rv32(), rv32_plan,
                runtime_alu_rv32_vectors(rv32_plan)),
            ("scalar_runtime_alu_ghdl_rv64", CoreConfig.rv64(), rv64_plan,
                runtime_alu_rv64_vectors(rv64_plan))]
        for product in products:
            val module = strict_riscv_scalar_runtime_alu_hwir(
                product[0], product[1], product[2]).unwrap()
            val emitted = render_strict_hwir_vhdl(module)
            expect(emitted.is_success()).to_equal(true)
            if emitted.is_success():
                val path = "/tmp/" + product[0] + ".vhd"
                val testbench = runtime_alu_testbench(
                    product[0], module.ports, product[1].xlen, product[3])
                expect(vhdl_write_file(path, emitted.vhdl + "\n" + testbench)).to_equal(true)
                expect(ghdl_analyze(path).success).to_equal(true)
                expect(ghdl_elaborate(product[0] + "_tb").success).to_equal(true)
                expect(ghdl_run(product[0] + "_tb", Some("50ns")).success).to_equal(true)
