# codex-system-test
#
# Clocked black-box evidence for the flattened v6 scalar pipeline.  Unlike
# the provider-only test, this proves that class-4 input is admitted through
# the tag-2 pending owner and cannot bypass the public completion handshake.
use std.spec.*
use app.io.vhdl_ffi.{ghdl_available, ghdl_unique_workdir, ghdl_analyze_in,
    ghdl_elaborate_in, ghdl_run_in, vhdl_write_file}
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.backend.backend.riscv_scalar_runtime_pipeline_v6_flat_to_vhdl.{
    compile_strict_riscv_scalar_runtime_pipeline_v6_flat}

fn runtime_v6_rv32_zmmul() -> CoreConfig:
    CoreConfig(xlen: 32, physical_address_bits: 32, register_count: 32,
        profile: "riscv-gen2-rv32-zmmul", isa_profile: "rv32i_zmmul",
        compressed_decode_profile: "none")

fn runtime_v6_rv64_zmmul() -> CoreConfig:
    CoreConfig(xlen: 64, physical_address_bits: 56, register_count: 32,
        profile: "riscv-gen2-rv64-zmmul", isa_profile: "rv64i_zmmul",
        compressed_decode_profile: "none")

fn runtime_pipeline_v6_flat_clocked_tb(entity_name: text, xlen: i32,
    mulh_lhs: text, mulh_expected: text, mulhu_expected: text, mulw_case: text) -> text:
    """
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use std.env.all;
entity {entity_name}_tb is end entity;
architecture sim of {entity_name}_tb is
  signal clk, rst, in_valid, completion_ready : std_logic := '0';
  signal instruction : std_logic_vector(31 downto 0) := (others => '0');
  signal instruction_length_bytes : std_logic_vector(2 downto 0) := "100";
  signal rs1_value, rs2_value, pc_before, fallthrough_pc : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal privilege : std_logic_vector(1 downto 0) := "11";
  signal provider_event_id, decode_event_id : std_logic_vector(63 downto 0) := (others => '0');
  signal bus_request_ready, bus_response_valid, bus_response_fault, fence_effect_ready : std_logic := '0';
  signal bus_response_id : std_logic_vector(63 downto 0) := (others => '0');
  signal bus_response_data, bus_response_cause, bus_response_tval : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal in_ready, completion_valid, completion_rd_write, runtime_protocol_fault : std_logic;
  signal completion_rd : std_logic_vector(4 downto 0);
  signal completion_rd_value : std_logic_vector({xlen - 1} downto 0);
  signal completion_original_instruction, completion_canonical_instruction : std_logic_vector(31 downto 0);
  signal completion_instruction_length_bytes : std_logic_vector(2 downto 0);
  signal completion_pc_before, completion_pc_after : std_logic_vector({xlen - 1} downto 0);
  signal completion_provider_event_id, completion_decode_event_id : std_logic_vector(63 downto 0);
  signal completion_illegal_valid : std_logic;
  signal bus_request_valid, bus_request_write, bus_response_ready, fence_effect_valid : std_logic;
  signal bus_request_id : std_logic_vector(63 downto 0);
  signal bus_request_address : std_logic_vector({xlen - 1} downto 0);
  signal bus_request_byte_mask : std_logic_vector({xlen / 8 - 1} downto 0);
  signal bus_request_write_data : std_logic_vector({xlen - 1} downto 0);
  signal fence_effect_kind : std_logic_vector(1 downto 0);
  signal fence_effect_fm, fence_effect_pred, fence_effect_succ : std_logic_vector(3 downto 0);
begin
  dut: entity work.{entity_name} port map(
    clk=>clk, rst=>rst, in_valid=>in_valid, instruction=>instruction,
    instruction_length_bytes=>instruction_length_bytes, rs1_value=>rs1_value,
    rs2_value=>rs2_value, pc_before=>pc_before, fallthrough_pc=>fallthrough_pc,
    privilege=>privilege, provider_event_id=>provider_event_id, decode_event_id=>decode_event_id,
    completion_ready=>completion_ready, bus_request_ready=>bus_request_ready,
    bus_response_valid=>bus_response_valid, bus_response_id=>bus_response_id,
    bus_response_data=>bus_response_data, bus_response_fault=>bus_response_fault,
    bus_response_cause=>bus_response_cause, bus_response_tval=>bus_response_tval,
    fence_effect_ready=>fence_effect_ready, in_ready=>in_ready,
    completion_valid=>completion_valid, completion_rd=>completion_rd,
    completion_rd_write=>completion_rd_write, completion_rd_value=>completion_rd_value,
    runtime_protocol_fault=>runtime_protocol_fault, bus_request_valid=>bus_request_valid,
    bus_request_id=>bus_request_id, bus_request_address=>bus_request_address,
    bus_request_write=>bus_request_write, bus_request_byte_mask=>bus_request_byte_mask,
    bus_request_write_data=>bus_request_write_data, bus_response_ready=>bus_response_ready,
    fence_effect_valid=>fence_effect_valid, fence_effect_kind=>fence_effect_kind,
    fence_effect_fm=>fence_effect_fm, fence_effect_pred=>fence_effect_pred, fence_effect_succ=>fence_effect_succ,
    completion_privilege=>open, completion_original_instruction=>completion_original_instruction,
    completion_canonical_instruction=>completion_canonical_instruction, completion_instruction_length_bytes=>completion_instruction_length_bytes,
    completion_pc_before=>completion_pc_before, completion_pc_after=>completion_pc_after, completion_memory_address=>open,
    completion_memory_read_mask=>open, completion_memory_write_mask=>open,
    completion_memory_read_data=>open, completion_memory_write_data=>open,
    completion_execute_trap_valid=>open, completion_execute_trap_cause=>open,
    completion_execute_trap_tval=>open, completion_memory_trap_valid=>open,
    completion_memory_trap_cause=>open, completion_memory_trap_tval=>open,
    completion_redirect_valid=>open, completion_redirect_target=>open,
    completion_provider_event_id=>completion_provider_event_id, completion_decode_event_id=>completion_decode_event_id,
    completion_illegal_valid=>completion_illegal_valid);
  process
    procedure tick is begin wait for 1 ns; clk<='1'; wait for 1 ns; clk<='0'; wait for 1 ns; end procedure;
    procedure drive(constant insn : std_logic_vector(31 downto 0);
      constant lhs, rhs : std_logic_vector({xlen - 1} downto 0); constant id : natural) is begin
      in_valid<='1'; instruction<=insn; rs1_value<=lhs; rs2_value<=rhs;
      pc_before<=std_logic_vector(to_unsigned(256, {xlen}));
      fallthrough_pc<=std_logic_vector(to_unsigned(260, {xlen}));
      provider_event_id<=std_logic_vector(to_unsigned(id,64)); decode_event_id<=std_logic_vector(to_unsigned(id,64));
    end procedure;
    procedure await_completion(constant label_text : string) is begin
      for n in 1 to {xlen + 12} loop if completion_valid='1' then return; end if; tick; end loop;
      assert false report label_text severity failure;
    end procedure;
  begin
    rst<='1'; tick; rst<='0'; wait for 1 ns;
    assert in_ready='1' and completion_valid='0' and runtime_protocol_fault='0'
      report "v6 reset state is invalid" severity failure;

    -- MUL x5,x6,x7: class 4 must reserve pending tag 2 then hold its result.
    assert in_ready='1' report "MUL was driven without an accepted input slot" severity failure;
    drive(x"027302B3", std_logic_vector(to_unsigned(17,{xlen})), std_logic_vector(to_unsigned(34,{xlen})), 1);
    tick; in_valid<='0'; tick;
    assert in_ready='0' and completion_valid='0'
      report "MUL did not enter the pending-owned iterative latency window" severity failure;
    tick; assert in_ready='0' and completion_valid='0'
      report "MUL bypassed the tag-2 pending provider with an early completion" severity failure;
    await_completion("MUL did not retire through tag-2 pending ownership");
    assert completion_rd="00101" and completion_rd_write='1' and completion_rd_value=std_logic_vector(to_unsigned(578,{xlen}))
      report "MUL completion payload mismatch" severity failure;
    assert completion_original_instruction=x"027302B3" and completion_canonical_instruction=x"027302B3" and
      completion_instruction_length_bytes="100" and completion_pc_before=std_logic_vector(to_unsigned(256,{xlen})) and
      completion_pc_after=std_logic_vector(to_unsigned(260,{xlen})) and completion_provider_event_id=std_logic_vector(to_unsigned(1,64)) and
      completion_decode_event_id=std_logic_vector(to_unsigned(1,64)) and completion_illegal_valid='0'
      report "MUL completion lost public provenance or lineage" severity failure;
    tick; assert completion_valid='1' and completion_rd_value=std_logic_vector(to_unsigned(578,{xlen}))
      report "MUL completion was not held under backpressure" severity failure;
    completion_ready<='1'; tick; completion_ready<='0'; assert completion_valid='0'
      report "MUL completion was not consumed once" severity failure;

    -- MULH x5,x6,x7: signed high-half result of 0x80000000 * 2 is -1 on RV32.
    assert in_ready='1' report "MULH was driven without an accepted input slot" severity failure;
    drive(x"027312B3", x"{mulh_lhs}", std_logic_vector(to_unsigned(2,{xlen})), 2);
    tick; in_valid<='0'; await_completion("MULH did not retire through tag-2 pending ownership");
    assert completion_rd="00101" and completion_rd_write='1' and completion_rd_value=x"{mulh_expected}"
      report "MULH signed high-half payload mismatch" severity failure;
    completion_ready<='1'; tick; completion_ready<='0'; assert completion_valid='0'
      report "MULH completion was not consumed once" severity failure;

    -- MULHSU x5,x6,x7: signed lhs high-half times unsigned rhs remains -1.
    assert in_ready='1' report "MULHSU was driven without an accepted input slot" severity failure;
    drive(x"027322B3", x"{mulh_lhs}", std_logic_vector(to_unsigned(2,{xlen})), 3);
    tick; in_valid<='0'; await_completion("MULHSU did not retire through tag-2 pending ownership");
    assert completion_rd="00101" and completion_rd_write='1' and completion_rd_value=x"{mulh_expected}"
      report "MULHSU signed-times-unsigned high-half payload mismatch" severity failure;
    tick; assert completion_valid='1' and completion_rd_value=x"{mulh_expected}"
      report "MULHSU completion was not held under backpressure" severity failure;
    completion_ready<='1'; tick; completion_ready<='0'; assert completion_valid='0'
      report "MULHSU completion was not consumed once" severity failure;

    -- MULHU x5,x6,x7: unsigned 2^(XLEN-1) times two has high half one.
    assert in_ready='1' report "MULHU was driven without an accepted input slot" severity failure;
    drive(x"027332B3", x"{mulh_lhs}", std_logic_vector(to_unsigned(2,{xlen})), 4);
    tick; in_valid<='0'; await_completion("MULHU did not retire through tag-2 pending ownership");
    assert completion_rd="00101" and completion_rd_write='1' and completion_rd_value=x"{mulhu_expected}"
      report "MULHU unsigned high-half payload mismatch" severity failure;
    completion_ready<='1'; tick; completion_ready<='0'; assert completion_valid='0'
      report "MULHU completion was not consumed once" severity failure;

    {mulw_case}

    -- Malformed public response traffic must still fail-stop the composed top.
    assert bus_response_ready='0' report "orphan response was injected while an LSU request was owned" severity failure;
    bus_response_id<=x"0000000000000042"; bus_response_valid<='1'; tick; bus_response_valid<='0';
    assert runtime_protocol_fault='1' and in_ready='0' and completion_valid='0'
      report "v6 fault gate did not suppress malformed external traffic" severity failure;
    rst<='1'; tick; rst<='0'; wait for 1 ns;
    assert runtime_protocol_fault='0' and in_ready='1' and completion_valid='0'
      report "reset did not recover v6 after malformed traffic" severity failure;
    finish;
  end process;
end architecture;
"""

fn simulate_runtime_pipeline_v6_flat_clocked(entity_name: text, config: CoreConfig, bus: LsuConfig) -> bool:
    val emitted = compile_strict_riscv_scalar_runtime_pipeline_v6_flat(entity_name, config, bus)
    if not emitted.is_success(): return false
    val workdir = ghdl_unique_workdir(entity_name); if workdir.is_err(): return false
    val isolated = workdir.ok().unwrap()
    val path = isolated + "/" + entity_name + ".vhd"
    val rv64_mulw = if config.xlen == 64:
        """
    -- MULW x5,x6,x7: only the low 32-bit product participates, then sign-extends.
    assert in_ready='1' report "MULW was driven without an accepted input slot" severity failure;
    drive(x"027302BB", x"00000000FFFFFFFF", x"0000000000000002", 5);
    tick; in_valid<='0'; await_completion("MULW did not retire through tag-2 pending ownership");
    assert completion_rd="00101" and completion_rd_write='1' and completion_rd_value=x"FFFFFFFFFFFFFFFE"
      report "MULW sign-extended payload mismatch" severity failure;
    tick; assert completion_valid='1' and completion_rd_value=x"FFFFFFFFFFFFFFFE"
      report "MULW completion was not held under backpressure" severity failure;
    completion_ready<='1'; tick; completion_ready<='0'; assert completion_valid='0'
      report "MULW completion was not consumed once" severity failure;
"""
    else: ""
    val mulh_lhs = if config.xlen == 64: "8000000000000000" else: "80000000"
    val mulh_expected = if config.xlen == 64: "FFFFFFFFFFFFFFFF" else: "FFFFFFFF"
    val mulhu_expected = if config.xlen == 64: "0000000000000001" else: "00000001"
    if not vhdl_write_file(path, emitted.vhdl + "\n" + runtime_pipeline_v6_flat_clocked_tb(
        entity_name, config.xlen, mulh_lhs, mulh_expected, mulhu_expected, rv64_mulw)): return false
    if not ghdl_analyze_in(path, isolated).success: return false
    if not ghdl_elaborate_in(entity_name + "_tb", isolated).success: return false
    ghdl_run_in(entity_name + "_tb", Some("4us"), isolated).success

describe "runtime scalar pipeline v6 flat clocked GHDL integration":
    slow_it "proves RV32 tag-2 MUL and high-half M admission, hold/consume, malformed traffic and reset":
        val available = ghdl_available(); expect(available).to_equal(true)
        if not available: return
        expect(simulate_runtime_pipeline_v6_flat_clocked("runtime_pipeline_v6_flat_clocked_rv32",
            runtime_v6_rv32_zmmul(), LsuConfig.rv32_product_default())).to_equal(true)

    slow_it "proves RV64 high-half M and MULW low-word sign extension through the same tag-2 lane":
        val available = ghdl_available(); expect(available).to_equal(true)
        if not available: return
        expect(simulate_runtime_pipeline_v6_flat_clocked("runtime_pipeline_v6_flat_clocked_rv64",
            runtime_v6_rv64_zmmul(), LsuConfig.rv64_product_default())).to_equal(true)
