use compiler.common.driver_compile_options.{driver_core_compile_options_default}
use compiler.driver.driver_types.{CompileContext}

struct Stage3AggregateWalk:
    node_key: text
    path: text

fn exact_compile_context_receiver() -> bool:
    var ctx: CompileContext = CompileContext.create(driver_core_compile_options_default())
    val before: i64 = ctx.error_count()
    ctx.add_error("first")
    ctx.add_error("second")
    val after: i64 = ctx.error_count()
    before == 0 and after == 2 and ctx.error_count_value == 2

fn adjacent_aggregate_push_and_access() -> bool:
    var pending: [Stage3AggregateWalk] = []
    pending.push(Stage3AggregateWalk(node_key: "root", path: ""))
    pending.push(Stage3AggregateWalk(node_key: "child", path: "root.edge"))
    val selected: Stage3AggregateWalk = pending[1]
    pending.len() == 2 and selected.node_key == "child" and selected.path == "root.edge"

fn main() -> i32:
    val exact_ok = exact_compile_context_receiver()
    val adjacent_ok = adjacent_aggregate_push_and_access()
    print "stage3_aggregate_receiver_exact={exact_ok}"
    print "stage3_aggregate_receiver_adjacent={adjacent_ok}"
    if exact_ok and adjacent_ok:
        return 0
    1
