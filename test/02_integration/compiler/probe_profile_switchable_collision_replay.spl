use std.nogc_sync_mut.src.collections.adaptive_text_set.{AdaptiveSetAlgorithm, AdaptiveTextSet}
use std.nogc_sync_mut.src.collections.adaptive_text_map.AdaptiveTextMap
use std.nogc_sync_mut.src.collections.adaptive_set.AdaptiveSet
use std.nogc_sync_mut.src.collections.adaptive_map.AdaptiveMap

fn main():
    @collection_algorithm("auto")
    var text_set: AdaptiveTextSet = AdaptiveTextSet.new()
    @collection_algorithm("auto")
    var text_map: AdaptiveTextMap = AdaptiveTextMap.new()
    @collection_algorithm("auto")
    var integer_set: AdaptiveSet<i64> = AdaptiveSet.new()
    @collection_algorithm("auto")
    var integer_map: AdaptiveMap<i64, text> = AdaptiveMap.new()
    @collection_algorithm("linear")
    var forced: AdaptiveTextSet = AdaptiveTextSet.new()

    val initial_ordered = text_set.selected_algorithm() == AdaptiveSetAlgorithm.Ordered and
        text_map.selected_algorithm() == AdaptiveSetAlgorithm.Ordered and
        integer_set.selected_algorithm() == AdaptiveSetAlgorithm.Ordered and
        integer_map.selected_algorithm() == AdaptiveSetAlgorithm.Ordered
    val forced_linear = forced.selected_algorithm() == AdaptiveSetAlgorithm.Linear
    text_set.insert("alpha")
    text_map.put("alpha", "value")
    integer_set.insert(7)
    integer_map.put(7, "seven")
    forced.insert("alpha")
    val values_preserved = text_set.contains("alpha") and
        (text_map.get("alpha") ?? "") == "value" and
        integer_set.contains(7) and (integer_map.get(7) ?? "") == "seven" and
        forced.contains("alpha")
    text_set.clear()
    text_map.clear()
    integer_set.clear()
    integer_map.clear()
    val ordered_after_clear = text_set.selected_algorithm() == AdaptiveSetAlgorithm.Ordered and
        text_map.selected_algorithm() == AdaptiveSetAlgorithm.Ordered and
        integer_set.selected_algorithm() == AdaptiveSetAlgorithm.Ordered and
        integer_map.selected_algorithm() == AdaptiveSetAlgorithm.Ordered
    print "COLLISION_REPLAY_INITIAL_ORDERED:{initial_ordered}"
    print "COLLISION_REPLAY_FORCED_LINEAR:{forced_linear}"
    print "COLLISION_REPLAY_VALUES_PRESERVED:{values_preserved}"
    print "COLLISION_REPLAY_CLEAR_ORDERED:{ordered_after_clear}"
    if initial_ordered and forced_linear and values_preserved and ordered_after_clear:
        print "COLLISION_REPLAY: PASS"
    else:
        print "COLLISION_REPLAY: FAIL"
