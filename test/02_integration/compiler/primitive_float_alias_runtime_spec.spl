use std.spec.{describe, it, expect}
use app.io.process_ops.{shell}

extern fn rt_getpid() -> i64

fn run_fixture(path: text):
    shell("env -u SIMPLE_BOOTSTRAP -u SIMPLE_RUNTIME_PATH SIMPLE_LIB=src bin/simple run {path}")

describe "primitive float alias runtime contract":
    it "executes numeric float aliases without routing through text parsing":
        val result = run_fixture("test/fixtures/compiler/primitive_float_alias/numeric_main.spl")
        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_contain("float_alias_positive=true")
        expect(result.stdout).to_contain("float_alias_negative=true")
        expect(result.stdout).to_contain("float_alias_zero=true")
        expect(result.stdout).to_contain("float_alias_fraction=true")

    it "rejects text passed to the numeric float alias":
        val output = "/tmp/primitive_float_alias_text_rejected_{rt_getpid()}"
        val result = shell("env -u SIMPLE_BOOTSTRAP -u SIMPLE_RUNTIME_PATH SIMPLE_LIB=src bin/simple native-build --source src/lib --entry-closure --entry test/fixtures/compiler/primitive_float_alias/text_rejected.spl --output {output}")
        expect(result.exit_code != 0).to_equal(true)
        shell("rm -f {output} {output}.simple_launch.sdn")

    it "keeps fallible text conversion on the explicit parse_f64 Option API":
        val result = run_fixture("test/fixtures/compiler/primitive_float_alias/text_parse_option_main.spl")
        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_contain("float_alias_text_parse_option_good=true")
        expect(result.stdout).to_contain("float_alias_text_parse_option_bad=true")
