# Native integration entry for the pure-Simple native-build command without
# the full CLI's optional Office/UI imports.
use app.io.cli_compile.{cli_native_build}
use app.compiler_entrypoint.inventory_events.{compiler_inventory_refresh_v1}
use app.io.file_ops.{path_absolute}
use app.io.env_ops.{env_get}
use std.io_runtime.{get_args}

fn main() -> i64:
    val args = get_args()
    if args.len() <= 1:
        return 1
    if (env_get("SIMPLE_SCV_SNAPSHOT_ROOT") ?? "") == "":
        val root = path_absolute(".").replace("\\", "/")
        val refresh = compiler_inventory_refresh_v1(
            root, root + "/build/scv", ["src"], true)
        if not refresh.valid:
            print "SCV-E-ADMISSION: {refresh.reason}"
            return 1
    cli_native_build(args[1:args.len()])
