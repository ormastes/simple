use .facade.{facet_call, FacetKind, FACET_COUNT, chosen_owner}
use .second.{second_call}

fn main() -> i32:
    assert(facet_call(5) == 12)
    val kind: FacetKind = FacetKind.Ready
    assert(kind == FacetKind.Ready)
    assert(FACET_COUNT == 37)
    # A real named import must override competing generated provenance.
    assert(chosen_owner() == 22)
    # Both facades use `.owner`; the closure key must retain source scope.
    assert(second_call() == 73)
    print "GENERATED_FACADE_CLOSURE_COMPONENT_PASS"
    0
