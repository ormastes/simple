# Compiler regression fixture: these wrappers call the real text methods.
# Do not replace them with Caret json_find/json_parse_int workarounds.
pub fn caret_owner_find(source: text, needle: text) -> i64:
    source.index_of(needle)

pub fn caret_owner_find_coalesced(source: text, needle: text) -> i64:
    source.index_of(needle) ?? -99

pub fn caret_owner_to_int(source: text) -> i64:
    source.to_int()

pub fn caret_owner_parse_int(source: text) -> i64:
    source.parse_int() ?? -99
