# Current-driver positive/negative probe compiled only by the tracked Wave-0
# bridge. The runner controls the three bootstrap flags and phase profiling.

use compiler.driver.bootstrap_api.{bootstrap_low_memory_requested}
use compiler.driver.driver.{compiler_driver_create, compiler_driver_run_compile}
use compiler.common.driver_core_types.{
    CompileMode,
    compile_result_errors,
    compile_result_is_success,
    driver_core_compile_options_default
}
use std.nogc_sync_mut.io.file_ops.{file_read}

extern fn rt_string_free(value: text) -> i64

fn main() -> i32:
    val fixture = "test/02_integration/compiler/phase2_low_memory_source_reclaim_fixture.spl"
    val capsule_value = file_read(fixture)
    val capsule_alias = capsule_value
    val first_free = rt_string_free(capsule_value)
    val alias_refusal = rt_string_free(capsule_alias)
    val enabled = bootstrap_low_memory_requested()

    var options = driver_core_compile_options_default()
    options.input_files = [fixture]
    options.bootstrap_input_count = 1
    options.bootstrap_input_0 = fixture
    options.mode = CompileMode.Check
    options.backend = "cranelift"
    options.low_memory = enabled
    val result = compiler_driver_run_compile(compiler_driver_create(options))
    val compile_ok = compile_result_is_success(result)
    val errors = compile_result_errors(result)

    print "bootstrap_low_memory_probe_enabled={enabled}"
    print "bootstrap_low_memory_probe_compile_ok={compile_ok}"
    print "bootstrap_low_memory_probe_error_count={errors.len()}"
    print "bootstrap_low_memory_probe_capsule_first_free={first_free}"
    print "bootstrap_low_memory_probe_capsule_alias_refusal={alias_refusal}"
    if compile_ok and errors.len() == 0 and first_free == 1 and alias_refusal == 0:
        return 0
    1
