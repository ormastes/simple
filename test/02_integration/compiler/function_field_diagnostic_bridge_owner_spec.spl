# Fence the exact undeclared-private-helper dependency from attempt4 linking.
# This is a supplemental source-ownership fence, not runtime correctness proof.
# Compile/link/run function_field_receipt_lowering_native with profiling enabled.
use std.spec.*
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "function field diagnostic bridge owner":
    it "owns its runtime discriminant bridge instead of borrowing a private sibling helper":
        val source = file_read("src/compiler/50.mir/_MirLoweringExpr/function_field_call.spl")
        expect(source.contains("extern fn rt_enum_discriminant<T>(value: T) -> i64")).to_equal(true)
        expect(source.contains("fn _function_field_hir_enum_discriminant(value: HirTypeKind) -> i64:")).to_equal(true)
        expect(source.contains("fn _function_field_mir_enum_discriminant(value: MirTypeKind) -> i64:")).to_equal(true)
        expect(source.contains("rt_enum_discriminant<HirTypeKind>(value)")).to_equal(true)
        expect(source.contains("rt_enum_discriminant<MirTypeKind>(value)")).to_equal(true)
        expect(source.contains("_function_field_enum_discriminant<T>")).to_equal(false)
        expect(source.contains("_sffi_enum_discriminant(")).to_equal(false)
