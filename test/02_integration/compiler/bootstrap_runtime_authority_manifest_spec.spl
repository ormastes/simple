"""# Bootstrap runtime-authority symbol manifest

This Integration contract checks the current runtime archive gate that supplies
the future Stage-4 manifest. It proves a concrete required-symbol roster and a
fail-closed absence path; it does not claim a Stage-4 artifact exists.
"""

use std.io.{file_read}
use std.spec.{describe, it, expect, step}

val RUNTIME_GATE = "scripts/check/check-simple-core-runtime-smoke.shs"
val BOOTSTRAP = "scripts/bootstrap/bootstrap-from-scratch.sh"

describe "Bootstrap runtime-authority completeness":
    it "should enumerate the exact required runtime symbol families":
        # @req: REQ-BSPLIT-008
        step("Inspect the runtime archive required-symbol roster")
        val gate = file_read(RUNTIME_GATE)
        expect(gate).to_contain("for required_symbol in")
        expect(gate).to_contain("rt_string_replace rt_to_string rt_array_new rt_array_extend_i64 rt_math_sqrt stdin_read_char")
        expect(gate).to_contain("rt_atomic_int_new rt_atomic_int_load rt_atomic_int_compare_exchange")
        expect(gate).to_contain("rt_process_spawn_async rt_process_spawn_guarded rt_process_wait rt_process_is_running rt_process_kill")
        expect(gate).to_contain("spl_thread_cpu_count text_dot_from_char_code rt_char_from_code rt_u32s_from_raw")

    it "should fail closed when any required runtime symbol is absent":
        # @req: REQ-BSPLIT-009
        step("Inspect required-symbol absence handling")
        val gate = file_read(RUNTIME_GATE)
        expect(gate).to_contain("if ! archive_has_symbol \"$required_symbol\"")
        expect(gate).to_contain("error=missing_required_symbol:$required_symbol")
        expect(gate).to_contain("simple_core_archive_complete=false")
        expect(gate).to_contain("exit 1")

    it "should prohibit stub fallback throughout staged native linking":
        # @req: REQ-BSPLIT-010
        step("Inspect strict staged-link environment")
        val bootstrap = file_read(BOOTSTRAP)
        expect(bootstrap).to_contain("SIMPLE_NO_STUB_FALLBACK=1")
        expect(bootstrap).to_contain("Stage 3 was built by the Rust seed")
        expect(bootstrap).to_contain("frozen runtime authority changed during Stage 3")

