use compiler.common.driver_core_types.{SourceFile}
use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.hir.hir_lowering.module_surface.{
    ModuleSurface,
    ModuleSurfaceBuilder,
    module_surface_canonical_path
}

extern fn rt_hash_text(content: text) -> i64

val PHYSICAL_COUNT: i64 = 200
val ALIAS_COUNT: i64 = 200

fn fail(reason: text) -> i32:
    print("streaming_surface_builder_single_frame_stress=FAIL reason=" + reason)
    1

fn line_position(source: text, needle: text) -> i64:
    val lines = source.split("\n")
    var index: i64 = 0
    while index < lines.len():
        if lines[index].contains(needle):
            return index
        index = index + 1
    -1

fn production_is_single_frame() -> bool:
    val driver = file_read(
        "src/compiler/80.driver/driver_source_pipeline_parsing.spl")
    val surface_source = file_read(
        "src/compiler/20.hir/hir_lowering/module_surface.spl")
    val stream = driver.split(
        "    me parse_all_streaming_surfaces_impl() -> bool:")
    if stream.len() < 2:
        return false
    val stream_end = stream[1].split(
        "    me parse_all_impl() -> (CompileContext, bool):")
    if stream_end.len() < 2:
        return false
    val body = stream_end[0]
    val loop_pos = line_position(body, "while source_index < self.ctx.sources.len()")
    val begin_pos = line_position(body, "if not rt_transient_array_scope_begin()")
    val parse_pos = line_position(body, "val module = parse_full_frontend(")
    val owner_pos = line_position(body, "var module_owner = ModuleSurfaceParserOwner(")
    val surface_pos = line_position(body, "val surface_result = module_owner.surface(")
    val pause_pos = line_position(body, "if not rt_transient_array_scope_pause()")
    val promote_pos = line_position(body, "if not module_surface_promote(surface)")
    val commit_pos = line_position(body, "val add_result = builder.add_surface_canonical(")
    val commit_receipt_pos = line_position(
        body, "log_module_surface_stage(source.path, \"commit-done\")")
    val release_pos = line_position(body, "release_seq = release_seq + 1")
    val commit_tail = body.split(
        "log_module_surface_stage(source.path, \"commit-done\")")
    var final_cleanup = false
    if commit_tail.len() > 1:
        final_cleanup = commit_tail[1].split(
            "release_seq = release_seq + 1")[0].contains(
                "driver_end_transient_parse_scope()")
    (not driver.contains("me add_streaming_module_surface(") and
        not driver.contains("Result<ModuleSurfaceBuilder, text>") and
        not driver.contains("builder = parsed_result.unwrap()") and
        not body.contains("if builder.frozen:") and
        not body.contains(
            "if builder.index_by_path.contains_key(canonical_path):") and
        surface_source.contains("struct ModuleSurfaceBuilder:") and
        not surface_source.contains("class ModuleSurfaceBuilder:") and
        loop_pos >= 0 and begin_pos > loop_pos and parse_pos > begin_pos and
        owner_pos > parse_pos and surface_pos > owner_pos and
        pause_pos > surface_pos and promote_pos > pause_pos and
        commit_pos > promote_pos and commit_receipt_pos > commit_pos and
        release_pos > commit_receipt_pos and final_cleanup)

fn physical_path(index: i64) -> text:
    "build/streaming-owner-stress/physical_{index}.spl"

fn physical_content(index: i64) -> text:
    "fn value_{index}() -> i64:\n    {index}\n"

fn main() -> i32:
    if not production_is_single_frame():
        return fail("production-boundary-not-single-frame")
    var builder = ModuleSurfaceBuilder.new()
    var parse_count: i64 = 0
    var physical_index: i64 = 0
    while physical_index < PHYSICAL_COUNT:
        val path = physical_path(physical_index)
        val content = physical_content(physical_index)
        val module_name = "stress.physical_{physical_index}"
        val source = SourceFile(
            path: path, content: content, module_name: module_name)
        val canonical_path = module_surface_canonical_path(path)
        if canonical_path == "":
            return fail("empty-canonical-path")
        if builder.has_canonical_path(canonical_path):
            return fail("physical-path-seen-before-parse")

        # This is the exact streaming boundary rule: only a new canonical
        # physical path enters the parse/promote/commit lane.
        parse_count = parse_count + 1
        val surface = ModuleSurface.empty(canonical_path)
        surface.source_index = physical_index
        surface.canonical_path = canonical_path
        surface.module_name = module_name
        surface.content_length = content.len()
        surface.content_hash = rt_hash_text(content)
        val physical_add = builder.add_surface_canonical(
            surface, source, canonical_path)
        if physical_add.is_err():
            return fail("physical-commit")

        val alias = SourceFile(
            path: path,
            content: content,
            module_name: "stress.alias_{physical_index}")
        if not builder.has_canonical_path(canonical_path):
            return fail("alias-missed-physical")
        val alias_add = builder.add_alias_canonical(alias, canonical_path)
        if alias_add.is_err():
            return fail("same-content-alias-rejected")
        physical_index = physical_index + 1

    val first_path = physical_path(0)
    val first_canonical = module_surface_canonical_path(first_path)
    val conflict = SourceFile(
        path: first_path,
        content: physical_content(0) + "# changed\n",
        module_name: "stress.conflicting_alias")
    val conflict_result = builder.add_alias_canonical(conflict, first_canonical)
    if not conflict_result.is_err():
        return fail("differing-content-alias-accepted")

    val finished = builder.finish()
    if finished.is_err():
        return fail("finish")
    val registry = finished.unwrap()
    if parse_count != PHYSICAL_COUNT:
        return fail("parse-count")
    if registry.surfaces.len() != PHYSICAL_COUNT:
        return fail("physical-count")
    if registry.ordered_names.len() != PHYSICAL_COUNT + ALIAS_COUNT:
        return fail("name-count")
    if registry.ordered_indices.len() != PHYSICAL_COUNT + ALIAS_COUNT:
        return fail("index-count")

    physical_index = 0
    while physical_index < PHYSICAL_COUNT:
        val canonical_path = module_surface_canonical_path(
            physical_path(physical_index))
        if registry.surfaces[physical_index].canonical_path == "":
            return fail("published-empty-path")
        if registry.surfaces[physical_index].canonical_path != canonical_path:
            return fail("unstable-canonical-path")
        val physical_name = "stress.physical_{physical_index}"
        val alias_name = "stress.alias_{physical_index}"
        if not registry.index_by_name.contains_key(physical_name) or
           not registry.index_by_name.contains_key(alias_name):
            return fail("missing-published-name")
        if registry.index_by_name[physical_name] != physical_index or
           registry.index_by_name[alias_name] != physical_index:
            return fail("alias-not-same-surface")
        physical_index = physical_index + 1

    print(
        "streaming_surface_builder_single_frame_stress=PASS inline=1 physical={PHYSICAL_COUNT} aliases={ALIAS_COUNT} parses={parse_count} surfaces={registry.surfaces.len()} names={registry.ordered_names.len()} conflict_rejected=1")
    0
