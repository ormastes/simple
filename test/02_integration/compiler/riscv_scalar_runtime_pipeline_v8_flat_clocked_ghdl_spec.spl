# codex-system-test
# Clocked black-box evidence for the V8 direct scalar product.  It deliberately
# observes only the public CSR service ABI: the testbench never reaches into
# the tag-three owner or its held state.
use std.spec.*
use app.io.vhdl_ffi.{ghdl_available, ghdl_unique_workdir, ghdl_analyze_in, ghdl_elaborate_in, ghdl_run_in, vhdl_write_file}
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.backend.backend.riscv_scalar_runtime_pipeline_v8_flat_to_vhdl.{compile_strict_riscv_scalar_runtime_pipeline_v8_flat}

fn runtime_v8_rv32() -> CoreConfig:
    CoreConfig(xlen: 32, physical_address_bits: 32, register_count: 32,
        profile: "riscv-gen2-rv32-zmmul-zicsr", isa_profile: "rv32i_zmmul_zicsr_zifencei", compressed_decode_profile: "none")

fn runtime_v8_rv64() -> CoreConfig:
    CoreConfig(xlen: 64, physical_address_bits: 56, register_count: 32,
        profile: "riscv-gen2-rv64-zmmul-zicsr", isa_profile: "rv64i_zmmul_zicsr_zifencei", compressed_decode_profile: "none")

fn runtime_v8_tb(entity: text, xlen: i32, read_value: text) -> text:
    """
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use std.env.all;
entity {entity}_tb is end entity;
architecture sim of {entity}_tb is
  signal clk, rst, in_valid, completion_ready : std_logic := '0';
  signal instruction : std_logic_vector(31 downto 0) := (others=>'0');
  signal instruction_length_bytes : std_logic_vector(2 downto 0) := "100";
  signal rs1_value, rs2_value, pc_before, fallthrough_pc : std_logic_vector({xlen - 1} downto 0) := (others=>'0');
  signal privilege : std_logic_vector(1 downto 0) := "11";
  signal provider_event_id, decode_event_id : std_logic_vector(63 downto 0) := (others=>'0');
  signal csr_present : std_logic := '1'; signal csr_read_value : std_logic_vector({xlen - 1} downto 0) := x"{read_value}";
  signal bus_request_ready, bus_response_valid, bus_response_fault, fence_effect_ready : std_logic := '0';
  signal bus_response_id : std_logic_vector(63 downto 0) := (others=>'0');
  signal bus_response_data, bus_response_cause, bus_response_tval : std_logic_vector({xlen - 1} downto 0) := (others=>'0');
  signal in_ready, completion_valid, completion_rd_write, completion_execute_trap_valid, completion_illegal_valid, runtime_protocol_fault : std_logic;
  signal completion_rd : std_logic_vector(4 downto 0); signal completion_rd_value, completion_execute_trap_cause, completion_execute_trap_tval, completion_pc_before, completion_pc_after : std_logic_vector({xlen - 1} downto 0);
  signal completion_original_instruction, completion_canonical_instruction : std_logic_vector(31 downto 0); signal completion_instruction_length_bytes : std_logic_vector(2 downto 0); signal completion_provider_event_id, completion_decode_event_id : std_logic_vector(63 downto 0);
  signal csr_lookup_valid, csr_lookup_read_enable, csr_commit_valid : std_logic;
  signal csr_lookup_address, csr_commit_address : std_logic_vector(11 downto 0); signal csr_commit_value : std_logic_vector({xlen - 1} downto 0);
begin
  dut: entity work.{entity} port map(
    clk=>clk,rst=>rst,in_valid=>in_valid,instruction=>instruction,instruction_length_bytes=>instruction_length_bytes,rs1_value=>rs1_value,rs2_value=>rs2_value,pc_before=>pc_before,fallthrough_pc=>fallthrough_pc,privilege=>privilege,provider_event_id=>provider_event_id,decode_event_id=>decode_event_id,completion_ready=>completion_ready,bus_request_ready=>bus_request_ready,bus_response_valid=>bus_response_valid,bus_response_id=>bus_response_id,bus_response_data=>bus_response_data,bus_response_fault=>bus_response_fault,bus_response_cause=>bus_response_cause,bus_response_tval=>bus_response_tval,fence_effect_ready=>fence_effect_ready,csr_present=>csr_present,csr_read_value=>csr_read_value,
    in_ready=>in_ready,completion_valid=>completion_valid,completion_privilege=>open,completion_original_instruction=>completion_original_instruction,completion_canonical_instruction=>completion_canonical_instruction,completion_instruction_length_bytes=>completion_instruction_length_bytes,completion_pc_before=>completion_pc_before,completion_pc_after=>completion_pc_after,completion_rd=>completion_rd,completion_rd_write=>completion_rd_write,completion_rd_value=>completion_rd_value,completion_memory_address=>open,completion_memory_read_mask=>open,completion_memory_write_mask=>open,completion_memory_read_data=>open,completion_memory_write_data=>open,completion_execute_trap_valid=>completion_execute_trap_valid,completion_execute_trap_cause=>completion_execute_trap_cause,completion_execute_trap_tval=>completion_execute_trap_tval,completion_memory_trap_valid=>open,completion_memory_trap_cause=>open,completion_memory_trap_tval=>open,completion_redirect_valid=>open,completion_redirect_target=>open,completion_provider_event_id=>completion_provider_event_id,completion_decode_event_id=>completion_decode_event_id,completion_illegal_valid=>completion_illegal_valid,runtime_protocol_fault=>runtime_protocol_fault,bus_request_valid=>open,bus_request_id=>open,bus_request_address=>open,bus_request_write=>open,bus_request_byte_mask=>open,bus_request_write_data=>open,bus_response_ready=>open,fence_effect_valid=>open,fence_effect_kind=>open,fence_effect_fm=>open,fence_effect_pred=>open,fence_effect_succ=>open,csr_lookup_valid=>csr_lookup_valid,csr_lookup_address=>csr_lookup_address,csr_lookup_read_enable=>csr_lookup_read_enable,csr_commit_valid=>csr_commit_valid,csr_commit_address=>csr_commit_address,csr_commit_value=>csr_commit_value);
  process
    procedure tick is begin wait for 1 ns; clk<='1'; wait for 1 ns; clk<='0'; wait for 1 ns; end procedure;
    procedure drive(constant insn : std_logic_vector(31 downto 0); constant source : std_logic_vector({xlen - 1} downto 0); constant p : std_logic_vector(1 downto 0); constant event : natural) is begin in_valid<='1'; instruction<=insn; rs1_value<=source; privilege<=p; pc_before<=std_logic_vector(to_unsigned(256,{xlen})); fallthrough_pc<=std_logic_vector(to_unsigned(260,{xlen})); provider_event_id<=std_logic_vector(to_unsigned(event,64)); decode_event_id<=std_logic_vector(to_unsigned(event+100,64)); end procedure;
    procedure await_completion(constant label_text : string) is begin for n in 1 to 12 loop if completion_valid='1' then return; end if; tick; end loop; assert false report label_text severity failure; end procedure;
  begin
    rst<='1'; tick; rst<='0'; wait for 1 ns;
    assert in_ready='1' and runtime_protocol_fault='0' report "V8 reset state invalid" severity failure;
    -- CSRRW x5,mstatus,x1: lookup/read value is captured at admission, result holds until accepted, and write commits exactly once.
    drive(x"300092F3",std_logic_vector(to_unsigned(16,{xlen})),"11",1); tick;
    assert csr_lookup_valid='1' and csr_lookup_read_enable='1' and csr_lookup_address=x"300" report "CSRRW did not expose atomic lookup ABI" severity failure;
    in_valid<='0'; await_completion("CSRRW did not complete through tag three");
    assert completion_rd="00101" and completion_rd_write='1' and completion_rd_value=x"{read_value}" and completion_original_instruction=x"300092F3" and completion_canonical_instruction=x"300092F3" and completion_instruction_length_bytes="100" and completion_pc_before=std_logic_vector(to_unsigned(256,{xlen})) and completion_pc_after=std_logic_vector(to_unsigned(260,{xlen})) and completion_provider_event_id=std_logic_vector(to_unsigned(1,64)) and completion_decode_event_id=std_logic_vector(to_unsigned(101,64)) and csr_commit_valid='0' report "CSRRW capture payload or provenance mismatch" severity failure;
    csr_read_value<=(others=>'1'); tick; assert completion_valid='1' and completion_rd_value=x"{read_value}" and csr_commit_valid='0' report "CSRRW completion did not hold captured service data" severity failure;
    completion_ready<='1'; wait for 1 ns; assert csr_commit_valid='1' and csr_commit_address=x"300" and csr_commit_value=std_logic_vector(to_unsigned(16,{xlen})) report "CSRRW did not present exact-once commit before consume edge" severity failure; tick; completion_ready<='0';
    assert completion_valid='0' and csr_commit_valid='0' report "CSRRW completion or commit was not one-shot" severity failure;
    -- CSRRS x0,mstatus,x0 reads for service but has no source write and no rd destination write.
    assert in_ready='1' report "CSRRS started while owner busy" severity failure;
    csr_read_value<=x"{read_value}"; drive(x"30002073",std_logic_vector(to_unsigned(99,{xlen})),"11",2); tick;
    assert csr_lookup_valid='1' and csr_lookup_read_enable='1' and csr_lookup_address=x"300" report "CSRRS x0 lost required read lookup" severity failure;
    in_valid<='0'; await_completion("CSRRS x0 did not complete");
    assert completion_rd="00000" and completion_rd_write='0' and completion_rd_value=x"{read_value}" and csr_commit_valid='0' report "CSRRS x0 source/destination semantics mismatch" severity failure;
    completion_ready<='1'; wait for 1 ns; assert csr_commit_valid='0' report "CSRRS x0 committed a zero-source write" severity failure; tick; completion_ready<='0';
    -- CSRRW x0 suppresses a needless read while still preserving its legal source write.
    drive(x"30009073",std_logic_vector(to_unsigned(7,{xlen})),"11",3); tick; assert csr_lookup_valid='1' and csr_lookup_read_enable='0' report "CSRRW x0 did not suppress lookup read" severity failure; in_valid<='0'; await_completion("CSRRW x0 did not complete"); completion_ready<='1'; wait for 1 ns; assert csr_commit_valid='1' and csr_commit_value=std_logic_vector(to_unsigned(7,{xlen})) report "CSRRW x0 did not retain write intent" severity failure; tick; completion_ready<='0';
    -- Immediate and RMW forms must derive the exact captured architectural commit value.
    csr_read_value<=std_logic_vector(to_unsigned(16#A0#,{xlen})); drive(x"3001D2F3",(others=>'0'),"11",4); tick; in_valid<='0'; await_completion("CSRRWI did not complete"); completion_ready<='1'; wait for 1 ns; assert csr_commit_valid='1' and csr_commit_value=std_logic_vector(to_unsigned(3,{xlen})) report "CSRRWI commit mismatch" severity failure; tick; completion_ready<='0';
    csr_read_value<=std_logic_vector(to_unsigned(16#A0#,{xlen})); drive(x"3001E2F3",(others=>'0'),"11",5); tick; in_valid<='0'; await_completion("CSRRSI did not complete"); completion_ready<='1'; wait for 1 ns; assert csr_commit_valid='1' and csr_commit_value=std_logic_vector(to_unsigned(16#A3#,{xlen})) report "CSRRSI OR commit mismatch" severity failure; tick; completion_ready<='0';
    csr_read_value<=std_logic_vector(to_unsigned(16#A7#,{xlen})); drive(x"3001B2F3",std_logic_vector(to_unsigned(3,{xlen})),"11",6); tick; in_valid<='0'; await_completion("CSRRC did not complete"); completion_ready<='1'; wait for 1 ns; assert csr_commit_valid='1' and csr_commit_value=std_logic_vector(to_unsigned(16#A4#,{xlen})) report "CSRRC clear commit mismatch" severity failure; tick; completion_ready<='0';
    csr_read_value<=std_logic_vector(to_unsigned(16#A7#,{xlen})); drive(x"3001F2F3",(others=>'0'),"11",7); tick; in_valid<='0'; await_completion("CSRRCI did not complete"); completion_ready<='1'; wait for 1 ns; assert csr_commit_valid='1' and csr_commit_value=std_logic_vector(to_unsigned(16#A4#,{xlen})) report "CSRRCI clear-immediate commit mismatch" severity failure; tick; completion_ready<='0';
    -- Read-only, absent, and privilege failures are architectural execute traps, never commits or sticky protocol faults.
    drive(x"C00092F3",std_logic_vector(to_unsigned(1,{xlen})),"11",8); tick; in_valid<='0'; await_completion("read-only CSR did not trap");
    assert completion_execute_trap_valid='1' and completion_execute_trap_cause=std_logic_vector(to_unsigned(2,{xlen})) and completion_execute_trap_tval=std_logic_vector(to_unsigned(16#C00092F3#,{xlen})) and completion_illegal_valid='0' and csr_commit_valid='0' and runtime_protocol_fault='0' report "read-only CSR was not a no-commit execute trap" severity failure;
    tick; assert completion_valid='1' and completion_execute_trap_tval=std_logic_vector(to_unsigned(16#C00092F3#,{xlen})) report "read-only trap did not hold under backpressure" severity failure; completion_ready<='1'; wait for 1 ns; assert csr_commit_valid='0' report "read-only trap committed" severity failure; tick; completion_ready<='0'; csr_present<='0';
    drive(x"301092F3",std_logic_vector(to_unsigned(1,{xlen})),"11",9); tick; in_valid<='0'; await_completion("absent CSR did not trap");
    assert completion_execute_trap_valid='1' and completion_execute_trap_cause=std_logic_vector(to_unsigned(2,{xlen})) and completion_execute_trap_tval=std_logic_vector(to_unsigned(16#301092F3#,{xlen})) and csr_commit_valid='0' and runtime_protocol_fault='0' report "absent CSR policy mismatch" severity failure;
    completion_ready<='1'; wait for 1 ns; assert csr_commit_valid='0' report "absent trap committed" severity failure; tick; completion_ready<='0'; csr_present<='1';
    drive(x"300092F3",std_logic_vector(to_unsigned(1,{xlen})),"00",10); tick; in_valid<='0'; await_completion("privilege CSR did not trap");
    assert completion_execute_trap_valid='1' and completion_execute_trap_cause=std_logic_vector(to_unsigned(2,{xlen})) and completion_execute_trap_tval=std_logic_vector(to_unsigned(16#300092F3#,{xlen})) and csr_commit_valid='0' and runtime_protocol_fault='0' report "privilege CSR policy mismatch" severity failure;
    completion_ready<='1'; wait for 1 ns; assert completion_valid='1' and csr_commit_valid='0' report "privilege trap committed before its consume edge" severity failure; tick; completion_ready<='0';
    -- A CSR decode with malformed instruction metadata must fault the tag-three owner, remain fail-closed, then recover only by reset.
    instruction_length_bytes<="000"; drive(x"300092F3",std_logic_vector(to_unsigned(1,{xlen})),"11",11); tick; in_valid<='0';
    assert runtime_protocol_fault='1' and in_ready='0' and completion_valid='0' and csr_commit_valid='0' report "malformed CSR metadata did not become sticky protocol fault" severity failure;
    rst<='1'; tick; rst<='0'; instruction_length_bytes<="100"; wait for 1 ns;
    assert runtime_protocol_fault='0' and in_ready='1' and completion_valid='0' report "reset did not recover tag-three CSR fault" severity failure;
    -- This separate raw/control mismatch proves the admission gate is not only a length checker: PC/fallthrough lineage is part of tag-three metadata.
    drive(x"300092F3",std_logic_vector(to_unsigned(1,{xlen})),"11",12); fallthrough_pc<=std_logic_vector(to_unsigned(264,{xlen})); tick; in_valid<='0';
    assert runtime_protocol_fault='1' and in_ready='0' and completion_valid='0' and csr_commit_valid='0' report "malformed CSR control lineage did not become sticky protocol fault" severity failure;
    rst<='1'; tick; rst<='0'; wait for 1 ns;
    assert runtime_protocol_fault='0' and in_ready='1' and completion_valid='0' report "reset did not recover CSR control-lineage fault" severity failure;
    finish;
  end process;
end architecture;
"""

fn simulate_runtime_v8(entity: text, config: CoreConfig, bus: LsuConfig) -> bool:
    val emitted = compile_strict_riscv_scalar_runtime_pipeline_v8_flat(entity, config, bus)
    if not emitted.is_success(): return false
    val workdir = ghdl_unique_workdir(entity); if workdir.is_err(): return false
    val isolated = workdir.ok().unwrap()
    val path = isolated + "/" + entity + ".vhd"
    val read_value = if config.xlen == 64: "00000000000000A5" else: "000000A5"
    if not vhdl_write_file(path, emitted.vhdl + "\n" + runtime_v8_tb(entity, config.xlen, read_value)): return false
    if not ghdl_analyze_in(path, isolated).success: return false
    if not ghdl_elaborate_in(entity + "_tb", isolated).success: return false
    ghdl_run_in(entity + "_tb", Some("3us"), isolated).success

describe "runtime scalar pipeline v8 flat clocked GHDL integration":
    slow_it "proves RV32 and RV64 CSR capture, backpressure, policy traps, fail-closed metadata and reset":
        val available = ghdl_available(); expect(available).to_equal(true)
        if not available: return
        expect(simulate_runtime_v8("runtime_pipeline_v8_flat_clocked_rv32", runtime_v8_rv32(), LsuConfig.rv32_product_default())).to_equal(true)
        expect(simulate_runtime_v8("runtime_pipeline_v8_flat_clocked_rv64", runtime_v8_rv64(), LsuConfig.rv64_product_default())).to_equal(true)
