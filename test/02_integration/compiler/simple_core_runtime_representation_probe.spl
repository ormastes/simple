extern fn abort()
extern fn rt_value_int(value: i64) -> i64
extern fn rt_value_unbox_int(value: i64) -> i64
extern fn rt_value_float(value: f64) -> i64
extern fn rt_value_as_float(value: i64) -> f64
extern fn rt_any_sub(left: i64, right: i64) -> i64
extern fn rt_array_new(cap: i64) -> i64
extern fn rt_array_push(array: i64, value: i64) -> i8
extern fn rt_array_len(array: i64) -> i64
extern fn rt_collection_remove(receiver: i64, key: i64) -> i64

fn stop(code: i64):
    abort()

val nine = rt_value_int(9)
val four = rt_value_int(4)
if rt_value_unbox_int(rt_any_sub(nine, four)) != 5:
    stop(11)

val negative = rt_value_int(-9)
if rt_value_unbox_int(rt_any_sub(negative, four)) != -13:
    stop(12)

# Both sides of the signed 61-bit immediate boundary must round-trip through
# the hosted-compatible INT1 wide box.
val positive_wide = rt_value_int(1152921504606846976)
if rt_value_unbox_int(positive_wide) != 1152921504606846976:
    stop(13)
val negative_wide = rt_value_int(-1152921504606846977)
if rt_value_unbox_int(negative_wide) != -1152921504606846977:
    stop(14)
if rt_value_unbox_int(rt_any_sub(positive_wide, rt_value_int(1))) != 1152921504606846975:
    stop(15)

val mixed = rt_any_sub(rt_value_float(9.5), four)
val mixed_value = rt_value_as_float(mixed)
if mixed_value < 5.499999 or mixed_value > 5.500001:
    stop(16)

val values = rt_array_new(3)
if rt_array_push(values, rt_value_int(10)) == 0:
    stop(17)
if rt_array_push(values, rt_value_int(20)) == 0:
    stop(18)
if rt_array_push(values, rt_value_int(30)) == 0:
    stop(19)
if rt_value_unbox_int(rt_collection_remove(values, rt_value_int(1))) != 20:
    stop(20)
if rt_array_len(values) != 2:
    stop(21)

# Reaching the end is the success signal. Do not call rt_exit here: the
# simple-core process owner has a separate libc-exit alias recursion defect.
