use std.spec.*
use app.io.vhdl_ffi.{ghdl_available, ghdl_analyze, ghdl_elaborate,
    ghdl_run, vhdl_write_file}
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.backend.backend.riscv_scalar_product_to_vhdl.{
    compile_strict_riscv_scalar_product}

fn alu_product_tb(entity_name: text, tb_name: text, xlen: i32,
    lhs_hex: text, rhs_hex: text, expected_hex: text,
    expected_rd: text, expected_write: text) -> text:
    val high = (xlen - 1).to_text()
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n" +
    "use std.env.all; entity " + tb_name + " is end entity;\n" +
    "architecture sim of " + tb_name + " is signal clk,rst,in_valid,retire_ready: std_logic := '0';\n" +
    " signal in_ready,retire_valid,rd_write,retire_trap,protocol_fault: std_logic;\n" +
    " signal retire_order: std_logic_vector(63 downto 0); signal rd: std_logic_vector(4 downto 0);\n" +
    " signal rd_value: std_logic_vector(" + high + " downto 0); begin clk <= not clk after 5 ns;\n" +
    " dut: entity work." + entity_name + " port map(clk=>clk,rst=>rst,retire_ready=>retire_ready," +
    "illegal_valid=>'0',interrupt_valid=>'0',interrupt_cause=>(others=>'0'),interrupt_event_id=>(others=>'0')," +
    "provider_event_id=>std_logic_vector(to_unsigned(21,64)),decode_event_id=>std_logic_vector(to_unsigned(21,64))," +
    "interrupt_held=>'0',between_events=>'0',in_order=>std_logic_vector(to_unsigned(21,64))," +
    "in_privilege=>\"11\",in_pc=>(others=>'0'),rs1_value=>x\"" + lhs_hex + "\",rs2_value=>x\"" + rhs_hex + "\"," +
    "in_valid=>in_valid,in_ready=>in_ready,dispatch_accept=>open,retire_valid=>retire_valid," +
    "retire_order=>retire_order,protocol_fault=>protocol_fault,retire_xlen=>open,retire_privilege=>open," +
    "retire_original_instruction=>open,retire_canonical_instruction=>open,retire_instruction_length_bytes=>open," +
    "retire_pc_before=>open,retire_pc_after=>open,retire_rd=>rd,retire_rd_write=>rd_write,retire_rd_value=>rd_value," +
    "retire_memory_address=>open,retire_memory_read_mask=>open,retire_memory_write_mask=>open," +
    "retire_memory_read_data=>open,retire_memory_write_data=>open,retire_trap=>retire_trap," +
    "retire_interrupt=>open,retire_cause=>open,retire_tval=>open);\n" +
    " process begin rst<='1'; wait until rising_edge(clk); wait until rising_edge(clk); rst<='0'; wait for 1 ns;\n" +
    " assert in_ready='1' report \"ALU product not ready\" severity failure; in_valid<='1'; wait until rising_edge(clk); in_valid<='0';\n" +
    " for i in 0 to 8 loop wait for 1 ns; exit when retire_valid='1'; wait until rising_edge(clk); end loop;\n" +
    " assert retire_valid='1' and rd_value=x\"" + expected_hex + "\" report \"ALU result mismatch\" severity failure;\n" +
    " assert rd=\"" + expected_rd + "\" and rd_write='" + expected_write + "' and retire_trap='0' report \"ALU retirement effects mismatch\" severity failure;\n" +
    " assert retire_order=std_logic_vector(to_unsigned(0,64)) report \"ALU order mismatch\" severity failure;\n" +
    " wait until rising_edge(clk); wait for 1 ns; assert retire_valid='1' and rd_value=x\"" + expected_hex + "\" report \"ALU payload not held\" severity failure;\n" +
    " retire_ready<='1'; wait until rising_edge(clk); retire_ready<='0'; wait for 1 ns;\n" +
    " assert retire_valid='0' and protocol_fault='0' report \"ALU completion did not consume cleanly\" severity failure; finish; end process; end architecture;\n"

fn run_alu_product(entity_name: text, tb_name: text, config: CoreConfig,
    instruction: u32, lhs: text, rhs: text, expected: text,
    rd: text, write: text) -> bool:
    val bus = if config.xlen == 32: LsuConfig.rv32_product_default() else: LsuConfig.rv64_product_default()
    val emitted = compile_strict_riscv_scalar_product(entity_name, config, instruction, bus)
    if not emitted.is_success(): return false
    val path = "/tmp/" + entity_name + ".vhd"
    if not vhdl_write_file(path, emitted.vhdl + "\n" + alu_product_tb(
            entity_name, tb_name, config.xlen, lhs, rhs, expected, rd, write)): return false
    if not ghdl_analyze(path).success: return false
    if not ghdl_elaborate(tb_name).success: return false
    ghdl_run(tb_name, Some("500ns")).success

describe "RISC-V Gen2 integrated scalar-I ALU cycle evidence":
    # @req REQ-G2-012 REQ-G2-015 NFR-G2-016
    slow_it "retires RV32 immediate and RV64 word-shift results once through the closed product when GHDL exists":
        if not ghdl_available():
            print "SKIP: GHDL not available"
            return
        expect(run_alu_product("scalar_addi_product_cycle", "scalar_addi_product_cycle_tb",
            CoreConfig.rv32(), 0xFFF08293, "00000001", "00000000", "00000000",
            "00101", "1")).to_equal(true)
        expect(run_alu_product("scalar_sraw_product_cycle", "scalar_sraw_product_cycle_tb",
            CoreConfig.rv64(), 0x4020D1BB, "0000000080000000", "0000000000000000",
            "FFFFFFFF80000000", "00011", "1")).to_equal(true)
        expect(run_alu_product("scalar_add_x0_product_cycle", "scalar_add_x0_product_cycle_tb",
            CoreConfig.rv32(), 0x00208033, "00000005", "00000007", "00000000",
            "00000", "0")).to_equal(true)
