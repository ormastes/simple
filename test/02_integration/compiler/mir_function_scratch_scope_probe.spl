use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_serialization.{serialize_mir_module}
use compiler.mir.mir_types.{MirTypeKind}
use compiler.hir.hir_definitions.{HirFunction, HirParam, HirBlock, HirExpr, HirExprKind}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.common.diagnostics.span.{Span}
use compiler.common.attributes.{FunctionAttr, ExportAttr, DriverManifestAttr, DriverManifestAttrKind, vhdl_hardware_metadata_default}
use compiler.common.dependency.visibility.{Visibility}

fn empty_span() -> Span:
    Span.empty()

fn unit_type() -> HirType:
    HirType(kind: HirTypeKind.Unit, span: empty_span())

fn dummy_expr() -> HirExpr:
    HirExpr(
        kind: HirExprKind.UnitLit,
        has_type_: false,
        type_: unit_type(),
        span: empty_span()
    )

fn dummy_block() -> HirBlock:
    HirBlock(
        stmts: [],
        has: true,
        value: dummy_expr(),
        span: empty_span()
    )

fn make_fn(id: i64, name: text) -> HirFunction:
    HirFunction(
        symbol: SymbolId(id: id),
        name: name,
        type_params: [],
        params: [],
        return_type: unit_type(),
        body: dummy_block(),
        effects: [],
        visibility: Visibility.Public,
        is_async: false,
        is_static: false,
        is_public: true,
        is_method: false,
        is_mutable: false,
        is_const: false,
        is_extern: false,
        func_attr: FunctionAttr.default(),
        has_export_attr: false,
        export_attr: ExportAttr(is_export_c: false, export_name: ""),
        has_driver_manifest_attr: false,
        driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
        has_suspension: false,
        has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(),
        has_doc_comment: false,
        doc_comment: "",
        span: empty_span(),
        is_gpu_kernel: false,
        gpu_target: "",
        gpu_backend_order: "",
        verification_contract: nil,
        is_generic_template: false
    )

fn make_module(name: text, path: text, functions: Dict<SymbolId, HirFunction>) -> HirModule:
    HirModule(
        name: name,
        path: path,
        imports: [],
        exports: [],
        domain_blocks: [],
        symbols: SymbolTable.new(),
        functions: functions,
        gpu_function_targets: {},
        gpu_function_backend_orders: {},
        classes: {},
        structs: {},
        enums: {},
        bitfields: {},
        traits: {},
        impls: [],
        constants: {},
        static_asserts: [],
        aop_advices: [],
        di_bindings: [],
        arch_rules: [],
        mock_decls: [],
        types: [],
        extend_enums: []
    )

# Native behavior regression; must run with actual scoped runtime support.
# No physical byte/RSS claim: that requires bound runtime observations.
fn parameter_module(name: text, id: i64) -> HirModule:
    var function = make_fn(id, "scratch_owner_entry")
    function.params = [HirParam(
        symbol: SymbolId(id: id + 1), name: "value",
        type_: HirType(kind: HirTypeKind.Int(64, true), span: empty_span()),
        has_default: false, default: dummy_expr(), span: empty_span(),
        is_mutable: false)]
    var functions: Dict<SymbolId, HirFunction> = {}
    functions[function.symbol] = function
    make_module(name, name + ".spl", functions)

fn check_mir_function_scratch_scope() -> i64:
    val first = parameter_module("scratch_first", 30)
    var reference = MirLowering.new(first.symbols)
    reference.use_explicit_semantic_policy()
    val reference_mir = reference.lower_module(first)
    if reference.errors.len() != 0: return 28
    if reference.local_symbol_ids.len() == 0: return 10
    if reference_mir.functions.keys().len() != 1: return 11
    var lowering = MirLowering.new(first.symbols)
    lowering.use_explicit_semantic_policy()
    val scoped = lowering.lower_module_transient_scoped(first)
    if scoped.is_err(): return 12
    val first_mir = scoped.unwrap()
    if lowering.local_symbol_ids.len() != 0: return 13
    if lowering.local_symbol_values.len() != 0: return 14
    if lowering.local_hir_type_ids.len() != 0: return 15
    if lowering.local_map.keys().len() != 0: return 16
    if first_mir.functions.keys().len() != 1: return 17
    if serialize_mir_module(first_mir) != serialize_mir_module(reference_mir): return 25
    if lowering.errors.len() != 0: return 29
    val first_function = first_mir.functions[SymbolId(id: 30)]
    if first_function.signature.params.len() != 1: return 30
    match first_function.signature.params[0].kind:
        case MirTypeKind.I64: ()
        case _: return 31
    if first_function.blocks.len() != 1: return 32
    if first_function.blocks[0].bootstrap_ret_kind() != 0: return 33
    if first_function.locals.len() != reference_mir.functions[SymbolId(id: 30)].locals.len(): return 18
    if first_function.blocks.len() != reference_mir.functions[SymbolId(id: 30)].blocks.len(): return 19
    val second = parameter_module("scratch_second", 40)
    val first_bytes = serialize_mir_module(first_mir)
    val next = lowering.lower_module_transient_scoped(second)
    if next.is_err(): return 20
    if next.unwrap().functions.keys().len() != 1: return 21
    if first_mir.functions[SymbolId(id: 30)].locals.len() != first_function.locals.len(): return 22
    if first_mir.functions[SymbolId(id: 30)].blocks.len() != first_function.blocks.len(): return 23
    if lowering.local_symbol_ids.len() != 0: return 24
    if serialize_mir_module(first_mir) != first_bytes: return 26
    var second_reference = MirLowering.new(second.symbols)
    second_reference.use_explicit_semantic_policy()
    if serialize_mir_module(next.unwrap()) != serialize_mir_module(second_reference.lower_module(second)): return 27
    print "PASS: completed MIR survives two scopes without retaining function-local indexes"
    0
