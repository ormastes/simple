# Narrow native reproducer for the full-closure empty-declaration-tag failure.
# It exits 1 if either valid slot is rejected or an out-of-range index is
# accepted. This is the admission check for the owner-side accessor repair.
use compiler.frontend.core._Ast.decl_nodes.{ast_module_decl_count_get, ast_module_decl_count_set, ast_module_decl_slot_get, ast_module_decl_slots_clear, ast_module_decl_slots_len}
use compiler.frontend.core._Ast.module_state.{module_add_decl, module_decl_at, module_decl_count_get}

fn main() -> i64:
    ast_module_decl_slots_clear()
    ast_module_decl_count_set(0)
    module_add_decl(7)
    module_add_decl(11)
    val count = module_decl_count_get()
    val slots = ast_module_decl_slots_len()
    val direct_count = ast_module_decl_count_get()
    val direct_first = ast_module_decl_slot_get(0)
    val direct_second = ast_module_decl_slot_get(1)
    val first = module_decl_at(0)
    val second = module_decl_at(1)
    val before = module_decl_at(-1)
    val outside = module_decl_at(2)
    print "count={count} direct_count={direct_count} slots={slots} direct_first={direct_first} direct_second={direct_second} first={first} second={second} before={before} outside={outside}"
    if count != 2 or direct_count != 2 or slots != 2 or
            direct_first != 7 or direct_second != 11 or first != 7 or
            second != 11 or before != -1 or outside != -1:
        return 1
    0
