# Adjacent controls for the unchanged stage3_context_tuple_return_native_probe.
# Run as a native executable produced by an admitted pure-Simple compiler.
class Stage3AdjacentContext:
    error_count_value: i64
    marker: i64

    fn error_count() -> i64:
        self.error_count_value

class Stage3AdjacentDriver:
    ctx: Stage3AdjacentContext

    me lower_and_check_impl(delta: i64, accepted: bool, replace: bool) -> (Stage3AdjacentContext, bool):
        if replace:
            val replacement = Stage3AdjacentContext(error_count_value: delta, marker: 91)
            return (replacement, accepted)
        self.ctx.error_count_value = self.ctx.error_count_value + delta
        (self.ctx, accepted)

    me compile(delta: i64, accepted: bool, replace: bool, expected_count: i64, expected_marker: i64) -> bool:
        val (analyzed_ctx, analyze_ok) = self.lower_and_check_impl(delta, accepted, replace)
        self.ctx = analyzed_ctx
        val direct_count = self.ctx.error_count_value
        val getter_count = self.ctx.error_count()
        (analyze_ok == accepted and direct_count == expected_count and
            getter_count == expected_count and self.ctx.marker == expected_marker)

fn main() -> i32:
    val driver = Stage3AdjacentDriver(ctx: Stage3AdjacentContext(error_count_value: 0, marker: 37))
    if not driver.compile(0, true, false, 0, 37):
        return 1
    if not driver.compile(1, true, false, 1, 37):
        return 2
    if not driver.compile(2, false, false, 3, 37):
        return 3
    if not driver.compile(11, false, true, 11, 91):
        return 4
    if not driver.compile(1, true, false, 12, 91):
        return 5
    val other = Stage3AdjacentDriver(ctx: Stage3AdjacentContext(error_count_value: 0, marker: 37))
    if not other.compile(0, false, false, 0, 37):
        return 6
    if driver.ctx.error_count_value != 12:
        return 7
    print("stage3_context_tuple_return_adjacent_status=pass")
    0
