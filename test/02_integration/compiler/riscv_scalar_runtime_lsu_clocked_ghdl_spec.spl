# codex-system-test
use std.spec.*
use app.io.vhdl_ffi.{ghdl_available, ghdl_unique_workdir, ghdl_analyze_in,
    ghdl_elaborate_in, ghdl_run_in, vhdl_write_file}
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_runtime_lsu_composition.{
    strict_riscv_scalar_runtime_lsu_composition}
use compiler.backend.backend.riscv_scalar_runtime_lsu_to_vhdl.{
    compile_strict_riscv_scalar_runtime_lsu_vhdl}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan,
    RiscvScalarIsaEntry, riscv_scalar_decoder_plan, riscv_scalar_semantic_opcode}

fn exact_row(plan: RiscvScalarDecoderPlan, instruction: u32) -> i64:
    var index = 0
    for entry in plan.entries:
        if entry.matches(instruction, plan.xlen): return index + 1
        index = index + 1
    0

fn declared_width_is_32(entry: RiscvScalarIsaEntry) -> i64:
    if entry.operand_width_bits == 32: 1 else: 0

fn runtime_lsu_clocked_tb(entity_name: text, row_width: i32,
    lb_row: i64, lb_semantic: i64, lb_width32: i64,
    sb_row: i64, sb_semantic: i64, sb_width32: i64,
    lh_row: i64, lh_semantic: i64, lh_width32: i64) -> text:
    """
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use std.env.all;
entity {entity_name}_tb is end entity;
architecture sim of {entity_name}_tb is
  signal clk, rst, dispatch_valid, dispatch_illegal_valid : std_logic := '0';
  signal downstream_ready, bus_request_ready, bus_response_valid : std_logic := '0';
  signal bus_response_fault : std_logic := '0';
  signal bus_response_id : std_logic_vector(63 downto 0) := (others => '0');
  signal bus_response_data, bus_response_cause, bus_response_tval : std_logic_vector(31 downto 0) := (others => '0');
  signal dispatch_decode_legal : std_logic := '0';
  signal dispatch_decoded_row_index : std_logic_vector({row_width - 1} downto 0) := (others => '0');
  signal dispatch_decoded_execution_class, dispatch_decoded_memory_effect : std_logic_vector(2 downto 0) := (others => '0');
  signal dispatch_decoded_semantic_opcode : std_logic_vector(5 downto 0) := (others => '0');
  signal dispatch_decoded_declared_operand_width_is_32 : std_logic := '0';
  signal dispatch_canonical_instruction, dispatch_original_instruction : std_logic_vector(31 downto 0) := (others => '0');
  signal dispatch_instruction_length_bytes : std_logic_vector(2 downto 0) := (others => '0');
  signal dispatch_instruction_rd_field, dispatch_instruction_rs1_field, dispatch_instruction_rs2_field : std_logic_vector(4 downto 0) := (others => '0');
  signal dispatch_rs1_value, dispatch_rs2_value, dispatch_pc_before, dispatch_fallthrough_pc : std_logic_vector(31 downto 0) := (others => '0');
  signal dispatch_privilege : std_logic_vector(1 downto 0) := (others => '0');
  signal dispatch_provider_event_id, dispatch_decode_event_id : std_logic_vector(63 downto 0) := (others => '0');
  signal dispatch_lineage_valid : std_logic := '0';
  signal dispatch_ready, uop_ready, bus_request_valid, bus_request_write, bus_response_ready : std_logic;
  signal bus_request_id : std_logic_vector(63 downto 0);
  signal bus_request_address : std_logic_vector(31 downto 0);
  signal bus_request_byte_mask : std_logic_vector(3 downto 0);
  signal bus_request_write_data : std_logic_vector(31 downto 0);
  signal selected_completion_valid, selected_completion_rd_write : std_logic;
  signal selected_completion_rd : std_logic_vector(4 downto 0);
  signal selected_completion_rd_value, selected_completion_memory_address : std_logic_vector(31 downto 0);
  signal selected_completion_memory_read_mask, selected_completion_memory_write_mask : std_logic_vector(31 downto 0);
  signal selected_completion_memory_read_data, selected_completion_memory_write_data : std_logic_vector(31 downto 0);
  signal selected_completion_memory_trap_valid : std_logic;
  signal selected_completion_memory_trap_cause, selected_completion_memory_trap_tval : std_logic_vector(31 downto 0);
  signal selected_completion_event_id, selected_completion_decode_event_id : std_logic_vector(63 downto 0);
  signal protocol_fault : std_logic;
begin
  dut: entity work.{entity_name} port map(
    clk=>clk, rst=>rst, dispatch_valid=>dispatch_valid,
    dispatch_illegal_valid=>dispatch_illegal_valid, downstream_ready=>downstream_ready,
    bus_request_ready=>bus_request_ready, bus_response_valid=>bus_response_valid,
    bus_response_id=>bus_response_id, bus_response_data=>bus_response_data,
    bus_response_fault=>bus_response_fault, bus_response_cause=>bus_response_cause,
    bus_response_tval=>bus_response_tval, dispatch_ready=>dispatch_ready,
    uop_ready=>uop_ready, bus_request_valid=>bus_request_valid,
    bus_request_id=>bus_request_id, bus_request_address=>bus_request_address,
    bus_request_write=>bus_request_write, bus_request_byte_mask=>bus_request_byte_mask,
    bus_request_write_data=>bus_request_write_data, bus_response_ready=>bus_response_ready,
    selected_completion_valid=>selected_completion_valid, selected_completion_tag=>open,
    selected_completion_event_id=>selected_completion_event_id,
    selected_completion_decode_event_id=>selected_completion_decode_event_id,
    protocol_fault=>protocol_fault,
    dispatch_decode_legal=>dispatch_decode_legal,
    dispatch_decoded_row_index=>dispatch_decoded_row_index,
    dispatch_decoded_execution_class=>dispatch_decoded_execution_class,
    dispatch_decoded_memory_effect=>dispatch_decoded_memory_effect,
    dispatch_decoded_semantic_opcode=>dispatch_decoded_semantic_opcode,
    dispatch_decoded_declared_operand_width_is_32=>dispatch_decoded_declared_operand_width_is_32,
    dispatch_canonical_instruction=>dispatch_canonical_instruction,
    dispatch_original_instruction=>dispatch_original_instruction,
    dispatch_instruction_length_bytes=>dispatch_instruction_length_bytes,
    dispatch_instruction_rd_field=>dispatch_instruction_rd_field,
    dispatch_instruction_rs1_field=>dispatch_instruction_rs1_field,
    dispatch_instruction_rs2_field=>dispatch_instruction_rs2_field,
    dispatch_rs1_value=>dispatch_rs1_value, dispatch_rs2_value=>dispatch_rs2_value,
    dispatch_pc_before=>dispatch_pc_before, dispatch_fallthrough_pc=>dispatch_fallthrough_pc,
    dispatch_privilege=>dispatch_privilege,
    dispatch_provider_event_id=>dispatch_provider_event_id,
    dispatch_decode_event_id=>dispatch_decode_event_id,
    dispatch_lineage_valid=>dispatch_lineage_valid,
    selected_completion_privilege=>open,
    selected_completion_original_instruction=>open,
    selected_completion_canonical_instruction=>open,
    selected_completion_instruction_length_bytes=>open,
    selected_completion_pc_before=>open, selected_completion_pc_after=>open,
    selected_completion_rd=>selected_completion_rd,
    selected_completion_rd_write=>selected_completion_rd_write,
    selected_completion_rd_value=>selected_completion_rd_value,
    selected_completion_memory_address=>selected_completion_memory_address,
    selected_completion_memory_read_mask=>selected_completion_memory_read_mask,
    selected_completion_memory_write_mask=>selected_completion_memory_write_mask,
    selected_completion_memory_read_data=>selected_completion_memory_read_data,
    selected_completion_memory_write_data=>selected_completion_memory_write_data,
    selected_completion_execute_trap_valid=>open,
    selected_completion_execute_trap_cause=>open,
    selected_completion_execute_trap_tval=>open,
    selected_completion_memory_trap_valid=>selected_completion_memory_trap_valid,
    selected_completion_memory_trap_cause=>selected_completion_memory_trap_cause,
    selected_completion_memory_trap_tval=>selected_completion_memory_trap_tval,
    selected_completion_redirect_valid=>open,
    selected_completion_redirect_target=>open);
  process
    variable accepted_id : std_logic_vector(63 downto 0);
    procedure tick is
    begin wait for 1 ns; clk<='1'; wait for 1 ns; clk<='0'; wait for 1 ns; end procedure;
    procedure drive(constant insn : std_logic_vector(31 downto 0);
      constant row, semantic, effect, width32 : natural;
      constant rs1, rs2, pc : std_logic_vector(31 downto 0);
      constant event_id : natural) is
    begin
      dispatch_valid<='1'; dispatch_decode_legal<='1'; dispatch_illegal_valid<='0';
      dispatch_decoded_row_index<=std_logic_vector(to_unsigned(row, {row_width}));
      dispatch_decoded_execution_class<="011";
      dispatch_decoded_memory_effect<=std_logic_vector(to_unsigned(effect, 3));
      dispatch_decoded_semantic_opcode<=std_logic_vector(to_unsigned(semantic, 6));
      dispatch_decoded_declared_operand_width_is_32<=std_logic'val(width32 + 2);
      dispatch_canonical_instruction<=insn; dispatch_original_instruction<=insn;
      dispatch_instruction_length_bytes<="100";
      dispatch_instruction_rd_field<=insn(11 downto 7);
      dispatch_instruction_rs1_field<=insn(19 downto 15);
      dispatch_instruction_rs2_field<=insn(24 downto 20);
      dispatch_rs1_value<=rs1; dispatch_rs2_value<=rs2;
      dispatch_pc_before<=pc; dispatch_fallthrough_pc<=std_logic_vector(unsigned(pc)+4);
      dispatch_privilege<="11";
      dispatch_provider_event_id<=std_logic_vector(to_unsigned(event_id,64));
      dispatch_decode_event_id<=std_logic_vector(to_unsigned(event_id,64));
      dispatch_lineage_valid<='1';
    end procedure;
  begin
    rst<='1'; tick; rst<='0'; wait for 1 ns;
    assert dispatch_ready='1' and uop_ready='1' and protocol_fault='0'
      report "reset/readiness mismatch" severity failure;

    -- LB x1,-1(x2): capture all lineage, then mutate every live dispatch input.
    drive(x"FFF10083", {lb_row}, {lb_semantic}, 1, {lb_width32},
      x"00000102", x"00000000", x"00000200", 17);
    tick; dispatch_valid<='0'; wait for 1 ns;
    assert bus_request_valid='0' and selected_completion_valid='0'
      report "LB became visible before the pending-to-LSU edge" severity failure;
    tick; wait for 1 ns;
    assert bus_request_valid='1' and bus_request_write='0' and
      bus_request_address=x"00000101" and bus_request_byte_mask="0010"
      report "LB request capture mismatch" severity failure;
    accepted_id:=bus_request_id;
    dispatch_canonical_instruction<=x"00000023"; dispatch_original_instruction<=x"00000023";
    dispatch_decoded_row_index<=(others=>'1'); dispatch_decoded_semantic_opcode<=(others=>'1');
    dispatch_rs1_value<=x"DEADBEEF"; dispatch_rs2_value<=x"CAFEBABE";
    dispatch_provider_event_id<=(others=>'1'); dispatch_decode_event_id<=(others=>'1');
    tick;
    assert bus_request_valid='1' and bus_request_id=accepted_id and
      bus_request_address=x"00000101" and bus_request_write='0' and bus_request_byte_mask="0010"
      report "backpressured LB request changed with live dispatch" severity failure;
    bus_request_ready<='1'; tick; bus_request_ready<='0'; wait for 1 ns;
    assert bus_request_valid='0' and bus_response_ready='1'
      report "LB request acceptance was not exact" severity failure;
    bus_response_id<=accepted_id; bus_response_data<=x"00008000"; bus_response_valid<='1';
    tick; bus_response_valid<='0'; wait for 1 ns;
    assert selected_completion_valid='0'
      report "LB completion became selected before the LSU-to-pending edge" severity failure;
    tick; wait for 1 ns;
    assert selected_completion_valid='1' and selected_completion_rd="00001" and
      selected_completion_rd_write='1' and selected_completion_rd_value=x"FFFFFF80" and
      selected_completion_memory_address=x"00000101" and
      selected_completion_memory_read_mask=x"00000001" and
      selected_completion_memory_read_data=x"FFFFFF80" and
      selected_completion_event_id=x"0000000000000011" and
      selected_completion_decode_event_id=x"0000000000000011"
      report "matched LB response was not normalized with captured metadata" severity failure;
    tick;
    assert selected_completion_valid='1' and selected_completion_rd_value=x"FFFFFF80"
      report "LB completion was not held under downstream backpressure" severity failure;
    downstream_ready<='1'; tick; downstream_ready<='0'; wait for 1 ns;
    assert selected_completion_valid='0' report "LB completion was not consumed once" severity failure;
    tick; assert selected_completion_valid='0' report "LB completion duplicated" severity failure;

    -- SB x3,-1(x2): shifted bus mask/data and low-justified completion record.
    drive(x"FE310FA3", {sb_row}, {sb_semantic}, 2, {sb_width32},
      x"00000102", x"000000AB", x"00000300", 18);
    tick; dispatch_valid<='0'; wait for 1 ns;
    assert bus_request_valid='0' and selected_completion_valid='0'
      report "SB became visible before the pending-to-LSU edge" severity failure;
    tick; wait for 1 ns; accepted_id:=bus_request_id;
    assert bus_request_valid='1' and bus_request_write='1' and
      bus_request_address=x"00000101" and bus_request_byte_mask="0010" and
      bus_request_write_data=x"0000AB00"
      report "SB bus mask/data mismatch" severity failure;
    bus_request_ready<='1'; tick; bus_request_ready<='0';
    bus_response_id<=accepted_id; bus_response_data<=(others=>'0'); bus_response_valid<='1';
    tick; bus_response_valid<='0'; wait for 1 ns;
    assert selected_completion_valid='0'
      report "SB completion became selected before the LSU-to-pending edge" severity failure;
    tick; wait for 1 ns;
    assert selected_completion_valid='1' and selected_completion_rd_write='0' and
      selected_completion_memory_address=x"00000101" and
      selected_completion_memory_write_mask=x"00000001" and
      selected_completion_memory_write_data=x"000000AB"
      report "SB completion record mismatch" severity failure;
    downstream_ready<='1'; tick; downstream_ready<='0';

    -- A non-matching response ID faults sticky; reset is the only recovery.
    drive(x"FFF10083", {lb_row}, {lb_semantic}, 1, {lb_width32},
      x"00000102", x"00000000", x"00000400", 19);
    tick; dispatch_valid<='0'; wait for 1 ns;
    assert bus_request_valid='0' and selected_completion_valid='0'
      report "wrong-ID request became visible before the pending-to-LSU edge" severity failure;
    tick; wait for 1 ns; accepted_id:=bus_request_id;
    assert bus_request_valid='1'
      report "wrong-ID setup request was not presented" severity failure;
    bus_request_ready<='1'; tick; bus_request_ready<='0';
    bus_response_id<=std_logic_vector(unsigned(accepted_id)+1); bus_response_valid<='1'; tick;
    bus_response_valid<='0'; wait for 1 ns;
    assert protocol_fault='1' and selected_completion_valid='0'
      report "wrong response ID did not fault closed" severity failure;
    tick; assert protocol_fault='1' report "response ID fault was not sticky" severity failure;
    rst<='1'; tick; rst<='0'; wait for 1 ns;
    assert protocol_fault='0' and dispatch_ready='1'
      report "reset did not clear sticky response fault" severity failure;

    -- LH x1,-1(x2) is locally misaligned and must never reach the bus.
    drive(x"FFF11083", {lh_row}, {lh_semantic}, 1, {lh_width32},
      x"00000102", x"00000000", x"00000500", 20);
    tick; dispatch_valid<='0'; wait for 1 ns;
    assert bus_request_valid='0' and bus_response_ready='0' and selected_completion_valid='0'
      report "misaligned LH completed before the pending-to-LSU edge" severity failure;
    tick; wait for 1 ns;
    assert bus_request_valid='0' and bus_response_ready='0' and selected_completion_valid='0'
      report "misaligned LH became selected before the LSU-to-pending edge" severity failure;
    tick; wait for 1 ns;
    assert bus_request_valid='0' and bus_response_ready='0' and
      selected_completion_valid='1' and selected_completion_memory_trap_valid='1' and
      selected_completion_memory_trap_cause=x"00000004" and
      selected_completion_memory_trap_tval=x"00000101"
      report "misaligned LH did not complete locally without bus traffic" severity failure;
    downstream_ready<='1'; tick; downstream_ready<='0'; wait for 1 ns;
    assert selected_completion_valid='0' and protocol_fault='0'
      report "local misalignment completion did not consume cleanly" severity failure;
    finish;
  end process;
end architecture;
"""

fn run_runtime_lsu_clocked_ghdl() -> text:
    if not ghdl_available(): return "GHDL is required for the runtime LSU clocked integration gate"
    val config = CoreConfig.rv32()
    val bus = LsuConfig.xlen(32)
    val plan = riscv_scalar_decoder_plan(config.isa_profile).unwrap()
    val lb = plan.lookup(0xFFF10083).unwrap()
    val sb = plan.lookup(0xFE310FA3).unwrap()
    val lh = plan.lookup(0xFFF11083).unwrap()
    val entity_name = "runtime_lsu_clocked_ghdl_rv32"
    val graph = strict_riscv_scalar_runtime_lsu_composition(entity_name, config, bus)
    if graph.is_err(): return graph.err().unwrap()
    val emitted = compile_strict_riscv_scalar_runtime_lsu_vhdl(entity_name, config, bus)
    if not emitted.is_success(): return emitted.diagnostic
    val workdir = ghdl_unique_workdir(entity_name)
    if not workdir.?: return "could not create isolated GHDL work directory"
    val isolated = workdir.unwrap()
    val path = isolated + "/" + entity_name + ".vhd"
    val tb = runtime_lsu_clocked_tb(entity_name, graph.unwrap().decoded.row_width,
        exact_row(plan, 0xFFF10083), riscv_scalar_semantic_opcode(lb.semantic_operation), declared_width_is_32(lb),
        exact_row(plan, 0xFE310FA3), riscv_scalar_semantic_opcode(sb.semantic_operation), declared_width_is_32(sb),
        exact_row(plan, 0xFFF11083), riscv_scalar_semantic_opcode(lh.semantic_operation), declared_width_is_32(lh))
    if not vhdl_write_file(path, emitted.vhdl + "\n" + tb): return "could not write isolated GHDL fixture"
    val analyzed = ghdl_analyze_in(path, isolated)
    if not analyzed.success: return analyzed.stderr
    val elaborated = ghdl_elaborate_in(entity_name + "_tb", isolated)
    if not elaborated.success: return elaborated.stderr
    val ran = ghdl_run_in(entity_name + "_tb", Some("250ns"), isolated)
    if not ran.success: return ran.stderr
    ""

describe "clocked runtime scalar LSU composition VHDL protocol":
    slow_it "holds requests and completions, normalizes loads and stores, and faults closed":
        expect(run_runtime_lsu_clocked_ghdl()).to_equal("")
