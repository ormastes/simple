# Native probe: text literal locals, direct arguments, and literal returns
# must be boxed with their explicit byte lengths, including embedded NUL.

fn echo_text(value: text) -> text:
    value

fn return_text_literal() -> text:
    "C\0é"

fn has_expected_bytes(value: text, b0: i64, b1: i64, b2: i64, b3: i64) -> bool:
    val bytes = value.bytes()
    if bytes.len() != 4:
        return false
    bytes[0].to_i64() == b0 and
        bytes[1].to_i64() == b1 and
        bytes[2].to_i64() == b2 and
        bytes[3].to_i64() == b3

fn main() -> i64:
    if not has_expected_bytes("A\0é", 65, 0, 195, 169):
        print "text literal argument bytes mismatch"
        return 1

    val local_text = "A\0é"
    if not has_expected_bytes(local_text, 65, 0, 195, 169):
        print "text literal local bytes mismatch"
        return 2

    val argument_text = echo_text("B\0é")
    if not has_expected_bytes(argument_text, 66, 0, 195, 169):
        print "text literal function argument mismatch"
        return 3

    val returned_text = return_text_literal()
    if not has_expected_bytes(returned_text, 67, 0, 195, 169):
        print "text literal function return mismatch"
        return 4

    print "llvm typed text literal native probe: PASS"
    0
