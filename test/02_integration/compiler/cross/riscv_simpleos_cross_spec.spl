    it "links an RV32 shared object that exports xc_add for DlOpen":
        # NOTE: RED — BUG-XC-SHARED-LINK-DFLAG.
        step("build fixture")
        val out = xc_out(RV32, "so")
        expect(xc_build(RV32, "so", xc_fixture("lib"), out, "")).to_equal("")
