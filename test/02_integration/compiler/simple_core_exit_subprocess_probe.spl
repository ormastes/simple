extern fn fork() -> i64
extern fn waitpid(pid: i64, status: i64, options: i64) -> i64
extern fn calloc(count: i64, size: i64) -> i64
extern fn free(ptr: i64)
extern fn spl_load_i64(ptr: i64, offset: i64) -> i64
extern fn rt_exit(code: i64) -> i64
extern fn abort()

fn verify_exit_status(code: i64):
    val pid = fork()
    if pid < 0:
        abort()
    if pid == 0:
        rt_exit(code)
        # A canonical termination ABI never returns to the child.
        abort()
    val status = calloc(1, 8)
    if status < 1:
        abort()
    if waitpid(pid, status, 0) != pid:
        abort()
    val raw = spl_load_i64(status, 0)
    free(status)
    if (raw & 127) != 0:
        abort()
    if ((raw >> 8) & 255) != code:
        abort()

verify_exit_status(0)
verify_exit_status(23)
