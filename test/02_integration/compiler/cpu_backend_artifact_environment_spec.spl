"""
# CPU Backend Artifact Environment Matrix

Runs the real pure-Simple LLVM, Cranelift, and WebAssembly artifact checker.
Each backend reports every layer as `PASS`, `FAIL`, or
`SKIP_UNAVAILABLE(reason)`. Optional tool absence is visible and is never
renamed to a pass; release gates run the checker with `--require-all`.
"""

use std.spec.*
use std.io_runtime.*

describe "CPU backend artifact environment matrix":
    it "should retain validate link and execute real backend artifacts":
        step("emit backend IR")
        step("validate backend IR")
        step("emit object")
        step("validate object")
        step("link artifact")
        step("run or read back")
        val result = shell("sh scripts/check/check-cpu-backend-artifacts.shs --backend all")
        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_contain("backend=llvm")
        expect(result.stdout).to_contain("backend=cranelift")
        expect(result.stdout).to_contain("backend=wasm")
        expect(result.stdout.contains("status=FAIL")).to_equal(false)
        val accounted = (
            result.stdout.contains("cpu_backend_matrix status=PASS") or
            result.stdout.contains("cpu_backend_matrix status=SKIP_UNAVAILABLE")
        )
        expect(accounted).to_equal(true)
