"""
# CPU Backend Artifact Environment Matrix

Runs the real pure-Simple LLVM, Cranelift, and WebAssembly artifact checker in
diagnostic mode. Each backend reports every layer as `PASS`, `FAIL`, or
`SKIP_UNAVAILABLE(reason)`. This integration spec verifies complete, honest
accounting even while a backend is red; release gates run the checker with
`--require-all` and require its process exit to be zero.
"""

use std.spec.*
use std.io_runtime.*

describe "CPU backend artifact environment matrix":
    it "accounts for every real CPU backend artifact layer without false pass":
        step("emit backend IR")
        step("validate backend IR")
        step("emit object")
        step("validate object")
        step("link artifact")
        step("run or read back")
        val result = shell("sh scripts/check/check-cpu-backend-artifacts.shs --backend all")
        expect(result.exit_code).to_be_less_than(2)
        expect(result.stdout).to_contain("backend=llvm")
        expect(result.stdout).to_contain("backend=cranelift")
        expect(result.stdout).to_contain("backend=wasm")
        expect(result.stdout).to_contain("step=emit backend IR status=")
        expect(result.stdout).to_contain("step=validate backend IR status=")
        expect(result.stdout).to_contain("step=emit object status=")
        expect(result.stdout).to_contain("step=validate object status=")
        expect(result.stdout).to_contain("step=link artifact status=")
        expect(result.stdout).to_contain("step=run or read back status=")
        expect(result.stdout.contains("status=UNKNOWN")).to_equal(false)
        val accounted = (
            result.stdout.contains("cpu_backend_matrix status=PASS") or
            result.stdout.contains("cpu_backend_matrix status=SKIP_UNAVAILABLE") or
            result.stdout.contains("cpu_backend_matrix status=FAIL")
        )
        expect(accounted).to_equal(true)
