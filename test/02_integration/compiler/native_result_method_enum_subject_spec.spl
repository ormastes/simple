extern fn rt_process_run(program: text, args: [text]) -> (text, text, i64)

describe "Native method Result enum-subject recovery":
    it "should resolve an instance method Result despite colliding bare variants":
        val (stdout, stderr, status) = rt_process_run("sh", [
            "scripts/check/check-native-result-method-enum-subject.shs"
        ])
        expect(status).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("STATUS: PASS native-result-method-enum-subject")
        expect(stdout).to_contain("instance=31 static=47")
