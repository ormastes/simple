# @engine-reach: native-by-compile
extern fn rt_process_run(program: text, args: [text]) -> (text, text, i64)

describe "Native scalar metadata-copy integration":
    it "should append, update, and ignore a missing source":
        val (stdout, stderr, status) = rt_process_run("sh", ["scripts/check/check-native-scalar-metadata-copy.shs"])
        expect(status).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("STATUS: PASS scalar-metadata-copy")
        expect(stdout).to_contain("source=pass append=pass update=pass missing-source=pass")
