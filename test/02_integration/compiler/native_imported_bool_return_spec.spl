# @engine-reach: native-by-compile
"""Native cross-module bool-return ABI regression.

The checker uses the canonical fail-closed self-hosted identity gate. It
requires emitted LLVM to assign the imported i1 call result to an SSA value,
then executes the linked candidate to prove the caller consumed that value.
"""

use std.spec.{describe, expect, it}

extern fn rt_process_run(program: text, args: [text]) -> (text, text, i64)

describe "native imported boolean return ABI":
    it "compiles and executes an imported bool consumed by if-not":
        val (stdout, stderr, status) = rt_process_run("sh", [
            "scripts/check/check-native-imported-bool-return.shs"
        ])
        expect(status).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("STATUS: PASS native-imported-bool-return")
        expect(stdout).to_contain("call-result=i1-ssa")
        expect(stdout).to_contain("runtime=pass")
