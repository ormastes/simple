# Real CompilerDriver regression; requires an admitted full compiler test runtime.
# The bounded native gate probe does not constitute execution of this spec.
# Run without SIMPLE_BOOTSTRAP whole-program transform skipping.
use std.spec.{describe, it, expect}
use compiler.common.driver_core_types.{CompileResult, driver_core_compile_options_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_definitions.{HirAopAdvice}
use compiler.driver.driver.{CompilerDriver}

describe "AOP failures stop ordinary AOT publication":
    it "returns the first weave diagnostic before backend dispatch":
        var options = driver_core_compile_options_default()
        options.backend = "unsupported-aop-regression-backend"
        var driver = match CompilerDriver.create(options):
            case Ok(value): value
            case Err(reason): panic("CompilerDriver.create setup failed in aop_failure_publication_spec.spl: {reason}")
        driver.ctx.hir_aop_advices_saved = [HirAopAdvice(
            predicate_text: "unsupported_selector(*)",
            advice_function: "rejected_observer",
            form: "invalid_advice_form",
            priority: 0,
            span: Span(start: 0, end: 1, line: 1, col: 1,
                file: "aop_failure.spl", length: 1))]
        val result = driver.stage_emit_object()
        expect(driver.ctx.has_errors()).to_equal(true)
        expect(driver.ctx.error_message_at(0)).to_contain("[AOP]")
        match result:
            case CompileResult.CodegenError(message):
                expect(message).to_equal(driver.ctx.error_message_at(0))
            case _:
                expect(false).to_equal(true)
