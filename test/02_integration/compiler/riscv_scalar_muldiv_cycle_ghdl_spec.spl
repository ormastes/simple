use std.spec.*
use app.io.vhdl_ffi.{ghdl_available, ghdl_analyze, ghdl_elaborate,
    ghdl_run, vhdl_write_file}
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_scalar_muldiv_projection.{strict_riscv_scalar_muldiv_projection}
use compiler.mir.hwir.riscv_scalar_iterative_multiplier.{strict_riscv_scalar_iterative_multiplier}
use compiler.mir.hwir.riscv_scalar_iterative_divider.{strict_riscv_scalar_iterative_divider}
use compiler.backend.backend.hwir_to_vhdl.{render_strict_sequential_hwir}

fn rv32im() -> CoreConfig:
    CoreConfig(xlen: 32, physical_address_bits: 32, register_count: 32,
        profile: "riscv-gen2-rv32im", isa_profile: "rv32im",
        compressed_decode_profile: "none")

fn testbench(entity: text, instruction: u32, lhs_hex: text, rhs_hex: text,
    expected_hex: text) -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n" +
    "use std.env.all;\nentity " + entity + "_tb is end entity;\n" +
    "architecture sim of " + entity + "_tb is\n" +
    " signal clk,rst,dispatch_valid,dispatch_ready,completion_valid,completion_ready,protocol_fault: std_logic := '0';\n" +
    " signal rd_value: std_logic_vector(31 downto 0);\nbegin\n" +
    " clk <= not clk after 5 ns;\n" +
    " dut: entity work." + entity + " port map(" +
    "clk=>clk,rst=>rst,dispatch_valid=>dispatch_valid,dispatch_lineage_valid=>'1'," +
    "dispatch_event_id=>std_logic_vector(to_unsigned(7,64)),decode_event_id=>std_logic_vector(to_unsigned(7,64))," +
    "illegal_valid=>'0',dispatch_privilege=>\"11\",dispatch_original_instruction=>std_logic_vector(to_unsigned(" + instruction.to_text() + ",32))," +
    "dispatch_canonical_instruction=>std_logic_vector(to_unsigned(" + instruction.to_text() + ",32))," +
    "dispatch_instruction_length_bytes=>\"100\",dispatch_pc_before=>x\"00000100\",dispatch_pc_after=>x\"00000104\"," +
    "dispatch_rd=>\"00011\",rs1_index=>\"00001\",rs2_index=>\"00010\"," +
    "rs1_value=>x\"" + lhs_hex + "\",rs2_value=>x\"" + rhs_hex + "\"," +
    "completion_ready=>completion_ready,dispatch_ready=>dispatch_ready,completion_valid=>completion_valid," +
    "completion_decode_valid=>open,completion_event_id=>open,completion_decode_event_id=>open,completion_illegal_valid=>open," +
    "privilege=>open,original_instruction=>open,canonical_instruction=>open,instruction_length_bytes=>open," +
    "pc_before=>open,pc_after=>open,rd=>open,rd_write=>open,rd_value=>rd_value," +
    "memory_address=>open,memory_read_mask=>open,memory_write_mask=>open,memory_read_data=>open,memory_write_data=>open," +
    "execute_trap_valid=>open,execute_trap_cause=>open,execute_trap_tval=>open,memory_trap_valid=>open," +
    "memory_trap_cause=>open,memory_trap_tval=>open,redirect_valid=>open,redirect_target=>open,protocol_fault=>protocol_fault);\n" +
    " process variable seen: boolean := false; begin\n" +
    "  rst<='1'; wait until rising_edge(clk); wait until rising_edge(clk); rst<='0';\n" +
    "  assert dispatch_ready='1' report \"M owner not ready after reset\" severity failure;\n" +
    "  dispatch_valid<='1'; wait until rising_edge(clk); dispatch_valid<='0';\n" +
    "  for i in 0 to 80 loop wait until rising_edge(clk); if completion_valid='1' then\n" +
    "   assert rd_value=x\"" + expected_hex + "\" report \"M result mismatch\" severity failure;\n" +
    "   assert protocol_fault='0' report \"unexpected M protocol fault\" severity failure;\n" +
    "   seen:=true; exit; end if; end loop;\n" +
    "  assert seen report \"M completion timeout\" severity failure;\n" +
    "  wait until rising_edge(clk); assert completion_valid='1' and rd_value=x\"" + expected_hex +
    "\" report \"M completion changed under backpressure\" severity failure;\n" +
    "  wait until rising_edge(clk); assert completion_valid='1' and rd_value=x\"" + expected_hex +
    "\" report \"M completion was not held\" severity failure; completion_ready<='1';\n" +
    "  wait until rising_edge(clk);\n" +
    "  assert completion_valid='0' report \"M completion did not consume once\" severity failure; finish; end process;\n" +
    "end architecture;\n"

describe "RISC-V Gen2 iterative M cycle evidence":
    slow_it "simulates held RV32 multiply and divide completions when GHDL exists":
        if not ghdl_available():
            print "SKIP: GHDL not available"
            return
        val cfg = rv32im()
        for row in [("mul_cycle", 0x022081B3, "00000006", "00000007", "0000002A", "multiply"),
                ("mulh_signed_cycle", 0x022091B3, "FFFFFFFE", "00000003", "FFFFFFFF", "multiply"),
                ("mulhsu_cycle", 0x0220A1B3, "FFFFFFFE", "00000003", "FFFFFFFF", "multiply"),
                ("mulhu_cycle", 0x0220B1B3, "FFFFFFFF", "FFFFFFFF", "FFFFFFFE", "multiply"),
                ("div_cycle", 0x0220C1B3, "00000064", "00000007", "0000000E", "divide"),
                ("div_zero_cycle", 0x0220C1B3, "80000000", "00000000", "FFFFFFFF", "divide"),
                ("div_overflow_cycle", 0x0220C1B3, "80000000", "FFFFFFFF", "80000000", "divide"),
                ("divu_high_cycle", 0x0220D1B3, "FFFFFFFF", "80000000", "00000001", "divide"),
                ("rem_overflow_cycle", 0x0220E1B3, "80000000", "FFFFFFFF", "00000000", "divide"),
                ("rem_zero_cycle", 0x0220E1B3, "80000000", "00000000", "80000000", "divide")]:
            val projection = strict_riscv_scalar_muldiv_projection(cfg, "iterative", row[1]).unwrap()
            val module = if row[5] == "multiply":
                strict_riscv_scalar_iterative_multiplier(row[0], cfg, projection).unwrap()
            else:
                strict_riscv_scalar_iterative_divider(row[0], cfg, projection).unwrap()
            val emitted = render_strict_sequential_hwir(module,
                "hwir-gen2-scalar-muldiv-owner-v1")
            expect(emitted.is_success()).to_equal(true)
            if emitted.is_success():
                val path = "/tmp/" + row[0] + ".vhd"
                expect(vhdl_write_file(path, emitted.vhdl + "\n" +
                    testbench(row[0], row[1], row[2], row[3], row[4]))).to_equal(true)
                expect(ghdl_analyze(path).success).to_equal(true)
                expect(ghdl_elaborate(row[0] + "_tb").success).to_equal(true)
                expect(ghdl_run(row[0] + "_tb", Some("1us")).success).to_equal(true)
