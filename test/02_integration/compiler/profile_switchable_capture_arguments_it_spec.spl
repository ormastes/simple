use std.spec.*
use app.io.mod.{process_run_timeout}
use std.io_runtime.{file_exists, read_file_text}
use std.io.{file_write, file_delete, time_now_unix_micros}
use std.env.platform.{get_temp_dir}
use app.optimize.sprof_collection_profile.{sprof_source_module_identity, sprof_load_collection_profile_text}
use test.system.qualified_pure_simple_runtime.{admit_source_matched_pure_simple_runtime}

describe "pure Simple CLI collection capture arguments":
    it "executes the source with Unicode and empty arguments through real run dispatch":
        val binary = admit_source_matched_pure_simple_runtime()
        expect(binary != "").to_be(true)
        expect(file_exists(binary)).to_be(true)
        val stem = get_temp_dir() + "/simple_capture_arguments_{time_now_unix_micros()}"
        val source_path = "{stem}.spl"
        val profile_path = "{stem}.sprof"
        val source = [
            "use std.nogc_sync_mut.sffi.system.args_get",
            "use std.nogc_sync_mut.src.collections.adaptive_text_set.AdaptiveTextSet",
            "use std.nogc_sync_mut.src.collections.adaptive_text_set.AdaptiveSetAlgorithm",
            "fn before_args():",
            "    print \"ARGS_BEFORE\"",
            "fn after_args():",
            "    print \"ARGS_AFTER\"",
            r"on pc{ execution(* rt_get_args(..)) } use before_args before priority 10",
            r"on pc{ execution(* rt_get_args(..)) } use after_args after_success priority 10",
            "fn main():",
            "    val args = args_get()",
            "    assert(args.len() == 5)",
            "    assert(args[1] == \"--\")",
            "    assert(args[2] == \"\")",
            "    assert(args[3] == \"한글\")",
            "    assert(args[4] == \"--collection-target=application\")",
            "    @collection_algorithm(\"auto\")",
            "    var selected = AdaptiveTextSet.new()",
            "    val initial_hash = selected.selected_algorithm() == AdaptiveSetAlgorithm.Hash",
            "    print \"CAPTURE_INITIAL_HASH:\"",
            "    print initial_hash",
            "    selected.insert(\"key\")",
            "    for i in 0..40:",
            "        assert(selected.contains(\"key\"))",
            "    print \"CAPTURE_ARGUMENTS_OK\"",
            ""
        ].join("\n")
        expect(file_write(source_path, source)).to_be(true)
        val identity = sprof_source_module_identity(source_path)
        val (stdout, stderr, code) = process_run_timeout(binary, ["run", source_path,
            "--collection-profile-out={profile_path}", "--collection-workload=arguments",
            "--collection-target=test-target", "--", "", "한글", "--collection-target=application"], 60000)
        expect(code).to_equal(0)
        expect(stdout + stderr).to_contain("CAPTURE_ARGUMENTS_OK")
        expect(stdout).to_contain("ARGS_BEFORE\nARGS_AFTER")
        expect(stdout).to_contain("CAPTURE_INITIAL_HASH:\nfalse")
        val loaded = sprof_load_collection_profile_text(read_file_text(profile_path), identity, "arguments")
        expect(loaded.status).to_equal("loaded")
        expect(loaded.samples.len()).to_be_greater_than(0)
        val (replay_stdout, replay_stderr, replay_code) = process_run_timeout(binary, ["run", source_path,
            "--collection-profile={profile_path}", "--collection-module={identity}",
            "--collection-workload=arguments", "--collection-target=test-target",
            "--", "", "한글", "--collection-target=application"], 60000)
        expect(replay_code).to_equal(0)
        expect(replay_stdout + replay_stderr).to_contain("CAPTURE_ARGUMENTS_OK")
        expect(replay_stdout).to_contain("ARGS_BEFORE\nARGS_AFTER")
        expect(replay_stdout).to_contain("CAPTURE_INITIAL_HASH:\ntrue")
        expect(file_delete(source_path)).to_be(true)
        expect(file_delete(profile_path)).to_be(true)
