# Regression for the source-only generic-return workaround.
# Every case rejects before filesystem access; existing publication probes cover
# successful transactions, generation corruption, and atomic publication.
use compiler.driver.cache.cas_batch_transaction.{CasBatchTransactionErrorV1, cas_batch_begin_v1}

fn rejects_incomplete(root: text, scc: text, keys: [text]) -> bool:
    val result = cas_batch_begin_v1(root, "", scc, keys)
    if not result.is_err():
        return false
    match result.unwrap_err():
        case CasBatchTransactionErrorV1.incomplete_scc:
            true
        case _:
            false

fn main() -> i64:
    assert(rejects_incomplete("", "scc", ["pkg"]))
    assert(rejects_incomplete("unused", "", ["pkg"]))
    assert(rejects_incomplete("unused", "scc", []))
    assert(rejects_incomplete("unused", "scc", ["pkg", "pkg"]))
    assert(rejects_incomplete("unused", "scc", ["bad|key"]))
    assert(rejects_incomplete("unused", "scc", ["bad\nkey"]))
    print "cas-concrete-error: 6 checks passed"
    0
