# @req REQ-SSPEC-INTEGRATION
# @cover src/compiler/50.mir/mir_lowering_stmts.spl
# @cover src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl
"""Native execution regression spec for `if val` on `text?` and `[i64]?`."""

use std.spec.{describe, it, expect}

fn nil_text_fn() -> text?:
    nil

fn some_text_fn() -> text?:
    Some("hello")

fn nil_arr_fn() -> [i64]?:
    nil

fn some_arr_fn() -> [i64]?:
    Some([10, 20])

describe "if val on Optional text and array":
    it "does not enter then branch when text? function returns nil":
        var entered = false
        if val s = nil_text_fn():
            entered = s.len() >= 0
        expect(entered).to_equal(false)

    it "yields hello when text? function returns Some":
        var got = ""
        if val s = some_text_fn():
            got = s
        expect(got).to_equal("hello")

    it "does not enter then branch when [i64]? function returns nil":
        var entered = false
        if val xs = nil_arr_fn():
            entered = xs.len() >= 0
        expect(entered).to_equal(false)

    it "yields array elements when [i64]? function returns Some":
        var sum = 0
        if val xs = some_arr_fn():
            sum = xs.len() + xs[0] + xs[1]
        expect(sum).to_equal(32)
