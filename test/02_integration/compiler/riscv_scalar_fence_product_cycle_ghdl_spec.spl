use std.spec.*
use app.io.vhdl_ffi.{ghdl_available, ghdl_analyze, ghdl_elaborate,
    ghdl_run, vhdl_write_file}
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.backend.backend.riscv_scalar_product_to_vhdl.{
    compile_strict_riscv_scalar_product}

fn fence_product_tb() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n" +
    "entity scalar_fence_product_cycle_tb is end entity; architecture sim of scalar_fence_product_cycle_tb is\n" +
    " signal clk,rst,dispatch_valid,effect_ready,retire_ready: std_logic := '0'; signal in_ready,effect_valid,retire_valid,retire_trap,retire_rd_write,protocol_fault: std_logic;\n" +
    " signal effect_kind: std_logic_vector(1 downto 0); signal fm,pred,succ: std_logic_vector(3 downto 0); begin clk<=not clk after 5 ns;\n" +
    " dut: entity work.scalar_fence_product_cycle port map(clk=>clk,rst=>rst,retire_ready=>retire_ready," +
    "illegal_valid=>'0',interrupt_valid=>'0',interrupt_cause=>(others=>'0'),interrupt_event_id=>(others=>'0')," +
    "provider_event_id=>std_logic_vector(to_unsigned(71,64)),decode_event_id=>std_logic_vector(to_unsigned(71,64))," +
    "interrupt_held=>'0',between_events=>'0',dispatch_valid=>dispatch_valid,dispatch_lineage_valid=>'1'," +
    "dispatch_privilege=>\"11\",dispatch_original_instruction=>x\"0FF0000F\",dispatch_canonical_instruction=>x\"0FF0000F\"," +
    "dispatch_instruction_length_bytes=>\"100\",dispatch_pc_before=>x\"00000100\",dispatch_pc_after=>x\"00000104\"," +
    "dispatch_rd=>\"00000\",dispatch_rs1=>\"00000\",fence_effect_ready=>effect_ready,in_ready=>in_ready," +
    "fence_effect_valid=>effect_valid,fence_effect_kind=>effect_kind,fence_fm=>fm,fence_pred=>pred,fence_succ=>succ," +
    "dispatch_accept=>open,retire_valid=>retire_valid,retire_order=>open,protocol_fault=>protocol_fault," +
    "retire_xlen=>open,retire_privilege=>open,retire_original_instruction=>open,retire_canonical_instruction=>open," +
    "retire_instruction_length_bytes=>open,retire_pc_before=>open,retire_pc_after=>open,retire_rd=>open," +
    "retire_rd_write=>retire_rd_write,retire_rd_value=>open,retire_memory_address=>open,retire_memory_read_mask=>open," +
    "retire_memory_write_mask=>open,retire_memory_read_data=>open,retire_memory_write_data=>open," +
    "retire_trap=>retire_trap,retire_interrupt=>open,retire_cause=>open,retire_tval=>open);\n" +
    " process begin rst<='1'; wait until rising_edge(clk); wait until rising_edge(clk); rst<='0'; wait for 1 ns;\n" +
    " assert in_ready='1' report \"fence product not ready\" severity failure; dispatch_valid<='1'; wait until rising_edge(clk); dispatch_valid<='0'; wait for 1 ns;\n" +
    " assert effect_valid='1' and retire_valid='0' and effect_kind=\"01\" and fm=\"0000\" and pred=\"1111\" and succ=\"1111\" report \"fence effect mismatch\" severity failure;\n" +
    " wait until rising_edge(clk); wait for 1 ns; assert effect_valid='1' and retire_valid='0' report \"fence retired before effect acceptance\" severity failure;\n" +
    " effect_ready<='1'; wait until rising_edge(clk); effect_ready<='0'; wait for 1 ns; assert effect_valid='0' report \"fence effect did not consume once\" severity failure;\n" +
    " for i in 0 to 5 loop exit when retire_valid='1'; wait until rising_edge(clk); wait for 1 ns; end loop;\n" +
    " assert retire_valid='1' and retire_trap='0' and retire_rd_write='0' report \"fence retirement mismatch\" severity failure;\n" +
    " wait until rising_edge(clk); wait for 1 ns; assert retire_valid='1' and effect_valid='0' report \"fence retirement not held or effect repeated\" severity failure;\n" +
    " retire_ready<='1'; wait until rising_edge(clk); retire_ready<='0'; wait for 1 ns; assert retire_valid='0' and protocol_fault='0' report \"fence retirement did not consume once\" severity failure; finish; end process; end architecture;\n"

describe "RISC-V Gen2 integrated FENCE product cycle evidence":
    # @req REQ-G2-012 REQ-G2-017 NFR-G2-018
    slow_it "acknowledges one effect before one retirement through the closed product when GHDL exists":
        if not ghdl_available():
            print "SKIP: GHDL not available"
            return
        val emitted = compile_strict_riscv_scalar_product("scalar_fence_product_cycle",
            CoreConfig.rv32(), 0x0FF0000F, LsuConfig.rv32_product_default())
        expect(emitted.is_success()).to_equal(true)
        if emitted.is_success():
            val path = "/tmp/scalar_fence_product_cycle.vhd"
            expect(vhdl_write_file(path, emitted.vhdl + "\n" + fence_product_tb())).to_equal(true)
            expect(ghdl_analyze(path).success).to_equal(true)
            expect(ghdl_elaborate("scalar_fence_product_cycle_tb").success).to_equal(true)
            expect(ghdl_run("scalar_fence_product_cycle_tb", Some("500ns")).success).to_equal(true)
