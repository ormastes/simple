# codex-system-test
# E5-001 acceptance: serialized policy -> snapshot -> catalog -> generation ->
# artifact -> callable evidence. This is an integration contract, not a source
# scan or a claim that an optimized artifact exists on this host.
# @evidence-class integration

use std.spec.{describe, it, step, fail}

fn collect_policy_sources():
    fail("MissingEvidence:E5-001:policy-source owner receipt; resume after E1/E2/E3 exact revisions are admitted")

fn resolve_policy_and_ceiling():
    fail("MissingEvidence:E5-001:policy/snapshot/catalog join; resume after trusted E2 host and catalog receipts exist")

fn probe_execution_domain():
    fail("MissingEvidence:E5-001:execution-domain probe; resume on a qualified self-hosted native runner")

fn admit_exact_provider():
    fail("MissingEvidence:E5-001:sealed provider/artifact admission; source metadata is not executable evidence")

fn pin_selected_generation():
    fail("MissingEvidence:E5-001:generation pin receipt; resume after E3 startup owner issues a durable pin")

fn execute_bounded_region():
    fail("MissingEvidence:E5-001:callable execution/parity receipt; a compiled artifact alone is insufficient")

fn validate_completion_receipt():
    fail("MissingEvidence:E5-001:completion receipt; resume after owner-issued output and scalar parity evidence")

fn drain_and_retire():
    fail("MissingEvidence:E5-001:retirement receipt; resume after old-generation drain is measured")

describe "E5-001 serialized environment activation [importance=critical; importance_weight=3]":
    it "E5-001 should bind reference startup to an exact policy and environment receipt [importance=critical; importance_weight=3]":
        # @req REQ-006
        # @req REQ-014
        step("Collect policy sources and resolve the effective ceiling")
        collect_policy_sources()
        resolve_policy_and_ceiling()
        probe_execution_domain()
        fail("MissingEvidence:E5-001:reference startup integration receipt; evidence-class=integration")

    it "E5-001 should preserve scalar parity for an admitted x86 variant [importance=critical; importance_weight=3]":
        # @req REQ-002
        # @req REQ-003
        # @req REQ-010
        step("Admit one exact artifact, pin its generation, and compare with scalar")
        admit_exact_provider()
        pin_selected_generation()
        execute_bounded_region()
        validate_completion_receipt()

    it "E5-001 should reject stale or copied activation receipts [importance=critical; importance_weight=3]":
        # @req REQ-004
        # @req REQ-006
        # @req REQ-014
        step("Replace the provider generation and validate the old receipt")
        pin_selected_generation()
        fail("MissingEvidence:E5-001:stale-receipt invalidation owner; no copied handle may authorize a call")
        drain_and_retire()
