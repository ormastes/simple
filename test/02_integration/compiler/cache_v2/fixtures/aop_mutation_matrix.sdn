aop_invalidation_matrix:
    - change: "Advice body, symbolic call"
      candidate_index: "no"
      selection: "no"
      weave_target: "no"
      advice_artifact: "yes"
      link_load: "yes"
    - change: "Advice body, statically embedded"
      candidate_index: "no"
      selection: "no"
      weave_target: "affected_targets"
      advice_artifact: "yes"
      link_load: "yes"
    - change: "Advice signature/form/effects"
      candidate_index: "no"
      selection: "affected_pointcuts"
      weave_target: "affected_targets"
      advice_artifact: "yes"
      link_load: "yes"
    - change: "Advice priority/order contract"
      candidate_index: "no"
      selection: "affected_pointcuts"
      weave_target: "targets_whose_order_changed"
      advice_artifact: "maybe"
      link_load: "yes"
    - change: "Pointcut query"
      candidate_index: "maybe_new_partitions"
      selection: "that_pointcut"
      weave_target: "selection_delta_targets"
      advice_artifact: "no"
      link_load: "yes"
    - change: "Pointcut public scope/visibility"
      candidate_index: "relevant_partitions"
      selection: "that_pointcut_and_importers"
      weave_target: "selection_delta_targets"
      advice_artifact: "no"
      link_load: "yes"
    - change: "Target private body"
      candidate_index: "no_when_descriptor_unchanged"
      selection: "no"
      weave_target: "recompile_target_body_preserve_selection"
      advice_artifact: "no"
      link_load: "yes"
    - change: "Target signature/attribute/effect"
      candidate_index: "one_descriptor_leaf"
      selection: "pointcuts_reading_changed_fields"
      weave_target: "if_selection_or_descriptor_changed"
      advice_artifact: "no"
      link_load: "yes"
    - change: "New matching public target"
      candidate_index: "one_leaf_or_path"
      selection: "applicable_pointcuts"
      weave_target: "new_target"
      advice_artifact: "no"
      link_load: "yes"
    - change: "New imported aspect"
      candidate_index: "visible_aspect_catalog_root"
      selection: "affected_scopes"
      weave_target: "selection_delta_targets"
      advice_artifact: "new_advice"
      link_load: "yes"
    - change: "Runtime enable/disable"
      candidate_index: "no"
      selection: "precomputed_plan_unchanged"
      weave_target: "no_static_reweave"
      advice_artifact: "no"
      link_load: "session_generation_only"
