"""Regression for interpreter caller-local mutation surviving imported calls."""

use std.spec.*
use .fixtures.cross_module_mutation_owner.{CrossModuleMutationProbe}
use .fixtures.cross_module_mutation_foreign.{unrelated_foreign_call, nested_imported_advance}

describe "interpreter cross-module local mutation clobber":
    it "keeps a locally mutated receiver after an unrelated imported call":
        var probe = CrossModuleMutationProbe.initial()
        expect(probe.advance()).to_equal(2)
        expect(probe.generation).to_equal(2)

        expect(unrelated_foreign_call(40)).to_equal(41)
        expect(probe.generation).to_equal(2)

    it "keeps a receiver mutation made through a nested imported call":
        var probe = CrossModuleMutationProbe.initial()
        expect(nested_imported_advance(probe)).to_equal(2)
        expect(probe.generation).to_equal(2)
