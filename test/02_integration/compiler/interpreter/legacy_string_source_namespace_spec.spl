"""Exact legacy string calls and adjacent arbitrary-source namespaces."""
use std.spec.{describe, it, expect, step}
import string
use .fixtures.namespace_facade
use .fixtures.namespace_provider as selected_provider

fn transform(value: i64) -> i64:
    value - 100

describe "legacy source module namespaces":
    it "executes char_at from the root string source facade":
        step("Reproduce the exact failure")
        expect(string.char_at("hello", 1)).to_equal("e")
        expect(string.char_at("hello", 0)).to_equal("h")
        expect(string.str_char_at("hello", 4)).to_equal("o")
        expect(string.char_code("A")).to_equal(65)
        expect(string.str_repeat("ab", 3)).to_equal("ababab")

    it "executes both local and aliased re-export members of arbitrary source":
        step("Exercise the repaired owner")
        expect(namespace_facade.decorate("value")).to_equal("[value]")
        expect(namespace_facade.public_transform(7)).to_equal(22)
        expect(selected_provider.transform(8)).to_equal(25)
        expect(transform(7)).to_equal(-93)
