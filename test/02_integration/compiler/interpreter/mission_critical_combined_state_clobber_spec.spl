"""Regression for DrawIR mutation under the combined policy import closure."""

use std.spec.*
use common.mission_critical.draw_ir_generation_arena_v3.*
# These otherwise-unused imports are load-bearing: their combined declaration
# closure made a DrawIR receiver mutation disappear in the umbrella scenario.
use nogc_sync_mut.mission_critical.domain_arena_v1.*
use nogc_sync_mut.mission_critical.bounded_process_policy.*

fn admitted_draw_arena(arena_id: u64) -> DrawIrGenerationArenaV3:
    val counts = draw_ir_generation_count_v3(
        2u32, 1u32, 1u32, 1u32, 1u32, 2u32)
    val outcome = draw_ir_generation_plan_v3(
        arena_id, 1u64, counts, 8u64, 64u64, 8u64)
    var arena = DrawIrGenerationArenaV3.bounded(arena_id, 64u64, 8u64)
    match outcome:
        DrawIrPlanOutcomeV3.Planned(plan): arena.admit(plan)
        DrawIrPlanOutcomeV3.Refused(receipt): expect(receipt.reason).to_equal(0u16)
    expect(arena.seal(64u64, 8u64)).to_be_nil()
    arena

describe "interpreter combined mission-critical receiver state":
    it "keeps mutation when the mutating return is consumed inline":
        var arena = admitted_draw_arena(41u64)
        expect(arena.retire()).to_equal(true)
        expect(arena.next_generation).to_equal(2u64)

    it "keeps mutation when the mutating return is first bound":
        var arena = admitted_draw_arena(42u64)
        val retired = arena.retire()
        expect(retired).to_equal(true)
        expect(arena.next_generation).to_equal(2u64)
