"""Minimal regression: mutable class receiver returned from a plain helper."""

use std.spec.*
use common.mission_critical.draw_ir_generation_arena_v3.*

fn admitted_draw_arena_returned(arena_id: u64) -> DrawIrGenerationArenaV3:
    val counts = draw_ir_generation_count_v3(
        2u32, 1u32, 1u32, 1u32, 1u32, 2u32)
    val outcome = draw_ir_generation_plan_v3(
        arena_id, 1u64, counts, 8u64, 64u64, 8u64)
    var arena = DrawIrGenerationArenaV3.bounded(arena_id, 64u64, 8u64)
    match outcome:
        DrawIrPlanOutcomeV3.Planned(plan): arena.admit(plan)
        DrawIrPlanOutcomeV3.Refused(receipt): expect(receipt.reason).to_equal(0u16)
    expect(arena.seal(64u64, 8u64)).to_be_nil()
    arena

describe "interpreter returned DrawIR receiver":
    it "preserves mutation for a locally constructed adjacent control":
        val counts = draw_ir_generation_count_v3(
            2u32, 1u32, 1u32, 1u32, 1u32, 2u32)
        val outcome = draw_ir_generation_plan_v3(
            45u64, 1u64, counts, 8u64, 64u64, 8u64)
        var arena = DrawIrGenerationArenaV3.bounded(45u64, 64u64, 8u64)
        match outcome:
            DrawIrPlanOutcomeV3.Planned(plan): arena.admit(plan)
            DrawIrPlanOutcomeV3.Refused(receipt): expect(receipt.reason).to_equal(0u16)
        expect(arena.seal(64u64, 8u64)).to_be_nil()
        expect(arena.retire()).to_equal(true)
        expect(arena.next_generation).to_equal(2u64)

    it "preserves mutation after a helper returns the receiver":
        var arena = admitted_draw_arena_returned(44u64)
        expect(arena.retire()).to_equal(true)
        expect(arena.next_generation).to_equal(2u64)
