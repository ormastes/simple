use std.spec.*
use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

describe "interpreter and loader package-image production entrypoints":
    it "exports interpreter package loading only through its facade":
        step("exports interpreter package loading only through its facade")
        val exports = rt_file_read_text(
            "src/compiler/95.interp/load_facade/__init__.spl") ?? ""
        expect(exports).to_contain("interpreter_load_from_package_v1")
        expect(exports).to_contain("interpreter_load_facade_v1")

    it "admits provider metadata before consuming the pinned loader capability":
        step("admits provider metadata before consuming the pinned loader capability")
        val source = rt_file_read_text(
            "src/compiler/99.loader/runtime/package_image_entrypoint.spl") ?? ""
        expect(source).to_contain("provider_admit_metadata_v1")
        expect(source).to_contain("package_image_to_loader_contract_v1")
        expect(source).to_not_contain("provider_execution_ticket_v1")

    it "does not accept paths or private loader implementation imports":
        step("does not accept paths or private loader implementation imports")
        val source = rt_file_read_text(
            "src/compiler/99.loader/runtime/package_image_entrypoint.spl") ?? ""
        expect(source).to_not_contain("archive_path")
        expect(source).to_not_contain("read_file")
        expect(source).to_not_contain("SmfReaderImpl.open")
        expect(source).to_not_contain("compiler.loader.loader.")
