use compiler.common.driver_compile_options.{driver_core_compile_options_default}
use compiler.driver.driver_types.{CompileContext}

fn main() -> i32:
    # This deliberately imports the same compiler closure as the exact probe
    # while replacing only `error_count()` with its canonical scalar owner.
    # It distinguishes a crash caused by the closure/add_error path from one
    # introduced specifically by the accessor receiver.
    var ctx: CompileContext = CompileContext.create(driver_core_compile_options_default())
    ctx.add_error("first")
    ctx.add_error("second")
    val scalar_ok = ctx.error_count_value == 2
    print "stage3_compile_context_scalar_control={scalar_ok}"
    if scalar_ok:
        return 0
    1
