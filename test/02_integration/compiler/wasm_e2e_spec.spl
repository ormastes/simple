# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# WASM End-to-End Compilation Test
#
# Validates the full pipeline: .spl source → MIR → WAT output.
# Checks that the generated WAT is structurally valid.
#
# @mode: native

use std.spec.step

use compiler.backend.backend.backend_types.{BackendKind, CodegenTarget, BackendCompileOptions, OptimizationLevel, compileoptions_default_options}
use compiler.backend.wasm_codegen_adapter.{WasmCodegenAdapter}
use compiler.backend.codegen_types.{Codegen}
use compiler.mir.mir_data.{MirModule}

fn _wasm32_options() -> BackendCompileOptions:
    var options = compileoptions_default_options()
    options.target = CodegenTarget.Wasm32
    options.opt_level = OptimizationLevel.None_
    options.verify_output = false
    options

describe "WASM E2E Compilation":
    # @manual scenario evidence

    context "minimal module":
        it "compiles empty module to valid WAT":
            # @req REQ-SSPEC-INTEGRATION
            step("compiles empty module to valid WAT")
            val options = _wasm32_options()
            var adapter = WasmCodegenAdapter(options: options)

            # Create minimal MIR module
            val module = MirModule(
                name: "test_module",
                functions: {},
                statics: {},
                constants: {},
                types: {}
            )

            val result = adapter.compile_module(module)
            match result:
                case Ok(output):
                    val wat = output.text_output
                    expect(wat).to_contain("(module")
                case Err(err):
                    expect("compilation failed: {err.message}").to_equal("")

    context "target support":
        it "supports Wasm32 target":
            # @req REQ-SSPEC-INTEGRATION
            step("supports Wasm32 target")
            val options = _wasm32_options()
            var adapter = WasmCodegenAdapter(options: options)
            expect(adapter.supports_target(CodegenTarget.Wasm32)).to_equal(true)

        it "rejects non-WASM targets":
            # @req REQ-SSPEC-INTEGRATION
            step("rejects non-WASM targets")
            val options = _wasm32_options()
            var adapter = WasmCodegenAdapter(options: options)
            expect(adapter.supports_target(CodegenTarget.X86_64)).to_equal(false)

        it "reports correct backend kind":
            # @req REQ-SSPEC-INTEGRATION
            step("reports correct backend kind")
            val options = _wasm32_options()
            var adapter = WasmCodegenAdapter(options: options)
            expect(adapter.backend_name()).to_equal("wasm")
