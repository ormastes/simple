# REQ-MC-008 B2 staged source producer: runtime and docgen UNRUN.
use std.spec.{describe, it, expect, step}
use compiler.semantics.symbol_id.semantic_link.{SemanticLinkFailureV1, SemanticLinkErrorV1, parse_semantic_link_v1}
use compiler.semantics.symbol_id.semantic_link_source.{open_semantic_link_document_v1, resolve_semantic_link_source_v1, semantic_link_document_uri_v1, semantic_link_document_collision_check_v1}
use compiler.semantics.symbol_id.stable_id.{SymbolComponents, stable_symbol_id, format_short_link}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io_runtime.{file_write, file_delete, getpid, time_now_unix_micros}
use std.env.platform.{get_temp_dir}

fn semantic_source_fixture(source: text) -> text:
    val path = get_temp_dir() + "/semantic-link-{getpid()}-{time_now_unix_micros()}.spl"
    expect(file_write(path, source)).to_equal(true)
    return path

fn semantic_source_failure<T>(result: Result<T, SemanticLinkErrorV1>) -> SemanticLinkFailureV1:
    match result:
        case Err(error): error.failure
        case Ok(_): panic("expected a typed semantic link refusal")

describe "revision-bound parsed semantic document links":
    it "should parse a real file and round-trip both selected URI forms through B1":
        step("Load an exact source revision with the checked core parser")
        val source = "fn increment(value: i64) -> i64:\n    value + 1\n"
        val path = semantic_source_fixture(source)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("ormastes.simple", "sample.math", path, revision).unwrap()
        expect(document.declarations.len()).to_equal(1)
        val expected = SymbolComponents(package: "ormastes.simple", module_path: "sample.math", item_kind: "fn", owner_id: "", name: "increment", signature: "fn increment(value: i64) -> i64")
        expect(document.declarations[0].full_id).to_equal(stable_symbol_id(expected))
        step("Resolve both formatter-produced links to copied parsed facts")
        val short = semantic_link_document_uri_v1(document, 0, false).unwrap()
        expect(short).to_equal(format_short_link(expected, stable_symbol_id(expected)))
        val long = semantic_link_document_uri_v1(document, 0, true).unwrap()
        expect(long).to_start_with("spl://ormastes.simple/sample.math#fn:increment~")
        val target = resolve_semantic_link_source_v1(short, document, revision).unwrap()
        expect(resolve_semantic_link_source_v1(long, document, revision).unwrap().full_id).to_equal(target.full_id)
        expect(target.file).to_equal(path)
        expect(target.start).to_equal(0)
        expect(target.line).to_equal(1)
        expect(target.column).to_equal(1)
        expect(target.end).to_be_greater_than(target.start)
        expect(file_delete(path)).to_equal(true)

    it "should refuse an incorrect requested revision before indexing":
        step("Use actual source with a different valid SHA256 request")
        val path = semantic_source_fixture("fn value() -> i64:\n    1\n")
        expect(semantic_source_failure(open_semantic_link_document_v1("pkg", "sample", path, sha256_text("other")))).to_equal(SemanticLinkFailureV1.RevisionChanged)
        expect(file_delete(path)).to_equal(true)

    it "should refuse missing revision and invalid package authority":
        step("Metadata alone never supplies a source revision")
        val source = "fn value() -> i64:\n    1\n"
        val path = semantic_source_fixture(source)
        expect(semantic_source_failure(open_semantic_link_document_v1("pkg", "sample", path, ""))).to_equal(SemanticLinkFailureV1.InvalidAuthority)
        expect(semantic_source_failure(open_semantic_link_document_v1("", "sample", path, sha256_text(source)))).to_equal(SemanticLinkFailureV1.InvalidAuthority)
        expect(file_delete(path)).to_equal(true)

    it "should refuse a package-qualified URI for another package":
        step("Keep source and fingerprint fixed while changing URI authority")
        val source = "fn value() -> i64:\n    1\n"
        val path = semantic_source_fixture(source)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample", path, revision).unwrap()
        val uri = semantic_link_document_uri_v1(document, 0, true).unwrap().replace("spl://pkg/", "spl://other/")
        expect(semantic_source_failure(resolve_semantic_link_source_v1(uri, document, revision))).to_equal(SemanticLinkFailureV1.WrongPackage)
        expect(file_delete(path)).to_equal(true)

    it "should refuse disk edits after a snapshot was published":
        step("Modify the actual file after parse and keep the old requested revision")
        val source = "fn value() -> i64:\n    1\n"
        val path = semantic_source_fixture(source)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample", path, revision).unwrap()
        val uri = semantic_link_document_uri_v1(document, 0, false).unwrap()
        val changed = "fn value() -> i64:\n    2\n"
        expect(file_write(path, changed)).to_equal(true)
        expect(semantic_source_failure(resolve_semantic_link_source_v1(uri, document, revision))).to_equal(SemanticLinkFailureV1.RevisionChanged)
        expect(semantic_source_failure(resolve_semantic_link_source_v1(uri, document, sha256_text(changed)))).to_equal(SemanticLinkFailureV1.RevisionChanged)
        expect(file_delete(path)).to_equal(true)

    it "should keep identity but refresh location after a body and line change":
        step("Rebuild a changed revision and preserve signature-derived identity")
        val source = "fn value() -> i64:\n    1\n"
        val path = semantic_source_fixture(source)
        val first = open_semantic_link_document_v1("pkg", "sample", path, sha256_text(source)).unwrap()
        val uri = semantic_link_document_uri_v1(first, 0, false).unwrap()
        val changed = "# shifted\n\nfn value() -> i64:\n    2\n"
        expect(file_write(path, changed)).to_equal(true)
        val second = open_semantic_link_document_v1("pkg", "sample", path, sha256_text(changed)).unwrap()
        val target = resolve_semantic_link_source_v1(uri, second, sha256_text(changed)).unwrap()
        expect(target.full_id).to_equal(first.declarations[0].full_id)
        expect(target.line).to_equal(3)
        expect(target.start).to_be_greater_than(first.declarations[0].start)
        expect(file_delete(path)).to_equal(true)

    it "should reject the old fingerprint when a signature changes":
        step("A current name is insufficient to retarget an old signature")
        val source = "fn value() -> i64:\n    1\n"
        val path = semantic_source_fixture(source)
        val first = open_semantic_link_document_v1("pkg", "sample", path, sha256_text(source)).unwrap()
        val uri = semantic_link_document_uri_v1(first, 0, false).unwrap()
        val changed = "fn value() -> bool:\n    true\n"
        expect(file_write(path, changed)).to_equal(true)
        val second = open_semantic_link_document_v1("pkg", "sample", path, sha256_text(changed)).unwrap()
        expect(semantic_source_failure(resolve_semantic_link_source_v1(uri, second, sha256_text(changed)))).to_equal(SemanticLinkFailureV1.StaleFingerprint)
        expect(file_delete(path)).to_equal(true)

    it "should not use a valid fingerprint to resolve a different declaration name":
        step("Bind name and module as well as the B1 short fingerprint")
        val source = "fn first() -> i64:\n    1\nfn second() -> i64:\n    2\n"
        val path = semantic_source_fixture(source)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample", path, revision).unwrap()
        val uri = semantic_link_document_uri_v1(document, 0, false).unwrap()
        expect(semantic_source_failure(resolve_semantic_link_source_v1(uri.replace("sample.first", "sample.second"), document, revision))).to_equal(SemanticLinkFailureV1.StaleFingerprint)
        expect(semantic_source_failure(resolve_semantic_link_source_v1(uri.replace("sample.first", "sample.missing"), document, revision))).to_equal(SemanticLinkFailureV1.UnresolvedTarget)
        expect(semantic_source_failure(resolve_semantic_link_source_v1(uri.replace("sample.first", "other.first"), document, revision))).to_equal(SemanticLinkFailureV1.UnresolvedTarget)
        expect(file_delete(path)).to_equal(true)

    it "should refuse two parsed declarations claiming the same stable identity":
        step("Duplicate definition locations cannot collapse into B1 idempotence")
        val source = "fn duplicate() -> i64:\n    1\nfn duplicate() -> i64:\n    2\n"
        val path = semantic_source_fixture(source)
        expect(semantic_source_failure(open_semantic_link_document_v1("pkg", "sample", path, sha256_text(source)))).to_equal(SemanticLinkFailureV1.AmbiguousTarget)
        expect(file_delete(path)).to_equal(true)

    it "should discriminate overload identities using the supplied fingerprint":
        step("Two same-name primitive signatures retain distinct B1 identities")
        val source = "fn choose(value: i64) -> i64:\n    value\nfn choose(value: bool) -> bool:\n    value\n"
        val path = semantic_source_fixture(source)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample", path, revision).unwrap()
        expect(document.declarations.len()).to_equal(2)
        for i in 0..2:
            val uri = semantic_link_document_uri_v1(document, i, false).unwrap()
            expect(resolve_semantic_link_source_v1(uri, document, revision).unwrap().full_id).to_equal(document.declarations[i].full_id)
        expect(file_delete(path)).to_equal(true)

    it "should refuse real parsed identities colliding at the existing B1 test seam":
        step("Seventeen parsed declarations force a one-hex prefix collision")
        var source = ""
        for i in 0..17:
            source = source + "fn item{i}() -> i64:\n    {i}\n"
        val path = semantic_source_fixture(source)
        val document = open_semantic_link_document_v1("pkg", "sample", path, sha256_text(source)).unwrap()
        expect(document.declarations.len()).to_equal(17)
        expect(semantic_source_failure(semantic_link_document_collision_check_v1(document, 1))).to_equal(SemanticLinkFailureV1.FingerprintCollision)
        expect(semantic_link_document_collision_check_v1(document, 12).is_ok()).to_equal(true)
        expect(file_delete(path)).to_equal(true)

    it "should copy declaration facts before another parse replaces the arena":
        step("Publish two independent source snapshots and resolve the first afterward")
        val first_source = "fn original() -> i64:\n    4\n"
        val second_source = "fn replacement() -> bool:\n    true\n"
        val first_path = semantic_source_fixture(first_source)
        val second_path = semantic_source_fixture(second_source)
        val first = open_semantic_link_document_v1("pkg", "first", first_path, sha256_text(first_source)).unwrap()
        val uri = semantic_link_document_uri_v1(first, 0, false).unwrap()
        val second = open_semantic_link_document_v1("pkg", "second", second_path, sha256_text(second_source)).unwrap()
        expect(second.declarations[0].symbol.name).to_equal("replacement")
        val target = resolve_semantic_link_source_v1(uri, first, sha256_text(first_source)).unwrap()
        expect(target.symbol.name).to_equal("original")
        expect(target.file).to_equal(first_path)
        expect(target.symbol.signature).to_equal("fn original() -> i64")
        expect(file_delete(first_path)).to_equal(true)
        expect(file_delete(second_path)).to_equal(true)

    it "should reject malformed source rather than publish an empty success":
        step("Use the real checked parser's cross-module failure result")
        val source = "val broken: = 1\n"
        val path = semantic_source_fixture(source)
        expect(semantic_source_failure(open_semantic_link_document_v1("pkg", "sample", path, sha256_text(source)))).to_equal(SemanticLinkFailureV1.ParseFailed)
        expect(file_delete(path)).to_equal(true)

    it "should refuse generic unresolved and inferred signatures explicitly":
        step("Do not derive resolved identity by copying unresolved source spelling")
        val sources = ["fn identity<T>(value: T) -> T:\n    value\n", "fn unknown(value: Missing) -> i64:\n    1\n", "fn inferred(value):\n    value\n"]
        for source in sources:
            val path = semantic_source_fixture(source)
            expect(semantic_source_failure(open_semantic_link_document_v1("pkg", "sample", path, sha256_text(source)))).to_equal(SemanticLinkFailureV1.UnsupportedSignature)
            expect(file_delete(path)).to_equal(true)

    it "should reject unsupported kinds through a typed resolver result":
        step("Parsing a selected URI grammar does not imply producer support")
        val source = "fn value() -> i64:\n    1\n"
        val path = semantic_source_fixture(source)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample", path, revision).unwrap()
        val uri = semantic_link_document_uri_v1(document, 0, false).unwrap().replace("spl:fn@", "spl:type@")
        expect(semantic_source_failure(resolve_semantic_link_source_v1(uri, document, revision))).to_equal(SemanticLinkFailureV1.UnsupportedKind)
        expect(file_delete(path)).to_equal(true)

    it "should reject noncanonical URI syntax without fallback":
        step("Keep selected package grammar and B1 lowercase 12-hex encoding")
        val invalid = ["spl://fn/sample.value~0123456789abcdef0123456789abcdef", "spl:fn@sample.value~ABCDEF012345", "spl://pkg/sample#fn:value~0123456789ab?rev=1", "spl:fn@sample..value~0123456789ab", "spl:fn@sample.%76alue~0123456789ab"]
        for uri in invalid:
            expect(semantic_source_failure(parse_semantic_link_v1(uri))).to_equal(SemanticLinkFailureV1.InvalidUri)
        expect(semantic_source_failure(parse_semantic_link_v1("spl:fn@sample.value"))).to_equal(SemanticLinkFailureV1.MissingFingerprint)

    it "should refuse a file larger than the provider byte bound":
        step("Exercise actual bounded file admission before parsing")
        var source = "#"
        for i in 0..21:
            source = source + source
        val path = semantic_source_fixture(source)
        expect(semantic_source_failure(open_semantic_link_document_v1("pkg", "sample", path, sha256_text(source)))).to_equal(SemanticLinkFailureV1.IoFailed)
        expect(file_delete(path)).to_equal(true)

    it "should refuse a missing file instead of trusting a prior declaration":
        step("Remove the actual source after publishing its snapshot")
        val source = "fn value() -> i64:\n    1\n"
        val path = semantic_source_fixture(source)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample", path, revision).unwrap()
        val uri = semantic_link_document_uri_v1(document, 0, false).unwrap()
        expect(file_delete(path)).to_equal(true)
        expect(semantic_source_failure(resolve_semantic_link_source_v1(uri, document, revision))).to_equal(SemanticLinkFailureV1.IoFailed)

    it "should refuse conditional source transformations without an original span map":
        step("Do not attach shortened preprocessor offsets to the original revision")
        val sources = ["@cfg(true)\nfn active() -> i64:\n    1\n", "@when(true):\nfn active() -> i64:\n    1\n@end\n"]
        for source in sources:
            val path = semantic_source_fixture(source)
            expect(semantic_source_failure(open_semantic_link_document_v1("pkg", "sample", path, sha256_text(source)))).to_equal(SemanticLinkFailureV1.UnsupportedSourceTransform)
            expect(file_delete(path)).to_equal(true)

    it "should map both declaration spans to original UTF8 bytes before header lexing":
        step("Use multibyte characters before and inside the first declaration")
        val prefix = "# é😀\n"
        val first = "fn first() -> text:\n    \"😀\"\n"
        val second = "fn second() -> i64:\n    2\n"
        val source = prefix + first + second
        val path = semantic_source_fixture(source)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample", path, revision).unwrap()
        expect(document.declarations.len()).to_equal(2)
        val first_uri = semantic_link_document_uri_v1(document, 0, false).unwrap()
        val second_uri = semantic_link_document_uri_v1(document, 1, false).unwrap()
        val first_target = resolve_semantic_link_source_v1(first_uri, document, revision).unwrap()
        val second_target = resolve_semantic_link_source_v1(second_uri, document, revision).unwrap()
        expect(first_target.start).to_equal(prefix.len())
        expect(first_target.end).to_equal(prefix.len() + first.len())
        expect(second_target.start).to_equal(prefix.len() + first.len())
        expect(first_target.line).to_equal(2)
        expect(second_target.line).to_equal(4)
        expect(source.slice(first_target.start, first_target.start + 2)).to_equal("fn")
        expect(source.slice(second_target.start, second_target.start + 2)).to_equal("fn")
        expect(file_delete(path)).to_equal(true)

    it "should refuse collapsed integer type spellings instead of manufacturing i64 identity":
        step("Check exact written primitive types against copied flat type tags")
        val sources = ["fn narrow(value: u7) -> i64:\n    value\n", "fn narrow(value: i64) -> u7:\n    value\n"]
        for source in sources:
            val path = semantic_source_fixture(source)
            expect(semantic_source_failure(open_semantic_link_document_v1("pkg", "sample", path, sha256_text(source)))).to_equal(SemanticLinkFailureV1.UnsupportedSignature)
            expect(file_delete(path)).to_equal(true)

    it "should refuse richer headers until exact source provenance is implemented":
        step("A default expression is not silently treated as a plain primitive header")
        val source = "fn defaulted(value: i64 = 3) -> i64:\n    value\n"
        val path = semantic_source_fixture(source)
        expect(semantic_source_failure(open_semantic_link_document_v1("pkg", "sample", path, sha256_text(source)))).to_equal(SemanticLinkFailureV1.UnsupportedSignature)
        expect(file_delete(path)).to_equal(true)

    it "should refuse oversized formatter results using the shared URI admission":
        step("A real parsed declaration must not emit a URI its parser rejects")
        val source = "fn value() -> i64:\n    1\n"
        val path = semantic_source_fixture(source)
        var module_path = "a"
        for i in 0..12:
            module_path = module_path + module_path
        expect(module_path.len()).to_equal(4096)
        val document = open_semantic_link_document_v1("pkg", module_path, path, sha256_text(source)).unwrap()
        expect(semantic_source_failure(semantic_link_document_uri_v1(document, 0, false))).to_equal(SemanticLinkFailureV1.InvalidUri)
        expect(semantic_source_failure(semantic_link_document_uri_v1(document, 0, true))).to_equal(SemanticLinkFailureV1.InvalidUri)
        expect(file_delete(path)).to_equal(true)
