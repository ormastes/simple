use std.spec.*
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.file_ops.{file_exists, file_delete}
use std.common.crypto.sha256.{sha256_text}
use compiler.hir.hir_types.{HirModule, SymbolTable}
use compiler.driver.driver_hir_cache.{hir_cache_enabled, hir_cache_dir, hir_cache_key,
    hir_cache_path, hir_cache_store, hir_cache_load}

fn library_mode_cache_module(name: text, path: text) -> HirModule:
    HirModule(name: name, path: path, imports: [], exports: [], domain_blocks: [],
        symbols: SymbolTable.new(), functions: {}, gpu_function_targets: {},
        gpu_function_backend_orders: {}, classes: {}, structs: {}, enums: {},
        bitfields: {}, traits: {}, impls: [], constants: {}, static_asserts: [],
        aop_advices: [], di_bindings: [], arch_rules: [], mock_decls: [], types: [], extend_enums: [])

describe "request-owned library mode cache isolation":
    it "stores and reloads interleaved modes in one real private cache":
        step("stores and reloads interleaved modes in one real private cache")
        # Coordinator provisions a fresh private cache and genuine producer
        # identity. Missing runtime fixture fails this case; never a skip/PASS.
        expect(env_get("SIMPLE_TEST_LIBRARY_MODE_CACHE_IO")).to_equal("1")
        expect(env_get("SIMPLE_HIR_CACHE_DIR") != "").to_equal(true)
        expect(hir_cache_dir()).to_equal(env_get("SIMPLE_HIR_CACHE_DIR"))
        expect(hir_cache_enabled()).to_equal(true)
        val source = "test/fixtures/compiler/library_mode_selection/src/app/entry.spl"
        val closure = sha256_text("library-mode-cache-io-fixture-v1")
        val sync = hir_cache_key(source, closure, true, "nogc-sync-mut")
        val gc = hir_cache_key(source, closure, true, "gc-sync-mut")
        val legacy = hir_cache_key(source, closure, true)
        for key in [sync, gc, legacy]:
            expect(key.len()).to_equal(64)
            expect(file_exists(hir_cache_path(key))).to_equal(false)
        expect(hir_cache_store(sync, library_mode_cache_module("nogc_sync_owner", source), [], "", "nogc-sync-mut")).to_equal(true)
        val first = hir_cache_load(sync, "", source, "nogc-sync-mut")
        expect(first != nil).to_equal(true)
        expect(first!.name).to_equal("nogc_sync_owner")
        expect(hir_cache_load(sync, "", source, "gc-sync-mut")).to_be_nil()
        expect(hir_cache_load(sync, "", source)).to_be_nil()
        expect(hir_cache_store(gc, library_mode_cache_module("gc_sync_owner", source), [], "", "gc-sync-mut")).to_equal(true)
        val second = hir_cache_load(gc, "", source, "gc-sync-mut")
        expect(second != nil).to_equal(true)
        expect(second!.name).to_equal("gc_sync_owner")
        val repeated = hir_cache_load(sync, "", source, "nogc-sync-mut")
        expect(repeated != nil).to_equal(true)
        expect(repeated!.name).to_equal("nogc_sync_owner")
        expect(hir_cache_store(legacy, library_mode_cache_module("legacy_owner", source), [])).to_equal(true)
        val old = hir_cache_load(legacy, "", source)
        expect(old != nil).to_equal(true)
        expect(old!.name).to_equal("legacy_owner")
        expect(hir_cache_load(legacy, "", source, "nogc-sync-mut")).to_be_nil()
        for key in [sync, gc, legacy]: expect(file_delete(hir_cache_path(key))).to_equal(true)
