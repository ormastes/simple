# Native behavioral regression for required MC/DC decision-token locals.
# Compile with the admitted pure producer and run the resulting native binary.
# A malformed Copy(nil) must fail here or in the real MIR verifier, never pass.
use .mir_function_scratch_scope_probe.{check_mir_function_scratch_scope}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_verify.{mir_verify_module}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirConst}
use compiler.mir._MirLowering.module_lowering.{runtime_module_initializers_in_declaration_order}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.common.diagnostics.span.{Span}

fn probe_call_name(operand: MirOperand) -> text:
    match operand.kind:
        case MirOperandKind.Const(value, type_):
            match value:
                case MirConstValue.Str(name): return name
                case _: return ""
        case _: return ""

fn check_mcdc_token(mode: i64, path: text = "mcdc_required_token.spl",
        include_csv: text = "", exclude_csv: text = "", eligible: bool = true, logical_op: text = "and") -> bool:
    val source = "fn check(a: bool, b: bool) -> bool:\n    if a {logical_op} b:\n        true\n    else:\n        false\n"
    val ast = parse_full_frontend(source, path, path, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(path)
    val hir = hir_lowering.lower_module(ast)
    var lowering = MirLowering.new(hir.symbols)
    # Missing constructor fields become NIL on the native lane, not zero.
    if lowering.mcdc_mode != 0 or lowering.mcdc_active_decision_id != 0 or
            lowering.mcdc_next_condition_ordinal != 0 or lowering.mcdc_next_runtime_id != 1 or
            lowering.mcdc_active_dynamic_token.id != -1 or lowering.mcdc_active_tokens.len() != 0:
        return false
    lowering.configure_mcdc_mode(mode, include_csv: include_csv, exclude_csv: exclude_csv)
    val mir = lowering.lower_module(hir)
    if lowering.mcdc_active_decision_id != 0 or lowering.mcdc_active_dynamic_token.id != -1 or
            lowering.mcdc_active_tokens.len() != 0:
        return false
    # Exercise the exact verifier that crashed in the real bootstrap receiver.
    val report = mir_verify_module(mir)
    if report.fatal_count() != 0 or report.functions_checked == 0:
        return false
    val prefix = if mode == 2:
        "lib.nogc_sync_mut.mcdc.dynamic_probe.mcdc_dynamic_probe_"
    else:
        "lib.nogc_sync_mut.mcdc.static_probe.mcdc_static_probe_"
    var found = false
    for function in mir.functions.values():
        if function.name != "check" and not function.name.ends_with(".check"):
            continue
        found = true
        var token = -1
        var begins = 0
        var conditions = 0
        var ends = 0
        var masks = 0
        var all_probes = 0
        for block in function.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case MirInstKind.Call(dest, callee, args):
                        val name = probe_call_name(callee)
                        # Bare names cannot link to the Pure-Simple owner.
                        if name.starts_with("mcdc_"): return false
                        if name.starts_with("lib.nogc_sync_mut.mcdc."):
                            all_probes = all_probes + 1
                        if name == prefix + "begin":
                            begins = begins + 1
                            if args.len() != 1: return false
                            if val local = dest:
                                token = local.id
                            else:
                                return false
                    case _: ()
        if mode == 0 or not eligible:
            if all_probes != 0: return false
            continue
        if begins != 1 or token < 0: return false
        for block in function.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case MirInstKind.Call(dest, callee, args):
                        val name = probe_call_name(callee)
                        var expected_args = 0
                        if name == prefix + "condition":
                            conditions = conditions + 1
                            expected_args = 3
                        elif name == prefix + "end":
                            ends = ends + 1
                            expected_args = 2
                        elif name == prefix + "mask_range":
                            masks = masks + 1
                            expected_args = 5
                        if expected_args > 0:
                            if args.len() != expected_args: return false
                            match args[0].kind:
                                case MirOperandKind.Copy(local):
                                    if local.id != token: return false
                                case _: return false
                    case _: ()
        if conditions != 2 or ends != 1 or masks == 0: return false
    found

pub fn check_mcdc_shared_lowerer(mode: i64) -> bool:
    # Real nested conditional: the outer decision remains active while the
    # inner decision closes. Following functions must inherit no token locals.
    val path = "mcdc_nested_stack.spl"
    val source = "fn nested(a: bool, b: bool, c: bool) -> bool:\n    if (if a: b else: c):\n        return true\n    return false\n\nfn following() -> bool:\n    return true\n"
    val ast = parse_full_frontend(source, path, path, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(path)
    val hir = hir_lowering.lower_module(ast)
    var lowering = MirLowering.new(hir.symbols)
    lowering.configure_mcdc_mode(mode)
    val mir = lowering.lower_module(hir)
    if lowering.mcdc_active_tokens.len() != 0 or lowering.mcdc_active_decision_id != 0:
        return false
    val report = mir_verify_module(mir)
    if report.fatal_count() != 0 or report.functions_checked != 2: return false
    val prefix = if mode == 2:
        "lib.nogc_sync_mut.mcdc.dynamic_probe.mcdc_dynamic_probe_"
    else:
        "lib.nogc_sync_mut.mcdc.static_probe.mcdc_static_probe_"
    var found_nested = false
    var found_following = false
    for function in mir.functions.values():
        val nested = function.name == "nested" or function.name.ends_with(".nested")
        val following = function.name == "following" or function.name.ends_with(".following")
        if nested: found_nested = true
        if following: found_following = true
        var begins: [i64] = []
        var ends: [i64] = []
        for block in function.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case MirInstKind.Call(dest, callee, args):
                        val name = probe_call_name(callee)
                        if name.starts_with("mcdc_"): return false
                        if following and name.starts_with("lib.nogc_sync_mut.mcdc."): return false
                        if name == prefix + "abort": return false
                        if name == prefix + "begin":
                            if val local = dest: begins = begins.push(local.id)
                            else: return false
                        if name == prefix + "end":
                            if args.len() != 2: return false
                            match args[0].kind:
                                case MirOperandKind.Copy(local): ends = ends.push(local.id)
                                case _: return false
                    case _: ()
        if nested:
            if begins.len() != 2 or ends.len() != 2: return false
            if begins[0] == begins[1] or ends[0] != begins[1] or ends[1] != begins[0]: return false
    if not found_nested or not found_following: return false
    # Reuse the identical lowering owner for an excluded runtime module.
    val excluded_path = "src/lib/nogc_sync_mut/mcdc/excluded_probe.spl"
    val excluded_ast = parse_full_frontend(
        "fn excluded(flag: bool) -> bool:\n    if flag: return true\n    return false\n",
        excluded_path, excluded_path, Logger(level: 0))
    var excluded_hir_lowering = HirLowering.with_filename(excluded_path)
    val excluded_hir = excluded_hir_lowering.lower_module(excluded_ast)
    val excluded_mir = lowering.lower_module(excluded_hir)
    if lowering.mcdc_active_tokens.len() != 0 or lowering.mcdc_active_decision_id != 0:
        return false
    val excluded_report = mir_verify_module(excluded_mir)
    if excluded_report.fatal_count() != 0 or excluded_report.functions_checked != 1: return false
    for function in excluded_mir.functions.values():
        for block in function.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case MirInstKind.Call(dest, callee, args):
                        val name = probe_call_name(callee)
                        if name.starts_with("mcdc_") or name.starts_with("lib.nogc_sync_mut.mcdc."):
                            return false
                    case _: ()
    true

pub fn check_mcdc_nested_early_return(mode: i64) -> bool:
    # Set up two genuinely initialized MIR token locals in an active nested
    # decision context, then lower the real HIR Return path. This isolates
    # cleanup ordering from source grammar and tests emitted, verified MIR.
    var lowering = MirLowering.new(SymbolTable.new())
    lowering.configure_mcdc_mode(mode)
    val span = Span.empty()
    var builder = lowering.builder
    builder.begin_function(SymbolId(id: 900), "early_return", MirSignature(
        params: [], return_type: MirType.bool(), is_variadic: false), span)
    val outer = builder.emit_const_int(11)
    val inner = builder.emit_const_int(22)
    lowering.builder = builder
    lowering.mcdc_active_decision_id = 17
    lowering.mcdc_active_dynamic_token = inner
    lowering.mcdc_active_tokens = [outer, inner]
    val bool_type = HirType(kind: HirTypeKind.Bool, span: span)
    val value = HirExpr(kind: HirExprKind.BoolLit(true), has_type_: true,
        type_: bool_type, span: span)
    val early = HirExpr(kind: HirExprKind.Return(Some(value)), has_type_: true,
        type_: bool_type, span: span)
    lowering.lower_expr(early)
    var finished = lowering.builder
    val function = finished.end_function()
    finished.add_function(function)
    val report = mir_verify_module(finished.module)
    if report.fatal_count() != 0 or report.functions_checked != 1: return false
    val abort_name = if mode == 2:
        "lib.nogc_sync_mut.mcdc.dynamic_probe.mcdc_dynamic_probe_abort"
    else:
        "lib.nogc_sync_mut.mcdc.static_probe.mcdc_static_probe_abort"
    var aborted: [i64] = []
    var returns = 0
    for block in function.blocks:
        for inst in block.instructions:
            match inst.kind:
                case MirInstKind.Call(dest, callee, args):
                    if probe_call_name(callee) == abort_name:
                        if args.len() != 1: return false
                        match args[0].kind:
                            case MirOperandKind.Copy(local): aborted = aborted.push(local.id)
                            case _: return false
                case _: ()
        match block.terminator:
            case MirTerminator.Ret(value): returns = returns + 1
            case _: ()
    aborted.len() == 2 and aborted[0] == inner.id and aborted[1] == outer.id and returns == 1

pub fn check_mcdc_entry_configuration(mode: i64, is_entry: bool) -> bool:
    val path = "mcdc_entry_configuration.spl"
    val ast = parse_full_frontend(
        "fn main() -> i64:\n    if true: return 0\n    1\n", path, path, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(path)
    val hir = hir_lowering.lower_module(ast)
    var lowering = MirLowering.new(hir.symbols)
    lowering.configure_mcdc_mode(mode)
    val mir = lowering.lower_module(hir, is_entry_module: is_entry)
    val report = mir_verify_module(mir)
    if report.fatal_count() != 0 or report.functions_checked != 1: return false
    val expected = if mode == 2:
        "lib.nogc_sync_mut.mcdc.dynamic_probe.mcdc_dynamic_probe_configure"
    else:
        "lib.nogc_sync_mut.mcdc.static_probe.mcdc_static_probe_configure_bytes"
    var configurations = 0
    var decisions = 0
    for function in mir.functions.values():
        for block in function.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case MirInstKind.Call(dest, callee, args):
                        val name = probe_call_name(callee)
                        if name.ends_with("_probe_configure") or name.ends_with("_probe_configure_bytes"):
                            if name != expected: return false
                        if name == expected:
                            if decisions != 0 or args.len() != 2: return false
                            configurations = configurations + 1
                        if name.ends_with("_probe_begin"):
                            if is_entry and mode > 0 and configurations != 1: return false
                            decisions = decisions + 1
                    case _: ()
    if mode == 0: return configurations == 0 and decisions == 0
    if decisions != 1: return false
    configurations == (if is_entry: 1 else: 0)

pub fn check_module_initializer_ordering() -> bool:
    val path = "initializer_ordering_probe.spl"
    val source = "fn value(v: i64) -> i64:\n    v\n\nvar first: i64 = value(1)\nvar second: i64 = value(2)\nvar third: i64 = value(3)\nval literal: i64 = 9\n"
    val ast = parse_full_frontend(source, path, path, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(path)
    val hir = hir_lowering.lower_module(ast)
    if hir_lowering.errors.len() != 0: return false
    var firsts: [HirConst] = []
    var seconds: [HirConst] = []
    var thirds: [HirConst] = []
    var literals: [HirConst] = []
    for constant in hir.constants.values():
        if constant.name == "first": firsts.push(constant)
        if constant.name == "second": seconds.push(constant)
        if constant.name == "third": thirds.push(constant)
        if constant.name == "literal": literals.push(constant)
    if firsts.len() != 1 or seconds.len() != 1 or thirds.len() != 1 or literals.len() != 1:
        return false
    val reversed = [thirds[0], literals[0], seconds[0], firsts[0]]
    val ordered = runtime_module_initializers_in_declaration_order(reversed)
    if ordered.len() != 3: return false
    if ordered[0].name != "first" or ordered[1].name != "second" or ordered[2].name != "third":
        return false
    # Sorting owns a fresh filtered array; the caller's inventory is retained.
    if reversed.len() != 4 or reversed[0].name != "third" or reversed[1].name != "literal":
        return false
    var first = firsts[0]
    var second = seconds[0]
    var third = thirds[0]
    first.span = Span.empty()
    second.span = Span.empty()
    third.span = Span.empty()
    first.symbol = SymbolId(id: 20)
    second.symbol = SymbolId(id: 10)
    third.symbol = SymbolId(id: 10)
    val tied = runtime_module_initializers_in_declaration_order([first, third, second])
    if tied.len() != 3: return false
    if tied[0].name != "third" or tied[1].name != "second" or tied[2].name != "first":
        return false
    val empty: [HirConst] = []
    if runtime_module_initializers_in_declaration_order(empty).len() != 0: return false
    val single = runtime_module_initializers_in_declaration_order([first])
    single.len() == 1 and single[0].name == "first"

fn main() -> i32:
    if not check_module_initializer_ordering():
        print "mcdc_required_token=FAIL initializer-ordering"
        return 1
    for mode in [0, 1, 2]:
        if not check_mcdc_entry_configuration(mode, true) or not check_mcdc_entry_configuration(mode, false):
            print "mcdc_required_token=FAIL entry-configuration mode={mode}"
            return 1
        if not check_mcdc_token(mode) or not check_mcdc_token(mode, logical_op: "or"):
            print "mcdc_required_token=FAIL mode={mode}"
            return 1
    for mode in [1, 2]:
        if not check_mcdc_shared_lowerer(mode) or not check_mcdc_nested_early_return(mode):
            print "mcdc_required_token=FAIL token-stack mode={mode}"
            return 1
        # Same short-circuit shape as the receiver, whose compiler path is
        # excluded by the existing production default instrumentation policy.
        if not check_mcdc_token(mode, path: "src/compiler/bootstrap_admission/token_guard.spl", eligible: false) or
                not check_mcdc_token(mode, path: "src/compiler/bootstrap_admission/token_guard.spl", eligible: false, logical_op: "or"):
            print "mcdc_required_token=FAIL default-exclusion mode={mode}"
            return 1
        if not check_mcdc_token(mode, exclude_csv: "mcdc_required_token", eligible: false) or
                not check_mcdc_token(mode, exclude_csv: "mcdc_required_token", eligible: false, logical_op: "or"):
            print "mcdc_required_token=FAIL explicit-exclusion mode={mode}"
            return 1
        if not check_mcdc_token(mode, path: "src/compiler/bootstrap_admission/token_guard.spl", include_csv: "token_guard") or
                not check_mcdc_token(mode, path: "src/compiler/bootstrap_admission/token_guard.spl", include_csv: "token_guard", logical_op: "or"):
            print "mcdc_required_token=FAIL explicit-inclusion mode={mode}"
            return 1
    val scratch_status = check_mir_function_scratch_scope()
    if scratch_status != 0:
        print "mcdc_required_token=FAIL scratch-scope checkpoint={scratch_status}"
        return 1
    print "mcdc_required_token=PASS modes=off,static,dynamic verifier=checked"
    0
