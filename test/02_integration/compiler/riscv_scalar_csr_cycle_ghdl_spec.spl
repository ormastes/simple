use std.spec.*
use app.io.vhdl_ffi.{ghdl_available, ghdl_analyze, ghdl_elaborate,
    ghdl_run, vhdl_write_file}
use compiler.mir.hwir.types.{CoreConfig}
use compiler.backend.backend.riscv_scalar_csr_owner_to_vhdl.{
    compile_strict_riscv_scalar_csr_owner}

fn csr_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n" +
    "entity csr_cycle_tb is end entity; architecture sim of csr_cycle_tb is\n" +
    " signal clk,rst,valid,ready,present,completion_valid,commit_valid,read_enable,trap,fault: std_logic := '0';\n" +
    " signal old_value,rd_value,commit_value,cause,tval: std_logic_vector(31 downto 0);\n" +
    " signal access_addr,commit_addr: std_logic_vector(11 downto 0); begin clk<=not clk after 5 ns;\n" +
    " dut: entity work.csr_cycle port map(clk=>clk,rst=>rst,dispatch_valid=>valid,completion_ready=>ready," +
    "in_privilege=>\"11\",in_pc=>x\"00000100\",rs1_index=>\"00001\",rs1_value=>x\"00000055\"," +
    "csr_present=>present,csr_read_value=>old_value,dispatch_event_id=>std_logic_vector(to_unsigned(11,64))," +
    "decode_event_id=>std_logic_vector(to_unsigned(11,64)),illegal_valid=>'0'," +
    "dispatch_canonical_instruction=>x\"300092F3\",dispatch_instruction_length_bytes=>\"100\",dispatch_rd=>\"00101\"," +
    "dispatch_ready=>open,dispatch_accept=>open,completion_valid=>completion_valid,completion_decode_valid=>open," +
    "protocol_fault=>fault,csr_access_read_enable=>read_enable,csr_access_address=>access_addr," +
    "csr_commit_valid=>commit_valid,csr_commit_address=>commit_addr,csr_commit_value=>commit_value," +
    "privilege=>open,original_instruction=>open,canonical_instruction=>open,instruction_length_bytes=>open," +
    "pc_before=>open,pc_after=>open,rd=>open,rd_write=>open,rd_value=>rd_value,memory_address=>open," +
    "memory_read_mask=>open,memory_write_mask=>open,memory_read_data=>open,memory_write_data=>open," +
    "execute_trap_valid=>trap,execute_trap_cause=>cause,execute_trap_tval=>tval,memory_trap_valid=>open," +
    "memory_trap_cause=>open,memory_trap_tval=>open,redirect_valid=>open,redirect_target=>open," +
    "completion_event_id=>open,completion_decode_event_id=>open,completion_illegal_valid=>open);\n" +
    " process begin rst<='1'; wait until rising_edge(clk); wait until rising_edge(clk); rst<='0';\n" +
    " present<='1'; old_value<=x\"000000A5\"; valid<='1'; wait for 1 ns;" +
    " assert read_enable='1' and access_addr=x\"300\" report \"CSR lookup mismatch\" severity failure;" +
    " wait until rising_edge(clk); valid<='0'; old_value<=x\"DEADBEEF\"; wait for 1 ns;\n" +
    " assert completion_valid='1' and rd_value=x\"000000A5\" report \"CSR old value not captured\" severity failure;" +
    " assert commit_valid='0' report \"CSR committed before completion acceptance\" severity failure;\n" +
    " wait until rising_edge(clk); wait for 1 ns; assert completion_valid='1' and rd_value=x\"000000A5\" report \"CSR completion not held\" severity failure;\n" +
    " ready<='1'; wait for 1 ns; assert commit_valid='1' and commit_addr=x\"300\" and commit_value=x\"00000055\" report \"CSR commit mismatch\" severity failure;" +
    " wait until rising_edge(clk); ready<='0'; wait for 1 ns; assert completion_valid='0' and commit_valid='0' report \"CSR commit duplicated\" severity failure;\n" +
    " present<='0'; old_value<=x\"12345678\"; valid<='1'; wait until rising_edge(clk); valid<='0'; wait for 1 ns;" +
    " assert completion_valid='1' and trap='1' and commit_valid='0' report \"denied CSR wrote state\" severity failure;" +
    " assert cause=x\"00000002\" and tval=x\"300092F3\" report \"denied CSR trap mismatch\" severity failure;" +
    " assert fault='0' report \"unexpected CSR protocol fault\" severity failure; finish; end process;\n" +
    "end architecture;\n"

describe "RISC-V Gen2 atomic CSR cycle evidence":
    # @req REQ-G2-016 NFR-G2-017
    slow_it "simulates old-value capture single commit backpressure and denied suppression":
        if not ghdl_available():
            print "SKIP: GHDL not available"
            return
        val emitted = compile_strict_riscv_scalar_csr_owner(
            "csr_cycle", CoreConfig.rv32_zicsr_zifencei(), 0x300092F3)
        expect(emitted.is_success()).to_equal(true)
        if emitted.is_success():
            val path = "/tmp/csr_cycle.vhd"
            expect(vhdl_write_file(path, emitted.vhdl + "\n" + csr_testbench())).to_equal(true)
            expect(ghdl_analyze(path).success).to_equal(true)
            expect(ghdl_elaborate("csr_cycle_tb").success).to_equal(true)
            expect(ghdl_run("csr_cycle_tb", Some("500ns")).success).to_equal(true)
