#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
script="$root/scripts/check/check-freebsd-bootstrap-qemu.shs"

sh -n "$script"

# ARM64 Linux can emulate the x86_64 FreeBSD guest with TCG. KVM is selected
# only on a matching x86_64 host: ARM KVM cannot accelerate an x86_64 system
# emulator even when /dev/kvm is writable.
grep -Fq 'x86_64|amd64|aarch64|arm64) return 0 ;;' "$script"
grep -Fq 'case "${HOST_ARCH:-$(uname -m 2>/dev/null || true)}" in' "$script"
grep -Fq 'x86_64|amd64)' "$script"

printf '%s\n' 'freebsd_bootstrap_qemu_cross_arch_contract=true'
