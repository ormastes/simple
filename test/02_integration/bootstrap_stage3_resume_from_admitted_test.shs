#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

write_fake_facade() {
    facade=$1
    cat >"$facade" <<'FACADE'
bootstrap_stage3_host_platform() { echo x86_64-unknown-linux-gnu; }

bootstrap_stage3_canonical_file() { readlink -f "$1"; }

bootstrap_stage3_canonical_path() {
    (CDPATH= cd -- "$1" && pwd -P)
}

bootstrap_stage3_hash_file() {
    sha256sum "$1" | sed 's/ .*//'
}

bootstrap_stage3_hash_stream() {
    sha256sum | sed 's/ .*//'
}

bootstrap_stage3_manifest_value() {
    key=$1
    file=$2
    [ "$(grep -c "^${key}=" "$file" || true)" = 1 ] || return 1
    sed -n "s/^${key}=//p" "$file"
}

bootstrap_stage3_transcript_host_value() {
    transcript=$1
    key=$2
    sed -n "s/^host:${key}://p" "$transcript"
}

bootstrap_stage3_transcript_explicit_env_value() {
    transcript=$1
    name=$2
    record=$(grep "^explicit-env:[0-9][0-9]*:${name}=" "$transcript" || true)
    [ -n "$record" ] && [ "$(printf '%s\n' "$record" | wc -l | tr -d ' ')" = 1 ] || return 1
    payload=${record#*:*:}
    printf '%s\n' "${payload#*=}"
}

bootstrap_stage3_verify_command_transcript() { return 0; }

bootstrap_stage3_verify_sanity_evidence() (
    evidence=$1
    candidate=$2
    fixture_root=$3
    [ "$(bootstrap_stage3_manifest_value status "$evidence")" = pass ] || return 1
    candidate_sha=$(bootstrap_stage3_hash_file "$candidate")
    [ "$(bootstrap_stage3_manifest_value candidate_sha256_before "$evidence")" = "$candidate_sha" ] || return 1
    [ "$(bootstrap_stage3_manifest_value candidate_sha256_after "$evidence")" = "$candidate_sha" ] || return 1
    [ "$($candidate --version)" = "simple-bootstrap 1.0.0-beta" ] || return 1
    unsupported_status=0
    unsupported=$($candidate run ignored.spl 2>&1) || unsupported_status=$?
    [ "$unsupported_status" = 1 ] || return 1
    case "$unsupported" in *"unknown command 'run'"*) ;; *) return 1 ;; esac
    . "$fixture_root/scripts/check/cert/redeploy_gate/candidate_frontend_admission.shs"
    [ "$(candidate_frontend_smoke "$candidate")" = frontend-smoke ] || return 1
    echo replayed >>"$fixture_root/stage2-sanity-replay.events"
)

bootstrap_stage3_directory_snapshot() {
    snapshot_output=$1
    authority=$2
    [ -d "$authority" ] && [ ! -L "$authority" ] || return 1
    find "$authority" -type l -print | grep -q . && return 1
    find "$authority" -type f -exec sha256sum {} + |
        sed "s|  $authority/|  |" | sort >"$snapshot_output"
    [ -s "$snapshot_output" ]
}

bootstrap_stage3_source_snapshot() {
    snapshot_output=$1
    snapshot_root=$2
    find "$snapshot_root/src/compiler" "$snapshot_root/src/app" \
        "$snapshot_root/src/lib" "$snapshot_root/examples/10_tooling" \
        -type f -exec sha256sum {} + | sort >"$snapshot_output"
    [ -s "$snapshot_output" ]
}

bootstrap_stage3_git_state() {
    snapshot_root=$1
    snapshot_output=$2
    printf '%s\n' schema=fake-git-state head=fixture dirty_fingerprint=clean \
        >"$snapshot_output"
}

bootstrap_stage3_tool_authority_snapshot() {
    snapshot_output=$1
    snapshot_path=$2
    printf 'path=%s\n' "$snapshot_path" >"$snapshot_output"
}

bootstrap_stage3_helper_bundle_fingerprint() {
    printf '%064d\n' 0
}

bootstrap_stage3_args_sha256() {
    printf '%s\n' "$@" | bootstrap_stage3_hash_stream
}

bootstrap_stage3_run_transcribed() {
    transcript=$1
    fixture_root=$2
    log=$3
    home=$4
    tmpdir=$5
    path=$6
    shift 6
    {
        printf 'host:HOME:%s\n' "$home"
        printf 'host:TMPDIR:%s\n' "$tmpdir"
        printf 'host:PATH:%s\n' "$path"
    } >"$transcript"
    env_args=
    env_index=1
    while [ "$1" != -- ]; do
        printf 'env:%s:%s\n' "$env_index" "$1" >>"$transcript"
        env_args="$env_args $1"
        env_index=$((env_index + 1))
        shift
    done
    shift
    argv_index=1
    for arg in "$@"; do
        printf 'argv:%s:%s\n' "$argv_index" "$arg" >>"$transcript"
        argv_index=$((argv_index + 1))
    done
    # Fixture paths contain no whitespace; production command quoting is covered
    # by the canonical command-transcript helper tests.
    env -i HOME="$home" TMPDIR="$tmpdir" PATH="$path" LC_ALL=C LANG=C \
        $env_args "$@" >"$log" 2>&1
}

bootstrap_stage3_write_manifest() {
    [ -d "$BSTAGE3_LOCK" ] || return 1
    [ -x "$BSTAGE3_STAGE3" ] || return 1
    {
        echo schema=fake-stage3-provenance
        echo status=pass
        echo stage2_sha256="$(bootstrap_stage3_hash_file "$BSTAGE3_STAGE2")"
        echo stage3_sha256="$(bootstrap_stage3_hash_file "$BSTAGE3_STAGE3")"
        echo no_stub_fallback=1
    } >"$BSTAGE3_MANIFEST"
}

bootstrap_stage3_verify_manifest() {
    manifest=$1
    candidate=$3
    [ "$(bootstrap_stage3_manifest_value status "$manifest")" = pass ] || return 1
    [ "$(bootstrap_stage3_manifest_value stage3_sha256 "$manifest")" = \
        "$(bootstrap_stage3_hash_file "$candidate")" ] || return 1
    : >"$manifest.verified"
}
FACADE
    chmod +x "$facade"
}

write_fake_stage2() {
    stage2_file=$1
    cat >"$stage2_file" <<'STAGE2'
#!/bin/sh
set -eu
stage3=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
case "${1:-}" in
    --version)
        echo "simple-bootstrap 1.0.0-beta"
        exit 0
        ;;
    run)
        echo "unknown command 'run'" >&2
        exit 1
        ;;
    native-build)
        original=$*
        candidate=
        while [ "$#" -gt 0 ]; do
            if [ "$1" = -o ]; then
                candidate=$2
                break
            fi
            shift
        done
        [ -n "$candidate" ] || exit 2
        printf '%s\n' "$original" >>"$stage3/stage3-native-build.calls"
        cat >"$candidate" <<'CANDIDATE'
#!/bin/sh
case "${1:-}" in
    --version) echo "simple-bootstrap 1.0.0-beta"; exit 0 ;;
    run) echo "unknown command 'run'" >&2; exit 1 ;;
    *) exit 2 ;;
esac
CANDIDATE
        chmod +x "$candidate"
        echo "fixture Stage 3 native build"
        ;;
    *) exit 2 ;;
esac
STAGE2
    chmod +x "$stage2_file"
}

make_fixture() {
    name=$1
    fixture_root="$tmp/$name/repo"
    output="$fixture_root/build/recovery"
    platform=x86_64-unknown-linux-gnu
    stage3="$output/stage3/$platform"
    runtime="$stage3/stage2-runtime-authority"
    mkdir -p "$fixture_root/scripts/bootstrap" \
        "$fixture_root/scripts/check/lib" \
        "$fixture_root/scripts/check/cert/redeploy_gate" \
        "$fixture_root/src/compiler" "$fixture_root/src/app" \
        "$fixture_root/src/lib" "$fixture_root/examples/10_tooling" \
        "$output/stage2/$platform" "$output/logs/$platform" \
        "$stage3/stage2-admitted" "$runtime" \
        "$stage3/stage2-native-cache" "$stage3/stage3-native-cache" \
        "$stage3/stage2-home" "$stage3/stage2-tmp"
    cp "$root/scripts/bootstrap/resume-stage3-from-admitted.sh" \
        "$fixture_root/scripts/bootstrap/"
    printf '#!/bin/sh\nexit 99\n' \
        >"$fixture_root/scripts/bootstrap/bootstrap-from-scratch.sh"
    chmod +x "$fixture_root/scripts/bootstrap/bootstrap-from-scratch.sh"
    write_fake_facade \
        "$fixture_root/scripts/check/lib/bootstrap-stage3-provenance.shs"
    cat >"$fixture_root/scripts/check/cert/redeploy_gate/candidate_frontend_admission.shs" <<'ADMISSION'
candidate_frontend_smoke() { echo frontend-smoke; }
run_timeout() { shift; "$@"; }
ADMISSION
    printf 'compiler\n' >"$fixture_root/src/compiler/input.spl"
    printf 'app\n' >"$fixture_root/src/app/input.spl"
    printf 'lib\n' >"$fixture_root/src/lib/input.spl"
    printf 'example\n' >"$fixture_root/examples/10_tooling/input.spl"

    write_fake_stage2 "$output/stage2/$platform/simple"
    cp "$output/stage2/$platform/simple" "$stage3/stage2-admitted/simple"
    chmod 500 "$stage3/stage2-admitted/simple"
    cat >"$runtime/simple" <<'SEED'
#!/bin/sh
echo seed-invoked >"$(dirname -- "$0")/seed-invoked"
exit 97
SEED
    chmod +x "$runtime/simple"
    printf 'native-all\n' >"$runtime/libsimple_native_all.a"
    printf 'backfill\n' >"$runtime/libsimple_compiler_backfill.a"
    printf 'inputs_fingerprint=%064d\n' 0 >"$runtime/simple.inputs.sha256"

    BOOTSTRAP_STAGE3_FACADE_PATH=\
"$fixture_root/scripts/check/lib/bootstrap-stage3-provenance.shs"
    export BOOTSTRAP_STAGE3_FACADE_PATH
    # shellcheck disable=SC1090
    . "$BOOTSTRAP_STAGE3_FACADE_PATH"
    bootstrap_stage3_directory_snapshot "$stage3/runtime-admitted.txt" "$runtime"
    cp "$stage3/runtime-admitted.txt" "$stage3/runtime-origin-before.txt"
    cp "$stage3/runtime-admitted.txt" "$stage3/runtime-origin-after.txt"
    bootstrap_stage3_source_snapshot "$stage3/source-inputs-before.txt" \
        "$fixture_root"
    bootstrap_stage3_git_state "$fixture_root" "$stage3/git-state-before.env"
    bootstrap_stage3_tool_authority_snapshot \
        "$stage3/tool-authority-before.txt" "$PATH" "$fixture_root"
    cp "$stage3/runtime-admitted.txt" "$stage3/runtime-before-stage2.txt"
    cp "$stage3/runtime-admitted.txt" "$stage3/runtime-after-stage2.txt"
    stage2_sha=$(bootstrap_stage3_hash_file "$output/stage2/$platform/simple")
    cat >"$stage3/stage2-sanity.env" <<SANITY
schema=simple-bootstrap-sanity-evidence-v1
status=pass
candidate_sha256_before=$stage2_sha
version_status=0
version_output=simple-bootstrap 1.0.0-beta
unsupported_status=1
unsupported_output_sha256=$(printf "unknown command 'run'" | bootstrap_stage3_hash_stream)
frontend_smoke_status=0
frontend_smoke_output_sha256=$(printf frontend-smoke | bootstrap_stage3_hash_stream)
candidate_sha256_after=$stage2_sha
SANITY
    stage2_cache_path="$stage3/stage2-native-cache"
    stage2_output_path="$output/stage2/$platform/simple"
    cat >"$stage3/stage2-command.transcript" <<TRANSCRIPT
host:HOME:$stage3/stage2-home
host:TMPDIR:$stage3/stage2-tmp
host:PATH:$PATH
explicit-env:14:RUST_LOG=error
explicit-env:13:LIBRARY_PATH=
explicit-env:42:SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=absent
explicit-env:18:SIMPLE_BOOTSTRAP=1
explicit-env:31:SIMPLE_NO_DEPRECATED_WARNINGS=1
explicit-env:26:SIMPLE_NATIVE_BUILD_RUST=1
explicit-env:25:SIMPLE_NO_STUB_FALLBACK=1
explicit-env:$((21 + ${#runtime})):SIMPLE_BINARY=$runtime/simple
argv:12:native-build
argv:8:--target
argv:24:$platform
argv:9:--backend
argv:9:cranelift
argv:16:--runtime-bundle
argv:16:core-c-bootstrap
argv:8:--source
argv:12:src/compiler
argv:8:--source
argv:7:src/app
argv:8:--source
argv:7:src/lib
argv:15:--entry-closure
argv:9:--threads
argv:1:1
argv:9:--verbose
argv:11:--cache-dir
argv:${#stage2_cache_path}:$stage2_cache_path
argv:6:--mode
argv:7:dynload
argv:7:--entry
argv:30:src/app/cli/bootstrap_main.spl
argv:14:--runtime-path
argv:${#runtime}:$runtime
argv:2:-o
argv:${#stage2_output_path}:$stage2_output_path
TRANSCRIPT
    printf 'fixture Stage 2 native build\n' \
        >"$output/logs/$platform/stage2-native-build.log"
    printf 'preserve-me\n' >"$stage3/stage3-native-cache/preserved.marker"
}

run_refusal() {
    label=$1
    if sh "$fixture_root/scripts/bootstrap/resume-stage3-from-admitted.sh" \
        build/recovery >"$tmp/$label.out" 2>&1; then
        fail "$label unexpectedly resumed Stage 3"
    fi
    [ ! -e "$stage3/simple" ] || fail "$label produced a candidate"
    [ ! -e "$stage3/stage3-native-build.calls" ] || \
        fail "$label invoked Stage 3"
}

make_fixture success
stage2_before=$(sha256sum "$output/stage2/$platform/simple")
admitted_before=$(sha256sum "$stage3/stage2-admitted/simple")
sh "$fixture_root/scripts/bootstrap/resume-stage3-from-admitted.sh" \
    build/recovery >"$tmp/success.out" 2>&1
[ -x "$stage3/simple" ] || fail "resume did not produce Stage 3"
[ "$(sed -n 's/^status=//p' "$stage3/provenance.env")" = pass ] || \
    fail "resume did not write passing provenance"
[ -f "$stage3/provenance.env.verified" ] || fail "manifest was not verified"
[ "$(wc -l <"$fixture_root/stage2-sanity-replay.events")" = 1 ] || \
    fail "Stage 2 sanity was not replayed exactly once before recovery"
[ "$(wc -l <"$stage3/stage3-native-build.calls")" = 1 ] || \
    fail "recovery did not invoke exactly one Stage 3 build"
grep -F -- "-o $stage3/simple" "$stage3/stage3-native-build.calls" >/dev/null || \
    fail "recovery build did not target Stage 3"
grep -F 'SIMPLE_NO_STUB_FALLBACK=1' "$stage3/stage3-command.transcript" >/dev/null || \
    fail "recovery omitted no-stub-fallback"
grep -F "SIMPLE_BINARY=$stage3/stage2-admitted/simple" \
    "$stage3/stage3-command.transcript" >/dev/null || \
    fail "recovery did not use admitted Stage 2"
[ ! -e "$stage3/stage3-native-cache/preserved.marker" ] || \
    fail "recovery reused stale Stage 3 cache"
[ "$(find "$stage3/stage3-resume-archive" -name preserved.marker | wc -l)" = 1 ] || \
    fail "recovery did not archive the prior Stage 3 cache"
[ ! -e "$runtime/seed-invoked" ] || fail "recovery fell back to seed"
[ "$stage2_before" = "$(sha256sum "$output/stage2/$platform/simple")" ] || \
    fail "recovery changed Stage 2"
[ "$admitted_before" = "$(sha256sum "$stage3/stage2-admitted/simple")" ] || \
    fail "recovery changed admitted Stage 2"
[ ! -e "$output.lock" ] || fail "recovery leaked its output lock"

make_fixture hash-mismatch
printf 'tampered\n' >>"$output/stage2/$platform/simple"
run_refusal hash-mismatch

make_fixture stale-runtime
printf 'stale\n' >>"$runtime/libsimple_native_all.a"
run_refusal stale-runtime

make_fixture stale-manifest
printf 'status=stale\n' >"$stage3/provenance.env"
run_refusal stale-manifest

make_fixture symlink-receipt
mv "$stage3/stage2-sanity.env" "$stage3/stage2-sanity.real"
ln -s stage2-sanity.real "$stage3/stage2-sanity.env"
run_refusal symlink-receipt

make_fixture symlink-recovery
ln -s "$tmp" "$stage3/stage3-resume-archive"
run_refusal symlink-recovery

make_fixture locked-output
mkdir "$output.lock"
run_refusal locked-output
[ -d "$output.lock" ] || fail "foreign lock was removed"

make_fixture symlink-lock
ln -s "$tmp" "$output.lock"
run_refusal symlink-lock
[ -L "$output.lock" ] || fail "foreign symlink lock was removed"

echo "PASS: Stage 3 resumes only from admitted Stage 2 and refuses unsafe evidence"
