#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

write_fake_facade() {
    facade=$1
    cat >"$facade" <<'FACADE'
bootstrap_stage3_host_platform() { echo x86_64-unknown-linux-gnu; }

bootstrap_stage3_canonical_version() {
    [ -d "$1" ] || return 1
    echo 1.0.0-beta
}

bootstrap_stage3_canonical_file() { readlink -f "$1"; }

bootstrap_stage3_canonical_path() {
    (CDPATH= cd -- "$1" && pwd -P)
}

bootstrap_stage3_hash_file() {
    sha256sum "$1" | sed 's/ .*//'
}

bootstrap_stage3_hash_stream() {
    sha256sum | sed 's/ .*//'
}

bootstrap_stage3_manifest_value() {
    key=$1
    file=$2
    [ "$(grep -c "^${key}=" "$file" || true)" = 1 ] || return 1
    sed -n "s/^${key}=//p" "$file"
}

bootstrap_stage3_transcript_host_value() {
    transcript=$1
    key=$2
    sed -n "s/^host:${key}://p" "$transcript"
}

bootstrap_stage3_transcript_explicit_env_value() {
    transcript=$1
    name=$2
    record=$(grep "^explicit-env:[0-9][0-9]*:${name}=" "$transcript" || true)
    [ -n "$record" ] && [ "$(printf '%s\n' "$record" | wc -l | tr -d ' ')" = 1 ] || return 1
    payload=${record#*:*:}
    printf '%s\n' "${payload#*=}"
}

bootstrap_stage3_transcript_argv_value_after() {
    [ "$#" = 2 ] || return 1
    awk -v wanted="$2" '
        BEGIN { waiting = 0; found = 0 }
        /^argv:[0-9]+:/ {
            declared = $0
            sub(/^argv:/, "", declared)
            sub(/:.*/, "", declared)
            payload = $0
            sub(/^argv:[0-9]+:/, "", payload)
            if (length(payload) != declared) exit 2
            if (waiting) { print payload; waiting = 0; found++; next }
            if (payload == wanted) waiting = 1
        }
        END { if (waiting || found != 1) exit 1 }
    ' "$1"
}

bootstrap_stage3_verify_command_transcript() { return 0; }

bootstrap_stage3_verify_sanity_evidence_receipt() (
    evidence=$1
    evidence_display=$2 companion_parent=$3
    candidate=$4
    fixture_root=$5
    [ "$evidence_display" = "$evidence" ] || return 1
    [ "$companion_parent" = "$(dirname -- "$evidence")" ] || return 1
    [ "$(bootstrap_stage3_manifest_value status "$evidence")" = pass ] || return 1
    candidate_sha=$(bootstrap_stage3_hash_file "$candidate")
    [ "$(bootstrap_stage3_manifest_value candidate_sha256_before "$evidence")" = "$candidate_sha" ] || return 1
    [ "$(bootstrap_stage3_manifest_value candidate_sha256_after "$evidence")" = "$candidate_sha" ] || return 1
    [ "$($candidate --version)" = "simple-bootstrap 1.0.0-beta" ] || return 1
    unsupported_status=0
    unsupported=$($candidate run ignored.spl 2>&1) || unsupported_status=$?
    [ "$unsupported_status" = 1 ] || return 1
    case "$unsupported" in *"unknown command 'run'"*) ;; *) return 1 ;; esac
    . "$fixture_root/scripts/check/cert/redeploy_gate/candidate_frontend_admission.shs"
    [ "$(candidate_frontend_smoke "$candidate")" = frontend-smoke ] || return 1
    echo replayed >>"$fixture_root/stage2-sanity-replay.events"
)

bootstrap_stage3_verify_receiver_evidence_receipt() (
    [ "$#" = 8 ] || return 1
    receipt=$1 receipt_display=$2
    candidate=$3 candidate_display=$4
    runtime_snapshot=$5 runtime_snapshot_display=$6
    expected_log=$7 expected_log_display=$8
    [ "$receipt" = "$receipt_display" ] || return 1
    [ "$candidate" = "$candidate_display" ] || return 1
    [ "$runtime_snapshot" = "$runtime_snapshot_display" ] || return 1
    [ "$expected_log" = "$expected_log_display" ] || return 1
    [ "$(bootstrap_stage3_manifest_value status "$receipt")" = pass ] || return 1
    candidate_sha=$(bootstrap_stage3_hash_file "$candidate")
    [ "$(bootstrap_stage3_manifest_value candidate_sha256_before "$receipt")" = "$candidate_sha" ] || return 1
    [ "$(bootstrap_stage3_manifest_value candidate_sha256_after "$receipt")" = "$candidate_sha" ] || return 1
    [ "$(bootstrap_stage3_manifest_value runtime_snapshot_sha256 "$receipt")" = \
        "$(bootstrap_stage3_hash_file "$runtime_snapshot")" ] || return 1
    [ "$(bootstrap_stage3_manifest_value probe_log "$receipt")" = "$expected_log" ] || return 1
    [ "$(bootstrap_stage3_manifest_value probe_log_sha256 "$receipt")" = \
        "$(bootstrap_stage3_hash_file "$expected_log")" ]
)

bootstrap_stage3_verify_stage2_admission_receipt() (
    [ "$#" = 21 ] || return 1
    receipt=$1 receipt_display=$2
    candidate=$3 candidate_display=$4
    source_snapshot=$5 source_snapshot_display=$6
    runtime_snapshot=$7 runtime_snapshot_display=$8
    runtime_authority=$9 runtime_authority_display=${10}
    tool_snapshot=${11} tool_snapshot_display=${12}
    sanity=${14} sanity_display=${15} sanity_parent=${16}
    receiver=${17} receiver_display=${18}
    receiver_log=${19} receiver_log_display=${20}
    [ "$receipt" = "$receipt_display" ] || return 1
    [ "$candidate" = "$candidate_display" ] || return 1
    [ "$source_snapshot" = "$source_snapshot_display" ] || return 1
    [ "$runtime_snapshot" = "$runtime_snapshot_display" ] || return 1
    [ "$runtime_authority" = "$runtime_authority_display" ] || return 1
    [ "$tool_snapshot" = "$tool_snapshot_display" ] || return 1
    [ "$sanity" = "$sanity_display" ] || return 1
    [ "$sanity_parent" = "$(dirname -- "$sanity")" ] || return 1
    [ "$receiver" = "$receiver_display" ] || return 1
    [ "$receiver_log" = "$receiver_log_display" ] || return 1
    [ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
    [ "$(bootstrap_stage3_manifest_value status "$receipt")" = admitted ] || return 1
    [ "$(bootstrap_stage3_manifest_value candidate_sha256 "$receipt")" = \
        "$(bootstrap_stage3_hash_file "$candidate")" ]
)

bootstrap_stage3_diagnostic_env() {
    for diagnostic_name in SIMPLE_BOOTSTRAP_DIAG SIMPLE_COMPILER_TRACE \
        SIMPLE_HIR_EXPORT_ORIGIN_TRACE SIMPLE_HIR_PAYLOAD_LOOKUP_TRACE \
        SIMPLE_HIR_SIBLING_TRACE SIMPLE_MIRB_TRACE \
        SIMPLE_MIR_DEFAULT_PAD_TRACE SIMPLE_MIR_FIELD_TRACE \
        SIMPLE_MIR_RET_TRACE; do
        eval "diagnostic_value=\${$diagnostic_name-}"
        [ "$diagnostic_value" = 1 ] || continue
        printf '%s=1\n' "$diagnostic_name"
    done
}

bootstrap_stage3_directory_snapshot() {
    snapshot_output=$1
    authority=$2
    [ -d "$authority" ] && [ ! -L "$authority" ] || return 1
    find "$authority" -type l -print | grep -q . && return 1
    find "$authority" -type f -exec sha256sum {} + |
        sed "s|  $authority/|  |" | sort >"$snapshot_output"
    [ -s "$snapshot_output" ]
}

bootstrap_stage3_source_snapshot() {
    snapshot_output=$1
    snapshot_root=$2
    find "$snapshot_root/src/compiler" "$snapshot_root/src/app" \
        "$snapshot_root/src/lib" "$snapshot_root/examples/10_tooling" \
        -type f -exec sha256sum {} + | sort >"$snapshot_output"
    [ -s "$snapshot_output" ]
}

bootstrap_stage3_git_state() {
    snapshot_root=$1
    snapshot_output=$2
    git_fixture="$snapshot_root/.fixture-git-state.env"
    [ -f "$git_fixture" ] && [ ! -L "$git_fixture" ] || return 1
    cp "$git_fixture" "$snapshot_output"
}

bootstrap_stage3_tool_authority_snapshot() {
    snapshot_output=$1
    snapshot_path=$2
    printf 'path=%s\n' "$snapshot_path" >"$snapshot_output"
}

bootstrap_stage3_helper_bundle_fingerprint() {
    printf '%064d\n' 0
}

bootstrap_stage3_args_sha256() {
    printf '%s\n' "$@" | bootstrap_stage3_hash_stream
}

bootstrap_stage3_run_transcribed() {
    transcript=$1
    fixture_root=$2
    log=$3
    home=$4
    tmpdir=$5
    path=$6
    shift 6
    {
        printf 'host:HOME:%s\n' "$home"
        printf 'host:TMPDIR:%s\n' "$tmpdir"
        printf 'host:PATH:%s\n' "$path"
    } >"$transcript"
    env_args=
    env_index=1
    while [ "$1" != -- ]; do
        printf 'env:%s:%s\n' "$env_index" "$1" >>"$transcript"
        env_args="$env_args $1"
        env_index=$((env_index + 1))
        shift
    done
    shift
    argv_index=1
    for arg in "$@"; do
        printf 'argv:%s:%s\n' "$argv_index" "$arg" >>"$transcript"
        argv_index=$((argv_index + 1))
    done
    if [ -n "${BOOTSTRAP_STAGE3_RUNNER_PID_FILE:-}" ]; then
        printf '1\n' >"$BOOTSTRAP_STAGE3_RUNNER_PID_FILE"
    fi
    # Fixture paths contain no whitespace; production command quoting is covered
    # by the canonical command-transcript helper tests.
    env -i HOME="$home" TMPDIR="$tmpdir" PATH="$path" LC_ALL=C LANG=C \
        $env_args "$@" >"$log" 2>&1
}

bootstrap_stage3_write_manifest() {
    [ -d "$BSTAGE3_LOCK" ] || return 1
    [ -x "$BSTAGE3_STAGE3" ] || return 1
    {
        echo schema=fake-stage3-provenance
        echo status=pass
        echo stage2_sha256="$(bootstrap_stage3_hash_file "$BSTAGE3_STAGE2")"
        echo stage3_sha256="$(bootstrap_stage3_hash_file "$BSTAGE3_STAGE3")"
        echo no_stub_fallback=1
    } >"$BSTAGE3_MANIFEST"
}

bootstrap_stage3_verify_manifest() {
    [ "$#" = 6 ] || return 1
    manifest=$1
    candidate=$4
    [ "$(bootstrap_stage3_manifest_value status "$manifest")" = pass ] || return 1
    [ "$(bootstrap_stage3_manifest_value stage3_sha256 "$manifest")" = \
        "$(bootstrap_stage3_hash_file "$candidate")" ] || return 1
    : >"$manifest.verified"
}
FACADE
    chmod +x "$facade"
}

write_fake_stage2() {
    stage2_file=$1
    cat >"$stage2_file" <<'STAGE2'
#!/bin/sh
set -eu
stage3=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
case "${1:-}" in
    --version)
        echo "simple-bootstrap 1.0.0-beta"
        exit 0
        ;;
    run)
        echo "unknown command 'run'" >&2
        exit 1
        ;;
    native-build)
        original=$*
        candidate=
        while [ "$#" -gt 0 ]; do
            if [ "$1" = -o ]; then
                candidate=$2
                break
            fi
            shift
        done
        [ -n "$candidate" ] || exit 2
        printf '%s\n' "$original" >>"$stage3/stage3-native-build.calls"
        cat >"$candidate" <<'CANDIDATE'
#!/bin/sh
case "${1:-}" in
    --version) echo "simple-bootstrap 1.0.0-beta"; exit 0 ;;
    run) echo "unknown command 'run'" >&2; exit 1 ;;
    *) exit 2 ;;
esac
CANDIDATE
        chmod +x "$candidate"
        echo "fixture Stage 3 native build"
        ;;
    *) exit 2 ;;
esac
STAGE2
    chmod +x "$stage2_file"
}

make_fixture() {
    name=$1
    fixture_root="$tmp/$name/repo"
    output="$fixture_root/build/recovery"
    platform=x86_64-unknown-linux-gnu
    stage3="$output/stage3/$platform"
    runtime="$stage3/stage2-runtime-authority"
    mkdir -p "$fixture_root/scripts/bootstrap" \
        "$fixture_root/scripts/check/lib" \
        "$fixture_root/scripts/check/cert/redeploy_gate" \
        "$fixture_root/src/compiler" "$fixture_root/src/app" \
        "$fixture_root/src/lib" "$fixture_root/examples/10_tooling" \
        "$output/stage2/$platform" "$output/logs/$platform" \
        "$stage3/stage2-admitted" "$runtime" \
        "$stage3/stage2-native-cache" "$stage3/stage3-native-cache" \
        "$stage3/stage2-home" "$stage3/stage2-tmp"
    cp "$root/scripts/bootstrap/resume-stage3-from-admitted.sh" \
        "$fixture_root/scripts/bootstrap/"
    cp "$root/scripts/bootstrap/run-process-group-bounded-log.pl" \
        "$fixture_root/scripts/bootstrap/"
    printf '#!/bin/sh\nexit 99\n' \
        >"$fixture_root/scripts/bootstrap/bootstrap-from-scratch.sh"
    chmod +x "$fixture_root/scripts/bootstrap/bootstrap-from-scratch.sh"
    write_fake_facade \
        "$fixture_root/scripts/check/lib/bootstrap-stage3-provenance.shs"
    cat >"$fixture_root/scripts/check/lib/bootstrap-planner-admission-bound.shs" <<'PLANNER'
bootstrap_planner_v2_verify() { return 0; }
bootstrap_planner_v2_verify_parent_compiler_binding() { return 0; }
bootstrap_planner_v2_field() {
    [ "$1" = target ] || return 1
    echo //bootstrap:stage3
}
PLANNER
    planner_receipt="$stage3/planner-admission-v2.env"
    printf 'fixture-planner-admission\n' >"$planner_receipt"
    cat >"$fixture_root/scripts/check/cert/redeploy_gate/candidate_frontend_admission.shs" <<'ADMISSION'
candidate_frontend_smoke() {
  if [ -n "${CANDIDATE_FRONTEND_LOG_PATH:-}" ] &&
     [ -n "${CANDIDATE_FRONTEND_STATUS_PATH:-}" ]; then
    for probe in p2_add stage2_mir_retention stage2_module_path_naming hello_world_positional; do
      case "$probe" in p2_add) probe_log=$CANDIDATE_FRONTEND_LOG_PATH ;; *) probe_log=$CANDIDATE_FRONTEND_LOG_PATH.$(printf '%s' "$probe" | tr _ -) ;; esac
      printf 'probe=%s\n' "$probe" >"$probe_log"
      probe_sha=$(sha256sum -- "$probe_log" | awk '{print $1}')
      printf '%s\n' schema=simple-bounded-process-log-v1 status=complete reason=child-exit raw_status=0 \
        max_bytes=4194304 "bytes_captured=$(wc -c <"$probe_log" | tr -d ' ')" timeout_seconds=180 \
        term_grace_seconds=1 combined_stream=stdout-stderr process_group=setsid artifact_limit=none \
        "log_leaf=${probe_log##*/}" "log_sha256=$probe_sha" >"$probe_log.bounded.env"
    done
    {
      echo schema=simple-candidate-frontend-status-v2
      echo result=pass
      echo probe=complete
      echo raw_status=0
      echo bootstrap_mode="$CANDIDATE_FRONTEND_BOOTSTRAP"
      echo backend="$CANDIDATE_FRONTEND_BACKEND"
      echo log_path="$CANDIDATE_FRONTEND_LOG_PATH"
      for probe in p2_add stage2_mir_retention stage2_module_path_naming hello_world_positional; do
        case "$probe" in p2_add) probe_log=$CANDIDATE_FRONTEND_LOG_PATH ;; *) probe_log=$CANDIDATE_FRONTEND_LOG_PATH.$(printf '%s' "$probe" | tr _ -) ;; esac
        echo "${probe}_raw_status=0"
        echo "${probe}_log_path=$probe_log"
        echo "${probe}_log_sha256=$(sha256sum -- "$probe_log" | awk '{print $1}')"
        echo "${probe}_collector_receipt_path=$probe_log.bounded.env"
        echo "${probe}_collector_receipt_sha256=$(sha256sum -- "$probe_log.bounded.env" | awk '{print $1}')"
      done
    } >"$CANDIDATE_FRONTEND_STATUS_PATH"
  fi
  echo frontend-smoke
}
run_timeout() { shift; "$@"; }
ADMISSION
    printf 'compiler\n' >"$fixture_root/src/compiler/input.spl"
    printf 'app\n' >"$fixture_root/src/app/input.spl"
    printf 'lib\n' >"$fixture_root/src/lib/input.spl"
    printf 'example\n' >"$fixture_root/examples/10_tooling/input.spl"
    printf '%s\n' schema=fake-git-state head=fixture \
        dirty_fingerprint=clean >"$fixture_root/.fixture-git-state.env"

    write_fake_stage2 "$output/stage2/$platform/simple"
    cp "$output/stage2/$platform/simple" "$stage3/stage2-admitted/simple"
    chmod 500 "$stage3/stage2-admitted/simple"
    cat >"$runtime/simple" <<'SEED'
#!/bin/sh
echo seed-invoked >"$(dirname -- "$0")/seed-invoked"
exit 97
SEED
    chmod +x "$runtime/simple"
    printf 'native-all\n' >"$runtime/libsimple_native_all.a"
    printf 'backfill\n' >"$runtime/libsimple_compiler_backfill.a"
    printf 'inputs_fingerprint=%064d\n' 0 >"$runtime/simple.inputs.sha256"

    BOOTSTRAP_STAGE3_FACADE_PATH=\
"$fixture_root/scripts/check/lib/bootstrap-stage3-provenance.shs"
    export BOOTSTRAP_STAGE3_FACADE_PATH
    # shellcheck disable=SC1090
    . "$BOOTSTRAP_STAGE3_FACADE_PATH"
    bootstrap_stage3_directory_snapshot "$stage3/runtime-admitted.txt" "$runtime"
    cp "$stage3/runtime-admitted.txt" "$stage3/runtime-origin-before.txt"
    cp "$stage3/runtime-admitted.txt" "$stage3/runtime-origin-after.txt"
    bootstrap_stage3_source_snapshot "$stage3/source-inputs-before.txt" \
        "$fixture_root"
    bootstrap_stage3_git_state "$fixture_root" "$stage3/git-state-before.env"
    bootstrap_stage3_tool_authority_snapshot \
        "$stage3/tool-authority-before.txt" "$PATH" "$fixture_root"
    cp "$stage3/runtime-admitted.txt" "$stage3/runtime-before-stage2.txt"
    cp "$stage3/runtime-admitted.txt" "$stage3/runtime-after-stage2.txt"
    stage2_sha=$(bootstrap_stage3_hash_file "$output/stage2/$platform/simple")
    sanity="$stage3/stage2-sanity.env"
    printf 'frontend-smoke\nfrontend-smoke\n' >"$sanity.frontend-driver.log"
    for sanity_mode in 0 1; do
        mode_log="$sanity.frontend-bootstrap-$sanity_mode.log"
        for probe in p2_add stage2_mir_retention stage2_module_path_naming hello_world_positional; do
            case "$probe" in p2_add) probe_log=$mode_log ;; *) probe_log=$mode_log.$(printf '%s' "$probe" | tr _ -) ;; esac
            printf 'probe=%s\n' "$probe" >"$probe_log"
            probe_sha=$(bootstrap_stage3_hash_file "$probe_log")
            printf '%s\n' schema=simple-bounded-process-log-v1 status=complete reason=child-exit raw_status=0 \
                max_bytes=4194304 "bytes_captured=$(wc -c <"$probe_log" | tr -d ' ')" timeout_seconds=180 \
                term_grace_seconds=1 combined_stream=stdout-stderr process_group=setsid artifact_limit=none \
                "log_leaf=${probe_log##*/}" "log_sha256=$probe_sha" >"$probe_log.bounded.env"
        done
        cat >"$sanity.frontend-bootstrap-$sanity_mode.status.env" <<STATUS
schema=simple-candidate-frontend-status-v2
result=pass
probe=complete
raw_status=0
bootstrap_mode=$sanity_mode
backend=cranelift
log_path=$mode_log
p2_add_raw_status=0
p2_add_log_path=$mode_log
p2_add_log_sha256=$(bootstrap_stage3_hash_file "$mode_log")
p2_add_collector_receipt_path=$mode_log.bounded.env
p2_add_collector_receipt_sha256=$(bootstrap_stage3_hash_file "$mode_log.bounded.env")
stage2_mir_retention_raw_status=0
stage2_mir_retention_log_path=$mode_log.stage2-mir-retention
stage2_mir_retention_log_sha256=$(bootstrap_stage3_hash_file "$mode_log.stage2-mir-retention")
stage2_mir_retention_collector_receipt_path=$mode_log.stage2-mir-retention.bounded.env
stage2_mir_retention_collector_receipt_sha256=$(bootstrap_stage3_hash_file "$mode_log.stage2-mir-retention.bounded.env")
stage2_module_path_naming_raw_status=0
stage2_module_path_naming_log_path=$mode_log.stage2-module-path-naming
stage2_module_path_naming_log_sha256=$(bootstrap_stage3_hash_file "$mode_log.stage2-module-path-naming")
stage2_module_path_naming_collector_receipt_path=$mode_log.stage2-module-path-naming.bounded.env
stage2_module_path_naming_collector_receipt_sha256=$(bootstrap_stage3_hash_file "$mode_log.stage2-module-path-naming.bounded.env")
hello_world_positional_raw_status=0
hello_world_positional_log_path=$mode_log.hello-world-positional
hello_world_positional_log_sha256=$(bootstrap_stage3_hash_file "$mode_log.hello-world-positional")
hello_world_positional_collector_receipt_path=$mode_log.hello-world-positional.bounded.env
hello_world_positional_collector_receipt_sha256=$(bootstrap_stage3_hash_file "$mode_log.hello-world-positional.bounded.env")
STATUS
    done
    cat >"$stage3/stage2-sanity.env" <<SANITY
schema=simple-bootstrap-sanity-evidence-v1
status=pass
candidate_sha256_before=$stage2_sha
version_status=0
version_output=simple-bootstrap 1.0.0-beta
unsupported_status=1
unsupported_output_sha256=$(printf "unknown command 'run'" | bootstrap_stage3_hash_stream)
frontend_smoke_status=0
frontend_smoke_backend=cranelift
frontend_smoke_bootstrap_mode_status=0
frontend_smoke_bootstrap0_raw_status=0
frontend_smoke_bootstrap0_log_path=$sanity.frontend-bootstrap-0.log
frontend_smoke_bootstrap0_log_sha256=$(bootstrap_stage3_hash_file "$sanity.frontend-bootstrap-0.log")
frontend_smoke_bootstrap0_status_path=$sanity.frontend-bootstrap-0.status.env
frontend_smoke_bootstrap0_status_sha256=$(bootstrap_stage3_hash_file "$sanity.frontend-bootstrap-0.status.env")
frontend_smoke_bootstrap1_ran=true
frontend_smoke_bootstrap1_raw_status=0
frontend_smoke_bootstrap1_log_path=$sanity.frontend-bootstrap-1.log
frontend_smoke_bootstrap1_log_sha256=$(bootstrap_stage3_hash_file "$sanity.frontend-bootstrap-1.log")
frontend_smoke_bootstrap1_status_path=$sanity.frontend-bootstrap-1.status.env
frontend_smoke_bootstrap1_status_sha256=$(bootstrap_stage3_hash_file "$sanity.frontend-bootstrap-1.status.env")
frontend_smoke_output_sha256=$(bootstrap_stage3_hash_file "$sanity.frontend-driver.log")
frontend_smoke_driver_log_path=$sanity.frontend-driver.log
frontend_smoke_driver_log_sha256=$(bootstrap_stage3_hash_file "$sanity.frontend-driver.log")
candidate_sha256_after=$stage2_sha
SANITY
    printf 'receiver PASS\n' >"$stage3/stage2-receiver.log"
    cat >"$stage3/stage2-receiver.env" <<RECEIVER
schema=simple-bootstrap-stage2-receiver-evidence-v1
status=pass
probe_exit=0
candidate_sha256_before=$stage2_sha
candidate_sha256_after=$stage2_sha
runtime_snapshot_sha256=$(bootstrap_stage3_hash_file "$stage3/runtime-admitted.txt")
probe_log=$stage3/stage2-receiver.log
probe_log_sha256=$(bootstrap_stage3_hash_file "$stage3/stage2-receiver.log")
RECEIVER
    cat >"$stage3/stage2-admitted/admission.env" <<ADMISSION_RECEIPT
schema=simple-bootstrap-stage2-admission-fixture-v1
status=admitted
candidate_sha256=$stage2_sha
ADMISSION_RECEIPT
    stage2_cache_path="$stage3/stage2-native-cache"
    stage2_output_path="$output/stage2/$platform/simple"
    cat >"$stage3/stage2-command.transcript" <<TRANSCRIPT
host:HOME:$stage3/stage2-home
host:TMPDIR:$stage3/stage2-tmp
host:PATH:$PATH
explicit-env:14:RUST_LOG=error
explicit-env:13:LIBRARY_PATH=
explicit-env:42:SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=absent
explicit-env:18:SIMPLE_BOOTSTRAP=1
explicit-env:31:SIMPLE_NO_DEPRECATED_WARNINGS=1
explicit-env:26:SIMPLE_NATIVE_BUILD_RUST=1
explicit-env:25:SIMPLE_NO_STUB_FALLBACK=1
explicit-env:30:SIMPLE_BUILD_PROGRESS_EVENTS=0
explicit-env:$((21 + ${#runtime})):SIMPLE_BINARY=$runtime/simple
argv:12:native-build
argv:8:--target
argv:24:$platform
argv:9:--backend
argv:9:cranelift
argv:16:--runtime-bundle
argv:16:core-c-bootstrap
argv:8:--source
argv:12:src/compiler
argv:8:--source
argv:7:src/app
argv:8:--source
argv:7:src/lib
argv:15:--entry-closure
argv:9:--threads
argv:1:1
argv:9:--verbose
argv:11:--cache-dir
argv:${#stage2_cache_path}:$stage2_cache_path
argv:6:--mode
argv:7:dynload
argv:7:--entry
argv:30:src/app/cli/bootstrap_main.spl
argv:14:--runtime-path
argv:${#runtime}:$runtime
argv:2:-o
argv:${#stage2_output_path}:$stage2_output_path
TRANSCRIPT
    printf 'fixture Stage 2 native build\n' \
        >"$output/logs/$platform/stage2-native-build.log"
    printf 'preserve-me\n' >"$stage3/stage3-native-cache/preserved.marker"
}

run_refusal() {
    label=$1
    if SIMPLE_BOOTSTRAP_REASON_RECEIPT="$planner_receipt" \
        sh "$fixture_root/scripts/bootstrap/resume-stage3-from-admitted.sh" \
        build/recovery >"$tmp/$label.out" 2>&1; then
        fail "$label unexpectedly resumed Stage 3"
    fi
    [ ! -e "$stage3/simple" ] || fail "$label produced a candidate"
    [ ! -e "$stage3/stage3-native-build.calls" ] || \
        fail "$label invoked Stage 3"
}

make_fixture success
stage2_before=$(sha256sum "$output/stage2/$platform/simple")
admitted_before=$(sha256sum "$stage3/stage2-admitted/simple")
SIMPLE_BOOTSTRAP_REASON_RECEIPT="$planner_receipt" \
sh "$fixture_root/scripts/bootstrap/resume-stage3-from-admitted.sh" \
    build/recovery >"$tmp/success.out" 2>&1
[ -x "$stage3/simple" ] || fail "resume did not produce Stage 3"
[ "$(sed -n 's/^status=//p' "$stage3/provenance.env")" = pass ] || \
    fail "resume did not write passing provenance"
[ -f "$stage3/provenance.env.verified" ] || fail "manifest was not verified"
stage3_status="$stage3/stage3-native-build-status.env"
[ "$(sed -n 's/^schema=//p' "$stage3_status")" = \
    simple-bootstrap-stage3-native-build-status-v1 ] || fail "native-build status schema mismatch"
[ "$(sed -n 's/^status=//p' "$stage3_status")" = pass ] || fail "native-build status not passing"
[ "$(sed -n 's/^shell_exit_status=//p' "$stage3_status")" = 0 ] || fail "native-build shell status nonzero"
[ "$(sed -n 's/^effective_exit_status=//p' "$stage3_status")" = 0 ] || fail "native-build effective status nonzero"
[ "$(sed -n 's/^log_sha256=//p' "$stage3_status")" = \
    "$(bootstrap_stage3_hash_file "$output/logs/$platform/stage3-native-build.log")" ] || fail "native-build log hash mismatch"
[ "$(sed -n 's/^transcript_sha256=//p' "$stage3_status")" = \
    "$(bootstrap_stage3_hash_file "$stage3/stage3-command.transcript")" ] || fail "native-build transcript hash mismatch"
[ "$(wc -l <"$fixture_root/stage2-sanity-replay.events")" = 1 ] || \
    fail "Stage 2 sanity was not replayed exactly once before recovery"
[ "$(wc -l <"$stage3/stage3-native-build.calls")" = 1 ] || \
    fail "recovery did not invoke exactly one Stage 3 build"
grep -F -- "-o $stage3/simple" "$stage3/stage3-native-build.calls" >/dev/null || \
    fail "recovery build did not target Stage 3"
grep -F 'SIMPLE_NO_STUB_FALLBACK=1' "$stage3/stage3-command.transcript" >/dev/null || \
    fail "recovery omitted no-stub-fallback"
grep -F "SIMPLE_BINARY=$stage3/stage2-admitted/simple" \
    "$stage3/stage3-command.transcript" >/dev/null || \
    fail "recovery did not use admitted Stage 2"
[ -e "$stage3/stage3-native-cache/preserved.marker" ] || \
    fail "default recovery did not preserve Stage 3 cache"
[ -d "$stage3/recovery-threads1" ] || \
    fail "default recovery omitted safe recovery directory"
[ "$(find "$stage3/recovery-threads1" -name preserved.marker | wc -l)" = 0 ] || \
    fail "default recovery archived the live Stage 3 cache marker"
[ ! -e "$runtime/seed-invoked" ] || fail "recovery fell back to seed"
[ "$stage2_before" = "$(sha256sum "$output/stage2/$platform/simple")" ] || \
    fail "recovery changed Stage 2"
[ "$admitted_before" = "$(sha256sum "$stage3/stage2-admitted/simple")" ] || \
    fail "recovery changed admitted Stage 2"
[ ! -e "$output.lock" ] || fail "recovery leaked its output lock"

make_fixture fresh-cache
RESUME_STAGE3_FRESH_CACHE=1 SIMPLE_BOOTSTRAP_REASON_RECEIPT="$planner_receipt" \
sh "$fixture_root/scripts/bootstrap/resume-stage3-from-admitted.sh" \
    build/recovery >"$tmp/fresh-cache.out" 2>&1
[ ! -e "$stage3/stage3-native-cache/preserved.marker" ] || \
    fail "fresh-cache recovery reused stale Stage 3 cache"

make_fixture preexisting-recovery
mkdir "$stage3/recovery-threads1"
printf 'keep\n' >"$stage3/recovery-threads1/sentinel"
SIMPLE_BOOTSTRAP_REASON_RECEIPT="$planner_receipt" \
sh "$fixture_root/scripts/bootstrap/resume-stage3-from-admitted.sh" \
    build/recovery >"$tmp/preexisting-recovery.out" 2>&1
[ "$(cat "$stage3/recovery-threads1/sentinel")" = keep ] || \
    fail "resume did not reuse the real recovery directory safely"

make_fixture hash-mismatch
printf 'tampered\n' >>"$output/stage2/$platform/simple"
run_refusal hash-mismatch

make_fixture git-state-drift
printf '%s\n' schema=fake-git-state head=changed \
    dirty_fingerprint=clean >"$fixture_root/.fixture-git-state.env"
run_refusal git-state-drift

make_fixture git-dirty-fingerprint-drift
printf '%s\n' schema=fake-git-state head=fixture \
    dirty_fingerprint=changed >"$fixture_root/.fixture-git-state.env"
run_refusal git-dirty-fingerprint-drift

make_fixture git-receipt-tampered
printf '%s\n' schema=fake-git-state head=tampered \
    dirty_fingerprint=clean >"$stage3/git-state-before.env"
run_refusal git-receipt-tampered

make_fixture stale-runtime
printf 'stale\n' >>"$runtime/libsimple_native_all.a"
run_refusal stale-runtime

make_fixture symlink-receipt
mv "$stage3/stage2-sanity.env" "$stage3/stage2-sanity.real"
ln -s stage2-sanity.real "$stage3/stage2-sanity.env"
run_refusal symlink-receipt

make_fixture symlink-recovery
external_recovery="$tmp/symlink-recovery-external"
mkdir "$external_recovery"
printf 'unchanged\n' >"$external_recovery/sentinel"
ln -s "$external_recovery" "$stage3/recovery-threads1"
run_refusal symlink-recovery
[ "$(cat "$external_recovery/sentinel")" = unchanged ] || \
    fail "symlink recovery target was modified"
[ ! -e "$stage3/simple" ] || fail "symlink recovery produced Stage 3"

make_fixture locked-output
mkdir "$output.lock"
run_refusal locked-output
[ -d "$output.lock" ] || fail "foreign lock was removed"

make_fixture symlink-lock
ln -s "$tmp" "$output.lock"
run_refusal symlink-lock
[ -L "$output.lock" ] || fail "foreign symlink lock was removed"

echo "PASS: Stage 3 resumes only from admitted Stage 2 and refuses unsafe evidence"
