#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT INT TERM

# The fixtures below build real symlinks, including deliberately DANGLING ones
# (link-missing-hex); Windows shells cannot create either by default.
. "$root/scripts/check/lib/portable-symlink-mode.shs"
. "$root/scripts/check/lib/bootstrap-stage3/authority.shs"
. "$root/scripts/check/lib/bootstrap-stage3/command-snapshot.shs"

mkdir -p "$tmp/repo/src/compiler" "$tmp/repo/src/app" \
  "$tmp/repo/src/lib/shared" "$tmp/repo/examples/10_tooling"
printf 'one\n' >"$tmp/repo/src/lib/shared/value.spl"
ln -s ../lib/shared "$tmp/repo/src/app/shared"
ln -s ../lib/shared/value.spl "$tmp/repo/src/app/value.spl"
ln -s ../compiler "$tmp/repo/src/app/compiler"
ln -s ../lib/shared/missing.spl "$tmp/repo/src/app/missing.spl"
ln -s ../../examples/missing/tool "$tmp/repo/src/app/missing-example"

bootstrap_stage3_source_snapshot "$tmp/before" "$tmp/repo"
grep -q '^link-dir-hex:' "$tmp/before"
grep -q '^link-hex:' "$tmp/before"
grep -q '^link-missing-hex:' "$tmp/before"

printf 'two\n' >"$tmp/repo/src/lib/shared/value.spl"
bootstrap_stage3_source_snapshot "$tmp/after" "$tmp/repo"
! cmp -s "$tmp/before" "$tmp/after"

mkdir -p "$tmp/repo/src/app/vscode_extension/node_modules/pkg"
printf 'hidden\n' \
  >"$tmp/repo/src/app/vscode_extension/node_modules/pkg/input.spl"
ln -s vscode_extension/node_modules/pkg "$tmp/repo/src/app/pruned"
! bootstrap_stage3_source_snapshot "$tmp/pruned" "$tmp/repo" >/dev/null 2>&1
rm "$tmp/repo/src/app/pruned"

mkdir "$tmp/outside"
ln -s "$tmp/outside" "$tmp/repo/src/app/external"
! bootstrap_stage3_source_snapshot "$tmp/external" "$tmp/repo" >/dev/null 2>&1
rm "$tmp/repo/src/app/external"

ln -s "$tmp/outside" "$tmp/repo/vendor"
ln -s ../../vendor/missing.spl "$tmp/repo/src/app/missing-external.spl"
! bootstrap_stage3_source_snapshot "$tmp/missing-external" \
  "$tmp/repo" >/dev/null 2>&1
rm "$tmp/repo/src/app/missing-external.spl" "$tmp/repo/vendor"

mkdir "$tmp/outside/dir"
ln -s "$tmp/outside/dir" "$tmp/repo/bridge"
ln -s ../../bridge/../payload "$tmp/repo/src/app/missing-dotdot-external"
! bootstrap_stage3_source_snapshot "$tmp/missing-dotdot-external" \
  "$tmp/repo" >/dev/null 2>&1

echo "bootstrap_stage3_source_snapshot=true"
