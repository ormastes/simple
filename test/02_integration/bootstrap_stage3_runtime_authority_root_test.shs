#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT INT TERM

. "$root/scripts/check/lib/bootstrap-stage3/authority.shs"

mkdir -p "$tmp/physical/deps" "$tmp/admitted"
printf 'runtime\n' >"$tmp/physical/libsimple_runtime.a"
printf 'compiler\n' >"$tmp/physical/deps/libsimple_compiler.a"
ln -s "$tmp/physical" "$tmp/runtime-root"

physical=$(bootstrap_stage3_physical_directory "$tmp/runtime-root")
[ "$physical" = "$tmp/physical" ]
bootstrap_stage3_directory_snapshot "$tmp/root.snapshot" "$physical"
grep -q '^file-hex:' "$tmp/root.snapshot"

# The strict snapshot helper still rejects an unresolved root symlink.
! bootstrap_stage3_directory_snapshot "$tmp/link.snapshot" \
    "$tmp/runtime-root" >/dev/null 2>&1

# Root resolution must not weaken rejection of symlinks within the authority.
ln -s deps/libsimple_compiler.a "$tmp/physical/libsimple_compiler.a"
! bootstrap_stage3_directory_snapshot "$tmp/interior.snapshot" "$physical" \
    >/dev/null 2>&1
rm "$tmp/physical/libsimple_compiler.a"

ln -s "$tmp/missing" "$tmp/broken-root"
! bootstrap_stage3_physical_directory "$tmp/broken-root" >/dev/null 2>&1

echo "bootstrap_stage3_runtime_authority_root=true"
