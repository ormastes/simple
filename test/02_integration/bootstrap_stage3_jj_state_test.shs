#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT INT TERM

. "$root/scripts/check/lib/bootstrap-stage3/authority.shs"

jj git init "$tmp/repo" >/dev/null
[ -d "$tmp/repo/.jj" ]
printf 'one\n' >"$tmp/repo/source.spl"

bootstrap_stage3_git_state "$tmp/repo" "$tmp/state-1"
bootstrap_stage3_git_state "$tmp/repo" "$tmp/state-2"
cmp -s "$tmp/state-1" "$tmp/state-2"
fingerprint_1=$(sed -n 's/^dirty_fingerprint=//p' "$tmp/state-1")

printf 'two\n' >"$tmp/repo/source.spl"
bootstrap_stage3_git_state "$tmp/repo" "$tmp/state-3"
! cmp -s "$tmp/state-1" "$tmp/state-3"
fingerprint_3=$(sed -n 's/^dirty_fingerprint=//p' "$tmp/state-3")
[ "$fingerprint_1" != "$fingerprint_3" ]

grep -Eq '^head=[0-9a-f]{40}$' "$tmp/state-3"
grep -Eq '^dirty_fingerprint=[0-9a-f]{64}$' "$tmp/state-3"

real_jj=$(command -v jj)
mkdir "$tmp/bin"
cat >"$tmp/bin/jj" <<'EOF'
#!/bin/sh
for arg in "$@"; do
  if [ "$arg" = log ]; then
    "$REAL_JJ" "$@"
    printf 'concurrent\n' >"$JJ_TEST_REPO/concurrent.spl"
    "$REAL_JJ" --no-pager -R "$JJ_TEST_REPO" status >/dev/null
    exit
  fi
done
exec "$REAL_JJ" "$@"
EOF
chmod +x "$tmp/bin/jj"
REAL_JJ=$real_jj JJ_TEST_REPO="$tmp/repo" PATH="$tmp/bin:$PATH" \
  bootstrap_stage3_git_state "$tmp/repo" "$tmp/state-concurrent"
captured_head=$(sed -n 's/^head=//p' "$tmp/state-concurrent")
"$real_jj" --ignore-working-copy --no-pager --color=never \
  -R "$tmp/repo" diff --git -r "$captured_head" >"$tmp/captured.diff"
printf 'jj-working-copy-diff-sha256=%s\n' \
  "$(bootstrap_stage3_hash_file "$tmp/captured.diff")" >"$tmp/captured.records"
expected_fingerprint=$(bootstrap_stage3_hash_file "$tmp/captured.records")
grep -Fqx "dirty_fingerprint=$expected_fingerprint" "$tmp/state-concurrent"

jj -R "$tmp/repo" config set --repo snapshot.max-new-file-size 1
printf 'oversized\n' >"$tmp/repo/oversized.spl"
! bootstrap_stage3_git_state "$tmp/repo" "$tmp/state-oversized"

echo "bootstrap_stage3_jj_state=true"
