# P11 — fusion golden fixture: `fusion_results.json` (checked in before this
# session) records the honest status
# "not_evidence_until_rank_sources_exist" — RRF evidence is not itself a
# provider-supplied Wave 4 lexical score, and this session's P4 landing of
# `rrf.spl`/`graph_source.spl` does not manufacture a real ranked lexical
# source to fuse. P11 owns proving that (a) the fixture still states its
# honest gap verbatim (catches a silent "upgrade to fake PASS" regression),
# and (b) the `rrf-fixed-v1` mechanism itself is real and callable, pinning
# the §10.1 contract points that do not depend on a real lexical source:
# default k=60, one-based fused ranks starting at 2 when a rank-1 slot is
# reserved for pinned identity, and stable tie-break by document ID ascending.
use std.spec.{describe, it, expect}
use std.fs.{read_file}
use std.common.json.parser.{json_parse_with_error}
use lib.common.search.fusion_types.{FusionSourceV1, SourceCandidateV1, SourceRankingV1}
use app.spipe.fusion.rrf.{fuse, RRF_SCALE}

val FIXTURE_PATH: text = "examples/05_stdlib/spipe/test/fixture/wave4_search/fusion_results.json"

fn lexical_ranking(ids_in_rank_order: [text]) -> SourceRankingV1:
    var candidates: [SourceCandidateV1] = []
    var i = 0
    while i < ids_in_rank_order.len():
        candidates.push(SourceCandidateV1(document_id: ids_in_rank_order[i],
            source_rank: i + 1, source_score_milli: 0))
        i = i + 1
    SourceRankingV1(source: FusionSourceV1.Lexical, source_contract: "test",
        snapshot_id: "s1", scope_digest: "sha256:" + "0" * 64,
        candidates: candidates, complete: true, source_digest: "sha256:" + "0" * 64)

describe "SPipe fusion golden fixture stays honest until a real rank source exists":
    it "still declares not_evidence_until_rank_sources_exist for the golden fixture, verbatim":
        val fixture_text = read_file(FIXTURE_PATH)
        val parsed = json_parse_with_error(fixture_text)
        expect(parsed.1).to_equal("")
        expect(fixture_text).to_contain("\"schema\":\"spipe-search-fusion-results-v1\"")
        expect(fixture_text).to_contain("\"fixture_id\":\"spipe-wave4-search-golden-v1\"")
        expect(fixture_text).to_contain("\"status\":\"not_evidence_until_rank_sources_exist\"")
        expect(fixture_text).to_contain("\"k\":60")

    it "fuse() with one source starts at rank 1 and preserves source-local order":
        val result = fuse([lexical_ranking(["A-ascii", "A-é"])], 60, 1000, 1)
        expect(result.is_ok()).to_equal(true)
        val hits = result.unwrap()
        expect(hits.len()).to_equal(2)
        expect(hits[0].document_id).to_equal("A-ascii")
        expect(hits[0].final_rank).to_equal(1)
        expect(hits[0].rrf_raw_scaled).to_equal(RRF_SCALE / 61)
        expect(hits[1].document_id).to_equal("A-é")
        expect(hits[1].final_rank).to_equal(2)

    it "fuse() starting at rank 2 reserves rank 1 for an exact-identity pin":
        val result = fuse([lexical_ranking(["A-ascii", "A-é"])], 60, 1000, 2)
        val hits = result.unwrap()
        expect(hits[0].final_rank).to_equal(2)
        expect(hits[1].final_rank).to_equal(3)

    it "breaks equal-contribution ties by ascending document ID, deterministically":
        # Two disjoint single-candidate sources with equal source_rank produce
        # equal rrf contributions for two different document IDs; the tie
        # must resolve the same way every time, by document ID ascending.
        val lexical = SourceRankingV1(source: FusionSourceV1.Lexical,
            source_contract: "test", snapshot_id: "s1",
            scope_digest: "sha256:" + "0" * 64,
            candidates: [SourceCandidateV1(document_id: "Z-last", source_rank: 1, source_score_milli: 0)],
            complete: true, source_digest: "sha256:" + "0" * 64)
        val graph = SourceRankingV1(source: FusionSourceV1.Graph,
            source_contract: "test", snapshot_id: "s1",
            scope_digest: "sha256:" + "0" * 64,
            candidates: [SourceCandidateV1(document_id: "A-first", source_rank: 1, source_score_milli: 0)],
            complete: true, source_digest: "sha256:" + "0" * 64)
        val result = fuse([lexical, graph], 60, 1000, 1)
        val hits = result.unwrap()
        expect(hits.len()).to_equal(2)
        expect(hits[0].rrf_raw_scaled).to_equal(hits[1].rrf_raw_scaled)
        expect(hits[0].document_id).to_equal("A-first")
        expect(hits[1].document_id).to_equal("Z-last")
    return ()
