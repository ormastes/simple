use std.spec.*
use std.http_server.types.{HttpResponseData}
use std.http_server.response.{serialize_response_for_method, add_keepalive_headers}

fn async_framing_response(status: i64, body: text, chunked: bool) -> HttpResponseData:
    HttpResponseData(
        status: status,
        reason: if status == 204: "No Content" elif status == 304: "Not Modified" else: "OK",
        headers: [
            ("Content-Length", "999"),
            ("Transfer-Encoding", "chunked"),
            ("Trailer", "Digest"),
            ("Connection", "close"),
            ("Keep-Alive", "timeout=999"),
            ("Proxy-Connection", "keep-alive"),
            ("X-Response-Owner", "async")
        ],
        body: body,
        body_bytes: [],
        body_file: "",
        body_offset: 0,
        body_length: 0,
        chunked: chunked
    )

describe "Event-driven HTTP response body framing":
    it "preserves HEAD metadata without transferring payload bytes":
        val wire = serialize_response_for_method(
            async_framing_response(200, "hello", false), "HEAD")
        expect(wire).to_contain("Content-Length: 5\r\n")
        expect(wire.contains("\r\n\r\nhello")).to_equal(false)
        expect(wire).to_contain("X-Response-Owner: async\r\n")

    it "forbids payload and all framing fields on 204":
        val wire = serialize_response_for_method(
            async_framing_response(204, "smuggled", true), "GET")
        expect(wire.contains("smuggled")).to_equal(false)
        expect(wire.contains("Content-Length:")).to_equal(false)
        expect(wire.contains("Transfer-Encoding:")).to_equal(false)
        expect(wire.contains("Trailer:")).to_equal(false)

    it "retains selected representation length but no payload on 304":
        val wire = serialize_response_for_method(
            async_framing_response(304, "selected", false), "GET")
        expect(wire).to_contain("Content-Length: 8\r\n")
        expect(wire.contains("\r\n\r\nselected")).to_equal(false)

        val metadata_only = async_framing_response(304, "", false)
        val metadata_wire = serialize_response_for_method(metadata_only, "GET")
        expect(metadata_wire).to_contain("Content-Length: 999\r\n")

    it "does not claim an unimplemented chunk transfer coding":
        val wire = serialize_response_for_method(
            async_framing_response(200, "hello", true), "GET")
        expect(wire).to_contain("Content-Length: 5\r\n")
        expect(wire.contains("Transfer-Encoding:")).to_equal(false)
        expect(wire.contains("Trailer:")).to_equal(false)
        expect(wire).to_contain("\r\n\r\nhello")

    it "replaces application connection lifecycle fields":
        val normalized = add_keepalive_headers(
            async_framing_response(200, "hello", false), true, 15)
        val wire = serialize_response_for_method(normalized, "GET")
        expect(wire).to_contain("Connection: keep-alive\r\n")
        expect(wire).to_contain("Keep-Alive: timeout=15\r\n")
        expect(wire.contains("Connection: close")).to_equal(false)
        expect(wire.contains("timeout=999")).to_equal(false)
        expect(wire.contains("Proxy-Connection:")).to_equal(false)
