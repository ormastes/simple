"""
## Purpose and audience
Pins the observable execution contract of the CoreIntegration subsystem spec lane
(core_integration_49_spec.spl): every scenario asserts a concrete language/stdlib outcome the runner
must report green for this subsystem spec to carry evidence weight.
Audience: compiler and test-infrastructure engineers triaging the CoreIntegration lane.
## Operator workflow
Run `bin/simple test test/integration/core/core_integration_49_spec.spl` and read the per-scenario verdicts in the
`Results:` summary; each scenario asserts one externally visible outcome.
## Compatibility and limitations
Covers interpreter-path semantics exercised by this lane; native codegen
and performance envelopes are out of scope.
# @manual: primary
REQ-SYS-CoreIntegration-001
doc/01_research/local/CoreIntegration_lane.md
doc/03_plan/sys_test/CoreIntegration_lane.md
doc/04_architecture/CoreIntegration_lane.md
doc/05_design/CoreIntegration_lane.md
"""
# @req: REQ-SYS-CoreIntegration-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%

use std.spec

describe "CoreIntegration subsystem spec execution contract":
    it "trim removes surrounding padding only":
        step("Verify: trim removes surrounding padding only")
        # @req: REQ-SYS-CoreIntegration-001
        val padded = "  payload  "
        expect(padded.trim()).to_equal("payload") # oracle: exact trimmed value
        expect(padded.trim().len()).to_equal(7) # oracle: "payload" has 7 chars

    it "option match binds the carried payload":
        step("Verify: option match binds the carried payload")
        # @req: REQ-SYS-CoreIntegration-002
        val opt = Some(41)
        match opt:
            Some(v):
                expect(v + 1).to_equal(42) # oracle: payload is 41
            nil:
                expect(false).to_equal(true) # oracle: nil arm must not run

    it "repetition via loop builds the expected run":
        step("Verify: repetition via loop builds the expected run")
        # @req: REQ-SYS-CoreIntegration-003
        var run = ""
        for i in 0..4:
            run = run + "ab"
        expect(run.len()).to_equal(8) # oracle: 4 iterations x 2 chars
        expect(run).to_equal("abababab")

    it "arithmetic precedence binds multiplication before addition":
        step("Verify: arithmetic precedence binds multiplication before addition")
        # @req: REQ-SYS-CoreIntegration-004
        expect(2 + 3 * 4).to_equal(14) # oracle: precedence, not left-to-right (would be 20)
        expect((2 + 3) * 4).to_equal(20) # oracle: parenthesised grouping

    it "loop accumulation sums the inclusive range 0..4":
        step("Verify: loop accumulation sums the inclusive range 0..4")
        # @req: REQ-SYS-CoreIntegration-005
        var total = 0
        for i in 0..5:
            total = total + i
        expect(total).to_equal(10) # oracle: 0+1+2+3+4 = 10

