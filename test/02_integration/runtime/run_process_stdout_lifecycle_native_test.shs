#!/bin/sh
# Runner for process_stdout_lifecycle_native.c (process_stdout_result_eof_drain_race_2026_10_12):
# includes the real runtime_process.c with OS-call fault injection, links the
# real runtime_process_tree.c, and runs under an outer 15-second timeout.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
test_dir=$(mktemp -d)
trap 'rm -rf "$test_dir"' EXIT HUP INT TERM

link_gc=-Wl,--gc-sections
if [ "$(uname -s)" = Darwin ]; then
    link_gc=-Wl,-dead_strip
fi

cc -O1 -g -std=gnu11 -ffunction-sections -fdata-sections -fno-omit-frame-pointer \
    -Werror=implicit-function-declaration -pthread \
    -I "$repo_root/src/runtime" \
    "$repo_root/test/02_integration/runtime/process_stdout_lifecycle_native.c" \
    "$repo_root/src/runtime/runtime_process_tree.c" \
    "$link_gc" -pthread \
    -o "$test_dir/process_stdout_lifecycle_native"

timeout 15 "$test_dir/process_stdout_lifecycle_native"
