# Real native core-C text/array ABI probe; synthetic provider validates bytes.
extern fn rt_vulkan_create_compute_pipeline(shader: i64, entry: text, push: i64) -> i64
extern fn rt_vulkan_compile_glsl(source: text) -> i64
extern fn rt_vulkan_push_constants(cmd: i64, pipe: i64, data: [u8]) -> i64
extern fn rt_vulkan_push_constants_array(cmd: i64, pipe: i64, data: [u8], count: i64) -> i64
extern fn rt_vulkan_present_buffer_regions(sc: i64, buffer: i64, w: i64, h: i64, revision: i64, rects: [i64]) -> i64

pub fn phase2_gpu_vulkan_pipeline_probe() -> i64:
    if rt_vulkan_create_compute_pipeline(11, "kernel_entry", 4) != 101:
        return 1
    if rt_vulkan_create_compute_pipeline(11, "", 4) != 0:
        return 2
    if rt_vulkan_create_compute_pipeline(11, "kernel_entry", -1) != 0:
        return 3
    if rt_vulkan_compile_glsl("unsupported shader") != 0:
        return 4
    val data: [u8] = [0, 8, 127, 255]
    if rt_vulkan_push_constants(21, 22, data) != 1:
        return 5
    if rt_vulkan_push_constants_array(21, 22, data, 2) != 1:
        return 6
    if rt_vulkan_push_constants_array(21, 22, data, 5) != 0:
        return 7
    val empty: [u8] = []
    if rt_vulkan_push_constants(21, 22, empty) != 1:
        return 8
    val rects: [i64] = [1, 2, 3, 4, 255, 256, 257, 258]
    if rt_vulkan_present_buffer_regions(31, 32, 640, 480, 33, rects) != 3:
        return 9
    val bad: [i64] = [-1, 2, 3, 4]
    if rt_vulkan_present_buffer_regions(31, 32, 640, 480, 33, bad) != 0:
        return 10
    val short: [i64] = [1, 2, 3]
    if rt_vulkan_present_buffer_regions(31, 32, 640, 480, 33, short) != 0:
        return 11
    return 0

fn main() -> i64:
    phase2_gpu_vulkan_pipeline_probe()
