"""
# Native detached-thread record lifetime

The native probe compiles the current C provider and gates each live worker
before detaching its public handle. Allocation observations assert that the
record survives detach, then the worker is released and must finish before
the final record reclamation receipt is emitted. Both isolated spawn APIs
are exercised. The pre-fix provider aborts at the live-record assertion.

Running the C provider in a child keeps this regression independent of the
SSpec host's runtime version. Compiler failures, crashes, timeouts, missing
scenario receipts, and missing completion receipts all fail the specification.
"""

use std.spec.{describe, it, expect, step}
use std.io_runtime.{process_run_timeout}

describe "Native detached-thread lifetime":
    it "retains live worker state through detach for both spawn APIs":
        step("Compile and execute the production provider with gated native workers")
        val (out, err, code) = process_run_timeout("/bin/sh", ["scripts/check/check-runtime-thread-detach.shs"], 30000)
        expect(code).to_equal(0)

        step("Each detached worker completes before its record is reclaimed")
        expect(out).to_contain("detach_isolated: worker_completed record_reclaimed")
        expect(out).to_contain("detach_with_args: worker_completed record_reclaimed")

        step("Join, completed detach, and failed handle admission also reclaim records")
        expect(out).to_contain("join: result=42 record_reclaimed")
        expect(out).to_contain("detach_completed: record_reclaimed")
        expect(out).to_contain("handle_exhaustion: worker_completed record_reclaimed")
        expect(out).to_contain("runtime thread detach selfcheck: PASS")
