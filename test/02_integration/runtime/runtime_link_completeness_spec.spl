use std.spec

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

"""
## Purpose and audience

Gate for scripts/check/check-runtime-link-completeness.shs: every runtime ABI
symbol declared by the compiler surface (src/compiler, host.spl,
native_build_worker.spl) must be defined by the core-C runtime list, except
the reviewed allowlist of symbols the real stage3 link never references.
Born from bug stage2_runtime_missing_rt_heap_aux_live_bytes_2026-11-02.
Audience: runtime and bootstrap maintainers.
"""

describe "runtime link completeness":
    it "finds no declared-but-undefined runtime symbol in the compiler surface":
        val (out, err, code) = rt_process_run("sh", ["scripts/check/check-runtime-link-completeness.shs"])
        expect(out + err).to_contain("STATUS: PASS")
        expect(out).to_contain("missing=0")
        expect(code).to_equal(0)

    it "lists a declared symbol that no runtime C object defines":
        val (out, err, code) = rt_process_run("sh", ["scripts/check/check-runtime-link-completeness.shs", "--no-allow", "--decl-root", "test/fixtures/runtime_link_completeness"])
        expect(out).to_contain("MISSING rt_link_completeness_fixture_missing_v1")
        expect(out).to_contain("missing=1")
        expect(out).to_contain("STATUS: FAIL")
        expect(code).to_equal(1)
