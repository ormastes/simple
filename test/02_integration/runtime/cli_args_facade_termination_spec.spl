"""
Verify the historical Stage 4 argv facade terminates and preserves the runtime
argument array. Run with a verified self-hosted CLI under an external deadline.
This spec does not by itself certify a newly bootstrapped native artifact.
"""

# @tag: integration, runtime, cli
# @req: REQ-ARGV-FACADE-001
use app.io.cli_ops.{get_args}
use std.io_runtime.{cli_arg_count, cli_arg_at}

describe "CLI argv facade termination":
    it "preserves every argument through repeated facade calls":
        val count = cli_arg_count()
        expect(count).to_be_greater_than(0)
        var repetition = 0
        while repetition < 64:
            val args = get_args()
            expect(args.len()).to_equal(count)
            var index = 0
            while index < count:
                expect(args[index]).to_equal(cli_arg_at(index))
                index = index + 1
            repetition = repetition + 1

    it "keeps invalid scalar indices separate from valid argv entries":
        val args = get_args()
        expect(cli_arg_at(-1)).to_equal("")
        expect(cli_arg_at(args.len())).to_equal("")
        expect(cli_arg_at(args.len() + 1)).to_equal("")
