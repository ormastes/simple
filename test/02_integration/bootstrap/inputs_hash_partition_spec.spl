# @req KPM-REQ-001 KPM-REQ-008 KPM-REQ-009 KPM-NFR-004 KPM-NFR-006
use std.spec.*
use std.io.{file_read}

describe "bootstrap kernel input partition":
    it "uses the fail-closed authoritative closure stream":
        val bootstrap = file_read("scripts/bootstrap/bootstrap-from-scratch.sh") ?? ""
        val helper = file_read("scripts/lib/kernel-closure-inputs.shs") ?? ""
        expect(bootstrap).to_contain("kernel-closure-inputs.shs")
        expect(helper).to_contain("K0|K1")
        expect(helper).to_contain("P-static|P-dyn")
        expect(helper).to_contain("unclassified compiler input")

    it "has a mutation-red host-independent partition checker":
        val checker = file_read("scripts/check/check-bootstrap-kernel-inputs.shs") ?? ""
        expect(checker).to_contain("P-static edit changed kernel inputs hash")
        expect(checker).to_contain("K0 edit did not change kernel inputs hash")
        expect(checker).to_contain("unclassified compiler input was admitted")
