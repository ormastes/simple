# @req MBH-REQ-007 MBH-NFR-004 MBH-NFR-005
describe "macOS M5 universal packaging integration":
    it "rejects invalid slices, stale evidence, mutation, and rebuild promotion":
        val (stdout, stderr, status) = process_run("sh", ["scripts/check/check-macos-universal-m5.shs"])
        expect(status).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("M5 portable structural self-test PASS")
        expect(stdout).to_contain("wrong/missing/same slice")
        expect(stdout).to_contain("retained M4 evidence mutation")
        expect(stdout).to_contain("forged workflow receipt")
        expect(stdout).to_contain("prebuilt helper")
        expect(stdout).to_contain("stale signature/ticket/verification handoff")
        expect(stdout).to_contain("wrong signing order")
        expect(stdout).to_contain("fake native proof")
        expect(stdout).to_contain("unsigned promotion")
        expect(stdout).to_contain("Gatekeeper failure")
        expect(stdout).to_contain("full bundle mutation")
        expect(stdout).to_contain("rebuild")
        expect(stdout).to_contain("signed pointer-only promotion")
        expect(stdout).to_contain("M5 native status: BLOCKED")
