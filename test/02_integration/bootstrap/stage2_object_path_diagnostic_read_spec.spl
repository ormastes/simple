# Regression spec for bootstrap_stage2_backend_object_path_status_2026_09_08.
#
# Defect: on the seed-built AOT lane (Stage 2), the bounded no-follow read that
# the driver uses to fetch the backend's AOT diagnostic miscompiled the
# nullable extern transport -- `.?` reported the Optional present while the
# force-unwrapped payload decoded to len -1, so a real backend failure surfaced
# only as the opaque "backend object-path status 1". The fix routes the unwrap
# through the `??` transport shape (the shape the capsule-receipt read is
# verified with on that same binary).
#
# Guard: run the probe on the interpret lane (reference) and as a seed
# native-built binary (the lane that miscompiled). Before the fix the native
# probe reports the payload as lost (PROBE-ERR) for a file that was just
# written; after the fix both lanes return the written bytes through Ok(...).
# The native lane additionally checks the failure arm: a missing file must be
# Err, never a laundered Ok(<nil>).

use std.spec
use std.io_runtime.{process_run, env_get, dir_create_all}
use app.io.sysinfo_ops.{getpid}
use app.io.file_ops.{path_absolute}

val PROBE = "test/02_integration/bootstrap/probe_stage2_object_path_diagnostic_read.spl"
val DIAGNOSTIC_TEXT = "AOT object destination already exists"

fn simple_bin() -> text:
    val b = env_get("SIMPLE_BIN")
    if b == "": "bin/simple" else: b

fn scv_bypass_env() -> text:
    # jj workspaces carry no git event source for the inner native-build's SCV
    # admission (native_build_main.spl skips the refresh only when
    # SIMPLE_SCV_SNAPSHOT_ROOT is preset); real git checkouts admit normally
    # and need no bypass.
    val probe = process_run("git", ["rev-parse", "--verify", "HEAD"])
    if probe.2 == 0: "" else:
        "SIMPLE_PACKAGE_INDEX_COLD_INIT=1 SIMPLE_SCV_INVENTORY_COLD_INIT=1 " +
        "SIMPLE_SCV_FREEZE_FALLBACK=1 SIMPLE_SCV_SNAPSHOT_ROOT=" +
        path_absolute(".").replace("\\", "/")

describe "stage2 backend object-path diagnostic read (bounded no-follow read)":
    slow_it "interpret lane and native lane both recover the written diagnostic text":
        val root = "/tmp/bootstrap_stage2_object_path_spec_{getpid()}"
        expect(dir_create_all(root)).to_equal(true)
        val fixture = root + "/diagnostic.txt"
        val missing = root + "/no-such-file.txt"

        step("interpret lane is the reference")
        val interp = process_run("sh", ["-c",
            "PROBE_FIXTURE=" + fixture +
            " SIMPLE_RUST_SEED_WARNING=0 SIMPLE_LIB=src " + simple_bin() +
            " run " + PROBE + " 2>/dev/null"])
        expect(interp.2).to_equal(0)
        expect(interp.0).to_contain("PROBE-OK len={DIAGNOSTIC_TEXT.len()}")
        expect(interp.0).to_contain("PROBE-CONTENT [{DIAGNOSTIC_TEXT}]")

        step("native lane (seed-built AOT) must not lose the payload")
        val out = root + "/probe"
        # SIMPLE_CACHE isolates the inner build's package-index/admission cache
        # under the fixture root: the default machine cache is host-global and
        # concurrent runs on one host must not cross-contaminate it.
        val build = process_run("sh", ["-c",
            scv_bypass_env() + " SIMPLE_CACHE=" + root + "/cache SIMPLE_LIB=src " +
            simple_bin() +
            " native-build --runtime-bundle core-c-bootstrap --threads 2 -o " +
            out + " " + PROBE + " 2>&1"])
        expect(build.0.contains("worker exited with code 1")).to_equal(false)
        expect(build.2).to_equal(0)
        val run = process_run("sh", ["-c",
            "PROBE_FIXTURE=" + fixture + " PROBE_MISSING=" + missing + " " +
            out + " 2>&1"])
        expect(run.2).to_equal(0)
        expect(run.0).to_contain("PROBE-OK len={DIAGNOSTIC_TEXT.len()}")
        expect(run.0).to_contain("PROBE-CONTENT [{DIAGNOSTIC_TEXT}]")
        expect(run.0).to_contain("PROBE-MISSING-ERR")
        expect(run.0.contains("PROBE-MISSING-UNEXPECTED-OK")).to_equal(false)
        expect(run.0.contains("PROBE-ERR")).to_equal(false)
