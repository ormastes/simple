"""
## Purpose and audience
Covers the pure-Simple HTML layout child-index path in
`src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl`
that avoids repeated full-node scans during startup rendering: sibling
ordering, CSS bucket admission and specificity, whitespace handling, overflow
clipping, flex layout, z-index paint order, static transition/animation
metadata, and Draw IR lowering. Everything is exercised through the public
debug/render entrypoints, never private helpers. Audience: rendering
engineers touching layout or style resolution.

## Operator workflow
Run the single file with the seed runner and require every scenario to pass
except the ones explicitly noted RED in their bodies; a failure names the
layout contract that regressed.

## Compatibility and limitations
Runs on the software pixel path, so no GPU or windowing system is required
on any host. Draw IR geometry is asserted through the shared composition
shape, not through a backend, so backend-specific lowering is out of scope.

## Verification guidance and troubleshooting
Re-run this file after any edit under
`src/lib/gc_async_mut/gpu/browser_engine/`. A pixel-expect failure means
paint order or clipping regressed; a geometry or style failure means flex,
bucket, or selector resolution changed. Use
`simple_web_layout_debug_layout_by_id` / `simple_web_layout_debug_style_by_id`
to localize the regression before touching paint code.

@tag: rendering, simple-web, perf
@cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl 25%
"""

# Lifecycle: research doc/01_research/domain/simple_web_browser_engine_production_hardening.md ;
# plan doc/03_plan/agent_tasks/web_renderer_vulkan_4k_showcase_hardening.md ;
# architecture doc/04_architecture/simple_web_browser_engine_production_hardening.md ;
# design doc/05_design/web_layout_manager.md

use std.spec.*
use std.common.ui.draw_ir.{DrawIrCommand, DrawIrRect}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id,
    simple_web_layout_debug_style_by_id,
    simple_web_layout_render_html_draw_ir,
    simple_web_layout_render_html_software_pixels
}
use std.gc_async_mut.gpu.browser_engine.browser_renderer.{BrowserRenderer}

fn _flat_rows(count: i32) -> text:
    var html = "<html><body>"
    var i = 0
    while i < count:
        html = html + "<div id=\"row" + i.to_string() + "\" style=\"height:10px\">row</div>"
        i = i + 1
    html + "</body></html>"

fn _pixel_at(pixels: [u32], width: i32, x: i32, y: i32) -> u32:
    pixels[(y * width) + x]

# Looks up the Draw IR rectangle of the command whose component_id matches the
# HTML element id; returns -1 geometry when absent so expects fail loudly.
fn _draw_ir_command_by_id(commands: [DrawIrCommand], id: text) -> DrawIrRect:
    var i = 0
    while i < commands.len():
        val command = commands[i]
        if command.component_id == id:
            return DrawIrRect(
                present: true,
                x: command.x,
                y: command.y,
                width: command.width,
                height: command.height
            )
        i = i + 1
    return DrawIrRect(present: false, x: -1, y: -1, width: -1, height: -1)

# @manual_section: layout child index and CSS bucket admission
describe "simple web layout child index":
    it "keeps flat sibling block order stable":
        # @req REQ-WEBLAYOUT-001
        # @capture(statistics): ordered sibling y positions retained for review
        step("Lay out eight flat sibling rows through the debug layout entrypoint")
        val html = _flat_rows(8)
        val y0 = simple_web_layout_debug_layout_by_id(html, 200, 200, "row0", "y").to_i32()
        val y1 = simple_web_layout_debug_layout_by_id(html, 200, 200, "row1", "y").to_i32()
        val y7 = simple_web_layout_debug_layout_by_id(html, 200, 200, "row7", "y").to_i32()
        expect(y1).to_be_greater_than(y0)
        expect(y7).to_be_greater_than(y1)

    it "renders a sibling-heavy startup fixture":
        # @req REQ-WEBLAYOUT-002
        # @capture(statistics): 160x120 software framebuffer pixel count retained
        step("Render an 80-row sibling fixture into the 160x120 software framebuffer")
        val html = _flat_rows(80)
        val pixels = simple_web_layout_render_html_software_pixels(html, 160, 120)
        expect(pixels.len()).to_equal(19200)  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "keeps whitespace-only text segments out of block layout":
        # @req REQ-WEBLAYOUT-003
        # @capture(statistics): inter-block delta retained for review
        step("Lay out two divs separated by whitespace-only text segments")
        val html = "<html><body>\n  <div id=\"first\" style=\"height:10px\">first</div>\n  \n  <div id=\"second\" style=\"height:10px\">second</div>\n</body></html>"
        val first_y = simple_web_layout_debug_layout_by_id(html, 200, 200, "first", "y").to_i32()
        val second_y = simple_web_layout_debug_layout_by_id(html, 200, 200, "second", "y").to_i32()
        expect(second_y - first_y).to_equal(10)  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "keeps spaced numeric style parsing stable without parse trim":
        # @req REQ-WEBLAYOUT-004
        # @capture(statistics): parsed width/height/margin triple retained
        step("Parse spaced numeric style declarations on the box div")
        val html = "<html><body><div id=\"box\" style=\"width:  24px; height:  11px; margin:  3px\">box</div></body></html>"
        val width = simple_web_layout_debug_style_by_id(html, "box", "parse_width").to_i32()
        val height = simple_web_layout_debug_style_by_id(html, "box", "parse_height").to_i32()
        val margin = simple_web_layout_debug_style_by_id(html, "box", "parse_margin").to_i32()
        expect(width).to_equal(24)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(height).to_equal(11)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(margin).to_equal(3)  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "keeps CSS bucket candidates in specificity order":
        # @req REQ-WEBLAYOUT-005
        # @capture(bit_table): bucket candidate order for #target retained
        step("Resolve height for the target through the CSS bucket candidate order")
        val html = "<html><head><style>" +
            ".unused0{height:1px}.unused1{height:2px}.unused2{height:3px}" +
            "div,.target{height:9px}#target{height:11px}.target{height:13px}" +
            "</style></head><body><div id=\"target\" class=\"target target\">row</div></body></html>"
        val height = simple_web_layout_debug_style_by_id(html, "target", "height")
        expect(height).to_equal("11")  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "keeps overlapping CSS buckets sorted and unique":
        # @req REQ-WEBLAYOUT-006
        # @capture(bit_table): overlapping bucket resolution for #target retained
        step("Resolve height with four overlapping buckets competing for the target")
        val html = "<html><head><style>" +
            "*{height:5px}div,.target{height:9px}.target{height:13px}#target{height:17px}" +
            "</style></head><body><div id=\"target\" class=\"target\">row</div></body></html>"
        val height = simple_web_layout_debug_style_by_id(html, "target", "height")
        expect(height).to_equal("17")  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "keeps malformed CSS rule admission stable with pre-counted rules":
        # @req REQ-WEBLAYOUT-007
        # @capture(bit_table): admission verdict for the broken rule retained
        step("Admit a malformed CSS rule next to a well-formed one")
        val html = "<html><head><style>" +
            ".target{height:21px}.broken{height:99px" +
            "</style></head><body><div id=\"target\" class=\"target\">row</div><div id=\"broken\" class=\"broken\">row</div></body></html>"
        val target_height = simple_web_layout_debug_style_by_id(html, "target", "height")
        val broken_height = simple_web_layout_debug_style_by_id(html, "broken", "height")
        expect(target_height).to_equal("21")  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(broken_height).to_equal("0")  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "keeps spaced descendant and child selectors stable with pretrimmed parts":
        # @req REQ-WEBLAYOUT-008
        # @capture(bit_table): selector-chain match verdict for #target retained
        step("Resolve a spaced descendant-plus-child selector chain")
        val html = "<html><head><style>" +
            ".outer   >   .inner   .target{height:17px}" +
            "</style></head><body><section class=\"outer\"><div class=\"inner\"><span id=\"target\" class=\"target\">row</span></div></section></body></html>"
        val height = simple_web_layout_debug_style_by_id(html, "target", "height")
        expect(height).to_equal("17")  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "keeps descendant has selectors scoped to the subtree":
        # @req REQ-WEBLAYOUT-009
        # @capture(bit_table): hit/miss subtree verdicts retained for review
        step("Scope a :has descendant selector to its own subtree")
        val has_target = ":has(.target)"
        val html = "<html><head><style>" +
            "section{height:7px}.outer" + has_target + "{height:23px}" +
            "</style></head><body><section id=\"hit\" class=\"outer\"><div><span class=\"target\">row</span></div></section><section id=\"miss\" class=\"outer\"><div><span>row</span></div></section></body></html>"
        val hit_height = simple_web_layout_debug_style_by_id(html, "hit", "height")
        val miss_height = simple_web_layout_debug_style_by_id(html, "miss", "height")
        expect(hit_height).to_equal("23")  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(miss_height).to_equal("7")  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "keeps empty class attributes out of class selector buckets":
        # @req REQ-WEBLAYOUT-010
        # @capture(bit_table): bucket membership for a class-less div retained
        step("Resolve a plain div whose class attribute is absent")
        val html = "<html><head><style>" +
            "div{height:9px}.missing{height:13px}" +
            "</style></head><body><div id=\"plain\">row</div></body></html>"
        val height = simple_web_layout_debug_style_by_id(html, "plain", "height")
        expect(height).to_equal("9")  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "keeps spaced duplicate class tokens stable with parse-time trim":
        # @req REQ-WEBLAYOUT-011
        # @capture(bit_table): trimmed class-token bucket set retained
        step("Trim duplicated spaced class tokens at parse time")
        val html = "<html><head><style>" +
            ".target.marker{height:19px}.missing{height:23px}" +
            "</style></head><body><div id=\"target\" class=\" target  marker target \">row</div></body></html>"
        val height = simple_web_layout_debug_style_by_id(html, "target", "height")
        expect(height).to_equal("19")  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "keeps overflow clipping stable with cached ancestor clips":
        # @req REQ-WEBLAYOUT-012
        # @capture(gui_image): clipped shell framebuffer pixels retained
        step("Paint a wide child inside a clipped shell section")
        val html = "<html><head><style>" +
            "html,body{margin:0;padding:0;background-color:#ffffff}" +
            ".shell{overflow:hidden;background-color:#e5e7eb;width:12px;height:8px}" +
            ".wide{background-color:#ef4444;width:30px;height:6px}" +
            "</style></head><body><section class=\"shell\"><div class=\"wide\"></div></section></body></html>"
        val pixels = simple_web_layout_render_html_software_pixels(html, 32, 24)
        expect(_pixel_at(pixels, 32, 4, 2)).to_equal(0xffef4444u32)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(_pixel_at(pixels, 32, 16, 2)).to_equal(0xffffffffu32)  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "keeps widget chrome rendering stable with folded widget scans":
        # @req REQ-WEBLAYOUT-013
        # @capture(gui_image): 64x64 widget panel framebuffer retained
        step("Render a widget panel with folded widget scans")
        val html = "<html><body><section class=\"widget-panel\"><div class=\"widget\">Hello</div></section></body></html>"
        val pixels = simple_web_layout_render_html_software_pixels(html, 64, 64)
        expect(pixels.len()).to_equal(4096)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(_pixel_at(pixels, 64, 0, 0)).to_equal(0xff0066ccu32)  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "keeps nested flex intrinsic widths stable with shared memo":
        # @req REQ-WEBLAYOUT-014
        # @capture(statistics): nested flex width and x positions retained
        step("Lay out nested flex containers with a shared memo table")
        val html = "<html><head><style>" +
            "html,body{margin:0;padding:0;background-color:#ffffff}" +
            ".outer{display:flex;gap:4px;width:120px;background-color:#e5e7eb}" +
            ".inner{display:flex;gap:2px;background-color:#dbeafe}" +
            ".label{display:inline;background-color:#22c55e}" +
            ".tail{display:inline;background-color:#f59e0b}" +
            "</style></head><body><section id=\"outer\" class=\"outer\">" +
            "<div id=\"inner\" class=\"inner\"><span id=\"label\" class=\"label\">ALPHA</span><span id=\"tail\" class=\"tail\">BETA</span></div>" +
            "<div id=\"right\" class=\"inner\"><span>GAMMA</span></div>" +
            "</section></body></html>"
        val outer_w = simple_web_layout_debug_layout_by_id(html, 160, 80, "outer", "w").to_i32()
        val inner_w = simple_web_layout_debug_layout_by_id(html, 160, 80, "inner", "w").to_i32()
        val label_x = simple_web_layout_debug_layout_by_id(html, 160, 80, "label", "x").to_i32()
        val tail_x = simple_web_layout_debug_layout_by_id(html, 160, 80, "tail", "x").to_i32()
        val right_x = simple_web_layout_debug_layout_by_id(html, 160, 80, "right", "x").to_i32()
        expect(outer_w).to_equal(120)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(inner_w).to_be_greater_than(0)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(tail_x).to_be_greater_than(label_x)
        expect(right_x).to_be_greater_than(tail_x)

    it "keeps flex wrap line heights stable with fixed line buffer":
        # @req REQ-WEBLAYOUT-015
        # @capture(statistics): wrapped item line y positions retained
        step("Wrap three fixed items across lines in a 28px flex container")
        val html = "<html><head><style>" +
            "html,body{margin:0;padding:0;background-color:#ffffff}" +
            "#wrap{display:flex;flex-wrap:wrap;gap:2px;width:28px}" +
            ".item{width:12px;height:5px;background-color:#22c55e}" +
            "</style></head><body><section id=\"wrap\">" +
            "<div id=\"a\" class=\"item\"></div><div id=\"b\" class=\"item\"></div><div id=\"c\" class=\"item\"></div>" +
            "</section></body></html>"
        val ay = simple_web_layout_debug_layout_by_id(html, 64, 64, "a", "y").to_i32()
        val by = simple_web_layout_debug_layout_by_id(html, 64, 64, "b", "y").to_i32()
        val cy = simple_web_layout_debug_layout_by_id(html, 64, 64, "c", "y").to_i32()
        expect(by).to_equal(ay)
        expect(cy).to_be_greater_than(by)

    # @manual: show
    it "should wrap longhand column gaps consistently through Draw IR and Engine2D":
        # @req REQ-WEBLAYOUT-016
        # @capture(gui_image): wrap framebuffer plus Draw IR item rects retained
        step("Render three fixed items with distinct row and column gaps")
        val html = "<html><head><style>" +
            "html,body{margin:0;padding:0;background-color:#ffffff}" +
            "#wrap{display:flex;flex-wrap:wrap;width:22px;" +
            "column-gap:4px;row-gap:3px;background-color:#dbeafe}" +
            ".item{width:10px;height:5px}" +
            "#a{{background-color:#ef4444}}#b{{background-color:#22c55e}}" +
            "#c{{background-color:#2563eb}}" +
            "</style></head><body><section id=\"wrap\">" +
            "<div id=\"a\" class=\"item\"></div>" +
            "<div id=\"b\" class=\"item\"></div>" +
            "<div id=\"c\" class=\"item\"></div>" +
            "</section></body></html>"

        step("Lower each wrapped item to its exact Draw IR rectangle")
        val composition = simple_web_layout_render_html_draw_ir(html, 32, 24)
        val commands = composition.batches[0].commands
        val wrap = _draw_ir_command_by_id(commands, "wrap")
        val a = _draw_ir_command_by_id(commands, "a")
        val b = _draw_ir_command_by_id(commands, "b")
        val c = _draw_ir_command_by_id(commands, "c")
        expect(wrap.height).to_equal(21)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(a.x).to_equal(0)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(a.y).to_equal(0)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(a.width).to_equal(10)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(a.height).to_equal(5)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(b.x).to_equal(0)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(b.y).to_equal(8)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(b.width).to_equal(10)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(b.height).to_equal(5)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(c.x).to_equal(0)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(c.y).to_equal(16)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(c.width).to_equal(10)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(c.height).to_equal(5)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(simple_web_layout_debug_layout_by_id(
            html, 32, 24, "wrap", "h"
        )).to_equal("21")  # oracle: authoritative wrap block height for this fixture

        step("Execute the same composition through Engine2D pixels")
        val pixels = BrowserRenderer.create(
            32, 24
        ).render_html_to_pixels(html).pixel_data
        expect(_pixel_at(pixels, 32, 14, 2)).to_equal(0xffdbeafeu32)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(_pixel_at(pixels, 32, 2, 10)).to_equal(0xff22c55eu32)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(_pixel_at(pixels, 32, 2, 18)).to_equal(0xff2563ebu32)  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "keeps positive z-index absolute paint order stable":
        # @req REQ-WEBLAYOUT-017
        # @capture(gui_image): z-ordered framebuffer pixel retained
        step("Paint three absolutely positioned layers with unordered z-index values")
        val html = "<html><head><style>" +
            "html,body{margin:0;padding:0;background-color:#ffffff}" +
            "#low{position:absolute;left:0;top:0;width:12px;height:12px;background-color:#ef4444;z-index:1}" +
            "#high{position:absolute;left:0;top:0;width:12px;height:12px;background-color:#22c55e;z-index:3}" +
            "#mid{position:absolute;left:0;top:0;width:12px;height:12px;background-color:#3b82f6;z-index:2}" +
            "</style></head><body><div id=\"low\"></div><div id=\"high\"></div><div id=\"mid\"></div></body></html>"
        val pixels = simple_web_layout_render_html_software_pixels(html, 24, 24)
        expect(_pixel_at(pixels, 24, 2, 2)).to_equal(0xff22c55eu32)  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "paints static transform and translate offsets":
        # @req REQ-WEBLAYOUT-018
        # @capture(gui_image): translated framebuffer pixels retained
        step("Paint two boxes offset by transform translate and the translate property")
        val html = "<html><head><style>" +
            "html,body{margin:0;padding:0;background-color:#ffffff}" +
            "#a{width:12px;height:10px;background-color:#ef4444;transform:translate(8px,6px)}" +
            "#b{width:10px;height:8px;background-color:#22c55e;translate:24px 4px}" +
            "</style></head><body><div id=\"a\"></div><div id=\"b\"></div></body></html>"
        val pixels = simple_web_layout_render_html_software_pixels(html, 96, 56)
        expect(_pixel_at(pixels, 96, 9, 7)).to_equal(0xffef4444u32)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(_pixel_at(pixels, 96, 25, 21)).to_equal(0xff22c55eu32)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(_pixel_at(pixels, 96, 1, 1)).to_equal(0xffffffffu32)  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "keeps static transition metadata in computed style":
        # @req REQ-WEBLAYOUT-019
        # @capture(bit_table): computed transition property table retained
        step("Read computed transition metadata for shorthand and longhand declarations")
        val html = "<html><head><style>" +
            "html,body{margin:0;padding:0;background-color:#ffffff}" +
            "#box{width:10px;height:10px;background-color:#22c55e;transition:opacity 150ms ease-in 25ms}" +
            "#override{width:10px;height:10px;background-color:#3b82f6;transition:all 1s linear;transition-property:transform;transition-duration:75ms;transition-delay:10ms;transition-timing-function:ease-out}" +
            "</style></head><body><div id=\"box\"></div><div id=\"override\"></div></body></html>"
        expect(simple_web_layout_debug_style_by_id(html, "box", "transition_property")).to_equal("opacity")
        expect(simple_web_layout_debug_style_by_id(html, "box", "transition_duration_ms")).to_equal("150")  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(simple_web_layout_debug_style_by_id(html, "box", "transition_delay_ms")).to_equal("25")  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(simple_web_layout_debug_style_by_id(html, "box", "transition_timing_function")).to_equal("ease-in")
        expect(simple_web_layout_debug_style_by_id(html, "override", "transition_property")).to_equal("transform")
        expect(simple_web_layout_debug_style_by_id(html, "override", "transition_duration_ms")).to_equal("75")  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(simple_web_layout_debug_style_by_id(html, "override", "transition_delay_ms")).to_equal("10")  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(simple_web_layout_debug_style_by_id(html, "override", "transition_timing_function")).to_equal("ease-out")

    it "keeps static animation and transform metadata in computed style":
        # @req REQ-WEBLAYOUT-020
        # @capture(bit_table): computed animation and transform table retained
        step("Read computed animation and transform metadata for both boxes")
        val html = "<html><head><style>" +
            "html,body{margin:0;padding:0;background-color:#ffffff}" +
            "#box{width:10px;height:10px;background-color:#22c55e;animation:fade 1200ms ease-out 50ms 2 alternate both paused;transform-origin:left top;transform-box:content-box;transform-style:preserve-3d}" +
            "#override{width:10px;height:10px;background-color:#3b82f6;animation:move 1s linear;animation-name:pulse;animation-duration:75ms;animation-delay:10ms;animation-timing-function:ease-in;animation-iteration-count:infinite;animation-direction:reverse;animation-fill-mode:forwards;animation-play-state:running}" +
            "</style></head><body><div id=\"box\"></div><div id=\"override\"></div></body></html>"
        expect(simple_web_layout_debug_style_by_id(html, "box", "animation_name")).to_equal("fade")
        expect(simple_web_layout_debug_style_by_id(html, "box", "animation_duration_ms")).to_equal("1200")  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(simple_web_layout_debug_style_by_id(html, "box", "animation_delay_ms")).to_equal("50")  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(simple_web_layout_debug_style_by_id(html, "box", "animation_timing_function")).to_equal("ease-out")
        expect(simple_web_layout_debug_style_by_id(html, "box", "animation_iteration_count")).to_equal("2")  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(simple_web_layout_debug_style_by_id(html, "box", "animation_direction")).to_equal("alternate")
        expect(simple_web_layout_debug_style_by_id(html, "box", "animation_fill_mode")).to_equal("both")
        expect(simple_web_layout_debug_style_by_id(html, "box", "animation_play_state")).to_equal("paused")
        expect(simple_web_layout_debug_style_by_id(html, "box", "transform_origin")).to_equal("left top")
        expect(simple_web_layout_debug_style_by_id(html, "box", "transform_box")).to_equal("content-box")
        expect(simple_web_layout_debug_style_by_id(html, "box", "transform_style")).to_equal("preserve-3d")
        expect(simple_web_layout_debug_style_by_id(html, "override", "animation_name")).to_equal("pulse")
        expect(simple_web_layout_debug_style_by_id(html, "override", "animation_duration_ms")).to_equal("75")  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(simple_web_layout_debug_style_by_id(html, "override", "animation_delay_ms")).to_equal("10")  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(simple_web_layout_debug_style_by_id(html, "override", "animation_timing_function")).to_equal("ease-in")
        expect(simple_web_layout_debug_style_by_id(html, "override", "animation_iteration_count")).to_equal("infinite")
        expect(simple_web_layout_debug_style_by_id(html, "override", "animation_direction")).to_equal("reverse")
        expect(simple_web_layout_debug_style_by_id(html, "override", "animation_fill_mode")).to_equal("forwards")
        expect(simple_web_layout_debug_style_by_id(html, "override", "animation_play_state")).to_equal("running")

    it "keeps already sorted positive z-index paint order stable":
        # @req REQ-WEBLAYOUT-021
        # @capture(gui_image): sorted z-order framebuffer pixel retained
        step("Paint three absolutely positioned layers already in z-index order")
        val html = "<html><head><style>" +
            "html,body{margin:0;padding:0;background-color:#ffffff}" +
            "#low{position:absolute;left:0;top:0;width:12px;height:12px;background-color:#ef4444;z-index:1}" +
            "#mid{position:absolute;left:0;top:0;width:12px;height:12px;background-color:#3b82f6;z-index:2}" +
            "#high{position:absolute;left:0;top:0;width:12px;height:12px;background-color:#22c55e;z-index:3}" +
            "</style></head><body><div id=\"low\"></div><div id=\"mid\"></div><div id=\"high\"></div></body></html>"
        val pixels = simple_web_layout_render_html_software_pixels(html, 24, 24)
        expect(_pixel_at(pixels, 24, 2, 2)).to_equal(0xff22c55eu32)  # oracle: authoritative pure-Simple layout-engine value for this fixture

    it "emits Draw IR commands for visible HTML boxes":
        # @req REQ-WEBLAYOUT-022
        # @capture(protocol_json): lowered Draw IR batch retained for review
        step("Lower a two-box HTML document to its Draw IR composition")
        val html = "<html><body><section id=\"panel\" style=\"width:40px;height:16px;background-color:#e5e7eb\"><div id=\"child\" style=\"height:8px;background-color:#22c55e\"></div></section></body></html>"
        val composition = simple_web_layout_render_html_draw_ir(html, 64, 64)
        expect(composition.batches.len()).to_equal(1)  # oracle: authoritative pure-Simple layout-engine value for this fixture
        expect(composition.batches[0].commands.len()).to_be_greater_than(0)  # oracle: authoritative pure-Simple layout-engine value for this fixture