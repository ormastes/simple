"""
## Purpose and audience
Purpose: This spec proves native Engine2D SIMD execution.
Audience: Maintainers of the Simple integration suite reviewing this behavior.
"""
# codex-system-test
# @req REQ-020 REQ-021
# @evidence-display: links
"""
# Native Engine2D SIMD execution

Requires the production CPU-SIMD facade to execute native fill, copy, and
alpha provider rows, then compares its complete framebuffer bit-for-bit with
an independently rendered scalar oracle. The host may use SSE/AVX, NEON, or
RVV; the provider operations must execute before this spec can pass.
"""

use std.spec.*
use std.gc_async_mut.gpu.engine2d.backend_cpu.{CpuBackend}
use std.gc_async_mut.gpu.engine2d.simd_provider.{reset_simd_hits, simd_hit_counts}
use std.gpu.engine2d.simd_kernels.{native_pixel_rows_enabled}

val CANVAS: i32 = 48

fn frame_checksum(pixels: [u32]) -> i64:
    var checksum: i64 = 0
    var i = 0
    while i < pixels.len():
        checksum = (checksum + pixels[i].to_i64()) % 2147483647
        i = i + 1
    checksum

fn mismatch_count(left: [u32], right: [u32]) -> i64:
    if left.len() != right.len():
        return -1
    var mismatches: i64 = 0
    var i = 0
    while i < left.len():
        if left[i] != right[i]:
            mismatches = mismatches + 1
        i = i + 1
    mismatches

fn render_scene(mut backend: CpuBackend) -> [u32]:
    backend.init(CANVAS, CANVAS)
    backend.clear(0xFF102030u32)
    backend.draw_rect_filled(2, 2, 28, 20, 0xFFFF0000u32)
    backend.draw_rect(4, 5, 30, 24, 0x80112233u32)
    val image: [u32] = [0xFF00CC44u32; 12 * 10]
    backend.draw_image(24, 3, 12, 10, image)
    backend.present()
    backend.read_pixels()

describe "native Engine2D SIMD execution":
    # @capture(log)
    it "executes fill copy alpha and matches scalar pixels bit-for-bit":
        # @req: REQ-020
        # @req: REQ-021
        step("Require an enabled native SIMD row provider")
        expect(native_pixel_rows_enabled()).to_equal(true)
        step("Render fill, copy, and alpha through cpu_simd")
        reset_simd_hits()
        var simd = CpuBackend.create_simd()
        val simd_pixels = render_scene(simd)
        val simd_checksum = frame_checksum(simd_pixels)
        val simd_hits = simd_hit_counts()
        step("Render the independent scalar oracle")
        reset_simd_hits()
        var scalar = CpuBackend.create()
        val scalar_pixels = render_scene(scalar)
        val scalar_checksum = frame_checksum(scalar_pixels)
        val scalar_hits = simd_hit_counts()
        step("Require each provider operation and zero bit mismatches")
        expect(simd_checksum).to_be_greater_than(0)
        expect(scalar_checksum).to_be_greater_than(0)
        expect(simd_hits.fill_hits).to_be_greater_than(0)
        expect(simd_hits.copy_hits).to_be_greater_than(0)
        expect(simd_hits.alpha_hits).to_be_greater_than(0)
        expect(scalar_hits.fill_hits).to_equal(0)
        expect(scalar_hits.copy_hits).to_equal(0)
        expect(scalar_hits.alpha_hits).to_equal(0)
        expect(mismatch_count(simd_pixels, scalar_pixels)).to_equal(0)
        expect(simd_checksum).to_equal(scalar_checksum)
