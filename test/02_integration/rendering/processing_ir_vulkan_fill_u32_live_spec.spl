use std.spec.{describe, it, expect}
use std.common.processing.processing_ir.{processing_ir_fill_u32}
use std.gc_async_mut.processing.vulkan_fill_u32.{processing_ir_execute_vulkan}

describe "Linux Vulkan ProcessingIR FillU32 live":
    it "fills 64 elements with the exact physical-device result":
        val expected_value = 0xA1B2C3D4u32
        val result = processing_ir_execute_vulkan(
            processing_ir_fill_u32(64, expected_value))
        expect(result.completed).to_equal(true)
        expect(result.reason).to_equal("ok")
        expect(result.backend_handle).to_be_greater_than(0)
        expect(result.device_identity).to_be_greater_than(0)
        expect(result.values.len()).to_equal(64)
        for actual in result.values:
            expect(actual).to_equal(expected_value)
