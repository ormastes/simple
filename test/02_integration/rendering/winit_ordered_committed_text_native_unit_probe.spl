# Native unit probe for the exact caller-owned Winit record channel.
# It does not declare or simulate rt_winit_* ABI: raw decoding is covered by
# the source contract while this executable proves kind/text payload survival.

use std.nogc_sync_mut.io.window_winit_input_event.{
    WinitInputEvent, winit_input_event_record_into}

fn main() -> i64:
    var events: [WinitInputEvent] = []
    var kinds: [i64] = []
    val first = winit_input_event_record_into(events, kinds, 10, "")
    val second = winit_input_event_record_into(events, kinds, 11, "g")
    val third = winit_input_event_record_into(events, kinds, 11, "한글")
    if first != 1 or second != 2 or third != 3:
        return 11
    if events.len() != 3 or kinds.len() != 3:
        return 12
    if kinds[0] != 10 or kinds[1] != 11 or kinds[2] != 11:
        return 13
    if events[0].kind != 10 or events[0].committed_text != "":
        return 14
    if events[1].kind != 11 or events[1].committed_text != "g":
        return 15
    if events[2].kind != 11 or events[2].committed_text != "한글":
        return 16
    print "winit_ordered_committed_text_native_probe=pass count={events.len()} ascii={events[1].committed_text} utf8={events[2].committed_text}"
    0
