use std.common.encoding.font_registry.{
    selected_font_asset_candidates,
    selected_font_asset_identity
}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}

fn main() -> i64:
    val candidate = selected_font_asset_candidates()[9]
    val expected_identity = selected_font_asset_identity(candidate)
    var engine = Engine2D.create_with_backend(128, 64, "software")
    if not engine.load_font(candidate.local_path):
        print("engine2d_font_state_native_status=fail-load")
        return 1
    val fonts = engine.fonts()
    if not fonts.has_sffi_ttf():
        print("engine2d_font_state_native_status=fail-live-face")
        return 2
    if fonts.current_font_identity() != expected_identity:
        print("engine2d_font_state_native_status=fail-identity")
        return 3
    val before = engine.font_cache_stats()
    engine.draw_text(2, 2, "Simple", 0xffffffffu32, 24)
    val cold = engine.font_cache_stats()
    engine.draw_text(2, 30, "Simple", 0xffffffffu32, 24)
    val warm = engine.font_cache_stats()
    if cold.rasterizations <= before.rasterizations:
        print("engine2d_font_state_native_status=fail-cold-cache")
        return 4
    if warm.rasterizations != cold.rasterizations or warm.hits <= cold.hits:
        print("engine2d_font_state_native_status=fail-warm-cache")
        return 5
    engine.shutdown()
    print("engine2d_font_state_native_status=pass")
    0
