extern fn rt_file_read_text(path: text) -> text
use std.spec.{describe, it, expect}

describe "window SFFI ownership and facade parity":
    it "keeps the SDL ABI under one owner":
        val owner = rt_file_read_text("src/lib/nogc_sync_mut/sffi/window_abi.spl") ?? ""
        val product = rt_file_read_text("src/lib/nogc_sync_mut/io/window_sffi.spl") ?? ""
        val app_ffi = rt_file_read_text("src/app/io/window_ffi.spl") ?? ""
        val app_sffi = rt_file_read_text("src/app/io/window_sffi.spl") ?? ""

        expect(owner).to_contain("extern fn rt_sdl2_init() -> i64")
        expect(owner).to_contain("extern fn rt_sdl2_clipboard_has_text() -> bool")
        expect(owner).to_contain("fn sdl2_native_poll_event() -> i64: rt_sdl2_poll_event()")
        expect(product).to_contain("use std.nogc_sync_mut.sffi.window_abi.*")
        expect(product.contains("extern fn rt_sdl2_")).to_be(false)
        expect(product.contains("fn rt_winit_")).to_be(false)
        expect(app_ffi.contains("extern fn rt_sdl2_")).to_be(false)
        expect(app_sffi.contains("extern fn rt_sdl2_")).to_be(false)

    it "maps both application compatibility names to the same product surface":
        val app_ffi = rt_file_read_text("src/app/io/window_ffi.spl") ?? ""
        val app_sffi = rt_file_read_text("src/app/io/window_sffi.spl") ?? ""

        expect(app_ffi).to_contain("export use std.nogc_sync_mut.io.window_sffi.*")
        expect(app_sffi).to_contain("export use std.nogc_sync_mut.io.window_sffi.*")
        expect(app_ffi).to_contain("canonical SDL/native ABI")
        expect(app_sffi).to_contain("canonical SDL/native ABI")

    it "preserves event counts, positive handles, and checked status results":
        val product = rt_file_read_text("src/lib/nogc_sync_mut/io/window_sffi.spl") ?? ""

        expect(product).to_contain("is_valid: result > 0")
        expect(product).to_contain("is_valid: handle > 0")
        expect(product).to_contain("count: if handle == 0: 0 else: 1")
        expect(product).to_contain("sdl2_native_set_window_fullscreen_checked(window.handle, if fullscreen: 1 else: 0) != 0")
        expect(product).to_contain("event_handle == 1")
        expect(product).to_contain("event_handle == 2 or event_handle == 3")
