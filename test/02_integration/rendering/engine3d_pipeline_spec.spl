# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @tag: gpu, engine3d, pipeline, integration
# @cover src/lib/gc_async_mut/gpu/engine3d/engine.spl 20%

use std.spec.step

use std.spec.{describe, context, it, expect}
use std.gpu.engine3d.engine.{Engine3D}
use std.gpu.engine3d.resource_pool.{ShaderHandle3D, PipelineHandle3D}

describe "Engine3D Shader Pipeline Lifecycle":
    # @manual scenario evidence

    context "create_shader":

        it "returns i32 id":
            # @req REQ-SSPEC-INTEGRATION
            step("returns i32 id")
            var engine = Engine3D.create(320, 240)
            val id = engine.create_shader("void main(){}", "void main(){}")
            expect(id).to_be_greater_than(-2)

    context "create_pipeline":

        it "returns i32 id":
            # @req REQ-SSPEC-INTEGRATION
            step("returns i32 id")
            var engine = Engine3D.create(320, 240)
            val shader_id = engine.create_shader("void main(){}", "void main(){}")
            val id = engine.create_pipeline(shader_id, true, 0, 0)
            expect(id).to_be_greater_than(-2)


    context "compute kernel":

        it "create_compute_kernel returns i32 id":
            # @req REQ-SSPEC-INTEGRATION
            step("create_compute_kernel returns i32 id")
            var engine = Engine3D.create(320, 240)
            val id = engine.create_compute_kernel("void main(){}")
            expect(id).to_be_greater_than(-2)

    context "storage buffer":

        it "create_storage_buffer returns i32 id":
            # @req REQ-SSPEC-INTEGRATION
            step("create_storage_buffer returns i32 id")
            var engine = Engine3D.create(320, 240)
            val id = engine.create_storage_buffer(256)
            expect(id).to_be_greater_than(-2)

        it "update_buffer and read_buffer round-trip may return empty in emu":
            # @req REQ-SSPEC-INTEGRATION
            step("update_buffer and read_buffer round-trip may return empty in emu")
            var engine = Engine3D.create(320, 240)
            val id = engine.create_storage_buffer(4)
            val data: [u8] = [1, 2, 3, 4]
            engine.update_buffer(id, data)
            val result = engine.read_buffer(id)
            expect(result.len()).to_be_greater_than(-1)
