# @tag: rendering, engine2d, cuda, authority, live, hardware

use std.spec.{describe, it, expect}
use std.gpu.engine2d.backend_cuda.{CudaBackend, probe_cuda}

describe "CUDA live authority state":

    it "preserves GPU pixels across a CPU-only draw without eager re-upload":
        # PROBE-THEN-CREATE TOCTOU
        # (doc/08_tracking/bug/gpu_probe_then_create_toctou_2026-08-04.md)
        # This example used to wrap its ENTIRE body in `if probe.is_usable():`
        # with no else, so when the probe predicted unusable the whole live
        # qualification silently vanished and the file still reported a clean
        # pass. probe_cuda() and the CudaBackend.create()+init() below are two
        # independent creates with nothing cached in between; on this host the
        # probe reports "CUDA runtime unavailable" from a cold process while the
        # real create succeeds with a genuine device_readback. The nested
        # `expect(initialized).to_equal(true)` was ALSO a false red in the other
        # direction: it demanded the second create succeed because the probe had
        # said usable.
        #
        # The create is now attempted UNCONDITIONALLY and the branch is taken on
        # init()'s OWN result. Every authority-state assertion below is
        # unchanged and stays hard.
        val probe = probe_cuda()
        var backend = CudaBackend.create()
        val initialized = backend.init(8, 8)
        if probe.is_usable() != initialized:
            print "[toctou] cuda-authority-live: probe predicted usable={probe.is_usable()} but the independent init returned {initialized} — the prediction did not survive the gap; asserting on the INIT, not the probe"
        if initialized:
                val background = 0xFF102030 as u32
                val gpu_color = 0xFF40A060 as u32
                val cpu_color = 0xFFE05070 as u32

                backend.clear(background)
                backend.draw_rect_filled(6, 0, 2, 2, gpu_color)
                expect(backend.device_current).to_equal(true)
                expect(backend.mirror_current).to_equal(false)
                val stale_mirror = backend.mirror.read_pixels()
                expect(stale_mirror[0] == background).to_equal(false)
                expect(stale_mirror[6] == gpu_color).to_equal(false)

                val gpu_readback = backend.read_pixels_with_source()
                expect(gpu_readback.source).to_equal("device_readback")
                expect(gpu_readback.pixels[6]).to_equal(gpu_color)
                expect(backend.device_current).to_equal(true)
                expect(backend.mirror_current).to_equal(true)

                backend.draw_triangle_filled(1, 1, 5, 1, 1, 5, cpu_color)
                expect(backend.device_current).to_equal(false)
                expect(backend.mirror_current).to_equal(true)

                val final_readback = backend.read_pixels_with_source()
                expect(final_readback.source).to_equal("cpu_fallback")
                expect(final_readback.backend_handle).to_equal(0)
                expect(final_readback.pixels[6]).to_equal(gpu_color)
                expect(final_readback.pixels[15]).to_equal(gpu_color)
                expect(final_readback.pixels[9]).to_equal(cpu_color)
                expect(final_readback.pixels[13]).to_equal(cpu_color)
                expect(final_readback.pixels[41]).to_equal(cpu_color)
                expect(final_readback.pixels[63]).to_equal(background)

                backend.draw_rect_filled(6, 6, 2, 2, gpu_color)
                expect(backend.device_current).to_equal(true)
                expect(backend.mirror_current).to_equal(false)
                val resumed_readback = backend.read_pixels_with_source()
                expect(resumed_readback.source).to_equal("cpu_fallback")
                expect(resumed_readback.pixels[9]).to_equal(cpu_color)
                expect(resumed_readback.pixels[54]).to_equal(gpu_color)
                expect(resumed_readback.pixels[63]).to_equal(gpu_color)
        else:
            # A live qualification that did not run must SAY it did not run,
            # rather than passing silently.
            print "[cuda-live] cuda-authority-live: QUALIFICATION NOT RUN — CudaBackend.init(8, 8) returned false, so no device/mirror authority transition was qualified; this example proves NOTHING about the CUDA authority-state path"
            expect(backend.initialized).to_equal(false)
        backend.shutdown()
