"""Live CUDA proof for fixed-leaf block, flex, and grid layout batches.

## Purpose and audience
Purpose: returns oracle-qualified Latin line ranges from device readback
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-RENDERING-WebLayoCudaLive-001


use std.spec.{describe, it, expect}
use std.common.structural.layout.*
use std.gc_async_mut.gpu.browser_engine.gpu_web.layout.{
    web_cuda_layout_execution_port,
    web_layout_adapt_cpu_oracle,
    web_layout_dirty_frontier,
    web_layout_manager,
    web_layout_run_full
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir_result
}

fn fixed_leaf_semantics(profile_id: text, width: i64, height: i64) -> LayoutNodeSemantics:
    val defaults = layout_node_semantics_default(profile_id)
    val box = defaults.box
    LayoutNodeSemantics(
        first_child_id: 0,
        next_sibling_id: 0,
        child_count: 0,
        node_kind: "normal",
        display: profile_id,
        box: LayoutBoxConstraints(
            width: layout_length_px(width),
            height: layout_length_px(height),
            min_width_px: box.min_width_px,
            max_width_px: box.max_width_px,
            min_height_px: box.min_height_px,
            max_height_px: box.max_height_px,
            border_box: box.border_box,
            padding: box.padding,
            border: box.border,
            margin_left: box.margin_left,
            margin_top: box.margin_top,
            margin_right: box.margin_right,
            margin_bottom: box.margin_bottom,
            margin_auto_bits: box.margin_auto_bits,
            gap_px: box.gap_px,
            row_gap_px: box.row_gap_px,
            column_gap_px: box.column_gap_px
        ),
        flex: defaults.flex,
        grid: defaults.grid,
        position: defaults.position,
        overflow: defaults.overflow,
        gpu_admission_flags: 0
    )

fn live_cuda_layout(profile_id: text) -> LayoutSnapshot:
    val nodes = [
        layout_node(
            1, 0, profile_id, true, false, 1, 100, false,
            fixed_leaf_semantics(profile_id, 120, 40)
        ),
        layout_node(
            2, 0, profile_id, true, false, 1, 100, false,
            fixed_leaf_semantics(profile_id, 80, 24)
        )
    ]
    val oracle = [
        layout_box(1, 0, 0, 120, 40),
        layout_box(2, 0, 0, 80, 24)
    ]
    val input = layout_input(
        nodes, [], [1, 2],
        layout_execution_profile(
            "hybrid_vector_gpu", 1000, 1, 1, 24, 40, 1, 1, 1
        ),
        2, 640, 480, [], oracle
    )
    layout_run_full_with_ports(
        input,
        layout_text_measure_port_unavailable(),
        layout_execution_port_oracle(oracle),
        web_cuda_layout_execution_port(oracle)
    )

fn child_semantics(
    profile_id: text, width: i64, height: i64,
    first_child_id: i64, next_sibling_id: i64, child_count: i64,
    direction: text, column_track_count: i64, row_track_start: i64,
    row_track_count: i64, column_start: i64, row_start: i64
) -> LayoutNodeSemantics:
    val base = fixed_leaf_semantics(profile_id, width, height)
    LayoutNodeSemantics(
        first_child_id: first_child_id,
        next_sibling_id: next_sibling_id,
        child_count: child_count,
        node_kind: base.node_kind,
        display: base.display,
        box: base.box,
        flex: LayoutFlexConstraints(
            direction: direction,
            wrap: "nowrap",
            justify_content: "flex-start",
            align_items: "flex-start",
            align_self: "auto",
            align_content: base.flex.align_content,
            grow: 0,
            shrink: 0,
            basis: layout_length_auto(),
            order: 0,
            direction_rtl: false
        ),
        grid: LayoutGridConstraints(
            column_track_start: 0,
            column_track_count: column_track_count,
            row_track_start: row_track_start,
            row_track_count: row_track_count,
            column_start: column_start,
            column_span: 1,
            row_start: row_start,
            row_span: 1,
            align_items_authored: false
        ),
        position: base.position,
        overflow: base.overflow,
        gpu_admission_flags: 0
    )

fn live_cuda_children(profile_id: text, direction: text) -> LayoutSnapshot:
    val grid = profile_id == "grid"
    val root_width = if grid: 70 else: 120
    val root_height = if grid: 45 else: 80
    val nodes = [
        layout_node(
            1, 0, profile_id, true, false, 1, 100, false,
            child_semantics(
                profile_id, root_width, root_height, 2, 0, 2, direction,
                if grid: 2 else: 0, if grid: 2 else: 0,
                if grid: 2 else: 0, -1, -1
            )
        ),
        layout_node(
            2, 1, profile_id, false, false, 1, 100, false,
            child_semantics(
                profile_id, 30, 10, 0, 3, 0, direction, 0, 0, 0,
                if grid: 0 else: -1, if grid: 0 else: -1
            )
        ),
        layout_node(
            3, 1, profile_id, false, false, 1, 100, false,
            child_semantics(
                profile_id, 40, 20, 0, 0, 0, direction, 0, 0, 0,
                if grid: 1 else: -1, if grid: 1 else: -1
            )
        )
    ]
    val second_x = if grid or (profile_id == "flex" and direction == "row"): 30 else: 0
    val second_y = if grid: 20 elif profile_id == "block" or direction == "column": 10 else: 0
    val oracle = [
        layout_box(1, 0, 0, root_width, root_height),
        layout_box(2, 0, 0, 30, if grid: 20 else: 10),
        layout_box(3, second_x, second_y, 40, if grid: 25 else: 20)
    ]
    val input = layout_input(
        nodes, [], [1],
        layout_execution_profile(
            "hybrid_vector_gpu", 1000, 1, 1, 24, 40, 1, 1, 1
        ),
        2, 640, 480, if grid: [30, 40, 20, 25] else: [], oracle
    )
    layout_run_full_with_ports(
        input,
        layout_text_measure_port_unavailable(),
        layout_execution_port_oracle(oracle),
        web_cuda_layout_execution_port(oracle)
    )

fn expect_child_geometry(
    profile_id: text, direction: text,
    x: i64, y: i64, width: i64, height: i64
):
    val result = live_cuda_children(profile_id, direction)
    expect(result.fault).to_equal("")
    expect(result.backend).to_equal("hybrid_vector_gpu")
    expect(result.boxes.len()).to_equal(3)  # oracle: value fixed by the spec contract
    expect(result.boxes[2].x).to_equal(x)
    expect(result.boxes[2].y).to_equal(y)
    expect(result.boxes[2].width).to_equal(width)
    expect(result.boxes[2].height).to_equal(height)
    expect(result.execution_proof.submitted).to_equal(true)
    expect(result.execution_proof.synchronized).to_equal(true)
    expect(result.execution_proof.device_readback).to_equal(true)
    expect(result.execution_proof.oracle_verified).to_equal(true)

fn semantic_position_overflow(
    base: LayoutNodeSemantics,
    position: LayoutPositionConstraints,
    overflow: LayoutOverflowPolicy
) -> LayoutNodeSemantics:
    LayoutNodeSemantics(
        first_child_id: base.first_child_id,
        next_sibling_id: base.next_sibling_id,
        child_count: base.child_count,
        node_kind: base.node_kind,
        display: base.display,
        box: base.box,
        flex: base.flex,
        grid: base.grid,
        position: position,
        overflow: overflow,
        gpu_admission_flags: base.gpu_admission_flags
    )

fn fixed_position(
    kind: text, left: LayoutLength, top: LayoutLength,
    right: LayoutLength, bottom: LayoutLength
) -> LayoutPositionConstraints:
    LayoutPositionConstraints(
        kind: kind, left: left, top: top, right: right, bottom: bottom
    )

fn live_cuda_absolute(offset_unit: text = LAYOUT_LENGTH_PX) -> LayoutSnapshot:
    val root_base = child_semantics(
        "absolute-sticky", 100, 80, 2, 0, 1, "row", 0, 0, 0, -1, -1
    )
    val child_base = child_semantics(
        "absolute-sticky", 20, 10, 0, 0, 0, "row", 0, 0, 0, -1, -1
    )
    val root = semantic_position_overflow(
        root_base,
        layout_position_constraints_default(),
        layout_overflow_policy_default()
    )
    val child = semantic_position_overflow(
        child_base,
        fixed_position(
            LAYOUT_POSITION_ABSOLUTE,
            layout_length_auto(), layout_length_auto(),
            LayoutLength(unit: offset_unit, value: 10), layout_length_px(15)
        ),
        layout_overflow_policy_default()
    )
    val nodes = [
        layout_node(1, 0, "absolute-sticky", true, false, 1, 100, false, root),
        layout_node(2, 1, "absolute-sticky", false, false, 1, 100, false, child)
    ]
    val oracle = [layout_box(1, 0, 0, 100, 80), layout_box(2, 70, 55, 20, 10)]
    val artifacts = layout_oracle_artifacts(
        [
            layout_fragment(1, 1, oracle[0], "principal", 0),
            layout_fragment(2, 2, oracle[1], "principal", 0)
        ],
        [],
        [
            layout_overflow(1, oracle[0], 100, 80),
            layout_overflow(2, oracle[1], 20, 10)
        ]
    )
    val input = layout_input(
        nodes, [], [1],
        layout_execution_profile("hybrid_vector_gpu", 1000, 1, 1, 24, 40, 1, 1, 1),
        2, 640, 480, [], oracle, artifacts
    )
    layout_run_full_with_ports(
        input,
        layout_text_measure_port_unavailable(),
        layout_execution_port_oracle_with_artifacts(oracle, artifacts),
        web_cuda_layout_execution_port(oracle)
    )

fn live_cuda_scroll() -> LayoutSnapshot:
    val root_base = child_semantics(
        "scroll", 60, 30, 2, 0, 2, "column", 0, 0, 0, -1, -1
    )
    val child1 = child_semantics(
        "scroll", 50, 20, 0, 3, 0, "column", 0, 0, 0, -1, -1
    )
    val child2 = child_semantics(
        "scroll", 80, 25, 0, 0, 0, "column", 0, 0, 0, -1, -1
    )
    val root = semantic_position_overflow(
        root_base,
        layout_position_constraints_default(),
        LayoutOverflowPolicy(x: LAYOUT_OVERFLOW_VISIBLE, y: LAYOUT_OVERFLOW_AUTO)
    )
    val nodes = [
        layout_node(1, 0, "scroll", true, false, 1, 100, false, root),
        layout_node(2, 1, "scroll", false, false, 1, 100, false, child1),
        layout_node(3, 1, "scroll", false, false, 1, 100, false, child2)
    ]
    val oracle = [
        layout_box(1, 0, 0, 60, 30),
        layout_box(2, 0, 0, 50, 20),
        layout_box(3, 0, 20, 80, 25)
    ]
    val artifacts = layout_oracle_artifacts(
        [
            layout_fragment(1, 1, oracle[0], "principal", 0),
            layout_fragment(2, 2, oracle[1], "principal", 0),
            layout_fragment(3, 3, oracle[2], "principal", 0)
        ],
        [],
        [
            layout_overflow(1, oracle[0], 80, 45),
            layout_overflow(2, oracle[1], 50, 20),
            layout_overflow(3, oracle[2], 80, 25)
        ]
    )
    val input = layout_input(
        nodes, [], [1],
        layout_execution_profile("hybrid_vector_gpu", 1000, 1, 1, 24, 40, 1, 1, 1),
        2, 640, 480, [], oracle, artifacts
    )
    layout_run_full_with_ports(
        input,
        layout_text_measure_port_unavailable(),
        layout_execution_port_oracle_with_artifacts(oracle, artifacts),
        web_cuda_layout_execution_port(oracle)
    )

use std.spec.step
describe "web CUDA layout live proof":
    it "returns oracle-qualified Latin line ranges from device readback":
        step("Verify: returns oracle-qualified Latin line ranges from device readback")
        # @req: REQ-RENDERING-WebLayoCudaLive-001
        val browser = simple_web_layout_render_html_draw_ir_result(
            "<div style='width:48px'>alpha beta gamma delta</div>",
            320, 240
        )
        val execution = layout_execution_profile(
            "hybrid_vector_gpu", 1000, 1, 1, 24, 40, 1, 1, 1
        )
        val adapted = web_layout_adapt_cpu_oracle(browser, 9, execution, 4)
        expect(adapted.fault).to_equal("")
        val run = web_layout_run_full(
            web_layout_manager(9), adapted.snapshot,
            web_layout_dirty_frontier([])
        )
        expect(run.result.fault).to_equal("")
        expect(run.result.gpu_line_break.admitted).to_equal(true)
        expect(run.result.gpu_line_break.submitted).to_equal(true)
        expect(run.result.gpu_line_break.synchronized).to_equal(true)
        expect(run.result.gpu_line_break.device_readback).to_equal(true)
        expect(run.result.gpu_line_break.oracle_verified).to_equal(true)
        expect(run.result.gpu_line_break.ranges.len()).to_be_greater_than(1)

    it "computes fixed leaf geometry on-device for block flex and grid":
        step("Verify: computes fixed leaf geometry on-device for block flex and grid")
        # @req: REQ-RENDERING-WebLayoCudaLive-001
        for profile_id in ["block", "flex", "grid"]:
            val result = live_cuda_layout(profile_id)
            expect(result.fault).to_equal("")
            expect(result.backend).to_equal("hybrid_vector_gpu")
            expect(result.boxes.len()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(result.execution_proof.submitted).to_equal(true)
            expect(result.execution_proof.synchronized).to_equal(true)
            expect(result.execution_proof.device_readback).to_equal(true)
            expect(result.execution_proof.oracle_verified).to_equal(true)

    it "computes one-level fixed child geometry on-device":
        step("Verify: computes one-level fixed child geometry on-device")
        # @req: REQ-RENDERING-WebLayoCudaLive-001
        expect_child_geometry("block", "row", 0, 10, 40, 20)
        expect_child_geometry("flex", "row", 30, 0, 40, 20)
        expect_child_geometry("flex", "column", 0, 10, 40, 20)
        expect_child_geometry("grid", "row", 30, 20, 40, 25)

    it "computes one-level absolute right and bottom offsets on-device":
        step("Verify: computes one-level absolute right and bottom offsets on-device")
        # @req: REQ-RENDERING-WebLayoCudaLive-001
        val result = live_cuda_absolute()
        expect(result.fault).to_equal("")
        expect(result.backend).to_equal("hybrid_vector_gpu")
        expect(result.boxes[1].x).to_equal(70)  # oracle: value fixed by the spec contract
        expect(result.boxes[1].y).to_equal(55)  # oracle: value fixed by the spec contract
        expect(result.execution_proof.device_readback).to_equal(true)
        expect(result.execution_proof.oracle_verified).to_equal(true)

    it "computes clip boxes and scroll extents on-device":
        step("Verify: computes clip boxes and scroll extents on-device")
        # @req: REQ-RENDERING-WebLayoCudaLive-001
        val result = live_cuda_scroll()
        expect(result.fault).to_equal("")
        expect(result.backend).to_equal("hybrid_vector_gpu")
        expect(result.overflows[0].clip_box.width).to_equal(60)  # oracle: value fixed by the spec contract
        expect(result.overflows[0].clip_box.height).to_equal(30)  # oracle: value fixed by the spec contract
        expect(result.overflows[0].scroll_width).to_equal(80)  # oracle: value fixed by the spec contract
        expect(result.overflows[0].scroll_height).to_equal(45)  # oracle: value fixed by the spec contract

    it "rejects unsupported absolute offset units before submission":
        step("Verify: rejects unsupported absolute offset units before submission")
        # @req: REQ-RENDERING-WebLayoCudaLive-001
        val result = live_cuda_absolute(LAYOUT_LENGTH_PERCENT)
        expect(result.backend).to_equal("serial_cpu")
        expect(result.receipt.fallback_reason).to_equal("cuda-layout-absolute-feature-unsupported")
        expect(result.execution_proof.submitted).to_equal(false)
