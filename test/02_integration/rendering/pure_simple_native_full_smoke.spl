# Standalone Pure-Simple native Mach-O + seed qualification smoke across Waves A and B1-B5.
# Compiled with `phase2-aarch64-apple-darwin/simple native-build --entry-closure` and also runnable on `bin/simple run`.

use std.io_runtime.{cwd, file_read}
use std.nogc_sync_mut.io.time_ops.{time_now_micros}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
