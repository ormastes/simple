    WM_CHROME_KIND_TITLED,
    simple_gui_internal_window_scene,
    simple_gui_internal_window_with_chrome_kind
}
use common.ui.window_scene_draw_ir.{shared_wm_scene_aqua_draw_ir_composition}
use std.editor.core.session.{EditSession}
use app.editor.gui_shell_render.{IdeGuiFrame, ide_render_gui_frame}
