# @manual_section: text helpers
describe "helpers_text — dimensions":

    it "text_buf_height equals glyph_height at font_size 7":
        # @req REQ-HELPERSPAR-036
        # @capture(statistics): buffer height retained
        step("Measure the text buffer height at font size 7")
        val h = text_buf_height(7)
        expect(h).to_equal(7)  # oracle: buffer height equals the font size at the base scale

    it "text_buf_height scales with font_size":
        # @req REQ-HELPERSPAR-037
        # @capture(statistics): scaled buffer height retained
        step("Measure the text buffer height at font size 14")
        val h = text_buf_height(14)
        expect(h).to_equal(14)  # oracle: buffer height tracks a doubled font size one-to-one

    it "text_buf_width: empty string returns 0":
        # @req REQ-HELPERSPAR-038
        # @capture(statistics): empty-string width retained
        step("Measure the width of an empty string")
        expect(text_buf_width("", 7)).to_equal(0)  # oracle: zero glyphs consume zero advance width

    it "text_buf_width: single char at scale 1":
        # @req REQ-HELPERSPAR-039
        # @capture(statistics): single-char width retained
        step("Measure the width of one character at scale 1")
        # advance = 5 * scale (unified with browser paint); scale = 7/7 = 1
        expect(text_buf_width("A", 7)).to_equal(5)  # oracle: the shared glyph advance is exactly 5 at unit scale, matching the browser paint path

    it "text_buf_width: 3 chars at scale 1":
        # @req REQ-HELPERSPAR-040
        # @capture(statistics): three-char width retained
        step("Measure the width of three characters at scale 1")
        expect(text_buf_width("ABC", 7)).to_equal(15)  # oracle: three glyphs at advance 5 each sum to 15

    it "text_scale: font_size 7 gives scale 1":
        # @req REQ-HELPERSPAR-041
        # @capture(statistics): base scale retained
        step("Compute the text scale at font size 7")
        expect(text_scale(7)).to_equal(1)  # oracle: font size 7 is the base glyph height, so scale is exactly 1

    it "text_scale: font_size 14 gives scale 2":
        # @req REQ-HELPERSPAR-042
        # @capture(statistics): doubled scale retained
        step("Compute the text scale at font size 14")
        expect(text_scale(14)).to_equal(2)  # oracle: 14 is double the base 7, so scale is exactly 2

    it "text_scale: font_size < 7 is clamped to 1":
        # @req REQ-HELPERSPAR-043
        # @capture(statistics): clamped scale retained
        step("Compute the text scale below the base font size")
        expect(text_scale(1)).to_equal(1)  # oracle: the scale floor is 1 — sub-base font sizes never downscale

describe "helpers_text — render_to_buf":

    it "text_render_to_buf: empty text returns empty buffer":
        # @req REQ-HELPERSPAR-044
        # @capture(statistics): empty render buffer size retained
        step("Render an empty string and require an empty buffer")
        val buf = text_render_to_buf("", 0xFFFFFFFFu32, 0xFF000000u32, 7)
        expect(buf.len()).to_equal(0)  # oracle: zero-width text must produce a zero-length buffer

    it "text_render_to_buf: buffer size matches dimensions":
        # @req REQ-HELPERSPAR-045
        # @capture(statistics): rendered buffer size retained
        step("Render two characters and check the buffer length formula")
        val buf = text_render_to_buf("Hi", 0xFFFFFFFFu32, 0xFF000000u32, 7)
        val expected_len = text_buf_width("Hi", 7) * text_buf_height(7)
        expect(buf.len()).to_equal(expected_len)

    it "text_render_to_buf: background color fills non-glyph pixels":
        # @req REQ-HELPERSPAR-046
        # @capture(statistics): background fill ratio retained
        step("Render a blank space glyph and require an all-background buffer")
        val bg = rgba(0, 0, 255, 255)
        val fg = rgba(255, 0, 0, 255)
        val buf = text_render_to_buf(" ", fg, bg, 7)
        # Space glyph has no set bits — entire buffer should be background
        var all_bg = true
        var bi = 0
        while bi < buf.len():
            if buf[bi] != bg:
                all_bg = false
            bi = bi + 1
        expect(all_bg).to_be(true)

    it "text_render_to_buf: parity with inline draw_text_bg pattern":
        # @req REQ-HELPERSPAR-047
        # @capture(statistics): inline-vs-helper buffer diff retained
        step("Render via the helper and the inline draw_text_bg pattern and diff every pixel")
        # This mirrors the body in each GPU backend's draw_text_bg:
        #   fill buffer with bg, call render_text_to_buffer, blit.
        # We verify text_render_to_buf produces same buffer as the inline form.
        use std.gpu.engine2d.glyph.{glyph_height, glyph_advance, render_text_to_buffer}
        val text_val = "X"
        val font_size = 7
        val fg = rgb(255, 255, 255)
        val bg = rgb(0, 0, 0)
        val gh = glyph_height()
        var scale = font_size / gh
        if scale < 1:
            scale = 1
        val advance = glyph_advance(scale)
        val text_w = text_val.len().to_i32() * advance
        val text_h = gh * scale
        var inline_buf: [u32] = []
        var fill_i = 0
        while fill_i < text_w * text_h:
            inline_buf.push(bg)
            fill_i = fill_i + 1
        inline_buf = render_text_to_buffer(inline_buf, text_w, text_h, 0, 0, text_val, fg, font_size)
        val helper_buf = text_render_to_buf(text_val, fg, bg, font_size)
        expect(helper_buf.len()).to_equal(inline_buf.len())
        var match_ok = true
        var ci = 0
        while ci < inline_buf.len():
            if inline_buf[ci] != helper_buf[ci]:
                match_ok = false
            ci = ci + 1
        expect(match_ok).to_be(true)

# ============================================================================
# helpers_availability parity
# ============================================================================

# @manual_section: availability helpers
describe "helpers_availability — backend names":

    it "backend_display_name: rocm includes HIP":
        # @req REQ-HELPERSPAR-048
        # @capture(statistics): rocm display name retained
        step("Read the display name for the rocm backend")
        val n = backend_display_name("rocm")
        expect(n).to_equal("AMD ROCm/HIP")

    it "backend_display_name: vulkan":
        # @req REQ-HELPERSPAR-049
        # @capture(statistics): vulkan display name retained
        step("Read the display name for the vulkan backend")
        val n = backend_display_name("vulkan")
        expect(n).to_equal("Vulkan Compute")

    it "backend_display_name: cpu":
        # @req REQ-HELPERSPAR-050
        # @capture(statistics): cpu display name retained
        step("Read the display name for the cpu backend")
        val n = backend_display_name("cpu")
        expect(n).to_equal("CPU Software (fallback)")

    it "backend_display_name: unknown":
        # @req REQ-HELPERSPAR-051
        # @capture(statistics): unknown display name retained
        step("Read the display name for an unknown backend id")
        val n = backend_display_name("unknown_xyz")
        expect(n.starts_with("Unknown")).to_be_true()

    it "backend_priority: metal is highest priority (0)":
        # @req REQ-HELPERSPAR-052
        # @capture(statistics): top-three priority ranks retained
        step("Read the priority ranks for metal cuda and rocm")
        expect(backend_priority("metal")).to_equal(0)  # oracle: rank 0 is the documented head of the preference order
        expect(backend_priority("cuda")).to_equal(1)  # oracle: cuda follows metal at rank 1 in the documented order
        expect(backend_priority("rocm")).to_equal(2)  # oracle: rocm follows cuda at rank 2 in the documented order

    it "backend_priority: cpu is lowest priority (12)":
        # @req REQ-HELPERSPAR-053
        # @capture(statistics): cpu priority rank retained
        step("Read the priority rank for the cpu fallback")
        expect(backend_priority("cpu")).to_equal(12)  # oracle: the software fallback is documented last at rank 12

    it "backend_priority: vulkan < software < cpu":
        # @req REQ-HELPERSPAR-054
        # @capture(statistics): vulkan-software-cpu rank ordering retained
        step("Check the vulkan software and cpu ranks are strictly ordered")
        val v = backend_priority("vulkan")
        val s = backend_priority("software")
        val c = backend_priority("cpu")
        expect(v).to_be_less_than(s)
        expect(s).to_be_less_than(c)

    it "backend_default_priority_order starts at Metal then CUDA HIP then Vulkan":
        # @req REQ-HELPERSPAR-055
        # @capture(statistics): default preference order retained
        step("Read the default preference order and check its documented slots")
        val order = backend_default_priority_order()
        expect(order[0]).to_equal("metal")
        expect(order[1]).to_equal("cuda")
        expect(order[2]).to_equal("rocm")
        expect(order[4]).to_equal("vulkan")
        expect(order[5]).to_equal("directx")
        expect(order[6]).to_equal("opencl")
        expect(order[order.len() - 1]).to_equal("cpu")

    it "backend_full_preference_order keeps native surfaces before auto GPU order":
        # @req REQ-HELPERSPAR-056
        # @capture(statistics): full preference order retained
        step("Read the full preference order and check its native-surface head")
        val order = backend_full_preference_order()
        expect(order[0]).to_equal("baremetal")
        expect(order[1]).to_equal("virtio_gpu")
        expect(order[2]).to_equal("metal")
        expect(order[3]).to_equal("cuda")
        expect(order[4]).to_equal("rocm")

    it "backend_is_hardware: cuda is hardware":
        # @req REQ-HELPERSPAR-057
        # @capture(bit_table): cuda hardware flag retained
        step("Check that cuda is classified as hardware")
        expect(backend_is_hardware("cuda")).to_be(true)

    it "backend_is_hardware: cpu is not hardware":
        # @req REQ-HELPERSPAR-058
        # @capture(bit_table): cpu hardware flag retained
        step("Check that cpu is not classified as hardware")
        expect(backend_is_hardware("cpu")).to_be(false)

    it "backend_is_hardware: software is not hardware":
        # @req REQ-HELPERSPAR-059
        # @capture(bit_table): software hardware flag retained
        step("Check that software is not classified as hardware")
        expect(backend_is_hardware("software")).to_be(false)

    it "backend_requires_gpu: cuda requires GPU":
        # @req REQ-HELPERSPAR-060
        # @capture(bit_table): cuda gpu requirement retained
        step("Check that cuda is marked GPU-required")
        expect(backend_requires_gpu("cuda")).to_be(true)

    it "backend_requires_gpu: vulkan does not require (can software fallback)":
        # @req REQ-HELPERSPAR-061
        # @capture(bit_table): vulkan gpu requirement retained
        step("Check that vulkan is not marked GPU-required")
        expect(backend_requires_gpu("vulkan")).to_be(false)

    it "backend_requires_gpu: cpu does not require GPU":
        # @req REQ-HELPERSPAR-062
        # @capture(bit_table): cpu gpu requirement retained
        step("Check that cpu is not marked GPU-required")
        expect(backend_requires_gpu("cpu")).to_be(false)

    it "feature_gate_description: returns non-empty text for all known backends":
        # @req REQ-HELPERSPAR-063
        # @capture(bit_table): per-backend gate description flags retained
        step("Read the feature gate description for every known backend")
        val names = ["cuda", "rocm", "metal", "qualcomm", "vulkan", "opengl", "intel", "webgpu", "software", "cpu"]
        var all_ok = true
        var ni = 0
        while ni < 10:
            val desc = feature_gate_description(names[ni])
            if desc.len() == 0:
                all_ok = false
            ni = ni + 1
        expect(all_ok).to_be(true)

describe "helpers_availability — numeric conversions":

    it "backend_i64: converts i32 to i64":
        # @req REQ-HELPERSPAR-064
        # @capture(statistics): widened conversion value retained
        step("Widen 42 from i32 to i64")
        expect(backend_i64(42)).to_equal(42)  # oracle: a sign-preserving widening of 42 is exactly 42

    it "backend_i64: handles negative":
        # @req REQ-HELPERSPAR-065
        # @capture(statistics): negative conversion value retained
        step("Widen -1 from i32 to i64")
        expect(backend_i64(-1)).to_equal(-1)  # oracle: a sign-preserving widening of -1 must stay -1, never wrap

    it "backend_bool_to_i32: true -> 1":
        # @req REQ-HELPERSPAR-066
        # @capture(statistics): true conversion value retained
        step("Convert true to its i32 encoding")
        expect(backend_bool_to_i32(true)).to_equal(1)  # oracle: the boolean encoding maps true to exactly 1

    it "backend_bool_to_i32: false -> 0":
        # @req REQ-HELPERSPAR-067
        # @capture(statistics): false conversion value retained
        step("Convert false to its i32 encoding")
        expect(backend_bool_to_i32(false)).to_equal(0)  # oracle: the boolean encoding maps false to exactly 0
