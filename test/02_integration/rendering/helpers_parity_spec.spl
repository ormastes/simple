"""
## Purpose and audience
Focused parity tests proving that the extracted shared helpers
(helpers_clip, helpers_pixel, helpers_text, helpers_availability)
produce the same results as the inline code they replace inside
the CPU/software backends. The text-metric contract (advance = 5 *
scale) is unified with the browser paint path via the web layout
manager, so the helpers lane and the web renderer cannot drift
apart silently.
Audience: Engine2D backend engineers touching any helper module or
inlining equivalent logic back into a backend.

## Operator workflow
Run the single file with the seed runner (`simple run
test/02_integration/rendering/helpers_parity_spec.spl`). Every
scenario is host-neutral: pure function calls, no GPU, no window
system, no environment gating.

## Compatibility and limitations
These are direct contract checks on the helper functions, not full
backend renders — a backend that bypasses the helpers can still
drift and is caught by the backend-level parity specs instead.
Numeric literals are pinned to the documented helper contracts
(4 bytes per pixel, advance 5 per glyph unit scale, priority ranks).

## Verification guidance and troubleshooting
A failure names the helper and input that diverged: for clip
helpers check the exclusive-edge convention, for pixel helpers the
premultiply rounding, for text helpers the advance formula shared
with `src/lib/.../web_layout_manager.spl`, for availability helpers
the preference-order table.

@tag: rendering, engine2d, helpers
@cover src/lib/gc_async_mut/gpu/engine2d/helpers_clip.spl 80%
@cover src/lib/gc_async_mut/gpu/engine2d/helpers_pixel.spl 80%
@cover src/lib/gc_async_mut/gpu/engine2d/helpers_text.spl 80%
@cover src/lib/gc_async_mut/gpu/engine2d/helpers_availability.spl 70%
"""

# Lifecycle: research doc/01_research/domain/web_layout_manager.md ;
# plan doc/03_plan/agent_tasks/web_layout_manager.md ;
# architecture doc/04_architecture/web_layout_manager.md ;
# design doc/05_design/web_layout_manager.md

use std.spec.{describe, context, it, expect}
use std.gpu.engine2d.helpers_clip.{
    clip_point_in_bounds, clip_point_in_rect,
    clip_pixel_allowed, rect_intersect_w, rect_intersect_h,
    clip_rect_to_viewport, mask_blocks_at, pixel_index
}
use std.gpu.engine2d.helpers_pixel.{
    buf_get_pixel, buf_set_pixel, buf_set_pixel_blend,
    alpha_premultiply, alpha_unpremultiply,
    pixels_to_bytes, bytes_to_pixels
}
use std.gpu.engine2d.helpers_text.{
    text_buf_width, text_buf_height, text_scale, text_render_to_buf
}
use std.gpu.engine2d.helpers_availability.{
    backend_display_name, backend_priority, backend_is_hardware,
    backend_requires_gpu, feature_gate_description, backend_default_priority_order,
    backend_full_preference_order, backend_i64, backend_bool_to_i32
}
use std.gpu.engine2d.color.{rgba, rgb, color_r, color_g, color_b, color_a, blend}

# ============================================================================
# helpers_clip parity
# ============================================================================

# @manual_section: clip helpers
describe "helpers_clip — bounds checking":

    it "clip_point_in_bounds: interior point is in bounds":
        # @req REQ-HELPERSPAR-001
        # @capture(bit_table): in-bounds verdict retained
        step("Check an interior point against the clip bounds")
        expect(clip_point_in_bounds(5, 5, 10, 10)).to_be(true)

    it "clip_point_in_bounds: (0,0) is in bounds":
        # @req REQ-HELPERSPAR-002
        # @capture(bit_table): origin in-bounds verdict retained
        step("Check the origin against the clip bounds")
        expect(clip_point_in_bounds(0, 0, 10, 10)).to_be(true)

    it "clip_point_in_bounds: right edge (exclusive) is out of bounds":
        # @req REQ-HELPERSPAR-003
        # @capture(bit_table): exclusive-right-edge verdict retained
        step("Check that the exclusive right edge is rejected")
        expect(clip_point_in_bounds(10, 5, 10, 10)).to_be(false)

    it "clip_point_in_bounds: bottom edge (exclusive) is out of bounds":
        # @req REQ-HELPERSPAR-004
        # @capture(bit_table): exclusive-bottom-edge verdict retained
        step("Check that the exclusive bottom edge is rejected")
        expect(clip_point_in_bounds(5, 10, 10, 10)).to_be(false)

    it "clip_point_in_bounds: negative x is out of bounds":
        # @req REQ-HELPERSPAR-005
        # @capture(bit_table): negative-x verdict retained
        step("Check that a negative x coordinate is rejected")
        expect(clip_point_in_bounds(-1, 5, 10, 10)).to_be(false)

    it "clip_point_in_rect: point inside clip rect":
        # @req REQ-HELPERSPAR-006
        # @capture(bit_table): point-inside-rect verdict retained
        step("Check a point inside the clip rect")
        expect(clip_point_in_rect(6, 6, 5, 5, 5, 5)).to_be(true)

    it "clip_point_in_rect: point outside clip rect":
        # @req REQ-HELPERSPAR-007
        # @capture(bit_table): point-outside-rect verdict retained
        step("Check a point outside the clip rect")
        expect(clip_point_in_rect(3, 3, 5, 5, 5, 5)).to_be(false)

    it "clip_pixel_allowed: no clip — passes bounds check":
        # @req REQ-HELPERSPAR-008
        # @capture(bit_table): unclipped-pixel verdict retained
        step("Check that an in-bounds pixel passes with clipping disabled")
        expect(clip_pixel_allowed(3, 3, 10, 10, false, 0, 0, 10, 10)).to_be(true)

    it "clip_pixel_allowed: clip enabled, point inside — allowed":
        # @req REQ-HELPERSPAR-009
        # @capture(bit_table): clipped-inside verdict retained
        step("Check that an in-clip pixel passes with clipping enabled")
        expect(clip_pixel_allowed(6, 6, 10, 10, true, 5, 5, 5, 5)).to_be(true)

    it "clip_pixel_allowed: clip enabled, point outside — blocked":
        # @req REQ-HELPERSPAR-010
        # @capture(bit_table): clipped-outside verdict retained
        step("Check that an out-of-clip pixel is blocked")
        expect(clip_pixel_allowed(3, 3, 10, 10, true, 5, 5, 5, 5)).to_be(false)

    it "clip_pixel_allowed: out of framebuffer — blocked regardless of clip":
        # @req REQ-HELPERSPAR-011
        # @capture(bit_table): framebuffer-bounds verdict retained
        step("Check that an out-of-framebuffer pixel is blocked even unclipped")
        expect(clip_pixel_allowed(-1, 5, 10, 10, false, 0, 0, 10, 10)).to_be(false)

    it "rect_intersect_w: overlapping rects":
        # @req REQ-HELPERSPAR-012
        # @capture(statistics): intersection width retained
        step("Intersect two overlapping rects horizontally")
        val w = rect_intersect_w(0, 8, 4, 8)
        expect(w).to_equal(4)  # oracle: rects spanning x 0-8 and 4-12 overlap for exactly 4 pixels

    it "rect_intersect_w: disjoint rects yields non-positive width":
        # @req REQ-HELPERSPAR-013
        # @capture(bit_table): disjoint-rect verdict retained
        step("Intersect two disjoint rects horizontally")
        val w = rect_intersect_w(0, 5, 10, 5)
        expect(w <= 0).to_be_true()

    it "rect_intersect_h: overlapping rects":
        # @req REQ-HELPERSPAR-014
        # @capture(statistics): intersection height retained
        step("Intersect two overlapping rects vertically")
        val h = rect_intersect_h(0, 8, 4, 8)
        expect(h).to_equal(4)  # oracle: rects spanning y 0-8 and 4-12 overlap for exactly 4 pixels

    it "clip_rect_to_viewport: rect fully inside":
        # @req REQ-HELPERSPAR-015
        # @capture(bit_table): rect-inside-viewport verdict retained
        step("Check that a fully inside rect passes the viewport clip")
        expect(clip_rect_to_viewport(1, 1, 5, 5, 10, 10)).to_be(true)

    it "clip_rect_to_viewport: rect fully outside right":
        # @req REQ-HELPERSPAR-016
        # @capture(bit_table): rect-outside-right verdict retained
        step("Check that a rect past the right edge fails the viewport clip")
        expect(clip_rect_to_viewport(15, 0, 5, 5, 10, 10)).to_be(false)

    it "clip_rect_to_viewport: rect fully outside top":
        # @req REQ-HELPERSPAR-017
        # @capture(bit_table): rect-outside-top verdict retained
        step("Check that a rect above the top edge fails the viewport clip")
        expect(clip_rect_to_viewport(0, -10, 5, 5, 10, 10)).to_be(false)

    it "pixel_index: correct flat index":
        # @req REQ-HELPERSPAR-018
        # @capture(statistics): flat index retained
        step("Flatten the coordinate (3,2) on a 10-wide buffer")
        expect(pixel_index(3, 2, 10)).to_equal(23)  # oracle: flat index is y*width+x, so 2*10+3 = 23

describe "helpers_clip — mask":

    it "mask_blocks_at: empty mask never blocks":
        # @req REQ-HELPERSPAR-019
        # @capture(bit_table): empty-mask verdict retained
        step("Check that an empty mask blocks nothing")
        var empty_mask: [u8] = []
        expect(mask_blocks_at(empty_mask, 10, 5, 5)).to_be(false)

    it "mask_blocks_at: mask byte 0 blocks":
        # @req REQ-HELPERSPAR-020
        # @capture(bit_table): mask-zero-blocks verdict retained
        step("Check that a zero mask byte blocks the pixel")
        var mask: [u8] = [1u8, 0u8, 1u8]
        expect(mask_blocks_at(mask, 3, 1, 0)).to_be(true)

    it "mask_blocks_at: mask byte 1 does not block":
        # @req REQ-HELPERSPAR-021
        # @capture(bit_table): mask-one-passes verdict retained
        step("Check that a one mask byte lets the pixel through")
        var mask: [u8] = [1u8, 0u8, 1u8]
        expect(mask_blocks_at(mask, 3, 0, 0)).to_be(false)

    it "mask_blocks_at: out-of-range coordinate does not block":
        # @req REQ-HELPERSPAR-022
        # @capture(bit_table): out-of-range-mask verdict retained
        step("Check that an out-of-range mask coordinate blocks nothing")
        var mask: [u8] = [0u8]
        expect(mask_blocks_at(mask, 1, 5, 5)).to_be(false)

# ============================================================================
# helpers_pixel parity
