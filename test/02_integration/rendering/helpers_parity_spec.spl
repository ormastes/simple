# @manual_section: pixel helpers
describe "helpers_pixel — buffer access":

    it "buf_get_pixel: returns 0 for out-of-bounds":
        # @req REQ-HELPERSPAR-023
        # @capture(statistics): out-of-bounds read value retained
        step("Read outside a 1x1 buffer and require the zero sentinel")
        var buf: [u32] = [0xFFFF0000u32]
        expect(buf_get_pixel(buf, 1, 0, 1, 1)).to_equal(0u32)  # oracle: out-of-bounds reads return the documented 0 sentinel, never memory noise

    it "buf_get_pixel: reads in-bounds pixel":
        # @req REQ-HELPERSPAR-024
        # @capture(statistics): in-bounds read value retained
        step("Read a planted pixel back from the buffer")
        var buf: [u32] = [0u32, 0u32, 0xAABBCCDDu32, 0u32]
        val got = buf_get_pixel(buf, 2, 0, 4, 1)
        expect(got).to_equal(0xAABBCCDDu32)  # oracle: the read must return the exact planted pixel value

    it "buf_set_pixel: writes in-bounds pixel":
        # @req REQ-HELPERSPAR-025
        # @capture(statistics): written pixel value retained
        step("Write a pixel in-bounds and read it back")
        var buf: [u32] = [0u32, 0u32, 0u32, 0u32]
        buf_set_pixel(buf, 2, 0, 4, 1, 0xDEADBEEFu32)
        expect(buf[2]).to_equal(0xDEADBEEFu32)  # oracle: the write must land the exact value at the requested index

    it "buf_set_pixel: out-of-bounds write is ignored":
        # @req REQ-HELPERSPAR-026
        # @capture(statistics): untouched buffer slot retained
        step("Write far out of bounds and require the buffer to stay untouched")
        var buf: [u32] = [0u32]
        buf_set_pixel(buf, 5, 5, 1, 1, 0xFFFFFFFFu32)
        expect(buf[0]).to_equal(0u32)  # oracle: an out-of-bounds write must not corrupt any in-bounds slot

    it "buf_set_pixel_blend: opaque src replaces dst":
        # @req REQ-HELPERSPAR-027
        # @capture(statistics): blended opaque pixel retained
        step("Blend an opaque red over black and check the red channel")
        var buf: [u32] = [rgb(0, 0, 0)]
        val src = rgb(255, 0, 0)
        buf_set_pixel_blend(buf, 0, 0, 1, 1, src)
        expect(color_r(buf[0])).to_equal(255)  # oracle: alpha-255 src fully replaces the dst red channel

    it "buf_set_pixel_blend: transparent src leaves dst unchanged":
        # @req REQ-HELPERSPAR-028
        # @capture(statistics): blended transparent pixel retained
        step("Blend a fully transparent source over green and check the green channel")
        var buf: [u32] = [rgb(0, 255, 0)]
        val src = rgba(255, 0, 0, 0)
        buf = buf_set_pixel_blend(buf, 0, 0, 1, 1, src)
        expect(color_g(buf[0])).to_equal(255)  # oracle: alpha-0 src contributes nothing, dst stays fully green

describe "helpers_pixel — alpha compositing":

    it "alpha_premultiply: opaque color is unchanged":
        # @req REQ-HELPERSPAR-029
        # @capture(statistics): premultiplied opaque color retained
        step("Premultiply an opaque color and require it unchanged")
        val c = rgb(100, 150, 200)
        expect(alpha_premultiply(c)).to_equal(c)

    it "alpha_premultiply: transparent returns 0":
        # @req REQ-HELPERSPAR-030
        # @capture(statistics): premultiplied transparent color retained
        step("Premultiply a fully transparent color and require zero")
        val c = rgba(255, 255, 255, 0)
        expect(alpha_premultiply(c)).to_equal(0u32)  # oracle: alpha-0 channels premultiply to exactly 0

    it "alpha_premultiply: 50% alpha halves RGB":
        # @req REQ-HELPERSPAR-031
        # @capture(statistics): premultiplied half-alpha channel retained
        step("Premultiply a half-alpha color and check the red channel range")
        val c = rgba(200, 200, 200, 128)
        val pm = alpha_premultiply(c)
        val r = color_r(pm)
        expect(r >= 98 and r <= 102).to_be_true()

    it "alpha_unpremultiply: zero alpha returns 0":
        # @req REQ-HELPERSPAR-032
        # @capture(statistics): unpremultiplied zero-alpha color retained
        step("Unpremultiply zero and require zero")
        expect(alpha_unpremultiply(0u32)).to_equal(0u32)  # oracle: unpremultiply of 0 cannot divide by zero — it must return exactly 0

    it "alpha_unpremultiply: opaque color is unchanged":
        # @req REQ-HELPERSPAR-033
        # @capture(statistics): unpremultiplied opaque color retained
        step("Unpremultiply an opaque color and require it unchanged")
        val c = rgb(80, 160, 240)
        expect(alpha_unpremultiply(c)).to_equal(c)

    it "pixels_to_bytes: 4 bytes per pixel":
        # @req REQ-HELPERSPAR-034
        # @capture(statistics): byte count retained
        step("Convert 10 pixels to bytes")
        expect(pixels_to_bytes(10)).to_equal(40)  # oracle: the RGBA8 contract is exactly 4 bytes per pixel

    it "bytes_to_pixels: inverse of pixels_to_bytes":
        # @req REQ-HELPERSPAR-035
        # @capture(statistics): round-trip pixel count retained
        step("Round-trip 7 pixels through the byte conversion")
        expect(bytes_to_pixels(pixels_to_bytes(7))).to_equal(7)  # oracle: bytes_to_pixels must invert pixels_to_bytes exactly

