"""One-submit production Vulkan Engine2D integration evidence."""

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.nogc_sync_mut.gpu.engine2d.sffi_vulkan.{
    vulkan_sffi_accepted_compute_submit_count}

fn expected_frame() -> [u32]:
    var pixels = [0xFF0000FFu32; 16 * 16]
    var y = 2
    while y < 8:
        var x = 2
        while x < 8:
            pixels[y * 16 + x] = 0xFFFF0000u32
            x = x + 1
        y = y + 1
    pixels

describe "Vulkan Engine2D live primitive batching":
    it "records three dispatches and accepts one submit at readback":
        val result = Engine2D.create_with_backend_strict(16, 16, "vulkan")
        if result.is_ok():
            var engine = result.unwrap()
            val before = vulkan_sffi_accepted_compute_submit_count()
            engine.clear(0xFF0000FFu32)
            engine.draw_rect_filled(2, 2, 6, 6, 0xFFFF0000u32)
            engine.draw_rect_filled(2, 2, 6, 6, 0xFFFF0000u32)
            expect(
                vulkan_sffi_accepted_compute_submit_count() - before
            ).to_equal(0)

            val readback = engine.read_pixels_with_source()
            expect(
                vulkan_sffi_accepted_compute_submit_count() - before
            ).to_equal(1)
            expect(readback.pixels).to_equal(expected_frame())
            expect(readback.source).to_equal("device_readback")
            engine.shutdown()
        else:
            val probe = result.unwrap_err()
            expect(probe.fallback_reason).to_not_equal("")
