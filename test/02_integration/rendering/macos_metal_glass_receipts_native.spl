# Strict native macOS evidence entry. Absence of Metal is failure, never a skip.
# @req REQ-HOST-GPU-LANE-001
# See wm_metal_glass_multi_receipt_opacity_2026-07-27.md for admission requirements.
use common.ui.draw_ir.{DrawIrCommand, DrawIrComposition, draw_ir_batch,
    draw_ir_box_with_style, draw_ir_composition, draw_ir_embedding_config,
    draw_ir_no_rect, draw_ir_style_prop}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{engine2d_draw_ir_adv_composition}

fn glass_command(material_id: text, y: i32, color: u32, color_text: text, alpha: text) -> DrawIrCommand:
    draw_ir_box_with_style(
        material_id, 0, y, 4, 2, color,
        draw_ir_no_rect(), draw_ir_no_rect(), draw_ir_no_rect(), draw_ir_no_rect(),
        [draw_ir_style_prop("wm-material-request", "window-surface-glass"),
         draw_ir_style_prop("wm-material-surface-alpha-milli", alpha),
         draw_ir_style_prop("background-color", color_text),
         draw_ir_style_prop("background-image", "none"),
         draw_ir_style_prop("border-radius", "0"),
         draw_ir_style_prop("backdrop-filter", "blur(0px) saturate(100%)"),
         draw_ir_style_prop("backdrop-filter-realized-blur-radius-px", "0"),
         draw_ir_style_prop("backdrop-filter-realized-saturation-milli", "1000"),
         draw_ir_style_prop("backdrop-filter-capability", "engine2d-composited-glass-material-v1")])

fn glass_composition(opacity: i32, alpha: text) -> DrawIrComposition:
    val body = glass_command("body-glass", 0, 0xFFFFFFFFu32, "4294967295", alpha)
    val title = glass_command("title-glass", 2, 0xFF000000u32, "4278190080", alpha)
    val batch = draw_ir_batch("metal-window", "metal",
        draw_ir_embedding_config("metal-surface", "window", 0, 0, 4, 4, 1, opacity, true),
        [body, title])
    draw_ir_composition("metal-frame", "scene", "metal", [batch])

fn main() -> i64:
    var engine = Engine2D.create_with_backend_fast(4, 4, "metal")
    if engine.backend_name() != "metal":
        print "metal_glass_status=FAIL reason=native-metal-unavailable"
        engine.shutdown()
        return 1
    engine.clear(0xFF204060u32)
    val active = engine2d_draw_ir_adv_composition(engine, glass_composition(1000, "1000"), true)
    val readback = engine.read_pixels_with_source()
    var ok = active.selected_backend == "metal" and not active.fallback_required
    ok = ok and active.rendered_command_count == 2 and active.skipped_command_count == 0
    ok = ok and active.metal_device_glass_requested_count == 2
    ok = ok and active.metal_device_glass_material_count == 2
    ok = ok and active.metal_device_glass_unfulfilled_count == 0
    ok = ok and active.metal_device_glass_receipts.len() == 2
    ok = ok and active.readback_source == "device_readback"
    ok = ok and active.backend_handle > 0 and active.device_identity > 0
    ok = ok and readback.source == "device_readback"
    ok = ok and readback.backend_handle == active.backend_handle
    ok = ok and readback.device_identity == active.device_identity
    ok = ok and readback.checksum == active.readback_checksum
    ok = ok and readback.pixels.len() == 16 and active.pixels.len() == 16
    if readback.pixels.len() == 16 and active.pixels.len() == 16:
        for i in 0..16:
            val expected = if i < 8: 0xFFFFFFFFu32 else: 0xFF000000u32
            ok = ok and readback.pixels[i] == expected and active.pixels[i] == expected
    var index = 0
    for receipt in active.metal_device_glass_receipts:
        val expected_id = if index == 0: "body-glass" else: "title-glass"
        ok = ok and receipt.material_id == expected_id and receipt.fulfilled
        ok = ok and receipt.execution_target == "metal-device-glass-v1"
        ok = ok and receipt.backend_handle == active.backend_handle
        ok = ok and receipt.device_identity == active.device_identity
        ok = ok and receipt.readback_source == "device_readback"
        ok = ok and receipt.readback_checksum == readback.checksum
        print "metal_glass_active index={index} id={receipt.material_id} opacity=1000 alpha=1000 fulfilled={receipt.fulfilled} target={receipt.execution_target} handle={receipt.backend_handle} device={receipt.device_identity} source={receipt.readback_source} checksum={receipt.readback_checksum}"
        index = index + 1
    # The same framebuffer must remain unchanged when sub-opaque parent sampling
    # is rejected before either material reaches the Metal device.
    val inactive = engine2d_draw_ir_adv_composition(engine, glass_composition(930, "500"), true)
    val after = engine.read_pixels_with_source()
    ok = ok and inactive.fallback_required
    ok = ok and inactive.rendered_command_count == 0 and inactive.skipped_command_count == 2
    ok = ok and inactive.metal_device_glass_requested_count == 2
    ok = ok and inactive.metal_device_glass_material_count == 0
    ok = ok and inactive.metal_device_glass_unfulfilled_count == 2
    ok = ok and inactive.metal_device_glass_receipts.len() == 2
    ok = ok and after.source == "device_readback" and after.checksum == readback.checksum
    ok = ok and after.backend_handle == readback.backend_handle
    ok = ok and after.device_identity == readback.device_identity
    ok = ok and after.pixels.len() == 16
    if after.pixels.len() == 16 and readback.pixels.len() == 16:
        for i in 0..16:
            ok = ok and after.pixels[i] == readback.pixels[i]
    index = 0
    for receipt in inactive.metal_device_glass_receipts:
        val expected_id = if index == 0: "body-glass" else: "title-glass"
        ok = ok and receipt.material_id == expected_id and not receipt.fulfilled
        ok = ok and receipt.execution_target == "unavailable"
        ok = ok and receipt.backend_handle == 0 and receipt.device_identity == 0
        print "metal_glass_inactive index={index} id={receipt.material_id} opacity=930 alpha=500 fulfilled={receipt.fulfilled} target={receipt.execution_target} handle={receipt.backend_handle} device={receipt.device_identity}"
        index = index + 1
    engine.shutdown()
    if not ok:
        print "metal_glass_status=FAIL reason=receipt-or-pixel-mismatch"
        return 1
    print "metal_glass_status=PASS active_receipts=2 inactive_receipts=2 pixels=16"
    return 0
