"""
## Purpose and audience
Covers the shared backend-capture facade in
`src/lib/gc_async_mut/gpu/browser_engine/backend_screenshot_capture.spl` and
its consumer in `app.wm_compare.graphical_backend_equality`: browser-rendered
captures through the shared `BackendCapture` shape, Engine2D filled-rect
readback captures, feeding two captures into the graphical equality report,
and bounded performance evidence for repeated captures. Audience: rendering
and WM engineers building backend-equivalence evidence.

## Operator workflow
Run the single file with the seed runner and require every scenario green;
each failure names which capture or equality contract regressed.

## Compatibility and limitations
All captures run on the CPU/software Engine2D path, so no GPU device is
required on any host; GPU-backend capture parity is out of scope here and
covered by the four-backend capture matrix docs. Performance expectations
are deliberately bounded (`>= 0` style sentinels) so shared hosts cannot
flake the file.

## Verification guidance and troubleshooting
Re-run this file after any edit to the capture facade or the wm_compare
equality module. A `success=false` means the backend initialization path
changed; an `exact_match` regression means the two captures of the same
canonical scene diverged; an SDN-content failure means the report schema
changed shape.
"""

# Lifecycle: research doc/01_research/domain/engine2d_four_backend_capture.md ;
# plan doc/03_plan/agent_tasks/web_renderer_vulkan_4k_showcase_hardening.md ;
# architecture doc/04_architecture/engine2d_four_backend_capture.md ;
# design doc/05_design/engine2d_four_backend_capture.md

# @tag: rendering, backend, capture, graphical_equality

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.backend_screenshot_capture.{
    capture_with_backend,
    capture_engine2d_filled_rect,
    benchmark_engine2d_filled_rect_capture,
    backend_capture_perf_report_sdn}
use app.wm_compare.graphical_backend_equality.{
    graphical_capture,
    graphical_equality_compare,
    graphical_equality_report_sdn,
    render_case,
    surface_geometry}

fn _html() -> text:
    "<html><body><div class='widget-button'>Run</div></body></html>"

# @manual_section: graphical backend capture facade
describe "graphical backend capture facade":

    it "captures browser-rendered pixels through the shared BackendCapture shape":
        # @req REQ-GFXCAPTURE-001
        # @capture(gui_image): 32x24 software browser capture retained
        step("Capture a rendered HTML fixture through the shared capture facade")
        val capture = capture_with_backend(_html(), 32, 24, "software")
        expect(capture.success).to_equal(true)
        expect(capture.backend_name).to_equal("software")
        expect(capture.width).to_equal(32)  # oracle: authoritative backend-capture facade value for this fixture
        expect(capture.height).to_equal(24)  # oracle: authoritative backend-capture facade value for this fixture
        expect(capture.pixels.len()).to_equal(32 * 24)  # oracle: authoritative backend-capture facade value for this fixture
        expect(capture.pixel_checksum).to_be_greater_than(0)  # oracle: authoritative backend-capture facade value for this fixture
        expect(capture.unique_sampled_colors).to_be_greater_than(0)  # oracle: authoritative backend-capture facade value for this fixture
        expect(capture.elapsed_us).to_be_greater_than(-1)  # oracle: authoritative backend-capture facade value for this fixture

    it "captures Engine2D readback pixels for a canonical filled-rect case":
        # @req REQ-GFXCAPTURE-002
        # @capture(gui_image): 16x12 filled-rect readback retained
        step("Capture the canonical filled-rect scene through Engine2D readback")
        val capture = capture_engine2d_filled_rect(
            16,
            12,
            "cpu",
            0xFFFFFFFFu32,
            0xFF2563EBu32
        )
        expect(capture.success).to_equal(true)
        expect(capture.pixels.len()).to_equal(16 * 12)  # oracle: authoritative backend-capture facade value for this fixture
        expect(capture.pixel_checksum).to_be_greater_than(0)  # oracle: authoritative backend-capture facade value for this fixture
        expect(capture.non_background_pixels).to_be_greater_than(0)  # oracle: authoritative backend-capture facade value for this fixture
        expect(capture.non_background_pixels).to_be_less_than(16 * 12)  # oracle: authoritative backend-capture facade value for this fixture
        expect(capture.unique_sampled_colors).to_be_greater_than(1)  # oracle: authoritative backend-capture facade value for this fixture

    it "feeds shared captures into the wm_compare graphical equality report":
        # @req REQ-GFXCAPTURE-003
        # @capture(protocol_json): graphical equality SDN report retained
        step("Compare two captures of the same canonical scene in the equality report")
        val first = capture_engine2d_filled_rect(
            16,
            12,
            "cpu",
            0xFFFFFFFFu32,
            0xFF2563EBu32
        )
        val second = capture_engine2d_filled_rect(
            16,
            12,
            "cpu",
            0xFFFFFFFFu32,
            0xFF2563EBu32
        )
        val geometry = surface_geometry(16, 12, first.width, first.height, 1.0, "srgb")
        val scenario = render_case(
            "engine2d_filled_rect",
            16,
            12,
            "#ffffff",
            ["clear", "filled_rect"],
            "strict"
        )
        val expected = graphical_capture(
            "2d:" + first.backend_name,
            "render_target",
            first.pixels,
            geometry,
            first.success,
            first.error
        )
        val actual = graphical_capture(
            "2d:" + second.backend_name,
            "render_target",
            second.pixels,
            geometry,
            second.success,
            second.error
        )
        val report = graphical_equality_compare(scenario, expected, actual)
        expect(report.pixel_status).to_equal("exact_match")
        expect(report.accepted).to_equal(true)
        val sdn = graphical_equality_report_sdn(report)
        expect(sdn).to_contain("engine2d_filled_rect")
        expect(sdn).to_contain("expected_backend: \"2d:cpu\"")

    it "records bounded performance evidence for repeated Engine2D captures":
        # @req REQ-GFXCAPTURE-004
        # @capture(statistics): per-iteration capture timings retained
        step("Benchmark eight repeated filled-rect captures and emit the SDN perf report")
        val perf = benchmark_engine2d_filled_rect_capture(16, 12, "cpu", 8)
        expect(perf.success).to_equal(true)
        expect(perf.backend_name).to_equal("cpu")
        expect(perf.iterations).to_equal(8)  # oracle: authoritative backend-capture facade value for this fixture
        expect(perf.pixels_per_iteration).to_equal(16 * 12)  # oracle: authoritative backend-capture facade value for this fixture
        expect(perf.aggregate_checksum).to_be_greater_than(0)  # oracle: authoritative backend-capture facade value for this fixture
        expect(perf.total_us).to_be_greater_than(-1)  # oracle: authoritative backend-capture facade value for this fixture
        val sdn = backend_capture_perf_report_sdn(perf)
        expect(sdn).to_contain("backend_capture_perf_report")
        expect(sdn).to_contain("iterations: 8")
        expect(sdn).to_contain("pixels_per_iteration: 192")
