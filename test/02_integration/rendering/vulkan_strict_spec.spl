"""
## Purpose and audience
Purpose: This spec proves Vulkan strict smoke tests.
Audience: Maintainers of the Simple integration suite reviewing this behavior.
"""
# @req: REQ-VULKANSTRICT-001
"""Vulkan Strict Smoke Tests

@tag: rendering, engine2d, vulkan, strict, hardware
@cover src/lib/gc_async_mut/gpu/engine2d/backend_vulkan.spl 70%
@cover src/lib/gc_async_mut/gpu/engine2d/backend_vulkan_spirv.spl 80%
@cover src/lib/gc_async_mut/gpu/engine2d/engine.spl 20%

Strictly gates real hardware execution when Vulkan initializes: shader module
load, compute pipeline creation, kernel dispatch, device sync, and pixel
readback must all work before parity assertions run. Surfaces device
diagnostics via BackendProbeResult.

On non-Vulkan hosts, asserts the BackendProbeResult carries a typed
Failed status rather than silently succeeding.
On Vulkan hosts where initialization succeeds, runs the full clear ->
draw_rect_filled -> present -> readback pipeline against a CPU reference for a
16x16 framebuffer. This spec must not be read as proof that current SPIR-V
placeholder blobs provide Vulkan parity.

PROBE-THEN-CREATE TOCTOU (doc/08_tracking/bug/gpu_probe_then_create_toctou_2026-08-04.md)
Every example used to call probe_vulkan() and then branch its whole body on that
stored answer. Engine2D.probe_backend runs a create+init+shutdown and throws it
away; Engine2D.create_with_backend_strict is a SECOND, independent create with
nothing cached in between, so the probe answer was only a prediction. Nothing is
asserted from the probe any more: the probe is checked for SELF-consistency, a
probe/create divergence is DISCLOSED on a [toctou] line, and every other
assertion reads the CREATE and the READBACK.
"""

use std.spec.{describe, context, it, expect, step}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.backend_vulkan.{VulkanBackend}
use std.gc_async_mut.gpu.engine2d.color.{rgb}
use std.gc_async_mut.gpu.engine2d.backend_probe.{BackendProbeResult, BackendStatus}

# ============================================================================
# Helpers
# ============================================================================

fn status_is_terminal_failure(probe: BackendProbeResult) -> bool:
    """True when the probe status is Failed or Unavailable (not Initialized)."""
    probe.status == BackendStatus.Failed or probe.status == BackendStatus.Unavailable

fn color_blue_u32() -> u32:
    """ARGB packed blue: 0xFF0000FF"""
    0xFF0000FFu32

fn color_red_u32() -> u32:
    """ARGB packed red: 0xFFFF0000"""
    0xFFFF0000u32

fn expected_px() -> i64:
    """Pixel count of the 16x16 framebuffer every example renders."""
    (16 * 16).to_i64()

fn build_cpu_reference(w: i32, h: i32, bg: u32, fg: u32, rx: i32, ry: i32, rw: i32, rh: i32) -> [u32]:
    """Build a CPU reference framebuffer for parity comparison."""
    var buf = [bg; w * h]
    var py = ry
    while py < ry + rh:
        var px = rx
        while px < rx + rw:
            if px >= 0 and px < w and py >= 0 and py < h:
                buf[py * w + px] = fg
            px = px + 1
        py = py + 1
    buf

fn probe_vulkan() -> BackendProbeResult:
    """Probe the Vulkan backend availability without allocating a full engine."""
    Engine2D.probe_backend(16, 16, "vulkan")

# --- readback provenance: the teeth, asserted on every outcome -------------

fn _device_proven(source: text, handle: i64, identity: i64, pixel_count: i64, expected: i64) -> bool:
    """True only when a real device demonstrably produced this frame."""
    source == "device_readback" and handle > 0 and identity > 0 and
        pixel_count == expected

fn _source_is_device(source: text) -> bool:
    """True for the readback sources that claim device provenance."""
    source == "device_readback" or source == "host_cache_after_device_present" or
        source == "host_cache_after_device_copy" or
        source == "swapchain_present" or source == "framebuffer_surface"

fn _source_is_cpu(source: text) -> bool:
    """True for the readback sources served by the CPU/software lane."""
    source == "cpu_mirror" or source == "cpu_fallback"

fn _source_is_no_frame(source: text) -> bool:
    """True for the readback sources that produced no frame at all.

    Every one of these carries an EMPTY pixel array, so no frame-content
    assertion may run on them.
    """
    source == "completion_unknown" or source == "readback_failed" or
        source == "not_requested" or source == "device_identity_unknown" or
        source == "preflight_rejected"

fn _source_is_known(source: text) -> bool:
    """True when the readback source is inside the honest vocabulary."""
    _source_is_device(source) or _source_is_cpu(source) or _source_is_no_frame(source)

fn _assert_provenance_invariants(label: text, source: text, handle: i64, identity: i64, pixel_count: i64, expected: i64):
    """Fail closed on any readback that claims more provenance than it earned."""
    if not _source_is_known(source):
        print "[probe-provenance] {label}: UNKNOWN READBACK SOURCE '{source}' — outside the honest vocabulary, failing closed"
    expect(_source_is_known(source)).to_equal(true)
    # Every call site here is a SUCCESSFUL strict vulkan create (or a successful
    # direct VulkanBackend.init), so the vulkan backend owns its own create. A
    # vulkan backend that degrades sets the STICKY cpu_fallback_used flag with a
    # recorded reason (backend_vulkan.spl mark_cpu_fallback) and reports
    # "cpu_fallback" — which stays a disclosed skip, because that is genuine
    # device loss. Reporting "cpu_mirror" instead is a silent CPU
    # reclassification, a bookkeeping defect rather than device loss, so it stays
    # a hard failure.
    if source == "cpu_mirror":
        print "[probe-provenance] {label}: SILENT CPU RECLASSIFICATION — a live vulkan backend reported source=cpu_mirror instead of cpu_fallback; failing closed"
    expect(source == "cpu_mirror").to_equal(false)
    if source == "device_readback":
        expect(handle).to_be_greater_than(0)
        expect(identity).to_be_greater_than(0)
        expect(pixel_count).to_equal(expected)
    if _source_is_cpu(source):
        expect(_source_is_device(source)).to_equal(false)
        expect(_device_proven(source, handle, identity, pixel_count, expected)).to_equal(false)

fn _report_outcome(label: text, source: text, handle: i64, identity: i64, pixel_count: i64, expected: i64) -> bool:
    """Disclose whether this example proved the GPU path, and return that fact."""
    if _device_proven(source, handle, identity, pixel_count, expected):
        print "[probe-gpu] {label}: GPU-PROVEN — a device produced this frame (source={source} handle={handle} identity={identity} pixels={pixel_count})"
        return true
    if _source_is_device(source):
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — device-sourced but not device-PROVEN (source={source} handle={handle} identity={identity} pixels={pixel_count}); this example proves NOTHING about the GPU path"
    else if source == "cpu_fallback":
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — the device was unavailable at use time (source=cpu_fallback); the probe's prediction did not survive to the create. This example proves NOTHING about the GPU path"
    else if source == "cpu_mirror":
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — CPU/software lane (source=cpu_mirror); this example proves NOTHING about the GPU path"
    else:
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — no frame produced (source={source}); this example proves NOTHING about the GPU path"
    false

# A strict create that fails must fail STRUCTURALLY: typed terminal status, the
# requested name preserved, a stated reason, and never a silent cpu/software
# substitute under the vulkan name. Holds on every host, so it is unconditional
# on the failure path instead of gated on what the probe predicted.
fn _assert_strict_failure_is_structured(label: text, failure: BackendProbeResult):
    """Assert the invariants a failed STRICT vulkan create still owes."""
    expect(failure.selected_name == "cpu" or failure.selected_name == "software").to_equal(false)
    expect(failure.requested_name).to_equal("vulkan")
    expect(status_is_terminal_failure(failure)).to_equal(true)
    expect(failure.fallback_reason).to_not_equal("")
    print "[probe-gpu] {label}: GPU BRANCH SKIPPED — the strict vulkan create failed at use time (selected={failure.selected_name}); this example proves NOTHING about the GPU path"

fn _frame_assertions_skipped(label: text, source: text):
    """Disclose that no frame existed to assert rendering correctness against."""
    print "[probe-gpu] {label}: FRAME ASSERTIONS SKIPPED — no frame was produced (source={source}); this example proves NOTHING about rendering correctness"

fn _disclose_toctou(label: text, probe_ready: bool, created: bool):
    """Disclose a probe/create divergence — a host condition, never asserted."""
    if probe_ready != created:
        print "[toctou] {label}: probe predicted ready={probe_ready} but the independent create returned ok={created} — the prediction did not survive the gap; asserting on the CREATE, not the probe"

# ============================================================================
# Tests
# ============================================================================

describe "Vulkan strict smoke tests":

    context "probe_vulkan device diagnostics":

        it "probe_vulkan returns a typed BackendProbeResult":
            # @req: REQ-VULKANSTRICT-001
            step("probe_vulkan returns a typed BackendProbeResult")
            val probe = probe_vulkan()
            val ok = probe.is_ok() or status_is_terminal_failure(probe)
            expect(ok).to_equal(true)

        it "probe_vulkan reports requested_name as vulkan":
            step("probe_vulkan reports requested_name as vulkan")
            val probe = probe_vulkan()
            expect(probe.requested_name).to_equal("vulkan")

        it "probe_vulkan on success reports api_name as vulkan":
            step("probe_vulkan on success reports api_name as vulkan")
            # Probe SELF-consistency: the probe's own fields must agree with each
            # other. This is a claim about the probe object, not a prediction
            # about any later create, so it stays a hard assertion.
            val probe = probe_vulkan()
            if probe.is_ok():
                expect(probe.api_name).to_equal("vulkan")
                expect(probe.available).to_equal(true)
            else:
                expect(probe.available).to_equal(false)

        it "probe_vulkan on failure carries non-empty fallback_reason":
            step("probe_vulkan on failure carries non-empty fallback_reason")
            val probe = probe_vulkan()
            if not probe.is_ok():
                expect(status_is_terminal_failure(probe)).to_equal(true)
                expect(probe.fallback_reason).to_not_equal("")

        it "probe_vulkan diagnostic_text is non-empty":
            step("probe_vulkan diagnostic_text is non-empty")
            val probe = probe_vulkan()
            val txt = probe.diagnostic_text()
            expect(txt.len()).to_be_greater_than(0)

    context "create_with_backend_strict vulkan strictness":

        it "never hands back a non-vulkan engine":
            step("never hands back a non-vulkan engine")
            # The create is attempted REGARDLESS of any probe. Both outcomes owe
            # a strictness claim, so neither branch is a silent skip.
            val result = Engine2D.create_with_backend_strict(16, 16, "vulkan")
            if result.is_ok():
                var engine = result.unwrap()
                expect(engine.backend_name()).to_equal("vulkan")
                engine.shutdown()
            else:
                _assert_strict_failure_is_structured("vulkan-strictness", result.unwrap_err())

        it "a failed strict create carries a terminal status and the requested name":
            step("a failed strict create carries a terminal status and the requested name")
            val result = Engine2D.create_with_backend_strict(16, 16, "vulkan")
            if not result.is_ok():
                val diag = result.unwrap_err()
                expect(status_is_terminal_failure(diag)).to_equal(true)
                expect(diag.requested_name).to_equal("vulkan")
            else:
                print "[probe-gpu] vulkan-typed-error: GPU BRANCH SKIPPED — the strict create succeeded, so the failure path was not exercised; this example proves NOTHING about the failure path"

        it "a failed strict create carries a non-empty fallback_reason":
            step("a failed strict create carries a non-empty fallback_reason")
            val result = Engine2D.create_with_backend_strict(16, 16, "vulkan")
            if not result.is_ok():
                val diag = result.unwrap_err()
                expect(diag.fallback_reason).to_not_equal("")
            else:
                print "[probe-gpu] vulkan-fallback-reason: GPU BRANCH SKIPPED — the strict create succeeded, so the failure path was not exercised; this example proves NOTHING about the failure path"

    context "create_with_backend_strict vulkan hardware path":

        it "returns a 16x16 vulkan engine with loaded SPIR-V modules, or a structured failure":
            step("returns a 16x16 vulkan engine with loaded SPIR-V modules, or a structure")
            # This is the one example that measures the probe/create gap: the
            # probe answer is DISCLOSED, never asserted. A successful create
            # implies every spirv_* blob was accepted by the driver.
            val probe = probe_vulkan()
            val probe_ready = probe.is_ok()
            val result = Engine2D.create_with_backend_strict(16, 16, "vulkan")
            val created = result.is_ok()
            _disclose_toctou("vulkan-hardware", probe_ready, created)
            if created:
                var engine = result.unwrap()
                expect(engine.backend_name()).to_equal("vulkan")
                expect(engine.width()).to_equal(16)
                expect(engine.height()).to_equal(16)
                engine.shutdown()
            else:
                _assert_strict_failure_is_structured("vulkan-hardware", result.unwrap_err())

    context "clear pixel parity with CPU reference":

        it "clear fills entire framebuffer with the given color":
            step("clear fills entire framebuffer with the given color")
            val result = Engine2D.create_with_backend_strict(16, 16, "vulkan")
            if result.is_ok():
                var engine = result.unwrap()
                val fill_color = color_blue_u32()
                engine.clear(fill_color)
                val drawn = engine.read_pixels_with_source()
                _assert_provenance_invariants("vulkan-clear-fill", drawn.source,
                    drawn.backend_handle, drawn.device_identity, drawn.pixel_count, expected_px())
                _report_outcome("vulkan-clear-fill", drawn.source, drawn.backend_handle,
                    drawn.device_identity, drawn.pixel_count, expected_px())
                if _source_is_no_frame(drawn.source):
                    _frame_assertions_skipped("vulkan-clear-fill", drawn.source)
                else:
                    engine.present()
                    val pixels = engine.read_pixels()
                    # Holds on whatever backend actually served the frame, so it
                    # is asserted on every source that produced one, not only on
                    # the GPU branch.
                    expect(pixels[0]).to_equal(fill_color)
                    expect(pixels[127]).to_equal(fill_color)
                    expect(pixels[255]).to_equal(fill_color)
                engine.shutdown()
            else:
                _assert_strict_failure_is_structured("vulkan-clear-fill", result.unwrap_err())

        it "clear matches CPU reference pixel-for-pixel":
            step("clear matches CPU reference pixel-for-pixel")
            val result = Engine2D.create_with_backend_strict(16, 16, "vulkan")
            if result.is_ok():
                var engine = result.unwrap()
                val fill_color = color_blue_u32()
                engine.clear(fill_color)
                val drawn = engine.read_pixels_with_source()
                _assert_provenance_invariants("vulkan-clear-parity", drawn.source,
                    drawn.backend_handle, drawn.device_identity, drawn.pixel_count, expected_px())
                _report_outcome("vulkan-clear-parity", drawn.source, drawn.backend_handle,
                    drawn.device_identity, drawn.pixel_count, expected_px())
                if _source_is_no_frame(drawn.source):
                    _frame_assertions_skipped("vulkan-clear-parity", drawn.source)
                else:
                    engine.present()
                    val pixels = engine.read_pixels()
                    var mismatch_count = 0
                    var ci = 0
                    while ci < 256:
                        if pixels[ci] != fill_color:
                            mismatch_count = mismatch_count + 1
                        ci = ci + 1
                    expect(mismatch_count).to_equal(0)
                engine.shutdown()
            else:
                _assert_strict_failure_is_structured("vulkan-clear-parity", result.unwrap_err())

    context "draw_rect_filled pixel parity with CPU reference":

        it "checked clear and rect return exact device-backed readback before present":
            step("checked clear and rect return exact device-backed readback before presen")
            # init() is attempted regardless of any probe; the readback decides
            # what may be claimed.
            var backend = VulkanBackend.create()
            val initialized = backend.init(16, 16)
            if initialized:
                val bg = color_blue_u32()
                val fg = color_red_u32()
                backend.clear(bg)
                backend.draw_rect_filled(2, 2, 6, 6, fg)
                val readback = backend.read_pixels_with_source()
                _assert_provenance_invariants("vulkan-direct-readback", readback.source,
                    readback.backend_handle, readback.device_identity, readback.pixel_count, expected_px())
                _report_outcome("vulkan-direct-readback", readback.source, readback.backend_handle,
                    readback.device_identity, readback.pixel_count, expected_px())
                if _source_is_no_frame(readback.source):
                    _frame_assertions_skipped("vulkan-direct-readback", readback.source)
                else:
                    val cpu_ref = build_cpu_reference(16, 16, bg, fg, 2, 2, 6, 6)
                    var mismatch_count = 0
                    expect(readback.pixels.len()).to_equal(256)
                    if readback.pixels.len() == 256:
                        var ci = 0
                        while ci < 256:
                            if readback.pixels[ci] != cpu_ref[ci]:
                                mismatch_count = mismatch_count + 1
                            ci = ci + 1
                    expect(mismatch_count).to_equal(0)
                # Backend self-consistency: a device-sourced frame may not also
                # claim a CPU fallback or an unknown completion.
                if readback.source == "device_readback":
                    expect(backend.cpu_fallback_used).to_equal(false)
                    expect(backend.completion_unknown).to_equal(false)
                backend.shutdown()
            else:
                print "[probe-gpu] vulkan-direct-readback: GPU BRANCH SKIPPED — VulkanBackend.init returned false; this example proves NOTHING about the GPU path"

        it "draw_rect_filled writes correct pixels in the rect region":
            step("draw_rect_filled writes correct pixels in the rect region")
            val result = Engine2D.create_with_backend_strict(16, 16, "vulkan")
            if result.is_ok():
                var engine = result.unwrap()
                val bg = color_blue_u32()
                val fg = color_red_u32()
                # Clear to blue, draw 4x4 red rect at (4,4)
                engine.clear(bg)
                engine.draw_rect_filled(4, 4, 4, 4, fg)
                val drawn = engine.read_pixels_with_source()
                _assert_provenance_invariants("vulkan-rect-region", drawn.source,
                    drawn.backend_handle, drawn.device_identity, drawn.pixel_count, expected_px())
                _report_outcome("vulkan-rect-region", drawn.source, drawn.backend_handle,
                    drawn.device_identity, drawn.pixel_count, expected_px())
                if _source_is_no_frame(drawn.source):
                    _frame_assertions_skipped("vulkan-rect-region", drawn.source)
                else:
                    engine.present()
                    val pixels = engine.read_pixels()
                    # Pixel at (6,6) must be inside the rect (red)
                    expect(pixels[6 * 16 + 6]).to_equal(fg)
                    # Pixel at (0,0) must be outside rect (blue)
                    expect(pixels[0]).to_equal(bg)
                engine.shutdown()
            else:
                _assert_strict_failure_is_structured("vulkan-rect-region", result.unwrap_err())

        it "clear then draw_rect_filled matches CPU reference pixel-for-pixel":
            step("clear then draw_rect_filled matches CPU reference pixel-for-pixel")
            val result = Engine2D.create_with_backend_strict(16, 16, "vulkan")
            if result.is_ok():
                var engine = result.unwrap()
                val bg = color_blue_u32()
                val fg = color_red_u32()
                engine.clear(bg)
                engine.draw_rect_filled(2, 2, 6, 6, fg)
                val drawn = engine.read_pixels_with_source()
                _assert_provenance_invariants("vulkan-rect-parity", drawn.source,
                    drawn.backend_handle, drawn.device_identity, drawn.pixel_count, expected_px())
                _report_outcome("vulkan-rect-parity", drawn.source, drawn.backend_handle,
                    drawn.device_identity, drawn.pixel_count, expected_px())
                if _source_is_no_frame(drawn.source):
                    _frame_assertions_skipped("vulkan-rect-parity", drawn.source)
                else:
                    engine.present()
                    val pixels = engine.read_pixels()
                    # Build CPU reference
                    val cpu_ref = build_cpu_reference(16, 16, bg, fg, 2, 2, 6, 6)
                    var mismatch_count = 0
                    var ci = 0
                    while ci < 256:
                        if pixels[ci] != cpu_ref[ci]:
                            mismatch_count = mismatch_count + 1
                        ci = ci + 1
                    expect(mismatch_count).to_equal(0)
                engine.shutdown()
            else:
                _assert_strict_failure_is_structured("vulkan-rect-parity", result.unwrap_err())

        it "rect outside framebuffer bounds does not corrupt surrounding pixels":
            step("rect outside framebuffer bounds does not corrupt surrounding pixels")
            val result = Engine2D.create_with_backend_strict(16, 16, "vulkan")
            if result.is_ok():
                var engine = result.unwrap()
                val bg = color_blue_u32()
                val fg = color_red_u32()
                engine.clear(bg)
                # Draw rect that starts at (14,14) with size (8,8) — mostly out of bounds
                engine.draw_rect_filled(14, 14, 8, 8, fg)
                val drawn = engine.read_pixels_with_source()
                _assert_provenance_invariants("vulkan-rect-bounds", drawn.source,
                    drawn.backend_handle, drawn.device_identity, drawn.pixel_count, expected_px())
                _report_outcome("vulkan-rect-bounds", drawn.source, drawn.backend_handle,
                    drawn.device_identity, drawn.pixel_count, expected_px())
                if _source_is_no_frame(drawn.source):
                    _frame_assertions_skipped("vulkan-rect-bounds", drawn.source)
                else:
                    engine.present()
                    val pixels = engine.read_pixels()
                    # Pixel at (0,0) must still be blue
                    expect(pixels[0]).to_equal(bg)
                engine.shutdown()
            else:
                _assert_strict_failure_is_structured("vulkan-rect-bounds", result.unwrap_err())

    context "sync and readback correctness":

        it "read_pixels after present reflects latest draw":
            step("read_pixels after present reflects latest draw")
            val result = Engine2D.create_with_backend_strict(16, 16, "vulkan")
            if result.is_ok():
                var engine = result.unwrap()
                val first_color = color_blue_u32()
                val second_color = color_red_u32()
                engine.clear(first_color)
                val drawn = engine.read_pixels_with_source()
                _assert_provenance_invariants("vulkan-readback-latest", drawn.source,
                    drawn.backend_handle, drawn.device_identity, drawn.pixel_count, expected_px())
                _report_outcome("vulkan-readback-latest", drawn.source, drawn.backend_handle,
                    drawn.device_identity, drawn.pixel_count, expected_px())
                if _source_is_no_frame(drawn.source):
                    _frame_assertions_skipped("vulkan-readback-latest", drawn.source)
                else:
                    engine.present()
                    val pixels_first = engine.read_pixels()
                    expect(pixels_first[0]).to_equal(first_color)
                    engine.clear(second_color)
                    engine.present()
                    val pixels_second = engine.read_pixels()
                    expect(pixels_second[0]).to_equal(second_color)
                engine.shutdown()
            else:
                _assert_strict_failure_is_structured("vulkan-readback-latest", result.unwrap_err())

        it "present idempotent — second present same content":
            step("present idempotent — second present same content")
            val result = Engine2D.create_with_backend_strict(16, 16, "vulkan")
            if result.is_ok():
                var engine = result.unwrap()
                val fill_color = color_red_u32()
                engine.clear(fill_color)
                val drawn = engine.read_pixels_with_source()
                _assert_provenance_invariants("vulkan-present-idempotent", drawn.source,
                    drawn.backend_handle, drawn.device_identity, drawn.pixel_count, expected_px())
                _report_outcome("vulkan-present-idempotent", drawn.source, drawn.backend_handle,
                    drawn.device_identity, drawn.pixel_count, expected_px())
                if _source_is_no_frame(drawn.source):
                    _frame_assertions_skipped("vulkan-present-idempotent", drawn.source)
                else:
                    engine.present()
                    val p1 = engine.read_pixels()
                    engine.present()
                    val p2 = engine.read_pixels()
                    expect(p1[0]).to_equal(p2[0])
                    expect(p1[255]).to_equal(p2[255])
                engine.shutdown()
            else:
                _assert_strict_failure_is_structured("vulkan-present-idempotent", result.unwrap_err())

            print "[probe-gpu] RUN VERDICT: this run's GPU evidence is exactly the set of '[probe-gpu] <label>: GPU-PROVEN' lines above."
            print "[probe-gpu] RUN VERDICT: every '[probe-gpu] <label>: GPU BRANCH SKIPPED' line marks an example that proves NOTHING about the GPU path."
            print "[probe-gpu] RUN VERDICT: a PASS with no GPU-PROVEN line does NOT attest any Vulkan device — read it as 'device unavailable', not as 'Vulkan works'."
