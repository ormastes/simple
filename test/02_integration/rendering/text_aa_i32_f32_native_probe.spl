"""Native regression probe for antialiased text sampling conversions."""

use std.gpu.engine2d.helpers_text.{text_aa_blit_buffer}

fn payload_is_valid(font_size: i32) -> bool:
    val payload = text_aa_blit_buffer(
        "A", 0xFFFFFFFFu32, 0xFF101820u32, font_size)
    if payload.width <= 0 or payload.height <= 0:
        return false
    if payload.pixels.len() != payload.width * payload.height:
        return false
    payload.pixels.len() > 0

fn main() -> i64:
    if not payload_is_valid(1):
        print "text_aa_i32_f32_native_status=fail font_size=1"
        return 1
    if not payload_is_valid(3):
        print "text_aa_i32_f32_native_status=fail font_size=3"
        return 1
    print "text_aa_i32_f32_native_status=pass"
    0
