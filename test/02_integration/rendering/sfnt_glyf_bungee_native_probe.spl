use std.common.encoding.sfnt_glyf.{SFNT_GLYPH_SELECTOR_CODEPOINT, SFNT_GLYPH_SELECTOR_INDEX, sfnt_glyf_void_transport_probe, sfnt_measure_glyph_into, sfnt_render_glyph_into}
use std.nogc_sync_mut.sffi.io.{file_read_bytes}

val BUNGEE_PATH = "assets/fonts/google-fonts/ofl/bungee/Bungee-Regular.ttf"

fn _undersized_meta_cookies_clear(blob: [u8], length: i64) -> bool:
    var meta: [i64] = [0; length]
    if length > 7:
        meta[7] = 310031
    if length > 8:
        meta[8] = 310032
    if length > 9:
        meta[9] = 1
    sfnt_measure_glyph_into(blob, SFNT_GLYPH_SELECTOR_CODEPOINT, 66, 100, meta)
    if length > 7 and meta[7] != 0: return false
    if length > 8 and meta[8] != 0: return false
    if length > 9 and meta[9] != 0: return false
    true

fn main() -> i64:
    val blob = file_read_bytes(BUNGEE_PATH)
    var canary_meta: [i64] = [0; 6]
    var canary_pixels: [u8] = [0u8; 4]
    sfnt_glyf_void_transport_probe(canary_meta, canary_pixels)
    if canary_meta[0] != 20260727 or canary_meta[5] != 909090 or canary_pixels[3] != 68u8:
        print("sfnt_glyf_bungee_native_status=fail-transport")
        return 10
    var stale_meta: [i64] = [0; 20]
    stale_meta[7] = 310031
    stale_meta[8] = 310032
    stale_meta[9] = 1
    sfnt_measure_glyph_into(blob, SFNT_GLYPH_SELECTOR_CODEPOINT, -1, 100, stale_meta)
    if stale_meta[7] != 0 or stale_meta[8] != 0 or stale_meta[9] != 0:
        print("sfnt_glyf_bungee_native_status=fail-stale-measure")
        return 11
    if (not _undersized_meta_cookies_clear(blob, 8) or
        not _undersized_meta_cookies_clear(blob, 9) or
        not _undersized_meta_cookies_clear(blob, 10) or
        not _undersized_meta_cookies_clear(blob, 19)):
        print("sfnt_glyf_bungee_native_status=fail-undersized-stale-measure")
        return 15
    var meta: [i64] = [0; 20]
    sfnt_measure_glyph_into(blob, SFNT_GLYPH_SELECTOR_CODEPOINT, 66, 100, meta)
    if meta[7] != 310031:
        print("sfnt_glyf_bungee_native_status=fail-measure phase={meta[10]}")
        return 1
    if meta[0] != 62 or meta[1] != 72 or meta[17] <= 0:
        print("sfnt_glyf_bungee_native_status=fail-dimensions")
        return 2
    if meta[5] != 4464:
        print("sfnt_glyf_bungee_native_status=fail-pixel-count")
        return 3
    var pixels: [u8] = [0u8; meta[5]]
    meta[8] = 310032
    meta[9] = 1
    sfnt_render_glyph_into(blob, SFNT_GLYPH_SELECTOR_CODEPOINT, 66, 0, meta, pixels)
    if meta[8] != 0 or meta[9] != 0:
        print("sfnt_glyf_bungee_native_status=fail-stale-render")
        return 12
    sfnt_render_glyph_into(blob, SFNT_GLYPH_SELECTOR_CODEPOINT, 66, 100, meta, pixels)
    if meta[8] != 310032:
        print("sfnt_glyf_bungee_native_status=fail-render")
        return 4
    if meta[9] <= 0:
        print("sfnt_glyf_bungee_native_status=fail-alpha")
        return 5
    val glyph_index = meta[6]
    var index_meta: [i64] = [0; 20]
    sfnt_measure_glyph_into(blob, SFNT_GLYPH_SELECTOR_INDEX, glyph_index, 100, index_meta)
    var metric_index = 0
    while metric_index < 6:
        if index_meta[metric_index] != meta[metric_index]:
            print("sfnt_glyf_bungee_native_status=fail-index-metrics")
            return 18
        metric_index = metric_index + 1
    if index_meta[17] != meta[17]:
        print("sfnt_glyf_bungee_native_status=fail-index-ascent")
        return 24
    var index_pixels: [u8] = [0u8; index_meta[5]]
    sfnt_render_glyph_into(blob, SFNT_GLYPH_SELECTOR_INDEX, glyph_index, 100, index_meta, index_pixels)
    var pixels_match = index_pixels.len() == pixels.len()
    var pixel_index = 0
    while pixels_match and pixel_index < pixels.len():
        pixels_match = index_pixels[pixel_index] == pixels[pixel_index]
        pixel_index = pixel_index + 1
    if index_meta[8] != 310032 or index_meta[9] <= 0 or not pixels_match:
        print("sfnt_glyf_bungee_native_status=fail-index-render")
        return 19
    index_meta[8] = 310032
    index_meta[9] = 1
    sfnt_render_glyph_into(blob, SFNT_GLYPH_SELECTOR_CODEPOINT, glyph_index, 100, index_meta, index_pixels)
    if index_meta[8] != 0 or index_meta[9] != 0:
        print("sfnt_glyf_bungee_native_status=fail-selector-binding")
        return 20
    var invalid_index_meta: [i64] = [0; 20]
    sfnt_measure_glyph_into(blob, SFNT_GLYPH_SELECTOR_INDEX, 0, 100, invalid_index_meta)
    if invalid_index_meta[7] != 0:
        print("sfnt_glyf_bungee_native_status=fail-index-zero")
        return 21
    sfnt_measure_glyph_into(blob, SFNT_GLYPH_SELECTOR_INDEX, 4294967296, 100, invalid_index_meta)
    if invalid_index_meta[7] != 0:
        print("sfnt_glyf_bungee_native_status=fail-index-overflow")
        return 22
    var space_meta: [i64] = [0; 20]
    sfnt_measure_glyph_into(blob, SFNT_GLYPH_SELECTOR_CODEPOINT, 32, 100, space_meta)
    if space_meta[7] != 310031 or space_meta[0] != 0 or space_meta[1] != 0 or space_meta[5] != 0 or space_meta[2] <= 0:
        print("sfnt_glyf_bungee_native_status=fail-space-measure")
        return 13
    var space_pixels: [u8] = []
    sfnt_render_glyph_into(blob, SFNT_GLYPH_SELECTOR_CODEPOINT, 32, 100, space_meta, space_pixels)
    if space_meta[8] != 310032 or space_meta[9] != 0:
        print("sfnt_glyf_bungee_native_status=fail-space-render")
        return 14
    var combining_meta: [i64] = [0; 20]
    sfnt_measure_glyph_into(blob, SFNT_GLYPH_SELECTOR_CODEPOINT, 768, 100, combining_meta)
    if combining_meta[7] != 310031:
        print("sfnt_glyf_bungee_native_status=fail-combining-measure")
        return 15
    if combining_meta[0] != 42 or combining_meta[1] != 22:
        print("sfnt_glyf_bungee_native_status=fail-combining-dimensions")
        return 16
    if combining_meta[2] != 0:
        print("sfnt_glyf_bungee_native_status=fail-combining-advance")
        return 17
    var combining_index_meta: [i64] = [0; 20]
    sfnt_measure_glyph_into(blob, SFNT_GLYPH_SELECTOR_INDEX, combining_meta[6], 100, combining_index_meta)
    if combining_index_meta[7] != 310031 or combining_index_meta[2] != 0:
        print("sfnt_glyf_bungee_native_status=fail-combining-index-advance")
        return 23
    print("sfnt_glyf_bungee_native_status=pass width=62 height=72 pixels=4464")
    0
