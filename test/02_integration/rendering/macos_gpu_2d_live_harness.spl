        "gpu_2d_live_audio_pcm_checksum={audio_pcm_checksum}\n" +
        "gpu_2d_live_audio_playback_handle={audio_playback_handle}\n" +
        "gpu_2d_live_audio_submit_count=1\n" +
        "gpu_2d_live_audio_completion_count={if audio_completion_observed: 1 else: 0}\n" +
