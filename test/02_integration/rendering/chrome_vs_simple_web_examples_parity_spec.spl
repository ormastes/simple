"""
# Chrome + Skia GPU vs Simple Web (Vulkan/MoltenVK) Examples & Aqua Parity Spec

Establishes the Vulkan + Chrome Skia GPU base configuration first, then renders
example pages and an Aqua CSS-themed Simple GUI + Simple Browser page at
800x600 via `simple_web_layout_render_html_readback(..., "vulkan")` and
compares them against GPU-rasterized headless Chrome via `compare_view_inspect`.
"""

use std.spec.{describe, it, expect}
use std.io_runtime.{
    cwd, dir_create_all, dir_remove_all, env_get, file_delete, file_exists,
    file_read, file_read_bytes_result, file_write, getpid, host_os, process_run
}
use std.common.image.png_decode.{PngImage, decode_png_to_argb}
use std.common.ui.wm_chrome_theme.{
    wm_chrome_theme_defaults, wm_chrome_colors_css_override
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_engine2d_presenter.{
    simple_web_layout_render_html_readback
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_element_geometry_lines
}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_resolved_engine2d_backend_name_with_reason
}
use std.nogc_sync_mut.ui.compare_view_host.{compare_view_find_browser, compare_view_inspect}

val VIEW_W: i32 = 800
val VIEW_H: i32 = 600
val EXPECTED_PIXEL_COUNT: i32 = 480000

struct FrameColorStats:
    distinct_count: i32
    non_bg_count: i32
    mean_luma: i32
    bg_pixel: u32

struct LayoutBox:
    key: text
    tag: text
    x: i32
    y: i32
    w: i32
    h: i32

fn _find_layout_box(lines: [text], key: text) -> LayoutBox:
    val prefix = "GEOM|" + key + "|"
    var i: i32 = 0
    while i < (lines.len() as i32):
        val line = lines[i]
        if line.starts_with(prefix):
            val parts = line.split("|")
            if parts.len() >= 7:
                return LayoutBox(
                    key: parts[1],
                    tag: parts[2],
                    x: parts[3].trim().to_i32(),
                    y: parts[4].trim().to_i32(),
                    w: parts[5].trim().to_i32(),
                    h: parts[6].trim().to_i32()
                )
        i = i + 1
    LayoutBox(key: key, tag: "", x: -1, y: -1, w: 0, h: 0)

fn _boxes_overlap(a: LayoutBox, b: LayoutBox) -> bool:
    if a.w <= 0 or a.h <= 0 or b.w <= 0 or b.h <= 0:
        return false
    a.x < b.x + b.w and a.x + a.w > b.x and a.y < b.y + b.h and a.y + a.h > b.y

fn _pixel_luma(c: u32) -> i32:
    val r = ((c >> 16) & 255u32) as i32
    val g = ((c >> 8) & 255u32) as i32
    val b = (c & 255u32) as i32
    (r * 77 + g * 150 + b * 29) >> 8

fn _max_channel_diff(a: u32, b: u32) -> i32:
    val ar = ((a >> 16) & 255u32) as i32
    val ag = ((a >> 8) & 255u32) as i32
    val ab = (a & 255u32) as i32
    val br = ((b >> 16) & 255u32) as i32
    val bg = ((b >> 8) & 255u32) as i32
    val bb = (b & 255u32) as i32
    val dr = if ar >= br: ar - br else: br - ar
    val dg = if ag >= bg: ag - bg else: bg - ag
    val db = if ab >= bb: ab - bb else: bb - ab
    var m = dr
    if dg > m:
        m = dg
    if db > m:
        m = db
    m

fn _compute_frame_stats(pixels: [u32], w: i32, h: i32) -> FrameColorStats:
    if (pixels.len() as i32) < w * h or w <= 0 or h <= 0:
        return FrameColorStats(distinct_count: 0, non_bg_count: 0, mean_luma: 0, bg_pixel: 0u32)
    # Sample bottom-right corner if top-left hits a header bar, else corner match.
    val tl = pixels[0]
    val br = pixels[w * h - 1]
    val bg = br
    var seen: [u32] = []
    var non_bg: i32 = 0
    var luma_sum: i64 = 0
    var sample_count: i64 = 0
    var y: i32 = 0
    while y < h:
        var x: i32 = 0
        val row_off = y * w
        while x < w:
            val px = pixels[row_off + x]
            luma_sum = luma_sum + _pixel_luma(px).to_i64()
            sample_count = sample_count + 1
            if _max_channel_diff(px, tl) > 6 or _max_channel_diff(px, bg) > 6:
                non_bg = non_bg + 1
            if (seen.len() as i32) < 64:
                var found = false
                var si: i32 = 0
                val sn = seen.len() as i32
                while si < sn:
                    if seen[si] == px:
                        found = true
                        break
                    si = si + 1
                if not found:
                    seen.push(px)
            x = x + 4
        y = y + 4
    val mean = if sample_count > 0: (luma_sum / sample_count).to_i32() else: 0
    FrameColorStats(
        distinct_count: seen.len() as i32,
        non_bg_count: non_bg,
        mean_luma: mean,
        bg_pixel: tl
    )

fn _active_block_grid(pixels: [u32], w: i32, h: i32, cols: i32, rows: i32) -> [bool]:
    var active: [bool] = [false; cols * rows]
    val cell_w = w / cols
    val cell_h = h / rows
    val ref_px = pixels[0]
    val bot_px = pixels[w * h - 1]
    var r: i32 = 0
    while r < rows:
        var c: i32 = 0
        while c < cols:
            var hit = false
            var dy: i32 = 2
            while dy < cell_h and not hit:
                val py = r * cell_h + dy
                val row_off = py * w
                var dx: i32 = 2
                while dx < cell_w:
                    val px = pixels[row_off + c * cell_w + dx]
                    if _max_channel_diff(px, ref_px) > 12 and _max_channel_diff(px, bot_px) > 12:
                        hit = true
                        break
                    dx = dx + 6
                dy = dy + 6
            active[r * cols + c] = hit
            c = c + 1
        r = r + 1
    active

fn _abs_i32(v: i32) -> i32:
    if v < 0: 0 - v else: v

fn _abs_path(rel_or_abs: text) -> text:
    if rel_or_abs.starts_with("/"):
        return rel_or_abs
    cwd() + "/" + rel_or_abs

fn _crop_chrome_800x600(img: PngImage) -> [u32]:
    if img.width == VIEW_W and img.height == VIEW_H and (img.pixels.len() as i32) >= EXPECTED_PIXEL_COUNT:
        return img.pixels
    if img.width == VIEW_W and img.height > VIEW_H and (img.pixels.len() as i32) >= VIEW_W * VIEW_H:
        var cropped: [u32] = [0u32; EXPECTED_PIXEL_COUNT]
        var idx: i32 = 0
        while idx < EXPECTED_PIXEL_COUNT:
            cropped[idx] = img.pixels[idx]
            idx = idx + 1
        return cropped
    if img.width == VIEW_W * 2 and img.height >= VIEW_H * 2 and (img.pixels.len() as i32) >= VIEW_W * 2 * VIEW_H * 2:
        var scaled: [u32] = [0u32; EXPECTED_PIXEL_COUNT]
        var y: i32 = 0
        while y < VIEW_H:
            val sy = y * 2 * img.width
            val dy = y * VIEW_W
            var x: i32 = 0
            while x < VIEW_W:
                scaled[dy + x] = img.pixels[sy + x * 2]
                x = x + 1
            y = y + 1
        return scaled
    []

fn _chrome_gpu_flags() -> [text]:
    val disable_gpu = (env_get("CHROME_CAPTURE_DISABLE_GPU") ?? "false").trim().lower() == "true"
    if disable_gpu:
        return ["--disable-gpu"]
    val os_name = host_os().trim().lower()
    if os_name == "macos" or os_name == "darwin":
        return [
            "--use-angle=metal",
            "--enable-gpu-rasterization",
            "--ignore-gpu-blocklist"
        ]
    [
        "--no-sandbox",
        "--disable-gpu-sandbox",
        "--disable-dev-shm-usage",
        "--enable-features=Vulkan,DefaultANGLEVulkan,VulkanFromANGLE",
        "--use-angle=vulkan",
        "--enable-gpu-rasterization",
        "--ignore-gpu-blocklist"
    ]

fn _capture_chrome_screenshot(browser_bin: text, page_name: text, html: text, source_file_path: text) -> [u32]:
    val pid = getpid()
    val tmp_dir = "/tmp/simple_chrome_parity_{pid}_{page_name}"
    val tmp_png = tmp_dir + "/shot.png"
    val tmp_profile = tmp_dir + "/profile"
    dir_create_all(tmp_profile)
    var target_html_path = ""
    var wrote_temp_html = false
    if source_file_path != "":
        target_html_path = _abs_path(source_file_path)
    else:
        target_html_path = tmp_dir + "/page.html"
        file_write(target_html_path, html)
        wrote_temp_html = true
    val url = "file://" + target_html_path
    var args: [text] = ["--headless=new"]
    for flag in _chrome_gpu_flags():
        args.push(flag)
    args.push("--hide-scrollbars")
    args.push("--force-device-scale-factor=1")
    args.push("--force-color-profile=srgb")
    args.push("--no-first-run")
    args.push("--no-default-browser-check")
    args.push("--user-data-dir=" + tmp_profile)
    args.push("--window-size=800,687")
    args.push("--screenshot=" + tmp_png)
    args.push(url)
    val (out, err, code) = process_run(browser_bin, args)
    var result: [u32] = []
    if code == 0 and file_exists(tmp_png):
        val bytes_res = file_read_bytes_result(tmp_png)
        match bytes_res:
            Ok(bytes):
                val decoded = decode_png_to_argb(bytes)
                match decoded:
                    Ok(img):
                        result = _crop_chrome_800x600(img)
                    Err(msg):
                        print "chrome decode failed for {page_name}: {msg}"
            Err(msg):
                print "chrome read failed for {page_name}: {msg}"
    elif code != 0:
        print "chrome screenshot failed for {page_name} (code={code}): {err}"
    if file_exists(tmp_png):
        file_delete(tmp_png)
    if wrote_temp_html and file_exists(target_html_path):
        file_delete(target_html_path)
    dir_remove_all(tmp_dir)
    result

fn _build_aqua_browser_chrome_html() -> text:
    val css_override = wm_chrome_colors_css_override(wm_chrome_theme_defaults())
    var html = "<!DOCTYPE html>\n"
    html = html + "<html><head><meta charset=\"utf-8\"><title>Simple GUI + Browser Aqua Chrome</title>\n"
    html = html + "<style>\n"
    html = html + "  * {{ box-sizing: border-box; }}\n"
    html = html + "  body {{ margin: 0; padding: 18px; background: var(--wm-bg); color: var(--wm-fg); font-family: sans-serif; }}\n"
    html = html + "  .aqua-window {{ background: var(--wm-surface); border: 1px solid #cbd5e1; border-radius: 12px; overflow: hidden; box-shadow: 0 12px 28px rgba(15, 23, 42, 0.22); }}\n"
    html = html + "  .aqua-titlebar {{ display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%); border-bottom: 1px solid #cbd5e1; }}\n"
    html = html + "  .traffic-lights {{ display: flex; gap: 8px; align-items: center; }}\n"
    html = html + "  .dot {{ width: 12px; height: 12px; border-radius: 6px; display: inline-block; }}\n"
    html = html + "  .dot.close {{ background: #ff5f57; }}\n"
    html = html + "  .dot.min {{ background: #febc2e; }}\n"
    html = html + "  .dot.max {{ background: #28c840; }}\n"
    html = html + "  .toolbar {{ display: flex; gap: 10px; align-items: center; padding: 10px 16px; background: #f1f5f9; border-bottom: 1px solid #cbd5e1; }}\n"
    html = html + "  .url-bar {{ flex: 1; background: #ffffff; border: 1px solid #94a3b8; border-radius: 8px; padding: 6px 10px; color: #0f172a; }}\n"
    html = html + "  .aqua-btn {{ background: var(--wm-accent); color: #ffffff; border: 1px solid #1d4ed8; border-radius: 8px; padding: 6px 14px; font-weight: bold; box-shadow: 0 2px 8px rgba(37, 99, 235, 0.35); }}\n"
    html = html + "  .workspace {{ padding: 16px; background: var(--wm-surface); }}\n"
    html = html + "  .aqua-card {{ background: #ffffff; border: 1px dashed #64748b; border-radius: 10px; padding: 14px; margin-bottom: 12px; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08); }}\n"
    html = html + "  .row {{ display: flex; gap: 12px; align-items: center; }}\n"
    html = html + "  blockquote {{ border-left: 4px solid #2563eb; background: #eff6ff; padding: 8px 12px; margin: 10px 0; }}\n"
    html = html + css_override + "\n"
    html = html + "</style></head><body>\n"
    html = html + "<div class=\"aqua-window\">\n"
    html = html + "  <div class=\"aqua-titlebar\">\n"
    html = html + "    <div class=\"traffic-lights\"><span class=\"dot close\"></span><span class=\"dot min\"></span><span class=\"dot max\"></span></div>\n"
    html = html + "    <strong>Simple GUI + Simple Browser (Aqua Chrome)</strong>\n"
    html = html + "    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><rect width=\"24\" height=\"24\" rx=\"5\" fill=\"#2563eb\"></rect></svg>\n"
    html = html + "  </div>\n"
    html = html + "  <div class=\"toolbar\">\n"
    html = html + "    <input class=\"url-bar\" type=\"text\" value=\"https://simple-lang.org/aqua-browser\">\n"
    html = html + "    <select><option>Aqua Profile</option><option>Default</option></select>\n"
    html = html + "    <button class=\"aqua-btn\">Go</button>\n"
    html = html + "  </div>\n"
    html = html + "  <div class=\"workspace\">\n"
    html = html + "    <div class=\"aqua-card\">\n"
    html = html + "      <h2>Rendered Surface Diagnostics</h2>\n"
    html = html + "      <p>Inspecting <mark>highlighted telemetry</mark>, <code>draw_ir</code> pipeline, and <kbd>Cmd+R</kbd> reload.</p>\n"
    html = html + "      <blockquote>Shared Aqua window chrome and browser content styling.</blockquote>\n"
    html = html + "    </div>\n"
    html = html + "  </div>\n"
    html = html + "</div>\n"
    html = html + "</body></html>\n"
    html

fn _verify_example_parity(page_name: text, html: text, source_file_path: text):
    val (resolved, reason) = simple_web_resolved_engine2d_backend_name_with_reason(VIEW_W, VIEW_H, "vulkan")
    val readback = simple_web_layout_render_html_readback(html, VIEW_W, VIEW_H, "vulkan")
    val simple_pixels = readback.pixels
    val gpu_backend_used = readback.source == "device_readback" and readback.backend_handle > 0 and readback.device_identity > 0
    print "[parity-base] page={page_name} requested=vulkan resolved={resolved} readback_source={readback.source} gpu_backend_used={gpu_backend_used} handle={readback.backend_handle} device={readback.device_identity} reason={reason}"
    expect(simple_pixels.len() as i32).to_equal(EXPECTED_PIXEL_COUNT)
    expect(readback.pixel_count).to_equal(EXPECTED_PIXEL_COUNT.to_i64())
    if resolved == "vulkan":
        expect(readback.source).to_equal("device_readback")
        expect(gpu_backend_used).to_equal(true)
    val s_stats = _compute_frame_stats(simple_pixels, VIEW_W, VIEW_H)
    expect(s_stats.distinct_count).to_be_greater_than(3)
    expect(s_stats.non_bg_count).to_be_greater_than(400)

    val browser_bin = compare_view_find_browser("")
    if browser_bin != "":
        val chrome_pixels = _capture_chrome_screenshot(browser_bin, page_name, html, source_file_path)
        expect(chrome_pixels.len() as i32).to_equal(EXPECTED_PIXEL_COUNT)
        if (chrome_pixels.len() as i32) == EXPECTED_PIXEL_COUNT:
            val cv_status = compare_view_inspect(
                "chrome_vs_simple_web_" + page_name,
                "simple_web_vulkan",
                simple_pixels,
                VIEW_W,
                VIEW_H,
                "chrome_skia_gpu",
                chrome_pixels,
                VIEW_W,
                VIEW_H
            )
            if (env_get("SIMPLE_COMPARE_VIEW") ?? "").trim().lower() == "html":
                expect(cv_status.starts_with("written:")).to_equal(true)
            val c_stats = _compute_frame_stats(chrome_pixels, VIEW_W, VIEW_H)
            expect(c_stats.distinct_count).to_be_greater_than(3)
            expect(c_stats.non_bg_count).to_be_greater_than(400)
            # Corner / outer page background color parity.
            val bg_diff = _max_channel_diff(simple_pixels[EXPECTED_PIXEL_COUNT - 1], chrome_pixels[EXPECTED_PIXEL_COUNT - 1])
            expect(bg_diff).to_be_less_than(48)
            # Mean brightness parity across viewport.
            expect(_abs_i32(s_stats.mean_luma - c_stats.mean_luma)).to_be_less_than(80)
            # Coarse 16x12 structural block activation parity.
            val s_blocks = _active_block_grid(simple_pixels, VIEW_W, VIEW_H, 16, 12)
            val c_blocks = _active_block_grid(chrome_pixels, VIEW_W, VIEW_H, 16, 12)
            var s_active: i32 = 0
            var c_active: i32 = 0
            var overlap: i32 = 0
            var bi: i32 = 0
            while bi < 192:
                if s_blocks[bi]:
                    s_active = s_active + 1
                if c_blocks[bi]:
                    c_active = c_active + 1
                if s_blocks[bi] and c_blocks[bi]:
                    overlap = overlap + 1
                bi = bi + 1
            expect(s_active).to_be_greater_than(3)
            expect(c_active).to_be_greater_than(3)
            expect(overlap).to_be_greater_than(1)

describe "Chrome + Skia GPU vs Simple Web (Vulkan) Examples & Aqua Parity (800x600)":
    it "establishes Vulkan/MoltenVK + Chrome GPU Skia base configuration":
        val (resolved, reason) = simple_web_resolved_engine2d_backend_name_with_reason(VIEW_W, VIEW_H, "vulkan")
        val base_html = "<!DOCTYPE html><html><body style='margin:0;background:#f8fafc'><div style='width:240px;height:80px;margin:24px;background:#2563eb;border-radius:10px;box-shadow:0 8px 20px rgba(15,23,42,0.25)'></div></body></html>"
        val readback = simple_web_layout_render_html_readback(base_html, VIEW_W, VIEW_H, "vulkan")
        val gpu_backend_used = readback.source == "device_readback" and readback.backend_handle > 0 and readback.device_identity > 0
        print "[parity-base] probe resolved={resolved} reason={reason} readback_source={readback.source} gpu_backend_used={gpu_backend_used} handle={readback.backend_handle} device={readback.device_identity}"
        expect(readback.pixels.len() as i32).to_equal(EXPECTED_PIXEL_COUNT)
        expect(readback.pixel_count).to_equal(EXPECTED_PIXEL_COUNT.to_i64())
        if resolved == "vulkan":
            expect(readback.source).to_equal("device_readback")
            expect(gpu_backend_used).to_equal(true)
        val browser_bin = compare_view_find_browser("")
        if browser_bin != "":
            val chrome_pixels = _capture_chrome_screenshot(browser_bin, "base_config", base_html, "")
            expect(chrome_pixels.len() as i32).to_equal(EXPECTED_PIXEL_COUNT)
            if (chrome_pixels.len() as i32) == EXPECTED_PIXEL_COUNT:
                val cv_status = compare_view_inspect(
                    "chrome_vs_simple_web_base_config",
                    "simple_web_vulkan",
                    readback.pixels,
                    VIEW_W,
                    VIEW_H,
                    "chrome_skia_gpu",
                    chrome_pixels,
                    VIEW_W,
                    VIEW_H
                )
                if (env_get("SIMPLE_COMPARE_VIEW") ?? "").trim().lower() == "html":
                    expect(cv_status.starts_with("written:")).to_equal(true)

    it "renders sample_page.html at 800x600 with Chrome structural/background parity":
        val path = "examples/06_io/ui/sample_page.html"
        val html = file_read(path)
        _verify_example_parity("sample_page", html, path)

    it "renders browser_common_elements_showcase.html at 800x600 with Chrome parity":
        val path = "examples/06_io/ui/browser_common_elements_showcase.html"
        val html = file_read(path)
        _verify_example_parity("browser_common_elements_showcase", html, path)

    it "renders web_catalog/css-layout.html at 800x600 with Chrome parity":
        val path = "examples/06_io/ui/web_catalog/css-layout.html"
        val html = file_read(path)
        _verify_example_parity("css_layout", html, path)

    it "renders web_catalog/css-paint.html at 800x600 with Chrome parity":
        val path = "examples/06_io/ui/web_catalog/css-paint.html"
        val html = file_read(path)
        _verify_example_parity("css_paint", html, path)

    it "renders Aqua CSS-themed Simple GUI + Simple Browser chrome page at 800x600 with Chrome parity":
        val html = _build_aqua_browser_chrome_html()
        _verify_example_parity("aqua_browser_chrome", html, "")

    it "lays out sample_page.html at 800x600 without card overlap, with spaced nav links and centered hero buttons":
        val html = file_read("examples/06_io/ui/sample_page.html")
        val lines = simple_web_layout_element_geometry_lines(html, VIEW_W, VIEW_H)

        val brand = _find_layout_box(lines, "path:0/0")
        val nav0 = _find_layout_box(lines, "path:0/1/0")
        val nav1 = _find_layout_box(lines, "path:0/1/1")
        val nav2 = _find_layout_box(lines, "path:0/1/2")
        val nav3 = _find_layout_box(lines, "path:0/1/3")
        expect(nav0.w).to_be_greater_than(0)
        expect(nav1.w).to_be_greater_than(0)
        expect(nav2.w).to_be_greater_than(0)
        expect(nav3.w).to_be_greater_than(0)
        expect(nav0.x).to_be_greater_than(brand.x + brand.w)
        expect(nav1.x).to_be_greater_than(nav0.x + nav0.w)
        expect(nav2.x).to_be_greater_than(nav1.x + nav1.w)
        expect(nav3.x).to_be_greater_than(nav2.x + nav2.w)
        expect(nav3.x + nav3.w).to_be_less_than(VIEW_W + 1)

        val hero = _find_layout_box(lines, "path:1")
        val btn0 = _find_layout_box(lines, "path:1/2")
        val btn1 = _find_layout_box(lines, "path:1/3")
        expect(btn0.w).to_be_greater_than(0)
        expect(btn1.w).to_be_greater_than(0)
        expect(btn1.y).to_equal(btn0.y)
        expect(btn1.x).to_be_greater_than(btn0.x + btn0.w)
        val hero_mid = hero.x + (hero.w / 2)
        val group_mid = (btn0.x + (btn1.x + btn1.w)) / 2
        expect(_abs_i32(group_mid - hero_mid)).to_be_less_than(3)

        val card0 = _find_layout_box(lines, "path:2/0")
        val card1 = _find_layout_box(lines, "path:2/1")
        val card2 = _find_layout_box(lines, "path:2/2")
        expect(card0.w).to_be_greater_than(200)
        expect(card1.w).to_be_greater_than(200)
        expect(card2.w).to_be_greater_than(200)
        expect(card0.h).to_be_greater_than(80)
        expect(card1.h).to_be_greater_than(80)
        expect(card2.h).to_be_greater_than(80)
        expect(_boxes_overlap(card0, card1)).to_equal(false)
        expect(_boxes_overlap(card0, card2)).to_equal(false)
        expect(_boxes_overlap(card1, card2)).to_equal(false)
        expect(card1.x).to_be_greater_than(card0.x + card0.w)
        expect(card2.y).to_be_greater_than(card0.y + card0.h)
        expect(card2.y).to_be_greater_than(card1.y + card1.h)
        expect(card1.x + card1.w).to_be_less_than(VIEW_W + 1)
        expect(card2.x + card2.w).to_be_less_than(VIEW_W + 1)

    it "lays out Aqua browser chrome titlebar and toolbar at 800x600 within viewport bounds without overlap":
        val html = _build_aqua_browser_chrome_html()
        val lines = simple_web_layout_element_geometry_lines(html, VIEW_W, VIEW_H)

        val lights = _find_layout_box(lines, "path:0/0/0")
        val title = _find_layout_box(lines, "path:0/0/1")
        val badge = _find_layout_box(lines, "path:0/0/2")
        expect(lights.w).to_be_greater_than(0)
        expect(lights.w).to_be_less_than(80)
        expect(title.w).to_be_greater_than(100)
        expect(badge.w).to_be_greater_than(0)
        expect(_boxes_overlap(lights, title)).to_equal(false)
        expect(_boxes_overlap(title, badge)).to_equal(false)
        expect(title.x).to_be_greater_than(lights.x + lights.w)
        expect(badge.x + badge.w).to_be_less_than(VIEW_W)

        val url = _find_layout_box(lines, "path:0/1/0")
        val sel = _find_layout_box(lines, "path:0/1/1")
        val go_btn = _find_layout_box(lines, "path:0/1/2")
        expect(url.w).to_be_greater_than(200)
        expect(sel.w).to_be_greater_than(0)
        expect(go_btn.w).to_be_greater_than(0)
        expect(_boxes_overlap(url, sel)).to_equal(false)
        expect(_boxes_overlap(sel, go_btn)).to_equal(false)
        expect(_boxes_overlap(url, go_btn)).to_equal(false)
        expect(go_btn.x + go_btn.w).to_be_less_than(VIEW_W)
