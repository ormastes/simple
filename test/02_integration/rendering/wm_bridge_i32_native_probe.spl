use common.ui.wm_app_process_contract.{
    wm_fs_app_event, wm_fs_app_event_decode, wm_fs_app_event_encode,
    wm_fs_bridge_decode, wm_fs_bridge_encode,
    wm_fs_frame_receipt, wm_fs_frame_receipt_decode, wm_fs_frame_receipt_encode,
    wm_widget_showcase_bridge_request_sized
}

fn main() -> i64:
    val request = wm_widget_showcase_bridge_request_sized(
        41, "build/tmp/native-probe.ppm", 480, 270)
    val encoded = wm_fs_bridge_encode(request)
    val decoded = wm_fs_bridge_decode(encoded)
    if decoded.pid != 41 or decoded.window_w != 480 or decoded.window_h != 270:
        print("wm_bridge_i32_native_status=fail-bridge width={decoded.window_w} height={decoded.window_h}")
        return 1
    val pointer_encoded = wm_fs_app_event_encode(
        wm_fs_app_event(2, "move", -17, 93, 3, false))
    val pointer = wm_fs_app_event_decode(pointer_encoded)
    if pointer.seq != 2 or pointer.x != -17 or pointer.y != 93 or pointer.button != 3:
        print("wm_bridge_i32_native_status=fail-pointer")
        return 2
    val receipt_encoded = wm_fs_frame_receipt_encode(
        wm_fs_frame_receipt(2, 7, "cpu_simd", "cpu_mirror", 0, 0, 129600, 1001958827))
    val receipt = wm_fs_frame_receipt_decode(receipt_encoded)
    if receipt.event_seq != 2 or receipt.frame_seq != 7 or receipt.pixel_count != 129600 or receipt.checksum != 1001958827:
        print("wm_bridge_i32_native_status=fail-receipt")
        return 3
    print("wm_bridge_i32_native_status=pass")
    0
