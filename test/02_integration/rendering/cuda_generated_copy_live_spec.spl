"""CUDA generated full-frame copy live qualification."""

use std.spec.{describe, it, expect}
use std.gpu.engine2d.backend_cuda.{CudaBackend, probe_cuda}

describe "CUDA generated copy live qualification":
    it "uses generated copy for full frames and positioned copy for subrects":
        val probe = probe_cuda()
        if probe.is_usable():
            var backend = CudaBackend.create()
            val initialized = backend.init(4, 3)
            expect(initialized).to_equal(true)
            if initialized:
                val full: [u32] = [
                    0xFF000001 as u32, 0xFF000002 as u32, 0xFF000003 as u32, 0xFF000004 as u32,
                    0xFF000005 as u32, 0xFF000006 as u32, 0xFF000007 as u32, 0xFF000008 as u32,
                    0xFF000009 as u32, 0xFF00000A as u32, 0xFF00000B as u32, 0xFF00000C as u32
                ]
                backend.draw_image(0, 0, 4, 3, full)
                expect(backend.last_image_kernel).to_equal("simple_2d_copy_u32")
                val full_readback = backend.read_pixels_with_source()
                expect(full_readback.source).to_equal("device_readback")
                expect(full_readback.pixels).to_equal(full)

                val patch: [u32] = [0xFFAABBCC as u32, 0xFF112233 as u32]
                backend.draw_image(1, 1, 2, 1, patch)
                expect(backend.last_image_kernel).to_equal("kernel_draw_image")
                val patch_readback = backend.read_pixels_with_source()
                expect(patch_readback.source).to_equal("device_readback")
                expect(patch_readback.pixels[5]).to_equal(patch[0])
                expect(patch_readback.pixels[6]).to_equal(patch[1])
                expect(patch_readback.pixels[0]).to_equal(full[0])
            backend.shutdown()
