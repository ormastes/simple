use std.gc_async_mut.gpu.engine2d.backend_vulkan.{
    VulkanBackend,
    vulkan_backend_retain_session
}
use std.gc_async_mut.gpu.engine2d.vulkan_session.{VulkanSession}

fn main() -> i64:
    var session = VulkanSession.create()
    session.device = 1
    session.is_initialized = true
    session.shader_font_atlas = 2
    session.pipe_font_atlas = 3
    session.font_atlas_artifact_mode = "embedded"
    session.font_atlas_artifact_identity = "native-retention-probe"
    session.font_atlas_status = "ready"

    var backend = VulkanBackend.create()
    vulkan_backend_retain_session(backend, session)

    # Churn tagged text values before reading the retained session so a bare
    # RtCoreString header cannot accidentally satisfy the ownership path.
    var churn = ""
    var i = 0
    while i < 64:
        churn = churn + i.to_text()
        i = i + 1

    val evidence = backend.font_atlas_pipeline_evidence()
    if not backend.owns_session:
        print("vulkan_session_retention_native_status=fail-owner")
        return 1
    if backend.session.device != 1 or backend.session.ref_count != 1:
        print("vulkan_session_retention_native_status=fail-session")
        return 2
    if evidence.status != "ready":
        print("vulkan_session_retention_native_status=fail-status")
        return 3
    if evidence.shader_handle != 2 or evidence.pipeline_handle != 3:
        print("vulkan_session_retention_native_status=fail-handles")
        return 4
    if evidence.artifact_identity != "native-retention-probe":
        print("vulkan_session_retention_native_status=fail-identity")
        return 5
    if churn == "":
        print("vulkan_session_retention_native_status=fail-churn")
        return 6

    print("vulkan_session_retention_native_status=pass")
    0
