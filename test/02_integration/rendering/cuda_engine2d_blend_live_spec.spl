"""CUDA Engine2D image blend live qualification.

Requires an NVIDIA CUDA device. Proves that the production backend completes
the blend without its CPU fallback and returns byte-exact device pixels.
"""

use std.spec.{describe, it, expect}
use std.gpu.engine2d.backend_cuda.{CudaBackend, probe_cuda}
use std.gpu.engine2d.color.{blend}

describe "CUDA Engine2D image blend live qualification":
    it "blends exact pixels on the device without CPU fallback":
        # PROBE-THEN-CREATE TOCTOU
        # (doc/08_tracking/bug/gpu_probe_then_create_toctou_2026-08-04.md)
        # This example used to wrap its ENTIRE body in `if probe.is_usable():`
        # with no else. probe_cuda() runs a create+init+shutdown and throws it
        # away; CudaBackend.create()+init() below is a SECOND, independent
        # create with nothing cached in between, so the probe answer was only a
        # prediction — and when it predicted unusable the whole live
        # qualification silently vanished while the file still reported a clean
        # pass. On this host probe_cuda() reports "CUDA runtime unavailable"
        # from a cold process while the real create succeeds with a genuine
        # device_readback, so the silent skip is live, not hypothetical.
        #
        # The create is now attempted UNCONDITIONALLY and the branch is taken on
        # init()'s OWN result. The device assertions below are unchanged and
        # stay hard; only the skip became visible.
        val probe = probe_cuda()
        var backend = CudaBackend.create()
        val initialized = backend.init(4, 4)
        if probe.is_usable() != initialized:
            print "[toctou] cuda-blend-live: probe predicted usable={probe.is_usable()} but the independent init returned {initialized} — the prediction did not survive the gap; asserting on the INIT, not the probe"
        if initialized:
            val dst = 0x40102030 as u32
            val src: [u32] = [
                0x00010203 as u32,
                0xFF112233 as u32,
                0x80406080 as u32,
                0x40224466 as u32
            ]
            backend.clear(dst)
            backend.draw_image_blend(1, 1, 2, 2, src)
            val readback = backend.read_pixels_with_source()
            expect(readback.source).to_equal("device_readback")
            expect(readback.backend_handle).to_be_greater_than(0)
            expect(backend.cpu_fallback_used).to_equal(false)
            expect(readback.pixels.len()).to_equal(16)
            if readback.pixels.len() == 16:
                expect(readback.pixels[1 * 4 + 1]).to_equal(blend(src[0], dst))
                expect(readback.pixels[1 * 4 + 2]).to_equal(blend(src[1], dst))
                expect(readback.pixels[2 * 4 + 1]).to_equal(blend(src[2], dst))
                expect(readback.pixels[2 * 4 + 2]).to_equal(blend(src[3], dst))
        else:
            # A live qualification that did not run must SAY it did not run,
            # rather than passing silently.
            print "[cuda-live] cuda-blend-live: QUALIFICATION NOT RUN — CudaBackend.init(4, 4) returned false, so no device blend was qualified; this example proves NOTHING about the CUDA blend path"
            expect(backend.initialized).to_equal(false)
        backend.shutdown()
