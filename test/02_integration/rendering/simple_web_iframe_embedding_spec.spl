"""
## Purpose and audience
Covers the hidden `<iframe>` embedding capability in the production Simple
Web layout renderer (`simple_web_html_layout_renderer.spl`). An `<iframe>` is
a replaced element: its own DOM subtree (fallback content) is never laid out
or painted; instead its child document (from `srcdoc`) is rendered through
the SAME pipeline into an offscreen `[u32]` buffer and blitted over the
iframe's content box. Nesting is capped at `WEB_IFRAME_DEPTH_CAP` (3) with an
opaque grey placeholder beyond the cap, and the `space` attribute controls
whether the child inherits the parent document's collected CSS rules
(`shared`) or is styled only by its own markup (`separate`, the default).
Audience: rendering engineers working on rendering-inside-rendering.

## Operator workflow
Run the single file with the seed runner and require every scenario green;
a failure names which iframe contract regressed (placement, fallback,
nesting, depth cap, CSS scope, or sizing).

## Compatibility and limitations
Runs on the software pixel path, so no GPU or windowing system is required
on any host. This is implementation evidence for a hidden/private capability,
not a standards-tracked feature; the CSS-scope scenario carries a NOTE about
a known interpreter brace footgun that shapes its fixture markup.

## Verification guidance and troubleshooting
Re-run this file after any edit under
`src/lib/gc_async_mut/gpu/browser_engine/`. A sampled-pixel failure means
iframe placement or blitting regressed; a color-count failure means depth
recursion, the cap placeholder, or CSS scope switching changed. Sampled
indices follow `x + y * width` on the returned framebuffer.
"""

# Lifecycle: research doc/01_research/domain/rendering_inside_rendering.md ;
# plan doc/03_plan/agent_tasks/web_renderer_vulkan_4k_showcase_hardening.md ;
# architecture doc/04_architecture/web_iframe_draw_ir_embedding.md ;
# design doc/05_design/web_iframe_draw_ir_embedding.md

use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_software_pixels}

fn _count_color(pixels: [u32], color: u32) -> i32:
    var count: i32 = 0
    var idx: i32 = 0
    while idx < pixels.len():
        if pixels[idx] == color:
            count = count + 1
        idx = idx + 1
    count

# Minimal HTML-attribute entity encoder used to build nested `srcdoc` values
# programmatically: each level of iframe nesting needs exactly one more
# round of encoding than its parent so the renderer's single decode pass per
# `srcdoc` extraction (see attr_value_by_key/decode_html_entities in
# simple_web_html_layout_renderer.spl) peels off exactly one layer at a time.
# `&` must be escaped FIRST so this function's own `&lt;`/`&gt;`/`&quot;`
# output never gets re-escaped by a later call.
fn _html_escape(s: text) -> text:
    var out = s.replace("&", "&amp;")
    out = out.replace("<", "&lt;")
    out = out.replace(">", "&gt;")
    out.replace("\"", "&quot;")

# @manual_section: iframe embedding pipeline
describe "Simple Web iframe embedding":

    it "renders an iframe srcdoc child at its content box and leaves the rest of the page unchanged":
        # @req REQ-WEBIFRAME-001
        # @capture(gui_image): iframe-box and page-background samples retained
        step("Render a page with a srcdoc iframe next to a marker div and sample both regions")
        val html = "<html><body style='margin:0;padding:0;background-color:#ffffff'><div style='width:10px;height:10px;background-color:#ef4444'></div><iframe width='40' height='20' srcdoc=\"&lt;body style='margin:0;background-color:#22c55e'&gt;&lt;/body&gt;\"></iframe></body></html>"
        val pixels = simple_web_layout_render_html_software_pixels(html, 100, 60)
        expect(pixels.len()).to_equal(100 * 60)  # oracle: authoritative software-render framebuffer value for this iframe fixture
        # marker div at (0,0)-(10,10), unaffected by the iframe
        expect(pixels[5 + 5 * 100]).to_equal(0xFFEF4444u32)  # oracle: authoritative software-render framebuffer value for this iframe fixture
        # iframe box is (0,10)-(40,30): sampled point inside is the child's color
        expect(pixels[20 + 20 * 100]).to_equal(0xFF22C55Eu32)  # oracle: authoritative software-render framebuffer value for this iframe fixture
        # far outside both the marker and the iframe box: untouched page background
        expect(pixels[80 + 50 * 100]).to_equal(0xFFFFFFFFu32)  # oracle: authoritative software-render framebuffer value for this iframe fixture

    it "never paints iframe fallback content, inline or otherwise":
        # @req REQ-WEBIFRAME-002
        # @capture(gui_image): fallback-free framebuffer sample retained
        step("Render an iframe with inline fallback content and no srcdoc")
        val html = "<html><body style='margin:0;padding:0;background-color:#ffffff'><iframe width='30' height='15' style='display:block'><div style='width:10px;height:10px;background-color:#7c3aed'></div>Fallback</iframe></body></html>"
        val pixels = simple_web_layout_render_html_software_pixels(html, 60, 40)
        expect(pixels.len()).to_equal(60 * 40)  # oracle: authoritative software-render framebuffer value for this iframe fixture
        expect(_count_color(pixels, 0xFF7C3AEDu32)).to_equal(0)  # oracle: authoritative software-render framebuffer value for this iframe fixture
        # no srcdoc -> empty child document -> blitted child canvas is the
        # renderer's own default background, not garbage
        expect(pixels[5 + 5 * 60]).to_equal(0xFFFFFFFFu32)  # oracle: authoritative software-render framebuffer value for this iframe fixture

    it "renders a nested iframe two levels deep":
        # @req REQ-WEBIFRAME-003
        # @capture(gui_image): depth-2 amber framebuffer sample retained
        step("Render a srcdoc iframe whose child document embeds a second iframe")
        # Depth 0 (top) embeds iframe1 (renders at depth 1), which embeds
        # iframe2 (renders at depth 2) whose body is solid amber. Each level
        # fully fills its parent's content box, so a top-level sample proves
        # the SECOND level of recursion actually ran.
        val level2_doc = "<body style='margin:0;background-color:#f59e0b'></body>"
        val iframe2_tag = "<iframe width='40' height='30' style='display:block' srcdoc=\"" + _html_escape(level2_doc) + "\"></iframe>"
        val level1_doc = "<body style='margin:0'>" + iframe2_tag + "</body>"
        val iframe1_tag = "<iframe width='40' height='30' style='display:block' srcdoc=\"" + _html_escape(level1_doc) + "\"></iframe>"
        val html = "<html><body style='margin:0;padding:0'>" + iframe1_tag + "</body></html>"
        val pixels = simple_web_layout_render_html_software_pixels(html, 40, 30)
        expect(pixels.len()).to_equal(40 * 30)  # oracle: authoritative software-render framebuffer value for this iframe fixture
        expect(pixels[5 + 5 * 40]).to_equal(0xFFF59E0Bu32)  # oracle: authoritative software-render framebuffer value for this iframe fixture
        expect(_count_color(pixels, 0xFFF59E0Bu32)).to_equal(40 * 30)  # oracle: authoritative software-render framebuffer value for this iframe fixture

    it "hits the embedding depth cap at level 4 and paints the placeholder instead of recursing further":
        # @req REQ-WEBIFRAME-004
        # @capture(gui_image): grey placeholder framebuffer sample retained
        step("Render four nested iframes so the innermost exceeds the depth cap")
        # top=depth0 -> iframe1=depth1 -> iframe2=depth2 -> iframe3=depth3 all
        # render; iframe3's own child (iframe4) would be depth 4, which
        # exceeds WEB_IFRAME_DEPTH_CAP(3), so it is replaced by the flat grey
        # placeholder and its (blue) content is never reached or rendered.
        val level4_doc = "<body style='margin:0;background-color:#3b82f6'></body>"
        val iframe4_tag = "<iframe width='40' height='30' style='display:block' srcdoc=\"" + _html_escape(level4_doc) + "\"></iframe>"
        val level3_doc = "<body style='margin:0'>" + iframe4_tag + "</body>"
        val iframe3_tag = "<iframe width='40' height='30' style='display:block' srcdoc=\"" + _html_escape(level3_doc) + "\"></iframe>"
        val level2_doc = "<body style='margin:0'>" + iframe3_tag + "</body>"
        val iframe2_tag = "<iframe width='40' height='30' style='display:block' srcdoc=\"" + _html_escape(level2_doc) + "\"></iframe>"
        val level1_doc = "<body style='margin:0'>" + iframe2_tag + "</body>"
        val iframe1_tag = "<iframe width='40' height='30' style='display:block' srcdoc=\"" + _html_escape(level1_doc) + "\"></iframe>"
        val html = "<html><body style='margin:0;padding:0'>" + iframe1_tag + "</body></html>"
        val pixels = simple_web_layout_render_html_software_pixels(html, 40, 30)
        expect(pixels.len()).to_equal(40 * 30)  # oracle: authoritative software-render framebuffer value for this iframe fixture
        expect(pixels[5 + 5 * 40]).to_equal(0xFF888888u32)  # oracle: authoritative software-render framebuffer value for this iframe fixture
        expect(_count_color(pixels, 0xFF3B82F6u32)).to_equal(0)  # oracle: authoritative software-render framebuffer value for this iframe fixture

    it "keeps space=separate isolated from the parent's CSS while space=shared inherits it":
        # @req REQ-WEBIFRAME-005
        # @capture(bit_table): separate/shared red-pixel counts retained
        step("Render the same marked child document with space separate and shared")
        # NOTE: the CSS rule below uses a trailing `;` before the closing `}`
        # (`background-color:#ef4444;`) to dodge a known interpreter footgun:
        # a brace span shaped like `{ident:#hex}` (no space, no trailing `;`)
        # inside a plain double-quoted literal is misparsed as string
        # interpolation and throws `semantic: variable 'ident' not found` at
        # run time — see doc/08_tracking/bug/string_interpolation_css_brace_footgun_2026-07-03.md.
        val separate_html = "<html><head><style>.marked{background-color:#ef4444;}</style></head><body style='margin:0;padding:0'><iframe width='40' height='24' style='display:block' srcdoc=\"&lt;body style='margin:0'&gt;&lt;div class='marked' style='width:40px;height:24px'&gt;&lt;/div&gt;&lt;/body&gt;\"></iframe></body></html>"
        val shared_html = "<html><head><style>.marked{background-color:#ef4444;}</style></head><body style='margin:0;padding:0'><iframe width='40' height='24' style='display:block' space='shared' srcdoc=\"&lt;body style='margin:0'&gt;&lt;div class='marked' style='width:40px;height:24px'&gt;&lt;/div&gt;&lt;/body&gt;\"></iframe></body></html>"
        val separate_pixels = simple_web_layout_render_html_software_pixels(separate_html, 40, 24)
        val shared_pixels = simple_web_layout_render_html_software_pixels(shared_html, 40, 24)
        expect(_count_color(separate_pixels, 0xFFEF4444u32)).to_equal(0)  # oracle: authoritative software-render framebuffer value for this iframe fixture
        expect(_count_color(shared_pixels, 0xFFEF4444u32)).to_equal(40 * 24)  # oracle: authoritative software-render framebuffer value for this iframe fixture

    it "sizes the iframe replaced-element box from width and height HTML attributes":
        # @req REQ-WEBIFRAME-006
        # @capture(statistics): 25x15 box edge samples and color count retained
        step("Render a 25x15 iframe and sample the box edges")
        val html = "<html><body style='margin:0;padding:0;background-color:#ffffff'><iframe width='25' height='15' style='display:block' srcdoc=\"&lt;body style='margin:0;background-color:#22c55e'&gt;&lt;/body&gt;\"></iframe></body></html>"
        val pixels = simple_web_layout_render_html_software_pixels(html, 40, 24)
        expect(pixels.len()).to_equal(40 * 24)  # oracle: authoritative software-render framebuffer value for this iframe fixture
        # inside the 25x15 box
        expect(pixels[24 + 14 * 40]).to_equal(0xFF22C55Eu32)  # oracle: authoritative software-render framebuffer value for this iframe fixture
        # just past the right edge (x=25) and bottom edge (y=15): background, not child color
        expect(pixels[26 + 14 * 40]).to_equal(0xFFFFFFFFu32)  # oracle: authoritative software-render framebuffer value for this iframe fixture
        expect(pixels[24 + 16 * 40]).to_equal(0xFFFFFFFFu32)  # oracle: authoritative software-render framebuffer value for this iframe fixture
        expect(_count_color(pixels, 0xFF22C55Eu32)).to_equal(25 * 15)  # oracle: authoritative software-render framebuffer value for this iframe fixture
