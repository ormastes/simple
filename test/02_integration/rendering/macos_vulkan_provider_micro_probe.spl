# Focused macOS Vulkan provider diagnostic.
#
# This probe deliberately stops below the renderer and window system. It opens
# one explicit runtime provider dylib, resolves the provider aliases, and
# records the provider's own initialization result and error.

use std.cli.cli_util.{get_cli_args}
use std.sffi.dynamic.{DynLib}

extern fn rt_cstring_to_text(cstr: i64) -> text

fn emit_unavailable(path: text, loader_error: text, reason: text) -> i64:
    print("vulkan_provider_probe_schema=macos-vulkan-provider-micro-v1")
    print("vulkan_provider_probe_status=fail")
    print("vulkan_provider_probe_reason=" + reason)
    print("vulkan_provider_probe_path=" + path)
    print("vulkan_provider_probe_dylib_loaded=0")
    print("vulkan_provider_probe_availability_symbol=0")
    print("vulkan_provider_probe_device_count_symbol=0")
    print("vulkan_provider_probe_init_symbol=0")
    print("vulkan_provider_probe_last_error_symbol=0")
    print("vulkan_provider_probe_shutdown_symbol=0")
    print("vulkan_provider_probe_is_available=0")
    print("vulkan_provider_probe_init=0")
    print("vulkan_provider_probe_device_count=0")
    print("vulkan_provider_probe_loader_error=" + loader_error)
    print("vulkan_provider_probe_provider_error=")
    2

fn main() -> i64:
    val args = get_cli_args()
    if args.len() != 1:
        return emit_unavailable("", "provider-path-argument-required", "invalid-arguments")

    val provider_path = args[0]
    var provider = DynLib.open(provider_path)
    if provider.handle <= 0:
        return emit_unavailable(provider_path, "dlopen-failed", "provider-dylib-load-failed")

    val availability_symbol = provider.sym("rt_vulkan_provider_is_available")
    val device_count_symbol = provider.sym("rt_vulkan_provider_device_count")
    val init_symbol = provider.sym("rt_vulkan_init")
    val last_error_symbol = provider.sym("rt_vulkan_get_last_error")
    val shutdown_symbol = provider.sym("rt_vulkan_shutdown")

    print("vulkan_provider_probe_schema=macos-vulkan-provider-micro-v1")
    print("vulkan_provider_probe_path=" + provider_path)
    print("vulkan_provider_probe_dylib_loaded=1")
    print("vulkan_provider_probe_availability_symbol=" + (if availability_symbol > 0: "1" else: "0"))
    print("vulkan_provider_probe_device_count_symbol=" + (if device_count_symbol > 0: "1" else: "0"))
    print("vulkan_provider_probe_init_symbol=" + (if init_symbol > 0: "1" else: "0"))
    print("vulkan_provider_probe_last_error_symbol=" + (if last_error_symbol > 0: "1" else: "0"))
    print("vulkan_provider_probe_shutdown_symbol=" + (if shutdown_symbol > 0: "1" else: "0"))

    if availability_symbol <= 0 or device_count_symbol <= 0 or init_symbol <= 0 or last_error_symbol <= 0 or shutdown_symbol <= 0:
        print("vulkan_provider_probe_status=fail")
        print("vulkan_provider_probe_reason=provider-symbol-missing")
        print("vulkan_provider_probe_is_available=0")
        print("vulkan_provider_probe_init=0")
        print("vulkan_provider_probe_device_count=0")
        print("vulkan_provider_probe_loader_error=provider-symbol-missing")
        print("vulkan_provider_probe_provider_error=")
        provider.close()
        return 3

    val is_available = provider.call0("rt_vulkan_provider_is_available")
    val initialized = provider.call0("rt_vulkan_init")
    val device_count = provider.call0("rt_vulkan_provider_device_count")
    val error_pointer = provider.call0("rt_vulkan_get_last_error")
    val provider_error = if error_pointer > 0: rt_cstring_to_text(error_pointer) else: ""

    print("vulkan_provider_probe_is_available=" + is_available.to_text())
    print("vulkan_provider_probe_init=" + initialized.to_text())
    print("vulkan_provider_probe_device_count=" + device_count.to_text())
    print("vulkan_provider_probe_loader_error=")
    print("vulkan_provider_probe_provider_error=" + provider_error)

    if initialized != 0:
        provider.call0("rt_vulkan_shutdown")
    provider.close()

    if is_available != 0 and initialized != 0 and device_count > 0:
        print("vulkan_provider_probe_status=pass")
        print("vulkan_provider_probe_reason=provider-device-enumerated")
        return 0

    print("vulkan_provider_probe_status=fail")
    print("vulkan_provider_probe_reason=provider-unavailable-or-device-missing")
    4
