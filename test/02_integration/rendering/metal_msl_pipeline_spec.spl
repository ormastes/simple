"""
## Purpose and audience
Purpose: This spec proves Metal MSL compile + GPU dispatch.
Audience: Maintainers of the Simple integration suite reviewing this behavior.
"""
# @req: REQ-METALMSLPIPELINE-001
# @tag: rendering, engine2d, metal, msl, pipeline
# @cover src/lib/gc_async_mut/gpu/engine2d/backend_metal_msl.spl 60%
# @cover src/lib/gc_async_mut/gpu/engine2d/backend_metal.spl 30%
#
# Guards the Metal MSL compile + GPU dispatch path. Before the MSL fix, the
# embedded shader failed to compile (Simple `#` comments are invalid C-pp
# directives; `int half` collided with MSL's reserved `half` type), so init()
# returned false and every "metal" test silently passed via the software-mirror
# fallback. These tests assert real pipeline creation and GPU dispatch.
#
# macOS-only: on Linux the asserts are skipped (Metal unavailable by design).

use std.spec.{describe, context, it, expect, step}
use std.gc_async_mut.gpu.engine2d.backend_metal.{MetalBackend}
use std.gc_async_mut.gpu.engine2d.color.{rgb, rgba}
use std.gc_async_mut.gpu.engine2d.draw_ir_glass_material.{
    Engine2dGlassMaterialConfig,
    engine2d_draw_ir_glass_material_pixels
}
use std.nogc_sync_mut.env.platform.{is_macos}
use std.io_runtime.{file_read}

describe "Metal MSL compile + GPU dispatch":

    it "keeps mandatory session pipelines mapped to one MSL entry point":
        # @req: REQ-METALMSLPIPELINE-001
        step("keeps mandatory session pipelines mapped to one MSL entry point")
        val msl = file_read(
            "src/lib/gc_async_mut/gpu/engine2d/backend_metal_msl.spl"
        )
        val session = file_read(
            "src/lib/gc_async_mut/gpu/engine2d/metal_session.spl"
        )
        val mandatory = [
            "kernel_clear",
            "kernel_draw_rect_filled",
            "kernel_draw_rect_outline",
            "kernel_draw_line",
            "kernel_draw_circle",
            "kernel_draw_circle_filled",
            "kernel_draw_rounded_rect",
            "kernel_draw_rounded_rect_outline",
            "kernel_draw_triangle_filled",
            "kernel_draw_gradient_rect",
            "kernel_blit_image",
            "kernel_composite_image"
        ]
        for name in mandatory:
            val binding = "metal_sffi_create_compute_pipeline(self.device, self.shader_lib, \"" + name + "\")"
            expect(session.split(binding).len()).to_equal(2)
            expect(msl.split("kernel void " + name + "(").len()).to_equal(2)
            val kernel = msl.substring(msl.index_of("kernel void " + name + "("), msl.len())
            val signature = kernel.substring(0, kernel.index_of(") {"))
            expect(signature).to_contain("[[buffer(0)]]")
            expect(signature).to_contain("[[buffer(1)]]")
            expect(signature).to_contain("[[buffer(4)]]")
            expect(signature).to_contain("[[thread_position_in_grid]]")
            if name == "kernel_blit_image" or name == "kernel_composite_image":
                expect(signature).to_contain("device const uint* src")
                expect(signature).to_contain("[[buffer(2)]]")

        val optional = [
            "kernel_glass_snapshot",
            "kernel_glass_material",
            "kernel_indexed_fill",
            "kernel_glyph_atlas_blit"
        ]
        for name in optional:
            expect(msl.split("kernel void " + name + "(").len()).to_equal(2)
            expect(session.split("\"" + name + "\"").len()).to_equal(2)
            val kernel = msl.substring(msl.index_of("kernel void " + name + "("), msl.len())
            val signature = kernel.substring(0, kernel.index_of(") {"))
            expect(signature).to_contain("[[buffer(0)]]")
            expect(signature).to_contain("[[buffer(1)]]")
            expect(signature).to_contain("[[buffer(2)]]")
            expect(signature).to_contain("[[thread_position_in_grid]]")

        val gate = session.substring(
            session.index_of("if self.pipe_clear"),
            session.index_of("self.last_error = 7")
        )
        expect(gate.contains("pipe_glass")).to_equal(false)
        expect(gate.contains("pipe_indexed_fill")).to_equal(false)
        expect(gate.contains("pipe_glyph_atlas_blit")).to_equal(false)
        expect(gate.contains("pipe_font_atlas_composite")).to_equal(false)

    it "keeps a successful device-glass receipt separate from CPU mirror execution":
        step("keeps a successful device-glass receipt separate from CPU mirror executi")
        # This is deliberately host-neutral: the receipt may only describe the
        # completed Metal snapshot/material dispatch. CPU mirror rasterization
        # is a distinct fallback lane, not hidden work behind that receipt.
        val backend = file_read(
            "src/lib/gc_async_mut/gpu/engine2d/backend_metal.spl"
        )
        expect(backend.contains(
            "engine2d_draw_ir_glass_material_pixels"
        )).to_equal(false)
        expect(backend.contains(
            "self.mirror.draw_image(\n                    config.x, config.y, config.width, config.height,\n                    mirror_pixels)"
        )).to_equal(false)
        expect(backend).to_contain(
            "Metal device glass requires GPU-only source of truth"
        )
        expect(backend).to_contain(
            "if not self.gpu_only:"
        )
        expect(backend).to_contain(
            "readback_source_label(ReadbackSource.DeviceReadback)"
        )

    context "on macOS":

        it "MSL compiles: all compute pipelines created":
            step("MSL compiles: all compute pipelines created")
            if is_macos():
                var b = MetalBackend.create()
                val ok = b.init(16, 16)
                expect(ok).to_equal(true)
                expect(b.session.pipe_clear).to_be_greater_than(0)
                expect(b.session.pipe_rect_filled).to_be_greater_than(0)
                expect(b.session.pipe_line).to_be_greater_than(0)
                expect(b.session.pipe_circle).to_be_greater_than(0)
                expect(b.session.pipe_triangle).to_be_greater_than(0)
                expect(b.session.pipe_gradient).to_be_greater_than(0)
                expect(b.session.pipe_blit).to_be_greater_than(0)
                expect(b.session.pipe_image_composite).to_be_greater_than(0)
                expect(b.session.pipe_glass_snapshot).to_be_greater_than(0)
                expect(b.session.pipe_glass_material).to_be_greater_than(0)
                expect(b.pending_composite_command).to_equal(0)
                expect(b.pending_composite_encoder).to_equal(0)
                b.shutdown()
            else:
                expect(is_macos()).to_equal(false)

        it "device glass dispatch owns an independent completed operation":
            step("device glass dispatch owns an independent completed operation")
            if is_macos():
                var b = MetalBackend.create()
                expect(b.init(16, 16)).to_equal(true)
                b.use_gpu_only()
                val seed = rgba(12, 24, 48, 63)
                b.clear(seed)
                val config = Engine2dGlassMaterialConfig(
                    framebuffer_width: 16,
                    framebuffer_height: 16,
                    x: 4,
                    y: 4,
                    width: 8,
                    height: 8,
                    radius: 2,
                    blur_radius: 4,
                    saturation_milli: 1700,
                    surface_alpha_milli: 800,
                    surface_color: 0xCC1F1F21u32,
                    gradient_from: 0x14FFFFFFu32,
                    gradient_to: 0x06FFFFFFu32,
                    gradient_enabled: true,
                    gradient_layered_over_surface: true
                )
                val oracle = engine2d_draw_ir_glass_material_pixels(
                    [seed; 16 * 16],
                    config
                )
                expect(oracle.len()).to_equal(8 * 8)
                val applied = b.draw_ir_apply_glass_material_device(config)
                val readback = b.read_pixels_with_source()
                expect(applied).to_equal(true)
                expect(readback.source).to_equal("device_readback")
                expect(readback.backend_handle).to_be_greater_than(0)
                expect(readback.pixels.len()).to_equal(16 * 16)
                expect(readback.pixels[0]).to_equal(seed)
                expect(readback.pixels[4 * 16 + 4]).to_equal(oracle[0])
                expect(readback.pixels[8 * 16 + 8]).to_equal(oracle[4 * 8 + 4])
                expect(b.pending_composite_command).to_equal(0)
                expect(b.pending_composite_encoder).to_equal(0)
                b.shutdown()
            else:
                expect(is_macos()).to_equal(false)

        it "normal mirror mode rejects a device-only glass receipt":
            step("normal mirror mode rejects a device-only glass receipt")
            if is_macos():
                var b = MetalBackend.create()
                expect(b.init(16, 16)).to_equal(true)
                val seed = rgba(12, 24, 48, 63)
                b.clear(seed)
                val config = Engine2dGlassMaterialConfig(
                    framebuffer_width: 16,
                    framebuffer_height: 16,
                    x: 4,
                    y: 4,
                    width: 8,
                    height: 8,
                    radius: 2,
                    blur_radius: 4,
                    saturation_milli: 1700,
                    surface_alpha_milli: 800,
                    surface_color: 0xCC1F1F21u32,
                    gradient_from: 0x14FFFFFFu32,
                    gradient_to: 0x06FFFFFFu32,
                    gradient_enabled: true,
                    gradient_layered_over_surface: true
                )
                val applied = b.draw_ir_apply_glass_material_device(config)
                val mirror_pixels = b.mirror.read_pixels()
                expect(applied).to_equal(false)
                expect(b.last_error).to_equal(
                    "Metal device glass requires GPU-only source of truth"
                )
                expect(mirror_pixels[4 * 16 + 4]).to_equal(seed)
                b.shutdown()
            else:
                expect(is_macos()).to_equal(false)

        it "GPU clear dispatch runs (1d) and marks dirty":
            step("GPU clear dispatch runs (1d) and marks dirty")
            if is_macos():
                var b = MetalBackend.create()
                b.init(16, 16)
                b.clear(rgb(3, 5, 7))
                expect(b.dirty).to_equal(true)
                expect(b.pending_composite_command).to_equal(0)
                expect(b.pending_composite_encoder).to_equal(0)
                b.shutdown()
            else:
                expect(is_macos()).to_equal(false)

        it "GPU rect_filled dispatch runs (2d) and marks dirty":
            step("GPU rect_filled dispatch runs (2d) and marks dirty")
            if is_macos():
                var b = MetalBackend.create()
                b.init(16, 16)
                b.draw_rect_filled(0, 0, 8, 8, rgb(40, 70, 100))
                expect(b.dirty).to_equal(true)
                expect(b.pending_composite_command).to_equal(0)
                expect(b.pending_composite_encoder).to_equal(0)
                b.shutdown()
            else:
                expect(is_macos()).to_equal(false)
