# @cover src/os/compositor/host_services/sdl2_display_adapter.spl 80%
use std.spec
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use os.compositor.hosted_backend_sdl2.{HostedSdl2Backend}
use os.compositor.host_services.sdl2_display_adapter.{sosix_sdl2_submit_composition}
use os.sosix.core.operation.{SosixOperationId}
use os.sosix.core.capability_ref.{SosixCapabilityRef, SosixBufferRef}
use os.sosix.host.service_contract.{SOSIX_HOST_DISPLAY_PRESENT, SosixDisplayRequest}
use os.sosix.host.display_surface_state.{sosix_display_surface_state_create}
use common.ui.draw_ir.{draw_ir_composition}

fn surface() -> SosixCapabilityRef:
    SosixCapabilityRef(slot: 12, generation: 4)

fn request() -> SosixDisplayRequest:
    SosixDisplayRequest(
        operation: SosixOperationId(slot: 1, generation: 1),
        api_id: SOSIX_HOST_DISPLAY_PRESENT,
        surface: surface(),
        surface_generation: 1,
        frame_sequence: 1,
        buffer: SosixBufferRef(slot: 22, generation: 1),
        deadline_ns: 1000
    )

describe "SOSIX hosted SDL2 display adapter":
    it "fails closed when no real SDL2 host surface exists":
        var raster = Engine2dCompositorBackend.create_named(2, 2, "software")
        val display = HostedSdl2Backend(window_handle: 0, w: 2, h: 2, pixels: [0u32; 4])
        val state = sosix_display_surface_state_create(surface(), 2).state
        val composition = draw_ir_composition("sdl2-frame-1", "sosix-host", "software", [])
        val submission = sosix_sdl2_submit_composition(
            raster, display, state, request(), composition)
        expect(submission.accepted).to_equal(false)
        expect(submission.reason).to_equal("sdl2-surface-unavailable")
        expect(submission.state.inflight_count).to_equal(0)
        raster.shutdown()

    it "rejects a mismatched host surface before consuming a frame sequence":
        var raster = Engine2dCompositorBackend.create_named(2, 2, "software")
        val display = HostedSdl2Backend(window_handle: 1, w: 3, h: 2, pixels: [0u32; 6])
        val state = sosix_display_surface_state_create(surface(), 2).state
        val composition = draw_ir_composition("sdl2-frame-1", "sosix-host", "software", [])
        val submission = sosix_sdl2_submit_composition(
            raster, display, state, request(), composition)
        expect(submission.accepted).to_equal(false)
        expect(submission.reason).to_equal("display-size-mismatch")
        expect(submission.state.next_frame_sequence).to_equal(1)
        raster.shutdown()
