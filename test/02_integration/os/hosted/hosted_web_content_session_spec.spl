        registry.register_with_headers(
            "https://api.test/data", 200,
            [
                Pair("Access-Control-Allow-Origin", "https://example.test"),
                Pair("Access-Control-Expose-Headers", "X-Visible"),
                Pair("X-Visible", "yes"),
                Pair("X-Hidden", "no"),
                Pair("Set-Cookie", "stolen=yes; Path=/")
            ],
            "ok"
        )
