extern fn rt_file_delete(path: text) -> bool

val PROFILE_PATH = "/tmp/simple_browser_profile_store_spec.sqlite3"

fn remove_profile_files():
    rt_file_delete(PROFILE_PATH)
    rt_file_delete(PROFILE_PATH + "-wal")
    rt_file_delete(PROFILE_PATH + "-shm")

fn _open_registry_address(
    registry: HostedWebContentRegistry,
    window_id: i64,
    url: text,
    event_id: i64,
    now_ms: i64
):
    val _ = registry.dispatch_chrome_pointer(
        event_id, window_id, "address", true
    )
    val _ = registry.dispatch_chrome_pointer(
        event_id + 1, window_id, "address", false
    )
    val _ = registry.dispatch_text(event_id + 2, window_id, url)
    val _ = registry.dispatch_key(event_id + 3, window_id, 13, true)
    val _ = registry.advance_window(
        window_id, "<div>browser</div>", 64, 48, now_ms, true
    )
    val _ = registry.advance_window(
        window_id, "<div>browser</div>", 64, 48, now_ms + 1, true
    )

fn check_in_process_registry_profile_reopen():
    remove_profile_files()
    val title_512 = "a".repeat(510) + "é"
    val title_513 = "a".repeat(511) + "é"
    var mocks = MockResponseRegistry.create()
    mocks.register(
        "https://title.test/accepted", 200,
        "<title>{title_512}</title><p>accepted</p>"
    )
    mocks.register(
        "https://title.test/fallback", 200,
        "<title>{title_513}</title><p>fallback</p>"
    )
    set_mock_registry(mocks)

    val first_profile = match BrowserProfileStore.open(PROFILE_PATH):
        Err(error):
            fail(error.message())
        Ok(profile):
            profile
    var first = HostedWebContentRegistry.create_with_bookmark_store(
        BrowserBookmarkStore.from_profile(first_profile)
    )
    val _ = first.advance_window(
        91, "<div>browser</div>", 64, 48, 100000, true
    )
    _open_registry_address(
        first, 91, "https://title.test/accepted", 10, 100001
    )
    val _ = first.dispatch_chrome_pointer(20, 91, "favorite", true)
    expect(first.dispatch_chrome_pointer(
        21, 91, "favorite", false
    ).callback_count).to_equal(1)  # oracle: value fixed by the spec contract
    _open_registry_address(
        first, 91, "https://title.test/fallback", 30, 100003
    )
    val _ = first.dispatch_chrome_pointer(40, 91, "favorite", true)
    expect(first.dispatch_chrome_pointer(
        41, 91, "favorite", false
    ).callback_count).to_equal(1)  # oracle: value fixed by the spec contract
    expect(first.close()).to_equal(true)

    val restarted_profile = match BrowserProfileStore.open(PROFILE_PATH):
        Err(error):
            fail(error.message())
        Ok(profile):
            profile
    var restarted = HostedWebContentRegistry.create_with_bookmark_store(
        BrowserBookmarkStore.from_profile(restarted_profile)
    )
    expect(restarted.profile_bookmarks.entries.len()).to_equal(2)  # oracle: value fixed by the spec contract
    expect(restarted.profile_bookmarks.entries[0].first).to_equal(
        "https://title.test/accepted"
    )
    expect(restarted.profile_bookmarks.entries[0].second).to_equal(
        title_512
    )
    expect(restarted.profile_bookmarks.entries[1].first).to_equal(
        "https://title.test/fallback"
    )
    expect(restarted.profile_bookmarks.entries[1].second).to_equal("")
    expect(restarted.close()).to_equal(true)
    set_mock_registry(MockResponseRegistry.create())
    remove_profile_files()

fn _set_home_page_receipt() -> Result<text, DbError>:
    remove_profile_files()
    var legacy = Database.open(PROFILE_PATH)?
    legacy.exec_sql(
        "CREATE TABLE browser_profile_meta (" +
        "id INTEGER PRIMARY KEY CHECK (id = 1)," +
        "schema_version INTEGER NOT NULL)"
    )?
    legacy.exec_sql(
        "INSERT INTO browser_profile_meta (id, schema_version) " +
        "VALUES (1, 1)"
    )?
    legacy.exec_sql(
        "CREATE TABLE browser_bookmarks (" +
        "position INTEGER PRIMARY KEY," +
        "url TEXT NOT NULL UNIQUE," +
        "title TEXT NOT NULL)"
    )?
    legacy.exec_sql(
        "INSERT INTO browser_bookmarks (position, url, title) VALUES " +
        "(0, 'https://legacy.test/', 'Legacy title')"
    )?
    legacy.close()?
    var profile = BrowserProfileStore.open(PROFILE_PATH)?
    val legacy_default = profile.load_home_url()?
    val legacy_title = profile.load_bookmarks()?.entries[0].second
    profile.save_home_url("  HTTPS://home.test/start  ")?
    val saved_home = profile.load_home_url()?
    profile.db.exec(
        "UPDATE browser_profile_meta SET home_url = ? WHERE id = 1",
        [DbValue.Text(value: "javascript:corrupt")]
    )?
    val corrupt_fallback = profile.load_home_url()?
    profile.save_home_url(saved_home)?
    val empty_atomic = (
        profile.save_home_url("").is_err() and
        profile.load_home_url()? == saved_home
    )
    val file_atomic = (
        profile.save_home_url("file:///etc/passwd").is_err() and
        profile.load_home_url()? == saved_home
    )
    val javascript_atomic = (
        profile.save_home_url("javascript:alert(1)").is_err() and
        profile.load_home_url()? == saved_home
    )
    val oversized_atomic = (
        profile.save_home_url(
            "https://home.test/" + "x".repeat(2049)
        ).is_err() and profile.load_home_url()? == saved_home
    )
    profile.close()?
    Ok(
        "legacy-default={legacy_default}; legacy-title={legacy_title}; " +
        "saved={saved_home}; corrupt-fallback={corrupt_fallback}; " +
        "empty-atomic={empty_atomic}; file-atomic={file_atomic}; " +
        "javascript-atomic={javascript_atomic}; " +
        "oversized-atomic={oversized_atomic}"
    )

fn _restart_home_profile_receipt() -> Result<text, DbError>:
    var restarted = BrowserProfileStore.open(PROFILE_PATH)?
    val home_url = restarted.load_home_url()?
    restarted.close()?
    val registry = HostedBrowserRendererRegistry.create(
        "/unused/renderer", home_url
    )
    Ok("reopened={home_url}; registry={registry.home_url}")

fn _navigate_home_receipt() -> Result<text, DbError>:
    var profile = BrowserProfileStore.open(PROFILE_PATH)?
    val home_url = profile.load_home_url()?
    profile.close()?
    var primary = HostedBrowserRendererProcess.create(80, 64, 48)
    val primary_seeded = primary.set_home_url(home_url)
    primary.state = "active"
    primary.document_url = "https://away.test/page"
    primary.document_origin = "https://away.test"
    primary.document_csp_policy = "default-src 'none'"
    primary.document_csp_ready = true
    primary.document_title = "Away"
    primary.document_title_url = primary.document_url
    primary.document_title_generation = primary.generation
    primary.document_title_reply_to_request_id = (
        primary.expected_reply_to_request_id
    )
    primary.history_urls = [primary.document_url]
    primary.history_csp_policies = [primary.document_csp_policy]
    primary.history_csp_ready = [true]
    primary.history_index = 0
    val primary_started = primary.begin_go_home(2000).is_ok()
    val primary_home = browser_renderer_navigation_decode(
        browser_renderer_decoder_feed(
            browser_renderer_decoder_new(80), primary.pending_wire
        ).message
    )
    primary._commit_document_url(primary_home.url)

    var secondary = HostedBrowserRendererProcess.create(81, 64, 48)
    val secondary_seeded = secondary.set_home_url(home_url)
    secondary.state = "active"
    secondary.document_url = "https://secondary.test/"
    secondary.history_urls = [secondary.document_url]
    secondary.history_csp_policies = [""]
    secondary.history_csp_ready = [false]
    secondary.history_index = 0
    val secondary_started = secondary.begin_go_home(2000).is_ok()
    val secondary_home = browser_renderer_navigation_decode(
        browser_renderer_decoder_feed(
            browser_renderer_decoder_new(81), secondary.pending_wire
        ).message
    )
    secondary._commit_document_url(secondary_home.url)
    Ok(
        "primary-seeded={primary_seeded}; " +
        "primary-started={primary_started}; " +
        "primary-action={primary_home.action}; " +
        "primary-method={primary_home.method}; " +
        "primary-url={primary.document_url}; " +
        "primary-csp='{primary.document_csp_policy}'; " +
        "primary-csp-ready={primary.document_csp_ready}; " +
        "primary-title='{primary.document_title}'; " +
        "primary-history={primary.history_urls.len()}; " +
        "primary-index={primary.history_index}; " +
        "secondary-seeded={secondary_seeded}; " +
        "secondary-started={secondary_started}; " +
        "secondary-action={secondary_home.action}; " +
        "secondary-method={secondary_home.method}; " +
        "secondary-url={secondary.document_url}; " +
        "secondary-history={secondary.history_urls.len()}; " +
        "secondary-index={secondary.history_index}"
    )

fn _visible_home_receipt() -> Result<text, DbError>:
    var profile = BrowserProfileStore.open(PROFILE_PATH)?
    val home_url = profile.load_home_url()?
    profile.close()?
    var comp = HostCompositor.new_headless(Size(
        width: 420u64, height: 280u64
    ))
    comp.apply_bridge_request(
        1, 0, COMP_CREATE_WINDOW.to_i64(), 0, home_url,
        20, 48, 320, 180, "<p>Home</p>", 1, "browser"
    )
    val home_control = comp.browser_chrome_target(220, 90)
    val target = if home_control.is_some():
        home_control.unwrap().control
    else:
        ""
    val title = comp.windows[0].title
    val raster = Engine2dCompositorBackend.create_named(
        420, 280, "software"
    )
    val rendered = comp.render_frame_engine2d(raster)
    val pixels = comp.pure_simple_pixel_buffer()
    val home_pixel = (
        pixels.len() == 420 * 280 and
        pixels[90 * 420 + 220] == wm_chrome_theme().title_unfocused
    )
    val address_pixel = (
        pixels.len() == 420 * 280 and
        pixels[90 * 420 + 300] == 0xFFFFFFFFu32
    )
    raster.shutdown()
    remove_profile_files()
    Ok(
        "target={target}; title={title}; draw-ir={rendered}; " +
        "pixels={pixels.len()}; home-pixel={home_pixel}; " +
        "address-pixel={address_pixel}"
    )

describe "hosted browser profile store":
    it "persists one validated Home through restart and hosted navigation":
        # @req: REQ-OS-BrowProfStor-001
        step("Set the home page")
        expect(_set_home_page_receipt()?).to_equal(
            "legacy-default=https://example.com/; " +
            "legacy-title=Legacy title; saved=https://home.test/start; " +
            "corrupt-fallback=https://example.com/; empty-atomic=true; " +
            "file-atomic=true; javascript-atomic=true; " +
            "oversized-atomic=true"
        )

        step("Restart the browser profile")
        expect(_restart_home_profile_receipt()?).to_equal(
            "reopened=https://home.test/start; " +
            "registry=https://home.test/start"
        )

        step("Navigate away and return home")
        expect(_navigate_home_receipt()?).to_equal(
            "primary-seeded=true; primary-started=true; " +
            "primary-action=home; primary-method=GET; " +
            "primary-url=https://home.test/start; primary-csp=''; " +
            "primary-csp-ready=false; primary-title=''; " +
            "primary-history=2; primary-index=1; " +
            "secondary-seeded=true; secondary-started=true; " +
            "secondary-action=home; secondary-method=GET; " +
            "secondary-url=https://home.test/start; " +
            "secondary-history=2; secondary-index=1"
        )

        step("Verify visible Home state")
        expect(_visible_home_receipt()?).to_equal(
            "target=home; title=https://home.test/start; " +
            "draw-ir=true; pixels=117600; home-pixel=true; " +
            "address-pixel=true"
        )

    it "reopens bounded bookmark titles through public registry actions":
        step("Verify: reopens bounded bookmark titles through public registry actions")
        # @req: REQ-OS-BrowProfStor-001
        check_in_process_registry_profile_reopen()

    it "rolls back bookmark mutation when its canonical snapshot read fails":
        step("Verify: rolls back bookmark mutation when its canonical snapshot read fails")
        # @req: REQ-OS-BrowProfStor-001
        remove_profile_files()
        var profile = BrowserProfileStore.open(PROFILE_PATH)?
        profile.set_bookmark(
            "https://atomic.test/page", "Committed title", true
        )?
        var registry = HostedWebContentRegistry.create_with_bookmark_store(
            BrowserBookmarkStore.from_profile(profile)
        )
        val _ = registry.advance_window(
            92, "<div>browser</div>", 64, 48, 100000, true
        )
        var session = registry.sessions[0]
        expect(session.browser.open_html(
            "https://atomic.test/page",
            "<title>Replacement title</title><p>atomic</p>"
        ).is_ok()).to_equal(true)
        registry.sessions[0] = session
        val down = registry.dispatch_chrome_pointer(
            50, 92, "favorite", true
        )
        expect(down.reason).to_equal("chrome-pressed")
        val revision_before = registry.sessions[0].mutation_revision
        val ui_before = registry.sessions[0].browser.ui_access_snapshot()
        val profile_before = registry.profile_bookmarks
        var bookmark_owner = registry.bookmark_store.unwrap()
        bookmark_owner.inject_post_mutation_bookmark_snapshot_read_failure()
        registry.bookmark_store = Some(bookmark_owner)

        val rejected = registry.dispatch_chrome_pointer(
            51, 92, "favorite", false
        )
        expect(rejected.callback_count).to_equal(0)  # oracle: value fixed by the spec contract
        expect(rejected.reason).to_contain(
            "injected post-mutation bookmark snapshot read failure"
        )
        expect(rejected.mutation_revision).to_equal(revision_before)
        expect(registry.sessions[0].mutation_revision).to_equal(
            revision_before
        )
        expect(registry.profile_bookmarks.entries.len()).to_equal(
            profile_before.entries.len()
        )
        expect(registry.profile_bookmarks.entries[0].first).to_equal(
            profile_before.entries[0].first
        )
        expect(registry.profile_bookmarks.entries[0].second).to_equal(
            "Committed title"
        )
        val ui_after = registry.sessions[0].browser.ui_access_snapshot()
        expect(ui_after.snapshot_revision).to_equal(
            ui_before.snapshot_revision
        )
        expect(ui_after.nodes.len()).to_equal(ui_before.nodes.len())
        expect(ui_after.nodes[5].selected).to_equal(
            ui_before.nodes[5].selected
        )
        expect(ui_after.nodes[5].selected).to_be(true)
        expect(registry.close()).to_equal(true)

        var restarted = BrowserProfileStore.open(PROFILE_PATH)?
        val restarted_bookmarks = restarted.load_bookmarks()?
        expect(restarted_bookmarks.entries.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(restarted_bookmarks.entries[0].first).to_equal(
            "https://atomic.test/page"
        )
        expect(restarted_bookmarks.entries[0].second).to_equal(
            "Committed title"
        )
        restarted.close()?
        remove_profile_files()

    it "cancels network jobs before fallible profile shutdown":
        step("Verify: cancels network jobs before fallible profile shutdown")
        # @req: REQ-OS-BrowProfStor-001
        var closed_store = BrowserBookmarkStore.memory()?
        closed_store.close()?
        var registry = HostedWebContentRegistry.create_with_bookmark_store(
            closed_store
        )
        expect(registry.profile_failure_reason).to_contain("close:")
        val _ = registry.advance_window(
            45, "<div>browser</div>", 64, 48, 100000, true
        )
        var session = registry.sessions[0]
        expect(session.browser.open_html(
            "https://rollback.test/",
            "<html><body>rollback</body></html>"
        ).is_ok()).to_equal(true)
        session.network_job_handle = 424242
        registry.sessions[0] = session
        val favorite_down = registry.dispatch_chrome_pointer(
            1, 45, "favorite", true
        )
        val favorite_up = registry.dispatch_chrome_pointer(
            2, 45, "favorite", false
        )
        expect(favorite_down.reason).to_equal("chrome-pressed")
        expect(favorite_up.callback_count).to_equal(0)  # oracle: value fixed by the spec contract
        expect(registry.sessions[0].browser.is_favorite(
            "https://rollback.test/"
        )).to_equal(false)
        expect(registry.close()).to_equal(false)
        expect(registry.sessions[0].network_job_handle).to_equal(0)  # oracle: value fixed by the spec contract

    it "releases hosted sessions after successful registry shutdown":
        step("Verify: releases hosted sessions after successful registry shutdown")
        # @req: REQ-OS-BrowProfStor-001
        var registry = HostedWebContentRegistry.create()
        val _ = registry.advance_window(
            46, "<div>browser</div>", 64, 48, 100000, false
        )
        expect(registry.sessions.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(registry.close()).to_equal(true)
        expect(registry.sessions.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "round trips add open and remove bookmark controls across host restarts":
        step("Verify: round trips add open and remove bookmark controls across host restarts")
        # @req: REQ-OS-BrowProfStor-001
        remove_profile_files()
        var first = HostedWebContentRegistry.create_with_bookmark_store(
            BrowserBookmarkStore.from_profile(
                BrowserProfileStore.open(PROFILE_PATH)?
            )
        )
        val _ = first.advance_window(
            47, "<div>first host</div>", 64, 48, 100000, true
        )
        var first_session = first.sessions[0]
        expect(first_session.browser.open_html(
            "https://restart.test/saved",
            "<html><body>Saved page</body></html>"
        ).is_ok()).to_equal(true)
        first.sessions[0] = first_session
        val _ = first.dispatch_chrome_pointer(1, 47, "favorite", true)
        expect(first.dispatch_chrome_pointer(
            2, 47, "favorite", false
        ).callback_count).to_equal(1)  # oracle: value fixed by the spec contract
        expect(first.close()).to_equal(true)

        var restarted = HostedWebContentRegistry.create_with_bookmark_store(
            BrowserBookmarkStore.from_profile(
                BrowserProfileStore.open(PROFILE_PATH)?
            )
        )
        val _ = restarted.advance_window(
            48, "<div>restarted host</div>", 64, 48, 100000, true
        )
        var restarted_session = restarted.sessions[0]
        restarted_session.browser.register_resource(
            "https://restart.test/saved",
            "<html><body>Reopened saved page</body></html>"
        )
        val restored_bookmarks = ui_access_find_nodes(
            restarted_session.browser.ui_access_snapshot(),
            "browser:session", "link",
            "https://restart.test/saved", 1
        )
        expect(restored_bookmarks.len()).to_equal(1)  # oracle: value fixed by the spec contract
        val opened = restarted_session.browser.ui_access_act(
            WinTextActionRequest(
                target_id: restored_bookmarks[0].canonical_id,
                action: "click", text_value: "", x: 0, y: 0
            )
        )
        expect(opened.ok).to_equal(true)
        expect(restarted_session.browser.current_url).to_equal(
            "https://restart.test/saved"
        )
        expect(restarted_session.browser.current_body_html).to_contain(
            "Reopened saved page"
        )
        restarted.sessions[0] = restarted_session
        val _ = restarted.dispatch_chrome_pointer(
            3, 48, "favorite", true
        )
        expect(restarted.dispatch_chrome_pointer(
            4, 48, "favorite", false
        ).callback_count).to_equal(1)  # oracle: value fixed by the spec contract
        expect(restarted.close()).to_equal(true)

        var removed = BrowserProfileStore.open(PROFILE_PATH)?
        expect(removed.load_bookmarks()?.entries.len()).to_equal(0)  # oracle: value fixed by the spec contract
        removed.close()?
        remove_profile_files()

    it "persists validated bookmarks and HSTS across reopen and removal":
        step("Verify: persists validated bookmarks and HSTS across reopen and removal")
        # @req: REQ-OS-BrowProfStor-001
        remove_profile_files()
        var bookmarks: [Pair<text, text>] = []
        bookmarks.push(Pair(
            first: "https://simple.test/docs", second: "Simple docs"
        ))
        var hsts_entries: [BrowserHstsSnapshotEntry] = []
        hsts_entries.push(BrowserHstsSnapshotEntry(
            host: "simple.test",
            received_at_unix_ms: 99500,
            expires_at_unix_ms: 101000,
            include_subdomains: true
        ))

        var first = BrowserProfileStore.open(PROFILE_PATH)?
        first.save_bookmarks(BrowserBookmarkSnapshot.create(bookmarks))?
        first.save_hsts(BrowserHstsSnapshot.create(hsts_entries), 100000)?
        first.close()?

        var reopened = BrowserProfileStore.open(PROFILE_PATH)?
        val restored_bookmarks = reopened.load_bookmarks()?
        val restored_hsts = reopened.load_hsts(100000)?
        expect(restored_bookmarks.entries.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(restored_hsts.entries.len()).to_equal(1)  # oracle: value fixed by the spec contract

        reopened.db.exec(
            "INSERT INTO browser_bookmarks (position, url, title) VALUES (?, ?, ?)",
            [
                DbValue.Integer(value: 99),
                DbValue.Text(value: "file:///etc/passwd"),
                DbValue.Text(value: "invalid")
            ]
        )?
        reopened.db.exec(
            "INSERT INTO browser_hsts (" +
            "host, received_at_unix_ms, expires_at_unix_ms, include_subdomains" +
            ") VALUES (?, ?, ?, ?)",
            [
                DbValue.Text(value: "com"),
                DbValue.Integer(value: 99500),
                DbValue.Integer(value: 101000),
                DbValue.Integer(value: 1)
            ]
        )?
        reopened.db.exec(
            "INSERT INTO browser_hsts (" +
            "host, received_at_unix_ms, expires_at_unix_ms, include_subdomains" +
            ") VALUES (?, ?, ?, ?)",
            [
                DbValue.Text(value: "user@simple.test"),
                DbValue.Integer(value: 99500),
                DbValue.Integer(value: 101000),
                DbValue.Integer(value: 1)
            ]
        )?
        for duplicate_host in ["Dupe.Test", "other.test"]:
            reopened.db.exec(
                "INSERT INTO browser_hsts (" +
                "host, received_at_unix_ms, expires_at_unix_ms, " +
                "include_subdomains) VALUES (?, ?, ?, ?)",
                [
                    DbValue.Text(value: duplicate_host),
                    DbValue.Integer(value: 99500),
                    DbValue.Integer(value: 101000),
                    DbValue.Integer(value: 1)
                ]
            )?
        for duplicate_host in ["dupe.test", "Other.Test"]:
            reopened.db.exec(
                "INSERT INTO browser_hsts (" +
                "host, received_at_unix_ms, expires_at_unix_ms, " +
                "include_subdomains) VALUES (?, ?, ?, ?)",
                [
                    DbValue.Text(value: duplicate_host),
                    DbValue.Integer(value: 99500),
                    DbValue.Integer(value: 99000),
                    DbValue.Integer(value: 1)
                ]
            )?
        expect(reopened.load_bookmarks()?.entries.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(reopened.load_hsts(100000)?.entries.len()).to_equal(1)  # oracle: value fixed by the spec contract

        var invalid_hsts: [BrowserHstsSnapshotEntry] = []
        invalid_hsts.push(BrowserHstsSnapshotEntry(
            host: "simple.test:443",
            received_at_unix_ms: 99500,
            expires_at_unix_ms: 101000,
            include_subdomains: true
        ))
        match reopened.save_hsts(
            BrowserHstsSnapshot.create(invalid_hsts), 100000
        ):
            Ok(_):
                fail("Expected malformed HSTS host rejection")
            Err(_):
                expect(reopened.load_hsts(100000)?.entries.len()).to_equal(1)  # oracle: value fixed by the spec contract

        var registry = HostedWebContentRegistry.create_with_bookmark_store(
            BrowserBookmarkStore.from_profile(reopened)
        )
        val changed = registry.advance_window(
            44, "<div>browser</div>", 64, 48, 100000, true
        )
        expect(changed).to_equal(false)
        expect(registry.sessions.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(registry.sessions[0].browser.is_favorite(
            "https://simple.test/docs"
        )).to_equal(true)
        var bookmark_owner = registry.bookmark_store.unwrap()
        expect(bookmark_owner.toggle_bookmark(
            "https://simple.test/docs", "Simple docs"
        )?).to_equal(false)
        registry.bookmark_store = Some(bookmark_owner)

        var primary_owner = BrowserProfileStore.open(PROFILE_PATH)?
        var current_hsts: [BrowserHstsSnapshotEntry] = []
        current_hsts.push(BrowserHstsSnapshotEntry(
            host: "simple.test",
            received_at_unix_ms: 100500,
            expires_at_unix_ms: 200000,
            include_subdomains: true
        ))
        primary_owner.save_hsts(
            BrowserHstsSnapshot.create(current_hsts), 100500
        )?
        primary_owner.close()?

        expect(registry.close_window(44)).to_equal(true)
        expect(registry.close()).to_equal(true)

        var after_removal = BrowserProfileStore.open(PROFILE_PATH)?
        expect(after_removal.load_bookmarks()?.entries.len()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(after_removal.load_hsts(101001)?.entries.len()).to_equal(1)  # oracle: value fixed by the spec contract
        after_removal.close()?
        remove_profile_files()

        var writer_one = BrowserProfileStore.open(PROFILE_PATH)?
        var writer_two = BrowserProfileStore.open(PROFILE_PATH)?
        writer_one.set_bookmark(
            "https://one.test/", "One", true
        )?
        writer_two.set_bookmark(
            "https://two.test/", "Two", true
        )?
        writer_one.set_bookmark(
            "https://one.test/", "One", false
        )?
        expect(writer_one.toggle_bookmark(
            "https://shared.test/", "Shared"
        )?).to_equal(true)
        expect(writer_two.toggle_bookmark(
            "https://shared.test/", "Shared"
        )?).to_equal(false)
        val merged = writer_two.load_bookmarks()?
        expect(merged.entries.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(merged.entries[0].first).to_equal("https://two.test/")
        writer_one.close()?
        writer_two.close()?
        remove_profile_files()
