#!/bin/sh
# Cross-check host signing against a second canonical-body emission by Simple.
set -eu
fail() { echo "x86-64-auth-roundtrip: $*" >&2; exit 1; }
tmp=$(mktemp -d "${TMPDIR:-/tmp}/x86-64-auth-roundtrip.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
if [ "${1:-}" = --self-test ]; then
    [ "$#" -eq 1 ] || fail '--self-test accepts no additional arguments'
    compiler=${SIMPLEOS_ROUNDTRIP_COMPILER:-/mnt/data/bs2/fresh-admitted-f5c26e-20260821/stage3/x86_64-unknown-linux-gnu/stage2-admitted/simple}
    admission=$(dirname "$compiler")/admission.env
    if [ ! -x "$compiler" ] || [ ! -s "$admission" ]; then
        echo 'SKIP x86_64 authenticated media roundtrip: admitted Simple helper unavailable'
        exit 0
    fi
    tool="$tmp/x86-64-auth-contract"
    env SIMPLE_COMPILER_ADMISSION="$admission" SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LIB=src \
        "$compiler" native-build --cache-dir "$tmp/cache" --source src/os --source src/lib --source src/app \
        --entry-closure --entry src/app/x86_64_auth_contract/main.spl --backend llvm \
        --opt-level=standard --output "$tool" >"$tmp/helper-build.log" 2>&1 || {
            tail -20 "$tmp/helper-build.log" >&2
            fail 'admitted Simple canonical-body helper build failed'
        }
    kernel=$compiler
    private_key="$tmp/private.pem"
    public_key="$tmp/public.pem"
    openssl genpkey -algorithm ED25519 -out "$private_key" >/dev/null 2>&1
    openssl pkey -in "$private_key" -pubout -out "$public_key" >/dev/null 2>&1
else
    [ "$#" -eq 4 ] || fail 'usage: --self-test | SIMPLE_CONTRACT_TOOL KERNEL_ELF PRIVATE_KEY_PEM PUBLIC_KEY_PEM'
    tool=$1 kernel=$2 private_key=$3 public_key=$4
fi
[ -x "$tool" ] && [ -s "$kernel" ] && [ -s "$private_key" ] && [ -s "$public_key" ] || fail 'missing input'
env SIMPLEOS_X86_64_AUTH_CONTRACT_TOOL="$tool" \
    SIMPLEOS_X86_64_AUTH_BODY_OUTPUT="$tmp/signed.body" \
    SIMPLEOS_X86_64_AUTH_MOUNT_ID=1 SIMPLEOS_X86_64_AUTH_MOUNT_GENERATION=1 \
    SIMPLEOS_X86_64_AUTH_FILE_ID=4294967297 SIMPLEOS_X86_64_AUTH_FILE_GENERATION=1 \
    sh scripts/os/build_x86_64_authenticated_fsexec.shs \
        "$tmp/media" "$kernel" "$private_key" "$public_key" >/dev/null
field() { sed -n "s/^$1=//p" "$2"; }
image_hash=$(field image_hash "$tmp/media/AUTHHEL.MAN")
kernel_hash=$(field kernel_hash "$tmp/media/AUTHHEL.ADM")
trust_hash=$(field trust_root_hash "$tmp/media/AUTHHEL.ADM")
manifest_hash=$(field manifest_hash "$tmp/media/AUTHHEL.ADM")
"$tool" "$tmp/recomputed.body" "$image_hash" "$kernel_hash" "$trust_hash" 1 1 4294967297 1
recomputed_hash=$(sha256sum "$tmp/recomputed.body" | awk '{print $1}')
[ "$(sha256sum "$tmp/signed.body" | awk '{print $1}')" = "$manifest_hash" ] || fail 'builder digest is not its signed body'
cmp -s "$tmp/signed.body" "$tmp/recomputed.body" || fail 'Simple canonical body emission is not deterministic'
[ "$recomputed_hash" = "$manifest_hash" ] ||
    fail "Simple loader recompute differs from signed manifest digest expected=$manifest_hash actual=$recomputed_hash"
sig_hex=$(field signature_hex "$tmp/media/AUTHHEL.SIG")
printf '%s' "$sig_hex" | xxd -r -p > "$tmp/signature.raw"
openssl pkeyutl -verify -rawin -pubin -inkey "$public_key" \
    -sigfile "$tmp/signature.raw" -in "$tmp/recomputed.body" >/dev/null 2>&1 ||
    fail 'host signature does not verify over Simple recompute'
echo 'PASS x86_64 host-vs-Simple authenticated media roundtrip'
