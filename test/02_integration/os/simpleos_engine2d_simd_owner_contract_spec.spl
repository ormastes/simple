# codex-system-test
# @req REQ-020 REQ-021

use std.io_runtime.{file_read, process_run_timeout}
use std.spec.*

describe "SimpleOS Engine2D SIMD production owners":

    # @req REQ-020 REQ-021
    it "wires all six operations to each target intrinsic owner without scalar PASS":
        step("Inspect the common contract and architecture owner modules")
        val common = file_read("src/lib/nogc_async_mut_noalloc/baremetal/common/engine2d_simd_evidence.spl")
        val x86 = file_read("src/lib/nogc_async_mut_noalloc/baremetal/x86_64/engine2d_simd.spl")
        val arm = file_read("src/lib/nogc_async_mut_noalloc/baremetal/arm64/engine2d_simd.spl")
        val rvv = file_read("src/lib/nogc_async_mut_noalloc/baremetal/riscv64/engine2d_simd.spl")
        val adapter = file_read("src/os/compositor/engine2d_simd_evidence.spl")
        val receipt = file_read("src/os/compositor/engine2d_render_evidence.spl")
        val catalog = file_read("src/os/port/_SimpleosMultiplatformBuild/platform_target_catalog.spl")
        expect(common).to_contain("engine2d_simd_producer_passes")
        expect(common).to_contain("scalar_fallback_calls == 0u64")
        for operation in ["fill", "copy", "alpha", "alpha_edge", "scroll", "diagram"]:
            expect(x86).to_contain("rt_simpleos_x86_engine2d_simd_" + operation)
            expect(arm).to_contain("rt_simpleos_neon_engine2d_simd_" + operation)
            expect(rvv).to_contain("rt_simpleos_rvv_engine2d_simd_" + operation)
        expect(adapter).to_contain("riscv64_engine2d_simd_produce")
        expect(receipt).to_contain("simpleos_engine2d_simd_produce(")
        expect(receipt).to_contain("engine2d_simd_producer_passes(evidence)")
        expect(catalog).to_contain("src/os/kernel/arch/x86_64/engine2d_simd_intrinsics.c")
        expect(catalog).to_contain("src/os/kernel/arch/arm64/engine2d_simd_intrinsics.c")
        expect(catalog).to_contain("src/os/kernel/arch/riscv64/engine2d_simd_intrinsics.c")
        expect(rvv.contains("pass_todo")).to_be(false)

        step("Classify source presence without compiling or launching QEMU")
        val (stdout, stderr, code) = process_run_timeout(
            "/bin/sh",
            ["-c", "sh scripts/check/check-simpleos-qemu-engine2d-simd-kernels.shs --source-contract"],
            10000)
        expect(code).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("simpleos_engine2d_simd_owner_status=local-complete")
        expect(stdout).to_contain("external-qemu-execution-framebuffer-parity-and-guest-elf-disassembly-required")
