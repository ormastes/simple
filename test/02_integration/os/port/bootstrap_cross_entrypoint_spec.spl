## Regression spec for the public cross-bootstrap script entrypoint.

use std.spec
use std.io_runtime.{file_read}

describe "bootstrap_cross entrypoint":
    it "declares main in the requested root module":
        val facade = file_read("src/os/port/bootstrap_cross.spl")
        expect(facade).to_contain("fn main():")
        expect(facade).to_contain("cross_bootstrap_main()")

    it "gives the extracted pipeline an explicit forwarded name":
        val pipeline = file_read("src/os/port/_BootstrapCross/cross_bootstrap_pipeline.spl")
        expect(pipeline).to_contain("fn cross_bootstrap_main():")
        expect(pipeline).to_contain("val config = parse_args(args)")

    it "keeps parallel targets in architecture-owned sysroots":
        val stages = file_read("src/os/port/_BootstrapCross/cross_compile_stages.spl")
        expect(stages).to_contain("fn default_sysroot_for_target(target: text) -> text:")
        expect(stages).to_contain("build/os/sysroot-aarch64")
        expect(stages).to_contain("build/os/sysroot-riscv64")
        expect(stages).to_contain("scripts/os/simpleos-sysroot-riscv64.shs")
