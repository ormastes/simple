use std.spec.*
use std.fs_driver.mem_block_device.{MemBlockDevice}
use std.fs_driver.block_device.{BlockDevice}
use os.kernel.boot.mmio.{mmio_reset_for_test}
use os.kernel.types.memory_types.{PhysAddr, VirtAddr, VmFlags, VM_PRESENT, VM_WRITABLE, VM_USER, VM_NO_EXECUTE}
use os.kernel.types.task_types.{AddressSpace}
use os.kernel.memory.pmm.{pmm_init_identity_range, pmm_get_manager, pmm_alloc_page_raw}
use os.kernel.memory.vmm.{PTE_ADDR_MASK, vmm_init_sparse_for_test}
use os.kernel.memory.vmm_address_space.{vmm_map_page_in, vmm_read_pte_in}
use os.kernel.memory.memory_leveling_vmm.{memory_vmm_write_physical}
use std.memory_leveling.{simple_memory_iso_cpu_cold, simple_memory_placement_config_from_intent, memory_leveling_policy_from_intent}
use os.kernel.memory.memory_leveling_manager.{memory_leveling_manager_new, simpleos_memory_leveling_config_default}
use os.kernel.memory.memory_swap_block.{memory_swap_block_store_new}
use os.kernel.memory.memory_swap_coordinator.{memory_swap_coordinator_new}

describe "SimpleOS swap address-space isolation":
    it "swaps one process mapping without changing the sibling mapping":
        mmio_reset_for_test()
        expect(pmm_init_identity_range(64 * 1024 * 1024, 1024 * 1024, 8 * 1024 * 1024)).to_equal(true)
        expect(vmm_init_sparse_for_test(pmm_get_manager(), 0)).to_equal(true)
        val space_a = AddressSpace(phys_root: pmm_alloc_page_raw(), id: 1)
        val space_b = AddressSpace(phys_root: pmm_alloc_page_raw(), id: 2)

        val virt = VirtAddr(addr: 0x8000000000)
        val phys_a = pmm_alloc_page_raw()
        val phys_b = pmm_alloc_page_raw()
        val flags = VmFlags(bits: VM_PRESENT | VM_WRITABLE | VM_USER | VM_NO_EXECUTE)
        expect(vmm_map_page_in(space_a, virt, PhysAddr(addr: phys_a), flags)).to_equal(true)
        expect(vmm_map_page_in(space_b, virt, PhysAddr(addr: phys_b), flags)).to_equal(true)
        memory_vmm_write_physical(phys_a, [1, 2, 3, 4])

        val intent = simple_memory_iso_cpu_cold()
        val manager = memory_leveling_manager_new(simpleos_memory_leveling_config_default())
        val allocation = manager.request(simple_memory_placement_config_from_intent(intent), memory_leveling_policy_from_intent(intent), 4, 1, 91)
        val memory_device = MemBlockDevice.new(16, 512)
        val device: BlockDevice = memory_device
        val coordinator = memory_swap_coordinator_new(manager, memory_swap_block_store_new(true, device, 0, 1, 4096))

        expect(coordinator.swap_out_page_in_space(space_a, allocation.allocation_id, 91, virt.addr, 0, 4).ok).to_equal(true)
        expect(vmm_read_pte_in(space_a, virt)).to_equal(0)
        expect(vmm_read_pte_in(space_b, virt) & PTE_ADDR_MASK).to_equal(phys_b)
        expect(coordinator.swap_in_page(allocation.allocation_id, 91).ok).to_equal(true)
        expect(vmm_read_pte_in(space_b, virt) & PTE_ADDR_MASK).to_equal(phys_b)
