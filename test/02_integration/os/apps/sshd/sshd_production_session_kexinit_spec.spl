use std.spec.*

use os.apps.sshd.sshd.{sshd_build_production_session_kexinit_for_test}
use os.apps.sshd.ssh_transport.{ssh_parse_kexinit}

fn _seed() -> [u8]:
    [
        0x9d, 0x61, 0xb1, 0x9d, 0xef, 0xfd, 0x5a, 0x60,
        0xba, 0x84, 0x4a, 0xf4, 0x92, 0xec, 0x2c, 0xc4,
        0x44, 0x49, 0xc5, 0x69, 0x7b, 0x32, 0x69, 0x19,
        0x70, 0x3b, 0xac, 0x03, 0x1c, 0xae, 0x7f, 0x60
    ]

fn _ecdsa_p256_pkcs8_der() -> [u8]:
    _hex_decode("308187020100301306072a8648ce3d020106082a8648ce3d030107046d306b0201010420578329bff057bf48c84b9fc462940c57bb509e77e443228dbd627054a1fce283a14403420004fc116698a3e3236550c4c9efa9bd4d0619602a65d2930e9150ab33e84dbc83f8a6a6b9933f35ab59245e5b5a7af5dca76b33cbe7aeee5981b3ca350bebf52ecd")

fn _hex_decode(hex: text) -> [u8]:
    if (hex.len() % 2) != 0:
        return []
    var out: [u8] = []
    var i: u64 = 0
    while i < hex.len():
        val hi = _hex_digit(hex[i])
        val lo = _hex_digit(hex[i + 1])
        if hi < 0 or lo < 0:
            return []
        out.push((hi * 16 + lo).to_u8())
        i = i + 2
    out

fn _hex_digit(c: text) -> i64:
    if c >= "0" and c <= "9":
        return c.to_i64() - "0".to_i64()
    if c >= "a" and c <= "f":
        return c.to_i64() - "a".to_i64() + 10
    if c >= "A" and c <= "F":
        return c.to_i64() - "A".to_i64() + 10
    -1

describe "SSHD production session KEXINIT":
    # Production policy: SshDaemon.build_host_keys_for_session() and
    # build_host_certificates_for_session() hard-nil RSA, ECDSA and the RSA
    # certificates (src/os/apps/sshd/sshd.spl). The live lane therefore stays on
    # the Ed25519/X25519 surface only. These assertions are deliberately
    # byte-for-byte on the whole advertised algorithm list -- a `to_contain`
    # style check is what previously let this spec drift out of sync with the
    # production hard-nil without anyone noticing.

    it "advertises only Ed25519 host material even when RSA and ECDSA keys are supplied":
        val payload = sshd_build_production_session_kexinit_for_test(
            true,
            _seed(),
            [9, 10, 11, 12],
            [13, 14, 15, 16],
            _ecdsa_p256_pkcs8_der(),
            [21, 22, 23, 24],
            [31, 32, 33, 34],
            [41, 42, 43, 44]
        )

        val parsed = ssh_parse_kexinit(payload)
        expect(parsed.is_ok()).to_equal(true)
        val kex = parsed.unwrap()
        expect(kex.kex_algorithms).to_equal("curve25519-sha256,ext-info-s,kex-strict-s-v00@openssh.com")
        # ABSOLUTE: the RSA/RSA-cert/ECDSA material passed in above is dropped by
        # the daemon's hard-nil policy, so it must NOT appear anywhere here.
        expect(kex.server_host_key_algorithms).to_equal("ssh-ed25519-cert-v01@openssh.com,ssh-ed25519")
        expect(kex.encryption_client_to_server).to_equal("aes256-gcm@openssh.com")
        expect(kex.encryption_server_to_client).to_equal("aes256-gcm@openssh.com")
        expect(kex.mac_client_to_server).to_equal("hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,none")
        expect(kex.mac_server_to_client).to_equal("hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,none")

    it "advertises no host key algorithm at all when Ed25519 is disabled":
        # Ed25519 off, and RSA material present in the daemon fields is still
        # hard-nilled by build_host_keys_for_session(). Nothing is left to
        # advertise, so the list is EMPTY -- the fail-closed outcome that
        # host_key_policy_satisfiable() is there to refuse to serve on.
        val payload = sshd_build_production_session_kexinit_for_test(
            false,
            _seed(),
            [9, 10, 11, 12],
            [13, 14, 15, 16],
            nil,
            nil,
            nil,
            nil
        )

        val parsed = ssh_parse_kexinit(payload)
        expect(parsed.is_ok()).to_equal(true)
        val kex = parsed.unwrap()
        # ABSOLUTE: empty, not "rsa-sha2-256,rsa-sha2-512".
        expect(kex.server_host_key_algorithms).to_equal("")
        expect(kex.kex_algorithms).to_equal("curve25519-sha256,ext-info-s,kex-strict-s-v00@openssh.com")
        expect(kex.encryption_client_to_server).to_equal("aes256-gcm@openssh.com")
        expect(kex.encryption_server_to_client).to_equal("aes256-gcm@openssh.com")
        # No certificates at all takes the empty-certificate KEXINIT branch in
        # ssh_build_kexinit_for_host_keys_and_certs(), which emits "none" MACs.
        expect(kex.mac_client_to_server).to_equal("none")
        expect(kex.mac_server_to_client).to_equal("none")
