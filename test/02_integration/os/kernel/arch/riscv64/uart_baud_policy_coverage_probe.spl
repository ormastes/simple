use os.kernel.arch.riscv64.platform.uart_baud_policy.{
    uart_baud_plan,
    uart_baud_plan_valid,
    uart_baud_status_code,
    uart_baud_apply_plan_with
}

fn _discard(address: u64, value: u8):
    val _address = address
    val _value = value

fn _emit(clock_hz: u64, baud: u64):
    val plan = uart_baud_plan(clock_hz, baud)
    print uart_baud_status_code(plan.status).to_text() + "," +
        plan.divisor.to_text() + "," +
        uart_baud_plan_valid(plan).to_text()

fn main() -> i64:
    val _invalid_writes = uart_baud_apply_plan_with(
        0u64, uart_baud_plan(1843200u64, 0u64), _discard
    )
    val _valid_writes = uart_baud_apply_plan_with(
        0u64, uart_baud_plan(1843200u64, 9600u64), _discard
    )
    _emit(0u64, 9600u64)
    _emit(1843200u64, 0u64)
    _emit(1843200u64, 115201u64)
    _emit(1843200u64, 1u64)
    _emit(1048560u64, 1u64)
    _emit(1843200u64, 115200u64)
    _emit(1843200u64, 9600u64)
    0
