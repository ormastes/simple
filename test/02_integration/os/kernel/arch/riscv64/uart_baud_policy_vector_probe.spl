use os.kernel.arch.riscv64.platform.uart_baud_policy.{
    uart_baud_plan,
    uart_baud_status_code
}

extern fn rt_file_read_text(path: text) -> text?

fn _parse_u64(value: text) -> u64:
    match value.trim().parse_i64():
        Some(parsed): parsed as u64
        None: 0u64

fn main() -> i64:
    val path = "test/fixtures/os/kernel/arch/riscv64/uart_baud_policy_vectors.sdn"
    val content = match rt_file_read_text(path):
        Some(value): value
        None: return 1
    var rows: i64 = 0
    for raw_line in content.split("\n"):
        if raw_line.starts_with("    "):
            val parts = raw_line.trim().split(",")
            if parts.len() == 8:
                val name = parts[0].trim()
                val plan = uart_baud_plan(_parse_u64(parts[1]), _parse_u64(parts[2]))
                print name + "," +
                    uart_baud_status_code(plan.status).to_text() + "," +
                    plan.divisor.to_text() + "," +
                    (plan.dll as i64).to_text() + "," +
                    (plan.dlh as i64).to_text()
                rows = rows + 1
    if rows != 8:
        return 1
    0
