use os.kernel.arch.riscv64.starfive.boot.starfive_dtb_policy.{
    starfive_dtb_policy_select
}

extern fn rt_file_read_text(path: text) -> text?

fn parse_u64(value: text) -> u64:
    match value.trim().parse_i64():
        Some(parsed): parsed as u64
        None: 0u64

fn main() -> i64:
    val path = "test/fixtures/os/kernel/arch/riscv64/starfive_dtb_policy_vectors.csv"
    val content = match rt_file_read_text(path):
        Some(value): value
        None: return 1
    var rows = 0
    for line in content.split("\n"):
        val parts = line.trim().split(",")
        if parts.len() == 5:
            val selected = starfive_dtb_policy_select(
                parse_u64(parts[1]),
                parse_u64(parts[2]),
                parse_u64(parts[3])
            )
            if selected != parse_u64(parts[4]):
                return 2
            print parts[0] + "," + selected.to_text()
            rows = rows + 1
    if rows != 8:
        return 3
    0
