# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.*
use std.fs_driver.mem_block_device.{MemBlockDevice}
use std.fs_driver.block_device.{BlockDevice}
use os.kernel.boot.mmio.{mmio_reset_for_test}
use os.kernel.types.memory_types.{PhysAddr, VirtAddr, VmFlags, VM_PRESENT, VM_WRITABLE, VM_USER, VM_NO_EXECUTE}
use os.kernel.memory.pmm.{pmm_init_identity_range, pmm_get_manager, pmm_alloc_page_raw}
use os.kernel.memory.vmm.{vmm_init_sparse_for_test, vmm_map_page, vmm_read_pte, vmm_translate}
use os.kernel.memory.memory_leveling_vmm.{memory_vmm_write_physical, memory_vmm_read_physical}
use std.memory_leveling.{simple_memory_iso_cpu_cold, simple_memory_placement_config_from_intent, memory_leveling_policy_from_intent}
use os.kernel.memory.memory_leveling_manager.{memory_leveling_manager_new, simpleos_memory_leveling_config_default}
use os.kernel.memory.memory_swap_block.{memory_swap_block_store_new}
use os.kernel.memory.memory_swap_coordinator.{memory_swap_coordinator_new}

describe "SimpleOS transactional swap coordinator":
    # @manual scenario evidence

    it "moves bytes from a mapped frame to block storage and restores them":
        # @req REQ-SSPEC-INTEGRATION
        step("moves bytes from a mapped frame to block storage and restores them")
        mmio_reset_for_test()
        expect(if pmm_init_identity_range(64 * 1024 * 1024, 1024 * 1024, 2 * 1024 * 1024): 1 else: 0).to_equal(1)
        expect(if vmm_init_sparse_for_test(pmm_get_manager(), 0): 1 else: 0).to_equal(1)
        val source = pmm_alloc_page_raw()
        val virt = VirtAddr(addr: 0x70000000)
        val flags = VmFlags(bits: VM_PRESENT | VM_WRITABLE | VM_USER | VM_NO_EXECUTE)
        expect(if vmm_map_page(virt, PhysAddr(addr: source), flags): 1 else: 0).to_equal(1)
        val expected: [u8] = [10, 20, 30, 40, 50, 60]
        memory_vmm_write_physical(source, expected)

        val intent = simple_memory_iso_cpu_cold()
        val manager = memory_leveling_manager_new(simpleos_memory_leveling_config_default())
        val allocation = manager.request(simple_memory_placement_config_from_intent(intent), memory_leveling_policy_from_intent(intent), expected.len() as u64, 1, 77)
        val memory_device = MemBlockDevice.new(32, 512)
        val device: BlockDevice = memory_device
        val store = memory_swap_block_store_new(true, device, 0, 2, 4096)
        val coordinator = memory_swap_coordinator_new(manager, store)

        expect(coordinator.swap_out_page(allocation.allocation_id, 77, virt.addr, 0, expected.len() as u64).state).to_equal("swapped")
        expect(if coordinator.has_swapped_mapping(allocation.allocation_id): 1 else: 0).to_equal(1)
        expect(vmm_read_pte(virt)).to_equal(0)

        expect(coordinator.swap_in_page(allocation.allocation_id, 77).state).to_equal("cpu_owned")
        val restored_phys = vmm_translate(virt).unwrap().addr
        expect(memory_vmm_read_physical(restored_phys, expected.len() as u64)).to_equal(expected)
        expect(if coordinator.has_swapped_mapping(allocation.allocation_id): 1 else: 0).to_equal(0)
        expect(coordinator.store.snapshot().occupied_slots).to_equal(0)

    it "restores the source mapping when swap storage rejects the page":
        mmio_reset_for_test()
        expect(pmm_init_identity_range(64 * 1024 * 1024, 1024 * 1024, 2 * 1024 * 1024)).to_equal(true)
        expect(vmm_init_sparse_for_test(pmm_get_manager(), 0)).to_equal(true)
        val source = pmm_alloc_page_raw()
        val virt = VirtAddr(addr: 0x70001000)
        val flags = VmFlags(bits: VM_PRESENT | VM_WRITABLE | VM_USER | VM_NO_EXECUTE)
        expect(vmm_map_page(virt, PhysAddr(addr: source), flags)).to_equal(true)
        val expected: [u8] = [11, 22, 33, 44]
        memory_vmm_write_physical(source, expected)

        val intent = simple_memory_iso_cpu_cold()
        val manager = memory_leveling_manager_new(simpleos_memory_leveling_config_default())
        val allocation = manager.request(simple_memory_placement_config_from_intent(intent), memory_leveling_policy_from_intent(intent), expected.len() as u64, 1, 78)
        val memory_device = MemBlockDevice.new(8, 512)
        val device: BlockDevice = memory_device
        val store = memory_swap_block_store_new(true, device, 0, 0, 4096)
        val coordinator = memory_swap_coordinator_new(manager, store)

        val failed = coordinator.swap_out_page(allocation.allocation_id, 78, virt.addr, 0, expected.len() as u64)
        expect(failed.reason).to_equal("swap-full")
        expect(coordinator.manager.get(allocation.allocation_id).unwrap().state.name).to_equal("cpu_owned")
        expect(vmm_translate(virt).unwrap().addr).to_equal(source)
        expect(memory_vmm_read_physical(source, expected.len() as u64)).to_equal(expected)

    it "keeps restored bytes available while retrying slot cleanup":
        mmio_reset_for_test()
        expect(pmm_init_identity_range(64 * 1024 * 1024, 1024 * 1024, 2 * 1024 * 1024)).to_equal(true)
        expect(vmm_init_sparse_for_test(pmm_get_manager(), 0)).to_equal(true)
        val source = pmm_alloc_page_raw()
        val virt = VirtAddr(addr: 0x70002000)
        val flags = VmFlags(bits: VM_PRESENT | VM_WRITABLE | VM_USER | VM_NO_EXECUTE)
        expect(vmm_map_page(virt, PhysAddr(addr: source), flags)).to_equal(true)
        val expected: [u8] = [7, 14, 21, 28]
        memory_vmm_write_physical(source, expected)

        val intent = simple_memory_iso_cpu_cold()
        val manager = memory_leveling_manager_new(simpleos_memory_leveling_config_default())
        val allocation = manager.request(simple_memory_placement_config_from_intent(intent), memory_leveling_policy_from_intent(intent), expected.len() as u64, 1, 79)
        val memory_device = MemBlockDevice.new(16, 512)
        val device: BlockDevice = memory_device
        val store = memory_swap_block_store_new(true, device, 0, 1, 4096)
        val coordinator = memory_swap_coordinator_new(manager, store)

        expect(coordinator.swap_out_page(allocation.allocation_id, 79, virt.addr, 0, expected.len() as u64).ok).to_equal(true)
        coordinator.store.fail_next_release_for_test()
        val restored = coordinator.swap_in_page(allocation.allocation_id, 79)
        expect(restored.ok).to_equal(true)
        expect(restored.reason).to_equal("slot-cleanup-pending")
        expect(coordinator.has_swapped_mapping(allocation.allocation_id)).to_equal(false)
        expect(coordinator.has_cleanup_pending(allocation.allocation_id)).to_equal(true)
        expect(memory_vmm_read_physical(vmm_translate(virt).unwrap().addr, expected.len() as u64)).to_equal(expected)
        expect(coordinator.store.snapshot().occupied_slots).to_equal(1)

        expect(coordinator.retry_slot_cleanup(allocation.allocation_id, 79).ok).to_equal(true)
        expect(coordinator.has_cleanup_pending(allocation.allocation_id)).to_equal(false)
        expect(coordinator.store.snapshot().occupied_slots).to_equal(0)
