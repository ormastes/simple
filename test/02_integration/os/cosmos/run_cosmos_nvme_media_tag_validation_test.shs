#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
test_source="$root/test/02_integration/os/cosmos/cosmos_nvme_media_tag_validation_test.c"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-media-tag.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

common='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2'
seams='-Dcosmos_pcie_host_dma_submit_auto_host_to_device=cosmos_test_tag_dma
 -Dcosmos_pcie_host_dma_submit_auto_device_to_host=cosmos_test_tag_dma
 -Dcosmos_pcie_host_dma_poll_auto=cosmos_test_tag_dma_poll
 -Dcosmos_nfc_read_page=cosmos_test_tag_nfc_read
 -Dcosmos_nfc_program_page=cosmos_test_tag_nfc_program'

cc $common -Wno-int-to-pointer-cast -DCOSMOS_MMIO_TEST=1 $seams \
    -no-pie -I"$source_dir" "$test_source" \
    "$source_dir/cosmos_nvme_ftl_media.c" "$source_dir/cosmos_ftl.c" \
    -o "$build_dir/cosmos_nvme_media_tag_validation_test"
"$build_dir/cosmos_nvme_media_tag_validation_test"

clang --target=armv7-none-eabi -mcpu=cortex-a9 -marm \
    -ffreestanding -nostdlib -fno-builtin $common \
    -DCOSMOS_SILICON=1 $seams \
    -include "$source_dir/cosmos_profile_openssd2_8ch8way_v300.h" \
    -I"$source_dir" -c "$source_dir/cosmos_nvme_ftl_media.c" \
    -o "$build_dir/cosmos_nvme_media_tag_validation.arm.o"

echo "cosmos NVMe media page-tag validation ARM compile: PASS"
