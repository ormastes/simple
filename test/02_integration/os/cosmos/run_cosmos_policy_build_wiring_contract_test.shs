#!/bin/sh
# Static fail-closed contract for the Cosmos pure-Simple policy build closure.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)"
SOURCE="$ROOT/src/os/kernel/arch/arm32/cosmos"
BUILD="$SOURCE/build.shs"
RECEIPT="$SOURCE/cosmos_build_receipt.shs"
PACKAGE="$SOURCE/package_boot.shs"
MANIFEST="$ROOT/build/verify/cosmos-policy-build-wiring-sources.tsv"

fail() {
    echo "FAIL cosmos policy build wiring: $*" >&2
    exit 1
}

sh -n "$BUILD" && sh -n "$RECEIPT" && sh -n "$PACKAGE" ||
    fail "shell syntax"

mkdir -p "$(dirname "$MANIFEST")"
sh -c '. "$1"; cosmos_write_source_manifest "$2" "$3"' sh \
    "$RECEIPT" "$SOURCE" "$MANIFEST" || fail "source manifest generation"
[ "$(wc -l < "$MANIFEST" | tr -d ' ')" = 65 ] ||
    fail "source manifest is not the exact 65-file closure"

for base in \
    cosmos_nfc_policy cosmos_ftl_nfc_backend_policy cosmos_ftl_policy \
    cosmos_nvme_media_policy cosmos_nvme_admin_policy \
    cosmos_nvme_pcie_adapter_policy cosmos_pcie_residual_policy \
    cosmos_storage_policy
do
    grep -Eq "  ${base}[.]h$" "$MANIFEST" || fail "missing $base.h receipt input"
    grep -Eq "  ${base}[.]spl$" "$MANIFEST" || fail "missing $base.spl receipt input"
    grep -Fq "cosmos_build_policy_pair $base" "$BUILD" ||
        fail "missing $base production object"
done

[ "$(grep -c '"\$SIMPLE" native-build' "$BUILD")" = 11 ] ||
    fail "unexpected Simple build invocation surface"
[ "$(grep -c 'SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LIB="\$ROOT/src"' "$BUILD")" = 11 ] ||
    fail "a Simple build invocation permits stub fallback"
grep -Fq 'CFLAGS="$CFLAGS -DCOSMOS_FTL_NFC_BACKEND_PURE_POLICY=1"' "$BUILD" ||
    fail "FTL NFC backend still selects the C fallback"
grep -Fq 'retained object closure must contain exactly 50 objects' "$BUILD" ||
    fail "50-object closure is not enforced"
grep -Fq 'object.file.count=50' "$PACKAGE" ||
    fail "package self-test does not enforce the object closure"
grep -Fq 'firmware.object.manifest.sha256' "$PACKAGE" ||
    fail "boot manifest does not bind the firmware object receipt"
grep -Fq '_cr_object_manifest="${9:-}"' "$RECEIPT" ||
    fail "firmware receipt does not require the object manifest"

echo "PASS cosmos policy build wiring sources=65 objects=50 policies=8 no_stub_fallback=11/11"
