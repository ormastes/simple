#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
test_source="$root/test/02_integration/os/cosmos/cosmos_nvme_dispatch_contract_test.c"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-dispatch-queue.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

common_flags='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2 -Wno-unused-function'

cc $common_flags -DCOSMOS_MMIO_TEST=1 \
    -DCOSMOS_NVME_DISPATCH_QUEUE_ONLY=1 -I"$source_dir" \
    "$test_source" \
    "$source_dir/cosmos_nvme_firmware.c" \
    "$source_dir/cosmos_nvme_admin.c" \
    "$source_dir/cosmos_nvme_pcie_adapter.c" \
    "$source_dir/cosmos_nvme_dispatch.c" \
    -o "$build_dir/cosmos_nvme_dispatch_queue_test"
"$build_dir/cosmos_nvme_dispatch_queue_test"

clang --target=armv7-none-eabi -mcpu=cortex-a9 -marm \
    -ffreestanding -nostdlib -fno-builtin $common_flags \
    -I"$source_dir" -c "$source_dir/cosmos_nvme_dispatch.c" \
    -o "$build_dir/cosmos_nvme_dispatch_queue.arm.o"

echo "cosmos NVMe dispatcher queue ARM compile: PASS"
