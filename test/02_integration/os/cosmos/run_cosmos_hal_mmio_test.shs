#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
test_source="$root/test/02_integration/os/cosmos/cosmos_hal_mmio_test.c"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-hal-mmio.XXXXXX")
fsbl_vectors="$root/test/fixtures/os/cosmos/fsbl_handoff_vectors.tsv"
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

[ -s "$fsbl_vectors" ] || {
    echo "missing Cosmos FSBL vector fixture: $fsbl_vectors" >&2
    exit 1
}
export COSMOS_FSBL_VECTOR_TSV="$fsbl_vectors"

cc \
    -std=c11 -O2 -g \
    -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2 \
    -Wno-int-to-pointer-cast \
    -DCOSMOS_SILICON=1 \
    -DCOSMOS_MMIO_TEST=1 \
    -DCOSMOS_POLL_LIMIT=16U \
    -DCOSMOS_NFC_POLL_LIMIT=16U \
    -include "$source_dir/cosmos_profile_openssd2_8ch8way_v300.h" \
    -I"$source_dir" \
    "$test_source" \
    "$source_dir/cosmos_fsbl.c" \
    "$source_dir/cosmos_nfc.c" \
    "$source_dir/cosmos_pcie.c" \
    -o "$build_dir/cosmos_hal_mmio_test"

# One normal process per case isolates the production drivers' private static
# state. Its normal exit also lets any enabled process coverage handler flush;
# the former fork()+_exit() children bypassed exit handlers.
case_count=$("$build_dir/cosmos_hal_mmio_test" --count)
case "$case_count" in
    ''|*[!0-9]*)
        echo "invalid cosmos HAL case count: $case_count" >&2
        exit 1
        ;;
esac
[ "$case_count" -gt 0 ] || {
    echo "invalid cosmos HAL case count: $case_count" >&2
    exit 1
}
case_index=0
while [ "$case_index" -lt "$case_count" ]; do
    "$build_dir/cosmos_hal_mmio_test" "$case_index"
    case_index=$((case_index + 1))
done
