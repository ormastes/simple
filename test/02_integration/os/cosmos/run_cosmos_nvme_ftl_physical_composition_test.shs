#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
test_source="$root/test/02_integration/os/cosmos/cosmos_ftl_nfc_backend_test.c"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-nvme-ftl-physical.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

common_flags='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2'
test_flags='-DCOSMOS_FTL_NFC_METADATA_PAGE_LIMIT=1280U -DCOSMOS_NVME_FTL_PHYSICAL_COMPOSITION_TEST=1'
seams='-Dcosmos_pcie_host_dma_submit_auto_host_to_device=cosmos_test_media_dma_h2d
 -Dcosmos_pcie_host_dma_submit_auto_device_to_host=cosmos_test_media_dma_d2h
 -Dcosmos_pcie_host_dma_poll_auto=cosmos_test_media_dma_poll
 -Dcosmos_nfc_read_page=cosmos_test_media_nfc_read
 -Dcosmos_nfc_program_page=cosmos_test_media_nfc_program'

cc $common_flags -Wno-int-to-pointer-cast -Wno-unused-function \
    -DCOSMOS_MMIO_TEST=1 $test_flags -I"$source_dir" \
    -c "$test_source" -o "$build_dir/test.o"
cc $common_flags -Wno-int-to-pointer-cast -DCOSMOS_MMIO_TEST=1 \
    $test_flags -I"$source_dir" \
    -c "$source_dir/cosmos_ftl_nfc_backend.c" -o "$build_dir/backend.o"
cc $common_flags -Wno-int-to-pointer-cast -DCOSMOS_MMIO_TEST=1 \
    -I"$source_dir" -c "$source_dir/cosmos_ftl.c" -o "$build_dir/ftl.o"
cc $common_flags -Wno-int-to-pointer-cast -DCOSMOS_MMIO_TEST=1 \
    -I"$source_dir" -c "$source_dir/cosmos_nfc.c" -o "$build_dir/nfc.o"
cc $common_flags -Wno-int-to-pointer-cast -DCOSMOS_MMIO_TEST=1 \
    $seams -I"$source_dir" -c "$source_dir/cosmos_nvme_ftl_media.c" \
    -o "$build_dir/media.o"
cc -no-pie "$build_dir/test.o" "$build_dir/backend.o" \
    "$build_dir/media.o" "$build_dir/ftl.o" "$build_dir/nfc.o" \
    -o "$build_dir/cosmos_nvme_ftl_physical_composition_test"
"$build_dir/cosmos_nvme_ftl_physical_composition_test"

clang --target=armv7-none-eabi -mcpu=cortex-a9 -marm \
    -ffreestanding -nostdlib -fno-builtin $common_flags \
    -DCOSMOS_SILICON=1 $test_flags $seams \
    -include "$source_dir/cosmos_profile_openssd2_8ch8way_v300.h" \
    -I"$source_dir" -c "$source_dir/cosmos_nvme_ftl_media.c" \
    -o "$build_dir/cosmos_nvme_ftl_physical_composition.arm.o"

echo "cosmos NVMe physical media composition ARM compile: PASS"
