#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
test_source="$root/test/02_integration/os/cosmos/cosmos_ftl_contract_test.c"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-ftl-gc.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

common_flags='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2 -Wno-unused-function'

cc $common_flags -DCOSMOS_MMIO_TEST=1 -DCOSMOS_FTL_GC_ONLY=1 \
    -I"$source_dir" "$test_source" "$source_dir/cosmos_ftl.c" \
    -o "$build_dir/cosmos_ftl_gc_contract_test"
"$build_dir/cosmos_ftl_gc_contract_test"

clang --target=armv7-none-eabi -mcpu=cortex-a9 -marm \
    -ffreestanding -nostdlib -fno-builtin $common_flags \
    -I"$source_dir" -c "$source_dir/cosmos_ftl.c" \
    -o "$build_dir/cosmos_ftl_gc.arm.o"

echo "cosmos FTL GC ARM compile: PASS"
