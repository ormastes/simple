#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
test_source="$root/test/02_integration/os/cosmos/cosmos_nvme_admin_queue_binding_test.c"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-admin-queue.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

common_flags='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2'

cc $common_flags -Wno-int-to-pointer-cast -I"$source_dir" "$test_source" \
    "$source_dir/cosmos_nvme_admin.c" \
    -o "$build_dir/cosmos_nvme_admin_queue_binding_test"
"$build_dir/cosmos_nvme_admin_queue_binding_test"

clang --target=armv7-none-eabi -mcpu=cortex-a9 -marm \
    -ffreestanding -nostdlib -fno-builtin $common_flags \
    -I"$source_dir" -c "$source_dir/cosmos_nvme_admin.c" \
    -o "$build_dir/cosmos_nvme_admin_queue.arm.o"

echo "cosmos NVMe admin queue ARM compile: PASS"
