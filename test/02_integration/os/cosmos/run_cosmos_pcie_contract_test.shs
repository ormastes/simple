#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
test_source="$root/test/02_integration/os/cosmos/cosmos_pcie_contract_test.c"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-pcie-contract.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

cc \
    -std=c11 -O2 -g \
    -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2 \
    -DCOSMOS_SILICON=1 \
    -DCOSMOS_MMIO_TEST=1 \
    -DCOSMOS_POLL_LIMIT=4U \
    -DCOSMOS_PCIE_BITSTREAM_CONTRACT=0x030000U \
    -include "$source_dir/cosmos_profile_openssd2_8ch8way_v300.h" \
    -I"$source_dir" \
    "$test_source" \
    "$source_dir/cosmos_pcie.c" \
    -o "$build_dir/cosmos_pcie_contract_test"

"$build_dir/cosmos_pcie_contract_test"
