use os.kernel.arch.arm32.cosmos.cosmos_nvme_pcie_policy.{
    cosmos_nvme_pcie_policy_status_fields_valid,
    cosmos_nvme_pcie_policy_status_word,
    cosmos_nvme_pcie_policy_io_sq_valid,
    cosmos_nvme_pcie_policy_io_sq_word1,
    cosmos_nvme_pcie_policy_io_cq_valid,
    cosmos_nvme_pcie_policy_io_cq_word1
}

val status_values = [0u32, 1u32, 7u32, 8u32, 255u32, 256u32]
val ids = [0u32, 1u32, 8u32, 9u32]
val flags = [0u32, 1u32, 2u32]
val entries_values = [0u32, 1u32, 256u32, 257u32]
val lows = [0u32, 0x1000u32, 0x1004u32]
val highs = [0u32, 15u32, 16u32]
val irq_vectors = [0u32, 1u32, 7u32]

for sct in status_values:
    for sc in status_values:
        for dnr in flags:
            print("P|status|{sct}|{sc}|{dnr}|{cosmos_nvme_pcie_policy_status_fields_valid(sct, sc, dnr)}|{cosmos_nvme_pcie_policy_status_word(sct, sc, dnr)}")

for queue_id in ids:
    for valid in flags:
        for completion_queue_id in ids:
            for entries in entries_values:
                for low in lows:
                    for high in highs:
                        print("P|sq|{queue_id}|{valid}|{completion_queue_id}|{entries}|{low}|{high}|{cosmos_nvme_pcie_policy_io_sq_valid(queue_id, valid, completion_queue_id, entries, low, high)}|{cosmos_nvme_pcie_policy_io_sq_word1(valid, completion_queue_id, entries, high)}")

for queue_id in ids:
    for valid in flags:
        for irq_enable in flags:
            for irq_vector in irq_vectors:
                for entries in entries_values:
                    for low in lows:
                        for high in highs:
                            print("P|cq|{queue_id}|{valid}|{irq_enable}|{irq_vector}|{entries}|{low}|{high}|{cosmos_nvme_pcie_policy_io_cq_valid(queue_id, valid, irq_enable, irq_vector, entries, low, high)}|{cosmos_nvme_pcie_policy_io_cq_word1(valid, irq_enable, irq_vector, entries, high)}")
