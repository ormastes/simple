#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
test_source="$root/test/02_integration/os/cosmos/cosmos_ftl_nfc_backend_test.c"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-ftl-nfc-io.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

common='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2'
flags='-DCOSMOS_FTL_NFC_METADATA_PAGE_LIMIT=1024U -DCOSMOS_FTL_NFC_IO_FAIL_CLOSED_TEST=1'

cc $common -Wno-int-to-pointer-cast -Wno-unused-function \
    -DCOSMOS_MMIO_TEST=1 $flags -no-pie -I"$source_dir" \
    "$test_source" "$source_dir/cosmos_ftl_nfc_backend.c" \
    "$source_dir/cosmos_ftl.c" "$source_dir/cosmos_nfc.c" \
    -o "$build_dir/cosmos_ftl_nfc_io_fail_closed_test"
"$build_dir/cosmos_ftl_nfc_io_fail_closed_test"

clang --target=armv7-none-eabi -mcpu=cortex-a9 -marm \
    -ffreestanding -nostdlib -fno-builtin $common \
    -DCOSMOS_SILICON=1 $flags \
    -include "$source_dir/cosmos_profile_openssd2_8ch8way_v300.h" \
    -I"$source_dir" -c "$source_dir/cosmos_ftl_nfc_backend.c" \
    -o "$build_dir/cosmos_ftl_nfc_io_fail_closed.arm.o"

echo "cosmos FTL NFC IO fail-closed ARM compile: PASS"
