#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
cd "$root"

fail() {
    echo "FAIL: $1" >&2
    exit 1
}
digest_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        echo "FAIL: no SHA-256 tool is available" >&2
        return 1
    fi
}

SIMPLE_BINARY=${SIMPLE_BINARY:-}
[ -n "$SIMPLE_BINARY" ] ||
    fail "SIMPLE_BINARY must name a provenance-admitted Stage-4 compiler"
[ -x "$SIMPLE_BINARY" ] || fail "missing Pure Simple compiler: $SIMPLE_BINARY"
case "$SIMPLE_BINARY" in
    *compiler_rust*|*'/bootstrap/'*) fail "Rust/bootstrap seed is forbidden" ;;
esac

BOOTSTRAP_STAGE3_FACADE_PATH="$root/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="$root/scripts/check/lib/stage4-candidate-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"
SIMPLE_BINARY=$(bootstrap_stage3_canonical_file "$SIMPLE_BINARY") ||
    fail "Stage-4 compiler is not canonical"
provenance="${SIMPLE_BINARY}.provenance.env"
stage4_verify_candidate_provenance "$provenance" "$SIMPLE_BINARY" "$root" ||
    fail "Stage-4 compiler provenance is invalid"
export SIMPLE_BINARY
compiler_sha_before=$(digest_file "$SIMPLE_BINARY")

if ! compiler_version=$("$SIMPLE_BINARY" --version 2>&1); then
    fail "compiler identity command failed"
fi
[ -n "$compiler_version" ] || fail "compiler identity is empty"
case "$compiler_version" in
    *"Rust-built"*|*"bootstrap seed only"*|*"debug build"*)
        fail "ARM32 emit-object acceptance requires a Pure Simple compiler"
        ;;
esac

for tool in readelf nm clang ld.lld; do
    command -v "$tool" >/dev/null 2>&1 || fail "missing required tool: $tool"
done

work=$(mktemp -d "${TMPDIR:-/tmp}/simple-arm32-emit-object.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
object="$work/cosmos_fsbl_candidate.o"
combined="$work/cosmos_fsbl_candidate_linked.o"
log="$work/native-build.log"

SIMPLE_NO_STUB_FALLBACK=1 "$SIMPLE_BINARY" native-build --backend llvm \
    --source src \
    --entry src/os/kernel/arch/arm32/cosmos/cosmos_fsbl.spl \
    --entry-closure --target armv7-unknown-none-eabihf --emit-object \
    --cache-dir "$work/cache" -o "$object" >"$log" 2>&1

! grep -Eiq "unknown option.*emit-object|ignoring.*emit-object" "$log" ||
    fail "compiler ignored --emit-object"
header=$(LC_ALL=C readelf -hW "$object")
printf '%s\n' "$header" | grep -Eq 'Class:[[:space:]]+ELF32'
printf '%s\n' "$header" | grep -Eq 'Type:[[:space:]]+REL([[:space:]]|$)'
printf '%s\n' "$header" | grep -Eq 'Machine:[[:space:]]+ARM([[:space:]]|$)'
printf '%s\n' "$header" | grep -Eq 'Flags:.*hard-float ABI'
sections=$(LC_ALL=C readelf -SW "$object")
printf '%s\n' "$sections" | grep -Eq '\.text([.[:space:]]|$)'
printf '%s\n' "$sections" | grep -Eq '\.symtab([[:space:]]|$)'
printf '%s\n' "$sections" | grep -Eq '\.strtab([[:space:]]|$)'
for symbol in cosmos_fsbl_validate_handoff cosmos_fsbl_selftest; do
    readelf -Ws "$object" |
        grep -Eq "FUNC[[:space:]]+GLOBAL[[:space:]]+DEFAULT[[:space:]]+[1-9][0-9]*[[:space:]]+$symbol$" ||
        fail "missing exported function: $symbol"
done
candidate_undefined=$(nm -u "$object" | awk '{print $NF}' | LC_ALL=C sort)
if printf '%s\n' "$candidate_undefined" | grep -Fq '__aeabi_unwind_cpp_pr0'; then
    fail "ARM32 object retains __aeabi_unwind_cpp_pr0"
fi
expected_candidate_undefined=$(printf '%s\n' \
    cosmos_fsbl_mmio_read32 cosmos_fsbl_platform_is_qemu | LC_ALL=C sort)
[ "$candidate_undefined" = "$expected_candidate_undefined" ] ||
    fail "candidate object undefined ABI contract mismatch: $candidate_undefined"
for symbol in cosmos_fsbl_mmio_read32 cosmos_fsbl_platform_is_qemu; do
    readelf -rW "$object" | grep -Fq "$symbol" ||
        fail "missing candidate ABI-shim relocation: $symbol"
done

printf '%s\n' \
    'extern int cosmos_fsbl_validate_handoff(void);' \
    'extern int cosmos_fsbl_selftest(void);' \
    'unsigned cosmos_fsbl_mmio_read32(unsigned address) { return address; }' \
    'int cosmos_fsbl_platform_is_qemu(void) { return 1; }' \
    'int cosmos_object_consumer(void) {' \
    '    return cosmos_fsbl_validate_handoff() + cosmos_fsbl_selftest();' \
    '}' >"$work/consumer.c"
clang --target=armv7-unknown-none-eabihf -mcpu=cortex-a9 -marm \
    -ffreestanding -nostdlib -fno-builtin -c "$work/consumer.c" \
    -o "$work/consumer.o"
for symbol in cosmos_fsbl_validate_handoff cosmos_fsbl_selftest; do
    readelf -rW "$work/consumer.o" | grep -Fq "$symbol" ||
        fail "missing consumer relocation: $symbol"
done
ld.lld -r "$object" "$work/consumer.o" -o "$combined"
combined_header=$(LC_ALL=C readelf -hW "$combined")
printf '%s\n' "$combined_header" | grep -Eq 'Type:[[:space:]]+REL([[:space:]]|$)'
printf '%s\n' "$combined_header" | grep -Eq 'Machine:[[:space:]]+ARM([[:space:]]|$)'
for symbol in cosmos_fsbl_validate_handoff cosmos_fsbl_selftest; do
    nm "$combined" | grep -Eq "[[:space:]]T[[:space:]]+$symbol$" ||
        fail "combined object lost export: $symbol"
done
undefined=$(nm -u "$combined" || true)
[ -z "$undefined" ] || fail "combined Cosmos object retains undefined symbols: $undefined"
[ "$(digest_file "$SIMPLE_BINARY")" = "$compiler_sha_before" ] ||
    fail "compiler changed during acceptance"

echo "Pure Simple ARM32 FSBL candidate emit-object Cosmos link: PASS"
