use os.kernel.arch.arm32.cosmos.cosmos_smp_gic_policy.*

val unary_inputs: [u32] = [
    0u32, 1u32, 15u32, 16u32, 31u32, 32u32, 33u32, 61u32,
    1019u32, 1020u32, 1023u32, 0xFFFFFFFFu32
]

cosmos_smp_gic_policy_coverage_reset()

for x in unary_inputs:
    print("P|limit|{x}|{cosmos_gic_limit_words(x)}")
    print("P|typer|{x}|{cosmos_gic_words_from_typer(x)}")
    print("P|target|{x}|{cosmos_gic_target_for_word(x)}")
    print("P|generation|{x}|{cosmos_smp_next_generation(x)}")
    print("P|ready|{x}|{cosmos_smp_ready_observed(x)}")
    print("P|poll|{x}|{cosmos_smp_poll_allowed(x)}")
    print("P|irq-id|{x}|{cosmos_gic_irq_id(x)}")
    print("P|spurious|{x}|{cosmos_gic_irq_is_spurious(x)}")
    print("P|disable-offset|{x}|{cosmos_gic_disable_offset(x)}")
    print("P|disable-mask|{x}|{cosmos_gic_disable_mask(x)}")
    print("P|byte-shift|{x}|{cosmos_gic_byte_shift(x)}")
    print("P|config-shift|{x}|{cosmos_gic_config_shift(x)}")
    print("P|priority-offset|{x}|{cosmos_gic_priority_offset(x)}")
    print("P|target-offset|{x}|{cosmos_gic_target_offset(x)}")
    print("P|config-offset|{x}|{cosmos_gic_config_offset(x)}")
    print("P|pcie-range|{x}|{cosmos_gic_pcie_irq_in_range(x)}")
    print("P|eoir|{x}|{cosmos_gic_eoir_required(x)}")

val results: [i32] = [-1, 0, 1, 4]
for result in results:
    print("P|secondary|{result}|{cosmos_smp_secondary_state(result)}")

val release_cpu: [u32] = [0u32, 1u32, 0u32, 0u32, 0u32, 0u32]
val release_entry: [u32] = [0x00100000u32, 0x00100000u32, 0u32, 0x00100000u32, 0x00100002u32, 0x00100000u32]
val release_stack: [u32] = [0x00200000u32, 0x00200000u32, 0x00200000u32, 0u32, 0x00200000u32, 0x00200004u32]
for i in 0..release_cpu.len():
    val cpu = release_cpu[i]
    val entry = release_entry[i]
    val stack = release_stack[i]
    print("P|release|{cpu}|{entry}|{stack}|{cosmos_smp_release_request_valid(cpu, entry, stack)}")

val ack_state: [u32] = [3u32, 2u32, 3u32, 3u32]
val ack_value: [u32] = [41u32, 41u32, 40u32, 0xFFFFFFFFu32]
val ack_generation: [u32] = [41u32, 41u32, 41u32, 0xFFFFFFFFu32]
for i in 0..ack_state.len():
    val state = ack_state[i]
    val ack = ack_value[i]
    val generation = ack_generation[i]
    print("P|ack|{state}|{ack}|{generation}|{cosmos_smp_ack_observed(state, ack, generation)}")

val currents: [u32] = [0u32, 0u32, 0xFFFFFFFFu32, 0x12345678u32]
val interrupts: [u32] = [0u32, 61u32, 61u32, 1023u32]
for i in 0..currents.len():
    val current = currents[i]
    val interrupt_id = interrupts[i]
    print("P|priority-value|{current}|{interrupt_id}|{cosmos_gic_priority_value(current, interrupt_id)}")
    print("P|target-value|{current}|{interrupt_id}|{cosmos_gic_target_cpu0_value(current, interrupt_id)}")
    print("P|config-value|{current}|{interrupt_id}|{cosmos_gic_level_config_value(current, interrupt_id)}")

val quiesce_interrupts: [u32] = [61u32, 61u32, 7u32, 1020u32]
val quiesce_results: [i32] = [0, 1, 4, 4]
for i in 0..quiesce_interrupts.len():
    val interrupt_id = quiesce_interrupts[i]
    val result = quiesce_results[i]
    print("P|quiesce|{interrupt_id}|{result}|{cosmos_gic_quiesce_kind(interrupt_id, result)}")

print("COVERAGE|{cosmos_smp_gic_policy_coverage_mask()}|{cosmos_smp_gic_policy_coverage_required()}|{cosmos_smp_gic_policy_coverage_decisions()}")
