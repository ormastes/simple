#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
test_dir="$root/test/02_integration/os/cosmos"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-nvme-prp.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

common_flags='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2 -Wno-unused-function'

cc $common_flags -ffunction-sections -fdata-sections \
    -DCOSMOS_MMIO_TEST=1 -DCOSMOS_NVME_PRP_CONTROL_ONLY=1 \
    -I"$source_dir" \
    "$test_dir/cosmos_nvme_pcie_adapter_contract_test.c" \
    "$source_dir/cosmos_nvme_pcie_adapter.c" \
    -Wl,--gc-sections -o "$build_dir/cosmos_nvme_prp_test"
"$build_dir/cosmos_nvme_prp_test"

cc $common_flags -DCOSMOS_MMIO_TEST=1 -DCOSMOS_NVME_FUA_ONLY=1 \
    -I"$source_dir" \
    "$test_dir/cosmos_nvme_firmware_contract_test.c" \
    "$source_dir/cosmos_nvme_firmware.c" \
    -o "$build_dir/cosmos_nvme_fua_test"
"$build_dir/cosmos_nvme_fua_test"

for source in \
    cosmos_nvme_admin_contract_test.c \
    cosmos_nvme_admin_queue_binding_test.c \
    cosmos_nvme_dispatch_contract_test.c \
    cosmos_nvme_firmware_contract_test.c \
    cosmos_nvme_pcie_adapter_contract_test.c
do
    cc $common_flags -DCOSMOS_MMIO_TEST=1 -I"$source_dir" \
        -fsyntax-only "$test_dir/$source"
done

for source in \
    cosmos_nvme_admin.c \
    cosmos_nvme_firmware.c \
    cosmos_nvme_pcie_adapter.c
do
    clang --target=armv7-none-eabi -mcpu=cortex-a9 -marm \
        -ffreestanding -nostdlib -fno-builtin $common_flags \
        -I"$source_dir" -c "$source_dir/$source" \
        -o "$build_dir/$source.arm.o"
done

echo "cosmos NVMe PRP/control ARM compile: PASS"
