# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.*
use os.kernel.memory.memory_leveling_runtime.{memory_leveling_runtime_reset_for_test, memory_leveling_runtime_register_cpu_range, memory_leveling_runtime_register_dma, memory_leveling_runtime_unregister_dma, memory_leveling_runtime_dma_sync_for_device, memory_leveling_runtime_dma_sync_for_cpu, memory_leveling_runtime_manager, memory_leveling_runtime_mapping, memory_leveling_runtime_replace_manager}
use os.kernel.boot.mmio.{mmio_reset_for_test}
use os.kernel.memory.pmm.{pmm_init_identity_range, pmm_alloc_pages}

describe "SimpleOS DMA memory-leveling runtime":
    # @manual scenario evidence

    it "tracks an allocation through ordered device ownership":
        # @req REQ-SSPEC-INTEGRATION
        step("tracks an allocation through ordered device ownership")
        memory_leveling_runtime_reset_for_test()
        expect(memory_leveling_runtime_register_dma(42, 7, 0x70000000, pages.addr, 4096, true).ok).to_equal(true)
        expect(memory_leveling_runtime_mapping(42).unwrap().virt_addr).to_equal(0x70000000)
        expect(memory_leveling_runtime_dma_sync_for_device(42, 7).ok).to_equal(true)
        var manager = memory_leveling_runtime_manager()
        expect(manager.get(42).unwrap().state.name).to_equal("device_owned")
        expect(manager.get(42).unwrap().in_flight_count).to_equal(1)
        memory_leveling_runtime_replace_manager(manager)

        expect(memory_leveling_runtime_dma_sync_for_cpu(42, 7).ok).to_equal(true)
        manager = memory_leveling_runtime_manager()
        expect(manager.get(42).unwrap().state.name).to_equal("cpu_owned")
        expect(manager.get(42).unwrap().mapping_count).to_equal(0)
        memory_leveling_runtime_replace_manager(manager)
        expect(memory_leveling_runtime_unregister_dma(42, 7).ok).to_equal(true)

    it "rejects non-coherent DMA without a cache-maintenance owner":
        # @req REQ-SSPEC-INTEGRATION
        step("rejects non-coherent DMA without a cache-maintenance owner")
        memory_leveling_runtime_reset_for_test()
        expect(memory_leveling_runtime_register_dma(43, 7, 0x70001000, 0x201000, 4096, false).reason).to_equal("coherency-unproven")

    it "allocates CPU and DMA identifiers from one manager sequence":
        # @req REQ-SSPEC-INTEGRATION
        step("allocates CPU and DMA identifiers from one manager sequence")
        memory_leveling_runtime_reset_for_test()
        val cpu = memory_leveling_runtime_register_cpu_range(0x60000000, 4096, 7)
        val dma = memory_leveling_runtime_register_dma(0, 7, 0x70002000, pages.addr, 4096, true)

        expect(cpu.ok).to_equal(true)
        expect(dma.ok).to_equal(true)
        expect(dma.allocation_ids[0]).to_not_equal(cpu.allocation_ids[0])
