# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# SVM-G conformance vector suite (Task D3).
#
# Drives the data table in test/fixtures/svmg/conformance_vectors.spl (D1's
# `svmg_asm` assembler) against D2's host reference VM (`SvmgVm` / `run` /
# `assemble_and_run`). One `it` per vector so a regression names the exact
# failing vector rather than a bulk "N/M vectors failed" count; a shared
# `_check_vector` helper keeps each `it` body to a single line.
#
# doc/03_plan/agent_tasks/gpu_remote_interpreter_parallel_plan_2026-08-07.md
# §5 (Task D3): ">=40 vectors covering every opcode, both trap kinds, budget
# exhaustion, PARFOR, and the design §4.4 lowered-subset patterns" -- see
# the coverage `it` at the bottom for the machine-checked version of that
# claim.

use std.spec.step

use std.spipe.*
use std.common.svmg.assembler.{svmg_asm}
use std.common.svmg.opcodes.{all_mnemonics}
use std.common.svmg.ref_vm.{assemble_and_run, read_log, read_records}
use test.fixtures.svmg.conformance_vectors.{ConformanceVector, all_vectors}

fn _find(name: text) -> ConformanceVector:
    for vec in all_vectors():
        if vec.name == name:
            return vec
    panic("svmg conformance: no vector named '{name}'")

fn _check_vector(v: ConformanceVector):
    val bytes = svmg_asm(v.source)
    val result = assemble_and_run(bytes, v.step_budget, v.entry_pc)
    assert_equal(result.trapped, v.expected_trapped)
    assert_equal(result.timed_out, v.expected_timed_out)
    assert_equal(result.sentinel, v.expected_sentinel)
    assert_equal(read_log(result.arena, result.log_cap), v.expected_log)
    assert_equal(result.record_count, v.expected_records.len())
    val records = read_records(result.arena, result.log_cap, result.record_count)
    var j = 0
    while j < v.expected_records.len():
        assert_equal(records[j].passed, v.expected_records[j].passed)
        assert_equal(records[j].value, v.expected_records[j].value)
        j = j + 1

fn _check(name: text):
    _check_vector(_find(name))

describe "svmg conformance (Task D3) — control / misc":
    # @manual scenario evidence
    it "NOP is a no-op that falls through to the next instruction":
        # @req REQ-SSPEC-INTEGRATION
        step("NOP is a no-op that falls through to the next instruction")
        _check("nop_passthrough")
    it "HALT writes the exit sentinel with its immediate code and no records":
        # @req REQ-SSPEC-INTEGRATION
        step("HALT writes the exit sentinel with its immediate code and no records")
        _check("halt_with_code")
    it "explicit TRAP opcode writes its immediate code as the trap value":
        # @req REQ-SSPEC-INTEGRATION
        step("explicit TRAP opcode writes its immediate code as the trap value")
        _check("trap_explicit")

