#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
script="$root/scripts/check/check-freebsd-bootstrap-qemu.shs"

grep -Fqx 'QEMU_RUNTIME_DIR="${QEMU_RUNTIME_DIR:-${VM_DIR}}"' "$script"
grep -Fqx 'PID_FILE="${QEMU_PID_FILE:-${QEMU_RUNTIME_DIR}/qemu.pid}"' "$script"
grep -Fqx 'SERIAL_LOG="${QEMU_SERIAL_LOG:-${QEMU_RUNTIME_DIR}/qemu-serial.log}"' "$script"
grep -Fqx 'QEMU_START_LOG="${QEMU_START_LOG:-${QEMU_RUNTIME_DIR}/qemu-start.log}"' "$script"
grep -Fqx 'OVERLAY_IMAGE="${QEMU_OVERLAY_IMAGE:-${QEMU_RUNTIME_DIR}/freebsd-run.overlay.qcow2}"' "$script"
grep -Fqx 'CLOUDINIT_DIR="${QEMU_CLOUDINIT_DIR:-${QEMU_RUNTIME_DIR}/cloudinit.tmp}"' "$script"

grep -Fq 'mkdir -p "$VM_DIR" "$QEMU_RUNTIME_DIR"' "$script"
grep -Fq '"$(dirname "$OVERLAY_IMAGE")"' "$script"
grep -Fq '"$(dirname "$SERIAL_LOG")"' "$script"
grep -Fq '"$(dirname "$QEMU_START_LOG")"' "$script"
grep -Fq '"$(dirname "$PID_FILE")"' "$script"

echo "freebsd_bootstrap_qemu_isolation_contract=true"
