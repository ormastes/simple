# Deliberate child-only fault injection; never loaded in the parent.
use std.sffi.cli.{cli_get_args}
use std.nogc_sync_mut.io.file_ops.{file_write}

@unsafe(reason: "test child raises an actual unhandled Win32 exception", capabilities: [ffi])
extern fn RaiseException(code: u32, flags: u32, count: u32, arguments: i64)

fn main() -> i64:
    val args = cli_get_args()
    if args.len() != 3: return 80
    if args[1] == "crash":
        unsafe(capabilities: [ffi]):
            RaiseException(3221225477u32, 1u32, 0u32, 0)
        return 81
    if args[1] == "assertion":
        if not file_write(args[2], "simple-bdd-v1\n0\n1\n"): return 82
        print "Results: 0 passed, 1 failed"
        return 1
    if args[1] == "pass":
        if not file_write(args[2], "simple-bdd-v1\n1\n0\n"): return 83
        print "Results: 1 passed, 0 failed"
        return 0
    84
