# @req CONTROLLER-LINUX-STORAGE-01
# P2 #18 live scenario. AUTHORED, NOT_RUN. BLOCKED: needs SIMPLE_LINUX_CONTROLLER_SWAP_ROOT, a disposable 0700 private root
# provisioned out of band plus a second 0700 root with a `journal` child, and a process that can rename the two between
# reader admit and journal open. No such fixture exists on the authoring host (B-10 precedent: env-gated, recorded pending).
use std.spec.{describe, it, pending}
use std.nogc_sync_mut.io.env_ops.{host_os, env_get}

describe "Linux controller journal parent identity pin (live)":
    it "refuses a private root swapped between reader admit and journal open":
        val root = env_get("SIMPLE_LINUX_CONTROLLER_SWAP_ROOT") ?? ""
        if host_os() != "linux" or root == "":
            pending("BLOCKED: SIMPLE_LINUX_CONTROLLER_SWAP_ROOT fixture unavailable")
        else:
            pending("BLOCKED: rename-between-admit-and-open harness not authored; needs a live runner")
