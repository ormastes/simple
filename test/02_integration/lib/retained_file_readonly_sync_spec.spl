# Requires an independently provisioned regular-file fixture. A readonly
# retained descriptor must reach the real Linux fsync, without a path reopen.
use std.spec
use std.nogc_sync_mut.io.env_ops.{host_os, env_get}
use std.nogc_sync_mut.io.retained_file.{retained_file_open, retained_file_sync}

describe "Linux retained readonly file synchronization":
    it "REQ-RETAINED-SYNC-001 synchronizes the exact readonly regular-file owner":
        expect(host_os()).to_equal("linux")
        val path = env_get("SIMPLE_RETAINED_READONLY_SYNC_FIXTURE") ?? ""
        expect(path != "").to_equal(true)
        match retained_file_open(path, 8388608u64):
            case Err(error):
                expect(error).to_equal("")
            case Ok(owner):
                var file = owner
                expect(retained_file_sync(file)).to_equal(true)
                expect(file.close()).to_equal(true)
                expect(retained_file_sync(file)).to_equal(false)
