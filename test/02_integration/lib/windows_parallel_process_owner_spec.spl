use std.spec
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.file_ops.{file_exists}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}

describe "Windows redirected parallel process ownership":
    it "REQ-WIN-PAR-001 through REQ-WIN-PAR-006 execute real owned native children":
        val probe = env_get("SIMPLE_WINDOWS_PARALLEL_OWNER_PROBE_EXE")
        expect(probe != "" and file_exists(probe)).to_equal(true)
        val (output, error, code) = process_run_bounded(probe, [], 1800000, 1048576)
        expect(code).to_equal(0)
        expect(output).to_contain("wave=0 simultaneously_live=80 requested=80")
        expect(output).to_contain("wave=1 simultaneously_live=80 requested=80")
        expect(output).to_contain("lifetime_completed=1025 previous_bound=1024")
        expect(output).to_contain("parent_peak_rss_kib=")
        expect(output).to_contain("0 failed")
        expect(output).to_contain("Results:")
