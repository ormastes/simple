# Native bootstrap regression for the synchronous database statistics path.
# @req: REQ-DATABASE-StatsFunctions-001

use nogc_sync_mut.database.stats.{calculate_std_dev}

fn main() -> i64:
    if calculate_std_dev([-1.0, 0.0, 1.0], 0.0) != 1.0:
        return 1
    val sqrt_two = calculate_std_dev([0.0, 2.0], 1.0)
    if sqrt_two < 1.4142 or sqrt_two > 1.4143:
        return 2
    0
