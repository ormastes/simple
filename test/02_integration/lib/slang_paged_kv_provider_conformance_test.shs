#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)"
OUT="$(mktemp -d)"
trap 'rm -rf "$OUT"' EXIT

cc -std=c11 -Wall -Wextra -Werror \
  -fsanitize=address,undefined -fno-omit-frame-pointer \
  -I"$ROOT/src/runtime" \
  -I"$ROOT/test/fixtures/slang_paged_kv_provider" \
  "$ROOT/test/fixtures/slang_paged_kv_provider/provider_fixture.c" \
  "$ROOT/test/fixtures/slang_paged_kv_provider/provider_conformance_test.c" \
  -o "$OUT/provider-conformance"

ASAN_OPTIONS=detect_leaks=1 "$OUT/provider-conformance"
echo "STATUS: PASS slang-paged-kv-provider-conformance"
