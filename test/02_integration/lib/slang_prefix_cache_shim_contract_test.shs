#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)"
OUT="$(mktemp -d)"
trap 'rm -rf "$OUT"' EXIT
cc -std=c11 -Wall -Wextra -Werror \
  -I"$ROOT/test/fixtures/slang_prefix_cache" \
  "$ROOT/src/runtime/slang_ggml_shim.c" \
  "$ROOT/test/fixtures/slang_prefix_cache/mock_llama.c" \
  "$ROOT/test/fixtures/slang_prefix_cache/prefix_cache_test.c" \
  -o "$OUT/prefix-cache-test"
"$OUT/prefix-cache-test"
echo "STATUS: PASS slang-prefix-cache-shim"
