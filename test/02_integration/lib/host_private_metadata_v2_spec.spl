# NOT_RUN: real Windows native privacy is required. Missing installed fixture
# roots fail; there is no skip, POSIX mode substitute, or scripted provider.
use std.spec
use std.nogc_sync_mut.orchestration.host_private_metadata_v2.*
use std.nogc_sync_mut.orchestration.host_service_private_receipt_v2.*
use std.nogc_sync_mut.io.windows_private_file_v1.*
use std.nogc_sync_mut.io.env_ops.{host_os, env_get}
use std.nogc_sync_mut.sosix.entropy.sosix_random_hex
use test.fixtures.orchestration.host_private_metadata_v2.*

fn metadata_fixture_error_v2(error: WindowsPrivateErrorV1, prior: HostServicePrivateCleanupV2):
    var cleanup = prior
    if error.cleanup_file.is_some(): cleanup.files.push(error.cleanup_file.unwrap())
    if error.cleanup_root.is_some(): cleanup.roots.push(error.cleanup_root.unwrap())
    assert(host_service_private_cleanup_v2(cleanup).is_none())
    fail("native metadata fixture admission failed: " + error.message)

fn metadata_fixture_install_v2(count: i64) -> Result<text, text>:
    expect(host_os()).to_equal("windows")
    val parent = env_get("SIMPLE_HOST_METADATA_PRIVATE_PARENT") ?? ""
    if parent == "": return Err("independently installed native private fixture parent required")
    val admitted = windows_private_root_open_v1(parent)
    if admitted.is_err():
        metadata_fixture_error_v2(admitted.unwrap_err(), HostServicePrivateCleanupV2(files: [], roots: []))
        return Err("native fixture parent rejected")
    var root = admitted.unwrap()
    val name = "host-metadata-" + sosix_random_hex(16).unwrap()
    val created = root.child_directory(name, true)
    if created.is_err():
        metadata_fixture_error_v2(created.unwrap_err(), HostServicePrivateCleanupV2(files: [], roots: [root]))
        return Err("native fixture child rejected")
    var directory = created.unwrap()
    val bytes = host_private_metadata_fixture_bytes_v2()
    val names = ["authority-policy.sdn", "host-config.sdn", "engine-policy.sdn", "broker-policy.sdn"]
    for index in 0..count:
        val output = directory.create_private_stage("install-" + index.to_text(), 1048576u64)
        if output.is_err():
            metadata_fixture_error_v2(output.unwrap_err(), HostServicePrivateCleanupV2(files: [], roots: [root, directory]))
            return Err("native fixture stage rejected")
        var stage = output.unwrap()
        assert(stage.write(bytes[index]).unwrap())
        assert(stage.seal().unwrap())
        expect(directory.publish_no_replace(stage, names[index])).to_equal(Ok(true))
        assert(stage.close())
    assert(directory.security_current())
    assert(directory.close())
    assert(root.close())
    Ok(parent + "/" + name)

fn metadata_fixture_open_v2(path: text, pins: HostPrivateMetadataPinsV2) -> Result<HostPrivateMetadataOwnerV2, text>:
    match host_private_metadata_open_v2(path, pins):
        case HostPrivateMetadataOpenV2.Ready(owner): return Ok(owner)
        case HostPrivateMetadataOpenV2.Rejected(error): return Err(error)
        case HostPrivateMetadataOpenV2.CleanupRequired(cleanup, error):
            assert(host_service_private_cleanup_v2(cleanup).is_none())
            return Err(error)
    Err("metadata fixture open did not return")

fn metadata_fixture_refused_v2(path: text, pins: HostPrivateMetadataPinsV2) -> text:
    match host_private_metadata_open_v2(path, pins):
        case HostPrivateMetadataOpenV2.Ready(owner):
            assert(host_private_metadata_close_v2(owner).is_none())
            fail("unqualified metadata admitted")
        case HostPrivateMetadataOpenV2.Rejected(error): return error
        case HostPrivateMetadataOpenV2.CleanupRequired(cleanup, error):
            assert(host_service_private_cleanup_v2(cleanup).is_none())
            return error
    "unexpected metadata fixture result"

describe "Installed metadata through real native Windows private owners":
    it "reads and refreshes four exact retained generations without claiming service readiness":
        val path = metadata_fixture_install_v2(4).unwrap()
        val bytes = host_private_metadata_fixture_bytes_v2()
        val pins = host_private_metadata_fixture_pins_v2(bytes)
        val owner = metadata_fixture_open_v2(path, pins).unwrap()
        expect(owner.files.len()).to_equal(4)
        assert(owner.root.security_current())
        expect(owner.metadata.policy.source_digest).to_equal(pins.policy_digest)
        val refreshed = host_private_metadata_refresh_v2(owner)
        expect(refreshed.error).to_equal("")
        assert(refreshed.cleanup.is_none())
        assert(refreshed.owner.is_some())
        expect(refreshed.metadata.unwrap().configuration.physical_host_id).to_equal("machine")
        assert(host_private_metadata_close_v2(refreshed.owner.unwrap()).is_none())
        # Reopen only after deliberately draining the old file generations.
        val reopened = metadata_fixture_open_v2(path, pins).unwrap()
        assert(host_private_metadata_close_v2(reopened).is_none())

    it "closes every admitted file and root after an exact digest mismatch":
        val path = metadata_fixture_install_v2(4).unwrap()
        val bytes = host_private_metadata_fixture_bytes_v2()
        val pins = host_private_metadata_fixture_pins_v2(bytes)
        var wrong = pins
        wrong.broker_policy_digest = "a".repeat(64)
        expect(metadata_fixture_refused_v2(path, wrong)).to_equal(
            "host-private-metadata-digest-mismatch:broker-policy.sdn")
        val actual = metadata_fixture_open_v2(path, pins).unwrap()
        assert(host_private_metadata_close_v2(actual).is_none())

    it "releases the first three admitted file generations when the fourth file is missing":
        val path = metadata_fixture_install_v2(3).unwrap()
        val bytes = host_private_metadata_fixture_bytes_v2()
        val pins = host_private_metadata_fixture_pins_v2(bytes)
        expect(metadata_fixture_refused_v2(path, pins)).to_equal("WINDOWS_PRIVATE_FILE_OPEN")
        var root = windows_private_root_open_v1(path).unwrap()
        var first = root.open_private_file("authority-policy.sdn", 1048576u64).unwrap()
        expect(first.read_all_bounded(1048576).unwrap()).to_equal(bytes[0])
        assert(first.close())
        assert(root.close())

    it "invalidates canonical read authority on refresh failure and returns no stale metadata":
        val path = metadata_fixture_install_v2(4).unwrap()
        val bytes = host_private_metadata_fixture_bytes_v2()
        val pins = host_private_metadata_fixture_pins_v2(bytes)
        var owner = metadata_fixture_open_v2(path, pins).unwrap()
        var stale_file = owner.files[0]
        owner.pins.engine_policy_digest = "a".repeat(64)
        val refused = host_private_metadata_refresh_v2(owner)
        expect(refused.error).to_equal("host-private-metadata-digest-mismatch:engine-policy.sdn")
        assert(refused.owner.is_none())
        assert(refused.metadata.is_none())
        if refused.cleanup.is_some():
            assert(host_service_private_cleanup_v2(refused.cleanup.unwrap()).is_none())
        assert(stale_file.read_all_bounded(1048576).is_err())
        assert(not owner.root.security_current())
        val reopened = metadata_fixture_open_v2(path, pins).unwrap()
        assert(host_private_metadata_close_v2(reopened).is_none())

    it "refuses an independently provisioned foreign-readable root through native ACL admission":
        expect(host_os()).to_equal("windows")
        val path = env_get("SIMPLE_WINDOWS_PRIVATE_FOREIGN_READ_ROOT") ?? ""
        assert(path != "")
        val bytes = host_private_metadata_fixture_bytes_v2()
        val error = metadata_fixture_refused_v2(path, host_private_metadata_fixture_pins_v2(bytes))
        assert(error != "")
