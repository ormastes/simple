# Native Windows qualification only. Unsupported hosts fail explicitly.
use std.spec
use app.io.cli_ops.{cli_kernel_executable_path}
use std.nogc_sync_mut.io.windows_image_owner.{windows_image_path, windows_image_path_with_capacity}
use std.nogc_sync_mut.io.env_ops.{host_os, env_get}
use std.nogc_sync_mut.io.file_ops.{file_exists}

describe "native Windows current-image identity":
    it "REQ-WIN-IMAGE-003 matches an independently recorded host image oracle":
        expect(host_os()).to_equal("windows")
        # Collector records this exact executable path; never derive it from argv.
        val expected = env_get("SIMPLE_WINDOWS_IMAGE_ORACLE") ?? ""
        expect(expected != "").to_equal(true)
        expect(windows_image_path()).to_equal(Ok(expected))
        expect(file_exists(expected)).to_equal(true)
        expect(cli_kernel_executable_path()).to_equal(expected)
    it "REQ-WIN-IMAGE-004 rejects a genuinely truncated kernel buffer":
        expect(host_os()).to_equal("windows")
        val result = unsafe(capabilities: [ffi, raw_ptr]):
            windows_image_path_with_capacity(1)
        expect(result).to_equal(Err("Windows image query failed or truncated"))
