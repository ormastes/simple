# New readonly capability controls, NOT_RUN without actual Windows fixtures.
use std.spec
use std.nogc_sync_mut.io.env_ops.{host_os, env_get}
use std.nogc_sync_mut.io.windows_private_read_v2.*
use std.nogc_sync_mut.io.windows_private_file_v1.{WindowsPrivateFileV1}
use std.common.base_encoding.utilities.{base_encoding_text_to_bytes}

# Keep every live/partial native owner reachable even when expect aborts a
# scenario. A confirmed close clears only its canonical slot; stale local
# copies are never used for another close.
var retained_read_roots_v2: [Option<WindowsPrivateReadRootV2>] = []
var retained_read_files_v2: [Option<WindowsPrivateReadFileV2>] = []

fn retain_read_root_v2(owner: WindowsPrivateReadRootV2) -> i64:
    val index = retained_read_roots_v2.len()
    retained_read_roots_v2.push(Some(owner))
    index

fn retain_read_file_v2(owner: WindowsPrivateReadFileV2) -> i64:
    val index = retained_read_files_v2.len()
    retained_read_files_v2.push(Some(owner))
    index

fn close_read_root_v2(index: i64) -> bool:
    if val owner = retained_read_roots_v2[index]:
        var root = owner
        val closed = root.close()
        if closed: retained_read_roots_v2[index] = None
        return closed
    false

fn close_read_file_v2(index: i64) -> bool:
    if val owner = retained_read_files_v2[index]:
        var file = owner
        val closed = file.close()
        if closed: retained_read_files_v2[index] = None
        return closed
    false

fn cleanup_read_error(error: WindowsPrivateReadErrorV2):
    var file_index = -1
    var root_index = -1
    if val retained = error.cleanup_file: file_index = retain_read_file_v2(retained)
    if val retained = error.cleanup_root: root_index = retain_read_root_v2(retained)
    if file_index >= 0: expect(close_read_file_v2(file_index)).to_equal(true)
    if root_index >= 0: expect(close_read_root_v2(root_index)).to_equal(true)

fn simultaneous_readers(path: text) -> bool:
    match windows_private_read_root_open_v2(path):
        case Err(error):
            cleanup_read_error(error)
            false
        case Ok(owner):
            var root = owner
            val root_index = retain_read_root_v2(root)
            match root.open_file("artifact.sdn", 1024u64):
                case Err(error):
                    cleanup_read_error(error)
                    expect(close_read_root_v2(root_index)).to_equal(true)
                    false
                case Ok(first_owner):
                    var first = first_owner
                    val first_index = retain_read_file_v2(first)
                    match root.open_file("artifact.sdn", 1024u64):
                        case Err(error):
                            cleanup_read_error(error)
                            expect(close_read_file_v2(first_index)).to_equal(true)
                            expect(close_read_root_v2(root_index)).to_equal(true)
                            false
                        case Ok(second_owner):
                            var second = second_owner
                            val second_index = retain_read_file_v2(second)
                            val expected = base_encoding_text_to_bytes("private artifact\n")
                            expect(first.read_all_bounded(1024)).to_equal(Ok(expected))
                            expect(second.read_all_bounded(1024)).to_equal(Ok(expected))
                            var forged = WindowsPrivateFileV1(token: first.token)
                            expect(forged.write([88u8])).to_equal(Err("WINDOWS_PRIVATE_FILE_WRITE"))
                            expect(forged.close()).to_equal(false)
                            expect(first.security_current()).to_equal(true)
                            expect(first.read_all_bounded(1024)).to_equal(Ok(expected))
                            expect(close_read_file_v2(second_index)).to_equal(true)
                            expect(close_read_file_v2(first_index)).to_equal(true)
                            close_read_root_v2(root_index)

describe "Windows private shared readonly capabilities":
    it "REQ-WIN-READ-001 REQ-WIN-READ-002 permits simultaneous readers and refuses forged V1 mutation":
        step("Open independently retained readonly readers and verify native kind boundaries")
        expect(host_os()).to_equal("windows")
        val path = env_get("SIMPLE_WINDOWS_PRIVATE_READ_INSTALLED_ROOT") ?? ""
        expect(path != "").to_equal(true)
        expect(simultaneous_readers(path)).to_equal(true)

    it "REQ-WIN-READ-003 never creates a missing readonly child directory":
        step("Refuse an absent child without creating it and retain cleanup before assertions")
        expect(host_os()).to_equal("windows")
        val path = env_get("SIMPLE_WINDOWS_PRIVATE_READ_INSTALLED_ROOT") ?? ""
        expect(path != "").to_equal(true)
        match windows_private_read_root_open_v2(path):
            case Err(error):
                cleanup_read_error(error)
                expect(error.message).to_equal("")
            case Ok(owner):
                var root = owner
                val root_index = retain_read_root_v2(root)
                var opened = false
                match root.child_directory("missing-child-must-not-create"):
                    case Err(error): cleanup_read_error(error)
                    case Ok(child_owner):
                        val child_index = retain_read_root_v2(child_owner)
                        opened = true
                        expect(close_read_root_v2(child_index)).to_equal(true)
                expect(opened).to_equal(false)
                expect(close_read_root_v2(root_index)).to_equal(true)
