# Regression for database loading that silently skipped rows with the wrong
# number of SDN fields. A malformed table must reject the whole database.

use std.database.core.{SdnDatabase}

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_read_text(path: text) -> text?

describe "Malformed SDN database rejection":
    it "rejects a malformed table without changing its source bytes":
        val path = "/tmp/sdn_malformed_row_rejection_spec.sdn"
        if rt_file_exists(path):
            rt_file_delete(path)

        val raw = "users |id, name|\n    user-1, Ada, unexpected\n"
        expect(rt_file_write_text(path, raw)).to_equal(true)

        val loaded = SdnDatabase.load(path)
        expect(loaded == nil).to_equal(true)
        expect(rt_file_read_text(path) ?? "").to_equal(raw)

        rt_file_delete(path)
