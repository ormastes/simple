"""
## Purpose and audience
Purpose: renders admitted HTML through Web Draw software 2D and Tiny WM
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-LIB-TinyBrowStacIt-001

use std.spec.*
use std.common.base_encoding.{text_to_bytes}
use std.tiny.common.event.{TinyEvent, TINY_EVENT_KEY, TINY_EVENT_POINTER_DOWN, TINY_EVENT_POINTER_UP, TINY_EVENT_TEXT, TINY_EVENT_WHEEL}
use std.tiny.common.status.{TINY_ERR_INVALID, TINY_ERR_UNSUPPORTED}
use std.tiny.common.types.{TinyPoint, TinyRect}
use std.tiny.gui.component.{TINY_COMPONENT_CHECKBOX, TINY_COMPONENT_TEXT_INPUT}
use std.tiny.gui.event_dispatch.{TINY_KEY_TAB, TINY_KEY_ENTER}
use std.tiny.web.resource.{TinyWebMemoryHost, TINY_RESOURCE_BUILTIN, TINY_RESOURCE_ROM, TINY_RESOURCE_VFS}
use std.tiny.web.scroll.{TinyScrollState}
use os.apps.tiny_browser.app.{TinyBrowser}

describe "Tiny browser stack integration":
    it "renders admitted HTML through Web Draw software 2D and Tiny WM":
        step("Verify: renders admitted HTML through Web Draw software 2D and Tiny WM")
        # @req: REQ-LIB-TinyBrowStacIt-001
        var browser = TinyBrowser.create(160, 120)
        val result = browser.render_html("<body><div><p>Tiny</p><button>Open</button><input></body>")
        expect(result.status.code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.parsed_nodes).to_be_greater_than(4)
        expect(result.paint_records).to_be_greater_than(3)
        expect(result.draw_words).to_be_greater_than(10)
        expect(result.checksum).to_be_greater_than(0)
        expect(result.surface_id).to_be_greater_than(0)
        expect(result.frame_id).to_be_greater_than(0)
        expect(result.presented_checksum).to_equal(result.checksum)
        expect(result.css_status.code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.html_unsupported_count).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.css_unsupported_count).to_equal(0)  # oracle: value fixed by the spec contract
        expect(browser.present.last_surface.checksum).to_equal(browser.renderer.checksum())
        expect(browser.present.last_surface.pixels.len()).to_equal(160 * 120)
        expect(result.frame.direct_present).to_be(true)
        expect(browser.wm.surface_count).to_equal(1)  # oracle: value fixed by the spec contract
        expect(browser.wm.frame_receipt().direct_present).to_be(true)

    it "loads a bounded host resource and installs only rendered CSS-resolved controls":
        step("Verify: loads a bounded host resource and installs only rendered CSS-resolved controls")
        # @req: REQ-LIB-TinyBrowStacIt-001
        val source = "<html><head><style>#name { width: 44px } .hidden { display: none }</style></head><body><input id='name' type='text' value='Ada' maxlength='3'><input type='checkbox' value='yes' checked disabled><input class='hidden' type='text' value='Gone'></body></html>"
        var host = TinyWebMemoryHost.bounded(160, 120, 2, 512)
        expect(host.register(7, TINY_RESOURCE_BUILTIN, "/index.html", text_to_bytes(source)).code).to_equal(0)  # oracle: value fixed by the spec contract
        var browser = TinyBrowser.create(160, 120)
        expect(browser.bind_web_host(host).code).to_equal(0)  # oracle: value fixed by the spec contract
        val result = browser.render_resource_id(7, 512)
        expect(result.status.code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.resource_id).to_equal(7)  # oracle: value fixed by the spec contract
        expect(result.resource_bytes).to_equal(source.len())
        expect(result.css_status.code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.unsupported_count).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.presented_checksum).to_equal(browser.present.last_surface.checksum)
        expect(browser.gui.nodes.len()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(browser.gui.nodes[0].class_id).to_equal(TINY_COMPONENT_TEXT_INPUT)
        expect(browser.gui.nodes[0].text_value).to_equal("Ada")
        expect(browser.gui.nodes[0].bounds.width).to_equal(44)  # oracle: value fixed by the spec contract
        expect(browser.control_max_length(0)).to_equal(3)  # oracle: value fixed by the spec contract
        expect(browser.gui.nodes[1].class_id).to_equal(TINY_COMPONENT_CHECKBOX)
        expect(browser.gui.nodes[1].value).to_equal(1)  # oracle: value fixed by the spec contract
        expect(browser.control_is_disabled(1)).to_be(true)
        val tab = TinyEvent(kind: TINY_EVENT_KEY, point: TinyPoint(x: 0, y: 0), code: TINY_KEY_TAB, value: 0)
        expect(browser.dispatch(tab).target_index).to_equal(0)  # oracle: value fixed by the spec contract
        expect(browser.dispatch(tab).target_index).to_equal(0)  # oracle: value fixed by the spec contract
        val typed = TinyEvent(kind: TINY_EVENT_TEXT, point: TinyPoint(x: 0, y: 0), code: 88, value: 0)
        val bounded = browser.dispatch(typed)
        expect(bounded.status.code).to_equal(TINY_ERR_UNSUPPORTED)
        expect(bounded.presented).to_be(false)
        expect(browser.gui.nodes[0].text_value).to_equal("Ada")

    it "renders an admitted empty V2 resource and rejects a missing ID":
        step("Verify: renders an admitted empty V2 resource and rejects a missing ID")
        # @req: REQ-LIB-TinyBrowStacIt-001
        var host = TinyWebMemoryHost.bounded(80, 60, 1, 16)
        expect(host.register(8, TINY_RESOURCE_BUILTIN, "/empty.html", []).code).to_equal(0)  # oracle: value fixed by the spec contract
        var browser = TinyBrowser.create(80, 60)
        expect(browser.bind_web_host(host).code).to_equal(0)  # oracle: value fixed by the spec contract
        val result = browser.render_resource_id(8, 16)
        expect(result.status.code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.resource_id).to_equal(8)  # oracle: value fixed by the spec contract
        expect(result.resource_bytes).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.presented_checksum).to_equal(browser.present.last_surface.checksum)
        expect(browser.render_resource_id(9, 16).status.code).to_equal(TINY_ERR_INVALID)

    it "loads accepted local navigation from the bound host and repaints product state":
        step("Verify: loads accepted local navigation from the bound host and repaints product state")
        # @req: REQ-LIB-TinyBrowStacIt-001
        val first = "<body><p>First</p></body>"
        val second = "<body><p>Second page</p><button>Open</button></body>"
        var host = TinyWebMemoryHost.bounded(120, 80, 2, 128)
        expect(host.register(1, TINY_RESOURCE_BUILTIN, "/index.html", text_to_bytes(first)).code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(host.register(2, TINY_RESOURCE_BUILTIN, "/next.html", text_to_bytes(second)).code).to_equal(0)  # oracle: value fixed by the spec contract
        var browser = TinyBrowser.create(120, 80)
        expect(browser.bind_web_host(host).code).to_equal(0)  # oracle: value fixed by the spec contract
        val initial = browser.render_resource_id(1, 128)
        expect(initial.status.code).to_equal(0)  # oracle: value fixed by the spec contract
        val navigated = browser.navigate_resource(TINY_RESOURCE_BUILTIN, "/next.html", 128)
        expect(navigated.status.code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(navigated.resource_id).to_equal(2)  # oracle: value fixed by the spec contract
        expect(navigated.frame_id).to_be_greater_than(initial.frame_id)
        expect(navigated.presented_checksum).to_equal(browser.present.last_surface.checksum)
        expect(browser.current_resource_id).to_equal(2)  # oracle: value fixed by the spec contract
        expect(browser.current_provider_kind).to_equal(TINY_RESOURCE_BUILTIN)
        expect(browser.current_path).to_equal("/next.html")
        expect(browser.page_source).to_equal(second)

    it "navigates built-in ROM and VFS providers through one bounded host port":
        step("Verify: navigates built-in ROM and VFS providers through one bounded host port")
        # @req: REQ-LIB-TinyBrowStacIt-001
        val builtin = "<body><p>Built in</p></body>"
        val rom = "<body><p>ROM page</p></body>"
        val vfs = "<body><p>VFS page</p></body>"
        var host = TinyWebMemoryHost.bounded(120, 80, 3, 128)
        expect(host.register(21, TINY_RESOURCE_BUILTIN, "/index.html", text_to_bytes(builtin)).code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(host.register(22, TINY_RESOURCE_ROM, "/rom.html", text_to_bytes(rom)).code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(host.register(23, TINY_RESOURCE_VFS, "/vfs.html", text_to_bytes(vfs)).code).to_equal(0)  # oracle: value fixed by the spec contract
        var browser = TinyBrowser.create(120, 80)
        expect(browser.bind_web_host(host).code).to_equal(0)  # oracle: value fixed by the spec contract
        val first = browser.render_resource_id(21, 128)
        expect(first.status.code).to_equal(0)  # oracle: value fixed by the spec contract
        val from_rom = browser.navigate_resource(TINY_RESOURCE_ROM, "/rom.html", 128)
        expect(from_rom.status.code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(from_rom.resource_id).to_equal(22)  # oracle: value fixed by the spec contract
        expect(from_rom.frame_id).to_be_greater_than(first.frame_id)
        expect(browser.current_provider_kind).to_equal(TINY_RESOURCE_ROM)
        expect(browser.page_source).to_equal(rom)
        val from_vfs = browser.navigate_resource(TINY_RESOURCE_VFS, "/vfs.html", 128)
        expect(from_vfs.status.code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(from_vfs.resource_id).to_equal(23)  # oracle: value fixed by the spec contract
        expect(from_vfs.frame_id).to_be_greater_than(from_rom.frame_id)
        expect(from_vfs.presented_checksum).to_equal(browser.present.last_surface.checksum)
        expect(browser.current_provider_kind).to_equal(TINY_RESOURCE_VFS)
        expect(browser.current_path).to_equal("/vfs.html")
        expect(browser.page_source).to_equal(vfs)

    it "propagates CSS and unsupported control receipts without partial presentation":
        step("Verify: propagates CSS and unsupported control receipts without partial presentation")
        # @req: REQ-LIB-TinyBrowStacIt-001
        var browser = TinyBrowser.create(80, 60)
        val css = browser.render_html("<html><head><style>input { position: fixed }</style></head><body><input></body></html>")
        expect(css.status.code).to_equal(TINY_ERR_UNSUPPORTED)
        expect(css.css_status.code).to_equal(TINY_ERR_UNSUPPORTED)
        expect(css.css_unsupported_count).to_equal(1)  # oracle: value fixed by the spec contract
        expect(css.unsupported_count).to_equal(1)  # oracle: value fixed by the spec contract
        expect(css.frame_id).to_equal(0)  # oracle: value fixed by the spec contract
        val control = browser.render_html("<body><input type='range'></body>")
        expect(control.status.code).to_equal(TINY_ERR_UNSUPPORTED)
        expect(control.control_unsupported_count).to_equal(1)  # oracle: value fixed by the spec contract
        expect(control.unsupported_count).to_equal(1)  # oracle: value fixed by the spec contract
        expect(control.frame_id).to_equal(0)  # oracle: value fixed by the spec contract

    it "focuses edits toggles and activates bounded controls":
        step("Verify: focuses edits toggles and activates bounded controls")
        # @req: REQ-LIB-TinyBrowStacIt-001
        var browser = TinyBrowser.create(160, 120)
        expect(browser.install_controls().code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(browser.wm.surface_count).to_equal(1)  # oracle: value fixed by the spec contract
        val tab = TinyEvent(kind: TINY_EVENT_KEY, point: TinyPoint(x: 0, y: 0), code: TINY_KEY_TAB, value: 0)
        val focused = browser.dispatch(tab)
        expect(focused.target_index).to_equal(0)  # oracle: value fixed by the spec contract
        expect(focused.routed_content_id).to_equal(1)  # oracle: value fixed by the spec contract
        expect(focused.presented).to_be(true)
        val pixel_before_text = browser.renderer.pixel_at(10, 26)
        expect(pixel_before_text).to_equal(-1)  # oracle: value fixed by the spec contract
        val typed = TinyEvent(kind: TINY_EVENT_TEXT, point: TinyPoint(x: 0, y: 0), code: 65, value: 0)
        val typed_receipt = browser.dispatch(typed)
        expect(typed_receipt.changed).to_be(true)
        expect(typed_receipt.presented).to_be(true)
        expect(typed_receipt.damage_count).to_be_greater_than(0)
        expect(typed_receipt.frame_id).to_be_greater_than(focused.frame_id)
        expect(typed_receipt.checksum_after).to_equal(browser.present.last_surface.checksum)
        expect(browser.renderer.pixel_at(10, 26)).to_equal(-16777216)  # oracle: value fixed by the spec contract
        expect(browser.gui.nodes[0].text_value).to_equal("A")
        expect(browser.dispatch(tab).target_index).to_equal(1)  # oracle: value fixed by the spec contract
        val enter = TinyEvent(kind: TINY_EVENT_KEY, point: TinyPoint(x: 0, y: 0), code: TINY_KEY_ENTER, value: 0)
        expect(browser.dispatch(enter).changed).to_be(true)
        expect(browser.gui.nodes[1].value).to_equal(1)  # oracle: value fixed by the spec contract
        val down = TinyEvent(kind: TINY_EVENT_POINTER_DOWN, point: TinyPoint(x: 20, y: 90), code: 1, value: 1)
        val action = browser.dispatch(down)
        expect(action.target_index).to_equal(2)  # oracle: value fixed by the spec contract
        expect(action.changed).to_be(true)
        val up = TinyEvent(kind: TINY_EVENT_POINTER_UP, point: TinyPoint(x: 20, y: 90), code: 1, value: 0)
        browser.dispatch(up)
        expect(browser.wm.captured_content_id).to_equal(-1)  # oracle: value fixed by the spec contract
        browser.scroll = TinyScrollState(offset_y: 0, viewport_height: 120, content_height: 240)
        val wheel = TinyEvent(kind: TINY_EVENT_WHEEL, point: TinyPoint(x: 20, y: 90), code: 0, value: 16)
        val wheel_receipt = browser.dispatch(wheel)
        expect(wheel_receipt.changed).to_be(true)
        expect(wheel_receipt.presented).to_be(true)
        expect(wheel_receipt.damage_count).to_be_greater_than(0)
        expect(wheel_receipt.checksum_after).to_equal(browser.renderer.checksum())
        expect(browser.scroll.offset_y).to_equal(16)  # oracle: value fixed by the spec contract

    it "composes a clipped popup and releases pointer capture":
        step("Verify: composes a clipped popup and releases pointer capture")
        # @req: REQ-LIB-TinyBrowStacIt-001
        var browser = TinyBrowser.create(160, 120)
        browser.render_html("<body><p>Tiny</p></body>")
        val popup = browser.open_visible_popup(2, TinyRect(x: 140, y: 100, width: 40, height: 40), -65536)
        expect(popup.status.code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(popup.presented).to_be(true)
        expect(popup.frame.direct_present).to_be(false)
        expect(popup.checksum_after).to_equal(browser.present.last_surface.checksum)
        expect(popup.sample_pixel).to_equal(-65536)  # oracle: value fixed by the spec contract
        expect(browser.wm.surfaces[1].resolved.width).to_equal(40)  # oracle: value fixed by the spec contract
        expect(browser.wm.surfaces[1].clip.width).to_equal(20)  # oracle: value fixed by the spec contract
        val down = TinyEvent(kind: TINY_EVENT_POINTER_DOWN, point: TinyPoint(x: 150, y: 110), code: 1, value: 1)
        browser.dispatch(down)
        expect(browser.wm.captured_content_id).to_equal(2)  # oracle: value fixed by the spec contract
        val up = TinyEvent(kind: TINY_EVENT_POINTER_UP, point: TinyPoint(x: 5, y: 5), code: 1, value: 0)
        browser.dispatch(up)
        expect(browser.wm.captured_content_id).to_equal(-1)  # oracle: value fixed by the spec contract
        expect(browser.close_popup(2).code).to_equal(0)  # oracle: value fixed by the spec contract

    it "keeps popup-routed input out of root GUI state":
        step("Verify: keeps popup-routed input out of root GUI state")
        # @req: REQ-LIB-TinyBrowStacIt-001
        var browser = TinyBrowser.create(160, 120)
        expect(browser.install_controls().code).to_equal(0)  # oracle: value fixed by the spec contract
        val tab = TinyEvent(kind: TINY_EVENT_KEY, point: TinyPoint(x: 0, y: 0), code: TINY_KEY_TAB, value: 0)
        expect(browser.dispatch(tab).target_index).to_equal(0)  # oracle: value fixed by the spec contract
        expect(browser.open_popup(2, TinyRect(x: 8, y: 20, width: 80, height: 40)).code).to_equal(0)  # oracle: value fixed by the spec contract
        val before_text = browser.gui.nodes[0].text_value
        val typed = TinyEvent(kind: TINY_EVENT_TEXT, point: TinyPoint(x: 0, y: 0), code: 88, value: 0)
        val blocked_key = browser.dispatch(typed)
        expect(blocked_key.status.code).to_equal(TINY_ERR_INVALID)
        expect(blocked_key.routed_content_id).to_equal(2)  # oracle: value fixed by the spec contract
        expect(blocked_key.presented).to_be(false)
        expect(browser.gui.nodes[0].text_value).to_equal(before_text)
        val down = TinyEvent(kind: TINY_EVENT_POINTER_DOWN, point: TinyPoint(x: 20, y: 30), code: 1, value: 1)
        val blocked_pointer = browser.dispatch(down)
        expect(blocked_pointer.status.code).to_equal(TINY_ERR_INVALID)
        expect(blocked_pointer.routed_content_id).to_equal(2)  # oracle: value fixed by the spec contract
        expect(blocked_pointer.target_index).to_equal(-1)  # oracle: value fixed by the spec contract
        expect(browser.gui.nodes[0].text_value).to_equal(before_text)

    it "fails closed when the parser capacity is exhausted":
        step("Verify: fails closed when the parser capacity is exhausted")
        # @req: REQ-LIB-TinyBrowStacIt-001
        var browser = TinyBrowser.create(80, 60)
        browser.max_nodes = 2
        val result = browser.render_html("<body><div><p>too many</p></div></body>")
        expect(result.status.code).to_equal(1)  # oracle: value fixed by the spec contract
        expect(result.checksum).to_equal(0)  # oracle: value fixed by the spec contract
