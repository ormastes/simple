use std.spec.{describe, it, expect}
use std.spec.step
use std.nogc_sync_mut.io.linux_container_user_observation_v1.{linux_container_user_observe_v1,
    linux_container_user_observation_failure_close_v1}
use test.fixtures.orchestration.linux_container_user_observation_checks_v1.linux_container_user_native_checks_v1

describe "Read-only native container primary user observation":
    it "executes the actual bounded native child and ownership regression":
        step("Verify the compiled fixture identity before running actual native observations")
        linux_container_user_native_checks_v1("build/linux-container-user-observer-v1/native-observer",
            "8cf0fd21d7aa54b5346b3dbb5420c4155a57f8e14fdef82023efe235b210ecbf")

    it "refuses invalid process identity without publishing a native owner":
        step("Use the production owner facade and retain structured failure ownership")
        val failed = linux_container_user_observe_v1(-1, "/invalid", "a".repeat(64))
        expect(failed.is_err()).to_equal(true)
        match failed:
            case Err(failure):
                expect(failure.retained_native_token).to_equal(0)
                expect(failure.error).to_equal("invalid-container-user-observation-request")
                expect(linux_container_user_observation_failure_close_v1(failure).is_ok()).to_equal(true)
            case Ok(_): expect(false).to_equal(true)
