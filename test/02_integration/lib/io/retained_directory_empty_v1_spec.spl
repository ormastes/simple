# SOURCE_AUTHORED_NOT_RUN. Two actual private nofollow fixture directories,
# one empty and one containing a real entry, must be independently installed.
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.env_ops.env_get
use std.nogc_sync_mut.io.retained_file.retained_directory_open_trusted_v1

describe "Actual retained template emptiness":
    it "REQ-AGENT-BOOT-005 rewinds actual directory state before every observation":
        val empty_path = env_get("SIMPLE_AGENT_BOOTSTRAP_EMPTY_TEMPLATE_FIXTURE") ?? ""
        val full_path = env_get("SIMPLE_AGENT_BOOTSTRAP_NONEMPTY_TEMPLATE_FIXTURE") ?? ""
        expect(empty_path != "" and full_path != "").to_equal(true)
        var empty = retained_directory_open_trusted_v1(empty_path).unwrap()
        val opened_full = retained_directory_open_trusted_v1(full_path)
        if opened_full.is_err():
            val consumed = empty.close()
            expect(opened_full.is_ok()).to_equal(true)
        else:
            var full = opened_full.unwrap()
            val first_empty = empty.directory_is_empty_v1()
            val second_empty = empty.directory_is_empty_v1()
            val first_full = full.directory_is_empty_v1()
            val second_full = full.directory_is_empty_v1()
            val full_closed = full.close()
            val empty_closed = empty.close()
            expect(first_empty.unwrap()).to_equal(true)
            expect(second_empty.unwrap()).to_equal(true)
            expect(first_full.unwrap()).to_equal(false)
            expect(second_full.unwrap()).to_equal(false)
            expect(full_closed and empty_closed).to_equal(true)
