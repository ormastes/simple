use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_write, file_delete}
use std.nogc_sync_mut.io_runtime.{dir_list_optional, dir_remove}

describe "optional directory listing preserves absence and entries":
    it "distinguishes an empty directory from a missing path and retains a real entry":
        val root = match secure_temp_dir(".", "phase3-dir-list"):
            Ok(path): path
            Err(error): panic(error)
        val empty = dir_list_optional(root)
        val missing = dir_list_optional(root + "/absent-child")
        val written = file_write(root + "/kept.txt", "retained")
        val populated = dir_list_optional(root)
        val removed_file = file_delete(root + "/kept.txt")
        val removed_dir = dir_remove(root)
        expect(written).to_equal(true)
        expect(removed_file).to_equal(true)
        expect(removed_dir).to_equal(true)
        expect(missing).to_be_nil()
        match empty:
            Some(entries): expect(entries.len()).to_equal(0)
            None: fail("an existing empty directory was reported missing")
        match populated:
            Some(entries):
                expect(entries.len()).to_equal(1)
                expect(entries[0]).to_equal("kept.txt")
            None: fail("an existing populated directory was reported missing")
