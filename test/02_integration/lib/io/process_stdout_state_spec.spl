# SOURCE-ONLY authored regression: requires the coordinated stdout-state runtime.
use std.spec.*
use std.nogc_sync_mut.io.process_ops.{process_spawn_piped, process_read_stdout_result, process_is_piped_alive, process_close_piped}
use std.io_runtime.{time_now_monotonic_ms, thread_sleep}

fn _stdout_state_wait_dead(pid: i64):
    val deadline = time_now_monotonic_ms() + 5000
    while process_is_piped_alive(pid) and time_now_monotonic_ms() < deadline:
        thread_sleep(1)
    expect(process_is_piped_alive(pid)).to_equal(false)

fn _stdout_state_collect(pid: i64) -> text:
    var output = ""
    val deadline = time_now_monotonic_ms() + 5000
    while time_now_monotonic_ms() < deadline:
        match process_read_stdout_result(pid):
            case Ok(Some(chunk)):
                output = output + chunk
            case Ok(nil):
                thread_sleep(1)
            case Err(error):
                expect(error).to_equal("process_stdout_eof")
                return output
    process_close_piped(pid)
    fail("stdout state regression exceeded its real process deadline")

describe "stdout EOF is independent of process liveness":
    it "retains buffered output after truthful child death":
        val pid = process_spawn_piped("/bin/sh", ["-c", "printf buffered"])
        expect(pid).to_be_greater_than(0)
        _stdout_state_wait_dead(pid)
        expect(_stdout_state_collect(pid)).to_equal("buffered")
        expect(process_close_piped(pid)).to_equal(true)

    it "flushes an incomplete UTF8 tail before EOF":
        val pid = process_spawn_piped("/bin/sh", ["-c", "printf '\\342\\202'"])
        expect(pid).to_be_greater_than(0)
        _stdout_state_wait_dead(pid)
        expect(_stdout_state_collect(pid)).to_equal("�")
        expect(process_close_piped(pid)).to_equal(true)

    it "reports unknown pipe separately from observed EOF":
        match process_read_stdout_result(0):
            case Err(error):
                expect(error).to_equal("process_stdout_read_failed")
            case _:
                fail("unknown pipe must not report open or observed EOF")
