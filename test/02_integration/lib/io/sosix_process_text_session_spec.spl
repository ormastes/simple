"""Actual Linux owned-process/codec contract. Native provider required; UNRUN."""
use std.spec.*
use std.nogc_sync_mut.sosix.process_text.*
use std.nogc_sync_mut.io.text_session.{TextSessionCodec, text_session_codec, utf8_text_session_codec}
use std.common.encoding.external_text.{Encoding, TextByteOrder, BomPolicy, CodecErrorKind}
use std.nogc_sync_mut.io.process_ops.{OwnedProcessResult}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir}
use std.io_runtime.{file_exists, dir_remove, dir_exists}

fn utf8() -> TextSessionCodec:
    utf8_text_session_codec(4096, 4096).unwrap()

fn utf16(order: TextByteOrder, bom: BomPolicy) -> TextSessionCodec:
    text_session_codec(Encoding.Utf16, order, bom, Encoding.Utf16, order, bom, 4096, 4096).unwrap()

fn start(script: text, input: text, write: TextSessionCodec, out: TextSessionCodec, err: TextSessionCodec, cap: i64 = 4096, timeout: i64 = 1000) -> ProcessTextSession:
    sosix_process_text_session("/bin/sh", ["-c", script], input, write, out, err, timeout, 50, cap).unwrap()

fn retire(session: ProcessTextSession) -> OwnedProcessResult:
    var turns = 0
    while turns < 80:
        val result = session.collect(25).unwrap()
        if val value = result: return value
        turns = turns + 1
    assert(false, "actual process failed to retire in bounded fixture turns")
    session.collect(0).unwrap().unwrap()

fn drain(session: ProcessTextSession, capacity: i64 = 64) -> (text, text, bool):
    var out = ""
    var err = ""
    var timed_out = false
    var turns = 0
    while turns < 100:
        val chunk = session.poll(25, capacity).unwrap()
        out = out + chunk.stdout
        err = err + chunk.stderr
        timed_out = timed_out or chunk.timed_out
        if chunk.output_finished: return (out, err, timed_out)
        turns = turns + 1
    assert(false, "actual process output did not finish")
    (out, err, timed_out)

fn expect_a_nul_emoji(value: text):
    expect(value.len()).to_equal(6)
    expect(value.byte_at(0)).to_equal(65)
    expect(value.byte_at(1)).to_equal(0)
    expect(value.byte_at(2)).to_equal(240)
    expect(value.byte_at(3)).to_equal(159)
    expect(value.byte_at(4)).to_equal(152)
    expect(value.byte_at(5)).to_equal(128)

fn consuming_error(session: ProcessTextSession) -> ProcessTextError:
    var turns = 0
    while turns < 100:
        match session.poll(25, 1):
            case Err(error): return error
            case Ok(_): turns = turns + 1
    assert(false, "actual malformed stream was accepted")
    ProcessTextError.InvalidRequest("unreachable")

describe "explicit process text sessions":
    it "decodes independent UTF16LE stdout and UTF16BE stderr with exact NUL bytes":
        step("Capture actual shell bytes through independent stream codecs")
        val s = start("printf '\\101\\000\\000\\000\\075\\330\\000\\336'; printf '\\000\\101\\000\\000\\330\\075\\336\\000' >&2", "", utf8(), utf16(TextByteOrder.LittleEndian, BomPolicy.Preserve), utf16(TextByteOrder.BigEndian, BomPolicy.Preserve))
        val output = drain(s, 1)
        expect_a_nul_emoji(output.0)
        expect_a_nul_emoji(output.1)
        expect(retire(s).exit_code).to_equal(0)

    it "encodes stdin once and distinguishes accepted from completely written input":
        step("Roundtrip binary stdin through cat and inspect actual delivery receipt")
        val codec = utf16(TextByteOrder.BigEndian, BomPolicy.Require)
        val s = start("cat", "A\u{0}😀", codec, codec, utf8())
        val output = drain(s, 1)
        expect_a_nul_emoji(output.0)
        val input = s.input_receipt().unwrap()
        expect(input.accepted).to_equal(10)
        expect(input.written).to_equal(10)
        expect(input.stdin_closed).to_equal(true)
        expect(retire(s).exit_code).to_equal(0)

    it "rejects missing BOM and retains cancellation and collection after sticky failure":
        step("Preserve owner after required signature failure")
        val s = start("printf '\\101\\000'; sleep 1", "", utf8(), utf16(TextByteOrder.LittleEndian, BomPolicy.Require), utf8())
        match consuming_error(s):
            case ProcessTextError.Codec(stream, error):
                expect(stream).to_equal("stdout")
                expect(error.kind).to_equal(CodecErrorKind.MissingBom)
            case _: assert(false, "expected typed missing BOM")
        expect(s.poll(0, 1).is_err()).to_equal(true)
        s.cancel().unwrap()
        expect(retire(s).reaped).to_equal(true)

    it "rejects malformed UTF8 and allows bounded discard retirement":
        step("Reject an invalid leading byte without losing the child lease")
        val s = start("printf '\\377'; printf tail", "", utf8(), utf8(), utf8())
        match consuming_error(s):
            case ProcessTextError.Codec(stream, error):
                expect(stream).to_equal("stdout")
                expect(error.kind).to_equal(CodecErrorKind.InvalidUtf8)
            case _: assert(false, "expected typed UTF8 error")
        expect(retire(s).reaped).to_equal(true)

    it "finishes only after draining terminal output and rejects incomplete UTF16":
        step("Validate pending scalar bytes at actual terminal stream end")
        val s = start("printf '\\101'", "", utf8(), utf16(TextByteOrder.LittleEndian, BomPolicy.Preserve), utf8())
        match consuming_error(s):
            case ProcessTextError.Codec(stream, error):
                expect(stream).to_equal("stdout")
                expect(error.kind).to_equal(CodecErrorKind.TruncatedInput)
            case _: assert(false, "expected typed incomplete UTF16")
        expect(retire(s).reaped).to_equal(true)

    it "rejects capture truncation rather than decoding a retained prefix as complete":
        step("Observe actual provider truncation at a four-byte limit")
        val s = start("printf 123456789", "", utf8(), utf8(), utf8(), 4)
        match consuming_error(s):
            case ProcessTextError.Truncated(stream): expect(stream).to_equal("stdout")
            case _: assert(false, "expected typed capture truncation")
        val result = retire(s)
        expect(result.stdout_truncated).to_equal(true)

    it "preserves timeout flags through decoded capture and collection":
        step("Use the provider deadline without a text timeout sentinel")
        val s = start("printf READY; sleep 2", "", utf8(), utf8(), utf8(), 4096, 50)
        val output = drain(s)
        expect(output.2).to_equal(true)
        expect(retire(s).timed_out).to_equal(true)

    it "shares collection state across aliases and refuses reuse":
        step("Collect the same opaque owner once through two class references")
        val s = start("exit 7", "", utf8(), utf8(), utf8())
        val alias = s
        drain(s)
        expect(retire(alias).exit_code).to_equal(7)
        expect(s.is_open()).to_equal(false)
        expect(s.collect(0).is_err()).to_equal(true)
        expect(s.poll(0, 1).is_err()).to_equal(true)

    it "rejects NUL arguments before any child can create a witness":
        step("Validate process argv before spawn")
        val temp = secure_temp_dir("/tmp", "process-codec-").unwrap()
        val witness = "{temp}/started"
        val result = sosix_process_text_session("/bin/sh", ["-c", "touch '{witness}'", "bad\u{0}arg"], "", utf8(), utf8(), utf8(), 1000, 50, 4096)
        expect(result.is_err()).to_equal(true)
        expect(file_exists(witness)).to_equal(false)
        expect(dir_remove(temp, false)).to_equal(true)
        expect(dir_exists(temp)).to_equal(false)

    it "rejects invalid session metadata before spawn":
        step("Validate all profiles before process creation")
        val bad = TextSessionCodec(_read_encoding: Encoding.Utf16, _read_byte_order: TextByteOrder.NotApplicable, _read_bom: BomPolicy.Preserve, _write_encoding: Encoding.Utf8, _write_byte_order: TextByteOrder.NotApplicable, _write_bom: BomPolicy.Preserve, _max_input_bytes: 4096, _max_output_bytes: 4096)
        expect(sosix_process_text_session("/bin/sh", ["-c", "exit 0"], "", utf8(), bad, utf8(), 1000, 50, 4096).is_err()).to_equal(true)

    it "rejects oversized capture and timeout before spawning":
        step("Keep finite integer limits explicit")
        expect(sosix_process_text_session("/bin/sh", ["-c", "exit 0"], "", utf8(), utf8(), utf8(), 0, 50, 4096).is_err()).to_equal(true)
        expect(sosix_process_text_session("/bin/sh", ["-c", "exit 0"], "", utf8(), utf8(), utf8(), 1000, 50, 1048577).is_err()).to_equal(true)

    it "rejects invalid poll bounds without consuming an otherwise valid owner":
        step("Preserve owner after nonconsuming argument failure")
        val s = start("printf OK", "", utf8(), utf8(), utf8())
        expect(s.poll(251, 1).is_err()).to_equal(true)
        expect(s.poll(0, 0).is_err()).to_equal(true)
        expect(drain(s).0).to_equal("OK")
        expect(retire(s).exit_code).to_equal(0)

    it "reports early stdin close without relabeling acceptance as full delivery":
        step("Observe partial input delivery when the real child closes stdin")
        val input_codec = utf8_text_session_codec(1048576, 1048576).unwrap()
        val s = start("exec 0<&-; exit 0", "x".repeat(1048576), input_codec, utf8(), utf8())
        match consuming_error(s):
            case ProcessTextError.Native(code): expect(code).to_equal(32)
            case _: assert(false, "expected the Linux provider EPIPE receipt")
        val receipt = s.input_receipt().unwrap()
        expect(receipt.accepted).to_equal(1048576)
        expect(receipt.written < receipt.accepted).to_equal(true)
        expect(receipt.stdin_closed).to_equal(true)
        expect(retire(s).reaped).to_equal(true)

    it "keeps decoder failure sticky while collection drains more than one poll":
        step("Retire unread retained data after the first invalid byte")
        val codec = utf8_text_session_codec(131072, 131072).unwrap()
        val s = start("printf '\\377'; head -c 100000 /dev/zero", "", utf8(), codec, codec, 131072)
        match consuming_error(s):
            case ProcessTextError.Codec(stream, error):
                expect(stream).to_equal("stdout")
                expect(error.kind).to_equal(CodecErrorKind.InvalidUtf8)
            case _: assert(false, "expected typed invalid leading byte")
        expect(retire(s).reaped).to_equal(true)
        expect(s.is_open()).to_equal(false)
