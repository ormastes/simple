use std.spec.*
use std.scv.solver_db_rows_schema_v1.*
use std.scv.db_schema_identity_v2.*
use std.scv.db_schema_codec_v2.*
use std.scv.db_schema_merge_v2.*
use std.scv.db_schema_migration_v2.*
use std.scv.db_reducer.{db_field_value}
use std.scv.db_patch.{DbValue, db_value_bytes}
use std.scv.db_patch_codec.{db_patch_decode}
use std.scv.db_snapshot.{db_snapshot_decode, db_snapshot_encode}
use test.fixtures.scv.db_schema_v2_fixture.{exercise_scv_schema_change, exercise_scv_schema_add}
use test.fixtures.scv.solver_host_v1_fixture.{setup_scv_policy}
use test.fixtures.scv.solver_db_rows_schema_v1_fixture.*

describe "Schema-aware textual database row proposals":
    it "previews the original signed V1 edit through ColumnUid after rename":
        step("setup")
        val input = setup_scv_rows_schema_input_v1()
        val request = freeze_scv_rows_schema_request_v1(input)
        step("exercise")
        val solved = solve_db_rows_schema_v1(request, setup_scv_policy(request.binding), input)
        step("assert")
        val preview = solved.preview.unwrap()
        expect(solved.result.status).to_equal("needs_inputs")
        expect(preview.authorization_status).to_equal("UNVERIFIED_PREVIEW")
        expect(solved.result.execution_status).to_equal("unqualified-builtin-execution")
        expect(solved.result.deterministic_result_key).to_equal("")
        expect(solved.uid_edits.len()).to_equal(1)
        expect(db_schema_uid_equal_v2(solved.uid_edits[0].address.column_uid, input.accepted_original_schema.columns[0].column_uid)).to_equal(true)
        expect(db_value_bytes(db_field_value(preview.proposed.rows[0].fields, "summary")).unwrap()).to_equal(db_value_bytes(DbValue.Text("edited offline")).unwrap())
        expect(solved.inputs.submitted_patch).to_equal(input.submitted_patch)
        expect(solved.inputs.submitted_snapshot).to_equal(input.submitted_snapshot)
        expect(solved.inputs.accepted_policy).to_equal(input.accepted_policy)
        expect(db_patch_decode(solved.inputs.submitted_patch).unwrap().signature).to_equal([7u8, 8u8])
        expect(db_snapshot_decode(input.submitted_snapshot).unwrap().rows[0].fields[0].name).to_equal("title")
        expect(solved.result.required_checks[6].check_id).to_equal("db.rows:combined-db-constraints")
        for check in solved.result.required_checks:
            expect(check.subject_digest).to_equal(solved.result.candidate_root.unwrap())

    it "retains independent nullable additions and their identity without padding old rows":
        val original = setup_scv_rows_schema_input_v1()
        var input = original
        val left = exercise_scv_schema_add(original.accepted_current_schema, 2u64, "labels", false, DbDefaultRuleV2.NoDefault)
        val right = exercise_scv_schema_add(original.accepted_current_schema, 2u64, "priority", true, DbDefaultRuleV2.Constant(DbValue.Text("normal")))
        input.accepted_current_schema = db_schema_merge_v2(original.accepted_current_schema, left, right).unwrap().candidate.unwrap()
        val request = freeze_scv_rows_schema_request_v1(input)
        val solved = solve_db_rows_schema_v1(request, setup_scv_policy(request.binding), input)
        expect(solved.result.conflicts.len()).to_equal(0)
        expect(solved.preview.unwrap().proposed.rows[0].fields.len()).to_equal(1)
        expect(solved.inputs.accepted_current_schema.columns.len()).to_equal(3)
        expect(solved.result.validation_status).to_equal("external-validation-required")

    it "preserves malformed submitted bytes as a draft without a preview":
        var input = setup_scv_rows_schema_input_v1()
        val request = freeze_scv_rows_schema_request_v1(input)
        input.submitted_patch = input.submitted_patch + "unparsed bytes\n"
        val solved = solve_db_rows_schema_v1(request, setup_scv_policy(request.binding), input)
        expect(solved.preview).to_be_nil()
        expect(solved.result.candidate_root).to_be_nil()
        expect(solved.inputs.submitted_patch).to_equal(input.submitted_patch)
        expect(solved.result.status).to_equal("failed")

    it "requires the exact host-pinned historical schema and never guesses mapping":
        var input = setup_scv_rows_schema_input_v1()
        input.historical_binding.binding_digest = "missing"
        val request = freeze_scv_rows_schema_request_v1(setup_scv_rows_schema_input_v1())
        val solved = solve_db_rows_schema_v1(request, setup_scv_policy(request.binding), input)
        expect(solved.preview).to_be_nil()
        expect(solved.result.status).to_equal("needs_inputs")
        expect(solved.result.conflicts[0].code).to_equal("SCVDB_SCHEMA_V1_BINDING_DIGEST")
        expect(solved.inputs.submitted_patch).to_equal(input.submitted_patch)

    it "keeps drop and old-schema update conflicts explicit":
        var input = setup_scv_rows_schema_input_v1()
        val schema = input.accepted_current_schema
        val uid = schema.columns[0].column_uid
        input.accepted_current_schema = db_schema_apply_v2(schema, exercise_scv_schema_change(schema, uid, 21u64, DbSchemaChangeV2.DropColumn(uid))).unwrap()
        val request = freeze_scv_rows_schema_request_v1(input)
        val solved = solve_db_rows_schema_v1(request, setup_scv_policy(request.binding), input)
        expect(solved.preview).to_be_nil()
        expect(solved.result.conflicts[0].code).to_equal("SCVDB_SCHEMA_DROP_EDIT_CONFLICT")

    it "rejects a source solver profile before interpreting database bytes":
        val input = setup_scv_rows_schema_input_v1()
        val request = freeze_scv_rows_schema_request_v1(input)
        var policy = setup_scv_policy(request.binding)
        policy.solver.provider_id = "scv.solver.source-bytes.v1"
        val solved = solve_db_rows_schema_v1(request, policy, input)
        expect(solved.result.status).to_equal("unsupported")
        expect(solved.preview).to_be_nil()

    it "bounds input bytes before readers and retains them on cancellation":
        var input = setup_scv_rows_schema_input_v1()
        var request = freeze_scv_rows_schema_request_v1(input)
        input.submitted_patch = "x".repeat(200000)
        request.memory_budget = 100
        val limited = solve_db_rows_schema_v1(request, setup_scv_policy(request.binding), input)
        expect(limited.result.status).to_equal("resource_limited")
        expect(limited.preview).to_be_nil()
        request.cancelled = true
        val cancelled = solve_db_rows_schema_v1(request, setup_scv_policy(request.binding), input)
        expect(cancelled.result.status).to_equal("cancelled")
        expect(cancelled.inputs.submitted_patch).to_equal(input.submitted_patch)
