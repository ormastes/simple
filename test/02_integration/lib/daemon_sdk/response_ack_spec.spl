# @req DAE-01
# Admitted SSpec execution status is recorded separately from native diagnostics.
use std.spec.*
use test.fixtures.daemon_sdk.publication_regression.*

describe "legacy daemon response acknowledgement safety":
    it "keeps a request and stops dispatch after a real response publication failure":
        expect(daemon_publication_failure_case()).to_equal(0)

    it "refuses a response for another request before publishing or deleting":
        expect(daemon_response_identity_case()).to_equal(0)

    it "publishes before clearing a successfully processed request":
        expect(daemon_publication_success_case()).to_equal(0)

    it "stops when acknowledgement fails after successful publication":
        expect(daemon_ack_missing_case()).to_equal(0)

    it "acknowledges only the successful prefix and preserves failed and unprocessed requests":
        expect(daemon_publication_prefix_case()).to_equal(0)

    it "stops after a deletion refusal while retaining the replacement entry":
        expect(daemon_ack_refusal_case()).to_equal(0)

    it "rejects field data that injects envelope headers before publication":
        expect(daemon_envelope_injection_case()).to_equal(0)

    it "does not clean old responses or lose blocked state at outer-loop cycle 100":
        expect(daemon_outer_loop_failure_case()).to_equal(0)

    it "acknowledges a valid nonzero-status response and preserves ordinary multiline compatibility":
        expect(daemon_error_status_case()).to_equal(0)
