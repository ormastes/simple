# @req DAE-01 HOST-01
use std.spec.{describe, it, expect}
use test.fixtures.daemon_sdk.spool_byte_limit.*

describe "daemon spool limits use serialized UTF-8 bytes":
    it "accepts exactly one MiB and rejects one extra byte for requests":
        expect(spool_request_byte_boundaries()).to_equal(0)

    it "accepts exactly one MiB and rejects one extra byte for responses":
        expect(spool_response_byte_boundaries()).to_equal(0)

    it "rejects multibyte messages whose character count would fit":
        expect(spool_multibyte_limit()).to_equal(0)
