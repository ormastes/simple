# Requires the native executable owner; interpreter adapters are not evidence.
use std.nogc_sync_mut.sosix.memory_executable_v1.{SosixMemoryExecutableV1}

describe "SOSIX native image preparation":
    it "rejects a missing image before any process launch":
        expect(SosixMemoryExecutableV1.prepare("/nonexistent-sosix-executable-fixture/image").is_err()).to_equal(true)
