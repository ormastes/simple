# SOSIX routes through the existing V1 observation facade. V4 has no SOSIX facade.
# @req REQ-POV4-C02
use std.spec.{describe, it, expect}
use std.spec.step
use std.nogc_async_mut.sosix.process_observation_v1.{
    ProcessObservationProviderV1, ObservedProcessStartStatusV1,
    ObservedProcessResultStatusV1, ObservedProcessRequestV1,
    process_observation_start_with_provider_v1, process_observation_decode_result_v1}

describe "SOSIX process observation V1 boundary":
    it "refuses unsupported provider before starting a child":
        step("Submit a request to an explicitly unsupported provider")
        val denied = process_observation_start_with_provider_v1(
            ProcessObservationProviderV1.Unsupported,
            ObservedProcessRequestV1(command: "/bin/sh", args: ["-c", "exit 0"],
                deadline_ms: 250, term_grace_ms: 50, stdout_limit: 1024,
                stderr_limit: 1024, pin_executable: true))
        expect(denied.status).to_equal(ObservedProcessStartStatusV1.Unsupported)
        expect(denied.spawned).to_equal(false)
        expect(denied.pid).to_equal(0)

    it "does not interpret arbitrary words as a provider receipt":
        step("Decode empty and unrecognized receipts")
        expect(process_observation_decode_result_v1([]).status).to_equal(ObservedProcessResultStatusV1.Missing)
        expect(process_observation_decode_result_v1([1, 2, 3]).status).to_equal(ObservedProcessResultStatusV1.Malformed)
