# @req KPM-REQ-004 KPM-REQ-006 KPM-REQ-009 KPM-REQ-011 KPM-NFR-003 KPM-NFR-005
use std.spec.*

extern fn rt_process_run(command: text, args: [text]) -> (text, text, i64)

describe "KPF native dynamic-library compatibility matrix":
    it "loads and negotiates real shared libraries before resident dispatch":
        val (output, error, status) = rt_process_run(
            "/bin/sh",
            ["test/02_integration/lib/sffi/native_dynamic_compatibility_matrix_test.shs"])
        expect(status).to_equal(0)
        expect(error).to_equal("")
        expect(output).to_contain("matrix_case name=matching-major result=accepted")
        expect(output).to_contain("matrix_case name=older-compatible-minor result=accepted")
        expect(output).to_contain("matrix_case name=wrong-major result=rejected reason=major")
        expect(output).to_contain("matrix_case name=digest-mismatch result=rejected reason=digest")
        expect(output).to_contain("entry_calls=1")
        expect(output).to_contain("KPF_NATIVE_DYNAMIC_MATRIX: PASS")
        expect(output).to_contain("KPF_NATIVE_DYNAMIC_MATRIX_MUTATION: PASS")
