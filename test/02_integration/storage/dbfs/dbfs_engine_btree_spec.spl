# Maps to: AC-3, AC-9
# Run: bin/simple test test/integration/storage/dbfs/dbfs_engine_btree_spec.spl

"""
## Purpose and audience
Purpose: insert then lookup returns the same value
Audience: compiler and tooling engineers who maintain this spec

DBFS B-Tree Specification

Verifies the generic B-tree used for namespace and metadata:
  1. insert + point-lookup round-trip
  2. range scan returns sorted results
  3. delete removes key
  4. MVCC snapshot read at older generation
  5. duplicate key insert updates existing value
"""

# @req: REQ-STORAGE-DbfsEngiBtre-001

use std.spipe.*
use std.nogc_async_mut.db.dbfs_engine.{NsBTree, NsDentryKey, NsIno}

use std.spec.step
describe "DBFS B-Tree — insert and lookup":
    """Basic insert/lookup contract."""

    it "insert then lookup returns the same value":
        step("Verify: insert then lookup returns the same value")
        # @req: REQ-STORAGE-DbfsEngiBtre-001
        val tree = NsBTree.new()
        val key = NsDentryKey(parent_ino: 1, name_hash: 0x1234)
        tree.insert(key, NsIno(value: 42)).unwrap()
        val got = tree.lookup(key).unwrap()
        expect(got.value).to_equal(42)  # oracle: value fixed by the spec contract

    it "lookup on missing key returns None":
        step("Verify: lookup on missing key returns None")
        # @req: REQ-STORAGE-DbfsEngiBtre-001
        val tree = NsBTree.new()
        val key = NsDentryKey(parent_ino: 99, name_hash: 0xDEAD)
        val got = tree.lookup(key)
        expect(got.is_none()).to_equal(true)

    it "duplicate insert updates value":
        step("Verify: duplicate insert updates value")
        # @req: REQ-STORAGE-DbfsEngiBtre-001
        val tree = NsBTree.new()
        val key = NsDentryKey(parent_ino: 1, name_hash: 0x01)
        tree.insert(key, NsIno(value: 10)).unwrap()
        tree.insert(key, NsIno(value: 20)).unwrap()
        val got = tree.lookup(key).unwrap()
        expect(got.value).to_equal(20)  # oracle: value fixed by the spec contract

describe "DBFS B-Tree — range scan":
    """Range scan returns all keys in [lo, hi]."""

    it "range scan returns entries in sorted order":
        step("Verify: range scan returns entries in sorted order")
        # @req: REQ-STORAGE-DbfsEngiBtre-001
        val tree = NsBTree.new()
        tree.insert(NsDentryKey(parent_ino: 1, name_hash: 3), NsIno(value: 3)).unwrap()
        tree.insert(NsDentryKey(parent_ino: 1, name_hash: 1), NsIno(value: 1)).unwrap()
        tree.insert(NsDentryKey(parent_ino: 1, name_hash: 2), NsIno(value: 2)).unwrap()
        val lo = NsDentryKey(parent_ino: 1, name_hash: 1)
        val hi = NsDentryKey(parent_ino: 1, name_hash: 3)
        val results = tree.range_scan(lo, hi).unwrap()
        expect(results.len()).to_equal(3)  # oracle: value fixed by the spec contract
        expect(results[0].1.value).to_equal(1)  # oracle: value fixed by the spec contract
        expect(results[2].1.value).to_equal(3)  # oracle: value fixed by the spec contract

    it "range scan with no matches returns empty list":
        step("Verify: range scan with no matches returns empty list")
        # @req: REQ-STORAGE-DbfsEngiBtre-001
        val tree = NsBTree.new()
        tree.insert(NsDentryKey(parent_ino: 1, name_hash: 100), NsIno(value: 1)).unwrap()
        val lo = NsDentryKey(parent_ino: 1, name_hash: 200)
        val hi = NsDentryKey(parent_ino: 1, name_hash: 300)
        val results = tree.range_scan(lo, hi).unwrap()
        expect(results.len()).to_equal(0)  # oracle: value fixed by the spec contract

describe "DBFS B-Tree — delete":
    """Delete removes the entry; subsequent lookup returns None."""

    it "delete then lookup returns None":
        step("Verify: delete then lookup returns None")
        # @req: REQ-STORAGE-DbfsEngiBtre-001
        val tree = NsBTree.new()
        val key = NsDentryKey(parent_ino: 1, name_hash: 0x55)
        tree.insert(key, NsIno(value: 7)).unwrap()
        tree.delete(key).unwrap()
        val got = tree.lookup(key)
        expect(got.is_none()).to_equal(true)

    it "delete missing key returns ok (idempotent)":
        step("Verify: delete missing key returns ok (idempotent)")
        # @req: REQ-STORAGE-DbfsEngiBtre-001
        val tree = NsBTree.new()
        val key = NsDentryKey(parent_ino: 5, name_hash: 0xFF)
        val r = tree.delete(key)
        expect(r.is_ok()).to_equal(true)

describe "DBFS B-Tree — MVCC snapshot":
    """Snapshot read at generation G sees only writes <= G."""

    it "snapshot at older gen does not see newer insert":
        step("Verify: snapshot at older gen does not see newer insert")
        # @req: REQ-STORAGE-DbfsEngiBtre-001
        val tree = NsBTree.new()
        val snap_gen: i64 = tree.current_gen()
        val key = NsDentryKey(parent_ino: 1, name_hash: 0xAA)
        tree.insert(key, NsIno(value: 99)).unwrap()
        val got = tree.lookup_at_gen(key, snap_gen)
        expect(got.is_none()).to_equal(true)
