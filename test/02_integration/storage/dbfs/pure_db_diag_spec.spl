"""
## Purpose and audience

DBFS PureSQL engine diagnostics: pin down ACTUAL comparison, rollback and
NULL behaviour of `PureDatabase` as row COUNTS (never indexing a possibly-
empty result), so one run answers every open question about the engine.
Audience: DBFS/pure-sql engine maintainers triaging storage-semantics drift.

## Operator workflow

Run `simple run test/02_integration/storage/dbfs/pure_db_diag_spec.spl`
against a scratch `.sdb` file; each scenario prints labelled DIAG counts
and asserts the authoritative count for its probe.

## Compatibility and limitations

Hosted-only (in-process PureDatabase over a temp file); it does not touch
the on-disk DBFS image format or the NVFS mount path. Diagnostics report
counts, not cell payloads, beyond the labelled per-row prints.

## Verification guidance and troubleshooting

A failure names the probe whose count moved (real-comparison, rollback,
control-table, NULL); rerun the single file to reproduce with a fresh
scratch database. `file_delete` cleanup means no state survives a run.
"""
# Lifecycle: research doc/01_research/os/nvfs/nvfs_completion.md ;
# plan doc/03_plan/os/storage/nvfs_dbfs_real_filesystem.md ;
# architecture doc/04_architecture/os/dbfs_architecture.md ;
# design doc/05_design/os/storage/dbfs_root_mount_seal_v1.md

use std.io_runtime.{file_delete, getpid, time_now_unix_micros}
use std.spec.{describe, it, expect}
use nogc_sync_mut.database.pure_sql.database.{PureDatabase}

# Diagnostic probes: report ACTUAL engine behaviour as counts (never index a
# possibly-empty result), so one run pins down every open question.

fn _tmp_path(tag: text) -> text:
    "/tmp/simple_puresql_diag_" + tag + "_" + getpid().to_text() + "_" + time_now_unix_micros().to_text() + ".sdb"

describe "DIAG real column":
    # @manual_section: dbfs-puresql-real-comparison
    it "reports counts for REAL comparisons":
        # @req REQ-DBFS-DIAG-001
        # @capture(statistics): labelled DIAG counts for REAL >, < and range probes
        step("Open a scratch database and insert two REAL rows (2.5 and 30.0)")
        val path = _tmp_path("real")
        file_delete(path)
        var db = PureDatabase.open(path).unwrap()
        db.exec_sql("CREATE TABLE pr (id INTEGER, amount REAL)").unwrap()
        db.exec_sql("INSERT INTO pr (id, amount) VALUES (1, 2.5)").unwrap()
        db.exec_sql("INSERT INTO pr (id, amount) VALUES (2, 30.0)").unwrap()
        step("Probe the engine with integer and float comparison literals")
        val all = db.query("SELECT * FROM pr", []).unwrap()
        print("DIAG real all=" + all.len().to_text())
        if all.len() > 0:
            print("DIAG real v0=" + all[0].values[1].to_text())
        val gt = db.query("SELECT * FROM pr WHERE amount > 10", []).unwrap()
        print("DIAG real gt10=" + gt.len().to_text())
        val gtf = db.query("SELECT * FROM pr WHERE amount > 10.0", []).unwrap()
        print("DIAG real gt10f=" + gtf.len().to_text())
        val lt = db.query("SELECT * FROM pr WHERE amount < 10", []).unwrap()
        print("DIAG real lt10=" + lt.len().to_text())
        val btw = db.query("SELECT * FROM pr WHERE amount > 1 AND amount < 100", []).unwrap()
        print("DIAG real range=" + btw.len().to_text())
        expect(all.len()).to_equal(2)  # oracle: the probe inserted exactly two REAL rows
        db.close().unwrap()
        file_delete(path)

describe "DIAG rollback update":
    # @manual_section: dbfs-puresql-rollback-update
    it "reports row state around a rolled-back UPDATE":
        # @req REQ-DBFS-DIAG-002
        # @capture(statistics): pre/mid/post row counts plus per-cell dumps around ROLLBACK
        step("Insert two rows, BEGIN, UPDATE one row, then ROLLBACK")
        val path = _tmp_path("rbu")
        file_delete(path)
        var db = PureDatabase.open(path).unwrap()
        db.exec_sql("CREATE TABLE ru (id INTEGER, n INTEGER)").unwrap()
        db.exec_sql("INSERT INTO ru (id, n) VALUES (1, 10)").unwrap()
        db.exec_sql("INSERT INTO ru (id, n) VALUES (2, 20)").unwrap()
        val pre = db.query("SELECT * FROM ru", []).unwrap()
        print("DIAG rbu pre_all=" + pre.len().to_text())
        db.exec_sql("BEGIN").unwrap()
        db.exec_sql("UPDATE ru SET n = 999 WHERE id = 1").unwrap()
        val mid = db.query("SELECT * FROM ru", []).unwrap()
        print("DIAG rbu mid_all=" + mid.len().to_text())
        db.exec_sql("ROLLBACK").unwrap()
        step("Re-read the table after ROLLBACK and dump every surviving cell")
        val post = db.query("SELECT * FROM ru", []).unwrap()
        print("DIAG rbu post_all=" + post.len().to_text())
        var i = 0
        while i < post.len():
            print("DIAG rbu row ncols=" + post[i].columns.len().to_text() + " nvals=" + post[i].values.len().to_text())
            var j = 0
            while j < post[i].values.len():
                print("DIAG rbu   cell[" + j.to_text() + "]=" + post[i].values[j].to_text())
                j = j + 1
            i = i + 1
        val one = db.query("SELECT * FROM ru WHERE id = 1", []).unwrap()
        print("DIAG rbu post_id1=" + one.len().to_text())
        expect(pre.len()).to_equal(2)  # oracle: the table held two rows before the transaction began
        db.close().unwrap()
        file_delete(path)

describe "DIAG rollback update no index read":
    # @manual_section: dbfs-puresql-rollback-no-warm-read
    it "reports rolled-back UPDATE without a prior warm read":
        # @req REQ-DBFS-DIAG-003
        # @capture(statistics): post-rollback counts without a warm read plus control-table nvals
        step("UPDATE inside BEGIN/ROLLBACK with no prior read of the table")
        val path = _tmp_path("rbu2")
        file_delete(path)
        var db = PureDatabase.open(path).unwrap()
        db.exec_sql("CREATE TABLE rv (id INTEGER, n INTEGER)").unwrap()
        db.exec_sql("INSERT INTO rv (id, n) VALUES (1, 10)").unwrap()
        db.exec_sql("BEGIN").unwrap()
        db.exec_sql("UPDATE rv SET n = 999 WHERE id = 1").unwrap()
        db.exec_sql("ROLLBACK").unwrap()
        val post = db.query("SELECT * FROM rv", []).unwrap()
        print("DIAG rbu2 post_all=" + post.len().to_text())
        var i = 0
        while i < post.len():
            print("DIAG rbu2 row ncols=" + post[i].columns.len().to_text() + " nvals=" + post[i].values.len().to_text())
            var j = 0
            while j < post[i].values.len():
                print("DIAG rbu2   cell[" + j.to_text() + "]=" + post[i].values[j].to_text())
                j = j + 1
            i = i + 1
        step("Read the never-transacted control table as the shape baseline")
        # Control: a table never touched by a transaction must keep both columns.
        db.exec_sql("CREATE TABLE ctl (id INTEGER, n INTEGER)").unwrap()
        db.exec_sql("INSERT INTO ctl (id, n) VALUES (7, 70)").unwrap()
        val ctl = db.query("SELECT * FROM ctl", []).unwrap()
        if ctl.len() > 0:
            print("DIAG ctl nvals=" + ctl[0].values.len().to_text())
        expect(ctl.len()).to_equal(1)  # oracle: the control table holds exactly its one inserted row
        db.close().unwrap()
        file_delete(path)

describe "DIAG null":
    # @manual_section: dbfs-puresql-null-comparison
    it "reports NULL comparison counts":
        # @req REQ-DBFS-DIAG-004
        # @capture(statistics): = NULL, !=, NOT = and IS NULL match counts on a NULL cell
        step("Insert one NULL name and one real name, then compare all four ways")
        val path = _tmp_path("null")
        file_delete(path)
        var db = PureDatabase.open(path).unwrap()
        db.exec_sql("CREATE TABLE nu (id INTEGER, name TEXT)").unwrap()
        db.exec_sql("INSERT INTO nu (id, name) VALUES (1, NULL)").unwrap()
        db.exec_sql("INSERT INTO nu (id, name) VALUES (2, 'bob')").unwrap()
        val eqnull = db.query("SELECT * FROM nu WHERE name = NULL", []).unwrap()
        print("DIAG null eq_null=" + eqnull.len().to_text())
        val ne = db.query("SELECT * FROM nu WHERE name != 'alice'", []).unwrap()
        print("DIAG null ne_alice=" + ne.len().to_text())
        val notq = db.query("SELECT * FROM nu WHERE NOT (name = 'bob')", []).unwrap()
        print("DIAG null not_eq_bob=" + notq.len().to_text())
        val isn = db.query("SELECT * FROM nu WHERE name IS NULL", []).unwrap()
        print("DIAG null is_null=" + isn.len().to_text())
        expect(isn.len()).to_equal(1)  # oracle: exactly the one NULL-name row satisfies IS NULL
        db.close().unwrap()
        file_delete(path)
