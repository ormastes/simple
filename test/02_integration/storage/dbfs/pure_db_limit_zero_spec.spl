use std.spec.{describe, it, expect}
use nogc_sync_mut.database.pure_sql.database.{PureDatabase}

describe "PureDatabase LIMIT 0":
    it "returns zero rows for an explicit LIMIT 0":
        var db = PureDatabase.memory().unwrap()
        db.exec_sql("CREATE TABLE t (id INTEGER)").unwrap()
        db.exec_sql("INSERT INTO t (id) VALUES (1)").unwrap()
        db.exec_sql("INSERT INTO t (id) VALUES (2)").unwrap()
        db.exec_sql("INSERT INTO t (id) VALUES (3)").unwrap()

        val rows = db.query("SELECT * FROM t LIMIT 0", []).unwrap()
        expect(rows.len()).to_equal(0)
