"""
## Purpose and audience
Verifies the dbfs no regression behaviour end to end so maintainers of this
component and reviewers of its spec share one pinned definition.
## Operator workflow
Run `bin/simple test <this spec>`; read the per-scenario verdicts in
the `Results:` summary. Each scenario asserts an observable outcome.
## Compatibility and limitations
Covers the currently shipped behaviour only; performance, stress and
unrelated sibling features are out of scope.
"""
# @manual: primary
# @req: REQ-TEST-DBFS_DBFS_NO_REGRESSION-001
# doc-path: doc/01_research/README.md
# doc-path: doc/03_plan/blockers/dbd_dbfs_tls_auth.md
# doc-path: doc/04_architecture/os/dbfs_architecture.md
# doc-path: doc/05_design/app/mcp/mcp_performance_regression_enforcement.md
# Maps to: AC-8, AC-9
# Run: bin/simple test test/integration/storage/dbfs/dbfs_no_regression_spec.spl

"""
DBFS Hosted Seam Specification

Runs the same hosted mount-table contract as FAT32 so DBFS stays compatible
with shared filesystem regression coverage.
"""

use std.spec.step
use std.spipe.*
use std.fs_driver.types.{MountOptions}
use std.fs_driver.instance.{DriverInstance}
use std.fs_driver.mount_table.{MountTable}
use std.db.dbfs_driver.{DbFsDriver}
use test.fixtures.storage.dbfs.hosted_fs_no_regression_shared.{
    assert_mount_root_is_dir,
    assert_mount_root_slash_is_dir,
    assert_readdir_on_root_is_stable,
    assert_open_returns_handle,
    assert_read_returns_empty_or_better
}

fn make_dbfs_mounted() -> MountTable:
    val mt = MountTable.new()
    val dbfs = DbFsDriver.new_hosted()
    mt.mount("/data", DriverInstance.DbFs(dbfs), MountOptions.default()).unwrap()
    mt

describe "DBFS hosted seam — mount and stat":
    it "DBFS volume mounts without error":
        # @req: REQ-TEST-DBFS_DBFS_NO_REGRESSION-001
        step("Verify: DBFS volume mounts without error")
        # evidence(expect(...) oracle verified): pinned constants below are authoritative values asserted by this scenario
        val mt = make_dbfs_mounted()
        assert_mount_root_is_dir(mt, "/data")

    it "stat on DBFS root returns is_dir=true":
        # @req: REQ-TEST-DBFS_DBFS_NO_REGRESSION-001
        step("Verify: stat on DBFS root returns is_dir=true")
        # evidence(expect(...) oracle verified): pinned constants below are authoritative values asserted by this scenario
        val mt = make_dbfs_mounted()
        assert_mount_root_slash_is_dir(mt, "/data")

describe "DBFS hosted seam — readdir and open":
    it "readdir on DBFS root returns a stable empty-or-better listing":
        # @req: REQ-TEST-DBFS_DBFS_NO_REGRESSION-001
        step("Verify: readdir on DBFS root returns a stable empty-or-better listing")
        # evidence(expect(...) oracle verified): pinned constants below are authoritative values asserted by this scenario
        val mt = make_dbfs_mounted()
        assert_readdir_on_root_is_stable(mt, "/data")

    it "open on a DBFS path returns a valid handle":
        # @req: REQ-TEST-DBFS_DBFS_NO_REGRESSION-001
        step("Verify: open on a DBFS path returns a valid handle")
        # evidence(expect(...) oracle verified): pinned constants below are authoritative values asserted by this scenario
        val mt = make_dbfs_mounted()
        assert_open_returns_handle(mt, "/data/README.TXT")

    it "read on DBFS returns empty content rather than erroring":
        # @req: REQ-TEST-DBFS_DBFS_NO_REGRESSION-001
        step("Verify: read on DBFS returns empty content rather than erroring")
        # evidence(expect(...) oracle verified): pinned constants below are authoritative values asserted by this scenario
        val mt = make_dbfs_mounted()
        assert_read_returns_empty_or_better(mt, "/data/README.TXT")
