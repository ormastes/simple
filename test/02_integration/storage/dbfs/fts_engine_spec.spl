"""
## Purpose and audience
Purpose: tokenizes simple text into lowercase terms
Audience: compiler and tooling engineers who maintain this spec

FTS Engine Specification

Verifies full-text search engine components:
  - Tokenizer: tokenization, stop words, positions
  - Inverted index: indexing, search, removal
  - BM25: scoring and ranking
  - Trigram: trigram generation, substring search
  - Fuzzy: Levenshtein distance, fuzzy matching
  - FtsEngine: unified search API
"""

# @req: REQ-STORAGE-FtsEngi-001

use std.io_runtime
use std.spipe.*
use std.db.dbfs_engine.fts.tokenizer.{FtsToken, fts_tokenize, fts_tokenize_raw}
use std.db.dbfs_engine.fts.inverted_index.{FtsInvertedIndex, FtsPosting}
use std.db.dbfs_engine.fts.bm25.{fts_bm25_search, fts_bm25_score, fts_bm25_score_fixed, fts_bm25_explain, FtsSearchResult}
use std.db.dbfs_engine.fts.trigram.{FtsTrigramIndex, fts_generate_trigrams}
use std.db.dbfs_engine.fts.fuzzy.{fts_levenshtein, fts_fuzzy_match}
use std.db.dbfs_engine.fts.search.{FtsEngine, FtsCompatibilityIndex}
use std.db.dbfs_engine.fts.wave4_compatibility.{DBFS_W4_SCOPE, DbfsWave4Document, dbfs_wave4_golden_index}
use std.common.crypto.sha256.{sha256_text}
use std.common.search.ranking.{bm25_score_default}

# ── Tokenizer ──────────────────────────────────────────────────────────────────

use std.spec.step
describe "FTS Tokenizer":
    it "tokenizes simple text into lowercase terms":
        step("Verify: tokenizes simple text into lowercase terms")
        # @req: REQ-STORAGE-FtsEngi-001
        val tokens = fts_tokenize("Hello World")
        expect(tokens.len()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(tokens[0].term).to_equal("hello")
        expect(tokens[1].term).to_equal("world")

    it "filters stop words":
        step("Verify: filters stop words")
        # @req: REQ-STORAGE-FtsEngi-001
        val tokens = fts_tokenize("the quick brown fox is in the house")
        # "the", "is", "in", "the" are stop words -> removed
        # remaining: quick, brown, fox, house
        expect(tokens.len()).to_equal(4)  # oracle: value fixed by the spec contract
        expect(tokens[0].term).to_equal("quick")
        expect(tokens[1].term).to_equal("brown")
        expect(tokens[2].term).to_equal("fox")
        expect(tokens[3].term).to_equal("house")

    it "tracks positions after stop word removal":
        step("Verify: tracks positions after stop word removal")
        # @req: REQ-STORAGE-FtsEngi-001
        val tokens = fts_tokenize("Hello World")
        expect(tokens[0].position).to_equal(0)  # oracle: value fixed by the spec contract
        expect(tokens[1].position).to_equal(1)  # oracle: value fixed by the spec contract

    it "raw tokenize preserves stop words":
        step("Verify: raw tokenize preserves stop words")
        # @req: REQ-STORAGE-FtsEngi-001
        val raw = fts_tokenize_raw("the quick fox")
        expect(raw.len()).to_equal(3)  # oracle: value fixed by the spec contract
        expect(raw[0]).to_equal("the")

    it "splits on punctuation":
        step("Verify: splits on punctuation")
        # @req: REQ-STORAGE-FtsEngi-001
        val tokens = fts_tokenize_raw("hello,world.test")
        expect(tokens.len()).to_equal(3)  # oracle: value fixed by the spec contract
        expect(tokens[0]).to_equal("hello")
        expect(tokens[1]).to_equal("world")
        expect(tokens[2]).to_equal("test")

# ── Inverted Index ─────────────────────────────────────────────────────────────

describe "FTS Inverted Index":
    it "indexes a document and finds terms":
        step("Verify: indexes a document and finds terms")
        # @req: REQ-STORAGE-FtsEngi-001
        var idx = FtsInvertedIndex.new()
        idx.index_document(1, "hello world hello")
        val results = idx.search("hello")
        expect(results.len()).to_equal(1)  # oracle: value fixed by the spec contract
        val first = results[0]
        expect(first.doc_id).to_equal(1)  # oracle: value fixed by the spec contract
        expect(first.term_freq).to_equal(2)  # oracle: value fixed by the spec contract

    it "tracks document count":
        step("Verify: tracks document count")
        # @req: REQ-STORAGE-FtsEngi-001
        var idx = FtsInvertedIndex.new()
        idx.index_document(1, "hello world")
        idx.index_document(2, "world test")
        expect(idx.doc_count()).to_equal(2)  # oracle: value fixed by the spec contract

    it "returns empty for unknown terms":
        step("Verify: returns empty for unknown terms")
        # @req: REQ-STORAGE-FtsEngi-001
        var idx = FtsInvertedIndex.new()
        idx.index_document(1, "hello world")
        val results = idx.search("unknown")
        expect(results.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "removes a document from index":
        step("Verify: removes a document from index")
        # @req: REQ-STORAGE-FtsEngi-001
        var idx = FtsInvertedIndex.new()
        idx.index_document(1, "hello world")
        idx.index_document(2, "hello test")
        idx.remove_document(1)
        expect(idx.doc_count()).to_equal(1)  # oracle: value fixed by the spec contract
        val results = idx.search("hello")
        val rlen = results.len() as i64
        expect(rlen).to_equal(1)  # oracle: value fixed by the spec contract
        val first = results[0]
        expect(first.doc_id).to_equal(2)  # oracle: value fixed by the spec contract

    it "reports doc_freq correctly":
        step("Verify: reports doc_freq correctly")
        # @req: REQ-STORAGE-FtsEngi-001
        var idx = FtsInvertedIndex.new()
        idx.index_document(1, "hello world")
        idx.index_document(2, "hello test")
        expect(idx.doc_freq("hello")).to_equal(2)  # oracle: value fixed by the spec contract
        expect(idx.doc_freq("world")).to_equal(1)  # oracle: value fixed by the spec contract

    it "replaces a document without inflating corpus statistics":
        step("Verify: replacement preserves exact corpus statistics")
        # @req: REQ-STORAGE-FtsEngi-001
        var idx = FtsInvertedIndex.new()
        idx.index_document(7, "alpha beta beta")
        idx.index_document(7, "gamma")
        expect(idx.doc_count()).to_equal(1)
        expect(idx.doc_length(7)).to_equal(1)
        expect(idx.avg_doc_length_fixed()).to_equal(1000000)
        expect(idx.doc_freq("beta")).to_equal(0)
        expect(idx.doc_freq("gamma")).to_equal(1)

# ── BM25 Scoring ──────────────────────────────────────────────────────────────

describe "FTS BM25 Scoring":
    it "produces non-zero score for matching terms":
        step("Verify: produces non-zero score for matching terms")
        # @req: REQ-STORAGE-FtsEngi-001
        val sc = fts_bm25_score(2, 1, 5, 5, 10)
        expect(sc > 0).to_equal(true)

    it "scores zero when tf is zero":
        step("Verify: scores zero when tf is zero")
        # @req: REQ-STORAGE-FtsEngi-001
        val sc = fts_bm25_score(0, 1, 5, 5, 10)
        expect(sc).to_equal(0)  # oracle: value fixed by the spec contract

    it "ranks documents by relevance":
        step("Verify: ranks documents by relevance")
        # @req: REQ-STORAGE-FtsEngi-001
        var idx = FtsInvertedIndex.new()
        idx.index_document(1, "simple simple simple database")
        idx.index_document(2, "simple query")
        idx.index_document(3, "complex database system")
        val results = fts_bm25_search(idx, "simple")
        val rlen = results.len() as i64
        expect(rlen > 0).to_equal(true)
        val first = results[0]
        expect(first.doc_id).to_equal(1)  # oracle: value fixed by the spec contract

    it "uses exact lengths and deterministic ascending id ties":
        step("Verify: BM25 uses exact document lengths and stable tie ordering")
        # @req: REQ-STORAGE-FtsEngi-001
        var idx = FtsInvertedIndex.new()
        idx.index_document(9, "needle short")
        idx.index_document(3, "needle short")
        idx.index_document(12, "needle with many additional searchable tokens")
        val results = fts_bm25_search(idx, "needle")
        expect(results.len()).to_equal(3)
        expect(results[0].doc_id).to_equal(3)
        expect(results[1].doc_id).to_equal(9)
        expect(results[0].score).to_equal(results[1].score)
        expect(results[1].score > results[2].score).to_equal(true)

    it "matches the canonical scorer on the golden corpus term vector":
        step("Verify: DBFS exact facade has canonical bm25-fixed-v1 parity")
        # @req: REQ-STORAGE-FtsEngi-001
        val facade_score = fts_bm25_score_fixed(3, 2, 4, 4500000, 5)
        val canonical_score = bm25_score_default([3], [2], 4, 4500000, 5)
        expect(facade_score).to_equal(canonical_score.raw_value())
        val explanation = fts_bm25_explain(3, 2, 4, 4500000, 5)
        expect(explanation.score_contract).to_equal("bm25-fixed-v1")
        expect(explanation.score_milli).to_equal(facade_score)
        expect(explanation.average_document_length_fixed).to_equal(4500000)

# ── Trigram Index ──────────────────────────────────────────────────────────────

describe "FTS Trigram Index":
    it "generates trigrams from text":
        step("Verify: generates trigrams from text")
        # @req: REQ-STORAGE-FtsEngi-001
        val tris = fts_generate_trigrams("hello")
        # "hel", "ell", "llo"
        expect(tris.len()).to_equal(3)  # oracle: value fixed by the spec contract
        expect(tris[0]).to_equal("hel")
        expect(tris[1]).to_equal("ell")
        expect(tris[2]).to_equal("llo")

    it "returns empty for short text":
        step("Verify: returns empty for short text")
        # @req: REQ-STORAGE-FtsEngi-001
        val tris = fts_generate_trigrams("ab")
        expect(tris.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "finds documents by substring":
        step("Verify: finds documents by substring")
        # @req: REQ-STORAGE-FtsEngi-001
        var tri = FtsTrigramIndex.new()
        tri.index_document(1, "hello world")
        tri.index_document(2, "goodbye world")
        val results = tri.search("hello")
        expect(results.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(results[0]).to_equal(1)  # oracle: value fixed by the spec contract

    it "finds documents matching all trigrams":
        step("Verify: finds documents matching all trigrams")
        # @req: REQ-STORAGE-FtsEngi-001
        var tri = FtsTrigramIndex.new()
        tri.index_document(1, "hello world")
        tri.index_document(2, "hello there")
        val results = tri.search("world")
        expect(results.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(results[0]).to_equal(1)  # oracle: value fixed by the spec contract

    it "removes a document from trigram index":
        step("Verify: removes a document from trigram index")
        # @req: REQ-STORAGE-FtsEngi-001
        var tri = FtsTrigramIndex.new()
        tri.index_document(1, "hello world")
        tri.remove_document(1)
        val results = tri.search("hello")
        expect(results.len()).to_equal(0)  # oracle: value fixed by the spec contract

# ── Fuzzy Search ───────────────────────────────────────────────────────────────

describe "FTS Fuzzy Search":
    it "computes zero distance for identical strings":
        step("Verify: computes zero distance for identical strings")
        # @req: REQ-STORAGE-FtsEngi-001
        expect(fts_levenshtein("hello", "hello")).to_equal(0)  # oracle: value fixed by the spec contract

    it "computes distance 1 for single edit":
        step("Verify: computes distance 1 for single edit")
        # @req: REQ-STORAGE-FtsEngi-001
        expect(fts_levenshtein("hello", "helo")).to_equal(1)  # oracle: value fixed by the spec contract

    it "computes distance for substitution":
        step("Verify: computes distance for substitution")
        # @req: REQ-STORAGE-FtsEngi-001
        expect(fts_levenshtein("cat", "bat")).to_equal(1)  # oracle: value fixed by the spec contract

    it "computes distance for insertion":
        step("Verify: computes distance for insertion")
        # @req: REQ-STORAGE-FtsEngi-001
        expect(fts_levenshtein("cat", "cats")).to_equal(1)  # oracle: value fixed by the spec contract

    it "handles empty strings":
        step("Verify: handles empty strings")
        # @req: REQ-STORAGE-FtsEngi-001
        expect(fts_levenshtein("", "abc")).to_equal(3)  # oracle: value fixed by the spec contract
        expect(fts_levenshtein("abc", "")).to_equal(3)  # oracle: value fixed by the spec contract

    it "fuzzy matches within distance threshold":
        step("Verify: fuzzy matches within distance threshold")
        # @req: REQ-STORAGE-FtsEngi-001
        val candidates: [text] = ["hello", "helo", "world", "help", "hallo"]
        val matches = fts_fuzzy_match("hello", candidates, 1)
        expect(matches.len()).to_equal(3)  # oracle: value fixed by the spec contract

# ── FtsEngine Unified ──────────────────────────────────────────────────────────

describe "FTS Engine":
    it "emits exact Wave 4 five-field root stats scores order and explanations":
        step("Verify: DBFS executable parity evidence matches the locked canonical fixture")
        var index = dbfs_wave4_golden_index()
        expect(index.logical_root()).to_equal("sha256:8cd7ac31569e67b132a477ed1e5e66cc610a9119f0bf899b8fee26d5d27e90dd")
        val identifier = index.field_stats("identifier")
        val title = index.field_stats("title")
        val heading = index.field_stats("heading")
        val classification = index.field_stats("classification")
        val body = index.field_stats("body")
        expect(identifier.total_length).to_equal(11)
        expect(title.total_length).to_equal(4)
        expect(heading.total_length).to_equal(6)
        expect(classification.total_length).to_equal(3)
        expect(body.total_length).to_equal(5)
        val alpha = index.query(DBFS_W4_SCOPE, "alpha search").unwrap()
        expect(alpha.hits.len()).to_equal(2)
        expect(alpha.hits[0].document_id).to_equal("A-ascii")
        expect(alpha.hits[0].score_milli).to_equal(5564)
        expect(alpha.hits[1].document_id).to_equal("A-é")
        expect(alpha.hits[1].score_milli).to_equal(5471)
        expect("sha256:" + sha256_text(alpha.hits[0].explanation_json)).to_equal("sha256:79a325595560360181d111119163260ab218ae630338542ed942e36f169f1040")
        expect("sha256:" + sha256_text(alpha.hits[1].explanation_json)).to_equal("sha256:8cd5535ac3cbd8631371e67e3e3d7c6bc5755f9c70fcfcc3a025e03a29055bf1")
        val exact = index.query(DBFS_W4_SCOPE, "REQ-SPKC-011").unwrap()
        expect(exact.hits[0].score_milli).to_equal(7407)
        expect(exact.hits[1].score_milli).to_equal(3625)
        val public = index.query_filtered(DBFS_W4_SCOPE, "alpha", "visibility", "public").unwrap()
        expect(public.hits.len()).to_equal(2)
        expect(index.query_filtered(DBFS_W4_SCOPE, "alpha", "visibility", "private").unwrap().hits.len()).to_equal(0)
        expect(index.query_filtered(DBFS_W4_SCOPE, "alpha", "unknown", "value").unwrap_err()).to_equal("unsupported_filter")
        expect(index.query(DBFS_W4_SCOPE, "\"alpha search\"").unwrap_err()).to_equal("unsupported_capability")
        expect(index.query("sha256:" + "2" * 64, "secret-needle").unwrap_err()).to_equal("unsupported_scope")

        val base_count = index.document_count()
        expect(index.remove("A-absent")).to_equal(false)
        val no_op_root = index.logical_root()
        expect(no_op_root).to_equal("sha256:8cd7ac31569e67b132a477ed1e5e66cc610a9119f0bf899b8fee26d5d27e90dd")
        expect(index.contains_document("A-added")).to_equal(false)
        expect(index.add(DbfsWave4Document.of("A-added", "r1", "ID-EMPTY", "", "", "empty", "", "public", DBFS_W4_SCOPE)).is_ok()).to_equal(true)
        expect(index.contains_document("A-added")).to_equal(true)
        expect(index.add(DbfsWave4Document.of("A-ascii", "r2", "REQ-SPKC-011", "Alpha Search", "Alpha combining é", "search", "alpha replacement", "public", DBFS_W4_SCOPE)).is_ok()).to_equal(true)
        expect(index.remove("A-é")).to_equal(true)
        expect(index.document_count()).to_equal(base_count)
        var clean = dbfs_wave4_golden_index()
        clean.add(DbfsWave4Document.of("A-added", "r1", "ID-EMPTY", "", "", "empty", "", "public", DBFS_W4_SCOPE))
        clean.add(DbfsWave4Document.of("A-ascii", "r2", "REQ-SPKC-011", "Alpha Search", "Alpha combining é", "search", "alpha replacement", "public", DBFS_W4_SCOPE))
        clean.remove("A-é")
        expect(index.logical_root()).to_equal(clean.logical_root())

    it "upserts one document id across keyword and substring indexes":
        step("Verify: engine replacement removes stale lexical and trigram entries")
        # @req: REQ-STORAGE-FtsEngi-001
        var engine = FtsEngine.new()
        engine.add_document(4, "obsolete phrase")
        engine.add_document(4, "current phrase")
        expect(engine.search_keyword("obsolete").len()).to_equal(0)
        expect(engine.search_substring("obsolete").len()).to_equal(0)
        expect(engine.search_keyword("current").len()).to_equal(1)

    it "bridges text ids with public deterministic ties and honest capabilities":
        step("Verify: DBFS compatibility facade exposes its supported subset")
        # @req: REQ-STORAGE-FtsEngi-001
        var bridge = FtsCompatibilityIndex.new("tenant-a")
        val z_ordinal = bridge.add_document("zeta", "equal token")
        val a_ordinal = bridge.add_document("alpha", "equal token")
        expect(z_ordinal < a_ordinal).to_equal(true)
        val results = bridge.query("tenant-a", "equal").unwrap()
        expect(results.len()).to_equal(2)
        expect(results[0].document_id).to_equal("alpha")
        expect(results[1].document_id).to_equal("zeta")
        expect(results[0].score_milli).to_equal(results[1].score_milli)
        val caps = bridge.capabilities()
        expect(caps.lexical).to_equal(true)
        expect(caps.explain).to_equal(true)
        expect(caps.stats).to_equal(true)
        expect(caps.provider_protocol).to_equal(false)
        expect(caps.phrase).to_equal(false)

    it "rejects unsupported scope before reading index state":
        step("Verify: scope denial precedes lexical index access")
        # @req: REQ-STORAGE-FtsEngi-001
        var bridge = FtsCompatibilityIndex.new("tenant-a")
        bridge.add_document("doc-a", "private needle")
        val before = bridge.stats()
        val denied = bridge.query("tenant-b", "needle")
        expect(denied.unwrap_err()).to_equal("unsupported_scope")
        val after = bridge.stats()
        expect(after.query_reads).to_equal(before.query_reads)
        expect(after.document_count).to_equal(1)
        expect(after.total_tokens).to_equal(2)

    it "adds documents and searches by keyword":
        step("Verify: adds documents and searches by keyword")
        # @req: REQ-STORAGE-FtsEngi-001
        var engine = FtsEngine.new()
        engine.add_document(1, "quick brown fox jumps over lazy dog")
        engine.add_document(2, "slow red fox sleeps under tree")
        val results = engine.search_keyword("fox")
        val rlen = results.len() as i64
        expect(rlen).to_equal(2)  # oracle: value fixed by the spec contract

    it "searches by substring":
        step("Verify: searches by substring")
        # @req: REQ-STORAGE-FtsEngi-001
        var engine = FtsEngine.new()
        engine.add_document(1, "hello world testing")
        engine.add_document(2, "goodbye world testing")
        val results = engine.search_substring("hello")
        expect(results.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(results[0]).to_equal(1)  # oracle: value fixed by the spec contract

    it "combined search returns results":
        step("Verify: combined search returns results")
        # @req: REQ-STORAGE-FtsEngi-001
        var engine = FtsEngine.new()
        engine.add_document(1, "database query engine search")
        engine.add_document(2, "simple text search tool")
        val results = engine.search("search")
        val rlen = results.len() as i64
        expect(rlen > 0).to_equal(true)

    it "removes document from engine":
        step("Verify: removes document from engine")
        # @req: REQ-STORAGE-FtsEngi-001
        var engine = FtsEngine.new()
        engine.add_document(1, "hello world")
        engine.add_document(2, "hello test")
        engine.remove_document(1)
        val kw_results = engine.search_keyword("hello")
        val rlen = kw_results.len() as i64
        expect(rlen).to_equal(1)  # oracle: value fixed by the spec contract
        val first = kw_results[0]
        expect(first.doc_id).to_equal(2)  # oracle: value fixed by the spec contract
