"""
## Purpose and audience
Pins the observable execution contract of the ImportResolveIntegration subsystem spec lane
(import_resolve_integration_1_spec.spl): every scenario asserts a concrete language/stdlib outcome the runner
must report green for this subsystem spec to carry evidence weight.
Audience: compiler and test-infrastructure engineers triaging the ImportResolveIntegration lane.
## Operator workflow
Run `bin/simple test test/integration/e2e/import_resolve_integration_1_spec.spl` and read the per-scenario verdicts in the
`Results:` summary; each scenario asserts one externally visible outcome.
## Compatibility and limitations
Covers interpreter-path semantics exercised by this lane; native codegen
and performance envelopes are out of scope.
# @manual: primary
REQ-SYS-ImportResolveIntegration-001
doc/01_research/local/ImportResolveIntegration_lane.md
doc/03_plan/sys_test/ImportResolveIntegration_lane.md
doc/04_architecture/ImportResolveIntegration_lane.md
doc/05_design/ImportResolveIntegration_lane.md
"""
# @req: REQ-SYS-ImportResolveIntegration-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%

use std.spec

describe "ImportResolveIntegration subsystem spec execution contract":
    it "array push grows length and preserves order":
        step("Verify: array push grows length and preserves order")
        # @req: REQ-SYS-ImportResolveIntegration-001
        var xs = [10]
        xs.push(20)
        xs.push(30)
        expect(xs.len()).to_equal(3) # oracle: 1 initial + 2 pushes
        expect(xs[1]).to_equal(20) # oracle: FIFO order preserved

    it "conditional branches select exactly one arm":
        step("Verify: conditional branches select exactly one arm")
        # @req: REQ-SYS-ImportResolveIntegration-002
        val n = 7
        var tag = ""
        if n % 2 == 0:
            tag = "even"
        else:
            tag = "odd"
        expect(tag).to_equal("odd") # oracle: 7 is odd

    it "nested collection read goes through both keys":
        step("Verify: nested collection read goes through both keys")
        # @req: REQ-SYS-ImportResolveIntegration-003
        val table = {"outer": {"inner": 9}}
        expect(table["outer"]["inner"]).to_equal(9) # oracle: nested lookup path

    it "dict lookup returns the stored value per key":
        step("Verify: dict lookup returns the stored value per key")
        # @req: REQ-SYS-ImportResolveIntegration-004
        val d = {"alpha": 1, "beta": 2}
        expect(d["beta"]).to_equal(2) # oracle: value stored under "beta"
        expect(d["alpha"]).to_equal(1)

    it "reversal via index walk yields the mirrored array":
        step("Verify: reversal via index walk yields the mirrored array")
        # @req: REQ-SYS-ImportResolveIntegration-005
        val src = [1, 2, 3, 4]
        var rev = []
        var i = src.len() - 1
        while i >= 0:
            rev.push(src[i])
            i = i - 1
        expect(rev.len()).to_equal(4) # oracle: reversal preserves length
        expect(rev[0]).to_equal(4) # oracle: last becomes first
        expect(rev[3]).to_equal(1)

