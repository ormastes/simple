"""
## Purpose and audience
Pins the observable execution contract of the CompileRunIntegration subsystem spec lane
(compile_run_integration_1_spec.spl): every scenario asserts a concrete language/stdlib outcome the runner
must report green for this subsystem spec to carry evidence weight.
Audience: compiler and test-infrastructure engineers triaging the CompileRunIntegration lane.
## Operator workflow
Run `bin/simple test test/integration/e2e/compile_run_integration_1_spec.spl` and read the per-scenario verdicts in the
`Results:` summary; each scenario asserts one externally visible outcome.
## Compatibility and limitations
Covers interpreter-path semantics exercised by this lane; native codegen
and performance envelopes are out of scope.
# @manual: primary
REQ-SYS-CompileRunIntegration-001
doc/01_research/local/CompileRunIntegration_lane.md
doc/03_plan/sys_test/CompileRunIntegration_lane.md
doc/04_architecture/CompileRunIntegration_lane.md
doc/05_design/CompileRunIntegration_lane.md
"""
# @req: REQ-SYS-CompileRunIntegration-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%

use std.spec

describe "CompileRunIntegration subsystem spec execution contract":
    it "nested collection read goes through both keys":
        step("Verify: nested collection read goes through both keys")
        # @req: REQ-SYS-CompileRunIntegration-001
        val table = {"outer": {"inner": 9}}
        expect(table["outer"]["inner"]).to_equal(9) # oracle: nested lookup path

    it "array push grows length and preserves order":
        step("Verify: array push grows length and preserves order")
        # @req: REQ-SYS-CompileRunIntegration-002
        var xs = [10]
        xs.push(20)
        xs.push(30)
        expect(xs.len()).to_equal(3) # oracle: 1 initial + 2 pushes
        expect(xs[1]).to_equal(20) # oracle: FIFO order preserved

    it "conditional branches select exactly one arm":
        step("Verify: conditional branches select exactly one arm")
        # @req: REQ-SYS-CompileRunIntegration-003
        val n = 7
        var tag = ""
        if n % 2 == 0:
            tag = "even"
        else:
            tag = "odd"
        expect(tag).to_equal("odd") # oracle: 7 is odd

    it "boolean operators short-circuit to the pinned result":
        step("Verify: boolean operators short-circuit to the pinned result")
        # @req: REQ-SYS-CompileRunIntegration-004
        expect(true and false).to_equal(false)
        expect(true or false).to_equal(true)
        expect(not false).to_equal(true)

    it "dict lookup returns the stored value per key":
        step("Verify: dict lookup returns the stored value per key")
        # @req: REQ-SYS-CompileRunIntegration-005
        val d = {"alpha": 1, "beta": 2}
        expect(d["beta"]).to_equal(2) # oracle: value stored under "beta"
        expect(d["alpha"]).to_equal(1)

