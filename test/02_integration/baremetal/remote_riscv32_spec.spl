        step("Read the five feature rank constants")
        expect(FeatureRank.NATIVE()).to_equal(0)  # oracle: native backends rank best at 0
        expect(FeatureRank.BRIDGE()).to_equal(1)  # oracle: bridge backends rank second at 1
        expect(FeatureRank.SECONDARY()).to_equal(2)  # oracle: secondary backends rank third at 2
        expect(FeatureRank.EXTERNAL()).to_equal(3)  # oracle: external backends rank fourth at 3
        expect(FeatureRank.EMULATED()).to_equal(4)  # oracle: emulated backends rank last at 4
    slow_it "native is always preferred over bridge":
        # @req REQ-REMOTE-DEBUG-014
        # @capture(statistics): the native-over-bridge ordering verdict
        step("Compare native rank against bridge rank")
