    slow_it "bridge is preferred over emulated":
        # @req REQ-REMOTE-DEBUG-014
        # @capture(statistics): the bridge-over-emulated ordering verdict
        step("Compare bridge rank against emulated rank")
        expect(FeatureRank.BRIDGE() < FeatureRank.EMULATED()).to_equal(true)


