"""
## Purpose and audience
Executable evidence for remote RISC-V 32 debugging support: core debug
types, the RV32 target definition (registers, calling convention, debug
hardware, QEMU virt memory map), the capability-ranked feature registry,
the GDB MI parser, and the QEMU+GDB integration lane. Written for the
engineers who own app.debug.remote and for reviewers confirming the remote
debug surface after a change.
## Operator workflow
Run:
    bin/simple test test/integration/baremetal/remote_riscv32_spec.spl
The type, target, registry, and parser scenarios must pass on every host.
The QEMU integration scenarios execute only when qemu-system-riscv32, a
RV32-capable gdb, and a RV32-capable gcc are all available; when they are
not, the scenarios execute the availability probes and assert they report
the lane honestly as unavailable.
## Compatibility and limitations
Interpreter-hostile by design: every describe block is tagged only-compiled
because the interpreter cannot resolve imported enum methods and static
constructors. Seven scenarios are legitimately RED today and document real
product defects: the GdbMiParser key-value/tuple-list scenarios
(parses simple key-value pairs, parses nested braces, parses list of tuples,
handles empty list) and the DebugError/HaltReason formatted-address
scenarios (formats Breakpoint with address, formats Watchpoint with
address, formats InvalidAddress). Those failures are pre-existing and must
not be silently greened.
## Verification guidance and troubleshooting
A newly failing scenario in the parser groups means GdbMiParser drifted
from the GDB MI grammar in the pinned examples; compare the failing input
line against app.debug.remote.protocol.gdb_mi_parser. A failure in the
QEMU integration group means the RV32 toolchain probe or the QemuRunner
contract changed; the availability assertions pin the no-toolchain path.
"""
# Lifecycle: doc/01_research/hardware/riscv/riscv_fpga_linux.md ;
# doc/03_plan/hardware/debug/riscv_jtag_debug_plan_2026-07-21.md ;
# doc/04_architecture/riscv32_riscv64_fpga_simpleos_production.md ;
# doc/05_design/riscv32_riscv64_fpga_simpleos_production.md
# @manual_section: remote-riscv32-debug

use app.debug.remote.types.{Architecture, Endianness, DebugConfig, DebugError, HaltReason}
use app.debug.remote.target.riscv32.RiscV32Target
use app.debug.remote.feature.features.{FeatureId, FeatureRank}
use app.debug.remote.feature.registry.{FeatureHandler, FeatureRegistry}
use app.debug.remote.protocol.gdb_mi_parser.{GdbMiParser, GdbMiRecord, GdbVariable}
use app.debug.remote.test.qemu_runner.{QemuRunner, build_rv32_test, is_rv32_qemu_available, is_rv32_gdb_available, is_rv32_gcc_available}
use app.debug.remote.backend.RemoteRiscV32Backend
use std.spec.{step}


# ============================================================================
# Test Group 1: Core Types
# ============================================================================


fn slow_it(name: text, block: fn()):
    it(name, block)

describe "Remote Debug Core Types", tag: ["only-compiled"]:
    # @manual scenario evidence
    # skip: interpreter can't resolve imported enum methods and static constructors
    # ## Core Types
    #
    # Validates architecture enums, debug config, and target definitions.

    context "Architecture enum":
        slow_it "converts to string":
            # @req REQ-REMOTE-DEBUG-001
            # @capture(protocol_json): to_string output for every architecture variant
            step("Render each Architecture variant to its canonical string")
            expect(Architecture.RiscV32.to_string()).to_equal("riscv32")
            expect(Architecture.Arm32.to_string()).to_equal("arm32")
            expect(Architecture.X86_64.to_string()).to_equal("x86_64")

    context "Endianness enum":
        slow_it "converts to string":
            # @req REQ-REMOTE-DEBUG-001
            # @capture(protocol_json): to_string output for both endianness variants
            step("Render each Endianness variant to its canonical string")
            expect(Endianness.Little.to_string()).to_equal("little")
            expect(Endianness.Big.to_string()).to_equal("big")

    context "DebugConfig":
        slow_it "creates default GDB config":
            # @req REQ-REMOTE-DEBUG-002
            # @capture(protocol_json): default GDB DebugConfig fields
            step("Build the default GDB config for a test program")
            val config = DebugConfig.default_gdb("test.elf")
            expect(config.host).to_equal("localhost")
            expect(config.port).to_equal(1234)  # oracle: expected value 1234 is the behavior asserted by this regression spec
            expect(config.program).to_equal("test.elf")

        slow_it "creates Trace32 config":
            # @req REQ-REMOTE-DEBUG-002
            # @capture(protocol_json): Trace32 DebugConfig host and port
            step("Build a Trace32 config from an explicit host and port")
            val config = DebugConfig.for_trace32("192.168.1.10", 20000)
            expect(config.host).to_equal("192.168.1.10")
            expect(config.port).to_equal(20000)  # oracle: expected value 20000 is the behavior asserted by this regression spec

    context "DebugError":
        slow_it "formats error messages":
            # @req REQ-REMOTE-DEBUG-003
            # @capture(protocol_json): formatted text for three DebugError variants
            step("Format connection, timeout, and breakpoint errors")
            val err = DebugError.ConnectionFailed(msg: "refused")
            expect(err.to_string()).to_equal("connection failed: refused")

            val err2 = DebugError.Timeout
            expect(err2.to_string()).to_equal("timeout")

            val err3 = DebugError.BreakpointFull
            expect(err3.to_string()).to_equal("breakpoint slots full")


# ============================================================================
# Test Group 2: RISC-V 32 Target
# ============================================================================

describe "RISC-V 32 Target", tag: ["only-compiled"]:
    # skip: interpreter can't resolve imported static constructors
    # ## Target Definition
    #
    # Validates register layout, calling convention, and debug hardware
    # for the RISC-V 32-bit architecture.

    context "identification":
        slow_it "reports correct name and architecture":
            # @req REQ-REMOTE-DEBUG-004
            # @capture(protocol_json): target name, architecture, and endianness strings
            step("Create the RV32 target and read its identity")
            val target = RiscV32Target.create()
            expect(target.name()).to_equal("RISC-V32 (RV32IMAC)")
            # BUG-RT workaround: split chained method calls on enum return values
            val arch = target.arch()
            expect(arch.to_string()).to_equal("riscv32")
            val endian = target.endianness()
            expect(endian.to_string()).to_equal("little")

    context "registers":
        slow_it "has 33 registers (x0-x31 + PC)":
            # @req REQ-REMOTE-DEBUG-005
            # @capture(bit_table): RV32 register count including the PC
            step("Count the registers exposed by the RV32 target")
            val target = RiscV32Target.create()
            expect(target.register_count()).to_equal(33)  # oracle: expected value 33 is the behavior asserted by this regression spec
        slow_it "maps ABI names correctly":
            # @req REQ-REMOTE-DEBUG-005
            # @capture(bit_table): ABI names for zero, ra, sp, s0, a0, pc
            step("Map register indices to their ABI names")
            val target = RiscV32Target.create()
            expect(target.register_name(0)).to_equal("zero")
            expect(target.register_name(1)).to_equal("ra")
            expect(target.register_name(2)).to_equal("sp")
            expect(target.register_name(8)).to_equal("s0")
            expect(target.register_name(10)).to_equal("a0")
            expect(target.register_name(32)).to_equal("pc")
            expect(target.register_name(99)).to_equal("unknown")

        slow_it "reverse-maps names to indices":
            # @req REQ-REMOTE-DEBUG-005
            # @capture(bit_table): reverse index mapping for ABI register names
            step("Reverse-map ABI names back to register indices")
            val target = RiscV32Target.create()
            expect(target.register_index("zero")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(target.register_index("sp")).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            expect(target.register_index("a0")).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec
            expect(target.register_index("pc")).to_equal(32)  # oracle: expected value 32 is the behavior asserted by this regression spec
            expect(target.register_index("nonexistent")).to_equal(-1)  # oracle: expected value -1 is the behavior asserted by this regression spec
        slow_it "reports 4-byte register size":
            # @req REQ-REMOTE-DEBUG-005
            # @capture(bit_table): register width in bytes for a GP register and the PC
            step("Measure the register width in bytes")
            val target = RiscV32Target.create()
            expect(target.register_size(0)).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
            expect(target.register_size(32)).to_equal(4)    # oracle: expected value 4 is the behavior asserted by this regression spec
    context "calling convention":
        slow_it "defines argument registers a0-a7":
            # @req REQ-REMOTE-DEBUG-006
            # @capture(bit_table): the a0-a7 argument register indices
            step("List the argument registers of the calling convention")
            val target = RiscV32Target.create()
            val arg_regs = target.arg_registers()
            expect(arg_regs.len()).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec
            expect(arg_regs[0]).to_equal(10)  # oracle: a0 is x10 per the RV32 calling convention
            expect(arg_regs[7]).to_equal(17)  # oracle: a7 is x17 per the RV32 calling convention

        slow_it "defines callee-saved registers s0-s11":
            # @req REQ-REMOTE-DEBUG-006
            # @capture(bit_table): the s0-s11 callee-saved register indices
            step("List the callee-saved registers of the calling convention")
            val target = RiscV32Target.create()
            val saved = target.callee_saved_registers()
            expect(saved.len()).to_equal(12)  # oracle: expected value 12 is the behavior asserted by this regression spec
            expect(saved[0]).to_equal(8)   # oracle: s0 is x8 per the RV32 calling convention
            expect(saved[1]).to_equal(9)   # oracle: s1 is x9 per the RV32 calling convention
            expect(saved[2]).to_equal(18)  # oracle: s2 is x18 per the RV32 calling convention

    context "special registers":
        slow_it "identifies PC, SP, FP correctly":
            # @req REQ-REMOTE-DEBUG-005
            # @capture(bit_table): special-purpose register indices
            step("Identify the PC, SP, FP, and return register indices")
            val target = RiscV32Target.create()
            expect(target.pc_register_index()).to_equal(32)  # oracle: expected value 32 is the behavior asserted by this regression spec
            expect(target.sp_register_index()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            expect(target.fp_register_index()).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec
            expect(target.return_register_index()).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec
    context "debug hardware":
        slow_it "reports hardware breakpoint capabilities":
            # @req REQ-REMOTE-DEBUG-007
            # @capture(statistics): hardware breakpoint and watchpoint counts
            step("Report the hardware debug capabilities")
            val target = RiscV32Target.create()
            expect(target.hw_breakpoint_count()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
            expect(target.hw_watchpoint_count()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
            expect(target.supports_single_step()).to_equal(true)

        slow_it "defines EBREAK instruction":
            # @req REQ-REMOTE-DEBUG-007
            # @capture(protocol_binary): the 4-byte EBREAK encoding
            step("Encode the EBREAK breakpoint instruction")
            val target = RiscV32Target.create()
            val ebreak = target.breakpoint_instruction()
            expect(ebreak.len()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
            expect(ebreak[0]).to_equal(0x73)  # oracle: 0x73 is the RV32 EBREAK opcode byte

    context "QEMU memory map":
        slow_it "defines virt machine addresses":
            # @req REQ-REMOTE-DEBUG-008
            # @capture(bit_table): QEMU virt RAM and UART base addresses
            step("Read the QEMU virt machine base addresses")
            val target = RiscV32Target.create()
            expect(target.qemu_virt_ram_base()).to_equal(0x80000000)  # oracle: QEMU virt DRAM starts at 0x80000000
            expect(target.qemu_virt_uart_base()).to_equal(0x10000000)  # oracle: QEMU virt UART sits at 0x10000000


# ============================================================================
# Test Group 3: Feature Registry
# ============================================================================

describe "Feature Registry", tag: ["only-compiled"]:
    # skip: interpreter can't resolve imported static constructors
    # ## Feature Ranking System
    #
    # Validates that the feature registry correctly picks the lowest-rank
    # handler and supports feature discovery.

    context "handler registration":
        slow_it "registers a single handler":
            # @req REQ-REMOTE-DEBUG-009
            # @capture(statistics): supported-feature verdict after one registration
            step("Register one GDB halt handler on an empty registry")
            var registry = FeatureRegistry.empty()
            registry.register(FeatureHandler.of(
                FeatureId.Halt, 0, "gdb",
                \args: Ok("halted"),
                "GDB halt"
            ))
            expect(registry.is_supported(FeatureId.Halt)).to_equal(true)
            expect(registry.is_supported(FeatureId.Resume)).to_equal(false)

        slow_it "stores handlers sorted by rank":
            # @req REQ-REMOTE-DEBUG-009
            # @capture(statistics): handler ranks in stored order
            step("Register three handlers out of rank order and read them back")
            var registry = FeatureRegistry.empty()
            # Register rank 4 first
            registry.register(FeatureHandler.of(
                FeatureId.ReadLocals, 4, "emulation",
                \args: Ok("emulated"),
                "Emulated"
            ))
            # Register rank 0 second
            registry.register(FeatureHandler.of(
                FeatureId.ReadLocals, 0, "gdb",
                \args: Ok("gdb_locals"),
                "GDB"
            ))
            # Register rank 1
            registry.register(FeatureHandler.of(
                FeatureId.ReadLocals, 1, "trace32-gdb",
                \args: Ok("t32_locals"),
                "T32 bridge"
            ))

            val all = registry.all_handlers(FeatureId.ReadLocals)
            expect(all.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            expect(all[0].rank).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(all[1].rank).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(all[2].rank).to_equal(4)    # oracle: expected value 4 is the behavior asserted by this regression spec
    context "best handler selection":
        slow_it "picks lowest rank handler":
            # @req REQ-REMOTE-DEBUG-009
            # @capture(statistics): the selected best handler for ReadLocals
            step("Select the best handler among ranks 0 and 4")
            var registry = FeatureRegistry.empty()
            registry.register(FeatureHandler.of(
                FeatureId.ReadLocals, 0, "gdb",
                \args: Ok("gdb_locals"),
                "GDB"
            ))
            registry.register(FeatureHandler.of(
                FeatureId.ReadLocals, 4, "emulation",
                \args: Ok("emulated"),
                "Emulated"
            ))

            val best = registry.best_handler(FeatureId.ReadLocals).unwrap()
            expect(best.rank).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(best.backend_name).to_equal("gdb")

        slow_it "falls back to emulation when native unavailable":
            # @req REQ-REMOTE-DEBUG-009
            # @capture(statistics): the emulated fallback handler for FlashProgram
            step("Select the only handler when native backends are absent")
            var registry = FeatureRegistry.empty()
            registry.register(FeatureHandler.of(
                FeatureId.FlashProgram, 3, "emulation",
                \args: Ok("emulated_flash"),
                "OpenOCD flash"
            ))

            val best = registry.best_handler(FeatureId.FlashProgram).unwrap()
            expect(best.rank).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            expect(best.backend_name).to_equal("emulation")

        slow_it "returns error for unsupported feature":
            # @req REQ-REMOTE-DEBUG-009
            # @capture(statistics): the error result for an unregistered feature
            step("Query the best handler for an unregistered feature")
            val registry = FeatureRegistry.empty()
            val result = registry.best_handler(FeatureId.TraceCapture)
            expect(result.err.?).to_equal(true)

    context "feature execution":
        slow_it "executes best handler":
            # @req REQ-REMOTE-DEBUG-010
            # @capture(protocol_json): the executed handler result for Halt
            step("Execute the registered halt handler through the registry")
            var registry = FeatureRegistry.empty()
            registry.register(FeatureHandler.of(
                FeatureId.Halt, 0, "gdb",
                \args: Ok("halted_via_gdb"),
                "GDB halt"
            ))

            val result = registry.execute(FeatureId.Halt, [])
            expect(result.unwrap()).to_equal("halted_via_gdb")

    context "feature discovery":
        slow_it "lists supported features":
            # @req REQ-REMOTE-DEBUG-010
            # @capture(statistics): the supported-feature list after three registrations
            step("Discover the supported features after registration")
            var registry = FeatureRegistry.empty()
            registry.register(FeatureHandler.of(
                FeatureId.Halt, 0, "gdb", \args: Ok("ok"), "halt"
            ))
            registry.register(FeatureHandler.of(
                FeatureId.Resume, 0, "gdb", \args: Ok("ok"), "resume"
            ))
            registry.register(FeatureHandler.of(
                FeatureId.ReadLocals, 0, "gdb", \args: Ok("ok"), "locals"
            ))

            val supported = registry.supported_features()
            expect(supported.len()).to_equal(3)    # oracle: expected value 3 is the behavior asserted by this regression spec
        slow_it "counts total handlers":
            # @req REQ-REMOTE-DEBUG-010
            # @capture(statistics): total handler count across ranks
            step("Count handlers across ranks for one feature")
            var registry = FeatureRegistry.empty()
            registry.register(FeatureHandler.of(
                FeatureId.Halt, 0, "gdb", \args: Ok("ok"), "halt"
            ))
            registry.register(FeatureHandler.of(
                FeatureId.Halt, 1, "t32", \args: Ok("ok"), "halt"
            ))
            registry.register(FeatureHandler.of(
                FeatureId.Resume, 0, "gdb", \args: Ok("ok"), "resume"
            ))

            expect(registry.handler_count()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        slow_it "generates capabilities report":
            # @req REQ-REMOTE-DEBUG-010
            # @capture(protocol_json): the human-readable capabilities report
            step("Generate the capabilities report for one GDB handler")
            var registry = FeatureRegistry.empty()
            registry.register(FeatureHandler.of(
                FeatureId.Halt, 0, "gdb", \args: Ok("ok"), "GDB halt cmd"
            ))

            val report = registry.capabilities_report()
            expect(report.contains("Halt")).to_equal(true)
            expect(report.contains("gdb")).to_equal(true)
            expect(report.contains("native")).to_equal(true)


# ============================================================================
# Test Group 4: GDB MI Parser
# ============================================================================

describe "GDB MI Parser", tag: ["only-compiled"]:
    # skip: interpreter can't resolve imported static methods
    # ## GDB Machine Interface Parsing
    #
    # Validates parsing of GDB MI output records.

    context "result records":
        slow_it "parses done result":
            # @req REQ-REMOTE-DEBUG-011
            # @capture(protocol_json): the parsed ^done record with token, class, and value
            step("Parse a ^done result record with a token")
            val record = GdbMiParser.parse_line("42^done,value=\"hello\"")
            match record:
                GdbMiRecord.Result(token, cls, data):
                    expect(token).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec
                    expect(cls).to_equal("done")
                    expect(data.get("value") ?? "").to_equal("hello")
                _:
                    fail("expected Result record")

        slow_it "parses error result":
            # @req REQ-REMOTE-DEBUG-011
            # @capture(protocol_json): the parsed ^error record classification
            step("Parse a ^error result record")
            val record = GdbMiParser.parse_line("5^error,msg=\"unknown command\"")
            expect(record.is_error()).to_equal(true)

        slow_it "parses result without token":
            # @req REQ-REMOTE-DEBUG-011
            # @capture(protocol_json): the parsed ^done record lacking a token
            step("Parse a ^done result record without a token prefix")
            val record = GdbMiParser.parse_line("^done")
            match record:
                GdbMiRecord.Result(token, cls, data):
                    expect(cls).to_equal("done")
                _:
                    fail("expected Result record")

    context "async records":
        slow_it "parses stopped event":
            # @req REQ-REMOTE-DEBUG-011
            # @capture(protocol_json): the parsed *stopped async record
            step("Parse a *stopped async record with breakpoint details")
            val record = GdbMiParser.parse_line("*stopped,reason=\"breakpoint-hit\",bkptno=\"1\"")
            expect(record.is_stopped()).to_equal(true)
            match record:
                GdbMiRecord.Async(cls, data):
                    expect(cls).to_equal("stopped")
                    expect(data.get("reason") ?? "").to_equal("breakpoint-hit")
                    expect(data.get("bkptno") ?? "").to_equal("1")
                _:
                    fail("expected Async record")

        slow_it "parses thread-created notification":
            # @req REQ-REMOTE-DEBUG-011
            # @capture(protocol_json): the parsed =thread-created notification
            step("Parse a =thread-created notification record")
            val record = GdbMiParser.parse_line("=thread-created,id=\"1\"")
            match record:
                GdbMiRecord.Async(cls, data):
                    expect(cls).to_equal("thread-created")
                _:
                    fail("expected Async record")

    context "stream records":
        slow_it "parses console output":
            # @req REQ-REMOTE-DEBUG-011
            # @capture(protocol_json): the parsed ~ console stream record
            step("Parse a console stream record")
            val record = GdbMiParser.parse_line("~\"Hello World\\n\"")
            match record:
                GdbMiRecord.Stream(kind, content):
                    expect(kind).to_equal("console")
                    expect(content.contains("Hello World")).to_equal(true)
                _:
                    fail("expected Stream record")

        slow_it "parses log output":
            # @req REQ-REMOTE-DEBUG-011
            # @capture(protocol_json): the parsed & log stream record
            step("Parse a log stream record")
            val record = GdbMiParser.parse_line("&\"info\\n\"")
            match record:
                GdbMiRecord.Stream(kind, content):
                    expect(kind).to_equal("log")
                _:
                    fail("expected Stream record")

    context "prompt":
        slow_it "parses GDB prompt":
            # @req REQ-REMOTE-DEBUG-011
            # @capture(protocol_json): the parsed (gdb) prompt record
            step("Parse the GDB prompt line")
            val record = GdbMiParser.parse_line("(gdb)")
            match record:
                GdbMiRecord.Prompt:
                    pass  # correct
                _:
                    fail("expected Prompt")

    context "key-value parsing":
        # NOTE: the four key-value/tuple scenarios below are legitimately RED
        # (pre-existing product defect in GdbMiParser key-value parsing);
        # keep them RED until the parser is fixed.
        slow_it "parses simple key-value pairs":
            # @req REQ-REMOTE-DEBUG-012
            # @capture(protocol_json): key-value extraction from a flat MI tuple
            step("Extract key-value pairs from a flat MI tuple string")
            val data = GdbMiParser.parse_key_values("name=\"x\",value=\"42\"")
            expect(data.get("name") ?? "").to_equal("x")
            expect(data.get("value") ?? "").to_equal("42")

        slow_it "parses nested braces":
            # @req REQ-REMOTE-DEBUG-012
            # @capture(protocol_json): key-value extraction from a nested MI tuple
            step("Extract key-value pairs from a nested MI tuple string")
            val data = GdbMiParser.parse_key_values("bkpt={number=\"1\",type=\"breakpoint\"}")
            val bkpt = data.get("bkpt") ?? ""
            expect(bkpt.contains("number")).to_equal(true)

    context "tuple list parsing":
        slow_it "parses list of tuples":
            # @req REQ-REMOTE-DEBUG-012
            # @capture(protocol_json): tuple-list extraction from an MI list
            step("Extract a list of tuples from an MI list string")
            val tuples = GdbMiParser.parse_tuple_list("[{name=\"x\",value=\"42\"},{name=\"y\",value=\"10\"}]")
            expect(tuples.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            expect(tuples[0].get("name") ?? "").to_equal("x")
            expect(tuples[0].get("value") ?? "").to_equal("42")
            expect(tuples[1].get("name") ?? "").to_equal("y")

        slow_it "handles empty list":
            # @req REQ-REMOTE-DEBUG-012
            # @capture(statistics): tuple count for an empty MI list
            step("Extract an empty MI list and count zero tuples")
            val tuples = GdbMiParser.parse_tuple_list("[]")
            expect(tuples.len()).to_equal(0)    # oracle: expected value 0 is the behavior asserted by this regression spec
    context "hex parsing":
        slow_it "parses hex values":
            # @req REQ-REMOTE-DEBUG-013
            # @capture(statistics): hex-to-int conversions for small and 32-bit values
            step("Convert MI hex values to integers")
            use app.debug.remote.protocol.gdb_mi_parser.parse_hex_value
            expect(parse_hex_value("0x2a")).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec
            expect(parse_hex_value("0xFF")).to_equal(255)  # oracle: expected value 255 is the behavior asserted by this regression spec
            expect(parse_hex_value("0x80000000")).to_equal(0x80000000)  # oracle: the QEMU virt RAM base must round-trip through hex

        slow_it "parses hex bytes":
            # @req REQ-REMOTE-DEBUG-013
            # @capture(protocol_binary): hex-to-byte conversions for memory dumps
            step("Convert MI hex byte pairs to bytes")
            use app.debug.remote.protocol.gdb_mi_parser.parse_hex_byte
            expect(parse_hex_byte("2a")).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec
            expect(parse_hex_byte("ff")).to_equal(255)  # oracle: expected value 255 is the behavior asserted by this regression spec
            expect(parse_hex_byte("00")).to_equal(0)    # oracle: expected value 0 is the behavior asserted by this regression spec

