"""
Comment-Only Specification Test

## Purpose and audience
## Operator workflow
## Compatibility and limitations

Feature: Pure-docstring .spl file support
Category: Testing
Status: Implemented

Test whether Simple compiler supports pure-docstring .spl files without executable code.
"""
# @manual: primary
# @req: REQ-TEST-META_COMMENT_ONLY-001
# doc-path: doc/01_research/os/fs/storage_fat32_handle_metadata.md
# doc-path: doc/03_plan/os/storage/storage_fat32_handle_metadata.md
# doc-path: doc/04_architecture/hardware/bare_metal_integration.md
# doc-path: doc/05_design/hardware/baremetal_robustness_rules.md

use std.spec.step

use compiler.core.parser.{parse_module, parser_has_errors, parser_get_errors}

use std.spec.step
describe "Comment-Only Files":
    """
    Verifies the compiler handles files with only docstrings/comments.
    """
    it "parses a docstring-only module without errors":
        # @req REQ-SSPEC-INTEGRATION
        step("parse a docstring-only source through the real parser")
        val source = "\"\"\"\nComment-only module body.\nNo executable code follows.\n\"\"\"\n"
        parse_module(source, "comment_only_fixture.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(parser_get_errors().len()).to_equal(0)

    it "parses a comment-and-whitespace-only module without errors":
        # @req REQ-SSPEC-INTEGRATION
        step("parse a comment-only source through the real parser")
        val source = "# leading comment\n\n# trailing comment\n"
        parse_module(source, "comment_only_lines_fixture.spl")
        expect(parser_has_errors()).to_equal(false)
        expect(parser_get_errors().len()).to_equal(0)
