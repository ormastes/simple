use std.spec.*
use std.io_runtime.{dir_create_all, file_write, file_delete, process_run}
use std.nogc_sync_mut.io_runtime.{dir_remove}
use app.compiler_entrypoint.inventory_events.{compiler_inventory_refresh_v1}
use std.scv.compile_source_inventory.{compile_source_inventory_read_current_v1, compile_source_inventory_read_pointer_content_v1}

extern fn rt_getpid() -> i64

describe "compiler inventory cold journal recovery":
    it "rebuilds from Git after a journal rewrite while warm refresh refuses it":
        val root = "build/test-artifacts/scv-cold-journal-{rt_getpid()}"
        val cache_root = root + "/build/scv"
        val journal_dir = root + "/.scv/journal"
        val journal_path = journal_dir + "/events.log"
        dir_remove(root, true)
        expect(dir_create_all(root + "/src")).to_equal(true)
        expect(file_write(root + "/src/a.spl", "export fn a(): 1\n")).to_equal(true)
        val (_, _, init_code) = process_run("git", ["-C", root, "init", "-q"])
        expect(init_code).to_equal(0)
        val (_, _, add_code) = process_run("git", ["-C", root, "add", "src/a.spl"])
        expect(add_code).to_equal(0)
        val (_, _, commit_code) = process_run("git", ["-C", root,
            "-c", "user.name=Simple Test", "-c", "user.email=test@example.invalid",
            "-c", "commit.gpgsign=false", "commit", "-qm", "seed"])
        expect(commit_code).to_equal(0)
        expect(file_write(root + "/src/untracked.spl",
            "export fn untracked(): 2\n")).to_equal(true)

        val initial = compiler_inventory_refresh_v1(root, cache_root, ["src"], true)
        expect(initial.valid).to_equal(true)
        expect(dir_create_all(journal_dir)).to_equal(true)
        expect(file_write(journal_path,
            "op=first kind=snapshot refs=x sha=x utc=1\n")).to_equal(true)
        val warmed = compiler_inventory_refresh_v1(root, cache_root, ["src"], false)
        expect(warmed.valid).to_equal(true)

        expect(file_write(journal_path,
            "op=changed kind=snapshot refs=x sha=x utc=2\n")).to_equal(true)
        val rejected = compiler_inventory_refresh_v1(root, cache_root, ["src"], false)
        expect(rejected.valid).to_equal(false)
        expect(rejected.reason).to_contain("filesystem-event-journal-rewritten")
        val rebuilt = compiler_inventory_refresh_v1(root, cache_root, ["src"], true)
        expect(rebuilt.valid).to_equal(true)
        val admitted = compiler_inventory_refresh_v1(root, cache_root, ["src"], false)
        expect(admitted.valid).to_equal(true)
        val pointer = compile_source_inventory_read_pointer_content_v1(cache_root) ?? ""
        expect(pointer).to_contain("simple-compile-event-cursor-v3")
        expect(pointer).to_contain("untracked_membership_digest=")
        val membership_marker = pointer.index_of("\nuntracked_src_digest=")
        expect(membership_marker > 0).to_equal(true)
        val legacy_pointer = pointer[:membership_marker].replace(
            "simple-compile-event-cursor-v3", "simple-compile-event-cursor-v1")
        expect(file_write(cache_root + "/source-inventory/CURRENT",
            legacy_pointer)).to_equal(true)
        val legacy_warm = compiler_inventory_refresh_v1(root, cache_root, ["src"], false)
        expect(legacy_warm.valid).to_equal(false)
        expect(legacy_warm.reason).to_contain("untracked-membership-cursor-missing")
        val migrated = compiler_inventory_refresh_v1(root, cache_root, ["src"], true)
        expect(migrated.valid).to_equal(true)
        expect(file_delete(root + "/src/untracked.spl")).to_equal(true)
        val deleted = compiler_inventory_refresh_v1(root, cache_root, ["src"], false)
        expect(deleted.valid).to_equal(true)
        val current = compile_source_inventory_read_current_v1(cache_root)
        expect(current.valid).to_equal(true)
        if current.valid:
            expect(current.inventory!.entries.len()).to_equal(1)
            expect(current.inventory!.entries[0].source_identity).to_equal("src/a.spl")
        expect(file_write(root + "/src/new.spl", "export fn new(): 3\n")).to_equal(true)
        val created = compiler_inventory_refresh_v1(root, cache_root, ["src"], false)
        expect(created.valid).to_equal(true)
        val (_, _, stage_code) = process_run("git", ["-C", root, "add", "src/new.spl"])
        expect(stage_code).to_equal(0)
        val staged = compiler_inventory_refresh_v1(root, cache_root, ["src"], false)
        expect(staged.valid).to_equal(true)
        val final_inventory = compile_source_inventory_read_current_v1(cache_root)
        expect(final_inventory.valid).to_equal(true)
        if final_inventory.valid:
            expect(final_inventory.inventory!.entries.len()).to_equal(2)
        dir_remove(root, true)
