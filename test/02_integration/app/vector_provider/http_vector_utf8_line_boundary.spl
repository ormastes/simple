# Native assertion fixture: importing the real vector parser must resolve its
# request/header/body decoder, while split multibyte lines retain exact bytes.
use std.nogc_sync_mut.http_server.vector_parser.{http_vector_line_chunk_advance_v1}
use std.common.base_encoding.{bytes_to_text}

fn main() -> i32:
    val prefix: [u8] = [88u8, 58u8, 32u8, 195u8]
    val first = http_vector_line_chunk_advance_v1([], prefix, 0, -1, -1)
    assert(not first.complete)
    assert(first.error == "")
    assert(first.bytes.len() == 4)
    assert(first.bytes[3] == 195u8)
    val suffix: [u8] = [169u8, 13u8, 10u8, 90u8]
    val second = http_vector_line_chunk_advance_v1(first.bytes, suffix, 0, 2, 1)
    assert(second.complete)
    assert(second.line_ending_crlf)
    assert(second.error == "")
    assert(second.cursor == 3)
    assert(second.bytes.len() == 7)
    assert(bytes_to_text(second.bytes) == "X: é\r\n")
    assert(suffix[second.cursor as i32] == 90u8)
    println("HTTP_VECTOR_UTF8_LINE_BOUNDARY_PASS assertions=11")
    0
