"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the serial MCP server app
(--log-mode and --progress) and prove the shared options leave normal
JSON-RPC ping handling intact.
Audience: compiler and tooling engineers who maintain the serial MCP server
and the shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/serial_mcp_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the serial MCP server's shared log options and its ping path only;
each scenario spawns real `bin/simple` processes over stdio pipes.
## Verification guidance and troubleshooting
A failure names the exact option, mode, or JSON field that regressed;
re-run this spec and compare the captured stdout in the failing scenario to
reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: serial-mcp-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn _run_serial_mcp(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/serial_mcp/main.spl\" " + joined
    ])

fn _ping_serial_mcp() -> (text, text, i64):
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); printf '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}\\n' | SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/serial_mcp/main.spl\""
    ])

describe "serial mcp log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-SERIAL-MCP-LOGMODE-001
        # @capture(tui_grid): serial MCP help text listing the shared log options
        step("Verify: shows shared log options in help")
        val (out, err, code) = _run_serial_mcp(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json for ready output":
        # @req REQ-SERIAL-MCP-LOGMODE-001
        # @capture(protocol_json): stdout JSON ready announcement
        step("Verify: supports log-mode json for ready output")
        val (out, err, code) = _run_serial_mcp(["--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a ready server start
        expect(out).to_contain("\"command\":\"serial-mcp\"")
        expect(out).to_contain("\"status\":\"ready\"")

    it "supports dot progress for help output":
        # @req REQ-SERIAL-MCP-LOGMODE-001
        # @capture(tui_grid): dot-progress help output naming the server
        step("Verify: supports dot progress for help output")
        val (out, err, code) = _run_serial_mcp(["--progress=dot", "--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_start_with(".")
        expect(out).to_contain("Serial MCP Server")

    it "rejects invalid log mode":
        # @req REQ-SERIAL-MCP-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Verify: rejects invalid log mode")
        val (out, err, code) = _run_serial_mcp(["--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode

    it "preserves normal MCP ping handling":
        # @req REQ-SERIAL-MCP-LOGMODE-001
        # @capture(protocol_json): JSON-RPC ping response transcript
        step("Verify: preserves normal MCP ping handling")
        val (out, err, code) = _ping_serial_mcp()
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a handled ping
        expect(out).to_contain("\"jsonrpc\":\"2.0\"")
        expect(out).to_contain("\"result\":{}")
