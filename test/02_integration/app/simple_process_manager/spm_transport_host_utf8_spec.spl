# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# @cover src/app/simple_process_manager/transport/spm_transport_host.spl

# The host transport writes the request wire as text; a body that is not valid
# UTF-8 is rejected with an explicit error before any socket is touched.

use std.spec.step
use lib.common.privilege.authority_token.{AuthorityToken}
use app.simple_process_manager.transport.spm_transport.{SpmTransport, SpmRequest}
use app.simple_process_manager.transport.spm_transport_host.{SpmTransportHost}

describe "SpmTransportHost strict UTF-8 wire":
    it "rejects an invalid UTF-8 request body":
        val host = SpmTransportHost.with_path("/nonexistent/spm-utf8-spec.sock")
        val req = SpmRequest(kind: "ping", body: [104u8, 255u8, 105u8], token_hint: AuthorityToken.public_none())
        val resp = host.send(req)
        expect(resp.ok).to_equal(false)
        expect(resp.error).to_equal("host request is not valid UTF-8")
