use std.spec.{describe, it, expect}
use std.io_runtime.{file_write, file_read, dir_create_all, dir_remove_all, cwd}
use std.nogc_sync_mut.io.process_ops.{process_run}
use std.nogc_sync_mut.env.platform.{get_temp_dir}

# Fixture roots must live where BOTH the POSIX fixture shell and the Simple
# filesystem APIs can address them: the runtime does not translate a POSIX
# "/tmp" prefix on Windows, so anchor under the host temp dir instead.
fn _fixture_base() -> text:
    val raw = get_temp_dir().replace("\\", "/")
    if raw.ends_with("/"): raw.substring(0, raw.len() - 1) else: raw

fn _seed_db_content() -> text:
    "bugs_active |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\n\n" +
    "bugs |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\n\n" +
    "bug_descriptions |bug_id, line_num, content|\n\n" +
    "bug_fix_strategies |bug_id, line_num, content|\n\n" +
    "bug_investigation_logs |bug_id, line_num, content|\n\n" +
    "bug_token_usage |bug_id, category, provider, input_tokens, output_tokens, cache_read_tokens, cache_create_tokens, total_tokens, source, knowledge, recorded_at|\n"

fn _reset_fixture(root: text) -> bool:
    dir_remove_all(root)
    if not dir_create_all(root + "/doc/08_tracking/bug"):
        return false
    file_write(root + "/doc/08_tracking/bug/bug_db.sdn", _seed_db_content())

describe "bug-add truthful creation timestamp integration":
    it "persists the caller-supplied creation date instead of the historical hardcoded date":
        val repo = cwd().replace("\\", "/")
        val root = _fixture_base() + "/simple_bug_add_truthful_timestamp_integration"
        expect(_reset_fixture(root)).to_equal(true)
        val command = "cd '" + root + "' && SIMPLE_LIB='" + repo + "/src' '" + repo + "/bin/simple' run '" + repo + "/src/app/bug_add/main.spl' --id=truthful_date_integration --severity=p1 --title=truthful --file=src/app/bug_add/main.spl --date=2026-08-14"
        expect(process_run("/bin/sh", ["-c", command]).2).to_equal(0)
        val content = file_read(root + "/doc/08_tracking/bug/bug_db.sdn")
        expect(content).to_contain("truthful_date_integration, P1, open, truthful, src/app/bug_add/main.spl, 0, N/A, 2026-08-14, 2026-08-14, true")
        expect(content.contains("truthful_date_integration, P1, open, truthful, src/app/bug_add/main.spl, 0, N/A, 2026-04-14")).to_equal(false)
        dir_remove_all(root)

    it "rejects a non-calendar creation date before writing a bug":
        val repo = cwd().replace("\\", "/")
        val root = _fixture_base() + "/simple_bug_add_truthful_timestamp_integration"
        expect(_reset_fixture(root)).to_equal(true)
        val command = "cd '" + root + "' && SIMPLE_LIB='" + repo + "/src' '" + repo + "/bin/simple' run '" + repo + "/src/app/bug_add/main.spl' --id=invalid_date_integration --title=invalid --date=2026-02-30"
        val result = process_run("/bin/sh", ["-c", command])
        expect(result.2).to_equal(1)
        expect(result.0).to_contain("valid YYYY-MM-DD calendar date")
        val content = file_read(root + "/doc/08_tracking/bug/bug_db.sdn")
        expect(content.contains("invalid_date_integration")).to_equal(false)
        dir_remove_all(root)
