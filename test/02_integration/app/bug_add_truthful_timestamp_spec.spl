use std.spec.{describe, it, expect}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_ROOT = "/tmp/simple_bug_add_truthful_timestamp_integration"

fn run_fixture(command: text) -> (text, text, i64):
    rt_process_run("/bin/sh", ["-c", command])

describe "bug-add truthful creation timestamp integration":
    it "persists the caller-supplied creation date instead of the historical hardcoded date":
        val repo = rt_process_run("/bin/pwd", []).0.trim()
        val setup = "rm -rf " + FIXTURE_ROOT + " && mkdir -p " + FIXTURE_ROOT + "/doc/08_tracking/bug && printf 'bugs_active |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\\n\\nbugs |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\\n\\nbug_descriptions |bug_id, line_num, content|\\n\\nbug_fix_strategies |bug_id, line_num, content|\\n\\nbug_investigation_logs |bug_id, line_num, content|\\n\\nbug_token_usage |bug_id, category, provider, input_tokens, output_tokens, cache_read_tokens, cache_create_tokens, total_tokens, source, knowledge, recorded_at|\\n' > " + FIXTURE_ROOT + "/doc/08_tracking/bug/bug_db.sdn"
        expect(run_fixture(setup).2).to_equal(0)
        val command = "cd " + FIXTURE_ROOT + " && SIMPLE_LIB=" + repo + "/src " + repo + "/bin/simple run " + repo + "/src/app/bug_add/main.spl --id=truthful_date_integration --severity=p1 --title=truthful --file=src/app/bug_add/main.spl --date=2026-08-14"
        expect(run_fixture(command).2).to_equal(0)
        val content = run_fixture("/bin/cat " + FIXTURE_ROOT + "/doc/08_tracking/bug/bug_db.sdn").0
        expect(content).to_contain("truthful_date_integration, P1, open, truthful, src/app/bug_add/main.spl, 0, N/A, 2026-08-14, 2026-08-14, true")
        expect(content.contains("truthful_date_integration, P1, open, truthful, src/app/bug_add/main.spl, 0, N/A, 2026-04-14")).to_equal(false)

    it "rejects a non-calendar creation date before writing a bug":
        val repo = rt_process_run("/bin/pwd", []).0.trim()
        val setup = "rm -rf " + FIXTURE_ROOT + " && mkdir -p " + FIXTURE_ROOT + "/doc/08_tracking/bug && printf 'bugs_active |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\\n\\nbugs |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\\n\\nbug_descriptions |bug_id, line_num, content|\\n\\nbug_fix_strategies |bug_id, line_num, content|\\n\\nbug_investigation_logs |bug_id, line_num, content|\\n\\nbug_token_usage |bug_id, category, provider, input_tokens, output_tokens, cache_read_tokens, cache_create_tokens, total_tokens, source, knowledge, recorded_at|\\n' > " + FIXTURE_ROOT + "/doc/08_tracking/bug/bug_db.sdn"
        expect(run_fixture(setup).2).to_equal(0)
        val command = "cd " + FIXTURE_ROOT + " && SIMPLE_LIB=" + repo + "/src " + repo + "/bin/simple run " + repo + "/src/app/bug_add/main.spl --id=invalid_date_integration --title=invalid --date=2026-02-30"
        val result = run_fixture(command)
        expect(result.2).to_equal(1)
        expect(result.0).to_contain("valid YYYY-MM-DD calendar date")
        val content = run_fixture("/bin/cat " + FIXTURE_ROOT + "/doc/08_tracking/bug/bug_db.sdn").0
        expect(content.contains("invalid_date_integration")).to_equal(false)
