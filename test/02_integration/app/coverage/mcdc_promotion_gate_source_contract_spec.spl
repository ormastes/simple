"""
## Purpose and audience
Executable source contract for the MC/DC production promotion gate, written for
the coverage-tooling owners. It pins the runtime report policy, the CLI
promotion-mode mapping, and the V2 bounded-row surface so a promotion decision
can never silently bypass the exact-coverage gate.
## Operator workflow
Run `./src/compiler_rust/target/bootstrap/simple run test/02_integration/app/coverage/mcdc_promotion_gate_source_contract_spec.spl`
from the repository root; every scenario reads shipped product source directly.
## Compatibility and limitations
This is a source contract, not a runtime exercise: the scenarios inspect
`src/runtime/runtime_coverage_core.c`, `src/app/coverage/main.spl`, and
`src/lib/nogc_sync_mut/io/coverage_mcdc.spl`. A drifted token shows up RED.
## Verification guidance and troubleshooting
A failure means a pinned token disappeared or changed meaning; grep the named
product file for the failing token and re-read the owning requirement before
editing either side.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: coverage promotion gate
# @req REQ-005 NFR-008
# @evidence-class source-contract

use std.io.{file_read}
use std.spec.{describe, it, expect, step}

val RUNTIME = "src/runtime/runtime_coverage_core.c"
val CLI = "src/app/coverage/main.spl"
val PURE_BOUNDARY = "src/lib/nogc_sync_mut/io/coverage_mcdc.spl"

describe "MC/DC production promotion gate source contract":
    it "fails every admitted runtime report mode below exact coverage":
        # @req REQ-005
        # @capture(protocol_json): the pinned runtime gate-fail return tokens
        step("Inspect the allocation-free runtime report return policy")
        val source = file_read(RUNTIME)
        val hardcodes_normal_mode_gate_bypass = source.contains(
            "mode == SIMPLE_MCDC_REPORT_NORMAL_V1 && !report->gate_passed")
        expect(source).to_contain("if (!report->gate_passed)")
        expect(source).to_contain("return SIMPLE_MCDC_V1_GATE_FAILED;")
        expect(hardcodes_normal_mode_gate_bypass).to_equal(false)

    it "does not bypass alpha or beta in CLI reporting":
        # @req REQ-005
        # @capture(protocol_json): the pinned CLI promotion-mode mapping tokens
        step("Inspect the CLI promotion-mode mapping and exit contract")
        val source = file_read(CLI)
        val hardcodes_not_enforced_mode = source.contains("gate=NOT_ENFORCED")
        expect(source).to_contain("McdcReportModeV1.Alpha")
        expect(source).to_contain("McdcReportModeV1.Beta")
        expect(source).to_contain("MC/DC gate=FAIL reason=eligible coverage is not exactly 100%")
        expect(hardcodes_not_enforced_mode).to_equal(false)

    it "exposes complete bounded V2 rows without changing the V1 default":
        # @req REQ-005
        # @capture(protocol_json): the pinned V2 bounded-row and cold-path tokens
        step("Inspect V2 caller-owned storage and cold-path output bounds")
        val cli = file_read(CLI)
        val boundary = file_read(PURE_BOUNDARY)
        expect(cli).to_contain("get_arg(args, \"--report-version\", \"v1\")")
        expect(cli).to_contain("MC/DC decision index=")
        expect(cli).to_contain("MC/DC witness index=")
        expect(cli).to_contain("MC/DC merge_process index=")
        expect(cli).to_contain("MC/DC merged_witness decision_id=")
        expect(cli).to_contain("exceeds --max-output-lines")
        expect(cli).to_contain("mcdc_runtime_merge_reports_v2")
        expect(boundary).to_contain("Build a complete V2 report using only caller-owned fixed buffers")
        expect(boundary).to_contain("binary_identity_sha256.len() != 64")
