# `simple spl-coverage module` end to end: per-module line, decision, outcome
# and condition coverage from a SIMPLE_COVERAGE artifact, and the --min gate.
#
# The artifact below is the seed collector's real output for
# test/fixtures/coverage/covreport_fixture.spl (covrep_classify(5),
# covrep_classify(0), covrep_sum([1, 2])); the hand-counted figures are pinned
# in test/01_unit/lib/common/coverage_module_report_spec.spl.
#
# Coverage of src/app/spl_coverage/main.spl itself: set
# SPL_COVERAGE_MODULE_CHILD_COV_DIR=<dir> and every CLI child runs with
# SIMPLE_COVERAGE=1 and writes <dir>/child_<tag>.sdn; report them with
# `spl-coverage module --file <dir>/child_<tag>.sdn ... src/app/spl_coverage/main.spl`.
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.env.platform.{is_windows, get_temp_dir}
use std.env.variables.{env_get}
use std.nogc_sync_mut.io.env_ops.{cwd}
use std.fs.{file_write_text, read_to_string}
use std.common.coverage_module_report.{coverage_source_digest}

val CLI_RUN_TIMEOUT_MS: i64 = 120000
val CLI_RUN_MAX_OUT: i64 = 16777216
val FIXTURE: text = "test/fixtures/coverage/covreport_fixture.spl"
val FIXTURE_LINE: text = "coverage-module: test/fixtures/coverage/covreport_fixture.spl lines=58.3% (7/12) decisions=33.3% (1/3 both outcomes) outcomes=50.0% (3/6) conditions=0.0% (0/2) toplevel_excluded=0 foreign_excluded=0 recorded=yes source=unverified"

fn _child_cov_env(tag: text) -> [(text, text)]:
    val dir = env_get("SPL_COVERAGE_MODULE_CHILD_COV_DIR") ?? ""
    if dir == "":
        return []
    [("SIMPLE_COVERAGE", "1"), ("SIMPLE_COVERAGE_OUTPUT", "{dir}/child_{tag}.sdn")]

# `tag` names the child's coverage artifact; each call site uses its own.
fn _run_spl_coverage(tag: text, args: [text]) -> (text, text, i64):
    val repo = cwd().replace("\\", "/")
    val program = if is_windows(): repo + "/bin/simple.exe" else: repo + "/bin/simple"
    val joined = (["src/app/spl_coverage/main.spl"] + args).join(" ")
    if is_windows():
        var cmd = "set \"SIMPLE_COVERAGE=\" && set \"SIMPLE_COVERAGE_OUTPUT=\" && "
        for (key, value) in _child_cov_env(tag):
            cmd = cmd + "set \"" + key + "=" + value + "\" && "
        cmd = cmd + "set \"SIMPLE_LIB=" + repo + "/src\" && " + program + " run " + joined
        return process_run_bounded(env_get("ComSpec") ?? "cmd.exe", ["/d", "/c", cmd], CLI_RUN_TIMEOUT_MS, CLI_RUN_MAX_OUT)
    var prefix = "unset SIMPLE_COVERAGE SIMPLE_COVERAGE_OUTPUT; "
    for (key, value) in _child_cov_env(tag):
        prefix = prefix + key + "=\"" + value + "\" "
    process_run_bounded("/bin/sh", ["-c", prefix + "SIMPLE_LIB=\"" + repo + "/src\" \"" + program + "\" run " + joined],
        CLI_RUN_TIMEOUT_MS, CLI_RUN_MAX_OUT)

fn _artifact() -> text:
    val abs = "/repo/" + FIXTURE
    val sdn = "# Coverage Report\nversion: 1.0\n\nlines |file, line, hit_count|\n" +
        "    {abs}, 4, 1\n    {abs}, 5, 1\n    {abs}, 6, 1\n" +
        "    {abs}, 12, 1\n    {abs}, 13, 1\n    {abs}, 14, 1\n    {abs}, 15, 1\n\n" +
        "functions |name, call_count|\n    covrep_classify, 2\n    covrep_sum, 1\n\n" +
        "# Runtime decision/condition coverage\n" +
        "decisions |id, file, line, column, true_count, false_count|\n" +
        "    3185411318, {abs}, 5, 5, 1, 1\n" +
        "    2579957545, {abs}, 19, 5, 0, 0\n" +
        "    3022333900, {abs}, 7, 5, 0, 1\n\n" +
        "conditions |decision_id, condition_id, file, line, column, true_count, false_count|\n" +
        "    2579957545, 0, {abs}, 19, 5, 0, 0\n" +
        "    2579957545, 1, {abs}, 19, 5, 0, 0\n"
    val path = get_temp_dir().replace("\\", "/") + "/spl_coverage_module_spec_artifact.sdn"
    expect(file_write_text(path, sdn)).to_equal(true)
    path


val TAIL_FIXTURE: text = "test/fixtures/coverage/covtail_fixture.spl"
val EXPR_FIXTURE: text = "test/fixtures/coverage/covexpr_fixture.spl"
val EXPR_HELPER: text = "test/fixtures/coverage/covexpr_helper.spl"

fn _tmp_path(name: text) -> text:
    get_temp_dir().replace("\\", "/") + "/" + name

# `_artifact()` rows plus a `sources` digest for FIXTURE, as a current
# collector writes them.
fn _digested_artifact(name: text, digest: text) -> text:
    val src = read_to_string(_artifact()) ?? ""
    val path = _tmp_path(name)
    expect(file_write_text(path, src + "\nsources |file, crc32|\n    /repo/{FIXTURE}, {digest}\n")).to_equal(true)
    path

# Runs `fixture` under the interpreter collector; returns the artifact path.
fn _collect_fixture_artifact(fixture: text, artifact_name: text, expected_out: text) -> text:
    val repo = cwd().replace("\\", "/")
    val out_path = _tmp_path(artifact_name)
    val env: [(text, text)] = [("SIMPLE_COVERAGE", "1"), ("SIMPLE_COVERAGE_OUTPUT", out_path),
        ("SIMPLE_RUNTIME_MODE", "interpreter"), ("SIMPLE_EXECUTION_MODE", "interpret"), ("SIMPLE_LIB", repo + "/src")]
    var result = ("", "", 1)
    if is_windows():
        var cmd = "set \"SIMPLE_COVERAGE=\" && set \"SIMPLE_COVERAGE_OUTPUT=\" && "
        for (key, value) in env:
            cmd = cmd + "set \"" + key + "=" + value + "\" && "
        cmd = cmd + repo + "/bin/simple.exe run " + fixture
        result = process_run_bounded(env_get("ComSpec") ?? "cmd.exe", ["/d", "/c", cmd], CLI_RUN_TIMEOUT_MS, CLI_RUN_MAX_OUT)
    else:
        var prefix = ""
        for (key, value) in env:
            prefix = prefix + key + "=\"" + value + "\" "
        result = process_run_bounded("/bin/sh", ["-c", prefix + "\"" + repo + "/bin/simple\" run " + fixture],
            CLI_RUN_TIMEOUT_MS, CLI_RUN_MAX_OUT)
    val (out, err, code) = result
    expect(code).to_equal(0)
    expect(out).to_contain(expected_out)
    out_path

fn _collect_tail_artifact() -> text:
    _collect_fixture_artifact(TAIL_FIXTURE, "spl_coverage_module_spec_tail.sdn", "one\n2\n2\n2")

# The line numbers the artifact's `lines |file, line, hit_count|` table
# records for `fixture`, ascending, each preceded by a space.
fn _recorded_lines(artifact: text, fixture: text, last_line: i64) -> text:
    var cells: [text] = []
    var in_lines = false
    for raw in (read_to_string(artifact) ?? "").split("\n"):
        if not raw.starts_with("    "):
            in_lines = raw.starts_with("lines |")
            continue
        val row = raw.trim().split(", ")
        if in_lines and row.len() == 3 and row[0].ends_with(fixture):
            cells.push(row[1])
    var out = ""
    var n = 1
    while n <= last_line:
        if cells.contains("{n}"):
            out = out + " {n}"
        n = n + 1
    out

describe "spl-coverage module":
    # @manual scenario evidence
    it "lists the module command in help":
        val (out, err, code) = _run_spl_coverage("help", ["--help"])
        expect(code).to_equal(0)
        expect(out).to_contain("module    Per-module line %")

    it "prints one coverage-module line per module from an artifact":
        val (out, err, code) = _run_spl_coverage("report", ["module", "--file", _artifact(), FIXTURE])
        expect(code).to_equal(0)
        expect(out).to_contain(FIXTURE_LINE)

    it "passes --min when line and decision coverage reach it and fails when they do not":
        val artifact = _artifact()
        val (low_out, low_err, low_code) = _run_spl_coverage("min_low", ["module", "--file", artifact, "--min", "30", FIXTURE])
        expect(low_code).to_equal(0)
        expect(low_out).to_contain("lines=58.3%")
        val (high_out, high_err, high_code) = _run_spl_coverage("min_high", ["module", "--file", artifact, "--min", "90", FIXTURE])
        expect(high_code).to_equal(1)
        expect(high_out).to_contain("lines=58.3%")

    it "fails --min for a module the artifact never recorded":
        val (out, err, code) = _run_spl_coverage("unrecorded", ["module", "--file", _artifact(), "--min", "0", "src/app/spl_coverage/main.spl"])
        expect(code).to_equal(1)
        expect(out).to_contain("recorded=no")

    it "applies --os and --arch to @when platform blocks":
        val (out, err, code) = _run_spl_coverage("platform", ["module", "--file", _artifact(), "--os", "freebsd", "--arch", "riscv64", FIXTURE])
        expect(code).to_equal(0)
        expect(out).to_contain("foreign_excluded=0")

    it "rejects missing arguments, a non-numeric --min and unreadable inputs":
        val artifact = _artifact()
        val (no_file_out, no_file_err, no_file_code) = _run_spl_coverage("no_file", ["module", FIXTURE])
        expect(no_file_code).to_equal(1)
        expect(no_file_out).to_contain("module requires at least one --file")
        val (bad_min_out, bad_min_err, bad_min_code) = _run_spl_coverage("bad_min", ["module", "--file", artifact, "--min", "9x", FIXTURE])
        expect(bad_min_code).to_equal(1)
        expect(bad_min_out).to_contain("--min needs a whole percentage, got: 9x")
        val (no_src_out, no_src_err, no_src_code) = _run_spl_coverage("no_src", ["module", "--file", artifact, "test/fixtures/coverage/no_such_module.spl"])
        expect(no_src_code).to_equal(1)
        expect(no_src_out).to_contain("module source not found")
        val (no_art_out, no_art_err, no_art_code) = _run_spl_coverage("no_art", ["module", "--file", "/nonexistent/spl_cov_module.sdn", FIXTURE])
        expect(no_art_code).to_equal(1)
        expect(no_art_out).to_contain("Error:")

    # Defects 1+2 (collector): a function's tail `match`, tail one-line and
    # block `if`, and a mid-body one-line `if c: a else: b` all run here, so a
    # collector that records them scores 100%; one that drops them read 5/9.
    # Defect 3 end to end: the collector's `sources` digest matches the file.
    it "scores every tail match and one-line if the collector ran as hit":
        val artifact = _collect_tail_artifact()
        val (out, err, code) = _run_spl_coverage("tail", ["module", "--file", artifact, TAIL_FIXTURE])
        expect(code).to_equal(0)
        expect(out).to_contain("lines=100.0% (9/9)")
        expect(out).to_contain("source=verified")

    # Statements whose executor bypasses exec_node (bug
    # coverage_value_match_arm_tail_and_lambda_body_unrecorded_2026-11-14): the
    # tail `if` / `match` of an arm of a value-position `match` (21, 28, 42,
    # 47, 110) and the whole body of a multi-line lambda (77-80, 89, 91, 108)
    # ran unrecorded, so this fixture read 14/31. The five lines main() never
    # reaches -- an untaken `else` (25, 83), an untaken arm's header (32), an
    # untaken arm (94) and an uncalled lambda's body (100) -- must stay missed.
    # covexpr_cross's lambda is invoked from covexpr_helper.spl: its lines are
    # the fixture's, and the helper records only its own two statements.
    it "records arm-tail and lambda-body lines of value-position if and match":
        val artifact = _collect_fixture_artifact(EXPR_FIXTURE, "spl_coverage_module_spec_expr.sdn",
            "10\n30\n2\n50\n20\n71\n6\n2\n4\n100\n7\n20\n3")
        expect(_recorded_lines(artifact, EXPR_FIXTURE, 131)).to_equal(
            " 19 21 22 28 39 41 42 47 52 53 54 58 65 72 76 77 78 79 80 88 89 91 99 107 108 110")
        expect(_recorded_lines(artifact, EXPR_HELPER, 131)).to_equal(" 5 6")
        # covexpr_tail_let: a value-match arm ending in `val` inside a lambda the
        # helper invokes (147) is recorded under exactly ONE file. Which one is
        # the open invoker-filing bug
        # (coverage_closure_body_hits_filed_under_invoker_2026-11-14).
        val tail_in_fixture = _recorded_lines(artifact, EXPR_FIXTURE, 150).contains(" 147")
        val tail_in_helper = _recorded_lines(artifact, EXPR_HELPER, 150).contains(" 147")
        expect(tail_in_fixture != tail_in_helper).to_equal(true)
        expect(_recorded_lines(artifact, EXPR_FIXTURE, 150).contains(" 143")).to_equal(false)
        val (out, err, code) = _run_spl_coverage("expr", ["module", "--file", artifact, EXPR_FIXTURE])
        expect(code).to_equal(0)
        expect(out).to_contain("lines=78.9% (30/38)")
        expect(out).to_contain("source=verified")

    it "refuses to merge artifacts recorded against different source versions":
        val current = coverage_source_digest(read_to_string(FIXTURE) ?? "")
        val fresh = _digested_artifact("spl_cov_module_fresh.sdn", current)
        val stale = _digested_artifact("spl_cov_module_stale.sdn", "0badf00d")
        val (out, err, code) = _run_spl_coverage("mixed", ["module", "--file", fresh, "--file", stale, FIXTURE])
        expect(code).to_equal(1)
        expect(out).to_contain("refusing to score")
        expect(out).to_contain("spl_cov_module_stale.sdn (crc32 0badf00d)")
        expect(out.contains("lines=")).to_equal(false)
        val (ok_out, ok_err, ok_code) = _run_spl_coverage("fresh", ["module", "--file", fresh, "--file", fresh, FIXTURE])
        expect(ok_code).to_equal(0)
        expect(ok_out).to_contain("source=verified")

    it "warns loudly when merging artifacts that carry no source digest":
        val artifact = _artifact()
        val (out, err, code) = _run_spl_coverage("legacy", ["module", "--file", artifact, "--file", artifact, FIXTURE])
        expect(code).to_equal(0)
        expect(out).to_contain("WARNING: merging 2 artifacts")
        expect(out).to_contain("source=unverified")
