use std.spec.*
use std.common.structural.mcdc.contracts.{
    McdcReportModeV1, mcdc_coverage_summary_v1, mcdc_normal_gate_v1
}
use compiler.tools.verify.mcdc_scenario_exclusion.{
    scan_mcdc_scenario_exclusions_v1, mcdc_audited_normal_gate_v1_passes,
    parse_mcdc_scenario_exclusion_v1, encode_mcdc_scenario_exclusion_v1,
    bind_mcdc_scenario_exclusions_v1, mcdc_bound_normal_gate_v1_passes
}
use std.nogc_sync_mut.io.coverage_mcdc.{
    MCDC_STATUS_INVALID, MCDC_REPORT_V2_BYTES,
    MCDC_DECISION_REPORT_V2_BYTES, mcdc_runtime_report_manifest_v2,
    mcdc_runtime_merge_reports_v2
}

val EVIDENCE = "sha256:1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef"

fn _exact_gate():
    val summary = mcdc_coverage_summary_v1(3, 1, 2)
    mcdc_normal_gate_v1(
        McdcReportModeV1.Normal, true, summary, 1, 1, 0)

describe "MC/DC report normal-mode gate":
    it "requires exact source-to-binary exclusion binding":
        val source = "# @mcdc-exclude: scenario=irq-edge | decision=u64:0000000000000009 | source=u64:0000000000000063 | conditions=u64:0000000000000001 | condition-count=2 | kind=fixture-unavailable | code=irq.fixture | capability=board.fixture.v1 | predicate=fixture.unavailable | producible=false | reason=host cannot produce the physical IRQ edge | evidence={EVIDENCE} | observed=90 | owner=safety-team | reviewed=100 | expires=200"
        val row = encode_mcdc_scenario_exclusion_v1(
            parse_mcdc_scenario_exclusion_v1(source, 150))
        val binding = bind_mcdc_scenario_exclusions_v1(source, row, 150)
        expect(mcdc_bound_normal_gate_v1_passes(_exact_gate(), binding)).to_equal(true)
        row[24] = row[24] + 1u8
        val tampered = bind_mcdc_scenario_exclusions_v1(source, row, 150)
        expect(mcdc_bound_normal_gate_v1_passes(_exact_gate(), tampered)).to_equal(false)

    it "joins exact eligible coverage with a fresh governed directive":
        val source = "# @mcdc-exclude: scenario=irq-edge | kind=fixture-unavailable | code=irq.fixture | predicate=fixture.unavailable | producible=false | reason=host cannot produce the physical IRQ edge | evidence={EVIDENCE} | observed=90 | owner=safety-team | reviewed=100 | expires=200"
        val audit = scan_mcdc_scenario_exclusions_v1(source, 150)
        expect(audit.directive_count).to_equal(1)
        expect(audit.accepted_count).to_equal(1)
        expect(mcdc_audited_normal_gate_v1_passes(_exact_gate(), audit)).to_equal(true)

    it "fails a nominal 100 percent result when a directive is stale":
        val source = "# @mcdc-exclude: scenario=irq-edge | kind=fixture-unavailable | code=irq.fixture | predicate=fixture.unavailable | producible=false | reason=host cannot produce the physical IRQ edge | evidence={EVIDENCE} | observed=90 | owner=safety-team | reviewed=100 | expires=120"
        val audit = scan_mcdc_scenario_exclusions_v1(source, 150)
        expect(audit.stale_count).to_equal(1)
        expect(mcdc_audited_normal_gate_v1_passes(_exact_gate(), audit)).to_equal(false)

    it "never admits an empty eligible denominator":
        val summary = mcdc_coverage_summary_v1(2, 2, 0)
        val gate = mcdc_normal_gate_v1(
            McdcReportModeV1.Normal, true, summary, 2, 2, 0)
        val audit = scan_mcdc_scenario_exclusions_v1("", 150)
        expect(mcdc_audited_normal_gate_v1_passes(gate, audit)).to_equal(false)

    it "enforces exact coverage in alpha and beta promotion modes":
        val incomplete = mcdc_coverage_summary_v1(3, 1, 1)
        val alpha = mcdc_normal_gate_v1(
            McdcReportModeV1.Alpha, true, incomplete, 1, 1, 0)
        val beta = mcdc_normal_gate_v1(
            McdcReportModeV1.Beta, true, incomplete, 1, 1, 0)
        expect(mcdc_normal_gate_v1_passes(alpha)).to_equal(false)
        expect(mcdc_normal_gate_v1_passes(beta)).to_equal(false)

    it "fails closed before native report or merge on missing V2 identities":
        val report = [for _ in 0..MCDC_REPORT_V2_BYTES: 0u8]
        val rows = [for _ in 0..MCDC_DECISION_REPORT_V2_BYTES: 0u8]
        val status = mcdc_runtime_report_manifest_v2(
            [], [1u8], [], [], [], 0u64, 0u32, 0u64, 0u64,
            [], [], [], rows, 1u64, report)
        expect(status).to_equal(MCDC_STATUS_INVALID)
        expect(mcdc_runtime_merge_reports_v2([], rows, report)).to_equal(
            MCDC_STATUS_INVALID)
