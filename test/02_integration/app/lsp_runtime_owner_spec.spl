# Requires an actual compiled src/app/lsp/main.spl executable. Missing native
# infrastructure is a failure, never an empty or substituted successful test.
use std.spec.*
use app.io.minimal_runtime_ops.{env_get, process_run}

describe "LSP entry uses its runtime owner", tag: ["only-compiled"]:
    it "reads help arguments and terminates successfully":
        val binary = env_get("SIMPLE_LSP_TEST_BINARY")
        expect(binary != "").to_be(true)
        val (stdout, stderr, code) = process_run(binary, ["--help"])
        expect(code).to_equal(0)
        expect(stdout).to_contain("Usage: simple lsp [options]")
        expect(stdout).to_contain("--version")
        expect(stderr).to_equal("")

    it "reads short and long version arguments without entering server startup":
        val binary = env_get("SIMPLE_LSP_TEST_BINARY")
        expect(binary != "").to_be(true)
        for flag in ["--version", "-v"]:
            val (stdout, stderr, code) = process_run(binary, [flag])
            expect(code).to_equal(0)
            expect(stdout).to_contain("simple-lsp 0.1.0")
            expect(stdout.contains("requires compiled mode")).to_be(false)
            expect(stderr).to_equal("")
