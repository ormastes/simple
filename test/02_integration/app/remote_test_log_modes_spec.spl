use std.spec.{describe, it, expect}
use test.helpers.simple_cli_spawn_fixture.{simple_cli_run}

fn _run_remote_test(args: [text]) -> (text, text, i64):
    simple_cli_run(["src/app/remote_test/main.spl"] + args, 120000)

describe "remote-test log mode CLI options":
    # @manual scenario evidence
    it "shows shared log options in help":
        val (out, err, code) = _run_remote_test(["--help"])
        expect(code).to_equal(0)
        expect(out).to_contain("Simple Remote Test")
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json ready output":
        val (out, err, code) = _run_remote_test(["--log-mode=json"])
        expect(code).to_equal(0)
        expect(out).to_contain("\"command\":\"remote-test\"")
        expect(out).to_contain("\"status\":\"ready\"")

    it "supports json command planning":
        val (out, err, code) = _run_remote_test([
            "--log-mode=json",
            "test-host",
            "test/unit/lib/math_spec.spl",
            "--config",
            "tmp.sdn",
            "--simple-bin",
            "/usr/local/bin/custom-simple"
        ])
        expect(code).to_equal(0)
        expect(out).to_contain("\"status\":\"planned\"")
        expect(out).to_contain("\"terminal\":\"test-host\"")
        expect(out).to_contain("\"test_path\":\"test/unit/lib/math_spec.spl\"")
        expect(out).to_contain("\"config\":\"tmp.sdn\"")
        expect(out).to_contain("\"remote_simple_bin\":\"/usr/local/bin/custom-simple\"")

    it "places an automatic interpreter binary in each supported remote OS":
        val (linux_out, _, linux_code) = _run_remote_test(["--log-mode=json", "host", "spec.spl", "--remote-os=linux"])
        val (windows_out, _, windows_code) = _run_remote_test(["--log-mode=json", "host", "spec.spl", "--remote-os=windows"])
        val (simpleos_out, _, simpleos_code) = _run_remote_test(["--log-mode=json", "host", "spec.spl", "--remote-os=simpleos"])
        expect(linux_code).to_equal(0)
        expect(windows_code).to_equal(0)
        expect(simpleos_code).to_equal(0)
        expect(linux_out).to_contain("\"remote_simple_bin\":\"/usr/local/bin/simple\"")
        expect(windows_out).to_contain("\"remote_simple_bin\":\"C:\\\\Program Files\\\\Simple\\\\simple.exe\"")
        expect(simpleos_out).to_contain("\"remote_simple_bin\":\"/usr/bin/simple\"")

    it "rejects automatic placement for an unknown remote OS":
        val (out, _, code) = _run_remote_test(["--log-mode=json", "host", "spec.spl", "--remote-os=plan9"])
        expect(code).to_equal(1)
        expect(out).to_contain("cannot place the Simple binary")

    it "supports dot progress for help output":
        val (out, err, code) = _run_remote_test(["--progress=dot", "--help"])
        expect(code).to_equal(0)
        expect(out).to_contain(".\nSimple Remote Test")

    it "rejects invalid log mode":
        val (out, err, code) = _run_remote_test(["--log-mode=noisy"])
        expect(code).to_equal(1)

    it "renders json missing argument output":
        val (out, err, code) = _run_remote_test(["--log-mode=json", "test-host"])
        expect(code).to_equal(1)
        expect(out).to_contain("\"status\":\"error\"")
        expect(out).to_contain("requires a terminal name and test path")

    it "renders json unknown option output":
        val (out, err, code) = _run_remote_test(["--log-mode=json", "--surprise"])
        expect(code).to_equal(1)
        expect(out).to_contain("\"status\":\"error\"")
        expect(out).to_contain("Unknown remote-test option: --surprise")
