use std.spec.{describe, it, expect}
use std.spec.step
use app.test_runner_new.test_runner_args.{parse_test_args}
use std.test_runner.test_runner_execute.{run_test_file_native}
use std.nogc_sync_mut.io.file_ops.{file_write, file_delete}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.test_runner.test_executor_parsing.{_tp_get_temp_dir}

fn check_native_backend_assertions(backend: text):
    val fixture = _tp_get_temp_dir() + "/native-contract-{backend}-{time_now_unix_micros()}.spl"
    val options = parse_test_args(["--native-backend=" + backend, "--no-cache", "--sequential"])
    file_write(fixture, "use std.spec\ndescribe \"native fixture\":\n    it \"passes a real assertion\":\n        expect(6 * 7).to_equal(42)\n")
    val passing = run_test_file_native(fixture, options)
    file_write(fixture, "use std.spec\ndescribe \"native fixture\":\n    it \"reports a failing assertion\":\n        expect(6 * 7).to_equal(43)\n")
    val failing = run_test_file_native(fixture, options)
    file_write(fixture, "fn main():\n    print \"no assertions\"\n")
    val empty = run_test_file_native(fixture, options)
    file_delete(fixture)
    expect(passing.passed).to_equal(1)
    expect(passing.failed).to_equal(0)
    expect(passing.error).to_equal("")
    expect(failing.passed).to_equal(0)
    expect(failing.failed).to_equal(1)
    expect(empty.passed).to_equal(0)
    expect(empty.failed).to_equal(1)
    expect(empty.error).to_contain("reported no assertions")

describe "Native backend executables preserve assertion outcomes":
    it "builds and directly executes LLVM positive and negative fixtures":
        step("Compile and execute actual LLVM test assertions")
        check_native_backend_assertions("llvm")

    it "builds and directly executes Cranelift positive and negative fixtures":
        step("Compile and execute actual Cranelift test assertions")
        check_native_backend_assertions("cranelift")
