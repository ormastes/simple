# REQ-MC-008 B4 verified semantic declaration links in the existing spec renderer.
# Authored production-bound scenarios; runtime and docgen UNRUN.
use std.spec.{describe, it, expect, step}
use app.doc.spec_gen.types.{SpecFile, TestCase}
use app.doc.spec_gen.markdown.{render_markdown_with_symbol_links_v1, generate_markdown_semantic_v1, publish_semantic_markdown_content_v1}
use app.doc.spec_gen.semantic_links.{semantic_doc_symbol_map_v1, semantic_doc_label_v1}
use compiler.semantics.symbol_id.semantic_link.{SemanticLinkErrorV1, SemanticLinkFailureV1}
use compiler.semantics.symbol_id.semantic_link_source.{open_semantic_link_document_v1, semantic_link_document_uri_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io_runtime.{file_write, file_read, file_delete, getpid, time_now_unix_micros}
use std.env.platform.{get_temp_dir}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_list, dir_remove}

fn robust_06_semantic_docs_setup_render_source(source: text) -> text:
    val path = get_temp_dir() + "/semantic-render-{getpid()}-{time_now_unix_micros()}.spl"
    expect(file_write(path, source)).to_equal(true)
    path

fn robust_06_semantic_docs_setup_render_spec(symbols: [text]) -> SpecFile:
    val test = TestCase(name: "should_increment", section: "increment", line_number: 1,
        docstring: "Increment behavior", code: "expect(increment(1)).to_equal(2)", symbols: symbols, related_tests: [])
    SpecFile(path: "test/increment_spec.spl", header_docstring: "# Increment", metadata: [], test_cases: [test])

fn robust_06_semantic_docs_assert_render_failure<T>(result: Result<T, SemanticLinkErrorV1>) -> SemanticLinkFailureV1:
    match result:
        case Err(error): error.failure
        case Ok(_): panic("expected semantic rendering to refuse the target")

describe "verified semantic links in generated specifications":
    it "should render one verified link consistently in summary index and detail":
        step("Prepare the production input")
        val source = "fn increment(value: i64) -> i64:\n    value + 1\n"
        val path = robust_06_semantic_docs_setup_render_source(source)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample.math", path, revision).unwrap()
        val uri = semantic_link_document_uri_v1(document, 0, true).unwrap()
        val spec = robust_06_semantic_docs_setup_render_spec([uri, uri, "unresolved_heuristic"])
        step("Exercise the production boundary")
        val links = semantic_doc_symbol_map_v1(spec, document, revision).unwrap()
        val markdown = render_markdown_with_symbol_links_v1(spec, links)
        step("Inspect the observed result")
        expect(links.len()).to_equal(1)
        expect(markdown).to_contain("[sample.math.increment](" + uri + ")")
        expect(markdown).to_contain("`unresolved_heuristic`")
        expect(markdown).to_contain("## Symbol Index")
        expect(file_delete(path)).to_equal(true)

    it "should refuse malformed unresolved and stale links rather than print verified output":
        step("Prepare the production input")
        val source = "fn increment(value: i64) -> i64:\n    value + 1\n"
        val path = robust_06_semantic_docs_setup_render_source(source)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample.math", path, revision).unwrap()
        val uri = semantic_link_document_uri_v1(document, 0, false).unwrap()
        step("Reject the negative control")
        expect(robust_06_semantic_docs_assert_render_failure(semantic_doc_symbol_map_v1(
            robust_06_semantic_docs_setup_render_spec(["spl:fn@sample.math.increment~bad"]), document, revision))).to_equal(SemanticLinkFailureV1.InvalidUri)
        expect(robust_06_semantic_docs_assert_render_failure(semantic_doc_symbol_map_v1(
            robust_06_semantic_docs_setup_render_spec([uri.replace(".increment~", ".missing~")]), document, revision))).to_equal(SemanticLinkFailureV1.UnresolvedTarget)
        expect(file_write(path, source + "# edited\n")).to_equal(true)
        expect(robust_06_semantic_docs_assert_render_failure(semantic_doc_symbol_map_v1(
            robust_06_semantic_docs_setup_render_spec([uri]), document, revision))).to_equal(SemanticLinkFailureV1.RevisionChanged)
        expect(file_delete(path)).to_equal(true)

    it "should escape labels in both paragraph and Markdown table contexts":
        step("Exercise the production boundary")
        expect(semantic_doc_label_v1("[x]|<tag>&\nnext")).to_equal("\\[x\\]&#124;&lt;tag&gt;&amp; next")

    it "should preserve ordinary symbol rendering with an empty semantic map":
        step("Prepare the production input")
        val spec = robust_06_semantic_docs_setup_render_spec(["increment"])
        step("Exercise the production boundary")
        val markdown = render_markdown_with_symbol_links_v1(spec, {})
        step("Inspect the observed result")
        expect(markdown).to_contain("`increment`")
        expect(markdown).to_contain("expect(increment(1)).to_equal(2)")

    it "should preserve an existing output file when a source revision becomes stale":
        step("Prepare the production input")
        val source = "fn increment(value: i64) -> i64:\n    value + 1\n"
        val path = robust_06_semantic_docs_setup_render_source(source)
        val output = path + ".md"
        expect(file_write(output, "previous document")).to_equal(true)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample.math", path, revision).unwrap()
        val uri = semantic_link_document_uri_v1(document, 0, true).unwrap()
        val spec = robust_06_semantic_docs_setup_render_spec([uri])
        step("Reject the negative control")
        expect(file_write(path, source + "# edited\n")).to_equal(true)
        expect(robust_06_semantic_docs_assert_render_failure(generate_markdown_semantic_v1(spec, output, document, revision))).to_equal(SemanticLinkFailureV1.RevisionChanged)
        expect(file_read(output)).to_equal("previous document")
        expect(file_delete(path)).to_equal(true)
        expect(file_delete(output)).to_equal(true)

    it "should preserve the old file and clean staging when the atomic provider cannot create a temporary output":
        step("Prepare the production input")
        val source = "fn increment(value: i64) -> i64:\n    value + 1\n"
        val path = robust_06_semantic_docs_setup_render_source(source)
        val directory = secure_temp_dir(get_temp_dir(), "semantic-render-").unwrap()
        # The admitted Linux filesystem supports a 255-byte leaf. Existing
        # atomic provider appends .tmp.pid.sequence, forcing staging open to
        # fail while a plain unlink/write would clobber this valid old file.
        var characters: [text] = []
        for i in 0..255:
            characters.push("o")
        val output = directory + "/" + characters.join("")
        expect(file_write(output, "previous document")).to_equal(true)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample.math", path, revision).unwrap()
        val uri = semantic_link_document_uri_v1(document, 0, true).unwrap()
        step("Exercise the production boundary")
        expect(generate_markdown_semantic_v1(robust_06_semantic_docs_setup_render_spec([uri]), output, document, revision).unwrap()).to_equal(false)
        step("Inspect the observed result")
        expect(file_read(output)).to_equal("previous document")
        expect(dir_list(directory).len()).to_equal(1)
        expect(file_delete(output)).to_equal(true)
        expect(dir_remove(directory, false)).to_equal(true)
        expect(file_delete(path)).to_equal(true)

    it "should recheck real source after rendering and bind successful publication to its exact revision":
        step("Prepare the production input")
        val source = "fn increment(value: i64) -> i64:\n    value + 1\n"
        val path = robust_06_semantic_docs_setup_render_source(source)
        val output = path + ".md"
        val previous = "previous verified page"
        expect(file_write(output, previous)).to_equal(true)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample.math", path, revision).unwrap()
        val uri = semantic_link_document_uri_v1(document, 0, true).unwrap()
        val spec = robust_06_semantic_docs_setup_render_spec([uri])
        val links = semantic_doc_symbol_map_v1(spec, document, revision).unwrap()
        val rendered = render_markdown_with_symbol_links_v1(spec, links)
        step("Reject the negative control")
        expect(file_write(path, source + "# changed after render\n")).to_equal(true)
        expect(robust_06_semantic_docs_assert_render_failure(
            publish_semantic_markdown_content_v1(rendered, output, path, revision))).to_equal(SemanticLinkFailureV1.RevisionChanged)
        expect(file_read(output)).to_equal(previous)
        step("Inspect the observed result")
        expect(file_write(path, source)).to_equal(true)
        expect(publish_semantic_markdown_content_v1(rendered, output, path, revision).unwrap()).to_equal(true)
        val published = file_read(output)
        expect(published).to_contain("<!-- semantic-source-revision-sha256: " + revision + " -->")
        expect(published).to_contain(rendered)
        expect(published).to_contain("[sample.math.increment](" + uri + ")")
        expect(file_delete(path)).to_equal(true)
        expect(file_delete(output)).to_equal(true)
