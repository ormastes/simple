# REQ-MC-008 B4 actual existing spec-gen CLI, authored runtime UNRUN.
use std.spec.{describe, it, expect, step}
use app.io.mod.{process_run_timeout}
use app.doc.spec_gen.parser.{parse_spec_file}
use compiler.semantics.symbol_id.semantic_link_source.{open_semantic_link_document_v1, semantic_link_document_uri_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io_runtime.{file_write, file_read, getpid, time_now_unix_micros}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_remove}
use std.env.platform.{get_temp_dir}

describe "semantic declaration links in the existing spec-gen CLI":
    it "should render explicit Links annotations and preserve output on stale authority":
        step("Prepare the production input")
        val root = secure_temp_dir(get_temp_dir(), "semantic-spec-cli-").unwrap()
        val source = "fn increment(value: i64) -> i64:\n    value + 1\n"
        val source_file = root + "/math.spl"
        val spec_file = root + "/increment_spec.spl"
        val output_dir = root + "/manual"
        expect(file_write(source_file, source)).to_equal(true)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample.math", source_file, revision).unwrap()
        val uri = semantic_link_document_uri_v1(document, 0, true).unwrap()
        # Existing ## Test marker and **Links:** annotation; actual modern it.
        val fixture = "## Test: Increment\n\"\"\"\n**Links:** " + uri + "\n\"\"\"\ndescribe \"increment\":\n    it \"should increment\":\n        expect(increment(1)).to_equal(2)\n"
        expect(file_write(spec_file, fixture)).to_equal(true)
        val options = ["--input", spec_file, "--output", output_dir, "--source-file", source_file, "--package", "pkg", "--module", "sample.math", "--revision", revision]
        step("Exercise the production boundary")
        val (out, err, code) = process_run_timeout("bin/simple", ["spec-gen"].merge(options), 30000)
        expect(code).to_equal(0)
        val rendered = file_read(output_dir + "/increment.md")
        step("Inspect the observed result")
        expect(rendered).to_contain("[sample.math.increment](" + uri + ")")
        step("Reject the negative control")
        expect(file_write(source_file, source + "# edited\n")).to_equal(true)
        val (stale_out, stale_err, stale_code) = process_run_timeout("bin/simple", ["spec-gen"].merge(options), 30000)
        expect(stale_code).to_equal(1)
        expect(file_read(output_dir + "/increment.md")).to_equal(rendered)
        expect(dir_remove(root, true)).to_equal(true)

    it "should refuse partial authority and all-spec scope before generation":
        step("Reject the negative control")
        val (partial_out, partial_err, partial_code) = process_run_timeout("bin/simple", ["spec-gen", "--input", "missing_spec.spl", "--source-file", "missing.spl"], 30000)
        expect(partial_code).to_equal(1)
        expect(partial_out + partial_err).to_contain("source authority")
        val (all_out, all_err, all_code) = process_run_timeout("bin/simple", ["spec-gen", "--all", "--source-file", "missing.spl", "--package", "pkg", "--module", "sample.math", "--revision", sha256_text("missing")], 30000)
        expect(all_code).to_equal(1)
        expect(all_out + all_err).to_contain("single --input")

    it "should validate markerless modern Links annotations and preserve output for a later malformed annotation":
        step("Prepare the production input")
        val root = secure_temp_dir(get_temp_dir(), "semantic-markerless-c4-").unwrap()
        val source = "fn increment(value: i64) -> i64:\n    value + 1\n"
        val source_file = root + "/math.spl"
        val spec_file = root + "/markerless_spec.spl"
        expect(file_write(source_file, source)).to_equal(true)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample.math", source_file, revision).unwrap()
        val uri = semantic_link_document_uri_v1(document, 0, true).unwrap()
        val fixture = "describe \"math\":\n    it \"increments\":\n        \"\"\"\n        **Links:** " + uri + "\n        \"\"\"\n        expect(increment(1)).to_equal(2)\n"
        expect(file_write(spec_file, fixture)).to_equal(true)
        val parsed = parse_spec_file(spec_file, true)
        expect(parsed.test_cases.len()).to_equal(1)
        expect(parsed.test_cases[0].name).to_equal("increments")
        expect(parsed.test_cases[0].symbols).to_contain(uri)
        val options = ["--input", spec_file, "--output", root, "--source-file", source_file, "--package", "pkg", "--module", "sample.math", "--revision", revision]
        step("Exercise the production boundary")
        val (out, err, code) = process_run_timeout("bin/simple", ["spec-gen"].merge(options), 30000)
        expect(code).to_equal(0)
        val output = root + "/markerless.md"
        val rendered = file_read(output)
        expect(rendered).to_contain("[sample.math.increment](" + uri + ")")
        step("Reject the negative control")
        expect(file_write(spec_file, fixture.replace(uri, "spl:fn@sample.math.increment~bad"))).to_equal(true)
        val (bad_out, bad_err, bad_code) = process_run_timeout("bin/simple", ["spec-gen"].merge(options), 30000)
        expect(bad_code).to_equal(1)
        expect(bad_out + bad_err).to_contain("12-hex")
        expect(file_read(output)).to_equal(rendered)
        # A retained legacy marker must not hide the modern body's annotation.
        val mixed = "## Test: retained marker\n" + fixture.replace(uri, "spl:fn@sample.math.increment~bad")
        expect(file_write(spec_file, mixed)).to_equal(true)
        val mixed_parsed = parse_spec_file(spec_file, true)
        expect(mixed_parsed.test_cases.len()).to_equal(1)
        expect(mixed_parsed.test_cases[0].symbols).to_contain("spl:fn@sample.math.increment~bad")
        val (mixed_out, mixed_err, mixed_code) = process_run_timeout("bin/simple", ["spec-gen"].merge(options), 30000)
        expect(mixed_code).to_equal(1)
        expect(mixed_out + mixed_err).to_contain("12-hex")
        expect(file_read(output)).to_equal(rendered)
        expect(file_write(spec_file, "# no extractable tests\n")).to_equal(true)
        val (empty_out, empty_err, empty_code) = process_run_timeout("bin/simple", ["spec-gen"].merge(options), 30000)
        expect(empty_code).to_equal(1)
        expect(empty_out + empty_err).to_contain("extractable test")
        expect(file_read(output)).to_equal(rendered)
        expect(dir_remove(root, true)).to_equal(true)

    it "should bind leading docstring metadata despite a triple quote example in a preceding comment":
        step("Prepare the production input")
        val root = secure_temp_dir(get_temp_dir(), "semantic-comment-c5-").unwrap()
        val source = "fn increment(value: i64) -> i64:\n    value + 1\n"
        val source_file = root + "/math.spl"
        val spec_file = root + "/comment_spec.spl"
        expect(file_write(source_file, source)).to_equal(true)
        val revision = sha256_text(source)
        val document = open_semantic_link_document_v1("pkg", "sample.math", source_file, revision).unwrap()
        val uri = semantic_link_document_uri_v1(document, 0, true).unwrap()
        val fixture = "describe \"math\":\n    it \"increments\":\n        # Example delimiter: \"\"\"\n        \"\"\"\n        **Links:** " + uri + "\n        \"\"\"\n        expect(increment(1)).to_equal(2)\n"
        expect(file_write(spec_file, fixture)).to_equal(true)
        val parsed = parse_spec_file(spec_file, true)
        expect(parsed.test_cases.len()).to_equal(1)
        expect(parsed.test_cases[0].symbols).to_contain(uri)
        val options = ["--input", spec_file, "--output", root, "--source-file", source_file, "--package", "pkg", "--module", "sample.math", "--revision", revision]
        step("Exercise the production boundary")
        val (out, err, code) = process_run_timeout("bin/simple", ["spec-gen"].merge(options), 30000)
        expect(code).to_equal(0)
        val output = root + "/comment.md"
        val rendered = file_read(output)
        expect(rendered).to_contain("[sample.math.increment](" + uri + ")")
        step("Reject the negative control")
        val invalid_uri = "spl:fn@sample.math.increment~bad"
        expect(file_write(spec_file, fixture.replace(uri, invalid_uri))).to_equal(true)
        val rejected = parse_spec_file(spec_file, true)
        expect(rejected.test_cases.len()).to_equal(1)
        expect(rejected.test_cases[0].symbols).to_contain(invalid_uri)
        val (bad_out, bad_err, bad_code) = process_run_timeout("bin/simple", ["spec-gen"].merge(options), 30000)
        expect(bad_code).to_equal(1)
        expect(bad_out + bad_err).to_contain("12-hex")
        expect(file_read(output)).to_equal(rendered)
        expect(dir_remove(root, true)).to_equal(true)
