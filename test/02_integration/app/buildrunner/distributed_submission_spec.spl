# DBC-006/007/020/021: real WAL admission and duplicate request authority.
use std.spec.{describe, it, expect}
use std.common.build_manager.contracts.{BuildTaskV1, BuildHostV1}
use std.common.contracts.distributed_control_v2.*
use std.common.contracts.distributed_operation_state_v2.distributed_operation_transition_v2
use std.common.contracts.distributed_control_codec_v2.distributed_environment_digest_v2
use std.common.task_runner.distributed_operation_journal_v2.*
use std.nogc_sync_mut.io.file_ops.secure_temp_dir
use std.nogc_sync_mut.io_runtime.dir_remove
use app.buildrunner.distributed_admission.*
use app.buildrunner.distributed_submission.*

fn admission_task() -> BuildTaskV1:
    BuildTaskV1(id: "compile_1", attempt: 1, phase: "native",
        producer_digest: "a".repeat(64), source_digest: "b".repeat(64),
        toolchain_digest: "c".repeat(64), dependencies: [], program: "producer",
        args: ["compile"], inputs: [], outputs: ["result.o"],
        cache_key: "d".repeat(64), timeout_ms: 1000, memory_limit_bytes: 1024,
        links: [], memory_policy: "enforce")

fn admission_host() -> BuildHostV1:
    BuildHostV1(id: "worker_1", transport: "local", endpoint: "",
        workspace: "/isolated", worker_program: "compiled_worker",
        worker_digest: "e".repeat(64), slots: 1)

fn admission_environment() -> ExecutionEnvironmentV2:
    ExecutionEnvironmentV2(host_id: "worker_1", execution_platform: "linux_x64",
        target_platform: "linux_x64", test_runtime: "linux_native",
        isolation_class: "native-process", toolchain_digest: "c".repeat(64),
        sdk_digest: "f".repeat(64), abi: "gnu", isa: "baseline", optimization: "release")

fn admission_environment_digest() -> text:
    match distributed_environment_digest_v2(admission_environment()):
        case Ok(value): value
        case Err(reason):
            expect(reason).to_equal("")
            ""

fn admission_request() -> OperationEnvelopeV2:
    var payload = ""
    match distributed_build_payload_digest_v2(admission_task()):
        case Ok(value): payload = value
        case Err(reason): expect(reason).to_equal("")
    OperationEnvelopeV2(version: 2, id: "operation_1", payload_digest: payload,
        principal: "user_1", project: "project_1", host_id: "worker_1",
        operation: "build", environment_digest: admission_environment_digest(),
        policy_revision: 4, revocation_epoch: 2, session_generation: 3,
        memory_bytes: 1024, duration_ms: 1000)

fn admission_grant() -> ExecutionGrantV2:
    ExecutionGrantV2(id: "grant_1", principal: "user_1", project: "project_1",
        host_id: "worker_1", operations: ["build"], environment_digest: admission_environment_digest(),
        policy_revision: 4, revocation_epoch: 2, expires_at: 200,
        maximum_memory_bytes: 2048, maximum_duration_ms: 2000)


fn submit_fixture(owner: DistributedOperationJournalV2, request: OperationEnvelopeV2,
        task: BuildTaskV1, now: i64) -> Result<ManagedBuildAdmissionV2, text>:
    distributed_build_submit_v2(owner, admission_grant(), request, task,
        admission_host(), admission_environment(), admission_environment(), now, 4, 2, 3)

fn begin_fixture(owner: DistributedOperationJournalV2, now: i64) -> Result<DistributedOperationJournalV2, text>:
    distributed_build_begin_v2(owner, admission_grant(), admission_request(), admission_task(),
        admission_host(), admission_environment(), admission_environment(), now, 4, 2, 3)

describe "managed build durable submission":
    it "commits once and retains exact duplicate admission after reopen":
        val root = secure_temp_dir("build", "managed-build-admission").unwrap()
        val owner = distributed_operation_journal_open_v2(root, "a".repeat(64), "b".repeat(64), 32).unwrap()
        val admitted = submit_fixture(owner, admission_request(), admission_task(), 100).unwrap()
        expect(admitted.disposition).to_equal("NEWLY_ADMITTED")
        expect(admitted.journal.sequence).to_equal(1)
        val duplicate = submit_fixture(admitted.journal, admission_request(), admission_task(), 100).unwrap()
        expect(duplicate.disposition).to_equal("ALREADY_ADMITTED")
        expect(duplicate.journal.sequence).to_equal(1)
        expect(distributed_operation_journal_lookup_v2(owner, "operation_1").is_err()).to_equal(true)
        expect(distributed_operation_journal_close_v2(admitted.journal).unwrap()).to_equal(true)
        val recovered = distributed_operation_journal_open_v2(root, "a".repeat(64), "c".repeat(64), 32).unwrap()
        val retained = submit_fixture(recovered, admission_request(), admission_task(), 100).unwrap()
        expect(retained.disposition).to_equal("ALREADY_ADMITTED")
        expect(retained.journal.sequence).to_equal(1)
        expect(distributed_operation_journal_close_v2(recovered).unwrap()).to_equal(true)
        expect(dir_remove(root, true)).to_equal(true)

    it "rejects reusing the operation ID for another correctly bound task":
        val root = secure_temp_dir("build", "managed-build-replay").unwrap()
        val owner = distributed_operation_journal_open_v2(root, "a".repeat(64), "b".repeat(64), 32).unwrap()
        val admitted = submit_fixture(owner, admission_request(), admission_task(), 100).unwrap()
        var changed = admission_task()
        changed.args = ["compile", "changed_flag"]
        var request = admission_request()
        request.payload_digest = distributed_build_payload_digest_v2(changed).unwrap()
        match submit_fixture(admitted.journal, request, changed, 100):
            case Ok(value): expect(value).to_be_nil()
            case Err(reason): expect(reason).to_equal("OPERATION_PAYLOAD_MISMATCH")
        expect(distributed_operation_journal_lookup_v2(admitted.journal, "operation_1").unwrap().state).to_equal("admitted")
        match distributed_build_begin_v2(admitted.journal, admission_grant(), request, changed,
                admission_host(), admission_environment(), admission_environment(), 100, 4, 2, 3):
            case Ok(value): expect(value).to_be_nil()
            case Err(reason): expect(reason).to_equal("OPERATION_PAYLOAD_MISMATCH")
        expect(distributed_operation_journal_lookup_v2(admitted.journal, "operation_1").unwrap().state).to_equal("admitted")
        expect(distributed_operation_journal_close_v2(admitted.journal).unwrap()).to_equal(true)
        expect(dir_remove(root, true)).to_equal(true)

    it "reauthorizes exact duplicate lookup and refuses expired grants":
        val root = secure_temp_dir("build", "managed-build-expiry").unwrap()
        val owner = distributed_operation_journal_open_v2(root, "a".repeat(64), "b".repeat(64), 32).unwrap()
        val admitted = submit_fixture(owner, admission_request(), admission_task(), 100).unwrap()
        match submit_fixture(admitted.journal, admission_request(), admission_task(), 200):
            case Ok(value): expect(value).to_be_nil()
            case Err(reason): expect(reason).to_equal("GRANT_EXPIRED")
        expect(admitted.journal.sequence).to_equal(1)
        expect(distributed_operation_journal_close_v2(admitted.journal).unwrap()).to_equal(true)
        expect(dir_remove(root, true)).to_equal(true)

    it "durably retains execution uncertainty across replacement owners":
        val root = secure_temp_dir("build", "managed-build-uncertainty").unwrap()
        val owner = distributed_operation_journal_open_v2(root, "a".repeat(64), "b".repeat(64), 32).unwrap()
        val admitted = submit_fixture(owner, admission_request(), admission_task(), 100).unwrap()
        val started = begin_fixture(admitted.journal, 100).unwrap()
        expect(distributed_operation_journal_close_v2(started).unwrap()).to_equal(true)
        val replacement = distributed_operation_journal_open_v2(root, "a".repeat(64), "c".repeat(64), 32).unwrap()
        val recovered = distributed_operation_journal_recover_execution_v2(replacement, "operation_1").unwrap()
        expect(recovered.sequence).to_equal(3)
        val duplicate = submit_fixture(recovered, admission_request(), admission_task(), 100).unwrap()
        expect(duplicate.disposition).to_equal("OUTCOME_UNKNOWN")
        val uncertain = distributed_operation_journal_lookup_v2(recovered, "operation_1").unwrap()
        expect(distributed_operation_transition_v2(uncertain, "executing", "").is_err()).to_equal(true)
        val unchanged = distributed_operation_journal_recover_execution_v2(recovered, "operation_1").unwrap()
        expect(unchanged.sequence).to_equal(3)
        expect(distributed_operation_journal_close_v2(unchanged).unwrap()).to_equal(true)
        val reopened = distributed_operation_journal_open_v2(root, "a".repeat(64), "d".repeat(64), 32).unwrap()
        expect(distributed_operation_journal_lookup_v2(reopened, "operation_1").unwrap().state).to_equal("outcome-unknown")
        expect(distributed_operation_journal_close_v2(reopened).unwrap()).to_equal(true)
        expect(dir_remove(root, true)).to_equal(true)

    it "reauthorizes execution and commits its claim only once":
        val root = secure_temp_dir("build", "managed-build-execution").unwrap()
        val owner = distributed_operation_journal_open_v2(root, "a".repeat(64), "b".repeat(64), 32).unwrap()
        val admitted = submit_fixture(owner, admission_request(), admission_task(), 100).unwrap()
        match begin_fixture(admitted.journal, 200):
            case Ok(value): expect(value).to_be_nil()
            case Err(reason): expect(reason).to_equal("GRANT_EXPIRED")
        expect(distributed_operation_journal_lookup_v2(admitted.journal, "operation_1").unwrap().state).to_equal("admitted")
        val started = begin_fixture(admitted.journal, 100).unwrap()
        expect(started.sequence).to_equal(2)
        match begin_fixture(started, 100):
            case Ok(value): expect(value).to_be_nil()
            case Err(reason): expect(reason).to_equal("ALREADY_EXECUTING")
        expect(distributed_operation_journal_lookup_v2(started, "operation_1").unwrap().state).to_equal("executing")
        expect(distributed_operation_journal_close_v2(started).unwrap()).to_equal(true)
        expect(dir_remove(root, true)).to_equal(true)

    it "preserves execution authority when recovery exhausts the journal bound":
        val root = secure_temp_dir("build", "managed-build-journal-full").unwrap()
        val owner = distributed_operation_journal_open_v2(root, "a".repeat(64), "b".repeat(64), 2).unwrap()
        val admitted = submit_fixture(owner, admission_request(), admission_task(), 100).unwrap()
        val started = begin_fixture(admitted.journal, 100).unwrap()
        expect(distributed_operation_journal_close_v2(started).unwrap()).to_equal(true)
        val replacement = distributed_operation_journal_open_v2(root, "a".repeat(64), "c".repeat(64), 2).unwrap()
        match distributed_operation_journal_recover_execution_v2(replacement, "operation_1"):
            case Ok(value): expect(value).to_be_nil()
            case Err(reason): expect(reason).to_equal("OPERATION_JOURNAL_FULL")
        expect(distributed_operation_journal_lookup_v2(replacement, "operation_1").unwrap().state).to_equal("executing")
        match begin_fixture(replacement, 100):
            case Ok(value): expect(value).to_be_nil()
            case Err(reason): expect(reason).to_equal("ALREADY_EXECUTING")
        expect(distributed_operation_journal_close_v2(replacement).unwrap()).to_equal(true)
        expect(dir_remove(root, true)).to_equal(true)
