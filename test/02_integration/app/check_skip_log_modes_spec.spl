use std.spec.{describe, it, expect}
use std.spec.step
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.env.platform.{is_windows, get_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all}
use std.nogc_sync_mut.io.file_ops.{file_create_exclusive}
use std.env.variables.{env_get}
use std.nogc_sync_mut.io.env_ops.{cwd}

val CLI_RUN_TIMEOUT_MS: i64 = 120000
val CLI_RUN_MAX_OUT: i64 = 16777216

fn _cli_repo_root() -> text:
    cwd().replace("\\", "/")

fn _spawn_cli(run_args: [text], work_dir: text, extra_env: [(text, text)]) -> (text, text, i64):
    """Host-portable replacement for the old POSIX sh harness: runs
    `bin/simple run <run_args...>` with SIMPLE_LIB bound to the repo src
    tree, optionally under a different working directory and with extra
    environment variables set for the child."""
    val repo = _cli_repo_root()
    val program = if is_windows(): repo + "/bin/simple.exe" else: repo + "/bin/simple"
    val lib = repo + "/src"
    val joined = run_args.join(" ")
    val (shell, shell_args) = if is_windows():
        val sh = env_get("ComSpec") ?? "cmd.exe"
        var cmd = ""
        if work_dir != "":
            cmd = cmd + "cd /d " + work_dir + " && "
        for (key, value) in extra_env:
            cmd = cmd + "set \"" + key + "=" + value + "\" && "
        cmd = cmd + "set \"SIMPLE_LIB=" + lib + "\" && " + program + " run " + joined
        (sh, ["/d", "/c", cmd])
    else:
        var prefix = ""
        if work_dir != "":
            prefix = prefix + "cd \"" + work_dir + "\" && "
        for (key, value) in extra_env:
            prefix = prefix + key + "=\"" + value + "\" "
        ("/bin/sh", ["-c", prefix + "SIMPLE_LIB=\"" + lib + "\" \"" + program + "\" run " + joined])
    process_run_bounded(shell, shell_args, CLI_RUN_TIMEOUT_MS, CLI_RUN_MAX_OUT)
# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/02_integration/app/check_skip_log_modes_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/check_skip_log_modes_spec.md
# doc-path: doc/03_plan/sys_test/check_skip_log_modes_spec.md
# doc-path: doc/04_architecture/check_skip_log_modes_spec.md
# doc-path: doc/05_design/check_skip_log_modes_spec_oracles.md
# @manual: primary


val FIXTURE_DIR = get_temp_dir().replace("\\", "/") + "/simple_check_skip_log_mode_fixture"

fn _setup_fixture():
    val _removed = dir_remove_all(FIXTURE_DIR)
    if not dir_create_all(FIXTURE_DIR + "/test/unit"):
        fail("could not create fixture dir " + FIXTURE_DIR + "/test/unit")
    if not file_create_exclusive(FIXTURE_DIR + "/test/unit/sample_spec.spl", "# temporarily disabled\n# @skip\ndescribe \"sample\":\n    it \"works\":\n        assert true\n"):
        fail("could not write fixture file " + FIXTURE_DIR + "/test/unit/sample_spec.spl")

fn _run_check_skip(args: [text]) -> (text, text, i64):
    _spawn_cli(["src/app/check_skip/main.spl"] + args, FIXTURE_DIR, [])

describe "check-skip log mode CLI options":
    # @manual scenario evidence
    it "shows shared log options in help":
        _setup_fixture()
        val (out, err, code) = _run_check_skip(["--help"])
        expect(code).to_equal(0)
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json":
        _setup_fixture()
        val (out, err, code) = _run_check_skip(["--log-mode=json"])
        expect(code).to_equal(0)
        expect(out).to_contain("\"command\":\"check-skip\"")
        expect(out).to_contain("\"total\":1")
        expect(out).to_contain("\"skipped\":1")

    it "supports dot progress":
        _setup_fixture()
        val (out, err, code) = _run_check_skip(["--progress=dot"])
        expect(code).to_equal(0)
        expect(out).to_contain(".")
        expect(out).to_contain("Skip/Pending Test Report")

    it "rejects invalid log mode":
        _setup_fixture()
        val (out, err, code) = _run_check_skip(["--log-mode=noisy"])
        expect(code).to_equal(1)
