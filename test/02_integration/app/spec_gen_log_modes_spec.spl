"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the spec-gen command
(--log-mode and --progress) as observed through real process invocations
against a fixture feature directory containing one sample spec.
Audience: compiler and tooling engineers who maintain the spec_gen app and
the shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/spec_gen_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the spec-gen command's shared log options only; every scenario scans
the fixture test/feature directory with exactly one authored spec, so the
one-document generation count is exercised rather than bulk behavior.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: spec-gen-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_spec_gen_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + "/test/feature && cat > " + FIXTURE_DIR + "/test/feature/sample_spec.spl <<'EOF'\n/// Sample feature docs\ndescribe \"sample feature\":\n    it \"does useful work\":\n        assert true\nEOF"
    ])

fn _run_spec_gen(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/spec_gen/main.spl\" " + joined
    ])

describe "spec-gen log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-SPEC-GEN-LOGMODE-001
        # @capture(tui_grid): spec-gen help text listing the shared log options
        step("Run spec-gen --help in the fixture directory")
        _setup_fixture()
        val (out, err, code) = _run_spec_gen(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json":
        # @req REQ-SPEC-GEN-LOGMODE-002
        # @capture(protocol_json): spec-gen JSON transcript with the one-document generated count
        step("Generate documents for the fixture feature with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_spec_gen(["--log-mode=json", "test/feature"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed generation walk
        expect(out).to_contain("\"command\":\"spec-gen\"")
        expect(out).to_contain("\"status\":\"ok\"")
        expect(out).to_contain("\"generated\":1")  # oracle: the fixture holds exactly one sample spec

    it "supports dot progress":
        # @req REQ-SPEC-GEN-LOGMODE-003
        # @capture(tui_grid): dot-progress output followed by the generated-count line
        step("Generate documents for the fixture feature with dot progress")
        _setup_fixture()
        val (out, err, code) = _run_spec_gen(["--progress=dot", "test/feature"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed generation walk
        expect(out).to_contain(".")
        expect(out).to_contain("Generated 1 spec documents")  # oracle: the fixture holds exactly one sample spec

    it "rejects invalid log mode":
        # @req REQ-SPEC-GEN-LOGMODE-004
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke spec-gen with an unknown log mode and expect a usage error")
        _setup_fixture()
        val (out, err, code) = _run_spec_gen(["--log-mode=noisy", "test/feature"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
