use std.spec.{describe, it, expect}
use app.debug_doctor.profile_v1.{load_debug_doctor_profile_v1}
use app.debug_doctor.main.{debug_doctor_registry}
use std.debug_doctor.matrix.{doctor_rows, doctor_capabilities_v1}
use std.notebook.gpu_mode_probe_live.{LiveGpuBackendProbe}
use app.debug_doctor.profile_v1.{evaluate_debug_doctor_profile_v1}

describe "debug doctor profile integration":
    it "loads a real SDN profile and proves its live host requirement":
        val loaded = load_debug_doctor_profile_v1("test/fixtures/debug/doctor_host_live.sdn")
        expect(loaded.ok).to_equal(true)
        val registry = debug_doctor_registry(loaded.profile.program)
        var probe = LiveGpuBackendProbe.create()
        val reports = doctor_capabilities_v1(
            doctor_rows(registry, probe, loaded.profile.program), "test")
        val health = evaluate_debug_doctor_profile_v1(loaded.profile, reports)
        expect(health.healthy).to_equal(true)
        expect(health.failures.len()).to_equal(0)

    it "fails closed when the requested profile is absent":
        val loaded = load_debug_doctor_profile_v1("test/fixtures/debug/missing-doctor-profile.sdn")
        expect(loaded.ok).to_equal(false)
        expect(loaded.error).to_contain("not found")
