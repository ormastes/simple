"""
## Purpose and audience
Purpose: pin that a clean-tree tracking regeneration is a no-op for curated
rows. todo-scan used to (a) DELETE a committed row whose description held an
inner double quote (the reader took the first quote as the terminator and
dropped the row; the rewrite then lost it), and (b) flip a still-live open
row to `closed` and re-add its marker under a new id whenever triage had
appended a `YYYY-MM-DD note: ...` to the description. The generated docs also
changed on every day because of the `**Generated:**` stamp.
Audience: tooling engineers maintaining src/app/todo_scan/main.spl and
src/app/tracking_doc/stable_write.spl.
## Operator workflow
Run with
`SIMPLE_LIB=src bin/simple test test/02_integration/app/todo_scan_curated_rows_spec.spl --mode=interpreter`.
## Compatibility and limitations
Spawns real `bin/simple` processes against a repo-relative fixture tree under build/tmp (an MSYS /tmp path is
unreadable to the runtime on Windows); each
scenario rebuilds the fixture, so scenarios are independent.
## Verification guidance and troubleshooting
Inspect build/tmp/simple_todo_scan_curated_rows_fixture to reproduce a failure.
"""
# @manual_section: todo-scan-curated-rows

use std.spec.{describe, it, expect}
use std.spec.step

use app.io.mod (file_read)
use app.tracking_doc.stable_write.{strip_generated_stamp}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "build/tmp/simple_todo_scan_curated_rows_fixture"

fn _setup_fixture():
    val (_o, _e, _c) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + "/src " + FIXTURE_DIR + "/doc/08_tracking/todo && cat > " + FIXTURE_DIR + "/src/m.spl <<'EOF'\n# TODO: [gpu][P2] verify this probe against a real metal host\n# TODO: [gpu][P1] keep inner quote row alive\nfn main() -> i64:\n    0\nEOF\ncat > " + FIXTURE_DIR + "/doc/08_tracking/todo/todo_db.sdn <<'EOF'\ntodos |id, keyword, area, priority, description, file, line, issue, blocked, status, valid|\n    20, TODO, gpu, P2, \"verify this probe against a real metal host 2026-09-16 note: still unexercised\", src/m.spl, 1, , \"\", open, true\n    21, TODO, gpu, P1, \"keep inner quote row alive note: probe_error=\"none\", seen twice\", src/m.spl, 2, , \"\", open, true\n    30, TODO, gpu, P1, \"registry item with no code marker\", doc/08_tracking/todo/reg.md, 1, , \"\", open, true\nEOF\nprintf '# Registry record\\n' > " + FIXTURE_DIR + "/doc/08_tracking/todo/reg.md"
    ])

fn _run_scan() -> (text, text, i64):
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd \"$REPO/" + FIXTURE_DIR + "\" && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/todo_scan/main.spl\" --no-progress"
    ])

fn _read_db() -> text:
    file_read(FIXTURE_DIR + "/doc/08_tracking/todo/todo_db.sdn") ?? ""

describe "todo-scan curated rows":
    it "keeps a row whose description holds inner double quotes":
        # @req REQ-SSPEC-APP
        step("Scan a fixture whose committed row 21 has probe_error=\"none\" inside its description")
        _setup_fixture()
        val (_out, _err, code) = _run_scan()
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code
        val db = _read_db()
        # Row 21 survives with its id and open status (quotes are normalized
        # to single quotes by the writer); it was previously deleted.
        expect(db).to_contain("21, TODO, gpu, P1, \"keep inner quote row alive note: probe_error='none', seen twice\", src/m.spl, 2, , \"\", open, true")

    it "keeps an annotated live row open instead of closing and duplicating it":
        # @req REQ-SSPEC-APP
        step("Scan a fixture whose committed row 20 carries an appended triage note")
        _setup_fixture()
        val (_out, _err, code) = _run_scan()
        expect(code).to_equal(0)
        val db = _read_db()
        expect(db).to_contain("20, TODO, gpu, P2, \"verify this probe against a real metal host 2026-09-16 note: still unexercised\", src/m.spl, 1, , \"\", open, true")
        # No fresh id was minted for either live marker.
        expect(db).to_contain("21, TODO, gpu, P1")
        expect(db.contains("31, TODO")).to_equal(false)

    it "keeps an open tracking-registry row open although it has no marker":
        # @req REQ-SSPEC-APP
        step("Scan a fixture whose open row 30 points at a doc/08_tracking record")
        _setup_fixture()
        val (_out, _err, code) = _run_scan()
        expect(code).to_equal(0)
        expect(_read_db()).to_contain("30, TODO, gpu, P1, \"registry item with no code marker\", doc/08_tracking/todo/reg.md, 1, , \"\", open, true")

    it "is a no-op on a second scan":
        # @req REQ-SSPEC-APP
        step("Run two consecutive scans and compare the db bytes")
        _setup_fixture()
        val (_o1, _e1, c1) = _run_scan()
        expect(c1).to_equal(0)
        val db1 = _read_db()
        val (_o2, _e2, c2) = _run_scan()
        expect(c2).to_equal(0)
        expect(_read_db()).to_equal(db1)

    it "ignores only the Generated stamp when comparing generated docs":
        # @req REQ-SSPEC-APP
        step("Compare two docs that differ only in their Generated date, then in content")
        val a = "# Recent Bugs\n\n**Generated:** 2026-09-07\n**Open:** 3\n"
        val b = "# Recent Bugs\r\n\r\n**Generated:** 2026-11-01\r\n**Open:** 3\r\n"
        val c = "# Recent Bugs\n\n**Generated:** 2026-11-01\n**Open:** 4\n"
        expect(strip_generated_stamp(a)).to_equal(strip_generated_stamp(b))
        expect(strip_generated_stamp(a) == strip_generated_stamp(c)).to_equal(false)
