"""
## Purpose and audience
Purpose: pin the hosted physical environment executor's capture-once,
replay-exact contract for process poll, ambient environment, regular file,
stream, clock, and random entropy surfaces under sealed capability policy.
Audience: MCDC HAL runtime engineers who own the environment instruction
executor and its capability/receipt wire contract.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/hal_environment_physical_executor_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed executor behavior.
## Compatibility and limitations
Exercises the hosted executor wrappers only; file capture reads the checked-in
config/critical_mode.sdn from the repository working directory and clock/random
capture requires the nondeterministic authority bit, so no baremetal target is
covered here.
## Verification guidance and troubleshooting
A failure names the opcode and policy combination that regressed; re-run this
spec and compare the failing scenario's receipt fields (applied,
physical_effect, allocation_count_after_seal) to reproduce locally.
"""
# @feature mcdc_hal_runtime_hardening
# @req REQ-011 REQ-016 REQ-017
# Lifecycle: doc/01_research/local/mcdc_hal_runtime_hardening.md ;
# doc/03_plan/agent_tasks/mcdc_hal_runtime_hardening.md ;
# doc/04_architecture/mcdc_hal_runtime_hardening.md ;
# doc/05_design/mcdc_hal_runtime_hardening.md
# @manual_section: hosted-physical-environment-executor

use std.spec.*
use app.io.{cwd, getpid}
use app.test.hal_environment_executor.{
    HostedProcessPollEnvExecutorV1, hosted_prepare_environment_get_v1,
    hosted_prepare_file_read_v1, hosted_prepare_stream_read_v1,
    hosted_prepare_clock_read_v1, hosted_prepare_random_fill_v1
}
use std.common.structural.environment_instruction.*

fn put_i64_le(out: [u8], value: i64):
    var i = 0
    while i < 8:
        out[i] = ((value >> (i * 8)) & 255) as u8
        i = i + 1

fn ascii_bytes(value: text) -> [u8]:
    var out: [u8] = [0u8; value.len()]
    var i = 0
    while i < value.len():
        out[i] = value.char_code_at(i) as u8
        i = i + 1
    out

fn capture_policy(opcode: EnvOpcodeV1, capability_id: i64,
                  allow_nondeterministic: bool = false) -> EnvExecutorPolicyV1:
    val nondeterministic = if opcode == EnvOpcodeV1.ClockRead
            or opcode == EnvOpcodeV1.RandomFill:
        env_opcode_mask_v1(opcode)
    else:
        0
    env_executor_policy_v1(env_opcode_mask_v1(opcode), 1 << capability_id,
        0, nondeterministic, false, allow_nondeterministic, true)

fn capture_instruction(opcode: EnvOpcodeV1, capability_id: i64,
                       argument_length: i64,
                       result_capacity: i64) -> EnvInstructionV1:
    env_instruction_v1(41, 0, opcode, capability_id, 0,
        0, argument_length, argument_length, 0,
        result_capacity, result_capacity)

describe "hosted physical environment executor":
    it "polls the current process through the canonical process facade":
        # @req REQ-016
        # @capture(protocol_binary): process-poll receipt with allocation count after seal
        step("Poll the current process id through the hosted executor under capability 7")
        val executor = HostedProcessPollEnvExecutorV1(sealed: true)
        val operation = env_instruction_v1(
            29, 0, EnvOpcodeV1.ProcessPoll, 7, 0,
            0, 8, 8, 0, 1, 1)
        val policy = env_executor_policy_v1(
            env_opcode_mask_v1(EnvOpcodeV1.ProcessPoll), 1 << 7,
            0, env_opcode_mask_v1(EnvOpcodeV1.ProcessPoll),
            false, true, true)
        var arguments: [u8] = [0u8; 8]
        var results: [u8] = [0u8; 1]
        put_i64_le(arguments, getpid())

        val receipt = executor.execute(policy, operation, arguments, results)

        expect(receipt.applied).to_be(true)
        expect(receipt.physical_effect).to_be(true)
        expect(receipt.allocation_count_after_seal).to_equal(0)  # oracle: a sealed capture must allocate nothing after the seal point
        expect(results[0]).to_equal(1u8)  # oracle: the executor encodes the live-process poll verdict as byte 1

    it "captures ambient environment once before seal and serves bytes without reread":
        # @req REQ-016
        # @capture(protocol_binary): environment-get capture receipt sized to the PATH value
        step("Capture the ambient PATH value once and serve it from the sealed snapshot")
        val executor = hosted_prepare_environment_get_v1("PATH")
        val key = ascii_bytes("PATH")
        val result_capacity = executor.value_bytes.len()
        val operation = env_instruction_v1(
            31, 0, EnvOpcodeV1.EnvironmentGet, 8, 0,
            0, key.len(), key.len(), 0, result_capacity, result_capacity)
        val policy = env_executor_policy_v1(
            env_opcode_mask_v1(EnvOpcodeV1.EnvironmentGet), 1 << 8,
            0, env_opcode_mask_v1(EnvOpcodeV1.EnvironmentGet),
            false, true, true)
        var results: [u8] = [0u8; result_capacity]

        val receipt = executor.execute(policy, operation, key, results)

        expect(receipt.applied).to_be(true)
        expect(receipt.physical_effect).to_be(true)
        expect(receipt.allocation_count_after_seal).to_equal(0)  # oracle: a sealed capture must allocate nothing after the seal point
        expect(receipt.observation.bytes_length).to_equal(result_capacity)  # oracle: the observation must carry exactly the captured PATH byte count

    it "fails closed for unsupported physical opcodes before any effect":
        # @req REQ-017
        # @capture(protocol_binary): rejected receipt preserving the untouched result byte
        step("Submit an environment-get instruction to the process-poll executor and expect rejection")
        val executor = HostedProcessPollEnvExecutorV1(sealed: true)
        val operation = env_instruction_v1(
            29, 0, EnvOpcodeV1.EnvironmentGet, 7, 0,
            0, 8, 8, 0, 1, 1)
        val policy = env_executor_policy_v1(
            env_opcode_mask_v1(EnvOpcodeV1.EnvironmentGet), 1 << 7,
            0, 0, false, false, true)
        val arguments: [u8] = [0u8; 8]
        var results: [u8] = [9u8; 1]

        val receipt = executor.execute(policy, operation, arguments, results)

        expect(receipt.applied).to_be(false)
        expect(env_instruction_status_to_i64(receipt.observation.status)).to_equal(
            env_instruction_status_to_i64(EnvInstructionStatusV1.UnsupportedCapability))
        expect(results[0]).to_equal(9u8)  # oracle: the sentinel 9 must survive because no result byte may be written on rejection

    it "captures a bounded regular file once and replays without a second effect":
        # @req REQ-011
        # @capture(protocol_binary): file-read capture plus replay receipt pair with digests
        step("Capture the bounded config file once and replay it from the observation")
        val root = cwd()
        val path = root + "/config/critical_mode.sdn"
        val executor = hosted_prepare_file_read_v1(path, root, 65536)
        val arguments = ascii_bytes(path)
        val operation = capture_instruction(
            EnvOpcodeV1.FileRead, 9, arguments.len(), executor.captured_length)
        var captured: [u8] = [0u8; executor.captured_length]
        var replayed: [u8] = [0u8; executor.captured_length]

        val receipt = executor.execute(
            capture_policy(EnvOpcodeV1.FileRead, 9), operation,
            arguments, captured)
        val replay = env_replay_exact_v1(
            operation, operation, receipt.observation,
            arguments, captured, replayed)

        expect(receipt.applied).to_be(true)
        expect(receipt.physical_effect).to_be(true)
        expect(receipt.allocation_count_after_seal).to_equal(0)  # oracle: a sealed capture must allocate nothing after the seal point
        expect(replay.applied).to_be(true)
        expect(replay.physical_effect).to_be(false)  # oracle: replay must serve the snapshot without a second physical read
        expect(replay.allocation_count_after_seal).to_equal(0)  # oracle: replay allocates nothing after the seal point either
        expect(replayed).to_equal(captured)

    it "binds a prepared stream snapshot to its exact handle and capacity":
        # @req REQ-011
        # @capture(protocol_binary): stream-read transcript with divergent-handle rejection status
        step("Bind stream handle 73 to its snapshot and reject a different handle")
        val payload: [u8] = [7u8, 8u8, 9u8]
        val executor = hosted_prepare_stream_read_v1(73, payload, 3, 3)
        var arguments: [u8] = [0u8; 8]
        put_i64_le(arguments, 73)
        val operation = capture_instruction(EnvOpcodeV1.StreamRead, 10, 8, 3)
        var results: [u8] = [0u8; 3]
        val receipt = executor.execute(
            capture_policy(EnvOpcodeV1.StreamRead, 10), operation,
            arguments, results)

        expect(receipt.applied).to_be(true)
        expect(receipt.allocation_count_after_seal).to_equal(0)  # oracle: a sealed capture must allocate nothing after the seal point
        expect(results).to_equal(payload)

        arguments[0] = 72u8
        val changed = executor.execute(
            capture_policy(EnvOpcodeV1.StreamRead, 10), operation,
            arguments, results)
        expect(env_instruction_status_to_i64(changed.observation.status)).to_equal(
            env_instruction_status_to_i64(EnvInstructionStatusV1.Diverged))

    it "captures clock and random once and blocks them without nondeterminism authority":
        # @req REQ-017
        # @capture(protocol_binary): clock/random capture receipts with the unsafe-instruction block
        step("Capture clock and random once, then block the unauthorized clock read and replay it")
        val clock = hosted_prepare_clock_read_v1()
        val random = hosted_prepare_random_fill_v1(16)
        val clock_op = capture_instruction(EnvOpcodeV1.ClockRead, 11, 0, 8)
        val random_op = capture_instruction(EnvOpcodeV1.RandomFill, 12, 0, 16)
        var blocked_result: [u8] = [91u8; 8]
        var clock_result: [u8] = [0u8; 8]
        var clock_replay: [u8] = [0u8; 8]
        var random_result: [u8] = [92u8; 16]

        val blocked_clock = clock.execute(
            capture_policy(EnvOpcodeV1.ClockRead, 11), clock_op, [], blocked_result)
        val captured_random = random.execute(
            capture_policy(EnvOpcodeV1.RandomFill, 12, true),
            random_op, [], random_result)
        val captured_clock = clock.execute(
            capture_policy(EnvOpcodeV1.ClockRead, 11, true),
            clock_op, [], clock_result)
        val replayed_clock = env_replay_exact_v1(
            clock_op, clock_op, captured_clock.observation,
            [], clock_result, clock_replay)

        expect(env_instruction_status_to_i64(
            blocked_clock.observation.status)).to_equal(
                env_instruction_status_to_i64(EnvInstructionStatusV1.UnsafeInstruction))
        expect(blocked_result[0]).to_equal(91u8)  # oracle: the sentinel 91 must survive because the blocked read may not write results
        expect(captured_clock.applied).to_be(true)
        expect(captured_clock.allocation_count_after_seal).to_equal(0)  # oracle: a sealed capture must allocate nothing after the seal point
        expect(replayed_clock.applied).to_be(true)
        expect(replayed_clock.physical_effect).to_be(false)  # oracle: replay must serve the snapshot without a second physical read
        expect(clock_replay).to_equal(clock_result)
        expect(captured_random.applied).to_be(true)
        expect(captured_random.allocation_count_after_seal).to_equal(0)  # oracle: a sealed capture must allocate nothing after the seal point
        expect(captured_random.observation.bytes_length).to_equal(16)  # oracle: the random capture must fill exactly the requested 16 bytes

    it "rejects oversized capture before allocating or touching result storage":
        # @req REQ-017
        # @capture(protocol_binary): oversized-request rejection receipt with untouched storage
        step("Request a 65537-byte random fill against the 32-byte authority and expect rejection")
        val executor = hosted_prepare_random_fill_v1(65537)
        val operation = capture_instruction(EnvOpcodeV1.RandomFill, 12, 0, 1)
        var result: [u8] = [55u8]
        val receipt = executor.execute(
            capture_policy(EnvOpcodeV1.RandomFill, 12, true),
            operation, [], result)

        expect(receipt.applied).to_be(false)
        expect(result[0]).to_equal(55u8)  # oracle: the sentinel 55 must survive because the oversized request may not touch result storage
