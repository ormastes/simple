"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the diff command (--log-mode
and --progress) as observed through real process invocations against a
fixture working directory.
Audience: compiler and tooling engineers who maintain the diff app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/diff_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the diff command's shared log options only; each scenario spawns real
`bin/simple` processes and builds its fixture under /tmp with two one-line
source files, old.spl and new.spl.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: diff-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_diff_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + " && printf 'one\\ntwo\\n' > " + FIXTURE_DIR + "/old.spl && printf 'one\\nthree\\n' > " + FIXTURE_DIR + "/new.spl"
    ])

fn _run_diff(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/diff/main.spl\" " + joined
    ])

describe "diff log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-DIFF-LOGMODE-001
        # @capture(tui_grid): diff help text listing the shared log options
        step("Run diff --help in the fixture directory")
        _setup_fixture()
        val (out, err, code) = _run_diff(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json":
        # @req REQ-DIFF-LOGMODE-001
        # @capture(protocol_json): diff JSON transcript reporting the one modified line
        step("Diff old.spl against new.spl with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_diff(["--log-mode=json", "old.spl", "new.spl"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a clean diff
        expect(out).to_contain("\"command\":\"diff\"")
        expect(out).to_contain("\"status\":\"ok\"")
        expect(out).to_contain("\"modifications\":1")

    it "supports dot progress":
        # @req REQ-DIFF-LOGMODE-001
        # @capture(tui_grid): dot-progress output followed by the diff stat summary
        step("Diff the two files with dot progress and --stat")
        _setup_fixture()
        val (out, err, code) = _run_diff(["--progress=dot", "--stat", "old.spl", "new.spl"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a clean diff
        expect(out).to_contain(".")
        expect(out).to_contain("1 modifications")

    it "rejects invalid log mode":
        # @req REQ-DIFF-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke diff with an unknown log mode and expect a usage error")
        _setup_fixture()
        val (out, err, code) = _run_diff(["--log-mode=noisy", "old.spl", "new.spl"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
