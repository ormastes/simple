"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the pkg command (--log-mode
and --progress) as observed through real process invocations against a
fixture working directory.
Audience: compiler and tooling engineers who maintain the pkg app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/pkg_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the pkg command's shared log options only; each scenario spawns real
`bin/simple` processes and builds its fixture under /tmp, creating a package
named sample-pkg inside it.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: pkg-log-modes

use std.spec.{describe, it, expect}
use std.spec.step
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.env.platform.{is_windows, get_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all}
use std.nogc_sync_mut.io.file_ops.{file_create_exclusive}
use std.env.variables.{env_get}
use std.nogc_sync_mut.io.env_ops.{cwd}

val CLI_RUN_TIMEOUT_MS: i64 = 120000
val CLI_RUN_MAX_OUT: i64 = 16777216

fn _cli_repo_root() -> text:
    cwd().replace("\\", "/")

fn _spawn_cli(run_args: [text], work_dir: text, extra_env: [(text, text)]) -> (text, text, i64):
    """Host-portable replacement for the old POSIX sh harness: runs
    `bin/simple run <run_args...>` with SIMPLE_LIB bound to the repo src
    tree, optionally under a different working directory and with extra
    environment variables set for the child."""
    val repo = _cli_repo_root()
    val program = if is_windows(): repo + "/bin/simple.exe" else: repo + "/bin/simple"
    val lib = repo + "/src"
    val joined = run_args.join(" ")
    val (shell, shell_args) = if is_windows():
        val sh = env_get("ComSpec") ?? "cmd.exe"
        var cmd = ""
        if work_dir != "":
            cmd = cmd + "cd /d " + work_dir + " && "
        for (key, value) in extra_env:
            cmd = cmd + "set \"" + key + "=" + value + "\" && "
        cmd = cmd + "set \"SIMPLE_LIB=" + lib + "\" && " + program + " run " + joined
        (sh, ["/d", "/c", cmd])
    else:
        var prefix = ""
        if work_dir != "":
            prefix = prefix + "cd \"" + work_dir + "\" && "
        for (key, value) in extra_env:
            prefix = prefix + key + "=\"" + value + "\" "
        ("/bin/sh", ["-c", prefix + "SIMPLE_LIB=\"" + lib + "\" \"" + program + "\" run " + joined])
    process_run_bounded(shell, shell_args, CLI_RUN_TIMEOUT_MS, CLI_RUN_MAX_OUT)

val FIXTURE_DIR = get_temp_dir().replace("\\", "/") + "/simple_pkg_log_mode_fixture"

fn _setup_fixture():
    val _removed = dir_remove_all(FIXTURE_DIR)
    if not dir_create_all(FIXTURE_DIR):
        fail("could not create fixture dir " + FIXTURE_DIR)

fn _run_pkg(args: [text]) -> (text, text, i64):
    _spawn_cli(["src/app/pkg/main.spl"] + args, FIXTURE_DIR, [])

describe "pkg log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-PKG-LOGMODE-001
        # @capture(tui_grid): pkg help text listing the shared log options
        step("Run pkg --help in the fixture directory")
        _setup_fixture()
        val (out, err, code) = _run_pkg(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports init log-mode json":
        # @req REQ-PKG-LOGMODE-001
        # @capture(protocol_json): pkg init JSON transcript naming the created package
        step("Initialize a package with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_pkg(["init", "sample-pkg", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed init
        expect(out).to_contain("\"command\":\"pkg init\"")
        expect(out).to_contain("\"name\":\"sample-pkg\"")

    it "supports install dry-run log-mode json":
        # @req REQ-PKG-LOGMODE-001
        # @capture(protocol_json): pkg install dry-run JSON transcript with the empty total
        step("Initialize the package, then dry-run its install with log-mode json")
        _setup_fixture()
        val (_init_out, _init_err, _init_code) = _run_pkg(["init", "sample-pkg"])
        val (out, err, code) = _run_pkg(["install", "--dry-run", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed dry-run
        expect(out).to_contain("\"command\":\"pkg install\"")
        expect(out).to_contain("\"dry_run\":true")
        expect(out).to_contain("\"total\":0")

    it "supports dot progress":
        # @req REQ-PKG-LOGMODE-001
        # @capture(tui_grid): dot-progress output followed by the package-created line
        step("Initialize a package with dot progress")
        _setup_fixture()
        val (out, err, code) = _run_pkg(["init", "sample-pkg", "--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed init
        expect(out).to_start_with(".")
        expect(out).to_contain("Created package.sdn for 'sample-pkg'")

    it "rejects invalid log mode":
        # @req REQ-PKG-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke pkg with an unknown log mode and expect a usage error")
        _setup_fixture()
        val (out, err, code) = _run_pkg(["init", "sample-pkg", "--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
