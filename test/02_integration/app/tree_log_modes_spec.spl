"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the tree command (--log-mode
and --progress) as observed through real process invocations against a
fixture working directory.
Audience: compiler and tooling engineers who maintain the tree app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/tree_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the tree command's shared log options only; each scenario spawns real
`bin/simple` processes and builds its fixture under /tmp with a simple.sdn
declaring two dependencies and one dev dependency.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: tree-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_tree_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + " && cat > " + FIXTURE_DIR + "/simple.sdn <<'EOF'\nname: tree-fixture\nversion: 2.3.4\ndependencies:\n  alpha: \"*\"\n  beta: \"*\"\ndev_dependencies:\n  gamma: \"*\"\nEOF"
    ])

fn _run_tree(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/tree/main.spl\" " + joined
    ])

describe "tree log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-TREE-LOGMODE-001
        # @capture(tui_grid): tree help text listing the shared log options
        step("Run tree --help in the fixture directory")
        _setup_fixture()
        val (out, err, code) = _run_tree(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json":
        # @req REQ-TREE-LOGMODE-001
        # @capture(protocol_json): dependency tree JSON transcript read from the fixture manifest
        step("Print the fixture dependency tree with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_tree(["--dev", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed tree walk
        expect(out).to_contain("\"name\":\"tree-fixture\"")
        expect(out).to_contain("\"dependencies\":[\"alpha\",\"beta\"]")
        expect(out).to_contain("\"dev_dependencies\":[\"gamma\"]")

    it "supports dot progress":
        # @req REQ-TREE-LOGMODE-001
        # @capture(tui_grid): dot-progress output followed by the package identity line
        step("Walk the fixture dependency tree with dot progress")
        _setup_fixture()
        val (out, err, code) = _run_tree(["--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed tree walk
        expect(out).to_start_with(".")
        expect(out).to_contain("tree-fixture v2.3.4")

    it "rejects invalid log mode":
        # @req REQ-TREE-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke tree with an unknown log mode and expect a usage error")
        _setup_fixture()
        val (out, err, code) = _run_tree(["--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
