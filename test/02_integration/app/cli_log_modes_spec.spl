"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the top-level cli app
(--log-mode and --progress) and its delegation of check presentation options,
as observed through real process invocations.
Audience: compiler and tooling engineers who maintain the cli app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/cli_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the cli app's shared log options and check delegation only; each
scenario spawns real `bin/simple` processes.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: cli-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn _run_cli(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/cli/main.spl\" " + joined
    ])

describe "cli log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-CLI-LOGMODE-001
        # @capture(tui_grid): cli help text listing the shared log options
        step("Verify: shows shared log options in help")
        val (out, err, code) = _run_cli(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("Simple Language")
        expect(out).to_contain("Shared log options")
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json ready output":
        # @req REQ-CLI-LOGMODE-001
        # @capture(protocol_json): stdout JSON ready receipt of the cli app
        step("Verify: supports log-mode json ready output")
        val (out, err, code) = _run_cli(["--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for the ready state
        expect(out).to_contain("\"command\":\"cli\"")
        expect(out).to_contain("\"status\":\"ready\"")

    it "supports log-mode json version output":
        # @req REQ-CLI-LOGMODE-001
        # @capture(protocol_json): stdout JSON version receipt of the cli app
        step("Verify: supports log-mode json version output")
        val (out, err, code) = _run_cli(["--log-mode=json", "--version"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --version
        expect(out).to_contain("\"command\":\"cli\"")
        expect(out).to_contain("\"status\":\"ok\"")
        expect(out).to_contain("\"version\":\"")

    it "supports dot progress for help output":
        # @req REQ-CLI-LOGMODE-001
        # @capture(tui_grid): dot-progress prefixed help output of the cli app
        step("Verify: supports dot progress for help output")
        val (out, err, code) = _run_cli(["--progress=dot", "--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain(".\nSimple Language")

    it "rejects invalid log mode":
        # @req REQ-CLI-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Verify: rejects invalid log mode")
        val (out, err, code) = _run_cli(["--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode

    it "preserves check presentation options through delegation":
        # @req REQ-CLI-LOGMODE-001
        # @capture(tui_grid): echoed delegate command proving option passthrough
        step("Verify: preserves check presentation options through delegation")
        val (out, err, code) = _run_cli_with_echo_delegate(["check", "--json", "--progress=count", "a.spl", "b.spl"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for the delegated check
        expect(out).to_contain("check a.spl b.spl --json --progress=count")

    it "rejects split check surface before delegation":
        # @req REQ-CLI-LOGMODE-001
        # @capture(tui_grid): usage-error output for an invalid check surface
        step("Verify: rejects split check surface before delegation")
        val (out, err, code) = _run_cli_with_echo_delegate(["check", "--surface", "tui", "a.spl"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI validation-failure exit code for an invalid surface
        expect(out).to_contain("invalid --surface")
        expect(out.contains("check a.spl")).to_equal(false)
