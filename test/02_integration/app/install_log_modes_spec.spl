"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the install command
(--log-mode and --progress) as observed through real process invocations
against a fixture working directory.
Audience: compiler and tooling engineers who maintain the install app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/install_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the install command's shared log options only; each scenario spawns
real `bin/simple` processes and builds its fixture under /tmp with a
simple.sdn declaring two dependencies and one dev dependency.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: install-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_install_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + " && cat > " + FIXTURE_DIR + "/simple.sdn <<'EOF'\nname: install-fixture\nversion: 5.6.7\ndependencies:\n  alpha: \"*\"\n  beta: \"*\"\ndev_dependencies:\n  gamma: \"*\"\nEOF"
    ])

fn _run_install(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/install/main.spl\" " + joined
    ])

describe "install log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-INSTALL-LOGMODE-001
        # @capture(tui_grid): install help text listing the shared log options
        step("Run install --help in the fixture directory")
        _setup_fixture()
        val (out, err, code) = _run_install(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports dry-run log-mode json":
        # @req REQ-INSTALL-LOGMODE-001
        # @capture(protocol_json): dry-run JSON transcript listing the dependency set
        step("Run a dry-run install with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_install(["--dry-run", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed dry-run
        expect(out).to_contain("\"dry_run\":true")
        expect(out).to_contain("\"dependencies\":[\"alpha\",\"beta\",\"gamma\"]")

    it "supports dot progress":
        # @req REQ-INSTALL-LOGMODE-001
        # @capture(tui_grid): dot-progress output followed by the would-install summary
        step("Run a dry-run install with dot progress")
        _setup_fixture()
        val (out, err, code) = _run_install(["--dry-run", "--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed dry-run
        expect(out).to_start_with(".")
        expect(out).to_contain("Would install 3 dependencies")

    it "rejects invalid log mode":
        # @req REQ-INSTALL-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke install with an unknown log mode and expect a usage error")
        _setup_fixture()
        val (out, err, code) = _run_install(["--dry-run", "--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
