"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the task-gen app (--log-mode
and --progress) as observed through real process invocations against a
fixture task database with two tasks.
Audience: compiler and tooling engineers who maintain the task-gen app and
the shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/task_gen_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the task-gen app's shared log options only; each scenario spawns real
`bin/simple` processes and rebuilds the fixture task database under /tmp.
## Verification guidance and troubleshooting
A failure names the exact option, mode, or JSON field that regressed;
re-run this spec and compare the captured stdout in the failing scenario to
reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: task-gen-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_task_gen_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + "/doc/08_tracking/task && cat > " + FIXTURE_DIR + "/doc/08_tracking/task/task_db.sdn <<'EOF'\ntasks |\nTASK-001,core,Sample task,Do the thing,high,complete,true\nTASK-002,core,Next task,Do another thing,low,planned,true\nEOF"
    ])

fn _run_task_gen(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/task_gen/main.spl\" " + joined
    ])

describe "task-gen log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-TASK-GEN-LOGMODE-001
        # @capture(tui_grid): task-gen help text listing the shared log options
        step("Verify: shows shared log options in help")
        _setup_fixture()
        val (out, err, code) = _run_task_gen(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json":
        # @req REQ-TASK-GEN-LOGMODE-001
        # @capture(protocol_json): stdout JSON generation report with the task count
        step("Verify: supports log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_task_gen(["--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed generation
        expect(out).to_contain("\"command\":\"task-gen\"")
        expect(out).to_contain("\"status\":\"ok\"")
        expect(out).to_contain("\"tasks\":2")

    it "supports dot progress":
        # @req REQ-TASK-GEN-LOGMODE-001
        # @capture(tui_grid): dot-progress output naming the generated task doc
        step("Verify: supports dot progress")
        _setup_fixture()
        val (out, err, code) = _run_task_gen(["--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed generation
        expect(out).to_contain(".")
        expect(out).to_contain("Generated doc/08_tracking/task/task.md")

    it "rejects invalid log mode":
        # @req REQ-TASK-GEN-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Verify: rejects invalid log mode")
        _setup_fixture()
        val (out, err, code) = _run_task_gen(["--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
