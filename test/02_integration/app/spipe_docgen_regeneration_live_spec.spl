# @req REQ-SPIPE-DOCGEN-001
"""
# spipe_docgen live regeneration determinism

**Category:** Tooling
**Status:** Implemented

## Purpose and Audience

Proves the REAL, LIVE `generate_feature_doc` entry point in
`src/app/spipe_docgen/spipe_docgen/generator.spl` (exported via
`spipe_docgen/__init__.spl`) is byte-identical across two invocations given
the same spec + evidence sidecar, and that the sidecar's presence/absence
changes/preserves output exactly as the evidence_loader.spl module docstring
promises: "specs with no typed evidence are completely unaffected."

## Primary Workflow

Build a tiny real spec file plus a real `.evidence.sdn` sidecar (the exact
line-based format documented in evidence_loader.spl), call
`parse_spipe_file` + `generate_feature_doc` twice with identical inputs, and
sha256-compare the two rendered manuals. Then remove the sidecar and prove
the no-sidecar manual is unaffected across two more runs.
"""

use std.spec.*
use app.spipe_docgen.spipe_docgen.*
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.file_ops.{file_delete}

val work_dir = "/tmp/claude-1000/-home-ormastes-dev-pub-simple/93f9b900-8e65-4a83-b9d7-c9a85fbe5ecf/scratchpad/spipe_docgen_regen_live"
val spec_path = "{work_dir}/tiny_feature_spec.spl"
val sidecar_path = "{spec_path}.evidence.sdn"
val out_dir_a = "{work_dir}/out_a"
val out_dir_b = "{work_dir}/out_b"
val out_dir_c = "{work_dir}/out_c"
val out_dir_d = "{work_dir}/out_d"

fn tiny_spec_content() -> text:
    "# Tiny Feature\n" +
    "# **Category:** Tooling\n" +
    "# **Status:** Implemented\n" +
    "\n" +
    "use std.spec.*\n" +
    "\n" +
    "describe \"Tiny Feature\":\n" +
    "    it \"does the thing\":\n" +
    "        expect(1 + 1).to_equal(2)\n"

fn sidecar_content() -> text:
    "schema=simple.sspec.evidence.v1\n" +
    "evidence_id=demo-live-1\n" +
    "profile_id=demo-live\n" +
    "spec_path={spec_path}\n" +
    "spec_sha256=1111111111111111111111111111111111111111111111111111111111111111\n" +
    "provider_id=demo-provider\n" +
    "provider_version=1.0.0\n" +
    "run_id=run-1\n" +
    "environment=ci\n" +
    "artifact_sha256=2222222222222222222222222222222222222222222222222222222222222222\n" +
    "status=passed\n" +
    "---\n" +
    "kind=paragraph\n" +
    "title=Observed Output\n" +
    "audience=qa\n" +
    "line=LIVE_REGEN_EVIDENCE_MARKER hello world\n"

fn setup_dirs():
    native_fs_create_dir(work_dir)
    native_fs_create_dir(out_dir_a)
    native_fs_create_dir(out_dir_b)
    native_fs_create_dir(out_dir_c)
    native_fs_create_dir(out_dir_d)

fn generate_into(output_dir: text) -> text:
    val parsed = match parse_spipe_file(spec_path):
        case Ok(doc): doc
        case Err(e): fail("parse_spipe_file failed: {e}")
    val metadata = extract_metadata(parsed)
    val doc_with_meta = SspecDoc(
        file_path: parsed.file_path,
        raw_content: parsed.raw_content,
        doc_blocks: parsed.doc_blocks,
        feature_title: parsed.feature_title,
        feature_ids: parsed.feature_ids,
        metadata: metadata
    )
    val gen_result = generate_feature_doc(doc_with_meta, output_dir)
    val written_path = match gen_result:
        case Ok(p): p
        case Err(e): fail("generate_feature_doc failed: {e}")
    native_fs_read_string(written_path)

describe "spipe_docgen live regeneration determinism":
    # @inline
    it "sets up a real spec file and evidence sidecar":
        # @req: REQ-SPIPE-DOCGEN-001
        step("Write a tiny real spec file")
        setup_dirs()
        native_fs_write_string(spec_path, tiny_spec_content())
        expect(native_fs_exists(spec_path)).to_equal(true)

        step("Write a real evidence sidecar at evidence_sidecar_path(spec)")
        expect(sidecar_path).to_equal(evidence_sidecar_path(spec_path))
        native_fs_write_string(sidecar_path, sidecar_content())
        expect(native_fs_exists(sidecar_path)).to_equal(true)

    # @prev("sets up a real spec file and evidence sidecar")
    # @capture
    it "renders byte-identical output across two live invocations with the sidecar present":
        step("Generate the manual twice via the real generate_feature_doc entry point")
        val output_a = generate_into(out_dir_a)
        val output_b = generate_into(out_dir_b)

        step("Compare the two renders by sha256 digest")
        val digest_a = sha256_text(output_a)
        val digest_b = sha256_text(output_b)
        expect(digest_a).to_equal(digest_b)
        expect(output_a).to_equal(output_b)

    # @prev("renders byte-identical output across two live invocations with the sidecar present")
    it "includes the evidence sidecar content when present":
        step("Read back the first rendered manual")
        val output_a = generate_into(out_dir_a)
        step("Verify the evidence marker line is present")
        expect(output_a.contains("LIVE_REGEN_EVIDENCE_MARKER hello world")).to_equal(true)

    # @prev("includes the evidence sidecar content when present")
    it "is unaffected by sidecar absence, byte-for-byte across two runs":
        step("Remove the sidecar so the spec has no typed evidence")
        val removed = file_delete(sidecar_path)
        expect(removed).to_equal(true)
        expect(native_fs_exists(sidecar_path)).to_equal(false)

        step("Generate the manual twice with the sidecar absent")
        val output_c = generate_into(out_dir_c)
        val output_d = generate_into(out_dir_d)

        step("Compare the two no-sidecar renders by sha256 digest")
        expect(sha256_text(output_c)).to_equal(sha256_text(output_d))
        expect(output_c).to_equal(output_d)

        step("Verify the no-sidecar manual does not contain the evidence marker")
        expect(output_c.contains("LIVE_REGEN_EVIDENCE_MARKER")).to_equal(false)
