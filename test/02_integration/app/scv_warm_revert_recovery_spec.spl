"""Warm source authority recovers a tracked source restored to HEAD."""
use std.spec.*
use test.fixtures.scv_warm_revert_native_probe.{scv_warm_revert_fixture}

describe "SCV warm authority after a tracked revert":
    it "rebuilds once after drift and admits the restored source bytes":
        step("publish a modified tracked source in an isolated Git checkout")
        step("restore the committed bytes without an event and acquire warm authority")
        expect(scv_warm_revert_fixture()).to_equal("")
