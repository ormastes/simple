# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: This spec proves the SCV append-only operation/event journal + WAL
(MIG-10, v2 final report §16.1, stabilization §7): every repo mutation appends
one line-framed event record to `.scv/journal/events.log`; the mutable
head/meta publication is bracketed by `BEGIN op=`/`COMMIT op=` in
`.scv/journal/wal.log`; a pending record without an exact operation binding
remains untouched and makes recovery fail closed.
Audience: Maintainers of the SCV storage layer.
"""
# @req: REQ-SSPEC-INTEGRATION
use std.spec.step

use std.spec.{describe, it, expect, step, assert_false}
use app.io.mod (process_run)


fn _harness() -> [text]:
    [
        "set -eu",
        "REPO=$(pwd)",
        "TMP=$(mktemp -d /tmp/scv-journal.XXXXXX)",
        "scv() { SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" \"$@\"; }",
        "cd \"$TMP\"",
        "printf 'base\\n' > a.txt",
        "scv init >/dev/null",
        "scv snapshot >/dev/null"
    ]

fn _run(lines: [text]) -> text:
    val (out, err, code) = process_run("/bin/sh", ["-c", lines.join("\n") + "\n"])
    val combined = "{out}{err}\nexit={code}\n"
    assert_false(out == "" and err == "")
    combined

describe "scv journal and WAL":
    # @manual scenario evidence
    it "appends one framed event record per snapshot mutation":
        # @req REQ-SSPEC-INTEGRATION
        step("appends one framed event record per snapshot mutation")
        step("Snapshot twice and inspect the append-only event journal")
        var lines = _harness()
        lines.push("printf 'two\\n' > a.txt")
        lines.push("scv snapshot >/dev/null")
        lines.push("printf 'events=%s\\n' \"$(grep -c '^op=' .scv/journal/events.log)\"")
        lines.push("grep -Ec '^op=op_[0-9a-f]+ kind=snapshot refs=commit_[0-9a-f]+ sha=tree_[0-9a-f]+ utc=[0-9]+$' .scv/journal/events.log")
        val out = _run(lines)
        expect(out).to_contain("events=2")
        expect(out).to_contain("exit=0")

    it "brackets every head publication in a committed WAL transaction":
        # @req REQ-SSPEC-INTEGRATION
        step("brackets every head publication in a committed WAL transaction")
        step("Verify BEGIN/SET/NEW/COMMIT framing for the snapshot's WAL entry")
        var lines = _harness()
        lines.push("grep -c '^BEGIN op=' .scv/journal/wal.log")
        lines.push("grep -c '^SET path=HEAD_OP old=' .scv/journal/wal.log")
        lines.push("grep -c '^SET path=meta/workspaces.sdn old=' .scv/journal/wal.log")
        lines.push("grep -c '^COMMIT op=' .scv/journal/wal.log")
        lines.push("printf 'framed=ok\\n'")
        val out = _run(lines)
        expect(out).to_contain("framed=ok")
        expect(out).to_contain("exit=0")

    it "preserves an incomplete WAL when publication ownership is unresolved":
        # @req REQ-SSPEC-INTEGRATION
        step("preserves an incomplete WAL when publication ownership is unresolved")
        step("Inject SCV_FAULT_AFTER=wal, then verify doctor preserves all mutable state")
        var lines = _harness()
        lines.push("OLD_OP=$(cat .scv/HEAD_OP)")
        lines.push("OLD_COMMIT=$(sed -n 's/default: //p' .scv/meta/workspaces.sdn)")
        lines.push("printf 'edited\\n' > a.txt")
        lines.push("set +e")
        lines.push("SCV_FAULT_AFTER=wal scv snapshot >/dev/null 2>&1")
        lines.push("printf 'fault_code=%s\\n' \"$?\"")
        lines.push("set -e")
        lines.push("WAL_BEFORE=$(sha256sum .scv/journal/wal.log | cut -d' ' -f1)")
        lines.push("WS_BEFORE=$(sha256sum .scv/meta/workspaces.sdn | cut -d' ' -f1)")
        lines.push("set +e")
        lines.push("scv doctor")
        lines.push("DOCTOR_CODE=$?")
        lines.push("set -e")
        lines.push("printf 'doctor_code=%s\\n' \"$DOCTOR_CODE\"")
        lines.push("NEW_OP=$(cat .scv/HEAD_OP)")
        lines.push("NEW_COMMIT=$(sed -n 's/default: //p' .scv/meta/workspaces.sdn)")
        lines.push("WAL_AFTER=$(sha256sum .scv/journal/wal.log | cut -d' ' -f1)")
        lines.push("WS_AFTER=$(sha256sum .scv/meta/workspaces.sdn | cut -d' ' -f1)")
        lines.push("test \"$NEW_OP\" = \"$OLD_OP\" && test \"$NEW_COMMIT\" = \"$OLD_COMMIT\" && test \"$WAL_AFTER\" = \"$WAL_BEFORE\" && test \"$WS_AFTER\" = \"$WS_BEFORE\" && test \"$(cat a.txt)\" = edited && printf 'state=pending-preserved\\n'")
        lines.push("grep -q '^BEGIN op=' .scv/journal/wal.log && ! grep -q '^ABORT op=' .scv/journal/wal.log && printf 'wal=pending\\n'")
        val out = _run(lines)
        expect(out).to_contain("fault_code=3")
        expect(out).to_contain("ERROR unresolved WAL")
        expect(out).to_contain("doctor_code=1")
        expect(out).to_contain("state=pending-preserved")
        expect(out).to_contain("wal=pending")
        expect(out).to_contain("exit=0")

    it "fails closed when a published head has no exact WAL candidate binding":
        # @req REQ-SSPEC-INTEGRATION
        step("fails closed when a published head has no exact WAL candidate binding")
        step("Inject a crash after HEAD_OP, then verify doctor preserves pending state")
        var lines = _harness()
        lines.push("OLD_OP=$(cat .scv/HEAD_OP)")
        lines.push("OLD_COMMIT=$(sed -n 's/default: //p' .scv/meta/workspaces.sdn)")
        lines.push("printf 'edited\\n' > a.txt")
        lines.push("set +e")
        lines.push("SCV_FAULT_AFTER=head scv snapshot >/dev/null 2>&1")
        lines.push("printf 'fault_code=%s\\n' \"$?\"")
        lines.push("set -e")
        lines.push("HEAD_BEFORE=$(cat .scv/HEAD_OP)")
        lines.push("WAL_BEFORE=$(sha256sum .scv/journal/wal.log | cut -d' ' -f1)")
        lines.push("WS_BEFORE=$(sha256sum .scv/meta/workspaces.sdn | cut -d' ' -f1)")
        lines.push("set +e")
        lines.push("scv doctor")
        lines.push("DOCTOR_CODE=$?")
        lines.push("set -e")
        lines.push("printf 'doctor_code=%s\\n' \"$DOCTOR_CODE\"")
        lines.push("NEW_OP=$(cat .scv/HEAD_OP)")
        lines.push("NEW_COMMIT=$(sed -n 's/default: //p' .scv/meta/workspaces.sdn)")
        lines.push("WAL_AFTER=$(sha256sum .scv/journal/wal.log | cut -d' ' -f1)")
        lines.push("WS_AFTER=$(sha256sum .scv/meta/workspaces.sdn | cut -d' ' -f1)")
        lines.push("test \"$NEW_OP\" = \"$HEAD_BEFORE\" && test \"$WAL_AFTER\" = \"$WAL_BEFORE\" && test \"$WS_AFTER\" = \"$WS_BEFORE\" && printf 'state=pending-preserved\\n'")
        lines.push("grep -q '^BEGIN op=' .scv/journal/wal.log && ! grep -q 'recovered=forward' .scv/journal/wal.log && printf 'wal=pending\\n'")
        val out = _run(lines)
        expect(out).to_contain("fault_code=3")
        expect(out).to_contain("ERROR")
        expect(out).to_contain("doctor_code=1")
        expect(out).to_contain("state=pending-preserved")
        expect(out).to_contain("wal=pending")
        expect(out).to_contain("exit=0")

    it "preserves a foreign HEAD and pending WAL when recovery is ambiguous":
        # @req REQ-SSPEC-INTEGRATION
        step("preserves a foreign HEAD and pending WAL when recovery is ambiguous")
        step("Open a WAL, replace HEAD_OP with a foreign value, then run doctor")
        var lines = _harness()
        lines.push("set +e")
        lines.push("SCV_FAULT_AFTER=wal scv snapshot >/dev/null 2>&1")
        lines.push("printf 'fault_code=%s\\n' \"$?\"")
        lines.push("set -e")
        lines.push("printf 'foreign-operation\\n' > .scv/HEAD_OP")
        lines.push("PENDING_OP=$(sed -n 's/^BEGIN op=\\([^ ]*\\).*/\\1/p' .scv/journal/wal.log | tail -1)")
        lines.push("HEAD_BEFORE=$(sha256sum .scv/HEAD_OP | cut -d' ' -f1)")
        lines.push("WAL_BEFORE=$(sha256sum .scv/journal/wal.log | cut -d' ' -f1)")
        lines.push("WS_BEFORE=$(sha256sum .scv/meta/workspaces.sdn | cut -d' ' -f1)")
        lines.push("set +e")
        lines.push("scv doctor")
        lines.push("DOCTOR_CODE=$?")
        lines.push("set -e")
        lines.push("printf 'doctor_code=%s\\n' \"$DOCTOR_CODE\"")
        lines.push("HEAD_AFTER=$(sha256sum .scv/HEAD_OP | cut -d' ' -f1)")
        lines.push("WAL_AFTER=$(sha256sum .scv/journal/wal.log | cut -d' ' -f1)")
        lines.push("WS_AFTER=$(sha256sum .scv/meta/workspaces.sdn | cut -d' ' -f1)")
        lines.push("test \"$HEAD_AFTER\" = \"$HEAD_BEFORE\" && test \"$WAL_AFTER\" = \"$WAL_BEFORE\" && test \"$WS_AFTER\" = \"$WS_BEFORE\" && printf 'state=foreign-preserved\\n'")
        lines.push("grep -q \"^BEGIN op=$PENDING_OP \" .scv/journal/wal.log && ! grep -Eq \"^(COMMIT|ABORT) op=$PENDING_OP( |$)\" .scv/journal/wal.log && printf 'wal=pending\\n'")
        val out = _run(lines)
        expect(out).to_contain("fault_code=3")
        expect(out).to_contain("ERROR")
        expect(out).to_contain("doctor_code=1")
        expect(out).to_contain("state=foreign-preserved")
        expect(out).to_contain("wal=pending")
        expect(out).to_contain("exit=0")

    it "rejects malformed WAL framing without clearing or masking a pending operation":
        # @req REQ-SSPEC-INTEGRATION
        step("rejects malformed WAL framing without clearing or masking a pending operation")
        step("Check nested BEGIN, truncated BEGIN, and unmatched terminal records")
        var lines = _harness()
        lines.push("printf 'BEGIN op=outer utc=1\\nBEGIN op=inner utc=2\\n' > .scv/journal/wal.log")
        lines.push("set +e")
        lines.push("scv doctor")
        lines.push("NESTED_CODE=$?")
        lines.push("set -e")
        lines.push("printf 'nested_code=%s\\n' \"$NESTED_CODE\"")
        lines.push("printf 'BEGIN op=truncated utc=1\\n' > .scv/journal/wal.log")
        lines.push("set +e")
        lines.push("scv doctor")
        lines.push("TRUNCATED_CODE=$?")
        lines.push("set -e")
        lines.push("printf 'truncated_code=%s\\n' \"$TRUNCATED_CODE\"")
        lines.push("printf 'COMMIT op=missing\\n' > .scv/journal/wal.log")
        lines.push("set +e")
        lines.push("scv doctor")
        lines.push("TERMINAL_CODE=$?")
        lines.push("set -e")
        lines.push("printf 'terminal_code=%s\\n' \"$TERMINAL_CODE\"")
        lines.push("printf 'BEGIN op=extra-field utc=1 unexpected=value\\n' > .scv/journal/wal.log")
        lines.push("set +e")
        lines.push("scv doctor")
        lines.push("EXTRA_FIELD_CODE=$?")
        lines.push("set -e")
        lines.push("printf 'extra_field_code=%s\\n' \"$EXTRA_FIELD_CODE\"")
        lines.push("printf 'BEGIN op=duplicate-key utc=1 op=shadow\\n' > .scv/journal/wal.log")
        lines.push("set +e")
        lines.push("scv doctor")
        lines.push("DUPLICATE_KEY_CODE=$?")
        lines.push("set -e")
        lines.push("printf 'duplicate_key_code=%s\\n' \"$DUPLICATE_KEY_CODE\"")
        lines.push("printf 'BEGIN op=unknown-path utc=1\\nSET path=unexpected old=value\\n' > .scv/journal/wal.log")
        lines.push("set +e")
        lines.push("scv doctor")
        lines.push("PATH_CODE=$?")
        lines.push("set -e")
        lines.push("printf 'path_code=%s\\n' \"$PATH_CODE\"")
        lines.push("printf 'BEGIN op=early-terminal utc=1\\nCOMMIT op=early-terminal\\n' > .scv/journal/wal.log")
        lines.push("set +e")
        lines.push("scv doctor")
        lines.push("INCOMPLETE_TERMINAL_CODE=$?")
        lines.push("set -e")
        lines.push("printf 'incomplete_terminal_code=%s\\n' \"$INCOMPLETE_TERMINAL_CODE\"")
        lines.push("test \"$NESTED_CODE\" = 1 && test \"$TRUNCATED_CODE\" = 1 && test \"$TERMINAL_CODE\" = 1 && test \"$EXTRA_FIELD_CODE\" = 1 && test \"$DUPLICATE_KEY_CODE\" = 1 && test \"$PATH_CODE\" = 1 && test \"$INCOMPLETE_TERMINAL_CODE\" = 1 && grep -q '^COMMIT op=early-terminal$' .scv/journal/wal.log && printf 'wal=malformed-preserved\\n'")
        val out = _run(lines)
        expect(out).to_contain("ERROR malformed WAL: nested BEGIN")
        expect(out).to_contain("ERROR unresolved WAL: incomplete recovery record")
        expect(out).to_contain("ERROR malformed WAL: unmatched transaction terminator")
        expect(out).to_contain("ERROR malformed WAL: invalid BEGIN fields")
        expect(out).to_contain("ERROR malformed WAL: unknown SET path")
        expect(out).to_contain("ERROR malformed WAL: terminal record follows incomplete transaction")
        expect(out).to_contain("wal=malformed-preserved")
        expect(out).to_contain("exit=0")

    it "rejects an unsafe WAL entry instead of treating it as absent":
        # @req REQ-SSPEC-INTEGRATION
        step("rejects an unsafe WAL entry instead of treating it as absent")
        step("Replace the WAL file with a dangling symlink and verify doctor fails")
        var lines = _harness()
        lines.push("rm .scv/journal/wal.log")
        lines.push("ln -s missing-wal-target .scv/journal/wal.log")
        lines.push("set +e")
        lines.push("scv doctor")
        lines.push("DOCTOR_CODE=$?")
        lines.push("set -e")
        lines.push("printf 'doctor_code=%s\\n' \"$DOCTOR_CODE\"")
        lines.push("test -L .scv/journal/wal.log && printf 'wal=unsafe-preserved\\n'")
        val out = _run(lines)
        expect(out).to_contain("ERROR cannot read WAL")
        expect(out).to_contain("doctor_code=1")
        expect(out).to_contain("wal=unsafe-preserved")
        expect(out).to_contain("exit=0")

    it "level 1 refuses to rebuild while WAL recovery is unresolved":
        # @req REQ-SSPEC-INTEGRATION
        step("level 1 refuses to rebuild while WAL recovery is unresolved")
        step("Create an ambiguous pending WAL and verify level 1 leaves derived state untouched")
        var lines = _harness()
        lines.push("set +e")
        lines.push("SCV_FAULT_AFTER=wal scv snapshot >/dev/null 2>&1")
        lines.push("printf 'fault_code=%s\\n' \"$?\"")
        lines.push("set -e")
        lines.push("printf 'foreign-operation\\n' > .scv/HEAD_OP")
        lines.push("DB_BEFORE=$(sha256sum .scv/meta/workspaces.sdn | cut -d' ' -f1)")
        lines.push("INDEX_BEFORE=$(sha256sum .scv/meta/status_index.sdn | cut -d' ' -f1)")
        lines.push("WAL_BEFORE=$(sha256sum .scv/journal/wal.log | cut -d' ' -f1)")
        lines.push("set +e")
        lines.push("scv recover --level 1")
        lines.push("RECOVER_CODE=$?")
        lines.push("set -e")
        lines.push("printf 'recover_code=%s\\n' \"$RECOVER_CODE\"")
        lines.push("set +e")
        lines.push("scv rebuild-db")
        lines.push("REBUILD_CODE=$?")
        lines.push("set -e")
        lines.push("printf 'rebuild_code=%s\\n' \"$REBUILD_CODE\"")
        lines.push("DB_AFTER=$(sha256sum .scv/meta/workspaces.sdn | cut -d' ' -f1)")
        lines.push("INDEX_AFTER=$(sha256sum .scv/meta/status_index.sdn | cut -d' ' -f1)")
        lines.push("WAL_AFTER=$(sha256sum .scv/journal/wal.log | cut -d' ' -f1)")
        lines.push("test \"$DB_AFTER\" = \"$DB_BEFORE\" && test \"$INDEX_AFTER\" = \"$INDEX_BEFORE\" && test \"$WAL_AFTER\" = \"$WAL_BEFORE\" && grep -q '^BEGIN op=' .scv/journal/wal.log && printf 'state=preserved\\n'")
        val out = _run(lines)
        expect(out).to_contain("fault_code=3")
        expect(out).to_contain("ERROR")
        expect(out).to_contain("recover_code=1")
        expect(out).to_contain("rebuild_code=1")
        expect(out).to_contain("state=preserved")
        expect(out).to_contain("exit=0")
