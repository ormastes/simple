# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""

## Operator workflow
## Compatibility and limitations

## Purpose and audience
Purpose: shows shared log options in help
Audience: compiler and tooling engineers who maintain this spec
"""
# @manual: primary
# doc-path: doc/01_research/local/spec_to_spipe_toolchain.md
# doc-path: doc/03_plan/sys_test/spec_to_spipe.md
# doc-path: doc/04_architecture/app/spec_to_spipe.md
# doc-path: doc/05_design/app/spec_to_spipe_ir.md

# @req: REQ-APP-SpecCoveLogMode-001

use std.spec.{describe, it, expect, skip}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.env.platform.{is_windows, get_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all}
use std.nogc_sync_mut.io.file_ops.{file_create_exclusive, file_exists}
use std.env.variables.{env_get}
use std.nogc_sync_mut.io.env_ops.{cwd}

val CLI_RUN_TIMEOUT_MS: i64 = 120000
val CLI_RUN_MAX_OUT: i64 = 16777216

fn _cli_repo_root() -> text:
    cwd().replace("\\", "/")

# This spec pins the compiler_rust seed binary's spec-coverage subcommand. The seed
# debug build is a qualification-environment artifact: where it is not
# built, every scenario below is reported as an honest skip instead of a
# failure, mirroring the compiled-binary handling of
# simple_lsp_mcp_log_modes_spec.spl.
val SEED_CLI = _cli_repo_root() + "/src/compiler_rust/target/debug/simple" + (if is_windows(): ".exe" else: "")

fn _seed_it(name: text, block: fn()):
    if file_exists(SEED_CLI):
        it(name, block)
    else:
        skip(name, "compiler_rust seed debug binary is not built on this host")

val FIXTURE_DIR = get_temp_dir().replace("\\", "/") + "/simple_spec_coverage_log_mode_fixture"

fn _setup_empty_fixture():
    val _removed = dir_remove_all(FIXTURE_DIR)
    if not dir_create_all(FIXTURE_DIR):
        fail("could not create fixture dir " + FIXTURE_DIR)
fn _setup_feature_fixture():
    val _removed = dir_remove_all(FIXTURE_DIR)
    if not dir_create_all(FIXTURE_DIR + "/doc/08_tracking/feature"):
        fail("could not create fixture dir " + FIXTURE_DIR + "/doc/08_tracking/feature")
    if not file_create_exclusive(FIXTURE_DIR + "/doc/08_tracking/feature/feature_db.sdn", "features |id, group, device, component, title, description, status, priority, source_file, requirement, research, plan, architecture, design, system_spec, spec_doc, implementation, unit_tests, integration_tests, guide, external_system, external_id, external_url, last_synced_at, created_at, updated_at, valid|\n    REQ-001,core,core,core,\"Sample feature\",\"Does work\",done,P1,,,,,,,,,,,,,,,,,2026-06-04,2026-06-04,true\n    REQ-002,core,core,core,\"Planned feature\",\"Does later\",request,P2,,,,,,,,,,,,,,,,,2026-06-04,2026-06-04,true\n"):
        fail("could not write fixture file " + FIXTURE_DIR + "/doc/08_tracking/feature/feature_db.sdn")

fn _run_seed(subcommand: text, args: [text]) -> (text, text, i64):
    val seed = SEED_CLI
    val joined = ([subcommand] + args).join(" ")
    val (shell, shell_args) = if is_windows():
        val sh = env_get("ComSpec") ?? "cmd.exe"
        (sh, ["/d", "/c", "cd /d " + FIXTURE_DIR + " && " + seed + " " + joined])
    else:
        ("/bin/sh", ["-c", "cd \"" + FIXTURE_DIR + "\" && \"" + seed + "\" " + joined])
    process_run_bounded(shell, shell_args, CLI_RUN_TIMEOUT_MS, CLI_RUN_MAX_OUT)
fn _run_spec_coverage(args: [text]) -> (text, text, i64):
    _run_seed("spec-coverage", args)

describe "spec-coverage log mode CLI options":
    _seed_it "shows shared log options in help":
        # @req REQ-001
        # @req REQ-002
        # @req REQ-001
        # @req REQ-002
        # @req REQ-SSPEC-INTEGRATION
        step("shows shared log options in help")
        step("Verify: shows shared log options in help")
        # @req: REQ-APP-SpecCoveLogMode-001
        _setup_empty_fixture()
        val (out, err, code) = _run_spec_coverage(["--help"])
        expect(code).to_equal(0)  # oracle: value fixed by the spec contract  # oracle: pinned constant asserted by this scenario
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    _seed_it "supports log-mode json for missing feature database":
        # @req REQ-SSPEC-INTEGRATION
        step("supports log-mode json for missing feature database")
        step("Verify: supports log-mode json for missing feature database")
        # @req: REQ-APP-SpecCoveLogMode-001
        _setup_empty_fixture()
        val (out, err, code) = _run_spec_coverage(["--log-mode=json"])
        expect(code).to_equal(1)  # oracle: value fixed by the spec contract  # oracle: pinned constant asserted by this scenario
        expect(out).to_contain("\"command\":\"spec-coverage\"")
        expect(out).to_contain("\"status\":\"error\"")
        expect(out).to_contain("\"total\":0")

    _seed_it "supports dot progress":
        # @req REQ-SSPEC-INTEGRATION
        step("supports dot progress")
        step("Verify: supports dot progress")
        # @req: REQ-APP-SpecCoveLogMode-001
        _setup_feature_fixture()
        val (out, err, code) = _run_spec_coverage(["--progress=dot"])
        expect(code).to_equal(0)  # oracle: value fixed by the spec contract  # oracle: pinned constant asserted by this scenario
        expect(out).to_contain(".")
        expect(out).to_contain("Total features: 2")

    _seed_it "rejects invalid log mode":
        # @req REQ-SSPEC-INTEGRATION
        step("rejects invalid log mode")
        step("Verify: rejects invalid log mode")
        # @req: REQ-APP-SpecCoveLogMode-001
        _setup_empty_fixture()
        val (out, err, code) = _run_spec_coverage(["--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: value fixed by the spec contract  # oracle: pinned constant asserted by this scenario
