"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the os command (--log-mode
and --progress) as observed through real process invocations in the repo
root, where the os app needs no fixture working directory.
Audience: compiler and tooling engineers who maintain the os app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/os_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the os command's shared log options only; each scenario spawns real
`bin/simple` processes. The version scenario intentionally stays RED until
`os --version` is routed instead of parsed as a subcommand.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: os-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn _run_os(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/os/main.spl\" " + joined
    ])

describe "os log mode CLI options":
    it "reports the focused compiler version without entering OS parsing":
        # @req REQ-OS-LOGMODE-001
        # @capture(protocol_json): os --version stdout captured for the version contract
        step("Ask the os command for its focused compiler version")
        val (out, err, code) = _run_os(["--version"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --version
        expect(out).to_equal("simple-bootstrap 1.0.0-beta\n")

    it "shows shared log options in help":
        # @req REQ-OS-LOGMODE-001
        # @capture(tui_grid): os help text listing the shared log options
        step("Run os --help from the repo root")
        val (out, err, code) = _run_os(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json for usage output":
        # @req REQ-OS-LOGMODE-001
        # @capture(protocol_json): usage JSON transcript emitted by the os command
        step("Invoke os with no subcommand and log-mode json")
        val (out, err, code) = _run_os(["--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for printing usage
        expect(out).to_contain("\"command\":\"os\"")
        expect(out).to_contain("\"status\":\"usage\"")

    it "supports dot progress for usage output":
        # @req REQ-OS-LOGMODE-001
        # @capture(tui_grid): dot-progress output followed by the SimpleOS usage banner
        step("Invoke os with dot progress and no subcommand")
        val (out, err, code) = _run_os(["--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for printing usage
        expect(out).to_start_with(".")
        expect(out).to_contain("SimpleOS")

    it "rejects invalid log mode":
        # @req REQ-OS-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke os with an unknown log mode and expect a usage error")
        val (out, err, code) = _run_os(["--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode

    it "emits json for deterministic targets output":
        # @req REQ-OS-LOGMODE-001
        # @capture(protocol_json): targets JSON transcript naming the os action
        step("List the deterministic build targets with log-mode json")
        val (out, err, code) = _run_os(["--log-mode=json", "targets"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for the targets action
        expect(out).to_contain("\"command\":\"os\"")
        expect(out).to_contain("\"status\":\"ok\"")
        expect(out).to_contain("\"action\":\"targets\"")
