"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the examples-check command
(--log-mode and --progress) as observed through real process invocations
against an empty fixture working directory.
Audience: compiler and tooling engineers who maintain the examples-check app
and the shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/examples_check_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the examples-check command's shared log options only; each scenario
spawns real `bin/simple` processes against an empty /tmp fixture, so every
non-help scenario exercises the no-examples-found error path and exits 1.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: examples-check-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_examples_check_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR
    ])

fn _run_examples_check(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/examples_check/main.spl\" " + joined
    ])

describe "examples-check log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-EXAMPLESCHECK-LOGMODE-001
        # @capture(tui_grid): examples-check help text listing the shared log options
        step("Run examples-check --help in the fixture directory")
        _setup_fixture()
        val (out, err, code) = _run_examples_check(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json for empty directories":
        # @req REQ-EXAMPLESCHECK-LOGMODE-001
        # @capture(protocol_json): error JSON transcript emitted for an empty examples tree
        step("Check the empty fixture examples tree with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_examples_check(["--log-mode=json", "examples"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI exit code when no examples are found
        expect(out).to_contain("\"command\":\"examples-check\"")
        expect(out).to_contain("\"status\":\"error\"")
        expect(out).to_contain("\"total\":0")

    it "supports dot progress for empty directories":
        # @req REQ-EXAMPLESCHECK-LOGMODE-001
        # @capture(tui_grid): dot-progress output followed by the no-examples error line
        step("Check the empty fixture examples tree with dot progress")
        _setup_fixture()
        val (out, err, code) = _run_examples_check(["--progress=dot", "examples"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI exit code when no examples are found
        expect(out).to_contain(".")
        expect(out).to_contain("No .spl files found under examples")

    it "rejects invalid log mode":
        # @req REQ-EXAMPLESCHECK-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke examples-check with an unknown log mode and expect a usage error")
        _setup_fixture()
        val (out, err, code) = _run_examples_check(["--log-mode=noisy", "examples"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
