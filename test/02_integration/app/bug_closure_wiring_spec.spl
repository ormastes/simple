"""
## Purpose and audience
Purpose: pin the wiring of the pure closure gate (`bug_closure_evaluate_v1`) into
the real `bug-resolve` and `bug-closure-check` CLIs as observed through spawned
processes against a fixture bug database. A blocked close must leave the
database byte-identical; an allowed close with full evidence resolves the bug; a
live workaround blocks with E-BUG-WR-004; a non-fix disposition closes without
fix evidence and is not recorded as a verified fix; closure-check never writes.
Audience: engineers who maintain bug-tracking CLIs and the closure gate.
## Operator workflow
Run `simple test test/02_integration/app/bug_closure_wiring_spec.spl`; a failing
scenario names the exact exit code or diagnostic that regressed.
## Compatibility and limitations
Run evidence (pre-fix RED / post-fix GREEN) is reported as not_observed because
the CLI has no TestDB run source yet; see
doc/08_tracking/bug/bug_closure_gate_wiring_remaining_2026-11-14.md.
## Verification guidance and troubleshooting
Each scenario spawns real `bin/simple` processes under temp-dir fixtures; compare
the printed receipt lines with the plan section 4.4 diagnostic table.
"""
# @manual_section: bug-closure-wiring

use std.spec.{describe, it, expect}
use std.spec.step
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.env.platform.{is_windows, get_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all}
use std.nogc_sync_mut.io.file_ops.{file_create_exclusive, file_read_text}
use std.env.variables.{env_get}
use std.nogc_sync_mut.io.env_ops.{cwd}
use std.database.test_extended.database.{TestDatabaseExtended}
use std.database.test_extended.source_revision.{TestSourceRevision}
use std.nogc_sync_mut.test_runner.test_db_compat.{RunnerTestDb}
use std.common.traceability.case_events.{TraceCaseEvent, TraceCaseFacts, TestBackendName}
use app.bug.workaround_index.{WorkaroundIndex, WorkaroundLink, WorkaroundLineNumber, WorkaroundCompleteness, encode_workaround_index}

val CLI_RUN_TIMEOUT_MS: i64 = 120000
val CLI_RUN_MAX_OUT: i64 = 16777216
val HEAD = "abcdef0123456789abcdef0123456789abcdef01"
val OTHER_HEAD = "1234567890abcdef1234567890abcdef12345678"

fn _repo_root() -> text:
    cwd().replace("\\", "/")

fn _spawn_cli(run_args: [text], work_dir: text) -> (text, text, i64):
    val repo = _repo_root()
    val program = if is_windows(): repo + "/bin/simple.exe" else: repo + "/bin/simple"
    val lib = repo + "/src"
    val joined = run_args.join(" ")
    val (shell, shell_args) = if is_windows():
        val sh = env_get("ComSpec") ?? "cmd.exe"
        (sh, ["/d", "/c", "cd /d " + work_dir + " && set \"SIMPLE_LIB=" + lib + "\" && " + program + " run " + joined])
    else:
        ("/bin/sh", ["-c", "cd \"" + work_dir + "\" && SIMPLE_LIB=\"" + lib + "\" \"" + program + "\" run " + joined])
    process_run_bounded(shell, shell_args, CLI_RUN_TIMEOUT_MS, CLI_RUN_MAX_OUT)

val FIXTURE_DIR = get_temp_dir().replace("\\", "/") + "/simple_bug_closure_wiring_fixture"
val DB_PATH = FIXTURE_DIR + "/doc/08_tracking/bug/bug_db.sdn"

fn _setup_fixture(links: [WorkaroundLink]):
    val _removed = dir_remove_all(FIXTURE_DIR)
    if not dir_create_all(FIXTURE_DIR + "/doc/08_tracking/bug") or not dir_create_all(FIXTURE_DIR + "/test") or not dir_create_all(FIXTURE_DIR + "/.simple"):
        fail("could not create fixture dirs under " + FIXTURE_DIR)
    val db = "bugs_active |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\n\nbugs |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\n    baseline_bug, P2, closed, baseline, src/app/baseline.spl, 0, fixture, 2026-05-01, 2026-05-01, true\n\nbug_descriptions |bug_id, line_num, content|\n\nbug_fix_strategies |bug_id, line_num, content|\n\nbug_investigation_logs |bug_id, line_num, content|\n\nbug_token_usage |bug_id, category, provider, input_tokens, output_tokens, cache_read_tokens, cache_create_tokens, total_tokens, source, knowledge, recorded_at|\n    baseline_bug, application, test-provider, 100, 0, 0, 0, 100, fixture, none, 2026-05-01\n"
    if not file_create_exclusive(DB_PATH, db):
        fail("could not write fixture bug database")
    if not file_create_exclusive(FIXTURE_DIR + "/test/repro_spec.spl", "# reproducer fixture\n"):
        fail("could not write reproducer fixture")
    if not file_create_exclusive(FIXTURE_DIR + "/test/prevent_spec.spl", "# prevention fixture\n"):
        fail("could not write prevention fixture")
    val index = WorkaroundIndex(revision: HEAD, complete: WorkaroundCompleteness.Complete, links: links)
    if not file_create_exclusive(FIXTURE_DIR + "/.simple/workarounds.sdn", encode_workaround_index(index)):
        fail("could not write workaround index fixture")

fn _add_bug(id: text):
    val (_out, _err, code) = _spawn_cli(["src/app/bug_add/main.spl", "--id=" + id, "--severity=p2", "--title=fixture", "--file=src/app/main.spl"], FIXTURE_DIR)
    expect(code).to_equal(0)  # oracle: bug-add exits 0 when the fixture bug is recorded

val EVIDENCE = ["--reproducer=test/repro_spec.spl", "--prevention=test/prevent_spec.spl", "--source-head=" + HEAD]

fn _resolve(id: text, extra: [text]) -> (text, text, i64):
    val base = ["src/app/bug_resolve/main.spl", "--id=" + id, "--date=2026-11-15", "--input-tokens=-1", "--output-tokens=-1", "--cache-read-tokens=-1", "--cache-create-tokens=-1", "--token-provider=test-provider", "--token-source=test-session", "--knowledge=none"]
    _spawn_cli(base + extra, FIXTURE_DIR)

fn _check(extra: [text]) -> (text, text, i64):
    _spawn_cli(["src/app/bug_closure_check/main.spl"] + extra, FIXTURE_DIR)

fn _live_workaround(id: text) -> WorkaroundLink:
    WorkaroundLink(bug_id: id, path: "src/app/main.spl", line: WorkaroundLineNumber(value: 7), recover: "", reason: "fixture workaround")

describe "bug closure gate wiring in the CLI":
    it "a blocked close writes nothing to the bug database":
        # @req BUG-001
        # @req BUG-002
        # @req BUG-004
        step("Fixture bug with a live workaround and full spec evidence")
        _setup_fixture([_live_workaround("wired_blocked_001")])
        _add_bug("wired_blocked_001")
        val before = file_read_text(DB_PATH)
        step("Blocked by the evaluator: live workaround")
        val (out, _err, code) = _resolve("wired_blocked_001", EVIDENCE)
        expect(code).to_equal(1)  # oracle: 1 is the CLI rejection exit code
        expect(out).to_contain("E-BUG-WR-004")
        expect(file_read_text(DB_PATH)).to_equal(before)
        step("Adverse: missing reproducer is rejected with the CU-015 message and still writes nothing")
        val (out2, _err2, code2) = _resolve("wired_blocked_001", ["--source-head=" + HEAD])
        expect(code2).to_equal(1)  # oracle: 1 is the CLI rejection exit code
        expect(out2).to_contain("--reproducer=")
        expect(file_read_text(DB_PATH)).to_equal(before)

    it "a blocked close with --auto-retire prints no retirement list and writes nothing":
        # @req BUG-004
        step("Fixture bug with a live workaround")
        _setup_fixture([_live_workaround("wired_retire_001")])
        _add_bug("wired_retire_001")
        val before = file_read_text(DB_PATH)
        val (out, _err, code) = _resolve("wired_retire_001", EVIDENCE + ["--auto-retire"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI rejection exit code
        expect(out).to_contain("E-BUG-WR-004")
        expect(out.contains("retirement candidate")).to_equal(false)
        expect(file_read_text(DB_PATH)).to_equal(before)
        step("Adverse: an allowed close with --auto-retire does list retirement state")
        _setup_fixture([])
        _add_bug("wired_retire_001")
        val (ok_out, _e2, _c2) = _resolve("wired_retire_001", EVIDENCE + ["--auto-retire"])
        expect(ok_out).to_contain("auto-retire: wired_retire_001")

    it "a live workaround blocks the close with E-BUG-WR-004 naming its location":
        # @req BUG-004
        step("Fixture bug linked from a workaround annotation")
        _setup_fixture([_live_workaround("wired_wr_001")])
        _add_bug("wired_wr_001")
        val (out, _err, code) = _resolve("wired_wr_001", EVIDENCE)
        expect(code).to_equal(1)  # oracle: 1 is the CLI rejection exit code
        expect(out).to_contain("E-BUG-WR-004 proof=src/app/main.spl:7")
        step("Adverse: a workaround linked to a different bug does not block this one")
        _setup_fixture([_live_workaround("someone_else")])
        _add_bug("wired_wr_001")
        val (_ok_out, _ok_err, ok_code) = _resolve("wired_wr_001", EVIDENCE)
        expect(ok_code).to_equal(0)  # oracle: 0 is the CLI success exit code for a resolved bug

    it "an allowed close with full evidence resolves the bug and records the receipt":
        # @req BUG-001
        # @req BUG-002
        # @req BUG-003
        step("Evidence, clean workaround index, pinned head")
        _setup_fixture([])
        _add_bug("wired_allowed_001")
        val (out, _err, code) = _resolve("wired_allowed_001", EVIDENCE)
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a resolved bug
        expect(out).to_contain("Resolved bug wired_allowed_001")
        val db = file_read_text(DB_PATH)
        expect(db).to_contain("close_evidence reproducer=test/repro_spec.spl prevention=test/prevent_spec.spl run_evidence=not_observed head=" + HEAD)

    it "a non-fix disposition closes without fix evidence and is not recorded as a verified fix":
        # @req BUG-001
        # @req BUG-002
        step("Duplicate with a rationale and no reproducer or prevention")
        _setup_fixture([])
        _add_bug("wired_dup_001")
        val (out, _err, code) = _resolve("wired_dup_001", ["--disposition=duplicate", "--rationale=duplicate-of-wired_allowed_001", "--source-head=" + HEAD])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code
        expect(out).to_contain("Resolved bug wired_dup_001")
        val db = file_read_text(DB_PATH)
        expect(db).to_contain("not_a_verified_fix")
        expect(db.contains("close_evidence")).to_equal(false)
        step("Adverse: a non-fix disposition without a rationale is rejected and writes nothing")
        _setup_fixture([])
        _add_bug("wired_dup_002")
        val before = file_read_text(DB_PATH)
        val (_out2, _err2, code2) = _resolve("wired_dup_002", ["--disposition=duplicate", "--source-head=" + HEAD])
        expect(code2).to_equal(1)  # oracle: 1 is the CLI rejection exit code
        expect(file_read_text(DB_PATH)).to_equal(before)

describe "bug-closure-check":
    it "is read-only and reports allowed, blocked and usage errors with exit 0, 1 and 2":
        # @req BUG-004
        # @req BUG-005
        step("Fixture bug with a live workaround")
        _setup_fixture([_live_workaround("wired_check_001")])
        _add_bug("wired_check_001")
        val blocked_before = file_read_text(DB_PATH)
        step("Blocked: prints the E-BUG code and exits 1")
        val (blocked_out, _e1, blocked_code) = _check(["--id=wired_check_001"] + EVIDENCE)
        expect(blocked_code).to_equal(1)  # oracle: 1 means the closure is blocked
        expect(blocked_out).to_contain("E-BUG-WR-004")
        expect(file_read_text(DB_PATH)).to_equal(blocked_before)
        step("Usage error: exits 2")
        val (_o2, _e2, usage_code) = _check([])
        expect(usage_code).to_equal(2)  # oracle: 2 is the usage-error exit code
        step("Allowed with a clean workaround index: exits 0")
        _setup_fixture([])
        _add_bug("wired_check_001")
        val clean_before = file_read_text(DB_PATH)
        val (ok_out, _e3, ok_code) = _check(["--id=wired_check_001"] + EVIDENCE)
        expect(ok_code).to_equal(0)  # oracle: 0 means the closure would be allowed
        expect(ok_out).to_contain("verdict=allowed")
        expect(ok_out).to_contain("run_evidence=not_observed")
        step("No invocation changed the bug database")
        expect(file_read_text(DB_PATH)).to_equal(clean_before)

fn _record_run_events(owner: RunnerTestDb, run_id: text, path: text, case_name: text, outcome: text, backend_name: text):
    val start_facts = TraceCaseFacts(backend: Some(TestBackendName(value: backend_name)))
    val events = [
        TraceCaseEvent(case_name: case_name, phase: "started", outcome: "not_finished", facts: Some(start_facts)),
        TraceCaseEvent(case_name: case_name, phase: "finished", outcome: outcome)
    ]
    match owner.db.record_trace_case_events(run_id, path, events):
        case Ok(_): pass
        case Err(reason): fail("fixture trace write failed: {reason}")

fn _distinct_test_run(owner: RunnerTestDb, rev: TestSourceRevision?) -> text:
    val prev = owner.current_run_id
    var next_id = owner.start_run(rev)
    while next_id == prev:
        next_id = owner.start_run(rev)
    next_id

fn _setup_observed_testdb(pre_repro_outcome: text, post_head: text) -> (text, text, text):
    val test_db_path = FIXTURE_DIR + "/test_db.sdn"
    var owner = RunnerTestDb(db: TestDatabaseExtended.create(test_db_path), current_run_id: "")
    val pre_run = _distinct_test_run(owner, Some(TestSourceRevision(value: OTHER_HEAD)))
    _record_run_events(owner, pre_run, "test/repro_spec.spl", "reproduces", pre_repro_outcome, "interpreter")
    val post_run = _distinct_test_run(owner, Some(TestSourceRevision(value: post_head)))
    _record_run_events(owner, post_run, "test/repro_spec.spl", "reproduces", "passed", "interpreter")
    _record_run_events(owner, post_run, "test/prevent_spec.spl", "prevents", "passed", "interpreter")
    match owner.save():
        case Ok(_): pass
        case Err(reason): fail("fixture TestDB save failed: {reason}")
    (pre_run, post_run, "test_db.sdn")

describe "bug closure gate wiring with TestDB run evidence":
    it "allows check and resolve with observed pre-fix RED and post-fix GREEN":
        # @req BUG-001
        # @req BUG-002
        # @req BUG-003
        _setup_fixture([])
        _add_bug("wired_obs_001")
        val (pre_run, post_run, test_db_rel) = _setup_observed_testdb("failed", HEAD)
        val obs_flags = EVIDENCE + [
            "--pre-fix-run=" + pre_run,
            "--post-fix-run=" + post_run,
            "--required-backend=interpreter",
            "--test-db=" + test_db_rel
        ]
        val (check_out, _ce, check_code) = _check(["--id=wired_obs_001"] + obs_flags)
        expect(check_code).to_equal(0)
        expect(check_out).to_contain("verdict=allowed")
        expect(check_out).to_contain("run_evidence=observed")
        val (res_out, _re, res_code) = _resolve("wired_obs_001", obs_flags)
        expect(res_code).to_equal(0)
        expect(res_out).to_contain("Resolved bug wired_obs_001")
        val db = file_read_text(DB_PATH)
        expect(db).to_contain("run_evidence=observed head=" + HEAD)
        expect(db).to_contain("pre_fix_run=" + pre_run)
        expect(db).to_contain("post_fix_run=" + post_run)

    it "blocks stale post-fix head, missing pre-fix RED, and unknown runs without modifying bug DB":
        # @req BUG-001
        # @req BUG-003
        _setup_fixture([])
        _add_bug("wired_obs_block_001")
        val (pre_run, stale_post, test_db_rel) = _setup_observed_testdb("failed", OTHER_HEAD)
        val before = file_read_text(DB_PATH)
        val (stale_out, _se, stale_code) = _resolve("wired_obs_block_001", EVIDENCE + [
            "--pre-fix-run=" + pre_run,
            "--post-fix-run=" + stale_post,
            "--required-backend=interpreter",
            "--test-db=" + test_db_rel
        ])
        expect(stale_code).to_equal(1)
        expect(stale_out).to_contain("E-BUG-EVIDENCE-003")
        expect(file_read_text(DB_PATH)).to_equal(before)

        val (bad_pre, ok_post, test_db_rel2) = _setup_observed_testdb("passed", HEAD)
        val (repro_out, _re2, repro_code) = _resolve("wired_obs_block_001", EVIDENCE + [
            "--pre-fix-run=" + bad_pre,
            "--post-fix-run=" + ok_post,
            "--required-backend=interpreter",
            "--test-db=" + test_db_rel2
        ])
        expect(repro_code).to_equal(1)
        expect(repro_out).to_contain("E-BUG-REPRO-001")
        expect(file_read_text(DB_PATH)).to_equal(before)

        val (unk_out, _ue, unk_code) = _check(["--id=wired_obs_block_001"] + EVIDENCE + [
            "--post-fix-run=run_missing",
            "--required-backend=interpreter",
            "--test-db=" + test_db_rel2
        ])
        expect(unk_code).to_equal(2)
        expect(unk_out).to_contain("test database error")
        expect(file_read_text(DB_PATH)).to_equal(before)
