"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the brief app (--log-mode and
--progress) as observed through real process invocations of src/app/brief.
Audience: compiler and tooling engineers who maintain the brief app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with `simple run test/02_integration/app/brief_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the brief app's shared log options only; each scenario spawns real
`bin/simple` processes and writes its fixture under /tmp.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec and
compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: brief-log-modes

use std.spec.{describe, it, expect}
use std.spec.step
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.env.platform.{get_temp_dir, is_windows}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all}
use std.nogc_sync_mut.io.file_ops.{file_create_exclusive}

# Host-derived fixture scope; a hardcoded /tmp breaks every non-POSIX host.
val FIXTURE_DIR = get_temp_dir().replace("\\", "/") + "/simple_brief_log_mode_fixture"

fn _setup_fixture():
    val _removed = dir_remove_all(FIXTURE_DIR)
    if not dir_create_all(FIXTURE_DIR):
        fail("could not create fixture dir " + FIXTURE_DIR)
    if not file_create_exclusive(FIXTURE_DIR + "/main.spl",
            "fn main() -> i64:\n    0\n"):
        fail("could not write fixture main.spl under " + FIXTURE_DIR)

fn _run_brief(args: [text]) -> (text, text, i64):
    # The spawned CLI is the native executable on Windows (bin/simple is a
    # shell-only name there).
    val program = if is_windows(): "bin/simple.exe" else: "bin/simple"
    process_run_bounded(program, args, 120000, 16777216)

describe "brief log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-BRIEF-LOGMODE-001
        # @capture(tui_grid): help text listing the shared log options
        step("Verify: shows shared log options in help")
        val (out, err, code) = _run_brief(["run", "src/app/brief/main.spl", "--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json":
        # @req REQ-BRIEF-LOGMODE-001
        # @capture(protocol_json): stdout JSON transcript of the brief run summary
        step("Verify: supports log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_brief(["run", "src/app/brief/main.spl", FIXTURE_DIR, "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a clean run
        expect(out).to_contain("\"files\":1")
        expect(out).to_contain("\"lines\":3")

    it "supports dot progress":
        # @req REQ-BRIEF-LOGMODE-001
        # @capture(tui_grid): dot-progress terminal output of the brief run
        step("Verify: supports dot progress")
        _setup_fixture()
        val (out, err, code) = _run_brief(["run", "src/app/brief/main.spl", FIXTURE_DIR, "--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a clean run
        expect(out).to_start_with(".")

    it "rejects invalid log mode":
        # @req REQ-BRIEF-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Verify: rejects invalid log mode")
        _setup_fixture()
        val (out, err, code) = _run_brief(["run", "src/app/brief/main.spl", FIXTURE_DIR, "--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
