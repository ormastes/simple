use std.spec.{describe, it, expect, step}

extern fn rt_sqlite_demand_state() -> i64
extern fn rt_sqlite_demand_concurrent_probe() -> i64

describe "SQLite concurrent first demand":
    it "admits one provider while four callers open and close databases":
        expect(rt_sqlite_demand_state()).to_equal(0)
        step("Start four native SQLite calls from separate threads")
        expect(rt_sqlite_demand_concurrent_probe()).to_equal(1)
        expect(rt_sqlite_demand_state()).to_equal(2)
