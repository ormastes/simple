"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the context app (--log-mode
and --progress) as observed through real process invocations against a
fixture working directory.
Audience: compiler and tooling engineers who maintain the context app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/context_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the context app's shared log options only; each scenario spawns real
`bin/simple` processes and builds its fixture under /tmp.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: context-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_context_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR
    ])

fn _run_context(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/context/main.spl\" " + joined
    ])

describe "context log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-CONTEXT-LOGMODE-001
        # @capture(tui_grid): context help text listing the shared log options
        step("Verify: shows shared log options in help")
        _setup_fixture()
        val (out, err, code) = _run_context(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json for missing source":
        # @req REQ-CONTEXT-LOGMODE-001
        # @capture(protocol_json): stdout JSON error transcript for a missing source
        step("Verify: supports log-mode json for missing source")
        _setup_fixture()
        val (out, err, code) = _run_context(["--log-mode=json", "missing.spl"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI failure exit code for a missing source file
        expect(out).to_contain("\"command\":\"context\"")
        expect(out).to_contain("\"status\":\"error\"")
        expect(out).to_contain("\"source\":\"missing.spl\"")

    it "supports dot progress for missing source":
        # @req REQ-CONTEXT-LOGMODE-001
        # @capture(tui_grid): dot-progress error output for a missing source
        step("Verify: supports dot progress for missing source")
        _setup_fixture()
        val (out, err, code) = _run_context(["--progress=dot", "missing.spl"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI failure exit code for a missing source file
        expect(out).to_contain(".")
        expect(out).to_contain("context: cannot read missing.spl")

    it "rejects invalid log mode":
        # @req REQ-CONTEXT-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Verify: rejects invalid log mode")
        _setup_fixture()
        val (out, err, code) = _run_context(["--log-mode=noisy", "missing.spl"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
