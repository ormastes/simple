use std.spec.*
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}

val PROBE = "test/fixtures/app/itf_color_probe.spl"

fn run_color_probe(env_args: [text]) -> (text, text, i64):
    var args = env_args
    args.push("bin/simple")
    args.push("run")
    args.push(PROBE)
    process_run_bounded("/usr/bin/env", args, 30000, 65536)

describe "ITF color output through a real subprocess pipe":
    it "omits ANSI by default when stdout is redirected":
        val (out, _, code) = run_color_probe(["-u", "NO_COLOR", "-u", "ITF_FORCE_COLOR"])
        expect(code).to_equal(0)
        expect(out).to_contain("ITF_COLOR_PROBE")
        expect(out.contains("\x1b[")).to_equal(false)

    it "emits ANSI when redirected output is explicitly forced":
        val (out, _, code) = run_color_probe(["-u", "NO_COLOR", "ITF_FORCE_COLOR=1"])
        expect(code).to_equal(0)
        expect(out).to_contain("ITF_COLOR_PROBE")
        expect(out).to_contain("\x1b[32mITF_COLOR_PROBE\x1b[0m")

    it "lets NO_COLOR win over a force request":
        val (out, _, code) = run_color_probe(["NO_COLOR=1", "ITF_FORCE_COLOR=1"])
        expect(code).to_equal(0)
        expect(out).to_contain("ITF_COLOR_PROBE")
        expect(out.contains("\x1b[")).to_equal(false)
