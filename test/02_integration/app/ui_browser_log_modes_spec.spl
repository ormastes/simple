"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the ui.browser app
(--log-mode and --progress) together with its planning, missing-file, and
unknown-option error reporting, as observed through real process
invocations.
Audience: compiler and tooling engineers who maintain the ui.browser app and
the shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/ui_browser_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the ui.browser app's shared log options and its planning output only;
each scenario spawns real `bin/simple` processes and plans against a demo UI
SDN without opening a window.
## Verification guidance and troubleshooting
A failure names the exact option, mode, or JSON field that regressed;
re-run this spec and compare the captured stdout in the failing scenario to
reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: ui-browser-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn _run_ui_browser(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/ui.browser/main.spl\" " + joined
    ])

describe "ui.browser log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-UI-BROWSER-LOGMODE-001
        # @capture(tui_grid): ui.browser help text listing the shared log options
        step("Verify: shows shared log options in help")
        val (out, err, code) = _run_ui_browser(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("Simple UI Browser")
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json ready output":
        # @req REQ-UI-BROWSER-LOGMODE-001
        # @capture(protocol_json): stdout JSON ready announcement
        step("Verify: supports log-mode json ready output")
        val (out, err, code) = _run_ui_browser(["--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a ready browser start
        expect(out).to_contain("\"command\":\"ui.browser\"")
        expect(out).to_contain("\"status\":\"ready\"")

    it "supports json browser planning":
        # @req REQ-UI-BROWSER-LOGMODE-001
        # @capture(protocol_json): stdout JSON plan echoing file, snapshot, backend, flags
        step("Verify: supports json browser planning")
        val (out, err, code) = _run_ui_browser([
            "--log-mode=json",
            "examples/06_io/ui/demo.ui.sdn",
            "--snapshot",
            "tmp.ppm",
            "--backend",
            "software",
            "--ui-access-db",
            "access.db",
            "--open",
            "--shared-wm"
        ])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a planned session
        expect(out).to_contain("\"status\":\"planned\"")
        expect(out).to_contain("\"file\":\"examples/06_io/ui/demo.ui.sdn\"")
        expect(out).to_contain("\"snapshot\":\"tmp.ppm\"")
        expect(out).to_contain("\"backend\":\"software\"")
        expect(out).to_contain("\"ui_access_db\":\"access.db\"")
        expect(out).to_contain("\"open\":true")
        expect(out).to_contain("\"shared_wm\":true")

    it "supports dot progress for help output":
        # @req REQ-UI-BROWSER-LOGMODE-001
        # @capture(tui_grid): dot-progress help output naming the browser
        step("Verify: supports dot progress for help output")
        val (out, err, code) = _run_ui_browser(["--progress=dot", "--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain(".\nSimple UI Browser")

    it "rejects invalid log mode":
        # @req REQ-UI-BROWSER-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Verify: rejects invalid log mode")
        val (out, err, code) = _run_ui_browser(["--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode

    it "renders json missing file output":
        # @req REQ-UI-BROWSER-LOGMODE-001
        # @capture(protocol_json): stdout JSON error for a --open without a UI SDN file
        step("Verify: renders json missing file output")
        val (out, err, code) = _run_ui_browser(["--log-mode=json", "--open"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI failure exit code for a missing required file
        expect(out).to_contain("\"status\":\"error\"")
        expect(out).to_contain("requires a UI SDN file")

    it "renders json unknown option output":
        # @req REQ-UI-BROWSER-LOGMODE-001
        # @capture(protocol_json): stdout JSON error naming the unknown option
        step("Verify: renders json unknown option output")
        val (out, err, code) = _run_ui_browser(["--log-mode=json", "--surprise"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown option
        expect(out).to_contain("\"status\":\"error\"")
        expect(out).to_contain("Unknown ui.browser option: --surprise")
