use std.spec.*
use app.sspec_maintain.main.{run_sspec_maintain}

describe "sspec-maintain CLI contract":
    it "shows help without requiring a path":
        expect(run_sspec_maintain(["--help"])).to_equal(0)

    it "rejects an unknown operation with usage status":
        expect(run_sspec_maintain(["unknown", "fixture.spl"])).to_equal(2)

    it "reports missing input as an IO failure":
        expect(run_sspec_maintain(["scan", "build/sspec-maintain/missing_spec.spl"])).to_equal(3)
