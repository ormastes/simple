# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.{describe, it, expect, step}
use std.io_runtime.{host_arch}
use compiler.loader.smf_mmap_native.{
    native_alloc_exec_memory, native_write_exec_memory,
    native_mmap_read_bytes, native_make_executable,
    native_call_function_0, native_free_exec_memory
}

describe "Loader executable memory":
    # @manual: show
    it "copies real bytes into a loader-owned mapping":
        # @req REQ-SSPEC-INTEGRATION
        step("Allocate writable memory through the production loader")
        val addr = native_alloc_exec_memory(4096)
        expect(addr).to_be_greater_than(0)
        val code: [u8] = [17, 34, 51, 68]
        unsafe(capabilities: [raw_ptr]):
            step("Write at a nonzero offset and read the exact bytes back")
            val written = native_write_exec_memory(addr, code, 64)
            val copied = native_mmap_read_bytes(addr, 64, 4)
            val freed = native_free_exec_memory(addr, 4096)
            expect(written).to_equal(4)
            expect(copied).to_equal(code)
            step("Release the real mapping")
            expect(freed).to_be(true)

    # @manual: show
    it "rejects invalid sizes and function addresses deterministically":
        # @req REQ-SSPEC-INTEGRATION
        step("Reject nonpositive allocation sizes without relying on OS overcommit")
        expect(native_alloc_exec_memory(0)).to_equal(0)
        expect(native_alloc_exec_memory(-1)).to_equal(0)
        unsafe(capabilities: [raw_ptr]):
            step("Reject a null entry point through the Result-returning call API")
            val result = native_call_function_0(0)
            expect(result.is_err()).to_be(true)
            expect(result.unwrap_err()).to_equal("cannot call a null or invalid native function address")
            expect(native_free_exec_memory(0, 4096)).to_be(false)

    # The byte-copy and rejection cases above run on every host. This machine
    # code has the same no-argument return ABI on x86_64 Windows and POSIX hosts.
    # Other architectures do not register an executable-code proof.
    if host_arch() == "x86_64":
        # @manual: show
        it "seals and executes an x86_64 function through the production loader":
            # @req REQ-SSPEC-INTEGRATION
            step("Allocate a real writable mapping for mov eax, 42; ret")
            val code: [u8] = [184, 42, 0, 0, 0, 195]
            val addr = native_alloc_exec_memory(4096)
            expect(addr).to_be_greater_than(0)
            unsafe(capabilities: [raw_ptr]):
                val written = native_write_exec_memory(addr, code, 0)
                expect(written).to_equal(code.len() as i64)
                step("Seal the mapping as executable before invoking its entry point")
                val made_exec = native_make_executable(addr, 4096)
                expect(made_exec).to_be(true)
                val result = native_call_function_0(addr)
                val freed = native_free_exec_memory(addr, 4096)
                step("Observe the exact machine-code return and release the mapping")
                expect(result.is_ok()).to_be(true)
                expect(result.unwrap()).to_equal(42)
                expect(freed).to_be(true)
