use app.compiler_service.demand_profile.{compiler_demand_profile_v1}
use app.test_daemon.demand_profile.{test_daemon_demand_profile_v1}
use app.mcp.demand_compile_profile.{mcp_demand_compile_profile_v1}
use app.simple_lsp_mcp.demand_compile_profile.{lsp_demand_compile_profile_v1}
use lib.compiler_artifact_service.profile.{artifact_service_profile_validate_v1}

describe "demand compile profile adapters":
    it "share one compatibility identity without owning queue or cache state":
        val compatibility_id = "fixture-compatibility-v1"
        val compiler = compiler_demand_profile_v1(compatibility_id)
        val tests = test_daemon_demand_profile_v1(compatibility_id)
        val mcp = mcp_demand_compile_profile_v1(compatibility_id)
        val lsp = lsp_demand_compile_profile_v1(compatibility_id)

        expect(artifact_service_profile_validate_v1(compiler)).to_equal("ok")
        expect(artifact_service_profile_validate_v1(tests)).to_equal("ok")
        expect(artifact_service_profile_validate_v1(mcp)).to_equal("ok")
        expect(artifact_service_profile_validate_v1(lsp)).to_equal("ok")
        expect(compiler.compatibility_id).to_equal(compatibility_id)
        expect(tests.compatibility_id).to_equal(compatibility_id)
        expect(mcp.compatibility_id).to_equal(compatibility_id)
        expect(lsp.compatibility_id).to_equal(compatibility_id)

    it "gives interactive compiler clients foreground priority":
        val compatibility_id = "fixture-compatibility-v1"
        val compiler = compiler_demand_profile_v1(compatibility_id)
        val tests = test_daemon_demand_profile_v1(compatibility_id)
        val mcp = mcp_demand_compile_profile_v1(compatibility_id)
        val lsp = lsp_demand_compile_profile_v1(compatibility_id)

        expect(mcp.foreground_priority).to_be_greater_than(tests.foreground_priority)
        expect(lsp.foreground_priority).to_be_greater_than(tests.foreground_priority)
        expect(compiler.foreground_priority).to_be_greater_than(tests.foreground_priority)

    it "keeps daemon availability outside semantic profile identity":
        val online = compiler_demand_profile_v1("fixture-compatibility-v1")
        val offline = compiler_demand_profile_v1("fixture-compatibility-v1")

        expect(online.compatibility_id).to_equal(offline.compatibility_id)
        expect(online.daemon_optional).to_be(true)
        expect(offline.daemon_optional).to_be(true)

    it "uses one CAS namespace as sole successful-result authority":
        val compatibility_id = "fixture-compatibility-v1"
        val compiler = compiler_demand_profile_v1(compatibility_id)
        val tests = test_daemon_demand_profile_v1(compatibility_id)
        val mcp = mcp_demand_compile_profile_v1(compatibility_id)
        val lsp = lsp_demand_compile_profile_v1(compatibility_id)

        expect(compiler.cas_namespace).to_equal("host-shared-project-cas-v1")
        expect(tests.cas_namespace).to_equal(compiler.cas_namespace)
        expect(mcp.cas_namespace).to_equal(compiler.cas_namespace)
        expect(lsp.cas_namespace).to_equal(compiler.cas_namespace)

    it "keeps local fallback action authority identical to daemon routing":
        val online = compiler_demand_profile_v1("fixture-compatibility-v1")
        val offline = compiler_demand_profile_v1("fixture-compatibility-v1")

        expect(online.compatibility_id).to_equal(offline.compatibility_id)
        expect(online.cas_namespace).to_equal(offline.cas_namespace)
        expect(online.foreground_priority).to_equal(offline.foreground_priority)
