"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the traceability command
(--log-mode and --progress) as observed through real process invocations
against an empty fixture workspace.
Audience: compiler and tooling engineers who maintain the traceability app
and the shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/traceability_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the traceability command's shared log options only; every scenario
scans the empty fixture directory under /tmp, so the clean-workspace path is
exercised rather than any warning path.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: traceability-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_traceability_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR
    ])

fn _run_traceability(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/traceability/main.spl\" " + joined
    ])

describe "traceability log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-TRACEABILITY-LOGMODE-001
        # @capture(tui_grid): traceability help text listing the shared log options
        step("Run traceability --help in the fixture directory")
        _setup_fixture()
        val (out, err, code) = _run_traceability(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json":
        # @req REQ-TRACEABILITY-LOGMODE-002
        # @capture(protocol_json): traceability scan JSON transcript for the empty workspace
        step("Scan the fixture workspace with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_traceability(["--log-mode=json", "."])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed scan
        expect(out).to_contain("\"warnings\"")

    it "supports dot progress":
        # @req REQ-TRACEABILITY-LOGMODE-003
        # @capture(tui_grid): dot-progress output followed by the clean-workspace line
        step("Scan the fixture workspace with dot progress")
        _setup_fixture()
        val (out, err, code) = _run_traceability(["--progress=dot", "."])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed scan
        expect(out).to_contain(".")
        expect(out).to_contain("traceability: clean")

    it "rejects invalid log mode":
        # @req REQ-TRACEABILITY-LOGMODE-004
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke traceability with an unknown log mode and expect a usage error")
        _setup_fixture()
        val (out, err, code) = _run_traceability(["--log-mode=noisy", "."])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
