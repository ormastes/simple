describe "Doc navigation INDEX.md":

    it "INDEX.md exists in doc/spec":
        step("Verify: INDEX.md exists in doc/spec")
        # @req: REQ-APP-DocNav-001
        val index_exists = file_exists("doc/02_requirements/app/INDEX.md")
        expect(index_exists).to_equal(true)

    it "INDEX.md links to math_render_spec":
        step("Verify: INDEX.md links to math_render_spec")
