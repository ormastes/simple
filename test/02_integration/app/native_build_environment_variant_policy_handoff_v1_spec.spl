use std.spec.*
use std.io_runtime.{file_read}

describe "native-build environment variant policy handoff V1":
    it "wires one policy payload through parent worker and warm identity":
        val parent = file_read("src/app/cli/native_build_main.spl")
        val worker = file_read("src/app/cli/native_build_worker.spl")
        val parse_shard = file_read("src/app/cli/parse_shard_main.spl")
        val compile_targets = file_read("src/app/io/_CliCompile/compile_targets.spl")
        val warm = file_read("src/app/cli/native_build_warm_receipt.spl")
        expect(parent).to_contain("environment_variant_policy_handoff_prepare_v1(args)")
        expect(parent).to_contain("environment_variant_policy_handoff_attach_v1")
        expect(parent).to_contain("for arg in forwarded_args:")
        expect(parent.contains('env_set("SIMPLE_FRONTEND_OFFLOAD"')).to_equal(false)
        expect(parent.contains('env_set("SIMPLE_FRONTEND_OFFLOAD_FALLBACK"')).to_equal(false)
        expect(worker).to_contain("environment_variant_policy_handoff_extract_v1")
        expect(worker).to_contain("cli_native_build_with_environment_variant_policy_v1(")
        expect(worker).to_contain("opened.handoff.collection")
        expect(parse_shard).to_contain("environment_variant_policy_handoff_extract_v1")
        expect(parse_shard).to_contain("val args = opened.user_args")
        expect(parse_shard).to_contain("driver_run_parse_shard_with_environment_variant_policy_v1")
        expect(parse_shard).to_contain("opened.handoff.collection")
        expect(compile_targets).to_contain("cli_native_build_policy_value_flag")
        expect(compile_targets).to_contain("cli_native_build_inline_policy_flag")
        expect(compile_targets).to_contain("compiler_driver_create_with_environment_variant_policy_v1")
        expect(warm).to_contain("environment_variant_policy_identity")
        expect(warm).to_contain('"environment_variant_policy="')

    it "documents the new user policy source without granting admin authority":
        val owner = file_read(
            "src/app/cli/environment_variant_policy_handoff_owner_v1.spl")
        expect(owner).to_contain("/.config/simple/config.sdn")
        expect(owner).to_contain("No authenticated administrator source is defined")
        expect(owner).to_contain("environment_variant_admin_restrictions_empty_v1()")
        expect(owner).to_contain("file_read_regular_no_follow_bounded")
