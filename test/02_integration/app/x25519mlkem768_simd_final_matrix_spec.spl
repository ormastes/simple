"""
## Purpose and audience
Purpose: This spec proves X25519MLKEM768 SIMD final matrix admission.
Audience: Maintainers of the Simple integration suite reviewing this behavior.
"""
# @tag: integration, app, crypto, x25519mlkem768, simd, matrix, security
# @req REQ-003 REQ-013 NFR-009

# This is deliberately a protocol integration test, not a claim of physical
# AVX2 execution.  Its synthetic inputs exercise the fail-closed hand-off:
# an observed receipt stays non-promotable until the common composer validates
# an independently admitted performance receipt and creates the final row.

use std.spec.{describe, it, expect, step}
use std.common.crypto.sha256.{sha256_text}
use app.test.x25519mlkem768_evidence.{X25519MlKem768PinnedSimdObservation}
use app.test.x25519mlkem768_pinned_workload.{
    X25519MlKem768PinnedPublicOutputs,
    X25519_MLKEM768_PINNED_WORKLOAD_SCHEMA,
    X25519_MLKEM768_PINNED_FIXTURE_ID,
    X25519_MLKEM768_PINNED_WORKLOAD_SHA256,
    X25519_MLKEM768_PINNED_ORACLE_ID,
    X25519_MLKEM768_PINNED_PUBLIC_WIRE_BYTES}
use app.test.x25519mlkem768_simd_attested_row.{
    x25519_mlkem768_compose_simd_attested_matrix_row}
use lib.common.crypto.x25519_mlkem768.contract.{
    X25519MlKem768Backend, X25519_MLKEM768_IMPLEMENTATION_VERSION,
    X25519_MLKEM768_PROFILE_VERSION}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend, X25519MlKem768EvidenceStatus,
    X25519MlKem768EvidenceMode, X25519MlKem768EvidenceScope,
    X25519MlKem768RunReceipt}
use lib.common.crypto.x25519_mlkem768.performance_attestation.{
    X25519MlKem768PerformanceAttestation,
    X25519_MLKEM768_PERFORMANCE_ATTESTATION_SCHEMA,
    X25519_MLKEM768_SIMD_MINIMUM_SPEEDUP_MILLI}
use lib.common.crypto.x25519_mlkem768.simd_full_operation_receipt.{
    X25519MlKem768SimdReceiptBinding}
use lib.common.crypto.x25519_mlkem768.matrix_receipt.{
    X25519MlKem768MatrixAdmissionPhase, X25519MlKem768MatrixRow}
use lib.common.crypto.x25519_mlkem768.pinned_public_receipt.{
    X25519MlKem768PinnedSet, X25519MlKem768PinnedSetReceipt,
    X25519_MLKEM768_PINNED_MLKEM_EK_SHA256,
    X25519_MLKEM768_PINNED_MLKEM_CT_SHA256,
    X25519_MLKEM768_PINNED_CLIENT_X25519_SHA256,
    X25519_MLKEM768_PINNED_SERVER_X25519_SHA256,
    X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
    X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256}

val _SOURCE = "a" * 64
val _BINARY = "b" * 64
val _PROVENANCE = "c" * 64
val _CONFIGURATION = "d" * 64
val _RUNNER_ARTIFACT = "8" * 64
val _CRYPTO_SOURCE = "9" * 64

fn _set_a() -> X25519MlKem768PinnedSetReceipt:
    X25519MlKem768PinnedSetReceipt(set_id: X25519MlKem768PinnedSet.MlKem,
        first_output_label: "mlkem768-encapsulation-key", second_output_label: "mlkem768-ciphertext",
        first_output_bytes: 1184, second_output_bytes: 1088, shared_secret_bytes: 32,
        recovered_secret_bytes: 32, first_output_sha256: X25519_MLKEM768_PINNED_MLKEM_EK_SHA256,
        second_output_sha256: X25519_MLKEM768_PINNED_MLKEM_CT_SHA256)

fn _set_b() -> X25519MlKem768PinnedSetReceipt:
    X25519MlKem768PinnedSetReceipt(set_id: X25519MlKem768PinnedSet.X25519,
        first_output_label: "x25519-client-public", second_output_label: "x25519-server-public",
        first_output_bytes: 32, second_output_bytes: 32, shared_secret_bytes: 32,
        recovered_secret_bytes: 32, first_output_sha256: X25519_MLKEM768_PINNED_CLIENT_X25519_SHA256,
        second_output_sha256: X25519_MLKEM768_PINNED_SERVER_X25519_SHA256)

fn _set_c() -> X25519MlKem768PinnedSetReceipt:
    X25519MlKem768PinnedSetReceipt(set_id: X25519MlKem768PinnedSet.Hybrid,
        first_output_label: "x25519mlkem768-client-share", second_output_label: "x25519mlkem768-server-share",
        first_output_bytes: 1216, second_output_bytes: 1120, shared_secret_bytes: 64,
        recovered_secret_bytes: 64, first_output_sha256: X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
        second_output_sha256: X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256)

fn _binding() -> X25519MlKem768SimdReceiptBinding:
    X25519MlKem768SimdReceiptBinding(backend: X25519MlKem768EvidenceBackend.Avx2,
        fixture_id: X25519_MLKEM768_PINNED_FIXTURE_ID, fixture_manifest_sha256: "1" * 64,
        fixture_source_sha256: "2" * 64, pinned_workload_sha256: X25519_MLKEM768_PINNED_WORKLOAD_SHA256,
        runner_source_sha256: "3" * 64, runner_artifact_sha256: _RUNNER_ARTIFACT,
        crypto_source_sha256: _CRYPTO_SOURCE, stage4_source_revision: _SOURCE,
        stage4_binary_sha256: _BINARY, stage4_provenance_sha256: _PROVENANCE,
        measurement_qualification_sha256: "4" * 64, qualified_timing_sha256: "5" * 64,
        matrix_row_set_sha256: "6" * 64, scalar_source_receipt_sha256: "7" * 64,
        candidate_source_receipt_sha256: "0" * 64, scalar_sample_set_sha256: "e" * 64,
        candidate_sample_set_sha256: "f" * 64, host_os: "linux", host_arch: "x86_64",
        session_id: "simd-final-matrix-integration", monotonic_clock_id: "monotonic-raw-nanoseconds",
        expected_keygen_digest: sha256_text("4" * 64), expected_encapsulate_digest: sha256_text("5" * 64),
        expected_decapsulate_digest: sha256_text("5" * 64), rvv_minimum_vlen_bits: 0, batch_size: 1)

fn _performance() -> X25519MlKem768PerformanceAttestation:
    X25519MlKem768PerformanceAttestation(schema: X25519_MLKEM768_PERFORMANCE_ATTESTATION_SCHEMA,
        status: X25519MlKem768EvidenceStatus.Pass, reason: "native-full-operation-performance-admitted",
        candidate_backend: X25519MlKem768EvidenceBackend.Avx2, backend_identity: "cpu:avx2-native-device",
        speedup_milli: X25519_MLKEM768_SIMD_MINIMUM_SPEEDUP_MILLI,
        minimum_speedup_milli: X25519_MLKEM768_SIMD_MINIMUM_SPEEDUP_MILLI,
        receipt_sha256: "a" * 64, qualification_sha256: "4" * 64, qualified_timing_sha256: "5" * 64,
        matrix_row_set_sha256: "6" * 64, scalar_source_receipt_sha256: "7" * 64,
        candidate_source_receipt_sha256: "0" * 64, scalar_sample_set_sha256: "e" * 64,
        candidate_sample_set_sha256: "f" * 64, host_os: "linux", host_arch: "x86_64",
        session_id: "simd-final-matrix-integration", monotonic_clock_id: "monotonic-raw-nanoseconds",
        implementation_version: X25519_MLKEM768_IMPLEMENTATION_VERSION,
        profile_version: X25519_MLKEM768_PROFILE_VERSION, fixture_id: X25519_MLKEM768_PINNED_FIXTURE_ID,
        fixture_manifest_sha256: "1" * 64, fixture_source_sha256: "2" * 64,
        workload_configuration_sha256: "c" * 64, backend_configuration_sha256: _CONFIGURATION,
        compiler_artifact_sha256: _BINARY, compiler_provenance_sha256: _PROVENANCE,
        compiler_source_revision: _SOURCE, runner_source_sha256: "3" * 64,
        runner_artifact_sha256: _RUNNER_ARTIFACT, crypto_source_sha256: _CRYPTO_SOURCE,
        accelerator_source_sha256: "", accelerator_artifact_sha256: "",
        accelerator_build_binding_sha256: "", batch_size: 1)

fn _observation() -> X25519MlKem768PinnedSimdObservation:
    val set_a = _set_a()
    val set_b = _set_b()
    val set_c = _set_c()
    val raw = X25519MlKem768RunReceipt(schema: "x25519mlkem768-evidence-v1",
        status: X25519MlKem768EvidenceStatus.Pass, reason: "raw-native-avx2-observed",
        scope: X25519MlKem768EvidenceScope.FullOperation, requested_backend: X25519MlKem768EvidenceBackend.Avx2,
        selected_backend: Some(X25519MlKem768EvidenceBackend.Avx2), mode: X25519MlKem768EvidenceMode.Native,
        emulated: false, promotion_eligible: false, implementation_version: X25519_MLKEM768_IMPLEMENTATION_VERSION,
        profile_version: X25519_MLKEM768_PROFILE_VERSION, fixture_id: X25519_MLKEM768_PINNED_FIXTURE_ID,
        fixture_manifest_sha256: "1" * 64, fixture_source_sha256: "2" * 64,
        pinned_workload_sha256: X25519_MLKEM768_PINNED_WORKLOAD_SHA256, runner_source_sha256: "3" * 64,
        batch_size: 1, client_share_bytes: 1216, server_share_bytes: 1120, shared_secret_bytes: 64,
        keygen_output_digest: "4" * 64, encapsulate_output_digest: "5" * 64, decapsulate_output_digest: "5" * 64,
        scalar_roundtrip_match: true, fallback_used: false, absolute_oracle_match: true, simd_chunk_hits: 3,
        observed_rvv_vlen_bits: 0, kernel_invocations: 0, compiled: false, submitted: false,
        fence_completed: false, device_readback: false, artifact_sha256: _BINARY,
        device_identity: "cpu:avx2-native-device")
    val outputs = X25519MlKem768PinnedPublicOutputs(schema: X25519_MLKEM768_PINNED_WORKLOAD_SCHEMA,
        fixture_id: X25519_MLKEM768_PINNED_FIXTURE_ID, workload_sha256: X25519_MLKEM768_PINNED_WORKLOAD_SHA256,
        oracle_id: X25519_MLKEM768_PINNED_ORACLE_ID, set_a: set_a, set_b: set_b, set_c: set_c,
        client_share_bytes: 1216, server_share_bytes: 1120, shared_secret_bytes: 64,
        public_wire_bytes: X25519_MLKEM768_PINNED_PUBLIC_WIRE_BYTES, total_observed_bytes: 3456,
        client_share_sha256: X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
        server_share_sha256: X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256, keygen_output_digest: "4" * 64,
        encapsulate_output_digest: "5" * 64, decapsulate_output_digest: "5" * 64,
        requested_backend: X25519MlKem768Backend.Avx2, selected_backend: X25519MlKem768Backend.Avx2,
        executor_identity: "native-avx2-candidate", artifact_digest: _BINARY, execution_proof_digest: _BINARY,
        fallback_used: false, candidate_oracle_match: true, accelerated_operation_count: 3,
        kernel_invocations: 0, simd_chunk_hits: 3, observed_rvv_vlen_bits: 0, compiled: false,
        submitted: false, fence_completed: false, device_readback: false)
    X25519MlKem768PinnedSimdObservation(raw_receipt: raw, public_outputs: outputs,
        set_a: set_a, set_b: set_b, set_c: set_c,
        client_share_sha256: X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
        server_share_sha256: X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256)

describe "X25519MLKEM768 SIMD final matrix admission":
    it "creates one executed AVX2 matrix row only after common attestation":
        # @req: REQ-003
        # @req: REQ-013
        step("Keep the runner observation raw and non-promotable")
        val observation = _observation()
        expect(observation.raw_receipt.promotion_eligible).to_be(false)
        step("Compose the single final matrix row through the common attestation boundary")
        val result = x25519_mlkem768_compose_simd_attested_matrix_row(
            _binding(), observation, _performance())
        expect(result.is_ok()).to_be(true)
        val row = result.unwrap()
        expect(row.admission_phase).to_equal(X25519MlKem768MatrixAdmissionPhase.Executed)
        expect(row.execution.promotion_eligible).to_be(true)
        expect(row.execution.requested_backend).to_equal(X25519MlKem768EvidenceBackend.Avx2)
        expect(row.host_arch).to_equal("x86_64")

    it "rejects an observation that claims raw promotion":
        step("Reject promotion before the common attestation composer")
        var observation = _observation()
        observation.raw_receipt.promotion_eligible = true
        val result = x25519_mlkem768_compose_simd_attested_matrix_row(
            _binding(), observation, _performance())
        expect(result.is_err()).to_be(true)
        expect(result.unwrap_err()).to_equal("avx2-public-observation-invalid")
