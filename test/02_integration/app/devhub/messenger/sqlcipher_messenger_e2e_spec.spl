# End-to-end integration spec — SQLCipher-4 messenger fixture -> server
# format=sqlcipher4 open path -> DevHub messenger history (integration lane,
# master plan §21.8 acceptance).
#
# Chain under test:
#   test/fixtures/database/sqlcipher4/messenger.sqlcipher4
#     (generated by gen_sqlcipher4_fixture.py; python sqlite3 oracle-opens
#     both the plaintext image and the decrypted file, see the generator)
#   -> std.database.server.storage_port: open(path, "sqlcipher4", SecretRef)
#      (cipher-b key session + cipher-c page codec, per-page HMAC before any
#      plaintext, sqlite_format pager over the decoded snapshot)
#   -> app.devhub.messenger.adapter.sqlcipher_reader: history verb
#      (policy gates -> schema-profile identifiers -> rendered JSON payload)
#
# Assertions are against REAL DECODED CONTENT (message bodies incl. a UTF-8
# probe string), never placeholders. Wrong-passphrase, agent-policy, and
# read-only-send denials are asserted as typed denials. Verb coverage for
# list_rooms/list_members/fetch_message runs against the plaintext fixture
# through the sqlite3 adapter (identical db_common code path, no cipher
# cost; the sqlcipher4 decode leg is fully exercised by history here and by
# the storage-port unit spec).
#
# @timeout_secs 1800 (interpreted-mode AES suites are slow; the directive is an
# honest runtime record, not a relaxed gate)
# @req: REQ-MSGR-E2E-001 — SQLCipher-4 messenger DB opens through the
#       server storage port and serves DevHub history read-only.

"""
## Purpose and audience
Purpose: Acceptance chain for the SQLCipher/SQLite/DevHub integration:
fixture DB -> server open path -> DevHub history, read-only throughout.
Audience: release integration reviewers.
"""

use std.spec.*
use app.devhub.messenger.config.{
    MessengerTarget, MessengerDbConfig, MessengerPolicy, SchemaProfile
}
use app.devhub.messenger.plugin_access.{
    messenger_load_adapter, messenger_reset_adapters, port_call_read, port_call_send,
    MESSENGER_PORT_OK, MESSENGER_PORT_PERMISSION_DENIED, MESSENGER_PORT_CONFIG_ERROR,
    MESSENGER_READ_PORT_ABI
}
use app.devhub.messenger.adapter.sqlcipher_reader.{
    messenger_register_sqlcipher4_adapter, messenger_sqlcipher4_history
}
use app.devhub.messenger.adapter.sqlite_reader.{
    messenger_register_sqlite3_adapter, messenger_sqlite3_list_rooms,
    messenger_sqlite3_list_members, messenger_sqlite3_fetch_message
}
use std.nogc_sync_mut.io.env_ops.{env_set}

val ENC_FIXTURE: text = "test/fixtures/database/sqlcipher4/messenger.sqlcipher4"
val PLAIN_FIXTURE: text = "test/fixtures/database/sqlcipher4/messenger_plain.sqlite"
val ENC_SECRET_REF: text = "secret://messenger/fixture"
val ENC_ENV_VAR: text = "SIMPLE_SECRET_MESSENGER_FIXTURE"
val FIXTURE_PASSPHRASE: text = "messenger-fixture-passphrase"

fn _schema() -> SchemaProfile:
    SchemaProfile(
        profile_id: "messenger.schema_profile.v1",
        room_table: "room",
        room_id: "id",
        room_name: "title",
        room_created_at: "created_at",
        member_table: "room_member",
        member_room_id: "room_id",
        member_identity_id: "user_id",
        member_joined_at: "joined_at",
        member_left_at: "left_at",
        member_role: "role",
        message_table: "messages",
        message_id: "id",
        message_room_id: "room_id",
        message_sender_id: "sender_id",
        message_body: "body",
        message_created_at: "created_at",
        message_updated_at: "updated_at",
        message_sequence: "seq",
        message_reply_to_id: "reply_to_id",
        timestamp_unit: "s",
        sequence_kind: "monotonic_within_room")

fn _db(format_name: text, path: text) -> MessengerDbConfig:
    MessengerDbConfig(
        path: path,
        format: format_name,
        access: "read_only",
        snapshot_mode: "consistent_live",
        profile: "sqlcipher4_4k_sha512",
        key_kind: "passphrase",
        secret_ref: ENC_SECRET_REF,
        cipher_page_size: 4096,
        cipher_kdf_iter: 256000,
        cipher_kdf_algorithm: "pbkdf2_hmac_sha512",
        cipher_hmac_algorithm: "hmac_sha512",
        cipher_page_hmac: true,
        cipher_hmac_pgno: "little_endian",
        cipher_reserved_bytes: 80,
        cipher_plaintext_header_bytes: 0,
        immutable: false)

fn _target(name: text, expose_bodies: bool) -> MessengerTarget:
    var policy = MessengerPolicy.deny_all()
    policy.expose_message_body_to_agents = expose_bodies
    MessengerTarget(
        name: name,
        read_provider: "sqlcipher4_database",
        send_provider: "none",
        send_enabled: false,
        source_kind: "external_owned_by_messenger",
        schema_profile_name: "messenger.schema_profile.v1",
        content_pipeline: "none",
        cache_mode: "none",
        sync_policy: "on_demand",
        db: _db("sqlcipher4", ENC_FIXTURE),
        api: nil,
        schema: _schema(),
        policy: policy)

fn _sqlite_target() -> MessengerTarget:
    var t = _target("sqlite-fixture", true)
    t.read_provider = "sqlite3_database"
    t.db = _db("sqlite3", PLAIN_FIXTURE)
    t

# --- outcome helpers ---------------------------------------------------------

fn _load_sqlcipher_adapter_summary() -> text:
    messenger_reset_adapters()
    val _reg = messenger_register_sqlcipher4_adapter()
    if val port = messenger_load_adapter("sqlcipher4_database"):
        "{port.provider_id}|{port.semantic_version}|{port.read_only}|{port.unavailable_reason}|{port.capabilities.len()}"
    else:
        "nil"

fn _history_payload(target: MessengerTarget, room: text, limit: i64, actor_kind: text) -> text:
    val r = messenger_sqlcipher4_history(target, room, limit, actor_kind)
    if r.status == MESSENGER_PORT_OK:
        r.payload
    else:
        "STATUS:{r.status}:{r.exit_code}:{r.error}"

fn _gate_status(target: MessengerTarget, op: text, actor_kind: text) -> text:
    messenger_reset_adapters()
    val _reg = messenger_register_sqlcipher4_adapter()
    if val port = messenger_load_adapter("sqlcipher4_database"):
        val result = port_call_read(port, target, op, actor_kind)
        "{result.status}:{result.exit_code}"
    else:
        "no-adapter"

fn _send_status(target: MessengerTarget) -> text:
    messenger_reset_adapters()
    val _reg = messenger_register_sqlcipher4_adapter()
    if val port = messenger_load_adapter("sqlcipher4_database"):
        val result = port_call_send(port, target)
        "{result.status}:{result.exit_code}"
    else:
        "no-adapter"

fn _sqlite_rooms() -> text:
    messenger_reset_adapters()
    val _reg = messenger_register_sqlite3_adapter()
    val r = messenger_sqlite3_list_rooms(_sqlite_target(), "user")
    if r.status == MESSENGER_PORT_OK:
        r.payload
    else:
        "STATUS:{r.status}:{r.exit_code}:{r.error}"

fn _sqlite_members(room: text) -> text:
    messenger_reset_adapters()
    val _reg = messenger_register_sqlite3_adapter()
    val r = messenger_sqlite3_list_members(_sqlite_target(), room, "user")
    if r.status == MESSENGER_PORT_OK:
        r.payload
    else:
        "STATUS:{r.status}:{r.exit_code}:{r.error}"

fn _sqlite_fetch(message_id: text) -> text:
    messenger_reset_adapters()
    val _reg = messenger_register_sqlite3_adapter()
    val r = messenger_sqlite3_fetch_message(_sqlite_target(), message_id, "user")
    if r.status == MESSENGER_PORT_OK:
        r.payload
    else:
        "STATUS:{r.status}:{r.exit_code}:{r.error}"

fn _wrong_key_outcome() -> text:
    val _ = env_set(ENC_ENV_VAR, "definitely-the-wrong-passphrase")
    val outcome = _history_payload(_target("enc", true), "1", 10, "user")
    val _restore = env_set(ENC_ENV_VAR, FIXTURE_PASSPHRASE)
    outcome

describe "sqlcipher4 adapter registration and gates":
    it "command-time registration serves the real read-only adapter through the lazy seam":
        step("register, then messenger_load_adapter('sqlcipher4_database')")
        expect(_load_sqlcipher_adapter_summary()).to_equal(
            "messenger.sqlcipher4_database|1.0.0|true||4")

    it "the port gate admits history for the interactive user":
        step("port_call_read history user")
        expect(_gate_status(_target("enc", false), "history", "user")).to_equal("ok:0")

    it "an agent without the body grant is denied message bodies (§12.2 default deny)":
        step("port_call_read history agent, expose_message_body_to_agents=false")
        expect(_gate_status(_target("enc", false), "history", "agent")).to_equal(
            "permission_denied:3")

    it "send through the read port is a typed permission denial (read-only source, §6.8)":
        step("port_call_send on the sqlcipher4 target")
        expect(_send_status(_target("enc", false))).to_equal("permission_denied:3")

describe "end-to-end: fixture DB -> server open path -> DevHub history":
    it "history decodes real content through the storage port (room 1)":
        step("set env, messenger_sqlcipher4_history(room=1)")
        val _ = env_set(ENC_ENV_VAR, FIXTURE_PASSPHRASE)
        val payload = _history_payload(_target("enc", true), "1", 10, "user")
        expect(payload.contains("\"count\":3")).to_equal(true)
        expect(payload.contains("hello world")).to_equal(true)
        expect(payload.contains("hi there")).to_equal(true)
        expect(payload.contains("unicode: héllo wörld ✓")).to_equal(true)
        expect(payload.contains("1700000003")).to_equal(true)
        expect(payload.contains(FIXTURE_PASSPHRASE)).to_equal(false)

    it "history for room 2 decodes the second room's message":
        step("messenger_sqlcipher4_history(room=2)")
        val _ = env_set(ENC_ENV_VAR, FIXTURE_PASSPHRASE)
        val payload = _history_payload(_target("enc", true), "2", 10, "user")
        expect(payload.contains("second room says hi")).to_equal(true)
        expect(payload.contains("\"count\":1")).to_equal(true)

    it "a wrong passphrase is a config error with no plaintext released":
        step("env = wrong passphrase, history")
        val outcome = _wrong_key_outcome()
        expect(outcome.starts_with("STATUS:config_error:2")).to_equal(true)
        expect(outcome.contains("hello world")).to_equal(false)

describe "verb coverage over the plaintext fixture (sqlite3 adapter, same core)":
    it "list_rooms renders both rooms":
        step("messenger_sqlite3_list_rooms")
        val payload = _sqlite_rooms()
        expect(payload.contains("general")).to_equal(true)
        expect(payload.contains("random")).to_equal(true)
        expect(payload.contains("\"count\":2")).to_equal(true)

    it "list_members filters by room":
        step("messenger_sqlite3_list_members(room=1)")
        val payload = _sqlite_members("1")
        expect(payload.contains("\"count\":2")).to_equal(true)
        expect(payload.contains("101")).to_equal(true)
        expect(payload.contains("102")).to_equal(true)

    it "fetch_message returns the message body; a missing id is found:false":
        step("messenger_sqlite3_fetch_message 2 / 999")
        expect(_sqlite_fetch("2").contains("hi there")).to_equal(true)
        expect(_sqlite_fetch("999").contains("\"found\":false")).to_equal(true)
