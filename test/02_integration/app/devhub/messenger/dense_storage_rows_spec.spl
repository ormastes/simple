# Integration layer, I/O and crypto: the dense encrypted database opened ONCE
# through the server storage port, then every table read against ground truth.
#
# The Phase 1 seed decrypts a page in about 45 s, so a full open is the whole
# budget of this file: the open happens once at load, and every scenario below
# reads the same opened view.  Expected rows come from Python's sqlite3 over the
# plaintext image (dense_ground_truth.json), never from the code under test.
# Lifecycle: doc/01_research/app/tools/devhub/devhub_cli_wrapper_forwarding_2026-09-06.md ;
# doc/03_plan/agent_tasks/devhub_messenger_master.md ;
# doc/04_architecture/app/devhub/messenger_gateway.md ;
# doc/05_design/app/devhub/messenger_sdn_and_api.md
# @manual_section: storage-port-exact-rows

"""
## Purpose and audience
Purpose: prove that opening the dense encrypted database through the storage
port yields exactly the geometry, page structure, rows and cells the generator
recorded for all three tables, including the multi-page message table, equal
sequence values, Unicode and escaped text, NULL cells and the overflow body.
Audience: reviewers of the encrypted read path who need the exact content proven
before the DevHub system test runs.
The passphrase is public synthetic test data from dense_ground_truth.json.
"""

use std.spec.*
use test.support.devhub_messenger_dense.*
use std.common.json.value.{JsonValue, json_value_field}
use std.database.server.storage_port.{database_storage_port_v1, DatabaseStoragePortV1, StorageReadView}
use std.database.sql.types.{DbRow}

val truth = dense_truth()
val _secret_ready = dense_set_secret(truth_passphrase(truth))
val dn_base_path = dense_path(DENSE_BASE)
val dn_sha_before = dense_file_sha256(DENSE_BASE)
val dn_view: StorageReadView? = dense_open_view(dn_base_path)
val dn_port: DatabaseStoragePortV1 = database_storage_port_v1()

fn read_rows(table: text) -> [DbRow]:
    if dn_view == nil:
        return []
    match dn_port.read_table(dn_view.?, table):
        case Ok(rows): rows
        case Err(_): []

val dn_room_rows: [DbRow] = read_rows("room")
val dn_member_rows: [DbRow] = read_rows("room_member")
val dn_message_rows: [DbRow] = read_rows("messages")

fn tables() -> JsonValue:
    json_value_field(truth, "tables")

describe "geometry and page structure":
    it "opens with the page geometry and text encoding the generator wrote":
        # @req REQ-MSGR-DENSE-ROWS-001
        step("Open the dense database once and read the view geometry")
        # @capture(statistics): page_size, page_count, reserved_bytes and text_encoding of the dn_view view
        expect(dn_view == nil).to_equal(false)
        val view = dn_view.?
        expect(view.page_size).to_equal(tn(truth, "page_size"))
        expect(view.page_count).to_equal(tn(truth, "page_count"))
        expect(view.reserved_bytes).to_equal(tn(truth, "reserved_bytes"))
        expect(view.text_encoding).to_equal(tn(truth, "text_encoding"))
        expect(view.image.len()).to_equal(tn(truth, "file_bytes"))

    it "decrypts every one of the nine pages to the structure the generator wrote":
        # @req REQ-MSGR-DENSE-ROWS-002
        step("Compare the first byte of every decrypted page with the generator's page kinds")
        # @capture(bit_table): first byte of each of the nine decrypted pages against the ground truth
        val view = dn_view.?
        val pages = tn(truth, "page_count")
        var seen = ""
        var checked = 0
        var page = 1
        while page <= pages:
            checked = checked + 1
            val got = view.image[(page - 1) * view.page_size].to_i64()
            val want = list_int(truth, "page_first_bytes", page - 1)
            if got != want:
                seen = seen + "page{page}:{got}!={want};"
            page = page + 1
        expect("checked={checked} bad={seen}").to_equal("checked={pages} bad=")

describe "exact rows and cells of every table":
    it "reads the room table exactly":
        # @req REQ-MSGR-DENSE-ROWS-003
        step("Read table room and compare columns, rows and cells with ground truth")
        # @capture(statistics): row count, cell count and mismatches for table room
        val want = json_value_field(tables(), "room")
        expect(column_names(dn_room_rows)).to_equal(truth_columns(want))
        expect(table_diff(dn_room_rows, want)).to_equal("rows={rows_in(want)} cells={rows_in(want) * cols_in(want)} bad=")

    it "reads the room_member table exactly":
        # @req REQ-MSGR-DENSE-ROWS-004
        step("Read table room_member and compare columns, rows and cells with ground truth")
        # @capture(statistics): row count, cell count and mismatches for table room_member
        val want = json_value_field(tables(), "room_member")
        expect(column_names(dn_member_rows)).to_equal(truth_columns(want))
        expect(table_diff(dn_member_rows, want)).to_equal("rows={rows_in(want)} cells={rows_in(want) * cols_in(want)} bad=")

    it "reads the multi-page message table exactly, NULL cells and Unicode included":
        # @req REQ-MSGR-DENSE-ROWS-005
        step("Read table messages across its interior page and leaf pages")
        # @capture(statistics): row count, cell count and mismatches for table messages
        val want = json_value_field(tables(), "messages")
        expect(column_names(dn_message_rows)).to_equal(truth_columns(want))
        # every cell except the one overflow body, which the next scenario checks
        expect(table_diff(dn_message_rows, want)).to_equal("rows={rows_in(want)} cells={rows_in(want) * cols_in(want) - 1} bad=")

    it "reads the overflow body through its page chain byte for byte":
        # @req REQ-MSGR-DENSE-ROWS-006
        step("Rebuild the overflow body from the generator's head and repeat unit")
        # @capture(protocol_binary): the 11,000+ byte body read through the overflow chain against its reconstruction
        val overflow = json_value_field(truth, "overflow")
        val want_body = expected_overflow_body(overflow)
        val got_body = dn_message_rows[4].values[3].to_text()
        expect(got_body == want_body).to_equal(true)
        expect(got_body.len() > 11000).to_equal(true)

describe "adverse reads on the dn_view view":
    it "rejects a read of a table that does not exist":
        # @req REQ-MSGR-DENSE-ROWS-007
        step("Read a table name absent from the schema")
        # @capture(protocol_json): storage-dn_port error code for the unknown table
        val view = dn_view.?
        val code = match dn_port.read_table(view, "no_such_table"):
            case Ok(rows): "OK:{rows.len()}"
            case Err(problem): problem.code()
        expect(code.starts_with("STORAGE_PORT_")).to_equal(true)
        expect(code.starts_with("OK")).to_equal(false)

    it "leaves the encrypted source byte-identical after the open":
        # @req REQ-MSGR-DENSE-ROWS-008
        step("Compare the file hash before and after the open with the generator's hashlib digest")
        # @capture(statistics): sha256 before and after against the ground-truth digest
        val expected = tf(json_value_field(json_value_field(truth, "files"), DENSE_BASE), "sha256")
        expect(dn_sha_before).to_equal(expected)
        expect(dense_file_sha256(DENSE_BASE)).to_equal(expected)
