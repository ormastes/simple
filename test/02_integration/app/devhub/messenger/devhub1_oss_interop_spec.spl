describe "REQ-INTEROP-NEG: the oracle fails closed on Simple-produced tampering":
    # @req REQ-INTEROP-NEG
    it "a flipped ciphertext byte in a Simple-encoded page fails the oracle HMAC":
        if interop_crypto_available():
            run_neg_tamper()
        else:
            skip("neg", "external crypto library unavailable; leg skipped per T0 gate ({interop_crypto_gate_report()})")

