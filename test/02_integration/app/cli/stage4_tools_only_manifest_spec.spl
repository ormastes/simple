use std.spec
use std.io_runtime.{file_read}

describe "Stage4 tools-only wrapper fail-closed contract":
    it "should bind admitted Stage3, canonical journal, and atomic publication":
        step("Inspect the Stage4 admission, journal, and publication contract")
        val source = file_read("scripts/bootstrap/stage4-tools-only.sh")
        expect(source).to_contain("Stage3AdmissionReceiptV1")
        expect(source).to_contain("ToolCompileJournalV1")
        expect(source).to_contain("compiler_manifest_hash")
        expect(source).to_contain("compiler_sources_compiled")
        expect(source).to_contain('mv "$stage" "$publish"')
        expect(source).to_contain('"$stage/simple" --help')
        expect(source).to_contain('"$stage/simple" --version')

    it "should reject compiler traversal and unsafe cache/publish paths":
        step("Inspect the fail-closed source and filesystem boundaries")
        val source = file_read("scripts/bootstrap/stage4-tools-only.sh")
        expect(source).to_contain("build/mini_cache_stage4_")
        expect(source).to_contain("build/stage4-tools/")
        expect(source).to_contain("src/compiler/*")
        expect(source).to_contain("duplicate source")
        expect(source).to_contain("duplicate object")
