use std.spec
use std.io_runtime.{file_read}

describe "Stage4 tools-only matrix contract":
    it "should bind tools to admitted Stage3 journals without rebuilding the compiler":
        step("Inspect the folded tools-only linker admission contract")
        val source = file_read("scripts/bootstrap/bootstrap-from-scratch.sh")
        expect(source).to_contain("bootstrap_folded_stage4_tools_only")
        expect(source).to_contain("Stage3AdmissionReceiptV1")
        expect(source).to_contain("ToolCompileJournalV1")
        expect(source).to_contain("compiler_sources_compiled=0")
        expect(source).to_contain("stage4_compiler_files=0")

    it "should require compiler, MCP, and LSP sanity evidence before admission":
        step("Inspect the durable Stage4 tooling matrix")
        val source = file_read("scripts/bootstrap/bootstrap-from-scratch.sh")
        expect(source).to_contain("compiler_full_tests")
        expect(source).to_contain("mcp_stdio_integration")
        expect(source).to_contain("lsp_stdio_integration")
        expect(source).to_contain("mcp_native_smoke")
        expect(source).to_contain("mcp_native_smoke,mcp_focused,mcp_unit_tests")
        expect(source).to_contain("mcp_native_smoke,lsp_unit_tests,lsp_log_modes_tests")
