"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the plugin command (--log-mode
and --progress) as observed through real process invocations against an empty
plugin manifest.
Audience: compiler and tooling engineers who maintain the plugin app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/plugin_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the plugin command's shared log options only; every scenario runs
against an empty plugin list produced by pointing SIMPLE_PLUGIN_MANIFEST at a
manifest that does not exist, so no real plugin is ever registered.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: plugin-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_MANIFEST = "/tmp/simple-plugin-log-modes/missing-manifest.sdn"

fn _run_plugin(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "rm -rf /tmp/simple-plugin-log-modes && mkdir -p /tmp/simple-plugin-log-modes && REPO=$(pwd); SIMPLE_PLUGIN_MANIFEST=\"" + FIXTURE_MANIFEST + "\" SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/plugin/main.spl\" " + joined
    ])

describe "plugin log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-PLUGIN-LOGMODE-001
        # @capture(tui_grid): plugin help text listing the shared log options
        step("Run plugin --help with the empty manifest environment")
        val (out, err, code) = _run_plugin(["plugin", "--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json for empty plugin list":
        # @req REQ-PLUGIN-LOGMODE-002
        # @capture(protocol_json): plugin list JSON transcript for the empty manifest
        step("List plugins with log-mode json over the empty manifest")
        val (out, err, code) = _run_plugin(["plugin", "--log-mode=json", "list"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed plugin list
        expect(out).to_contain("\"command\":\"plugin list\"")
        expect(out).to_contain("\"status\":\"ok\"")
        expect(out).to_contain("\"count\":0")

    it "supports dot progress for empty plugin list":
        # @req REQ-PLUGIN-LOGMODE-003
        # @capture(tui_grid): dot-progress output followed by the empty-list notice
        step("List plugins with dot progress over the empty manifest")
        val (out, err, code) = _run_plugin(["plugin", "--progress=dot", "list"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed plugin list
        expect(out).to_start_with(".")
        expect(out).to_contain("no plugins registered")

    it "rejects invalid log mode":
        # @req REQ-PLUGIN-LOGMODE-004
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke plugin with an unknown log mode and expect a usage error")
        val (out, err, code) = _run_plugin(["plugin", "--log-mode=noisy", "list"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
