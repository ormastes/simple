# Native compilation must resolve each protocol module's explicit helper imports.
# Run through the existing --native-backend test route; source scans are not execution.
use std.spec
use app.mcp.main_lazy_protocol.{handle_completion_req, handle_resources_read}
use app.simple_lsp_mcp.tools.{handle_resource_read}

describe "MCP native protocol helper imports":
    it "serializes completion values and their count":
        val result = handle_completion_req("7", "{\"name\":\"mode\"}")
        expect(result).to_equal("{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":{\"completion\":{\"values\":[\"over\",\"in\",\"out\"],\"total\":3,\"hasMore\":false}}}")

    it "builds the four-field debug status resource":
        val result = handle_resources_read("8", "debuglog:///status")
        expect(result).to_contain("debuglog:///status")
        expect(result).to_contain("application/json")
        expect(result).to_contain("entry_count")
        expect(result).to_contain("stack_depth")

    it "rejects an unsupported LSP resource URI":
        val result = handle_resource_read("9", "{\"uri\":\"file:///missing.spl\"}")
        expect(result).to_equal("{\"jsonrpc\":\"2.0\",\"id\":9,\"error\":{\"code\":-32002,\"message\":\"Resource not found\"}}")
