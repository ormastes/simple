use std.spec.{describe, it, expect}
use app.debug_doctor.main.{debug_doctor_registry}
use std.debug_doctor.matrix.{host_row, row_can_debug}

describe "debug doctor host capability integration":
    it "reports the landed host DebugTarget instead of a pending source marker":
        val fixture = "test/fixtures/dap/host_debug_target_program.spl"
        val registry = debug_doctor_registry(fixture)
        val row = host_row(registry, fixture)
        expect(row_can_debug(row)).to_equal(true)
        expect(row.debug_detail).to_equal("line")

    it "does not fabricate host verification without a reachable program":
        val registry = debug_doctor_registry("")
        val row = host_row(registry, "")
        expect(row_can_debug(row)).to_equal(false)
        expect(row.debug_detail).to_contain("not live-verified")
