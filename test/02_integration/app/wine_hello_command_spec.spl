use std.common.spec.evidence.untyped_capture.{UntypedCapture, untyped_capture_to_canonical}
use std.common.spec.evidence.model.{EvidenceStatus, oracle_spec, check_exact}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

describe "Wine hello command":
    it "runs the known hello.exe milestone app with modeled stdout and exit code":
        val (stdout, stderr, code) = rt_process_run("bin/simple", ["run", "src/app/wine_hello/main.spl"])
        expect(code).to_equal(0)
        expect(stdout).to_equal("Hello from SimpleOS Wine\n")
        expect(stderr).to_equal("")

        val capture = UntypedCapture(label: "wine-hello-stdout", raw_value: stdout, source_kind: "stdout")
        val evidence = untyped_capture_to_canonical(capture, "wine_hello_command_spec/wine-hello-stdout")
        val comparison = compare_evidence(evidence, oracle_spec("wine_hello_command_spec/wine-hello-stdout", [
            check_exact("value", "Hello from SimpleOS Wine\n")
        ]))
        expect(comparison.status).to_equal(EvidenceStatus.passed)
