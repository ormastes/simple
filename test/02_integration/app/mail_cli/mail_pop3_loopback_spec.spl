# @tag:in-development
# @req REQ-001 REQ-003 REQ-006
# Real curl + production Bash mail client against a pure-Simple implicit-TLS POP3
# loopback server (test/01_unit/tools/mail_cli/fixtures/loopback_pop3_server.spl).
# Requires MAIL_CONFIG_BIN (compiled SDN helper); a missing helper fails, never skips.
# The STLS upgrade scenarios remain blocked: see
# doc/08_tracking/todo/mail_pop3_loopback_tls_server_2026-11-14.md
use std.spec.*
use std.spec.step
use std.process.{run}

val PROBE = "test/01_unit/tools/mail_cli/fixtures/loopback_pop3_probe.shs"

describe "Mail POP3 interoperability through actual curl over implicit TLS":
    it "should pass every implicit-TLS loopback scenario against the Simple POP3 server":
        step("Start the Simple TLS POP3 server on a loopback port and drive the production client")
        val result = run("bash", [PROBE])
        step("Check each scenario verdict emitted by the probe")
        expect(result.exit_code).to_equal(0)

    it "should list the scripted mailbox and retrieve without mutating it":
        val result = run("bash", [PROBE])
        expect(result.stdout).to_contain("actual_curl_tls_pop3_list: PASS")
        expect(result.stdout).to_contain("actual_curl_tls_pop3_retrieve_without_mutation: PASS")

    it "should unstuff dot-stuffed lines and handle an empty mailbox":
        val result = run("bash", [PROBE])
        expect(result.stdout).to_contain("actual_curl_pop3_dot_unstuffing: PASS")
        expect(result.stdout).to_contain("actual_curl_pop3_empty_mailbox: PASS")

    it "should propagate a LIST error and reject a truncated message":
        val result = run("bash", [PROBE])
        expect(result.stdout).to_contain("actual_curl_pop3_list_error_propagated: PASS")
        expect(result.stdout).to_contain("actual_curl_pop3_truncated_message_rejected: PASS")

    it "should send a rejected password once and reject an untrusted certificate":
        val result = run("bash", [PROBE])
        expect(result.stdout).to_contain("actual_curl_authentication_rejected_once: PASS")
        expect(result.stdout).to_contain("actual_curl_untrusted_certificate_rejected: PASS")

    it "should upgrade with STLS before credentials and send none when STLS fails":
        fail("BLOCKED mail-pop3-loopback-stls: no Simple TLS server mid-stream STLS upgrade; see doc/08_tracking/todo/mail_pop3_loopback_tls_server_2026-11-14.md")
