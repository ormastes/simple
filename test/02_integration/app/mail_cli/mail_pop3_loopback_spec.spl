# codex-system-test
# @req REQ-001 REQ-003 REQ-006
"""
Local TLS POP3 interoperability with actual curl and the production Bash client.
Requires Python 3, openssl, curl, jq, Bash, and Linux CA trust bundle.
Creates only synthetic accounts, a disposable certificate, and a loopback server.
**Protocol evidence:** build/test-artifacts/mail_pop3_credentials/loopback_tls.txt
"""
use std.spec.*
use std.spec.step
use std.process.{run}

describe "Mail POP3 interoperability through actual curl":
    it "should list and retrieve through trusted TLS and reject authentication and certificate failures":
        step("Start a disposable loopback TLS POP3 server with an ephemeral certificate")
        val result = run("python3", ["test/01_unit/tools/mail_cli/fixtures/loopback_pop3_probe.py"])
        step("Check actual curl LIST and RETR without server-side mutations")
        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_contain("actual_curl_tls_pop3_list: PASS")
        expect(result.stdout).to_contain("actual_curl_tls_pop3_retrieve_without_mutation: PASS")
        step("Check bounded wrong-password handling and mandatory certificate verification")
        expect(result.stdout).to_contain("actual_curl_authentication_rejected_once: PASS")
        expect(result.stdout).to_contain("actual_curl_untrusted_certificate_rejected: PASS")
