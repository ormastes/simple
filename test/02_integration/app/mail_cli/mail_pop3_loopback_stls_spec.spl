# @req REQ-001 REQ-004 REQ-006
# Real curl (--ssl-reqd over pop3://) + production Bash mail client against the
# pure-Simple POP3 loopback server in STLS transport: plaintext greeting, STLS,
# then rt_tls_server_upgrade_tcp turns the accepted TCP connection into TLS.
# Requires MAIL_CONFIG_BIN (compiled SDN helper); a missing helper fails, never skips.
use std.spec.*
use std.spec.step
use std.process.{run}

val PROBE = "test/01_unit/tools/mail_cli/fixtures/loopback_pop3_probe.shs"
# One server start + client drive per file; every scenario verdict is read from this run.
val probe = run("bash", [PROBE, "stls"])

describe "Mail POP3 STLS upgrade through actual curl":
    it "should pass every STLS loopback scenario against the Simple POP3 server":
        step("Start the Simple POP3 server in STLS transport and drive the production client")
        step("Check the probe's overall verdict")
        expect(probe.exit_code).to_equal(0)

    it "should authenticate and list the mailbox only after the STLS upgrade":
        expect(probe.stdout).to_contain("actual_curl_stls_upgrade_before_credentials: PASS")

    it "should send no credentials when the server refuses STLS":
        expect(probe.stdout).to_contain("actual_curl_stls_failure_sends_no_credentials: PASS")
