# codex-system-test
# @req REQ-002
"""
Real compiled Simple mail credential helper acceptance.
Requires MAIL_REAL_CREDENTIAL_BIN pointing to the admitted compiled helper.
Missing runtime/helper fails this specification; it is never a passing skip.
The test creates a disposable HOME and never accesses user credentials.
"""
use std.spec.*
use std.spec.step
use std.process.{run}

describe "Mail credential helper real crypto acceptance":
    it "should round trip with random IVs and fail closed on malformed ciphertext":
        step("Encrypt twice and decrypt using the actual compiled Simple helper")
        val result = run("bash", ["test/01_unit/tools/mail_cli/fixtures/real_credential_probe.shs"])
        step("Check round trip, distinct ciphertext, key permissions, and invalid input errors")
        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_contain("real_crypto_roundtrip_random_iv: PASS")
        expect(result.stdout).to_contain("real_key_owner_only: PASS")
        expect(result.stdout).to_contain("real_invalid_decrypt_fails_closed: PASS")
