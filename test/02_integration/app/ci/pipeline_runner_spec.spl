# A CI pipeline really runs its jobs, in order, on this host.
#
# @req ORCH-003 ORCH-006 ORCH-014
# **Requirements:** N/A
# **Plan:** N/A
# **Design:** N/A
# **Research:** doc/01_research/os/container/simple_orchestrator_and_container_2026-09-06.md
#
# Requirements are the research doc's ORCH-001..016 table; the milestone table is
# `.spipe/simple_orchestrator/state.md`; the design is §12 and §13 of the
# research doc.
#
# ## Overview
#
# This is the CI application of the orchestration model. It EXECUTES: each job
# launches a real host process and the receipt carries that process's real exit
# code and real stdout. A fresh nonce is minted per run and must appear in the
# job's output, so a receipt cannot be satisfied by fabricated text (research
# §13.4).
#
# The executable fixtures target Linux's `native-process` lane. On another OS,
# the runner must block them before launch. The container lane is separately
# asserted to be refused on the qualification host rather than quietly
# downgraded to a process (research §4.1, ORCH-006).
#
# ## Examples
#
# Three scenarios: a nonce round-trip, an upstream failure that stops its
# dependent while an independent job still runs, and a `native-container` job
# that is refused.

use std.spec.*
use app.io.mod.{current_time_ms, file_write, host_os}
use std.io_runtime.{file_read, file_exists}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir}
use std.common.contracts.orchestration.resource_v1.{ObjectMetaV1, PodSpecV1}
use std.common.contracts.orchestration.ci_v1.*
use std.common.contracts.container.runtime_v1.*
use app.ci.pipeline_runner.*

fn empty_job() -> JobV1:
    JobV1(meta: ObjectMetaV1(name: "", ns: "", labels: {}), backoff_limit: 0,
          template: PodSpecV1(os_name: "", runtime_class: "", network_profile: "", containers: []))

# A Job that runs `/usr/bin/busybox sh -c <script>` on the host process lane.
fn shell_job(name: text, script: text) -> JobV1:
    val src = "apiVersion: " + CI_API_VERSION_V1 + "\n" +
              "kind: Job\n" +
              "metadata:\n" +
              "    name: " + name + "\n" +
              "spec:\n" +
              "    template:\n" +
              "        spec:\n" +
              "            os:\n" +
              "                name: linux\n" +
              "            runtimeClassName: native-process\n" +
              "            containers:\n" +
              "                - name: step\n" +
              "                  command: [\"/usr/bin/busybox\", \"sh\", \"-c\", \"" + script + "\"]\n"
    match decode_job(src):
        case Ok(j): j
        case Err(_): empty_job()

fn container_job(name: text, marker: text) -> JobV1:
    val src = "apiVersion: " + CI_API_VERSION_V1 + "\n" +
              "kind: Job\n" +
              "metadata:\n" +
              "    name: " + name + "\n" +
              "spec:\n" +
              "    template:\n" +
              "        spec:\n" +
              "            os:\n" +
              "                name: linux\n" +
              "            runtimeClassName: native-container\n" +
              "            containers:\n" +
              "                - name: step\n" +
              "                  image: \"docker.io/library/busybox@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n" +
              "                  command: [\"/usr/bin/busybox\", \"sh\", \"-c\", \"touch " + marker + "\"]\n"
    match decode_job(src):
        case Ok(j): j
        case Err(_): empty_job()

val F = "test/fixtures/orchestration/"

fn fixture_pipeline(name: text) -> PipelineV1:
    match decode_pipeline(file_read(F + name) ?? ""):
        case Ok(p): p
        case Err(_): PipelineV1(meta: ObjectMetaV1(name: "", ns: "", labels: {}), jobs: [])

# The committed Job fixture, with its NONCE placeholder bound to this run.
fn fixture_job(name: text, job_name: text, nonce: text) -> JobV1:
    var src = file_read(F + name) ?? ""
    src = src.replace("NONCE", nonce)
    src = src.replace("name: echo-linux", "name: " + job_name)
    match decode_job(src):
        case Ok(j): j
        case Err(_): empty_job()

fn pipeline_from(body: text) -> PipelineV1:
    val src = "apiVersion: " + CI_API_VERSION_V1 + "\n" +
              "kind: Pipeline\n" +
              "metadata:\n" +
              "    name: runner-spec\n" +
              "spec:\n" +
              "    jobs:\n" + body
    match decode_pipeline(src):
        case Ok(p): p
        case Err(_): PipelineV1(meta: ObjectMetaV1(name: "", ns: "", labels: {}), jobs: [])

fn node(name: text, ref_name: text, after: text, policy: text) -> text:
    var s = "        - name: " + name + "\n" +
            "          jobTemplateRef: " + ref_name + "\n"
    if after != "":
        s = s + "          runAfter: [" + after + "]\n"
    if policy != "":
        s = s + "          runPolicy: " + policy + "\n"
    s

fn receipt_for(run: RunReceiptV1, name: text) -> JobReceiptV1:
    for r in run.jobs:
        if r.job_name == name:
            return r
    JobReceiptV1(job_name: name, attempt: -1, runtime_class: "", verdict: "MISSING",
                 reason: "no receipt for this job", exit_code: -1, stdout: "", node_boot_id: "",
                 native_id: "", provider_generation: 0, operation_id: "", runtime_state_dir: "")

fn run_or_empty(p: PipelineV1, t: Dict<text, JobV1>, id: text) -> RunReceiptV1:
    match run_pipeline(p, t, id):
        case Ok(rr): rr
        case Err(r): RunReceiptV1(run_id: id, pipeline: "", verdict: "REJECTED:" + r.kind, jobs: [])

describe "Simple CI runs a pipeline on this host":

    it "admits only a matching host OS and an implemented runtime class":
        var spec = shell_job("guard", "echo should-not-run").template
        spec.os_name = "linux"
        expect(job_runtime_admission_error(spec, "linux")).to_equal("")
        expect(job_runtime_admission_error(spec, "windows")).to_contain("job-os-mismatch")
        expect(job_runtime_admission_error(spec, "unknown-os")).to_contain("unsupported-host-os")
        spec.runtime_class = "native-sandbox"
        expect(job_runtime_admission_error(spec, "linux")).to_contain("native-sandbox-provider-unavailable")
        spec.runtime_class = "native-container"
        expect(job_runtime_admission_error(spec, "linux")).to_equal("")
        spec.os_name = "windows"
        expect(job_runtime_admission_error(spec, "windows")).to_contain("native-container-provider-unavailable")
        spec.runtime_class = "unrecognized"
        expect(job_runtime_admission_error(spec, "windows")).to_contain("unsupported-runtime-class")

    it "blocks a foreign OS and sandbox class before launching their commands":
        val marker_dir = match secure_temp_dir("/tmp", "simpleorch-admission-spec-"):
            case Ok(path): path
            case Err(_): ""
        expect(marker_dir.len()).to_be_greater_than(0)
        val foreign_marker = marker_dir + "/foreign"
        val sandbox_marker = marker_dir + "/sandbox"
        var foreign = shell_job("foreign", "touch " + foreign_marker)
        var foreign_spec = foreign.template
        foreign_spec.os_name = if host_os() == "linux" then "windows" else "linux"
        foreign.template = foreign_spec
        var sandbox = shell_job("sandbox", "touch " + sandbox_marker)
        var sandbox_spec = sandbox.template
        sandbox_spec.os_name = host_os()
        sandbox_spec.runtime_class = "native-sandbox"
        sandbox.template = sandbox_spec
        var t: Dict<text, JobV1> = {}
        t["foreign"] = foreign
        t["sandbox"] = sandbox
        val p = pipeline_from(node("foreign", "foreign", "", "") +
                              node("sandbox", "sandbox", "", ""))
        val run = run_or_empty(p, t, "run-admission")
        expect(run.verdict).to_equal(VERDICT_BLOCKED)
        val f = receipt_for(run, "foreign")
        expect(f.verdict).to_equal(VERDICT_BLOCKED)
        expect(f.reason).to_contain("job-os-mismatch")
        expect(f.attempt).to_equal(0)
        val s = receipt_for(run, "sandbox")
        expect(s.verdict).to_equal(VERDICT_BLOCKED)
        expect(s.reason).to_contain("native-sandbox-provider-unavailable")
        expect(s.attempt).to_equal(0)
        expect(file_exists(foreign_marker)).to_equal(false)
        expect(file_exists(sandbox_marker)).to_equal(false)
        val cleaned = cleanup_container_runtime_state(s, marker_dir)
        expect(cleaned.runtime_state_dir).to_equal("")

    it "deletes state after proven pre-execution failure but retains uncertain create state":
        val pre_exec = RuntimeOperationV1(status: RUNTIME_STATUS_REJECTED,
            operation: "create", command: runtime_command_empty(),
            state: runtime_state_empty(), exit_code: -1, stdout: "", stderr: "",
            reason: "intent-journal-write-failed")
        expect(container_runtime_state_requires_recovery(pre_exec)).to_equal(false)

        val uncertain = RuntimeOperationV1(status: RUNTIME_STATUS_REJECTED,
            operation: "create", command: runtime_command_empty(),
            state: runtime_state_empty(), exit_code: 125, stdout: "", stderr: "",
            reason: "native-create-failed")
        expect(container_runtime_state_requires_recovery(uncertain)).to_equal(true)

    it "cleans temporary container runtime state and reports no stale path":
        val state_dir = match secure_temp_dir("/tmp", "simpleorch-cleanup-spec-"):
            case Ok(path): path
            case Err(_): ""
        expect(state_dir.len()).to_be_greater_than(0)
        val receipt = JobReceiptV1(job_name: "boxed", attempt: 1,
            runtime_class: "native-container", verdict: VERDICT_FAIL,
            reason: "create failed", exit_code: -1, stdout: "",
            node_boot_id: "boot-1", native_id: "",
            provider_generation: 1, operation_id: "create-1",
            runtime_state_dir: state_dir)
        val cleaned = cleanup_container_runtime_state(receipt, state_dir)
        expect(cleaned.verdict).to_equal(VERDICT_FAIL)
        expect(cleaned.reason).to_equal("create failed")
        expect(cleaned.runtime_state_dir).to_equal("")
        expect(file_exists(state_dir)).to_equal(false)

        val blocking_file = match secure_temp_dir("/tmp", "simpleorch-cleanup-fail-"):
            case Ok(path): path
            case Err(_): ""
        expect(file_write(blocking_file + "/regular", "owned")).to_equal(true)
        val retained = cleanup_container_runtime_state(receipt,
            blocking_file + "/regular")
        expect(retained.verdict).to_equal(VERDICT_FAIL)
        expect(retained.reason).to_equal("create failed; runtime-state-cleanup-failed")
        expect(retained.runtime_state_dir).to_equal(blocking_file + "/regular")
        val final_cleanup = cleanup_container_runtime_state(retained, blocking_file)
        expect(final_cleanup.runtime_state_dir).to_equal("")

    it "runs every job in order and each receipt carries that run's fresh nonce":
        """
        An operator triggers a pipeline run. Two independent steps, then a step
        that waits for both. Each step echoes the nonce the runner minted for
        this run, so its receipt could not have been produced by an earlier run
        or written by hand.
        """
        step("Mint a nonce for this run")
        val nonce = "SIMPLEORCH-" + current_time_ms().to_text()

        step("Build three jobs that each echo the nonce with their own name")
        var t: Dict<text, JobV1> = {}
        t["a"] = shell_job("a", "echo " + nonce + "-a")
        t["b"] = shell_job("b", "echo " + nonce + "-b")
        t["c"] = shell_job("c", "echo " + nonce + "-c")

        step("Run a pipeline where c waits for a and b")
        val p = pipeline_from(node("a", "a", "", "") + node("b", "b", "", "") +
                              node("c", "c", "a, b", ""))
        val run = run_or_empty(p, t, "run-nonce")

        step("Confirm three receipts appear in dependency order")
        expect(run.jobs.len()).to_equal(3)
        expect(run.jobs[0].job_name).to_equal("a")
        expect(run.jobs[1].job_name).to_equal("b")
        expect(run.jobs[2].job_name).to_equal("c")

        if host_os() == "linux":
            step("Confirm each Linux process reports a real exit code and fresh nonce")
            expect(run.verdict).to_equal(VERDICT_PASS)
            for name in ["a", "b", "c"]:
                val r = receipt_for(run, name)
                expect(r.verdict).to_equal(VERDICT_PASS)
                expect(r.exit_code).to_equal(0)
                expect(r.runtime_class).to_equal("native-process")
                expect(r.attempt).to_equal(1)
                expect(r.stdout).to_contain(nonce + "-" + name)
            expect(receipt_for(run, "a").node_boot_id.len()).to_be_greater_than(0)
        else:
            step("Confirm foreign Linux jobs never launch on this host")
            expect(run.verdict).to_equal(VERDICT_BLOCKED)
            for name in ["a", "b"]:
                val r = receipt_for(run, name)
                expect(r.verdict).to_equal(VERDICT_BLOCKED)
                expect(r.reason).to_contain("job-os-mismatch")
                expect(r.attempt).to_equal(0)
                expect(r.stdout).to_equal("")
            val c = receipt_for(run, "c")
            expect(c.verdict).to_equal(VERDICT_NOT_RUN)
            expect(c.reason).to_contain("upstream")

    it "stops a dependent after its upstream fails while an independent job still runs":
        """
        A failed build must block what depends on it and must not block what does
        not. A diagnostics step declared `runPolicy: always` still runs, and the
        run verdict stays FAIL — collecting diagnostics never turns a failure
        into a success.
        """
        step("Build a failing job, its dependent, an independent job, and an always-run collector")
        val nonce = "SIMPLEORCH-" + current_time_ms().to_text()
        var t: Dict<text, JobV1> = {}
        t["fails"] = shell_job("fails", "echo " + nonce + "-fails; exit 3")
        t["dependent"] = shell_job("dependent", "echo " + nonce + "-dependent")
        t["independent"] = shell_job("independent", "echo " + nonce + "-independent")
        t["collector"] = shell_job("collector", "echo " + nonce + "-collector")

        step("Run the pipeline")
        val p = pipeline_from(node("fails", "fails", "", "") +
                              node("dependent", "dependent", "fails", "") +
                              node("independent", "independent", "", "") +
                              node("collector", "collector", "dependent", "always"))
        val run = run_or_empty(p, t, "run-failprop")

        if host_os() == "linux":
            step("Confirm the failing job reports its real non-zero exit code and output")
            val f = receipt_for(run, "fails")
            expect(f.verdict).to_equal(VERDICT_FAIL)
            expect(f.exit_code).to_equal(3)
            expect(f.stdout).to_contain(nonce + "-fails")

            step("Confirm the dependent never ran and names its failed upstream")
            val d = receipt_for(run, "dependent")
            expect(d.verdict).to_equal(VERDICT_NOT_RUN)
            expect(d.exit_code).to_equal(0)
            expect(d.stdout).to_equal("")
            expect(d.reason).to_contain("fails")

            step("Confirm the independent job and always-policy collector ran")
            val i = receipt_for(run, "independent")
            expect(i.verdict).to_equal(VERDICT_PASS)
            expect(i.exit_code).to_equal(0)
            expect(i.stdout).to_contain(nonce + "-independent")
            val col = receipt_for(run, "collector")
            expect(col.verdict).to_equal(VERDICT_PASS)
            expect(col.stdout).to_contain(nonce + "-collector")
            expect(run.verdict).to_equal(VERDICT_FAIL)
        else:
            step("Confirm all Linux commands are withheld on this host")
            expect(run.verdict).to_equal(VERDICT_BLOCKED)
            for name in ["fails", "independent", "collector"]:
                val r = receipt_for(run, name)
                expect(r.verdict).to_equal(VERDICT_BLOCKED)
                expect(r.reason).to_contain("job-os-mismatch")
                expect(r.attempt).to_equal(0)
                expect(r.stdout).to_equal("")
            val d = receipt_for(run, "dependent")
            expect(d.verdict).to_equal(VERDICT_NOT_RUN)
            expect(d.reason).to_contain("fails")

    it "never runs a native-container job as a host process":
        """
        An unavailable lane blocks before launch. A qualified Linux lane may
        reach its provider and fail for an unavailable image, but must never
        execute the container command on the host process lane.
        """
        step("Probe the host container lane")
        val probe = probe_container_lane()

        step("Run a pipeline with one native-container job and one process job")
        val nonce = "SIMPLEORCH-" + current_time_ms().to_text()
        val marker_dir = match secure_temp_dir("/tmp", "simpleorch-container-lane-spec-"):
            case Ok(path): path
            case Err(_): ""
        expect(marker_dir.len()).to_be_greater_than(0)
        val marker = marker_dir + "/host-process-fallback"
        var t: Dict<text, JobV1> = {}
        t["boxed"] = container_job("boxed", marker)
        t["plain"] = shell_job("plain", "echo " + nonce + "-plain")
        val p = pipeline_from(node("boxed", "boxed", "", "") + node("plain", "plain", "", ""))
        val run = run_or_empty(p, t, "run-blocked")

        step("Confirm the receipt preserves the requested container class")
        val b = receipt_for(run, "boxed")
        expect(b.runtime_class).to_equal("native-container")
        expect(file_exists(marker)).to_equal(false)

        step("Confirm the provider or admission reason and the independent job")
        expect(b.reason.len()).to_be_greater_than(0)
        val plain = receipt_for(run, "plain")
        if host_os() == "linux":
            expect(plain.verdict).to_equal(VERDICT_PASS)
            expect(plain.stdout).to_contain(nonce + "-plain")
            if probe.available:
                expect([VERDICT_FAIL, VERDICT_BLOCKED].contains(b.verdict)).to_be(true)
            else:
                expect(b.verdict).to_equal(VERDICT_BLOCKED)
                expect(b.reason).to_equal(probe.reason)
                expect(b.attempt).to_equal(0)
                expect(b.exit_code).to_equal(0)
                expect(b.stdout).to_equal("")
        else:
            expect(b.verdict).to_equal(VERDICT_BLOCKED)
            expect(b.reason).to_contain("job-os-mismatch")
            expect(b.attempt).to_equal(0)
            expect(plain.verdict).to_equal(VERDICT_BLOCKED)
            expect(plain.reason).to_contain("job-os-mismatch")
            expect(plain.attempt).to_equal(0)
            expect(plain.stdout).to_equal("")

        step("Confirm the run reflects its container job and remove the marker directory")
        expect(run.verdict).to_equal(b.verdict)
        val cleaned = cleanup_container_runtime_state(b, marker_dir)
        expect(cleaned.runtime_state_dir).to_equal("")

    it "runs the qualification pipeline fixture from disk end to end":
        """
        The pipeline and Job documents an operator would actually commit — the
        four-job qualification fixture and its process-lane Job template — are
        read from disk, expanded, and executed. This is the only example that
        runs the committed fixtures rather than pipelines built in this spec.
        """
        step("Read the committed pipeline fixture")
        val p = fixture_pipeline("ci_pipeline.sdn")
        expect(p.meta.name).to_equal("orchestrator-qualification")
        expect(p.jobs.len()).to_equal(4)

        step("Bind its four template references to the committed process-lane Job")
        val nonce = "SIMPLEORCH-" + current_time_ms().to_text()
        var t: Dict<text, JobV1> = {}
        for ref_name in ["echo-linux", "echo-probe", "echo-publish", "echo-evidence"]:
            t[ref_name] = fixture_job("ci_job_process.sdn", ref_name, nonce)

        step("Run it")
        val run = run_or_empty(p, t, "run-fixture")

        step("Confirm all four receipts follow dependency order")
        expect(run.jobs.len()).to_equal(4)
        expect(run.jobs[0].job_name).to_equal("build-linux")
        expect(run.jobs[1].job_name).to_equal("build-probe")
        expect(run.jobs[2].job_name).to_equal("publish")
        expect(run.jobs[3].job_name).to_equal("evidence")

        step("Confirm the receipts name this pipeline")
        expect(run.pipeline).to_equal("orchestrator-qualification")
        if host_os() == "linux":
            step("Confirm all four fixture jobs executed and carried the nonce")
            expect(run.verdict).to_equal(VERDICT_PASS)
            for r in run.jobs:
                expect(r.verdict).to_equal(VERDICT_PASS)
                expect(r.exit_code).to_equal(0)
                expect(r.stdout).to_contain(nonce)
        else:
            step("Confirm the committed Linux fixture cannot execute on this host")
            expect(run.verdict).to_equal(VERDICT_BLOCKED)
            for name in ["build-linux", "build-probe", "evidence"]:
                val r = receipt_for(run, name)
                expect(r.verdict).to_equal(VERDICT_BLOCKED)
                expect(r.reason).to_contain("job-os-mismatch")
                expect(r.attempt).to_equal(0)
                expect(r.stdout).to_equal("")
            expect(receipt_for(run, "publish").verdict).to_equal(VERDICT_NOT_RUN)

    it "reports the container engine and its privilege as separate facts":
        """
        Podman is the default engine because its normal mode is rootless. But an
        available engine and an unprivileged launch are independent facts: rootless
        podman and a root docker daemon are both "an engine that answered". The
        probe therefore reports engine and privilege separately, and a lane that is
        unavailable claims neither.
        """
        step("Probe the container lane on this host")
        val probe = probe_container_lane()

        step("Confirm an unavailable lane claims no engine and no privilege")
        if not probe.available:
            expect(probe.engine).to_equal("")
            expect(probe.privilege).to_equal(PRIVILEGE_UNKNOWN)
            expect(probe.reason.len()).to_be_greater_than(0)

        step("Confirm an available lane names one of the supported engines")
        if probe.available:
            expect([ENGINE_PODMAN, ENGINE_DOCKER, ENGINE_RUNC].contains(probe.engine)).to_be(true)

        step("Confirm an available lane states root or rootless, never unknown")
        if probe.available:
            expect([PRIVILEGE_ROOTLESS, PRIVILEGE_ROOT].contains(probe.privilege)).to_be(true)

        step("Confirm a rootless claim is never made for docker's root daemon")
        if probe.engine == ENGINE_DOCKER:
            expect(probe.privilege).to_equal(PRIVILEGE_ROOT)
