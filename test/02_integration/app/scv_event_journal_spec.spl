"""
## Purpose and audience
Purpose: This spec proves SCV-IMPL-E-03 event journal integration: watcher
event batches land as pending files under `.scv/journal/event_batches/`,
commit appends framed `kind=fsevent` lines (op = batch id) to the MIG-10
append-only events.log with a durable committed marker, and replay is
idempotent — a second replay commits nothing and leaves events.log
byte-identical. The `scv event-record|event-commit|event-replay|events` CLI
drives the same disk state.
Audience: Maintainers of the SCV storage/event layers.
"""
# @req: REQ-SCV-EVENT-JOURNAL-001
use std.spec.{describe, it, expect, step}
use app.io.mod (file_exists, file_read, file_write, file_delete, dir_create, dir_remove_all, process_run)
use std.scv.store.{scv_init_repo}
use std.scv.journal.{scv_event_batch_record, scv_event_batch_commit, scv_event_batch_replay, scv_event_batch_is_committed, scv_event_batch_pending_path, scv_journal_events_path, scv_event_log}
use std.nogc_sync_mut.io.time_ops.{current_time_ms}

fn _repo(tag: text) -> text:
    val root = "/tmp/scv-event-journal-{tag}-{current_time_ms()}"
    dir_create(root, true)
    scv_init_repo(root)
    root

fn _events_lines(root: text) -> i64:
    val path = scv_journal_events_path(root)
    if not file_exists(path):
        return 0
    var count = 0
    for line in file_read(path).split("\n"):
        if line.trim() != "":
            count = count + 1
    count

fn _fault_cli(root: text, fault: text, command: text, batch_id: text) -> i64:
    val script = [
        "set -eu",
        "REPO=$(pwd)",
        "cd \"{root}\"",
        "SIMPLE_LIB=\"$REPO/src\" SCV_FAULT_AFTER={fault} \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" {command} {batch_id}"
    ].join("\n") + "\n"
    val (out, err, code) = process_run("/bin/sh", ["-c", script])
    code

describe "scv event journal integration (E-03)":
    it "records events into a pending, uncommitted batch":
        step("Record two events; pending file exists, batch not committed")
        val root = _repo("pending")
        expect(scv_event_batch_record(root, "b1", "created", "a.txt", "")).to_equal(true)
        expect(scv_event_batch_record(root, "b1", "modified", "a.txt", "")).to_equal(true)
        expect(file_exists(scv_event_batch_pending_path(root, "b1"))).to_equal(true)
        expect(scv_event_batch_is_committed(root, "b1")).to_equal(false)
        dir_remove_all(root)

    it "commits a batch into the append-only events.log exactly once":
        step("Commit, verify framed lines + marker; a second commit adds nothing")
        val root = _repo("commit")
        scv_event_batch_record(root, "b1", "created", "a.txt", "")
        scv_event_batch_record(root, "b1", "deleted", "b.txt", "")
        val before = _events_lines(root)
        expect(scv_event_batch_commit(root, "b1")).to_equal(true)
        val after = _events_lines(root)
        expect(after - before).to_equal(2)
        expect(scv_event_batch_is_committed(root, "b1")).to_equal(true)
        expect(file_exists(scv_event_batch_pending_path(root, "b1"))).to_equal(false)
        val log = file_read(scv_journal_events_path(root))
        expect(log).to_contain("op=b1 kind=fsevent")
        expect(scv_event_batch_commit(root, "b1")).to_equal(true)
        expect(_events_lines(root)).to_equal(after)
        dir_remove_all(root)

    it "replays pending batches idempotently":
        step("Replay commits both batches; a second replay commits zero")
        val root = _repo("replay")
        scv_event_batch_record(root, "b1", "created", "a.txt", "")
        scv_event_batch_record(root, "b2", "created", "b.txt", "")
        expect(scv_event_batch_replay(root)).to_equal(2)
        val lines = _events_lines(root)
        expect(scv_event_batch_replay(root)).to_equal(0)
        expect(_events_lines(root)).to_equal(lines)
        expect(scv_event_log(root)).to_contain("op=b2 kind=fsevent")
        dir_remove_all(root)

    it "does not acknowledge an event-log write failure or discard pending events":
        step("Make events.log unwriteable as a file and attempt commit")
        val root = _repo("event-write-failure")
        expect(scv_event_batch_record(root, "b1", "created", "a.txt", "")).to_equal(true)
        dir_create(scv_journal_events_path(root), true)
        expect(scv_event_batch_commit(root, "b1")).to_equal(false)
        expect(file_exists(scv_event_batch_pending_path(root, "b1"))).to_equal(true)
        expect(scv_event_batch_is_committed(root, "b1")).to_equal(false)
        dir_remove_all(root)

    it "keeps a sealed batch retryable after event publication but before its terminal marker":
        step("Fail marker publication after the event row is durable")
        val root = _repo("marker-write-failure")
        expect(scv_event_batch_record(root, "b1", "created", "a.txt", "")).to_equal(true)
        expect(_fault_cli(root, "event_batch_event", "event-commit", "b1")).to_equal(3)
        expect(_events_lines(root)).to_equal(1)
        dir_create("{root}/.scv/journal/event_batches/b1.committed", true)
        expect(scv_event_batch_commit(root, "b1")).to_equal(false)
        expect(_events_lines(root)).to_equal(1)
        expect(file_exists(scv_event_batch_pending_path(root, "b1"))).to_equal(true)
        expect(scv_event_batch_is_committed(root, "b1")).to_equal(false)
        expect(scv_event_batch_record(root, "b1", "modified", "a.txt", "")).to_equal(false)
        dir_remove_all("{root}/.scv/journal/event_batches/b1.committed")
        expect(scv_event_batch_replay(root)).to_equal(1)
        expect(_events_lines(root)).to_equal(1)
        expect(scv_event_batch_is_committed(root, "b1")).to_equal(true)
        dir_remove_all(root)

    it "refuses to reuse a committed batch identity for different payload":
        step("Commit one payload, then try to record a different event under its ID")
        val root = _repo("batch-id-reuse")
        expect(scv_event_batch_record(root, "same-id", "created", "a.txt", "")).to_equal(true)
        expect(scv_event_batch_commit(root, "same-id")).to_equal(true)
        expect(scv_event_batch_record(root, "same-id", "deleted", "b.txt", "")).to_equal(false)
        expect(file_exists(scv_event_batch_pending_path(root, "same-id"))).to_equal(false)
        expect(_events_lines(root)).to_equal(1)
        dir_remove_all(root)

    it "rejects altered seal, event rows, and missing published rows while preserving pending input":
        step("Tamper with each identity-bearing artifact after its prior durable boundary")
        val seal_root = _repo("tamper-seal")
        expect(scv_event_batch_record(seal_root, "s1", "created", "a.txt", "")).to_equal(true)
        expect(_fault_cli(seal_root, "event_batch_sealed", "event-commit", "s1")).to_equal(3)
        expect(file_write(scv_event_batch_pending_path(seal_root, "s1"), "kind=created path=b.txt related=\n")).to_equal(true)
        expect(scv_event_batch_commit(seal_root, "s1")).to_equal(false)
        expect(file_exists(scv_event_batch_pending_path(seal_root, "s1"))).to_equal(true)
        expect(_events_lines(seal_root)).to_equal(0)

        val row_root = _repo("tamper-row")
        expect(scv_event_batch_record(row_root, "r1", "created", "a.txt", "")).to_equal(true)
        expect(_fault_cli(row_root, "event_batch_event", "event-commit", "r1")).to_equal(3)
        val original = file_read(scv_journal_events_path(row_root))
        val changed = original.replace("refs=kind=created,path=a.txt,related=", "refs=kind=created,path=b.txt,related=")
        expect(file_write(scv_journal_events_path(row_root), changed)).to_equal(true)
        expect(scv_event_batch_commit(row_root, "r1")).to_equal(false)
        expect(file_exists(scv_event_batch_pending_path(row_root, "r1"))).to_equal(true)

        val missing_root = _repo("missing-row")
        expect(scv_event_batch_record(missing_root, "m1", "created", "a.txt", "")).to_equal(true)
        expect(scv_event_batch_commit(missing_root, "m1")).to_equal(true)
        expect(file_delete(scv_journal_events_path(missing_root))).to_equal(true)
        expect(scv_event_batch_is_committed(missing_root, "m1")).to_equal(false)
        expect(scv_event_batch_commit(missing_root, "m1")).to_equal(false)

        val marker_root = _repo("tamper-marker")
        expect(scv_event_batch_record(marker_root, "t1", "created", "a.txt", "")).to_equal(true)
        expect(scv_event_batch_commit(marker_root, "t1")).to_equal(true)
        expect(file_write("{marker_root}/.scv/journal/event_batches/t1.committed", "corrupt marker\n")).to_equal(true)
        expect(scv_event_batch_is_committed(marker_root, "t1")).to_equal(false)

        val legacy_marker_root = _repo("legacy-marker")
        dir_create("{legacy_marker_root}/.scv/journal/event_batches", true)
        expect(file_write("{legacy_marker_root}/.scv/journal/event_batches/l1.committed", "committed utc=1\n")).to_equal(true)
        expect(scv_event_batch_is_committed(legacy_marker_root, "l1")).to_equal(false)
        expect(scv_event_batch_commit(legacy_marker_root, "l1")).to_equal(false)

        val legacy_root = _repo("legacy-partial-row")
        expect(scv_event_batch_record(legacy_root, "l1", "created", "a.txt", "")).to_equal(true)
        expect(file_write(scv_journal_events_path(legacy_root), "op=l1 kind=fsevent refs=kind=created,path=a.txt,related= sha=- utc=1\n")).to_equal(true)
        expect(scv_event_batch_commit(legacy_root, "l1")).to_equal(false)
        expect(file_exists(scv_event_batch_pending_path(legacy_root, "l1"))).to_equal(true)
        expect(_events_lines(legacy_root)).to_equal(1)

        val path_root = _repo("path-traversal")
        expect(scv_event_batch_record(path_root, "../outside", "created", "a.txt", "")).to_equal(false)
        expect(file_exists("{path_root}/.scv/journal/outside.pending")).to_equal(false)
        dir_remove_all(seal_root)
        dir_remove_all(row_root)
        dir_remove_all(missing_root)
        dir_remove_all(marker_root)
        dir_remove_all(legacy_marker_root)
        dir_remove_all(legacy_root)
        dir_remove_all(path_root)

    it "refuses a symlinked pending leaf without following or deleting its target":
        step("Place a pending-name symlink to an ordinary file and attempt commit")
        val root = _repo("pending-symlink")
        val target = "{root}/outside.pending-data"
        expect(file_write(target, "kind=created path=a.txt related=\n")).to_equal(true)
        val (out, err, code) = process_run("ln", ["-s", target, scv_event_batch_pending_path(root, "b1")])
        expect(code).to_equal(0)
        expect(scv_event_batch_commit(root, "b1")).to_equal(false)
        expect(file_exists(scv_event_batch_pending_path(root, "b1"))).to_equal(true)
        expect(file_read(target)).to_equal("kind=created path=a.txt related=\n")
        dir_remove_all(root)

    it "refuses a symlinked event log without replacing or following its target":
        step("Point events.log at an unrelated regular file and attempt commit")
        val root = _repo("event-log-symlink")
        val target = "{root}/outside.events"
        expect(file_write(target, "keep this file\n")).to_equal(true)
        expect(scv_event_batch_record(root, "b1", "created", "a.txt", "")).to_equal(true)
        val (out, err, code) = process_run("ln", ["-s", target, scv_journal_events_path(root)])
        expect(code).to_equal(0)
        expect(scv_event_batch_commit(root, "b1")).to_equal(false)
        expect(file_exists(scv_event_batch_pending_path(root, "b1"))).to_equal(true)
        expect(file_read(target)).to_equal("keep this file\n")
        dir_remove_all(root)

    it "fails closed on dangling pending and lock symlinks":
        step("Ensure no-replace creation rejects dangling entry names before acknowledging work")
        val pending_root = _repo("dangling-pending")
        val absent_target = "{pending_root}/missing-target"
        val (pending_out, pending_err, pending_code) = process_run("ln", ["-s", absent_target, scv_event_batch_pending_path(pending_root, "b1")])
        expect(pending_code).to_equal(0)
        expect(scv_event_batch_record(pending_root, "b1", "created", "a.txt", "")).to_equal(false)
        expect(scv_event_batch_commit(pending_root, "b1")).to_equal(false)
        expect(file_exists(absent_target)).to_equal(false)

        val lock_root = _repo("dangling-lock")
        val lock_target = "{lock_root}/missing-lock-target"
        val (lock_out, lock_err, lock_code) = process_run("ln", ["-s", lock_target, "{lock_root}/.scv/journal/events.lock"])
        expect(lock_code).to_equal(0)
        expect(scv_event_batch_record(lock_root, "b1", "created", "a.txt", "")).to_equal(false)
        expect(file_exists(lock_target)).to_equal(false)
        dir_remove_all(pending_root)
        dir_remove_all(lock_root)

    it "recovers crashes at each durable event-batch boundary without duplicate rows":
        step("Crash after pending, seal, event-row, and terminal-marker publication")
        val pending_root = _repo("crash-pending")
        expect(_fault_cli(pending_root, "event_batch_pending", "event-record", "p1 created a.txt")).to_equal(3)
        expect(file_exists(scv_event_batch_pending_path(pending_root, "p1"))).to_equal(true)
        expect(scv_event_batch_replay(pending_root)).to_equal(1)
        expect(_events_lines(pending_root)).to_equal(1)

        val seal_root = _repo("crash-seal")
        expect(scv_event_batch_record(seal_root, "s1", "created", "a.txt", "")).to_equal(true)
        expect(_fault_cli(seal_root, "event_batch_sealed", "event-commit", "s1")).to_equal(3)
        expect(scv_event_batch_replay(seal_root)).to_equal(1)
        expect(_events_lines(seal_root)).to_equal(1)

        val row_root = _repo("crash-row")
        expect(scv_event_batch_record(row_root, "r1", "created", "a.txt", "")).to_equal(true)
        expect(scv_event_batch_record(row_root, "r1", "modified", "a.txt", "")).to_equal(true)
        expect(_fault_cli(row_root, "event_batch_event", "event-commit", "r1")).to_equal(3)
        expect(_events_lines(row_root)).to_equal(2)
        expect(scv_event_batch_replay(row_root)).to_equal(1)
        expect(_events_lines(row_root)).to_equal(2)

        val marker_root = _repo("crash-marker")
        expect(scv_event_batch_record(marker_root, "m1", "created", "a.txt", "")).to_equal(true)
        expect(_fault_cli(marker_root, "event_batch_marker", "event-commit", "m1")).to_equal(3)
        expect(file_exists(scv_event_batch_pending_path(marker_root, "m1"))).to_equal(true)
        expect(scv_event_batch_replay(marker_root)).to_equal(0)
        expect(_events_lines(marker_root)).to_equal(1)
        dir_remove_all(pending_root)
        dir_remove_all(seal_root)
        dir_remove_all(row_root)
        dir_remove_all(marker_root)

    it "serializes cooperating event writers through the shared journal lock":
        step("Record two batches concurrently, commit both, and verify neither row was lost")
        val root = _repo("concurrent")
        val script = [
            "set -eu",
            "REPO=$(pwd)",
            "cd \"{root}\"",
            "scv() { SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" \"$@\"; }",
            "scv event-record c1 created a.txt & p1=$!",
            "scv event-record c2 created b.txt & p2=$!",
            "wait \"$p1\"",
            "wait \"$p2\"",
            "scv event-commit c1 & p1=$!",
            "scv event-commit c2 & p2=$!",
            "wait \"$p1\"",
            "wait \"$p2\"",
            "printf 'writers=done\\n'"
        ].join("\n") + "\n"
        val (out, err, code) = process_run("/bin/sh", ["-c", script])
        expect(code).to_equal(0)
        expect("{out}{err}").to_contain("writers=done")
        expect(_events_lines(root)).to_equal(2)
        expect(file_read(scv_journal_events_path(root))).to_contain("refs=kind=created,path=a.txt,related=")
        expect(file_read(scv_journal_events_path(root))).to_contain("refs=kind=created,path=b.txt,related=")
        expect(scv_event_batch_is_committed(root, "c1")).to_equal(true)
        expect(scv_event_batch_is_committed(root, "c2")).to_equal(true)
        dir_remove_all(root)

    it "drives the same lifecycle through the scv CLI dispatch":
        step("scv event-record / event-commit / events over a real repo")
        val script = [
            "set -eu",
            "REPO=$(pwd)",
            "TMP=$(mktemp -d /tmp/scv-event-cli.XXXXXX)",
            "scv() { SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" \"$@\"; }",
            "cd \"$TMP\"",
            "scv init >/dev/null",
            "scv event-record cli1 created a.txt",
            "scv event-commit cli1",
            "scv event-replay",
            "scv events",
            "printf 'cli=done\\n'"
        ].join("\n") + "\n"
        val (out, err, code) = process_run("/bin/sh", ["-c", script])
        val combined = "{out}{err}\nexit={code}\n"
        expect(combined).to_contain("recorded batch=cli1")
        expect(combined).to_contain("committed batch=cli1")
        expect(combined).to_contain("op=cli1 kind=fsevent")
        expect(combined).to_contain("cli=done")
        expect(combined).to_contain("exit=0")
