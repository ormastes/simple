"""
## Purpose and audience
Purpose: pin the hosted secure entropy authority's single-consumption
contract: one authorized fill per cursor, exact authorization-token checking,
an upper bound on requested bytes, and replay that never re-reads entropy.
Audience: MCDC HAL runtime engineers who own the entropy environment
instruction executor and its cursor/receipt wire contract.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/hal_environment_entropy_executor_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed executor behavior.
## Compatibility and limitations
Exercises the hosted entropy executor wrappers only; the authority is
constructed with a fixed invocation and authorization token, so no real
hardware RNG source is contacted and determinism comes from the sealed
cursor state machine.
## Verification guidance and troubleshooting
A failure names the rejected condition (cursor reuse, wrong authorization,
oversized request) or the broken capture/replay pair; re-run this spec and
compare the failing scenario's receipt fields to reproduce locally.
"""
# @feature mcdc_hal_runtime_hardening
# @req REQ-011 REQ-015 REQ-016 REQ-017
# Lifecycle: doc/01_research/local/mcdc_hal_runtime_hardening.md ;
# doc/03_plan/agent_tasks/mcdc_hal_runtime_hardening.md ;
# doc/04_architecture/mcdc_hal_runtime_hardening.md ;
# doc/05_design/mcdc_hal_runtime_hardening.md
# @manual_section: hosted-secure-entropy-executor

use std.spec.*
use app.test.hal_environment_entropy_executor.*
use std.common.structural.environment_instruction.*

fn entropy_put_i64_le(out: [u8], offset: i64, value: i64):
    var i = 0
    while i < 8:
        out[offset + i] = ((value >> (i * 8)) & 255) as u8
        i = i + 1

fn entropy_authority() -> HostedSecureEntropyAuthorityV1:
    HostedSecureEntropyAuthorityV1(
        invocation_id: 771, capability_id: 14,
        authorization_hi: 0x10203040, authorization_lo: 0x50607080,
        max_bytes: 32, sealed: true)

fn entropy_policy() -> EnvExecutorPolicyV1:
    val opcode = env_opcode_mask_v1(EnvOpcodeV1.RandomFill)
    env_executor_policy_v1(opcode, 1 << 14, 0, opcode,
        false, true, true)

fn entropy_instruction(result_bytes: i64) -> EnvInstructionV1:
    env_instruction_v1(771, 0, EnvOpcodeV1.RandomFill, 14, 0,
        0, HOSTED_SECURE_ENTROPY_ARGUMENT_BYTES_V1,
        HOSTED_SECURE_ENTROPY_ARGUMENT_BYTES_V1,
        0, result_bytes, result_bytes)

fn entropy_arguments(requested: i64) -> [u8]:
    var arguments: [u8] = [0u8; HOSTED_SECURE_ENTROPY_ARGUMENT_BYTES_V1]
    entropy_put_i64_le(arguments, 0, requested)
    entropy_put_i64_le(arguments, 8, 0x10203040)
    entropy_put_i64_le(arguments, 16, 0x50607080)
    arguments

describe "hosted secure entropy environment executor":
    it "fills caller-owned storage once and replays without another effect":
        # @req REQ-011
        # @capture(protocol_binary): entropy capture receipt plus replay receipt with no second effect
        step("Fill 32 authorized entropy bytes once, then replay them from the observation")
        val authority = entropy_authority()
        val cursor = hosted_secure_entropy_cursor_v1(authority)
        val instruction = entropy_instruction(32)
        val arguments = entropy_arguments(32)
        var captured: [u8] = [0u8; 32]
        var replayed: [u8] = [0u8; 32]

        val attempt = hosted_secure_entropy_execute_v1(
            authority, cursor, entropy_policy(), instruction,
            arguments, captured)
        val replay = env_replay_exact_v1(
            instruction, instruction, attempt.receipt.observation,
            arguments, captured, replayed)

        expect(attempt.receipt.applied).to_be(true)
        expect(attempt.receipt.physical_effect).to_be(true)
        expect(attempt.receipt.allocation_count_after_seal).to_equal(0)  # oracle: a sealed capture must allocate nothing after the seal point
        expect(hosted_secure_entropy_complete_v1(attempt.cursor)).to_be(true)
        expect(replay.applied).to_be(true)
        expect(replay.physical_effect).to_be(false)  # oracle: replay must serve the snapshot without a second entropy read
        expect(replay.allocation_count_after_seal).to_equal(0)  # oracle: replay allocates nothing after the seal point either
        expect(replayed).to_equal(captured)

    it "rejects cursor reuse before reading entropy or changing storage":
        # @req REQ-015
        # @capture(protocol_binary): diverged rejection receipt for a consumed cursor
        step("Replay a consumed cursor against the authority and expect rejection")
        val authority = entropy_authority()
        val consumed = HostedSecureEntropyCursorV1(
            invocation_id: 771, next_sequence: 1,
            consumed_count: 1, sealed: true)
        val instruction = entropy_instruction(16)
        var result: [u8] = [73u8; 16]

        val attempt = hosted_secure_entropy_execute_v1(
            authority, consumed, entropy_policy(), instruction,
            entropy_arguments(16), result)

        expect(attempt.receipt.applied).to_be(false)
        expect(env_instruction_status_to_i64(
            attempt.receipt.observation.status)).to_equal(
                env_instruction_status_to_i64(EnvInstructionStatusV1.Diverged))
        expect(result[0]).to_equal(73u8)  # oracle: the sentinel 73 must survive because a rejected fill may not touch result storage

    it "rejects wrong authorization without reading entropy":
        # @req REQ-016
        # @capture(protocol_binary): diverged rejection receipt for a corrupted authorization token
        step("Corrupt the authorization token byte and expect rejection before any entropy read")
        val authority = entropy_authority()
        val cursor = hosted_secure_entropy_cursor_v1(authority)
        val instruction = entropy_instruction(16)
        var arguments = entropy_arguments(16)
        arguments[8] = 0u8
        var result: [u8] = [91u8; 16]

        val attempt = hosted_secure_entropy_execute_v1(
            authority, cursor, entropy_policy(), instruction,
            arguments, result)

        expect(attempt.receipt.applied).to_be(false)
        expect(env_instruction_status_to_i64(
            attempt.receipt.observation.status)).to_equal(
                env_instruction_status_to_i64(EnvInstructionStatusV1.Diverged))
        expect(result[0]).to_equal(91u8)  # oracle: the sentinel 91 must survive because a rejected fill may not touch result storage

    it "rejects oversized requests without allocation":
        # @req REQ-017
        # @capture(protocol_binary): oversized-request rejection receipt with untouched storage
        step("Request 33 entropy bytes against the 32-byte authority bound and expect rejection")
        val authority = entropy_authority()
        val cursor = hosted_secure_entropy_cursor_v1(authority)
        val instruction = entropy_instruction(33)
        var result: [u8] = [91u8; 33]

        val attempt = hosted_secure_entropy_execute_v1(
            authority, cursor, entropy_policy(), instruction,
            entropy_arguments(33), result)

        expect(attempt.receipt.applied).to_be(false)
        expect(attempt.receipt.allocation_count_after_seal).to_equal(0)  # oracle: an oversized request must allocate nothing
        expect(result[0]).to_equal(91u8)  # oracle: the sentinel 91 must survive because a rejected fill may not touch result storage
