"""Convergence observes real Git refs and records reviewed divergence."""
# @req: REQ-004, REQ-005, REQ-006, REQ-009, REQ-016
use std.spec.{describe, it, expect, step}
use app.io.mod.{process_run_bounded, file_write}
use std.nogc_sync_mut.io.file_ops.{file_hash_sha256}
use app.release.policy.{ReleaseSession}
use app.release.convergence.{
    ReviewedBugFix, ConvergenceRequest, PostIntegrationDivergenceRequest,
    inspect_release_main_convergence, record_post_integration_divergence,
    convergence_graph_allowed
}

fn run(command: text, arguments: [text]) -> (text, text, i64):
    process_run_bounded(command, arguments, 10000, 1048576)

fn output(command: text, arguments: [text]) -> text:
    val (stdout, _stderr, code) = run(command, arguments)
    if code != 0:
        return ""
    stdout.trim()

fn git(root: text, arguments: [text]) -> text:
    output("git", ["-C", root] + arguments)

fn session(root: text, main_root: text, target_ref: text, target_sha: text) -> ReleaseSession:
    ReleaseSession(
        session_id: "convergence-spec", workspace_path: root,
        main_workspace_path: main_root,
        work_branch: git(root, ["symbolic-ref", "--quiet", "--short", "HEAD"]),
        target_ref: target_ref, base_sha: git(root, ["rev-parse", "HEAD"]),
        expected_target_sha: target_sha,
        policy_sha256: file_hash_sha256(root + "/.spipe/policy/vcs.sdn")
    )

describe "Git-backed release/main convergence":
    it "fetches exact refs, checks one reviewed selection, and records post-integration divergence":
        step("Create an isolated repository with independent main and release histories")
        val temp_root = output("mktemp", ["-d", "/tmp/simple-convergence-spec.XXXXXX"])
        val origin = temp_root + "/origin.git"
        val main_root = temp_root + "/main"
        val worktree = temp_root + "/release-worktree"
        run("git", ["init", "--bare", origin])
        run("git", ["clone", origin, main_root])
        git(main_root, ["config", "user.email", "release-spec@example.invalid"])
        git(main_root, ["config", "user.name", "Release Spec"])
        run("mkdir", ["-p", main_root + "/.spipe/policy"])
        file_write(main_root + "/.spipe/policy/vcs.sdn", "schema: spipe-vcs/3\n")
        file_write(main_root + "/source.txt", "base\n")
        git(main_root, ["add", ".spipe/policy/vcs.sdn", "source.txt"])
        git(main_root, ["commit", "-m", "chore: base"])
        git(main_root, ["branch", "-M", "main"])
        git(main_root, ["push", "-u", "origin", "main"])
        val base_sha = git(main_root, ["rev-parse", "HEAD"])
        git(main_root, ["branch", "release/1.0", base_sha])
        git(main_root, ["push", "origin", "release/1.0"])

        file_write(main_root + "/source.txt", "base\nreviewed fix\n")
        git(main_root, ["add", "source.txt"])
        git(main_root, ["commit", "-m", "fix: reviewed correction"])
        git(main_root, ["push", "origin", "main"])
        val fix_sha = git(main_root, ["rev-parse", "HEAD"])
        git(main_root, ["worktree", "add", "-b", "work/release/convergence-spec", worktree, "refs/remotes/origin/release/1.0"])
        val canonical_main = output("realpath", [main_root])
        val canonical_worktree = output("realpath", [worktree])
        git(canonical_worktree, ["config", "user.email", "release-spec@example.invalid"])
        git(canonical_worktree, ["config", "user.name", "Release Spec"])
        file_write(canonical_worktree + "/release-line.txt", "release metadata\n")
        git(canonical_worktree, ["add", "release-line.txt"])
        git(canonical_worktree, ["commit", "-m", "chore: release line metadata"])
        git(canonical_worktree, ["push", "origin", "HEAD:refs/heads/release/1.0"])
        val release_sha = git(canonical_worktree, ["rev-parse", "HEAD"])

        step("Observe an exact caller-selected reviewed fix without applying it")
        val request = ConvergenceRequest(
            last_scanned_main_sha: base_sha, current_main_sha: fix_sha,
            release_ref: "release/1.0", release_head_sha: release_sha,
            last_scan_epoch_seconds: 0, current_epoch_seconds: 100,
            scan_interval_seconds: 60,
            eligible_reviewed_bug_fixes: [ReviewedBugFix(
                commit_sha: fix_sha,
                review_receipt_sha256: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                source_ref: "main", change_kind: "fix"
            )],
            selected_bug_fix_shas: [fix_sha], caller_selection_confirmed: true,
            direction: "main_to_release", forward_port_required: false,
            forward_port_target_ref: "", main_tracks_release: false
        )
        val observed = await inspect_release_main_convergence(
            canonical_worktree, session(canonical_worktree, canonical_main, "release/1.0", release_sha), request
        )
        expect(observed.valid).to_be(true)
        expect(observed.mutation).to_equal("fetch-only")
        expect(observed.source_only_commit_shas).to_contain(fix_sha)
        expect(observed.selected_exactly_reviewed).to_be(true)
        expect(observed.selected_absent_from_target).to_be(true)

        step("Simulate external reviewed integration and record exact divergence")
        git(canonical_worktree, ["cherry-pick", fix_sha])
        val result_sha = git(canonical_worktree, ["rev-parse", "HEAD"])
        git(canonical_worktree, ["push", "origin", "HEAD:refs/heads/release/1.0"])
        val receipt = await record_post_integration_divergence(
            canonical_worktree, session(canonical_worktree, canonical_main, "release/1.0", result_sha),
            PostIntegrationDivergenceRequest(
                direction: "main_to_release", release_ref: "release/1.0",
                source_head_before: fix_sha, target_head_before: release_sha,
                result_commit_sha: result_sha, selected_bug_fix_shas: [fix_sha],
                review_receipt_sha256: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                evidence_receipt_sha256: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                integration_receipt_sha256: "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
            )
        )
        expect(receipt.valid).to_be(true)
        expect(receipt.source_unchanged).to_be(true)
        expect(receipt.target_equals_result).to_be(true)
        expect(receipt.main_remains_independent).to_be(true)

        step("Reject a release-to-main merge that absorbs the entire release line")
        file_write(canonical_worktree + "/release-first-fix.txt", "reviewed release-first fix\n")
        git(canonical_worktree, ["add", "release-first-fix.txt"])
        git(canonical_worktree, ["commit", "-m", "fix: release-first correction"])
        git(canonical_worktree, ["push", "origin", "HEAD:refs/heads/release/1.0"])
        val release_first_fix_sha = git(canonical_worktree, ["rev-parse", "HEAD"])
        git(canonical_main, ["fetch", "--no-tags", "origin", "+refs/heads/release/1.0:refs/remotes/origin/release/1.0"])
        git(canonical_main, ["merge", "--no-ff", "--no-edit", "refs/remotes/origin/release/1.0"])
        val absorbed_main_sha = git(canonical_main, ["rev-parse", "HEAD"])
        git(canonical_main, ["push", "origin", "main"])
        val (_ancestor_out, _ancestor_err, ancestor_code) = run(
            "git", ["-C", canonical_worktree, "merge-base", "--is-ancestor", release_first_fix_sha, absorbed_main_sha]
        )
        expect(ancestor_code).to_equal(0)
        expect(convergence_graph_allowed(ancestor_code == 0)).to_be(false)

        git(canonical_main, ["worktree", "remove", "--force", canonical_worktree])
        run("rm", ["-rf", "--", temp_root])
