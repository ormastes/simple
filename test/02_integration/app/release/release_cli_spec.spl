"""
## Purpose and audience
Purpose: Exercise the release command boundary, including repository-backed
version validation and machine-output isolation.
Audience: Release maintainers reviewing fail-closed CLI behavior.
"""

# @req: REQ-003
# @req: REQ-005
# @req: REQ-007
# @req: REQ-009
# @req: REQ-012
# @req: REQ-017
# @req: REQ-018
use std.spec.{describe, it, expect, step}
use app.io.mod.{process_run}

fn _run_release(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    process_run("/bin/sh", [
        "-c",
        "set -eu; REPO=$(pwd); RUNTIME=${SIMPLE_RELEASE_TEST_BIN:-$REPO/bin/simple}; SIMPLE_LIB=\"$REPO/src\" \"$RUNTIME\" run \"$REPO/src/app/release/main.spl\" " + joined
    ])

fn _compatibility_flags() -> [text]:
    [
        "--public-api-major=1", "--compiler-abi=7",
        "--bootstrap-protocol=4", "--package-format=3",
        "--scv-store-schema=2", "--scv-wire-protocol=1",
        "--devhub-provider-api=1", "--spipe-skill-api=1",
        "--release-manifest-schema=1", "--bootstrap-receipt-schema=1"
    ]

fn _with_compatibility(args: [text]) -> [text]:
    var result = args
    for flag in _compatibility_flags():
        result.push(flag)
    result

describe "release CLI boundary":
    it "checks the canonical repository manifest and all declared projections":
        # @req: REQ-003
        step("Validate the repository-backed version authority")
        val (out, err, code) = _run_release(["version-check", "--json"])
        expect(code).to_equal(0)
        expect(out).to_contain("\"output_version\":\"simple-release/v1\"")
        expect(out).to_contain("\"command\":\"release version-check\"")
        expect(out).to_contain("\"status\":\"ok\"")
        expect(out.contains("Release version-check: PASS")).to_equal(false)
        expect(out.contains("Usage:")).to_equal(false)

    it "rejects a caller version that disagrees with the repository authority":
        # @req: REQ-003
        step("Reject a stale caller-supplied version")
        val (out, err, code) = _run_release(["version-check", "--version=9.9.9", "--json"])
        expect(code).to_equal(1)
        expect(out).to_contain("\"status\":\"rejected\"")
        expect(out).to_contain("requested version does not match")
        expect(out.contains("Usage:")).to_equal(false)

    it "rejects a missing manifest without falling back to caller facts":
        # @req: REQ-003
        step("Reject an unavailable canonical manifest")
        val (out, err, code) = _run_release(["version-check", "--root=/does/not/exist", "--version=1.0.0", "--channel=stable", "--json"])
        expect(code).to_equal(1)
        expect(out).to_contain("canonical release version manifest is missing")
        expect(out.contains("Release version-check")).to_equal(false)

    it "keeps progress and human help out of JSON rejection output":
        # @req: REQ-012
        step("Request JSON with progress and an unknown subcommand")
        val (out, err, code) = _run_release(["surprise", "--json", "--progress=count"])
        expect(code).to_equal(1)
        expect(out).to_contain("\"output_version\":\"simple-release/v1\"")
        expect(out).to_contain("unknown subcommand: surprise")
        expect(out.contains("Usage:")).to_equal(false)
        expect(out.contains("release surprise")).to_equal(false)

    it "rejects misspelled options instead of silently weakening a check":
        # @req: REQ-012
        step("Pass an unknown version option")
        val (out, err, code) = _run_release(["version-check", "--json", "--chanell=rc"])
        expect(code).to_equal(1)
        expect(out).to_contain("unknown or malformed option: --chanell=rc")
        expect(out.contains("Usage:")).to_equal(false)

    it "plans a monotonic projection render without writing":
        # @req: REQ-001
        # @req: REQ-002
        step("Plan the next release candidate version")
        val (out, err, code) = _run_release(["version-render-plan", "--version=1.0.0-rc.2", "--channel=rc", "--json"])
        expect(code).to_equal(0)
        expect(out).to_contain("\"mutation\":\"none\"")
        expect(out).to_contain("\"current_version\":\"1.0.0-rc.1\"")
        expect(out).to_contain("\"target_version\":\"1.0.0-rc.2\"")
        expect(out).to_contain("\"requested_bump\":\"prerelease\"")
        expect(out).to_contain("\"manifest_content\":\"version:\\n")
        expect(out).to_contain("\"projection_edits\":[{")
        expect(out).to_contain("\"rendered_content\":")

    it "requires every compatibility counter for an explicit bump plan":
        # @req: REQ-001
        # @req: REQ-002
        step("Reject an underspecified compatibility declaration")
        val (missing_out, missing_err, missing_code) = _run_release([
            "version-bump-plan", "--version=1.0.0-rc.2", "--channel=rc", "--json"
        ])
        expect(missing_code).to_equal(1)
        expect(missing_out).to_contain("required compatibility counter is missing or invalid")

        step("Render a complete explicit compatibility plan")
        val (out, err, code) = _run_release(_with_compatibility([
            "version-bump-plan", "--version=1.0.0-rc.2", "--channel=rc", "--json"
        ]))
        expect(code).to_equal(0)
        expect(out).to_contain("\"command\":\"release version-bump-plan\"")
        expect(out).to_contain("\"mutation\":\"none\"")
        expect(out).to_contain("\"manifest_content\":\"version:\\n")
        expect(out).to_contain("\"path\":\"VERSION\"")
        expect(out).to_contain("\"rendered_content\":\"1.0.0-rc.2\"")

    it "rejects version bump from the main workspace before writing":
        # @req: REQ-004
        # @req: REQ-005
        step("Supply a valid plan but a non-isolated session")
        val (out, err, code) = _run_release(_with_compatibility([
            "version-bump", "--version=1.0.0-rc.2", "--channel=rc", "--json",
            "--expected-manifest-sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "--session=s-cli", "--workspace=/tmp/fake-release-worktree", "--main-workspace=/tmp/fake-main-worktree",
            "--branch=work/release/v1.0.0-rc.2-s-cli", "--target=release/1.0",
            "--base-sha=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "--target-sha=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "--policy-sha256=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        ]))
        expect(code).to_equal(1)
        expect(out).to_contain("workspace does not match the canonical repository root")
        expect(out).to_contain("\"recovery_required\":false")
        expect(out).to_contain("\"applied_files\":[]")
        expect(out.contains("\"mutation\":\"applied\"")).to_equal(false)

    it "routes beta preparation through the isolated-session policy":
        # @req: REQ-005
        step("Reject beta preparation in the main workspace")
        val (out, err, code) = _run_release([
            "beta-prepare", "--json", "--version=1.0.0-beta.1",
            "--session=s-cli", "--workspace=/repo", "--main-workspace=/repo",
            "--branch=work/release/v1.0.0-beta.1-s-cli", "--target=release/1.0",
            "--base-sha=base", "--target-sha=target", "--policy-sha256=policy"
        ])
        expect(code).to_equal(1)
        expect(out).to_contain("mutation is forbidden in the main worktree")

    it "renders beta support from the canonical support manifest":
        # @req: REQ-004
        step("Load policy-required beta targets")
        val (out, err, code) = _run_release(["support-check", "--channel=beta", "--json"])
        expect(code).to_equal(0)
        expect(out).to_contain("\"command\":\"release support-check\"")
        expect(out).to_contain("\"required_support\":[{")
        expect(out).to_contain("x86_64-unknown-linux-gnu")
        expect(out).to_contain("\"bootstrap\":\"full\"")
        expect(out).to_contain("\"whole_tests\":\"required\"")

    it "fails convergence admission on an unselected shared fix":
        # @req: REQ-006
        step("Validate protected-integration convergence decisions before candidate admission")
        val (out, err, code) = _run_release([
            "convergence-admission", "--json", "--graph-independent",
            "--candidate-commit-sha=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "--receipt-candidate-commit-sha=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "--release-ref=release/1.0",
            "--main-head-sha=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "--release-head-sha=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "--receipt-sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "--review-summary-sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "--evidence-receipt-sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "--integration-receipt-sha256=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
            "--inventory-origin=protected_integration",
            "--main-inventory=cccccccccccccccccccccccccccccccccccccccc",
            "--main-shared=cccccccccccccccccccccccccccccccccccccccc",
            "--main-selected=", "--release-inventory=", "--release-classified=",
            "--release-classification-kinds=", "--release-classification-receipts=",
            "--release-forward-ported=", "--release-forward-port-results=",
            "--release-forward-port-targets=", "--forward-port-receipts="
        ])
        expect(code).to_equal(1)
        expect(out).to_contain("every main shared fix must be explicitly selected for backport")
        expect(out).to_contain("\"mutation\":\"none\"")

    it "refuses a self-review policy path supplied by the PR worktree":
        step("Keep operator deny/constraint authority outside caller-controlled files")
        val (out, err, code) = _run_release([
            "self-review-plan", "--json", "--policy-db=.spipe/policy/vcs.sdn",
            "--changed-manifest=/tmp/changed-paths.sdn"
        ])
        expect(code).to_equal(1)
        expect(out).to_contain("SPIPE_SELF_REVIEW_POLICY_DB")
        expect(out).to_contain("not the PR worktree")

    it "routes backport and promotion hazards to fail-closed checks":
        # @req: REQ-007
        # @req: REQ-009
        step("Reject a feature-shaped beta backport")
        val (backport_out, backport_err, backport_code) = _run_release([
            "backport-check", "--json", "--direction=main_to_beta", "--source-ref=main",
            "--source-sha=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "--result-sha=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "--change-id=change", "--work-id=gh-1", "--kind=feat",
            "--review-sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "--reviewed-source-sha=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "--reviewed-change-id=change",
            "--target=release/1.0", "--target-sha=cccccccccccccccccccccccccccccccccccccccc",
            "--adaptation=none", "--evidence-sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "--evidence-result-sha=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "--evidence-target-sha=cccccccccccccccccccccccccccccccccccccccc"
        ])
        expect(backport_code).to_equal(1)
        expect(backport_out).to_contain("bug fixes only")
        step("Reject caller-supplied admission strings at the persisted promotion boundary")
        val (promote_out, promote_err, promote_code) = _run_release([
            "promote-check", "--json", "--candidate-version=1.0.0-beta.1", "--candidate-attempt=1",
            "--candidate-ref=candidate/v1.0.0-beta.1/a001",
            "--candidate-identity=1e369bb3125e647b458214d7a2f4b0641b5bbb02e93fa6bb18863084cb1c28b3",
            "--candidate-commit-sha=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "--source-sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "--policy-sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "--version-sha256=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
            "--toolchain-sha256=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
            "--support-sha256=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
            "--build-graph-sha256=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
            "--creator-identity=github:ormastes/simple/actions/runs/42/attempts/1",
            "--target-sha=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "--tag=v1.0.0-beta.1",
            "--artifact-sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "--admitted-artifact-sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "--evidence-sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "--qualification-sha256=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
            "--admission-sha256=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
            "--signed", "--annotated", "--exact-push", "--rebuild"
        ])
        expect(promote_code).to_equal(1)
        expect(promote_out).to_contain("unknown or malformed option: --candidate-version")
