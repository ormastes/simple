"""Retained file value-owner regression intent. Native execution: UNRUN.

The scenarios exercise actual handles, not copied-state stand-ins.
"""
use std.spec.*
use std.spec.step
use std.nogc_sync_mut.io.retained_file.{retained_file_open, retained_file_read_at, retained_file_unchanged}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_remove}
use std.nogc_sync_mut.io.dir_ops.{dir_remove}

describe "Retained file sequential value ownership":
    it "opens ASCII and multibyte paths while rejecting embedded NUL and over-limit paths":
        val target = secure_temp_dir(".", "item4-retained-path-").unwrap()
        step("Open, write, and read a file through an ASCII path")
        val ascii_path = "{target}/ascii"
        var ascii_output = retained_file_open(ascii_path, 1u64, true).unwrap()
        expect(ascii_output.write([11u8]).unwrap()).to_equal(true)
        expect(ascii_output.close()).to_equal(true)
        var ascii_input = retained_file_open(ascii_path, 1u64).unwrap()
        expect(ascii_input.read_exact(1).unwrap()).to_equal([11u8])
        expect(ascii_input.close()).to_equal(true)
        step("Open, write, and read a supplementary Unicode path")
        val path = "{target}/café-🙂"
        var output = retained_file_open(path, 2u64, true).unwrap()
        expect(output.write([17u8, 29u8]).unwrap()).to_equal(true)
        expect(output.close()).to_equal(true)
        var input = retained_file_open(path, 2u64).unwrap()
        expect(input.read_exact(2).unwrap()).to_equal([17u8, 29u8])
        expect(input.close()).to_equal(true)
        step("Reject empty and embedded-NUL paths before native open")
        expect(retained_file_open("", 1u64, true).unwrap_err()).to_equal("SCVDB_FILE_PATH")
        expect(retained_file_open("{target}/bad\0suffix", 1u64, true).unwrap_err()).to_equal("SCVDB_FILE_PATH")
        step("Reject a path beyond the existing byte-length cap")
        expect(retained_file_open("x".repeat(32761), 1u64, true).unwrap_err()).to_equal("SCVDB_FILE_PATH")
        expect(file_remove(ascii_path)).to_equal(true)
        expect(file_remove(path)).to_equal(true)
        expect(dir_remove(target, false)).to_equal(true)

    it "preserves cumulative write quotas and invalidates the exact owner on close":
        step("Create an exclusive native file and perform separate writes")
        val target = secure_temp_dir(".", "item4-retained-owner-").unwrap()
        var file = retained_file_open("{target}/owner", 4u64, true).unwrap()
        file.write([10u8, 20u8]).unwrap()
        expect(file.position).to_equal(2u64)
        expect(file.size).to_equal(2u64)
        file.write([30u8, 40u8]).unwrap()
        expect(file.position).to_equal(4u64)
        expect(file.write([50u8]).is_err()).to_equal(true)
        expect(file.position).to_equal(4u64)
        expect(file.close()).to_equal(true)
        expect(file.closed).to_equal(true)
        expect(file.handle).to_equal(-1)
        step("A repeated close cannot close a later native owner")
        var other = retained_file_open("{target}/other", 1u64, true).unwrap()
        expect(file.close()).to_equal(false)
        expect(file.write([1u8]).is_err()).to_equal(true)
        expect(other.write([7u8]).unwrap()).to_equal(true)
        expect(other.close()).to_equal(true)
        var reader = retained_file_open("{target}/owner", 4u64).unwrap()
        expect(reader.read_exact(4).unwrap()).to_equal([10u8, 20u8, 30u8, 40u8])
        expect(reader.position).to_equal(4u64)
        expect(retained_file_unchanged(reader).unwrap()).to_equal(true)
        expect(reader.close()).to_equal(true)
        expect(file_remove("{target}/owner")).to_equal(true)
        expect(file_remove("{target}/other")).to_equal(true)
        expect(dir_remove(target, false)).to_equal(true)

    it "keeps positional reads independent from the advancing sequential owner":
        step("Create a real four-byte file")
        val target = secure_temp_dir(".", "item4-retained-owner-").unwrap()
        var output = retained_file_open("{target}/cursor", 4u64, true).unwrap()
        output.write([10u8, 20u8, 30u8, 40u8]).unwrap()
        expect(output.close()).to_equal(true)
        var file = retained_file_open("{target}/cursor", 4u64).unwrap()
        expect(file.read(2).unwrap()).to_equal([10u8, 20u8])
        expect(file.position).to_equal(2u64)
        expect(retained_file_read_at(file, 0u64, 2).unwrap()).to_equal([10u8, 20u8])
        expect(file.position).to_equal(2u64)
        expect(file.read_exact(2).unwrap()).to_equal([30u8, 40u8])
        expect(file.position).to_equal(4u64)
        expect(file.read(1).unwrap()).to_equal([])
        expect(file.position).to_equal(4u64)
        expect(file.close()).to_equal(true)
        expect(file.read(1).is_err()).to_equal(true)
        expect(file_remove("{target}/cursor")).to_equal(true)
        expect(dir_remove(target, false)).to_equal(true)

    it "retains consumed cursor progress when exact-read returns truncation":
        step("Request more bytes than remain and observe state on the Err path")
        val target = secure_temp_dir(".", "item4-retained-owner-").unwrap()
        var output = retained_file_open("{target}/short", 2u64, true).unwrap()
        output.write([1u8, 2u8]).unwrap()
        expect(output.close()).to_equal(true)
        var file = retained_file_open("{target}/short", 2u64).unwrap()
        expect(file.read_exact(3).unwrap_err()).to_equal("SCVDB_FILE_TRUNCATED")
        expect(file.position).to_equal(2u64)
        expect(file.read_exact(0).unwrap()).to_equal([])
        expect(file.read_exact(-1).is_err()).to_equal(true)
        expect(file.read_exact(1048577).is_err()).to_equal(true)
        expect(file.position).to_equal(2u64)
        expect(file.close()).to_equal(true)
        expect(file_remove("{target}/short")).to_equal(true)
        expect(dir_remove(target, false)).to_equal(true)
