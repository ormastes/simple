# # MCP Protocol Runtime Spec
#
# Wire-level protocol checks for active simple-mcp server wrapper.

use std.spec
use std.common.spec.scenario_helpers.{capture_api_protocol_fields, capture_exec_detailed}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_create_exclusive}
use std.nogc_sync_mut.io.dir_ops.{dir_remove_all}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.env.platform.{get_temp_dir, is_windows}
use std.env.variables.{env_get}

fn mcp_msg(body: text) -> text:
    "Content-Length: " + body.len().to_string() + "\r\n\r\n" + body

fn mcp_jsonl(body: text) -> text:
    body + "\n"

fn init_request(id: text) -> text:
    val body = "{\"jsonrpc\":\"2.0\",\"id\":\"" + id + "\",\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"spec\",\"version\":\"1.0\"}}}"
    mcp_msg(body)

fn initialized_notification() -> text:
    mcp_msg("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}")

fn shutdown_request(id: text) -> text:
    mcp_msg("{\"jsonrpc\":\"2.0\",\"id\":\"" + id + "\",\"method\":\"shutdown\",\"params\":{}}")

fn generic_request(id: text, method: text, params_json: text) -> text:
    val body = "{\"jsonrpc\":\"2.0\",\"id\":\"" + id + "\",\"method\":\"" + method + "\",\"params\":" + params_json + "}"
    mcp_msg(body)

fn parse_nonnegative_i64(value: text) -> i64:
    var n: i64 = 0
    var i: i64 = 0
    if value.len() == 0:
        return -1
    while i < value.len():
        val ch = value.char_at(i)
        var digit: i64 = -1
        if ch == "0": digit = 0
        elif ch == "1": digit = 1
        elif ch == "2": digit = 2
        elif ch == "3": digit = 3
        elif ch == "4": digit = 4
        elif ch == "5": digit = 5
        elif ch == "6": digit = 6
        elif ch == "7": digit = 7
        elif ch == "8": digit = 8
        elif ch == "9": digit = 9
        if digit < 0:
            return -1
        n = n * 10 + digit
        i = i + 1
    n

fn has_valid_content_length_frames(output: text) -> bool:
    val parts = output.split("Content-Length:")
    parts.len() >= 3 and not output.contains("Content-Length: 2305843009213693951")

# Keep shell metacharacters inside a single pathname argument. Windows cmd
# expands percent variables even inside quotes, so those paths fail closed.
fn mcp_stdin_command(server: text, input_path: text, windows: bool) -> Result<text, text>:
    if server.len() <= 0 or input_path.len() <= 0:
        return Err("MCP executable and input paths must be nonempty")
    if server.contains("\r") or server.contains("\n") or input_path.contains("\r") or input_path.contains("\n"):
        return Err("MCP paths must not contain line breaks")
    if windows:
        if server.contains("\"") or server.contains("%") or input_path.contains("\"") or input_path.contains("%"):
            return Err("MCP Windows paths contain unsupported command expansion")
        return Ok("\"\"" + server + "\" < \"" + input_path + "\"\"")
    val quoted_server = "'" + server.replace("'", "'\"'\"'") + "'"
    val quoted_input = "'" + input_path.replace("'", "'\"'\"'") + "'"
    Ok("exec " + quoted_server + " < " + quoted_input)

fn send_mcp(messages: text) -> text:
    val scope = match secure_temp_dir(get_temp_dir(), "simple-mcp-stdio-"):
        Ok(path): path
        Err(reason): return "error: MCP temporary scope: " + reason
    val input_path = scope + "/input.txt"
    if not file_create_exclusive(input_path, messages):
        val removed = dir_remove_all(scope)
        return "error: MCP input creation failed; cleanup=" + removed.to_string()
    # Qualification supplies the actual receipt-bound native MCP executable.
    val server = env_get("SIMPLE_MCP_TEST_BINARY") ?? "bin/simple_mcp_server"
    val windows = is_windows()
    val command = match mcp_stdin_command(server, input_path, windows):
        Ok(value): value
        Err(reason):
            val removed = dir_remove_all(scope)
            return "error: " + reason + "; cleanup=" + removed.to_string()
    val shell = if windows: env_get("ComSpec") ?? "cmd.exe" else: "/bin/sh"
    val args = if windows: ["/d", "/v:off", "/s", "/c", command] else: ["-c", command]
    val (stdout, stderr, status) = process_run_bounded(shell, args, 120000, 16777216)
    val removed = dir_remove_all(scope)
    if status != 0 or not removed:
        return "error: MCP process status=" + status.to_string() + "; cleanup=" + removed.to_string() + "; " + stderr
    stdout

describe "MCP Protocol Runtime":
    it "quotes Windows stdin paths with spaces and command metacharacters":
        val command = match mcp_stdin_command("C:/Program Files/MCP & Tools/server.exe", "C:/private scope/input.txt", true):
            Ok(value): value
            Err(reason): reason
        expect(command).to_equal("\"\"C:/Program Files/MCP & Tools/server.exe\" < \"C:/private scope/input.txt\"\"")

    it "rejects Windows variable expansion and injected command delimiters":
        val expansion_rejected = match mcp_stdin_command("C:/%MCP%/server.exe", "C:/input.txt", true):
            Ok(value): false
            Err(reason): reason.contains("expansion")
        val newline_rejected = match mcp_stdin_command("C:/server.exe\nwhoami", "C:/input.txt", true):
            Ok(value): false
            Err(reason): reason.contains("line breaks")
        expect(expansion_rejected).to_equal(true)
        expect(newline_rejected).to_equal(true)

    it "quotes apostrophes in POSIX stdin paths":
        val command = match mcp_stdin_command("/private/MCP's/server", "/private/input.txt", false):
            Ok(value): value
            Err(reason): reason
        expect(command).to_equal("exec '/private/MCP'\"'\"'s/server' < '/private/input.txt'")

    # @inline
    # @capture(protocol)
    slow_it "handles initialize, tools/list, and unknown-tool MCP startup flows":
        # @step: Operator sends initialize, Codex framed startup, JSONL tools/list, and unknown-tool calls
        val single_output = send_mcp(init_request("1"))
        expect(single_output.contains("\"protocolVersion\":\"2025-06-18\"")).to_equal(true)
        expect(single_output.contains("\"simple-mcp-full\"")).to_equal(true)
        expect(single_output.contains("\"error\":")).to_equal(false)

        val init = "{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"spec\",\"version\":\"1.0\"}}}"
        val initialized = "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\",\"params\":{}}"
        val req = "{\"jsonrpc\":\"2.0\",\"id\":\"2\",\"method\":\"tools/list\",\"params\":{}}"
        val input = mcp_msg(init) + mcp_msg(initialized) + mcp_msg(req)
        val output = send_mcp(input)
        val output_frames_valid = has_valid_content_length_frames(output)
        expect(output_frames_valid).to_equal(true)
        expect(output.contains("Content-Length: 2305843009213693951")).to_equal(false)
        expect(output.contains("\"protocolVersion\":\"2025-06-18\"")).to_equal(true)
        expect(output.contains("\"tools\":")).to_equal(true)
        expect(output.contains("\"inputSchema\":")).to_equal(true)

        val jsonl_tools = mcp_jsonl(init) + mcp_jsonl("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}") + mcp_jsonl(req)
        val jsonl_output = send_mcp(jsonl_tools)
        expect(jsonl_output.contains("\"protocolVersion\":\"2025-06-18\"")).to_equal(true)
        expect(jsonl_output.contains("\"tools\":")).to_equal(true)
        expect(jsonl_output.contains("\"inputSchema\":")).to_equal(true)
        expect(jsonl_output.contains("\"name\":\"debug_create_session\"")).to_equal(true)
        expect(jsonl_output.contains("\"error\":")).to_equal(false)

        val unknown_req = "{\"jsonrpc\":\"2.0\",\"id\":\"2\",\"method\":\"tools/call\",\"params\":{\"name\":\"no_such_tool\",\"arguments\":{}}}"
        val unknown_input = mcp_jsonl(init) + mcp_jsonl("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}") + mcp_jsonl(unknown_req)
        val unknown_output = send_mcp(unknown_input)
        expect(unknown_output.contains("\"isError\":true")).to_equal(true)
        expect(unknown_output.contains("Unknown tool")).to_equal(true)
        expect(unknown_output.contains("\"error\":")).to_equal(false)
