"""Integration: runner -> phase2 compiler -> result reporting, for all 4 kinds.

Drives `run_test_file_interpreter` with `--compiler=phase2` and
SIMPLE_PHASE2_FULL_CLI pointing at a recording stand-in CLI that delegates to
the real binary. Asserts (a) the stand-in was actually invoked for each kind
(positive phase2 identity), and (b) the reported TestFileResult is a real
pass/fail: a red fixture is failed, not skipped and not error-free.

# @req REQ-TESTRUNNER-PHASE2-4KINDS
"""

use std.spec.*
use std.spec.step
use app.test_runner_new.test_runner_args.{parse_test_args}
use std.test_runner.test_runner_execute.{run_test_file_interpreter}
use std.nogc_sync_mut.io.env_ops.{env_get, env_set}
use test.support.phase2_kinds_fixture.{KIND_NAMES, phase2_fixture_root, phase2_write_fixture, phase2_write_recording_cli, phase2_log}

val SHA: text = "abababababababababababababababababababababababababababababababab"

fn real_binary() -> text:
    val b = env_get("SIMPLE_BINARY")
    if b != "":
        return b
    "bin/simple"

describe "runner executes each kind through the phase2 compiler":
    it "invokes phase2 for every kind and reports real pass/fail":
        step("Create fixtures for unit, integration, system, smoke")
        val root = phase2_fixture_root("phase2-kinds-int-")
        expect(root).to_start_with("/")
        val cli = phase2_write_recording_cli(root, real_binary())
        env_set("SIMPLE_PHASE2_FULL_CLI", cli)
        env_set("SIMPLE_PHASE2_FULL_CLI_SHA256", SHA)
        val options = parse_test_args(["--compiler=phase2", "--no-cache", "--sequential"])
        var i = 0
        while i < 4:
            val green = run_test_file_interpreter(phase2_write_fixture(root, i, false), options)
            val red = run_test_file_interpreter(phase2_write_fixture(root, i, true), options)
            step("{KIND_NAMES[i]}: green passes, red fails")
            expect(green.passed).to_equal(1)
            expect(green.failed).to_equal(0)
            expect(red.failed).to_equal(1)
            expect(red.skipped).to_equal(0)
            expect(red.passed).to_equal(0)
            i = i + 1
        step("The phase2 CLI saw every fixture")
        val log = phase2_log(cli)
        for kind in KIND_NAMES:
            expect(log).to_contain(kind + "_green_spec.spl")
            expect(log).to_contain(kind + "_red_spec.spl")

    it "does not fall back to another binary when phase2 is unusable":
        env_set("SIMPLE_PHASE2_FULL_CLI", "")
        val root = phase2_fixture_root("phase2-kinds-int2-")
        val options = parse_test_args(["--compiler=phase2", "--no-cache", "--sequential"])
        val r = run_test_file_interpreter(phase2_write_fixture(root, 0, false), options)
        expect(r.failed).to_equal(1)
        expect(r.error).to_contain("SIMPLE_PHASE2_FULL_CLI")
