"""Integration: runner flags and environment resolve to the phase2 CLI.

# @req REQ-TESTRUNNER-PHASE2-4KINDS
"""

use std.spec.*
use app.test_runner_new.test_runner_args.{parse_test_args}
use std.test_runner.compiler_select.{resolve_test_compiler}
use std.nogc_sync_mut.io.env_ops.{env_set}

val SHA: text = "abababababababababababababababababababababababababababababababab"

describe "runner to phase2 compiler":
    it "resolves the CLI named by SIMPLE_PHASE2_FULL_CLI":
        env_set("SIMPLE_PHASE2_FULL_CLI", "/p2/simple")
        env_set("SIMPLE_PHASE2_FULL_CLI_SHA256", SHA)
        val options = parse_test_args(["--compiler=phase2", "--smoke"])
        val cli = resolve_test_compiler(options.compiler, "/p2/simple", SHA, "")
        expect(cli.unwrap()).to_equal("/p2/simple")
    it "reports a clear error when SIMPLE_PHASE2_FULL_CLI is empty":
        val options = parse_test_args(["--compiler=phase2"])
        val cli = resolve_test_compiler(options.compiler, "", SHA, "")
        expect(cli.unwrap_err()).to_contain("SIMPLE_PHASE2_FULL_CLI")
