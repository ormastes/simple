"""Integration: runner flags resolve to the phase2 CLI through the production parser.

# @req REQ-TESTRUNNER-PHASE2-4KINDS
"""

use std.spec.*
use std.test_runner.test_runner_args.{parse_test_args}
use std.test_runner.test_runner_types.{TestLevel}
use std.test_runner.compiler_select.{resolve_test_compiler}

val SHA: text = "abababababababababababababababababababababababababababababababab"

describe "runner to phase2 compiler":
    it "parses --compiler=phase2 --smoke and resolves the named CLI":
        val options = parse_test_args(["--compiler=phase2", "--smoke"])
        expect(options.compiler).to_equal("phase2")
        expect(options.level == TestLevel.Smoke).to_equal(true)
        expect(options.session_daemon).to_equal(false)
        expect(resolve_test_compiler(options.compiler, "/p2/simple", SHA, "/seed/simple").unwrap()).to_equal("/p2/simple")
    it "keeps the explicit binary when no compiler is selected":
        val options = parse_test_args(["--smoke"])
        expect(resolve_test_compiler(options.compiler, "/p2/simple", SHA, "/seed/simple").unwrap()).to_equal("/seed/simple")
    it "reports a clear error when the phase2 CLI path is empty":
        val options = parse_test_args(["--compiler", "phase2"])
        expect(resolve_test_compiler(options.compiler, "", SHA, "").unwrap_err()).to_contain("requires SIMPLE_PHASE2_FULL_CLI")
