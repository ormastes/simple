# @manual: primary
# Native parser contract used by bug-add date and line parsing.

use std.spec.{describe, it, expect}
use std.spec.step

describe "bug-add checked text integer parsing":
    it "preserves signed i64 endpoints":
        step("Verify: preserves signed i64 endpoints")
        val max_value: i64 = 9223372036854775807
        val min_value: i64 = 0 - 9223372036854775807 - 1
        expect("9223372036854775807".parse_int() ?? 0).to_equal(max_value)
        expect("-9223372036854775808".parse_int() ?? 0).to_equal(min_value)

    it "accepts signed values above 2^60 and surrounding whitespace":
        step("Verify: accepts full-range signed and trimmed values")
        expect("1152921504606847099".parse_int() ?? 0).to_equal(1152921504606847099)
        expect("  +17 \t".parse_int() ?? 0).to_equal(17)
        expect(" -19 ".parse_int() ?? 0).to_equal(-19)

    it "rejects empty, sign-only, malformed, and overflowing values":
        step("Verify: rejects malformed and overflowing values")
        expect("".parse_int()).to_be_nil()
        expect("+".parse_int()).to_be_nil()
        expect("-".parse_int()).to_be_nil()
        expect("12x".parse_int()).to_be_nil()
        expect("9223372036854775808".parse_int()).to_be_nil()
        expect("-9223372036854775809".parse_int()).to_be_nil()

    it "preserves the bug-add invalid line fallback":
        step("Verify: preserves invalid line fallback")
        expect("12x".parse_int() ?? 0).to_equal(0)
