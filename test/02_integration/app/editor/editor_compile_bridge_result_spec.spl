# REQ-EDITOR-JIT-001: optimized compile bridge preserves its failure tuple.
# AUTHORED_UNRUN: requires an admitted source-matched runtime. Native/JIT and
# interpreter results must be recorded separately; interpreter PASS cannot
# qualify the native runtime export used by the editor's JIT import closure.
use std.spec.*
use std.sffi.cli.{compile_to_native_with_opt}

describe "REQ-EDITOR-JIT-001 optimized editor compile bridge":
    it "should return a readable failure tuple for missing input at level zero":
        step("Request native compilation of a missing source")
        val result = compile_to_native_with_opt("/__simple_editor_missing_source_20261103__.spl", "", "0")
        step("Inspect the failure result without entering code generation")
        expect(result.0).to_equal(false)
        expect(result.1.len()).to_be_greater_than(0)

    it "should preserve failure tuple fields for optimized compilation":
        step("Request optimized compilation of the same missing source")
        val result = compile_to_native_with_opt("/__simple_editor_missing_source_20261103__.spl", "", "2")
        step("Inspect both fields of the native bridge result")
        expect(result.0).to_equal(false)
        expect(result.1.len()).to_be_greater_than(0)

    it "should report missing input with an invalid optimization request":
        step("Request compilation with missing input and an invalid optimization level")
        val result = compile_to_native_with_opt("/__simple_editor_missing_source_20261103__.spl", "", "invalid")
        step("Require a structured diagnostic rather than an invalid tuple handle")
        expect(result.0).to_equal(false)
        expect(result.1.len()).to_be_greater_than(0)
