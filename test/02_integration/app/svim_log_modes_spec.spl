use std.spec.{describe, it, expect}
use test.helpers.simple_cli_spawn_fixture.{simple_cli_run}

fn _run_svim(args: [text]) -> (text, text, i64):
    simple_cli_run(["src/app/svim/main.spl"] + args, 120000)

describe "svim log mode CLI options":
    # @manual scenario evidence
    it "shows shared log options in help":
        val (out, err, code) = _run_svim(["--help"])
        expect(code).to_equal(0)
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json for ready output":
        val (out, err, code) = _run_svim(["--log-mode=json"])
        expect(code).to_equal(0)
        expect(out).to_contain("\"command\":\"svim\"")
        expect(out).to_contain("\"status\":\"ready\"")

    it "supports dot progress for help output":
        val (out, err, code) = _run_svim(["--progress=dot", "--help"])
        expect(code).to_equal(0)
        expect(out).to_start_with(".")
        expect(out).to_contain("Host-side svim")

    it "rejects invalid log mode":
        val (out, err, code) = _run_svim(["--log-mode=noisy"])
        expect(code).to_equal(1)

    it "emits json for unknown options":
        val (out, err, code) = _run_svim(["--log-mode=json", "--bogus"])
        expect(code).to_equal(1)
        expect(out).to_contain("\"command\":\"svim\"")
        expect(out).to_contain("\"status\":\"error\"")
