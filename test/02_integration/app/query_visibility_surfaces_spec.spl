# Host-portable spawn: the shared CLI fixture runs bin/simple on the current
# host (cmd.exe on Windows, /bin/sh elsewhere) with SIMPLE_LIB bound; the
# POSIX-only raw rt_process_run + /bin/sh harness cannot spawn on Windows.
use test.helpers.simple_cli_spawn_fixture.{simple_cli_run}
use std.spec

fn check(condition: bool):
    expect(condition).to_equal(true)

describe "query_visibility CLI surfaces":
    it "reports scoped peer and up visibility in structured JSON":
        val (stdout, stderr, code) = simple_cli_run(
            ["src/app/cli/query_visibility.spl", "symbols", "src/compiler/10.frontend/testdata/visibility_query_fixture.spl", "--requester", "src/compiler/35.semantics/testdata/visibility_query_fixture.spl"],
            120000
        )

        expect(code).to_equal(0)
        check(stdout.contains("\"name\":\"peer_api\""))
        check(stdout.contains("\"display\":\"peer\""))
        check(stdout.contains("\"declared\":\"peer\""))
        check(stdout.contains("\"reachable\":true"))
        check(stdout.contains("\"name\":\"parent_api\""))
        check(stdout.contains("\"display\":\"up\""))
        check(stdout.contains("\"declared\":\"up\""))
        check(stdout.contains("\"reachable\":false"))
        check(stderr == "")

    it "hover returns markdown contents plus simpleVisibility":
        val (stdout, stderr, code) = simple_cli_run(
            ["src/app/cli/query_visibility.spl", "hover", "src/lib/nogc_sync_mut/lsp/main.spl", "43", "4"],
            120000
        )

        expect(code).to_equal(0)
        check(stdout.contains("\"contents\""))
        check(stdout.contains("\"kind\":\"markdown\""))
        check(stdout.contains("fn lsp_main():"))
        check(stdout.contains("\"simpleVisibility\""))
        check(stdout.contains("\"display\":\"private\""))
        check(stdout.contains("\"boundaryModule\":\"lib.nogc_sync_mut.lsp\""))
        check(stderr == "")

    it "completions return structured visibility in item data":
        val (stdout, stderr, code) = simple_cli_run(
            ["src/app/cli/query_visibility.spl", "completions", "src/lib/nogc_sync_mut/lsp/main.spl", "43", "4"],
            120000
        )

        expect(code).to_equal(0)
        check(stdout.contains("\"label\":\"lsp_main\""))
        check(stdout.contains("\"detail\":\"[private] fn\""))
        check(stdout.contains("\"data\":{\"simpleVisibility\""))
        check(stdout.contains("\"display\":\"private\""))
        check(stderr == "")

    it "document symbols include simpleVisibility on returned symbols":
        val (stdout, stderr, code) = simple_cli_run(
            ["src/app/cli/query_visibility.spl", "symbols", "src/lib/nogc_sync_mut/lsp/main.spl", "--requester", "src/lib/nogc_sync_mut/lsp/main.spl"],
            120000
        )

        expect(code).to_equal(0)
        check(stdout.contains("\"name\":\"lsp_main\""))
        check(stdout.contains("\"selectionRange\""))
        check(stdout.contains("\"simpleVisibility\""))
        check(stdout.contains("\"boundaryKind\":\"boundary\""))
        check(stderr == "")

    it "semantic-tokens returns full-style JSON data":
        val (stdout, stderr, code) = simple_cli_run(
            ["src/app/cli/query_visibility.spl", "semantic-tokens", "src/app/cli/query_visibility.spl"],
            120000
        )

        expect(code).to_equal(0)
        check(stdout.starts_with("{\"data\":["))
        check(stdout.contains(","))
        check(stderr == "")

    it "semantic-tokens supports a scoped line range":
        val (full_stdout, full_stderr, full_code) = simple_cli_run(
            ["src/app/cli/query_visibility.spl", "semantic-tokens", "src/app/cli/query_visibility.spl"],
            120000
        )
        val (range_stdout, range_stderr, range_code) = simple_cli_run(
            ["src/app/cli/query_visibility.spl", "semantic-tokens", "src/app/cli/query_visibility.spl", "--start-line", "1", "--end-line", "40"],
            120000
        )

        expect(full_code).to_equal(0)
        expect(range_code).to_equal(0)
        check(full_stdout.contains("\"data\":["))
        check(range_stdout.contains("\"data\":["))
        check(range_stdout.len() < full_stdout.len())
        check(full_stderr == "")
        check(range_stderr == "")
