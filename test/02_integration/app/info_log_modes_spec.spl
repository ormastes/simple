"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the info command (--log-mode
and --progress) as observed through real process invocations against a
fixture working directory.
Audience: compiler and tooling engineers who maintain the info app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/info_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the info command's shared log options and its project/package inquiry
modes only; each scenario spawns real `bin/simple` processes and builds its
fixture under /tmp with a package: simple.sdn for sample-info v1.2.3.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: info-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_info_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + " && cat > " + FIXTURE_DIR + "/simple.sdn <<'EOF'\npackage:\n  name: sample-info\n  version: 1.2.3\n  license: MIT\n  main: src/main.spl\nEOF"
    ])

fn _run_info(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/info/main.spl\" " + joined
    ])

describe "info log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-INFO-LOGMODE-001
        # @capture(tui_grid): info help text listing the shared log options
        step("Run info --help in the fixture directory")
        _setup_fixture()
        val (out, err, code) = _run_info(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports project log-mode json":
        # @req REQ-INFO-LOGMODE-001
        # @capture(protocol_json): project JSON envelope carrying the fixture package identity
        step("Inquire the fixture project with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_info(["--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed inquiry
        expect(out).to_contain("\"command\":\"info\"")
        expect(out).to_contain("\"kind\":\"project\"")
        expect(out).to_contain("\"name\":\"sample-info\"")

    it "supports package log-mode json":
        # @req REQ-INFO-LOGMODE-001
        # @capture(protocol_json): package JSON envelope echoing the queried package name
        step("Inquire the sample-pkg package with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_info(["sample-pkg", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed inquiry
        expect(out).to_contain("\"kind\":\"package\"")
        expect(out).to_contain("\"name\":\"sample-pkg\"")

    it "supports dot progress":
        # @req REQ-INFO-LOGMODE-001
        # @capture(tui_grid): dot-progress output followed by the project info banner
        step("Inquire the fixture project with dot progress")
        _setup_fixture()
        val (out, err, code) = _run_info(["--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed inquiry
        expect(out).to_start_with(".")
        expect(out).to_contain("Project Info")

    it "rejects invalid log mode":
        # @req REQ-INFO-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke info with an unknown log mode and expect a usage error")
        _setup_fixture()
        val (out, err, code) = _run_info(["--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
