# @tag:in-development
"""
## Inspect structural trace resolution across production modules

Audience: maintainers validating the immutable extractor, resolver, SDN codec
and query boundary together before CLI admission is wired.

The supplied snapshot is a fixture. These scenarios call production functions;
they do not execute Git, the deployed CLI, a test runner child, or Slop's native
window. They supplement AC-TRC-003/007/009 and do not complete those system gates.

## Verification and troubleshooting

Run with the admitted Phase 4 runtime and include in-development scenarios.
Missing imports, rejected serialization or unresolved mappings must fail the
scenario. No execution or capture has been recorded at authoring time.
"""
# @manual_section: immutable-snapshot-integration
# Lifecycle: doc/01_research/local/simple_traceability_sdn_slop.md
# doc/03_plan/sys_test/simple_traceability_sdn_slop.md
# doc/04_architecture/simple_traceability_sdn_slop.md
# doc/05_design/simple_traceability_sdn_slop.md
use std.spec.{describe, it, expect, step, fail}
use std.common.traceability.model.*
use std.common.traceability.resolve.{resolve_trace_graph}
use std.common.traceability.sdn_codec.{encode_trace_document, decode_trace_document}
use std.common.traceability.query.{query_trace_graph}
use app.traceability.extract.snapshot_facts.{extract_snapshot_trace_facts}

fn snapshot_graph_policy() -> TracePolicy:
    TracePolicy(id: "policy:integration", authorities: [], max_nodes: 100, max_claims: 100,
        conventions: [TraceConventionRule(id: "app-unit-v1", source_root: "src/app/",
            target_root: "test/01_unit/app/", source_suffix: ".spl",
            target_suffix: "_spec.spl", relation: TraceRelation.Targets, version: "1")])

fn snapshot_graph_fixture(include_test: bool, snapshot_id: text) -> SnapshotInput:
    var artifacts = [SnapshotArtifact(path: "src/app/parser.spl", blob_id: "blob:source",
        content: "fn parse(): 1", visibility: "public")]
    if include_test:
        artifacts.push(SnapshotArtifact(path: "test/01_unit/app/parser_spec.spl", blob_id: "blob:test",
            content: "# Quoted example REQ-EXAMPLE accepted_by test:invented", visibility: "public"))
    SnapshotInput(subject: SnapshotSubject(repository_id: "simple", snapshot_id: snapshot_id,
        kind: "git_tree", revision_id: "revision:fixture", tree_id: "tree:fixture", object_format: "sha256"),
        artifacts: artifacts, complete: true)

fn snapshot_graph_resolve(snapshot: SnapshotInput) -> TraceGraph:
    val policy = snapshot_graph_policy()
    val facts = extract_snapshot_trace_facts(snapshot, policy, [], "inputs:fixture", "generation:fixture")
    resolve_trace_graph(facts, policy)

fn snapshot_graph_entity_at(graph: TraceGraph, path: text) -> text:
    for locator in graph.locators:
        if locator.path == path:
            return locator.entity_id
    ""

describe "Immutable extraction, resolution and interchange":
    it "derives the test target and preserves it through the real SDN codec":
        # @req REQ-TRC-001 REQ-TRC-004 REQ-TRC-007
        # @ac AC-TRC-003
        step("Prepare a frozen source and conventional test without authored link rows")
        val graph = snapshot_graph_resolve(snapshot_graph_fixture(true, "snapshot:paired"))
        val source_id = snapshot_graph_entity_at(graph, "src/app/parser.spl")
        val test_id = snapshot_graph_entity_at(graph, "test/01_unit/app/parser_spec.spl")
        expect(graph.complete).to_equal(true)
        expect(graph.edges.len()).to_equal(1)
        expect(graph.edges[0].from_id).to_equal(test_id)
        expect(graph.edges[0].to_id).to_equal(source_id)
        expect(graph.edges[0].relation).to_equal(TraceRelation.Targets)

        step("Encode and decode the actual resolved graph using the shared SDN path")
        val document = TraceDocument(schema_name: "simple.trace.graph", schema_version: 1, graph: graph)
        match encode_trace_document(document):
            case Err(_): fail("resolved fixture graph could not be encoded")
            case Ok(wire):
                match decode_trace_document(wire):
                    case Err(_): fail("shared codec rejected its graph output")
                    case Ok(decoded):
                        expect(decoded.graph.subject.snapshot_id).to_equal("snapshot:paired")
                        expect(decoded.graph.edges[0].id).to_equal(graph.edges[0].id)
                        expect(decoded.graph.edge_origins[0].origin_id).to_equal("convention:app-unit-v1")
                        step("Query the decoded graph by the exact pinned source identity")
                        val page = query_trace_graph(decoded.graph, TraceQuery(snapshot_id: "snapshot:paired",
                            selected_id: source_id, direction: "incoming", limit: 10, cursor: ""))
                        expect(page.complete).to_equal(true)
                        expect(page.total_count).to_equal(2)
                        expect(page.edges.len()).to_equal(1)
                        expect(page.edges[0].from_id).to_equal(test_id)

    it "does not turn requirement prose in a test file into acceptance or execution":
        # @req REQ-TRC-002 REQ-TRC-013
        # @ac AC-TRC-007
        step("Resolve a test artifact whose comment contains a requirement example")
        val graph = snapshot_graph_resolve(snapshot_graph_fixture(true, "snapshot:quoted"))
        expect(graph.nodes.len()).to_equal(2)
        expect(graph.test_definitions.len()).to_equal(0)
        expect(graph.edges.len()).to_equal(1)
        expect(graph.edges[0].relation).to_equal(TraceRelation.Targets)
        step("Inspect the graph without inventing executed case definitions")
        for node in graph.nodes:
            expect(node.kind == TraceNodeKind.Requirement).to_equal(false)
            expect(node.kind == TraceNodeKind.Observation).to_equal(false)

    it "reports a missing conventional target when it is absent from the snapshot":
        # @req REQ-TRC-006 REQ-TRC-007
        # @ac AC-TRC-009
        step("Resolve an exact inventory containing the source but no conventional test")
        val graph = snapshot_graph_resolve(snapshot_graph_fixture(false, "snapshot:deleted"))
        expect(graph.complete).to_equal(false)
        expect(graph.edges.len()).to_equal(0)
        var matching = 0
        step("Inspect the diagnostic subject, mapping rule and missing endpoint")
        for diagnostic in graph.diagnostics:
            if diagnostic.code == "TRACE-MISSING-ENDPOINT":
                matching = matching + 1
                expect(diagnostic.subject_id).to_equal("snapshot:deleted")
                expect(diagnostic.rule_id).to_equal("app-unit-v1")
                expect(diagnostic.message).to_contain("test/01_unit/app/parser_spec.spl")
        expect(matching).to_equal(1)
