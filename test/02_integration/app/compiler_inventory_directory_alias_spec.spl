"""POSIX real-Git directory-alias lifecycle. Authored; execution UNRUN."""
use std.spec.*
use app.io.mod.{process_run_bounded}
use app.io.file_ops.{path_absolute}
use std.io_runtime.{dir_create_all, file_write, file_read, file_exists, file_delete}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir}
use std.scv.compile_source_inventory.{compile_source_inventory_read_pointer_content_v1}
use app.compiler_entrypoint.source_authority.{compiler_source_authority_acquire_v1}

fn alias_fixture_git(root: text, args: [text]) -> bool:
    val (_stdout, _stderr, status) = process_run_bounded("git",
        ["-C", root, "-c", "core.hooksPath=", "-c", "commit.gpgsign=false"] + args,
        30000, 1048576)
    status == 0

fn alias_fixture_link(root: text, path: text, target: text) -> bool:
    val (_stdout, _stderr, status) = process_run_bounded("ln",
        ["-s", "--", target, root + "/" + path], 30000, 1048576)
    status == 0

fn alias_inventory_lifecycle() -> text:
    val parent = path_absolute("build/test-artifacts")
    if not dir_create_all(parent): return "parent"
    val allocated = secure_temp_dir(parent, "directory-alias-")
    if allocated.is_err(): return "allocate"
    val root = allocated.unwrap()
    val cache = root + "/build/scv"
    for directory in ["src/app", "test", "examples/a", "examples/b", "examples/c", "build"]:
        if not dir_create_all(root + "/" + directory): return "mkdir:" + directory
    val a = "pub fn t32_cli_main() -> i64: 17\n"
    val b = "pub fn t32_cli_main() -> i64: 29\n"
    if not file_write(root + "/src/direct.spl", "fn direct() -> i64: 3\n"): return "direct"
    if not file_write(root + "/examples/a/mod.spl", a): return "owner-a"
    if not file_write(root + "/examples/b/mod.spl", b): return "owner-b"
    if not file_write(root + "/examples/c/other.spl", b): return "owner-c"
    if not file_write(root + "/.gitignore", "build/\n"): return "ignore"
    if not alias_fixture_link(root, "src/app/t32_cli", "../../examples/a"): return "alias"
    if not alias_fixture_link(root, "src/app/second", "../../examples/a"): return "second"
    if not alias_fixture_git(root, ["init", "-q"]): return "git-init"
    if not alias_fixture_git(root, ["add", "src", "examples", ".gitignore"]): return "git-add"
    if not alias_fixture_git(root, ["-c", "user.name=Alias fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", "fixture"]): return "git-commit"
    val cold = compiler_source_authority_acquire_v1(root, cache, ["src", "test"], true)
    if not cold.valid: return "cold:" + cold.reason
    val logical = "/src/app/t32_cli/mod.spl"
    if file_read(cold.snapshot.snapshot_root + logical) != a: return "cold-bytes"
    if file_read(cold.snapshot.snapshot_root + "/src/app/second/mod.spl") != a: return "second-bytes"
    val old_manifest = file_read(cold.snapshot.snapshot_root + "/SCV_COMPILE_INVENTORY")
    val unchanged = compiler_source_authority_acquire_v1(root, cache, ["src", "test"], false)
    if not unchanged.valid: return "unchanged:" + unchanged.reason
    if unchanged.inventory_generation != cold.inventory_generation: return "unchanged-generation"
    if not file_write(root + "/examples/a/mod.spl", b): return "modify"
    val changed = compiler_source_authority_acquire_v1(root, cache, ["src", "test"], false)
    if not changed.valid: return "changed:" + changed.reason
    if changed.inventory_generation <= cold.inventory_generation: return "changed-generation"
    if file_read(changed.snapshot.snapshot_root + logical) != b: return "changed-bytes"
    if file_read(cold.snapshot.snapshot_root + logical) != a: return "old-bytes-mutated"
    # Retarget with identical names and different bytes: membership alone is insufficient.
    if not file_write(root + "/examples/b/mod.spl", a): return "retarget-owner"
    if not file_delete(root + "/src/app/t32_cli"): return "unlink"
    if not alias_fixture_link(root, "src/app/t32_cli", "../../examples/b"): return "retarget"
    val retarget = compiler_source_authority_acquire_v1(root, cache, ["src", "test"], false)
    if not retarget.valid: return "retarget:" + retarget.reason
    if file_read(retarget.snapshot.snapshot_root + logical) != a: return "retarget-bytes"
    # Removed owner file disappears only from the alias targeting that owner.
    if not file_delete(root + "/examples/b/mod.spl"): return "delete-child"
    val deleted = compiler_source_authority_acquire_v1(root, cache, ["src", "test"], false)
    if not deleted.valid: return "deleted:" + deleted.reason
    if file_exists(deleted.snapshot.snapshot_root + logical): return "deleted-retained"
    if file_read(deleted.snapshot.snapshot_root + "/src/app/second/mod.spl") != b: return "unrelated-alias-lost"
    # A newly staged alias has no HEAD history; the admitted membership owns deletion.
    if not alias_fixture_link(root, "src/app/staged", "../../examples/a"): return "stage-link"
    if not alias_fixture_git(root, ["add", "src/app/staged"]): return "stage-add"
    val staged = compiler_source_authority_acquire_v1(root, cache, ["src", "test"], false)
    if not staged.valid: return "staged:" + staged.reason
    if file_read(staged.snapshot.snapshot_root + "/src/app/staged/mod.spl") != b: return "staged-bytes"
    if not file_delete(root + "/src/app/staged"): return "stage-delete"
    val removed = compiler_source_authority_acquire_v1(root, cache, ["src", "test"], false)
    if not removed.valid: return "removed:" + removed.reason
    if file_exists(removed.snapshot.snapshot_root + "/src/app/staged/mod.spl"): return "stage-retained"
    if not file_delete(root + "/src/app/t32_cli"): return "different-unlink"
    if not alias_fixture_link(root, "src/app/t32_cli", "../../examples/c"): return "different-link"
    val different = compiler_source_authority_acquire_v1(root, cache, ["src", "test"], false)
    if not different.valid: return "different:" + different.reason
    if file_exists(different.snapshot.snapshot_root + logical): return "different-old"
    if file_read(different.snapshot.snapshot_root + "/src/app/t32_cli/other.spl") != b: return "different-new"
    val pointer = compile_source_inventory_read_pointer_content_v1(cache) ?? ""
    # An outside owner must fail before CURRENT changes.
    if not file_delete(root + "/src/app/t32_cli"): return "escape-unlink"
    if not alias_fixture_link(root, "src/app/t32_cli", "../../../"): return "escape-link"
    val rejected = compiler_source_authority_acquire_v1(root, cache, ["src", "test"], false)
    if rejected.valid: return "escape-admitted"
    if (compile_source_inventory_read_pointer_content_v1(cache) ?? "") != pointer: return "escape-published"
    if file_read(cold.snapshot.snapshot_root + "/SCV_COMPILE_INVENTORY") != old_manifest: return "old-manifest-mutated"
    "ok"

describe "compiler directory alias source admission":
    it "freezes real logical providers and reconciles warm owner lifecycle without breaking custody":
        expect(alias_inventory_lifecycle()).to_equal("ok")
