# Reference legacy-v1 compatibility through actual signed checkpoint import.
# Source-only: no admitted runtime. Paged legacy replay and an independently
# recorded golden v1 wire vector remain separate, unclaimed coverage.
use std.spec.*
use app.io.mod.{file_delete}
use app.scv.db.local_store.{db_store_read}
use app.scv.db.local_transition.{db_read_local_view}
use app.scv.db.observation_owner.{db_observation_apply_reference}
use app.scv.db.observation_content.{db_observation_limits}
use app.scv.db.checkpoint_store.{db_checkpoint_prepare_install}
use std.scv.db_checkpoint.{db_checkpoint_encode}
use std.scv.db_patch_codec.{db_patch_encode}
use std.scv.db_reproduction_codec.{db_reproduction_record_encode}
use std.scv.db_reproduction_projection.{db_reproduction_row}
use test.fixtures.scv.db_observation_fixture.*
use test.fixtures.scv.db_legacy_replay_fixture.*

describe "Historical v1 accepted replay under current source mapping admission":
    it "rejects fresh legacy custom failure and imports only an authenticated historical accepted image":
        val fixture = setup_item2_legacy_replay()
        val context = fixture.observation
        val before = db_store_read(context.source)
        val retained = db_store_read(context.source, "retention")
        expect(db_observation_apply_reference(context.source, "", context.patch, context.policy.config, context.sources, db_observation_limits()).unwrap_err()).to_equal("SCVDB_REPRODUCTION_MAPPING_REQUIRED")
        expect(db_store_read(context.source)).to_equal(before)
        expect(db_store_read(context.source, "retention")).to_equal(retained)
        var forged = fixture.checkpoint
        forged.signature = [0u8;64]
        expect(db_checkpoint_prepare_install(context.source, "", db_checkpoint_encode(forged).unwrap(), fixture.authority, fixture.pages).is_err()).to_equal(true)
        expect(db_store_read(context.source)).to_equal(before)
        expect(db_store_read(context.source, "checkpoint-install").code).to_equal("empty")
        val imported = check_item2_legacy_import(fixture)
        expect(imported.len()).to_be_greater_than(0)
        expect(db_store_read(context.source).checkpoint_anchor).to_equal(fixture.checkpoint.revision)
        check_item2_observation_cleanup(context)

    it "replays exact original v1 bytes and captured head after artifact loss without refreshing availability":
        val fixture = setup_item2_legacy_replay()
        val context = fixture.observation
        val wire = db_patch_encode(context.patch).unwrap()
        val head = check_item2_legacy_import(fixture)
        val stored = db_store_read(context.source)
        val retained = db_store_read(context.source, "retention")
        expect(file_delete(context.sources.evidence_parent + "/scv-evidence-v1/" + context.available_digest + ".scve")).to_equal(true)
        val replay = db_observation_apply_reference(context.source, head, context.patch, context.policy.config, context.sources, db_observation_limits()).unwrap()
        expect(replay.code).to_equal("ok")
        expect(replay.replay).to_equal(true)
        expect(replay.head).to_equal(head)
        expect(replay.revision).to_equal(fixture.historical.revision)
        expect(db_patch_encode(context.patch).unwrap()).to_equal(wire)
        expect(db_store_read(context.source)).to_equal(stored)
        expect(db_store_read(context.source, "retention")).to_equal(retained)
        val restored = db_read_local_view(context.source, context.policy.config.admission).unwrap().image.state
        expect(restored.accepted).to_equal(fixture.historical.accepted)
        for row in restored.rows:
            expect(db_reproduction_record_encode(db_reproduction_row(row).unwrap()).unwrap().starts_with("SCVDB-REPRODUCTION-RECORD-v1\n")).to_equal(true)
        check_item2_observation_cleanup(context)

    it "requires current signature trust and exact head even for an accepted historical batch":
        val fixture = setup_item2_legacy_replay()
        val context = fixture.observation
        val head = check_item2_legacy_import(fixture)
        val before = db_store_read(context.source)
        expect(db_observation_apply_reference(context.source, "", context.patch, context.policy.config, context.sources, db_observation_limits()).unwrap_err()).to_equal("SCVDB_STORE_HEAD_ADVANCED")
        var forged = context.patch
        forged.signature = [0u8;64]
        expect(db_observation_apply_reference(context.source, head, forged, context.policy.config, context.sources, db_observation_limits()).unwrap_err()).to_equal("SCVDB_SIGNATURE_INVALID")
        var revoked = context.policy
        revoked.config.admission.keys[0].revoked = true
        revoked = setup_item2_observation_repin(revoked)
        expect(db_observation_apply_reference(context.source, head, context.patch, revoked.config, context.sources, db_observation_limits()).unwrap_err()).to_equal("SCVDB_KEY_REVOKED")
        expect(db_store_read(context.source)).to_equal(before)
        check_item2_observation_cleanup(context)
