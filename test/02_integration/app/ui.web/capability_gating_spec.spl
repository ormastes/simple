# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use app.ui.web.origin_guard.{OriginGuard}
use app.ui.web.session_token.{SessionToken}
use common.ui.capability.{Capability}
use common.ui.capability_policy.{CapabilityPolicy, check_capability, grant}

describe "OriginGuard.check":
    # @manual scenario evidence
    it "allows a matching origin":
        # @req REQ-SSPEC-INTEGRATION
        step("allows a matching origin")
        val guard = OriginGuard(allowed: ["https://app.example.com"])
        val headers = "Origin: https://app.example.com\r\nHost: app.example.com\r\n"
        val result = guard.check(headers)
        expect(result.is_ok()).to_equal(true)

describe "SessionToken":
    it "serializes a token with the grant id":
        # @req REQ-SSPEC-INTEGRATION
        step("serializes a token with the grant id")
        val tok = SessionToken.issue("dev", "https://app.example.com", 60000u64, "test-secret-key")
        expect(tok.serialize().contains(".dev.")).to_equal(true)

    it "percent-encodes dots in the serialized origin segment":
        # @req REQ-SSPEC-INTEGRATION
        step("percent-encodes dots in the serialized origin segment")
        val tok = SessionToken.issue("dev", "https://app.example.com", 60000u64, "test-secret-key")
        expect(tok.serialize().contains("%2E")).to_equal(true)

    it "rejects tokens with extra separators":
        # @req REQ-SSPEC-INTEGRATION
        step("rejects tokens with extra separators")
        val result = SessionToken.parse("token.dev.https%2E%2Eapp.example.com.123.sig.extra")
        expect(result.is_err()).to_be(true)

describe "CapabilityPolicy":
    it "default-deny policy denies InputInject":
        # @req REQ-SSPEC-INTEGRATION
        step("default-deny policy denies InputInject")
        val policy = CapabilityPolicy.new("win-1")
        val result = check_capability(policy, Capability.InputInject)
        expect(result.is_err()).to_equal(true)

    it "granting InputInject allows it":
        # @req REQ-SSPEC-INTEGRATION
        step("granting InputInject allows it")
        val policy = CapabilityPolicy.new("win-1")
        val granted_policy = grant(policy, Capability.InputInject)
        val result = check_capability(granted_policy, Capability.InputInject)
        expect(result.is_ok()).to_equal(true)
