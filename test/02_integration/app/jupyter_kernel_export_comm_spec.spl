# @cover src/app/jupyter_kernel/main.spl 40%
# `simple_export` comm — X4 (SDoctest export command), kernel-side handler.
#
# Design:  doc/05_design/app/tools/notebook_lanes_architecture.md §7.3/§7.4
# Plan:    doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md (Stream X, X4)
#
# The JupyterLab "Export notebook as SDoctest" command
# (tools/jupyter/labextension/src/export.ts) opens a `simple_export` comm
# whose comm_open payload is an
# `{"action":"export_sdoctest","in_path":...,"out_path":...}` request; the
# kernel-side handler (`handle_export_request` in
# src/app/jupyter_kernel/main.spl) runs L1's shared exporter
# (src/app/simple_lab/export_sdoctest.spl `export_notebook_file`) against it
# and replies with `{"status":"ok","out_path":...}` over the same comm.
#
# This spec spawns a REAL kernel subprocess (same pattern as
# test/02_integration/app/tools/notebook/lsp_bridge_spec.spl) and drives it
# through a real comm_open -> comm_msg round trip over JSON-lines
# stdin/stdout, then confirms the exported file actually passes
# `simple test --sdoctest` — the same end-to-end check L1's own
# export_sdoctest_spec.spl establishes for the exporter itself.

# tag: slow, system

use std.spec.{describe, it, expect}
use std.io.{file_write, file_read, file_exists, file_delete, thread_sleep_ms, shell_output_trimmed}
use std.nogc_sync_mut.io.{process_spawn_piped, process_write_stdin, process_read_stdout, process_close_piped}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.notebook.ipynb.{NbNotebook, NbCell, ipynb_serialize}

val FIXTURE_DIR = "test/02_integration/app/fixtures/jupyter_kernel_export"
val FIXTURE_IPYNB = "{FIXTURE_DIR}/export_hello.ipynb"
val FIXTURE_SDOCTEST_MD = "{FIXTURE_DIR}/export_hello.sdoctest.md"

fn _piped_process_extern_available() -> bool:
    """Same capability probe as lsp_bridge_spec.spl: `rt_process_spawn_piped`
    is a pre-existing gap in the interpreter build's extern dispatch table
    (doc/08_tracking/bug/interpreter_sffi_missing_piped_process_externs_2026-07-29.md).
    Probe out-of-process first so a missing capability skips cleanly instead
    of hard-failing every `it` in this file."""
    val probe_path = "/tmp/simple_lsp_test_export_comm_capability_probe.spl"
    val probe_src = "use std.nogc_sync_mut.io.{process_spawn_piped}\n\nfn main():\n    val pid = process_spawn_piped(\"true\", [])\n    if pid > 0:\n        print \"PIPED_OK\"\n    else:\n        print \"PIPED_FAIL\"\n"
    file_write(probe_path, probe_src)
    val output = shell_output_trimmed("bin/simple run {probe_path} 2>/dev/null", "")
    file_delete(probe_path)
    output.contains("PIPED_OK")

fn _make_hello_notebook_json() -> text:
    val cell = NbCell(
        cell_type: "code",
        metadata_json: "{}",
        source: "print(\"Hello, Simple Lab!\")",
        has_execution_count: false,
        execution_count: -1,
        outputs: []
    )
    val nb = NbNotebook(nbformat_minor: 5, metadata_json: "{}", cells: [cell])
    ipynb_serialize(nb)

fn _json_escape(s: text) -> text:
    var result = s
    result = result.replace("\\", "\\\\")
    result = result.replace("\"", "\\\"")
    result

# Reads stdout chunks from `pid` until a line containing every string in
# `needles` is seen, or `timeout_ms` elapses. Returns that line, or "" on
# timeout -- mirrors the poll-with-thread_sleep_ms pattern used by
# src/app/debug/remote/protocol/gdb_mi.spl against the same piped-process
# primitives.
fn _read_line_containing(pid: i64, needles: [text], timeout_ms: i64) -> text:
    var buf = ""
    var waited = 0
    val poll_interval_ms = 100
    while waited < timeout_ms:
        val chunk = process_read_stdout(pid)
        if chunk != "":
            buf = buf + chunk
            for line in buf.split("\n"):
                var all_present = true
                for needle in needles:
                    if not line.contains(needle):
                        all_present = false
                if all_present and line.trim() != "":
                    return line
        thread_sleep_ms(poll_interval_ms)
        waited = waited + poll_interval_ms
    ""

describe "jupyter kernel `simple_export` comm (X4)":
    it "runs the L1 exporter and replies status:ok with the written sdoctest path":
        if not _piped_process_extern_available():
            print "SKIP: rt_process_spawn_piped is not registered in this interpreter build's extern dispatch table (pre-existing gap, not caused by this change — see doc/08_tracking/bug/interpreter_sffi_missing_piped_process_externs_2026-07-29.md)"
            return

        val nb_json = _make_hello_notebook_json()
        val wrote = file_write(FIXTURE_IPYNB, nb_json)
        expect(wrote).to_equal(true)
        file_delete(FIXTURE_SDOCTEST_MD)

        val pid = process_spawn_piped("bin/simple", ["run", "src/app/jupyter_kernel/main.spl"])
        expect(pid > 0).to_equal(true)

        val request = "{\"msg_type\":\"comm_open\",\"msg_id\":\"m1\",\"comm_id\":\"c1\",\"target_name\":\"simple_export\",\"data\":{\"action\":\"export_sdoctest\",\"in_path\":\"" + _json_escape(FIXTURE_IPYNB) + "\",\"out_path\":\"" + _json_escape(FIXTURE_SDOCTEST_MD) + "\"}}\n"
        process_write_stdin(pid, request)

        val reply_line = _read_line_containing(pid, ["comm_msg", "c1"], 20000)
        process_close_piped(pid)

        expect(reply_line).to_contain("\"status\":\"ok\"")
        expect(reply_line).to_contain(FIXTURE_SDOCTEST_MD)

        val written = file_read(FIXTURE_SDOCTEST_MD)
        expect(written).to_contain("```sdoctest")
        expect(written).to_contain(">>> print(\"Hello, Simple Lab!\")")

    it "the exported file passes `simple test --sdoctest`":
        if not _piped_process_extern_available():
            print "SKIP: rt_process_spawn_piped is not registered in this interpreter build's extern dispatch table"
            return
        if not file_exists(FIXTURE_SDOCTEST_MD):
            print "SKIP: previous `it` did not produce {FIXTURE_SDOCTEST_MD} (see its own assertions for the real failure)"
            return

        val run_result = process_run_bounded("bin/simple", ["test", "--sdoctest", FIXTURE_SDOCTEST_MD], 30000, 65536)
        val stdout = run_result.0
        val stderr = run_result.1
        val exit_code = run_result.2
        if exit_code != 0:
            fail("bin/simple test --sdoctest {FIXTURE_SDOCTEST_MD} exited {exit_code}\nstdout: {stdout}\nstderr: {stderr}")
        expect(exit_code).to_equal(0)
