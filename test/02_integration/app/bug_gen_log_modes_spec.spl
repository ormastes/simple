"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the bug-gen app (--log-mode
and --progress) as observed through real process invocations against a
fixture bug database.
Audience: compiler and tooling engineers who maintain the bug-gen app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/bug_gen_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the bug-gen shared log options only; each scenario spawns real
`bin/simple` processes and rebuilds a fixture bug database under /tmp.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: bug-gen-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_bug_gen_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + "/doc/08_tracking/bug && cat > " + FIXTURE_DIR + "/doc/08_tracking/bug/bug_db.sdn <<'EOF'\nbugs |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\n    BUG-1, P1, Open, \"fixture bug\", src/main.spl, 7, test, 2026-05-24, 2026-05-24, true\nEOF"
    ])

fn _run_bug_gen(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/bug_gen/main.spl\" " + joined
    ])

describe "bug-gen log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-BUGGEN-LOGMODE-001
        # @capture(tui_grid): bug-gen help text listing the shared log options
        step("Verify: shows shared log options in help")
        _setup_fixture()
        val (out, err, code) = _run_bug_gen(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json":
        # @req REQ-BUGGEN-LOGMODE-001
        # @capture(protocol_json): stdout JSON transcript of the bug-gen report
        step("Verify: supports log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_bug_gen(["--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a generated report
        expect(out).to_contain("\"command\":\"bug-gen\"")
        expect(out).to_contain("\"bugs\":1")

    it "supports dot progress":
        # @req REQ-BUGGEN-LOGMODE-001
        # @capture(tui_grid): dot-progress terminal output of the bug-gen run
        step("Verify: supports dot progress")
        _setup_fixture()
        val (out, err, code) = _run_bug_gen(["--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a generated report
        expect(out).to_start_with(".")
        expect(out).to_contain("Generated doc/08_tracking/bug/recent_bugs.md (1 bugs)")

    it "rejects invalid log mode":
        # @req REQ-BUGGEN-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Verify: rejects invalid log mode")
        _setup_fixture()
        val (out, err, code) = _run_bug_gen(["--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
