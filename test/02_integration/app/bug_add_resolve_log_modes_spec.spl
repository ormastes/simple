"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the bug-add and bug-resolve
apps (--log-mode and --progress, plus the token-receipt validation those
commands apply around the log output) as observed through real process
invocations against a fixture bug database.
Audience: compiler and tooling engineers who maintain the bug-tracking CLIs
and the shared log-option helpers they consume.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/bug_add_resolve_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the bug-add and bug-resolve shared log options and their token-receipt
guards only; each scenario spawns real `bin/simple` processes and rebuilds a
fixture bug database under /tmp.
## Verification guidance and troubleshooting
A failure names the exact option, mode, or token rule that regressed; re-run
this spec and compare the captured stdout in the failing scenario to
reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: bug-add-resolve-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_bug_add_resolve_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + "/doc/08_tracking/bug && cat > " + FIXTURE_DIR + "/doc/08_tracking/bug/bug_db.sdn <<'EOF'\nbugs_active |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\n\nbugs |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\n    baseline_bug, P2, closed, baseline, src/app/baseline.spl, 0, fixture, 2026-05-01, 2026-05-01, true\n\nbug_descriptions |bug_id, line_num, content|\n\nbug_fix_strategies |bug_id, line_num, content|\n\nbug_investigation_logs |bug_id, line_num, content|\n\nbug_token_usage |bug_id, category, provider, input_tokens, output_tokens, cache_read_tokens, cache_create_tokens, total_tokens, source, knowledge, recorded_at|\n    baseline_bug, application, test-provider, 100, 0, 0, 0, 100, fixture, none, 2026-05-01\nEOF"
    ])

fn _run_bug_add(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/bug_add/main.spl\" " + joined
    ])

fn _run_bug_resolve(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/bug_resolve/main.spl\" " + joined
    ])

describe "bug add and resolve log mode CLI options":
    it "bug-add shows shared log options in help":
        # @req REQ-BUG-LOGMODE-001
        # @capture(tui_grid): bug-add help text listing the shared log options
        step("Verify: bug-add shows shared log options in help")
        _setup_fixture()
        val (out, err, code) = _run_bug_add(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "bug-resolve shows shared log options in help":
        # @req REQ-BUG-LOGMODE-001
        # @capture(tui_grid): bug-resolve help text listing the shared log options
        step("Verify: bug-resolve shows shared log options in help")
        _setup_fixture()
        val (out, err, code) = _run_bug_resolve(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "bug-add supports log-mode json":
        # @req REQ-BUG-LOGMODE-001
        # @capture(protocol_json): stdout JSON transcript of the bug-add receipt
        step("Verify: bug-add supports log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_bug_add(["--id=log_mode_bug_001", "--severity=p2", "--title=fixture", "--file=src/main.spl", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a recorded bug
        expect(out).to_contain("\"command\":\"bug-add\"")
        expect(out).to_contain("\"id\":\"log_mode_bug_001\"")

    it "bug-resolve supports log-mode json":
        # @req REQ-BUG-LOGMODE-001
        # @capture(protocol_json): stdout JSON transcript of the bug-resolve receipt
        step("Verify: bug-resolve supports log-mode json")
        _setup_fixture()
        val (_add_out, _add_err, _add_code) = _run_bug_add(["--id=log_mode_bug_002", "--severity=p2", "--title=fixture", "--file=src/main.spl"])
        val (out, err, code) = _run_bug_resolve(["--id=log_mode_bug_002", "--date=2026-05-24", "--input-tokens=-1", "--output-tokens=-1", "--cache-read-tokens=-1", "--cache-create-tokens=-1", "--token-provider=test-provider", "--token-source=test-session", "--knowledge=none", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a resolved bug
        expect(out).to_contain("\"command\":\"bug-resolve\"")
        expect(out).to_contain("\"id\":\"log_mode_bug_002\"")

    it "bug-resolve requires a knowledge link above twice the comparable average":
        # @req REQ-BUG-LOGMODE-001
        # @capture(tui_grid): rejection output when knowledge is not linked
        step("Verify: bug-resolve requires a knowledge link above twice the comparable average")
        _setup_fixture()
        val (_add_out, _add_err, add_code) = _run_bug_add(["--id=high_token_bug_001", "--severity=p2", "--title=fixture", "--file=src/app/main.spl"])
        expect(add_code).to_equal(0)  # oracle: 0 is the CLI success exit code for the recorded baseline bug
        val (out, _err, code) = _run_bug_resolve(["--id=high_token_bug_001", "--date=2026-05-24", "--input-tokens=201", "--output-tokens=0", "--cache-read-tokens=0", "--cache-create-tokens=0", "--token-provider=test-provider", "--token-source=test-session", "--knowledge=none"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI validation-failure exit code for an unlinked knowledge entry
        expect(out).to_contain("--knowledge must name")

    it "bug-add supports dot progress":
        # @req REQ-BUG-LOGMODE-001
        # @capture(tui_grid): dot-progress terminal output of the bug-add run
        step("Verify: bug-add supports dot progress")
        _setup_fixture()
        val (out, err, code) = _run_bug_add(["--id=log_mode_bug_003", "--severity=p2", "--title=fixture", "--file=src/main.spl", "--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a recorded bug
        expect(out).to_start_with(".")
        expect(out).to_contain("Added bug log_mode_bug_003")

    it "bug-add rejects invalid log mode":
        # @req REQ-BUG-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Verify: bug-add rejects invalid log mode")
        _setup_fixture()
        val (out, err, code) = _run_bug_add(["--id=log_mode_bug_004", "--title=fixture", "--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode

    it "bug-resolve rejects invalid log mode":
        # @req REQ-BUG-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Verify: bug-resolve rejects invalid log mode")
        _setup_fixture()
        val (out, err, code) = _run_bug_resolve(["--id=log_mode_bug_004", "--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode

    it "bug-resolve rejects partial provider token receipts without knowledge":
        # @req REQ-BUG-LOGMODE-001
        # @capture(tui_grid): rejection output for a partial token receipt
        step("Verify: bug-resolve rejects partial provider token receipts without knowledge")
        _setup_fixture()
        val (_add_out, _add_err, add_code) = _run_bug_add(["--id=partial_token_bug_001", "--severity=p2", "--title=fixture", "--file=src/app/main.spl"])
        expect(add_code).to_equal(0)  # oracle: 0 is the CLI success exit code for the recorded baseline bug
        val (out, _err, code) = _run_bug_resolve(["--id=partial_token_bug_001", "--date=2026-05-24", "--input-tokens=10", "--output-tokens=unavailable", "--cache-read-tokens=0", "--cache-create-tokens=0", "--token-provider=test-provider", "--token-source=test-session", "--knowledge=none"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI validation-failure exit code for a partial token receipt
        expect(out).to_contain("partial token usage cannot be compared")

    it "bug-resolve rejects invalid token values":
        # @req REQ-BUG-LOGMODE-001
        # @capture(tui_grid): rejection output for a negative token count
        step("Verify: bug-resolve rejects invalid token values")
        _setup_fixture()
        val (_add_out, _add_err, add_code) = _run_bug_add(["--id=invalid_token_bug_001", "--severity=p2", "--title=fixture", "--file=src/app/main.spl"])
        expect(add_code).to_equal(0)  # oracle: 0 is the CLI success exit code for the recorded baseline bug
        val (out, _err, code) = _run_bug_resolve(["--id=invalid_token_bug_001", "--date=2026-05-24", "--input-tokens=-2", "--output-tokens=0", "--cache-read-tokens=0", "--cache-create-tokens=0", "--token-provider=test-provider", "--token-source=test-session", "--knowledge=none"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI validation-failure exit code for a negative token count
        expect(out).to_contain("nonnegative decimal integers")

    it "bug-resolve requires provider separately from usage source":
        # @req REQ-BUG-LOGMODE-001
        # @capture(tui_grid): rejection output when the token provider is missing
        step("Verify: bug-resolve requires provider separately from usage source")
        _setup_fixture()
        val (_add_out, _add_err, add_code) = _run_bug_add(["--id=missing_provider_bug_001", "--severity=p2", "--title=fixture", "--file=src/app/main.spl"])
        expect(add_code).to_equal(0)  # oracle: 0 is the CLI success exit code for the recorded baseline bug
        val (out, _err, code) = _run_bug_resolve(["--id=missing_provider_bug_001", "--date=2026-05-24", "--input-tokens=-1", "--output-tokens=-1", "--cache-read-tokens=-1", "--cache-create-tokens=-1", "--token-source=test-session", "--knowledge=none"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI validation-failure exit code for a missing token provider
        expect(out).to_contain("token receipt fields are required")

    it "bug-resolve rejects malformed dates":
        # @req REQ-BUG-LOGMODE-001
        # @capture(tui_grid): rejection output for a non-ISO resolve date
        step("Verify: bug-resolve rejects malformed dates")
        _setup_fixture()
        val (_add_out, _add_err, add_code) = _run_bug_add(["--id=bad_date_bug_001", "--severity=p2", "--title=fixture", "--file=src/app/main.spl"])
        expect(add_code).to_equal(0)  # oracle: 0 is the CLI success exit code for the recorded baseline bug
        val (out, _err, code) = _run_bug_resolve(["--id=bad_date_bug_001", "--date=2026-99-24", "--input-tokens=-1", "--output-tokens=-1", "--cache-read-tokens=-1", "--cache-create-tokens=-1", "--token-provider=test-provider", "--token-source=test-session", "--knowledge=none"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI validation-failure exit code for a malformed date
        expect(out).to_contain("YYYY-MM-DD")
