"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the check app (--log-mode and
--progress) together with its SSpec command-block routing, as observed through
real process invocations against fixture sources.
Audience: compiler and tooling engineers who maintain the check app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/check_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the check app's shared log options and its SSpec guidance routing
only; each scenario spawns real `bin/simple` processes and rebuilds fixture
sources under /tmp.
## Verification guidance and troubleshooting
A failure names the exact option, mode, or routing rule that regressed;
re-run this spec and compare the captured stdout in the failing scenario to
reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: check-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_check_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + " && cat > " + FIXTURE_DIR + "/sample.spl <<'EOF'\nfn answer() -> i64:\n    42\nEOF"
    ])

fn _run_check(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/check/main.spl\" " + joined
    ])

describe "check log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-CHECK-LOGMODE-001
        # @capture(tui_grid): check help text listing the shared log options
        step("Verify: shows shared log options in help")
        _setup_fixture()
        val (out, err, code) = _run_check(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json":
        # @req REQ-CHECK-LOGMODE-001
        # @capture(protocol_json): stdout JSON error transcript for a missing file
        step("Verify: supports log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_check(["--log-mode=json", "missing.spl"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI failure exit code for a missing target file
        expect(out).to_contain("\"command\":\"check\"")
        expect(out).to_contain("\"status\":\"error\"")
        expect(out).to_contain("\"files\":1")

    it "supports dot progress":
        # @req REQ-CHECK-LOGMODE-001
        # @capture(tui_grid): dot-progress error output for a missing file
        step("Verify: supports dot progress")
        _setup_fixture()
        val (out, err, code) = _run_check(["--progress=dot", "missing.spl"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI failure exit code for a missing target file
        expect(out).to_contain(".")
        expect(out).to_contain("ERROR: file not found: missing.spl")

    it "discovers source files when the target is a directory":
        # @req REQ-CHECK-LOGMODE-001
        # @capture(tui_grid): success output for a directory target check
        step("Verify: discovers source files when the target is a directory")
        _setup_fixture()
        val (out, err, code) = _run_check([FIXTURE_DIR + "/directory"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code when the discovered file checks clean
        expect(out).to_contain("All checks passed (1 file(s))")

    it "directs SSpec command blocks to the test runner before parsing":
        # @req REQ-CHECK-LOGMODE-001
        # @capture(tui_grid): SSpec guidance banner for a spec-targeted check
        step("Verify: directs SSpec command blocks to the test runner before parsing")
        _setup_fixture()
        val (out, err, code) = _run_check(["sample_spec.spl"])
        val combined = out + "\n" + err
        expect(code).to_equal(1)  # oracle: 1 is the CLI failure exit code for an SSpec-routed file
        expect(combined).to_contain("bin/simple test sample_spec.spl --mode=interpreter")
        expect(combined.contains("unexpected token in expression: : ':'")).to_equal(false)

    it "applies SSpec guidance in JSON mode without contaminating JSON":
        # @req REQ-CHECK-LOGMODE-001
        # @capture(protocol_json): stdout JSON that must stay a clean single object
        step("Verify: applies SSpec guidance in JSON mode without contaminating JSON")
        _setup_fixture()
        val (out, err, code) = _run_check(["--json", "sample.spl", "sample_spec.spl"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI failure exit code when one of two checked files errors
        expect((out + err).contains("E-SSPEC-CHECK")).to_equal(false)
        expect(out.trim()).to_equal("{\"command\":\"check\",\"status\":\"error\",\"checked\":2,\"files\":2,\"errors\":1,\"files_with_errors\":1}")

    it "does not classify prefixes, strings, or indented text as SSpec":
        # @req REQ-CHECK-LOGMODE-001
        # @capture(tui_grid): error output proving no false SSpec classification
        step("Verify: does not classify prefixes, strings, or indented text as SSpec")
        _setup_fixture()
        val (out, err, code) = _run_check(["not_spec.spl"])
        val combined = out + "\n" + err
        expect(code).to_equal(1)  # oracle: 1 is the CLI failure exit code for a file that fails ordinary parsing
        expect(combined.contains("error[E-SSPEC-CHECK]")).to_equal(false)

    it "rejects invalid log mode":
        # @req REQ-CHECK-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Verify: rejects invalid log mode")
        _setup_fixture()
        val (out, err, code) = _run_check(["--log-mode=noisy", "sample.spl"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
