"""
## Purpose and audience
Purpose: This spec proves Simple Browser CLI options.
Audience: Maintainers of the Simple integration suite reviewing this behavior.
"""
# @req: REQ-BROWSERCLILOGMODES-001
# Simple Browser CLI option handling — mirrors
# test/02_integration/app/ui_browser_log_modes_spec.spl's process-spawning
# style so this exercises the real compiled entry point
# (src/app/browser/main.spl), not an in-process shim.
#
# Deliberately covers only paths that return BEFORE main.spl calls
# render_browser() (--help, --version, an unknown-option rejection, and
# --open's early-exit): every path that reaches render_browser() drives the
# real DOM/CSS/layout/paint engine (see
# doc/08_tracking/bug/browser_text_node_blanks_frame_2026-08-05.md), which
# is too slow under the tree-walk interpreter for a spec-runner subprocess
# to wait on reliably (verified end-to-end manually instead: `bin/simple run
# src/app/browser/main.spl` prints real "Hello, World!" content and a real
# non-zero painted-pixel count).

use std.spec.{describe, it, expect, step}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn _run_browser(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/browser/main.spl\" " + joined
    ])

describe "Simple Browser CLI options":
    it "shows shared log options and the --open flag in help":
        # @req: REQ-BROWSERCLILOGMODES-001
        step("shows shared log options and the --open flag in help")
        val (out, err, code) = _run_browser(["--help"])
        expect(code).to_equal(0)
        expect(out).to_contain("Simple Browser")
        expect(out).to_contain("--open")
        expect(out).to_contain("--log-mode")

    it "supports --version":
        step("supports --version")
        val (out, err, code) = _run_browser(["--version"])
        expect(code).to_equal(0)
        expect(out).to_contain("Simple Browser")

    it "rejects an unknown option before reaching the render engine":
        step("rejects an unknown option before reaching the render engine")
        val (out, err, code) = _run_browser(["--log-mode=json", "--bogus"])
        expect(code).to_equal(1)
        expect(out).to_contain("\"status\":\"error\"")
        expect(out).to_contain("Unknown browser option: --bogus")

    it "does not reject --open as an unknown option":
        step("does not reject --open as an unknown option")
        # --open is checked by the SAME browser_first_unknown_option()
        # allowlist as the case above, so this is fast (it returns from
        # that check before main.spl ever calls run_browser_window_gui /
        # the render engine) -- it just confirms --open didn't regress
        # into the "unknown option" branch, without actually launching.
        val (out, err, code) = _run_browser(["--log-mode=json", "--open", "--bogus"])
        expect(code).to_equal(1)
        expect(out).to_contain("Unknown browser option: --bogus")
        expect(out).to_not_contain("Unknown browser option: --open")
