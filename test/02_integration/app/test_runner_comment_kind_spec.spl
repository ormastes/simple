# @req REQ-TESTRUNNER-PHASE2-4KINDS
# @cover src/lib/nogc_sync_mut/test_runner/doctest_runner.spl 10%
"""
# Test runner runs comment doctests

**Feature IDs:** #test-runner-phase2
**Category:** Tooling

## Overview

`simple test --spl-doctest <file.spl>` runs the fenced examples in the doc
comments of a source file. A passing example is reported PASS with exit 0, a
failing one FAIL with exit 1, with real counts on the summary line. Under
`--compiler=phase2` the CLI named by SIMPLE_PHASE2_FULL_CLI runs the examples.
"""

use std.spec.*
use std.spec.step
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.file_ops.{file_write, file_read, secure_temp_dir}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.test_runner.test_executor_parsing.{_tp_get_temp_dir}
use std.io_runtime.{file_hash_sha256_or_empty}

fn real_binary() -> text:
    val b = env_get("SIMPLE_BINARY")
    if b != "":
        return b
    "bin/simple"

fn new_root() -> text:
    secure_temp_dir(_tp_get_temp_dir(), "comment-kind-").unwrap().replace("\\", "/")

# A source file whose doc comment holds one example asserting add_one(1) == <expected>.
fn write_source(root: text, expected: i64) -> text:
    val path = root + "/" + ("green" if expected == 2 else "red") + "_doc.spl"
    file_write(path, "/// Adds one.\n/// ```simple\n/// assert add_one(1) == {expected}\n/// ```\nfn add_one(x: i64) -> i64:\n    x + 1\n")
    path

# Recording stand-in for the phase2-built CLI: logs its argv, runs the real binary.
fn write_phase2_cli(root: text) -> text:
    val path = root + "/phase2_simple"
    file_write(path, "#!/bin/sh\necho \"phase2-invoked $*\" >> \"{path}.log\"\nexec \"{real_binary()}\" \"$@\"\n")
    process_run_bounded("chmod", ["+x", path], 10000, 65536)
    path

fn run_default(source: text) -> (text, i64):
    val (out, err, code) = process_run_bounded(real_binary(), ["test", "--no-session-daemon", "--spl-doctest", source], 300000, 4194304)
    (out + err, code)

fn run_phase2(cli: text, source: text) -> (text, i64):
    val (out, err, code) = process_run_bounded("env", ["SIMPLE_PHASE2_FULL_CLI=" + cli, "SIMPLE_PHASE2_FULL_CLI_SHA256=" + file_hash_sha256_or_empty(cli), real_binary(), "test", "--compiler=phase2", "--no-session-daemon", "--spl-doctest", source], 300000, 4194304)
    (out + err, code)

describe "simple test --spl-doctest":
    # @capture(exec)
    it "reports a passing comment example as PASS":
        val (report, code) = run_default(write_source(new_root(), 2))
        expect(code).to_equal(0)
        expect(report).to_contain("SPL Doctest: 1 passed, 0 failed")

    # @capture(exec)
    it "reports a failing comment example as FAIL":
        val (report, code) = run_default(write_source(new_root(), 3))
        expect(code).to_equal(1)
        expect(report).to_contain("FAIL")
        expect(report).to_contain("SPL Doctest: 0 passed, 1 failed")

    # @capture(exec)
    it "runs comment examples with the phase2 CLI":
        val root = new_root()
        val cli = write_phase2_cli(root)
        step("A passing example is PASS under phase2")
        val (green, green_code) = run_phase2(cli, write_source(root, 2))
        expect(green_code).to_equal(0)
        expect(green).to_contain("SPL Doctest: 1 passed, 0 failed")
        step("A failing example is FAIL under phase2")
        val (red, red_code) = run_phase2(cli, write_source(root, 3))
        expect(red_code).to_equal(1)
        expect(red).to_contain("SPL Doctest: 0 passed, 1 failed")
        step("The phase2 CLI ran the doctest children")
        expect(file_read(cli + ".log")).to_contain("spl_doctest_")
