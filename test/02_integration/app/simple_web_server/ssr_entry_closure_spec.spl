use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.file_ops.{file_read}

fn _source(path: text) -> text:
    file_read(path) ?? ""

describe "hosted web SSR entry closure":
    it "uses the narrow canonical renderer and live HTTP registry owner":
        val submitter = _source("src/lib/gc_async_mut/http_server/ssr_submitter.spl")
        expect(submitter).to_contain("simple_web_ssr_renderer.{")
        expect(submitter).to_contain("simple_web_ssr_render_html_to_pixels")
        expect(submitter).to_contain("registry.register(name, _registered_ssr_handler)")
        expect(submitter).to_contain("mutex_with_lock_keeping")

        val renderer = _source("src/lib/gc_async_mut/gpu/browser_engine/simple_web_ssr_renderer.spl")
        expect(renderer).to_contain("simple_web_layout_render_html_pixels_engine2d")
        expect(renderer).to_contain("simple_web_engine2d_resolved_backend_name")
        expect(renderer.contains("simple_web_renderer")).to_equal(false)

    it "does not revive the removed asynchronous lifecycle facade":
        val submitter = _source("src/lib/gc_async_mut/http_server/ssr_submitter.spl")
        expect(submitter.contains("async_handler_lifecycle")).to_equal(false)
        expect(submitter.contains("send_async_handler_completion")).to_equal(false)
        expect(submitter.contains("multicore_green_spawn")).to_equal(false)
