use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.file_ops.{file_read}

fn _source(path: text) -> text:
    file_read(path) ?? ""

describe "hosted web SSR entry closure":
    it "uses the narrow canonical SSR renderer capability":
        val submitter = _source("src/lib/gc_async_mut/http_server/ssr_submitter.spl")
        expect(submitter).to_contain("simple_web_ssr_renderer")
        expect(submitter.contains("simple_web_renderer.{")).to_equal(false)

    it "keeps Draw IR and Engine2D ownership without browser-only dependencies":
        val renderer = _source("src/lib/gc_async_mut/gpu/browser_engine/simple_web_ssr_renderer.spl")
        expect(renderer).to_contain("simple_web_layout_render_html_pixels_engine2d")
        expect(renderer).to_contain("simple_web_engine2d_resolved_backend_name")
        expect(renderer.contains("simple_web_ssr_evidence")).to_equal(false)
        expect(renderer.contains("simple_web_html_layout_renderer")).to_equal(false)
        expect(renderer.contains("simple_web_file_renderer")).to_equal(false)
        expect(renderer.contains("Engine2DReadback")).to_equal(false)
        expect(renderer.contains("wm_chrome_theme")).to_equal(false)
