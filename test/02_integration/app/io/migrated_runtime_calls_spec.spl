# Regression for Phase3 CLI unresolved runtime names after facade migration.
use std.spec.{describe, it, expect}
use std.io_runtime.{file_write_exact, file_exists, file_delete, getpid, time_now_unix_micros}
use app.io.file_shell.{shell_output}
use app.watch.deps.{extract_imports}
use app.test_dep_graph_shared.{shared_dep_graph_new, shared_dep_graph_load}

describe "migrated application runtime calls":
    it "collects watch imports and handles a missing source":
        val path = ".runtime-watch-{getpid()}-{time_now_unix_micros()}.spl"
        expect(file_write_exact(path, "use std.io_runtime\n")).to_equal(true)
        val imports = extract_imports(path)
        expect(file_delete(path)).to_equal(true)
        expect(imports).to_equal(["std.io_runtime"])
        expect(extract_imports(path).len()).to_equal(0)

    it "saves and reloads dependency graph entries":
        val path = ".runtime-deps-{getpid()}-{time_now_unix_micros()}.sdn"
        var graph = shared_dep_graph_new(path, false)
        graph.deps["test.spl"] = ["dependency.spl"]
        graph.save()
        expect(file_exists(path)).to_equal(true)
        val loaded = shared_dep_graph_load(path, false)
        expect(file_delete(path)).to_equal(true)
        expect(loaded.get_deps("test.spl")).to_equal(["dependency.spl"])

    it "returns trimmed process output through the shell facade":
        expect(shell_output("printf '  facade output  \\n'")).to_equal("facade output")
