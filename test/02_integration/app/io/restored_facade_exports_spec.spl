# @req REQ-SSPEC-LIB
# Windows Phase 3 diagnosed missing file_read_bytes_i64 and dir_exists exports.
use std.spec.{describe, it, expect}
use app.io.mod.{file_read_bytes_i64, file_write_bytes, file_delete, dir_exists}
use std.io_runtime.{getpid, time_now_unix_micros}

describe "restored IO facade exports":
    it "preserves all unsigned byte values through the public i64 reader":
        val path = ".facade-byte-values-{getpid()}-{time_now_unix_micros()}.bin"
        var expected: [u8] = []
        for value in 0..256:
            expected = expected.push(value.to_u8())
        expect(file_write_bytes(path, expected)).to_equal(true)
        val actual = file_read_bytes_i64(path)
        val removed = file_delete(path)
        expect(removed).to_equal(true)
        expect(actual.len()).to_equal(256)
        for value in 0..256:
            expect(actual[value]).to_equal(value)
        expect(file_read_bytes_i64(path).len()).to_equal(0)

    it "exports the directory predicate used by compile snapshots":
        expect(dir_exists(".")).to_equal(true)
        val absent = ".facade-absent-{getpid()}-{time_now_unix_micros()}"
        expect(dir_exists(absent)).to_equal(false)
