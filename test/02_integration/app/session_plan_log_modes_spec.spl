use std.spec.{describe, it, expect}
use test.helpers.simple_cli_spawn_fixture.{simple_cli_run}

fn _run_app(app_path: text, args: [text]) -> (text, text, i64):
    simple_cli_run([app_path] + args, 120000)

describe "session plan log mode CLI options":
    # @manual scenario evidence
    it "shows shared log options in proton session plan help":
        val (out, err, code) = _run_app("src/app/proton_session_plan/main.spl", ["--help"])
        expect(code).to_equal(0)
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "rejects invalid proton session plan log mode":
        val (out, err, code) = _run_app("src/app/proton_session_plan/main.spl", ["--log-mode=noisy"])
        expect(code).to_equal(1)

    it "shows shared log options in wine process session plan help":
        val (out, err, code) = _run_app("src/app/wine_process_session_plan/main.spl", ["--help"])
        expect(code).to_equal(0)
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "rejects invalid wine process session plan log mode":
        val (out, err, code) = _run_app("src/app/wine_process_session_plan/main.spl", ["--log-mode=noisy"])
        expect(code).to_equal(1)
