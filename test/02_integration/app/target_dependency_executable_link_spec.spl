# Executable proof that a named target consumes a dependency archive.
# Requires a working pure-Simple native-build toolchain; this spec is not a
# substitute for the receipt-only unit tests.

use std.spec.{describe, it, expect}
use app.build.targets.build_targets.{parse_targets_text}
use app.build.targets.target_executor.{execute_target_plan}
use app.io.cli_ops.{cli_current_exe_path}
use app.io.mod.{
    cwd, getpid, dir_create_all, file_write, file_delete, file_exists,
    process_run
}

fn target_link_provider_source(value: i64) -> text:
    "@export(\"C\", name: \"target_link_probe_value_v1\")\n" +
        "fn provider_value() -> i64:\n    {value}\n"

fn target_link_consumer_source() -> text:
    "extern fn target_link_probe_value_v1() -> i64\n\n" +
        "fn main() -> i64:\n    target_link_probe_value_v1()\n"

fn target_link_fixture_scope() -> text:
    "build/target_dependency_executable_link_spec/" + getpid().to_text()

fn target_link_target_text(scope: text) -> text:
    "target lib:\n" +
        "    kind: library\n" +
        "    entry: {scope}/provider.spl\n" +
        "    output: {scope}/libprovider.a\n\n" +
        "target app:\n" +
        "    kind: binary\n" +
        "    entry: {scope}/consumer.spl\n" +
        "    output: {scope}/app\n" +
        "    depends: lib\n"

describe "named target executable consumes an archive":
    it "changes behavior with the producer and fails unresolved without its archive":
        val repo_root = cwd()
        val scope = target_link_fixture_scope()
        val directory = repo_root + "/" + scope
        expect(file_exists(repo_root + "/src/app/build/targets/target_executor.spl")).to_equal(true)
        expect(dir_create_all(directory)).to_equal(true)
        val provider = directory + "/provider.spl"
        val consumer = directory + "/consumer.spl"
        expect(file_write(provider, target_link_provider_source(17))).to_equal(true)
        expect(file_write(consumer, target_link_consumer_source())).to_equal(true)
        val targets = parse_targets_text(target_link_target_text(scope))
        expect(targets.errors.len()).to_equal(0)

        # The only source definition is in the library target. The consumer
        # declares an extern and does not import the provider source module.
        val first = execute_target_plan(repo_root, targets, "app")
        expect(first.error).to_equal("")
        expect(first.executed_count).to_equal(2)
        val app = directory + "/app"
        val (_first_out, _first_err, first_code) = process_run(app, [])
        expect(first_code).to_equal(17)

        expect(file_write(provider, target_link_provider_source(29))).to_equal(true)
        val second = execute_target_plan(repo_root, targets, "app")
        expect(second.error).to_equal("")
        expect(second.executed_count).to_equal(2)
        val (_second_out, _second_err, second_code) = process_run(app, [])
        expect(second_code).to_equal(29)

        # Same consumer and native backend, but no manifest or archive input.
        # This must be an unresolved extern, not a successful empty stub.
        val missing_output = directory + "/without_archive"
        file_delete(missing_output)
        val compiler = cli_current_exe_path()
        expect(compiler != "").to_equal(true)
        val (_negative_out, negative_err, negative_code) = process_run(compiler, [
            "native-build", "--entry", consumer, "--entry-closure",
            "--source", repo_root + "/src", "--mode", "one-binary",
            "--output", missing_output,
            "--cache-dir", directory + "/without_archive_cache"
        ])
        expect(negative_code == 0).to_equal(false)
        expect(negative_err).to_contain("target_link_probe_value_v1")
        expect(file_exists(missing_output)).to_equal(false)
