"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the new test runner app
(--log-mode and --progress) together with its planning, unknown-option, and
error reporting, as observed through real process invocations.
Audience: compiler and tooling engineers who maintain the test runner and
the shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/test_runner_new_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the runner's shared log options and its planning output only; each
scenario spawns real `bin/simple` processes and plans against the repo's
own test tree without executing suites.
## Verification guidance and troubleshooting
A failure names the exact option, mode, or JSON field that regressed;
re-run this spec and compare the captured stdout in the failing scenario to
reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: test-runner-new-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn _run_test_runner_new(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/test_runner_new/main.spl\" " + joined
    ])

describe "test runner new log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-TEST-RUNNER-LOGMODE-001
        # @capture(tui_grid): runner help text listing the shared log options
        step("Verify: shows shared log options in help")
        val (out, err, code) = _run_test_runner_new(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("Simple Test Runner")
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports json default planning output":
        # @req REQ-TEST-RUNNER-LOGMODE-001
        # @capture(protocol_json): stdout JSON plan for the default target
        step("Verify: supports json default planning output")
        val (out, err, code) = _run_test_runner_new(["--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a planned run
        expect(out).to_contain("\"command\":\"test-runner-new\"")
        expect(out).to_contain("\"status\":\"planned\"")
        expect(out).to_contain("\"target\":\"test\"")

    it "supports json target and mode planning":
        # @req REQ-TEST-RUNNER-LOGMODE-001
        # @capture(protocol_json): stdout JSON plan echoing target, mode, list, coverage
        step("Verify: supports json target and mode planning")
        val (out, err, code) = _run_test_runner_new([
            "--log-mode=json",
            "test/unit",
            "--mode",
            "native",
            "--list",
            "--coverage"
        ])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a planned run
        expect(out).to_contain("\"target\":\"test/unit\"")
        expect(out).to_contain("\"mode\":\"native\"")
        expect(out).to_contain("\"listOnly\":true")
        expect(out).to_contain("\"coverage\":true")

    it "supports compile shorthand mode planning":
        # @req REQ-TEST-RUNNER-LOGMODE-001
        # @capture(protocol_json): stdout JSON plan resolving the --compile shorthand
        step("Verify: supports compile shorthand mode planning")
        val (out, err, code) = _run_test_runner_new(["--log-mode=json", "--compile"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a planned run
        expect(out).to_contain("\"mode\":\"native\"")

    it "supports dot progress for help output":
        # @req REQ-TEST-RUNNER-LOGMODE-001
        # @capture(tui_grid): dot-progress help output naming the runner
        step("Verify: supports dot progress for help output")
        val (out, err, code) = _run_test_runner_new(["--progress=dot", "--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain(".\nSimple Test Runner")

    it "rejects invalid log mode":
        # @req REQ-TEST-RUNNER-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Verify: rejects invalid log mode")
        val (out, err, code) = _run_test_runner_new(["--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode

    it "renders json unknown option output":
        # @req REQ-TEST-RUNNER-LOGMODE-001
        # @capture(protocol_json): stdout JSON error naming the unknown option
        step("Verify: renders json unknown option output")
        val (out, err, code) = _run_test_runner_new(["--log-mode=json", "--surprise"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown option
        expect(out).to_contain("\"status\":\"error\"")
        expect(out).to_contain("Unknown test runner option: --surprise")
