"""Native runnable mirror for BrowserSession's bounded request queue."""

use std.gc_async_mut.web.browser_session.{
    BrowserRequest, BrowserSession
}
use std.io_runtime.{exit}

fn fail_probe(reason: text):
    print "BROWSER REQUEST QUEUE PROBE: FAIL ({reason})"
    exit(1)

fn main():
    var session = BrowserSession.new()
    var index: i64 = 0
    while index < 1024:
        session.pending_requests.push(BrowserRequest.create(
            index.to_text(), "document",
            "https://example.test/" + index.to_text(),
            "GET", "", "payload-" + index.to_text(), "text/plain"
        ))
        index = index + 1

    match session.take_pending_request():
        nil:
            fail_probe("first-request-missing")
        Some(request):
            if request.id != "0":
                fail_probe("first-request-out-of-order")
    if session.pending_requests.len() != 1024:
        fail_probe("queue-copied-on-first-pop")
    if session.pending_request_head != 1:
        fail_probe("queue-head-not-advanced")
    if session.pending_requests[0].body != "":
        fail_probe("consumed-body-still-retained")

    index = 1
    while index < 1024:
        match session.take_pending_request():
            nil:
                fail_probe("request-missing-" + index.to_text())
            Some(request):
                if request.id != index.to_text():
                    fail_probe("request-out-of-order-" + index.to_text())
        if index == 511:
            if (session.pending_requests.len() != 512 or
                session.pending_request_head != 0 or
                session.pending_request_count() != 512):
                fail_probe("queue-compaction-boundary-invalid")
        index = index + 1

    if session.has_pending_requests():
        fail_probe("queue-not-exhausted")
    if session.pending_requests.len() != 0 or session.pending_request_head != 0:
        fail_probe("queue-storage-not-released")
    print "BROWSER REQUEST QUEUE PROBE: PASS"
    exit(0)
