"""SCV batch persistence, exact replay values and failure publication.

REQ-008 / REQ-014 / REQ-024 of incremental_build_tldr_scv. This covers the
existing schema-v1 batch owner only, not schema-v2 or source freshness.
"""
use std.spec.{describe, it, expect, step, fail}
use app.io.mod.{dir_create, file_exists, file_read, file_write, file_delete}
use std.scv.store.{scv_init_repo}
use std.scv.metadata_db.{ScvMetaInsert, scv_metadb_open, scv_metadb_path}
use std.nogc_sync_mut.io.time_ops.{current_time_ms}
use nogc_sync_mut.database.wal.{WriteAheadLog, WalEntry, WalEntryType}

fn batch_repo(tag: text) -> text:
    val root = "/tmp/scv-batch-{tag}-{current_time_ms()}"
    dir_create(root, true)
    scv_init_repo(root)
    root

fn change_row(key: text, title: text) -> ScvMetaInsert:
    ScvMetaInsert(table: "logical_change", values: [key, title, "open", "1"])

fn wal_insert(key: text, data: text) -> WalEntry:
    WalEntry(sequence: 0, entry_type: WalEntryType.Insert,
             table_name: "logical_change", row_key: key, data: data, timestamp: 0)

describe "SCV bounded metadata batch":
    it "replays both unsaved rows with exact values and contiguous owner sequences":
        step("Persist the schema, then publish two rows through one batch")
        val root = batch_repo("replay")
        var meta = scv_metadb_open(root)
        expect(meta.save()).to_equal(true)
        val before = meta.wal.sequence_counter
        expect(meta.insert_batch([change_row("a", "first, quoted"), change_row("b", "second|pipe")])).to_equal(true)
        expect(meta.count("logical_change")).to_equal(2)
        expect(meta.seq).to_equal(before + 2)
        val pending = meta.wal.pending_entries()
        expect(pending.len()).to_equal(2)
        expect(pending[0].sequence).to_equal(before + 1)
        expect(pending[1].sequence).to_equal(before + 2)
        step("Reopen without a post-batch save and inspect actual recovered values")
        val reopened = scv_metadb_open(root)
        expect(reopened.count("logical_change")).to_equal(2)
        match reopened.row("logical_change", "a"):
            Some(row):
                expect(row.get("title") ?? "").to_equal("first, quoted")
            nil:
                fail("missing first row")
        match reopened.row("logical_change", "b"):
            Some(row):
                expect(row.get("title") ?? "").to_equal("second|pipe")
            nil:
                fail("missing second row")

    it "preflights the final row before publishing any earlier row":
        val root = batch_repo("preflight")
        var meta = scv_metadb_open(root)
        expect(meta.save()).to_equal(true)
        val before = file_read(meta.wal.path)
        val sequence = meta.seq
        val invalid = ScvMetaInsert(table: "logical_change", values: ["bad", "too few"])
        expect(meta.insert_batch([change_row("good", "valid"), invalid])).to_equal(false)
        expect(meta.count("logical_change")).to_equal(0)
        expect(meta.seq).to_equal(sequence)
        expect(file_read(meta.wal.path)).to_equal(before)

    it "keeps rows, pending entries and sequence unchanged on a failed WAL rename":
        val root = batch_repo("write-failure")
        var meta = scv_metadb_open(root)
        expect(dir_create(meta.wal.path, true)).to_equal(true)
        expect(meta.insert_batch([change_row("a", "first"), change_row("b", "second")])).to_equal(false)
        expect(meta.count("logical_change")).to_equal(0)
        expect(meta.seq).to_equal(0)
        expect(meta.wal.sequence_counter).to_equal(0)
        expect(meta.wal.entries.len()).to_equal(0)
        step("Legacy single-row insertion also propagates this persistence failure")
        expect(meta.insert("logical_change", ["c", "single", "open", "1"])).to_equal(false)
        expect(meta.count("logical_change")).to_equal(0)
        expect(meta.wal.sequence_counter).to_equal(0)

    it "does not write a WAL for an empty batch":
        val root = batch_repo("empty")
        var meta = scv_metadb_open(root)
        expect(meta.insert_batch([])).to_equal(true)
        expect(file_exists(meta.wal.path)).to_equal(false)
        expect(meta.wal.entries.len()).to_equal(0)

    it "rejects multiline payloads and invalid keys before creating a WAL":
        val root = batch_repo("framing")
        var meta = scv_metadb_open(root)
        expect(meta.insert_batch([change_row("a", "line one\nline two")])).to_equal(false)
        expect(meta.insert_batch([change_row("a|b", "valid title")])).to_equal(false)
        expect(meta.count("logical_change")).to_equal(0)
        expect(file_exists(meta.wal.path)).to_equal(false)

    it "bounds aggregate payload and row cardinality without a partial write":
        val root = batch_repo("bounds")
        var meta = scv_metadb_open(root)
        val large = "x".repeat(600000)
        expect(meta.insert_batch([change_row("a", large), change_row("b", large)])).to_equal(false)
        var many: [ScvMetaInsert] = []
        var index = 0
        while index < 4097:
            many.push(change_row(index.to_text(), "small"))
            index = index + 1
        expect(meta.insert_batch(many)).to_equal(false)
        expect(meta.count("logical_change")).to_equal(0)
        expect(meta.seq).to_equal(0)
        expect(file_exists(meta.wal.path)).to_equal(false)

    it "rejects a torn suffix under the lease and preserves the original file":
        val root = batch_repo("torn")
        val path = scv_metadb_path(root)
        var wal = WriteAheadLog.open(path)
        val torn = "#wal-version:2\n1|Insert|logical_change|a|incomplete"
        expect(file_write(wal.path, torn)).to_equal(true)
        expect(wal.append_batch([wal_insert("b", "b,new,open,1")])).to_equal(false)
        expect(file_read(wal.path)).to_equal(torn)
        expect(wal.sequence_counter).to_equal(0)
        expect(wal.entries.len()).to_equal(0)

    it "preserves checkpoint counters and pending entries when replacement fails":
        val root = batch_repo("checkpoint")
        var meta = scv_metadb_open(root)
        expect(meta.save()).to_equal(true)
        expect(meta.insert_batch([change_row("a", "pending")])).to_equal(true)
        var wal = meta.wal
        val sequence = wal.sequence_counter
        val flushed = wal.flushed_up_to
        expect(file_delete(wal.path)).to_equal(true)
        expect(dir_create(wal.path, true)).to_equal(true)
        expect(wal.checkpoint()).to_equal(false)
        expect(wal.sequence_counter).to_equal(sequence)
        expect(wal.flushed_up_to).to_equal(flushed)
        expect(wal.pending_entries().len()).to_equal(1)
