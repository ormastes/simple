# Pure Simple executable proof for SCI-style provider activation and dispatch.

use std.cli.cli_util.{get_cli_args}
use std.common.crypto.sha256.{sha256_u8_hex}
use app.cli_composition.{CliActivationRequestV1}
use app.simple_core.provider_dispatch.{
    SIMPLE_CORE_PROVIDER_DISPATCH_OK, simple_core_dispatch_provider_v1
}

extern fn rt_file_read_bytes(path: text) -> [u8]

fn main() -> i64:
    val args = get_cli_args()
    val path = if args.len() > 0: args[0] else: "build/providers/provider_cli_native.so"
    val digest = sha256_u8_hex(rt_file_read_bytes(path))
    val activation = CliActivationRequestV1(
        ok: true,
        diagnostic_code: "",
        diagnostic_subject: "",
        requested_command: "fmt",
        canonical_command: "fmt",
        summary: "Pure Simple provider integration",
        args: ["fixture.spl"],
        binding_service_id: "cli.fmt",
        interface_group_id: "cli.command",
        interface_major: 1,
        interface_minor: 0,
        interface_abi_digest: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        provider_id: "provider_cli_native",
        provider_artifact_path: path,
        provider_artifact_kind: "native",
        provider_artifact_digest: digest,
        requested_capability_bits: 0,
    )
    val receipt = simple_core_dispatch_provider_v1(activation, 1, 0)
    print "status=" + receipt.status.to_text()
    print "command_status=" + receipt.command_status.to_text()
    print "output=" + receipt.output
    print "diagnostic=" + receipt.diagnostic
    print "pin_released=" + receipt.pin_released.to_text()
    print "session_closed=" + receipt.session_closed.to_text()
    if receipt.status == SIMPLE_CORE_PROVIDER_DISPATCH_OK: 0 else: receipt.status as i64
