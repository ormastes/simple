# Focused native proof for lossless SCI/provider ABI identity admission.

use std.nogc_sync_mut.composition.provider_contract.{
    SIMPLE_PROVIDER_OK,
    SIMPLE_PROVIDER_QUERY_RESULT_V1_SIZE,
    SimpleProviderQueryResultV1,
    simple_provider_digest_from_hex_v1,
    simple_provider_digest_to_hex_v1
}
use os.smf.provider_query_wire.{
    encode_provider_query_result_v1,
    decode_provider_query_result_v1
}
use os.smf.provider_loader.{provider_query_abi_validate_v1}

fn main() -> i64:
    val abi = "112233445566778899aabbccddeeff00010203040506070890abcdefdeadbeef"
    val result = SimpleProviderQueryResultV1(
        status: SIMPLE_PROVIDER_OK,
        provided_major: 1,
        provided_minor: 0,
        descriptor_size: 28,
        interface_handle: 1,
        provider_context: 0,
        provider_identity_digest: 2,
        implementation_digest: 3,
        abi_digest: simple_provider_digest_from_hex_v1(abi),
    )
    val encoded = encode_provider_query_result_v1(result)
    if not encoded.ok or encoded.bytes.len() != SIMPLE_PROVIDER_QUERY_RESULT_V1_SIZE as i64:
        return 10
    if encoded.bytes[48] != 0x11 or encoded.bytes[79] != 0xef:
        return 11
    val decoded = decode_provider_query_result_v1(encoded.bytes)
    if not decoded.ok or simple_provider_digest_to_hex_v1(decoded.value.abi_digest) != abi:
        return 12
    if provider_query_abi_validate_v1(abi, decoded.value) != "":
        return 13
    if provider_query_abi_validate_v1(
            "222233445566778899aabbccddeeff00010203040506070890abcdefdeadbeef",
            decoded.value,
        ) != "provider-query-abi-digest-mismatch":
        return 14
    if provider_query_abi_validate_v1("not-a-sha256", decoded.value) != "interface-abi-digest-invalid":
        return 15
    if decode_provider_query_result_v1([0u8; 60]).diagnostic != "result-wire-size-invalid":
        return 16
    var legacy_partial = [165u8; 84]
    var index = 0
    while index < 60:
        legacy_partial[index] = encoded.bytes[index]
        index = index + 1
    if decode_provider_query_result_v1(legacy_partial).diagnostic != "result-reserved-not-zero":
        return 17
    var nonzero_reserved = encoded.bytes
    nonzero_reserved[80] = 1
    if decode_provider_query_result_v1(nonzero_reserved).diagnostic != "result-reserved-not-zero":
        return 18
    print "abi-digest-admission=pass"
    0
