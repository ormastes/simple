# Focused native proof that direct provider-query producers carry full digests.

use std.nogc_sync_mut.composition.provider_contract.{
    SIMPLE_PROVIDER_OK,
    SIMPLE_PROVIDER_QUERY_V1_SIZE,
    SIMPLE_CLI_COMMAND_V1_INTERFACE,
    SimpleProviderQueryV1,
    simple_provider_digest_is_canonical_v1,
    simple_provider_digest_to_hex_v1
}
use std.nogc_sync_mut.composition.cli_registry.{
    InProcessCliProviderV1,
    SimpleCliRegistryV1,
    simple_provider_query_in_process_v1
}
use compiler.driver.driver_provider_contract_v1.{
    SIMPLE_COMPILER_DRIVER_V1_INTERFACE,
    SIMPLE_COMPILER_DRIVER_V1_ABI_DIGEST,
    simple_compiler_driver_query_v1
}

val CLI_ABI_DIGEST: text = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn query_v1(interface_id: u64, host_abi: u64) -> SimpleProviderQueryV1:
    SimpleProviderQueryV1(
        descriptor_size: SIMPLE_PROVIDER_QUERY_V1_SIZE,
        interface_id: interface_id,
        minimum_major: 1,
        minimum_minor: 0,
        host_abi: host_abi,
        target_offset: 0,
        target_length: 0,
        requested_capability_bits: 0,
    )

fn main() -> i64:
    if not simple_provider_digest_is_canonical_v1(CLI_ABI_DIGEST):
        return 20
    var registry = SimpleCliRegistryV1.create()
    registry.register_in_process(InProcessCliProviderV1(
        provider_handle: 41,
        context_handle: 7,
        provider_identity_digest: 257,
        implementation_digest: 514,
        abi_digest: CLI_ABI_DIGEST,
        required_capability_bits: 0,
        command_name: "fmt",
        summary: "fixture",
    ))
    val cli = simple_provider_query_in_process_v1(
        registry, 41, query_v1(SIMPLE_CLI_COMMAND_V1_INTERFACE, 1),
    )
    if cli.status != SIMPLE_PROVIDER_OK or
            simple_provider_digest_to_hex_v1(cli.abi_digest) != CLI_ABI_DIGEST:
        return 21
    val driver = simple_compiler_driver_query_v1(
        query_v1(SIMPLE_COMPILER_DRIVER_V1_INTERFACE, 0),
    )
    if driver.status != SIMPLE_PROVIDER_OK or
            simple_provider_digest_to_hex_v1(driver.abi_digest) != SIMPLE_COMPILER_DRIVER_V1_ABI_DIGEST:
        return 22
    print "abi-digest-producers=pass"
    0
