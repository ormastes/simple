"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the svllm-pack command
(--log-mode and --progress) as observed through real process invocations,
including its JSON error envelope for unknown options.
Audience: compiler and tooling engineers who maintain the svllm_pack app and
the shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/svllm_pack_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the svllm-pack command's shared log options only; every scenario runs
without a fixture workspace, so usage and error paths are exercised directly
against the bare command.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: svllm-pack-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn _run_svllm_pack(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/svllm_pack/main.spl\" " + joined
    ])

describe "svllm pack log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-SVLLM-PACK-LOGMODE-001
        # @capture(tui_grid): svllm-pack help text listing the shared log options
        step("Run svllm-pack --help")
        val (out, err, code) = _run_svllm_pack(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json for usage output":
        # @req REQ-SVLLM-PACK-LOGMODE-002
        # @capture(protocol_json): svllm-pack usage JSON envelope
        step("Run svllm-pack with log-mode json and no subcommand")
        val (out, err, code) = _run_svllm_pack(["--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for the usage envelope
        expect(out).to_contain("\"command\":\"svllm-pack\"")
        expect(out).to_contain("\"status\":\"usage\"")

    it "supports dot progress for help output":
        # @req REQ-SVLLM-PACK-LOGMODE-003
        # @capture(tui_grid): dot-progress output followed by the command identity line
        step("Run svllm-pack --help with dot progress")
        val (out, err, code) = _run_svllm_pack(["--progress=dot", "--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_start_with(".")
        expect(out).to_contain("svllm-pack")

    it "rejects invalid log mode":
        # @req REQ-SVLLM-PACK-LOGMODE-004
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke svllm-pack with an unknown log mode and expect a usage error")
        val (out, err, code) = _run_svllm_pack(["--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode

    it "emits json for unknown options":
        # @req REQ-SVLLM-PACK-LOGMODE-005
        # @capture(protocol_json): svllm-pack error JSON envelope for an unknown option
        step("Invoke svllm-pack with an unknown option under log-mode json")
        val (out, err, code) = _run_svllm_pack(["--log-mode=json", "--bogus"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI error exit code for an unknown option
        expect(out).to_contain("\"command\":\"svllm-pack\"")
        expect(out).to_contain("\"status\":\"error\"")
