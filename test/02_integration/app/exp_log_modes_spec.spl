use std.spec.{describe, it, expect}
use std.nogc_sync_mut.env.platform.{get_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_remove_all}
use std.nogc_sync_mut.io.file_ops.{file_create_exclusive, secure_temp_dir}
use test.helpers.simple_cli_spawn_fixture.{simple_cli_run}

fn _run_exp(args: [text]) -> (text, text, i64):
    simple_cli_run(["src/app/exp/main.spl"] + args, 120000)

fn _run_exp_temp_script() -> (text, text, i64):
    val scope = match secure_temp_dir(get_temp_dir(), "exp-run-script-"):
        Ok(path): path.replace("\\", "/")
        Err(reason): return ("", "error: script scope: " + reason, 125)
    val script_path = scope + "/probe.spl"
    if not file_create_exclusive(script_path, "print \"exp-run-ok\"\n"):
        val _removed = dir_remove_all(scope)
        return ("", "error: script fixture creation failed", 125)
    val (out, err, code) = simple_cli_run(["src/app/exp/main.spl", "run", script_path], 120000)
    val _removed = dir_remove_all(scope)
    (out, err, code)

describe "exp log mode CLI options":
    # @manual scenario evidence
    it "shows shared log options in help":
        val (out, err, code) = _run_exp(["--help"])
        expect(code).to_equal(0)
        expect(out).to_contain("Usage: exp")
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json ready output":
        val (out, err, code) = _run_exp(["--log-mode=json"])
        expect(code).to_equal(0)
        expect(out).to_contain("\"command\":\"exp\"")
        expect(out).to_contain("\"status\":\"ready\"")

    it "supports dot progress for help output":
        val (out, err, code) = _run_exp(["--progress=dot", "--help"])
        expect(code).to_equal(0)
        expect(out).to_start_with(".")
        expect(out).to_contain("Usage: exp")

    it "rejects invalid log mode":
        val (out, err, code) = _run_exp(["--log-mode=noisy"])
        expect(code).to_equal(1)

    it "delegates experiment script execution":
        val (out, err, code) = _run_exp_temp_script()
        expect(code).to_equal(0)
        expect(out).to_contain("exp-run-ok")
