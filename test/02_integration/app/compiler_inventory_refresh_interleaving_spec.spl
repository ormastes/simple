"""Real refresh owners interleaving WITHOUT a lease (lockless refresh).

doc/05_design/compiler/scv/lockless_refresh.md. A refresh that observed an
older pointer never blocks a competing publisher, never deletes the record it
copied (reclamation is age-based), and a competing publication is reported
as superseded by complete-byte pointer comparison, after which the ordinary
public refresh re-derives from the winner. A two-thread scenario exercises
ordinary concurrent refresh calls; no timing threshold substitutes for data
and ownership assertions.
"""
use std.spec.{describe, it, expect, step}
use std.io_runtime.{dir_create_all, file_write, file_read, file_exists, process_run}
use std.nogc_sync_mut.io_runtime.{dir_remove}
use std.nogc_sync_mut.concurrent.thread.{thread_spawn_with_args}
use std.common.crypto.sha256.{sha256_text}
use std.scv.compile_source_inventory.{
    compile_source_inventory_read_current_v1,
    compile_source_inventory_read_pointer_content_v1,
    compile_source_inventory_revalidate_pointer_v1}
use app.compiler_entrypoint.inventory_events.{
    compiler_inventory_refresh_v1, compiler_inventory_cursor_decode_v1,
    compiler_inventory_membership_decode_v1, compiler_inventory_gc_v1}

extern fn rt_getpid() -> i64

fn refresh_checkout(label: text) -> text:
    val root = "build/test-artifacts/scv-refresh-interleaving-{label}-{rt_getpid()}"
    dir_remove(root, true)
    expect(dir_create_all(root + "/src")).to_equal(true)
    expect(file_write(root + "/src/main.spl", "export fn main(): 1\n")).to_equal(true)
    val (_, _, init_code) = process_run("git", ["-C", root, "init", "-q"])
    expect(init_code).to_equal(0)
    val (_, _, add_code) = process_run("git", ["-C", root, "add", "src/main.spl"])
    expect(add_code).to_equal(0)
    val (_, _, commit_code) = process_run("git", ["-C", root,
        "-c", "user.name=Simple Test", "-c", "user.email=test@example.invalid",
        "-c", "commit.gpgsign=false", "commit", "-qm", "seed"])
    expect(commit_code).to_equal(0)
    expect(compiler_inventory_refresh_v1(root, root + "/build/scv", ["src"], true).valid).to_equal(true)
    root

fn refresh_pointer(cache: text) -> text:
    val pointer = compile_source_inventory_read_pointer_content_v1(cache) ?? ""
    expect(pointer).to_contain("simple-compile-event-cursor-v3")
    pointer

fn refresh_membership(cache: text, pointer: text) -> text:
    val separator = pointer.index_of("\n")
    expect(separator).to_be_greater_than(0)
    val cursor = compiler_inventory_cursor_decode_v1(pointer.substring(separator + 1))
    expect(cursor.valid).to_equal(true)
    cache + "/compile-events/untracked/" + cursor.untracked_membership_digest + ".paths"

fn concurrent_refresh_worker(root: text, cache: text) -> i64:
    val result = compiler_inventory_refresh_v1(root, cache, ["src"], false)
    if result.valid: 1 else: 0

describe "p2_p3_bug_reproduction SCV refresh ownership":
    it "permits another publisher during observation and keeps the record it copied":
        step("Reproduce the exact failure")
        val root = refresh_checkout("snapshot")
        val cache = root + "/build/scv"
        val before = refresh_pointer(cache)
        val old_record = refresh_membership(cache, before)
        val old_paths = compiler_inventory_membership_decode_v1(file_read(old_record))
        expect(old_paths != nil).to_equal(true)
        expect(old_paths!.len()).to_equal(0)
        expect(file_exists(cache + "/compile-events/refresh.lock")).to_equal(false)

        step("Exercise the lockless owner")
        expect(file_write(root + "/src/new.spl", "export fn added(): 2\n")).to_equal(true)
        val winner = compiler_inventory_refresh_v1(root, cache, ["src"], false)
        expect(winner.valid).to_equal(true)
        val after = refresh_pointer(cache)
        val new_record = refresh_membership(cache, after)
        expect(after == before).to_equal(false)
        expect(file_exists(new_record)).to_equal(true)
        # The observer's copied record is NOT retired by the winner: only an
        # age-based sweep reclaims unreferenced records, and a sweep with a
        # day-scale floor keeps a record published seconds ago.
        expect(file_exists(old_record)).to_equal(true)
        expect(compiler_inventory_gc_v1(cache, 86400)).to_equal(0)
        expect(file_exists(old_record)).to_equal(true)
        # The stale observer's base is reported superseded by complete-byte comparison.
        expect(compile_source_inventory_revalidate_pointer_v1(cache, before).reason).to_equal("publish-cursor-superseded")
        expect(refresh_pointer(cache)).to_equal(after)
        expect(file_exists(cache + "/source-inventory/publication.lock")).to_equal(false)

        step("Reject the adjacent regression")
        expect(compiler_inventory_refresh_v1(root, cache, ["src"], false).valid).to_equal(true)
        val current = compile_source_inventory_read_current_v1(cache)
        expect(current.valid).to_equal(true)
        expect(current.inventory!.entries.len()).to_equal(2)
        dir_remove(root, true)

    it "admits concurrent public refresh calls without losing dirty source content":
        val root = refresh_checkout("threads")
        val cache = root + "/build/scv"
        val content = "export fn main(): 3\n"
        expect(file_write(root + "/src/main.spl", content)).to_equal(true)
        val first = thread_spawn_with_args(root, cache, concurrent_refresh_worker)
        val second = thread_spawn_with_args(root, cache, concurrent_refresh_worker)
        val first_result = first.join()
        val second_result = second.join()
        expect(first_result ?? -1).to_equal(1)
        expect(second_result ?? -1).to_equal(1)
        val current = compile_source_inventory_read_current_v1(cache)
        expect(current.valid).to_equal(true)
        expect(current.inventory!.entries.len()).to_equal(1)
        expect(current.inventory!.entries[0].content_digest).to_equal(sha256_text(content))
        dir_remove(root, true)

describe "p2_p3_adjacent_regression SCV refresh authority":
    it "rejects a complete-byte pointer change after NUL without any lease":
        val root = refresh_checkout("nul")
        val cache = root + "/build/scv"
        val before = refresh_pointer(cache)
        val record = refresh_membership(cache, before)
        val mutated = before + "\0different-authority"
        expect(file_write(cache + "/source-inventory/CURRENT", mutated)).to_equal(true)
        expect(compile_source_inventory_revalidate_pointer_v1(cache, before).reason).to_equal("publish-cursor-superseded")
        expect(sha256_text(file_read(cache + "/source-inventory/CURRENT"))).to_equal(sha256_text(mutated))
        expect(file_exists(record)).to_equal(true)
        expect(file_write(cache + "/source-inventory/CURRENT", before)).to_equal(true)
        expect(compile_source_inventory_revalidate_pointer_v1(cache, before).valid).to_equal(true)
        expect(compiler_inventory_refresh_v1(root, cache, ["src"], false).valid).to_equal(true)
        expect(refresh_pointer(cache)).to_equal(before)
        dir_remove(root, true)
