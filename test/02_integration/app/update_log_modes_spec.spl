"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the update app (--log-mode
and --progress) as observed through real process invocations against a
fixture package manifest with two dependencies.
Audience: compiler and tooling engineers who maintain the update app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/update_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the update app's shared log options in dry-run form only; each
scenario spawns real `bin/simple` processes and rebuilds the fixture
manifest under /tmp.
## Verification guidance and troubleshooting
A failure names the exact option, mode, or JSON field that regressed;
re-run this spec and compare the captured stdout in the failing scenario to
reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: update-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_update_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + " && cat > " + FIXTURE_DIR + "/simple.sdn <<'EOF'\nname: update-fixture\nversion: 3.4.5\ndependencies:\n  alpha: \"*\"\n  beta: \"*\"\nEOF"
    ])

fn _run_update(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/update/main.spl\" " + joined
    ])

describe "update log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-UPDATE-LOGMODE-001
        # @capture(tui_grid): update help text listing the shared log options
        step("Verify: shows shared log options in help")
        _setup_fixture()
        val (out, err, code) = _run_update(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports dry-run log-mode json":
        # @req REQ-UPDATE-LOGMODE-001
        # @capture(protocol_json): stdout JSON dry-run plan with the dependency list
        step("Verify: supports dry-run log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_update(["--dry-run", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed dry run
        expect(out).to_contain("\"dry_run\":true")
        expect(out).to_contain("\"dependencies\":[\"alpha\",\"beta\"]")

    it "supports dot progress":
        # @req REQ-UPDATE-LOGMODE-001
        # @capture(tui_grid): dot-progress dry-run output with the update count
        step("Verify: supports dot progress")
        _setup_fixture()
        val (out, err, code) = _run_update(["--dry-run", "--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed dry run
        expect(out).to_start_with(".")
        expect(out).to_contain("Would update 2 dependencies")

    it "rejects invalid log mode":
        # @req REQ-UPDATE-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Verify: rejects invalid log mode")
        _setup_fixture()
        val (out, err, code) = _run_update(["--dry-run", "--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
