use std.spec.{describe, it, expect}
use test.helpers.simple_cli_spawn_fixture.{simple_cli_run}

fn _run_simple_portal(args: [text]) -> (text, text, i64):
    simple_cli_run(["src/app/simple_portal/main.spl"] + args, 120000)

describe "simple portal log mode CLI options":
    # @manual scenario evidence
    it "shows shared log options in help":
        val (out, err, code) = _run_simple_portal(["--help"])
        expect(code).to_equal(0)
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json for ready output":
        val (out, err, code) = _run_simple_portal(["--log-mode=json"])
        expect(code).to_equal(0)
        expect(out).to_contain("\"command\":\"simple-portal\"")
        expect(out).to_contain("\"status\":\"ready\"")

    it "supports dot progress for help output":
        val (out, err, code) = _run_simple_portal(["--progress=dot", "--help"])
        expect(code).to_equal(0)
        expect(out).to_start_with(".")
        expect(out).to_contain("Simple Portal")

    it "rejects invalid log mode":
        val (out, err, code) = _run_simple_portal(["--log-mode=noisy"])
        expect(code).to_equal(1)

    it "emits json for unknown commands":
        val (out, err, code) = _run_simple_portal(["--log-mode=json", "bogus"])
        expect(code).to_equal(1)
        expect(out).to_contain("\"command\":\"simple-portal\"")
        expect(out).to_contain("\"status\":\"error\"")
