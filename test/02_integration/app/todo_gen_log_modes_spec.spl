"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the todo-gen command
(--log-mode and --progress) as observed through real process invocations
against a fixture tracking directory.
Audience: compiler and tooling engineers who maintain the todo-gen app and
the shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/todo_gen_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the todo-gen command's shared log options only; each scenario spawns
real `bin/simple` processes and builds its fixture under /tmp with a one-row
doc/08_tracking/todo/todo_db.sdn.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: todo-gen-log-modes

use std.spec.{describe, it, expect}
use std.spec.step
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.env.platform.{is_windows, get_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all}
use std.nogc_sync_mut.io.file_ops.{file_create_exclusive}
use std.env.variables.{env_get}
use std.nogc_sync_mut.io.env_ops.{cwd}

val CLI_RUN_TIMEOUT_MS: i64 = 120000
val CLI_RUN_MAX_OUT: i64 = 16777216

fn _cli_repo_root() -> text:
    cwd().replace("\\", "/")

fn _spawn_cli(run_args: [text], work_dir: text, extra_env: [(text, text)]) -> (text, text, i64):
    """Host-portable replacement for the old POSIX sh harness: runs
    `bin/simple run <run_args...>` with SIMPLE_LIB bound to the repo src
    tree, optionally under a different working directory and with extra
    environment variables set for the child."""
    val repo = _cli_repo_root()
    val program = if is_windows(): repo + "/bin/simple.exe" else: repo + "/bin/simple"
    val lib = repo + "/src"
    val joined = run_args.join(" ")
    val (shell, shell_args) = if is_windows():
        val sh = env_get("ComSpec") ?? "cmd.exe"
        var cmd = ""
        if work_dir != "":
            cmd = cmd + "cd /d " + work_dir + " && "
        for (key, value) in extra_env:
            cmd = cmd + "set \"" + key + "=" + value + "\" && "
        cmd = cmd + "set \"SIMPLE_LIB=" + lib + "\" && " + program + " run " + joined
        (sh, ["/d", "/c", cmd])
    else:
        var prefix = ""
        if work_dir != "":
            prefix = prefix + "cd \"" + work_dir + "\" && "
        for (key, value) in extra_env:
            prefix = prefix + key + "=\"" + value + "\" "
        ("/bin/sh", ["-c", prefix + "SIMPLE_LIB=\"" + lib + "\" \"" + program + "\" run " + joined])
    process_run_bounded(shell, shell_args, CLI_RUN_TIMEOUT_MS, CLI_RUN_MAX_OUT)

val FIXTURE_DIR = get_temp_dir().replace("\\", "/") + "/simple_todo_gen_log_mode_fixture"

fn _setup_fixture():
    val _removed = dir_remove_all(FIXTURE_DIR)
    if not dir_create_all(FIXTURE_DIR + "/doc/08_tracking/todo"):
        fail("could not create fixture dir " + FIXTURE_DIR + "/doc/08_tracking/todo")
    if not file_create_exclusive(FIXTURE_DIR + "/doc/08_tracking/todo/todo_db.sdn", "todos |id, keyword, area, priority, description, file, line, issue, blocked, status, valid|\n    1, TODO, runtime, P1, \"fixture todo\", src/main.spl, 3, 42, \"\", open, true\n"):
        fail("could not write fixture file " + FIXTURE_DIR + "/doc/08_tracking/todo/todo_db.sdn")

fn _run_todo_gen(args: [text]) -> (text, text, i64):
    _spawn_cli(["src/app/todo_gen/main.spl"] + args, FIXTURE_DIR, [])

describe "todo-gen log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-TODOGEN-LOGMODE-001
        # @capture(tui_grid): todo-gen help text listing the shared log options
        step("Run todo-gen --help in the fixture directory")
        _setup_fixture()
        val (out, err, code) = _run_todo_gen(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json":
        # @req REQ-TODOGEN-LOGMODE-001
        # @capture(protocol_json): generation JSON transcript for the one fixture todo
        step("Regenerate the todo page from the one-row fixture database with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_todo_gen(["--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed generation
        expect(out).to_contain("\"command\":\"todo-gen\"")
        expect(out).to_contain("\"todos\":1")

    it "supports dot progress":
        # @req REQ-TODOGEN-LOGMODE-001
        # @capture(tui_grid): dot-progress output followed by the generation summary line
        step("Regenerate the todo page with dot progress")
        _setup_fixture()
        val (out, err, code) = _run_todo_gen(["--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed generation
        expect(out).to_start_with(".")
        expect(out).to_contain("Generated doc/TODO.md (1 items)")

    it "rejects invalid log mode":
        # @req REQ-TODOGEN-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke todo-gen with an unknown log mode and expect a usage error")
        _setup_fixture()
        val (out, err, code) = _run_todo_gen(["--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
