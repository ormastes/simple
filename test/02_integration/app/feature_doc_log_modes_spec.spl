"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the feature-doc command
(--log-mode and --progress) as observed through real process invocations
against a fixture working directory.
Audience: compiler and tooling engineers who maintain the feature-doc app and
the shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/feature_doc_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the feature-doc command's shared log options only; each scenario
spawns real `bin/simple` processes and builds its fixture under /tmp with two
minimal feature specs, one under app and one under usage.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: feature-doc-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_feature_doc_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + "/test/feature/app " + FIXTURE_DIR + "/test/feature/usage && cat > " + FIXTURE_DIR + "/test/feature/app/tool_spec.spl <<'EOF'\ndescribe \"tool\":\n    it \"works\":\n        assert true\nEOF\ncat > " + FIXTURE_DIR + "/test/feature/usage/lang_spec.spl <<'EOF'\ndescribe \"language\":\n    it \"works\":\n        assert true\nEOF"
    ])

fn _run_feature_doc(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/feature_doc/main.spl\" " + joined
    ])

describe "feature-doc log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-FEATUREDOC-LOGMODE-001
        # @capture(tui_grid): feature-doc help text listing the shared log options
        step("Run feature-doc --help in the fixture directory")
        _setup_fixture()
        val (out, err, code) = _run_feature_doc(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports list log-mode json":
        # @req REQ-FEATUREDOC-LOGMODE-001
        # @capture(protocol_json): list JSON transcript counting one spec per category
        step("List the fixture's feature specs with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_feature_doc(["--list", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed listing
        expect(out).to_contain("\"command\":\"feature-doc\"")
        expect(out).to_contain("\"app\":1")
        expect(out).to_contain("\"usage\":1")

    it "supports dot progress":
        # @req REQ-FEATUREDOC-LOGMODE-001
        # @capture(tui_grid): dot-progress output followed by the classification report
        step("List the fixture's feature specs with dot progress")
        _setup_fixture()
        val (out, err, code) = _run_feature_doc(["--list", "--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed listing
        expect(out).to_start_with(".")
        expect(out).to_contain("Feature Test Classification")

    it "rejects invalid log mode":
        # @req REQ-FEATUREDOC-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke feature-doc with an unknown log mode and expect a usage error")
        _setup_fixture()
        val (out, err, code) = _run_feature_doc(["--list", "--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
