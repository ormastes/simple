"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the publish command (--log-mode
and --progress) as observed through real process invocations against a
fixture package directory.
Audience: compiler and tooling engineers who maintain the publish app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/publish_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the publish command's shared log options only; every publish scenario
runs with --dry-run so no registry is contacted, and the fixture under /tmp
declares package publish-fixture@7.8.9.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: publish-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_publish_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + " && cat > " + FIXTURE_DIR + "/simple.sdn <<'EOF'\npackage:\n  name: publish-fixture\n  version: 7.8.9\nEOF"
    ])

fn _run_publish(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/publish/main.spl\" " + joined
    ])

describe "publish log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-PUBLISH-LOGMODE-001
        # @capture(tui_grid): publish help text listing the shared log options
        step("Run publish --help in the fixture directory")
        _setup_fixture()
        val (out, err, code) = _run_publish(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports dry-run log-mode json":
        # @req REQ-PUBLISH-LOGMODE-002
        # @capture(protocol_json): publish dry-run JSON transcript for the fixture package
        step("Publish the fixture package in dry-run mode with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_publish(["--dry-run", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed dry-run publish
        expect(out).to_contain("\"command\":\"publish\"")
        expect(out).to_contain("\"dry_run\":true")
        expect(out).to_contain("\"name\":\"publish-fixture\"")
        expect(out).to_contain("\"version\":\"7.8.9\"")

    it "supports dot progress":
        # @req REQ-PUBLISH-LOGMODE-003
        # @capture(tui_grid): dot-progress output followed by the publish identity line
        step("Publish the fixture package in dry-run mode with dot progress")
        _setup_fixture()
        val (out, err, code) = _run_publish(["--dry-run", "--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed dry-run publish
        expect(out).to_start_with(".")
        expect(out).to_contain("Publishing publish-fixture@7.8.9")
        expect(out).to_contain("(dry run - no changes made)")

    it "rejects invalid log mode":
        # @req REQ-PUBLISH-LOGMODE-004
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke publish with an unknown log mode and expect a usage error")
        _setup_fixture()
        val (out, err, code) = _run_publish(["--dry-run", "--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
