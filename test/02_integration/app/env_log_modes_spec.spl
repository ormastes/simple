"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the env command (--log-mode
and --progress) as observed through real process invocations against a
fixture working directory.
Audience: compiler and tooling engineers who maintain the env app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/env_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the env command's shared log options only; each scenario spawns real
`bin/simple` processes and builds its fixture under /tmp, and the
delete-json scenario intentionally stays RED until the env delete transcript
carries the environment name again.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: env-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_env_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR
    ])

fn _run_env(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" SIMPLE_ENV= \"$REPO/bin/simple\" run \"$REPO/src/app/env/main.spl\" " + joined
    ])

describe "env log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-ENV-LOGMODE-001
        # @capture(tui_grid): env help text listing the shared log options
        step("Run env --help in the fixture directory")
        _setup_fixture()
        val (out, err, code) = _run_env(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports create log-mode json":
        # @req REQ-ENV-LOGMODE-001
        # @capture(protocol_json): create JSON transcript naming the new environment
        step("Create a test environment with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_env(["create", "--name=test-env", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed create
        expect(out).to_contain("\"command\":\"create\"")
        expect(out).to_contain("\"name\":\"test-env\"")

    it "supports status log-mode json":
        # @req REQ-ENV-LOGMODE-001
        # @capture(protocol_json): status JSON transcript reporting the environment as existing
        step("Create the environment, then query its status with log-mode json")
        _setup_fixture()
        val (_create_out, _create_err, _create_code) = _run_env(["create", "--name=test-env"])
        val (out, err, code) = _run_env(["status", "--name=test-env", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed status query
        expect(out).to_contain("\"command\":\"status\"")
        expect(out).to_contain("\"exists\":true")

    it "supports delete log-mode json":
        # @req REQ-ENV-LOGMODE-001
        # @capture(protocol_json): delete JSON transcript for the removed environment
        step("Create the environment, then delete it with log-mode json")
        _setup_fixture()
        val (_create_out, _create_err, _create_code) = _run_env(["create", "--name=test-env"])
        val (out, err, code) = _run_env(["delete", "--name=test-env", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed delete
        expect(out).to_contain("\"command\":\"delete\"")
        expect(out).to_contain("\"name\":\"test-env\"")

    it "supports dot progress":
        # @req REQ-ENV-LOGMODE-001
        # @capture(tui_grid): dot-progress output followed by the no-environment status line
        step("Query env status with dot progress and no environment present")
        _setup_fixture()
        val (out, err, code) = _run_env(["status", "--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a status query on an empty workspace
        expect(out).to_start_with(".")
        expect(out).to_contain("No virtual environment found.")

    it "rejects invalid log mode":
        # @req REQ-ENV-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke env status with an unknown log mode and expect a usage error")
        _setup_fixture()
        val (out, err, code) = _run_env(["status", "--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
