"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the qualify-ignore app
(--log-mode and --progress) as observed through real process invocations
against a fixture spec carrying an unqualified ignore.
Audience: compiler and tooling engineers who maintain the qualify-ignore app
and the shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/qualify_ignore_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the qualify-ignore app's shared log options only; each scenario
spawns real `bin/simple` processes and rebuilds the fixture under /tmp.
## Verification guidance and troubleshooting
A failure names the exact option, mode, or JSON field that regressed;
re-run this spec and compare the captured stdout in the failing scenario to
reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: qualify-ignore-log-modes

use std.spec.{describe, it, expect}
use std.spec.step
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.env.platform.{is_windows, get_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all}
use std.nogc_sync_mut.io.file_ops.{file_create_exclusive}
use std.env.variables.{env_get}
use std.nogc_sync_mut.io.env_ops.{cwd}

val CLI_RUN_TIMEOUT_MS: i64 = 120000
val CLI_RUN_MAX_OUT: i64 = 16777216

fn _cli_repo_root() -> text:
    cwd().replace("\\", "/")

fn _spawn_cli(run_args: [text], work_dir: text, extra_env: [(text, text)]) -> (text, text, i64):
    """Host-portable replacement for the old POSIX sh harness: runs
    `bin/simple run <run_args...>` with SIMPLE_LIB bound to the repo src
    tree, optionally under a different working directory and with extra
    environment variables set for the child."""
    val repo = _cli_repo_root()
    val program = if is_windows(): repo + "/bin/simple.exe" else: repo + "/bin/simple"
    val lib = repo + "/src"
    val joined = run_args.join(" ")
    val (shell, shell_args) = if is_windows():
        val sh = env_get("ComSpec") ?? "cmd.exe"
        var cmd = ""
        if work_dir != "":
            cmd = cmd + "cd /d " + work_dir + " && "
        for (key, value) in extra_env:
            cmd = cmd + "set \"" + key + "=" + value + "\" && "
        cmd = cmd + "set \"SIMPLE_LIB=" + lib + "\" && " + program + " run " + joined
        (sh, ["/d", "/c", cmd])
    else:
        var prefix = ""
        if work_dir != "":
            prefix = prefix + "cd \"" + work_dir + "\" && "
        for (key, value) in extra_env:
            prefix = prefix + key + "=\"" + value + "\" "
        ("/bin/sh", ["-c", prefix + "SIMPLE_LIB=\"" + lib + "\" \"" + program + "\" run " + joined])
    process_run_bounded(shell, shell_args, CLI_RUN_TIMEOUT_MS, CLI_RUN_MAX_OUT)

val FIXTURE_DIR = get_temp_dir().replace("\\", "/") + "/simple_qualify_ignore_log_mode_fixture"

fn _setup_fixture():
    val _removed = dir_remove_all(FIXTURE_DIR)
    if not dir_create_all(FIXTURE_DIR + "/test"):
        fail("could not create fixture dir " + FIXTURE_DIR + "/test")
    if not file_create_exclusive(FIXTURE_DIR + "/test/sample_spec.spl", "#[ignore]\ndescribe \"sample\":\n    it \"works\":\n        assert true\n"):
        fail("could not write fixture file " + FIXTURE_DIR + "/test/sample_spec.spl")

fn _run_qualify_ignore(args: [text]) -> (text, text, i64):
    _spawn_cli(["src/app/qualify_ignore/main.spl"] + args, FIXTURE_DIR, [])

describe "qualify-ignore log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-QUALIFY-LOGMODE-001
        # @capture(tui_grid): qualify-ignore help text listing the shared log options
        step("Verify: shows shared log options in help")
        _setup_fixture()
        val (out, err, code) = _run_qualify_ignore(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports scan log-mode json":
        # @req REQ-QUALIFY-LOGMODE-001
        # @capture(protocol_json): stdout JSON scan report with the issue count
        step("Verify: supports scan log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_qualify_ignore(["test", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed scan
        expect(out).to_contain("\"command\":\"qualify-ignore\"")
        expect(out).to_contain("\"issues\":1")

    it "supports fix log-mode json":
        # @req REQ-QUALIFY-LOGMODE-001
        # @capture(protocol_json): stdout JSON fix report with the fixed count
        step("Verify: supports fix log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_qualify_ignore(["test", "--fix", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed fix run
        expect(out).to_contain("\"mode\":\"fix\"")
        expect(out).to_contain("\"fixed\":1")

    it "supports dot progress":
        # @req REQ-QUALIFY-LOGMODE-001
        # @capture(tui_grid): dot-progress scan output naming the unqualified ignore
        step("Verify: supports dot progress")
        _setup_fixture()
        val (out, err, code) = _run_qualify_ignore(["test", "--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed scan
        expect(out).to_contain(".")
        expect(out).to_contain("Found 1 unqualified ignore(s)")

    it "rejects invalid log mode":
        # @req REQ-QUALIFY-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Verify: rejects invalid log mode")
        _setup_fixture()
        val (out, err, code) = _run_qualify_ignore(["test", "--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
