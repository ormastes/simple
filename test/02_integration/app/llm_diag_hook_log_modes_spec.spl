use std.spec.{describe, it, expect}

use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.env.platform.{is_windows, get_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_remove_all}
use std.nogc_sync_mut.io.file_ops.{file_create_exclusive, secure_temp_dir}
use std.env.variables.{env_get}
use std.nogc_sync_mut.io.env_ops.{cwd}
use test.helpers.simple_cli_spawn_fixture.{simple_cli_run}

extern fn rt_file_read_text(path: text) -> text?

val CLI_RUN_TIMEOUT_MS: i64 = 120000
val CLI_RUN_MAX_OUT: i64 = 16777216

fn _cli_repo_root() -> text:
    cwd().replace("\\", "/")

fn _run_llm_diag_hook(args: [text]) -> (text, text, i64):
    simple_cli_run(["src/app/llm_diag_hook/main.spl"] + args, CLI_RUN_TIMEOUT_MS)

fn _run_llm_diag_hook_with_input(args: [text], input: text, log_path: text) -> (text, text, i64):
    val repo = _cli_repo_root()
    val program = if is_windows(): repo + "/bin/simple.exe" else: repo + "/bin/simple"
    val lib = repo + "/src"
    val scope = match secure_temp_dir(get_temp_dir(), "llm-diag-stdin-"):
        Ok(path): path.replace("\\", "/")
        Err(reason): return ("", "error: stdin scope: " + reason, 125)
    val input_path = scope + "/input.txt"
    if not file_create_exclusive(input_path, input):
        val _removed = dir_remove_all(scope)
        return ("", "error: stdin fixture creation failed", 125)
    val joined = (["src/app/llm_diag_hook/main.spl"] + args).join(" ")
    val (shell, shell_args) = if is_windows():
        val sh = env_get("ComSpec") ?? "cmd.exe"
        val redirect = " < " + input_path.replace("/", "\\")
        val cmd = "set \"LLM_DIAG_LOG=" + log_path + "\" && set \"SIMPLE_LIB=" + lib + "\" && " + program + " run " + joined + redirect
        (sh, ["/d", "/c", cmd])
    else:
        ("/bin/sh", ["-c", "LLM_DIAG_LOG=\"" + log_path + "\" SIMPLE_LIB=\"" + lib + "\" \"" + program + "\" run " + joined + " < \"" + input_path + "\""])
    val (out, err, code) = process_run_bounded(shell, shell_args, CLI_RUN_TIMEOUT_MS, CLI_RUN_MAX_OUT)
    val _removed = dir_remove_all(scope)
    (out, err, code)

describe "llm-diag-hook log mode CLI options":
    # @manual scenario evidence
    it "shows shared log options in help":
        val (out, err, code) = _run_llm_diag_hook(["--help"])
        expect(code).to_equal(0)
        expect(out).to_contain("LLM Diagnostics Hook")
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json ready output":
        val (out, err, code) = _run_llm_diag_hook(["--log-mode=json"])
        expect(code).to_equal(0)
        expect(out).to_contain("\"command\":\"llm-diag-hook\"")
        expect(out).to_contain("\"status\":\"ready\"")

    it "supports dot progress for help output":
        val (out, err, code) = _run_llm_diag_hook(["--progress=dot", "--help"])
        expect(code).to_equal(0)
        expect(out).to_contain(".\nLLM Diagnostics Hook")

    it "rejects invalid log mode":
        val (out, err, code) = _run_llm_diag_hook(["--log-mode=noisy"])
        expect(code).to_equal(1)

    it "renders json unknown option output":
        val (out, err, code) = _run_llm_diag_hook(["--log-mode=json", "--surprise"])
        expect(code).to_equal(1)
        expect(out).to_contain("\"status\":\"error\"")
        expect(out).to_contain("Unknown llm-diag-hook option: --surprise")

    it "logs stdin hook json without blocking":
        val log_path = get_temp_dir().replace("\\", "/") + "/simple_llm_diag_hook_log_modes.jsonl"
        val input = "{\"hook_event_name\":\"SessionStart\",\"session_id\":\"sid-1\"}"
        val (out, err, code) = _run_llm_diag_hook_with_input(["--log-mode=json"], input, log_path)
        expect(code).to_equal(0)
        expect(out).to_contain("\"status\":\"logged\"")
        val logged = rt_file_read_text(log_path) ?? ""
        expect(logged).to_contain("\"event\":\"SessionStart\"")
        expect(logged).to_contain("\"sid\":\"sid-1\"")
