use std.spec.{describe, it, expect}
use std.nogc_sync_mut.env.platform.{get_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all}
use std.nogc_sync_mut.io.file_ops.{file_create_exclusive}
use test.helpers.simple_cli_spawn_fixture.{simple_cli_run}

val DIAGRAM_TMP = get_temp_dir().replace("\\", "/") + "/simple-diagram-log-modes"

fn _run_diagram(args: [text]) -> (text, text, i64):
    val _removed = dir_remove_all(DIAGRAM_TMP)
    if not dir_create_all(DIAGRAM_TMP):
        fail("could not create diagram fixture dir " + DIAGRAM_TMP)
    if not file_create_exclusive(DIAGRAM_TMP + "/profile.log", "1|call|Main|Worker|x|ok|5\n"):
        fail("could not write diagram fixture profile.log")
    simple_cli_run(["src/app/diagram/main.spl"] + args, 120000)

describe "diagram log mode CLI options":
    # @manual scenario evidence
    it "shows shared log options in help":
        val (out, err, code) = _run_diagram(["--help"])
        expect(code).to_equal(0)
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json for usage output":
        val (out, err, code) = _run_diagram(["--log-mode=json"])
        expect(code).to_equal(0)
        expect(out).to_contain("\"command\":\"diagram\"")
        expect(out).to_contain("\"status\":\"usage\"")

    it "supports dot progress for usage output":
        val (out, err, code) = _run_diagram(["--progress=dot"])
        expect(code).to_equal(0)
        expect(out).to_start_with(".")
        expect(out).to_contain("Usage: simple diagram")

    it "rejects invalid log mode":
        val (out, err, code) = _run_diagram(["--log-mode=noisy"])
        expect(code).to_equal(1)

    it "emits json for generated diagrams":
        val (out, err, code) = _run_diagram([
            "--log-mode=json",
            "--from-file",
            DIAGRAM_TMP + "/profile.log",
            "--output",
            DIAGRAM_TMP,
            "--name",
            "sample"
        ])
        expect(code).to_equal(0)
        expect(out).to_contain("\"command\":\"diagram\"")
        expect(out).to_contain("\"status\":\"ok\"")
        expect(out).to_contain("\"generated\":1")
