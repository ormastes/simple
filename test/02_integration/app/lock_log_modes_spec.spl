"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the lock command (--log-mode
and --progress) as observed through real process invocations against a
fixture working directory.
Audience: compiler and tooling engineers who maintain the lock app and the
shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/lock_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the lock command's shared log options and its generate/validate
subcommands only; each scenario spawns real `bin/simple` processes and builds
its fixture under /tmp with a simple.sdn declaring two dependencies and one
dev dependency.
## Verification guidance and troubleshooting
A failure names the exact option, subcommand, or mode that regressed; re-run
this spec and compare the captured stdout in the failing scenario to
reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: lock-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_lock_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + " && cat > " + FIXTURE_DIR + "/simple.sdn <<'EOF'\nname: lock-fixture\nversion: 4.5.6\ndependencies:\n  alpha: \"*\"\n  beta: \"*\"\ndev_dependencies:\n  gamma: \"*\"\nEOF"
    ])

fn _run_lock(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/lock/main.spl\" " + joined
    ])

describe "lock log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-LOCK-LOGMODE-001
        # @capture(tui_grid): lock help text listing the shared log options
        step("Run lock --help in the fixture directory")
        _setup_fixture()
        val (out, err, code) = _run_lock(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports generate log-mode json":
        # @req REQ-LOCK-LOGMODE-001
        # @capture(protocol_json): generate JSON transcript for the three fixture dependencies
        step("Generate the lockfile for the fixture manifest with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_lock(["generate", "--force", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed generation
        expect(out).to_contain("\"command\":\"generate\"")
        expect(out).to_contain("\"count\":3")

    it "validates generated lockfile":
        # @req REQ-LOCK-LOGMODE-001
        # @capture(protocol_json): validate JSON transcript against a freshly generated lockfile
        step("Generate then validate the fixture lockfile with log-mode json")
        _setup_fixture()
        val (_gen_out, _gen_err, gen_code) = _run_lock(["generate", "--force"])
        expect(gen_code).to_equal(0)  # oracle: 0 is the CLI success exit code for the generate precondition
        val (out, err, code) = _run_lock(["validate", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a passing validation
        expect(out).to_contain("\"command\":\"validate\"")
        expect(out).to_contain("\"status\":\"ok\"")

    it "supports dot progress":
        # @req REQ-LOCK-LOGMODE-001
        # @capture(tui_grid): dot-progress output followed by the lockfile generation summary
        step("Generate the fixture lockfile with dot progress")
        _setup_fixture()
        val (out, err, code) = _run_lock(["generate", "--force", "--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed generation
        expect(out).to_start_with(".")
        expect(out).to_contain("Generated simple.lock with 3 packages")

    it "rejects invalid log mode":
        # @req REQ-LOCK-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke lock generate with an unknown log mode and expect a usage error")
        _setup_fixture()
        val (out, err, code) = _run_lock(["generate", "--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
