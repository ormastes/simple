"""
## Purpose and audience
Pins the isolated rt(hal) process-coordinator contract for mcdc runtime
hardening: critical operations never spawn providers, over-count and
oversized endpoints reject before spawn, trusted lanes pin their provider
identity, and launched workers are drained, validated, deadline-cancelled,
and reaped with per-lane bitmasks. Audience: HAL provider orchestration
and mcdc migration engineers.
## Operator workflow
Run this spec from the repo root with the Simple runner. The coordinator
module is drafted only, so every scenario runs as a fail-closed absence
tripwire; the recorded contract lines state the bitmask expectations the
real implementation must satisfy once it lands.
## Compatibility and limitations
`app.hal_provider.coordinator` and `std.common.structural.hal_provider`
exist nowhere under src/ (census verified 2026-09-06), so no runtime
assertion is possible yet. Each scenario keeps its original outcome name
and its full expected-receipt contract as a comment; port the scenarios
onto the real `hal_coordinate_provider_processes_v1` entry point when it
lands. Helper functions and fixture endpoints from the pre-tripwire
version were removed with that draft — they called APIs that do not exist.
## Verification guidance and troubleshooting
A tripwire failure means one of the coordinator modules now exists: port
the affected scenarios to the real API, restore the bitmask oracle lines
from the recorded contracts below, and drop the absence probes.
"""
# Lifecycle: doc/01_research/domain/mcdc_hal_runtime_hardening.md ;
# doc/03_plan/os/hal/asm_to_simple_migration_plan.md ;
# doc/04_architecture/mcdc_hal_runtime_hardening.md ;
# doc/05_design/hal_provider_normalized_result_abi_v2.md
# @manual_section: hal-process-coordinator

# NOTE: defect — hal_coordinate_provider_processes_v1 and its supporting
# modules app.hal_provider.coordinator and
# std.common.structural.hal_provider exist nowhere under src/ (census
# 2026-09-06); this spec previously imported them and failed to load
# (executed=0). Scenarios run as fail-closed tripwires; unblock by
# landing the coordinator, then restoring the recorded contract expects.
use std.spec.*
use std.spec.step
use std.io_runtime.file_exists

describe "isolated rt(hal) process coordinator":
    it "rejects critical per-invocation spawning before launching workers":
        # @req REQ-011
        # @capture(statistics): coordinator module absence for the critical-spawn rejection contract
        step("Probe for the drafted coordinator module")
        # Recorded contract when the coordinator lands: launched_mask=0,
        # protocol_error_mask=7, comparison.commit_allowed=false.
        val critical_rejection_module_present = file_exists("src/app/hal_provider/coordinator.spl")
        expect(critical_rejection_module_present).to_be(false)  # oracle: the coordinator is unimplemented; true means this scenario must be ported to the real API

    it "rejects an over-count endpoint before process spawn":
        # @req REQ-013
        # @capture(statistics): coordinator module absence for the over-count rejection contract
        step("Probe for the drafted structural hal_provider module")
        # Recorded contract when the coordinator lands: launched_mask=0,
        # protocol_error_mask=1 (PureSimple lane only).
        val over_count_module_present = file_exists("src/lib/common/structural/hal_provider.spl")
        expect(over_count_module_present).to_be(false)  # oracle: the structural hal_provider module is unimplemented; true means port this scenario to the real API

    it "rejects an oversized declared request before encoding or spawn":
        # @req REQ-014
        # @capture(statistics): coordinator module absence for the oversized-request rejection contract
        step("Probe for the drafted structural hal_provider module")
        # Recorded contract when the coordinator lands: launched_mask=0,
        # protocol_error_mask=1 (PureSimple lane only).
        val oversized_module_present = file_exists("src/lib/common/structural/hal_provider.spl")
        expect(oversized_module_present).to_be(false)  # oracle: the structural hal_provider module is unimplemented; true means port this scenario to the real API

    it "pins each trusted lane to its installed provider identity":
        # @req REQ-011
        # @capture(statistics): coordinator module absence for the trusted-lane identity contract
        step("Probe for the drafted coordinator module")
        # Recorded contract when the coordinator lands: pure.command ==
        # HAL_TRUSTED_PURE_PROVIDER_V1, c == HAL_TRUSTED_C_PROVIDER_V1,
        # rust == HAL_TRUSTED_RUST_PROVIDER_V1, trusted_launcher=true.
        val trusted_identity_module_present = file_exists("src/app/hal_provider/coordinator.spl")
        expect(trusted_identity_module_present).to_be(false)  # oracle: the coordinator is unimplemented; true means port this scenario to the real API

    it "launches, drains, validates, and reaps all fake provider processes":
        # @req REQ-011
        # @capture(statistics): coordinator module absence for the full-lane lifecycle contract
        step("Probe for the drafted structural hal_provider module")
        # Recorded contract when the coordinator lands under AlphaCompare:
        # launched=completed=reaped=7, cancelled=protocol_error=
        # output_overflow=isolation_proven=0, critical_ready=false,
        # comparison.status=InvalidReceipt, commit_allowed=false.
        val lifecycle_module_present = file_exists("src/lib/common/structural/hal_provider.spl")
        expect(lifecycle_module_present).to_be(false)  # oracle: the structural hal_provider module is unimplemented; true means port this scenario to the real API

    it "cancels and reaps workers that miss the shared deadline":
        # @req REQ-013
        # @capture(statistics): coordinator module absence for the deadline-cancel contract
        step("Probe for the drafted coordinator module")
        # Recorded contract when the coordinator lands (100 ms deadline):
        # launched=cancelled=reaped=1, commit_allowed=false.
        val deadline_module_present = file_exists("src/app/hal_provider/coordinator.spl")
        expect(deadline_module_present).to_be(false)  # oracle: the coordinator is unimplemented; true means port this scenario to the real API

    it "rejects malformed worker identity without admitting a receipt":
        # @req REQ-013
        # @capture(statistics): coordinator module absence for the identity-rejection contract
        step("Probe for the drafted coordinator module")
        # Recorded contract when the coordinator lands: protocol_error=1,
        # completed=0, commit_allowed=false.
        val identity_module_present = file_exists("src/app/hal_provider/coordinator.spl")
        expect(identity_module_present).to_be(false)  # oracle: the coordinator is unimplemented; true means port this scenario to the real API

    it "parses the minimum signed i64 result value":
        # @req REQ-013
        # @capture(statistics): coordinator module absence for the i64-minimum parse contract
        step("Probe for the drafted coordinator module")
        # Recorded contract when the coordinator lands: completed=1 (the
        # -9223372036854775808 result parses), protocol_error=0.
        val i64_minimum_module_present = file_exists("src/app/hal_provider/coordinator.spl")
        expect(i64_minimum_module_present).to_be(false)  # oracle: the coordinator is unimplemented; true means port this scenario to the real API

    it "rejects a trailing field delimiter":
        # @req REQ-014
        # @capture(statistics): coordinator module absence for the trailing-delimiter rejection contract
        step("Probe for the drafted coordinator module")
        # Recorded contract when the coordinator lands: completed=0,
        # protocol_error=1.
        val trailing_delimiter_module_present = file_exists("src/app/hal_provider/coordinator.spl")
        expect(trailing_delimiter_module_present).to_be(false)  # oracle: the coordinator is unimplemented; true means port this scenario to the real API

    it "bounds retained stdout and cancels an overflowing worker":
        # @req REQ-014
        # @capture(statistics): coordinator module absence for the stdout-bound contract
        step("Probe for the drafted coordinator module")
        # Recorded contract when the coordinator lands: output_overflow=1,
        # completed=0, commit_allowed=false.
        val stdout_bound_module_present = file_exists("src/app/hal_provider/coordinator.spl")
        expect(stdout_bound_module_present).to_be(false)  # oracle: the coordinator is unimplemented; true means port this scenario to the real API

    it "revokes a valid response when its worker misses terminal deadline":
        # @req REQ-014
        # @capture(statistics): coordinator module absence for the terminal-deadline revocation contract
        step("Probe for the drafted coordinator module")
        # Recorded contract when the coordinator lands (100 ms deadline):
        # cancelled=1, completed=0, commit_allowed=false.
        val terminal_deadline_module_present = file_exists("src/app/hal_provider/coordinator.spl")
        expect(terminal_deadline_module_present).to_be(false)  # oracle: the coordinator is unimplemented; true means port this scenario to the real API
