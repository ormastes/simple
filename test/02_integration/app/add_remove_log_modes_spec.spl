"""
## Purpose and audience
Purpose: Prove that add/remove log mode CLI options.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
# @manual: primary
REQ-APP-001
doc/01_research/local/pure_simple_cli_completeness.md
doc/03_plan/agent_tasks/pure_simple_cli_completeness.md
doc/04_architecture/pure_simple_cli_completeness.md
doc/05_design/pure_simple_cli_completeness.md
"""
# @req: REQ-APP-001

# @slow — 16 full-interpreter spawns loading 600+ modules (~100s each); needs slow-lane resource limits. See doc/08_tracking/bug/add_remove_log_modes_timeout_resource_limit_2026-07-17.md
use std.spec.step

use std.spec.{describe, it, slow_it, expect}

val FIXTURE_DIR = get_temp_dir().replace("\\", "/") + "/simple_add_remove_log_mode_fixture"

fn _setup_fixture():
    val _removed = dir_remove_all(FIXTURE_DIR)
    if not dir_create_all(FIXTURE_DIR):
        fail("could not create fixture dir " + FIXTURE_DIR)
    if not file_create_exclusive(FIXTURE_DIR + "/simple.sdn", "name: add-remove-fixture\nversion: 6.7.8\ndependencies:\n  alpha: \"*\"\n"):
        fail("could not write fixture file " + FIXTURE_DIR + "/simple.sdn")

fn _run_app(app: text, args: [text]) -> (text, text, i64):
    _spawn_cli(["src/app/" + app + "/main.spl"] + args, FIXTURE_DIR, [])

use std.spec.step
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.env.platform.{is_windows, get_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all}
use std.nogc_sync_mut.io.file_ops.{file_create_exclusive}
use std.env.variables.{env_get}
use std.nogc_sync_mut.io.env_ops.{cwd}

val CLI_RUN_TIMEOUT_MS: i64 = 120000
val CLI_RUN_MAX_OUT: i64 = 16777216

fn _cli_repo_root() -> text:
    cwd().replace("\\", "/")

fn _spawn_cli(run_args: [text], work_dir: text, extra_env: [(text, text)]) -> (text, text, i64):
    """Host-portable replacement for the old POSIX sh harness: runs
    `bin/simple run <run_args...>` with SIMPLE_LIB bound to the repo src
    tree, optionally under a different working directory and with extra
    environment variables set for the child."""
    val repo = _cli_repo_root()
    val program = if is_windows(): repo + "/bin/simple.exe" else: repo + "/bin/simple"
    val lib = repo + "/src"
    val joined = run_args.join(" ")
    val (shell, shell_args) = if is_windows():
        val sh = env_get("ComSpec") ?? "cmd.exe"
        var cmd = ""
        if work_dir != "":
            cmd = cmd + "cd /d " + work_dir + " && "
        for (key, value) in extra_env:
            cmd = cmd + "set \"" + key + "=" + value + "\" && "
        cmd = cmd + "set \"SIMPLE_LIB=" + lib + "\" && " + program + " run " + joined
        (sh, ["/d", "/c", cmd])
    else:
        var prefix = ""
        if work_dir != "":
            prefix = prefix + "cd \"" + work_dir + "\" && "
        for (key, value) in extra_env:
            prefix = prefix + key + "=\"" + value + "\" "
        ("/bin/sh", ["-c", prefix + "SIMPLE_LIB=\"" + lib + "\" \"" + program + "\" run " + joined])
    process_run_bounded(shell, shell_args, CLI_RUN_TIMEOUT_MS, CLI_RUN_MAX_OUT)

describe "add/remove log mode CLI options":
    # @manual scenario evidence
    slow_it "shows shared add log options in help":
        # @req: REQ-APP-001
        step("Verify: shows shared add log options in help")
        _setup_fixture()
        val (out, err, code) = _run_app("add", ["--help"])
        expect(code).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    slow_it "shows shared remove log options in help":
        # @req: REQ-APP-001
        step("Verify: shows shared remove log options in help")
        _setup_fixture()
        val (out, err, code) = _run_app("remove", ["--help"])
        expect(code).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    slow_it "supports add log-mode json":
        # @req: REQ-APP-001
        step("Verify: supports add log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_app("add", ["beta@^1.0.0", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(out).to_contain("\"command\":\"add\"")
        expect(out).to_contain("\"name\":\"beta\"")
        expect(out).to_contain("\"constraint\":\"^1.0.0\"")

    slow_it "supports remove log-mode json":
        # @req: REQ-APP-001
        step("Verify: supports remove log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_app("remove", ["alpha", "--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(out).to_contain("\"command\":\"remove\"")
        expect(out).to_contain("\"name\":\"alpha\"")

    slow_it "supports add dot progress":
        # @req: REQ-APP-001
        step("Verify: supports add dot progress")
        _setup_fixture()
        val (out, err, code) = _run_app("add", ["beta", "--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(out).to_start_with(".")
        expect(out).to_contain("Added dependency 'beta'")

    slow_it "supports remove dot progress":
        # @req: REQ-APP-001
        step("Verify: supports remove dot progress")
        _setup_fixture()
        val (out, err, code) = _run_app("remove", ["alpha", "--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(out).to_start_with(".")
        expect(out).to_contain("Removed dependency 'alpha'")

    slow_it "rejects invalid add log mode":
        # @req: REQ-APP-001
        step("Verify: rejects invalid add log mode")
        _setup_fixture()
        val (out, err, code) = _run_app("add", ["beta", "--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 — named expected value from the requirement

    slow_it "rejects invalid remove log mode":
        # @req: REQ-APP-001
        step("Verify: rejects invalid remove log mode")
        _setup_fixture()
        val (out, err, code) = _run_app("remove", ["alpha", "--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 — named expected value from the requirement
