"""
## Purpose and audience
Purpose: pin the shared CLI log-mode surface of the todo-scan command
(--log-mode and --progress) as observed through real process invocations
against a fixture source tree.
Audience: compiler and tooling engineers who maintain the todo-scan app and
the shared log-option helpers it consumes.
## Operator workflow
Run this spec with
`simple run test/02_integration/app/todo_scan_log_modes_spec.spl`
and read the per-scenario verdict lines; a failing scenario pinpoints the
regressed CLI behavior.
## Compatibility and limitations
Covers the todo-scan command's shared log options only; each scenario spawns
real `bin/simple` processes and builds its fixture under /tmp with one src
file carrying a single tagged TODO comment.
## Verification guidance and troubleshooting
A failure names the exact option and mode that regressed; re-run this spec
and compare the captured stdout in the failing scenario to reproduce locally.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/pure_simple_cli_completeness.md
# @manual_section: todo-scan-log-modes

use std.spec.{describe, it, expect}
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_todo_scan_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + "/src && cat > " + FIXTURE_DIR + "/src/main.spl <<'EOF'\n# TODO: [runtime][P1] fix scanner fixture [#42]\nfn main() -> i32:\n    0\nEOF"
    ])

fn _run_todo_scan(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/todo_scan/main.spl\" " + joined
    ])

describe "todo-scan log mode CLI options":
    it "shows shared log options in help":
        # @req REQ-TODOSCAN-LOGMODE-001
        # @capture(tui_grid): todo-scan help text listing the shared log options
        step("Run todo-scan --help in the fixture directory")
        _setup_fixture()
        val (out, err, code) = _run_todo_scan(["--help"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for --help
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json":
        # @req REQ-TODOSCAN-LOGMODE-001
        # @capture(protocol_json): scan JSON transcript for the one-file one-todo fixture tree
        step("Scan the one-file fixture tree with log-mode json")
        _setup_fixture()
        val (out, err, code) = _run_todo_scan(["--log-mode=json"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed scan
        expect(out).to_contain("\"command\":\"todo-scan\"")
        expect(out).to_contain("\"files\":1")
        expect(out).to_contain("\"todos\":1")

    it "supports dot progress":
        # @req REQ-TODOSCAN-LOGMODE-001
        # @capture(tui_grid): dot-progress output followed by the scan summary line
        step("Scan the one-file fixture tree with dot progress")
        _setup_fixture()
        val (out, err, code) = _run_todo_scan(["--progress=dot"])
        expect(code).to_equal(0)  # oracle: 0 is the CLI success exit code for a completed scan
        expect(out).to_contain(".")
        expect(out).to_contain("Scan complete: 1 TODOs found")

    it "rejects invalid log mode":
        # @req REQ-TODOSCAN-LOGMODE-001
        # @capture(tui_grid): usage-error output emitted for an unknown log mode
        step("Invoke todo-scan with an unknown log mode and expect a usage error")
        _setup_fixture()
        val (out, err, code) = _run_todo_scan(["--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: 1 is the CLI usage-error exit code for an unknown mode
