use common.ui.widget_draw_ir.{widget_tree_to_draw_ir_cpu}
use common.ui.wm_full_stack_demo.{wm_full_stack_demo_tree}

fn _has_command(composition, component_id: text) -> bool:
    for batch in composition.batches:
        for command in batch.commands:
            if command.component_id == component_id:
                return true
    false

fn main() -> i64:
    val tree = wm_full_stack_demo_tree("Ready", "Play sound", "")
    val composition = widget_tree_to_draw_ir_cpu(
        tree.root_node(), 480, 480
    )
    if (composition.batches.len() == 2 and
        _has_command(composition, "demo-root") and
        _has_command(composition, "demo-button") and
        _has_command(composition, "demo-scroll-scrollbar-thumb") and
        _has_command(composition, "demo-surface-2d") and
        _has_command(composition, "demo-surface-web")):
        print "WIDGET DRAW IR NATIVE PROBE: PASS"
        return 0
    print "WIDGET DRAW IR NATIVE PROBE: FAIL"
    1
