# @cover src/lib/common/ui/ui_scene_event_route.spl 40%
# @tag: integration, ui, draw_ir, draw_ir_v3, unified_packed_ui_scene, l9, cross_producer_nesting

# Closes the cross-producer owner-chain wiring follow-on noted in
# ui_scene_event_route.spl's own module doc: ui_scene_event_route_spec.spl
# proves the ROUTING ALGORITHM against a hand-built `[UiOwnerRecord]`
# fixture; this spec proves the SAME "WebView chain walks Web->GUI host->WM
# in that order" gate against REAL emitted WM/GUI/Web packed-producer
# output, composed via the `host_owner_id` wiring added to
# GuiPackedProducer and WebPackedProducer alongside WM's new per-window
# owner records (wm_packed_producer.spl).

use std.spec
use common.ui.builder.{column, button, label, build_tree_with_title, with_height, with_width}
use common.ui.widget.{WidgetNode}
use common.ui.draw_ir.{DRAW_IR_BACKEND_GPU}
use common.ui.draw_ir_v3.{
    DRAW_IR_V3_NO_ID,
    DrawIrV3Scene,
    draw_ir_v3_empty_scene,
    draw_ir_v3_scene_push_command,
    draw_ir_v3_transform_append,
    draw_ir_v3_clip_append,
    draw_ir_v3_paint_append,
    draw_ir_v3_hit_shape_append
}
use common.ui.draw_ir_v3_group_resolve.{draw_ir_v3_group_resolve, draw_ir_v3_port_surface_state_empty}
use common.ui.ui_scene_counts.{ui_scene_counts_zero, ui_scene_scan}
use common.ui.ui_scene_owner_table.{UiOwnerRecord}
use common.ui.ui_scene_slice.{UiSceneEmitResult}
use common.ui.ui_scene_event_route.{ui_scene_route_event}
use common.ui.window.{WindowManager}
use common.ui.window_surface_registry.{UiWindowSurfaceRegistry, UI_SURFACE_KIND_SIMPLE_WEB}
use common.ui.taskbar_model.{TaskbarModel}
use common.ui.window_scene.{shared_wm_background_color}
use common.ui.app_menu_registry.{AppMenuRegistry}
use common.ui.wm_packed_producer.{WmPackedProducer, wm_packed_producer_window_owner_semantic_id}
use common.ui.ui_gui_packed_producer.{GuiPackedProducer}
use common.ui.ui_web_packed_producer.{WebPackedProducer}
use nogc_sync_mut.ui.draw_ir_v3_native_writer.{
    UiSceneNativeWriter,
    UiSceneNativeOwnerWriter,
    UiSceneNativeActionWriter
}

# --- WM fixture --------------------------------------------------------------

fn _ns_tree(title: text):
    build_tree_with_title(column("{title}_root", [label("{title}_label", title)]), title, "glass_dark")

fn _ns_wm_manager() -> WindowManager:
    var manager = WindowManager.new()
    manager.open_window("surf1", "One", 10, 40, 300, 200, _ns_tree("one"))
    manager

fn _ns_wm_registry() -> UiWindowSurfaceRegistry:
    var registry = UiWindowSurfaceRegistry.new()
    registry.bind_with_kind("win1", "surf1", 42u64, "demo.app", "Window One", UI_SURFACE_KIND_SIMPLE_WEB)
    registry

fn _ns_wm_taskbar() -> TaskbarModel:
    TaskbarModel(pinned: [], running: [], tray: [])

fn _ns_wm_producer() -> WmPackedProducer:
    WmPackedProducer(
        id_val: 1u32, manager: _ns_wm_manager(), registry: _ns_wm_registry(), taskbar: _ns_wm_taskbar(),
        width: 800, height: 600, background: shared_wm_background_color(0xFF112233u32),
        menu_registry: AppMenuRegistry.new(), active_app_id: DRAW_IR_V3_NO_ID,
        backend_target: DRAW_IR_BACKEND_GPU, dpi_scale_milli: 1000, clock_label: "09:41", right_icon_count: 2
    )

# --- GUI fixture (one interactive widget standing in for a WebView host) ----

fn _ns_gui_root() -> WidgetNode:
    val host = with_height(with_width(button("ns-webview-host", "WebView", "noop"), 200), 150)
    column("ns-root", [host])

fn _ns_gui_producer(host_owner_id: u32) -> GuiPackedProducer:
    GuiPackedProducer(id_val: 2u32, root: _ns_gui_root(), width: 200, height: 150, host_owner_id: host_owner_id)

# --- Web fixture (one absolutely-positioned box, pinned like L7's corpus) ---

val _NS_WEB_HTML: text = "<html><head><style>html,body{margin:0;padding:0}#a{position:absolute;left:5px;top:5px;width:40px;height:20px;background:#1D4ED8}</style></head><body><div id='a'></div></body></html>"

fn _ns_web_producer(host_owner_id: u32) -> WebPackedProducer:
    WebPackedProducer(id_val: 3u32, html: _NS_WEB_HTML, width: 100, height: 70, host_parent_id: DRAW_IR_V3_NO_ID, host_owner_id: host_owner_id)

# --- Scene combining ----------------------------------------------------------

# `draw_ir_v3_group_resolve`/`draw_ir_v3_group_resolve_hit_test` only ever
# read commands, hit_shapes, transforms, clips and paint (verified against
# their own bodies) -- only those five tables need combining to prove
# routing. Table-row-index ids (geometry_id, paint_id, ...) are already
# arena-absolute against the SAME `ui_scene_scan` ranges these three
# producers share, so those need no adjustment. But `component_id`/
# `parent_id` (on commands and hit_shapes) and the matching owner
# `semantic_id` are each producer's own LOCAL numbering, independently
# started at 0 by that producer's own oracle -- plain concatenation
# collides them across producers and breaks draw_ir_v3_group_resolve's
# structural parent-child matching (found and fixed in this spec: it
# returned ok=false, states=[] before this offsetting existed). A real
# multi-producer assembler will need to do exactly this same offsetting;
# it does not exist yet, so this spec does it inline rather than inventing
# a module to hold six lines.
fn _ns_rebase_component(id: u32, offset: u32) -> u32:
    if id == DRAW_IR_V3_NO_ID:
        DRAW_IR_V3_NO_ID
    else:
        id + offset

fn _ns_append_writer_output(scene: DrawIrV3Scene, draw: UiSceneNativeWriter, id_offset: u32) -> DrawIrV3Scene:
    var out = scene
    for cmd in draw.commands_snapshot():
        var c = cmd
        c.component_id = _ns_rebase_component(cmd.component_id, id_offset)
        c.parent_id = _ns_rebase_component(cmd.parent_id, id_offset)
        out = draw_ir_v3_scene_push_command(out, c)
    for t in draw.transforms_snapshot():
        out.transforms = draw_ir_v3_transform_append(out.transforms, t.m11, t.m12, t.m21, t.m22, t.dx, t.dy)
    for c in draw.clips_snapshot():
        out.clips = draw_ir_v3_clip_append(out.clips, c.x, c.y, c.width, c.height, c.corner_radius, c.parent_id)
    for p in draw.paint_snapshot():
        out.paint = draw_ir_v3_paint_append(out.paint, p.fill_color, p.stroke_color, p.stroke_width_milli, p.opacity_milli, p.blend_mode)
    for h in draw.hit_shapes_snapshot():
        out.hit_shapes = draw_ir_v3_hit_shape_append(out.hit_shapes, h.x, h.y, h.width, h.height, h.shape_kind, h.hit_flags, _ns_rebase_component(h.component_id, id_offset))
    out

describe "Unified packed UI scene nested composition (WM->GUI->Web, real producer output)":
    """Composes real WM, GUI and Web packed-producer output -- not the
    hand-built owner-array fixture ui_scene_event_route_spec.spl uses --
    and asserts ui_scene_route_event's owner_chain against absolute owner
    indices read back from each producer's own emitted output, closing the
    loop on gate (c) for production scenes."""

    it "routes a click on the Web element through GUI's WebView-host owner to WM's window owner":
        val wm = _ns_wm_producer()
        val gui_placeholder = _ns_gui_producer(DRAW_IR_V3_NO_ID)
        val web_placeholder = _ns_web_producer(DRAW_IR_V3_NO_ID)

        # host_owner_id/host_parent_id affect owner-record CONTENT only,
        # never row COUNTS (verified: _gui_counts_of/_web_counts_of never
        # read either field) -- so counts computed from placeholders are
        # valid for the real, correctly-nested producers built below.
        val wm_counts = wm.count(1u64, ui_scene_counts_zero())
        val gui_counts = gui_placeholder.count(1u64, ui_scene_counts_zero())
        val web_counts = web_placeholder.count(1u64, ui_scene_counts_zero())
        val scanned = ui_scene_scan([wm_counts, gui_counts, web_counts])
        val wm_ranges = scanned[0]
        val gui_ranges = scanned[1]
        val web_ranges = scanned[2]

        step("Pass 1: emit WM for real, read back its window owner's absolute index")
        var wm_draw = UiSceneNativeWriter.new(wm_ranges)
        var wm_owners = UiSceneNativeOwnerWriter.new(wm_ranges.owner_records)
        var wm_actions = UiSceneNativeActionWriter.new(wm_ranges.action_bindings)
        val wm_result = wm.emit(1u64, wm_ranges, wm_draw, wm_owners, wm_actions)
        var wm_window_owner_abs = DRAW_IR_V3_NO_ID
        match wm_result:
            UiSceneEmitResult.Emitted(slice):
                val target_semantic_id = wm_packed_producer_window_owner_semantic_id(wm, 0u32)
                val records = wm_owners.records_snapshot()
                var i = 0
                while i < records.len():
                    if records[i].semantic_id == target_semantic_id:
                        wm_window_owner_abs = wm_ranges.owner_records.start + i.to_u32()
                    i = i + 1
            UiSceneEmitResult.Refused(receipt):
                expect(true).to_equal(false)
        assert_true(wm_window_owner_abs != DRAW_IR_V3_NO_ID)

        step("Pass 2: emit GUI nested under WM's window owner, read back its WebView-host owner's absolute index")
        val gui = _ns_gui_producer(wm_window_owner_abs)
        var gui_draw = UiSceneNativeWriter.new(gui_ranges)
        var gui_owners = UiSceneNativeOwnerWriter.new(gui_ranges.owner_records)
        var gui_actions = UiSceneNativeActionWriter.new(gui_ranges.action_bindings)
        val gui_result = gui.emit(1u64, gui_ranges, gui_draw, gui_owners, gui_actions)
        var gui_webview_owner_abs = DRAW_IR_V3_NO_ID
        match gui_result:
            UiSceneEmitResult.Emitted(slice):
                val records = gui_owners.records_snapshot()
                expect(records.len()).to_equal(1)
                expect(records[0].parent_owner_id).to_equal(wm_window_owner_abs)
                gui_webview_owner_abs = gui_ranges.owner_records.start
            UiSceneEmitResult.Refused(receipt):
                expect(true).to_equal(false)
        assert_true(gui_webview_owner_abs != DRAW_IR_V3_NO_ID)

        step("Pass 3: emit Web nested under GUI's WebView-host owner")
        val web = _ns_web_producer(gui_webview_owner_abs)
        var web_draw = UiSceneNativeWriter.new(web_ranges)
        var web_owners = UiSceneNativeOwnerWriter.new(web_ranges.owner_records)
        var web_actions = UiSceneNativeActionWriter.new(web_ranges.action_bindings)
        val web_result = web.emit(1u64, web_ranges, web_draw, web_owners, web_actions)
        match web_result:
            UiSceneEmitResult.Emitted(slice):
                expect(web_owners.records_snapshot().len()).to_be_greater_than(0)
            UiSceneEmitResult.Refused(receipt):
                expect(true).to_equal(false)

        step("Verify owner-table ranges match emission order before trusting plain-push combining")
        # combined_owners below is built by pushing each producer's records
        # in scan order; that only reproduces a real committed UiSceneArena
        # if each producer's assigned owner_records range starts exactly
        # where the previous producer's rows end -- assert it instead of
        # trusting the coincidence.
        val wm_owner_count = wm_owners.records_snapshot().len().to_u32()
        val gui_owner_count = gui_owners.records_snapshot().len().to_u32()
        val web_owner_count = web_owners.records_snapshot().len().to_u32()
        assert_true(wm_ranges.owner_records.start == 0u32)
        assert_true(gui_ranges.owner_records.start == wm_ranges.owner_records.start + wm_owner_count)
        assert_true(web_ranges.owner_records.start == gui_ranges.owner_records.start + gui_owner_count)

        step("Combine into one scene + one owner array (scan order), rebasing each producer's local component_id/semantic_id space")
        var combined = draw_ir_v3_empty_scene(1u32, 1u32)
        val wm_id_offset = combined.commands.len().to_u32()
        combined = _ns_append_writer_output(combined, wm_draw, wm_id_offset)
        val gui_id_offset = combined.commands.len().to_u32()
        combined = _ns_append_writer_output(combined, gui_draw, gui_id_offset)
        val web_id_offset = combined.commands.len().to_u32()
        combined = _ns_append_writer_output(combined, web_draw, web_id_offset)

        var combined_owners: [UiOwnerRecord] = []
        for rec in wm_owners.records_snapshot():
            var r = rec
            r.semantic_id = _ns_rebase_component(rec.semantic_id, wm_id_offset)
            combined_owners.push(r)
        for rec in gui_owners.records_snapshot():
            var r = rec
            r.semantic_id = _ns_rebase_component(rec.semantic_id, gui_id_offset)
            combined_owners.push(r)
        for rec in web_owners.records_snapshot():
            var r = rec
            r.semantic_id = _ns_rebase_component(rec.semantic_id, web_id_offset)
            combined_owners.push(r)

        val resolved = draw_ir_v3_group_resolve(combined, draw_ir_v3_port_surface_state_empty())
        val receipt = ui_scene_route_event(combined, resolved, combined_owners, 10, 10)

        expect(receipt.accepted).to_equal(true)
        expect(receipt.owner_chain.len()).to_equal(3)
        val web_owner_start = web_ranges.owner_records.start
        assert_true(receipt.owner_chain[0] >= web_owner_start)
        assert_true(receipt.owner_chain[0] < web_owner_start + web_owner_count)
        expect(receipt.owner_chain[1]).to_equal(gui_webview_owner_abs)
        expect(receipt.owner_chain[2]).to_equal(wm_window_owner_abs)
        print "ns_nested_route chain=[{receipt.owner_chain[0]},{receipt.owner_chain[1]},{receipt.owner_chain[2]}] wm_window={wm_window_owner_abs} gui_host={gui_webview_owner_abs}"
