use common.ui.builder.{column}
use common.ui.profile.{Orientation}
use common.ui.widget.{UIEvent, UITree}
use nogc_sync_mut.ui.session.{new_session}

fn main() -> i64:
    var session = new_session(UITree.new(column("root", [])))
    session.set_active_backend("tui")
    session.dispatch(UIEvent.Resize(40, 60))
    if (session.viewport.width == 40 and
        session.viewport.height == 60 and
        session.profile_resolver.current.orientation == Orientation.Portrait):
        print "UI SESSION RESIZE NATIVE PROBE: PASS"
        return 0
    print "UI SESSION RESIZE NATIVE PROBE: FAIL"
    1
