struct Inner:
    d: Dict<text, i64>
    arr: [text]

struct Holder:
    by: Dict<text, Inner>

fn make_holder(m: Dict<text, Inner>) -> Holder:
    Holder(by: m)

fn main():
    var inner_d: Dict<text, i64> = {}
    inner_d["a"] = 1
    inner_d["b"] = 2
    val inner = Inner(d: inner_d, arr: ["x", "y"])
    print "A direct inner: keys={inner.d.keys().len()} arr={inner.arr.len()}"

    var m: Dict<text, Inner> = {}
    m["mod"] = inner
    print "B in map: keys={m["mod"].d.keys().len()} arr={m["mod"].arr.len()}"

    val h = make_holder(m)
    print "C via fn-arg into field: keys={h.by["mod"].d.keys().len()} arr={h.by["mod"].arr.len()}"
    print "D contains={h.by.contains_key("mod")} outer_keys={h.by.keys().len()}"
