use app.io.env_ops.{env_get}
extern fn rt_stderr_write(s: text)

fn main() -> i64:
    unsafe(capabilities: [ffi]):
        rt_stderr_write("A\n")
    val os_env = env_get("OS")
    unsafe(capabilities: [ffi]):
        rt_stderr_write("B got\n")
    if os_env == nil:
        unsafe(capabilities: [ffi]):
            rt_stderr_write("C nil\n")
    else:
        val l = os_env.lower()
        unsafe(capabilities: [ffi]):
            rt_stderr_write("D lower={l}\n")
        val c = l.contains("windows")
        unsafe(capabilities: [ffi]):
            rt_stderr_write("E contains={c}\n")
    0

main()
