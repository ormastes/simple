interactive_cases |id, title, engine_scope, event_kind, expected_parity|
    e01, "Click Button & Action Dispatch", "Chrome DOM click vs Pure-Simple BrowserSession/widget_hit", pointer_click, "Clicked button updates DOM/action state and repaints active fill"
    e02, "Pointer Move & Drag Capture", "Chrome drag vs HostCompositor/widget_dispatch_pointer_move", pointer_drag, "Captured target tracks outside bounds and ignores sibling release"
    e03, "Dropdown Select & Disclosure Toggle", "Chrome select/details vs Pure-Simple popup/disclosure", toggle_select, "Dropdown open state and selection value match across renders"
    e04, "Keyboard Input, Shift & Focus Traversal", "Chrome Tab/keydown vs common.ui.event + ScreenGuiHost", keyboard_focus, "Focus skips non-interactive/hidden/disabled nodes and clears preedit on blur"
    e05, "Wheel Scroll Clamping & Linked Sync", "Chrome scrollTop vs BrowserSession/showcase scroll", wheel_scroll, "Wheel delta clamps scroll_y cleanly and updates visible viewport band"
    e06, "JS / SimpleScript DOM Mutation & Re-render", "Chrome JS listener vs SimpleScriptExecutor DOM revision", script_mutation, "Listener DOM edit advances single UI revision and matches post-event frame"
