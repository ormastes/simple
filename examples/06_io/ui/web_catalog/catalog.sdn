# Shared HTML catalog consumed by BOTH the Chrome dynlib showcase and the
# Simple web renderer showcase. Generated by src/app/ui/chrome_showcase.
web_catalog:
  inventory_version: web-renderable-feature-inventory-v1
  source: examples/06_io/ui/browser_common_elements_showcase.html
  tabs:
    - tab: overview
      file: overview.html
    - tab: html
      file: html.html
    - tab: css-layout
      file: css-layout.html
    - tab: css-paint
      file: css-paint.html
    - tab: forms-media
      file: forms-media.html
    - tab: animation
      file: animation.html
    - tab: evidence
      file: evidence.html
    - tab: tab-bar
      file: tab-bar.html
