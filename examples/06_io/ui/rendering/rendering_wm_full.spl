# rendering_wm_full.spl — WM-as-server rendering showcase, full tier: the WM
# runs as the compositor server, opens its desktop by default, and admits the
# showcase windows ON the WM as internal windows through the production WM
# bridge. Headless composed PPM is the default; SIMPLE_GUI=1 additionally
# presents the composed desktop in a physical window.
# lane: wm
# tier: full
# core: examples.ui.rendering_wm_common
#
# Admission flow (in-process, deterministic — the file/env bridge in
# common.ui.wm_app_process_contract is the child-process variant; this entry
# goes through the same apply_bridge_request path a real app process uses,
# like examples/06_io/ui/wm_multiapp_taskbar_gui.spl):
#
#   comp.apply_bridge_request(seq, owner_port, COMP_CREATE_WINDOW, 0,
#       title, x, y, w, h, content, pid, app_id)
#
# Each admitted window is a showcase placeholder — GUI widgets, 2D scene, web
# page — rendered by a small built-in pixel producer and handed to the
# compositor through the external content-frame boundary
# (require_external_web_frame + set_external_web_frame), the same admission
# src/app/wm_showcase/session.spl uses. The taskbar is NOT built here:
# HostCompositor.taskbar_model() projects it from the live window list, so a
# window that closes necessarily removes its taskbar entry.
#
# The shared admission/capture/artifact helpers live in
# examples/ui/rendering_wm_common (imported below); this entry keeps its own
# window specs, pixel producers, sabotage sequence, and gates.
#
# Scripted sabotage sequence (mirrors wm_showcase/session.spl; every receipt
# is from the SAME run):
#   1. admit three windows            -> `base`     (taskbar shows all three)
#   2. close the web window           -> `closed`   (bridge COMP_DESTROY_WINDOW;
#                                                    its taskbar entry must vanish)
#   3. re-admit the web window        -> `restored` (entry must return)
#   4. mutate the 2D scene            -> `mutated`  (capture must change)
#   5. click the 2D taskbar item      -> focus must move to the 2D window
# Steps 2 and 4 are the sabotage arms: a taskbar that renders the same list
# regardless of window state, or a capture insensitive to the scene, fails
# here rather than passing decoratively.
#
# Env knobs (shared contract): SIMPLE_SHOWCASE_W/H (default 640x480, minimum
# 640x480), SIMPLE_SHOWCASE_FRAMES (GUI present count), SIMPLE_SHOWCASE_CAPTURE
# (PPM output path), SIMPLE_GUI=1 (physical window; headless PPM default),
# SIMPLE_2D_BACKEND (cpu|cpu_simd|vulkan|metal, default vulkan) — advisory:
# the compositor desktop is a pixel buffer, so headless capture is
# backend-independent; the configured backend applies wherever an Engine2D
# backend is constructed.

use os.compositor.host_compositor_entry.{
    HostCompositor, host_compositor_focused_window_id,
    host_compositor_left_button_at,
}
use os.userlib.ipc_protocol.{COMP_DESTROY_WINDOW}
use common.window_protocol.geometry.{Size}
use common.ui.pixel_surface_content_frame.{pixel_surface_content_frame}
use examples.ui.rendering_wm_common.{
    WM_DEFAULT_W, WM_DEFAULT_H, WM_MIN_W, WM_MIN_H,
    WmWindowSpec, WmAdmitted, WmCapture,
    wm_env_text, wm_env_i32,
    wm_blit_rect,
    wm_taskbar_has_title,
    wm_content_theme_id, wm_content_dims, wm_admit_window, wm_capture_desktop,
    wm_capture_path, wm_provenance_path, wm_write_ppm, wm_write_provenance,
    wm_gui_present
}

val WM_FULL_ARTIFACT: text = "wm_full"

# Taskbar hit geometry of the headless pixel lane (HostCompositor
# _hit_shared_taskbar): slot i occupies x = i*56 .. i*56+56 in the bottom 56
# rows, enumerated in taskbar_model().running order.
val WM_FULL_TASKBAR_SLOT_W: i32 = 56
val WM_FULL_TASKBAR_H: i32 = 56

val WM_FULL_KEY_GUI: text = "gui"
val WM_FULL_KEY_2D: text = "2d"
val WM_FULL_KEY_WEB: text = "web"

# The 2D scene's mutated-arm rect offset (home is 24).
val WM_FULL_MUTATED_SHIFT: i32 = 40

fn wm_full_specs() -> [WmWindowSpec]:
    """The three showcase windows. Laid out without overlap, every bottom
    edge above the taskbar band (bottom 56 rows), so each content rect can be
    read back unoccluded from the composite."""
    [
        WmWindowSpec(
            key: WM_FULL_KEY_GUI, title: "Rendering GUI",
            app_id: "/sys/apps/rendering-gui",
            x: 16, y: 64, w: 280, h: 170
        ),
        WmWindowSpec(
            key: WM_FULL_KEY_2D, title: "Rendering 2D",
            app_id: "/sys/apps/rendering-2d",
            x: 320, y: 64, w: 280, h: 170
        ),
        WmWindowSpec(
            key: WM_FULL_KEY_WEB, title: "Rendering Web",
            app_id: "/sys/apps/rendering-web",
            x: 16, y: 250, w: 280, h: 170
        ),
    ]

fn wm_full_spec_for(key: text) -> WmWindowSpec:
    for spec in wm_full_specs():
        if spec.key == key:
            return spec
    wm_full_specs()[0]

# ---------------------------------------------------------------------------
# Built-in content producers — each window kind gets a distinct rect-art
# producer so the desktop checksum is sensitive to every window and to the
# 2D scene's mutation arm.
# ---------------------------------------------------------------------------

fn paint_widgets(w: i32, h: i32) -> [u32]:
    """The GUI-widgets placeholder: menubar, button, list rows, progress,
    statusbar."""
    var px: [u32] = [0xFF1E2836u32; w * h]
    wm_blit_rect(px, w, h, 0, 0, w, 14, 0xFF2B3A55u32)
    wm_blit_rect(px, w, h, 10, 24, 64, 16, 0xFF0066CCu32)
    var r = 0
    while r < 4:
        wm_blit_rect(px, w, h, 10, 50 + r * 12, w - 20, 7, 0xFF3A4A66u32)
        r = r + 1
    wm_blit_rect(px, w, h, 10, 104, w - 20, 9, 0xFF10161Fu32)
    wm_blit_rect(px, w, h, 10, 104, (w - 20) * 13 / 20, 9, 0xFF33B26Bu32)
    wm_blit_rect(px, w, h, 0, h - 12, w, 12, 0xFF141C28u32)
    wm_blit_rect(px, w, h, 6, h - 9, 40, 6, 0xFFE5C33Du32)
    px

fn paint_scene2d(w: i32, h: i32, shift: i32) -> [u32]:
    """The 2D-scene placeholder: sky, ground, grid, a draggable rect at
    (24 + shift, 30). `shift` is what the mutation arm moves."""
    var px: [u32] = [0xFF274060u32; w * h]
    wm_blit_rect(px, w, h, 0, h / 2, w, h - h / 2, 0xFF2E5E3Au32)
    wm_blit_rect(px, w, h, w - 40, 12, 22, 22, 0xFFE5C33Du32)
    var g = 0
    while g < w:
        wm_blit_rect(px, w, h, g, 0, 1, h, 0xFF33475Bu32)
        g = g + 16
    wm_blit_rect(px, w, h, 24 + shift, 30, 44, 26, 0xFFD9822Bu32)
    wm_blit_rect(px, w, h, 24 + shift, 30, 44, 3, 0xFFE5533Du32)
    wm_blit_rect(px, w, h, 100 + shift, h / 2 + 14, 60, 20, 0xFF5CC0E0u32)
    px

fn paint_webpage(w: i32, h: i32) -> [u32]:
    """The web-page placeholder: header band, heading, lede lines, link,
    footer."""
    var px: [u32] = [0xFFFFFFFFu32; w * h]
    wm_blit_rect(px, w, h, 0, 0, w, 18, 0xFF0B1F33u32)
    wm_blit_rect(px, w, h, 8, 28, w - 48, 9, 0xFF2563EBu32)
    wm_blit_rect(px, w, h, 8, 44, w - 72, 5, 0xFF33475Bu32)
    wm_blit_rect(px, w, h, 8, 56, w - 96, 5, 0xFF33475Bu32)
    wm_blit_rect(px, w, h, 8, 68, w - 120, 5, 0xFF33475Bu32)
    wm_blit_rect(px, w, h, 8, 84, 44, 7, 0xFF33B26Bu32)
    wm_blit_rect(px, w, h, 0, h - 10, w, 10, 0xFFEEF3F9u32)
    px

fn paint_for(key: text, cw: i32, ch: i32, shift: i32) -> [u32]:
    if key == WM_FULL_KEY_2D:
        return paint_scene2d(cw, ch, shift)
    if key == WM_FULL_KEY_WEB:
        return paint_webpage(cw, ch)
    paint_widgets(cw, ch)

# ---------------------------------------------------------------------------
# WM bridge close — in-process, same production path a real app process uses:
# apply_bridge_request(COMP_DESTROY_WINDOW).
# ---------------------------------------------------------------------------

fn bridge_close_window(comp: HostCompositor, seq: i64, owner_port: i64, wid: i64):
    comp.apply_bridge_request(
        seq, owner_port, COMP_DESTROY_WINDOW.to_i64(), wid,
        "", 0, 0, 0, 0, "", 0, ""
    )

fn main() -> i64:
    val w = wm_env_i32("SIMPLE_SHOWCASE_W", WM_DEFAULT_W)
    val h = wm_env_i32("SIMPLE_SHOWCASE_H", WM_DEFAULT_H)
    var frames = wm_env_i32("SIMPLE_SHOWCASE_FRAMES", 3)
    if frames < 1:
        frames = 1
    val want_gui = wm_env_text("SIMPLE_GUI") == "1"
    if w < WM_MIN_W or h < WM_MIN_H:
        print "showcase status=blocked desktop-too-small need={WM_MIN_W}x{WM_MIN_H} got={w}x{h}"
        return 1

    # The WM session itself. Its window opens by default: headless that is
    # the composed desktop surface the captures read back; with SIMPLE_GUI=1
    # it is additionally presented as a physical window below.
    var comp = HostCompositor.new_headless(Size(width: w, height: h))
    var seq: i64 = 0
    var revision: i64 = 0

    # -- 1. admit the three showcase windows on the WM ----------------------
    var opened: [WmAdmitted] = []
    var owner_port: i64 = 100
    for spec in wm_full_specs():
        seq = seq + 1
        owner_port = owner_port + 1
        revision = revision + 1
        # Per-window stage marker: interpreted compositor startup is slow, so
        # without this a slow admit is indistinguishable from a hang.
        print "showcase stage=admit key={spec.key} title={spec.title}"
        val (cw, ch) = wm_content_dims(spec)
        opened.push(wm_admit_window(
            comp, seq, owner_port, spec,
            paint_for(spec.key, cw, ch, 0), revision
        ))
    val web_spec = wm_full_spec_for(WM_FULL_KEY_WEB)
    val web_title = web_spec.title
    var web_window_id: i64 = 0
    var scene_window_id: i64 = 0
    for e in opened:
        if e.key == WM_FULL_KEY_WEB:
            web_window_id = e.window_id
        if e.key == WM_FULL_KEY_2D:
            scene_window_id = e.window_id

    var accepted = 0
    var rejects = ""
    for e in opened:
        if e.frame_accepted:
            accepted = accepted + 1
        else:
            val item = "{e.key}={e.reject_reason}"
            rejects = if rejects == "": item else: rejects + "|" + item

    val base = wm_capture_desktop(comp, opened)
    print "showcase wm_windows declared={wm_full_specs().len()} open={base.open_windows} accepted={accepted} rendered={base.rendered_windows} rejects={rejects}"
    print "showcase wm_taskbar_base entries={base.taskbar_entries} titles={base.taskbar_titles}"

    if base.open_windows != wm_full_specs().len() or accepted != wm_full_specs().len():
        print "showcase status=blocked windows-not-open open={base.open_windows} accepted={accepted} rejects={rejects}"
        return 1
    if base.rendered_windows != wm_full_specs().len():
        print "showcase status=blocked windows-not-rendered rendered={base.rendered_windows} of {wm_full_specs().len()} (content rects did not read back byte-identical)"
        return 1
    if base.taskbar_entries != wm_full_specs().len() or not wm_taskbar_has_title(comp, web_title):
        print "showcase status=blocked taskbar-not-tracking entries={base.taskbar_entries} titles={base.taskbar_titles}"
        return 1

    # -- 2. sabotage arm 1: close the web window ----------------------------
    # The taskbar is a projection of the compositor's live window list, so
    # this must remove the entry, and the window's content must leave the
    # composited frame (checksum must change).
    seq = seq + 1
    print "showcase stage=close key={WM_FULL_KEY_WEB} window_id={web_window_id}"
    bridge_close_window(comp, seq, 103, web_window_id)
    var kept: [WmAdmitted] = []
    for e in opened:
        if e.key != WM_FULL_KEY_WEB:
            kept.push(e)
    val closed = wm_capture_desktop(comp, kept)
    print "showcase wm_taskbar_closed entries={closed.taskbar_entries} titles={closed.taskbar_titles}"

    if closed.taskbar_entries != wm_full_specs().len() - 1:
        print "showcase status=blocked taskbar-entry-survived-close entries={closed.taskbar_entries} titles={closed.taskbar_titles}"
        return 1
    if wm_taskbar_has_title(comp, web_title):
        print "showcase status=blocked closed-window-still-in-taskbar title={web_title}"
        return 1
    if closed.checksum == base.checksum:
        print "showcase status=blocked capture-insensitive-to-close base={base.checksum} closed={closed.checksum}"
        return 1

    # -- 3. restore: re-admit the web window --------------------------------
    seq = seq + 1
    revision = revision + 1
    print "showcase stage=restore key={WM_FULL_KEY_WEB}"
    val (rcw, rch) = wm_content_dims(web_spec)
    val restored_web = wm_admit_window(
        comp, seq, 103, web_spec, paint_for(WM_FULL_KEY_WEB, rcw, rch, 0),
        revision
    )
    if not restored_web.frame_accepted:
        print "showcase status=blocked restore-frame-rejected reason={restored_web.reject_reason}"
        return 1
    web_window_id = restored_web.window_id
    var restored_opened: [WmAdmitted] = kept
    restored_opened.push(restored_web)
    val restored = wm_capture_desktop(comp, restored_opened)
    print "showcase wm_taskbar_restored entries={restored.taskbar_entries} titles={restored.taskbar_titles}"

    if restored.taskbar_entries != wm_full_specs().len() or not wm_taskbar_has_title(comp, web_title):
        print "showcase status=blocked restore-missing-from-taskbar entries={restored.taskbar_entries} titles={restored.taskbar_titles}"
        return 1
    if restored.rendered_windows != wm_full_specs().len():
        print "showcase status=blocked restored-not-rendered rendered={restored.rendered_windows}"
        return 1
    if restored.checksum == closed.checksum:
        print "showcase status=blocked capture-insensitive-to-restore closed={closed.checksum} restored={restored.checksum}"
        return 1

    # -- 4. sabotage arm 2: mutate the 2D scene -----------------------------
    # Re-produce the 2D window's content with its draggable rect moved and
    # hand the compositor the new frame; the capture must change.
    revision = revision + 1
    print "showcase stage=mutate key={WM_FULL_KEY_2D} shift={WM_FULL_MUTATED_SHIFT}"
    val scene_spec = wm_full_spec_for(WM_FULL_KEY_2D)
    val (scw, sch) = wm_content_dims(scene_spec)
    val moved_pixels = paint_for(WM_FULL_KEY_2D, scw, sch, WM_FULL_MUTATED_SHIFT)
    var moved_frame = pixel_surface_content_frame(
        "{scene_window_id}", "", 0, 0, scw, sch, moved_pixels,
        revision, revision
    )
    moved_frame.theme_id = wm_content_theme_id()
    val moved_accepted = comp.set_external_web_frame(scene_window_id, moved_frame)
    var mutated_opened: [WmAdmitted] = []
    for e in restored_opened:
        if e.key == WM_FULL_KEY_2D:
            var moved_entry = e
            moved_entry.pixels = moved_pixels
            mutated_opened.push(moved_entry)
        else:
            mutated_opened.push(e)
    val mutated = wm_capture_desktop(comp, mutated_opened)
    print "showcase wm_capture base_checksum={base.checksum} closed_checksum={closed.checksum} restored_checksum={restored.checksum} mutated_checksum={mutated.checksum} distinct_colors={base.distinct_colors}"

    if not moved_accepted:
        print "showcase status=blocked mutated-frame-rejected"
        return 1
    if mutated.checksum == restored.checksum:
        print "showcase status=blocked capture-insensitive-to-scene restored={restored.checksum} mutated={mutated.checksum}"
        return 1
    if mutated.rendered_windows != wm_full_specs().len():
        print "showcase status=blocked mutated-not-rendered rendered={mutated.rendered_windows}"
        return 1

    # -- 5. taskbar interaction: click the 2D item, focus must move ----------
    # Focus after restore is on the re-admitted web window (newest). Click
    # the 2D window's taskbar item: the entry order is taskbar_model().running
    # order — unfocused windows in window order, focused last — so with focus
    # on the web window (index 2) the 2D window sits at index 1.
    val click_index: i32 = 1
    val click_x = click_index * WM_FULL_TASKBAR_SLOT_W + WM_FULL_TASKBAR_SLOT_W / 2
    val click_y = h - WM_FULL_TASKBAR_H / 2
    val focus_before = host_compositor_focused_window_id(comp)
    comp = host_compositor_left_button_at(comp, true, click_x, click_y)
    comp = host_compositor_left_button_at(comp, false, click_x, click_y)
    val focus_after = host_compositor_focused_window_id(comp)
    print "showcase wm_taskbar_focus before={focus_before} after={focus_after} want={scene_window_id}"
    if focus_after != scene_window_id:
        print "showcase status=blocked taskbar-click-no-focus before={focus_before} after={focus_after} want={scene_window_id}"
        return 1

    # -- artifact: the restored desktop (all windows open) -------------------
    val ppm = wm_capture_path(WM_FULL_ARTIFACT)
    val ppm_written = wm_write_ppm(ppm, restored)
    val prov = wm_provenance_path(ppm)
    val provenance_written = wm_write_provenance(
        prov, restored, wm_full_specs().len(), "restored", want_gui
    )
    if not ppm_written:
        print "showcase status=blocked ppm-write-failed path={ppm}"
        return 1
    if not provenance_written:
        print "showcase status=blocked provenance-write-failed path={prov}"
        return 1

    if want_gui:
        print "showcase stage=gui-present frames={frames}"
        if not wm_gui_present(w, h, "Simple WM — Rendering Showcase", restored.pixels, frames):
            print "showcase status=blocked gui-runtime-unavailable (no display or window backend)"
            return 1
        print "showcase gui_presented=true"

    print "showcase wm_artifact ppm={ppm} ppm_written={ppm_written} provenance={prov} provenance_written={provenance_written}"
    print "showcase status=pass {ppm}"
    0
