# rendering_gui_core.spl — GUI (ScreenGuiHost) rendering showcase, brief tier.
# lane: gui
# tier: brief
# core: examples.ui.rendering_widgets_core (shared core lane pending)
#
# Renders the brief-tier core widget set — panel, text, button, list, menubar,
# statusbar, divider, progress — through the shared widget tree -> DrawIR v2 ->
# DrawIrV3 pipeline. Headless by default: frames are rasterized offscreen with
# the shared scene raster helpers, and when SIMPLE_SHOWCASE_CAPTURE names a PPM
# path the last frame is written there. With SIMPLE_GUI=1 the same scenes are
# presented through a real window via ScreenGuiHost (which reports frames=0
# honestly when no display exists).
#
# Env knobs (shared contract): SIMPLE_SHOWCASE_W/H (default 320x240),
# SIMPLE_SHOWCASE_FRAMES (default 3 headless), SIMPLE_SHOWCASE_CAPTURE (PPM
# output path), SIMPLE_GUI=1 (physical window instead of offscreen raster),
# SIMPLE_2D_BACKEND (cpu|cpu_simd|vulkan|metal, default vulkan) — advisory on
# this lane: the headless capture rasterizes on CPU by design; the configured
# backend applies wherever an Engine2D backend is constructed (windowed path).
#
# The shared core module (examples.ui.rendering_widgets_core) is being built by
# the shared lane; until it lands this entry builds the brief tree directly
# from common.ui.builder — the same widgets, one deterministic column,
# glass_dark theme — and imports nothing that does not exist yet.

use std.io_runtime.{env_get, exit, file_write_bytes, mkdir_p}
use common.ui.builder.{
    column, panel, text_widget, button, list_widget, menubar, divider,
    progress, statusbar, build_tree_with_title, with_height
}
use common.ui.widget_store_ops.{WidgetNode}
use common.ui.widget_draw_ir.{widget_tree_to_draw_ir}
use common.ui.draw_ir.{DRAW_IR_BACKEND_CPU}
use common.ui.draw_ir_v2_to_v3.{draw_ir_v2_to_v3}
use common.ui.draw_ir_v3.{DrawIrV3Scene}
use common.ui.wm_app_process_contract.{widget_showcase_window_title}
use app.ui_showcase.hosts.scene_raster.{
    raster_scene_argb, raster_to_ppm_bytes, raster_distinct_pixel_count
}
use app.ui_showcase.hosts.host_gui.{ScreenGuiHost}

val BRIEF_PREFIX: text = "rgui_brief"
val BRIEF_BAR_H: i32 = 22

fn _env_i32(key: text, fallback: i32) -> i32:
    val raw = env_get(key).trim()
    if raw == "":
        return fallback
    raw.to_int() ?? fallback

fn brief_tree() -> text:
    """Build the brief-tier core widget tree in the global widget store and
    return the root id. One column, deterministic layout, glass_dark theme."""
    val p = BRIEF_PREFIX
    val toolbar = with_height(menubar("{p}_menubar", ["File", "View", "Help"]), BRIEF_BAR_H)
    val body = panel("{p}_panel", "Core Widgets", [
        text_widget("{p}_text", "text: the quick brown fox 0123456789"),
        button("{p}_button", "button: Apply", "apply"),
        list_widget("{p}_list", ["list: alpha", "list: beta", "list: gamma"]),
        divider("{p}_divider"),
        progress("{p}_progress", 65)
    ])
    val status = with_height(statusbar("{p}_status", "ready", "brief tier"), BRIEF_BAR_H)
    val root = column("{p}_root", [toolbar, body, status])
    build_tree_with_title(root, "Rendering GUI (brief)", "glass_dark")
    root.id

fn brief_scene(root_id: text, w: i32, h: i32) -> DrawIrV3Scene:
    """Widget tree -> DrawIR v2 composition -> DrawIrV3 scene value."""
    draw_ir_v2_to_v3(widget_tree_to_draw_ir(WidgetNode(id: root_id), w, h, DRAW_IR_BACKEND_CPU))

fn _parent_dir(path: text) -> text:
    val idx = path.last_index_of("/")
    if idx <= 0:
        return ""
    path.substring(0, idx)

fn _write_capture(path: text, px: [u32], w: i32, h: i32) -> i64:
    """Write one PPM frame; returns the distinct-pixel count (a blank capture
    reports 0/1 here instead of being silently tolerated upstream)."""
    val dir = _parent_dir(path)
    if dir != "":
        mkdir_p(dir)
    file_write_bytes(path, raster_to_ppm_bytes(px, w, h))
    raster_distinct_pixel_count(px, 4)

fn main():
    val w = _env_i32("SIMPLE_SHOWCASE_W", 320)
    val h = _env_i32("SIMPLE_SHOWCASE_H", 240)
    val frames = _env_i32("SIMPLE_SHOWCASE_FRAMES", 3).to_i64()
    val capture = env_get("SIMPLE_SHOWCASE_CAPTURE").trim()
    val want_gui = env_get("SIMPLE_GUI").trim() == "1"

    val root_id = brief_tree()
    var frames_rendered: i64 = 0
    var last_scene = brief_scene(root_id, w, h)

    if want_gui:
        val opened = ScreenGuiHost.open(w, h, widget_showcase_window_title("rendering-gui-core"))
        match opened:
            case None:
                print "showcase status=blocked no-window (missing display or build/sffi/libspl_winit)"
                exit(1)
            case Some(host):
                while frames_rendered < frames:
                    last_scene = brief_scene(root_id, w, h)
                    if not host.present_scene(last_scene):
                        break
                    frames_rendered = frames_rendered + 1
                host.shutdown()
    else:
        # Headless default: every frame is rasterized offscreen through the
        # same DrawIrV3 scene the window host would present.
        while frames_rendered < frames:
            last_scene = brief_scene(root_id, w, h)
            frames_rendered = frames_rendered + 1

    print "showcase host=gui tier=brief frames={frames_rendered} widgets=panel,text,button,list,menubar,statusbar,divider,progress"

    if capture != "":
        val px = raster_scene_argb(last_scene, w, h)
        val distinct = _write_capture(capture, px, w, h)
        print "capture path={capture} distinct_pixels={distinct}"
        if distinct < 2:
            print "showcase status=blocked capture-blank path={capture}"
            exit(1)
        print "showcase status=pass {capture}"
    else:
        print "showcase status=pass headless frames={frames_rendered} (set SIMPLE_SHOWCASE_CAPTURE=<path>.ppm for a PPM artifact)"
