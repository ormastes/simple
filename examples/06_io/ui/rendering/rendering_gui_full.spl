# rendering_gui_full.spl — GUI (ScreenGuiHost) rendering showcase, full tier.
# lane: gui
# tier: full
# core: examples.ui.rendering_widgets_full (shared core lane pending)
#
# Full tier = the complete shared showcase tree (toolbar + linked scroll
# panels + dialogs + event probe + statusbar, via
# app.ui_showcase.showcase_core) PLUS the REQ-011 internal-window desktop
# demo: one `titled` and one `borderless` internal window built with
# simple_gui_internal_window / simple_gui_internal_window_scene and rendered
# through shared_wm_scene_render_to_backend with wm_chrome_theme() into an
# in-memory CompositorBackend, captured as a second PPM.
#
# Headless by default (offscreen raster of every frame); SIMPLE_GUI=1 presents
# the widget scenes through a real window instead. SIMPLE_2D_BACKEND
# (cpu|cpu_simd|vulkan|metal, default vulkan) is advisory here: headless capture
# rasterizes on CPU by design; the configured backend applies wherever an
# Engine2D backend is constructed (windowed path). Env knobs (shared
# contract): SIMPLE_SHOWCASE_W/H (default 320x240), SIMPLE_SHOWCASE_FRAMES
# (default 3), SIMPLE_SHOWCASE_CAPTURE (PPM output path; the desktop render is
# written beside it as <base>.desktop.ppm), SIMPLE_GUI=1.
#
# The shared full core module (examples.ui.rendering_widgets_full, which will
# own rendering_tabs()) is being built by the shared lane; until it lands this
# entry renders the full tree through showcase_core directly and imports
# nothing that does not exist yet.

use std.io_runtime.{env_get, exit, file_write_bytes, mkdir_p}
use common.ui.wm_app_process_contract.{widget_showcase_window_title}
use common.ui.window_scene.{
    SharedWmScene,
    simple_gui_internal_window, simple_gui_internal_window_with_chrome_kind,
    simple_gui_internal_window_scene, WM_CHROME_KIND_BORDERLESS
}
use common.ui.window_scene_draw_ir.{shared_wm_scene_render_to_backend}
use common.ui.wm_chrome_theme.{wm_chrome_theme}
use os.compositor.display_backend.{CompositorBackend, CompositorGlassCapable}
use app.ui_showcase.showcase_core.{showcase_build, showcase_scene}
use app.ui_showcase.hosts.scene_raster.{
    raster_scene_argb, raster_to_ppm_bytes, raster_distinct_pixel_count
}
use app.ui_showcase.hosts.host_gui.{ScreenGuiHost}

val FULL_PREFIX: text = "rgui_full"

fn _env_i32(key: text, fallback: i32) -> i32:
    val raw = env_get(key).trim()
    if raw == "":
        return fallback
    raw.to_int() ?? fallback

# =========================================================================
# Internal-window desktop (REQ-011)
# =========================================================================

# In-memory CompositorBackend draw target for the desktop render. Same shape
# as the executor unit spec's TestPixelBackend: rect/pixel fills are real,
# glyph drawing is a no-op (the chrome/content rectangles and taskbar band are
# what the capture gate measures — >= 2 distinct pixel values, honest nonblank).
class DesktopPixelBackend:
    w: i32
    h: i32
    pixels: [u32]

    static fn create(width: i32, height: i32, fill: u32) -> DesktopPixelBackend:
        var pixels: [u32] = []
        var i = 0
        val total = if width > 0 and height > 0: width * height else: 0
        while i < total:
            pixels.push(fill)
            i = i + 1
        DesktopPixelBackend(w: width, h: height, pixels: pixels)

impl CompositorBackend for DesktopPixelBackend:

    fn width() -> i32:
        self.w

    fn height() -> i32:
        self.h

    me clear(color: u32):
        var i = 0
        while i < self.pixels.len():
            self.pixels[i] = color
            i = i + 1

    me fill_rect(x: i32, y: i32, w: i32, h: i32, color: u32):
        var x0 = if x < 0: 0 else: x
        var y0 = if y < 0: 0 else: y
        var x1 = x + w
        var y1 = y + h
        if x1 > self.w:
            x1 = self.w
        if y1 > self.h:
            y1 = self.h
        if x1 <= x0 or y1 <= y0:
            return
        var yy = y0
        while yy < y1:
            var idx = yy * self.w + x0
            var xx = x0
            while xx < x1:
                self.pixels[idx] = color
                idx = idx + 1
                xx = xx + 1
            yy = yy + 1

    me draw_text(x: i32, y: i32, text_str: text, fg: u32, bg: u32):
        pass_do_nothing

    me draw_char_8x16(x: i32, y: i32, ch: u8, fg: u32, bg: u32):
        pass_do_nothing

    me put_pixel(x: i32, y: i32, color: u32):
        if x < 0 or y < 0 or x >= self.w or y >= self.h:
            return
        val idx = y * self.w + x
        if idx >= 0 and idx < self.pixels.len():
            self.pixels[idx] = color

    me blit_pixels(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        var row = 0
        while row < h:
            var col = 0
            while col < w:
                val src_idx = row * w + col
                if src_idx >= 0 and src_idx < pixels.len():
                    self.put_pixel(x + col, y + row, pixels[src_idx])
                col = col + 1
            row = row + 1

    me present():
        pass_do_nothing

    me present_rect(x: i32, y: i32, w: i32, h: i32):
        pass_do_nothing

    fn as_glass_capable() -> CompositorGlassCapable?:
        nil

fn desktop_scene(w: i32, h: i32) -> SharedWmScene:
    """REQ-011: one titled + one borderless internal window on a wm_chrome_theme
    desktop, projected by simple_gui_internal_window_scene."""
    val win_titled = simple_gui_internal_window(
        "rgui-surf-titled", "rgui-win-titled", 11u64, "app.rendering.showcase",
        "Showcase - Titled", 12, 12, 180, 120, "", false, true, 1)
    val win_borderless = simple_gui_internal_window_with_chrome_kind(
        "rgui-surf-borderless", "rgui-win-borderless", 12u64, "app.rendering.showcase",
        "Showcase - Borderless", 60, 96, 140, 80, "", false, false, 2,
        WM_CHROME_KIND_BORDERLESS)
    simple_gui_internal_window_scene(w, h, "rendering-gui-full", [win_titled, win_borderless])

fn render_desktop(w: i32, h: i32) -> DesktopPixelBackend:
    """Render the internal-window desktop through the shared WM scene executor
    into the in-memory backend. wm_chrome_theme() supplies the desktop clear
    color; the executor re-reads the same theme for chrome/taskbar pixels."""
    val theme = wm_chrome_theme()
    val backend = DesktopPixelBackend.create(w, h, theme.compositor_bg)
    shared_wm_scene_render_to_backend(backend, desktop_scene(w, h), 0)
    backend

# =========================================================================
# Entry
# =========================================================================

fn _parent_dir(path: text) -> text:
    val idx = path.last_index_of("/")
    if idx <= 0:
        return ""
    path.substring(0, idx)

fn _write_ppm(path: text, px: [u32], w: i32, h: i32) -> i64:
    val dir = _parent_dir(path)
    if dir != "":
        mkdir_p(dir)
    file_write_bytes(path, raster_to_ppm_bytes(px, w, h))
    raster_distinct_pixel_count(px, 4)

fn _desktop_capture_path(capture: text) -> text:
    if capture.ends_with(".ppm"):
        val base = capture.substring(0, capture.len() - 4)
        return "{base}.desktop.ppm"
    "{capture}.desktop.ppm"

fn main():
    val w = _env_i32("SIMPLE_SHOWCASE_W", 320)
    val h = _env_i32("SIMPLE_SHOWCASE_H", 240)
    val frames = _env_i32("SIMPLE_SHOWCASE_FRAMES", 3).to_i64()
    val capture = env_get("SIMPLE_SHOWCASE_CAPTURE").trim()
    val want_gui = env_get("SIMPLE_GUI").trim() == "1"

    val st = showcase_build(FULL_PREFIX)
    var frames_rendered: i64 = 0
    var last_scene = showcase_scene(st, w, h)

    if want_gui:
        val opened = ScreenGuiHost.open(w, h, widget_showcase_window_title("rendering-gui-full"))
        match opened:
            case None:
                print "showcase status=blocked no-window (missing display or build/sffi/libspl_winit)"
                exit(1)
            case Some(host):
                while frames_rendered < frames:
                    last_scene = showcase_scene(st, w, h)
                    if not host.present_scene(last_scene):
                        break
                    frames_rendered = frames_rendered + 1
                host.shutdown()
    else:
        # Headless default: rasterize every frame offscreen through the same
        # DrawIrV3 scene the window host would present.
        while frames_rendered < frames:
            last_scene = showcase_scene(st, w, h)
            frames_rendered = frames_rendered + 1

    print "showcase host=gui tier=full frames={frames_rendered} widgets=full-tree desktop=titled+borderless"

    if capture != "":
        val px = raster_scene_argb(last_scene, w, h)
        val distinct = _write_ppm(capture, px, w, h)
        print "capture path={capture} distinct_pixels={distinct}"
        if distinct < 2:
            print "showcase status=blocked capture-blank path={capture}"
            exit(1)
        # REQ-011 evidence: the same internal-window desktop, composited by
        # shared_wm_scene_render_to_backend, captured beside the widget frame.
        val desktop = render_desktop(w, h)
        val desktop_path = _desktop_capture_path(capture)
        val desktop_distinct = _write_ppm(desktop_path, desktop.pixels, w, h)
        print "capture path={desktop_path} distinct_pixels={desktop_distinct} source=shared_wm_scene_render_to_backend"
        if desktop_distinct < 2:
            print "showcase status=blocked desktop-capture-blank path={desktop_path}"
            exit(1)
        print "showcase status=pass {capture}"
    else:
        print "showcase status=pass headless frames={frames_rendered} (set SIMPLE_SHOWCASE_CAPTURE=<path>.ppm for PPM artifacts)"
