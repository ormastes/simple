app:
    title: "Rendering Showcase Items"
    theme: glass_dark

layout:
    type: vbox
    id: root
    children:
        menu:
            type: menubar
            id: menu
            items:
                0:
                    label: "Lanes"
                1:
                    label: "Items"
                2:
                    label: "Switch"
                3:
                    label: "Help"
        intro:
            type: text
            id: intro
            content: "Shared item list - one definition, three presentations: TUI sdn loader, GUI sdn loader, and 'bin/simple ui web' (REQ-001, REQ-004)."
        tui_panel:
            type: panel
            id: tui_panel
            title: "TUI widgets - char-grid renderers [lanes: tui gui web]"
            children:
                tui_list:
                    type: list
                    id: tui_list
                    items:
                        0:
                            label: "panel - lanes: tui gui web"
                        1:
                            label: "text - lanes: tui gui web"
                        2:
                            label: "list - lanes: tui gui web"
                        3:
                            label: "table - lanes: tui gui web"
                        4:
                            label: "progress - lanes: tui gui web"
                        5:
                            label: "menubar - lanes: tui gui web"
                        6:
                            label: "statusbar - lanes: tui gui web"
                        7:
                            label: "input - lanes: tui gui web"
                        8:
                            label: "tabs - lanes: tui gui web"
                        9:
                            label: "button - lanes: tui gui web"
                        10:
                            label: "checkbox - lanes: tui gui web"
                        11:
                            label: "radio - lanes: tui gui web"
                        12:
                            label: "dropdown - lanes: tui gui web"
                        13:
                            label: "textfield - lanes: tui gui web"
                        14:
                            label: "image - lanes: tui gui web"
                        15:
                            label: "divider - lanes: tui gui web"
                        16:
                            label: "dialog - lanes: tui gui web"
                        17:
                            label: "tooltip - lanes: tui gui web"
                        18:
                            label: "scroll - lanes: tui gui web"
                        19:
                            label: "textarea - lanes: tui gui web"
                        20:
                            label: "heading - lanes: tui gui web"
                        21:
                            label: "navigation_bar - lanes: tui gui web"
                        22:
                            label: "tab_bar - lanes: tui gui web"
                        23:
                            label: "card - lanes: tui gui web"
                        24:
                            label: "switch - lanes: tui gui web"
                        25:
                            label: "segmented_control - lanes: tui gui web"
                        26:
                            label: "search_bar - lanes: tui gui web"
                        27:
                            label: "tree - lanes: tui gui web"
                        28:
                            label: "treenode - lanes: tui gui web"
                        29:
                            label: "label - lanes: tui gui web"
        notui_panel:
            type: panel
            id: notui_panel
            title: "WidgetKinds with no TUI renderer (no tui) [lanes: gui wm web]"
            children:
                notui_list:
                    type: list
                    id: notui_list
                    items:
                        0:
                            label: "glass_title_bar (no tui) - lanes: gui wm web"
                        1:
                            label: "sidebar (no tui) - lanes: gui wm web"
                        2:
                            label: "command_bar (no tui) - lanes: gui wm web"
                        3:
                            label: "workspace_tabs (no tui) - lanes: gui wm web"
                        4:
                            label: "command_palette (no tui) - lanes: gui wm web"
                        5:
                            label: "toast (no tui) - lanes: gui wm web"
                        6:
                            label: "sheet_modal (no tui) - lanes: gui wm web"
                        7:
                            label: "context_menu (no tui) - lanes: gui wm web"
                        8:
                            label: "inspector (no tui) - lanes: gui wm web"
                        9:
                            label: "utility_rail (no tui) - lanes: gui wm web"
                        10:
                            label: "status_chip (no tui) - lanes: gui wm web"
                        11:
                            label: "selection_pill (no tui) - lanes: gui wm web"
                        12:
                            label: "empty_state (no tui) - lanes: gui wm web"
        engine2d_panel:
            type: panel
            id: engine2d_panel
            title: "Engine2D API groups [lanes: 2d gui wm]"
            children:
                engine2d_list:
                    type: list
                    id: engine2d_list
                    items:
                        0:
                            label: "primitives - rect/line/circle/ellipse/arc/triangle/polygon/polyline/bezier/rounded - lanes: 2d gui wm"
                        1:
                            label: "gradients - linear (h/stops) + radial - lanes: 2d gui wm"
                        2:
                            label: "text+fonts - bitmap 5x7/8x16 fallback vs vector corpus, shaped text word spacing - lanes: 2d gui wm"
                        3:
                            label: "images - draw_image* + web fixture rendering_fixture.png - lanes: 2d gui wm web"
                        4:
                            label: "compositing - nested draw_engine, masks/clips, blend modes, offscreen read_pixels - lanes: 2d gui wm"
        web_panel:
            type: panel
            id: web_panel
            title: "Web features [lane: web]"
            children:
                web_list:
                    type: list
                    id: web_list
                    items:
                        0:
                            label: "multi-line text - block + inline + styled spans - lane: web"
                        1:
                            label: "image - <img> from generated fixture - lane: web"
                        2:
                            label: "scrollbar - scrollable region exercises UA scrollbar - lane: web"
                        3:
                            label: "forms-media - forms and media elements - lane: web"
                        4:
                            label: "animation - animated page regions - lane: web"
                        5:
                            label: "aqua themes - aqua_light/aqua_dark + glass/ios theme gallery - lane: web"
        wm_panel:
            type: panel
            id: wm_panel
            title: "WM items [lanes: wm gui]"
            children:
                wm_list:
                    type: list
                    id: wm_list
                    items:
                        0:
                            label: "internal windows - titled + borderless (simple_gui_internal_window) - lanes: wm gui"
                        1:
                            label: "taskbar - tracks windows admitted through the WM bridge - lanes: wm gui"
                        2:
                            label: "chrome kinds - wm_chrome_theme window chrome - lanes: wm gui"
        status:
            type: statusbar
            id: status
            left: "ITEMS"
            right: "rendering_items.ui.sdn"
