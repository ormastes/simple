# ARM32 OS Entry — Minimal SimpleOS boot for ARMv7 QEMU virt
#
# Proves the arm32 arch layer boots: disables interrupts, inits console,
# prints boot banner, parses boot info, then halts.
#
# Binds the arm32 arch modules directly: os.kernel.arch.hal is x86_64-only
# (all bodies @cfg(x86_64), unconditional hal_current -> x86_64/acpi imports),
# so importing it dragged x86_64 timer + ACPI into the arm32 entry closure.
#
# Serial markers consumed by test/qemu/os/boot/arm32_boot_qemu_spec.spl:
#   SimpleOS arm32 starting...   — entry reached, console live
#   [arm32] boot-info:ok          — boot info parsed
#   [arm32] halt                  — entering halt loop

use os.kernel.arch.arm32.console.{uart_init, uart_writeln}
use os.kernel.arch.arm32.cpu.{cpsid_if, wfi}
use os.kernel.arch.arm32.boot.{Arm32Boot}
use os.kernel.arch.arm32.runtime_array_shims.{}
use os.kernel.arch.arm32.hw_shims.{}
use os.kernel.arch.arm32.runtime_value_shims.{}

fn spl_start():
    cpsid_if()
    uart_init()
    uart_writeln("SimpleOS arm32 starting...")

    val _boot_info = Arm32Boot.build_boot_output()
    uart_writeln("[arm32] boot-info:ok")

    uart_writeln("[arm32] halt")
    cpsid_if()
    while true:
        wfi()
