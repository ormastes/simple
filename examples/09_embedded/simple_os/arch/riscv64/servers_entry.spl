# RV64 filesystem-launched HTTP/database server acceptance entry.

extern fn serial_println(msg: text)
extern fn rt_qemu_exit_success()
extern fn rt_qemu_exit_failure()
extern fn rt_riscv_nvfs_probe() -> i64

use os.services.vfs.vfs_boot_init.{vfs_boot_init_riscv64_virtio_fat32, g_mount_table}
use os.kernel.loader.riscv64_authenticated_media_fixture.{riscv64_authenticated_media_execute_server_v1}
use os.kernel.loader.boot_service_context_v1.{boot_service_context_publish_v1}
use os.kernel.loader.spawn_recipes.{
    SPAWN_RECIPE_AUTH_MEDIA_SERVER, spawn_recipe_seed_parent_caps
}
use os.kernel.loader.authenticated_fs_exec_submission_service_v1.{authenticated_fs_exec_user_install_canonical_vfs_owner_v1}
use os.kernel.scheduler.scheduler_types.{Scheduler}
use os.kernel.ipc.ipc.{IpcManager}

fn reject(reason: text):
    serial_println("[riscv64-servers] " + reason)
    serial_println("TEST FAILED")
    rt_qemu_exit_failure()

fn spl_start():
    # DBD is reachable only inside /SERVERS.ELF after its current TCB consumes
    # ABI 116; this kernel entry must never bind or advertise DBD directly.
    serial_println("=== SimpleOS RV64 filesystem servers boot ===")
    if rt_riscv_nvfs_probe() != 1 or not vfs_boot_init_riscv64_virtio_fat32():
        reject("filesystem mount=fail")
        return
    if not authenticated_fs_exec_user_install_canonical_vfs_owner_v1():
        reject("filesystem-exec VFS owner install=fail")
        return
    serial_println("[riscv64-servers] executable read=ok path=/SERVERS.ELF")
    var boot_scheduler = Scheduler.new()
    var boot_ipc = IpcManager.new()
    val boot_task = boot_service_context_publish_v1(
        boot_scheduler, boot_ipc,
        spawn_recipe_seed_parent_caps(SPAWN_RECIPE_AUTH_MEDIA_SERVER, 1u64))
    if not boot_task.?:
        reject("boot service context=fail")
        return
    serial_println("[riscv64-servers] boot service context=ok task={boot_task.unwrap().id}")
    val rc = riscv64_authenticated_media_execute_server_v1(
        boot_scheduler, g_mount_table)
    if rc != 0:
        reject("filesystem launch=fail rc={rc}")
        return
    serial_println("[riscv64-servers] executable=/SERVERS.ELF exit=0")
    serial_println("TEST PASSED")
    rt_qemu_exit_success()
