# RISC-V 64 fs-exec hello entry (rebuilt minimal 2026-11-21 after the lane worktree loss).
#
# Mounts the virtio FAT32 boot volume, then runs the authenticated-media
# acceptance: open the signed hello ELF through the VFS, admit it, and enter
# U-mode. Reached from crt0.S -> boot_entry in S-mode after OpenSBI handover.
# Gate: scripts/check/check-simpleos-riscv64-user-elf-opensbi.shs

use os.services.vfs.vfs_boot_init.{vfs_boot_init_riscv64_virtio_fat32, g_mount_table}
use os.kernel.loader.riscv64_authenticated_media_fixture.{riscv64_authenticated_media_acceptance_v1}
use os.kernel.scheduler.scheduler_types.{Scheduler}
use os.kernel.net.thread_shim.{}
use os.kernel.arch.riscv64.user_memory.{}
use os.kernel.arch.riscv64.runtime_shims.{}

extern fn serial_println(msg: text)

fn spl_start():
    serial_println("[fsexec] SimpleOS riscv64 fs-exec hello (OpenSBI)")
    if not vfs_boot_init_riscv64_virtio_fat32():
        serial_println("[fsexec] FAIL virtio FAT32 mount")
        return
    if not g_mount_table.?:
        serial_println("[fsexec] FAIL no mount table")
        return
    if riscv64_authenticated_media_acceptance_v1(Scheduler.new_bootstrap(), g_mount_table.unwrap()):
        serial_println("[fsexec] PASS authenticated hello exited")
    else:
        serial_println("[fsexec] FAIL authenticated hello")
