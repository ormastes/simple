# SimpleOS riscv64 in-guest BUILD-AND-RUN sanity entry (OpenSBI lane).
#
# GOAL ROW 2: "build-and-run sanity — compile-and-run in-guest". This file
# closes that row within the scope stated below.
#
# Boot chain and forbidden-flag policy identical to interpreter_hello_entry.spl:
# real OpenSBI v1.4 fw_payload via `-bios` ONLY, NEVER `-kernel`, NEVER
# isa-debug-exit. COMPILER: the RUST SEED.
#
# WHAT "BUILD AND RUN" MEANS HERE, AND WHAT IT DOES NOT
# -----------------------------------------------------
# Sibling of the interpreter row, and deliberately a DIFFERENT pipeline: where
# interpreter_hello_entry.spl stops at HIR and evaluates, this row drives the
# COMPILE half that `simpleos_compile_native_file` drives on a hosted build —
# the frontend AND the MIR lowering — and only then runs the program:
#
#     source text -> preprocess -> parse -> desugar -> HIR lowering   (frontend)
#                 -> MirLowering.lower_module                          (BUILD)
#                 -> InterpreterBackendImpl.interpret_hir_module       (RUN)
#
# What is NOT claimed: no LLVM codegen, no object emission, no in-guest link.
# `simpleos_compile_native_file` pins CodegenTarget.SimpleOS_X86_64 and its
# link step is `link_simpleos_x86_64_external` — an x86_64 path that a
# freestanding riscv64 S-mode image has no linker, no filesystem and no process
# model to drive. Emitting a native object in-guest on riscv64 is a separate and
# much larger artifact; this row does not pretend to be it. What IS proven is
# that the real MIR lowering runs in-guest over real source and produces real
# functions, and that the program then actually executes and prints its own
# result.
#
# WHY THE PROGRAM COMPUTES RATHER THAN JUST GREETING
# --------------------------------------------------
# The interpreted program here does arithmetic whose result the gate checks
# against an independently known answer, and prints the nonce only on the
# success path. A run that lowered nothing, or that "ran" a stubbed program,
# cannot produce the expected sum, so this row fails rather than passing when
# the pipeline degrades. That is the same two-directions-of-evidence discipline
# the devtool component row uses (clean snippet silent AND dirty snippet flagged).
#
# NONCE ANCHORING: identical to the interpreter row — the marker carries a nonce
# generated outside the guest per run and embedded in the interpreted source, so
# a stale image or a replayed transcript cannot satisfy the gate.
#
# HONEST SCOPE: runs in S-mode (kernel mode) linked into the guest image, not as
# a U-mode process. See interpreter_hello_entry.spl's header for why the U-mode
# path is not used (rt_riscv_fs_exec_run fails closed by design, returning -13).
#
# NEVER interpolate an integer into text in THIS file — that emits
# rt_raw_i64_to_string, which the freestanding riscv64 runtime does not provide,
# and the link dies.

use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
# ROW2 PROBE (temporary): discriminate candidate (a) vs (b) of the top-level
# declaration walk defect (bug riscv64_freestanding_toplevel_decl_walk_names_
# both_functions_add_2026-09-01.md). RAW values only, never comparisons.
use compiler.core.ast.{module_decl_at, module_decl_count_get, decl_get_name, int_to_str, ast_parse_i64, ast_module_decl_slots_len, ast_module_decl_slot_get, ast_decl_prefer_arena}
@unsafe(reason: "probe reads the process environment directly", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text

@unsafe(reason: "probe reads the process environment directly", capabilities: [ffi])
extern fn rt_env_get_i64(key: text, default_value: i64) -> i64

use compiler.frontend.desugar.desugar_async.{desugar_module}
use compiler.frontend.desugar.collection_desugar.{desugar_collections_static}
use compiler.core.parser_preprocessor.{_pp_preprocess_conditionals}
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.backend.backend.interpreter.{InterpreterBackendImpl}
use build.os.generated.rv64_interp_nonce.{rv64_interp_nonce}

@unsafe(reason: "foreign serial output provider is not artifact-verified", capabilities: [ffi])
extern fn serial_println(msg: text)

fn buildrun_source() -> text:
    """The Simple PROGRAM this row builds and then runs.

    It adds 40 + 2 and prints the nonce only when the sum is 42, so a degraded
    pipeline that produced no real code cannot reach the success marker.
    """
    "fn add(a: i64, b: i64) -> i64:\n" +
        "    a + b\n" +
        "\n" +
        "fn main():\n" +
        "    val total = add(40, 2)\n" +
        "    if total == 42:\n" +
        "        print \"BUILDRUN_SIMPLEOS_RISCV64_OK sum=42 nonce=" + rv64_interp_nonce() + "\"\n" +
        "    else:\n" +
        "        print \"BUILDRUN_SIMPLEOS_RISCV64_BAD_SUM\"\n"


# ROW2 PROBE3 (temporary): module_decl_at answers 0 for index 1 while
# ast_module_decl_slot_get(1) answers 1 -- measured in the same boot, with the
# env mirror EMPTY so the env branch is not even taken. These four local
# replicas of module_state.spl:433-443 isolate WHICH construct in that body
# loses the answer. RAW values only.

fn probe_decl_at_v1(index: i64) -> i64:
    """Verbatim copy of module_decl_at. Must reproduce (expect 0 for index 1)."""
    if index < 0 or index >= module_decl_count_get():
        return -1
    if rt_env_get_i64("SIMPLE_NATIVE_ARENA_DECLS", 0) == 1:
        if index >= ast_module_decl_slots_len():
            return -1
        return ast_module_decl_slot_get(index)
    val env_value = rt_env_get("SIMPLE_BOOTSTRAP_MODULE_DECL_" + int_to_str(index)) ?? ""
    if env_value != "":
        return ast_parse_i64(env_value)
    ast_module_decl_slot_get(index)

fn probe_decl_at_v2(index: i64) -> i64:
    """v1 with an EXPLICIT return on the tail. Discriminates implicit-return."""
    if index < 0 or index >= module_decl_count_get():
        return -1
    if rt_env_get_i64("SIMPLE_NATIVE_ARENA_DECLS", 0) == 1:
        if index >= ast_module_decl_slots_len():
            return -1
        return ast_module_decl_slot_get(index)
    val env_value = rt_env_get("SIMPLE_BOOTSTRAP_MODULE_DECL_" + int_to_str(index)) ?? ""
    if env_value != "":
        return ast_parse_i64(env_value)
    return ast_module_decl_slot_get(index)

fn probe_decl_at_v3(index: i64) -> i64:
    """v1 but the index is snapshotted BEFORE the env work. Discriminates a
    parameter clobbered by the `??` / string-concat / extern-call sequence."""
    val kept: i64 = index
    if kept < 0 or kept >= module_decl_count_get():
        return -1
    if rt_env_get_i64("SIMPLE_NATIVE_ARENA_DECLS", 0) == 1:
        if kept >= ast_module_decl_slots_len():
            return -1
        return ast_module_decl_slot_get(kept)
    val env_value = rt_env_get("SIMPLE_BOOTSTRAP_MODULE_DECL_" + int_to_str(kept)) ?? ""
    if env_value != "":
        return ast_parse_i64(env_value)
    return ast_module_decl_slot_get(kept)

fn probe_decl_at_v4(index: i64) -> i64:
    """v1 with the env lookup REMOVED entirely. Discriminates the env
    expression itself (the `??` on a non-optional extern text result)."""
    if index < 0 or index >= module_decl_count_get():
        return -1
    return ast_module_decl_slot_get(index)

fn buildrun_sanity_row() -> i64:
    """Build (frontend + MIR) then run the program, in-guest."""
    val path = "src/os/rv64_buildrun_sanity.spl"
    val source = buildrun_source()

    serial_println("[buildrun] lowering source through the real frontend")
    var parsed = parse_and_build_module(_pp_preprocess_conditionals(source), path)
    serial_println("[probe] decl-count=" + module_decl_count_get().to_string())
    serial_println("[probe] slots-len=" + ast_module_decl_slots_len().to_string())
    serial_println("[probe] slot0=" + ast_module_decl_slot_get(0).to_string())
    serial_println("[probe] slot1=" + ast_module_decl_slot_get(1).to_string())
    serial_println("[probe] declat0=" + module_decl_at(0).to_string())
    serial_println("[probe] declat1=" + module_decl_at(1).to_string())
    serial_println("[probe] name0=[" + decl_get_name(module_decl_at(0)) + "]")
    serial_println("[probe] name1=[" + decl_get_name(module_decl_at(1)) + "]")
    serial_println("[probe] prefer-arena=" + ast_decl_prefer_arena().to_string())
    serial_println("[probe2] itos0=[" + int_to_str(0) + "]")
    serial_println("[probe2] itos1=[" + int_to_str(1) + "]")
    serial_println("[probe2] key1=[" + "SIMPLE_BOOTSTRAP_MODULE_DECL_" + int_to_str(1) + "]")
    serial_println("[probe2] env0=[" + (rt_env_get("SIMPLE_BOOTSTRAP_MODULE_DECL_" + int_to_str(0)) ?? "<NIL>") + "]")
    serial_println("[probe2] env1=[" + (rt_env_get("SIMPLE_BOOTSTRAP_MODULE_DECL_" + int_to_str(1)) ?? "<NIL>") + "]")
    serial_println("[probe2] envlit1=[" + (rt_env_get("SIMPLE_BOOTSTRAP_MODULE_DECL_1") ?? "<NIL>") + "]")
    serial_println("[probe2] bootstrap=[" + (rt_env_get("SIMPLE_BOOTSTRAP") ?? "<NIL>") + "]")
    serial_println("[probe2] arena=[" + (rt_env_get("SIMPLE_NATIVE_ARENA_DECLS") ?? "<NIL>") + "]")
    serial_println("[probe2] parse-of-1=" + ast_parse_i64("1").to_string())
    serial_println("[probe3] v1-0=" + probe_decl_at_v1(0).to_string() + " v1-1=" + probe_decl_at_v1(1).to_string())
    serial_println("[probe3] v2-0=" + probe_decl_at_v2(0).to_string() + " v2-1=" + probe_decl_at_v2(1).to_string())
    serial_println("[probe3] v3-0=" + probe_decl_at_v3(0).to_string() + " v3-1=" + probe_decl_at_v3(1).to_string())
    serial_println("[probe3] v4-0=" + probe_decl_at_v4(0).to_string() + " v4-1=" + probe_decl_at_v4(1).to_string())
    serial_println("[probe] parsed-fns=" + parsed.functions.len().to_string())
    serial_println("[probe] order-len=" + parsed.function_order.len().to_string())
    for pname in parsed.function_order:
        serial_println("[probe] parsed-fn-order=[" + pname + "]")
    parsed = desugar_module(parsed)
    desugar_collections_static(0, 0)

    var lowering: HirLowering = HirLowering.with_filename(path)
    val hir: HirModule = lowering.lower_module(parsed)
    if lowering.errors.len() > 0:
        serial_println("[buildrun] FAIL hir lowering error: " + lowering.errors[0].message)
        return 1
    serial_println("[buildrun] phase=hir-ok")

    # --- the BUILD half: real MIR lowering, in-guest -------------------------
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    if mir_lowering.errors.len() > 0:
        serial_println("[buildrun] FAIL mir lowering error: " + mir_lowering.errors[0].message)
        return 1
    if mir.functions.len() == 0:
        serial_println("[buildrun] FAIL mir module produced no functions — the build was vacuous")
        return 1
    serial_println("[buildrun] phase=mir-ok functions lowered")

    # --- the RUN half: the program actually executes -------------------------
    serial_println("[buildrun] running the built program")
    val ran = InterpreterBackendImpl.new().interpret_hir_module(hir)
    match ran:
        case Ok(_):
            serial_println("[buildrun] program returned Ok")
            0
        case Err(error):
            serial_println("[buildrun] FAIL run error: " + error.message)
            1

fn spl_start():
    """riscv64 in-guest build-and-run sanity entry, reached from crt0.S ->
    boot_entry in S-mode after OpenSBI's firmware-performed handover."""
    serial_println("")
    serial_println("[buildrun] SimpleOS riscv64 in-guest build-and-run sanity (OpenSBI fw_payload)")
    serial_println("[buildrun] serial up, building then running a Simple program")
    val rc = buildrun_sanity_row()
    if rc == 0:
        serial_println("[buildrun] build-and-run row exited rc=0")
    else:
        serial_println("[buildrun] build-and-run row exited rc=nonzero")
    serial_println("[buildrun] parking")
