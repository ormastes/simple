# SimpleOS riscv64 in-guest TEST RUNNER component sanity entry (OpenSBI lane).
#
# Sibling of caret_component_entry.spl; see that file's header for why the four
# components are probed as SEPARATE kernels rather than one.
#
# Boot chain and forbidden-flag policy identical to hello_world_sbi_entry.spl:
# real OpenSBI v1.4 fw_payload via -bios only, NEVER -kernel, NEVER
# isa-debug-exit. COMPILER: the RUST SEED.
#
# WHAT THIS PROVES: the REAL test-runner output parser
# (std.nogc_sync_mut.test_runner.test_executor_parsing.parse_test_output) runs
# inside the guest over a real spec-run transcript and reports the counts.
#
# HONEST SCOPE: the guest does NOT fork a child `simple test` process — a
# freestanding S-mode image has no process model. What runs in-guest is the
# runner's result-evaluation core, which is the part that decides pass/fail,
# over a transcript this file supplies. That is a real round-trip through
# unmodified product code within a stated limit, not a banner.
#
# NEVER interpolate an integer into text — that emits rt_raw_i64_to_string,
# which the freestanding riscv64 runtime does not provide, and the link dies.
# The counts are therefore reported by WHICH literal is printed, which also
# keeps the gate's rung exact.

use std.nogc_sync_mut.test_runner.test_executor_parsing.{parse_test_output}

@unsafe(reason: "foreign serial output provider is not artifact-verified", capabilities: [ffi])
extern fn serial_println(msg: text)

fn testrunner_component_row() -> i64:
    """Feed a real spec transcript to the REAL test-runner output parser."""
    val transcript =
        "running 3 tests\n" +
        "test arithmetic adds ... ok\n" +
        "test arithmetic subtracts ... ok\n" +
        "test arithmetic divides by zero ... FAILED\n" +
        "\n" +
        "test result: FAILED. 2 passed; 1 failed; 0 ignored\n"
    serial_println("[testrun] feeding a 3-example spec transcript to the real parser")
    val counts = parse_test_output(transcript)
    val passed = counts.0
    val failed = counts.1

    var rc = 0
    if passed == 2:
        serial_println("[testrun] parser reported passed=2")
    else:
        serial_println("[testrun] FAIL parser did not report passed=2")
        rc = 1
    if failed == 1:
        serial_println("[testrun] parser reported failed=1")
    else:
        serial_println("[testrun] FAIL parser did not report failed=1")
        rc = 1
    if rc == 0:
        serial_println("COMPONENT_TESTRUN_SIMPLEOS_RISCV64_OK real runner parser summarised the spec as 2 passed / 1 failed")
    rc

fn spl_start():
    """riscv64 in-guest test-runner sanity entry, reached from crt0.S ->
    boot_entry in S-mode after OpenSBI's firmware-performed handover."""
    serial_println("")
    serial_println("[components] SimpleOS riscv64 in-guest toolchain components (OpenSBI fw_payload)")
    serial_println("[components] serial up, exercising real product modules")
    val rc = testrunner_component_row()
    if rc == 0:
        serial_println("[components] all component rows exited rc=0")
    else:
        serial_println("[components] at least one component row exited rc=nonzero")
    serial_println("[components] parking")
