# RISC-V64 OS Entry — Full-stack SimpleOS boot (bare-metal QEMU virt)

extern fn serial_println(msg: text)

# Direct POSIX init (bypass mod.spl to avoid weak-stub cascade)
use os.posix.fd_table.{fd_table_init}
use os.posix.async_io.{async_io_init}
use os.posix.signal_compat.{signal_init}

# Byte-order/VirtIO identity ABI (rt_get_le32/rt_put_le32/rt_put_le64/rt_pci_is_virtio_*).
use os.kernel.arch.riscv64.freestanding_policy.{}
# Soft-float i64<->f64 libcalls (__floatdidf/__fixdfdi) and PMM page ABI.
use os.kernel.arch.riscv64.soft_float_conv.{}
use os.kernel.arch.riscv64.noalloc_pmm_runtime.{}

# Services
use os.kernel.boot.riscv_services.{init_riscv_services}

# Shell
use os.apps.shell.shell_boot.{shell_boot_init}

fn spl_start():
    serial_println("")
    serial_println("=== SimpleOS Boot ===")
    serial_println("")

    # POSIX layer init
    fd_table_init()
    async_io_init()
    signal_init()
    serial_println("[boot] POSIX layer initialized")

    # Services
    init_riscv_services()

    # Shell
    val shell = shell_boot_init()
    serial_println("[boot] Shell ready")

    serial_println("")
    serial_println("=== SimpleOS ready ===")
    serial_println("TEST PASSED")
