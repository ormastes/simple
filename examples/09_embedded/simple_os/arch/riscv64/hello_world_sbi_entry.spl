# SimpleOS riscv64 hello-world in-guest execution entry (OpenSBI real-firmware lane).
#
# Boot chain: OpenSBI v1.4 built as `fw_payload` with this kernel Image embedded,
# handed to QEMU as `-bios` ONLY. NEVER QEMU `-kernel`, NEVER isa-debug-exit —
# fw_dynamic's next-stage address is populated by QEMU's `-kernel` machinery,
# which is exactly the banned pass semantics, whereas fw_payload is a real
# board-shipping configuration (it is how OpenSBI ships on flash on JH7110-class
# boards): the FIRMWARE, not QEMU, performs the S-mode handover to 0x80200000.
# See scripts/check/check-simpleos-riscv64-opensbi-guest-boot.shs for the full
# rationale, which this lane reuses verbatim.
#
# What it proves: a hello-world program WRITTEN IN SIMPLE and compiled to a
# freestanding riscv64 image by the RUST SEED (the pure-Simple self-hosted
# compiler cannot compile anything yet) runs inside the guest under real
# firmware and prints ITS OWN output to the 16550 console.
#
# HONEST SCOPE — same as the aarch64 sibling: the program runs in S-mode
# (kernel mode), not as a U-mode task loaded off the guest's own filesystem.
# riscv64 does have a `_rv64_enter_user` path (see arch/riscv64/entry.spl), but
# reaching it requires the full scheduler + ELF-loader closure, which is a
# separate, much larger artifact than a hello world. What IS proven here is:
# real firmware -> firmware-performed S-mode handover -> Simple-compiled guest
# code executing and emitting its own marker.
#
# Conventions this file satisfies:
#   * Entry symbol is `spl_start` — boot/crt0.S's `_start` sets gp/sp, zeroes
#     .bss, preserves the firmware handover registers (a0=hartid, a1=dtb) and
#     calls `boot_entry`, which reaches `spl_start`. This mirrors
#     arch/riscv64/smoke_entry.spl exactly; it is NOT the aarch64 convention,
#     where the entry file must define a literal `_start`.
#   * Living in examples/09_embedded/simple_os/arch/riscv64/ is load-bearing:
#     boot-object autodiscovery keys off the --entry file's own directory and
#     picks up the sibling boot/ sources (crt0.S + the freestanding runtime that
#     provides serial_println).
#   * No module-level `val` initializers; constants stay function-local.

@unsafe(reason: "foreign serial output provider is not artifact-verified", capabilities: [ffi])
extern fn serial_println(msg: text)

fn hello_world_program() -> i64:
    """The hello-world program itself.

    Kept as a separate function from the boot glue so its output is attributable
    to the PROGRAM and not to a boot stage: every line it emits carries the
    HELLO_ marker, and the gate's must-FAIL fixture is a serial capture with
    exactly those lines stripped out.
    """
    serial_println("HELLO_NATIVE_SIMPLEOS_RISCV64_OK hello world from Simple")
    serial_println("HELLO_NATIVE_SIMPLEOS_RISCV64 second line proves the program kept running")
    0

fn spl_start():
    """riscv64 hello-world entry, reached from crt0.S -> boot_entry in S-mode
    after OpenSBI's firmware-performed handover."""
    serial_println("")
    serial_println("[hello] SimpleOS riscv64 hello-world in-guest (OpenSBI fw_payload)")
    serial_println("[hello] serial up, invoking the Simple hello-world program")
    val rc = hello_world_program()
    # Deliberately NOT "rc={rc}": text interpolation of an integer emits a call
    # to rt_raw_i64_to_string, which the riscv64 freestanding runtime does not
    # provide (`ld.lld: error: undefined symbol: rt_raw_i64_to_string`). The
    # success/failure distinction is carried by which literal is printed, so the
    # gate's rung stays exact and the must-FAIL non-zero-exit fixture still
    # discriminates.
    if rc == 0:
        serial_println("[hello] native program exited rc=0")
    else:
        serial_println("[hello] native program exited rc=nonzero")
    serial_println("[hello] parking")
