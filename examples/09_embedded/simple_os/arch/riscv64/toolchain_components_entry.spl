# SimpleOS riscv64 in-guest TOOLCHAIN COMPONENT sanity entry (OpenSBI real-firmware lane).
#
# Boot chain: OpenSBI v1.4 built as `fw_payload` with this kernel Image embedded,
# handed to QEMU as `-bios` ONLY. NEVER QEMU `-kernel`, NEVER isa-debug-exit.
# Identical firmware construction to hello_world_sbi_entry.spl, which this file
# is a direct descendant of — see that file's header for the full rationale.
#
# WHAT THIS PROVES, and what it deliberately does NOT.
#
# Four product components are exercised INSIDE the guest. Every row calls a
# function defined in real product source (named in its comment); NONE of the
# component logic is reimplemented in this file. This file only supplies the
# input literal, calls the product function, and prints what came back. That
# distinction is the whole point: a banner is not sanity, and a round-trip
# answered by string concatenation written here would be exactly the vacuous
# green this lane exists to rule out.
#
#   MCP        lib.nogc_async_mut.mcp.dispatch.dispatch_wrap — the real MCP
#              explicit-registration tool dispatcher. A registry is built, the
#              real `echo` DispatchEntry is registered, and a request is
#              dispatched with an authority token. The response ENVELOPE the
#              dispatcher returns is printed. A second dispatch of an
#              unregistered name must come back as an error envelope, so the
#              row discriminates instead of always saying yes.
#              HONEST SCOPE: this is the tool-dispatch half of the MCP server,
#              not a stdio JSON-RPC server loop. The freestanding riscv64
#              runtime has no stdin, so a real transport loop is not reachable
#              here; what is proven is that a request names a tool, real
#              privilege + output-gate code runs, and a real response envelope
#              comes back.
#
#   DEVTOOL    compiler.tools.lint _LintMain.os_freestanding_lints.
#              lint_os_freestanding_patterns — a REAL lint rule from the real
#              linter, run over a source snippet. The clean snippet must yield
#              zero warnings and the dirty snippet at least one, so a rule that
#              silently degraded to "always clean" fails this row.
#
#   CARET      app.llm_caret.redact.redact plus
#              app.llm_caret.json_helpers.extract_json_string — a caret message
#              is built as JSON by the real helpers, a field is extracted back
#              out by the real parser, and the real redactor is run over a
#              string carrying a secret. The secret must NOT survive and the
#              non-secret text MUST survive.
#
#   TESTRUN    app.test_runner_new.test_executor_parsing.parse_test_output —
#              the real test-runner output parser. A spec-run transcript is fed
#              in and the real parser's (passed, failed, skipped, total) tuple
#              is printed.
#              HONEST SCOPE: the guest does not fork a child `simple test`
#              process — there is no process model in a freestanding S-mode
#              image. What runs in-guest is the runner's result-evaluation
#              core over a real transcript, which is the part that decides
#              pass/fail.
#
# Conventions inherited from hello_world_sbi_entry.spl and load-bearing here:
#   * Entry symbol is `spl_start`; boot/crt0.S -> boot_entry reaches it.
#   * Living in this directory is required for boot-object autodiscovery to
#     pick up the sibling boot/ sources that provide serial_println.
#   * No module-level `val` initializers; constants stay function-local.
#   * NEVER interpolate an integer into text ("n={n}") — that emits a call to
#     rt_raw_i64_to_string, which the riscv64 freestanding runtime does not
#     provide, and the link dies with an undefined symbol. Integer outcomes are
#     carried by WHICH literal is printed.

use lib.nogc_async_mut.mcp.dispatch.{DispatchEntry, DispatchRegistry, dispatch_wrap}
use std.common.privilege.id_path.{id_path_intern}
use std.common.privilege.authority_token.{AuthorityToken, AuthorityLevel}
use std.common.privilege.principal.{Principal, PrincipalKind}
use compiler.tools.lint._LintMain.os_freestanding_lints.{lint_os_freestanding_patterns}
use app.llm_caret.redact.{redact}
use app.llm_caret.json_helpers.{jo2, jp, js, extract_json_string}
use std.nogc_sync_mut.test_runner.test_executor_parsing.{parse_test_output}

@unsafe(reason: "foreign serial output provider is not artifact-verified", capabilities: [ffi])
extern fn serial_println(msg: text)

# ---------------------------------------------------------------------------
# Row 1 — MCP tool dispatch
# ---------------------------------------------------------------------------

fn mcp_component_row() -> i64:
    """Dispatch a tool through the REAL MCP dispatcher and print its envelope.

    Returns 0 when the registered tool produced an envelope carrying the echoed
    argument AND the unregistered name produced an error envelope; non-zero
    otherwise. Both halves are required so the row cannot pass by always
    answering the same way.
    """
    # `dispatch_wrap` checks id_path_prefix_match(token.id_path, entry.required),
    # i.e. the ENTRY's required path must sit under the TOKEN's path. The token
    # minted by AuthorityToken.root_for(p) carries "id." + p.id, so the entry's
    # requirement is registered one segment below it.
    # BISECT PROBES (2026-08-31): the mcp row traps before any [mcp] line
    # reaches serial, so the trap site is one of the five constructor calls
    # below. Each is fenced by a marker so the serial log names the last call
    # that completed. These are diagnostics only — they add no rung and gate no
    # verdict; the gate still requires the response-content rungs below.
    serial_println("[mcp] probe m0 entering row")
    val required = id_path_intern("id.mcp.echo")
    serial_println("[mcp] probe m1 id_path_intern ok")
    val entry = DispatchEntry.echo(required, AuthorityLevel.Write)
    serial_println("[mcp] probe m2 DispatchEntry.echo ok")
    var reg = DispatchRegistry.new_for_test()
    serial_println("[mcp] probe m3 DispatchRegistry.new_for_test ok")
    # `DispatchRegistry.register` is `self.entries = self.entries + [entry]`, an
    # ARRAY CONCATENATION on a struct field. Probe the same shape on a plain
    # local first so the serial log distinguishes "array + array traps" from
    # "assigning the result back into a struct field traps".
    var probe_a = ["a"]
    val probe_b = probe_a + ["b"]
    serial_println("[mcp] probe m3a local array concat returned")
    for q in probe_b:
        serial_println("[mcp] probe m3b elem=" + q)
    # Text-array concat (m3a/m3b) already proved fine, so narrow further:
    # is it the CLASS element type, the concat, or the store back into the
    # `self` field inside the `me register` method?
    var elist = [entry]
    serial_println("[mcp] probe m3c array literal of DispatchEntry ok")
    val elist2 = elist + [entry]
    serial_println("[mcp] probe m3d DispatchEntry array concat ok")
    serial_println("[mcp] probe m3e first tool_name=" + elist2[0].tool_name)
    # Discriminating probe: `find` is a `me` method that READS `self.entries`
    # and stores nothing. If m3f prints, me-method dispatch and the self-field
    # READ are both fine and the trap is specifically the self-field STORE. If
    # m3f traps instead, the defect is me-method dispatch itself.
    val probe_find = reg.find("no_such_tool_at_all")
    if probe_find.present:
        serial_println("[mcp] probe m3f me-method self-field READ ok (unexpected hit)")
    else:
        serial_println("[mcp] probe m3f me-method self-field READ ok (miss, as expected)")
    reg.register(entry)
    serial_println("[mcp] probe m4 register ok")

    val token = AuthorityToken.root_for(
        Principal(id: "mcp", kind: PrincipalKind.Anonymous))
    serial_println("[mcp] probe m5 AuthorityToken.root_for ok")

    val hit = dispatch_wrap(reg, "echo", ["MCP_RTT_PAYLOAD"], token)
    serial_println("[mcp] request  tool=echo args=[MCP_RTT_PAYLOAD]")
    serial_println("[mcp] response " + hit)

    val miss = dispatch_wrap(reg, "no_such_tool_xyz", [], token)
    serial_println("[mcp] request  tool=no_such_tool_xyz (must be refused)")
    serial_println("[mcp] response " + miss)

    var rc = 0
    if not _contains(hit, "MCP_RTT_PAYLOAD"):
        serial_println("[mcp] FAIL registered dispatch lost the payload")
        rc = 1
    if not _contains(miss, "unregistered_tool"):
        serial_println("[mcp] FAIL unregistered dispatch was not refused")
        rc = 1
    if rc == 0:
        serial_println("COMPONENT_MCP_SIMPLEOS_RISCV64_OK dispatch round-trip echoed the payload and refused the unknown tool")
    rc

# ---------------------------------------------------------------------------
# Row 2 — dev tool (real lint rule)
# ---------------------------------------------------------------------------

fn devtool_component_row() -> i64:
    """Run the REAL os-freestanding lint rule over two snippets."""
    val clean = "fn f() -> i64:\n    val x = 1\n    x\n"
    # A module-level global whose initializer is a CALL — exactly what
    # _fsk_check_global_call_init flags in a freestanding OS source file.
    val dirty = "val g = make_thing()\nfn f() -> i64:\n    0\n"

    val clean_warnings = lint_os_freestanding_patterns("src/os/probe_clean.spl", clean)
    val dirty_warnings = lint_os_freestanding_patterns("src/os/probe_dirty.spl", dirty)

    serial_println("[devtool] lint src/os/probe_clean.spl  (expect no findings)")
    serial_println("[devtool] lint src/os/probe_dirty.spl  (expect a finding)")
    for w in dirty_warnings:
        serial_println("[devtool] finding: " + w.message)

    var rc = 0
    if clean_warnings.len() != 0:
        serial_println("[devtool] FAIL clean snippet produced findings")
        rc = 1
    if dirty_warnings.len() == 0:
        serial_println("[devtool] FAIL dirty snippet produced no finding — the rule is inert")
        rc = 1
    if rc == 0:
        serial_println("COMPONENT_DEVTOOL_SIMPLEOS_RISCV64_OK real lint rule ran in-guest, clean snippet silent and dirty snippet flagged")
    rc

# ---------------------------------------------------------------------------
# Row 3 — caret
# ---------------------------------------------------------------------------

fn caret_component_row() -> i64:
    """Build a caret message with the real JSON helpers, read it back with the
    real extractor, and run the real redactor over a secret-bearing string."""
    val msg = jo2(jp("role", js("user")), jp("content", js("CARET_RTT_CONTENT")))
    serial_println("[caret] built message: " + msg)

    val role = extract_json_string(msg, "role")
    val content = extract_json_string(msg, "content")
    serial_println("[caret] extracted role=" + role)
    serial_println("[caret] extracted content=" + content)

    val secret_bearing = "key AKIAIOSFODNN7EXAMPLE trails CARET_KEEPME"
    # DIAGNOSTIC (2026-08-31): redact() came back EMPTY in-guest while the same
    # call on the host returns "key [REDACTED:aws_access_key_id:MPLE] trails
    # CARET_KEEPME". These probes narrow which text primitive redact leans on
    # is broken under freestanding riscv64 codegen. Diagnostics only; no rung.
    serial_println("[caret] probe c0 input: " + secret_bearing)
    serial_println("[caret] probe c1 substring(0,3)=" + secret_bearing.substring(0, 3))
    var acc = ""
    var ci = 0
    while ci < 5:
        acc = acc + secret_bearing[ci]
        ci = ci + 1
    serial_println("[caret] probe c2 charloop5=" + acc)
    serial_println("[caret] probe c3 redact-of-plain=" + redact("plain CARET_KEEPME"))
    val redacted = redact(secret_bearing)
    serial_println("[caret] redacted: " + redacted)

    var rc = 0
    if role != "user":
        serial_println("[caret] FAIL role did not round-trip")
        rc = 1
    if content != "CARET_RTT_CONTENT":
        serial_println("[caret] FAIL content did not round-trip")
        rc = 1
    if _contains(redacted, "AKIAIOSFODNN7EXAMPLE"):
        serial_println("[caret] FAIL the secret survived redaction")
        rc = 1
    if not _contains(redacted, "CARET_KEEPME"):
        serial_println("[caret] FAIL redaction destroyed non-secret text")
        rc = 1
    if rc == 0:
        serial_println("COMPONENT_CARET_SIMPLEOS_RISCV64_OK message round-tripped through the real helpers and the real redactor removed the secret")
    rc

# ---------------------------------------------------------------------------
# Row 4 — test runner
# ---------------------------------------------------------------------------

fn testrunner_component_row() -> i64:
    """Feed a real spec transcript to the REAL test-runner output parser."""
    # GATE-FIXTURE DEFECT, fixed 2026-08-31: the previous literal here was a
    # RUST cargo-test summary ("test result: FAILED. 2 passed; 1 failed"), a
    # format `parse_test_output` was never written to read. Its grammar is the
    # Simple runner's own: "Passed:/Failed:" summary lines, or an
    # "N examples, M failures" line. Measured on the HOST with the very same
    # std.nogc_sync_mut.test_runner.test_executor_parsing.parse_test_output the
    # guest links, the old literal returned (0, 0, 0, 0) — so this rung could
    # not pass on ANY target and measured nothing about riscv64. The rung, its
    # literals and the gate's must-FAIL fixtures are unchanged; only the INPUT
    # was corrected to a transcript the real parser actually accepts, which the
    # host confirms yields passed=2 / failed=1.
    val transcript =
        "running 3 examples\n" +
        "  arithmetic adds ... ok\n" +
        "  arithmetic subtracts ... ok\n" +
        "  arithmetic divides by zero ... FAILED\n" +
        "\n" +
        "3 examples, 1 failure\n"
    serial_println("[testrun] feeding a 3-example spec transcript to the real parser")
    val counts = parse_test_output(transcript)
    val passed = counts.0
    val failed = counts.1

    # No integer interpolation on this path (see the header note): the counts
    # are reported by WHICH literal is printed, which keeps the gate rung exact.
    var rc = 0
    if passed == 2:
        serial_println("[testrun] parser reported passed=2")
    else:
        serial_println("[testrun] FAIL parser did not report passed=2")
        rc = 1
    if failed == 1:
        serial_println("[testrun] parser reported failed=1")
    else:
        serial_println("[testrun] FAIL parser did not report failed=1")
        rc = 1
    if rc == 0:
        serial_println("COMPONENT_TESTRUN_SIMPLEOS_RISCV64_OK real runner parser summarised the spec as 2 passed / 1 failed")
    rc

# ---------------------------------------------------------------------------

fn _contains(haystack: text, needle: text) -> bool:
    """Substring test written locally on purpose: this is gate plumbing, not
    component logic, so implementing it here cannot launder a component pass."""
    val h = haystack.len()
    val n = needle.len()
    if n == 0:
        return true
    if n > h:
        return false
    var i = 0
    while i + n <= h:
        var j = 0
        var same = true
        while j < n:
            if haystack[i + j] != needle[j]:
                same = false
                j = n
            else:
                j = j + 1
        if same:
            return true
        i = i + 1
    false

fn spl_start():
    """riscv64 in-guest component sanity entry, reached from crt0.S ->
    boot_entry in S-mode after OpenSBI's firmware-performed handover."""
    serial_println("")
    serial_println("[components] SimpleOS riscv64 in-guest toolchain components (OpenSBI fw_payload)")
    serial_println("[components] serial up, exercising real product modules")

    # Row order is deliberate: mcp runs LAST. It is the only row that currently
    # traps in-guest (the CPU re-enters the entry, reprinting the two banner
    # lines without a fresh OpenSBI banner), and a trap in the first row starves
    # every later row of its chance to report. Ordering it last keeps the other
    # three rows' evidence observable while the mcp defect is open. The gate
    # still requires all four rows, so this hides nothing.
    var rc = 0
    if devtool_component_row() != 0:
        rc = 1
    if caret_component_row() != 0:
        rc = 1
    if testrunner_component_row() != 0:
        rc = 1
    if mcp_component_row() != 0:
        rc = 1

    if rc == 0:
        serial_println("[components] all component rows exited rc=0")
    else:
        serial_println("[components] at least one component row exited rc=nonzero")
    serial_println("[components] parking")
