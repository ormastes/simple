# SimpleOS riscv64 in-guest SIMPLE INTERPRETER hello-world entry (OpenSBI lane).
#
# GOAL ROW 1: "a hello world .spl INTERPRETED in-guest on riscv64, printing to
# serial". This file closes that row.
#
# Boot chain and forbidden-flag policy are identical to hello_world_sbi_entry.spl
# and the toolchain component entries: real OpenSBI v1.4 built as `fw_payload`
# with this kernel Image embedded, handed to QEMU as `-bios` ONLY. NEVER QEMU
# `-kernel`, NEVER isa-debug-exit — fw_dynamic's next-stage address is populated
# by QEMU's `-kernel` machinery, which is exactly the banned pass semantics,
# whereas fw_payload is a real board-shipping configuration: the FIRMWARE, not
# QEMU, performs the S-mode handover to 0x80200000.
#
# COMPILER: the RUST SEED. The pure-Simple self-hosted compiler cannot compile
# anything in this tree yet, so this lane's artifact is seed-built and the gate's
# verdict says so rather than implying self-hosting.
#
# WHAT THIS PROVES, precisely
# ---------------------------
# The REAL Simple interpreter — unmodified product code, the same
# `InterpreterBackendImpl.interpret_hir_module` that `src/app/simpleos_tool/
# focused_pipeline.spl` drives on a hosted build — runs INSIDE the guest and
# EVALUATES a hello-world Simple program end to end:
#
#     source text -> _pp_preprocess_conditionals -> parse_and_build_module
#                 -> desugar_module -> HirLowering.lower_module
#                 -> InterpreterBackendImpl.interpret_hir_module -> `main` runs
#
# The interpreted program's OWN `print` statement is what puts the success line
# on the serial console. Nothing in this file prints that line; if the
# interpreter does not actually execute `main`, the line cannot appear.
#
# NONCE ANCHORING (why this cannot pass vacuously)
# ------------------------------------------------
# The marker the gate greps for carries a NONCE generated OUTSIDE the guest, per
# run, by scripts/os/build-simpleos-riscv64-interpreter-kernel.shs, which writes
# it into build/os/generated/rv64_interp_nonce.spl. The nonce reaches the serial
# console only by being embedded in the interpreted program's source text and
# then printed by the interpreted program. A stale image, a replayed transcript,
# or a guest that boots and prints a fixed banner therefore cannot satisfy the
# gate: the gate knows the nonce it just generated and accepts no other.
#
# HONEST SCOPE, stated rather than papered over
# ---------------------------------------------
# The interpreter runs in S-mode (kernel mode), linked into the guest image —
# not as a U-mode process loaded off the guest's own filesystem. That is the
# same scope as every other in-guest row in this tree (x86_64 PR #177, aarch64
# PR #175, riscv64 components). riscv64 DOES carry a U-mode ELF loader
# (boot/rv64_fs_exec_loader.inc.c, with Sv39 page-table construction) and a
# scheduler/enter-user path (arch/riscv64/entry.spl `_rv64_enter_user`), but its
# public execution entry `rt_riscv_fs_exec_run()` DELIBERATELY FAILS CLOSED
# (returns -13) pending an authority token bound to digest, mount/file identity
# and content generation. Routing around that fail-closed to manufacture a
# U-mode row would be defeating a security control, not delivering evidence, so
# this lane does not do it. Within S-mode scope every step above is a real
# round-trip through unmodified product source.
#
# The source text is deliberately kept to constructs the freestanding riscv64
# runtime supports. NEVER interpolate an integer into text in THIS file — that
# emits rt_raw_i64_to_string, which the freestanding riscv64 runtime does not
# provide, and the link dies.

use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.desugar.desugar_async.{desugar_module}
use compiler.frontend.desugar.collection_desugar.{desugar_collections_static}
use compiler.core.parser_preprocessor.{_pp_preprocess_conditionals}
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.backend.backend.interpreter.{InterpreterBackendImpl}
use build.os.generated.rv64_interp_nonce.{rv64_interp_nonce}

@unsafe(reason: "foreign serial output provider is not artifact-verified", capabilities: [ffi])
extern fn serial_println(msg: text)

fn interpreter_hello_source() -> text:
    """The hello-world Simple PROGRAM that the in-guest interpreter evaluates.

    This is ordinary Simple source text, not a fixture of the interpreter's
    internals. `main` is what InterpreterBackendImpl locates and runs.

    The nonce is concatenated in rather than interpolated so that the value the
    gate greps for is unambiguously the build-time nonce and nothing else.
    """
    "fn main():\n" +
        "    print \"HELLO_INTERP_SIMPLEOS_RISCV64_OK nonce=" + rv64_interp_nonce() + "\"\n" +
        "    print \"HELLO_INTERP_SIMPLEOS_RISCV64 second line proves the interpreter kept running\"\n"

fn interpreter_hello_row() -> i64:
    """Drive the REAL interpreter over the hello-world source, in-guest."""
    val path = "src/os/rv64_interp_hello.spl"
    val source = interpreter_hello_source()

    serial_println("[interp] lowering hello-world source through the real frontend")
    var parsed = parse_and_build_module(_pp_preprocess_conditionals(source), path)
    parsed = desugar_module(parsed)
    desugar_collections_static(0, 0)

    var lowering: HirLowering = HirLowering.with_filename(path)
    val hir: HirModule = lowering.lower_module(parsed)
    if lowering.errors.len() > 0:
        serial_println("[interp] FAIL hir lowering error: " + lowering.errors[0].message)
        return 1
    if hir.functions.len() == 0:
        serial_println("[interp] FAIL hir module has no functions — nothing to interpret")
        return 1
    serial_println("[interp] hir ready, invoking InterpreterBackendImpl.interpret_hir_module")

    # Everything below the next line that reaches the console comes from the
    # INTERPRETED program, not from this file.
    val interpreted = InterpreterBackendImpl.new().interpret_hir_module(hir)
    match interpreted:
        case Ok(_):
            serial_println("[interp] interpreter returned Ok")
            0
        case Err(error):
            serial_println("[interp] FAIL interpreter error: " + error.message)
            1

fn spl_start():
    """riscv64 in-guest interpreter entry, reached from crt0.S -> boot_entry in
    S-mode after OpenSBI's firmware-performed handover."""
    serial_println("")
    serial_println("[interp] SimpleOS riscv64 in-guest Simple interpreter (OpenSBI fw_payload)")
    serial_println("[interp] serial up, interpreting a hello world")
    val rc = interpreter_hello_row()
    if rc == 0:
        serial_println("[interp] interpreter row exited rc=0")
    else:
        serial_println("[interp] interpreter row exited rc=nonzero")
    serial_println("[interp] parking")
