use os.kernel.boot.riscv_noalloc_handoff.{riscv_noalloc_handoff, riscv_noalloc_boot_idle}
use os.kernel.boot.riscv_noalloc_heap.{
    RISCV_QEMU_RAM_BASE, RISCV_QEMU_RAM_SIZE, RISCV_QEMU_RESERVED_END,
    RISCV_QEMU_HEAP_START, RISCV_QEMU_HEAP_SIZE, riscv_noalloc_heap_init}
use os.kernel.boot.riscv_noalloc_log.{riscv_noalloc_log_init, riscv_noalloc_log_boot_ok}
use os.kernel.boot.riscv_noalloc_services.{riscv_noalloc_services_init}
use os.crypto.ed25519.{ed25519_keypair_from_seed, ed25519_sign, ed25519_verify}

extern fn serial_println(msg: text)
extern fn rt_bytes_u8_at(arr: [u8], idx: i64) -> i64
extern fn rt_riscv_noalloc_pmm_init(ram_base: u64, ram_size: u64, reserved_end: u64, heap_start: u64) -> i64

@section(".text.entry")
@naked
fn _start():
    asm volatile:
        "mv      s0, a0"
        "mv      s1, a1"
        "bnez    s0, .Lrv64_ed25519_halt"
        "la      sp, _stack_top"
        "la      t0, _sbss"
        "la      t1, _ebss"
        ".Lrv64_ed25519_bss_loop:"
        "bgeu    t0, t1, .Lrv64_ed25519_bss_done"
        "sd      zero, 0(t0)"
        "addi    t0, t0, 8"
        "j       .Lrv64_ed25519_bss_loop"
        ".Lrv64_ed25519_bss_done:"
        "mv      a0, s0"
        "mv      a1, s1"
        "call    m_09_embedded__simple_os__arch__riscv64__ed25519_probe_entry__rv64_ed25519_probe_boot_main"
        ".Lrv64_ed25519_halt:"
        "wfi"
        "j       .Lrv64_ed25519_halt"

fn _byte_at(data: [u8], idx: i64) -> u8:
    rt_bytes_u8_at(data, idx).to_u8()

fn _push_byte(out: [u8], byte_val: i64) -> [u8]:
    var next = out
    next.push((byte_val & 0xFF).to_u8())
    next

fn _hex_digit(n: u8) -> text:
    if n == 0x0: return "0"
    if n == 0x1: return "1"
    if n == 0x2: return "2"
    if n == 0x3: return "3"
    if n == 0x4: return "4"
    if n == 0x5: return "5"
    if n == 0x6: return "6"
    if n == 0x7: return "7"
    if n == 0x8: return "8"
    if n == 0x9: return "9"
    if n == 0xA: return "a"
    if n == 0xB: return "b"
    if n == 0xC: return "c"
    if n == 0xD: return "d"
    if n == 0xE: return "e"
    "f"

fn _hex(data: [u8]) -> text:
    var out = ""
    var i: i64 = 0
    while i < data.len().to_i64():
        val b = _byte_at(data, i)
        out = out + _hex_digit((b / 16) & 0x0F)
        out = out + _hex_digit(b & 0x0F)
        i = i + 1
    out

fn _rfc8032_vec1_seed() -> [u8]:
    var seed: [u8] = []
    seed = _push_byte(seed, 0x9d)
    seed = _push_byte(seed, 0x61)
    seed = _push_byte(seed, 0xb1)
    seed = _push_byte(seed, 0x9d)
    seed = _push_byte(seed, 0xef)
    seed = _push_byte(seed, 0xfd)
    seed = _push_byte(seed, 0x5a)
    seed = _push_byte(seed, 0x60)
    seed = _push_byte(seed, 0xba)
    seed = _push_byte(seed, 0x84)
    seed = _push_byte(seed, 0x4a)
    seed = _push_byte(seed, 0xf4)
    seed = _push_byte(seed, 0x92)
    seed = _push_byte(seed, 0xec)
    seed = _push_byte(seed, 0x2c)
    seed = _push_byte(seed, 0xc4)
    seed = _push_byte(seed, 0x44)
    seed = _push_byte(seed, 0x49)
    seed = _push_byte(seed, 0xc5)
    seed = _push_byte(seed, 0x69)
    seed = _push_byte(seed, 0x7b)
    seed = _push_byte(seed, 0x32)
    seed = _push_byte(seed, 0x69)
    seed = _push_byte(seed, 0x19)
    seed = _push_byte(seed, 0x70)
    seed = _push_byte(seed, 0x3b)
    seed = _push_byte(seed, 0xac)
    seed = _push_byte(seed, 0x03)
    seed = _push_byte(seed, 0x1c)
    seed = _push_byte(seed, 0xae)
    seed = _push_byte(seed, 0x7f)
    seed = _push_byte(seed, 0x60)
    seed

fn rv64_ed25519_probe_boot_main(hart_id: u64, dtb_addr: u64):
    riscv_noalloc_log_init()
    riscv_noalloc_handoff(hart_id, dtb_addr)
    val pmm_ready = rt_riscv_noalloc_pmm_init(
        RISCV_QEMU_RAM_BASE,
        RISCV_QEMU_RAM_SIZE,
        RISCV_QEMU_RESERVED_END,
        RISCV_QEMU_HEAP_START
    )
    if pmm_ready != 1:
        riscv_noalloc_boot_idle()
        return
    riscv_noalloc_heap_init(RISCV_QEMU_HEAP_START, RISCV_QEMU_HEAP_SIZE)
    riscv_noalloc_services_init(true)
    riscv_noalloc_log_boot_ok()
    spl_start()
    riscv_noalloc_boot_idle()

@export("C")
fn spl_start():
    serial_println("=== RV64 Ed25519 probe ===")
    val seed = _rfc8032_vec1_seed()
    val kp = ed25519_keypair_from_seed(seed)
    val pk = kp.1
    val empty_msg: [u8] = []
    val sig = ed25519_sign(seed, pk, empty_msg)
    val ok = ed25519_verify(pk, empty_msg, sig)
    serial_println("ED25519_PROBE_PK=" + _hex(pk))
    serial_println("ED25519_PROBE_SIG_EMPTY=" + _hex(sig))
    if ok:
        serial_println("ED25519_PROBE_VERIFY=OK")
    else:
        serial_println("ED25519_PROBE_VERIFY=FAIL")
