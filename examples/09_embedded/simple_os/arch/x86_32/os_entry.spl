# x86_32 (i686) OS Entry — Full-stack SimpleOS boot (bare-metal, multiboot)
#
# crt0.s (_entry32) sets up the stack, zeroes BSS and calls _start, which the
# freestanding runtime forwards to spl_start. Mirrors arch/riscv32/os_entry.spl
# without the riscv-owned service bring-up.

extern fn serial_println(msg: text)

# Direct POSIX init (bypass mod.spl to avoid weak-stub cascade)
use os.posix.fd_table.{fd_table_init}
use os.posix.async_io.{async_io_init}
use os.posix.signal_compat.{signal_init}

# Shell
use os.apps.shell.shell_boot.{shell_boot_init}

fn spl_start():
    serial_println("")
    serial_println("=== SimpleOS Boot (i686) ===")
    serial_println("")

    serial_println("[boot] init POSIX layer (fd_table, async_io, signal)")
    fd_table_init()
    async_io_init()
    signal_init()

    val shell = shell_boot_init()
    serial_println("[boot] Shell ready")

    serial_println("")
    serial_println("=== SimpleOS ready ===")
    serial_println("TEST PASSED")
