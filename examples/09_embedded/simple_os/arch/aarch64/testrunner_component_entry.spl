# SimpleOS aarch64 in-guest TEST RUNNER component sanity entry (EDK2/AAVMF).
#
# Sibling of devtool_component_entry.spl; see that file's header for the boot
# chain, the forbidden-flag policy (NEVER -kernel, NEVER isa-debug-exit), the
# per-component build rule, and the compiler statement (RUST SEED).
#
# Port of the riscv64 test-runner entry, which linked and booted and then
# STALLED inside the real parse_test_output — the known in-guest text.len()
# defect owned by another lane. Kept identical in shape so an identical stall
# is recognisable as that same defect.
#
# HONEST SCOPE: this runs the runner's result-EVALUATION core over a real spec
# transcript. The guest does not fork a child `simple test` process, because a
# freestanding EL1 image has no process model. Within that scope the round-trip
# is real: a transcript in, the REAL parser's counts out, rung on both the
# passed and the failed count so a parser that answered a constant fails.
#
# NEVER interpolate an integer into text — that emits rt_raw_i64_to_string,
# which the freestanding aarch64 runtime does not provide, and the link dies.

use os.kernel.log.klog_api.{log_init_serial, log_raw_println, LOG_INFO}
use std.nogc_sync_mut.test_runner.test_executor_parsing.{parse_test_output}

@unsafe(reason: "bare WFE park has no artifact-verified contract", capabilities: [ffi])
extern fn rt_aarch64_wfe_spin()

fn testrunner_component_row() -> i64:
    """Feed a real spec transcript to the REAL test-runner output parser."""
    val transcript =
        "running 3 tests\n" +
        "test arithmetic adds ... ok\n" +
        "test arithmetic subtracts ... ok\n" +
        "test arithmetic divides by zero ... FAILED\n" +
        "\n" +
        "test result: FAILED. 2 passed; 1 failed; 0 ignored\n"
    log_raw_println("[testrun] feeding a 3-example spec transcript to the real parser")
    val counts = parse_test_output(transcript)
    val passed = counts.0
    val failed = counts.1

    var rc = 0
    if passed == 2:
        log_raw_println("[testrun] parser reported passed=2")
    else:
        log_raw_println("[testrun] FAIL parser did not report passed=2")
        rc = 1
    if failed == 1:
        log_raw_println("[testrun] parser reported failed=1")
    else:
        log_raw_println("[testrun] FAIL parser did not report failed=1")
        rc = 1
    if rc == 0:
        log_raw_println("COMPONENT_TESTRUN_SIMPLEOS_AARCH64_OK real runner parser summarised the spec as 2 passed / 1 failed")
    rc

@noreturn
fn _start():
    """aarch64 in-guest test-runner sanity entry. Limine hands off at EL1 with
    the MMU on and a valid stack; the name `_start` is load-bearing."""
    log_init_serial(LOG_INFO)
    log_raw_println("")
    log_raw_println("[components] SimpleOS aarch64 in-guest toolchain components (EDK2/AAVMF -> BOOTAA64.EFI)")
    log_raw_println("[components] serial up, exercising real product modules")
    val rc = testrunner_component_row()
    if rc == 0:
        log_raw_println("[components] all component rows exited rc=0")
    else:
        log_raw_println("[components] at least one component row exited rc=nonzero")
    log_raw_println("[components] parking")
    while true:
        unsafe:
            rt_aarch64_wfe_spin()
