# SimpleOS x86_64 in-guest CARET component sanity entry (OVMF/GRUB-EFI lane).
#
# Sibling of devtool_component_entry.spl; see that file's header for the boot
# chain (OVMF pflash -> GRUB-EFI -> multiboot; NEVER `-kernel`, NEVER
# isa-debug-exit), the per-component build rule, and the compiler statement
# (RUST SEED).
#
# Port of the aarch64 caret entry, deliberately identical in SHAPE so that the
# known in-guest text.len() stall inside extract_json_string — owned by a
# separate lane and recorded in
# doc/08_tracking/bug/simpleos_aarch64_in_guest_text_defects_not_len_abi_2026-08-31.md
# — is recognisable here as that same defect rather than a new x86_64 one.
#
# WHAT THIS PROVES (to the extent it gets): a caret message is built by the REAL
# json_helpers, read back by the REAL extractor, and a secret-bearing string is
# passed through the REAL redactor — rung on CONTENT in BOTH directions (the
# secret must be gone AND the non-secret text must survive), so a redactor that
# erased everything fails this row instead of passing it.
#
# NEVER interpolate an integer into text — that emits rt_raw_i64_to_string,
# which the freestanding x86_64 runtime does not provide, and the link dies.
# No module-level `val` globals: on this native-build config they have been
# observed treated as unresolved extern symbols (see abi_probe_entry.spl).

use app.llm_caret.redact.{redact}
use app.llm_caret.json_helpers.{jo2, jp, js, extract_json_string}

@unsafe(reason: "foreign serial output provider is not artifact-verified", capabilities: [ffi])
extern fn serial_println(msg: text)

fn _contains(haystack: text, needle: text) -> bool:
    """Substring test written locally on purpose: this is gate plumbing, not
    component logic, so implementing it here cannot launder a component pass."""
    val h = haystack.len()
    val n = needle.len()
    if n == 0:
        return true
    if n > h:
        return false
    var i = 0
    while i + n <= h:
        var j = 0
        var same = true
        while j < n:
            if haystack[i + j] != needle[j]:
                same = false
                j = n
            else:
                j = j + 1
        if same:
            return true
        i = i + 1
    false

fn caret_component_row() -> i64:
    """Build a caret message with the real JSON helpers, read it back with the
    real extractor, and run the real redactor over a secret-bearing string."""
    val msg = jo2(jp("role", js("user")), jp("content", js("CARET_RTT_CONTENT")))
    serial_println("[caret] built message: " + msg)

    val role = extract_json_string(msg, "role")
    val content = extract_json_string(msg, "content")
    serial_println("[caret] extracted role=" + role)
    serial_println("[caret] extracted content=" + content)

    val secret_bearing = "key AKIAIOSFODNN7EXAMPLE trails CARET_KEEPME"
    val redacted = redact(secret_bearing)
    serial_println("[caret] redacted: " + redacted)

    var rc = 0
    if role != "user":
        serial_println("[caret] FAIL role did not round-trip")
        rc = 1
    if content != "CARET_RTT_CONTENT":
        serial_println("[caret] FAIL content did not round-trip")
        rc = 1
    if _contains(redacted, "AKIAIOSFODNN7EXAMPLE"):
        serial_println("[caret] FAIL the secret survived redaction")
        rc = 1
    if not _contains(redacted, "CARET_KEEPME"):
        serial_println("[caret] FAIL redaction destroyed non-secret text")
        rc = 1
    if rc == 0:
        serial_println("COMPONENT_CARET_SIMPLEOS_X86_64_OK message round-tripped through the real helpers and the real redactor removed the secret")
    rc

fn _start():
    """x86_64 in-guest caret sanity entry, reached from crt0.s after the
    multiboot handover performed by GRUB-EFI under OVMF."""
    serial_println("")
    serial_println("[components] SimpleOS x86_64 in-guest toolchain components (OVMF -> GRUB-EFI)")
    serial_println("[components] serial up, exercising real product modules")
    val rc = caret_component_row()
    if rc == 0:
        serial_println("[components] all component rows exited rc=0")
    else:
        serial_println("[components] at least one component row exited rc=nonzero")
    serial_println("[components] parking")
