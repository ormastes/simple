# Focused x86_64 freestanding probe for Simple Web custom-property transport.
#
# This intentionally drives the production collector, resolver, cascade, and
# debug-style surface without booting the full desktop. The host-side checker
# validates the exact serial values; the guest does not self-compare dynamic
# text because freestanding text equality is not an independent oracle.

use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_core.{
    simple_web_layout_debug_collect_custom_props,
    simple_web_layout_debug_custom_prop_state,
    simple_web_layout_debug_backdrop_admission,
    simple_web_layout_debug_resolve_custom_props,
    simple_web_layout_debug_style_by_id
}

extern fn serial_println(msg: text)
extern fn rt_port_outb(port: u16, value: u8)

fn _probe_css() -> text:
    ":root{--blur-surface:30px;--app-surface:rgba(31,31,33,0.80)}" +
    "#aetheric{" +
    "background:linear-gradient(180deg,rgba(255,255,255,0.08)," +
    "rgba(255,255,255,0.025)),var(--app-surface);" +
    "backdrop-filter:blur(var(--blur-surface)) saturate(170%)" +
    "}" +
    "#memo{background-color:var(--app-surface)}"

fn _probe_html(css: text) -> text:
    "<html><head><style>" + css +
    "</style></head><body><div id=\"aetheric\"></div>" +
    "<div id=\"memo\"></div></body></html>"

fn _start():
    val css = _probe_css()
    val html = _probe_html(css)
    serial_println("[css-var-probe] boot html_len={html.len()}")
    serial_println("[css-var-probe] collect-start css_len={css.len()}")
    val collected = simple_web_layout_debug_collect_custom_props(css, "")
    serial_println(
        "[css-var-probe] collect-done props_len={collected.len()} props={collected}"
    )
    serial_println("[css-var-probe] state-start")
    val state_count = simple_web_layout_debug_custom_prop_state(
        collected, 0, "count"
    )
    val state_name0 = simple_web_layout_debug_custom_prop_state(
        collected, 0, "name"
    )
    val state_value0 = simple_web_layout_debug_custom_prop_state(
        collected, 0, "value"
    )
    val state_name1 = simple_web_layout_debug_custom_prop_state(
        collected, 1, "name"
    )
    val state_value1 = simple_web_layout_debug_custom_prop_state(
        collected, 1, "value"
    )
    serial_println(
        "[css-var-probe] state-done count={state_count} name0={state_name0} value0={state_value0} name1={state_name1} value1={state_value1}"
    )
    serial_println("[css-var-probe] resolve-start")
    val resolved = simple_web_layout_debug_resolve_custom_props(css, collected)
    serial_println(
        "[css-var-probe] resolve-done css_len={resolved.len()} css={resolved}"
    )
    serial_println("[css-var-probe] background-start")
    val background = simple_web_layout_debug_style_by_id(
        html, "aetheric", "background_color"
    )
    serial_println("[css-var-probe] background-done value={background}")
    serial_println("[css-var-probe] gradient-from-start")
    val gradient_from = simple_web_layout_debug_style_by_id(
        html, "aetheric", "background_gradient_from"
    )
    serial_println("[css-var-probe] gradient-from-done value={gradient_from}")
    serial_println("[css-var-probe] gradient-to-start")
    val gradient_to = simple_web_layout_debug_style_by_id(
        html, "aetheric", "background_gradient_to"
    )
    serial_println("[css-var-probe] gradient-to-done value={gradient_to}")
    serial_println("[css-var-probe] layers-start")
    val layers = simple_web_layout_debug_style_by_id(
        html, "aetheric", "background_layers_raw"
    )
    serial_println("[css-var-probe] layers-done value={layers}")
    serial_println("[css-var-probe] backdrop-start")
    val backdrop = simple_web_layout_debug_style_by_id(
        html, "aetheric", "backdrop_filter_raw"
    )
    serial_println("[css-var-probe] backdrop-done value={backdrop}")
    val backdrop_admission = simple_web_layout_debug_backdrop_admission(backdrop)
    serial_println(
        "[css-var-probe] backdrop-admission value={backdrop_admission}"
    )
    serial_println("[css-var-probe] memo-start")
    val memo_background = simple_web_layout_debug_style_by_id(
        html, "memo", "background_color"
    )
    serial_println("[css-var-probe] memo-done value={memo_background}")

    serial_println("[css-var-probe] background={background}")
    serial_println("[css-var-probe] gradient_from={gradient_from}")
    serial_println("[css-var-probe] gradient_to={gradient_to}")
    serial_println("[css-var-probe] layers={layers} layers_len={layers.len()}")
    serial_println("[css-var-probe] backdrop={backdrop} backdrop_len={backdrop.len()}")
    serial_println("[css-var-probe] memo_background={memo_background}")
    serial_println("CSS_VAR_TRANSPORT_PROBE_DONE")
    rt_port_outb(0xf4u16, 0x03u8)
