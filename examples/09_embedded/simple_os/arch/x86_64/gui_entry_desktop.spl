# x86_64 Desktop GUI Entry -- Production interactive desktop with VFS
#
# Combines gui_entry.spl (BGA framebuffer, PS/2 input, compositor, shell)
# with desktop_e2e_entry.spl (kernel init, VFS boot, launcher, IPC) for a
# fully interactive desktop session with filesystem-backed app launching.
#
# Boot sequence:
# 1. COM1 serial init
# 2. Kernel IDT + memory bootstrap (PMM/VMM)
# 3. Syscall shim + interrupt runtime install
# 4. VFS boot init (NVMe FAT32 mount)
# 5. BGA framebuffer init (1024x768x32)
# 6. PS/2 keyboard + mouse init
# 7. Compositor + DesktopShell
# 8. Interactive event loop (shell.run)
#
# Serial markers:
#   [desktop-gui] spl_start
#   [desktop-gui] boot
#   [vfs] mounted fat32 device=nvme0 volume=simpleos
#   [desktop-gui] desktop-ready
#
# QEMU scenario: x64-desktop-gui (gui_mode: true + NVMe + removable + net)

use os.kernel.arch.x86_64.console.{serial_init, serial_writeln}
use os.kernel.boot.cpu.{port_inb, port_outb}
use os.drivers.framebuffer.bga_init.{bga_device_id, bga_init_scanout, bga_pci_decode_is_enabled, find_bga_pci_device, scanout_evidence_is_valid, bga_mmio_read, bga_read}
use os.drivers.framebuffer.fb_driver.{FramebufferDriver}
use os.drivers.framebuffer.fb_font.{get_glyph_8x16}
use os.drivers.input.ps2_keyboard.{Ps2Keyboard}
use os.drivers.input.ps2_mouse.{Ps2Mouse, MouseState}
use os.compositor.compositor.{Compositor}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use os.compositor.engine2d_wm_frame_executor.{Engine2dWmFrameExecutor}
use os.compositor.input_backend.{Ps2InputBackend}
use os.compositor.engine2d_display.{create_fb_engine_sized}
use os.desktop.shell.{DesktopShell}
use os.desktop.font_bootstrap.{simpleos_desktop_register_selected_fonts_from_vfs, simpleos_desktop_registered_font_count, simpleos_desktop_selected_font_count, simpleos_desktop_font_failure_summary, simpleos_desktop_default_font_registered}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.{simple_web_layout_set_render_budget_floor_ms}
use os.services.launcher.launcher.{launcher_get_app_count}
use os.services.vfs.vfs_init.{vfs_boot_init, vfs_mount_removable, g_vfs_read_file_bytes}
use os.services.vfs.vfs_write_ops.{g_vfs_file_exists}
use os.services.pkg.pkg_service.{pkg_service_init}
use os.kernel.arch.x86_64.interrupt.{X86Interrupt}
use os.kernel.arch.x86_64.arch_init.{arch_x86_64_direct_boot_init}
use os.kernel.arch.x86_64.interrupt.{x86_dispatch_installed_syscall_abi}
use os.kernel.memory.pmm.{pmm_init_identity_range}
use os.kernel.memory.vmm.{vmm_activate, vmm_bootstrap_pd_entry0, vmm_bootstrap_pdpt_entry0, vmm_bootstrap_pml4_entry0, vmm_init_from_global_pmm, vmm_kernel_pml4_phys}
use os.kernel.boot.mmio.{mmio_disable_test_mode}
use os.kernel.boot.monotonic_hardware.{boot_monotonic_prepare, boot_monotonic_now_us}
use os.kernel.arch.x86_64.host_gpu_ivshmem_vmm.{map_qemu_host_gpu_ivshmem_bar2_active_vmm}
use common.gpu.simpleos_host_gpu_protocol.{SIMPLEOS_HOST_GPU_ISA_X86_64, SIMPLEOS_HOST_GPU_BACKEND_VULKAN}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.encoding.font_registry.{simpleos_default_font_asset_candidate, simpleos_font_asset_short_guest_path, validate_selected_font_asset}
use os.compositor.simpleos_wm_theme_bootstrap.{install_generated_simpleos_wm_theme}
use os.desktop.font_bootstrap.{simpleos_desktop_register_selected_fonts_from_vfs}

@export("C", name: "rt_file_exists")
fn rt_file_exists(path: text) -> bool:
    g_vfs_file_exists(path)

@export("C", name: "rt_file_read_bytes")
fn rt_file_read_bytes(path: text) -> [u8]:
    # Route hosted-style byte reads to the mounted VFS (overrides the weak
    # baremetal trap stub). On a degraded/absent mount this returns empty
    # bytes, so callers like font loading fail SOFT instead of halting.
    g_vfs_read_file_bytes(path)

@export("C", name: "ord")
fn ord(value: text) -> i64:
    if value.len() == 0:
        return 0
    value.char_code_at(0) as i64
use os.kernel.abi.syscall_shim.{shim_init}
use os.userlib.syscall_raw.{syscall}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.log.klog.{KernelLog}

extern fn serial_println(msg: text)
extern fn rt_gui_set_fb(addr: u64, width: u64)
extern fn rt_ptr_read_i64(addr: i64, offset: i64) -> i64
extern fn rt_ptr_read_i32(addr: i64, offset: i64) -> i32
extern fn rt_ptr_write_i32(addr: i64, offset: i64, value: i32)

val FB_W: u32 = 1024
val FB_H: u32 = 768
val FB_BPP: u32 = 32
val FB_PITCH: u32 = FB_W * 4
val PS2_DATA_PORT: u16 = 0x60
val PS2_COMMAND_PORT: u16 = 0x64
val MOUSE_COMMAND_PORT: u16 = 0x64
val CMD_ENABLE_AUX: u8 = 0xA8
val CMD_READ_CONFIG: u8 = 0x20
val CMD_WRITE_CONFIG: u8 = 0x60
val CMD_WRITE_AUX: u8 = 0xD4
val MOUSE_CMD_SET_DEFAULTS: u8 = 0xF6
val MOUSE_CMD_ENABLE_REPORTING: u8 = 0xF4
val MOUSE_STATUS_PORT: u16 = 0x64
val MOUSE_STATUS_OUTPUT_FULL: u8 = 0x01
val MOUSE_STATUS_INPUT_FULL: u8 = 0x02
val DIRECT_QEMU_TOTAL_MEMORY: u64 = 0x20000000
val DIRECT_QEMU_KERNEL_START: u64 = 0x100000
val DIRECT_QEMU_RESERVED_END: u64 = 0x14000000
val SYS_IPC_CREATE_PORT: u64 = 22
val WM_PORT_NAME_BOOT: text = "compositor"

var g_vfs_mounted = false

fn _ps2_wait_input_clear():
    var timeout: i64 = 100000
    while timeout > 0:
        val status = port_inb(MOUSE_STATUS_PORT)
        if (status & MOUSE_STATUS_INPUT_FULL) == 0:
            return
        timeout = timeout - 1

fn _ps2_wait_output_full():
    var timeout: i64 = 100000
    while timeout > 0:
        val status = port_inb(MOUSE_STATUS_PORT)
        if (status & MOUSE_STATUS_OUTPUT_FULL) != 0:
            return
        timeout = timeout - 1

fn _ps2_mouse_write(byte_val: u8):
    _ps2_wait_input_clear()
    port_outb(MOUSE_COMMAND_PORT, CMD_WRITE_AUX)
    _ps2_wait_input_clear()
    port_outb(PS2_DATA_PORT, byte_val)

fn _ps2_mouse_read() -> u8:
    _ps2_wait_output_full()
    port_inb(PS2_DATA_PORT)

fn _keyboard_bootstrap_init():
    port_outb(PS2_COMMAND_PORT, 0xAD)
    port_outb(PS2_COMMAND_PORT, 0xA7)
    port_inb(PS2_DATA_PORT)
    port_outb(PS2_COMMAND_PORT, 0xAE)
    port_outb(PS2_DATA_PORT, 0xF4)

fn _mouse_bootstrap_init(mouse: Ps2Mouse):
    port_outb(MOUSE_COMMAND_PORT, CMD_ENABLE_AUX)
    _ps2_wait_input_clear()
    port_outb(MOUSE_COMMAND_PORT, CMD_READ_CONFIG)
    _ps2_wait_output_full()
    val config = port_inb(PS2_DATA_PORT)
    val new_config = (config | 0x02) & 0xDF
    port_outb(MOUSE_COMMAND_PORT, CMD_WRITE_CONFIG)
    _ps2_wait_input_clear()
    port_outb(PS2_DATA_PORT, new_config)
    _ps2_wait_input_clear()
    _ps2_mouse_write(MOUSE_CMD_SET_DEFAULTS)
    _ps2_mouse_read()
    _ps2_mouse_write(MOUSE_CMD_ENABLE_REPORTING)
    _ps2_mouse_read()
    mouse.initialized = true

fn spl_start():
    serial_init()
    serial_println("[desktop-gui] spl_start")
    serial_println("[desktop-gui] boot")

    arch_x86_64_early_init()

    if pmm_init_identity_range(DIRECT_QEMU_TOTAL_MEMORY, DIRECT_QEMU_KERNEL_START, DIRECT_QEMU_RESERVED_END):
        vmm_init(g_pmm, 0)
        serial_println("[desktop-gui] memory-bootstrap:ok")
    else:
        serial_println("[desktop-gui] memory-bootstrap:fail")

    shim_init(Scheduler.new_bootstrap(), IpcManager.new(), KernelLog.new(256))

    if not X86Interrupt.runtime_installed():
        X86Interrupt.install_bootstrap_runtime(64)

    g_vfs_mounted = vfs_boot_init()
    if g_vfs_mounted:
        serial_println("[vfs] mounted fat32 device=nvme0 volume=simpleos")
    else:
        serial_println("[vfs] mount_failed fat32 reason=no-nvme-or-bad-fs")
        serial_println("[desktop-gui] fatal reason=font-media-mount")
        return
    if not simpleos_desktop_register_selected_fonts_from_vfs():
        serial_println("[desktop-gui] fatal reason=font-register")
        return
    val font_candidate = simpleos_default_font_asset_candidate()
    val font_guest_path = simpleos_font_asset_short_guest_path(font_candidate)
    val font_blob = g_vfs_read_file_bytes(font_guest_path)
    val font_validation = validate_selected_font_asset(font_candidate.local_path, font_blob)
    if not font_validation.valid:
        serial_println("[desktop-gui] fatal reason=font-evidence-asset")
        return
    serial_println("[desktop-gui] font registered source=fat32")

    # The generated Aetheric snapshot is the first-frame baseline. A boot-media
    # /THEME.CSS may then override only the six WM chrome tokens, after the VFS
    # mount has completed and before the compositor/frame executor exists.
    val theme_css = if g_vfs_mounted:
        g_vfs_read_file_text("/THEME.CSS")
    else:
        ""
    val theme_override_applied = if g_vfs_mounted:
        apply_simpleos_css_theme_override(theme_css)
    else:
        false
    serial_println("[theme-override] path=/THEME.CSS mount={g_vfs_mounted} bytes={theme_css.len()} applied={theme_override_applied}")

    # The freestanding kernel has no env, so keep selected-asset validation
    # on the native digest route before the shared desktop owner registers
    # every pinned face.
    font_registry_force_native_digest_route()
    val font_catalog_complete = simpleos_desktop_register_selected_fonts_from_vfs()
    val font_registered_count = simpleos_desktop_registered_font_count()
    val font_total_count = simpleos_desktop_selected_font_count()
    val font_failures: text = simpleos_desktop_font_failure_summary()
    # Readiness is the DEFAULT face, not the whole pinned corpus: the desktop
    # draws with the monospace default only, so a missing script-coverage face
    # must not force the bitmap fallback on a boot that loaded its font.
    val font_loaded = simpleos_desktop_default_font_registered()
    serial_println("[desktop-gui] font register accepted={font_loaded} catalog_complete={font_catalog_complete} registered={font_registered_count}/{font_total_count} unregistered={font_failures}")

    if vfs_mount_removable(1, "/media/sd0"):
        serial_println("[desktop-gui] removable mounted at /media/sd0")
    else:
        serial_println("[desktop-gui] no removable media found")

    pkg_service_init()
    serial_println("[desktop-gui] pkg service initialized")

    serial_println("[desktop-gui] initializing framebuffer...")
    val scanout = bga_init_scanout(framebuffer_width, framebuffer_height, framebuffer_bpp)
    val bga_pci = find_bga_pci_device()
    val bga_id = bga_device_id()
    val pci_decode = bga_pci_decode_is_enabled(bga_pci)
    serial_println("[scanout-evidence] address={scanout.address} width={scanout.width} height={scanout.height} stride={scanout.stride} pixel_format={scanout.pixel_format} generation={scanout.generation} device_id={bga_id} pci_found={bga_pci.found} pci_device={bga_pci.device} framebuffer_bar={bga_pci.framebuffer_bar} mmio_bar={bga_pci.mmio_bar} pci_decode={pci_decode}")
    if not scanout_evidence_is_valid(scanout):
        serial_println("[scanout-invalid] unsupported-or-incomplete-metadata")
        return
    rt_gui_set_fb(scanout.address, scanout.width.to_u64())
    _vram_mapping_probe(scanout.address as i64, vmm_kernel_pml4_phys() as i64)
    var fb = FramebufferDriver.from_scanout_raw(scanout.address, scanout.width, scanout.height, scanout.stride, framebuffer_bpp)
    val screen_width = scanout.width.to_i32()
    val screen_height = scanout.height.to_i32()
    val font_loaded = simpleos_desktop_register_selected_fonts_from_vfs()
    var engine = create_fb_engine_sized(fb, screen_width, screen_height)
    serial_println("[desktop-gui] framebuffer ready width={scanout.width} height={scanout.height} pitch={scanout.stride}")
    serial_println("[desktop-gui] engine2d-ready backend=baremetal-framebuffer persistent=true")

    var keyboard: Ps2Keyboard = Ps2Keyboard(
        shift_held: false,
        ctrl_held: false,
        alt_held: false,
        caps_lock: false
    )
    _keyboard_bootstrap_init()
    serial_println("[desktop-gui] keyboard ready")

    val initial_mouse_state = MouseState(
        x: fb.width.to_i64() / 2,
        y: fb.height.to_i64() / 2,
        left_button: false,
        right_button: false,
        middle_button: false,
        dx: 0,
        dy: 0,
        screen_width: fb.width.to_i64(),
        screen_height: fb.height.to_i64()
    )
    var mouse: Ps2Mouse = Ps2Mouse(
        state: initial_mouse_state,
        prev_left: false,
        prev_right: false,
        packet_byte0: 0,
        packet_byte1: 0,
        packet_byte2: 0,
        packet_index: 0,
        initialized: false
    )
    _mouse_bootstrap_init(mouse)
    serial_println("[desktop-gui] mouse ready")

    var compositor: Compositor = Compositor.new(fb, keyboard, mouse)
    serial_println("[desktop-gui] compositor ready")

    var shell: DesktopShell = DesktopShell.new(compositor)
    _shell_bootstrap_init(shell)

    val registered = launcher_get_app_count()
    serial_println("[desktop-gui] launcher apps={registered}")
    boot_monotonic_prepare()
    val host_gpu_base = map_qemu_host_gpu_ivshmem_bar2_active_vmm()
    val negotiation_started_us = boot_monotonic_now_us()
    # `backend_required: false` is passed EXPLICITLY, never left to its declared
    # default. Under native/baremetal codegen an omitted trailing default is NOT
    # materialized at all -- the callee reads an uninitialized register/stack
    # slot, which for this parameter came back `true` and flipped the x86_64 lane
    # from `host-gpu-fallback` to `host-gpu-required-rejected`. The gate's QEMU
    # cmdline has no ivshmem device, so a required host GPU can never be
    # satisfied there and the lane failed closed.
    # Compiler defect: doc/08_tracking/bug/native_trailing_default_param_reads_uninitialized_2026-08-09.md
    val wm_frame_executor = Engine2dWmFrameExecutor.create_host_gpu(engine, fb, host_gpu_base, SIMPLEOS_HOST_GPU_ISA_X86_64, SIMPLEOS_HOST_GPU_BACKEND_VULKAN, screen_width.to_i64(), screen_height.to_i64(), negotiation_started_us, baremetal_simd_fill_enabled(), false)
    # Paint the first desktop frame BEFORE announcing readiness: the evidence
    # wrapper captures its baseline immediately after the readiness markers,
    # and an unpainted scanout at that instant is an honest FAIL, not a race
    # to be excused.
    _dbg_vbe_readback("pre-first-frame")
    val first_frame_revision = shell.render_baremetal_first_frame(wm_frame_executor)
    _dbg_vbe_readback("post-first-frame")
    if first_frame_revision <= 0:
        serial_println("[production-readiness-failed] reason=simple2d-or-simple-web-frame-invalid")
        port_outb(0xF4, 1)
        return
    val simd_enabled = baremetal_simd_fill_enabled()
    val simd_hits = baremetal_simd_fill_hits()
    val simd_chunks = baremetal_simd_fill_chunks()
    val simd_tail_pixels = baremetal_simd_fill_tail_pixels()
    if not simd_enabled or simd_hits == 0 or simd_chunks == 0:
        serial_println("[engine2d-simd] fatal arch=x86_64 isa=sse2 reason=zero-runtime-receipt")
        port_outb(0xF4, 1)
        return
    serial_println("[engine2d-simd] arch=x86_64 isa=sse2 enabled=1 fill_hits={simd_hits} fill_chunks={simd_chunks} fill_tail_pixels={simd_tail_pixels}")
    if _probe_debug():
        val pb: u8 = 0x6Cu8
        val pm: u8 = 0x80u8
        val pt = (pb & pm) != 0u8
        val pt_num = if pt: 1 else: 0
        serial_println("[glyph-probe2] u8ne={pt_num}")
        val pbi = pb as i64
        val pmi = pm as i64
        val pti = (pbi & pmi) != 0
        val pti_num = if pti: 1 else: 0
        serial_println("[glyph-probe2] i64ne={pti_num}")
        val cc = "X".char_code_at(0)
        serial_println("[glyph-probe2] ccraw={cc} ccshl3={cc * 8}")

    val region_sha256 = _taskbar_clock_region_rgb_sha256(fb, screen_width, screen_height)
    val pinned_region_sha256: text = taskbar_clock_region_rgb_sha256_pin()
    if pinned_region_sha256.len() == 64 and region_sha256 == pinned_region_sha256:
        serial_println("[font-evidence] guest_path={font_guest_path} asset_bytes={font_blob.len()} family=Noto Sans Mono asset_sha256=2cb2adb378a8f574213e23df697050b83c54c27df465a2015552740b2769a081 raster=pure-sfnt-glyf route=shared-wm-draw-ir component_id=taskbar-clock font_size=12 text=00:00 region=right56,bottom48 region_rgb_sha256={region_sha256}")
    else:
        serial_println("[font-evidence-unavailable] reason=canonical-taskbar-clock-oracle-pending route=shared-wm-draw-ir component_id=taskbar-clock region=right56,bottom48 region_rgb_sha256={region_sha256}")
    serial_println("[desktop-gui] desktop-ready")

    shell.run_baremetal(wm_frame_executor)
    serial_println("[desktop-gui] shell exited")
