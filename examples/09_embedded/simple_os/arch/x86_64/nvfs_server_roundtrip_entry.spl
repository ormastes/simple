# x86_64 NVFS filesystem-server round-trip entry.
#
# The NVFS analogue of vfs_server_roundtrip_entry.spl (FAT32, green at 8/8).
# Proves that the SimpleOS VFS FILESYSTEM SERVER is actually RUNNING inside the
# guest ON AN NVFS VOLUME by pushing DATA through it and reading that same data
# back — not by printing a banner and not by observing that a path exists.
#
# Boot is OVMF pflash -> GRUB-EFI (a real EFI application) -> multiboot1 kernel.
# NEVER QEMU `-kernel`, NEVER isa-debug-exit: the point of the lane is that the
# same artifact could boot on hardware.
#
# WHY THIS DOES NOT CALL vfs_boot_init_production(). That function is the FAT32
# lane's entry and is fused to `_vfs_boot_init_pure_nvme_fat32`: it reads a
# FAT32 boot sector, a /VERSION.TXT probe and three FAT32 app slots, and only
# then publishes the storage handoff. On an NVFS volume every one of those
# probes fails, so it can never serve this lane. Worse, it sets
# `g_vfs_initialized`, and `vfs_nvfs_root_mount_stage_v1` refuses with
# `root-already-ready` when `vfs_is_ready()` — the two mounts cannot coexist in
# one boot. So the volume is a single NVFS drive and the bring-up is split:
#
#   vfs_boot_init_pure_nvme_device()        the filesystem-agnostic half —
#       PCI -> grant -> NVMe init -> transfer evidence -> system lease ->
#       block adapter -> bounce buffer -> backend binding -> production handoff.
#   boot_fs_mount_freestanding_production() the SAME production entry os_main
#       uses. It probes NVFS -> DBFS -> FAT32 on the provisioned lease device
#       and publishes whichever root it takes through the canonical
#       `boot_nvfs_root_mount_transaction_v1` / `vfs_nvfs_root_mount_commit_v1`
#       pair, which mounts `DriverInstance.Nvfs` at "/" in the VFS MountTable.
#
# So the round-trip below is served by the live hub, not by a probe-private
# driver handle: `g_vfs_write_file_text` / `g_vfs_read_file_text` are ordinary
# hub requests against the root that production mounting published. This entry
# never opens a driver of its own.
#
# THE fs-IDENTITY RUNG IS LOAD-BEARING. The production probe falls back to DBFS
# and then FAT32. A DBFS-fallback boot would move data through the hub perfectly
# well and prove nothing about NVFS, so the fs type is printed and the gate
# requires `fs-type=nvfs`.
#
# WHAT MAKES THE ROUND-TRIP HONEST:
#   * The NVMe volume is a freshly staged NVFS volume (NVFS superblock replicas
#     at LBA 0-1, DBFS backing superblock at LBA 2-3, DBFS arena from LBA 4 —
#     the exact constants boot_nvfs_root_mount_transaction_v1 reads), asserted
#     before boot to contain neither this run's nonce nor /NVFSRT.TXT.
#   * The payload is a PER-RUN NONCE generated into
#     build/os/nvfsrt/generated/nvfs_roundtrip_nonce.spl at build time. A stale kernel
#     or stale disk image carries a stale nonce and CANNOT satisfy the gate.
#   * After the guest halts, the gate searches the raw NVMe image ON THE HOST
#     for the nonce bytes — an independent FILESYSTEM CHECK outside the guest.
#
# DELIBERATELY MINIMAL IMPORT SET, for the same reasons the FAT32 entry
# documents: the dbd apps fail codegen under strict mode, and
# SIMPLE_ALLOW_STUB_FALLBACK is never set here — a round-trip "proved" by a
# silently-stubbed binary is exactly the fabricated evidence this lane exists
# to rule out.

use build.os.nvfsrt.generated.nvfs_roundtrip_nonce.{nvfs_roundtrip_nonce}
use os.services.vfs.vfs_boot_state.{vfs_boot_init_pure_nvme_device, vfs_is_ready}
use os.kernel.boot.boot_fs_mount.{
    boot_fs_mount_freestanding_production, fs_mount_type, FsMountType
}
use os.services.vfs.vfs_init.{
    g_vfs_read_file_text, g_vfs_write_file_text, g_vfs_file_exists
}

extern fn serial_println(msg: text)

val NVFSRT_PATH: text = "/NVFSRT.TXT"

fn _nvfsrt_fs_type_name(kind: FsMountType) -> text:
    match kind:
        case Nvfs: "nvfs"
        case Dbfs: "dbfs"
        case Fat32: "fat32"
        case None_: "none"

fn _start():
    serial_println("")
    serial_println("=== SimpleOS NVFS filesystem-server round-trip probe ===")
    val nonce = nvfs_roundtrip_nonce()
    serial_println("[nvfsrt] probe begin nonce={nonce}")

    # --- bring the NVMe lease device up (no filesystem yet) -----------------
    # Render bools EXPLICITLY. `"{flag}"` renders a Simple bool as `1`/`0`, not
    # `true`/`false`, which silently missed the FAT32 gate's needle on a fully
    # successful run. Do NOT relax the gate's needles instead — its selftest
    # fixtures are written in true/false and must stay that way.
    val nvme_ok = vfs_boot_init_pure_nvme_device()
    serial_println("[nvfsrt] nvme bring-up ok=" + (if nvme_ok: "true" else: "false"))
    if not nvme_ok:
        serial_println("[nvfsrt] PROBE FAILED: pure-Simple NVMe device did not come up")
        return ()

    # --- production root mount (NVFS -> DBFS -> FAT32 probe order) ----------
    val mount_r = boot_fs_mount_freestanding_production()
    if mount_r.is_err():
        serial_println("[nvfsrt] production mount ok=false err=" + mount_r.unwrap_err())
        serial_println("[nvfsrt] PROBE FAILED: production mount refused the volume")
        return ()
    serial_println("[nvfsrt] production mount ok=true")
    val fs_name = _nvfsrt_fs_type_name(fs_mount_type())
    serial_println("[nvfsrt] fs-type=" + fs_name)
    if fs_name != "nvfs":
        serial_println("[nvfsrt] PROBE FAILED: root was taken by " + fs_name + ", not NVFS")
        return ()

    if not vfs_is_ready():
        serial_println("[nvfsrt] PROBE FAILED: vfs not ready after NVFS root mount")
        return ()
    serial_println("[nvfsrt] fs-server up ready=true")

    # --- the round-trip: DATA through the server ---------------------------
    val payload = "nvfsrt-nonce:{nonce}"
    serial_println("[nvfsrt] server write begin path={NVFSRT_PATH} bytes={payload.len()}")
    val wrote = g_vfs_write_file_text(NVFSRT_PATH, payload)
    serial_println("[nvfsrt] server write path=" + NVFSRT_PATH + " ok=" + (if wrote: "true" else: "false"))
    if not wrote:
        serial_println("[nvfsrt] PROBE FAILED: server refused the write")
        return ()

    val exists = g_vfs_file_exists(NVFSRT_PATH)
    serial_println("[nvfsrt] server stat exists=" + (if exists: "true" else: "false"))

    val got = g_vfs_read_file_text(NVFSRT_PATH)
    serial_println("[nvfsrt] server read-back={got}")
    if got != payload:
        serial_println("[nvfsrt] PROBE FAILED: read-back differs from write")
        return ()
    serial_println("[nvfsrt] ROUNDTRIP_OK nonce={nonce}")
    serial_println("[nvfsrt] probe complete")

    while true:
        ()

export _start
