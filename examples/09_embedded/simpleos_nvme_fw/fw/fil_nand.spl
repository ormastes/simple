"""
fil_nand — simulated NAND flash array (lowest-level FIL layer).
Depends only on nvme_types and the ECC utility used for OOB parity.
"""

use nvme_types.*
use nvme_payload.*
use fil_ecc.*

fn nand_erase_counter_next(v: i64) -> i64:
    if v < 0:
        return 1
    if v >= FW_SAFE_I64_LIMIT:
        return FW_SAFE_I64_LIMIT
    v + 1

# ── NandRead: result returned by read_page ────────────────────────────────────
struct NandRead:
    data: i64
    lba:  i64
    seq:  i64
    ecc:  i64
    err:  i64

# ── Nand: the full simulated NAND device ──────────────────────────────────────
struct Nand:
    page:       [PageData] # length NUM_PAGES, the REAL page main area
                           # (PAGE_WORDS words = PAGE_BYTES). D3 of the payload
                           # plan: media storage is a full page, no longer one
                           # i64 stand-in. The i64-signature methods below are
                           # unchanged for callers and bridge through the
                           # a residual word-0 derivation; page-wide entry
                           # points (program_page/read_page_data/corrupt_page)
                           # exist for D4/D5 to adopt.
    oob:        [OobData]  # length NUM_PAGES, spare area {lba, seq, parity, meta}.
                           # D2 of the payload plan: this ONE array replaces the
                           # former parallel oob_lba/oob_seq/oob_ecc triple. ECC
                           # is still the single scalar fil_ecc computes today,
                           # held in parity[0]; D4 widens it per codeword.
    page_err:   [i64]   # length NUM_PAGES, injected bit-flip count (0 normally)
    blk_state:  [i64]   # length NUM_BLOCKS, BLK_FREE/OPEN/CLOSED/BAD
    blk_erase:  [i64]   # length NUM_BLOCKS, cumulative erase count
    blk_wp:     [i64]   # length NUM_BLOCKS, write pointer (0..PAGES_PER_BLOCK)
    prog_fail:  [i64]   # length NUM_BLOCKS, 1 = next program to this block fails
    erase_fail: [i64]   # length NUM_BLOCKS, 1 = next erase of this block fails

fn nand_new() -> Nand:
    var page:       [PageData] = []
    var oob:        [OobData] = []
    var page_err:   [i64] = []
    var blk_state:  [i64] = []
    var blk_erase:  [i64] = []
    var blk_wp:     [i64] = []
    var prog_fail:  [i64] = []
    var erase_fail: [i64] = []

    var i: i64 = 0
    while i < NUM_PAGES:
        page.push(page_zero())
        oob.push(oob_erased())
        page_err.push(0)
        i = i + 1

    i = 0
    while i < NUM_BLOCKS:
        blk_state.push(BLK_FREE)
        blk_erase.push(0)
        blk_wp.push(0)
        prog_fail.push(0)
        erase_fail.push(0)
        i = i + 1

    Nand(page: page, oob: oob, page_err: page_err, blk_state: blk_state, blk_erase: blk_erase, blk_wp: blk_wp, prog_fail: prog_fail, erase_fail: erase_fail)

impl Nand:
    me page_ready(ppn: i64) -> bool:
        ppn_in_range(ppn) and ppn < me.page.len() and ppn < me.oob.len() and ppn < me.page_err.len()

    me block_ready(blk: i64) -> bool:
        block_in_range(blk) and blk < me.blk_state.len() and blk < me.blk_erase.len() and blk < me.blk_wp.len() and blk < me.prog_fail.len() and blk < me.erase_fail.len()

    me block_pages_ready(blk: i64) -> bool:
        me.block_ready(blk) and block_first_ppn(blk) + PAGES_PER_BLOCK <= me.page.len() and block_first_ppn(blk) + PAGES_PER_BLOCK <= me.oob.len() and block_first_ppn(blk) + PAGES_PER_BLOCK <= me.page_err.len()

    # Word-wide entry point kept for every layer above D3, which still speaks
    # i64. D11 deleted the shared narrowing shim, so the word-0 derivation is
    # written out here at the scalar seam that needs it.
    me program(ppn: i64, lba: i64, seq: i64, data: i64) -> i64:
        var p: PageData = page_zero()
        p.words[0] = data
        me.program_page(ppn, lba, seq, p)

    me program_page(ppn: i64, lba: i64, seq: i64, data: PageData) -> i64:
        if not me.page_ready(ppn):
            return NAND_BAD_BLOCK
        val blk: i64 = ppn_block(ppn)
        if not me.block_ready(blk):
            return NAND_BAD_BLOCK
        if me.blk_state[blk] == BLK_BAD:
            return NAND_BAD_BLOCK
        if me.prog_fail[blk] != 0:
            me.prog_fail[blk] = 0
            return NAND_PROG_FAIL
        if me.oob[ppn].lba != UNMAP:
            return NAND_PROG_FAIL
        me.page[ppn] = data
        # Mutate the spare area through its single owner (me.oob[ppn].<field>);
        # binding a temporary OobData and writing it back would deep-copy under
        # value semantics.
        me.oob[ppn].lba = lba
        me.oob[ppn].seq = seq
        # D4: slot 0 stays the legacy scalar (NandRead.ecc / FmcResult.ecc are
        # i64 and their owning files are frozen for this workstream); slots
        # 1..CODEWORDS_PER_PAGE carry the REAL per-codeword SEC-DED parity over
        # all 512 page words. Written through the single owner me.oob[ppn].
        # ECC is still the scalar fil_ecc computes over word 0; D4 widens it to
        # per-codeword parity over the whole page.
        me.oob[ppn].parity[0] = ecc_compute(page_word(data, 0), lba, seq)
        val cwp: [i64] = ecc_page_compute(data, lba, seq)
        var ci: i64 = 0
        while ci < CODEWORDS_PER_PAGE:
            me.oob[ppn].parity[1 + ci] = cwp[ci]
            ci = ci + 1
        me.blk_state[blk] = BLK_OPEN
        NAND_OK

    me read_page(ppn: i64) -> NandRead:
        if not me.page_ready(ppn):
            return NandRead(data: 0, lba: UNMAP, seq: 0, ecc: 0, err: 2)
        var err: i64 = me.page_err[ppn]
        if err < 0:
            err = 0
        NandRead(data: page_word(me.page[ppn], 0), lba: me.oob[ppn].lba, seq: me.oob[ppn].seq, ecc: me.oob[ppn].parity[0], err: err)

    me erase_block(blk: i64) -> i64:
        if not me.block_pages_ready(blk):
            return NAND_BAD_BLOCK
        if me.blk_state[blk] == BLK_BAD:
            return NAND_BAD_BLOCK
        if me.erase_fail[blk] != 0:
            me.erase_fail[blk] = 0
            return NAND_ERASE_FAIL
        val first: i64 = block_first_ppn(blk)
        var pg: i64 = 0
        while pg < PAGES_PER_BLOCK:
            var ppn: i64 = first + pg
            me.page[ppn] = page_zero()
            me.oob[ppn] = oob_erased()
            me.page_err[ppn] = 0
            pg = pg + 1
        me.blk_erase[blk] = nand_erase_counter_next(me.blk_erase[blk])
        me.blk_wp[blk] = 0
        me.blk_state[blk] = BLK_FREE
        NAND_OK

    me erase_count(blk: i64) -> i64:
        if not me.block_ready(blk):
            return 0
        if me.blk_erase[blk] < 0:
            return 0
        if me.blk_erase[blk] > FW_SAFE_I64_LIMIT:
            return FW_SAFE_I64_LIMIT
        me.blk_erase[blk]

    me inject_prog_fail(blk: i64):
        if not me.block_ready(blk):
            return
        me.prog_fail[blk] = 1

    me inject_erase_fail(blk: i64):
        if not me.block_ready(blk):
            return
        me.erase_fail[blk] = 1

    me inject_read_bitflip(ppn: i64, n: i64):
        if not me.page_ready(ppn):
            return
        if n < 0:
            me.page_err[ppn] = 0
            return
        me.page_err[ppn] = n

    # Read the full page main area (D4/D5 adopt this; today's callers read the
    # word through read_page).
    # The per-codeword parity slots (OobData.parity[1..CODEWORDS_PER_PAGE]) for
    # one page. Separate from read_page() because NandRead.ecc is a scalar i64
    # and its constructor sites live in fil_nand_emu.spl, which this workstream
    # may not edit — widening NandRead is DEBT WITH AN OWNER (the FMC/emu owner).
    # Returns an empty list for a page that is not ready, so a caller cannot
    # mistake "no parity" for "parity of zero".
    me read_page_parity(ppn: i64) -> [i64]:
        var out: [i64] = []
        if not me.page_ready(ppn):
            return out
        var i: i64 = 0
        while i < CODEWORDS_PER_PAGE:
            if 1 + i < me.oob[ppn].parity.len():
                out.push(me.oob[ppn].parity[1 + i])
            i = i + 1
        out

    # Overwrite ONE page word, leaving OOB (and therefore the stored parity)
    # untouched — the widened sibling of corrupt_page_data, which can only reach
    # word 0. This is what lets a check corrupt codeword 3.
    me corrupt_page_word(ppn: i64, widx: i64, v: i64):
        if not me.page_ready(ppn):
            return
        if widx < 0:
            return
        if widx >= me.page[ppn].words.len():
            return
        me.page[ppn].words[widx] = v

    me read_page_data(ppn: i64) -> PageData:
        if not me.page_ready(ppn):
            return page_zero()
        me.page[ppn]

    me corrupt_page_data(ppn: i64, data: i64):
        # Residual word-0 derivation at the legacy scalar entry point (D11).
        var p: PageData = page_zero()
        p.words[0] = data
        me.corrupt_page(ppn, p)

    me corrupt_page(ppn: i64, data: PageData):
        if not me.page_ready(ppn):
            return
        me.page[ppn] = data

    me set_bad(blk: i64):
        if not me.block_ready(blk):
            return
        me.blk_state[blk] = BLK_BAD

# ── Self-test ─────────────────────────────────────────────────────────────────
fn nand_selftest() -> i64:
    var failures: i64 = 0
    var nand = nand_new()

    # program page at block_first_ppn(1)+0, then read it back
    val ppn0: i64 = block_first_ppn(1)
    var rc: i64 = nand.program(ppn0, 10, 5, 0xAB)
    failures = failures + expect_eq(rc, NAND_OK, "program returns NAND_OK")

    var r0: NandRead = nand.read_page(ppn0)
    failures = failures + expect_eq(r0.data, 0xAB, "read data==0xAB")
    failures = failures + expect_eq(r0.lba, 10, "read lba==10")
    failures = failures + expect_eq(r0.seq, 5, "read seq==5")
    failures = failures + expect_eq(r0.ecc, ecc_compute(0xAB, 10, 5), "read stored ecc")
    failures = failures + expect_eq(r0.err, 0, "read err==0")
    rc = nand.program(ppn0, 11, 6, 0xBC)
    failures = failures + expect_eq(rc, NAND_PROG_FAIL, "no-overwrite fails closed")
    failures = failures + expect_eq(nand.read_page(ppn0).data, 0xAB, "no-overwrite preserves data")

    # block 0 was never erased
    var ec0: i64 = nand.erase_count(0)
    failures = failures + expect_eq(ec0, 0, "erase_count(0)==0")

    # erase block 1
    rc = nand.erase_block(1)
    failures = failures + expect_eq(rc, NAND_OK, "erase_block returns NAND_OK")

    var r1: NandRead = nand.read_page(ppn0)
    failures = failures + expect_eq(r1.lba, UNMAP, "post-erase oob_lba==UNMAP")
    failures = failures + expect_eq(r1.ecc, 0, "post-erase ecc cleared")

    var ec1: i64 = nand.erase_count(1)
    failures = failures + expect_eq(ec1, 1, "erase_count(1)==1")

    # inject_prog_fail -> next program to block 1 returns NAND_PROG_FAIL
    nand.inject_prog_fail(1)
    rc = nand.program(ppn0, 99, 1, 0xFF)
    failures = failures + expect_eq(rc, NAND_PROG_FAIL, "prog_fail hook")
    nand.prog_fail[4] = 7
    val ppn4: i64 = block_first_ppn(4)
    failures = failures + expect_eq(nand.program(ppn4, 44, 4, 0x44), NAND_PROG_FAIL, "corrupted nonzero program fault fails once")
    failures = failures + expect_eq(nand.program(ppn4, 44, 4, 0x44), NAND_OK, "corrupted program fault clears after one failure")
    nand.erase_fail[5] = 7
    failures = failures + expect_eq(nand.erase_block(5), NAND_ERASE_FAIL, "corrupted nonzero erase fault fails once")
    failures = failures + expect_eq(nand.erase_block(5), NAND_OK, "corrupted erase fault clears after one failure")

    # set_bad(2) -> program into block 2 returns NAND_BAD_BLOCK
    nand.set_bad(2)
    val ppn2: i64 = block_first_ppn(2)
    rc = nand.program(ppn2, 42, 3, 0xCD)
    failures = failures + expect_eq(rc, NAND_BAD_BLOCK, "bad block hook")

    # inject_read_bitflip -> err field == injected count
    nand.inject_read_bitflip(0, 3)
    var r2: NandRead = nand.read_page(0)
    failures = failures + expect_eq(r2.err, 3, "bitflip err==3")
    nand.inject_read_bitflip(0, -1)
    failures = failures + expect_eq(nand.read_page(0).err, 0, "negative bitflip injection clamps to zero")
    nand.page_err[0] = -7
    failures = failures + expect_eq(nand.read_page(0).err, 0, "corrupted negative read error clamps to zero")
    nand.blk_erase[1] = -5
    failures = failures + expect_eq(nand.erase_count(1), 0, "corrupted negative erase count clamps to zero")
    failures = failures + expect_eq(nand.erase_block(1), NAND_OK, "erase recovers corrupted negative erase count")
    failures = failures + expect_eq(nand.erase_count(1), 1, "erase count recovers from corrupted negative value")
    nand.blk_erase[1] = FW_OVERFLOW_TEST_SIZE + 1
    failures = failures + expect_eq(nand.erase_count(1), FW_SAFE_I64_LIMIT, "corrupted oversized erase count saturates")
    failures = failures + expect_eq(nand.erase_block(1), NAND_OK, "erase still succeeds with saturated erase count")
    failures = failures + expect_eq(nand.erase_count(1), FW_SAFE_I64_LIMIT, "erase count remains saturated after oversized value")

    val ppn3: i64 = block_first_ppn(3)
    rc = nand.program(ppn3, 42, 3, 0xCD)
    failures = failures + expect_eq(rc, NAND_OK, "program corruption-test page")
    nand.corrupt_page_data(ppn3, 0xCE)
    val r3: NandRead = nand.read_page(ppn3)
    failures = failures + expect_eq(r3.data, 0xCE, "corrupt_page_data changes payload")
    failures = failures + expect_eq(r3.ecc, ecc_compute(0xCD, 42, 3), "corrupt_page_data preserves stored ecc")
    failures = failures + expect_eq(nand.program(NUM_PAGES, 1, 1, 1), NAND_BAD_BLOCK, "out-of-range program fails closed")
    failures = failures + expect_eq(nand.read_page(NUM_PAGES).err, 2, "out-of-range read reports uncorrectable")
    failures = failures + expect_eq(nand.erase_block(NUM_BLOCKS), NAND_BAD_BLOCK, "out-of-range erase fails closed")
    failures = failures + expect_eq(nand.erase_count(NUM_BLOCKS), 0, "out-of-range erase count is inert")

    # ── D3 non-vacuity: the media stores a REAL page, not a word ──────────────
    # Every assertion above passes through word 0 and so would still pass on the
    # old one-i64-per-page media. These drive the page-wide seam directly and
    # fail on any stand-in that keeps only the first word.
    val ppn_w: i64 = block_first_ppn(5)
    var wide = page_zero()
    wide.words[0] = 0x11
    wide.words[1] = 0x22
    wide.words[PAGE_WORDS - 1] = 0x33
    failures = failures + expect_eq(nand.program_page(ppn_w, 77, 9, wide), NAND_OK, "program_page returns NAND_OK")
    var back: PageData = nand.read_page_data(ppn_w)
    failures = failures + expect_eq(page_word_count(back), PAGE_WORDS, "stored page is PAGE_WORDS wide")
    failures = failures + expect_eq(page_word(back, 0), 0x11, "page word 0 round-trips")
    failures = failures + expect_eq(page_word(back, 1), 0x22, "page word 1 round-trips (a word the old stand-in DROPPED)")
    failures = failures + expect_eq(page_word(back, PAGE_WORDS - 1), 0x33, "page LAST word round-trips")
    failures = failures + expect_eq(page_word(back, 2), 0, "unwritten interior word reads 0")
    failures = failures + expect_eq(bool_to_int(page_eq(back, wide)), 1, "whole page compares equal to what was programmed")
    # The narrow seam still sees word 0, so the layers above D3 are unaffected.
    failures = failures + expect_eq(nand.read_page(ppn_w).data, 0x11, "narrow read_page still yields word 0 for un-migrated callers")
    failures = failures + expect_eq(nand.read_page(ppn_w).lba, 77, "page-wide program still writes the OOB lba")
    # Erase must clear the WHOLE page, not just word 0.
    failures = failures + expect_eq(nand.erase_block(5), NAND_OK, "erase the page-wide test block")
    var cleared: PageData = nand.read_page_data(ppn_w)
    failures = failures + expect_eq(page_word(cleared, 0), 0, "erase clears word 0")
    failures = failures + expect_eq(page_word(cleared, PAGE_WORDS - 1), 0, "erase clears the LAST word too")

    var nt = nand_new()
    nt.page = []
    failures = failures + expect_eq(nt.program(0, 1, 1, 1), NAND_BAD_BLOCK, "truncated NAND page array program fails closed")
    failures = failures + expect_eq(nt.read_page(0).err, 2, "truncated NAND page array read reports uncorrectable")
    failures = failures + expect_eq(nt.erase_block(0), NAND_BAD_BLOCK, "truncated NAND page array erase fails closed")
    nt = nand_new()
    nt.blk_state = []
    failures = failures + expect_eq(nt.program(0, 1, 1, 1), NAND_BAD_BLOCK, "truncated NAND block metadata program fails closed")
    failures = failures + expect_eq(nt.erase_count(0), 0, "truncated NAND block metadata erase count is inert")
    failures = failures + expect_eq(nt.erase_block(0), NAND_BAD_BLOCK, "truncated NAND block metadata erase fails closed")

    failures
