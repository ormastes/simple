# nvme_transport_profiles.sdn — host-equivalent NVMe transport CONFIG seam.
#
# This file is the ONLY thing that differs between emulation and a real board.
# The host driver source (nvme_host_driver.spl) and every test written against
# it are byte-identical across profiles.
#
# Read by fw/nvme_transport_config.spl. The path is resolved relative to the
# REPO ROOT, which is where `bin/simple run` is invoked from.
# ASCII only: the reader scans bytes.

profiles:
  emu:
    backend: emu
    bar_base: 0
    sq_base: 0
    cq_base: 4096
    doorbell_base: 8192
    doorbell_stride: 4
    reg_base: 8208
    queue_depth: 64
    mem_size: 8272
    bound: 1
  board:
    backend: board
    bar_base: 4009754624
    sq_base: 2147483648
    cq_base: 2147487744
    doorbell_base: 4009758720
    doorbell_stride: 4
    reg_base: 4009754624
    queue_depth: 64
    mem_size: 8272
    bound: 0

# ── Admin-transport pair (fw/admin_transport.spl) ─────────────────────────────
# Two profiles, ONE shared memory array. Disjoint queue regions and disjoint
# doorbell dwords in the same doorbell page, exactly like a real controller's
# BAR: qid 0 is the admin pair, qid 1 the first I/O pair.
#   ASQ  0..4095      (64 x 64 B)     admin SQ0TDBL @ 16384
#   ACQ  4096..5119   (64 x 16 B)     admin CQ0HDBL @ 16388
#   IOSQ 8192..12287  (64 x 64 B)     I/O   SQ1TDBL @ 16392
#   IOCQ 12288..13311 (64 x 16 B)     I/O   CQ1HDBL @ 16396
  admin_emu:
    backend: emu
    bar_base: 0
    sq_base: 0
    cq_base: 4096
    doorbell_base: 16384
    doorbell_stride: 4
    queue_depth: 64
    mem_size: 16400
    bound: 1
  admin_emu_io:
    backend: emu
    bar_base: 0
    sq_base: 8192
    cq_base: 12288
    doorbell_base: 16392
    doorbell_stride: 4
    queue_depth: 64
    mem_size: 16400
    bound: 1
