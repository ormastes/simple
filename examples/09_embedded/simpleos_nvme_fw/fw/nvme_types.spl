"""
nvme_types — shared frozen interface for the SimpleOS NVMe firmware (simulation).

Pure data + constants + small free helpers. NO `impl`/`me` methods here, so this
module is cheap to type-check and safe to import everywhere. Every HIL/FTL/FIL
module builds against these names; do not rename without an interface re-lock.

Geometry (tiny, for fast host-runnable simulation):
  planes=4 x blocks/plane=16 x pages/block=64  => 4096 physical pages.
  One i64 "data" byte per page stands in for a real 4 KiB page payload.
"""

use nvme_payload.*   # PageData and the page-wide primitives (leaf, no cycle)

# ── NVMe I/O opcodes ──────────────────────────────────────────────────────────
val OP_FLUSH:       i64 = 0x00
val OP_WRITE:       i64 = 0x01
val OP_READ:        i64 = 0x02
val OP_WRITE_ZERO:  i64 = 0x08
val OP_DSM_TRIM:    i64 = 0x09

# ── NVMe status codes (SC, generic command set) ───────────────────────────────
val SC_SUCCESS:        i64 = 0x00
val SC_INVALID_OPCODE: i64 = 0x01   # command opcode not supported
val SC_INVALID_FIELD:  i64 = 0x02   # a reserved/illegal field value
val SC_INTERNAL:       i64 = 0x06
val SC_LBA_RANGE:      i64 = 0x80
val SC_NS_NOT_READY:   i64 = 0x82
val SC_MEDIA_ERR:      i64 = 0x281   # unrecovered read error (ECC exhausted)

# ── Sentinels ─────────────────────────────────────────────────────────────────
# Index-handle law (see PRODUCTION_STATUS.md "Index-handle law"): every
# NULL/invalid-index case is a NAMED constant, never a bare -1. Vocabulary:
#   UNMAP     — unmapped L2P entry / invalid ppn (FTL map + block-alloc domain)
#   NO_PPN    — invalid physical page number (alias of UNMAP for ppn returns)
#   NULL_IDX  — generic invalid index/handle (pool handles, queue/cid/sqid
#               "none" fields, not-found search results) outside the L2P/ppn
#               domain above. Same value as UNMAP (kept a literal, not a
#               val-to-val alias, to match UNMAP/NO_PPN's own convention).
val UNMAP: i64 = -1      # unmapped L2P entry / invalid ppn
val NO_PPN: i64 = -1
val NULL_IDX: i64 = -1   # generic invalid-index / null-handle sentinel

# ── Device geometry ───────────────────────────────────────────────────────────
val NUM_PLANES:      i64 = 4
val BLOCKS_PER_PLANE: i64 = 16
val PAGES_PER_BLOCK: i64 = 64
val NUM_BLOCKS:      i64 = 64     # NUM_PLANES * BLOCKS_PER_PLANE
val NUM_PAGES:       i64 = 4096   # NUM_BLOCKS * PAGES_PER_BLOCK
val LBA_COUNT:       i64 = 3072   # surfaced LBAs (~75%, rest = over-provision)
val GC_RESERVE:      i64 = 2      # free blocks the host write path never consumes —
                                  # held as GC scratch so collection always makes progress
val WL_THRESHOLD:    i64 = 2      # static wear-leveling fires when max-min erase spread exceeds this
val READ_DISTURB_THRESHOLD: i64 = 50  # reads on one block before a read-disturb scrub
val FW_SAFE_I64_LIMIT: i64 = 1000000000000000000
val FW_OVERFLOW_TEST_SIZE: i64 = 1000000000000000000

# ── NAND op outcome codes (FIL -> caller) ─────────────────────────────────────
val NAND_OK:        i64 = 0
val NAND_ECC_FIXED: i64 = 1   # data returned, but bit error was corrected
val NAND_ECC_FAIL:  i64 = 2   # uncorrectable read
val NAND_PROG_FAIL: i64 = 3   # program failure (retire block)
val NAND_ERASE_FAIL: i64 = 4  # erase failure (retire block)
val NAND_BAD_BLOCK: i64 = 5   # target block is retired

# ── Block lifecycle states ────────────────────────────────────────────────────
val BLK_FREE:    i64 = 0
val BLK_OPEN:    i64 = 1   # currently being written (the active band)
val BLK_CLOSED:  i64 = 2   # full, holds valid+stale data
val BLK_BAD:     i64 = 3   # retired

# ── Write-task cooperative phases (state machine, held in task context) ───────
val PH_INIT:      i64 = 0
val PH_ALLOC:     i64 = 1   # pick physical page from active band
val PH_PROGRAM:   i64 = 2   # FIL program
val PH_JOURNAL:   i64 = 3   # append WAL record
val PH_UPDATE:    i64 = 4   # update L2P + valid bitmap
val PH_COMPLETE:  i64 = 5   # post CQ completion
val PH_DONE:      i64 = 6

# ── Object-pool generation handle (index-pointer, not a raw pointer) ──────────
struct Handle:
    pool:       i64
    index:      i64
    generation: i64

fn handle_invalid() -> Handle:
    Handle(pool: NULL_IDX, index: NULL_IDX, generation: NULL_IDX)

fn handle_is_valid(h: Handle) -> bool:
    h.index >= 0

# ── A decoded host NVMe command ───────────────────────────────────────────────
# PAYLOAD vs ADDRESSING — the two meanings `data` used to carry at once.
#
# `data` was overloaded: it was BOTH the one-word payload stand-in AND (via
# hil_command's `prp_pack`) a packed pair of host-buffer base bytes. Those are
# now separate fields. `prp1`/`prp2` are the authoritative PRP descriptor and
# NOTHING below this constructor re-decodes `data` as an address any more; the
# legacy `prp_pack` encoding is unpacked EXACTLY ONCE, here, and `prp_pack`
# itself is scheduled for deletion with the shim in D11.
#
# `page` is the real 4096-byte payload. `has_page` says which of `data`/`page`
# the host actually supplied, so a page whose word 0 exceeds one byte is not
# silently truncated by the legacy byte path.
struct NvmeCmd:
    cid:      i64   # command id
    nsid:     i64   # namespace id (single namespace model: 1)
    opcode:   i64
    lba:      i64
    nblocks:  i64
    data:     i64      # legacy one-word payload / word-0 view of `page`
    page:     PageData # block 0 of the payload — a COMPAT VIEW of pages[0]
    pages:    [PageData] # the REAL host buffer: one page per block, length nblocks
    has_page: bool     # true => `page`/`pages` are authoritative, not `data`
    prp1:     i64      # host-buffer base (first PRP entry) — ADDRESSING, not payload
    prp2:     i64      # second PRP entry / list base

fn cmd_make(cid: i64, opcode: i64, lba: i64, nblocks: i64, data: i64) -> NvmeCmd:
    cmd_make_nsid(cid, 1, opcode, lba, nblocks, data)

fn cmd_make_nsid(cid: i64, nsid: i64, opcode: i64, lba: i64, nblocks: i64, data: i64) -> NvmeCmd:
    var none: [PageData] = []
    # Residual word-0 derivation at the legacy scalar constructor (D11 deleted
    # the shared narrowing shim this used to call).
    var p0: PageData = page_zero()
    p0.words[0] = data
    NvmeCmd(cid: cid, nsid: nsid, opcode: opcode, lba: lba, nblocks: nblocks, data: data,
            page: p0, pages: none, has_page: false,
            prp1: data & 0xFF, prp2: (data >> 8) & 0xFF)

# Page-carrying host command — the widened seam (`data` stays the word-0 view).
fn cmd_make_page(cid: i64, opcode: i64, lba: i64, nblocks: i64, page: PageData) -> NvmeCmd:
    var one: [PageData] = []
    one.push(page)
    cmd_make_pages(cid, opcode, lba, nblocks, one)

# MULTI-BLOCK host command: one page per logical block.
#
# `pages.len()` is the host buffer's real width. `nblocks` is what the command
# asks the controller to transfer; they are kept as SEPARATE facts rather than
# derived from one another, because "the host described N blocks but supplied
# fewer pages" is a real malformed-command case the controller must be able to
# see. `page` stays the block-0 compat view so every pre-existing reader keeps
# working unchanged.
fn cmd_make_pages(cid: i64, opcode: i64, lba: i64, nblocks: i64, pages: [PageData]) -> NvmeCmd:
    var w0: i64 = 0
    if pages.len() > 0:
        w0 = page_word(pages[0], 0)
    var p0: PageData = page_zero()
    if pages.len() > 0:
        p0 = pages[0]
    NvmeCmd(cid: cid, nsid: 1, opcode: opcode, lba: lba, nblocks: nblocks,
            data: w0, page: p0, pages: pages, has_page: pages.len() > 0,
            prp1: w0 & 0xFF, prp2: 0)

# Explicit PRP descriptor, no payload — the non-overloaded replacement for
# `cmd_make(..., prp_pack(a, b))`.
fn cmd_make_prp(cid: i64, opcode: i64, lba: i64, nblocks: i64, base1: i64, base2: i64) -> NvmeCmd:
    var none: [PageData] = []
    NvmeCmd(cid: cid, nsid: 1, opcode: opcode, lba: lba, nblocks: nblocks, data: 0,
            page: page_zero(), pages: none, has_page: false, prp1: base1 & 0xFF, prp2: base2 & 0xFF)

"""The host page for block `i`, or a zero page when the host supplied none."""
fn cmd_page_at(c: NvmeCmd, i: i64) -> PageData:
    if i < 0 or i >= c.pages.len():
        return page_zero()
    c.pages[i]

"""True when the host buffer is wide enough for every block the command asks for."""
fn cmd_pages_cover_blocks(c: NvmeCmd) -> bool:
    if not c.has_page:
        return false
    c.pages.len() >= c.nblocks

# True iff the host supplied NO payload with this command. Replaces the bare
# `c.data != 0` tests, which are blind to a page-carrying command.
fn cmd_payload_empty(c: NvmeCmd) -> bool:
    c.data == 0 and not c.has_page

fn cid_valid(cid: i64) -> bool:
    cid >= 0 and cid <= 65535

# ── A completion-queue entry ──────────────────────────────────────────────────
struct NvmeCpl:
    cid:    i64
    status: i64
    data:   i64      # word-0 view of `page` — never independent of it
    page:   PageData # block 0 of the result — a COMPAT VIEW of pages[0]
    pages:  [PageData] # the REAL result buffer: one page per block TRANSFERRED

fn cpl_make(cid: i64, status: i64, data: i64) -> NvmeCpl:
    # Residual word-0 derivation at the legacy scalar constructor (D11 deleted
    # the shared narrowing shim this used to call). `page` and `pages[0]` are
    # built as SEPARATE pages, not one value stored twice: on the default JIT
    # lane a struct field and an array element that share a PageData alias the
    # same interior words array, so a later repair through one would silently
    # mutate the other.
    var p0: PageData = page_zero()
    p0.words[0] = data
    var p1: PageData = page_zero()
    p1.words[0] = data
    var one: [PageData] = []
    one.push(p1)
    NvmeCpl(cid: cid, status: status, data: data, page: p0, pages: one)

# Page-carrying completion — the widened seam.
fn cpl_make_page(cid: i64, status: i64, page: PageData) -> NvmeCpl:
    var one: [PageData] = []
    one.push(page)
    cpl_make_pages(cid, status, one)

# MULTI-BLOCK completion.
#
# `pages` holds exactly the blocks the controller actually TRANSFERRED. On a
# partial failure that is SHORTER than the command's nblocks, and `status` is
# the failing block's status — the completion never claims success for a
# transfer it did not finish. See fw/nvme_controller.spl process_one_io.
fn cpl_make_pages(cid: i64, status: i64, pages: [PageData]) -> NvmeCpl:
    var p0: PageData = page_zero()
    if pages.len() > 0:
        p0 = pages[0]
    NvmeCpl(cid: cid, status: status, data: page_word(p0, 0), page: p0, pages: pages)

"""The result page for block `i`, or a zero page when that block never transferred."""
fn cpl_page_at(p: NvmeCpl, i: i64) -> PageData:
    if i < 0 or i >= p.pages.len():
        return page_zero()
    p.pages[i]

"""How many blocks this completion actually carries back to the host."""
fn cpl_blocks_transferred(p: NvmeCpl) -> i64:
    p.pages.len()

fn cpl_status_valid(status: i64) -> bool:
    status == SC_SUCCESS or status == SC_INVALID_OPCODE or status == SC_INVALID_FIELD or status == SC_INTERNAL or status == SC_LBA_RANGE or status == SC_NS_NOT_READY or status == SC_MEDIA_ERR

# ── Physical page address helpers (ppn <-> block/page) ────────────────────────
fn ppn_block(ppn: i64) -> i64:
    ppn / PAGES_PER_BLOCK

fn ppn_page(ppn: i64) -> i64:
    ppn % PAGES_PER_BLOCK

fn block_first_ppn(blk: i64) -> i64:
    blk * PAGES_PER_BLOCK

fn ppn_in_range(ppn: i64) -> bool:
    ppn >= 0 and ppn < NUM_PAGES

fn block_in_range(blk: i64) -> bool:
    blk >= 0 and blk < NUM_BLOCKS

# 1 if the bool is true, else 0 (for asserting bool results with expect_eq).
fn bool_to_int(b: bool) -> i64:
    var v: i64 = 0
    if b:
        v = 1
    v

# ── Tiny test helper reused across firmware self-tests ────────────────────────
fn expect_eq(got: i64, want: i64, label: text) -> i64:
    if got == want:
        print "  PASS: {label} ({got})"
        return 0
    print "  FAIL: {label} -- expected {want} got {got}"
    1
