"""
ecc_check — wired SECDED ECC floor (gap-closure P3).

Run: bin/simple run examples/09_embedded/simpleos_nvme_fw/fw/ecc_check.spl
"""

use nvme_types.*
use nvme_payload.*
use fil_ecc.*
use fil.*

fn main():
    var fail: i64 = 0
    var fil: Fil = fil_new()
    val ppn: i64 = block_first_ppn(3) + 1

    fail = fail + expect_eq(fil.program(ppn, 7, 1, 0x5A), NAND_OK, "program page")

    fil.corrupt_page_data(ppn, 0x5B)
    val one: FilRead = fil.read(ppn)
    fail = fail + expect_eq(one.code, NAND_ECC_FIXED, "single silent payload bit corrected")
    fail = fail + expect_eq(one.data, 0x5A, "corrected byte returned to FIL caller")

    fil.corrupt_page_data(ppn, 0x59)
    val two: FilRead = fil.read(ppn)
    fail = fail + expect_eq(two.code, NAND_ECC_FAIL, "double silent payload bit fails closed")

    val ppn2: i64 = block_first_ppn(3) + 2
    fail = fail + expect_eq(fil.program(ppn2, 8, 2, 0x123456), NAND_OK, "program high payload page")
    fil.corrupt_page_data(ppn2, 0x133456)
    val high: FilRead = fil.read(ppn2)
    fail = fail + expect_eq(high.code, NAND_ECC_FIXED, "single high payload bit corrected")
    fail = fail + expect_eq(high.data, 0x123456, "corrected high payload returned to FIL caller")

    # ── D4: per-codeword ECC through the REAL FIL stack ──────────────────────
    # NON-VACUITY: every assertion below corrupts a word OUTSIDE codeword 0.
    # The pre-D4 implementation ECC-covered page word 0 only, so it cannot pass
    # any of them — it would return the corrupted word verbatim with NAND_OK.
    val ppn3: i64 = block_first_ppn(4) + 1
    var src = page_zero()
    var w: i64 = 0
    while w < PAGE_WORDS:
        src.words[w] = (w * 0x0123456789ABCDEF) ^ (w << 11) ^ 0x33
        w = w + 1
    # Program a CLONE: on the current Rust seed `me.page_data[ppn] = data` in
    # fil_nand_device.spl aliases the caller's nested `words` array instead of
    # copying it, so programming `src` directly would make every later
    # corrupt_page_word silently edit `src` too and turn each comparison below
    # into "corrupted page == corrupted page" — a check that can never fail.
    fail = fail + expect_eq(fil.program_page(ppn3, 77, 4, ecc_page_clone(src)), NAND_OK, "program a full 4096-byte page")
    val base: FilRead = fil.read(ppn3)
    fail = fail + expect_eq(base.code, NAND_OK, "full page reads clean")
    fail = fail + expect_eq(bool_to_int(page_eq(base.page, src)), 1, "full page round-trips all 512 words")

    # Codeword 3 = page words 384..511. A word-0-only ECC is blind here.
    fil.corrupt_page_word(ppn3, 400, src.words[400] ^ (1 << 29))
    val c3: FilRead = fil.read(ppn3)
    fail = fail + expect_eq(c3.code, NAND_ECC_FIXED, "single bit in codeword 3 (word 400) -> ECC_FIXED")
    fail = fail + expect_eq(bool_to_int(page_eq(c3.page, src)), 1, "codeword 3 bit corrected in the page returned to the FTL")

    # Codeword 1 and 2, including the last word of the page.
    fil.corrupt_page_word(ppn3, 400, src.words[400])
    fil.corrupt_page_word(ppn3, 200, src.words[200] ^ 1)
    fail = fail + expect_eq(fil.read(ppn3).code, NAND_ECC_FIXED, "single bit in codeword 1 -> ECC_FIXED")
    fail = fail + expect_eq(bool_to_int(page_eq(fil.read(ppn3).page, src)), 1, "codeword 1 bit corrected")
    fil.corrupt_page_word(ppn3, 200, src.words[200])
    fil.corrupt_page_word(ppn3, 511, src.words[511] ^ (1 << 63))
    fail = fail + expect_eq(fil.read(ppn3).code, NAND_ECC_FIXED, "last word, bit 63 -> ECC_FIXED")
    fail = fail + expect_eq(bool_to_int(page_eq(fil.read(ppn3).page, src)), 1, "last word bit 63 corrected")

    # UNCORRECTABLE, and NOT silently mis-corrected.
    fil.corrupt_page_word(ppn3, 511, src.words[511])
    fil.corrupt_page_word(ppn3, 300, src.words[300] ^ 0x0000000000000005)
    val two3: FilRead = fil.read(ppn3)
    fail = fail + expect_eq(two3.code, NAND_ECC_FAIL, "2-bit error in codeword 2 -> ECC_FAIL")
    fail = fail + expect_eq(two3.corrected, 2, "uncorrectable read reports corrected==2 to the reliability engine")
    var miscorrected: i64 = 0
    if page_eq(two3.page, src):
        miscorrected = 1
    fail = fail + expect_eq(miscorrected, 0, "uncorrectable 2-bit error was NOT silently mis-corrected")

    # INDEPENDENCE through the stack: a dead codeword 2 does not corrupt 0/1/3.
    var untouched: i64 = 0
    var q: i64 = 0
    while q < PAGE_WORDS:
        if q < 256 or q >= 384:
            if two3.page.words[q] != src.words[q]:
                untouched = untouched + 1
        q = q + 1
    fail = fail + expect_eq(untouched, 0, "dead codeword 2 left codewords 0/1/3 untouched")

    if fail == 0:
        print "ECC OK"
    else:
        print "ECC FAIL ({fail})"
