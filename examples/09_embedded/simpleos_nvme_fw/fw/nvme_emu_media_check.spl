"""
nvme_emu_media_check — Slice B: NVMe host traffic over emulated media.

This is the first check that drives the FULL NVMe controller (command
validation, opcode dispatch, task pool, SMART, DRAM write buffer, FTL, FIL,
FMC) onto the Vt-physics NeChip emulator, rather than calling the FTL directly.

fil_nand_emu_e2e_check.spl already proves `ftl_new_emu()` works at the FTL
level. The gap it leaves — and the reason this file exists — is that host
software does not call `ftl.write()`. It submits an NVMe command. Everything
between the SQE and the FTL (validation, dispatch, write buffer, completion
construction, SMART accounting) was only ever exercised against the behavioural
NAND, whose bytes never decay. This check closes that gap.

  bin/simple run examples/09_embedded/simpleos_nvme_fw/fw/nvme_emu_media_check.spl

Fault injection goes exclusively through the typed emu_* seam on the FTL
(emu_set_block_wear / emu_advance_time_s / emu_set_vref_offset). Nothing here
reaches into media backing arrays, and there is no `.nandram` word poking —
that is the point: this is what the raw-offset test-control bypass is supposed
to be replaced BY. See
doc/03_plan/hardware/nvme_emu_first_increment_plan.md §3 and
doc/08_tracking/bug/nandram_slot_map_undocumented_and_two_vacuous_slots_2026-09-01.md

GEOMETRY: firmware addresses 64 blocks x 64 pages; the S1 NeChip backs 8 x 4
and aliases beyond that. Everything below stays inside the 1:1 window
(block < 8, page < 4), so a round-trip failure is a real defect and not a fold
artefact.
"""

use nvme_types.*
use nvme_controller.*
use ftl.*
use fil.*

fn expect_eq(got: i64, want: i64, label: text) -> i64:
    if got == want:
        print("  PASS: " + label + " (" + got.to_text() + ")")
        return 0
    print("  FAIL: " + label + " — got " + got.to_text() + ", want " + want.to_text())
    1

fn expect_ne(got: i64, unwanted: i64, label: text) -> i64:
    if got != unwanted:
        print("  PASS: " + label + " (" + got.to_text() + ")")
        return 0
    print("  FAIL: " + label + " — got " + got.to_text() + ", which should differ")
    1

fn main():
    var fail: i64 = 0

    # ── A. an ordinary NVMe write/read round-trips over emulated media ───────
    print("A. NVMe host write/read over the Vt-physics backend")
    var c: NvmeController = nvme_controller_new_emu()

    val w: NvmeCpl = c.process_one_io(cmd_make(1, OP_WRITE, 0, 1, 0xA5))
    fail = fail + expect_eq(w.status, SC_SUCCESS, "host WRITE lba0 completes SC_SUCCESS")
    fail = fail + expect_eq(w.cid, 1, "completion carries the submitted cid")

    val r: NvmeCpl = c.process_one_io(cmd_make(2, OP_READ, 0, 1, 0))
    fail = fail + expect_eq(r.status, SC_SUCCESS, "host READ lba0 completes SC_SUCCESS")
    fail = fail + expect_eq(r.data, 0xA5, "host READ returns the written pattern")
    fail = fail + expect_eq(r.cid, 2, "read completion carries its own cid")

    # A distinct pattern on a second LBA — proves the read is not a constant.
    val w2: NvmeCpl = c.process_one_io(cmd_make(3, OP_WRITE, 1, 1, 0x5A))
    fail = fail + expect_eq(w2.status, SC_SUCCESS, "host WRITE lba1 completes")
    val r2: NvmeCpl = c.process_one_io(cmd_make(4, OP_READ, 1, 1, 0))
    fail = fail + expect_eq(r2.data, 0x5A, "host READ lba1 returns ITS pattern, not lba0's")

    # ── B. the write actually reached emulated media ─────────────────────────
    # Non-vacuity: if the controller were somehow serving reads from the DRAM
    # write buffer alone, the LBA would have no physical page behind it.
    print("B. the host write is backed by a real physical page")
    val ppn: i64 = c.ftl.lba_ppn(0)
    fail = fail + expect_ne(ppn, UNMAP, "lba0 maps to a physical page")

    # The Vt oracle must see a programmed cell there. A behavioural NAND has no
    # margin concept, so a non-zero margin also proves the emu backend is live.
    val margin: i64 = c.ftl.emu_read_margin(ppn)
    fail = fail + expect_ne(margin, 0, "NeChip reports a read margin for that page (emu backend live)")

    # ── C. retention drift surfaces through the ordinary NVMe read path ──────
    # Age the exact block the write landed on, through the typed seam only.
    print("C. retention drift on the host read path")
    var c2: NvmeController = nvme_controller_new_emu()
    # Pattern 0x00 = every cell programmed, the state retention drift attacks.
    # (An earlier draft used a mixed pattern and read_margin as the oracle; the
    # margin did not move, and the witness below is the one fil_nand_emu_e2e_check
    # already establishes as load-bearing. Keeping a non-moving oracle would have
    # been a check that cannot fail.)
    fail = fail + expect_eq(c2.process_one_io(cmd_make(10, OP_WRITE, 4, 1, 0x00)).status, SC_SUCCESS, "seed WRITE lba4 (all-programmed page)")
    fail = fail + expect_eq(c2.process_one_io(cmd_make(11, OP_READ, 4, 1, 0)).data, 0x00, "fresh page reads back through NVMe")

    val ppn4: i64 = c2.ftl.lba_ppn(4)
    fail = fail + expect_ne(ppn4, UNMAP, "lba4 mapped before ageing")

    # Wear the block, then let it sit. Both go through the typed test-control
    # seam; neither touches media state directly.
    c2.ftl.emu_set_block_wear(ppn_block(ppn4), 3000)
    c2.ftl.emu_advance_time_s(31536000.0)   # one year

    # The host read must still return correct data — the FIL recovery ladder is
    # expected to absorb the drift. That is the firmware behaviour under test:
    # degrade the media, keep the data, over the ORDINARY NVMe read path.
    val r4: NvmeCpl = c2.process_one_io(cmd_make(12, OP_READ, 4, 1, 0))
    fail = fail + expect_eq(r4.data, 0x00, "aged page still returns correct data through NVMe read")
    fail = fail + expect_eq(r4.status, SC_SUCCESS, "aged page read completes SC_SUCCESS")

    # ── D. the ageing seam is not a no-op ────────────────────────────────────
    # Without this, C passes whether or not the media actually decayed, and the
    # whole file would be theatre. A raw offset-0 device read bypasses the
    # recovery ladder: if the drift is real it senses the retention-flipped 0xFF
    # and fails ECC. Same witness fil_nand_emu_e2e_check.spl uses.
    print("D. non-vacuity: the drift C survived is real, not absent")
    val raw: FilRead = c2.ftl.fil.read(ppn4)
    fail = fail + expect_eq(raw.data, 0xFF, "raw device read senses retention-flipped bits (drift is real)")
    fail = fail + expect_eq(raw.code, NAND_ECC_FAIL, "raw device read FAILS ECC (recovery in C did real work)")

    if fail == 0:
        print("NVME EMU MEDIA OK")
    else:
        print("STATUS: FAIL nvme_emu_media_check: " + fail.to_text() + " check(s) failed")
    return ()
