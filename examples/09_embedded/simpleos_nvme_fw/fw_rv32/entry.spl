# NVMe firmware — bare-metal RV32 on-device self-test (gap-closure P9).
#
# Array-free, scalar re-expression of the firmware's core RAIN parity reconstruct,
# SECDED payload-window ECC floor, fixed scheduler floor, fixed power/thermal floor, fixed map-cache floor, fixed band floor, fixed journal-ring floor, fixed HIL command/queue floor, fixed queue-phase floor, fixed read-zero-trim-flush floor, fixed admin/format/fw-log floor, fixed reactor floor, fixed policy/target floor, fixed DRAM/durability floor, fixed wear/scrub floor, fixed media-retire floor, fixed power-cycle floor, fixed backpressure/abort floor, fixed feature-guard floor, fixed namespace-guard floor, fixed target-profile floor, and fixed task-pool fail-closed floor so it can run inside the bare-metal rv32 boot path with
# NO heap and NO arrays — matching the constraint documented in
# src/os/kernel/arch/riscv32/boot.spl ("keep this module freestanding and minimal ... without
# pulling runtime formatting, arrays, or boot metadata into the first-stage entry object").
# UART output uses rt_riscv_uart_put exactly like boot.spl's `_line_*` helpers — one byte at a
# time, no string runtime.
#
# Integration: call `nvme_fw_rv32_selftest()` from the rv32 boot chain (boot.spl `boot_main`,
# after `riscv_noalloc_log_init`), then build with the proven recipe (fw_rv32/build.shs) and boot
# (fw_rv32/boot.shs). It prints `ALL RV32 NVME FW CHECKS PASS` on success.
#
# BUILD STATUS (2026-06-30): toolchain FIXED + freestanding runtime COMPLETED. `native-build
# --target riscv32-unknown-none` routes to the in-process Rust LLVM handler (no silent 255), and the
# shared freestanding runtime (src/os/kernel/arch/riscv64/boot/freestanding_runtime.c, autodiscovered
# via the rv32 boot bridge baremetal_stubs.c) now provides every rt_* the rv32 kernel emits —
# rt_native_eq/neq + rt_riscv_uart_put were always there; rt_string_char_at/rt_value_as_int/
# rt_array_pop were added (commit 5ac934cd285). The rv32 boot.spl kernel links with 0 undefined
# runtime symbols, and the OS fs-exec rv32 ELF boots under qemu (-bios none) printing
# "SimpleOS RV32 boot OK". This `entry.spl` is the standalone *logic reference* (host-verified,
# XOR/ECC/scheduler/power-thermal/map-cache/band/journal-ring/HIL/queue-phase/read-zero-trim-flush/admin-format-fw-log/reactor/policy-target/DRAM-durability/wear-scrub/media-retire/power-cycle/backpressure-abort/feature-guard/namespace-guard/task-pool checks reproduce fail=0); a standalone native-build of it alone won't link (its dir has no
# boot/ for C autodiscovery) — the bootable path is the OS build, which links the shared runtime.
# Tracked in doc/08_tracking/bug/native_build_rv32_baremetal_silent_255_2026-06-30.md. Full 22-module
# no-alloc port of ../fw/ is the larger ceiling.

extern fn rt_riscv_uart_put(byte: u64)
extern fn rt_rv32_nand_ram_load(word: u32) -> u32
extern fn rt_rv32_nand_ram_store(word: u32, value: u32)
use logic.{nvme_fw_rv32_logic_selftest}
use logic_nand_read_level.*

fn _uart_put(byte: i64):
    rt_riscv_uart_put(byte as u64)

# Emit a NUL-terminated-style fixed byte sequence one byte at a time (no arrays, no string
# runtime, no `;` statement separators — native-build's parser rejects those).
fn _emit_pass():
    # "ALL RV32 NVME FW CHECKS PASS\n"
    _uart_put(65)
    _uart_put(76)
    _uart_put(76)
    _uart_put(32)
    _uart_put(82)
    _uart_put(86)
    _uart_put(51)
    _uart_put(50)
    _uart_put(32)
    _uart_put(78)
    _uart_put(86)
    _uart_put(77)
    _uart_put(69)
    _uart_put(32)
    _uart_put(70)
    _uart_put(87)
    _uart_put(32)
    _uart_put(67)
    _uart_put(72)
    _uart_put(69)
    _uart_put(67)
    _uart_put(75)
    _uart_put(83)
    _uart_put(32)
    _uart_put(80)
    _uart_put(65)
    _uart_put(83)
    _uart_put(83)
    _uart_put(10)

fn _emit_fail():
    # "RV32 NVME FW FAIL\n"
    _uart_put(82)
    _uart_put(86)
    _uart_put(51)
    _uart_put(50)
    _uart_put(32)
    _uart_put(78)
    _uart_put(86)
    _uart_put(77)
    _uart_put(69)
    _uart_put(32)
    _uart_put(70)
    _uart_put(87)
    _uart_put(32)
    _uart_put(70)
    _uart_put(65)
    _uart_put(73)
    _uart_put(76)
    _uart_put(10)

fn _emit_begin():
    # "RV32 NVME FW BEGIN\n"
    _uart_put(82)
    _uart_put(86)
    _uart_put(51)
    _uart_put(50)
    _uart_put(32)
    _uart_put(78)
    _uart_put(86)
    _uart_put(77)
    _uart_put(69)
    _uart_put(32)
    _uart_put(70)
    _uart_put(87)
    _uart_put(32)
    _uart_put(66)
    _uart_put(69)
    _uart_put(71)
    _uart_put(73)
    _uart_put(78)
    _uart_put(10)

fn _emit_fail_mask(mask: i64):
    if (mask & 1) != 0:
        _uart_put(82)   # R
    if (mask & 2) != 0:
        _uart_put(69)   # E
    if (mask & 4) != 0:
        _uart_put(74)   # J
    if (mask & 8) != 0:
        _uart_put(77)   # M
    if (mask & 16) != 0:
        _uart_put(66)   # B
    if (mask & 32) != 0:
        _uart_put(83)   # S
    if (mask & 64) != 0:
        _uart_put(80)   # P
    if (mask & 128) != 0:
        _uart_put(72)   # H
    if (mask & 256) != 0:
        _uart_put(81)   # Q
    if (mask & 512) != 0:
        _uart_put(73)   # I
    if (mask & 1024) != 0:
        _uart_put(70)   # F
    if (mask & 2048) != 0:
        _uart_put(65)   # A
    if (mask & 4096) != 0:
        _uart_put(67)   # C
    if (mask & 8192) != 0:
        _uart_put(84)   # T
    if (mask & 16384) != 0:
        _uart_put(68)   # D
    if (mask & 32768) != 0:
        _uart_put(87)   # W
    if (mask & 65536) != 0:
        _uart_put(76)   # L
    if (mask & 131072) != 0:
        _uart_put(89)   # Y
    if (mask & 262144) != 0:
        _uart_put(75)   # K
    if (mask & 524288) != 0:
        _uart_put(71)   # G
    if (mask & 1048576) != 0:
        _uart_put(78)   # N
    if (mask & 2097152) != 0:
        _uart_put(79)   # O
    if (mask & 4194304) != 0:
        _uart_put(88)   # X
    if (mask & 8388608) != 0:
        _uart_put(86)   # V
    _uart_put(10)

fn _nand_ram_load(word: u32) -> u32:
    rt_rv32_nand_ram_load(word)

fn _nand_ram_store(word: u32, value: u32):
    rt_rv32_nand_ram_store(word, value)

fn _emit_nand_prefix():
    _uart_put(78)
    _uart_put(65)
    _uart_put(78)
    _uart_put(68)
    _uart_put(32)

fn _emit_nand_pass_suffix():
    _uart_put(32)
    _uart_put(80)
    _uart_put(65)
    _uart_put(83)
    _uart_put(83)
    _uart_put(10)

fn _emit_nand_digit(value: u32):
    _uart_put(48 + value as i64)

fn _emit_nand_evidence():
    # "NAND EVIDENCE D1 U1 F5 C3 T1 M1 Q3 X2 S1 PASS\n"
    _emit_nand_prefix()
    _uart_put(69)
    _uart_put(86)
    _uart_put(73)
    _uart_put(68)
    _uart_put(69)
    _uart_put(78)
    _uart_put(67)
    _uart_put(69)
    _uart_put(32)
    _uart_put(68)
    _emit_nand_digit(_nand_ram_load(35))
    _uart_put(32)
    _uart_put(85)
    _emit_nand_digit(_nand_ram_load(36))
    _uart_put(32)
    _uart_put(70)
    _emit_nand_digit(_nand_ram_load(7))
    _uart_put(32)
    _uart_put(67)
    _emit_nand_digit(_nand_ram_load(8))
    _uart_put(32)
    _uart_put(84)
    _emit_nand_digit(_nand_ram_load(23))
    _uart_put(32)
    _uart_put(77)
    _emit_nand_digit(_nand_ram_load(24))
    _uart_put(32)
    _uart_put(81)
    _emit_nand_digit(_nand_ram_load(20))
    _uart_put(32)
    _uart_put(88)
    _emit_nand_digit(_nand_ram_load(46))
    _uart_put(32)
    _uart_put(83)
    _emit_nand_digit(_nand_ram_load(31))
    _emit_nand_pass_suffix()

fn _emit_nand_stage(stage: i64):
    _emit_nand_prefix()
    if stage == 1:
        _uart_put(83)
        _uart_put(84)
        _uart_put(65)
        _uart_put(82)
        _uart_put(84)
        _uart_put(85)
        _uart_put(80)
    if stage == 2:
        _uart_put(65)
        _uart_put(68)
        _uart_put(77)
        _uart_put(73)
        _uart_put(78)
        _uart_put(81)
    if stage == 3:
        _uart_put(73)
        _uart_put(79)
        _uart_put(81)
    if stage == 4:
        _uart_put(69)
        _uart_put(82)
        _uart_put(65)
        _uart_put(83)
        _uart_put(69)
    if stage == 5:
        _uart_put(80)
        _uart_put(82)
        _uart_put(79)
        _uart_put(71)
        _uart_put(82)
        _uart_put(65)
        _uart_put(77)
    if stage == 6:
        _uart_put(82)
        _uart_put(69)
        _uart_put(65)
        _uart_put(68)
    if stage == 7:
        _uart_put(80)
        _uart_put(82)
        _uart_put(69)
        _uart_put(86)
        _uart_put(69)
        _uart_put(78)
        _uart_put(84)
    if stage == 8:
        _uart_put(82)
        _uart_put(69)
        _uart_put(67)
        _uart_put(79)
        _uart_put(86)
        _uart_put(69)
        _uart_put(82)
        _uart_put(89)
    _emit_nand_pass_suffix()

fn _nand_ram_startup() -> i64:
    _nand_ram_store(0, 0x4E414E44)
    _nand_ram_store(1, rv32_nand_lifecycle_next(0, 1) as u32)
    _nand_ram_store(2, 0)
    _nand_ram_store(3, 0xFFFFFFFF)
    _nand_ram_store(4, rv32_nand_level_erased() as u32)
    _nand_ram_store(5, rv32_nand_reference_default() as u32)
    _nand_ram_store(6, 0)
    _nand_ram_store(7, 0)
    _nand_ram_store(8, 0)
    _nand_ram_store(9, 0)
    _nand_ram_store(10, 0xFFFFFFFF)
    _nand_ram_store(11, 0)
    _nand_ram_store(12, 0xFFFFFFFF)
    _nand_ram_store(13, 0)
    _nand_ram_store(14, 0)
    _nand_ram_store(15, 0)
    _nand_ram_store(16, 0)
    _nand_ram_store(17, 0)
    _nand_ram_store(18, 0)
    _nand_ram_store(19, 0)
    _nand_ram_store(20, 0)
    _nand_ram_store(21, 0)
    _nand_ram_store(22, rv32_nand_level_erased() as u32)
    _nand_ram_store(23, 0)
    _nand_ram_store(24, 0)
    _nand_ram_store(25, 0)
    _nand_ram_store(26, 0)
    _nand_ram_store(27, 0)
    _nand_ram_store(28, 0)
    _nand_ram_store(29, 1)
    _nand_ram_store(30, 0)
    _nand_ram_store(31, 1)
    _nand_ram_store(32, 0)
    _nand_ram_store(33, 0xFFFFFFFF)
    _nand_ram_store(34, 0)
    _nand_ram_store(35, 0)
    _nand_ram_store(36, 0)
    _nand_ram_store(37, rv32_nand_ecc_compute(0xFFFFFFFF) as u32)
    _nand_ram_store(38, rv32_nand_ecc_compute(0xFFFFFFFF) as u32)
    _nand_ram_store(39, 0)
    _nand_ram_store(40, 0xFFFFFFFF)
    _nand_ram_store(41, rv32_nand_level_erased() as u32)
    _nand_ram_store(42, rv32_nand_ecc_compute(0xFFFFFFFF) as u32)
    _nand_ram_store(43, 0)
    _nand_ram_store(44, 0)
    _nand_ram_store(45, 0)
    _nand_ram_store(46, 0)
    if _nand_ram_load(0) != 0x4E414E44:
        return 1
    if _nand_ram_load(1) != 1:
        return 1
    0

fn _nand_ram_advance(event: i64) -> i64:
    val next = rv32_nand_lifecycle_next(_nand_ram_load(1) as i64, event)
    if next < 0:
        _nand_ram_store(9, 1)
        return 1
    _nand_ram_store(1, next as u32)
    _nand_ram_store(9, 0)
    0

fn _nand_ram_create_admin_queue(qid: i64, depth: i64) -> i64:
    if rv32_nand_admin_queue_valid(qid, depth) == 0:
        _nand_ram_store(9, 1)
        return 1
    if _nand_ram_advance(2) != 0:
        return 1
    val queue_state = rv32_nand_queue_next(_nand_ram_load(14) as i64, 1)
    if queue_state < 0:
        return 1
    _nand_ram_store(10, qid as u32)
    _nand_ram_store(11, depth as u32)
    _nand_ram_store(14, queue_state as u32)
    0

fn _nand_ram_create_io_queue(qid: i64, depth: i64) -> i64:
    if rv32_nand_io_queue_valid(qid, depth) == 0:
        _nand_ram_store(9, 1)
        return 1
    if _nand_ram_load(1) == 2:
        if _nand_ram_advance(3) != 0:
            return 1
    elif _nand_ram_load(1) != 3:
        return 1
    val queue_state = rv32_nand_queue_next(_nand_ram_load(15) as i64, 1)
    if queue_state < 0:
        return 1
    _nand_ram_store(12, qid as u32)
    _nand_ram_store(13, depth as u32)
    _nand_ram_store(15, queue_state as u32)
    0

fn _nand_ram_submit_io() -> i64:
    if _nand_ram_load(15) != 1:
        return 1
    val depth = _nand_ram_load(13)
    val next = (_nand_ram_load(16) + 1) % depth
    if next == _nand_ram_load(17):
        _nand_ram_store(9, 5)
        _nand_ram_store(46, _nand_ram_load(46) + 1)
        return 5
    _nand_ram_store(16, next)
    0

fn _nand_ram_complete_io() -> i64:
    if _nand_ram_load(17) == _nand_ram_load(16):
        return 1
    val depth = _nand_ram_load(13)
    val next_cq = (_nand_ram_load(18) + 1) % depth
    if next_cq == _nand_ram_load(19):
        _nand_ram_store(9, 5)
        _nand_ram_store(46, _nand_ram_load(46) + 1)
        return 5
    _nand_ram_store(17, (_nand_ram_load(17) + 1) % depth)
    _nand_ram_store(18, next_cq)
    _nand_ram_store(20, _nand_ram_load(20) + 1)
    0

fn _nand_ram_reap_completion() -> i64:
    if _nand_ram_load(19) == _nand_ram_load(18):
        return 1
    _nand_ram_store(19, (_nand_ram_load(19) + 1) % _nand_ram_load(13))
    0

fn _nand_ram_delete_io_queue() -> i64:
    if _nand_ram_load(15) != 1:
        return 1
    if _nand_ram_load(16) != _nand_ram_load(17) or _nand_ram_load(18) != _nand_ram_load(19):
        return 1
    val deleting = rv32_nand_queue_next(_nand_ram_load(15) as i64, 2)
    if deleting < 0:
        return 1
    _nand_ram_store(15, deleting as u32)
    val absent = rv32_nand_queue_next(_nand_ram_load(15) as i64, 3)
    if absent < 0:
        return 1
    _nand_ram_store(15, absent as u32)
    _nand_ram_store(12, 0xFFFFFFFF)
    _nand_ram_store(13, 0)
    0

fn _nand_ram_erase() -> i64:
    val status = rv32_nand_media_status(_nand_ram_load(1) as i64, _nand_ram_load(2) as i64, 1)
    _nand_ram_store(9, status as u32)
    if status != 0:
        return status
    _nand_ram_store(2, 0)
    _nand_ram_store(3, 0xFFFFFFFF)
    _nand_ram_store(4, rv32_nand_level_erased() as u32)
    _nand_ram_store(6, 0)
    _nand_ram_store(28, 0)
    _nand_ram_store(32, 0)
    _nand_ram_store(37, rv32_nand_ecc_compute(0xFFFFFFFF) as u32)
    _nand_ram_store(44, 0)
    0

fn _nand_ram_program(data: u32) -> i64:
    val status = rv32_nand_media_status(_nand_ram_load(1) as i64, _nand_ram_load(2) as i64, 2)
    _nand_ram_store(9, status as u32)
    if status != 0:
        return status
    _nand_ram_store(2, 1)
    _nand_ram_store(3, data)
    _nand_ram_store(4, rv32_nand_level_programmed() as u32)
    _nand_ram_store(6, 0)
    _nand_ram_store(28, 0)
    _nand_ram_store(32, 1)
    _nand_ram_store(37, rv32_nand_ecc_compute(data as i64) as u32)
    _nand_ram_store(44, 0)
    0

fn _nand_ram_read_raw(read_reference: i64) -> u32:
    val status = rv32_nand_media_status(_nand_ram_load(1) as i64, _nand_ram_load(2) as i64, 3)
    _nand_ram_store(9, status as u32)
    if status != 0:
        return 0xFFFFFFFF
    _nand_ram_store(5, read_reference as u32)
    _nand_ram_store(6, _nand_ram_load(6) + 1)
    _nand_ram_store(21, _nand_ram_load(21) + 1)
    _nand_ram_store(22, rv32_nand_disturb_level(_nand_ram_load(22) as i64, _nand_ram_load(21) as i64, _nand_ram_load(34) as i32) as u32)
    val data = _nand_ram_load(3) as i64
    val error_bits = rv32_nand_error_bits(_nand_ram_load(32) as i32, _nand_ram_load(4) as i64, read_reference)
    val sensed = rv32_nand_sense_data(data, _nand_ram_load(32) as i32, _nand_ram_load(4) as i64, read_reference)
    _nand_ram_store(28, error_bits as u32)
    if rv32_nand_ecc_correctable(error_bits, _nand_ram_load(29) as i64) == 0:
        _nand_ram_store(9, 3)
    else:
        _nand_ram_store(9, 0)
    sensed as u32

fn _nand_ram_remap(corrected_data: u32, programmed: i32, recovered: i32) -> i64:
    _nand_ram_store(23, _nand_ram_load(23) + 1)
    _nand_ram_store(24, _nand_ram_load(24) + 1)
    _nand_ram_store(39, 1)
    _nand_ram_store(40, corrected_data)
    _nand_ram_store(41, rv32_nand_nominal_level(programmed) as u32)
    _nand_ram_store(42, rv32_nand_ecc_compute(corrected_data as i64) as u32)
    _nand_ram_store(43, programmed as u32)
    val remap_errors = rv32_nand_error_bits(programmed, _nand_ram_load(41) as i64, rv32_nand_reference_default())
    val remap_sensed = rv32_nand_sense_data(_nand_ram_load(40) as i64, programmed, _nand_ram_load(41) as i64, rv32_nand_reference_default())
    val remap_status = rv32_nand_ecc_decode_status(remap_sensed, _nand_ram_load(42) as i64, remap_errors, _nand_ram_load(29) as i64)
    val remap_data = rv32_nand_ecc_decode_data(remap_sensed, _nand_ram_load(42) as i64)
    if remap_status == 0 or remap_data != corrected_data as i64:
        _nand_ram_store(9, 4)
        _nand_ram_store(30, 4)
        return 4
    _nand_ram_store(2, 1)
    _nand_ram_store(3, _nand_ram_load(40))
    _nand_ram_store(4, _nand_ram_load(41))
    _nand_ram_store(32, _nand_ram_load(43))
    _nand_ram_store(37, _nand_ram_load(42))
    _nand_ram_store(44, 1)
    _nand_ram_store(6, 0)
    _nand_ram_store(21, 0)
    _nand_ram_store(7, _nand_ram_load(7) + 1)
    if recovered != 0:
        _nand_ram_store(8, _nand_ram_load(8) + 1)
    _nand_ram_store(9, 0)
    _nand_ram_store(30, 3)
    0

fn _nand_ram_fcr(corrected_data: u32, recovered: i32) -> i64:
    val correctable = rv32_nand_ecc_correctable(_nand_ram_load(28) as i64, _nand_ram_load(29) as i64)
    var matches: i32 = 0
    if rv32_nand_ecc_compute(corrected_data as i64) == _nand_ram_load(37) as i64:
        matches = 1
    if rv32_nand_refresh_allowed(correctable, matches) == 0:
        return 3
    val programmed = _nand_ram_load(32) as i32
    _nand_ram_store(30, 1)
    _nand_ram_store(2, 0)
    _nand_ram_store(4, rv32_nand_level_erased() as u32)
    if _nand_ram_load(25) != 0:
        _nand_ram_store(25, 0)
        return _nand_ram_remap(corrected_data, programmed, recovered)
    _nand_ram_store(2, 1)
    _nand_ram_store(3, corrected_data)
    _nand_ram_store(4, rv32_nand_nominal_level(programmed) as u32)
    _nand_ram_store(37, rv32_nand_ecc_compute(corrected_data as i64) as u32)
    _nand_ram_store(30, 2)
    val verify_errors = rv32_nand_error_bits(programmed, _nand_ram_load(4) as i64, rv32_nand_reference_default())
    val verify_data = rv32_nand_sense_data(_nand_ram_load(3) as i64, programmed, _nand_ram_load(4) as i64, rv32_nand_reference_default())
