"""
# Freestanding hello (bare metal, real firmware)

Text literals, interpolation and panic on a `<arch>-unknown-none` target,
backed by `src/lib/nogc_async_mut_noalloc/baremetal/freestanding/bm_rt.spl`.
Booted by `scripts/check/check-baremetal-efi-boot.shs`; expected serial:

    hello from Simple bare metal
    n=42
    panic: boom

and never "after panic" (panic halts).
"""

fn main():
    print "hello from Simple bare metal"
    val n = 42
    print "n={n}"
    panic("boom")
    print "after panic"
