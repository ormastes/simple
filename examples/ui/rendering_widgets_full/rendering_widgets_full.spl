# examples.ui.rendering_widgets_full — shared full-tier widget set for the
# rendering showcases (lane tui/gui, tier full).
#
# Imports the brief core (examples.ui.rendering_widgets_core) and adds:
#   * rendering_widgets_full_tree — the full TUI tree (all builder-supported
#     TUI-rendered kinds), CELL-sized for the char-grid host;
#   * the WidgetKind coverage tables — all 43 wire names and the 30 with a
#     TUI renderer, so the 13 unrendered kinds are exposed with honest
#     `(no tui)` markers instead of being dropped;
#   * rendering_tabs() — the single shared tab list every lane renders
#     (shared tabs, changed tags only).

use common.ui.builder.{
    column, row, panel, label, button, checkbox, dropdown,
    text_field, image, tooltip, progress, menubar, statusbar, divider,
    tabs, list_widget, table_widget, segmented_control, tree_widget,
    tree_node, tree_leaf, scroll, textarea, dialog,
    with_height
}
use common.ui.widget_store_ops.{WidgetNode, set_internal_prop}
use examples.ui.rendering_widgets_core.{rendering_core_menu_items}

# --- shared tab list --------------------------------------------------------
#
# The single tab definition every lane renders. Titles feed the TUI full
# tree's tabs widget; GUI/full entries consume the same list for their tab
# receipts. Change tags here only — the ids/titles are the cross-lane
# contract.

struct RenderingTab:
    id: text
    title: text
    tags: [text]

fn rendering_tabs() -> [RenderingTab]:
    [
        RenderingTab(id: "widgets", title: "Widgets", tags: ["panel", "text", "button", "list", "menubar", "statusbar", "divider", "progress"]),
        RenderingTab(id: "coverage", title: "Coverage", tags: ["kinds", "no-tui"]),
        RenderingTab(id: "about", title: "About", tags: ["contract", "env"]),
    ]

fn rendering_tab_titles() -> [text]:
    var titles: [text] = []
    for t in rendering_tabs():
        titles.push(t.title)
    titles

# --- coverage tables --------------------------------------------------------
#
# ALL 43 WidgetKind wire names (common/ui/widget_kind.spl) and the 30 that
# have a TUI renderer in the render_tui dispatch. Everything in
# rendering_all_kinds but not in rendering_tui_rendered_kinds is printed with
# a `(no tui)` marker in the coverage section.

fn rendering_all_kinds() -> [text]:
    [
        "panel", "text", "list", "table", "progress", "menubar", "statusbar",
        "input", "tabs", "button", "checkbox", "radio", "dropdown",
        "textfield", "image", "divider", "dialog", "tooltip", "tree",
        "treenode", "scroll", "textarea", "heading", "label",
        "navigation_bar", "tab_bar", "card", "switch", "segmented_control",
        "search_bar", "glass_title_bar", "sidebar", "command_bar",
        "workspace_tabs", "command_palette", "toast", "sheet_modal",
        "context_menu", "inspector", "utility_rail", "status_chip",
        "selection_pill", "empty_state"
    ]

fn rendering_tui_rendered_kinds() -> [text]:
    [
        "panel", "text", "list", "table", "progress", "menubar", "statusbar",
        "input", "tabs", "button", "checkbox", "radio", "dropdown",
        "textfield", "image", "divider", "dialog", "tooltip", "tree",
        "treenode", "scroll", "textarea", "heading", "label",
        "navigation_bar", "tab_bar", "card", "switch", "segmented_control",
        "search_bar"
    ]

fn rendering_kind_has_tui(kind: text) -> bool:
    for k in rendering_tui_rendered_kinds():
        if k == kind:
            return true
    false

# --- full tree --------------------------------------------------------------
#
# Rows are CELL-sized for the 80x24-style char grid (the entry defaults to
# 80x40 so every widget keeps a real row; SIMPLE_SHOWCASE_H can shrink it,
# clipped content is the scroll viewport's job). Builder-supported kinds
# only: radio/heading/navigation_bar/tab_bar/card/switch/search_bar have TUI
# renderers but no builder convenience fn, so they appear in the coverage
# table (renderer exists) without a tree instance here.

fn rendering_widgets_full_tree(prefix: text) -> WidgetNode:
    """The full-tier TUI tree: every builder-supported TUI-rendered kind in
    one column, tab labels driven by the shared rendering_tabs() list.
    showcase_apply recovers the prefix from the `sc_prefix` prop."""
    val bar = with_height(menubar("{prefix}_menu", rendering_core_menu_items()), 1)
    val tab_row = with_height(tabs("{prefix}_tabs", rendering_tab_titles()), 1)
    val main = panel("{prefix}_main", "TUI Full: renderer set", [
        label("{prefix}_title", "Rendering showcase - TUI full (all TUI renderers)"),
        with_height(row("{prefix}_controls", [
            button("{prefix}_ok", "OK", "ok"),
            checkbox("{prefix}_chk", "enabled", true),
            progress("{prefix}_prog", 65),
        ]), 1),
        with_height(tooltip("{prefix}_tip", "a tooltip", "{prefix}_ok"), 1),
        divider("{prefix}_div"),
        with_height(dropdown("{prefix}_drop", ["alpha", "beta", "gamma"]), 1),
        with_height(text_field("{prefix}_field", "", "type here"), 1),
        with_height(segmented_control("{prefix}_seg", ["one", "two", "three"], 1, "seg"), 1),
        with_height(list_widget("{prefix}_list", ["list row 0", "list row 1", "list row 2", "list row 3"]), 3),
        with_height(table_widget("{prefix}_table", ["id", "name"], [["1", "alpha"], ["2", "beta"], ["3", "gamma"]]), 4),
        with_height(tree_widget("{prefix}_tree", [
            tree_node("{prefix}_tree_a", "alpha", [
                tree_leaf("{prefix}_tree_a1", "a1"),
                tree_leaf("{prefix}_tree_a2", "a2"),
            ]),
            tree_leaf("{prefix}_tree_b", "beta"),
        ]), 4),
        with_height(textarea("{prefix}_area", "", "multi-line", 3), 3),
        with_height(image("{prefix}_img", "asset.png", "[image]"), 3),
        with_height(scroll("{prefix}_scroll", 4, [
            label("{prefix}_sl0", "scroll row 0"),
            label("{prefix}_sl1", "scroll row 1"),
            label("{prefix}_sl2", "scroll row 2"),
            label("{prefix}_sl3", "scroll row 3"),
            label("{prefix}_sl4", "scroll row 4"),
            label("{prefix}_sl5", "scroll row 5"),
        ]), 4),
        with_height(dialog("{prefix}_dlg", "Dialog", [
            label("{prefix}_dlg_body", "dialog body"),
        ]), 3),
    ])
    val status = with_height(statusbar("{prefix}_status", "ready", "tui full"), 1)
    val root = column("{prefix}_root", [bar, tab_row, main, status])
    set_internal_prop(root.id, "sc_prefix", prefix)
    root
