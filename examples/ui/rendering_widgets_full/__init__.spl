# examples.ui.rendering_widgets_full — shared full-tier widget set (lane
# tui/gui, tier full). Imports the brief core and adds the full tree, the
# WidgetKind coverage tables, and the shared tab list. Re-exports both tiers
# so a full-tier consumer needs only this package.

use rendering_widgets_full.{
    RenderingTab,
    rendering_tabs, rendering_tab_titles,
    rendering_all_kinds, rendering_tui_rendered_kinds, rendering_kind_has_tui,
    rendering_widgets_full_tree
}
use rendering_widgets_core.{
    RENDERING_CORE_BAR_H, rendering_core_menu_items,
    rendering_widgets_core_tree, rendering_widgets_core_tui_tree
}

export RenderingTab
export rendering_tabs, rendering_tab_titles
export rendering_all_kinds, rendering_tui_rendered_kinds, rendering_kind_has_tui
export rendering_widgets_full_tree
export RENDERING_CORE_BAR_H, rendering_core_menu_items
export rendering_widgets_core_tree, rendering_widgets_core_tui_tree
