# Extended web document module for the rendering showcases (lane: web, tier: extended).
#
# Imports the core page (examples.ui.rendering_web_core) and builds the
# multi-tab document: core, forms-media, animation, the aqua-family theme
# gallery (ten themes applied through CSS custom properties), and the
# full-widget examples ported to static HTML.

use examples.ui.rendering_web_core.{rendering_web_core_sections}

pub class RenderingWebTab:
    id: text
    title: text
    tags: [text]

# The single tab definition list for the web extended document.
pub fn rendering_web_tabs() -> [RenderingWebTab]:
    var tabs: [RenderingWebTab] = []
    tabs.push(RenderingWebTab(id: "core", title: "Core page", tags: ["web", "core", "text", "image", "scrollbar"]))
    tabs.push(RenderingWebTab(id: "forms-media", title: "Forms & Media", tags: ["web", "extended", "forms"]))
    tabs.push(RenderingWebTab(id: "animation", title: "Animation", tags: ["web", "extended", "animation"]))
    tabs.push(RenderingWebTab(id: "themes", title: "Theme gallery", tags: ["web", "extended", "themes", "aqua-family"]))
    tabs.push(RenderingWebTab(id: "widgets", title: "Widgets", tags: ["web", "extended", "widgets"]))
    tabs

# Current theme set (mirrors demo_themes.ui.sdn): the aqua family plus the
# plain dark/light pair. The theme gallery renders one section per name.
pub fn rendering_web_theme_names() -> [text]:
    var names: [text] = []
    names.push("aqua_light")
    names.push("aqua_dark")
    names.push("glass_light")
    names.push("glass_dark")
    names.push("glass_obsidian_light")
    names.push("glass_obsidian_dark")
    names.push("ios_light")
    names.push("ios_dark")
    names.push("dark")
    names.push("light")
    names

fn _theme_is_dark(name: text) -> bool:
    if name == "aqua_dark":
        return true
    if name == "glass_dark":
        return true
    if name == "glass_obsidian_dark":
        return true
    if name == "ios_dark":
        return true
    if name == "dark":
        return true
    false

fn _theme_bg(name: text) -> text:
    if name == "aqua_light":
        return "#e8f6fb"
    if name == "aqua_dark":
        return "#0b2530"
    if name == "glass_light":
        return "#f4f6fb"
    if name == "glass_dark":
        return "#10131c"
    if name == "glass_obsidian_light":
        return "#eef1f6"
    if name == "glass_obsidian_dark":
        return "#0a0c12"
    if name == "ios_light":
        return "#f2f2f7"
    if name == "ios_dark":
        return "#1c1c1e"
    if name == "dark":
        return "#15181d"
    "#ffffff"

fn _theme_fg(name: text) -> text:
    if _theme_is_dark(name):
        return "#e8eaed"
    "#172033"

fn _theme_accent(name: text) -> text:
    if name.starts_with("aqua"):
        return "#0aa8d8"
    if name.starts_with("glass_obsidian"):
        return "#8b9cf9"
    if name.starts_with("glass"):
        return "#5b7cfa"
    if name.starts_with("ios"):
        return "#0a84ff"
    "#4f46e5"

# One theme section: the theme is applied purely through CSS custom
# properties (--theme-bg / --theme-fg / --theme-accent) consumed via var(),
# so the gallery exercises the engine custom_properties.spl var() path.
pub fn rendering_web_theme_section(name: text) -> text:
    val bg = _theme_bg(name)
    val fg = _theme_fg(name)
    val accent = _theme_accent(name)
    var parts: [text] = []
    parts.push("<section class='theme-card' data-theme='" + name + "' style='--theme-bg: " + bg + "; --theme-fg: " + fg + "; --theme-accent: " + accent + "; background: var(--theme-bg, " + bg + "); color: var(--theme-fg, " + fg + "); border: 1px solid var(--theme-accent, " + accent + "); border-radius: 12px; padding: 16px; margin: 0 0 16px;'>")
    parts.push("<h3 style='color: var(--theme-accent, " + accent + "); margin: 0 0 8px;'>" + name + "</h3>")
    parts.push("<p>Sample body text on the theme background with an <span style='color: var(--theme-accent, " + accent + ")'>accented inline run</span> inside the sentence.</p>")
    parts.push("<button type='button' style='background: var(--theme-accent, " + accent + "); color: var(--theme-bg, " + bg + "); border: 0; border-radius: 6px; padding: 6px 12px;'>Themed button</button>")
    parts.push("<div class='scroll' style='height: 56px; overflow: auto; margin-top: 10px; border: 1px dashed var(--theme-accent, " + accent + "); scrollbar-track-color: var(--theme-bg, " + bg + "); scrollbar-thumb-color: var(--theme-accent, " + accent + ");'>Theme scroll line 1<br/>Theme scroll line 2<br/>Theme scroll line 3<br/>Theme scroll line 4<br/>Theme scroll line 5<br/>Theme scroll line 6</div>")
    parts.push("</section>")
    parts.join("\n")

fn _forms_media_panel() -> text:
    var parts: [text] = []
    parts.push("<section id='panel-forms-media' role='tabpanel' aria-labelledby='tab-forms-media' hidden>")
    parts.push("<h2>Interactive forms</h2>")
    parts.push("<form id='showcase-form'>")
    parts.push("<label>Name <input id='name' name='name' value='Simple'/></label>")
    parts.push("<label><input id='enabled' type='checkbox' checked='checked'/> Enabled</label>")
    parts.push("<label><input type='radio' name='mode' checked='checked'/> Light</label>")
    parts.push("<label>Choice <select id='choice'><option>Alpha</option><option>Beta</option></select></label>")
    parts.push("<label>Notes <textarea id='notes'>Editable text</textarea></label>")
    parts.push("<button id='submit' type='button'>Exercise controls</button>")
    parts.push("<output id='result'>Not exercised</output>")
    parts.push("</form>")
    parts.push("<details id='details'><summary>Disclosure widget</summary><p>Details content is visible after activation.</p></details>")
    parts.push("<p class='note'>Mirrors web_catalog/forms-media.html: canvas, audio, and video remain explicit probes — a renderer must show them or report them unsupported.</p>")
    parts.push("</section>")
    parts.join("\n")

fn _animation_panel() -> text:
    var parts: [text] = []
    parts.push("<section id='panel-animation' role='tabpanel' aria-labelledby='tab-animation' class='unsupported' hidden>")
    parts.push("<h2>Explicit advanced-feature probes</h2>")
    parts.push("<p>Canvas, SVG, audio, and video are included as probes. A renderer must show them or report them as unsupported; blank success is invalid.</p>")
    parts.push("<canvas width='120' height='40'>Canvas unsupported</canvas>")
    parts.push("<svg width='120' height='40' role='img'><rect width='120' height='40' fill='#7c3aed'></rect></svg>")
    parts.push("<audio controls='controls'><span>Audio unsupported</span></audio><video controls='controls' width='120'><span>Video unsupported</span></video>")
    parts.push("<p>Transition sample: <span style='transition: color 200ms; color: #4f46e5;'>inline transition declaration</span>.</p>")
    parts.push("<style>@keyframes rendering-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }</style>")
    parts.push("<p>Animation sample: <span style='animation: rendering-spin 2s linear infinite; display: inline-block;'>spinning span</span>.</p>")
    parts.push("</section>")
    parts.join("\n")

fn _themes_panel() -> text:
    var parts: [text] = []
    parts.push("<section id='panel-themes' role='tabpanel' aria-labelledby='tab-themes' hidden>")
    parts.push("<h2>Aqua-family theme gallery</h2>")
    parts.push("<p>One section per current theme. Each theme is applied only through CSS custom properties consumed with var(), mirroring demo_themes.ui.sdn.</p>")
    for name in rendering_web_theme_names():
        parts.push(rendering_web_theme_section(name))
    parts.push("</section>")
    parts.join("\n")

fn _widget_card(id: text, title: text) -> text:
    "<div class='card' data-widget='" + id + "'><strong>" + title + "</strong><br/><span class='widget-tags'>tags: web gui</span></div>"

# Every WidgetKind from src/lib/common/ui/widget_kind.spl, rendered as static
# HTML through the same card structure as web_catalog. The authoritative
# (no tui) census lives in the shared rendering_items.ui.sdn (L6); this panel
# deliberately does not re-claim per-kind TUI coverage.
fn _widgets_panel() -> text:
    var kinds: [text] = []
    kinds.push("panel")
    kinds.push("text")
    kinds.push("list")
    kinds.push("table")
    kinds.push("progress")
    kinds.push("menubar")
    kinds.push("statusbar")
    kinds.push("input")
    kinds.push("tabs")
    kinds.push("button")
    kinds.push("checkbox")
    kinds.push("radio")
    kinds.push("dropdown")
    kinds.push("textfield")
    kinds.push("image")
    kinds.push("divider")
    kinds.push("dialog")
    kinds.push("tooltip")
    kinds.push("tree")
    kinds.push("treenode")
    kinds.push("scroll")
    kinds.push("textarea")
    kinds.push("heading")
    kinds.push("label")
    kinds.push("navigation_bar")
    kinds.push("tab_bar")
    kinds.push("card")
    kinds.push("switch")
    kinds.push("segmented_control")
    kinds.push("search_bar")
    kinds.push("glass_title_bar")
    kinds.push("sidebar")
    kinds.push("command_bar")
    kinds.push("workspace_tabs")
    kinds.push("command_palette")
    kinds.push("toast")
    kinds.push("sheet_modal")
    kinds.push("context_menu")
    kinds.push("inspector")
    kinds.push("utility_rail")
    kinds.push("status_chip")
    kinds.push("selection_pill")
    kinds.push("empty_state")
    var parts: [text] = []
    parts.push("<section id='panel-widgets' role='tabpanel' aria-labelledby='tab-widgets' hidden>")
    parts.push("<h2>Widget examples rendered to HTML</h2>")
    parts.push("<p>Each full-tier widget item as static HTML. Widget chrome is structural markup; the authoritative per-kind lane census (including the honest (no tui) markers) is rendering_items.ui.sdn.</p>")
    parts.push("<div class='flex'>")
    for kind in kinds:
        parts.push(_widget_card(kind, kind))
    parts.push("</div>")
    parts.push("</section>")
    parts.join("\n")

pub fn rendering_web_extended_page() -> text:
    var parts: [text] = []
    parts.push("<!doctype html>")
    parts.push("<html lang='en'>")
    parts.push("<head>")
    parts.push("<meta charset='utf-8'>")
    parts.push("<title>Simple Rendering Showcase — Web Extended</title>")
    parts.push("<style>")
    parts.push("* { box-sizing: border-box; }")
    parts.push("body { margin: 0; font: 16px/1.5 sans-serif; color: #172033; background: #eef2ff; }")
    parts.push("header { position: sticky; top: 0; z-index: 2; display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; color: #ffffff; background: linear-gradient(120deg, #173b7a, #6d28d9); }")
    parts.push(".tabs { position: sticky; top: 64px; z-index: 1; display: flex; gap: 8px; padding: 10px 24px; background: #dbeafe; }")
    parts.push(".tabs button { color: #172033; background: #ffffff; padding: 8px; border: 1px solid #94a3b8; border-radius: 5px; cursor: pointer; }")
    parts.push(".tabs button[aria-selected='true'] { color: #ffffff; background: #4f46e5; }")
    parts.push("[role='tabpanel'][hidden] { display: none; }")
    parts.push("main { width: min(1100px, 100%); margin: auto; padding: 24px; }")
    parts.push("section { margin: 0 0 24px; padding: 20px; border: 1px solid #c7d2fe; border-radius: 12px; background: #ffffff; box-shadow: 0 6px 18px rgba(30,41,59,.12); }")
    parts.push(".flex { display: flex; flex-wrap: wrap; gap: 12px; }")
    parts.push(".card { flex: 1 1 180px; padding: 12px; border-left: 5px solid #4f46e5; background: #eef2ff; }")
    parts.push(".widget-tags { color: #64748b; font-size: 13px; }")
    parts.push(".note { color: #64748b; font-size: 14px; }")
    parts.push(".unsupported { border-color: #f59e0b; background: #fffbeb; }")
    parts.push("label { display: block; margin: 8px 0; }")
    parts.push("input, select, textarea { padding: 8px; border: 1px solid #94a3b8; border-radius: 5px; }")
    parts.push(".scroll { padding: 8px; }")
    parts.push("</style>")
    parts.push("</head>")
    parts.push("<body data-showcase-lane='web' data-tier='extended'>")
    parts.push("<header><strong>Simple Rendering Showcase</strong><span>web extended document</span></header>")
    parts.push("<nav class='tabs' role='tablist' aria-label='Rendering web showcase tabs'>")
    parts.push("<button role='tab' id='tab-core' aria-controls='panel-core' aria-selected='true' tabindex='0'>Core page</button>")
    parts.push("<button role='tab' id='tab-forms-media' aria-controls='panel-forms-media' aria-selected='false' tabindex='-1'>Forms &amp; Media</button>")
    parts.push("<button role='tab' id='tab-animation' aria-controls='panel-animation' aria-selected='false' tabindex='-1'>Animation</button>")
    parts.push("<button role='tab' id='tab-themes' aria-controls='panel-themes' aria-selected='false' tabindex='-1'>Theme gallery</button>")
    parts.push("<button role='tab' id='tab-widgets' aria-controls='panel-widgets' aria-selected='false' tabindex='-1'>Widgets</button>")
    parts.push("</nav>")
    parts.push("<main>")
    parts.push("<section id='panel-core' role='tabpanel' aria-labelledby='tab-core'>")
    parts.push(rendering_web_core_sections())
    parts.push("</section>")
    parts.push(_forms_media_panel())
    parts.push(_animation_panel())
    parts.push(_themes_panel())
    parts.push(_widgets_panel())
    parts.push("</main>")
    parts.push("<script>")
    parts.push("(function () {")
    parts.push("  var tabs = Array.prototype.slice.call(document.querySelectorAll('[role=\"tab\"]'));")
    parts.push("  var panels = Array.prototype.slice.call(document.querySelectorAll('[role=\"tabpanel\"]'));")
    parts.push("  function activate(index) {")
    parts.push("    tabs.forEach(function (tab, i) { tab.setAttribute('aria-selected', i === index ? 'true' : 'false'); });")
    parts.push("    panels.forEach(function (panel, i) { panel.hidden = i !== index; });")
    parts.push("  }")
    parts.push("  tabs.forEach(function (tab, index) { tab.addEventListener('click', function () { activate(index); }); });")
    parts.push("}());")
    parts.push("</script>")
    parts.push("</body>")
    parts.push("</html>")
    parts.join("\n")
