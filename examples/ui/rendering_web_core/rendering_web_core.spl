# Core web page module for the rendering showcases (lane: web, tier: core).
#
# Builds ONE canonical HTML document containing:
#   - multiple text lines: block paragraphs, inline spans, styled runs
#   - one <img src='rendering_fixture.png'> referencing the generated LOCAL
#     fixture file (the engine resource path does not support data URIs)
#   - a fixed-height overflow:auto region exercising the UA scrollbar paint
#     (browser_engine paint.spl paint_scrollbar, 15px track, proportional thumb)
#
# Also owns the deterministic fixture pixel buffer so every entry generates
# byte-identical rendering_fixture.png content.

pub val RENDERING_WEB_FIXTURE_URI: text = "rendering_fixture.png"
pub val RENDERING_WEB_FIXTURE_W: i32 = 96
pub val RENDERING_WEB_FIXTURE_H: i32 = 64

# Deterministic ARGB fixture: horizontal R gradient, vertical G gradient,
# 8px checker B channel, opaque alpha. Non-uniform by construction so a
# blank-or-uniform image check can never pass on it.
pub fn rendering_web_fixture_pixels() -> [u32]:
    var pixels: [u32] = []
    var y: i32 = 0
    while y < RENDERING_WEB_FIXTURE_H:
        var x: i32 = 0
        while x < RENDERING_WEB_FIXTURE_W:
            val r = (x * 255) / (RENDERING_WEB_FIXTURE_W - 1)
            val g = (y * 255) / (RENDERING_WEB_FIXTURE_H - 1)
            val b = if ((x / 8) + (y / 8)) % 2 == 0: 232 else: 40
            val px = 0xFF000000u32 | (r.to_u32() << 16) | (g.to_u32() << 8) | b.to_u32()
            pixels.push(px)
            x = x + 1
        y = y + 1
    pixels

pub fn rendering_web_fixture_checksum() -> i64:
    var sum: i64 = 0
    for px in rendering_web_fixture_pixels():
        sum = (sum + px.to_i64()) % 1000000007
    sum

# The three core sections (text lines, image, scrollbar). Kept separate from
# the document wrapper so the extended tabbed document can embed them verbatim
# in its first tab.
pub fn rendering_web_core_sections() -> text:
    var parts: [text] = []
    parts.push("<section id='panel-text-lines' role='tabpanel' aria-labelledby='tab-core'>")
    parts.push("<h2>Multiple text lines</h2>")
    parts.push("<p>Block paragraph one: the quick brown fox jumps over the lazy dog while packing a box with five dozen liquor jugs.</p>")
    parts.push("<p>Block paragraph two mixes <strong>strong emphasis</strong>, <em>italic stress</em>, <code>inline code span</code>, and <mark>marked text</mark> in one flowing line that wraps across the full width of this container so the line breaking of the layout engine is exercised with realistic prose.</p>")
    parts.push("<p>Inline spans in a sentence: <span class='accent'>an accented inline run</span> followed by <span class='styled-run'>a styled run with its own background</span> and a final <span style='color:#b45309; text-decoration:underline'>inline-styled span</span> on the same line.</p>")
    parts.push("<p>Four short separate lines inside one paragraph.<br/>Second short line.<br/>Third short line.<br/>Fourth short line.</p>")
    parts.push("</section>")
    parts.push("<section id='panel-image'>")
    parts.push("<h2>Image from local fixture</h2>")
    parts.push("<p>The image below is loaded from the generated local fixture file <code>rendering_fixture.png</code>; data URIs are unsupported by the engine resource path, so a relative local path is used.</p>")
    parts.push("<img id='rendering-fixture-img' class='fixture-img' src='rendering_fixture.png' alt='generated rendering fixture' width='192' height='128'/>")
    parts.push("</section>")
    parts.push("<section id='panel-scrollbar'>")
    parts.push("<h2>Scrollable region</h2>")
    parts.push("<p>The fixed-height region below overflows vertically, so the UA paints its vertical scrollbar (15px track, proportional thumb).</p>")
    parts.push("<div class='scroll' id='rendering-scroll-region'>")
    parts.push("Overflow line 01<br/>Overflow line 02<br/>Overflow line 03<br/>Overflow line 04<br/>Overflow line 05<br/>Overflow line 06<br/>Overflow line 07<br/>Overflow line 08<br/>Overflow line 09<br/>Overflow line 10<br/>Overflow line 11<br/>Overflow line 12<br/>Overflow line 13<br/>Overflow line 14")
    parts.push("</div>")
    parts.push("</section>")
    parts.join("\n")

pub fn rendering_web_core_body() -> text:
    var parts: [text] = []
    parts.push("<header><strong>Simple Rendering Showcase</strong> <span>web core page</span></header>")
    parts.push(rendering_web_core_sections())
    parts.join("\n")

pub fn rendering_web_core_page() -> text:
    var parts: [text] = []
    parts.push("<!doctype html>")
    parts.push("<html lang='en'>")
    parts.push("<head>")
    parts.push("<meta charset='utf-8'>")
    parts.push("<title>Simple Rendering Showcase — Web Core</title>")
    parts.push("<style>")
    parts.push("* { box-sizing: border-box; }")
    parts.push("body { margin: 0; font: 16px/1.5 sans-serif; color: #172033; background: #eef2ff; }")
    parts.push("header { padding: 16px 24px; color: #ffffff; background: #173b7a; }")
    parts.push("main { width: min(1100px, 100%); margin: auto; padding: 24px; }")
    parts.push("section { margin: 0 0 24px; padding: 20px; border: 1px solid #c7d2fe; border-radius: 12px; background: #ffffff; box-shadow: 0 6px 18px rgba(30,41,59,.12); }")
    parts.push(".accent { color: #047857; font-weight: bold; }")
    parts.push(".styled-run { color: #4f46e5; background: #eef2ff; padding: 2px 6px; border-radius: 4px; }")
    parts.push(".fixture-img { border: 2px solid #444455; border-radius: 8px; }")
    parts.push(".scroll { height: 96px; overflow: auto; padding: 8px; border: 1px dashed #64748b; scrollbar-track-color: #f1f1f1; scrollbar-thumb-color: #a3a3a3; }")
    parts.push("</style>")
    parts.push("</head>")
    parts.push("<body data-showcase-lane='web' data-tier='core'>")
    parts.push("<main>")
    parts.push(rendering_web_core_body())
    parts.push("</main>")
    parts.push("</body>")
    parts.push("</html>")
    parts.join("\n")
