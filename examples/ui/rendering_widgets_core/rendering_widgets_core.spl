# examples.ui.rendering_widgets_core — shared brief-tier widget set for the
# rendering showcases (lane tui/gui, tier brief).
#
# Owns the core widget set — panel, text, button, list, menubar, statusbar,
# divider, progress — as tree builders the brief entries render:
#   * rendering_widgets_core_tree      -> pixel-host tree (GUI brief entry)
#   * rendering_widgets_core_tui_tree  -> CELL-sized char-grid tree (TUI brief)
#
# Both builders return the root WidgetNode; the entries wrap it with their
# host's build_tree_with_title / UIState construct (host concern, stays in the
# entry). The TUI variant stamps the `sc_prefix` internal prop showcase_apply
# uses to route scripted input to the reducer (same convention as
# showcase_core.showcase_build).

use common.ui.builder.{
    column, panel, label, text_widget, button, checkbox, list_widget,
    menubar, statusbar, divider, progress,
    with_height
}
use common.ui.widget_store_ops.{WidgetNode, set_internal_prop}

# Pixel-host bar height (GUI brief): menubar/statusbar rows are 22px.
val RENDERING_CORE_BAR_H: i32 = 22

# Shared brief-tier menubar entries (both the brief and full trees use them).
fn rendering_core_menu_items() -> [text]:
    ["Overview", "Fonts", "Shapes", "Scroll", "Blend"]

fn rendering_widgets_core_tree(prefix: text) -> WidgetNode:
    """Brief/core widget set for the pixel hosts: one deterministic column —
    menubar, panel(text, button, list, divider, progress), statusbar — in
    pixel geometry (22px bars). This is the tree rendering_gui_core renders."""
    val bar = with_height(menubar("{prefix}_menubar", ["File", "View", "Help"]), RENDERING_CORE_BAR_H)
    val body = panel("{prefix}_panel", "Core Widgets", [
        text_widget("{prefix}_text", "text: the quick brown fox 0123456789"),
        button("{prefix}_button", "button: Apply", "apply"),
        list_widget("{prefix}_list", ["list: alpha", "list: beta", "list: gamma"]),
        divider("{prefix}_divider"),
        progress("{prefix}_progress", 65)
    ])
    val status = with_height(statusbar("{prefix}_status", "ready", "brief tier"), RENDERING_CORE_BAR_H)
    column("{prefix}_root", [bar, body, status])

fn rendering_widgets_core_tui_tree(prefix: text) -> WidgetNode:
    """Brief/core widget set for the char-grid TUI host: the same 8-kind core
    set plus a label and checkbox, CELL-sized (rows are 1-4 grid cells, not
    pixels). showcase_apply recovers the prefix from the `sc_prefix` prop, so
    scripted input reaches the reducer."""
    val bar = with_height(menubar("{prefix}_menu", rendering_core_menu_items()), 1)
    val content = panel("{prefix}_main", "Core Widgets", [
        label("{prefix}_title", "Rendering showcase - TUI brief (core set)"),
        text_widget("{prefix}_body", "panel text button list menubar statusbar divider progress"),
        with_height(button("{prefix}_ok", "OK", "ok"), 1),
        checkbox("{prefix}_chk", "enabled", true),
        divider("{prefix}_div"),
        with_height(list_widget("{prefix}_list", ["panel", "text", "button", "list", "menubar", "statusbar", "divider", "progress"]), 4),
        with_height(progress("{prefix}_prog", 65), 1),
    ])
    val status = with_height(statusbar("{prefix}_status", "ready", "tui brief"), 1)
    val root = column("{prefix}_root", [bar, content, status])
    set_internal_prop(root.id, "sc_prefix", prefix)
    root
