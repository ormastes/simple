# Repro for the deterministic 0x0000001100000001 slot-field value seen
# in-guest: array literals of the parser slot shapes ([0], [text] with "").

fn main():
    var kind_slot: [i64] = [0]
    var text_slot: [text] = [""]
    var line_slot: [i64] = [0]
    var col_slot: [i64] = [0]
    if kind_slot.len() != 1:
        print("FAIL kind len")
        return
    if kind_slot[0] != 0:
        print("FAIL kind elem")
        return
    if text_slot.len() != 1:
        print("FAIL text len")
        return
    if text_slot[0] != "":
        print("FAIL text elem")
        return
    if line_slot.len() != 1 or line_slot[0] != 0:
        print("FAIL line")
        return
    if col_slot.len() != 1 or col_slot[0] != 0:
        print("FAIL col")
        return
    # second construction must be an independent object (dedup check)
    var kind2: [i64] = [0]
    if kind2.len() != 1 or kind2[0] != 0:
        print("FAIL kind2")
        return
    print("ARRAY LITERAL REPRO OK")
