# Minimal reusable IDE render example.
#
# Demonstrates how an embedded/sample IDE can render editor content through the
# shared editor GUI backend and common WebRender envelope without host-only APIs.

use std.editor.backend.gui_backend.*
use std.editor.buffer.buffer.*
use std.editor.common.types.*
use common.ui.web_render_api.{WEB_RENDER_TARGET_PURE_SIMPLE, WebRenderRequest, web_render_to_artifact}

val _IDE_EXAMPLE_CSS: text = """
*{box-sizing:border-box;}
html,body{margin:0;background:#1e1e26;color:#e2e8f0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;}
.editor-area{position:relative;padding:14px 16px;background:#1f222c;min-height:100vh;}
.line{position:relative;display:flex;align-items:baseline;gap:10px;min-height:22px;line-height:22px;padding:1px 6px;}
.line[data-active='true']{background:#2a3142;border-radius:4px;}
.line-num{position:relative;display:inline-block;min-width:32px;color:#64748b;text-align:right;user-select:none;}
.diagnostic-gutter{position:relative;display:inline-block;width:14px;text-align:center;}
.content{position:relative;flex:1 1 auto;white-space:pre-wrap;word-break:break-word;}
"""

fn main() -> i64:
    val buffer = EditorBuffer.from_text(EditorBufferId(value: 1), "# Embedded IDE\n\nfn main() -> i64:\n    0\n")
    val body = gui_render_editor_area(buffer, "markdown", EditorViewport(top_row: 0, left_col: 0, width: 80, height: 8))
    val req = WebRenderRequest.html(WEB_RENDER_TARGET_PURE_SIMPLE, "Embedded Simple IDE", body, _IDE_EXAMPLE_CSS, "", 800, 600)
    val artifact = web_render_to_artifact(req)
    print "target={artifact.target}"
    print "has_editor_source={artifact.html.contains(\"gui-editor-source\")}"
    print "has_markdown_language={artifact.html.contains(\"data-language=\\\"markdown\\\"\")}"
    0
