# TRACE32 CLI standalone entrypoint.
#
# Why this file exists (2026-09-13): `t32_cli_main` was reachable ONLY as a
# subcommand of the pure-Simple full CLI (`src/app/cli/_CliMain/main_and_help.spl`
# dispatches `t32` at lines 311 and 631). No full-CLI pure-Simple binary is
# deployed on Windows, so `bin\simple.cmd t32 --help` reaches the Rust seed
# instead, which has no `t32` verb and answers rc=1 with the generic bootstrap
# HELP. That is the "t32 CLI falls back to interpreter" symptom: there was no
# standalone entry to compile, so the only way to reach the CLI at all was to
# hand the source tree to the seed's interpreter.
#
# This module gives the t32 CLI its own `fn main`, which is the unit
# `native-build` accepts. It adds no behaviour of its own — argument handling
# stays in `app.t32_cli.mod`.

use std.cli.cli_util (get_cli_args)
use app.t32_cli.mod.{t32_cli_main}

fn main() -> i64:
    t32_cli_main(get_cli_args())
    0
