@allow(unnamed_duplicate_typed_args)
# T32 MCP — Small shared helpers used across tool families
use .session_state.{MCP_T32_SESSIONS}

fn t32_key_before_pipe(entry: text) -> text:
    entry.split("|")[0]

pub fn t32_mcp_session_ids() -> [text]:
    var ids: [text] = []
    for s in MCP_T32_SESSIONS:
        ids.push(s.id)
    ids

export t32_mcp_session_ids
