# TRACE32 MCP session state shared by protocol, CLI bridge, and tool handlers.

class McpT32Core:
    core_id: text
    label: text
    instance_binding: text

class McpT32Session:
    id: text
    host: text
    port: i64
    intercom_name: text
    architecture: text
    connected: bool
    cores: [McpT32Core]

class McpT32HistoryItem:
    command: text
    result: text
    session_id: text
    core_id: text
    request_id: text

var MCP_T32_SESSIONS: [McpT32Session] = []
var MCP_T32_CURRENT_SESSION = ""
var MCP_T32_CURRENT_CORE = ""
var MCP_T32_HISTORY: [McpT32HistoryItem] = []
var MCP_T32_AREA_READY = false
var MCP_T32_AREA_NAME = ""

export McpT32Core, McpT32Session, McpT32HistoryItem
export MCP_T32_SESSIONS, MCP_T32_CURRENT_SESSION, MCP_T32_CURRENT_CORE
export MCP_T32_HISTORY, MCP_T32_AREA_READY, MCP_T32_AREA_NAME

fn t32_session_core_count(session: McpT32Session) -> i64:
    session.cores.len()

# @workaround bug=native_array_range_slice_lowering_2026_10_26
# The native producer rejects items[250..]. Preserve the original compaction
# threshold and ordered suffix with indexed, typed storage instead.
fn t32_compact_history(items: [McpT32HistoryItem]) -> [McpT32HistoryItem]:
    if items.len() <= 500:
        return items
    var kept: [McpT32HistoryItem] = []
    var index = 250
    while index < items.len():
        kept = kept.push(items[index])
        index = index + 1
    kept

export t32_session_core_count, t32_compact_history
