use std.io_runtime.{file_exists}
@allow(unnamed_duplicate_typed_args)
# T32 MCP — Action and field tool handlers
# Handles: action_invoke, field_get, field_set, screenshot, history_tail,
#          resources_list, resource_read, dispatch_tool

use ..t32_cli.error_codes.{T4050, T4082, T4090, t32_err_action_not_found, t32_err_missing_param, t32_err_no_session_mcp, t32_err_unknown_tool, t32_err_missing_tool_name, t32_err_resource_not_found}
use .window_tools.{t32_get_window_catalog, t32_get_window_actions, t32_parse_catalog_entry, t32_parse_catalog_entry_with_meta, handle_t32_window_list, handle_t32_window_open, handle_t32_window_capture, handle_t32_window_describe}
use .session_tools.{handle_t32_sessions_list, handle_t32_session_open, handle_t32_session_resume, handle_t32_session_close, handle_t32_core_list, handle_t32_core_select, handle_t32_cmd_run, handle_t32_cmm_run, handle_t32_eval, handle_t32_error_check}
use .headless_tools.{handle_t32_setup_headless, handle_t32_area_read, handle_t32_cmm_commands}
use .gap_tools.{handle_t32_session_info, handle_t32_action_list, handle_t32_status_snapshot, handle_t32_cmm_validate}
use .job_manager.{t32_job_list, t32_job_get, t32_job_cancel, t32_job_to_json}
use .dialog_tools.{handle_t32_dialog_parse, handle_t32_dialog_get, handle_t32_dialog_set, handle_t32_dialog_click}
use .json_helpers.{t32_LB, t32_RB, t32_SB_L, t32_SB_R, t32_escape_json, t32_js, t32_jp, t32_jo1, t32_jo2, t32_extract_field, t32_extract_field_raw, t32_extract_nested, t32_make_error, t32_make_json_result, t32_make_tool_error, t32_make_tool_result}
use .session_tools.{t32_find_current_session, t32_run_remote, t32_add_history}
use .protocol.{t32_validate_identifier, t32_is_hex_address, t32_has_shell_meta}
use .session_state.{MCP_T32_SESSIONS, MCP_T32_CURRENT_CORE, MCP_T32_HISTORY, t32_history_fields}
pub use .tool_common.{t32_mcp_session_ids}

# --- Action/field state ---
# Field state is stored per-session as two parallel flat arrays keyed
# "session_id:field_key". The previous hash-bucket class mutated nested
# arrays (`self.bucket_keys[b].push(..)`), which operated on a copy under
# the seed's array value semantics, so a stored value could never be read
# back (t32_mcp_bugfix_spec "stores and retrieves a value" was red).

var MCP_T32_FIELD_KEYS: [text] = []
var MCP_T32_FIELD_VALUES: [text] = []

fn t32_field_index(lookup: text) -> i64:
    var idx: i64 = 0
    for k in MCP_T32_FIELD_KEYS:
        if k == lookup:
            return idx
        idx = idx + 1
    -1

fn t32_resolve_field_alias(key: text) -> text:
    if key == "pc": return "register.PC"
    if key == "sp": return "register.SP"
    if key == "lr": return "register.LR"
    if key == "cpsr": return "register.CPSR"
    key

fn t32_field_state_get(session_id: text, field_key: text) -> text:
    val idx = t32_field_index(session_id + ":" + field_key)
    if idx < 0:
        return ""
    MCP_T32_FIELD_VALUES[idx]

fn t32_field_state_set(session_id: text, field_key: text, value: text):
    val lookup = session_id + ":" + field_key
    val idx = t32_field_index(lookup)
    if idx >= 0:
        MCP_T32_FIELD_VALUES[idx] = value
        return
    MCP_T32_FIELD_KEYS = MCP_T32_FIELD_KEYS + [lookup]
    MCP_T32_FIELD_VALUES = MCP_T32_FIELD_VALUES + [value]

fn t32_field_state_delete(session_id: text, field_key: text):
    val idx = t32_field_index(session_id + ":" + field_key)
    if idx < 0:
        return
    var keys: [text] = []
    var values: [text] = []
    var i: i64 = 0
    for k in MCP_T32_FIELD_KEYS:
        if i != idx:
            keys.push(k)
            values.push(MCP_T32_FIELD_VALUES[i])
        i = i + 1
    MCP_T32_FIELD_KEYS = keys
    MCP_T32_FIELD_VALUES = values

# --- Helpers for error suggestions ---

fn t32_key_before_pipe(entry: text) -> text:
    entry.split("|")[0]

fn t32_mcp_action_keys() -> [text]:
    val catalog = t32_get_window_catalog()
    var keys: [text] = []
    for entry in catalog:
        val wkey = t32_key_before_pipe(entry)
        val actions = t32_get_window_actions(wkey)
        for aentry in actions:
            keys.push(t32_key_before_pipe(aentry))
    keys

# --- Tool handlers ---

fn handle_t32_action_invoke(id: text, body: text) -> text:
    val action_key = t32_extract_field(body, "action_key")
    val args = t32_extract_field(body, "args")
    if action_key == "":
        return t32_make_tool_error(id, -32602, t32_err_missing_param("action_key", "t32_action_invoke", "t32_action_invoke(action_key: \"<key>\", args: \"<args>\")", "t32_action_invoke(action_key: \"set_break\", args: \"main\")"))
    val session_opt = t32_find_current_session()
    match session_opt:
        nil: return t32_make_tool_error(id, -32602, t32_err_no_session_mcp())
        Some(session):
            # Search for action in all window catalogs
            val catalog = t32_get_window_catalog()
            var found_template = ""
            var found_label = ""
            var found_type = ""
            for entry in catalog:
                var key = ""
                var title = ""
                var kind = ""
                var open_cmd = ""
                var capture_cmd = ""
                (key, title, kind, open_cmd, capture_cmd) = t32_parse_catalog_entry(entry)
                val action_entries = t32_get_window_actions(key)
                for aentry in action_entries:
                    val aparts = aentry.split("|")
                    var akey = ""
                    var alabel = ""
                    var atype = ""
                    var atemplate = ""
                    if aparts.len() > 0:
                        akey = aparts[0]
                    if aparts.len() > 1:
                        alabel = aparts[1]
                    if aparts.len() > 2:
                        atype = aparts[2]
                    if aparts.len() > 3:
                        atemplate = aparts[3]
                    if akey == action_key:
                        found_template = atemplate
                        found_label = alabel
                        found_type = atype
            if found_template == "":
                return t32_make_tool_error(id, -32602, t32_err_action_not_found(action_key, t32_mcp_action_keys()))
            # Substitute args (%0, %1, ...) with provided arguments
            var final_cmd = found_template
            if args != "":
                final_cmd = final_cmd.replace("%0", args)
            var stdout = ""
            var rc: i64 = 0
            (stdout, rc) = t32_run_remote(session, final_cmd)
            t32_add_history("action:" + action_key + " " + final_cmd, stdout.trim(), session.id, MCP_T32_CURRENT_CORE)
            if rc != 0 and rc != -1:
                return t32_make_tool_error(id, -32000, "Action failed (exit " + str(rc) + "): " + stdout.trim())
            if rc == -1:
                return t32_make_tool_error(id, -32000, stdout.trim())
            var r = t32_LB()
            r = r + t32_jp("action_key", t32_js(action_key))
            r = r + "," + t32_jp("label", t32_js(found_label))
            r = r + "," + t32_jp("command", t32_js(final_cmd))
            r = r + "," + t32_jp("output", t32_js(stdout.trim()))
            r = r + "," + t32_jp("status", t32_js("ok"))
            r = r + t32_RB()
            return t32_make_tool_result(id, r)

fn t32_field_to_eval(field_key: text) -> text:
    # Map common field keys to T32 EVAL expressions
    if field_key == "pc":
        return "Register(PC)"
    if field_key == "sp":
        return "Register(SP)"
    if field_key == "lr":
        return "Register(LR)"
    if field_key == "cpsr":
        return "Register(CPSR)"
    if field_key == "r0":
        return "Register(R0)"
    if field_key == "r1":
        return "Register(R1)"
    if field_key == "r2":
        return "Register(R2)"
    if field_key == "r3":
        return "Register(R3)"
    # status.* -> live target-state PRACTICE functions
    if field_key == "status.mode" or field_key == "mode":
        return "DEBUGMODE()"
    if field_key == "status.system" or field_key == "system":
        return "SYStem.MODE()"
    if field_key == "status.trace" or field_key == "trace":
        return "Trace.STATE()"
    if field_key == "status.cursor" or field_key == "cursor":
        return "TRACK.ADDRESS()"
    if t32_is_status_field(field_key):
        return "STATE.RUN()"
    # register.NAME -> Register(NAME); the name is an identifier, never a command
    if field_key.starts_with("register."):
        val reg_name = field_key.substring(9)
        if not t32_validate_identifier(reg_name):
            return ""
        return "Register(" + reg_name + ")"
    # var.NAME -> Var.VALUE(NAME)
    if field_key.starts_with("var."):
        val var_name = field_key.substring(4)
        if not t32_validate_identifier(var_name):
            return ""
        return "Var.VALUE(" + var_name + ")"
    # memory.ADDR -> Data.Long(ADDR); ADDR must be a hex address
    if field_key.starts_with("memory."):
        val addr = field_key.substring(7)
        if not t32_is_hex_address(addr):
            return ""
        return "Data.Long(" + addr + ")"
    # Fallback: raw EVAL expression — refused when it carries shell/command
    # separators, since the text is handed to the T32 remote verbatim.
    if not t32_eval_expr_is_safe(field_key):
        return ""
    field_key

# A raw PRACTICE expression may use parentheses (`PRACTICE.STATE()`), so the
# generic shell-meta check is too strict here; only command separators and
# shell expansion characters are refused.
fn t32_eval_expr_is_safe(expr: text) -> bool:
    for ch in expr:
        if ch == ";" or ch == "|" or ch == "&" or ch == "`" or ch == "$":
            return false
        if ch == "<" or ch == ">" or ch == "\n" or ch == "\r":
            return false
    expr.trim() != ""

# --- Status field helpers (consumed by t32_field_get and status_snapshot) ---

fn t32_is_status_field(field_key: text) -> bool:
    if field_key == "status" or field_key == "status.current":
        return true
    if field_key == "mode" or field_key == "system" or field_key == "trace" or field_key == "cursor":
        return true
    field_key.starts_with("status.")

# Collapse (STATE.RUN(), SYStem.MODE(), DEBUGMODE()) into one of
# running | stopped | disconnected.
fn t32_normalize_current_status(run_state: text, debug_mode: text, system_mode: text) -> text:
    val sys = system_mode.trim().to_lower()
    if sys == "down" or sys == "nodebug" or sys == "":
        return "disconnected"
    if run_state.trim() == "1" or debug_mode.trim().to_lower() == "run":
        return "running"
    "stopped"

fn t32_toolbar_run_enabled(status: text) -> text:
    if status == "stopped":
        return "true"
    "false"

fn t32_toolbar_stop_enabled(status: text) -> text:
    if status == "running":
        return "true"
    "false"

fn handle_t32_field_get(id: text, body: text) -> text:
    val field_key = t32_extract_field(body, "field_key")
    if field_key == "":
        return t32_make_tool_error(id, -32602, t32_err_missing_param("field_key", "t32_field_get", "t32_field_get(field_key: \"<key>\")", "t32_field_get(field_key: \"pc\")"))
    val session_opt = t32_find_current_session()
    match session_opt:
        nil: return t32_make_tool_error(id, -32602, t32_err_no_session_mcp())
        Some(session):
            # Map field key to T32 EVAL expression
            val eval_expr = t32_field_to_eval(field_key)
            if eval_expr == "":
                return t32_make_tool_error(id, -32602, "Rejected field key: " + field_key + ". Use pc/sp/lr/cpsr/r0-r3, register.NAME, var.NAME, memory.0xADDR, status.*, or a PRACTICE expression without ; | & ` $ < >")
            val eval_cmd = "EVAL " + eval_expr
            var stdout = ""
            var rc: i64 = 0
            (stdout, rc) = t32_run_remote(session, eval_cmd)
            t32_add_history("field_get:" + field_key + " -> " + eval_cmd, stdout.trim(), session.id, MCP_T32_CURRENT_CORE)
            var value = stdout.trim()
            if rc != 0 and rc != -1:
                value = "error: " + stdout.trim()
            if rc == -1:
                return t32_make_tool_error(id, -32000, stdout.trim())
            # Also cache in local state
            t32_field_state_set(session.id, field_key, value)
            var r = t32_LB()
            r = r + t32_jp("field_key", t32_js(field_key))
            r = r + "," + t32_jp("value", t32_js(value))
            r = r + "," + t32_jp("eval_expression", t32_js(eval_expr))
            r = r + "," + t32_jp("session_id", t32_js(session.id))
            r = r + t32_RB()
            return t32_make_tool_result(id, r)

fn t32_field_to_set_cmd(field_key: text, value: text) -> text:
    # The value is spliced into a T32 command line: refuse separators/shell meta.
    if value == "" or t32_has_shell_meta(value):
        return ""
    # Map common field keys to T32 set commands
    if field_key == "pc":
        return "Register.Set PC " + value
    if field_key == "sp":
        return "Register.Set SP " + value
    if field_key == "lr":
        return "Register.Set LR " + value
    if field_key == "cpsr":
        return "Register.Set CPSR " + value
    if field_key == "r0":
        return "Register.Set R0 " + value
    if field_key == "r1":
        return "Register.Set R1 " + value
    if field_key == "r2":
        return "Register.Set R2 " + value
    if field_key == "r3":
        return "Register.Set R3 " + value
    # register.NAME -> Register.Set NAME value
    if field_key.starts_with("register."):
        val reg_name = field_key.substring(9)
        if not t32_validate_identifier(reg_name):
            return ""
        return "Register.Set " + reg_name + " " + value
    # var.NAME -> Var.Set NAME = value
    if field_key.starts_with("var."):
        val var_name = field_key.substring(4)
        if not t32_validate_identifier(var_name):
            return ""
        return "Var.Set " + var_name + " = " + value
    # memory.ADDR -> Data.Set ADDR %Long value
    if field_key.starts_with("memory."):
        val addr = field_key.substring(7)
        if not t32_is_hex_address(addr):
            return ""
        return "Data.Set " + addr + " %Long " + value
    # Fallback: raw command
    ""

fn handle_t32_field_set(id: text, body: text) -> text:
    val field_key = t32_extract_field(body, "field_key")
    val value = t32_extract_field(body, "value")
    if field_key == "" or value == "":
        return t32_make_tool_error(id, -32602, t32_err_missing_param("field_key, value", "t32_field_set", "t32_field_set(field_key: \"<key>\", value: \"<value>\")", "t32_field_set(field_key: \"pc\", value: \"0x1000\")"))
    val session_opt = t32_find_current_session()
    match session_opt:
        nil: return t32_make_tool_error(id, -32602, t32_err_no_session_mcp())
        Some(session):
            val set_cmd = t32_field_to_set_cmd(field_key, value)
            if set_cmd == "":
                # No mapping found, cannot set
                return t32_make_tool_error(id, -32602, "Unknown field key for set: " + field_key + ". Use register.NAME, var.NAME, memory.ADDR, or pc/sp/lr/cpsr/r0-r3")
            var stdout = ""
            var rc: i64 = 0
            (stdout, rc) = t32_run_remote(session, set_cmd)
            t32_add_history("field_set:" + field_key + "=" + value + " -> " + set_cmd, stdout.trim(), session.id, MCP_T32_CURRENT_CORE)
            if rc != 0 and rc != -1:
                return t32_make_tool_error(id, -32000, "Field set failed (exit " + str(rc) + "): " + stdout.trim())
            if rc == -1:
                return t32_make_tool_error(id, -32000, stdout.trim())
            # Cache in local state
            t32_field_state_set(session.id, field_key, value)
            var r = t32_LB()
            r = r + t32_jp("field_key", t32_js(field_key))
            r = r + "," + t32_jp("value", t32_js(value))
            r = r + "," + t32_jp("command", t32_js(set_cmd))
            r = r + "," + t32_jp("session_id", t32_js(session.id))
            r = r + "," + t32_jp("status", t32_js("ok"))
            r = r + t32_RB()
            return t32_make_tool_result(id, r)

fn handle_t32_screenshot(id: text, body: text) -> text:
    val window_key = t32_extract_field(body, "window")
    val output_path = t32_extract_field(body, "output_path")
    if window_key == "":
        return t32_make_tool_error(id, -32602, t32_err_missing_param("window", "t32_screenshot", "t32_screenshot(window: \"<key>\")", "t32_screenshot(window: \"register\")"))
    val session_opt = t32_find_current_session()
    match session_opt:
        nil: return t32_make_tool_error(id, -32602, t32_err_no_session_mcp())
        Some(session):
            var out_file = output_path
            if out_file == "":
                out_file = "/tmp/t32_" + window_key + ".bmp"
            # Position the window first (correct WinPOS syntax: no trailing comma)
            val winpos_cmd = "WinPOS 0. 0. 80. 40."
            var stdout1 = ""
            var rc1: i64 = 0
            (stdout1, rc1) = t32_run_remote(session, winpos_cmd)
            # Use SCREEN.DUMP with /BMP format
            val screen_cmd = "SCREEN.DUMP " + out_file + " /BMP"
            var stdout2 = ""
            var rc2: i64 = 0
            (stdout2, rc2) = t32_run_remote(session, screen_cmd)
            t32_add_history("screenshot " + window_key + " -> " + out_file, "ok", session.id, MCP_T32_CURRENT_CORE)
            if rc2 != 0 and rc2 != -1:
                return t32_make_tool_error(id, -32000, "Screenshot failed: " + stdout2.trim())
            if rc2 == -1:
                return t32_make_tool_error(id, -32000, stdout2.trim())
            # Verify file exists
            var file_exists = file_exists(out_file) ?? false
            var status_text = "ok"
            if not file_exists:
                # Fallback: try text-mode capture via PRinTer.FILE
                val printer_cmd = "PRinTer.FILE " + out_file + ".txt"
                var stdout3 = ""
                var rc3: i64 = 0
                (stdout3, rc3) = t32_run_remote(session, printer_cmd)
                status_text = "text_fallback"
                out_file = out_file + ".txt"
            var r = t32_LB()
            r = r + t32_jp("window", t32_js(window_key))
            r = r + "," + t32_jp("output_path", t32_js(out_file))
            r = r + "," + t32_jp("status", t32_js(status_text))
            r = r + t32_RB()
            return t32_make_tool_result(id, r)

fn handle_t32_history_tail(id: text, body: text) -> text:
    val count_str = t32_extract_field(body, "count")
    var count: i64 = 20
    if count_str != "":
        count = int(count_str)
        if count < 1:
            count = 20
    var total: i64 = 0
    for _h in MCP_T32_HISTORY:
        total = total + 1
    var start_idx: i64 = 0
    if total > count:
        start_idx = total - count
    var entries: [text] = []
    var idx: i64 = 0
    for h in MCP_T32_HISTORY:
        if idx >= start_idx:
            val history_fields = t32_history_fields(h)
            var obj = t32_LB()
            obj = obj + t32_jp("command", t32_js(history_fields.0))
            obj = obj + "," + t32_jp("result", t32_js(history_fields.1))
            obj = obj + "," + t32_jp("session_id", t32_js(history_fields.2))
            obj = obj + "," + t32_jp("core_id", t32_js(history_fields.3))
            obj = obj + t32_RB()
            entries = entries.push(obj)
        idx = idx + 1
    val arr = t32_SB_L() + entries.join(",") + t32_SB_R()
    t32_make_tool_result(id, arr)

# --- Resources ---

fn t32_make_resources_list(id: text) -> text:
    var r1 = t32_LB()
    r1 = r1 + t32_jp("uri", t32_js("t32:///sessions"))
    r1 = r1 + "," + t32_jp("name", t32_js("T32 Session Manifest"))
    r1 = r1 + "," + t32_jp("description", t32_js("List of all TRACE32 sessions and their state"))
    r1 = r1 + "," + t32_jp("mimeType", t32_js("application/json"))
    r1 = r1 + t32_RB()
    var r2 = t32_LB()
    r2 = r2 + t32_jp("uri", t32_js("t32:///windows"))
    r2 = r2 + "," + t32_jp("name", t32_js("T32 Window Catalog"))
    r2 = r2 + "," + t32_jp("description", t32_js("Available TRACE32 windows and their metadata"))
    r2 = r2 + "," + t32_jp("mimeType", t32_js("application/json"))
    r2 = r2 + t32_RB()
    var r3 = t32_LB()
    r3 = r3 + t32_jp("uri", t32_js("t32:///history"))
    r3 = r3 + "," + t32_jp("name", t32_js("T32 Command History"))
    r3 = r3 + "," + t32_jp("description", t32_js("Recent TRACE32 command history"))
    r3 = r3 + "," + t32_jp("mimeType", t32_js("application/json"))
    r3 = r3 + t32_RB()
    val resources = t32_SB_L() + r1 + "," + r2 + "," + r3 + t32_SB_R()
    val result = t32_jo1(t32_jp("resources", resources))
    t32_make_json_result(id, result)

fn t32_handle_resource_read(id: text, body: text) -> text:
    val uri = t32_extract_nested(body, "uri")
    if uri == "":
        return t32_make_error(id, -32602, "Missing required parameter: uri")
    if uri == "t32:///sessions":
        # Return sessions as JSON
        var arr = t32_SB_L()
        var first = true
        for s in MCP_T32_SESSIONS:
            if not first:
                arr = arr + ","
            first = false
            var obj = t32_LB()
            obj = obj + t32_jp("id", t32_js(s.id))
            obj = obj + "," + t32_jp("host", t32_js(s.host))
            obj = obj + "," + t32_jp("port", str(s.port))
            obj = obj + "," + t32_jp("architecture", t32_js(s.architecture))
            var conn_str = "false"
            if s.connected:
                conn_str = "true"
            obj = obj + "," + t32_jp("connected", conn_str)
            obj = obj + t32_RB()
            arr = arr + obj
        arr = arr + t32_SB_R()
        val rc = t32_LB()
        val content = rc + t32_jp("uri", t32_js(uri)) + "," + t32_jp("mimeType", t32_js("application/json")) + "," + t32_jp("text", t32_js(t32_escape_json(arr))) + t32_RB()
        val result = t32_jo1(t32_jp("contents", t32_SB_L() + content + t32_SB_R()))
        return t32_make_json_result(id, result)
    if uri == "t32:///windows":
        # Return window catalog as JSON
        val catalog = t32_get_window_catalog()
        var arr = t32_SB_L()
        var first = true
        for entry in catalog:
            var key = ""
            var title = ""
            var kind = ""
            var open_cmd = ""
            var capture_cmd = ""
            var capture_mode = ""
            var arch = ""
            var notes = ""
            (key, title, kind, open_cmd, capture_cmd, capture_mode, arch, notes) = t32_parse_catalog_entry_with_meta(entry)
            if not first:
                arr = arr + ","
            first = false
            var obj = t32_LB()
            obj = obj + t32_jp("window_key", t32_js(key))
            obj = obj + "," + t32_jp("title", t32_js(title))
            obj = obj + "," + t32_jp("kind", t32_js(kind))
            if capture_mode != "":
                obj = obj + "," + t32_jp("capture_mode", t32_js(capture_mode))
            if arch != "":
                obj = obj + "," + t32_jp("arch", t32_js(arch))
            if notes != "":
                obj = obj + "," + t32_jp("notes", t32_js(notes))
            obj = obj + t32_RB()
            arr = arr + obj
        arr = arr + t32_SB_R()
        val rc = t32_LB()
        val content = rc + t32_jp("uri", t32_js(uri)) + "," + t32_jp("mimeType", t32_js("application/json")) + "," + t32_jp("text", t32_js(t32_escape_json(arr))) + t32_RB()
        val result = t32_jo1(t32_jp("contents", t32_SB_L() + content + t32_SB_R()))
        return t32_make_json_result(id, result)
    if uri == "t32:///history":
        # Reuse history_tail logic
        return handle_t32_history_tail(id, body)
    t32_make_error(id, -32002, t32_err_resource_not_found(uri))

# --- Master dispatcher ---

fn t32_dispatch_tool(id: text, body: text) -> text:
    val tool_name = t32_extract_nested(body, "name")
    val args_raw = t32_extract_field_raw(body, "arguments")
    if tool_name == "":
        return t32_make_error(id, -32602, t32_err_missing_tool_name())

    # Session tools
    if tool_name == "t32_sessions_list":
        return handle_t32_sessions_list(id, args_raw)
    elif tool_name == "t32_session_open":
        return handle_t32_session_open(id, args_raw)
    elif tool_name == "t32_session_resume":
        return handle_t32_session_resume(id, args_raw)
    elif tool_name == "t32_session_close":
        return handle_t32_session_close(id, args_raw)
    elif tool_name == "t32_core_list":
        return handle_t32_core_list(id, args_raw)
    elif tool_name == "t32_core_select":
        return handle_t32_core_select(id, args_raw)
    elif tool_name == "t32_cmd_run":
        return handle_t32_cmd_run(id, args_raw)
    elif tool_name == "t32_cmm_run":
        return handle_t32_cmm_run(id, args_raw)
    elif tool_name == "t32_eval":
        return handle_t32_eval(id, args_raw)

    # Window tools
    elif tool_name == "t32_window_list":
        return handle_t32_window_list(id, args_raw)
    elif tool_name == "t32_window_open":
        return handle_t32_window_open(id, args_raw)
    elif tool_name == "t32_window_capture":
        return handle_t32_window_capture(id, args_raw)
    elif tool_name == "t32_window_describe":
        return handle_t32_window_describe(id, args_raw)
    elif tool_name == "t32_screenshot":
        return handle_t32_screenshot(id, args_raw)

    # Action/Field tools
    elif tool_name == "t32_action_invoke":
        return handle_t32_action_invoke(id, args_raw)
    elif tool_name == "t32_field_get":
        return handle_t32_field_get(id, args_raw)
    elif tool_name == "t32_field_set":
        return handle_t32_field_set(id, args_raw)
    elif tool_name == "t32_history_tail":
        return handle_t32_history_tail(id, args_raw)
    elif tool_name == "t32_resources_list":
        return t32_make_resources_list(id)
    elif tool_name == "t32_resource_read":
        return t32_handle_resource_read(id, body)

    # Headless/AREA/Command tools
    elif tool_name == "t32_setup_headless":
        return handle_t32_setup_headless(id, args_raw)
    elif tool_name == "t32_area_read":
        return handle_t32_area_read(id, args_raw)
    elif tool_name == "t32_cmm_commands":
        return handle_t32_cmm_commands(id, args_raw)

    # Gap closure tools
    elif tool_name == "t32_session_info":
        return handle_t32_session_info(id, args_raw)
    elif tool_name == "t32_action_list":
        return handle_t32_action_list(id, args_raw)
    elif tool_name == "t32_status_snapshot":
        return handle_t32_status_snapshot(id, args_raw)
    elif tool_name == "t32_cmm_validate":
        return handle_t32_cmm_validate(id, args_raw)

    # Job tools
    elif tool_name == "t32_job_list":
        val session_filter = t32_extract_field(args_raw, "session_id")
        val jobs = t32_job_list(session_filter)
        var parts: [text] = []
        for job in jobs:
            parts.push(t32_job_to_json(job))
        val result = t32_SB_L() + parts.join(",") + t32_SB_R()
        return t32_make_tool_result(id, result)
    elif tool_name == "t32_job_get":
        val job_id = t32_extract_field(args_raw, "job_id")
        val job = t32_job_get(job_id)
        if job.status == "not_found":
            return t32_make_tool_error(id, -32602, "Job not found: " + job_id)
        return t32_make_tool_result(id, t32_job_to_json(job))
    elif tool_name == "t32_job_cancel":
        val job_id = t32_extract_field(args_raw, "job_id")
        val ok = t32_job_cancel(job_id)
        if ok:
            return t32_make_tool_result(id, t32_jo1(t32_jp("cancelled", "true")))
        return t32_make_tool_error(id, -32000, "Cannot cancel job: " + job_id + " (not found or already terminal)")
    elif tool_name == "t32_job_result":
        val job_id = t32_extract_field(args_raw, "job_id")
        val job = t32_job_get(job_id)
        if job.status == "not_found":
            return t32_make_tool_error(id, -32602, "Job not found: " + job_id)
        if job.status == "completed":
            return t32_make_tool_result(id, t32_jo2(t32_jp("job_id", t32_js(job_id)), t32_jp("result", job.result)))
        if job.status == "failed":
            return t32_make_tool_error(id, -32000, "Job failed: " + job.error)
        return t32_make_tool_error(id, -32000, "Job not yet complete (status: " + job.status + ")")

    # Dialog tools
    elif tool_name == "t32_dialog_parse":
        return handle_t32_dialog_parse(id, args_raw)
    elif tool_name == "t32_dialog_get":
        return handle_t32_dialog_get(id, args_raw)
    elif tool_name == "t32_dialog_set":
        return handle_t32_dialog_set(id, args_raw)
    elif tool_name == "t32_dialog_click":
        return handle_t32_dialog_click(id, args_raw)
    # Error check
    elif tool_name == "t32_error_check":
        return handle_t32_error_check(id, args_raw)

    t32_make_error(id, -32602, t32_err_unknown_tool(tool_name))

export t32_dispatch_tool, t32_make_resources_list, t32_handle_resource_read
export t32_field_state_get, t32_field_state_set, t32_field_state_delete, t32_field_to_eval, t32_field_to_set_cmd
export t32_is_status_field, t32_normalize_current_status, t32_toolbar_run_enabled, t32_toolbar_stop_enabled
