# Stable CMM parser facade. Source parsing belongs to the pure source owner;
# file loading keeps the established configured text-I/O boundary.
use cmm_ast.{CmmProgram}
use cmm_parser_source.{parse_cmm_source as parse_cmm_source_owner, parse_cmm_source_with_policy as parse_cmm_source_with_policy_owner}
use std.io_runtime.{read_file}

export parse_cmm_source, parse_cmm_source_with_policy, parse_cmm_file

fn parse_cmm_source(source: text) -> CmmProgram:
    parse_cmm_source_owner(source)

fn parse_cmm_source_with_policy(source: text, recover_unclosed: bool) -> CmmProgram:
    parse_cmm_source_with_policy_owner(source, recover_unclosed)

fn parse_cmm_file(path: text) -> CmmProgram:
    val source = read_file(path) ?? ""
    var program = parse_cmm_source(source)
    program.file_path = path
    program
