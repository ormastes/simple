# CMM parser runtime compatibility facade.
# Editor/runtime callers retain tolerant unclosed-block recovery, while the
# ordinary parser facade remains strict. Both select one statement owner.
use cmm_ast.{CmmProgram}
use cmm_parser_source.{parse_cmm_source_with_policy}
use std.io_runtime.{read_file}

export parse_cmm_source, parse_cmm_file

fn parse_cmm_source(source: text) -> CmmProgram:
    parse_cmm_source_with_policy(source, true)

fn parse_cmm_file(path: text) -> CmmProgram:
    val source = read_file(path) ?? ""
    var program = parse_cmm_source(source)
    program.file_path = path
    program
