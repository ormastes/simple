#!/bin/sh
# rt_migration_cycle.shs — one SPipe continuous-check cycle for the
# binary_runtime_hardening rt_ migration track (goal: drive the
# check-no-direct-rt baseline to zero mechanically and safely).
#
# One cycle:
#   1. selftest the gate (fatal if broken)
#   2. find UNCALLED rt_ symbols: every repo-wide occurrence of the symbol
#      is an `extern fn` declaration line — no call site, no import, no
#      re-export anywhere. Deleting every declaration of such a symbol
#      cannot change behavior.
#   3. delete them; verify a re-scan finds zero
#   4. run the gate; the baseline must ratchet DOWN or stay equal
#   5. commit only the touched files (never `git add -A` on this shared tree)
#
# Verdict is the last stdout line: PASS/NOOP exit 0, FAIL exit 1, ERROR exit 2.
# Flags: --dry-run (report only, no deletion/commit), --max N (cap deletions).
#
# Invoked by /spipe_loop continuous mode for the rt-migration track.
# Design: doc/03_plan/infra/binary_runtime_hardening/plan.md (Wave 3).

set -u
cd "$(dirname "$0")/../.." || { echo "ERROR — cannot cd to repo root"; exit 2; }

DRY=0
MAX=200
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --max) shift; MAX="$1" ;;
    *) echo "ERROR — unknown argument: $1"; exit 2 ;;
  esac
  shift
done

sh scripts/check/check-no-direct-rt.shs --selftest-only >/dev/null 2>&1
st=$?
if [ $st -ne 0 ]; then echo "ERROR — gate selftest failed"; exit 2; fi

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# Step 2: candidate symbols — declared via `extern fn rt_*` somewhere under
# src/lib or src/app, whose EVERY repo-wide occurrence is a declaration line.
# Two whole-tree scans total (not per-symbol): one for all rt_ token mentions,
# one for declaration lines; compare per-symbol counts. A comment mentioning a
# symbol counts as a mention and keeps it alive — conservative by design.
/usr/bin/grep -rhoE '\brt_[a-z0-9_]+' src --include='*.spl' 2>/dev/null \
  | sort | uniq -c | awk '{print $2, $1}' > "$WORK/mentions.txt"
/usr/bin/grep -rhE '^extern fn rt_[a-z0-9_]+\(' src --include='*.spl' 2>/dev/null \
  | sed -E 's/^extern fn (rt_[a-z0-9_]+)\(.*/\1/' | sort | uniq -c | awk '{print $2, $1}' > "$WORK/decls.txt"
# uncalled: mention count == decl count (every mention IS a declaration).
# Restrict to symbols declared under src/lib or src/app.
/usr/bin/grep -rhE '^extern fn rt_[a-z0-9_]+\(' src/lib src/app --include='*.spl' 2>/dev/null \
  | sed -E 's/^extern fn (rt_[a-z0-9_]+)\(.*/\1/' | sort -u > "$WORK/libapp_declared.txt"
awk 'NR==FNR {m[$1]=$2; next} {d[$1]=$2} END {for (s in d) if (m[s]==d[s]) print s}' \
  "$WORK/mentions.txt" "$WORK/decls.txt" | sort > "$WORK/uncalled_all.txt"
comm -12 "$WORK/uncalled_all.txt" "$WORK/libapp_declared.txt" > "$WORK/uncalled.txt"

# --- Track B: mechanical call-site rewrite to a std.* wrapper -------------
# Table of rt_symbol -> identical-signature provider wrapper, all exported by
# src/lib/nogc_sync_mut/io_runtime.spl (thin passthroughs, verified). Scope:
# files under src/lib/nogc_sync_mut and src/app that DECLARE the extern
# in-file (the decl line becomes the use line, so import placement is exact),
# do not already mention the bare wrapper name (collision guard), do not
# re-export the extern (dangling-export guard), and are not the provider.
# Async families are IN scope: their io_runtime.spl is a re-export facade
# over nogc_sync_mut, so std.io_runtime resolves family-correctly.
# EXCLUDED deliberately: rt_file_read_text (wrapper nil-coalesces to "") —
# bare callers whose nil flows onward need per-site review (track C handles
# the ?? "" subclass). rt_file_write_text TABLED after site audit
# (2026-08-18): 149 sites, 0 directory-probe patterns; the wrapper's
# mkdir-retry is a transparent improvement at every audited site.
# rt_cli_get_args TABLED after nil-audit (2026-08-18): nil is reachable only
# on malloc failure (runtime_native.c:5221 returns nil on OOM); all audited
# callers guard via len()/indexing, so nil->[] is benign.
TB_TABLE="rt_time_now_unix_micros time_now_unix_micros
rt_file_exists file_exists
rt_file_delete file_delete
rt_env_get env_get
rt_getpid getpid
rt_process_run process_run
rt_file_copy file_copy
rt_thread_sleep thread_sleep
rt_sleep_ms thread_sleep
rt_cli_get_args get_args
rt_file_write_text file_write"

track_b() {
  tb_done=0
  : > "$WORK/tb_touched.txt"
  : > "$WORK/tb_pairs.txt"
  printf '%s\n' "$TB_TABLE" | while IFS=' ' read -r sym wrap; do
    [ -n "$sym" ] || continue
    for f in $(/usr/bin/grep -rlE "^extern fn ${sym}\(" src/lib/nogc_sync_mut src/lib/nogc_async_mut src/lib/gc_async_mut src/app --include='*.spl' 2>/dev/null); do
      case "$f" in src/lib/nogc_sync_mut/io_runtime.spl) continue ;; esac
      grep -qE "^export .*\b${sym}\b" "$f" && continue
      # identifier-exact collision guard: tokenize and count identifiers
      # EQUAL to the wrapper name (the old prefix-capture truncated
      # rt_file_write_text to rt_file_write and self-collided every file).
      bare=$(grep -oE '[a-z0-9_]+' "$f" | grep -cx "${wrap}")
      [ "$bare" -gt 0 ] && continue
      sed -i "s/^extern fn ${sym}(.*\$/use std.io_runtime.{${wrap}}/" "$f"
      sed -i "s/\b${sym}(/${wrap}(/g" "$f"
      echo "$f" >> "$WORK/tb_touched.txt"
      echo "$f $sym" >> "$WORK/tb_pairs.txt"
    done
  done
  # --- Track C: rt_file_read_text(X) ?? "" -> read_file_text(X) ---------
  # The wrapper read_file_text(path) IS rt_file_read_text(path) ?? "" (see
  # io_runtime.spl file_read), so ONLY call sites already coalescing to ""
  # are drop-in. A file qualifies when it declares the extern AND every
  # call-position use matches the simple-argument coalesced shape
  # rt_file_read_text(<no-parens-arg>) ?? "". Anything else (bare call whose
  # nil flows onward, ?? other-default, nested-paren arg) leaves the file
  # for per-site review.
  for f in $(/usr/bin/grep -rlE '^extern fn rt_file_read_text\(' src/lib/nogc_sync_mut src/lib/nogc_async_mut src/lib/gc_async_mut src/app --include='*.spl' 2>/dev/null); do
    case "$f" in src/lib/nogc_sync_mut/io_runtime.spl) continue ;; esac
    grep -qE '^export .*\brt_file_read_text\b' "$f" && continue
    bare=$(grep -oE '[a-z_]*read_file_text' "$f" | grep -cv '^rt_file_read_text$')
    [ "$bare" -gt 0 ] && continue
    coalesced=$(grep -cE '^[^#]*\brt_file_read_text\([^()]*\) \?\? ""' "$f")
    [ "$coalesced" -gt 0 ] || continue
    sed -i 's/\brt_file_read_text(\([^()]*\)) ?? ""/read_file_text(\1)/g' "$f"
    remaining=$(grep -cE '^[^#]*\brt_file_read_text\(' "$f")
    if [ "$remaining" -eq 0 ]; then
      # every call migrated: the decl becomes the import
      sed -i 's/^extern fn rt_file_read_text(.*$/use std.io_runtime.{read_file_text}/' "$f"
      echo "$f rt_file_read_text" >> "$WORK/tb_pairs.txt"
    else
      # mixed file: keep the extern for the remaining bare calls and add the
      # import on the line after it
      sed -i '/^extern fn rt_file_read_text(/a use std.io_runtime.{read_file_text}' "$f"
    fi
    # per-site residual: the coalesced pattern itself must be gone
    if grep -qE '^[^#]*\brt_file_read_text\([^()]*\) \?\? ""' "$f"; then
      echo "TRACKC-RESIDUE $f" >> "$WORK/tb_residue.txt"
    fi
    echo "$f" >> "$WORK/tb_touched.txt"
  done
  if [ -s "$WORK/tb_residue.txt" ] 2>/dev/null; then
    echo "FAIL — track C residue: $(wc -l < "$WORK/tb_residue.txt") file(s)"
    exit 1
  fi
  # --- Track D: text<->bytes provider wrappers (signature-exact only) -----
  # std.common.string_core.{text_to_bytes, bytes_to_text} are thin
  # passthroughs. A caller file qualifies only when its extern decl matches
  # the provider signature EXACTLY (param name free, types fixed) — signature
  # variance (e.g. `-> [i64]`) means the caller relies on a different shape
  # and stays manual.
  for pair in "rt_text_to_bytes text_to_bytes text [u8]" "rt_bytes_to_text bytes_to_text [u8] text"; do
    set -- $pair
    sym=$1; wrap=$2
    declre=""
    case "$sym" in
      rt_text_to_bytes) declre='^extern fn rt_text_to_bytes\([a-z_]+: text\) -> \[u8\]$' ;;
      rt_bytes_to_text) declre='^extern fn rt_bytes_to_text\([a-z_]+: \[u8\]\) -> text$' ;;
    esac
    for f in $(/usr/bin/grep -rlE "$declre" src/lib/nogc_sync_mut src/lib/nogc_async_mut src/lib/gc_async_mut src/app --include='*.spl' 2>/dev/null); do
      case "$f" in src/lib/common/string_core.spl) continue ;; esac
      grep -qE "^export .*\b${sym}\b" "$f" && continue
      # identifier-exact collision guard: tokenize and count identifiers
      # EQUAL to the wrapper name (the old prefix-capture truncated
      # rt_file_write_text to rt_file_write and self-collided every file).
      bare=$(grep -oE '[a-z0-9_]+' "$f" | grep -cx "${wrap}")
      [ "$bare" -gt 0 ] && continue
      sed -i -E "s@${declre}@use std.common.string_core.{${wrap}}@" "$f"
      sed -i "s/\b${sym}(/${wrap}(/g" "$f"
      echo "$f" >> "$WORK/tb_touched.txt"
      echo "$f $sym" >> "$WORK/tb_pairs.txt"
    done
  done
  sort -u "$WORK/tb_touched.txt" > "$WORK/tb_touched_u.txt"
  mv "$WORK/tb_touched_u.txt" "$WORK/tb_touched.txt"
  sort -u "$WORK/tb_touched.txt" > "$WORK/tb_touched_u.txt"
  mv "$WORK/tb_touched_u.txt" "$WORK/tb_touched.txt"
  wc -l < "$WORK/tb_touched.txt"
}

n_candidates=$(wc -l < "$WORK/uncalled.txt")
if [ "$n_candidates" -eq 0 ]; then
  echo "cycle: scanned $(wc -l < "$WORK/libapp_declared.txt") declared symbol(s), 0 uncalled (track A converged)"
  if [ $DRY -eq 1 ]; then
    tbc=$(/usr/bin/grep -rlE '^extern fn rt_time_now_unix_micros\(' src/lib/nogc_sync_mut src/lib/nogc_async_mut src/lib/gc_async_mut src/app --include='*.spl' 2>/dev/null | grep -v 'io_runtime.spl' | wc -l)
    echo "PASS — dry-run, track B candidates: $tbc file(s)"
    exit 0
  fi
  nb=$(track_b)
  if [ "$nb" -eq 0 ]; then
    echo "NOOP — nothing safely migratable this cycle (tracks A and B converged)"
    exit 0
  fi
  # residual check: for each (file, symbol) pair actually rewritten, the
  # CALL form of that symbol must be gone from that file. Other table symbols
  # left in the file (their own pass legitimately skipped it) and prose
  # mentions without parens are not residue.
  left=0
  while IFS=' ' read -r rf rsym; do
    c=$(grep -cE "^[^#]*\b${rsym}\(" "$rf" 2>/dev/null)
    left=$((left + c))
  done < "$WORK/tb_pairs.txt"
  if [ "$left" -ne 0 ]; then
    echo "FAIL — $left file(s) still reference a track-B rt_ symbol after rewrite; NOT committing"
    exit 1
  fi
  out=$(sh scripts/check/check-no-direct-rt.shs)
  gate=$?
  verdict=$(printf '%s\n' "$out" | tail -1)
  echo "$verdict"
  [ $gate -ne 0 ] && { echo "FAIL — gate did not pass after track B rewrite"; exit 1; }
  xargs git add < "$WORK/tb_touched.txt"
  git add scripts/check/no_direct_rt_baseline.txt
  git commit -q -m "refactor(rt): spipe cycle track B — rt_ externs -> std.io_runtime wrappers in $nb file(s)

Automated by scripts/spipe/rt_migration_cycle.shs track B: in-file extern
declaration replaced by the use-import at the same position; call sites
renamed to the identical-signature provider wrapper. Gate: $verdict

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>" || { echo "FAIL — commit failed"; exit 1; }
  echo "PASS — track B rewrote $nb file(s), committed; $verdict"
  exit 0
fi

head -"$MAX" "$WORK/uncalled.txt" > "$WORK/batch.txt"
n_batch=$(wc -l < "$WORK/batch.txt")
echo "cycle: $n_candidates uncalled symbol(s), deleting $n_batch this cycle"

if [ $DRY -eq 1 ]; then
  cat "$WORK/batch.txt"
  echo "PASS — dry-run, $n_batch deletable symbol(s) reported"
  exit 0
fi

# Step 3: delete every declaration of each batch symbol; record touched files.
: > "$WORK/touched.txt"
while IFS= read -r sym; do
  /usr/bin/grep -rlE "^extern fn ${sym}\(" src --include='*.spl' >> "$WORK/touched.txt" 2>/dev/null
  for f in $(/usr/bin/grep -rlE "^extern fn ${sym}\(" src --include='*.spl' 2>/dev/null); do
    sed -i "/^extern fn ${sym}(/d" "$f"
  done
done < "$WORK/batch.txt"
sort -u "$WORK/touched.txt" > "$WORK/touched_u.txt"

# verify: none of the batch symbols remain anywhere
left=0
while IFS= read -r sym; do
  c=$(/usr/bin/grep -rE "\b${sym}\b" src --include='*.spl' 2>/dev/null | wc -l)
  left=$((left + c))
done < "$WORK/batch.txt"
if [ "$left" -ne 0 ]; then
  echo "FAIL — $left residual reference(s) after deletion; NOT committing"
  exit 1
fi

# Step 4: gate must ratchet down or hold.
out=$(sh scripts/check/check-no-direct-rt.shs)
gate=$?
verdict=$(printf '%s\n' "$out" | tail -1)
echo "$verdict"
if [ $gate -ne 0 ]; then
  echo "FAIL — gate did not pass after deletion"
  exit 1
fi

# Step 5: scoped commit.
n_files=$(wc -l < "$WORK/touched_u.txt")
xargs git add < "$WORK/touched_u.txt"
xargs git add scripts/check/no_direct_rt_baseline.txt < /dev/null
git commit -q -m "refactor(rt): spipe cycle — delete $n_batch uncalled rt_ extern symbol(s) across $n_files file(s)

Automated by scripts/spipe/rt_migration_cycle.shs: every occurrence of each
symbol repo-wide was an extern declaration (no call sites, verified pre- and
post-deletion). Gate: $verdict

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>"
ci=$?
if [ $ci -ne 0 ]; then echo "FAIL — commit failed"; exit 1; fi
echo "PASS — $n_batch symbol(s) deleted in $n_files file(s), committed; $verdict"
exit 0
