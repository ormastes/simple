#!/bin/sh
# keygen-pq.shs — generate a stateful hash-based signing key
# (wots-merkle-sha256-w16-h8) and its committed public trust root.
#
#   sh scripts/trust/keygen-pq.shs --name NAME [--key-dir DIR] --out config/trust/NAME.pub
#                                  [--jobs N]
#
# Private state lands in DIR (default $HOME/.config/simple/keys/NAME, mode
# 0700) and NEVER in the repo. Only the public root file is written to --out.
# Idempotent: refuses to overwrite an existing key dir or an existing --out.
# Seeds are never printed.
#
# Cost: 256 leaves x 67 chains x 16 hashes ~= 275k SHA-256 invocations; leaves
# are computed by --jobs background workers (default 8) so a keygen takes a few
# minutes rather than tens of them.

set -u

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
. "$SCRIPT_DIR/pq-sign-lib.shs"

NAME=""
KEY_DIR=""
OUT=""
JOBS=8

usage() {
    printf '%s\n' "usage: keygen-pq.shs --name NAME [--key-dir DIR] --out FILE [--jobs N]" >&2
    exit 2
}

while [ $# -gt 0 ]; do
    case "$1" in
        --name) [ $# -ge 2 ] || usage; NAME=$2; shift 2 ;;
        --key-dir) [ $# -ge 2 ] || usage; KEY_DIR=$2; shift 2 ;;
        --out) [ $# -ge 2 ] || usage; OUT=$2; shift 2 ;;
        --jobs) [ $# -ge 2 ] || usage; JOBS=$2; shift 2 ;;
        -h|--help) usage ;;
        *) usage ;;
    esac
done

[ -n "$NAME" ] || usage
[ -n "$OUT" ] || usage
case "$NAME" in
    *[!A-Za-z0-9._-]*) pq_die "key name must match [A-Za-z0-9._-]" ;;
esac
case "$JOBS" in
    ''|*[!0-9]*|0) pq_die "--jobs must be a positive integer" ;;
esac
[ -n "$KEY_DIR" ] || KEY_DIR="${HOME:?HOME unset}/.config/simple/keys/$NAME"

if [ -e "$KEY_DIR" ]; then
    pq_die "refusing to overwrite existing key dir $KEY_DIR (keys are stateful; delete it deliberately if you really mean to rotate)"
fi
if [ -e "$OUT" ]; then
    pq_die "refusing to overwrite existing public root $OUT"
fi

umask 077
mkdir -p "$(dirname "$KEY_DIR")" || pq_die "cannot create parent of $KEY_DIR"
mkdir "$KEY_DIR" || pq_die "cannot create $KEY_DIR"
chmod 700 "$KEY_DIR"

SK_SEED=$(pq_random_hex32)
PUB_SEED=$(pq_random_hex32)
printf '%s\n' "$SK_SEED" > "$KEY_DIR/sk_seed"
printf '%s\n' "$PUB_SEED" > "$KEY_DIR/pub_seed"
chmod 600 "$KEY_DIR/sk_seed" "$KEY_DIR/pub_seed"

LEAF_DIR="$KEY_DIR/leaves.tmp"
mkdir "$LEAF_DIR" || pq_die "cannot create $LEAF_DIR"

printf '%s\n' "keygen-pq: computing $PQ_LEAVES one-time leaves with $JOBS workers (this takes minutes)"

# Worker w computes leaves w, w+JOBS, w+2*JOBS, ...
w=0
while [ "$w" -lt "$JOBS" ]; do
    (
        i=$w
        while [ "$i" -lt "$PQ_LEAVES" ]; do
            leaf=$(pq_leaf "$SK_SEED" "$PUB_SEED" "$i")
            pq_is_hex64 "$leaf" || exit 1
            printf '%s\n' "$leaf" > "$LEAF_DIR/$i.tmp" && mv "$LEAF_DIR/$i.tmp" "$LEAF_DIR/$i"
            i=$((i + JOBS))
        done
    ) &
    w=$((w + 1))
done
wait

i=0
while [ "$i" -lt "$PQ_LEAVES" ]; do
    [ -f "$LEAF_DIR/$i" ] || pq_die "leaf $i was not produced; key dir $KEY_DIR is incomplete — delete it and retry"
    i=$((i + 1))
done

ROOT=$(pq_build_tree "$LEAF_DIR" "$KEY_DIR/tree")
pq_is_hex64 "$ROOT" || pq_die "tree build failed"
rm -rf "$LEAF_DIR"

KEY_ID="$NAME-$(printf '%s' "$ROOT" | cut -c1-12)"
printf '%s\n' "$ROOT" > "$KEY_DIR/root"
printf '%s\n' "$KEY_ID" > "$KEY_DIR/key_id"
printf '%s\n' 0 > "$KEY_DIR/next_leaf"

CREATED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
mkdir -p "$(dirname "$OUT")" || pq_die "cannot create parent of $OUT"
umask 022
{
    printf 'alg=%s\n' "$PQ_ALG"
    printf 'key_id=%s\n' "$KEY_ID"
    printf 'root=%s\n' "$ROOT"
    printf 'pub_seed=%s\n' "$PUB_SEED"
    printf 'created_utc=%s\n' "$CREATED"
    printf 'revocation_epoch=1\n'
    printf 'tree_height=%s\n' "$PQ_TREE_HEIGHT"
    printf 'max_signatures=%s\n' "$PQ_LEAVES"
} > "$OUT.tmp.$$" && mv "$OUT.tmp.$$" "$OUT"

printf '%s\n' "keygen-pq: key_id=$KEY_ID"
printf '%s\n' "keygen-pq: root=$ROOT"
printf '%s\n' "keygen-pq: private state in $KEY_DIR (never commit this directory)"
printf '%s\n' "keygen-pq: public root written to $OUT"
