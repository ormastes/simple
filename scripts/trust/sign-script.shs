#!/bin/sh
# sign-script.shs — sign files with a stateful hash-based key
# (wots-merkle-sha256-w16-h8). Writes FILE.sig next to each FILE.
#
#   sh scripts/trust/sign-script.shs --name NAME [--key-dir DIR] FILE...
#
# State discipline (this is what makes a one-time-signature key safe):
#   * next_leaf is bumped ATOMICALLY (tmp + mv) BEFORE any signature bytes are
#     derived or emitted, so a crash mid-signature burns the leaf rather than
#     reusing it. A leaf used twice leaks enough chain values to forge.
#   * A key with next_leaf >= 256 is exhausted and signing is refused.
#   * Seeds are never printed.

set -u

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
. "$SCRIPT_DIR/pq-sign-lib.shs"

NAME=""
KEY_DIR=""

usage() {
    printf '%s\n' "usage: sign-script.shs --name NAME [--key-dir DIR] FILE..." >&2
    exit 2
}

while [ $# -gt 0 ]; do
    case "$1" in
        --name) [ $# -ge 2 ] || usage; NAME=$2; shift 2 ;;
        --key-dir) [ $# -ge 2 ] || usage; KEY_DIR=$2; shift 2 ;;
        -h|--help) usage ;;
        --) shift; break ;;
        -*) usage ;;
        *) break ;;
    esac
done

[ -n "$NAME" ] || [ -n "$KEY_DIR" ] || usage
[ $# -ge 1 ] || usage
[ -n "$KEY_DIR" ] || KEY_DIR="${HOME:?HOME unset}/.config/simple/keys/$NAME"

pq_load_key "$KEY_DIR"

# pq_sign_one FILE: consumes one leaf, writes FILE.sig. Prints the leaf used.
pq_sign_one() {
    _file=$1
    [ -f "$_file" ] || pq_die "no such file: $_file"
    read -r _leaf < "$KEY_DIR/next_leaf"
    case "$_leaf" in
        ''|*[!0-9]*) pq_die "next_leaf malformed" ;;
    esac
    if [ "$_leaf" -ge "$PQ_LEAVES" ]; then
        pq_die "key $PQ_KEY_ID is exhausted (next_leaf=$_leaf >= $PQ_LEAVES); rotate the key"
    fi
    # Bump FIRST. If anything after this fails the leaf is simply burned.
    pq_atomic_write "$KEY_DIR/next_leaf" "$((_leaf + 1))"
    read -r _check < "$KEY_DIR/next_leaf"
    [ "$_check" -eq $((_leaf + 1)) ] || pq_die "next_leaf bump did not persist; refusing to sign"

    _m=$(pq_msg_digest "$_file")
    set -- $(pq_digits_of "$_m")
    _sig=""
    _j=0
    for _b in "$@"; do
        _sk=$(pq_chain_key "$PQ_SK_SEED" "$_leaf" "$_j")
        _s=$(pq_f_n "$PQ_PUB_SEED" "$_sk" "$_b")
        _sig="$_sig$_s"
        _j=$((_j + 1))
    done
    _auth=$(pq_auth_path "$KEY_DIR/tree" "$_leaf" | tr -d '\n')
    [ "${#_sig}" -eq $((PQ_CHAINS * 64)) ] || pq_die "internal: sig length ${#_sig}"
    [ "${#_auth}" -eq $((PQ_TREE_HEIGHT * 64)) ] || pq_die "internal: auth length ${#_auth}"
    _out="$_file.sig"
    {
        printf 'alg=%s\n' "$PQ_ALG"
        printf 'key_id=%s\n' "$PQ_KEY_ID"
        printf 'leaf=%s\n' "$_leaf"
        printf 'sig=%s\n' "$_sig"
        printf 'auth=%s\n' "$_auth"
    } > "$_out.tmp.$$" && mv -f "$_out.tmp.$$" "$_out" || pq_die "cannot write $_out"
    printf '%s\n' "sign-script: $_file -> $_out (key_id=$PQ_KEY_ID leaf=$_leaf)"
}

for f in "$@"; do
    pq_sign_one "$f"
done
