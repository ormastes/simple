#!/bin/sh
# recursion_guard.shs — env-depth recursion guard for the repo's .shs scripts.
#
# Mirrors src/app/llm_caret/agent_workspace.spl (LLM_CARET_WORKSPACE_DEPTH,
# refuse at MAX_DEPTH): every guarded script bumps SIMPLE_SHS_DEPTH in its
# environment, so a script that re-invokes itself (directly, or through a
# chain of guarded scripts) is refused once the depth reaches the limit,
# instead of forking until the box falls over.
#
# Usage (first non-comment statement of a script):
#   . "${0%/*}/../lib/recursion_guard.shs"
#
# Env:
#   SIMPLE_SHS_DEPTH        current depth (integer, default 0; exported +1)
#   SIMPLE_SHS_MAX_DEPTH    refuse when depth >= this (default 3)
#   SIMPLE_SHS_GUARD_CHAIN  optional; when set (even empty) the script name is
#                           appended so the FAIL line shows the whole chain
#
# On refusal, ONE line goes to stderr and the sourcing script exits 3:
#   recursion-guard: FAIL — <script> refused at depth N (max M); set SIMPLE_SHS_MAX_DEPTH to raise
#
# Selftest:  sh scripts/lib/recursion_guard.shs --selftest
#   Last stdout line: `recursion-guard selftest: PASS — <n> fixture(s)` exit 0
#   or `recursion-guard selftest: FAIL — ...` exit 1.
#
# PERF: only shell builtins (parameter expansion, case, arithmetic, export).
# No subprocess, no file I/O. Measured 2026-08-25 on this host (dash 0.5.12,
# shared box): 1000 sourced iterations in 60 ms wall (incl. sh startup) =
# ~0.06 ms/source (`time sh -c` over a while-loop of `SIMPLE_SHS_DEPTH=0;
# . guard`); the selftest measured 56 us/source over 200 iterations;
# the selftest re-measures 200 iterations and fails above 1 ms/source.

# --- guard body (runs on every source) -------------------------------------
case "${SIMPLE_SHS_DEPTH:-}" in
    ''|*[!0-9]*) _rg_depth=0 ;;
    *) _rg_depth=$SIMPLE_SHS_DEPTH ;;
esac
case "${SIMPLE_SHS_MAX_DEPTH:-}" in
    ''|*[!0-9]*) _rg_max=3 ;;
    *) _rg_max=$SIMPLE_SHS_MAX_DEPTH ;;
esac
_rg_name=${0##*/}
if [ -n "${SIMPLE_SHS_GUARD_CHAIN+x}" ]; then
    SIMPLE_SHS_GUARD_CHAIN="${SIMPLE_SHS_GUARD_CHAIN:+$SIMPLE_SHS_GUARD_CHAIN > }$_rg_name"
    export SIMPLE_SHS_GUARD_CHAIN
    _rg_name=$SIMPLE_SHS_GUARD_CHAIN
fi
if [ "$_rg_depth" -ge "$_rg_max" ]; then
    echo "recursion-guard: FAIL — $_rg_name refused at depth $_rg_depth (max $_rg_max); set SIMPLE_SHS_MAX_DEPTH to raise" >&2
    unset _rg_depth _rg_max _rg_name
    exit 3
fi
SIMPLE_SHS_DEPTH=$((_rg_depth + 1))
export SIMPLE_SHS_DEPTH
unset _rg_depth _rg_max _rg_name

# --- selftest (only when EXECUTED as this file, never when sourced) --------
case "$0" in
    *recursion_guard.shs) ;;
    *) return 0 2>/dev/null || exit 0 ;;
esac
[ "${1:-}" = "--selftest" ] || exit 0
# re-sourced by fixture (d) below with $0 still this file: do not recurse
[ -z "${_rg_selftest_running:-}" ] || return 0
_rg_selftest_running=1

_rg_self=$(cd "$(dirname "$0")" && pwd)/recursion_guard.shs
_rg_tmp_parent=/mnt/data/tmp/claude-1000
mkdir -p "$_rg_tmp_parent"
_rg_tmp=$(mktemp -d "$_rg_tmp_parent/recursion_guard_selftest.XXXXXX")
_rg_pass=0
_rg_fail=0
_rg_ok() { _rg_pass=$((_rg_pass + 1)); echo "  ok   - $1"; }
_rg_ko() { _rg_fail=$((_rg_fail + 1)); echo "  FAIL - $1"; }

# (a) a plain script sourcing the guard at depth 0 runs
cat > "$_rg_tmp/plain.shs" <<EOF
. "$_rg_self"
echo "plain-ran depth=\$SIMPLE_SHS_DEPTH"
EOF
_rg_out=$(env -u SIMPLE_SHS_DEPTH -u SIMPLE_SHS_MAX_DEPTH sh "$_rg_tmp/plain.shs" 2>&1)
_rg_rc=$?
if [ "$_rg_rc" -eq 0 ] && [ "$_rg_out" = "plain-ran depth=1" ]; then
    _rg_ok "depth-0 script runs and exports depth 1"
else
    _rg_ko "depth-0 script: rc=$_rg_rc out=$_rg_out"
fi

# (b) a self-invoking script is stopped with exit 3 after exactly MAX invocations
cat > "$_rg_tmp/selfinvoke.shs" <<EOF
. "$_rg_self"
echo "invocation depth=\$SIMPLE_SHS_DEPTH"
exec sh "\$0"
EOF
_rg_out=$(env -u SIMPLE_SHS_DEPTH -u SIMPLE_SHS_MAX_DEPTH sh "$_rg_tmp/selfinvoke.shs" 2>"$_rg_tmp/err")
_rg_rc=$?
_rg_n=0
for _rg_l in $_rg_out; do case "$_rg_l" in invocation) _rg_n=$((_rg_n + 1)) ;; esac; done
_rg_err=$(cat "$_rg_tmp/err")
case "$_rg_err" in
    "recursion-guard: FAIL — selfinvoke.shs refused at depth 3 (max 3); set SIMPLE_SHS_MAX_DEPTH to raise") _rg_line_ok=1 ;;
    *) _rg_line_ok=0 ;;
esac
if [ "$_rg_rc" -eq 3 ] && [ "$_rg_n" -eq 3 ] && [ "$_rg_line_ok" -eq 1 ]; then
    _rg_ok "self-invoking script stopped: exit 3 after 3 invocations, FAIL line printed"
else
    _rg_ko "self-invoking script: rc=$_rg_rc invocations=$_rg_n stderr=$_rg_err"
fi

# (c) SIMPLE_SHS_MAX_DEPTH override is honoured (also exercises the chain)
_rg_out=$(env -u SIMPLE_SHS_DEPTH SIMPLE_SHS_MAX_DEPTH=5 SIMPLE_SHS_GUARD_CHAIN= sh "$_rg_tmp/selfinvoke.shs" 2>"$_rg_tmp/err")
_rg_rc=$?
_rg_n=0
for _rg_l in $_rg_out; do case "$_rg_l" in invocation) _rg_n=$((_rg_n + 1)) ;; esac; done
_rg_err=$(cat "$_rg_tmp/err")
case "$_rg_err" in
    *"selfinvoke.shs > selfinvoke.shs > selfinvoke.shs > selfinvoke.shs > selfinvoke.shs > selfinvoke.shs refused at depth 5 (max 5)"*) _rg_line_ok=1 ;;
    *) _rg_line_ok=0 ;;
esac
if [ "$_rg_rc" -eq 3 ] && [ "$_rg_n" -eq 5 ] && [ "$_rg_line_ok" -eq 1 ]; then
    _rg_ok "SIMPLE_SHS_MAX_DEPTH=5 honoured: 5 invocations, chain shown in FAIL line"
else
    _rg_ko "max-depth override: rc=$_rg_rc invocations=$_rg_n stderr=$_rg_err"
fi

# (d) overhead per source < 1 ms over 200 iterations (builtins only inside the loop)
_rg_t0=$(date +%s%N)
_rg_i=0
while [ "$_rg_i" -lt 200 ]; do
    SIMPLE_SHS_DEPTH=0
    . "$_rg_self"
    _rg_i=$((_rg_i + 1))
done
_rg_t1=$(date +%s%N)
_rg_us=$(( (_rg_t1 - _rg_t0) / 1000 / 200 ))
if [ "$_rg_us" -lt 1000 ]; then
    _rg_ok "overhead ${_rg_us} us/source over 200 iterations (< 1000 us)"
else
    _rg_ko "overhead ${_rg_us} us/source over 200 iterations (>= 1000 us)"
fi

rm -rf "$_rg_tmp"
if [ "$_rg_fail" -eq 0 ]; then
    echo "recursion-guard selftest: PASS — $_rg_pass fixture(s)"
    exit 0
fi
echo "recursion-guard selftest: FAIL — $_rg_fail of $((_rg_pass + _rg_fail)) fixture(s) failed"
exit 1
