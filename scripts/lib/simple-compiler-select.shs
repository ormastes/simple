#!/usr/bin/env sh
# Shared, capability-probing selection of a usable Simple compiler.
#
# WHY THIS EXISTS
# ---------------
# ~60 scripts in this repo discovered a compiler with some variant of
#
#     for candidate in release/*/simple bin/release/*/simple ...; do
#         [ -x "$candidate" ] && SIMPLE=$candidate && break
#     done
#
# That shape is fail-OPEN in three independent ways, all three measured on this
# host on 2026-08-06 (see
# doc/08_tracking/bug/deployed_selfhost_env_set_miscompile_segv_2026-07-14.md):
#
#   D-A  It takes the FIRST executable and (at best) rejects it by aborting,
#        so discovery can never reach a working compiler sitting later in the
#        list. bin/release/*/simple is a Rust bootstrap SEED copy today, so
#        auto-discovery terminated on the seed.
#   D-B  bin/release/x86_64-unknown-simpleos/simple -- the SimpleOS PAYLOAD, a
#        cross-target ELF that this very toolchain produces -- matches the same
#        glob. It is executable, fails to exec with rc=126 and NO output, and
#        therefore passed every "reject on rc>=128 or on bad output" filter.
#        The payload was a live candidate to be selected as its OWN builder.
#   D-C  A `--help` probe proves nothing. release/x86_64-unknown-linux-gnu/simple
#        links the obsolete TWO-argument rt_env_set and SIGSEGVs on the first
#        environment write, yet exits 0 on `--help` / `native-build --help`
#        because those return before any env var is set.
#
# So selection here is a POSITIVE CAPABILITY SEARCH: a candidate is admitted
# only by demonstrating the capability the caller needs, and the search
# CONTINUES past every rejection instead of aborting on the first one.
#
# TWO TIERS
# ---------
# Most callers (the evidence gates) only need "a host compiler that can run a
# .spl". They must NOT be forced to satisfy the native-build contract, or they
# would go red on a compiler that is perfectly fine for their purpose.
#
#   core     (every caller)  not a bootstrap seed
#                            AND `check <trivial.spl>` exits rc==0
#   builder  (--builder-target <triple>)  core, AND
#                            `native-build --target <triple> --help` rc==0
#                            AND prints the "Simple Native Build" banner
#                            AND advertises --runtime-bundle
#
# rc==0 (not "did not die by signal") is the core predicate on purpose: it is a
# single test that rejects the payload (rc=126 exec failure), the stale-ABI
# binary (rc=139 SIGSEGV), a crash-dumping stage (rc=139), and a binary with no
# `check` subcommand at all (rc=127). "rc < 128" would ADMIT the payload.
#
# `check` is the env-write probe: it drives rt_env_set -> SIMPLE_BOOTSTRAP_* on
# ast_reset, which is exactly the call that kills the stale binary, and it is
# fast.
#
# USAGE (as a library -- this file never `set -e`s and never exits)
# -----------------------------------------------------------------
#     . "$ROOT_DIR/scripts/lib/simple-compiler-select.shs"
#
#     SIMPLE_BIN="$(simple_compiler_select --root "$ROOT_DIR")" \
#         || { echo "no usable compiler" >&2; exit 1; }
#
#     # builder callers:
#     COMPILER="$(simple_compiler_select --root "$ROOT_DIR" \
#                     --builder-target x86_64-unknown-simpleos)" || exit 1
#
# Predicates are also exported for callers that already have a path:
#     simple_compiler_is_seed   <bin>              rc0 = it IS the Rust seed
#     simple_compiler_usable    <bin> [triple]     rc0 = passes core (+builder)
#
# An explicit operator choice is honoured via $SIMPLE_BUILD_COMPILER, but it is
# still capability-probed -- an explicit choice has to be able to do the job.
# A deliberate seed selection warns rather than aborting (D1 route-around).
#
# USAGE (as a command)
# --------------------
#     sh scripts/lib/simple-compiler-select.shs --self-test
#     sh scripts/lib/simple-compiler-select.shs [--builder-target <triple>]
#
# The --self-test mode pins the discriminations against the known-good and
# known-bad binaries in this tree so the guard cannot silently rot. Convention
# follows scripts/os/make_os_disk.shs --self-test.

# Seconds allowed per probe invocation. Deliberately small: every binary we
# need to reject fails fast, and a hang is itself a rejection.
SIMPLE_COMPILER_PROBE_TIMEOUT="${SIMPLE_COMPILER_PROBE_TIMEOUT:-25}"

# The default search order. build/bootstrap/{stage3,stage2} hold the pure-Simple
# staged compilers and outrank whatever happens to be sitting in release/.
# release/ and bin/release/ are searched LAST and only on their merits -- both
# currently hold binaries that fail the probe.
simple_compiler_default_candidates() {
    _scs_root="${1:-.}"
    # NOTE the bare-name collision: this repo has BOTH a top-level bootstrap/
    # tree and a build/bootstrap/ tree, holding DIFFERENT binaries. Searching
    # only one of them (as the reference implementation did) silently misses
    # half the staged compilers. Both are listed.
    printf '%s\n' \
        "$_scs_root"/build/bootstrap/stage3/*/simple \
        "$_scs_root"/build/bootstrap/stage3/simple \
        "$_scs_root"/bootstrap/stage3/*/simple \
        "$_scs_root"/bootstrap/stage3/simple \
        "$_scs_root"/build/bootstrap/stage2/*/simple \
        "$_scs_root"/build/bootstrap/stage2/simple \
        "$_scs_root"/bootstrap/stage2/*/simple \
        "$_scs_root"/bootstrap/stage2/simple \
        "$_scs_root"/release/*/simple \
        "$_scs_root"/bin/release/*/simple \
        "$_scs_root"/bin/simple
}

# Matches on "<path>:<version output>", NOT on the version output alone. Three
# existing callers (build_clang_disk.shs, build_fsexec_prod_ring3.shs,
# socket_echo_loopback_gate.shs) already keyed off "$COMPILER:$PROVENANCE" so
# that a seed is caught by its PATH (…/compiler_rust/…, …simple_seed…) even when
# its --version output is silent. Dropping the path half would regress them.
simple_compiler_is_seed() {
    _scs_ver="$(timeout "$SIMPLE_COMPILER_PROBE_TIMEOUT" "$1" --version 2>&1 || true)"
    case "$1:$_scs_ver" in
        *"bootstrap seed only"*|*compiler_rust*|*simple_seed*) return 0 ;;
        *) return 1 ;;
    esac
}

# Core tier: survive a command that actually WRITES the environment.
#
# THE VACUITY TRAP (measured 2026-08-06 -- this is why the probe is a LADDER)
# --------------------------------------------------------------------------
# The obvious probe is `<bin> check <trivial.spl>`: it drives rt_env_set ->
# SIMPLE_BOOTSTRAP_* on ast_reset, which is exactly the call that kills the
# stale two-arg-ABI binary. And it does reject that binary (rc=139).
#
# But the staged bootstrap compilers DO NOT IMPLEMENT `check`:
#
#     $ build/bootstrap/stage2/x86_64-unknown-linux-gnu/simple check p.spl
#     error: unknown command 'check'          # rc=1, no signal
#
# Under a "reject only signal deaths" rule that rc=1 reads as a PASS -- so the
# probe accepts stage2 having never executed one line of its pipeline. It is
# accepted for the wrong reason. An unimplemented subcommand is NOT evidence of
# health, so the ladder falls through to a second rung.
#
# SECOND-RUNG FALSE NEGATIVE (measured 2026-08-06, fixed same day): the second
# rung used to be `compile p.spl --format=smf`. That rejected
# build/bootstrap/stage2/x86_64-unknown-linux-gnu/simple (rc=139, SIGSEGV) --
# but that binary's `native-build` path, exercised for real (not `--help`),
# compiles AND LINKS the same fixture cleanly (rc=0, runnable output) and was
# independently used by another lane to produce a clean aarch64 payload. The
# SMF serializer is a narrow, independently-broken code path that is not on
# the critical path any real caller of this selector exercises -- every caller
# needs `native-build`, none need raw `compile --format=smf`. A probe rung must
# test the capability callers actually use, or a rung failure that is
# irrelevant to the caller becomes a false-negative rejection of a working
# compiler -- exactly the mirror image of the fail-open defect this file
# exists to fix. The second rung is now a real (non---help) `native-build`
# invocation against the trivial fixture, which still SIGSEGVs (rc=139) on the
# stale two-arg-ABI binary (verified) and on every other known-bad candidate in
# the self-test below, so it keeps the D-C discrimination without the false
# negative.
#
# So: try each probe in a ladder, classify each result, and require at least one
# CONCLUSIVE probe. A probe whose output says "unknown command" is inconclusive
# and moves to the next rung. A signal death on ANY rung is an immediate reject.
# If every rung is inconclusive we reject -- fail-CLOSED, because we then have no
# evidence the candidate can do anything at all.
#
# A non-signal, non-unknown-command exit (e.g. a type error about the fixture)
# IS a pass: that is a source-level verdict from a pipeline that plainly ran.
simple_compiler_env_write_ok() {
    _scs_bin="$1"
    case "$_scs_bin" in /*) ;; *) _scs_bin="$PWD/$_scs_bin" ;; esac
    _scs_dir="$(mktemp -d "${TMPDIR:-/tmp}/simple-compiler-probe.XXXXXX")" || return 1
    printf 'fn main():\n    print("ok")\n' > "$_scs_dir/p.spl" 2>/dev/null || {
        rm -rf "$_scs_dir"; return 1; }

    _scs_conclusive=0
    _scs_verdict=0   # 0 = no reject seen yet, 1 = rejected

    # Rung order: cheapest real-work command first. Each rung runs in its own
    # clean directory -- a leftover p.smf/probe_bin from a previous rung could
    # otherwise be misread as evidence from THIS rung.
    for _scs_rung in "check p.spl" "native-build --entry p.spl --source . -o probe_bin"; do
        rm -f "$_scs_dir"/p.smf "$_scs_dir"/probe_bin "$_scs_dir"/out.txt
        rm -rf "$_scs_dir"/.simple
        # shellcheck disable=SC2086
        ( cd "$_scs_dir" 2>/dev/null || exit 127
          ulimit -c 0 2>/dev/null
          timeout "$SIMPLE_COMPILER_PROBE_TIMEOUT" "$_scs_bin" $_scs_rung >out.txt 2>&1 )
        _scs_rc=$?
        _scs_out="$(cat "$_scs_dir/out.txt" 2>/dev/null || true)"

        if [ "$_scs_rc" -ge 128 ]; then
            _scs_verdict=1; _scs_conclusive=1
            break
        fi
        case "$_scs_out" in
            *"unknown command"*|*"unrecognized command"*|*"Unknown command"*)
                continue ;;   # inconclusive -- this binary has no such subcommand
        esac
        # rc=127 is AMBIGUOUS and must not be read as a reject. Measured
        # 2026-08-06: the Rust seed answers `check p.spl` with rc=127 and NO
        # "unknown command" text -- it signals an unimplemented subcommand purely
        # by exit code. Treating 127 as "not executable" therefore rejected a
        # binary that compiles perfectly well on the very next rung (rc=0). Only
        # rc=126 (exec format error -- what a cross-target payload gives) is a
        # conclusive reject here; 127 falls through to the next rung, and the
        # fail-closed "every rung inconclusive => reject" rule below still stops
        # a binary that can run nothing at all.
        if [ "$_scs_rc" -eq 127 ]; then
            continue
        fi
        if [ "$_scs_rc" -eq 126 ]; then
            _scs_verdict=1; _scs_conclusive=1
            break
        fi
        _scs_conclusive=1   # it ran; whatever it said is about the fixture
    done

    rm -rf "$_scs_dir"
    [ "$_scs_conclusive" -eq 1 ] || return 1   # fail-CLOSED on no evidence
    [ "$_scs_verdict" -eq 0 ]
}

# Builder tier: prove the native-build contract for a concrete target triple.
simple_compiler_can_build_target() {
    _scs_out="$( ulimit -c 0 2>/dev/null
                 timeout "$SIMPLE_COMPILER_PROBE_TIMEOUT" \
                     "$1" native-build --target "$2" --help 2>&1 )" && _scs_rc=0 || _scs_rc=$?
    [ "$_scs_rc" -eq 0 ] || return 1
    case "$_scs_out" in *"Simple Native Build"*) ;; *) return 1 ;; esac
    case "$_scs_out" in *"--runtime-bundle"*) ;; *) return 1 ;; esac
    case "$_scs_out" in
        *"unknown"*"--target"*|*"unrecognized"*"--target"*) return 1 ;;
    esac
    return 0
}

# simple_compiler_usable <bin> [builder-target]
simple_compiler_usable() {
    [ -n "${1:-}" ] || return 1
    [ -f "$1" ] && [ -x "$1" ] || return 1
    simple_compiler_is_seed "$1" && return 1
    simple_compiler_env_write_ok "$1" || return 1
    if [ -n "${2:-}" ]; then
        simple_compiler_can_build_target "$1" "$2" || return 1
    fi
    return 0
}

# simple_compiler_select [--root <dir>] [--builder-target <triple>] [--quiet]
# Prints the selected path on stdout; diagnostics go to stderr. rc0 on success.
simple_compiler_select() {
    _scs_sel_root="."
    _scs_sel_target=""
    _scs_quiet=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --root) shift; _scs_sel_root="${1:-.}" ;;
            --root=*) _scs_sel_root="${1#*=}" ;;
            --builder-target) shift; _scs_sel_target="${1:-}" ;;
            --builder-target=*) _scs_sel_target="${1#*=}" ;;
            --quiet) _scs_quiet=1 ;;
            *) break ;;
        esac
        shift
    done

    # Explicit operator choice: honoured, but still probed.
    if [ -n "${SIMPLE_BUILD_COMPILER:-}" ]; then
        if [ ! -x "$SIMPLE_BUILD_COMPILER" ]; then
            echo "error: SIMPLE_BUILD_COMPILER is not executable: $SIMPLE_BUILD_COMPILER" >&2
            return 1
        fi
        if simple_compiler_is_seed "$SIMPLE_BUILD_COMPILER"; then
            echo "warning: explicitly selected the Rust bootstrap seed: $SIMPLE_BUILD_COMPILER" >&2
            echo "warning: artifacts built with it will FAIL the provenance guards" >&2
            printf '%s\n' "$SIMPLE_BUILD_COMPILER"
            return 0
        fi
        if ! simple_compiler_env_write_ok "$SIMPLE_BUILD_COMPILER"; then
            echo "error: SIMPLE_BUILD_COMPILER failed the environment-write probe: $SIMPLE_BUILD_COMPILER" >&2
            return 1
        fi
        if [ -n "$_scs_sel_target" ] \
           && ! simple_compiler_can_build_target "$SIMPLE_BUILD_COMPILER" "$_scs_sel_target"; then
            echo "error: SIMPLE_BUILD_COMPILER failed the native-build --target probe: $SIMPLE_BUILD_COMPILER" >&2
            return 1
        fi
        printf '%s\n' "$SIMPLE_BUILD_COMPILER"
        return 0
    fi

    # Discovery. Dedupe by realpath: bin/simple is a symlink into release/, so
    # an undeduped list pays the probe cost several times over on one binary.
    _scs_seen=""
    for _scs_cand in $(simple_compiler_default_candidates "$_scs_sel_root"); do
        [ -f "$_scs_cand" ] && [ -x "$_scs_cand" ] || continue
        _scs_real="$(readlink -f "$_scs_cand" 2>/dev/null || printf '%s' "$_scs_cand")"
        case " $_scs_seen " in *" $_scs_real "*) continue ;; esac
        _scs_seen="$_scs_seen $_scs_real"

        if simple_compiler_is_seed "$_scs_cand"; then
            [ "$_scs_quiet" -eq 1 ] || echo "  skip (Rust bootstrap seed): $_scs_cand" >&2
            continue
        fi
        if ! simple_compiler_env_write_ok "$_scs_cand"; then
            [ "$_scs_quiet" -eq 1 ] || echo "  skip (failed environment-write probe): $_scs_cand" >&2
            continue
        fi
        if [ -n "$_scs_sel_target" ] \
           && ! simple_compiler_can_build_target "$_scs_cand" "$_scs_sel_target"; then
            [ "$_scs_quiet" -eq 1 ] || echo "  skip (failed native-build --target probe): $_scs_cand" >&2
            continue
        fi
        printf '%s\n' "$_scs_cand"
        return 0
    done

    echo "error: no Simple compiler passed the capability probe" >&2
    echo "hint: run the bootstrap, or set SIMPLE_BUILD_COMPILER explicitly" >&2
    return 1
}

# ---------------------------------------------------------------------------
# --self-test / direct invocation
# ---------------------------------------------------------------------------
simple_compiler_select_self_test() {
    _scs_st_root="$1"
    _scs_st_fail=0
    _scs_st_ran=0

    # expect <verdict> <path> <label>   verdict: usable | reject | skip-missing
    _scs_expect() {
        _scs_e_want="$1"; _scs_e_bin="$_scs_st_root/$2"; _scs_e_label="$3"
        if [ ! -x "$_scs_e_bin" ]; then
            echo "  SKIP  $_scs_e_label -- not present in this tree ($2)"
            return 0
        fi
        _scs_st_ran=$((_scs_st_ran + 1))
        if simple_compiler_usable "$_scs_e_bin"; then _scs_e_got=usable; else _scs_e_got=reject; fi
        if [ "$_scs_e_got" = "$_scs_e_want" ]; then
            echo "  PASS  $_scs_e_got  $_scs_e_label"
        else
            echo "  FAIL  expected=$_scs_e_want got=$_scs_e_got  $_scs_e_label ($2)"
            _scs_st_fail=$((_scs_st_fail + 1))
        fi
    }

    # Expectations below are MEASURED on this tree (2026-08-06), not assumed.
    # The self-test's job is to pin WHY each candidate is accepted or rejected,
    # so a future regression -- either direction -- is caught: a fail-OPEN
    # regression that starts admitting a known-bad binary, or a fail-CLOSED
    # regression that starts rejecting a known-good one (measured 2026-08-06:
    # the second env-write rung used to be `compile --format=smf`, which
    # false-negative-rejected build/bootstrap/stage2 below even though its
    # `native-build` path -- the contract every real caller uses -- works; see
    # the comment above simple_compiler_env_write_ok). A self-test with no
    # `usable` row cannot detect an over-strict probe, which is why the
    # build/bootstrap/stage2 row below is `usable`, not `reject`.
    echo "simple-compiler-select --self-test (root: $_scs_st_root)"
    echo "known-bad -- every one of these MUST be rejected:"
    _scs_expect reject release/x86_64-unknown-linux-gnu/simple \
        "stale two-arg rt_env_set ABI: --help rc=0, but rc=139 on env write (D-C)"
    _scs_expect reject bin/release/x86_64-unknown-linux-gnu/simple \
        "Rust bootstrap seed copy -- compiles fine, caught by identity only (D-A)"
    _scs_expect reject bin/release/x86_64-unknown-simpleos/simple \
        "SimpleOS PAYLOAD: cross-target ELF, must never build itself (D-B)"
    _scs_expect reject bootstrap/stage3/x86_64-unknown-linux-gnu/simple \
        "top-level stage3: rc=139 on native-build (real work, not --help)"
    _scs_expect reject bootstrap/stage2/simple \
        "top-level stage2: rc=139 on native-build (real work, not --help)"
    echo "known-good -- MUST be accepted (regression guard for the false-negative fix):"
    _scs_expect usable build/bootstrap/stage2/x86_64-unknown-linux-gnu/simple \
        "build/ stage2: no 'check' subcommand (inconclusive), but native-build compiles+links a real binary"

    # POSITIVE CONTROL. Every row above is a reject, so on its own this suite
    # cannot tell a correct probe from one that rejects everything. The Rust
    # bootstrap seed is the only binary in this tree that compiles cleanly
    # (rc=0, .smf emitted), so it pins BOTH sides:
    #   - the capability probe must PASS it  -> the probe is not a blanket reject
    #   - full usability must still REJECT it -> the seed identity gate fires
    # If the first of these ever fails, the probe has become over-strict and
    # every reject above is passing for the wrong reason.
    echo "positive control -- seed must pass the capability probe but fail identity:"
    _scs_pc="$_scs_st_root/bin/release/x86_64-unknown-linux-gnu/simple"
    if [ ! -x "$_scs_pc" ]; then
        echo "  SKIP  seed positive control -- not present"
    else
        _scs_st_ran=$((_scs_st_ran + 1))
        if simple_compiler_env_write_ok "$_scs_pc"; then
            echo "  PASS  capability probe accepts the seed (probe is not blanket-reject)"
        else
            echo "  FAIL  capability probe REJECTED the seed -- probe is over-strict," >&2
            echo "        so every 'reject' verdict above is unreliable" >&2
            _scs_st_fail=$((_scs_st_fail + 1))
        fi
        _scs_st_ran=$((_scs_st_ran + 1))
        if simple_compiler_is_seed "$_scs_pc"; then
            echo "  PASS  seed identity gate fires on the seed"
        else
            echo "  FAIL  seed identity gate did NOT fire on the seed" >&2
            _scs_st_fail=$((_scs_st_fail + 1))
        fi
    fi

    if [ "$_scs_st_ran" -eq 0 ]; then
        echo "ERROR -- nothing was checked (no candidate binaries present)" >&2
        return 2
    fi
    if [ "$_scs_st_fail" -ne 0 ]; then
        echo "FAIL -- $_scs_st_fail of $_scs_st_ran discrimination(s) wrong" >&2
        return 1
    fi
    echo "PASS -- $_scs_st_ran discrimination(s) checked, all correct"
    return 0
}

# Only run when EXECUTED, not when sourced. $0 ends in this filename exactly
# when this file is the script being run.
case "$0" in
    *simple-compiler-select.shs)
        _scs_self_root="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
        case "${1:-}" in
            --self-test)
                simple_compiler_select_self_test "$_scs_self_root"
                exit $?
                ;;
            --help|-h)
                echo "Usage: sh scripts/lib/simple-compiler-select.shs [--self-test] [--builder-target <triple>]"
                echo "       . scripts/lib/simple-compiler-select.shs   # as a library"
                exit 0
                ;;
            *)
                simple_compiler_select --root "$_scs_self_root" "$@"
                exit $?
                ;;
        esac
        ;;
esac
