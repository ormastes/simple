#!/bin/sh
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "usage: $0 PYTHON_ENTITIES_PY [OUTPUT_SPL]" >&2
    exit 2
fi

entity_source=$1
entity_output=${2:-src/lib/gc_async_mut/gpu/browser_engine/html_named_character_references.spl}

if [ ! -f "$entity_source" ]; then
    echo "CPython html/entities.py source not found: $entity_source" >&2
    exit 2
fi

perl -Mstrict -Mwarnings -Mutf8 -MEncode=encode \
    -MDigest::SHA=sha256_hex -e '
sub decode_python_string {
    my ($value) = @_;
    $value =~ s/\\x([0-9A-Fa-f]{2})/chr(hex($1))/ge;
    $value =~ s/\\u([0-9A-Fa-f]{4})/chr(hex($1))/ge;
    $value =~ s/\\U([0-9A-Fa-f]{8})/chr(hex($1))/ge;
    $value =~ s/\\n/"\n"/ge;
    $value =~ s/\\t/"\t"/ge;
    $value =~ s/\\([\\'\''])/$1/g;
    return $value;
}

sub simple_quote {
    my ($value) = @_;
    $value =~ s/\\/\\\\/g;
    $value =~ s/"/\\"/g;
    $value =~ s/\n/\\n/g;
    $value =~ s/\t/\\t/g;
    return "\"" . $value . "\"";
}

my ($source, $output) = @ARGV;
open my $input, "<:encoding(UTF-8)", $source or die "$source: $!\n";
my (%entities, $inside_html5);
while (my $line = <$input>) {
    if ($line =~ /^html5 = \{/) {
        $inside_html5 = 1;
        next;
    }
    next unless $inside_html5;
    last if $line =~ /^\}/;
    if ($line =~ /^\s*'\''([^'\'']+)'\''\s*:\s*'\''((?:\\.|[^'\''])*)'\'',/) {
        $entities{$1} = decode_python_string($2);
    } elsif ($line =~ /^\s*'\''([^'\'']+)'\''\s*:\s*"((?:\\.|[^"])*)",/) {
        $entities{$1} = decode_python_string($2);
    }
}
close $input;

my @names = sort keys %entities;
my %unique = map { my $name = $_; $name =~ s/;$//; $name => 1 } @names;
my $legacy = grep { $_ !~ /;$/ } @names;
my $maximum = 0;
for my $name (@names) {
    $maximum = length($name) if length($name) > $maximum;
}
my $canonical = join "", map {
    $_ . "\t" . $entities{$_} . "\n"
} @names;
my $digest = sha256_hex(encode("UTF-8", $canonical));
my $expected = "2153dd01901680634b4bc936dcb5f8a058c12bfc563fc7a87752c6b546c75f7b";
die "CPython html.entities table does not match the pinned dataset\n"
    unless @names == 2231 && keys(%unique) == 2125 &&
        $legacy == 106 && $maximum == 32 && $digest eq $expected;

open my $out, ">:encoding(UTF-8)", $output or die "$output: $!\n";
print {$out} "# Generated by scripts/generate/generate-html-named-character-references.shs — DO NOT EDIT\n";
print {$out} "# Component: CPython Lib/html/entities.py html5 mapping\n";
print {$out} "# Upstream: https://github.com/python/cpython/blob/v3.12.3/Lib/html/entities.py\n";
print {$out} "# Canonical SHA-256: $digest\n";
print {$out} "# License: PSF-2.0; see html_named_character_references.LICENSE.txt\n";
print {$out} "# 2231 exact references; 2125 names; 106 legacy no-semicolon forms.\n\n";
print {$out} "pub val HTML_NAMED_REFERENCE_SOURCE_SHA256: text = \"$digest\"\n";
print {$out} "pub val HTML_NAMED_REFERENCE_MAX_LENGTH: i32 = $maximum\n\n";
print {$out} "pub val HTML_NAMED_REFERENCE_NAMES: [text] = [\n";
print {$out} "    " . simple_quote($_) . ",\n" for @names;
print {$out} "]\n\npub val HTML_NAMED_REFERENCE_VALUES: [text] = [\n";
print {$out} "    " . simple_quote($entities{$_}) . ",\n" for @names;
print {$out} "]\n";
close $out;
print "generated $output references=" . scalar(@names) .
    " names=" . scalar(keys %unique) . " legacy=$legacy\n";
' "$entity_source" "$entity_output"
