#!/bin/sh
# GitHub-hosted Linux x64 prerequisite shared by self-hosted runtime consumers.
# Same reviewed archive identity as aot-lane-fences.yml; never use a rolling apt LLVM.
set -eu
[ "$(uname -s)" = Linux ] && [ "$(uname -m)" = x86_64 ] || { echo 'requires Linux x64' >&2; exit 2; }
: "${RUNNER_TEMP:?}" "${GITHUB_PATH:?}" "${GITHUB_ENV:?}"
sudo apt-get update
sudo apt-get install -y libfreetype6-dev libunwind-dev
llvm_archive="$RUNNER_TEMP/LLVM-23.1.1-Linux-X64.tar.xz"
llvm_prefix="$RUNNER_TEMP/llvm-23.1.1"
gh release download llvmorg-23.1.1 --repo llvm/llvm-project \
  --pattern 'LLVM-23.1.1-Linux-X64.tar.xz' --dir "$RUNNER_TEMP"
printf '%s  %s\n' \
  '832aeb58d105de1cabc7b982dd2c65de0610f7377df48ae8fc2dd8e97420a15c' \
  "$llvm_archive" | sha256sum --check
mkdir -p "$llvm_prefix"
tar -xJf "$llvm_archive" -C "$llvm_prefix" --strip-components=1
rm "$llvm_archive"
test "$("$llvm_prefix/bin/llvm-config" --version)" = '23.1.1'
for tool in clang llvm-as opt llc; do test -x "$llvm_prefix/bin/$tool"; done
echo "$llvm_prefix/bin" >> "$GITHUB_PATH"
echo "LLVM_SYS_231_PREFIX=$llvm_prefix" >> "$GITHUB_ENV"