#!/bin/sh
# Pick the components of config/ci/components.sdn that a change touches.
#
#   sh scripts/ci/plan-components.shs <base-sha> <head-sha>   # changed between them
#   sh scripts/ci/plan-components.shs --all                    # every component
#   sh scripts/ci/plan-components.shs --only a,b               # named components
#   sh scripts/ci/plan-components.shs --selftest
#
# Prints the selected names, one per line, and writes matrix=<json> and
# count=<n> to $GITHUB_OUTPUT (JSON only at the GitHub boundary). An unknown or
# unreachable base selects everything: a change we cannot see is not "nothing".
set -eu
config=${SIMPLE_CI_COMPONENTS:-config/ci/components.sdn}

# "name|runner|host|paths|build|cache|output" per component.
rows() {
  awk '
    function flush() { if (name != "") print name "|" v["runner"] "|" v["host"] "|" v["paths"] "|" v["build"] "|" v["cache"] "|" v["output"] }
    /^[[:space:]]*#/ { next }
    /^component [^:]+:[[:space:]]*$/ { flush(); name=$2; sub(/:$/, "", name); delete v; next }
    name != "" && /^[[:space:]]+[a-z]+:/ {
      k=$1; sub(/:$/, "", k); line=$0
      sub(/^[[:space:]]+[a-z]+:[[:space:]]*/, "", line); gsub(/^"|"$/, "", line)
      v[k]=line }
    END { flush() }' "$1"
}

select_rows() { # <mode> [base head | names]
  mode=$1
  changed=
  if [ "$mode" = diff ]; then
    if git cat-file -e "$2^{commit}" 2>/dev/null && [ -n "$(echo "$2" | tr -d 0)" ]; then
      changed=$(git diff --name-only "$2" "$3")
    else
      echo "plan-components: base $2 unavailable; selecting all" >&2
      mode=all
    fi
  fi
  rows "$config" | while IFS='|' read -r name runner host paths build cache output; do
    pick=0
    case $mode in
      all) pick=1 ;;
      only) case ",$2," in *",$name,"*) pick=1 ;; esac ;;
      diff)
        for p in $paths; do
          if printf '%s\n' "$changed" | grep -q "^$p"; then pick=1; break; fi
        done ;;
    esac
    [ "$pick" = 1 ] && printf '%s|%s|%s|%s|%s|%s|%s\n' "$name" "$runner" "$host" "$paths" "$build" "$cache" "$output"
  done
}

emit() { # stdin: selected rows
  json= n=0
  while IFS='|' read -r name runner host paths build cache output; do
    echo "$name"
    obj=$(printf '{"name":"%s","runner":"%s","host":"%s","build":"%s","cache":"%s","output":"%s"}' \
      "$name" "$runner" "$host" "$build" "$cache" "$output")
    json=${json:+$json,}$obj n=$((n + 1))
  done
  { echo "matrix={\"include\":[$json]}"; echo "count=$n"; } >> "${GITHUB_OUTPUT:-/dev/null}"
}

selftest() {
  t=$(mktemp -d)
  trap 'rm -rf "$t"' EXIT
  cat > "$t/c.sdn" <<'EOF'
component a:
    runner: r
    host: h
    paths: "src/a/ src/lib/"
    build: "sh build-a.shs"
    cache: "c/a"
    output: "o/a"
component b:
    runner: r
    host: h
    paths: "src/b/"
    build: "sh build-b.shs"
    cache: "c/b"
    output: "o/b"
EOF
  [ "$(rows "$t/c.sdn" | wc -l)" -eq 2 ] || { echo "selftest FAIL: rows" >&2; exit 1; }
  [ "$(rows "$t/c.sdn" | head -1)" = 'a|r|h|src/a/ src/lib/|sh build-a.shs|c/a|o/a' ] || { echo "selftest FAIL: parse" >&2; exit 1; }
  config=$t/c.sdn
  [ "$(select_rows only b | cut -d'|' -f1)" = b ] || { echo "selftest FAIL: only" >&2; exit 1; }
  [ "$(select_rows diff 0000000 HEAD | wc -l)" -eq 2 ] || { echo "selftest FAIL: unknown base must select all" >&2; exit 1; }
  echo "plan-components: selftest PASS (4 checks)"
}

case ${1:-} in
  --selftest) selftest ;;
  --all) select_rows all | emit ;;
  --only) select_rows only "${2:?names}" | emit ;;
  '') echo "usage: plan-components.shs <base> <head> | --all | --only a,b | --selftest" >&2; exit 2 ;;
  *) select_rows diff "$1" "${2:?head}" | emit ;;
esac
