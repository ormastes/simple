#!/bin/sh
# Behavioural proof for scripts/ci/cache-preflight.shs.
S=scripts/ci/cache-preflight.shs
PASS=0; FAIL=0

expect() { # expect <want> <role> <env-assignments...>
  want="$1"; role="$2"; shift 2
  got="$(env -i PATH="$PATH" "$@" sh "$S" "$role" | tail -1)"
  if [ "$got" = "VERDICT: $want" ]; then
    PASS=$((PASS+1)); echo "ok   [$want] $*"
  else
    FAIL=$((FAIL+1)); echo "FAIL want='VERDICT: $want' got='$got' :: $*"
  fi
}

FULL="CI=true GITHUB_EVENT_NAME=push GITHUB_REF=refs/heads/main GITHUB_SHA=abc CACHE_GATEWAY_URL=u CACHE_GATEWAY_TOKEN_ID=t CACHE_GATEWAY_SECRET=s PROMOTION_SIGNING_KEY=k"

# happy paths
expect write-main   trusted_main_ci   $FULL
expect write-branch trusted_branch_ci CI=true GITHUB_EVENT_NAME=push GITHUB_REF=refs/heads/feat GITHUB_REF_NAME=feat CACHE_BRANCH_NAMESPACE_ENABLED=true CACHE_GATEWAY_URL=u CACHE_GATEWAY_TOKEN_ID=t CACHE_GATEWAY_SECRET=s PROMOTION_SIGNING_KEY=k

# fail-closed paths
expect read-only trusted_main_ci GITHUB_EVENT_NAME=push        # not CI
expect read-only trusted_main_ci CI=true GITHUB_EVENT_NAME=pull_request GITHUB_REF=refs/heads/main CACHE_GATEWAY_URL=u CACHE_GATEWAY_TOKEN_ID=t CACHE_GATEWAY_SECRET=s PROMOTION_SIGNING_KEY=k
expect read-only trusted_main_ci CI=true GITHUB_EVENT_NAME=push GITHUB_REPOSITORY=a/b GITHUB_HEAD_REPOSITORY=fork/b GITHUB_REF=refs/heads/main CACHE_GATEWAY_URL=u CACHE_GATEWAY_TOKEN_ID=t CACHE_GATEWAY_SECRET=s PROMOTION_SIGNING_KEY=k
expect read-only trusted_main_ci CI=true GITHUB_EVENT_NAME=push GITHUB_REF=refs/heads/main CACHE_GATEWAY_URL=u CACHE_GATEWAY_TOKEN_ID=t PROMOTION_SIGNING_KEY=k   # secret missing
expect read-only trusted_main_ci CI=true GITHUB_EVENT_NAME=push GITHUB_REF=refs/heads/main CACHE_GATEWAY_URL=u CACHE_GATEWAY_TOKEN_ID=t CACHE_GATEWAY_SECRET=s      # signing key missing
# THE load-bearing one: a branch job asking for main authority
expect read-only trusted_main_ci CI=true GITHUB_EVENT_NAME=push GITHUB_REF=refs/heads/feat CACHE_GATEWAY_URL=u CACHE_GATEWAY_TOKEN_ID=t CACHE_GATEWAY_SECRET=s PROMOTION_SIGNING_KEY=k
# branch namespace not opted in
expect read-only trusted_branch_ci CI=true GITHUB_EVENT_NAME=push GITHUB_REF=refs/heads/feat GITHUB_REF_NAME=feat CACHE_GATEWAY_URL=u CACHE_GATEWAY_TOKEN_ID=t CACHE_GATEWAY_SECRET=s PROMOTION_SIGNING_KEY=k
# branch lane must not run on main
expect read-only trusted_branch_ci CI=true GITHUB_EVENT_NAME=push GITHUB_REF=refs/heads/main GITHUB_REF_NAME=main CACHE_BRANCH_NAMESPACE_ENABLED=true CACHE_GATEWAY_URL=u CACHE_GATEWAY_TOKEN_ID=t CACHE_GATEWAY_SECRET=s PROMOTION_SIGNING_KEY=k
expect read-only bogus_role $FULL

echo "VERDICT: ${PASS} passed, ${FAIL} failed"
[ "$FAIL" -eq 0 ]
