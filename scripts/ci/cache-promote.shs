#!/bin/sh
# cache-promote — thin CI wrapper around the promotion policy gateway (C9 slice 1).
#
# Locates promotion requests, invokes src/app/cache_gateway per request, and
# aggregates the per-request verdicts into the single last-line contract:
#
#   PASS — promoted <n>            exit 0   (n > 0; a vacuous run is never PASS)
#   FAIL — <rule>                  exit 1   (first failing rule, by name)
#   ERROR — nothing was checked …  exit 2
#
# This script performs the ONE network operation in the promotion path — the
# authenticated `git fetch` of the trusted origin/main snapshot — and hands the
# resulting tip/time/authenticity to the gateway as arguments. The gateway
# itself does no network I/O, and NOTHING here writes to a remote cache
# namespace: the remote writer is C9 slice 2 and lives in the protected
# workflow, never on a developer machine.
#
# Env:
#   CACHE_PROMOTION_REQUEST_DIR  directory of *.sdn requests (default below)
#   CACHE_PROMOTION_OUT_DIR      directory approved receipts are written to
#   SIMPLE_BIN                   simple binary (default bin/simple)

set -u

REQUEST_DIR="${CACHE_PROMOTION_REQUEST_DIR:-build/cache/promotion/requests}"
OUT_DIR="${CACHE_PROMOTION_OUT_DIR:-build/cache/promotion/approved}"
SIMPLE_BIN="${SIMPLE_BIN:-bin/simple}"
GATEWAY="src/app/cache_gateway/main.spl"

fail_closed() {
    echo "ERROR — nothing was checked ($1)"
    exit 2
}

[ -x "$SIMPLE_BIN" ] || fail_closed "simple binary not found at $SIMPLE_BIN"
[ -f "$GATEWAY" ] || fail_closed "gateway entry not found at $GATEWAY"
[ -d "$REQUEST_DIR" ] || fail_closed "request directory not found: $REQUEST_DIR"

# Authenticated snapshot of the trusted ref. A failed fetch must not degrade to
# a stale local ref — that is exactly the trust proof git_ancestry.spl refuses.
if ! git fetch --prune origin main >/dev/null 2>&1; then
    fail_closed "could not fetch origin/main"
fi
MAIN_TIP=$(git rev-parse refs/remotes/origin/main 2>/dev/null) || fail_closed "origin/main has no tip"
[ -n "$MAIN_TIP" ] || fail_closed "origin/main has no tip"
FETCHED_AT_MICROS=$(( $(date +%s) * 1000000 ))
REMOTE_URL=$(git remote get-url origin 2>/dev/null || echo "")
REPOSITORY_ID=$(printf '%s' "$REMOTE_URL" | git hash-object --stdin 2>/dev/null || echo "")

mkdir -p "$OUT_DIR" || fail_closed "cannot create output directory $OUT_DIR"

CHECKED=0
PROMOTED=0
FIRST_FAILURE=""

for request in "$REQUEST_DIR"/*.sdn; do
    [ -f "$request" ] || continue
    CHECKED=$((CHECKED + 1))
    out=$("$SIMPLE_BIN" run "$GATEWAY" "$request" \
        --out "$OUT_DIR" \
        --repo . \
        --main-tip "$MAIN_TIP" \
        --fetched-at-micros "$FETCHED_AT_MICROS" \
        --fetch-authenticated \
        --repository-id "$REPOSITORY_ID" \
        --remote-url "$REMOTE_URL" 2>&1)
    rc=$?
    verdict=$(printf '%s\n' "$out" | tail -1)
    echo "$request: $verdict"
    if [ "$rc" -eq 0 ]; then
        PROMOTED=$((PROMOTED + 1))
    elif [ "$rc" -eq 1 ]; then
        [ -n "$FIRST_FAILURE" ] || FIRST_FAILURE=$(printf '%s' "$verdict" | sed 's/^FAIL — //')
    else
        fail_closed "gateway could not check $request"
    fi
done

# A run that examined no request is not a pass.
[ "$CHECKED" -gt 0 ] || fail_closed "no promotion requests in $REQUEST_DIR"

if [ -n "$FIRST_FAILURE" ]; then
    echo "FAIL — $FIRST_FAILURE"
    exit 1
fi

echo "PASS — promoted $PROMOTED"
exit 0
