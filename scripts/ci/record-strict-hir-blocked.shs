#!/usr/bin/env bash
# A failed prerequisite is evidence of BLOCKED, never a successful unit test.
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
out=${1:?absolute evidence directory required}
outcome=${2:?compiler prerequisite outcome required}
case "$out" in /*) ;; *) exit 2 ;; esac
case "$outcome" in failure|skipped|cancelled) ;; *) exit 2 ;; esac
source_sha=$(git -C "$root" rev-parse HEAD)
[ -z "${GITHUB_SHA:-}" ] || [ "$GITHUB_SHA" = "$source_sha" ] || exit 2
mkdir -p "$out"
[ ! -e "$out/result.sdn" ] || { echo 'evidence collision' >&2; exit 2; }
{
  printf 'schema: strict-hir-unit-evidence-v1\nstatus: BLOCKED\nreason: compiler-lib-test-prerequisite\n'
  printf 'source_sha: %s\nprerequisite_outcome: %s\n' "$source_sha" "$outcome"
  printf 'test_name: hir::lower::tests::expression_tests::llvm_pipeline_optional_destination_keeps_narrow_unsafe_boundary\n'
  printf 'verified_passed_tests: 0\nexecution_attempted: 0\nunit_exit_status: not-run\n'
  printf 'github_run_id: %s\ngithub_run_attempt: %s\n' "${GITHUB_RUN_ID:-local-diagnostic}" "${GITHUB_RUN_ATTEMPT:-1}"
} >"$out/result.sdn"
cat "$out/result.sdn"
