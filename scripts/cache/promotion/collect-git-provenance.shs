#!/bin/sh
# collect-git-provenance.shs — emit the SDN facts the promotion gate consumes.
#
# Design: doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §15.1
# Consumer: src/compiler/80.driver/cache/promotion/git_provenance.spl (GitProvenanceFacts)
#
# The freshness proof is constructed HERE and nowhere else:
#   1. `git fetch --prune origin main` runs unconditionally in this invocation;
#   2. the tip is read AFTER that fetch (`refs/remotes/origin/main`);
#   3. the pre-fetch tip and the fetch wall-clock time are both recorded, so the
#      gate can prove the ref was re-fetched rather than trusted as found;
#   4. reachability is `git merge-base --is-ancestor $BUILD_COMMIT <post-fetch tip>`.
# A stale local origin/main is therefore never the reachability base.
#
# Usage: sh scripts/cache/promotion/collect-git-provenance.shs [BUILD_COMMIT] > facts.sdn
# Exit:  0 facts emitted (admission is still the gate's decision), 2 not a repo.

set -e

REMOTE="${PROMOTION_REMOTE:-origin}"
TRUSTED_REF="refs/remotes/${REMOTE}/main"

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "ERROR — not a git repository; no provenance can be collected" >&2
    exit 2
fi

BUILD_COMMIT="${1:-$(git rev-parse HEAD)}"
BUILD_TREE="$(git rev-parse "${BUILD_COMMIT}^{tree}")"
REPO_URL="$(git remote get-url "$REMOTE" 2>/dev/null || echo '')"
REPO_ID="$(printf '%s' "$REPO_URL" | git hash-object --stdin)"

TIP_BEFORE="$(git rev-parse --verify --quiet "$TRUSTED_REF" || echo '')"

FETCH_OK=false
if git fetch --prune "$REMOTE" main >/dev/null 2>&1; then
    FETCH_OK=true
fi
FETCH_AT="$(date +%s)"
TIP_AFTER="$(git rev-parse --verify --quiet "$TRUSTED_REF" || echo '')"

# Authenticated transport: an SSH/HTTPS remote that we actually reached.
REMOTE_AUTH=false
if [ "$FETCH_OK" = true ] && [ -n "$TIP_AFTER" ]; then
    REMOTE_AUTH=true
fi

CLEAN=true
if [ -n "$(git status --porcelain)" ]; then
    CLEAN=false
fi
CLEAN_TREE_DIGEST="$(git rev-parse "HEAD^{tree}")"

ANCESTOR=false
if [ -n "$TIP_AFTER" ] && git merge-base --is-ancestor "$BUILD_COMMIT" "$TIP_AFTER" 2>/dev/null; then
    ANCESTOR=true
fi

# Merge strategy is supplied by the integration lane; it cannot be inferred
# reliably after the fact (squash and cherry-pick look like ordinary commits).
STRATEGY="${PROMOTION_MERGE_STRATEGY:-normal_merge}"
REBASED_COMMIT="${PROMOTION_REBASED_COMMIT:-}"

cat <<SDN
git_provenance_facts:
  repository_url: "${REPO_URL}"
  repository_id: "${REPO_ID}"
  remote_authenticated: ${REMOTE_AUTH}
  trusted_ref: "${TRUSTED_REF}"
  origin_main_tip_before_fetch: "${TIP_BEFORE}"
  origin_main_tip: "${TIP_AFTER}"
  fetch_performed: ${FETCH_OK}
  fetch_epoch_seconds: ${FETCH_AT}
  now_epoch_seconds: $(date +%s)
  build_commit: "${BUILD_COMMIT}"
  build_tree: "${BUILD_TREE}"
  worktree_clean: ${CLEAN}
  clean_tree_digest: "${CLEAN_TREE_DIGEST}"
  is_ancestor_of_main_tip: ${ANCESTOR}
  merge_strategy: "${STRATEGY}"
  rebased_commit: "${REBASED_COMMIT}"
  builder_id: "${PROMOTION_BUILDER_ID:-}"
  builder_is_trusted: ${PROMOTION_BUILDER_TRUSTED:-false}
  workflow_digest: "${PROMOTION_WORKFLOW_DIGEST:-}"
  workflow_is_approved: ${PROMOTION_WORKFLOW_APPROVED:-false}
SDN
