      k1_composition: "src/compositions/kernel_llvm_cranelift"
      host_only_composition: "src/compositions/cuda_disabled"
      static_minimal_primitives: true
      dynlib_units:
        - "simple-std"
        - "simple-compiler-common"
        - "simple-compiler"
        - "simple-app"

    - id: "simpleos-aarch64"
      platform: "simpleos"
      cpu: "aarch64"
      target_triple: "aarch64-unknown-simpleos"
      native_host_match: true
      static_primitive_archive: "libsimple-primitive-simpleos-aarch64.a"
      runtime_bundle: "core-c-bootstrap"
