stage3_native_host_link_policy:
  schema: "simple-stage3-native-host-link-policy-v1"
  native_host_match_tag: "native_host_match"
  native_host_match_required: true
  default_compile_mode: "shard"
  supported_compile_modes:
    - "shard"
    - "file"
  compile_granularity: "shard-default-file-optional"
  phase_sharding: "enabled"
  link_model: "dynlib-plus-static-primitives"
  build_unneeded_dynlibs: false
  allow_existing_dynlibs: true
  default_win_config: "mingw"

  profiles:
    - id: "darwin-aarch64"
      platform: "darwin"
      cpu: "aarch64"
      target_triple: "aarch64-apple-darwin"
      native_host_match: true
      static_primitive_archive: "libsimple-primitive-darwin-aarch64.a"
      runtime_bundle: "core-c-bootstrap"
      k1_composition: "src/compositions/kernel_llvm_cranelift"
      host_only_composition: "src/compositions/cuda_disabled"
      static_minimal_primitives: true
      dynlib_units:
        - "simple-std"
        - "simple-compiler-common"
        - "simple-compiler"
        - "simple-app"

    - id: "darwin-x86_64"
      platform: "darwin"
      cpu: "x86_64"
      target_triple: "x86_64-apple-darwin"
      native_host_match: true
      static_primitive_archive: "libsimple-primitive-darwin-x86_64.a"
      runtime_bundle: "core-c-bootstrap"
      k1_composition: "src/compositions/kernel_llvm_cranelift"
      host_only_composition: "src/compositions/cuda_disabled"
      static_minimal_primitives: true
      dynlib_units:
        - "simple-std"
        - "simple-compiler-common"
        - "simple-compiler"
        - "simple-app"

    - id: "linux-x86_64"
      platform: "linux"
      cpu: "x86_64"
      target_triple: "x86_64-unknown-linux-gnu"
      native_host_match: true
      static_primitive_archive: "libsimple-primitive-linux-x86_64.a"
      runtime_bundle: "core-c-bootstrap"
      k1_composition: "src/compositions/kernel_llvm_cranelift"
      host_only_composition: "src/compositions/cuda_disabled"
      static_minimal_primitives: true
      dynlib_units:
        - "simple-std"
        - "simple-compiler-common"
        - "simple-compiler"
        - "simple-app"

    - id: "linux-aarch64"
      platform: "linux"
      cpu: "aarch64"
      target_triple: "aarch64-unknown-linux-gnu"
      native_host_match: true
      static_primitive_archive: "libsimple-primitive-linux-aarch64.a"
      runtime_bundle: "core-c-bootstrap"
      k1_composition: "src/compositions/kernel_llvm_cranelift"
      host_only_composition: "src/compositions/cuda_disabled"
      static_minimal_primitives: true
      dynlib_units:
        - "simple-std"
        - "simple-compiler-common"
        - "simple-compiler"
        - "simple-app"

    - id: "linux-riscv64"
      platform: "linux"
      cpu: "riscv64"
      target_triple: "riscv64gc-unknown-linux-gnu"
      native_host_match: true
      static_primitive_archive: "libsimple-primitive-linux-riscv64.a"
      runtime_bundle: "core-c-bootstrap"
      k1_composition: "src/compositions/kernel_llvm_cranelift"
      host_only_composition: "src/compositions/cuda_disabled"
      static_minimal_primitives: true
      dynlib_units:
        - "simple-std"
        - "simple-compiler-common"
        - "simple-compiler"
        - "simple-app"

    - id: "freebsd-x86_64"
      platform: "freebsd"
      cpu: "x86_64"
