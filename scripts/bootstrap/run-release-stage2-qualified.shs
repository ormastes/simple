#!/bin/sh
# Fresh canonical Stage 2 construction, admission and real phase-tool tests.
# This route uses canonical source-derived authority, not an external C22 seed.
set -eu
usage() {
    echo 'usage: run-release-stage2-qualified.shs SOURCE_ROOT EXPECTED_HEAD FRESH_OUTPUT [JOBS]' >&2
    exit 2
}
[ "$#" -ge 3 ] && [ "$#" -le 4 ] || usage
source_root=$(cd -- "$1" && pwd -P)
expected_head=$2
output=$3
jobs=${4:-full}
case "$output" in /*) ;; *) usage ;; esac
case "$expected_head" in ''|*[!0-9a-f]*) usage ;; esac
[ "${#expected_head}" = 40 ] || usage
case "$jobs" in full|half|min|auto) ;; *[!0-9]*|'') usage ;; *) [ "$jobs" -gt 0 ] || usage ;; esac
cd -- "$source_root"
[ "$(git rev-parse HEAD)" = "$expected_head" ] || exit 98
git diff --quiet && git diff --cached --quiet || exit 98
for required in scripts/bootstrap/bootstrap-from-scratch.sh src/compiler_rust/Cargo.toml \
    src/app/cli/bootstrap_main.spl src/app/cli/_CliMain/main_and_help.spl \
    src/app/test_runner_new/main.spl; do
    [ -f "$required" ] || { echo "missing canonical input: $required" >&2; exit 2; }
done
# A fresh root prevents attributing prior constructors' evidence to this run.
[ ! -e "$output" ] && [ ! -L "$output" ] || { echo 'fresh output required' >&2; exit 2; }
printf '%s\n' 'authority=canonical-source-derived' \
    'external_C22_authority_preserved=0' 'test_execution=required-in-process' \
    'phase4_selfhosting_qualified=0'
# All constructor snapshots, sanity, receiver and immutable admission writes
# stay with their existing canonical owners. No receipt is authored here.
env BOOTSTRAP_STAGE2_TEST_DELEGATE=0 SIMPLE_NO_BOOTSTRAP_DELEGATE=1 SIMPLE_NO_STUB_FALLBACK=1 \
    sh scripts/bootstrap/bootstrap-from-scratch.sh \
    --full-bootstrap --stop-after-stage2 --mode=dynload \
    --backend=cranelift --strategy=full "--jobs=$jobs" "--output=$output"
[ "$(git rev-parse HEAD)" = "$expected_head" ] || exit 98
git diff --quiet && git diff --cached --quiet || exit 98
