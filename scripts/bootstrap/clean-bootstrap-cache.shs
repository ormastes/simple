#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
BOOTSTRAP_CACHE_PROCESS_HELPER_PATH="$script_dir/../check/lib/portable-hardlink-lock.pl"
. "$script_dir/bootstrap-cache-lineage.shs"
{ [ "$#" -eq 4 ] || [ "$#" -eq 5 ]; } && [ "$1" = --root ] && [ "$3" = --lineage ] || {
  echo 'usage: clean-bootstrap-cache.shs --root ABSOLUTE_CACHE_ROOT --lineage ABSOLUTE_IDLE_LINEAGE [--repair-idle-writer=NONCE]' >&2
  exit 64
}
if [ "$#" -eq 5 ]; then
  case "$5" in --repair-idle-writer=*) bootstrap_cache_repair_idle_writer "$2" "$4" "${5#*=}"; exit $? ;; *) exit 64 ;; esac
fi
bootstrap_cache_clean "$2" "$4" || exit 1
echo "cleaned idle cache lineage: $4"
