#!/bin/sh
# One rung of the phase ladder: take the highest phase a lane already has,
# build the next phase with it, sanity-check the result, and hand it on.
#
#   sh scripts/bootstrap/phase-ladder-step.shs <platform> <in-dir> <out-dir> [threads]
#
# <in-dir>   earlier rungs' handoffs: */PHASE + */simple[.exe] (may be empty)
# <out-dir>  this rung's handoff: <out-dir>/<platform>-p<N>/{simple[.exe],PHASE}
#
# Native lanes climb with build-next-phase-ci.shs, which picks the compiler per
# config/bootstrap.sdn (the handed-over local stage first, then the newest RC),
# else build phase 1 with the Rust seed.
# linux-riscv64 has no hosted runner: it is cross-built by the linux-x86_64
# handoff of the previous rung (phase k host -> phase k+1 target), sanity
# checked under qemu-user. Phases cap at 4. Writes phase=<N> and
# climbed=true|false to $GITHUB_OUTPUT; exit 1 on a failed build or sanity.
#
# Essentials: after a native climb the new phase also builds the essential
# binaries (simple_cli = src/app/cli/main.spl, simple_test_runner,
# simple_build_runner) into <handoff>/essentials/, one status line each in
# essentials/STATUS (ok | failed | not-built: <reason>). A failed essential is
# recorded, never hidden, and does not stop the compiler climbing; writes
# essentials=<ok>/<total> to $GITHUB_OUTPUT.
# Phases below PHASE_LADDER_ESSENTIALS_FROM (default 3) record not-built, so
# early rungs spend their time climbing.
set -eu
platform=${1:?platform} in_dir=${2:?in-dir} out_dir=${3:?out-dir} threads=${4:-4}
evidence_root=$(pwd)/build/ladder/evidence
cache_root=$(pwd)/build/ladder/cache
producer_root=$(pwd)/build/ladder/producer
mkdir -p "$evidence_root" "$cache_root" "$producer_root"
source_revision=$(git rev-parse HEAD 2>/dev/null || printf unknown)
attempt_role=planning
record_ladder_exit() {
  ladder_exit=$?
  trap - 0
  set +e
  {
    printf 'schema: phase-ladder-attempt-v1\nsource_revision: %s\nplatform: %s\n' "$source_revision" "$platform"
    printf 'role: %s\nexit_status: %s\nseed_threads: %s\n' "$attempt_role" "$ladder_exit" "$threads"
    printf 'native_file_timing: %s\nadmission: none\ncontinuation_validation: pending-owner\nargv_binding: diagnostic-display-only\n' "${SIMPLE_NATIVE_FILE_TIMING:-0}"
  } > "$evidence_root/attempt.sdn"
  if [ "$ladder_exit" -ne 0 ] && [ "$attempt_role" = seed-native ]; then
    cp "$evidence_root/attempt.sdn" "$evidence_root/seed-native-failure.sdn"
  fi
  exit "$ladder_exit"
}
trap record_ladder_exit 0
exe=
case $platform in windows-*) exe=.exe ;; esac

# Highest handed-over phase of <platform> in <in-dir>: prints "<phase> <dir>".
best_handoff() {
  bp=0 bd=
  for f in "$in_dir"/"$1"-p*/PHASE; do
    [ -f "$f" ] || continue
    p=$(cat "$f")
    if [ "$p" -gt "$bp" ]; then bp=$p bd=$(dirname "$f"); fi
  done
  echo "$bp $bd"
}

# Artifact downloads drop the exec bit.
chmod +x "$in_dir"/*/simple* 2>/dev/null || :
set -- $(best_handoff "$platform")
have=$1 have_dir=${2:-}
# A pure-Simple compiler needs far more memory per thread than the Rust
# seed: hosted runners were OOM-killed at the seed thread count (run
# 40075571655, phase 2). Builds by a handed-over phase use this count.
selfhost_threads=${PHASE_LADDER_SELFHOST_THREADS:-2}
emit() { # <phase> <binary> <climbed>
  dest=$out_dir/$platform-p$1
  mkdir -p "$dest"
  cp "$2" "$dest/simple$exe"
  chmod +x "$dest/simple$exe"
  echo "$1" > "$dest/PHASE"
  { echo "phase=$1"; echo "climbed=$3"; } >> "${GITHUB_OUTPUT:-/dev/null}"
  echo "phase-ladder: $platform phase $1 (climbed=$3) -> $dest"
}

# <compiler> <handoff-dir>: build the essential binaries with that compiler.
build_essentials() {
  mkdir -p "$2"
  ess=$(cd "$2" && pwd)/essentials
  mkdir -p "$ess"
  : > "$ess/STATUS"
  ok=0 total=0
  for spec in simple_cli:src/app/cli/main.spl \
              simple_test_runner:src/app/test_runner_new/main.spl \
              simple_build_runner:src/app/buildrunner/main.spl; do
    # Separate commands: FreeBSD sh expands every word of one command before
    # assigning, so $name would be unset under set -u.
    name=${spec%%:*}
    entry=${spec#*:}
    out=$ess/$name$exe
    total=$((total + 1))
    rc=0
    RUST_LOG=error SIMPLE_BOOTSTRAP=1 SIMPLE_SCV_INVENTORY_COLD_INIT=1 SIMPLE_PARSE_SHARDING=0 \
      "$1" native-build --source src/compositions/kernel_llvm_cranelift --source src \
      --entry-closure --entry "$entry" --mode dynload --threads "$selfhost_threads" \
      --output "$out" > "$ess/$name.log" 2>&1 || rc=$?
    result=failed
    if [ "$rc" -eq 0 ] && [ -s "$out" ] && [ -x "$out" ]; then
      result=ok
      # The full CLI must at least start; the runners have no --version contract.
      if [ "$name" = simple_cli ] && ! "$out" --version >> "$ess/$name.log" 2>&1; then result=failed; fi
    fi
    [ "$result" = ok ] && ok=$((ok + 1)) || rm -f "$out"
    echo "$name=$result" >> "$ess/STATUS"
    echo "phase-ladder: essential $name $result (rc=$rc, log $ess/$name.log)"
  done
  echo "essentials=$ok/$total" >> "${GITHUB_OUTPUT:-/dev/null}"
}

if [ "$have" -ge 4 ]; then
  emit 4 "$have_dir/simple$exe" false
  # Carry the phase-4 essentials forward; build them if an earlier rung did not.
  if [ -f "$have_dir/essentials/STATUS" ]; then
    cp -r "$have_dir/essentials" "$out_dir/$platform-p4/"
  elif [ "$platform" != linux-riscv64 ]; then
    build_essentials "$(cd "$have_dir" && pwd)/simple$exe" "$out_dir/$platform-p4"
  fi
  exit 0
fi

if [ "$platform" = linux-riscv64 ]; then
  set -- $(best_handoff linux-x86_64)
  host_phase=$1 host_dir=${2:-}
  if [ "$host_phase" -gt 0 ]; then
    next=$((host_phase + 1)); [ "$next" -le 4 ] || next=4
    if [ "$next" -le "$have" ]; then
      emit "$have" "$have_dir/simple" false
      exit 0
    fi
    SIMPLE_CROSS_THREADS=${SIMPLE_CROSS_THREADS:-$selfhost_threads} \
      SIMPLE_CROSS_FILE_TIMEOUT=${SIMPLE_CROSS_FILE_TIMEOUT:-10800} \
      sh scripts/bootstrap/cross-arch-bootstrap.shs --target linux-riscv64 \
      --compiler "$host_dir/simple" --phase "$next" --sanity
  else
    # First rung: newest proven linux-x86_64 compiler (RC), else the seed.
    sh scripts/bootstrap/cross-arch-bootstrap.shs --target linux-riscv64 --compiler auto --sanity
  fi
  next=$(cat build/cross/linux-riscv64/PHASE)
  [ "$next" -gt "$have" ] || { echo "phase-ladder: riscv64 cross-build did not climb above $have" >&2; exit 1; }
  emit "$next" build/cross/linux-riscv64/simple true
  mkdir -p "$out_dir/$platform-p$next/essentials"
  for name in simple_cli simple_test_runner simple_build_runner; do
    echo "$name=not-built: cross lane builds the compiler only" >> "$out_dir/$platform-p$next/essentials/STATUS"
  done
  exit 0
fi

# Native lane: stage the handoff where the resolver looks first.
if [ "$have" -gt 0 ]; then
  mkdir -p "build/bootstrap/stage$have"
  cp "$have_dir/simple$exe" "build/bootstrap/stage$have/simple$exe"
  chmod +x "build/bootstrap/stage$have/simple$exe"
fi
next_threads=$threads
[ "$have" -gt 0 ] && next_threads=$selfhost_threads
if ! SIMPLE_BOOTSTRAP_COMPILER=auto sh scripts/bootstrap/build-next-phase-ci.shs "$platform" "$next_threads"; then
  # Nothing to climb from: phase 1 comes from the Rust seed (as release.yml).
  [ "$have" -eq 0 ] || { echo "phase-ladder: phase $((have + 1)) build failed" >&2; exit 1; }
  # An earlier rung's failed seed is not a qualified input. Do not cold-repeat
  # it merely because always() scheduled another rung. Retained keyed objects
  # stay diagnostic until a real owner admits an exact-producer continuation.
  prior_diagnostics=${PHASE_LADDER_PRIOR_DIAGNOSTICS_ROOT:-build/ladder/diagnostics}
  for prior_failure in "$prior_diagnostics"/*/seed-native-failure.sdn; do
    [ -f "$prior_failure" ] || continue
    if grep -Fxq "source_revision: $source_revision" "$prior_failure" &&
       grep -Fxq "platform: $platform" "$prior_failure" &&
       grep -Fxq "seed_threads: $threads" "$prior_failure"; then
      attempt_role=blocked-unchanged-seed
      echo "phase-ladder: unchanged failed seed blocked; retained cache requires actual owner continuation admission" >&2
      exit 86
    fi
  done
  echo "phase-ladder: no qualified compiler; building phase 1 with the Rust seed"
  unset_dyld=
  case $platform in darwin-*) unset_dyld="-u DYLD_LIBRARY_PATH" ;; esac
  (cd src/compiler_rust &&
    env $unset_dyld cargo build --profile bootstrap -p simple-driver &&
    env $unset_dyld cargo build --profile bootstrap -p simple-native-all --features driver-compat)
  # Freeze actual bootstrap-only producer bytes beside the diagnostic cache.
  cp "src/compiler_rust/target/bootstrap/simple$exe" "$producer_root/simple$exe"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$producer_root/simple$exe" > "$producer_root/producer.sha256"
  else
    sha256 -q "$producer_root/simple$exe" > "$producer_root/producer.sha256"
  fi
  git rev-parse HEAD > "$evidence_root/source-revision.txt"
  git show HEAD:config/bootstrap.sdn > "$evidence_root/bootstrap.sdn"
  mkdir -p build/bootstrap/stage1
  attempt_role=seed-native
  printf '%s\n' "native-build --source src/compositions/kernel_llvm_cranelift --source src --entry-closure --entry src/app/cli/bootstrap_main.spl --mode dynload --threads $threads --cache-dir $cache_root/seed-phase1 --verbose --output build/bootstrap/stage1/simple$exe" > "$evidence_root/seed-argv-display.txt"
  RUST_LOG=error SIMPLE_BOOTSTRAP=1 SIMPLE_NATIVE_BUILD_RUST=1 SIMPLE_SCV_INVENTORY_COLD_INIT=1 SIMPLE_PARSE_SHARDING=0 \
    "src/compiler_rust/target/bootstrap/simple$exe" native-build \
    --source src/compositions/kernel_llvm_cranelift --source src \
    --entry-closure --entry src/app/cli/bootstrap_main.spl \
    --mode dynload --threads "$threads" --cache-dir "$cache_root/seed-phase1" --verbose \
    --output "build/bootstrap/stage1/simple$exe"
fi
next=0
for p in 4 3 2 1; do
  [ -f "build/bootstrap/stage$p/simple$exe" ] && { next=$p; break; }
done
[ "$next" -gt "$have" ] || { echo "phase-ladder: no phase above $have was built" >&2; exit 1; }
bin=build/bootstrap/stage$next/simple$exe

# Sanity: --version is not enough (see resolve-bootstrap-compiler.shs);
# the new phase must build and run a hello world.
# Absolute paths: Windows hello builds fail with "diagnostic staging
# unavailable" only under harnesses; a relative output parent is that bug's
# open hypothesis (stage2_sanity_diagnostic_staging_unavailable_2026-09-12).
probe=$(pwd)/build/ladder-sanity
rm -rf "$probe" && mkdir -p "$probe"
printf 'fn main():\n    print "phase-ladder-%s-ok"\n' "$next" > "$probe/hello.spl"
"./$bin" --version
if ! "./$bin" native-build "$probe/hello.spl" -o "$probe/hello$exe"; then
  # A crashing compiler leaves no core on hosted runners: replay under lldb
  # (macOS) or gdb for a backtrace, then fail.
  if command -v lldb >/dev/null 2>&1; then
    lldb --batch -o run -o "bt 40" -o "register read" -- "./$bin" native-build "$probe/hello.spl" -o "$probe/hello$exe" || :
  elif command -v gdb >/dev/null 2>&1; then
    gdb -q -batch -ex run -ex "bt 40" --args "./$bin" native-build "$probe/hello.spl" -o "$probe/hello$exe" || :
  fi
  # Keep the rejected compiler for offline analysis; no PHASE file, so no
  # later rung climbs from it.
  mkdir -p "$out_dir/$platform-rejected-p$next"
  cp "./$bin" "$out_dir/$platform-rejected-p$next/"
  echo "phase-ladder: phase $next hello build failed" >&2
  exit 1
fi
"$probe/hello$exe" | grep -q "phase-ladder-$next-ok"
emit "$next" "$bin" true
if [ "$next" -ge "${PHASE_LADDER_ESSENTIALS_FROM:-3}" ]; then
  build_essentials "$(pwd)/$bin" "$out_dir/$platform-p$next"
else
  mkdir -p "$out_dir/$platform-p$next/essentials"
  for name in simple_cli simple_test_runner simple_build_runner; do
    echo "$name=not-built: phase $next is below ${PHASE_LADDER_ESSENTIALS_FROM:-3}" >> "$out_dir/$platform-p$next/essentials/STATUS"
  done
fi
