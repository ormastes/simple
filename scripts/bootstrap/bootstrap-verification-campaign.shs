#!/bin/sh
# One deadline owns the whole matrix; row watchdogs retain their RSS policy.
bootstrap_verification_campaign_policy() {
  case "$1" in ''|*[!0-9]*) return 2 ;; esac
  [ "$1" -gt 0 ] || return 2
  case "$2" in ''|*[!0-9]*) return 2 ;; esac
}

# Zero means every pending module, not zero work. Full keep-going campaigns
# must not become eight-module checkpoints merely because a tool build failed.
# Explicit fail-fast and the opt-in slim profile retain the configured bound.
bootstrap_verification_module_limit() {
  case "$1" in normal|full) ;; *) return 2 ;; esac
  case "$2" in full|slim) ;; *) return 2 ;; esac
  case "$3" in 0|1) ;; *) return 2 ;; esac
  case "$4" in ''|*[!0-9]*) return 2 ;; esac
  if [ "$3" = 0 ] && { [ "$1" = full ] || [ "$2" = full ]; }; then
    printf '0\n'
  else
    printf '%s\n' "$4"
  fi
}

bootstrap_verification_campaign_child() {
  [ -n "${BOOTSTRAP_VERIFY_CAMPAIGN_TOKEN:-}" ] &&
    [ -f "$BOOTSTRAP_VERIFY_CAMPAIGN_TOKEN" ] &&
    [ ! -L "$BOOTSTRAP_VERIFY_CAMPAIGN_TOKEN" ] &&
    [ "$(sed -n 's/^work_root=//p' "$BOOTSTRAP_VERIFY_CAMPAIGN_TOKEN")" = "$1" ] &&
    [ "$(sed -n 's/^deadline_epoch=//p' "$BOOTSTRAP_VERIFY_CAMPAIGN_TOKEN")" = "${BOOTSTRAP_VERIFY_CAMPAIGN_DEADLINE:-}" ] || return 1
  bcc_deadline=${BOOTSTRAP_VERIFY_CAMPAIGN_DEADLINE:-}
  bcc_pid=$(sed -n 's/^owner_pid=//p' "$BOOTSTRAP_VERIFY_CAMPAIGN_TOKEN")
  case "$bcc_deadline:$bcc_pid" in *[!0-9:]*|:*|*:) return 1 ;; esac
  [ "$bcc_deadline" -gt "$(date +%s)" ] && [ "$bcc_pid" -gt 0 ] &&
    [ -f "${BOOTSTRAP_VERIFY_CAMPAIGN_TOKEN%/*}/active" ] &&
    kill -0 "$bcc_pid" 2>/dev/null
}

bootstrap_verification_campaign_run() {
  bc_seconds=$1 bc_work=$2 bc_script=$3 bc_owner=$4; shift 4
  bc_owner=$(CDPATH= cd -- "$bc_owner" && pwd -P)
  bc_attempt=$(mktemp -d "$bc_work/campaign.XXXXXX") || exit 2
  mkdir -p "$bc_attempt/tmp" || exit 2
  : >"$bc_attempt/prior-module-attempts"
  for bc_prior in "$bc_work"/module-diagnostics/attempt.*; do
    [ ! -d "$bc_prior" ] || printf '%s\n' "$bc_prior" >>"$bc_attempt/prior-module-attempts"
  done
  : >"$bc_attempt/active"
  bc_started=$(date +%s)
  BOOTSTRAP_VERIFY_CAMPAIGN_DEADLINE=$((bc_started + bc_seconds))
  BOOTSTRAP_VERIFY_CAMPAIGN_TOKEN="$bc_attempt/owner.env"
  printf 'work_root=%s\nstarted_epoch=%s\ndeadline_epoch=%s\ntimeout_seconds=%s\nowner_pid=%s\n' \
    "$bc_work" "$bc_started" "$BOOTSTRAP_VERIFY_CAMPAIGN_DEADLINE" "$bc_seconds" "$$" >"$BOOTSTRAP_VERIFY_CAMPAIGN_TOKEN"
  export BOOTSTRAP_VERIFY_CAMPAIGN_TOKEN BOOTSTRAP_VERIFY_CAMPAIGN_DEADLINE
  bc_row_rss_mode=${SIMPLE_BOOTSTRAP_RSS_CAP_MODE:-enforce}
  # Keep an actual registered enclosing execution owner. Presence of either
  # field chooses strict native admission; malformed/partial contracts fail
  # closed in the watchdog rather than starting a foreign nested session.
  bc_session_mode=new
  if [ "${SIMPLE_BOOTSTRAP_SESSION_ID+x}${SIMPLE_BOOTSTRAP_SESSION_EXEC+x}" != "" ]; then
    bc_session_mode=inherit
  fi
  bc_campaign_rss_cap=${SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB:-5859375}
  # The campaign watchdog wraps the whole phase tree directly (rows nest
  # inside it), so it must declare the phase worker count itself: without
  # --compiler-jobs its ceiling stays at the static 8 GiB, which the full
  # verification matrix measurably exceeds (~8.4 GiB peak on a 64 GiB Windows
  # host). The declaration is exported by bootstrap-phase-verification.shs
  # (SIMPLE_PROCESS_TREE_RSS_DECLARED_JOBS = build_threads); same source the
  # per-row timeout owner consumes.
  bc_campaign_jobs_arg=
  case "${SIMPLE_PROCESS_TREE_RSS_DECLARED_JOBS:-}" in
    ''|*[!0-9]*) ;;
    *) if [ "$SIMPLE_PROCESS_TREE_RSS_DECLARED_JOBS" -ge 1 ] &&
          [ "$SIMPLE_PROCESS_TREE_RSS_DECLARED_JOBS" -le 128 ]; then
         bc_campaign_jobs_arg=--compiler-jobs="$SIMPLE_PROCESS_TREE_RSS_DECLARED_JOBS"
       fi ;;
  esac
  # Forward an explicitly admitted elevated compiler ceiling the same way the
  # per-row owner does for native-build commands (run-process-group-timeout
  # lines below the same pattern): the watchdog admits it only under 3/4 of
  # real total AND available host memory, with enforced scope and declared
  # jobs. Non-build rows unset the pair and keep the default policy.
  bc_campaign_ceiling_arg=
  if [ -n "${SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB:-}" ]; then
    case "$SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB" in
      ''|0*|*[!0-9]*) ;;
      *) [ -n "$bc_campaign_jobs_arg" ] &&
           bc_campaign_ceiling_arg=--compiler-ceiling-kib="$SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB" ;;
    esac
  fi
  # The canonical watchdog validates this cap against its compiler ceiling.
  # Campaign and rows keep the caller's actual enforcement policy.
  bc_status=0 bc_guard=
  bc_cancel() {
    [ -z "$bc_guard" ] || kill -TERM "$bc_guard" 2>/dev/null || :
  }
  trap 'bc_cancel' 1 2 15
  TMPDIR="$bc_attempt/tmp" perl "$bc_owner/../resource/process-tree-rss-watchdog.pl" \
    --session-mode="$bc_session_mode" --rss-cap-mode="$bc_row_rss_mode" --max-rss-kib="$bc_campaign_rss_cap" \
    $bc_campaign_jobs_arg \
    $bc_campaign_ceiling_arg \
    --timeout-seconds="$bc_seconds" --term-grace-seconds=2 \
    --receipt="$bc_attempt/process.env" -- \
    env "SIMPLE_BOOTSTRAP_RSS_CAP_MODE=$bc_row_rss_mode" sh "$bc_script" "$@" &
  bc_guard=$!
  wait "$bc_guard" || bc_status=$?
  # A signal can interrupt wait before the guard finishes its owned-job cleanup.
  if kill -0 "$bc_guard" 2>/dev/null; then
    wait "$bc_guard" || bc_status=$?
  fi
  trap - 1 2 15
  rm -f "$bc_attempt/active"
  bc_reason=$(sed -n 's/^status=//p' "$bc_attempt/process.env" 2>/dev/null || :)
  printf 'status=%s\nexit_status=%s\nstarted_epoch=%s\ndeadline_epoch=%s\nfinished_epoch=%s\nprocess_receipt=%s\n' \
    "$bc_reason" "$bc_status" "$bc_started" "$BOOTSTRAP_VERIFY_CAMPAIGN_DEADLINE" "$(date +%s)" "$bc_attempt/process.env" >"$bc_attempt/result.env"
  if [ "$bc_reason" = timeout ] || [ "$bc_reason" = interrupted ]; then
    bc_total=unknown bc_started_modules=0 bc_terminal_modules=0
    if [ -f "$bc_work/module-compile-inventory.txt" ]; then
      bc_total=$(awk 'NF { n++ } END { print n+0 }' "$bc_work/module-compile-inventory.txt")
    fi
    for bc_entry in "$bc_work"/module-diagnostics/attempt.*/*/entry; do
      [ -f "$bc_entry" ] || continue
      bc_module_attempt=${bc_entry%/*/entry}
      grep -Fqx -- "$bc_module_attempt" "$bc_attempt/prior-module-attempts" && continue
      bc_started_modules=$((bc_started_modules + 1))
      [ ! -s "${bc_entry%/entry}/row" ] || bc_terminal_modules=$((bc_terminal_modules + 1))
    done
    bc_unstarted=unknown
    [ "$bc_total" = unknown ] || bc_unstarted=$((bc_total - bc_started_modules))
    printf 'campaign_scope_completed=0\ncampaign_module_started=%s\ncampaign_module_terminal=%s\ncampaign_module_interrupted=%s\ncampaign_module_unstarted=%s\n' \
      "$bc_started_modules" "$bc_terminal_modules" "$((bc_started_modules - bc_terminal_modules))" "$bc_unstarted" >>"$bc_work/summary.env"
  fi
  if [ "$bc_reason" = timeout ]; then
    printf 'task=campaign_deadline|result=TIMEOUT|status=124|log=%s\noverall=FAIL\n' \
      "$bc_attempt/process.env" >>"$bc_work/summary.env"
    printf 'bootstrap-phase-verification: global campaign deadline reached; evidence preserved: %s\n' "$bc_attempt" >&2
  elif [ "$bc_reason" = interrupted ]; then
    printf 'task=campaign_interrupted|result=FAIL|status=%s|log=%s\noverall=FAIL\n' \
      "$bc_status" "$bc_attempt/process.env" >>"$bc_work/summary.env"
  fi
  return "$bc_status"
}

bootstrap_verification_select_modules() {
  # Keep the full manifest and explicitly describe unexecuted scope.
  bvm_full=$1 bvm_selected=$2 bvm_cli=$3 bvm_runner=$4 bvm_limit=$5 bvm_summary=$6
  if [ -n "${MODULE_PROGRESS_STATE:-}" ]; then
    bvm_effective_limit=$bvm_limit
    [ "$bvm_cli:$bvm_runner" != 1:1 ] || bvm_effective_limit=0
    python3 "$MODULE_PROGRESS_HELPER" select "$bvm_full" "$bvm_selected" "$MODULE_PROGRESS_STATE" "$MODULE_PROGRESS_CONTEXT" "$MODULE_PROGRESS_TARGET" "$bvm_effective_limit" "$bvm_summary"
    return $?
  fi
  bvm_total=$(awk 'NF { n++ } END { print n+0 }' "$bvm_full") || return 2
  if [ "$bvm_cli" = 1 ] && [ "$bvm_runner" = 1 ]; then
    cp "$bvm_full" "$bvm_selected" || return 2
    bvm_selected_count=$bvm_total
  else
    awk -v limit="$bvm_limit" 'NF { n++; if (limit == 0 || n <= limit) print }' "$bvm_full" >"$bvm_selected" || return 2
    bvm_selected_count=$(awk 'NF { n++ } END { print n+0 }' "$bvm_selected") || return 2
  fi
  bvm_unexecuted=$((bvm_total - bvm_selected_count))
  printf 'module_compile_inventory_count=%s\nmodule_compile_selected_count=%s\nmodule_compile_unexecuted_count=%s\nmodule_compile_selected_inventory=%s\n' \
    "$bvm_total" "$bvm_selected_count" "$bvm_unexecuted" "$bvm_selected" >>"$bvm_summary"
  if [ "$bvm_unexecuted" -gt 0 ]; then
    awk -v limit="$bvm_selected_count" 'NF { n++; if (n > limit) print }' "$bvm_full" >"$bvm_selected.unexecuted" || return 2
    printf 'task=module_compile_unexecuted|result=INCOMPLETE|status=bounded-campaign-checkpoint|count=%s|log=%s\n' \
      "$bvm_unexecuted" "$bvm_selected.unexecuted" >>"$bvm_summary"
  fi
}
