#!/bin/sh
# Pick the compiler that builds the next bootstrap phase.
#
#   sh scripts/bootstrap/resolve-bootstrap-compiler.shs --platform <p> [--config <sdn>]
#      [--lane-dir build/bootstrap] [--work-dir <dir>] [--min-phase <N>]
#
# Selection (config/bootstrap.sdn `compiler:`, env SIMPLE_BOOTSTRAP_COMPILER wins):
#   auto     local stage4 > stage3 > stage2 > stage1 of the lane, then the release binary,
#            else none (caller falls back to the Rust seed unless min_phase > 1)
#   local    local phases only;  release  release binary only;  seed  none
#   <path>   that binary
# Minimum phase floor (--min-phase > SIMPLE_BOOTSTRAP_MIN_PHASE > config `min_phase:` > 1):
#   Candidates with phase < min_phase are skipped/rejected before probing.
#   When --config is omitted and --platform selects Windows MSVC
#   (x86_64-pc-windows-msvc / windows-msvc / windows-x86_64-msvc),
#   config/bootstrap/windows-msvc.sdn is loaded automatically (min_phase: 3).
# Every candidate must native-build AND run a hello world before it is chosen:
# `--version` alone is not enough (a FreeBSD stage1 answered it and still could
# not stage a compile). Prints "<path> <phase>" on stdout, exit 0; exit 1 when
# no candidate qualified (use the seed only when allowed); exit 2 on usage errors.
set -u

script_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." 2>/dev/null && pwd -P) || script_root=""
platform=
config=config/bootstrap.sdn
config_explicit=0
lane_dir=build/bootstrap
work_dir=${TMPDIR:-/tmp}/simple-bootstrap-compiler
cli_min_phase=
while [ $# -gt 0 ]; do
  case $1 in
    --platform) [ $# -ge 2 ] || { printf 'resolve-bootstrap-compiler: --platform requires a value\n' >&2; exit 2; }; platform=$2; shift 2 ;;
    --config) [ $# -ge 2 ] || { printf 'resolve-bootstrap-compiler: --config requires a value\n' >&2; exit 2; }; config=$2; config_explicit=1; shift 2 ;;
    --lane-dir) [ $# -ge 2 ] || { printf 'resolve-bootstrap-compiler: --lane-dir requires a value\n' >&2; exit 2; }; lane_dir=$2; shift 2 ;;
    --work-dir) [ $# -ge 2 ] || { printf 'resolve-bootstrap-compiler: --work-dir requires a value\n' >&2; exit 2; }; work_dir=$2; shift 2 ;;
    --min-phase) [ $# -ge 2 ] || { printf 'resolve-bootstrap-compiler: --min-phase requires a value\n' >&2; exit 2; }; cli_min_phase=$2; shift 2 ;;
    --min-phase=*) cli_min_phase=${1#--min-phase=}; shift ;;
    --help|-h)
      printf 'usage: sh scripts/bootstrap/resolve-bootstrap-compiler.shs --platform <p> [--config <sdn>] [--lane-dir <dir>] [--work-dir <dir>] [--min-phase <N>]\n'
      exit 0 ;;
    *) printf 'resolve-bootstrap-compiler: unknown argument %s\n' "$1" >&2; exit 2 ;;
  esac
done
[ -n "$platform" ] || { printf 'resolve-bootstrap-compiler: --platform is required\n' >&2; exit 2; }

if [ "$config_explicit" -eq 0 ]; then
  case $platform in
    x86_64-pc-windows-msvc|windows-msvc|windows-x86_64-msvc)
      if [ -f config/bootstrap/windows-msvc.sdn ]; then
        config=config/bootstrap/windows-msvc.sdn
      elif [ -n "$script_root" ] && [ -f "$script_root/config/bootstrap/windows-msvc.sdn" ]; then
        config=$script_root/config/bootstrap/windows-msvc.sdn
      fi ;;
  esac
fi

sdn_value() {
  [ -f "$config" ] || return 0
  awk -v key="$1" '
    /^[[:space:]]*#/ { next }
    { line=$0; sub(/[[:space:]]*#.*/, "", line)
      if (line ~ "^[[:space:]]*" key "[[:space:]]*:") {
        sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "", line); sub(/[[:space:]]*$/, "", line)
        print line; exit } }' "$config"
}

mode=${SIMPLE_BOOTSTRAP_COMPILER:-$(sdn_value compiler)}
mode=${mode:-auto}
release=$(sdn_value compiler_release)
release=${release:-latest}
cfg_min_phase=$(sdn_value min_phase)
allow_seed_fallback=$(sdn_value allow_seed_fallback)
allow_seed_fallback=${allow_seed_fallback:-true}
if [ -n "$cli_min_phase" ]; then
  min_phase=$cli_min_phase
elif [ -n "${SIMPLE_BOOTSTRAP_MIN_PHASE:-}" ]; then
  min_phase=$SIMPLE_BOOTSTRAP_MIN_PHASE
elif [ -n "$cfg_min_phase" ]; then
  min_phase=$cfg_min_phase
else
  min_phase=1
fi
case $min_phase in
  ''|*[!0-9]*) printf 'resolve-bootstrap-compiler: --min-phase must be a positive integer, got %s\n' "$min_phase" >&2; exit 2 ;;
esac
if [ "$min_phase" -lt 1 ]; then
  printf 'resolve-bootstrap-compiler: --min-phase must be >= 1, got %s\n' "$min_phase" >&2
  exit 2
fi
exe=
case $platform in windows-*|*-windows-*) exe=.exe ;; esac

mkdir -p "$work_dir" || exit 2

# A candidate qualifies when it compiles and runs a hello world.
qualifies() {
  cand=$1
  [ -f "$cand" ] || return 1
  candidate_path=$(CDPATH= cd -- "$(dirname "$cand")" && printf '%s/%s' "$(pwd -P)" "$(basename "$cand")") || return 1
  # SCV admits source only within the caller's checkout, even when downloads,
  # outputs and retained logs use an external --work-dir. Never share/delete a
  # probe directory: concurrent candidate selection must not destroy evidence.
  checkout_root=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  checkout_root=$(CDPATH= cd -- "$checkout_root" && pwd -P) || return 1
  # SCV takes the compiler's CWD as its admission root, not its Git ancestor.
  # Preserve the caller-facing candidate spelling but execute absolute paths
  # from the actual checkout root, including subdirectory invocations.
  (CDPATH= cd -- "$checkout_root" && "$candidate_path" --version) >/dev/null 2>&1 || return 1
  source_parent=$checkout_root/build/bootstrap/compiler-probes
  mkdir -p "$source_parent" || return 1
  source_parent=$(CDPATH= cd -- "$source_parent" && pwd -P) || return 1
  case $source_parent in "$checkout_root"/*) ;; *)
    printf 'resolve-bootstrap-compiler: probe source directory escapes caller checkout\n' >&2
    return 1 ;;
  esac
  probe_source=$(mktemp -d "$source_parent/probe.XXXXXX") || return 1
  probe=$(mktemp -d "$work_dir/probe.XXXXXX") || return 1
  probe=$(CDPATH= cd -- "$probe" && pwd -P) || return 1
  printf '%s\n' "$probe_source/hello.spl" > "$probe/source-path"
  printf 'fn main():\n    print "bootstrap-compiler-probe"\n' > "$probe_source/hello.spl"
  (CDPATH= cd -- "$checkout_root" &&
    SIMPLE_CACHE_SCOPE="bootstrap-compiler-${probe_source##*/}" \
    "$candidate_path" native-build "$probe_source/hello.spl" -o "$probe/hello$exe") >"$probe/build.log" 2>&1 || {
    printf 'resolve-bootstrap-compiler: %s failed the hello build:\n' "$cand" >&2
    tail -5 "$probe/build.log" >&2
    return 1
  }
  probe_run_status=0
  (CDPATH= cd -- "$checkout_root" && "$probe/hello$exe") >"$probe/run.log" 2>"$probe/run.stderr" || probe_run_status=$?
  printf '%s\n' "$probe_run_status" > "$probe/run-exit-status"
  [ "$probe_run_status" -eq 0 ] || return 1
  printf 'bootstrap-compiler-probe\n' > "$probe/expected-lf"
  printf 'bootstrap-compiler-probe\r\n' > "$probe/expected-crlf"
  cmp -s "$probe/expected-lf" "$probe/run.log" || cmp -s "$probe/expected-crlf" "$probe/run.log"
}

try_local() {
  for phase in 4 3 2 1; do
    if [ "$phase" -lt "$min_phase" ]; then
      continue
    fi
    cand=$lane_dir/stage$phase/simple$exe
    if qualifies "$cand"; then
      printf '%s %s\n' "$cand" "$phase"
      return 0
    fi
  done
  return 1
}

try_release() {
  command -v gh >/dev/null 2>&1 || { printf 'resolve-bootstrap-compiler: gh not found; no release binary\n' >&2; return 1; }
  if [ "$release" = latest ]; then
    tags=$(gh release list --limit 30 --json tagName --jq '.[].tagName' 2>/dev/null | grep -E '^(rc-|v)')
  else
    tags=$release
  fi
  for tag in $tags; do
    dl=$work_dir/release-$tag
    rm -rf "$dl" && mkdir -p "$dl" || return 1
    gh release download "$tag" --pattern "simple-bootstrap-*-$platform.spk" -D "$dl" >/dev/null 2>&1 || continue
    spk=$(ls "$dl"/*.spk 2>/dev/null | head -1)
    [ -n "$spk" ] && tar -xzf "$spk" -C "$dl" || continue
    cand=$(find "$dl" -path '*/bin/simple-runtime' -o -path '*/bin/simple.exe' | head -1)
    [ -n "$cand" ] || continue
    chmod +x "$cand"
    # The package launcher (bin/simple) sets this before exec; the payload
    # needs it to find the bundled stdlib.
    SIMPLE_ASSET_ROOT=$(cd "$(dirname "$cand")/.." && pwd)
    export SIMPLE_ASSET_ROOT
    phase=$(cat "$(dirname "$cand")/../PHASE" 2>/dev/null | tr -d '[:space:]')
    case $phase in
      ''|*[!0-9]*) phase=1 ;;
    esac
    if [ "$phase" -lt "$min_phase" ]; then
      printf 'resolve-bootstrap-compiler: skipping %s from release %s (phase %s < min_phase %s)\n' "$cand" "$tag" "$phase" "$min_phase" >&2
      continue
    fi
    if qualifies "$cand"; then
      printf 'resolve-bootstrap-compiler: using %s from release %s (phase %s)\n' "$cand" "$tag" "$phase" >&2
      printf '%s %s\n' "$cand" "$phase"
      return 0
    fi
  done
  return 1
}

fail_no_candidate() {
  if [ "$min_phase" -gt 1 ] || [ "$allow_seed_fallback" = false ]; then
    printf 'resolve-bootstrap-compiler: no candidate with phase >= %s qualified (allow_seed_fallback=%s)\n' "$min_phase" "$allow_seed_fallback" >&2
  fi
  exit 1
}

case $mode in
  seed)
    if [ "$min_phase" -gt 1 ] || [ "$allow_seed_fallback" = false ]; then
      printf 'resolve-bootstrap-compiler: refusing seed mode (min_phase=%s, allow_seed_fallback=%s)\n' "$min_phase" "$allow_seed_fallback" >&2
    fi
    exit 1 ;;
  auto) try_local || try_release || fail_no_candidate ;;
  local) try_local || fail_no_candidate ;;
  release) try_release || fail_no_candidate ;;
  *)
    explicit_phase=${SIMPLE_BOOTSTRAP_COMPILER_PHASE:-1}
    case $explicit_phase in
      ''|*[!0-9]*)
        printf 'resolve-bootstrap-compiler: invalid SIMPLE_BOOTSTRAP_COMPILER_PHASE=%s\n' "$explicit_phase" >&2
        exit 2 ;;
    esac
    if [ "$explicit_phase" -lt "$min_phase" ]; then
      printf 'resolve-bootstrap-compiler: refusing configured compiler %s (phase %s < min_phase %s)\n' "$mode" "$explicit_phase" "$min_phase" >&2
      exit 1
    fi
    if qualifies "$mode"; then printf '%s %s\n' "$mode" "$explicit_phase"
    else printf 'resolve-bootstrap-compiler: configured compiler %s did not qualify\n' "$mode" >&2; exit 1
    fi ;;
esac
