#!/bin/sh
# One owner for phase-qualified native Hello linkage evidence.
# Phases 1-2: hello-sanity-matrix.py (Python is admitted only before phase 2 is
# built and verified). Phase 3: the pure-Simple twin, run on the verified stage
# binary SIMPLE_VERIFIED_STAGE_BINARY, pinned by SIMPLE_VERIFIED_STAGE_PIN
# (or --stage-pin). Fails closed (exit 2) when phase 3 has no stage binary.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
phase=
prev=
for arg in "$@"; do
  case "$arg" in
    --phase=*) phase=${arg#--phase=} ;;
    *) [ "$prev" = "--phase" ] && phase=$arg ;;
  esac
  prev=$arg
done
if [ "$phase" = "3" ]; then
  stage=${SIMPLE_VERIFIED_STAGE_BINARY:-}
  if [ -z "$stage" ] || [ ! -x "$stage" ]; then
    echo "ERROR: phase 3 requires SIMPLE_VERIFIED_STAGE_BINARY (verified stage binary); no Python fallback" >&2
    exit 2
  fi
  exec "$stage" run "$here/hello-sanity-matrix.spl" "$@" --stage-binary "$stage"
fi
exec python3 "$here/hello-sanity-matrix.py" "$@"
