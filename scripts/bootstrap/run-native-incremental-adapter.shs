#!/bin/sh
# One stable workspace/cache per lane; immutable compact evidence per prefix.
set -eu
tools=$(CDPATH= cd -P -- "$(dirname "$0")/../.." && pwd -P)
[ "$#" -eq 6 ] || { echo 'expected workspace admitted-compiler backend generated-prefix-directory stable-lane-directory previous-green-result' >&2; exit 2; }
workspace=$1 compiler=$2 backend=$3 evidence=$4 lane=$5 previous_green=$6
for path in "$workspace" "$compiler" "$evidence" "$lane" "$previous_green"; do case "$path" in /*) ;; *) exit 2 ;; esac; done
case "$backend" in llvm|cranelift) ;; *) exit 2 ;; esac
workspace=$(CDPATH= cd -P -- "$workspace" && pwd -P)
field() { perl -e 'my($k,$p)=@ARGV;open my $f,"<",$p or die $!;my @v=map{/^\Q$k\E=(.*)$/?$1:()}<$f>;@v==1 or die "missing/duplicate field";print $v[0]' "$1" "$2"; }
hash() { perl -MDigest::SHA -e 'open my $f,"<:raw",$ARGV[0] or die $!;my $s=Digest::SHA->new(256);$s->addfile($f);print $s->hexdigest' "$1"; }
[ -z "${SIMPLE_BOOTSTRAP_EMPTY_NATIVE_OBJ:-}${SIMPLE_BOOTSTRAP:-}" ] || exit 2
sha=$(hash "$compiler")
admission=$(dirname "$compiler")/admission.env
perl "$tools/scripts/bootstrap/product-producer-fields.pl" "$admission" qualified "$compiler" "$sha" "$workspace" >/dev/null
binding=$(dirname "$compiler")/runtime-capsule.env
[ "$(field schema "$binding")" = simple-phase2-runtime-binding-v1 ]
[ "$(field compiler_sha256 "$binding")" = "$sha" ]
capsule=$(field capsule_path "$binding")
[ "$(hash "$capsule/phase2-runtime-capsule.env")" = "$(field capsule_receipt_sha256 "$binding")" ]
[ "$(field compiler_sha256 "$capsule/phase2-runtime-capsule.env")" = "$sha" ]
runtime=$(field runtime_authority_path "$admission")
[ "$(field source_authority_path "$capsule/phase2-runtime-capsule.env")" = "$runtime" ]
sh "$tools/scripts/bootstrap/phase2-runtime-capsule.shs" verify "$capsule" >/dev/null
mkdir -p "$lane"
mkdir "$lane/writer.lock" || { echo 'lane has another writer' >&2; exit 2; }
trap 'rmdir "$lane/writer.lock"' EXIT HUP INT TERM
expected_binding=$(printf '%s\n' "workspace=$workspace" "compiler_sha256=$sha" "backend=$backend")
if [ -e "$lane/binding.env" ]; then
    [ "$(cat "$lane/binding.env")" = "$expected_binding" ] || { echo 'cache lineage changed' >&2; exit 2; }
else printf '%s\n' "$expected_binding" >"$lane/binding.env"; fi
[ ! -e "$evidence/build.env" ] && [ ! -e "$evidence/result.json" ] || { echo 'prefix already attempted; retain evidence' >&2; exit 2; }
perl -MJSON::PP -MDigest::SHA=sha256_hex -MFile::Basename=dirname -e '
sub read_bytes {open my $f,"<:raw",$_[0] or die $!;local $/;return <$f>;}
my($root,$workspace,$green)=@ARGV;my $p=decode_json(read_bytes("$root/manifest.json"));
$p->{source_root} eq $workspace && $p->{negative_control_available} or die "unsupported prefix build";
for my $v(qw(positive negative)){sha256_hex(read_bytes("$root/$v-entry.spl")) eq $p->{variants}{$v}{entry_sha256} or die "entry changed";}
for my $o(@{$p->{owners}}){sha256_hex(read_bytes("$workspace/$o->{path}")) eq $o->{source_sha256} or die "source changed";}
my $g=decode_json(read_bytes($green)); !$g->{formal_product_pass} or die "incorrect prior authority";
my @old=grep {$_->{attachment} eq "attached" && $_->{path} ne $p->{ordered_paths}[-1]} @{$p->{owners}};
if(($g->{schema}//"") eq "simple-restricted-native-adapter-result-v1") {
 $g->{status} eq "RESTRICTED_NATIVE_GATE_PASS" && @old==1 && $old[0]{path} eq "test/01_unit/compiler/interpreter/while_body_scope_spec.spl"
  && $g->{variants}{positive}{source_sha256} eq $old[0]{source_sha256} && $g->{variants}{positive}{run_exit}==0 && $g->{variants}{negative}{run_exit}==1
  or die "first-file migration proof differs";
} else {
 $g->{schema} eq "simple-restricted-prefix-result-v1" && $g->{status} eq "RESTRICTED_PREFIX_GATE_PASS" or die "preceding native gate absent";
 my $old_bytes=read_bytes(dirname($green)."/manifest.json");sha256_hex($old_bytes) eq $g->{manifest_sha256} or die "preceding manifest changed";
 my $old=decode_json($old_bytes);my @proved=grep {$_->{attachment} eq "attached"} @{$old->{owners}};
 @proved==@old && $g->{executed_owners}==@old or die "preceding attached count differs";
 for my $i(0..$#old){$old[$i]{path} eq $proved[$i]{path} && $old[$i]{source_sha256} eq $proved[$i]{source_sha256} or die "preceding native owner differs";}
}
' "$evidence" "$workspace" "$previous_green"
{
    printf '%s\n' 'schema=simple-restricted-prefix-build-v1' 'formal_product_pass=0' "$expected_binding"
    printf '%s\n' "runtime=$runtime" "runtime_cwd=$workspace" "manifest_sha256=$(hash "$evidence/manifest.json")"
    printf '%s\n' "previous_green_path=$previous_green" "previous_green_sha256=$(hash "$previous_green")"
    printf '%s\n' 'SIMPLE_HIR_CACHE=0' 'SIMPLE_SCV_INVENTORY_COLD_INIT=1' 'SIMPLE_NO_STUB_FALLBACK=1' 'threads=10' 'rss_cap_kib=6835937' 'observation_budget_ms=5000'
} >"$evidence/build.env"
mkdir -p "$lane/tmp" "$lane/user-storage" "$lane/worktree-storage"
for variant in positive negative; do
    entry=src/app/native_incremental_adapter/$variant/main.spl
    mkdir -p "$workspace/$(dirname "$entry")"
    cp "$evidence/$variant-entry.spl" "$workspace/$entry"
    (
        cd "$workspace"
        export SIMPLE_HIR_CACHE=0 SIMPLE_SCV_INVENTORY_COLD_INIT=1 SIMPLE_NO_STUB_FALLBACK=1
        export SIMPLE_PROJECT_ROOT="$workspace" SIMPLE_LIB="$workspace/src" SIMPLE_RUNTIME_PATH="$runtime" SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap
        export SIMPLE_NATIVE_BUILD_THREADS=10 SIMPLE_NATIVE_FILE_TIMEOUT=1800 SIMPLE_SHARD_MEM_CLAMP=1
        export SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB=6835937 SIMPLE_BOOTSTRAP_RSS_CAP_MODE=enforce SIMPLE_PROCESS_TREE_OBSERVATION_BUDGET_MS=5000
        export SIMPLE_PROCESS_TREE_RSS_RECEIPT="$evidence/$variant-build.watchdog.env"
        export SIMPLE_USER_STORAGE_ROOT="$lane/user-storage" SIMPLE_WORKTREE_STORAGE_ROOT="$lane/worktree-storage" TMPDIR="$lane/tmp"
        sh "$tools/scripts/bootstrap/run-process-group-timeout.shs" 1800 5 "$compiler" native-build "--backend=$backend" --threads 10 \
            --source src/compiler --source src/app --source src/lib --entry-closure --entry "$entry" \
            --cache-dir "$lane/cache-$backend-$sha-$variant" --output "$lane/latest-$variant"
    ) >"$evidence/$variant-build.log" 2>&1
    perl -MDigest::SHA -MJSON::PP -e '
open my $f,"<:raw",$ARGV[0] or die $!;read($f,my $magic,4)==4 && $magic eq "\x7fELF" or die "not native ELF";seek($f,0,0);
my $h=Digest::SHA->new(256);$h->addfile($f);print JSON::PP->new->canonical->encode({native_format=>"ELF",sha256=>$h->hexdigest}),"\n";
' "$lane/latest-$variant" >"$evidence/$variant-binary.json"
    for mode in enumerate run; do
        status=0
        (cd "$workspace" && timeout 60 "$lane/latest-$variant" "--$mode") >"$evidence/$variant-$mode.stdout.log" 2>"$evidence/$variant-$mode.stderr.log" || status=$?
        printf '%s\n' "$status" >"$evidence/$variant-$mode.exit"
    done
done
perl "$tools/scripts/bootstrap/verify-native-incremental-adapter.pl" "$evidence" "$lane" >"$evidence/result.json.tmp"
mv "$evidence/result.json.tmp" "$evidence/result.json"
printf '%s\n' "RESTRICTED_PREFIX_GATE_PASS: $evidence/result.json"
