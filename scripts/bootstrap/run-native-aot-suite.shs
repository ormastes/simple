#!/bin/sh
# One private, sequential native-AOT suite. The caller owns the directory and
# checks its full-CLI/test-runner receipt before and after this command.
set -eu

[ "$#" -eq 10 ] || { echo 'native-aot-suite: expected ten arguments' >&2; exit 2; }
source_root=$1 backend=$2 compiler=$3 compiler_sha=$4 runner=$5 suite=$6
run_dir=$7 build_threads=$8 runtime_path=$9 runtime_identity=${10}
case "$backend" in llvm|cranelift) ;; *) echo 'native-aot-suite: invalid backend' >&2; exit 2 ;; esac
case "$build_threads" in ''|*[!0-9]*|0) echo 'native-aot-suite: invalid build threads' >&2; exit 2 ;; esac
[ -d "$run_dir" ] && [ ! -L "$run_dir" ] || { echo 'native-aot-suite: private run directory missing' >&2; exit 2; }
[ -x "$compiler" ] && [ ! -L "$compiler" ] && [ -x "$runner" ] && [ ! -L "$runner" ] || exit 2
[ ! -e "$run_dir/runner.log" ] && [ ! -e "$run_dir/evidence.tsv" ] || {
  echo 'native-aot-suite: stale run directory' >&2; exit 2;
}
mkdir "$run_dir/tmp" || exit 2
case "$runtime_path" in -) runtime_path= ;; esac
if [ -n "$runtime_path" ]; then
  [ -d "$runtime_path" ] || { echo 'native-aot-suite: runtime path missing' >&2; exit 2; }
fi

run_status=0
(
  cd "$source_root" || exit 125
  TMPDIR="$run_dir/tmp" SIMPLE_BINARY="$compiler" SIMPLE_BIN="$compiler" \
    SIMPLE_RUNTIME_PATH="$runtime_path" SIMPLE_NATIVE_BUILD_THREADS="$build_threads" \
    SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_NO_BOOTSTRAP_DELEGATE=1 \
    "$runner" "$suite" "--native-backend=$backend" --unstable \
      --assert-ran --no-cache --no-db --no-session-daemon \
      --sequential --keep-artifacts --verbose --json
) >"$run_dir/runner.log" 2>&1 || run_status=$?
cat "$run_dir/runner.log"
[ "$run_status" -eq 0 ] || exit "$run_status"

perl "$source_root/scripts/bootstrap/validate-native-aot-evidence.pl" \
  "$run_dir/runner.log" "$run_dir/tmp" "$source_root" "$suite" \
  "$backend" "$compiler" "$compiler_sha" "$build_threads" \
  "$runtime_path" "$runtime_identity" "$run_dir/evidence.tsv" || exit $?
echo "native_aot_evidence=$run_dir/evidence.tsv"
