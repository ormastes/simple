#!/bin/sh
# Run an admitted phase compiler's compiler/tool matrix without sharing mutable
# HOME, TMP, cache, or output state with the next canonical bootstrap phase.

set -u

. "$(dirname -- "$0")/bootstrap-windows-cl-mode.shs"
. "$(dirname -- "$0")/bootstrap-phase-toolchain.shs"
. "$(dirname -- "$0")/bootstrap-cache-policy.shs"
. "$(dirname -- "$0")/bootstrap-module-collection.shs"
. "$(dirname -- "$0")/bootstrap-scv-prime.shs"
bootstrap_windows_preserve_cl_mode

die() {
  echo "bootstrap-phase-verification: $*" >&2
  exit 2
}

manifest_value() {
  key=$1
  file=$2
  sed -n "s/^${key}=//p" "$file" | head -n 1
}

manifest_key_count() {
  key=$1
  file=$2
  awk -F= -v wanted="$key" '$1 == wanted { count++ } END { print count + 0 }' "$file"
}

# Fail closed, not just fall back: a missing/broken tool or a malformed
# digest must never be mistaken for a valid one. Two independent callers each
# getting an empty/garbage string from a silently-broken hash helper would
# compare equal and produce a false PASS, so this checks the underlying
# tool's own exit status directly (never through an awk pipe, whose exit
# status is the LAST command's, not the hasher's) and validates the result
# is exactly 64 lowercase hex characters before ever printing it. Mirrors
# the existing candidate_frontend_hash_file pattern in
# scripts/check/cert/redeploy_gate/candidate_frontend_admission.shs. Return
# codes: 1 = bad input (missing file), 126 = no usable tool or a tool that
# ran but produced something that is not a real sha256 digest.
hash_file() (
  [ -f "$1" ] || return 1
  if command -v sha256sum >/dev/null 2>&1; then
    hf_out=$(sha256sum -- "$1") || return 126
    hf_digest=${hf_out%% *}
  elif command -v shasum >/dev/null 2>&1; then
    hf_out=$(shasum -a 256 -- "$1") || return 126
    hf_digest=${hf_out%% *}
  elif command -v sha256 >/dev/null 2>&1; then
    hf_digest=$(sha256 -q "$1") || return 126
  elif command -v openssl >/dev/null 2>&1; then
    hf_out=$(openssl dgst -sha256 "$1") || return 126
    hf_digest=${hf_out##* }
  else
    return 126
  fi
  [ "${#hf_digest}" -eq 64 ] || return 126
  case "$hf_digest" in *[!0-9a-f]*) return 126 ;; esac
  printf '%s\n' "$hf_digest"
)

hash_stream() (
  if command -v sha256sum >/dev/null 2>&1; then
    hs_out=$(sha256sum) || return 126
    hs_digest=${hs_out%% *}
  elif command -v shasum >/dev/null 2>&1; then
    hs_out=$(shasum -a 256) || return 126
    hs_digest=${hs_out%% *}
  elif command -v sha256 >/dev/null 2>&1; then
    hs_digest=$(sha256 -q) || return 126
  elif command -v openssl >/dev/null 2>&1; then
    hs_out=$(openssl dgst -sha256) || return 126
    hs_digest=${hs_out##* }
  else
    return 126
  fi
  [ "${#hs_digest}" -eq 64 ] || return 126
  case "$hs_digest" in *[!0-9a-f]*) return 126 ;; esac
  printf '%s\n' "$hs_digest"
)

validate_hosted_runtime_authority() {
  authority=$1
  [ -n "$authority" ] && [ -d "$authority" ] || return 1
  capsule_receipt="$authority/phase2-runtime-capsule.env"
  admission=$(dirname "$compiler")/admission.env
  receipt="$authority/hosted-runtime.env"
  [ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
  [ "$(manifest_value schema "$receipt")" = simple-bootstrap-hosted-runtime-authority-v1 ] || return 1
  [ "$(manifest_value status "$receipt")" = frozen ] || return 1
  relative=$(manifest_value relative_path "$receipt")
  expected=$(manifest_value sha256 "$receipt")
  if [ -f "$capsule_receipt" ] && [ ! -L "$capsule_receipt" ]; then
    "$source_root/scripts/bootstrap/phase2-runtime-capsule.shs" verify "$authority" >/dev/null || return 1
    capsule_schema=$(manifest_value schema "$capsule_receipt")
    case "$capsule_schema" in
      simple-phase2-runtime-capsule-v1)
        [ "$(manifest_key_count artifact_layout "$capsule_receipt")" = 0 ] || return 1
        capsule_layout=posix ;;
      simple-phase2-runtime-capsule-v2)
        [ "$(manifest_key_count artifact_layout "$capsule_receipt")" = 1 ] || return 1
        capsule_layout=$(manifest_value artifact_layout "$capsule_receipt") ;;
      *) return 1 ;;
    esac
    [ "$(manifest_value status "$capsule_receipt")" = frozen ] || return 1
    [ "$(manifest_value compiler_sha256 "$capsule_receipt")" = "$expected_sha" ] || return 1
    case "$capsule_layout" in
      windows-msvc)
        capsule_compiler="$authority/simple.exe"
        native_all="$authority/simple_native_all.lib"
        authority_stamp="$authority/simple.exe.inputs.sha256" ;;
      posix)
        capsule_compiler="$authority/simple"
        native_all="$authority/libsimple_native_all.a"
        authority_stamp="$authority/simple.inputs.sha256" ;;
      *) return 1 ;;
    esac
    [ -f "$capsule_compiler" ] && [ ! -L "$capsule_compiler" ] || return 1
    [ "$(hash_file "$capsule_compiler")" = "$expected_sha" ] || return 1
    [ -f "$native_all" ] && [ ! -L "$native_all" ] || return 1
    [ "$(hash_file "$native_all")" = "$(manifest_value native_all_sha256 "$capsule_receipt")" ] || return 1
    [ -f "$authority_stamp" ] && [ ! -L "$authority_stamp" ] || return 1
    [ "$(hash_file "$authority_stamp")" = "$(manifest_value seed_authority_stamp_sha256 "$capsule_receipt")" ] || return 1
    [ "$(hash_file "$authority/hosted-runtime.env")" = "$(manifest_value hosted_authority_receipt_sha256 "$capsule_receipt")" ] || return 1
    runtime_cache_identity=$(manifest_value capsule_identity_sha256 "$capsule_receipt")
  else
    [ -f "$admission" ] && [ ! -L "$admission" ] || return 1
  # Stage-2 admission v1 does not bind a hosted runtime.  Do not search mutable
  # Cargo targets or accept an arbitrary --runtime-path: remain explicitly
  # UNSUPPORTED until the producer publishes the v2 frozen-capsule fields.
  [ "$(manifest_value schema "$admission")" = simple-bootstrap-stage2-admission-v2 ] || return 1
  [ "$(manifest_value status "$admission")" = admitted ] || return 1
  [ "$(manifest_value candidate_path "$admission")" = "$compiler" ] || return 1
  [ "$(manifest_value candidate_sha256 "$admission")" = "$expected_sha" ] || return 1
  [ "$(manifest_value runtime_authority_path "$admission")" = "$authority" ] || return 1
  [ "$(manifest_value hosted_runtime_relative_path "$admission")" = "$relative" ] || return 1
  [ "$(manifest_value hosted_runtime_sha256 "$admission")" = "$expected" ] || return 1
  fi
  case "$relative" in deps/*) ;; *) return 1 ;; esac
  hosted_leaf=${relative#deps/}
  case "$hosted_leaf" in libspl_hosted_runtime*.rlib) ;; *) return 1 ;; esac
  case "$hosted_leaf" in *[!A-Za-z0-9_.-]*) return 1 ;; esac
  hosted="$authority/$relative"
  [ ! -L "$authority" ] && [ ! -L "$authority/deps" ] || return 1
  [ -f "$hosted" ] && [ ! -L "$hosted" ] || return 1
  [ "$(hash_file "$hosted")" = "$expected" ] || return 1
  [ "$(find "$authority" -maxdepth 2 -type f -name 'libspl_hosted_runtime*.rlib' | wc -l | tr -d ' ')" = 1 ] || return 1
  if [ ! -f "$capsule_receipt" ]; then
  [ "$(stat -c '%a' "$authority" 2>/dev/null || stat -f '%Lp' "$authority")" = 500 ] || return 1
  [ "$(stat -c '%a' "$authority/deps" 2>/dev/null || stat -f '%Lp' "$authority/deps")" = 500 ] || return 1
  [ "$(stat -c '%a' "$hosted" 2>/dev/null || stat -f '%Lp' "$hosted")" = 400 ] || return 1
  [ "$(stat -c '%a' "$receipt" 2>/dev/null || stat -f '%Lp' "$receipt")" = 400 ] || return 1
  fi
  hosted_runtime_sha=$expected
  if [ -z "${runtime_cache_identity:-}" ]; then
    runtime_cache_identity=$hosted_runtime_sha
  fi
  return 0
}

phase=""
stage3_provenance=""
compiler=""
expected_sha=""
strategy=normal
profile=full
hash_policy=canonical
work_root=""
cache_root=""
runtime_path=${SIMPLE_RUNTIME_PATH:-}
runtime_path_explicit=0
source_root=$(pwd -P)
timeout_seconds=${BOOTSTRAP_VERIFY_TIMEOUT_SECONDS:-1800}
spec_timeout_seconds=${BOOTSTRAP_VERIFY_SPEC_TIMEOUT_SECONDS:-120}
native_internal_timeout=${BOOTSTRAP_VERIFY_NATIVE_INTERNAL_TIMEOUT:-600}
build_threads=${BOOTSTRAP_VERIFY_BUILD_THREADS:-4}
module_workers=${BOOTSTRAP_VERIFY_MODULE_WORKERS:-2}
test_workers=${BOOTSTRAP_VERIFY_TEST_WORKERS:-1}

for arg in "$@"; do
  case "$arg" in
    --phase=*) phase=${arg#*=} ;;
    --stage3-provenance=*) stage3_provenance=${arg#*=} ;;
    --compiler=*) compiler=${arg#*=} ;;
    --compiler-sha256=*) expected_sha=${arg#*=} ;;
    --strategy=*) strategy=${arg#*=} ;;
    --fail-fast|--keep-going) ;; # Resolved together below, in argument order.
    # --profile=slim is an explicit opt-in, phase=stage2 only (see
    # stage2_slim_profile below). EVERY behavioral effect of slim mode --
    # skipped MCP/LSP builds and checks, skipped compile-mode test
    # duplicates, and the shared CLI/test-runner build cache -- is gated on
    # stage2_slim_profile, so default "full" is genuinely byte-identical:
    # every existing caller (run-linux-phase2-tests.shs,
    # run-freebsd-phase2-tests.shs, run-macos-phase23-evidence.shs, and this
    # script's own stage1/stage3/stage4 paths) is unaffected unless it opts
    # in. Any new stage2_slim_profile-conditioned code must keep this true.
    --profile=*) profile=${arg#*=} ;;
    --hash-policy=*) hash_policy=${arg#*=} ;;
    --work-root=*) work_root=${arg#*=} ;;
    --cache-root=*) cache_root=${arg#*=} ;;
    --runtime-path=*) runtime_path=${arg#*=}; runtime_path_explicit=1 ;;
    --source-root=*) source_root=${arg#*=} ;;
    --timeout-seconds=*) timeout_seconds=${arg#*=} ;;
    *) die "unknown option: $arg" ;;
  esac
done

bootstrap_compile_failure_policy "$@"

case "$phase" in stage1|stage2|stage3|stage4) ;; *) die "invalid phase" ;; esac
[ -z "$stage3_provenance" ] || [ "$phase" = stage3 ] || die "--stage3-provenance is stage3-only"
if [ "$phase" = stage3 ]; then
  [ -n "$stage3_provenance" ] || die "Stage3 requires admitted provenance"
  [ "$hash_policy" = canonical ] || die "Stage3 requires canonical provenance"
fi
case "$strategy" in normal|full) ;; *) die "verification requires normal or full" ;; esac
case "$profile" in full|slim) ;; *) die "--profile requires full or slim" ;; esac
[ "$profile" != slim ] || [ "$phase" = stage2 ] || die "--profile=slim is stage2-only"
[ "$profile" != slim ] || [ "$strategy" != full ] || die "--profile=slim and --strategy=full are mutually exclusive"
case "$hash_policy" in canonical|temporary) ;; *) die "invalid hash policy" ;; esac
case "$timeout_seconds" in ''|*[!0-9]*|0) die "timeout must be a positive integer" ;; esac
case "$spec_timeout_seconds" in ''|*[!0-9]*|0) die "spec timeout must be a positive integer" ;; esac
case "$native_internal_timeout" in ''|*[!0-9]*) die "native internal timeout must be an integer" ;; esac
[ "$native_internal_timeout" -gt 60 ] || die "native internal timeout must exceed 60 seconds"
case "$build_threads" in ''|*[!0-9]*|0) die "build threads must be a positive integer" ;; esac
verification_worker_limit=12
# Stage2 qualification can use an explicitly requested large Windows pool.
# Keep later-phase limits unchanged until their separate memory admission.
[ "$phase" != stage2 ] || verification_worker_limit=80
case "$module_workers" in ''|*[!0-9]*|0) die "module workers must be a positive integer" ;; esac
[ "$module_workers" -gt 0 ] && [ "$module_workers" -le "$verification_worker_limit" ] || die "module workers must be from 1 to $verification_worker_limit"
[ "$phase" != stage3 ] || [ "$build_threads" -le 12 ] || die "Stage3 build threads must be from 1 to 12"
case "$test_workers" in ''|*[!0-9]*|0) die "test workers must be a positive integer" ;; esac
[ "$test_workers" -gt 0 ] && [ "$test_workers" -le "$verification_worker_limit" ] || die "test workers must be from 1 to $verification_worker_limit"
test_mode_flag=--sequential
test_worker_flag=
if [ "$test_workers" -gt 1 ]; then
  test_mode_flag=--parallel
  test_worker_flag="--max-workers=$test_workers"
fi
[ -n "$compiler" ] && [ -x "$compiler" ] || die "compiler is not executable: $compiler"
[ -n "$expected_sha" ] || die "compiler SHA-256 is required"
[ -n "$work_root" ] || die "work root is required"
[ -d "$source_root" ] || die "source root is not a directory"

# Stage-2 slim profile (perf/memory audit of PR #1458, 2026-09-24): the
# owner's actual ask for the stage-2 gate is "as soon as phase 2 can make
# compiler test binary and it works and run some tests" -- not four full-CLI
# builds, three source `check` runs, and six test suites run in both modes.
# Opt in explicitly with `--profile=slim` (stage2-only, rejected together
# with --strategy=full above): skip the MCP/LSP builds, their source checks,
# their behavior integration tests, and the *_compile duplicate of each
# remaining test task. A task skipped this way emits NO row at all:
# `record_unsupported_task` would count as UNSUPPORTED and flip `overall` to
# FAIL below (see the `failures=$(grep -cE
# 'result=(FAIL|CRASH|TIMEOUT|BLOCKED|UNSUPPORTED|SKIPPED)' ...)` accounting near the
# end of this script), so silent omission -- not an unsupported row -- is the
# only correct way to skip a task here. Default `--profile=full` keeps every
# existing caller (run-linux-phase2-tests.shs, run-freebsd-phase2-tests.shs,
# run-macos-phase23-evidence.shs, and this script's own stage1/stage3/stage4
# paths) byte-identical in behavior; only bootstrap-from-scratch.sh's own
# stage-2 step passes --profile=slim, and only for the normal strategy.
stage2_slim_profile=0
if [ "$phase" = stage2 ] && [ "$profile" = slim ]; then
  stage2_slim_profile=1
fi

mkdir -p "$work_root" || die "cannot create work root"
work_root=$(cd "$work_root" && pwd -P)
source_root=$(cd "$source_root" && pwd -P)
if [ -z "$cache_root" ]; then
  cache_root="$work_root/cache"
fi
mkdir -p "$cache_root" || die "cannot create cache root"
cache_root=$(cd "$cache_root" && pwd -P)
home="$work_root/home"
tmp="$work_root/tmp"
cache="$cache_root"
outputs="$work_root/outputs"
logs="$work_root/logs"
summary="$work_root/summary.env"
mkdir -p "$home" "$tmp" "$cache" "$outputs" "$logs" || die "cannot isolate verification state"
server_outputs="$outputs"
mcp_build_ready=0
lsp_build_ready=0
stage4_tooling_receipt=""
stage4_tooling_receipt_sha=""

# Copy only an already-admitted compiler. The before/copy/after hashes make a
# concurrent publish or accidental mutation a terminal admission failure.
if [ "$phase" = stage1 ]; then
  [ "$hash_policy" = canonical ] || die "Phase1 requires canonical current-generation authority"
  phase1_tool_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
  . "$phase1_tool_root/scripts/bootstrap/bootstrap-phase1-authority.shs"
  bootstrap_phase1_authority_init "$phase1_tool_root" "$source_root" \
    "$compiler" "$expected_sha" "$work_root" || die "Phase1 compiler is not the current admitted artifact"
fi
source_before=$(hash_file "$compiler") || die "cannot hash compiler"
# A previous run seals the snapshot read-only; replace it instead of failing on cp.
if [ -e "$work_root/compiler.snapshot" ]; then
  chmod u+w "$work_root/compiler.snapshot" 2>/dev/null || :
  rm -f "$work_root/compiler.snapshot" || die "cannot remove stale compiler snapshot"
fi
cp "$compiler" "$work_root/compiler.snapshot" || die "cannot snapshot compiler"
chmod +x "$work_root/compiler.snapshot"
source_after=$(hash_file "$compiler") || die "cannot re-hash compiler"
snapshot_sha=$(hash_file "$work_root/compiler.snapshot") || die "cannot hash compiler snapshot"
hash_status=PASS
if [ "$source_before" != "$source_after" ] || [ "$snapshot_sha" != "$expected_sha" ]; then
  if [ "$hash_policy" = canonical ]; then
    die "canonical compiler hash mismatch"
  fi
  hash_status=WARN
fi
compiler_snapshot="$work_root/compiler.snapshot"
if [ "$phase" = stage3 ]; then
  [ -f "$stage3_provenance" ] && [ ! -L "$stage3_provenance" ] || die "invalid Stage3 provenance file"
  stage3_provenance=$(cd "$(dirname "$stage3_provenance")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$stage3_provenance")") || die "cannot resolve Stage3 provenance"
  compiler=$(cd "$(dirname "$compiler")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$compiler")") || die "cannot resolve Stage3 compiler"
  BOOTSTRAP_STAGE3_FACADE_PATH="$source_root/scripts/check/lib/bootstrap-stage3-provenance.shs"
  . "$BOOTSTRAP_STAGE3_FACADE_PATH" || die "cannot load Stage3 provenance authority"
  stage3_manifest_sha=$(hash_file "$stage3_provenance") || die "cannot hash Stage3 provenance"
  TMPDIR="$tmp" bootstrap_stage3_verify_manifest "$stage3_provenance" "$stage3_provenance" \
    "$source_root" "$compiler" "$compiler" "$stage3_provenance.authority-map.env" || die "Stage3 provenance is not current"
  [ "$(hash_file "$stage3_provenance")" = "$stage3_manifest_sha" ] || die "Stage3 provenance changed during verification"
  [ "$(manifest_value stage3_sha256 "$stage3_provenance")" = "$snapshot_sha" ] &&
    [ "$(manifest_value output_sha256 "$stage3_provenance")" = "$snapshot_sha" ] || die "Stage3 producer differs from compiler snapshot"
  stage3_source_sha=$(manifest_value source_fingerprint "$stage3_provenance")
  stage3_runtime_snapshot=$(manifest_value runtime_admitted_snapshot_path "$stage3_provenance")
  stage3_runtime_sha=$(manifest_value runtime_admitted_snapshot_sha256 "$stage3_provenance")
  stage3_backend=$(manifest_value backend "$stage3_provenance")
  stage3_platform=$(manifest_value platform "$stage3_provenance")
  bound_runtime=$(manifest_value runtime_path "$stage3_provenance")
  [ "$(hash_file "$stage3_provenance")" = "$stage3_manifest_sha" ] || die "Stage3 provenance changed during field extraction"
  [ -d "$bound_runtime" ] || die "Stage3 runtime is not a directory"
  bound_runtime=$(cd "$bound_runtime" && pwd -P) || die "cannot resolve Stage3 runtime"
  if [ "$runtime_path_explicit" = 1 ]; then
    [ -d "$runtime_path" ] && [ "$(cd "$runtime_path" && pwd -P)" = "$bound_runtime" ] || die "Stage3 runtime differs from provenance"
  fi
  runtime_path=$bound_runtime
  runtime_cache_identity=$(printf '%s\n' stage3 "$snapshot_sha" "$stage3_manifest_sha" "$stage3_runtime_sha" "$stage3_source_sha" | hash_stream) || die "cannot bind Stage3 runtime identity"
fi
if [ "$phase" = stage1 ]; then
  bootstrap_phase1_register_tool "$compiler_snapshot" "$snapshot_sha" || die "cannot bind Phase1 compiler snapshot"
fi

if [ "$phase" = stage2 ]; then
  bound_runtime=$(sh "$source_root/scripts/bootstrap/phase2-runtime-binding.shs" resolve \
    "$compiler" "$source_root" "$work_root") || die "Phase2 runtime binding is invalid"
  if [ "$runtime_path_explicit" = 1 ]; then
    [ -d "$runtime_path" ] && [ "$(cd "$runtime_path" && pwd -P)" = "$bound_runtime" ] ||
      die "Phase2 runtime path differs from the admitted capsule"
  fi
  runtime_path=$bound_runtime
  # Phase2 keeps its own admission; only reuse the canonical snapshot helpers.
  . "$source_root/scripts/check/lib/bootstrap-stage3/authority.shs"
  . "$source_root/scripts/check/lib/bootstrap-stage3/command-snapshot.shs"
fi
if [ -z "$runtime_path" ]; then
  compiler_dir=$(dirname "$compiler")
  if [ -f "$compiler_dir/phase2-runtime-capsule.env" ]; then
    candidate_runtime=$compiler_dir
  else
    candidate_runtime=$(dirname "$compiler_dir")/stage2-runtime-authority
  fi
  if [ -d "$candidate_runtime" ]; then
    runtime_path=$candidate_runtime
  fi
fi
if [ -n "$runtime_path" ]; then
  [ -d "$runtime_path" ] || die "runtime path is not a directory: $runtime_path"
  runtime_path=$(cd "$runtime_path" && pwd -P)
fi

if [ "$phase" = stage2 ]; then
  [ -n "$runtime_path" ] && [ -f "$runtime_path/phase2-runtime-capsule.env" ] ||
    die "Phase2 verification requires a SHA-qualified runtime capsule"
fi

# INTERIM (owner-approved 2026-09-26): Stage-2 spec rows delegate `run` to the
# frozen authority seed. The stage-2 CLI cannot execute std.spec specs
# in-process yet, and its native spec path (`compile <spec> -o x.smf`) does not
# complete. The rows therefore produce SEED verdicts, and every such run is
# labelled test_execution=delegated-seed with the seed path and sha256.
# Scope:
#   - only the compiler_bootstrap / interpreter / loader interpreter suites
#     and the per-spec inventory rows;
#   - every other row keeps SIMPLE_NO_BOOTSTRAP_DELEGATE=1.
# BOOTSTRAP_STAGE2_TEST_DELEGATE=0 restores in-process execution for those
# rows. A missing seed, a missing LLVM-C.dll or a seed that does not start is
# fatal: never a silent fall-through to the in-process interpreter.
stage2_test_delegate=0
stage2_test_seed=""
stage2_test_seed_sha=""
stage2_test_llvm_bin=""
if [ "$phase" = stage2 ]; then
  case "${BOOTSTRAP_STAGE2_TEST_DELEGATE:-1}" in
    1) stage2_test_delegate=1 ;;
    0) ;;
    *) die "BOOTSTRAP_STAGE2_TEST_DELEGATE must be 0 or 1" ;;
  esac
fi
if [ "$stage2_test_delegate" -eq 1 ]; then
  # The capsule's own simple(.exe) is the stage-2 CANDIDATE, not the seed.
  # The seed is the frozen authority the capsule was built from
  # (source_authority_path), admitted by the seed stamp the capsule
  # hash-binds (seed_authority_stamp_sha256): its seed_sha256 must match.
  stage2_capsule_receipt="$runtime_path/phase2-runtime-capsule.env"
  stage2_authority=$(manifest_value source_authority_path "$stage2_capsule_receipt")
  [ -n "$stage2_authority" ] && [ -d "$stage2_authority" ] ||
    die "stage-2 test delegation: capsule names no frozen seed authority: $stage2_capsule_receipt"
  if [ -f "$runtime_path/simple.exe.inputs.sha256" ]; then
    stage2_test_seed="$stage2_authority/simple.exe"
    stage2_seed_stamp="$runtime_path/simple.exe.inputs.sha256"
  else
    stage2_test_seed="$stage2_authority/simple"
    stage2_seed_stamp="$runtime_path/simple.inputs.sha256"
  fi
  [ -f "$stage2_test_seed" ] && [ -x "$stage2_test_seed" ] && [ -f "$stage2_seed_stamp" ] ||
    die "stage-2 test delegation: frozen authority seed missing: $stage2_test_seed"
  [ "$(hash_file "$stage2_seed_stamp")" = "$(manifest_value seed_authority_stamp_sha256 "$stage2_capsule_receipt")" ] ||
    die "stage-2 test delegation: seed stamp is not the one the capsule admitted: $stage2_seed_stamp"
  stage2_test_seed_sha=$(hash_file "$stage2_test_seed") ||
    die "stage-2 test delegation: cannot hash seed $stage2_test_seed"
  [ "$stage2_test_seed_sha" = "$(manifest_value seed_sha256 "$stage2_seed_stamp")" ] ||
    die "stage-2 test delegation: seed sha256 differs from the admitted stamp: $stage2_test_seed"
  case "$stage2_test_seed" in
    *.exe)
      # The seed imports LLVM-C.dll; without it on PATH every delegated run
      # exits 127 (STATUS_DLL_NOT_FOUND) before printing anything.
      for stage2_llvm_candidate in \
          "$(dirname "${SIMPLE_LLVM_PATH:-/nonexistent/x}")" \
          "${LLVM_SYS_231_PREFIX:-/nonexistent}/bin" \
          "$(dirname "$(command -v clang-cl 2>/dev/null || echo /nonexistent/x)")"; do
        if [ -f "$stage2_llvm_candidate/LLVM-C.dll" ]; then
          stage2_test_llvm_bin=$stage2_llvm_candidate
          break
        fi
      done
      [ -n "$stage2_test_llvm_bin" ] ||
        die "stage-2 test delegation: LLVM-C.dll not found (set SIMPLE_LLVM_PATH or LLVM_SYS_231_PREFIX)"
      ;;
  esac
  if [ -n "$stage2_test_llvm_bin" ]; then
    stage2_seed_probe_path="$stage2_test_llvm_bin:$PATH"
  else
    stage2_seed_probe_path=$PATH
  fi
  PATH=$stage2_seed_probe_path "$stage2_test_seed" --version >/dev/null 2>&1 ||
    die "stage-2 test delegation: seed does not start: $stage2_test_seed"
  # The runner's MC/DC route compiles the wrapped spec with the stage-2 CLI and
  # then `run`s that SMF; the seed only interprets .spl, so a delegated row can
  # never execute it. Delegated rows therefore run MC/DC off, which the runner
  # admits only under a recorded waiver. The waiver atoms come from the caller
  # (the owner's approval record) and are never defaulted here.
  for stage2_waiver_var in SIMPLE_MCDC_OFF_WAIVER_REASON SIMPLE_MCDC_OFF_WAIVER_REVIEWER \
      SIMPLE_MCDC_OFF_WAIVER_REVIEW_ID SIMPLE_MCDC_OFF_WAIVER_VERSION; do
    eval "stage2_waiver_value=\${$stage2_waiver_var:-}"
    case "$stage2_waiver_value" in
      ''|*'|'*) die "stage-2 test delegation: delegated rows run MC/DC off and need $stage2_waiver_var (non-empty, no '|'); or set BOOTSTRAP_STAGE2_TEST_DELEGATE=0" ;;
    esac
  done
  printf 'bootstrap-phase-verification: stage-2 spec rows use test_execution=delegated-seed seed=%s sha256=%s (BOOTSTRAP_STAGE2_TEST_DELEGATE=0 disables)\n' \
    "$stage2_test_seed" "$stage2_test_seed_sha"
fi

# Environment for one test row: sets row_no_delegate and, when the row is a
# delegated stage-2 spec row, exports the seed driver and LLVM PATH. Call only
# inside the row's subshell.
stage2_row_delegation_env() {
  row_no_delegate=1
  [ "$stage2_test_delegate" -eq 1 ] || return 0
  case "$1" in
    compiler_bootstrap_tests|interpreter_interpreter_tests|loader_interpreter_tests|inventory-row) ;;
    *) return 0 ;;
  esac
  row_no_delegate=0
  SIMPLE_BOOTSTRAP_DRIVER=$stage2_test_seed
  SIMPLE_MCDC_MODE=off
  export SIMPLE_BOOTSTRAP_DRIVER SIMPLE_MCDC_MODE SIMPLE_MCDC_OFF_WAIVER_REASON \
    SIMPLE_MCDC_OFF_WAIVER_REVIEWER SIMPLE_MCDC_OFF_WAIVER_REVIEW_ID SIMPLE_MCDC_OFF_WAIVER_VERSION
  if [ -n "$stage2_test_llvm_bin" ]; then
    PATH="$stage2_test_llvm_bin:$PATH"
    export PATH
  fi
}

: >"$summary" || die "cannot initialize verification summary"
{
  echo "schema=bootstrap-phase-verification-v1"
  echo "phase=$phase"
  echo "strategy=$strategy"
  echo "hash_policy=$hash_policy"
  echo "expected_compiler_sha256=$expected_sha"
  echo "actual_compiler_sha256=$snapshot_sha"
  echo "compiler_hash_status=$hash_status"
  echo "runtime_path=${runtime_path:--}"
  if [ "$phase" = stage3 ]; then
    echo "stage3_provenance_sha256=$stage3_manifest_sha"
    echo "stage3_source_fingerprint=$stage3_source_sha"
    echo "stage3_runtime_snapshot_sha256=$stage3_runtime_sha"
  fi
  echo "native_internal_timeout_seconds=$native_internal_timeout"
  echo "timing_scope=post-admission-excludes-git-lfs-checkout"
  if [ "$stage2_test_delegate" -eq 1 ]; then
    echo "test_execution=delegated-seed"
    echo "test_execution_seed=$stage2_test_seed"
    echo "test_execution_seed_sha256=$stage2_test_seed_sha"
    echo "test_execution_mcdc=off-waived"
    echo "test_execution_mcdc_waiver_review_id=$SIMPLE_MCDC_OFF_WAIVER_REVIEW_ID"
    echo "test_execution_mcdc_waiver_reviewer=$SIMPLE_MCDC_OFF_WAIVER_REVIEWER"
  elif [ "$phase" = stage2 ]; then
    echo "test_execution=in-process"
  fi
  if [ "$phase" = stage1 ]; then
    echo "phase1_generation=$p1a_generation"
    echo "phase1_admission_path=$p1a_marker"
    echo "phase1_admission_sha256=$p1a_marker_sha"
    echo "phase1_admitted_compiler_path=$p1a_seed"
  fi
} >>"$summary" || die "cannot initialize verification summary headers"

rss_time=""
rss_time_style=none
rss_sample_interval_ms=not-applicable
rss_sampling_overhead_scope=unavailable
rss_probe="$tmp/phase-verification-rss-probe"
if [ -x /usr/bin/time ] &&
   /usr/bin/time -f '%M' -o "$rss_probe" true >/dev/null 2>&1 &&
   grep -Eq '^[1-9][0-9]*$' "$rss_probe"; then
  rss_time=/usr/bin/time
  rss_time_style=gnu
elif [ -x /usr/bin/time ] &&
     LC_ALL=C /usr/bin/time -l -o "$rss_probe" true >/dev/null 2>&1 &&
     grep -Eq '^[[:space:]]*[1-9][0-9]*[[:space:]]+maximum resident set size[[:space:]]*$' "$rss_probe"; then
  rss_time=/usr/bin/time
  case "$(uname -s)" in
    Darwin) rss_time_style=darwin ;;
    FreeBSD) rss_time_style=bsd-kib ;;
  esac
fi
rm -f "$rss_probe"
case "$rss_time_style" in
  gnu) rss_measurement=gnu-time-rusage-kib ;;
  darwin) rss_measurement=darwin-time-rusage-bytes-normalized-kib ;;
  bsd-kib) rss_measurement=bsd-time-rusage-kib ;;
  *)
    rss_measurement=unavailable
    case "$(uname -s)" in
      MINGW*|MSYS*|CYGWIN*)
        if [ -r /proc/self/stat ]; then
          rss_measurement=proc-group-rss-kib
        fi
        ;;
    esac
    ;;
esac
case "$rss_measurement" in
  gnu-time-rusage-kib|darwin-time-rusage-bytes-normalized-kib|bsd-time-rusage-kib)
    rss_sampling_overhead_scope=kernel-rusage ;;
  proc-group-rss-kib)
    rss_sample_interval_ms=50
    rss_sampling_overhead_scope=external-ps-awk-excluded-from-rss-included-in-wall-time ;;
esac
echo "max_rss_measurement=$rss_measurement" >>"$summary"
echo "max_rss_sample_interval_ms=$rss_sample_interval_ms" >>"$summary"
echo "max_rss_sampling_overhead_scope=$rss_sampling_overhead_scope" >>"$summary"

proc_tree_rss_kib() {
  ps -l | awk -v root="$1" -v proc_root="${2:-/proc}" \
    -f "$source_root/scripts/bootstrap/windows-process-group-rss.awk"
}

run_measured_timeout() {
  metric_file=$1
  measured_timeout=$2
  measured_grace=$3
  shift 3
  case "$rss_time_style" in
    gnu)
      "$rss_time" -f '%M' -o "$metric_file" \
        "$source_root/scripts/bootstrap/run-process-group-timeout.shs" \
        "$measured_timeout" "$measured_grace" "$@" ;;
    darwin|bsd-kib)
      LC_ALL=C "$rss_time" -l -o "$metric_file" \
        "$source_root/scripts/bootstrap/run-process-group-timeout.shs" \
        "$measured_timeout" "$measured_grace" "$@" ;;
    *)
      if [ "$rss_measurement" = proc-group-rss-kib ]; then
        # Preserve the caller stream before the asynchronous shell substitutes
        # /dev/null for stdin in its child.
        exec 4<&0
        "$source_root/scripts/bootstrap/run-process-group-timeout.shs" \
          "$measured_timeout" "$measured_grace" "$@" <&4 &
        measured_pid=$!
        exec 4<&-
        peak_rss_kib=0
        while kill -0 "$measured_pid" 2>/dev/null; do
          measured_state=$(awk '{ line = $0; sub(/^.*\) /, "", line); split(line, field, " "); print field[1] }' \
            "/proc/$measured_pid/stat" 2>/dev/null || printf 'gone\n')
          [ "$measured_state" != Z ] && [ "$measured_state" != gone ] || break
          sample_rss_kib=$(proc_tree_rss_kib "$measured_pid" || printf '0\n')
          case "$sample_rss_kib" in
            [1-9][0-9]*)
              [ "$sample_rss_kib" -le "$peak_rss_kib" ] || peak_rss_kib=$sample_rss_kib
              ;;
          esac
          sleep 0.05
        done
        if wait "$measured_pid"; then measured_status=0; else measured_status=$?; fi
        if [ "$peak_rss_kib" -gt 0 ]; then
          printf '%s\n' "$peak_rss_kib" >"$metric_file"
        else
          printf 'unavailable\n' >"$metric_file"
        fi
        return "$measured_status"
      else
        printf 'unavailable\n' >"$metric_file"
        "$source_root/scripts/bootstrap/run-process-group-timeout.shs" \
          "$measured_timeout" "$measured_grace" "$@"
      fi
      ;;
  esac
}

read_max_rss_kib() {
  metric_file=$1
  [ -f "$metric_file" ] || {
    printf 'unavailable\n'
    return 0
  }
  case "$rss_time_style" in
    darwin)
      metric=$(awk '/^[[:space:]]*[0-9]+[[:space:]]+maximum resident set size[[:space:]]*$/ {
        printf "%.0f\n", int(($1 + 1023) / 1024)
      }' "$metric_file" | tail -n 1) ;;
    bsd-kib)
      metric=$(awk '/^[[:space:]]*[0-9]+[[:space:]]+maximum resident set size[[:space:]]*$/ {
        print $1
      }' "$metric_file" | tail -n 1) ;;
    *) metric=$(tail -n 1 "$metric_file" 2>/dev/null || :) ;;
  esac
  case "$metric" in
    [1-9][0-9]*) printf '%s\n' "$metric" ;;
    *) printf 'unavailable\n' ;;
  esac
}

run_with_timeout() {
  run_measured_timeout "$active_rss_file" "$timeout_seconds" 15 "$@"
}

validate_test_runner_json_log() {
  validated_log=$1
  validated_status=0
  validated_counts=$(perl "$source_root/scripts/bootstrap/validate-test-runner-json.pl" \
    "$validated_log") || validated_status=$?
  validated_passed=0
  validated_failed=0
  validated_skipped=0
  if [ -n "$validated_counts" ]; then
    validated_tab=$(printf '\t')
    validated_old_ifs=$IFS
    IFS=$validated_tab
    set -- $validated_counts
    IFS=$validated_old_ifs
    if [ "$#" -eq 3 ]; then
      validated_passed=$1
      validated_failed=$2
      validated_skipped=$3
    else
      validated_status=91
    fi
  elif [ "$validated_status" -eq 0 ]; then
    validated_status=91
  fi
  validated_executed=$((validated_passed + validated_failed))
  [ "$validated_status" -eq 0 ]
}

run_task() {
  task=$1
  shift
  expected_executable=""
  task_command_owner_receipt=""
  task_stage4_tooling_receipt=""
  require_test_json=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --verification-expect-executable=*)
        expected_executable=${1#*=}
        shift
        ;;
      --verification-command-owner-receipt=*)
        task_command_owner_receipt=${1#*=}
        shift
        ;;
      --verification-stage4-tooling-receipt=*)
        task_stage4_tooling_receipt=${1#*=}
        shift
        ;;
      --verification-require-test-json)
        require_test_json=1
        shift
        ;;
      *) break ;;
    esac
  done
  log="$logs/$task.log"
  active_rss_file="$logs/$task.max-rss-kib"
  rm -f "$active_rss_file"
  started=$(date +%s)
  status=0
  command_owner_before=not-applicable
  command_owner_after=not-applicable
  stage4_tooling_before=not-applicable
  stage4_tooling_after=not-applicable
  stage4_snapshot_before=not-applicable
  stage4_snapshot_after=not-applicable
  test_executed=not-applicable
  executed=not-applicable
  test_passed=not-applicable
  test_failed=not-applicable
  test_skipped=not-applicable
  if [ "$require_test_json" -eq 1 ]; then
    executed=0
    test_passed=0
    test_failed=0
    test_skipped=0
  fi
  if [ -n "$task_command_owner_receipt" ]; then
    if ! validate_command_owner_receipt "$task_command_owner_receipt"; then
      printf 'bootstrap-phase-verification: command-owner receipt is not current before invocation: %s\n' \
        "$task_command_owner_receipt" >"$log"
      status=90
      command_owner_before=mismatch
    else
      command_owner_before=PASS
    fi
  fi
  if [ "$status" -eq 0 ] && [ -n "$task_stage4_tooling_receipt" ]; then
    if ! validate_stage4_tooling_receipt "$task_stage4_tooling_receipt"; then
      printf 'bootstrap-phase-verification: Stage4 tooling receipt is not current before invocation: %s\n' \
        "$task_stage4_tooling_receipt" >"$log"
      status=90
      stage4_tooling_before=mismatch
    else
      stage4_tooling_before=PASS
    fi
  fi
  if [ "$status" -eq 0 ] && [ "$phase" = stage4 ] && [ "${1:-}" = "$compiler_snapshot" ]; then
    if validate_stage4_compiler_snapshot; then
      stage4_snapshot_before=PASS
    else
      printf 'bootstrap-phase-verification: Stage4 compiler snapshot changed before producer invocation\n' >"$log"
      status=90
      stage4_snapshot_before=mismatch
    fi
  fi
  if [ "$status" -eq 0 ] && [ -n "$expected_executable" ] && ! rm -f "$expected_executable"; then
    printf 'bootstrap-phase-verification: cannot remove prior expected artifact: %s\n' \
      "$expected_executable" >"$log"
    status=88
  elif [ "$status" -eq 0 ]; then
    (
      cd "$source_root" || exit 125
      # SIMPLE_NO_BOOTSTRAP_DELEGATE=1: a full-CLI `run` must execute in the
      # phase binary itself, never hand the spec to a cwd bin/simple seed --
      # otherwise a spec verdict proves the deployed seed, not this phase.
      # Exception: the interim stage-2 seed delegation (stage2_row_delegation_env).
      stage2_row_delegation_env "$task"
      HOME="$home" TMPDIR="$tmp" SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_NO_BOOTSTRAP_DELEGATE=$row_no_delegate
      SIMPLE_NATIVE_BUILD_CACHE_DIR="$cache/$task"
      export HOME TMPDIR SIMPLE_NO_STUB_FALLBACK SIMPLE_NO_BOOTSTRAP_DELEGATE SIMPLE_NATIVE_BUILD_CACHE_DIR
      # Bootstrap-only dispatch controls belong only to the Stage 1 native
      # producer below.  Do not let an operator's ambient shell silently
      # redirect version checks or later phase verification.
      # SCV cold init is a one-time prime (bootstrap_scv_prime below), never
      # an ambient setting: inherited, it re-lists the whole tree per child.
      unset SIMPLE_BOOTSTRAP SIMPLE_NATIVE_BUILD_RUST SIMPLE_BINARY SIMPLE_SCV_INVENTORY_COLD_INIT
      if [ "$phase" = stage1 ]; then
        bootstrap_phase1_validate_invocation "${1:-}" "$task" "$log.phase1-before.env" || exit 89
      fi
      if { [ "$phase" = stage2 ] || [ "$phase" = stage3 ]; } && \
         [ "${1:-}" = "$compiler_snapshot" ] && \
         [ "${2:-}" = native-build ]; then
        case "$task" in compiler_cli_build|test_runner_build|mcp_build|lsp_build|module_compile_*) ;; *) exit 89 ;; esac
        # Keep the actual compiler at argv[0] so the existing pinned-toolchain
        # boundary still recognizes and validates this native-build invocation.
        SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap SIMPLE_RUNTIME_PATH="$runtime_path"
        SIMPLE_NATIVE_BUILD_THREADS="$pure_tool_threads" SIMPLE_NATIVE_BUILD_CACHE_DIR="$pure_tool_cache"
        SIMPLE_RT_OBJ_CACHE_DIR="$pure_tool_cache/runtime-objects"
        # The admitted Stage2 producer cache is sealed read-only. Its inherited
        # frontend/HIR paths cannot store entries for this verifier build.
        SIMPLE_FRONTEND_CACHE_DIR="$pure_tool_cache/frontend"
        SIMPLE_HIR_CACHE_DIR="$pure_tool_cache/hir"
        SIMPLE_NATIVE_BUILD_TARGET="$target_c_platform" SIMPLE_BINARY="$compiler_snapshot"
        SIMPLE_PROJECT_ROOT="$source_root" SIMPLE_ABI_POLICY=v1
        SIMPLE_RUNTIME_RISCV64_VECTOR=0
        unset SIMPLE_BOOTSTRAP_STAGE3_REQUESTED_ROUTE SIMPLE_NATIVE_BUILD_WORKER
        SIMPLE_BOOTSTRAP_STAGE3=0 SIMPLE_BOOTSTRAP_STAGE4=0
        export SIMPLE_NATIVE_RUNTIME_BUNDLE SIMPLE_RUNTIME_PATH SIMPLE_NATIVE_BUILD_THREADS \
           SIMPLE_NATIVE_BUILD_CACHE_DIR SIMPLE_FRONTEND_CACHE_DIR SIMPLE_HIR_CACHE_DIR \
           SIMPLE_NATIVE_BUILD_TARGET SIMPLE_BINARY \
           SIMPLE_BOOTSTRAP_STAGE3 SIMPLE_BOOTSTRAP_STAGE4 SIMPLE_RT_OBJ_CACHE_DIR \
           SIMPLE_PROJECT_ROOT SIMPLE_ABI_POLICY SIMPLE_RUNTIME_RISCV64_VECTOR
        bootstrap_phase_run_command run_with_timeout "$@"
      elif [ "$phase" = stage1 ] && [ "${1:-}" = "$compiler_snapshot" ] && \
         [ "${2:-}" = native-build ]; then
        # A Phase-1 seed normally dispatches native-build to the deployed
        # pure-Simple CLI.  That ambient CLI can predate the admitted seed and
        # current source (observed as `auto:` being rejected in a valid named
        # argument).  Phase verification must exercise the exact snapshotted
        # seed's bootstrap-only Rust builder and must never consult bin/simple.
        SIMPLE_BOOTSTRAP=1 SIMPLE_NATIVE_BUILD_RUST=1
        SIMPLE_BINARY="$compiler_snapshot"
        export SIMPLE_BOOTSTRAP SIMPLE_NATIVE_BUILD_RUST SIMPLE_BINARY
        bootstrap_phase_run_command run_with_timeout "$@"
      else
        bootstrap_phase_run_command run_with_timeout "$@"
      fi
    ) >"$log" 2>&1 || status=$?
    if [ "$phase" = stage1 ] && [ "$status" -eq 0 ]; then
      bootstrap_phase1_validate_invocation "${1:-}" "$task" "$log.phase1-after.env" >>"$log" 2>&1 || status=89
    fi
  fi
  if [ "$status" -eq 0 ] && [ "$require_test_json" -eq 1 ]; then
    test_json_status=0
    test_counts=$(perl "$source_root/scripts/bootstrap/validate-test-runner-json.pl" \
      "$log" 2>>"$log") || test_json_status=$?
    if [ -n "$test_counts" ]; then
      test_tab=$(printf '\t')
      test_old_ifs=$IFS
      IFS=$test_tab
      set -- $test_counts
      IFS=$test_old_ifs
      [ "$#" -eq 3 ] || test_json_status=91
    fi
    if [ "$#" -eq 3 ] && [ -n "$test_counts" ]; then
      test_passed=$1
      test_failed=$2
      test_skipped=$3
      executed=$((test_passed + test_failed))
    fi
    status=$test_json_status
  fi
  if [ -n "$task_command_owner_receipt" ] && [ "$command_owner_before" = PASS ]; then
    if validate_command_owner_receipt "$task_command_owner_receipt"; then
      command_owner_after=PASS
    else
      printf 'bootstrap-phase-verification: command-owner receipt changed during invocation: %s\n' \
        "$task_command_owner_receipt" >>"$log"
      status=90
      command_owner_after=mismatch
    fi
  fi
  if [ -n "$task_stage4_tooling_receipt" ] && [ "$stage4_tooling_before" = PASS ]; then
    if validate_stage4_tooling_receipt "$task_stage4_tooling_receipt"; then
      stage4_tooling_after=PASS
    else
      printf 'bootstrap-phase-verification: Stage4 tooling receipt changed during invocation: %s\n' \
        "$task_stage4_tooling_receipt" >>"$log"
      status=90
      stage4_tooling_after=mismatch
    fi
  fi
  if [ "$stage4_snapshot_before" = PASS ]; then
    if validate_stage4_compiler_snapshot; then
      stage4_snapshot_after=PASS
    else
      printf 'bootstrap-phase-verification: Stage4 compiler snapshot changed during producer invocation\n' >>"$log"
      status=90
      stage4_snapshot_after=mismatch
    fi
  fi
  case "$task" in
    compiler_bootstrap_tests|compiler_bootstrap_compile_tests)
      test_executed=0
      test_passed=0
      test_failed=0
      test_skipped=0
      if [ "$status" -eq 0 ]; then
        validate_test_runner_json_log "$log" 2>>"$log" || status=$validated_status
        test_executed=$validated_executed
        test_passed=$validated_passed
        test_failed=$validated_failed
        test_skipped=$validated_skipped
        if [ "$test_skipped" -gt 0 ] && [ "$status" -eq 0 ]; then
          printf 'bootstrap-phase-verification: aggregate bootstrap row reported skipped examples; per-file category proof is unavailable\n' >>"$log"
          status=94
        fi
      fi
      ;;
  esac
  # The two bootstrap tasks above compute a stricter test_executed (via
  # validate_test_runner_json_log, enforcing the zero-skip aggregate-row
  # policy) above; every other --verification-require-test-json task (e.g.
  # loader_interpreter_tests/loader_compile_tests) only ever populates the
  # generic $executed from the require_test_json block earlier in this
  # function. Fall back to that so the terminal summary line below always
  # carries a real executed count, not the not-applicable default.
  if [ "$test_executed" = not-applicable ] && [ "$require_test_json" -eq 1 ]; then
    test_executed=$executed
  fi
  # Tool help is an executable ABI sanity probe, not merely an exit-code
  # check. Native runtimes deliberately fail closed on invalid handles but may
  # return control to the program so diagnostics remain inspectable. Do not
  # admit that rc=0 as a healthy built artifact.
  case "$task" in
    *_help)
      if grep -Eq '\[simple-runtime\]\[error\].*(invalid array handle|compiler/FFI ABI mismatch)|probable compiler/FFI ABI mismatch' "$log"; then
        status=86
      fi
      ;;
  esac
  artifact_status=not-applicable
  artifact_sha256=-
  if [ -n "$expected_executable" ]; then
    if [ "$status" -ne 0 ]; then
      artifact_status=producer-failed
    elif [ ! -e "$expected_executable" ]; then
      printf 'bootstrap-phase-verification: command exited 0 but expected executable is missing: %s\n' \
        "$expected_executable" >>"$log"
      status=87
      artifact_status=missing
    elif [ -L "$expected_executable" ] || [ ! -f "$expected_executable" ] || \
         [ ! -x "$expected_executable" ]; then
      printf 'bootstrap-phase-verification: expected artifact is not a regular executable: %s\n' \
        "$expected_executable" >>"$log"
      status=87
      artifact_status=invalid
    else
      artifact_status=present
      artifact_sha256=$(hash_file "$expected_executable") || {
        status=89
        artifact_status=hash-failed
        artifact_sha256=-
      }
    fi
  fi
  ended=$(date +%s)
  max_rss_kib=$(read_max_rss_kib "$active_rss_file")
  if [ "$phase" = stage1 ] && [ "$status" -eq 0 ] && [ "$artifact_status" = present ]; then
    bootstrap_phase1_register_tool "$expected_executable" "$artifact_sha256" || status=89
  fi
  result=PASS
  case "$status" in
    0) result=PASS ;;
    124|137) result=TIMEOUT ;;
    134|136|139) result=CRASH ;;
    *) result=FAIL ;;
  esac
  if [ -n "$expected_executable" ]; then
    printf 'task=%s|result=%s|status=%s|elapsed_seconds=%s|max_rss_kib=%s|log=%s|artifact=%s|artifact_status=%s|artifact_sha256=%s|stage4_snapshot_before=%s|stage4_snapshot_after=%s|executed=%s|passed=%s|failed=%s|skipped=%s\n' \
      "$task" "$result" "$status" "$((ended - started))" "$max_rss_kib" "$log" \
      "$expected_executable" "$artifact_status" "$artifact_sha256" \
      "$stage4_snapshot_before" "$stage4_snapshot_after" "$executed" "$test_passed" \
      "$test_failed" "$test_skipped" >>"$summary" ||
      die "cannot append verification summary"
  else
    printf 'task=%s|result=%s|status=%s|elapsed_seconds=%s|max_rss_kib=%s|log=%s|command_owner_before=%s|command_owner_after=%s|stage4_tooling_before=%s|stage4_tooling_after=%s|stage4_snapshot_before=%s|stage4_snapshot_after=%s|executed=%s|passed=%s|failed=%s|skipped=%s\n' \
      "$task" "$result" "$status" "$((ended - started))" "$max_rss_kib" "$log" \
      "$command_owner_before" "$command_owner_after" "$stage4_tooling_before" "$stage4_tooling_after" \
      "$stage4_snapshot_before" "$stage4_snapshot_after" \
      "$test_executed" "$test_passed" "$test_failed" "$test_skipped" >>"$summary" ||
      die "cannot append verification summary"
  fi
  [ "$status" -eq 0 ]
}

# The full CLI and test runner are distinct native products.  A receipt binds
# every source check/test invocation to the exact pair constructed by this
# verification run.  It is created once with noclobber and then made read-only;
# validating both hashes before and after a command rejects a concurrent swap.
write_command_owner_receipt() {
  receipt=$1
  cli=$2
  cli_sha=$3
  runner=$4
  runner_sha=$5
  mcp=$6
  mcp_sha=$7
  if [ -z "$mcp" ] || [ -z "$mcp_sha" ]; then
    mcp=-
    mcp_sha=-
  fi
  if [ -e "$receipt" ]; then
    [ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
    [ "$(manifest_value schema "$receipt")" = simple-bootstrap-command-owners-v3 ] || return 1
    [ "$(manifest_value status "$receipt")" = frozen ] || return 1
    [ "$(manifest_value phase "$receipt")" = "$phase" ] || return 1
    [ "$(manifest_value compiler_snapshot_sha256 "$receipt")" = "$snapshot_sha" ] || return 1
    [ "$(manifest_value runtime_identity_sha256 "$receipt")" = "$runtime_cache_identity" ] || return 1
    validate_target_c_receipt "$receipt" || return 1
    [ "$(manifest_value compiler_cli_path "$receipt")" = "$cli" ] || return 1
    [ "$(manifest_value compiler_cli_sha256 "$receipt")" = "$cli_sha" ] || return 1
    [ "$(manifest_value test_runner_path "$receipt")" = "$runner" ] || return 1
    [ "$(manifest_value test_runner_sha256 "$receipt")" = "$runner_sha" ] || return 1
    [ "$(manifest_value mcp_server_path "$receipt")" = "$mcp" ] || return 1
    [ "$(manifest_value mcp_server_sha256 "$receipt")" = "$mcp_sha" ] || return 1
    return 0
  fi
  (
    umask 077
    set -C
    {
      echo 'schema=simple-bootstrap-command-owners-v3'
      echo 'status=frozen'
      echo "phase=$phase"
      echo "compiler_snapshot_sha256=$snapshot_sha"
      echo "runtime_identity_sha256=$runtime_cache_identity"
      write_target_c_receipt_fields || exit 1
      echo "compiler_cli_path=$cli"
      echo "compiler_cli_sha256=$cli_sha"
      echo "test_runner_path=$runner"
      echo "test_runner_sha256=$runner_sha"
      echo "mcp_server_path=$mcp"
      echo "mcp_server_sha256=$mcp_sha"
    } >"$receipt"
  ) || return 1
  chmod 400 "$receipt" || return 1
  [ ! -L "$receipt" ] && [ "$(hash_file "$receipt")" ]
}

validate_command_owner_receipt() {
  vcor_receipt=$1
  [ -n "${command_owner_receipt_sha:-}" ] || return 1
  [ -f "$vcor_receipt" ] && [ ! -L "$vcor_receipt" ] || return 1
  [ "$(hash_file "$vcor_receipt")" = "$command_owner_receipt_sha" ] || return 1
  [ "$(manifest_value schema "$vcor_receipt")" = simple-bootstrap-command-owners-v3 ] || return 1
  [ "$(manifest_value status "$vcor_receipt")" = frozen ] || return 1
  [ "$(manifest_value phase "$vcor_receipt")" = "$phase" ] || return 1
  [ "$(manifest_value compiler_snapshot_sha256 "$vcor_receipt")" = "$snapshot_sha" ] || return 1
  [ "$(manifest_value runtime_identity_sha256 "$vcor_receipt")" = "$runtime_cache_identity" ] || return 1
  validate_target_c_receipt "$vcor_receipt" || return 1
  vcor_cli=$(manifest_value compiler_cli_path "$vcor_receipt")
  vcor_cli_sha=$(manifest_value compiler_cli_sha256 "$vcor_receipt")
  vcor_runner=$(manifest_value test_runner_path "$vcor_receipt")
  vcor_runner_sha=$(manifest_value test_runner_sha256 "$vcor_receipt")
  vcor_mcp=$(manifest_value mcp_server_path "$vcor_receipt")
  vcor_mcp_sha=$(manifest_value mcp_server_sha256 "$vcor_receipt")
  [ "$vcor_cli" = "$compiler_cli" ] && [ "$vcor_cli_sha" = "$compiler_cli_sha" ] || return 1
  [ "$vcor_runner" = "$test_runner" ] && [ "$vcor_runner_sha" = "$test_runner_sha" ] || return 1
  [ -f "$vcor_cli" ] && [ ! -L "$vcor_cli" ] && [ -x "$vcor_cli" ] || return 1
  [ -f "$vcor_runner" ] && [ ! -L "$vcor_runner" ] && [ -x "$vcor_runner" ] || return 1
  [ "$(hash_file "$vcor_cli")" = "$vcor_cli_sha" ] || return 1
  [ "$(hash_file "$vcor_runner")" = "$vcor_runner_sha" ] || return 1
  if [ "$vcor_mcp" = - ]; then
    [ "$vcor_mcp_sha" = - ] || return 1
  else
    [ "$vcor_mcp" = "$mcp_server" ] && [ "$vcor_mcp_sha" = "$mcp_server_sha" ] || return 1
    [ -f "$vcor_mcp" ] && [ ! -L "$vcor_mcp" ] && [ -x "$vcor_mcp" ] || return 1
    [ "$(hash_file "$vcor_mcp")" = "$vcor_mcp_sha" ] || return 1
  fi
}

# Stage 4 must prove that every producer invocation and final tooling receipt
# still refer to the immutable compiler snapshot taken at this verification
# boundary. A cached expected hash alone would not detect a concurrent rewrite.
validate_stage4_compiler_snapshot() {
  [ "$phase" = stage4 ] || return 1
  [ -f "$compiler_snapshot" ] && [ ! -L "$compiler_snapshot" ] && [ -x "$compiler_snapshot" ] || return 1
  [ "$(hash_file "$compiler_snapshot")" = "$snapshot_sha" ] || return 1
  [ "$snapshot_sha" = "$expected_sha" ] || return 1
}

# Stage 4 is the first phase that can support a release claim.  Its tool
# evidence therefore binds the Phase-4 CLI/runner pair, runtime authority, and
# both service binaries in one immutable receipt.  A matching Stage-3 receipt
# or tool path cannot satisfy this phase-specific record.
write_stage4_tooling_receipt() {
  receipt=$1
  mcp=$2
  mcp_sha=$3
  lsp=$4
  lsp_sha=$5
  if [ -e "$receipt" ]; then
    [ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
    [ "$(manifest_value schema "$receipt")" = simple-bootstrap-stage4-tooling-owners-v1 ] || return 1
    [ "$(manifest_value status "$receipt")" = frozen ] || return 1
    [ "$(manifest_value phase "$receipt")" = stage4 ] || return 1
    [ "$(manifest_value compiler_snapshot_path "$receipt")" = "$compiler_snapshot" ] || return 1
    [ "$(manifest_value compiler_snapshot_sha256 "$receipt")" = "$snapshot_sha" ] || return 1
    [ "$(manifest_value command_owner_receipt_path "$receipt")" = "$command_owner_receipt" ] || return 1
    [ "$(manifest_value command_owner_receipt_sha256 "$receipt")" = "$command_owner_receipt_sha" ] || return 1
    [ "$(manifest_value hosted_runtime_path "$receipt")" = "$runtime_path" ] || return 1
    [ "$(manifest_value hosted_runtime_sha256 "$receipt")" = "$hosted_runtime_sha" ] || return 1
    [ "$(manifest_value mcp_server_path "$receipt")" = "$mcp" ] || return 1
    [ "$(manifest_value mcp_server_sha256 "$receipt")" = "$mcp_sha" ] || return 1
    [ "$(manifest_value lsp_server_path "$receipt")" = "$lsp" ] || return 1
    [ "$(manifest_value lsp_server_sha256 "$receipt")" = "$lsp_sha" ] || return 1
    return 0
  fi
  (
    umask 077
    set -C
    {
      echo 'schema=simple-bootstrap-stage4-tooling-owners-v1'
      echo 'status=frozen'
      echo 'phase=stage4'
      echo "compiler_snapshot_path=$compiler_snapshot"
      echo "compiler_snapshot_sha256=$snapshot_sha"
      echo "command_owner_receipt_path=$command_owner_receipt"
      echo "command_owner_receipt_sha256=$command_owner_receipt_sha"
      echo "hosted_runtime_path=$runtime_path"
      echo "hosted_runtime_sha256=$hosted_runtime_sha"
      echo "mcp_server_path=$mcp"
      echo "mcp_server_sha256=$mcp_sha"
      echo "lsp_server_path=$lsp"
      echo "lsp_server_sha256=$lsp_sha"
    } >"$receipt"
  ) || return 1
  chmod 400 "$receipt" || return 1
  [ ! -L "$receipt" ] && [ "$(hash_file "$receipt")" ]
}

validate_stage4_tooling_receipt() {
  vstr_receipt=$1
  [ "$phase" = stage4 ] || return 1
  [ -n "${stage4_tooling_receipt_sha:-}" ] || return 1
  [ -f "$vstr_receipt" ] && [ ! -L "$vstr_receipt" ] || return 1
  [ "$(hash_file "$vstr_receipt")" = "$stage4_tooling_receipt_sha" ] || return 1
  [ "$(manifest_value schema "$vstr_receipt")" = simple-bootstrap-stage4-tooling-owners-v1 ] || return 1
  [ "$(manifest_value status "$vstr_receipt")" = frozen ] || return 1
  [ "$(manifest_value phase "$vstr_receipt")" = stage4 ] || return 1
  validate_stage4_compiler_snapshot || return 1
  [ "$(manifest_value compiler_snapshot_path "$vstr_receipt")" = "$compiler_snapshot" ] || return 1
  [ "$(manifest_value compiler_snapshot_sha256 "$vstr_receipt")" = "$snapshot_sha" ] || return 1
  [ "$(manifest_value command_owner_receipt_path "$vstr_receipt")" = "$command_owner_receipt" ] || return 1
  [ "$(manifest_value command_owner_receipt_sha256 "$vstr_receipt")" = "$command_owner_receipt_sha" ] || return 1
  validate_command_owner_receipt "$command_owner_receipt" || return 1
  [ "$(manifest_value hosted_runtime_path "$vstr_receipt")" = "$runtime_path" ] || return 1
  validate_hosted_runtime_authority "$runtime_path" || return 1
  # Revalidation refreshes hosted_runtime_sha from the current frozen authority.
  # Compare the tooling receipt only afterward so replacing the authority and
  # its admission record cannot retain a stale, previously matching hash.
  [ "$(manifest_value hosted_runtime_sha256 "$vstr_receipt")" = "$hosted_runtime_sha" ] || return 1
  for vstr_server_key in mcp_server lsp_server; do
    vstr_server=$(manifest_value "${vstr_server_key}_path" "$vstr_receipt")
    vstr_server_sha=$(manifest_value "${vstr_server_key}_sha256" "$vstr_receipt")
    [ -f "$vstr_server" ] && [ ! -L "$vstr_server" ] && [ -x "$vstr_server" ] || return 1
    [ "$(hash_file "$vstr_server")" = "$vstr_server_sha" ] || return 1
  done
}

matrix_failed=0
matrix_unsupported=0

# This checks the admitted C owner, never an inherited Phase2 Rust capsule.
validate_stage3_tool_binding() (
  [ "$(hash_file "$stage3_provenance")" = "$stage3_manifest_sha" ] &&
    [ "$(hash_file "$compiler_snapshot")" = "$expected_sha" ] || exit 1
  # Revalidate live source, tool and runtime inputs, not just their archived
  # snapshot files. Each producer's private TMPDIR owns the verifier scratch.
  TMPDIR="$tmp" bootstrap_stage3_verify_manifest "$stage3_provenance" "$stage3_provenance" \
    "$source_root" "$compiler" "$compiler" "$stage3_provenance.authority-map.env" || exit 1
  [ "$(hash_file "$stage3_provenance")" = "$stage3_manifest_sha" ] &&
    [ "$(hash_file "$compiler_snapshot")" = "$expected_sha" ]
)

# The generic source inventory covers the Simple selector, not src/runtime.
# Stage3's full manifest additionally binds C/headers through its seed inputs
# fingerprint. These target fields also identify tool caches and cover Phase2.
snapshot_target_c_inputs() (
  tci_record=$1
  tci_cc_request=$(bootstrap_phase_c_compiler_path) || exit 1
  tci_cc=$(bootstrap_stage3_canonical_native_command "$tci_cc_request") || exit 1
  [ -f "$tci_cc" ] && [ -x "$tci_cc" ] || exit 1
  if [ -n "${SIMPLE_CC:-}" ]; then
    tci_override=$(command -v "$SIMPLE_CC") || exit 1
    tci_override=$(bootstrap_stage3_canonical_native_command "$tci_override") || exit 1
    [ "$tci_override" = "$tci_cc" ] || exit 1
  fi
  bootstrap_stage3_directory_snapshot "$tci_record.runtime" "$source_root/src/runtime" || exit 1
  "$tci_cc_request" --version >"$tci_record.version" 2>&1 || exit 1
  case "$target_c_platform" in
    *-pc-windows-msvc) grep -Eq '^clang version 23\.1\.1([[:space:]]|$)' "$tci_record.version" || exit 1 ;;
    *) grep -qi 'clang version' "$tci_record.version" || exit 1 ;;
  esac
  tci_profile_sha=$(printf '%s\n' core-c-bootstrap v1 llvm "$target_c_platform" \
    opt=3 riscv-vector=0 stage4-legacy=0 "$target_c_source_sha" | hash_stream) || exit 1
  tci_runtime_sha=$(hash_file "$tci_record.runtime") || exit 1
  tci_sdk_header="$source_root/tools/counterpart/sdk/c/simple_counterpart_abi.h"
  [ -f "$tci_sdk_header" ] && [ ! -L "$tci_sdk_header" ] || exit 1
  tci_sdk_sha=$(hash_file "$tci_sdk_header") || exit 1
  tci_tool_sha=$(hash_file "$tci_cc") || exit 1
  tci_version_sha=$(hash_file "$tci_record.version") || exit 1
  {
    echo 'target_runtime_profile=core-c-bootstrap'
    echo 'target_runtime_abi_policy=v1'
    echo 'target_runtime_backend=llvm'
    echo "target_runtime_platform=$target_c_platform"
    echo "target_source_snapshot_sha256=$target_c_source_sha"
    echo "target_runtime_source_path=$source_root/src/runtime"
    echo "target_runtime_snapshot_sha256=$tci_runtime_sha"
    echo "target_counterpart_sdk_header_path=$tci_sdk_header"
    echo "target_counterpart_sdk_header_sha256=$tci_sdk_sha"
    echo "target_c_tool_path=$tci_cc"
    echo "target_c_tool_sha256=$tci_tool_sha"
    echo "target_c_tool_version_sha256=$tci_version_sha"
    echo "target_runtime_profile_sha256=$tci_profile_sha"
  } >"$tci_record" || exit 1
)

prepare_phase_c_tool_binding() {
  case "${SIMPLE_NATIVE_RUNTIME_BUNDLE:-core-c-bootstrap}" in
    core-c-bootstrap|core_c_bootstrap|core-c|core_c) ;;
    *) return 1 ;;
  esac
  [ "${SIMPLE_ABI_POLICY:-v1}" = v1 ] || return 1
  [ "${SIMPLE_RUNTIME_RISCV64_VECTOR:-0}" = 0 ] || return 1
  if [ -n "${SIMPLE_PROJECT_ROOT:-}" ]; then
    [ "$(CDPATH= cd -- "$SIMPLE_PROJECT_ROOT" && pwd -P)" = "$source_root" ] || return 1
  fi
  if [ "$phase" = stage3 ]; then
    [ "$stage3_backend" = llvm ] || return 1
    target_c_platform=$stage3_platform
    target_c_source_sha=$stage3_source_sha
  else
    target_c_platform=$(bootstrap_phase_c_target_platform) || return 1
    target_c_source_sha=$(manifest_value source_snapshot_sha256 "$(dirname "$compiler")/admission.env")
  fi
  # The Windows executor pins clang-cl/MSVC even under Git Bash's GNU MSYSTEM.
  case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*)
    [ "$target_c_platform" = x86_64-pc-windows-msvc ] || return 1
    [ "${SIMPLE_WINDOWS_ABI:-msvc}:${SIMPLE_LINKER_FLAVOR:-msvc}:${CL:-/TC}" = msvc:msvc:/TC ] || return 1 ;;
  esac
  [ "${#target_c_source_sha}" -eq 64 ] || return 1
  target_c_binding="$work_root/target-c-inputs.env"
  snapshot_target_c_inputs "$target_c_binding" || return 1
  target_c_identity=$(hash_file "$target_c_binding") || return 1
  chmod 400 "$target_c_binding" || return 1
  tool_input_identity=$(printf '%s\n' "$runtime_cache_identity" "$target_c_identity" \
    "$target_c_source_sha" | hash_stream) || return 1
  write_target_c_receipt_fields >>"$summary"
}

write_target_c_receipt_fields() {
  case "$phase" in stage2|stage3)
    cat "$target_c_binding" || return 1
    echo "target_runtime_identity_sha256=$target_c_identity"
    echo "tool_input_identity_sha256=$tool_input_identity"
    ;;
  esac
}

validate_target_c_receipt() {
  case "$phase" in stage2|stage3)
    [ "$(hash_file "$target_c_binding")" = "$target_c_identity" ] || return 1
    [ "$(manifest_key_count target_runtime_identity_sha256 "$1")" = 1 ] || return 1
    [ "$(manifest_key_count tool_input_identity_sha256 "$1")" = 1 ] || return 1
    [ "$(manifest_value target_runtime_identity_sha256 "$1")" = "$target_c_identity" ] || return 1
    [ "$(manifest_value tool_input_identity_sha256 "$1")" = "$tool_input_identity" ] || return 1
    while IFS='=' read -r tcr_key tcr_value; do
      [ "$(manifest_key_count "$tcr_key" "$1")" = 1 ] &&
        [ "$(manifest_value "$tcr_key" "$1")" = "$tcr_value" ] || return 1
    done <"$target_c_binding"
    ;;
  esac
}

validate_phase_c_tool_binding() (
  [ "$(hash_file "$compiler_snapshot")" = "$expected_sha" ] || exit 1
  if [ "$phase" = stage3 ]; then
    validate_stage3_tool_binding || exit 1
  else
    pcb_runtime=$(sh "$source_root/scripts/bootstrap/phase2-runtime-binding.shs" resolve \
      "$compiler" "$source_root" "$tmp/phase2-tool-binding") || exit 1
    [ "$pcb_runtime" = "$runtime_path" ] || exit 1
  fi
  snapshot_target_c_inputs "$tmp/target-c-current.env" || exit 1
  [ "$(hash_file "$tmp/target-c-current.env")" = "$target_c_identity" ] &&
    [ "$(hash_file "$target_c_binding")" = "$target_c_identity" ]
)

run_phase_c_tool_build() {
  pure_tool_task=$1 pure_tool_entry=$2 pure_tool_output=$3 pure_tool_cache=$4 pure_tool_threads=$5
  if matrix_should_skip; then
    matrix_task_passed=0
    record_skipped_task "$pure_tool_task"
    return 0
  fi
  if ! validate_phase_c_tool_binding; then
    printf 'task=%s|result=FAIL|status=authority-mismatch|elapsed_seconds=0|log=-\n' "$pure_tool_task" >>"$summary"
    matrix_failed=1 matrix_task_passed=0
    return
  fi
  run_matrix_task "$pure_tool_task" --verification-expect-executable="$pure_tool_output" \
    "$compiler_snapshot" native-build "$pure_tool_entry" --backend=llvm --low-memory -o "$pure_tool_output"
  if ! validate_phase_c_tool_binding; then
    printf 'task=%s_authority|result=FAIL|status=authority-mismatch|elapsed_seconds=0|log=-\n' "$pure_tool_task" >>"$summary"
    matrix_failed=1 matrix_task_passed=0
  fi
}

# Match inventory workers: each child owns HOME/TMP/cache and result files;
# only the parent publishes rows and marks the command owner ready.
run_phase_c_tool_worker() (
  worker=$1
  home="$work_root/$phase-tool-workers/$worker/home"
  tmp="$work_root/$phase-tool-workers/$worker/tmp"
  summary="$work_root/$phase-tool-workers/$worker/summary.env"
  mkdir -p "$home" "$tmp" || exit 1
  : >"$summary" || exit 1
  shift
  run_phase_c_tool_build "$@"
  printf '%s\n' "$matrix_task_passed" >"$work_root/$phase-tool-workers/$worker/result" || exit 1
)

# A missing full CLI must not hide compiler/module errors. Objects are a
# separate diagnostic surface and never satisfy executable/admission rows.
validate_module_compile_prerequisites() (
  tmp=${TMPDIR:-$tmp}
  [ "${MODULE_COMPILE_PREREQUISITE_BLOCKED:-0}" != 1 ] || { cat "$work_root/module-prerequisite.log"; exit 1; }
  [ "${tool_authority_ready:-0}" = 1 ] || { echo 'compiler runtime authority unavailable'; exit 1; }
  [ -x "$compiler_snapshot" ] && [ ! -L "$compiler_snapshot" ] || { echo 'compiler snapshot missing or invalid'; exit 1; }
  [ "$(hash_file "$compiler_snapshot")" = "$expected_sha" ] || { echo 'compiler snapshot digest mismatch'; exit 1; }
  # Strict Stage4 only permits executable outputs. Do not weaken its profile.
  [ "${SIMPLE_BOOTSTRAP_STAGE4:-0}" != 1 ] || { echo 'strict Stage4 profile does not support diagnostic object output'; exit 1; }
  if [ "${MODULE_COMPILE_VALIDATE_FULL:-0}" != 1 ]; then
    case "$phase" in
      stage2|stage3) [ "$(hash_file "$target_c_binding")" = "$target_c_identity" ] ;;
      stage4) validate_stage4_compiler_snapshot ;;
      *) exit 1 ;;
    esac
    exit $?
  fi
  case "$phase" in
    stage2|stage3) validate_phase_c_tool_binding ;;
    stage4) validate_stage4_compiler_snapshot && validate_hosted_runtime_authority "$runtime_path" ;;
    *) exit 1 ;;
  esac
)

run_module_compile_command() (
  module_entry=$1 pure_tool_cache=$2 module_output=$3 pure_tool_threads=$4
  module_log=$5
  home=$HOME tmp=$TMPDIR logs=$(dirname "$module_log")
  summary="$logs/producer.env"
  cache="$pure_tool_cache"
  SIMPLE_NATIVE_BUILD_EMIT_OBJECT=1
  SIMPLE_RT_OBJ_CACHE_DIR="$pure_tool_cache/runtime-objects"
  export SIMPLE_NATIVE_BUILD_EMIT_OBJECT SIMPLE_RT_OBJ_CACHE_DIR
  # Keep run_task's timeout, exact producer and toolchain authority checks.
  # Positional Phase2/3 dispatch consumes the driver's existing object env;
  # their bootstrap CLI does not parse the full CLI's --emit-object switch.
  if [ "$phase" = stage2 ] || [ "$phase" = stage3 ]; then
    set -- "$compiler_snapshot" native-build "$module_entry" --backend=llvm -o "$module_output"
  else
    set -- "$compiler_snapshot" native-build --emit-object \
      --timeout "$native_internal_timeout" --runtime-bundle "$tool_runtime_bundle" --runtime-path "$runtime_path" \
      --source src/compositions/kernel_llvm_cranelift --source src/compiler --source src/app --source src/lib \
      --entry-closure --entry "$module_entry" --threads "$pure_tool_threads" \
      --cache-dir "$pure_tool_cache" --output "$module_output"
  fi
  printf '%s\n' "SIMPLE_NATIVE_BUILD_EMIT_OBJECT=1" "$@" >"$logs/command.argv"
  module_status=0
  run_task module_compile_object "$@" || module_status=$?
  cat "$logs/module_compile_object.log"
  exit "$module_status"
)

run_failed_binary_module_inventory() {
  [ "$phase" != stage1 ] || return 0
  module_prior_failure=1
  if [ "${compiler_cli_ready:-0}" = 1 ] && [ "${test_runner_ready:-0}" = 1 ] && \
     { [ "$stage2_slim_profile" = 1 ] || { [ "${mcp_build_ready:-0}" = 1 ] && [ "${lsp_build_ready:-0}" = 1 ]; }; }; then
    module_prior_failure=0
    # Slim explicitly limits its successful proof to CLI/runner behavior.
    [ "$stage2_slim_profile" != 1 ] || return 0
  fi
  [ "${matrix_failed:-0}" = 0 ] || module_prior_failure=1
  module_manifest="$work_root/module-compile-inventory.txt"
  # This conservative source-root superset also works when closure discovery
  # failed before producing a graph. It does not claim exact entry membership.
  (cd "$source_root" && find src/compositions/kernel_llvm_cranelift src/compiler src/app src/lib \
      -type f -name '*.spl' -print) >"$module_manifest.unsorted" || return 1
  LC_ALL=C sort -u "$module_manifest.unsorted" >"$module_manifest" || return 1
  module_effective_workers=$module_workers
  [ "$module_effective_workers" -le "$build_threads" ] || module_effective_workers=$build_threads
  module_threads=$((build_threads / module_effective_workers))
  module_cache="$cache_root/module-diagnostics/$phase/$snapshot_sha/${tool_input_identity:-unavailable}"
  printf 'module_compile_scope=source-roots-superset\nmodule_compile_mode=diagnostic-relocatable-object\nmodule_compile_inventory=%s\nmodule_compile_workers=%s\nmodule_compile_threads=%s\n' \
    "$module_manifest" "$module_effective_workers" "$module_threads" >>"$summary"
  MODULE_COMPILE_PRIOR_FAILURE=$module_prior_failure
  export MODULE_COMPILE_PRIOR_FAILURE
  # Full source/runtime authority is validated at inventory boundaries; each
  # invocation still uses run_task's pinned toolchain boundary and immutable
  # producer/binding checks. Diagnostic rows remain provisional until the end.
  MODULE_COMPILE_PREREQUISITE_BLOCKED=0
  if ! MODULE_COMPILE_VALIDATE_FULL=1 validate_module_compile_prerequisites >"$work_root/module-prerequisite.log" 2>&1; then
    MODULE_COMPILE_PREREQUISITE_BLOCKED=1
  fi
  if ! run_module_compile_inventory "$module_manifest" "$work_root/module-diagnostics" "$module_cache" \
      "$module_effective_workers" "$module_threads" run_module_compile_command \
      validate_module_compile_prerequisites "$summary"; then
    matrix_failed=1
  fi
  if [ "$MODULE_COMPILE_PREREQUISITE_BLOCKED" = 0 ] && \
     ! MODULE_COMPILE_VALIDATE_FULL=1 validate_module_compile_prerequisites >>"$work_root/module-prerequisite.log" 2>&1; then
    printf 'task=module_compile_authority|result=FAIL|status=source-runtime-authority-changed|log=%s\n' \
      "$work_root/module-prerequisite.log" >>"$summary"
    matrix_failed=1
  fi
  unset MODULE_COMPILE_PRIOR_FAILURE
  unset MODULE_COMPILE_PREREQUISITE_BLOCKED
}

matrix_should_skip() {
  [ "${SIMPLE_COMPILE_FAIL_FAST:-0}" = 1 ] && [ "$matrix_failed" -ne 0 ]
}

record_skipped_task() {
  printf 'task=%s|result=SKIPPED|status=fail-fast|elapsed_seconds=0|log=-\n' \
    "$1" >>"$summary" || die "cannot append verification summary"
}

run_matrix_task() {
  task=$1
  shift
  matrix_task_passed=0
  if matrix_should_skip; then
    record_skipped_task "$task"
    return 0
  fi
  if ! run_task "$task" "$@"; then
    matrix_failed=1
  else
    matrix_task_passed=1
  fi
  return 0
}

record_unsupported_task() {
  task=$1
  reason=$2
  matrix_unsupported=$((matrix_unsupported + 1))
  matrix_failed=1
  printf 'task=%s|result=UNSUPPORTED|status=%s|elapsed_seconds=0|log=-\n' \
    "$task" "$reason" >>"$summary" || die "cannot append verification summary"
}

# Each inventory row owns its process, timeout, evidence and (when parallel)
# HOME/TMP/native cache. The parent waits for a bounded batch, then publishes
# rows in manifest order; a slow or failed row cannot suppress later evidence.
run_inventory_row() {
  row_task=$1
  row_index=$2
  row_relative=$3
  row_runner=$4
  row_owner=$5
  row_mcp_server=$6
  row_dir="$logs/${row_task}.rows"
  row_output="$row_dir/$row_index.json.log"
  row_diag="$row_dir/$row_index.diag.log"
  row_rss_file="$row_dir/$row_index.max-rss-kib"
  row_record="$row_dir/$row_index.result"
  : >"$row_output"
  : >"$row_diag"
  row_status=0
  row_executed=0
  row_passed=0
  row_failed=0
  row_skipped=0
  row_home=$home
  row_tmp=$tmp
  row_cache="$cache/$row_task"
  if [ "$test_workers" -gt 1 ]; then
    row_home="$row_dir/$row_index.home"
    row_tmp="$row_dir/$row_index.tmp"
    row_cache="$cache/$row_task/$row_index"
    mkdir -p "$row_home" "$row_tmp" "$row_cache" || row_status=96
  fi
  if [ "$row_status" -eq 0 ] && ! validate_command_owner_receipt "$row_owner"; then
    printf 'command-owner receipt mismatch before %s\n' "$row_relative" >>"$row_diag"
    row_status=90
  fi
  if [ "$row_status" -eq 0 ]; then
    (
      cd "$source_root" || exit 125
      # Match run_task dispatch isolation before binding this row's CLI owner.
      # SCV cold init is a one-time prime (bootstrap_scv_prime below), never
      # an ambient setting: inherited, it re-lists the whole tree per child.
      unset SIMPLE_BOOTSTRAP SIMPLE_NATIVE_BUILD_RUST SIMPLE_BINARY SIMPLE_SCV_INVENTORY_COLD_INIT
      stage2_row_delegation_env inventory-row
      if [ -n "$row_mcp_server" ]; then
        HOME="$row_home" TMPDIR="$row_tmp" SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_NO_BOOTSTRAP_DELEGATE=$row_no_delegate \
          SIMPLE_NATIVE_BUILD_CACHE_DIR="$row_cache" \
          SIMPLE_BINARY="$compiler_cli" SIMPLE_BIN="$compiler_cli" \
          SIMPLE_MCP_TEST_BINARY="$row_mcp_server" \
          run_measured_timeout "$row_rss_file" "$spec_timeout_seconds" 15 \
            "$row_runner" "$row_relative" \
            --mode=interpreter --unstable --assert-ran --no-cache --no-db \
            --no-session-daemon "$test_mode_flag" ${test_worker_flag:+"$test_worker_flag"} --json
      else
        HOME="$row_home" TMPDIR="$row_tmp" SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_NO_BOOTSTRAP_DELEGATE=$row_no_delegate \
          SIMPLE_NATIVE_BUILD_CACHE_DIR="$row_cache" \
          SIMPLE_BINARY="$compiler_cli" SIMPLE_BIN="$compiler_cli" \
          run_measured_timeout "$row_rss_file" "$spec_timeout_seconds" 15 \
            "$row_runner" "$row_relative" \
            --mode=interpreter --unstable --assert-ran --no-cache --no-db \
            --no-session-daemon "$test_mode_flag" ${test_worker_flag:+"$test_worker_flag"} --json
      fi
    ) >"$row_output" 2>&1 || row_status=$?
    if ! validate_command_owner_receipt "$row_owner"; then
      printf 'command-owner receipt changed during %s\n' "$row_relative" >>"$row_diag"
      row_status=90
    fi
  fi
  if [ "$row_status" -eq 0 ]; then
    row_json_status=0
    row_counts=$(perl "$source_root/scripts/bootstrap/validate-test-runner-json.pl" \
      "$row_output" 2>>"$row_diag") || row_json_status=$?
    if [ -n "$row_counts" ]; then
      row_tab=$(printf '\t')
      row_old_ifs=$IFS
      IFS=$row_tab
      set -- $row_counts
      IFS=$row_old_ifs
      [ "$#" -eq 3 ] || row_json_status=91
    fi
    if [ "$#" -eq 3 ] && [ -n "$row_counts" ]; then
      row_passed=$1
      row_failed=$2
      row_skipped=$3
      row_executed=$((row_passed + row_failed))
    fi
    row_status=$row_json_status
  fi
  row_max_rss_kib=$(read_max_rss_kib "$row_rss_file")
  row_result=FAIL
  case "$row_status" in
    0) row_result=PASS ;;
    124|137) row_result=TIMEOUT ;;
    134|136|139) row_result=CRASH ;;
  esac
  printf '%s %s %s %s %s %s %s\n' \
    "$row_result" "$row_status" "$row_executed" "$row_passed" \
    "$row_failed" "$row_skipped" "$row_max_rss_kib" >"$row_record.tmp" &&
    mv "$row_record.tmp" "$row_record"
}

run_inventory_rows() {
  task=$1
  row_runner=$2
  row_owner=$3
  row_mcp_server=$4
  manifest=$5
  log="$logs/$task.log"
  inventory="$logs/${task}.inventory.tsv"
  row_dir="$logs/${task}.rows"
  : >"$log"
  mkdir -p "$row_dir"
  printf 'spec\tresult\tstatus\texecuted\tpassed\tfailed\tskipped\tevidence\tmax_rss_kib\n' >"$inventory"
  started=$(date +%s)
  spec_count=0
  active_count=0
  active_jobs=
  row_stop=0
  matrix_should_skip && row_stop=1
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    spec_count=$((spec_count + 1))
    relative=${spec#"$source_root/"}
    # A retried lineage may already have row files. A killed worker must never
    # inherit a prior PASS receipt or an old RSS/evidence file.
    rm -f "$row_dir/$spec_count.result" "$row_dir/$spec_count.result.tmp" \
      "$row_dir/$spec_count.json.log" "$row_dir/$spec_count.diag.log" \
      "$row_dir/$spec_count.max-rss-kib" "$row_dir/$spec_count.wait-failed" ||
      die "cannot reset inventory row before launch: $task/$spec_count"
    if [ "$row_stop" -eq 1 ]; then
      printf '%s\n' 'SKIPPED 95 0 0 0 1 unavailable' >"$row_dir/$spec_count.result"
      continue
    fi
    run_inventory_row "$task" "$spec_count" "$relative" \
      "$row_runner" "$row_owner" "$row_mcp_server" &
    active_jobs="$active_jobs $spec_count:$!"
    active_count=$((active_count + 1))
    if [ "$active_count" -eq "$test_workers" ]; then
      for row_job in $active_jobs; do
        row_job_index=${row_job%%:*}
        row_pid=${row_job#*:}
        if wait "$row_pid"; then :; else
          printf '%s\n' "$?" >"$row_dir/$row_job_index.wait-failed" ||
            die "cannot record failed inventory worker: $task/$row_job_index"
        fi
      done
      if [ "${SIMPLE_COMPILE_FAIL_FAST:-0}" = 1 ]; then
        for row_job in $active_jobs; do
          row_job_index=${row_job%%:*}
          if [ -f "$row_dir/$row_job_index.wait-failed" ] ||
             ! grep -q '^PASS 0 ' "$row_dir/$row_job_index.result" 2>/dev/null; then
            row_stop=1
          fi
        done
      fi
      active_jobs=
      active_count=0
    fi
  done <"$manifest"
  for row_job in $active_jobs; do
    row_job_index=${row_job%%:*}
    row_pid=${row_job#*:}
    if wait "$row_pid"; then :; else
      printf '%s\n' "$?" >"$row_dir/$row_job_index.wait-failed" ||
        die "cannot record failed inventory worker: $task/$row_job_index"
    fi
  done

  failed=0
  passed_count=0
  timeout_count=0
  crash_count=0
  max_rss_kib=0
  row_index=0
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    row_index=$((row_index + 1))
    relative=${spec#"$source_root/"}
    row_output="$row_dir/$row_index.json.log"
    row_diag="$row_dir/$row_index.diag.log"
    row_record="$row_dir/$row_index.result"
    row_result=FAIL
    row_status=96
    row_executed=0
    row_passed=0
    row_failed=0
    row_skipped=0
    row_max_rss_kib=unavailable
    if [ -f "$row_dir/$row_index.wait-failed" ]; then
      printf 'inventory row worker exited %s before terminal receipt\n' \
        "$(head -n 1 "$row_dir/$row_index.wait-failed")" >>"$row_diag"
    elif [ -f "$row_record" ]; then
      read -r row_result row_status row_executed row_passed row_failed \
        row_skipped row_max_rss_kib <"$row_record" || row_status=96
    fi
    printf 'BEGIN %s\n' "$relative" >>"$log"
    if [ -f "$row_diag" ]; then cat "$row_diag" >>"$log"; fi
    if [ -f "$row_output" ]; then cat "$row_output" >>"$log"; fi
    case "$row_result" in
      PASS) passed_count=$((passed_count + 1)) ;;
      TIMEOUT) timeout_count=$((timeout_count + 1)) ;;
      CRASH) crash_count=$((crash_count + 1)) ;;
    esac
    case "$row_max_rss_kib" in
      [1-9]|[1-9][0-9]*)
        [ "$row_max_rss_kib" -le "$max_rss_kib" ] || max_rss_kib=$row_max_rss_kib ;;
    esac
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$relative" "$row_result" "$row_status" "$row_executed" "$row_passed" \
      "$row_failed" "$row_skipped" "$row_output" "$row_max_rss_kib" >>"$inventory"
    printf 'END %s result=%s status=%s\n' "$relative" "$row_result" "$row_status" >>"$log"
    [ "$row_status" -eq 0 ] || failed=1
  done <"$manifest"
  if [ "$spec_count" -eq 0 ]; then
    printf '%s inventory is empty; no passing result can be admitted\n' "$task" >>"$log"
    failed=1
  fi
  ended=$(date +%s)
  result=PASS
  [ "$failed" -eq 0 ] || result=FAIL
  [ "$max_rss_kib" -gt 0 ] || max_rss_kib=unavailable
  printf 'task=%s|result=%s|status=%s|elapsed_seconds=%s|max_rss_kib=%s|log=%s|inventory=%s|spec_count=%s|passed_count=%s|timeout_count=%s|crash_count=%s|command_owner_receipt=%s\n' \
    "$task" "$result" "$failed" "$((ended - started))" "$max_rss_kib" "$log" "$inventory" \
    "$spec_count" "$passed_count" "$timeout_count" "$crash_count" \
    "$row_owner" >>"$summary"
  [ "$failed" -eq 0 ]
}

# A compiler unit tree is much larger than one matrix-row timeout. Materialize
# its complete, stable list first and contain every spec independently so one
# timeout cannot discard the remaining inventory or suppress terminal receipts.
run_compiler_unit_tests() {
  test_runner=$1
  command_owner_receipt=$2
  task=compiler_unit_tests
  log="$logs/$task.log"
  inventory="$logs/${task}.inventory.tsv"
  manifest="$tmp/${task}.manifest"
  unsorted_manifest="$tmp/${task}.unsorted"
  if ! find "$source_root/test/01_unit/compiler" -type f -name '*_spec.spl' -print >"$unsorted_manifest"; then
    printf 'task=%s|result=FAIL|status=discovery-error|elapsed_seconds=0|log=%s|inventory=%s|spec_count=0\n' \
      "$task" "$log" "$inventory" >>"$summary"
    return 1
  fi
  if ! LC_ALL=C sort "$unsorted_manifest" >"$manifest"; then
    printf 'task=%s|result=FAIL|status=sort-error|elapsed_seconds=0|log=%s|inventory=%s|spec_count=0\n' \
      "$task" "$log" "$inventory" >>"$summary"
    return 1
  fi
  run_inventory_rows "$task" "$test_runner" "$command_owner_receipt" "" "$manifest"
}

# Phase 3 full verification must cover the repository inventory, not only the
# compiler subtree.  Each spec is terminalized independently so a crash or
# timeout cannot hide later rows, and --assert-ran rejects zero-example greens.
run_repository_full_tests() {
  test_runner=$1
  full_owner_receipt=$2
  full_mcp_server=$3
  task=repository_full_tests
  log="$logs/$task.log"
  inventory="$logs/${task}.inventory.tsv"
  results="$logs/${task}.results.tsv"
  manifest="$tmp/${task}.manifest"
  unsorted_manifest="$tmp/${task}.unsorted"
  if ! find "$source_root/test" -type f \
      \( -name '*_spec.spl' -o -name '*_test.spl' \) -print >"$unsorted_manifest"; then
    printf 'task=%s|result=FAIL|status=discovery-error|elapsed_seconds=0|log=%s|inventory=%s|spec_count=0\n' \
      "$task" "$log" "$inventory" >>"$summary"
    return 1
  fi
  if ! LC_ALL=C sort "$unsorted_manifest" >"$manifest"; then
    printf 'task=%s|result=FAIL|status=sort-error|elapsed_seconds=0|log=%s|inventory=%s|spec_count=0\n' \
      "$task" "$log" "$inventory" >>"$summary"
    return 1
  fi
  # NOTE: repository_full_tests intentionally does NOT route through the
  # shared run_inventory_rows/run_inventory_row helper used above for
  # compiler_unit_tests: this matrix's rows parse the full-repo runner's
  # nested "spec":{...} JSON schema (grep/sed below), not the flat schema
  # validate-test-runner-json.pl expects, and that distinction predates this
  # merge (base already had it) — keeping it here avoids silently changing
  # how repository-wide pass/fail counts are parsed.
  category_count=$(awk '{ path=$0; sub(/^.*\/test\//, "", path); split(path, part, "/"); \
      if (part[1] != "") seen[part[1]]=1 } \
      END { for (key in seen) count++; print count+0 }' "$manifest")
  : >"$log"
  row_dir="$logs/${task}.rows"
  mkdir -p "$row_dir"
  printf 'spec\tresult\tstatus\texecuted\tpassed\tfailed\tskipped\tevidence\tmax_rss_kib\n' >"$inventory"
  printf 'runner\tpath\tresult\texecuted\tskipped\n' >"$results"
  started=$(date +%s)
  failed=0
  spec_count=0
  passed_count=0
  skipped_spec_count=0
  timeout_count=0
  crash_count=0
  max_rss_kib=0
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    spec_count=$((spec_count + 1))
    relative=${spec#"$source_root/"}
    row_output="$row_dir/$spec_count.json.log"
    row_rss_file="$row_dir/$spec_count.max-rss-kib"
    if [ "${SIMPLE_COMPILE_FAIL_FAST:-0}" = 1 ] &&
       { [ "$failed" -ne 0 ] || matrix_should_skip; }; then
      printf '%s\tSKIPPED\t95\t0\t0\t0\t1\t-\tunavailable\n' "$relative" >>"$inventory"
      printf 'simple-spec\t%s\tSKIPPED\t0\t1\n' "$relative" >>"$results"
      failed=1
      continue
    fi
    printf 'BEGIN %s\n' "$relative" >>"$log"
    status=0
    executed=0
    row_passed=0
    row_failed=0
    row_skipped=0
    row_disposition=execute
    if ! validate_command_owner_receipt "$full_owner_receipt"; then
      printf 'command-owner receipt mismatch before %s\n' "$relative" >>"$log"
      status=90
    else
      (
        cd "$source_root" || exit 125
        # Keep ambient bootstrap routing out of direct repository-test rows;
        # SIMPLE_BINARY below is the exact receipt-bound CLI for this matrix.
        unset SIMPLE_BOOTSTRAP SIMPLE_NATIVE_BUILD_RUST SIMPLE_BINARY SIMPLE_SCV_INVENTORY_COLD_INIT
        stage2_row_delegation_env inventory-row
        HOME="$home" TMPDIR="$tmp" SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_NO_BOOTSTRAP_DELEGATE=$row_no_delegate \
          SIMPLE_NATIVE_BUILD_CACHE_DIR="$cache/$task" \
          SIMPLE_BINARY="$compiler_cli" \
          SIMPLE_BIN="$compiler_cli" \
          SIMPLE_MCP_TEST_BINARY="$full_mcp_server" \
          run_measured_timeout "$row_rss_file" "$spec_timeout_seconds" 15 \
            "$test_runner" "$relative" \
            --mode=interpreter --unstable --assert-ran --no-cache --no-db \
            --no-session-daemon --sequential --json
      ) >"$row_output" 2>&1 || status=$?
      cat "$row_output" >>"$log"
      if ! validate_command_owner_receipt "$full_owner_receipt"; then
        printf 'command-owner receipt changed during %s\n' "$relative" >>"$log"
        status=90
      fi
    fi
    if [ "$status" -eq 0 ]; then
      validate_test_runner_json_log "$row_output" 2>>"$log" || :
      row_passed=$validated_passed
      row_failed=$validated_failed
      row_skipped=$validated_skipped
      executed=$validated_executed
      status=$validated_status
      if [ "$row_skipped" -gt 0 ] && { [ "$status" -eq 0 ] || [ "$status" -eq 92 ]; }; then
        skip_policy_status=0
        skip_policy=$(sh "$source_root/scripts/bootstrap/phase3-test-skip-policy.shs" \
          classify "$spec" "$row_skipped" "$executed" 2>>"$log") || skip_policy_status=$?
        if [ "$skip_policy_status" -eq 0 ] && [ "$skip_policy" = 'skip|in-development' ]; then
          status=0
          row_disposition=skip
        else
          status=94
        fi
      fi
    fi
    row_max_rss_kib=$(read_max_rss_kib "$row_rss_file")
    case "$row_max_rss_kib" in
      [1-9][0-9]*)
        [ "$row_max_rss_kib" -le "$max_rss_kib" ] || max_rss_kib=$row_max_rss_kib ;;
    esac
    result=FAIL
    case "$status" in
      0)
        if [ "$row_disposition" = skip ]; then
          result=SKIP
          skipped_spec_count=$((skipped_spec_count + 1))
        else
          result=PASS
          passed_count=$((passed_count + 1))
        fi
        ;;
      124|137) result=TIMEOUT; timeout_count=$((timeout_count + 1)) ;;
      134|136|139) result=CRASH; crash_count=$((crash_count + 1)) ;;
    esac
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$relative" "$result" "$status" "$executed" "$row_passed" "$row_failed" \
      "$row_skipped" "$row_output" "$row_max_rss_kib" >>"$inventory"
    result_receipt=FAIL
    [ "$result" = PASS ] && result_receipt=PASS
    [ "$result" = SKIP ] && result_receipt=SKIP
    printf 'simple-spec\t%s\t%s\t%s\t%s\n' "$relative" "$result_receipt" \
      "$executed" "$row_skipped" >>"$results"
    printf 'END %s result=%s status=%s\n' "$relative" "$result" "$status" >>"$log"
    [ "$status" -eq 0 ] || failed=1
  done <"$manifest"
  if [ "$spec_count" -eq 0 ]; then
    printf 'repository test inventory is empty; no passing result can be admitted\n' >>"$log"
    failed=1
  fi
  ended=$(date +%s)
  result=PASS
  [ "$failed" -eq 0 ] || result=FAIL
  [ "$max_rss_kib" -gt 0 ] || max_rss_kib=unavailable
  printf 'task=%s|result=%s|status=%s|elapsed_seconds=%s|max_rss_kib=%s|log=%s|inventory=%s|results=%s|spec_count=%s|passed_count=%s|skipped_spec_count=%s|category_count=%s|timeout_count=%s|crash_count=%s|command_owner_receipt=%s\n' \
    "$task" "$result" "$failed" "$((ended - started))" "$max_rss_kib" "$log" "$inventory" \
    "$results" "$spec_count" "$passed_count" "$skipped_spec_count" "$category_count" "$timeout_count" "$crash_count" \
    "$full_owner_receipt" >>"$summary"
  [ "$failed" -eq 0 ]
}

run_phase3_expanded_tests() {
  expanded_runner=$1
  expanded_owner_receipt=$2
  expanded_mcp_server=$3
  expanded_repository_results=$4
  task=phase3_expanded_tests
  if matrix_should_skip; then
    record_skipped_task "$task"
    return 1
  fi
  log="$logs/$task.log"
  inventory="$logs/$task.inventory.tsv"
  results="$logs/$task.results.tsv"
  counts="$logs/$task.surface-counts.tsv"
  nested_receipt="$logs/$task.nested-receipt.tsv"
  started=$(date +%s)
  status=0
  sh "$source_root/scripts/bootstrap/phase3-test-inventory.shs" discover \
    "$source_root" "$nested_receipt" >"$inventory" 2>"$log" || status=$?
  if [ "$status" -eq 0 ]; then
    PHASE3_COMMAND_OWNER_RECEIPT="$expanded_owner_receipt" \
    PHASE3_COMMAND_OWNER_RECEIPT_SHA256="$command_owner_receipt_sha" \
    PHASE3_TEST_RUNNER="$expanded_runner" PHASE3_COMPILER_CLI="$compiler_cli" \
    PHASE3_MCP_SERVER="$expanded_mcp_server" PHASE3_TIMEOUT_SECONDS="$spec_timeout_seconds" \
    PHASE3_HOME="$home" PHASE3_TMPDIR="$tmp" PHASE3_CACHE_DIR="$cache/$task" \
      sh "$source_root/scripts/bootstrap/phase3-expanded-test-runner.shs" \
        "$source_root" "$inventory" "$expanded_repository_results" "$results" \
        "$counts" "$logs/$task.rows" "$nested_receipt" >>"$log" 2>&1 || status=$?
  fi
  ended=$(date +%s)
  result=PASS
  [ "$status" -eq 0 ] || result=FAIL
  printf 'task=%s|result=%s|status=%s|elapsed_seconds=%s|log=%s|inventory=%s|results=%s|surface_counts=%s|nested_receipt=%s|command_owner_receipt=%s\n' \
    "$task" "$result" "$status" "$((ended - started))" "$log" "$inventory" \
    "$results" "$counts" "$nested_receipt" "$expanded_owner_receipt" >>"$summary"
  [ "$status" -eq 0 ]
}

# Both strategies collect independent tasks by default; explicit fail-fast
# terminalizes unlaunched work as SKIPPED and preserves the failure status.
# Call-site prerequisite checks block tasks whose required artifacts are absent;
# an unrelated earlier failure must not suppress useful diagnostic evidence.
run_matrix_task compiler_version "$compiler_snapshot" --version
hosted_runtime_ready=0
if [ "$phase" = stage1 ]; then
  # Stage 1 is the Rust bootstrap seed. It accepts `check`/`test`, but its own
  # authority banner forbids use as the normal tool; applying its older
  # semantic surface to the current pure-Simple tree produced identical
  # source-looking failures for every unrelated directory. Record the missing
  # capability explicitly instead of claiming either coverage or regressions.
  record_unsupported_task compiler_check bootstrap-seed-not-qualified-for-source-check
  record_unsupported_task compiler_bootstrap_tests bootstrap-seed-not-qualified-for-source-test
  record_unsupported_task mcp_check bootstrap-seed-not-qualified-for-source-check
  record_unsupported_task lsp_check bootstrap-seed-not-qualified-for-source-check
  if [ "$strategy" = full ]; then
    record_unsupported_task library_check bootstrap-seed-not-qualified-for-source-check
    record_unsupported_task compiler_unit_tests bootstrap-seed-not-qualified-for-source-test
  fi
else
  # bootstrap_main is a compiler capsule, not the full command-line tool. Build
  # SHA-bound full-CLI and test-runner artifacts first, then route source checks
  # and tests through the artifact that actually owns each command surface.
  # This prevents an unsupported `check`/`test` dispatch from being expanded
  # into thousands of false source failures.
   # The producer keeps its own phase admission. Phase2/3 tools link the live,
   # separately bound C owner through the pure-Simple positional route.
  tool_runtime_bundle=host-gpu
  hosted_runtime_sha=""
  compiler_cli=""
  test_runner=""
  command_owner_receipt=""
  command_owner_receipt_sha=""
  compiler_cli_ready=0
  test_runner_ready=0
  tool_authority_ready=0
  if [ "$phase" = stage3 ]; then
    validate_stage3_tool_binding && tool_authority_ready=1
  elif validate_hosted_runtime_authority "$runtime_path"; then
    tool_authority_ready=1
  fi
  if [ "$tool_authority_ready" -ne 1 ]; then
    record_unsupported_task compiler_cli_build host-gpu-hosted-runtime-authority-unavailable
    record_unsupported_task test_runner_build host-gpu-hosted-runtime-authority-unavailable
   else
    [ "$phase" = stage3 ] || echo "hosted_runtime_sha256=$hosted_runtime_sha" >>"$summary"
     hosted_runtime_ready=1
     tool_input_identity=$runtime_cache_identity
     if [ "$phase" = stage2 ] || [ "$phase" = stage3 ]; then
       prepare_phase_c_tool_binding || die "cannot bind target C source/profile/tool inputs"
     fi
     tool_cache="$cache_root/compiler-tools/$phase/$snapshot_sha/$tool_input_identity"
    # 16-hex prefixes, not the full 64-hex pair: the full path to the built
    # simple_cli.exe was 288 chars on the Windows lane, past MAX_PATH, and
    # CreateProcess cannot launch an image there (ERROR_FILE_NOT_FOUND even
    # with LongPathsEnabled), so every spec child the runner spawned failed
    # "process spawn failed" (bootstrap36, 2026-09-25). Identity is still the
    # full hashes recorded in the command-owner receipt.
     tool_outputs="$outputs/compiler-tools/$phase/$(printf %.16s "$snapshot_sha")/$(printf %.16s "$tool_input_identity")"
    compiler_cli="$tool_outputs/simple_cli"
    test_runner="$tool_outputs/simple_test_runner"
    # Concurrent producers own separate object/cache and temporary state,
    # including the slim Phase2 profile.
    tool_cache_cli="$tool_cache/full-cli"
    tool_cache_runner="$tool_cache/test-runner"
    mkdir -p "$tool_cache_cli" "$tool_cache_runner"
    mkdir -p "$tool_outputs"
    rm -f "$compiler_cli" "$test_runner"
     if [ "$phase" = stage2 ] || [ "$phase" = stage3 ]; then
       if [ "$build_threads" -gt 1 ] && [ "${SIMPLE_COMPILE_FAIL_FAST:-0}" != 1 ]; then
         phase_worker_threads=$((build_threads / 2))
         phase_workers="$work_root/$phase-tool-workers"
         mkdir -p "$phase_workers/cli" "$phase_workers/runner" || die "cannot isolate phase C builders"
         rm -f "$phase_workers/cli/result" "$phase_workers/runner/result"
         run_phase_c_tool_worker cli compiler_cli_build src/app/cli/_CliMain/main_and_help.spl \
           "$compiler_cli" "$tool_cache_cli" "$phase_worker_threads" &
         phase_cli_pid=$!
         run_phase_c_tool_worker runner test_runner_build src/app/test_runner_new/main.spl \
           "$test_runner" "$tool_cache_runner" "$phase_worker_threads" &
         phase_runner_pid=$!
         phase_cli_wait=0 phase_runner_wait=0
         wait "$phase_cli_pid" || phase_cli_wait=$?
         wait "$phase_runner_pid" || phase_runner_wait=$?
         for phase_worker in cli runner; do
           [ -f "$phase_workers/$phase_worker/summary.env" ] && cat "$phase_workers/$phase_worker/summary.env" >>"$summary"
         done
         [ "$phase_cli_wait" -ne 0 ] || compiler_cli_ready=$(cat "$phase_workers/cli/result" 2>/dev/null || printf 0)
         [ "$phase_runner_wait" -ne 0 ] || test_runner_ready=$(cat "$phase_workers/runner/result" 2>/dev/null || printf 0)
         if [ "$compiler_cli_ready" != 1 ] || [ "$test_runner_ready" != 1 ]; then
           matrix_failed=1
           printf 'task=%s_tool_workers|result=FAIL|status=worker-failed|elapsed_seconds=0|log=-\n' "$phase" >>"$summary"
         fi
       else
         run_phase_c_tool_build compiler_cli_build src/app/cli/_CliMain/main_and_help.spl "$compiler_cli" "$tool_cache_cli" 1
        compiler_cli_ready=$matrix_task_passed
         run_phase_c_tool_build test_runner_build src/app/test_runner_new/main.spl "$test_runner" "$tool_cache_runner" 1
        test_runner_ready=$matrix_task_passed
      fi
    else
    run_matrix_task compiler_cli_build --verification-expect-executable="$compiler_cli" \
      "$compiler_snapshot" native-build \
      --timeout "$native_internal_timeout" --runtime-bundle "$tool_runtime_bundle" --runtime-path "$runtime_path" \
      --source src/compositions/kernel_llvm_cranelift \
      --source src/compiler --source src/app --source src/lib --entry-closure \
      --entry src/app/cli/_CliMain/main_and_help.spl --threads "$build_threads" \
      --cache-dir "$tool_cache_cli" --output "$compiler_cli"
    compiler_cli_ready=$matrix_task_passed
    run_matrix_task test_runner_build --verification-expect-executable="$test_runner" \
      "$compiler_snapshot" native-build \
      --timeout "$native_internal_timeout" --runtime-bundle "$tool_runtime_bundle" --runtime-path "$runtime_path" \
      --source src/compositions/kernel_llvm_cranelift \
      --source src/compiler --source src/app --source src/lib --entry-closure \
      --entry src/app/test_runner_new/main.spl --threads "$build_threads" \
      --cache-dir "$tool_cache_runner" --output "$test_runner"
    test_runner_ready=$matrix_task_passed
    fi
  fi

  if [ "$compiler_cli_ready" -eq 1 ] && [ -x "$compiler_cli" ]; then
    compiler_cli_sha=$(hash_file "$compiler_cli")
  else
    compiler_cli_sha=""
  fi
  if [ "$test_runner_ready" -eq 1 ] && [ -x "$test_runner" ]; then
    test_runner_sha=$(hash_file "$test_runner")
  else
    test_runner_sha=""
  fi

  # Build the receipt-owned service binaries before any full inventory row can
  # reach an MCP spec. The command-owner receipt below binds this MCP path and
  # hash, so no phase can substitute an ambient bin/simple_mcp_server wrapper.
  mcp_server=""
  mcp_server_sha=""
  if [ "$stage2_slim_profile" -eq 1 ]; then
    : # slim stage-2 profile: MCP/LSP server builds are out of scope for the
      # "compiler test binary works" proof; skip entirely (no task row --
      # see the stage2_slim_profile note above for why no row is emitted).
  elif [ "$hosted_runtime_ready" -eq 1 ]; then
    tool_build_cache="$cache/tool_builds/$phase/$snapshot_sha/$tool_input_identity"
    # Short path for the same MAX_PATH reason as tool_outputs above.
    server_outputs="$outputs/tool-builds/$phase/$(printf %.16s "$snapshot_sha")/$(printf %.16s "$tool_input_identity")"
    mcp_server="$server_outputs/simple_mcp_server"
    mkdir -p "$server_outputs"
    rm -f "$server_outputs/simple_mcp_server" "$server_outputs/simple_lsp_mcp_server"
    if [ "$phase" = stage2 ] || [ "$phase" = stage3 ]; then
      run_phase_c_tool_build mcp_build src/app/mcp/main.spl "$mcp_server" "$tool_build_cache/mcp" "$build_threads"
      mcp_build_ready=$matrix_task_passed
      run_phase_c_tool_build lsp_build src/app/simple_lsp_mcp/main.spl "$server_outputs/simple_lsp_mcp_server" "$tool_build_cache/lsp" "$build_threads"
      lsp_build_ready=$matrix_task_passed
    else
    service_mcp_cache=$(bootstrap_phase_service_cache "$cache/tool_builds" "$phase" "$snapshot_sha" "$tool_input_identity" mcp) || die "cannot isolate MCP cache"
    service_lsp_cache=$(bootstrap_phase_service_cache "$cache/tool_builds" "$phase" "$snapshot_sha" "$tool_input_identity" lsp) || die "cannot isolate LSP cache"
    run_matrix_task mcp_build --verification-expect-executable="$mcp_server" \
      "$compiler_snapshot" native-build \
      --timeout "$native_internal_timeout" --runtime-bundle "$tool_runtime_bundle" --runtime-path "$runtime_path" \
      --source src/compiler --source src/app --source src/lib --entry-closure \
      --entry src/app/mcp/main.spl --threads "$build_threads" --cache-dir "$service_mcp_cache" \
      --output "$mcp_server"
    mcp_build_ready=$matrix_task_passed
    run_matrix_task lsp_build --verification-expect-executable="$server_outputs/simple_lsp_mcp_server" \
      "$compiler_snapshot" native-build \
      --timeout "$native_internal_timeout" --runtime-bundle "$tool_runtime_bundle" --runtime-path "$runtime_path" \
      --source src/compiler --source src/app --source src/lib --entry-closure \
      --entry src/app/simple_lsp_mcp/main.spl --threads "$build_threads" --cache-dir "$service_lsp_cache" \
      --output "$server_outputs/simple_lsp_mcp_server"
    lsp_build_ready=$matrix_task_passed
    fi
    if [ "$mcp_build_ready" -eq 1 ] && [ -x "$mcp_server" ]; then
      mcp_server_sha=$(hash_file "$mcp_server")
    fi
  else
    record_unsupported_task mcp_build host-gpu-hosted-runtime-authority-unavailable
    record_unsupported_task lsp_build host-gpu-hosted-runtime-authority-unavailable
  fi

  run_failed_binary_module_inventory || die "cannot inventory diagnostic modules"

  if [ -n "$compiler_cli_sha" ] && [ -n "$test_runner_sha" ]; then
    if [ "$phase" = stage2 ] || [ "$phase" = stage3 ]; then
      validate_phase_c_tool_binding || die "target C inputs changed before owner publication"
    fi
    command_owner_lineage_sha=$(printf '%s\n' "$compiler_cli_sha" "$test_runner_sha" "$mcp_server_sha" |
      hash_stream)
    command_owner_receipt="$tool_outputs/command-owners.$command_owner_lineage_sha.env"
    write_command_owner_receipt "$command_owner_receipt" "$compiler_cli" "$compiler_cli_sha" \
      "$test_runner" "$test_runner_sha" "$mcp_server" "$mcp_server_sha" || die "cannot freeze command-owner receipt"
    command_owner_receipt_sha=$(hash_file "$command_owner_receipt")
    echo "compiler_cli_sha256=$compiler_cli_sha" >>"$summary"
    echo "test_runner_sha256=$test_runner_sha" >>"$summary"
    echo "command_owner_receipt=$command_owner_receipt" >>"$summary"
    echo "command_owner_receipt_sha256=$command_owner_receipt_sha" >>"$summary"
  fi

  if [ "$phase" = stage4 ]; then
    if [ "${compiler_cli_ready:-0}" -eq 1 ] && [ "${test_runner_ready:-0}" -eq 1 ] && \
       [ "${mcp_build_ready:-0}" -eq 1 ] && [ "${lsp_build_ready:-0}" -eq 1 ] && \
       [ -x "$compiler_cli" ] && [ -x "$test_runner" ] && \
       [ -x "$server_outputs/simple_mcp_server" ] && [ -x "$server_outputs/simple_lsp_mcp_server" ] && \
       [ -n "$command_owner_receipt" ]; then
      validate_stage4_compiler_snapshot || die "Stage4 compiler snapshot changed before tooling receipt"
      stage4_mcp_sha=$(hash_file "$server_outputs/simple_mcp_server")
      stage4_lsp_sha=$(hash_file "$server_outputs/simple_lsp_mcp_server")
      # Derive one compact filename identity from every mutable artifact bound
      # by the frozen receipt. This avoids NAME_MAX overflow without aliasing a
      # rebuilt MCP/LSP/runtime lineage onto an incompatible existing receipt.
      stage4_tooling_lineage_sha=$(printf '%s\n' "$snapshot_sha" "$command_owner_receipt_sha" \
        "$runtime_path" "$hosted_runtime_sha" "$stage4_mcp_sha" "$stage4_lsp_sha" |
        hash_stream)
      stage4_tooling_receipt="$server_outputs/stage4-tooling-owners.$stage4_tooling_lineage_sha.env"
      write_stage4_tooling_receipt "$stage4_tooling_receipt" \
        "$server_outputs/simple_mcp_server" "$stage4_mcp_sha" \
        "$server_outputs/simple_lsp_mcp_server" "$stage4_lsp_sha" ||
        die "cannot freeze Stage4 tooling receipt"
      stage4_tooling_receipt_sha=$(hash_file "$stage4_tooling_receipt")
      echo "stage4_tooling_receipt=$stage4_tooling_receipt" >>"$summary"
      echo "stage4_tooling_receipt_sha256=$stage4_tooling_receipt_sha" >>"$summary"
    else
      record_unsupported_task stage4_tooling_owners stage4-cli-runner-mcp-lsp-artifact-not-built
    fi
  fi

  # Every full-CLI row below (check, and each spec child the test runner
  # spawns) passes SCV admission, which needs build/scv in the source root.
  # Prime it once with the just-built CLI; skipped when a valid journal
  # already exists. Lane-independent. See bootstrap-scv-prime.shs.
  if [ "$compiler_cli_ready" -eq 1 ] && [ -x "$compiler_cli" ]; then
    scv_prime_line=$(bootstrap_scv_prime "$source_root" "$compiler_cli" "$home" "$tmp" \
      "$logs/scv_inventory_prime.log") ||
      die "SCV inventory prime failed; see $logs/scv_inventory_prime.log"
    echo "$scv_prime_line"
    echo "scv_inventory_prime=$scv_prime_line" >>"$summary"
  fi

  if [ "$stage2_slim_profile" -eq 1 ]; then
    : # slim stage-2 profile: source `check` runs belong to the full matrix
      # (--strategy=full); skip entirely (no task row).
  elif [ "$compiler_cli_ready" -eq 1 ] && [ -x "$compiler_cli" ] && \
     [ -n "$command_owner_receipt" ]; then
    run_matrix_task compiler_check --verification-command-owner-receipt="$command_owner_receipt" \
      env SIMPLE_BINARY="$compiler_cli" "$compiler_cli" check src/compiler
    run_matrix_task mcp_check --verification-command-owner-receipt="$command_owner_receipt" \
      env SIMPLE_BINARY="$compiler_cli" "$compiler_cli" check src/app/mcp
    run_matrix_task lsp_check --verification-command-owner-receipt="$command_owner_receipt" \
      env SIMPLE_BINARY="$compiler_cli" "$compiler_cli" check src/app/simple_lsp_mcp
    if [ "$strategy" = full ]; then
      run_matrix_task library_check --verification-command-owner-receipt="$command_owner_receipt" \
        env SIMPLE_BINARY="$compiler_cli" "$compiler_cli" check src/lib
    fi
  else
    record_unsupported_task compiler_check full-cli-artifact-not-built
    record_unsupported_task mcp_check full-cli-artifact-not-built
    record_unsupported_task lsp_check full-cli-artifact-not-built
    if [ "$strategy" = full ]; then
      record_unsupported_task library_check full-cli-artifact-not-built
    fi
  fi

  if [ "$compiler_cli_ready" -eq 1 ] && [ "$test_runner_ready" -eq 1 ] && \
     [ -x "$compiler_cli" ] && [ -x "$test_runner" ] && \
     [ -n "$command_owner_receipt" ]; then
    loader_oracle=test/01_unit/compiler/loader/module_loader_relocation_spec.spl
    case "$(uname -s)" in
      Darwin) loader_oracle=test/01_unit/compiler/loader/module_load_intent_spec.spl ;;
    esac
    run_matrix_task compiler_bootstrap_tests --verification-command-owner-receipt="$command_owner_receipt" \
      --verification-require-test-json \
      env SIMPLE_BINARY="$compiler_cli" SIMPLE_BIN="$compiler_cli" "$test_runner" \
      test/01_unit/compiler/bootstrap --mode=interpreter --unstable \
      --assert-ran --no-cache --no-db --no-session-daemon \
      "$test_mode_flag" ${test_worker_flag:+"$test_worker_flag"} --json
    if [ "$stage2_slim_profile" -ne 1 ]; then
      run_matrix_task compiler_bootstrap_compile_tests --verification-command-owner-receipt="$command_owner_receipt" \
        --verification-require-test-json \
        env SIMPLE_BINARY="$compiler_cli" SIMPLE_BIN="$compiler_cli" "$test_runner" \
        test/01_unit/compiler/bootstrap --mode=compile --unstable \
        --assert-ran --no-cache --no-db --no-session-daemon \
        "$test_mode_flag" ${test_worker_flag:+"$test_worker_flag"} --json
    fi
    # Keep the interpreter subsystem as an explicit inventory in both modes.
    # The full compiler walk below remains independently terminalized per file.
    run_matrix_task interpreter_interpreter_tests --verification-command-owner-receipt="$command_owner_receipt" \
      --verification-require-test-json \
      env SIMPLE_BINARY="$compiler_cli" SIMPLE_BIN="$compiler_cli" "$test_runner" \
      test/01_unit/compiler/interpreter --mode=interpreter --unstable \
      --assert-ran --no-cache --no-db --no-session-daemon \
      "$test_mode_flag" ${test_worker_flag:+"$test_worker_flag"} --json
    if [ "$stage2_slim_profile" -ne 1 ]; then
      run_matrix_task interpreter_compile_tests --verification-command-owner-receipt="$command_owner_receipt" \
        --verification-require-test-json \
        env SIMPLE_BINARY="$compiler_cli" SIMPLE_BIN="$compiler_cli" "$test_runner" \
        test/01_unit/compiler/interpreter --mode=compile --unstable \
        --assert-ran --no-cache --no-db --no-session-daemon \
        "$test_mode_flag" ${test_worker_flag:+"$test_worker_flag"} --json
    fi
    # The full compiler inventory below covers loader sources in interpreter
    # mode. Keep one explicit loader behavior oracle in both execution modes so
    # a phase cannot claim compiler/loader coverage from the bootstrap subset
    # or from source discovery alone.
    run_matrix_task loader_interpreter_tests --verification-command-owner-receipt="$command_owner_receipt" \
      --verification-require-test-json \
      env SIMPLE_BINARY="$compiler_cli" SIMPLE_BIN="$compiler_cli" "$test_runner" \
      "$loader_oracle" --mode=interpreter --unstable \
      --assert-ran --no-cache --no-db --no-session-daemon \
      "$test_mode_flag" ${test_worker_flag:+"$test_worker_flag"} --json
    if [ "$stage2_slim_profile" -ne 1 ]; then
      run_matrix_task loader_compile_tests --verification-command-owner-receipt="$command_owner_receipt" \
        --verification-require-test-json \
        env SIMPLE_BINARY="$compiler_cli" SIMPLE_BIN="$compiler_cli" "$test_runner" \
        "$loader_oracle" --mode=compile --unstable \
        --assert-ran --no-cache --no-db --no-session-daemon \
        "$test_mode_flag" ${test_worker_flag:+"$test_worker_flag"} --json
    fi
    if [ "$strategy" = full ] && ! run_compiler_unit_tests "$test_runner" "$command_owner_receipt"; then
      matrix_failed=1
    fi
    if { [ "$phase" = stage3 ] || [ "$phase" = stage4 ]; } && [ "$strategy" = full ] && \
       ! run_repository_full_tests "$test_runner" "$command_owner_receipt" "$mcp_server"; then
      matrix_failed=1
    fi
    if { [ "$phase" = stage3 ] || [ "$phase" = stage4 ]; } && [ "$strategy" = full ]; then
      if [ -f "$logs/repository_full_tests.results.tsv" ]; then
        if ! run_phase3_expanded_tests "$test_runner" "$command_owner_receipt" "$mcp_server" \
            "$logs/repository_full_tests.results.tsv"; then
          matrix_failed=1
        fi
      else
        record_unsupported_task phase3_expanded_tests repository-full-result-receipt-unavailable
      fi
    fi
  else
    if [ "$compiler_cli_ready" -ne 1 ]; then
      test_owner_reason=full-cli-artifact-not-built
    elif [ "$test_runner_ready" -ne 1 ]; then
      test_owner_reason=test-runner-artifact-not-built
    else
      test_owner_reason=command-owner-receipt-not-built
    fi
    record_unsupported_task compiler_bootstrap_tests "$test_owner_reason"
    if [ "$stage2_slim_profile" -ne 1 ]; then
      record_unsupported_task compiler_bootstrap_compile_tests "$test_owner_reason"
    fi
    record_unsupported_task interpreter_interpreter_tests "$test_owner_reason"
    if [ "$stage2_slim_profile" -ne 1 ]; then
      record_unsupported_task interpreter_compile_tests "$test_owner_reason"
    fi
    record_unsupported_task loader_interpreter_tests "$test_owner_reason"
    if [ "$stage2_slim_profile" -ne 1 ]; then
      record_unsupported_task loader_compile_tests "$test_owner_reason"
    fi
    if [ "$strategy" = full ]; then
      record_unsupported_task compiler_unit_tests "$test_owner_reason"
      if [ "$phase" = stage3 ] || [ "$phase" = stage4 ]; then
        record_unsupported_task repository_full_tests "$test_owner_reason"
        record_unsupported_task phase3_expanded_tests "$test_owner_reason"
      fi
    fi
  fi
fi

if [ "$phase" = stage1 ]; then
  # The admitted seed stamp binds source/tool/target inputs in addition to the
  # executable hash. Never reuse the other entry's mutable native-build cache.
  service_mcp_cache=$(bootstrap_phase_service_cache "$cache/tool_builds" "$phase" "$snapshot_sha" "$p1a_stamp_sha" mcp) || die "cannot isolate Phase1 MCP cache"
  service_lsp_cache=$(bootstrap_phase_service_cache "$cache/tool_builds" "$phase" "$snapshot_sha" "$p1a_stamp_sha" lsp) || die "cannot isolate Phase1 LSP cache"
  run_matrix_task mcp_build --verification-expect-executable="$outputs/simple_mcp_server" \
    "$compiler_snapshot" native-build \
    --source src/compiler --source src/app --source src/lib --entry-closure \
    --entry src/app/mcp/main.spl --threads 1 --cache-dir "$service_mcp_cache" \
    --output "$outputs/simple_mcp_server"
  mcp_build_ready=$matrix_task_passed
  run_matrix_task lsp_build --verification-expect-executable="$outputs/simple_lsp_mcp_server" \
    "$compiler_snapshot" native-build \
    --source src/compiler --source src/app --source src/lib --entry-closure \
    --entry src/app/simple_lsp_mcp/main.spl --threads 1 --cache-dir "$service_lsp_cache" \
    --output "$outputs/simple_lsp_mcp_server"
  lsp_build_ready=$matrix_task_passed
else
  # Non-Stage1 service builds are scheduled before the source/test matrix so
  # an MCP spec never observes an ambient wrapper.
  :
fi

if [ "$stage2_slim_profile" -eq 1 ]; then
  : # slim stage-2 profile: the MCP behavior integration test needs the
    # skipped MCP build; skip entirely (no task row).
elif [ "$phase" != stage1 ] && [ "${compiler_cli_ready:-0}" -eq 1 ] && \
   [ "${test_runner_ready:-0}" -eq 1 ] && [ "${mcp_build_ready:-0}" -eq 1 ] && \
   [ -x "$compiler_cli" ] && [ -x "$test_runner" ] && [ -x "$mcp_server" ] && \
   [ -n "${command_owner_receipt:-}" ]; then
  if [ "$phase" = stage4 ]; then
    if [ -n "$stage4_tooling_receipt" ]; then
      run_matrix_task mcp_behavior --verification-command-owner-receipt="$command_owner_receipt" \
        --verification-stage4-tooling-receipt="$stage4_tooling_receipt" \
        env SIMPLE_LIB=src SIMPLE_BINARY="$compiler_cli" \
        SIMPLE_MCP_TEST_BINARY="$server_outputs/simple_mcp_server" "$test_runner" \
        test/02_integration/app/mcp_stdio_integration_spec.spl --mode=interpreter --unstable \
        --assert-ran --no-cache --no-db --no-session-daemon \
        "$test_mode_flag" ${test_worker_flag:+"$test_worker_flag"}
      run_matrix_task mcp_behavior_compile --verification-command-owner-receipt="$command_owner_receipt" \
        --verification-stage4-tooling-receipt="$stage4_tooling_receipt" \
        env SIMPLE_LIB=src SIMPLE_BINARY="$compiler_cli" \
        SIMPLE_MCP_TEST_BINARY="$server_outputs/simple_mcp_server" "$test_runner" \
        test/02_integration/app/mcp_stdio_integration_spec.spl --mode=compile --unstable \
        --assert-ran --no-cache --no-db --no-session-daemon \
        "$test_mode_flag" ${test_worker_flag:+"$test_worker_flag"}
    else
      record_unsupported_task mcp_behavior stage4-tooling-owners-not-built
      record_unsupported_task mcp_behavior_compile stage4-tooling-owners-not-built
    fi
  else
    run_matrix_task mcp_behavior --verification-command-owner-receipt="$command_owner_receipt" \
      env SIMPLE_LIB=src SIMPLE_BINARY="$compiler_cli" \
      SIMPLE_MCP_TEST_BINARY="$mcp_server" "$test_runner" \
      test/02_integration/app/mcp_stdio_integration_spec.spl --mode=interpreter --unstable \
      --assert-ran --no-cache --no-db --no-session-daemon \
      "$test_mode_flag" ${test_worker_flag:+"$test_worker_flag"}
    run_matrix_task mcp_behavior_compile --verification-command-owner-receipt="$command_owner_receipt" \
      env SIMPLE_LIB=src SIMPLE_BINARY="$compiler_cli" \
      SIMPLE_MCP_TEST_BINARY="$mcp_server" "$test_runner" \
      test/02_integration/app/mcp_stdio_integration_spec.spl --mode=compile --unstable \
      --assert-ran --no-cache --no-db --no-session-daemon \
      "$test_mode_flag" ${test_worker_flag:+"$test_worker_flag"}
  fi
else
  if [ "${compiler_cli_ready:-0}" -ne 1 ]; then
    behavior_owner_reason=full-cli-artifact-not-built
  elif [ "${test_runner_ready:-0}" -ne 1 ]; then
    behavior_owner_reason=test-runner-artifact-not-built
  elif [ "${mcp_build_ready:-0}" -ne 1 ]; then
    behavior_owner_reason=mcp-server-artifact-not-built
  else
    behavior_owner_reason=command-owner-receipt-not-built
  fi
  record_unsupported_task mcp_behavior "$behavior_owner_reason"
  record_unsupported_task mcp_behavior_compile "$behavior_owner_reason"
fi

if [ "$stage2_slim_profile" -ne 1 ]; then
  for tool in simple_mcp_server simple_lsp_mcp_server; do
    tool_path="$outputs/$tool"
    tool_ready=0
    if [ "$phase" != stage1 ]; then
      tool_path="$server_outputs/$tool"
    fi
    case "$tool" in
      simple_mcp_server) tool_ready=${mcp_build_ready:-0} ;;
      simple_lsp_mcp_server) tool_ready=${lsp_build_ready:-0} ;;
    esac
    if [ "$tool_ready" -eq 1 ] && [ -x "$tool_path" ]; then
      if [ "$phase" = stage4 ]; then
        if [ -n "$stage4_tooling_receipt" ]; then
          run_matrix_task "${tool}_help" \
            --verification-stage4-tooling-receipt="$stage4_tooling_receipt" "$tool_path" --help
        else
          record_unsupported_task "${tool}_help" stage4-tooling-owners-not-built
        fi
      else
        run_matrix_task "${tool}_help" "$tool_path" --help
      fi
    else
      printf 'task=%s_help|result=BLOCKED|status=not-built|elapsed_seconds=0|log=-\n' \
        "$tool" >>"$summary" || die "cannot append verification summary"
    fi
  done
fi

# Self-check the slim stage-2 profile's own guarantee instead of resting it
# solely on a caller's awk gate (bootstrap-from-scratch.sh's stage2-tests
# summary validator makes the same check today, but a verifier that can only
# be trusted correctly by ONE caller is not actually trustworthy). These are
# the five rows the slim profile exists to produce: proof that a compiler
# test binary was built (compiler_cli_build, test_runner_build) AND used
# (compiler_bootstrap_tests, interpreter_interpreter_tests,
# loader_interpreter_tests). A summary missing any of them, or carrying one
# that is not exactly PASS, checked nothing and must not report PASS.
if [ "$stage2_slim_profile" -eq 1 ]; then
  for stage2_slim_required_task in compiler_cli_build test_runner_build \
      compiler_bootstrap_tests interpreter_interpreter_tests loader_interpreter_tests; do
    if ! grep -q "^task=${stage2_slim_required_task}|result=PASS|" "$summary"; then
      printf 'bootstrap-phase-verification: slim stage-2 profile is missing a required PASS row for %s\n' \
        "$stage2_slim_required_task" >&2
      matrix_failed=1
    fi
  done
fi

summary_read_status=0
failures=$(grep -cE 'result=(FAIL|CRASH|TIMEOUT|BLOCKED|UNSUPPORTED|SKIPPED)' "$summary") || summary_read_status=$?
[ "$summary_read_status" -le 1 ] || die "cannot read verification summary"
echo "terminal_failures=$failures" >>"$summary" || die "cannot append verification summary"
echo "unsupported_tasks=$matrix_unsupported" >>"$summary" || die "cannot append verification summary"
# A rewritten/truncated evidence file cannot erase failures already observed
# by this process. Keep unsupported state separate from execution failures,
# so independent supported tasks still produce their normal evidence.
if [ "$failures" -eq 0 ] && [ "$matrix_failed" -eq 0 ] && [ "$matrix_unsupported" -eq 0 ]; then
  echo "overall=PASS" >>"$summary" || die "cannot append verification summary"
  exit 0
fi
echo "overall=FAIL" >>"$summary" || die "cannot append verification summary"
exit 1
