#!/bin/sh
# Run an admitted phase compiler's compiler/tool matrix without sharing mutable
# HOME, TMP, cache, or output state with the next canonical bootstrap phase.

set -u

die() {
  echo "bootstrap-phase-verification: $*" >&2
  exit 2
}

manifest_value() {
  key=$1
  file=$2
  sed -n "s/^${key}=//p" "$file" | head -n 1
}

hash_file() {
  sha256sum "$1" | awk '{print $1}'
}

phase=""
compiler=""
expected_sha=""
strategy=normal
hash_policy=canonical
work_root=""
cache_root=""
source_root=$(pwd -P)
timeout_seconds=${BOOTSTRAP_VERIFY_TIMEOUT_SECONDS:-1800}
spec_timeout_seconds=${BOOTSTRAP_VERIFY_SPEC_TIMEOUT_SECONDS:-120}

for arg in "$@"; do
  case "$arg" in
    --phase=*) phase=${arg#*=} ;;
    --compiler=*) compiler=${arg#*=} ;;
    --compiler-sha256=*) expected_sha=${arg#*=} ;;
    --strategy=*) strategy=${arg#*=} ;;
    --hash-policy=*) hash_policy=${arg#*=} ;;
    --work-root=*) work_root=${arg#*=} ;;
    --cache-root=*) cache_root=${arg#*=} ;;
    --source-root=*) source_root=${arg#*=} ;;
    --timeout-seconds=*) timeout_seconds=${arg#*=} ;;
    *) die "unknown option: $arg" ;;
  esac
done

case "$phase" in stage1|stage2|stage3|stage4) ;; *) die "invalid phase" ;; esac
case "$strategy" in normal|full) ;; *) die "verification requires normal or full" ;; esac
case "$hash_policy" in canonical|temporary) ;; *) die "invalid hash policy" ;; esac
case "$timeout_seconds" in ''|*[!0-9]*|0) die "timeout must be a positive integer" ;; esac
case "$spec_timeout_seconds" in ''|*[!0-9]*|0) die "spec timeout must be a positive integer" ;; esac
[ -n "$compiler" ] && [ -x "$compiler" ] || die "compiler is not executable: $compiler"
[ -n "$expected_sha" ] || die "compiler SHA-256 is required"
[ -n "$work_root" ] || die "work root is required"
[ -d "$source_root" ] || die "source root is not a directory"

mkdir -p "$work_root" || die "cannot create work root"
work_root=$(cd "$work_root" && pwd -P)
source_root=$(cd "$source_root" && pwd -P)
if [ -z "$cache_root" ]; then
  cache_root="$work_root/cache"
fi
mkdir -p "$cache_root" || die "cannot create cache root"
cache_root=$(cd "$cache_root" && pwd -P)
home="$work_root/home"
tmp="$work_root/tmp"
cache="$cache_root"
outputs="$work_root/outputs"
logs="$work_root/logs"
summary="$work_root/summary.env"
mkdir -p "$home" "$tmp" "$cache" "$outputs" "$logs" || die "cannot isolate verification state"

# Copy only an already-admitted compiler. The before/copy/after hashes make a
# concurrent publish or accidental mutation a terminal admission failure.
source_before=$(hash_file "$compiler") || die "cannot hash compiler"
cp "$compiler" "$work_root/compiler.snapshot" || die "cannot snapshot compiler"
chmod +x "$work_root/compiler.snapshot"
source_after=$(hash_file "$compiler") || die "cannot re-hash compiler"
snapshot_sha=$(hash_file "$work_root/compiler.snapshot") || die "cannot hash compiler snapshot"
hash_status=PASS
if [ "$source_before" != "$source_after" ] || [ "$snapshot_sha" != "$expected_sha" ]; then
  if [ "$hash_policy" = canonical ]; then
    die "canonical compiler hash mismatch"
  fi
  hash_status=WARN
fi
compiler_snapshot="$work_root/compiler.snapshot"

: >"$summary"
{
  echo "schema=bootstrap-phase-verification-v1"
  echo "phase=$phase"
  echo "strategy=$strategy"
  echo "hash_policy=$hash_policy"
  echo "expected_compiler_sha256=$expected_sha"
  echo "actual_compiler_sha256=$snapshot_sha"
  echo "compiler_hash_status=$hash_status"
} >>"$summary"

run_with_timeout() {
  "$source_root/scripts/bootstrap/run-process-group-timeout.shs" \
    "$timeout_seconds" 15 "$@"
}

run_task() {
  task=$1
  shift
  log="$logs/$task.log"
  started=$(date +%s)
  status=0
  (
    cd "$source_root" || exit 125
    HOME="$home" TMPDIR="$tmp" SIMPLE_NO_STUB_FALLBACK=1 \
      SIMPLE_NATIVE_BUILD_CACHE_DIR="$cache/$task" \
      run_with_timeout "$@"
  ) >"$log" 2>&1 || status=$?
  # Tool help is an executable ABI sanity probe, not merely an exit-code
  # check. Native runtimes deliberately fail closed on invalid handles but may
  # return control to the program so diagnostics remain inspectable. Do not
  # admit that rc=0 as a healthy built artifact.
  case "$task" in
    *_help)
      if grep -Eq '\[simple-runtime\]\[error\].*(invalid array handle|compiler/FFI ABI mismatch)|probable compiler/FFI ABI mismatch' "$log"; then
        status=86
      fi
      ;;
  esac
  ended=$(date +%s)
  result=PASS
  case "$status" in
    0) result=PASS ;;
    124|137) result=TIMEOUT ;;
    134|136|139) result=CRASH ;;
    *) result=FAIL ;;
  esac
  printf 'task=%s|result=%s|status=%s|elapsed_seconds=%s|log=%s\n' \
    "$task" "$result" "$status" "$((ended - started))" "$log" >>"$summary"
  [ "$status" -eq 0 ]
}

matrix_failed=0
run_matrix_task() {
  task=$1
  shift
  if [ "$strategy" = normal ] && [ "$matrix_failed" -ne 0 ]; then
    printf 'task=%s|result=BLOCKED|status=blocked-upstream|elapsed_seconds=0|log=-\n' \
      "$task" >>"$summary"
    return 0
  fi
  if ! run_task "$task" "$@"; then
    matrix_failed=1
  fi
  return 0
}

record_unsupported_task() {
  task=$1
  reason=$2
  printf 'task=%s|result=UNSUPPORTED|status=%s|elapsed_seconds=0|log=-\n' \
    "$task" "$reason" >>"$summary"
}

# A compiler unit tree is much larger than one matrix-row timeout. Materialize
# its complete, stable list first and contain every spec independently so one
# timeout cannot discard the remaining inventory or suppress terminal receipts.
run_compiler_unit_tests() {
  task=compiler_unit_tests
  log="$logs/$task.log"
  inventory="$logs/${task}.inventory.tsv"
  manifest="$tmp/${task}.manifest"
  find "$source_root/test/01_unit/compiler" -type f -name '*_spec.spl' -print | LC_ALL=C sort >"$manifest"
  : >"$log"
  printf 'spec\tresult\tstatus\n' >"$inventory"
  started=$(date +%s)
  failed=0
  while IFS= read -r spec; do
    relative=${spec#"$source_root/"}
    printf 'BEGIN %s\n' "$relative" >>"$log"
    status=0
    (
      cd "$source_root" || exit 125
      HOME="$home" TMPDIR="$tmp" SIMPLE_NO_STUB_FALLBACK=1 \
        SIMPLE_NATIVE_BUILD_CACHE_DIR="$cache/$task" \
        "$source_root/scripts/bootstrap/run-process-group-timeout.shs" \
          "$spec_timeout_seconds" 15 "$compiler_snapshot" test "$relative" --mode=interpreter
    ) >>"$log" 2>&1 || status=$?
    result=FAIL
    case "$status" in
      0) result=PASS ;;
      124|137) result=TIMEOUT ;;
      134|136|139) result=CRASH ;;
    esac
    printf '%s\t%s\t%s\n' "$relative" "$result" "$status" >>"$inventory"
    printf 'END %s result=%s status=%s\n' "$relative" "$result" "$status" >>"$log"
    [ "$status" -eq 0 ] || failed=1
  done <"$manifest"
  ended=$(date +%s)
  result=PASS
  [ "$failed" -eq 0 ] || result=FAIL
  printf 'task=%s|result=%s|status=%s|elapsed_seconds=%s|log=%s|inventory=%s\n' \
    "$task" "$result" "$failed" "$((ended - started))" "$log" "$inventory" >>"$summary"
  [ "$failed" -eq 0 ]
}

# Normal is fail-fast within a phase-local matrix; the already-running next
# compiler phase remains independent. Full terminalizes each row and continues
# all later independent tasks.
run_matrix_task compiler_version "$compiler_snapshot" --version
if [ "$phase" = stage1 ]; then
  # Stage 1 is the Rust bootstrap seed. It accepts `check`/`test`, but its own
  # authority banner forbids use as the normal tool; applying its older
  # semantic surface to the current pure-Simple tree produced identical
  # source-looking failures for every unrelated directory. Record the missing
  # capability explicitly instead of claiming either coverage or regressions.
  record_unsupported_task compiler_check bootstrap-seed-not-qualified-for-source-check
  record_unsupported_task compiler_bootstrap_tests bootstrap-seed-not-qualified-for-source-test
  record_unsupported_task mcp_check bootstrap-seed-not-qualified-for-source-check
  record_unsupported_task lsp_check bootstrap-seed-not-qualified-for-source-check
  if [ "$strategy" = full ]; then
    record_unsupported_task library_check bootstrap-seed-not-qualified-for-source-check
    record_unsupported_task compiler_unit_tests bootstrap-seed-not-qualified-for-source-test
  fi
else
  run_matrix_task compiler_check "$compiler_snapshot" check src/compiler
  run_matrix_task compiler_bootstrap_tests "$compiler_snapshot" test test/01_unit/compiler/bootstrap --mode=interpreter
  run_matrix_task mcp_check "$compiler_snapshot" check src/app/mcp
  run_matrix_task lsp_check "$compiler_snapshot" check src/app/simple_lsp_mcp

  if [ "$strategy" = full ]; then
    run_matrix_task library_check "$compiler_snapshot" check src/lib
    if ! run_compiler_unit_tests; then
      matrix_failed=1
    fi
  fi
fi

run_matrix_task mcp_build "$compiler_snapshot" native-build \
  --source src/compiler --source src/app --source src/lib --entry-closure \
  --entry src/app/mcp/main.spl --threads 1 --cache-dir "$cache/tool_builds" \
  --output "$outputs/simple_mcp_server"
run_matrix_task lsp_build "$compiler_snapshot" native-build \
  --source src/compiler --source src/app --source src/lib --entry-closure \
  --entry src/app/simple_lsp_mcp/main.spl --threads 1 --cache-dir "$cache/tool_builds" \
  --output "$outputs/simple_lsp_mcp_server"
run_matrix_task mcp_behavior env SIMPLE_LIB=src "$compiler_snapshot" test \
  test/02_integration/app/mcp_stdio_integration_spec.spl --mode=interpreter

for tool in simple_mcp_server simple_lsp_mcp_server; do
  if [ -x "$outputs/$tool" ]; then
    run_matrix_task "${tool}_help" "$outputs/$tool" --help
  else
    printf 'task=%s_help|result=BLOCKED|status=not-built|elapsed_seconds=0|log=-\n' \
      "$tool" >>"$summary"
  fi
done

failures=$(grep -cE 'result=(FAIL|CRASH|TIMEOUT|BLOCKED|UNSUPPORTED)' "$summary" || :)
echo "terminal_failures=$failures" >>"$summary"
if [ "$failures" -eq 0 ]; then
  echo "overall=PASS" >>"$summary"
  exit 0
fi
echo "overall=FAIL" >>"$summary"
exit 1
