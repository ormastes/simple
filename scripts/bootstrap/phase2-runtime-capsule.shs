#!/bin/sh
# Publish or verify a SHA-addressed Phase2 compiler + hosted-runtime capsule.
set -eu

die() { echo "phase2-runtime-capsule: $*" >&2; exit 2; }
hash_file() { sha256sum "$1" | awk '{print $1}'; }
value() { sed -n "s/^$1=//p" "$2" | head -n 1; }
require_unique_keys() {
  file=$1; shift
  for key in "$@"; do
    [ "$(awk -F= -v wanted="$key" '$1 == wanted { count++ } END { print count + 0 }' "$file")" = 1 ] || return 1
  done
}

verify_capsule() {
  capsule=$1
  expected_basename=${2:-}
  receipt="$capsule/phase2-runtime-capsule.env"
  [ -d "$capsule" ] && [ ! -L "$capsule" ] || return 1
  [ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
  require_unique_keys "$receipt" schema status compiler_sha256 native_all_sha256 \
    hosted_authority_receipt_sha256 seed_authority_stamp_sha256 \
    capsule_identity_sha256 source_authority_path || return 1
  [ "$(value schema "$receipt")" = simple-phase2-runtime-capsule-v1 ] || return 1
  [ "$(value status "$receipt")" = frozen ] || return 1
  compiler_sha=$(value compiler_sha256 "$receipt")
  native_sha=$(value native_all_sha256 "$receipt")
  hosted_receipt_sha=$(value hosted_authority_receipt_sha256 "$receipt")
  case "$compiler_sha$native_sha$hosted_receipt_sha" in *[!0-9a-f]*|'') return 1 ;; esac
  [ ${#compiler_sha} -eq 64 ] && [ ${#native_sha} -eq 64 ] && [ ${#hosted_receipt_sha} -eq 64 ] || return 1
  [ "${expected_basename:-$(basename "$capsule")}" = "$compiler_sha" ] || return 1
  [ -n "$expected_basename" ] || [ "$(basename "$capsule")" = "$compiler_sha" ] || return 1
  [ -x "$capsule/simple" ] && [ ! -L "$capsule/simple" ] || return 1
  [ -f "$capsule/libsimple_native_all.a" ] && [ ! -L "$capsule/libsimple_native_all.a" ] || return 1
  [ -f "$capsule/hosted-runtime.env" ] && [ ! -L "$capsule/hosted-runtime.env" ] || return 1
  [ "$(hash_file "$capsule/simple")" = "$compiler_sha" ] || return 1
  [ "$(hash_file "$capsule/libsimple_native_all.a")" = "$native_sha" ] || return 1
  [ "$(hash_file "$capsule/hosted-runtime.env")" = "$hosted_receipt_sha" ] || return 1
  stamp="$capsule/simple.inputs.sha256"
  [ -f "$stamp" ] && [ ! -L "$stamp" ] || return 1
  require_unique_keys "$stamp" schema inputs_fingerprint seed_sha256 \
    native_all_sha256 backfill_status backfill_sha256 || return 1
  [ "$(value schema "$stamp")" = simple-bootstrap-seed-artifact-stamp-v2 ] || return 1
  [ "$(value native_all_sha256 "$stamp")" = "$native_sha" ] || return 1
  [ "$(hash_file "$stamp")" = "$(value seed_authority_stamp_sha256 "$receipt")" ] || return 1
  backfill_status=$(value backfill_status "$stamp")
  backfill_sha=$(value backfill_sha256 "$stamp")
  case "$backfill_status" in
    present)
      [ -f "$capsule/libsimple_compiler_backfill.a" ] && [ ! -L "$capsule/libsimple_compiler_backfill.a" ] || return 1
      [ "$(hash_file "$capsule/libsimple_compiler_backfill.a")" = "$backfill_sha" ] || return 1 ;;
    absent) [ "$backfill_sha" = absent ] && [ ! -e "$capsule/libsimple_compiler_backfill.a" ] || return 1 ;;
    *) return 1 ;;
  esac
  hosted_relative=$(value relative_path "$capsule/hosted-runtime.env")
  hosted_sha=$(value sha256 "$capsule/hosted-runtime.env")
  require_unique_keys "$capsule/hosted-runtime.env" schema status relative_path sha256 || return 1
  [ "$(value schema "$capsule/hosted-runtime.env")" = simple-bootstrap-hosted-runtime-authority-v1 ] || return 1
  [ "$(value status "$capsule/hosted-runtime.env")" = frozen ] || return 1
  case "$hosted_relative" in deps/libspl_hosted_runtime-*.rlib) ;; *) return 1 ;; esac
  [ -f "$capsule/$hosted_relative" ] && [ ! -L "$capsule/$hosted_relative" ] || return 1
  [ "$(hash_file "$capsule/$hosted_relative")" = "$hosted_sha" ] || return 1
  [ "$(find "$capsule/deps" -maxdepth 1 -type f -name 'libspl_hosted_runtime-*.rlib' | wc -l | tr -d ' ')" = 1 ] || return 1
  aggregate=$(printf '%s\n' "$compiler_sha" "$native_sha" "$hosted_receipt_sha" "$(value seed_authority_stamp_sha256 "$receipt")" "$backfill_sha" | sha256sum | awk '{print $1}')
  [ "$(value capsule_identity_sha256 "$receipt")" = "$aggregate" ] || return 1
  # `-perm /MODE` (any of these bits) is a GNU findutils extension. BSD find,
  # which is what /bin/sh gets on macOS, rejects it with
  # "find: -perm: /0222: illegal mode string" on STDERR and prints nothing on
  # stdout -- so the `[ -z ... ]` below saw an empty string and reported the
  # capsule immutable no matter how writable it actually was. That is fail-OPEN
  # in an immutability check. POSIX `-perm -MODE` (all of these bits) is honoured
  # by both implementations; OR the three single-bit tests to recover "any".
  [ -z "$(find "$capsule" \( -perm -0200 -o -perm -0020 -o -perm -0002 \) -print -quit)" ] || return 1
}

case ${1:-} in
  verify)
    [ $# -eq 2 ] || die 'usage: phase2-runtime-capsule.shs verify CAPSULE'
    verify_capsule "$2" || die 'capsule verification failed'
    ;;
  publish)
    [ $# -eq 4 ] || die 'usage: phase2-runtime-capsule.shs publish COMPILER AUTHORITY OUTPUT_ROOT'
    compiler=$2; authority=$3; output_root=$4
    [ -x "$compiler" ] && [ ! -L "$compiler" ] || die 'invalid compiler'
    [ -d "$authority" ] && [ ! -L "$authority" ] || die 'invalid authority'
    for file in libsimple_native_all.a hosted-runtime.env simple.inputs.sha256; do
      [ -f "$authority/$file" ] && [ ! -L "$authority/$file" ] || die "missing authority file: $file"
    done
    native_sha=$(hash_file "$authority/libsimple_native_all.a")
    [ "$(value native_all_sha256 "$authority/simple.inputs.sha256")" = "$native_sha" ] || die 'stale native_all authority stamp'
    compiler_sha=$(hash_file "$compiler")
    destination="$output_root/$compiler_sha"
    mkdir -p "$output_root"
    lock="$output_root/.${compiler_sha}.publish-lock"
    mkdir "$lock" 2>/dev/null || die 'capsule publication already active'
    staging="$output_root/.${compiler_sha}.tmp.$$"
    trap 'chmod -R u+w "$staging" 2>/dev/null || true; rm -rf "$staging" "$lock"' EXIT HUP INT TERM
    [ ! -e "$destination" ] && [ ! -L "$destination" ] || die 'refusing to overwrite capsule'
    mkdir -p "$staging/deps"
    cp "$compiler" "$staging/simple"
    cp "$authority/libsimple_native_all.a" "$staging/"
    cp "$authority/hosted-runtime.env" "$authority/simple.inputs.sha256" "$staging/"
    [ ! -f "$authority/libsimple_compiler_backfill.a" ] || cp "$authority/libsimple_compiler_backfill.a" "$staging/"
    hosted_relative=$(value relative_path "$authority/hosted-runtime.env")
    case "$hosted_relative" in deps/libspl_hosted_runtime-*.rlib) ;; *) die 'invalid hosted authority path' ;; esac
    cp "$authority/$hosted_relative" "$staging/$hosted_relative"
    hosted_receipt_sha=$(hash_file "$authority/hosted-runtime.env")
    stamp_sha=$(hash_file "$authority/simple.inputs.sha256")
    backfill_sha=$(value backfill_sha256 "$authority/simple.inputs.sha256")
    aggregate=$(printf '%s\n' "$compiler_sha" "$native_sha" "$hosted_receipt_sha" "$stamp_sha" "$backfill_sha" | sha256sum | awk '{print $1}')
    {
      echo schema=simple-phase2-runtime-capsule-v1
      echo status=frozen
      echo compiler_sha256="$compiler_sha"
      echo native_all_sha256="$native_sha"
      echo hosted_authority_receipt_sha256="$hosted_receipt_sha"
      echo seed_authority_stamp_sha256="$stamp_sha"
      echo capsule_identity_sha256="$aggregate"
      echo source_authority_path="$(CDPATH= cd -- "$authority" && pwd -P)"
    } >"$staging/phase2-runtime-capsule.env"
    chmod 500 "$staging" "$staging/deps"
    chmod 500 "$staging/simple"
    find "$staging" -type f ! -name simple -exec chmod 400 {} +
    verify_capsule "$staging" "$compiler_sha" || die 'staged capsule verification failed'
    mv "$staging" "$destination"
    rmdir "$lock"
    trap - EXIT HUP INT TERM
    echo "$destination"
    ;;
  *) die 'expected publish or verify' ;;
esac
