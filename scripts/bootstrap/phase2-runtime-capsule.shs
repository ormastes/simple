#!/bin/sh
# Publish or verify a SHA-addressed Phase2 compiler + hosted-runtime capsule.
set -eu
tool_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
windows_host=0
case $(uname -s) in MINGW*|MSYS*|CYGWIN*) windows_host=1 ;; esac

die() { echo "phase2-runtime-capsule: $*" >&2; exit 2; }
hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  else shasum -a 256 "$1" | awk '{print $1}'
  fi
}
hash_lines() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'
  else shasum -a 256 | awk '{print $1}'
  fi
}
value() { sed -n "s/^$1=//p" "$2" | head -n 1; }
require_unique_keys() {
  file=$1; shift
  for key in "$@"; do
    [ "$(awk -F= -v wanted="$key" '$1 == wanted { count++ } END { print count + 0 }' "$file")" = 1 ] || return 1
  done
}

layout_files() {
  layout=$1
  case "$layout" in
    posix) compiler_file=simple; native_file=libsimple_native_all.a
      stamp_file=simple.inputs.sha256; backfill_file=libsimple_compiler_backfill.a ;;
    windows-msvc) compiler_file=simple.exe; native_file=simple_native_all.lib
      stamp_file=simple.exe.inputs.sha256; backfill_file=simple_compiler_backfill.lib ;;
    *) return 1 ;;
  esac
}

windows_permissions() {
  powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass \
    -File "$(cygpath -w "$tool_dir/phase2-capsule-permissions.ps1")" \
    -Action "$1" -Path "$(cygpath -w "$2")"
}

capsule_identity() {
  {
    [ "$capsule_schema" = simple-phase2-runtime-capsule-v1 ] || printf '%s\n' "$layout"
    printf '%s\n' "$compiler_sha" "$native_sha" "$hosted_receipt_sha" "$stamp_sha" "$backfill_sha"
    [ -z "${dynamic_sha:-}" ] || printf '%s\n' "$dynamic_sha"
    [ -z "${cocoa_sha:-}" ] || printf '%s\n' "$cocoa_sha" "$cocoa_receipt_sha" unavailable not-established
  } | hash_lines
}

# A diagnostic producer is an inert candidate, never Darwin load authority.
# Keep both bytes and provenance together until an exact mapped-byte and
# dependency admission mechanism exists. No pathname from this receipt is used.
verify_cocoa_candidate() {
  cocoa_root=$1
  cocoa_receipt="$cocoa_root/libspl_cocoa.producer.txt"
  [ -f "$cocoa_root/libspl_cocoa.dylib" ] && [ ! -L "$cocoa_root/libspl_cocoa.dylib" ] || return 1
  [ -f "$cocoa_receipt" ] && [ ! -L "$cocoa_receipt" ] || return 1
  require_unique_keys "$cocoa_receipt" kind admission artifact abi artifact_sha256 dependency_admission || return 1
  [ "$(value kind "$cocoa_receipt")" = diagnostic-producer-receipt ] || return 1
  [ "$(value admission "$cocoa_receipt")" = not-established ] || return 1
  [ "$(value artifact "$cocoa_receipt")" = libspl_cocoa.dylib ] || return 1
  [ "$(value abi "$cocoa_receipt")" = legacy-cocoa-raw-title-v1 ] || return 1
  [ "$(value artifact_sha256 "$cocoa_receipt")" = "$(hash_file "$cocoa_root/libspl_cocoa.dylib")" ] || return 1
  [ "$(value dependency_admission "$cocoa_receipt")" = not-established ] || return 1
}

verify_capsule() {
  capsule=$1
  expected_basename=${2:-}
  receipt="$capsule/phase2-runtime-capsule.env"
  [ -d "$capsule" ] && [ ! -L "$capsule" ] || return 1
  [ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
  require_unique_keys "$receipt" schema status compiler_sha256 native_all_sha256 \
    hosted_authority_receipt_sha256 seed_authority_stamp_sha256 \
    capsule_identity_sha256 source_authority_path || return 1
  capsule_schema=$(value schema "$receipt")
  case "$capsule_schema" in
    simple-phase2-runtime-capsule-v1)
      [ "$(awk -F= '$1 == "artifact_layout" { count++ } END { print count + 0 }' "$receipt")" = 0 ] || return 1
      layout_files posix ;;
    simple-phase2-runtime-capsule-v2)
      require_unique_keys "$receipt" artifact_layout || return 1
      layout_files "$(value artifact_layout "$receipt")" || return 1 ;;
    *) return 1 ;;
  esac
  [ "$(value status "$receipt")" = frozen ] || return 1
  compiler_sha=$(value compiler_sha256 "$receipt")
  native_sha=$(value native_all_sha256 "$receipt")
  hosted_receipt_sha=$(value hosted_authority_receipt_sha256 "$receipt")
  case "$compiler_sha$native_sha$hosted_receipt_sha" in *[!0-9a-f]*|'') return 1 ;; esac
  [ ${#compiler_sha} -eq 64 ] && [ ${#native_sha} -eq 64 ] && [ ${#hosted_receipt_sha} -eq 64 ] || return 1
  [ "${expected_basename:-$(basename "$capsule")}" = "$compiler_sha" ] || return 1
  [ -n "$expected_basename" ] || [ "$(basename "$capsule")" = "$compiler_sha" ] || return 1
  [ -x "$capsule/$compiler_file" ] && [ ! -L "$capsule/$compiler_file" ] || return 1
  [ -f "$capsule/$native_file" ] && [ ! -L "$capsule/$native_file" ] || return 1
  [ -f "$capsule/hosted-runtime.env" ] && [ ! -L "$capsule/hosted-runtime.env" ] || return 1
  [ "$(hash_file "$capsule/$compiler_file")" = "$compiler_sha" ] || return 1
  [ "$(hash_file "$capsule/$native_file")" = "$native_sha" ] || return 1
  [ "$(hash_file "$capsule/hosted-runtime.env")" = "$hosted_receipt_sha" ] || return 1
  stamp="$capsule/$stamp_file"
  [ -f "$stamp" ] && [ ! -L "$stamp" ] || return 1
  require_unique_keys "$stamp" schema inputs_fingerprint seed_sha256 \
    native_all_sha256 backfill_status backfill_sha256 || return 1
  [ "$(value schema "$stamp")" = simple-bootstrap-seed-artifact-stamp-v2 ] || return 1
  [ "$(value native_all_sha256 "$stamp")" = "$native_sha" ] || return 1
  [ "$(hash_file "$stamp")" = "$(value seed_authority_stamp_sha256 "$receipt")" ] || return 1
  backfill_status=$(value backfill_status "$stamp")
  backfill_sha=$(value backfill_sha256 "$stamp")
  case "$backfill_status" in
    present)
      [ -f "$capsule/$backfill_file" ] && [ ! -L "$capsule/$backfill_file" ] || return 1
      [ "$(hash_file "$capsule/$backfill_file")" = "$backfill_sha" ] || return 1 ;;
    absent) [ "$backfill_sha" = absent ] && [ ! -e "$capsule/$backfill_file" ] || return 1 ;;
    *) return 1 ;;
  esac
  hosted_relative=$(value relative_path "$capsule/hosted-runtime.env")
  hosted_sha=$(value sha256 "$capsule/hosted-runtime.env")
  require_unique_keys "$capsule/hosted-runtime.env" schema status relative_path sha256 || return 1
  [ "$(value schema "$capsule/hosted-runtime.env")" = simple-bootstrap-hosted-runtime-authority-v1 ] || return 1
  [ "$(value status "$capsule/hosted-runtime.env")" = frozen ] || return 1
  case "$hosted_relative" in deps/libspl_hosted_runtime-*.rlib) ;; *) return 1 ;; esac
  case "${hosted_relative#deps/}" in *[!A-Za-z0-9_.-]*) return 1 ;; esac
  [ -d "$capsule/deps" ] && [ ! -L "$capsule/deps" ] || return 1
  [ -f "$capsule/$hosted_relative" ] && [ ! -L "$capsule/$hosted_relative" ] || return 1
  [ "$(hash_file "$capsule/$hosted_relative")" = "$hosted_sha" ] || return 1
  [ "$(find "$capsule/deps" -maxdepth 1 -type f -name 'libspl_hosted_runtime-*.rlib' | wc -l | tr -d ' ')" = 1 ] || return 1
  dynamic_sha=$(value dynamic_runtime_sha256 "$receipt")
  if grep -q '^dynamic_runtime_sha256=' "$receipt"; then
    require_unique_keys "$receipt" dynamic_runtime_sha256 || return 1
    [ -n "$dynamic_sha" ] || return 1
  fi
  case "$dynamic_sha" in
    ''|absent) [ ! -e "$capsule/libsimple_runtime.dylib" ] && [ ! -L "$capsule/libsimple_runtime.dylib" ] || return 1 ;;
    *)
      case "$dynamic_sha" in *[!0-9a-f]*) return 1 ;; esac
      [ "${#dynamic_sha}" = 64 ] || return 1
      [ -f "$capsule/libsimple_runtime.dylib" ] && [ ! -L "$capsule/libsimple_runtime.dylib" ] || return 1
      [ "$(hash_file "$capsule/libsimple_runtime.dylib")" = "$dynamic_sha" ] || return 1 ;;
  esac
  cocoa_sha=$(value cocoa_candidate_sha256 "$receipt")
  cocoa_receipt_sha=$(value cocoa_producer_receipt_sha256 "$receipt")
  if grep -q '^cocoa_' "$receipt"; then
    require_unique_keys "$receipt" cocoa_candidate_sha256 cocoa_producer_receipt_sha256 \
      cocoa_admission cocoa_dependency_admission || return 1
    [ "$(value cocoa_admission "$receipt")" = unavailable ] || return 1
    [ "$(value cocoa_dependency_admission "$receipt")" = not-established ] || return 1
    [ -n "$cocoa_sha" ] && [ -n "$cocoa_receipt_sha" ] || return 1
  fi
  case "$cocoa_sha" in
    ''|absent)
      [ "$cocoa_receipt_sha" = "$cocoa_sha" ] || return 1
      [ ! -e "$capsule/libspl_cocoa.dylib" ] && [ ! -L "$capsule/libspl_cocoa.dylib" ] || return 1
      [ ! -e "$capsule/libspl_cocoa.producer.txt" ] && [ ! -L "$capsule/libspl_cocoa.producer.txt" ] || return 1 ;;
    *)
      case "$cocoa_sha$cocoa_receipt_sha" in *[!0-9a-f]*) return 1 ;; esac
      [ "${#cocoa_sha}" = 64 ] && [ "${#cocoa_receipt_sha}" = 64 ] || return 1
      verify_cocoa_candidate "$capsule" || return 1
      [ "$(hash_file "$capsule/libspl_cocoa.dylib")" = "$cocoa_sha" ] || return 1
      [ "$(hash_file "$capsule/libspl_cocoa.producer.txt")" = "$cocoa_receipt_sha" ] || return 1 ;;
  esac
  stamp_sha=$(hash_file "$stamp")
  aggregate=$(capsule_identity)
  [ "$(value capsule_identity_sha256 "$receipt")" = "$aggregate" ] || return 1
  # `-perm /MODE` (any of these bits) is a GNU findutils extension. BSD find,
  # which is what /bin/sh gets on macOS, rejects it with
  # "find: -perm: /0222: illegal mode string" on STDERR and prints nothing on
  # stdout -- so the `[ -z ... ]` below saw an empty string and reported the
  # capsule immutable no matter how writable it actually was. That is fail-OPEN
  # in an immutability check. POSIX `-perm -MODE` (all of these bits) is honoured
  # by both implementations; OR the three single-bit tests to recover "any".
  if [ "$windows_host" = 1 ]; then
    windows_permissions verify "$capsule" || return 1
  else
    writable_entries=$(find "$capsule" \( -perm -0200 -o -perm -0020 -o -perm -0002 \) -print -quit) || return 1
    [ -z "$writable_entries" ] || return 1
  fi
}

case ${1:-} in
  verify)
    [ $# -eq 2 ] || die 'usage: phase2-runtime-capsule.shs verify CAPSULE'
    verify_capsule "$2" || die 'capsule verification failed'
    ;;
  publish)
    [ $# -eq 4 ] || die 'usage: phase2-runtime-capsule.shs publish COMPILER AUTHORITY OUTPUT_ROOT'
    compiler=$2; authority=$3; output_root=$4
    [ -x "$compiler" ] && [ ! -L "$compiler" ] || die 'invalid compiler'
    [ -d "$authority" ] && [ ! -L "$authority" ] || die 'invalid authority'
    if [ -e "$authority/simple_native_all.lib" ]; then
      [ ! -e "$authority/libsimple_native_all.a" ] || die 'ambiguous authority layout'
      layout_files windows-msvc
    else
      layout_files posix
    fi
    for file in "$native_file" hosted-runtime.env "$stamp_file"; do
      [ -f "$authority/$file" ] && [ ! -L "$authority/$file" ] || die "missing authority file: $file"
    done
    native_sha=$(hash_file "$authority/$native_file")
    [ "$(value native_all_sha256 "$authority/$stamp_file")" = "$native_sha" ] || die 'stale native_all authority stamp'
    compiler_sha=$(hash_file "$compiler")
    destination="$output_root/$compiler_sha"
    mkdir -p "$output_root"
    lock="$output_root/.${compiler_sha}.publish-lock"
    mkdir "$lock" 2>/dev/null || die 'capsule publication already active'
    staging="$output_root/.${compiler_sha}.tmp.$$"
    trap 'if [ "$windows_host" = 1 ] && [ -d "$staging" ]; then windows_permissions thaw "$staging" 2>/dev/null || true; fi; chmod -R u+w "$staging" 2>/dev/null || true; rm -rf "$staging" "$lock"' EXIT HUP INT TERM
    [ ! -e "$destination" ] && [ ! -L "$destination" ] || die 'refusing to overwrite capsule'
    mkdir -p "$staging/deps"
    cp "$compiler" "$staging/$compiler_file"
    cp "$authority/$native_file" "$staging/"
    cp "$authority/hosted-runtime.env" "$authority/$stamp_file" "$staging/"
    [ ! -L "$authority/$backfill_file" ] || die 'symlink backfill authority'
    [ ! -f "$authority/$backfill_file" ] || cp "$authority/$backfill_file" "$staging/"
    hosted_relative=$(value relative_path "$authority/hosted-runtime.env")
    case "$hosted_relative" in deps/libspl_hosted_runtime-*.rlib) ;; *) die 'invalid hosted authority path' ;; esac
    case "${hosted_relative#deps/}" in *[!A-Za-z0-9_.-]*) die 'invalid hosted authority leaf' ;; esac
    [ ! -L "$authority/deps" ] && [ ! -L "$authority/$hosted_relative" ] || die 'symlink hosted authority'
    cp "$authority/$hosted_relative" "$staging/$hosted_relative"
    dynamic_sha=absent
    if [ -e "$authority/libsimple_runtime.dylib" ] || [ -L "$authority/libsimple_runtime.dylib" ]; then
      [ -f "$authority/libsimple_runtime.dylib" ] && [ ! -L "$authority/libsimple_runtime.dylib" ] || die 'unsafe dynamic runtime'
      dynamic_sha=$(hash_file "$authority/libsimple_runtime.dylib")
      cp "$authority/libsimple_runtime.dylib" "$staging/libsimple_runtime.dylib"
      [ "$(hash_file "$authority/libsimple_runtime.dylib")" = "$dynamic_sha" ] || die 'dynamic runtime changed during publication'
      [ "$(hash_file "$staging/libsimple_runtime.dylib")" = "$dynamic_sha" ] || die 'dynamic runtime copy hash mismatch'
    fi
    cocoa_sha=absent
    cocoa_receipt_sha=absent
    if [ -e "$authority/libspl_cocoa.dylib" ] || [ -L "$authority/libspl_cocoa.dylib" ] || \
       [ -e "$authority/libspl_cocoa.producer.txt" ] || [ -L "$authority/libspl_cocoa.producer.txt" ]; then
      verify_cocoa_candidate "$authority" || die 'invalid diagnostic Cocoa candidate'
      cocoa_sha=$(hash_file "$authority/libspl_cocoa.dylib")
      cocoa_receipt_sha=$(hash_file "$authority/libspl_cocoa.producer.txt")
      cp "$authority/libspl_cocoa.dylib" "$authority/libspl_cocoa.producer.txt" "$staging/"
      [ "$(hash_file "$authority/libspl_cocoa.dylib")" = "$cocoa_sha" ] && \
        [ "$(hash_file "$authority/libspl_cocoa.producer.txt")" = "$cocoa_receipt_sha" ] || die 'Cocoa candidate changed during publication'
      [ "$(hash_file "$staging/libspl_cocoa.dylib")" = "$cocoa_sha" ] && \
        [ "$(hash_file "$staging/libspl_cocoa.producer.txt")" = "$cocoa_receipt_sha" ] || die 'Cocoa candidate copy mismatch'
    fi
    hosted_receipt_sha=$(hash_file "$authority/hosted-runtime.env")
    stamp_sha=$(hash_file "$authority/$stamp_file")
    backfill_sha=$(value backfill_sha256 "$authority/$stamp_file")
    capsule_schema=simple-phase2-runtime-capsule-v2
    aggregate=$(capsule_identity)
    {
      echo schema="$capsule_schema"
      echo artifact_layout="$layout"
      echo status=frozen
      echo compiler_sha256="$compiler_sha"
      echo native_all_sha256="$native_sha"
      echo hosted_authority_receipt_sha256="$hosted_receipt_sha"
      echo seed_authority_stamp_sha256="$stamp_sha"
      echo dynamic_runtime_sha256="$dynamic_sha"
      echo cocoa_candidate_sha256="$cocoa_sha"
      echo cocoa_producer_receipt_sha256="$cocoa_receipt_sha"
      echo cocoa_admission=unavailable
      echo cocoa_dependency_admission=not-established
      echo capsule_identity_sha256="$aggregate"
      echo source_authority_path="$(CDPATH= cd -- "$authority" && pwd -P)"
    } >"$staging/phase2-runtime-capsule.env"
    chmod 500 "$staging" "$staging/deps"
    chmod 500 "$staging/$compiler_file"
    find "$staging" -type f ! -name "$compiler_file" -exec chmod 400 {} +
    [ "$windows_host" = 0 ] || windows_permissions freeze "$staging"
    verify_capsule "$staging" "$compiler_sha" || die 'staged capsule verification failed'
    mv "$staging" "$destination"
    rmdir "$lock"
    trap - EXIT HUP INT TERM
    echo "$destination"
    ;;
  *) die 'expected publish or verify' ;;
esac
