#!/bin/sh
# Execute every physical owner in a canonical Phase-3 inventory exactly once.
# Existing repository results are reused, so test/ rows are not rerun.

set -u

die() { printf 'phase3-expanded-test-runner: %s\n' "$*" >&2; exit 1; }
hash_file() { sha256sum "$1" | awk '{print $1}'; }
manifest_value() { awk -F= -v key="$1" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$2"; }

[ "$#" -eq 7 ] || die 'usage: SOURCE_ROOT INVENTORY REPOSITORY_RESULTS RESULTS COUNTS LOG_DIR NESTED_RECEIPT'
source_root=$(CDPATH= cd -- "$1" && pwd -P) || die 'cannot resolve source root'
inventory=$2
repository_results=$3
results=$4
counts=$5
log_dir=$6
nested_receipt=$7
receipt=${PHASE3_COMMAND_OWNER_RECEIPT:-}
receipt_sha=${PHASE3_COMMAND_OWNER_RECEIPT_SHA256:-}
test_runner=${PHASE3_TEST_RUNNER:-}
compiler_cli=${PHASE3_COMPILER_CLI:-}
mcp_server=${PHASE3_MCP_SERVER:-}
timeout_seconds=${PHASE3_TIMEOUT_SECONDS:-120}
phase_home=${PHASE3_HOME:-$log_dir/home}
phase_tmp=${PHASE3_TMPDIR:-$log_dir/tmp}
phase_cache=${PHASE3_CACHE_DIR:-$log_dir/cache}
helper=$source_root/scripts/bootstrap/phase3-test-inventory.shs
timeout_helper=$source_root/scripts/bootstrap/run-process-group-timeout.shs
tab=$(printf '\t')

mkdir -p "$log_dir" "$phase_home" "$phase_tmp" "$phase_cache" || die 'cannot create isolated directories'
[ -f "$inventory" ] || die 'inventory missing'
[ -f "$repository_results" ] || die 'repository results missing'
[ -f "$nested_receipt" ] || die 'nested receipt missing'
cd "$source_root" || die 'cannot enter source root'

validate_owner_receipt() {
  [ -n "$receipt" ] && [ -n "$receipt_sha" ] || return 1
  [ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
  [ "$(hash_file "$receipt")" = "$receipt_sha" ] || return 1
  [ "$(manifest_value schema "$receipt")" = simple-bootstrap-command-owners-v3 ] || return 1
  [ "$(manifest_value status "$receipt")" = frozen ] || return 1
  [ "$(manifest_value compiler_cli_path "$receipt")" = "$compiler_cli" ] || return 1
  [ "$(manifest_value test_runner_path "$receipt")" = "$test_runner" ] || return 1
  [ "$(manifest_value mcp_server_path "$receipt")" = "$mcp_server" ] || return 1
  for pair in "$compiler_cli:compiler_cli_sha256" "$test_runner:test_runner_sha256" "$mcp_server:mcp_server_sha256"; do
    artifact=${pair%%:*}; key=${pair#*:}
    [ -f "$artifact" ] && [ ! -L "$artifact" ] && [ -x "$artifact" ] || return 1
    [ "$(hash_file "$artifact")" = "$(manifest_value "$key" "$receipt")" ] || return 1
  done
}

validate_nested_receipt() {
  fresh=$log_dir/nested-receipt.current.tsv
  sh "$source_root/scripts/bootstrap/phase3-nested-test-inventory.shs" discover "$source_root" \
    "$source_root/scripts/bootstrap/phase3-nested-test-policy.tsv" "$fresh" >/dev/null 2>>"$log_dir/expanded.log" || return 1
  cmp -s "$nested_receipt" "$fresh"
}

printf 'runner\tpath\tresult\texecuted\tskipped\n' >"$results"
# Reuse only repository rows that are executable owners in this inventory.
awk -F '\t' 'FNR == NR { if (FNR > 1 && $4 == "execute") own[$3 SUBSEP $5]=1; next }
  FNR > 1 && own[$1 SUBSEP $2] { print }' "$inventory" "$repository_results" >>"$results" ||
  die 'cannot seed repository results'

owners=$log_dir/owners.tsv
awk -F '\t' 'NR > 1 && $4 == "execute" { key=$3 FS $5; if (!seen[key]++) print $2 FS $3 FS $5 }' \
  "$inventory" >"$owners" || die 'cannot select physical owners'

while IFS="$tab" read -r category runner path; do
  [ -n "$path" ] || continue
  if awk -F '\t' -v r="$runner" -v p="$path" 'NR > 1 && $1 == r && $2 == p { found=1 } END { exit !found }' "$results"; then
    continue
  fi
  safe=$(printf '%s' "$runner-$path" | tr '/\\: ' '____')
  log=$log_dir/$safe.log
  output=$log_dir/$safe.out
  json=$log_dir/$safe.json
  status=0
  executed=0
  skipped=0
  validate_owner_receipt || die "command-owner receipt mismatch before $path"
  case "$runner:$category" in
    simple-spec:*)
      env HOME="$phase_home" TMPDIR="$phase_tmp" SIMPLE_NO_STUB_FALLBACK=1 \
        SIMPLE_NATIVE_BUILD_CACHE_DIR="$phase_cache" SIMPLE_LIB=src \
        SIMPLE_BINARY="$compiler_cli" SIMPLE_MCP_TEST_BINARY="$mcp_server" \
        "$timeout_helper" "$timeout_seconds" 15 "$test_runner" "$path" \
        --mode=interpreter --unstable --assert-ran --no-cache --no-db \
        --no-session-daemon --sequential --json >"$output" 2>"$log" || status=$?
      if [ "$status" -eq 0 ]; then
        counts_row=$(perl "$source_root/scripts/bootstrap/validate-test-runner-json.pl" "$output" 2>>"$log") || status=$?
        if [ -n "${counts_row:-}" ]; then
          old_ifs=$IFS; IFS=$tab; set -- $counts_row; IFS=$old_ifs
          [ "$#" -eq 3 ] || status=91
          executed=$((${1:-0} + ${2:-0})); skipped=${3:-0}
        fi
      fi
      if [ "$skipped" -gt 0 ] && { [ "$status" -eq 0 ] || [ "$status" -eq 92 ]; }; then
        policy=$(sh "$source_root/scripts/bootstrap/phase3-test-skip-policy.shs" classify \
          "$source_root/$path" "$skipped" "$executed" 2>>"$log") || status=94
        if [ "${policy:-}" = 'skip|in-development' ]; then status=0; fi
      fi
      ;;
    npm-test:*)
      package_dir=$(dirname -- "$source_root/$path")
      while [ "$package_dir" != "$source_root/tools" ] && [ "$package_dir" != "$source_root" ] && \
            [ ! -f "$package_dir/package.json" ]; do package_dir=$(dirname -- "$package_dir"); done
      [ -f "$package_dir/package.json" ] || status=95
      if [ "$status" -eq 0 ]; then
        test_relative=${source_root}/${path}; test_relative=${test_relative#"$package_dir/"}
        rm -f -- "$json" || status=91
        (cd "$package_dir" && env HOME="$phase_home" TMPDIR="$phase_tmp" \
          "$timeout_helper" "$timeout_seconds" 15 npm test -- \
          --runTestsByPath "$test_relative" --runInBand --json --outputFile="$json") \
          >"$output" 2>"$log" || status=$?
      fi
      if [ "$status" -eq 0 ]; then
        [ -f "$json" ] && [ ! -L "$json" ] || status=91
      fi
      if [ "$status" -eq 0 ]; then
        counts_row=$(perl "$source_root/scripts/bootstrap/validate-jest-json.pl" "$json" 2>>"$log") || status=$?
        if [ -n "${counts_row:-}" ]; then
          old_ifs=$IFS; IFS=$tab; set -- $counts_row; IFS=$old_ifs
          [ "$#" -eq 3 ] || status=91
          executed=$((${1:-0} + ${2:-0})); skipped=${3:-0}
        fi
      fi
      [ "$skipped" -eq 0 ] || status=94
      ;;
    doctest-bootstrap:*)
      env HOME="$phase_home" TMPDIR="$phase_tmp" SIMPLE_NO_STUB_FALLBACK=1 \
        SIMPLE_NATIVE_BUILD_CACHE_DIR="$phase_cache" SIMPLE_BINARY="$compiler_cli" \
        "$timeout_helper" "$timeout_seconds" 15 \
        sh "$source_root/$path" >"$output" 2>"$log" || status=$?
      if [ "$status" -eq 0 ] && grep -Eq '(^|: )PASS([ (:]|$)' "$output"; then
        markdown_count=$(sed -n 's/^Sdoctest: *\([0-9][0-9]*\) passed, 0 failed, 0 skipped$/\1/p' "$output")
        comment_count=$(sed -n 's/^SPL Doctest: *\([0-9][0-9]*\) passed, 0 failed, 0 skipped$/\1/p' "$output")
        case "$markdown_count:$comment_count" in
          *[!0-9:]*|:*|*:) status=96 ;;
          *) executed=$((markdown_count + comment_count)); [ "$executed" -gt 0 ] || status=96 ;;
        esac
      else
        status=96
      fi
      ;;
    nested:required-no-tests)
      validate_nested_receipt || status=97
      [ "$status" -ne 0 ] || executed=1
      ;;
    nested:simple-spec)
      validate_nested_receipt || status=97
      if [ "$status" -eq 0 ]; then
        env HOME="$phase_home" TMPDIR="$phase_tmp" SIMPLE_NO_STUB_FALLBACK=1 \
          SIMPLE_NATIVE_BUILD_CACHE_DIR="$phase_cache" SIMPLE_LIB=src SIMPLE_BINARY="$compiler_cli" \
          "$timeout_helper" "$timeout_seconds" 15 \
          "$test_runner" "$path" --mode=interpreter --unstable --assert-ran --no-cache --no-db \
          --no-session-daemon --sequential --json >"$output" 2>"$log" || status=$?
      fi
      if [ "$status" -eq 0 ]; then
        counts_row=$(perl "$source_root/scripts/bootstrap/validate-test-runner-json.pl" "$output" 2>>"$log") || status=$?
        if [ -n "${counts_row:-}" ]; then
          old_ifs=$IFS; IFS=$tab; set -- $counts_row; IFS=$old_ifs
          executed=$((${1:-0} + ${2:-0})); skipped=${3:-0}
        fi
      fi
      [ "$skipped" -eq 0 ] || status=94
      validate_nested_receipt || status=97
      ;;
    nested:shell-unit)
      validate_nested_receipt || status=97
      if [ "$status" -eq 0 ]; then
        env HOME="$phase_home" TMPDIR="$phase_tmp" "$timeout_helper" "$timeout_seconds" 15 \
          sh "$source_root/$path" >"$output" 2>"$log" || status=$?
      fi
      if [ "$status" -eq 0 ] && grep -Eq '(^|: )PASS([ (:]|$)' "$output"; then executed=1; else status=96; fi
      validate_nested_receipt || status=97
      ;;
    *) status=95 ;;
  esac
  validate_owner_receipt || die "command-owner receipt mismatch after $path"
  [ "$status" -eq 0 ] || die "physical owner failed status=$status: $runner $path"
  result=PASS
  if [ "$executed" -eq 0 ] && [ "$skipped" -gt 0 ]; then result=SKIP; fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$runner" "$path" "$result" "$executed" "$skipped" >>"$results"
done <"$owners"

sh "$helper" check-results "$inventory" "$results" >"$counts" || die 'final result accounting failed'
