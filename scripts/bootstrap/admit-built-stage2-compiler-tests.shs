#!/bin/sh
# Re-run ONLY the Stage 2 compiler-tests gate against an already-built,
# already-admitted Stage 2 compiler and, when it passes, publish the same
# stage2-compiler-tests.env receipt bootstrap-from-scratch.sh writes -- so a
# Stage 2 rejected by a gate-side defect (e.g. the Windows GNU CC spelling bug)
# is admitted without rebuilding it, and managed Stage 3 resume can start.
#
# Nothing is relaxed: the gate and publisher are the SOURCE ROOT's own copies
# (the Stage 2 admission binds scripts/** in its source snapshot, so running a
# different checkout's verifier would be refused as stale), the compiler is
# re-hashed, and a retained rejection is archived, never deleted.
#
# usage: admit-built-stage2-compiler-tests.shs --source-root=DIR --output=DIR
#        --platform=TRIPLE [--backend=llvm|cranelift] [--strategy=normal|full]
#        [--timeout-seconds=N]
# Windows GNU: export MSYS2_ENV_CONV_EXCL="CL=;CC=" when the source root
# predates the CC drive-letter fix, so the native watchdog keeps CC POSIX.
set -eu
src="" out="" plat="" backend=llvm strategy=normal timeout=""
for a in "$@"; do
  case "$a" in
    --source-root=*) src=${a#*=} ;;
    --output=*) out=${a#*=} ;;
    --platform=*) plat=${a#*=} ;;
    --backend=*) backend=${a#*=} ;;
    --strategy=*) strategy=${a#*=} ;;
    --timeout-seconds=*) timeout=${a#*=} ;;
    *) echo "admit-stage2: unknown argument: $a" >&2; exit 64 ;;
  esac
done
[ -n "$src" ] && [ -n "$out" ] && [ -n "$plat" ] || { sed -n '13,17p' "$0" >&2; exit 64; }
src=$(CDPATH= cd -- "$src" && pwd -P)
out=$(CDPATH= cd -- "$out" && pwd -P)
case "$strategy" in full) profile=full ;; normal) profile=slim ;; *) exit 64 ;; esac
# Windows pins one frontend worker (product-frontend-policy.shs), so the cold
# full-CLI parse alone is ~1 file/s over ~2950 files; the CLI + runner + tests
# campaign does not fit 2 h there.
case "$plat" in *windows*) default_timeout=21600 ;; *) default_timeout=3600 ;; esac
# --timeout-seconds (or BOOTSTRAP_VERIFY_TIMEOUT_SECONDS) is explicit and kept
# as-is; the default is scaled by the whole-build plan's worker fit below.
timeout=${timeout:-${BOOTSTRAP_VERIFY_TIMEOUT_SECONDS:-}}
compiler="$out/stage3/$plat/stage2-admitted/simple"
[ -f "$compiler" ] || compiler="$compiler.exe"
[ -f "$compiler" ] && [ -f "$(dirname "$compiler")/admission.env" ] ||
  { echo "admit-stage2: no admitted Stage 2 compiler under $out/stage3/$plat/stage2-admitted" >&2; exit 1; }
sha=$(sha256sum "$compiler" | cut -c1-64)
root="$out/stage2-compiler-tests/$plat"
work="$root/verification"
log="$out/logs/$plat/stage2-compiler-tests.log"
mkdir -p "$root" "$(dirname "$log")"
[ ! -e "$root/stage2-compiler-tests.env" ] ||
  { echo "admit-stage2: receipt already published: $root/stage2-compiler-tests.env" >&2; exit 0; }
stamp=$(date -u +%Y%m%dT%H%M%SZ)
if [ -e "$root/rejection.env" ]; then
  mv "$root/rejection.env" "$root/rejection.env.superseded-$stamp"
fi
[ ! -f "$log" ] || mv "$log" "$log.superseded-$stamp"
status=0
(
  cd "$src"
  BOOTSTRAP_VERIFY_TOOL_BUILD_CONCURRENCY="${BOOTSTRAP_VERIFY_TOOL_BUILD_CONCURRENCY:-1}"
  BOOTSTRAP_STAGE2_TEST_DELEGATE="${BOOTSTRAP_STAGE2_TEST_DELEGATE:-0}"
  # Older source roots resolve the repo for Windows metadata launches only
  # through SIMPLE_PROJECT_ROOT (Phase2 loads no Stage3 facade); the verifier
  # requires it to equal --source-root.
  SIMPLE_PROJECT_ROOT=$src
  # Same per-row native-build budget bootstrap-from-scratch.sh gives this gate:
  # the verifier default (600s) kills the HIR/MIR shard worker mid-promote
  # (BLOCKED exit=-2 claimed=0) on the full-CLI build.
  # Windows: one pinned frontend worker -> cold full-CLI build takes hours; 1800s
  # always expired there (exit=-2). Host-scaled default, env-overridable.
  # Published after the whole-build plan below, scaled by its worker fit.
  case "$plat" in *windows*) native_internal_default=14400 ;; *) native_internal_default=1800 ;; esac
  export BOOTSTRAP_VERIFY_TOOL_BUILD_CONCURRENCY BOOTSTRAP_STAGE2_TEST_DELEGATE SIMPLE_PROJECT_ROOT
  # Same whole-build phase pricing bootstrap-from-scratch.sh gives this gate.
  # Without it the campaign watchdog fell to its literal 5859375 KiB default
  # and killed the single in-process full-CLI build at HIR module 9/3005
  # (2026-11-05, data point 6 of doc/08_tracking/bug/tree_rss_floor_kills_
  # stage2_compiler_tests_on_large_hosts_2026-10-15.md). The requested thread
  # count is an upper bound (8 = the from-scratch lane's hard ceiling, never
  # above the CPU count); the policy reduces it to what the host budget holds
  # at the per-worker floor and refuses, naming the requirement, when not
  # even one worker fits. An explicit cap in the environment is kept as-is.
  admit_threads=${BOOTSTRAP_VERIFY_BUILD_THREADS:-8}
  # A typo must not quietly become a different worker count (the verifier
  # would die on it anyway): refuse non-numeric, never substitute.
  case "$admit_threads" in
    ''|*[!0-9]*|0) echo "admit-stage2: BOOTSTRAP_VERIFY_BUILD_THREADS must be a positive decimal, got '$admit_threads'" >&2; exit 64 ;;
  esac
  admit_cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || :)
  case "$admit_cpus" in ''|*[!0-9]*|0) ;; *) [ "$admit_threads" -le "$admit_cpus" ] || admit_threads=$admit_cpus ;; esac
  . "$src/scripts/bootstrap/lib/tree-rss-policy.shs"
  bootstrap_tree_rss_whole_build_export "$admit_threads" "$src" || {
    echo "admit-stage2: $bootstrap_tree_rss_refusal" >&2
    exit 125
  }
  # Same worker-fit timeout scaling bootstrap-from-scratch.sh applies: the
  # native internal, row and campaign (verifier default 7200 s) budgets were
  # calibrated for the requested workers, so scale them by ceil(requested /
  # fitted), bounded by BOOTSTRAP_TREE_RSS_TIMEOUT_SCALE_MAX; explicit values
  # are kept. Run 4 (2026-11-05): 8 -> 2 workers, both MIR workers killed at
  # the unscaled 1800 s with 596 of 3010 modules claimed.
  BOOTSTRAP_VERIFY_TIMEOUT_SECONDS=$timeout
  { bootstrap_tree_rss_scaled_timeout BOOTSTRAP_VERIFY_NATIVE_INTERNAL_TIMEOUT "$native_internal_default" &&
    bootstrap_tree_rss_scaled_timeout BOOTSTRAP_VERIFY_TIMEOUT_SECONDS "$default_timeout" &&
    bootstrap_tree_rss_scaled_timeout BOOTSTRAP_VERIFY_CAMPAIGN_TIMEOUT_SECONDS 7200; } || {
    echo "admit-stage2: $bootstrap_tree_rss_refusal" >&2
    exit 125
  }
  timeout=$BOOTSTRAP_VERIFY_TIMEOUT_SECONDS
  echo "admit-stage2: tree RSS cap ${SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB} KiB, build-threads=${BOOTSTRAP_VERIFY_BUILD_THREADS} ($bootstrap_tree_rss_plan_summary)"
  echo "admit-stage2: timeouts native-internal=${BOOTSTRAP_VERIFY_NATIVE_INTERNAL_TIMEOUT}s row=${timeout}s campaign=${BOOTSTRAP_VERIFY_CAMPAIGN_TIMEOUT_SECONDS}s scale=x${BOOTSTRAP_VERIFY_TIMEOUT_SCALE} (${BOOTSTRAP_VERIFY_TIMEOUT_SOURCE})"
  sh "$src/scripts/bootstrap/bootstrap-phase-verification.shs" --phase=stage2 \
    "--backend=$backend" "--compiler=$compiler" "--compiler-sha256=$sha" \
    "--strategy=$strategy" "--profile=$profile" --hash-policy=canonical \
    "--work-root=$work" "--cache-root=$root/cache" "--source-root=$src" \
    "--timeout-seconds=$timeout"
) >"$log" 2>&1 || status=$?
[ "$status" -ne 0 ] || [ -f "$work/summary.env" ] || status=95
if [ "$status" -eq 0 ]; then
  sh "$src/scripts/bootstrap/lib/verify-stage2-compiler-tests.shs" --publish \
    "$out" "$plat" "$compiler" "$sha" "$src" "$work/summary.env" "$log" || status=95
fi
if [ "$status" -ne 0 ]; then
  {
    echo "schema=simple-bootstrap-stage2-compiler-tests-v1"
    echo "status=rejected"
    echo "reason=stage2-compiler-tests-failed"
    echo "candidate=$compiler"
    echo "candidate_sha256=$sha"
    echo "strategy=$strategy"
    echo "verification_status=$status"
    echo "verification_summary=$work/summary.env"
    echo "verification_log=$log"
  } >"$root/rejection.env"
  chmod 400 "$root/rejection.env"
  echo "admit-stage2: REJECTED (status=$status); log: $log" >&2
  exit 1
fi
echo "admit-stage2: ADMITTED $compiler ($sha); receipt: $root/stage2-compiler-tests.env"
