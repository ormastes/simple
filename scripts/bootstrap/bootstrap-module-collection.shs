#!/bin/sh
# Diagnostic object compilation. Caller owns source inventory and admission;
# this scheduler never substitutes a producer or promotes diagnostic output.

bootstrap_module_documentation_only() {
  # Deliberately narrower than a facade classifier: import/export/type/string
  # syntax needs real frontend/closure validation. Only ordinary blank lines
  # and full-line comments can prove there is no object-producing syntax.
  # Unreadable, symlinked, missing, or unusual input stays on the compile path.
  [ "$#" -eq 1 ] && [ -f "$1" ] && [ ! -L "$1" ] && [ -r "$1" ] || return 1
  LC_ALL=C awk '
    /^[[:space:]]*$/ { next }
    /^[[:space:]]*#/ { next }
    { exit 1 }
  ' "$1"
}

bootstrap_module_object_valid() {
  if [ -n "${MODULE_PROGRESS_TARGET:-}" ]; then
    python3 "$MODULE_PROGRESS_HELPER" object "$1" "$MODULE_PROGRESS_TARGET"
    return $?
  fi
  # Check the output kind independently of the compiler's status or suffix.
  # ELF ET_REL, COFF (no PE optional header), and Mach-O MH_OBJECT are the
  # supported host object containers. This is not a full object-file verifier.
  od -An -v -tu1 -N20 "$1" 2>/dev/null | awk '
    { for (i = 1; i <= NF; i++) b[++n] = $i }
    END {
      if (n < 20) exit 1
      if (b[1] == 127 && b[2] == 69 && b[3] == 76 && b[4] == 70) {
        if ((b[6] == 1 && b[17] == 1 && b[18] == 0) ||
            (b[6] == 2 && b[17] == 0 && b[18] == 1)) exit 0
        exit 1
      }
      machine = b[1] + 256 * b[2]
      if ((machine == 34404 || machine == 43620 || machine == 332 || machine == 452) &&
          b[3] + b[4] * 256 > 0 && b[17] == 0 && b[18] == 0) exit 0
      if (((b[1] == 207 || b[1] == 206) && b[2] == 250 && b[3] == 237 && b[4] == 254) &&
          b[13] == 1 && b[14] == 0 && b[15] == 0 && b[16] == 0) exit 0
      if (b[1] == 254 && b[2] == 237 && b[3] == 250 && (b[4] == 206 || b[4] == 207) &&
          b[13] == 0 && b[14] == 0 && b[15] == 0 && b[16] == 1) exit 0
      exit 1
    }'
}

run_module_compile_inventory() (
  [ "$#" -eq 8 ] || return 2
  mc_manifest=$1 mc_work=$2 mc_cache_root=$3 mc_workers=$4 mc_threads=$5
  mc_run=$6 mc_validate=$7 mc_summary=$8
  case "$mc_workers:$mc_threads" in *[!0-9:]*|0:*|*:0|:*|*:) return 2 ;; esac
  mc_stop_file=${SIMPLE_MODULE_COLLECTION_STOP_REQUEST_FILE:-}
  mc_systemic_file=${SIMPLE_MODULE_SYSTEMIC_STOP_FILE:-}
  for mc_marker in "$mc_stop_file" "$mc_systemic_file"; do
    [ -z "$mc_marker" ] || { case "$mc_marker" in /*) ;; *) return 2 ;; esac; }
  done
  mc_abort_requested() {
    if [ -n "$mc_stop_file" ] && [ -e "$mc_stop_file" ]; then mc_abort_rc=143; return 0; fi
    if [ -n "$mc_systemic_file" ] && [ -e "$mc_systemic_file" ]; then mc_abort_rc=74; return 0; fi
    return 1
  }
  [ -f "$mc_manifest" ] || return 2
  mkdir -p "$mc_work" "$mc_cache_root" || return 2
  mc_attempt=$(mktemp -d "$mc_work/attempt.XXXXXX") || return 2
  mc_failed=0 mc_count=0 mc_batch=0 mc_jobs= mc_blocked=0 mc_block_log= mc_abort_rc=0
  # A scheduler filesystem/hash error must not orphan already launched work.
  # Children own their timeout; finish/reap them without deleting their caches.
  trap 'for mc_pending in $mc_jobs; do wait "${mc_pending%:*}" 2>/dev/null || :; done' 0
  trap 'exit 143' 1 2 15
  # A failed binary remains failed; fail-fast must skip this entire inventory.
  mc_stopped=${MODULE_COMPILE_PRIOR_FAILURE:-0}
  # Reuse the portable cache-lock owner identity implementation. Capture each
  # child's kernel birth identity before its callback can exit or be killed.
  mc_process_helper=${BOOTSTRAP_MODULE_PROCESS_HELPER:-${PORTABLE_LOCK_ATOMIC_HELPER_PATH:-}}
  if [ -z "$mc_process_helper" ]; then
    if [ -f "$(dirname -- "$0")/../check/lib/portable-hardlink-lock.pl" ]; then
      mc_process_helper=$(CDPATH= cd -- "$(dirname -- "$0")/../check/lib" && pwd -P)/portable-hardlink-lock.pl || return 2
    else
      mc_process_helper=scripts/check/lib/portable-hardlink-lock.pl
    fi
  fi
  [ -f "$mc_process_helper" ] || return 2
  mc_publish_next=1
  mc_reap_finished() {
    mc_remaining= mc_publish_validated=0
    for mc_job in $mc_jobs; do
      mc_live=0
      if [ ! -s "$mc_attempt/${mc_job#*:}/row" ] && [ -s "$mc_attempt/${mc_job#*:}/owner" ]; then
        mc_birth=$(sed -n 's/^start_hex=//p' "$mc_attempt/${mc_job#*:}/owner") || return 2
        mc_state=$(perl "$mc_process_helper" process-state "${mc_job%:*}" "$mc_birth") || return 2
        case "$mc_state" in live) mc_live=1 ;; gone) ;; *) return 2 ;; esac
      elif [ ! -s "$mc_attempt/${mc_job#*:}/row" ]; then
        # Allow bounded startup observation; a child killed before identity
        # publication has no receipt. Then join the actual shell-owned child,
        # never any unrelated process that recycled its numeric PID.
        mc_start_wait=0
        [ ! -f "$mc_attempt/${mc_job#*:}/startup-waits" ] || mc_start_wait=$(cat "$mc_attempt/${mc_job#*:}/startup-waits")
        mc_start_wait=$((mc_start_wait + 1))
        printf '%s\n' "$mc_start_wait" >"$mc_attempt/${mc_job#*:}/startup-waits" || return 2
        [ "$mc_start_wait" -ge 5 ] || mc_live=1
      fi
      if [ "$mc_live" = 1 ]; then
        mc_remaining="$mc_remaining $mc_job"
      else
        wait "${mc_job%:*}" || { mc_failed=1; mc_stopped=1; }
        : >"$mc_attempt/${mc_job#*:}/reaped" || return 2
        mc_batch=$((mc_batch - 1))
      fi
    done
    mc_jobs=$mc_remaining
    while [ -f "$mc_attempt/$mc_publish_next/reaped" ]; do
      if [ -n "${MODULE_PROGRESS_STATE:-}" ] && [ -f "$mc_attempt/$mc_publish_next/launched" ] && [ -s "$mc_attempt/$mc_publish_next/row" ]; then
        if [ "$mc_publish_validated" = 0 ]; then
          MODULE_COMPILE_VALIDATE_FULL=1 "$mc_validate" >"$mc_attempt/checkpoint-authority.log" 2>&1 || return 2
          mc_publish_validated=1
        fi
        python3 "$MODULE_PROGRESS_HELPER" publish "$MODULE_PROGRESS_STATE" "$MODULE_PROGRESS_CONTEXT" "$MODULE_PROGRESS_TARGET" "$mc_attempt/$mc_publish_next/row" || return 2
      fi
      mc_publish_next=$((mc_publish_next + 1))
    done
  }
  while IFS= read -r mc_entry || [ -n "$mc_entry" ]; do
    [ -n "$mc_entry" ] || continue
    # Observe owner cancellation before allocating another attempt or child.
    if mc_abort_requested; then break; fi
    mc_count=$((mc_count + 1))
    mc_dir="$mc_attempt/$mc_count"
    mkdir -p "$mc_dir/home" "$mc_dir/tmp" || return 2
    printf '%s\n' "$mc_entry" >"$mc_dir/entry"
    if [ "${SIMPLE_COMPILE_FAIL_FAST:-0}" = 1 ] && [ "$mc_stopped" = 1 ]; then
      printf 'task=module_compile_%s|entry=%s|result=SKIPPED|status=fail-fast|log=-\n' "$mc_count" "$mc_entry" >"$mc_dir/row"
      mc_failed=1
    elif [ "$mc_blocked" = 1 ] || ! "$mc_validate" >"$mc_dir/prerequisite.log" 2>&1; then
      [ "$mc_blocked" = 1 ] || mc_block_log="$mc_dir/prerequisite.log"
      mc_blocked=1
      printf 'task=module_compile_%s|entry=%s|result=BLOCKED|status=prerequisite-unavailable|log=%s\n' "$mc_count" "$mc_entry" "$mc_block_log" >"$mc_dir/row"
      mc_failed=1 mc_stopped=1
    elif bootstrap_module_documentation_only "$mc_entry"; then
      mc_source_sha=$(hash_stream <"$mc_entry") || return 2
      mc_doc_result=UNSUPPORTED mc_doc_status=documentation-only-no-code
      if ! "$mc_validate" >>"$mc_dir/prerequisite.log" 2>&1; then
        mc_doc_result=BLOCKED mc_doc_status=authority-changed
      else
        mc_source_after=$(hash_stream <"$mc_entry") || return 2
        if [ "$mc_source_sha" != "$mc_source_after" ] ||
            ! bootstrap_module_documentation_only "$mc_entry"; then
          mc_doc_result=BLOCKED mc_doc_status=source-changed
        fi
      fi
      # No object operation was executed. Retain aggregate failure until the
      # admission policy explicitly provides empty-input rejection coverage.
      printf 'task=module_compile_%s|entry=%s|result=%s|status=%s|source_sha256=%s|producer_sha256=%s|artifact=-|log=%s|mode=diagnostic-relocatable-object\n' \
        "$mc_count" "$mc_entry" "$mc_doc_result" "$mc_doc_status" \
        "$mc_source_sha" "${snapshot_sha:-unavailable}" "$mc_dir/prerequisite.log" >"$mc_dir/row"
      mc_failed=1 mc_stopped=1
    else
      mc_key=$(printf '%s\n' "$mc_entry" | hash_stream) || return 2
      mc_cache="$mc_cache_root/$mc_key"
      : >"$mc_dir/launched" || return 2
      (
        if ! perl "$mc_process_helper" owner-snapshot >"$mc_dir/owner.pending"; then
          printf 'task=module_compile_%s|entry=%s|result=FAIL|status=process-identity-unavailable|log=-\n' "$mc_count" "$mc_entry" >"$mc_dir/row"
          exit 2
        fi
        mv "$mc_dir/owner.pending" "$mc_dir/owner" || exit 2
        HOME="$mc_dir/home" TMPDIR="$mc_dir/tmp"
        export HOME TMPDIR
        mc_log="$mc_dir/compile.log" mc_output="$mc_dir/module.o"
        mc_result=PASS mc_status=0 mc_started=$(date +%s)
        mkdir -p "$mc_cache" || exit 2
        if ! "$mc_validate" >"$mc_log" 2>&1; then
          mc_result=BLOCKED mc_status=prerequisite-unavailable
        else
          "$mc_run" "$mc_entry" "$mc_cache" "$mc_output" "$mc_threads" "$mc_log" >"$mc_log" 2>&1 || mc_status=$?
          [ "$mc_status" = 0 ] || mc_result=FAIL
          if ! "$mc_validate" >>"$mc_log" 2>&1; then
            mc_result=BLOCKED mc_status=authority-changed
          elif [ "$mc_status" = 0 ] && { [ ! -s "$mc_output" ] || [ -L "$mc_output" ]; }; then
            mc_result=FAIL mc_status=missing-object
          elif [ "$mc_status" = 0 ] && ! bootstrap_module_object_valid "$mc_output"; then
            mc_result=FAIL mc_status=invalid-object
          fi
        fi
        mc_ended=$(date +%s)
        printf 'task=module_compile_%s|entry=%s|result=%s|status=%s|elapsed_seconds=%s|log=%s|artifact=%s|cache=%s|threads=%s|mode=diagnostic-relocatable-object\n' \
          "$mc_count" "$mc_entry" "$mc_result" "$mc_status" "$((mc_ended - mc_started))" \
          "$mc_log" "$mc_output" "$mc_cache" "$mc_threads" >"$mc_dir/row"
        [ "$mc_result" = PASS ]
      ) &
      mc_jobs="$mc_jobs $!:$mc_count"
      mc_batch=$((mc_batch + 1))
    fi
    case " $mc_jobs " in
      *":$mc_count "*) ;;
      *) : >"$mc_dir/reaped" || return 2 ;;
    esac
    # Refill as soon as any worker terminates, rather than joining a wave.
    while [ "$mc_batch" -ge "$mc_workers" ]; do
      mc_reap_finished || return 2
      [ "$mc_batch" -lt "$mc_workers" ] || sleep 1
    done
    if mc_abort_requested; then break; fi
  done <"$mc_manifest"
  while [ "$mc_batch" -gt 0 ]; do
    mc_reap_finished || return 2
    [ "$mc_batch" -eq 0 ] || sleep 1
  done
  # Observe stop markers raised by a final partial set of workers.
  mc_abort_requested || :
  if [ "$mc_count" -eq 0 ] && [ "$mc_abort_rc" -ne 0 ]; then return "$mc_abort_rc"; fi
  if [ "$mc_count" -eq 0 ]; then
    printf 'task=module_compile_inventory|result=FAIL|status=empty-inventory|log=-\n' >>"$mc_summary"
    return 1
  fi
  mc_index=1
  while [ "$mc_index" -le "$mc_count" ]; do
    if [ -s "$mc_attempt/$mc_index/row" ]; then
      cat "$mc_attempt/$mc_index/row" >>"$mc_summary" || return 2
    else
      mc_entry=$(cat "$mc_attempt/$mc_index/entry")
      printf 'task=module_compile_%s|entry=%s|result=FAIL|status=worker-failed|log=%s\n' \
        "$mc_index" "$mc_entry" "$mc_attempt/$mc_index/compile.log" >>"$mc_summary"
      mc_failed=1
    fi
    mc_index=$((mc_index + 1))
  done
  [ "$mc_abort_rc" -eq 0 ] || return "$mc_abort_rc"
  [ "$mc_failed" -eq 0 ]
)
