#!/bin/sh
# Run one command in an isolated session/process group. On timeout terminate
# the complete group, wait through the grace period, then reap the group leader.

set -u

[ "$#" -ge 3 ] || { echo "usage: $0 TIMEOUT GRACE COMMAND [ARG ...]" >&2; exit 2; }
timeout_seconds=$1
grace_seconds=$2
shift 2
case "$timeout_seconds:$grace_seconds" in *[!0-9:]*|0:*) exit 2 ;; esac
# `setsid` is util-linux and is absent on macOS, where this hard requirement
# made every phase-verification run exit 125 before doing any work. perl ships
# with macOS and POSIX::setsid() is the same syscall, so it provides the session
# leader this script's `kill -- -$leader` group termination depends on. Prefer
# real setsid wherever it exists, so Linux behaviour is unchanged.
# NOTE the `exec` in both branches, which is load-bearing rather than an
# optimisation. This function is invoked as `spl_setsid "$@" <&3 &`, so the
# shell forks a subshell and `leader=$!` records THAT subshell's pid. Without
# `exec` the real session leader would be a grandchild, leaving `leader` in the
# OLD process group -- so `kill -- -$leader` in cleanup() would signal the wrong
# group and the timed-out tree would survive. Verified: the selftest hangs
# without `exec` and passes with it.
if command -v setsid >/dev/null 2>&1; then
  spl_setsid() { exec setsid "$@"; }
elif command -v perl >/dev/null 2>&1; then
  spl_setsid() { exec perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV or exit 127' -- "$@"; }
else
  echo "setsid (or perl) is required for process containment" >&2
  exit 125
fi

[ -n "${TMPDIR:-}" ] || {
  echo "centralized TMPDIR is required for process containment" >&2
  exit 125
}
state_dir=${TMPDIR}/simple-process-group-timeout.$$
mkdir -p "$state_dir" || exit 125
timed_out="$state_dir/timed-out"
leader=0
watchdog=0

cleanup() {
  if [ "$watchdog" -gt 0 ]; then
    kill "$watchdog" 2>/dev/null || :
    wait "$watchdog" 2>/dev/null || :
  fi
  if [ "$leader" -gt 0 ] && kill -0 "-$leader" 2>/dev/null; then
    kill -TERM "-$leader" 2>/dev/null || :
    kill -KILL "-$leader" 2>/dev/null || :
  fi
  rm -rf "$state_dir"
}
trap 'cleanup; exit 143' TERM INT HUP
trap cleanup EXIT

# An asynchronous command inherits /dev/null as stdin in non-interactive POSIX
# shells unless its stdin is explicitly redirected. Preserve the caller's
# pipe/file on a dedicated descriptor so protocol servers can be contained
# without observing an immediate EOF.
exec 3<&0
spl_setsid "$@" <&3 &
leader=$!
exec 3<&-
(
  timer=0
  stop_watchdog() {
    if [ "$timer" -gt 0 ]; then
      kill "$timer" 2>/dev/null || :
      wait "$timer" 2>/dev/null || :
    fi
    exit 0
  }
  trap stop_watchdog TERM INT HUP
  sleep "$timeout_seconds" &
  timer=$!
  wait "$timer" 2>/dev/null || exit 0
  timer=0
  if kill -0 "-$leader" 2>/dev/null; then
    : >"$timed_out"
    kill -TERM "-$leader" 2>/dev/null || :
    sleep "$grace_seconds"
    kill -KILL "-$leader" 2>/dev/null || :
  fi
) &
watchdog=$!

status=0
wait "$leader" || status=$?
if [ -f "$timed_out" ]; then
  wait "$watchdog" 2>/dev/null || :
  watchdog=0
  exit 124
fi
kill "$watchdog" 2>/dev/null || :
wait "$watchdog" 2>/dev/null || :
watchdog=0
exit "$status"
