#!/bin/sh
# Shared command owner for timeout and process-tree RSS enforcement.
set -eu
[ "$#" -ge 3 ] || { echo "usage: $0 TIMEOUT GRACE COMMAND [ARG ...]" >&2; exit 2; }
timeout_seconds=$1
grace_seconds=$2
shift 2
case "$timeout_seconds:$grace_seconds" in *[!0-9:]*|:*|*:) exit 2 ;; esac
[ -n "${TMPDIR:-}" ] || { echo 'centralized TMPDIR is required for process containment' >&2; exit 125; }
session_mode=new
if [ "${SIMPLE_BOOTSTRAP_SESSION_ID+x}${SIMPLE_BOOTSTRAP_SESSION_EXEC+x}" != "" ]; then
  case "${SIMPLE_BOOTSTRAP_SESSION_ID:-}:${SIMPLE_BOOTSTRAP_SESSION_EXEC:-}" in
    [1-9]*:/*) ;;
    *) echo 'incomplete inherited session contract' >&2; exit 125 ;;
  esac
  session_mode=inherit
fi
runner=$(CDPATH= cd -- "$(dirname -- "$0")/../resource" && pwd -P)/process-tree-rss-watchdog.pl
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
. "$repo/scripts/bootstrap/lib/tree-rss-policy.shs"
compiler_jobs=0
if [ "${2:-}" = native-build ]; then
  compiler_jobs=$(bootstrap_tree_rss_command_jobs "$@")
fi
# Phase-level declaration for commands whose argv carries no worker count
# (e.g. the interpreter test runner): the watchdog scales its ceiling only on
# evidence of a worker count, and on Windows its host probe is the MSYS
# /proc/meminfo view, which works -- so an explicit declaration is the only
# way a wide verification phase (build threads + test workers) gets the same
# jobs-scaled ceiling a native-build row already gets from its --threads.
# Validated by the same canonical-uint rule and refused above 128 downstream.
if [ "$compiler_jobs" -eq 0 ] && [ -n "${SIMPLE_PROCESS_TREE_RSS_DECLARED_JOBS:-}" ]; then
  compiler_jobs=$(bootstrap_tree_rss_canonical_uint "$SIMPLE_PROCESS_TREE_RSS_DECLARED_JOBS" 3)
  [ -n "$compiler_jobs" ] && [ "$compiler_jobs" -ge 1 ] || {
    echo 'process-timeout-policy-error: invalid SIMPLE_PROCESS_TREE_RSS_DECLARED_JOBS (want 1..128)' >&2
    exit 125
  }
fi
# An elevated compiler budget belongs to an explicit native-build invocation,
# not to arbitrary verification helpers (or their descendants). Preserve the
# legacy cap precedence when this optional compiler policy is absent.
compiler_ceiling_arg=
if [ -n "${SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB+x}" ]; then
  compiler_ceiling=$SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB
  compiler_cap=${SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB:-}
  for compiler_value in "$compiler_ceiling" "$compiler_cap"; do
    case "$compiler_value" in
      ''|0*|*[!0-9]*) echo 'invalid explicit compiler ceiling/cap pair' >&2; exit 125 ;;
    esac
  done
  [ "${#compiler_ceiling}" -le 15 ] && [ "${#compiler_cap}" -le 15 ] &&
    [ "$compiler_cap" -le "$compiler_ceiling" ] || {
      echo 'invalid explicit compiler ceiling/cap pair' >&2; exit 125;
    }
  if [ "${2:-}" = native-build ]; then
    compiler_ceiling_arg=--compiler-ceiling-kib=$compiler_ceiling
  else
    unset SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB
  fi
fi
# Preserve the legacy override's precedence while validating every cap through
# the same worker/host policy used by the transcribed bootstrap command owner.
if [ -z "${SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB:-}" ] && \
   [ -n "${SIMPLE_PROCESS_TREE_RSS_CAP_KIB:-}" ]; then
  SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB=$SIMPLE_PROCESS_TREE_RSS_CAP_KIB
fi
bootstrap_tree_rss_resolve "$compiler_jobs" "$repo" || {
  printf 'process-timeout-policy-error: %s\n' "$bootstrap_tree_rss_refusal" >&2
  exit 125
}
compiler_jobs_arg=
[ "$compiler_jobs" -eq 0 ] || compiler_jobs_arg=--compiler-jobs=$compiler_jobs
exec perl "$runner" \
  --session-mode="$session_mode" \
  --rss-cap-mode="${SIMPLE_BOOTSTRAP_RSS_CAP_MODE:-enforce}" \
  --max-rss-kib="$bootstrap_tree_rss_cap_kib" \
  $compiler_jobs_arg \
  $compiler_ceiling_arg \
  --cap-source="$bootstrap_tree_rss_source" --cap-bound="$bootstrap_tree_rss_bound" \
  --interval-ms="${SIMPLE_PROCESS_TREE_RSS_INTERVAL_MS:-100}" \
  --receipt="${SIMPLE_PROCESS_TREE_RSS_RECEIPT:-$TMPDIR/simple-process-tree-rss.$$.env}" \
  --timeout-seconds="$timeout_seconds" --term-grace-seconds="$grace_seconds" \
  -- "$@"
