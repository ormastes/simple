#!/bin/sh
# Run one command in an isolated session/process group. On timeout terminate
# the complete group, wait through the grace period, then reap the group leader.

set -u

[ "$#" -ge 3 ] || { echo "usage: $0 TIMEOUT GRACE COMMAND [ARG ...]" >&2; exit 2; }
timeout_seconds=$1
grace_seconds=$2
shift 2
case "$timeout_seconds:$grace_seconds" in *[!0-9:]*|0:*) exit 2 ;; esac
command -v setsid >/dev/null 2>&1 || { echo "setsid is required for process containment" >&2; exit 125; }

state_dir=${TMPDIR:-/tmp}/simple-process-group-timeout.$$
mkdir -p "$state_dir" || exit 125
timed_out="$state_dir/timed-out"
leader=0
watchdog=0

cleanup() {
  if [ "$watchdog" -gt 0 ]; then
    kill "$watchdog" 2>/dev/null || :
    wait "$watchdog" 2>/dev/null || :
  fi
  if [ "$leader" -gt 0 ] && kill -0 "-$leader" 2>/dev/null; then
    kill -TERM "-$leader" 2>/dev/null || :
    kill -KILL "-$leader" 2>/dev/null || :
  fi
  rm -rf "$state_dir"
}
trap 'cleanup; exit 143' TERM INT HUP
trap cleanup EXIT

setsid "$@" &
leader=$!
(
  sleep "$timeout_seconds"
  if kill -0 "-$leader" 2>/dev/null; then
    : >"$timed_out"
    kill -TERM "-$leader" 2>/dev/null || :
    sleep "$grace_seconds"
    kill -KILL "-$leader" 2>/dev/null || :
  fi
) &
watchdog=$!

status=0
wait "$leader" || status=$?
if [ -f "$timed_out" ]; then
  wait "$watchdog" 2>/dev/null || :
  watchdog=0
  exit 124
fi
kill "$watchdog" 2>/dev/null || :
wait "$watchdog" 2>/dev/null || :
watchdog=0
exit "$status"
