#!/bin/sh
# @workaround bug=stage2_whole_program_mir_memory_growth_2026-11-01 (entry groups; fallback to the 32-shard whole-program run)
#
# Build the stage3 compiler (entry src/app/cli/bootstrap_main.spl) with the
# frozen stage2 as K small entry-closure groups instead of one whole-program
# worker, then link simple_stage3.exe from the deduped group objects.
#
# Usage: sh scripts/bootstrap/p3-entry-groups.shs <checkout> <out_dir> [first_group] [last_group]
#
#   <checkout>  git checkout whose HEAD tracks src/app/cli/p3_groups/group_<n>.spl
#               (SCV: entry + every --source under the checkout root, entry tracked)
#   <out_dir>   group archives, logs, merged object dir, simple_stage3.exe
#
# Groups (src/app/cli/p3_groups/group_<n>.spl) follow the layering:
#   1 std lib   2 compiler 00.common (+scv)   3 frontend/hir   4 types/semantics/mir
#   5 backend   6 driver (+plugins)           7 app/cli
# Each group `use`s only the slice of the bootstrap_main closure not already
# covered by earlier groups (<= 250 new modules each). Groups are strictly
# layered (group n imports groups 1..n-1), so they run in order by default and
# reuse one shared --cache-dir: lower layers compile once and are cache hits
# later. P3G_WAVES may run groups of a wave concurrently, e.g. "1|2 3|4 5|6|7";
# concurrent groups share deps and the cache dir, so only use it once the lower
# waves are cached.
#
# Memory: every stage2 process runs under C:/dev/p3new/tools/measure.ps1, which
# kills only its own process tree past P3G_CAP_GB (default 28). With at most 3
# concurrent groups that is <= 84 GB, leaving >= 24 GB commit free on the host.
#
# Link (duplicate-symbol handling): every archive is extracted into ONE object
# dir. Members are content/module-hash named (aot-<sha256>.o), so the same
# module built by two groups collapses to one file by name. Group entry objects
# (they define __simple_main) are dropped; then any remaining object whose
# __module_init* symbol is already defined by an earlier object is dropped too
# (reported). The bootstrap_main entry object (--emit-entry-object, last step)
# supplies __simple_main. scripts/bootstrap/p3-manual-link-stage3.shs links the
# list with the #5760 ptree-shadow runtime.
set -eu

if [ "$#" -lt 2 ]; then
    echo "usage: $0 <checkout> <out_dir> [first_group] [last_group]" >&2
    exit 2
fi
checkout=${1%/}
out=${2%/}
first=${3:-1}
last=${4:-7}
here=$(cd "$(dirname "$0")" && pwd)
stage2=${P3G_STAGE2:-C:/dev/p3new/stage2.exe}
measure=${P3G_MEASURE:-C:/dev/p3new/tools/measure.ps1}
cache=${P3G_CACHE_DIR:-$out/cache}
cap=${P3G_CAP_GB:-28}
limit=${P3G_LIMIT_S:-7200}
threads=${P3G_THREADS:-26}
ptree=${P3G_PTREE_SHADOW:-C:/dev/p3new/r11/ptree_shadow}
lm=${SIMPLE_LLVM_MINGW_ROOT:-C:/Users/user/.simple/toolchains/llvm-mingw-20260922-ucrt-x86_64}
ar="$lm/bin/llvm-ar.exe"; [ -x "$ar" ] || ar="$lm/bin/llvm-ar"
nm="$lm/bin/llvm-nm.exe"; [ -x "$nm" ] || nm="$lm/bin/llvm-nm"
ps=$(command -v pwsh || command -v powershell || true)
[ -n "$ps" ] || { echo "error: pwsh/powershell not found" >&2; exit 1; }
[ -f "$stage2" ] || { echo "error: stage2 missing: $stage2" >&2; exit 1; }
[ -f "$measure" ] || { echo "error: measure wrapper missing: $measure" >&2; exit 1; }
mkdir -p "$out" "$cache"

# One stage2 run under the RSS-capped wrapper. $1=name $2=entry $3=emit flag $4=output
run_stage2() {
    name=$1; entry=$2; emit=$3; o=$4
    git -C "$checkout" ls-files --error-unmatch "$entry" >/dev/null 2>&1 ||
        { echo "error: $entry is not tracked in $checkout (SCV needs a tracked entry)" >&2; return 1; }
    ps1="$out/$name.run.ps1"
    cat > "$ps1" <<EOF
\$env:SIMPLE_P3_RUN="P3-GROUPS-$name"
\$env:KEEP_CACHE="1"
\$env:PATH="C:\\msys64\\clang64\\bin;"+\$env:PATH
\$env:SIMPLE_FILE_WORKERS="0"; \$env:SIMPLE_FILE_FIBERS="0"; \$env:SIMPLE_COMPILE_FAIL_FAST="0"; \$env:SIMPLE_NATIVE_BUILD_THREADS="$threads"
\$env:SIMPLE_NATIVE_INCREMENTAL="1"; \$env:SIMPLE_COMPILER_TRACE="1"
\$env:SIMPLE_SCV_INVENTORY_COLD_INIT="1"; \$env:SIMPLE_SCV_FREEZE_FALLBACK="1"
Remove-Item Env:LIB -EA SilentlyContinue
\$lm="$lm"
\$env:PATH=\$env:PATH+";\$lm\\bin"; \$env:CC="\$lm\\bin\\clang.exe"; \$env:SIMPLE_LLVM_MINGW_ROOT=\$lm
# @workaround bug=stage2_runtime_list_missing_process_tree (#5760)
\$env:SIMPLE_PROJECT_ROOT="$ptree"; \$env:SIMPLE_RT_OBJ_CACHE_DIR="$ptree.rtcache"
Set-Location "$checkout"
& "$measure" -Exe "$stage2" -Cache "$cache" -Log "$out/$name.build.log" -Limit $limit -CapGB $cap -Rest @('native-build','--entry-closure','--entry','$entry','--runtime-bundle','core-c-bootstrap','--source','src/compositions/cuda_static','--source','src/compositions/kernel_llvm_cranelift','--source','src/compiler','--source','src/app','--source','src/lib','--source','src/plugins','--target','x86_64-pc-windows-gnu','--backend','llvm','--threads','$threads','--keep-going','--go-to-end','--cache-dir','$cache','$emit','-o','$o') | Tee-Object "$out/$name.result.txt"
EOF
    echo "[p3g] start $name ($entry $emit) $(date +%H:%M:%S)"
    "$ps" -NoProfile -ExecutionPolicy Bypass -File "$ps1" > "$out/$name.wrapper.log" 2>&1 || true
    echo "[p3g] done  $name: $(tail -n 1 "$out/$name.result.txt" 2>/dev/null)"
    [ -s "$o" ] || { echo "error: $name produced no $o" >&2; return 1; }
}

# ---- groups -----------------------------------------------------------------
waves=${P3G_WAVES:-}
if [ -z "$waves" ]; then
    waves=$(seq "$first" "$last" | tr '\n' '|' | sed 's/|$//')
fi
old_ifs=$IFS; IFS='|'
for wave in $waves; do
    IFS=$old_ifs
    pids=""
    for g in $wave; do
        a="$out/group_$g.a"
        if [ -s "$a" ] && [ "${P3G_REBUILD:-0}" != 1 ]; then echo "[p3g] reuse $a"; continue; fi
        run_stage2 "group_$g" "src/app/cli/p3_groups/group_$g.spl" --emit-archive "$a" &
        pids="$pids $!"
    done
    for p in $pids; do wait "$p" || { echo "error: wave '$wave' failed" >&2; exit 1; }; done
    IFS='|'
done
IFS=$old_ifs

# ---- bootstrap_main entry object (all deps are cache hits by now) -----------
entry_o="$out/bootstrap_main_entry.o"
if [ ! -s "$entry_o" ] || [ "${P3G_REBUILD:-0}" = 1 ]; then
    run_stage2 entry src/app/cli/bootstrap_main.spl --emit-entry-object "$entry_o"
fi

# ---- merge + dedupe ---------------------------------------------------------
objs="$out/objs"
rm -rf "$objs"; mkdir -p "$objs"
for g in $(seq 1 7); do
    a="$out/group_$g.a"
    [ -s "$a" ] || { echo "error: missing $a" >&2; exit 1; }
    "$ar" t "$a" | tr -d '\r' > "$out/group_$g.members"
    (cd "$objs" && "$ar" x "$a")
done
total=$(cat "$out"/group_*.members | wc -l | tr -d ' ')
uniq_n=$(cat "$out"/group_*.members | sort -u | wc -l | tr -d ' ')
echo "[p3g] archive members: $total total, $uniq_n unique by name ($((total - uniq_n)) shared deduped)"
: > "$out/obj-list.txt"; : > "$out/dedupe.log"
seen="$out/inits.seen"; : > "$seen"
for o in $(ls "$objs" | LC_ALL=C sort); do
    case "$o" in *.o) ;; *) continue ;; esac
    syms=$("$nm" --defined-only --extern-only "$objs/$o" 2>/dev/null | awk 'NF>=3{print $3}' | sed 's/^_\{1,3\}simple_main$/__simple_main/')
    if echo "$syms" | grep -qx '__simple_main'; then echo "drop $o: group entry (__simple_main)" >> "$out/dedupe.log"; continue; fi
    inits=$(echo "$syms" | sed 's/^___module_init/__module_init/' | grep -E '^__module_init' || true)
    dup=""
    for s in $inits; do grep -qxF "$s" "$seen" && dup=$s; done
    if [ -n "$dup" ]; then echo "drop $o: duplicate $dup" >> "$out/dedupe.log"; continue; fi
    for s in $inits; do echo "$s" >> "$seen"; done
    echo "$o" >> "$out/obj-list.txt"
done
cp "$entry_o" "$objs/bootstrap_main_entry.o"
echo bootstrap_main_entry.o >> "$out/obj-list.txt"
echo "[p3g] link objects: $(wc -l < "$out/obj-list.txt" | tr -d ' '); dropped: $(wc -l < "$out/dedupe.log" | tr -d ' ') (see $out/dedupe.log)"

# ---- link -------------------------------------------------------------------
P3_OBJ_LIST="$out/obj-list.txt" SIMPLE_LLVM_MINGW_ROOT="$lm" \
    sh "$here/p3-manual-link-stage3.shs" "$objs" "$checkout" "$out/simple_stage3.exe"
