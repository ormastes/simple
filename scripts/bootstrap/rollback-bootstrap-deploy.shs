#!/bin/sh
# Bootstrap Gate 5R rollback: given <canonical-triple>, undo the last deploy of
# bin/release/<triple>/simple and print a rollback receipt.
#
# TWO deploy designs exist and this entrypoint serves both, dispatching on the
# `schema=` line of the deploy receipt it finds. Guessing is not allowed: an
# unrecognised schema is ERROR, never a pass.
#
#   bootstrap-deploy-receipt-v1  — the legacy design. The deploy retained a
#     sibling `<current>.pre_deploy` copy; rolling back means installing that
#     copy back over `<current>`, verifying its recorded SHA-256, and re-running
#     the arithmetic smoke (-c 'print(1+1)').
#
#   bootstrap-deploy-receipt-v3  — what bootstrap-from-scratch.sh writes today.
#     There is no `.pre_deploy` sibling at all: deploys are immutable generation
#     directories under
#     bin/release/<triple>/.bootstrap-deploy-generations/<triple>/<id>/ plus an
#     atomic pointer swap, and rolling back means swapping the pointer back to
#     `previous_pointer_target` after re-verifying the generation manifests and
#     the eight authority artefacts. That verification+swap is implemented by
#     bootstrap_deploy_tx_rollback_generation() in
#     scripts/bootstrap/bootstrap-deploy-transaction.shs, which this script
#     delegates to rather than reimplementing. Its happy path is exercised by
#     test/01_unit/scripts/bootstrap_deploy_transaction_test.shs.
#
# Until 2026-09-07 this script hardcoded the v1 schema check, so a binary
# deployed by the current bootstrap could not be rolled back at all: every
# invocation died at `deploy receipt has unexpected schema`. The two halves are
# now on the same receipt format.
#
# Two honest limits of the v3 path, stated rather than papered over:
#   * `--dry-run` on v3 is RECEIPT-ONLY. It reports the generation that would be
#     rolled back and the pointer target that would be restored, but does not
#     re-verify the previous generation's manifests or authority artefacts the
#     way the v1 dry-run re-verifies its backup. Doing so properly means calling
#     into the transaction library, and its entry point recovers (i.e. can
#     COMPLETE) an interrupted transaction — which a dry run must never do.
#   * A rollback receipt left by an earlier rollback is not cleared. The
#     transaction library refuses to overwrite one, so a second rollback FAILs
#     rather than silently clobbering the first one's evidence. That is
#     fail-closed and deliberate; remove the stale receipt by hand if a second
#     rollback is genuinely wanted.
#
# See doc/08_tracking/todo/rollback_bootstrap_deploy_script_missing_2026-08-08.md.
#
# Usage:
#   sh scripts/bootstrap/rollback-bootstrap-deploy.shs [<canonical-triple>]
#   sh scripts/bootstrap/rollback-bootstrap-deploy.shs --dry-run [<canonical-triple>]
#   sh scripts/bootstrap/rollback-bootstrap-deploy.shs --selftest
#
# Fail-closed: absence of a deploy receipt is ERROR (exit 2), never a pass.
# Verdict line (last line of stdout), matching the scripts/check/*.shs
# convention documented in .claude/rules/vcs.md:
#   PASS  — <n> artifact(s) restored, ...          exit 0
#   FAIL  — ...                                    exit 1
#   ERROR — nothing was rolled back (<reason>)     exit 2
set -eu

SELF=$(basename "$0")
repo_root="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)"
cd "${repo_root}"

SELFTEST_EXPECTED=6

CR=$(printf '\r')
_HASH_TOOL=""
if command -v sha256sum >/dev/null 2>&1; then _HASH_TOOL=sha256sum
elif command -v shasum >/dev/null 2>&1; then _HASH_TOOL=shasum
elif command -v sha256 >/dev/null 2>&1; then _HASH_TOOL=sha256
fi
_TIMEOUT_BIN=""
_TIMEOUT_BIN_INIT=0

hash_file() {
  case "${_HASH_TOOL}" in
    sha256sum)
      _hf=$(sha256sum -- "$1") || return 1
      _hf=${_hf%%[[:space:]]*}
      printf '%s\n' "${_hf#\\}"
      ;;
    shasum)
      _hf=$(shasum -a 256 -- "$1") || return 1
      _hf=${_hf%%[[:space:]]*}
      printf '%s\n' "${_hf#\\}"
      ;;
    sha256) sha256 -q "$1" ;;
    *) echo "error: no SHA-256 tool" >&2; return 1 ;;
  esac
}

value() {
  _val_key="$1="
  _val_count=0
  _val_out=""
  while IFS= read -r _val_line || [ -n "${_val_line}" ]; do
    _val_line=${_val_line%$CR}
    case "${_val_line}" in
      "${_val_key}"*)
        _val_count=$((_val_count + 1))
        _val_out=${_val_line#"${_val_key}"}
        ;;
    esac
  done < "${receipt}"
  if [ "${_val_count}" -eq 1 ]; then
    printf '%s\n' "${_val_out}"
  fi
}

bounded_smoke() {
  if [ "${_TIMEOUT_BIN_INIT}" -eq 0 ]; then
    _TIMEOUT_BIN_INIT=1
    for _tb in /usr/bin/timeout timeout gtimeout; do
      if "${_tb}" --version >/dev/null 2>&1; then
        _TIMEOUT_BIN=${_tb}
        break
      fi
    done
  fi
  if [ -n "${_TIMEOUT_BIN}" ]; then
    "${_TIMEOUT_BIN}" 30 "$1" -c 'print(1+1)' </dev/null 2>/dev/null
    return $?
  fi
  smoke_out="${deploy_dir}/.rollback-smoke-out.$$"
  smoke_done="${deploy_dir}/.rollback-smoke-done.$$"
  rm -f "${smoke_done}"
  "$1" -c 'print(1+1)' </dev/null >"${smoke_out}" 2>/dev/null &
  smoke_pid=$!
  (
    watchdog_t=0
    while [ "${watchdog_t}" -lt 30 ] && [ ! -f "${smoke_done}" ]; do
      sleep 1 2>/dev/null || break
      watchdog_t=$((watchdog_t + 1))
    done
    if [ ! -f "${smoke_done}" ]; then
      kill "${smoke_pid}" 2>/dev/null || true
      sleep 1 2>/dev/null || true
      kill -KILL "${smoke_pid}" 2>/dev/null || true
    fi
  ) </dev/null >/dev/null 2>&1 &
  watchdog_pid=$!
  smoke_status=0
  wait "${smoke_pid}" || smoke_status=$?
  : >"${smoke_done}"
  kill "${watchdog_pid}" 2>/dev/null || true
  wait "${watchdog_pid}" 2>/dev/null || true
  rm -f "${smoke_done}"
  cat "${smoke_out}"
  rm -f "${smoke_out}"
  return "${smoke_status}"
}

fail_receipt() {
  { echo "schema=bootstrap-rollback-receipt-v1"; echo "platform=${platform}"; echo "rollback_status=fail"; echo "reason=$1"; echo "platform_acceptance_claimed=false"; } > "${rollback_receipt}.tmp.$$"
  mv "${rollback_receipt}.tmp.$$" "${rollback_receipt}"
  echo "error: rollback failed: $1" >&2
  echo "${SELF}: FAIL — $1"
  exit 1
}

# error_receipt: nothing exists to act on (no receipt, no backup, malformed
# provenance) — this is ERROR (exit 2), distinct from fail_receipt's FAIL
# (exit 1, evidence exists but is untrustworthy or unsafe to use).
error_receipt() {
  echo "error: rollback failed: $1" >&2
  echo "${SELF}: ERROR — nothing was rolled back ($1)"
  exit 2
}

detect_platform() {
  host_os=$(uname -s)
  host_arch=$(uname -m)
  case "${host_os}:${host_arch}" in
    Linux:x86_64) echo x86_64-unknown-linux-gnu ;;
    Linux:aarch64|Linux:arm64) echo aarch64-unknown-linux-gnu ;;
    Darwin:x86_64) echo x86_64-apple-darwin ;;
    Darwin:arm64|Darwin:aarch64) echo aarch64-apple-darwin ;;
    FreeBSD:x86_64|FreeBSD:amd64) echo x86_64-unknown-freebsd-elf ;;
    FreeBSD:aarch64|FreeBSD:arm64) echo aarch64-unknown-freebsd-elf ;;
    MINGW*:x86_64|MSYS*:x86_64) echo x86_64-pc-windows-gnu ;;
    *) return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# --selftest: three isolated subprocess fixtures under mktemp -d, never
# touching this repo's real bin/release/** or bin/simple. Each fixture copies
# THIS script's own current source into a private tmp tree and runs it there
# as a child (SIMPLE_ROLLBACK_SELFTEST_CHILD=1 skips the recursive selftest).
# Runs before every real invocation and is FATAL on failure (house
# convention; see scripts/check/check-tree-size-push.shs).
# ---------------------------------------------------------------------------
build_fixture_common() {
  fx=$1
  mkdir -p "${fx}/scripts/bootstrap" "${fx}/scripts/setup" "${fx}/bin/release/selftest-platform"
  cp "${repo_root}/scripts/bootstrap/rollback-bootstrap-deploy.shs" "${fx}/scripts/bootstrap/rollback-bootstrap-deploy.shs"
  chmod 755 "${fx}/scripts/bootstrap/rollback-bootstrap-deploy.shs"
  # The v3 fixtures exercise the real delegation, so the transaction library
  # goes into the fixture too. Without it the v3 path would ERROR on a missing
  # library instead of on the condition the fixture is actually testing.
  cp "${repo_root}/scripts/bootstrap/bootstrap-deploy-transaction.shs" "${fx}/scripts/bootstrap/bootstrap-deploy-transaction.shs"
  printf '%s\n' '#!/bin/sh' 'exit 0' > "${fx}/scripts/setup/setup.shs"
  chmod 755 "${fx}/scripts/setup/setup.shs"
}

write_fixture_binary() {
  # $1 = path, $2 = generation marker word
  printf '%s\n' '#!/bin/sh' '# enum construction: unregistered enum' "# $2-generation" 'echo 2' > "$1"
  chmod 755 "$1"
}

write_fixture_receipt() {
  # $1 = fixture root, $2 = current sha256, $3 = backup sha256
  {
    echo "schema=bootstrap-deploy-receipt-v1"
    echo "platform=selftest-platform"
    echo "current_path=bin/release/selftest-platform/simple"
    echo "current_sha256=$2"
    echo "backup_path=bin/release/selftest-platform/simple.pre_deploy"
    echo "backup_sha256=$3"
    echo "deployment_status=pass"
    echo "platform_acceptance_claimed=false"
  } > "$1/bin/release/selftest-platform/bootstrap-deploy-receipt.env"
}

run_fixture() {
  # $1 = fixture root; writes stdout/stderr to $1/out and $1/err, sets $rc
  set +e
  SIMPLE_ROLLBACK_SELFTEST_CHILD=1 sh "$1/scripts/bootstrap/rollback-bootstrap-deploy.shs" selftest-platform \
    >"$1/out" 2>"$1/err"
  rc=$?
  set -e
}

selftest_symlink() {
  case "$(uname -s 2>/dev/null || echo unknown)" in
    MINGW*|MSYS*|CYGWIN*)
      MSYS="${MSYS:+$MSYS }winsymlinks:nativestrict" ln -s "$1" "$2" 2>/dev/null ||
        MSYS="${MSYS:+$MSYS }winsymlinks" ln -s "$1" "$2"
      ;;
    *)
      ln -s "$1" "$2"
      ;;
  esac
}

# Fixture 1: a normal rollback restores the previous binary (must PASS).
selftest_case_normal() {
  fx=$(mktemp -d)
  build_fixture_common "${fx}"
  write_fixture_binary "${fx}/bin/release/selftest-platform/simple" current
  write_fixture_binary "${fx}/bin/release/selftest-platform/simple.pre_deploy" backup
  cur_hash=$(hash_file "${fx}/bin/release/selftest-platform/simple")
  back_hash=$(hash_file "${fx}/bin/release/selftest-platform/simple.pre_deploy")
  write_fixture_receipt "${fx}" "${cur_hash}" "${back_hash}"
  selftest_symlink "${fx}/bin/release/selftest-platform/simple" "${fx}/bin/simple"
  run_fixture "${fx}"
  out=$(cat "${fx}/out")
  ok=1
  [ "${rc}" -eq 0 ] || ok=0
  case "${out}" in *"rollback_status=pass"*) ;; *) ok=0 ;; esac
  case "${out}" in *"PASS — "*) ;; *) ok=0 ;; esac
  grep -q backup-generation "${fx}/bin/release/selftest-platform/simple" 2>/dev/null || ok=0
  grep -q current-generation "${fx}/bin/release/selftest-platform/simple.pre_deploy" 2>/dev/null || ok=0
  rm -rf "${fx}"
  [ "${ok}" -eq 1 ]
}

# Fixture 2: no prior deploy recorded — must ERROR, never a pass.
selftest_case_no_deploy() {
  fx=$(mktemp -d)
  build_fixture_common "${fx}"
  write_fixture_binary "${fx}/bin/release/selftest-platform/simple" current
  # Deliberately no bootstrap-deploy-receipt.env and no .pre_deploy: nothing
  # was ever deployed through this mechanism for this platform.
  run_fixture "${fx}"
  out=$(cat "${fx}/out")
  ok=1
  [ "${rc}" -eq 2 ] || ok=0
  case "${out}" in *"ERROR — nothing was rolled back"*) ;; *) ok=0 ;; esac
  rm -rf "${fx}"
  [ "${ok}" -eq 1 ]
}

# Fixture 3: a rollback that would leave bin/simple dangling — must FAIL.
selftest_case_dangling() {
  fx=$(mktemp -d)
  build_fixture_common "${fx}"
  write_fixture_binary "${fx}/bin/release/selftest-platform/simple" current
  write_fixture_binary "${fx}/bin/release/selftest-platform/simple.pre_deploy" backup
  cur_hash=$(hash_file "${fx}/bin/release/selftest-platform/simple")
  back_hash=$(hash_file "${fx}/bin/release/selftest-platform/simple.pre_deploy")
  write_fixture_receipt "${fx}" "${cur_hash}" "${back_hash}"
  # bin/simple points at a path that does not exist: already dangling, and a
  # completed rollback would still leave it dangling.
  selftest_symlink "${fx}/bin/release/selftest-platform/simple-ghost" "${fx}/bin/simple"
  run_fixture "${fx}"
  out=$(cat "${fx}/out")
  ok=1
  [ "${rc}" -eq 1 ] || ok=0
  case "${out}" in *"FAIL — "*) ;; *) ok=0 ;; esac
  grep -q current-generation "${fx}/bin/release/selftest-platform/simple" 2>/dev/null || ok=0
  grep -q backup-generation "${fx}/bin/release/selftest-platform/simple.pre_deploy" 2>/dev/null || ok=0
  rm -rf "${fx}"
  [ "${ok}" -eq 1 ]
}

# write_fixture_receipt_v3: the shape bootstrap-from-scratch.sh writes today.
# $1 = fixture root, $2 = generation id, $3 = previous_pointer_target
write_fixture_receipt_v3() {
  {
    echo "schema=bootstrap-deploy-receipt-v3"
    echo "platform=selftest-platform"
    echo "generation_id=$2"
    echo "generation_path=bin/release/.bootstrap-deploy-generations/selftest-platform/$2"
    echo "current_pointer_path=bin/release/selftest-platform/simple"
    echo "current_pointer_target=.bootstrap-deploy-generations/selftest-platform/$2"
    echo "previous_pointer_target=$3"
    echo "current_path=bin/release/selftest-platform/simple"
    echo "deployment_status=pass"
    echo "platform_acceptance_claimed=false"
  } > "$1/bin/release/selftest-platform/bootstrap-deploy-receipt.env"
}

# Fixture 4: a v3 receipt whose previous_pointer_target is `none` — the first
# deploy on this platform. There is no generation to go back to, so this must
# ERROR (exit 2), never silently pass and never claim it rolled something back.
selftest_case_v3_no_previous() {
  fx=$(mktemp -d)
  build_fixture_common "${fx}"
  write_fixture_binary "${fx}/bin/release/selftest-platform/simple" current
  write_fixture_receipt_v3 "${fx}" gen-0001 none
  run_fixture "${fx}"
  out=$(cat "${fx}/out")
  ok=1
  [ "${rc}" -eq 2 ] || ok=0
  case "${out}" in *"ERROR — nothing was rolled back"*) ;; *) ok=0 ;; esac
  case "${out}" in *"no previous generation"*) ;; *) ok=0 ;; esac
  rm -rf "${fx}"
  [ "${ok}" -eq 1 ]
}

# Fixture 5: a v3 receipt naming a previous generation, but the transaction
# library refuses (no generation tree, no manifests, no authority artefacts in
# this fixture). A refused rollback is FAIL (exit 1) — evidence exists but is
# not trustworthy — and the binary must be left exactly as it was.
selftest_case_v3_refused() {
  fx=$(mktemp -d)
  build_fixture_common "${fx}"
  write_fixture_binary "${fx}/bin/release/selftest-platform/simple" current
  write_fixture_receipt_v3 "${fx}" gen-0002 \
    .bootstrap-deploy-generations/selftest-platform/gen-0001
  run_fixture "${fx}"
  out=$(cat "${fx}/out")
  ok=1
  [ "${rc}" -eq 1 ] || ok=0
  case "${out}" in *"FAIL — "*) ;; *) ok=0 ;; esac
  grep -q current-generation "${fx}/bin/release/selftest-platform/simple" 2>/dev/null || ok=0
  rm -rf "${fx}"
  [ "${ok}" -eq 1 ]
}

# Fixture 6: a receipt with a schema this script does not implement. Dispatch
# must be fail-closed: an unknown schema is ERROR, never treated as v1.
selftest_case_unknown_schema() {
  fx=$(mktemp -d)
  build_fixture_common "${fx}"
  write_fixture_binary "${fx}/bin/release/selftest-platform/simple" current
  {
    echo "schema=bootstrap-deploy-receipt-v99"
    echo "platform=selftest-platform"
    echo "current_path=bin/release/selftest-platform/simple"
  } > "${fx}/bin/release/selftest-platform/bootstrap-deploy-receipt.env"
  run_fixture "${fx}"
  out=$(cat "${fx}/out")
  ok=1
  [ "${rc}" -eq 2 ] || ok=0
  case "${out}" in *"ERROR — nothing was rolled back"*) ;; *) ok=0 ;; esac
  case "${out}" in *"unsupported schema"*) ;; *) ok=0 ;; esac
  rm -rf "${fx}"
  [ "${ok}" -eq 1 ]
}

selftest() {
  selftest_case_normal || { echo "${SELF}: SELFTEST FAIL: a normal rollback did not restore the previous binary" >&2; return 1; }
  selftest_case_no_deploy || { echo "${SELF}: SELFTEST FAIL: a rollback with no prior deploy recorded did not ERROR" >&2; return 1; }
  selftest_case_dangling || { echo "${SELF}: SELFTEST FAIL: a rollback that would leave bin/simple dangling did not FAIL" >&2; return 1; }
  selftest_case_v3_no_previous || { echo "${SELF}: SELFTEST FAIL: a v3 receipt with no previous generation did not ERROR" >&2; return 1; }
  selftest_case_v3_refused || { echo "${SELF}: SELFTEST FAIL: a v3 rollback the transaction library refuses did not FAIL" >&2; return 1; }
  selftest_case_unknown_schema || { echo "${SELF}: SELFTEST FAIL: an unknown deploy receipt schema did not ERROR" >&2; return 1; }
  return 0
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
dry_run=0
do_selftest=0
platform=""
for arg in "$@"; do
  case "${arg}" in
    --dry-run) dry_run=1 ;;
    --selftest) do_selftest=1 ;;
    -*)
      echo "error: unknown flag '${arg}'" >&2
      echo "${SELF}: ERROR — nothing was rolled back (unknown flag ${arg})"
      exit 2
      ;;
    *)
      if [ -n "${platform}" ]; then
        echo "error: multiple platform arguments given" >&2
        echo "${SELF}: ERROR — nothing was rolled back (multiple platform arguments)"
        exit 2
      fi
      platform=${arg}
      ;;
  esac
done

if [ "${SIMPLE_ROLLBACK_SELFTEST_CHILD:-0}" != "1" ]; then
  if ! selftest; then
    echo "${SELF}: ERROR — selftest failed; the rollback script is not trustworthy" >&2
    echo "${SELF}: ERROR — nothing was rolled back (selftest failed)"
    exit 2
  fi
fi

if [ "${do_selftest}" -eq 1 ]; then
  echo "${SELF}: PASS — ${SELFTEST_EXPECTED} fixture(s) checked (selftest only, rollback skipped)"
  exit 0
fi

if [ -z "${platform}" ]; then
  if ! platform=$(detect_platform); then
    echo "error: unsupported host; pass the canonical platform triple" >&2
    echo "${SELF}: ERROR — nothing was rolled back (unsupported host $(uname -s):$(uname -m))"
    exit 2
  fi
fi
case "${platform}" in '.'|'..'|*[!A-Za-z0-9._-]*|'') echo "error: invalid platform" >&2; echo "${SELF}: ERROR — nothing was rolled back (invalid platform)"; exit 2;; esac

deploy_dir="bin/release/${platform}"
receipt="${deploy_dir}/bootstrap-deploy-receipt.env"
rollback_receipt="${deploy_dir}/bootstrap-rollback-receipt.env"
lock="${deploy_dir}/.bootstrap-deploy.lock"
[ ! -L "bin" ] && [ ! -L "bin/release" ] && [ ! -L "${deploy_dir}" ] || { echo "error: symlinked deployment path" >&2; echo "${SELF}: ERROR — nothing was rolled back (symlinked deployment path)"; exit 2; }
mkdir "${lock}" 2>/dev/null || { echo "error: deployment is locked" >&2; echo "${SELF}: ERROR — nothing was rolled back (deployment is locked)"; exit 2; }
trap 'rm -rf "${lock}"' EXIT
trap 'exit 130' HUP INT TERM

if [ -L "${receipt}" ]; then fail_receipt receipt_symlink; fi
[ -f "${receipt}" ] || error_receipt "no deploy receipt recorded for platform ${platform} (expected ${receipt})"
receipt_schema="$(value schema)"
case "${receipt_schema}" in
  bootstrap-deploy-receipt-v1|bootstrap-deploy-receipt-v3) ;;
  *) error_receipt "deploy receipt has unsupported schema '${receipt_schema}' (expected bootstrap-deploy-receipt-v1 or bootstrap-deploy-receipt-v3)" ;;
esac
[ "$(value platform)" = "${platform}" ] || error_receipt "deploy receipt platform mismatch (expected ${platform})"

# -------------------------------------------------------------------------
# v3: generation-pointer rollback, delegated to the transaction library that
# owns the format. This script contributes the entrypoint, the fail-closed
# preconditions, the dry-run, and the verdict convention; it deliberately does
# NOT reimplement manifest/authority verification or the pointer swap, because
# a second implementation of that contract is exactly how the two halves fell
# out of step in the first place.
# -------------------------------------------------------------------------
if [ "${receipt_schema}" = "bootstrap-deploy-receipt-v3" ]; then
  tx_lib="${repo_root}/scripts/bootstrap/bootstrap-deploy-transaction.shs"
  [ -f "${tx_lib}" ] && [ ! -L "${tx_lib}" ] || error_receipt "deploy transaction library ${tx_lib} is missing; a v3 receipt cannot be rolled back without it"
  generation_id="$(value generation_id)"
  previous_target="$(value previous_pointer_target)"
  case "${generation_id}" in '.'|'..'|*[!A-Za-z0-9._-]*|'') error_receipt "v3 deploy receipt has an unusable generation_id" ;; esac
  [ -n "${previous_target}" ] || error_receipt "v3 deploy receipt records no previous_pointer_target"
  if [ "${previous_target}" = none ]; then
    error_receipt "no previous generation recorded for platform ${platform} (generation ${generation_id} is the first deploy; there is nothing to roll back to)"
  fi
  if [ "${dry_run}" -eq 1 ]; then
    echo "dry_run=true"
    echo "platform=${platform}"
    echo "receipt_schema=${receipt_schema}"
    echo "would_roll_back_generation_id=${generation_id}"
    echo "would_restore_pointer_target=${previous_target}"
    echo "${SELF}: DRY-RUN — would restore 1 artifact(s): pointer ${deploy_dir}/simple -> ${previous_target} (rolling back generation ${generation_id})"
    exit 0
  fi
  # shellcheck source=scripts/bootstrap/bootstrap-deploy-transaction.shs
  . "${tx_lib}"
  tx_status=0
  bootstrap_deploy_tx_rollback_generation \
    "${repo_root}/bin/release" "${platform}" "${generation_id}" \
    "${repo_root}/${rollback_receipt}" || tx_status=$?
  # Read on the line after the call, never through a pipe: a pipeline's $? is
  # the last command's status and has produced false greens in this repo.
  if [ "${tx_status}" -ne 0 ]; then
    fail_receipt "transaction rollback of generation ${generation_id} refused (bootstrap_deploy_tx_rollback_generation exit ${tx_status})"
  fi
  [ -f "${repo_root}/${rollback_receipt}" ] || fail_receipt "transaction rollback reported success but wrote no rollback receipt"
  echo "rollback_status=pass"
  echo "rollback_receipt=${rollback_receipt}"
  echo "${SELF}: PASS — 1 artifact(s) restored (pointer ${deploy_dir}/simple -> ${previous_target}, generation ${generation_id} rolled back)"
  exit 0
fi
current="$(value current_path)"; backup="$(value backup_path)"
[ "${current}" = "${deploy_dir}/simple" ] || [ "${current}" = "${deploy_dir}/simple.exe" ] || fail_receipt current_path
[ "${backup}" = "${current}.pre_deploy" ] || fail_receipt backup_path
[ -f "${current}" ] && [ ! -L "${current}" ] || error_receipt "current binary ${current} is missing or a symlink"
[ -f "${backup}" ] && [ ! -L "${backup}" ] || error_receipt "retained backup ${backup} is missing or a symlink (nothing to roll back to)"
expected_current_hash="$(value current_sha256)"
expected_backup_hash="$(value backup_sha256)"
[ "$(hash_file "${current}")" = "${expected_current_hash}" ] || fail_receipt current_hash
[ "$(hash_file "${backup}")" = "${expected_backup_hash}" ] || fail_receipt backup_hash

# A rollback is refused, never completed, if it would leave bin/simple — the
# repo's single canonical compiler entrypoint (see .claude/rules/structure.md)
# — a dangling symlink. bin/simple already broken before we touch anything
# means completing the rollback would still leave it broken.
if [ -L "bin/simple" ] && [ ! -e "bin/simple" ]; then
  fail_receipt dangling_bin_simple
fi

candidate="${current}.rollback_candidate.$$"
install -m755 "${backup}" "${candidate}"
[ "$(hash_file "${candidate}")" = "${expected_backup_hash}" ] || { rm -f "${candidate}"; fail_receipt candidate_hash; }
marker='enum construction: unregistered enum'
if ! grep -a -q "${marker}" "${candidate}" 2>/dev/null; then
  rm -f "${candidate}"
  fail_receipt rollback_smoke
fi
set +e
smoke_output="$(bounded_smoke "${candidate}" 2>/dev/null)"
smoke_rc=$?
set -e
if [ "${smoke_rc}" -ne 0 ] || [ "${smoke_output}" != "2" ]; then
  rm -f "${candidate}"
  fail_receipt rollback_smoke
fi

if [ "${dry_run}" -eq 1 ]; then
  rm -f "${candidate}"
  echo "dry_run=true"
  echo "platform=${platform}"
  echo "would_restore=${current}"
  echo "from_backup=${backup}"
  echo "current_sha256=${expected_current_hash}"
  echo "restored_sha256_would_be=${expected_backup_hash}"
  echo "smoke_output=${smoke_output}"
  echo "${SELF}: DRY-RUN — would restore 1 artifact(s): ${current} (from ${backup}, sha256 ${expected_backup_hash})"
  exit 0
fi

pre_rollback_hash="${expected_current_hash}"
old="${current}.rollback_old.$$"
install -m755 "${current}" "${old}"
rm -f "${receipt}" "${rollback_receipt}"
mv "${candidate}" "${current}"
if [ "$(uname -s)" != "Windows_NT" ] && ! "${repo_root}/scripts/setup/setup.shs"; then
  mv "${old}" "${current}" || fail_receipt restore_failed
  fail_receipt setup
fi
backup_tmp="${backup}.tmp.$$"
install -m755 "${old}" "${backup_tmp}"
mv "${backup_tmp}" "${backup}"
rm -f "${old}"
restored_hash="$(hash_file "${current}")"
{
  echo "schema=bootstrap-rollback-receipt-v1"
  echo "platform=${platform}"
  echo "command=$0 ${platform}"
  echo "current_path=${current}"
  echo "pre_rollback_sha256=${pre_rollback_hash}"
  echo "current_sha256=${restored_hash}"
  echo "restored_sha256=${restored_hash}"
  echo "backup_path=${backup}"
  echo "backup_sha256=$(hash_file "${backup}")"
  echo "smoke_output=${smoke_output}"
  echo "exit_status=0"
  echo "timestamp_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "rollback_status=pass"
  echo "platform_acceptance_claimed=false"
} > "${rollback_receipt}.tmp.$$"
mv "${rollback_receipt}.tmp.$$" "${rollback_receipt}"
echo "rollback_status=pass"
echo "rollback_receipt=${rollback_receipt}"
echo "${SELF}: PASS — 1 artifact(s) restored (${current} <- ${backup}, sha256 ${restored_hash})"
