#!/bin/sh
# Atomic rollback for a deployed Stage4 binary.
#
# Usage:
#   sh scripts/bootstrap/rollback-bootstrap-deploy.shs \
#     [--deployed PATH] [--backup PATH] [--receipt PATH]
#
# The input receipt is an exact stage4-deploy-v1 record. A successful
# rollback writes an exact stage4-rollback-v1 record. The receipt rename is
# the transaction commit point; cleanup after that point is best effort.
#
# This contract guarantees namespace atomicity through same-directory
# renames. It does not claim crash durability because portable POSIX fsync
# ownership is not available here.
#
# Receipt schemas are closed within a version: adding, removing, or renaming a
# field requires a schema version bump. The deployment helper must acquire the
# same neutral <deployed>.stage4-state.lock before changing binary or receipt
# state.

set -u

deployed=${SIMPLE_DEPLOYED_BIN:-bin/simple}
backup=${SIMPLE_BACKUP_BIN:-}
receipt=${SIMPLE_ROLLBACK_RECEIPT:-}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --deployed)
      [ "$#" -ge 2 ] || { echo "rollback: --deployed requires a path" >&2; exit 2; }
      deployed=$2
      shift 2
      ;;
    --backup)
      [ "$#" -ge 2 ] || { echo "rollback: --backup requires a path" >&2; exit 2; }
      backup=$2
      shift 2
      ;;
    --receipt)
      [ "$#" -ge 2 ] || { echo "rollback: --receipt requires a path" >&2; exit 2; }
      receipt=$2
      shift 2
      ;;
    --help|-h)
      sed -n '2,18p' "$0"
      exit 0
      ;;
    *)
      echo "rollback: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

[ -n "$backup" ] || backup="${deployed}.pre_deploy"
[ -n "$receipt" ] || receipt="${deployed}.deploy.receipt"

fail() {
  echo "rollback: $*" >&2
  exit 1
}

path_has_newline() {
  case "$1" in
    *"
"*) return 0 ;;
  esac
  return 1
}

canonical_path() {
  path=$1
  case "$path" in
    /*) absolute=$path ;;
    *) absolute="$(pwd -P)/$path" ;;
  esac
  parent=$(dirname "$absolute") || return 1
  name=$(basename "$absolute") || return 1
  parent=$(CDPATH= cd "$parent" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s\n' "$parent" "$name"
}

hash_file() {
  file=$1
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | awk '{print $1}'
    return
  fi
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" | awk '{print $1}'
    return
  fi
  if command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 "$file" | awk '{print $NF}'
    return
  fi
  return 1
}

valid_hash() {
  printf '%s\n' "$1" | awk 'length($0) == 64 && $0 ~ /^[[:xdigit:]]+$/ { exit 0 } { exit 1 }'
}

valid_timestamp_utc() {
  printf '%s\n' "$1" | awk '
    length($0) == 20 &&
    $0 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z$/ {
      year = substr($0, 1, 4) + 0
      month = substr($0, 6, 2) + 0
      day = substr($0, 9, 2) + 0
      hour = substr($0, 12, 2) + 0
      minute = substr($0, 15, 2) + 0
      second = substr($0, 18, 2) + 0
      if (month < 1 || month > 12 || hour > 23 || minute > 59 || second > 59) exit 1
      days[1] = 31; days[2] = 28; days[3] = 31; days[4] = 30
      days[5] = 31; days[6] = 30; days[7] = 31; days[8] = 31
      days[9] = 30; days[10] = 31; days[11] = 30; days[12] = 31
      if ((year % 400 == 0) || (year % 4 == 0 && year % 100 != 0)) days[2] = 29
      if (day < 1 || day > days[month]) exit 1
      exit 0
    }
    { exit 1 }
  '
}

mode_file() {
  mode=$(stat -c '%a' "$1" 2>/dev/null) && {
    printf '%s\n' "$mode"
    return
  }
  stat -f '%Lp' "$1" 2>/dev/null
}

receipt_value() {
  key=$1
  awk -F '=' -v wanted="$key" '
    $1 == wanted {
      value = $0
      sub(/^[^=]*=/, "", value)
      print value
      count++
    }
    END { if (count != 1) exit 1 }
  ' "$receipt"
}

validate_exact_schema() {
  schema_file=$1
  schema_name=$2
  schema_keys=$3
  awk -F '=' -v wanted_schema="$schema_name" -v keys="$schema_keys" '
    BEGIN {
      key_count = split(keys, expected, " ")
      for (i = 1; i <= key_count; i++) allowed[expected[i]] = 1
    }
    {
      if (index($0, "=") == 0 || $1 == "" || !($1 in allowed)) invalid = 1
      if (++seen[$1] != 1) invalid = 1
      value = substr($0, index($0, "=") + 1)
      values[$1] = value
    }
    END {
      for (i = 1; i <= key_count; i++) {
        if (seen[expected[i]] != 1) invalid = 1
      }
      if (values["schema"] != wanted_schema) invalid = 1
      if (invalid) exit 1
      exit 0
    }
  ' "$schema_file"
}

validate_success_receipt() {
  validate_exact_schema "$receipt" stage4-rollback-v1 \
    'schema status timestamp_utc deployed_path backup_path receipt_path prior_receipt_sha256 before_sha256 backup_sha256 restored_sha256 before_mode restored_mode' || return 1
  [ "$(receipt_value status)" = success ] || return 1
  [ "$(receipt_value deployed_path)" = "$deployed" ] || return 1
  [ "$(receipt_value backup_path)" = "$backup" ] || return 1
  [ "$(receipt_value receipt_path)" = "$receipt" ] || return 1

  success_timestamp=$(receipt_value timestamp_utc) || return 1
  success_prior_hash=$(receipt_value prior_receipt_sha256) || return 1
  success_before_hash=$(receipt_value before_sha256) || return 1
  success_backup_hash=$(receipt_value backup_sha256) || return 1
  success_restored_hash=$(receipt_value restored_sha256) || return 1
  success_before_mode=$(receipt_value before_mode) || return 1
  success_restored_mode=$(receipt_value restored_mode) || return 1
  success_prior_hash=$(printf '%s' "$success_prior_hash" | tr 'A-F' 'a-f')
  success_before_hash=$(printf '%s' "$success_before_hash" | tr 'A-F' 'a-f')
  success_backup_hash=$(printf '%s' "$success_backup_hash" | tr 'A-F' 'a-f')
  success_restored_hash=$(printf '%s' "$success_restored_hash" | tr 'A-F' 'a-f')

  valid_timestamp_utc "$success_timestamp" || return 1
  valid_hash "$success_prior_hash" || return 1
  valid_hash "$success_before_hash" || return 1
  valid_hash "$success_backup_hash" || return 1
  valid_hash "$success_restored_hash" || return 1
  [ "$success_backup_hash" = "$success_restored_hash" ] || return 1
  case "$success_before_mode:$success_restored_mode" in
    *[!0-7:]*|'') return 1 ;;
  esac

  success_actual_hash=$(hash_file "$deployed") || return 1
  success_actual_hash=$(printf '%s' "$success_actual_hash" | tr 'A-F' 'a-f')
  [ "$success_actual_hash" = "$success_restored_hash" ] || return 1
  success_actual_mode=$(mode_file "$deployed") || return 1
  [ "$success_actual_mode" = "$success_restored_mode" ] || return 1
  success_actual_hash=$(hash_file "$backup") || return 1
  success_actual_hash=$(printf '%s' "$success_actual_hash" | tr 'A-F' 'a-f')
  [ "$success_actual_hash" = "$success_backup_hash" ] || return 1
  success_actual_mode=$(mode_file "$backup") || return 1
  [ "$success_actual_mode" = "$success_restored_mode" ] || return 1
  return 0
}

make_temp() {
  base=$1
  attempt=0
  while [ "$attempt" -lt 20 ]; do
    candidate="${base}.rollback.$$.$attempt"
    if (set -C; : > "$candidate") 2>/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
    attempt=$((attempt + 1))
  done
  return 1
}

mv_command=${SIMPLE_ROLLBACK_MV:-}
rm_command=${SIMPLE_ROLLBACK_RM:-}
run_mv() {
  if [ -n "$mv_command" ]; then
    "$mv_command" "$@"
  else
    mv "$@"
  fi
}

run_rm() {
  if [ -n "$rm_command" ]; then
    "$rm_command" "$@"
  else
    rm "$@"
  fi
}

validate_path_argument() {
  path_value=$1
  [ -n "$path_value" ] || fail "paths must not be empty"
  path_has_newline "$path_value" && fail "paths must not contain newlines"
}

validate_path_argument "$deployed"
validate_path_argument "$backup"
validate_path_argument "$receipt"

[ -L "$deployed" ] && fail "deployed path must not be a symlink"
[ -L "$backup" ] && fail "backup path must not be a symlink"
[ -L "$receipt" ] && fail "receipt path must not be a symlink"

deployed_canonical=$(canonical_path "$deployed") || fail "cannot canonicalize deployed path"
backup_canonical=$(canonical_path "$backup") || fail "cannot canonicalize backup path"
receipt_canonical=$(canonical_path "$receipt") || fail "cannot canonicalize receipt path"
[ "$deployed_canonical" != "$backup_canonical" ] || fail "deployed and backup paths must differ"
[ "$deployed_canonical" != "$receipt_canonical" ] || fail "deployed and receipt paths must differ"
[ "$backup_canonical" != "$receipt_canonical" ] || fail "backup and receipt paths must differ"

deployed=$deployed_canonical
backup=$backup_canonical
receipt=$receipt_canonical
[ -f "$deployed" ] || fail "deployed binary is missing: $deployed"
[ -f "$backup" ] || fail "backup binary is missing: $backup"
[ -f "$receipt" ] || fail "deployment receipt is missing: $receipt"
[ -L "$deployed" ] || [ -L "$backup" ] || [ -L "$receipt" ] && fail "rollback paths must not be symlinks"

receipt_schema=$(receipt_value schema) || fail "receipt schema is missing or duplicated"
case "$receipt_schema" in
  stage4-deploy-v1)
    validate_exact_schema "$receipt" stage4-deploy-v1 \
      'schema status deployed_path backup_path deployed_sha256 backup_sha256' ||
      fail "deployment receipt schema is not exact"
    ;;
  stage4-rollback-v1)
    lock_dir="${deployed}.stage4-state.lock"
    mkdir "$lock_dir" 2>/dev/null || fail "deployment-state lock is already held: $lock_dir"
    trap 'rmdir "$lock_dir" 2>/dev/null || :; exit 129' 1
    trap 'rmdir "$lock_dir" 2>/dev/null || :; exit 130' 2
    trap 'rmdir "$lock_dir" 2>/dev/null || :; exit 131' 3
    trap 'rmdir "$lock_dir" 2>/dev/null || :; exit 143' 15
    if ! validate_success_receipt; then
      rmdir "$lock_dir" 2>/dev/null || :
      trap - 1 2 3 15
      fail "successful rollback receipt is invalid or stale"
    fi
    rmdir "$lock_dir" 2>/dev/null || fail "cannot release deployment-state lock"
    trap - 1 2 3 15
    echo "rollback status=success idempotent=1 deployed=$deployed backup=$backup receipt=$receipt"
    exit 0
    ;;
  *)
    fail "unsupported receipt schema: $receipt_schema"
    ;;
esac

receipt_status=$(receipt_value status) || fail "receipt status is missing"
[ "$receipt_status" = deployed ] || fail "receipt status is not deployed"
receipt_deployed_path=$(receipt_value deployed_path) || fail "receipt is missing deployed_path"
receipt_backup_path=$(receipt_value backup_path) || fail "receipt is missing backup_path"
expected_deployed_hash=$(receipt_value deployed_sha256) || fail "receipt is missing deployed_sha256"
expected_backup_hash=$(receipt_value backup_sha256) || fail "receipt is missing backup_sha256"
[ "$receipt_deployed_path" = "$deployed" ] || fail "receipt deployed path mismatch"
[ "$receipt_backup_path" = "$backup" ] || fail "receipt backup path mismatch"
expected_deployed_hash=$(printf '%s' "$expected_deployed_hash" | tr 'A-F' 'a-f')
expected_backup_hash=$(printf '%s' "$expected_backup_hash" | tr 'A-F' 'a-f')
valid_hash "$expected_deployed_hash" || fail "receipt deployed hash is invalid"
valid_hash "$expected_backup_hash" || fail "receipt backup hash is invalid"

lock_dir="${deployed}.stage4-state.lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
  fail "deployment-state lock is already held: $lock_dir"
fi

before_tmp=
stage_tmp=
receipt_tmp=
recovery_tmp=
replacement_done=0
receipt_committed=0
cleanup_running=0

cleanup() {
  status=$?
  [ "$cleanup_running" -eq 0 ] || exit "$status"
  cleanup_running=1

  # A signal may arrive after the receipt rename but before the in-memory
  # state transition. The exact on-disk receipt is authoritative at cleanup.
  if [ "$replacement_done" -eq 1 ] && [ "$receipt_committed" -eq 0 ] && validate_success_receipt; then
    receipt_committed=1
    replacement_done=0
  fi

  if [ "$replacement_done" -eq 1 ] && [ "$receipt_committed" -eq 0 ]; then
    if recover_deployment; then
      if run_rm -f "$before_tmp" 2>/dev/null; then
        before_tmp=
      else
        echo "rollback: recovery succeeded; safeguard retained at $before_tmp" >&2
      fi
    else
      echo "rollback: recovery failed; safeguard retained at $before_tmp" >&2
    fi
  elif [ "$receipt_committed" -eq 0 ] && [ -n "$before_tmp" ]; then
    run_rm -f "$before_tmp" 2>/dev/null || :
    before_tmp=
  fi

  [ -n "$recovery_tmp" ] && run_rm -f "$recovery_tmp" 2>/dev/null || :
  [ -n "$stage_tmp" ] && run_rm -f "$stage_tmp" 2>/dev/null || :
  [ -n "$receipt_tmp" ] && run_rm -f "$receipt_tmp" 2>/dev/null || :

  if [ "$receipt_committed" -eq 1 ] && [ -n "$before_tmp" ]; then
    if run_rm -f "$before_tmp" 2>/dev/null; then
      before_tmp=
    else
      echo "rollback: rollback committed; safeguard retained at $before_tmp" >&2
    fi
  fi
  rmdir "$lock_dir" 2>/dev/null || :
  trap - EXIT
  exit "$status"
}

trap cleanup 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 131' 3
trap 'exit 143' 15

recover_deployment() {
  [ "$replacement_done" -eq 1 ] || return 0
  [ -n "$before_tmp" ] || return 1
  [ -f "$before_tmp" ] || return 1

  recovery_tmp=$(make_temp "$deployed") || return 1
  if ! cp "$before_tmp" "$recovery_tmp" || ! chmod "$before_mode" "$recovery_tmp"; then
    return 1
  fi
  recovery_hash=$(hash_file "$recovery_tmp") || return 1
  recovery_hash=$(printf '%s' "$recovery_hash" | tr 'A-F' 'a-f')
  [ "$recovery_hash" = "$before_hash" ] || return 1
  recovery_mode=$(mode_file "$recovery_tmp") || return 1
  [ "$recovery_mode" = "$before_mode" ] || return 1
  run_mv -f "$recovery_tmp" "$deployed" || return 1
  recovery_tmp=
  recovery_hash=$(hash_file "$deployed") || return 1
  recovery_hash=$(printf '%s' "$recovery_hash" | tr 'A-F' 'a-f')
  recovery_mode=$(mode_file "$deployed") || return 1
  [ "$recovery_hash" = "$before_hash" ] || return 1
  [ "$recovery_mode" = "$before_mode" ] || return 1
  replacement_done=0
  return 0
}

before_hash=$(hash_file "$deployed") || fail "no SHA-256 tool is available"
backup_hash=$(hash_file "$backup") || fail "cannot hash backup binary"
prior_receipt_hash=$(hash_file "$receipt") || fail "cannot hash deployment receipt"
before_hash=$(printf '%s' "$before_hash" | tr 'A-F' 'a-f')
backup_hash=$(printf '%s' "$backup_hash" | tr 'A-F' 'a-f')
prior_receipt_hash=$(printf '%s' "$prior_receipt_hash" | tr 'A-F' 'a-f')
[ "$before_hash" = "$expected_deployed_hash" ] || fail "deployed hash does not match receipt"
[ "$backup_hash" = "$expected_backup_hash" ] || fail "backup hash does not match receipt"
valid_hash "$prior_receipt_hash" || fail "deployment receipt hash is invalid"

before_mode=$(mode_file "$deployed") || fail "cannot inspect deployed mode"
backup_mode=$(mode_file "$backup") || fail "cannot inspect backup mode"
case "$before_mode:$backup_mode" in
  *[!0-7:]*|'') fail "file mode is invalid" ;;
esac

before_tmp=$(make_temp "$deployed") || fail "cannot create same-filesystem safeguard"
stage_tmp=$(make_temp "$deployed") || fail "cannot create same-filesystem staging file"
if ! cp "$deployed" "$before_tmp" || ! chmod "$before_mode" "$before_tmp"; then
  fail "cannot stage current deployment safeguard"
fi
if ! cp "$backup" "$stage_tmp" || ! chmod "$backup_mode" "$stage_tmp"; then
  fail "cannot stage backup binary"
fi

# Revalidate all mutable inputs immediately before the namespace commit.
current_hash=$(hash_file "$deployed") || fail "cannot revalidate deployed binary"
current_hash=$(printf '%s' "$current_hash" | tr 'A-F' 'a-f')
[ "$current_hash" = "$before_hash" ] || fail "deployed binary changed during rollback"
current_hash=$(hash_file "$backup") || fail "cannot revalidate backup binary"
current_hash=$(printf '%s' "$current_hash" | tr 'A-F' 'a-f')
[ "$current_hash" = "$backup_hash" ] || fail "backup binary changed during rollback"
current_hash=$(hash_file "$receipt") || fail "cannot revalidate deployment receipt"
current_hash=$(printf '%s' "$current_hash" | tr 'A-F' 'a-f')
[ "$current_hash" = "$prior_receipt_hash" ] || fail "deployment receipt changed during rollback"
staged_hash=$(hash_file "$stage_tmp") || fail "cannot hash staged backup"
staged_hash=$(printf '%s' "$staged_hash" | tr 'A-F' 'a-f')
[ "$staged_hash" = "$backup_hash" ] || fail "staged backup changed during rollback"

run_mv -f "$stage_tmp" "$deployed" || fail "atomic deployed replacement failed"
stage_tmp=
replacement_done=1

restored_hash=$(hash_file "$deployed") || fail "cannot hash restored binary"
restored_hash=$(printf '%s' "$restored_hash" | tr 'A-F' 'a-f')
restored_mode=$(mode_file "$deployed") || fail "cannot inspect restored mode"
[ "$restored_hash" = "$backup_hash" ] || fail "restored hash does not match backup hash"
[ "$restored_mode" = "$backup_mode" ] || fail "restored mode does not match backup mode"

timestamp_utc=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || fail "cannot obtain UTC timestamp"
receipt_tmp=$(make_temp "$receipt") || fail "cannot create atomic rollback receipt"
if ! {
  printf '%s\n' \
    'schema=stage4-rollback-v1' \
    'status=success' \
    "timestamp_utc=$timestamp_utc" \
    "deployed_path=$deployed" \
    "backup_path=$backup" \
    "receipt_path=$receipt" \
    "prior_receipt_sha256=$prior_receipt_hash" \
    "before_sha256=$before_hash" \
    "backup_sha256=$backup_hash" \
    "restored_sha256=$restored_hash" \
    "before_mode=$before_mode" \
    "restored_mode=$restored_mode" > "$receipt_tmp" &&
  chmod 644 "$receipt_tmp" &&
  validate_exact_schema "$receipt_tmp" stage4-rollback-v1 \
    'schema status timestamp_utc deployed_path backup_path receipt_path prior_receipt_sha256 before_sha256 backup_sha256 restored_sha256 before_mode restored_mode' &&
  run_mv -f "$receipt_tmp" "$receipt"
then
  fail "atomic rollback receipt write failed"
fi
receipt_tmp=
receipt_committed=1
replacement_done=0

echo "rollback status=success deployed=$deployed backup=$backup receipt=$receipt"
exit 0
