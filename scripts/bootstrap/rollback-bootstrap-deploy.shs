#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
. "$repo_root/scripts/setup/release-platform.shs"
. "$repo_root/scripts/bootstrap/bootstrap-deploy-transaction.shs"
. "$repo_root/scripts/check/lib/portable-process-lock.shs"

if [ "$#" -gt 0 ]; then
  platform=$1
else
  case "$(uname -s):$(uname -m)" in
    Linux:x86_64) platform=x86_64-unknown-linux-gnu ;;
    Linux:aarch64|Linux:arm64) platform=aarch64-unknown-linux-gnu ;;
    Darwin:x86_64) platform=x86_64-apple-darwin ;;
    Darwin:arm64|Darwin:aarch64) platform=aarch64-apple-darwin ;;
    FreeBSD:x86_64|FreeBSD:amd64) platform=x86_64-unknown-freebsd-elf ;;
    FreeBSD:aarch64|FreeBSD:arm64) platform=aarch64-unknown-freebsd-elf ;;
    MINGW*:x86_64|MSYS*:x86_64) platform=x86_64-pc-windows-gnu ;;
    *) exit 2 ;;
  esac
fi
deploy_platform=$(simple_release_platform_dir "$platform") || exit 2
release_root="$repo_root/bin/release"
deploy_path="$release_root/$deploy_platform"
lock_root="$release_root/.bootstrap-deploy-locks"
portable_lock_acquire "$lock_root" "$deploy_platform" 30 || exit 1
lock_handle=$PORTABLE_LOCK_HANDLE
trap 'portable_lock_release "$lock_handle"' EXIT HUP INT TERM
bootstrap_deploy_tx_recover "$release_root" "$deploy_platform" || exit 1
BOOTSTRAP_DEPLOY_TX_AUTHORITY_VERIFIER="$repo_root/scripts/bootstrap/verify-bootstrap-deploy-generation-authority.shs"
export BOOTSTRAP_DEPLOY_TX_AUTHORITY_VERIFIER
[ -L "$deploy_path" ] || exit 1
current_target=$(readlink "$deploy_path") || exit 1
current_generation=${current_target##*/}
rollback_receipt="$release_root/.bootstrap-deploy-control/${deploy_platform}.rollback-${current_generation}.env"
bootstrap_deploy_tx_rollback_generation "$release_root" "$deploy_platform" \
  "$current_generation" "$rollback_receipt" || exit 1
printf 'rollback_status=pass\nrollback_receipt=%s\n' "$rollback_receipt"
