#!/bin/sh
set -eu

repo_root="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)"
cd "${repo_root}"
if [ "$#" -gt 0 ]; then
  platform=$1
else
  host_os=$(uname -s)
  host_arch=$(uname -m)
  case "${host_os}:${host_arch}" in
    Linux:x86_64) platform=x86_64-unknown-linux-gnu ;;
    Linux:aarch64|Linux:arm64) platform=aarch64-unknown-linux-gnu ;;
    Darwin:x86_64) platform=x86_64-apple-darwin ;;
    Darwin:arm64|Darwin:aarch64) platform=aarch64-apple-darwin ;;
    FreeBSD:x86_64|FreeBSD:amd64) platform=x86_64-unknown-freebsd-elf ;;
    FreeBSD:aarch64|FreeBSD:arm64) platform=aarch64-unknown-freebsd-elf ;;
    MINGW*:x86_64|MSYS*:x86_64) platform=x86_64-pc-windows-gnu ;;
    *) echo "error: unsupported host; pass the canonical platform triple" >&2; exit 2 ;;
  esac
fi
case "${platform}" in '.'|'..'|*[!A-Za-z0-9._-]*|'') echo "error: invalid platform" >&2; exit 2;; esac
deploy_dir="bin/release/${platform}"
receipt="${deploy_dir}/bootstrap-deploy-receipt.env"
rollback_receipt="${deploy_dir}/bootstrap-rollback-receipt.env"
lock="${deploy_dir}/.bootstrap-deploy.lock"
[ ! -L "bin" ] && [ ! -L "bin/release" ] && [ ! -L "${deploy_dir}" ] || { echo "error: symlinked deployment path" >&2; exit 2; }
mkdir "${lock}" 2>/dev/null || { echo "error: deployment is locked" >&2; exit 2; }
rollback_work=
trap 'rm -rf "${lock}"; [ -z "${rollback_work:-}" ] || rm -f "${rollback_work}"' EXIT
trap 'exit 130' HUP INT TERM

hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256 >/dev/null 2>&1; then sha256 -q "$1"
  else echo "error: no SHA-256 tool" >&2; return 1; fi
}
value() { sed -n "s/^$1=//p" "${receipt}" | awk 'NR==1 { value=$0 } END { if (NR==1) print value }'; }
bounded_smoke() {
  smoke_out="${deploy_dir}/.rollback-smoke-out.$$"
  "$1" -c 'print(1+1)' >"${smoke_out}" 2>/dev/null &
  smoke_pid=$!
  (sleep 30; kill "${smoke_pid}" 2>/dev/null || true; sleep 2; kill -KILL "${smoke_pid}" 2>/dev/null || true) &
  watchdog_pid=$!
  smoke_status=0
  wait "${smoke_pid}" || smoke_status=$?
  kill "${watchdog_pid}" 2>/dev/null || true
  wait "${watchdog_pid}" 2>/dev/null || true
  cat "${smoke_out}"
  rm -f "${smoke_out}"
  return "${smoke_status}"
}
fail_receipt() {
  { echo "schema=bootstrap-rollback-receipt-v1"; echo "platform=${platform}"; echo "rollback_status=fail"; echo "reason=$1"; echo "platform_acceptance_claimed=false"; } > "${rollback_receipt}.tmp.$$"
  mv "${rollback_receipt}.tmp.$$" "${rollback_receipt}"
  echo "error: rollback failed: $1" >&2
  exit 1
}

[ -f "${receipt}" ] && [ ! -L "${receipt}" ] || fail_receipt receipt
[ "$(value schema)" = "bootstrap-deploy-receipt-v1" ] || fail_receipt schema
[ "$(value platform)" = "${platform}" ] || fail_receipt platform
[ "$(value repository_root)" = "${repo_root}" ] || fail_receipt current_worktree
BOOTSTRAP_STAGE3_FACADE_PATH="${repo_root}/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="${repo_root}/scripts/check/lib/stage4-candidate-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "${BOOTSTRAP_STAGE3_FACADE_PATH}" || fail_receipt stage3_verifier
. "${STAGE4_PROVENANCE_HELPER_PATH}" || fail_receipt stage4_verifier
stage4_candidate=$(bootstrap_stage3_canonical_file "$(value stage4_candidate_path)") || fail_receipt stage4_candidate
stage4_provenance=$(bootstrap_stage3_canonical_file "$(value stage4_provenance_path)") || fail_receipt stage4_provenance
[ "$(value stage4_candidate_sha256)" = "$(hash_file "${stage4_candidate}")" ] || fail_receipt stage4_candidate_hash
[ "$(value stage4_provenance_sha256)" = "$(hash_file "${stage4_provenance}")" ] || fail_receipt stage4_provenance_hash
current_identity="${deploy_dir}/.rollback-current-tree.$$"; rollback_work=${current_identity}
stage4_write_current_tree_identity "${current_identity}" "${repo_root}" || fail_receipt current_tree_measurement
for identity_key in repository_root source_revision_kind source_revision source_roots \
  stage3_source_snapshot_sha256 git_state_sha256 git_head \
  git_dirty_fingerprint stage3_producer_path stage3_producer_sha256; do
  [ "$(value "${identity_key}")" = \
    "$(bootstrap_stage3_manifest_value "${identity_key}" "${stage4_provenance}")" ] ||
    fail_receipt "stage4_${identity_key}"
  [ "$(value "${identity_key}")" = \
    "$(bootstrap_stage3_manifest_value "${identity_key}" "${current_identity}")" ] ||
    fail_receipt stale_current_tree
done
[ "$(bootstrap_stage3_manifest_value output_path "${stage4_provenance}")" = "${stage4_candidate}" ] || fail_receipt stage4_output_path
[ "$(bootstrap_stage3_manifest_value output_sha256 "${stage4_provenance}")" = "$(value stage4_candidate_sha256)" ] || fail_receipt stage4_output_hash
stage3_manifest=$(bootstrap_stage3_canonical_file "$(bootstrap_stage3_manifest_value stage3_provenance_path "${stage4_provenance}")") || fail_receipt stage3_provenance
[ "$(bootstrap_stage3_manifest_value stage3_provenance_sha256 "${stage4_provenance}")" = "$(hash_file "${stage3_manifest}")" ] || fail_receipt stage3_provenance_hash
[ "$(bootstrap_stage3_manifest_value source_snapshot_sha256 "${stage3_manifest}")" = "$(value stage3_source_snapshot_sha256)" ] || fail_receipt stage3_source_snapshot
[ "$(bootstrap_stage3_manifest_value git_state_sha256 "${stage3_manifest}")" = "$(value git_state_sha256)" ] || fail_receipt stage3_git_state
[ "$(bootstrap_stage3_manifest_value git_head "${stage3_manifest}")" = "$(value git_head)" ] || fail_receipt stage3_git_head
[ "$(bootstrap_stage3_manifest_value git_dirty_fingerprint "${stage3_manifest}")" = "$(value git_dirty_fingerprint)" ] || fail_receipt stage3_git_dirty
[ "$(bootstrap_stage3_manifest_value bootstrap_script_path "${stage3_manifest}")" = "$(value stage3_producer_path)" ] || fail_receipt stage3_producer_path
[ "$(bootstrap_stage3_manifest_value bootstrap_script_sha256 "${stage3_manifest}")" = "$(value stage3_producer_sha256)" ] || fail_receipt stage3_producer_hash
rm -f "${current_identity}"; rollback_work=
stage3_acceptance=$(bootstrap_stage3_canonical_file "$(value stage3_current_acceptance_receipt)") || fail_receipt stage3_acceptance
[ "$(value stage3_current_acceptance_status)" = verified ] || fail_receipt stage3_acceptance_status
[ "$(value stage3_current_acceptance_receipt_sha256)" = "$(hash_file "${stage3_acceptance}")" ] || fail_receipt stage3_acceptance_hash
[ "$(bootstrap_stage3_manifest_value status "${stage3_acceptance}")" = verified ] || fail_receipt stage3_acceptance_receipt_status
[ "$(bootstrap_stage3_manifest_value stage4_candidate_sha256 "${stage3_acceptance}")" = "$(value stage4_candidate_sha256)" ] || fail_receipt stage3_acceptance_candidate
[ "$(bootstrap_stage3_manifest_value stage4_provenance_sha256 "${stage3_acceptance}")" = "$(value stage4_provenance_sha256)" ] || fail_receipt stage3_acceptance_provenance
for identity_key in repository_root source_revision_kind source_revision source_roots \
  stage3_source_snapshot_sha256 git_state_sha256 git_head \
  git_dirty_fingerprint stage3_producer_path stage3_producer_sha256; do
  [ "$(bootstrap_stage3_manifest_value "${identity_key}" "${stage3_acceptance}")" = \
    "$(value "${identity_key}")" ] || fail_receipt stage3_acceptance_identity
done
current="$(value current_path)"; backup="$(value backup_path)"
[ "${current}" = "${deploy_dir}/simple" ] || [ "${current}" = "${deploy_dir}/simple.exe" ] || fail_receipt current_path
[ "${backup}" = "${current}.pre_deploy" ] || fail_receipt backup_path
[ -f "${current}" ] && [ ! -L "${current}" ] || fail_receipt current_file
[ -f "${backup}" ] && [ ! -L "${backup}" ] || fail_receipt backup_file
expected_current_hash="$(value current_sha256)"
expected_backup_hash="$(value backup_sha256)"
[ "$(hash_file "${current}")" = "${expected_current_hash}" ] || fail_receipt current_hash
[ "$(hash_file "${backup}")" = "${expected_backup_hash}" ] || fail_receipt backup_hash

candidate="${current}.rollback_candidate.$$"
old="${current}.rollback_old.$$"
install -m755 "${backup}" "${candidate}"
[ "$(hash_file "${candidate}")" = "${expected_backup_hash}" ] || { rm -f "${candidate}"; fail_receipt candidate_hash; }
marker='enum construction: unregistered enum'
if ! { grep -a -q "${marker}" "${candidate}" 2>/dev/null && [ "$(bounded_smoke "${candidate}" 2>/dev/null)" = "2" ]; }; then
  rm -f "${candidate}"
  fail_receipt rollback_smoke
fi
install -m755 "${current}" "${old}"
deploy_receipt_sha256_before="$(hash_file "${receipt}")"
stage4_candidate_sha256_before="$(value stage4_candidate_sha256)"
stage3_acceptance_sha256_before="$(hash_file "${stage3_acceptance}")"
rm -f "${receipt}" "${rollback_receipt}"
mv "${candidate}" "${current}"
if [ "$(uname -s)" != "Windows_NT" ] && ! "${repo_root}/scripts/setup/setup.shs"; then
  mv "${old}" "${current}" || fail_receipt restore_failed
  fail_receipt setup
fi
backup_tmp="${backup}.tmp.$$"
install -m755 "${old}" "${backup_tmp}"
mv "${backup_tmp}" "${backup}"
rm -f "${old}"
{
  echo "schema=bootstrap-rollback-receipt-v1"
  echo "platform=${platform}"
  echo "current_path=${current}"
  echo "current_sha256=$(hash_file "${current}")"
  echo "backup_path=${backup}"
  echo "backup_sha256=$(hash_file "${backup}")"
  echo "deploy_receipt_sha256=${deploy_receipt_sha256_before}"
  echo "stage4_candidate_path=${stage4_candidate}"
  echo "stage4_candidate_sha256=${stage4_candidate_sha256_before}"
  echo "stage4_provenance_path=${stage4_provenance}"
  echo "stage4_provenance_sha256=$(bootstrap_stage3_hash_file "${stage4_provenance}")"
  echo "stage3_current_acceptance_receipt=${stage3_acceptance}"
  echo "stage3_current_acceptance_receipt_sha256=${stage3_acceptance_sha256_before}"
  echo "repository_root=${repo_root}"
  echo "source_revision_kind=$(bootstrap_stage3_manifest_value source_revision_kind "${stage4_provenance}")"
  echo "source_revision=$(bootstrap_stage3_manifest_value source_revision "${stage4_provenance}")"
  echo "source_roots=$(bootstrap_stage3_manifest_value source_roots "${stage4_provenance}")"
  echo "stage3_source_snapshot_sha256=$(bootstrap_stage3_manifest_value stage3_source_snapshot_sha256 "${stage4_provenance}")"
  echo "git_state_sha256=$(bootstrap_stage3_manifest_value git_state_sha256 "${stage4_provenance}")"
  echo "git_head=$(bootstrap_stage3_manifest_value git_head "${stage4_provenance}")"
  echo "git_dirty_fingerprint=$(bootstrap_stage3_manifest_value git_dirty_fingerprint "${stage4_provenance}")"
  echo "stage3_producer_path=$(bootstrap_stage3_manifest_value stage3_producer_path "${stage4_provenance}")"
  echo "stage3_producer_sha256=$(bootstrap_stage3_manifest_value stage3_producer_sha256 "${stage4_provenance}")"
  echo "timestamp_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "rollback_status=pass"
  echo "platform_acceptance_claimed=false"
} > "${rollback_receipt}.tmp.$$"
mv "${rollback_receipt}.tmp.$$" "${rollback_receipt}"
echo "rollback_status=pass"
echo "rollback_receipt=${rollback_receipt}"
