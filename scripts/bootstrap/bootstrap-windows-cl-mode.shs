#!/bin/sh
# Preserve the Windows clang-cl C-mode option across Git Bash/MSYS launches.
# Without this exclusion an inherited CL=/TC becomes CL=C:/.../Git/TC in a
# native child; clang-cl treats that path as an extra linker/source input.
bootstrap_windows_preserve_cl_mode() {
    case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        case ";${MSYS2_ENV_CONV_EXCL:-};" in
        *';CL=;'*) : ;;
        *) MSYS2_ENV_CONV_EXCL="${MSYS2_ENV_CONV_EXCL:+${MSYS2_ENV_CONV_EXCL};}CL="
           export MSYS2_ENV_CONV_EXCL ;;
        esac
        ;;
    esac
}
