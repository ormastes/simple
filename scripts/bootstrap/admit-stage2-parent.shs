#!/bin/sh

# Admit an existing pure-Simple runtime as the producer of a fresh Stage2.
# This helper validates authority without compiling or copying a candidate.
# Deployed-runtime admission executes its existing version check; canonical
# Phase-2 admission validates the recorded probes and their complete bindings.

bootstrap_stage2_parent_admit() {
    unset BOOTSTRAP_STAGE2_PARENT_RUNTIME_PATH BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT
    unset BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT_SHA256
    _bspa_candidate=$1
    _bspa_root=$2
    [ -n "$_bspa_candidate" ] && [ -n "$_bspa_root" ] || return 64
    . "$_bspa_root/scripts/lib/simple-runtime-provenance.shs" || return 64
    if simple_runtime_receipt_for "$_bspa_candidate" "$_bspa_root" >/dev/null 2>&1; then
        # An invalid published runtime receipt must never fall through to a
        # different authority route.
        simple_runtime_provenance_admits "$_bspa_candidate" "$_bspa_root" || return 64
        BOOTSTRAP_STAGE2_PARENT_PATH=$SIMPLE_RUNTIME_REAL
        BOOTSTRAP_STAGE2_PARENT_SHA256=$SIMPLE_RUNTIME_SHA256
        BOOTSTRAP_STAGE2_PARENT_PROVENANCE=$SIMPLE_RUNTIME_PROVENANCE
    else
        _bspa_real=$(simple_runtime_real_path "$_bspa_candidate") || return 64
        _bspa_parent_dir=$(dirname -- "$_bspa_real")
        _bspa_stage2_dir=$(dirname -- "$_bspa_parent_dir")
        [ "$(basename -- "$_bspa_stage2_dir")" = stage2 ] || return 64
        _bspa_output=$(dirname -- "$_bspa_stage2_dir")
        _bspa_validation=$(sh "$_bspa_root/scripts/bootstrap/produce-bootstrap-planner-admission-v2.shs" \
            --validate-parent-only --target=//bootstrap:stage3 \
            --reason=verify-landed-compiler-fix --parent-compiler="$_bspa_real" \
            --bootstrap-output="$_bspa_output") || return 64
        BOOTSTRAP_STAGE2_PARENT_PATH=$(printf '%s\n' "$_bspa_validation" | sed -n 's/^parent_path=//p')
        BOOTSTRAP_STAGE2_PARENT_SHA256=$(printf '%s\n' "$_bspa_validation" | sed -n 's/^parent_sha256=//p')
        BOOTSTRAP_STAGE2_PARENT_PROVENANCE=$(printf '%s\n' "$_bspa_validation" | sed -n 's/^parent_admission_receipt=//p')
        BOOTSTRAP_STAGE2_PARENT_RUNTIME_PATH=$(printf '%s\n' "$_bspa_validation" | sed -n 's/^parent_runtime_path=//p')
        BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT=$(printf '%s\n' "$_bspa_validation" | sed -n 's/^parent_runtime_snapshot=//p')
        BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT_SHA256=$(printf '%s\n' "$_bspa_validation" | sed -n 's/^parent_runtime_snapshot_sha256=//p')
        [ "$BOOTSTRAP_STAGE2_PARENT_PATH" = "$_bspa_real" ] &&
            [ -n "$BOOTSTRAP_STAGE2_PARENT_SHA256" ] &&
            [ -f "$BOOTSTRAP_STAGE2_PARENT_PROVENANCE" ] &&
            [ -d "$BOOTSTRAP_STAGE2_PARENT_RUNTIME_PATH" ] &&
            [ -f "$BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT" ] &&
            [ -n "$BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT_SHA256" ] || return 64
        export BOOTSTRAP_STAGE2_PARENT_RUNTIME_PATH BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT
        export BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT_SHA256
    fi
    BOOTSTRAP_STAGE2_PARENT_AUTHORITY=admitted-pure-simple-runtime-stage2-trust-root
    export BOOTSTRAP_STAGE2_PARENT_PATH BOOTSTRAP_STAGE2_PARENT_SHA256
    export BOOTSTRAP_STAGE2_PARENT_PROVENANCE BOOTSTRAP_STAGE2_PARENT_AUTHORITY
}

# The caller has sourced the canonical Stage-3 authority helpers. Check every
# byte of the original runtime, including its original producer stamp, before
# copying it into the new generation. Missing or changed evidence is fatal.
bootstrap_stage2_parent_runtime_verify() {
    [ "$#" -eq 1 ] || return 64
    [ -n "${BOOTSTRAP_STAGE2_PARENT_RUNTIME_PATH:-}" ] &&
        [ -n "${BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT:-}" ] &&
        [ -n "${BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT_SHA256:-}" ] || return 64
    [ -f "$BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT" ] &&
        [ ! -L "$BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT" ] &&
        [ -d "$BOOTSTRAP_STAGE2_PARENT_RUNTIME_PATH" ] &&
        [ ! -L "$BOOTSTRAP_STAGE2_PARENT_RUNTIME_PATH" ] || return 64
    [ "$(bootstrap_stage3_hash_file "$BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT")" = \
        "$BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT_SHA256" ] || return 64
    bootstrap_stage3_directory_snapshot "$1" "$BOOTSTRAP_STAGE2_PARENT_RUNTIME_PATH" || return 64
    cmp -s "$BOOTSTRAP_STAGE2_PARENT_RUNTIME_SNAPSHOT" "$1" || return 64
}
