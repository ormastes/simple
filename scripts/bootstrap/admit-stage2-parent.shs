#!/bin/sh

# Admit an existing pure-Simple runtime as the producer of a fresh Stage2.
# This helper only validates authority; it never copies or executes the binary.

bootstrap_stage2_parent_admit() {
    _bspa_candidate=$1
    _bspa_root=$2
    [ -n "$_bspa_candidate" ] && [ -n "$_bspa_root" ] || return 64
    . "$_bspa_root/scripts/lib/simple-runtime-provenance.shs" || return 64
    simple_runtime_provenance_admits "$_bspa_candidate" "$_bspa_root" || return 64
    BOOTSTRAP_STAGE2_PARENT_PATH=$SIMPLE_RUNTIME_REAL
    BOOTSTRAP_STAGE2_PARENT_SHA256=$SIMPLE_RUNTIME_SHA256
    BOOTSTRAP_STAGE2_PARENT_PROVENANCE=$SIMPLE_RUNTIME_PROVENANCE
    BOOTSTRAP_STAGE2_PARENT_AUTHORITY=admitted-pure-simple-runtime-stage2-trust-root
    export BOOTSTRAP_STAGE2_PARENT_PATH BOOTSTRAP_STAGE2_PARENT_SHA256
    export BOOTSTRAP_STAGE2_PARENT_PROVENANCE BOOTSTRAP_STAGE2_PARENT_AUTHORITY
}
