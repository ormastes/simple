#!/bin/sh
# Run before any strategy/session/resume dispatch so option order cannot
# redirect an explicit seed-only prerequisite into another execution lane.
bootstrap_seed_stop_policy_validate() {
    seed_stop_selected=0 seed_stop_full=0
    for option do
        case "$option" in --stop-after-seed) seed_stop_selected=1 ;; --full-bootstrap) seed_stop_full=1 ;; esac
    done
    [ "$seed_stop_selected" = 1 ] || return 0
    [ "$seed_stop_full" = 1 ] || {
        echo 'error: --stop-after-seed requires --full-bootstrap' >&2; return 64;
    }
    for option do
        case "$option" in
            --resume-managed-from-admitted=*|--resume-stage3-from-admitted=*|--resume-stage4-from-admitted=*|\
            --validate-bootstrap-receipt|--bootstrap-receipt=*|--produce-stage3-receipt=*|--produce-managed-receipt=*|\
            --stop-after-stage2|--stop-after-stage3|--pure-simple|--full-cli|--deploy|--release-tests|\
            --diagnostic-sweep|--diagnostic-root=*|--diagnostic-child-compiler=*|--refresh-stage2-source-cache=*|\
            --invalidate-cache=*|--help|-h)
                echo "error: --stop-after-seed conflicts with $option" >&2; return 64 ;;
        esac
    done
}
