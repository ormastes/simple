#!/bin/sh
# Admit a diagnostic Stage 3 binary as a pure-Simple Stage 2 parent.
#
# Writes <bin>.provenance.env (schema simple-runtime-provenance-v1,
# producer=diagnostic-stage3) ONLY after the binary passes
# scripts/check/check-stage-binaries-runnable.shs (--version, compile and
# native-build of a hello world, no crash, no non-zero exit). The sidecar is
# what admit-stage2-parent.shs reads when bootstrap-from-scratch.sh is run
# with --stop-after-stage2 and SIMPLE_BUILD_COMPILER=<bin>, so Phase 3 can
# rebuild Phase 3 without a seed or Stage 2 rebuild.
#
# Scope: diagnostic rebuilds only. A binary under bin/release/ is refused;
# released binaries are admitted by the Stage 4 path, never by this script.
# The sidecar is removed before the gate runs, so a failed gate never leaves a
# stale admission behind, and the result is re-read through
# simple_runtime_provenance_admits: a sidecar that the admit function would
# reject is deleted and the run fails.
#
# Usage:
#   write-diagnostic-stage3-provenance.shs <stage3-binary>
#   write-diagnostic-stage3-provenance.shs --selftest
# Verdict (last stdout line): PASS — ... exit 0 / FAIL — ... exit 1 /
# ERROR — ... exit 2.

case "$0" in */*) . "${0%/*}/../lib/recursion_guard.shs" ;; *) . ./scripts/lib/recursion_guard.shs ;; esac
set -u

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 2
REPO_ROOT=$(CDPATH= cd -- "$SELF_DIR/../.." && pwd -P) || exit 2
GATE="$REPO_ROOT/scripts/check/check-stage-binaries-runnable.shs"
. "$REPO_ROOT/scripts/lib/simple-runtime-provenance.shs" || exit 2

# admit_diagnostic <bin> <tmpdir>
# Returns 0 = sidecar written and admitted, 1 = refused (no sidecar),
# 2 = could not decide (no sidecar). Sets ADMIT_REASON.
admit_diagnostic() {
    _bin=$1; _tmp=$2; ADMIT_REASON=''
    [ -f "$_bin" ] && [ -x "$_bin" ] || { ADMIT_REASON="$_bin is not an executable file"; return 2; }
    _real=$(simple_runtime_real_path "$_bin") || { ADMIT_REASON='cannot resolve path'; return 2; }
    case "$_real" in
        */bin/release/*) ADMIT_REASON="$_real is under bin/release; release admission needs Stage 4"; return 1 ;;
    esac
    _side="$_bin.provenance.env"
    rm -f "$_side" || { ADMIT_REASON="cannot remove stale $_side"; return 2; }

    _ver=$("$_bin" --version 2>&1)
    _vrc=$?
    [ "$_vrc" -eq 0 ] && [ -n "$_ver" ] || { ADMIT_REASON="--version rc=$_vrc"; return 1; }
    case "$_ver" in
        *"bootstrap seed only"*|*"Rust-built"*) ADMIT_REASON='--version names a Rust-built seed'; return 1 ;;
    esac
    [ "$(printf '%s\n' "$_ver" | wc -l | tr -d ' ')" = 1 ] || { ADMIT_REASON='multi-line --version'; return 1; }

    _sha=$(simple_runtime_sha256 "$_bin") || { ADMIT_REASON='sha256 failed'; return 2; }
    _triple=$(simple_runtime_candidate_target "$_bin") || { ADMIT_REASON='target triple unknown'; return 2; }

    # The gate probes git-tracked bootstrap/**/simple; give it a one-file repo
    # holding a byte-identical copy at this host's triple-scoped stage path.
    _repo="$_tmp/gate-repo"
    mkdir -p "$_repo/bootstrap/stage3/$_triple" || { ADMIT_REASON='mkdir failed'; return 2; }
    cp "$_bin" "$_repo/bootstrap/stage3/$_triple/simple" || { ADMIT_REASON='copy failed'; return 2; }
    [ "$(simple_runtime_sha256 "$_repo/bootstrap/stage3/$_triple/simple")" = "$_sha" ] || { ADMIT_REASON='copy differs'; return 2; }
    git -C "$_repo" init -q >/dev/null 2>&1 &&
        git -C "$_repo" add bootstrap >/dev/null 2>&1 || { ADMIT_REASON='gate repo init failed'; return 2; }

    # native-build resolves src/runtime from the working directory, so the
    # probes run from this checkout's root (the gate itself never cds).
    ( cd "$REPO_ROOT" && exec sh "$GATE" --root "$_repo" ) >"$_tmp/gate.log" 2>&1
    _grc=$?
    _gverdict=$(tail -n 1 "$_tmp/gate.log")
    if [ "$_grc" -ne 0 ]; then
        ADMIT_REASON="runnable gate rc=$_grc: $_gverdict"
        [ "$_grc" -eq 1 ] && return 1
        return 2
    fi
    case "$_gverdict" in "PASS — "*) ;; *) ADMIT_REASON="gate verdict not PASS: $_gverdict"; return 2 ;; esac
    [ "$(simple_runtime_sha256 "$_bin")" = "$_sha" ] || { ADMIT_REASON='binary changed during the gate'; return 2; }

    {
        printf 'schema=simple-runtime-provenance-v1\n'
        printf 'status=admitted\n'
        printf 'implementation=pure-simple\n'
        printf 'artifact_sha256=%s\n' "$_sha"
        printf 'target_triple=%s\n' "$_triple"
        printf 'version_output=%s\n' "$_ver"
        printf 'producer=diagnostic-stage3\n'
        printf 'evidence=check-stage-binaries-runnable: %s\n' "$_gverdict"
        printf 'scope=diagnostic stage2 parent only; not a release admission\n'
    } >"$_side.tmp" && mv -f "$_side.tmp" "$_side" || { rm -f "$_side.tmp"; ADMIT_REASON='write failed'; return 2; }

    if ! simple_runtime_provenance_admits "$_bin" "$REPO_ROOT"; then
        rm -f "$_side"
        ADMIT_REASON='written sidecar is not admitted by simple_runtime_provenance_admits'
        return 2
    fi
    ADMIT_REASON="$_side sha256=$_sha triple=$_triple"
    return 0
}

selftest() {
    _st=$(mktemp -d "${TMPDIR:-/tmp}/diag_prov_selftest_XXXXXX") || return 1
    _ok=1
    printf '#!/bin/sh\ncase "$1" in --version) echo "Simple v0.0.0-diag-fixture"; exit 0 ;; esac\nexit 0\n' >"$_st/good"
    printf '#!/bin/sh\ncase "$1" in --version) echo "Simple v0.0.0-diag-fixture"; exit 0 ;; esac\nkill -SEGV $$\n' >"$_st/crash"
    chmod +x "$_st/good" "$_st/crash"

    mkdir -p "$_st/t1"
    admit_diagnostic "$_st/crash" "$_st/t1"
    _rc=$?
    if [ "$_rc" -ne 1 ] || [ -e "$_st/crash.provenance.env" ]; then
        printf 'selftest: crash fixture rc=%s sidecar=%s (want rc=1, no sidecar): %s\n' \
            "$_rc" "$([ -e "$_st/crash.provenance.env" ] && echo yes || echo no)" "$ADMIT_REASON"
        _ok=0
    fi

    mkdir -p "$_st/t2"
    admit_diagnostic "$_st/good" "$_st/t2"
    _rc=$?
    if [ "$_rc" -ne 0 ] || ! simple_runtime_provenance_admits "$_st/good" "$REPO_ROOT"; then
        printf 'selftest: working fixture rc=%s not admitted: %s\n' "$_rc" "$ADMIT_REASON"
        _ok=0
    fi
    rm -rf "$_st"
    [ "$_ok" -eq 1 ]
}

if ! selftest; then
    printf 'ERROR — nothing was checked (selftest failed)\n'
    exit 2
fi
if [ "${1:-}" = --selftest ]; then
    printf 'PASS — selftest: crashing fixture refused without a sidecar, working fixture admitted\n'
    exit 0
fi
[ $# -eq 1 ] || { printf 'ERROR — nothing was checked (usage: %s <stage3-binary> | --selftest)\n' "$0"; exit 2; }

TMP=$(mktemp -d "${TMPDIR:-/tmp}/diag_prov_XXXXXX") || { printf 'ERROR — nothing was checked (mktemp)\n'; exit 2; }
admit_diagnostic "$1" "$TMP"
RC=$?
if [ "$RC" -ne 0 ]; then
    printf 'gate log: %s/gate.log\n' "$TMP"
    if [ "$RC" -eq 1 ]; then printf 'FAIL — %s refused: %s\n' "$1" "$ADMIT_REASON"; exit 1; fi
    printf 'ERROR — nothing was admitted: %s\n' "$ADMIT_REASON"; exit 2
fi
rm -rf "$TMP"
printf 'PASS — diagnostic Stage 3 admitted: %s\n' "$ADMIT_REASON"
exit 0
