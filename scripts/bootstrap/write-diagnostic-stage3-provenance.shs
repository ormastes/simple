#!/bin/sh
# Admit a diagnostic Stage 3 binary as a pure-Simple Stage 2 parent.
#
# Writes <bin>.provenance.env (schema simple-runtime-provenance-v1,
# producer=diagnostic-stage3) ONLY after the binary
#   1. is a host-native executable (ELF for this machine, or Mach-O on Darwin),
#      not a symlink and not under any bin/release/ directory;
#   2. passes scripts/check/check-stage-binaries-runnable.shs (--version,
#      compile and native-build of a hello world, no crash, no non-zero exit);
#   3. native-builds that hello world into a program that prints exactly `hi`.
# The sidecar is what admit-stage2-parent.shs reads when
# bootstrap-from-scratch.sh runs with --stop-after-stage2 and
# SIMPLE_BUILD_COMPILER=<bin>, so Phase 3 can rebuild Phase 3 without a seed
# or Stage 2 rebuild.
#
# Scope: diagnostic rebuilds only. Released binaries are admitted by the
# Stage 4 path, never by this script; bin/release/ paths are refused. Any
# existing sidecar is removed before checking, so a failed check never leaves
# an admission behind, and the result is re-read through
# simple_runtime_provenance_admits: a sidecar that function would reject is
# deleted and the run fails.
#
# Usage:
#   write-diagnostic-stage3-provenance.shs <stage3-binary>
#   write-diagnostic-stage3-provenance.shs --selftest
# Verdict (last stdout line): PASS — ... exit 0 / FAIL — ... exit 1 /
# ERROR — ... exit 2.

case "$0" in */*) . "${0%/*}/../lib/recursion_guard.shs" ;; *) . ./scripts/lib/recursion_guard.shs ;; esac
set -u

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 2
REPO_ROOT=$(CDPATH= cd -- "$SELF_DIR/../.." && pwd -P) || exit 2
GATE="$REPO_ROOT/scripts/check/check-stage-binaries-runnable.shs"
. "$REPO_ROOT/scripts/lib/simple-runtime-provenance.shs" || exit 2

# Shell-only (never read from the environment): selftest fixtures are shell
# scripts, real admissions must be host-native executables.
ALLOW_SCRIPT_FIXTURE=0
TIMEOUT_BIN=''
for _t in timeout gtimeout; do
    command -v "$_t" >/dev/null 2>&1 && { TIMEOUT_BIN=$_t; break; }
done

# host_native_ok <file> -> 0 when the file is an executable format this host runs.
host_native_ok() {
    _magic=$(od -An -tx1 -N4 "$1" 2>/dev/null | tr -d ' \n')
    case "$_magic" in
        2321*) [ "$ALLOW_SCRIPT_FIXTURE" -eq 1 ]; return ;;
        7f454c46)
            _mach=$(od -An -tx1 -j18 -N2 "$1" 2>/dev/null | tr -d ' \n')
            case "$(uname -s)-$(uname -m)-$_mach" in
                *-x86_64-3e00|*-amd64-3e00|*-aarch64-b700|*-arm64-b700) return 0 ;;
            esac
            return 1 ;;
        cffaedfe|cefaedfe) [ "$(uname -s)" = Darwin ]; return ;;
    esac
    return 1
}

# run_bounded <seconds> <out> <cmd...>; sets RB_RC (read on the next line, no pipe).
run_bounded() {
    _secs=$1; _o=$2; shift 2
    if [ -n "$TIMEOUT_BIN" ]; then
        "$TIMEOUT_BIN" "$_secs" "$@" >"$_o" 2>&1
        RB_RC=$?
    else
        "$@" >"$_o" 2>&1
        RB_RC=$?
    fi
}

# admit_diagnostic <bin> <tmpdir>
# Returns 0 = sidecar written and admitted, 1 = refused (no sidecar),
# 2 = could not decide (no sidecar). Sets ADMIT_REASON.
admit_diagnostic() {
    _bin=$1; _tmp=$2; ADMIT_REASON=''
    [ -L "$_bin" ] && { ADMIT_REASON="$_bin is a symlink; pass the real file"; return 1; }
    [ -f "$_bin" ] && [ -x "$_bin" ] || { ADMIT_REASON="$_bin is not an executable file"; return 2; }
    _pdir=$(CDPATH= cd -- "$(dirname -- "$_bin")" && pwd -P) || { ADMIT_REASON='cannot resolve directory'; return 2; }
    _bin="$_pdir/$(basename -- "$_bin")"
    case "$_pdir/" in
        */bin/release/*) ADMIT_REASON="$_bin is under bin/release; release admission needs Stage 4"; return 1 ;;
    esac
    _side="$_bin.provenance.env"
    rm -f "$_side" || { ADMIT_REASON="cannot remove stale $_side"; return 2; }
    [ -e "$_side" ] || [ -L "$_side" ] && { ADMIT_REASON="stale $_side survived removal"; return 2; }

    host_native_ok "$_bin" || { ADMIT_REASON="$_bin is not a host-native executable"; return 1; }
    _sha=$(simple_runtime_sha256 "$_bin") || { ADMIT_REASON='sha256 failed'; return 2; }
    _triple=$(simple_runtime_candidate_target "$_bin") || { ADMIT_REASON='target triple unknown'; return 2; }

    _ver=$("$_bin" --version 2>&1)
    _vrc=$?
    [ "$_vrc" -eq 0 ] && [ -n "$_ver" ] || { ADMIT_REASON="--version rc=$_vrc"; return 1; }
    case "$_ver" in
        *"bootstrap seed only"*|*"Rust-built"*) ADMIT_REASON='--version names a Rust-built seed'; return 1 ;;
    esac
    [ "$(printf '%s\n' "$_ver" | wc -l | tr -d ' ')" = 1 ] || { ADMIT_REASON='multi-line --version'; return 1; }

    # The gate probes git-tracked bootstrap/**/simple; give it a one-file repo
    # holding a byte-identical copy at this host's triple-scoped stage path.
    _repo="$_tmp/gate_repo"
    mkdir -p "$_repo/bootstrap/stage3/$_triple" || { ADMIT_REASON='mkdir failed'; return 2; }
    cp "$_bin" "$_repo/bootstrap/stage3/$_triple/simple" || { ADMIT_REASON='copy failed'; return 2; }
    [ "$(simple_runtime_sha256 "$_repo/bootstrap/stage3/$_triple/simple")" = "$_sha" ] || { ADMIT_REASON='copy differs'; return 2; }
    git -C "$_repo" init -q >/dev/null 2>&1 &&
        git -C "$_repo" add bootstrap >/dev/null 2>&1 || { ADMIT_REASON='gate repo init failed'; return 2; }

    # native-build resolves src/runtime from the working directory, so the
    # probes run from this checkout's root (the gate itself never cds).
    ( cd "$REPO_ROOT" && exec sh "$GATE" --root "$_repo" ) >"$_tmp/gate.out" 2>"$_tmp/gate.err"
    _grc=$?
    _gverdict=$(tail -n 1 "$_tmp/gate.out")
    if [ "$_grc" -ne 0 ]; then
        ADMIT_REASON="runnable gate rc=$_grc: $_gverdict"
        [ "$_grc" -eq 1 ] && return 1
        return 2
    fi
    case "$_gverdict" in "PASS — "*) ;; *) ADMIT_REASON="gate verdict not PASS: $_gverdict"; return 2 ;; esac

    # The gate checks exit codes only; also require the built program to run.
    _hw="$_tmp/hello_run"
    mkdir -p "$_hw" || { ADMIT_REASON='mkdir failed'; return 2; }
    printf 'fn main() -> i64:\n    print "hi"\n    0\n' >"$_hw/hello.spl"
    ( cd "$REPO_ROOT" && run_bounded 600 "$_hw/build.log" "$_bin" native-build "$_hw/hello.spl" -o "$_hw/hello_bin"; exit "$RB_RC" )
    _nrc=$?
    [ "$_nrc" -eq 0 ] && [ -x "$_hw/hello_bin" ] || { ADMIT_REASON="hello native-build rc=$_nrc or no executable (log $_hw/build.log)"; return 1; }
    run_bounded 60 "$_hw/run.out" "$_hw/hello_bin"
    _hrc=$RB_RC
    [ "$_hrc" -eq 0 ] && [ "$(cat "$_hw/run.out")" = hi ] || { ADMIT_REASON="hello program rc=$_hrc did not print exactly 'hi'"; return 1; }

    [ "$(simple_runtime_sha256 "$_bin")" = "$_sha" ] || { ADMIT_REASON='binary changed during the checks'; return 2; }

    _stmp=$(mktemp "$_side.XXXXXX") || { ADMIT_REASON='mktemp for sidecar failed'; return 2; }
    {
        printf 'schema=simple-runtime-provenance-v1\n'
        printf 'status=admitted\n'
        printf 'implementation=pure-simple\n'
        printf 'artifact_sha256=%s\n' "$_sha"
        printf 'target_triple=%s\n' "$_triple"
        printf 'version_output=%s\n' "$_ver"
        printf 'producer=diagnostic-stage3\n'
        printf 'evidence=check-stage-binaries-runnable: %s; hello program printed hi\n' "$_gverdict"
        printf 'scope=diagnostic stage2 parent only; not a release admission\n'
    } >"$_stmp" && mv -f "$_stmp" "$_side" || { rm -f "$_stmp"; ADMIT_REASON='write failed'; return 2; }

    if ! simple_runtime_provenance_admits "$_bin" "$REPO_ROOT"; then
        rm -f "$_side"
        ADMIT_REASON='written sidecar is not admitted by simple_runtime_provenance_admits'
        return 2
    fi
    ADMIT_REASON="$_side sha256=$_sha triple=$_triple"
    return 0
}

# fake <path> <native-build behaviour: hi|nope|fail> <compile: ok|segv>
fake() {
    {
        printf '#!/bin/sh\n'
        printf 'case "$1" in --version) echo "Simple v0.0.0-diag-fixture"; exit 0 ;; esac\n'
        [ "$3" = segv ] && printf '[ "$1" = compile ] && kill -SEGV $$\n'
        case "$2" in
            fail) printf '[ "$1" = native-build ] && exit 1\n' ;;
            *) printf 'if [ "$1" = native-build ]; then o=; while [ $# -gt 0 ]; do [ "$1" = -o ] && o=$2; shift; done\n'
               printf '  printf "#!/bin/sh\\necho %s\\n" >"$o"; chmod +x "$o"; fi\n' "$2" ;;
        esac
        printf 'exit 0\n'
    } >"$1"
    chmod +x "$1"
}

selftest() {
    _st=$(mktemp -d "${TMPDIR:-/tmp}/diag_prov_selftest_XXXXXX") || return 1
    _ok=1
    ALLOW_SCRIPT_FIXTURE=1
    mkdir -p "$_st/bin/release/x"
    fake "$_st/crash" hi segv
    fake "$_st/nbfail" fail ok
    fake "$_st/nope" nope ok
    fake "$_st/good" hi ok
    fake "$_st/bin/release/x/simple" hi ok
    ln -s "$_st/good" "$_st/link"
    printf 'schema=simple-runtime-provenance-v1\nstatus=admitted\n' >"$_st/crash.provenance.env"

    _n=0
    for _case in crash nbfail nope bin/release/x/simple link; do
        _n=$((_n + 1)); mkdir -p "$_st/t$_n"
        admit_diagnostic "$_st/$_case" "$_st/t$_n"
        _rc=$?
        if [ "$_rc" -ne 1 ] || [ -e "$_st/$_case.provenance.env" ] || [ -e "$_st/good.provenance.env" ]; then
            printf 'selftest: %s rc=%s (want 1, no sidecar): %s\n' "$_case" "$_rc" "$ADMIT_REASON"
            _ok=0
        fi
    done

    mkdir -p "$_st/tgood"
    admit_diagnostic "$_st/good" "$_st/tgood"
    _rc=$?
    if [ "$_rc" -ne 0 ] || ! simple_runtime_provenance_admits "$_st/good" "$REPO_ROOT"; then
        printf 'selftest: good rc=%s not admitted: %s\n' "$_rc" "$ADMIT_REASON"
        _ok=0
    fi
    ALLOW_SCRIPT_FIXTURE=0
    host_native_ok "$_st/good" && { printf 'selftest: script accepted outside the selftest\n'; _ok=0; }
    rm -rf "$_st"
    [ "$_ok" -eq 1 ]
}

if ! selftest; then
    printf 'ERROR — nothing was checked (selftest failed)\n'
    exit 2
fi
if [ "${1:-}" = --selftest ]; then
    printf 'PASS — selftest: 5 refusal fixtures (crash, native-build fail, wrong output, bin/release, symlink) got no sidecar; working fixture admitted\n'
    exit 0
fi
[ $# -eq 1 ] || { printf 'ERROR — nothing was checked (usage: %s <stage3-binary> | --selftest)\n' "$0"; exit 2; }

TMP=$(mktemp -d "${TMPDIR:-/tmp}/diag_prov_XXXXXX") || { printf 'ERROR — nothing was checked (mktemp)\n'; exit 2; }
admit_diagnostic "$1" "$TMP"
RC=$?
if [ "$RC" -ne 0 ]; then
    printf 'kept for inspection: %s\n' "$TMP"
    if [ "$RC" -eq 1 ]; then printf 'FAIL — %s refused: %s\n' "$1" "$ADMIT_REASON"; exit 1; fi
    printf 'ERROR — nothing was admitted: %s\n' "$ADMIT_REASON"; exit 2
fi
rm -rf "$TMP"
printf 'PASS — diagnostic Stage 3 admitted: %s\n' "$ADMIT_REASON"
exit 0
