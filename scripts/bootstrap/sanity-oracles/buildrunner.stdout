buildrunner run --manifest FILE --state DIR [--source-root DIR] [--output-root DIR]
buildrunner verify --manifest FILE --state DIR [--source-root DIR] [--output-root DIR]
buildrunner verify-settled --manifest FILE --state DIR [--source-root DIR] [--output-root DIR]
buildrunner check --manifest FILE
buildrunner worker --request FILE --attempt-root DIR --host ID
