bootstrap_graph:
  schema: simple-bootstrap-graph-v1
  compatibility_supervisor: shell-v1
  future_owner: pure-simple-bootstrap-scheduler

  nodes:
    - id: stage2-build
      kind: BuildCompiler
      state_output: Built
      output_class: quarantined
      resource_class: compiler-critical
    - id: stage2-smoke-admission
      kind: AdmitCompilerSmoke
      state_output: SmokeAdmitted
      output_class: immutable-quarantined
      resource_class: compiler-critical
    - id: stage3-build
      kind: BuildCompiler
      state_output: Built
      output_class: quarantined-descendant
      resource_class: compiler-critical
    - id: stage2-qualification
      kind: QualifyCompiler
      state_output: Qualified
      output_class: evidence-only
      resource_class: qualification-remainder
    - id: lineage-admission
      kind: AdmitLineage
      state_output: ReleaseAdmitted
      output_class: typed-receipt
      resource_class: control
    - id: stage4-build
      kind: BuildProduct
      state_output: Built
      output_class: quarantined-descendant
      resource_class: compiler-critical
    - id: deploy
      kind: DeployProduct
      state_output: Published
      output_class: protected
      resource_class: exclusive-deploy

  edges:
    - from: stage2-build
      to: stage2-smoke-admission
      type: artifact-and-receipt
    - from: stage2-smoke-admission
      to: stage3-build
      type: speculative-parent
    - from: stage2-smoke-admission
      to: stage2-qualification
      type: qualification
    - from: stage3-build
      to: lineage-admission
      type: artifact-and-provenance
    - from: stage2-qualification
      to: lineage-admission
      type: qualification
    - from: lineage-admission
      to: stage4-build
      type: qualified-lineage
    - from: stage4-build
      to: deploy
      type: exclusive-publication

  invalidation:
    recursive: true
    preserve_rejected_artifacts: true
    stale_lease_publication: deny
    unknown_failure: invalidate

  resources:
    compiler_critical_reservation: required
    qualification_uses_remainder: true
    child_memory_limit: ulimit-v-or-serialize
    unenforceable_memory_overlap: deny
    cpu_slots_forwarded_to_children: true
    deploy_token: exclusive
