bootstrap_graph:
  schema: simple-bootstrap-graph-v1
  compatibility_supervisor: shell-v1
  future_owner: pure-simple-bootstrap-scheduler

  nodes:
    - id: stage1-build
      kind: BuildCompiler
      state_output: Built
      output_class: quarantined
      resource_class: compiler-critical
    - id: stage1-smoke
      kind: CheckCompilerSmoke
      state_output: SmokeChecked
      output_class: evidence-only
      resource_class: compiler-critical
    - id: stage1-whole-tests
      kind: TestInventory
      state_output: Collected
      output_class: evidence-only
      resource_class: qualification-remainder
    - id: stage2-build
      kind: BuildCompiler
      state_output: Built
      output_class: quarantined
      resource_class: compiler-critical
    - id: stage2-smoke-admission
      kind: AdmitCompilerSmoke
      state_output: SmokeAdmitted
      output_class: immutable-quarantined
      resource_class: compiler-critical
    - id: stage3-build
      kind: BuildCompiler
      state_output: Built
      output_class: quarantined-descendant
      resource_class: compiler-critical
    - id: stage2-qualification
      kind: QualifyCompiler
      state_output: Qualified
      output_class: evidence-only
      resource_class: qualification-remainder
    - id: stage2-subsystem-tests
      kind: BuildEnumerateRunTests
      state_output: Collected
      output_class: evidence-only
      resource_class: qualification-remainder
    - id: stage4-from-stage2
      kind: BuildProduct
      state_output: Built
      output_class: quarantined-descendant
      resource_class: compiler-critical
    - id: stage4-from-stage2-tests
      kind: TestInventory
      state_output: Collected
      output_class: evidence-only
      resource_class: qualification-remainder
    - id: stage3-smoke
      kind: CheckCompilerSmoke
      state_output: SmokeChecked
      output_class: evidence-only
      resource_class: compiler-critical
    - id: stage3-whole-tests
      kind: TestInventory
      state_output: Collected
      output_class: evidence-only
      resource_class: qualification-remainder
    - id: stage4-from-stage3
      kind: BuildProduct
      state_output: Built
      output_class: quarantined-descendant
      resource_class: compiler-critical
    - id: stage4-from-stage3-tests
      kind: TestInventory
      state_output: Collected
      output_class: evidence-only
      resource_class: qualification-remainder
    - id: lineage-admission
      kind: AdmitLineage
      state_output: ReleaseAdmitted
      output_class: typed-receipt
      resource_class: control
    - id: stage4-build
      kind: BuildProduct
      state_output: Built
      output_class: quarantined-descendant
      resource_class: compiler-critical
    - id: deploy
      kind: DeployProduct
      state_output: Published
      output_class: protected
      resource_class: exclusive-deploy

  edges:
    - from: stage1-build
      to: stage1-smoke
      type: artifact-and-receipt
    - from: stage1-smoke
      to: stage1-whole-tests
      type: artifact-and-sanity
    - from: stage1-whole-tests
      to: stage2-build
      type: collection-terminal-with-usable-producer
    - from: stage2-build
      to: stage2-smoke-admission
      type: artifact-and-receipt
    - from: stage2-smoke-admission
      to: stage3-build
      type: speculative-parent
    - from: stage2-smoke-admission
      to: stage2-qualification
      type: qualification
    - from: stage2-smoke-admission
      to: stage2-subsystem-tests
      type: speculative-parent
    - from: stage2-smoke-admission
      to: stage4-from-stage2
      type: speculative-parent
    - from: stage4-from-stage2
      to: stage4-from-stage2-tests
      type: artifact-and-sanity
    - from: stage3-build
      to: stage3-smoke
      type: artifact-and-receipt
    - from: stage3-smoke
      to: stage3-whole-tests
      type: speculative-parent
    - from: stage3-smoke
      to: stage4-from-stage3
      type: speculative-parent
    - from: stage4-from-stage3
      to: stage4-from-stage3-tests
      type: artifact-and-sanity
    - from: stage3-build
      to: lineage-admission
      type: artifact-and-provenance
    - from: stage2-qualification
      to: lineage-admission
      type: qualification
    - from: stage1-whole-tests
      to: lineage-admission
      type: qualification
    - from: stage2-subsystem-tests
      to: lineage-admission
      type: qualification
    - from: stage3-whole-tests
      to: lineage-admission
      type: qualification
    - from: lineage-admission
      to: stage4-build
      type: qualified-lineage
    - from: stage4-build
      to: deploy
      type: exclusive-publication
    - from: stage4-from-stage2-tests
      to: deploy
      type: qualification
    - from: stage4-from-stage3-tests
      to: deploy
      type: qualification

  invalidation:
    recursive: true
    preserve_rejected_artifacts: true
    stale_lease_publication: deny
    unknown_failure: invalidate

  collection:
    independent_failures: continue
    same_failure_repair_cycles: 3
    exhausted_failure: bug-linked-workaround-or-blocked
    preserve_compatible_caches: true
    test_registry_enumeration: required
    zero_tests_pass: deny
    diagnostic_results_admit_release: false

  resources:
    compiler_critical_reservation: required
    qualification_uses_remainder: true
    child_memory_limit: ulimit-v-or-serialize
    unenforceable_memory_overlap: deny
    cpu_slots_forwarded_to_children: true
    deploy_token: exclusive
