#!/bin/sh
# Explicit temporary standalone lane. It grants no aggregate-product authority.
set -eu
tool_root=$(CDPATH= cd -P -- "$(dirname "$0")/../.." && pwd -P)
[ "$#" -eq 4 ] || { echo 'usage: run-native-one-file-adapter.shs ABS_WORKSPACE ABS_ADMITTED_COMPILER llvm|cranelift ABS_NEW_OUTPUT' >&2; exit 2; }
workspace=$1 compiler=$2 backend=$3 output=$4
case "$backend" in llvm|cranelift) ;; *) exit 2 ;; esac
for path in "$workspace" "$compiler" "$output"; do case "$path" in /*) ;; *) exit 2 ;; esac; done
workspace=$(CDPATH= cd -P -- "$workspace" && pwd -P)
[ ! -e "$output" ] && [ ! -L "$output" ] || { echo 'output exists: preserve evidence and caches' >&2; exit 2; }
[ -z "${SIMPLE_BOOTSTRAP_EMPTY_NATIVE_OBJ:-}${SIMPLE_BOOTSTRAP:-}" ] || exit 2
field() { perl -e 'my($k,$p)=@ARGV; open my $f,"<",$p or die $!; my @v=map { /^\Q$k\E=(.*)$/ ? $1 : () } <$f>; @v==1 or die "missing/duplicate $k"; print $v[0]' "$1" "$2"; }
hash() { perl -MDigest::SHA -e 'open my $f,"<:raw",$ARGV[0] or die $!; my $s=Digest::SHA->new(256); $s->addfile($f); print $s->hexdigest' "$1"; }
producer_sha=$(hash "$compiler")
admission=$(dirname "$compiler")/admission.env
perl "$tool_root/scripts/bootstrap/product-producer-fields.pl" "$admission" qualified "$compiler" "$producer_sha" "$workspace" >/dev/null
binding=$(dirname "$compiler")/runtime-capsule.env
[ "$(field schema "$binding")" = simple-phase2-runtime-binding-v1 ]
[ "$(field compiler_sha256 "$binding")" = "$producer_sha" ]
capsule=$(field capsule_path "$binding")
[ "$(hash "$capsule/phase2-runtime-capsule.env")" = "$(field capsule_receipt_sha256 "$binding")" ]
[ "$(field compiler_sha256 "$capsule/phase2-runtime-capsule.env")" = "$producer_sha" ]
runtime=$(field runtime_authority_path "$admission")
[ "$(field source_authority_path "$capsule/phase2-runtime-capsule.env")" = "$runtime" ]
sh "$tool_root/scripts/bootstrap/phase2-runtime-capsule.shs" verify "$capsule" >/dev/null
# Dedicated physical workspaces prevent concurrently generated entries or moved caches.
entry_root=$workspace/src/app/native_one_file_adapter
[ ! -e "$entry_root" ] && [ ! -L "$entry_root" ] || { echo 'use a dedicated workspace without an adapter entry' >&2; exit 2; }
mkdir "$entry_root"
perl "$tool_root/scripts/bootstrap/native-one-file-adapter.pl" "$workspace" "$output"
mkdir -p "$output/tmp" "$output/user-storage" "$output/worktree-storage"
source_head=$(git -C "$workspace" rev-parse HEAD)
{
    printf '%s\n' 'schema=simple-restricted-native-adapter-build-v1' 'producer_phase=phase2' 'formal_product_pass=0'
    printf '%s\n' "source_root=$workspace" "source_head=$source_head" "backend=$backend" "compiler=$compiler" "compiler_sha256=$producer_sha"
    printf '%s\n' "admission_sha256=$(hash "$admission")" "runtime_capsule_sha256=$(hash "$capsule/phase2-runtime-capsule.env")"
    printf '%s\n' 'SIMPLE_HIR_CACHE=0' 'SIMPLE_NO_STUB_FALLBACK=1' 'SIMPLE_SCV_INVENTORY_COLD_INIT=1'
    printf '%s\n' 'threads_requested=10' 'rss_cap_kib=6835937' 'observation_budget_ms=5000'
} >"$output/build.env"
for variant in positive negative; do
    mkdir "$entry_root/$variant"
    cp "$output/$variant-entry.spl" "$entry_root/$variant/main.spl"
    (
        cd "$workspace"
        export SIMPLE_HIR_CACHE=0 SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_SCV_INVENTORY_COLD_INIT=1
        export SIMPLE_PROJECT_ROOT="$workspace" SIMPLE_LIB="$workspace/src"
        export SIMPLE_RUNTIME_PATH="$runtime" SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap
        export SIMPLE_NATIVE_BUILD_THREADS=10 SIMPLE_NATIVE_FILE_TIMEOUT=1800 SIMPLE_SHARD_MEM_CLAMP=1
        export SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB=6835937 SIMPLE_BOOTSTRAP_RSS_CAP_MODE=enforce
        export SIMPLE_PROCESS_TREE_OBSERVATION_BUDGET_MS=5000
        export SIMPLE_USER_STORAGE_ROOT="$output/user-storage" SIMPLE_WORKTREE_STORAGE_ROOT="$output/worktree-storage" TMPDIR="$output/tmp"
        export SIMPLE_PROCESS_TREE_RSS_RECEIPT="$output/$variant-build.watchdog.env"
        sh "$tool_root/scripts/bootstrap/run-process-group-timeout.shs" 1800 5 "$compiler" native-build \
            "--backend=$backend" --threads 10 --source src/compiler --source src/app --source src/lib \
            --entry-closure --entry "src/app/native_one_file_adapter/$variant/main.spl" \
            --cache-dir "$output/cache-$backend-$producer_sha-$variant" --output "$output/$variant"
    ) >"$output/$variant-build.log" 2>&1
    for mode in enumerate run; do
        status=0
        timeout 60 "$output/$variant" "--$mode" >"$output/$variant-$mode.stdout.log" 2>"$output/$variant-$mode.stderr.log" || status=$?
        printf '%s\n' "$status" >"$output/$variant-$mode.exit"
    done
done
perl "$tool_root/scripts/bootstrap/verify-native-one-file-adapter.pl" "$output" >"$output/result.json"
printf '%s\n' "RESTRICTED_NATIVE_GATE_PASS: $output/result.json (not an aggregate product)"
