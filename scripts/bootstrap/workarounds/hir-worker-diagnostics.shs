#!/bin/sh
# Optional diagnostic configuration. Sourcing this file changes no environment.
# Call explicitly in a subshell around an existing admitted native-build command.
simple_enable_hir_worker_diagnostics_workaround() {
    # @workaround bug=BUG-WIN-HIR-WORKER-DIAGNOSTICS-20261010 recover=d6abe34243c4ea9365454eca4c7e8586b8d216bf reason=disable optional async HIR warmup while retaining ordinary compiler diagnostics and admission
    SIMPLE_HIR_SHARDING=0
    export SIMPLE_HIR_SHARDING
}
