#!/bin/sh
# Cross-CPU bootstrap / release: build the compiler for a target CPU on the
# host (fast), then check it on the target CPU (qemu-user sanity, VM tests).
#
#   sh scripts/bootstrap/cross-arch-bootstrap.shs --target <platform>
#      [--compiler <host compiler>] [--phase <N>] [--qemu-sanity] [--vm-test]
#
# platform: linux-riscv64 | linux-aarch64 | freebsd-riscv64 | freebsd-aarch64
# --compiler  host compiler that cross-compiles. Default: the Rust seed
#             (result = phase 1). A host phase-3 compiler gives phase 4: the
#             phase-3 sources rebuilt for the target CPU by a fixpoint compiler.
# --phase     phase label of the result (default: 1 for the seed, else 4).
# --qemu-sanity  run `--version` of the result under qemu-user (Linux targets).
# --vm-test   sync the result into the target's QEMU system VM lane and run
#             the sanity + hello build + test smoke there.
# Output: build/cross/<platform>/simple, PHASE next to it. Exit 1 on failure.
set -eu

target= compiler= phase= qemu_sanity=0 vm_test=0
while [ $# -gt 0 ]; do
  case $1 in
    --target) target=${2:?}; shift 2 ;;
    --compiler) compiler=${2:?}; shift 2 ;;
    --phase) phase=${2:?}; shift 2 ;;
    --qemu-sanity) qemu_sanity=1; shift ;;
    --vm-test) vm_test=1; shift ;;
    *) echo "cross-arch-bootstrap: unknown argument $1" >&2; exit 2 ;;
  esac
done

# platform -> rust triple, simple triple, linker, qemu-user, VM lane
case $target in
  linux-riscv64)   rust=riscv64gc-unknown-linux-gnu; triple=riscv64-unknown-linux-gnu
                   linker=riscv64-linux-gnu-gcc; qemu=qemu-riscv64-static; sysroot=/usr/riscv64-linux-gnu
                   lane=scripts/check/check-linux-riscv64-bootstrap-qemu.shs ;;
  linux-aarch64)   rust=aarch64-unknown-linux-gnu; triple=aarch64-unknown-linux-gnu
                   linker=aarch64-linux-gnu-gcc; qemu=qemu-aarch64-static; sysroot=/usr/aarch64-linux-gnu; lane= ;;
  freebsd-riscv64) rust=riscv64gc-unknown-freebsd; triple=riscv64-unknown-freebsd
                   linker=${FREEBSD_CROSS_CC:-}; qemu=; sysroot=${FREEBSD_SYSROOT:-}
                   lane=scripts/check/check-freebsd-riscv64-bootstrap-qemu.shs ;;
  freebsd-aarch64) rust=aarch64-unknown-freebsd; triple=aarch64-unknown-freebsd
                   linker=${FREEBSD_CROSS_CC:-}; qemu=; sysroot=${FREEBSD_SYSROOT:-}; lane= ;;
  *) echo "cross-arch-bootstrap: unsupported --target $target" >&2; exit 2 ;;
esac
[ -n "$linker" ] || { echo "cross-arch-bootstrap: $target needs FREEBSD_CROSS_CC and FREEBSD_SYSROOT" >&2; exit 2; }

seed=src/compiler_rust/target/bootstrap/simple
if [ -z "$compiler" ]; then
  compiler=$seed
  [ -x "$compiler" ] || (cd src/compiler_rust && cargo build --profile bootstrap -p simple-driver)
  : "${phase:=1}"
else
  : "${phase:=4}"
fi

# Target runtime archive. The std for the target must belong to the toolchain
# rust-toolchain.toml pins, not whatever rustup default is active.
upper=$(printf '%s' "$rust" | tr 'a-z-' 'A-Z_')
(cd src/compiler_rust && rustup target add "$rust" >/dev/null 2>&1 || true
 env "CARGO_TARGET_${upper}_LINKER=$linker" \
   cargo build --profile bootstrap -p simple-native-all --features driver-compat --target "$rust")
runtime=src/compiler_rust/target/$rust/bootstrap

out_dir=build/cross/$target
mkdir -p "$out_dir"
rm -f "$out_dir/simple"
seed_env=
[ "$compiler" = "$seed" ] && seed_env=SIMPLE_NATIVE_BUILD_RUST=1
echo "cross-arch-bootstrap: $compiler -> $target (phase $phase)"
env RUST_LOG=error SIMPLE_BOOTSTRAP=1 SIMPLE_SCV_INVENTORY_COLD_INIT=1 SIMPLE_PARSE_SHARDING=0 $seed_env \
  "$compiler" native-build --target "$triple" --runtime-path "$runtime" \
  --source src/compositions/kernel_llvm_cranelift --source src \
  --entry-closure --entry src/app/cli/bootstrap_main.spl \
  --mode dynload --threads "${SIMPLE_NATIVE_BUILD_THREADS:-4}" \
  --output "$out_dir/simple" || true
[ -f "$out_dir/simple" ] || { echo "cross-arch-bootstrap: no binary produced" >&2; exit 1; }
echo "$phase" > "$out_dir/PHASE"
file "$out_dir/simple" 2>/dev/null || true

if [ "$qemu_sanity" = 1 ]; then
  [ -n "$qemu" ] || { echo "cross-arch-bootstrap: no qemu-user for $target; use --vm-test" >&2; exit 1; }
  QEMU_LD_PREFIX=$sysroot "$qemu" "$out_dir/simple" --version
  echo "cross-arch-bootstrap: qemu-user sanity PASS"
fi

if [ "$vm_test" = 1 ]; then
  [ -n "$lane" ] || { echo "cross-arch-bootstrap: no VM lane for $target yet" >&2; exit 1; }
  # The lane owns VM lifecycle and transport; it runs the sanity + tests there.
  sh "$lane" --cross-test "$out_dir/simple"
fi
echo "cross-arch-bootstrap: $out_dir/simple (phase $phase)"
