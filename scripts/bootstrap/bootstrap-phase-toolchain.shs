#!/bin/sh
# Phase verification owns the native-build toolchain boundary. Generated
# sources are C: use clang on Unix-like hosts and CLANG64 clang (default) or
# clang-cl (explicit msvc) on Windows, never a gcc/g++/cl.exe fallback.
bootstrap_phase_toolchain_error() {
    echo "bootstrap-phase-toolchain: $1" >&2
    return 1
}

# Match the Windows setup owner's admitted 23.1 patch family. Authority still
# records the selected executable's physical path, hash and actual version.
bootstrap_phase_windows_llvm_version_valid() {
    printf '%s\n' "$1" | sed -n '1p' | grep -Eq '^clang version 23\.1\.[0-9]+([[:space:]]|$)'
}

# Windows ABI of the phase: gnu (MinGW UCRT / MSYS2 CLANG64) by default, msvc
# only by explicit SIMPLE_WINDOWS_ABI=msvc. See
# doc/07_guide/infra/toolchain/windows_mingw_ucrt.md.
bootstrap_phase_windows_abi() {
    case "${SIMPLE_WINDOWS_ABI:-gnu}" in
        gnu|msvc) printf '%s\n' "${SIMPLE_WINDOWS_ABI:-gnu}" ;;
        *) bootstrap_phase_toolchain_error 'SIMPLE_WINDOWS_ABI must be gnu or msvc'; return 1 ;;
    esac
}

# LLVM prefix that owns the Windows C driver: LLVM_SYS_231_PREFIX when set,
# else the active MSYS2 environment prefix (MINGW_PREFIX, e.g. /clang64).
bootstrap_phase_windows_llvm_prefix() {
    phase_llvm_prefix=${LLVM_SYS_231_PREFIX:-}
    if [ -z "$phase_llvm_prefix" ] && [ "$(bootstrap_phase_windows_abi)" = gnu ]; then
        phase_llvm_prefix=${MINGW_PREFIX:-}
    fi
    case "$phase_llvm_prefix" in
        /*|[A-Za-z]:[\\/]*) printf '%s\n' "$phase_llvm_prefix" ;;
        *) bootstrap_phase_toolchain_error 'Windows requires an absolute LLVM_SYS_231_PREFIX (or MINGW_PREFIX for gnu)'; return 1 ;;
    esac
}

# The receipt writer and executor resolve the same C driver. Keep the spelling
# native on Windows; the canonical authority helper hashes its physical file.
# gnu uses the CLANG64 clang.exe (target x86_64-w64-windows-gnu, LLD); msvc
# uses clang-cl.exe from the same pinned prefix.
bootstrap_phase_c_compiler_path() (
    case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        phase_prefix=$(bootstrap_phase_windows_llvm_prefix) || exit 1
        case "$(bootstrap_phase_windows_abi)" in
            msvc) phase_resolved_cc="$phase_prefix/bin/clang-cl.exe" ;;
            gnu) phase_resolved_cc="$phase_prefix/bin/clang.exe" ;;
            *) exit 1 ;;
        esac
        [ -f "$phase_resolved_cc" ] && [ -x "$phase_resolved_cc" ] || exit 1
        cygpath -am "$phase_resolved_cc"
        ;;
    *)
        phase_resolved_cc=${CC:-clang}
        case "${phase_resolved_cc##*/}" in
            clang|clang-[0-9]*) ;;
            *) bootstrap_phase_toolchain_error 'Unix phase C compiler must be clang'; exit 1 ;;
        esac
        command -v "$phase_resolved_cc"
        ;;
    esac
)

bootstrap_phase_c_target_platform() {
    case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        phase_target_abi=$(bootstrap_phase_windows_abi) || return 1
        printf '%s\n' "x86_64-pc-windows-$phase_target_abi"
        ;;
    *) bootstrap_stage3_host_platform ;;
    esac
}

bootstrap_phase_run_command() (
    phase_executor=$1
    shift
    [ "${2:-}" = native-build ] || { "$phase_executor" "$@"; exit $?; }
    case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        # Git Bash MSYSTEM never selects the ABI. gnu (default) keeps CLANG64
        # clang.exe, GNU ABI/linker flavor and the -windows-gnu target
        # together; msvc keeps LLVM 23.1.x clang-cl, MSVC ABI and CL=/TC
        # together. Do not change this to gcc, g++, cl.exe, or ambient PATH
        # discovery on another host.
        phase_abi=$(bootstrap_phase_windows_abi) || exit 1
        bootstrap_phase_windows_llvm_prefix >/dev/null || exit 1
        phase_cc=$(bootstrap_phase_c_compiler_path) || exit 1
        if [ "$phase_abi" = msvc ]; then
            phase_cc_name=clang-cl.exe
        else
            phase_cc_name=clang.exe
        fi
        if [ -n "${CC:-}" ]; then
            phase_requested_cc=$(cygpath -am "$CC") || exit 1
            [ "$phase_requested_cc" = "$phase_cc" ] || {
                bootstrap_phase_toolchain_error "CC must match the pinned LLVM $phase_cc_name"; exit 1;
            }
        fi
        case "$phase_abi:${SIMPLE_LINKER_FLAVOR:-$phase_abi}" in
            msvc:msvc|gnu:gnu) ;;
            *) bootstrap_phase_toolchain_error 'Windows phase linker flavor must match SIMPLE_WINDOWS_ABI'; exit 1 ;;
        esac
        if [ "$phase_abi" = msvc ]; then
            case "${CL:-/TC}" in
                /TC) ;;
                *) bootstrap_phase_toolchain_error 'Windows phase requires CL=/TC'; exit 1 ;;
            esac
        fi
        phase_windows_target="x86_64-pc-windows-$phase_abi"
        phase_target_seen=0
        phase_target_next=0
        for phase_arg in "$@"; do
            if [ "$phase_target_next" = 1 ]; then
                [ "$phase_arg" = "$phase_windows_target" ] || {
                    bootstrap_phase_toolchain_error "Windows phase requires the $phase_windows_target target"; exit 1;
                }
                phase_target_next=0
                continue
            fi
            case "$phase_arg" in
                --target) phase_target_seen=1; phase_target_next=1 ;;
                --target="$phase_windows_target") phase_target_seen=1 ;;
                --target=*) bootstrap_phase_toolchain_error "Windows phase requires the $phase_windows_target target"; exit 1 ;;
            esac
        done
        [ "$phase_target_next" = 0 ] || {
            bootstrap_phase_toolchain_error 'missing native-build target'; exit 1;
        }
        # Reuse the matrix's bounded executor for the version probe too.
        phase_version=$("$phase_executor" "$phase_cc" --version) || exit 1
        bootstrap_phase_windows_llvm_version_valid "$phase_version" || {
            bootstrap_phase_toolchain_error "Windows phase requires LLVM $phase_cc_name 23.1.x"; exit 1;
        }
        CC=$phase_cc
        SIMPLE_WINDOWS_ABI=$phase_abi
        SIMPLE_LINKER_FLAVOR=$phase_abi
        export CC SIMPLE_WINDOWS_ABI SIMPLE_LINKER_FLAVOR
        if [ "$phase_abi" = msvc ]; then
            CL=/TC
            export CL
            bootstrap_windows_preserve_cl_mode
        fi
        [ "$phase_target_seen" = 1 ] || set -- "$@" --target "$phase_windows_target"
        ;;
    *)
        CC=$(bootstrap_phase_c_compiler_path) || {
            bootstrap_phase_toolchain_error 'Unix phase requires executable clang'; exit 1;
        }
        # Some admitted compilers still route generated source through CXX.
        # Bind that driver too; the compiler owner decides the source language.
        phase_cxx=${CXX:-clang++}
        case "${phase_cxx##*/}" in
            clang++|clang++-[0-9]*) ;;
            *) bootstrap_phase_toolchain_error 'Unix phase C++ compiler must be clang++'; exit 1 ;;
        esac
        CXX=$(command -v "$phase_cxx") || {
            bootstrap_phase_toolchain_error 'Unix phase requires executable clang++'; exit 1;
        }
        export CC CXX
        ;;
    esac
    # Pure-Simple runtime compilation reads SIMPLE_CC rather than CC. Reject an
    # ambient override so the target receipt cannot describe a different tool.
    if [ -n "${SIMPLE_CC:-}" ]; then
        case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            phase_simple_cc=$(command -v "$SIMPLE_CC") || exit 1
            phase_simple_cc=$(cygpath -am "$phase_simple_cc") || exit 1
            ;;
        *) phase_simple_cc=$(command -v "$SIMPLE_CC") || exit 1 ;;
        esac
        [ "$phase_simple_cc" = "$CC" ] || {
            bootstrap_phase_toolchain_error 'SIMPLE_CC must match the pinned C compiler'; exit 1;
        }
    fi
    SIMPLE_CC=$CC
    export SIMPLE_CC
    if [ -n "${source_root:-}" ]; then
        if [ -n "${SIMPLE_PROJECT_ROOT:-}" ]; then
            phase_project_root=$(CDPATH= cd -- "$SIMPLE_PROJECT_ROOT" && pwd -P) || exit 1
            [ "$phase_project_root" = "$source_root" ] || {
                bootstrap_phase_toolchain_error 'SIMPLE_PROJECT_ROOT must match the matrix source root'; exit 1;
            }
        fi
        case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) SIMPLE_PROJECT_ROOT=$(cygpath -am "$source_root") || exit 1 ;;
        *) SIMPLE_PROJECT_ROOT=$source_root ;;
        esac
        export SIMPLE_PROJECT_ROOT
    fi
    if [ -n "${tmp:-}" ]; then
        case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            TMP=$(cygpath -am "$tmp") || exit 1
            TEMP=$TMP
            export TMP TEMP
            ;;
        esac
    fi
    "$phase_executor" "$@"
)
