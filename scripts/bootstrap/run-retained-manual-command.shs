#!/bin/sh
# @workaround bug=retained_manual_system_link_old_seed_abi_2026_10_25
# Only the native aggregate and canonical entry shim are compiled. The runtime
# is retained; no Rust/bootstrap selector is introduced by this owner.
set -eu
root=$1 log=$2 transcript=$3 task_home=$4 task_tmp=$5 producer=$6 runtime=$7
shift 7
[ "$1" = -- ]; shift
BOOTSTRAP_STAGE3_FACADE_PATH=$root/scripts/check/lib/bootstrap-stage3-provenance.shs
export BOOTSTRAP_STAGE3_FACADE_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
unset SIMPLE_BOOTSTRAP SIMPLE_NATIVE_BUILD_RUST SIMPLE_BOOTSTRAP_STAGE3 SIMPLE_BOOTSTRAP_STAGE4 SIMPLE_BOOTSTRAP_WHOLE_PROGRAM SIMPLE_TEST_RUNNER_RUST
unset SIMPLE_BOOTSTRAP_SESSION_ID SIMPLE_BOOTSTRAP_SESSION_EXEC SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB
unset SIMPLE_COMPILER_PHASE_PROFILE SIMPLE_COMPILER_TRACE SIMPLE_MIRB_TRACE
bootstrap_stage3_run_transcribed "$transcript" "$root" "$log" "$task_home" "$task_tmp" "$PATH" \
 "PATH=$PATH" "SIMPLE_BINARY=$producer" "SIMPLE_RUNTIME_PATH=$runtime" \
 SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_ABI_POLICY=v1 SIMPLE_PLUGIN_MANIFEST_POLICY=simple-sdn \
 SIMPLE_NATIVE_BUILD_EMIT_OBJECT=1 SIMPLE_MIR_SHARDING=0 \
 SIMPLE_COMPILER_PHASE_PROFILE=0 SIMPLE_COMPILER_TRACE=0 SIMPLE_MIRB_TRACE=0 \
 SIMPLE_PACKAGE_INDEX_COLD_INIT=1 SIMPLE_SCV_INVENTORY_COLD_INIT=1 -- "$@"
