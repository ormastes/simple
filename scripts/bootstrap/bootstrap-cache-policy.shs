#!/bin/sh
# Cache-policy predicates and helpers shared by the bootstrap wrapper and its
# tests. Most of this file is pure predicates; bootstrap_prune_stale_seed_scope_dirs
# below is the one exception (it does real filesystem I/O) and is kept here
# anyway so the wrapper and its selftest share one implementation.

bootstrap_cache_force_clear_one_binary() {
  # Only an explicit clean profile may discard compatible cache state.
  [ "$1" = clean-release ]
}

# Mutable service caches bind the phase, exact producer, admitted input
# context, and entry. The context digest includes the target/runtime inputs;
# identical lineage retries therefore keep the same writable directory.
bootstrap_phase_service_cache() (
  [ "$#" -eq 5 ] || return 1
  service_cache_base=${1%/}
  service_cache_phase=$2 service_cache_producer=$3 service_cache_inputs=$4
  service_cache_entry=$5
  case "$1" in /*|[A-Za-z]:[\\/]*) ;; *) return 1 ;; esac
  case "$service_cache_phase" in stage1|stage2|stage3|stage4) ;; *) return 1 ;; esac
  for service_cache_digest in "$service_cache_producer" "$service_cache_inputs"; do
    [ "${#service_cache_digest}" -eq 64 ] || return 1
    case "$service_cache_digest" in *[!0-9a-f]*) return 1 ;; esac
  done
  case "$service_cache_entry" in mcp|lsp) ;; *) return 1 ;; esac
  printf '%s/%s/%s/%s/%s\n' "$service_cache_base" "$service_cache_phase" \
    "$service_cache_producer" "$service_cache_inputs" "$service_cache_entry"
)

# Strategy validation is kept pure so the stage engine remains usable when the
# optional coordinated supervisor is unavailable.
bootstrap_strategy_validate() {
  case "$1" in
    adhoc|normal|full) return 0 ;;
    *) return 1 ;;
  esac
}

# Every run collects independent results by default, including CI.
# Exact env 0/1 overrides that default; empty/invalid values use the default.
# Resolve before scheduling so descendants inherit the same decision. Explicit
# flags override env in argument order.
bootstrap_compile_failure_policy() {
  case "${SIMPLE_COMPILE_FAIL_FAST:-}" in
    0|1) ;;
    *) SIMPLE_COMPILE_FAIL_FAST=0 ;;
  esac
  for bootstrap_policy_arg in "$@"; do
    case "$bootstrap_policy_arg" in
      --fail-fast) SIMPLE_COMPILE_FAIL_FAST=1 ;;
      --keep-going) SIMPLE_COMPILE_FAIL_FAST=0 ;;
    esac
  done
  export SIMPLE_COMPILE_FAIL_FAST
}

bootstrap_strategy_failure_policy() {
  # Strategy chooses scheduling, while the resolved compile flag chooses when
  # independent work stops. Report the policy the workers actually receive.
  bootstrap_strategy_validate "$1" || return 1
  if [ "${SIMPLE_COMPILE_FAIL_FAST:-0}" = 1 ]; then
    printf '%s\n' fail-fast
  else
    printf '%s\n' inventory-to-end
  fi
}

# Compatibility hook: automatic scope pruning is prohibited. An explicit
# owned, idle lineage clean is provided by clean-bootstrap-cache.shs.
bootstrap_prune_stale_seed_scope_dirs() { return 0; }

# Bounded retention for keyed cache directories: under <parent>, keep the
# <current> child plus the newest others, <keep> children in total. A child
# with any file modified in the last 6 hours, or holding a .in-use.<pid>
# marker of a live process, is in use by another lane and is never removed.
# The caller's current child gets its own marker. Eviction renames first so a
# half-deleted dir is never reused.
bootstrap_prune_lru_dirs() (
  [ "$#" -eq 4 ] || return 64
  lru_parent=$1 lru_current=$2 lru_keep=$3 lru_label=$4
  case "$lru_keep" in
    [1-9]|[1-9][0-9]*) ;;
    *) echo "error: $lru_label keep count must be a positive integer (got '$lru_keep')" >&2; return 1 ;;
  esac
  [ -d "$lru_parent" ] || return 0
  if [ -d "$lru_parent/$lru_current" ]; then
    touch "$lru_parent/$lru_current"
    : > "$lru_parent/$lru_current/.in-use.$$" 2>/dev/null || :
  fi
  lru_kept=0
  ls -1dt -- "$lru_parent"/* 2>/dev/null | while IFS= read -r lru_d; do
    [ -d "$lru_d" ] || continue
    lru_name=${lru_d##*/}
    case "$lru_name" in *.evict.*) rm -rf "$lru_d"; continue ;; esac
    [ "$lru_name" != "$lru_current" ] || continue
    if [ "$lru_kept" -lt "$((lru_keep - 1))" ]; then
      lru_kept=$((lru_kept + 1)); continue
    fi
    lru_live=0
    for lru_marker in "$lru_d"/.in-use.*; do
      [ -e "$lru_marker" ] || continue
      lru_pid=${lru_marker##*.in-use.}
      case "$lru_pid" in ''|*[!0-9]*) continue ;; esac
      ! kill -0 "$lru_pid" 2>/dev/null || lru_live=1
    done
    # find -mmin is GNU and BSD; a failing find keeps the dir (fail closed).
    lru_recent=$(find "$lru_d" -maxdepth 5 -mmin -360 -print 2>/dev/null | head -1) || lru_recent=failed
    if [ "$lru_live" -eq 1 ] || [ -n "$lru_recent" ]; then
      echo "bootstrap: keeping in-use $lru_label $lru_name" >&2; continue
    fi
    if mv "$lru_d" "$lru_d.evict.$$"; then
      chmod -R u+w "$lru_d.evict.$$" 2>/dev/null
      rm -rf "$lru_d.evict.$$" && echo "bootstrap: evicted $lru_label $lru_name" >&2
    else
      echo "bootstrap: warning: could not evict $lru_label $lru_name" >&2
    fi
  done
)
