#!/bin/sh
# Cache-policy predicates and helpers shared by the bootstrap wrapper and its
# tests. Most of this file is pure predicates; bootstrap_prune_stale_seed_scope_dirs
# below is the one exception (it does real filesystem I/O) and is kept here
# anyway so the wrapper and its selftest share one implementation.

bootstrap_cache_force_clear_one_binary() {
  # Only an explicit clean profile may discard compatible cache state.
  [ "$1" = clean-release ]
}

# Mutable service caches bind the phase, exact producer, admitted input
# context, and entry. The context digest includes the target/runtime inputs;
# identical lineage retries therefore keep the same writable directory.
bootstrap_phase_service_cache() (
  [ "$#" -eq 5 ] || return 1
  service_cache_base=${1%/}
  service_cache_phase=$2 service_cache_producer=$3 service_cache_inputs=$4
  service_cache_entry=$5
  case "$1" in /*|[A-Za-z]:[\\/]*) ;; *) return 1 ;; esac
  case "$service_cache_phase" in stage1|stage2|stage3|stage4) ;; *) return 1 ;; esac
  for service_cache_digest in "$service_cache_producer" "$service_cache_inputs"; do
    [ "${#service_cache_digest}" -eq 64 ] || return 1
    case "$service_cache_digest" in *[!0-9a-f]*) return 1 ;; esac
  done
  case "$service_cache_entry" in mcp|lsp) ;; *) return 1 ;; esac
  printf '%s/%s/%s/%s/%s\n' "$service_cache_base" "$service_cache_phase" \
    "$service_cache_producer" "$service_cache_inputs" "$service_cache_entry"
)

# Strategy validation is kept pure so the stage engine remains usable when the
# optional coordinated supervisor is unavailable.
bootstrap_strategy_validate() {
  case "$1" in
    adhoc|normal|full) return 0 ;;
    *) return 1 ;;
  esac
}

bootstrap_strategy_failure_policy() {
  case "$1" in
    adhoc) printf '%s\n' fail-fast ;;
    normal) printf '%s\n' phase-isolated ;;
    full) printf '%s\n' inventory-to-end ;;
    *) return 1 ;;
  esac
}

# Compatibility hook: automatic scope pruning is prohibited. An explicit
# owned, idle lineage clean is provided by clean-bootstrap-cache.shs.
bootstrap_prune_stale_seed_scope_dirs() { return 0; }
