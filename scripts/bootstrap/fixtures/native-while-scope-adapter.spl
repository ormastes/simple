use std.sffi.cli_args.{cli_get_args}

fn authored_case() -> i64:
    var adapter_assertions: i64 = 0
    var adapter_failures: i64 = 0
    var shadow = 99
    var i = 0
    while i < 2:
        val shadow = i + 5
        i = i + 1
    adapter_assertions = adapter_assertions + 1
    if i != 2:
        adapter_failures = adapter_failures + 1
        print "assertion\tline=8\tstatus=FAIL\tactual={i}\texpected=2"
    else:
        print "assertion\tline=8\tstatus=PASS\tactual={i}\texpected=2"
    adapter_assertions = adapter_assertions + 1
    if shadow != 99:
        adapter_failures = adapter_failures + 1
        print "assertion\tline=9\tstatus=FAIL\tactual={shadow}\texpected=99"
    else:
        print "assertion\tline=9\tstatus=PASS\tactual={shadow}\texpected=99"
    if adapter_assertions != 2: return 125
    if adapter_failures > 0:
        print "result\t858157aa34c088cf0ea8171ae89401567d5f5fe487fd9fafa89b769f5b8bc1da\tFAIL\tassertions={adapter_assertions}\tfailures={adapter_failures}"
        return 1
    print "result\t858157aa34c088cf0ea8171ae89401567d5f5fe487fd9fafa89b769f5b8bc1da\tPASS\tassertions={adapter_assertions}\tfailures={adapter_failures}"
    0

fn main() -> i64:
    var enumerating = false
    var running = false
    for arg in cli_get_args():
        if arg == "--enumerate": enumerating = true
        elif arg == "--run": running = true
    if enumerating == running: return 2
    print "owner\ttest/01_unit/compiler/interpreter/while_body_scope_spec.spl\t492ce803161d0df2b2b21fa540f154f15b8d82aa0156698700502596eb6f985f"
    print "declare\t858157aa34c088cf0ea8171ae89401567d5f5fe487fd9fafa89b769f5b8bc1da\tinterpreter while-body scope\tdoes not overwrite an enclosing binding"
    if enumerating:
        print "enumeration-complete\tcases=1"
        return 0
    authored_case()
