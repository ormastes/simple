#!/bin/sh
# Exact-environment launcher for a Phase C tool-build row.
#
#   sh phase-c-tool-row-exec.shs <command> [args...]
#
# Replaces this process with `env -i <row keys> <command> [args...]`, where
# the row keys are bootstrap_phase_c_tool_row_environment_keys
# (phase-c-backend-commands.shs), each with its exact current value. The
# verifier (bootstrap-phase-verification.shs, run_measured_timeout) puts this
# around the tree-RSS timeout owner for the stage2/stage3 native-build tool
# rows, so the owner, its watchdog and the compiler all see the constructed
# environment while the command argv stays byte-identical.
set -eu
phase_c_tool_row_lib=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)/phase-c-backend-commands.shs
. "$phase_c_tool_row_lib"
bootstrap_phase_c_tool_row_exec "$@"
