#!/bin/sh
# Phase C native-build commands. The verifier supplies run_matrix_task/run_task;
# keeping argv construction here lets the backend contract be exercised without
# building the full compiler in a shell fixture.

# MIR shards for the full-tool rows (see bootstrap_phase_c_run_tool_build).
BOOTSTRAP_PHASE_C_TOOL_MIR_SHARD_COUNT=8

bootstrap_phase_c_backend_valid() {
  case "$1" in llvm|cranelift) return 0 ;; *) return 1 ;; esac
}

bootstrap_phase_c_tool_input_identity() {
  pcb_backend=$1 pcb_runtime=$2 pcb_target=$3 pcb_source=$4
  bootstrap_phase_c_backend_valid "$pcb_backend" || return 2
  printf '%s\n' "$pcb_runtime" "$pcb_target" "$pcb_source" "$pcb_backend" | hash_stream
}

bootstrap_phase_c_validate_backend_receipt() {
  pcb_backend=$1 pcb_receipt=$2
  bootstrap_phase_c_backend_valid "$pcb_backend" || return 2
  [ "$(manifest_key_count verification_backend "$pcb_receipt")" = 1 ] &&
    [ "$(manifest_value verification_backend "$pcb_receipt")" = "$pcb_backend" ]
}

# Exact launch environment of a Phase C tool-build row (compiler_cli_build,
# test_runner_build, mcp_build, lsp_build): host basics, the toolchain pins
# bootstrap_phase_run_command exports, and the keys the verifier, the tree-RSS
# policy, the product frontend policy and bootstrap_phase_c_run_tool_build set
# for the row. Nothing else reaches the row: bootstrap-fable-17 (2026-11-12,
# ea253974c0e) launched the row from the caller's whole shell, and the HIR
# worker profile (src/app/cli/worker_hir_profile_v1.spl, reject-never-sanitize)
# refused it in one line naming 111 keys (GITHUB_TOKEN, TMUX, CLAUDE_CODE_*,
# BOOTSTRAP_VERIFY_*, SIMPLE_BOOTSTRAP_*_ROOT, ...), which is fatal for the row
# ("error: HIR aggregate failure; final worker and artifact publication
# blocked"). Earlier Stage 2 compilers never started the pool on this row:
# under the pre-fb5a084c30f seed, `match raw.to_i64(): case Some(value)` in
# native_build_closure_selected_count_v1 bound 3, so the small-closure clamp
# zeroed the HIR pool (closure_files=3 measured with run 13 and run 16 Stage 2
# binaries, 3134 with run 17's); run 16's rows also ran at one compiler job.
# Every key here must be admitted by that profile; the contract test
# (test/01_unit/scripts/bootstrap_phase_c_backend_command_contract_test.shs)
# cross-checks the two lists so they cannot drift apart again. Keys the row
# does not consume below the launch (BOOTSTRAP_VERIFY_*, the campaign roots,
# SIMPLE_BOOTSTRAP_TREE_RSS_CLI_ROW_*, the tree-RSS cap SOURCE/BOUND
# diagnostics, SIMPLE_BUILD_PROGRESS_SNAPSHOT) are deliberately absent.
bootstrap_phase_c_tool_row_environment_keys() {
  printf '%s\n' \
    PATH HOME USER LOGNAME SHELL TMPDIR TMP TEMP LANG LC_ALL LC_CTYPE TZ TERM CI \
    SYSTEMROOT WINDIR COMSPEC PATHEXT OS \
    CC CXX SIMPLE_CC INCLUDE LIB LIBPATH LIBRARY_PATH SIMPLE_WINDOWS_ABI \
    SIMPLE_TOOLCHAINS_ROOT SIMPLE_HOST_CONFIG \
    SIMPLE_BOOTSTRAP_SESSION_ID SIMPLE_BOOTSTRAP_SESSION_EXEC \
    SIMPLE_BOOTSTRAP_PROCESS_OBSERVER SIMPLE_BOOTSTRAP_PROCESS_OBSERVER_SHA256 \
    SIMPLE_PROCESS_TREE_OBSERVATION_BUDGET_MS \
    SIMPLE_BINARY SIMPLE_PROJECT_ROOT SIMPLE_NO_STUB_FALLBACK SIMPLE_NO_BOOTSTRAP_DELEGATE \
    SIMPLE_NATIVE_BUILD_CACHE_DIR SIMPLE_RT_OBJ_CACHE_DIR SIMPLE_FRONTEND_CACHE_DIR SIMPLE_HIR_CACHE_DIR \
    SIMPLE_NATIVE_RUNTIME_BUNDLE SIMPLE_RUNTIME_PATH SIMPLE_NATIVE_BUILD_TARGET SIMPLE_NATIVE_BUILD_THREADS \
    SIMPLE_ABI_POLICY SIMPLE_RUNTIME_RISCV64_VECTOR SIMPLE_BOOTSTRAP_STAGE3 SIMPLE_BOOTSTRAP_STAGE4 \
    SIMPLE_MEM_SNAPSHOT_FILE SIMPLE_COMPILER_PHASE_PROFILE SIMPLE_COMPILER_PHASE_PROFILE_FILE SIMPLE_EVIDENCE_RUN_ID \
    SIMPLE_COMPILE_FAIL_FAST SIMPLE_KERNEL_K1_POLICY \
    SIMPLE_CACHE_SCOPE SIMPLE_CACHE SIMPLE_NATIVE_ARENA_DECLS SIMPLE_FRONTEND_CACHE SIMPLE_HIR_CACHE \
    SIMPLE_MANAGED_NATIVE_TOOLS SIMPLE_MANAGED_NATIVE_TOOL_AUTHORITY_PATH SIMPLE_MANAGED_NATIVE_TOOL_AUTHORITY_SHA256 \
    SIMPLE_MANAGED_RUNTIME_AUTHORITY_PATH SIMPLE_MANAGED_RUNTIME_SNAPSHOT_PATH SIMPLE_MANAGED_RUNTIME_SNAPSHOT_SHA256 \
    SIMPLE_FILE_WORKERS SIMPLE_MIR_SHARD_COUNT \
    SIMPLE_SHARD_MEM_CLAMP SIMPLE_PARSE_SHARD_WORKER_KB SIMPLE_HIR_SHARD_WORKER_KB SIMPLE_MIR_SHARD_WORKER_KB SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB \
    SIMPLE_PROCESS_TREE_RSS_SCOPE_GROUP SIMPLE_PROCESS_TREE_RSS_DECLARED_JOBS SIMPLE_PROCESS_TREE_RSS_RECEIPT \
    SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB SIMPLE_BOOTSTRAP_RSS_CAP_MODE
}

# Re-launch "$@" from `env -i` plus the keys above, each with its exact
# current value (present-but-empty stays present). The command argv is not
# touched: every owner (run_task's managed-tool block, bootstrap_phase_run_command,
# run-process-group-timeout.shs) keys on argv[0]=compiler argv[1]=native-build,
# which an `env VAR=... compiler` argv prefix broke in run 6 (2026-11-06); the
# wrapper therefore sits around the timeout owner, like Phase 4 direct's
# `env -i ... sh "$timeout_helper"`. `printenv` reads each value without eval;
# a value ending in a newline would lose it (no row key carries one).
bootstrap_phase_c_tool_row_exec() {
  [ "$#" -gt 0 ] || { echo 'phase C tool row: no command to launch' >&2; return 125; }
  case "${SIMPLE_BOOTSTRAP_SESSION_ID+x}${SIMPLE_BOOTSTRAP_SESSION_EXEC+x}" in
    xx|'') ;;
    *) echo 'phase C tool row: incomplete inherited session contract' >&2; return 125 ;;
  esac
  for pcb_row_key in $(bootstrap_phase_c_tool_row_environment_keys); do
    if pcb_row_value=$(printenv -- "$pcb_row_key"); then
      set -- "$pcb_row_key=$pcb_row_value" "$@"
    fi
  done
  exec env -i "$@"
}

# Apply the product frontend share before the process-tree owner starts. On a
# fanout host the share is the resolved command cap (priced per declared job by
# tree-rss-policy.shs); its watchdog resolves the same cap from the same
# --threads, so the exported budget and the enforced cap agree. Code generation
# still receives the caller's --threads value.
#
# Every refusal names itself on stderr as verification-frontend-policy-error.
# The caller runs this inside the row wrapper, whose stdout+stderr ARE the row
# log, and maps any failure to exit 88. A silent return left run 15
# (bfe789dd411, 2026-11-12) with compiler_cli_build status=88 after 0 s and a
# 0-byte log: that row's elevated ceiling (the 60 GiB cli-row-mir-shards cap)
# is re-admitted here against live MemAvailable (3/4 of available >= ceiling),
# and co-resident lanes had consumed the headroom the phase-start admission
# saw. The refusal is correct; only its silence was the defect.
bootstrap_phase_c_frontend_policy_error() {
  printf 'verification-frontend-policy-error: %s\n' "$1" >&2
  return 1
}

bootstrap_phase_c_apply_frontend_policy() {
  . "$source_root/scripts/bootstrap/lib/tree-rss-policy.shs" ||
    bootstrap_phase_c_frontend_policy_error "cannot load $source_root/scripts/bootstrap/lib/tree-rss-policy.shs" || return 1
  . "$source_root/scripts/bootstrap/lib/product-frontend-policy.shs" ||
    bootstrap_phase_c_frontend_policy_error "cannot load $source_root/scripts/bootstrap/lib/product-frontend-policy.shs" || return 1
  bootstrap_tree_rss_resolve "$pure_tool_threads" "$source_root" ||
    bootstrap_phase_c_frontend_policy_error "${bootstrap_tree_rss_refusal:-tree RSS policy refused without a recorded reason} (threads ${pure_tool_threads:-unset})" ||
    return 1
  # Thread the resolved job-scaled ceiling through: the frontend environment
  # validates cap <= ceiling, and without the resolved value it falls back to
  # the static 8 GiB ceiling -- which refuses every cap above 8 GiB (the
  # elevated-admission range this phase needs for real full-CLI builds,
  # ~2.4 GiB per worker). Absent this, the tool builds exited 88 in ~1s with
  # no log (frontend policy failure inside the row wrapper).
  pcb_frontend_rows=$(bootstrap_product_frontend_policy qualified \
    "$bootstrap_tree_rss_cap_kib" "${SIMPLE_BOOTSTRAP_RSS_CAP_MODE:-enforce}" \
    "$bootstrap_tree_rss_ceiling_kib") ||
    bootstrap_phase_c_frontend_policy_error "product frontend policy refused cap $bootstrap_tree_rss_cap_kib KiB (ceiling $bootstrap_tree_rss_ceiling_kib KiB, rss mode ${SIMPLE_BOOTSTRAP_RSS_CAP_MODE:-enforce}); an inherited SIMPLE_SHARD_MEM_CLAMP/SIMPLE_PARSE_SHARD_*/SIMPLE_HIR_SHARD_WORKER_KB/SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB contradicts scripts/bootstrap/lib/product-frontend-policy.shs, or cap > ceiling" ||
    return 1
  while IFS= read -r pcb_frontend_setting; do
    export "$pcb_frontend_setting" ||
      bootstrap_phase_c_frontend_policy_error "cannot export '$pcb_frontend_setting'" || return 1
    printf 'verification_frontend_policy=%s\n' "$pcb_frontend_setting"
  done <<EOF
$pcb_frontend_rows
EOF
}

bootstrap_phase_c_run_tool_build() {
  pcb_backend=$1 pcb_task=$2 pcb_compiler=$3 pcb_entry=$4 pcb_output=$5 pcb_cache=$6 pcb_threads=$7
  bootstrap_phase_c_backend_valid "$pcb_backend" || return 2
  bootstrap_phase_c_policy_refused=0
  # --entry-closure: the positional entry IS a frozen entry closure, but the
  # coordinator publishes the parse-closure request only on the explicit flag
  # (native_build_closure_publish_once_v1), and the HIR shard profile the
  # SIMPLE_FILE_WORKERS=0 pin below selects admits a worker only against a
  # published request. Without the flag every tool row failed in 12 s with
  # "[hir-shard] profile admission rejected: no closure request published"
  # (bootstrap-fable-11, 2026-11-12).
  set -- "$pcb_compiler" native-build "$pcb_entry" "--backend=$pcb_backend" --low-memory --entry-closure
  # Phase-route pin: these tool entries use AOP advice across module
  # boundaries, which the per-file pool cannot close (fail-closed
  # FILE-WORKER-E-CLOSURE-INCOMPLETE, observed 2026-11-05 on
  # compiler_cli_build). The two-pass route needs the row RSS budget that
  # BOOTSTRAP_VERIFY_TEST_WORKERS=2 provides (the per-row tree budget is the
  # session cap divided by concurrent test workers). This is the documented
  # per-invocation opt-out, not a script-global default.
  # The pin travels in the ENVIRONMENT (exported around run_matrix_task and
  # restored after), never as an `env VAR=...` argv prefix: every owner keys
  # on argv[0]=compiler / argv[1]=native-build -- the verifier's Stage 2
  # managed-tool block (bootstrap-phase-verification.shs), the toolchain pin
  # (bootstrap-phase-toolchain.shs) and the tree-RSS owner
  # (run-process-group-timeout.shs). Run 6 (2026-11-06) proved the prefix
  # bypassed all three: the owner stripped the published phase-policy cap and
  # ceiling and killed the full-CLI build at the 13 GiB default budget.
  # --cache-dir is mandatory: without it both concurrent tool workers
  # (cli + runner) share the ambient native cache root and race each other
  # (HIR ledger creation failed, parse shards SIGSEGV'd, 2026-11-05). The
  # caller has always computed a private per-tool cache; it was dropped here.
  set -- "$@" --cache-dir "$pcb_cache"
  # The verifier validates this setting before dispatch. Preserve an explicit
  # diagnostic zero instead of silently using the coordinator's six-hour cap.
  # Standalone callers without a configured timeout retain their existing argv.
  if [ -n "${native_internal_timeout:-}" ]; then
    set -- "$@" --timeout "$native_internal_timeout"
  fi
  pcb_fw_was_set=${SIMPLE_FILE_WORKERS+x}
  pcb_fw_previous=${SIMPLE_FILE_WORKERS-}
  SIMPLE_FILE_WORKERS=0
  export SIMPLE_FILE_WORKERS
  # MIR shard count pin, same per-invocation scoping. The coordinator's
  # default is one shard per concurrent worker, so on this row each of the 2
  # workers claimed ~1516 of 3031 modules. A worker starts MIR at ~19.3 GiB
  # (its own HIR) and holds every claimed module's MIR until it exits (no
  # collector), ~11 MiB per module: run 10 (2026-11-06) hit the 52 GiB tree
  # cap at module 1088. Run 11 (8 shards, ~382 modules each) hit the same
  # 52 GiB cap in the first wave's end-of-shard codegen; #7302 then priced
  # this row at 60 GiB. Run 13 (5fdf9fa4fc0, 60 GiB row cap) ran all 8 shards
  # through MIR in 10156 s of the 14400 s row timeout, with no RSS-cap kill;
  # tree RSS peaked at ~57 GiB in the 2 app.* shards that reached codegen.
  # The 6 compiler.*/lib.* shards stopped on MIR errors before codegen, so
  # their codegen headroom is UNMEASURED. Each extra shard repeats the ~19 min
  # frontend: 12 shards project to 12400-15200 s before that codegen, at or
  # past the timeout. Re-measure once those shards lower clean. An explicit
  # caller value wins.
  pcb_mc_was_set=${SIMPLE_MIR_SHARD_COUNT+x}
  pcb_mc_previous=${SIMPLE_MIR_SHARD_COUNT-}
  SIMPLE_MIR_SHARD_COUNT=${SIMPLE_MIR_SHARD_COUNT:-$BOOTSTRAP_PHASE_C_TOOL_MIR_SHARD_COUNT}
  export SIMPLE_MIR_SHARD_COUNT
  pcb_status=0
  # Row RSS cap: the whole-build phase policy may publish a compiler_cli_build
  # row cap above the phase cap (run 11, 2026-11-06: two MIR shard workers of
  # this row reached 24.0 + 25.2 GiB under the 52 GiB phase cap). The policy
  # owns the value and its admission; this only scopes it around the row,
  # like the pins above. A malformed published cap fails the row closed.
  command -v bootstrap_tree_rss_row_cap_enter >/dev/null 2>&1 ||
    . "${source_root:?phase C tool build needs source_root for the tree RSS policy}/scripts/bootstrap/lib/tree-rss-policy.shs" ||
    return 1
  if bootstrap_tree_rss_row_cap_enter "$pcb_task"; then
    run_matrix_task "$pcb_task" --verification-expect-executable="$pcb_output" \
      "$@" --threads "$pcb_threads" -o "$pcb_output" || pcb_status=$?
    bootstrap_tree_rss_row_cap_leave
  else
    printf 'process-timeout-policy-error: %s\n' "$bootstrap_tree_rss_refusal" >&2
    bootstrap_phase_c_policy_refused=1
    matrix_task_passed=0
    pcb_status=125
  fi
  if [ -n "$pcb_fw_was_set" ]; then
    SIMPLE_FILE_WORKERS=$pcb_fw_previous
  else
    unset SIMPLE_FILE_WORKERS
  fi
  if [ -n "$pcb_mc_was_set" ]; then
    SIMPLE_MIR_SHARD_COUNT=$pcb_mc_previous
  else
    unset SIMPLE_MIR_SHARD_COUNT
  fi
  return "$pcb_status"
}

bootstrap_phase_c_run_module_build() {
  pcb_backend=$1 pcb_compiler=$2 pcb_entry=$3 pcb_output=$4 pcb_log_dir=$5 pcb_threads=$6
  bootstrap_phase_c_backend_valid "$pcb_backend" || return 2
  # The coordinator derives output kind from argv and replaces the inherited
  # driver environment. An object filename or EMIT_OBJECT alone is insufficient.
  set -- "$pcb_compiler" native-build "$pcb_entry" --emit-object "--backend=$pcb_backend" --threads "$pcb_threads" -o "$pcb_output"
  printf '%s\n' 'SIMPLE_NATIVE_BUILD_EMIT_OBJECT=1' "$@" >"$pcb_log_dir/command.argv" || return 1
  run_task module_compile_object "$@"
}
