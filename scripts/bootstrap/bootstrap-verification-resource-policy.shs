#!/bin/sh
# Explicit diagnostic execution never produces the canonical overall=PASS.
bootstrap_verification_resource_policy() {
    [ "$#" -eq 8 ] || return 2
    bvrp_phase=$1 bvrp_diagnostic=$2 bvrp_timeout=$3 bvrp_spec=$4
    bvrp_native=$5 bvrp_build=$6 bvrp_modules=$7 bvrp_tests=$8
    case "$bvrp_diagnostic" in 0|1) ;; *) return 2 ;; esac
    for bvrp_value in "$bvrp_timeout" "$bvrp_spec" "$bvrp_native" \
        "$bvrp_build" "$bvrp_modules" "$bvrp_tests"; do
        case "$bvrp_value" in ''|*[!0-9]*) return 2 ;; esac
    done
    if [ "$bvrp_diagnostic" = 0 ]; then
        [ "$bvrp_timeout" -gt 0 ] && [ "$bvrp_spec" -gt 0 ] || return 2
        [ "$bvrp_native" -gt 60 ] || return 2
        [ "$bvrp_phase" != stage3 ] || [ "$bvrp_build" -le 12 ] || return 2
    else
        [ "$bvrp_native" -eq 0 ] || [ "$bvrp_native" -gt 60 ] || return 2
        [ "$bvrp_build" -le 80 ] || return 2
    fi
    [ "$bvrp_build" -gt 0 ] || return 2
    verification_worker_limit=12
    [ "$bvrp_phase" != stage2 ] || verification_worker_limit=80
    # The explicit diagnostic budget is already capped at 80 above. Preserve
    # its allocation instead of restoring a hidden stage3 twelve-worker cap.
    [ "$bvrp_diagnostic" != 1 ] || verification_worker_limit=$bvrp_build
    [ "$bvrp_modules" -gt 0 ] && [ "$bvrp_modules" -le "$verification_worker_limit" ] || return 2
    [ "$bvrp_tests" -gt 0 ] && [ "$bvrp_tests" -le "$verification_worker_limit" ] || return 2
    verification_success_result=PASS
    [ "$bvrp_diagnostic" = 0 ] || verification_success_result=DIAGNOSTIC_PASS
}
