#!/bin/sh
# Validate parser-authored main declarations against source-bound verdict policy.
set -eu

adapter_binary=
source_root=
inventory=
spans=
output=
policy=

for arg in "$@"; do
  case "$arg" in
    --binary=*) adapter_binary=${arg#--binary=} ;;
    --source-root=*) source_root=${arg#--source-root=} ;;
    --inventory=*) inventory=${arg#--inventory=} ;;
    --spans=*) spans=${arg#--spans=} ;;
    --output=*) output=${arg#--output=} ;;
    --policy=*) policy=${arg#--policy=} ;;
    *) echo "compiler-subsystem-main-verdicts: unknown argument" >&2; exit 2 ;;
  esac
done

if [ -z "$adapter_binary" ] || [ -z "$source_root" ] || [ -z "$inventory" ] ||
   [ -z "$spans" ] || [ -z "$output" ]; then
  echo 'usage: compiler-subsystem-main-verdicts.shs --binary=ADMITTED_NATIVE_ADAPTER --source-root=ROOT --inventory=TSV --spans=SPAN_TSV --output=VERDICT_TSV [--policy=TSV]' >&2
  exit 2
fi
if [ ! -x "$adapter_binary" ] || [ ! -d "$source_root" ] || [ ! -f "$inventory" ] ||
   [ ! -f "$spans" ] || [ -e "$output" ]; then
  echo 'compiler-subsystem-main-verdicts: missing authority or output already exists' >&2
  exit 2
fi

if [ -n "$policy" ]; then
  exec "$adapter_binary" "--source-root=$source_root" "--inventory=$inventory" \
    "--spans=$spans" "--policy=$policy" "--output=$output"
fi
exec "$adapter_binary" "--source-root=$source_root" "--inventory=$inventory" \
  "--spans=$spans" "--output=$output"
