#!/bin/sh
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$repo/scripts/bootstrap/bootstrap-seed-stop-policy.shs"
count=0
accept() { bootstrap_seed_stop_policy_validate "$@" || exit 1; count=$((count + 1)); }
reject() { code=0; bootstrap_seed_stop_policy_validate "$@" 2>/dev/null || code=$?; [ "$code" = 64 ]; count=$((count + 1)); }
accept --full-bootstrap --stop-after-seed --jobs=80 --strategy=full
accept --stop-after-seed --full-bootstrap
accept --resume-managed-from-admitted=/previous --bootstrap-receipt=/receipt
reject --stop-after-seed
for option in --resume-managed-from-admitted=/previous --resume-stage3-from-admitted=/previous \
    --resume-stage4-from-admitted=/previous --validate-bootstrap-receipt --stop-after-stage2 \
    --stop-after-stage3 --deploy --release-tests --pure-simple --produce-managed-receipt=reason \
    --bootstrap-receipt=/receipt --invalidate-cache=stage2 --full-cli --help; do
    reject --full-bootstrap --stop-after-seed "$option"
    reject "$option" --full-bootstrap --stop-after-seed
done
printf 'PASS seed stop policy: %s cases, managed-resume and alternate exits refused before dispatch\n' "$count"
