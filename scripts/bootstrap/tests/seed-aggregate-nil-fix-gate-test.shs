#!/bin/sh
# Bug stage3_macos_full_graph_hir_sigsegv_2026_09_21: a Stage2 built by a seed
# lacking 2c89727c11c (nil Optional<aggregate> -> zeroed aggregate) must be
# refused at seed handoff, not discovered as a Stage3 SIGSEGV.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT HUP INT TERM
. "$repo/scripts/bootstrap/bootstrap-seed-handoff.shs"
rel=src/compiler_rust/compiler/src/codegen/llvm/functions/objects.rs
mkdir -p "$scratch/fixed/${rel%/*}" "$scratch/old/${rel%/*}" "$scratch/none"
printf '    .build_select(src_is_valid, tagged, src_tagged, "aggcopy_result")\n' >"$scratch/fixed/$rel"
printf '    Ok(tagged)\n' >"$scratch/old/$rel"
bootstrap_seed_has_aggregate_nil_fix "$scratch/fixed"
if bootstrap_seed_has_aggregate_nil_fix "$scratch/old"; then exit 1; fi
if bootstrap_seed_has_aggregate_nil_fix "$scratch/none"; then exit 1; fi
bootstrap_seed_has_aggregate_nil_fix "$repo"
printf 'PASS seed aggregate-nil fix gate: 4 cases (fixed, pre-fix, missing, real tree)\n'
