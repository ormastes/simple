#!/bin/sh
# A known entry with changed source must never reach its executable.
set -eu
work=${1:?fresh evidence}
here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
mkdir "$work"; work=$(CDPATH= cd -- "$work" && pwd -P)
mkdir -p "$work/repo/src/app/lsp"
printf '# Unreviewed replacement\n' >"$work/repo/src/app/lsp/main.spl"
printf '#!/bin/sh\necho executed >"%s"\n' "$work/incorrectly-executed" >"$work/binary.shs"
chmod +x "$work/binary.shs"
code=0
sh "$here/run-reviewed-native-sanity.shs" "$work/repo" "$work/probe" src/app/lsp/main.spl "$work/binary.shs" >"$work/stdout" 2>"$work/stderr" || code=$?
[ "$code" = 2 ] && [ ! -e "$work/incorrectly-executed" ] && [ ! -e "$work/probe" ]
grep -q 'reviewed source changed' "$work/stderr"
printf 'PASS: changed reviewed source rejected before executable or owner launch\n'
