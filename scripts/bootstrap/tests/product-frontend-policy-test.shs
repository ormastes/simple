#!/bin/sh
# Real child environment transport, no compiler or native PASS simulated.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$repo/scripts/check/lib/bootstrap-stage3/command-snapshot.shs"
. "$repo/scripts/bootstrap/lib/product-frontend-policy.shs"
scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT HUP INT TERM
unset SIMPLE_BOOTSTRAP_FRONTEND_MEMORY_BUDGET_KIB SIMPLE_SHARD_MEM_CLAMP \
  SIMPLE_PARSE_SHARD_MAX SIMPLE_PARSE_SHARD_WORKER_KB SIMPLE_HIR_SHARD_WORKER_KB \
  SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB
if bootstrap_product_frontend_policy diagnostic 5859375 monitor >"$scratch/absent" 2>/dev/null; then exit 1; fi
[ ! -s "$scratch/absent" ]
count=1
for mode in enforce monitor; do
  SIMPLE_BOOTSTRAP_FRONTEND_MEMORY_BUDGET_KIB=3000000
  rows=$(bootstrap_product_frontend_policy diagnostic 5859375 "$mode")
  (
    while IFS= read -r row; do export "$row"; done <<EOF
$rows
EOF
    export SIMPLE_NATIVE_BUILD_THREADS=80
    sh -c 'printf "%s\n" "$SIMPLE_NATIVE_BUILD_THREADS" "$SIMPLE_SHARD_MEM_CLAMP" "$SIMPLE_PARSE_SHARD_MAX" "$SIMPLE_PARSE_SHARD_WORKER_KB" "$SIMPLE_HIR_SHARD_WORKER_KB" "$SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB"'
  ) >"$scratch/child"
  printf '%s\n' 80 1 1 1650000 3000000 3000000 >"$scratch/expected"
  cmp "$scratch/expected" "$scratch/child"
  count=$((count + 1))
done
for share in 0 -1 8388609 broken; do
  SIMPLE_BOOTSTRAP_FRONTEND_MEMORY_BUDGET_KIB=$share
  if bootstrap_product_frontend_policy diagnostic 5859375 monitor >"$scratch/rejected" 2>/dev/null; then exit 1; fi
  [ ! -s "$scratch/rejected" ]
  count=$((count + 1))
done
SIMPLE_BOOTSTRAP_FRONTEND_MEMORY_BUDGET_KIB=3000000
for bad in SIMPLE_SHARD_MEM_CLAMP=0 SIMPLE_PARSE_SHARD_MAX=80 \
  SIMPLE_PARSE_SHARD_WORKER_KB=1 SIMPLE_HIR_SHARD_WORKER_KB=1 SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=0; do
  (
    export "$bad"
    if bootstrap_product_frontend_policy diagnostic 5859375 monitor >"$scratch/rejected" 2>/dev/null; then exit 1; fi
    [ ! -s "$scratch/rejected" ]
  )
  count=$((count + 1))
done
# An enclosing watchdog's larger cap is consistent; a smaller one wins.
rows=$(SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=5859375 bootstrap_product_frontend_policy diagnostic 5859375 enforce)
printf '%s\n' "$rows" | grep -qx SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=3000000
count=$((count + 1))
rows=$(SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=2000000 bootstrap_product_frontend_policy diagnostic 5859375 enforce)
printf '%s\n' "$rows" | grep -qx SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=2000000
[ "$(printf '%s\n' "$rows" | grep -c '^SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=')" -eq 1 ]
count=$((count + 1))
for bad in broken 0100 -1; do
  if SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=$bad bootstrap_product_frontend_policy diagnostic 5859375 enforce >"$scratch/rejected" 2>/dev/null; then exit 1; fi
  [ ! -s "$scratch/rejected" ]
  count=$((count + 1))
done
rows=$(bootstrap_product_frontend_policy qualified 2000000 enforce)
printf '%s\n' "$rows" | grep -qx SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=2000000
count=$((count + 1))
# Fanout host (this test runs on one): the default product share is the
# enforced cap itself -- 8 HIR-priced jobs give 45088768 KiB, which the
# compiler's clamp (60% / 3000000 KiB) turns into 8 workers -- in both RSS
# modes. An explicit smaller share still wins; an explicit share above the cap
# is clamped to the enforced cap, kept in monitor mode, refused above the
# resolved ceiling.
# Windows keeps the one-worker share (windows-frontend-resource-policy-test).
unset SIMPLE_BOOTSTRAP_FRONTEND_MEMORY_BUDGET_KIB
budget_row() { bootstrap_product_frontend_policy qualified 45088768 "$1" 50331648 | grep '^SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB='; }
if bootstrap_product_frontend_fanout_host; then
  [ "$(budget_row enforce)" = SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=45088768 ]
  [ "$(budget_row monitor)" = SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=45088768 ]
  [ "$(SIMPLE_BOOTSTRAP_FRONTEND_MEMORY_BUDGET_KIB=3000000 budget_row enforce)" = SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=3000000 ]
  [ "$(SIMPLE_BOOTSTRAP_FRONTEND_MEMORY_BUDGET_KIB=46000000 budget_row enforce)" = SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=45088768 ]
  [ "$(SIMPLE_BOOTSTRAP_FRONTEND_MEMORY_BUDGET_KIB=46000000 budget_row monitor)" = SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=46000000 ]
  if SIMPLE_BOOTSTRAP_FRONTEND_MEMORY_BUDGET_KIB=50331649 bootstrap_product_frontend_policy qualified 45088768 enforce 50331648 >"$scratch/rejected" 2>/dev/null; then exit 1; fi
  [ ! -s "$scratch/rejected" ]
else
  [ "$(budget_row enforce)" = SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=3000000 ]
  [ "$(budget_row monitor)" = SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=3000000 ]
  for share in 3000001 45088768 46000000 50331649; do
    if SIMPLE_BOOTSTRAP_FRONTEND_MEMORY_BUDGET_KIB=$share bootstrap_product_frontend_policy qualified 45088768 enforce 50331648 >"$scratch/rejected" 2>/dev/null; then exit 1; fi
    [ ! -s "$scratch/rejected" ]
  done
fi
count=$((count + 6))
printf 'PASS product frontend policy: %s cases, real child transport; no native build\n' "$count"
