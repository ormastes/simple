#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/scripts/bootstrap/bootstrap-verification-resource-policy.shs"
count=0
accept() { bootstrap_verification_resource_policy "$@" || exit 1; count=$((count + 1)); }
reject() { if bootstrap_verification_resource_policy "$@" 2>/dev/null; then exit 1; fi; count=$((count + 1)); }
accept stage3 0 1800 120 600 12 2 1
[ "$verification_success_result" = PASS ]
reject stage3 0 0 120 600 12 2 1
reject stage3 0 1800 0 600 12 2 1
reject stage3 0 1800 120 0 12 2 1
reject stage3 0 1800 120 600 40 2 1
accept stage3 1 0 0 0 40 2 1
[ "$verification_success_result" = DIAGNOSTIC_PASS ]
accept stage2 1 0 0 0 80 80 80
reject stage3 1 0 0 0 81 2 1
accept stage3 1 0 0 0 40 13 1
accept stage3 1 0 0 0 40 2 13
accept stage3 1 0 0 0 80 80 80
[ "$verification_worker_limit" = 80 ]
reject stage3 1 0 0 0 40 41 1
reject stage3 1 0 0 0 40 2 41
reject stage2 1 0 0 0 20 21 1
reject stage3 1 0 0 60 40 2 1
reject stage3 1 -1 0 0 40 2 1
reject stage3 1 invalid 0 0 40 2 1
reject stage3 invalid 0 0 0 40 2 1
reject stage3 1 0 0 0 0 2 1
printf 'PASS verification resource policy: %s cases\n' "$count"
