#!/bin/sh
# Production policy and real process-owner regression; no compiler required.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$repo/scripts/bootstrap/bootstrap-verification-campaign.shs"
work=$(mktemp -d "${TMPDIR:-/tmp}/verification-campaign.XXXXXX")
# Retain failed evidence; successful caller can archive/remove its own temp root.
echo "campaign-test-evidence=$work"
fail() { echo "FAIL: $*" >&2; exit 1; }
bootstrap_verification_campaign_policy 30 8 || fail policy
if bootstrap_verification_campaign_policy 0 8; then fail zero-deadline; fi
if bootstrap_verification_campaign_policy 30 -1; then fail negative-sample; fi
printf '%s\n' one two three four five >"$work/full"
: >"$work/summary"
bootstrap_verification_select_modules "$work/full" "$work/selected" 0 1 2 "$work/summary"
[ "$(wc -l <"$work/selected" | tr -d ' ')" = 2 ] || fail bounded-sample
[ "$(wc -l <"$work/selected.unexecuted" | tr -d ' ')" = 3 ] || fail missing-unexecuted
[ "$(wc -l <"$work/full" | tr -d ' ')" = 5 ] || fail full-inventory-mutated
grep -q 'result=INCOMPLETE|status=bounded-campaign-checkpoint|count=3' "$work/summary" || fail truthful-blocked
: >"$work/healthy-summary"
bootstrap_verification_select_modules "$work/full" "$work/healthy" 1 1 2 "$work/healthy-summary"
cmp -s "$work/full" "$work/healthy" || fail healthy-scope-reduced
bootstrap_verification_select_modules "$work/full" "$work/zero" 1 0 0 "$work/summary"
cmp -s "$work/full" "$work/zero" || fail zero-limit-must-retain-all
mkdir "$work/failure" "$work/child-timeout" "$work/deadline" "$work/cancel"
printf 'preserved\n' >"$work/cache"
cat >"$work/child.sh" <<'CHILD'
#!/bin/sh
set -eu
[ "$SIMPLE_BOOTSTRAP_RSS_CAP_MODE" = enforce ] || exit 87
[ -f "$BOOTSTRAP_VERIFY_CAMPAIGN_TOKEN" ] || exit 86
printf '%s\n' "$BOOTSTRAP_VERIFY_CAMPAIGN_DEADLINE" >"$1/deadline-start"
if [ "$2" = fail ]; then exit 7; fi
if [ "$2" = child-timeout ]; then exit 124; fi
# Each row is shorter than its nominal per-row budget, but the campaign is not.
(sleep 20; printf 'escaped\n' >"$1/escaped") &
printf 'first\n' >>"$1/rows"
sleep 2
printf 'second\n' >>"$1/rows"
[ "$(cat "$1/deadline-start")" = "$BOOTSTRAP_VERIFY_CAMPAIGN_DEADLINE" ] || exit 85
sleep 20
printf 'third\n' >>"$1/rows"
CHILD
status=0
bootstrap_verification_campaign_run 30 "$work/failure" "$work/child.sh" "$repo/scripts/bootstrap" "$work/failure" fail >"$work/failure.log" 2>&1 || status=$?
[ "$status" = 7 ] || fail "failure-status-$status"
status=0
bootstrap_verification_campaign_run 30 "$work/child-timeout" "$work/child.sh" "$repo/scripts/bootstrap" "$work/child-timeout" child-timeout >"$work/child-timeout.log" 2>&1 || status=$?
[ "$status" = 124 ] || fail child-timeout-status
[ ! -f "$work/child-timeout/summary.env" ] || fail child-timeout-mislabelled-as-campaign
status=0
bootstrap_verification_campaign_run 5 "$work/deadline" "$work/child.sh" "$repo/scripts/bootstrap" "$work/deadline" deadline >"$work/deadline.log" 2>&1 || status=$?
[ "$status" = 124 ] || fail "deadline-status-$status"
grep -q '^task=campaign_deadline|result=TIMEOUT|status=124|' "$work/deadline/summary.env" || fail timeout-evidence
[ "$(wc -l <"$work/deadline/rows" | tr -d ' ')" = 2 ] || fail deadline-reset
[ ! -e "$work/deadline/escaped" ] || fail descendant-survived
[ "$(cat "$work/cache")" = preserved ] || fail cache-deleted
for receipt in "$work/deadline"/campaign.*/process.env; do
  grep -qx 'quiescent=1' "$receipt" || fail process-tree-not-quiescent
done
bootstrap_verification_campaign_run 30 "$work/cancel" "$work/child.sh" "$repo/scripts/bootstrap" "$work/cancel" cancel >"$work/cancel.log" 2>&1 &
owner=$!
ready=0
while [ ! -s "$work/cancel/deadline-start" ] && [ "$ready" -lt 50 ]; do
  sleep 0.1
  ready=$((ready + 1))
done
[ -s "$work/cancel/deadline-start" ] || fail cancellation-owner-not-started
kill -TERM "$owner"
status=0
wait "$owner" || status=$?
[ "$status" = 143 ] || fail "cancellation-status-$status"
for receipt in "$work/cancel"/campaign.*/process.env; do
  grep -qx 'quiescent=1' "$receipt" || fail cancellation-not-quiescent
done
grep -q '^task=campaign_interrupted|result=FAIL|' "$work/cancel/summary.env" || fail cancellation-evidence
printf 'PASS: campaign deadline/cancellation, descendant cleanup, failure preservation, unchanged RSS policy, bounded failed-prerequisite sample, healthy full scope\n'
