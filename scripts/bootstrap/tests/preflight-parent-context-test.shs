#!/bin/sh
# Source contract controls; these do not qualify a native bootstrap.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/scripts/bootstrap/lib/preflight-configuration.shs"
. "$root/scripts/check/lib/bootstrap-stage3/authority.shs"
. "$root/scripts/check/lib/bootstrap-stage3/command-snapshot.shs"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/preflight-parent-context.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
python3 - "$root" "$tmp/construction-context.sh" <<'EXTRACT'
import sys
from pathlib import Path
source = (Path(sys.argv[1]) / 'scripts/bootstrap/bootstrap-from-scratch.sh').read_text()
start = source.index('bootstrap_preflight_bindings=\nstage2_preflight_context_env=')
end = source.index('bootstrap_step_mark bootstrap-preflight', start)
Path(sys.argv[2]).write_text(source[start:end])
EXTRACT
bootstrap_progress_mark() { :; }
run_rust_authority_command() { return 0; }
repo_root=$root output_dir=$tmp PLATFORM=aarch64-unknown-linux-gnu
PLATFORM_RUST_TRIPLE=$PLATFORM backend=llvm bootstrap_mode=dynload
llvm_features='--features llvm' cargo_abs=/test/cargo seed_bin=/test/seed
bootstrap_preflight_config=untrusted-ambient-value
full_bootstrap=0
. "$tmp/construction-context.sh"
[ -z "$stage2_preflight_context_env" ]
[ -z "$stage2_preflight_context_recorded" ]
full_bootstrap=1
. "$tmp/construction-context.sh"
[ "$stage2_preflight_context_recorded" = 1 ]
[ "$stage2_preflight_context_env" = "SIMPLE_BOOTSTRAP_PREFLIGHT_CONTEXT_V1=$bootstrap_preflight_config" ]
full_bootstrap=0
. "$tmp/construction-context.sh"
[ -z "$stage2_preflight_context_env" ]
[ -z "$stage2_preflight_context_recorded" ]
if (
  full_bootstrap=1
  run_rust_authority_command() { return 37; }
  . "$tmp/construction-context.sh"
  echo 'incorrectly continued after failed checked preflight'
) >"$tmp/failed-construction" 2>&1; then
  echo 'FAIL: construction accepted failed preflight' >&2
  exit 1
else
  [ "$?" -eq 1 ]
fi
grep -q 'authoritative bootstrap preflight failed' "$tmp/failed-construction"
reject() {
  if "$@" >"$tmp/rejected" 2>&1; then
    echo "FAIL: accepted invalid context: $*" >&2
    exit 1
  fi
}
for backend in llvm llvm-lib cranelift; do
  for target in aarch64-unknown-linux-gnu x86_64-pc-windows-msvc; do
    for features in '' '--features llvm'; do
      config=$(bootstrap_preflight_configuration_v1 "$target" "$backend" dynload "$target" "$features")
      recovered=$(bootstrap_preflight_configuration_from_parent_v1 "$config" "$target" "$backend" dynload)
      [ "$recovered" = "$config" ]
      payload="SIMPLE_BOOTSTRAP_PREFLIGHT_CONTEXT_V1=$config"
      printf 'explicit-env:%s:%s\n' "${#payload}" "$payload" >"$tmp/transcript"
      [ "$(bootstrap_stage3_stage2_transcript_preflight_context "$tmp/transcript")" = "$config" ]
      original=$(bootstrap_stage3_args_sha256 "$payload" native-build)
      changed=$(bootstrap_stage3_args_sha256 "${payload};tampered=1" native-build)
      [ "$original" != "$changed" ]
      reject bootstrap_preflight_configuration_from_parent_v1 "$config" different "$backend" dynload
      reject bootstrap_preflight_configuration_from_parent_v1 "${config};extra=1" "$target" "$backend" dynload
    done
  done
done
config=$(bootstrap_preflight_configuration_v1 aarch64-unknown-linux-gnu llvm dynload aarch64-unknown-linux-gnu '--features llvm')
reject bootstrap_preflight_configuration_from_parent_v1 "${config%cargo_features=*}cargo_features=--features untrusted" aarch64-unknown-linux-gnu llvm dynload
reject bootstrap_preflight_configuration_from_parent_v1 "platform=aarch64-unknown-linux-gnu;backend=llvm;mode=dynload;lane=full-bootstrap" aarch64-unknown-linux-gnu llvm dynload
reject bootstrap_preflight_configuration_v1 'bad;platform' llvm dynload aarch64-unknown-linux-gnu ''
: >"$tmp/transcript"
[ -z "$(bootstrap_stage3_stage2_transcript_preflight_context "$tmp/transcript")" ]
legacy=$(bootstrap_stage3_stage2_canonical_env_names aarch64-unknown-linux-gnu)
current=$(bootstrap_stage3_stage2_canonical_env_names aarch64-unknown-linux-gnu '' 1)
[ "$current" = "$legacy SIMPLE_BOOTSTRAP_PREFLIGHT_CONTEXT_V1" ]
payload="SIMPLE_BOOTSTRAP_PREFLIGHT_CONTEXT_V1=$config"
printf 'explicit-env:%s:%s\nexplicit-env:%s:%s\n' "${#payload}" "$payload" "${#payload}" "$payload" >"$tmp/transcript"
reject bootstrap_stage3_stage2_transcript_preflight_context "$tmp/transcript"
printf 'explicit-env:1:%s\n' "$payload" >"$tmp/transcript"
reject bootstrap_stage3_stage2_transcript_preflight_context "$tmp/transcript"
payload=SIMPLE_BOOTSTRAP_PREFLIGHT_CONTEXT_V1=
printf 'explicit-env:%s:%s\n' "${#payload}" "$payload" >"$tmp/transcript"
reject bootstrap_stage3_stage2_transcript_preflight_context "$tmp/transcript"
echo 'PASS: parent preflight context round-trip, hash binding, strict rejection and legacy absence'
