#!/bin/sh
# Command-contract regression; this is not bootstrap admission evidence.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/preflight-cargo-cache.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
python3 - "$root" "$tmp/functions.sh" <<'EXTRACT'
import sys
from pathlib import Path
root = Path(sys.argv[1])
blocks = []
for relative, name, following in [
    ('scripts/check/check-bootstrap-preflight.shs', 'run_preflight_cargo_check', 'capture_bindings'),
    ('scripts/bootstrap/bootstrap-from-scratch.sh', 'run_rust_authority_cargo', 'run_rust_authority_command'),
]:
    source = (root / relative).read_text()
    start = source.index(name + '() {')
    end = source.index(following + '() {', start)
    blocks.append(source[start:end])
Path(sys.argv[2]).write_text('\n'.join(blocks))
EXTRACT
. "$tmp/functions.sh"
cargo() { printf '%s\n' "$@" >"$tmp/args"; return "${cargo_status:-0}"; }
CARGO_CHECK_BIN=cargo CARGO_PROFILE=release CARGO_CHECK_TARGET= CARGO_CHECK_FEATURES=
run_preflight_cargo_check
printf '%s\n' check --profile release --bin simple >"$tmp/wanted"
cmp "$tmp/args" "$tmp/wanted"
CARGO_PROFILE=bootstrap CARGO_CHECK_TARGET=aarch64-unknown-linux-gnu CARGO_CHECK_FEATURES=llvm
run_preflight_cargo_check
printf '%s\n' check --profile bootstrap --bin simple --target aarch64-unknown-linux-gnu --features llvm >"$tmp/wanted"
cmp "$tmp/args" "$tmp/wanted"
cargo_status=37
if run_preflight_cargo_check; then echo 'FAIL: erased Cargo failure' >&2; exit 1; else status=$?; fi
[ "$status" -eq 37 ]
mkdir "$tmp/authority path"
cat >"$tmp/authority path/cargo" <<'PINNED'
#!/bin/sh
printf '%s\n' "$@" >"$PROBE_ARGS"
exit 23
PINNED
chmod +x "$tmp/authority path/cargo"
export PROBE_ARGS="$tmp/args"
CARGO_CHECK_BIN="$tmp/authority path/cargo"
if run_preflight_cargo_check; then echo 'FAIL: pinned Cargo failure erased' >&2; exit 1; else status=$?; fi
[ "$status" -eq 23 ]
cmp "$tmp/args" "$tmp/wanted"
run_rust_authority_command() { printf '%s\n' "$@" >"$tmp/args"; }
cargo_abs='/authority path/cargo' PLATFORM_RUST_TRIPLE=x86_64-pc-windows-msvc
os=windows
run_rust_authority_cargo seed default build --profile bootstrap
printf '%s\n' seed default "$cargo_abs" build --profile bootstrap --target "$PLATFORM_RUST_TRIPLE" >"$tmp/wanted"
cmp "$tmp/args" "$tmp/wanted"
os=linux
run_rust_authority_cargo seed off build --profile bootstrap --target aarch64-unknown-linux-gnu
printf '%s\n' seed off "$cargo_abs" build --profile bootstrap --target aarch64-unknown-linux-gnu >"$tmp/wanted"
cmp "$tmp/args" "$tmp/wanted"
for option in '--cargo-profile=debug' '--cargo-target=--release' '--cargo-target=' '--cargo-features=untrusted' '--cargo-bin=relative' '--cargo-bin=/nonexistent/cargo'; do
  if sh "$root/scripts/check/check-bootstrap-preflight.shs" "$option" --selftest >"$tmp/rejected" 2>&1; then
    echo "FAIL: accepted $option" >&2; exit 1
  fi
  grep -q 'ERROR' "$tmp/rejected"
done
echo 'PASS: preflight profile/target/features, failure propagation, and seed argv contracts'
