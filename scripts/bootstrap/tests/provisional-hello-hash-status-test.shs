#!/bin/sh
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/simple-hello-hash.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
# Exercise the production definition without invoking the compiler launcher.
eval "$(sed -n '/^digest()/p; /^hash_file()/,/^)/p' "$repo/scripts/bootstrap/prepare-provisional-hello.shs")"
mkdir "$tmp/bin"
cat >"$tmp/bin/sha256sum" <<'SH'
#!/bin/sh
printf '%s  fixture\n' aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
exit 7
SH
chmod +x "$tmp/bin/sha256sum"
PATH="$tmp/bin:$PATH"; export PATH
if hash_file "$tmp/input" >"$tmp/out"; then echo 'FAIL: failed hash provider admitted' >&2; exit 1; fi
test ! -s "$tmp/out"
echo 'PASS: production hash helper preserves provider failure and emits no digest'
