#!/bin/sh
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$repo/scripts/bootstrap/bootstrap-verification-campaign.shs"
work=$(mktemp -d "${TMPDIR:-/tmp}/verification-campaign-retained.XXXXXX")
echo "campaign-test-evidence=$work"
fail() { echo "FAIL: $*" >&2; exit 1; }
mkdir -p "$work/token" "$work/reused/module-diagnostics/attempt.prior/000"
BOOTSTRAP_VERIFY_CAMPAIGN_TOKEN="$work/token/owner.env"
BOOTSTRAP_VERIFY_CAMPAIGN_DEADLINE=$(($(date +%s) + 60))
write_token() {
  printf 'work_root=%s\ndeadline_epoch=%s\nowner_pid=%s\n' "$work" "$BOOTSTRAP_VERIFY_CAMPAIGN_DEADLINE" "$1" >"$BOOTSTRAP_VERIFY_CAMPAIGN_TOKEN"
}
: >"$work/token/active"
write_token "$$"
bootstrap_verification_campaign_child "$work" || fail live-owner-rejected
BOOTSTRAP_VERIFY_CAMPAIGN_DEADLINE=1
write_token "$$"
if bootstrap_verification_campaign_child "$work"; then fail expired-token-accepted; fi
BOOTSTRAP_VERIFY_CAMPAIGN_DEADLINE=$(($(date +%s) + 60))
write_token 2147483647
if bootstrap_verification_campaign_child "$work"; then fail dead-owner-accepted; fi
write_token "$$"
rm "$work/token/active"
if bootstrap_verification_campaign_child "$work"; then fail completed-owner-accepted; fi
printf 'old\n' >"$work/reused/module-diagnostics/attempt.prior/000/entry"
printf 'PASS\n' >"$work/reused/module-diagnostics/attempt.prior/000/row"
cat >"$work/child.sh" <<'CHILD'
set -eu
. "$2/scripts/bootstrap/bootstrap-verification-campaign.shs"
bootstrap_verification_campaign_child "$1" || exit 86
printf 'one\ntwo\nthree\n' >"$1/module-compile-inventory.txt"
mkdir -p "$1/module-diagnostics/attempt.current/000" "$1/module-diagnostics/attempt.current/001"
printf 'one\n' >"$1/module-diagnostics/attempt.current/000/entry"
printf 'FAIL\n' >"$1/module-diagnostics/attempt.current/000/row"
printf 'two\n' >"$1/module-diagnostics/attempt.current/001/entry"
sleep 20
CHILD
status=0
bootstrap_verification_campaign_run 3 "$work/reused" "$work/child.sh" "$repo/scripts/bootstrap" "$work/reused" "$repo" >"$work/campaign.log" 2>&1 || status=$?
[ "$status" = 124 ] || fail "deadline-status-$status"
for expected in campaign_module_started=2 campaign_module_terminal=1 campaign_module_interrupted=1 campaign_module_unstarted=1; do
  grep -qx "$expected" "$work/reused/summary.env" || fail "$expected"
done
[ "$(cat "$work/reused/module-diagnostics/attempt.prior/000/row")" = PASS ] || fail retained-evidence-mutated
if bootstrap_verification_campaign_child "$work/reused"; then fail returned-owner-still-active; fi
for receipt in "$work/reused"/campaign.*/process.env; do
  grep -qx 'quiescent=1' "$receipt" || fail descendants-not-quiescent
done
echo 'PASS: retained attempts excluded; live token admitted; expired, dead and completed owner tokens rejected; deadline descendants quiescent'
