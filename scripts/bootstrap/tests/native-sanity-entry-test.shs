#!/bin/sh
# New entry dispatch controls; no application side effects or mocked process receipts.
set -eu
source_root=${1:?immutable source}; work=${2:?fresh evidence}
script_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
runner="$script_root/bootstrap-phase-verification.shs"
native_sanity_helper="$script_root/run-reviewed-native-sanity.shs"
mkdir "$work"; work=$(CDPATH= cd -- "$work" && pwd -P)
mkdir "$work/home" "$work/tmp" "$work/cache" "$work/logs" "$work/helpers"
for fn in run_task matrix_should_skip record_skipped_task run_matrix_task; do
 sed -n "/^$fn() {$/,/^}$/p" "$runner" >>"$work/functions.shs"
done
. "$work/functions.shs"
cat >"$work/fixture.c" <<'C'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
int main(int argc,char **argv) {
 const char *marker=getenv("FIXTURE_MARKER");
 if(marker) {FILE *f=fopen(marker,"w"); if(f){fputs("executed",f);fclose(f);}}
 if(argc!=2 || strcmp(argv[1],"--version")) return 3;
 puts("simple-lsp 0.1.0"); puts("Simple Language Server (LSP)");
 if(getenv("FIXTURE_BAD")) puts("unexpected-extra-output");
 return 0;
}
C
${CC:-cc} "$work/fixture.c" -o "$work/fixture.exe"
printf '#!/bin/sh\ncp "$1" "$2"\n' >"$work/producer.shs"
hash_file() { sha256sum "$1" | awk '{print $1}'; }
read_max_rss_kib() { printf '0\n'; }
stage2_row_delegation_env() { row_no_delegate=1; }
bootstrap_phase_run_command() { "$@"; }
run_with_timeout() { "$@"; }
die() { echo "FAIL: $*" >&2; exit 1; }
phase=stage2; compiler_snapshot=unused
home="$work/home"; tmp="$work/tmp"; cache="$work/cache"; logs="$work/logs"
summary="$work/summary.env"; : >"$summary"
matrix_failed=0; SIMPLE_COMPILE_FAIL_FAST=0
SIMPLE_BOOTSTRAP_SESSION_HELPER_CACHE="$work/helpers"
SIMPLE_BOOTSTRAP_RSS_CAP_MODE=monitor
export SIMPLE_BOOTSTRAP_SESSION_HELPER_CACHE SIMPLE_BOOTSTRAP_RSS_CAP_MODE SIMPLE_COMPILE_FAIL_FAST
FIXTURE_BAD=1; export FIXTURE_BAD
run_matrix_task native_lsp_bad --verification-expect-executable="$work/bad.exe" sh "$work/producer.shs" "$work/fixture.exe" "$work/bad.exe" --entry src/app/lsp/main.spl
[ "$matrix_task_passed" = 0 ] && [ "$matrix_failed" = 1 ] || die 'extra output accepted'
unset FIXTURE_BAD
run_matrix_task native_lsp_good --verification-expect-executable="$work/good.exe" sh "$work/producer.shs" "$work/fixture.exe" "$work/good.exe" --entry=src/app/lsp/main.spl
[ "$matrix_task_passed" = 1 ] && [ "$matrix_failed" = 1 ] || die 'go-end failure latch lost'
FIXTURE_MARKER="$work/unknown-executed"; export FIXTURE_MARKER
run_matrix_task unknown --verification-expect-executable="$work/unknown.exe" sh "$work/producer.shs" "$work/fixture.exe" "$work/unknown.exe" --entry src/app/unknown/main.spl
[ ! -e "$FIXTURE_MARKER" ] || die 'unknown app executed'
grep -q 'task=unknown.*|sanity_status=UNQUALIFIED|behavior_qualified=0|' "$summary" || die 'unknown link qualified'
# CRLF source parsing changes only source lines, never observed output.
source="$work/constants.spl"
printf 'val SERVER_NAME = "simple-lsp-mcp"\r\nval SERVER_VERSION = "0.9.8"\r\n' >"$source"
sed -n '/^constant() {$/,/^}$/p' "$native_sanity_helper" >"$work/constant.shs"
. "$work/constant.shs"
[ "$(constant SERVER_VERSION)" = 0.9.8 ] || die 'CRLF source oracle rejected'
printf 'PASS: new entry wrong-output fails; go-end success preserves failure; unknown never runs; CRLF source oracle parses\n'
