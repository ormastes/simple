#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/preflight-authority-milestone.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
# Exercise the real routing/progress header, injecting a terminal command error.
awk '
  /^run_rust_authority_command\(\) \{/ { copying=1 }
  copying && /^  prepare_rust_authority_workspace$/ {
    print "  return 37"; print "}"; finished=1; exit
  }
  copying { print }
  END { if (!finished) exit 2 }
' "$root/scripts/bootstrap/bootstrap-from-scratch.sh" >"$tmp/header.sh"
. "$tmp/header.sh"
os=linux progress_log=present log_dir=/logs
absolute_path() { printf '%s\n' "$1"; }
bootstrap_progress_mark() { milestone=$1; }
for label in bootstrap-preflight rust-seed-build; do
  if run_rust_authority_command "$label" default unused; then exit 1; else status=$?; fi
  [ "$status" -eq 37 ]
  case "$label" in
    bootstrap-preflight) [ "$milestone" = bootstrap-preflight ] ;;
    rust-seed-build) [ "$milestone" = rust-rust-seed-build ] ;;
  esac
done
echo 'PASS: common authority helper preserves preflight and Cargo error milestones'
