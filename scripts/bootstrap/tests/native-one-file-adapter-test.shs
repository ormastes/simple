#!/bin/sh
set -eu
root=$(CDPATH= cd -P -- "$(dirname "$0")/../../.." && pwd -P)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
owner=test/01_unit/compiler/interpreter/while_body_scope_spec.spl
mkdir -p "$tmp/source/$(dirname "$owner")"
cp "$root/$owner" "$tmp/source/$owner"
perl "$root/scripts/bootstrap/native-one-file-adapter.pl" "$tmp/source" "$tmp/generated" >/dev/null
perl -MDigest::SHA=sha256_hex -MJSON::PP -e '
my ($out) = @ARGV;
my %expected=(positive=>"87d1c51dd80305e1b52c277f5e465a75a0553510221ff081114f65210ced5442",
 negative=>"1809eabd3a74c2a5b238da7bc63e21ea1dcfc6f517e27589b31786225967e903");
for my $v (sort keys %expected) {
 open my $f,"<:raw","$out/$v-entry.spl" or die $!; local $/; my $b=<$f>;
 sha256_hex($b) eq $expected{$v} or die "native-tested entry differs";
}
open my $p,"<","$out/provenance.json" or die $!; local $/; my $proof=decode_json(<$p>);
!$proof->{formal_product_pass} && !$proof->{stdlib_framework_pass} && $proof->{assertions_lowered}==2
 or die "incorrect authority";
' "$tmp/generated"
reject() {
    if perl "$root/scripts/bootstrap/native-one-file-adapter.pl" "$tmp/source" "$1" >"$tmp/rejected.log" 2>&1; then
        echo 'unexpected acceptance' >&2; exit 1
    fi
}
reject "$tmp/generated"
printf '\n' >>"$tmp/source/$owner"
reject "$tmp/changed"
[ ! -e "$tmp/changed" ]
cp "$root/$owner" "$tmp/source/$owner"
perl -pi -e 's/to_equal\(2\)/to_equal(3)/' "$tmp/source/$owner"
reject "$tmp/changed-assertion"
rm "$tmp/source/$owner"
ln -s "$root/$owner" "$tmp/source/$owner"
reject "$tmp/linked-source"
echo 'PASS: native-tested entry hashes, explicit restricted authority, existing evidence, changed bytes/assertion and linked input rejection'
