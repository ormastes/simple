#!/bin/sh
# Actual bounded staging/hash checks; these byte fixtures are not LLVM ABI proof.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/scripts/check/lib/bootstrap-stage3/authority.shs"
. "$root/scripts/check/lib/bootstrap-stage3/command-snapshot.shs"
temp_root=$(CDPATH= cd -- "${TMPDIR:-/tmp}" && pwd -P)
work=$(mktemp -d "$temp_root/simple-llvm-import-test.XXXXXX")
case "$work" in "$temp_root"/simple-llvm-import-test.??????) ;; *) exit 1 ;; esac
trap 'chmod -R u+w "$work"; rm -rf "$work"' EXIT HUP INT TERM
mkdir -p "$work/producer" "$work/good" "$work/bad" "$work/foreign" "$work/disabled"
printf 'test import archive content\n' >"$work/producer/LLVM-C.lib"
digest=$(bootstrap_stage3_hash_file "$work/producer/LLVM-C.lib")
authority=$(printf 'llvm-build-status=enabled\nllvm-link-kind=dynamic-c-api\nllvm-c-import-lib-path=%s\nllvm-c-import-lib-sha256=%s\n' "$work/producer/LLVM-C.lib" "$digest")
bootstrap_stage3_stage_windows_llvm_import "$work/good" x86_64-pc-windows-msvc "$authority"
cmp "$work/producer/LLVM-C.lib" "$work/good/LLVM-C.lib"
[ "$(bootstrap_stage3_manifest_value sha256 "$work/good/LLVM-C.lib.producer.txt")" = "$digest" ]
bootstrap_stage3_stage_windows_llvm_import "$work/good" x86_64-pc-windows-msvc ""
bootstrap_stage3_stage_windows_llvm_import "$work/good" x86_64-pc-windows-msvc "$authority"
if bootstrap_stage3_stage_windows_llvm_import "$work/bad" x86_64-pc-windows-msvc ""; then exit 1; fi
if bootstrap_stage3_stage_windows_llvm_import "$work/foreign" aarch64-pc-windows-msvc "$authority"; then exit 1; fi
if bootstrap_stage3_stage_windows_llvm_import "$work/disabled" x86_64-pc-windows-msvc "$(printf '%s\n' "$authority" | sed 's/llvm-build-status=enabled/llvm-build-status=disabled/')"; then exit 1; fi
if bootstrap_stage3_stage_windows_llvm_import "$work/bad" x86_64-pc-windows-msvc "$authority
llvm-c-import-lib-sha256=$digest"; then exit 1; fi
printf 'changed producer bytes\n' >>"$work/producer/LLVM-C.lib"
if bootstrap_stage3_stage_windows_llvm_import "$work/bad" x86_64-pc-windows-msvc "$authority"; then exit 1; fi
printf 'windows LLVM import staging checks PASS (byte custody only)\n'
