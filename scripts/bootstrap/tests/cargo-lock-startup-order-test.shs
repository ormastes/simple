#!/bin/sh
# Execute production initialization fragments, with no preinitialized os.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT HUP INT TERM
python3 - "$ROOT/scripts/bootstrap/bootstrap-from-scratch.sh" "$tmp/startup.sh" <<'PY'
import sys
source = open(sys.argv[1], encoding="utf-8").read()
early = source[source.index("bootstrap_lock_handle=\n"):source.index('portable_lock_canonical_output "${output_dir}"')]
start = source.index('os="${PLATFORM_OS}"')
end = source.index('echo "Platform: ${PLATFORM}"', start)
platform = source[start:end]
with open(sys.argv[2], "w", encoding="utf-8") as out:
    out.write('set -eu\nrepo_root=$1\nPLATFORM_OS=$2\n. "$3/scripts/bootstrap/bootstrap-authority-wiring.shs"\nunset os\n')
    out.write(early)
    out.write(platform)
    out.write('test "$rust_shared_cache_common_dir" = "$(bootstrap_authority_default_rust_cargo_lock_domain "$repo_root" "$PLATFORM_OS")"\nprintf "%s\\n" "$rust_shared_cache_common_dir"\n')
PY
git init -q "$tmp/repo"
git -C "$tmp/repo" -c user.name=test -c user.email=test@example.invalid commit --allow-empty -qm fixture
git -C "$tmp/repo" worktree add -q --detach "$tmp/linked" HEAD
unset SIMPLE_BOOTSTRAP_RUST_CARGO_CACHE_ROOT
one=$(sh "$tmp/startup.sh" "$tmp/repo" windows "$ROOT")
two=$(sh "$tmp/startup.sh" "$tmp/linked" windows "$ROOT")
test "$one" != "$two"
test "$(sh "$tmp/startup.sh" "$tmp/repo" windows "$ROOT")" = "$one"
test "$(sh "$tmp/startup.sh" "$tmp/repo" linux "$ROOT")" = "$(sh "$tmp/startup.sh" "$tmp/linked" linux "$ROOT")"
echo 'PASS: production startup initializes lock domain after platform under nounset'
