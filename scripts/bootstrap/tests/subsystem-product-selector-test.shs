#!/bin/sh
# Dispatch/blocked-evidence regression only; this does not simulate native PASS.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT HUP INT TERM
source="$scratch/source"
mkdir -p "$source/scripts/bootstrap/lib"
for tool in run-compiler-subsystem-test-products.shs build-compiler-subsystem-test-product.shs \
    verify-compiler-subsystem-test-product.pl verify-product-first-case.pl product-spec-selection.pl run-process-group-timeout.shs; do
    cp "$repo/scripts/bootstrap/$tool" "$source/scripts/bootstrap/$tool"
done
cp "$repo/scripts/bootstrap/lib/managed-task-schedule.shs" "$source/scripts/bootstrap/lib/"
cp "$repo/scripts/bootstrap/lib/BootstrapProductProducer.pm" "$source/scripts/bootstrap/lib/"
cp "$repo/scripts/bootstrap/lib/BootstrapProductSelection.pm" "$source/scripts/bootstrap/lib/"
cp "$repo/scripts/bootstrap/lib/product-tool-authority.shs" "$source/scripts/bootstrap/lib/"
# A fixed discovery fixture: neither compiler is present, so no build,
# enumeration or execution callback is permitted to claim a result.
printf '#!/bin/sh\nprintf "suite\\tpath\\tsha256\\n"\n' >"$source/scripts/bootstrap/compiler-subsystem-test-inventory.shs"
count=0
for backend in llvm cranelift; do
    for suite in compiler interpreter loader; do
        output="$scratch/$backend-$suite"
        code=0
        sh "$source/scripts/bootstrap/run-compiler-subsystem-test-products.shs" \
            --source-root="$source" --output-root="$output" --product="$backend:$suite" \
            >"$scratch/$backend-$suite.log" 2>&1 || code=$?
        [ "$code" = 1 ]
        [ "$(wc -l <"$output/product-status.tsv" | tr -d ' ')" = 3 ]
        for stage in build enumerate run; do
            printf 'phase4_%s_product_%s_%s\tBLOCKED\t1\n' "$backend" "$suite" "$stage"
        done >"$scratch/expected"
        cmp "$scratch/expected" "$output/product-status.tsv"
        grep -qx 'status=INCOMPLETE' "$output/matrix.env"
        [ ! -e "$output/$backend/$suite/result.env" ]
        count=$((count + 1))
    done
done
for option in --product=llvm:unknown --product=other:compiler; do
    code=0
    sh "$source/scripts/bootstrap/run-compiler-subsystem-test-products.shs" "$option" --source-root="$source" \
        >"$scratch/rejected.log" 2>&1 || code=$?
    [ "$code" = 2 ]
    grep -q 'invalid product selector' "$scratch/rejected.log"
    count=$((count + 1))
done
code=0
sh "$source/scripts/bootstrap/run-compiler-subsystem-test-products.shs" --product=llvm:compiler --resume --source-root="$source" \
    >"$scratch/rejected.log" 2>&1 || code=$?
[ "$code" = 2 ]
grep -q 'single-product resume' "$scratch/rejected.log"
count=$((count + 1))
# A subset request retains canonical discovery and exact user ordering even
# when its native producer is unavailable. It cannot mint a success receipt.
one=test/01_unit/compiler/interpreter/one_spec.spl
two=test/01_unit/compiler/interpreter/two_spec.spl
hash=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
cat >"$source/scripts/bootstrap/compiler-subsystem-test-inventory.shs" <<EOF
#!/bin/sh
printf 'subsystem\\tlevel\\tpath\\tsha256\\n'
printf 'interpreter\\t01_unit\\t$one\\t$hash\\n'
printf 'interpreter\\t01_unit\\t$two\\t$hash\\n'
EOF
printf '%s\n' "$two" "$one" >"$scratch/spec-list.txt"
code=0
sh "$source/scripts/bootstrap/run-compiler-subsystem-test-products.shs" \
    --source-root="$source" --output-root="$scratch/subset" --product=llvm:interpreter \
    --producer-phase=phase2 --spec-list="$scratch/spec-list.txt" \
    >"$scratch/subset.log" 2>&1 || code=$?
[ "$code" = 1 ]
cmp "$scratch/spec-list.txt" "$scratch/subset/spec-list.txt"
[ "$(sed -n '2p' "$scratch/subset/source-specs.tsv" | cut -f3)" = "$two" ]
[ "$(sed -n '2p' "$scratch/subset/canonical-source-specs.tsv" | cut -f3)" = "$one" ]
grep -qx 'status=INCOMPLETE' "$scratch/subset/matrix.env"
[ ! -e "$scratch/subset/llvm/interpreter/result.env" ]
printf 'PASS product selector: %s cases; missing producers remain BLOCKED, no native success claimed\n' "$count"
