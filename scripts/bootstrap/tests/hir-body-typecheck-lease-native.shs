#!/usr/bin/env bash
# Serialized native fixture owner. Preflight starts no Simple compiler/fixture.
# Run only after the campaign owner has assigned the memory slot.
set -euo pipefail
harness_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
die() { echo "hir-body-lease-fixture: $*" >&2; exit 96; }
[ "$#" = 5 ] || die 'usage: --preflight|--run CANONICAL_ROOT FIXTURE_ROOT STAGE3_LANE FRESH_EVIDENCE_DIR'
mode=$1
case "$mode" in --preflight|--run) ;; *) die invalid-mode ;; esac
fixture_kind=${SIMPLE_HIR_LEASE_FIXTURE_KIND:-typecheck}
case "$fixture_kind" in
    typecheck)
        fixture_dir=test/fixtures/compiler/hir_body_typecheck_lease
        fixture_files='main.spl provider.spl mismatch.spl'
        fixture_receipt='HIR body typecheck lease: 43 checks passed'
        fixture_checks=43 ;;
    mono)
        fixture_dir=test/fixtures/compiler/hir_mono_archive
        fixture_files='main.spl provider.spl root.spl recursive.spl growing.spl alternate.spl'
        fixture_receipt='HIR mono archive consumer: 54 checks passed'
        fixture_checks=54 ;;
    *) die unsupported-fixture-kind ;;
esac
canonical_root=$(cd "$2" && pwd -P)
fixture_root=$(cd "$3" && pwd -P)
lane=$(cd "$4" && pwd -P)
evidence=$5
case "$evidence" in /*) ;; *) die evidence-must-be-absolute ;; esac
mkdir -p "$(dirname "$evidence")"
mkdir "$evidence" || die evidence-must-be-fresh

export BOOTSTRAP_STAGE3_FACADE_PATH="$canonical_root/scripts/check/lib/bootstrap-stage3-provenance.shs"
export BOOTSTRAP_STAGE3_VERSION_ROOT="$canonical_root"
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
producer="$lane/stage2-admitted/simple.exe"
admission="$lane/stage2-admitted/admission.env"
runtime_authority="$lane/stage2-runtime-authority"
source_snapshot="$lane/source-inputs-before.txt"
runtime_snapshot="$lane/runtime-admitted.txt"
tool_snapshot="$lane/tool-authority-before.txt"
sanity="$lane/stage2-sanity.env"
receiver="$lane/stage2-receiver.env"
receiver_log="$lane/stage2-receiver.log"
# Derive all paths from the selected owned lane, never environment values or
# unchecked receipt path fields. Replay the existing full admission authority.
export SIMPLE_ABI_POLICY=v1
args_sha=$(bootstrap_stage3_manifest_value build_args_sha256 "$admission") || die absent-admission-args
bootstrap_stage3_verify_stage2_admission_receipt \
    "$admission" "$admission" "$producer" "$producer" \
    "$source_snapshot" "$source_snapshot" "$runtime_snapshot" "$runtime_snapshot" \
    "$runtime_authority" "$runtime_authority" "$tool_snapshot" "$tool_snapshot" "$args_sha" \
    "$sanity" "$sanity" "$lane" "$receiver" "$receiver" \
    "$receiver_log" "$receiver_log" "$canonical_root" || die admission-replay-refused
# Require an already published canonical runtime-capsule.env binding. Resolve
# replays exact capsule leaves against admission and current canonical source;
# this harness never publishes a binding into the frozen producer directory.
runtime=$(sh "$canonical_root/scripts/bootstrap/phase2-runtime-binding.shs" \
    resolve "$producer" "$canonical_root" "$evidence/binding-resolution") || die bound-runtime-refused
capsule="$runtime/phase2-runtime-capsule.env"
"$canonical_root/scripts/bootstrap/phase2-runtime-capsule.shs" verify "$runtime" \
    > "$evidence/runtime-capsule-verification.log" 2>&1 || die capsule-refused
producer_sha=$(bootstrap_stage3_hash_file "$producer")
capsule_sha=$(bootstrap_stage3_hash_file "$capsule")
[ "$(bootstrap_stage3_manifest_value compiler_sha256 "$capsule")" = "$producer_sha" ] || die capsule-producer-mismatch
[ "$(bootstrap_stage3_manifest_value artifact_layout "$capsule")" = windows-msvc ] || die unsupported-layout
cp "$admission" "$evidence/input-admission.env"
cp "$lane/stage2-admitted/runtime-capsule.env" "$evidence/input-runtime-binding.env"
cp "$capsule" "$evidence/input-runtime-capsule.env"
admission_sha=$(bootstrap_stage3_hash_file "$admission")
binding_sha=$(bootstrap_stage3_hash_file "$lane/stage2-admitted/runtime-capsule.env")

cd "$fixture_root"
. "$harness_dir/../hir-body-lease-fixture-git-gate.shs"
harness_sha=$(bootstrap_stage3_hash_file "$harness_dir/hir-body-typecheck-lease-native.shs")
git_gate_sha=$(bootstrap_stage3_hash_file "$harness_dir/../hir-body-lease-fixture-git-gate.shs")
fixture_links_receipt=${SIMPLE_HIR_LEASE_FIXTURE_LINKS_RECEIPT:-}
fixture_git_gate() {
    gate_epoch=$1
    allow_aliases=0
    [ -z "$fixture_links_receipt" ] || allow_aliases=1
    hir_body_lease_fixture_git_gate_v1 "$fixture_root" "$evidence/fixture-git-$gate_epoch" "$allow_aliases" || die fixture-source-not-frozen
    if [ "$allow_aliases" = 1 ]; then
        bootstrap_stage3_materialized_git_state "$fixture_root" \
            "$evidence/fixture-materialized-$gate_epoch.env" "$fixture_links_receipt" || die fixture-materialization-refused
    fi
}
fixture_git_gate before
git rev-parse HEAD > "$evidence/source.head"
if [ -n "$fixture_links_receipt" ]; then
    fixture_links_sha=$(bootstrap_stage3_hash_file "$fixture_links_receipt")
    cp "$fixture_links_receipt" "$evidence/input-fixture-materialization.env"
fi
# Canonical snapshot owns src and its normal source/tool roots, excluding
# vendor/target caches. The whitelisted actual fixture files are added below;
# the canonical bootstrap snapshot intentionally does not include these tests.
bootstrap_stage3_source_snapshot "$evidence/source.before.txt" "$fixture_root" || die source-snapshot-refused
fixture_snapshot() {
    for file in $fixture_files; do
        path="$fixture_dir/$file"
        [ -f "$path" ] && [ ! -L "$path" ] || return 1
        printf '%s %s\n' "$(bootstrap_stage3_hash_file "$path")" "$path"
    done
    # Selected variant configuration is committed authority too; the canonical
    # source snapshot's root list does not stand in for this exact config file.
    [ -f config/var.sdn ] && [ ! -L config/var.sdn ] || return 1
    printf '%s config/var.sdn\n' "$(bootstrap_stage3_hash_file config/var.sdn)"
}
fixture_snapshot > "$evidence/fixture.before.txt" || die fixture-snapshot-refused
source_sha=$(bootstrap_stage3_hash_file "$evidence/source.before.txt")
fixture_source_sha=$(bootstrap_stage3_hash_file "$evidence/fixture.before.txt")
closure_sha=$(printf '%s\n' "$source_sha" "$fixture_source_sha" | sha256sum)
closure_sha=${closure_sha%% *}
{
    printf 'schema=hir-body-lease-fixture-input-v1\n'
    printf 'fixture_kind=%s\nfixture_entry=%s/main.spl\n' "$fixture_kind" "$fixture_dir"
    printf 'producer_path=%s\nproducer_sha256=%s\n' "$producer" "$producer_sha"
    printf 'runtime_receipt_path=%s\nruntime_receipt_sha256=%s\n' "$capsule" "$capsule_sha"
    printf 'source_snapshot_sha256=%s\nfixture_snapshot_sha256=%s\nclosure_sha256=%s\n' "$source_sha" "$fixture_source_sha" "$closure_sha"
    printf 'harness_sha256=%s\nfixture_git_gate_sha256=%s\n' "$harness_sha" "$git_gate_sha"
    printf 'target=x86_64-pc-windows-msvc\nbackend=llvm\nrss_cap_kib=5859375\ncompile_timeout_seconds=600\n'
} > "$evidence/input.env"
[ "$mode" = --run ] || { printf 'hir-body-lease-fixture: PREFLIGHT PASS (no Simple compiler/fixture jobs)\n'; exit 0; }

unset SIMPLE_BINARY SIMPLE_BIN SIMPLE_RUNTIME SIMPLE_LIB SIMPLE_NATIVE_BUILD_RUST
unset SIMPLE_BOOTSTRAP_SESSION_ID SIMPLE_BOOTSTRAP_SESSION_EXEC SIMPLE_BOOTSTRAP_SESSION_READY
unset SIMPLE_BOOTSTRAP_CAMPAIGN_TOKEN SIMPLE_BOOTSTRAP_CAMPAIGN_DEADLINE
unset SIMPLE_FRONTEND_CACHE_SCOPE
export SIMPLE_PROJECT_ROOT="$fixture_root" SIMPLE_USER_STORAGE_ROOT="$evidence/user"
export SIMPLE_WORKTREE_STORAGE_ROOT="$evidence/worktree" SIMPLE_SCV_INVENTORY_COLD_INIT=1
export SIMPLE_BOOTSTRAP=0 SIMPLE_BOOTSTRAP_STAGE3=0 SIMPLE_BOOTSTRAP_STAGE4=0
export SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_NO_BOOTSTRAP_DELEGATE=1 SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap
export SIMPLE_RUNTIME_PATH="$runtime" SIMPLE_NATIVE_BUILD_THREADS=1
export SIMPLE_NATIVE_BUILD_TARGET=x86_64-pc-windows-msvc SIMPLE_RUNTIME_RISCV64_VECTOR=0
export SIMPLE_NATIVE_BUILD_CACHE_DIR="$evidence/cache" SIMPLE_RT_OBJ_CACHE_DIR="$evidence/cache/runtime-objects"
export SIMPLE_FRONTEND_CACHE_DIR="$evidence/cache/frontend" SIMPLE_HIR_CACHE_DIR="$evidence/cache/hir"
export SIMPLE_FRONTEND_CACHE=1 SIMPLE_HIR_CACHE=1 SIMPLE_STUB_HIR=0 SIMPLE_FRONTEND_DIAG=1
# The fixture checks the production defaults, including E-MONO-040 warning.
unset SIMPLE_MONO_LEVELS SIMPLE_MONO_DIAG
export SIMPLE_SHARD_MEM_CLAMP=1 SIMPLE_PARSE_SHARD_MAX=1 SIMPLE_PARSE_SHARD_WORKER_KB=1650000
export SIMPLE_HIR_SHARD_WORKER_KB=3000000 SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=3000000
export TMPDIR="$evidence/tmp" TMP="$(cygpath -w "$evidence/tmp")" TEMP="$(cygpath -w "$evidence/tmp")"
mkdir -p "$TMPDIR" "$SIMPLE_USER_STORAGE_ROOT" "$SIMPLE_WORKTREE_STORAGE_ROOT"
. "$canonical_root/scripts/setup/windows-msvc-bootstrap-env.shs"
fixture="$evidence/fixture.exe"
watchdog="$canonical_root/scripts/resource/process-tree-rss-watchdog.pl"
set +e
perl "$watchdog" --session-mode=new --rss-cap-mode=enforce --max-rss-kib=5859375 \
    --timeout-seconds=600 --receipt="$evidence/compile.rss.env" -- \
    "$producer" native-build "$fixture_dir/main.spl" \
    --backend=llvm --low-memory --timeout 600 --threads 1 -o "$fixture" \
    > "$evidence/compile.log" 2>&1
compile_rc=$?
set -e
printf '%s\n' "$compile_rc" > "$evidence/compile.exit.txt"
[ "$compile_rc" = 0 ] || exit "$compile_rc"
[ -s "$fixture" ] || die missing-native-fixture
fixture_git_gate after
cmp -s "$evidence/source.head" "$evidence/fixture-git-after.head" || die fixture-head-mutated
cmp -s "$evidence/fixture-git-before.changed" "$evidence/fixture-git-after.changed" || die fixture-git-delta-mutated
cmp -s "$evidence/fixture-git-before.untracked" "$evidence/fixture-git-after.untracked" || die fixture-untracked-mutated
if [ -n "$fixture_links_receipt" ]; then
    [ "$(bootstrap_stage3_hash_file "$fixture_links_receipt")" = "$fixture_links_sha" ] || die fixture-links-receipt-mutated
    cmp -s "$evidence/fixture-materialized-before.env" "$evidence/fixture-materialized-after.env" || die fixture-materialization-mutated
fi
bootstrap_stage3_source_snapshot "$evidence/source.after.txt" "$fixture_root" || die source-after-refused
fixture_snapshot > "$evidence/fixture.after.txt" || die fixture-after-refused
cmp -s "$evidence/source.before.txt" "$evidence/source.after.txt" || die source-mutated
cmp -s "$evidence/fixture.before.txt" "$evidence/fixture.after.txt" || die fixture-mutated
[ "$(bootstrap_stage3_hash_file "$producer")" = "$producer_sha" ] || die producer-mutated
[ "$(bootstrap_stage3_hash_file "$admission")" = "$admission_sha" ] || die admission-mutated
[ "$(bootstrap_stage3_hash_file "$lane/stage2-admitted/runtime-capsule.env")" = "$binding_sha" ] || die binding-mutated
"$canonical_root/scripts/bootstrap/phase2-runtime-capsule.shs" verify "$runtime" \
    > "$evidence/runtime-capsule-after.log" 2>&1 || die capsule-mutated
[ "$(bootstrap_stage3_hash_file "$capsule")" = "$capsule_sha" ] || die receipt-mutated
[ "$(bootstrap_stage3_hash_file "$harness_dir/hir-body-typecheck-lease-native.shs")" = "$harness_sha" ] || die harness-mutated
[ "$(bootstrap_stage3_hash_file "$harness_dir/../hir-body-lease-fixture-git-gate.shs")" = "$git_gate_sha" ] || die fixture-git-gate-mutated
fixture_sha=$(bootstrap_stage3_hash_file "$fixture")
printf '%s\n' "$fixture_sha" > "$evidence/executable.sha256"
# The executing checker implementation is now this native fixture, built by
# the exact admitted producer above; bind both identities rather than labels.
export SIMPLE_FRONTEND_CACHE_SCOPE="hir-body-lease-v1|frontend-exe=$fixture_sha|producer=$producer_sha|source=$closure_sha|runtime=$capsule_sha"
export SIMPLE_HIR_LEASE_RUNTIME_PROVIDER_RECEIPT="$capsule"
export SIMPLE_HIR_LEASE_RUNTIME_PROVIDER_DIGEST="$capsule_sha"
export SIMPLE_HIR_LEASE_CLOSURE_DIGEST="$closure_sha"
set +e
perl "$watchdog" --session-mode=new --rss-cap-mode=enforce --max-rss-kib=5859375 \
    --timeout-seconds=60 --receipt="$evidence/execution.rss.env" -- "$fixture" \
    > "$evidence/execution.log" 2>&1
execution_rc=$?
set -e
printf '%s\n' "$execution_rc" > "$evidence/execution.exit.txt"
[ "$execution_rc" = 0 ] || exit "$execution_rc"
[ "$(bootstrap_stage3_hash_file "$fixture")" = "$fixture_sha" ] || die fixture-executable-mutated
grep -Fqx "$fixture_receipt" "$evidence/execution.log" || die missing-positive-receipt
printf 'hir-body-lease-fixture: PASS (%s native checks, %s)\n' "$fixture_checks" "$fixture_kind"
