#!/usr/bin/env bash
# This tests Git delta rejection only, never aliases' filesystem authority.
set -euo pipefail
self_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
. "$self_dir/../hir-body-lease-fixture-git-gate.shs"
[ "$#" = 1 ] || exit 2
test_root=$1
case "$test_root" in /*) ;; *) exit 2 ;; esac
mkdir "$test_root"
mkdir "$test_root/repo" "$test_root/results"
cd "$test_root/repo"
git init -q
git config core.symlinks false
git config user.name 'HIR lease gate regression'
git config user.email 'hir-lease-gate@example.invalid'
mkdir src
printf 'actual provider body\n' > src/provider.spl
printf 'provider.spl' > src/alias
git add src/provider.spl
alias_blob=$(printf 'provider.spl' | git hash-object -w --stdin)
git update-index --add --cacheinfo "120000,$alias_blob,src/alias"
git commit -qm 'owned gate fixture'
checks=0
expect_gate() {
    name=$1 expected=$2 aliases=$3
    actual=0
    hir_body_lease_fixture_git_gate_v1 "$PWD" "$test_root/results/$name" "$aliases" || actual=$?
    if [ "$expected" = pass ]; then [ "$actual" = 0 ]; else [ "$actual" != 0 ]; fi
    checks=$((checks + 1))
}
expect_gate clean pass 0
printf 'changed real body\n' > src/provider.spl
expect_gate source-edit refuse 1
git restore -- src/provider.spl
printf 'unadmitted source\n' > src/extra.spl
expect_gate extra-source refuse 1
rm -- src/extra.spl
cp src/provider.spl src/alias
expect_gate materialized-alias-delta pass 1
expect_gate alias-without-authority refuse 0
git add src/alias
expect_gate staged-alias refuse 1
git restore --staged -- src/alias
rm -- src/alias
mkdir src/alias
cp src/provider.spl src/alias/provider.spl
expect_gate alias-descendant-delta pass 1
printf 'unadmitted source\n' > src/extra.spl
expect_gate descendant-does-not-excuse-other-source refuse 1
[ "$checks" = 8 ]
printf 'HIR lease fixture Git gate: 8 checks passed (no materialization authority claimed)\n'
