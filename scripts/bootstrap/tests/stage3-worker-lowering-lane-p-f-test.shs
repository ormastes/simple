#!/bin/sh
# P-F per-file knob transport: Stage 3 worker refuses knob-suffixed lanes it
# does not accept, and the resume args hash equals the worker vector when
# SIMPLE_FILE_WORKERS=1 is passed through as lane suffix "per-file:fw=1".
# Only text slices of the real worker/resume scripts run; nothing is compiled.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
temp_parent=$(CDPATH= cd -- "${TMPDIR:-/tmp}" && pwd -P)
tmp=$(mktemp -d "$temp_parent/simple-stage3-lane-pf.XXXXXX")
case "$tmp" in "$temp_parent"/simple-stage3-lane-pf.*) ;; *) exit 2 ;; esac
trap 'rm -rf -- "$tmp"' EXIT HUP INT TERM
worker_file="$repo/scripts/bootstrap/lib/stage3-native-build-worker.sh"
resume_file="$repo/scripts/bootstrap/resume-stage3-from-admitted.sh"

# slice FILE START END INCLUDE_END: text from START up to END (END "" = EOF).
slice() {
  awk -v s="$2" -v e="$3" -v inc="$4" '
    { buf = buf $0 "\n" }
    END {
      i = index(buf, s); if (i == 0) exit 3
      rest = substr(buf, i)
      if (e == "") { printf "%s", rest; exit 0 }
      j = index(rest, e); if (j == 0) exit 3
      n = j - 1; if (inc == "1") n += length(e)
      printf "%s", substr(rest, 1, n)
    }' "$1"
}
awk -v s='BOOTSTRAP_STAGE3_FACADE_PATH=' '{ buf = buf $0 "\n" } END { i = index(buf, s); if (i == 0) exit 3; printf "%s", substr(buf, 1, i - 1) }' "$worker_file" >"$tmp/prefix"
slice "$worker_file" 'bootstrap_stage3_run_transcribed "$transcript"' '' 0 >"$tmp/recipe"
slice "$resume_file" 'stage3_lowering_lane=per-file' 'stage3_cold_init_env=' 0 >"$tmp/lane"
slice "$resume_file" 'stage3_args=$(bootstrap_stage3_args_sha256' 'src/app/cli/bootstrap_main.spl)' 1 >"$tmp/digest"

{
  cat "$tmp/prefix"
  printf '%s\n' 'bootstrap_stage3_run_transcribed() { shift 6; printf "%s\0" "$@" >"$CONTROL_RECORD"; }'
  printf '%s\n' 'timeout_args=' '[ -z "$timeout_seconds" ] || timeout_args="--timeout $timeout_seconds"'
  cat "$tmp/recipe"
} >"$tmp/worker.sh"

aaaa=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
run_worker() { # lane record [env...]
  lane=$1; rec=$2; shift 2
  rm -f "$rec"
  env -i PATH=/usr/bin:/bin CONTROL_RECORD="$rec" "$@" sh -c "$(cat "$tmp/worker.sh")" lane-test \
    /fixture/transcript "$repo" /fixture/log /fixture/home /fixture/tmp /usr/bin:/bin \
    /fixture/admitted aarch64-apple-darwin llvm 10 600 "/fixture/cache with space" \
    /fixture/runtime /fixture/candidate /fixture/progress /fixture/phase /fixture/memory \
    fixture-id native none 4194304 "" "" "" 4096 v1 /fixture/admission "$aaaa" \
    "" "" 1000 "$lane" enforce --stage3-source-policy-v1 \
    --source /frozen/k1 --source "/frozen/cuda disabled" --source src/compiler \
    --source src/app --source src/lib --entry-closure >"$tmp/out" 2>"$tmp/err"
}

fail=0
for lane in 'per-file:fw=2' 'per-file:mono=1'; do
  rc=0; run_worker "$lane" "$tmp/vec" || rc=$?
  if [ "$rc" -eq 64 ] && grep -q 'invalid lowering lane' "$tmp/err" && [ ! -e "$tmp/vec" ]; then
    echo "PASS: worker refuses lane '$lane' before recording"
  else
    echo "FAIL: lane '$lane' rc=$rc" >&2; cat "$tmp/err" >&2; fail=1
  fi
done

# The resume slice computes the lane and the hashed vector; the worker, given
# that same lane, must record the same vector (minus the "--" separator and
# the admitted binary). The lane is read back from the resume slice, so a new
# lane item cannot be added to one side only.
{
  printf '%s\n' 'set -eu' transcript=/fixture/transcript "root='$repo'" log=/fixture/log \
    home=/fixture/home tmp=/fixture/tmp path=/usr/bin:/bin admitted=/fixture/admitted \
    platform=aarch64-apple-darwin stage2_backend=llvm stage3_threads=10 timeout_seconds=600 \
    "stage3_cache='/fixture/cache with space'" runtime=/fixture/runtime candidate=/fixture/candidate \
    progress=/fixture/progress phase_profile=/fixture/phase memory_snapshot=/fixture/memory \
    evidence_run_id=fixture-id stage3_requested_route=native stage3_fallback_route=none \
    stage3_mc_env= stage3_cold_init_env= stage3_diagnostic_env= stage3_compiler_ceiling_env= \
    resume_abi_policy=v1 stage2_admission=/fixture/admission "stage3_timeout_args='--timeout 600'"
  printf '%s\n' 'set -- --source /frozen/k1 --source "/frozen/cuda disabled" --source src/compiler --source src/app --source src/lib --entry-closure'
  cat "$tmp/lane"
  printf '%s\n' 'printf "%s" "$stage3_lowering_lane" >"$LANE_RECORD"'
  printf '%s\n' 'bootstrap_stage3_args_sha256() { printf "%s\0" "$@" >"$CONTROL_RECORD"; }'
  cat "$tmp/digest"
} >"$tmp/resume.sh"

# vector_case NAME EXPECTED_LANE EXPECTED_ENV_LINE [ENV...]
vector_case() {
  name=$1; want_lane=$2; want_env=$3; shift 3
  rm -f "$tmp/expected" "$tmp/actual" "$tmp/lane.txt"
  rc=0
  env -i PATH=/usr/bin:/bin CONTROL_RECORD="$tmp/expected" LANE_RECORD="$tmp/lane.txt" "$@" \
    sh -c "$(cat "$tmp/resume.sh")" lane-test >"$tmp/out" 2>"$tmp/err" || rc=$?
  got_lane=$(cat "$tmp/lane.txt" 2>/dev/null || true)
  wrc=0; run_worker "$got_lane" "$tmp/actual" || wrc=$?
  if [ "$rc" -ne 0 ] || [ "$wrc" -ne 0 ] || [ ! -e "$tmp/expected" ] || [ ! -e "$tmp/actual" ]; then
    echo "FAIL: $name resume rc=$rc worker rc=$wrc lane='$got_lane'" >&2; cat "$tmp/err" >&2; fail=1; return 0
  fi
  tr '\0' '\n' <"$tmp/expected" >"$tmp/expected.txt"
  tr '\0' '\n' <"$tmp/actual" | awk 'skip > 0 { skip--; next } !done && $0 == "--" { done = 1; skip = 1; next } { print }' >"$tmp/actual.txt"
  if [ "$got_lane" = "$want_lane" ] && cmp -s "$tmp/expected.txt" "$tmp/actual.txt" &&
     grep -q -x "$want_env" "$tmp/actual.txt"; then
    echo "PASS: $name: resume hash vector equals worker vector for $got_lane"
  else
    echo "FAIL: $name lane='$got_lane' (want '$want_lane', env line '$want_env')" >&2
    diff "$tmp/expected.txt" "$tmp/actual.txt" >&2 || true; fail=1
  fi
}

vector_case 'file workers on' 'per-file:fw=1:gte=1:msc=9' 'SIMPLE_FILE_WORKERS=1' SIMPLE_FILE_WORKERS=1
# MIR shard count: one worker must never claim the whole closure. Default 9,
# SIMPLE_BOOTSTRAP_STAGE3_MIR_SHARD_COUNT overrides it, the caller's
# SIMPLE_MIR_SHARD_COUNT wins over both.
vector_case 'default MIR shard count' 'per-file:fw=0:gte=1:msc=9' 'SIMPLE_MIR_SHARD_COUNT=9' SIMPLE_FILE_WORKERS=0
vector_case 'stage knob' 'per-file:fw=0:gte=1:msc=5' 'SIMPLE_MIR_SHARD_COUNT=5' \
  SIMPLE_FILE_WORKERS=0 SIMPLE_BOOTSTRAP_STAGE3_MIR_SHARD_COUNT=5
vector_case 'caller wins' 'per-file:fw=0:gte=0:msc=4' 'SIMPLE_MIR_SHARD_COUNT=4' \
  SIMPLE_FILE_WORKERS=0 SIMPLE_BOOTSTRAP_GO_TO_END=0 SIMPLE_BOOTSTRAP_STAGE3_MIR_SHARD_COUNT=5 SIMPLE_MIR_SHARD_COUNT=4

for lane in 'per-file:msc=0' 'per-file:msc=x' 'per-file:msc=' 'per-file:msc=129' 'per-file:msc=09'; do
  rc=0; run_worker "$lane" "$tmp/vec" || rc=$?
  if [ "$rc" -eq 64 ] && grep -q 'invalid lowering lane' "$tmp/err" && [ ! -e "$tmp/vec" ]; then
    echo "PASS: worker refuses lane '$lane' before recording"
  else
    echo "FAIL: lane '$lane' rc=$rc" >&2; cat "$tmp/err" >&2; fail=1
  fi
done

for bad in 0 x 129 09; do
  rc=0
  env -i PATH=/usr/bin:/bin CONTROL_RECORD="$tmp/expected" LANE_RECORD="$tmp/lane.txt" SIMPLE_FILE_WORKERS=0 \
    SIMPLE_BOOTSTRAP_STAGE3_MIR_SHARD_COUNT="$bad" sh -c "$(cat "$tmp/resume.sh")" lane-test >"$tmp/out" 2>"$tmp/err" || rc=$?
  if [ "$rc" -eq 1 ] && grep -q 'MIR shard count' "$tmp/err"; then
    echo "PASS: resume refuses MIR shard count '$bad'"
  else
    echo "FAIL: resume accepted MIR shard count '$bad' rc=$rc" >&2; cat "$tmp/err" >&2; fail=1
  fi
done
exit "$fail"
