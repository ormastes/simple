#!/bin/sh
# Stage 4c (crypto/compress dynSMF bundles) is opt-in via
# SIMPLE_BOOTSTRAP_STAGE4C_DYNSMF=1. Default must skip with one visible line and
# never exit; opted in, a missing dynsmf_entry.spl must fail closed (exit 1).
# Runs the real Stage 4c block extracted between its markers, with the build
# helpers stubbed, so no bootstrap is started.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
entry="$repo/scripts/bootstrap/bootstrap-from-scratch.sh"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM

sed -n '/^# -- stage4c-dynsmf begin$/,/^# -- stage4c-dynsmf end$/p' "$entry" >"$scratch/block.sh"
[ "$(grep -c 'stage4c-dynsmf \(begin\|end\)' "$scratch/block.sh")" -eq 2 ] || {
    echo "FAIL: Stage 4c block markers not found in $entry" >&2
    exit 1
}

cat >"$scratch/harness.sh" <<'EOF'
set -eu
log_dir=$PWD/logs
full_bin=$PWD/fake-simple
mkdir -p "$log_dir"
absolute_path() { printf '%s\n' "$1"; }
bootstrap_progress_mark() { :; }
run_timeout() { shift; "$@"; }
run_logged() { echo "run_logged $1" >>"$PWD/calls"; shift; "$@"; }
hash_file() { echo deadbeef; }
EOF
cat >"$scratch/fake-simple" <<'EOF'
#!/bin/sh
while [ "$#" -gt 0 ]; do [ "$1" = -o ] && { echo smf >"$2"; exit 0; }; shift; done
exit 3
EOF
chmod +x "$scratch/fake-simple"

fails=0
run_case() { # name env-value -> sets rc, out
    case_dir="$scratch/$1"
    mkdir -p "$case_dir"
    cp "$scratch/fake-simple" "$case_dir/fake-simple"
    rc=0
    if [ "$2" = unset ]; then
        (cd "$case_dir" && env -u SIMPLE_BOOTSTRAP_STAGE4C_DYNSMF \
            sh -c ". ./../harness.sh; . ./../block.sh; echo REACHED-END") \
            >"$case_dir/out" 2>&1 || rc=$?
    else
        (cd "$case_dir" && env SIMPLE_BOOTSTRAP_STAGE4C_DYNSMF="$2" \
            sh -c ". ./../harness.sh; . ./../block.sh; echo REACHED-END") \
            >"$case_dir/out" 2>&1 || rc=$?
    fi
}
check() { # description condition...
    desc=$1; shift
    if "$@"; then echo "ok: $desc"; else echo "FAIL: $desc" >&2; fails=$((fails + 1)); fi
}

no_build() { [ ! -e "$1/calls" ] && [ ! -e "$1/build" ]; }
for v in unset 0; do
    run_case "default-$v" "$v"
    d="$scratch/default-$v"
    check "default ($v): exit 0" [ "$rc" -eq 0 ]
    check "default ($v): skip line printed" grep -q '^Stage 4c: skipped' "$d/out"
    check "default ($v): continues past Stage 4c" grep -q '^REACHED-END$' "$d/out"
    check "default ($v): no build attempted" no_build "$d"
done

run_case optin-missing 1
d="$scratch/optin-missing"
check "opted in, entries missing: exit 1" [ "$rc" -eq 1 ]
check "opted in, entries missing: names the entry" \
    grep -q 'error: Stage 4c dynSMF entry missing: src/lib/common/crypto/dynsmf_entry.spl' "$d/out"
check "opted in, entries missing: does not continue" sh -c "! grep -q REACHED-END '$d/out'"

mkdir -p "$scratch/optin-present/src/lib/common/crypto" "$scratch/optin-present/src/lib/common/compress"
: >"$scratch/optin-present/src/lib/common/crypto/dynsmf_entry.spl"
: >"$scratch/optin-present/src/lib/common/compress/dynsmf_entry.spl"
run_case optin-present 1
d="$scratch/optin-present"
check "opted in, entries present: exit 0" [ "$rc" -eq 0 ]
check "opted in, entries present: crypto digest" grep -q '^dynsmf_artifact_sha256=crypto:deadbeef$' "$d/out"
check "opted in, entries present: compress digest" grep -q '^dynsmf_artifact_sha256=compress:deadbeef$' "$d/out"

if [ "$fails" -ne 0 ]; then
    echo "FAIL — $fails check(s) failed" >&2
    for f in "$scratch"/*/out; do echo "--- $f"; cat "$f"; done >&2
    exit 1
fi
echo "PASS — stage4c dynSMF opt-in checks"
