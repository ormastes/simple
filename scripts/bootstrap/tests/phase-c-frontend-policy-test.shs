#!/bin/sh
# Exercise the Phase2/3 policy's real child environment; no compiler is admitted.
set -eu
source_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$source_root/scripts/check/lib/bootstrap-stage3/command-snapshot.shs"
. "$source_root/scripts/bootstrap/phase-c-backend-commands.shs"
. "$source_root/scripts/bootstrap/lib/tree-rss-policy.shs"
. "$source_root/scripts/bootstrap/lib/product-frontend-policy.shs"
scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT HUP INT TERM
unset SIMPLE_BOOTSTRAP_FRONTEND_MEMORY_BUDGET_KIB SIMPLE_SHARD_MEM_CLAMP \
  SIMPLE_PARSE_SHARD_MAX SIMPLE_PARSE_SHARD_WORKER_KB SIMPLE_HIR_SHARD_WORKER_KB \
  SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB \
  SIMPLE_BOOTSTRAP_TREE_RSS_PER_JOB_MIB SIMPLE_HOST_TREE_RSS_PER_JOB_MIB
# The child's tree budget is the command's resolved cap (this test runs on a
# fanout host): measured parse/HIR reservations travel with it, independently
# from the caller's codegen thread count.
for backend in llvm cranelift; do
  (
    pure_tool_threads=8
    bootstrap_phase_c_apply_frontend_policy >"$scratch/policy"
    if bootstrap_product_frontend_fanout_host; then
      [ "$bootstrap_tree_rss_bound" != floor ]
      expected_budget=$bootstrap_tree_rss_cap_kib
      # The parse warm-up is sized by the compiler's clamp from that budget;
      # no one-frontend pin on a fanout host.
      expected_parse=unset
    else
      expected_budget=3000000
      expected_parse=1
    fi
    if bootstrap_product_frontend_fanout_host; then
      printf '%s\n' 1 "$expected_parse" 8000000 12000000 "$expected_budget" >"$scratch/expected"
    else
      printf '%s\n' 1 "$expected_parse" 1650000 3000000 "$expected_budget" >"$scratch/expected"
    fi
    run_matrix_task() {
      shift 2
      [ "$1" = producer ] && [ "$2" = native-build ] || return 1
      [ "$5" = --low-memory ] && [ "$6" = --threads ] && [ "$7" = 8 ] || return 1
      sh -c 'printf "%s\n" "$SIMPLE_SHARD_MEM_CLAMP" "${SIMPLE_PARSE_SHARD_MAX-unset}" "$SIMPLE_PARSE_SHARD_WORKER_KB" "$SIMPLE_HIR_SHARD_WORKER_KB" "$SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB"'
    }
    bootstrap_phase_c_run_tool_build "$backend" cli producer entry.spl output 8
  ) >"$scratch/child"
  cmp "$scratch/expected" "$scratch/child"
done
# Fanout host: an explicit cap is the budget verbatim; an explicit per-job
# knob is honoured (96 MiB keeps the tree floor; that small tree budget does
# not admit a measured 12000000 KiB HIR worker).
if bootstrap_product_frontend_fanout_host; then
  (
    pure_tool_threads=8
    SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB=40000000
    bootstrap_phase_c_apply_frontend_policy >"$scratch/policy"
    grep -qx 'verification_frontend_policy=SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=40000000' "$scratch/policy"
  )
  (
    pure_tool_threads=8
    SIMPLE_BOOTSTRAP_TREE_RSS_PER_JOB_MIB=96
    bootstrap_phase_c_apply_frontend_policy >"$scratch/policy"
    grep -qx 'verification_frontend_policy=SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=5859375' "$scratch/policy"
  )
fi
(
  pure_tool_threads=8
  SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=2000000
  bootstrap_phase_c_apply_frontend_policy >"$scratch/policy"
  [ "$SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB" = 2000000 ]
)
(
  pure_tool_threads=8
  SIMPLE_PARSE_SHARD_MAX=8
  if bootstrap_phase_c_apply_frontend_policy >"$scratch/rejected" 2>/dev/null; then exit 1; fi
  [ ! -s "$scratch/rejected" ]
)
[ "${SIMPLE_PARSE_SHARD_MAX-unset}" = unset ]
printf '%s\n' 'PASS Phase C frontend policy: both backends, unchanged codegen threads, narrower budget, rejected fanout, isolated environment'
