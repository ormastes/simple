#!/bin/sh
set -eu
script_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/simple-managed-planner-policy.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
policy="$script_root/lib/managed-planner-policy.shs"
: >"$tmp/planner.receipt"
if sh "$policy" '' 1 0 '' >/dev/null 2>&1; then
  echo 'FAIL: empty managed reason admitted' >&2; exit 1
fi
if sh "$policy" self-host-convergence-check 0 0 '' >/dev/null 2>&1; then
  echo 'FAIL: ordinary unplanned managed planner production admitted' >&2; exit 1
fi
if sh "$policy" self-host-convergence-check 0 1 "$tmp/missing" >/dev/null 2>&1; then
  echo 'FAIL: full bootstrap without planner receipt admitted' >&2; exit 1
fi
sh "$policy" self-host-convergence-check 1 0 '' || exit 1
sh "$policy" self-host-convergence-check 0 1 "$tmp/planner.receipt" || exit 1
echo 'PASS: managed planner production limited to Stage 2 trust-root or planned full lane'
