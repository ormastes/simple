#!/bin/sh
# Regression: Stage 3 and managed Stage 4 planner receipts produced in one run
# must not share an admission directory (bootstrap_dual_planner_receipts_share_planner_artifact_2026_10_19).
set -u
root=$(cd "$(dirname "$0")/../../.." && pwd -P)
. "$root/scripts/check/lib/bootstrap-planner-admission-bound.shs"
fail() { echo "FAIL - $1" >&2; exit 1; }
a=$(bootstrap_planner_v2_admission_dir /out scope1 //bootstrap:stage3) || fail "stage3 dir"
b=$(bootstrap_planner_v2_admission_dir /out scope1 //bootstrap:stage4) || fail "stage4 dir"
[ "$a" != "$b" ] || fail "targets share $a"
[ "$a" = "/out/admission/scope1/__bootstrap_stage3" ] || fail "unexpected layout $a"
c=$(bootstrap_planner_v2_admission_dir /out scope1 //bootstrap:stage3)
[ "$a" = "$c" ] || fail "not deterministic (producer/verifier would disagree)"
if bootstrap_planner_v2_admission_dir /out scope1 '' >/dev/null 2>&1; then fail "empty target accepted"; fi
echo "PASS - 5 assertion(s): per-target planner admission dirs distinct, deterministic, empty target refused"
