#!/bin/sh
set -eu
script_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/simple-provisional-hello.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
mkdir -p "$tmp/source/src/runtime" "$tmp/source/test/04_smoke" "$tmp/output"
cat >"$tmp/producer" <<'SH'
#!/bin/sh
: >"$PRODUCER_CALLED"
exit 0
SH
chmod +x "$tmp/producer"
export PRODUCER_CALLED="$tmp/producer.called"
printf 'snapshot\n' >"$tmp/source.snapshot"
printf 'print("windows native hello")\n' >"$tmp/source/test/04_smoke/windows_native_hello.spl"
producer_sha=$(sha256sum "$tmp/producer" | cut -d ' ' -f 1)
snapshot_sha=$(sha256sum "$tmp/source.snapshot" | cut -d ' ' -f 1)
hello_sha=$(sha256sum "$tmp/source/test/04_smoke/windows_native_hello.spl" | cut -d ' ' -f 1)
printf 'changed\n' >"$tmp/source/test/04_smoke/windows_native_hello.spl"
if sh "$script_root/prepare-provisional-hello.shs" \
  --producer="$tmp/producer" --producer-digest="$producer_sha" \
  --source-checkout="$tmp/source" --source-snapshot="$tmp/source.snapshot" \
  --source-snapshot-digest="$snapshot_sha" \
  --hello-source="$tmp/source/test/04_smoke/windows_native_hello.spl" \
  --hello-source-digest="$hello_sha" --output-root="$tmp/output/hello" \
  --target=x86_64-pc-windows-msvc --memory-bytes=1073741824 \
  --reserve-bytes=1073741824 >"$tmp/out" 2>&1; then
  echo 'FAIL: changed hello source admitted' >&2; exit 1
fi
[ ! -e "$PRODUCER_CALLED" ] && [ ! -e "$tmp/output/hello/hello.receipt" ] || {
  echo 'FAIL: producer started or receipt appeared after fixture drift' >&2; exit 1
}
echo 'PASS: changed hello source refuses before compiler spawn or receipt'
