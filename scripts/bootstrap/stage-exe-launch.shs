#!/bin/sh
# Run a Windows stage compiler and, when it dies in the loader, say why.
# usage: stage-exe-launch.shs <stage.exe> [args...]
# The loader fails before any Simple code runs, so the binary itself cannot
# print a diagnostic; this launcher names STATUS_ENTRYPOINT_NOT_FOUND
# (0xC0000139, surfaced as exit 127 or 3221225785) and the DLL-clash cause.
set -u
[ "$#" -ge 1 ] || { echo "usage: $0 <stage.exe> [args...]" >&2; exit 2; }
exe=$1
shift
"$exe" "$@"
rc=$?
case "$rc" in
127|3221225785|-1073741515)
    echo "stage-exe-launch: $exe exited $rc = STATUS_ENTRYPOINT_NOT_FOUND (0xC0000139): a DLL on PATH (typically llvm-mingw libLLVM-23.dll) shadows the one the stage was built against. Put the admitted DLL dir (e.g. C:/msys64/clang64/bin) first on PATH or bundle the DLL closure beside the exe (scripts/bootstrap/tests/stage2-dll-path-independence-test.shs). See doc/08_tracking/bug/stage2_exit127_llvm_mingw_path_dll_clash_2026-10-26.md" >&2
    ;;
esac
exit "$rc"
