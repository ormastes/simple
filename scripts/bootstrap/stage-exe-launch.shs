#!/bin/sh
# Run a Windows stage compiler and, when it dies in the loader, say why.
# usage: stage-exe-launch.shs <stage.exe> [args...]
#        stage-exe-launch.shs --classify <rc> <exe>   (diagnostic only; selftest hook,
#                              needed because a POSIX shell cannot exit with a 32-bit NTSTATUS)
# The loader fails before any Simple code runs, so the binary itself cannot
# print a diagnostic; this launcher names the two loader failures separately:
#   STATUS_DLL_NOT_FOUND        (0xC0000135, 3221225781 / -1073741515): a DLL the
#                               exe imports is missing from the search path.
#   STATUS_ENTRYPOINT_NOT_FOUND (0xC0000139, 3221225785 / -1073741511): a DLL was found
#                               but lacks an imported symbol (DLL clash).
set -u
describe_rc() {
    rc=$1
    exe=$2
    case "$rc" in
    3221225781|-1073741515)
        echo "stage-exe-launch: $exe exited $rc = STATUS_DLL_NOT_FOUND (0xC0000135): a DLL the stage imports is missing from the loader search path. Put the admitted DLL dir (e.g. C:/msys64/clang64/bin) on PATH or bundle the DLL closure beside the exe (scripts/bootstrap/tests/stage2-dll-path-independence-test.shs)." >&2
        ;;
    127)
        echo "stage-exe-launch: $exe returned shell exit 127 (ambiguous): this alone does not identify a Windows loader status. Inspect program output and the native process/timeout receipt before diagnosing a DLL failure." >&2
        ;;
    3221225785|-1073741511)
        echo "stage-exe-launch: $exe exited $rc = STATUS_ENTRYPOINT_NOT_FOUND (0xC0000139): a DLL on PATH (typically llvm-mingw libLLVM-23.dll) shadows the one the stage was built against. Put the admitted DLL dir (e.g. C:/msys64/clang64/bin) first on PATH or bundle the DLL closure beside the exe (scripts/bootstrap/tests/stage2-dll-path-independence-test.shs). See doc/08_tracking/bug/stage2_exit127_llvm_mingw_path_dll_clash_2026-10-26.md" >&2
        ;;
    esac
}
if [ "${1:-}" = "--classify" ]; then
    [ "$#" -ge 3 ] || { echo "usage: $0 --classify <rc> <exe>" >&2; exit 2; }
    describe_rc "$2" "$3"
    exit 0
fi
[ "$#" -ge 1 ] || { echo "usage: $0 <stage.exe> [args...]" >&2; exit 2; }
exe=$1
if [ ! -f "$exe" ]; then
    echo "stage-exe-launch: $exe does not exist (missing stage exe, not a loader failure); exit 127 here is the shell command-not-found, not STATUS_ENTRYPOINT_NOT_FOUND." >&2
    exit 127
fi
shift
"$exe" "$@"
rc=$?
describe_rc "$rc" "$exe"
exit "$rc"
