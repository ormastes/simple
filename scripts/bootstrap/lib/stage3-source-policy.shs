# Source/closure policy transport for admitted Stage 3 recovery. Source this
# only from the checkout protected by the existing source-before guards.
# Output is one argv element per line; no eval, word splitting or discovery.
bootstrap_stage3_source_policy() (
  [ "$#" -gt 0 ] || return 64
  policy_mode=$1
  shift
  case "$policy_mode" in
    stage2) [ "$#" -gt 0 ] && [ "$1" = native-build ] || return 64; shift ;;
    transfer) ;;
    *) return 64 ;;
  esac
  policy_sources=0 policy_closure=0
  policy_newline='
'
  policy_cr=$(printf '\r')
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --source)
        [ "$#" -ge 2 ] || return 64
        case "$2" in ''|-*|*"$policy_newline"*|*"$policy_cr"*) return 64 ;; esac
        printf '%s\n' --source "$2"
        policy_sources=$((policy_sources + 1))
        shift 2 ;;
      --entry-closure)
        [ "$policy_closure" -eq 0 ] || return 64
        policy_closure=1
        printf '%s\n' --entry-closure
        shift ;;
      --target|--backend|--runtime-bundle|--threads|--timeout|--cache-dir|--mode|--entry|--runtime-path|-o)
        [ "$policy_mode" = stage2 ] && [ "$#" -ge 2 ] || return 64
        case "$2" in ''|-*|*"$policy_newline"*|*"$policy_cr"*) return 64 ;; esac
        shift 2 ;;
      --low-memory|--verbose)
        [ "$policy_mode" = stage2 ] || return 64
        shift ;;
      src/app/cli/bootstrap_main.spl)
        [ "$policy_mode" = stage2 ] || return 64
        shift ;;
      *) return 64 ;;
    esac
  done
  # Absence of entry-closure preserves an authenticated all-objects policy.
  # Absence of explicit sources is not a policy: never fall back to discovery.
  [ "$policy_sources" -gt 0 ] || return 64
)
