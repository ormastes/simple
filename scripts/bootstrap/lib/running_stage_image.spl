# Path of the running stage image for the verified-stage trust anchor.
#
# lib/verified_stage_pin.spl hashes /proc/self/exe itself on Linux. On Windows
# the kernel-owned module path (GetModuleFileNameW via windows_image_owner)
# replaces the caller-supplied --stage-binary, so a twin cannot be run by one
# binary while a different, pinned one is hashed. Any query failure yields ""
# and the pin check fails closed. macOS has no image query in the runtime yet:
# it still hashes the caller path (gap recorded in
# doc/08_tracking/bug/tool_code_authority_twin_slower_than_python_2026-11-27.md).
use std.nogc_sync_mut.io.windows_image_owner.{windows_image_path}

pub fn running_stage_image(caller_path: text, os: text) -> text:
    if os == "windows":
        return match windows_image_path():
            case Ok(path): path
            case Err(_): ""
    caller_path
