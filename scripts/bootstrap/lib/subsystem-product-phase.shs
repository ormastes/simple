#!/bin/sh
# Legacy six-product matrices omitted this field and used phase4 task names.
# Phase3 selected tasks are supported elsewhere, but not aggregate matrices.
product_matrix_phase() {
  awk -F= '$1=="producer_phase" {n++; value=substr($0,index($0,"=")+1)}
    END {if(n==0) {print "phase4"; exit} if(n!=1 || (value!="phase2" && value!="phase4"))exit 1; print value}' "$1"
}
