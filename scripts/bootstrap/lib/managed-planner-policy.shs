#!/bin/sh
# Guard explicit Stage 4 planner production before any bootstrap stage starts.
set -eu
[ "$#" -eq 4 ] || exit 64
reason=$1 stop_after_stage2=$2 full_bootstrap=$3 prior_planner=$4
[ -n "$reason" ] &&
  { [ "$stop_after_stage2" = 1 ] ||
    { [ "$full_bootstrap" = 1 ] && [ -n "$prior_planner" ] &&
      [ -f "$prior_planner" ] && [ ! -L "$prior_planner" ]; }; } || {
  echo 'bootstrap-policy-error: managed planner production requires a typed reason and Stage 2 trust-root stop or receipt-authorized full bootstrap' >&2
  exit 64
}
