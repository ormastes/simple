#!/bin/sh
# Source only. Call after an exclusive lease has actually been acquired.
# Arguments: lease, RSS receipt, native_started (0/1), lease_owned (0/1).
executable_batch_release_owned_lease() {
    [ "$4" = 1 ] || return 0
    if [ "$3" = 0 ] || {
        [ -f "$2" ] &&
        grep -qx 'quiescent=1' "$2" &&
        grep -qx 'observer_errors=0' "$2"
    }; then
        rm -f -- "$1"
    fi
}
