#!/bin/sh
# Child launcher for scripts/bootstrap/adaptive-executable-batch.spl.
# The Simple process API has no spawn that both sets the working directory and
# redirects stdout/stderr to files, so the driver starts each child through this
# script: change directory, create the two logs exclusively (an existing log means
# stale output and fails the launch, like Python open(..., 'xb')), then exec.
# Usage: executable-batch-launch.shs CWD STDOUT_LOG STDERR_LOG COMMAND [ARGS...]
# STDOUT_LOG may be "-" (with STDERR_LOG "-") to inherit the parent's streams.
set -eu
if [ "$#" -lt 4 ]; then
    echo "usage: executable-batch-launch.shs CWD STDOUT_LOG STDERR_LOG COMMAND [ARGS...]" >&2
    exit 2
fi
cwd=$1
out=$2
err=$3
shift 3
cd -- "$cwd"
if [ "$out" = "-" ] && [ "$err" = "-" ]; then
    exec "$@"
fi
set -C
exec "$@" >"$out" 2>"$err"
