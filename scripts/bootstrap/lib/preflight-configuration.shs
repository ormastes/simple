#!/bin/sh
# Pure configuration encoding shared by construction and admitted resume.
# Cargo context is recorded only after the canonical preflight has checked it.
bootstrap_preflight_configuration_v1() {
  [ "$#" -eq 5 ] || return 1
  for bootstrap_preflight_component in "$1" "$2" "$3" "$4"; do
    case "$bootstrap_preflight_component" in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac
  done
  case "$2" in llvm|llvm-lib|cranelift) ;; *) return 1 ;; esac
  case "$5" in ''|'--features llvm') ;; *) return 1 ;; esac
  printf '%s' "platform=$1;backend=$2;mode=$3;lane=full-bootstrap;cargo_profile=bootstrap;cargo_target=$4;cargo_features=$5"
}

# The caller must first authenticate the parent transcript's build-args digest.
# No receipt decoding or ambient Cargo options participate in reconstruction.
bootstrap_preflight_configuration_from_parent_v1() {
  [ "$#" -eq 4 ] || return 1
  bootstrap_preflight_parent=$1
  bootstrap_preflight_prefix="platform=$2;backend=$3;mode=$4;lane=full-bootstrap;cargo_profile=bootstrap;cargo_target="
  case "$bootstrap_preflight_parent" in "$bootstrap_preflight_prefix"*) ;; *) return 1 ;; esac
  bootstrap_preflight_cargo=${bootstrap_preflight_parent#"$bootstrap_preflight_prefix"}
  case "$bootstrap_preflight_cargo" in *';cargo_features='*) ;; *) return 1 ;; esac
  bootstrap_preflight_target=${bootstrap_preflight_cargo%%;cargo_features=*}
  bootstrap_preflight_features=${bootstrap_preflight_cargo#"$bootstrap_preflight_target;cargo_features="}
  bootstrap_preflight_rebuilt=$(bootstrap_preflight_configuration_v1 \
    "$2" "$3" "$4" "$bootstrap_preflight_target" "$bootstrap_preflight_features") || return 1
  [ "$bootstrap_preflight_parent" = "$bootstrap_preflight_rebuilt" ] || return 1
  printf '%s' "$bootstrap_preflight_rebuilt"
}
