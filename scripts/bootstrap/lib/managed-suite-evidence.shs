#!/bin/sh
# Check published suite evidence; invoked after the compiled task receipt gate.
set -eu
[ "$#" -eq 2 ] || exit 2
result=$1 directory=$2
[ -f "$result" ] && [ ! -L "$result" ] || exit 2
for kind in stdout stderr invocations; do
  path="$directory/$kind.log"
  [ -f "$path" ] && [ ! -L "$path" ] || exit 2
  expected=$(awk -F= -v key="${kind}_sha256" '$1==key {n++; value=$2} END {if(n!=1)exit 1; print value}' "$result") || exit 2
  [ "${#expected}" -eq 64 ] || exit 2
  case "$expected" in *[!0-9a-f]*) exit 2 ;; esac
  [ "$(sha256sum "$path" | cut -d ' ' -f 1)" = "$expected" ] || exit 2
done
[ -s "$directory/invocations.log" ] || exit 2
