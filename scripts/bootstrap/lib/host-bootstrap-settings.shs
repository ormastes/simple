#!/bin/sh
# Host-config defaults for bootstrap tuning knobs that used to be passed as
# ad-hoc launcher env vars. Precedence per knob: env var (or CLI flag that
# sets it) > host config key (scripts/setup/host-env.shs --get: SIMPLE_HOST_<KEY>
# > user host.sdn > config/host/<hostname>.sdn) > the consumer's built-in
# default. A host without the key is unchanged: nothing is exported.
#
# The Stage 3 child runs under `env -i` with a sandboxed HOME and no hostname,
# so it cannot read host config itself; the SCRIPT layer resolves the key and
# exports the env var, which the entry scripts already forward/hash.
#
#   key                       exported as
#   mem_reserve_free_mib      SIMPLE_BUILD_MEMORY_RESERVE_BYTES (MiB * 1048576)
#   stage3_tree_rss_cap_kib   SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB (Stage 3 only)
#   stage3_threads            SIMPLE_NATIVE_BUILD_THREADS (Stage 3 coordinator route;
#                             skipped when either thread variable is set). Direct
#                             fan-out (SIMPLE_STAGE3_DIRECT_THREADS>1) needs linux/darwin
#                             memory evidence, so it is not a host setting.
#   stage3_file_workers       read in bootstrap-jobs.shs bootstrap_select_stage3_file_workers
#   frontend_cache, mir_sharding, mir_shard_count, mir_shard_worker_kib
#                             Stage 2 matrix / Stage 3 shard knobs (see below)
#
# Measure/update the keys: sh scripts/setup/update-host-config.shs --dry-run

# bootstrap_host_setting KEY ROOT -> effective host-config value, or empty.
bootstrap_host_setting() {
  [ -f "$2/scripts/setup/host-env.shs" ] || return 0
  sh "$2/scripts/setup/host-env.shs" --get "$1" | tail -n 1
}

# bootstrap_host_apply_memory_reserve ROOT
bootstrap_host_apply_memory_reserve() {
  [ -z "${SIMPLE_BUILD_MEMORY_RESERVE_BYTES+x}" ] || return 0
  bhs_v=$(bootstrap_host_setting mem_reserve_free_mib "$1")
  case "$bhs_v" in ''|0*|*[!0-9]*|??????????*) return 0 ;; esac
  SIMPLE_BUILD_MEMORY_RESERVE_BYTES=$((bhs_v * 1048576))
  export SIMPLE_BUILD_MEMORY_RESERVE_BYTES
  echo "Build memory reserve: $SIMPLE_BUILD_MEMORY_RESERVE_BYTES bytes (source: host config mem_reserve_free_mib=$bhs_v)" >&2
}

# bootstrap_host_apply_stage3_settings ROOT
bootstrap_host_apply_stage3_settings() {
  if [ -z "${SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB:-}" ]; then
    bhs_v=$(bootstrap_host_setting stage3_tree_rss_cap_kib "$1")
    case "$bhs_v" in ''|0*|*[!0-9]*) ;; *)
      SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB=$bhs_v
      export SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB
      echo "Stage 3 tree RSS cap: $bhs_v KiB (source: host config stage3_tree_rss_cap_kib)" ;;
    esac
  fi
  if [ -z "${SIMPLE_STAGE3_DIRECT_THREADS:-}" ] && [ -z "${SIMPLE_NATIVE_BUILD_THREADS:-}" ]; then
    bhs_v=$(bootstrap_host_setting stage3_threads "$1")
    if [ -n "$bhs_v" ]; then
      SIMPLE_NATIVE_BUILD_THREADS=$bhs_v
      export SIMPLE_NATIVE_BUILD_THREADS
      echo "Stage 3 threads: $bhs_v (source: host config stage3_threads)"
    fi
  fi
}

# Stage 2 verification matrix / Stage 3 shard-worker knobs (W27/W32/W36,
# doc/08_tracking/bug/host_config_matrix_shard_knobs_unreachable_2026-11-23.md).
# Each applies only when its env var is unset (explicit env always wins). An
# INVALID host value is a hard error naming the key, never a silent
# fall-through: host-env.shs --get warns and falls through to a lower layer,
# so its warning is read here (same rule as tree-rss-policy.shs
# bootstrap_tree_rss_knob).
#
#   key                   env var                       values
#   frontend_cache        SIMPLE_FRONTEND_CACHE         on|off -> 1|0
#   mir_sharding          SIMPLE_MIR_SHARDING           0|1
#   mir_shard_count       SIMPLE_MIR_SHARD_COUNT        1..128
#   mir_shard_worker_kib  SIMPLE_MIR_SHARD_WORKER_KB    positive integer KiB
#
# frontend_cache resolves into bootstrap_caller_frontend_cache (NOT exported):
# bootstrap-from-scratch.sh's Stage 2 cache setup exports
# SIMPLE_FRONTEND_CACHE=1, so each lane re-applies the caller/host value.

# bootstrap_host_strict_setting KEY ROOT -> sets bhs_value (may be empty);
# returns 1, naming KEY, when a host-config layer holds an invalid value.
bootstrap_host_strict_setting() {
  bhs_value=
  [ -f "$2/scripts/setup/host-env.shs" ] || return 0
  bhs_err=$(mktemp "${TMPDIR:-/tmp}/host-setting-err.XXXXXX") || {
    echo "error: host config: cannot create a temp file to read key $1" >&2
    return 1
  }
  bhs_value=$(sh "$2/scripts/setup/host-env.shs" --get "$1" 2>"$bhs_err" | tail -n 1)
  bhs_warn=$(grep "^host-config: warning: ignoring invalid $1=" "$bhs_err" | head -n 1) || bhs_warn=
  rm -f "$bhs_err"
  if [ -n "$bhs_warn" ]; then
    echo "error: host config key $1 is invalid (${bhs_warn#host-config: warning: ignoring invalid })" >&2
    return 1
  fi
  return 0
}

# bootstrap_host_valid_matrix_value KEY VALUE -> 0 when acceptable. Bounds are
# the consumers': SHARDING 0|1 (bootstrap-from-scratch.sh Stage 3 launch,
# resume-stage3-from-admitted.sh), SHARD_COUNT 1..128 (resume-stage3).
bootstrap_host_valid_matrix_value() {
  case "$1" in
    frontend_cache) case "$2" in on|off) return 0 ;; esac ;;
    mir_sharding) case "$2" in 0|1) return 0 ;; esac ;;
    mir_shard_count)
      case "$2" in ''|*[!0-9]*|0*|????*) return 1 ;; esac
      [ "$2" -le 128 ] && return 0 ;;
    mir_shard_worker_kib)
      case "$2" in ''|*[!0-9]*|0*|???????????*) return 1 ;; esac
      return 0 ;;
  esac
  return 1
}

# bootstrap_host_matrix_value KEY ROOT -> bhs_value, validated (hard error).
bootstrap_host_matrix_value() {
  bootstrap_host_strict_setting "$1" "$2" || return 1
  [ -z "$bhs_value" ] || bootstrap_host_valid_matrix_value "$1" "$bhs_value" || {
    echo "error: host config key $1 is invalid ($1=$bhs_value)" >&2
    return 1
  }
}

# bootstrap_host_apply_frontend_cache_default ROOT -> when SIMPLE_FRONTEND_CACHE
# is unset, sets bootstrap_caller_frontend_cache to 0|1 from frontend_cache.
bootstrap_host_apply_frontend_cache_default() {
  [ -z "${SIMPLE_FRONTEND_CACHE+x}" ] || return 0
  bootstrap_host_matrix_value frontend_cache "$1" || return 1
  case "$bhs_value" in
    on) bootstrap_caller_frontend_cache=1 ;;
    off) bootstrap_caller_frontend_cache=0 ;;
    *) return 0 ;;
  esac
  echo "Frontend cache: SIMPLE_FRONTEND_CACHE=$bootstrap_caller_frontend_cache for the Stage 2 matrix and Stage 3 (source: host config frontend_cache=$bhs_value)" >&2
}

# bootstrap_host_apply_matrix_settings ROOT -> exports SIMPLE_MIR_SHARDING,
# SIMPLE_MIR_SHARD_COUNT and SIMPLE_MIR_SHARD_WORKER_KB from host config, each
# only when unset or empty.
bootstrap_host_apply_matrix_settings() {
  for bhs_pair in mir_sharding:SIMPLE_MIR_SHARDING mir_shard_count:SIMPLE_MIR_SHARD_COUNT \
      mir_shard_worker_kib:SIMPLE_MIR_SHARD_WORKER_KB; do
    bhs_key=${bhs_pair%%:*} bhs_var=${bhs_pair#*:}
    eval "bhs_cur=\${$bhs_var:-}"
    [ -z "$bhs_cur" ] || continue
    bootstrap_host_matrix_value "$bhs_key" "$1" || return 1
    [ -n "$bhs_value" ] || continue
    eval "$bhs_var=\$bhs_value"
    export "$bhs_var"
    echo "$bhs_var=$bhs_value (source: host config $bhs_key)" >&2
  done
  return 0
}
