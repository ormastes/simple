# Shared bounded-execution helper for the bootstrap entry points.
# `run_timeout SECONDS CMD...` runs CMD with a wall-clock bound and returns its
# status (124 on expiry). On MSYS/MinGW/Cygwin a capture+watchdog stands in for
# coreutils timeout, which cannot signal native Windows children reliably.
#
# Sourced by bootstrap-from-scratch.sh AND resume-stage3-from-admitted.sh: the
# resume runs as its own process, so a definition that lived only in
# bootstrap-from-scratch.sh left the resume's Stage 3 sanity probes failing
# with `run_timeout: command not found` (status 127). See
# doc/08_tracking/bug/resume_stage3_run_timeout_and_sanity_memory_reserve_2026-11-23.md.
run_timeout() {
  timeout_seconds=$1
  shift
  case "$(uname -s 2>/dev/null || echo unknown)" in
    MSYS*|MINGW*|CYGWIN*)
      timeout_capture=$(mktemp "${TMPDIR:-/tmp}/simple-timeout.XXXXXX") || return 1
      timeout_marker="${timeout_capture}.expired"
      "$@" >"${timeout_capture}" 2>&1 &
      timeout_pid=$!
      (
        sleep "${timeout_seconds}"
        if kill -0 "${timeout_pid}" 2>/dev/null; then
          : >"${timeout_marker}"
          kill "${timeout_pid}" 2>/dev/null || true
          sleep 1
          kill -9 "${timeout_pid}" 2>/dev/null || true
        fi
      ) &
      timeout_watchdog=$!
      timeout_status=0
      wait "${timeout_pid}" || timeout_status=$?
      kill "${timeout_watchdog}" 2>/dev/null || true
      wait "${timeout_watchdog}" 2>/dev/null || true
      cat "${timeout_capture}"
      if [ -f "${timeout_marker}" ]; then
        timeout_status=124
      fi
      rm -f "${timeout_capture}" "${timeout_marker}"
      return "${timeout_status}"
      ;;
  esac
  if command -v timeout >/dev/null 2>&1; then
    timeout "${timeout_seconds}" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "${timeout_seconds}" "$@"
  else
    "$@"
  fi
}
