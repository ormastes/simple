#!/bin/sh
# A read-only compiled authority gate. Hashes alone never prove phase reap.
set -eu
[ "$#" -eq 4 ] || exit 2
root=$1 builder=$2 poll=$3 lifetime=$4
regular() { [ -f "$1" ] && [ ! -L "$1" ]; }
sha() { sha256sum "$1" | cut -d ' ' -f 1; }
for n in "$poll" "$lifetime"; do case "$n" in ''|0|0*|*[!0-9]*) exit 2 ;; esac; done
manifest3="$root/parallel/manifests/phase3.sdn"
manifest4="$root/parallel/manifests/phase4.sdn"
policy="$root/phase-policy.sdn"
result3="$root/parallel/owner/phase3/result.sdn"
result4="$root/parallel/owner/phase4/result.sdn"
for path in "$builder" "$manifest3" "$manifest4" "$policy" "$result3" "$result4"; do regular "$path" || exit 2; done
digest3=$(sha "$manifest3") digest4=$(sha "$manifest4") policy_digest=$(sha "$policy")
result_digest3=$(sha "$result3") result_digest4=$(sha "$result4")
"$builder" managed-phases-verify \
  --phase3-manifest "$manifest3" --phase3-sha256 "$digest3" \
  --phase4-manifest "$manifest4" --phase4-sha256 "$digest4" \
  --policy "$policy" --policy-sha256 "$policy_digest" \
  --source-root "$root/driver-inputs" --state "$root/parallel/owner" \
  --poll-ms "$poll" --lifetime-ms "$lifetime" >/dev/null || exit 2
[ "$(sha "$manifest3")" = "$digest3" ] && [ "$(sha "$manifest4")" = "$digest4" ] &&
  [ "$(sha "$policy")" = "$policy_digest" ] && [ "$(sha "$result3")" = "$result_digest3" ] &&
  [ "$(sha "$result4")" = "$result_digest4" ] || exit 2
printf '%s\n' "phase_admission_policy_sha256=$policy_digest" \
  "phase3_phase_manifest_sha256=$digest3" "phase4_phase_manifest_sha256=$digest4" \
  "phase3_phase_result_sha256=$result_digest3" "phase4_phase_result_sha256=$result_digest4"
