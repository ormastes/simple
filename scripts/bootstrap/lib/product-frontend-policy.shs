# Frontend fanout hosts: every host except Windows, whose transcribed owner
# (command-snapshot.shs) pins one frontend by design. On a fanout host the
# product share is the enforced process-tree cap itself: the compiler's clamp
# (src/app/cli/shard_mem_clamp.spl) reserves 8000000 KiB per parse shard and
# 12000000 KiB per HIR shard from measured large-closure worker peaks.
# The clamp retains 40% of the tree budget for the parent and tools.
# tree-rss-policy.shs prices each declared job at the HIR reservation / 60%;
# the enforced 48 GiB ceiling therefore admits at most two HIR workers.
#
# This is what process-tree-rss-watchdog.pl exports to the tree and what the
# Linux transcribed lane already does (run_shard_budget = rss_cap).
# No independent worker-count pin: measured worker reservation and enforced
# tree budget are the same values consumed by the CLI admission clamp. No
# host-memory query here: the cap already carries the host-fraction bound.
bootstrap_product_frontend_fanout_host() {
    case "$(uname -s 2>/dev/null || echo unknown)" in
        MSYS*|MINGW*|CYGWIN*) return 1 ;;
        *) return 0 ;;
    esac
}

# Uses the canonical Windows frontend owner. Windows keeps the one-worker share;
# fanout hosts admit up to the cap. Codegen parallelism remains independent.
bootstrap_product_frontend_policy() {
    product_policy_mode=$1 product_policy_cap=$2 product_policy_rss_mode=$3
    # Optional 4th argument: the job-scaled hard ceiling the caller resolved
    # through tree-rss-policy.shs (same contract as
    # bootstrap_stage3_windows_frontend_environment's 4th parameter). Absent,
    # the static tree ceiling holds -- which refuses every cap above 8 GiB,
    # breaking elevated-admission tool builds (frontend policy failure, exit
    # 88 in ~1s with no row log).
    product_policy_ceiling=${4:-8388608}
    # Fanout host: the default share is the cap; an explicit share is admitted
    # up to the resolved ceiling and, as before, clamped to the cap when the
    # cap is enforced. Windows keeps the one-worker share and bound.
    if bootstrap_product_frontend_fanout_host; then
        product_policy_default=$product_policy_cap
        product_policy_max=$product_policy_ceiling
        product_parse_worker_kb=8000000
        product_hir_worker_kb=12000000
    else
        product_policy_default=3000000
        product_policy_max=3000000
        # Windows remains on its independently qualified one-frontend policy.
        product_parse_worker_kb=1650000
        product_hir_worker_kb=3000000
    fi
    product_policy_share=${SIMPLE_BOOTSTRAP_FRONTEND_MEMORY_BUDGET_KIB:-}
    if [ "$product_policy_mode" = diagnostic ]; then
        [ -n "$product_policy_share" ] || {
            echo 'product frontend requires an explicit admitted lane share' >&2
            return 1
        }
    else
        product_policy_share=${product_policy_share:-$product_policy_default}
    fi
    product_policy_rows=$(bootstrap_stage3_windows_frontend_environment \
        "$product_policy_cap" "$product_policy_rss_mode" "$product_policy_share" \
        "$product_policy_ceiling" "$product_policy_max") || return 1
    # The Windows owner pins SIMPLE_PARSE_SHARD_MAX=1 by design (one frontend).
    # On a fanout host that pin serialized the parse cache warm-up to one cold
    # parse of the whole closure (~104 ms/file: 137 s at 1315 modules, ~4.7 min
    # at the 2702-module Stage 2 closure) while the HIR shards fanned out. The
    # compiler's clamp already sizes parse shards from the exported tree budget
    # (60% / 8000000 KiB per measured shard, bounded by --threads), so the row is dropped
    # here; the contradiction check below still refuses an inherited explicit
    # fanout request. Bug parse_shard_warmup_pinned_to_one_worker_2026-10-19.
    if bootstrap_product_frontend_fanout_host; then
        product_policy_rows=$(printf '%s\n' "$product_policy_rows" |
            sed '/^SIMPLE_PARSE_SHARD_MAX=1$/d' |
            sed 's/^SIMPLE_PARSE_SHARD_WORKER_KB=.*/SIMPLE_PARSE_SHARD_WORKER_KB=8000000/' |
            sed 's/^SIMPLE_HIR_SHARD_WORKER_KB=.*/SIMPLE_HIR_SHARD_WORKER_KB=12000000/') || return 1
    fi
    # Reject inherited contradictory scheduling requests rather than quietly
    # masking them. No eval, host-memory query, or unchecked fanout override.
    [ "${SIMPLE_SHARD_MEM_CLAMP:-1}" = 1 ] &&
        [ "${SIMPLE_PARSE_SHARD_MAX:-1}" = 1 ] &&
        [ "${SIMPLE_PARSE_SHARD_WORKER_KB:-$product_parse_worker_kb}" = "$product_parse_worker_kb" ] &&
        [ "${SIMPLE_HIR_SHARD_WORKER_KB:-$product_hir_worker_kb}" = "$product_hir_worker_kb" ] || return 1
    product_policy_effective=$(printf '%s\n' "$product_policy_rows" |
        sed -n 's/^SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=//p') || return 1
    [ -n "$product_policy_effective" ] || return 1
    # An enclosing enforced owner (process-tree-rss-watchdog.pl exports its
    # cap) may already declare a tree budget. A larger one is consistent:
    # this lane's share stays the binding bound. A smaller one is stricter
    # and wins. Zero, junk or overlong values remain contradictions.
    product_policy_inherited=${SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB:-$product_policy_effective}
    case "$product_policy_inherited" in
        ''|0*|*[!0-9]*|??????????????????*) return 1 ;;
    esac
    if [ "$product_policy_inherited" -lt "$product_policy_effective" ]; then
        product_policy_rows=$(printf '%s\n' "$product_policy_rows" |
            sed "s/^SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=.*/SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=$product_policy_inherited/") ||
            return 1
    fi
    printf '%s\n' "$product_policy_rows"
}
