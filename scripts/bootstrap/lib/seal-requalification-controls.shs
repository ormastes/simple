#!/bin/sh
# Seal source/Git authority; open only canonical generated-state leaves.
set -eu
[ "$#" = 1 ] || exit 64
fixture=$1
[ -d "$fixture" ] && [ ! -L "$fixture" ] || exit 1
for path in build build/scv .simple .simple/workarounds.d; do
    [ ! -L "$fixture/$path" ] || exit 1
    if [ -e "$fixture/$path" ]; then [ -d "$fixture/$path" ] || exit 1; fi
done
for path in build/scv .simple/workarounds.d; do
    # Writable directories permit unlinking even readonly children. Never put
    # committed files in either generated-state authority.
    tracked=$(git -C "$fixture" --no-optional-locks ls-files -- "$path")
    [ -z "$tracked" ] || { echo "tracked generated-state path: $path" >&2; exit 1; }
    mkdir -p "$fixture/$path"
done
chmod -R a-w "$fixture"
chmod u+w "$fixture/build/scv" "$fixture/.simple/workarounds.d"
