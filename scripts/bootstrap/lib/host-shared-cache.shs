#!/bin/sh
# Configure the immutable compiler CAS once per host user and project.
# Mutable native caches remain lane-private; this helper never migrates,
# removes, or rewrites an existing cache.

simple_host_cache_configure() {
  [ -z "${SIMPLE_CACHE:-}" ] || return 0
  if [ -n "${SIMPLE_USER_STORAGE_ROOT:-}" ]; then
    SIMPLE_CACHE="${SIMPLE_USER_STORAGE_ROOT}/cache/compiler/bootstrap/v1/cas"
    SIMPLE_CACHE_PROJECT=${SIMPLE_CACHE_PROJECT:-simple}
    export SIMPLE_CACHE SIMPLE_CACHE_PROJECT
    return 0
  fi
  shc_project=${SIMPLE_CACHE_PROJECT:-simple}
  shc_payload=$(printf 'simple-cache-project-v1\n%s' "${shc_project}")
  if command -v shasum >/dev/null 2>&1; then
    shc_namespace=$(printf '%s' "${shc_payload}" | shasum -a 256 | awk '{print $1}')
  elif command -v sha256sum >/dev/null 2>&1; then
    shc_namespace=$(printf '%s' "${shc_payload}" | sha256sum | awk '{print $1}')
  else
    echo "error: host-shared cache requires SHA-256 tooling" >&2
    return 1
  fi
  # Base precedence: SIMPLE_HOST_CACHE_ROOT > host config cache_root (queried
  # via `host-env.shs --get` in a child shell, so nothing new is exported into
  # the bootstrap env fingerprint) > XDG/HOME. Only the CAS base moves; the
  # content-addressed project namespace below is unchanged.
  shc_base=${SIMPLE_HOST_CACHE_ROOT:-}
  if [ -z "${shc_base}" ]; then
    shc_hc_script=${BOOTSTRAP_HOST_ENV_SCRIPT:-${bootstrap_entry_dir:+${bootstrap_entry_dir}/../setup/host-env.shs}}
    if [ -n "${shc_hc_script}" ] && [ -f "${shc_hc_script}" ]; then
      shc_base=$(sh "${shc_hc_script}" --get cache_root 2>/dev/null) || shc_base=""
    fi
  fi
  shc_base=${shc_base:-${XDG_CACHE_HOME:-${HOME:?HOME required}/.cache}/simple}
  SIMPLE_CACHE="${shc_base}/v1/projects/${shc_namespace}"
  SIMPLE_CACHE_PROJECT=${shc_project}
  export SIMPLE_CACHE SIMPLE_CACHE_PROJECT
}
