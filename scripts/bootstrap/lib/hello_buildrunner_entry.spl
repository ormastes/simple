# Single entry point from the phase-3 Hello matrix twin into the BuildRunner
# twin (hello-sanity-buildrunner.py run_lane). The BuildRunner/worker twins are
# owned by a parallel lane and have not landed; until they do this entry fails
# closed: every requested lane is a FAIL row, never UNRUN or PASS, so a phase-3
# matrix that asked for BuildRunner evidence cannot report PASS without it.
# TODO(hello-buildrunner-twin): route to the BuildRunner twin's run_lane once it lands.
use scripts.bootstrap.lib.hello_matrix_policy.{SdnField, sdn_s}

pub fn hello_buildrunner_run_lane(backend: text, lane: text, manager: text, manifest_writer: text, template: text, target: text) -> [SdnField]:
    [sdn_s("status", "FAIL"), sdn_s("reason", "buildrunner twin not landed")]
