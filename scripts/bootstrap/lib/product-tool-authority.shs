# Source this only after source_root and script_root are set. Separate tool
# authority is explicit and inherited unchanged by synchronous child tools.
case "$source_root" in /*|[A-Za-z]:/*) ;; *) exit 2 ;; esac
[ -d "$source_root" ] && [ ! -L "$source_root" ] || exit 2
source_root=$(CDPATH= cd -P -- "$source_root" && pwd -P) || exit 2
tool_root=${SIMPLE_BOOTSTRAP_TOOL_ROOT:-$source_root}
[ -d "$tool_root" ] && [ ! -L "$tool_root" ] || exit 2
tool_root=$(CDPATH= cd -P -- "$tool_root" && pwd -P) || exit 2
[ "$script_root" = "$tool_root/scripts/bootstrap" ] || {
  echo 'bootstrap tool entry outside declared tool root' >&2; exit 2;
}
bootstrap_product_tool_verify() {
  [ "$tool_root" != "$source_root" ] || return 0
  [ -n "${SIMPLE_BOOTSTRAP_TOOL_MANIFEST:-}" ] &&
    [ -n "${SIMPLE_BOOTSTRAP_TOOL_MANIFEST_SHA256:-}" ] &&
    [ -n "${SIMPLE_BOOTSTRAP_TOOL_PYTHON:-}" ] || return 2
  "$SIMPLE_BOOTSTRAP_TOOL_PYTHON" -B "$script_root/tool-code-authority.py" \
    --root "$tool_root" --manifest "$SIMPLE_BOOTSTRAP_TOOL_MANIFEST" \
    --sha256 "$SIMPLE_BOOTSTRAP_TOOL_MANIFEST_SHA256" --entry "$script_root/$(basename -- "$0")"
}
bootstrap_product_tool_verify || { echo 'bootstrap tool authority rejected' >&2; exit 2; }
