#!/bin/sh
# bootstrap-pin-archive.shs -- materialise a PINNED snapshot of a source commit so
# bootstrap-from-scratch.sh builds committed content, never the live shared
# working copy (owner decision 2026-11-09, item 15).
# Bug: doc/08_tracking/bug/bootstrap_reads_transiently_broken_shared_working_copy_2026-09-05.md
#
# The snapshot must be a git repository: SCV source admission lists the
# inventory with `git ls-files` and refuses a root without `.git`
# (`source-inventory-root-not-git`, source_authority.spl), which made every
# Stage 2 sanity fail on the bare `git archive` form (2026-11-12). Two forms:
#   - Unix: a shared-object clone checked out at the pinned sha. Own index and
#     working tree (live edits stay invisible), `git rev-parse HEAD` is the real
#     pinned sha (provenance captures keep their meaning), objects borrowed via
#     `.git/objects/info/alternates` -- nothing is copied. Consequence: the
#     snapshot stays valid only while the sha is reachable in the source repo
#     (or within gc.pruneExpire); do not delete a `work/*` branch whose sha a
#     running managed phase was pinned from until that run is terminal.
#   - core.symlinks=false (Windows): a detached `git worktree` of the exact
#     commit (`git archive | tar` cannot create the tracked symlinks and the
#     Windows materializer needs a real git toplevel), with the recorded
#     .spipe/spipe gitlink populated the way bootstrap-windows.sh does.
#
# Usage:
#   bootstrap-pin-archive.shs <repo> <rev> <dest-parent>   # prints snapshot dir on stdout
#   bootstrap-pin-archive.shs --selftest
# Snapshot dir = <dest-parent>/pinned-<sha12>; holds .bootstrap-pinned-sha.
# Exit 2 = nothing built (bad rev / empty checkout / clone or worktree failure).
set -u
pin_archive() {
    pa_repo=$1; pa_rev=$2; pa_parent=$3
    pa_sha=$(git -C "$pa_repo" rev-parse --verify "${pa_rev}^{commit}" 2>/dev/null) || {
        echo "ERROR — nothing was checked (cannot resolve rev '${pa_rev}')" >&2; return 2; }
    pa_dir="${pa_parent}/pinned-$(echo "$pa_sha" | cut -c1-12)"
    # Reuse an intact snapshot of the same sha: a bootstrap output tree lives
    # INSIDE the snapshot (<snapshot>/build/<lane>), so re-materialising it on a
    # resume would delete the admitted Stage 2 the resume is about to consume.
    if [ "$(cat "$pa_dir/.bootstrap-pinned-sha" 2>/dev/null)" = "$pa_sha" ] &&
       [ "$(git -C "$pa_dir" rev-parse HEAD 2>/dev/null)" = "$pa_sha" ]; then
        touch "$pa_dir/.bootstrap-pinned-sha" 2>/dev/null   # age = last use (bootstrap-pin-prune.shs `young`)
        echo "pinned-archive: ${pa_sha} reused (intact snapshot) -> ${pa_dir}" >&2
        printf '%s\n' "$pa_dir"
        return 0
    fi
    rm -rf "$pa_dir.tmp"; mkdir -p "$pa_parent" || return 2
    if [ "$(git -C "$pa_repo" config --get core.symlinks 2>/dev/null)" = false ]; then
        # core.symlinks=false (Windows): `git archive | tar` cannot create the
        # tracked symlinks, and the Windows materializer that turns them into
        # junctions/hardlinks (scripts/setup/materialize-symlinks-windows.shs)
        # needs a real git toplevel. Pin a detached worktree of the exact commit
        # instead: still isolated from live edits, and a git repo for the
        # materializer. The recorded .spipe/spipe gitlink is populated the same
        # way bootstrap-windows.sh does for the live tree.
        rm -rf "$pa_dir"; git -C "$pa_repo" worktree prune
        GIT_LFS_SKIP_SMUDGE=1 git -C "$pa_repo" worktree add --detach "$pa_dir" "$pa_sha" >/dev/null 2>&1 || {
            rm -rf "$pa_dir"; git -C "$pa_repo" worktree prune
            echo "ERROR — git worktree add failed for ${pa_sha}" >&2; return 2; }
        case "$(git -C "$pa_repo" ls-files -s -- .spipe/spipe 2>/dev/null)" in
            160000*) git -C "$pa_dir" submodule update --init -- .spipe/spipe >/dev/null 2>&1 || {
                echo "ERROR — cannot initialize .spipe/spipe gitlink in pinned worktree" >&2; return 2; } ;;
        esac
        pa_n=$(find "$pa_dir" -type f -not -path "$pa_dir/.git/*" | wc -l)
        [ "$pa_n" -gt 0 ] || { echo "ERROR — empty worktree for ${pa_sha}" >&2; return 2; }
        printf '%s\n' "$pa_sha" > "$pa_dir/.bootstrap-pinned-sha"
        echo "pinned-archive: ${pa_sha} (${pa_n} files, detached worktree) -> ${pa_dir}" >&2
        printf '%s\n' "$pa_dir"
        return 0
    fi
    # Clone to a temp dir then rename: a half-materialised tree is never visible.
    # --shared borrows the object store; --no-checkout + detached checkout pins
    # the exact sha instead of whatever branch HEAD names. LFS smudge is skipped
    # (the archive form also shipped pointer files). stderr is NOT silenced: an
    # opaque "failed" is the class this script's header exists to prevent.
    GIT_LFS_SKIP_SMUDGE=1 git clone -q --shared --no-checkout "$pa_repo" "$pa_dir.tmp" &&
        GIT_LFS_SKIP_SMUDGE=1 git -C "$pa_dir.tmp" checkout -q --detach "$pa_sha" || {
        rm -rf "$pa_dir.tmp"; echo "ERROR — pinned clone/checkout of ${pa_sha} failed" >&2; return 2; }
    pa_n=$(git -C "$pa_dir.tmp" ls-files | wc -l)
    [ "$pa_n" -gt 0 ] || { rm -rf "$pa_dir.tmp"; echo "ERROR — empty checkout for ${pa_sha}" >&2; return 2; }
    printf '%s\n' "$pa_sha" > "$pa_dir.tmp/.bootstrap-pinned-sha"
    printf '.bootstrap-pinned-sha\n' >> "$pa_dir.tmp/.git/info/exclude"   # keep the snapshot git-clean
    rm -rf "$pa_dir"; mv "$pa_dir.tmp" "$pa_dir" || return 2
    echo "pinned-archive: ${pa_sha} (${pa_n} files) -> ${pa_dir}" >&2
    printf '%s\n' "$pa_dir"
}
selftest() {
    st=$(mktemp -d) || return 2; fail=0
    mkdir -p "$st/bin"
    printf '#!/bin/sh\nif [ "${GIT_LFS_SKIP_SMUDGE:-0}" = 1 ]; then cat; else echo "simulated missing LFS object" >&2; exit 1; fi\n' > "$st/bin/lfs-smudge"
    chmod +x "$st/bin/lfs-smudge"
    printf '[filter "lfs"]\n\tclean = cat\n\tsmudge = %s/bin/lfs-smudge\n\trequired = true\n' "$st" > "$st/gitconfig"
    git init -q "$st/r" && ( cd "$st/r" && git config user.email t@t && git config user.name t \
        && mkdir -p src && printf 'committed\n' > src/a.spl \
        && printf '*.png filter=lfs diff=lfs merge=lfs -text\n' > .gitattributes \
        && printf 'version https://git-lfs.github.com/spec/v1\noid sha256:0123456789abcdef\nsize 3\n' > asset.png \
        && git add -A && git commit -qm c1 )
    src_sha=$(git -C "$st/r" rev-parse HEAD)
    expected_inventory=$(git -C "$st/r" ls-files)
    asset_pointer=$(cat "$st/r/asset.png")
    d=$(GIT_CONFIG_GLOBAL="$st/gitconfig" pin_archive "$st/r" HEAD "$st/out" 2>/dev/null) || { echo "selftest FAIL: pin failed"; fail=1; }
    # Mutate the live tree AFTER pinning: torn content + new file + new commit.
    printf '<<<<<<< HEAD\n' > "$st/r/src/a.spl"; printf x > "$st/r/src/new.spl"
    ( cd "$st/r" && git add -A && git commit -qm c2 )
    [ "$(cat "$d/src/a.spl" 2>/dev/null)" = committed ] || { echo "selftest FAIL: live edit visible"; fail=1; }
    [ -e "$d/src/new.spl" ] && { echo "selftest FAIL: new file visible"; fail=1; }
    [ "$(cat "$d/asset.png" 2>/dev/null)" = "$asset_pointer" ] || { echo "selftest FAIL: LFS pointer was not preserved"; fail=1; }
    # The snapshot must be a git repository of its own (a `.git` DIRECTORY for
    # the Unix clone, a `.git` FILE for the Windows detached worktree) whose
    # HEAD is the pinned sha: SCV admission runs `git ls-files` in it. A copied
    # source repo would carry the live branch tip instead.
    [ -e "$d/.git" ] || { echo "selftest FAIL: snapshot is not a git repository (SCV admission needs git ls-files)"; fail=1; }
    [ "$(git -C "$d" rev-parse HEAD 2>/dev/null)" = "$src_sha" ] || { echo "selftest FAIL: snapshot HEAD is not the pinned sha"; fail=1; }
    [ "$(git -C "$d" ls-files 2>/dev/null)" = "$expected_inventory" ] || { echo "selftest FAIL: git ls-files inventory"; fail=1; }
    [ "$(cat "$d/.bootstrap-pinned-sha" 2>/dev/null)" = "$src_sha" ] || { echo "selftest FAIL: sha marker"; fail=1; }
    pin_archive "$st/r" no-such-rev "$st/out" >/dev/null 2>&1; [ $? -eq 2 ] || { echo "selftest FAIL: bad rev not exit 2"; fail=1; }
    rm -rf "$st"
    [ "$fail" -eq 0 ] && { echo "PASS — 8 selftest assertion(s) checked, pinned snapshot is a git checkout isolated from live edits"; return 0; }
    echo "FAIL — selftest"; return 1
}

case "${1:-}" in
    --selftest) selftest; exit $? ;;
    "") echo "usage: $0 <repo> <rev> <dest-parent> | --selftest" >&2; exit 2 ;;
    *) pin_archive "${1}" "${2:?rev}" "${3:?dest-parent}"; exit $? ;;
esac
