#!/usr/bin/env bash
# Build a Simple-generated RISC-V product core for K26 via Vivado 2025.2.
# Usage: bash scripts/fpga/build_k26_vexriscv.shs [--synth-only]

[ -n "${BASH_VERSION:-}" ] || exec bash "$0" "$@"
set -euo pipefail

VIVADO_SETTINGS="${VIVADO_SETTINGS:-$HOME/Xilinx/2025.2/Vivado/settings64.sh}"
RISCV_ARCH="${RISCV_ARCH:-rv64}"
case "$RISCV_ARCH" in
  rv64)
    BUILD_DIR="build/fpga/k26"
    RTL_DIR="build/vhdl/rv64"
    GENERATOR="scripts/fpga/generate_rv64_vhdl.shs"
    CORE_VHDL="$RTL_DIR/rv64imac_core_product.vhd"
    WRAPPER_VHDL="$RTL_DIR/rv64imac_core_product_wb.vhd"
    SOC_VHDL="$RTL_DIR/soc_top_rv64_external_ddr.vhd"
    PL_ENTITY="soc_top_rv64_k26_pl"
    PRELIGHT_BITSTREAM="build/build/xilinx_kv260/gateware/xilinx_kv260.bit"
    RISCV_MHZ="${RISCV_RV64_MHZ:-100}"
    ;;
  rv32)
    BUILD_DIR="build/fpga/k26_rv32"
    RTL_DIR="build/vhdl/rv32"
    GENERATOR="scripts/fpga/generate_rv32_vhdl.shs"
    CORE_VHDL="$RTL_DIR/core32_protected_product.vhd"
    WRAPPER_VHDL="$RTL_DIR/rv32imac_core_product_wb.vhd"
    SOC_VHDL="$RTL_DIR/soc_top_rv32_external_ddr.vhd"
    PL_ENTITY="soc_top_rv32_k26_pl"
    PRELIGHT_BITSTREAM="build/build/rv32_fpga/gateware/rv32_fpga.bit"
    RISCV_MHZ="${RISCV_RV32_MHZ:-100}"
    ;;
  *)
    echo "ERROR: RISCV_ARCH must be rv32 or rv64" >&2
    exit 2
    ;;
esac

LOCK_DIR="$BUILD_DIR.lock"
PROJECT_NAME="k26_${RISCV_ARCH}_product"
RUN_DIR="$BUILD_DIR/$PROJECT_NAME/$PROJECT_NAME.runs"
TCL_FILE="$BUILD_DIR/build_product.tcl"
XDC_FILE="$BUILD_DIR/k26_uart.xdc"
PRODUCT_BITSTREAM="$BUILD_DIR/${PROJECT_NAME}.bit"
PRODUCT_XSA="$BUILD_DIR/${PROJECT_NAME}.xsa"

if [ ! -f "$VIVADO_SETTINGS" ]; then
    echo "ERROR: Vivado not found at $VIVADO_SETTINGS"
    exit 1
fi
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    echo "ERROR: $RISCV_ARCH K26 Vivado build already running ($LOCK_DIR)" >&2
    exit 75
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT

# shellcheck disable=SC1090
. "$VIVADO_SETTINGS"
mkdir -p "$BUILD_DIR"

echo "Generating $RISCV_ARCH VHDL and Vivado TCL project..."
bash "$GENERATOR"
if grep -Eiq 'stub|placeholder' "$CORE_VHDL"; then
    echo "ERROR: $CORE_VHDL is placeholder RTL; refusing K26 build." >&2
    exit 2
fi
if ! grep -q '<=' "$CORE_VHDL"; then
    echo "ERROR: $CORE_VHDL has no signal assignments; refusing K26 build." >&2
    exit 2
fi

cat > "$XDC_FILE" <<XDC
set_property PACKAGE_PIN H12 [get_ports uart_tx]
set_property IOSTANDARD LVCMOS33 [get_ports uart_tx]
set_property PACKAGE_PIN E10 [get_ports uart_rx]
set_property IOSTANDARD LVCMOS33 [get_ports uart_rx]
XDC

cat > "$TCL_FILE" <<TCL
create_project $PROJECT_NAME $BUILD_DIR/$PROJECT_NAME -part xck26-sfvc784-2lv-c -force
set_property board_part xilinx.com:kv260_som:part0:1.4 [current_project]
add_files [list \
  $CORE_VHDL \
  $WRAPPER_VHDL \
  $RTL_DIR/clint.vhd \
  $RTL_DIR/plic.vhd \
  $RTL_DIR/uart16550.vhd \
  $RTL_DIR/bootrom.vhd \
  $RTL_DIR/wb_interconnect.vhd \
  $SOC_VHDL \
  $RTL_DIR/wb64_axi_hp_bridge.vhd \
  $RTL_DIR/$PL_ENTITY.vhd]
add_files -fileset constrs_1 $XDC_FILE
update_compile_order -fileset sources_1

create_bd_design k26_ps_bd
create_bd_cell -type ip -vlnv xilinx.com:ip:zynq_ultra_ps_e:3.5 zynq_ultra_ps_e_0
apply_bd_automation -rule xilinx.com:bd_rule:zynq_ultra_ps_e \
  -config {apply_board_preset "1"} [get_bd_cells zynq_ultra_ps_e_0]
set_property -dict [list CONFIG.PSU__USE__S_AXI_GP2 {1}] [get_bd_cells zynq_ultra_ps_e_0]
create_bd_cell -type ip -vlnv xilinx.com:ip:smartconnect:1.0 smartconnect_0
set_property -dict [list CONFIG.NUM_SI {1} CONFIG.NUM_MI {1}] [get_bd_cells smartconnect_0]
create_bd_cell -type module -reference $PL_ENTITY riscv_pl_0

connect_bd_intf_net [get_bd_intf_pins riscv_pl_0/M_AXI_HP] [get_bd_intf_pins smartconnect_0/S00_AXI]
connect_bd_intf_net [get_bd_intf_pins smartconnect_0/M00_AXI] [get_bd_intf_pins zynq_ultra_ps_e_0/S_AXI_HP0_FPD]
connect_bd_net [get_bd_pins zynq_ultra_ps_e_0/pl_clk0] \
  [get_bd_pins zynq_ultra_ps_e_0/saxihp0_fpd_aclk] \
  [get_bd_pins smartconnect_0/aclk] [get_bd_pins riscv_pl_0/clk]
connect_bd_net [get_bd_pins zynq_ultra_ps_e_0/pl_resetn0] \
  [get_bd_pins smartconnect_0/aresetn] [get_bd_pins riscv_pl_0/rst_n]
create_bd_port -dir O uart_tx
create_bd_port -dir I uart_rx
connect_bd_net [get_bd_ports uart_tx] [get_bd_pins riscv_pl_0/uart_tx]
connect_bd_net [get_bd_ports uart_rx] [get_bd_pins riscv_pl_0/uart_rx]
assign_bd_address
validate_bd_design
save_bd_design
set bd_wrapper [make_wrapper -files [get_files k26_ps_bd.bd] -top]
add_files -norecurse \$bd_wrapper
set_property top k26_ps_bd_wrapper [current_fileset]
update_compile_order -fileset sources_1

launch_runs synth_1
wait_on_run synth_1
open_run synth_1
report_utilization -file $RUN_DIR/synth_1/k26_ps_bd_wrapper_utilization_synth.rpt
report_timing_summary -file $RUN_DIR/synth_1/k26_ps_bd_wrapper_timing_summary_synth.rpt
if {[lsearch \$argv synth_only] >= 0} { exit }
launch_runs impl_1 -to_step write_bitstream
wait_on_run impl_1
file copy -force $RUN_DIR/impl_1/k26_ps_bd_wrapper.bit $PRODUCT_BITSTREAM
write_hw_platform -fixed -include_bit -force -file $PRODUCT_XSA
file mkdir [file dirname $PRELIGHT_BITSTREAM]
file copy -force $PRODUCT_BITSTREAM $PRELIGHT_BITSTREAM
TCL

SYNTH_ONLY=""
if [ "${1:-}" = "--synth-only" ]; then
    SYNTH_ONLY="1"
fi

echo "=== K26 Simple $RISCV_ARCH Product Build ==="
echo "Part:    xck26-sfvc784-2lv-c"
echo "Build:   $BUILD_DIR"
set +e
if [ -n "$SYNTH_ONLY" ]; then
    echo "Mode:    synthesis only"
    vivado -mode batch -source "$TCL_FILE" -tclargs synth_only \
        -journal "$BUILD_DIR/vivado.jou" -log "$BUILD_DIR/vivado.log" 2>&1 | tail -40
else
    echo "Mode:    full (synth + impl + bitstream)"
    vivado -mode batch -source "$TCL_FILE" \
        -journal "$BUILD_DIR/vivado.jou" -log "$BUILD_DIR/vivado.log" 2>&1 | tail -40
fi
vivado_rc="${PIPESTATUS[0]}"
set -e
if [ "$vivado_rc" -ne 0 ]; then
    echo "ERROR: Vivado failed (exit $vivado_rc); see $BUILD_DIR/vivado.log"
    exit "$vivado_rc"
fi

UTIL_REPORT="$RUN_DIR/synth_1/k26_ps_bd_wrapper_utilization_synth.rpt"
if [ -f "$UTIL_REPORT" ] &&
    grep -Eq '^\| CLB LUTs\*?[[:space:]]+\|[[:space:]]+0[[:space:]]+\|' "$UTIL_REPORT" &&
    grep -Eq '^\|[[:space:]]+RAMB36/FIFO\*[[:space:]]+\|[[:space:]]+0[[:space:]]+\|' "$UTIL_REPORT" &&
    grep -Eq '^\|[[:space:]]+RAMB18[[:space:]]+\|[[:space:]]+0[[:space:]]+\|' "$UTIL_REPORT"; then
    echo "ERROR: Vivado synthesized no CPU/RAM logic. See $UTIL_REPORT" >&2
    exit 3
fi

if [ -n "$SYNTH_ONLY" ]; then
    sh scripts/check/convert-riscv-vivado-reports.shs "$RISCV_ARCH" \
        "$UTIL_REPORT" \
        "$RUN_DIR/synth_1/k26_ps_bd_wrapper_timing_summary_synth.rpt" \
        "$RISCV_MHZ" \
        "${RISCV_SYNTH_REPORT_DIR:-build/riscv_synth_reports}"
    echo "SUCCESS: Synthesis checkpoint at $RUN_DIR/synth_1/k26_ps_bd_wrapper.dcp"
    exit 0
fi

if [ -f "$PRODUCT_BITSTREAM" ]; then
    echo "SUCCESS: Bitstream at $PRODUCT_BITSTREAM"
else
    echo "ERROR: Bitstream not found — check Vivado logs in $BUILD_DIR" >&2
    exit 4
fi
