#!/bin/sh
# kv260_jtag_debug_demo.shs — exercise the live JTAG/MMIO debug primitives the
# NVMe/SimpleOS board lanes will reuse, over the BSCANE2 tunnel (raw hw_jtag,
# TCK=1 MHz). Requires a running rv32 debug bitstream + a free JTAG chain
# (fresh hw_server, no other Vivado). Non-destructive: halts, reads, resumes.
#
# DMI op encoding for kv260_dmi_hwjtag.tcl: <op:addr:data>, op=1 read/2 write.
#   dmcontrol=0x10 dmstatus=0x11 abstractcs=0x16 command=0x17 data0=0x04
#   sbcs=0x38 sbaddress0=0x39 sbdata0=0x3c
#   abstract access-register cmd = 0x00220000 | regno ; x8=0x1008 dpc=0x07b1
#   SBA read: sbcs = sbreadonaddr(bit20)|sbaccess32(bits19:17=010) = 0x00140000
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"; cd "$ROOT"
VIVADO="${VIVADO:-/home/ormastes/Xilinx/2025.2/Vivado/bin/vivado}"
TCL="$ROOT/scripts/fpga/kv260_dmi_hwjtag.tcl"
IDLE="${IDLE:-128}"
MMIO="${MMIO:-80000000}"   # SBA target: rv32 code ROM base (first instruction)
EVID="${EVID:-$ROOT/build/fpga/evidence/rv32_$(date +%Y-%m-%d)/jtag_debug_demo_$(date +%Y%m%d_%H%M%S)}"
mkdir -p "$EVID"
LOG="$EVID/demo.log"

# halt / dmstatus / dpc / x8 / SBA-config / SBA-addr / SBA-data / resume / dmstatus
"$VIVADO" -mode batch -nojournal -nolog -notrace -source "$TCL" -tclargs "$IDLE" \
  2:10:80000001 1:11:0 2:17:002207b1 1:04:0 2:17:00221008 1:04:0 \
  2:38:00140000 2:39:$MMIO 1:3c:0 2:10:40000001 1:11:0 \
  > "$LOG" 2>&1
echo "vivado_rc=$?"
echo "=== JTAG-debug demo results (MMIO target=0x$MMIO) ==="
grep -E 'FREQ=|OP[0-9]+_RESULT' "$LOG"
echo "transcript: $LOG"
