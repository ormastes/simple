#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

SIMPLE_BINARY="${SIMPLE_BINARY:-bin/release/simple}"
OUT_DIR="build/vhdl/rv32"
CORE_OUTPUT="$OUT_DIR/core32_protected_product.vhd"

mkdir -p "$OUT_DIR"
"$SIMPLE_BINARY" run scripts/fpga/rv32_vhdl_driver.spl
"$SIMPLE_BINARY" run src/app/cli/vhdl_compile_entry.spl \
    src/lib/hardware/rv32i_rtl/protected_entry.spl -o "$CORE_OUTPUT"

for path in \
    "$CORE_OUTPUT" \
    "$OUT_DIR/rv32imac_core_product_wb.vhd" \
    "$OUT_DIR/clint.vhd" \
    "$OUT_DIR/plic.vhd" \
    "$OUT_DIR/uart16550.vhd" \
    "$OUT_DIR/bootrom.vhd" \
    "$OUT_DIR/wb_interconnect.vhd" \
    "$OUT_DIR/soc_top_rv32_external_ddr.vhd" \
    "$OUT_DIR/wb64_axi_hp_bridge.vhd" \
    "$OUT_DIR/soc_top_rv32_k26_pl.vhd"; do
    if [ ! -s "$path" ]; then
        printf 'ERROR missing generated RV32 VHDL: %s\n' "$path" >&2
        exit 1
    fi
done

if ! grep -q 'entity core32_protected_product_entry is' "$CORE_OUTPUT"; then
    printf 'ERROR generated RV32 product core is invalid\n' >&2
    exit 1
fi
if ! grep -q 'entity rv32imac_core_product_wb is' "$OUT_DIR/rv32imac_core_product_wb.vhd"; then
    printf 'ERROR generated RV32 product wrapper is invalid\n' >&2
    exit 1
fi
if ! grep -q 'entity soc_top_rv32_external_ddr is' "$OUT_DIR/soc_top_rv32_external_ddr.vhd"; then
    printf 'ERROR generated RV32 external SoC top is invalid\n' >&2
    exit 1
fi
if ! grep -q 'entity soc_top_rv32_k26_pl is' "$OUT_DIR/soc_top_rv32_k26_pl.vhd"; then
    printf 'ERROR generated RV32 K26 PL top is invalid\n' >&2
    exit 1
fi

GHDL_WORK="$OUT_DIR/.ghdl_work"
rm -rf "$GHDL_WORK"
mkdir -p "$GHDL_WORK"
for unit in \
    core32_protected_product \
    rv32imac_core_product_wb \
    clint plic uart16550 bootrom wb_interconnect \
    soc_top_rv32_external_ddr wb64_axi_hp_bridge soc_top_rv32_k26_pl; do
    if ! ghdl -a --std=08 --workdir="$GHDL_WORK" "$OUT_DIR/$unit.vhd"; then
        printf 'ERROR GHDL rejected RV32 unit: %s\n' "$unit" >&2
        exit 1
    fi
done

printf 'RV32_VHDL_GEN: PASS\n'
