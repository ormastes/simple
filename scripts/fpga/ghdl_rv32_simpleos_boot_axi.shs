#!/bin/sh
# GHDL SoC-sim: boot the FULL rv32 SimpleOS kernel on the SYNTHESIZABLE rv32
# soft-core (rv32_exec_core_axi) through an EXTERNAL, LATENCY-INJECTING memory
# slave.
#
# This is the synthesizability sibling of ghdl_rv32_simpleos_boot.shs. That lane
# uses rv32_exec_core_flat, which fetches+decodes+executes in ONE cycle with
# COMBINATIONAL reads from internal 16 MB + 1 MB VHDL arrays -- correct, but
# un-synthesizable (17 MB >> ~2.9 MB xck26 BRAM, and it never went through
# Vivado). rv32_exec_core_axi keeps the SAME decode/ALU/CSR/M-ext logic but
# splits S_EXEC into a STALLED FSM (S_FETCH -> S_FETCH_W [-> S_FETCH2 ->
# S_FETCH2_W] -> S_DECODE -> S_LOAD_W|S_STORE_W|S_DIVIDE|S_UART -> S_FETCH) with
# an AXI-shaped external memory port (addr/wdata/wstrb/we/req -> rdata/rvalid).
#
# tb_rv32_simpleos_boot_axi backs that port with a behavioral slave that injects
# VARYING wait-states (N=1..4) on every access -- proving the core boots when
# memory has latency (which PS-DDR4 over an AXI master always does). The same
# rv32_flat.mem (16 MB @ 0x80000000) + rv32_ramdisk.mem (1 MB @ 0x88000000)
# images are used, now loaded by the slave instead of the core.
#
# NO Vivado. GHDL simulation only.
set -e
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

RTL_DIR="$ROOT_DIR/examples/09_embedded/fpga_riscv/rtl"
WORK_DIR="$ROOT_DIR/build/ghdl/rv32_simpleos_boot_axi"
KERNEL_ELF="${KERNEL_ELF:-$ROOT_DIR/build/os/simpleos_riscv32_smf_fs.elf}"
FAT32_IMG="${FAT32_IMG:-$ROOT_DIR/build/os/fat32-riscv32.img}"
RAMDISK_BYTES="${RAMDISK_BYTES:-1048576}"

command -v ghdl >/dev/null 2>&1 || { echo "ERROR: ghdl not found in PATH"; exit 1; }
[ -f "$KERNEL_ELF" ] || { echo "ERROR: kernel ELF missing: $KERNEL_ELF"; exit 1; }
[ -f "$FAT32_IMG" ] || { echo "ERROR: FAT32 ramdisk image missing: $FAT32_IMG"; exit 1; }

mkdir -p "$WORK_DIR"
echo "=== GHDL RV32 SimpleOS kernel boot (SYNTHESIZABLE AXI core + latency-injecting slave) ==="
echo "  Kernel ELF: $KERNEL_ELF"
echo "  Ramdisk img: $FAT32_IMG (first $RAMDISK_BYTES bytes -> 0x88000000)"

# 1. Flatten loadable PROGBITS to the slave's init_mem file.
riscv64-unknown-elf-objcopy -O binary "$KERNEL_ELF" "$WORK_DIR/kernel.bin"
od -An -v -tx4 -w4 "$WORK_DIR/kernel.bin" | awk 'NF{print $1}' > "$WORK_DIR/rv32_flat.mem"
echo "  Kernel image: $(wc -l < "$WORK_DIR/rv32_flat.mem") words (rv32_flat.mem)"

# 1b. Flatten the ramdisk (FAT32) image into the slave's ramdisk-bank init file.
head -c "$RAMDISK_BYTES" "$FAT32_IMG" > "$WORK_DIR/rv32_ramdisk.img"
od -An -v -tx4 -w4 "$WORK_DIR/rv32_ramdisk.img" | awk 'NF{print $1}' > "$WORK_DIR/rv32_ramdisk.mem"
echo "  Ramdisk image: $(wc -l < "$WORK_DIR/rv32_ramdisk.mem") words (rv32_ramdisk.mem)"

# 2. Analyse + elaborate.
printf "  Analysing AXI core + testbench ... "
out="$(ghdl -a --std=08 --workdir="$WORK_DIR" \
  "$RTL_DIR/rv32_exec_core_axi.vhd" \
  "$RTL_DIR/tb_rv32_simpleos_boot_axi.vhd" 2>&1)" || true
if echo "$out" | grep -q ":error:"; then
  echo "FAIL"; echo "$out" | tail -40; exit 1
fi
echo "OK"

printf "  Elaborating ... "
out="$(cd "$WORK_DIR" && ghdl -e --std=08 --workdir="$WORK_DIR" tb_rv32_simpleos_boot_axi 2>&1)" || true
if echo "$out" | grep -qi "error"; then
  echo "FAIL"; echo "$out" | tail -40; exit 1
fi
echo "OK"

# 3. Run from WORK_DIR so the slave's relative init_mem open finds the images.
STOP_TIME="${STOP_TIME:-2000ms}"
printf "  Running simulation (stop-time=%s) ... \n" "$STOP_TIME"
sim="$(cd "$WORK_DIR" && ghdl -r --std=08 --workdir="$WORK_DIR" \
  tb_rv32_simpleos_boot_axi --stop-time="$STOP_TIME" 2>&1)" || true
echo "----- UART transcript -----"
echo "$sim" | grep -E "RV32_UART_LINE:" | sed 's/.*RV32_UART_LINE: //'
echo "---------------------------"
echo "$sim" | grep -E "RV32_BOOT_(DONE|STUCK)" | tail -4
