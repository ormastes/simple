#!/bin/sh
# ghdl_validate_rv64.shs — GHDL validation of RV64GC SoC VHDL
#
# Usage: sh scripts/fpga/ghdl_validate_rv64.shs [--analyze|--elaborate|--simulate]
#
# Phases:
#   --analyze   (default) Run ghdl -a --std=08 on all .vhd files
#   --elaborate Also run ghdl -e --std=08 on soc_top_rv64
#   --simulate  Also run ghdl -r with testbench

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
VHDL_DIR="$PROJECT_ROOT/build/vhdl/rv64"
WORK_DIR="$PROJECT_ROOT/build/ghdl/rv64"
TB_DIR="$PROJECT_ROOT/examples/09_embedded/fpga_riscv/rtl"

PHASE="analyze"
for arg in "$@"; do
    case "$arg" in
        --analyze)   PHASE="analyze" ;;
        --elaborate) PHASE="elaborate" ;;
        --simulate)  PHASE="simulate" ;;
    esac
done

# Verify GHDL is available
if ! command -v ghdl >/dev/null 2>&1; then
    echo "ERROR: ghdl not found in PATH"
    exit 1
fi

echo "=== GHDL RV64GC Validation ==="
echo "Phase: $PHASE"
echo "VHDL dir: $VHDL_DIR"
echo "Work dir: $WORK_DIR"
echo ""

mkdir -p "$WORK_DIR"

# Analysis order per D-5:
# pkg -> leaves (alu, regfile, csr_s, csr) -> composites (decode, lsu, mmu_sv39,
# mul_div, atomics, trap) -> core -> soc_top_rv64 -> testbench
# Order: pkg -> RTL leaves -> compiler product -> WB adapter -> peripherals ->
# selected SoC tops -> external-DDR bridge/top.
ANALYSIS_ORDER="rv64imac_core_product rv64imac_core_product_wb clint plic uart16550 ram bootrom wb_interconnect soc_top_rv64 soc_top_rv64_external_ddr wb64_axi_hp_bridge soc_top_rv64_k26_pl"
set -- $ANALYSIS_ORDER
MODULE_COUNT=$#

# These are the generator's required artifacts, excluding only its Vivado-only
# soc_top_rv64_k26 top. Never substitute the same-named handwritten board DUT.
# Check the whole closure before analysis so stale work-library units cannot
# hide a missing generated source in a subsequent elaboration.
MISSING=0
for module in $ANALYSIS_ORDER; do
    if [ ! -s "$VHDL_DIR/${module}.vhd" ]; then
        echo "ERROR: required generated artifact missing or empty: $module.vhd"
        MISSING=$((MISSING + 1))
    fi
done
[ "$MISSING" -eq 0 ] || exit 1

# Phase 1: Analyze
echo "--- Phase: Analyze ---"
PASS=0
FAIL=0

for module in $ANALYSIS_ORDER; do
    VHD_FILE="$VHDL_DIR/${module}.vhd"
    printf "  Analyzing %s.vhd ... " "$module"
    if GHDL_OUT=$(ghdl -a --std=08 --workdir="$WORK_DIR" "$VHD_FILE" 2>&1); then
        echo "OK"
        PASS=$((PASS + 1))
    else
        echo "FAIL"
        echo "$GHDL_OUT" | tail -40
        FAIL=$((FAIL + 1))
    fi
done

echo ""
echo "Analysis: $PASS passed, $FAIL failed out of $MODULE_COUNT modules"

# A later elaboration must not consume stale units after any analysis failure.
[ "$FAIL" -eq 0 ] && [ "$PASS" -gt 0 ] && [ "$PASS" -eq "$MODULE_COUNT" ] || exit 1
if [ "$PHASE" = "analyze" ]; then
    exit 0
fi

# Phase 2: Elaborate
echo ""
echo "--- Phase: Elaborate ---"
printf "  Elaborating soc_top_rv64 ... "
if TOP_OUT=$(ghdl -e --std=08 --workdir="$WORK_DIR" soc_top_rv64 2>&1); then
    printf '%s\n' "$TOP_OUT" | tail -40
    echo "OK"
else
    printf '%s\n' "$TOP_OUT" | tail -40
    echo "FAIL"
    exit 1
fi

if [ "$PHASE" = "elaborate" ]; then
    exit 0
fi

# Phase 3: Simulate
echo ""
echo "--- Phase: Simulate ---"
TB_FILE="$TB_DIR/tb_rv64_wb_soc_smoke.vhd"
if [ ! -f "$TB_FILE" ]; then
    echo "  ERROR: testbench not found at $TB_FILE"
    exit 1
fi

printf "  Analyzing testbench ... "
if TB_OUT=$(ghdl -a --std=08 --workdir="$WORK_DIR" "$TB_FILE" 2>&1); then
    echo "OK"
else
    echo "FAIL"
    echo "$TB_OUT" | tail -40
    exit 1
fi

printf "  Elaborating testbench ... "
if ELAB_OUT=$(ghdl -e --std=08 --workdir="$WORK_DIR" tb_rv64_wb_soc_smoke 2>&1); then
    echo "OK"
else
    echo "FAIL"
    echo "$ELAB_OUT" | tail -40
    exit 1
fi

printf "  Running simulation ... "
if SIM_OUT=$(cd "$VHDL_DIR" && ghdl -r --std=08 --workdir="$WORK_DIR" tb_rv64_wb_soc_smoke --stop-time=10ms 2>&1); then
    SIM_EXIT=0
else
    SIM_EXIT=$?
fi
printf '%s\n' "$SIM_OUT" | tail -40

if [ $SIM_EXIT -eq 0 ] &&
   echo "$SIM_OUT" | grep -q "RV64_UART_TX_ACTIVITY_SEEN" &&
   echo "$SIM_OUT" | grep -q "RV64_UART_BYTE_SEEN" &&
   echo "$SIM_OUT" | grep -q "RV64_UART_MARKER_SEEN"; then
    echo "Simulation PASSED"
else
    echo "Simulation FAILED (exit $SIM_EXIT)"
    exit 1
fi
