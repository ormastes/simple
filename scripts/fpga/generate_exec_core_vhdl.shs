#!/bin/sh
# Generate the two silicon-lane exec cores (rv32/rv64) from the pure-Simple
# structured VHDL generator (src/lib/hardware/vhdl_gen/), byte-identical to
# the proven goldens in examples/09_embedded/fpga_riscv/rtl/.
#
# Usage: sh scripts/fpga/generate_exec_core_vhdl.shs [--mem-prefix DIR/] [--out-dir DIR]
set -e
ROOT_DIR=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT_DIR"
mkdir -p build/os/rtl
bin/simple run src/lib/hardware/vhdl_gen/generate_main.spl "$@"
