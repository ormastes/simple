#!/bin/sh
# GHDL rehearsal of the REAL KV260 silicon bring-up path for rv32 SimpleOS.
#
# ghdl_rv32_simpleos_boot_axi.shs proves the CORE against a behavioral slave
# wired straight to its mem_* port. This lane goes one level further out and
# drives soc_top_rv32_k26_ddr -- the actual PL top that gets synthesized --
# so it exercises the two blocks that only matter on silicon:
#
#   * rv32_axi4_mem_adapter: mem_* -> full AXI4 (AW/W/B/AR/R), including the
#     address remap from the core's 0x80000000/0x88000000 into the PS DDR
#     aperture. On ZynqMP 0x80000000+ is NOT memory, so a boot here only
#     succeeds if that remap is correct.
#   * rv32_ctrl_obs_slave: the AXI4-Lite control/observation path. The
#     transcript printed below is recovered by POLLING that slave over AXI-Lite
#     -- byte for byte the same procedure xsdb uses on the board -- not by
#     tapping inside the DUT.
#
# The AXI slave model injects varying wait-states (1..4) on both channels.
#
# NO Vivado. GHDL simulation only.
set -e
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

RTL_DIR="$ROOT_DIR/examples/09_embedded/fpga_riscv/rtl"
DEFAULT_WORK_DIR="$ROOT_DIR/build/ghdl/rv32_k26_ddr_boot"
if [ "${GARBAGE_FILL:-0}" = "1" ]; then
  DEFAULT_WORK_DIR="$ROOT_DIR/build/ghdl/rv32_k26_ddr_boot_garbage"
fi
EVIDENCE_DIR="${WORK_DIR:-$DEFAULT_WORK_DIR}"
KERNEL_ELF="${KERNEL_ELF:-$ROOT_DIR/build/os/simpleos_riscv32_smf_fs.elf}"
FAT32_IMG="${FAT32_IMG:-$ROOT_DIR/build/os/fat32-riscv32.img}"
RAMDISK_BYTES="${RAMDISK_BYTES:-1048576}"
OBJCOPY="${OBJCOPY:-riscv64-unknown-elf-objcopy}"
EXPECTED_MARKER="${EXPECTED_MARKER:-TEST PASSED}"
TRACE_BASE="${TRACE_BASE:-0}"
TRACE_BYTES="${TRACE_BYTES:-0}"

command -v ghdl >/dev/null 2>&1 || { echo "ERROR: ghdl not found in PATH"; exit 1; }
[ -f "$KERNEL_ELF" ] || { echo "ERROR: kernel ELF missing: $KERNEL_ELF"; exit 1; }
[ -f "$FAT32_IMG" ] || { echo "ERROR: FAT32 image missing: $FAT32_IMG"; exit 1; }

mkdir -p "$EVIDENCE_DIR"
WORK_DIR="$(mktemp -d "$EVIDENCE_DIR/run.XXXXXX")"
echo "=== GHDL rv32 SimpleOS boot through the K26 DDR PL top (AXI4 + AXI-Lite) ==="
echo "  Kernel ELF:  $KERNEL_ELF"
echo "  Ramdisk img: $FAT32_IMG (first $RAMDISK_BYTES bytes -> core 0x88000000)"
echo "  Marker:      $EXPECTED_MARKER"
echo "  Trace range: $TRACE_BASE + $TRACE_BYTES bytes"

"$OBJCOPY" -O binary "$KERNEL_ELF" "$WORK_DIR/kernel.bin"
od -An -v -tx4 -w4 "$WORK_DIR/kernel.bin" | awk 'NF{print $1}' > "$WORK_DIR/rv32_flat.mem"
echo "  Kernel image:  $(wc -l < "$WORK_DIR/rv32_flat.mem") words"

head -c "$RAMDISK_BYTES" "$FAT32_IMG" > "$WORK_DIR/rv32_ramdisk.img"
od -An -v -tx4 -w4 "$WORK_DIR/rv32_ramdisk.img" | awk 'NF{print $1}' > "$WORK_DIR/rv32_ramdisk.mem"
echo "  Ramdisk image: $(wc -l < "$WORK_DIR/rv32_ramdisk.mem") words"

printf "  Analysing PL top + adapter + control slave + testbench ... "
if ! out="$(ghdl -a --std=08 --workdir="$WORK_DIR" \
  "$RTL_DIR/rv32_exec_core_axi.vhd" \
  "$RTL_DIR/rv32_axi4_mem_adapter.vhd" \
  "$RTL_DIR/rv32_nvme_axi.vhd" \
  "$RTL_DIR/rv32_ctrl_obs_slave.vhd" \
  "$RTL_DIR/soc_top_rv32_k26_ddr.vhd" \
  "$RTL_DIR/tb_rv32_k26_ddr_boot.vhd" 2>&1)"; then
  echo "FAIL"; echo "$out" | tail -40; exit 1
fi
echo "OK"

printf "  Elaborating ... "
if ! out="$(cd "$WORK_DIR" && ghdl -e --std=08 --workdir="$WORK_DIR" tb_rv32_k26_ddr_boot 2>&1)"; then
  echo "FAIL"; echo "$out" | tail -40; exit 1
fi
echo "OK"

# A full DDR-path boot to TEST PASSED takes 125.07ms of sim time (measured
# 2026-07-26; the marker match stops the run early, so the bound is only a
# safety net). 200ms gives margin; the old 3000ms default wasted 66+ min of
# wall clock per iteration.
STOP_TIME="${STOP_TIME:-200ms}"
# GARBAGE_FILL=1: fill DDR beyond the loaded kernel image with nonzero
# pseudo-random words, rehearsing REAL power-up PS DDR4 (never zeroed).
# A kernel that relies on implicit zero .bss boots under the default zeroed
# model but fails here exactly as on silicon.
GEN_ARGS=""
if [ "${GARBAGE_FILL:-0}" = "1" ]; then
  GEN_ARGS="-gG_GARBAGE_FILL=true"
  echo "  DDR model: GARBAGE FILL (un-zeroed power-up DDR rehearsal)"
fi
echo "  Running simulation (stop-time=$STOP_TIME) ..."
printf 'K26_GARBAGE_FILL=%s\n' "${GARBAGE_FILL:-0}" > "$WORK_DIR/sim.log"
if (cd "$WORK_DIR" && ghdl -r --std=08 --workdir="$WORK_DIR" \
  tb_rv32_k26_ddr_boot $GEN_ARGS \
  -gG_MARKER="$EXPECTED_MARKER" -gG_TRACE_BASE="$TRACE_BASE" \
  -gG_TRACE_BYTES="$TRACE_BYTES" --stop-time="$STOP_TIME" \
  >> "$WORK_DIR/sim.log" 2>&1); then
  sim_status=0
else
  sim_status=$?
fi
cp "$WORK_DIR/sim.log" "$EVIDENCE_DIR/sim.log"
if [ "$sim_status" -ne 0 ]; then
  echo "RESULT: FAIL - simulation exited with status $sim_status"
  tail -40 "$WORK_DIR/sim.log"
  exit 1
fi

echo "----- transcript recovered over AXI-Lite -----"
grep -v -E "^K26_" "$WORK_DIR/sim.log" || true
echo "----------------------------------------------"
grep -E "^K26_" "$WORK_DIR/sim.log" || true

if grep -q "K26_MARKER_SEEN" "$WORK_DIR/sim.log"; then
  if [ "${REQUIRE_TRACE:-0}" = "1" ]; then
    reads="$(sed -n 's/^K26_TRACE_READS=//p' "$WORK_DIR/sim.log" | tail -1)"
    writes="$(sed -n 's/^K26_TRACE_WRITES=//p' "$WORK_DIR/sim.log" | tail -1)"
    [ "${reads:-0}" -gt 0 ] 2>/dev/null || { echo "RESULT: FAIL - no AXI reads in trace range"; exit 1; }
    [ "${writes:-0}" -gt 0 ] 2>/dev/null || { echo "RESULT: FAIL - no AXI writes in trace range"; exit 1; }
  fi
  echo "RESULT: PASS - ${RESULT_LABEL:-rv32 SimpleOS booted through the AXI4/DDR path}"
  exit 0
fi
echo "RESULT: FAIL - terminal marker not seen (full log: $EVIDENCE_DIR/sim.log)"
exit 1
