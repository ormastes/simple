#!/bin/sh
# ghdl_rv32_nvme_bram_soc.shs — GHDL rehearsal of the EXACT synthesizable
# tiny-BRAM SoC (rv32_bram_soc = rv32_exec_core_axi + BRAM banks + UART capture
# + obs port) running the Simple-generated NVMe self-test firmware.
#
# MANDATORY gate before build_rv32_nvme_bram_bitstream.shs (KV260 silicon).
# The firmware is self-contained (no external NVMe device model) and prints
# "ALL RV32 NVME FW CHECKS PASS" to the 16550 THR at 0x10000000.
#
# Env knobs:
#   FW_ELF        firmware ELF linked with nvme_fw_rv32_bram.ld
#                 (default build/ghdl/rv32_nvme_fw/nvme_fw_rv32_bram.elf, the
#                 image whose GHDL PASS is on record in
#                 build/ghdl/rv32_nvme_verify/verify.log; rebuild with
#                 scripts/check/check-nvme-rv32-minimal-live.shs +
#                 scripts/fpga/ghdl_rv32_nvme_fw.shs)
#   RAM_WORDS     default 16384 (64 KB = the fw's whole link window)
#   RDISK_WORDS   default 1024  (fw never touches the ramdisk)
#   GARBAGE_FILL  =1: fill RAM beyond the loaded image and the whole ramdisk
#                 with deterministic nonzero xorshift32 garbage. Un-zeroed
#                 memory is the proven silicon killer class (sim RAM powers up
#                 zeroed and masks it). NOTE: this fw's .bss is EMPTY
#                 (_sbss == _ebss) and the stack needs no init, so garbage must
#                 not change the verdict; if it does, that is a real fw bug.
set -e
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

RTL_DIR="$ROOT_DIR/examples/09_embedded/fpga_riscv/rtl"
WORK_DIR="$ROOT_DIR/build/ghdl/rv32_nvme_bram_soc"
FW_ELF="${FW_ELF:-$ROOT_DIR/build/ghdl/rv32_nvme_fw/nvme_fw_rv32_bram.elf}"
RAM_WORDS="${RAM_WORDS:-16384}"
RDISK_WORDS="${RDISK_WORDS:-1024}"
RUN_NAME=clean
[ "${GARBAGE_FILL:-0}" = "1" ] && RUN_NAME=garbage
DEFAULT_WORK_DIR="$WORK_DIR/$RUN_NAME"
WORK_DIR="${WORK_DIR_OVERRIDE:-$DEFAULT_WORK_DIR}"
EVIDENCE_DIR="${EVIDENCE_DIR:-$ROOT_DIR/build/test-artifacts/nvme_rv32_bram_soc/$RUN_NAME}"
LOG="$WORK_DIR/sim.log"
LEGACY_LOG="$ROOT_DIR/build/ghdl/rv32_nvme_bram_soc/sim.log"

command -v ghdl >/dev/null 2>&1 || { echo "ERROR: ghdl not found in PATH"; exit 1; }
[ -f "$FW_ELF" ] || {
  echo "ERROR: firmware ELF missing: $FW_ELF"
  echo "Rebuild: scripts/check/check-nvme-rv32-minimal-live.shs then scripts/fpga/ghdl_rv32_nvme_fw.shs"
  exit 1
}

mkdir -p "$WORK_DIR"
mkdir -p "$EVIDENCE_DIR"
mkdir -p "$(dirname "$LEGACY_LOG")"
echo "=== GHDL RV32 NVMe firmware on the SYNTH BRAM SoC (rv32_bram_soc) ==="

# 1. Flatten the ELF to the BRAM INIT .mem (32-bit LE words, hex).
llvm-objcopy -O binary "$FW_ELF" "$WORK_DIR/fw.bin"
od -An -v -tx4 -w4 "$WORK_DIR/fw.bin" | awk 'NF{print $1}' > "$WORK_DIR/rv32_flat.mem"
IMG_WORDS=$(wc -l < "$WORK_DIR/rv32_flat.mem")
[ "$IMG_WORDS" -le "$RAM_WORDS" ] || { echo "ERROR: image ($IMG_WORDS words) exceeds RAM_WORDS=$RAM_WORDS"; exit 1; }

# 2. GARBAGE_FILL: pad RAM beyond the image + the whole ramdisk with xorshift32
#    garbage; otherwise a minimal zero ramdisk file (init fn zero-fills the rest).
if [ "${GARBAGE_FILL:-0}" = "1" ]; then
  awk -v n=$((RAM_WORDS - IMG_WORDS)) 'BEGIN{
    s=305419896; # 0x12345678
    for(i=0;i<n;i++){
      s=xor(s,and(s*8192,4294967295)); s=xor(s,int(s/131072));
      s=and(xor(s,and(s*32,4294967295)),4294967295);
      if(s==0)s=2463534242;
      printf "%08x\n", s;
    }}' >> "$WORK_DIR/rv32_flat.mem"
  awk -v n="$RDISK_WORDS" 'BEGIN{
    s=2463534242; # 0x92d68ca2
    for(i=0;i<n;i++){
      s=xor(s,and(s*8192,4294967295)); s=xor(s,int(s/131072));
      s=and(xor(s,and(s*32,4294967295)),4294967295);
      if(s==0)s=305419896;
      printf "%08x\n", s;
    }}' > "$WORK_DIR/rv32_ramdisk.mem"
  echo "  GARBAGE_FILL=1: RAM padded $IMG_WORDS -> $RAM_WORDS words, ramdisk $RDISK_WORDS garbage words"
else
  printf "00000000\n" > "$WORK_DIR/rv32_ramdisk.mem"
fi
echo "  Firmware image: $IMG_WORDS words (rv32_flat.mem), RAM_WORDS=$RAM_WORDS RDISK_WORDS=$RDISK_WORDS"

# 3. Analyse + elaborate the EXACT synth RTL + tb.
printf "  Analysing synth RTL + testbench ... "
if ! ghdl -a --std=08 --workdir="$WORK_DIR" \
  "$RTL_DIR/rv32_exec_core_axi.vhd" \
  "$RTL_DIR/rv32_bram_soc.vhd" \
  "$RTL_DIR/tb_rv32_nvme_bram_soc.vhd" >"$WORK_DIR/analyse.log" 2>&1; then
  echo "FAIL"; tail -40 "$WORK_DIR/analyse.log"; exit 1
fi
echo "OK"

printf "  Elaborating ... "
if ! (cd "$WORK_DIR" && ghdl -e --std=08 --workdir="$WORK_DIR" tb_rv32_nvme_bram_soc \
  >"$WORK_DIR/elaborate.log" 2>&1); then
  echo "FAIL"; tail -40 "$WORK_DIR/elaborate.log"; exit 1
fi
echo "OK"

# 4. Run from WORK_DIR so the SoC's BRAM INIT file opens resolve. Persist log.
echo "  Running simulation (log: $LOG) ..."
(cd "$WORK_DIR" && ghdl -r --std=08 --workdir="$WORK_DIR" tb_rv32_nvme_bram_soc \
  -gTINY_RAM_WORDS="$RAM_WORDS" -gTINY_RDISK_WORDS="$RDISK_WORDS" \
  --stop-time=450ms > "$LOG" 2>&1) || true
cp "$LOG" "$EVIDENCE_DIR/sim.log"
cp "$WORK_DIR/fw.bin" "$EVIDENCE_DIR/fw.bin"
cp "$WORK_DIR/rv32_flat.mem" "$EVIDENCE_DIR/rv32_flat.mem"
cp "$WORK_DIR/rv32_ramdisk.mem" "$EVIDENCE_DIR/rv32_ramdisk.mem"
cp "$WORK_DIR/analyse.log" "$EVIDENCE_DIR/analyse.log"
cp "$WORK_DIR/elaborate.log" "$EVIDENCE_DIR/elaborate.log"
cp "$LOG" "$LEGACY_LOG"
grep -E "RV32_NVMEBRAM_(UART_LINE|BOOT_DONE|BOOT_STUCK|OBS_MAGIC|OBS_STATUS|OBS_UART_)" "$LOG" | tail -12

for marker in \
  "NAND STARTUP PASS" \
  "NAND ADMINQ PASS" \
  "NAND IOQ PASS" \
  "NAND ERASE PASS" \
  "NAND PROGRAM PASS" \
  "NAND READ PASS" \
  "NAND PREVENT PASS" \
  "NAND EVIDENCE D1 U1 F5 C3 T1 M1 Q3 X2 S1 PASS" \
  "NAND RECOVERY PASS"
do
  grep -q "RV32_NVMEBRAM_UART_LINE: $marker" "$LOG" || {
    echo "STATUS: FAIL ghdl-rv32-nvme-bram-soc missing-marker='$marker'"
    exit 1
  }
done

if grep -q "RV32_NVMEBRAM_BOOT_DONE reached=NVME_FW_PASS" "$LOG" &&
   grep -q "RV32_NVMEBRAM_OBS_MAGIC_OK" "$LOG" &&
   grep -q "RV32_NVMEBRAM_OBS_STATUS pass='1' fail='0'" "$LOG" &&
   grep -q "RV32_NVMEBRAM_OBS_UART_MATCH" "$LOG"; then
  echo "STATUS: PASS ghdl-rv32-nvme-bram-soc (fw PASS marker + obs transcript match on the synth SoC RTL)"
  exit 0
fi
if grep -q "reached=NVME_FW_FAIL" "$LOG"; then
  echo "STATUS: DIVERGENCE ghdl-rv32-nvme-bram-soc (fw ran but selftest FAILed on the synth SoC)"
  exit 2
fi
echo "STATUS: FAIL ghdl-rv32-nvme-bram-soc (no marker — see $LOG)"
exit 1
