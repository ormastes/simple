#!/usr/bin/env bash
# bringup_kv260_rv64_ddr.shs -- program the rv64/DDR bitstream onto a REAL
# KV260 (xck26) and boot rv64 SimpleOS on the Simple soft-core, reading the
# boot transcript back over JTAG. Direct mirror of the silicon-proven
# bringup_kv260_rv32_ddr.shs (read that file's header for the full landmine
# history: full-psu_init-before-fpga, A53 cache invalidation, .bss zeroing).
#
# Observation is over JTAG, NOT serial: the KV260 carrier does not route the
# fabric UART (H12 / PMOD J2) to the onboard FT4232H, so no host tty can ever
# see the soft-core's console. The core's UART side-channel is captured in the
# PL into rv32_ctrl_obs_slave's 16 KB buffer (reused unchanged by the rv64 top)
# and read out via the PS at 0xA0000000 with xsdb mrd.
#
# Sequence (order matters -- the core must never fetch from uninitialised DDR):
#   1. connect, confirm the JTAG chain and xck26 IDCODE
#   2. halt APU so nothing else writes our DDR window, then run the FULL psu_init
#   3. program the PL bitstream, remove PS-PL isolation
#   4. confirm the control slave MAGIC, and that the core is still in reset
#   5. load kernel -> DDR 0x10200000 (core 0x80200000 -- the rv64 link/reset
#      address), FAT32 ramdisk -> DDR 0x18000000 (core 0x88000000)
#   5b. ZERO .BSS (kernel+0x5000, 27 pages) -- real DDR4 is garbage; the kernel
#       assumes zero .bss (g_heap_off at kernel+0x8008) and every allocation
#       fails otherwise (the rv32 lane's canary-only park)
#   6. release the core (CTRL bit0)
#   7. poll UART_COUNT and dump the capture buffer
#
# The FULL psu_init in step 2 is MANDATORY, not optional. Skipping it (and doing
# only psu_ps_pl_isolation_removal) leaves the PS-PL interfaces and the
# AXI-HP/HPM ports unconfigured: the control slave then reads back 0x00000000
# for every register except the single-bit CTRL flip-flop, and the soft-core
# never completes its first instruction fetch. This cost a long rv32 debug
# session -- do not "optimise" it away.
#
# WEDGED-PS LANDMINE (2026-07-26): if EVERYTHING here reports success
# (CTRL_MAGIC OK, loads verified, BSS zeroed, CORE_RELEASED, CTRL reads back 1)
# but AXI_READS/AXI_WRITES stay at 0 and UART_BYTE_COUNT=0 -- the core is out
# of reset but its very first HP0 fetch never completes -- the PS is in a
# wedged state left by a previous session whose bitstream/psu_init did not use
# the HP AXI ports (e.g. the BRAM-only tiny lane). Full psu_init does NOT
# recover it. Fix proven on silicon: xsdb `targets PSU; rst -system`, wait,
# then re-run this whole script. The rv32-DDR lane reproduced the identical
# zero-fetch signature and both lanes returned to TEST PASSED after rst -system.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

VIVADO_SETTINGS="${VIVADO_SETTINGS:-$HOME/Xilinx/2025.2/Vivado/settings64.sh}"
BUILD_DIR="build/fpga/k26_rv64_ddr"
BIT="${BIT:-$BUILD_DIR/k26_rv64_ddr.bit}"
XSA="${XSA:-$BUILD_DIR/k26_rv64_ddr.xsa}"
KERNEL_ELF="${KERNEL_ELF:-build/os/simpleos_riscv64_smf_fs.elf}"
FAT32_IMG="${FAT32_IMG:-build/os/fat32-riscv64.img}"
RAMDISK_BYTES="${RAMDISK_BYTES:-1048576}"
OBJCOPY="${OBJCOPY:-riscv64-unknown-elf-objcopy}"
OUT_DIR="$BUILD_DIR/bringup"
# DDR placement -- must match G_DDR_BASE in soc_top_rv64_k26_ddr.vhd.
# The adapter remaps core 0x80000000 -> 0x10000000; the rv64 kernel is linked
# at core 0x80200000, so its binary lands at DDR 0x10200000.
DDR_KERNEL="${DDR_KERNEL:-0x10200000}"
DDR_RAMDISK="${DDR_RAMDISK:-0x18000000}"
CTRL_BASE="${CTRL_BASE:-0xA0000000}"
POLL_SECONDS="${POLL_SECONDS:-60}"

[ -f "$VIVADO_SETTINGS" ] || { echo "FAIL: vivado settings missing $VIVADO_SETTINGS"; exit 1; }
[ -f "$BIT" ] || { echo "FAIL: bitstream missing: $BIT (run build_k26_rv64_ddr_bitstream.shs)"; exit 1; }
[ -f "$KERNEL_ELF" ] || { echo "FAIL: kernel ELF missing: $KERNEL_ELF"; exit 1; }
[ -f "$FAT32_IMG" ] || { echo "FAIL: FAT32 image missing: $FAT32_IMG"; exit 1; }

# shellcheck disable=SC1090
. "$VIVADO_SETTINGS"
mkdir -p "$OUT_DIR"

echo "=== preparing DDR payloads ==="
"$OBJCOPY" -O binary "$KERNEL_ELF" "$OUT_DIR/kernel.bin"
head -c "$RAMDISK_BYTES" "$FAT32_IMG" > "$OUT_DIR/ramdisk.bin"
echo "  kernel.bin  $(stat -c%s "$OUT_DIR/kernel.bin") bytes -> $DDR_KERNEL"
echo "  ramdisk.bin $(stat -c%s "$OUT_DIR/ramdisk.bin") bytes -> $DDR_RAMDISK"

# psu_init.tcl (for full PS init + PS-PL isolation removal) lives inside the XSA.
PSU_INIT=""
if [ -f "$XSA" ]; then
    rm -rf "$OUT_DIR/xsa"; mkdir -p "$OUT_DIR/xsa"
    if unzip -o -q "$XSA" -d "$OUT_DIR/xsa" 2>/dev/null; then
        PSU_INIT="$(find "$OUT_DIR/xsa" -name 'psu_init.tcl' | head -1)"
    fi
fi
[ -n "$PSU_INIT" ] && echo "  psu_init.tcl: $PSU_INIT" || echo "  psu_init.tcl: not found (bring-up will very likely fail)"

if ! pgrep -f '[h]w_server' >/dev/null 2>&1; then
    echo "=== starting hw_server ==="
    nohup hw_server -d > "$OUT_DIR/hw_server.log" 2>&1 &
    sleep 5
fi

# .bss zero-fill image (belt-and-suspenders since 2026-07-26: the kernel now
# self-zeroes .bss in _start/crt0, so this loader step is redundant-but-kept).
# History: un-zeroed real DDR4 leaves g_heap_off trash so EVERY allocation
# fails (canary-only park -- the exact rv32 silicon failure mode).
#
# Span/probe offsets are ELF-derived at run time (hardcoded offsets go stale
# on any relink and a stale span would CORRUPT loaded .data — see the rv32
# script). Offsets are relative to the rv64 kernel core base 0x80200000.
# SKIP_BSS_ZERO=1 skips the dow (crt0 self-zero silicon proof).
NM_TOOL="${NM_TOOL:-riscv64-unknown-elf-nm}"
command -v "$NM_TOOL" >/dev/null 2>&1 || NM_TOOL=llvm-nm
SBSS_HEX=$("$NM_TOOL" "$KERNEL_ELF" | awk '$3=="_sbss"{print $1}')
EBSS_HEX=$("$NM_TOOL" "$KERNEL_ELF" | awk '$3=="_ebss"{print $1}')
HEAPOFF_HEX=$("$NM_TOOL" "$KERNEL_ELF" | awk '$3=="g_heap_off"{print $1}')
[ -n "$SBSS_HEX" ] && [ -n "$EBSS_HEX" ] || { echo "FAIL: _sbss/_ebss not found in $KERNEL_ELF"; exit 1; }
BSS_OFF=$(( 0x$SBSS_HEX - 0x80200000 ))
BSS_PAGES=$(( ( 0x$EBSS_HEX - 0x$SBSS_HEX + 4095 ) / 4096 ))
if [ -n "$HEAPOFF_HEX" ]; then HEAPOFF_OFF=$(( 0x$HEAPOFF_HEX - 0x80200000 )); else HEAPOFF_OFF=$BSS_OFF; fi
SKIP_BSS_ZERO="${SKIP_BSS_ZERO:-0}"
printf '  .bss: kernel+0x%x, %d pages; heap-off probe kernel+0x%x; skip_zero=%s\n' \
  "$BSS_OFF" "$BSS_PAGES" "$HEAPOFF_OFF" "$SKIP_BSS_ZERO"
dd if=/dev/zero of="$OUT_DIR/bss_zeros.bin" bs=4096 count="$BSS_PAGES" 2>/dev/null

cat > "$OUT_DIR/bringup.tcl" <<TCL
set bit          "$ROOT_DIR/$BIT"
set kernel_bin   "$ROOT_DIR/$OUT_DIR/kernel.bin"
set ramdisk_bin  "$ROOT_DIR/$OUT_DIR/ramdisk.bin"
set psu_init     "$PSU_INIT"
set ddr_kernel   $DDR_KERNEL
set ddr_ramdisk  $DDR_RAMDISK
set ctrl         $CTRL_BASE
set poll_seconds $POLL_SECONDS

connect

# ---- 1. board identity -------------------------------------------------
puts "BOARD_JTAG_CHAIN_BEGIN"
puts [jtag targets]
puts "BOARD_JTAG_CHAIN_END"

# ---- 2. halt the APU so nothing else writes our DDR window -------------
catch { targets -set -nocase -filter {name =~ "*Cortex-A53 #0*"} ; stop ; puts "APU_HALTED" } e
if {[info exists e] && \$e ne ""} { puts "APU_HALT_NOTE:\$e" }

# Reset ALL A53 cores: U-Boot ran before we halted, so the A53 caches can hold
# dirty lines covering our DDR window; a later eviction would overwrite the
# DAP-loaded image with stale bytes (patchy per-64B-line corruption). Core
# reset INVALIDATES the caches, discarding dirty lines.
foreach n {0 1 2 3} {
  # separate catches: "Already stopped" from stop must NOT abort the rst
  catch { targets -set -nocase -filter "name =~ \\"*Cortex-A53 #\$n*\\"" }
  catch { stop } se
  if {[catch { rst -processor } re]} {
    puts "A53_\${n}_RESET_NOTE:\$re"
  } else {
    puts "A53_\${n}_RESET_CACHES_INVALIDATED"
  }
}

# ---- 2b. FULL psu_init: configures PS clocks and the PS-PL AXI ports ----
# Without this the PL is configured but unreachable/dead (see header note).
targets -set -nocase -filter {name =~ "*PSU*"}
if {\$psu_init ne "" && [file exists \$psu_init]} {
  source \$psu_init
  if {[catch { psu_init } e]} { puts "PSU_INIT_ERR:\$e" } else { puts "PSU_INIT_DONE" }
  after 1000
} else {
  puts "PSU_INIT_MISSING -- bring-up will very likely fail"
}

# ---- 3. program the PL -------------------------------------------------
targets -set -nocase -filter {name =~ "*PL*"}
puts "PROGRAMMING_BITSTREAM \$bit"
if {[catch { fpga -file \$bit } e]} { puts "FPGA_PROGRAM_FAIL:\$e"; exit 1 }
puts "PROGRAM_HW_DEVICES_DONE"
after 500

targets -set -nocase -filter {name =~ "*PSU*"}
if {\$psu_init ne "" && [file exists \$psu_init]} {
  if {[catch {
    source \$psu_init
    catch { psu_ps_pl_isolation_removal ; puts "PS_PL_ISOLATION_REMOVED" }
    catch { psu_ps_pl_reset_config ; puts "PS_PL_RESET_CONFIGURED" }
  } e]} { puts "PSU_INIT_NOTE:\$e" }
}
after 500

# ---- 4. control slave reachable, core still held in reset --------------
# MAGIC still reads "RV32" (0x52563332): the rv64 top reuses rv32_ctrl_obs_slave
# unchanged; the constant proves slave reachability, not core width.
if {[catch { set magic [lindex [mrd -force -value [expr {\$ctrl + 0x24}] 1] 0] } e]} {
  puts "CTRL_READ_FAIL:\$e"; exit 1
}
puts [format "CTRL_MAGIC=0x%08X" \$magic]
if {\$magic != 0x52563332} {
  puts "CTRL_MAGIC_MISMATCH -- PL not configured or AXI path blocked"; exit 1
}
set prerun [lindex [mrd -force -value [expr {\$ctrl + 0x1C}] 1] 0]
puts "PRERUN_AXI_READS=\$prerun"
if {\$prerun != 0} { puts "WARN_CORE_ALREADY_RAN" }

# ---- 5. load DDR -------------------------------------------------------
puts "LOADING_KERNEL -> \$ddr_kernel"
if {[catch { dow -data \$kernel_bin \$ddr_kernel } e]} { puts "KERNEL_LOAD_FAIL:\$e"; exit 1 }
puts "LOADING_RAMDISK -> \$ddr_ramdisk"
if {[catch { dow -data \$ramdisk_bin \$ddr_ramdisk } e]} { puts "RAMDISK_LOAD_FAIL:\$e"; exit 1 }

# verify the first words actually landed
puts [format "DDR_KERNEL_WORD0=0x%08X" [lindex [mrd -force -value \$ddr_kernel 1] 0]]
puts [format "DDR_RAMDISK_WORD0=0x%08X" [lindex [mrd -force -value \$ddr_ramdisk 1] 0]]
# verify a banner rodata word deep in the image (kernel+0x3130 holds "=== " of
# "=== SimpleOS RV64 smoke boot ===", expect 0x203D3D3D): if THIS is wrong the
# A53-cache-eviction coherency fix did not hold.
puts [format "DDR_BANNER_WORD=0x%08X" [lindex [mrd -force -value [expr {\$ddr_kernel + 0x3130}] 1] 0]]

# ---- 5b. zero .bss (belt-and-suspenders; kernel crt0 also self-zeroes) ---
# Offsets are ELF-derived by the shell wrapper (see bss_zeros.bin generation).
# SKIP_BSS_ZERO=1 leaves .bss as garbage to prove the crt0 loop on silicon.
puts [format "BSS_HEAPOFF_PRE=0x%08X" [lindex [mrd -force -value [expr {\$ddr_kernel + $HEAPOFF_OFF}] 1] 0]]
if {"$SKIP_BSS_ZERO" ne "1"} {
    set bss_zeros "$ROOT_DIR/$OUT_DIR/bss_zeros.bin"
    puts "ZEROING_BSS -> [format 0x%08X [expr {\$ddr_kernel + $BSS_OFF}]]"
    if {[catch { dow -data \$bss_zeros [expr {\$ddr_kernel + $BSS_OFF}] } e]} { puts "BSS_ZERO_FAIL:\$e"; exit 1 }
} else {
    puts "BSS_ZERO_SKIPPED (crt0 self-zero proof)"
}
puts [format "BSS_HEAPOFF_POST=0x%08X" [lindex [mrd -force -value [expr {\$ddr_kernel + $HEAPOFF_OFF}] 1] 0]]

# ---- 6. release the core ----------------------------------------------
mwr -force \$ctrl 0x1
puts "CORE_RELEASED"

# ---- 7. poll the transcript -------------------------------------------
set deadline [expr {[clock seconds] + \$poll_seconds}]
set last -1
set stable 0
while {[clock seconds] < \$deadline} {
  set n [lindex [mrd -force -value [expr {\$ctrl + 0x04}] 1] 0]
  if {\$n == \$last} { incr stable } else { set stable 0 ; set last \$n }
  if {\$stable > 8 && \$n > 0} { break }
  after 500
}
set count \$last
puts "UART_BYTE_COUNT=\$count"
# Observation registers carry the LOW 32 BITS of the 64-bit core state (the
# rv64 map fits under 4 GB; documented truncation in soc_top_rv64_k26_ddr).
puts [format "FINAL_PC_LO32=0x%08X"  [lindex [mrd -force -value [expr {\$ctrl + 0x08}] 1] 0]]
puts [format "FINAL_INS=0x%08X"      [lindex [mrd -force -value [expr {\$ctrl + 0x0C}] 1] 0]]
puts [format "FINAL_A0_LO32=0x%08X"  [lindex [mrd -force -value [expr {\$ctrl + 0x10}] 1] 0]]
puts [format "FINAL_SP_LO32=0x%08X"  [lindex [mrd -force -value [expr {\$ctrl + 0x14}] 1] 0]]
puts [format "AXI_READS=%d"          [lindex [mrd -force -value [expr {\$ctrl + 0x1C}] 1] 0]]
puts [format "AXI_WRITES=%d"         [lindex [mrd -force -value [expr {\$ctrl + 0x20}] 1] 0]]

if {\$count > 0} {
  set words [expr {(\$count + 3) / 4}]
  set data [mrd -force -value [expr {\$ctrl + 0x8000}] \$words]
  set txt ""
  set i 0
  foreach w \$data {
    for {set b 0} {\$b < 4} {incr b} {
      if {\$i >= \$count} { break }
      set c [expr {(\$w >> (8*\$b)) & 0xFF}]
      if {\$c == 10} { append txt "\n" } elseif {\$c >= 32 && \$c < 127} { append txt [format %c \$c] }
      incr i
    }
  }
  puts "TRANSCRIPT_BEGIN"
  puts \$txt
  puts "TRANSCRIPT_END"
} else {
  puts "TRANSCRIPT_EMPTY -- core produced no UART bytes"
}
disconnect
TCL

echo "=== running board bring-up ==="
xsdb "$OUT_DIR/bringup.tcl" 2>&1 | tee "$OUT_DIR/bringup.log"

echo
echo "=== verdict ==="
if grep -q "TEST PASSED" "$OUT_DIR/bringup.log"; then
    echo "PASS: rv64 SimpleOS reached TEST PASSED on KV260 silicon"
    exit 0
fi
if grep -q "SimpleOS RV64 boot OK" "$OUT_DIR/bringup.log"; then
    echo "PARTIAL: core booted (boot marker seen) but did not reach TEST PASSED"
    exit 2
fi
echo "NO OS MARKERS OBSERVED -- see $OUT_DIR/bringup.log for what the core did do"
exit 3
