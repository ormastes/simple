#!/bin/sh
# Generated-product Sv32 -> final PMP -> Wishbone evidence.  No source generation.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
rtl=${1:-"$root/build/vhdl/rv32"}
work="$root/build/ghdl/rv32_product_sv32_pmp"
tb="$root/test/01_unit/lib/hardware/fpga_linux/rv32_product_sv32_pmp_ghdl"
gcc=${RV32_GCC:-riscv64-unknown-elf-gcc}
objcopy=${RV32_OBJCOPY:-riscv64-unknown-elf-objcopy}
command -v ghdl >/dev/null 2>&1 || { echo "FAIL: ghdl not found"; exit 1; }
command -v "$gcc" >/dev/null 2>&1 || { echo "FAIL: RV32 GCC not found: $gcc"; exit 1; }
command -v "$objcopy" >/dev/null 2>&1 || { echo "FAIL: RV32 objcopy not found: $objcopy"; exit 1; }
for f in core32_protected_product.vhd rv32imac_core_product_wb.vhd; do
  [ -s "$rtl/$f" ] || { echo "FAIL: generated product missing: $rtl/$f"; exit 1; }
done
grep -q 'entity core32_protected_product_entry is' "$rtl/core32_protected_product.vhd" || { echo "FAIL: invalid generated product core"; exit 1; }
grep -q 'entity rv32imac_core_product_wb is' "$rtl/rv32imac_core_product_wb.vhd" || { echo "FAIL: invalid generated product wrapper"; exit 1; }
rm -rf "$work"; mkdir -p "$work"
"$gcc" -march=rv32imac_zicsr -mabi=ilp32 -nostdlib -Wl,-Ttext=0 -Wl,-e,_start -o "$work/rv32_product_sv32_pmp.elf" "$tb/rv32_product_sv32_pmp.S"
"$objcopy" -O binary "$work/rv32_product_sv32_pmp.elf" "$work/rv32_product_sv32_pmp.bin"
od -An -v -tx4 -w4 --endian=little "$work/rv32_product_sv32_pmp.bin" | tr -d ' ' >"$work/rv32_product_sv32_pmp.mem"
ghdl -a --std=08 --workdir="$work" "$rtl/core32_protected_product.vhd"
ghdl -a --std=08 --workdir="$work" "$rtl/rv32imac_core_product_wb.vhd"
ghdl -a --std=08 --workdir="$work" "$tb/tb_rv32_product_sv32_pmp.vhd"
ghdl -e --std=08 --workdir="$work" tb_rv32_product_sv32_pmp
log="$work/sim.log"
if ! (cd "$work" && ghdl -r --std=08 --workdir="$work" tb_rv32_product_sv32_pmp --stop-time=20us) >"$log" 2>&1; then tail -40 "$log"; exit 1; fi
grep -q RV32_PRODUCT_SV32_PMP_GHDL_PASS "$log" || { tail -40 "$log"; exit 1; }
echo RV32_PRODUCT_SV32_PMP_GHDL_PASS
