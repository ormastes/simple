#!/usr/bin/env bash
# build_rv32_debug_bitstream.shs — reproducible build of the rv32 DEBUG bitstream
# (soc_top_rv32 with G_DEBUG_JTAG=true) for the Kria KV260. This is the bitstream
# whose BSCANE2 USER4 tunnel gives the on-silicon JTAG-MMIO readout used by
# read_rv32_core_jtag.shs. It bakes the soak payload ROM the same way as the
# golden bit; only the JTAG debug back-end (src/lib/hardware/debug/*.vhd) is added.
#
# Was previously an orphaned TCL in build/fpga/k26_rv32_debug/ (not tracked); this
# committed wrapper regenerates the RTL, writes the TCL, and runs ONE Vivado
# synth+impl (~30-60 min, ~20-60 GB RAM — run only one Vivado at a time).
#
# Proven result (2026-07-24): routed timing MET, WNS +15.68 ns; inner TAP IDCODE
# 0x15350067 reachable; 981 s soak read out entirely over this tunnel, no UART.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

VIVADO_SETTINGS="${VIVADO_SETTINGS:-$HOME/Xilinx/2025.2/Vivado/settings64.sh}"
BUILD_DIR="build/fpga/k26_rv32_debug"
OUT_BIT="build/build/rv32_fpga_debug/gateware/rv32_fpga_debug.bit"
SYNTH_ONLY="0"
[ "${1:-}" = "--synth-only" ] && SYNTH_ONLY="1"

[ -f "$VIVADO_SETTINGS" ] || { echo "FAIL: vivado settings missing $VIVADO_SETTINGS"; exit 1; }
if pgrep -f 'lnx64.o/vivado' >/dev/null 2>&1; then
    echo "FAIL: a Vivado is already running (serialize: exactly one at a time)"; exit 1
fi
# shellcheck disable=SC1090
. "$VIVADO_SETTINGS"

echo "=== regenerating rv32 RTL (soc_top_rv32.vhd + rv32_exec_core.vhd) ==="
sh scripts/fpga/generate_rv32_vhdl.shs
for f in build/vhdl/rv32/soc_top_rv32.vhd build/vhdl/rv32/rv32_exec_core.vhd; do
    [ -s "$f" ] || { echo "FAIL: generated RTL missing: $f"; exit 1; }
done

mkdir -p "$BUILD_DIR"
cat > "$BUILD_DIR/k26_debug.xdc" <<'XDC'
set_property PACKAGE_PIN H12 [get_ports uart_tx]
set_property IOSTANDARD LVCMOS33 [get_ports uart_tx]
create_clock -name cfgmclk -period 20.000 [get_pins u_startup/CFGMCLK]
set_false_path -to [get_ports uart_tx]
XDC

cat > "$BUILD_DIR/build_rv32_debug.tcl" <<TCL
set synth_only $SYNTH_ONLY
create_project k26_rv32_dbg $BUILD_DIR/k26_rv32_dbg -part xck26-sfvc784-2lv-c -force
add_files [list \\
  build/vhdl/rv32/soc_top_rv32.vhd build/vhdl/rv32/rv32_exec_core.vhd \\
  src/lib/hardware/debug/jtag_tap.vhd src/lib/hardware/debug/riscv_dtm.vhd src/lib/hardware/debug/dmi_bus.vhd \\
  src/lib/hardware/debug/debug_registers.vhd src/lib/hardware/debug/riscv_debug_module.vhd \\
  src/lib/hardware/debug/sba_test_mem.vhd src/lib/hardware/debug/hart_core_glue.vhd \\
  src/lib/hardware/debug/jtag_debug_chain.vhd src/lib/hardware/debug/bscane2_tap_bridge.vhd ]
add_files -fileset constrs_1 $BUILD_DIR/k26_debug.xdc
set_property top soc_top_rv32 [current_fileset]
set_property generic {G_DEBUG_JTAG=true} [current_fileset]
update_compile_order -fileset sources_1
launch_runs synth_1 -jobs 8
wait_on_run synth_1
if {[get_property PROGRESS [get_runs synth_1]] != "100%"} { puts "SYNTH_FAILED"; exit 5 }
open_run synth_1
report_utilization -file $BUILD_DIR/util_synth.rpt
report_timing_summary -file $BUILD_DIR/timing_synth.rpt
puts "SYNTH_WNS=[get_property STATS.WNS [get_runs synth_1]]"
if {\$synth_only} { puts "SYNTH_ONLY_DONE"; exit 0 }
launch_runs impl_1 -to_step write_bitstream -jobs 8
wait_on_run impl_1
if {[get_property PROGRESS [get_runs impl_1]] != "100%"} { puts "IMPL_FAILED"; exit 6 }
open_run impl_1
report_timing_summary -file $BUILD_DIR/timing_routed.rpt
report_utilization -file $BUILD_DIR/util_routed.rpt
set wns [get_property STATS.WNS [get_runs impl_1]]
set whs [get_property STATS.WHS [get_runs impl_1]]
puts "IMPL_WNS=\$wns IMPL_WHS=\$whs"
if {\$wns < 0.0 || \$whs < 0.0} { puts "TIMING_NOT_MET"; exit 3 }
file mkdir [file dirname $OUT_BIT]
file copy -force $BUILD_DIR/k26_rv32_dbg/k26_rv32_dbg.runs/impl_1/soc_top_rv32.bit $OUT_BIT
puts "BITSTREAM_WRITTEN=$OUT_BIT"
TCL

echo "=== running ONE Vivado build (G_DEBUG_JTAG=true) ==="
vivado -mode batch -source "$BUILD_DIR/build_rv32_debug.tcl" \
    -journal "$BUILD_DIR/vivado.jou" -log "$BUILD_DIR/vivado.log" 2>&1 | tail -40

if [ "$SYNTH_ONLY" = "1" ]; then
    grep -E 'SYNTH_WNS|SYNTH_ONLY_DONE' "$BUILD_DIR/vivado.log" || true
    exit 0
fi
[ -f "$OUT_BIT" ] && echo "SUCCESS: debug bitstream at $OUT_BIT" || { echo "FAIL: no bitstream; see $BUILD_DIR/vivado.log"; exit 4; }
