#!/bin/sh
# Generated-product Sv39 -> final PMP -> Wishbone evidence; never substitutes a stub core.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
rtl=${1:-"$root/build/vhdl/rv64"}
work="$root/build/ghdl/rv64_product_sv39_pmp"
fixture="$root/test/01_unit/lib/hardware/fpga_linux/rv64_product_sv39_pmp_ghdl/rv64_product_sv39_pmp.S"
tb="$root/test/01_unit/lib/hardware/fpga_linux/rv64_product_sv39_pmp_ghdl/tb_rv64_product_sv39_pmp.vhd"
runner="$root/scripts/fpga/ghdl_rv64_product_sv39_pmp.shs"
gcc=${RV64_GCC:-riscv64-unknown-elf-gcc}
objcopy=${RV64_OBJCOPY:-riscv64-unknown-elf-objcopy}
. "$root/scripts/check/riscv-fpga-preflight-common.shs"

command -v "$gcc" >/dev/null 2>&1 || { echo "FAIL: riscv64-unknown-elf-gcc not found"; exit 1; }
command -v "$objcopy" >/dev/null 2>&1 || { echo "FAIL: riscv64-unknown-elf-objcopy not found"; exit 1; }
command -v ghdl >/dev/null 2>&1 || { echo "FAIL: ghdl not found"; exit 1; }
for f in rv64imac_core_product.vhd rv64imac_core_product_wb.vhd; do
  [ -s "$rtl/$f" ] || { echo "FAIL: generated $f is required; no stub is allowed"; exit 1; }
done

rm -rf "$work"; mkdir -p "$work"
"$gcc" -march=rv64imac_zicsr -mabi=lp64 -mno-relax -nostdlib -nostartfiles \
  -Wl,-Ttext=0x80000000,-e,_start -o "$work/program.elf" "$fixture"
"$objcopy" -O binary "$work/program.elf" "$work/program.bin"
od -An -v -tx1 "$work/program.bin" | awk -v base=2147483648 '
  BEGIN { offset = 0 }
  { for (i = 1; i <= NF; i++) { printf "%016X %s\n", base + offset, $i; offset++ } }
' >"$work/program.hex"
[ -s "$work/program.hex" ] || { echo "FAIL: empty RV64IMAC program image"; exit 1; }

ghdl -a --std=08 --workdir="$work" "$rtl/rv64imac_core_product.vhd"
ghdl -a --std=08 --workdir="$work" "$rtl/rv64imac_core_product_wb.vhd"
ghdl -a --std=08 --workdir="$work" "$tb"
ghdl -e --std=08 --workdir="$work" tb_rv64_product_sv39_pmp
sim_log="$work/sim.log"
if ! ghdl -r --std=08 --workdir="$work" tb_rv64_product_sv39_pmp \
    -gPROGRAM_HEX="$work/program.hex" --stop-time=100us >"$sim_log" 2>&1; then
  tail -40 "$sim_log"
  exit 1
fi
grep -q RV64_PRODUCT_SV39_PMP_GHDL_PASS "$sim_log"
digest="$(preflight_input_digest "$rtl/rv64imac_core_product.vhd" "$rtl/rv64imac_core_product_wb.vhd" "$tb" "$fixture" "$runner")"
printf 'PRODUCT_INPUT_SHA256=%s\n' "$digest" >>"$sim_log"
printf '%s\n' "$digest" >"$work/provenance.sha256"
echo "RV64_PRODUCT_SV39_PMP_GHDL_PASS"
