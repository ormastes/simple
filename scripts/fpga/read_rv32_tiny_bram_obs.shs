#!/usr/bin/env bash
# read_rv32_tiny_bram_obs.shs — on-silicon readout of the BRAM-only TINY rv32
# SimpleOS SoC (soc_top_rv32_tiny_bram) on a Kria KV260, over Vivado hw_jtag
# through the BSCANE2 USER4 observation DR (scripts/fpga/jtag_obs_tunnel.tcl).
#
# Requires the tiny-BRAM bitstream programmed (build_rv32_tiny_bram_bitstream.shs
# + program_kv260_bitstream.shs). TCK is pinned at the proven 1 MHz.
#
# Modes:
#   status      (default) — magic, status (pass/fail flags + UART byte count),
#                pc, cycle counter twice (liveness: values must differ).
#   transcript  — status, then read the whole UART capture buffer and decode it
#                to text; prints the marker lines seen ON SILICON.
#   reset       — pulse the soft reset (re-runs the boot), then status.
# All raw tunnel output is persisted under build/fpga/jtag_readout/.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

MODE="${1:-status}"
VIVADO_SETTINGS="${VIVADO_SETTINGS:-$HOME/Xilinx/2025.2/Vivado/settings64.sh}"
HW_SERVER="${HW_SERVER:-$HOME/Xilinx/2025.2/Vivado/bin/hw_server}"
OUT_DIR="${OUT_DIR:-build/fpga/jtag_readout}"
STAMP="$(date +%Y%m%d_%H%M%S)"
LOG="$OUT_DIR/tiny_bram_${MODE}_${STAMP}.log"
TCL="$ROOT_DIR/scripts/fpga/jtag_obs_tunnel.tcl"

mkdir -p "$OUT_DIR"
[ -f "$VIVADO_SETTINGS" ] || { echo "FAIL: vivado settings missing $VIVADO_SETTINGS"; exit 1; }
# shellcheck disable=SC1090
. "$VIVADO_SETTINGS"
if ! (command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q ':3121'); then
    "$HW_SERVER" -d >/dev/null 2>&1 || true
    sleep 2
fi

run_tunnel() { # $@ = 32-bit hex commands; appends to $LOG, echoes OBS lines
    vivado -mode batch -nojournal -nolog -notrace -source "$TCL" -tclargs "$@" 2>&1 \
      | tee -a "$LOG" | grep -E 'ALIGN_|OBS[0-9]+ |FREQ=|ALIGN_FAILED|RAW_PROBE' || true
}

echo "== rv32 tiny-BRAM obs readout ($MODE @ $STAMP) ==" | tee -a "$LOG"

case "$MODE" in
  status)
    run_tunnel 00000000 00000001 00000002 00000007 00000007 00000009
    ;;
  reset)
    run_tunnel 5AFE000F 00000000 00000001
    echo "(soft reset pulsed; boot re-runs; call 'status' again after ~2s)" | tee -a "$LOG"
    ;;
  transcript)
    out="$(run_tunnel 00000000 00000001 00000002)"
    echo "$out"
    st="$(echo "$out" | grep -E 'OBS1 CMD=00000001' | sed 's/.*DATA=\([0-9a-f]*\).*/\1/' | head -1)"
    [ -n "$st" ] || { echo "FAIL: no status readback (see $LOG)"; exit 1; }
    cnt=$((0x$st & 0xffffff))
    pass=$(( (0x$st >> 31) & 1 ))
    fail=$(( (0x$st >> 30) & 1 ))
    echo "STATUS: uart_bytes=$cnt pass_seen=$pass fail_seen=$fail" | tee -a "$LOG"
    [ "$cnt" -gt 0 ] || { echo "FAIL: UART byte count is 0 — core produced no output"; exit 1; }
    max=$((8192)); [ "$cnt" -lt "$max" ] && max=$cnt
    words=$(( (max + 3) / 4 ))
    echo "reading $words capture-buffer words ..." | tee -a "$LOG"
    : > "$OUT_DIR/tiny_bram_transcript_${STAMP}.txt"
    w=0
    while [ "$w" -lt "$words" ]; do
        chunk=""
        n=0
        while [ "$n" -lt 128 ] && [ "$w" -lt "$words" ]; do
            chunk="$chunk $(printf '%04x0003' "$w")"
            w=$((w + 1)); n=$((n + 1))
        done
        # shellcheck disable=SC2086
        run_tunnel $chunk | grep -E 'OBS[0-9]+ CMD=[0-9a-f]{4}0003' \
          | sed 's/.*DATA=\([0-9a-f]*\).*/\1/' \
          | while read -r hx; do
              for i in 0 1 2 3; do
                  b=$(( (0x$hx >> (8 * i)) & 0xff ))
                  [ "$b" -ge 32 ] || [ "$b" -eq 10 ] || continue
                  printf "\\$(printf '%03o' "$b")"
              done
            done >> "$OUT_DIR/tiny_bram_transcript_${STAMP}.txt"
    done
    echo "----- ON-SILICON UART transcript -----" | tee -a "$LOG"
    tee -a "$LOG" < "$OUT_DIR/tiny_bram_transcript_${STAMP}.txt"
    echo "" | tee -a "$LOG"
    echo "--------------------------------------" | tee -a "$LOG"
    echo "transcript=$OUT_DIR/tiny_bram_transcript_${STAMP}.txt" | tee -a "$LOG"
    ;;
  *) echo "usage: $0 [status|transcript|reset]"; exit 2;;
esac
echo "log=$LOG"
