#!/bin/sh
# GHDL rehearsal of the REAL KV260 silicon bring-up path for rv64 SimpleOS.
# Direct mirror of ghdl_rv32_k26_ddr_boot.shs (the rv32 lane that preceded the
# rv32 silicon PASS), widened to the 64-bit core/adapter.
#
# ghdl_rv64_simpleos_boot_axi.shs proves the CORE against a behavioral slave
# wired straight to its mem_* port. This lane goes one level further out and
# drives soc_top_rv64_k26_ddr -- the actual PL top that gets synthesized --
# so it exercises the two blocks that only matter on silicon:
#
#   * rv64_axi4_mem_adapter: mem_* (64-bit) -> full AXI4 (AW/W/B/AR/R),
#     including the address remap from the core's 0x80200000/0x88000000 into
#     the PS DDR aperture. On ZynqMP 0x80000000+ is NOT memory, so a boot here
#     only succeeds if that remap is correct.
#   * rv32_ctrl_obs_slave (reused unchanged): the AXI4-Lite control/observation
#     path. The transcript printed below is recovered by POLLING that slave
#     over AXI-Lite -- byte for byte the same procedure xsdb uses on the board.
#
# The AXI slave model injects varying wait-states (1..4) on both channels.
#
# NO Vivado. GHDL simulation only.
set -e
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

RTL_DIR="$ROOT_DIR/examples/09_embedded/fpga_riscv/rtl"
WORK_DIR="$ROOT_DIR/build/ghdl/rv64_k26_ddr_boot"
KERNEL_ELF="${KERNEL_ELF:-$ROOT_DIR/build/os/simpleos_riscv64_smf_fs.elf}"
FAT32_IMG="${FAT32_IMG:-$ROOT_DIR/build/os/fat32-riscv64.img}"
RAMDISK_BYTES="${RAMDISK_BYTES:-1048576}"
OBJCOPY="${OBJCOPY:-riscv64-unknown-elf-objcopy}"
# Core-side flat base: the adapter remaps core 0x80000000 -> DDR_BASE, and the
# rv64 kernel is linked at 0x80200000, so the flat image gets a 2 MB front pad.
RAM_BASE=$((0x80000000))

command -v ghdl >/dev/null 2>&1 || { echo "ERROR: ghdl not found in PATH"; exit 1; }
[ -f "$KERNEL_ELF" ] || { echo "ERROR: kernel ELF missing: $KERNEL_ELF"; exit 1; }
[ -f "$FAT32_IMG" ] || { echo "ERROR: FAT32 image missing: $FAT32_IMG"; exit 1; }

mkdir -p "$WORK_DIR"
echo "=== GHDL rv64 SimpleOS boot through the K26 DDR PL top (AXI4 + AXI-Lite) ==="
echo "  Kernel ELF:  $KERNEL_ELF"
echo "  Ramdisk img: $FAT32_IMG (first $RAMDISK_BYTES bytes -> core 0x88000000)"

# Flatten loadable PROGBITS; zero-pad the front by (lowest_LMA - RAM_BASE) so
# the kernel lands at its linked address inside the DDR model. 64-bit LE words.
"$OBJCOPY" -O binary "$KERNEL_ELF" "$WORK_DIR/kernel.bin"
LOW_LMA=$(riscv64-unknown-elf-readelf -l "$KERNEL_ELF" \
  | awk '/LOAD/ {print strtonum($3); exit}')
PAD=$(( LOW_LMA - RAM_BASE ))
echo "  Lowest LMA: $(printf 0x%x "$LOW_LMA")  front zero-pad: $PAD bytes"
[ "$PAD" -ge 0 ] || { echo "ERROR: lowest LMA below RAM base"; exit 1; }
head -c "$PAD" /dev/zero > "$WORK_DIR/flat.bin"
cat "$WORK_DIR/kernel.bin" >> "$WORK_DIR/flat.bin"
TAIL=$(( 8 - ( $(wc -c < "$WORK_DIR/flat.bin") % 8 ) ))
[ "$TAIL" -eq 8 ] || head -c "$TAIL" /dev/zero >> "$WORK_DIR/flat.bin"
od -An -v -tx8 -w8 "$WORK_DIR/flat.bin" | awk 'NF{print $1}' > "$WORK_DIR/rv64_flat.mem"
echo "  Kernel image:  $(wc -l < "$WORK_DIR/rv64_flat.mem") words"

head -c "$RAMDISK_BYTES" "$FAT32_IMG" > "$WORK_DIR/rv64_ramdisk.img"
od -An -v -tx8 -w8 "$WORK_DIR/rv64_ramdisk.img" | awk 'NF{print $1}' > "$WORK_DIR/rv64_ramdisk.mem"
echo "  Ramdisk image: $(wc -l < "$WORK_DIR/rv64_ramdisk.mem") words"

printf "  Analysing PL top + adapter + control slave + testbench ... "
out="$(ghdl -a --std=08 --workdir="$WORK_DIR" \
  "$RTL_DIR/rv64_exec_core_axi.vhd" \
  "$RTL_DIR/rv64_axi4_mem_adapter.vhd" \
  "$RTL_DIR/rv32_ctrl_obs_slave.vhd" \
  "$RTL_DIR/soc_top_rv64_k26_ddr.vhd" \
  "$RTL_DIR/tb_rv64_k26_ddr_boot.vhd" 2>&1)" || true
if echo "$out" | grep -q ":error:"; then
  echo "FAIL"; echo "$out" | tail -40; exit 1
fi
echo "OK"

printf "  Elaborating ... "
out="$(cd "$WORK_DIR" && ghdl -e --std=08 --workdir="$WORK_DIR" tb_rv64_k26_ddr_boot 2>&1)" || true
if echo "$out" | grep -qi "error"; then
  echo "FAIL"; echo "$out" | tail -40; exit 1
fi
echo "OK"

# The marker match stops the run early on success; the bound is a safety net.
# The rv32 DDR-path boot took 125 ms of sim time; the rv64 core fetches 64-bit
# words (fewer beats/insn) but the tb clock is 50 MHz (2x period), so allow
# more headroom than rv32's 200 ms without repeating the 3000 ms mistake.
STOP_TIME="${STOP_TIME:-500ms}"
# GARBAGE_FILL=1: fill DDR beyond the loaded kernel image with nonzero
# pseudo-random words, rehearsing REAL power-up PS DDR4 (never zeroed). The tb
# zeroes .bss exactly like the board flow, so this run PASSING proves the
# zeroed span is complete for rv64.
GEN_ARGS=""
if [ "${GARBAGE_FILL:-0}" = "1" ]; then
  GEN_ARGS="-gG_GARBAGE_FILL=true"
  echo "  DDR model: GARBAGE FILL (un-zeroed power-up DDR rehearsal)"
fi
# SKIP_BSS_ZERO=1: disable the tb's board-step-5b .bss zeroing. With
# GARBAGE_FILL=1 this proves the kernel's own crt0 .bss-zero loop boots with
# zero loader cooperation (board-runnable rule).
if [ "${SKIP_BSS_ZERO:-0}" = "1" ]; then
  GEN_ARGS="$GEN_ARGS -gG_SKIP_BSS_ZERO=true"
  echo "  DDR model: tb .bss zeroing DISABLED (kernel crt0 self-zero proof)"
fi
echo "  Running simulation (stop-time=$STOP_TIME) ..."
(cd "$WORK_DIR" && ghdl -r --std=08 --workdir="$WORK_DIR" \
  tb_rv64_k26_ddr_boot $GEN_ARGS --stop-time="$STOP_TIME" > "$WORK_DIR/sim.log" 2>&1) || true

echo "----- transcript recovered over AXI-Lite -----"
grep -v -E "^K26_" "$WORK_DIR/sim.log" || true
echo "----------------------------------------------"
grep -E "^K26_" "$WORK_DIR/sim.log" || true

if grep -q "K26_MARKER_TEST_PASSED_SEEN" "$WORK_DIR/sim.log"; then
  echo "RESULT: PASS - rv64 SimpleOS booted through the AXI4/DDR path"
  exit 0
fi
echo "RESULT: FAIL - terminal marker not seen (full log: $WORK_DIR/sim.log)"
exit 1
