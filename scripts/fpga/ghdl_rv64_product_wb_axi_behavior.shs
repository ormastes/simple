#!/bin/sh
# Focused generated-product ABI/adapter behavior test; no source generation.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
rtl=${1:-"$root/build/vhdl/rv64"}
work="$root/build/ghdl/rv64_product_wb_axi"
command -v ghdl >/dev/null 2>&1 || { echo "FAIL: ghdl not found"; exit 1; }
for f in rv64imac_core_product_wb.vhd wb64_axi_hp_bridge.vhd; do [ -f "$rtl/$f" ] || { echo "FAIL: generate $f first"; exit 1; }; done
rm -rf "$work"; mkdir -p "$work"
ghdl -a --std=08 --workdir="$work" "$root/test/01_unit/lib/hardware/fpga_linux/rv64_product_wb_axi_ghdl/core64_imac_product_entry_stub.vhd"
ghdl -a --std=08 --workdir="$work" "$rtl/rv64imac_core_product_wb.vhd"
ghdl -a --std=08 --workdir="$work" "$rtl/wb64_axi_hp_bridge.vhd"
ghdl -a --std=08 --workdir="$work" "$root/test/01_unit/lib/hardware/fpga_linux/rv64_product_wb_axi_ghdl/tb_rv64_product_wb_axi.vhd"
ghdl -e --std=08 --workdir="$work" tb_rv64_product_wb_axi
sim_log="$work/sim.log"
if ! ghdl -r --std=08 --workdir="$work" tb_rv64_product_wb_axi --stop-time=1us >"$sim_log" 2>&1; then
    tail -40 "$sim_log"
    exit 1
fi
grep -q RV64_PRODUCT_WB_AXI_GHDL_PASS "$sim_log"
echo "RV64_PRODUCT_WB_AXI_GHDL_PASS"
