#!/bin/sh
# GHDL rehearsal of the SYNTHESIZABLE BRAM-only rv32 SimpleOS SoC
# (rv32_bram_soc = rv32_exec_core_axi + BRAM memory slave + UART capture +
# JTAG observation register file) — the exact RTL that goes into the Vivado
# KV260 build (soc_top_rv32_tiny_bram), minus only the device primitives
# (STARTUPE3 clock, BSCANE2 USER4 shift logic).
#
# This is the mandatory cheap gate before burning a Vivado run: it proves the
# BRAM init path, the stalled memory pipeline, the ramdisk decode, the capture
# buffer packing and the observation mux all boot the tiny kernel to
# TEST PASSED and read the transcript back byte-identical.
#
# Env knobs:
#   KERNEL_ELF   (default build/os/simpleos_riscv32_smf_fs_tiny.elf)
#   FAT32_IMG    (default build/os/fat32-riscv32.img)
#   RAM_WORDS    (default 131072 = 512 KB;   65536 = 256 KB shrunk budget)
#   RDISK_WORDS  (default 262144 = 1 MiB;    81920 = 320 KB shrunk budget)
#   STOP_TIME    (default 400ms)
#
# NO Vivado. GHDL simulation only.
set -e
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

RTL_DIR="$ROOT_DIR/examples/09_embedded/fpga_riscv/rtl"
WORK_DIR="$ROOT_DIR/build/ghdl/rv32_tiny_bram_soc"
KERNEL_ELF="${KERNEL_ELF:-$ROOT_DIR/build/os/simpleos_riscv32_smf_fs_tiny.elf}"
FAT32_IMG="${FAT32_IMG:-$ROOT_DIR/build/os/fat32-riscv32.img}"
RAM_WORDS="${RAM_WORDS:-131072}"
RDISK_WORDS="${RDISK_WORDS:-262144}"
RAM_BYTES=$((RAM_WORDS * 4))
RAMDISK_BYTES=$((RDISK_WORDS * 4))

command -v ghdl >/dev/null 2>&1 || { echo "ERROR: ghdl not found in PATH"; exit 1; }
[ -f "$KERNEL_ELF" ] || { echo "ERROR: tiny kernel ELF missing: $KERNEL_ELF"; exit 1; }
[ -f "$FAT32_IMG" ] || { echo "ERROR: FAT32 ramdisk image missing: $FAT32_IMG"; exit 1; }

mkdir -p "$WORK_DIR"
echo "=== GHDL rv32 BRAM-SoC rehearsal (synth RTL, ${RAM_BYTES}B RAM + ${RAMDISK_BYTES}B ramdisk) ==="
echo "  Kernel ELF: $KERNEL_ELF"
echo "  Ramdisk img: $FAT32_IMG (first $RAMDISK_BYTES bytes -> 0x88000000)"

# Static budget gate (same as the tiny lane).
if command -v llvm-nm >/dev/null 2>&1; then
  kend_hex="$(llvm-nm "$KERNEL_ELF" | awk '$3=="_kernel_end"{print $1}')"
  if [ -n "$kend_hex" ]; then
    kend=$(printf '%d' "0x$kend_hex")
    base=$(printf '%d' 0x80000000)
    used=$((kend - base))
    echo "  Image footprint: $used bytes (_kernel_end=0x$kend_hex) vs $RAM_BYTES bytes of RAM"
    if [ "$used" -gt "$RAM_BYTES" ]; then
      echo "ERROR: image does not fit the configured BRAM budget"; exit 1
    fi
  fi
fi

# Flatten kernel + ramdisk to the .mem format (same as the tiny lane; this is
# also EXACTLY what the Vivado build feeds the BRAM INIT impure functions).
riscv64-unknown-elf-objcopy -O binary "$KERNEL_ELF" "$WORK_DIR/kernel.bin"
od -An -v -tx4 -w4 "$WORK_DIR/kernel.bin" | awk 'NF{print $1}' > "$WORK_DIR/rv32_flat.mem"
# GARBAGE_FILL=1: pad the .mem image with deterministic nonzero pseudo-random
# words out to the full BRAM depth. Real BRAM powers up from the INIT file
# (zeros) so silicon is safe, but this knob unmasks any reliance on implicit
# zero .bss/heap/stack — the kernel's crt0 .bss-zero loop must cope. Done in
# the .mem (loader side), so the SYNTHESIZABLE rv32_bram_soc.vhd stays
# untouched. xorshift32 seeded 0xDEADBEEF, matching the DDR tbs.
if [ "${GARBAGE_FILL:-0}" = "1" ]; then
  kwords=$(wc -l < "$WORK_DIR/rv32_flat.mem")
  awk -v have="$kwords" -v total="$RAM_WORDS" 'BEGIN{
    x = 3735928559;                       # 0xDEADBEEF
    for (i = have; i < total; i++) {
      x = xor(x, (x * 8192) % 4294967296);        # x ^= x << 13 (mod 2^32)
      x = xor(x, int(x / 131072));                # x ^= x >> 17
      x = xor(x, (x * 32) % 4294967296);          # x ^= x << 5  (mod 2^32)
      if (x == 0) x = 3735928559;
      printf "%08x\n", x;
    }
  }' >> "$WORK_DIR/rv32_flat.mem"
  echo "  BRAM model: GARBAGE FILL beyond kernel image ($kwords -> $RAM_WORDS words)"
fi
echo "  Kernel image: $(wc -l < "$WORK_DIR/rv32_flat.mem") words (rv32_flat.mem)"
head -c "$RAMDISK_BYTES" "$FAT32_IMG" > "$WORK_DIR/rv32_ramdisk.img"
od -An -v -tx4 -w4 "$WORK_DIR/rv32_ramdisk.img" | awk 'NF{print $1}' > "$WORK_DIR/rv32_ramdisk.mem"
echo "  Ramdisk image: $(wc -l < "$WORK_DIR/rv32_ramdisk.mem") words (rv32_ramdisk.mem)"

printf "  Analysing synth SoC + rehearsal tb ... "
out="$(ghdl -a --std=08 --workdir="$WORK_DIR" \
  "$RTL_DIR/rv32_exec_core_axi.vhd" \
  "$RTL_DIR/rv32_bram_soc.vhd" \
  "$RTL_DIR/tb_rv32_tiny_bram_soc.vhd" 2>&1)" || true
if echo "$out" | grep -q ":error:"; then
  echo "FAIL"; echo "$out" | tail -40; exit 1
fi
echo "OK"

printf "  Elaborating ... "
out="$(cd "$WORK_DIR" && ghdl -e --std=08 --workdir="$WORK_DIR" tb_rv32_tiny_bram_soc 2>&1)" || true
if echo "$out" | grep -qi "error"; then
  echo "FAIL"; echo "$out" | tail -40; exit 1
fi
echo "OK"

STOP_TIME="${STOP_TIME:-400ms}"
printf "  Running simulation (stop-time=%s, RAM_WORDS=%s, RDISK_WORDS=%s) ...\n" \
  "$STOP_TIME" "$RAM_WORDS" "$RDISK_WORDS"
sim="$(cd "$WORK_DIR" && ghdl -r --std=08 --workdir="$WORK_DIR" tb_rv32_tiny_bram_soc \
  -gTINY_RAM_WORDS="$RAM_WORDS" -gTINY_RDISK_WORDS="$RDISK_WORDS" \
  --stop-time="$STOP_TIME" 2>&1)" || true
echo "$sim" | grep -E "RV32_BRAMSOC_BUDGET" | tail -1
echo "----- UART transcript (live tap) -----"
echo "$sim" | grep -E "RV32_BRAMSOC_UART_LINE:" | sed 's/.*RV32_BRAMSOC_UART_LINE: //'
echo "--------------------------------------"
# NOTE: only these timestamped testbench `(report note)` lines are evidence.
# Grepping the build dir for "TEST PASSED" also matches the BINARY kernel image.
echo "$sim" | grep -E "RV32_BRAMSOC_(BOOT_DONE|BOOT_STUCK|OBS_)" | tail -12
