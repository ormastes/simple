#!/bin/sh
# soak_rv32_board_jtag.shs — REAL-BOARD rv32 hard-job soak read out ENTIRELY over
# Simple's own JTAG/BSCANE2 debug stack (NO UART; the KV260 carrier routes no
# FT4232H channel to the PL UART pin H12, so golden is sampled from the hart's
# GPRs over JTAG). Companion to soak_rv32_board.shs (UART path, blocked on wiring).
#
# Requires a fresh hw_server holding the FT4232H (single-client chain — kill any
# stale hw_server/Vivado first). Programs the debug bitstream (G_DEBUG_JTAG=true,
# COUNT=260M baked, host golden 0x7EB5A8A9) then polls: halt -> read x18
# (progress) + x8 (Adler-32) -> resume, until golden==host and x18 goes stable.
#
# Env: BIT (debug bitstream), IDLE (dmi idle_cycles=128), INTERVAL (poll s=30),
#      MAX_WALL (cap s=1400), GOLDEN (0x-less hex=7EB5A8A9), EVID (out dir).
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"; cd "$ROOT"
VIVADO="${VIVADO:-/home/ormastes/Xilinx/2025.2/Vivado/bin/vivado}"
TCL="$ROOT/scripts/fpga/kv260_dmi_hwjtag.tcl"
BIT="${BIT:-$ROOT/build/build/rv32_fpga_debug/gateware/rv32_fpga_debug.bit}"
IDLE="${IDLE:-128}"
INTERVAL="${INTERVAL:-30}"
MAX_WALL="${MAX_WALL:-1400}"
GOLDEN="${GOLDEN:-7EB5A8A9}"
STAMP="$(date +%Y%m%d_%H%M%S)"
EVID="${EVID:-$ROOT/build/fpga/evidence/rv32_$(date +%Y-%m-%d)/jtag_rerun_$STAMP}"
mkdir -p "$EVID"
PROG="$EVID/progress.log"; VERDICT="$EVID/verdict.txt"
SAMPLE_ARGS="$IDLE 2:10:80000001 1:11:0 1:16:0 2:17:221012 1:04:0 2:17:221008 1:04:0 2:10:40000001 1:11:0"

[ -x "$VIVADO" ] || { echo "FAIL: vivado missing $VIVADO"; exit 1; }
[ -f "$BIT" ]    || { echo "FAIL: debug bitstream missing $BIT"; exit 1; }

sample() { # -> echoes OPn_RESULT lines
  "$VIVADO" -mode batch -nojournal -nolog -notrace -source "$TCL" -tclargs $SAMPLE_ARGS 2>/dev/null
}

if [ "${SKIP_PROGRAM:-0}" != "1" ]; then
  echo "=== programming debug bitstream (fresh reset -> soak from 0) ==="
  OUT_DIR="$EVID" sh scripts/fpga/program_kv260_bitstream.shs "$BIT" > "$EVID/program.log" 2>&1 \
    || { echo "FAIL: program"; tail -5 "$EVID/program.log"; exit 1; }
  grep -q 'PROGRAM_HW_DEVICES_DONE' "$EVID/program.log" || { echo "FAIL: no PROGRAM_HW_DEVICES_DONE"; exit 1; }
  echo "programmed OK"
fi

T0="$(date +%s)"; n=0; stable=0; last_x18=""; final_x8=""; final_x18=""
echo "=== sampling golden over JTAG (interval=${INTERVAL}s cap=${MAX_WALL}s) ==="
while :; do
  now="$(date +%s)"; wall=$((now - T0))
  out="$(sample || true)"
  hd="$(printf '%s\n' "$out" | sed -n 's/^OP1_RESULT OP=[0-9] DATA=\([0-9a-f]*\) ADDR=11$/\1/p' | head -1)"
  x18="$(printf '%s\n' "$out" | sed -n 's/^OP4_RESULT OP=[0-9] DATA=\([0-9a-f]*\) ADDR=04$/\1/p' | head -1)"
  x8="$(printf '%s\n' "$out"  | sed -n 's/^OP6_RESULT OP=[0-9] DATA=\([0-9a-f]*\) ADDR=04$/\1/p' | head -1)"
  rd="$(printf '%s\n' "$out" | sed -n 's/^OP8_RESULT OP=[0-9] DATA=\([0-9a-f]*\) ADDR=11$/\1/p' | head -1)"
  echo "SAMPLE n=$n wall=$wall halt_dmstatus=${hd:-??} x18=${x18:-??} x8=${x8:-??} run_dmstatus=${rd:-??}" | tee -a "$PROG"
  if [ -n "$x18" ] && [ "$x18" = "$last_x18" ]; then stable=$((stable+1)); else stable=0; fi
  last_x18="$x18"; final_x8="$x8"; final_x18="$x18"
  # terminal: golden matches AND progress frozen for >=3 samples
  glow="$(printf '%s' "$GOLDEN" | tr 'A-F' 'a-f')"
  if [ "${x8:-}" = "$glow" ] && [ "$stable" -ge 3 ]; then
    echo "TERMINAL reached (golden stable)"; break
  fi
  [ "$wall" -ge "$MAX_WALL" ] && { echo "MAX_WALL hit"; break; }
  n=$((n+1)); sleep "$INTERVAL"
done
WALL=$(( $(date +%s) - T0 ))

{
  echo "RV32 KV260 BOARD SOAK (JTAG readout) — rerun $STAMP"
  echo "wall_seconds=$WALL"
  echo "final_x18(progress)=$final_x18"
  echo "final_x8(golden)=$final_x8  host_golden=$(printf '%s' "$GOLDEN" | tr 'A-F' 'a-f')"
  echo "bitstream=$BIT"
} | tee "$VERDICT"

glow="$(printf '%s' "$GOLDEN" | tr 'A-F' 'a-f')"
if [ "${final_x8:-}" = "$glow" ]; then
  echo "SOAK_RV32_BOARD_JTAG: PASS"
else
  echo "SOAK_RV32_BOARD_JTAG: FAIL (golden ${final_x8:-none} != $glow)"; exit 1
fi
