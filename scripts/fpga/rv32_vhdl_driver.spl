# Generate RV32IMAC SoC glue around the compiler-emitted product core.

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_dir_create(path: text) -> bool

use std.hardware.fpga_linux._SocVhdlGen.product_bus_rv32.{generate_rv32_product_wb64_wrapper_vhdl}
use std.hardware.fpga_linux._SocVhdlGen.peripherals.{generate_bootrom_vhdl_wb64, generate_clint_vhdl, generate_uart_vhdl, generate_wb_interconnect_vhdl_rv64}
use std.hardware.fpga_linux._SocVhdlGen.plic.{generate_plic_vhdl_rv64}
use std.hardware.fpga_linux._SocVhdlGen.top_testbench.{generate_soc_top_vhdl_rv32_external_ddr}
use std.hardware.fpga_k26.k26_axi_hp_bridge.{generate_wb64_axi_hp_bridge_vhdl, generate_rv32_k26_ps_pl_top_vhdl}

fn write_vhd(out_dir: text, name: text, content: text) -> bool:
    val path = "{out_dir}/{name}.vhd"
    val ok = rt_file_write_text(path, content)
    if ok:
        print("OK {path} bytes={content.length()}")
    else:
        print("FAIL {path}")
    ok

fn main() -> i32:
    val out_dir = "build/vhdl/rv32"
    rt_dir_create(out_dir)

    # The CPU VHDL is emitted separately from protected_entry.spl.  Never
    # substitute a copied executor for core32_protected_product_entry.
    var ok = write_vhd(out_dir, "rv32imac_core_product_wb",
        generate_rv32_product_wb64_wrapper_vhdl())
    ok = write_vhd(out_dir, "clint", generate_clint_vhdl()) and ok
    ok = write_vhd(out_dir, "plic", generate_plic_vhdl_rv64()) and ok
    ok = write_vhd(out_dir, "uart16550", generate_uart_vhdl()) and ok
    ok = write_vhd(out_dir, "bootrom", generate_bootrom_vhdl_wb64()) and ok
    ok = write_vhd(out_dir, "wb_interconnect", generate_wb_interconnect_vhdl_rv64()) and ok
    ok = write_vhd(out_dir, "soc_top_rv32_external_ddr",
        generate_soc_top_vhdl_rv32_external_ddr()) and ok
    ok = write_vhd(out_dir, "wb64_axi_hp_bridge",
        generate_wb64_axi_hp_bridge_vhdl()) and ok
    ok = write_vhd(out_dir, "soc_top_rv32_k26_pl",
        generate_rv32_k26_ps_pl_top_vhdl()) and ok
    if ok:
        0
    else:
        1
