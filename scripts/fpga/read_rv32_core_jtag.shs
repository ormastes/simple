#!/usr/bin/env bash
# read_rv32_core_jtag.shs — REPRODUCIBLE on-silicon readout of the Simple rv32
# soft-core on a Kria KV260, over Vivado hw_jtag through the BSCANE2 USER4 tunnel
# (bscane2_tap_bridge -> Simple TAP/DTM/DMI -> Debug Module -> rv32 hart).
#
# This is the path proven on 2026-07-24 (see build/fpga/evidence/rv32_2026-07-24/
# jtag/jtag_soak_verdict.txt: 981 s soak, x8 == host golden 0x7EB5A8A9). It was
# ad-hoc TCL in a since-deleted scratchpad; committed here so the readout is
# repeatable. Requires a G_DEBUG_JTAG=true bitstream programmed on the board
# (build/build/rv32_fpga_debug/gateware/rv32_fpga_debug.bit, built by
# build_rv32_debug_bitstream.shs).
#
# Key calibration (do NOT change without re-proving): TCK = 1 MHz. The bridge CDC
# only reliably crosses at <= core_clk/8 (~3 MHz at the 25 MHz core clock); the
# ~15 MHz hw_jtag default reads all-zeros. Outer chain = xck26 (0x04724093) +
# arm_dap (0x5ba00477); inner Simple TAP IDCODE = 0x15350067.
#
# Modes:
#   sample (default) — halt; read x18 (progress) + x8 (Adler accumulator) via
#                      abstract access-register; resume. Prints DMSTATUS/X18/X8.
#   idcode           — read-only: confirm outer chain + tunnelled inner IDCODE.
#
# DMI regs: 0x10 dmcontrol (halt=0x80000001, resume=0x40000001), 0x11 dmstatus
# (allhalted=0x000303xx, allrunning=0x00030cxx), 0x04 data0, 0x17 command
# (access-reg read: 0x00220000 | regno; x8=0x1008, x18=0x1012).
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

MODE="${1:-sample}"
VIVADO_SETTINGS="${VIVADO_SETTINGS:-$HOME/Xilinx/2025.2/Vivado/settings64.sh}"
HW_SERVER="${HW_SERVER:-$HOME/Xilinx/2025.2/Vivado/bin/hw_server}"
IDLE="${RV32_JTAG_IDLE_CYCLES:-64}"
OUT_DIR="${OUT_DIR:-build/fpga/jtag_readout}"
STAMP="$(date +%Y%m%d_%H%M%S)"
LOG="$OUT_DIR/read_${MODE}_${STAMP}.log"
TCL="$ROOT_DIR/scripts/fpga/jtag_dmi_tunnel.tcl"

mkdir -p "$OUT_DIR"
[ -f "$VIVADO_SETTINGS" ] || { echo "FAIL: vivado settings missing $VIVADO_SETTINGS"; exit 1; }
[ -f "$TCL" ] || { echo "FAIL: tunnel tcl missing $TCL"; exit 1; }
# shellcheck disable=SC1090
. "$VIVADO_SETTINGS"

# Ensure a single hw_server is up on 3121 (the tunnel connects to localhost:3121).
if ! (command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q ':3121'); then
    "$HW_SERVER" -d >/dev/null 2>&1 || true
    sleep 2
fi

case "$MODE" in
  idcode)
    # op:addr:data triples — a single nop is enough; the tcl reads the tunnelled
    # inner IDCODE as part of chain bring-up. Use a benign dmstatus read.
    OPS="1:11:0"
    ;;
  sample)
    # Exact proven 2026-07-24 op sequence:
    # op0 halt, op1 dmstatus, op2 abstractcs(settle), op3 cmd(read x18),
    # op4 read data0(=x18), op5 cmd(read x8), op6 read data0(=x8),
    # op7 resume, op8 dmstatus. DMI readback lags by one op:
    #   x18=OP4_RESULT, x8=OP6_RESULT, dmstatus_halted=OP1, dmstatus_resumed=OP8.
    OPS="2:10:80000001 1:11:0 1:16:0 2:17:00221012 1:04:0 2:17:00221008 1:04:0 2:10:40000001 1:11:0"
    ;;
  *) echo "usage: $0 [sample|idcode]"; exit 2;;
esac

# shellcheck disable=SC2086
vivado -mode batch -nojournal -nolog -notrace -source "$TCL" -tclargs "$IDLE" $OPS >"$LOG" 2>&1 || true

echo "== rv32 JTAG readout ($MODE @ $STAMP) =="
grep -E 'OUTER_DR64|FREQ=|OP[0-9]_RESULT' "$LOG" || { echo "FAIL: no tunnel output"; tail -20 "$LOG"; exit 1; }

if [ "$MODE" = "sample" ]; then
    X18="$(grep -E '^OP4_RESULT' "$LOG" | grep -oE 'DATA=[0-9a-f]{8}' | sed 's/DATA=//' || true)"
    X8="$(grep -E '^OP6_RESULT' "$LOG" | grep -oE 'DATA=[0-9a-f]{8}' | sed 's/DATA=//' || true)"
    DMS_H="$(grep -E '^OP1_RESULT' "$LOG" | grep -oE 'DATA=[0-9a-f]{8}' | sed 's/DATA=//' || true)"
    DMS_R="$(grep -E '^OP8_RESULT' "$LOG" | grep -oE 'DATA=[0-9a-f]{8}' | sed 's/DATA=//' || true)"
    echo "DMSTATUS_HALTED=$DMS_H  X18_PROGRESS=$X18  X8_GOLDEN=$X8  DMSTATUS_RESUMED=$DMS_R"
    echo "log=$LOG"
    # Expose for callers that source-parse the last lines.
    printf 'RV32_READ x18=%s x8=%s dms_h=%s dms_r=%s\n' "${X18:-?}" "${X8:-?}" "${DMS_H:-?}" "${DMS_R:-?}"
fi
echo "log=$LOG"
