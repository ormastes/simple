#!/bin/sh
# Host-driven H1 endpoint proof with a testbench-modeled firmware response.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
RTL_DIR="$ROOT_DIR/examples/09_embedded/fpga_riscv/rtl"
WORK_DIR="$ROOT_DIR/build/ghdl/rv32_nvme_host_axi_mmio"

command -v ghdl >/dev/null 2>&1 || { echo "FAIL: ghdl not found"; exit 1; }
mkdir -p "$WORK_DIR"
rm -f "$WORK_DIR"/*.cf

ghdl -a --std=08 --workdir="$WORK_DIR" \
    "$RTL_DIR/rv32_nvme_axi.vhd" \
    "$RTL_DIR/tb_rv32_nvme_host_axi_mmio.vhd"
ghdl -e --std=08 --workdir="$WORK_DIR" tb_rv32_nvme_host_axi_mmio
ghdl -r --std=08 --workdir="$WORK_DIR" tb_rv32_nvme_host_axi_mmio \
    --assert-level=error --stop-time=5ms > "$WORK_DIR/sim.log" 2>&1

grep -q "RV32_NVME_HOST_AXI_PASS" "$WORK_DIR/sim.log" || {
    tail -40 "$WORK_DIR/sim.log"
    echo "STATUS: FAIL rv32-nvme-host-axi-mmio"
    exit 1
}
echo "STATUS: PASS rv32-nvme-host-axi-mmio H1-ENDPOINT firmware=mocked"
