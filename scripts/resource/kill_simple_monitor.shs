#!/bin/sh
# kill_simple_monitor.sh — Kill runaway Simple processes, protect LLM/MCP/tmux
#
# Launched by ensure_kill_monitor_running() in system_monitor.spl.
# Runs in background, writes PID to /tmp/kill_simple_monitor.pid.
# Polls every $CHECK_INTERVAL secs for runaway processes (CPU spin or RSS balloon).
# NEVER kills: simple_mcp_server, simple_lsp_mcp_server, tmux, claude, codex, node, npm.

set -e

PIDFILE="/tmp/kill_simple_monitor.pid"
LOGFILE="${KILL_SIMPLE_LOG:-/tmp/kill_simple_monitor.log}"
CHECK_INTERVAL="${KILL_SIMPLE_INTERVAL:-10}"
CPU_THRESHOLD="${KILL_SIMPLE_CPU_PCT:-95}"
# CPU-spin grace period. A `bin/simple run|test` pegged at >=CPU_THRESHOLD for
# longer than this is killed. This is the ~60s ceiling that silently truncated
# every long spec/gate run before 2026-07-28: the victim died on SIGTERM
# mid-output with no diagnostic in its own stream, so a cut-short run read as a
# partial/failed result instead of an infrastructure timeout.
# Two ways to raise it:
#   - KILL_SIMPLE_MIN_AGE_SECS in the monitor's own environment (daemon-wide,
#     only takes effect when the daemon is (re)started), or
#   - SIMPLE_TIMEOUT_SECONDS in the *victim's* environment, read live from
#     /proc/<pid>/environ at check time, so
#     `SIMPLE_TIMEOUT_SECONDS=3600 bin/simple run x.spl` works against an
#     already-running monitor. `SIMPLE_TIMEOUT_SECONDS=0` disables the CPU
#     guard for that process; the RSS guard below still applies, so a runaway
#     can never balloon the host.
# Raised from 60 to 900 on 2026-08-17. 60s sat BELOW the runtime of an ordinary
# unit spec (~115s measured), so the DEFAULT configuration killed valid runs —
# the guard's floor has to be above realistic spec runtime or it is a
# result-corrupting timer, not a runaway guard. A true runaway spins forever and
# is still caught, just later.
MIN_AGE_SECS="${KILL_SIMPLE_MIN_AGE_SECS:-900}"
# Number of CONSECUTIVE polls a process must be measured above CPU_THRESHOLD
# before the CPU guard will fire. One hot sample is noise; a runaway is hot on
# every sample forever.
SPIN_SAMPLES="${KILL_SIMPLE_SPIN_SAMPLES:-3}"
# RSS guard: kill a bin/simple run/test proc this big regardless of CPU/age.
# A no-GC simple balloon doesn't peg CPU, so the CPU guard alone misses the
# host-OOM crash class (simple_runaway_oom_host_crash_2026-06-14). earlyoom is
# the kernel backstop; this kills a single proc long before the host degrades.
MEM_THRESHOLD_MB="${KILL_SIMPLE_MEM_MB:-24000}"
# Generic RSS cap for ANY non-protected proc owned by this uid (catches a rogue
# python/etc that isn't bin/simple — the class that OOM-crashed the host on
# 2026-06-26, a python3 leaking ~1.2GB/min to ~99GB). Set high so it only trips
# on a real runaway, never normal LLM/build work; raise KILL_ANY_MEM_MB for
# intentional big jobs.
GENERIC_MEM_THRESHOLD_MB="${KILL_ANY_MEM_MB:-64000}"
# Warn (log argv, do not kill) when any owned proc crosses this. Makes the
# offending command recoverable next time — argv is NOT logged anywhere else
# once the PID dies (no psacct/atop; earlyoom logs only the comm name).
WARN_MEM_MB="${KILL_SIMPLE_WARN_MB:-32000}"
MY_UID=$(id -u)

# Single-instance lock. Before 2026-08-17 the monitor unconditionally clobbered
# $PIDFILE, so two worktrees each started a monitor and both policed the whole
# uid: a process spared by one was killed by the other, and the pidfile pointed
# at whichever started last, so neither could be stopped reliably. mkdir is the
# portable atomic test-and-set.
LOCKDIR="${KILL_SIMPLE_LOCKDIR:-/tmp/.kill_simple_monitor.lock}"
OWNS_LOCK=0

acquire_lock() {
    if mkdir "$LOCKDIR" 2>/dev/null; then
        OWNS_LOCK=1
        echo $$ > "$LOCKDIR/pid" 2>/dev/null || true
        return 0
    fi
    _holder=$(cat "$LOCKDIR/pid" 2>/dev/null)
    if [ -n "$_holder" ] && kill -0 "$_holder" 2>/dev/null; then
        echo "[kill_monitor] another monitor already running (pid=$_holder); exiting" >&2
        return 1
    fi
    # Stale lock from a monitor that died without cleaning up.
    rm -rf "$LOCKDIR" 2>/dev/null || true
    if mkdir "$LOCKDIR" 2>/dev/null; then
        OWNS_LOCK=1
        echo $$ > "$LOCKDIR/pid" 2>/dev/null || true
        return 0
    fi
    echo "[kill_monitor] could not acquire lock $LOCKDIR; exiting" >&2
    return 1
}

cleanup() {
    if [ "$OWNS_LOCK" -eq 1 ]; then
        rm -f "$PIDFILE"
        rm -rf "$LOCKDIR" 2>/dev/null || true
    fi
    exit 0
}
trap cleanup INT TERM HUP EXIT

acquire_lock || exit 0

echo $$ > "$PIDFILE"

# Instantaneous-CPU sampling state, one file per observed pid.
CPU_STATE_DIR="${KILL_SIMPLE_CPU_STATE_DIR:-/tmp/.kill_monitor_cpu_$MY_UID}"
mkdir -p "$CPU_STATE_DIR" 2>/dev/null || true
CLK_TCK=$(getconf CLK_TCK 2>/dev/null || echo 100)
[ -n "$CLK_TCK" ] || CLK_TCK=100

is_protected() {
    _cmd="$1"
    case "$_cmd" in
        *simple_mcp_server*) return 0 ;;
        *simple_lsp_mcp_server*) return 0 ;;
        *t32_mcp_server*) return 0 ;;
        *t32_lsp_mcp_server*) return 0 ;;
        *mcp/main.spl*) return 0 ;;
        *mcp/main_*.spl*) return 0 ;;
        *lsp_mcp*) return 0 ;;
        *daemon*) return 0 ;;
        *claude*) return 0 ;;
        *codex*) return 0 ;;
        *tmux*) return 0 ;;
        *node*) return 0 ;;
        *npm*) return 0 ;;
    esac
    return 1
}

is_simple_run_or_test() {
    _cmd="$1"
    _had_noglob=0
    case $- in *f*) _had_noglob=1 ;; esac
    set -f
    set -- $_cmd
    [ "$_had_noglob" -eq 1 ] || set +f
    while [ "$#" -gt 1 ]; do
        case "$1:$2" in
            */simple:run|*/simple:test|simple:run|simple:test) return 0 ;;
        esac
        shift
    done
    return 1
}

safe_kill() {
    _pid="$1"
    case "$_pid" in
        ''|*[!0-9]*) return 0 ;;
    esac
    [ "$_pid" -le 1 ] 2>/dev/null && return 0
    kill "$_pid" 2>/dev/null || true
}

# Per-process CPU-spin budget in seconds, read live from the victim's own
# environment so a caller can raise it without restarting the monitor.
# Echoes the effective budget; empty output means "no CPU guard" (disabled).
cpu_budget_secs() {
    _pid="$1"
    _env=$(tr '\0' '\n' < "/proc/$_pid/environ" 2>/dev/null |
        sed -n 's/^SIMPLE_TIMEOUT_SECONDS=//p' | head -n 1)
    case "$_env" in
        ''|*[!0-9]*) echo "$MIN_AGE_SECS" ; return 0 ;;
    esac
    # Explicit 0 = caller disabled the wall-clock limit.
    [ "$_env" -eq 0 ] 2>/dev/null && return 0
    # Never let an explicit request shorten the default grace period.
    if [ "$_env" -lt "$MIN_AGE_SECS" ] 2>/dev/null; then
        echo "$MIN_AGE_SECS"
    else
        echo "$_env"
    fi
}

# Instantaneous CPU percent for a pid, as the delta of utime+stime over the
# interval since the PREVIOUS poll. This replaces `ps -o pcpu`, which reports a
# LIFETIME AVERAGE: a spec that compiles near 100% and then falls to ~70% for
# I/O drifts across a fixed threshold purely as a function of WHEN it happens to
# be sampled, so byte-identical commands got opposite verdicts (measured
# 2026-08-17: 75.1% survived, 97.2% killed, 69.2% survived).
#
# Echoes nothing when there is no usable prior sample (first sighting of the
# pid, or the pid was reused). Callers MUST treat empty as "no evidence" and
# skip the kill — never as 0 and never as "hot".
instant_cpu_pct() {
    _pid="$1"
    _stat=$(cat "/proc/$_pid/stat" 2>/dev/null) || return 0
    [ -n "$_stat" ] || return 0
    # Field 2 (comm) is parenthesised and may contain spaces; strip through the
    # LAST ") " so a comm like "sh (x) y" cannot shift every later field.
    _rest=${_stat##*') '}
    _had_noglob=0
    case $- in *f*) _had_noglob=1 ;; esac
    set -f
    # After comm is stripped, positional $1 is field 3 (state), so field N is
    # ${N-2}: utime(14)=${12}, stime(15)=${13}, starttime(22)=${20}.
    set -- $_rest
    [ "$_had_noglob" -eq 1 ] || set +f
    [ "$#" -ge 20 ] || return 0
    _ticks=$(( ${12} + ${13} ))
    _start=${20}
    _now=$(date +%s)

    _f="$CPU_STATE_DIR/$_pid"
    _prev=$(cat "$_f" 2>/dev/null)
    printf '%s %s %s\n' "$_start" "$_ticks" "$_now" > "$_f" 2>/dev/null || true
    [ -n "$_prev" ] || return 0

    set -f
    set -- $_prev
    [ "$_had_noglob" -eq 1 ] || set +f
    [ "$#" -eq 3 ] || return 0
    # starttime mismatch means this pid was recycled; the old sample is not ours.
    [ "$1" = "$_start" ] || return 0
    _dticks=$(( _ticks - $2 ))
    _dt=$(( _now - $3 ))
    [ "$_dt" -ge 1 ] 2>/dev/null || return 0
    [ "$_dticks" -ge 0 ] 2>/dev/null || return 0
    echo $(( _dticks * 100 / (CLK_TCK * _dt) ))
}

# Consecutive-hot-sample counter, so one hot poll can never fire the guard.
spin_streak() {
    _pid="$1"; _hot="$2"
    _f="$CPU_STATE_DIR/streak_$_pid"
    if [ "$_hot" -eq 0 ]; then
        rm -f "$_f" 2>/dev/null || true
        echo 0
        return 0
    fi
    _n=$(cat "$_f" 2>/dev/null)
    case "$_n" in ''|*[!0-9]*) _n=0 ;; esac
    _n=$(( _n + 1 ))
    echo "$_n" > "$_f" 2>/dev/null || true
    echo "$_n"
}

# Tell the victim why it is dying, in its own output stream. Without this the
# kill is invisible to whoever is reading the run: the process just stops
# mid-line and the truncated output reads like a real (partial) result.
notify_victim() {
    _pid="$1"; _msg="$2"
    for _fd in 2 1; do
        [ -w "/proc/$_pid/fd/$_fd" ] 2>/dev/null || continue
        echo "$_msg" >> "/proc/$_pid/fd/$_fd" 2>/dev/null || true
    done
}

kill_hard() {
    _pid="$1"
    _why="$2"
    _line="[kill_monitor] Killing runaway process pid=$_pid ($_why)"
    echo "$_line" >&2
    echo "$(date '+%Y-%m-%dT%H:%M:%S') KILL $_line" >> "$LOGFILE" 2>/dev/null || true
    notify_victim "$_pid" "error: TIMEOUT: killed by kill_simple_monitor ($_why). Raise the limit with SIMPLE_TIMEOUT_SECONDS=<secs> (0 disables the CPU guard); see scripts/resource/kill_simple_monitor.shs."
    safe_kill "$_pid"
    sleep 1
    kill -0 "$_pid" 2>/dev/null && [ "$_pid" -gt 1 ] 2>/dev/null && kill -9 "$_pid" 2>/dev/null || true
}

# Append a timestamped argv record so the offending command is recoverable even
# after the PID dies. Throttled to once per pid per ramp via a /tmp marker.
log_proc() {
    _pid="$1"; _rss_mb="$2"; _cmd="$3"
    _marker="/tmp/.kill_monitor_warned_${_pid}"
    [ -e "$_marker" ] && return 0
    : > "$_marker" 2>/dev/null || true
    echo "$(date '+%Y-%m-%dT%H:%M:%S') WARN pid=$_pid rss=${_rss_mb}MB cmd=$_cmd" >> "$LOGFILE" 2>/dev/null || true
}

while true; do
    sleep "$CHECK_INTERVAL"

    # Drop warn-markers for dead pids so a reused pid warns again.
    for _m in /tmp/.kill_monitor_warned_*; do
        [ -e "$_m" ] || continue
        _mp="${_m##*_}"
        kill -0 "$_mp" 2>/dev/null || rm -f "$_m" 2>/dev/null || true
    done

    # Drop CPU-sample and spin-streak state for dead pids, so a recycled pid
    # starts from no evidence rather than inheriting a stranger's hot streak.
    for _s in "$CPU_STATE_DIR"/* ; do
        [ -e "$_s" ] || continue
        _sp="${_s##*/}"
        _sp="${_sp#streak_}"
        case "$_sp" in ''|*[!0-9]*) continue ;; esac
        kill -0 "$_sp" 2>/dev/null || rm -f "$_s" 2>/dev/null || true
    done

    # uid filters to our own procs (can't/shouldn't kill root system procs);
    # rss is in KB; etimes in seconds. args is last so it captures full cmdline.
    ps -eo uid,pid,pcpu,rss,etimes,args --no-headers 2>/dev/null | while read uid pid cpu rss etime cmdline; do
        [ "$uid" = "$MY_UID" ] 2>/dev/null || continue

        if is_protected "$cmdline"; then
            continue
        fi

        rss_mb=$(( rss / 1024 ))

        # Warn-log argv for anything large, so a runaway is identifiable later.
        if [ "$rss_mb" -ge "$WARN_MEM_MB" ] 2>/dev/null; then
            log_proc "$pid" "$rss_mb" "$cmdline"
        fi

        if is_simple_run_or_test "$cmdline"; then
                # bin/simple RSS guard — fires regardless of CPU/age (OOM balloon).
                if [ "$rss_mb" -ge "$MEM_THRESHOLD_MB" ] 2>/dev/null; then
                    kill_hard "$pid" "rss=${rss_mb}MB>=${MEM_THRESHOLD_MB}MB: $cmdline"
                    continue
                fi

                case "$cmdline" in
                    *native_build_main.spl*|*native_build_worker.spl*)
                        # Native bootstrap builds are CPU-bound by design; the
                        # RSS guard above still catches real runaway balloons.
                        continue
                        ;;
                esac

                # CPU guard — runaway spin. Measured INSTANTANEOUSLY (see
                # instant_cpu_pct); `ps` pcpu is deliberately not used here.
                cpu_int=$(instant_cpu_pct "$pid")
                # Empty => first sighting or recycled pid. No evidence is not
                # evidence of a runaway: wait for the next poll.
                if [ -z "$cpu_int" ]; then
                    continue
                fi
                if [ "$cpu_int" -lt "$CPU_THRESHOLD" ] 2>/dev/null; then
                    spin_streak "$pid" 0 >/dev/null
                    continue
                fi
                streak=$(spin_streak "$pid" 1)
                if [ "$streak" -lt "$SPIN_SAMPLES" ] 2>/dev/null; then
                    continue
                fi
                budget=$(cpu_budget_secs "$pid")
                # Empty budget => caller set SIMPLE_TIMEOUT_SECONDS=0.
                [ -n "$budget" ] || continue
                if [ "$etime" -lt "$budget" ] 2>/dev/null; then
                    continue
                fi
                kill_hard "$pid" "cpu=${cpu_int}% (instantaneous, ${streak} consecutive samples) age=${etime}s>=${budget}s: $cmdline"
        else
                # Generic RSS cap for any other owned proc (rogue python/etc).
                if [ "$rss_mb" -ge "$GENERIC_MEM_THRESHOLD_MB" ] 2>/dev/null; then
                    kill_hard "$pid" "generic rss=${rss_mb}MB>=${GENERIC_MEM_THRESHOLD_MB}MB: $cmdline"
                fi
        fi
    done
done
