#!/bin/sh
# Run one `simple test` invocation under a host-wide concurrency cap.
#
# Why: 2026-08-17 the box hit loadavg 55 with 57 concurrent `bin/simple test`
# processes across four independent sessions. Each holds ~3.5GB RSS, so 17
# concurrent is ~60GB and the stage-3 build starves. Measured: a directory that
# produced a verdict in ~5min took >60min in that window.
#
# Usage:  sh scripts/resource/test-slot.shs bin/simple test <path> --timeout 800
# Env:    SIMPLE_TEST_SLOTS (default 6), SIMPLE_TEST_SLOT_WAIT (default 3600s)
#
# ponytail: flock on N lock files, not a daemon. Slots free automatically when a
# holder dies, including SIGKILL — no stale-slot reaper needed.
set -u

SLOTS=${SIMPLE_TEST_SLOTS:-6}
WAIT=${SIMPLE_TEST_SLOT_WAIT:-3600}
DIR=${TMPDIR:-/tmp}/simple-test-slots
mkdir -p "$DIR" 2>/dev/null || true

[ "$#" -gt 0 ] || { echo "ERROR — nothing was checked: no command given" >&2; exit 2; }

deadline=$(( $(date +%s) + WAIT ))
while :; do
    i=0
    while [ "$i" -lt "$SLOTS" ]; do
        # Non-blocking: take the first free slot. exec 9< keeps the fd (and the
        # lock) held for the lifetime of the command below.
        if exec 9<>"$DIR/slot.$i" && flock -n 9; then
            "$@"
            rc=$?
            exec 9<&-
            exit "$rc"
        fi
        exec 9<&- 2>/dev/null || true
        i=$((i + 1))
    done
    [ "$(date +%s)" -lt "$deadline" ] || {
        echo "ERROR — nothing was checked: no slot within ${WAIT}s (cap=$SLOTS)" >&2
        exit 2
    }
    sleep 5
done
