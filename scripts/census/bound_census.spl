# Census of SPL-BOUND-001/002 (bound_late_cast) and SPL-BOUND-004 style
# reassert findings over a list of files. Usage:
#   bin/simple run scripts/census/bound_census.spl <file-list.txt>
# Prints one `FINDING|code|path|line` row per finding and a CENSUS summary.

use std.cli.cli_util (get_cli_args)
use std.nogc_sync_mut.io.file_ops.{file_read_text}
use compiler.semantics.lint.bound_late_cast.{check_bound_late_casts}
use compiler.semantics.lint.bound_unit_reassert.{check_bound_unit_reasserts}

fn main():
    val args = get_cli_args()
    val list_path = args[args.len() - 1]
    var scanned = 0
    var total = 0
    for path in file_read_text(list_path).split("\n"):
        val p = path.trim()
        if p == "":
            continue
        scanned = scanned + 1
        val src = file_read_text(p)
        for f in check_bound_late_casts(src, p):
            print "FINDING|{f.code}|{p}|{f.line_num}"
            total = total + 1
        for f in check_bound_unit_reasserts(src, p):
            print "FINDING|{f.code}|{p}|{f.line_num}"
            total = total + 1
    print "CENSUS|files={scanned}|findings={total}"

main()
