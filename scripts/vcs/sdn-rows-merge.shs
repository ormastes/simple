#!/bin/sh
# sdn-rows-merge.shs — git merge driver for sealed SDN row tables
# (doc/08_tracking/bug/bug_db.sdn and friends).
#
# WHY: line 1 of a sealed SDN file is `#sdn-crc32:<n>`, a checksum of the whole
# body. Every PR that touches any row rewrites that line, so ANY two PRs that
# both touch the file conflict on line 1 even when their rows are disjoint.
#
# Wiring (scripts/setup/setup.shs installs it; .gitattributes selects it):
#   git config merge.sdn-rows.name   "SDN row-union merge + reseal"
#   git config merge.sdn-rows.driver "sh scripts/vcs/sdn-rows-merge.shs %O %A %B %P"
# A clone without that config ignores `merge=sdn-rows` and git falls back to its
# normal text merge, so nothing breaks when the driver is absent.
#
# MERGE RULES (per table; a table starts at a `name |col, col, ...|` header)
#   key  = first column, or first two columns when the 2nd is `line_num`.
#   A key that occurs at most once per side is merged by key:
#     same on both sides            -> keep
#     changed on one side only      -> take the change
#     changed on both, differently  -> the newer timestamp wins; timestamp is
#        the row's updated_at / heartbeat_at / assessed_at / claimed_at column,
#        else the `bugs` (then `bugs_active`) row's updated_at for that id.
#        Equal or missing timestamps -> CONFLICT.
#     deleted on one side, unchanged on the other -> deleted
#     deleted on one side, changed on the other   -> CONFLICT
#     added on one side             -> kept
#   A key that repeats on some side (append-only logs: claims, difficulty)
#   is merged as a multiset of whole row lines (appends from both sides kept,
#   deletions honoured).
#   Table headers must match on both sides; rows are copied verbatim, so column
#   counts are preserved. The result is resealed by
#   scripts/check/reseal-sdn-crc32.shs (the one CRC implementation).
#
# FAIL-CLOSED: on a row CONFLICT the result keeps standard
# `<<<<<<<`/`=======`/`>>>>>>>` markers around the two rows and exits 1. If any
# input is not a sealed SDN table file (or already carries conflict markers, or
# headers differ), it falls back to `git merge-file` (plain 3-way text merge).
#
# Usage:
#   sh scripts/vcs/sdn-rows-merge.shs <base> <ours> <theirs> [<path>]
#   sh scripts/vcs/sdn-rows-merge.shs --selftest
# Verdict (last stdout line of --selftest): PASS — <n> fixtures / FAIL — ...

set -u

HERE=$(cd "$(dirname "$0")" && pwd)
CHECKDIR="$HERE/../check"
# A copy installed outside the repo resolves the checkers from the repo git runs it in.
[ -f "$CHECKDIR/reseal-sdn-crc32.shs" ] || CHECKDIR="$(git rev-parse --show-toplevel 2>/dev/null)/scripts/check"
RESEAL="$CHECKDIR/reseal-sdn-crc32.shs"
SEALCHK="$CHECKDIR/check-sdn-crc32-sealed.shs"

is_sealed_sdn() { # file -> 0 when it is an SDN table file (legacy header or plain) with no conflict markers
    head -1 "$1" | grep -Eq '^#sdn-crc32:|^[A-Za-z_][A-Za-z0-9_]* \|.*\|[[:space:]]*$' || return 1
    grep -q '^<<<<<<< \|^>>>>>>> ' "$1" && return 1
    return 0
}

text_merge() { # base ours theirs path -> plain git 3-way text merge
    git merge-file -L "ours" -L "base" -L "theirs" "$2" "$1" "$3"
    [ $? -eq 0 ] && return 0
    return 1
}

row_merge() { # base ours theirs -> writes merged rows to stdout; rc 0 clean, 1 conflict, 3 unsupported
    awk '
    FNR == 1 { side++ ; tbl = ""; if ($0 ~ /^#sdn-crc32:/) next }   # legacy seal header is dropped; .csm sidecars are resealed after the merge
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    function fields(s, arr,   n, i, c, q, cur) {   # quote-aware comma split
        n = 0; q = 0; cur = ""
        for (i = 1; i <= length(s); i++) {
            c = substr(s, i, 1)
            if (c == "\"") q = !q
            if (c == "," && !q) { arr[++n] = trim(cur); cur = ""; continue }
            cur = cur c
        }
        arr[++n] = trim(cur)
        return n
    }
    /^[A-Za-z_][A-Za-z0-9_]* \|.*\|[ \t]*$/ {
        tbl = $1; hdr[side, tbl] = $0
        if (!((side, tbl) in seen)) { seen[side, tbl] = 1; torder[side, ++nt[side]] = tbl }
        h = $0; sub(/^[^|]*\|/, "", h); sub(/\|[ \t]*$/, "", h)
        nc = fields(h, cols)
        two[tbl] = (nc >= 2 && cols[2] == "line_num")
        tsc[tbl] = 0
        for (i = 1; i <= nc; i++) if (cols[i] == "updated_at") tsc[tbl] = i
        if (!tsc[tbl]) for (i = 1; i <= nc; i++) if (cols[i] == "heartbeat_at") tsc[tbl] = i
        if (!tsc[tbl]) for (i = 1; i <= nc; i++) if (cols[i] == "assessed_at") tsc[tbl] = i
        if (!tsc[tbl]) for (i = 1; i <= nc; i++) if (cols[i] == "claimed_at") tsc[tbl] = i
        idc[tbl] = (cols[1] == "id" || cols[1] == "bug_id")
        if (cols[1] == "id") for (i = 1; i <= nc; i++) if (cols[i] == "updated_at") bugts[tbl] = i
        next
    }
    {
        if (tbl == "") { if ($0 ~ /^[ \t]*$/) next; bad = 1; next }
        n = ++nl[side, tbl]; line[side, tbl, n] = $0
        if ($0 ~ /^[ \t]*$/ || $0 ~ /^[ \t]*#/) { isrow[side, tbl, n] = 0; next }
        isrow[side, tbl, n] = 1
        nf = fields($0, f)
        k = f[1]; if (two[tbl]) k = k SUBSEP f[2]
        key[side, tbl, n] = k
        cnt[side, tbl, k]++
        rowof[side, tbl, k] = $0
        ts[side, tbl, k] = tsc[tbl] ? f[tsc[tbl]] : ""
        txt[side, tbl, $0]++
        if (tbl in bugts) { if (!((side, f[1]) in bupd) || tbl == "bugs") bupd[side, f[1]] = f[bugts[tbl]] }
        lastrow[side, tbl] = n
    }
    function stamp(s, t, k,   id) {
        if (ts[s, t, k] != "") return ts[s, t, k]
        if (!idc[t]) return ""
        id = k; sub(SUBSEP ".*", "", id)
        return ((s, id) in bupd) ? bupd[s, id] : ""
    }
    function uniq(t, k) { return cnt[1, t, k] <= 1 && cnt[2, t, k] <= 1 && cnt[3, t, k] <= 1 }
    # decide a by-key row: sets OUT (text, "" = drop) and returns 0 clean / 1 conflict
    function decide(t, k,   o, a, b, ho, ha, hb, sa, sb) {
        ho = cnt[1, t, k] > 0; ha = cnt[2, t, k] > 0; hb = cnt[3, t, k] > 0
        o = rowof[1, t, k]; a = rowof[2, t, k]; b = rowof[3, t, k]
        OUT = ""
        if (ha && hb) {
            if (a == b || (ho && o == b)) { OUT = a; return 0 }
            if (ho && o == a) { OUT = b; return 0 }
            sa = stamp(2, t, k); sb = stamp(3, t, k)
            if (sa != "" && sb != "" && sa != sb) { OUT = (sa > sb) ? a : b; return 0 }
            CA = a; CB = b; return 1
        }
        if (ha) { if (!ho) { OUT = a; return 0 } ; if (o == a) return 0 ; CA = a; CB = ""; return 1 }
        if (hb) { if (!ho) { OUT = b; return 0 } ; if (o == b) return 0 ; CA = ""; CB = b; return 1 }
        return 0
    }
    function want(t, r,   o, a, b) {      # multiset result count for a whole row line
        o = txt[1, t, r] + 0; a = txt[2, t, r] + 0; b = txt[3, t, r] + 0
        if (a == b) return a
        if (a == o) return b
        if (b == o) return a
        return (a > b) ? a : b
    }
    function conflict(a, b) {
        print "<<<<<<< ours"; if (a != "") print a
        print "======="; if (b != "") print b
        print ">>>>>>> theirs"
        nconf++
    }
    function emit_extras(t,   i, k, r, need) {   # rows only theirs contributes
        for (i = 1; i <= nl[3, t]; i++) {
            if (!isrow[3, t, i]) continue
            k = key[3, t, i]; r = line[3, t, i]
            if (uniq(t, k)) {
                if (cnt[2, t, k] > 0 || (k in doneb)) continue
                doneb[k] = 1
                if (decide(t, k)) conflict(CA, CB); else if (OUT != "") print OUT
            } else {
                need = want(t, r) - (txt[2, t, r] + 0) - (r in usedb ? usedb[r] : 0)
                if (need > 0) { print r; usedb[r]++ }
            }
        }
    }
    function emit_table(t, pa, pb,   i, k, r) {
        delete doneb; delete useda; delete usedb
        print hdr[pa ? 2 : 3, t]
        if (pa) {
            for (i = 1; i <= nl[2, t]; i++) {
                r = line[2, t, i]
                if (!isrow[2, t, i]) { if (i > lastrow[2, t]) continue; print r; continue }
                k = key[2, t, i]
                if (uniq(t, k)) {
                    if (decide(t, k)) conflict(CA, CB); else if (OUT != "") print OUT
                } else {
                    useda[r]++
                    if (useda[r] <= want(t, r)) print r
                }
                if (i == lastrow[2, t] && pb) emit_extras(t)
            }
            if (!lastrow[2, t] && pb) emit_extras(t)
            for (i = lastrow[2, t] + 1; i <= nl[2, t]; i++) print line[2, t, i]
        } else {
            emit_extras(t)
            print ""
        }
    }
    END {
        if (side != 3 || bad) exit 3
        for (s = 2; s <= 3; s++) for (i = 1; i <= nt[s]; i++) {
            t = torder[s, i]
            if (((2, t) in seen) && ((3, t) in seen) && hdr[2, t] != hdr[3, t]) exit 3
        }
        for (i = 1; i <= nt[2]; i++) { t = torder[2, i]; emit_table(t, 1, ((3, t) in seen)) }
        for (i = 1; i <= nt[3]; i++) { t = torder[3, i]; if (!((2, t) in seen) && !((1, t) in seen)) emit_table(t, 0, 1) }
        exit (nconf > 0) ? 1 : 0
    }' "$1" "$2" "$3"
}

merge_files() { # base ours theirs [path] -> rewrites ours; rc 0 clean, 1 conflict
    _o=$1; _a=$2; _b=$3
    # CRLF (core.autocrlf / Windows editors) would end up inside the last
    # column and the CRC body; normalise every input to LF, and write LF.
    for _f in "$_o" "$_a" "$_b"; do
        if grep -q "$(printf '\r')" "$_f" 2>/dev/null; then
            tr -d '\r' < "$_f" > "$_f.lf.$$" && mv "$_f.lf.$$" "$_f"
        fi
    done
    if ! is_sealed_sdn "$_o" || ! is_sealed_sdn "$_a" || ! is_sealed_sdn "$_b"; then
        text_merge "$_o" "$_a" "$_b"; return $?
    fi
    _tmp="$_a.sdnrows.$$"
    : > "$_tmp"   # output is headerless: seals are .csm sidecars (run scripts/check/reseal-sdn-crc32.shs on the merged path)
    row_merge "$_o" "$_a" "$_b" >> "$_tmp"
    _rc=$?
    case $_rc in
        0) mv "$_tmp" "$_a" || return 1
           return 0 ;;
        1) mv "$_tmp" "$_a" || return 1
           echo "sdn-rows-merge: ${4:-$_a}: unresolvable row conflict (same id, same timestamp); markers left" >&2
           return 1 ;;
        *) rm -f "$_tmp"
           echo "sdn-rows-merge: ${4:-$_a}: unsupported layout; falling back to text merge" >&2
           text_merge "$_o" "$_a" "$_b"; return $? ;;
    esac
}

selftest() {
    SDN_SEAL_ALGO=crc32; export SDN_SEAL_ALGO   # fixtures need no external hasher
    _t=$(mktemp -d) && { _t=$(cygpath -m "$_t" 2>/dev/null || echo "$_t"); } || return 1   # native spelling for git under MSYS_NO_PATHCONV=1
    _fails=0; _n=0
    H='bugs |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|'
    L='bug_fix_claims |bug_id, state, session_id, claimed_at, heartbeat_at, prev_status, note|'
    mk() { # name, body (printf %b) -> sealed file
        printf '%b' "$2" > "$_t/$1"
    }
    r() { echo "    $1, P2, $2, t, f, 0, -, 2026-11-01, $3, true"; }
    base="$H\n$(r a open 2026-11-01)\n$(r b open 2026-11-01)\n\n$L\n    a, claimed, s1, 2026-11-01, 2026-11-01, open, x\n"

    # 1 disjoint rows on each side -> clean merge, both kept, seal valid
    _n=$((_n+1))
    mk o1 "$base"
    mk a1 "$H\n$(r a open 2026-11-01)\n$(r b open 2026-11-01)\n$(r c open 2026-11-02)\n\n$L\n    a, claimed, s1, 2026-11-01, 2026-11-01, open, x\n    c, claimed, s2, 2026-11-02, 2026-11-02, open, y\n"
    mk b1 "$H\n$(r a open 2026-11-01)\n$(r b open 2026-11-01)\n$(r d open 2026-11-02)\n\n$L\n    a, claimed, s1, 2026-11-01, 2026-11-01, open, x\n    d, claimed, s3, 2026-11-02, 2026-11-02, open, z\n"
    merge_files "$_t/o1" "$_t/a1" "$_t/b1" x 2>/dev/null; _rc=$?
    if [ $_rc -ne 0 ] || ! grep -q '^    c, P2' "$_t/a1" || ! grep -q '^    d, P2' "$_t/a1" \
        || ! grep -q 's2, 2026' "$_t/a1" || ! grep -q 's3, 2026' "$_t/a1" \
        ; then
        echo "selftest FAIL: disjoint rows (rc=$_rc)"; _fails=$((_fails+1))
    fi

    # 2 same id edited on both sides -> newer updated_at wins
    _n=$((_n+1))
    mk o2 "$base"
    mk a2 "$H\n$(r a fixed 2026-11-03)\n$(r b open 2026-11-01)\n\n$L\n    a, claimed, s1, 2026-11-01, 2026-11-01, open, x\n"
    mk b2 "$H\n$(r a wontfix 2026-11-02)\n$(r b open 2026-11-01)\n\n$L\n    a, claimed, s1, 2026-11-01, 2026-11-01, open, x\n"
    merge_files "$_t/o2" "$_t/a2" "$_t/b2" x 2>/dev/null; _rc=$?
    if [ $_rc -ne 0 ] || ! grep -q '^    a, P2, fixed' "$_t/a2" || grep -q wontfix "$_t/a2"; then
        echo "selftest FAIL: newer updated_at did not win (rc=$_rc)"; _fails=$((_fails+1))
    fi

    # 3 same id, same updated_at, different content -> exit 1 with markers
    _n=$((_n+1))
    mk o3 "$base"
    mk a3 "$H\n$(r a fixed 2026-11-03)\n$(r b open 2026-11-01)\n\n$L\n    a, claimed, s1, 2026-11-01, 2026-11-01, open, x\n"
    mk b3 "$H\n$(r a wontfix 2026-11-03)\n$(r b open 2026-11-01)\n\n$L\n    a, claimed, s1, 2026-11-01, 2026-11-01, open, x\n"
    merge_files "$_t/o3" "$_t/a3" "$_t/b3" x 2>/dev/null; _rc=$?
    if [ $_rc -ne 1 ] || ! grep -q '^<<<<<<< ours' "$_t/a3" || ! grep -q '^>>>>>>> theirs' "$_t/a3"; then
        echo "selftest FAIL: equal-timestamp conflict not fail-closed (rc=$_rc)"; _fails=$((_fails+1))
    fi

    # 4 row deleted on one side and unchanged on the other -> deleted
    _n=$((_n+1))
    mk o4 "$base"
    mk a4 "$H\n$(r a open 2026-11-01)\n\n$L\n    a, claimed, s1, 2026-11-01, 2026-11-01, open, x\n"
    mk b4 "$H\n$(r a open 2026-11-01)\n$(r b open 2026-11-01)\n$(r e open 2026-11-02)\n\n$L\n    a, claimed, s1, 2026-11-01, 2026-11-01, open, x\n"
    merge_files "$_t/o4" "$_t/a4" "$_t/b4" x 2>/dev/null; _rc=$?
    if [ $_rc -ne 0 ] || grep -q '^    b, P2' "$_t/a4" || ! grep -q '^    e, P2' "$_t/a4"; then
        echo "selftest FAIL: one-sided delete not honoured (rc=$_rc)"; _fails=$((_fails+1))
    fi

    # 5 the merged result passes the sdn-crc32 push gate checker (committed content)
    _n=$((_n+1))
    _g="$_t/repo"
    if git init -q "$_g" 2>/dev/null && git -C "$_g" config core.autocrlf false && mkdir -p "$_g/d" "$_g/config/check" \
        && printf 'seal_policy |glob, algo|\n    *.sdn, crc32\n' > "$_g/config/check/sdn_seal_policy.sdn" \
        && cp "$_t/a1" "$_g/d/db.sdn" && sh "$RESEAL" --no-selftest "$_g/d/db.sdn" >/dev/null \
        && git -C "$_g" add -A && git -C "$_g" -c user.name=t -c user.email=t@t commit -q -m t; then
        _v=$(sh "$SEALCHK" --no-selftest --rev HEAD --root "$_g" 2>/dev/null | tail -1)
        case "$_v" in PASS*) ;; *) echo "selftest FAIL: sealed-SDN checker rejected merge ($_v)"; _fails=$((_fails+1)) ;; esac
    else
        echo "selftest FAIL: could not build checker fixture repo"; _fails=$((_fails+1))
    fi

    # 6 a non-SDN input falls back to plain text merge
    _n=$((_n+1))
    printf 'x\n' > "$_t/o6"; printf 'x\ny\n' > "$_t/a6"; printf 'z\nx\n' > "$_t/b6"
    merge_files "$_t/o6" "$_t/a6" "$_t/b6" x 2>/dev/null; _rc=$?
    if [ $_rc -ne 0 ] || [ "$(cat "$_t/a6")" != "$(printf 'z\nx\ny')" ]; then
        echo "selftest FAIL: text-merge fallback (rc=$_rc)"; _fails=$((_fails+1))
    fi

    # 7 CRLF inputs merge like LF ones, result is LF and its seal matches the LF body
    _n=$((_n+1))
    mk o7 "$base"
    mk a7 "$H\n$(r a open 2026-11-01)\n$(r b open 2026-11-01)\n$(r c open 2026-11-02)\n\n$L\n    a, claimed, s1, 2026-11-01, 2026-11-01, open, x\n"
    mk b7 "$H\n$(r a open 2026-11-01)\n$(r b open 2026-11-01)\n$(r d open 2026-11-02)\n\n$L\n    a, claimed, s1, 2026-11-01, 2026-11-01, open, x\n"
    for _x in o7 a7 b7; do sed 's/$/\r/' "$_t/$_x" > "$_t/$_x.c" && mv "$_t/$_x.c" "$_t/$_x"; done
    merge_files "$_t/o7" "$_t/a7" "$_t/b7" x 2>/dev/null; _rc=$?
    if [ $_rc -ne 0 ] || grep -q "$(printf '\r')" "$_t/a7" || ! grep -q '^    c, P2' "$_t/a7" || ! grep -q '^    d, P2' "$_t/a7" \
        ; then
        echo "selftest FAIL: CRLF inputs (rc=$_rc)"; _fails=$((_fails+1))
    fi

    rm -rf "$_t"
    if [ $_fails -ne 0 ]; then echo "FAIL — $_fails of $_n selftest fixture(s) failed"; return 1; fi
    echo "PASS — $_n selftest fixture(s) passed"
    return 0
}

case "${1:-}" in
    --selftest) selftest; exit $? ;;
    ''|-h|--help) sed -n '2,45p' "$0"; exit 2 ;;
esac
[ $# -ge 3 ] || { echo "usage: sdn-rows-merge.shs <base> <ours> <theirs> [<path>]" >&2; exit 2; }
merge_files "$1" "$2" "$3" "${4:-}"
exit $?
