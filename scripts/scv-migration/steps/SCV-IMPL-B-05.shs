#!/bin/sh
# SCV-IMPL-B-05 — continuous native shadow write: every explicit revision
# dual-writes to the native shadow and is compared (tree, content, parent DAG,
# refs, reachability) on the commit path (store.spl scv_write_operation ->
# shadow_write.spl), with fail-closed report rows in
# .scv/meta/shadow_write_log.sdn. jj is broken on this host: the git side is
# the read-only backend_git/shadow path; nothing shells out to sj/jj.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED.
set -u
LIB="src/lib/scv/shadow_write.spl"
SPEC="test/integration/app/scv_shadow_write_spec.spl"
[ -f "$LIB" ] && [ -f "$SPEC" ] || { echo "ERROR — nothing was checked (missing files)"; exit 2; }
checked=0
bad=""
grep -q 'scv_shadow_write_on_operation' "$LIB" || bad="$bad trigger"
checked=$((checked + 1))
grep -q 'scv_shadow_write_on_operation(root)' src/lib/scv/store.spl || bad="$bad commit-path-wiring"
checked=$((checked + 1))
grep -q 'case "shadow-write"' src/app/scv/main.spl || bad="$bad cli-dispatch"
checked=$((checked + 1))
OUT="${TMPDIR:-/tmp}/SCV-IMPL-B-05.$$.log"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RESULTS=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
[ "$rc" -eq 0 ] || bad="$bad spec-rc($rc)"
case "$RESULTS" in
  *", 0 failed"*) : ;;
  "") bad="$bad spec(no-results-line)" ;;
  *) bad="$bad spec($RESULTS)" ;;
esac
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$bad" ]; then
  echo "PASS — $checked check(s): continuous trigger wired on commit path, $RESULTS"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$bad"
exit 1
