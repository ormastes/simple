#!/bin/sh
# SCV-IMPL-D-03 — refactoring-aware edit graph (raw hunks <-> entities <-> inferred refactoring ops, exposed as diff --view graph)
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED.
set -u
LIB="src/lib/scv/edit_graph.spl"
SPEC="test/integration/app/scv_edit_graph_spec.spl"
TWIN="$(printf '%s' "$SPEC" | sed 's|test/integration/|test/02_integration/|')"
[ -f "$LIB" ] && [ -f "$SPEC" ] && [ -f "$TWIN" ] || { echo "ERROR — nothing was checked (missing files)"; exit 2; }
checked=0
bad=""
cmp -s "$SPEC" "$TWIN" || bad="$bad twin-diverged"
checked=$((checked + 1))
grep -q "scv_edit_graph" src/lib/scv/three_view_diff.spl || bad="$bad view(graph)"
checked=$((checked + 1))
grep -q "^val SCV_EDIT_GRAPH_MAX_ANCHORS = " "$LIB" || bad="$bad bound(max-anchors)"
checked=$((checked + 1))
grep -q "export edit_graph" src/lib/scv/__init__.spl || bad="$bad init(export)"
checked=$((checked + 1))
OUT="${TMPDIR:-/tmp}/SCV-IMPL-D-03.$$.log"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RESULTS=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
[ "$rc" -eq 0 ] || bad="$bad spec-rc($rc)"
case "$RESULTS" in
  *", 0 failed"*) : ;;
  "") bad="$bad spec(no-results-line)" ;;
  *) bad="$bad spec($RESULTS)" ;;
esac
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$bad" ]; then
  echo "PASS — $checked check(s): edit graph wired, $RESULTS"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$bad"
exit 1
