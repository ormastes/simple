#!/bin/sh
# SCV-IMPL-G-04 — strict / mission_critical profiles: per-repo profile pin,
# forced_unparsed refused + unreachable under strict profiles, publication
# blocked on any forced audit; check-scv-mission-critical.shs gains the
# profile row in its DEFAULT scan.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED.
set -u
LIB="src/lib/scv/profiles.spl"
POLICY="src/lib/scv/commit_policy.spl"
STATE="src/lib/scv/state_model.spl"
GATE="scripts/check/check-scv-mission-critical.shs"
SPEC="test/integration/app/scv_profiles_spec.spl"
TWIN="test/02_integration/app/scv_profiles_spec.spl"
[ -f "$LIB" ] && [ -f "$POLICY" ] && [ -f "$STATE" ] && [ -f "$GATE" ] && [ -f "$SPEC" ] && [ -f "$TWIN" ] || { echo "ERROR — nothing was checked (missing files)"; exit 2; }
checked=0
bad=""
grep -q 'scv_profile_refuses_forced' "$POLICY" || bad="$bad policy(profile-seam)"
checked=$((checked + 1))
grep -q 'scv_state_transition_profile' "$STATE" || bad="$bad state(profile-seam)"
checked=$((checked + 1))
grep -q 'write_profile_probe 0' "$GATE" || bad="$bad gate(profile-row-not-in-default-scan)"
checked=$((checked + 1))
cmp -s "$SPEC" "$TWIN" || bad="$bad spec-twins-differ"
checked=$((checked + 1))
GATE_OUT=$(sh "$GATE" 2>&1)
GATE_RC=$?
GATE_LAST=$(printf '%s\n' "$GATE_OUT" | tail -1)
checked=$((checked + 1))
case "$GATE_LAST" in
  PASS*"profile row(s) enforced"*) [ "$GATE_RC" -eq 0 ] || bad="$bad gate-rc($GATE_RC)" ;;
  *) bad="$bad gate($GATE_LAST)" ;;
esac
OUT="${TMPDIR:-/tmp}/SCV-IMPL-G-04.$$.log"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RESULTS=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
[ "$rc" -eq 0 ] || bad="$bad spec-rc($rc)"
case "$RESULTS" in
  *", 0 failed"*) : ;;
  "") bad="$bad spec(no-results-line)" ;;
  *) bad="$bad spec($RESULTS)" ;;
esac
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$bad" ]; then
  echo "PASS — $checked check(s): profiles wired, gate: $GATE_LAST, $RESULTS"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$bad"
exit 1
