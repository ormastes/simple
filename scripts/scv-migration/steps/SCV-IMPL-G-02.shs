#!/bin/sh
# SCV-IMPL-G-02 — forced_unparsed path + audit: --force-unparsed requires --reason, recorded, never public_ready by default.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED.
set -u
LIB="src/lib/scv/commit_policy.spl"
SPEC="test/integration/app/scv_forced_unparsed_spec.spl"
[ -f "$LIB" ] && [ -f "$SPEC" ] || { echo "ERROR — nothing was checked (missing files)"; exit 2; }
checked=0
bad=""
grep -q "\\-\\-force-unparsed" src/app/scv/main.spl || bad="$bad dispatch(--force-unparsed)"
checked=$((checked + 1))
grep -q "scv_forced_unparsed_blocks_public" "$LIB" || bad="$bad lib(blocks_public)"
checked=$((checked + 1))
OUT="${TMPDIR:-/tmp}/SCV-IMPL-G-02.$$.log"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RESULTS=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
[ "$rc" -eq 0 ] || bad="$bad spec-rc($rc)"
case "$RESULTS" in
  *", 0 failed"*) : ;;
  "") bad="$bad spec(no-results-line)" ;;
  *) bad="$bad spec($RESULTS)" ;;
esac
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$bad" ]; then
  echo "PASS — $checked check(s): forced_unparsed wired + audited, $RESULTS"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$bad"
exit 1
