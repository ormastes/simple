#!/bin/sh
# SCV-IMPL-B-02 — mutating jj CLI adapter. This step does NOT accept "the command
# was built" as evidence: it creates a THROWAWAY jj repo (mktemp -d + jj git
# init), performs a real mutation through the adapter and through the sj lane,
# and reads the new state back with a machine-readable `-T` template. It also
# proves the version pin refuses rather than warns.
#
# SAFETY: every mutating call runs inside the mktemp scratch repo, and the script
# refuses to continue unless it has confirmed it is inside that path. Nothing here
# touches the real repository, and nothing here pushes.
#
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-IMPL-B-02.shs
set -u
REPO=$(pwd)
ADAPTER="src/lib/scv/jj_adapter.spl"
SPEC="test/02_integration/app/scv_jj_mutating_adapter_spec.spl"
HANDLER="src/app/sj_daemon/request_handler.spl"

[ -f "$ADAPTER" ] || { echo "ERROR — nothing was checked (missing adapter: $ADAPTER)"; exit 2; }
[ -f "$SPEC" ] || { echo "ERROR — nothing was checked (missing spec: $SPEC)"; exit 2; }
[ -f "$HANDLER" ] || { echo "ERROR — nothing was checked (missing sj handler: $HANDLER)"; exit 2; }
command -v jj >/dev/null 2>&1 || { echo "ERROR — nothing was checked (jj not on PATH; absence of the tool is absence of evidence)"; exit 2; }
[ -x "$REPO/bin/simple" ] || { echo "ERROR — nothing was checked (no deployed compiler at bin/simple)"; exit 2; }

checked=0
missing=""

# 1. The pin recorded in the adapter must match the installed jj.
PIN=$(sed -n 's/^val JJ_PINNED_VERSION = "\(.*\)"/\1/p' "$ADAPTER" | head -1)
JJV=$(jj --version 2>/dev/null | awk '{print $2}')
checked=$((checked + 1))
[ -n "$PIN" ] || missing="$missing pin-not-declared"
case "$JJV" in
  "$PIN"|"$PIN".*|"$PIN"-*) : ;;
  *) missing="$missing pin-mismatch(declared=$PIN installed=$JJV)" ;;
esac

# 2. The sj lane must actually EXECUTE, not echo the command it built.
TMP=$(mktemp -d "${TMPDIR:-/tmp}/scv-b02-step.XXXXXX") || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
cd "$TMP" 2>/dev/null || { echo "ERROR — nothing was checked (cannot enter scratch dir)"; exit 2; }
case "$(pwd)" in
  "$TMP"*) : ;;
  *) echo "ERROR — nothing was checked (refusing to run mutating jj outside the scratch repo)"; exit 2 ;;
esac
git init -q . >/dev/null 2>&1
jj git init --colocate >/dev/null 2>&1 || jj git init >/dev/null 2>&1
[ -d .jj ] || { cd "$REPO"; rm -rf "$TMP"; echo "ERROR — nothing was checked (could not create scratch jj repo)"; exit 2; }
printf 'alpha\n' > a.txt

"$REPO/bin/simple" run "$REPO/src/app/sj/main.spl" raw jj describe -m b02-step-wrote-this >/dev/null 2>&1
DESC=$(jj --no-pager --color never --ignore-working-copy log --no-graph -r @ -T description 2>/dev/null)
checked=$((checked + 1))
[ "$DESC" = "b02-step-wrote-this" ] || missing="$missing sj-lane-did-not-mutate(desc=[$DESC])"

# The old build-only behaviour returned the command string on stdout; a read
# through the lane must now return real jj output instead.
LOGOUT=$("$REPO/bin/simple" run "$REPO/src/app/sj/main.spl" raw jj log --no-graph -r @ -T 'change_id.short(8)' 2>/dev/null | tail -1)
checked=$((checked + 1))
case "$LOGOUT" in
  jj\ *|*--no-pager*) missing="$missing sj-lane-still-echoes-command([$LOGOUT])" ;;
  "") missing="$missing sj-lane-returned-nothing" ;;
  *) : ;;
esac

cd "$REPO" 2>/dev/null || { echo "ERROR — nothing was checked (lost the repo root)"; exit 2; }
rm -rf "$TMP"

# 3. The executable spec must be green.
SPEC_OUT="${TMPDIR:-/tmp}/SCV-IMPL-B-02.$$.spec"
SIMPLE_TIMEOUT_SECONDS=1800 "$REPO/bin/simple" test "$SPEC" > "$SPEC_OUT" 2>&1
RESULTS=$(grep -E '^Results:' "$SPEC_OUT" | tail -1)
rm -f "$SPEC_OUT"
checked=$((checked + 1))
case "$RESULTS" in
  *"0 failed"*) : ;;
  "") missing="$missing spec-produced-no-results-line" ;;
  *) missing="$missing spec-red([$RESULTS])" ;;
esac

# 4. The sj handler must genuinely call the adapter (guards against a silent
#    revert back to build-only).
checked=$((checked + 1))
grep -q "scv_jj_exec(handler.repo_path" "$HANDLER" || missing="$missing sj-handler-not-wired"

[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$missing" ]; then
  echo "PASS — $checked check(s): jj $JJV matches pin $PIN, sj lane executed a real mutation in a scratch repo, spec green ($RESULTS)"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$missing"
exit 1
