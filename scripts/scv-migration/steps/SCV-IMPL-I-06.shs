#!/bin/sh
# SCV-IMPL-I-06 — identity corrections CLI: scv identity
# link|unlink|split|merge|trace as logged operations; superseded rows aliased
# (edge:<n> references in .scv/meta/identity_corrections.sdn), never rewritten.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED.
set -u
LIB="src/lib/scv/identity_corrections.spl"
SPEC="test/integration/app/scv_identity_corrections_spec.spl"
[ -f "$LIB" ] && [ -f "$SPEC" ] || { echo "ERROR — nothing was checked (missing files)"; exit 2; }
checked=0
bad=""
for sym in scv_identity_correct_link scv_identity_correct_unlink scv_identity_correct_split scv_identity_correct_merge scv_identity_correct_trace; do
  grep -q "$sym" "$LIB" || bad="$bad $sym"
  checked=$((checked + 1))
done
grep -q 'case "identity"' src/app/scv/main.spl || bad="$bad cli-dispatch"
checked=$((checked + 1))
OUT="${TMPDIR:-/tmp}/SCV-IMPL-I-06.$$.log"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RESULTS=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
[ "$rc" -eq 0 ] || bad="$bad spec-rc($rc)"
case "$RESULTS" in
  *", 0 failed"*) : ;;
  "") bad="$bad spec(no-results-line)" ;;
  *) bad="$bad spec($RESULTS)" ;;
esac
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$bad" ]; then
  echo "PASS — $checked check(s): corrections CLI wired + logged, $RESULTS"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$bad"
exit 1
