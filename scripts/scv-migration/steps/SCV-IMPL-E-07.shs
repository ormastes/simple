#!/bin/sh
# SCV-IMPL-E-07 — bulk-update generation: checkout/rebase/branch-switch marks a generation (index dirty gen +1, coalescer held), defers per-file events with zero I/O folding duplicates, reconciles ONCE via the E-06 warm path.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 /
# ERROR exit 2. Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-IMPL-E-07.shs
set -u
MOD="src/lib/scv/bulk_update.spl"
SPEC="test/integration/app/scv_bulk_update_spec.spl"
TWIN="test/02_integration/app/scv_bulk_update_spec.spl"
[ -x bin/simple ] || { echo "ERROR — nothing was checked (missing bin/simple)"; exit 2; }
checked=0
missing=""
for f in "$MOD" "$SPEC" "$TWIN"; do
  checked=$((checked + 1))
  [ -f "$f" ] || missing="$missing missing($f)"
done
if [ -f "$SPEC" ] && [ -f "$TWIN" ]; then
  checked=$((checked + 1))
  cmp -s "$SPEC" "$TWIN" || missing="$missing twin-diverged($TWIN)"
fi
for sym in scv_bulk_begin scv_bulk_defer scv_bulk_end scv_bulk_active scv_bulk_deferred_count; do
  checked=$((checked + 1))
  grep -q "fn $sym" "$MOD" 2>/dev/null || missing="$missing no-fn($sym)"
done
for field in generation deferred reason; do
  checked=$((checked + 1))
  grep -q "$field" "$MOD" 2>/dev/null || missing="$missing no-field($field)"
done
checked=$((checked + 1))
grep -q "^export bulk_update\.\*" src/lib/scv/__init__.spl || missing="$missing not-exported(bulk_update)"
if [ -n "$missing" ]; then
  echo "FAIL — $checked check(s), unmet:$missing"
  exit 1
fi
OUT="${TMPDIR:-/tmp}/SCV-IMPL-E-07.$$.out"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
RES=$(grep -E '^Results: ' "$OUT" | tail -1)
rm -f "$OUT"
checked=$((checked + 1))
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
case "$RES" in
  "") echo "ERROR — nothing was checked (spec printed no Results line, rc=$rc)"; exit 2 ;;
  *" 0 failed"*) echo "PASS — $checked check(s): module+spec+twin present, surface + fields present, $RES"; exit 0 ;;
  *) echo "FAIL — $checked check(s), spec not green: $RES"; exit 1 ;;
esac
