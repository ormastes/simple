#!/bin/sh
# SCV-MIG-07 — PQ hash-based signing landed (trust lane): the migration checker itself
# verifies against the root public key.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-MIG-07.shs
set -u
VS="scripts/trust/verify-script.shs"
PUB="config/trust/scv_migration_root.pub"
TARGET="scripts/check/check-scv-migration-todo.shs"
for f in "$VS" "$PUB" "$TARGET"; do
  [ -f "$f" ] || { echo "ERROR — nothing was checked (missing: $f)"; exit 2; }
done
OUT="${TMPDIR:-/tmp}/SCV-MIG-07.$$.out"
sh "$VS" --public "$PUB" "$TARGET" > "$OUT" 2>&1
rc=$?
V="$(tail -n 1 "$OUT")"
rm -f "$OUT"
case "$V" in
  PASS*) [ "$rc" -eq 0 ] && { echo "PASS — $TARGET verified by $VS: $V"; exit 0; } ;;
esac
echo "FAIL — $TARGET not verified: $V (rc=$rc)"
exit 1
