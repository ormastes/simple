#!/bin/sh
# SCV-IMPL-P-06 — entity query packs per language (declaration kinds, name
# fields, signatures, scope parents, commutative lists, comment/doc nodes,
# reference rules; fallback decl nodes now carry `name:` anchor fields).
# Mechanical: verifies the module, its spec + mirror twin, exports, the
# symbol_entity hookup (TODO removed), and the acceptance spec's green run.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-IMPL-P-06.shs
set -u
checked=0
missing=""
for f in src/lib/scv/query_packs.spl \
         test/integration/app/scv_query_packs_spec.spl \
         test/02_integration/app/scv_query_packs_spec.spl; do
  checked=$((checked + 1))
  [ -f "$f" ] || missing="$missing file($f)"
done
checked=$((checked + 1))
grep -q '^export query_packs\.\*' src/lib/scv/__init__.spl || missing="$missing export(query_packs)"
checked=$((checked + 1))
grep -q 'scv/query-pack/v1' src/lib/scv/query_packs.spl || missing="$missing version(scv/query-pack/v1)"
checked=$((checked + 1))
grep -q 'scv_query_pack_extract_decls' src/lib/scv/symbol_entity.spl || missing="$missing symbol_entity-hookup"
checked=$((checked + 1))
grep -q 'TODO(SCV-IMPL-P-06)' src/lib/scv/symbol_entity.spl && missing="$missing stale-todo(symbol_entity)"
checked=$((checked + 1))
grep -q 'scv_query_pack_line_decls' src/lib/scv/parser.spl || missing="$missing parser-name-fields"
OUT="${TMPDIR:-/tmp}/SCV-IMPL-P-06.$$.out"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test test/integration/app/scv_query_packs_spec.spl > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RES=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
{ [ "$rc" -eq 0 ] && printf '%s' "$RES" | grep -q ', 0 failed'; } || missing="$missing spec-run(rc=$rc $RES)"
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$missing" ]; then
  echo "PASS — $checked check(s) verified, entity query packs green ($RES)"
  exit 0
fi
echo "FAIL — $checked check(s) verified, missing:$missing"
exit 1
