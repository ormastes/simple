#!/bin/sh
# SCV-MIG-17 — automatic Git bundle + backup replication (month plan §10 / priority 8):
# push current main to the secondary local backup server and write+verify a dated
# bundle, via the dual-push wrapper. GitHub leg is deliberately skipped here — the
# canonical GitHub push happens through scripts/check/land.shs on the normal landing
# path; this step only exercises the shadow/backup legs.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-MIG-17.shs
set -u
P="scripts/scv-migration/push-both.shs"
[ -f "$P" ] || { echo "ERROR — nothing was checked (missing: $P)"; exit 2; }
OUT="${TMPDIR:-/tmp}/SCV-MIG-17.$$.out"
sh "$P" --skip-github --bundle > "$OUT" 2>&1
rc=$?
V="$(tail -n 1 "$OUT")"
rm -f "$OUT"
case "$rc" in
  0) echo "PASS — backup leg + bundle [$V]"; exit 0 ;;
  2) echo "ERROR — nothing was checked (push-both: $V)"; exit 2 ;;
  *) echo "FAIL — push-both rc=$rc [$V]"; exit 1 ;;
esac
