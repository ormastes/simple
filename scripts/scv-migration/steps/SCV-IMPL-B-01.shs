#!/bin/sh
# SCV-IMPL-B-01 — sj-capsule transaction coordinator.
#
# Verifies the acceptance criterion from doc/03_plan/app/tools/scv_complete_impl_plan.md
# Track B: `bin/simple test test/integration/app/scv_sj_capsule_spec.spl` must
# report `0 failed`. The Results line is the ONLY thing that counts — a spec
# run that prints no Results line at all is an ERROR, never a pass.
#
# Also asserts the structural invariants the spec cannot assert about itself:
# the module, spec and its 02_integration twin exist, and the module carries no
# mutating jj/sj invocation (the jj lane is a declared SEAM, SCV-IMPL-B-02).
#
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-IMPL-B-01.shs
set -u

MODULE="src/lib/scv/sj_capsule.spl"
SPEC="test/integration/app/scv_sj_capsule_spec.spl"
TWIN="test/02_integration/app/scv_sj_capsule_spec.spl"
SIMPLE="bin/simple"

checked=0
missing=""

[ -f "$SIMPLE" ] || { echo "ERROR — nothing was checked (missing $SIMPLE)"; exit 2; }
[ -f "$MODULE" ] || { echo "ERROR — nothing was checked (missing $MODULE)"; exit 2; }
[ -f "$SPEC" ]   || { echo "ERROR — nothing was checked (missing $SPEC)"; exit 2; }

checked=$((checked + 1))
[ -f "$TWIN" ] || missing="$missing twin($TWIN)"

# All 12 report steps must be declared, in the module, by name.
for s in lease cursor_sync coalesce capture wal objects index jj_snapshot jj_read_ids backend_map publish release; do
  checked=$((checked + 1))
  grep -q "\"$s\"" "$MODULE" || missing="$missing step($s)"
done

# The seam must stay honest: no mutating jj/sj command may be shelled out.
checked=$((checked + 1))
# Comment lines are stripped first: this file DISCUSSES the sj lane at length.
if grep -v '^[[:space:]]*#' "$MODULE" | grep -qE '(process_run|shell_output|shell_bool|rt_shell_exec|shell\()'; then
  missing="$missing module-shells-out(jj lane must stay a seam)"
fi

# The default executor must be unavailable, never a fabricated pass.
checked=$((checked + 1))
grep -q 'mode: "unavailable"' "$MODULE" || missing="$missing default-executor-not-unavailable"

# Acceptance: the spec itself.
checked=$((checked + 1))
LOG="${TMPDIR:-/tmp}/SCV-IMPL-B-01.$$.log"
SIMPLE_TIMEOUT_SECONDS=1800 "$SIMPLE" test "$SPEC" > "$LOG" 2>&1
RESULTS=$(grep -E '^Results: [0-9]+ total' "$LOG" | tail -1)
rm -f "$LOG"
if [ -z "$RESULTS" ]; then
  echo "ERROR — nothing was checked (spec run produced no Results line)"
  exit 2
fi
case "$RESULTS" in
  *", 0 failed"*) : ;;
  *) missing="$missing spec($RESULTS)" ;;
esac

[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }

if [ -z "$missing" ]; then
  echo "PASS — $checked check(s): 12 steps declared, jj lane still a seam (default executor unavailable), $RESULTS"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$missing"
exit 1
