#!/bin/sh
# SCV-MIG-13 — read-only Git/jj sidecar backend adapter (scv backend
# status|map|verify): runs the integration spec and maps its result.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-MIG-13.shs
set -u
SPEC="test/integration/app/scv_backend_git_spec.spl"
[ -f "$SPEC" ] || { echo "ERROR — nothing was checked (missing: $SPEC)"; exit 2; }
[ -x bin/simple ] || { echo "ERROR — nothing was checked (missing: bin/simple)"; exit 2; }
OUT="${TMPDIR:-/tmp}/SCV-MIG-13.$$.out"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
RES="$(grep -E 'Results:' "$OUT" | tail -n 1)"
FAILS="$(grep -cE '^ *(FAIL|not ok)' "$OUT")"
rm -f "$OUT"
if [ -z "$RES" ]; then
  echo "ERROR — nothing was checked (no Results: line from bin/simple test, rc=$rc)"
  exit 2
fi
if [ "$rc" -eq 0 ] && [ "$FAILS" -eq 0 ]; then
  echo "PASS — backend adapter spec green [$RES]"
  exit 0
fi
echo "FAIL — backend adapter spec rc=$rc failures=$FAILS [$RES]"
exit 1
