#!/bin/sh
# SCV-MIG-08 — ledger + hourly checker + timer (migration lane): checker selftest is
# green and the hourly timer is installed.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-MIG-08.shs
set -u
C="scripts/check/check-scv-migration-todo.shs"
T="scripts/setup/install-scv-migration-timer.shs"
for f in "$C" "$T"; do
  [ -f "$f" ] || { echo "ERROR — nothing was checked (missing: $f)"; exit 2; }
done
OUT="${TMPDIR:-/tmp}/SCV-MIG-08.$$.out"
sh "$C" --selftest-only > "$OUT" 2>&1
rc1=$?
V1="$(tail -n 1 "$OUT")"
sh "$T" --check > "$OUT" 2>&1
rc2=$?
V2="$(tail -n 1 "$OUT")"
rm -f "$OUT"
if [ "$rc1" -eq 0 ] && [ "$rc2" -eq 0 ]; then
  echo "PASS — checker selftest [$V1]; timer [$V2]"; exit 0
fi
echo "FAIL — checker selftest rc=$rc1 [$V1]; timer rc=$rc2 [$V2]"
exit 1
