#!/bin/sh
# SCV-IMPL-B-06 — pack v2 hardening: reachability-aware native pack, delta
# fuzzing, GC-never-loses-reachable soak.
#   (a) `scv pack-write-v2r` walks the SAME MIG-21 GC root set (heads,
#       bookmarks/tags, changes, conflicts, checkpoint manifests, identity
#       commits) by IMPORTING maintenance.spl's scv_gc_roots_reachable — never a
#       copy — records the walked ids as `reach <id>` payload lines, and proves
#       after writing that every reachable loose object resolves back out of the
#       pack byte-identically. It FAILs rather than reporting success otherwise.
#   (b) `scv pack-fuzz-v2 <seed> <cases>` runs a bounded deterministic seeded-LCG
#       fuzz over chunk entry data (full and delta) with a forced non-zero XOR
#       mask; every corruption must be DETECTED by a content-hash mismatch or a
#       decode error, never silently decoded.
#   (c) `scv pack-soak-v2 <n>` runs n write/pack/gc-quarantine/verify cycles and
#       asserts after EACH cycle that every reachable object stays readable and
#       fsck stays clean.
# No format break: `reach` lines are skipped by the pre-existing v2 reader and
# v1 packs stay readable; both directions are spec-pinned.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED.
set -u
LIB="src/lib/scv/pack_v2.spl"
SPEC="test/integration/app/scv_pack_v2_spec.spl"
[ -f "$LIB" ] && [ -f "$SPEC" ] || { echo "ERROR — nothing was checked (missing files)"; exit 2; }
checked=0
bad=""
# reachability must REUSE the GC root walk, not reimplement it
grep -q 'use std.scv.maintenance.*scv_gc_roots_reachable' "$LIB" || bad="$bad gc-root-reuse"
checked=$((checked + 1))
grep -q 'fn scv_pack_write_v2_reachable' "$LIB" || bad="$bad reach-write"
checked=$((checked + 1))
grep -q 'fn scv_pack_v2_fuzz' "$LIB" || bad="$bad delta-fuzz"
checked=$((checked + 1))
grep -q 'fn scv_pack_v2_soak' "$LIB" || bad="$bad gc-soak"
checked=$((checked + 1))
# the fuzz must be seeded, never Math.random
grep -q 'scv_pack_v2_lcg_next' "$LIB" || bad="$bad seeded-lcg"
checked=$((checked + 1))
grep -q 'Math.random' "$LIB" && bad="$bad uses-math-random"
checked=$((checked + 1))
# v1 read support must survive
grep -q 'scv-pack-payload-v1' "$LIB" || bad="$bad v1-read-compat"
checked=$((checked + 1))
grep -q 'case "pack-write-v2r"' src/app/scv/main.spl || bad="$bad cli-dispatch"
checked=$((checked + 1))
OUT="${TMPDIR:-/tmp}/SCV-IMPL-B-06.$$.log"
SIMPLE_TIMEOUT_SECONDS=1800 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RESULTS=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
[ "$rc" -eq 0 ] || bad="$bad spec-rc($rc)"
case "$RESULTS" in
  *", 0 failed"*) : ;;
  "") bad="$bad spec(no-results-line)" ;;
  *) bad="$bad spec($RESULTS)" ;;
esac
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$bad" ]; then
  echo "PASS — $checked check(s): reachability-aware pack v2 + seeded delta fuzz + GC soak, $RESULTS"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$bad"
exit 1
