#!/bin/sh
# SCV-MIG-20 — S3 gate review (month plan W3): mechanical gate check.
# Verifies: (1) the S3 review doc exists, (2) every W3 sibling step
# (SCV-MIG-15..19) is marked done in the ledger .spipe/scv-migration/todo.sdn,
# (3) the migration checker dry-run PASSes. This step legitimately FAILs until
# the W3 siblings land — that is correct ordering, not a defect.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-MIG-20.shs
set -u

DOC="doc/03_plan/app/tools/scv_s3_review.md"
LEDGER=".spipe/scv-migration/todo.sdn"
CHECKER="scripts/check/check-scv-migration-todo.shs"

[ -f "$LEDGER" ] || { echo "ERROR — nothing was checked (missing ledger: $LEDGER)"; exit 2; }

CHECKED=0
FAILS=""

# 1) review doc
CHECKED=$((CHECKED+1))
if [ -f "$DOC" ]; then echo "review doc: OK ($DOC)"; else
  echo "review doc: MISSING ($DOC)"; FAILS="$FAILS review-doc"
fi

# 2) W3 siblings done in the ledger
for id in SCV-MIG-15 SCV-MIG-16 SCV-MIG-17 SCV-MIG-18 SCV-MIG-19; do
  CHECKED=$((CHECKED+1))
  LINE=$(grep "^[[:space:]]*$id," "$LEDGER" | head -n 1)
  ST=$(printf '%s' "$LINE" | cut -d, -f4 | tr -d ' ')
  if [ -z "$LINE" ]; then
    echo "$id: NOT IN LEDGER"; FAILS="$FAILS $id-missing"
  elif [ "$ST" = "done" ]; then
    echo "$id: done"
  else
    echo "$id: not done (status: ${ST:-unknown})"; FAILS="$FAILS $id"
  fi
done

# 3) checker dry-run must PASS
if [ -f "$CHECKER" ]; then
  CHECKED=$((CHECKED+1))
  COUT=$(sh "$CHECKER" --dry-run 2>&1); crc=$?
  CV=$(printf '%s\n' "$COUT" | tail -n 1)
  echo "checker dry-run: rc=$crc [$CV]"
  { [ "$crc" -eq 0 ] && [ "${CV#PASS}" != "$CV" ]; } || FAILS="$FAILS checker"
else
  CHECKED=$((CHECKED+1))
  echo "checker: MISSING ($CHECKER)"; FAILS="$FAILS checker-missing"
fi

if [ "$CHECKED" -eq 0 ]; then echo "ERROR — nothing was checked"; exit 2; fi
if [ -n "$FAILS" ]; then echo "FAIL — $CHECKED check(s) run, failing:$FAILS"; exit 1; fi
echo "PASS — $CHECKED check(s) run, S3 gate prerequisites all satisfied"
exit 0
