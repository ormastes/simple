#!/bin/sh
# SCV-IMPL-I-04 — refactoring relations (rename/move/move_rename/extract/inline/split/merge/pull_up/push_down/signature_change as many-to-many edges; anchors -> bounded GumTree-style -> RefactoringMiner-style rules)
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED.
set -u
LIB="src/lib/scv/refactoring_relations.spl"
SPEC="test/integration/app/scv_refactoring_relations_spec.spl"
TWIN="$(printf '%s' "$SPEC" | sed 's|test/integration/|test/02_integration/|')"
[ -f "$LIB" ] && [ -f "$SPEC" ] && [ -f "$TWIN" ] || { echo "ERROR — nothing was checked (missing files)"; exit 2; }
checked=0
bad=""
cmp -s "$SPEC" "$TWIN" || bad="$bad twin-diverged"
checked=$((checked + 1))
grep -q "^val SCV_REFACTOR_MAX_PAIRS = " "$LIB" || bad="$bad bound(max-pairs)"
checked=$((checked + 1))
grep -q "^val SCV_REFACTOR_AMBIGUITY_MARGIN_MILLI = " "$LIB" || bad="$bad bound(ambiguity-margin)"
checked=$((checked + 1))
for k in rename move move_rename extract inline split merge pull_up push_down signature_change; do grep -q "\"$k\"\|\"$k|" "$LIB" || grep -q "\"$k\b" "$LIB" || bad="$bad kind($k)"; done
checked=$((checked + 1))
grep -q "export refactoring_relations" src/lib/scv/__init__.spl || bad="$bad init(export)"
checked=$((checked + 1))
OUT="${TMPDIR:-/tmp}/SCV-IMPL-I-04.$$.log"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RESULTS=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
[ "$rc" -eq 0 ] || bad="$bad spec-rc($rc)"
case "$RESULTS" in
  *", 0 failed"*) : ;;
  "") bad="$bad spec(no-results-line)" ;;
  *) bad="$bad spec($RESULTS)" ;;
esac
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$bad" ]; then
  echo "PASS — $checked check(s): refactoring relations with bounds + ambiguity contract, $RESULTS"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$bad"
exit 1
