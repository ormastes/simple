#!/bin/sh
# SCV-IMPL-G-01 — explicit-commit parse policy: supported source requires a
# locked available parser + successful parse; unsupported text => text_only
# line mode; binary => bytes/chunks.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED.
set -u
LIB="src/lib/scv/commit_policy.spl"
SPEC="test/integration/app/scv_commit_parse_policy_spec.spl"
MAIN="src/app/scv/main.spl"
[ -f "$LIB" ] && [ -f "$SPEC" ] && [ -f "$MAIN" ] || { echo "ERROR — nothing was checked (missing files)"; exit 2; }
checked=0
bad=""
grep -q 'case "commit-policy"' "$MAIN" || bad="$bad dispatch(commit-policy)"
checked=$((checked + 1))
OUT="${TMPDIR:-/tmp}/SCV-IMPL-G-01.$$.log"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RESULTS=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
[ "$rc" -eq 0 ] || bad="$bad spec-rc($rc)"
case "$RESULTS" in
  *", 0 failed"*) : ;;
  "") bad="$bad spec(no-results-line)" ;;
  *) bad="$bad spec($RESULTS)" ;;
esac
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$bad" ]; then
  echo "PASS — $checked check(s): commit parse policy wired, $RESULTS"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$bad"
exit 1
