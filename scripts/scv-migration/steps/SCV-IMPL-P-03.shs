#!/bin/sh
# SCV-IMPL-P-03 — TRUE incremental parse: persistent ParserSession, exact TSInputEdit,
# changed_ranges, differential full-vs-incremental equivalence, fuzzed edits.
# Acceptance for the SCV complete-impl plan (doc/03_plan/app/tools/scv_complete_impl_plan.md).
# Runs the acceptance spec and maps its Results line to this step's verdict.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-IMPL-P-03.shs
# The checker (scripts/check/check-scv-migration-todo.shs) refuses to run it until then.
set -u
SPEC="test/integration/app/scv_incremental_parse_spec.spl"
[ -f "$SPEC" ] || { echo "ERROR — nothing was checked (missing: $SPEC)"; exit 2; }
OUT="${TMPDIR:-/tmp}/SCV-IMPL-P-03.$$.out"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
RES="$(grep -E '^Results: ' "$OUT" | tail -n 1)"
[ -n "$RES" ] || { tail -n 20 "$OUT"; rm -f "$OUT"; echo "ERROR — nothing was checked (no Results line from $SPEC; rc=$rc)"; exit 2; }
TOTAL="$(printf '%s' "$RES" | sed -n 's/^Results: \([0-9][0-9]*\) total.*/\1/p')"
FAILED="$(printf '%s' "$RES" | sed -n 's/.* \([0-9][0-9]*\) failed.*/\1/p')"
rm -f "$OUT"
[ -n "$TOTAL" ] && [ "$TOTAL" -gt 0 ] || { echo "ERROR — nothing was checked ($SPEC: $RES)"; exit 2; }
if [ "$FAILED" = "0" ] && [ "$rc" -eq 0 ]; then
  echo "PASS — $SPEC: $RES"
  exit 0
fi
echo "FAIL — $SPEC: $RES (rc=$rc)"
exit 1
