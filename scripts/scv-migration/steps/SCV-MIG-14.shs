#!/bin/sh
# SCV-MIG-14 — S1->S2 gate drill: SCV owns implicit snapshots and losing the
# whole .scv store is cheap. In a temp colocated git repo: init + snapshot +
# checkpoint, delete .scv entirely, re-init + re-snapshot, then assert
#   scv doctor PASS, scv fsck clean, scv db-index rebuild OK,
#   scv verify-backends --git PASS, and git fsck clean.
# (Folds the plan row's doctor+fsck+rebuild-db acceptance with the S2
# delete-and-recover drill; runs in a temp dir, not a copy of this repo.)
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-MIG-14.shs
set -u
REPO="$(pwd)"
[ -x "$REPO/bin/simple" ] || { echo "ERROR — nothing was checked (missing: bin/simple)"; exit 2; }
command -v git >/dev/null 2>&1 || { echo "ERROR — nothing was checked (git not installed)"; exit 2; }
TMP="$(mktemp -d "${TMPDIR:-/tmp}/scv-mig14.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
scv() { SIMPLE_LIB="$REPO/src" SIMPLE_TIMEOUT_SECONDS=0 "$REPO/bin/simple" run "$REPO/src/app/scv/main.spl" "$@"; }
cd "$TMP" || { echo "ERROR — nothing was checked (cannot enter temp dir)"; exit 2; }
mkdir work && cd work
printf 'alpha\n' > a.txt
mkdir -p sub && printf 'beta\n' > sub/b.txt
git init -q . && git add -A && git -c user.email=t@t -c user.name=t commit -q -m base \
  || { echo "ERROR — nothing was checked (temp git repo setup failed)"; exit 2; }
FAILED=""
CHECKS=0
run_step() { # name, expect-substring, cmd...
  name="$1"; want="$2"; shift 2
  out="$("$@" 2>&1)"
  rc=$?
  CHECKS=$((CHECKS + 1))
  case "$out" in
    *"$want"*) [ "$rc" -eq 0 ] || FAILED="$FAILED $name(rc=$rc)";;
    *) FAILED="$FAILED $name"; printf '%s failed:\n%s\n' "$name" "$out";;
  esac
}
run_step init1 "" scv init
run_step snapshot1 "" scv snapshot
run_step checkpoint1 "" scv checkpoint
[ -d .scv ] || { echo "ERROR — nothing was checked (.scv was never created)"; exit 2; }
rm -rf .scv
[ ! -d .scv ] || { echo "ERROR — nothing was checked (.scv deletion failed)"; exit 2; }
run_step reinit "" scv init
run_step resnapshot "" scv snapshot
run_step doctor "PASS" scv doctor
run_step fsck "OK checked=" scv fsck
run_step dbindex "" scv db-index
run_step verify_backends "PASS — 2 path(s) compared, 0 mismatches" scv verify-backends --git .
GITFSCK="$(git fsck --strict 2>&1)"
gfrc=$?
CHECKS=$((CHECKS + 1))
[ "$gfrc" -eq 0 ] || { FAILED="$FAILED git_fsck"; printf 'git fsck failed:\n%s\n' "$GITFSCK"; }
if [ -z "$FAILED" ]; then
  echo "PASS — $CHECKS drill step(s) green: .scv deleted and fully recovered; verify-backends + git fsck clean"
  exit 0
fi
echo "FAIL — drill step(s) failed:$FAILED"
exit 1
