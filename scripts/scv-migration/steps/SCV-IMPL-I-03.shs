#!/bin/sh
# SCV-IMPL-I-03 — SymbolEntityId + declaration extraction into persistent
# symbol_entity(+version) rows (interim .spl structural scanner; query-pack
# hookup is an explicit TODO on SCV-IMPL-P-06).
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED.
set -u
LIB="src/lib/scv/symbol_entity.spl"
SPEC="test/integration/app/scv_symbol_entity_spec.spl"
[ -f "$LIB" ] && [ -f "$SPEC" ] || { echo "ERROR — nothing was checked (missing files)"; exit 2; }
checked=0
bad=""
grep -q 'scv_symbol_extract_decls' "$LIB" || bad="$bad extractor"
checked=$((checked + 1))
grep -q 'scv_symbol_ingest' "$LIB" || bad="$bad ingest"
checked=$((checked + 1))
grep -q 'TODO(SCV-IMPL-P-06)' "$LIB" || bad="$bad query-pack-todo"
checked=$((checked + 1))
OUT="${TMPDIR:-/tmp}/SCV-IMPL-I-03.$$.log"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RESULTS=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
[ "$rc" -eq 0 ] || bad="$bad spec-rc($rc)"
case "$RESULTS" in
  *", 0 failed"*) : ;;
  "") bad="$bad spec(no-results-line)" ;;
  *) bad="$bad spec($RESULTS)" ;;
esac
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$bad" ]; then
  echo "PASS — $checked check(s): extractor + ingest wired, P-06 TODO recorded, $RESULTS"
  exit 0
fi
echo "FAIL — $checked check(s), unmet:$bad"
exit 1
