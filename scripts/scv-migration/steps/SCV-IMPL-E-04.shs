#!/bin/sh
# SCV-IMPL-E-04 — coalescer/settle layer (editor micro-batch, fs settle
# window, save immediate, VCS/bulk deferred; atomic-save tmp-write-rename
# coalesces to modify-target). Mechanical: verifies the module + spec + twin
# exist, the module exports the coalescer surface, and runs the acceptance
# spec. Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 /
# ERROR exit 2. Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-IMPL-E-04.shs
set -u
MOD="src/lib/scv/event_coalesce.spl"
SPEC="test/integration/lib/scv_event_coalesce_spec.spl"
TWIN="test/02_integration/lib/scv_event_coalesce_spec.spl"
[ -x bin/simple ] || { echo "ERROR — nothing was checked (missing bin/simple)"; exit 2; }
checked=0
missing=""
for f in "$MOD" "$SPEC" "$TWIN"; do
  checked=$((checked + 1))
  [ -f "$f" ] || missing="$missing missing($f)"
done
if [ -f "$SPEC" ] && [ -f "$TWIN" ]; then
  checked=$((checked + 1))
  cmp -s "$SPEC" "$TWIN" || missing="$missing twin-diverged($TWIN)"
fi
for sym in scv_coalesce_open scv_coalesce_add scv_coalesce_flush_ready scv_coalesce_bulk_end scv_coalesce_atomic_save; do
  checked=$((checked + 1))
  grep -q "fn $sym" "$MOD" 2>/dev/null || missing="$missing no-fn($sym)"
done
checked=$((checked + 1))
grep -q "^export event_coalesce\.\*" src/lib/scv/__init__.spl || missing="$missing not-exported(event_coalesce)"
if [ -n "$missing" ]; then
  echo "FAIL — $checked check(s), unmet:$missing"
  exit 1
fi
OUT="${TMPDIR:-/tmp}/SCV-IMPL-E-04.$$.out"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
RES=$(grep -E '^Results: ' "$OUT" | tail -1)
rm -f "$OUT"
checked=$((checked + 1))
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
case "$RES" in
  "") echo "ERROR — nothing was checked (spec printed no Results line, rc=$rc)"; exit 2 ;;
  *" 0 failed"*) echo "PASS — $checked check(s): module+spec+twin present, surface exported, $RES"; exit 0 ;;
  *) echo "FAIL — $checked check(s), spec not green: $RES"; exit 1 ;;
esac
