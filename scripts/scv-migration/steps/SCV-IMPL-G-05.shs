#!/bin/sh
# SCV-IMPL-G-05 — interface / HIR fingerprints via the Simple compiler
# frontend: syntactic_interface_id reuses compile_interface_digest
# (simple/compile-interface/v1), normalized_impl_hash reuses
# implementation_digest_of; typed_hir_hash is reported unavailable (no
# typed-HIR extractor) — names state the guarantee, no semantic overclaim.
# Mechanical: verifies the module, spec + mirror twin, export, compiler reuse
# (no second digest scheme), and the acceptance spec's green run.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-IMPL-G-05.shs
set -u
checked=0
missing=""
for f in src/lib/scv/hir_fingerprint.spl \
         test/integration/app/scv_hir_fingerprint_spec.spl \
         test/02_integration/app/scv_hir_fingerprint_spec.spl; do
  checked=$((checked + 1))
  [ -f "$f" ] || missing="$missing file($f)"
done
checked=$((checked + 1))
grep -q '^export hir_fingerprint\.\*' src/lib/scv/__init__.spl || missing="$missing export(hir_fingerprint)"
checked=$((checked + 1))
grep -q 'scv/hir-fingerprint/v1' src/lib/scv/hir_fingerprint.spl || missing="$missing version(scv/hir-fingerprint/v1)"
checked=$((checked + 1))
grep -q 'compile_interface.{compile_interface_digest}' src/lib/scv/hir_fingerprint.spl || missing="$missing compiler-reuse(compile_interface_digest)"
checked=$((checked + 1))
grep -q 'sha256_text' src/lib/scv/hir_fingerprint.spl && missing="$missing second-digest-scheme"
checked=$((checked + 1))
grep -q '"unavailable: no typed-HIR extractor' src/lib/scv/hir_fingerprint.spl || missing="$missing honest-typed-hir-status"
OUT="${TMPDIR:-/tmp}/SCV-IMPL-G-05.$$.out"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test test/integration/app/scv_hir_fingerprint_spec.spl > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RES=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
{ [ "$rc" -eq 0 ] && printf '%s' "$RES" | grep -q ', 0 failed'; } || missing="$missing spec-run(rc=$rc $RES)"
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$missing" ]; then
  echo "PASS — $checked check(s) verified, interface/HIR fingerprints green ($RES)"
  exit 0
fi
echo "FAIL — $checked check(s) verified, missing:$missing"
exit 1
