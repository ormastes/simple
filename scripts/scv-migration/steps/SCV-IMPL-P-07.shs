#!/bin/sh
# SCV-IMPL-P-07 — Neovim `scv/editor/v1` protocol: open_buffer / apply_edit /
# parser_changed_ranges / save / rename / refactor_transaction as a pure
# request→response layer over an abstract transport (in-process fold; the
# E-09 UDS wiring is a recorded TODO). Neovim trees/ranges are HINTS verified
# against bytes+artifact, never authoritative.
# Mechanical: verifies the module, spec + mirror twin, export, protocol
# version, authority statement, the E-09 TODO, that no lane-A editor-IPC
# module is imported, and the acceptance spec's green run.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-IMPL-P-07.shs
set -u
checked=0
missing=""
for f in src/lib/scv/nvim_protocol.spl \
         test/integration/app/scv_nvim_protocol_spec.spl \
         test/02_integration/app/scv_nvim_protocol_spec.spl; do
  checked=$((checked + 1))
  [ -f "$f" ] || missing="$missing file($f)"
done
checked=$((checked + 1))
grep -q '^export nvim_protocol\.\*' src/lib/scv/__init__.spl || missing="$missing export(nvim_protocol)"
checked=$((checked + 1))
grep -q 'scv/editor/v1' src/lib/scv/nvim_protocol.spl || missing="$missing version(scv/editor/v1)"
checked=$((checked + 1))
grep -q 'bytes+artifact' src/lib/scv/nvim_protocol.spl || missing="$missing authority(bytes+artifact)"
checked=$((checked + 1))
grep -q 'TODO(SCV-IMPL-E-09)' src/lib/scv/nvim_protocol.spl || missing="$missing todo(E-09-transport)"
checked=$((checked + 1))
grep -q 'use std\.scv\.editor_ipc' src/lib/scv/nvim_protocol.spl && missing="$missing lane-a-coupling(editor_ipc-import)"
OUT="${TMPDIR:-/tmp}/SCV-IMPL-P-07.$$.out"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test test/integration/app/scv_nvim_protocol_spec.spl > "$OUT" 2>&1
rc=$?
checked=$((checked + 1))
RES=$(grep 'Results:' "$OUT" | tail -1)
rm -f "$OUT"
{ [ "$rc" -eq 0 ] && printf '%s' "$RES" | grep -q ', 0 failed'; } || missing="$missing spec-run(rc=$rc $RES)"
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
if [ -z "$missing" ]; then
  echo "PASS — $checked check(s) verified, nvim editor protocol green ($RES)"
  exit 0
fi
echo "FAIL — $checked check(s) verified, missing:$missing"
exit 1
