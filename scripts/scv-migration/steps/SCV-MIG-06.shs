#!/bin/sh
# SCV-MIG-06 — critical lint profile + allocation bounds for src/lib/scv/** (mci lane)
# Runs scripts/check/check-scv-mission-critical.shs and forwards its verdict.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-MIG-06.shs
set -u
G="scripts/check/check-scv-mission-critical.shs"
[ -f "$G" ] || { echo "ERROR — nothing was checked (missing gate: $G)"; exit 2; }
OUT="${TMPDIR:-/tmp}/SCV-MIG-06.$$.out"
sh "$G" > "$OUT" 2>&1
rc=$?
V="$(tail -n 1 "$OUT")"
rm -f "$OUT"
case "$V" in
  PASS*) [ "$rc" -eq 0 ] && { echo "PASS — $G: $V"; exit 0; } ;;
  ERROR*) echo "ERROR — nothing was checked ($G: $V)"; exit 2 ;;
esac
echo "FAIL — $G: $V (rc=$rc)"
exit 1
