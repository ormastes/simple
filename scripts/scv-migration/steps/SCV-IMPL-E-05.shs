#!/bin/sh
# SCV-IMPL-E-05 — persistent binary worktree index (path key, mode, size,
# times, both ContentIds, FileId, clock, dirty/ignore generations; lifts
# pipe-delimited path limits). HONEST DEPENDENCY NOTE: plan row E-05 depends
# on B-04 (metadata DB, another lane) — this lands the index as its own
# binary store with a load/save/upsert/get/remove surface the B-04 DB
# migration adopts; the DB migration itself is NOT covered here.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 /
# ERROR exit 2. Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-IMPL-E-05.shs
set -u
MOD="src/lib/scv/worktree_index.spl"
SPEC="test/integration/app/scv_worktree_index_spec.spl"
TWIN="test/02_integration/app/scv_worktree_index_spec.spl"
[ -x bin/simple ] || { echo "ERROR — nothing was checked (missing bin/simple)"; exit 2; }
checked=0
missing=""
for f in "$MOD" "$SPEC" "$TWIN"; do
  checked=$((checked + 1))
  [ -f "$f" ] || missing="$missing missing($f)"
done
if [ -f "$SPEC" ] && [ -f "$TWIN" ]; then
  checked=$((checked + 1))
  cmp -s "$SPEC" "$TWIN" || missing="$missing twin-diverged($TWIN)"
fi
for sym in scv_wtindex_new scv_wtindex_upsert scv_wtindex_get scv_wtindex_remove scv_wtindex_save scv_wtindex_load; do
  checked=$((checked + 1))
  grep -q "fn $sym" "$MOD" 2>/dev/null || missing="$missing no-fn($sym)"
done
for field in worktree_content_id repository_content_id file_id dirty_generation ignore_generation; do
  checked=$((checked + 1))
  grep -q "$field" "$MOD" 2>/dev/null || missing="$missing no-field($field)"
done
checked=$((checked + 1))
grep -q "^export worktree_index\.\*" src/lib/scv/__init__.spl || missing="$missing not-exported(worktree_index)"
if [ -n "$missing" ]; then
  echo "FAIL — $checked check(s), unmet:$missing"
  exit 1
fi
OUT="${TMPDIR:-/tmp}/SCV-IMPL-E-05.$$.out"
SIMPLE_TIMEOUT_SECONDS=900 bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
RES=$(grep -E '^Results: ' "$OUT" | tail -1)
rm -f "$OUT"
checked=$((checked + 1))
[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
case "$RES" in
  "") echo "ERROR — nothing was checked (spec printed no Results line, rc=$rc)"; exit 2 ;;
  *" 0 failed"*) echo "PASS — $checked check(s): module+spec+twin present, index surface + fields present, $RES"; exit 0 ;;
  *) echo "FAIL — $checked check(s), spec not green: $RES"; exit 1 ;;
esac
