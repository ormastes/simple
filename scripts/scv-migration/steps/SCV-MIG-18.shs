#!/bin/sh
# SCV-MIG-18 — crash/fault-injection harness over the transaction hook
# (month plan W3, priority 9, stabilization §11). Runs the harness selftest
# (a deliberately-corrupting fixture must be caught as FAIL) and then the full
# sweep: all 6 fault points (content/tree/commit/operation/head/wal via
# SCV_FAULT_AFTER) plus the 3 chaos rows (wal-truncate, index-delete,
# head-delete), each asserting restart -> doctor -> journal recovery -> fsck
# -> repo equals a valid OLD or NEW state.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-MIG-18.shs
set -u
REPO="$(pwd)"
[ -x "$REPO/bin/simple" ] || { echo "ERROR — nothing was checked (missing: bin/simple)"; exit 2; }
[ -f "$REPO/scripts/check/check-scv-crash-harness.shs" ] || { echo "ERROR — nothing was checked (missing: check-scv-crash-harness.shs)"; exit 2; }

OUT=$(sh "$REPO/scripts/check/check-scv-crash-harness.shs" 2>&1)
RC=$?
printf '%s\n' "$OUT"
LAST=$(printf '%s\n' "$OUT" | tail -1)
case "$LAST" in
  "PASS — "*) echo "PASS — SCV-MIG-18: $LAST"; exit 0 ;;
  "FAIL — "*) echo "FAIL — SCV-MIG-18: $LAST"; exit 1 ;;
  *) echo "ERROR — nothing was checked (harness rc=$RC, last line: $LAST)"; exit 2 ;;
esac
