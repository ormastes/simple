#!/bin/sh
set -eu

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 2
cd "$ROOT"

fail() { echo "check-github-policy-projection: FAIL — $*" >&2; exit 1; }

workflow_dispatch_input_keys() {
    awk '
      $0 == "  workflow_dispatch:" { in_dispatch = 1; next }
      in_dispatch && $0 == "    inputs:" { in_inputs = 1; next }
      in_inputs {
        raw = $0
        stripped = raw
        sub(/^ */, "", stripped)
        if (stripped == "" || stripped ~ /^#/) next
        indent = length(raw) - length(stripped)
        if (indent <= 4) exit
        if (indent == 6) {
          key = stripped
          sub(/:.*/, "", key)
          if (key ~ /^[A-Za-z0-9_-]+$/) print key
        }
      }
      in_dispatch && $0 ~ /^  [^ ]/ { exit }
    ' "$1"
}

sh -n scripts/release/github-policy.shs || fail "github policy tool does not parse"
sh -n scripts/release/candidate-ref-create.shs || fail "candidate ref tool does not parse"
sh -n scripts/release/converge-reviewed-fix.shs || fail "convergence preparation tool does not parse"
sh -n scripts/release/verify-forward-port-authority.shs ||
    fail "forward-port authority verifier does not parse"
[ -z "$(find scripts/release -maxdepth 1 -type f \( -name '*.sh' -o -name '*.bash' \) -print)" ] ||
    fail "release-local shell scripts must use the canonical .shs extension"

for file in .github/rulesets/spipe-vcs-v3-*.json .github/*-environment.json; do
    jq -e . "$file" >/dev/null || fail "invalid JSON: $file"
done
jq -e '
  .schema == "spipe-review-admission-broker/1" and
  .configured == false and .apply_live == false and
  .implementation_status == "unsupported_until_external_signed_broker" and
  .signed_receipt_protocol == "unimplemented" and
  .github_app_integration_id == null and
  .environment_protection_rule_app_id == null and
  .planned_ruleset_required_check ==
    {context:"SPipe Review Admission",integration_id:null} and
  .planned_environment_custom_protection ==
    {app_id:null,preserve_required_reviewers:true} and
  .status_context == "SPipe Review Admission" and
  .authorized_dispatcher == {type:"User",id:2378857} and
  .fallback_reason == "no eligible independent reviewer" and
  .owner_convergence_fallback == {
    configured:true,authority_class:"owner_attested_actions",
    workflow:".github/workflows/pr-admission.yml",trusted_ref:"refs/heads/main",
    environment:"owner-convergence-admission",
    environment_projection:".github/owner-convergence-admission-environment.json",
    authorized_actor:{type:"User",id:2378857},
    owner_attestation:"NO-VERIFY:OWNER-PROOF",verification_performed:false,
    github_pr_approval_claimed:false,ttl_seconds:28800,
    external_broker_must_be_unavailable:true,candidate_content_is_data_only:true} and
  .privileged_self_review.schema == "spipe-self-review-decision/1" and
  .privileged_self_review.configured == true and
  .privileged_self_review.default_allow == true and
  .privileged_self_review.review_evidence_mode == "self_attested" and
  .privileged_self_review.self_attestation_is_independent_authentication == false and
  .privileged_self_review.external_policy_db_secret == "SPIPE_SELF_REVIEW_POLICY_DB" and
  .privileged_self_review.required_check ==
    {context:"SPipe Self Review Admission",integration_id:15368} and
  .privileged_self_review.workflow == ".github/workflows/review-admission.yml" and
  .privileged_self_review.trusted_default_branch == "main" and
  .privileged_self_review.environment == "self-review-admission" and
  .privileged_self_review.repository_actions_default_permissions == "read" and
  .privileged_self_review.workflow_permissions_projection == ".github/actions-workflow-permissions.json" and
  .privileged_self_review.environment_projection == ".github/self-review-admission-environment.json" and
  .privileged_self_review.apply_live == true and
  .privileged_self_review.apply_live_mode == "self_attested_generic_actions" and
  .privileged_self_review.generic_actions_app_trust_accepted == true and
  .privileged_self_review.generic_actions_app_is_independent_security_identity == false and
  .privileged_self_review.server_resolved_head_base_merge_base_diff_and_ruleset == true and
  .privileged_self_review.normalized_ruleset_digest_required == true and
  .privileged_self_review.ruleset_projection_version_required == true and
  .privileged_self_review.strict_up_to_date == true and
  .privileged_self_review.protected_target == true and
  .privileged_self_review.decision_ttl_seconds == 600 and
  .privileged_self_review.scheduled_invalidator_is_backup == true and
  .privileged_self_review.immediate_pull_request_target_events == ["synchronize","edited","closed","reopened"] and
  .privileged_self_review.protected_base_push_invalidation == true and
  .privileged_self_review.repository_dispatch_invalidation == ["self_review_policy_changed","self_review_ruleset_changed"] and
  .privileged_self_review.candidate_admission_receipt_schema == "spipe-review-admission/1" and
  .privileged_self_review.self_review_decision_can_authorize_release_candidate == false and
  .privileged_self_review.provider_approval_claimed == false' \
  .github/review-admission-broker.json >/dev/null ||
    fail "unconfigured dedicated review broker plan is not fail-closed"

[ "$(find .github -maxdepth 1 -name '*-environment.json' | wc -l)" -eq 5 ] ||
    fail "expected five managed environments including owner-convergence-admission"
jq -e '.default_workflow_permissions == "read" and
       .can_approve_pull_request_reviews == false' \
    .github/actions-workflow-permissions.json >/dev/null ||
    fail "repository Actions workflow permissions are not read-only"
jq -e '.wait_timer == 0 and .prevent_self_review == false and
       .reviewers == [] and .deployment_branch_policy ==
         {protected_branches:true,custom_branch_policies:false}' \
    .github/self-review-admission-environment.json >/dev/null ||
    fail "self-review-admission environment projection is stale"
jq -e '.wait_timer == 0 and .prevent_self_review == false and
       .reviewers == [{type:"User",id:2378857}] and .deployment_branch_policy ==
         {protected_branches:true,custom_branch_policies:false}' \
    .github/owner-convergence-admission-environment.json >/dev/null ||
    fail "owner-convergence-admission environment projection is stale"

rendered=$(scripts/release/github-policy.shs render)
[ "$(printf '%s' "$rendered" | jq 'length')" -eq 7 ] || fail "expected seven rulesets"

for name in candidates version-tags; do
    file=".github/rulesets/spipe-vcs-v3-$name.json"
    jq -e '([.rules[].type] | sort) == (["deletion","non_fast_forward","update"] | sort)' "$file" >/dev/null ||
        fail "$name must be immutable after creation"
    jq -e '(.bypass_actors // []) | length == 0' "$file" >/dev/null ||
        fail "$name must not have an immutability bypass"
done

for name in candidate-creation version-tag-creation; do
    file=".github/rulesets/spipe-vcs-v3-$name.json"
    jq -e '[.rules[].type] == ["creation"]' "$file" >/dev/null ||
        fail "$name must restrict creation"
    jq -e '.bypass_actors == [{"actor_id":2378857,"actor_type":"User","bypass_mode":"always"}]' "$file" >/dev/null ||
        fail "$name must bind creation to the repository owner authority"
done

jq -e '[.rules[].type] | index("pull_request") != null' \
    .github/rulesets/spipe-vcs-v3-main.json >/dev/null || fail "main is not PR-only"
jq -e '[.rules[].type] | index("pull_request") != null' \
    .github/rulesets/spipe-vcs-v3-release-lines.json >/dev/null || fail "release lines are not PR-only"

required_check='[{"context":"Code Idiom & Structural Ratchet Gates","integration_id":15368},{"context":"SPipe Self Review Admission","integration_id":15368}]'
for profile in main release-lines; do
    file=".github/rulesets/spipe-vcs-v3-$profile.json"
    jq -e --argjson required "$required_check" '
        ([.rules[] | select(.type == "pull_request")][0].parameters |
          .required_approving_review_count == 0 and
          .require_code_owner_review == false and
          .require_last_push_approval == false) and
        ([.rules[] | select(.type == "required_status_checks")][0].parameters |
          .strict_required_status_checks_policy == true and
          .do_not_enforce_on_create == false and
          .required_status_checks == $required)' "$file" >/dev/null ||
        fail "$profile review/check projection does not match canonical protected policy"
done

jq -e '([.rules[] | select(.type == "pull_request")][0].parameters.allowed_merge_methods) == ["merge"]' \
    .github/rulesets/spipe-vcs-v3-release-lines.json >/dev/null ||
    fail "release-line admission requires an exact two-parent merge"
rg -q "branches: \[main, master, develop, 'release/\*\*'\]" \
    .github/workflows/repo-hygiene.yml ||
    fail "configured release-line check does not run on release pull requests"

[ "$(rg -c 'approving_reviews: 0' .spipe/policy/vcs.sdn)" -eq 2 ] ||
    fail "canonical approval counts are stale"
rg -q 'context: Code Idiom & Structural Ratchet Gates' .spipe/policy/vcs.sdn ||
    fail "canonical required check name is missing"
rg -q 'integration_id: 15368' .spipe/policy/vcs.sdn ||
    fail "canonical required check app identity is missing"
rg -q 'beta_backport_source_result_equivalence: stable_patch_id' .spipe/policy/vcs.sdn ||
    fail "canonical backport source/result equivalence is missing"
rg -q 'beta_backport_provider_receipt: required' .spipe/policy/vcs.sdn ||
    fail "canonical backport provider receipt requirement is missing"
rg -q 'current_mode: independent_environment_review' .spipe/policy/vcs.sdn ||
    fail "canonical environment approval mode is stale"
rg -q 'prevent_self_review: true' .spipe/policy/vcs.sdn ||
    fail "canonical self-review policy is stale"
rg -q 'id: 2378857' .spipe/policy/vcs.sdn ||
    fail "canonical environment reviewer identity is stale"
rg -q 'release_claim: approval_gated' .spipe/policy/vcs.sdn ||
    fail "canonical release claim is stale"
rg -q 'schema: spipe-review-admission/1' .spipe/policy/vcs.sdn ||
    fail "closed review admission schema is missing"
rg -q 'preference: independent_high_capability_model' .spipe/policy/vcs.sdn ||
    fail "independent high-capability model review is not preferred"
rg -q 'minimum_effort: high' .spipe/policy/vcs.sdn ||
    fail "independent review minimum effort is missing"
rg -q 'reason: no eligible independent reviewer' .spipe/policy/vcs.sdn ||
    fail "owner fallback reason is not exact"
rg -q 'unavailable_verifier_receipt_sha256: required' .spipe/policy/vcs.sdn ||
    fail "owner fallback lacks verifier-unavailability evidence"
rg -q 'integration_id: provider_config_required' .spipe/policy/vcs.sdn ||
    fail "dedicated broker App identity is not fail-closed"
rg -q 'admin_bypass: deny' .spipe/policy/vcs.sdn ||
    fail "review admission permits an admin bypass"
rg -q 'live_apply: unsupported_until_external_signed_broker' .spipe/policy/vcs.sdn ||
    fail "unconfigured review broker does not block live apply"
rg -q 'live_apply: self_attested_generic_actions_only' .spipe/policy/vcs.sdn ||
    fail "privileged self-review generic Actions live apply is missing"
rg -q 'broker_signed_live_apply: require_configured_external_signed_broker' .spipe/policy/vcs.sdn ||
    fail "broker-signed self-review does not fail closed"
rg -q 'required_status_context: SPipe Self Review Admission' .spipe/policy/vcs.sdn ||
    fail "privileged self-review status context is missing"
rg -q 'default_allow: true' .spipe/policy/self-review-policy.sdn ||
    fail "self-review checked-in projection is not default allow"
rg -q 'checked_in_grants: forbidden' .spipe/policy/self-review-policy.sdn ||
    fail "pull-request worktree can grant self-review authority"
rg -q 'workflow_dispatch:' .github/workflows/review-admission.yml ||
    fail "server-side review dispatch workflow is missing"
rg -q 'pull_request_number:' .github/workflows/review-admission.yml ||
    fail "review dispatch does not identify the pull request"
positive_fixture=scripts/check/fixtures/github-policy/review-dispatch-inputs-positive.yml
negative_fixture=scripts/check/fixtures/github-policy/review-dispatch-inputs-negative.yml
positive_keys=$(workflow_dispatch_input_keys "$positive_fixture")
[ "$positive_keys" = "pull_request_number
expected_head_sha
session_id" ] || fail "positive dispatch-input fixture was not bounded to inputs"
negative_keys=$(workflow_dispatch_input_keys "$negative_fixture")
printf '%s\n' "$negative_keys" | rg -qx 'head_sha' ||
    fail "negative dispatch-input fixture did not expose caller head_sha"
dispatch_keys=$(workflow_dispatch_input_keys .github/workflows/review-admission.yml)
printf '%s\n' "$dispatch_keys" | rg -qx 'pull_request_number' ||
    fail "review dispatch does not declare pull_request_number as an input"
printf '%s\n' "$dispatch_keys" | rg -qx 'expected_head_sha' ||
    fail "review dispatch does not bind the completed review to an expected head SHA"
printf '%s\n' "$dispatch_keys" | rg -qx 'session_id' ||
    fail "review dispatch does not declare session_id as an input"
for key in reviewer_model reviewer_effort self_attestation; do
    printf '%s\n' "$dispatch_keys" | rg -qx "$key" ||
        fail "review dispatch does not carry explicit self-attestation field: $key"
done
if printf '%s\n' "$dispatch_keys" | rg -q '^candidate_commit_sha$|^head_sha$'; then
    fail "review dispatch must resolve the live PR head and compare it with expected_head_sha"
fi
rg -Fq 'test "$head_sha" = "$EXPECTED_HEAD_SHA"' .github/workflows/review-admission.yml ||
    fail "review dispatch does not reject a live-head mismatch"
rg -q 'checks: write' .github/workflows/review-admission.yml ||
    fail "self-review broker cannot publish the exact-head required check"
rg -q 'environment: self-review-admission' .github/workflows/review-admission.yml ||
    fail "self-review broker is not gated by the dedicated environment"
rg -q "review_evidence_mode:\"self_attested\"" .github/workflows/review-admission.yml ||
    fail "self-review broker masquerades caller evidence as authenticated higher-model review"
rg -q 'conclusion:"action_required"' .github/workflows/review-admission.yml ||
    fail "self-review broker does not reset expired successful checks"
rg -q 'provider_approval_claimed == false' .github/workflows/review-admission.yml ||
    fail "self-review broker does not reject a false provider approval claim"
rg -q 'SPIPE_SELF_REVIEW_POLICY_DB' .github/workflows/review-admission.yml ||
    fail "self-review broker does not load operator-owned policy state"

for environment in protected-integration release npm-release; do
    jq -e '.prevent_self_review == true and
           .reviewers == [{"type":"User","id":2378857}]' \
        ".github/$environment-environment.json" >/dev/null ||
        fail "$environment environment reviewer projection is stale"
done

owner_workflow=.github/workflows/pr-admission.yml
candidate_workflow=.github/workflows/candidate.yml
for token in \
  'default: external_broker' \
  'options: [external_broker, owner_attested_actions]' \
  "test \"\$OWNER_ATTESTATION\" = 'NO-VERIFY:OWNER-PROOF'" \
  "test \"\$EVENT_REF\" = refs/heads/main" \
  '.actor.id == 2378857 and .triggering_actor.id == 2378857' \
  'owner-convergence-admission' \
  'verification_performed:false' \
  'github_pr_approval_claimed:false' \
  'verifier-unavailability-proof.json' \
  'git show "$CANDIDATE_COMMIT:.github/release-convergence-manifest.json"'; do
    rg -Fq "$token" "$owner_workflow" || fail "owner convergence workflow misses: $token"
done
for token in \
  'artifact-ids: ${{ inputs.convergence_artifact_id }}' \
  '.digest == $digest and .expired == false' \
  '--signer-workflow' \
  '--signer-digest "$run_head"' \
  '--source-ref refs/heads/main' \
  '--deny-self-hosted-runners' \
  'verificationResult.signature.certificate'; do
    rg -Fq -- "$token" "$candidate_workflow" || fail "candidate fallback consumer misses: $token"
done
rg -Fq 'scripts/release/verify-forward-port-authority.shs' "$candidate_workflow" ||
    fail "candidate does not execute authority-specific forward-port validation"
if rg -Fq -- '--cert-identity' "$candidate_workflow"; then
    fail "candidate combines mutually exclusive signer-workflow and cert-identity selectors"
fi
attestation_semantics=test/fixture/github/gh_attestation_verify_semantics.json
jq -e '
  .schema == "github-cli-attestation-verify-semantics/1" and
  .mutually_exclusive_flag_group ==
    ["cert-identity","cert-identity-regex","signer-repo","signer-workflow"]' \
  "$attestation_semantics" >/dev/null ||
    fail "GitHub CLI attestation selector semantic fixture is stale"
jq -e --arg identity \
  'https://github.com/ormastes/simple/.github/workflows/pr-admission.yml@refs/heads/main' \
  --arg digest '0123456789abcdef0123456789abcdef01234567' '
  .verification_output | length > 0 and all(.[];
    .verificationResult.signature.certificate as $certificate |
    $certificate.subjectAlternativeName == $identity and
    $certificate.buildSignerURI == $identity and
    $certificate.buildSignerDigest == $digest and
    $certificate.runnerEnvironment == "github-hosted" and
    $certificate.sourceRepositoryURI == "https://github.com/ormastes/simple" and
    $certificate.sourceRepositoryRef == "refs/heads/main")' \
  "$attestation_semantics" >/dev/null ||
    fail "GitHub CLI attestation certificate identity fixture is stale"

for projection in \
    spipe-vcs-v3-main.json \
    spipe-vcs-v3-release-lines.json \
    spipe-vcs-v3-candidates.json \
    spipe-vcs-v3-review-recovery.json \
    spipe-vcs-v3-version-tags.json; do
    rg -q "$projection" .spipe/policy/vcs.sdn || fail "policy does not bind $projection"
done

for projection in spipe-vcs-v3-candidate-creation.json spipe-vcs-v3-version-tag-creation.json; do
    rg -q "$projection" .spipe/policy/vcs.sdn || fail "policy does not bind $projection"
done

rg -q 'immutable_releases: required' .spipe/policy/vcs.sdn || fail "immutable release authority missing"
for environment in protected-integration release npm-release; do
    rg -q "$environment-environment.json" .spipe/policy/vcs.sdn ||
        fail "policy does not bind $environment environment"
done
echo "check-github-policy-projection: PASS — PR-only protection uses short-lived exact-state self-review admission; release environments remain independently protected"
