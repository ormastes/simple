#!/bin/sh
set -eu

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 2
cd "$ROOT"

fail() { echo "check-github-policy-projection: FAIL — $*" >&2; exit 1; }

sh -n scripts/release/github-policy.sh || fail "github policy tool does not parse"
sh -n scripts/release/candidate-ref-create.sh || fail "candidate ref tool does not parse"

for file in .github/rulesets/spipe-vcs-v3-*.json .github/*-environment.json; do
    jq -e . "$file" >/dev/null || fail "invalid JSON: $file"
done

[ "$(find .github -maxdepth 1 -name '*-environment.json' | wc -l)" -eq 3 ] ||
    fail "expected protected-integration, release, and npm-release environments"

rendered=$(scripts/release/github-policy.sh render)
[ "$(printf '%s' "$rendered" | jq 'length')" -eq 7 ] || fail "expected seven rulesets"

for name in candidates version-tags; do
    file=".github/rulesets/spipe-vcs-v3-$name.json"
    jq -e '([.rules[].type] | sort) == (["deletion","non_fast_forward","update"] | sort)' "$file" >/dev/null ||
        fail "$name must be immutable after creation"
    jq -e '(.bypass_actors // []) | length == 0' "$file" >/dev/null ||
        fail "$name must not have an immutability bypass"
done

for name in candidate-creation version-tag-creation; do
    file=".github/rulesets/spipe-vcs-v3-$name.json"
    jq -e '[.rules[].type] == ["creation"]' "$file" >/dev/null ||
        fail "$name must restrict creation"
    jq -e '.bypass_actors == [{"actor_id":2378857,"actor_type":"User","bypass_mode":"always"}]' "$file" >/dev/null ||
        fail "$name must bind creation to the repository owner authority"
done

jq -e '[.rules[].type] | index("pull_request") != null' \
    .github/rulesets/spipe-vcs-v3-main.json >/dev/null || fail "main is not PR-only"
jq -e '[.rules[].type] | index("pull_request") != null' \
    .github/rulesets/spipe-vcs-v3-release-lines.json >/dev/null || fail "release lines are not PR-only"

required_check='[{"context":"Code Idiom & Structural Ratchet Gates","integration_id":15368}]'
for profile in main release-lines; do
    file=".github/rulesets/spipe-vcs-v3-$profile.json"
    jq -e --argjson required "$required_check" '
        ([.rules[] | select(.type == "pull_request")][0].parameters |
          .required_approving_review_count == 1 and
          .require_code_owner_review == true and
          .require_last_push_approval == true) and
        ([.rules[] | select(.type == "required_status_checks")][0].parameters |
          .strict_required_status_checks_policy == true and
          .do_not_enforce_on_create == false and
          .required_status_checks == $required)' "$file" >/dev/null ||
        fail "$profile review/check projection does not match canonical protected policy"
done

jq -e '([.rules[] | select(.type == "pull_request")][0].parameters.allowed_merge_methods) == ["merge"]' \
    .github/rulesets/spipe-vcs-v3-release-lines.json >/dev/null ||
    fail "release-line admission requires an exact two-parent merge"
rg -q "branches: \[main, master, develop, 'release/\*\*'\]" \
    .github/workflows/repo-hygiene.yml ||
    fail "configured release-line check does not run on release pull requests"

[ "$(rg -c 'approving_reviews: 1' .spipe/policy/vcs.sdn)" -eq 2 ] ||
    fail "canonical approval counts are stale"
rg -q 'context: Code Idiom & Structural Ratchet Gates' .spipe/policy/vcs.sdn ||
    fail "canonical required check name is missing"
rg -q 'integration_id: 15368' .spipe/policy/vcs.sdn ||
    fail "canonical required check app identity is missing"
rg -q 'beta_backport_source_result_equivalence: stable_patch_id' .spipe/policy/vcs.sdn ||
    fail "canonical backport source/result equivalence is missing"
rg -q 'beta_backport_provider_receipt: required' .spipe/policy/vcs.sdn ||
    fail "canonical backport provider receipt requirement is missing"
rg -q 'current_mode: independent_environment_review' .spipe/policy/vcs.sdn ||
    fail "canonical environment approval mode is stale"
rg -q 'prevent_self_review: true' .spipe/policy/vcs.sdn ||
    fail "canonical self-review policy is stale"
rg -q 'id: 2378857' .spipe/policy/vcs.sdn ||
    fail "canonical environment reviewer identity is stale"
rg -q 'release_claim: approval_gated' .spipe/policy/vcs.sdn ||
    fail "canonical release claim is stale"

for environment in protected-integration release npm-release; do
    jq -e '.prevent_self_review == true and
           .reviewers == [{"type":"User","id":2378857}]' \
        ".github/$environment-environment.json" >/dev/null ||
        fail "$environment environment reviewer projection is stale"
done

for projection in \
    spipe-vcs-v3-main.json \
    spipe-vcs-v3-release-lines.json \
    spipe-vcs-v3-candidates.json \
    spipe-vcs-v3-review-recovery.json \
    spipe-vcs-v3-version-tags.json; do
    rg -q "$projection" .spipe/policy/vcs.sdn || fail "policy does not bind $projection"
done

for projection in spipe-vcs-v3-candidate-creation.json spipe-vcs-v3-version-tag-creation.json; do
    rg -q "$projection" .spipe/policy/vcs.sdn || fail "policy does not bind $projection"
done

rg -q 'immutable_releases: required' .spipe/policy/vcs.sdn || fail "immutable release authority missing"
for environment in protected-integration release npm-release; do
    rg -q "$environment-environment.json" .spipe/policy/vcs.sdn ||
        fail "policy does not bind $environment environment"
done
echo "check-github-policy-projection: PASS — seven rulesets, split creation/immutability authority, environment, and immutable-release policy"
