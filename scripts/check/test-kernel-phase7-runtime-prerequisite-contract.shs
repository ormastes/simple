#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
. "$root/scripts/check/lib/kernel-phase7-runtime-admission.shs"
work=$(mktemp -d "${TMPDIR:-/tmp}/phase7-runtime-contract.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
runtime=$work/simple
provenance=$work/simple.provenance.env
cache=$work/cache.env
source_file=$work/source.spl
printf 'source-v1\n' >"$source_file"
cat >"$runtime" <<'EOF'
#!/bin/sh
case "${1:-}" in
  --version) echo 'simple test fixture (pure-Simple full CLI)' ;;
  --help) echo 'native-build' ;;
  *) exit 1 ;;
esac
EOF
chmod +x "$runtime"

fixture_verify() {
  fixture_provenance=$1 fixture_runtime=$2
  [ "$(kernel_phase7_manifest_value schema "$fixture_provenance")" = simple-bootstrap-stage4-provenance-v1 ] &&
  [ "$(kernel_phase7_manifest_value status "$fixture_provenance")" = pass ] &&
  [ "$(kernel_phase7_manifest_value artifact_kind "$fixture_provenance")" = pure-simple-full-cli ] &&
  [ "$(kernel_phase7_manifest_value output_sha256 "$fixture_provenance")" = "$(kernel_phase7_hash_file "$fixture_runtime")" ] &&
  [ "$(kernel_phase7_manifest_value source_revision "$fixture_provenance")" = "$(kernel_phase7_hash_file "$source_file")" ]
}
write_receipts() {
  cat >"$provenance" <<EOF
schema=simple-bootstrap-stage4-provenance-v1
status=pass
artifact_kind=pure-simple-full-cli
output_sha256=$(kernel_phase7_hash_file "$runtime")
source_revision=$(kernel_phase7_hash_file "$source_file")
EOF
  cat >"$cache" <<EOF
schema=simple-kernel-phase7-runtime-cache-v1
status=pass
ttl_days=1
runtime_sha256=$(kernel_phase7_hash_file "$runtime")
provenance_sha256=$(kernel_phase7_hash_file "$provenance")
source_revision=$(kernel_phase7_hash_file "$source_file")
EOF
}
admit() {
  KERNEL_PHASE7_TEST_MODE=1 KERNEL_PHASE7_PROVENANCE_VERIFY_FN=fixture_verify \
    kernel_phase7_admit_runtime "$runtime" "$provenance" "$cache" "$root"
}
reject() { if "$@"; then echo "FAIL: mutation admitted: $*" >&2; exit 1; fi; }

write_receipts
admit
sed 's/status=pass/status=forged/' "$provenance" >"$work/p" && mv "$work/p" "$provenance"
reject admit
write_receipts
printf '# altered\n' >>"$runtime"
reject admit
sed -i.bak '$d' "$runtime" && rm -f "$runtime.bak"
write_receipts
printf 'source-v2\n' >"$source_file"
reject admit
printf 'source-v1\n' >"$source_file"
write_receipts
sed 's/ttl_days=1/ttl_days=8/' "$cache" >"$work/c" && mv "$work/c" "$cache"
reject admit
write_receipts
sed 's/simple test fixture (pure-Simple full CLI)/WARNING: Rust-built bootstrap seed only/' "$runtime" >"$work/r" && mv "$work/r" "$runtime" && chmod +x "$runtime"
write_receipts
reject admit
sed 's/WARNING: Rust-built bootstrap seed only/simple test fixture (pure-Simple full CLI)/' "$runtime" >"$work/r" && mv "$work/r" "$runtime" && chmod +x "$runtime"
write_receipts
KERNEL_PHASE7_REQUIRED_TOOLS=phase7-tool-that-does-not-exist reject admit
rm -f "$provenance"
reject admit

for trigger in scripts/check/prepare-kernel-phase7-runtime.shs \
  scripts/check/test-kernel-phase7-runtime-prerequisite-contract.shs \
  scripts/check/lib/kernel-phase7-runtime-admission.shs \
  scripts/check/lib/stage4-candidate-provenance.shs \
  scripts/check/lib/bootstrap-stage3-provenance.shs; do
  grep -Fq -- "- '$trigger'" "$root/.github/workflows/kernel-phase7-qualification.yml"
done
echo KERNEL_PHASE7_RUNTIME_PREREQUISITE_MUTATION_PASS
