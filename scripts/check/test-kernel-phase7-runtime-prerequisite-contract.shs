#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
workflow=$root/.github/workflows/kernel-phase7-qualification.yml
producer=$root/scripts/check/prepare-kernel-phase7-runtime.shs
matrix=$root/scripts/check/check-kernel-phase7-matrix.shs

grep -Fq 'Build and admit full pure-Simple Phase 7 runtime' "$workflow"
grep -Fq 'prepare-kernel-phase7-runtime.shs' "$workflow"
grep -Fq 'cat phase7-runtime.env >> "$GITHUB_ENV"' "$workflow"
grep -Fq 'SIMPLE_NO_STUB_FALLBACK: "1"' "$workflow"
grep -Fq 'BOOTSTRAP_NATIVE_CACHE_TTL_DAYS=1' "$producer"
grep -Fq 'stage4_verify_candidate_provenance "$provenance" "$runtime" "$root"' "$producer"
grep -Fq 'artifact_kind=pure-simple-full-cli' "$producer"
grep -Fq 'SIMPLE_PHASE7_RUNTIME_PROVENANCE' "$matrix"
grep -Fq 'stage4_verify_candidate_provenance "$runtime_provenance" "$runtime" "$root"' "$matrix"
! grep -Eq 'compiler_rust/target|src/compiler_rust|fake|mock' "$producer"

echo KERNEL_PHASE7_RUNTIME_PREREQUISITE_CONTRACT_PASS
