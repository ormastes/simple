#!/bin/sh
# check-native-unwrap-enum-receiver.shs
#
# Regression fence for: `.unwrap()` on an unannotated `Result.Ok(v)` /
# `Option.Some(v)` receiver, compiled through the Rust seed's JIT/native
# (Cranelift) codegen lane, returned the boxed ENUM WRAPPER itself
# (`<enum@0x...>`) instead of the payload `v` — and `.unwrap()` on
# `Result.Err(e)` / `Option.None` silently returned garbage instead of
# trapping. The tree-walk interpreter (`SIMPLE_EXECUTION_MODE=interpret`) was
# never affected — this is a JIT/native-codegen-only defect.
#
# Root cause: `try_compile_builtin_method_call` in
# compiler/src/codegen/instr/closures_structs.rs mapped `unwrap`/`unwrap_or`
# to `rt_unwrap_or_self`, a helper deliberately scoped to the reserved
# `OPTION_ENUM_ID` for the `??` operator (returns any OTHER enum, including
# Result, unchanged) — and separately, `rt_enum_payload` (used by the
# resolved-type HIR path) extracts a payload with no variant check at all, so
# it never traps on Err/None. See
# doc/08_tracking/bug/native_unwrap_returns_enum_wrapper_instead_of_payload_2026-08-11.md.
#
# `.unwrap_or(default)` had the SAME `rt_unwrap_or_self` routing and was left
# unfixed by the first pass of this bug (documented there as a known
# limitation): since Result has no reserved enum_id the way Option does,
# `Result.Ok(v).unwrap_or(d)` AND `Result.Err(e).unwrap_or(d)` both hit the
# "return self" fallback and printed the boxed Result enum instead of `v` /
# `d`. Fixed by routing `unwrap_or` to a new `rt_unwrap_or_value(receiver,
# default)` helper (discriminant-hash technique, same as `rt_unwrap_or_trap`)
# instead. `??`'s `rt_unwrap_or_self` itself is UNCHANGED.
#
# WHY A SCRIPT AND NOT ONLY A SPEC
# `bin/simple test` (the deployed pure-Simple tool) defaults to the
# tree-walk interpreter, which does not reproduce this — only the Rust seed's
# JIT/native lane does. This script exercises a Rust-seed-produced binary
# directly so the JIT lane is actually measured. The system spec at
# test/01_unit/bugs/native_unwrap_enum_receiver_spec.spl documents the same
# fixtures/expectations for the interpreter lane, which is unaffected.
#
# DEFAULT BINARY / PROVENANCE. The default target is `readlink -f bin/simple`
# — the currently DEPLOYED binary — not a `src/compiler_rust/target/**`
# build. Those target/ dirs go stale silently (measured 2026-08-11: both
# release and bootstrap sat at their Aug 10 build, a day behind the deployed
# binary that carries the actual fix), and a run against a stale binary reads
# as a real FAIL instead of the provenance gap it is. Override with $1 or
# $SIMPLE_BIN when you deliberately want to test a different binary (e.g. a
# fresh seed build). Any binary older than the fix landing (rebuilt
# 2026-08-11 04:08:03 UTC per
# doc/08_tracking/bug/native_unwrap_returns_enum_wrapper_instead_of_payload_2026-08-11.md)
# is refused as ERROR, never silently scored as FAIL — same mtime-provenance
# pattern as scripts/check/check-numeric-builtin-result-type.shs.
#
# EXIT CODES (repo pre-push guard convention)
#   0  PASS   — <n> checked, n > 0
#   1  FAIL   — a real regression
#   2  ERROR  — nothing was actually measured (missing/stale binary, etc.)
#
# Usage: sh scripts/check/check-native-unwrap-enum-receiver.shs [path-to-binary]
#        SIMPLE_BIN=/path/to/simple sh scripts/check/check-native-unwrap-enum-receiver.shs
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
cd "$REPO_ROOT" || { echo "ERROR — nothing was checked (cannot cd to repo root)"; exit 2; }

# Fix-landing timestamp: any candidate binary built strictly before this is
# stale and cannot possibly carry the fix. 2026-08-11 05:45:17 UTC — the
# unwrap_or(default) follow-up fix (rt_unwrap_or_value), later than the
# original unwrap()/expect() fix at 04:08:03 UTC.
FIX_EPOCH=1786427117

FIXTURE_DIR="test/fixtures/native_unwrap_enum_receiver"
SEED_BIN="${1:-${SIMPLE_BIN:-}}"
if [ -z "$SEED_BIN" ]; then
    if [ -e "$REPO_ROOT/bin/simple" ]; then
        SEED_BIN="$(readlink -f "$REPO_ROOT/bin/simple" 2>/dev/null)"
    fi
fi

[ -n "$SEED_BIN" ] && [ -x "$SEED_BIN" ] || {
    echo "ERROR — nothing was checked (no runnable binary found; pass a path as"
    echo "  \$1, set \$SIMPLE_BIN, or ensure bin/simple resolves to an executable)"
    exit 2
}

BIN_EPOCH="$(stat -c '%Y' "$SEED_BIN" 2>/dev/null || stat -f '%m' "$SEED_BIN" 2>/dev/null)"
if [ -z "$BIN_EPOCH" ]; then
    echo "ERROR — nothing was checked (could not stat mtime of $SEED_BIN)"
    exit 2
fi
if [ "$BIN_EPOCH" -lt "$FIX_EPOCH" ]; then
    echo "ERROR — nothing was checked ($SEED_BIN is stale: built before the fix"
    echo "  landed at 2026-08-11 04:08:03 UTC (epoch $FIX_EPOCH), got epoch"
    echo "  $BIN_EPOCH — rebuild or point at the currently deployed binary)"
    exit 2
fi

echo "check-native-unwrap-enum-receiver — binary: $SEED_BIN"
ls -l "$SEED_BIN" 2>/dev/null | awk '{print "  size/mtime: " $5 " " $6 " " $7 " " $8}'

for f in ok_unwrap.spl some_unwrap.spl err_unwrap.spl none_unwrap.spl \
         ok_unwrap_or.spl some_unwrap_or.spl err_unwrap_or.spl none_unwrap_or.spl; do
    [ -f "$FIXTURE_DIR/$f" ] || { echo "ERROR — nothing was checked (missing fixture $f)"; exit 2; }
done

checked=0
failures=""

check_payload() {
    name="$1"; fixture="$2"; want="$3"
    out="$("$SEED_BIN" run "$FIXTURE_DIR/$fixture" 2>&1 | grep -v '^WARNING' | grep -v 'pure-Simple bin/simple')"
    checked=$((checked + 1))
    if [ "$out" = "$want" ]; then
        echo "PASS  $name: got '$out'"
    else
        echo "FAIL  $name: want '$want' got '$out'"
        failures="$failures $name"
    fi
}

check_trap() {
    name="$1"; fixture="$2"
    out="$("$SEED_BIN" run "$FIXTURE_DIR/$fixture" 2>&1 | grep -v '^WARNING' | grep -v 'pure-Simple bin/simple')"
    checked=$((checked + 1))
    case "$out" in
        *"called unwrap"*|*"unwrap"*"None"*|*"unwrap"*"Err"*)
            echo "PASS  $name traps: '$out'"
            ;;
        *)
            echo "FAIL  $name did not trap, got: '$out'"
            failures="$failures $name"
            ;;
    esac
}

check_payload "Ok(42).unwrap()==42"     "ok_unwrap.spl"   "42"
check_payload "Some(42).unwrap()==42"   "some_unwrap.spl" "42"
check_trap    "Err(x).unwrap() traps"   "err_unwrap.spl"
check_trap    "None.unwrap() traps"     "none_unwrap.spl"

# unwrap_or(default): never traps. Ok/Some yield the payload; Err/None yield
# the DEFAULT, not the boxed enum wrapper and not a trap.
check_payload "Ok(1).unwrap_or(9)==1"     "ok_unwrap_or.spl"   "1"
check_payload "Some(1).unwrap_or(9)==1"   "some_unwrap_or.spl" "1"
check_payload "Err(x).unwrap_or(9)==9"    "err_unwrap_or.spl"  "9"
check_payload "None.unwrap_or(9)==9"      "none_unwrap_or.spl" "9"

if [ -n "$failures" ]; then
    echo "FAIL —$failures"
    exit 1
fi
if [ "$checked" -eq 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi
echo "PASS — $checked checked"
exit 0
