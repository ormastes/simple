#!/bin/sh
# Produce unsigned reviewer-ready evidence by launching retained server/client
# executables over a real loopback TCP connection. The executable protocol is
# documented in must_check_tiering.md; no direct function-call mode exists.
set -eu
LC_ALL=C; export LC_ALL
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
GATE=db-server-request-port
OUT_REL= RUN_ID= PORT= SERVER= SERVER_SOURCE= CLIENT= CLIENT_SOURCE= QUERY= TOOLCHAIN_ID= TARGET_ID= TIMEOUT_MS=10000
PRODUCER_ID=${PRODUCER_ID:-database-team}; REVIEWER_KEY_ID=${REVIEWER_KEY_ID:-independent-reviewer-required}
fail() { echo "STATUS: FAIL db-server-request-port-producer — $*" >&2; exit 1; }
sha() { sha256sum "$1" | awk '{print $1}'; }
hex() { od -An -v -t x1 "$1" | tr -d ' \n'; }
token_ok() { case "$1" in ''|*[!A-Za-z0-9._:@+/-]*) return 1;; esac; }
fingerprint() { git -C "$ROOT" ls-tree -r HEAD -- src scripts config test rules.sdl doc/07_guide doc/00_llm_process doc/glossary.md | sed '\|[[:space:]]doc/08_tracking/check/must_check_db.sdn$|d' | sha256sum | awk '{print $1}'; }
usage() { echo "usage: $0 --output-dir DIR --run-id ID --port PORT --server-executable FILE --server-source FILE --client-executable FILE --client-source FILE --query FILE --toolchain-id ID --target-id ID [--timeout-ms N]"; }
while [ "$#" -gt 0 ]; do
 case "$1" in
  --output-dir) OUT_REL=$2;; --run-id) RUN_ID=$2;; --port) PORT=$2;;
  --server-executable) SERVER=$2;; --server-source) SERVER_SOURCE=$2;;
  --client-executable) CLIENT=$2;; --client-source) CLIENT_SOURCE=$2;; --query) QUERY=$2;;
  --toolchain-id) TOOLCHAIN_ID=$2;; --target-id) TARGET_ID=$2;; --timeout-ms) TIMEOUT_MS=$2;;
  --producer-id) PRODUCER_ID=$2;; --reviewer-key-id) REVIEWER_KEY_ID=$2;; -h|--help) usage; exit 0;;
  *) fail "unknown-argument-$1";;
 esac; shift 2
done
token_ok "$RUN_ID" && token_ok "$PRODUCER_ID" && token_ok "$REVIEWER_KEY_ID" || fail invalid-identity-token
[ "$PRODUCER_ID" != "$REVIEWER_KEY_ID" ] || fail reviewer-must-be-independent
case "$OUT_REL" in ''|/*|*' '*|..|../*|*/../*|*/..) fail unsafe-output-dir;; esac
case "$PORT" in ''|*[!0-9]*) fail invalid-port;; esac; [ "$PORT" -ge 1024 ] && [ "$PORT" -le 65535 ] || fail invalid-port
case "$TIMEOUT_MS" in ''|*[!0-9]*) fail invalid-timeout;; esac; [ "$TIMEOUT_MS" -ge 100 ] && [ "$TIMEOUT_MS" -le 60000 ] || fail invalid-timeout
for f in "$SERVER" "$SERVER_SOURCE" "$CLIENT" "$CLIENT_SOURCE" "$QUERY"; do [ -f "$f" ] && [ ! -L "$f" ] || fail missing-input; done
[ -x "$SERVER" ] && [ -x "$CLIENT" ] || fail executable-not-runnable
[ -s "$QUERY" ] || fail empty-query
command -v lsof >/dev/null 2>&1 || fail missing-listener-ownership-observer

parent=${OUT_REL%/*}; [ "$parent" != "$OUT_REL" ] || parent=.; mkdir -p "$ROOT/$parent"
parent_real=$(CDPATH= cd -- "$ROOT/$parent" && pwd -P); case "$parent_real" in "$ROOT"|"$ROOT"/*) ;; *) fail output-escapes-root;; esac
OUT=$parent_real/${OUT_REL##*/}; [ ! -e "$OUT" ] || fail output-exists; mkdir "$OUT"
work=$(mktemp -d); server_pid=; client_pid=
cleanup() { [ -z "$client_pid" ] || kill "$client_pid" 2>/dev/null || true; [ -z "$server_pid" ] || kill "$server_pid" 2>/dev/null || true; rm -rf "$work"; }
trap cleanup EXIT INT TERM
cp "$SERVER" "$OUT/db-server"; cp "$SERVER_SOURCE" "$OUT/db-server-source.spl"
cp "$CLIENT" "$OUT/wire-client"; cp "$CLIENT_SOURCE" "$OUT/wire-client-source.spl"; cp "$QUERY" "$OUT/query.bin"
chmod 755 "$OUT/db-server" "$OUT/wire-client"
FINGERPRINT=$(fingerprint)
cat >"$OUT/toolchain-identity.env" <<EOF
evidence_schema=simple.must-check-toolchain/v1
gate_id=$GATE
run_id=$RUN_ID
toolchain_id=$TOOLCHAIN_ID
final_verdict=PASS
EOF
cat >"$OUT/target-identity.env" <<EOF
evidence_schema=simple.must-check-target/v1
gate_id=$GATE
run_id=$RUN_ID
target_kind=loopback-native-host
target_id=$TARGET_ID
final_verdict=PASS
EOF
start_ns=$(date +%s%N)
"$OUT/db-server" --listen-host 127.0.0.1 --listen-port "$PORT" --ready-file "$work/ready" --pid-file "$work/listener.pid" --request-log "$work/request.bin" --response-log "$work/server-result.bin" --stop-file "$work/stop" --max-connections 1 >"$OUT/server.stdout" 2>"$OUT/server.stderr" & server_pid=$!
steps=$((TIMEOUT_MS / 50)); i=0
while [ ! -f "$work/ready" ] && kill -0 "$server_pid" 2>/dev/null && [ "$i" -lt "$steps" ]; do sleep 0.05; i=$((i+1)); done
[ -f "$work/ready" ] && kill -0 "$server_pid" 2>/dev/null || fail server-not-ready
[ "$(cat "$work/ready")" = "READY 127.0.0.1:$PORT" ] || fail malformed-readiness
[ -f "$work/listener.pid" ] && [ "$(cat "$work/listener.pid")" = "$server_pid" ] || fail listener-owner-mismatch
socket_owner=$(lsof -nP -t -a -p "$server_pid" -iTCP@127.0.0.1:"$PORT" -sTCP:LISTEN 2>/dev/null || true)
[ "$socket_owner" = "$server_pid" ] || fail launched-process-does-not-own-listener
"$OUT/wire-client" --host 127.0.0.1 --port "$PORT" --query-file "$OUT/query.bin" --result-file "$work/client-result.bin" --status-file "$work/client-status" >"$OUT/client.stdout" 2>"$OUT/client.stderr" & client_pid=$!
launched_client_pid=$client_pid
wait "$client_pid" || fail client-failed; client_pid=
[ "$(cat "$work/client-status" 2>/dev/null || true)" = RECEIVED ] || fail client-result-status
[ -f "$work/request.bin" ] && cmp -s "$OUT/query.bin" "$work/request.bin" || fail server-received-query-mismatch
[ -s "$work/client-result.bin" ] && cmp -s "$work/client-result.bin" "$work/server-result.bin" || fail result-mismatch
cp "$work/client-result.bin" "$OUT/result.bin"
: >"$work/stop"
i=0; while kill -0 "$server_pid" 2>/dev/null && [ "$i" -lt "$steps" ]; do sleep 0.05; i=$((i+1)); done
if kill -0 "$server_pid" 2>/dev/null; then fail server-stop-timeout; fi
wait "$server_pid"; server_rc=$?; launched_server_pid=$server_pid; server_pid=
[ "$server_rc" -eq 0 ] || fail server-failed
elapsed_ms=$(( ($(date +%s%N) - start_ns) / 1000000 )); [ "$elapsed_ms" -le "$TIMEOUT_MS" ] || fail lifecycle-budget-exceeded

cat >"$OUT/session.env" <<EOF
session_schema=simple.db-server-request-port-session/v1
gate_id=$GATE
source_fingerprint=$FINGERPRINT
run_id=$RUN_ID
transport=tcp
listen_host=127.0.0.1
client_host=127.0.0.1
configured_port=$PORT
observed_port=$PORT
readiness_status=READY
request_status=SENT
result_status=RECEIVED
launched_server_pid=$launched_server_pid
listener_owner_pid=$launched_server_pid
launched_client_pid=$launched_client_pid
accepted_connection_count=1
server_exit_status=0
client_exit_status=0
stop_status=CLEAN
no_leak=true
direct_function_simulation=false
elapsed_ms=$elapsed_ms
stop_budget_ms=$TIMEOUT_MS
query_bytes=$(wc -c <"$OUT/query.bin" | tr -d ' ')
query_hex=$(hex "$OUT/query.bin")
query_sha256=$(sha "$OUT/query.bin")
result_bytes=$(wc -c <"$OUT/result.bin" | tr -d ' ')
result_hex=$(hex "$OUT/result.bin")
result_sha256=$(sha "$OUT/result.bin")
server_executable_sha256=$(sha "$OUT/db-server")
server_source_sha256=$(sha "$OUT/db-server-source.spl")
client_executable_sha256=$(sha "$OUT/wire-client")
client_source_sha256=$(sha "$OUT/wire-client-source.spl")
toolchain_identity_sha256=$(sha "$OUT/toolchain-identity.env")
target_identity_sha256=$(sha "$OUT/target-identity.env")
final_verdict=PASS
EOF

cat >"$OUT/command-receipt.env" <<EOF
evidence_schema=simple.must-check-command/v1
gate_id=$GATE
source_fingerprint=$FINGERPRINT
run_id=$RUN_ID
command=sh scripts/check/produce-db-server-request-port-evidence.shs --output-dir $OUT_REL --run-id $RUN_ID --port $PORT [retained-server-and-client]
exit_status=0
final_verdict=PASS
EOF
cat >"$OUT/observations.env" <<EOF
evidence_schema=simple.must-check-observations/v1
gate_id=$GATE
source_fingerprint=$FINGERPRINT
run_id=$RUN_ID
acceptance_ids=configurable-port,listen,query,result,ownership,stop,no-leak
acceptance.configurable-port=PASS
acceptance.listen=PASS
acceptance.query=PASS
acceptance.result=PASS
acceptance.ownership=PASS
acceptance.stop=PASS
acceptance.no-leak=PASS
final_verdict=PASS
EOF
cat >"$OUT/external-evidence.unsigned.env" <<EOF
evidence_schema=simple.must-check-external-evidence/v2
gate_id=$GATE
source_fingerprint=$FINGERPRINT
run_id=$RUN_ID
produced_at_utc=review-time-required
producer_id=$PRODUCER_ID
producer_kind=real-loopback-wire-producer
reviewer_key_id=$REVIEWER_KEY_ID
final_verdict=PASS
acceptance_contract=$GATE/v1
acceptance_ids=configurable-port,listen,query,result,ownership,stop,no-leak
EOF
for pair in command_receipt:command-receipt.env target_identity:target-identity.env toolchain_identity:toolchain-identity.env observations:observations.env db_session:session.env query_bytes:query.bin result_bytes:result.bin db_server_executable:db-server db_server_source:db-server-source.spl wire_client_executable:wire-client wire_client_source:wire-client-source.spl; do k=${pair%%:*}; p=${pair#*:}; printf '%s_path=%s/%s\n%s_sha256=%s\n' "$k" "$OUT_REL" "$p" "$k" "$(sha "$OUT/$p")" >>"$OUT/external-evidence.unsigned.env"; done
sh "$ROOT/scripts/check/check-db-server-request-port-evidence.shs" --session "$OUT/session.env" --query "$OUT/query.bin" --result "$OUT/result.bin" --server-executable "$OUT/db-server" --server-source "$OUT/db-server-source.spl" --client-executable "$OUT/wire-client" --client-source "$OUT/wire-client-source.spl" --toolchain "$OUT/toolchain-identity.env" --target "$OUT/target-identity.env" --fingerprint "$FINGERPRINT" --run-id "$RUN_ID" >/dev/null
[ "$FINGERPRINT" = "$(fingerprint)" ] || fail head-drift-during-production
echo "STATUS: PASS db-server-request-port-producer — unsigned reviewer-ready real wire evidence: $OUT_REL"
