#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
fixture="$root/test/01_unit/os/services/vfs/arm64_nonce_slot_contract_fixture.c"
runtime="$root/examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c"
tmp=$(mktemp "${TMPDIR:-/tmp}/arm64-nonce-slot.XXXXXX")
trap 'rm -f "$tmp"' EXIT HUP INT TERM
cc -std=c11 -Wall -Wextra -Werror "$fixture" -o "$tmp"
"$tmp"
grep -qF 'arm64_nonce_slot_line_length(slot, slot_len)' "$runtime"
[ "$(grep -c 'arm64_nonce_runtime_line_length(' "$runtime")" -eq 3 ]
! grep -qF 'a->len - 1U]) != '\''\n'\''' "$runtime"
echo 'PASS ARM64 canonical fixed-slot nonce parsing'
