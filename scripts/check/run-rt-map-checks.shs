#!/bin/sh
# Shared rt_ map checks: the one implementation behind the bootstrap must-check row
# and `buildrunner rt-map-checks`. Usage: sh scripts/check/run-rt-map-checks.shs
#
# Blocking: check-rt-pointer-ref-map.shs and check-rt-host-map.shs. Exit 1 only when
# either one reports a new finding (its own exit 1).
# Report-only: check-rt-c-contract-compile.shs. Its FAIL rows never change the exit status.
#
# Per-checker status: PASS (exit 0), FAIL (exit 1), ERROR (any other exit: nothing checked),
# UNTESTED (prerequisite absent: cc for the compile probe). UNTESTED is never PASS,
# FAIL exits 1 and ERROR exits 2, so a broken checker never looks green; a host without cc does not break a build.
#
# Test seams: RT_MAP_ROOT (tree to check, default: this checkout), RT_MAP_CC.
set -u

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd) || exit 2
ROOT=${RT_MAP_ROOT:-$(cd "$SCRIPT_DIR/../.." && pwd)} || exit 2
CC=${RT_MAP_CC:-cc}
TMP=$(mktemp -d) || { echo "RT_MAP_CHECKS verdict=ERROR reason=mktemp-failed"; exit 2; }
trap 'rm -rf "$TMP"' EXIT INT TERM

have() { command -v "$1" >/dev/null 2>&1; }

# run_blocking SCRIPT OUT: sets STATUS and LAST (the checker's final stdout line).
run_blocking() {
  sh "$SCRIPT_DIR/$1" --root "$ROOT" > "$2" 2>&1
  case $? in
    0) STATUS=PASS ;;
    1) STATUS=FAIL ;;
    *) STATUS=ERROR ;;
  esac
  LAST=$(tail -n 1 "$2")
}

# rank: FAIL over ERROR over UNTESTED over PASS.
worse() {
  case "$1:$2" in
    FAIL:*|*:FAIL) echo FAIL ;;
    ERROR:*|*:ERROR) echo ERROR ;;
    UNTESTED:*|*:UNTESTED) echo UNTESTED ;;
    *) echo PASS ;;
  esac
}

run_blocking check-rt-pointer-ref-map.shs "$TMP/pointer.out"
PTR=$STATUS PTR_LAST=$LAST
run_blocking check-rt-host-map.shs "$TMP/host.out"
HOST=$STATUS HOST_LAST=$LAST
if have "$CC"; then
  sh "$SCRIPT_DIR/check-rt-c-contract-compile.shs" --root "$ROOT" --cc "$CC" > "$TMP/compile.out" 2>&1
  CONTRACT=$(tail -n 1 "$TMP/compile.out")
else
  CONTRACT="UNTESTED reason=no-cc"
fi

# A skipped compile probe (no cc) keeps the overall verdict off PASS.
VERDICT=$(worse "$PTR" "$HOST")
case $CONTRACT in UNTESTED*) VERDICT=$(worse "$VERDICT" UNTESTED) ;; esac
if [ "$PTR" = FAIL ] || [ "$HOST" = FAIL ]; then
  for f in "$TMP/pointer.out" "$TMP/host.out"; do
    [ -f "$f" ] && head -n 200 "$f"
  done
fi
echo "RT_MAP_CHECKS pointer-ref=$PTR :: $PTR_LAST"
echo "RT_MAP_CHECKS host-map=$HOST :: $HOST_LAST"
echo "RT_MAP_CHECKS c-contract(report-only) :: $CONTRACT"
echo "RT_MAP_CHECKS verdict=$VERDICT"
[ "$VERDICT" = FAIL ] && exit 1
[ "$VERDICT" = ERROR ] && exit 2
exit 0
