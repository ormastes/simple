#!/bin/sh
# CI-style wiring for the Modern SSpec byte-identical regeneration gate.
#
# src/lib/common/spec/evidence/regeneration_gate.spl (render_manual_digest,
# assert_regeneration_stable, manifest_regeneration_report) landed as a
# library with unit coverage (test/01_unit/lib/common/spec/evidence/
# regeneration_gate_spec.spl) but nothing invoked it as a runnable check —
# the last explicitly open item from the Modern SSpec typed-evidence plan
# (doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md). This
# script closes that gap: it drives the gate against representative fixtures
# and reports a fail-closed PASS/FAIL/ERROR verdict, following the same
# shell-wrapper-around-a-`bin/simple run`-probe convention as
# scripts/check/check-array-remove-returns-element.shs.
#
# KNOWN SCOPE LIMIT: this proves the gate mechanism is wired into something
# runnable in CI style, using the same representative evidence/oracle/manifest
# fixtures as the landed unit spec. It is NOT yet wired to the full
# spipe_docgen pipeline, which currently reads a rendered sidecar file rather
# than CanonicalEvidence/OracleSpec objects directly. Hooking spipe_docgen
# itself to typed evidence is separate future work.
#
# TARGETS (positional args): "stable" and/or "shuffled". No args = "stable"
# only — the real regression gate, which must PASS on unmodified evidence.
# "shuffled" is a self-test target that deliberately reorders rendered blocks
# to prove the gate CAN detect nondeterministic output; pass it explicitly
# (alone or alongside "stable") to exercise the FAIL branch. An empty/invalid
# target list is a caller error, not a clean result:
#   check-sspec-evidence-regeneration.shs                  # default: stable
#   check-sspec-evidence-regeneration.shs stable shuffled  # also exercise FAIL
#   check-sspec-evidence-regeneration.shs --none            # forces ERROR (empty set)
#
# Verdict line is always the LAST line of stdout:
#   check-sspec-evidence-regeneration: PASS — <n> spec(s) checked, 0 nondeterministic   exit 0
#   check-sspec-evidence-regeneration: FAIL — <spec> produced different output on two runs  exit 1
#   check-sspec-evidence-regeneration: ERROR — nothing was checked                       exit 2
#
# Exit codes match .claude/rules/vcs.md: PASS=0, FAIL=1, ERROR=2.

set -u

SELF=check-sspec-evidence-regeneration
SIMPLE_BIN="${SIMPLE_BIN:-bin/simple}"
SIMPLE_RUST_SEED_WARNING=0
export SIMPLE_RUST_SEED_WARNING

die() {
    code=$1
    shift
    echo "$SELF: ERROR — $*" >&2
    echo "$SELF: ERROR — nothing was checked"
    exit "$code"
}

[ -x "$SIMPLE_BIN" ] || command -v "$SIMPLE_BIN" >/dev/null 2>&1 \
    || die 2 "compiler not executable at '$SIMPLE_BIN' (set SIMPLE_BIN to override)"

# --- resolve targets, fail closed -------------------------------------------
targets=""
if [ "$#" -eq 0 ]; then
    targets="stable"
elif [ "$#" -eq 1 ] && [ "$1" = "--none" ]; then
    die 2 "requested target list is explicitly empty (--none)"
else
    for t in "$@"; do
        case "$t" in
            stable|shuffled) targets="${targets:+$targets }$t" ;;
            *) die 2 "unknown target '$t' (valid: stable, shuffled)" ;;
        esac
    done
fi
[ -n "$targets" ] || die 2 "target list resolved to empty"

work="$(mktemp -d)" || die 2 "mktemp failed"
trap 'rm -rf "$work"' EXIT INT TERM

probe="$work/regeneration_gate_probe.spl"
cat > "$probe" <<'PROBE_EOF'
use std.common.spec.evidence.model.{
    ManualBlock, EvidenceAudience, EvidenceManifest, EvidenceStatus,
    evidence_manifest,
    CanonicalEvidence, OracleSpec,
    canonical_evidence, evidence_node,
    oracle_spec, check_exact
}
use std.common.spec.evidence.regeneration_gate.{
    render_manual_digest, assert_regeneration_stable
}
use std.common.spec.evidence.evidence_comparator.{
    compare_evidence, comparison_to_manual_blocks
}

fn sample_manifest(run_id: text, environment: text) -> EvidenceManifest:
    evidence_manifest(
        "evd-regen-001",
        "simple-list/1",
        "test/01_unit/lib/common/spec/evidence/regeneration_gate_spec.spl",
        "1111111111111111111111111111111111111111111111111111111111111111",
        "provider.list",
        "1.0.0",
        run_id,
        environment,
        "2222222222222222222222222222222222222222222222222222222222222222",
        EvidenceStatus.passed
    )

fn sample_evidence() -> CanonicalEvidence:
    canonical_evidence(
        "protocol_text",
        "simple-list/1",
        [evidence_node("response.status", "200")]
    )

fn sample_spec() -> OracleSpec:
    oracle_spec("simple-list/1", [check_exact("response.status", "200")])

fn reorder(blocks: [ManualBlock]) -> [ManualBlock]:
    var out: [ManualBlock] = []
    var i = blocks.len() - 1
    while i >= 0:
        out.push(blocks[i])
        i = i - 1
    out

fn run_stable():
    val manifest = sample_manifest("run-1", "ci-linux")
    val outcome = assert_regeneration_stable(
        sample_evidence(), sample_spec(), "List response manual", EvidenceAudience.qa, manifest
    )
    if outcome.0:
        print "TARGET:stable:STABLE"
    else:
        print "TARGET:stable:MISMATCH:{outcome.1}"

fn run_shuffled():
    val manifest = sample_manifest("run-1", "ci-linux")
    val result = compare_evidence(sample_evidence(), sample_spec())
    val blocks = comparison_to_manual_blocks("List response manual", result)
    val digest_a = render_manual_digest("List response manual", blocks, EvidenceAudience.qa, manifest)
    val reordered = reorder(blocks)
    val digest_b = render_manual_digest("List response manual", reordered, EvidenceAudience.qa, manifest)
    if digest_a == digest_b:
        print "TARGET:shuffled:STABLE"
    else:
        print "TARGET:shuffled:MISMATCH:{digest_a}:{digest_b}"

fn main():
    run_stable()
    run_shuffled()
    print "REACHED_END"
main()
PROBE_EOF
[ -s "$probe" ] || die 2 "probe file was not written"

out="$work/out"
"$SIMPLE_BIN" run "$probe" > "$out" 2>&1
rc=$?
[ "$rc" -eq 0 ] || die 2 "probe exited $rc: $(tr '\n' '|' < "$out")"
[ -s "$out" ]   || die 2 "probe produced no output"

/usr/bin/grep -aq '^REACHED_END$' "$out" \
    || die 2 "probe did not reach the end — verdict would be vacuous: $(tr '\n' '|' < "$out")"

checked=0
found_mismatch=0
mismatch_spec=""

for t in $targets; do
    line=$(/usr/bin/grep -a "^TARGET:$t:" "$out" | head -1)
    [ -n "$line" ] || die 2 "target '$t' produced no result line in probe output"
    checked=$((checked + 1))
    case "$line" in
        TARGET:*:STABLE) : ;;
        TARGET:*:MISMATCH:*)
            found_mismatch=$((found_mismatch + 1))
            [ -n "$mismatch_spec" ] || mismatch_spec="$t"
            ;;
        *) die 2 "target '$t' produced an unrecognized result line: $line" ;;
    esac
done

[ "$checked" -gt 0 ] || die 2 "no target was exercised"

if [ "$found_mismatch" -gt 0 ]; then
    echo "$SELF: FAIL — $mismatch_spec produced different output on two runs"
    exit 1
fi

echo "$SELF: PASS — $checked spec(s) checked, 0 nondeterministic"
exit 0
