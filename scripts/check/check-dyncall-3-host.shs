#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
OUT_DIR=${1:-/tmp/simple-dyncall-3-host-check}
CC_NAME=${CC:-clang}
mkdir -p "$OUT_DIR"

"$CC_NAME" -std=gnu11 -O1 -ffunction-sections -fdata-sections \
    "$ROOT_DIR/src/runtime/test/dyncall_3_host_selfcheck.c" \
    "$ROOT_DIR/src/runtime/runtime_native.c" \
    -Wl,--gc-sections -pthread -ldl -lm \
    -o "$OUT_DIR/dyncall_3_host_selfcheck"
"$OUT_DIR/dyncall_3_host_selfcheck" >"$OUT_DIR/dyncall_3_host_selfcheck.out"
grep -q '^PASS dyncall_3_host_selfcheck$' \
    "$OUT_DIR/dyncall_3_host_selfcheck.out"
printf '%s\n' 'dyncall_3_host_gate=pass'
