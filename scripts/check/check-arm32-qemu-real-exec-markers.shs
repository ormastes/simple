#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
contract="$root/src/os/qemu_systest_contract.spl"
body=$(sed -n '/pub fn arm32_markers()/,/pub fn arm32_timeout_ms()/p' "$contract")
for marker in \
    'FS_LS_BEGIN path=/SYS/APPS' \
    'FS_LS_ENTRY name=' \
    'FS_LS_END status=pass' \
    'FS_PROGRAM_BEGIN path=/FSEXEC.ELF arch=arm32' \
    'SIMPLEOS_FS_EXEC_OK arch=arm32 nonce=' \
    'FS_PROGRAM_END rc=37 reaped=true' \
    'TEST PASSED'; do
    printf '%s\n' "$body" | rg -F "$marker" >/dev/null || {
        echo "missing ARM32 live marker: $marker" >&2
        exit 1
    }
done
if printf '%s\n' "$body" | rg -F 'standard_smf_markers()' >/dev/null; then
    echo "ARM32 still accepts synthetic shared SMF marker set" >&2
    exit 1
fi
echo "arm32 QEMU real-exec markers: PASS"
