compiler_receipt_sha256=$compiler_receipt_sha"
    self_test_rehash_lineage() {
        self_test_replace_field "$stage4_manifest" stage3_provenance_sha256 "$(hash_file "$stage3_manifest")"
        stage4_manifest_sha=$(hash_file "$stage4_manifest")
        self_test_replace_field "$stage3_acceptance" stage3_provenance_sha256 "$(hash_file "$stage3_manifest")"
        self_test_replace_field "$stage3_acceptance" stage4_provenance_sha256 "$stage4_manifest_sha"
        stage3_acceptance_sha=$(hash_file "$stage3_acceptance")
        self_test_replace_field "$test_root/deploy.receipt.env" stage4_provenance_sha256 "$stage4_manifest_sha"
        self_test_replace_field "$test_root/deploy.receipt.env" stage3_current_acceptance_receipt_sha256 "$stage3_acceptance_sha"
        deploy_receipt_sha=$(hash_file "$test_root/deploy.receipt.env")
        self_test_replace_field "$test_root/rollback.receipt.env" stage4_provenance_sha256 "$stage4_manifest_sha"
        self_test_replace_field "$test_root/rollback.receipt.env" stage3_current_acceptance_receipt_sha256 "$stage3_acceptance_sha"
        self_test_replace_field "$test_root/rollback.receipt.env" deploy_receipt_sha256 "$deploy_receipt_sha"
    }
    BOOTSTRAP_HANDOFF_ROOT=$test_root
    HANDOFF_SELFTEST_MODE=1
    BOOTSTRAP_HANDOFF_SELFTEST_CURRENT_TREE_IDENTITY=$current_tree_identity
    unset BOOTSTRAP_HANDOFF_STAGE3_MANIFEST BOOTSTRAP_HANDOFF_STAGE3_CANDIDATE BOOTSTRAP_HANDOFF_STAGE4_PROVENANCE BOOTSTRAP_HANDOFF_STAGE4_CANDIDATE BOOTSTRAP_HANDOFF_ESSENTIAL_SMOKE_RECEIPT BOOTSTRAP_HANDOFF_SMOKE_RECEIPT BOOTSTRAP_HANDOFF_DEPLOY_RECEIPT BOOTSTRAP_HANDOFF_ROLLBACK_RECEIPT BOOTSTRAP_HANDOFF_LINUX_AARCH64_NATIVE_HOST_RECEIPT BOOTSTRAP_HANDOFF_LINUX_AARCH64_HOST BOOTSTRAP_HANDOFF_MACOS_NATIVE_HOST_RECEIPT BOOTSTRAP_HANDOFF_MACOS_HOST BOOTSTRAP_HANDOFF_FREEBSD_BASE_IMAGE BOOTSTRAP_HANDOFF_FREEBSD_BASE_IMAGE_RECEIPT BOOTSTRAP_HANDOFF_SIMPLEOS_ARM64_KERNEL BOOTSTRAP_HANDOFF_SIMPLEOS_ARM64_PRODUCER_MANIFEST BOOTSTRAP_HANDOFF_SIMPLEOS_ARM64_MANIFEST || :
    evaluate_readiness || { emit_result; echo bootstrap_handoff_self_test=fail_ready_fixture; exit 1; }
    [ "$READINESS_STATUS" = ready ] || { echo bootstrap_handoff_self_test=fail_ready_status; exit 1; }

    for receipt_copy in "$stage3_manifest" "$stage4_manifest" "$stage3_acceptance" \
        "$test_root/deploy.receipt.env" "$test_root/rollback.receipt.env"; do
        cp "$receipt_copy" "${receipt_copy}.tree-good"
    done
    stale_dirty=6666666666666666666666666666666666666666666666666666666666666666
    self_test_replace_field "$stage3_manifest" git_dirty_fingerprint "$stale_dirty"
    for stale_receipt in "$stage4_manifest" "$stage3_acceptance" \
        "$test_root/deploy.receipt.env" "$test_root/rollback.receipt.env"; do
        self_test_replace_field "$stale_receipt" git_dirty_fingerprint "$stale_dirty"
    done
    self_test_rehash_lineage
    evaluate_readiness && { echo bootstrap_handoff_self_test=fail_coherent_stale_tree; exit 1; } || :
    [ "$STAGE3_REASON" = current_tree_identity_mismatch ] || { echo bootstrap_handoff_self_test=wrong_coherent_stale_tree_reason; exit 1; }
    for receipt_copy in "$stage3_manifest" "$stage4_manifest" "$stage3_acceptance" \
        "$test_root/deploy.receipt.env" "$test_root/rollback.receipt.env"; do
        mv "${receipt_copy}.tree-good" "$receipt_copy"
    done

    for receipt_copy in "$stage4_manifest" "$stage3_acceptance" \
        "$test_root/deploy.receipt.env" "$test_root/rollback.receipt.env"; do
        cp "$receipt_copy" "${receipt_copy}.root-good"
        self_test_replace_field "$receipt_copy" repository_root /wrong/bootstrap/worktree
    done
    self_test_rehash_lineage
    evaluate_readiness && { echo bootstrap_handoff_self_test=fail_wrong_current_worktree; exit 1; } || :
    [ "$STAGE4_REASON" = current_tree_identity_mismatch ] || { echo bootstrap_handoff_self_test=wrong_current_worktree_reason; exit 1; }
    for receipt_copy in "$stage4_manifest" "$stage3_acceptance" \
        "$test_root/deploy.receipt.env" "$test_root/rollback.receipt.env"; do
        mv "${receipt_copy}.root-good" "$receipt_copy"
    done

    cp "$source_snapshot" "$source_snapshot.good"
    self_test_file "$source_snapshot" stale-source
    evaluate_readiness && { echo bootstrap_handoff_self_test=fail_source_identity; exit 1; } || :
    [ "$STAGE3_REASON" = source_identity_mismatch ] || { echo bootstrap_handoff_self_test=wrong_source_identity_reason; exit 1; }
    mv "$source_snapshot.good" "$source_snapshot"

    cp "$runtime_origin" "$runtime_origin.good"
    self_test_file "$runtime_origin" stale-runtime
    evaluate_readiness && { echo bootstrap_handoff_self_test=fail_runtime_identity; exit 1; } || :
    [ "$STAGE3_REASON" = runtime_origin_mismatch ] || { echo bootstrap_handoff_self_test=wrong_runtime_identity_reason; exit 1; }
    mv "$runtime_origin.good" "$runtime_origin"

    cp "$seed" "$seed.good"
    cp "$stage3_manifest" "$stage3_manifest.good"
    cp "$stage4_manifest" "$stage4_manifest.good"
    cp "$stage2" "$seed"
    self_test_replace_field "$stage3_manifest" seed_sha256 "$stage2_sha"
    self_test_replace_field "$stage4_manifest" stage3_provenance_sha256 "$(hash_file "$stage3_manifest")"
    evaluate_readiness && { echo bootstrap_handoff_self_test=fail_seed_substitution; exit 1; } || :
    [ "$STAGE3_REASON" = seed_substitution_detected ] || { echo bootstrap_handoff_self_test=wrong_seed_substitution_reason; exit 1; }
    mv "$seed.good" "$seed"
    mv "$stage3_manifest.good" "$stage3_manifest"
    mv "$stage4_manifest.good" "$stage4_manifest"

    cp "$stage2_sanity" "$stage2_sanity.good"
    cp "$stage3_manifest" "$stage3_manifest.good"
    cp "$stage4_manifest" "$stage4_manifest.good"
    self_test_replace_field "$stage2_sanity" unsupported_status 0
    self_test_replace_field "$stage3_manifest" stage2_sanity_evidence_sha256 "$(hash_file "$stage2_sanity")"
    self_test_replace_field "$stage4_manifest" stage3_provenance_sha256 "$(hash_file "$stage3_manifest")"
    evaluate_readiness && { echo bootstrap_handoff_self_test=fail_no_stub_contract; exit 1; } || :
    [ "$STAGE3_REASON" = stage2_no_stub_contract_invalid ] || { echo bootstrap_handoff_self_test=wrong_no_stub_reason; exit 1; }
    mv "$stage2_sanity.good" "$stage2_sanity"
    mv "$stage3_manifest.good" "$stage3_manifest"
    mv "$stage4_manifest.good" "$stage4_manifest"

    cp "$smoke" "$smoke.good"
    cp "$stage4_manifest" "$stage4_manifest.good"
    sed '1d' "$smoke.good" >"$smoke"
    self_test_replace_field "$stage4_manifest" essential_tools_log_sha256 "$(hash_file "$smoke")"
    evaluate_readiness && { echo bootstrap_handoff_self_test=fail_stage4_execution_contract; exit 1; } || :
    [ "$SMOKE_REASON" = receipt_not_bound_to_stage4_execution ] || { echo bootstrap_handoff_self_test=wrong_stage4_execution_reason; exit 1; }
    mv "$smoke.good" "$smoke"
    mv "$stage4_manifest.good" "$stage4_manifest"

    cp "$test_root/rollback.receipt.env" "$test_root/rollback.receipt.env.good"
    atomic_alias="$test_root/deploy/atomic-alias"
    cp "$deployed" "$atomic_alias"
    self_test_replace_field "$test_root/rollback.receipt.env" backup_path "$atomic_alias"
    evaluate_readiness && { echo bootstrap_handoff_self_test=fail_atomic_rollback_binding; exit 1; } || :
    [ "$ROLLBACK_REASON" = atomic_path_swap_mismatch ] || { echo bootstrap_handoff_self_test=wrong_atomic_rollback_reason; exit 1; }
    mv "$test_root/rollback.receipt.env.good" "$test_root/rollback.receipt.env"
    rm "$atomic_alias"

    mv "$test_root/deploy.receipt.env" "$test_root/deploy.receipt.env.missing"
    evaluate_readiness && { echo bootstrap_handoff_self_test=fail_missing_receipt; exit 1; } || :
    mv "$test_root/deploy.receipt.env.missing" "$test_root/deploy.receipt.env"
    cp "$stage4" "$test_root/stage4.good"
    self_test_file "$stage4" tampered
    evaluate_readiness && { echo bootstrap_handoff_self_test=fail_tamper; exit 1; } || :
    cp "$test_root/stage4.good" "$stage4"
    mv "$stage3" "$test_root/stage3.saved"
    ln -s "$test_root/stage3.saved" "$stage3"
    evaluate_readiness && { echo bootstrap_handoff_self_test=fail_symlink; exit 1; } || :
    rm "$stage3"
    mv "$test_root/stage3.saved" "$stage3"
    printf 'bootstrap_handoff_identity_guard_self_test=pass\n'
    printf 'bootstrap_handoff_stage2_stage3_guard_self_test=pass\n'
    printf 'bootstrap_handoff_no_seed_no_stub_guard_self_test=pass\n'
    printf 'bootstrap_handoff_atomic_rollback_guard_self_test=pass\n'
    printf 'bootstrap_handoff_stage4_execution_guard_self_test=pass\n'
    printf 'bootstrap_handoff_current_tree_guard_self_test=pass\n'
    printf 'bootstrap_handoff_wrong_worktree_guard_self_test=pass\n'
    printf 'bootstrap_handoff_self_test=pass\n'
    printf 'platform_acceptance_claimed=false\n'
}

usage() {
    printf '%s\n' "usage: $0 [--self-test]"
    printf '%s\n' 'Read-only bootstrap handoff readiness check; paths may be overridden with BOOTSTRAP_HANDOFF_* environment variables.'
}

configure_paths
case "${1:-}" in
    '')
        if [ "${BOOTSTRAP_HANDOFF_SELFTEST_CHILD:-0}" != 1 ]; then
            if ! verdict_self_test; then
                echo "ERROR — nothing was checked (verdict selftest failed)"
                exit 2
            fi
            if ! BOOTSTRAP_HANDOFF_SELFTEST_CHILD=1 sh "$0" --self-test >/dev/null 2>&1; then
                echo "ERROR — nothing was checked (fixture selftest failed)"
                exit 2
            fi
        fi
        evaluate_readiness || :
        emit_result
        emit_verdict "$GATE_TOTAL" "$GATE_COUNT" "$GATE_LIST" >/dev/null
        exit $?
        ;;
    --self-test)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        verdict_self_test || exit 1
        self_test
        ;;
    -h|--help)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
