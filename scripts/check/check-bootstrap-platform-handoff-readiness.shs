#!/bin/sh
# Read-only, fail-closed readiness checker for the bootstrap platform handoff.
# The only writes performed by --self-test are confined to its temporary fixture.
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd -P)
BOOTSTRAP_STAGE3_FACADE_PATH="$REPO_ROOT/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="$REPO_ROOT/scripts/check/lib/stage4-candidate-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"

HANDOFF_ROOT=
STAGE3_MANIFEST=
STAGE3_CANDIDATE=
STAGE4_PROVENANCE=
STAGE4_CANDIDATE=
SMOKE_RECEIPT=
DEPLOY_RECEIPT=
ROLLBACK_RECEIPT=
LINUX_AARCH64_RECEIPT=
MACOS_RECEIPT=
FREEBSD_IMAGE=
FREEBSD_IMAGE_RECEIPT=
SIMPLEOS_KERNEL=
SIMPLEOS_MANIFEST=
CURRENT_TREE_IDENTITY=
CURRENT_TREE_IDENTITY_DIR=
HANDOFF_SELFTEST_MODE=0

configure_paths() {
    HANDOFF_ROOT=${BOOTSTRAP_HANDOFF_ROOT:-${SIMPLE_BOOTSTRAP_HANDOFF_ROOT:-${BOOTSTRAP_HANDOFF_FIXTURE_ROOT:-$REPO_ROOT/build/bootstrap/handoff}}}
    case "$HANDOFF_ROOT" in /*) ;; *) HANDOFF_ROOT="$REPO_ROOT/$HANDOFF_ROOT" ;; esac

    STAGE3_MANIFEST=${BOOTSTRAP_HANDOFF_STAGE3_MANIFEST:-$HANDOFF_ROOT/stage3.provenance.env}
    STAGE3_CANDIDATE=${BOOTSTRAP_HANDOFF_STAGE3_CANDIDATE:-$HANDOFF_ROOT/stage3/simple}
    STAGE4_PROVENANCE=${BOOTSTRAP_HANDOFF_STAGE4_PROVENANCE:-$HANDOFF_ROOT/stage4.provenance.env}
    STAGE4_CANDIDATE=${BOOTSTRAP_HANDOFF_STAGE4_CANDIDATE:-$HANDOFF_ROOT/stage4/simple}
    SMOKE_RECEIPT=${BOOTSTRAP_HANDOFF_ESSENTIAL_SMOKE_RECEIPT:-${BOOTSTRAP_HANDOFF_SMOKE_RECEIPT:-$HANDOFF_ROOT/essential-tools-smoke.receipt}}
    DEPLOY_RECEIPT=${BOOTSTRAP_HANDOFF_DEPLOY_RECEIPT:-$HANDOFF_ROOT/deploy.receipt.env}
    ROLLBACK_RECEIPT=${BOOTSTRAP_HANDOFF_ROLLBACK_RECEIPT:-$HANDOFF_ROOT/rollback.receipt.env}
    LINUX_AARCH64_RECEIPT=${BOOTSTRAP_HANDOFF_LINUX_AARCH64_NATIVE_HOST_RECEIPT:-${BOOTSTRAP_HANDOFF_LINUX_AARCH64_HOST:-$HANDOFF_ROOT/linux-aarch64-native-host.receipt.env}}
    MACOS_RECEIPT=${BOOTSTRAP_HANDOFF_MACOS_NATIVE_HOST_RECEIPT:-${BOOTSTRAP_HANDOFF_MACOS_HOST:-$HANDOFF_ROOT/macos-native-host.receipt.env}}
    FREEBSD_IMAGE=${BOOTSTRAP_HANDOFF_FREEBSD_BASE_IMAGE:-$HANDOFF_ROOT/freebsd-base.qcow2}
    FREEBSD_IMAGE_RECEIPT=${BOOTSTRAP_HANDOFF_FREEBSD_BASE_IMAGE_RECEIPT:-$HANDOFF_ROOT/freebsd-base-image.receipt.env}
    SIMPLEOS_KERNEL=${BOOTSTRAP_HANDOFF_SIMPLEOS_ARM64_KERNEL:-$HANDOFF_ROOT/simpleos-arm64-kernel.elf}
    SIMPLEOS_MANIFEST=${BOOTSTRAP_HANDOFF_SIMPLEOS_ARM64_PRODUCER_MANIFEST:-${BOOTSTRAP_HANDOFF_SIMPLEOS_ARM64_MANIFEST:-$HANDOFF_ROOT/simpleos-arm64-producer-manifest.env}}
}

hash_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum -- "$1" | awk 'NF { print $1; exit }'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 -- "$1" | awk 'NF { print $1; exit }'
    elif command -v sha256 >/dev/null 2>&1; then
        sha256 -q "$1" | awk 'NF { print $1; exit }'
    else
        return 1
    fi
}

canonical_file() {
    file=$1
    [ -f "$file" ] && [ ! -L "$file" ] || return 1
    directory=$(CDPATH= cd -- "$(dirname "$file")" && pwd -P) || return 1
    base=$(basename "$file") || return 1
    canonical="$directory/$base"
    case "$file" in
        /*) [ "$canonical" = "$file" ] || return 1 ;;
    esac
    printf '%s\n' "$canonical"
}

canonical_any_existing() {
    file=$1
    [ -e "$file" ] || return 1
    [ ! -L "$file" ] || return 1
    if [ -f "$file" ]; then
        canonical_file "$file"
    elif [ -d "$file" ]; then
        directory=$(CDPATH= cd -- "$file" && pwd -P) || return 1
        case "$file" in
            /*) [ "$directory" = "$file" ] || return 1 ;;
        esac
        printf '%s\n' "$directory"
    else
        return 1
    fi
}

manifest_value() {
    key=$1
    file=$2
    awk -F '=' -v wanted="$key" '
        $1 == wanted { count++; value=substr($0, index($0, "=") + 1) }
        END { if (count != 1 || value == "") exit 1; print value }
    ' "$file"
}

ensure_current_tree_identity() {
    [ -z "$CURRENT_TREE_IDENTITY" ] || return 0
    if [ "$HANDOFF_SELFTEST_MODE" = 1 ] &&
       [ -n "${BOOTSTRAP_HANDOFF_SELFTEST_CURRENT_TREE_IDENTITY:-}" ]; then
        CURRENT_TREE_IDENTITY=$(canonical_file "$BOOTSTRAP_HANDOFF_SELFTEST_CURRENT_TREE_IDENTITY") || return 1
        return 0
    fi
    CURRENT_TREE_IDENTITY_DIR=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-handoff-current-tree.XXXXXX") || return 1
    CURRENT_TREE_IDENTITY="$CURRENT_TREE_IDENTITY_DIR/current.env"
    stage4_write_current_tree_identity "$CURRENT_TREE_IDENTITY" "$REPO_ROOT" || return 1
}

release_current_tree_identity() {
    [ -z "$CURRENT_TREE_IDENTITY_DIR" ] || rm -rf "$CURRENT_TREE_IDENTITY_DIR"
    CURRENT_TREE_IDENTITY=
    CURRENT_TREE_IDENTITY_DIR=
}

verify_current_tree_fields() {
    receipt=$1
    ensure_current_tree_identity || return 1
    for identity_key in repository_root source_revision_kind source_revision \
        source_roots stage3_source_snapshot_sha256 git_state_sha256 \
        git_head git_dirty_fingerprint stage3_producer_path \
        stage3_producer_sha256; do
        [ "$(manifest_value "$identity_key" "$receipt")" = \
          "$(manifest_value "$identity_key" "$CURRENT_TREE_IDENTITY")" ] || return 1
    done
}

verify_stage3_current_tree_fields() {
    manifest=$1
    ensure_current_tree_identity || return 1
    [ "$(manifest_value source_snapshot_sha256 "$manifest")" = \
      "$(manifest_value stage3_source_snapshot_sha256 "$CURRENT_TREE_IDENTITY")" ] || return 1
    [ "$(manifest_value git_state_sha256 "$manifest")" = \
      "$(manifest_value git_state_sha256 "$CURRENT_TREE_IDENTITY")" ] || return 1
    [ "$(manifest_value git_head "$manifest")" = \
      "$(manifest_value git_head "$CURRENT_TREE_IDENTITY")" ] || return 1
    [ "$(manifest_value git_dirty_fingerprint "$manifest")" = \
      "$(manifest_value git_dirty_fingerprint "$CURRENT_TREE_IDENTITY")" ] || return 1
    [ "$(manifest_value bootstrap_script_path "$manifest")" = \
      "$(manifest_value stage3_producer_path "$CURRENT_TREE_IDENTITY")" ] || return 1
    [ "$(manifest_value bootstrap_script_sha256 "$manifest")" = \
      "$(manifest_value stage3_producer_sha256 "$CURRENT_TREE_IDENTITY")" ] || return 1
}

field_any() {
    file=$1
    shift
    for key in "$@"; do
        if value=$(manifest_value "$key" "$file" 2>/dev/null); then
            printf '%s\n' "$value"
            return 0
        fi
    done
    return 1
}

expect_field() {
    expected=$3
    actual=$(manifest_value "$1" "$2" 2>/dev/null) || return 1
    [ "$actual" = "$expected" ]
}

valid_sha256() {
    printf '%s\n' "$1" | awk '/^[0-9a-f]{64}$/ { ok=1 } END { exit(ok ? 0 : 1) }'
}

verify_hashed_file() {
    file=$1
    expected=$2
    valid_sha256 "$expected" || return 1
    actual=$(hash_file "$file" 2>/dev/null) || return 1
    [ "$actual" = "$expected" ]
}

canonical_hashed_reference() {
    reference=$1
    base_directory=$2
    expected=$3
    resolved=$(resolve_reference "$reference" "$base_directory") || return 1
    canonical=$(canonical_file "$resolved") || return 1
    verify_hashed_file "$canonical" "$expected" || return 1
    printf '%s\n' "$canonical"
}

verify_sanity_receipt() {
    receipt=$1
    receipt_sha=$2
    candidate_sha=$3
    verify_hashed_file "$receipt" "$receipt_sha" || return 1
    expect_field schema "$receipt" simple-bootstrap-sanity-evidence-v1 || return 1
    expect_field status "$receipt" pass || return 1
    expect_field version_status "$receipt" 0 || return 1
    expect_field unsupported_status "$receipt" 1 || return 1
    expect_field frontend_smoke_status "$receipt" 0 || return 1
    expect_field frontend_smoke_bootstrap_mode_status "$receipt" 0 || return 1
    expect_field candidate_sha256_before "$receipt" "$candidate_sha" || return 1
    expect_field candidate_sha256_after "$receipt" "$candidate_sha" || return 1
    unsupported_sha=$(manifest_value unsupported_output_sha256 "$receipt") || return 1
    frontend_sha=$(manifest_value frontend_smoke_output_sha256 "$receipt") || return 1
    valid_sha256 "$unsupported_sha" && valid_sha256 "$frontend_sha"
}

verify_receiver_receipt() {
    receipt=$1
    receipt_sha=$2
    candidate_sha=$3
    runtime_sha=$4
    verify_hashed_file "$receipt" "$receipt_sha" || return 1
    expect_field schema "$receipt" simple-bootstrap-stage2-receiver-evidence-v1 || return 1
    expect_field status "$receipt" pass || return 1
    expect_field probe_exit "$receipt" 0 || return 1
    expect_field candidate_sha256_before "$receipt" "$candidate_sha" || return 1
    expect_field candidate_sha256_after "$receipt" "$candidate_sha" || return 1
    expect_field runtime_snapshot_sha256 "$receipt" "$runtime_sha" || return 1
    probe_log=$(manifest_value probe_log "$receipt") || return 1
    probe_log_sha=$(manifest_value probe_log_sha256 "$receipt") || return 1
    probe_base=$(dirname "$receipt")
    canonical_hashed_reference "$probe_log" "$probe_base" "$probe_log_sha" >/dev/null
}

resolve_reference() {
    reference=$1
    base_directory=$2
    case "$reference" in
        /*) printf '%s\n' "$reference" ;;
        *) printf '%s/%s\n' "$base_directory" "$reference" ;;
    esac
}

same_file_reference() {
    reference=$1
    expected=$2
    base_directory=$3
    resolved=$(resolve_reference "$reference" "$base_directory") || return 1
    left=$(canonical_file "$resolved") || return 1
    right=$(canonical_file "$expected") || return 1
    [ "$left" = "$right" ]
}

GATE_COUNT=0
GATE_TOTAL=0
GATE_LIST=
READINESS_STATUS=blocked
READINESS_REASON=

add_reason() {
    reason=$1
    if [ -n "$READINESS_REASON" ]; then
        READINESS_REASON="$READINESS_REASON|$reason"
    else
        READINESS_REASON=$reason
    fi
}

record_gate() {
    gate=$1
    status=$2
    reason=$3
    GATE_TOTAL=$((GATE_TOTAL + 1))
    if [ "$status" != ready ]; then
        GATE_COUNT=$((GATE_COUNT + 1))
        if [ -n "$GATE_LIST" ]; then GATE_LIST="$GATE_LIST,$gate"; else GATE_LIST=$gate; fi
        add_reason "$gate:$reason"
    fi
}

STAGE3_STATUS=blocked
STAGE3_REASON=not_checked
STAGE4_STATUS=blocked
STAGE4_REASON=not_checked
SMOKE_STATUS=blocked
SMOKE_REASON=not_checked
DEPLOY_STATUS=blocked
DEPLOY_REASON=not_checked
ROLLBACK_STATUS=blocked
ROLLBACK_REASON=not_checked
LINUX_STATUS=blocked
LINUX_REASON=not_checked
MACOS_STATUS=blocked
MACOS_REASON=not_checked
FREEBSD_STATUS=blocked
FREEBSD_REASON=not_checked
SIMPLEOS_KERNEL_STATUS=blocked
SIMPLEOS_KERNEL_REASON=not_checked
SIMPLEOS_MANIFEST_STATUS=blocked
SIMPLEOS_MANIFEST_REASON=not_checked
SMOKE_TEST_RUNNER_STATUS=blocked
SMOKE_LINT_STATUS=blocked
SMOKE_DUPLICATE_STATUS=blocked
SMOKE_AGGREGATE_STATUS=blocked
STAGE4_SMOKE_FROM_PROVENANCE=

check_stage3() {
    STAGE3_STATUS=blocked
    if ! canonical_file "$STAGE3_MANIFEST" >/dev/null 2>&1; then STAGE3_REASON=missing_or_symlinked_manifest; return 1; fi
    if ! canonical_file "$STAGE3_CANDIDATE" >/dev/null 2>&1; then STAGE3_REASON=missing_or_symlinked_candidate; return 1; fi
    expect_field schema "$STAGE3_MANIFEST" simple-bootstrap-stage3-provenance-v4 || { STAGE3_REASON=invalid_schema; return 1; }
    expect_field status "$STAGE3_MANIFEST" pass || { STAGE3_REASON=manifest_not_pass; return 1; }
    expect_field artifact_kind "$STAGE3_MANIFEST" pure-simple-bootstrap-compiler || { STAGE3_REASON=invalid_artifact_kind; return 1; }
    expect_field platform "$STAGE3_MANIFEST" x86_64-unknown-linux-gnu || { STAGE3_REASON=invalid_platform; return 1; }
    expect_field source_roots "$STAGE3_MANIFEST" src/compiler:src/app:src/lib || { STAGE3_REASON=invalid_source_roots; return 1; }
    expect_field stage2_sanity_status "$STAGE3_MANIFEST" pass || { STAGE3_REASON=stage2_sanity_not_pass; return 1; }
    expect_field stage3_sanity_status "$STAGE3_MANIFEST" pass || { STAGE3_REASON=stage3_sanity_not_pass; return 1; }
    expect_field stage2_receiver_status "$STAGE3_MANIFEST" pass || { STAGE3_REASON=stage2_receiver_not_pass; return 1; }
    expect_field stage2_check_policy "$STAGE3_MANIFEST" identity-scoped-receipt-reuse || { STAGE3_REASON=invalid_stage2_check_policy; return 1; }
    expect_field stage2_checks_executed_at_admission "$STAGE3_MANIFEST" 1 || { STAGE3_REASON=invalid_stage2_admission_count; return 1; }
    expect_field stage2_checks_replayed_during_stage3 "$STAGE3_MANIFEST" 0 || { STAGE3_REASON=stage2_checks_replayed; return 1; }
    stage2_admission_identity=$(manifest_value stage2_admission_identity "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage2_admission_identity; return 1; }
    valid_sha256 "$stage2_admission_identity" || { STAGE3_REASON=invalid_stage2_admission_identity; return 1; }
    stage2_admission_receipt=$(manifest_value stage2_admission_receipt_path "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage2_admission_receipt; return 1; }
    stage2_admission_receipt_sha=$(manifest_value stage2_admission_receipt_sha256 "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage2_admission_receipt_hash; return 1; }
    valid_sha256 "$stage2_admission_receipt_sha" || { STAGE3_REASON=invalid_stage2_admission_receipt_hash; return 1; }
    seed_ref=$(manifest_value seed_path "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_seed_path; return 1; }
    seed_sha=$(manifest_value seed_sha256 "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_seed_hash; return 1; }
    stage2_ref=$(manifest_value stage2_path "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage2_path; return 1; }
    stage2_sha=$(manifest_value stage2_sha256 "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage2_hash; return 1; }
    stage2_admitted_ref=$(manifest_value stage2_admitted_path "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage2_admitted_path; return 1; }
    stage2_admitted_sha=$(manifest_value stage2_admitted_sha256 "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage2_admitted_hash; return 1; }
    stage3_path=$(manifest_value stage3_path "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage3_path; return 1; }
    stage3_sha=$(manifest_value stage3_sha256 "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage3_hash; return 1; }
    output_path=$(manifest_value output_path "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_output_path; return 1; }
    output_sha=$(manifest_value output_sha256 "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_output_hash; return 1; }
    base=$(dirname "$STAGE3_MANIFEST")
    same_file_reference "$stage2_admission_receipt" "$base/stage2-admitted/admission.env" "$base" || { STAGE3_REASON=stage2_admission_receipt_path_mismatch; return 1; }
    verify_hashed_file "$stage2_admission_receipt" "$stage2_admission_receipt_sha" || { STAGE3_REASON=stage2_admission_receipt_hash_mismatch; return 1; }
    seed_path=$(canonical_hashed_reference "$seed_ref" "$base" "$seed_sha") || { STAGE3_REASON=seed_identity_mismatch; return 1; }
    stage2_path=$(canonical_hashed_reference "$stage2_ref" "$base" "$stage2_sha") || { STAGE3_REASON=stage2_identity_mismatch; return 1; }
    stage2_admitted_path=$(canonical_hashed_reference "$stage2_admitted_ref" "$base" "$stage2_admitted_sha") || { STAGE3_REASON=stage2_admitted_identity_mismatch; return 1; }
    [ "$stage2_sha" = "$stage2_admitted_sha" ] || { STAGE3_REASON=stage2_admitted_hash_mismatch; return 1; }
    [ "$seed_path" != "$stage2_path" ] && [ "$seed_path" != "$stage2_admitted_path" ] && [ "$seed_sha" != "$stage2_sha" ] || { STAGE3_REASON=seed_substitution_detected; return 1; }
    same_file_reference "$stage3_path" "$STAGE3_CANDIDATE" "$base" || { STAGE3_REASON=stage3_path_mismatch; return 1; }
    same_file_reference "$output_path" "$STAGE3_CANDIDATE" "$base" || { STAGE3_REASON=output_path_mismatch; return 1; }
    verify_hashed_file "$STAGE3_CANDIDATE" "$stage3_sha" || { STAGE3_REASON=stage3_hash_mismatch; return 1; }
    verify_hashed_file "$STAGE3_CANDIDATE" "$output_sha" || { STAGE3_REASON=output_hash_mismatch; return 1; }
    [ "$seed_path" != "$(canonical_file "$STAGE3_CANDIDATE")" ] && [ "$seed_sha" != "$stage3_sha" ] || { STAGE3_REASON=seed_substitution_detected; return 1; }

    source_ref=$(manifest_value source_snapshot_path "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_source_identity; return 1; }
    source_sha=$(manifest_value source_snapshot_sha256 "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_source_identity_hash; return 1; }
    source_fingerprint=$(manifest_value source_fingerprint "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_source_fingerprint; return 1; }
    canonical_hashed_reference "$source_ref" "$base" "$source_sha" >/dev/null || { STAGE3_REASON=source_identity_mismatch; return 1; }
    [ "$source_sha" = "$source_fingerprint" ] || { STAGE3_REASON=source_fingerprint_mismatch; return 1; }
    verify_stage3_current_tree_fields "$STAGE3_MANIFEST" || { STAGE3_REASON=current_tree_identity_mismatch; return 1; }
    runtime_origin_ref=$(manifest_value runtime_origin_snapshot_path "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_runtime_origin; return 1; }
    runtime_origin_sha=$(manifest_value runtime_origin_snapshot_sha256 "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_runtime_origin_hash; return 1; }
    runtime_admitted_ref=$(manifest_value runtime_admitted_snapshot_path "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_runtime_admission; return 1; }
    runtime_admitted_sha=$(manifest_value runtime_admitted_snapshot_sha256 "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_runtime_admission_hash; return 1; }
    canonical_hashed_reference "$runtime_origin_ref" "$base" "$runtime_origin_sha" >/dev/null || { STAGE3_REASON=runtime_origin_mismatch; return 1; }
    canonical_hashed_reference "$runtime_admitted_ref" "$base" "$runtime_admitted_sha" >/dev/null || { STAGE3_REASON=runtime_admission_mismatch; return 1; }
    [ "$runtime_origin_sha" = "$runtime_admitted_sha" ] || { STAGE3_REASON=runtime_identity_mismatch; return 1; }
    tool_ref=$(manifest_value tool_authority_path "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_compiler_authority; return 1; }
    tool_sha=$(manifest_value tool_authority_sha256 "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_compiler_authority_hash; return 1; }
    canonical_hashed_reference "$tool_ref" "$base" "$tool_sha" >/dev/null || { STAGE3_REASON=compiler_authority_mismatch; return 1; }

    expect_field schema "$stage2_admission_receipt" simple-bootstrap-stage2-admission-v1 || { STAGE3_REASON=invalid_stage2_admission_schema; return 1; }
    expect_field status "$stage2_admission_receipt" admitted || { STAGE3_REASON=stage2_not_admitted; return 1; }
    expect_field checks_executed_at_admission "$stage2_admission_receipt" 1 || { STAGE3_REASON=invalid_stage2_receipt_count; return 1; }
    expect_field checks_replayed_during_stage3 "$stage2_admission_receipt" 0 || { STAGE3_REASON=stage2_receipt_replayed; return 1; }
    expect_field admission_identity "$stage2_admission_receipt" "$stage2_admission_identity" || { STAGE3_REASON=stage2_admission_identity_mismatch; return 1; }
    admitted_candidate_ref=$(manifest_value candidate_path "$stage2_admission_receipt") || { STAGE3_REASON=missing_admitted_candidate; return 1; }
    admitted_candidate_sha=$(manifest_value candidate_sha256 "$stage2_admission_receipt") || { STAGE3_REASON=missing_admitted_candidate_hash; return 1; }
    same_file_reference "$admitted_candidate_ref" "$stage2_admitted_path" "$(dirname "$stage2_admission_receipt")" || { STAGE3_REASON=admitted_candidate_path_mismatch; return 1; }
    [ "$admitted_candidate_sha" = "$stage2_admitted_sha" ] || { STAGE3_REASON=admitted_candidate_hash_mismatch; return 1; }
    expect_field source_snapshot_sha256 "$stage2_admission_receipt" "$source_sha" || { STAGE3_REASON=stage2_source_identity_mismatch; return 1; }
    expect_field runtime_snapshot_sha256 "$stage2_admission_receipt" "$runtime_admitted_sha" || { STAGE3_REASON=stage2_runtime_identity_mismatch; return 1; }
    expect_field tool_authority_sha256 "$stage2_admission_receipt" "$tool_sha" || { STAGE3_REASON=stage2_compiler_authority_mismatch; return 1; }

    stage2_sanity_ref=$(manifest_value stage2_sanity_evidence_path "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage2_sanity_receipt; return 1; }
    stage2_sanity_sha=$(manifest_value stage2_sanity_evidence_sha256 "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage2_sanity_hash; return 1; }
    stage2_sanity=$(canonical_hashed_reference "$stage2_sanity_ref" "$base" "$stage2_sanity_sha") || { STAGE3_REASON=stage2_sanity_hash_mismatch; return 1; }
    verify_sanity_receipt "$stage2_sanity" "$stage2_sanity_sha" "$stage2_sha" || { STAGE3_REASON=stage2_no_stub_contract_invalid; return 1; }
    stage3_sanity_ref=$(manifest_value stage3_sanity_evidence_path "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage3_sanity_receipt; return 1; }
    stage3_sanity_sha=$(manifest_value stage3_sanity_evidence_sha256 "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage3_sanity_hash; return 1; }
    stage3_sanity=$(canonical_hashed_reference "$stage3_sanity_ref" "$base" "$stage3_sanity_sha") || { STAGE3_REASON=stage3_sanity_hash_mismatch; return 1; }
    verify_sanity_receipt "$stage3_sanity" "$stage3_sanity_sha" "$stage3_sha" || { STAGE3_REASON=stage3_no_stub_contract_invalid; return 1; }
    receiver_ref=$(manifest_value stage2_receiver_evidence_path "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage2_receiver_receipt; return 1; }
    receiver_sha=$(manifest_value stage2_receiver_evidence_sha256 "$STAGE3_MANIFEST") || { STAGE3_REASON=missing_stage2_receiver_hash; return 1; }
    receiver=$(canonical_hashed_reference "$receiver_ref" "$base" "$receiver_sha") || { STAGE3_REASON=stage2_receiver_hash_mismatch; return 1; }
    verify_receiver_receipt "$receiver" "$receiver_sha" "$stage2_sha" "$runtime_admitted_sha" || { STAGE3_REASON=stage2_runtime_receiver_invalid; return 1; }
    STAGE3_STATUS=ready
    STAGE3_REASON=validated
    return 0
}

check_stage4() {
    STAGE4_STATUS=blocked
    if ! canonical_file "$STAGE4_PROVENANCE" >/dev/null 2>&1; then STAGE4_REASON=missing_or_symlinked_provenance; return 1; fi
    if ! canonical_file "$STAGE4_CANDIDATE" >/dev/null 2>&1; then STAGE4_REASON=missing_or_symlinked_candidate; return 1; fi
    [ -x "$STAGE4_CANDIDATE" ] || { STAGE4_REASON=candidate_not_executable; return 1; }
    expect_field schema "$STAGE4_PROVENANCE" simple-bootstrap-stage4-provenance-v1 || { STAGE4_REASON=invalid_schema; return 1; }
    expect_field status "$STAGE4_PROVENANCE" pass || { STAGE4_REASON=provenance_not_pass; return 1; }
    expect_field artifact_kind "$STAGE4_PROVENANCE" pure-simple-full-cli || { STAGE4_REASON=invalid_artifact_kind; return 1; }
    output_path=$(manifest_value output_path "$STAGE4_PROVENANCE") || { STAGE4_REASON=missing_output_path; return 1; }
    output_sha=$(manifest_value output_sha256 "$STAGE4_PROVENANCE") || { STAGE4_REASON=missing_output_hash; return 1; }
    expect_field source_revision_kind "$STAGE4_PROVENANCE" content-sha256 || { STAGE4_REASON=invalid_source_revision_kind; return 1; }
    source_revision=$(manifest_value source_revision "$STAGE4_PROVENANCE") || { STAGE4_REASON=missing_source_revision; return 1; }
    valid_sha256 "$source_revision" || { STAGE4_REASON=invalid_source_revision; return 1; }
    expect_field source_roots "$STAGE4_PROVENANCE" src/compiler:src/lib:src/app:src/runtime:examples/10_tooling || { STAGE4_REASON=invalid_source_roots; return 1; }
    parent_ref=$(manifest_value parent_compiler_path "$STAGE4_PROVENANCE") || { STAGE4_REASON=missing_parent_compiler; return 1; }
    parent_sha=$(manifest_value parent_compiler_sha256 "$STAGE4_PROVENANCE") || { STAGE4_REASON=missing_parent_compiler_hash; return 1; }
    stage3_ref=$(manifest_value stage3_provenance_path "$STAGE4_PROVENANCE") || { STAGE4_REASON=missing_stage3_provenance; return 1; }
    stage3_provenance_sha=$(manifest_value stage3_provenance_sha256 "$STAGE4_PROVENANCE") || { STAGE4_REASON=missing_stage3_provenance_hash; return 1; }
    smoke_ref=$(manifest_value essential_tools_log_path "$STAGE4_PROVENANCE") || { STAGE4_REASON=missing_smoke_receipt; return 1; }
    smoke_sha=$(manifest_value essential_tools_log_sha256 "$STAGE4_PROVENANCE") || { STAGE4_REASON=missing_smoke_hash; return 1; }
    expect_field completed_gate "$STAGE4_PROVENANCE" stage4-essential-tools-smoke || { STAGE4_REASON=essential_smoke_not_completed; return 1; }
    base=$(dirname "$STAGE4_PROVENANCE")
    same_file_reference "$output_path" "$STAGE4_CANDIDATE" "$base" || { STAGE4_REASON=output_path_mismatch; return 1; }
    verify_hashed_file "$STAGE4_CANDIDATE" "$output_sha" || { STAGE4_REASON=output_hash_mismatch; return 1; }
    same_file_reference "$parent_ref" "$STAGE3_CANDIDATE" "$base" || { STAGE4_REASON=parent_compiler_mismatch; return 1; }
    stage3_sha=$(manifest_value stage3_sha256 "$STAGE3_MANIFEST") || { STAGE4_REASON=stage3_identity_missing; return 1; }
    [ "$parent_sha" = "$stage3_sha" ] && verify_hashed_file "$STAGE3_CANDIDATE" "$parent_sha" || { STAGE4_REASON=parent_compiler_hash_mismatch; return 1; }
    same_file_reference "$stage3_ref" "$STAGE3_MANIFEST" "$base" || { STAGE4_REASON=stage3_provenance_mismatch; return 1; }
    verify_hashed_file "$STAGE3_MANIFEST" "$stage3_provenance_sha" || { STAGE4_REASON=stage3_provenance_hash_mismatch; return 1; }
    verify_current_tree_fields "$STAGE4_PROVENANCE" || { STAGE4_REASON=current_tree_identity_mismatch; return 1; }
    stage4_verify_stage3_identity_fields "$STAGE4_PROVENANCE" "$STAGE3_MANIFEST" "$REPO_ROOT" || { STAGE4_REASON=stage3_source_or_producer_mismatch; return 1; }
    STAGE4_SMOKE_FROM_PROVENANCE=$(resolve_reference "$smoke_ref" "$base")
    verify_hashed_file "$STAGE4_SMOKE_FROM_PROVENANCE" "$smoke_sha" || { STAGE4_REASON=smoke_receipt_hash_mismatch; return 1; }
    STAGE4_STATUS=ready
    STAGE4_REASON=validated
    return 0
}

check_smoke_marker() {
    marker=$1
    count=$(grep -Fxc "$marker" "$SMOKE_RECEIPT" 2>/dev/null || true)
    [ "$count" -eq 1 ]
}

check_smoke() {
    SMOKE_STATUS=blocked
    SMOKE_TEST_RUNNER_STATUS=blocked
    SMOKE_LINT_STATUS=blocked
    SMOKE_DUPLICATE_STATUS=blocked
    SMOKE_AGGREGATE_STATUS=blocked
    if [ -z "${BOOTSTRAP_HANDOFF_ESSENTIAL_SMOKE_RECEIPT:-}${BOOTSTRAP_HANDOFF_SMOKE_RECEIPT:-}" ] && [ -n "$STAGE4_SMOKE_FROM_PROVENANCE" ]; then
        SMOKE_RECEIPT=$STAGE4_SMOKE_FROM_PROVENANCE
    fi
    if ! canonical_file "$SMOKE_RECEIPT" >/dev/null 2>&1; then SMOKE_REASON=missing_or_symlinked_receipt; return 1; fi
    [ -x "$STAGE4_CANDIDATE" ] || { SMOKE_REASON=stage4_candidate_not_executable; return 1; }
    check_smoke_marker essential_tools_identity_rc=0 || { SMOKE_REASON=missing_executable_identity_status; return 1; }
    check_smoke_marker essential_tools_pure_simple_identity=true || { SMOKE_REASON=missing_pure_simple_identity; return 1; }
    check_smoke_marker "command: run_timeout_kill 180 env SIMPLE_BINARY=$STAGE4_CANDIDATE sh scripts/check/check-bootstrap-essential-tools-smoke.shs" || { SMOKE_REASON=receipt_not_bound_to_stage4_execution; return 1; }
    if grep -Fq 'error=' "$SMOKE_RECEIPT"; then SMOKE_REASON=smoke_error_present; return 1; fi
    check_smoke_marker essential_test_runner_smoke=true && SMOKE_TEST_RUNNER_STATUS=ready
    check_smoke_marker essential_lint_smoke=true && SMOKE_LINT_STATUS=ready
    check_smoke_marker essential_duplicate_checker_smoke=true && SMOKE_DUPLICATE_STATUS=ready
    check_smoke_marker bootstrap_essential_tools_smoke=true && SMOKE_AGGREGATE_STATUS=ready
    if [ "$SMOKE_TEST_RUNNER_STATUS" != ready ]; then SMOKE_REASON=missing_test_runner_marker; return 1; fi
    if [ "$SMOKE_LINT_STATUS" != ready ]; then SMOKE_REASON=missing_lint_marker; return 1; fi
    if [ "$SMOKE_DUPLICATE_STATUS" != ready ]; then SMOKE_REASON=missing_duplicate_marker; return 1; fi
    if [ "$SMOKE_AGGREGATE_STATUS" != ready ]; then SMOKE_REASON=missing_aggregate_marker; return 1; fi
    if [ -n "$STAGE4_SMOKE_FROM_PROVENANCE" ] && ! same_file_reference "$STAGE4_SMOKE_FROM_PROVENANCE" "$SMOKE_RECEIPT" "$(dirname "$STAGE4_PROVENANCE")"; then
        SMOKE_REASON=receipt_not_bound_to_stage4
        return 1
    fi
    SMOKE_STATUS=ready
    SMOKE_REASON=validated
    return 0
}

receipt_file_ready() {
    file=$1
    schema=$2
    canonical_file "$file" >/dev/null 2>&1 || return 1
    actual_schema=$(manifest_value schema "$file" 2>/dev/null) || return 1
    schema_match=0
    old_ifs=$IFS
    IFS=,
    for allowed_schema in $schema; do
        if [ "$actual_schema" = "$allowed_schema" ]; then
            schema_match=1
        fi
    done
    IFS=$old_ifs
    [ "$schema_match" -eq 1 ] || return 1
    expect_field status "$file" pass || return 1
}

check_deploy() {
    DEPLOY_STATUS=blocked
    canonical_file "$DEPLOY_RECEIPT" >/dev/null 2>&1 || { DEPLOY_REASON=missing_or_invalid_receipt; return 1; }
    expect_field schema "$DEPLOY_RECEIPT" bootstrap-deploy-receipt-v1 || { DEPLOY_REASON=invalid_schema; return 1; }
    expect_field deployment_status "$DEPLOY_RECEIPT" pass || { DEPLOY_REASON=receipt_not_pass; return 1; }
    expect_field platform_acceptance_claimed "$DEPLOY_RECEIPT" false || { DEPLOY_REASON=false_platform_claim_missing; return 1; }
    deploy_platform=$(manifest_value platform "$DEPLOY_RECEIPT") || { DEPLOY_REASON=missing_platform; return 1; }
    current_ref=$(manifest_value current_path "$DEPLOY_RECEIPT") || { DEPLOY_REASON=missing_current_path; return 1; }
    current_sha=$(manifest_value current_sha256 "$DEPLOY_RECEIPT") || { DEPLOY_REASON=missing_current_hash; return 1; }
    backup_ref=$(manifest_value backup_path "$DEPLOY_RECEIPT") || { DEPLOY_REASON=missing_backup_path; return 1; }
    backup_sha=$(manifest_value backup_sha256 "$DEPLOY_RECEIPT") || { DEPLOY_REASON=missing_backup_hash; return 1; }
    [ "$backup_sha" != none ] || { DEPLOY_REASON=rollback_backup_missing; return 1; }
    base=$(dirname "$DEPLOY_RECEIPT")
    stage4_ref=$(manifest_value stage4_candidate_path "$DEPLOY_RECEIPT") || { DEPLOY_REASON=missing_stage4_candidate_path; return 1; }
    stage4_provenance_ref=$(manifest_value stage4_provenance_path "$DEPLOY_RECEIPT") || { DEPLOY_REASON=missing_stage4_provenance_path; return 1; }
    stage4_provenance_sha=$(manifest_value stage4_provenance_sha256 "$DEPLOY_RECEIPT") || { DEPLOY_REASON=missing_stage4_provenance_hash; return 1; }
    same_file_reference "$stage4_ref" "$STAGE4_CANDIDATE" "$base" || { DEPLOY_REASON=stage4_candidate_path_mismatch; return 1; }
    same_file_reference "$stage4_provenance_ref" "$STAGE4_PROVENANCE" "$base" || { DEPLOY_REASON=stage4_provenance_path_mismatch; return 1; }
    verify_hashed_file "$STAGE4_PROVENANCE" "$stage4_provenance_sha" || { DEPLOY_REASON=stage4_provenance_hash_mismatch; return 1; }
    verify_current_tree_fields "$DEPLOY_RECEIPT" || { DEPLOY_REASON=current_tree_identity_mismatch; return 1; }
    for identity_key in repository_root source_revision_kind source_revision \
        source_roots stage3_source_snapshot_sha256 git_state_sha256 git_head \
        git_dirty_fingerprint stage3_producer_path stage3_producer_sha256; do
        expect_field "$identity_key" "$DEPLOY_RECEIPT" \
          "$(manifest_value "$identity_key" "$STAGE4_PROVENANCE")" || { DEPLOY_REASON=stage4_identity_mismatch; return 1; }
    done
    acceptance_ref=$(manifest_value stage3_current_acceptance_receipt "$DEPLOY_RECEIPT") || { DEPLOY_REASON=missing_stage3_acceptance; return 1; }
    acceptance_sha=$(manifest_value stage3_current_acceptance_receipt_sha256 "$DEPLOY_RECEIPT") || { DEPLOY_REASON=missing_stage3_acceptance_hash; return 1; }
    acceptance=$(canonical_hashed_reference "$acceptance_ref" "$base" "$acceptance_sha") || { DEPLOY_REASON=stage3_acceptance_hash_mismatch; return 1; }
    expect_field stage3_current_acceptance_status "$DEPLOY_RECEIPT" verified || { DEPLOY_REASON=stage3_acceptance_not_verified; return 1; }
    expect_field status "$acceptance" verified || { DEPLOY_REASON=stage3_acceptance_receipt_not_verified; return 1; }
    expect_field stage4_candidate_sha256 "$acceptance" "$(manifest_value stage4_candidate_sha256 "$DEPLOY_RECEIPT")" || { DEPLOY_REASON=stage3_acceptance_candidate_mismatch; return 1; }
    expect_field stage4_provenance_sha256 "$acceptance" "$stage4_provenance_sha" || { DEPLOY_REASON=stage3_acceptance_provenance_mismatch; return 1; }
    for identity_key in repository_root source_revision_kind source_revision \
        source_roots stage3_source_snapshot_sha256 git_state_sha256 git_head \
        git_dirty_fingerprint stage3_producer_path stage3_producer_sha256; do
        expect_field "$identity_key" "$acceptance" \
          "$(manifest_value "$identity_key" "$DEPLOY_RECEIPT")" || { DEPLOY_REASON=stage3_acceptance_identity_mismatch; return 1; }
    done
    current_path=$(resolve_reference "$current_ref" "$base")
    backup_path=$(resolve_reference "$backup_ref" "$base")
    verify_hashed_file "$current_path" "$current_sha" || { DEPLOY_REASON=current_hash_mismatch; return 1; }
    verify_hashed_file "$backup_path" "$backup_sha" || { DEPLOY_REASON=backup_hash_mismatch; return 1; }
    stage4_sha=$(manifest_value output_sha256 "$STAGE4_PROVENANCE") || { DEPLOY_REASON=stage4_lineage_missing; return 1; }
    expect_field stage4_candidate_sha256 "$DEPLOY_RECEIPT" "$stage4_sha" || { DEPLOY_REASON=stage4_candidate_receipt_mismatch; return 1; }
    [ "$current_sha" = "$stage4_sha" ] || { DEPLOY_REASON=stage4_lineage_mismatch; return 1; }
    [ "$current_path" != "$backup_path" ] || { DEPLOY_REASON=non_atomic_same_path; return 1; }
    DEPLOY_STATUS=ready
    DEPLOY_REASON=validated
    return 0
}

check_rollback() {
    ROLLBACK_STATUS=blocked
    canonical_file "$ROLLBACK_RECEIPT" >/dev/null 2>&1 || { ROLLBACK_REASON=missing_or_invalid_receipt; return 1; }
    canonical_file "$DEPLOY_RECEIPT" >/dev/null 2>&1 || { ROLLBACK_REASON=deploy_receipt_missing; return 1; }
    expect_field schema "$ROLLBACK_RECEIPT" bootstrap-rollback-receipt-v1 || { ROLLBACK_REASON=invalid_schema; return 1; }
    expect_field rollback_status "$ROLLBACK_RECEIPT" pass || { ROLLBACK_REASON=receipt_not_pass; return 1; }
    expect_field platform_acceptance_claimed "$ROLLBACK_RECEIPT" false || { ROLLBACK_REASON=false_platform_claim_missing; return 1; }
    rollback_platform=$(manifest_value platform "$ROLLBACK_RECEIPT") || { ROLLBACK_REASON=missing_platform; return 1; }
    deploy_platform=$(manifest_value platform "$DEPLOY_RECEIPT") || { ROLLBACK_REASON=deploy_platform_missing; return 1; }
    [ "$rollback_platform" = "$deploy_platform" ] || { ROLLBACK_REASON=platform_mismatch; return 1; }
    deploy_receipt_sha=$(manifest_value deploy_receipt_sha256 "$ROLLBACK_RECEIPT") || { ROLLBACK_REASON=missing_deploy_receipt_hash; return 1; }
    verify_hashed_file "$DEPLOY_RECEIPT" "$deploy_receipt_sha" || { ROLLBACK_REASON=deploy_receipt_hash_mismatch; return 1; }
    verify_current_tree_fields "$ROLLBACK_RECEIPT" || { ROLLBACK_REASON=current_tree_identity_mismatch; return 1; }
    for identity_key in repository_root source_revision_kind source_revision \
        source_roots stage3_source_snapshot_sha256 git_state_sha256 git_head \
        git_dirty_fingerprint stage3_producer_path stage3_producer_sha256; do
        expect_field "$identity_key" "$ROLLBACK_RECEIPT" \
          "$(manifest_value "$identity_key" "$DEPLOY_RECEIPT")" || { ROLLBACK_REASON=deploy_identity_mismatch; return 1; }
    done
    stage4_ref=$(manifest_value stage4_candidate_path "$ROLLBACK_RECEIPT") || { ROLLBACK_REASON=missing_stage4_candidate_path; return 1; }
    stage4_sha=$(manifest_value stage4_candidate_sha256 "$ROLLBACK_RECEIPT") || { ROLLBACK_REASON=missing_stage4_candidate_hash; return 1; }
    stage4_provenance_ref=$(manifest_value stage4_provenance_path "$ROLLBACK_RECEIPT") || { ROLLBACK_REASON=missing_stage4_provenance_path; return 1; }
    stage4_provenance_sha=$(manifest_value stage4_provenance_sha256 "$ROLLBACK_RECEIPT") || { ROLLBACK_REASON=missing_stage4_provenance_hash; return 1; }
    same_file_reference "$stage4_ref" "$STAGE4_CANDIDATE" "$(dirname "$ROLLBACK_RECEIPT")" || { ROLLBACK_REASON=stage4_candidate_path_mismatch; return 1; }
    [ "$stage4_sha" = "$(manifest_value stage4_candidate_sha256 "$DEPLOY_RECEIPT")" ] || { ROLLBACK_REASON=stage4_candidate_hash_mismatch; return 1; }
    same_file_reference "$stage4_provenance_ref" "$STAGE4_PROVENANCE" "$(dirname "$ROLLBACK_RECEIPT")" || { ROLLBACK_REASON=stage4_provenance_path_mismatch; return 1; }
    [ "$stage4_provenance_sha" = "$(manifest_value stage4_provenance_sha256 "$DEPLOY_RECEIPT")" ] && verify_hashed_file "$STAGE4_PROVENANCE" "$stage4_provenance_sha" || { ROLLBACK_REASON=stage4_provenance_hash_mismatch; return 1; }
    acceptance_ref=$(manifest_value stage3_current_acceptance_receipt "$ROLLBACK_RECEIPT") || { ROLLBACK_REASON=missing_stage3_acceptance; return 1; }
    acceptance_sha=$(manifest_value stage3_current_acceptance_receipt_sha256 "$ROLLBACK_RECEIPT") || { ROLLBACK_REASON=missing_stage3_acceptance_hash; return 1; }
    [ "$acceptance_ref" = "$(manifest_value stage3_current_acceptance_receipt "$DEPLOY_RECEIPT")" ] || { ROLLBACK_REASON=stage3_acceptance_path_mismatch; return 1; }
    [ "$acceptance_sha" = "$(manifest_value stage3_current_acceptance_receipt_sha256 "$DEPLOY_RECEIPT")" ] && canonical_hashed_reference "$acceptance_ref" "$(dirname "$ROLLBACK_RECEIPT")" "$acceptance_sha" >/dev/null || { ROLLBACK_REASON=stage3_acceptance_hash_mismatch; return 1; }
    current_ref=$(manifest_value current_path "$ROLLBACK_RECEIPT") || { ROLLBACK_REASON=missing_current_path; return 1; }
    current_sha=$(manifest_value current_sha256 "$ROLLBACK_RECEIPT") || { ROLLBACK_REASON=missing_current_hash; return 1; }
    backup_ref=$(manifest_value backup_path "$ROLLBACK_RECEIPT") || { ROLLBACK_REASON=missing_backup_path; return 1; }
    backup_sha=$(manifest_value backup_sha256 "$ROLLBACK_RECEIPT") || { ROLLBACK_REASON=missing_backup_hash; return 1; }
    base=$(dirname "$ROLLBACK_RECEIPT")
    current_path=$(resolve_reference "$current_ref" "$base")
    backup_path=$(resolve_reference "$backup_ref" "$base")
    verify_hashed_file "$current_path" "$current_sha" || { ROLLBACK_REASON=current_hash_mismatch; return 1; }
    verify_hashed_file "$backup_path" "$backup_sha" || { ROLLBACK_REASON=backup_hash_mismatch; return 1; }
    deploy_base=$(dirname "$DEPLOY_RECEIPT")
    deploy_current_ref=$(manifest_value current_path "$DEPLOY_RECEIPT") || { ROLLBACK_REASON=deploy_current_path_missing; return 1; }
    deploy_backup_ref=$(manifest_value backup_path "$DEPLOY_RECEIPT") || { ROLLBACK_REASON=deploy_backup_path_missing; return 1; }
    deploy_current_path=$(canonical_hashed_reference "$deploy_current_ref" "$deploy_base" "$(manifest_value current_sha256 "$DEPLOY_RECEIPT")") || { ROLLBACK_REASON=deploy_current_identity_mismatch; return 1; }
    deploy_backup_path=$(canonical_hashed_reference "$deploy_backup_ref" "$deploy_base" "$(manifest_value backup_sha256 "$DEPLOY_RECEIPT")") || { ROLLBACK_REASON=deploy_backup_identity_mismatch; return 1; }
    [ "$current_path" = "$deploy_backup_path" ] && [ "$backup_path" = "$deploy_current_path" ] || { ROLLBACK_REASON=atomic_path_swap_mismatch; return 1; }
    deploy_current_sha=$(manifest_value current_sha256 "$DEPLOY_RECEIPT") || { ROLLBACK_REASON=deploy_current_hash_missing; return 1; }
    deploy_backup_sha=$(manifest_value backup_sha256 "$DEPLOY_RECEIPT") || { ROLLBACK_REASON=deploy_backup_hash_missing; return 1; }
    [ "$current_sha" = "$deploy_backup_sha" ] && [ "$backup_sha" = "$deploy_current_sha" ] || { ROLLBACK_REASON=atomic_hash_swap_mismatch; return 1; }
    ROLLBACK_STATUS=ready
    ROLLBACK_REASON=validated
    return 0
}

check_native_receipt() {
    file=$1
    wanted_os=$2
    wanted_arch=$3
    NATIVE_REASON=not_checked
    receipt_file_ready "$file" simple-bootstrap-native-host-receipt-v1,simple-bootstrap-platform-native-host-receipt-v1 || { NATIVE_REASON=missing_or_invalid_receipt; return 1; }
    expect_field native_host "$file" true || { NATIVE_REASON=not_native; return 1; }
    host_os=$(manifest_value host_os "$file") || { NATIVE_REASON=missing_host_os; return 1; }
    host_arch=$(manifest_value host_arch "$file") || { NATIVE_REASON=missing_host_arch; return 1; }
    case "$wanted_os:$host_os" in
        Linux:Linux|macOS:macOS|macOS:Darwin) ;;
        *) NATIVE_REASON=host_os_mismatch; return 1 ;;
    esac
    case "$wanted_arch:$host_arch" in
        aarch64:aarch64|aarch64:arm64|x86_64:x86_64|x86_64:amd64) ;;
        *) NATIVE_REASON=host_arch_mismatch; return 1 ;;
    esac
    stage3_ref=$(manifest_value stage3_path "$file") || stage3_ref=$(manifest_value stage3_candidate_path "$file") || { NATIVE_REASON=missing_stage3_path; return 1; }
    stage3_sha=$(field_any "$file" stage3_sha256 stage3_candidate_sha256) || { NATIVE_REASON=missing_stage3_hash; return 1; }
    stage4_ref=$(manifest_value stage4_path "$file") || stage4_ref=$(manifest_value stage4_candidate_path "$file") || { NATIVE_REASON=missing_stage4_path; return 1; }
    stage4_sha=$(field_any "$file" stage4_sha256 stage4_candidate_sha256) || { NATIVE_REASON=missing_stage4_hash; return 1; }
    base=$(dirname "$file")
    same_file_reference "$stage3_ref" "$STAGE3_CANDIDATE" "$base" || { NATIVE_REASON=stage3_lineage_mismatch; return 1; }
    same_file_reference "$stage4_ref" "$STAGE4_CANDIDATE" "$base" || { NATIVE_REASON=stage4_lineage_mismatch; return 1; }
    verify_hashed_file "$STAGE3_CANDIDATE" "$stage3_sha" || { NATIVE_REASON=stage3_hash_mismatch; return 1; }
    verify_hashed_file "$STAGE4_CANDIDATE" "$stage4_sha" || { NATIVE_REASON=stage4_hash_mismatch; return 1; }
    NATIVE_REASON=validated
    return 0
}

check_linux() { LINUX_STATUS=blocked; check_native_receipt "$LINUX_AARCH64_RECEIPT" Linux aarch64 && { LINUX_STATUS=ready; LINUX_REASON=validated; return 0; }; LINUX_REASON=$NATIVE_REASON; return 1; }
check_macos() { MACOS_STATUS=blocked; check_native_receipt "$MACOS_RECEIPT" macOS x86_64 && { MACOS_STATUS=ready; MACOS_REASON=validated; return 0; }; MACOS_REASON=$NATIVE_REASON; return 1; }

check_freebsd() {
    FREEBSD_STATUS=blocked
    receipt_file_ready "$FREEBSD_IMAGE_RECEIPT" simple-bootstrap-freebsd-base-image-receipt-v1,freebsd-bootstrap-base-image-v1 || { FREEBSD_REASON=missing_or_invalid_receipt; return 1; }
    image_ref=$(field_any "$FREEBSD_IMAGE_RECEIPT" base_image_path image_path) || { FREEBSD_REASON=missing_image_path; return 1; }
    image_sha=$(field_any "$FREEBSD_IMAGE_RECEIPT" base_image_sha256 image_sha256) || { FREEBSD_REASON=missing_image_hash; return 1; }
    expect_field base_image_status "$FREEBSD_IMAGE_RECEIPT" pass || { FREEBSD_REASON=image_status_not_pass; return 1; }
    base=$(dirname "$FREEBSD_IMAGE_RECEIPT")
    same_file_reference "$image_ref" "$FREEBSD_IMAGE" "$base" || { FREEBSD_REASON=image_path_mismatch; return 1; }
    verify_hashed_file "$FREEBSD_IMAGE" "$image_sha" || { FREEBSD_REASON=image_hash_mismatch; return 1; }
    FREEBSD_STATUS=ready
    FREEBSD_REASON=validated
    return 0
}

check_simpleos() {
    SIMPLEOS_KERNEL_STATUS=blocked
    SIMPLEOS_MANIFEST_STATUS=blocked
    if ! canonical_file "$SIMPLEOS_MANIFEST" >/dev/null 2>&1; then SIMPLEOS_MANIFEST_REASON=missing_or_symlinked_manifest; SIMPLEOS_KERNEL_REASON=manifest_required; return 1; fi
    expect_field schema "$SIMPLEOS_MANIFEST" simpleos-arm64-desktop-engine2d-build-manifest-v2 || { SIMPLEOS_MANIFEST_REASON=invalid_schema; SIMPLEOS_KERNEL_REASON=invalid_manifest; return 1; }
    expect_field artifact_kind "$SIMPLEOS_MANIFEST" simpleos-arm64-desktop-engine2d || { SIMPLEOS_MANIFEST_REASON=invalid_artifact_kind; SIMPLEOS_KERNEL_REASON=invalid_manifest; return 1; }
    expect_field bootstrap_status "$SIMPLEOS_MANIFEST" not-claimed || { SIMPLEOS_MANIFEST_REASON=platform_claimed_or_invalid; SIMPLEOS_KERNEL_REASON=invalid_manifest; return 1; }
    kernel_ref=$(manifest_value kernel_path "$SIMPLEOS_MANIFEST") || { SIMPLEOS_MANIFEST_REASON=missing_kernel_path; SIMPLEOS_KERNEL_REASON=missing_kernel_path; return 1; }
    kernel_sha=$(manifest_value kernel_sha256 "$SIMPLEOS_MANIFEST") || { SIMPLEOS_MANIFEST_REASON=missing_kernel_hash; SIMPLEOS_KERNEL_REASON=missing_kernel_hash; return 1; }
    producer_ref=$(manifest_value producer_script_path "$SIMPLEOS_MANIFEST") || { SIMPLEOS_MANIFEST_REASON=missing_producer_path; SIMPLEOS_KERNEL_REASON=invalid_manifest; return 1; }
    producer_sha=$(manifest_value producer_script_sha256 "$SIMPLEOS_MANIFEST") || { SIMPLEOS_MANIFEST_REASON=missing_producer_hash; SIMPLEOS_KERNEL_REASON=invalid_manifest; return 1; }
    build_log_ref=$(manifest_value build_log_path "$SIMPLEOS_MANIFEST") || { SIMPLEOS_MANIFEST_REASON=missing_build_log; SIMPLEOS_KERNEL_REASON=invalid_manifest; return 1; }
    build_log_sha=$(manifest_value build_log_sha256 "$SIMPLEOS_MANIFEST") || { SIMPLEOS_MANIFEST_REASON=missing_build_log_hash; SIMPLEOS_KERNEL_REASON=invalid_manifest; return 1; }
    compiler_receipt_ref=$(manifest_value compiler_receipt_path "$SIMPLEOS_MANIFEST") || { SIMPLEOS_MANIFEST_REASON=missing_compiler_receipt; SIMPLEOS_KERNEL_REASON=invalid_manifest; return 1; }
    compiler_receipt_sha=$(manifest_value compiler_receipt_sha256 "$SIMPLEOS_MANIFEST") || { SIMPLEOS_MANIFEST_REASON=missing_compiler_receipt_hash; SIMPLEOS_KERNEL_REASON=invalid_manifest; return 1; }
    base=$(dirname "$SIMPLEOS_MANIFEST")
    same_file_reference "$kernel_ref" "$SIMPLEOS_KERNEL" "$base" || { SIMPLEOS_MANIFEST_REASON=kernel_path_mismatch; SIMPLEOS_KERNEL_REASON=kernel_path_mismatch; return 1; }
    verify_hashed_file "$SIMPLEOS_KERNEL" "$kernel_sha" || { SIMPLEOS_MANIFEST_REASON=kernel_hash_mismatch; SIMPLEOS_KERNEL_REASON=kernel_hash_mismatch; return 1; }
    producer_path=$(resolve_reference "$producer_ref" "$base")
    build_log_path=$(resolve_reference "$build_log_ref" "$base")
    compiler_receipt_path=$(resolve_reference "$compiler_receipt_ref" "$base")
    verify_hashed_file "$producer_path" "$producer_sha" || { SIMPLEOS_MANIFEST_REASON=producer_hash_mismatch; SIMPLEOS_KERNEL_REASON=invalid_manifest; return 1; }
    verify_hashed_file "$build_log_path" "$build_log_sha" || { SIMPLEOS_MANIFEST_REASON=build_log_hash_mismatch; SIMPLEOS_KERNEL_REASON=invalid_manifest; return 1; }
    verify_hashed_file "$compiler_receipt_path" "$compiler_receipt_sha" || { SIMPLEOS_MANIFEST_REASON=compiler_receipt_hash_mismatch; SIMPLEOS_KERNEL_REASON=invalid_manifest; return 1; }
    SIMPLEOS_KERNEL_STATUS=ready
    SIMPLEOS_KERNEL_REASON=validated
    SIMPLEOS_MANIFEST_STATUS=ready
    SIMPLEOS_MANIFEST_REASON=validated
    return 0
}

evaluate_readiness() {
    configure_paths
    GATE_COUNT=0
    GATE_TOTAL=0
    GATE_LIST=
    READINESS_REASON=
    check_stage3 || :
    check_stage4 || :
    check_smoke || :
    check_deploy || :
    check_rollback || :
    check_linux || :
    check_macos || :
    check_freebsd || :
    check_simpleos || :
    record_gate stage3_candidate "$STAGE3_STATUS" "$STAGE3_REASON"
    record_gate stage4_candidate "$STAGE4_STATUS" "$STAGE4_REASON"
    record_gate essential_smoke_receipt "$SMOKE_STATUS" "$SMOKE_REASON"
    record_gate deploy_receipt "$DEPLOY_STATUS" "$DEPLOY_REASON"
    record_gate rollback_receipt "$ROLLBACK_STATUS" "$ROLLBACK_REASON"
    record_gate linux_aarch64_native_host "$LINUX_STATUS" "$LINUX_REASON"
    record_gate macos_native_host "$MACOS_STATUS" "$MACOS_REASON"
    record_gate freebsd_base_image "$FREEBSD_STATUS" "$FREEBSD_REASON"
    record_gate simpleos_arm64_kernel "$SIMPLEOS_KERNEL_STATUS" "$SIMPLEOS_KERNEL_REASON"
    record_gate simpleos_arm64_producer_manifest "$SIMPLEOS_MANIFEST_STATUS" "$SIMPLEOS_MANIFEST_REASON"
    if [ "$GATE_COUNT" -eq 0 ]; then
        READINESS_STATUS=ready
        READINESS_REASON=all_required_receipts_valid
        GATE_LIST=none
        release_current_tree_identity
        return 0
    fi
    READINESS_STATUS=blocked
    release_current_tree_identity
    return 1
}

emit_result() {
    printf 'bootstrap_handoff_readiness_status=%s\n' "$READINESS_STATUS"
    printf 'bootstrap_handoff_readiness_reason=%s\n' "$READINESS_REASON"
    printf 'bootstrap_handoff_stage3_candidate_status=%s\n' "$STAGE3_STATUS"
    printf 'bootstrap_handoff_stage4_candidate_status=%s\n' "$STAGE4_STATUS"
    printf 'bootstrap_handoff_essential_smoke_receipt_status=%s\n' "$SMOKE_STATUS"
    printf 'bootstrap_handoff_essential_test_runner_smoke_status=%s\n' "$SMOKE_TEST_RUNNER_STATUS"
    printf 'bootstrap_handoff_essential_lint_smoke_status=%s\n' "$SMOKE_LINT_STATUS"
    printf 'bootstrap_handoff_essential_duplicate_checker_smoke_status=%s\n' "$SMOKE_DUPLICATE_STATUS"
    printf 'bootstrap_handoff_essential_aggregate_smoke_status=%s\n' "$SMOKE_AGGREGATE_STATUS"
    printf 'bootstrap_handoff_deploy_receipt_status=%s\n' "$DEPLOY_STATUS"
    printf 'bootstrap_handoff_rollback_receipt_status=%s\n' "$ROLLBACK_STATUS"
    printf 'bootstrap_handoff_linux_aarch64_native_host_status=%s\n' "$LINUX_STATUS"
    printf 'bootstrap_handoff_macos_native_host_status=%s\n' "$MACOS_STATUS"
    printf 'bootstrap_handoff_freebsd_base_image_status=%s\n' "$FREEBSD_STATUS"
    printf 'bootstrap_handoff_simpleos_arm64_kernel_status=%s\n' "$SIMPLEOS_KERNEL_STATUS"
    printf 'bootstrap_handoff_simpleos_arm64_producer_manifest_status=%s\n' "$SIMPLEOS_MANIFEST_STATUS"
    printf 'bootstrap_handoff_remaining_gate_count=%s\n' "$GATE_COUNT"
    printf 'bootstrap_handoff_remaining_gate_list=%s\n' "$GATE_LIST"
    printf 'platform_acceptance_claimed=false\n'
    emit_verdict "$GATE_TOTAL" "$GATE_COUNT" "$GATE_LIST"
}

# Verdict convention (.claude/rules/vcs.md).  Every handoff gate is evaluated
# from committed receipts on this host, so there is no "unavailable" axis: a
# gate is either ready or not.  Zero gates evaluated means the check ran
# vacuously -> ERROR.
emit_verdict() {
    ev_total="$1"; ev_blocked="$2"; ev_list="$3"
    if [ "$ev_total" -eq 0 ]; then
        echo "ERROR — nothing was checked (0 handoff gates evaluated)"
        return 2
    fi
    if [ "$ev_blocked" -gt 0 ]; then
        echo "FAIL — $ev_total handoff gate(s) checked, $ev_blocked not ready: $ev_list"
        return 1
    fi
    echo "PASS — $ev_total handoff gate(s) checked, all ready"
    return 0
}

verdict_self_test() {
    vt_fail=0
    vt_case() { # name total blocked list expect_exit expect_substr
        vt_out="$(emit_verdict "$2" "$3" "$4")"; vt_ec=$?
        if [ "$vt_ec" -ne "$5" ]; then
            echo "verdict selftest FAIL $1: exit $vt_ec expected $5 ($vt_out)" >&2
            vt_fail=$((vt_fail + 1)); return 0
        fi
        case "$vt_out" in
            *"$6"*) ;;
            *) echo "verdict selftest FAIL $1: '$vt_out' lacks '$6'" >&2; vt_fail=$((vt_fail + 1)) ;;
        esac
    }
    vt_case must-pass 10 0 none 0 "PASS — 10 handoff gate(s) checked, all ready"
    vt_case must-fail 10 2 "stage3_candidate,stage4_candidate" 1 "FAIL — 10 handoff gate(s) checked, 2 not ready: stage3_candidate,stage4_candidate"
    vt_case must-error-empty 0 0 none 2 "ERROR — nothing was checked (0 handoff gates evaluated)"
    if [ "$vt_fail" -gt 0 ]; then
        echo "bootstrap_handoff_verdict_selftest status=FAIL cases_failed=$vt_fail" >&2
        return 1
    fi
    echo "bootstrap_handoff_verdict_selftest status=PASS cases=3"
    return 0
}

self_test_file() { printf '%b\n' "$2" >"$1"; }

self_test_replace_field() {
    file=$1
    key=$2
    value=$3
    tmp="$file.replace.$$"
    awk -F '=' -v wanted="$key" -v replacement="$value" '
        $1 == wanted { $0=wanted "=" replacement; found++ }
        { print }
        END { if (found != 1) exit 1 }
    ' "$file" >"$tmp" || return 1
    mv "$tmp" "$file"
}

