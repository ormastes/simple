#!/bin/sh
set -u

usage() {
  echo "Usage: scripts/check/bootstrap-diagnostic-sweep.shs --compiler=<simple> [--root=<path>] [--cache-dir=<dir>] [--jobs=<n>] [--timeout=<seconds>]"
  echo "Checks independent .spl files, aggregates failures, and never builds or deploys an artifact."
}

compiler=""
roots=""
cache_root="build/bootstrap/diagnostic-cache"
jobs=1
timeout_seconds=600
timeout_grace_seconds=5

for arg in "$@"; do
  case "$arg" in
    --compiler=*) compiler=${arg#*=} ;;
    --root=*) roots="${roots}${roots:+
}${arg#*=}" ;;
    --cache-dir=*) cache_root=${arg#*=} ;;
    --jobs=*) jobs=${arg#*=} ;;
    --timeout=*) timeout_seconds=${arg#*=} ;;
    --timeout-grace=*) timeout_grace_seconds=${arg#*=} ;;
    --help|-h) usage; exit 0 ;;
    *) echo "error: unknown diagnostic-sweep option '$arg'" >&2; usage >&2; exit 2 ;;
  esac
done

case "$jobs" in
  ''|*[!0-9]*|0) echo "error: --jobs must be a positive integer" >&2; exit 2 ;;
esac
case "$timeout_seconds" in
  ''|*[!0-9]*|0) echo "error: --timeout must be a positive integer" >&2; exit 2 ;;
esac
case "$timeout_grace_seconds" in
  ''|*[!0-9]*|0) echo "error: --timeout-grace must be a positive integer" >&2; exit 2 ;;
esac
[ -n "$compiler" ] || { echo "error: --compiler is required" >&2; exit 2; }
[ -x "$compiler" ] || { echo "error: compiler is not executable: $compiler" >&2; exit 2; }
command -v perl >/dev/null 2>&1 || { echo "error: perl is required for isolated diagnostic process groups" >&2; exit 2; }
[ -n "$roots" ] || roots="src/compiler"

# The bootstrap seed's `check` command delegates frontend work to the admitted
# pure-Simple CLI at this canonical repo-relative path. Fail before dispatching
# thousands of workers when an isolated worktree omitted that ignored artifact.
[ -x bin/simple ] || {
  echo "error: diagnostic child compiler is not executable: bin/simple" >&2
  echo "Provide an admitted pure-Simple bin/simple before diagnostic sweep." >&2
  exit 2
}

mkdir -p "$cache_root" || exit 2
run_dir=$(mktemp -d "${TMPDIR:-/tmp}/simple-bootstrap-diagnostic.XXXXXX") || exit 2
active_workers=""
cleanup_sweep() {
  cleanup_status=$?
  [ "$#" -eq 0 ] || cleanup_status=$1
  trap - EXIT INT TERM HUP
  for cleanup_worker in $active_workers; do
    cleanup_worker_pid=${cleanup_worker%%:*}
    kill -TERM "$cleanup_worker_pid" 2>/dev/null || true
  done
  for cleanup_pgid_file in "$run_dir"/*.pgid; do
    [ -f "$cleanup_pgid_file" ] || continue
    IFS= read -r cleanup_pgid < "$cleanup_pgid_file" || cleanup_pgid=""
    case "$cleanup_pgid" in ''|*[!0-9]*) continue ;; esac
    kill -TERM "-$cleanup_pgid" 2>/dev/null || true
  done
  /bin/sleep 0.1
  for cleanup_pgid_file in "$run_dir"/*.pgid; do
    [ -f "$cleanup_pgid_file" ] || continue
    IFS= read -r cleanup_pgid < "$cleanup_pgid_file" || cleanup_pgid=""
    case "$cleanup_pgid" in ''|*[!0-9]*) continue ;; esac
    kill -KILL "-$cleanup_pgid" 2>/dev/null || true
  done
  rm -rf "$run_dir"
  exit "$cleanup_status"
}
trap cleanup_sweep EXIT
trap 'cleanup_sweep 130' INT
trap 'cleanup_sweep 143' TERM
trap 'cleanup_sweep 129' HUP
files_list="$run_dir/files"
: > "$files_list"

old_ifs=$IFS
IFS='
'
for root in $roots; do
  [ -e "$root" ] || { echo "error: diagnostic root does not exist: $root" >&2; exit 2; }
  if [ -d "$root" ]; then
    find "$root" -type f -name '*.spl' -print
  else
    case "$root" in *.spl) echo "$root" ;; *) echo "error: diagnostic input is not .spl: $root" >&2; exit 2 ;; esac
  fi
done | LC_ALL=C sort -u > "$files_list"
IFS=$old_ifs

[ -s "$files_list" ] || { echo "error: diagnostic sweep selected no .spl files" >&2; exit 2; }

run_one() {
  item_id=$1
  source_path=$2
  cache_checksum=$(printf '%s\n' "$source_path" | cksum)
  cache_key=${cache_checksum%% *}
  item_cache="$cache_root/$cache_key"
  mkdir -p "$item_cache"
  timeout_marker="$run_dir/$item_id.timeout"
  # Each compiler owns a new process group. Parser/semantic globals therefore
  # remain process-isolated, and a timed-out compiler cannot leave a delegated
  # bin/simple descendant holding output or consuming a worker slot.
  perl -MPOSIX=setsid -e \
    'defined(POSIX::setsid()) or die "setsid failed\n"; exec @ARGV or die "exec failed: $!\n"' \
    env SIMPLE_NATIVE_BUILD_CACHE_DIR="$item_cache" \
    "$compiler" check "$source_path" >"$run_dir/$item_id.log" 2>&1 &
  compiler_pid=$!
  printf '%s\n' "$compiler_pid" > "$run_dir/$item_id.pgid.tmp"
  mv "$run_dir/$item_id.pgid.tmp" "$run_dir/$item_id.pgid"
  (
    /bin/sleep "$timeout_seconds"
    if kill -0 "$compiler_pid" 2>/dev/null; then
      : > "$timeout_marker.tmp"
      mv "$timeout_marker.tmp" "$timeout_marker"
      kill -TERM "-$compiler_pid" 2>/dev/null || true
      /bin/sleep "$timeout_grace_seconds"
      kill -KILL "-$compiler_pid" 2>/dev/null || true
    fi
  ) &
  watchdog_pid=$!

  command_status=0
  wait "$compiler_pid" || command_status=$?
  if [ -f "$timeout_marker" ]; then
    wait "$watchdog_pid" 2>/dev/null || true
  else
    kill "$watchdog_pid" 2>/dev/null || true
    wait "$watchdog_pid" 2>/dev/null || true
  fi
  # A compiler may exit while a delegated descendant still owns the group's
  # stdout/stderr. Always reap that group before publishing completion.
  if kill -TERM "-$compiler_pid" 2>/dev/null; then
    /bin/sleep "$timeout_grace_seconds"
    kill -KILL "-$compiler_pid" 2>/dev/null || true
  fi
  : > "$run_dir/$item_id.pgid"

  if [ -f "$timeout_marker" ]; then
    printf 'error: diagnostic timeout after %ss: %s\n' \
      "$timeout_seconds" "$source_path" >> "$run_dir/$item_id.log"
    result_status=124
  elif [ "$command_status" -eq 0 ]; then
    result_status=0
  else
    result_status=1
  fi
  printf '%s\n' "$result_status" > "$run_dir/$item_id.status.tmp"
  mv "$run_dir/$item_id.status.tmp" "$run_dir/$item_id.status"
}

item_id=0
active_count=0
reap_completed() {
  remaining_workers=""
  reaped_any=0
  for worker in $active_workers; do
    worker_pid=${worker%%:*}
    worker_id=${worker#*:}
    if [ -f "$run_dir/$worker_id.status" ]; then
      wait "$worker_pid" 2>/dev/null || true
      active_count=$((active_count - 1))
      reaped_any=1
    else
      remaining_workers="$remaining_workers $worker"
    fi
  done
  active_workers=$remaining_workers
}

while IFS= read -r source_path; do
  while [ "$active_count" -ge "$jobs" ]; do
    reap_completed
    [ "$reaped_any" -eq 1 ] || /bin/sleep 0.02
  done
  item_id=$((item_id + 1))
  printf '%s\t%s\n' "$item_id" "$source_path" >> "$run_dir/index"
  run_one "$item_id" "$source_path" &
  active_workers="$active_workers $!:$item_id"
  active_count=$((active_count + 1))
done < "$files_list"
while [ "$active_count" -gt 0 ]; do
  reap_completed
  [ "$reaped_any" -eq 1 ] || /bin/sleep 0.02
done

passed=0
failed=0
timed_out=0
while IFS="	" read -r result_id source_path; do
  IFS= read -r status < "$run_dir/$result_id.status"
  if [ "$status" -eq 0 ]; then
    passed=$((passed + 1))
  else
    failed=$((failed + 1))
    if [ "$status" -eq 124 ]; then
      timed_out=$((timed_out + 1))
      echo "=== diagnostic timeout: $source_path ==="
    else
      echo "=== diagnostic failure: $source_path ==="
    fi
    cat "$run_dir/$result_id.log"
  fi
done < "$run_dir/index"

echo "bootstrap diagnostic summary: checked=$((passed + failed)) passed=$passed failed=$failed timed_out=$timed_out"
if [ "$failed" -ne 0 ]; then
  exit 1
fi
exit 0
