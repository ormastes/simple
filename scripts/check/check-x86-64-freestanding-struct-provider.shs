#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
elf=${1:-}
[ -n "$elf" ] && [ -f "$elf" ] || { echo "usage: $0 KERNEL.ELF" >&2; exit 2; }
provider="$root/examples/09_embedded/simple_os/arch/x86_64/boot/freestanding_value_registry.c"
impl="$root/examples/09_embedded/simple_os/arch/common/boot/freestanding_value_registry_impl.h"
grep -qF '#include "../../common/boot/freestanding_value_registry_impl.h"' "$provider"
grep -q '^void \*rt_struct_alloc(int64_t size)' "$impl"
nm "$elf" | grep -Eq '^[0-9a-fA-F]+ T rt_struct_alloc$'
! nm "$elf" | grep -Eq ' [Ww] rt_struct_alloc$'
echo 'PASS x86_64 kernel uses the canonical strong freestanding rt_struct_alloc provider'
