#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/simpleos-percpu-atomic.XXXXXX")
trap 'rm -f "$work/percpu-atomic-test"; rmdir "$work"' EXIT HUP INT TERM

cc -std=c11 -Wall -Wextra -Werror -pthread \
    -DSIMPLEOS_PERCPU_ATOMIC_SELF_TEST \
    "$ROOT_DIR/src/os/kernel/smp/percpu_atomic_owner.c" \
    -o "$work/percpu-atomic-test"
"$work/percpu-atomic-test"

grep -q '__atomic_fetch_or' "$ROOT_DIR/src/os/kernel/smp/percpu_atomic_owner.c"
grep -q 'rt_simpleos_percpu_online_count()' "$ROOT_DIR/src/os/kernel/smp/percpu.spl"
grep -q 'src/os/kernel/smp/percpu_atomic_owner.c' \
    "$ROOT_DIR/examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c"
printf '%s\n' 'simpleos_percpu_atomic_owner_status=pass'
