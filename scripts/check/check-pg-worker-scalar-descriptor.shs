#!/bin/sh
# Focused source gate for the PostgreSQL-mimic worker descriptor ABI.
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
OUT_DIR=${1:-/mnt/data/simple-pg-worker-descriptor-check}
mkdir -p "$OUT_DIR"

CC_NAME=${CC:-cc}
"$CC_NAME" -std=gnu11 -O1 -ffunction-sections -fdata-sections \
    "$ROOT_DIR/src/runtime/test/rt_pg_worker_scalar_descriptor_selfcheck.c" \
    "$ROOT_DIR/src/runtime/runtime_db.c" \
    "$ROOT_DIR/src/runtime/runtime_native.c" \
    -Wl,--gc-sections -pthread -ldl -lm \
    -o "$OUT_DIR/rt_pg_worker_scalar_descriptor_selfcheck"
"$OUT_DIR/rt_pg_worker_scalar_descriptor_selfcheck" \
    >"$OUT_DIR/rt_pg_worker_scalar_descriptor_selfcheck.out"
grep -q '^PASS pg_worker_scalar_descriptor_concurrent_selfcheck$' \
    "$OUT_DIR/rt_pg_worker_scalar_descriptor_selfcheck.out"
printf '%s\n' 'pg_worker_scalar_descriptor_gate=pass'
