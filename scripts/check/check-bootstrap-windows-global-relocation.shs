#!/bin/sh
# Compile and execute real initialized/imported module globals through PE/COFF.
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT_DIR"
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) ;;
    *) echo 'bootstrap-windows-global-relocation requires a Windows host' >&2; exit 2 ;;
esac

SIMPLE_BINARY=${SIMPLE_BINARY:-bin/simple}
WORK_DIR=${WORK_DIR:-build/native_probe/bootstrap_windows_global_relocation}
mkdir -p "$WORK_DIR"
SIMPLE_NO_STUB_FALLBACK=1 "$SIMPLE_BINARY" native-build \
    --target x86_64-pc-windows-gnu --backend cranelift \
    --source test/fixtures/bootstrap_windows_global_relocation \
    --entry-closure --threads 1 --cache-dir "$WORK_DIR/cache" --mode dynload \
    --entry test/fixtures/bootstrap_windows_global_relocation/main.spl \
    -o "$WORK_DIR/probe.exe" >"$WORK_DIR/build.log" 2>&1
"$WORK_DIR/probe.exe" >"$WORK_DIR/run.log" 2>&1
grep -Fx 'bootstrap-global-relocation: pass' "$WORK_DIR/run.log" >/dev/null
echo 'bootstrap-windows-global-relocation: pass'
