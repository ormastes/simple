#!/bin/sh
set -eu
if [ "$(uname -s)" != Darwin ]; then
    echo 'SKIP: Darwin UID zombie barrier requires macOS'; exit 77
fi
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/sosix-darwin-uid-zombie.XXXXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
"${CC:-cc}" -std=c11 -O0 -Wall -Wextra -Werror -Wno-unused-function \
    "$root/src/runtime/test/rt_sosix_darwin_uid_zombie_selfcheck.c" -o "$scratch/probe"
"$scratch/probe"
