#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

MIN_DISK_GIB="${MIN_DISK_GIB:-250}"
MIN_MEM_GIB="${MIN_MEM_GIB:-32}"
MAX_CPU_FRACTION="${MAX_CPU_FRACTION:-2}"
MAX_ACTIVE_NATIVE_BUILDS="${MAX_ACTIVE_NATIVE_BUILDS:-0}"
NATIVE_BUILD_PROC_ROOT="${NATIVE_BUILD_PROC_ROOT:-/proc}"

pass() {
    printf 'PASS %s\n' "$1"
}

fail() {
    printf 'FAIL %s\n' "$1"
}

info() {
    printf 'INFO %s\n' "$1"
}

# A probe that could not read its input must never be laundered into a
# plausible number: `x=$(cmd | filter || echo 0)` binds `||` to the PIPELINE, so
# the filter's success hides the probe's failure and $x is EMPTY, not 0. Empty
# then becomes 0 in $(( )) -- which is how "swap_used_gib=0" passed
# "swap_not_overcommitted" on a host whose /proc/meminfo could not be read.
# Every probe below therefore goes through this: non-numeric => hard FAIL.
require_num() {
    # $1 = metric name, $2 = probed value
    case "${2:-}" in
        ''|*[!0-9]*)
            fail "probe_${1}_unreadable"
            exit_code=1
            printf 'INFO probe %s returned a non-numeric value (%s); refusing to assume a passing default\n' "$1" "${2:-<empty>}"
            return 1
            ;;
    esac
    return 0
}

blocked() {
    printf 'BLOCKED %s\n' "$1"
}

exit_code=0

# --- --selftest: reproduce the fail-open this file used to carry ------------
# Pre-fix, an unreadable /proc/meminfo made both swap probes EMPTY, and
# $(( "" - "" )) is 0, so "swap_not_overcommitted" PASSED having measured
# nothing. The fixtures below drive require_num with exactly the values those
# broken probes produced, and assert it now refuses them.
if [ "${1:-}" = "--selftest" ]; then
    nfix=0; failed=''
    fixture() { # name, value, want_rc
        nfix=$((nfix + 1))
        exit_code=0
        got=0
        require_num "$1" "$2" >/dev/null 2>&1 || got=$?
        [ "$got" -eq "$3" ] || failed="$failed
  fixture '$1' value='$2': rc=$got want=$3"
        if [ "$3" -eq 1 ] && [ "$exit_code" -ne 1 ]; then
            failed="$failed
  fixture '$1': rejected the value but did not set exit_code=1"
        fi
    }
    fixture empty_probe_swap_total '' 1
    fixture empty_probe_swap_free '' 1
    fixture non_numeric_probe 'N/A' 1
    fixture partially_numeric_probe '12k' 1
    fixture healthy_probe '4194304' 0
    fixture healthy_zero_probe '0' 0
    if [ -n "$failed" ]; then
        printf 'selftest: %d fixture(s) run, FAILURES:%s\n' "$nfix" "$failed"
        echo "ERROR — nothing was checked"
        exit 2
    fi
    echo "selftest: $nfix fixture(s) passed"
    exit 0
fi

# --- 1. Disk space ---
disk_avail_kb=$(df --output=avail / 2>/dev/null | tail -1 | tr -d ' ')
if ! require_num disk_avail_kb "$disk_avail_kb"; then
    disk_avail_gib=-1
else
    disk_avail_gib=$((disk_avail_kb / 1048576))
fi
info "disk_available_gib=$disk_avail_gib"
if [ "$disk_avail_gib" -ge "$MIN_DISK_GIB" ]; then
    pass "disk_space_min_${MIN_DISK_GIB}gib"
else
    fail "disk_space_min_${MIN_DISK_GIB}gib"
    exit_code=1
fi

# --- 2. Available memory ---
mem_avail_kb=$(grep MemAvailable /proc/meminfo 2>/dev/null | awk '{print $2}')
if ! require_num mem_avail_kb "$mem_avail_kb"; then
    mem_avail_gib=-1
else
    mem_avail_gib=$((mem_avail_kb / 1048576))
fi
info "memory_available_gib=$mem_avail_gib"
if [ "$mem_avail_gib" -ge "$MIN_MEM_GIB" ]; then
    pass "memory_min_${MIN_MEM_GIB}gib"
else
    fail "memory_min_${MIN_MEM_GIB}gib"
    exit_code=1
fi

# --- 3. Swap not over-committed ---
swap_total_kb=$(grep SwapTotal /proc/meminfo 2>/dev/null | awk '{print $2}')
swap_free_kb=$(grep SwapFree /proc/meminfo 2>/dev/null | awk '{print $2}')
# THE fail-open this file carried: both probes empty => $(( "" - "" )) is 0 =>
# swap_used_gib=0 => "swap_not_overcommitted" PASSED without reading any swap.
if ! require_num swap_total_kb "$swap_total_kb" || ! require_num swap_free_kb "$swap_free_kb"; then
    swap_used_gib=999
else
    swap_used_gib=$(((swap_total_kb - swap_free_kb) / 1048576))
fi
info "swap_used_gib=$swap_used_gib"
if [ "$swap_used_gib" -le 2 ]; then
    pass "swap_not_overcommitted"
else
    fail "swap_not_overcommitted"
    exit_code=1
fi

# --- 4. CPU headroom ---
cpu_count=$(nproc 2>/dev/null)
load_1m=$(awk '{printf "%d", $1}' /proc/loadavg 2>/dev/null)
if ! require_num cpu_count "$cpu_count" || ! require_num load_1m "$load_1m"; then
    cpu_half=-1
    load_1m=0
else
    cpu_half=$((cpu_count / MAX_CPU_FRACTION))
fi
info "cpu_count=${cpu_count:-<unreadable>} load_1m=$load_1m cpu_half=$cpu_half"
if [ "$load_1m" -le "$cpu_half" ]; then
    pass "cpu_load_below_half"
else
    fail "cpu_load_below_half"
    exit_code=1
fi

# --- 5. No overlapping native builds ---
native_build_count=0
native_build_scan_ok=1
if [ ! -d "$NATIVE_BUILD_PROC_ROOT" ] || [ ! -r "$NATIVE_BUILD_PROC_ROOT" ] || [ ! -x "$NATIVE_BUILD_PROC_ROOT" ]; then
    native_build_scan_ok=0
else
    for cmdline in "$NATIVE_BUILD_PROC_ROOT"/[0-9]*/cmdline; do
        [ -e "$cmdline" ] || continue
        if [ ! -r "$cmdline" ]; then
            native_build_scan_ok=0
            continue
        fi
        if second_arg=$(awk 'BEGIN { RS="\0" } NR == 2 { print; exit }' "$cmdline" 2>/dev/null); then
            if [ "$second_arg" = "native-build" ]; then
                native_build_count=$((native_build_count + 1))
            fi
        elif [ -e "$cmdline" ]; then
            native_build_scan_ok=0
        fi
    done
fi
info "native_build_running=$native_build_count"
if [ "$native_build_scan_ok" -ne 1 ]; then
    fail "native_build_process_scan"
    exit_code=1
elif [ "$native_build_count" -le "$MAX_ACTIVE_NATIVE_BUILDS" ]; then
    pass "native_build_at_most_${MAX_ACTIVE_NATIVE_BUILDS}"
else
    fail "native_build_at_most_${MAX_ACTIVE_NATIVE_BUILDS}"
    exit_code=1
fi

# --- 6. No active QEMU guests ---
qemu_count="$(pgrep -c qemu-system 2>/dev/null || true)"
qemu_count="${qemu_count:-0}"
info "qemu_running=$qemu_count"
if [ "$qemu_count" -le 1 ]; then
    pass "qemu_at_most_one"
else
    fail "qemu_at_most_one"
    exit_code=1
fi

# --- 7. Kernel log: no recent hard lockup / OOM / NVMe errors ---
kernel_danger=0
if dmesg_out=$(dmesg --time-format iso 2>/dev/null | tail -200); then
    for pattern in "hard LOCKUP" "blocked for more than" "Out of memory" "nvme.*I/O error" "usb.*disconnect"; do
        if echo "$dmesg_out" | grep -qi "$pattern" 2>/dev/null; then
            blocked "kernel_log_contains: $pattern"
            kernel_danger=1
        fi
    done
    if [ "$kernel_danger" -eq 0 ]; then
        pass "kernel_log_clean"
    else
        exit_code=1
    fi
else
    info "kernel_log_unavailable (dmesg requires privileges)"
fi

# --- 8. Git working tree clean ---
if git -C "$ROOT_DIR" diff --quiet HEAD 2>/dev/null; then
    pass "git_working_tree_clean"
else
    dirty_count=$(git -C "$ROOT_DIR" diff --name-only HEAD 2>/dev/null | wc -l)
    info "git_dirty_files=$dirty_count"
    blocked "git_working_tree_clean"
fi

# --- 9. No stale lock files ---
if [ -f "$ROOT_DIR/.git/index.lock" ]; then
    fail "no_stale_git_index_lock"
    exit_code=1
else
    pass "no_stale_git_index_lock"
fi

# --- Summary ---
if [ "$exit_code" -eq 0 ]; then
    info "preflight=READY"
else
    info "preflight=BLOCKED"
fi

exit "$exit_code"
