#!/bin/sh
# Chrome vs Simple web-renderer PIXEL diff over the shared catalog.
#
# The three existing "chrome-simple comparison" scripts in this directory are
# env/JSON bundle validators — none of them compares a pixel. This one does:
# it drives Chrome headless (--headless=new --screenshot) and the pure-Simple
# web lane (examples/06_io/ui/web_render_page_ppm.spl) over the same HTML, then
# diffs the two frames with the pure-Simple differ
# src/app/ui/chrome_showcase/pixel_diff.spl.
#
# Output, one line per page:
#   page=<name> chrome_ms=<n> simple_ms=<n> mismatch_pct=<p> max_delta=<d>
# then exactly one verdict line, always last on stdout:
#   PASS — <n> page(s) compared, worst=<pct>
#   FAIL — ...
#   ERROR — nothing was checked (<reason>)
#
# Non-vacuity is absolute: 0 pages compared is ERROR, never a pass, and a host
# with no Chrome is ERROR naming the path it looked for.
#
# Usage:
#   sh scripts/check/check-chrome-catalog-pixel-diff.shs [--out DIR] [--pages "a b"]
#   sh scripts/check/check-chrome-catalog-pixel-diff.shs --selftest
#   sh scripts/check/check-chrome-catalog-pixel-diff.shs --diff-only --out DIR
#   sh scripts/check/check-chrome-catalog-pixel-diff.shs --simple-only --out DIR
#
# --simple-only re-renders the Simple side and reuses the *.chrome.{bmp,png}
# already in DIR. That is the mode for a host with no Chrome, and the mode to
# use when only the renderer changed. --diff-only skips BOTH sides.

set -u

repo_root=$(cd "$(dirname "$0")/../.." && pwd)
cd "$repo_root" || { echo "ERROR — nothing was checked (repo root unreachable)"; exit 2; }

PAGES="overview html css-layout css-paint forms-media animation evidence tab-bar"
OUT="build/perf/chrome_catalog_pixel_diff"
CATALOG="examples/06_io/ui/web_catalog"
WIDTH=900
HEIGHT=760
SELFTEST=0
DIFF_ONLY=0
SIMPLE_ONLY=0
CHROME_TIMEOUT=90

while [ $# -gt 0 ]; do
    case "$1" in
        --out) OUT="$2"; shift 2 ;;
        --pages) PAGES="$2"; shift 2 ;;
        --width) WIDTH="$2"; shift 2 ;;
        --height) HEIGHT="$2"; shift 2 ;;
        --selftest) SELFTEST=1; shift ;;
        --diff-only) DIFF_ONLY=1; shift ;;
        --simple-only) SIMPLE_ONLY=1; shift ;;
        --chrome-timeout) CHROME_TIMEOUT="$2"; shift 2 ;;
        *) echo "ERROR — nothing was checked (unknown argument $1)"; exit 2 ;;
    esac
done

# ---------------------------------------------------------------------------
# Binaries
# ---------------------------------------------------------------------------
find_simple() {
    # SIMPLE_BIN wins when set: a git worktree does not carry the main
    # checkout's build/ directory, so the caller must be able to name one.
    if [ -n "${SIMPLE_BIN:-}" ] && [ -x "${SIMPLE_BIN}" ]; then
        echo "$SIMPLE_BIN"
        return 0
    fi
    for candidate in \
        "$repo_root/build/cargo-r2/release/simple" \
        "$repo_root/bin/simple" \
        "$repo_root/src/compiler_rust/target/bootstrap/simple"
    do
        [ -x "$candidate" ] && { echo "$candidate"; return 0; }
    done
    return 1
}

find_chrome() {
    for candidate in \
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
        "/Applications/Chromium.app/Contents/MacOS/Chromium" \
        "/usr/bin/google-chrome" \
        "/usr/bin/chromium" \
        "/usr/bin/chromium-browser"
    do
        [ -x "$candidate" ] && { echo "$candidate"; return 0; }
    done
    return 1
}

now_ms() {
    # `date +%s%N` is GNU-only; python is not allowed as product code here and
    # perl is present on every host this runs on.
    perl -MTime::HiRes=time -e 'printf("%d\n", time()*1000)' 2>/dev/null || echo 0
}

SIMPLE_BIN=$(find_simple) || {
    echo "ERROR — nothing was checked (no runnable simple binary under build/cargo-r2, bin/ or src/compiler_rust/target/bootstrap)"
    exit 2
}


# ---------------------------------------------------------------------------
# Zero-pixel classification (2026-09-12).
#
# A Simple page that renders NOTHING used to reach the verdict only as
# "unreadable", which reads like a missing or corrupt capture and names no
# page. It is a different and far worse condition: the PPM is perfectly
# readable and every pixel is the background -- the whole page's Draw IR was
# dropped, which is exactly what one em dash did in
# doc/08_tracking/bug/web_drawir_advances_staged_per_byte_kills_render_2026-09-12.md.
# Keyed on the IMAGE, never on a log line, so it cannot be fooled by a producer
# that stops printing its receipt.
ppm_header_bytes() {
    head -c 128 "$1" | awk 'BEGIN { RS = "\n" } { n += length($0) + 1; if (NR == 3) { print n; exit } }'
}

# Prints the number of pixels that differ from the image's FIRST pixel.
ppm_non_background_pixels() {
    _ppm=$1
    [ -f "$_ppm" ] || { echo "-1"; return 0; }
    _hdr=$(ppm_header_bytes "$_ppm")
    case "$_hdr" in ''|*[!0-9]*) echo "-1"; return 0 ;; esac
    od -An -v -tu1 -j "$_hdr" "$_ppm" | awk '
        {
            for (i = 1; i <= NF; i++) {
                c[n % 3] = $i; n++
                if (n % 3 == 0) {
                    if (!init) { r0 = c[0]; g0 = c[1]; b0 = c[2]; init = 1 }
                    else if (c[0] != r0 || c[1] != g0 || c[2] != b0) { d++ }
                }
            }
        }
        END { print d + 0 }'
}

# ---------------------------------------------------------------------------
# Selftest: a synthetic identical pair must report 0.00, a deliberately
# different pair must report a non-zero mismatch. Fatal, runs before any scan.
# ---------------------------------------------------------------------------
run_selftest() {
    st_dir="$OUT/.selftest"
    rm -rf "$st_dir"
    mkdir -p "$st_dir" || return 1
    # 4x1 P6 PPM, two identical frames and one that differs in every pixel.
    printf 'P6\n4 1\n255\n' > "$st_dir/same.simple.ppm"
    printf '\377\0\0\377\0\0\377\0\0\377\0\0' >> "$st_dir/same.simple.ppm"
    cp "$st_dir/same.simple.ppm" "$st_dir/same.chrome.ppm"
    printf 'P6\n4 1\n255\n' > "$st_dir/diff.simple.ppm"
    printf '\0\0\377\0\0\377\0\0\377\0\0\377' >> "$st_dir/diff.simple.ppm"
    cp "$st_dir/same.simple.ppm" "$st_dir/diff.chrome.ppm"

    same_out=$("$SIMPLE_BIN" run src/app/ui/chrome_showcase/pixel_diff.spl \
        --pair "$st_dir/same.chrome.ppm" "$st_dir/same.simple.ppm" 2>/dev/null)
    same_rc=$?
    diff_out=$("$SIMPLE_BIN" run src/app/ui/chrome_showcase/pixel_diff.spl \
        --pair "$st_dir/diff.chrome.ppm" "$st_dir/diff.simple.ppm" 2>/dev/null)
    diff_rc=$?
    [ "$same_rc" -eq 0 ] || { echo "selftest: identical pair run failed (rc=$same_rc)"; return 1; }
    [ "$diff_rc" -eq 0 ] || { echo "selftest: differing pair run failed (rc=$diff_rc)"; return 1; }
    echo "$same_out" | grep -q 'mismatch_pct=0\.00' || { echo "selftest: identical pair did not report 0.00"; return 1; }
    echo "$diff_out" | grep -q 'mismatch_pct=100\.00' || { echo "selftest: differing pair did not report 100.00"; return 1; }
    # A missing input must be an error, never a silent pass.
    miss_out=$("$SIMPLE_BIN" run src/app/ui/chrome_showcase/pixel_diff.spl \
        --pair "$st_dir/does-not-exist.ppm" "$st_dir/same.simple.ppm" 2>/dev/null)
    echo "$miss_out" | grep -q 'ERROR — nothing was checked' || { echo "selftest: missing input was not an ERROR"; return 1; }
    # An all-background image must classify as zero-pixel-render; an image with
    # any ink must not. Without this pair the classifier could answer "0" for
    # everything and the gate would look strict while checking nothing.
    printf 'P6\n4 1\n255\n' > "$st_dir/blank.ppm"
    printf '\377\377\377\377\377\377\377\377\377\377\377\377' >> "$st_dir/blank.ppm"
    blank_n=$(ppm_non_background_pixels "$st_dir/blank.ppm")
    [ "$blank_n" = "0" ] || { echo "selftest: all-background image reported $blank_n non-background pixels"; return 1; }
    printf 'P6\n4 1\n255\n' > "$st_dir/ink.ppm"
    printf '\377\377\377\377\377\377\0\0\0\377\377\377' >> "$st_dir/ink.ppm"
    ink_n=$(ppm_non_background_pixels "$st_dir/ink.ppm")
    [ "$ink_n" = "0" ] && { echo "selftest: an inked image classified as zero-pixel-render"; return 1; }
    return 0
}

if ! run_selftest; then
    echo "ERROR — nothing was checked (selftest failed)"
    exit 2
fi
if [ "$SELFTEST" -eq 1 ]; then
    echo "PASS — 5 selftest fixture(s) checked, differ discriminates and zero-pixel-render is named"
    exit 0
fi

mkdir -p "$OUT" || { echo "ERROR — nothing was checked (cannot create $OUT)"; exit 2; }

# ---------------------------------------------------------------------------
# Capture
# ---------------------------------------------------------------------------
if [ "$DIFF_ONLY" -eq 0 ] && [ "$SIMPLE_ONLY" -eq 0 ]; then
    CHROME_BIN=$(find_chrome) || {
        echo "ERROR — nothing was checked (no Chrome at /Applications/Google Chrome.app/Contents/MacOS/Google Chrome, /usr/bin/google-chrome or /usr/bin/chromium)"
        exit 2
    }
fi

captured=0
for page in $PAGES; do
    html="$CATALOG/$page.html"
    if [ ! -f "$html" ]; then
        echo "page=$page status=error reason=missing-fixture"
        continue
    fi
    chrome_ms=0
    simple_ms=0
    if [ "$DIFF_ONLY" -eq 0 ] && [ "$SIMPLE_ONLY" -eq 0 ]; then
        profile="$OUT/.chrome-profile-$page"
        rm -rf "$profile"
        t0=$(now_ms)
        perl -e 'alarm shift; exec @ARGV' "$CHROME_TIMEOUT" \
            "$CHROME_BIN" --headless=new --disable-gpu --hide-scrollbars \
            --no-first-run --no-default-browser-check --disable-extensions \
            --force-device-scale-factor=1 --virtual-time-budget=3000 \
            --user-data-dir="$profile" \
            --window-size="$WIDTH,$HEIGHT" \
            --screenshot="$OUT/$page.chrome.png" "file://$repo_root/$html" >/dev/null 2>&1
        chrome_rc=$?
        if [ ! -s "$OUT/$page.chrome.png" ]; then
            echo "page=$page status=error reason=chrome-timeout-or-no-screenshot rc=$chrome_rc"
        fi
        t1=$(now_ms)
        chrome_ms=$((t1 - t0))
        rm -rf "$profile"
        # The pure-Simple PNG decoder rejects some Chrome streams; convert to
        # BMP with whatever the host provides. Absence is reported, not hidden.
        if [ -f "$OUT/$page.chrome.png" ]; then
            if command -v sips >/dev/null 2>&1; then
                sips -s format bmp "$OUT/$page.chrome.png" --out "$OUT/$page.chrome.bmp" >/dev/null 2>&1
            elif command -v magick >/dev/null 2>&1; then
                magick "$OUT/$page.chrome.png" "$OUT/$page.chrome.bmp" >/dev/null 2>&1
            fi
        fi
        t2=$(now_ms)
        SIMPLE_EXECUTION_MODE=interpreter SIMPLE_TIMEOUT_SECONDS=0 SIMPLE_2D_BACKEND=cpu_simd \
            "$SIMPLE_BIN" run examples/06_io/ui/web_render_page_ppm.spl \
            "$html" "$OUT/$page.simple.ppm" "$WIDTH" "$HEIGHT" > "$OUT/$page.simple.log" 2>&1
        t3=$(now_ms)
        simple_ms=$((t3 - t2))
    fi
    if [ "$SIMPLE_ONLY" -eq 1 ]; then
        if command -v sips >/dev/null 2>&1 && [ -f "$OUT/$page.chrome.png" ] && [ ! -f "$OUT/$page.chrome.bmp" ]; then
            sips -s format bmp "$OUT/$page.chrome.png" --out "$OUT/$page.chrome.bmp" >/dev/null 2>&1
        fi
        t2=$(now_ms)
        SIMPLE_EXECUTION_MODE=interpreter SIMPLE_TIMEOUT_SECONDS=0 SIMPLE_2D_BACKEND=cpu_simd \
            "$SIMPLE_BIN" run examples/06_io/ui/web_render_page_ppm.spl \
            "$html" "$OUT/$page.simple.ppm" "$WIDTH" "$HEIGHT" > "$OUT/$page.simple.log" 2>&1
        t3=$(now_ms)
        simple_ms=$((t3 - t2))
    fi
    echo "$page $chrome_ms $simple_ms" >> "$OUT/.timings"
    captured=$((captured + 1))
done

if [ "$captured" -eq 0 ]; then
    echo "ERROR — nothing was checked (0 pages captured)"
    exit 2
fi

# ---------------------------------------------------------------------------
# Diff
# ---------------------------------------------------------------------------
diff_out=$("$SIMPLE_BIN" run src/app/ui/chrome_showcase/pixel_diff.spl "$OUT" $PAGES 2>/dev/null)
diff_rc=$?
if [ "$diff_rc" -ne 0 ]; then
    echo "ERROR — nothing was checked (differ exited $diff_rc)"
    exit 2
fi

compared=0
for page in $PAGES; do
    line=$(echo "$diff_out" | grep "^page=$page ")
    [ -n "$line" ] || continue
    pct=$(echo "$line" | sed -n 's/.*mismatch_pct=\([0-9.]*\).*/\1/p')
    maxd=$(echo "$line" | sed -n 's/.*max_delta=\([0-9]*\).*/\1/p')
    times=$(grep "^$page " "$OUT/.timings" 2>/dev/null | tail -1)
    cms=$(echo "$times" | awk '{print $2}')
    sms=$(echo "$times" | awk '{print $3}')
    echo "page=$page chrome_ms=${cms:-0} simple_ms=${sms:-0} mismatch_pct=${pct:-n/a} max_delta=${maxd:-n/a}"
    [ -n "$pct" ] && compared=$((compared + 1))
done

verdict=$(echo "$diff_out" | tail -1)
if [ "$compared" -eq 0 ]; then
    echo "ERROR — nothing was checked (0 pages compared)"
    exit 2
fi

# A readable capture with no ink is a rendering failure, not an unreadable one,
# and the verdict must NAME the page.
zero_pages=""
zero_count=0
for page in $PAGES; do
    [ -f "$OUT/$page.simple.ppm" ] || continue
    ink=$(ppm_non_background_pixels "$OUT/$page.simple.ppm")
    if [ "$ink" = "0" ]; then
        zero_pages="$zero_pages $page"
        zero_count=$((zero_count + 1))
    fi
done
if [ "$zero_count" -gt 0 ]; then
    echo "FAIL — $compared page(s) compared, $zero_count zero-pixel-render:$zero_pages"
    exit 1
fi

echo "$verdict"
case "$verdict" in
    PASS*) exit 0 ;;
    FAIL*) exit 1 ;;
    *) exit 2 ;;
esac
