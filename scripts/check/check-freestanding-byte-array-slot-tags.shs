#!/bin/sh
# check-freestanding-byte-array-slot-tags.shs
#
# Reproduce guard for
# doc/08_tracking/bug/riscv64_erased_receiver_routes_class_method_to_rt_find_2026-08-31.md
# (defect 2 — the `.bytes()` payload truncation on the riscv64 mcp component row)
#
# WHAT IT PINS. Every freestanding/baremetal C definition of a `[u8]`-PRODUCING
# entry point (`rt_string_bytes`, `rt_text_to_bytes`, `rt_bytes_from_raw`) must store TAGGED
# slots (`ENCODE_INT` / `rt_int` / `<< 3`),
# never raw bytes.
#
# WHY. These runtimes use TAG_INT == 0, so a RAW byte whose value is a multiple
# of 8 is bit-for-bit indistinguishable from an ENCODE_INT-tagged int, and every
# reader on this lane untags with the `IS_INT(v) ? DECODE_INT(v) : v` rule that
# simpleos_raw_or_encoded_int spells out. A raw slot is therefore silently
# divided by 8 for exactly the bytes 0, 8, 16, ... 248 and left alone for the
# other 224 — a defect that hides behind any payload that happens to avoid them.
#
# Measured in-guest 2026-09-01 under real OpenSBI fw_payload, with
# baremetal_runtime_core.inc.c's ported rt_string_bytes storing RAW bytes:
# `"MCP_RTT_PAYLOAD".bytes()` read back element 0 = 77 and element 14 = 68
# correctly but element 2 (byte 80 = 'P') as 10, and `_bytes_text` rebuilt
# "MC\n_RTT_\nAYLOAD" — RIGHT LENGTH, WRONG BYTES. Both 'P's (80) are the only
# multiples of 8 in that payload. That is the whole of the mcp row's
# "[mcp] FAIL registered dispatch lost the payload".
#
# Why a SOURCE check and not an in-guest boot: the in-guest evidence is real and
# is recorded in the bug doc, but it needs a riscv64 cross toolchain, OpenSBI and
# QEMU and takes minutes. This runs in under a second on every push and catches
# the same defect at its source.
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> definition(s) checked, 0 untagged     exit 0
#   FAIL  — ...                                       exit 1
#   ERROR — nothing was checked                       exit 2
# A run that examined 0 definitions is ERROR, never a pass.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

ENTRY_RE='rt_string_bytes|rt_text_to_bytes|rt_bytes_from_raw'

# Classify every byte-array-producing definition in one C source. Prints one
# line per definition: "TAGGED <name>" or "UNTAGGED <name>". Weak link-fallback
# stubs are ignored -- they are not the real definition.
# Strip C comments FIRST. Without this the guard is worthless: the incident's
# own body carried the comment "deliberately NOT ENCODE_INT", and the FIXED body
# carries a long comment that also names ENCODE_INT -- so a text match over raw
# source calls BOTH of them tagged. Verified: with comments left in, this guard
# reported PASS on the exact pre-fix content it exists to catch.
strip_comments() {
    awk '''
        { line = $0; out = ""
          while (length(line) > 0) {
              if (inblock) {
                  i = index(line, "*/")
                  if (i == 0) { line = ""; break }
                  line = substr(line, i + 2); inblock = 0; continue
              }
              b = index(line, "/*"); l = index(line, "//")
              if (l > 0 && (b == 0 || l < b)) { out = out substr(line, 1, l - 1); line = ""; break }
              if (b > 0) { out = out substr(line, 1, b - 1); line = substr(line, b + 2); inblock = 1; continue }
              out = out line; line = ""
          }
          print out
        }
    ''' "$1"
}

classify_file() {
    strip_comments "$1" | awk -v re="$ENTRY_RE" '
        /__attribute__\(\(weak\)\)/ { next }
        !found && $0 ~ ("^[A-Za-z_][A-Za-z0-9_ *]*[ *](" re ")[ ]*\\(") && !/;[ ]*$/ {
            match($0, "(" re ")"); name = substr($0, RSTART, RLENGTH)
            found = 1; depth = 0; body = ""
        }
        found {
            body = body " " $0
            n = gsub(/\{/, "{"); depth += n
            m = gsub(/\}/, "}"); depth -= m
            if (depth <= 0 && body ~ /\{/) {
                # Classify the STORE EXPRESSIONS, not the whole body.
                # Two earlier revisions of this guard failed here:
                #  * matching ENCODE_INT anywhere in the body passes the real
                #    incident, because its first line is
                #    `rt_array_new(ENCODE_INT(s->len))` -- an encoded LENGTH
                #    argument that says nothing about the slots;
                #  * a one-line delegation stores nothing at all and must not
                #    be classified (the x86_64 rt_extras.c false FAIL).
                # So: look only at statements that push/assign a value read out
                # of a byte buffer, and ask whether THAT value is encoded.
                nstore = 0; nbad = 0
                nl = split(body, L, ";")
                for (k = 1; k <= nl; k++) {
                    st = L[k]
                    if (st !~ /push|\][ ]*=/) continue
                    if (st !~ /\(uint8_t\)|\(unsigned char\)|\(spl_u8\)|data\[/) continue
                    nstore++
                    if (st !~ /ENCODE_INT|rt_int\(|<<[ ]*3/) nbad++
                }
                if (nstore > 0) {
                    if (nbad > 0) print "UNTAGGED " name
                    else print "TAGGED " name
                }
                found = 0
            }
        }
    '
}

scan_root() {
    _root=$1
    _checked=0
    _bad=""
    # Freestanding/baremetal runtime C sources only. The HOSTED runtime
    # (src/runtime/runtime_native.c) deliberately stores raw bytes -- its
    # `[u8]` element read masks with & 0xFF WITHOUT untagging -- and is covered
    # by its own selfchecks. Copying the hosted convention into a freestanding
    # TU is precisely the defect this guard exists to catch.
    for f in $(find "$_root/examples/09_embedded/simple_os" "$_root/src/os" \
                    \( -name '*.c' -o -name '*.inc.c' \) 2>/dev/null | sort); do
        [ -f "$f" ] || continue
        grep -Eq "$ENTRY_RE" "$f" 2>/dev/null || continue
        classify_file "$f" > "$TMPCLS" || true
        while read -r verdict name; do
            [ -n "${verdict:-}" ] || continue
            _checked=$((_checked + 1))
            [ "$verdict" = "UNTAGGED" ] && _bad="$_bad ${f#$_root/}:$name"
        done < "$TMPCLS"
    done
    EV_CHECKED=$_checked
    EV_BAD=$_bad
}

TMPCLS=$(mktemp)
trap 'rm -f "$TMPCLS"' EXIT

selftest() {
    d=$(mktemp -d)
    mkdir -p "$d/examples/09_embedded/simple_os" "$d/src/os"

    # F1: tagged via ENCODE_INT -> TAGGED
    cat >"$d/examples/09_embedded/simple_os/good_encode.c" <<'EOF'
RuntimeValue rt_string_bytes(RuntimeValue str)
{
    for (uint64_t i = 0; i < s->len; i++) {
        arr = rt_array_push_handle(arr, ENCODE_INT((int64_t)(uint8_t)s->data[i]));
    }
    return arr;
}
EOF
    # F2: tagged via rt_int() -> TAGGED
    cat >"$d/examples/09_embedded/simple_os/good_rtint.c" <<'EOF'
spl_i64 rt_text_to_bytes(spl_i64 text_value) {
    for (spl_u64 i = 0; i < string->len; i = i + 1) {
        rt_array_push(out, rt_int((spl_i64)(unsigned char)string->data[i]));
    }
    return out;
}
EOF
    # F3: THE INCIDENT — raw byte slots -> UNTAGGED
    cat >"$d/src/os/bad_raw.c" <<'EOF'
RuntimeValue rt_string_bytes(RuntimeValue str)
{
    for (uint64_t i = 0; i < s->len; i++) {
        arr = rt_array_push_handle(arr, (RuntimeValue)(uint8_t)s->data[i]);
    }
    return arr;
}
EOF
    # F4: weak link-fallback stub must be IGNORED, not counted
    cat >"$d/src/os/weak_stub.c" <<'EOF'
__attribute__((weak)) RuntimeValue rt_string_bytes(RuntimeValue a) { return NIL_VALUE; }
EOF
    # F5: a prototype must not be mistaken for a definition
    cat >"$d/src/os/proto_only.c" <<'EOF'
int64_t rt_string_bytes(int64_t string);
EOF
    # F5c: THE COMMENT-MASKING TRAP. A raw-slot body whose COMMENT names
    # ENCODE_INT must still be UNTAGGED. This is the incident's own text
    # ("deliberately NOT ENCODE_INT") and the first revision of this guard
    # reported PASS on it.
    cat >"$d/src/os/bad_raw_commented.c" <<'EOF'
RuntimeValue rt_text_to_bytes(RuntimeValue str)
{
    /* RAW byte, deliberately NOT ENCODE_INT, and not value << 3 either. */
    for (uint64_t i = 0; i < s->len; i++) {
        arr = rt_array_push_handle(arr, (RuntimeValue)(uint8_t)s->data[i]);
    }
    return arr;
}
EOF
    # F5d: THE LENGTH-ARGUMENT TRAP. A raw-slot body that encodes its LENGTH
    # argument (`rt_array_new(ENCODE_INT(s->len))`) must still be UNTAGGED.
    # This is the real incident's shape and a whole-body ENCODE_INT match
    # reported PASS on it.
    cat >"$d/src/os/bad_raw_encoded_len.c" <<'EOF'
RuntimeValue rt_bytes_from_raw(RuntimeValue str)
{
    RuntimeValue arr = rt_array_new(ENCODE_INT(s ? (int64_t)s->len : 0));
    for (uint64_t i = 0; i < s->len; i++) {
        arr = rt_array_push_handle(arr, (RuntimeValue)(uint8_t)s->data[i]);
    }
    return arr;
}
EOF
    # F5b: a pure delegation stores no slot and must NOT be classified.
    # This is the real x86_64 rt_extras.c shape that the first revision of this
    # guard reported as a FAIL.
    cat >"$d/src/os/delegate.c" <<'EOF'
RuntimeValue rt_text_to_bytes(RuntimeValue size) { return rt_bytes_alloc_packed(size); }
EOF

    _f=0
    got=$(classify_file "$d/examples/09_embedded/simple_os/good_encode.c")
    [ "$got" = "TAGGED rt_string_bytes" ] || { echo "selftest F1 FAILED: got '$got'" >&2; _f=1; }
    got=$(classify_file "$d/examples/09_embedded/simple_os/good_rtint.c")
    [ "$got" = "TAGGED rt_text_to_bytes" ] || { echo "selftest F2 FAILED: got '$got'" >&2; _f=1; }
    got=$(classify_file "$d/src/os/bad_raw.c")
    [ "$got" = "UNTAGGED rt_string_bytes" ] || { echo "selftest F3 FAILED: got '$got'" >&2; _f=1; }
    got=$(classify_file "$d/src/os/weak_stub.c")
    [ -z "$got" ] || { echo "selftest F4 FAILED: weak stub not ignored, got '$got'" >&2; _f=1; }
    got=$(classify_file "$d/src/os/proto_only.c")
    [ -z "$got" ] || { echo "selftest F5 FAILED: prototype counted, got '$got'" >&2; _f=1; }
    got=$(classify_file "$d/src/os/delegate.c")
    [ -z "$got" ] || { echo "selftest F5b FAILED: delegation counted, got '$got'" >&2; _f=1; }
    got=$(classify_file "$d/src/os/bad_raw_commented.c")
    [ "$got" = "UNTAGGED rt_text_to_bytes" ] || { echo "selftest F5c FAILED: comment masked raw slots, got '$got'" >&2; _f=1; }
    got=$(classify_file "$d/src/os/bad_raw_encoded_len.c")
    [ "$got" = "UNTAGGED rt_bytes_from_raw" ] || { echo "selftest F5d FAILED: encoded length argument masked raw slots, got '$got'" >&2; _f=1; }

    # F6: the incident tree as a whole must FAIL the scan
    scan_root "$d"
    [ "$EV_CHECKED" -eq 5 ] || { echo "selftest F6 FAILED: expected 5 definitions, got $EV_CHECKED" >&2; _f=1; }
    case "$EV_BAD" in *bad_raw.c:rt_string_bytes*) : ;; *) echo "selftest F6 FAILED: incident not flagged" >&2; _f=1 ;; esac

    # F7: an empty tree must check 0 so the caller is forced to ERROR
    e=$(mktemp -d); mkdir -p "$e/examples/09_embedded/simple_os" "$e/src/os"
    scan_root "$e"; rm -rf "$e"
    [ "$EV_CHECKED" -eq 0 ] || { echo "selftest F7 FAILED: empty tree checked $EV_CHECKED" >&2; _f=1; }

    rm -rf "$d"
    [ "$_f" -eq 0 ] || return 1
    return 0
}

case "${1-}" in
    --selftest) selftest && { echo "selftest: 10 fixture(s) OK"; exit 0; }
                echo "ERROR — nothing was checked (selftest failed)"; exit 2 ;;
esac

# selftest runs before every scan and is fatal.
selftest >/dev/null 2>&1 || { echo "ERROR — nothing was checked (selftest failed)"; exit 2; }

scan_root "$ROOT"

if [ "$EV_CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked (no freestanding byte-array producer found)"
    exit 2
fi
if [ -n "$EV_BAD" ]; then
    echo "FAIL — $EV_CHECKED definition(s) checked, untagged byte slots in:$EV_BAD"
    exit 1
fi
echo "PASS — $EV_CHECKED definition(s) checked, 0 untagged"
exit 0
