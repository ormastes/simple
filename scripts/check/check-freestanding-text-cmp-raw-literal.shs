#!/bin/sh
# check-freestanding-text-cmp-raw-literal.shs
#
# Fences the ORDERING sibling of the 2026-08-11 defect fenced by
# check-freestanding-text-eq-raw-literal.shs: on the freestanding/baremetal
# lanes, text ORDERING (`<`/`>`/`<=`/`>=`/sort) against a RAW string literal
# reflected pointer/word identity instead of content, because those lanes'
# rt_text_cmp_any (x86_64, aarch64) / rt_native_cmp's inline string-ordering
# arm (arm64) content-compares only when BOTH operands decode to a heap
# string. A `.trim()`/`.substring()` result is always a heap string; a bare
# literal is a raw untagged char* global. So `x < "foo"` / sort comparators
# involving a literal reflected malloc address, not alphabetical order.
#
# Bug: doc/08_tracking/bug/freestanding_text_ordering_raw_literal_2026-08-11.md
#
# Two fail-closed checks:
#   1. The selfcheck binary builds and passes. It first REPRODUCES the defect
#      with the old predicate (exits 2 "vacuous" if it cannot), then asserts the
#      fixed predicate, including negative controls that non-equal ordering
#      still compares correctly and that small non-pointer words are never
#      dereferenced.
#   2. Every known freestanding text-ordering implementation carries the
#      raw-literal arm. This catches a lane being added, or the fix being
#      dropped from one, without anyone noticing.
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> check(s) ...            exit 0
#   FAIL  — ...                         exit 1
#   ERROR — nothing was checked         exit 2

set -u

ROOT=$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd)
if [ -z "$ROOT" ] || [ ! -d "$ROOT/src/runtime" ]; then
    echo "ERROR — nothing was checked (not in a repo clone: no src/runtime under '$ROOT')"
    exit 2
fi
cd "$ROOT" || { echo "ERROR — nothing was checked (cannot cd to repo root)"; exit 2; }

SELFCHECK="src/runtime/test/rt_text_cmp_any_heap_vs_raw_selfcheck.c"

# Every freestanding rt_text_cmp_any / rt_native_cmp string-ordering
# implementation, and the token that proves it has the fix.
# Format: <path>|<required-token>
LANES="
examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c|rt_text_cmp_heap_vs_raw
examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c|rt_text_cmp_heap_vs_raw
examples/09_embedded/simple_os/arch/aarch64/boot/freestanding_runtime.c|rt_text_cmp_str_vs_raw
"

checks=0
fails=0
missing=""

# ---- check 1: selfcheck builds and passes -----------------------------------
if [ ! -f "$SELFCHECK" ]; then
    echo "ERROR — nothing was checked (missing selfcheck source $SELFCHECK)"
    exit 2
fi

CC=${CC:-cc}
BIN=$(mktemp -t rt_textcmp_selfcheck.XXXXXX) || {
    echo "ERROR — nothing was checked (cannot create temp file)"; exit 2; }
trap 'rm -f "$BIN"' EXIT INT TERM HUP

if ! "$CC" -O1 -Wall -o "$BIN" "$SELFCHECK" 2>&1; then
    echo "selfcheck: BUILD FAILED"
    echo "FAIL — selfcheck did not compile"
    exit 1
fi

sc_out=$("$BIN" 2>&1)
sc_rc=$?
echo "$sc_out" | sed 's/^/  /'
checks=$((checks + 1))
if [ "$sc_rc" -eq 2 ]; then
    echo "ERROR — nothing was checked (selfcheck vacuous: defect did not reproduce)"
    exit 2
fi
if [ "$sc_rc" -ne 0 ]; then
    fails=$((fails + 1))
fi

# ---- check 2: every freestanding lane carries the fix -----------------------
for entry in $LANES; do
    [ -n "$entry" ] || continue
    path=${entry%%|*}
    token=${entry##*|}
    checks=$((checks + 1))
    if [ ! -f "$path" ]; then
        echo "  lane MISSING FILE: $path"
        fails=$((fails + 1)); missing="$missing $path"
        continue
    fi
    if grep -q "$token" "$path" 2>/dev/null; then
        echo "  lane ok: $path"
    else
        echo "  lane UNFIXED (no '$token'): $path"
        fails=$((fails + 1)); missing="$missing $path"
    fi
done

# ---- check 3: no NEW freestanding rt_text_cmp_any/rt_native_cmp escaped -----
KNOWN_F=$(mktemp -t rt_textcmp_known.XXXXXX) || KNOWN_F=""
FOUND_F=$(mktemp -t rt_textcmp_found.XXXXXX) || FOUND_F=""
if [ -n "$KNOWN_F" ] && [ -n "$FOUND_F" ]; then
    trap 'rm -f "$BIN" "$KNOWN_F" "$FOUND_F"' EXIT INT TERM HUP
    printf '%s\n' $LANES | sed 's/|.*//' | sort > "$KNOWN_F"
    grep -rl --include=baremetal_stubs.c --include=freestanding_runtime.c \
        -E '^[A-Za-z_][A-Za-z0-9_ ]* (rt_text_cmp_any|rt_native_cmp)\(' \
        examples/09_embedded src 2>/dev/null | sort > "$FOUND_F"
    unlisted=$(comm -13 "$KNOWN_F" "$FOUND_F" 2>/dev/null)
    checks=$((checks + 1))
    if [ -n "$unlisted" ]; then
        for u in $unlisted; do
            echo "  UNLISTED freestanding rt_text_cmp_any/rt_native_cmp (add to this guard): $u"
            fails=$((fails + 1))
        done
    else
        echo "  no unlisted freestanding rt_text_cmp_any/rt_native_cmp definitions"
    fi
fi

if [ "$checks" -eq 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi
if [ "$fails" -ne 0 ]; then
    echo "FAIL — $fails of $checks check(s) failed;${missing:- see above}"
    exit 1
fi
echo "PASS — $checks check(s) passed, freestanding text-vs-raw-literal ordering fenced"
exit 0
