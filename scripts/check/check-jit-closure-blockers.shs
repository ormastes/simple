#!/bin/sh
# check-jit-closure-blockers — flag closure forms that force the whole module
# off the JIT and onto the tree-walk interpreter (~10-1000x).
#
# WHY: the Rust seed JIT refuses ANY module containing a `MirInst::ClosureCreate`
# (src/compiler_rust/compiler/src/codegen/jit.rs:196), which is emitted for every
# `HirExprKind::Lambda`. Refusal is per-MODULE and ignores reachability, so a
# lambda in a never-called diagnostics helper interprets the entire co-compiled
# render lane. That is exactly what happened in diag.spl.
#
# Two forms are flagged, because a lambda-shaped grep misses the second:
#   1. lambda literals            \x: ...   /   \a, b: ...
#   2. `_` placeholder closures   xs.map(f(_))
#
# NOT DETECTABLE HERE, stated plainly: a NAMED FUNCTION passed as a value emits
# no ClosureCreate, passes the JIT guard, and then SILENTLY MISCOMPILES to an
# address-shaped garbage value (defect 2 in the bug doc). It is
# indistinguishable from an ordinary call at the grep level. Do not read a PASS
# from this script as "this file is JIT-safe" — only as "no lambda/placeholder".
#
# See doc/08_tracking/bug/jit_closure_abi_refuses_lambdas_and_miscompiles_fn_refs_2026-08-06.md
#
# Usage:
#   sh scripts/check/check-jit-closure-blockers.shs [path ...]
# Default paths are the hot render/UI lanes. Exit 0 = clean, 1 = blockers
# found, 2 = nothing was checked (fail closed).

set -e

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"

FIXTURES=test/fixtures/repro/compiler/jit_closure

# String literals and comments are stripped BEFORE matching. Without that the
# scan is badly contaminated: a `\n` inside a string matches the lambda
# pattern, and `case Ok(_)` matches the placeholder pattern.
AWK_SCAN='
{
  line = $0
  # Escaped quotes FIRST, else `"\""` leaves an unpaired quote and the string
  # stripper below runs past the real end of the literal — which made `\"width:`
  # inside an HTML string look exactly like the lambda `\ident:`.
  gsub(/\\"/, "", line)
  gsub(/"[^"]*"/, "QQ", line)
  sub(/#.*/, "", line)
  if (line ~ /\\[a-zA-Z_][a-zA-Z0-9_]*([ ]*,[ ]*[a-zA-Z_][a-zA-Z0-9_]*)*[ ]*:/)
      printf "%s:%d: lambda\n", FILENAME, FNR
  else if (line !~ /=>/ && line !~ /^[ ]*case/ &&
           line ~ /[a-zA-Z_][a-zA-Z0-9_]*\([^()]*[a-zA-Z_][a-zA-Z0-9_]*\(_\)/)
      printf "%s:%d: placeholder\n", FILENAME, FNR
}'

scan() { awk "$AWK_SCAN" "$@" 2>/dev/null; }

# --- selftest: FATAL, runs before every scan -------------------------------
# A detector that cannot see its own known-bad fixtures is worse than none.
selftest() {
    [ -d "$FIXTURES" ] || { echo "check-jit-closure-blockers: ERROR — nothing was checked (missing fixtures $FIXTURES)"; exit 2; }
    fails=0
    # Must FLAG these.
    for f in f02_lambda_stored_local f03_lambda_noncapturing_arg f04_lambda_capturing \
             f05_lambda_in_dead_function f07_underscore_placeholder f08_lambda_returned; do
        [ -f "$FIXTURES/$f.spl" ] || { echo "selftest: missing fixture $f"; fails=$((fails+1)); continue; }
        if [ -z "$(scan "$FIXTURES/$f.spl")" ]; then
            echo "selftest: FAILED to flag $f"; fails=$((fails+1))
        fi
    done
    # Must NOT flag these. f09 pins the two false-positive classes that this
    # checker actually shipped with once: enum match wildcards `Variant(_)`,
    # and escaped quotes `"\""` that broke string-stripping.
    for f in f01_baseline_no_lambda f09_match_wildcards_not_closures; do
        [ -f "$FIXTURES/$f.spl" ] || { echo "selftest: missing fixture $f"; fails=$((fails+1)); continue; }
        if [ -n "$(scan "$FIXTURES/$f.spl")" ]; then
            echo "selftest: FALSE POSITIVE on $f"; fails=$((fails+1))
        fi
    done
    if [ "$fails" -ne 0 ]; then
        echo "check-jit-closure-blockers: ERROR — nothing was checked (selftest failed: $fails)"
        exit 2
    fi
}

selftest

# --- scan ------------------------------------------------------------------
if [ "$#" -gt 0 ]; then
    PATHS="$*"
else
    PATHS="src/lib/common/ui src/lib/nogc_sync_mut/ui src/lib/gc_async_mut/gpu src/os/compositor"
fi

LIST=$(mktemp)
trap 'rm -f "$LIST"' EXIT
for p in $PATHS; do
    [ -e "$p" ] && find "$p" -name '*.spl' >> "$LIST" 2>/dev/null || true
done

FILE_COUNT=$(wc -l < "$LIST" | tr -d ' ')
if [ "$FILE_COUNT" -eq 0 ]; then
    echo "check-jit-closure-blockers: ERROR — nothing was checked (no .spl files under: $PATHS)"
    exit 2
fi

HITS=$(scan $(cat "$LIST") || true)
HIT_COUNT=$(printf '%s' "$HITS" | grep -c ':' || true)
[ -z "$HITS" ] && HIT_COUNT=0

if [ "$HIT_COUNT" -ne 0 ]; then
    printf '%s\n' "$HITS"
    echo "check-jit-closure-blockers: FAIL — $HIT_COUNT closure blocker(s) in $FILE_COUNT file(s); each forces its whole module to the interpreter"
    exit 1
fi
echo "check-jit-closure-blockers: PASS — $FILE_COUNT file(s) scanned, 0 closure blockers (does NOT cover named-fn-ref miscompiles)"
