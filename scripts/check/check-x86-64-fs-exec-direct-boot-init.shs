#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
entry="$root/examples/09_embedded/simple_os/arch/x86_64/fs_exec_entry.spl"
grep -qF 'use os.kernel.arch.x86_64.arch_init.{arch_x86_64_direct_boot_init}' "$entry"
grep -qF '    arch_x86_64_direct_boot_init()' "$entry"
! grep -qF 'arch_x86_64_early_init' "$entry"
! grep -qF 'parse_hhdm' "$entry"
echo 'PASS x86_64 fs-exec uses direct Multiboot init and rejects Limine init sabotage'
