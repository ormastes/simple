#!/bin/sh
# check-no-jit-module-drop.shs — fail-closed fence against paren-less accessors
# on builtin containers, a silent ~100-1000x whole-module de-JIT defect class.
#
# WHY THIS EXISTS
# ---------------
# A paren-less accessor on a builtin container — `.length`, `.len`, `.size`,
# `.empty`, `.chars`, `.first`, `.last`, `.capacity` — parses as a FIELD ACCESS.
# There is no HIR lowering for it, so `hir/lower/expr/access.rs` raises
#
#     cannot infer field type while lowering <fn>: struct 'Array' field 'length'
#
# (also `'String'`, `'Dict'`). In the `compile` / AOT lane that is a hard error.
# In the `run` / JIT lane it is INVISIBLE: the driver drops the WHOLE ENCLOSING
# MODULE to the tree-walk interpreter and the value still prints correctly.
# Measured on the seed on 2026-08-08:
#
#     bin/simple run  <f>   ->  rc=0, prints "3"      (silently interpreted)
#     bin/simple compile <f>->  rc=1, names the field (hard error)
#
# `.length` is the worst member because it is the only one the interpreter
# accepts AND evaluates correctly; `.size` and `.empty` also die at runtime
# ("undefined field ... on Array") so they self-report. That asymmetry is why
# `.length` alone accumulated hundreds of sites.
#
# WHY `compile` AND NOT `run` IS THE ORACLE
# -----------------------------------------
# Three independent reasons, all measured, none of them obvious:
#   1. `run` does not report the defect at all for `.length`/`.first`/`.chars` —
#      it succeeds. Only `compile` surfaces it. A run-based fence is VACUOUS.
#   2. `SIMPLE_JIT_STRICT=1` does NOT harden this path. Strict only tags errors
#      routed through `jit_strict_fallback_error` (HIR/MIR `LowerError`) and
#      unresolved externs. The accessor family is caught earlier, at the
#      semantic gate, whose message is never tagged — so `run_file_with_args`'s
#      `jit_err.contains("SIMPLE_JIT_STRICT:")` test is false and it falls back
#      anyway. Verified: `SIMPLE_JIT_STRICT=1 bin/simple run t4.spl` still
#      printed "[INFO] JIT compilation failed, falling back to interpreter".
#      See doc/08_tracking/bug/paren_less_accessor_whole_module_de_jit_2026-08-08.md
#   3. `compile` does not EXECUTE the file. A run-based tree scan would execute
#      arbitrary library and app modules for their side effects, and most
#      declaration-only modules refuse to run at all ("no `main` function and no
#      top-level statements"), so they could never be covered.
#
# EXIT CODES (matching the repo's pre-push guard convention)
#   0  PASS  — every selected file was compiled and none dropped. The verdict
#              line states how many were actually examined.
#   1  FAIL  — at least one file has a paren-less accessor drop. Each is NAMED.
#   2  ERROR — nothing was checked, or the fence could not prove it can fire.
#              This is NOT a pass.
#
# This repo has a documented history of guards that fail OPEN: printing
# "nothing to push" and exiting 0 from a worktree they could not read. Every
# indeterminate outcome here is exit 2, and a passing run always states a
# non-zero count of things it examined. `--selftest` runs BEFORE every scan and
# is fatal: if the fixture that MUST be detected is not detected, or the fixture
# that MUST be clean is not clean, the fence refuses to report on anything.
#
# Usage:
#   sh scripts/check/check-no-jit-module-drop.shs                 # default roots
#   sh scripts/check/check-no-jit-module-drop.shs src/lib src/app # explicit roots
#   sh scripts/check/check-no-jit-module-drop.shs --file a.spl b.spl
#   sh scripts/check/check-no-jit-module-drop.shs --selftest      # fixtures only
#   sh scripts/check/check-no-jit-module-drop.shs --list          # roster only
#
# Env:
#   JIT_DROP_BIN        compiler to drive (default bin/simple)
#   JIT_DROP_LOG_DIR    log directory (default build/check/jit-module-drop)
#   JIT_DROP_TIMEOUT    per-file compile timeout in seconds (default 120)
#   JIT_DROP_MAX_FILES  stop after N files (for a bounded sample; the verdict
#                       RECORDS the cap so a sampled run can never read as full)
#
# NOT wired into any pre-commit/pre-push hook on purpose: a per-file compile
# over the whole tree costs minutes, and ~10 sessions share this checkout.
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
cd "$REPO_ROOT" || { echo "ERROR — nothing was checked (cannot cd to repo root)"; exit 2; }

BIN="${JIT_DROP_BIN:-bin/simple}"
LOG_DIR="${JIT_DROP_LOG_DIR:-build/check/jit-module-drop}"
TIMEOUT="${JIT_DROP_TIMEOUT:-120}"
MAX_FILES="${JIT_DROP_MAX_FILES:-0}"

# The signature the compiler emits for this defect class. Anchored on the
# distinctive phrase, not on a whole-line match, so a change in the surrounding
# "semantic: <path>: HIR lowering: Unsupported feature:" wrapper cannot silently
# stop this fence from matching.
DROP_RE='cannot infer field type while lowering'

# The accessor family. Used only to CLASSIFY a hit for the report — never to
# decide whether something is a hit. Scope is not statically decidable (genuine
# `length` struct fields exist, e.g. SvimPiece.length), which is exactly why the
# compiler's own diagnostic is the oracle and grep is not.
ACCESSORS='length len size empty chars first last capacity'

[ -x "$BIN" ] || { echo "ERROR — nothing was checked (compiler '$BIN' is not executable)"; exit 2; }
mkdir -p "$LOG_DIR" || { echo "ERROR — nothing was checked (cannot create $LOG_DIR)"; exit 2; }

WORK="$LOG_DIR/work"
rm -rf "$WORK"
mkdir -p "$WORK" || { echo "ERROR — nothing was checked (cannot create $WORK)"; exit 2; }

# ---------------------------------------------------------------------------
# compile_one <relative-path> <logfile>
#   echoes the classified outcome: DROP | CLEAN | UNMEASURABLE
#
# The path MUST be repo-relative. A documented trap: `simple compile` with an
# ABSOLUTE path exits 0 WITHOUT COMPILING, which would turn every file into a
# false CLEAN. Absolute paths are rejected outright rather than normalised, so
# the failure is loud.
#
# Output goes to -o under $WORK so a scan never writes .smf artifacts next to
# the sources of a checkout that ~10 sessions share.
# ---------------------------------------------------------------------------
compile_one() {
    _f="$1"
    _log="$2"
    case "$_f" in
        /*) echo "UNMEASURABLE"; echo "absolute path rejected (compile exits 0 without compiling)" >"$_log"; return ;;
    esac
    _rc=0
    timeout "$TIMEOUT" "$BIN" compile "$_f" -o "$WORK/out.smf" >"$_log" 2>&1 || _rc=$?
    rm -f "$WORK/out.smf"
    if grep -q "$DROP_RE" "$_log" 2>/dev/null; then
        echo "DROP"
    elif [ "$_rc" -eq 0 ]; then
        echo "CLEAN"
    else
        # Compiled non-zero for some OTHER reason (missing dep, unrelated
        # semantic error, timeout). This file was NOT measured for the defect
        # class. It is never counted as a pass.
        echo "UNMEASURABLE"
    fi
}

# ---------------------------------------------------------------------------
# SELFTEST — fatal, runs before every scan.
#
# A guard never shown to fire is not a guard: this repo has a documented case of
# a guard whose only detection was of its own test fixture. So the selftest is
# bidirectional. It plants a KNOWN-BAD file that MUST be reported DROP and a
# KNOWN-GOOD file that MUST be reported CLEAN. If either direction disagrees,
# the fence exits 2 and reports on nothing — a fence that cannot fire must never
# print PASS.
# ---------------------------------------------------------------------------
selftest() {
    _fx="$WORK/selftest"
    mkdir -p "$_fx" || { echo "ERROR — nothing was checked (cannot create $_fx)"; return 2; }
    _rel="${_fx#"$REPO_ROOT"/}"
    case "$_rel" in
        /*) echo "ERROR — nothing was checked (fixture dir '$_fx' is outside the repo; compile needs a relative path)"; return 2 ;;
    esac

    printf 'val xs = [1, 2, 3]\nprint xs.length\n' >"$_fx/known_bad.spl" || return 2
    printf 'val xs = [1, 2, 3]\nprint xs.len()\n'  >"$_fx/known_good.spl" || return 2

    _bad="$(compile_one "$_rel/known_bad.spl" "$LOG_DIR/selftest-bad.log")"
    _good="$(compile_one "$_rel/known_good.spl" "$LOG_DIR/selftest-good.log")"

    if [ "$_bad" != "DROP" ]; then
        echo "ERROR — nothing was checked: the known-BAD fixture (\`xs.length\`) was classified '$_bad', not DROP."
        echo "        The fence cannot detect the defect it exists to detect, so it will not report on anything."
        echo "        Log: $LOG_DIR/selftest-bad.log"
        return 2
    fi
    if [ "$_good" != "CLEAN" ]; then
        echo "ERROR — nothing was checked: the known-GOOD fixture (\`xs.len()\`) was classified '$_good', not CLEAN."
        echo "        The fence would flag correct code, so its verdict is worthless."
        echo "        Log: $LOG_DIR/selftest-good.log"
        return 2
    fi
    echo "selftest: OK (known-bad -> DROP, known-good -> CLEAN; 2 fixtures, both directions)"
    return 0
}

# ---------------------------------------------------------------------------
# Roster
#
# Tracked files only, via `git ls-files` — that deduplicates by construction and
# keeps untracked scratch out of the count. Test trees are DUPLICATED in this
# repo (test/unit + test/01_unit + .spipe_matchers_*), so generated matcher
# mirrors are excluded explicitly; counting them would inflate any class size.
# ---------------------------------------------------------------------------
DEFAULT_ROOTS="src/lib src/app src/os src/compiler"

roster_for() {
    git ls-files -- "$@" 2>/dev/null \
        | grep -E '\.spl$' \
        | grep -v '/\.spipe_matchers_' \
        | grep -v '^src/compiler_rust/' \
        | grep -v '/vendor/' \
        | sort -u
}

# --candidates narrows the roster to files that TEXTUALLY contain a paren-less
# accessor. This is a pure SUPERSET filter and cannot drop a true positive: for
# a file to be reported DROP, the offending token must literally appear in it,
# because the diagnostic is raised while lowering that file's own function
# bodies. It is not a substitute for the compiler oracle — the filter
# massively OVER-reports (genuine `length` struct fields, doc comments, string
# literals all match), which is exactly why every survivor is still compiled.
# Purpose is only runtime: a full-tree per-file compile costs hours.
#
# `grep` on PATH in this environment is a WRAPPED ugrep that honours
# .gitignore; for a load-bearing roster that silently dropping files would be a
# fail-open, so the real /usr/bin/grep is used when present.
GREP=grep
[ -x /usr/bin/grep ] && GREP=/usr/bin/grep
candidate_filter() {
    _re='\.(length|len|size|empty|chars|first|last|capacity)([^A-Za-z0-9_(]|$)'
    xargs -r -d '\n' "$GREP" -lE "$_re" 2>/dev/null
}

# ---------------------------------------------------------------------------
# Argument handling
# ---------------------------------------------------------------------------
MODE="scan"
EXPLICIT_FILES=""
ROOTS=""
CANDIDATES=0
while [ $# -gt 0 ]; do
    case "$1" in
        --selftest)   MODE="selftest" ;;
        --list)       MODE="list" ;;
        --candidates) CANDIDATES=1 ;;
        --file)     shift; while [ $# -gt 0 ]; do EXPLICIT_FILES="$EXPLICIT_FILES $1"; shift; done ;;
        -*)         echo "ERROR — nothing was checked (unknown option '$1')"; exit 2 ;;
        *)          ROOTS="$ROOTS $1" ;;
    esac
    [ $# -gt 0 ] && shift
done

if [ -n "$EXPLICIT_FILES" ]; then
    FILES="$(for f in $EXPLICIT_FILES; do echo "$f"; done | sort -u)"
    SCOPE="explicit file list"
else
    [ -n "$ROOTS" ] || ROOTS="$DEFAULT_ROOTS"
    # shellcheck disable=SC2086
    FILES="$(roster_for $ROOTS)"
    SCOPE="roots:$ROOTS"
    if [ "$CANDIDATES" -eq 1 ]; then
        _all=0
        for f in $FILES; do _all=$((_all + 1)); done
        FILES="$(printf '%s\n' "$FILES" | candidate_filter)"
        SCOPE="$SCOPE [--candidates: textual superset filter, $_all file(s) in roster before filtering]"
    fi
fi

if [ "$MODE" = "list" ]; then
    echo "$FILES"
    exit 0
fi

# Selftest first, always. Fatal.
st_rc=0
selftest || st_rc=$?
if [ "$st_rc" -ne 0 ]; then
    exit 2
fi
if [ "$MODE" = "selftest" ]; then
    echo "PASS — 2 fixture(s) checked (selftest only; NO tree files were examined)"
    exit 0
fi

# Fail closed on an empty roster. An empty file set is the classic vacuous pass:
# the loop below would run zero times and every counter would stay at zero.
n_total=0
for f in $FILES; do n_total=$((n_total + 1)); done
if [ "$n_total" -eq 0 ]; then
    echo "ERROR — nothing was checked (the roster is empty for $SCOPE)"
    echo "        An empty selection is NOT a pass. Check the roots, or that this is a real clone with a git index."
    exit 2
fi

echo "scanning $n_total file(s) — $SCOPE"
[ "$MAX_FILES" -gt 0 ] && echo "NOTE: JIT_DROP_MAX_FILES=$MAX_FILES — this run is a bounded SAMPLE, not full coverage."

n_checked=0
n_clean=0
n_drop=0
n_unmeasurable=0
DROP_LIST="$LOG_DIR/drops.txt"
UNMEAS_LIST="$LOG_DIR/unmeasurable.txt"
: >"$DROP_LIST"
: >"$UNMEAS_LIST"

for f in $FILES; do
    if [ "$MAX_FILES" -gt 0 ] && [ "$n_checked" -ge "$MAX_FILES" ]; then
        break
    fi
    log="$WORK/one.log"
    verdict="$(compile_one "$f" "$log")"
    n_checked=$((n_checked + 1))
    case "$verdict" in
        DROP)
            n_drop=$((n_drop + 1))
            # Name the struct+field the compiler itself reported. The diagnostic
            # names struct and field but NOT the source file, which is precisely
            # why this fence drives one file at a time: attribution comes from
            # the loop variable, not from the message.
            detail="$(grep -o "struct '[^']*' field '[^']*'" "$log" | sort -u | tr '\n' ' ')"
            [ -n "$detail" ] || detail="$(grep -o "$DROP_RE.*" "$log" | head -1)"
            printf '%s\t%s\n' "$f" "$detail" >>"$DROP_LIST"
            printf 'DROP  %s  %s\n' "$f" "$detail"
            cp "$log" "$LOG_DIR/drop-$(echo "$f" | tr '/' '_').log" 2>/dev/null
            ;;
        CLEAN)
            n_clean=$((n_clean + 1))
            ;;
        *)
            n_unmeasurable=$((n_unmeasurable + 1))
            reason="$(grep -m1 -E '^error' "$log" 2>/dev/null | cut -c1-160)"
            [ -n "$reason" ] || reason="compile failed or timed out with no 'error:' line"
            printf '%s\t%s\n' "$f" "$reason" >>"$UNMEAS_LIST"
            ;;
    esac
done

if [ "$n_checked" -eq 0 ]; then
    echo "ERROR — nothing was checked (the scan loop executed zero times over a roster of $n_total)"
    exit 2
fi

# An UNMEASURABLE file was not proven clean — it failed to compile for an
# unrelated reason, so this fence has NO opinion about it. Reporting it as
# covered would be the fail-open pattern. It is stated in the verdict line so a
# reader can never mistake partial coverage for full coverage.
if [ "$n_unmeasurable" -gt 0 ]; then
    echo "NOTE: $n_unmeasurable file(s) could not be measured (unrelated compile failure); listed in $UNMEAS_LIST"
    echo "      These are NOT covered by the verdict below."
fi

if [ "$n_drop" -gt 0 ]; then
    echo "      full drop list: $DROP_LIST"
    echo "FAIL — $n_checked file(s) checked, $n_drop with a paren-less accessor whole-module de-JIT ($n_clean clean, $n_unmeasurable unmeasurable). Accessor family: $ACCESSORS"
    exit 1
fi

# Fail closed when NOTHING was actually measured. Without this the fence prints
# "PASS — 29 module(s) checked ... (0 compiled clean, 29 unmeasurable)", which
# reads green while proving nothing — found in exactly that form on 2026-08-08
# when a bad path list made every file fail to compile. A run in which not one
# file compiled clean has no evidence behind its verdict.
if [ "$n_clean" -eq 0 ]; then
    echo "ERROR — nothing was checked: all $n_checked selected file(s) were unmeasurable and NOT ONE compiled clean."
    echo "        With no clean compile there is no evidence the oracle ran against real code."
    echo "        Check the file list is valid and repo-relative. See $UNMEAS_LIST"
    exit 2
fi

sample_note=""
[ "$MAX_FILES" -gt 0 ] && sample_note=" [SAMPLE capped at $MAX_FILES of $n_total]"
echo "PASS — $n_checked module(s) checked, 0 paren-less accessor de-JIT drops ($n_clean compiled clean, $n_unmeasurable unmeasurable), selftest fired in both directions$sample_note"
exit 0
