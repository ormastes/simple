#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

. "$ROOT_DIR/scripts/deps/generated-2d-readback-lib.shs"

BUILD_DIR="${BUILD_DIR:-build/opencl_generated_2d_readback}"
REPORT_PATH="${REPORT_PATH:-doc/09_report/opencl_generated_2d_readback_$(date -u +%F).md}"
TOOLCHAIN_BUILD_DIR="${TOOLCHAIN_BUILD_DIR:-$BUILD_DIR/toolchains}"
SPIRV_PATH="${SPIRV_PATH:-$TOOLCHAIN_BUILD_DIR/simple_2d_optimization.spirv}"
OPENCL_SPIRV_TOOL="${OPENCL_SPIRV_TOOL:-opencl-c-to-spirv}"
OPENCL_RUNTIME_PROBE="${OPENCL_RUNTIME_PROBE:-clinfo}"
CC_TOOL="${CC_TOOL:-cc}"
OPENCL_ELEMENT_COUNT="${OPENCL_ELEMENT_COUNT:-64}"
OPENCL_FILL_VALUE="${OPENCL_FILL_VALUE:-16909060}"
EXPECTED_PIXELS_PATH="$BUILD_DIR/expected-u32.json"
ACTUAL_PIXELS_PATH="$BUILD_DIR/actual-u32.json"

mkdir -p "$BUILD_DIR" "$TOOLCHAIN_BUILD_DIR" "$(dirname "$REPORT_PATH")"

has_opencl_loader() {
    generated_2d_loader_present "libOpenCL.so" /usr/lib/libOpenCL.so /usr/lib64/libOpenCL.so /lib/x86_64-linux-gnu/libOpenCL.so /usr/local/cuda/lib64/libOpenCL.so
}

emit_env() {
    status="$1"
    reason="$2"
    readback="$3"
    submit="$4"
    bytes="$(generated_2d_bytes_of "$SPIRV_PATH")"
    {
        echo "opencl_generated_2d_readback_status=$status"
        echo "opencl_generated_2d_readback_reason=$reason"
        echo "opencl_generated_2d_readback_backend_name=opencl"
        echo "opencl_generated_2d_readback_spirv=$SPIRV_PATH"
        echo "opencl_generated_2d_readback_spirv_bytes=$bytes"
        echo "opencl_generated_2d_readback_loader_present=$loader_present"
        echo "opencl_generated_2d_readback_probe_tool_present=$probe_tool_present"
        echo "opencl_generated_2d_readback_module_verified=$module_verified"
        echo "opencl_generated_2d_readback_submit_attempted=$submit"
        echo "opencl_generated_2d_readback_readback_available=$readback"
        echo "opencl_generated_2d_readback_expected_checksum=0"
        echo "opencl_generated_2d_readback_actual_checksum=0"
        echo "opencl_generated_2d_readback_ops=fill,copy,alpha,scroll"
        echo "opencl_generated_2d_readback_font_status=unavailable"
        echo "opencl_generated_2d_readback_font_reason=$reason"
        echo "opencl_generated_2d_readback_font_backend=opencl"
        echo "opencl_generated_2d_readback_font_driver="
        echo "opencl_generated_2d_readback_font_device_handle=0"
        echo "opencl_generated_2d_readback_font_module_or_queue_handle=0"
        echo "opencl_generated_2d_readback_font_kernel_or_pipeline_handle=0"
        echo "opencl_generated_2d_readback_font_fence_handle=0"
        echo "opencl_generated_2d_readback_font_fence_handle_kind=clevent-wait-for-events"
        echo "opencl_generated_2d_readback_font_expected_checksum=0"
        echo "opencl_generated_2d_readback_font_actual_checksum=0"
        echo "opencl_generated_2d_readback_font_readback_checksum=0"
        echo "opencl_generated_2d_readback_font_mismatch_count=0"
        echo "opencl_generated_2d_readback_font_parity_status=unavailable"
        echo "opencl_generated_2d_readback_font_submit_attempted=false"
        echo "opencl_generated_2d_readback_font_readback_available=false"
    } >"$BUILD_DIR/evidence.env"
}

emit_unavailable() {
    reason="$1"
    emit_env "unavailable" "$reason" "false" "false"
}

opencl_env_value() {
    key="$1"
    while IFS='=' read -r _k _v || [ -n "$_k" ]; do
        if [ "$_k" = "$key" ]; then
            printf '%s\n' "$_v"
            return 0
        fi
    done <"$BUILD_DIR/evidence.env" 2>/dev/null || true
}

opencl_unsigned_decimal() {
    case "${1:-}" in
        '' | *[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

opencl_positive_decimal() {
    opencl_unsigned_decimal "$1" || return 1
    case "$1" in
        *[1-9]*) return 0 ;;
        *) return 1 ;;
    esac
}

opencl_mark_claimed_pass_failed() {
    reason="$1"
    tmp="$BUILD_DIR/evidence.env.tmp"
    awk -F= -v reason="$reason" '
        /^opencl_generated_2d_readback_status=/ {
            print "opencl_generated_2d_readback_status=fail"
            status_seen = 1
            next
        }
        /^opencl_generated_2d_readback_reason=/ {
            print "opencl_generated_2d_readback_reason=" reason
            reason_seen = 1
            next
        }
        { print }
        END {
            if (!status_seen) print "opencl_generated_2d_readback_status=fail"
            if (!reason_seen) print "opencl_generated_2d_readback_reason=" reason
        }
    ' "$BUILD_DIR/evidence.env" >"$tmp"
    mv "$tmp" "$BUILD_DIR/evidence.env"
}

opencl_validate_op_evidence() {
    op="$1"
    expected="$(opencl_env_value "opencl_generated_2d_readback_${op}_expected_checksum")"
    actual="$(opencl_env_value "opencl_generated_2d_readback_${op}_actual_checksum")"
    mismatches="$(opencl_env_value "opencl_generated_2d_readback_${op}_mismatch_count")"

    if ! opencl_positive_decimal "$expected" || ! opencl_positive_decimal "$actual"; then
        opencl_mark_claimed_pass_failed "${op}-checksum-missing-or-zero"
    elif [ "$expected" != "$actual" ]; then
        opencl_mark_claimed_pass_failed "${op}-checksum-mismatch"
    elif [ "$mismatches" != "0" ]; then
        opencl_mark_claimed_pass_failed "${op}-mismatch-count"
    fi
}

opencl_validate_evidence() {
    [ -s "$BUILD_DIR/evidence.env" ] || return 0
    status="$(opencl_env_value opencl_generated_2d_readback_status)"
    [ "$status" = "pass" ] || return 0
    submit="$(opencl_env_value opencl_generated_2d_readback_submit_attempted)"
    readback="$(opencl_env_value opencl_generated_2d_readback_readback_available)"
    expected="$(opencl_env_value opencl_generated_2d_readback_expected_checksum)"
    actual="$(opencl_env_value opencl_generated_2d_readback_actual_checksum)"
    mismatches="$(opencl_env_value opencl_generated_2d_readback_mismatch_count)"

    if [ "$submit" != "true" ]; then
        opencl_mark_claimed_pass_failed "missing-submit-attempt"
    elif [ "$readback" != "true" ]; then
        opencl_mark_claimed_pass_failed "missing-readback"
    elif ! opencl_positive_decimal "$expected" || ! opencl_positive_decimal "$actual"; then
        opencl_mark_claimed_pass_failed "checksum-missing-or-zero"
    elif [ "$expected" != "$actual" ]; then
        opencl_mark_claimed_pass_failed "aggregate-checksum-mismatch"
    elif [ "$mismatches" != "0" ]; then
        opencl_mark_claimed_pass_failed "aggregate-mismatch-count"
    else
        for op in fill copy alpha scroll; do
            opencl_validate_op_evidence "$op"
            [ "$(opencl_env_value opencl_generated_2d_readback_status)" = "pass" ] || break
        done
    fi
    if [ "$(opencl_env_value opencl_generated_2d_readback_status)" = "pass" ]; then
        f_status="$(opencl_env_value opencl_generated_2d_readback_font_status)"
        f_parity="$(opencl_env_value opencl_generated_2d_readback_font_parity_status)"
        f_backend="$(opencl_env_value opencl_generated_2d_readback_font_backend)"
        f_driver="$(opencl_env_value opencl_generated_2d_readback_font_driver)"
        f_submit="$(opencl_env_value opencl_generated_2d_readback_font_submit_attempted)"
        f_readback="$(opencl_env_value opencl_generated_2d_readback_font_readback_available)"
        f_dev="$(opencl_env_value opencl_generated_2d_readback_font_device_handle)"
        f_mod="$(opencl_env_value opencl_generated_2d_readback_font_module_or_queue_handle)"
        f_kern="$(opencl_env_value opencl_generated_2d_readback_font_kernel_or_pipeline_handle)"
        f_fence="$(opencl_env_value opencl_generated_2d_readback_font_fence_handle)"
        f_ex="$(opencl_env_value opencl_generated_2d_readback_font_expected_checksum)"
        f_act="$(opencl_env_value opencl_generated_2d_readback_font_actual_checksum)"
        f_rb="$(opencl_env_value opencl_generated_2d_readback_font_readback_checksum)"
        f_mm="$(opencl_env_value opencl_generated_2d_readback_font_mismatch_count)"

        if [ "$f_status" != "pass" ] || [ "$f_parity" != "pass" ]; then
            opencl_mark_claimed_pass_failed "font-parity-not-pass"
        elif [ "$f_backend" != "opencl" ] || [ -z "$f_driver" ]; then
            opencl_mark_claimed_pass_failed "font-provenance-missing"
        elif [ "$f_submit" != "true" ] || [ "$f_readback" != "true" ]; then
            opencl_mark_claimed_pass_failed "font-submit-or-readback-missing"
        elif ! opencl_positive_decimal "$f_dev" \
            || ! opencl_positive_decimal "$f_mod" \
            || ! opencl_positive_decimal "$f_kern" \
            || ! opencl_positive_decimal "$f_fence"; then
            opencl_mark_claimed_pass_failed "font-handle-missing-or-zero"
        elif ! opencl_positive_decimal "$f_ex" \
            || ! opencl_positive_decimal "$f_act" \
            || ! opencl_positive_decimal "$f_rb"; then
            opencl_mark_claimed_pass_failed "font-checksum-missing-or-zero"
        elif [ "$f_act" != "$f_ex" ] || [ "$f_rb" != "$f_act" ]; then
            opencl_mark_claimed_pass_failed "font-checksum-mismatch"
        elif [ "$f_mm" != "0" ]; then
            opencl_mark_claimed_pass_failed "font-mismatch-count"
        fi
    fi
}

if [ "${1:-}" = "--self-test" ]; then
    self_dir="${BUILD_DIR}.self_test"
    rm -rf "$self_dir"
    mkdir -p "$self_dir"
    BUILD_DIR="$self_dir"

    cat >"$BUILD_DIR/evidence.env" <<'EOF'
opencl_generated_2d_readback_status=pass
opencl_generated_2d_readback_reason=fake
opencl_generated_2d_readback_readback_available=true
opencl_generated_2d_readback_expected_checksum=4
opencl_generated_2d_readback_actual_checksum=4
opencl_generated_2d_readback_mismatch_count=0
EOF
    opencl_validate_evidence
    if ! grep -q '^opencl_generated_2d_readback_status=fail$' "$BUILD_DIR/evidence.env" \
        || ! grep -q '^opencl_generated_2d_readback_reason=missing-submit-attempt$' "$BUILD_DIR/evidence.env"; then
        echo "self_test_status=fail"
        echo "self_test_reason=missing-submit-accepted"
        exit 1
    fi

    cat >"$BUILD_DIR/evidence.env" <<'EOF'
opencl_generated_2d_readback_status=pass
opencl_generated_2d_readback_reason=fake
opencl_generated_2d_readback_submit_attempted=true
opencl_generated_2d_readback_expected_checksum=4
opencl_generated_2d_readback_actual_checksum=4
opencl_generated_2d_readback_mismatch_count=0
EOF
    opencl_validate_evidence
    if ! grep -q '^opencl_generated_2d_readback_status=fail$' "$BUILD_DIR/evidence.env" \
        || ! grep -q '^opencl_generated_2d_readback_reason=missing-readback$' "$BUILD_DIR/evidence.env"; then
        echo "self_test_status=fail"
        echo "self_test_reason=missing-readback-accepted"
        exit 1
    fi

    cat >"$BUILD_DIR/evidence.env" <<'EOF'
opencl_generated_2d_readback_status=pass
opencl_generated_2d_readback_reason=fake
opencl_generated_2d_readback_submit_attempted=true
opencl_generated_2d_readback_readback_available=true
opencl_generated_2d_readback_expected_checksum=4
opencl_generated_2d_readback_actual_checksum=5
opencl_generated_2d_readback_mismatch_count=0
EOF
    opencl_validate_evidence
    if ! grep -q '^opencl_generated_2d_readback_status=fail$' "$BUILD_DIR/evidence.env" \
        || ! grep -q '^opencl_generated_2d_readback_reason=aggregate-checksum-mismatch$' "$BUILD_DIR/evidence.env"; then
        echo "self_test_status=fail"
        echo "self_test_reason=checksum-mismatch-accepted"
        exit 1
    fi

    cat >"$BUILD_DIR/evidence.env" <<'EOF'
opencl_generated_2d_readback_status=pass
opencl_generated_2d_readback_reason=readback-pixels-matched
opencl_generated_2d_readback_submit_attempted=true
opencl_generated_2d_readback_readback_available=true
opencl_generated_2d_readback_expected_checksum=4
opencl_generated_2d_readback_actual_checksum=4
opencl_generated_2d_readback_mismatch_count=0
opencl_generated_2d_readback_fill_expected_checksum=1
opencl_generated_2d_readback_fill_actual_checksum=1
opencl_generated_2d_readback_fill_mismatch_count=0
opencl_generated_2d_readback_copy_expected_checksum=1
opencl_generated_2d_readback_copy_actual_checksum=1
opencl_generated_2d_readback_copy_mismatch_count=0
opencl_generated_2d_readback_alpha_expected_checksum=1
opencl_generated_2d_readback_alpha_actual_checksum=1
opencl_generated_2d_readback_alpha_mismatch_count=0
opencl_generated_2d_readback_scroll_expected_checksum=1
opencl_generated_2d_readback_scroll_actual_checksum=1
opencl_generated_2d_readback_scroll_mismatch_count=0
opencl_generated_2d_readback_font_status=pass
opencl_generated_2d_readback_font_reason=straight-argb-pixels-matched
opencl_generated_2d_readback_font_backend=opencl
opencl_generated_2d_readback_font_driver=opencl-driver-3.0
opencl_generated_2d_readback_font_device_handle=3001
opencl_generated_2d_readback_font_module_or_queue_handle=3002
opencl_generated_2d_readback_font_kernel_or_pipeline_handle=3003
opencl_generated_2d_readback_font_fence_handle=3004
opencl_generated_2d_readback_font_fence_handle_kind=clevent-wait-for-events
opencl_generated_2d_readback_font_expected_checksum=14991786118
opencl_generated_2d_readback_font_actual_checksum=14991786118
opencl_generated_2d_readback_font_readback_checksum=14991786118
opencl_generated_2d_readback_font_mismatch_count=0
opencl_generated_2d_readback_font_parity_status=pass
opencl_generated_2d_readback_font_submit_attempted=true
opencl_generated_2d_readback_font_readback_available=true
EOF
    cp "$BUILD_DIR/evidence.env" "$BUILD_DIR/valid.env"
    opencl_validate_evidence
    if ! grep -q '^opencl_generated_2d_readback_status=pass$' "$BUILD_DIR/evidence.env" \
        || ! grep -q '^opencl_generated_2d_readback_font_backend=opencl$' "$BUILD_DIR/evidence.env" \
        || ! grep -q '^opencl_generated_2d_readback_font_fence_handle=3004$' "$BUILD_DIR/evidence.env" \
        || ! grep -q '^opencl_generated_2d_readback_font_readback_checksum=14991786118$' "$BUILD_DIR/evidence.env"; then
        echo "self_test_status=fail"
        echo "self_test_reason=valid-readback-rejected"
        exit 1
    fi

    grep -v '^opencl_generated_2d_readback_font_' "$BUILD_DIR/valid.env" >"$BUILD_DIR/evidence.env"
    opencl_validate_evidence
    if ! grep -q '^opencl_generated_2d_readback_status=fail$' "$BUILD_DIR/evidence.env" \
        || ! grep -q '^opencl_generated_2d_readback_reason=font-parity-not-pass$' "$BUILD_DIR/evidence.env"; then
        echo "self_test_status=fail"
        echo "self_test_reason=missing-font-provenance-accepted"
        exit 1
    fi

    sed 's/^opencl_generated_2d_readback_font_fence_handle=3004$/opencl_generated_2d_readback_font_fence_handle=0/' "$BUILD_DIR/valid.env" >"$BUILD_DIR/evidence.env"
    opencl_validate_evidence
    if ! grep -q '^opencl_generated_2d_readback_status=fail$' "$BUILD_DIR/evidence.env" \
        || ! grep -q '^opencl_generated_2d_readback_reason=font-handle-missing-or-zero$' "$BUILD_DIR/evidence.env"; then
        echo "self_test_status=fail"
        echo "self_test_reason=zero-font-fence-accepted"
        exit 1
    fi

    sed 's/^opencl_generated_2d_readback_font_actual_checksum=14991786118$/opencl_generated_2d_readback_font_actual_checksum=14991786119/' "$BUILD_DIR/valid.env" >"$BUILD_DIR/evidence.env"
    opencl_validate_evidence
    if ! grep -q '^opencl_generated_2d_readback_status=fail$' "$BUILD_DIR/evidence.env" \
        || ! grep -q '^opencl_generated_2d_readback_reason=font-checksum-mismatch$' "$BUILD_DIR/evidence.env"; then
        echo "self_test_status=fail"
        echo "self_test_reason=font-checksum-mismatch-accepted"
        exit 1
    fi

    cat >"$BUILD_DIR/evidence.env" <<'EOF'
opencl_generated_2d_readback_status=pass
opencl_generated_2d_readback_reason=readback-pixels-matched
opencl_generated_2d_readback_submit_attempted=true
opencl_generated_2d_readback_readback_available=true
opencl_generated_2d_readback_expected_checksum=4
opencl_generated_2d_readback_actual_checksum=4
opencl_generated_2d_readback_mismatch_count=0
opencl_generated_2d_readback_fill_expected_checksum=1
opencl_generated_2d_readback_fill_actual_checksum=1
opencl_generated_2d_readback_fill_mismatch_count=0
opencl_generated_2d_readback_copy_expected_checksum=1
opencl_generated_2d_readback_copy_actual_checksum=2
opencl_generated_2d_readback_copy_mismatch_count=0
opencl_generated_2d_readback_alpha_expected_checksum=1
opencl_generated_2d_readback_alpha_actual_checksum=1
opencl_generated_2d_readback_alpha_mismatch_count=0
opencl_generated_2d_readback_scroll_expected_checksum=1
opencl_generated_2d_readback_scroll_actual_checksum=1
opencl_generated_2d_readback_scroll_mismatch_count=0
EOF
    opencl_validate_evidence
    if ! grep -q '^opencl_generated_2d_readback_status=fail$' "$BUILD_DIR/evidence.env" \
        || ! grep -q '^opencl_generated_2d_readback_reason=copy-checksum-mismatch$' "$BUILD_DIR/evidence.env"; then
        echo "self_test_status=fail"
        echo "self_test_reason=per-op-checksum-mismatch-accepted"
        exit 1
    fi

    echo "self_test_status=pass"
    echo "self_test_reason=opencl-submit-readback-per-op-checksum-gate"
    exit 0
fi

loader_present=false
if has_opencl_loader; then
    loader_present=true
fi

probe_tool_present=false
if generated_2d_have "$OPENCL_RUNTIME_PROBE"; then
    probe_tool_present=true
fi

module_verified=false
if ! generated_2d_module_verified "$SPIRV_PATH"; then
    REPORT_PATH="$BUILD_DIR/toolchains.md" BUILD_DIR="$TOOLCHAIN_BUILD_DIR" OPENCL_SPIRV_TOOL="$OPENCL_SPIRV_TOOL" sh scripts/check/check-portable-compute-toolchains.shs >/dev/null
fi

if generated_2d_module_verified "$SPIRV_PATH"; then
    module_verified=true
fi

if [ "$loader_present" != "true" ]; then
    emit_unavailable "missing-opencl-runtime-loader"
elif [ "$probe_tool_present" != "true" ]; then
    emit_unavailable "missing-opencl-runtime-probe-tool"
elif ! generated_2d_have "$CC_TOOL"; then
    emit_unavailable "missing-c-compiler"
else
    if "$OPENCL_RUNTIME_PROBE" >"$BUILD_DIR/opencl_probe.out" 2>"$BUILD_DIR/opencl_probe.err"; then
        cat >"$BUILD_DIR/opencl_generated_2d_readback.c" <<'C_EOF'
#include <dlfcn.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

/* Runtime-resolved OpenCL binding (no libOpenCL.so at link time — see
 * doc/03_plan/runtime/native_binding/dlopen_conversion_lanes.md lane N3).
 * Own minimal type/const definitions so this harness has zero build-time
 * dependency on OpenCL SDK headers, matching the loader contract in
 * src/runtime/runtime_simd_dispatch.c. */
typedef int32_t cl_int;
typedef int64_t cl_long;
typedef uint32_t cl_uint;
typedef uint64_t cl_device_type;
typedef uint64_t cl_mem_flags;
typedef intptr_t cl_context_properties;
typedef void* cl_platform_id;
typedef void* cl_device_id;
typedef void* cl_context;
typedef void* cl_command_queue;
typedef void* cl_program;
typedef void* cl_kernel;
typedef void* cl_mem;
typedef void* cl_event;

#define CL_SUCCESS 0
#define CL_TRUE 1
#define CL_DEVICE_TYPE_DEFAULT ((cl_device_type)1ULL << 0)
#define CL_DEVICE_TYPE_GPU ((cl_device_type)1ULL << 2)
#define CL_DEVICE_DRIVER_VERSION 0x102Du
#define CL_MEM_READ_WRITE ((cl_mem_flags)1ULL << 0)

typedef cl_int (*clGetPlatformIDs_fn)(cl_uint, cl_platform_id*, cl_uint*);
typedef cl_int (*clGetDeviceIDs_fn)(cl_platform_id, cl_device_type, cl_uint, cl_device_id*, cl_uint*);
typedef cl_int (*clGetDeviceInfo_fn)(cl_device_id, cl_uint, size_t, void*, size_t*);
typedef cl_context (*clCreateContext_fn)(const cl_context_properties*, cl_uint, const cl_device_id*, void*, void*, cl_int*);
typedef cl_command_queue (*clCreateCommandQueueWithProperties_fn)(cl_context, cl_device_id, const cl_context_properties*, cl_int*);
typedef cl_program (*clCreateProgramWithSource_fn)(cl_context, cl_uint, const char**, const size_t*, cl_int*);
typedef cl_int (*clBuildProgram_fn)(cl_program, cl_uint, const cl_device_id*, const char*, void*, void*);
typedef cl_kernel (*clCreateKernel_fn)(cl_program, const char*, cl_int*);
typedef cl_int (*clSetKernelArg_fn)(cl_kernel, cl_uint, size_t, const void*);
typedef cl_mem (*clCreateBuffer_fn)(cl_context, cl_mem_flags, size_t, void*, cl_int*);
typedef cl_int (*clEnqueueWriteBuffer_fn)(cl_command_queue, cl_mem, cl_uint, size_t, size_t, const void*, cl_uint, const void*, void*);
typedef cl_int (*clEnqueueReadBuffer_fn)(cl_command_queue, cl_mem, cl_uint, size_t, size_t, void*, cl_uint, const void*, void*);
typedef cl_int (*clEnqueueNDRangeKernel_fn)(cl_command_queue, cl_kernel, cl_uint, const size_t*, const size_t*, const size_t*, cl_uint, const void*, cl_event*);
typedef cl_int (*clWaitForEvents_fn)(cl_uint, const cl_event*);
typedef cl_int (*clReleaseEvent_fn)(cl_event);
typedef cl_int (*clReleaseMemObject_fn)(cl_mem);
typedef cl_int (*clReleaseKernel_fn)(cl_kernel);
typedef cl_int (*clReleaseProgram_fn)(cl_program);
typedef cl_int (*clFinish_fn)(cl_command_queue);

typedef struct ClFns {
    clGetPlatformIDs_fn GetPlatformIDs;
    clGetDeviceIDs_fn GetDeviceIDs;
    clGetDeviceInfo_fn GetDeviceInfo;
    clCreateContext_fn CreateContext;
    clCreateCommandQueueWithProperties_fn CreateCommandQueueWithProperties;
    clCreateProgramWithSource_fn CreateProgramWithSource;
    clBuildProgram_fn BuildProgram;
    clCreateKernel_fn CreateKernel;
    clSetKernelArg_fn SetKernelArg;
    clCreateBuffer_fn CreateBuffer;
    clEnqueueWriteBuffer_fn EnqueueWriteBuffer;
    clEnqueueReadBuffer_fn EnqueueReadBuffer;
    clEnqueueNDRangeKernel_fn EnqueueNDRangeKernel;
    clWaitForEvents_fn WaitForEvents;
    clReleaseEvent_fn ReleaseEvent;
    clReleaseMemObject_fn ReleaseMemObject;
    clReleaseKernel_fn ReleaseKernel;
    clReleaseProgram_fn ReleaseProgram;
    clFinish_fn Finish;
} ClFns;

static ClFns g_fns;

/* Ordered soname candidates (same order as src/runtime/runtime_simd_dispatch.c
 * rt_opencl_load_symbols) — dlopen, then verify EVERY export used below is
 * actually present before reporting the loader available. A dlopen success
 * alone is not honesty; naming the missing symbol on failure is. */
static int cl_load(const char **out_soname, const char **out_missing_symbol) {
    static const char *candidates[] = { "libOpenCL.so.1", "libOpenCL.so", NULL };
    void *handle = NULL;
    const char *used = NULL;
    for (int i = 0; candidates[i]; i++) {
        handle = dlopen(candidates[i], RTLD_NOW | RTLD_LOCAL);
        if (handle) { used = candidates[i]; break; }
    }
    if (!handle) { *out_soname = NULL; return 0; }
    *out_soname = used;

#define CL_LOAD(field, name) \
    g_fns.field = (void*)dlsym(handle, name); \
    if (!g_fns.field) { *out_missing_symbol = name; return 0; }

    CL_LOAD(GetPlatformIDs, "clGetPlatformIDs")
    CL_LOAD(GetDeviceIDs, "clGetDeviceIDs")
    CL_LOAD(GetDeviceInfo, "clGetDeviceInfo")
    CL_LOAD(CreateContext, "clCreateContext")
    CL_LOAD(CreateCommandQueueWithProperties, "clCreateCommandQueueWithProperties")
    CL_LOAD(CreateProgramWithSource, "clCreateProgramWithSource")
    CL_LOAD(BuildProgram, "clBuildProgram")
    CL_LOAD(CreateKernel, "clCreateKernel")
    CL_LOAD(SetKernelArg, "clSetKernelArg")
    CL_LOAD(CreateBuffer, "clCreateBuffer")
    CL_LOAD(EnqueueWriteBuffer, "clEnqueueWriteBuffer")
    CL_LOAD(EnqueueReadBuffer, "clEnqueueReadBuffer")
    CL_LOAD(EnqueueNDRangeKernel, "clEnqueueNDRangeKernel")
    CL_LOAD(WaitForEvents, "clWaitForEvents")
    CL_LOAD(ReleaseEvent, "clReleaseEvent")
    CL_LOAD(ReleaseMemObject, "clReleaseMemObject")
    CL_LOAD(ReleaseKernel, "clReleaseKernel")
    CL_LOAD(ReleaseProgram, "clReleaseProgram")
    CL_LOAD(Finish, "clFinish")
#undef CL_LOAD
    return 1;
}

static const char *kernel_source =
"__kernel void simple_2d_fill_u32(__global uint* dst, uint value, uint count) {"
"  uint i = get_global_id(0); if (i >= count) return; dst[i] = value;"
"}"
"__kernel void simple_2d_copy_u32(__global const uint* src, __global uint* dst, uint count) {"
"  uint i = get_global_id(0); if (i >= count) return; dst[i] = src[i];"
"}"
"__kernel void simple_2d_alpha_u32(__global const uint* src, __global uint* dst, uint alpha, uint count) {"
"  uint i = get_global_id(0); if (i >= count) return;"
"  uint s = src[i]; uint d = dst[i]; uint inv = 255u - alpha;"
"  uint rb = (((s & 0x00ff00ffu) * alpha) + ((d & 0x00ff00ffu) * inv)) >> 8;"
"  uint g = (((s & 0x0000ff00u) * alpha) + ((d & 0x0000ff00u) * inv)) >> 8;"
"  dst[i] = 0xff000000u | (rb & 0x00ff00ffu) | (g & 0x0000ff00u);"
"}"
"__kernel void simple_2d_scroll_u32(__global const uint* src, __global uint* dst, uint width, uint height, int delta_y) {"
"  uint i = get_global_id(0); uint count = width * height; if (i >= count) return;"
"  uint x = i % width; uint y = i / width; int sy = (int)y - delta_y;"
"  if (sy < 0 || sy >= (int)height) { dst[i] = 0u; return; }"
"  dst[i] = src[(uint)sy * width + x];"
"}"
"__kernel void simple_font_atlas_composite_v1_u32(\n"
"    __global const uint* atlas, __global uint* dst,\n"
"    long atlas_width, long atlas_height, long atlas_count,\n"
"    long atlas_x, long atlas_y, long quad_width, long quad_height,\n"
"    long dst_width, long dst_height, long dst_count,\n"
"    long dst_x, long dst_y, long color) {\n"
"    long i = get_global_id(0);\n"
"    if (i < 0 || atlas_width > 2147483647L || atlas_height > 2147483647L ||\n"
"        quad_width > 2147483647L || quad_height > 2147483647L ||\n"
"        dst_width > 2147483647L || dst_height > 2147483647L) { return; }\n"
"    if (atlas_width <= 0 || atlas_height <= 0 || atlas_count <= 0 ||\n"
"        quad_width <= 0 || quad_height <= 0 || dst_width <= 0 ||\n"
"        dst_height <= 0 || dst_count <= 0 || atlas_x < 0 || atlas_y < 0) { return; }\n"
"    if (atlas_count != atlas_width * atlas_height || dst_count != dst_width * dst_height) { return; }\n"
"    if (atlas_x > atlas_width || atlas_y > atlas_height ||\n"
"        quad_width > atlas_width - atlas_x || quad_height > atlas_height - atlas_y) { return; }\n"
"    if (dst_x < -quad_width || dst_y < -quad_height || dst_x >= dst_width || dst_y >= dst_height) { return; }\n"
"    if (i >= quad_width * quad_height) { return; }\n"
"    long sx = atlas_x + i % quad_width;\n"
"    long sy = atlas_y + i / quad_width;\n"
"    if (sx < 0 || sy < 0 || sx >= atlas_width || sy >= atlas_height) { return; }\n"
"    long si = sy * atlas_width + sx;\n"
"    if (si < 0 || si >= atlas_count) { return; }\n"
"    long dx = i % quad_width + dst_x;\n"
"    long dy = i / quad_width + dst_y;\n"
"    if (dx < 0 || dy < 0 || dx >= dst_width || dy >= dst_height) { return; }\n"
"    long di = (long)dy * dst_width + (long)dx;\n"
"    if (di < 0 || di >= dst_count) { return; }\n"
"    uint color_u32 = (uint)color;\n"
"    uint mask_a = atlas[si] >> 24u;\n"
"    uint sa = (mask_a * (color_u32 >> 24u) + 127u) / 255u;\n"
"    if (sa == 0u) { return; }\n"
"    uint d = dst[di];\n"
"    uint da = d >> 24u;\n"
"    uint inv = 255u - sa;\n"
"    uint dst_weight = (da * inv) / 255u;\n"
"    uint out_a = sa + dst_weight;\n"
"    uint out_r = (((color_u32 >> 16u) & 255u) * sa + ((d >> 16u) & 255u) * dst_weight) / out_a;\n"
"    uint out_g = (((color_u32 >> 8u) & 255u) * sa + ((d >> 8u) & 255u) * dst_weight) / out_a;\n"
"    uint out_b = ((color_u32 & 255u) * sa + (d & 255u) * dst_weight) / out_a;\n"
"    dst[di] = (out_a << 24u) | (out_r << 16u) | (out_g << 8u) | out_b;\n"
"}\n";

static uint64_t checksum_u32(const uint32_t *data, unsigned int count) {
    uint64_t sum = 0;
    for (unsigned int i = 0; i < count; ++i) sum += data[i];
    return sum;
}

static uint64_t mismatch_u32(const uint32_t *actual, const uint32_t *expected, unsigned int count) {
    uint64_t mismatches = 0;
    for (unsigned int i = 0; i < count; ++i) {
        if (actual[i] != expected[i]) mismatches++;
    }
    return mismatches;
}

static uint64_t mismatch_fill_u32(const uint32_t *actual, uint32_t expected, unsigned int count) {
    uint64_t mismatches = 0;
    for (unsigned int i = 0; i < count; ++i) {
        if (actual[i] != expected) mismatches++;
    }
    return mismatches;
}

static int write_json_u32(const char *path, const uint32_t *data, unsigned int count, const char *producer) {
    FILE *f = fopen(path, "w");
    if (!f) return 0;
    fprintf(f, "{\"count\":%u,\"format\":\"u32\",\"producer\":\"%s\",\"pixels\":[", count, producer);
    for (unsigned int i = 0; i < count; ++i) {
        if (i > 0) fputc(',', f);
        fprintf(f, "%u", data[i]);
    }
    fprintf(f, "]}");
    fclose(f);
    return 1;
}

static uint32_t alpha_pixel(uint32_t s, uint32_t d, uint32_t alpha) {
    uint32_t inv = 255u - alpha;
    uint32_t rb = (((s & 0x00ff00ffu) * alpha) + ((d & 0x00ff00ffu) * inv)) >> 8;
    uint32_t g = (((s & 0x0000ff00u) * alpha) + ((d & 0x0000ff00u) * inv)) >> 8;
    return 0xff000000u | (rb & 0x00ff00ffu) | (g & 0x0000ff00u);
}

static uint32_t font_straight_argb_pixel(uint32_t mask, uint32_t d, uint32_t color) {
    uint32_t sa = (((mask >> 24u) & 255u) * (color >> 24u) + 127u) / 255u;
    if (sa == 0u) return d;
    uint32_t da = d >> 24u;
    uint32_t dst_weight = (da * (255u - sa)) / 255u;
    uint32_t out_a = sa + dst_weight;
    uint32_t out_r = ((((color >> 16u) & 255u) * sa) + (((d >> 16u) & 255u) * dst_weight)) / out_a;
    uint32_t out_g = ((((color >> 8u) & 255u) * sa) + (((d >> 8u) & 255u) * dst_weight)) / out_a;
    uint32_t out_b = (((color & 255u) * sa) + ((d & 255u) * dst_weight)) / out_a;
    return (out_a << 24u) | (out_r << 16u) | (out_g << 8u) | out_b;
}

static void sanitize_env_token(char *buf, size_t cap, const char *fallback) {
    size_t i = 0;
    for (; i + 1 < cap && buf[i] != '\0'; i++) {
        unsigned char ch = (unsigned char)buf[i];
        int ok = (ch >= '0' && ch <= '9') || (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || ch == '.' || ch == '_' || ch == '-';
        if (!ok) buf[i] = '-';
    }
    if (i == 0) snprintf(buf, cap, "%s", fallback);
}

static void fail(const char *reason, cl_int code, uint64_t expected, uint64_t actual) {
    printf("opencl_generated_2d_readback_status=fail\n");
    printf("opencl_generated_2d_readback_reason=%s\n", reason);
    printf("opencl_generated_2d_readback_opencl_code=%d\n", (int)code);
    printf("opencl_generated_2d_readback_expected_checksum=%llu\n", (unsigned long long)expected);
    printf("opencl_generated_2d_readback_actual_checksum=%llu\n", (unsigned long long)actual);
}

static int set3(cl_kernel k, cl_mem a, cl_mem b, cl_uint c) {
    cl_int err = CL_SUCCESS;
    err |= g_fns.SetKernelArg(k, 0, sizeof(cl_mem), &a);
    err |= g_fns.SetKernelArg(k, 1, sizeof(cl_mem), &b);
    err |= g_fns.SetKernelArg(k, 2, sizeof(cl_uint), &c);
    return err == CL_SUCCESS;
}

int main(int argc, char **argv) {
    unsigned int count = argc > 1 ? (unsigned int)strtoul(argv[1], NULL, 10) : 64u;
    unsigned int value = argc > 2 ? (unsigned int)strtoul(argv[2], NULL, 10) : 16909060u;
    const char *expected_pixels_path = argc > 3 ? argv[3] : "expected-u32.json";
    const char *actual_pixels_path = argc > 4 ? argv[4] : "actual-u32.json";
    if (count == 0 || count % 8u != 0u) { fail("invalid-count", -1, 0, 0); return 2; }
    size_t bytes = (size_t)count * sizeof(uint32_t);

    const char *loaded_soname = NULL;
    const char *missing_symbol = NULL;
    if (!cl_load(&loaded_soname, &missing_symbol)) {
        if (!loaded_soname) {
            fail("opencl-lib-absent", -1, 0, 0);
        } else {
            printf("opencl_generated_2d_readback_missing_symbol=%s\n", missing_symbol);
            printf("opencl_generated_2d_readback_loaded_soname=%s\n", loaded_soname);
            fail("opencl-export-missing", -1, 0, 0);
        }
        return 3;
    }

    cl_int err = CL_SUCCESS;
    cl_uint platform_count = 0;
    err = g_fns.GetPlatformIDs(0, NULL, &platform_count);
    if (err != CL_SUCCESS || platform_count == 0) { fail("opencl-no-platform", err, 0, 0); return 3; }
    cl_platform_id platform = NULL;
    err = g_fns.GetPlatformIDs(1, &platform, NULL);
    if (err != CL_SUCCESS) { fail("opencl-get-platform", err, 0, 0); return 3; }
    cl_device_id device = NULL;
    err = g_fns.GetDeviceIDs(platform, CL_DEVICE_TYPE_GPU, 1, &device, NULL);
    if (err != CL_SUCCESS) err = g_fns.GetDeviceIDs(platform, CL_DEVICE_TYPE_DEFAULT, 1, &device, NULL);
    if (err != CL_SUCCESS) { fail("opencl-no-device", err, 0, 0); return 3; }
    cl_context context = g_fns.CreateContext(NULL, 1, &device, NULL, NULL, &err);
    if (err != CL_SUCCESS) { fail("opencl-create-context", err, 0, 0); return 3; }
    cl_command_queue queue = g_fns.CreateCommandQueueWithProperties(context, device, NULL, &err);
    if (err != CL_SUCCESS) { fail("opencl-create-queue", err, 0, 0); return 3; }
    cl_program program = g_fns.CreateProgramWithSource(context, 1, &kernel_source, NULL, &err);
    if (err != CL_SUCCESS) { fail("opencl-create-program", err, 0, 0); return 3; }
    err = g_fns.BuildProgram(program, 1, &device, "", NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-build-program", err, 0, 0); return 3; }
    cl_kernel k_fill = g_fns.CreateKernel(program, "simple_2d_fill_u32", &err);
    if (err != CL_SUCCESS) { fail("opencl-create-fill-kernel", err, 0, 0); return 3; }
    cl_kernel k_copy = g_fns.CreateKernel(program, "simple_2d_copy_u32", &err);
    if (err != CL_SUCCESS) { fail("opencl-create-copy-kernel", err, 0, 0); return 3; }
    cl_kernel k_alpha = g_fns.CreateKernel(program, "simple_2d_alpha_u32", &err);
    if (err != CL_SUCCESS) { fail("opencl-create-alpha-kernel", err, 0, 0); return 3; }
    cl_kernel k_scroll = g_fns.CreateKernel(program, "simple_2d_scroll_u32", &err);
    if (err != CL_SUCCESS) { fail("opencl-create-scroll-kernel", err, 0, 0); return 3; }
    cl_kernel k_font = g_fns.CreateKernel(program, "simple_font_atlas_composite_v1_u32", &err);
    if (err != CL_SUCCESS || !k_font) { fail("opencl-create-font-kernel", err, 0, 0); return 3; }

    char driver_buf[128];
    driver_buf[0] = '\0';
    size_t driver_bytes = 0;
    if (g_fns.GetDeviceInfo(device, CL_DEVICE_DRIVER_VERSION, sizeof(driver_buf), driver_buf, &driver_bytes) != CL_SUCCESS) {
        driver_buf[0] = '\0';
    }
    driver_buf[sizeof(driver_buf) - 1] = '\0';
    sanitize_env_token(driver_buf, sizeof(driver_buf), "opencl-icd");

    uint32_t *host = (uint32_t *)calloc(count, sizeof(uint32_t));
    uint32_t *expected_buf = (uint32_t *)calloc(count, sizeof(uint32_t));
    uint32_t *expected_all = (uint32_t *)calloc((size_t)count * 4u, sizeof(uint32_t));
    uint32_t *actual_all = (uint32_t *)calloc((size_t)count * 4u, sizeof(uint32_t));
    if (!host || !expected_buf || !expected_all || !actual_all) { fail("host-alloc-failed", -1, 0, 0); return 3; }
    cl_mem src = g_fns.CreateBuffer(context, CL_MEM_READ_WRITE, bytes, NULL, &err);
    if (err != CL_SUCCESS) { fail("opencl-buffer-src", err, 0, 0); return 3; }
    cl_mem dst = g_fns.CreateBuffer(context, CL_MEM_READ_WRITE, bytes, NULL, &err);
    if (err != CL_SUCCESS) { fail("opencl-buffer-dst", err, 0, 0); return 3; }
    size_t global = count;

    cl_uint count_arg = count;
    cl_uint value_arg = value;
    err = g_fns.SetKernelArg(k_fill, 0, sizeof(cl_mem), &dst);
    err |= g_fns.SetKernelArg(k_fill, 1, sizeof(cl_uint), &value_arg);
    err |= g_fns.SetKernelArg(k_fill, 2, sizeof(cl_uint), &count_arg);
    if (err != CL_SUCCESS) { fail("opencl-fill-args", err, 0, 0); return 3; }
    err = g_fns.EnqueueNDRangeKernel(queue, k_fill, 1, NULL, &global, NULL, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-fill-enqueue", err, 0, 0); return 3; }
    err = g_fns.Finish(queue);
    if (err != CL_SUCCESS) { fail("opencl-fill-finish", err, 0, 0); return 3; }
    err = g_fns.EnqueueReadBuffer(queue, dst, CL_TRUE, 0, bytes, host, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-fill-readback", err, 0, 0); return 3; }
    uint64_t fill_actual = checksum_u32(host, count);
    uint64_t fill_expected = (uint64_t)value * (uint64_t)count;
    uint64_t fill_mismatches = mismatch_fill_u32(host, value, count);
    for (unsigned int i = 0; i < count; ++i) { expected_all[i] = value; actual_all[i] = host[i]; }

    for (unsigned int i = 0; i < count; ++i) expected_buf[i] = 1000u + i;
    err = g_fns.EnqueueWriteBuffer(queue, src, CL_TRUE, 0, bytes, expected_buf, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-copy-write", err, 0, 0); return 3; }
    if (!set3(k_copy, src, dst, count_arg)) { fail("opencl-copy-args", -1, 0, 0); return 3; }
    err = g_fns.EnqueueNDRangeKernel(queue, k_copy, 1, NULL, &global, NULL, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-copy-enqueue", err, 0, 0); return 3; }
    err = g_fns.Finish(queue);
    if (err != CL_SUCCESS) { fail("opencl-copy-finish", err, 0, 0); return 3; }
    err = g_fns.EnqueueReadBuffer(queue, dst, CL_TRUE, 0, bytes, host, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-copy-readback", err, 0, 0); return 3; }
    uint64_t copy_actual = checksum_u32(host, count);
    uint64_t copy_expected = checksum_u32(expected_buf, count);
    uint64_t copy_mismatches = mismatch_u32(host, expected_buf, count);
    for (unsigned int i = 0; i < count; ++i) { expected_all[count + i] = expected_buf[i]; actual_all[count + i] = host[i]; }

    for (unsigned int i = 0; i < count; ++i) expected_buf[i] = 0xff204060u + i;
    for (unsigned int i = 0; i < count; ++i) host[i] = 0xff102030u + i;
    err = g_fns.EnqueueWriteBuffer(queue, src, CL_TRUE, 0, bytes, expected_buf, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-alpha-src-write", err, 0, 0); return 3; }
    err = g_fns.EnqueueWriteBuffer(queue, dst, CL_TRUE, 0, bytes, host, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-alpha-dst-write", err, 0, 0); return 3; }
    cl_uint alpha = 128u;
    for (unsigned int i = 0; i < count; ++i) expected_buf[i] = alpha_pixel(expected_buf[i], host[i], alpha);
    err = g_fns.SetKernelArg(k_alpha, 0, sizeof(cl_mem), &src);
    err |= g_fns.SetKernelArg(k_alpha, 1, sizeof(cl_mem), &dst);
    err |= g_fns.SetKernelArg(k_alpha, 2, sizeof(cl_uint), &alpha);
    err |= g_fns.SetKernelArg(k_alpha, 3, sizeof(cl_uint), &count_arg);
    if (err != CL_SUCCESS) { fail("opencl-alpha-args", err, 0, 0); return 3; }
    err = g_fns.EnqueueNDRangeKernel(queue, k_alpha, 1, NULL, &global, NULL, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-alpha-enqueue", err, 0, 0); return 3; }
    err = g_fns.Finish(queue);
    if (err != CL_SUCCESS) { fail("opencl-alpha-finish", err, 0, 0); return 3; }
    err = g_fns.EnqueueReadBuffer(queue, dst, CL_TRUE, 0, bytes, host, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-alpha-readback", err, 0, 0); return 3; }
    uint64_t alpha_actual = checksum_u32(host, count);
    uint64_t alpha_expected = checksum_u32(expected_buf, count);
    uint64_t alpha_mismatches = mismatch_u32(host, expected_buf, count);
    for (unsigned int i = 0; i < count; ++i) { expected_all[count * 2u + i] = expected_buf[i]; actual_all[count * 2u + i] = host[i]; }

    cl_uint width = 8u;
    cl_uint height = count / width;
    cl_int delta_y = 1;
    for (unsigned int i = 0; i < count; ++i) host[i] = 2000u + i;
    for (unsigned int i = 0; i < count; ++i) {
        unsigned int x = i % width;
        unsigned int y = i / width;
        int sy = (int)y - delta_y;
        expected_buf[i] = (sy < 0 || sy >= (int)height) ? 0u : host[(unsigned int)sy * width + x];
    }
    err = g_fns.EnqueueWriteBuffer(queue, src, CL_TRUE, 0, bytes, host, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-scroll-write", err, 0, 0); return 3; }
    err = g_fns.SetKernelArg(k_scroll, 0, sizeof(cl_mem), &src);
    err |= g_fns.SetKernelArg(k_scroll, 1, sizeof(cl_mem), &dst);
    err |= g_fns.SetKernelArg(k_scroll, 2, sizeof(cl_uint), &width);
    err |= g_fns.SetKernelArg(k_scroll, 3, sizeof(cl_uint), &height);
    err |= g_fns.SetKernelArg(k_scroll, 4, sizeof(cl_int), &delta_y);
    if (err != CL_SUCCESS) { fail("opencl-scroll-args", err, 0, 0); return 3; }
    err = g_fns.EnqueueNDRangeKernel(queue, k_scroll, 1, NULL, &global, NULL, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-scroll-enqueue", err, 0, 0); return 3; }
    err = g_fns.Finish(queue);
    if (err != CL_SUCCESS) { fail("opencl-scroll-finish", err, 0, 0); return 3; }
    err = g_fns.EnqueueReadBuffer(queue, dst, CL_TRUE, 0, bytes, host, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-scroll-readback", err, 0, 0); return 3; }
    uint64_t scroll_actual = checksum_u32(host, count);
    uint64_t scroll_expected = checksum_u32(expected_buf, count);
    uint64_t scroll_mismatches = mismatch_u32(host, expected_buf, count);
    for (unsigned int i = 0; i < count; ++i) { expected_all[count * 3u + i] = expected_buf[i]; actual_all[count * 3u + i] = host[i]; }

    const unsigned int font_count = 4u;
    const size_t font_bytes = font_count * sizeof(uint32_t);
    uint32_t font_atlas[] = {0x00000000u, 0x80ffffffu, 0xffffffffu, 0xffffffffu};
    uint32_t font_initial[] = {0xff102030u, 0xff102030u, 0xff102030u, 0x00000000u};
    uint32_t font_expected_pixels[4];
    uint32_t font_actual_pixels[4];
    cl_long font_color_l = (cl_long)0x80402010u;
    for (unsigned int i = 0; i < font_count; ++i) {
        font_expected_pixels[i] = font_straight_argb_pixel(font_atlas[i], font_initial[i], (uint32_t)font_color_l);
    }
    cl_mem font_atlas_buf = g_fns.CreateBuffer(context, CL_MEM_READ_WRITE, font_bytes, NULL, &err);
    if (err != CL_SUCCESS || !font_atlas_buf) { fail("opencl-font-atlas-buffer", err, 0, 0); return 3; }
    cl_mem font_dst_buf = g_fns.CreateBuffer(context, CL_MEM_READ_WRITE, font_bytes, NULL, &err);
    if (err != CL_SUCCESS || !font_dst_buf) { fail("opencl-font-dst-buffer", err, 0, 0); return 3; }
    err = g_fns.EnqueueWriteBuffer(queue, font_atlas_buf, CL_TRUE, 0, font_bytes, font_atlas, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-font-atlas-write", err, 0, 0); return 3; }
    err = g_fns.EnqueueWriteBuffer(queue, font_dst_buf, CL_TRUE, 0, font_bytes, font_initial, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-font-dst-write", err, 0, 0); return 3; }

    cl_long f_atlas_w = 4, f_atlas_h = 1, f_atlas_cnt = 4;
    cl_long f_atlas_x = 0, f_atlas_y = 0, f_quad_w = 4, f_quad_h = 1;
    cl_long f_dst_w = 4, f_dst_h = 1, f_dst_cnt = 4;
    cl_long f_dst_x = 0, f_dst_y = 0;
    err = g_fns.SetKernelArg(k_font, 0, sizeof(cl_mem), &font_atlas_buf);
    err |= g_fns.SetKernelArg(k_font, 1, sizeof(cl_mem), &font_dst_buf);
    err |= g_fns.SetKernelArg(k_font, 2, sizeof(cl_long), &f_atlas_w);
    err |= g_fns.SetKernelArg(k_font, 3, sizeof(cl_long), &f_atlas_h);
    err |= g_fns.SetKernelArg(k_font, 4, sizeof(cl_long), &f_atlas_cnt);
    err |= g_fns.SetKernelArg(k_font, 5, sizeof(cl_long), &f_atlas_x);
    err |= g_fns.SetKernelArg(k_font, 6, sizeof(cl_long), &f_atlas_y);
    err |= g_fns.SetKernelArg(k_font, 7, sizeof(cl_long), &f_quad_w);
    err |= g_fns.SetKernelArg(k_font, 8, sizeof(cl_long), &f_quad_h);
    err |= g_fns.SetKernelArg(k_font, 9, sizeof(cl_long), &f_dst_w);
    err |= g_fns.SetKernelArg(k_font, 10, sizeof(cl_long), &f_dst_h);
    err |= g_fns.SetKernelArg(k_font, 11, sizeof(cl_long), &f_dst_cnt);
    err |= g_fns.SetKernelArg(k_font, 12, sizeof(cl_long), &f_dst_x);
    err |= g_fns.SetKernelArg(k_font, 13, sizeof(cl_long), &f_dst_y);
    err |= g_fns.SetKernelArg(k_font, 14, sizeof(cl_long), &font_color_l);
    if (err != CL_SUCCESS) { fail("opencl-font-args", err, 0, 0); return 3; }

    size_t font_global = font_count;
    cl_event font_event = NULL;
    err = g_fns.EnqueueNDRangeKernel(queue, k_font, 1, NULL, &font_global, NULL, 0, NULL, &font_event);
    if (err != CL_SUCCESS || !font_event) { fail("opencl-font-enqueue", err, 0, 0); return 3; }
    err = g_fns.WaitForEvents(1, &font_event);
    if (err != CL_SUCCESS) { fail("opencl-font-wait", err, 0, 0); return 3; }
    uint64_t font_fence_handle = (uint64_t)(uintptr_t)font_event;
    g_fns.ReleaseEvent(font_event);
    err = g_fns.EnqueueReadBuffer(queue, font_dst_buf, CL_TRUE, 0, font_bytes, font_actual_pixels, 0, NULL, NULL);
    if (err != CL_SUCCESS) { fail("opencl-font-readback", err, 0, 0); return 3; }
    uint64_t font_expected = checksum_u32(font_expected_pixels, font_count);
    uint64_t font_actual = checksum_u32(font_actual_pixels, font_count);
    uint64_t font_mismatches = mismatch_u32(font_actual_pixels, font_expected_pixels, font_count);
    uint64_t font_device_handle = (uint64_t)(uintptr_t)device;
    uint64_t font_module_handle = (uint64_t)(uintptr_t)program;
    uint64_t font_kernel_handle = (uint64_t)(uintptr_t)k_font;
    g_fns.ReleaseMemObject(font_atlas_buf);
    g_fns.ReleaseMemObject(font_dst_buf);
    g_fns.ReleaseKernel(k_font);

    uint64_t actual = fill_actual + copy_actual + alpha_actual + scroll_actual;
    uint64_t expected = fill_expected + copy_expected + alpha_expected + scroll_expected;
    uint64_t mismatches = fill_mismatches + copy_mismatches + alpha_mismatches + scroll_mismatches;
    int wrote_expected = write_json_u32(expected_pixels_path, expected_all, count * 4u, "opencl-generated-2d-expected");
    int wrote_actual = write_json_u32(actual_pixels_path, actual_all, count * 4u, "opencl-generated-2d-readback");
    int font_ok = font_actual == font_expected && font_mismatches == 0 && font_device_handle > 0 && font_module_handle > 0 && font_kernel_handle > 0 && font_fence_handle > 0;
    if (actual == expected && mismatches == 0 && font_ok && wrote_expected && wrote_actual) {
        printf("opencl_generated_2d_readback_status=pass\n");
        printf("opencl_generated_2d_readback_reason=readback-pixels-matched\n");
        printf("opencl_generated_2d_readback_backend_name=opencl\n");
        printf("opencl_generated_2d_readback_opencl_code=0\n");
        printf("opencl_generated_2d_readback_submit_attempted=true\n");
        printf("opencl_generated_2d_readback_readback_available=true\n");
        printf("opencl_generated_2d_readback_expected_checksum=%llu\n", (unsigned long long)expected);
        printf("opencl_generated_2d_readback_actual_checksum=%llu\n", (unsigned long long)actual);
        printf("opencl_generated_2d_readback_mismatch_count=%llu\n", (unsigned long long)mismatches);
        printf("opencl_generated_2d_readback_fill_expected_checksum=%llu\n", (unsigned long long)fill_expected);
        printf("opencl_generated_2d_readback_fill_actual_checksum=%llu\n", (unsigned long long)fill_actual);
        printf("opencl_generated_2d_readback_fill_mismatch_count=%llu\n", (unsigned long long)fill_mismatches);
        printf("opencl_generated_2d_readback_copy_expected_checksum=%llu\n", (unsigned long long)copy_expected);
        printf("opencl_generated_2d_readback_copy_actual_checksum=%llu\n", (unsigned long long)copy_actual);
        printf("opencl_generated_2d_readback_copy_mismatch_count=%llu\n", (unsigned long long)copy_mismatches);
        printf("opencl_generated_2d_readback_alpha_expected_checksum=%llu\n", (unsigned long long)alpha_expected);
        printf("opencl_generated_2d_readback_alpha_actual_checksum=%llu\n", (unsigned long long)alpha_actual);
        printf("opencl_generated_2d_readback_alpha_mismatch_count=%llu\n", (unsigned long long)alpha_mismatches);
        printf("opencl_generated_2d_readback_scroll_expected_checksum=%llu\n", (unsigned long long)scroll_expected);
        printf("opencl_generated_2d_readback_scroll_actual_checksum=%llu\n", (unsigned long long)scroll_actual);
        printf("opencl_generated_2d_readback_scroll_mismatch_count=%llu\n", (unsigned long long)scroll_mismatches);
        printf("opencl_generated_2d_readback_blur_or_tolerance_used=false\n");
        printf("opencl_generated_2d_readback_ops=fill,copy,alpha,scroll\n");
        printf("opencl_generated_2d_readback_count=%u\n", count);
        printf("opencl_generated_2d_readback_value=%u\n", value);
        printf("opencl_generated_2d_readback_expected_pixels_path=%s\n", expected_pixels_path);
        printf("opencl_generated_2d_readback_actual_pixels_path=%s\n", actual_pixels_path);
        printf("opencl_generated_2d_readback_font_status=pass\n");
        printf("opencl_generated_2d_readback_font_reason=straight-argb-pixels-matched\n");
        printf("opencl_generated_2d_readback_font_entry=simple_font_atlas_composite_v1_u32\n");
        printf("opencl_generated_2d_readback_font_oracle_semantics_revision=2\n");
        printf("opencl_generated_2d_readback_font_submit_attempted=true\n");
        printf("opencl_generated_2d_readback_font_readback_available=true\n");
        printf("opencl_generated_2d_readback_font_fixture=straight-argb-v2-4x1\n");
        printf("opencl_generated_2d_readback_font_backend=opencl\n");
        printf("opencl_generated_2d_readback_font_driver=%s\n", driver_buf);
        printf("opencl_generated_2d_readback_font_device_handle=%llu\n", (unsigned long long)font_device_handle);
        printf("opencl_generated_2d_readback_font_module_or_queue_handle=%llu\n", (unsigned long long)font_module_handle);
        printf("opencl_generated_2d_readback_font_kernel_or_pipeline_handle=%llu\n", (unsigned long long)font_kernel_handle);
        printf("opencl_generated_2d_readback_font_fence_handle=%llu\n", (unsigned long long)font_fence_handle);
        printf("opencl_generated_2d_readback_font_fence_handle_kind=clevent-wait-for-events\n");
        printf("opencl_generated_2d_readback_font_expected_checksum=%llu\n", (unsigned long long)font_expected);
        printf("opencl_generated_2d_readback_font_actual_checksum=%llu\n", (unsigned long long)font_actual);
        printf("opencl_generated_2d_readback_font_readback_checksum=%llu\n", (unsigned long long)font_actual);
        printf("opencl_generated_2d_readback_font_mismatch_count=%llu\n", (unsigned long long)font_mismatches);
        printf("opencl_generated_2d_readback_font_parity_status=pass\n");
        return 0;
    }
    fail(wrote_expected && wrote_actual ? "readback-pixel-mismatch" : "readback-artifact-write-failed", 0, expected, actual);
    return 4;
}
C_EOF
        if ! "$CC_TOOL" -O2 -o "$BUILD_DIR/opencl_generated_2d_readback" "$BUILD_DIR/opencl_generated_2d_readback.c" -ldl >"$BUILD_DIR/cc.out" 2>"$BUILD_DIR/cc.err"; then
            emit_unavailable "opencl-readback-harness-build-failed"
        elif "$BUILD_DIR/opencl_generated_2d_readback" "$OPENCL_ELEMENT_COUNT" "$OPENCL_FILL_VALUE" "$EXPECTED_PIXELS_PATH" "$ACTUAL_PIXELS_PATH" >"$BUILD_DIR/evidence.env" 2>"$BUILD_DIR/run.err"; then
            {
                echo "opencl_generated_2d_readback_spirv=$SPIRV_PATH"
                echo "opencl_generated_2d_readback_spirv_bytes=$(generated_2d_bytes_of "$SPIRV_PATH")"
                echo "opencl_generated_2d_readback_loader_present=$loader_present"
                echo "opencl_generated_2d_readback_probe_tool_present=$probe_tool_present"
                echo "opencl_generated_2d_readback_module_verified=$module_verified"
            } >>"$BUILD_DIR/evidence.env"
        else
            if [ ! -s "$BUILD_DIR/evidence.env" ]; then
                emit_unavailable "opencl-readback-run-failed"
            fi
        fi
    else
        emit_unavailable "opencl-runtime-probe-failed"
    fi
fi

. "$BUILD_DIR/evidence.env"
opencl_validate_evidence
. "$BUILD_DIR/evidence.env"
generated_2d_report_from_env "$REPORT_PATH" "OpenCL Generated 2D Readback Evidence" "$BUILD_DIR/evidence.env" "Generated OpenCL evidence is fail-closed until the OpenCL loader, runtime probe, compiled kernel harness, device/queue/kernel handles, submit, synchronization, and readback checksum are all present. The SPIR-V fields are retained as portable-toolchain diagnostics; this gate passes only from direct OpenCL C runtime execution and readback checksum parity."

cat "$BUILD_DIR/evidence.env"
echo "report_path=$REPORT_PATH"

if [ "$opencl_generated_2d_readback_status" = "pass" ]; then
    exit 0
fi
exit 1
