#!/bin/sh
set -eu

root=${1:-.}
version=$(tr -d '[:space:]' <"$root/VERSION")
[ -n "$version" ] || { echo "empty VERSION" >&2; exit 1; }

for file in \
    config/bootstrap.sdn \
    src/app/simple.sdn \
    src/compiler/simple.sdn \
    src/lib/simple.sdn \
    src/compiler_rust/simple.sdn; do
    grep -Eq "^[[:space:]]*version:[[:space:]]+$version[[:space:]]*$" \
        "$root/$file" || { echo "stale release version: $file" >&2; exit 1; }
done

for file in \
    src/app/cli/bootstrap_identity.spl \
    src/app/cli/cli_helpers.spl \
    src/app/cli/_CliMain/args_and_os_commands.spl; do
    grep -Fq "\"$version\"" "$root/$file" ||
        { echo "stale release version: $file" >&2; exit 1; }
done

grep -Fq "Simple v$version" "$root/src/app/simpleos_tool/main.spl" ||
    { echo "stale release version: src/app/simpleos_tool/main.spl" >&2; exit 1; }
grep -Eq "^version = \"$version\"$" "$root/src/compiler_rust/Cargo.toml" ||
    { echo "stale release version: src/compiler_rust/Cargo.toml" >&2; exit 1; }
[ "$(grep -Ec "^version = \"$version\"$" "$root/src/compiler_rust/Cargo.lock")" -eq 11 ] ||
    { echo "stale local package versions: src/compiler_rust/Cargo.lock" >&2; exit 1; }

echo "release_version_consistency=pass version=$version"
