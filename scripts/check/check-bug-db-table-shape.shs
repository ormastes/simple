#!/bin/sh
# check-bug-db-table-shape.shs - every row of a multi-table SDN file must have
# exactly its table's column count. Table header: `name |c1, c2, ...|`.
# Fields are counted quote-aware (commas inside "..." do not count; backslash
# escapes inside quotes). Rows are trimmed first, so an unindented (column 0)
# row is counted exactly like an indented one. Blank and `#` lines are skipped.
#
# Incident: 18 ten-field `bugs` rows were appended under the 4-column
# `bug_scope` table; SdnTable.parse folds extra fields into the last column, so
# the file loaded while the bugs were invisible to bugs/bugs_active consumers.
#
# Ratchet: legacy malformed rows are frozen in scripts/check/bug_db_table_shape_baseline.txt
# (one `table|id|fields` key per line). Only malformed rows NOT in the baseline fail.
# Regenerate (reviewed updates only): BASE= LIST=1 sh <this> [file] > baseline
#
# Usage: check-bug-db-table-shape.shs [--selftest] [--baseline FILE] [file]
# Default file: doc/08_tracking/bug/bug_db.sdn
# Verdict is the LAST stdout line: PASS (exit 0) / FAIL (exit 1) /
# ERROR - nothing was checked (exit 2; empty/missing file is ERROR, not PASS).

scan() {
    awk -v base="${BASE:-}" -v list="${LIST:-0}" '
    function nf(s,   i, c, q, n, e) {
        n = 1; q = 0; e = 0
        for (i = 1; i <= length(s); i++) {
            c = substr(s, i, 1)
            if (e) { e = 0; continue }
            if (q && c == "\\") { e = 1; continue }
            if (c == "\"") { q = !q; continue }
            if (c == "," && !q) n++
        }
        return n
    }
    BEGIN {
        if (base != "") while ((getline k < base) > 0) if (k != "" && substr(k, 1, 1) != "#") known[k] = 1
    }
    {
        l = $0
        sub(/\r$/, "", l); sub(/^[ \t]+/, "", l); sub(/[ \t]+$/, "", l)
        if (l == "" || substr(l, 1, 1) == "#") next
        if (l ~ /^[A-Za-z_][A-Za-z0-9_]* *\|.*\|$/) {
            name = l; sub(/ *\|.*$/, "", name)
            cols = l; sub(/^[^|]*\|/, "", cols); sub(/\|$/, "", cols)
            want = nf(cols); tables++; cur = name
            next
        }
        if (cur == "") next
        rows++
        got = nf(l)
        if (got != want) {
            id = l; sub(/,.*$/, "", id)
            key = cur "|" id "|" got
            if (list == 1) { print key; next }
            if (key in known) { frozen++; next }
            bad++
            msg = msg (bad > 1 ? "; " : "") id " (" cur ": " got " fields, want " want ")"
        }
    }
    END {
        if (rows == 0) { print "ERROR — nothing was checked (0 rows)"; exit 2 }
        if (list == 1) exit 0
        if (bad > 0) { print "FAIL — " rows " row(s) checked across " tables " table(s), " bad " malformed: " msg; exit 1 }
        print "PASS — " rows " row(s) checked across " tables " table(s), 0 malformed (" frozen + 0 " baselined)"
    }' "$1"
}

selftest() {
    d=$(mktemp -d 2>/dev/null) || return 1
    printf 'bugs |id, sev, title|\n    a, P1, "x, y"\ns |bug_id, scope|\n    a, shared\n' > "$d/clean"
    printf 's |bug_id, scope, layer, note|\n    a, shared, l, n\n    bad_id, P1, open, "t", f, 1, r, c, u, true\n' > "$d/wide"
    printf 's |bug_id, scope, layer, note|\n    a, shared, l, n\nbad_col0, P1, open, "t", f, 1, r, c, u, true\n' > "$d/col0"
    printf 's|bad_id|10\n' > "$d/base"
    : > "$d/empty"
    out=$(LIST=0 BASE= scan "$d/clean"); rc=$?
    [ $rc -eq 0 ] && case "$out" in "PASS —"*) : ;; *) rc=9 ;; esac
    [ $rc -eq 0 ] || { echo "selftest: clean must PASS (rc=$rc)"; rm -rf "$d"; return 1; }
    out=$(LIST=0 BASE= scan "$d/wide"); rc=$?
    case "$out" in *"bad_id"*) : ;; *) rc=9 ;; esac
    [ $rc -eq 1 ] || { echo "selftest: wide row must FAIL naming bad_id (rc=$rc)"; rm -rf "$d"; return 1; }
    out=$(LIST=0 BASE= scan "$d/col0"); rc=$?
    case "$out" in *"bad_col0"*) : ;; *) rc=9 ;; esac
    [ $rc -eq 1 ] || { echo "selftest: column-0 row must be counted and FAIL (rc=$rc)"; rm -rf "$d"; return 1; }
    out=$(LIST=0 BASE="$d/base" scan "$d/wide"); rc=$?
    [ $rc -eq 0 ] || { echo "selftest: baselined row must PASS (rc=$rc)"; rm -rf "$d"; return 1; }
    LIST=0 BASE= scan "$d/empty" > /dev/null; rc=$?
    [ $rc -eq 2 ] || { echo "selftest: empty file must ERROR (rc=$rc)"; rm -rf "$d"; return 1; }
    rm -rf "$d"
    echo "selftest: ok (5 fixtures)" >&2
}

main() {
    run_self=0; file=""; BASE=""; want_base=0
    for a in "$@"; do
        if [ "$want_base" -eq 1 ]; then BASE=$a; want_base=0; continue; fi
        case "$a" in
            --selftest) run_self=1 ;;
            --baseline) want_base=1 ;;
            *) file=$a ;;
        esac
    done
    selftest || { echo "ERROR — nothing was checked (selftest failed)"; exit 2; }
    [ "$run_self" -eq 1 ] && [ -z "$file" ] && { echo "PASS — selftest only"; exit 0; }
    [ -n "$file" ] || file=doc/08_tracking/bug/bug_db.sdn
    [ -s "$file" ] || { echo "ERROR — nothing was checked ($file missing or empty)"; exit 2; }
    if [ -z "$BASE" ] && [ "${LIST:-0}" != 1 ]; then
        d=$(dirname "$0"); [ -f "$d/bug_db_table_shape_baseline.txt" ] && BASE="$d/bug_db_table_shape_baseline.txt"
    fi
    export BASE
    scan "$file"
    exit $?
}

main "$@"
