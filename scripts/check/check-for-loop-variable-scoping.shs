#!/bin/sh
# Guard: a `for` loop variable is SCOPED TO THE LOOP. It must not survive the
# loop, and it must never clobber a pre-existing outer binding.
#
# Bug: doc/08_tracking/bug/for_loop_variable_leaks_into_enclosing_scope_2026-08-04.md
#
# WHAT WENT WRONG
# ---------------
# `exec_for` bound the loop pattern straight into the CALLER's `Env` with no
# scope push and no restore. So `val x = 100` followed by `for x in [1,2,3]` left
# `x == 3` — an immutable `val` silently overwritten by a loop that merely reused
# the name. Both engines were affected.
#
# WHY THE ASSERTIONS ARE SHAPED THIS WAY
# --------------------------------------
# The interesting property is not "the loop ran". It is what the enclosing scope
# looks like AFTERWARDS, which splits into two cases that fail independently:
#
#   1. SHADOWING — an outer binding of the same name must be intact after the
#      loop. This is the data-loss case and the one with a `val` involved.
#   2. NON-LEAK — a loop variable with NO outer binding must not be visible after
#      the loop at all. A fix that only saves/restores pre-existing names would
#      pass (1) and still leak here.
#
# Both are checked for a plain identifier AND for a TUPLE pattern
# (`for i, v in ...`), because the binding path for tuple patterns recurses
# separately and a names-collector that forgot to recurse would pass the plain
# case only.
#
# It also checks that the loop still WORKS — iteration count and last value
# observed from inside the body. Without that, a "fix" that skipped the body
# entirely, or one that restored the outer value before each iteration instead of
# after the loop, would pass every scoping assertion while breaking all loops.
#
# `exec_for` dispatches through EIGHT specialised fast paths (int range, int
# array, float array, enumerated, string count, string match, ...) before the
# generic body, each of which bound into the caller's env the same way. The
# probe therefore exercises an int range, an int array, a float array, a text
# array and an enumerated loop, so a fix applied to only some paths is caught.
#
# BINARY UNDER TEST — `SIMPLE_BIN` (default `bin/simple`). Expected RED against
# the stale deployed binary and GREEN against a freshly built seed until the next
# redeploy; see the bug doc.
#
# FAIL-CLOSED CONTRACT — verdict line is always the LAST line of stdout:
#   PASS — <n> engine setting(s) checked: ...   exit 0   (n is always > 0)
#   FAIL — ...                                  exit 1
#   ERROR — nothing was checked: ...            exit 2

set -u

SIMPLE_BIN="${SIMPLE_BIN:-bin/simple}"
SIMPLE_RUST_SEED_WARNING=0
export SIMPLE_RUST_SEED_WARNING

fail() { printf 'FAIL — %s\n' "$1"; exit 1; }
oops() { printf 'ERROR — nothing was checked: %s\n' "$1"; exit 2; }

[ -x "$SIMPLE_BIN" ] || command -v "$SIMPLE_BIN" >/dev/null 2>&1 \
  || oops "compiler not executable at '$SIMPLE_BIN' (set SIMPLE_BIN to override)"

work="$(mktemp -d)" || oops "mktemp failed"
trap 'rm -rf "$work"' EXIT INT TERM

# Case 1 — SHADOWING. Each loop reuses the name of an outer `val`, one per
# fast-path element type. The outer value must be intact afterwards.
shadow="$work/for_shadow.spl"
cat > "$shadow" <<'SHADOW_EOF'
fn main():
    val a = 100
    for a in [1, 2, 3]:
        pass
    print "int_array={a}"

    val b = 200
    for b in 0..5:
        pass
    print "int_range={b}"

    val c = 300.5
    for c in [1.5, 2.5]:
        pass
    print "float_array={c}"

    val d = "outer"
    for d in ["p", "q"]:
        pass
    print "text_array={d}"

    # Tuple pattern: BOTH names must be restored, which requires the names
    # collector to recurse into the pattern rather than handle only a bare name.
    val i = 900
    val v = 901
    for i, v in [10, 20, 30]:
        pass
    print "enum_i={i}"
    print "enum_v={v}"
    print "SHADOW_END"
main()
SHADOW_EOF
[ -s "$shadow" ] || oops "shadow probe was not written"

# Case 2 — NON-LEAK plus liveness. `n` has no outer binding, so after the loop it
# must be GONE. Reading a name that is not bound is an error, so absence is
# proven by the program failing at that read — with the pre-read marker present
# and the post-read marker absent. The counters prove the loop really ran.
leak="$work/for_leak.spl"
cat > "$leak" <<'LEAK_EOF'
fn main():
    var count = 0
    var last = -1
    for n in [4, 5, 6]:
        count = count + 1
        last = n
    print "count={count}"
    print "last={last}"
    print "BEFORE_LEAK_READ"
    print "leaked={n}"
    print "AFTER_LEAK_READ"
main()
LEAK_EOF
[ -s "$leak" ] || oops "leak probe was not written"

checked=0
engines=""

for mode in interpreter jit; do
  sout="$work/shadow.$mode"
  SIMPLE_EXECUTION_MODE="$mode" "$SIMPLE_BIN" run "$shadow" > "$sout" 2>&1
  src=$?
  [ "$src" -eq 0 ] || oops "engine '$mode': shadow probe exited $src: $(tr '\n' '|' < "$sout")"
  /usr/bin/grep -aq '^SHADOW_END$' "$sout" \
    || oops "engine '$mode': shadow probe did not run to completion — assertions would be vacuous: $(tr '\n' '|' < "$sout")"

  # 1. Outer bindings intact. Pre-fix these read 3 / 4 / 2.5 / q / 2 / 30.
  for pair in 'int_array=100' 'int_range=200' 'float_array=300.5' 'text_array=outer' 'enum_i=900' 'enum_v=901'; do
    /usr/bin/grep -aq "^$pair\$" "$sout" \
      || fail "engine '$mode': a for-loop CLOBBERED an outer \`val\` — expected '$pair', got: $(/usr/bin/grep -a "^${pair%%=*}=" "$sout")"
  done

  lout="$work/leak.$mode"
  SIMPLE_EXECUTION_MODE="$mode" "$SIMPLE_BIN" run "$leak" > "$lout" 2>&1

  # 2. Liveness FIRST: the loop must actually have executed its body 3 times
  #    with the right values. A fix that restored the binding per-iteration, or
  #    skipped the body, would break these while satisfying the scoping test.
  /usr/bin/grep -aq '^count=3$' "$lout" \
    || fail "engine '$mode': the loop body did not run 3 times; got: $(/usr/bin/grep -a '^count=' "$lout")"
  /usr/bin/grep -aq '^last=6$' "$lout" \
    || fail "engine '$mode': the loop variable was not visible INSIDE the body; expected 'last=6', got: $(/usr/bin/grep -a '^last=' "$lout")"
  /usr/bin/grep -aq '^BEFORE_LEAK_READ$' "$lout" \
    || oops "engine '$mode': leak probe did not reach the read under test — assertion would be vacuous: $(tr '\n' '|' < "$lout")"

  # 3. The loop variable must NOT survive the loop.
  #
  # INTERPRETER ONLY, and the reason is a SEPARATE pre-existing defect, not a
  # gap in this fix. Absence is proven here by the read FAILING. On the JIT an
  # unresolved name does not fail — it silently lowers to 0, for ANY name:
  #
  #     print "undef={totally_undeclared_name}"   # jit -> undef=0, exit 0
  #                                               # interpreter -> error
  #
  # so on that engine a correctly-scoped loop variable and a leaked one are
  # INDISTINGUISHABLE by this probe (both would print `leaked=0`). Asserting it
  # there would be asserting the lenient-lowering bug, not the scoping fix.
  # That divergence is recorded in
  # doc/08_tracking/bug/interp_implicit_self_field_assignment_silent_noop_2026-07-17.md
  # ("Separate defect observed while reproducing"). When it is fixed, drop this
  # condition and let both engines run the assertion.
  #
  # The CLOBBERING half above — the actual data-loss case — IS checked on both
  # engines, and it is the half this bug is about.
  if [ "$mode" = interpreter ] && /usr/bin/grep -aq '^AFTER_LEAK_READ$' "$lout"; then
    fail "engine '$mode': the loop variable LEAKED — reading \`n\` after the loop succeeded ($(/usr/bin/grep -a '^leaked=' "$lout")); it must not be bound in the enclosing scope"
  fi

  checked=$((checked + 1))
  engines="${engines:+$engines,}$mode"
done

[ "$checked" -gt 0 ] || oops "no engine was exercised"
printf 'PASS — %d engine setting(s) checked: %s — for-loop variables are scoped to the loop: outer bindings survive intact and the loop variable does not leak\n' "$checked" "$engines"
exit 0
