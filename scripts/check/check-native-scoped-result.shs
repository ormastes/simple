#!/bin/sh
# Execute a prebuilt test/fixtures/test_runner_scoped_result/main.spl.
# Keep this gate outside the test runner whose startup depends on process capture.
set -eu
if [ "$#" -ne 2 ] || [ "$1" != --binary ] || [ ! -x "$2" ]; then
    echo "usage: $0 --binary <native-scoped-result-regression>" >&2
    exit 2
fi
binary=$2
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
work=$(mktemp -d "${TMPDIR:-/tmp}/native-scoped-result.XXXXXX")
trap '[ "${SIMPLE_NATIVE_SCOPED_KEEP_WORK:-0}" = 1 ] || rm -rf "$work"' EXIT HUP INT TERM
export TMPDIR=$work
export SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB=1048576
export SIMPLE_PROCESS_TREE_RSS_RECEIPT=$work/process.rss.env
set +e
sh "$repo/scripts/bootstrap/run-process-group-timeout.shs" 30 2 "$binary" > "$work/stdout" 2> "$work/stderr"
status=$?
set -e
cat "$work/stdout"
if [ "$status" -ne 0 ]; then
    cat "$work/stderr" >&2
    echo "FAIL native scoped result: executable exit=$status; evidence=$work" >&2
    exit 1
fi
for case_name in normal-exit-zero-not-limited exit-seven-not-limited missing-command-fails actual-timeout-remains-limited wrapped-normal-exit-zero wrapped-exit-seven wrapped-missing-fails wrapped-timeout-remains-limited wrapper-error-remains-error; do
    if ! grep -Fx "PASS $case_name" "$work/stdout" >/dev/null; then
        echo "FAIL native scoped result: missing case $case_name; evidence=$work" >&2
        exit 1
    fi
done
if grep '^FAIL ' "$work/stdout" >/dev/null || ! grep -Fx 'SCOPED_RESULT_REGRESSION failures=0' "$work/stdout" >/dev/null; then
    echo "FAIL native scoped result: invalid regression summary; evidence=$work" >&2
    exit 1
fi
echo "PASS native scoped result: 9 cases; binary=$binary; evidence=$work"
