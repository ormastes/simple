#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
. "$root/scripts/check/lib/bootstrap-planner-admission-bound.shs"
[ "$#" -eq 1 ] || { echo "usage: $0 RECEIPT" >&2; exit 2; }
receipt=$1
case "$receipt" in /*) ;; *) receipt="$PWD/$receipt" ;; esac
bootstrap_planner_v2_verify "$receipt" "$root" || {
    echo "bootstrap-policy-error: planner-admission-v2-invalid" >&2
    exit 64
}
echo "bootstrap-policy: planner-admission-v2-valid execution=not-attempted"
