#!/bin/sh
# Regression gate for AOT (`native-build`) omitted TRAILING default
# parameters.
#
# WHY THIS EXISTS: `bin/simple test` hard-defaults to the tree-walk
# interpreter, which binds defaults correctly from `HirFunction.params`
# directly (backend/interpreter_calls.spl:193) -- so no `*_spec.spl` can ever
# observe this lane. Only a script that actually drives `native-build` can
# fence it.
#
# Bug: doc/08_tracking/bug/native_trailing_default_param_reads_uninitialized_2026-08-09.md
# Calling a function with fewer positional args than its arity left each
# omitted trailing defaulted parameter reading UNINITIALIZED STACK MEMORY,
# not its declared default -- garbage, not a consistent misbinding (the same
# slot read `false` for one call shape and `true` for another). The fix pads
# the call in MIR call lowering (`_MirLoweringExpr/switch_operators_calls.spl`
# `pad_trailing_default_args`, wired into every direct-call choke point:
# `emit_resolved_direct_call` for free functions/static methods, and the
# InstanceMethod/TraitMethod/FreeFunction(UFCS)/Unresolved-custom-owner
# method-call arms in `method_calls_literals.spl`).
#
# This fixture deliberately covers every call SHAPE the predecessor fix
# (`35.semantics/resolve.spl fill_call_defaults`, proven NEVER CALLED under
# native-build) missed or never attempted:
#   - same-module free function, 2 different arities omitted
#   - CROSS-MODULE free function, with a default that is a CALL expression
#     (`computed: i64 = dep_seven()`) and one that is a CONST expression
#     (`expr: i64 = 3 * 5 + 1`), not just a literal
#   - instance METHOD (receiver + synthetic `self` param alignment)
#   - static METHOD
#   - TRAIT method (receiver's STATIC type is the trait, e.g. a trait-typed
#     local variable, not the concrete class -- resolves through the
#     `TraitMethod` MIR arm, not `InstanceMethod`; this closes the "code path
#     patched, not fixture-exercised" gap noted when the fix landed)
#
# Only the DECLARED DEFAULT is asserted, never a specific wrong value --
# uninitialized memory is garbage, not a consistent misbinding, so asserting
# a particular garbage value would be flaky in either direction.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

SIMPLE_BINARY="${SIMPLE_BINARY:-bin/simple}"
WORK_DIR="${WORK_DIR:-/tmp/check-native-trailing-default-param.$$}"
FIXTURE="test/fixtures/native_trailing_default_param/main.spl"
EXPECTED="local a=1 s=false t=12
local a=1 s=true t=12
cross tag=41 flag=false computed=7 expr=16
bump step=1 loud=false extra=99
stat a=2 b=55 c=false
greet name=Bob loud=false times=1"

test -x "$SIMPLE_BINARY"
mkdir -p "$WORK_DIR"
KEPT_LOG="/tmp/check-native-trailing-default-param.last.log"
trap 'rm -rf "$WORK_DIR"' EXIT HUP INT TERM

binary="$WORK_DIR/trailing-default-param"
log="$WORK_DIR/trailing-default-param.log"

set +e
env -u SIMPLE_BOOTSTRAP SIMPLE_NO_STUB_FALLBACK=1 \
    "$SIMPLE_BINARY" native-build \
    --source test/fixtures --entry-closure --entry "$FIXTURE" \
    --cache-dir "$WORK_DIR/cache" --output "$binary" >"$log" 2>&1
build_rc=$?
set -e

if [ "$build_rc" -ne 0 ]; then
    cp "$log" "$KEPT_LOG" 2>/dev/null || true
    echo "FAIL — native-build failed to compile the fixture (exit $build_rc, log saved to $KEPT_LOG)"
    tail -n 60 "$log" | sed 's/^/    /'
    exit 1
fi

set +e
out="$(timeout 60 "$binary" 2>>"$log")"
run_rc=$?
set -e

if [ "$run_rc" -ne 0 ]; then
    cp "$log" "$KEPT_LOG" 2>/dev/null || true
    echo "FAIL — compiled binary exited $run_rc (log saved to $KEPT_LOG)"
    tail -n 60 "$log" | sed 's/^/    /'
    exit 1
fi

if [ "$out" != "$EXPECTED" ]; then
    cp "$log" "$KEPT_LOG" 2>/dev/null || true
    echo "FAIL — native-build omitted-trailing-default-parameter regression (log saved to $KEPT_LOG)"
    echo "  expected:"
    echo "$EXPECTED" | sed 's/^/    /'
    echo "  actual:"
    echo "$out" | sed 's/^/    /'
    exit 1
fi

echo "PASS — native-build omitted trailing default parameters: free/cross-module/instance-method/static-method/trait-method all bind the declared default"
