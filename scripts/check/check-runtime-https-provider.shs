#!/bin/sh
# Optional live HTTPS smoke for a supplied staged Rust runtime provider.
set -eu

REPO_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
PROVIDER="${SIMPLE_RUNTIME_WM_PATH:-}"
# Endpoint overrides are DNS host names only, without scheme, port, or path.
TRUSTED_HOST="${SIMPLE_RUNTIME_HTTPS_TRUSTED_HOST:-example.com}"
INVALID_CERT_HOST="${SIMPLE_RUNTIME_HTTPS_INVALID_CERT_HOST:-expired.badssl.com}"
REQUIRED="${SIMPLE_RUNTIME_HTTPS_REQUIRED:-0}"

skip_or_fail() {
  if [ "$REQUIRED" = "1" ]; then
    echo "STATUS: FAIL $1" >&2
    exit 1
  fi
  echo "STATUS: SKIP $1"
  exit 0
}

if [ "$PROVIDER" = "" ]; then
  skip_or_fail "SIMPLE_RUNTIME_WM_PATH is not set"
fi
if [ ! -f "$PROVIDER" ]; then
  skip_or_fail "runtime provider is not a file: $PROVIDER"
fi
if ! command -v "${CC:-cc}" >/dev/null 2>&1; then
  skip_or_fail "C compiler is unavailable"
fi
if ! command -v timeout >/dev/null 2>&1; then
  skip_or_fail "timeout command is unavailable"
fi

case "$TRUSTED_HOST" in
  ""|*[!A-Za-z0-9.-]*) skip_or_fail "invalid trusted DNS host: $TRUSTED_HOST" ;;
esac
case "$INVALID_CERT_HOST" in
  ""|*[!A-Za-z0-9.-]*) skip_or_fail "invalid invalid-certificate DNS host: $INVALID_CERT_HOST" ;;
esac

BUILD_DIR="$(mktemp -d "${TMPDIR:-/tmp}/simple-https-provider.XXXXXX")"
cleanup() {
  rm -rf -- "$BUILD_DIR"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM
BIN="$BUILD_DIR/rt_browser_http_job_provider_selfcheck"
PROVIDER_DIR="$(CDPATH= cd -- "$(dirname -- "$PROVIDER")" && pwd)"
PROVIDER="$PROVIDER_DIR/$(basename -- "$PROVIDER")"
"${CC:-cc}" -std=gnu11 -Wall -Wextra -Werror \
  "$REPO_ROOT/src/runtime/test/rt_browser_http_job_provider_selfcheck.c" \
  -Wl,--no-as-needed "$PROVIDER" \
  -Xlinker -rpath -Xlinker "$PROVIDER_DIR" \
  -lpthread -ldl -lm -o "$BIN.new"
mv "$BIN.new" "$BIN"

set +e
timeout 25s "$BIN" "$TRUSTED_HOST" "$INVALID_CERT_HOST"
RESULT=$?
set -e
if [ "$RESULT" -eq 77 ]; then
  skip_or_fail "HTTPS endpoint unavailable; see harness diagnostic"
fi
if [ "$RESULT" -ne 0 ]; then
  echo "STATUS: FAIL runtime HTTPS provider" >&2
  exit "$RESULT"
fi
echo "STATUS: PASS runtime HTTPS provider"
