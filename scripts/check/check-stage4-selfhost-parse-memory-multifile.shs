#!/bin/sh
# Multi-file regression guard for
# doc/08_tracking/bug/bootstrap_stage4_selfhost_parse_memory_blowup_2026-07-20.md
#
# The sibling script (check-stage4-selfhost-parse-memory.shs) targets the
# CONFIRMED single-file O(N^2) time mechanism (one large synthetic file).
# This script targets the mission's other, DECISIVE finding: real-corpus
# per-file `rt_heap_registry_count()` (a genuine live-object set, not a
# monotonic counter -- see the bug doc) climbs ~85-105K objects/file,
# essentially linearly, and does NOT flatten across files -- i.e. the
# self-hosted compiler's own flat-AST arenas (stmt_*/expr_*/decl_*,
# compiler.core.parser_decls) are retained forever instead of being freed
# once a file's Module is built and its arena slots are no longer needed.
# A single huge file cannot catch this: it's a MULTI-file accumulation, so
# this guard compiles a FIXED, small, deterministic N-file *chain*
# (mod0 imported by mod1 imported by mod2 ... entry = mod(N-1)) via
# --entry-closure and samples one peak-RSS number for the whole build.
#
# The source-matched compiler emits one `phase2:surface:file:released` marker
# per physical source. This gate bounds both registry growth between those
# markers and whole-build peak RSS, so a missing release or a late live-set
# climb fails before a full CLI admission build consumes the host.
# The canonical bootstrap producer must also write the adjacent provenance
# manifest documented in doc/03_plan/sys_test/stage4_streaming_live_slope.md.
#
# Ceilings are calibrated with generous headroom (defect-class tripwire,
# not a tight perf budget). Override via env for local tuning.
set -eu

REPO_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)"
cd "$REPO_ROOT"
BOOTSTRAP_STAGE3_FACADE_PATH="$REPO_ROOT/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="$REPO_ROOT/scripts/check/lib/stage4-candidate-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"
ROOT="${STAGE4_PARSE_MEM_MULTI_ROOT:-build/check-stage4-parse-memory-multifile}"
FILE_COUNT="${STAGE4_PARSE_MEM_MULTI_FILES:-40}"
FUNCS_PER_FILE="${STAGE4_PARSE_MEM_MULTI_FUNCS_PER_FILE:-20}"
TIME_MAX_S="${STAGE4_PARSE_MEM_MULTI_TIME_MAX_S:-120}"
VERSION_TIME_MAX_S="${STAGE4_PARSE_MEM_MULTI_VERSION_TIME_MAX_S:-10}"
# Calibrated 2026-07-21 against a real self-hosted binary (stage2 built from
# this doc's own worktree HEAD): 40 files x 20 funcs/file -> ~132-136MB peak
# RSS. ~3x headroom, not a tight budget -- this is a defect-class tripwire
# (catch a 64GB-class blowup, or any multi-x regression), not a benchmark.
RSS_MAX_KIB="${STAGE4_PARSE_MEM_MULTI_RSS_MAX_KIB:-409600}"
REGISTRY_AVG_GROWTH_MAX="${STAGE4_PARSE_MEM_MULTI_REGISTRY_AVG_GROWTH_MAX:-25000}"
REGISTRY_STEP_GROWTH_MAX="${STAGE4_PARSE_MEM_MULTI_REGISTRY_STEP_GROWTH_MAX:-100000}"
# Same landmine as the sibling script: bin/simple's ad-hoc
# `native-build --entry <file>` path was broken as of 2026-07-20
# (content-independent "function expects 2 argument(s)" error) -- override
# with a known-working self-hosted binary until that's fixed. Must NOT be
# the Rust seed (bin/simple_seed): this bug is self-hosted-binary-only, the
# seed's own Rust parser does not reproduce it.
SIMPLE_BIN="${STAGE4_PARSE_MEM_MULTI_BINARY:-bin/simple}"
PROVENANCE="${STAGE4_PARSE_MEM_MULTI_PROVENANCE:-}"

surface_marker_metrics() (
  raw_log="$1"
  expected_root="$2"
  expected_count="$3"
  awk '{ gsub(/\\n/, "\n"); print }' "$raw_log" |
    awk -v expected="$expected_count" -v root="$expected_root" '
      /phase2:surface:file:released/ {
        lines++
        path = ""
        seq = -1
        value = -1
        for (i = 1; i <= NF; i++) {
          if ($i ~ /^path=/) path = substr($i, 6)
          else if ($i ~ /^seq=[0-9]+$/) { split($i, pair, "="); seq = pair[2] + 0 }
          else if ($i ~ /^heap_registry=[0-9]+$/) { split($i, pair, "="); value = pair[2] + 0 }
        }
        if (path == "" || seq < 1 || value < 0) { invalid++; next }
        parts = split(path, component, "/")
        base = component[parts]
        file_index = base
        if (base !~ /^mod[0-9]+[.]spl$/) invalid++
        else {
          sub(/^mod/, "", file_index)
          sub(/[.]spl$/, "", file_index)
          if ((file_index + 0) < 0 || (file_index + 0) >= expected || path != root "/mod" file_index ".spl") invalid++
        }
        if (seq != lines || seq > expected) invalid++
        if (seen_seq[seq]++ > 0) duplicate++
        if (seen_path[path]++ > 0) duplicate++
        valid++
        if (valid == 1) first = value
        if (valid > 1) { delta = value - previous; if (delta > max_step) max_step = delta }
        previous = value
        last = value
      }
      END {
        average = valid > 1 ? int((last - first) / (valid - 1)) : 0
        printf "%d %d %d %d %d %d %d\n", lines, first, last, average, max_step, duplicate, invalid
      }
    '
)

self_test() {
  work="$(mktemp -d)"
  trap 'rm -rf "$work"' EXIT INT TERM
  gen="$work/gen"
  mkdir -p "$gen" "$work/other"
  good="$work/good.log"
  duplicate="$work/duplicate.log"
  wrong_dir="$work/wrong-dir.log"
  i=0
  while [ "$i" -lt 4 ]; do
    seq=$((i + 1))
    printf '%s\\n\n' "phase2:surface:file:released path=$gen/mod${i}.spl seq=$seq heap_registry=$((100000 + seq * 1000))" >>"$good"
    i=$((i + 1))
  done
  cp "$good" "$duplicate"
  printf '%s\\n\n' "phase2:surface:file:released path=$gen/mod0.spl seq=4 heap_registry=104000" >>"$duplicate"
  sed "s|$gen/mod3.spl|$work/other/mod3.spl|" "$good" >"$wrong_dir"

  [ "$(surface_marker_metrics "$good" "$gen" 4)" = "4 101000 104000 1000 1000 0 0" ] || {
    echo "error=self_test_good_marker_fixture_failed"
    exit 1
  }
  set -- $(surface_marker_metrics "$duplicate" "$gen" 4)
  [ "$6" -gt 0 ] || { echo "error=self_test_duplicate_marker_fixture_accepted"; exit 1; }
  set -- $(surface_marker_metrics "$wrong_dir" "$gen" 4)
  [ "$7" -gt 0 ] || { echo "error=self_test_wrong_directory_fixture_accepted"; exit 1; }

  lane="$work/lane"
  platform=x86_64-unknown-linux-gnu
  parent="$lane/stage3/$platform/simple"
  binary="$lane/full/$platform/simple"
  build_log="$lane/logs/$platform/stage4-native-build.log"
  smoke_log="$lane/logs/$platform/stage4-essential-tools-smoke.log"
  manifest="$lane/stage3/$platform/provenance.env"
  mkdir -p "$(dirname -- "$parent")" "$(dirname -- "$binary")" "$(dirname -- "$build_log")"
  : >"$parent"
  : >"$binary"
  printf 'platform=%s\noutput_path=%s\n' "$platform" "$parent" >"$manifest"
  printf '[fixture] stage4-native-build\ncwd: %s\ncommand: bootstrap_native_build_main %s %s\n' \
    "$REPO_ROOT" "$parent" "$binary" >"$build_log"
  {
    printf '[fixture] stage4-essential-tools-smoke\ncwd: %s\n' "$REPO_ROOT"
    printf 'command: run_timeout_kill 180 env SIMPLE_BINARY=%s sh scripts/check/check-bootstrap-essential-tools-smoke.shs\n' "$binary"
    printf '%s\n' essential_tools_pure_simple_identity=true \
      essential_test_runner_smoke=true essential_lint_smoke=true \
      essential_duplicate_checker_smoke=true bootstrap_essential_tools_smoke=true
  } >"$smoke_log"
  stage4_validate_candidate_lane "$binary" "$manifest" "$REPO_ROOT" "$build_log" "$smoke_log" || {
    echo "error=self_test_candidate_lane_fixture_failed"
    exit 1
  }
  cp "$smoke_log" "$smoke_log.good"
  sed '/essential_lint_smoke=true/d' "$smoke_log.good" >"$smoke_log"
  if stage4_validate_candidate_lane "$binary" "$manifest" "$REPO_ROOT" "$build_log" "$smoke_log"; then
    echo "error=self_test_missing_smoke_receipt_accepted"
    exit 1
  fi
  mv "$smoke_log.good" "$smoke_log"
  if stage4_validate_candidate_lane "$work/outside-simple" "$manifest" "$REPO_ROOT" "$build_log" "$smoke_log"; then
    echo "error=self_test_noncanonical_candidate_lane_accepted"
    exit 1
  fi
  echo "STATUS: PASS stage4-streaming-live-slope self-test"
}

case "${1:-}" in
  --self-test) self_test; exit 0 ;;
  "") ;;
  *) echo "usage: $0 [--self-test]"; exit 2 ;;
esac

case "$FILE_COUNT" in ''|*[!0-9]*) echo "error=invalid_file_count"; exit 2 ;; esac
[ "$FILE_COUNT" -gt 1 ] || { echo "error=invalid_file_count (need >1 to exercise cross-file accumulation)"; exit 2; }
case "$FUNCS_PER_FILE" in ''|*[!0-9]*) echo "error=invalid_funcs_per_file"; exit 2 ;; esac
[ "$FUNCS_PER_FILE" -gt 0 ] || { echo "error=invalid_funcs_per_file"; exit 2; }
case "$VERSION_TIME_MAX_S" in ''|*[!0-9]*) echo "error=invalid_version_timeout"; exit 2 ;; esac
[ "$VERSION_TIME_MAX_S" -gt 0 ] || { echo "error=invalid_version_timeout"; exit 2; }
[ -x /usr/bin/time ] || { echo "error=gnu_time_required"; exit 2; }
command -v timeout >/dev/null 2>&1 || { echo "error=timeout_required"; exit 2; }
[ -x "$SIMPLE_BIN" ] || { echo "error=binary_missing:$SIMPLE_BIN"; exit 2; }
SIMPLE_BIN="$(bootstrap_stage3_canonical_file "$SIMPLE_BIN")" || { echo "error=invalid_binary_path:$SIMPLE_BIN"; exit 2; }
PROVENANCE="${PROVENANCE:-${SIMPLE_BIN}.provenance.env}"
stage4_verify_candidate_provenance "$PROVENANCE" "$SIMPLE_BIN" "$REPO_ROOT" || {
  echo "error=invalid_stage4_candidate_provenance:$PROVENANCE"
  exit 2
}
PROVENANCE="$(bootstrap_stage3_canonical_file "$PROVENANCE")"

rm -rf "$ROOT"
mkdir -p "$ROOT/gen"
ROOT="$(CDPATH= cd -- "$ROOT" && pwd -P)"
GEN_ROOT="$ROOT/gen"

binary_sha256="$(bootstrap_stage3_hash_file "$SIMPLE_BIN")" || { echo "error=binary_sha256_failed"; exit 2; }
provenance_sha256="$(bootstrap_stage3_hash_file "$PROVENANCE")" || { echo "error=provenance_sha256_failed"; exit 2; }
source_revision_kind="$(bootstrap_stage3_manifest_value source_revision_kind "$PROVENANCE")"
source_revision_before="$(bootstrap_stage3_manifest_value source_revision "$PROVENANCE")"

set +e
timeout -k 5s "${VERSION_TIME_MAX_S}s" "$SIMPLE_BIN" --version >"$ROOT/version.log" 2>&1
version_status=$?
set -e
case "$version_status" in 124|137) echo "error=version_timed_out_after_${VERSION_TIME_MAX_S}s"; exit 2 ;; esac
[ "$version_status" -eq 0 ] || { echo "error=version_failed:$version_status"; exit 2; }
[ -s "$ROOT/version.log" ] || { echo "error=version_empty"; exit 2; }
if grep -Eiq 'Rust-built|Rust bootstrap seed|bootstrap seed only|debug build' "$ROOT/version.log"; then
  echo "error=selfhost_binary_required"
  exit 2
fi
[ "$(bootstrap_stage3_hash_file "$SIMPLE_BIN")" = "$binary_sha256" ] || { echo "error=binary_changed_after_version"; exit 2; }

# mod0 has no imports; mod(i) for i>0 imports mod(i-1) and re-exposes one of
# its functions, so --entry-closure from the last file transitively reaches
# exactly $FILE_COUNT files -- deterministic, no repo-root scan.
i=0
while [ "$i" -lt "$FILE_COUNT" ]; do
  f="$GEN_ROOT/mod${i}.spl"
  : > "$f"
  if [ "$i" -gt 0 ]; then
    prev=$((i - 1))
    printf 'use gen.mod%d.{parsemem_multi_f_%d_0}\n' "$prev" "$prev" >>"$f"
  fi
  j=0
  while [ "$j" -lt "$FUNCS_PER_FILE" ]; do
    printf 'fn parsemem_multi_f_%d_%d() -> i64:\n    val a = %d\n    val b = %d\n    a + b\n\n' "$i" "$j" "$j" "$j" >>"$f"
    j=$((j + 1))
  done
  i=$((i + 1))
done
last=$((FILE_COUNT - 1))
printf 'fn main() -> i64:\n    parsemem_multi_f_%d_0()\n' "$last" >>"$GEN_ROOT/mod${last}.spl"

set +e
/usr/bin/time -f "%M" -o "$ROOT/max-rss-kib" \
  timeout -k 5s "${TIME_MAX_S}s" env \
    SIMPLE_BOOTSTRAP=1 SIMPLE_BOOTSTRAP_STAGE4=1 \
    SIMPLE_BOOTSTRAP_LOW_MEMORY=1 SIMPLE_STAGE4_STREAMING_SURFACES=1 SIMPLE_NATIVE_ARENA_DECLS=1 \
    SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE=1 SIMPLE_COMPILER_PHASE_PROFILE=1 \
    SIMPLE_NO_STUB_FALLBACK=1 \
    "$SIMPLE_BIN" native-build \
    --target x86_64-unknown-linux-gnu --backend cranelift --runtime-bundle core-c-bootstrap \
    --source "$GEN_ROOT" --entry-closure --low-memory --threads 1 --mode dynload \
    --cache-dir "$ROOT/cache" \
    --entry "$GEN_ROOT/mod${last}.spl" -o "$ROOT/out.bin" \
    >"$ROOT/output.log" 2>"$ROOT/error.log"
status=$?
set -e

if [ "$status" -eq 124 ] || [ "$status" -eq 137 ]; then
  echo "error=timed_out_after_${TIME_MAX_S}s (multi-file parse-memory regression signature -- see doc/08_tracking/bug/bootstrap_stage4_selfhost_parse_memory_blowup_2026-07-20.md)"
  tail -n 20 "$ROOT/error.log" || true
  exit 1
fi
if grep -Eq '\[stmt_get_tag\] OOB|\[flat-bridge\] missing (stmt|expr) tag' "$ROOT/output.log" "$ROOT/error.log"; then
  echo "error=stale_flat_ast_index"
  exit 1
fi

max_rss_kib="$(sed -n '1p' "$ROOT/max-rss-kib" 2>/dev/null || echo 0)"
case "$max_rss_kib" in ''|*[!0-9]*) max_rss_kib=0 ;; esac
[ "$max_rss_kib" -gt 0 ] || { echo "error=no_rss_sample"; cat "$ROOT/error.log" || true; exit 2; }

if [ "$status" -ne 0 ]; then
  echo "error=native_build_failed:$status (peak_rss_kib=$max_rss_kib -- if this is a compile error unrelated to memory, the guard's synthetic chain may need updating, not the ceilings)"
  tail -n 20 "$ROOT/error.log" || true
  exit 1
fi
[ -f "$ROOT/out.bin" ] || { echo "error=native_output_missing"; exit 1; }
[ "$(bootstrap_stage3_hash_file "$SIMPLE_BIN")" = "$binary_sha256" ] || { echo "error=binary_changed_after_build"; exit 1; }
[ "$(bootstrap_stage3_hash_file "$PROVENANCE")" = "$provenance_sha256" ] || { echo "error=provenance_changed_during_build"; exit 1; }
[ "$(stage4_source_revision "$REPO_ROOT")" = "$source_revision_before" ] || { echo "error=source_changed_during_build"; exit 1; }

metrics="$(surface_marker_metrics "$ROOT/error.log" "$GEN_ROOT" "$FILE_COUNT")" || { echo "error=surface_release_marker_parse_failed"; exit 1; }
set -- $metrics
[ "$#" -eq 7 ] || { echo "error=surface_release_marker_metrics_missing"; exit 1; }
marker_count="$1"
registry_first="$2"
registry_last="$3"
registry_average_growth="$4"
registry_max_step_growth="$5"
marker_duplicate_count="$6"
marker_invalid_count="$7"

[ "$marker_count" -eq "$FILE_COUNT" ] || {
  echo "error=surface_release_marker_count:$marker_count expected:$FILE_COUNT"
  exit 1
}
[ "$marker_duplicate_count" -eq 0 ] && [ "$marker_invalid_count" -eq 0 ] || {
  echo "error=surface_release_marker_invalid duplicates:$marker_duplicate_count invalid:$marker_invalid_count"
  exit 1
}
[ "$registry_average_growth" -le "$REGISTRY_AVG_GROWTH_MAX" ] || {
  echo "error=registry_average_growth:$registry_average_growth exceeds:$REGISTRY_AVG_GROWTH_MAX"
  exit 1
}
[ "$registry_max_step_growth" -le "$REGISTRY_STEP_GROWTH_MAX" ] || {
  echo "error=registry_max_step_growth:$registry_max_step_growth exceeds:$REGISTRY_STEP_GROWTH_MAX"
  exit 1
}

[ "$max_rss_kib" -lt "$RSS_MAX_KIB" ] || {
  echo "error=peak_rss_kib:$max_rss_kib exceeds ceiling $RSS_MAX_KIB over $FILE_COUNT files"
  exit 1
}

echo "stage4_parse_memory_multifile_file_count=$FILE_COUNT"
echo "stage4_parse_memory_multifile_funcs_per_file=$FUNCS_PER_FILE"
echo "stage4_parse_memory_multifile_max_rss_kib=$max_rss_kib"
echo "stage4_parse_memory_multifile_surface_release_markers=$marker_count"
echo "stage4_parse_memory_multifile_registry_first=$registry_first"
echo "stage4_parse_memory_multifile_registry_last=$registry_last"
echo "stage4_parse_memory_multifile_registry_average_growth=$registry_average_growth"
echo "stage4_parse_memory_multifile_registry_max_step_growth=$registry_max_step_growth"
echo "stage4_parse_memory_multifile_marker_duplicates=$marker_duplicate_count"
echo "stage4_parse_memory_multifile_marker_invalid=$marker_invalid_count"
echo "stage4_parse_memory_multifile_binary_sha256=$binary_sha256"
echo "stage4_parse_memory_multifile_source_revision_kind=$source_revision_kind"
echo "stage4_parse_memory_multifile_source_revision=$source_revision_before"
echo "stage4_parse_memory_multifile_provenance_sha256=$provenance_sha256"
echo "stage4_parse_memory_multifile_status=pass"
echo "PASS — $FILE_COUNT-file chain ($FUNCS_PER_FILE funcs/file) built in <=${TIME_MAX_S}s: peak_rss_kib=$max_rss_kib (ceiling $RSS_MAX_KIB), $marker_count surface-release markers (0 dup/invalid), registry avg_growth=$registry_average_growth max_step=$registry_max_step_growth"
