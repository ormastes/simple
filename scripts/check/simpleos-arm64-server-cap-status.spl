use os.apps.servers_user.database_persistence_adapter.{
    simpleos_database_persistence_caps_for,
    simpleos_database_persistence_ready,
    simpleos_database_persistence_blocker
}

fn main():
    # 31 is the frozen target runtime ABI bitset. The payload nm gate proves
    # every concrete provider separately; this pure function prevents a host
    # interpreter from accidentally answering for the target extern.
    val caps = simpleos_database_persistence_caps_for(31)
    print "schema=SimpleOsArm64ServerPersistenceCapsV1"
    print "exclusive_create={caps.exclusive_create}"
    print "bounded_lock_wait={caps.bounded_lock_wait}"
    print "private_temp_write={caps.private_temp_write}"
    print "durable_file_sync={caps.durable_file_sync}"
    print "runtime_rename_owner_linked={caps.runtime_rename_owner_linked}"
    print "atomic_replace_rename={caps.atomic_replace_rename}"
    print "crash_recovery={caps.crash_recovery}"
    print "ready={simpleos_database_persistence_ready(caps)}"
    print "blocker={simpleos_database_persistence_blocker(caps)}"
