#!/bin/sh
# Build target-native filesystem artifacts for the SimpleOS web and DB servers.
#
# This gate proves only that both artifacts were built for the SimpleOS ring-3
# loader ABI. It does not stage media, boot SimpleOS, or claim either server is
# runnable. The two artifacts are published atomically only after both pass.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
cd "$ROOT"

fail() { printf 'FAIL simpleos_server_artifacts %s\n' "$*" >&2; exit 1; }
need_file() { [ -f "$1" ] && [ ! -L "$1" ] || fail "missing_regular_file=$1"; }
need_exec() { [ -x "$1" ] || fail "missing_executable=$1"; }
sha() { sha256sum "$1" | awk '{print $1}'; }

COMPILER=${1:-"$ROOT/bin/simple"}
OUT_DIR=${2:-"$ROOT/build/simpleos-server-artifacts/x86_64"}
TARGET=x86_64-unknown-simpleos
BACKEND=${SIMPLEOS_SERVER_BACKEND:-cranelift}
SYSROOT=${SIMPLEOS_SERVER_SYSROOT:-"$ROOT/build/os/sysroot"}
RUNTIME=${SIMPLEOS_SERVER_RUNTIME:-"$ROOT/build/os/simple-core-simpleos/libsimple_runtime.a"}
LINKER_SCRIPT="$SYSROOT/share/simpleos/simpleos.ld"
CRT0="$SYSROOT/lib/crt0.o"
LIBC="$SYSROOT/lib/libsimpleos_c.a"
WEB_ENTRY="$ROOT/src/app/simple_web_server/main.spl"
DB_ENTRY="$ROOT/src/app/postgres_mimic_server/main.spl"
TCP_ADAPTER="$ROOT/examples/09_embedded/simple_os/arch/x86_64/boot/rt_extras.c"
TCP_OWNER="$ROOT/examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c"

command -v readelf >/dev/null 2>&1 || fail missing_tool=readelf
command -v sha256sum >/dev/null 2>&1 || fail missing_tool=sha256sum
need_exec "$COMPILER"
COMPILER=$(readlink -f "$COMPILER") || fail compiler_path_unresolvable
need_exec "$COMPILER"
for input in "$RUNTIME" "$LINKER_SCRIPT" "$CRT0" "$LIBC" "$WEB_ENTRY" "$DB_ENTRY" "$TCP_ADAPTER" "$TCP_OWNER"; do
    need_file "$input"
done

case "$BACKEND" in cranelift|llvm) ;; *) fail "unsupported_backend=$BACKEND" ;; esac
grep -Eq 'ENTRY[[:space:]]*\([[:space:]]*_start[[:space:]]*\)' "$LINKER_SCRIPT" ||
    fail "linker_entry_not_start=$LINKER_SCRIPT"
grep -Eq '0x40000000' "$LINKER_SCRIPT" ||
    fail "linker_user_base_not_0x40000000=$LINKER_SCRIPT"

# The pure-Simple runtime archive and architecture C providers are separate
# inputs to native-build. Pin the providers here; validate their definitions
# in the final ELF below, after native-build has composed both layers.
grep -Fq 'RuntimeValue rt_io_tcp_bind_fd(' "$TCP_ADAPTER" ||
    fail "tcp_adapter_missing_bind_bridge=$TCP_ADAPTER"
grep -Fq 'int64_t rt_net_bind(' "$TCP_OWNER" ||
    fail "tcp_owner_missing_bind_provider=$TCP_OWNER"

# The filesystem launcher supplies the nonce at runtime.  Keep the build gate
# coupled to the explicit target profiles so a hosted-default artifact cannot
# accidentally be promoted as a SimpleOS daemon.
grep -Fq 'if parsed.config.simpleos:' "$WEB_ENTRY" || fail web_entry_missing_simpleos_profile
grep -Fq 'path=/SYS/APPS/WEBSRV.SMF launch_id=' "$WEB_ENTRY" || fail web_entry_missing_launch_identity
grep -Fq 'config.worker_count = 1' "$ROOT/src/app/simple_web_server/config.spl" || fail web_profile_not_single_worker
grep -Fq 'pg_has_flag(args, "--simpleos")' "$DB_ENTRY" || fail db_entry_missing_simpleos_profile
grep -Fq 'path=/SYS/APPS/DBSRV.SMF launch_id=' "$DB_ENTRY" || fail db_entry_missing_launch_identity
grep -Fq 'server.serve_inline_bounded_status(max_connections)' "$DB_ENTRY" || fail db_profile_not_inline_bounded

. "$ROOT/scripts/lib/simple-compiler-select.shs"
simple_compiler_usable "$COMPILER" ||
    fail "compiler_not_admitted_pure_simple=$COMPILER"

validate_artifact() {
    role=$1
    artifact=$2
    need_file "$artifact"
    hdr=$(readelf -W -h "$artifact") || fail "${role}_readelf_header_failed"
    phdr=$(readelf -W -l "$artifact") || fail "${role}_readelf_program_headers_failed"
    printf '%s\n' "$hdr" | grep -Eq 'Class:[[:space:]]+ELF64' || fail "${role}_not_elf64"
    printf '%s\n' "$hdr" | grep -Eq 'Data:[[:space:]]+2.s complement, little endian' || fail "${role}_not_little_endian"
    printf '%s\n' "$hdr" | grep -Eq 'Type:[[:space:]]+EXEC' || fail "${role}_not_et_exec"
    printf '%s\n' "$hdr" | grep -Eq 'Machine:[[:space:]]+Advanced Micro Devices X86-64' || fail "${role}_wrong_machine"
    printf '%s\n' "$phdr" | grep -Eq '^[[:space:]]*LOAD.* E ' || fail "${role}_missing_executable_load"
    if printf '%s\n' "$phdr" | grep -Eq '^[[:space:]]*INTERP'; then
        fail "${role}_dynamic_interpreter_forbidden"
    fi
    dynamic=$(readelf -W -d "$artifact" 2>/dev/null || true)
    if printf '%s\n' "$dynamic" | grep -Eq '\(NEEDED\)|\(RPATH\)|\(RUNPATH\)'; then
        fail "${role}_host_dynamic_dependency_forbidden"
    fi
    symbols=$(readelf -W -s "$artifact" 2>/dev/null || true)
    if printf '%s\n' "$symbols" | awk '$7 == "UND" && $8 ~ /(@GLIBC_|^(__libc_|pthread_|dlopen$|dlsym$|fork$|execve$|epoll_|io_uring_|getenv$))/ { found=1 } END { exit !found }'; then
        fail "${role}_hosted_import_forbidden"
    fi
    for symbol in rt_io_tcp_socket_create rt_io_tcp_bind_fd rt_io_tcp_listen \
        rt_io_tcp_accept rt_io_tcp_read rt_io_tcp_write_bytes rt_io_tcp_close
    do
        printf '%s\n' "$symbols" | awk -v wanted="$symbol" '$7 != "UND" && $8 == wanted { found=1 } END { exit !found }' ||
            fail "${role}_elf_missing_simpleos_tcp_bridge_symbol=$symbol"
    done
    entry_hex=$(printf '%s\n' "$hdr" | awk '/Entry point address:/ { print $4 }')
    case "$entry_hex" in 0x4???????|0x[5-9a-fA-F]???????) ;; *) fail "${role}_entry_outside_simpleos_user_window=$entry_hex" ;; esac
}

mkdir -p "$OUT_DIR"
work=$(mktemp -d "${TMPDIR:-/tmp}/simpleos-server-artifacts.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM

build_one() {
    role=$1
    entry=$2
    output=$3
    cache="$work/cache-$role"
    mkdir -p "$cache"
    env -u SIMPLE_BOOTSTRAP -u SIMPLE_RUNTIME_PATH \
        SIMPLE_LIB="$ROOT/src" \
        SIMPLE_NO_STUB_FALLBACK=1 \
        SIMPLE_SIMPLE_CORE_PATH="$RUNTIME" \
        "$COMPILER" native-build \
        --backend "$BACKEND" \
        --runtime-bundle simple-core \
        --source "$ROOT/src/app" \
        --source "$ROOT/src/lib" \
        --entry-closure \
        --cache-dir "$cache" \
        --entry "$entry" \
        --target "$TARGET" \
        --cpu x86-64-v1 \
        --opt-level=aggressive \
        --linker-script "$LINKER_SCRIPT" \
        --output "$output" >"$work/$role.log" 2>&1 || {
            sed -n '1,160p' "$work/$role.log" >&2
            fail "${role}_target_native_build_failed"
        }
    if grep -Eq 'stub functions for unresolved symbols|falling back|fallback runtime' "$work/$role.log"; then
        fail "${role}_build_used_stub_or_fallback"
    fi
    validate_artifact "$role" "$output"
}

build_one web "$WEB_ENTRY" "$work/WEBSRV.SMF"
build_one db "$DB_ENTRY" "$work/DBSRV.SMF"

compiler_sha=$(sha "$COMPILER")
runtime_sha=$(sha "$RUNTIME")
linker_sha=$(sha "$LINKER_SCRIPT")
crt0_sha=$(sha "$CRT0")
libc_sha=$(sha "$LIBC")
tcp_adapter_sha=$(sha "$TCP_ADAPTER")
tcp_owner_sha=$(sha "$TCP_OWNER")

write_receipt() {
    role=$1
    entry=$2
    artifact=$3
    fs_path=$4
    receipt=$5
    launch_args=$6
    bytes=$(wc -c < "$artifact" | tr -d ' ')
    artifact_sha=$(sha "$artifact")
    cat >"$receipt" <<EOF
schema=simpleos-server-artifact-v2
status=artifact-built
role=$role
target=$TARGET
backend=$BACKEND
entry=$entry
entry_sha256=$(sha "$entry")
source_root_1=$ROOT/src/app
source_root_2=$ROOT/src/lib
entry_closure=true
runtime_bundle=simple-core
compiler_sha256=$compiler_sha
runtime_sha256=$runtime_sha
linker_script_sha256=$linker_sha
crt0_sha256=$crt0_sha
libc_sha256=$libc_sha
tcp_adapter_source=$TCP_ADAPTER
tcp_adapter_sha256=$tcp_adapter_sha
tcp_owner_source=$TCP_OWNER
tcp_owner_sha256=$tcp_owner_sha
tcp_bridge=std-io-to-simpleos-rt-net-v1
artifact_sha256=$artifact_sha
artifact_bytes=$bytes
filesystem_path=$fs_path
launch_profile=simpleos-single-worker-v1
launch_args=$launch_args
launch_id_source=simpleos.server_launch_nonce
format=elf64-et_exec-x86_64-static
loader_abi=simpleos-ring3-fs-exec-v1
staged=false
runnable=false
reason=live-staging-and-execution-not-observed
EOF
}

write_receipt web "$WEB_ENTRY" "$work/WEBSRV.SMF" /SYS/APPS/WEBSRV.SMF "$work/WEBSRV.SMF.receipt" \
    '--simpleos --launch-id ${simpleos.server_launch_nonce} --listen 0.0.0.0:8080 --workers 1 --backend cpu'
write_receipt db "$DB_ENTRY" "$work/DBSRV.SMF" /SYS/APPS/DBSRV.SMF "$work/DBSRV.SMF.receipt" \
    '--serve --simpleos --launch-id ${simpleos.server_launch_nonce} --listen 0.0.0.0:5432 --workers 1 --allow-user simpleos --allow-database simpleos'

# Publish only after both builds, validations, and receipts succeed.
for name in WEBSRV.SMF DBSRV.SMF WEBSRV.SMF.receipt DBSRV.SMF.receipt; do
    mv "$work/$name" "$OUT_DIR/$name"
done

printf 'PASS simpleos_server_artifacts status=artifact-built staged=false runnable=false out=%s\n' "$OUT_DIR"
