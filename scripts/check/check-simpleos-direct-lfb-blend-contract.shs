#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM

cc -std=c11 -O2 -Wall -Wextra -Werror \
    -I "$repo_root/examples/09_embedded/simple_os/arch/x86_64/boot" \
    "$repo_root/test/09_baselines/engine2d_simd/simpleos_direct_lfb_blend_contract_test.c" \
    -o "$work_dir/direct-lfb-contract"
if command -v /usr/bin/time >/dev/null 2>&1; then
    /usr/bin/time -f 'direct_lfb_contract max_rss_kb=%M elapsed_s=%e' \
        "$work_dir/direct-lfb-contract"
else
    "$work_dir/direct-lfb-contract"
fi
echo "PASS: provenance/malformed geometry/wrap/clipping reject before access; padded-pitch blend bounded"
