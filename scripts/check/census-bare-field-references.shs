#!/bin/sh
# Read-only census of bare-field-reference sites across src/ (Simple sources).
# NOT a guard/gate — informational only. Does not fix anything, not wired into
# any pipeline or CI. See doc/08_tracking/bug/bare_field_reference_in_methods_is_illegal_but_pervasive_2026-08-10.md
#
# The census run recorded in doc/08_tracking/test/bare_field_reference_sites_2026-08-10.tsv
# (1,550 candidate sites / 210 files, methodology + positive-control proof in the bug doc
# above) was produced by a one-off Python scanner. Per repo rule (.claude/rules/language.md:
# "ALL code in .spl or .shs — No Python"), that scanner has been removed rather than kept
# in-tree. This wrapper is left as a pointer to the methodology; re-running the census
# requires re-implementing the scan (per-class field collection, then word-boundary,
# non-self./me.-prefixed matches across if-cond/while-cond/return/assign-rhs/expr positions
# within each method body — see the bug doc's methodology section) in .spl/.shs.
echo "census scanner removed (no-Python rule) — see bug doc for methodology; TSV output is a static snapshot, not regenerable by this script" >&2
exit 1
