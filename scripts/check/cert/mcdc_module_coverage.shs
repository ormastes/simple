#!/bin/sh
set -u

# mcdc_module_coverage.shs — thin wrapper for the pure-Simple MC/DC module
# coverage tool (scripts/check/cert/mcdc_module_coverage.spl).
#
#   sh scripts/check/cert/mcdc_module_coverage.shs instrument --run gen src/compiler/30.types/type_infer/generic_calls.spl
#   sh scripts/check/cert/mcdc_module_coverage.shs run        --run gen test/01_unit/compiler/30.types
#   sh scripts/check/cert/mcdc_module_coverage.shs run        --run gen --in-place <specs>   # Rust seed (ignores SIMPLE_LIB)
#   sh scripts/check/cert/mcdc_module_coverage.shs report     --run gen
#   sh scripts/check/cert/mcdc_module_coverage.shs restore    --run gen                      # after an interrupted --in-place run
#
# Env:  SIMPLE_BIN  compiler binary used both to run the tool and (unless
#                   --bin is passed to `run`) to run the specs
#                   (default: bin/simple)

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd)
SIMPLE_BIN="${SIMPLE_BIN:-$REPO_ROOT/bin/simple}"
export SIMPLE_BIN

case "${1:-}" in --help|-h|"") sed -n '3,14p' "$0"; exit 2 ;; esac

cd "$REPO_ROOT" || exit 1
exec "$SIMPLE_BIN" run scripts/check/cert/mcdc_module_coverage.spl "$@"
