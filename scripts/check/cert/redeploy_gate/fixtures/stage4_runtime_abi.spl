# Stage4 runtime ABI fixture.  Text parameters are lowered to the current
# four-argument pointer/length rt_env_* ABI by the native backend.
extern fn rt_env_set(key: text, value: text) -> bool
extern fn rt_env_get(key: text) -> text
extern fn rt_env_remove(key: text) -> bool

fn main():
    val key = "__SIMPLE_STAGE4_RUNTIME_ENV_ABI__"
    val set_ok = rt_env_set(key, "stage4")
    val got = rt_env_get(key)
    val remove_ok = rt_env_remove(key)
    val after = rt_env_get(key)
    if set_ok and got == "stage4" and remove_ok and after == "":
        print("STAGE4_RUNTIME_ENV_ABI_OK")
    else:
        print("STAGE4_RUNTIME_ENV_ABI_FAIL")
