# Bootstrap producer regression: typed dictionary key iteration must retain heap handles.
struct CodecKey:
    id: i64

fn read_key(key: CodecKey) -> i64:
    key.id

fn sum_keys(entries: {CodecKey: i64}) -> i64:
    var keys: [CodecKey] = []
    if entries != nil:
        keys = entries.keys()
    var total: i64 = 0
    for key in keys:
        total = total + read_key(key)
    total

fn main():
    val entries: {CodecKey: i64} = {CodecKey(id: 17): 3, CodecKey(id: 25): 4}
    print sum_keys(entries)
    val empty: {CodecKey: i64} = {}
    print sum_keys(empty)
