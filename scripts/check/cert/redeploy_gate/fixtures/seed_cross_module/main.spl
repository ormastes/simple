# seed-native-build-invariant fixture, half 2 of 2 (reader module).
#
# Unlike p2_add.spl (a single file with no imports), this fixture spans TWO
# modules and reads a module-level global from owner.spl THROUGH a `use`
# import. That shape is exactly what regressed in d312b8e4253 ("defer lazy
# imports until first use"): the importing module got a fresh/empty instance
# of the owner module's globals instead of the shared one, so a broken seed
# either fails to native-build this file at all (expr_tag OOB parse error) or
# native-builds it but prints the wrong value (empty ITEMS -> index OOB /
# wrong sum) instead of the correct one.
#
# EXPECT stdout: 5

use owner.{owner_items}

fn main():
    val xs = owner_items()
    print(xs[0] + xs[1])
