#!/bin/sh

COMPILER_PROBE_TIMEOUT_SECONDS=${COMPILER_PROBE_TIMEOUT_SECONDS:-5}
COMPILER_BUILD_TIMEOUT_SECONDS=${COMPILER_BUILD_TIMEOUT_SECONDS:-180}
COMPILER_EXEC_TIMEOUT_SECONDS=${COMPILER_EXEC_TIMEOUT_SECONDS:-5}
COMPILER_CHECK_KILL_GRACE_SECONDS=${COMPILER_CHECK_KILL_GRACE_SECONDS:-1}

candidate_frontend_timeout_bin() {
    if command -v timeout >/dev/null 2>&1; then
        command -v timeout
    elif command -v gtimeout >/dev/null 2>&1; then
        command -v gtimeout
    else
        return 1
    fi
}

# Cap on the candidate's own build-log size. A dead lexer combined with a
# parser error-recovery loop that makes no forward progress emits the SAME line
# forever: on 2026-08-09 an admitted Stage-2 binary produced a 444 MB /
# 6,299,344-line log at 32 GB RSS before the run was killed by hand. Any
# candidate that emits more than this from a 2-line fixture is non-functional
# regardless of its exit status.
CANDIDATE_FRONTEND_MAX_LOG_BYTES=${CANDIDATE_FRONTEND_MAX_LOG_BYTES:-4194304}

candidate_frontend_executable_path() {
    case "$(uname -s 2>/dev/null || echo unknown)" in
        MSYS*|MINGW*|CYGWIN*) printf '%s.exe\n' "$1" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

candidate_frontend_hash_file() {
    sha256sum -- "$1" | awk '{ print $1 }'
}
candidate_frontend_procfd() {
    expr "$1" : '/proc/[1-9][0-9]*/fd/[1-9][0-9]*$' >/dev/null
}
candidate_frontend_procfd_leaf() {
    expr "$1" : '/proc/[1-9][0-9]*/fd/[1-9][0-9]*/[A-Za-z0-9_.-][A-Za-z0-9_.-]*$' >/dev/null
}

candidate_frontend_bounded_build() {
    bounded_probe=$1; shift
    candidate_frontend_procfd "${BOOTSTRAP_STAGE3_PERL_DESCRIPTOR:-}" || return 126
    candidate_frontend_procfd "${BOOTSTRAP_STAGE3_BOUNDED_LOG_DESCRIPTOR:-}" || return 126
    bounded_parent=${build_log%/*}
    bounded_base=${build_log##*/}
    [ "$bounded_parent/$bounded_base" = "$build_log" ] || return 126
    candidate_frontend_procfd "$bounded_parent" || return 126
    case "$bounded_probe" in
      p2_add) bounded_leaf=$bounded_base ;;
      stage2_mir_retention) bounded_leaf=$bounded_base.stage2-mir-retention ;;
      stage2_module_path_naming) bounded_leaf=$bounded_base.stage2-module-path-naming ;;
      hello_world_positional) bounded_leaf=$bounded_base.hello-world-positional ;;
      *) return 126 ;;
    esac
    bounded_log=$bounded_parent/$bounded_leaf
    bounded_receipt=$bounded_parent/$bounded_leaf.bounded.env
    if "$BOOTSTRAP_STAGE3_PERL_DESCRIPTOR" "$BOOTSTRAP_STAGE3_BOUNDED_LOG_DESCRIPTOR" \
        --output-parent="$bounded_parent" --log-leaf="$bounded_leaf" \
        --receipt-leaf="$bounded_leaf.bounded.env" \
        --max-bytes="$CANDIDATE_FRONTEND_MAX_LOG_BYTES" \
        --timeout-seconds="$COMPILER_BUILD_TIMEOUT_SECONDS" \
        --term-grace-seconds="$COMPILER_CHECK_KILL_GRACE_SECONDS" -- "$@"; then
        bounded_rc=0
    else
        bounded_rc=$?
    fi
    [ -f "$bounded_log" ] && [ -f "$bounded_receipt" ] || return 126
    [ "$(sed -n 's/^schema=//p' "$bounded_receipt")" = simple-bounded-process-log-v1 ] || return 126
    bounded_reason=$(sed -n 's/^reason=//p' "$bounded_receipt")
    bounded_raw=$(sed -n 's/^raw_status=//p' "$bounded_receipt")
    [ "$bounded_raw" = "$bounded_rc" ] || return 126
    [ "$(sed -n 's/^log_sha256=//p' "$bounded_receipt")" = \
        "$(candidate_frontend_hash_file "$bounded_log")" ] || return 126
    case "$bounded_reason:$bounded_rc" in
      child-exit:*) ;;
      child-signal:1[2-9][89]|child-signal:1[3-9][0-9]|child-signal:2[0-5][0-9]) ;;
      timeout:124|overflow:125|setup-failure:126|exec-failure:127|supervisor-signal:1[2-9][89]|supervisor-signal:1[3-9][0-9]|supervisor-signal:2[0-5][0-9]) ;;
      *) return 126 ;;
    esac
    bounded_last_reason=$bounded_reason
    return "$bounded_rc"
}

# candidate_frontend_smoke <candidate>
#
# CANDIDATE_FRONTEND_BOOTSTRAP selects the SIMPLE_BOOTSTRAP value the candidate
# is exercised under. This must be swept, not fixed: Stage 3 invokes the
# admitted Stage-2 binary with SIMPLE_BOOTSTRAP=1, but this gate only ever ran
# it with SIMPLE_BOOTSTRAP=0 -- and SIMPLE_BOOTSTRAP=1 is documented in this repo
# to change compiler behaviour drastically (vacuous `--native` emit; the `?`
# operator dropped entirely). So the gate certified a configuration Stage 3
# never uses. See
# doc/08_tracking/bug/stage2_binary_lexer_reads_every_source_as_empty_infinite_parser_loop_2026-08-09.md
candidate_frontend_smoke() (
    candidate=$1
    candidate_backend=${CANDIDATE_FRONTEND_BACKEND:-cranelift}
    candidate_bootstrap=${CANDIDATE_FRONTEND_BOOTSTRAP:-0}
    timeout_bin=$(candidate_frontend_timeout_bin || true)
    [ -n "$timeout_bin" ] || exit 1
    probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/simpleos-host-gpu-admission.XXXXXX") || exit 1
    trap 'rm -rf "$probe_dir"' 0
    trap 'exit 1' HUP INT TERM
    build_log=${CANDIDATE_FRONTEND_LOG_PATH:-$probe_dir/build.log}
    build_log_display=${CANDIDATE_FRONTEND_LOG_DISPLAY_PATH:-$build_log}
    status_path=${CANDIDATE_FRONTEND_STATUS_PATH:-}
    p2_add_log=$build_log
    stage2_mir_retention_log=$build_log.stage2-mir-retention
    stage2_module_path_naming_log=$build_log.stage2-module-path-naming
    hello_world_positional_log=$build_log.hello-world-positional
    p2_add_receipt=$p2_add_log.bounded.env
    stage2_mir_retention_receipt=$stage2_mir_retention_log.bounded.env
    stage2_module_path_naming_receipt=$stage2_module_path_naming_log.bounded.env
    hello_world_positional_receipt=$hello_world_positional_log.bounded.env
    p2_add_raw_status=not-run stage2_mir_retention_raw_status=not-run
    stage2_module_path_naming_raw_status=not-run hello_world_positional_raw_status=not-run
    candidate_frontend_finish() {
        result=$1
        probe=$2
        raw_status=$3
        [ -n "$status_path" ] || return 0
        candidate_frontend_procfd_leaf "$status_path" || return 126
        status_tmp="${status_path}.tmp.$$"
        {
            echo schema=simple-candidate-frontend-status-v2
            echo result="$result"
            echo probe="$probe"
            echo raw_status="$raw_status"
            echo bootstrap_mode="$candidate_bootstrap"
            echo backend="$candidate_backend"
            echo log_path="$build_log_display"
            for status_probe in p2_add stage2_mir_retention stage2_module_path_naming hello_world_positional; do
                eval "status_raw=\${${status_probe}_raw_status}"
                eval "status_log=\${${status_probe}_log}"
                eval "status_receipt=\${${status_probe}_receipt}"
                case "$status_probe" in
                  p2_add) status_log_display=$build_log_display ;;
                  stage2_mir_retention) status_log_display=$build_log_display.stage2-mir-retention ;;
                  stage2_module_path_naming) status_log_display=$build_log_display.stage2-module-path-naming ;;
                  hello_world_positional) status_log_display=$build_log_display.hello-world-positional ;;
                esac
                if [ "$status_raw" = not-run ]; then
                    status_log=-
                    status_receipt=-
                    status_log_display=-
                fi
                if [ "$status_log" != - ] && { [ ! -f "$status_log" ] || [ ! -f "$status_receipt" ]; }; then
                    status_log=-
                    status_receipt=-
                    status_log_display=-
                fi
                echo "${status_probe}_raw_status=$status_raw"
                echo "${status_probe}_log_path=$status_log_display"
                echo "${status_probe}_log_sha256=$([ "$status_log" = - ] && echo - || candidate_frontend_hash_file "$status_log")"
                echo "${status_probe}_collector_receipt_path=$([ "$status_log_display" = - ] && echo - || echo "$status_log_display.bounded.env")"
                echo "${status_probe}_collector_receipt_sha256=$([ "$status_receipt" = - ] && echo - || candidate_frontend_hash_file "$status_receipt")"
            done
        } >"$status_tmp" || return 1
        ln "$status_tmp" "$status_path" || { rm -f "$status_tmp"; return 126; }
        rm -f "$status_tmp"
    }
    candidate_frontend_fail() {
        failed_probe=$1
        failed_status=$2
        case "$failed_probe" in
          p2_add-*|p2-add-*) failed_log=$p2_add_log ;;
          stage2-mir-retention-*) failed_log=$stage2_mir_retention_log ;;
          stage2-module-path-naming-*) failed_log=$stage2_module_path_naming_log ;;
          hello-world-positional-*) failed_log=$hello_world_positional_log ;;
          *) failed_log=$build_log ;;
        esac
        echo "candidate_frontend_smoke: ${failed_probe} failed (raw rc=${failed_status})" >&2
        if [ -f "$failed_log" ]; then
            head -c 65536 "$failed_log" >&2
        fi
        candidate_frontend_finish fail "$failed_probe" "$failed_status" || :
        exit "$failed_status"
    }
    if ! candidate_frontend_procfd_leaf "$build_log"; then
        candidate_frontend_finish fail setup-failure 126 || :
        exit 126
    fi
    probe_output=$(candidate_frontend_executable_path "$probe_dir/p2_add")
    probe_build_status=0
    SIMPLE_BINARY="$candidate" \
    SIMPLE_BIN="$candidate" \
    SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
    SIMPLE_FRONTEND_DELEGATE="$candidate" \
    SIMPLE_FRONTEND_DELEGATED=1 \
    SIMPLE_NO_STUB_FALLBACK=1 \
    SIMPLE_EXECUTION_MODE= \
    SIMPLE_NATIVE_BUILD_FORCE_WORKER=0 \
    SIMPLE_BOOTSTRAP="$candidate_bootstrap" \
    SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        candidate_frontend_bounded_build p2_add "$candidate" native-build \
        --backend "$candidate_backend" \
        --runtime-bundle core-c-bootstrap \
        --entry-closure \
        --entry scripts/check/cert/redeploy_gate/fixtures/p2_add.spl \
        --cache-dir "$probe_dir/cache" \
        --mode one-binary \
        --output "$probe_output" || probe_build_status=$?
    p2_add_raw_status=$probe_build_status
    p2_add_reason=$(sed -n 's/^reason=//p' "$p2_add_receipt" 2>/dev/null || echo infrastructure-failure)
    [ "$probe_build_status" -eq 0 ] || {
        # tail, not head: a real build failure's log is typically dominated
        # by hundreds of KB of compiler warnings from unrelated files BEFORE
        # the actual failing command's output; the failure text is always the
        # last thing printed, so keep the END of the log (measured 2026-08-31:
        # a genuine link failure was invisible behind 65536 bytes of clang-cl
        # deprecation warnings under a head-bounded excerpt).
        tail -c 65536 "$p2_add_log" >&2
        candidate_frontend_fail p2_add-build "$probe_build_status"
    }
    # Runaway-diagnostic gate: even a build that reports success must not have
    # spewed an unbounded diagnostic stream at a two-line fixture.
    build_log_bytes=$(wc -c <"$p2_add_log" 2>/dev/null || echo 0)
    if [ "$build_log_bytes" -gt "$CANDIDATE_FRONTEND_MAX_LOG_BYTES" ]; then
        echo "candidate_frontend_smoke: candidate emitted ${build_log_bytes} bytes of output for a two-line fixture (cap ${CANDIDATE_FRONTEND_MAX_LOG_BYTES}); treating as a runaway error loop" >&2
        candidate_frontend_fail p2_add-log-cap 1
    fi
    # Dead-lexer signature: kind 0 / empty token text is never a real token.
    if grep -q "Unknown(0) ''" "$p2_add_log" 2>/dev/null ||
        grep -q '\[lexer_fatal\]' "$p2_add_log" 2>/dev/null; then
        echo "candidate_frontend_smoke: candidate reported a dead lexer while compiling the fixture" >&2
        candidate_frontend_fail p2_add-dead-lexer 1
    fi
    probe_run_status=0
    probe_stdout=$("$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_EXEC_TIMEOUT_SECONDS}s" "$probe_output" 2>/dev/null) || probe_run_status=$?
    [ "$probe_run_status" -eq 0 ] || candidate_frontend_fail p2_add-run "$probe_run_status"
    [ "$probe_stdout" = 5 ] || candidate_frontend_fail p2_add-output 1

    # Exact Stage-2 MIR-retention guard. An admitted self-compiled compiler was
    # observed emitting two method-call instructions, then losing them when
    # end_function called finalize_block with an already-empty pending list.
    # p2_add alone did not distinguish that failure, so keep this fixture and
    # cache independent and require its native result before admission.
    retention_output=$(candidate_frontend_executable_path \
        "$probe_dir/stage2_mir_retention")
    retention_build_status=0
    SIMPLE_BINARY="$candidate" \
    SIMPLE_BIN="$candidate" \
    SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
    SIMPLE_FRONTEND_DELEGATE="$candidate" \
    SIMPLE_FRONTEND_DELEGATED=1 \
    SIMPLE_NO_STUB_FALLBACK=1 \
    SIMPLE_EXECUTION_MODE= \
    SIMPLE_NATIVE_BUILD_FORCE_WORKER=0 \
    SIMPLE_BOOTSTRAP="$candidate_bootstrap" \
    SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        candidate_frontend_bounded_build stage2_mir_retention "$candidate" native-build \
        --backend "$candidate_backend" \
        --runtime-bundle core-c-bootstrap \
        --entry-closure \
        --entry scripts/check/cert/redeploy_gate/fixtures/stage2_mir_retention.spl \
        --cache-dir "$probe_dir/cache-stage2-mir-retention" \
        --mode one-binary \
        --output "$retention_output" || retention_build_status=$?
    stage2_mir_retention_raw_status=$retention_build_status
    stage2_mir_retention_reason=$(sed -n 's/^reason=//p' "$stage2_mir_retention_receipt" 2>/dev/null || echo infrastructure-failure)
    [ "$retention_build_status" -eq 0 ] || {
        # tail, not head: a real build failure's log is typically dominated
        # by hundreds of KB of compiler warnings from unrelated files BEFORE
        # the actual failing command's output; the failure text is always the
        # last thing printed, so keep the END of the log (measured 2026-08-31:
        # a genuine link failure was invisible behind 65536 bytes of clang-cl
        # deprecation warnings under a head-bounded excerpt).
        tail -c 65536 "$stage2_mir_retention_log" >&2
        candidate_frontend_fail stage2-mir-retention-build "$retention_build_status"
    }
    build_log_bytes=$(wc -c <"$stage2_mir_retention_log" 2>/dev/null || echo 0)
    [ "$build_log_bytes" -le "$CANDIDATE_FRONTEND_MAX_LOG_BYTES" ] || {
        echo "candidate_frontend_smoke: candidate exceeded the combined admission log cap" >&2
        candidate_frontend_fail stage2-mir-retention-log-cap 1
    }
    retention_run_status=0
    retention_stdout=$("$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_EXEC_TIMEOUT_SECONDS}s" "$retention_output" 2>/dev/null) || retention_run_status=$?
    [ "$retention_run_status" -eq 0 ] ||
        candidate_frontend_fail stage2-mir-retention-run "$retention_run_status"
    [ "$retention_stdout" = 3 ] || candidate_frontend_fail stage2-mir-retention-output 1

    # Stage-3 module-identity guard. Stage 2 previously admitted even though
    # its native lowering turned both of these source paths into the empty
    # module name. Compile and execute the canonical helper through the exact
    # candidate that will build Stage 3; interpreter-only tests cannot prove
    # this boundary.
    naming_output=$(candidate_frontend_executable_path \
        "$probe_dir/stage2_module_path_naming")
    naming_build_status=0
    SIMPLE_BINARY="$candidate" \
    SIMPLE_BIN="$candidate" \
    SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
    SIMPLE_FRONTEND_DELEGATE="$candidate" \
    SIMPLE_FRONTEND_DELEGATED=1 \
    SIMPLE_NO_STUB_FALLBACK=1 \
    SIMPLE_EXECUTION_MODE= \
    SIMPLE_NATIVE_BUILD_FORCE_WORKER=0 \
    SIMPLE_BOOTSTRAP="$candidate_bootstrap" \
    SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        candidate_frontend_bounded_build stage2_module_path_naming "$candidate" native-build \
        --backend "$candidate_backend" \
        --runtime-bundle core-c-bootstrap \
        --entry-closure \
        --entry scripts/check/cert/redeploy_gate/fixtures/stage2_module_path_naming.spl \
        --cache-dir "$probe_dir/cache-stage2-module-path-naming" \
        --mode one-binary \
        --output "$naming_output" || naming_build_status=$?
    stage2_module_path_naming_raw_status=$naming_build_status
    stage2_module_path_naming_reason=$(sed -n 's/^reason=//p' "$stage2_module_path_naming_receipt" 2>/dev/null || echo infrastructure-failure)
    [ "$naming_build_status" -eq 0 ] || {
        # tail, not head: a real build failure's log is typically dominated
        # by hundreds of KB of compiler warnings from unrelated files BEFORE
        # the actual failing command's output; the failure text is always the
        # last thing printed, so keep the END of the log (measured 2026-08-31:
        # a genuine link failure was invisible behind 65536 bytes of clang-cl
        # deprecation warnings under a head-bounded excerpt).
        tail -c 65536 "$stage2_module_path_naming_log" >&2
        candidate_frontend_fail stage2-module-path-naming-build "$naming_build_status"
    }
    build_log_bytes=$(wc -c <"$stage2_module_path_naming_log" 2>/dev/null || echo 0)
    [ "$build_log_bytes" -le "$CANDIDATE_FRONTEND_MAX_LOG_BYTES" ] || {
        echo "candidate_frontend_smoke: candidate exceeded the combined admission log cap during module naming" >&2
        candidate_frontend_fail stage2-module-path-naming-log-cap 1
    }
    if grep -q "Unknown(0) ''" "$stage2_module_path_naming_log" 2>/dev/null ||
        grep -q '\[lexer_fatal\]' "$stage2_module_path_naming_log" 2>/dev/null; then
        echo "candidate_frontend_smoke: candidate reported a dead lexer during module naming" >&2
        candidate_frontend_fail stage2-module-path-naming-dead-lexer 1
    fi
    naming_run_status=0
    naming_stdout=$("$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_EXEC_TIMEOUT_SECONDS}s" "$naming_output" 2>/dev/null) || naming_run_status=$?
    [ "$naming_run_status" -eq 0 ] ||
        candidate_frontend_fail stage2-module-path-naming-run "$naming_run_status"
    naming_expected=$(printf 'app.cli.bootstrap_main\ncompiler.driver.driver\napp.cli.main')
    [ "$naming_stdout" = "$naming_expected" ] || {
        echo "candidate_frontend_smoke: Stage-2 module naming mismatch: '$naming_stdout'" >&2
        candidate_frontend_fail stage2-module-path-naming-output 1
    }

    # Positional-entry no-crash probe (2026-08-25). Both probes above name the
    # entry with the `--entry` FLAG, and that flag form is the ONLY form this
    # gate ever exercised. Measured on build/bootstrap/s5 and s5full: the SAME
    # binary that passes everything above SIGSEGVs (rc=139,
    # E-DRIVER-HIR-RETAINED-SURFACES-MALFORMED) when the identical build is
    # asked for with a POSITIONAL entry instead -- the form a human types. That
    # is how a compiler unable to compile hello world was ADMITTED. See
    # doc/08_tracking/bug/stage2_admitted_while_hello_world_native_build_segv_2026-08-25.md
    #
    # Admission is strict: all four collectors must report child-exit/raw 0 so
    # the status-v2 receipt can be verified without an accepted-failure state.
    positional_output=$(candidate_frontend_executable_path \
        "$probe_dir/hello_world_positional")
    positional_status=0
    if SIMPLE_BINARY="$candidate" \
    SIMPLE_BIN="$candidate" \
    SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
    SIMPLE_FRONTEND_DELEGATE="$candidate" \
    SIMPLE_FRONTEND_DELEGATED=1 \
    SIMPLE_NO_STUB_FALLBACK=1 \
    SIMPLE_EXECUTION_MODE= \
    SIMPLE_NATIVE_BUILD_FORCE_WORKER=0 \
    SIMPLE_BOOTSTRAP="$candidate_bootstrap" \
    SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        candidate_frontend_bounded_build hello_world_positional "$candidate" native-build \
        --backend "$candidate_backend" \
        --runtime-bundle core-c-bootstrap \
        --entry-closure \
        --cache-dir "$probe_dir/cache-hello-world-positional" \
        --mode one-binary \
        scripts/check/cert/redeploy_gate/fixtures/hello_world.spl \
        --output "$positional_output"; then
        positional_status=0
    else
        positional_status=$?
    fi
    hello_world_positional_raw_status=$positional_status
    hello_world_positional_reason=$(sed -n 's/^reason=//p' "$hello_world_positional_receipt" 2>/dev/null || echo infrastructure-failure)
    [ "$positional_status" -eq 0 ] ||
        candidate_frontend_fail hello-world-positional-build "$positional_status"
    if [ "$positional_status" -eq 0 ] && [ ! -x "$positional_output" ]; then
        echo "candidate_frontend_smoke: hello world positional build exited 0 without an executable output" >&2
        candidate_frontend_fail hello-world-positional-output-missing 1
    fi
    if [ "$positional_status" -eq 0 ]; then
        positional_stdout=$("$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
            "${COMPILER_EXEC_TIMEOUT_SECONDS}s" "$positional_output" 2>/dev/null)
        positional_run_status=$?
        if [ "$positional_run_status" -ne 0 ] || [ "$positional_stdout" != hello ]; then
            echo "candidate_frontend_smoke: hello world built from a positional entry did not run correctly (rc=$positional_run_status, stdout='$positional_stdout')" >&2
            [ "$positional_run_status" -ne 0 ] || positional_run_status=1
            candidate_frontend_fail hello-world-positional-run "$positional_run_status"
        fi
    fi
    candidate_frontend_finish pass complete 0
)

candidate_frontend_delegate_fidelity() (
    candidate=$1
    timeout_bin=$(candidate_frontend_timeout_bin || true)
    [ -n "$timeout_bin" ] || exit 1
    probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/simple-front-delegate.XXXXXX") || exit 1
    trap 'rm -rf "$probe_dir"' 0
    trap 'exit 1' HUP INT TERM
    case "$candidate" in
        *.exe)
            delegate=$probe_dir/delegate.cmd
            cat >"$delegate" <<'EOF'
@echo stage4-delegate-stdout
@echo stage4-delegate-stderr 1>&2
@exit /b 17
EOF
            ;;
        *)
            delegate=$probe_dir/delegate
            cat >"$delegate" <<'EOF'
#!/bin/sh
printf 'stage4-delegate-stdout\n'
printf 'stage4-delegate-stderr\n' >&2
exit 17
EOF
            chmod +x "$delegate"
            ;;
    esac
    set +e
    SIMPLE_BINARY="$candidate" \
    SIMPLE_BIN="$candidate" \
    SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
    SIMPLE_FRONTEND_DELEGATE="$delegate" \
    SIMPLE_FRONTEND_DELEGATED=0 \
    SIMPLE_NO_STUB_FALLBACK=1 \
    SIMPLE_EXECUTION_MODE= \
    SIMPLE_BOOTSTRAP=0 \
    SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        "$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_PROBE_TIMEOUT_SECONDS}s" "$candidate" check ignored.spl \
        >"$probe_dir/stdout" 2>"$probe_dir/stderr"
    probe_status=$?
    set -e
    if [ "$positional_status" -ne 0 ] &&
        [ "$hello_world_positional_reason" != child-exit ]; then
        candidate_frontend_fail hello-world-positional-infrastructure 126
    fi
    [ "$probe_status" -eq 17 ] || exit 1
    grep -Fq 'stage4-delegate-stdout' "$probe_dir/stdout" || exit 1
    grep -Fq 'stage4-delegate-stderr' "$probe_dir/stderr"
)

simple_binary_is_valid() (
    candidate=$1
    [ -x "$candidate" ] || return 1
    case "$candidate" in
        */target/debug/*|*/debug/simple|*/debug/simple.exe) return 1 ;;
    esac
    timeout_bin=$(candidate_frontend_timeout_bin || true)
    [ -n "$timeout_bin" ] || return 1
    version=$(SIMPLE_BINARY="$candidate" \
        SIMPLE_BIN="$candidate" \
        SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
        SIMPLE_FRONTEND_DELEGATE="$candidate" \
        SIMPLE_FRONTEND_DELEGATED=1 \
        SIMPLE_NO_STUB_FALLBACK=1 \
        SIMPLE_EXECUTION_MODE= \
        SIMPLE_NATIVE_BUILD_FORCE_WORKER=0 \
        SIMPLE_BOOTSTRAP=0 \
        SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        "$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_PROBE_TIMEOUT_SECONDS}s" "$candidate" --version 2>&1) || return 1
    [ -n "$version" ] || return 1
    case "$version" in
        *"bootstrap seed only"*|*"Rust-built"*|*"debug build"*) return 1 ;;
    esac
    env_probe=$(SIMPLE_BINARY="$candidate" \
        SIMPLE_BIN="$candidate" \
        SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
        SIMPLE_FRONTEND_DELEGATE="$candidate" \
        SIMPLE_FRONTEND_DELEGATED=1 \
        SIMPLE_NO_STUB_FALLBACK=1 \
        SIMPLE_EXECUTION_MODE= \
        SIMPLE_BOOTSTRAP=0 \
        SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        "$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_PROBE_TIMEOUT_SECONDS}s" "$candidate" -c \
        'extern fn rt_env_set(key: text, value: text) -> bool; print(rt_env_set("__SIMPLE_CANDIDATE_ENV_ABI__", "ok"))' \
        2>&1) || return 1
    [ "$env_probe" = true ] || return 1
    candidate_frontend_delegate_fidelity "$candidate" || return 1
    candidate_frontend_smoke "$candidate" || return 1
    if probe=$(SIMPLE_BINARY="$candidate" \
        SIMPLE_BIN="$candidate" \
        SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
        SIMPLE_FRONTEND_DELEGATE="$candidate" \
        SIMPLE_FRONTEND_DELEGATED=1 \
        SIMPLE_NO_STUB_FALLBACK=1 \
        SIMPLE_EXECUTION_MODE= \
        SIMPLE_NATIVE_BUILD_FORCE_WORKER=0 \
        SIMPLE_BOOTSTRAP=0 \
        SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        "$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_PROBE_TIMEOUT_SECONDS}s" "$candidate" native-build \
        --backend cranelift --entry src/app/cli/main.spl \
        --mode definitely-invalid-mode 2>&1)
    then
        return 1
    else
        probe_status=$?
    fi
    [ "$probe_status" -eq 1 ] || return 1
    case "$probe" in
        *"Error: invalid --mode 'definitely-invalid-mode' (expected dynload or one-binary)"*) ;;
        *) return 1 ;;
    esac
)
