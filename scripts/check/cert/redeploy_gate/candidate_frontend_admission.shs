#!/bin/sh

COMPILER_PROBE_TIMEOUT_SECONDS=${COMPILER_PROBE_TIMEOUT_SECONDS:-5}
COMPILER_BUILD_TIMEOUT_SECONDS=${COMPILER_BUILD_TIMEOUT_SECONDS:-60}
COMPILER_EXEC_TIMEOUT_SECONDS=${COMPILER_EXEC_TIMEOUT_SECONDS:-5}
COMPILER_CHECK_KILL_GRACE_SECONDS=${COMPILER_CHECK_KILL_GRACE_SECONDS:-1}

candidate_frontend_timeout_bin() {
    if command -v timeout >/dev/null 2>&1; then
        command -v timeout
    elif command -v gtimeout >/dev/null 2>&1; then
        command -v gtimeout
    else
        return 1
    fi
}

# Cap on the candidate's own build-log size. A dead lexer combined with a
# parser error-recovery loop that makes no forward progress emits the SAME line
# forever: on 2026-08-09 an admitted Stage-2 binary produced a 444 MB /
# 6,299,344-line log at 32 GB RSS before the run was killed by hand. Any
# candidate that emits more than this from a 2-line fixture is non-functional
# regardless of its exit status.
CANDIDATE_FRONTEND_MAX_LOG_BYTES=${CANDIDATE_FRONTEND_MAX_LOG_BYTES:-4194304}

candidate_frontend_executable_path() {
    case "$(uname -s 2>/dev/null || echo unknown)" in
        MSYS*|MINGW*|CYGWIN*) printf '%s.exe\n' "$1" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

candidate_frontend_run_expect() {
    candidate_frontend_run_path=$1
    candidate_frontend_run_expected=$2
    candidate_frontend_run_label=$3
    candidate_frontend_run_status=0
    if command -v run_timeout >/dev/null 2>&1; then
        candidate_frontend_run_output=$(run_timeout \
            "${COMPILER_EXEC_TIMEOUT_SECONDS}" \
            "$candidate_frontend_run_path" 2>&1) ||
            candidate_frontend_run_status=$?
    else
        candidate_frontend_run_output=$(
            "$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
                "${COMPILER_EXEC_TIMEOUT_SECONDS}s" \
                "$candidate_frontend_run_path" 2>&1
        ) || candidate_frontend_run_status=$?
    fi
    if [ "$candidate_frontend_run_status" -ne 0 ]; then
        echo "candidate_frontend_smoke: ${candidate_frontend_run_label} executable exited ${candidate_frontend_run_status}: ${candidate_frontend_run_output}" >&2
        return 1
    fi
    if [ "$candidate_frontend_run_output" != "$candidate_frontend_run_expected" ]; then
        echo "candidate_frontend_smoke: ${candidate_frontend_run_label} output '${candidate_frontend_run_output}', expected '${candidate_frontend_run_expected}'" >&2
        return 1
    fi
}

# candidate_frontend_smoke <candidate>
#
# CANDIDATE_FRONTEND_BOOTSTRAP selects the SIMPLE_BOOTSTRAP value the candidate
# is exercised under. This must be swept, not fixed: Stage 3 invokes the
# admitted Stage-2 binary with SIMPLE_BOOTSTRAP=1, but this gate only ever ran
# it with SIMPLE_BOOTSTRAP=0 -- and SIMPLE_BOOTSTRAP=1 is documented in this repo
# to change compiler behaviour drastically (vacuous `--native` emit; the `?`
# operator dropped entirely). So the gate certified a configuration Stage 3
# never uses. See
# doc/08_tracking/bug/stage2_binary_lexer_reads_every_source_as_empty_infinite_parser_loop_2026-08-09.md
candidate_frontend_smoke() (
    candidate=$1
    candidate_backend=${CANDIDATE_FRONTEND_BACKEND:-cranelift}
    candidate_bootstrap=${CANDIDATE_FRONTEND_BOOTSTRAP:-0}
    timeout_bin=$(candidate_frontend_timeout_bin || true)
    [ -n "$timeout_bin" ] || exit 1
    probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/simpleos-host-gpu-admission.XXXXXX") || exit 1
    trap 'rm -rf "$probe_dir"' 0
    trap 'exit 1' HUP INT TERM
    probe_output=$(candidate_frontend_executable_path "$probe_dir/p2_add")
    SIMPLE_BINARY="$candidate" \
    SIMPLE_BIN="$candidate" \
    SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
    SIMPLE_FRONTEND_DELEGATE="$candidate" \
    SIMPLE_FRONTEND_DELEGATED=1 \
    SIMPLE_NO_STUB_FALLBACK=1 \
    SIMPLE_EXECUTION_MODE= \
    SIMPLE_NATIVE_BUILD_FORCE_WORKER=0 \
    SIMPLE_BOOTSTRAP="$candidate_bootstrap" \
    SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        "$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_BUILD_TIMEOUT_SECONDS}s" "$candidate" native-build \
        --backend "$candidate_backend" \
        --runtime-bundle core-c-bootstrap \
        --entry-closure \
        --entry scripts/check/cert/redeploy_gate/fixtures/p2_add.spl \
        --cache-dir "$probe_dir/cache" \
        --mode one-binary \
        --output "$probe_output" >"$probe_dir/build.log" 2>&1 || {
            # tail, not head: --entry-closure with no --source scans the
            # whole project (see the "scans the DEFAULT source roots"
            # warning a few lines above), so a real build failure's log is
            # typically dominated by hundreds of KB of compiler warnings
            # from unrelated files BEFORE the actual failing command's
            # output. A head-bounded excerpt showed only those warnings and
            # never reached the real "Build failed: ..." line -- measured
            # 2026-08-31: a genuine link failure was invisible behind 65536
            # bytes of clang-cl deprecation warnings. The failure text is
            # always the last thing printed, so keep the END of the log.
            tail -c 65536 "$probe_dir/build.log" >&2
            exit 1
        }
    # Runaway-diagnostic gate: even a build that reports success must not have
    # spewed an unbounded diagnostic stream at a two-line fixture.
    build_log_bytes=$(wc -c <"$probe_dir/build.log" 2>/dev/null || echo 0)
    if [ "$build_log_bytes" -gt "$CANDIDATE_FRONTEND_MAX_LOG_BYTES" ]; then
        echo "candidate_frontend_smoke: candidate emitted ${build_log_bytes} bytes of output for a two-line fixture (cap ${CANDIDATE_FRONTEND_MAX_LOG_BYTES}); treating as a runaway error loop" >&2
        head -c 4096 "$probe_dir/build.log" >&2
        exit 1
    fi
    # Dead-lexer signature: kind 0 / empty token text is never a real token.
    if grep -q "Unknown(0) ''" "$probe_dir/build.log" 2>/dev/null ||
        grep -q '\[lexer_fatal\]' "$probe_dir/build.log" 2>/dev/null; then
        echo "candidate_frontend_smoke: candidate reported a dead lexer while compiling the fixture" >&2
        head -c 4096 "$probe_dir/build.log" >&2
        exit 1
    fi
    candidate_frontend_run_expect "$probe_output" 5 p2_add || exit 1

    # Exact Stage-2 MIR-retention guard. An admitted self-compiled compiler was
    # observed emitting two method-call instructions, then losing them when
    # end_function called finalize_block with an already-empty pending list.
    # p2_add alone did not distinguish that failure, so keep this fixture and
    # cache independent and require its native result before admission.
    retention_output=$(candidate_frontend_executable_path \
        "$probe_dir/stage2_mir_retention")
    SIMPLE_BINARY="$candidate" \
    SIMPLE_BIN="$candidate" \
    SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
    SIMPLE_FRONTEND_DELEGATE="$candidate" \
    SIMPLE_FRONTEND_DELEGATED=1 \
    SIMPLE_NO_STUB_FALLBACK=1 \
    SIMPLE_EXECUTION_MODE= \
    SIMPLE_NATIVE_BUILD_FORCE_WORKER=0 \
    SIMPLE_BOOTSTRAP="$candidate_bootstrap" \
    SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        "$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_BUILD_TIMEOUT_SECONDS}s" "$candidate" native-build \
        --backend "$candidate_backend" \
        --runtime-bundle core-c-bootstrap \
        --entry-closure \
        --entry scripts/check/cert/redeploy_gate/fixtures/stage2_mir_retention.spl \
        --cache-dir "$probe_dir/cache-stage2-mir-retention" \
        --mode one-binary \
        --output "$retention_output" >>"$probe_dir/build.log" 2>&1 || {
            tail -c 65536 "$probe_dir/build.log" >&2
            exit 1
        }
    build_log_bytes=$(wc -c <"$probe_dir/build.log" 2>/dev/null || echo 0)
    [ "$build_log_bytes" -le "$CANDIDATE_FRONTEND_MAX_LOG_BYTES" ] || {
        echo "candidate_frontend_smoke: candidate exceeded the combined admission log cap" >&2
        head -c 4096 "$probe_dir/build.log" >&2
        exit 1
    }
    candidate_frontend_run_expect \
        "$retention_output" 3 stage2_mir_retention || exit 1

    # Stage-3 module-identity guard. Stage 2 previously admitted even though
    # its native lowering turned both of these source paths into the empty
    # module name. Compile and execute the canonical helper through the exact
    # candidate that will build Stage 3; interpreter-only tests cannot prove
    # this boundary.
    naming_output=$(candidate_frontend_executable_path \
        "$probe_dir/stage2_module_path_naming")
    SIMPLE_BINARY="$candidate" \
    SIMPLE_BIN="$candidate" \
    SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
    SIMPLE_FRONTEND_DELEGATE="$candidate" \
    SIMPLE_FRONTEND_DELEGATED=1 \
    SIMPLE_NO_STUB_FALLBACK=1 \
    SIMPLE_EXECUTION_MODE= \
    SIMPLE_NATIVE_BUILD_FORCE_WORKER=0 \
    SIMPLE_BOOTSTRAP="$candidate_bootstrap" \
    SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        "$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_BUILD_TIMEOUT_SECONDS}s" "$candidate" native-build \
        --backend "$candidate_backend" \
        --runtime-bundle core-c-bootstrap \
        --entry-closure \
        --entry scripts/check/cert/redeploy_gate/fixtures/stage2_module_path_naming.spl \
        --cache-dir "$probe_dir/cache-stage2-module-path-naming" \
        --mode one-binary \
        --output "$naming_output" >>"$probe_dir/build.log" 2>&1 || {
            tail -c 65536 "$probe_dir/build.log" >&2
            exit 1
        }
    build_log_bytes=$(wc -c <"$probe_dir/build.log" 2>/dev/null || echo 0)
    [ "$build_log_bytes" -le "$CANDIDATE_FRONTEND_MAX_LOG_BYTES" ] || {
        echo "candidate_frontend_smoke: candidate exceeded the combined admission log cap during module naming" >&2
        head -c 4096 "$probe_dir/build.log" >&2
        exit 1
    }
    if grep -q "Unknown(0) ''" "$probe_dir/build.log" 2>/dev/null ||
        grep -q '\[lexer_fatal\]' "$probe_dir/build.log" 2>/dev/null; then
        echo "candidate_frontend_smoke: candidate reported a dead lexer during module naming" >&2
        tail -c 4096 "$probe_dir/build.log" >&2
        exit 1
    fi
    naming_expected=$(printf 'app.cli.bootstrap_main\ncompiler.driver.driver\napp.cli.main')
    candidate_frontend_run_expect \
        "$naming_output" "$naming_expected" stage2_module_path_naming || exit 1

    # Positional-entry no-crash probe (2026-08-25). Both probes above name the
    # entry with the `--entry` FLAG, and that flag form is the ONLY form this
    # gate ever exercised. Measured on build/bootstrap/s5 and s5full: the SAME
    # binary that passes everything above SIGSEGVs (rc=139,
    # E-DRIVER-HIR-RETAINED-SURFACES-MALFORMED) when the identical build is
    # asked for with a POSITIONAL entry instead -- the form a human types. That
    # is how a compiler unable to compile hello world was ADMITTED. See
    # doc/08_tracking/bug/stage2_admitted_while_hello_world_native_build_segv_2026-08-25.md
    #
    # This is a NO-CRASH check, not a must-succeed check, and must stay that
    # way: a healthy compiler may legitimately reject a positional entry with a
    # clean non-zero diagnostic, and demanding success here would false-reject
    # it. Only death-by-signal and a hang are failures. `--entry-closure` is
    # mandatory -- without it the candidate scans the default source roots and
    # runs unbounded on a two-line fixture.
    positional_output=$(candidate_frontend_executable_path \
        "$probe_dir/hello_world_positional")
    SIMPLE_BINARY="$candidate" \
    SIMPLE_BIN="$candidate" \
    SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
    SIMPLE_FRONTEND_DELEGATE="$candidate" \
    SIMPLE_FRONTEND_DELEGATED=1 \
    SIMPLE_NO_STUB_FALLBACK=1 \
    SIMPLE_EXECUTION_MODE= \
    SIMPLE_NATIVE_BUILD_FORCE_WORKER=0 \
    SIMPLE_BOOTSTRAP="$candidate_bootstrap" \
    SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        "$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_BUILD_TIMEOUT_SECONDS}s" "$candidate" native-build \
        --backend "$candidate_backend" \
        --runtime-bundle core-c-bootstrap \
        --entry-closure \
        --cache-dir "$probe_dir/cache-hello-world-positional" \
        --mode one-binary \
        scripts/check/cert/redeploy_gate/fixtures/hello_world.spl \
        --output "$positional_output" >>"$probe_dir/build.log" 2>&1
    # Status read DIRECTLY into a variable on the line after the command --
    # never through a pipe, whose $? is the last element's status.
    positional_status=$?
    if [ "$positional_status" -eq 124 ]; then
        echo "candidate_frontend_smoke: candidate HUNG (timeout) native-building a two-line hello world with a positional entry" >&2
        exit 1
    fi
    if [ "$positional_status" -ge 128 ]; then
        echo "candidate_frontend_smoke: candidate CRASHED (signal $((positional_status - 128)), rc=$positional_status) native-building a two-line hello world with a positional entry" >&2
        tail -c 4096 "$probe_dir/build.log" >&2
        exit 1
    fi
    # A clean non-zero exit is deliberately accepted here; see above. When the
    # build DID succeed, the artifact must actually run and print the fixture's
    # output -- an exit-0 build proves nothing about the binary it produced.
    if [ "$positional_status" -eq 0 ] && [ -x "$positional_output" ]; then
        positional_stdout=$("$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
            "${COMPILER_EXEC_TIMEOUT_SECONDS}s" "$positional_output" 2>/dev/null)
        positional_run_status=$?
        if [ "$positional_run_status" -ne 0 ] || [ "$positional_stdout" != hello ]; then
            echo "candidate_frontend_smoke: hello world built from a positional entry did not run correctly (rc=$positional_run_status, stdout='$positional_stdout')" >&2
            exit 1
        fi
    fi
    :
)

candidate_frontend_delegate_fidelity() (
    candidate=$1
    timeout_bin=$(candidate_frontend_timeout_bin || true)
    [ -n "$timeout_bin" ] || exit 1
    probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/simple-front-delegate.XXXXXX") || exit 1
    trap 'rm -rf "$probe_dir"' 0
    trap 'exit 1' HUP INT TERM
    case "$candidate" in
        *.exe)
            delegate=$probe_dir/delegate.cmd
            cat >"$delegate" <<'EOF'
@echo stage4-delegate-stdout
@echo stage4-delegate-stderr 1>&2
@exit /b 17
EOF
            ;;
        *)
            delegate=$probe_dir/delegate
            cat >"$delegate" <<'EOF'
#!/bin/sh
printf 'stage4-delegate-stdout\n'
printf 'stage4-delegate-stderr\n' >&2
exit 17
EOF
            chmod +x "$delegate"
            ;;
    esac
    set +e
    SIMPLE_BINARY="$candidate" \
    SIMPLE_BIN="$candidate" \
    SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
    SIMPLE_FRONTEND_DELEGATE="$delegate" \
    SIMPLE_FRONTEND_DELEGATED=0 \
    SIMPLE_NO_STUB_FALLBACK=1 \
    SIMPLE_EXECUTION_MODE= \
    SIMPLE_BOOTSTRAP=0 \
    SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        "$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_PROBE_TIMEOUT_SECONDS}s" "$candidate" check ignored.spl \
        >"$probe_dir/stdout" 2>"$probe_dir/stderr"
    probe_status=$?
    set -e
    [ "$probe_status" -eq 17 ] || exit 1
    grep -Fq 'stage4-delegate-stdout' "$probe_dir/stdout" || exit 1
    grep -Fq 'stage4-delegate-stderr' "$probe_dir/stderr"
)

simple_binary_is_valid() (
    candidate=$1
    [ -x "$candidate" ] || return 1
    case "$candidate" in
        */target/debug/*|*/debug/simple|*/debug/simple.exe) return 1 ;;
    esac
    timeout_bin=$(candidate_frontend_timeout_bin || true)
    [ -n "$timeout_bin" ] || return 1
    version=$(SIMPLE_BINARY="$candidate" \
        SIMPLE_BIN="$candidate" \
        SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
        SIMPLE_FRONTEND_DELEGATE="$candidate" \
        SIMPLE_FRONTEND_DELEGATED=1 \
        SIMPLE_NO_STUB_FALLBACK=1 \
        SIMPLE_EXECUTION_MODE= \
        SIMPLE_NATIVE_BUILD_FORCE_WORKER=0 \
        SIMPLE_BOOTSTRAP=0 \
        SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        "$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_PROBE_TIMEOUT_SECONDS}s" "$candidate" --version 2>&1) || return 1
    [ -n "$version" ] || return 1
    case "$version" in
        *"bootstrap seed only"*|*"Rust-built"*|*"debug build"*) return 1 ;;
    esac
    env_probe=$(SIMPLE_BINARY="$candidate" \
        SIMPLE_BIN="$candidate" \
        SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
        SIMPLE_FRONTEND_DELEGATE="$candidate" \
        SIMPLE_FRONTEND_DELEGATED=1 \
        SIMPLE_NO_STUB_FALLBACK=1 \
        SIMPLE_EXECUTION_MODE= \
        SIMPLE_BOOTSTRAP=0 \
        SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        "$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_PROBE_TIMEOUT_SECONDS}s" "$candidate" -c \
        'extern fn rt_env_set(key: text, value: text) -> bool; print(rt_env_set("__SIMPLE_CANDIDATE_ENV_ABI__", "ok"))' \
        2>&1) || return 1
    [ "$env_probe" = true ] || return 1
    candidate_frontend_delegate_fidelity "$candidate" || return 1
    candidate_frontend_smoke "$candidate" || return 1
    if probe=$(SIMPLE_BINARY="$candidate" \
        SIMPLE_BIN="$candidate" \
        SIMPLE_BOOTSTRAP_DRIVER="$candidate" \
        SIMPLE_FRONTEND_DELEGATE="$candidate" \
        SIMPLE_FRONTEND_DELEGATED=1 \
        SIMPLE_NO_STUB_FALLBACK=1 \
        SIMPLE_EXECUTION_MODE= \
        SIMPLE_NATIVE_BUILD_FORCE_WORKER=0 \
        SIMPLE_BOOTSTRAP=0 \
        SIMPLE_LIB="$CANDIDATE_FRONTEND_ROOT/src" \
        "$timeout_bin" -k "${COMPILER_CHECK_KILL_GRACE_SECONDS}s" \
        "${COMPILER_PROBE_TIMEOUT_SECONDS}s" "$candidate" native-build \
        --backend cranelift --entry src/app/cli/main.spl \
        --mode definitely-invalid-mode 2>&1)
    then
        return 1
    else
        probe_status=$?
    fi
    [ "$probe_status" -eq 1 ] || return 1
    case "$probe" in
        *"Error: invalid --mode 'definitely-invalid-mode' (expected dynload or one-binary)"*) ;;
        *) return 1 ;;
    esac
)
