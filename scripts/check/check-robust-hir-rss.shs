#!/bin/sh
# Bounds peak memory growth of `simple robust --source hir` on the JIT: the
# per-file parser graph, HIR and origin table must be reclaimed once a file's
# facts are emitted. Needs a seed/binary that JITs (the probe has a `main`).
# Usage: sh scripts/check/check-robust-hir-rss.shs [path/to/simple]
# Verdict is the last line; exit 0 = PASS, 1 = FAIL, 2 = ERROR (nothing checked).
set -u
root=$(cd "$(dirname "$0")/../.." && pwd)
bin=${1:-$root/bin/simple}
if [ ! -x "$bin" ]; then
    echo "ERROR - nothing was checked (no executable $bin)"
    exit 2
fi
cd "$root" || exit 2
out=$("$bin" test/01_unit/app/cli/robust_hir_rss_probe.spl 2>/dev/null)
line=$(printf '%s\n' "$out" | grep '^RSS-PROBE ' | tail -1)
case "$line" in
    "RSS-PROBE PASS"*) echo "PASS - $line"; exit 0 ;;
    "RSS-PROBE FAIL"*) echo "FAIL - $line"; exit 1 ;;
    *) echo "ERROR - nothing was checked (probe printed no verdict)"; exit 2 ;;
esac
