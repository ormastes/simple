#!/bin/sh
set -eu

JS_RENDER_RUNTIME="${JS_RENDER_RUNTIME:-bun}"
JS_RENDER_RUNTIME_BIN="${JS_RENDER_RUNTIME_BIN:-bun}"
BUILD_DIR="${BUILD_DIR:-build/bun_web_render_bitmap_evidence}"
REPORT_PATH="${REPORT_PATH:-doc/09_report/bun_web_render_bitmap_evidence_$(date -u +%F).md}"
export JS_RENDER_RUNTIME JS_RENDER_RUNTIME_BIN BUILD_DIR REPORT_PATH

# Path fix (2026-08-06): the delegate lives at scripts/check/, not scripts/.
# The stale path made this script exit 2 with "cannot open" before it reached a
# single assertion -- found by running it during the guard_wiring_optout.txt
# false-exemption audit, which is the first time anything had run it at all.
exec sh scripts/check/check-node-web-render-bitmap-evidence.shs
