#!/bin/sh
set -eu

if [ "$(uname -s)" != Darwin ]; then
    echo "rt_file_publish_directory_macos_selfcheck: SKIP (requires macOS)"
    exit 0
fi

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
WORK=${TMPDIR:-/tmp}/simple-publish-directory-$$
trap 'rm -rf "$WORK"' EXIT HUP INT TERM
mkdir -p "$WORK"

${CC:-cc} -std=gnu11 -Wall -Wextra -Werror -ffunction-sections \
    -fdata-sections -Wl,-dead_strip -I "$ROOT/src/runtime" \
    "$ROOT/src/runtime/runtime_secure_staging.c" \
    "$ROOT/src/runtime/test/rt_file_publish_directory_macos_selfcheck.c" \
    -o "$WORK/selfcheck"
"$WORK/selfcheck"
