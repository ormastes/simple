#!/bin/sh
# Prove Stage2 sanity admission binds every frontend log/status artifact.

set -u
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
work=$(mktemp -d "${TMPDIR:-/tmp}/stage2-sanity-binding.XXXXXX") || exit 2
trap 'rm -rf "$work"' EXIT

bootstrap_stage3_hash_file() { sha256sum "$1" | cut -d' ' -f1; }
bootstrap_stage3_hash_stream() { sha256sum | cut -d' ' -f1; }
bootstrap_stage3_manifest_value() {
  key=$1 file=$2
  [ "$(grep -c "^${key}=" "$file" || true)" = 1 ] || return 1
  sed -n "s/^${key}=//p" "$file"
}
. "$root/scripts/check/lib/bootstrap-stage3/sanity.shs"

repo=$work/repo
mkdir -p "$repo/release" "$repo/src/app/cli"
cp "$root/VERSION" "$repo/VERSION"
cp "$root/release/version.sdn" "$repo/release/version.sdn"
cp "$root/src/app/cli/bootstrap_identity.spl" "$repo/src/app/cli/bootstrap_identity.spl"
version=$(sed -n '1p' "$repo/VERSION")
candidate=$work/candidate
printf '#!/bin/sh\nexit 0\n' >"$candidate"
chmod +x "$candidate"
candidate_sha=$(bootstrap_stage3_hash_file "$candidate")
receipt=$work/stage2-sanity.env
driver=$receipt.frontend-driver.log
: >"$driver"

for mode in 0 1; do
  log=$receipt.frontend-bootstrap-$mode.log
  status=$receipt.frontend-bootstrap-$mode.status.env
  for probe in p2_add stage2_mir_retention stage2_module_path_naming hello_world_positional; do
    case "$probe" in p2_add) probe_log=$log ;; *) probe_log=$log.$(printf '%s' "$probe" | tr _ -) ;; esac
    printf 'probe=%s mode=%s\n' "$probe" "$mode" >"$probe_log"
    probe_sha=$(bootstrap_stage3_hash_file "$probe_log")
    {
      echo schema=simple-bounded-process-log-v1; echo status=complete
      echo reason=child-exit; echo raw_status=0; echo max_bytes=4194304
      echo bytes_captured="$(wc -c <"$probe_log")"; echo timeout_seconds="${COMPILER_BUILD_TIMEOUT_SECONDS:-180}"
      echo term_grace_seconds=1; echo combined_stream=stdout-stderr
      echo process_group=setsid; echo artifact_limit=none
      echo log_leaf="${probe_log##*/}"; echo log_sha256="$probe_sha"
    } >"$probe_log.bounded.env"
  done
  {
    echo schema=simple-candidate-frontend-status-v2
    echo result=pass
    echo probe=complete
    echo raw_status=0
    echo bootstrap_mode="$mode"
    echo backend=llvm
    echo log_path="$log"
    for probe in p2_add stage2_mir_retention stage2_module_path_naming hello_world_positional; do
      case "$probe" in p2_add) probe_log=$log ;; *) probe_log=$log.$(printf '%s' "$probe" | tr _ -) ;; esac
      echo "${probe}_log_path=$probe_log"
      echo "${probe}_log_sha256=$(bootstrap_stage3_hash_file "$probe_log")"
      echo "${probe}_collector_receipt_path=$probe_log.bounded.env"
      echo "${probe}_collector_receipt_sha256=$(bootstrap_stage3_hash_file "$probe_log.bounded.env")"
      echo "${probe}_raw_status=0"
    done
  } >"$status"
done

{
  echo schema=simple-bootstrap-sanity-evidence-v1
  echo status=pass
  echo candidate_sha256_before="$candidate_sha"
  echo version_status=0
  echo version_output="simple-bootstrap $version"
  echo version_expected="$version"
  echo version_expect_status=0
  echo version_match_status=0
  echo unsupported_status=1
  printf 'unsupported_output_sha256=%s\n' "$(printf unsupported | bootstrap_stage3_hash_stream)"
  echo frontend_smoke_status=0
  echo frontend_smoke_backend=llvm
  echo frontend_smoke_bootstrap_mode_status=0
  echo frontend_smoke_bootstrap0_raw_status=0
  echo frontend_smoke_bootstrap0_log_path="$receipt.frontend-bootstrap-0.log"
  echo frontend_smoke_bootstrap0_log_sha256="$(bootstrap_stage3_hash_file "$receipt.frontend-bootstrap-0.log")"
  echo frontend_smoke_bootstrap0_status_path="$receipt.frontend-bootstrap-0.status.env"
  echo frontend_smoke_bootstrap0_status_sha256="$(bootstrap_stage3_hash_file "$receipt.frontend-bootstrap-0.status.env")"
  echo frontend_smoke_bootstrap1_ran=true
  echo frontend_smoke_bootstrap1_raw_status=0
  echo frontend_smoke_bootstrap1_log_path="$receipt.frontend-bootstrap-1.log"
  echo frontend_smoke_bootstrap1_log_sha256="$(bootstrap_stage3_hash_file "$receipt.frontend-bootstrap-1.log")"
  echo frontend_smoke_bootstrap1_status_path="$receipt.frontend-bootstrap-1.status.env"
  echo frontend_smoke_bootstrap1_status_sha256="$(bootstrap_stage3_hash_file "$receipt.frontend-bootstrap-1.status.env")"
  echo frontend_smoke_output_sha256="$(bootstrap_stage3_hash_file "$driver")"
  echo frontend_smoke_driver_log_path="$driver"
  echo frontend_smoke_driver_log_sha256="$(bootstrap_stage3_hash_file "$driver")"
  echo candidate_sha256_after="$candidate_sha"
} >"$receipt"

failures=0
bootstrap_stage3_verify_sanity_evidence_receipt "$receipt" "$receipt" "$(dirname -- "$receipt")" "$candidate" "$repo" || {
  echo 'FAIL: valid bound receipt rejected'; failures=$((failures + 1));
}

mv "$receipt.frontend-bootstrap-0.log" "$work/log0.saved"
if bootstrap_stage3_verify_sanity_evidence_receipt "$receipt" "$receipt" "$(dirname -- "$receipt")" "$candidate" "$repo" >/dev/null 2>&1; then
  echo 'FAIL: deleted per-pass log admitted'; failures=$((failures + 1))
fi
mv "$work/log0.saved" "$receipt.frontend-bootstrap-0.log"

cp "$receipt.frontend-bootstrap-1.log" "$work/log1.saved"
printf 'tamper\n' >>"$receipt.frontend-bootstrap-1.log"
if bootstrap_stage3_verify_sanity_evidence_receipt "$receipt" "$receipt" "$(dirname -- "$receipt")" "$candidate" "$repo" >/dev/null 2>&1; then
  echo 'FAIL: tampered per-pass log admitted'; failures=$((failures + 1))
fi
mv "$work/log1.saved" "$receipt.frontend-bootstrap-1.log"

sed '/^frontend_smoke_driver_log_sha256=/d' "$receipt" >"$work/legacy.env"
if bootstrap_stage3_verify_sanity_evidence_receipt "$work/legacy.env" "$work/legacy.env" "$work" "$candidate" "$repo" >/dev/null 2>&1; then
  echo 'FAIL: legacy receipt omission admitted'; failures=$((failures + 1))
fi

cp "$receipt.frontend-bootstrap-0.status.env" "$work/status0.saved"
sed 's/^raw_status=0$/raw_status=124/' "$work/status0.saved" \
  >"$receipt.frontend-bootstrap-0.status.env"
cp "$receipt" "$work/receipt.saved"
tampered_status_sha=$(bootstrap_stage3_hash_file \
  "$receipt.frontend-bootstrap-0.status.env")
sed "s/^frontend_smoke_bootstrap0_status_sha256=.*/frontend_smoke_bootstrap0_status_sha256=$tampered_status_sha/" \
  "$work/receipt.saved" >"$receipt"
if bootstrap_stage3_verify_sanity_evidence_receipt "$receipt" "$receipt" "$(dirname -- "$receipt")" "$candidate" "$repo" >/dev/null 2>&1; then
  echo 'FAIL: hash-consistent nonzero raw status admitted'; failures=$((failures + 1))
fi

[ "$failures" -eq 0 ] || exit 1
echo 'PASS — Stage2 verifier rejects deleted, tampered, and legacy frontend evidence'
