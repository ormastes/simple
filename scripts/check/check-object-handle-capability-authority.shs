#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
out_dir=${SIMPLE_OBJECT_CAP_CHECK_OUT:-/mnt/data/simple-object-capability}
cc_bin=${CC:-cc}
mkdir -p "$out_dir"
"$cc_bin" -std=c11 -O1 -g -pthread -D_GNU_SOURCE \
    -ffunction-sections -fdata-sections -I"$repo_root/src/runtime" \
    "$repo_root/src/runtime/test/rt_object_handle_capability_selfcheck.c" \
    "$repo_root/src/runtime/runtime_native.c" \
    -Wl,--gc-sections -ldl -lm -o "$out_dir/object_capability_selfcheck"
"$out_dir/object_capability_selfcheck"

(cd "$repo_root/src/compiler_rust" && \
    cargo test -p simple-runtime object_handle_authority -- --test-threads=1)

"$repo_root/bin/simple" test \
    "$repo_root/test/01_unit/common/structural/transfer_object_handle_capability_registry_spec.spl" \
    --mode=interpreter
