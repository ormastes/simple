#!/bin/sh
# Fail-closed prerequisite gate for the render_2d Vulkan coverage plan's Wave-3
# units (C1-C3). Per
# doc/03_plan/ui/testing/render_2d_vulkan_functional_coverage_plan_2026-08-07.md
# Unit B1 and doc/08_tracking/bug/coverage_tooling_does_not_instrument_spl_2026-08-07.md,
# no branch-coverage percentage may be reported for this stack until FIVE
# prerequisites land:
#
#   1. Real (non-"<source>", non-0/0) file/line identity at decision probe
#      call sites (interpreter_control.rs, lowering_stmt.rs, lowering_expr_ops.rs).
#   2. Production MIR lowering emits coverage DecisionProbe instructions on
#      the real `simple compile` path (JIT/native), not just Rust unit tests.
#   3. `bin/simple spl-coverage <subcommand>` is dispatchable (not
#      "file not found: spl-coverage").
#   4. SIMPLE_COVERAGE=1 SIMPLE_COVERAGE_OUTPUT=<path> bin/simple test <spec>
#      writes a real, non-empty artifact at <path> (or an equivalent
#      spipe/.spl-runner-reachable export).
#   5. A rollup exists computing taken/not-taken per site into a per-file or
#      per-module hit/total table.
#
# All five prerequisites now have a REAL mechanical probe against the live
# deployed binary (no more UNVERIFIED-BY-SCRIPT placeholders):
#
#   - Prereq 3 runs `spl-coverage status` WITH SIMPLE_COVERAGE=1 set. The
#     subcommand exits 1 by design when coverage is disabled ("Coverage
#     tracking is DISABLED") -- that is documented, expected behavior, not a
#     dispatch failure, so testing it with the env unset was conflating
#     "coverage disabled" with "subcommand unreachable". The only real
#     dispatch-failure signature is the literal `file not found: spl-coverage`
#     string; only that (or an unexpected non-zero exit under an ENABLED env)
#     counts as unmet.
#   - Prereqs 1 and 2 compile a tiny self-contained branching probe file
#     through `bin/simple compile --emit-mir=<path>` TWICE -- once with
#     SIMPLE_COVERAGE unset, once with SIMPLE_COVERAGE=1 -- and inspect the
#     emitted MIR JSON directly. This targets the exact gap the bug doc
#     pinned (interpreter decision-recording was already reachable via
#     `bin/simple test`, so an artifact produced by the test-runner path
#     alone cannot distinguish "interpreter recorded it" from "MIR lowering
#     emitted a real DecisionProbe instruction"; the two prior candidate A/B
#     probes -- interpret-mode vs default `bin/simple test` -- both returned
#     total_decisions=57, an inconclusive result). `--emit-mir` reads MIR
#     straight from the compile pipeline (`pipeline/lowering.rs
#     process_hir_to_mir`), independent of the interpreter and independent
#     of the test runner, so it isolates prereq 2 correctly:
#       2: MIR compiled WITHOUT SIMPLE_COVERAGE has zero DecisionProbe
#          instructions AND MIR compiled WITH SIMPLE_COVERAGE=1 has at least
#          one -- proving the production MIR-lowering path both gates on the
#          env var and actually emits probes when it's set, not merely that
#          some unrelated Rust unit test exercises the coverage-aware
#          lowering function.
#       1: the DecisionProbe instruction's own `file`/`line` fields (parsed
#          out of its Rust Debug-formatted JSON string) name the real probe
#          source path (not `<source>`/`<entry>`/empty) and a positive line
#          number -- checked directly at the MIR instruction, not inferred
#          from a downstream artifact.
#   - Prereqs 4 and 5 exercise a real branching spec end-to-end through
#     `bin/simple test --coverage` with SIMPLE_COVERAGE_OUTPUT set, then (for
#     5) round-trip two independent runs' artifacts through `spl-coverage
#     rollup`:
#       4: the artifact is written and non-empty.
#       5: rolling up two runs of the SAME spec sums the SAME decision id's
#          true_count between the two inputs (checked against a row whose
#          true_count is nonzero in each input, so a broken/no-op merge that
#          happened to compare 0+0=0 could not read as a false MET) rather
#          than deduplicating or silently dropping -- the strongest
#          available signal that the merge is real arithmetic, not a
#          passthrough of one input.
#
# This script never overrides a probe that legitimately fails: any of the
# checks below can report UNMET on evidence, and MET is only ever printed
# when the underlying binary/artifact test observably held.
#
# Verdict is always the LAST line of stdout:
#   PASS — <n> prerequisite(s) checked, all met (branch-coverage % may be reported)
#   FAIL — <n> prerequisite(s) checked, <m> unmet (do not report a percentage)
#   ERROR — nothing was checked
#
# Exit codes: 0 PASS, 1 FAIL, 2 ERROR.

SELF="check-render2d-coverage"

err() {
    echo "$SELF: ERROR — $*" >&2
    echo "$SELF: ERROR — nothing was checked"
    exit 2
}

# Fail-closed on cwd: must run from a real repo root, not an archive worktree.
toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || err "not inside a git working tree"
cd "$toplevel" || err "cannot cd to repo toplevel $toplevel"
[ -e "$toplevel/.git" ] || err "no .git at repo toplevel — refusing to check an archive worktree"

BIN="$toplevel/bin/simple"
[ -x "$BIN" ] || err "bin/simple not found or not executable at $BIN"

checked=0
unmet=0
report=""

add_result() {
    # $1 = name, $2 = 0 (met) or 1 (unmet), $3 = detail
    checked=$((checked + 1))
    if [ "$2" -ne 0 ]; then
        unmet=$((unmet + 1))
    fi
    report="$report
  [$([ "$2" -eq 0 ] && echo MET || echo UNMET)] $1 -- $3"
}

# --- Prerequisite 3: spl-coverage subcommand dispatchable ---------------
# Probe WITH SIMPLE_COVERAGE=1 so a documented disabled-by-default exit (1)
# cannot be mistaken for the subcommand being unreachable. The only unmet
# signature is the literal dispatch-failure string, or a non-zero exit while
# coverage IS enabled (which would mean the subcommand itself errored, not
# that it's absent from the dispatch table).
p3_out=$(SIMPLE_COVERAGE=1 "$BIN" spl-coverage status 2>&1)
p3_rc=$?
if echo "$p3_out" | grep -q "file not found: spl-coverage"; then
    add_result "prereq3_spl_coverage_dispatchable" 1 "SIMPLE_COVERAGE=1 bin/simple spl-coverage status -> 'file not found: spl-coverage'"
elif [ "$p3_rc" -eq 0 ] && echo "$p3_out" | grep -q "Coverage tracking is ENABLED"; then
    add_result "prereq3_spl_coverage_dispatchable" 0 "SIMPLE_COVERAGE=1 bin/simple spl-coverage status exited 0, reported ENABLED"
else
    add_result "prereq3_spl_coverage_dispatchable" 1 "SIMPLE_COVERAGE=1 bin/simple spl-coverage status exited $p3_rc, output: $(echo "$p3_out" | grep -v '^WARNING\|^warning\|^\[' | head -3 | tr '\n' ' ')"
fi

# --- Prerequisites 1 and 2: MIR-level A/B probe, isolated from the ----
# interpreter and from the test-runner path (see header rationale).
MIR_PROBE_SRC="$(mktemp -u /tmp/check-render2d-coverage-mir-probe.XXXXXX.spl)"
cat > "$MIR_PROBE_SRC" <<'PROBE_EOF'
fn classify(x: i64) -> i64:
    if x > 0:
        1
    else:
        0

fn main() -> i64:
    classify(5)
PROBE_EOF

MIR_NOCOV="$(mktemp -u /tmp/check-render2d-coverage-mir-nocov.XXXXXX.json)"
MIR_COV="$(mktemp -u /tmp/check-render2d-coverage-mir-cov.XXXXXX.json)"
OUT_NOCOV="$(mktemp -u /tmp/check-render2d-coverage-out-nocov.XXXXXX)"
OUT_COV="$(mktemp -u /tmp/check-render2d-coverage-out-cov.XXXXXX)"
rm -f "$MIR_NOCOV" "$MIR_COV" "$OUT_NOCOV" "$OUT_COV"

"$BIN" compile "$MIR_PROBE_SRC" "--emit-mir=$MIR_NOCOV" -o "$OUT_NOCOV" >/tmp/check-render2d-coverage-compile-nocov.$$ 2>&1
SIMPLE_COVERAGE=1 "$BIN" compile "$MIR_PROBE_SRC" "--emit-mir=$MIR_COV" -o "$OUT_COV" >/tmp/check-render2d-coverage-compile-cov.$$ 2>&1

nocov_probes=0
cov_probes=0
[ -f "$MIR_NOCOV" ] && nocov_probes=$(grep -c '"DecisionProbe"' "$MIR_NOCOV" 2>/dev/null)
[ -f "$MIR_COV" ] && cov_probes=$(grep -c '"DecisionProbe"' "$MIR_COV" 2>/dev/null)
[ -z "$nocov_probes" ] && nocov_probes=0
[ -z "$cov_probes" ] && cov_probes=0

# --- Prerequisite 2: production MIR lowering gates on SIMPLE_COVERAGE ---
if [ ! -f "$MIR_NOCOV" ] || [ ! -f "$MIR_COV" ]; then
    add_result "prereq2_production_mir_coverage_lowering" 1 "bin/simple compile --emit-mir did not produce one or both MIR dumps (nocov=$MIR_NOCOV cov=$MIR_COV) -- cannot probe"
elif [ "$cov_probes" -gt 0 ] && [ "$nocov_probes" -eq 0 ]; then
    add_result "prereq2_production_mir_coverage_lowering" 0 "bin/simple compile MIR: SIMPLE_COVERAGE=1 emits $cov_probes DecisionProbe instruction(s), unset emits $nocov_probes -- production MIR lowering path gates on and emits real probes"
elif [ "$cov_probes" -eq 0 ]; then
    add_result "prereq2_production_mir_coverage_lowering" 1 "bin/simple compile MIR: SIMPLE_COVERAGE=1 emits 0 DecisionProbe instructions for a branching probe file -- production MIR lowering still does not emit probes"
else
    add_result "prereq2_production_mir_coverage_lowering" 1 "bin/simple compile MIR: DecisionProbe emitted regardless of SIMPLE_COVERAGE (nocov=$nocov_probes, cov=$cov_probes) -- gating is not env-conditional as claimed"
fi

# --- Prerequisite 1: DecisionProbe carries real file/line identity ------
if [ ! -s "$MIR_COV" ] || [ "$cov_probes" -eq 0 ]; then
    add_result "prereq1_real_source_spans" 1 "no DecisionProbe instruction available in $MIR_COV to inspect (prereq2 already unmet)"
else
    # Anchor to lines that directly follow a `"kind": "DecisionProbe"` marker
    # so a coincidental `file:`/`line:` pair on some OTHER instruction's debug
    # string cannot satisfy this prerequisite -- only a debug string that is
    # provably part of a DecisionProbe instruction (verified against real
    # `--emit-mir` output: kind and debug are adjacent JSON object fields)
    # counts.
    probe_id_line=$(grep -A1 '"kind": "DecisionProbe"' "$MIR_COV" | sed -n 's/.*file: \\"\([^\\]*\)\\", line: \([0-9]*\).*/\1|\2/p' | head -1)
    probe_file=$(printf '%s\n' "$probe_id_line" | cut -d'|' -f1)
    probe_line=$(printf '%s\n' "$probe_id_line" | cut -d'|' -f2)
    if [ -z "$probe_id_line" ]; then
        add_result "prereq1_real_source_spans" 1 "could not parse file/line out of any DecisionProbe debug string in $MIR_COV"
    else
        case "$probe_file" in
            ''|'<'*)
                add_result "prereq1_real_source_spans" 1 "DecisionProbe file field is fabricated/empty: '$probe_file'"
                ;;
            *)
                case "$probe_line" in
                    ''|*[!0-9]*|0)
                        add_result "prereq1_real_source_spans" 1 "DecisionProbe file='$probe_file' but line field is fabricated/absent: '$probe_line'"
                        ;;
                    *)
                        if [ "$probe_file" = "$MIR_PROBE_SRC" ]; then
                            add_result "prereq1_real_source_spans" 0 "DecisionProbe carries real identity matching the compiled source: file='$probe_file' line=$probe_line"
                        else
                            add_result "prereq1_real_source_spans" 0 "DecisionProbe carries a real (non-fabricated) file identity: file='$probe_file' line=$probe_line (does not exactly match probe path '$MIR_PROBE_SRC', but is a real path/line, not '<source>' or 0,0)"
                        fi
                        ;;
                esac
                ;;
        esac
    fi
fi

rm -f "$MIR_PROBE_SRC" "$MIR_NOCOV" "$MIR_COV" "$OUT_NOCOV" "$OUT_COV" \
    /tmp/check-render2d-coverage-compile-nocov.$$ /tmp/check-render2d-coverage-compile-cov.$$

# --- Prerequisites 4 and 5: exercise a real branching spec end-to-end ---
# Use a real branching spec from this plan's own module set so a false PASS
# can't hide behind an empty/degenerate spec.
PROBE_SPEC="test/01_unit/lib/common/gpu/engine2d/scalar_oracle_spec.spl"
if [ ! -f "$PROBE_SPEC" ]; then
    add_result "prereq4_artifact_export" 1 "probe spec missing: $PROBE_SPEC (cannot probe export)"
    add_result "prereq5_perfile_rollup" 1 "probe spec missing: $PROBE_SPEC (cannot probe)"
else
    ARTIFACT_A="$(mktemp -u /tmp/check-render2d-coverage-artifact-a.XXXXXX.sdn)"
    rm -f "$ARTIFACT_A"
    SIMPLE_COVERAGE=1 SIMPLE_COVERAGE_OUTPUT="$ARTIFACT_A" \
        "$BIN" test "$PROBE_SPEC" --coverage --no-cache >/tmp/check-render2d-coverage-testout-a.$$ 2>&1

    # --- Prerequisite 4: artifact export on the spipe/.spl runner path ---
    if [ -s "$ARTIFACT_A" ]; then
        add_result "prereq4_artifact_export" 0 "artifact written and non-empty at $ARTIFACT_A"
    else
        add_result "prereq4_artifact_export" 1 "SIMPLE_COVERAGE_OUTPUT artifact not written (checked $ARTIFACT_A); stdout only has line-% banners, no export"
    fi

    if [ -s "$ARTIFACT_A" ]; then
        # --- Prerequisite 5: rollup performs a real per-site sum, not a ---
        # dedup/passthrough. Run the SAME spec a second time to get an
        # independent artifact, roll both up, and confirm a decision id's
        # true_count in the rollup equals the sum of the two inputs' counts
        # for that id (not just equal to one input, which would indicate
        # silent overwrite/dedup instead of a real merge). Prefer a row
        # whose true_count is nonzero in BOTH inputs so 0+0=0 can't read as
        # a false MET.
        decisions_block=$(awk '/^decisions \|/{f=1;next} f && /^$/{exit} f{print}' "$ARTIFACT_A")
        real_rows=$(printf '%s\n' "$decisions_block" | grep -v '<entry>' | grep -v '<source>' | grep -v '^[[:space:]]*$')
        real_row=$(printf '%s\n' "$real_rows" | awk -F', ' '{gsub(/^ +| +$/,"",$5); if ($5+0 > 0) {print; exit}}')
        if [ -z "$real_row" ]; then
            real_row=$(printf '%s\n' "$real_rows" | head -1)
        fi

        ARTIFACT_B="$(mktemp -u /tmp/check-render2d-coverage-artifact-b.XXXXXX.sdn)"
        rm -f "$ARTIFACT_B"
        SIMPLE_COVERAGE=1 SIMPLE_COVERAGE_OUTPUT="$ARTIFACT_B" \
            "$BIN" test "$PROBE_SPEC" --coverage --no-cache >/tmp/check-render2d-coverage-testout-b.$$ 2>&1

        if [ -z "$real_row" ]; then
            add_result "prereq5_perfile_rollup" 1 "no usable decision row found in $ARTIFACT_A to track through rollup"
        elif [ ! -s "$ARTIFACT_B" ]; then
            add_result "prereq5_perfile_rollup" 1 "second probe run did not produce an artifact at $ARTIFACT_B -- cannot test rollup merge"
        else
            id_field=$(printf '%s\n' "$real_row" | awk -F', ' '{print $1}' | sed 's/^ *//;s/ *$//')
            a_row=$(grep "^ *$id_field," "$ARTIFACT_A" | head -1)
            b_row=$(grep "^ *$id_field," "$ARTIFACT_B" | head -1)
            a_true=$(printf '%s\n' "$a_row" | awk -F', ' '{print $5}' | sed 's/^ *//;s/ *$//')
            b_true=$(printf '%s\n' "$b_row" | awk -F', ' '{print $5}' | sed 's/^ *//;s/ *$//')
            ROLLUP_OUT="$(mktemp -u /tmp/check-render2d-coverage-rollup.XXXXXX.sdn)"
            rm -f "$ROLLUP_OUT"
            rollup_out=$("$BIN" spl-coverage rollup --file "$ARTIFACT_A" --file "$ARTIFACT_B" --out "$ROLLUP_OUT" 2>&1)
            if ! printf '%s\n' "$rollup_out" | grep -q "Rolled up 2 artifact"; then
                add_result "prereq5_perfile_rollup" 1 "rollup command did not report success: $(printf '%s\n' "$rollup_out" | grep -v '^WARNING\|^warning\|^\[' | head -2 | tr '\n' ' ')"
            elif [ ! -s "$ROLLUP_OUT" ]; then
                add_result "prereq5_perfile_rollup" 1 "rollup reported success but wrote no/empty output at $ROLLUP_OUT"
            else
                r_row=$(grep "^ *$id_field," "$ROLLUP_OUT" | head -1)
                r_true=$(printf '%s\n' "$r_row" | awk -F', ' '{print $5}' | sed 's/^ *//;s/ *$//')
                r_file=$(printf '%s\n' "$r_row" | awk -F', ' '{print $2}' | sed 's/^ *//;s/ *$//')
                case "$r_file" in
                    ''|'<'*)
                        add_result "prereq5_perfile_rollup" 1 "rollup row for id=$id_field has fabricated/absent file identity '$r_file' -- this is a per-FILE hit/total table requirement, not just a summed counter"
                        ;;
                    *)
                        case "$a_true$b_true$r_true" in
                            *[!0-9]*|"")
                                add_result "prereq5_perfile_rollup" 1 "could not parse true_count for decision id=$id_field across a='$a_true' b='$b_true' rollup='$r_true'"
                                ;;
                            *)
                                expected=$((a_true + b_true))
                                # Require a_true -gt 0 (nonzero input) in ALL
                                # met branches, not just the labeled one -- a
                                # degenerate 0+0=0 merge must never read MET,
                                # even though it numerically satisfies
                                # r_true -eq expected.
                                if [ "$r_true" -eq "$expected" ] && [ "$a_true" -gt 0 ]; then
                                    add_result "prereq5_perfile_rollup" 0 "rollup of two runs sums per-decision hits for id=$id_field: $a_true + $b_true = $r_true, file identity preserved ('$r_file') (nonzero inputs, real merge, not dedup/passthrough)"
                                else
                                    add_result "prereq5_perfile_rollup" 1 "rollup for id=$id_field expected $a_true+$b_true=$expected but got $r_true, or inputs were degenerate (a_true=$a_true) -- merge is not summing or nonzero-input requirement unmet"
                                fi
                                ;;
                        esac
                        ;;
                esac
            fi
            rm -f "$ROLLUP_OUT"
        fi
        rm -f "$ARTIFACT_B" /tmp/check-render2d-coverage-testout-b.$$
    else
        add_result "prereq5_perfile_rollup" 1 "no artifact at $ARTIFACT_A to inspect (prereq4 already unmet)"
    fi
    rm -f "$ARTIFACT_A" /tmp/check-render2d-coverage-testout-a.$$
fi

echo "$SELF: prerequisite detail:$report"

if [ "$checked" -eq 0 ]; then
    err "no prerequisites were checked"
fi

if [ "$unmet" -eq 0 ]; then
    echo "$SELF: PASS — $checked prerequisite(s) checked, all met (branch-coverage % may be reported)"
    exit 0
else
    echo "$SELF: FAIL — $checked prerequisite(s) checked, $unmet unmet (do not report a branch-coverage percentage; see doc/08_tracking/bug/coverage_tooling_does_not_instrument_spl_2026-08-07.md)"
    exit 1
fi
