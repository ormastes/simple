#!/bin/sh
# Replay db-server-request-port/v2 evidence. Legacy v1 remains generic.
set -eu
LC_ALL=C; export LC_ALL
fail() { echo "STATUS: FAIL db-server-request-port-evidence — $*" >&2; exit 1; }
field() { [ "$(grep -c "^$2=" "$1" 2>/dev/null || true)" -eq 1 ] || return 1; sed -n "s/^$2=//p" "$1"; }
eqf() { v=$(field "$1" "$2") || fail "missing-or-duplicate-$2"; [ "$v" = "$3" ] || fail "$2-mismatch"; }
sha() { sha256sum "$1" | awk '{print $1}'; }
hex() { od -An -v -t x1 "$1" | tr -d ' \n'; }
uint() { case "$1" in ''|*[!0-9]*) return 1;; esac; }
SESSION= QUERY= RESULT= SERVER= CLOSURE= ORIGIN= TRACE= TREE= COMPILER= PROVENANCE= TOOLCHAIN= TARGET= FINGERPRINT= RUN_ID=
while [ "$#" -gt 0 ]; do case "$1" in
 --session) SESSION=$2;; --query) QUERY=$2;; --result) RESULT=$2;; --server-executable) SERVER=$2;;
 --source-closure) CLOSURE=$2;; --build-origin) ORIGIN=$2;; --kernel-trace) TRACE=$2;; --process-tree) TREE=$2;;
 --stage4-compiler) COMPILER=$2;; --stage4-provenance) PROVENANCE=$2;; --toolchain) TOOLCHAIN=$2;;
 --target) TARGET=$2;; --fingerprint) FINGERPRINT=$2;; --run-id) RUN_ID=$2;; *) fail "unknown-argument-$1";; esac; shift 2; done
for f in "$SESSION" "$QUERY" "$RESULT" "$SERVER" "$CLOSURE" "$ORIGIN" "$TRACE" "$TREE" "$COMPILER" "$PROVENANCE" "$TOOLCHAIN" "$TARGET"; do [ -f "$f" ] && [ ! -L "$f" ] || fail missing-input; done
eqf "$SESSION" session_schema simple.db-server-request-port-session/v2
eqf "$SESSION" gate_id db-server-request-port; eqf "$SESSION" source_fingerprint "$FINGERPRINT"; eqf "$SESSION" run_id "$RUN_ID"
for pair in transport:tcp listen_host:127.0.0.1 client_host:127.0.0.1 readiness_status:READY request_status:SENT result_status:RECEIVED server_exit_status:0 client_exit_status:0 stop_status:CLEAN no_leak:true listener_absent_after_stop:true direct_function_simulation:false final_verdict:PASS; do k=${pair%%:*}; v=${pair#*:}; eqf "$SESSION" "$k" "$v"; done
port=$(field "$SESSION" configured_port) || fail configured-port; observed=$(field "$SESSION" observed_port) || fail observed-port
uint "$port" && [ "$port" -ge 1024 ] && [ "$port" -le 65535 ] && [ "$observed" = "$port" ] || fail invalid-port
server_pid=$(field "$SESSION" server_pid) || fail server-pid; owner=$(field "$SESSION" listener_owner_pid) || fail owner-pid; pgid=$(field "$SESSION" process_group_id) || fail process-group
uint "$server_pid" && uint "$pgid" && [ "$owner" = "$server_pid" ] || fail listener-owner
eqf "$SESSION" process_tree_complete true; eqf "$SESSION" descendant_count_after_stop 0; eqf "$SESSION" accepted_connection_count 1
ready=$(field "$SESSION" ready_monotonic_ms) || fail ready-time; accept=$(field "$SESSION" accept_monotonic_ms) || fail accept-time; read_t=$(field "$SESSION" read_monotonic_ms) || fail read-time; write_t=$(field "$SESSION" write_monotonic_ms) || fail write-time; stop_start=$(field "$SESSION" stop_start_monotonic_ms) || fail stop-start; stop_done=$(field "$SESSION" stop_done_monotonic_ms) || fail stop-done; budget=$(field "$SESSION" stop_budget_ms) || fail stop-budget
for n in "$ready" "$accept" "$read_t" "$write_t" "$stop_start" "$stop_done" "$budget"; do uint "$n" || fail invalid-monotonic-time; done
[ "$ready" -le "$accept" ] && [ "$accept" -le "$read_t" ] && [ "$read_t" -le "$write_t" ] && [ "$write_t" -le "$stop_start" ] && [ "$stop_start" -le "$stop_done" ] || fail unordered-monotonic-events
[ $((stop_done - stop_start)) -le "$budget" ] || fail stop-interval-over-budget
eqf "$SESSION" query_sha256 "$(sha "$QUERY")"; eqf "$SESSION" query_hex "$(hex "$QUERY")"; eqf "$SESSION" query_bytes "$(wc -c <"$QUERY" | tr -d ' ')"
eqf "$SESSION" result_sha256 "$(sha "$RESULT")"; eqf "$SESSION" result_hex "$(hex "$RESULT")"; eqf "$SESSION" result_bytes "$(wc -c <"$RESULT" | tr -d ' ')"; [ -s "$QUERY" ] && [ -s "$RESULT" ] || fail empty-wire-payload
for pair in server_executable:$SERVER source_closure:$CLOSURE build_origin:$ORIGIN kernel_trace:$TRACE process_tree:$TREE stage4_compiler:$COMPILER stage4_provenance:$PROVENANCE toolchain_identity:$TOOLCHAIN target_identity:$TARGET; do k=${pair%%:*}; f=${pair#*:}; eqf "$SESSION" "${k}_sha256" "$(sha "$f")"; done
eqf "$ORIGIN" origin_schema simple.db-server-build-origin/v1; eqf "$ORIGIN" gate_id db-server-request-port; eqf "$ORIGIN" run_id "$RUN_ID"; eqf "$ORIGIN" source_fingerprint "$FINGERPRINT"
eqf "$ORIGIN" clean_committed_source true; eqf "$ORIGIN" entry_path src/app/database_server/main.spl; eqf "$ORIGIN" query_path test/fixtures/database/server/request_port_query.bin
eqf "$ORIGIN" closed_environment true; eqf "$ORIGIN" simple_no_stub_fallback 1; eqf "$ORIGIN" build_exit_status 0; eqf "$ORIGIN" final_verdict PASS
eqf "$ORIGIN" compiler_sha256 "$(sha "$COMPILER")"; eqf "$ORIGIN" provenance_sha256 "$(sha "$PROVENANCE")"; eqf "$ORIGIN" source_closure_sha256 "$(sha "$CLOSURE")"; eqf "$ORIGIN" executable_sha256 "$(sha "$SERVER")"
eqf "$PROVENANCE" schema simple-bootstrap-stage4-provenance-v1
eqf "$TOOLCHAIN" evidence_schema simple.must-check-toolchain/v1; eqf "$TOOLCHAIN" gate_id db-server-request-port; eqf "$TOOLCHAIN" run_id "$RUN_ID"; eqf "$TOOLCHAIN" final_verdict PASS
eqf "$TARGET" evidence_schema simple.must-check-target/v1; eqf "$TARGET" gate_id db-server-request-port; eqf "$TARGET" run_id "$RUN_ID"; eqf "$TARGET" final_verdict PASS
eqf "$TRACE" trace_schema simple.db-server-kernel-io/v1; eqf "$TRACE" gate_id db-server-request-port; eqf "$TRACE" run_id "$RUN_ID"; eqf "$TRACE" server_pid "$server_pid"; eqf "$TRACE" listener_owner_pid "$server_pid"
eqf "$TRACE" accept_observed true; eqf "$TRACE" read_observed true; eqf "$TRACE" write_observed true; eqf "$TRACE" read_bytes "$(wc -c <"$QUERY" | tr -d ' ')"; eqf "$TRACE" write_bytes "$(wc -c <"$RESULT" | tr -d ' ')"; eqf "$TRACE" query_sha256 "$(sha "$QUERY")"; eqf "$TRACE" result_sha256 "$(sha "$RESULT")"; eqf "$TRACE" final_verdict PASS
eqf "$TREE" tree_schema simple.db-server-process-tree/v1; eqf "$TREE" process_group_id "$pgid"; eqf "$TREE" server_pid "$server_pid"; eqf "$TREE" descendant_count_after_stop 0; eqf "$TREE" listener_absent_after_stop true; eqf "$TREE" final_verdict PASS
echo 'STATUS: PASS db-server-request-port-evidence — v2 build origin, wire bytes, kernel I/O, ownership, ordered lifecycle, and clean stop validated'
