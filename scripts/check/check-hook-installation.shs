#!/bin/sh
# check-hook-installation.shs — fence the pre-push hook WIRING itself.
#
# Why this exists (2026-08-11, the FOURTH tree wipe: 6f86ff32a7d wiped 113,027
# tracked files including all of src/). Every content guard was SOUND — replayed
# against the incident range, check-tree-size-push.shs FAILs exit 1 as designed.
# The wipe landed anyway because the hook that INVOKES those guards never ran,
# for two independent, silent, fail-OPEN reasons:
#
#   1. .git/config carried  core.hooksPath = /tmp/simple-stage4-push.85KIAn/.git-hooks
#      — a temp directory that no longer exists. Git does not warn when hooksPath
#      points at a missing directory; it simply runs no hooks at all, and the
#      .git/hooks/pre-push symlink is bypassed entirely.
#   2. The hook target scripts/check/pre-push-conflict-tree-guard.shs was mode
#      0664, not executable. Git's only signal is a `hint:` line buried in push
#      output that nobody reads, and it proceeds with the push.
#
# Either defect alone silently downgrades EVERY guard in this repo to advisory.
# Neither is visible in `git status`, in any guard verdict, or in a normal push.
# The content guards cannot detect this — a guard that is never invoked cannot
# report that it was never invoked. That is what this script is for.
#
# It is NOT a content guard. It answers one question: if I push right now, will
# the guards actually run? Run it before any plumbing landing, and the pre-push
# hook runs it first so a half-installed hook fails loudly instead of open.
#
# Verdict convention matches the other guards — last line of stdout:
#   PASS  — <n> check(s) performed, hook wiring intact       exit 0
#   FAIL  — ...                                              exit 1
#   ERROR — nothing was checked                              exit 2
# A run that performs 0 checks is an ERROR, never a pass.
#
# `--selftest` (added 2026-09-24): started as a POSIX-portable,
# filesystem-free fixture for the absolute-path test below
# (`is_absolute_path`) -- the defect there is pure string logic (does a
# `case` pattern recognize a Windows drive-letter path as absolute?), which
# does not need a live filesystem to prove, and a literal
# different-drive-letter fixture would not be portable to CI hosts that have
# no D: drive at all. Extended 2026-09-25 (Opus review, SHOULD finding #2)
# with ONE real-git-repo fixture for the PASS-only cache added that day: the
# cache key hashed $expected_guard's CONTENT but not its exec bit, while
# check 5 blocks on exec bit alone, so a cached PASS survived a bare
# `chmod -x` with zero bytes touched. That defect needs a real filesystem to
# reproduce, so this one fixture is not string-only like the other six.

set -u

name="check-hook-installation"
checks=0
fails=0

fail() {
    fails=$((fails + 1))
    printf '%s: DEFECT — %s\n' "$name" "$1"
    [ -n "${2:-}" ] && printf '    fix: %s\n' "$2"
}

# A path is absolute if it starts with `/` (POSIX / Git-Bash-mounted), or
# with a Windows drive letter spelled either forward-slash style
# (`C:/Users/...`, what `git rev-parse --path-format=absolute
# --git-common-dir` actually emits under Git for Windows) or backslash
# style (`C:\Users\...`). Only the forward-slash form was recognized before
# 2026-09-24 (see origin b8075e146c0); the backslash form fell through to
# the `*)` branch and was joined onto `$repo_root`, producing a broken
# concatenation like `D:/some-worktree/C:\Users\...\.git` whenever a
# worktree's root lives under a different path/drive than the git-common-dir
# — the exact shape that made `no pre-push hook at
# D:/wk-.../C:/Users/.../hooks/pre-push` report a path that can never exist,
# independent of whether the hook was actually installed. Mirrors the same
# fix in scripts/check/check-no-document-symlinks-push.shs (WP5).
is_absolute_path() {
    case "$1" in
        /*) return 0 ;;
        [A-Za-z]:/*) return 0 ;;
        [A-Za-z]:\\*) return 0 ;;
        *) return 1 ;;
    esac
}

selftest() {
    _rc=0

    if is_absolute_path "C:/Users/ormas/dev/simple/.git"; then
        echo "selftest 1 (forward-slash drive-letter path recognized as absolute): ok"
    else
        echo "selftest 1 FAILED: C:/Users/ormas/dev/simple/.git was not recognized as absolute"
        _rc=1
    fi

    if is_absolute_path 'C:\Users\ormas\dev\simple\.git'; then
        echo 'selftest 2 (backslash-style drive-letter path recognized as absolute): ok'
    else
        echo 'selftest 2 FAILED: C:\Users\ormas\dev\simple\.git was not recognized as absolute (this was the residual gap before this fix)'
        _rc=1
    fi

    if is_absolute_path "/home/ormas/dev/simple/.git"; then
        echo "selftest 3 (plain POSIX absolute path recognized as absolute): ok"
    else
        echo "selftest 3 FAILED: /home/ormas/dev/simple/.git was not recognized as absolute"
        _rc=1
    fi

    if is_absolute_path "relative/.git"; then
        echo "selftest 4 FAILED: relative/.git was incorrectly treated as absolute"
        _rc=1
    else
        echo "selftest 4 (relative path correctly NOT treated as absolute): ok"
    fi

    # End-to-end fixture for the reported shape: a worktree ROOT under one
    # path/drive (e.g. a `D:/wk-*` worktree) and a git-common-dir under a
    # DIFFERENT one (the shared main clone's `C:/Users/.../.git`) — the exact
    # cross-drive-worktree scenario from the real incident. Exercises the
    # identical join logic used at the real call site (`git_dir=...; case
    # "$git_dir" in ...) ;; *) git_dir="$repo_root/$git_dir" ;; esac`), so a
    # drift between this fixture and that call site is impossible: both call
    # the same `is_absolute_path`.
    _repo_root="D:/wk-selftest-worktree-fixture-not-a-real-checkout"
    _git_dir="C:/Users/selftest/dev/simple/.git"
    if is_absolute_path "$_git_dir"; then
        _resolved="$_git_dir"
    else
        _resolved="$_repo_root/$_git_dir"
    fi
    if [ "$_resolved" = "$_git_dir" ]; then
        echo "selftest 5 (cross-drive worktree root + drive-letter git-common-dir resolves without concatenation): ok"
    else
        echo "selftest 5 FAILED: got '$_resolved', expected the unmodified '$_git_dir' -- this is exactly the reported defect's shape (worktree root wrongly prepended onto an already-absolute git-common-dir)"
        _rc=1
    fi

    # Same fixture, backslash-style git-common-dir -- this is the case that
    # was still broken by the 2026-09-24-b8075e146c0 fix (single-backslash
    # `[A-Za-z]:\*` pattern, which matches a literal trailing `*` character,
    # not "backslash followed by anything").
    _git_dir_bs='C:\Users\selftest\dev\simple\.git'
    if is_absolute_path "$_git_dir_bs"; then
        _resolved_bs="$_git_dir_bs"
    else
        _resolved_bs="$_repo_root/$_git_dir_bs"
    fi
    if [ "$_resolved_bs" = "$_git_dir_bs" ]; then
        echo "selftest 6 (cross-drive worktree root + BACKSLASH-style drive-letter git-common-dir resolves without concatenation): ok"
    else
        echo "selftest 6 FAILED: got '$_resolved_bs', expected the unmodified '$_git_dir_bs'"
        _rc=1
    fi

    return $_rc
}

# selftest_cache_exec_bit (Opus review 2026-09-25, SHOULD finding #2): a real
# throwaway git repo wired so every one of the 12 checks below passes, run
# through THIS SAME SCRIPT (via SELF_SCRIPT_PATH, resolved before this
# function is ever called). First run must PASS and write the cache; a bare
# `chmod -x` on $expected_guard afterward (no byte of any file touched) must
# invalidate that cached PASS and produce a real FAIL, not a stale short-circuit
# -- exactly the gap the guardExec fingerprint field above was added to close.
#
# PLATFORM PROBE FIRST: on an NTFS `noacl` Git-for-Windows/MSYS mount
# (confirmed present on this host, 2026-09-25), the exec bit `[ -x ]` reports
# is derived from file CONTENT (a `#!` shebang), not a real independent
# permission bit -- `chmod +x`/`chmod -x` are accepted but do not change what
# `[ -x ]` reports, on either a brand-new file or an existing tracked one.
# That is a genuine host limitation, not a defect in the fix: on a real POSIX
# filesystem (Linux, macOS, WSL, and this repo's own CI runners) `chmod -x`
# unconditionally clears the bit `[ -x ]` reports, independent of content,
# which is exactly the gap the review flagged. Running the byte-for-byte
# fixture on a host where it cannot possibly reproduce would either hang on
# an unreachable code path or silently pass for the wrong reason; probing
# first and reporting which path ran keeps this honest instead of either.
_cache_exec_bit_probe_supported() {
    _pb_dir=$(mktemp -d 2>/dev/null) || return 1
    printf 'plain, no shebang\n' > "$_pb_dir/plain"
    printf '#!/bin/sh\nexit 0\n' > "$_pb_dir/shebanged"
    chmod +x "$_pb_dir/plain"
    chmod -x "$_pb_dir/shebanged"
    _pb_ok=1
    [ -x "$_pb_dir/plain" ] || _pb_ok=0
    [ ! -x "$_pb_dir/shebanged" ] || _pb_ok=0
    rm -rf "$_pb_dir"
    [ "$_pb_ok" -eq 1 ]
}
selftest_cache_exec_bit() {
    if ! _cache_exec_bit_probe_supported; then
        echo "selftest-cache-exec-bit SKIPPED (reason recorded, not silent): this host's filesystem derives"
        echo "  [ -x ] from file content (a shebang line), not an independent permission bit -- chmod"
        echo "  cannot toggle it here, so the live PASS/chmod-x/FAIL round trip cannot reproduce."
        echo "  Falling back to a static check that the fix is actually present in the source:"
        if grep -Eq '^[[:space:]]*_guard_exec_bit=' "$SELF_SCRIPT_PATH" 2>/dev/null &&
           grep -q "printf 'guardExec=%s" "$SELF_SCRIPT_PATH" 2>/dev/null; then
            echo "  ok: the running script computes \$_guard_exec_bit and folds a guardExec= field into the cache fingerprint."
            return 0
        fi
        echo "  FAILED: the running script no longer computes/folds a guardExec= fingerprint field."
        return 1
    fi
    _cx_tmp=$(mktemp -d 2>/dev/null) || { echo "selftest-cache-exec-bit FAILED: mktemp -d failed"; return 1; }
    _cx_repo="$_cx_tmp/repo"
    mkdir -p "$_cx_repo/scripts/hooks" "$_cx_repo/scripts/check" "$_cx_repo/.git/hooks"
    (
        cd "$_cx_repo" || exit 1
        git init -q
        git config user.email t@example.com
        git config user.name t
        printf 'launcher\n' > scripts/hooks/pre-push-worktree-launcher
        printf 'dispatcher\n' > scripts/hooks/pre-push
        printf '#!/bin/sh\nexit 0\n' > scripts/check/pre-push-conflict-tree-guard.shs
        chmod +x scripts/check/pre-push-conflict-tree-guard.shs
        : > scripts/check/check-tree-size-push.shs
        : > scripts/check/check-no-conflict-tree-push.shs
        : > scripts/check/check-no-conflict-markers-push.shs
        : > scripts/check/check-no-revert-push.shs
        : > scripts/check/check-core-bare-sanity.shs
        cp "$SELF_SCRIPT_PATH" scripts/check/check-hook-installation.shs 2>/dev/null || : > scripts/check/check-hook-installation.shs
        # The actual git hook: byte-identical to the launcher, so check 4's
        # `cmp -s "$hook" "$expected_launcher"` fallback is satisfied without
        # needing a real symlink (not reliably creatable on every host).
        cp scripts/hooks/pre-push-worktree-launcher .git/hooks/pre-push
        chmod +x .git/hooks/pre-push
        git add -A
        git commit -q -m fixture
    ) >/dev/null 2>&1

    _cx_out1=$(cd "$_cx_repo" && sh "$SELF_SCRIPT_PATH" 2>&1)
    _cx_rc1=$?
    if [ "$_cx_rc1" -ne 0 ]; then
        echo "selftest-cache-exec-bit FAILED: fixture's first (should-PASS) run did not pass: rc=$_cx_rc1 out=$_cx_out1"
        rm -rf "$_cx_tmp"
        return 1
    fi
    if [ ! -f "$_cx_repo/.git/simple-hook-install-check.cache" ]; then
        echo "selftest-cache-exec-bit FAILED: no cache file was written after a PASS"
        rm -rf "$_cx_tmp"
        return 1
    fi

    chmod -x "$_cx_repo/scripts/check/pre-push-conflict-tree-guard.shs"
    _cx_out2=$(cd "$_cx_repo" && sh "$SELF_SCRIPT_PATH" 2>&1)
    _cx_rc2=$?
    rm -rf "$_cx_tmp"
    if [ "$_cx_rc2" -eq 0 ]; then
        echo "selftest-cache-exec-bit FAILED: a bare chmod -x on the guard driver was served a STALE CACHED PASS (rc=0) instead of re-running and failing: $_cx_out2"
        return 1
    fi
    echo "selftest-cache-exec-bit (chmod -x on the guard driver after a cached PASS invalidates the cache and re-fails) -> ok"
    return 0
}

SELF_SCRIPT_PATH=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P)/$(basename -- "$0")

case "${1:-}" in
    --selftest)
        _st_ok=1
        selftest || _st_ok=0
        selftest_cache_exec_bit || _st_ok=0
        if [ "$_st_ok" -eq 1 ]; then
            echo "selftest: 7 fixture(s) passed"
            exit 0
        fi
        echo "ERROR — nothing was checked (selftest failed)"
        exit 2
        ;;
esac

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    printf '%s: not inside a git repository\n' "$name"
    # Most common real cause: core.bare=true written into the SHARED .git/config
    # (see doc/08_tracking/bug/shared_git_config_core_worktree_misdirects_prepush_guards_2026-08-08.md
    # and scripts/check/check-core-bare-sanity.shs for the proven mechanism —
    # `git init` with an inherited GIT_DIR ending in '/' or '/.').
    if [ "$(git config --get --type=bool core.bare 2>/dev/null || true)" = "true" ]; then
        printf '%s: core.bare=true is set on this repo\n' "$name"
        printf '    fix: git config --unset-all core.bare\n'
    fi
    printf '%s: ERROR — nothing was checked (exit 2)\n' "$name"
    exit 2
}
# --git-common-dir alone is relative to the CWD, not to the repo root, so
# joining it onto $repo_root from any subdirectory yields <repo>/../.git and
# this check reports the guards unwired when they are wired. Ask git for the
# absolute form; keep the relative join only as a fallback for git < 2.31,
# resolving it against the CWD it was actually reported against.
git_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
    git_dir=$(git rev-parse --git-common-dir 2>/dev/null) ||
    git_dir="$repo_root/.git"
if ! is_absolute_path "$git_dir"; then
    git_dir="$(CDPATH= cd -- "$git_dir" 2>/dev/null && pwd)" || git_dir="$repo_root/.git"
fi

expected_guard="$repo_root/scripts/check/pre-push-conflict-tree-guard.shs"
expected_dispatcher="$repo_root/scripts/hooks/pre-push"
expected_launcher="$repo_root/scripts/hooks/pre-push-worktree-launcher"

# --- PASS-only cache (2026-09-25, push_hook_plan.md item2, goal "hook adds
# <=10s"). This script alone measured ~1.5s of the ~5s of fixed overhead in
# every push (several git-rev-parse/readlink/cmp subshells plus a nested
# check-core-bare-sanity.shs invocation), on top of the fast content guards it
# gates. Its own verdict is a pure function of a small, enumerable set of
# inputs (hook wiring files + two git-config booleans + this script's own
# content), so an unchanged fingerprint can only ever recompute the SAME
# verdict. Only a PASS is ever cached: an uncertain or broken wiring state
# must always be re-examined, never short-circuited, so a FAIL/ERROR path
# below never writes this cache and a stale cache is never trusted to mean
# "still fine" -- only "still exactly this". Any hashing failure (a missing
# file, an unwritable cache dir) degrades to running the full check, never to
# skipping it.
_cache_dir_raw=$(git rev-parse --git-dir 2>/dev/null) || _cache_dir_raw=""
if [ -n "$_cache_dir_raw" ]; then
    if is_absolute_path "$_cache_dir_raw"; then
        _cache_dir=$_cache_dir_raw
    else
        _cache_dir="$repo_root/$_cache_dir_raw"
    fi
else
    _cache_dir=""
fi
_cache_file=""
_cache_key=""
if [ -n "$_cache_dir" ] && [ -d "$_cache_dir" ]; then
    _cache_file="$_cache_dir/simple-hook-install-check.cache"
    _hooks_path_now=$(git config --get core.hooksPath 2>/dev/null || true)
    _resolved_hooks_dir=""
    if [ -n "$_hooks_path_now" ]; then
        case "$_hooks_path_now" in
            /*) _resolved_hooks_dir=$_hooks_path_now ;;
            *) _resolved_hooks_dir="$repo_root/$_hooks_path_now" ;;
        esac
    fi
    _hook_now="$git_dir/hooks/pre-push"
    if [ -n "$_hooks_path_now" ] && [ -d "$_resolved_hooks_dir" ] && [ -e "$_resolved_hooks_dir/pre-push" ]; then
        _hook_now="$_resolved_hooks_dir/pre-push"
    fi
    _hook_exec_bit="noexec"
    [ -e "$_hook_now" ] && [ -x "$_hook_now" ] && _hook_exec_bit="exec"
    _hook_target_now=$(readlink -f "$_hook_now" 2>/dev/null || echo "$_hook_now")
    _ppl_now="$(dirname "$_hook_now")/pre-push.local"
    # One batched `sha256sum` over every file this script's checks inspect,
    # instead of one process per file (measured ~20-30ms per spawn on this
    # host, so N separate hashes was a meaningful slice of this cache-key
    # computation's own cost). A file that does not exist is recorded as
    # "absent:<path>" instead of being fed to sha256sum, so an appear/
    # disappear transition still changes the fingerprint.
    #
    # EXEC BIT (review finding #2, 2026-09-25): content alone is not enough
    # for $expected_guard -- check 5 below (`[ ! -x "$expected_guard" ]`)
    # blocks the push when the guard driver is not executable, but a content
    # hash cannot see a permission-bit-only change (`chmod -x` with no byte
    # touched). The exec bit of every file whose checks below actually test
    # executability ($expected_guard as check 5's direct subject, plus the
    # hook/dispatcher/launcher family already tracked via `_hook_exec_bit`)
    # is folded into the fingerprint text explicitly, so a bare permission
    # flip invalidates a cached PASS exactly like a content edit would.
    set --
    _missing_note=""
    _guard_exec_bit="noexec"
    [ -x "$expected_guard" ] && _guard_exec_bit="exec"
    for _f in "$_hook_now" "$expected_guard" "$expected_dispatcher" "$expected_launcher" \
              "$repo_root/scripts/check/check-core-bare-sanity.shs" "$_ppl_now" \
              "$repo_root/scripts/check/check-tree-size-push.shs" \
              "$repo_root/scripts/check/check-no-conflict-tree-push.shs" \
              "$repo_root/scripts/check/check-no-conflict-markers-push.shs" \
              "$repo_root/scripts/check/check-no-revert-push.shs" \
              "$repo_root/scripts/check/check-hook-installation.shs"; do
        if [ -e "$_f" ]; then
            set -- "$@" "$_f"
        else
            _missing_note="$_missing_note
absent:$_f"
        fi
    done
    _hash_out=""
    if [ "$#" -gt 0 ]; then
        _hash_out=$(sha256sum -- "$@" 2>/dev/null)
    fi
    _fp=$(
        printf 'hooksPath=%s\n' "$_hooks_path_now"
        printf 'hookPath=%s exec=%s target=%s\n' "$_hook_now" "$_hook_exec_bit" "$_hook_target_now"
        printf 'guardExec=%s\n' "$_guard_exec_bit"
        printf '%s\n' "$_hash_out"
        printf '%s\n' "$_missing_note"
        printf 'core.verify=%s\n' "$(git config --get --type=bool core.verify 2>/dev/null || true)"
        printf 'core.bare=%s\n' "$(git config --get --type=bool core.bare 2>/dev/null || true)"
    ) 2>/dev/null
    _cache_key=$(printf '%s' "$_fp" | sha256sum 2>/dev/null | awk '{print $1}')
    if [ -n "$_cache_key" ] && [ -f "$_cache_file" ]; then
        _stored_key=$(sed -n '1p' "$_cache_file" 2>/dev/null)
        if [ "$_stored_key" = "$_cache_key" ]; then
            tail -n +2 "$_cache_file" 2>/dev/null
            exit 0
        fi
    fi
fi

# --- check 1: core.hooksPath must be unset, or point at a real directory that
# actually contains a pre-push hook. This is the exact defect that let the
# fourth wipe through.
checks=$((checks + 1))
hooks_path=$(git config --get core.hooksPath 2>/dev/null || true)
if [ -n "$hooks_path" ]; then
    case "$hooks_path" in
        /*) resolved="$hooks_path" ;;
        *) resolved="$repo_root/$hooks_path" ;;
    esac
    if [ ! -d "$resolved" ]; then
        fail "core.hooksPath is set to '$hooks_path' but that directory does not exist. Git silently runs NO hooks in this state — every pre-push guard is disabled." \
             "git config --unset core.hooksPath"
    elif [ ! -e "$resolved/pre-push" ]; then
        fail "core.hooksPath='$hooks_path' exists but contains no pre-push hook. Guards are disabled." \
             "git config --unset core.hooksPath"
    else
        case "$hooks_path" in
            /tmp/*|/var/tmp/*|/run/*|/dev/shm/*)
                fail "core.hooksPath='$hooks_path' lives in volatile temp storage. It will vanish on reboot or cleanup and silently disable every guard." \
                     "git config --unset core.hooksPath"
                ;;
        esac
    fi
fi

# --- check 2: the pre-push hook must exist.
checks=$((checks + 1))
hook="$git_dir/hooks/pre-push"
if [ -n "$hooks_path" ] && [ -d "${resolved:-}" ] && [ -e "${resolved:-}/pre-push" ]; then
    hook="$resolved/pre-push"
fi
if [ ! -e "$hook" ]; then
    fail "no pre-push hook at $hook — nothing invokes the guards on push." \
         "ln -sf ../../scripts/check/pre-push-conflict-tree-guard.shs $git_dir/hooks/pre-push"
else
    # --- check 3: the hook must be EXECUTABLE. Git only emits a `hint:` and
    # proceeds when it is not; this was the second half of the 2026-08-11 wipe.
    checks=$((checks + 1))
    if [ ! -x "$hook" ]; then
        fail "pre-push hook $hook is not executable. Git IGNORES it with only a 'hint:' line and pushes anyway." \
             "chmod +x $(readlink -f "$hook" 2>/dev/null || echo "$hook")"
    fi

    # --- check 4: the hook must actually resolve to the repo's guard driver,
    # not to some unrelated or stale script.
    checks=$((checks + 1))
    target=$(readlink -f "$hook" 2>/dev/null || echo "$hook")
    expected_real=$(readlink -f "$expected_guard" 2>/dev/null || echo "$expected_guard")
    dispatcher_real=$(readlink -f "$expected_dispatcher" 2>/dev/null || echo "$expected_dispatcher")
    launcher_real=$(readlink -f "$expected_launcher" 2>/dev/null || echo "$expected_launcher")
    if [ "$target" != "$expected_real" ] && [ "$target" != "$dispatcher_real" ] && \
       [ "$target" != "$launcher_real" ] && ! cmp -s "$hook" "$expected_launcher"; then
        fail "pre-push hook resolves to '$target', which is neither the canonical guard, tracked dispatcher, nor worktree-resolving launcher." \
             "sh scripts/setup/install-must-check-hooks.shs --install"
    fi
fi

# --- check 5: the guard driver and the load-bearing content guards it shells
# out to must themselves be executable. The driver invokes most of them via
# `sh <path>`, which tolerates mode 0664, but any that are exec'd directly and
# any that a human runs from the shell must not be silently unrunnable.
checks=$((checks + 1))
if [ ! -x "$expected_guard" ]; then
    fail "guard driver $expected_guard is not executable." "chmod +x $expected_guard"
fi

for g in check-tree-size-push check-no-conflict-tree-push check-no-conflict-markers-push check-no-revert-push; do
    checks=$((checks + 1))
    p="$repo_root/scripts/check/$g.shs"
    if [ ! -f "$p" ]; then
        fail "mandatory guard $g.shs is missing from scripts/check/." "restore it from git history"
    fi
done

# --- check 6: no repo-local push policy that blanket-disables verification.
checks=$((checks + 1))
if [ "$(git config --get --type=bool core.verify 2>/dev/null || true)" = "false" ]; then
    fail "core.verify=false disables all hooks on push." "git config --unset core.verify"
fi

# --- check 7: core.bare must not be true on a provably non-bare layout.
# scripts/check/check-core-bare-sanity.shs has existed for this since 2026-08-17
# ("written into this repo's shared .git/config repeatedly, >=3 times on
# 2026-08-17 alone, silently") and was called by NOTHING — it sits in
# scripts/check/guard_wiring_unwired_baseline.txt. It happened again on
# 2026-09-03: check-guard-wiring.shs refused the mandatory push gate with
# "is-bare-repository=" while THIS script reported "PASS — hook wiring intact".
# The guard is read-only, takes no locks, walks no objects and runs in
# milliseconds — it documents itself as safe to call from other guards — so
# there is no cost reason it was unwired. Wiring it here rather than as a new
# push-tier row is deliberate: this script already runs first from
# pre-push-conflict-tree-guard.shs, and "can the guards resolve the repo at all"
# is exactly this file's job.
checks=$((checks + 1))
_cbs="$repo_root/scripts/check/check-core-bare-sanity.shs"
if [ -f "$_cbs" ]; then
    # GIT_DIR/GIT_WORK_TREE MUST be cleared for this call. git exports GIT_DIR
    # into a pre-push hook, and the sanity guard's selftest builds throwaway
    # repos; an inherited GIT_DIR makes its "non-repository directory" fixture
    # resolve as a repo, so the selftest fails and the guard reports
    # "FAIL — guard selftest did not pass" on a perfectly healthy config.
    # Measured: plain -> PASS; with GIT_DIR exported -> FAIL; with it unset ->
    # PASS. Subshell rather than `env -u` so this stays POSIX sh.
    if ! _cbs_out=$( unset GIT_DIR GIT_WORK_TREE; sh "$_cbs" --root "$repo_root" 2>&1 ); then
        fail "core.bare sanity: $(printf '%s' "$_cbs_out" | tail -1)" "git config --unset-all core.bare"
    fi
fi

# --- check 8: pre-push.local must not itself be a launcher/dispatcher.
# scripts/hooks/pre-push CHAINS $HOOKS_DIR/pre-push.local, and the launcher
# execs that dispatcher — so a pre-push.local that is a copy of either one is an
# infinite hook recursion, bounded only by the OLDGUARD_DEPTH sentinel added
# 2026-08-26 after it "spawned thousands of timeout/sh processes and hung the
# host". It is created by install-must-check-hooks.shs mistaking an OLDER copy
# of our own launcher for a foreign local hook; the identity marker added to the
# launcher stops that recurring, but an ALREADY-stale file on an existing clone
# is only found by looking. This script previously reported "PASS — hook wiring
# intact" with exactly that file present.
checks=$((checks + 1))
_ppl="$(dirname "$hook")/pre-push.local"
if [ -f "$_ppl" ] && grep -qE '^# simple-repo-managed-hook: pre-push-worktree-launcher$|exec sh "\$DISPATCHER"' "$_ppl" 2>/dev/null; then
    fail "pre-push.local is a copy of this repo's own launcher/dispatcher, which the dispatcher chains — that is an infinite hook recursion, not a user hook." "rm -f $_ppl"
fi

if [ "$checks" -eq 0 ]; then
    printf '%s: ERROR — nothing was checked (exit 2)\n' "$name"
    exit 2
fi

if [ "$fails" -gt 0 ]; then
    printf '\n'
    printf '%s: A guard that is never INVOKED cannot report that it was never\n' "$name"
    printf '  invoked. Every content guard in this repo is sound and still fails\n'
    printf '  open in this configuration. Fix the wiring above before pushing.\n'
    printf '%s: FAIL — %d check(s) performed, %d defect(s) in hook wiring\n' "$name" "$checks" "$fails"
    exit 1
fi

_pass_line=$(printf '%s: PASS — %d check(s) performed, hook wiring intact\n' "$name" "$checks")
printf '%s' "$_pass_line"
if [ -n "$_cache_key" ] && [ -n "$_cache_file" ]; then
    {
        printf '%s\n' "$_cache_key"
        printf '%s' "$_pass_line"
    } > "$_cache_file.tmp$$" 2>/dev/null && mv -f "$_cache_file.tmp$$" "$_cache_file" 2>/dev/null
    rm -f "$_cache_file.tmp$$" 2>/dev/null
fi
exit 0
