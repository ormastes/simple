#!/bin/sh
# Offline, exact-pixel comparison of seven independently captured 4K tabs.
# Exit 0: pixel equality; 1: invalid evidence/mismatch; 2: unavailable proof.
set -eu
LC_ALL=C
export LC_ALL
tabs='overview html css-layout css-paint forms-media animation evidence'
emit() { printf '%s=%s\n' "$1" "$2"; }
stop() { emit status "$1"; emit reason "$2"; exit "$3"; }
field() {
    awk -v key="$2" 'index($0,key "=")==1 {n++; v=substr($0,length(key)+2)}
        END {if(n!=1 || v=="") exit 1; print v}' "$1"
}
sha256() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
    else shasum -a 256 "$1" | awk '{print $1}'; fi
}
digest_file() {
    evidence_path=$(field "$1" "${2}_path") || return 1
    evidence_hash=$(field "$1" "${2}_sha256") || return 1
    [ -f "$evidence_path" ] || return 1
    case "$evidence_hash" in *[!0-9a-f]*|'') return 1 ;; esac
    [ "${#evidence_hash}" -eq 64 ] && [ "$(sha256 "$evidence_path")" = "$evidence_hash" ]
}
emit schema simple.web-showcase-tab-pixels/v1
emit width 3840
emit height 2160
emit tolerance_absolute_channel_delta 0
emit tolerance_different_pixels 0
emit comparison_admitted false
emit timing_admitted false
emit scanout_admitted false
[ "$#" -eq 2 ] || stop FAIL usage-simple-capture-directory-chrome-capture-directory 1
simple_dir=$1
chrome_dir=$2
for dependency in awk od tr wc; do
    command -v "$dependency" >/dev/null 2>&1 || stop BLOCKED "missing-$dependency" 2
done
command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 || stop BLOCKED missing-sha256 2
command -v magick >/dev/null 2>&1 || stop BLOCKED missing-imagemagick7 2
if command -v timeout >/dev/null 2>&1; then limiter=timeout
elif command -v gtimeout >/dev/null 2>&1; then limiter=gtimeout
else stop BLOCKED missing-timeout 2; fi
scratch=$(mktemp -d "${TMPDIR:-/tmp}/web-tab-pixels.XXXXXX")
trap 'rm -f "$scratch/metric" "$scratch/decode"; rmdir "$scratch"' EXIT HUP INT TERM
emit comparison_engine imagemagick7-AE-RGBA
# A missing member is unavailable evidence; extra members are an invalid set.
for capture_dir in "$simple_dir" "$chrome_dir"; do
    [ -d "$capture_dir" ] || stop BLOCKED missing-capture-directory 2
    for tab in $tabs; do
        [ -f "$capture_dir/$tab.env" ] && [ -f "$capture_dir/$tab.png" ] || stop BLOCKED "missing-tab-$tab" 2
    done
    set -- "$capture_dir"/*.env
    [ "$#" -eq 7 ] || stop FAIL unexpected-receipt-set 1
    set -- "$capture_dir"/*.png
    [ "$#" -eq 7 ] || stop FAIL unexpected-png-set 1
done
failed=0
blocked=0
matched=0
for tab in $tabs; do
    tab_ok=1
    for renderer in simple chrome; do
        if [ "$renderer" = simple ]; then capture_dir=$simple_dir; else capture_dir=$chrome_dir; fi
        receipt="$capture_dir/$tab.env"
        png="$capture_dir/$tab.png"
        prefix="tab.$tab.$renderer"
        for pair in 'schema=simple.web-tab-capture/v1' "renderer=$renderer" "tab=$tab" 'width=3840' 'height=2160'; do
            key=${pair%%=*}; expected=${pair#*=}
            actual=$(field "$receipt" "$key") || actual=missing
            if [ "$actual" != "$expected" ]; then
                emit "$prefix.error" "invalid-$key"; failed=1; tab_ok=0
            fi
        done
        backend_status=$(field "$receipt" backend_status) || backend_status=unverified
        capture_status=$(field "$receipt" status) || capture_status=unavailable
        if [ "$backend_status" != verified ] || [ "$capture_status" != MEASURED ]; then
            emit "$prefix.error" capture-or-backend-unverified; blocked=1; tab_ok=0
        fi
        for artifact in png fixture binary backend_evidence; do
            if ! digest_file "$receipt" "$artifact"; then
                emit "$prefix.error" "missing-or-stale-$artifact"; failed=1; tab_ok=0
            fi
        done
        png_digest=$(sha256 "$png")
        declared_png_digest=$(field "$receipt" png_sha256) || declared_png_digest=missing
        emit "$prefix.png_sha256" "$png_digest"
        if [ "$png_digest" != "$declared_png_digest" ]; then
            emit "$prefix.error" tab-png-digest-mismatch; failed=1; tab_ok=0
        fi
        proof=$(field "$receipt" backend_evidence_path) || proof=/nonexistent
        if [ -f "$proof" ]; then
            for pair in 'schema=simple.web-tab-backend/v1' "renderer=$renderer" "tab=$tab" 'physical_device=true' "png_sha256=$png_digest"; do
                key=${pair%%=*}; expected=${pair#*=}
                actual=$(field "$proof" "$key") || actual=missing
                if [ "$actual" != "$expected" ]; then
                    emit "$prefix.error" "unverified-backend-$key"; blocked=1; tab_ok=0
                fi
            done
            adapter=$(field "$proof" device_identity) || adapter=unverified
            case "$adapter" in unverified|unavailable|none|0) emit "$prefix.error" missing-device-identity; blocked=1; tab_ok=0 ;; esac
            backend=$(field "$proof" backend) || backend=unverified
            if [ "$renderer" = simple ] && [ "$backend" != vulkan ]; then
                emit "$prefix.error" simple-backend-not-vulkan; blocked=1; tab_ok=0
            fi
            case "$backend" in unverified|unavailable|software|swiftshader|llvmpipe|'') emit "$prefix.error" backend-not-admitted; blocked=1; tab_ok=0 ;; esac
        fi
        # PNG signature, first chunk length/type, and big-endian 3840x2160 IHDR.
        header=$(od -An -tx1 -N24 "$png" | tr -d ' \n')
        if [ "$header" != 89504e470d0a1a0a0000000d4948445200000f0000000870 ]; then
            emit "$prefix.error" invalid-png-4k-ihdr; failed=1; tab_ok=0
        fi
        if ! "$limiter" -k 1 30 magick identify -regard-warnings -limit memory 256MiB -limit map 512MiB -limit disk 0 \
            -format '%m %w %h %n' "$png" > "$scratch/decode" 2>/dev/null; then
            emit "$prefix.error" png-decode-failed; failed=1; tab_ok=0
        elif [ "$(awk '{print}' "$scratch/decode")" != 'PNG 3840 2160 1' ]; then
            emit "$prefix.error" invalid-decoded-image; failed=1; tab_ok=0
        fi
    done
    simple_fixture=$(field "$simple_dir/$tab.env" fixture_sha256) || simple_fixture=missing-simple
    chrome_fixture=$(field "$chrome_dir/$tab.env" fixture_sha256) || chrome_fixture=missing-chrome
    emit "tab.$tab.fixture_sha256" "$simple_fixture"
    if [ "$simple_fixture" != "$chrome_fixture" ]; then
        emit "tab.$tab.error" fixture-digest-mismatch; failed=1; tab_ok=0
    fi
    if [ "$tab_ok" -ne 1 ]; then emit "tab.$tab.status" REJECTED; continue; fi
    compare_exit=0
    "$limiter" -k 1 30 magick compare -regard-warnings -limit memory 256MiB -limit map 512MiB -limit disk 0 \
        -channel RGBA -metric AE -fuzz 0 "$simple_dir/$tab.png" "$chrome_dir/$tab.png" null: \
        2> "$scratch/metric" || compare_exit=$?
    metric=$(awk '{print}' "$scratch/metric")
    if ! awk -v n="$metric" 'BEGIN {exit !(n ~ /^[0-9]+([.][0-9]+)?([eE][+]?[0-9]+)?$/ && n+0>=0 && n+0<=8294400)}'; then
        emit "tab.$tab.error" invalid-comparison-metric; failed=1
    elif [ "$compare_exit" -eq 0 ] && [ "$metric" = 0 ]; then
        emit "tab.$tab.status" MATCH; emit "tab.$tab.different_pixels" 0; matched=$((matched + 1))
    elif [ "$compare_exit" -eq 1 ]; then
        emit "tab.$tab.status" MISMATCH; emit "tab.$tab.different_pixels" "$metric"; failed=1
    else
        emit "tab.$tab.error" comparison-failed-or-timeout; failed=1
    fi
done
emit matched_tabs "$matched"
[ "$failed" -eq 0 ] || stop FAIL invalid-evidence-or-pixel-mismatch 1
[ "$blocked" -eq 0 ] || stop BLOCKED capture-or-physical-backend-unverified 2
[ "$matched" -eq 7 ] || stop FAIL incomplete-comparison 1
emit pixel_equality_admitted true
emit status PASS
emit reason seven-tabs-exact-pixel-equality-only
