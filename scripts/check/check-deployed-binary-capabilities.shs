#!/bin/sh
# check-deployed-binary-capabilities.shs
#
# Permanent post-redeploy verification gate. Codifies the ad hoc capability
# probes run during the 2026-08 redeploy campaigns (f64 builtins, Result/
# Option unwrap, sqrt/pow/sin, min) into one fenced, repeatable check.
#
# CALL-FORM PITFALL. `(0.0).sin()` (method-call form) is correct; the
# call-form spelling `f64.sin(0.0)` silently prints nothing (no error, empty
# stdout) rather than failing loudly -- verified against the fresh build
# during this gate's own authoring. Use the method-call form for float
# builtins here and anywhere else this pattern is copied.
#
# RUN THIS after every `bin/simple build bootstrap` redeploy, before trusting
# the newly-deployed binary for anything else. A PASS proves the deployed
# binary: (1) is at least as new as the newest src/compiler_rust commit
# (provenance), (2) actually executes float/Result/Option builtins correctly
# through the real CLI entry point (not in-process, so it exercises whatever
# lane `bin/simple <file>` really uses today — JIT, native, or interpreter),
# and (3) the oracle itself can detect a wrong value (negative self-check).
#
# WHY `fn main():` WRAPPING IS LOAD-BEARING. Top-level script statements (no
# `fn main():`) take a DIFFERENT lowering path that bypasses JIT codegen
# entirely and silently falls back to the interpreter -- a false-negative trap
# that would make this gate pass against a broken JIT. Every probe below is
# wrapped in `fn main():` so it goes through the same path production code does.
#
# WHY STDOUT CONTENT, NEVER EXIT CODE. `bin/simple run <file>` exits 0 even
# after a FATAL `error: semantic:` -- see
# doc/*/reference_bin_simple_run_exits_zero_after_fatal_semantic_error.md.
# Every assertion here compares captured stdout text to a hand-computed
# expected value; exit codes are never consulted for probe pass/fail.
#
# OVERRIDE. Set SIMPLE_BIN to point this gate at a specific binary instead of
# the deployed `bin/simple` symlink -- e.g. to verify a freshly built binary
# in /mnt/data/cargo-target*/release/simple BEFORE it is deployed, or to
# compare two builds:
#     SIMPLE_BIN=/mnt/data/cargo-target/release/simple \
#         sh scripts/check/check-deployed-binary-capabilities.shs
#
# Verdict line is the last line of stdout:
#   PASS  — <n> probe(s) checked          exit 0
#   FAIL  — ...                           exit 1
#   ERROR — nothing was checked           exit 2
#
# --selftest: verifies the oracle itself can FAIL (runs one probe against a
# deliberately wrong expected value and confirms it is reported FAIL). Fatal
# if the selftest does not detect the deliberate mismatch.

set -u

SELFTEST=0
for arg in "$@"; do
    case "$arg" in
        --selftest) SELFTEST=1 ;;
    esac
done

BIN_PATH="${SIMPLE_BIN:-bin/simple}"
BIN="$(readlink -f "$BIN_PATH" 2>/dev/null || echo "$BIN_PATH")"

if [ ! -x "$BIN" ]; then
    echo "ERROR — nothing was checked (no runnable binary at $BIN, resolved from $BIN_PATH)"
    exit 2
fi

echo "check-deployed-binary-capabilities"
echo "  symlink/override target: $BIN_PATH"
echo "  resolved binary:         $BIN"
ls -l "$BIN" 2>/dev/null | awk '{print "  size: " $5 "  mtime: " $6 " " $7 " " $8}'
echo

# ---- PROVENANCE ------------------------------------------------------------
# Only meaningful for the default (unoverridden) bin/simple symlink target --
# an explicit SIMPLE_BIN override (e.g. probing a not-yet-deployed candidate
# build) is exempt, since its whole point is to be checked BEFORE deployment.
if [ -z "${SIMPLE_BIN:-}" ]; then
    NEWEST_RUST_COMMIT_TS=$(git log -1 --format=%ct -- src/compiler_rust 2>/dev/null || echo 0)
    BIN_MTIME_TS=$(stat -c '%Y' "$BIN" 2>/dev/null || stat -f '%m' "$BIN" 2>/dev/null || echo 0)
    if [ "$NEWEST_RUST_COMMIT_TS" -gt 0 ] && [ "$BIN_MTIME_TS" -gt 0 ]; then
        if [ "$BIN_MTIME_TS" -lt "$NEWEST_RUST_COMMIT_TS" ]; then
            echo "FAIL — deployed binary mtime ($BIN_MTIME_TS) predates the newest"
            echo "       src/compiler_rust commit ($NEWEST_RUST_COMMIT_TS); this gate's"
            echo "       whole claim is that the deployed binary has CURRENT capabilities,"
            echo "       so a stale binary is a hard failure here, not a warning."
            exit 1
        fi
        echo "provenance: binary mtime $BIN_MTIME_TS >= newest src/compiler_rust commit $NEWEST_RUST_COMMIT_TS"
    else
        echo "provenance: could not compare timestamps (git log or stat failed); continuing"
    fi
    echo
fi

WORK="${TMPDIR:-/tmp}/deploycap.$$"
mkdir -p "$WORK" || { echo "ERROR — nothing was checked (cannot create $WORK)"; exit 2; }
trap 'rm -rf "$WORK"' EXIT INT TERM

CHECKED=0
FAILED=0

# probe <label> <src> <expect>
probe() {
    _label="$1"; _src="$2"; _expect="$3"
    printf '%s\n' "$_src" > "$WORK/case.spl"
    _got=$(SIMPLE_RUST_SEED_WARNING=0 "$BIN" "$WORK/case.spl" 2>/dev/null)
    CHECKED=$((CHECKED + 1))
    if [ "$_got" = "$_expect" ]; then
        echo "  ok   $_label -> $_got"
        return 0
    fi
    echo "  FAIL $_label: expected '$_expect', got '$_got'"
    FAILED=$((FAILED + 1))
    return 1
}

probe "(16.0).sqrt()" 'fn main():
    print (16.0).sqrt()' '4.0'

probe "Result.Ok(42).unwrap()" 'fn main():
    print Result.Ok(42).unwrap()' '42'

probe "Option.Some(7).unwrap()" 'fn main():
    print Option.Some(7).unwrap()' '7'

probe "min(1.5, 2.5)" 'fn main():
    print min(1.5, 2.5)' '1.5'

probe "sqrt(16.0)" 'fn main():
    print sqrt(16.0)' '4.0'

probe "f64 literal 16.0" 'fn main():
    print 16.0' '16.0'

probe "(0.0).sin()" 'fn main():
    print (0.0).sin()' '0.0'

probe "pow(2.0, 3.0)" 'fn main():
    print pow(2.0, 3.0)' '8.0'

probe "i64 positive control 42" 'fn main():
    print 42' '42'

echo

# ---- NEGATIVE CONTROL: oracle sanity ---------------------------------------
# An undefined identifier must produce `error:` on stderr. If it doesn't, the
# oracle cannot distinguish a broken binary from a working one -- ERROR out
# rather than reporting a false PASS.
printf 'fn main():\n    print undefined_identifier_probe_xyz\n' > "$WORK/negctl.spl"
NEG_ERR=$(SIMPLE_RUST_SEED_WARNING=0 "$BIN" "$WORK/negctl.spl" 2>&1 >/dev/null)
if ! printf '%s' "$NEG_ERR" | grep -q 'error:'; then
    echo "ERROR — nothing was checked (negative control did not produce 'error:' on stderr; oracle is broken)"
    exit 2
fi
echo "negative control: undefined identifier correctly reported an error"
echo

# ---- --selftest -------------------------------------------------------------
if [ "$SELFTEST" -eq 1 ]; then
    printf 'fn main():\n    print 42\n' > "$WORK/selftest.spl"
    SELF_GOT=$(SIMPLE_RUST_SEED_WARNING=0 "$BIN" "$WORK/selftest.spl" 2>/dev/null)
    if [ "$SELF_GOT" = "THIS_CAN_NEVER_MATCH" ]; then
        echo "ERROR — nothing was checked (selftest: deliberate mismatch fixture matched; oracle broken)"
        exit 2
    fi
    echo "selftest: deliberately-wrong expectation ('THIS_CAN_NEVER_MATCH') correctly did NOT match actual output ('$SELF_GOT') — the oracle can detect FAIL"
    echo
fi

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi

if [ "$FAILED" -gt 0 ]; then
    echo "FAIL — $CHECKED probe(s) checked, $FAILED failure(s)"
    exit 1
fi

echo "PASS — $CHECKED probe(s) checked"
exit 0
