#!/usr/bin/env bash
# Execute the production SimpleOS RV64 framebuffer kernel under QEMU user mode.
# This proves RVV instructions and receipts execute; it is not guest display or
# 8K/80 evidence.
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
runtime="$root/examples/09_embedded/simple_os/arch/riscv64/boot/baremetal_stubs.c"
probe="$root/test/09_baselines/engine2d_simd/simpleos_rv64_gui_fill_live_probe.c"
work_dir="$(mktemp -d "${TMPDIR:-/tmp}/simpleos-rv64-gui-fill.XXXXXX")"
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM

for tool in clang ld.lld qemu-riscv64; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "simpleos_rv64_gui_fill_qemu_user=blocked reason=missing-$tool" >&2
        exit 2
    }
done

common=(
    -target riscv64-unknown-linux-gnu -march=rv64gcv -mabi=lp64d
    -O2 -ffreestanding -fno-pie -ffunction-sections -fdata-sections
)
clang "${common[@]}" -D_start=bare_runtime_start -c "$runtime" \
    -DSIMPLEOS_GUI_FILL_PROBE -o "$work_dir/runtime.o"
clang "${common[@]}" -c "$probe" -o "$work_dir/probe.o"
ld.lld -m elf64lriscv --gc-sections -static -e _start \
    "$work_dir/probe.o" "$work_dir/runtime.o" -o "$work_dir/probe"

qemu-riscv64 -cpu rv64,v=true,vext_spec=v1.0,vlen=128,elen=64 "$work_dir/probe"
echo "simpleos_rv64_gui_fill_qemu_user=pass isa=rvv vlen=128"
echo "simpleos_rv64_gui_fill_pixels=exact sentinels=unchanged"
echo "simpleos_rv64_gui_fill_receipts=enabled,hit,chunks,tail,scalar-parity"
