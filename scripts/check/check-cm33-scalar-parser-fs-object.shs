#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
    echo "usage: $0 <an505|stm32u585|ra4m1> <policy-object>" >&2
    exit 2
fi

BOARD=$1
OBJECT=$2
case "$BOARD" in
    an505|stm32u585) CORE=cortex-m33; TARGET=thumbv8m.main-none-eabi ;;
    ra4m1) CORE=cortex-m4; TARGET=thumbv7em-none-eabi ;;
    *) echo "ERROR unknown Cortex-M scalar/parser/FS board: $BOARD" >&2; exit 2 ;;
esac

[ -s "$OBJECT" ] || {
    echo "ERROR missing or empty scalar/parser/FS policy object: $OBJECT" >&2
    exit 1
}
for tool in llvm-readobj llvm-nm llvm-objdump; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "ERROR required object admission tool is unavailable: $tool" >&2
        exit 1
    }
done

HEADER=$(llvm-readobj --file-headers "$OBJECT")
printf '%s\n' "$HEADER" | grep -Fq 'Format: elf32-littlearm' || exit 1
printf '%s\n' "$HEADER" | grep -Fq 'Machine: EM_ARM' || exit 1
printf '%s\n' "$HEADER" | grep -Fq 'Flags [ (0x5000000)' || exit 1

EXPECTED_SYMBOLS='cm33_policy_fs_add_file
cm33_policy_fs_add_name
cm33_policy_fs_find
cm33_policy_fs_init
cm33_policy_memcpy_simple
cm33_policy_parse_hex_digit
cm33_policy_parse_hex_prefix
cm33_policy_starts_with
cm33_policy_streq
cm33_policy_strlen_simple'
DEFINED_SYMBOLS=$(llvm-nm --defined-only --extern-only --format=posix "$OBJECT" |
    awk '{print $1}' | LC_ALL=C sort)
[ "$DEFINED_SYMBOLS" = "$EXPECTED_SYMBOLS" ] || {
    echo "ERROR scalar/parser/FS policy object external symbol set is not admitted" >&2
    exit 1
}
UNDEFINED_SYMBOLS=$(llvm-nm --undefined-only --format=posix "$OBJECT" |
    awk '{print $1}' | LC_ALL=C sort)
[ -z "$UNDEFINED_SYMBOLS" ] || {
    echo "ERROR unexpected-policy-undefined-symbol: $UNDEFINED_SYMBOLS" >&2
    exit 1
}
llvm-objdump --disassemble --triple="$TARGET" "$OBJECT" >/dev/null
echo "PASS cm33-scalar-parser-fs-object board=$BOARD core=$CORE target=$TARGET exports=10 undefined=0"
