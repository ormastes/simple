#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
out=${TLS_CHECK_OUT:-$(mktemp -d "${TMPDIR:-/tmp}/simple-thread-local.XXXXXX")}
mkdir -p "$out"
case $(uname -s) in
    Darwin) strip_flag=-Wl,-dead_strip; libs= ;;
    *) strip_flag=-Wl,--gc-sections; libs=-ldl ;;
esac
"${CC:-cc}" -std=gnu11 -O2 -pthread -ffunction-sections -fdata-sections \
    ${CFLAGS:-} "$root/src/runtime/test/runtime_thread_local_selfcheck.c" \
    "$strip_flag" $libs -o "$out/check"
"$out/check"
if "$out/check" --negative-control >"$out/negative.log" 2>&1; then
    echo "TLS negative control unexpectedly passed" >&2
    exit 1
fi
grep -q 'intentional negative control' "$out/negative.log"
echo "runtime TLS negative control: PASS (failure detected)"
