# Pure-Simple adapter from an offline receipt into the canonical UNO Q owner.

use std.cli.cli_util (get_cli_args)
use os.port.uno_q_native_2d_admission.{UnoQNative2dEvidence, uno_q_native_2d_admission}

fn flag(value: text) -> bool:
    value == "true"

fn valid_flag(value: text) -> bool:
    value == "true" or value == "false"

fn main() -> i64:
    val args = get_cli_args()
    if args.len() != 35:
        print "unoq_native_2d_admission=fail reason=invalid-argument-count"
        return 2
    if (not valid_flag(args[6]) or not valid_flag(args[10]) or
        not valid_flag(args[11]) or not valid_flag(args[12]) or
        not valid_flag(args[21]) or not valid_flag(args[22]) or
        not valid_flag(args[23]) or not valid_flag(args[24]) or
        not valid_flag(args[25]) or not valid_flag(args[26]) or
        not valid_flag(args[27]) or not valid_flag(args[28]) or
        not valid_flag(args[29]) or not valid_flag(args[30]) or
        not valid_flag(args[31]) or not valid_flag(args[34])):
        print "unoq_native_2d_admission=fail reason=invalid-boolean"
        return 2
    val vendor_id = if args[3] == "0x5143": 0x5143 else: args[3].to_i64()
    val evidence = UnoQNative2dEvidence(
        board_id: args[0], platform: args[1], arch: args[2],
        gpu_vendor_id: vendor_id, gpu_name: args[4], backend: args[5],
        draw_ir: flag(args[6]), draw_ir_op_count: args[7].to_i64(),
        animation_frame_count: args[8].to_i64(), font_glyph_count: args[9].to_i64(),
        device_executed: flag(args[10]), physical_device: flag(args[11]),
        fallback_used: flag(args[12]), submit_count: args[13].to_i64(),
        fence_count: args[14].to_i64(), readback_bytes: args[15].to_i64(),
        expected_checksum: args[16].to_i64(), actual_checksum: args[17].to_i64(),
        boot_id: args[18], frame_id: args[19], capture_frame_id: args[20],
        ctrl_left: flag(args[21]), ctrl_right: flag(args[22]),
        alt_left: flag(args[23]), alt_right: flag(args[24]),
        key_down: flag(args[25]), key_up: flag(args[26]),
        pointer_move: flag(args[27]), pointer_down: flag(args[28]),
        pointer_drag: flag(args[29]), pointer_up: flag(args[30]),
        pointer_wheel: flag(args[31]), audio_submitted: args[32].to_i64(),
        audio_completed: args[33].to_i64(), audio_non_silent: flag(args[34]))
    val result = uno_q_native_2d_admission(evidence)
    print "unoq_native_2d_admission={result.status} reason={result.reason}"
    if result.status == "pass":
        return 0
    if result.status == "blocked" or result.status == "ready":
        return 2
    1
