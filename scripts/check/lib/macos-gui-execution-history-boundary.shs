#!/bin/sh
# EndpointSecurity execution-history admission boundary for macOS GUI evidence.
#
# There is deliberately no ps/polling or caller-selected collector fallback.
# Live acceptance remains unavailable until the checked-in policy names a
# tracked collector source, reproducible manifest, signing team/identifier, and
# EndpointSecurity entitlement that this verifier knows how to authenticate.

macos_gui_history_sha256_file() {
    [ -f "$1" ] || return 1
    shasum -a 256 "$1" | awk '{print $1}'
}

macos_gui_history_canonical_file() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    macos_gui_history_dir="$(
        CDPATH= cd -- "$(dirname -- "$1")" && pwd -P
    )" || return 1
    printf '%s/%s\n' "$macos_gui_history_dir" "$(basename -- "$1")"
}

macos_gui_history_value() {
    macos_gui_history_count="$(
        grep -c "^$1=" "$2" 2>/dev/null || true
    )"
    [ "$macos_gui_history_count" = 1 ] || return 1
    sed -n "s/^$1=//p" "$2"
}

macos_gui_history_positive_integer() {
    case "$1" in
        ""|0|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

macos_gui_history_forbidden_role() {
    # build/bootstrap/full is the canonical GUI-driver location.  Reject roles,
    # not that location's path component.
    case "$1" in
        */simple_seed|*/simple_seed/*|*/src/compiler_rust/*|\
        */build/wm-to-i64-bootstrap/stage3/*|*/target/debug/*|\
        */debug/*|*/test/02_integration/rendering/*live_harness*) return 0 ;;
        *) return 1 ;;
    esac
}

macos_gui_history_eslogger_available() {
    [ "$(uname -s)" = Darwin ] || return 1
    [ -x /usr/bin/eslogger ] || return 1
    for macos_gui_history_event in exec fork exit; do
        /usr/bin/eslogger --list-events 2>/dev/null |
            grep -qx "$macos_gui_history_event" || return 1
    done
}

macos_gui_history_tracked_clean_file() {
    macos_gui_history_root="$1"
    macos_gui_history_relative="$2"
    macos_gui_history_absolute="$macos_gui_history_root/$macos_gui_history_relative"
    [ "$(macos_gui_history_canonical_file "$macos_gui_history_absolute")" = \
        "$macos_gui_history_absolute" ] || return 1
    git -C "$macos_gui_history_root" ls-files --error-unmatch \
        "$macos_gui_history_relative" >/dev/null 2>&1 || return 1
    macos_gui_history_head_sha="$(
        git -C "$macos_gui_history_root" show \
            "HEAD:$macos_gui_history_relative" |
            shasum -a 256 | awk '{print $1}'
    )" || return 1
    [ "$macos_gui_history_head_sha" = "$(
        macos_gui_history_sha256_file "$macos_gui_history_absolute"
    )" ]
}

# This is the only production trust root.  The policy is itself tracked and
# equal to HEAD, so an environment variable or generated build/sffi file cannot
# authorize a collector.  Current status is unavailable because no signing
# team/entitlement identity is provisioned in this repository.
macos_gui_history_require_trust_root() {
    macos_gui_history_root="$1"
    macos_gui_history_policy_relative=\
"config/security/macos_gui_es_collector_policy.env"
    macos_gui_history_policy=\
"$macos_gui_history_root/$macos_gui_history_policy_relative"
    macos_gui_history_tracked_clean_file "$macos_gui_history_root" \
        "$macos_gui_history_policy_relative" || {
        echo "macOS GUI execution history: FAIL (tracked collector policy is absent or differs from HEAD)" >&2
        return 125
    }
    [ "$(macos_gui_history_value schema "$macos_gui_history_policy")" = \
        simple-macos-es-collector-policy-v1 ] || return 125
    [ "$(macos_gui_history_value required_events \
        "$macos_gui_history_policy")" = exec,fork,exit ] || return 125
    [ "$(macos_gui_history_value required_entitlement \
        "$macos_gui_history_policy")" = \
        com.apple.developer.endpoint-security.client ] || return 125
    [ "$(macos_gui_history_value signing_identifier \
        "$macos_gui_history_policy")" = org.simplelang.gui-es-history ] ||
        return 125
    macos_gui_history_source_relative="$(
        macos_gui_history_value collector_source_path \
            "$macos_gui_history_policy"
    )" || return 125
    [ "$macos_gui_history_source_relative" = \
        tools/native/macos/simple_es_history_collector.swift ] || return 125
    macos_gui_history_tracked_clean_file "$macos_gui_history_root" \
        "$macos_gui_history_source_relative" || return 125
    [ "$(macos_gui_history_value collector_source_sha256 \
        "$macos_gui_history_policy")" = "$(
            macos_gui_history_sha256_file \
                "$macos_gui_history_root/$macos_gui_history_source_relative"
        )" ] || return 125
    [ "$(macos_gui_history_value collector_build_manifest_path \
        "$macos_gui_history_policy")" = \
        build/sffi/simple_es_history_collector.provenance.env ] || return 125
    [ "$(macos_gui_history_value collector_output_path \
        "$macos_gui_history_policy")" = \
        build/sffi/simple_es_history_collector ] || return 125
    [ "$(macos_gui_history_value team_identifier \
        "$macos_gui_history_policy")" = unassigned ] || return 125
    if [ "$(macos_gui_history_value status "$macos_gui_history_policy")" != \
            admitted ]; then
        echo "macOS GUI execution history: FAIL (tracked policy keeps EndpointSecurity collector unavailable until source, reproducible provenance, team signing identity, and entitlement are admitted)" >&2
        return 125
    fi
    # No admitted policy exists yet.  When status becomes admitted, this branch
    # must be extended to authenticate every pinned source/build/signing field.
    echo "macOS GUI execution history: FAIL (admitted collector policy verifier is not implemented)" >&2
    return 125
}

macos_gui_history_state_read() {
    macos_gui_history_state_dir="$1"
    macos_gui_history_state_pid="$2"
    macos_gui_history_state_key="$3"
    macos_gui_history_value "$macos_gui_history_state_key" \
        "$macos_gui_history_state_dir/$macos_gui_history_state_pid"
}

macos_gui_history_state_write() {
    macos_gui_history_state_dir="$1"
    macos_gui_history_state_pid="$2"
    macos_gui_history_state_parent="$3"
    macos_gui_history_state_alive="$4"
    macos_gui_history_state_execs="$5"
    macos_gui_history_state_tmp=\
"$macos_gui_history_state_dir/$macos_gui_history_state_pid.tmp"
    {
        echo "parent=$macos_gui_history_state_parent"
        echo "alive=$macos_gui_history_state_alive"
        echo "exec_count=$macos_gui_history_state_execs"
    } >"$macos_gui_history_state_tmp" || return 1
    mv "$macos_gui_history_state_tmp" \
        "$macos_gui_history_state_dir/$macos_gui_history_state_pid"
}

# Verify the normalized, finalized kernel-event history.  This function is
# intentionally separable for adversarial parser tests; production admission
# additionally requires macos_gui_history_require_trust_root().
macos_gui_history_verify_normalized() {
    macos_gui_history_receipt="$1"
    macos_gui_history_driver="$2"
    macos_gui_history_driver_sha="$3"
    [ "$(macos_gui_history_canonical_file "$macos_gui_history_driver")" = \
        "$macos_gui_history_driver" ] || return 1
    [ "$(macos_gui_history_sha256_file "$macos_gui_history_driver")" = \
        "$macos_gui_history_driver_sha" ] || return 1
    [ -f "$macos_gui_history_receipt" ] &&
        [ ! -L "$macos_gui_history_receipt" ] || return 1
    [ "$(macos_gui_history_value schema "$macos_gui_history_receipt")" = \
        macos-es-execution-history-v2 ] || return 1
    [ "$(macos_gui_history_value observer_kind \
        "$macos_gui_history_receipt")" = endpointsecurity-eslogger-v1 ] ||
        return 1
    [ "$(macos_gui_history_value coverage "$macos_gui_history_receipt")" = \
        root-and-descendants-through-exit ] || return 1
    [ "$(macos_gui_history_value finalized "$macos_gui_history_receipt")" = \
        complete ] || return 1
    [ "$(macos_gui_history_value status "$macos_gui_history_receipt")" = pass ] ||
        return 1
    macos_gui_history_root_pid="$(
        macos_gui_history_value root_pid "$macos_gui_history_receipt"
    )" || return 1
    macos_gui_history_positive_integer "$macos_gui_history_root_pid" || return 1
    [ "$(macos_gui_history_value root_executable_path \
        "$macos_gui_history_receipt")" = "$macos_gui_history_driver" ] ||
        return 1
    [ "$(macos_gui_history_value root_executable_sha256 \
        "$macos_gui_history_receipt")" = "$macos_gui_history_driver_sha" ] ||
        return 1
    macos_gui_history_expected_count="$(
        macos_gui_history_value event_count "$macos_gui_history_receipt"
    )" || return 1
    macos_gui_history_positive_integer "$macos_gui_history_expected_count" ||
        return 1
    macos_gui_history_events="$(
        macos_gui_history_value event_log_path "$macos_gui_history_receipt"
    )" || return 1
    [ "$(macos_gui_history_canonical_file "$macos_gui_history_events")" = \
        "$macos_gui_history_events" ] || return 1
    [ "$(macos_gui_history_value event_log_sha256 \
        "$macos_gui_history_receipt")" = "$(
            macos_gui_history_sha256_file "$macos_gui_history_events"
        )" ] || return 1
    macos_gui_history_collector="$(
        macos_gui_history_value collector_path "$macos_gui_history_receipt"
    )" || return 1
    [ "$(macos_gui_history_canonical_file "$macos_gui_history_collector")" = \
        "$macos_gui_history_collector" ] || return 1
    [ "$(macos_gui_history_value collector_sha256 \
        "$macos_gui_history_receipt")" = "$(
            macos_gui_history_sha256_file "$macos_gui_history_collector"
        )" ] || return 1
    macos_gui_history_provenance="$(
        macos_gui_history_value collector_provenance_path \
            "$macos_gui_history_receipt"
    )" || return 1
    [ "$(macos_gui_history_canonical_file "$macos_gui_history_provenance")" = \
        "$macos_gui_history_provenance" ] || return 1
    [ "$(macos_gui_history_value collector_provenance_sha256 \
        "$macos_gui_history_receipt")" = "$(
            macos_gui_history_sha256_file "$macos_gui_history_provenance"
        )" ] || return 1
    macos_gui_history_policy="$(
        macos_gui_history_value collector_policy_path \
            "$macos_gui_history_receipt"
    )" || return 1
    [ "$(macos_gui_history_canonical_file "$macos_gui_history_policy")" = \
        "$macos_gui_history_policy" ] || return 1
    [ "$(macos_gui_history_value collector_policy_sha256 \
        "$macos_gui_history_receipt")" = "$(
            macos_gui_history_sha256_file "$macos_gui_history_policy"
        )" ] || return 1
    [ "$(macos_gui_history_value collector_signing_identifier \
        "$macos_gui_history_receipt")" = org.simplelang.gui-es-history ] ||
        return 1
    macos_gui_history_team="$(
        macos_gui_history_value collector_team_identifier \
            "$macos_gui_history_receipt"
    )" || return 1
    [ -n "$macos_gui_history_team" ] &&
        [ "$macos_gui_history_team" != unassigned ] || return 1
    [ "$(macos_gui_history_value collector_entitlement_status \
        "$macos_gui_history_receipt")" = pass ] || return 1
    [ "$(macos_gui_history_value collector_code_signature_status \
        "$macos_gui_history_receipt")" = pass ] || return 1

    macos_gui_history_state_dir="$(
        mktemp -d /tmp/macos-gui-history-state.XXXXXX
    )" || return 1
    macos_gui_history_expected_sequence=1
    macos_gui_history_observed_count=0
    macos_gui_history_root_exited=0
    macos_gui_history_result=0
    while IFS='|' read -r macos_gui_history_sequence \
        macos_gui_history_kind macos_gui_history_pid \
        macos_gui_history_related macos_gui_history_path \
        macos_gui_history_extra; do
        [ "$macos_gui_history_root_exited" = 0 ] || {
            macos_gui_history_result=1
            break
        }
        [ -z "$macos_gui_history_extra" ] || {
            macos_gui_history_result=1
            break
        }
        [ "$macos_gui_history_sequence" = \
            "$macos_gui_history_expected_sequence" ] || {
            macos_gui_history_result=1
            break
        }
        macos_gui_history_positive_integer "$macos_gui_history_pid" || {
            macos_gui_history_result=1
            break
        }
        macos_gui_history_positive_integer "$macos_gui_history_related" || {
            macos_gui_history_result=1
            break
        }
        macos_gui_history_observed_count=$((macos_gui_history_observed_count + 1))
        macos_gui_history_expected_sequence=$((macos_gui_history_expected_sequence + 1))
        case "$macos_gui_history_kind" in
            exec)
                case "$macos_gui_history_path" in
                    /*) ;;
                    *) macos_gui_history_result=1; break ;;
                esac
                if [ "$macos_gui_history_observed_count" = 1 ]; then
                    [ "$macos_gui_history_pid" = \
                        "$macos_gui_history_root_pid" ] &&
                        [ "$macos_gui_history_path" = \
                            "$macos_gui_history_driver" ] || {
                            macos_gui_history_result=1
                            break
                        }
                    macos_gui_history_state_write "$macos_gui_history_state_dir" \
                        "$macos_gui_history_pid" "$macos_gui_history_related" \
                        1 1 || {
                            macos_gui_history_result=1
                            break
                        }
                    continue
                fi
                macos_gui_history_state_file=\
"$macos_gui_history_state_dir/$macos_gui_history_pid"
                [ -f "$macos_gui_history_state_file" ] || {
                    macos_gui_history_result=1
                    break
                }
                [ "$(macos_gui_history_state_read \
                    "$macos_gui_history_state_dir" \
                    "$macos_gui_history_pid" alive)" = 1 ] || {
                    macos_gui_history_result=1
                    break
                }
                [ "$(macos_gui_history_state_read \
                    "$macos_gui_history_state_dir" \
                    "$macos_gui_history_pid" parent)" = \
                    "$macos_gui_history_related" ] || {
                    macos_gui_history_result=1
                    break
                }
                ! macos_gui_history_forbidden_role \
                    "$macos_gui_history_path" || {
                    macos_gui_history_result=1
                    break
                }
                macos_gui_history_execs="$(
                    macos_gui_history_state_read "$macos_gui_history_state_dir" \
                        "$macos_gui_history_pid" exec_count
                )" || {
                    macos_gui_history_result=1
                    break
                }
                macos_gui_history_state_write "$macos_gui_history_state_dir" \
                    "$macos_gui_history_pid" "$macos_gui_history_related" \
                    1 $((macos_gui_history_execs + 1)) || {
                        macos_gui_history_result=1
                        break
                    }
                ;;
            fork)
                [ -z "$macos_gui_history_path" ] || {
                    macos_gui_history_result=1
                    break
                }
                macos_gui_history_parent="$macos_gui_history_pid"
                macos_gui_history_child="$macos_gui_history_related"
                [ "$macos_gui_history_parent" != "$macos_gui_history_child" ] &&
                    [ -f "$macos_gui_history_state_dir/$macos_gui_history_parent" ] &&
                    [ ! -e "$macos_gui_history_state_dir/$macos_gui_history_child" ] &&
                    [ "$(macos_gui_history_state_read \
                        "$macos_gui_history_state_dir" \
                        "$macos_gui_history_parent" alive)" = 1 ] &&
                    [ "$(macos_gui_history_state_read \
                        "$macos_gui_history_state_dir" \
                        "$macos_gui_history_parent" exec_count)" -gt 0 ] || {
                            macos_gui_history_result=1
                            break
                        }
                macos_gui_history_state_write "$macos_gui_history_state_dir" \
                    "$macos_gui_history_child" "$macos_gui_history_parent" \
                    1 0 || {
                        macos_gui_history_result=1
                        break
                    }
                ;;
            exit)
                [ -z "$macos_gui_history_path" ] &&
                    [ -f "$macos_gui_history_state_dir/$macos_gui_history_pid" ] &&
                    [ "$(macos_gui_history_state_read \
                        "$macos_gui_history_state_dir" \
                        "$macos_gui_history_pid" parent)" = \
                        "$macos_gui_history_related" ] &&
                    [ "$(macos_gui_history_state_read \
                        "$macos_gui_history_state_dir" \
                        "$macos_gui_history_pid" alive)" = 1 ] &&
                    [ "$(macos_gui_history_state_read \
                        "$macos_gui_history_state_dir" \
                        "$macos_gui_history_pid" exec_count)" -gt 0 ] || {
                            macos_gui_history_result=1
                            break
                        }
                macos_gui_history_execs="$(
                    macos_gui_history_state_read "$macos_gui_history_state_dir" \
                        "$macos_gui_history_pid" exec_count
                )"
                macos_gui_history_state_write "$macos_gui_history_state_dir" \
                    "$macos_gui_history_pid" "$macos_gui_history_related" \
                    0 "$macos_gui_history_execs" || {
                        macos_gui_history_result=1
                        break
                    }
                if [ "$macos_gui_history_pid" = \
                        "$macos_gui_history_root_pid" ]; then
                    for macos_gui_history_state in \
                        "$macos_gui_history_state_dir"/*; do
                        [ "$(macos_gui_history_value alive \
                            "$macos_gui_history_state")" = 0 ] || {
                            macos_gui_history_result=1
                            break
                        }
                    done
                    [ "$macos_gui_history_result" = 0 ] || break
                    macos_gui_history_root_exited=1
                fi
                ;;
            *) macos_gui_history_result=1; break ;;
        esac
    done <"$macos_gui_history_events"
    [ "$macos_gui_history_result" = 0 ] &&
        [ "$macos_gui_history_root_exited" = 1 ] &&
        [ "$macos_gui_history_observed_count" = \
            "$macos_gui_history_expected_count" ] ||
        macos_gui_history_result=1
    rm -rf "$macos_gui_history_state_dir"
    return "$macos_gui_history_result"
}

macos_gui_history_verify() {
    macos_gui_history_receipt="$1"
    macos_gui_history_driver="$2"
    macos_gui_history_driver_sha="$3"
    macos_gui_history_root="$4"
    macos_gui_history_require_trust_root "$macos_gui_history_root" || return $?
    macos_gui_history_verify_normalized "$macos_gui_history_receipt" \
        "$macos_gui_history_driver" "$macos_gui_history_driver_sha"
}
