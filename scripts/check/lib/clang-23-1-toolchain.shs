#!/bin/sh
# Resolve and validate one coherent LLVM/Clang 23.1 provider.

clang_23_1_version() {
    tool_path="$1"
    tool_role="$2"
    case "$tool_role" in
        clang)
            "$tool_path" --version 2>/dev/null \
                | awk 'NR == 1 && NF == 3 && $1 == "clang" && $2 == "version" && $3 ~ /^[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*$/ { print $3; exit }'
            ;;
        lld|ld.lld)
            "$tool_path" --version 2>/dev/null \
                | awk 'NR == 1 && NF == 2 && $1 == "LLD" && $2 ~ /^[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*$/ { print $2; exit }'
            ;;
        llvm-config)
            "$tool_path" --version 2>/dev/null \
                | awk 'NR == 1 && NF == 1 && $1 ~ /^[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*$/ { print $1; exit }'
            ;;
        *)
            "$tool_path" --version 2>/dev/null \
                | awk 'NR == 1 && NF == 3 && $1 == "LLVM" && $2 == "version" && $3 ~ /^[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*$/ { print $3; exit }'
            ;;
    esac
}

clang_23_1_require() {
    tool_path="$1"
    tool_role="$2"
    [ -x "$tool_path" ] || {
        echo "Clang 23.1 toolchain: missing $tool_role executable: $tool_path" >&2
        return 1
    }
    observed_version="$(clang_23_1_version "$tool_path" "$tool_role")"
    [ "$observed_version" = "23.1.0" ] || {
        echo "Clang 23.1 toolchain: rejected $tool_role $tool_path (reported ${observed_version:-unparseable}; expected 23.1.0)" >&2
        return 1
    }
}

clang_23_1_find() {
    for candidate in "$@"; do
        if command -v "$candidate" >/dev/null 2>&1; then
            command -v "$candidate"
            return 0
        fi
    done
    return 1
}

resolve_clang_23_1_toolchain() {
    prefix="${LLVM_23_1_PREFIX:-}"
    if [ -n "${CLANG:-}" ]; then
        CLANG_23_1="$(command -v "$CLANG" 2>/dev/null || true)"
    elif [ -n "$prefix" ]; then
        CLANG_23_1="$prefix/bin/clang"
    else
        CLANG_23_1="$(clang_23_1_find clang-23.1 clang-23 clang || true)"
    fi
    [ -n "$CLANG_23_1" ] || {
        echo "Clang 23.1 toolchain: compiler not found; set LLVM_23_1_PREFIX or CLANG to an llvmorg-23.1 provider" >&2
        return 1
    }

    inferred_bin="$(CDPATH= cd -- "$(dirname -- "$CLANG_23_1")" && pwd)"
    if [ -n "${LINKER:-}" ]; then
        LLD_23_1="$(command -v "$LINKER" 2>/dev/null || true)"
    elif [ -n "$prefix" ]; then
        LLD_23_1="$prefix/bin/ld.lld"
    else
        LLD_23_1="$(clang_23_1_find "$inferred_bin/ld.lld" ld.lld-23.1 ld.lld-23 ld.lld || true)"
    fi
    if [ -n "${LLVM_AR:-}" ]; then
        LLVM_AR_23_1="$(command -v "$LLVM_AR" 2>/dev/null || true)"
    elif [ -n "$prefix" ]; then
        LLVM_AR_23_1="$prefix/bin/llvm-ar"
    else
        LLVM_AR_23_1="$(clang_23_1_find "$inferred_bin/llvm-ar" llvm-ar-23.1 llvm-ar-23 llvm-ar || true)"
    fi

    clang_23_1_require "$CLANG_23_1" clang || return 1
    clang_23_1_require "$LLD_23_1" lld || return 1
    clang_23_1_require "$LLVM_AR_23_1" llvm-ar || return 1
    export CLANG_23_1 LLD_23_1 LLVM_AR_23_1
}

validate_clang_23_1_toolchain() {
    resolve_clang_23_1_toolchain
}

# Admit a complete LLVM 23.1 command-line provider rooted at one explicit
# prefix.  Unlike resolve_clang_23_1_toolchain this deliberately does not
# inspect PATH or honour per-tool overrides: bootstrap runners use it when a
# mixed system package/toolchain would invalidate the evidence.
clang_23_1_require_full_provider_prefix() {
    provider_prefix=${1:-}
    case "$provider_prefix" in
        /*) ;;
        *)
            echo "Clang 23.1 toolchain: provider prefix must be an absolute path" >&2
            return 1
            ;;
    esac

    command -v realpath >/dev/null 2>&1 || {
        echo "Clang 23.1 toolchain: realpath is required for strict provider admission" >&2
        return 1
    }
    provider_prefix=$(realpath "$provider_prefix") || return 1

    for provider_tool in clang ld.lld llvm-ar llvm-as opt llc llvm-config llvm-objcopy llvm-nm llvm-readobj; do
        provider_tool_path=$(realpath "$provider_prefix/bin/$provider_tool") || return 1
        case "$provider_tool_path" in
            "$provider_prefix"/bin/*) ;;
            *)
                echo "Clang 23.1 toolchain: provider tool escapes prefix: $provider_tool_path" >&2
                return 1
                ;;
        esac
        clang_23_1_require "$provider_tool_path" "$provider_tool" || return 1
    done

    CLANG_23_1=$(realpath "$provider_prefix/bin/clang")
    LLD_23_1=$(realpath "$provider_prefix/bin/ld.lld")
    LLVM_AR_23_1=$(realpath "$provider_prefix/bin/llvm-ar")
    LLVM_AS_23_1=$(realpath "$provider_prefix/bin/llvm-as")
    LLVM_OPT_23_1=$(realpath "$provider_prefix/bin/opt")
    LLC_23_1=$(realpath "$provider_prefix/bin/llc")
    LLVM_CONFIG_23_1=$(realpath "$provider_prefix/bin/llvm-config")
    LLVM_OBJCOPY_23_1=$(realpath "$provider_prefix/bin/llvm-objcopy")
    LLVM_NM_23_1=$(realpath "$provider_prefix/bin/llvm-nm")
    LLVM_READOBJ_23_1=$(realpath "$provider_prefix/bin/llvm-readobj")
    export CLANG_23_1 LLD_23_1 LLVM_AR_23_1 LLVM_AS_23_1 LLVM_OPT_23_1 \
        LLC_23_1 LLVM_CONFIG_23_1 LLVM_OBJCOPY_23_1 LLVM_NM_23_1 \
        LLVM_READOBJ_23_1
}
