#!/bin/sh
# Closed compiler-in-filesystem designation policy shared by every SOSIX lane.
#
# The live matrix deliberately has no promoted compiler-bearing cell yet.  The
# fixture switch is test-only and must be explicitly enabled by a contract;
# production callers cannot turn it on through an ambient environment value.

sosix_qemu_compiler_designation_policy_validate() {
    sosix_designation_policy=$1
    [ -f "$sosix_designation_policy" ] || return 1
    awk -F'|' '
      BEGIN {
        split("linux windows macos freebsd", hosts, " ")
        split("x86_32 x86_64 arm32 arm64 riscv32 riscv64", guests, " ")
        for (i in hosts) valid_host[hosts[i]]=1
        for (i in guests) valid_guest[guests[i]]=1
      }
      NF != 3 || !valid_host[$1] || !valid_guest[$2] || ($3 != "true" && $3 != "false") { bad=1; next }
      { key=$1 "|" $2; if (++seen[key] != 1) bad=1; rows++ }
      END {
        if (rows != 24) bad=1
        for (h in valid_host) for (g in valid_guest) if (seen[h "|" g] != 1) bad=1
        exit bad
      }
    ' "$sosix_designation_policy"
}

sosix_qemu_compiler_designation_live() {
    sosix_designation_host=$1
    sosix_designation_guest=$2
    sosix_designation_policy=${SOSIX_QEMU_COMPILER_DESIGNATION_POLICY:?designation policy path is required}
    sosix_qemu_compiler_designation_policy_validate "$sosix_designation_policy" || return 1
    awk -F'|' -v h="$sosix_designation_host" -v g="$sosix_designation_guest" \
        '$1 == h && $2 == g { print $3 }' "$sosix_designation_policy"
}

sosix_qemu_compiler_designation_fixture() {
    sosix_designation_host=$1
    sosix_designation_guest=$2
    sosix_designation_fixture=${3:-}
    if [ "${SOSIX_QEMU_TEST_MODE:-}" = 1 ] &&
       [ "$sosix_designation_fixture" = "$sosix_designation_host:$sosix_designation_guest" ]; then
        printf true
    else
        sosix_qemu_compiler_designation_live "$sosix_designation_host" "$sosix_designation_guest"
    fi
}

sosix_qemu_compiler_designation_accepts() {
    sosix_designation_host=$1
    sosix_designation_guest=$2
    sosix_designation_claim=$3
    sosix_designation_fixture=${4:-}
    case "$sosix_designation_claim" in true|false) ;; *) return 1 ;; esac
    [ "$sosix_designation_claim" = "$(sosix_qemu_compiler_designation_fixture \
        "$sosix_designation_host" "$sosix_designation_guest" "$sosix_designation_fixture")" ]
}
