#!/bin/sh
# Canonical Stage 3 bootstrap provenance facade.
#
# Keep this file small: each sourced module is independently byte-bound by the
# manifest, and consumers source only this canonical facade.

: "${BOOTSTRAP_STAGE3_FACADE_PATH:?canonical facade path is required}"
if [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" = 1 ]; then
    : "${BOOTSTRAP_STAGE3_AUTHORITY_DESCRIPTOR:?descriptor capsule authority}"
    : "${BOOTSTRAP_STAGE3_COMMAND_DESCRIPTOR:?descriptor capsule command}"
    : "${BOOTSTRAP_STAGE3_SANITY_DESCRIPTOR:?descriptor capsule sanity}"
    : "${BOOTSTRAP_STAGE3_MANIFEST_WRITE_DESCRIPTOR:?descriptor capsule writer}"
    : "${BOOTSTRAP_STAGE3_MANIFEST_VERIFY_DESCRIPTOR:?descriptor capsule verifier}"
    : "${BOOTSTRAP_STAGE3_SELF_TEST_DESCRIPTOR:?descriptor capsule self-test}"
    : "${BOOTSTRAP_STAGE3_RUNNER_DESCRIPTOR:?descriptor capsule runner}"
    bootstrap_stage3_facade_dir=
    bootstrap_stage3_authority_module=$BOOTSTRAP_STAGE3_AUTHORITY_DESCRIPTOR
    bootstrap_stage3_command_module=$BOOTSTRAP_STAGE3_COMMAND_DESCRIPTOR
    bootstrap_stage3_sanity_module=$BOOTSTRAP_STAGE3_SANITY_DESCRIPTOR
    bootstrap_stage3_manifest_write_module=$BOOTSTRAP_STAGE3_MANIFEST_WRITE_DESCRIPTOR
    bootstrap_stage3_manifest_verify_module=$BOOTSTRAP_STAGE3_MANIFEST_VERIFY_DESCRIPTOR
    bootstrap_stage3_self_test_module=$BOOTSTRAP_STAGE3_SELF_TEST_DESCRIPTOR
    bootstrap_stage3_runner_module=$BOOTSTRAP_STAGE3_RUNNER_DESCRIPTOR
else
    bootstrap_stage3_facade_dir=$(
        CDPATH= cd -- "$(dirname -- "$BOOTSTRAP_STAGE3_FACADE_PATH")" && pwd -P
    ) || return 1 2>/dev/null || exit 1
    [ "$BOOTSTRAP_STAGE3_FACADE_PATH" = \
        "$bootstrap_stage3_facade_dir/bootstrap-stage3-provenance.shs" ] || {
        return 1 2>/dev/null || exit 1
    }
    bootstrap_stage3_authority_module="$bootstrap_stage3_facade_dir/bootstrap-stage3/authority.shs"
    bootstrap_stage3_command_module="$bootstrap_stage3_facade_dir/bootstrap-stage3/command-snapshot.shs"
    bootstrap_stage3_sanity_module="$bootstrap_stage3_facade_dir/bootstrap-stage3/sanity.shs"
    bootstrap_stage3_manifest_write_module="$bootstrap_stage3_facade_dir/bootstrap-stage3/manifest-write.shs"
    bootstrap_stage3_manifest_verify_module="$bootstrap_stage3_facade_dir/bootstrap-stage3/manifest-verify.shs"
    bootstrap_stage3_self_test_module="$bootstrap_stage3_facade_dir/bootstrap-stage3/self-test.shs"
    bootstrap_stage3_runner_module="$bootstrap_stage3_facade_dir/bootstrap-stage3/runner.shs"
fi

for bootstrap_stage3_helper_module in \
    "$bootstrap_stage3_authority_module" \
    "$bootstrap_stage3_command_module" \
    "$bootstrap_stage3_sanity_module" \
    "$bootstrap_stage3_manifest_write_module" \
    "$bootstrap_stage3_manifest_verify_module" \
    "$bootstrap_stage3_self_test_module" \
    "$bootstrap_stage3_runner_module"; do
    [ -f "$bootstrap_stage3_helper_module" ] && {
        [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" = 1 ] ||
            [ ! -L "$bootstrap_stage3_helper_module" ]
    } || {
        echo "bootstrap Stage 3 provenance: helper module invalid" >&2
        return 1 2>/dev/null || exit 1
    }
    . "$bootstrap_stage3_helper_module"
done

bootstrap_stage3_helper_bundle_snapshot() {
    bootstrap_stage3_bundle_output=$1
    bootstrap_stage3_bundle_tmp="${bootstrap_stage3_bundle_output}.tmp.$$"
    : >"$bootstrap_stage3_bundle_tmp" || return 1
    for bootstrap_stage3_bundle_file in \
        "$BOOTSTRAP_STAGE3_FACADE_PATH" \
        "$bootstrap_stage3_authority_module" \
        "$bootstrap_stage3_command_module" \
        "$bootstrap_stage3_sanity_module" \
        "$bootstrap_stage3_manifest_write_module" \
        "$bootstrap_stage3_manifest_verify_module" \
        "$bootstrap_stage3_self_test_module" \
        "$bootstrap_stage3_runner_module"; do
        if [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" != 1 ]; then
            [ "$(bootstrap_stage3_canonical_file \
                "$bootstrap_stage3_bundle_file")" = \
                "$bootstrap_stage3_bundle_file" ] || return 1
        fi
        printf '%s  %s\n' \
            "$(bootstrap_stage3_hash_file "$bootstrap_stage3_bundle_file")" \
            "$bootstrap_stage3_bundle_file" \
            >>"$bootstrap_stage3_bundle_tmp" || return 1
    done
    mv "$bootstrap_stage3_bundle_tmp" "$bootstrap_stage3_bundle_output"
}

bootstrap_stage3_helper_bundle_fingerprint() {
    bootstrap_stage3_bundle_dir=$(
        mktemp -d "${TMPDIR:-/tmp}/bootstrap-stage3-helpers.XXXXXX"
    ) || return 1
    bootstrap_stage3_bundle_snapshot="$bootstrap_stage3_bundle_dir/modules"
    bootstrap_stage3_helper_bundle_snapshot \
        "$bootstrap_stage3_bundle_snapshot" || {
        rm -rf "$bootstrap_stage3_bundle_dir"
        return 1
    }
    bootstrap_stage3_bundle_sha=$(
        bootstrap_stage3_hash_file "$bootstrap_stage3_bundle_snapshot"
    ) || {
        rm -rf "$bootstrap_stage3_bundle_dir"
        return 1
    }
    rm -rf "$bootstrap_stage3_bundle_dir"
    printf '%s\n' "$bootstrap_stage3_bundle_sha"
}
