#!/bin/sh
set -eu

root= source_output= jobs= supervised= evidence_run_id= rss_raw=
rss_sampler= rss_sampler_sha256= admitted_option= admitted_option_sha256=
compatibility_marker= runner_plan= runner_plan_sha256= env_tool=
planner_admission=
platform= root_dir= root_dev= root_ino= stage2= stage2_admission= seed= stamp= native_all=
backfill= stage2_sanity= stage2_receiver= stage2_receiver_log=
stage2_transcript= stage2_log= source_before= git_before= tool_before=
runtime_origin_before= runtime_origin_after= runtime_admitted= stage2_cache=
stage3_cache= runtime= home= tmp= jobs_receipt= candidate= manifest=
stage3_transcript= stage3_log= stage3_sanity= source_after= git_after=
tool_after= progress=
descriptor_map= result_descriptor_map=
descriptor_map_sha256= stage3_display_root=

[ "$#" -ge 1 ] || exit 64
candidate_builder_seen=' '
for option in "$@"; do
  candidate_builder_key=${option%%=*}
  case "$candidate_builder_seen" in
    *" $candidate_builder_key "*) exit 64 ;;
  esac
  candidate_builder_seen="$candidate_builder_seen$candidate_builder_key "
  case "$option" in
    --jobs=*) [ -z "$jobs" ] || exit 64; jobs=${option#*=} ;;
    --supervised-stage3) [ -z "$supervised" ] || exit 64; supervised=1 ;;
    --platform=*) platform=${option#*=} ;;
    --repository-root=*) [ -z "$root" ] || exit 64; root=${option#*=} ;;
    --root-dir=*) root_dir=${option#*=} ;;
    --root-dev=*) root_dev=${option#*=} ;;
    --root-ino=*) root_ino=${option#*=} ;;
    --source-output-display=*) source_output=${option#*=} ;;
    --evidence-run-id=*) [ -z "$evidence_run_id" ] || exit 64; evidence_run_id=${option#*=} ;;
    --rss-raw=*) [ -z "$rss_raw" ] || exit 64; rss_raw=${option#*=} ;;
    --rss-sampler=*) [ -z "$rss_sampler" ] || exit 64; rss_sampler=${option#*=} ;;
    --rss-sampler-sha256=*) [ -z "$rss_sampler_sha256" ] || exit 64; rss_sampler_sha256=${option#*=} ;;
    --admitted-compiler=*) [ -z "$admitted_option" ] || exit 64; admitted_option=${option#*=} ;;
    --admitted-compiler-sha256=*) [ -z "$admitted_option_sha256" ] || exit 64; admitted_option_sha256=${option#*=} ;;
    --compatibility-marker=*) [ -z "$compatibility_marker" ] || exit 64; compatibility_marker=${option#*=} ;;
    --runner-plan=*) [ -z "$runner_plan" ] || exit 64; runner_plan=${option#*=} ;;
    --runner-plan-sha256=*) [ -z "$runner_plan_sha256" ] || exit 64; runner_plan_sha256=${option#*=} ;;
    --env-tool=*) [ -z "$env_tool" ] || exit 64; env_tool=${option#*=} ;;
    --planner-admission=*) [ -z "$planner_admission" ] || exit 64; planner_admission=${option#*=} ;;
    --stage2=*) stage2=${option#*=} ;;
    --stage2-admission=*) stage2_admission=${option#*=} ;;
    --seed=*) seed=${option#*=} ;;
    --seed-stamp=*) stamp=${option#*=} ;;
    --native-all=*) native_all=${option#*=} ;;
    --compiler-backfill=*) backfill=${option#*=} ;;
    --stage2-sanity=*) stage2_sanity=${option#*=} ;;
    --stage2-receiver=*) stage2_receiver=${option#*=} ;;
    --stage2-receiver-log=*) stage2_receiver_log=${option#*=} ;;
    --stage2-transcript=*) stage2_transcript=${option#*=} ;;
    --stage2-build-log=*) stage2_log=${option#*=} ;;
    --source-before=*) source_before=${option#*=} ;;
    --git-before=*) git_before=${option#*=} ;;
    --tool-before=*) tool_before=${option#*=} ;;
    --runtime-origin-before=*) runtime_origin_before=${option#*=} ;;
    --runtime-origin-after=*) runtime_origin_after=${option#*=} ;;
    --runtime-admitted=*) runtime_admitted=${option#*=} ;;
    --stage2-cache-dir=*) stage2_cache=${option#*=} ;;
    --stage3-cache-dir=*) stage3_cache=${option#*=} ;;
    --runtime-dir=*) runtime=${option#*=} ;;
    --private-home=*) home=${option#*=} ;;
    --private-tmp=*) tmp=${option#*=} ;;
    --jobs-receipt=*) jobs_receipt=${option#*=} ;;
    --candidate-output=*) candidate=${option#*=} ;;
    --candidate-provenance=*) manifest=${option#*=} ;;
    --stage3-transcript=*) stage3_transcript=${option#*=} ;;
    --stage3-build-log=*) stage3_log=${option#*=} ;;
    --stage3-sanity=*) stage3_sanity=${option#*=} ;;
    --source-after=*) source_after=${option#*=} ;;
    --git-after=*) git_after=${option#*=} ;;
    --tool-after=*) tool_after=${option#*=} ;;
    --progress=*) progress=${option#*=} ;;
    --descriptor-map=*) descriptor_map=${option#*=} ;;
    --descriptor-map-sha256=*) descriptor_map_sha256=${option#*=} ;;
    --result-descriptor-map=*) result_descriptor_map=${option#*=} ;;
    --stage3-display-root=*) stage3_display_root=${option#*=} ;;
    *) echo "stage3 candidate builder: unknown option: $option" >&2; exit 64 ;;
  esac
done
for value in "$root" "$source_output" "$jobs" "$supervised" \
    "$evidence_run_id" "$rss_raw" "$rss_sampler" "$rss_sampler_sha256" \
    "$admitted_option" "$admitted_option_sha256" "$compatibility_marker" \
    "$runner_plan" "$runner_plan_sha256" "$env_tool" "$planner_admission" \
    "$platform" "$root_dir" "$root_dev" "$root_ino" "$stage2" "$stage2_admission" "$seed" "$stamp" \
    "$native_all" "$backfill" "$stage2_sanity" "$stage2_receiver" \
    "$stage2_receiver_log" "$stage2_transcript" "$stage2_log" "$source_before" \
    "$git_before" "$tool_before" "$runtime_origin_before" \
    "$runtime_origin_after" "$runtime_admitted" "$stage2_cache" \
    "$stage3_cache" "$runtime" "$home" "$tmp" "$jobs_receipt" "$candidate" \
    "$manifest" "$stage3_transcript" "$stage3_log" "$stage3_sanity" \
    "$source_after" "$git_after" "$tool_after" "$progress" \
    "$descriptor_map" "$descriptor_map_sha256" "$result_descriptor_map" \
    "$stage3_display_root"; do
  [ -n "$value" ] || exit 64
done
[ "$jobs" = 1 ] && [ "$supervised" = 1 ] || exit 64
[ "${BOOTSTRAP_STAGE3_CAPSULE_ENTRY:-}" = stage3 ] && \
  [ "${BOOTSTRAP_STAGE3_CAPSULE_LOADED:-}" = 1 ] && \
  [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-}" = 1 ] || exit 64
case "$root" in /*) ;; *) exit 64 ;; esac
[ "$platform" = x86_64-unknown-linux-gnu ] || exit 64
candidate_builder_procfd() {
  expr "$1" : '/proc/[1-9][0-9]*/fd/[0-9][0-9]*$' >/dev/null
}
candidate_builder_output_leaf() {
  expr "$1" : '/proc/[1-9][0-9]*/fd/[0-9][0-9]*/[A-Za-z0-9_.-][A-Za-z0-9_.-]*$' >/dev/null
}
candidate_builder_procfd "$root_dir" || exit 64
[ -d "$root_dir" ] || exit 64

[ "$(wc -l <"$planner_admission" | tr -d ' ')" -eq 29 ] || exit 64
[ "$(bootstrap_planner_v2_field schema "$planner_admission")" = \
  simple-bootstrap-planner-admission-v2 ] || exit 64
[ "$(bootstrap_planner_v2_field status "$planner_admission")" = pass ] || exit 64
[ "$(bootstrap_planner_v2_field target "$planner_admission")" = \
  //bootstrap:stage3 ] || exit 64

admitted=$admitted_option

for required in "$stage2" "$admitted" "$stage2_admission" "$seed" "$stamp" "$native_all" \
  "$stage2_sanity" "$stage2_receiver" "$stage2_receiver_log" \
  "$stage2_transcript" "$stage2_log" "$source_before" \
  "$git_before" \
  "$runtime_origin_before" "$runtime_origin_after" "$runtime_admitted" \
  "$tool_before"; do
  [ -f "$required" ] || exit 1
  candidate_builder_procfd "$required" || exit 64
done
for descriptor_input in "$planner_admission" "$rss_sampler" "$runner_plan" \
    "$env_tool"; do
  candidate_builder_procfd "$descriptor_input" || exit 64
done
for required_dir in "$runtime" "$stage2_cache" "$stage3_cache" "$home" "$tmp"; do
  [ -d "$required_dir" ] || exit 1
  candidate_builder_procfd "$required_dir" || exit 64
done
for output_leaf in "$jobs_receipt" "$candidate" "$manifest" \
    "$stage3_transcript" "$stage3_log" "$stage3_sanity" \
    "$source_after" "$git_after" "$tool_after" \
    "$progress" "$rss_raw" "$result_descriptor_map"; do
  candidate_builder_output_leaf "$output_leaf" || exit 64
  [ ! -e "$output_leaf" ] && [ ! -L "$output_leaf" ] || exit 64
done
candidate_builder_procfd "$descriptor_map" || exit 64
[ -f "$descriptor_map" ] || exit 64
case "$stage3_display_root" in /*) ;; *) exit 64 ;; esac

descriptor_roles='root admitted compiler_backfill git_before native_all runtime_admitted runtime_dir runtime_origin_after runtime_origin_before seed seed_stamp source_before stage2 stage2_admission stage2_build_log stage2_cache_dir stage2_receiver stage2_receiver_log stage2_sanity stage2_transcript tool_before stage3_cache_dir private_home private_tmp'
bootstrap_stage3_validate_descriptor_map "$descriptor_map" \
  "$descriptor_map_sha256" simple-stage3-authority-descriptors-v2 \
  "$evidence_run_id" "$platform" "$descriptor_roles" || exit 65
descriptor_matches() {
  descriptor_role=$1 descriptor_value=$2
  [ "$(bootstrap_stage3_descriptor_map_value "$descriptor_map" \
    "$descriptor_role" descriptor)" = "$descriptor_value" ]
}
for descriptor_binding in \
    "root:$root_dir" "stage2:$stage2" "admitted:$admitted_option" \
    "stage2_admission:$stage2_admission" "seed:$seed" \
    "seed_stamp:$stamp" "native_all:$native_all" \
    "stage2_sanity:$stage2_sanity" "stage2_receiver:$stage2_receiver" \
    "stage2_receiver_log:$stage2_receiver_log" \
    "stage2_transcript:$stage2_transcript" "stage2_build_log:$stage2_log" \
    "source_before:$source_before" "git_before:$git_before" \
    "tool_before:$tool_before" "runtime_origin_before:$runtime_origin_before" \
    "runtime_origin_after:$runtime_origin_after" \
    "runtime_admitted:$runtime_admitted" "runtime_dir:$runtime" \
    "stage2_cache_dir:$stage2_cache" "stage3_cache_dir:$stage3_cache" \
    "private_home:$home" "private_tmp:$tmp"; do
  descriptor_matches "${descriptor_binding%%:*}" \
    "${descriptor_binding#*:}" || exit 65
done
if [ "$backfill" = absent ]; then
  descriptor_matches compiler_backfill descriptor-absent || exit 65
else
  descriptor_matches compiler_backfill "$backfill" || exit 65
fi
display_of() {
  bootstrap_stage3_descriptor_map_value "$descriptor_map" "$1" display_token
}
for display_binding in \
    "stage2:$source_output/output/stage2/$platform/simple" \
    "admitted:$source_output/output/stage3/$platform/stage2-admitted/simple" \
    "stage2_admission:$source_output/output/stage3/$platform/stage2-admitted/admission.env" \
    "seed:$source_output/output/stage3/$platform/stage2-runtime-authority/simple" \
    "seed_stamp:$source_output/output/stage3/$platform/stage2-runtime-authority/simple.inputs.sha256" \
    "native_all:$source_output/output/stage3/$platform/stage2-runtime-authority/libsimple_native_all.a" \
    "stage2_sanity:$source_output/output/stage3/$platform/stage2-sanity.env" \
    "stage2_receiver:$source_output/output/stage3/$platform/stage2-receiver.env" \
    "stage2_receiver_log:$source_output/output/stage3/$platform/stage2-receiver.log" \
    "stage2_transcript:$source_output/output/stage3/$platform/stage2-command.transcript" \
    "stage2_build_log:$source_output/output/logs/$platform/stage2-native-build.log" \
    "source_before:$source_output/output/stage3/$platform/source-inputs-before.txt" \
    "git_before:$source_output/output/stage3/$platform/git-state-before.env" \
    "tool_before:$source_output/output/stage3/$platform/tool-authority-before.txt" \
    "runtime_origin_before:$source_output/output/stage3/$platform/runtime-origin-before.txt" \
    "runtime_origin_after:$source_output/output/stage3/$platform/runtime-origin-after.txt" \
    "runtime_admitted:$source_output/output/stage3/$platform/runtime-admitted.txt" \
    "runtime_dir:$source_output/output/stage3/$platform/stage2-runtime-authority" \
    "stage2_cache_dir:$source_output/output/stage3/$platform/stage2-native-cache"; do
  [ "$(display_of "${display_binding%%:*}")" = \
    "${display_binding#*:}" ] || exit 65
done

stage2_sha=$(bootstrap_stage3_hash_file "$stage2")
admitted_sha=$(bootstrap_stage3_hash_file "$admitted")
[ "$stage2_sha" = "$admitted_sha" ] || exit 1
[ "$admitted" = "$admitted_option" ] || exit 1
[ "$admitted_sha" = "$admitted_option_sha256" ] || exit 1
[ -f "$rss_sampler" ] || exit 1
[ "$(bootstrap_stage3_hash_file "$rss_sampler")" = "$rss_sampler_sha256" ] || exit 1
[ -f "$runner_plan" ] || exit 1
[ "$(bootstrap_stage3_hash_file "$runner_plan")" = "$runner_plan_sha256" ] || exit 1
[ -x "$env_tool" ] || exit 1
[ "$(bootstrap_stage3_manifest_value status "$stage2_sanity")" = pass ] || exit 1
[ "$(bootstrap_stage3_manifest_value candidate_sha256_after "$stage2_sanity")" = "$admitted_sha" ] || exit 1
stage2_backend=$(bootstrap_stage3_transcript_argv_value_after \
  "$stage2_transcript" --backend) || exit 1
stage2_threads=$(bootstrap_stage3_transcript_argv_value_after \
  "$stage2_transcript" --threads) || exit 1
stage2_compile_stack_mib=$(bootstrap_stage3_transcript_argv_value_after \
  "$stage2_transcript" --compile-stack-mib) || exit 1
stage2_progress=$(bootstrap_stage3_transcript_explicit_env_value \
  "$stage2_transcript" SIMPLE_BUILD_PROGRESS_EVENTS) || exit 1
case "$stage2_backend" in llvm|llvm-lib|cranelift) ;; *) exit 1 ;; esac
case "$stage2_threads" in ''|*[!0-9]*|0) exit 1 ;; esac
case "$stage2_compile_stack_mib" in ''|*[!0-9]*|0) exit 1 ;; esac
stage2_args=$(bootstrap_stage3_args_sha256 \
  "RUST_LOG=error" "LIBRARY_PATH=" "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=absent" \
  "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
  "SIMPLE_NATIVE_BUILD_RUST=1" "SIMPLE_NO_STUB_FALLBACK=1" \
  "SIMPLE_BUILD_PROGRESS_EVENTS=$stage2_progress" "SIMPLE_BINARY=$seed" \
  native-build --target "$platform" --backend "$stage2_backend" \
  --runtime-bundle core-c-bootstrap --source src/compiler --source src/app \
  --source src/lib --entry-closure --threads "$stage2_threads" \
  --compile-stack-mib "$stage2_compile_stack_mib" \
  --cache-dir "$stage2_cache" --mode dynload --entry src/app/cli/bootstrap_main.spl \
  --runtime-path "$runtime" -o "$stage2")
# The shared runner validates the descriptor-bound Stage-2 receipt bundle before
# this child starts. Re-running the legacy path verifier here would reopen the
# receipt's display-only paths.
path=$(bootstrap_stage3_transcript_host_value "$stage2_transcript" PATH)
cmp -s "$runtime_origin_before" "$runtime_origin_after"
cmp -s "$runtime_origin_after" "$runtime_admitted"
for candidate_builder_dir in "$stage3_cache" "$home" "$tmp"; do
  [ -d "$candidate_builder_dir" ] || exit 1
done
bootstrap_build_jobs_write_receipt "$jobs_receipt" candidate-builder
jobs_receipt_sha256_before=$(bootstrap_stage3_hash_file "$jobs_receipt")

# Stage-2 authority files remain immutable descriptor-bound inputs.
script=$BOOTSTRAP_STAGE3_BOOTSTRAP_SCRIPT_DESCRIPTOR
helper=$BOOTSTRAP_STAGE3_FACADE_PATH
script_sha_before=$(bootstrap_stage3_hash_file "$script")
helper_sha_before=$(bootstrap_stage3_hash_file "$helper")
helper_bundle_before=$(bootstrap_stage3_helper_bundle_fingerprint)
seed_fingerprint=$(bootstrap_stage3_manifest_value inputs_fingerprint "$stamp")
memory_snapshot=${SIMPLE_MEM_SNAPSHOT_FILE:?}
phase_profile=${SIMPLE_COMPILER_PHASE_PROFILE_FILE:?}
[ "$SIMPLE_BUILD_PROGRESS_EVENTS" = "$progress" ] || exit 64
candidate_builder_output_leaf "$memory_snapshot" || exit 64
candidate_builder_output_leaf "$phase_profile" || exit 64
[ ! -e "$memory_snapshot" ] && [ ! -L "$memory_snapshot" ] || exit 1
[ ! -e "$phase_profile" ] && [ ! -L "$phase_profile" ] || exit 1

# See bootstrap_stage3_diagnostic_env in
# scripts/check/lib/bootstrap-stage3/authority.shs.  Computed once, word-split
# into both the args hash and the real invocation so they cannot diverge; empty
# unless an allowlisted print-only probe var is set to exactly 1.
stage3_diagnostic_env=$(bootstrap_stage3_diagnostic_env) || exit 1
stage3_args=$(bootstrap_stage3_args_sha256 \
  "RUST_LOG=error" "LIBRARY_PATH=" "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=absent" \
  "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
  "SIMPLE_STAGE3_STREAMING_SURFACES=1" \
  "SIMPLE_FRONTEND_CACHE=0" \
  "MALLOC_ARENA_MAX=2" "MALLOC_TRIM_THRESHOLD_=0" \
  "SIMPLE_NATIVE_ARENA_DECLS=1" "SIMPLE_NO_STUB_FALLBACK=1" \
  "SIMPLE_BUILD_PROGRESS_EVENTS=$progress" \
  "SIMPLE_COMPILER_PHASE_PROFILE=1" \
  "SIMPLE_COMPILER_PHASE_PROFILE_FILE=$phase_profile" \
  "SIMPLE_MEM_SNAPSHOT_FILE=$memory_snapshot" \
  "SIMPLE_EVIDENCE_RUN_ID=$evidence_run_id" \
  "LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING=1" \
  "SIMPLE_NATIVE_BUILD_TARGET=$platform" "SIMPLE_NATIVE_BUILD_THREADS=$jobs" \
  "SIMPLE_NATIVE_BUILD_CACHE_DIR=$stage3_cache" "SIMPLE_RUNTIME_PATH=$runtime" \
  "SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap" "SIMPLE_BINARY=$admitted" \
  ${stage3_diagnostic_env} \
  native-build --target "$platform" --backend "$stage2_backend" \
  --runtime-bundle core-c-bootstrap --threads "$jobs" --cache-dir "$stage3_cache" \
  --mode dynload --runtime-path "$runtime" -o "$candidate" \
  src/app/cli/bootstrap_main.spl)

set +e
bootstrap_stage3_run_transcribed "$stage3_transcript" "$root_dir" "$stage3_log" \
  "$home" "$tmp" "$path" RUST_LOG=error LIBRARY_PATH= \
  SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=absent SIMPLE_BOOTSTRAP=1 \
  SIMPLE_NO_DEPRECATED_WARNINGS=1 SIMPLE_STAGE3_STREAMING_SURFACES=1 \
  SIMPLE_FRONTEND_CACHE=0 \
  MALLOC_ARENA_MAX=2 MALLOC_TRIM_THRESHOLD_=0 SIMPLE_NATIVE_ARENA_DECLS=1 \
  SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_BUILD_PROGRESS_EVENTS="$progress" \
  SIMPLE_COMPILER_PHASE_PROFILE=1 \
  SIMPLE_COMPILER_PHASE_PROFILE_FILE="$phase_profile" \
  SIMPLE_MEM_SNAPSHOT_FILE="$memory_snapshot" \
  SIMPLE_EVIDENCE_RUN_ID="$evidence_run_id" \
  LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING=1 \
  SIMPLE_NATIVE_BUILD_TARGET="$platform" SIMPLE_NATIVE_BUILD_THREADS="$jobs" \
  SIMPLE_NATIVE_BUILD_CACHE_DIR="$stage3_cache" SIMPLE_RUNTIME_PATH="$runtime" \
  SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap SIMPLE_BINARY="$admitted" \
  ${stage3_diagnostic_env} -- \
  "$admitted" native-build --target "$platform" --backend "$stage2_backend" \
  --runtime-bundle core-c-bootstrap --threads "$jobs" --cache-dir "$stage3_cache" \
  --mode dynload --runtime-path "$runtime" -o "$candidate" \
  src/app/cli/bootstrap_main.spl
status=$?
set -e
if [ "$status" -ne 0 ]; then
  exit "$status"
fi
[ -x "$candidate" ] || {
  echo "error: Stage 3 compiler exited successfully without an executable candidate" >&2
  exit 1
}
! grep -qE '^(Build complete: [0-9]+ compiled|Linked: .* via clang)' "$stage3_log" || exit 1
[ "$(bootstrap_stage3_hash_file "$admitted")" = "$admitted_sha" ] || exit 1

CANDIDATE_FRONTEND_ROOT=$root_dir
COMPILER_PROBE_TIMEOUT_SECONDS=5
COMPILER_BUILD_TIMEOUT_SECONDS=60
COMPILER_EXEC_TIMEOUT_SECONDS=5
COMPILER_CHECK_KILL_GRACE_SECONDS=1
bootstrap_stage_sanity() (
  candidate_sanity=$1 evidence=$2 sanity_home=$3 sanity_tmp=$4 sanity_path=$5
  for name in $(env | sed 's/=.*//'); do unset "$name"; done
  HOME=$sanity_home TMPDIR=$sanity_tmp PATH=$sanity_path LC_ALL=C LANG=C
  export HOME TMPDIR PATH LC_ALL LANG
  evidence_tmp="$evidence.tmp.$$" frontend_log="$evidence_tmp.frontend"
  before=$(bootstrap_stage3_hash_file "$candidate_sanity")
  version_status=0; version=$(run_timeout 10 "$candidate_sanity" --version 2>&1) || version_status=$?
  unsupported_status=0
  unsupported=$(run_timeout 10 "$candidate_sanity" run scripts/check/cert/redeploy_gate/fixtures/p2_add.spl 2>&1) || unsupported_status=$?
  frontend_status=0
  CANDIDATE_FRONTEND_BACKEND="$stage2_backend" \
    CANDIDATE_FRONTEND_BOOTSTRAP=0 \
    candidate_frontend_smoke "$candidate_sanity" >"$frontend_log" 2>&1 || frontend_status=$?
  frontend_bootstrap_status=0
  if [ "$frontend_status" -eq 0 ]; then
    CANDIDATE_FRONTEND_BACKEND="$stage2_backend" \
      CANDIDATE_FRONTEND_BOOTSTRAP=1 \
      candidate_frontend_smoke "$candidate_sanity" >>"$frontend_log" 2>&1 || \
      frontend_bootstrap_status=$?
    frontend_status=$frontend_bootstrap_status
  fi
  after=$(bootstrap_stage3_hash_file "$candidate_sanity")
  sanity_status=fail
  if [ "$version_status" -eq 0 ] && [ "$version" = "simple-bootstrap 1.0.0-beta" ] && \
    [ "$unsupported_status" -eq 1 ] && case "$unsupported" in *"unknown command 'run'"*) true;; *) false;; esac && \
    [ "$frontend_status" -eq 0 ] && [ "$before" = "$after" ]; then sanity_status=pass; fi
  { echo schema=simple-bootstrap-sanity-evidence-v1; echo status="$sanity_status"; \
    echo candidate_sha256_before="$before"; echo version_status="$version_status"; \
    echo version_output="$version"; echo unsupported_status="$unsupported_status"; \
    printf 'unsupported_output_sha256=%s\n' "$(printf %s "$unsupported" | bootstrap_stage3_hash_stream)"; \
    echo frontend_smoke_status="$frontend_status"; \
    echo frontend_smoke_bootstrap_mode_status="$frontend_bootstrap_status"; \
    echo frontend_smoke_output_sha256="$(bootstrap_stage3_hash_file "$frontend_log")"; \
    echo candidate_sha256_after="$after"; } >"$evidence_tmp"
  mv "$evidence_tmp" "$evidence"; rm -f "$frontend_log"; [ "$sanity_status" = pass ]
)
bootstrap_stage_sanity "$candidate" "$stage3_sanity" "$home" "$tmp" "$path"
# These are post-build captures, not caller-prepared evidence.  Each target was
# required absent above and is descriptor-anchored beneath the coordinator's
# Stage-3 result root.  Capturing only now makes mutations during native-build
# observable instead of comparing two pre-build snapshots.
bootstrap_stage3_tool_authority_snapshot "$tool_after" "$path" "$root_dir"
bootstrap_stage3_git_state "$root_dir" "$git_after"
bootstrap_stage3_source_snapshot "$source_after" "$root_dir"
cmp -s "$source_before" "$source_after"
cmp -s "$git_before" "$git_after"
cmp -s "$tool_before" "$tool_after"

# Preserve the manifest verifier's stable *_path lookup contract while every
# authority value remains a retained descriptor (or a fixed leaf beneath a
# retained output-directory descriptor). Display spellings are audited
# separately and are never reopened for authority.
(
  set -C
  {
    echo schema=simple-stage3-bound-artifact-descriptors-v1
    echo "seed_path=$seed"
    echo "native_all_path=$native_all"
    echo "stage2_path=$stage2"
    echo "stage2_admitted_path=$admitted"
    echo "stage2_build_log_path=$stage2_log"
    echo "stage2_command_transcript_path=$stage2_transcript"
    echo "stage2_sanity_evidence_path=$stage2_sanity"
    echo "stage2_receiver_evidence_path=$stage2_receiver"
    echo "stage2_admission_receipt_path=$stage2_admission"
    echo "stage3_build_log_path=$stage3_log"
    echo "stage3_command_transcript_path=$stage3_transcript"
    echo "stage3_sanity_evidence_path=$stage3_sanity"
    echo "git_state_path=$git_after"
    echo "runtime_origin_snapshot_path=$runtime_origin_after"
    echo "runtime_admitted_snapshot_path=$runtime_admitted"
    echo "tool_authority_path=$tool_after"
    echo "seed_inputs_stamp_path=$stamp"
    echo "source_snapshot_path=$source_after"
    echo "stage3_jobs_receipt_path=$jobs_receipt"
    if [ "$backfill" = absent ]; then
      echo compiler_backfill_path=descriptor-absent
    else
      echo "compiler_backfill_path=$backfill"
    fi
    echo "output_path=$candidate"
    echo "stage2_native_cache_dir=$stage2_cache"
    echo "stage3_native_cache_dir=$stage3_cache"
    echo "runtime_path=$runtime"
    echo "stage2_receiver_log=$stage2_receiver_log"
    echo "source_inputs_before=$source_before"
    echo "tool_authority_before=$tool_before"
    echo "replay_home=$home"
    echo "replay_tmpdir=$tmp"
  } >"$result_descriptor_map"
) || exit 1

BSTAGE3_SEED_DISPLAY=$(display_of seed)
BSTAGE3_SEED_STAMP_DISPLAY=$(display_of seed_stamp)
BSTAGE3_NATIVE_ALL_DISPLAY=$(display_of native_all)
BSTAGE3_BACKFILL_DISPLAY=$(display_of compiler_backfill)
BSTAGE3_STAGE2_DISPLAY=$(display_of stage2)
BSTAGE3_STAGE2_ADMITTED_DISPLAY=$(display_of admitted)
BSTAGE3_STAGE2_ADMISSION_DISPLAY=$(display_of stage2_admission)
BSTAGE3_STAGE2_LOG_DISPLAY=$(display_of stage2_build_log)
BSTAGE3_STAGE2_TRANSCRIPT_DISPLAY=$(display_of stage2_transcript)
BSTAGE3_STAGE2_SANITY_DISPLAY=$(display_of stage2_sanity)
BSTAGE3_STAGE2_RECEIVER_DISPLAY=$(display_of stage2_receiver)
BSTAGE3_STAGE2_CACHE_DIR_DISPLAY=$(display_of stage2_cache_dir)
BSTAGE3_RUNTIME_PATH_DISPLAY=$(display_of runtime_dir)
BSTAGE3_RUNTIME_ORIGIN_AFTER_DISPLAY=$(display_of runtime_origin_after)
BSTAGE3_RUNTIME_ADMITTED_DISPLAY=$(display_of runtime_admitted)
BSTAGE3_JOBS_RECEIPT_DISPLAY=$stage3_display_root/effective-build-jobs.env
BSTAGE3_STAGE3_DISPLAY=$stage3_display_root/simple
BSTAGE3_STAGE3_TRANSCRIPT_DISPLAY=$stage3_display_root/stage3-command.transcript
BSTAGE3_STAGE3_LOG_DISPLAY=$stage3_display_root/stage3-build.log
BSTAGE3_STAGE3_SANITY_DISPLAY=$stage3_display_root/stage3-sanity.env
BSTAGE3_STAGE3_CACHE_DIR_DISPLAY=$(display_of stage3_cache_dir)
BSTAGE3_GIT_AFTER_DISPLAY=$stage3_display_root/git-state-after.env
BSTAGE3_TOOL_AUTHORITY_DISPLAY=$stage3_display_root/tool-authority-after.txt
BSTAGE3_SOURCE_AFTER_DISPLAY=$stage3_display_root/source-inputs-after.txt
BSTAGE3_BOOTSTRAP_SCRIPT_DISPLAY=$root/scripts/bootstrap/bootstrap-from-scratch.sh
BSTAGE3_HELPER_DISPLAY=$root/scripts/check/lib/bootstrap-stage3-provenance.shs
BSTAGE3_LOCK=$compatibility_marker
BOOTSTRAP_STAGE3_BOUND_ARTIFACTS_DESCRIPTOR=$result_descriptor_map
BOOTSTRAP_STAGE3_MANIFEST_ROOT_DISPLAY=$stage3_display_root
export BOOTSTRAP_STAGE3_BOUND_ARTIFACTS_DESCRIPTOR \
  BOOTSTRAP_STAGE3_MANIFEST_ROOT_DISPLAY

BSTAGE3_ROOT=$root BSTAGE3_ROOT_DESCRIPTOR=$root_dir \
BSTAGE3_MANIFEST=$manifest BSTAGE3_PLATFORM=$platform
BSTAGE3_BACKEND=$stage2_backend BSTAGE3_MODE=dynload BSTAGE3_SEED=$seed
BSTAGE3_SEED_STAMP=$stamp BSTAGE3_NATIVE_ALL=$native_all BSTAGE3_BACKFILL=$backfill
BSTAGE3_RUNTIME_ORIGIN_BEFORE=$runtime_origin_before BSTAGE3_RUNTIME_ORIGIN_AFTER=$runtime_origin_after
BSTAGE3_RUNTIME_ADMITTED_SNAPSHOT=$runtime_admitted BSTAGE3_TOOL_AUTHORITY=$tool_after
BSTAGE3_TOOL_AUTHORITY_BEFORE=$tool_before
BSTAGE3_STAGE2=$stage2 BSTAGE3_STAGE2_ADMITTED=$admitted
BSTAGE3_STAGE2_ADMISSION=$stage2_admission BSTAGE3_STAGE3=$candidate
BSTAGE3_SOURCE_BEFORE=$source_before BSTAGE3_SOURCE_AFTER=$source_after
BSTAGE3_STAGE2_LOG=$stage2_log BSTAGE3_STAGE3_LOG=$stage3_log
BSTAGE3_STAGE2_ARGS_SHA256=$stage2_args BSTAGE3_STAGE3_ARGS_SHA256=$stage3_args
BSTAGE3_STAGE2_THREADS=$stage2_threads BSTAGE3_STAGE3_THREADS=$jobs
BSTAGE3_JOBS_RECEIPT=$jobs_receipt
BSTAGE3_JOBS_RECEIPT_SHA256_BEFORE=$jobs_receipt_sha256_before
BSTAGE3_JOBS_EFFECTIVE=$jobs
BSTAGE3_STAGE2_CACHE_DIR=$stage2_cache BSTAGE3_STAGE3_CACHE_DIR=$stage3_cache
BSTAGE3_RUNTIME_PATH=$runtime BSTAGE3_STAGE2_COMMAND_OUTPUT=$stage2
BSTAGE3_STAGE3_COMMAND_OUTPUT=$candidate BSTAGE3_BOOTSTRAP_SCRIPT=$script
BSTAGE3_HELPER=$helper BSTAGE3_HELPER_SHA256_BEFORE=$helper_sha_before
BSTAGE3_HELPER_BUNDLE_FINGERPRINT_BEFORE=$helper_bundle_before
BSTAGE3_BOOTSTRAP_SCRIPT_SHA256_BEFORE=$script_sha_before
BSTAGE3_SEED_INPUTS_FINGERPRINT=$seed_fingerprint BSTAGE3_SEED_FEATURES=
BSTAGE3_GIT_BEFORE=$git_before BSTAGE3_GIT_AFTER=$git_after
BSTAGE3_STAGE2_TRANSCRIPT=$stage2_transcript BSTAGE3_STAGE3_TRANSCRIPT=$stage3_transcript
BSTAGE3_STAGE2_SANITY=$stage2_sanity BSTAGE3_STAGE2_RECEIVER=$stage2_receiver
BSTAGE3_STAGE3_SANITY=$stage3_sanity
BSTAGE3_COMPATIBILITY_MARKER=$compatibility_marker
BSTAGE3_COMPATIBILITY_RECEIPT="$compatibility_marker/compatibility.env"
BSTAGE3_BOUND_ARTIFACTS_DESCRIPTOR=$descriptor_map
BSTAGE3_RESULT_DESCRIPTOR_MAP=$result_descriptor_map
BSTAGE3_RUST_LOG=error
export BSTAGE3_ROOT BSTAGE3_ROOT_DESCRIPTOR BSTAGE3_MANIFEST BSTAGE3_PLATFORM BSTAGE3_BACKEND BSTAGE3_MODE \
  BSTAGE3_SEED BSTAGE3_SEED_STAMP BSTAGE3_NATIVE_ALL BSTAGE3_BACKFILL \
  BSTAGE3_RUNTIME_ORIGIN_BEFORE BSTAGE3_RUNTIME_ORIGIN_AFTER \
  BSTAGE3_RUNTIME_ADMITTED_SNAPSHOT BSTAGE3_TOOL_AUTHORITY \
  BSTAGE3_TOOL_AUTHORITY_BEFORE BSTAGE3_STAGE2 BSTAGE3_STAGE2_ADMITTED \
  BSTAGE3_STAGE2_ADMISSION BSTAGE3_STAGE3 BSTAGE3_SOURCE_BEFORE BSTAGE3_SOURCE_AFTER \
  BSTAGE3_STAGE2_LOG BSTAGE3_STAGE3_LOG BSTAGE3_STAGE2_ARGS_SHA256 \
  BSTAGE3_STAGE3_ARGS_SHA256 BSTAGE3_STAGE2_THREADS BSTAGE3_STAGE3_THREADS \
  BSTAGE3_JOBS_RECEIPT BSTAGE3_JOBS_RECEIPT_SHA256_BEFORE BSTAGE3_JOBS_EFFECTIVE \
  BSTAGE3_STAGE2_CACHE_DIR BSTAGE3_STAGE3_CACHE_DIR BSTAGE3_RUNTIME_PATH \
  BSTAGE3_STAGE2_COMMAND_OUTPUT BSTAGE3_STAGE3_COMMAND_OUTPUT BSTAGE3_BOOTSTRAP_SCRIPT \
  BSTAGE3_HELPER BSTAGE3_HELPER_SHA256_BEFORE BSTAGE3_HELPER_BUNDLE_FINGERPRINT_BEFORE \
  BSTAGE3_BOOTSTRAP_SCRIPT_SHA256_BEFORE BSTAGE3_SEED_INPUTS_FINGERPRINT \
  BSTAGE3_SEED_FEATURES BSTAGE3_GIT_BEFORE BSTAGE3_GIT_AFTER \
  BSTAGE3_STAGE2_TRANSCRIPT BSTAGE3_STAGE3_TRANSCRIPT BSTAGE3_STAGE2_SANITY \
  BSTAGE3_STAGE2_RECEIVER BSTAGE3_STAGE3_SANITY BSTAGE3_COMPATIBILITY_MARKER \
  BSTAGE3_COMPATIBILITY_RECEIPT BSTAGE3_BOUND_ARTIFACTS_DESCRIPTOR \
  BSTAGE3_RESULT_DESCRIPTOR_MAP BSTAGE3_RUST_LOG
bootstrap_stage3_write_manifest
bootstrap_stage3_verify_manifest "$manifest" "$root" "$candidate" \
  "$stage3_display_root/provenance.env"
