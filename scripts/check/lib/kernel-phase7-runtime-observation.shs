#!/bin/sh

observe_admitted_runtime() {
  . "$root/scripts/lib/simple-runtime-provenance.shs"
  simple_runtime_provenance_admits "$runtime" "$root" || {
    status=BLOCKED
    reason=admitted-runtime-unavailable
    return
  }
  require_native_host
  require_candidate_architecture "$runtime"
  candidate_path=$(canonical_file "$runtime") || exit 1
  candidate_sha256=$(hash_file "$candidate_path")
  candidate_architecture=$architecture
  runtime_provenance_path=$(canonical_file "$SIMPLE_RUNTIME_PROVENANCE") || exit 1
  runtime_provenance_sha256=$(hash_file "$runtime_provenance_path")

  observation=$receipt_dir/$row-admitted-runtime-observation.env
  evidence_dir=$receipt_dir/$row-admitted-runtime-evidence
  rm -rf "$evidence_dir"
  mkdir -p "$evidence_dir"
  deps=$evidence_dir/native-dependencies.txt
  if command -v otool >/dev/null 2>&1; then otool -L "$candidate_path" >"$deps"
  elif command -v ldd >/dev/null 2>&1; then ldd "$candidate_path" >"$deps"
  else echo "FAIL: no native dependency inspector for admitted runtime" >&2; exit 1
  fi
  one_binary_observation=pass
  if grep -Ei 'backend_(llvm|cranelift|vhdl|vulkan|cuda)|simple_stage4_dynload' "$deps" >/dev/null; then
    one_binary_observation=fail
  fi

  parity=$evidence_dir/backend-parity.tsv
  parity_source=$evidence_dir/backend-parity-main.spl
  cat >"$parity_source" <<'EOF'
fn main():
    print 42
EOF
  printf 'backend\texit_status\tstdout_sha256\tstderr_sha256\n' >"$parity"
  for backend in llvm cranelift; do
    binary=$evidence_dir/parity-$backend
    build_log=$evidence_dir/parity-$backend.build.log
    out=$evidence_dir/parity-$backend.stdout err=$evidence_dir/parity-$backend.stderr
    set +e
    SIMPLE_NO_STUB_FALLBACK=1 "$candidate_path" native-build "$parity_source" --backend="$backend" \
      --output="$binary" --cache-dir="$evidence_dir/cache-$backend" >"$build_log" 2>&1
    build_status=$?
    if [ "$build_status" -eq 0 ] && [ -x "$binary" ]; then
      "$binary" >"$out" 2>"$err"
      parity_status=$?
    else
      : >"$out"
      : >"$err"
      parity_status=$build_status
    fi
    set -e
    output_sha=$(hash_file "$out")
    printf '%s\t%s\t%s\t%s\n' "$backend" "$parity_status" "$output_sha" "$(hash_file "$err")" >>"$parity"
    if [ "$backend" = llvm ]; then llvm_status=$parity_status llvm_output_sha=$output_sha
    else cranelift_status=$parity_status cranelift_output_sha=$output_sha
    fi
  done
  backend_parity_observation=blocked
  if [ "$llvm_status" -eq 0 ] && [ "$cranelift_status" -eq 0 ] &&
      [ "$llvm_output_sha" = "$cranelift_output_sha" ] && grep -Fxq 42 "$evidence_dir/parity-llvm.stdout"; then
    backend_parity_observation=pass
  fi

  dynload_log=$evidence_dir/dynload-status.log
  set +e
  /bin/sh -c 'SIMPLE_DYNLOAD_CONFIG=$1 exec "$2" --dynsmf-status' sh \
    "$evidence_dir/missing-dynload.sdn" "$candidate_path" >"$dynload_log" 2>&1
  dynload_status=$?
  set -e
  dynload_observation=blocked
  if [ "$dynload_status" -ne 0 ] && grep -Fq missing_explicit_dynload_config "$dynload_log"; then
    dynload_observation=pass
  fi

  samples=$evidence_dir/startup-rss.tsv
  printf 'sequence\telapsed_ms\tmaximum_rss_bytes\n' >"$samples"
  sample=1
  while [ "$sample" -le 20 ]; do
    timed=$evidence_dir/time-$sample.txt
    started=$(perl -MTime::HiRes=time -e 'printf "%.0f\n", time()*1000')
    /usr/bin/time -l "$candidate_path" --version >/dev/null 2>"$timed"
    ended=$(perl -MTime::HiRes=time -e 'printf "%.0f\n", time()*1000')
    max_rss=$(awk '/maximum resident set size/ { value=$1 } END { print value }' "$timed")
    require_positive_integer "$max_rss" || { echo "FAIL: macOS startup sample lacks maximum RSS" >&2; exit 1; }
    printf '%s\t%s\t%s\n' "$sample" "$((ended - started))" "$max_rss" >>"$samples"
    sample=$((sample + 1))
  done
  startup_observation=pass
  rss_observation=pass-process-per-invocation-only

  observation_tmp=$observation.tmp.$$
  {
    echo schema=simple-kernel-phase7-admitted-runtime-observation-v1
    echo status=BLOCKED
    echo deployment_authorization=DENY
    echo reason=phase7-produced-candidate-and-resident-baseline-unavailable
    echo host_system=$host_system
    echo architecture=$architecture
    echo translated_execution=$translated_execution
    echo candidate_path=$candidate_path
    echo candidate_sha256=$candidate_sha256
    echo runtime_provenance_path=$runtime_provenance_path
    echo runtime_provenance_sha256=$runtime_provenance_sha256
    echo one_binary_observation=$one_binary_observation
    echo backend_parity_observation=$backend_parity_observation
    echo dynload_observation=$dynload_observation
    echo dynload_exit_status=$dynload_status
    echo startup_observation=$startup_observation
    echo startup_sample_count=20
    echo rss_observation=$rss_observation
    echo rss_scope=twenty-independent-native-processes-not-resident-server
    echo dependencies_sha256=$(hash_file "$deps")
    echo parity_sha256=$(hash_file "$parity")
    echo dynload_log_sha256=$(hash_file "$dynload_log")
    echo startup_rss_samples_sha256=$(hash_file "$samples")
  } >"$observation_tmp"
  mv "$observation_tmp" "$observation"
  observation_evidence_path=$(canonical_file "$observation") || exit 1
  observation_evidence_sha256=$(hash_file "$observation_evidence_path")
  status=BLOCKED
  if [ "$mode" = one-binary ]; then
    mode_gate=$one_binary_observation
    reason=phase7-produced-candidate-and-resident-baseline-unavailable
  else
    mode_gate=$dynload_observation
    reason=admitted-runtime-dynload-unavailable
  fi
}
