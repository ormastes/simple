#!/bin/sh
# Sourced CI caller library. Defines one isolated function; sourcing does not
# run a gate, install traps, mutate options, or exit the parent shell.
# The actual run-gate-tier row calls it with the complete pinned range.
conflict_tree_check_complete_range() (
# Inspect the guard exit explicitly even when the sourcing caller uses -e.
set +e
set -u
SELF=check-no-conflict-tree-range-batches
work=""
verdict=0
finish() {
    status=$?
    trap - EXIT HUP INT TERM QUIT PIPE
    if [ -n "$work" ]; then
        rm -f -- "$work/full" "$work/planned" "$work/checked" "$work"/batch-*
        rmdir -- "$work"
    fi
    if [ "$verdict" -eq 0 ]; then
        echo "$SELF: ERROR — stopped before complete coverage (exit 2)" >&2
        status=2
    fi
    exit "$status"
}
trap finish EXIT
trap 'exit 2' HUP INT TERM QUIT PIPE
die() { verdict=1; echo "$SELF: ERROR — $*" >&2; exit 2; }
[ "$#" -eq 1 ] && [ -n "$1" ] || die "one nonempty explicit range is required"
range=$1
case "$range" in --*) die "options are not ranges" ;; esac
case "$range" in *..*) ;; *) die "explicit range must contain '..'" ;; esac
left=${range%%..*}
right=${range#*..}
separator=..
case "$right" in .*) separator=...; right=${right#.} ;; esac
[ -n "$left" ] && [ -n "$right" ] || die "range endpoints must be nonempty"
root=$(git rev-parse --show-toplevel 2>/dev/null) || die "cwd is not a git repository"
base=$(git rev-parse --verify --quiet "$left^{commit}" 2>/dev/null) || die "missing base commit: $left"
tip=$(git rev-parse --verify --quiet "$right^{commit}" 2>/dev/null) || die "missing tip commit: $right"
guard="$root/scripts/check/check-no-conflict-tree-push.shs"
[ -f "$guard" ] || die "bounded guard is absent"
work=$(mktemp -d) || die "cannot create coverage workspace"
git rev-list "$base$separator$tip" > "$work/full" || die "full range enumeration failed"
[ -s "$work/full" ] || die "explicit range resolved to zero commits"
# Full object IDs only. Verify uniqueness before partitioning, without dropping
# a duplicate and then claiming the deduplicated list was the original range.
awk 'length($0) != 40 && length($0) != 64 {exit 1}
     /[^0-9a-f]/ || seen[$0]++ {exit 1}' "$work/full" || die "invalid or duplicate enumerated commit"
awk -v dir="$work" '{file=dir "/batch-" int((NR-1)/64);
    if (previous != "" && previous != file) close(previous);
    print > file; previous=file}' "$work/full" || die "partition failed"
count=$(wc -l < "$work/full" | tr -d ' ') || die "cannot count commits"
batches=$(( (count + 63) / 64 ))
: > "$work/planned"
index=0
while [ "$index" -lt "$batches" ]; do
    file="$work/batch-$index"
    size=$(wc -l < "$file" | tr -d ' ') || die "cannot count batch"
    [ "$size" -ge 1 ] && [ "$size" -le 64 ] || die "invalid batch size"
    cat "$file" >> "$work/planned" || die "cannot retain planned coverage"
    index=$((index + 1))
done
cmp -s "$work/full" "$work/planned" || die "batch union differs from complete range"
: > "$work/checked"
index=0
while [ "$index" -lt "$batches" ]; do
    set -- --rev-list-args --no-walk=unsorted
    while IFS= read -r commit; do set -- "$@" "$commit"; done < "$work/batch-$index"
    sh "$guard" "$@"
    status=$?
    if [ "$status" -ne 0 ]; then
        verdict=1
        if [ "$status" -eq 1 ]; then
            echo "$SELF: FAIL — conflict in batch $((index + 1))/$batches" >&2
            exit 1
        fi
        echo "$SELF: ERROR — bounded guard failed in batch $((index + 1))/$batches (exit $status)" >&2
        exit 2
    fi
    cat "$work/batch-$index" >> "$work/checked" || die "cannot retain checked coverage"
    index=$((index + 1))
done
cmp -s "$work/full" "$work/checked" || die "successful batch union differs from complete range"
verdict=1
echo "$SELF: PASS — $count commits in $batches disjoint batches, complete coverage ($base$separator$tip; repo $root)"
)
