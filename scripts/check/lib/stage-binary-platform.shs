#!/bin/sh
# File/host identity for the stage runnability guard. A DOS MZ prefix alone
# does not establish a PE executable or the architecture Windows can load.
artifact_format() {
    _magic=$(od -An -tx1 -N4 "$1" 2>/dev/null | tr -d ' \n')
    case "$_magic" in
        7f454c46)
            _mach=$(od -An -tx1 -j18 -N2 "$1" 2>/dev/null | tr -d ' \n')
            case "$_mach" in
                3e00|003e) printf 'elf-x86_64' ;;
                b700|00b7) printf 'elf-aarch64' ;;
                *)         printf 'elf-other' ;;
            esac ;;
        cffaedfe|cefaedfe|feedface|feedfacf|cafebabe|bebafeca) printf 'macho' ;;
        4d5a*)
            _pe_path=$1
            # Decode the little-endian DOS e_lfanew without depending on the
            # observer's endianness or treating COFF bytes as a symbol table.
            set -- $(od -An -tu1 -j60 -N4 "$_pe_path" 2>/dev/null)
            if [ "$#" -ne 4 ]; then printf 'pe-invalid'; return; fi
            _pe_offset=$(($1 + $2 * 256 + $3 * 65536 + $4 * 16777216))
            if [ "$_pe_offset" -lt 64 ]; then printf 'pe-invalid'; return; fi
            _pe_header=$(od -An -v -tx1 -j"$_pe_offset" -N24 "$_pe_path" 2>/dev/null | tr -d ' \n')
            if [ "${#_pe_header}" -ne 48 ]; then printf 'pe-invalid'; return; fi
            case "$_pe_header" in
                504500006486*) printf 'pe-x86_64' ;;
                5045000064aa*) printf 'pe-aarch64' ;;
                504500004c01*) printf 'pe-i386' ;;
                50450000*)     printf 'pe-other' ;;
                *)             printf 'pe-invalid' ;;
            esac ;;
        2321*) printf 'script' ;;
        *)     printf 'unknown' ;;
    esac
}

host_native_format() {
    case "$(uname -s)-$(uname -m)" in
        Linux-x86_64)  printf 'elf-x86_64' ;;
        Linux-aarch64) printf 'elf-aarch64' ;;
        Darwin-*)      printf 'macho' ;;
        FreeBSD-amd64|FreeBSD-x86_64) printf 'elf-x86_64' ;;
        MINGW*-x86_64|MSYS*-x86_64|CYGWIN*-x86_64) printf 'pe-x86_64' ;;
        MINGW*-aarch64|MSYS*-aarch64|CYGWIN*-aarch64|MINGW*-arm64|MSYS*-arm64|CYGWIN*-arm64) printf 'pe-aarch64' ;;
        MINGW*-i686|MSYS*-i686|CYGWIN*-i686) printf 'pe-i386' ;;
        *) printf 'unknown' ;;
    esac
}

host_triple() {
    case "$(uname -s)-$(uname -m)" in
        Linux-x86_64)  printf 'x86_64-unknown-linux-gnu' ;;
        Linux-aarch64) printf 'aarch64-unknown-linux-gnu' ;;
        Darwin-arm64|Darwin-aarch64) printf 'aarch64-apple-darwin-macho' ;;
        Darwin-x86_64) printf 'x86_64-apple-darwin-macho' ;;
        FreeBSD-amd64|FreeBSD-x86_64) printf 'x86_64-unknown-freebsd' ;;
        MINGW*-x86_64|MSYS*-x86_64|CYGWIN*-x86_64) printf 'x86_64-pc-windows-msvc' ;;
        MINGW*-aarch64|MSYS*-aarch64|CYGWIN*-aarch64|MINGW*-arm64|MSYS*-arm64|CYGWIN*-arm64) printf 'aarch64-pc-windows-msvc' ;;
        MINGW*-i686|MSYS*-i686|CYGWIN*-i686) printf 'i686-pc-windows-msvc' ;;
        *) printf '' ;;
    esac
}
