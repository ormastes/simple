#!/bin/sh

# Portable parent-owned hard-link locks. Recovery is deliberately fail-closed:
# a claim is stale only when its owner PID/start no longer match and the kernel
# positively reports that the complete recorded process group is absent.
# Callers that share a process group intentionally share its recovery lifetime;
# use portable-session-exec.pl when an independently recoverable lane is needed.

portable_lock_manifest_value() {
  portable_lock_manifest_key=$1
  portable_lock_manifest_path=$2
  sed -n "s/^${portable_lock_manifest_key}=//p" \
    "${portable_lock_manifest_path}" 2>/dev/null | sed -n '1p'
}

portable_lock_identity() {
  perl "${PORTABLE_LOCK_ATOMIC_HELPER_PATH}" identity "$1"
}

portable_lock_actual_process_identity() {
  portable_lock_owner_snapshot_path=$(mktemp)
  (perl "${PORTABLE_LOCK_ATOMIC_HELPER_PATH}" owner-snapshot > \
    "${portable_lock_owner_snapshot_path}") || {
    /bin/rm -f -- "${portable_lock_owner_snapshot_path}"
    return 1
  }
  portable_lock_owner_snapshot=$(cat "${portable_lock_owner_snapshot_path}") ||
    {
      /bin/rm -f -- "${portable_lock_owner_snapshot_path}"
      return 1
    }
  /bin/rm -f -- "${portable_lock_owner_snapshot_path}"
  PORTABLE_LOCK_OWNER_PID=$(printf '%s\n' "${portable_lock_owner_snapshot}" |
    sed -n 's/^pid=//p')
  PORTABLE_LOCK_OWNER_START_HEX=$(printf '%s\n' \
    "${portable_lock_owner_snapshot}" | sed -n 's/^start_hex=//p')
  PORTABLE_LOCK_OWNER_PGID=$(printf '%s\n' "${portable_lock_owner_snapshot}" |
    sed -n 's/^pgid=//p')
  case "${PORTABLE_LOCK_OWNER_PID}" in ''|*[!0-9]*) return 1 ;; esac
  case "${PORTABLE_LOCK_OWNER_START_HEX}" in
    ''|*[!0-9a-f]*) return 1 ;;
  esac
  case "${PORTABLE_LOCK_OWNER_PGID}" in ''|*[!0-9]*) return 1 ;; esac
  export PORTABLE_LOCK_OWNER_PID PORTABLE_LOCK_OWNER_START_HEX
  export PORTABLE_LOCK_OWNER_PGID
}

portable_lock_nonce() {
  portable_lock_nonce_value=$(perl -e '
    use strict; use warnings;
    open(my $fh, "<", "/dev/urandom") or exit 1;
    read($fh, my $bytes, 16) == 16 or exit 1;
    print unpack("H*", $bytes);
  ') || return 1
  case "${portable_lock_nonce_value}" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]* ) ;;
    *) return 1 ;;
  esac
  PORTABLE_LOCK_NONCE=${portable_lock_nonce_value}
  export PORTABLE_LOCK_NONCE
}

portable_lock_canonical_output() {
  portable_lock_canonical_input=$1
  [ -n "${portable_lock_canonical_input}" ] || return 64
  case "${portable_lock_canonical_input}" in *"
"*) return 64 ;; esac
  case "/${portable_lock_canonical_input}/" in
    */./*|*/../*) return 64 ;;
  esac
  mkdir -p -- "${portable_lock_canonical_input}" || return 73
  portable_lock_canonical_value=$(CDPATH= cd -- \
    "${portable_lock_canonical_input}" && pwd -P) || return 73
  PORTABLE_LOCK_CANONICAL_OUTPUT=${portable_lock_canonical_value}
  export PORTABLE_LOCK_CANONICAL_OUTPUT
}

portable_lock_valid_name() {
  case "$1" in ''|.|..|*[!A-Za-z0-9._-]*) return 1 ;; esac
}

# PORTABLE_LOCK_HANDLES is shell-private state. Exporting its newline-delimited
# absolute paths corrupts line-oriented environment scrubbers. A child cannot
# own or release the parent's claims, so only the current handle is exported.
portable_lock_record_handle() {
  portable_lock_record_value=$1
  portable_lock_record_existing=${PORTABLE_LOCK_HANDLES:-}
  unset PORTABLE_LOCK_HANDLES
  if [ -n "${portable_lock_record_existing}" ]; then
    PORTABLE_LOCK_HANDLES="${portable_lock_record_existing}
${portable_lock_record_value}"
  else
    PORTABLE_LOCK_HANDLES=${portable_lock_record_value}
  fi
  PORTABLE_LOCK_HANDLE=${portable_lock_record_value}
  export PORTABLE_LOCK_HANDLE
}

portable_lock_create_claim() {
  portable_lock_create_path=$1
  portable_lock_create_name=$2
  portable_lock_create_nonce=$3
  portable_lock_create_tmp="${portable_lock_create_path}.tmp.${PORTABLE_LOCK_OWNER_PID}"
  umask 077
  {
    printf '%s\n' 'format=portable-hardlink-lock-v2'
    printf 'nonce=%s\n' "${portable_lock_create_nonce}"
    printf 'owner_pid=%s\n' "${PORTABLE_LOCK_OWNER_PID}"
    printf 'owner_start_hex=%s\n' "${PORTABLE_LOCK_OWNER_START_HEX}"
    printf 'owner_pgid=%s\n' "${PORTABLE_LOCK_OWNER_PGID}"
    printf 'lock_name=%s\n' "${portable_lock_create_name}"
  } >"${portable_lock_create_tmp}" || return 1
  chmod 600 "${portable_lock_create_tmp}" || return 1
  perl "${PORTABLE_LOCK_ATOMIC_HELPER_PATH}" link \
    "${portable_lock_create_tmp}" "${portable_lock_create_path}" || return 1
  rm -f "${portable_lock_create_tmp}"
}

portable_lock_load_claim() {
  portable_lock_load_path=$1
  PORTABLE_LOCK_LOADED_FORMAT=$(portable_lock_manifest_value format \
    "${portable_lock_load_path}")
  PORTABLE_LOCK_LOADED_NONCE=$(portable_lock_manifest_value nonce \
    "${portable_lock_load_path}")
  PORTABLE_LOCK_LOADED_PID=$(portable_lock_manifest_value owner_pid \
    "${portable_lock_load_path}")
  PORTABLE_LOCK_LOADED_START=$(portable_lock_manifest_value owner_start_hex \
    "${portable_lock_load_path}")
  PORTABLE_LOCK_LOADED_PGID=$(portable_lock_manifest_value owner_pgid \
    "${portable_lock_load_path}")
  PORTABLE_LOCK_LOADED_NAME=$(portable_lock_manifest_value lock_name \
    "${portable_lock_load_path}")
  [ "${PORTABLE_LOCK_LOADED_FORMAT}" = portable-hardlink-lock-v2 ] || return 1
  case "${PORTABLE_LOCK_LOADED_NONCE}" in
    ''|*[!0-9a-f]*) return 1 ;;
  esac
  [ "${#PORTABLE_LOCK_LOADED_NONCE}" -eq 32 ] || return 1
  case "${PORTABLE_LOCK_LOADED_PID}" in ''|*[!0-9]*) return 1 ;; esac
  case "${PORTABLE_LOCK_LOADED_START}" in ''|*[!0-9a-f]*) return 1 ;; esac
  case "${PORTABLE_LOCK_LOADED_PGID}" in ''|*[!0-9]*) return 1 ;; esac
  portable_lock_valid_name "${PORTABLE_LOCK_LOADED_NAME}" || return 1
}

portable_lock_claim_state() {
  perl "${PORTABLE_LOCK_ATOMIC_HELPER_PATH}" claim-state "$1" "$2" "$3" \
    2>/dev/null || printf '%s\n' unknown
}

portable_lock_remove_exact() {
  portable_lock_remove_path=$1
  portable_lock_remove_identity=$2
  portable_lock_remove_nonce=$3
  portable_lock_remove_pid=$4
  portable_lock_remove_start=$5
  portable_lock_remove_pgid=$6
  portable_lock_remove_dev=${portable_lock_remove_identity%%:*}
  portable_lock_remove_ino=${portable_lock_remove_identity#*:}
  perl "${PORTABLE_LOCK_ATOMIC_HELPER_PATH}" unlink-if-match \
    "${portable_lock_remove_path}" "${portable_lock_remove_dev}" \
    "${portable_lock_remove_ino}" "${portable_lock_remove_nonce}" \
    "${portable_lock_remove_pid}" "${portable_lock_remove_start}" \
    "${portable_lock_remove_pgid}"
}

portable_lock_cleanup_linked_claim() {
  portable_lock_cleanup_root=$1
  portable_lock_cleanup_name=$2
  portable_lock_cleanup_nonce=$3
  portable_lock_cleanup_identity=$4
  portable_lock_cleanup_pid=$5
  portable_lock_cleanup_start=$6
  portable_lock_cleanup_pgid=$7
  portable_lock_cleanup_path=\
"${portable_lock_cleanup_root}/.${portable_lock_cleanup_name}.claim.${portable_lock_cleanup_nonce}"
  portable_lock_cleanup_current=$(portable_lock_identity \
    "${portable_lock_cleanup_path}" 2>/dev/null || :)
  [ "${portable_lock_cleanup_current}" = "${portable_lock_cleanup_identity}" ] ||
    return 0
  portable_lock_remove_exact "${portable_lock_cleanup_path}" \
    "${portable_lock_cleanup_identity}" "${portable_lock_cleanup_nonce}" \
    "${portable_lock_cleanup_pid}" "${portable_lock_cleanup_start}" \
    "${portable_lock_cleanup_pgid}" || :
}

portable_lock_release_recovery() {
  portable_lock_recovery_stable=$1
  portable_lock_recovery_claim=$2
  portable_lock_recovery_nonce=$3
  portable_lock_recovery_identity=$(portable_lock_identity \
    "${portable_lock_recovery_stable}" 2>/dev/null || :)
  if [ -n "${portable_lock_recovery_identity}" ]; then
    portable_lock_remove_exact "${portable_lock_recovery_stable}" \
      "${portable_lock_recovery_identity}" "${portable_lock_recovery_nonce}" \
      "${PORTABLE_LOCK_OWNER_PID}" "${PORTABLE_LOCK_OWNER_START_HEX}" \
      "${PORTABLE_LOCK_OWNER_PGID}" || :
  fi
  portable_lock_claim_identity=$(portable_lock_identity \
    "${portable_lock_recovery_claim}" 2>/dev/null || :)
  if [ -n "${portable_lock_claim_identity}" ]; then
    portable_lock_remove_exact "${portable_lock_recovery_claim}" \
      "${portable_lock_claim_identity}" "${portable_lock_recovery_nonce}" \
      "${PORTABLE_LOCK_OWNER_PID}" "${PORTABLE_LOCK_OWNER_START_HEX}" \
      "${PORTABLE_LOCK_OWNER_PGID}" || :
  fi
}

portable_lock_recover_stale() {
  portable_lock_recover_root=$1
  portable_lock_recover_name=$2
  portable_lock_recover_stable=$3
  portable_lock_recover_owner_claim=$4
  portable_lock_recover_stale_identity=$5
  portable_lock_recover_stale_nonce=$6
  portable_lock_recover_stale_pid=$7
  portable_lock_recover_stale_start=$8
  portable_lock_recover_stale_pgid=$9
  portable_lock_recovery_name="${portable_lock_recover_name}_recovery"
  portable_lock_recovery_claim=\
"${portable_lock_recover_root}/.${portable_lock_recovery_name}.claim.${PORTABLE_LOCK_NONCE}"
  portable_lock_recovery_stable=\
"${portable_lock_recover_root}/.${portable_lock_recovery_name}.lock"
  if [ ! -f "${portable_lock_recovery_claim}" ]; then
    portable_lock_create_claim "${portable_lock_recovery_claim}" \
      "${portable_lock_recovery_name}" "${PORTABLE_LOCK_NONCE}" || return 1
  fi
  while :; do
    if perl "${PORTABLE_LOCK_ATOMIC_HELPER_PATH}" link \
      "${portable_lock_recovery_claim}" "${portable_lock_recovery_stable}"; then
      break
    fi
    portable_lock_recovery_identity=$(portable_lock_identity \
      "${portable_lock_recovery_stable}" 2>/dev/null || :) 
    portable_lock_load_claim "${portable_lock_recovery_stable}" || return 1
    portable_lock_recovery_nonce=${PORTABLE_LOCK_LOADED_NONCE}
    portable_lock_recovery_pid=${PORTABLE_LOCK_LOADED_PID}
    portable_lock_recovery_start=${PORTABLE_LOCK_LOADED_START}
    portable_lock_recovery_pgid=${PORTABLE_LOCK_LOADED_PGID}
    [ "$(portable_lock_claim_state "${portable_lock_recovery_pid}" \
      "${portable_lock_recovery_start}" "${portable_lock_recovery_pgid}")" = dead ] ||
      return 1
    if portable_lock_remove_exact "${portable_lock_recovery_stable}" \
      "${portable_lock_recovery_identity}" "${portable_lock_recovery_nonce}" \
      "${portable_lock_recovery_pid}" "${portable_lock_recovery_start}" \
      "${portable_lock_recovery_pgid}"; then
      portable_lock_cleanup_linked_claim "${portable_lock_recover_root}" \
        "${portable_lock_recovery_name}" "${portable_lock_recovery_nonce}" \
        "${portable_lock_recovery_identity}" "${portable_lock_recovery_pid}" \
        "${portable_lock_recovery_start}" "${portable_lock_recovery_pgid}"
    fi
  done
  portable_lock_current_identity=$(portable_lock_identity \
    "${portable_lock_recover_stable}" 2>/dev/null || :)
  if [ "${portable_lock_current_identity}" != \
    "${portable_lock_recover_stale_identity}" ]; then
    portable_lock_release_recovery "${portable_lock_recovery_stable}" \
      "${portable_lock_recovery_claim}" "${PORTABLE_LOCK_NONCE}"
    return 1
  fi
  portable_lock_load_claim "${portable_lock_recover_stable}" || {
    portable_lock_release_recovery "${portable_lock_recovery_stable}" \
      "${portable_lock_recovery_claim}" "${PORTABLE_LOCK_NONCE}"
    return 1
  }
  [ "${PORTABLE_LOCK_LOADED_NONCE}" = "${portable_lock_recover_stale_nonce}" ] &&
    [ "${PORTABLE_LOCK_LOADED_PID}" = "${portable_lock_recover_stale_pid}" ] &&
    [ "${PORTABLE_LOCK_LOADED_START}" = "${portable_lock_recover_stale_start}" ] &&
    [ "${PORTABLE_LOCK_LOADED_PGID}" = "${portable_lock_recover_stale_pgid}" ] &&
    [ "$(portable_lock_claim_state "${portable_lock_recover_stale_pid}" \
      "${portable_lock_recover_stale_start}" \
      "${portable_lock_recover_stale_pgid}")" = dead ] || {
      portable_lock_release_recovery "${portable_lock_recovery_stable}" \
        "${portable_lock_recovery_claim}" "${PORTABLE_LOCK_NONCE}"
      return 1
    }
  portable_lock_remove_exact "${portable_lock_recover_stable}" \
    "${portable_lock_recover_stale_identity}" \
    "${portable_lock_recover_stale_nonce}" "${portable_lock_recover_stale_pid}" \
    "${portable_lock_recover_stale_start}" \
    "${portable_lock_recover_stale_pgid}" || {
      portable_lock_release_recovery "${portable_lock_recovery_stable}" \
        "${portable_lock_recovery_claim}" "${PORTABLE_LOCK_NONCE}"
      return 1
    }
  portable_lock_cleanup_linked_claim "${portable_lock_recover_root}" \
    "${portable_lock_recover_name}" "${portable_lock_recover_stale_nonce}" \
    "${portable_lock_recover_stale_identity}" \
    "${portable_lock_recover_stale_pid}" "${portable_lock_recover_stale_start}" \
    "${portable_lock_recover_stale_pgid}"
  portable_lock_recover_admitted=1
  perl "${PORTABLE_LOCK_ATOMIC_HELPER_PATH}" link \
    "${portable_lock_recover_owner_claim}" \
    "${portable_lock_recover_stable}" || portable_lock_recover_admitted=0
  portable_lock_release_recovery "${portable_lock_recovery_stable}" \
    "${portable_lock_recovery_claim}" "${PORTABLE_LOCK_NONCE}"
  [ "${portable_lock_recover_admitted}" -eq 1 ]
}

portable_lock_acquire() {
  portable_lock_canonical_output "$1" || return $?
  portable_lock_root=${PORTABLE_LOCK_CANONICAL_OUTPUT}
  portable_lock_name=$2
  portable_lock_wait=${3:-30}
  portable_lock_valid_name "${portable_lock_name}" || return 64
  case "${portable_lock_wait}" in ''|*[!0-9]*) return 64 ;; esac
  [ -f "${PORTABLE_LOCK_ATOMIC_HELPER_PATH:-}" ] || return 69
  portable_lock_actual_process_identity || return 70
  portable_lock_nonce || return 70
  portable_lock_owner_nonce=${PORTABLE_LOCK_NONCE}
  portable_lock_owner_claim=\
"${portable_lock_root}/.${portable_lock_name}.claim.${portable_lock_owner_nonce}"
  portable_lock_stable="${portable_lock_root}/.${portable_lock_name}.lock"
  portable_lock_create_claim "${portable_lock_owner_claim}" \
    "${portable_lock_name}" "${portable_lock_owner_nonce}" || return 73
  portable_lock_deadline=$(($(date +%s) + portable_lock_wait))
  while :; do
    if perl "${PORTABLE_LOCK_ATOMIC_HELPER_PATH}" link \
      "${portable_lock_owner_claim}" "${portable_lock_stable}"; then
      portable_lock_record_handle "${portable_lock_owner_claim}"
      return 0
    fi
    portable_lock_stale_identity=$(portable_lock_identity \
      "${portable_lock_stable}" 2>/dev/null || :)
    if [ -n "${portable_lock_stale_identity}" ] &&
      portable_lock_load_claim "${portable_lock_stable}"; then
      portable_lock_stale_nonce=${PORTABLE_LOCK_LOADED_NONCE}
      portable_lock_stale_pid=${PORTABLE_LOCK_LOADED_PID}
      portable_lock_stale_start=${PORTABLE_LOCK_LOADED_START}
      portable_lock_stale_pgid=${PORTABLE_LOCK_LOADED_PGID}
      if [ "$(portable_lock_claim_state "${portable_lock_stale_pid}" \
        "${portable_lock_stale_start}" "${portable_lock_stale_pgid}")" = dead ] &&
        portable_lock_recover_stale "${portable_lock_root}" \
          "${portable_lock_name}" "${portable_lock_stable}" \
          "${portable_lock_owner_claim}" "${portable_lock_stale_identity}" \
          "${portable_lock_stale_nonce}" "${portable_lock_stale_pid}" \
          "${portable_lock_stale_start}" "${portable_lock_stale_pgid}"; then
        portable_lock_record_handle "${portable_lock_owner_claim}"
        return 0
      fi
    fi
    if [ "$(date +%s)" -ge "${portable_lock_deadline}" ]; then
      portable_lock_owner_identity=$(portable_lock_identity \
        "${portable_lock_owner_claim}" 2>/dev/null || :)
      [ -z "${portable_lock_owner_identity}" ] ||
        portable_lock_remove_exact "${portable_lock_owner_claim}" \
          "${portable_lock_owner_identity}" "${portable_lock_owner_nonce}" \
          "${PORTABLE_LOCK_OWNER_PID}" "${PORTABLE_LOCK_OWNER_START_HEX}" \
          "${PORTABLE_LOCK_OWNER_PGID}" || :
      return 75
    fi
    sleep 1
  done
}

portable_lock_handle_is_owned() {
  portable_lock_owned_handle=$1
  portable_lock_actual_process_identity || return 1
  portable_lock_load_claim "${portable_lock_owned_handle}" || return 1
  [ "${PORTABLE_LOCK_LOADED_PID}" = "${PORTABLE_LOCK_OWNER_PID}" ] &&
    [ "${PORTABLE_LOCK_LOADED_START}" = \
      "${PORTABLE_LOCK_OWNER_START_HEX}" ] &&
    [ "${PORTABLE_LOCK_LOADED_PGID}" = "${PORTABLE_LOCK_OWNER_PGID}" ] ||
    return 1
  portable_lock_owned_root=${portable_lock_owned_handle%/*}
  portable_lock_owned_stable=\
"${portable_lock_owned_root}/.${PORTABLE_LOCK_LOADED_NAME}.lock"
  portable_lock_owned_claim_identity=$(portable_lock_identity \
    "${portable_lock_owned_handle}" 2>/dev/null) || return 1
  portable_lock_owned_stable_identity=$(portable_lock_identity \
    "${portable_lock_owned_stable}" 2>/dev/null) || return 1
  [ "${portable_lock_owned_claim_identity}" = \
    "${portable_lock_owned_stable_identity}" ]
}

portable_lock_release() {
  portable_lock_release_handle=$1
  portable_lock_handle_is_owned "${portable_lock_release_handle}" || return 1
  portable_lock_release_nonce=${PORTABLE_LOCK_LOADED_NONCE}
  portable_lock_release_pid=${PORTABLE_LOCK_LOADED_PID}
  portable_lock_release_start=${PORTABLE_LOCK_LOADED_START}
  portable_lock_release_pgid=${PORTABLE_LOCK_LOADED_PGID}
  portable_lock_release_name=${PORTABLE_LOCK_LOADED_NAME}
  portable_lock_release_root=${portable_lock_release_handle%/*}
  portable_lock_release_stable=\
"${portable_lock_release_root}/.${portable_lock_release_name}.lock"
  portable_lock_release_identity=$(portable_lock_identity \
    "${portable_lock_release_stable}") || return 1
  portable_lock_remove_exact "${portable_lock_release_stable}" \
    "${portable_lock_release_identity}" "${portable_lock_release_nonce}" \
    "${portable_lock_release_pid}" "${portable_lock_release_start}" \
    "${portable_lock_release_pgid}" || return 1
  portable_lock_claim_identity=$(portable_lock_identity \
    "${portable_lock_release_handle}" 2>/dev/null || :)
  [ -z "${portable_lock_claim_identity}" ] ||
    portable_lock_remove_exact "${portable_lock_release_handle}" \
      "${portable_lock_claim_identity}" "${portable_lock_release_nonce}" \
      "${portable_lock_release_pid}" "${portable_lock_release_start}" \
      "${portable_lock_release_pgid}"
}

portable_lock_release_all() {
  portable_lock_release_list=${PORTABLE_LOCK_HANDLES:-}
  portable_lock_release_saved_ifs=$IFS
  case $- in
    *f*) portable_lock_release_glob_was_disabled=1 ;;
    *) portable_lock_release_glob_was_disabled=0; set -f ;;
  esac
  portable_lock_release_failed=
  portable_lock_release_first_failed=
  IFS='
'
  for portable_lock_release_item in ${portable_lock_release_list}; do
    [ -n "${portable_lock_release_item}" ] || continue
    if ! portable_lock_release "${portable_lock_release_item}"; then
      printf 'warning: failed to release portable lock claim: %s\n' \
        "${portable_lock_release_item}" >&2
      if [ -n "${portable_lock_release_failed}" ]; then
        portable_lock_release_failed="${portable_lock_release_failed}
${portable_lock_release_item}"
      else
        portable_lock_release_failed=${portable_lock_release_item}
        portable_lock_release_first_failed=${portable_lock_release_item}
      fi
    fi
  done
  IFS=${portable_lock_release_saved_ifs}
  if [ "${portable_lock_release_glob_was_disabled}" -eq 0 ]; then
    set +f
  fi
  unset PORTABLE_LOCK_HANDLES
  PORTABLE_LOCK_HANDLES=${portable_lock_release_failed}
  PORTABLE_LOCK_HANDLE=${portable_lock_release_first_failed}
  export PORTABLE_LOCK_HANDLE
  [ -z "${portable_lock_release_failed}" ]
}
