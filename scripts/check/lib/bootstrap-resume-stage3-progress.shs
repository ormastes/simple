# Shared, fail-closed progress lifecycle for resume-only Stage 3.
# The caller owns trap installation; this helper owns validated same-directory
# state/event/log publication, watcher cleanup, and the recorded lock release.

bootstrap_resume_stage3_progress_validate() {
  bootstrap_resume_progress_output=$1
  bootstrap_resume_progress_log_input=${2:-default}
  bootstrap_resume_progress_root=$3
  bootstrap_resume_progress_watcher=$4
  case "$bootstrap_resume_progress_log_input" in
    default) bootstrap_resume_progress_log="$bootstrap_resume_progress_output/bootstrap-progress.log" ;;
    /*) bootstrap_resume_progress_log=$bootstrap_resume_progress_log_input ;;
    *) bootstrap_resume_progress_log="$bootstrap_resume_progress_root/$bootstrap_resume_progress_log_input" ;;
  esac
  bootstrap_resume_progress_state="$bootstrap_resume_progress_output/bootstrap-progress.state"
  bootstrap_resume_progress_events="$bootstrap_resume_progress_output/bootstrap-build-progress.events"
  bootstrap_resume_progress_tmp="${bootstrap_resume_progress_state}.tmp.$$"
  bootstrap_resume_progress_pid=
  bootstrap_resume_progress_log_dir=$(dirname -- "$bootstrap_resume_progress_log")
  [ -d "$bootstrap_resume_progress_output" ] && [ ! -L "$bootstrap_resume_progress_output" ] || return 1
  [ -f "$bootstrap_resume_progress_watcher" ] && [ ! -L "$bootstrap_resume_progress_watcher" ] || return 1
  [ -d "$bootstrap_resume_progress_log_dir" ] && [ ! -L "$bootstrap_resume_progress_log_dir" ] || return 1
  [ ! -L "$bootstrap_resume_progress_log" ] || return 1
  [ ! -L "$bootstrap_resume_progress_state" ] || return 1
  [ ! -L "$bootstrap_resume_progress_events" ] || return 1
  [ ! -e "$bootstrap_resume_progress_tmp" ] && [ ! -L "$bootstrap_resume_progress_tmp" ] || return 1
}

bootstrap_resume_stage3_progress_state() {
  bootstrap_resume_progress_milestone=$1
  bootstrap_resume_progress_main_log=${2:-}
  [ ! -L "$bootstrap_resume_progress_state" ] || return 1
  [ ! -e "$bootstrap_resume_progress_tmp" ] && [ ! -L "$bootstrap_resume_progress_tmp" ] || return 1
  ( umask 077; set -C; : >"$bootstrap_resume_progress_tmp" ) || return 1
  {
    printf 'milestone=%s\n' "$bootstrap_resume_progress_milestone"
    printf 'main_log=%s\n' "$bootstrap_resume_progress_main_log"
  } >"$bootstrap_resume_progress_tmp" || { rm -f "$bootstrap_resume_progress_tmp"; return 1; }
  [ ! -L "$bootstrap_resume_progress_tmp" ] || { rm -f "$bootstrap_resume_progress_tmp"; return 1; }
  mv "$bootstrap_resume_progress_tmp" "$bootstrap_resume_progress_state" || {
    rm -f "$bootstrap_resume_progress_tmp"
    return 1
  }
}

bootstrap_resume_stage3_progress_event() {
  bootstrap_resume_progress_phase=$1
  bootstrap_resume_progress_terminal=$2
  bootstrap_resume_progress_failed=$3
  bootstrap_resume_progress_current=$4
  [ ! -L "$bootstrap_resume_progress_events" ] || return 1
  printf 'event=build_progress phase=%s unit_kind=unknown done=unknown total=unknown remaining=unknown tasks_done=unknown tasks_total=unknown tasks_remaining=unknown failed=%s cached=unknown current=%s terminal=%s\n' \
    "$bootstrap_resume_progress_phase" "$bootstrap_resume_progress_failed" \
    "$bootstrap_resume_progress_current" "$bootstrap_resume_progress_terminal" \
    >>"$bootstrap_resume_progress_events"
}

bootstrap_resume_stage3_progress_begin() {
  bootstrap_resume_progress_watch_pid=$1
  bootstrap_resume_progress_interval=${2:-30}
  [ ! -L "$bootstrap_resume_progress_log" ] || return 1
  [ ! -L "$bootstrap_resume_progress_events" ] || return 1
  : >"$bootstrap_resume_progress_log" || return 1
  : >"$bootstrap_resume_progress_events" || return 1
  bootstrap_resume_stage3_progress_state stage3-resume "" || return 1
  bootstrap_resume_stage3_progress_event stage3-resume running unknown stage3-resume || return 1
  sh "$bootstrap_resume_progress_watcher" progress-watch \
    --pid="$bootstrap_resume_progress_watch_pid" \
    --state-file="$bootstrap_resume_progress_state" \
    --event-file="$bootstrap_resume_progress_events" \
    --progress-log="$bootstrap_resume_progress_log" \
    --interval="$bootstrap_resume_progress_interval" &
  bootstrap_resume_progress_pid=$!
}

bootstrap_resume_stage3_progress_finish() {
  bootstrap_resume_progress_status=$1
  bootstrap_resume_progress_lock=${2:-}
  bootstrap_resume_progress_publish_failed=0
  if ! bootstrap_resume_stage3_progress_state "exit-${bootstrap_resume_progress_status}" ""; then
    bootstrap_resume_progress_publish_failed=1
  fi
  if [ "$bootstrap_resume_progress_status" -eq 0 ]; then
    bootstrap_resume_stage3_progress_event complete succeeded 0 complete || bootstrap_resume_progress_publish_failed=1
  else
    bootstrap_resume_stage3_progress_event "exit-${bootstrap_resume_progress_status}" failed 1 failed || bootstrap_resume_progress_publish_failed=1
  fi
  if [ -n "${bootstrap_resume_progress_pid:-}" ]; then
    kill "$bootstrap_resume_progress_pid" 2>/dev/null || true
    wait "$bootstrap_resume_progress_pid" 2>/dev/null || true
  fi
  if [ -n "$bootstrap_resume_progress_lock" ]; then
    rm -rf "$bootstrap_resume_progress_lock" || bootstrap_resume_progress_publish_failed=1
  fi
  # Never replace a real candidate failure; publication failure only turns an
  # otherwise-successful resume into a failure.
  if [ "$bootstrap_resume_progress_status" -eq 0 ] && [ "$bootstrap_resume_progress_publish_failed" -ne 0 ]; then
    return 1
  fi
  return "$bootstrap_resume_progress_status"
}
