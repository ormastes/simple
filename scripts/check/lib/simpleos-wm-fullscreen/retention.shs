archive_previous_run() {
    [ -f "$BUILD_DIR/evidence.env" ] || return 0
    prev_status="$(sed -n 's/^simpleos_wm_fullscreen_status=//p' "$BUILD_DIR/evidence.env" | head -n 1)"
    [ -n "$prev_status" ] || prev_status=unknown
    case "$prev_status" in
        pass|fail|skip|blocked|unknown) ;;
        *) prev_status=unknown ;;
    esac
    stamp="$(date -u +%Y%m%dT%H%M%SZ)" || return 1
    mkdir -p "$EVIDENCE_RUNS_DIR" || return 1
    # Keep partial copies invisible to archive discovery/pruning. A unique
    # same-filesystem staging directory becomes a published run only after
    # every present artifact and the run metadata have been written.
    pending="$(mktemp -d "$EVIDENCE_RUNS_DIR/.pending-$stamp-XXXXXX")" || return 1
    nonce="${pending##*-}"
    dest="$EVIDENCE_RUNS_DIR/$stamp-$nonce-$prev_status"
    [ ! -e "$dest" ] || return 1
    for retained in "$BUILD_DIR/evidence.env" "$LAUNCH_OUT" "$SERIAL_LOG" \
        "$CAPTURE_OUT" "$BASELINE_PPM" "$FULLSCREEN_PPM" "$RESTORED_PPM" \
        "$BROWSER_EVENT_PPM" "$FONT_REGION_RGB"
    do
        if [ -f "$retained" ]; then
            cp -p "$retained" "$pending/" || return 1
        fi
    done
    printf '%s\n' \
        "archived_at_utc=$stamp" \
        "archived_from=$BUILD_DIR" \
        "archived_run_status=$prev_status" \
        "archived_by_wrapper=$WRAPPER" \
        "note=retained copy of a PREVIOUS run; the current run writes only the canonical \$BUILD_DIR paths" \
        >"$pending/RUN_INFO.env" || return 1
    mv "$pending" "$dest" || return 1
    if [ "$prev_status" = pass ]; then
        # Commit completion order separately from random archive names. The
        # next failed run must still protect this PASS, not a lexically later
        # old name. A failed marker update leaves canonical evidence intact.
        latest_pass="$EVIDENCE_RUNS_DIR/.latest-pass"
        if [ -e "$latest_pass" ] || [ -L "$latest_pass" ]; then
            [ -f "$latest_pass" ] && [ ! -L "$latest_pass" ] || return 1
        fi
        latest_pending="$(mktemp "$EVIDENCE_RUNS_DIR/.latest-pass-XXXXXX")" || return 1
        printf '%s\n' "${dest##*/}" >"$latest_pending" || return 1
        mv -f "$latest_pending" "$latest_pass" || return 1
    fi
    echo "simpleos_wm_fullscreen_retained_previous_run=$dest status=$prev_status"
}

prune_archived_runs() {
    [ -d "$EVIDENCE_RUNS_DIR" ] || return 0
    latest_pass="$EVIDENCE_RUNS_DIR/.latest-pass"
    if [ -e "$latest_pass" ] || [ -L "$latest_pass" ]; then
        [ -f "$latest_pass" ] && [ ! -L "$latest_pass" ] || return 1
        IFS= read -r keep_pass <"$latest_pass" || return 1
        case "$keep_pass" in
            ''|.*|*/*) return 1 ;;
            *-pass|*-pass.[0-9]*) ;;
            *) return 1 ;;
        esac
        [ -d "$EVIDENCE_RUNS_DIR/$keep_pass" ] &&
            [ ! -L "$EVIDENCE_RUNS_DIR/$keep_pass" ] || return 1
    else
        # Legacy archives predate the completion record; use filesystem
        # completion times rather than names until a new PASS is published.
        keep_pass="$(ls -1t "$EVIDENCE_RUNS_DIR" 2>/dev/null | grep -E -- '-pass(\.[0-9]+)?$' | head -n 1)"
    fi
    total="$(ls -1 "$EVIDENCE_RUNS_DIR" 2>/dev/null | wc -l | tr -d ' ')"
    [ "$total" -gt "$EVIDENCE_RETAIN" ] || return 0
    excess=$((total - EVIDENCE_RETAIN))
    for stale in $(ls -1tr "$EVIDENCE_RUNS_DIR" 2>/dev/null); do
        [ "$excess" -gt 0 ] || break
        [ "$stale" = "$keep_pass" ] && continue
        rm -rf "$EVIDENCE_RUNS_DIR/$stale"
        excess=$((excess - 1))
    done
}

if ! archive_previous_run; then
    echo "simpleos_wm_fullscreen_retention_failed: previous evidence preserved" >&2
    exit 1
fi
prune_archived_runs

rm -f "$LAUNCH_OUT" "$SERIAL_LOG" "$QMP_SOCKET" "$CAPTURE_OUT" \
    "$BASELINE_PPM" "$FULLSCREEN_PPM" "$RESTORED_PPM" \
    "$BROWSER_EVENT_PPM" "$BASELINE_RAW" "$FULLSCREEN_RAW" "$RESTORED_RAW" \
    "$BROWSER_EVENT_RAW" \
    "$FONT_REGION_RGB" "$FONT_REGION_CORRUPT_COPY" "$BUILD_DIR/evidence.env"

resolve_path() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1" 2>/dev/null || true
    elif command -v readlink >/dev/null 2>&1; then
        readlink -f "$1" 2>/dev/null || true
    else
        return 0
    fi
}

is_rust_seed_path() {
    case "$1" in
        *"/src/compiler_rust/"*|*"/compiler_rust/target/"*) return 0 ;;
        *) return 1 ;;
    esac
}

if [ -z "${SIMPLE_BIN:-}" ]; then
    SIMPLE_BIN=""
    SIMPLE_BIN_SOURCE=auto-cached-pure-simple
    for candidate in \
        "$ROOT_DIR"/build/bootstrap/stage3/*/stage2-admitted/simple
    do
        if [ -x "$candidate" ]; then
            resolved="$(resolve_path "$candidate")"
            if [ -n "$resolved" ] && ! is_rust_seed_path "$resolved" && \
               simpleos_admitted_runtime_verify_auto "$resolved"; then
                SIMPLE_BIN="$candidate"
                SIMPLE_BIN_RUNTIME_ADMITTED=1
                break
            fi
        fi
    done
fi
export SIMPLE_BIN SIMPLE_BIN_SOURCE SIMPLE_BIN_STATUS SIMPLE_BIN_RESOLVED SIMPLE_BIN_VERSION SIMPLE_BIN_SHA256

cleanup() {
    if [ -n "${BUILD_POLL_PID:-}" ]; then
        kill "$BUILD_POLL_PID" >/dev/null 2>&1 || true
        wait "$BUILD_POLL_PID" >/dev/null 2>&1 || true
    fi
    if [ -n "${BUILD_PID:-}" ]; then
        kill "$BUILD_PID" >/dev/null 2>&1 || true
        wait "$BUILD_PID" >/dev/null 2>&1 || true
    fi
    if [ -n "$QEMU_PID" ]; then
        kill "$QEMU_PID" >/dev/null 2>&1 || true
        wait "$QEMU_PID" >/dev/null 2>&1 || true
    fi
    pkill -f "qemu-system.*$QMP_SOCKET" >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

file_byte_count() {
    if [ -f "$1" ]; then
        wc -c <"$1" | tr -d ' '
    else
        echo 0
    fi
}

file_sha256() {
    if [ ! -f "$1" ]; then
        echo ""
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        echo ""
    fi
}

wrapper_bundle_sha256() {
    bundle_manifest="$BUILD_DIR/wrapper-components.sha256"
    : >"$bundle_manifest"
    for bundle_component in $WM_FULLSCREEN_COMPONENTS; do
        bundle_component_sha256="$(file_sha256 "$bundle_component")"
        is_sha256 "$bundle_component_sha256" || return 1
        printf '%s  %s\n' "$bundle_component_sha256" "$bundle_component" >>"$bundle_manifest"
    done
    file_sha256 "$bundle_manifest"
}

font_region_oracle_status() {
    if [ "$(file_byte_count "$1")" = "$FONT_REGION_EXPECTED_BYTES" ] && \
       [ "$(file_sha256 "$1")" = "$FONT_REGION_EXPECTED_SHA256" ]; then
        echo pass
    else
        echo fail
    fi
}

is_sha256() {
    [ "${#1}" -eq 64 ] && case "$1" in
        *[!0-9a-f]*) false ;;
        *) true ;;
    esac
}
