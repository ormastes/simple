#!/bin/sh
# Copy one caller-supplied artifact into a private fresh directory and pin the
# exact staged bytes by SHA-256 before the file can be executed or loaded.
set -eu
[ "$#" = 4 ] || { echo 'usage: stage-verified-file.shs SOURCE DEST MODE SHA256' >&2; exit 2; }
source=$1
destination=$2
mode=$3
expected=$4
case "$expected" in *[!0-9a-f]*|'') echo 'invalid expected SHA-256' >&2; exit 2 ;; esac
[ "${#expected}" = 64 ] || { echo 'invalid expected SHA-256 length' >&2; exit 2; }
[ -f "$source" ] && [ -r "$source" ] || { echo 'source artifact is not a readable regular file' >&2; exit 1; }
[ ! -e "$destination" ] || { echo 'destination must not exist' >&2; exit 1; }
directory=$(dirname -- "$destination")
[ -d "$directory" ] || { echo 'destination directory is missing' >&2; exit 1; }
temporary=$destination.copying.$$
trap 'rm -f -- "$temporary"' EXIT HUP INT TERM
cp -- "$source" "$temporary"
chmod "$mode" "$temporary"
actual=$(sha256sum -- "$temporary" | awk '{print $1}')
[ "$actual" = "$expected" ] || { echo 'staged artifact SHA-256 mismatch' >&2; exit 1; }
mv -- "$temporary" "$destination"
trap - EXIT HUP INT TERM
actual=$(sha256sum -- "$destination" | awk '{print $1}')
[ "$actual" = "$expected" ] || { echo 'destination SHA-256 changed after staging' >&2; exit 1; }
