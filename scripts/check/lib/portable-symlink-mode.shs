#!/bin/sh

# Make `ln -s` create REAL symlinks on Windows shells.
#
# MSYS / Git Bash / Cygwin default to *copying* on `ln -s`: a directory link
# becomes an independent directory and a dangling link fails outright with
# "No such file or directory". Both are silent-wrong for this repo:
#
#   - the immutable bootstrap authority publishes the seed as a symlink
#     (target/bootstrap -> a generation dir); a copy leaves every generation
#     stale while looking fine;
#   - Stage 3 source snapshotting classifies dangling links (link-missing-hex),
#     which the default mode cannot even create.
#
# winsymlinks:nativestrict creates a real NTFS symlink (including dangling
# ones) and FAILS LOUDLY where the host lacks the privilege -- Developer Mode
# or SeCreateSymbolicLinkPrivilege -- rather than copying behind our back.
# Callers that can genuinely proceed without symlinks must detect that
# themselves ([ -L ... ]) and say so; this file never silently degrades.
#
# No effect on Linux/macOS/FreeBSD, which ignore MSYS entirely.

portable_symlink_mode_enable() {
  case "$(uname -s 2>/dev/null || echo unknown)" in
    MSYS*|MINGW*|CYGWIN*) ;;
    *) return 0 ;;
  esac
  case "${MSYS:-}" in
    *winsymlinks:nativestrict*) return 0 ;;
  esac
  MSYS="${MSYS:+${MSYS} }winsymlinks:nativestrict"
  export MSYS
}

portable_symlink_mode_enable
