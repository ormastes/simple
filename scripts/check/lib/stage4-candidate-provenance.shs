#!/bin/sh
# Canonical provenance contract for a full-CLI Stage4 candidate.

: "${BOOTSTRAP_STAGE3_FACADE_PATH:?canonical Stage3 provenance facade path is required}"
: "${STAGE4_PROVENANCE_HELPER_PATH:?canonical Stage4 provenance helper path is required}"

stage4_source_revision() (
  root="$(CDPATH= cd -- "$1" && pwd -P)" || exit 1
  cd "$root" || exit 1
  work="$(mktemp -d)" || exit 1
  trap 'rm -rf "$work"' EXIT INT TERM
  find src/compiler src/lib src/app src/runtime examples/10_tooling \
    \( -type f -o -type l \) -print \
    >"$work/paths.unsorted" || exit 1
  LC_ALL=C sort "$work/paths.unsorted" >"$work/paths" || exit 1
  while IFS= read -r path; do
    if [ -L "$path" ]; then
      target="$(readlink "$path")" || exit 1
      content=directory
      if [ -f "$path" ]; then
        content="$(bootstrap_stage3_hash_file "$path")" || exit 1
      elif [ -d "$path" ]; then
        target_dir="$(CDPATH= cd -- "$path" && pwd -P)" || exit 1
        case "$target_dir" in
          "$root/src/compiler"|"$root/src/compiler/"*|\
          "$root/src/lib"|"$root/src/lib/"*|\
          "$root/src/app"|"$root/src/app/"*|\
          "$root/src/runtime"|"$root/src/runtime/"*|\
          "$root/examples/10_tooling"|"$root/examples/10_tooling/"*)
            content="directory:$target_dir"
            ;;
          *)
            printf 'stage4 source authority: directory symlink escapes owned roots: %s -> %s\n' \
              "$path" "$target_dir" >&2
            exit 1
            ;;
        esac
      else
        printf 'stage4 source authority: unresolved symlink: %s -> %s\n' \
          "$path" "$target" >&2
        exit 1
      fi
      printf 'link %s %s %s\n' "$path" "$target" "$content"
    else
      content="$(bootstrap_stage3_hash_file "$path")" || exit 1
      printf 'file %s %s\n' "$path" "$content"
    fi
  done <"$work/paths" >"$work/snapshot" || exit 1
  bootstrap_stage3_hash_file "$work/snapshot"
)

stage4_validate_candidate_lane() (
  binary="$1"
  stage3_manifest="$2"
  root="$3"
  build_log="$4"
  smoke_log="$5"
  platform="$(bootstrap_stage3_manifest_value platform "$stage3_manifest")" || exit 1
  stage3_dir="$(dirname -- "$stage3_manifest")"
  output_root="$(dirname -- "$(dirname -- "$stage3_dir")")"
  suffix=
  case "$platform" in *windows*) suffix=.exe ;; esac
  [ "$binary" = "$output_root/full/$platform/simple$suffix" ] || exit 1
  [ "$build_log" = "$output_root/logs/$platform/stage4-native-build.log" ] || exit 1
  [ "$smoke_log" = "$output_root/logs/$platform/stage4-essential-tools-smoke.log" ] || exit 1
  parent="$(bootstrap_stage3_manifest_value output_path "$stage3_manifest")" || exit 1
  [ "$(grep -Fxc "cwd: $root" "$build_log")" -eq 1 ] || exit 1
  [ "$(grep -Fxc "command: bootstrap_native_build_main $parent $binary" "$build_log")" -eq 1 ] || exit 1
  [ "$(grep -Fxc "cwd: $root" "$smoke_log")" -eq 1 ] || exit 1
  [ "$(grep -Fxc "command: run_timeout_kill 180 env SIMPLE_BINARY=$binary sh scripts/check/check-bootstrap-essential-tools-smoke.shs" "$smoke_log")" -eq 1 ] || exit 1
  for receipt in essential_tools_pure_simple_identity=true \
      essential_test_runner_smoke=true essential_lint_smoke=true \
      essential_duplicate_checker_smoke=true bootstrap_essential_tools_smoke=true; do
    [ "$(grep -Fxc "$receipt" "$smoke_log")" -eq 1 ] || exit 1
  done
)

stage4_write_candidate_provenance() (
  [ "$#" -eq 12 ] || exit 1
  binary="$(bootstrap_stage3_canonical_file "$1")" || exit 1
  provenance="$2"
  root="$(CDPATH= cd -- "$3" && pwd -P)" || exit 1
  producer="$(bootstrap_stage3_canonical_file "$4")" || exit 1
  parent_compiler="$(bootstrap_stage3_canonical_file "$5")" || exit 1
  stage3_manifest="$(bootstrap_stage3_canonical_file "$6")" || exit 1
  source_before="$7"
  producer_sha_before="$8"
  helper_sha_before="$9"
  bootstrap_lock="$(bootstrap_stage3_canonical_path "${10}")" || exit 1
  build_log="$(bootstrap_stage3_canonical_file "${11}")" || exit 1
  smoke_log="$(bootstrap_stage3_canonical_file "${12}")" || exit 1
  helper="$(bootstrap_stage3_canonical_file "$STAGE4_PROVENANCE_HELPER_PATH")" || exit 1

  [ "$provenance" = "${binary}.provenance.env" ] || exit 1
  bootstrap_stage3_verify_manifest "$stage3_manifest" "$root" "$parent_compiler" || exit 1
  if [ -n "${STAGE4_CONTINUATION_RECEIPT:-}" ]; then
    [ -f "$bootstrap_lock" ] && [ ! -L "$bootstrap_lock" ] &&
      portable_lock_handle_is_owned "$bootstrap_lock" || exit 1
    continuation="$(bootstrap_stage3_canonical_file "$STAGE4_CONTINUATION_RECEIPT")" || exit 1
    [ "$(bootstrap_stage3_manifest_value schema "$continuation")" = simple-bootstrap-stage4-continuation-v1 ] || exit 1
    [ "$(bootstrap_stage3_manifest_value status "$continuation")" = prepared ] || exit 1
    [ "$(bootstrap_stage3_manifest_value stage3_provenance_path "$continuation")" = "$stage3_manifest" ] || exit 1
    [ "$(bootstrap_stage3_manifest_value stage3_provenance_sha256 "$continuation")" = "$(bootstrap_stage3_hash_file "$stage3_manifest")" ] || exit 1
    [ "$(bootstrap_stage3_manifest_value parent_compiler_path "$continuation")" = "$parent_compiler" ] || exit 1
    [ "$(bootstrap_stage3_manifest_value parent_compiler_sha256 "$continuation")" = "$(bootstrap_stage3_hash_file "$parent_compiler")" ] || exit 1
    [ "$(bootstrap_stage3_manifest_value bootstrap_lock_path "$continuation")" = "$bootstrap_lock" ] || exit 1
    recorded_pid="$(bootstrap_stage3_manifest_value bootstrap_lock_owner_pid "$continuation")" || exit 1
  else
    [ "$bootstrap_lock" = "$(bootstrap_stage3_manifest_value bootstrap_lock_path "$stage3_manifest")" ] || exit 1
    recorded_pid="$(bootstrap_stage3_manifest_value bootstrap_lock_owner_pid "$stage3_manifest")" || exit 1
  fi
  [ "$recorded_pid" = "$$" ] || exit 1
  if [ -z "${STAGE4_CONTINUATION_RECEIPT:-}" ]; then
    [ -d "$bootstrap_lock" ] && [ ! -L "$bootstrap_lock" ] || exit 1
    [ "$(tr -d '[:space:]' <"$bootstrap_lock/pid")" = "$recorded_pid" ] || exit 1
  fi
  stage4_validate_candidate_lane "$binary" "$stage3_manifest" "$root" "$build_log" "$smoke_log" || exit 1
  source_after="$(stage4_source_revision "$root")" || exit 1
  [ "$source_after" = "$source_before" ] || exit 1
  [ "$(bootstrap_stage3_hash_file "$producer")" = "$producer_sha_before" ] || exit 1
  [ "$(bootstrap_stage3_hash_file "$helper")" = "$helper_sha_before" ] || exit 1

  tmp="${provenance}.tmp.$$"
  trap 'rm -f "$tmp"' EXIT INT TERM
  umask 077
  {
    echo "schema=simple-bootstrap-stage4-provenance-v1"
    echo "status=pass"
    echo "artifact_kind=pure-simple-full-cli"
    echo "output_path=$binary"
    echo "output_sha256=$(bootstrap_stage3_hash_file "$binary")"
    echo "source_revision_kind=content-sha256"
    echo "source_revision=$source_after"
    echo "source_roots=src/compiler:src/lib:src/app:src/runtime:examples/10_tooling"
    echo "producer_path=$producer"
    echo "producer_sha256=$producer_sha_before"
    echo "provenance_helper_path=$helper"
    echo "provenance_helper_sha256=$helper_sha_before"
    echo "parent_compiler_path=$parent_compiler"
    echo "parent_compiler_sha256=$(bootstrap_stage3_hash_file "$parent_compiler")"
    echo "stage3_provenance_path=$stage3_manifest"
    echo "stage3_provenance_sha256=$(bootstrap_stage3_hash_file "$stage3_manifest")"
    echo "build_log_path=$build_log"
    echo "build_log_sha256=$(bootstrap_stage3_hash_file "$build_log")"
    echo "essential_tools_log_path=$smoke_log"
    echo "essential_tools_log_sha256=$(bootstrap_stage3_hash_file "$smoke_log")"
    echo "completed_gate=stage4-essential-tools-smoke"
  } >"$tmp" || exit 1
  mv "$tmp" "$provenance"
)

stage4_verify_candidate_provenance() (
  provenance="$(bootstrap_stage3_canonical_file "$1")" || exit 1
  binary="$(bootstrap_stage3_canonical_file "$2")" || exit 1
  root="$(CDPATH= cd -- "$3" && pwd -P)" || exit 1
  producer="$root/scripts/bootstrap/bootstrap-from-scratch.sh"
  helper="$root/scripts/check/lib/stage4-candidate-provenance.shs"

  [ "$provenance" = "${binary}.provenance.env" ] || exit 1
  for key in schema status artifact_kind output_path output_sha256 \
      source_revision_kind source_revision source_roots producer_path \
      producer_sha256 provenance_helper_path provenance_helper_sha256 \
      parent_compiler_path parent_compiler_sha256 stage3_provenance_path \
      stage3_provenance_sha256 build_log_path build_log_sha256 \
      essential_tools_log_path essential_tools_log_sha256 completed_gate; do
    bootstrap_stage3_manifest_value "$key" "$provenance" >/dev/null || exit 1
  done
  [ "$(bootstrap_stage3_manifest_value schema "$provenance")" = simple-bootstrap-stage4-provenance-v1 ] || exit 1
  [ "$(bootstrap_stage3_manifest_value status "$provenance")" = pass ] || exit 1
  [ "$(bootstrap_stage3_manifest_value artifact_kind "$provenance")" = pure-simple-full-cli ] || exit 1
  [ "$(bootstrap_stage3_manifest_value output_path "$provenance")" = "$binary" ] || exit 1
  [ "$(bootstrap_stage3_manifest_value output_sha256 "$provenance")" = "$(bootstrap_stage3_hash_file "$binary")" ] || exit 1
  [ "$(bootstrap_stage3_manifest_value source_revision_kind "$provenance")" = content-sha256 ] || exit 1
  [ "$(bootstrap_stage3_manifest_value source_roots "$provenance")" = src/compiler:src/lib:src/app:src/runtime:examples/10_tooling ] || exit 1
  [ "$(bootstrap_stage3_manifest_value source_revision "$provenance")" = "$(stage4_source_revision "$root")" ] || exit 1
  [ "$(bootstrap_stage3_manifest_value producer_path "$provenance")" = "$producer" ] || exit 1
  [ "$(bootstrap_stage3_manifest_value producer_sha256 "$provenance")" = "$(bootstrap_stage3_hash_file "$producer")" ] || exit 1
  [ "$(bootstrap_stage3_manifest_value provenance_helper_path "$provenance")" = "$helper" ] || exit 1
  [ "$(bootstrap_stage3_manifest_value provenance_helper_sha256 "$provenance")" = "$(bootstrap_stage3_hash_file "$helper")" ] || exit 1

  parent_compiler="$(bootstrap_stage3_canonical_file "$(bootstrap_stage3_manifest_value parent_compiler_path "$provenance")")" || exit 1
  [ "$(bootstrap_stage3_manifest_value parent_compiler_sha256 "$provenance")" = "$(bootstrap_stage3_hash_file "$parent_compiler")" ] || exit 1
  stage3_manifest="$(bootstrap_stage3_canonical_file "$(bootstrap_stage3_manifest_value stage3_provenance_path "$provenance")")" || exit 1
  [ "$(bootstrap_stage3_manifest_value stage3_provenance_sha256 "$provenance")" = "$(bootstrap_stage3_hash_file "$stage3_manifest")" ] || exit 1
  bootstrap_stage3_verify_manifest "$stage3_manifest" "$root" "$parent_compiler" || exit 1
  build_log="$(bootstrap_stage3_canonical_file "$(bootstrap_stage3_manifest_value build_log_path "$provenance")")" || exit 1
  [ "$(bootstrap_stage3_manifest_value build_log_sha256 "$provenance")" = "$(bootstrap_stage3_hash_file "$build_log")" ] || exit 1
  smoke_log="$(bootstrap_stage3_canonical_file "$(bootstrap_stage3_manifest_value essential_tools_log_path "$provenance")")" || exit 1
  [ "$(bootstrap_stage3_manifest_value essential_tools_log_sha256 "$provenance")" = "$(bootstrap_stage3_hash_file "$smoke_log")" ] || exit 1
  stage4_validate_candidate_lane "$binary" "$stage3_manifest" "$root" "$build_log" "$smoke_log" || exit 1
  [ "$(bootstrap_stage3_manifest_value completed_gate "$provenance")" = stage4-essential-tools-smoke ] || exit 1
)
