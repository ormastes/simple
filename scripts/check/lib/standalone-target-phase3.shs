#!/bin/sh
# Admitted Phase 3 compiler resolver for standalone product targets.
#
# A standalone target (Office, a desktop demo, or an external tool) is not a
# compiler rebuild.  It may consume an already admitted Stage 3 compiler, but
# it must never start a Stage 1/2/3 bootstrap itself.

: "${STANDALONE_TARGET_ROOT:?repository root is required}"

standalone_target_fail() {
    printf 'standalone target build: FAIL (%s)\n' "$1" >&2
    return 1
}

standalone_target_hash_file() {
    bootstrap_stage3_hash_file "$1"
}

standalone_target_require_nonbootstrap_path() {
    case "$1" in
        "$STANDALONE_TARGET_ROOT"/build/bootstrap|\
        "$STANDALONE_TARGET_ROOT"/build/bootstrap/*)
            standalone_target_fail "target-path-is-bootstrap-owned"
            return 1
            ;;
    esac
}

# Arguments: <absolute Stage 3 compiler path>
# Sets STANDALONE_TARGET_COMPILER and STANDALONE_TARGET_COMPILER_SHA256.
standalone_target_resolve_phase3() {
    standalone_target_candidate=$1
    case "$standalone_target_candidate" in
        /*) ;;
        *) standalone_target_fail "phase3-compiler-path-not-absolute"; return 1 ;;
    esac
    [ -x "$standalone_target_candidate" ] && [ ! -L "$standalone_target_candidate" ] || {
        standalone_target_fail "phase3-compiler-missing-or-symlinked"
        return 1
    }
    standalone_target_candidate=$(bootstrap_stage3_canonical_file \
        "$standalone_target_candidate") || {
        standalone_target_fail "phase3-compiler-path-not-canonical"
        return 1
    }
    standalone_target_manifest="$(dirname -- "$standalone_target_candidate")/provenance.env"
    [ -f "$standalone_target_manifest" ] && [ ! -L "$standalone_target_manifest" ] || {
        standalone_target_fail "phase3-provenance-missing-or-symlinked"
        return 1
    }
    standalone_target_manifest=$(bootstrap_stage3_canonical_file \
        "$standalone_target_manifest") || {
        standalone_target_fail "phase3-provenance-path-not-canonical"
        return 1
    }
    standalone_target_candidate_sha=$(standalone_target_hash_file \
        "$standalone_target_candidate") || return 1
    standalone_target_manifest_sha=$(standalone_target_hash_file \
        "$standalone_target_manifest") || return 1
    bootstrap_stage3_verify_manifest "$standalone_target_manifest" \
        "$STANDALONE_TARGET_ROOT" "$standalone_target_candidate" >/dev/null || {
        standalone_target_fail "phase3-provenance-invalid"
        return 1
    }
    [ "$standalone_target_candidate_sha" = "$(standalone_target_hash_file \
        "$standalone_target_candidate")" ] || {
        standalone_target_fail "phase3-compiler-changed-during-verification"
        return 1
    }
    [ "$standalone_target_manifest_sha" = "$(standalone_target_hash_file \
        "$standalone_target_manifest")" ] || {
        standalone_target_fail "phase3-provenance-changed-during-verification"
        return 1
    }
    STANDALONE_TARGET_COMPILER=$standalone_target_candidate
    STANDALONE_TARGET_COMPILER_SHA256=$standalone_target_candidate_sha
    STANDALONE_TARGET_PROVENANCE=$standalone_target_manifest
    STANDALONE_TARGET_PROVENANCE_SHA256=$standalone_target_manifest_sha
    export STANDALONE_TARGET_COMPILER STANDALONE_TARGET_COMPILER_SHA256 \
        STANDALONE_TARGET_PROVENANCE STANDALONE_TARGET_PROVENANCE_SHA256
}
