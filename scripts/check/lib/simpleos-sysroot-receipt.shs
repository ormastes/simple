#!/bin/sh
# Build provenance, not execution qualification. SDK validation needs hashes,
# source inputs and installed bytes, but never the producer's local CC or AR.

simpleos_sdk_hash() (
    [ -f "$1" ] || return 1
    [ "${2:-}" = tool ] || [ ! -L "$1" ] || return 1
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        return 1
    fi
)

simpleos_sdk_field() {
    awk -v key="$2" 'index($0,key ": ")==1 { n++; value=substr($0,length(key)+3) }
        END { if(n==1 && length(value)>0) {
            if(substr(value,1,1)=="\"" && substr(value,length(value),1)=="\"") value=substr(value,2,length(value)-2)
            print value
        } else exit 1 }' "$1"
}

simpleos_sdk_profile() {
    case "$1" in
        x86_64) printf '%s\n' x86_64-unknown-simpleos x64-fd32-source-only ;;
        aarch64) printf '%s\n' aarch64-unknown-simpleos legacy-serial-unqualified ;;
        riscv64) printf '%s\n' riscv64-unknown-simpleos legacy-serial-unqualified ;;
        i686) printf '%s\n' i686-unknown-simpleos legacy-serial-unqualified ;;
        arm32) printf '%s\n' arm32-unknown-simpleos legacy-serial-unqualified ;;
        riscv32) printf '%s\n' riscv32-unknown-simpleos legacy-serial-unqualified ;;
        *) return 1 ;;
    esac
}

simpleos_sdk_invalidate() {
    rm -f "$1/share/simpleos/sysroot-receipt.sdn"
}

simpleos_sdk_object_target_ok() (
    case "$2" in
        x86_64) sdk_class=0201; sdk_machine=3e00 ;;
        aarch64) sdk_class=0201; sdk_machine=b700 ;;
        riscv64) sdk_class=0201; sdk_machine=f300 ;;
        i686) sdk_class=0101; sdk_machine=0300 ;;
        arm32) sdk_class=0101; sdk_machine=2800 ;;
        riscv32) sdk_class=0101; sdk_machine=f300 ;;
        *) return 1 ;;
    esac
    [ "$(od -An -tx1 -N4 "$1" | tr -d ' \r\n')" = 7f454c46 ] &&
    [ "$(od -An -tx1 -j4 -N2 "$1" | tr -d ' \r\n')" = "$sdk_class" ] &&
    [ "$(od -An -tx1 -j18 -N2 "$1" | tr -d ' \r\n')" = "$sdk_machine" ]
)

simpleos_sdk_ledger() (
    sdk_base=$1; sdk_list=$2; sdk_output=$3; sdk_schema=$4
    printf 'schema: %s\nfiles:\n' "$sdk_schema" > "$sdk_output" || return 1
    while IFS= read -r sdk_path; do
        case "$sdk_path" in ''|/*|*..*|*[!a-zA-Z0-9_./+-]*) return 1 ;; esac
        sdk_digest=$(simpleos_sdk_hash "$sdk_base/$sdk_path") || return 1
        printf '  "%s": "%s"\n' "$sdk_path" "$sdk_digest" >> "$sdk_output" || return 1
    done < "$sdk_list"
)

simpleos_sdk_ledger_rows() (
    sdk_ledger=$1; sdk_schema=$2
    [ -f "$sdk_ledger" ] && [ ! -L "$sdk_ledger" ] || return 1
    [ "$(wc -c < "$sdk_ledger" | tr -d ' ')" -le 2097152 ] || return 1
    [ "$(sed -n '1p' "$sdk_ledger")" = "schema: $sdk_schema" ] || return 1
    [ "$(sed -n '2p' "$sdk_ledger")" = files: ] || return 1
    awk 'NR>2 {
        if($0 !~ /^  "[a-zA-Z0-9_.\/+\-]+": "[0-9a-f]+"$/) exit 1
        path=$0; sub(/^  "/,"",path); sub(/": .*/,"",path)
        hash=$0; sub(/^.*": "/,"",hash); sub(/"$/,"",hash)
        if(length(hash)!=64 || length(path)>512 || seen[path]++ || ++count>2048) exit 1
        print path " " hash
    } END { if(count<1) exit 1 }' "$sdk_ledger"
)

simpleos_sdk_verify_ledger() (
    sdk_base=$1; sdk_ledger=$2; sdk_schema=$3
    sdk_rows=$(simpleos_sdk_ledger_rows "$sdk_ledger" "$sdk_schema") || return 1
    while IFS=' ' read -r sdk_path sdk_digest; do
        case "$sdk_path" in ''|/*|*..*) return 1 ;; esac
        [ "$(simpleos_sdk_hash "$sdk_base/$sdk_path")" = "$sdk_digest" ] || return 1
    done <<EOF
$sdk_rows
EOF
)

simpleos_sdk_capture_inputs() (
    sdk_root=$1; sdk_arch=$2; sdk_recipe=$3; sdk_output=$4
    sdk_list=$(mktemp) || return 1
    trap 'rm -f "$sdk_list"' EXIT HUP INT TERM
    (
        cd "$sdk_root" || exit 1
        find src/os/libc -maxdepth 1 -type f \( -name '*.c' -o -name '*.h' -o -name '*.S' -o -name Makefile \)
        find src/os/libc/include -type f
        if [ "$sdk_arch" = x86_64 ] || [ "$sdk_arch" = aarch64 ] || [ "$sdk_arch" = riscv64 ]; then
            for sdk_source in runtime_native runtime_simd_utf8 runtime_contracts runtime_memory runtime_time runtime_timestamp runtime_pool runtime_memtrack runtime_legacy_core runtime_simpleos_syscall_adapters startup/baremetal/runtime_log; do
                printf 'src/runtime/%s.c\n' "$sdk_source"
            done
            [ "$sdk_arch" != x86_64 ] || printf '%s\n' src/runtime/startup/baremetal/runtime_port_io.c
            find src/runtime -type d -name vendor -prune -o -type f -name '*.h' ! -name miniaudio.h ! -name stb_image.h ! -name stb_truetype.h -print
        fi
        printf '%s\n' "$sdk_recipe" scripts/check/lib/simpleos-sysroot-receipt.shs
    ) | LC_ALL=C sort -u > "$sdk_list"
    simpleos_sdk_ledger "$sdk_root" "$sdk_list" "$sdk_output" simpleos-sdk-inputs-v1
)

simpleos_sdk_write() (
    # ROOT SYSROOT ARCH RECIPE CC AR FLAGS_FILE PREBUILD_INPUTS
    sdk_root=$1; sdk_sysroot=$2; sdk_arch=$3; sdk_recipe=$4
    sdk_cc=$(command -v "$5") || return 1
    sdk_ar=$(command -v "$6") || return 1
    sdk_flags=$7; sdk_prebuild=$8
    sdk_profile=$(simpleos_sdk_profile "$sdk_arch") || return 1
    sdk_triple=$(printf '%s\n' "$sdk_profile" | sed -n '1p')
    sdk_stdio=$(printf '%s\n' "$sdk_profile" | sed -n '2p')
    sdk_owner=scripts/check/lib/simpleos-sysroot-receipt.shs
    sdk_meta=$sdk_sysroot/share/simpleos
    mkdir -p "$sdk_meta" || return 1
    sdk_tmp=$(mktemp -d "$sdk_meta/.receipt.XXXXXX") || return 1
    trap 'rm -rf "$sdk_tmp"' EXIT HUP INT TERM
    # Inputs must be captured before compilation, and unchanged afterward.
    simpleos_sdk_capture_inputs "$sdk_root" "$sdk_arch" "$sdk_recipe" "$sdk_tmp/sysroot-inputs.sdn" || return 1
    sdk_before=$(simpleos_sdk_hash "$sdk_prebuild") || return 1
    [ "$sdk_before" = "$(simpleos_sdk_hash "$sdk_tmp/sysroot-inputs.sdn")" ] || return 1
    (
        cd "$sdk_sysroot" || exit 1
        for sdk_leaf in libsimpleos_c.a libsimpleos_all.a libsimple_runtime.a libsimple_runtime_native.a libsimple_runtime_compat.a; do
            [ ! -f "lib/$sdk_leaf" ] || printf 'lib/%s\n' "$sdk_leaf"
        done
        find lib -maxdepth 1 -type f -name '*.o'
        printf '%s\n' share/simpleos/simpleos.ld share/simpleos/target-triple.txt
    ) | LC_ALL=C sort -u > "$sdk_tmp/artifacts.list"
    simpleos_sdk_ledger "$sdk_sysroot" "$sdk_tmp/artifacts.list" "$sdk_tmp/sysroot-artifacts.sdn" simpleos-sdk-artifacts-v1 || return 1
    printf 'schema: simpleos-sdk-members-v1\nfiles:\n' > "$sdk_tmp/sysroot-members.sdn"
    while IFS= read -r sdk_archive; do
        case "$sdk_archive" in *.a) ;; *) continue ;; esac
        "$sdk_ar" t "$sdk_sysroot/$sdk_archive" > "$sdk_tmp/members.list" || return 1
        [ -z "$(LC_ALL=C sort "$sdk_tmp/members.list" | uniq -d)" ] || return 1
        while IFS= read -r sdk_member; do
            case "$sdk_member" in ''|*/*|*..*|*[!a-zA-Z0-9_.+-]*) return 1 ;; esac
            "$sdk_ar" p "$sdk_sysroot/$sdk_archive" "$sdk_member" > "$sdk_tmp/member.bin" || return 1
            sdk_digest=$(simpleos_sdk_hash "$sdk_tmp/member.bin") || return 1
            printf '  "%s/%s": "%s"\n' "$sdk_archive" "$sdk_member" "$sdk_digest" >> "$sdk_tmp/sysroot-members.sdn"
        done < "$sdk_tmp/members.list"
    done < "$sdk_tmp/artifacts.list"
    cp "$sdk_flags" "$sdk_tmp/sysroot-build-flags.txt" || return 1
    {
        printf 'schema: simpleos-sysroot-receipt-v1\nstatus: built\n'
        printf 'target: %s\ntarget_triple: %s\n' "$sdk_arch" "$sdk_triple"
        printf 'recipe_path: %s\nrecipe_sha256: "%s"\n' "$sdk_recipe" "$(simpleos_sdk_hash "$sdk_root/$sdk_recipe")"
        printf 'receipt_owner_sha256: "%s"\n' "$(simpleos_sdk_hash "$sdk_root/$sdk_owner")"
        printf 'source_inputs_sha256: "%s"\n' "$(simpleos_sdk_hash "$sdk_tmp/sysroot-inputs.sdn")"
        printf 'artifacts_sha256: "%s"\n' "$(simpleos_sdk_hash "$sdk_tmp/sysroot-artifacts.sdn")"
        printf 'members_sha256: "%s"\n' "$(simpleos_sdk_hash "$sdk_tmp/sysroot-members.sdn")"
        printf 'compiler_path: "%s"\ncompiler_sha256: "%s"\n' "$(printf '%s' "$sdk_cc" | tr '\\' '/')" "$(simpleos_sdk_hash "$sdk_cc" tool)"
        printf 'archiver_path: "%s"\narchiver_sha256: "%s"\n' "$(printf '%s' "$sdk_ar" | tr '\\' '/')" "$(simpleos_sdk_hash "$sdk_ar" tool)"
        printf 'flags_sha256: "%s"\n' "$(simpleos_sdk_hash "$sdk_tmp/sysroot-build-flags.txt")"
        printf 'crt0_sha256: "%s"\n' "$(simpleos_sdk_hash "$sdk_sysroot/lib/crt0.o")"
        printf 'libc_sha256: "%s"\n' "$(simpleos_sdk_hash "$sdk_sysroot/lib/libsimpleos_c.a")"
        printf 'stdio_source_profile: %s\nruntime_qualification: none\n' "$sdk_stdio"
    } > "$sdk_tmp/sysroot-receipt.sdn" || return 1
    simpleos_sdk_verify "$sdk_root" "$sdk_sysroot" "$sdk_arch" "$sdk_tmp" || return 1
    # A partial generation is never reusable. The receipt is published last.
    for sdk_leaf in sysroot-inputs.sdn sysroot-artifacts.sdn sysroot-members.sdn sysroot-build-flags.txt; do
        mv "$sdk_tmp/$sdk_leaf" "$sdk_meta/$sdk_leaf" || return 1
    done
    mv "$sdk_tmp/sysroot-receipt.sdn" "$sdk_meta/sysroot-receipt.sdn" || return 1
    simpleos_sdk_verify "$sdk_root" "$sdk_sysroot" "$sdk_arch"
)

simpleos_sdk_verify() (
    sdk_root=$1; sdk_sysroot=$2; sdk_arch=$3
    sdk_profile=$(simpleos_sdk_profile "$sdk_arch") || return 1
    sdk_meta=${4:-$sdk_sysroot/share/simpleos}
    sdk_receipt=$sdk_meta/sysroot-receipt.sdn
    [ -f "$sdk_receipt" ] && [ ! -L "$sdk_receipt" ] || return 1
    [ "$(wc -c < "$sdk_receipt" | tr -d ' ')" -le 32768 ] || return 1
    awk 'BEGIN { keys=" schema status target target_triple recipe_path recipe_sha256 receipt_owner_sha256 source_inputs_sha256 artifacts_sha256 members_sha256 compiler_path compiler_sha256 archiver_path archiver_sha256 flags_sha256 crt0_sha256 libc_sha256 stdio_source_profile runtime_qualification " }
        { key=$0; sub(/:.*/,"",key)
          if(index(keys," " key " ")==0 || seen[key]++ || $0 !~ /^[a-z_0-9]+: .+$/ || length($0)>4130) exit 1
          count++ }
        END { if(count!=19) exit 1 }' "$sdk_receipt" || return 1
    for sdk_key in recipe_sha256 receipt_owner_sha256 source_inputs_sha256 artifacts_sha256 members_sha256 compiler_sha256 archiver_sha256 flags_sha256 crt0_sha256 libc_sha256; do
        sdk_digest=$(simpleos_sdk_field "$sdk_receipt" "$sdk_key") || return 1
        [ "${#sdk_digest}" -eq 64 ] || return 1
        case "$sdk_digest" in *[!0-9a-f]*) return 1 ;; esac
    done
    [ "$(simpleos_sdk_field "$sdk_receipt" schema)" = simpleos-sysroot-receipt-v1 ] &&
    [ "$(simpleos_sdk_field "$sdk_receipt" status)" = built ] &&
    [ "$(simpleos_sdk_field "$sdk_receipt" target)" = "$sdk_arch" ] &&
    [ "$(simpleos_sdk_field "$sdk_receipt" target_triple)" = "$(printf '%s\n' "$sdk_profile" | sed -n '1p')" ] &&
    [ "$(simpleos_sdk_field "$sdk_receipt" stdio_source_profile)" = "$(printf '%s\n' "$sdk_profile" | sed -n '2p')" ] &&
    [ "$(simpleos_sdk_field "$sdk_receipt" runtime_qualification)" = none ] || return 1
    [ "$(cat "$sdk_sysroot/share/simpleos/target-triple.txt")" = "$(simpleos_sdk_field "$sdk_receipt" target_triple)" ] &&
    [ "$(wc -l < "$sdk_sysroot/share/simpleos/target-triple.txt" | tr -d ' ')" = 1 ] &&
    simpleos_sdk_object_target_ok "$sdk_sysroot/lib/crt0.o" "$sdk_arch" || return 1
    sdk_recipe=$(simpleos_sdk_field "$sdk_receipt" recipe_path) || return 1
    case "$sdk_arch:$sdk_recipe" in
        x86_64:src/os/port/llvm/sysroot.shs|aarch64:src/os/port/llvm/sysroot.shs|aarch64:scripts/os/simpleos-sysroot-aarch64.shs|riscv64:scripts/os/simpleos-sysroot-riscv64.shs|i686:scripts/os/simpleos-sysroot-32.shs|arm32:scripts/os/simpleos-sysroot-32.shs|riscv32:scripts/os/simpleos-sysroot-32.shs) ;;
        *) return 1 ;;
    esac
    [ "$(simpleos_sdk_hash "$sdk_root/$sdk_recipe")" = "$(simpleos_sdk_field "$sdk_receipt" recipe_sha256)" ] &&
    [ "$(simpleos_sdk_hash "$sdk_root/scripts/check/lib/simpleos-sysroot-receipt.shs")" = "$(simpleos_sdk_field "$sdk_receipt" receipt_owner_sha256)" ] &&
    [ "$(simpleos_sdk_hash "$sdk_meta/sysroot-inputs.sdn")" = "$(simpleos_sdk_field "$sdk_receipt" source_inputs_sha256)" ] &&
    [ "$(simpleos_sdk_hash "$sdk_meta/sysroot-artifacts.sdn")" = "$(simpleos_sdk_field "$sdk_receipt" artifacts_sha256)" ] &&
    [ "$(simpleos_sdk_hash "$sdk_meta/sysroot-members.sdn")" = "$(simpleos_sdk_field "$sdk_receipt" members_sha256)" ] &&
    [ "$(simpleos_sdk_hash "$sdk_meta/sysroot-build-flags.txt")" = "$(simpleos_sdk_field "$sdk_receipt" flags_sha256)" ] &&
    [ "$(simpleos_sdk_hash "$sdk_sysroot/lib/crt0.o")" = "$(simpleos_sdk_field "$sdk_receipt" crt0_sha256)" ] &&
    [ "$(simpleos_sdk_hash "$sdk_sysroot/lib/libsimpleos_c.a")" = "$(simpleos_sdk_field "$sdk_receipt" libc_sha256)" ] || return 1
    sdk_input_rows=$(simpleos_sdk_ledger_rows "$sdk_meta/sysroot-inputs.sdn" simpleos-sdk-inputs-v1) || return 1
    sdk_artifact_rows=$(simpleos_sdk_ledger_rows "$sdk_meta/sysroot-artifacts.sdn" simpleos-sdk-artifacts-v1) || return 1
    sdk_member_rows=$(simpleos_sdk_ledger_rows "$sdk_meta/sysroot-members.sdn" simpleos-sdk-members-v1) || return 1
    for sdk_required in src/os/libc/simpleos_libc.c "$sdk_recipe" scripts/check/lib/simpleos-sysroot-receipt.shs; do
        simpleos_sdk_field "$sdk_meta/sysroot-inputs.sdn" "  \"$sdk_required\"" >/dev/null || return 1
    done
    for sdk_required in lib/crt0.o lib/libsimpleos_c.a share/simpleos/simpleos.ld share/simpleos/target-triple.txt; do
        simpleos_sdk_field "$sdk_meta/sysroot-artifacts.sdn" "  \"$sdk_required\"" >/dev/null || return 1
    done
    if [ "$sdk_arch" = x86_64 ]; then sdk_runtime=lib/libsimple_runtime.a; else sdk_runtime=lib/libsimpleos_all.a; fi
    simpleos_sdk_field "$sdk_meta/sysroot-artifacts.sdn" "  \"$sdk_runtime\"" >/dev/null || return 1
    if [ -n "${5:-}" ]; then
        # Explicit caller input: validate/hash actual bytes, never claim SDK ownership.
        [ -f "$5" ] && [ ! -L "$5" ] || return 1
        [ "$(wc -c < "$5")" -le 2097152 ] || return 1
        sdk_script_digest=$(simpleos_sdk_hash "$5") || return 1
        [ "$(simpleos_sdk_hash "$5")" = "$sdk_script_digest" ] || return 1
    fi
    while IFS=' ' read -r sdk_path sdk_digest; do
        case "$sdk_path" in src/os/libc/*|src/runtime/*|"$sdk_recipe"|scripts/check/lib/simpleos-sysroot-receipt.shs) ;; *) return 1 ;; esac
    done <<EOF
$sdk_input_rows
EOF
    while IFS=' ' read -r sdk_path sdk_digest; do
        case "$sdk_path" in lib/*|share/simpleos/simpleos.ld|share/simpleos/target-triple.txt) ;; *) return 1 ;; esac
        case "$sdk_path" in *.a)
            awk -v prefix="  \"$sdk_path/" 'index($0,prefix)==1 {found=1} END {if(!found)exit 1}' "$sdk_meta/sysroot-members.sdn" || return 1 ;;
        esac
    done <<EOF
$sdk_artifact_rows
EOF
    while IFS=' ' read -r sdk_member sdk_digest; do
        case "$sdk_member" in *.a/*) ;; *) return 1 ;; esac
        sdk_archive=${sdk_member%%.a/*}.a
        sdk_leaf=${sdk_member#*.a/}
        case "$sdk_leaf" in ''|*/*) return 1 ;; esac
        simpleos_sdk_field "$sdk_meta/sysroot-artifacts.sdn" "  \"$sdk_archive\"" >/dev/null || return 1
    done <<EOF
$sdk_member_rows
EOF
    simpleos_sdk_verify_ledger "$sdk_root" "$sdk_meta/sysroot-inputs.sdn" simpleos-sdk-inputs-v1 &&
        simpleos_sdk_verify_ledger "$sdk_sysroot" "$sdk_meta/sysroot-artifacts.sdn" simpleos-sdk-artifacts-v1
)

simpleos_sdk_verify_builder() (
    # Builder reuse is stricter than SDK consumption: current tools and flags.
    simpleos_sdk_verify "$1" "$2" "$3" || return 1
    sdk_receipt=$2/share/simpleos/sysroot-receipt.sdn
    sdk_cc=$(command -v "$4") && sdk_ar=$(command -v "$5") || return 1
    [ "$(simpleos_sdk_hash "$sdk_cc" tool)" = "$(simpleos_sdk_field "$sdk_receipt" compiler_sha256)" ] &&
    [ "$(simpleos_sdk_hash "$sdk_ar" tool)" = "$(simpleos_sdk_field "$sdk_receipt" archiver_sha256)" ] &&
    [ "$(simpleos_sdk_hash "$6")" = "$(simpleos_sdk_field "$sdk_receipt" flags_sha256)" ]
)
