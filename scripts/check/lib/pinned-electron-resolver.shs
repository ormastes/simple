#!/bin/sh
# Resolve only the exact Electron package installed for tools/electron-shell.
# Callers set ELECTRON_RESOLVER_ROOT to their repository root before sourcing.

ELECTRON_RESOLVER_ROOT="${ELECTRON_RESOLVER_ROOT:-${ROOT_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)}}"
ELECTRON_RESOLVER_REASON=""
ELECTRON_RESOLVED_BIN=""
ELECTRON_EXPECTED_VERSION=""

electron_json_dependency_version() {
    json_path="$1"
    [ -f "$json_path" ] || return 1
    awk '
        /"electron"[[:space:]]*:/ {
            value = $0
            sub(/.*"electron"[[:space:]]*:[[:space:]]*"/, "", value)
            sub(/".*/, "", value)
            print value
            exit
        }
    ' "$json_path"
}

electron_pinned_version() {
    lock_path="$ELECTRON_RESOLVER_ROOT/tools/electron-shell/package-lock.json"
    [ -f "$lock_path" ] || return 1
    awk '
        /"node_modules\/electron"[[:space:]]*:[[:space:]]*\{/ { in_electron = 1; next }
        in_electron && /"version"[[:space:]]*:/ {
            value = $0
            sub(/.*"version"[[:space:]]*:[[:space:]]*"/, "", value)
            sub(/".*/, "", value)
            print value
            exit
        }
        in_electron && /^[[:space:]]*}[,]?[[:space:]]*$/ { exit }
    ' "$lock_path"
}

electron_installed_version() {
    package_path="$ELECTRON_RESOLVER_ROOT/tools/electron-shell/node_modules/electron/package.json"
    [ -f "$package_path" ] || return 1
    awk '
        /"version"[[:space:]]*:/ {
            value = $0
            sub(/.*"version"[[:space:]]*:[[:space:]]*"/, "", value)
            sub(/".*/, "", value)
            print value
            exit
        }
    ' "$package_path"
}

resolve_electron_bin() {
    ELECTRON_RESOLVER_REASON=""
    ELECTRON_RESOLVED_BIN=""
    ELECTRON_EXPECTED_VERSION="$(electron_pinned_version || true)"
    manifest_version="$(electron_json_dependency_version "$ELECTRON_RESOLVER_ROOT/tools/electron-shell/package.json" || true)"
    lock_root_version="$(electron_json_dependency_version "$ELECTRON_RESOLVER_ROOT/tools/electron-shell/package-lock.json" || true)"
    installed_package="$ELECTRON_RESOLVER_ROOT/tools/electron-shell/node_modules/electron/package.json"
    [ -f "$installed_package" ] || {
        ELECTRON_RESOLVER_REASON="missing-pinned-electron"
        return 1
    }
    installed_version="$(electron_installed_version || true)"
    case "$ELECTRON_EXPECTED_VERSION:$manifest_version:$lock_root_version:$installed_version" in
        42.5.0:42.5.0:42.5.0:42.5.0) ;;
        *)
            ELECTRON_RESOLVER_REASON="electron-version-mismatch"
            return 1
            ;;
    esac

    [ -z "${ELECTRON_BIN:-}" ] || {
        ELECTRON_RESOLVER_REASON="invalid-electron-command"
        return 1
    }
    resolver_root="$(CDPATH= cd -- "$ELECTRON_RESOLVER_ROOT" && pwd -P)" || {
        ELECTRON_RESOLVER_REASON="invalid-electron-command"
        return 1
    }
    node_modules_dir="$ELECTRON_RESOLVER_ROOT/tools/electron-shell/node_modules"
    bin_dir="$node_modules_dir/.bin"
    [ ! -L "$node_modules_dir" ] && [ ! -L "$bin_dir" ] || {
        ELECTRON_RESOLVER_REASON="invalid-electron-command"
        return 1
    }
    expected_node_modules="$resolver_root/tools/electron-shell/node_modules"
    actual_node_modules="$(CDPATH= cd -- "$node_modules_dir" && pwd -P)" || {
        ELECTRON_RESOLVER_REASON="missing-pinned-electron"
        return 1
    }
    actual_bin_dir="$(CDPATH= cd -- "$bin_dir" && pwd -P)" || {
        ELECTRON_RESOLVER_REASON="missing-pinned-electron"
        return 1
    }
    [ "$actual_node_modules" = "$expected_node_modules" ] && [ "$actual_bin_dir" = "$expected_node_modules/.bin" ] || {
        ELECTRON_RESOLVER_REASON="invalid-electron-command"
        return 1
    }
    candidate="$bin_dir/electron"
    [ -L "$candidate" ] || {
        ELECTRON_RESOLVER_REASON="missing-pinned-electron"
        return 1
    }
    [ "$(readlink "$candidate")" = "../electron/cli.js" ] || {
        ELECTRON_RESOLVER_REASON="invalid-electron-command"
        return 1
    }
    electron_package_dir="$ELECTRON_RESOLVER_ROOT/tools/electron-shell/node_modules/electron"
    [ ! -L "$electron_package_dir" ] || {
        ELECTRON_RESOLVER_REASON="invalid-electron-command"
        return 1
    }
    target_dir="$(CDPATH= cd -- "$(dirname -- "$candidate")/../electron" && pwd -P)" || {
        ELECTRON_RESOLVER_REASON="invalid-electron-command"
        return 1
    }
    expected_target="$(CDPATH= cd -- "$electron_package_dir" && pwd -P)/cli.js" || {
        ELECTRON_RESOLVER_REASON="missing-pinned-electron"
        return 1
    }
    [ "$target_dir/cli.js" = "$expected_target" ] && [ ! -L "$expected_target" ] && [ -f "$expected_target" ] && [ -x "$expected_target" ] || {
        ELECTRON_RESOLVER_REASON="invalid-electron-command"
        return 1
    }

    ELECTRON_RESOLVED_BIN="$candidate"
    actual_version="$("$ELECTRON_RESOLVED_BIN" --version 2>/dev/null)" || {
        ELECTRON_RESOLVER_REASON="invalid-electron-command"
        return 1
    }
    case "$actual_version" in
        42.5.0|v42.5.0) ;;
        *)
            ELECTRON_RESOLVER_REASON="electron-version-mismatch"
            return 1
            ;;
    esac
}
