bootstrap_stage3_write_command_transcript() {
    bootstrap_stage3_transcript=$1
    bootstrap_stage3_command_cwd=$2
    bootstrap_stage3_command_home=$3
    bootstrap_stage3_command_tmpdir=$4
    bootstrap_stage3_command_path=$5
    shift 5
    [ -d "$bootstrap_stage3_command_cwd" ] &&
        [ ! -L "$bootstrap_stage3_command_cwd" ] &&
        [ "$(bootstrap_stage3_canonical_path \
            "$bootstrap_stage3_command_cwd")" = \
            "$bootstrap_stage3_command_cwd" ] || return 1
    bootstrap_stage3_transcript_tmp="${bootstrap_stage3_transcript}.tmp.$$"
    (
        echo "schema=simple-bootstrap-command-transcript-v2"
        printf 'cwd:%s:%s\n' "${#bootstrap_stage3_command_cwd}" \
            "$bootstrap_stage3_command_cwd"
        for bootstrap_stage3_host_env in \
            "HOME=$bootstrap_stage3_command_home" \
            "PATH=$bootstrap_stage3_command_path" \
            "TMPDIR=$bootstrap_stage3_command_tmpdir" \
            "LC_ALL=C" "LANG=C"; do
            case "$bootstrap_stage3_host_env" in
                *'
'*) exit 1 ;;
            esac
            printf 'host-env:%s:%s\n' "${#bootstrap_stage3_host_env}" \
                "$bootstrap_stage3_host_env"
        done
        bootstrap_stage3_seen_env=:
        while [ "$#" -gt 0 ] && [ "$1" != -- ]; do
            case "$1" in
                *'
'*) exit 1 ;;
                [A-Z_][A-Z0-9_]*=*) ;;
                *) exit 1 ;;
            esac
            bootstrap_stage3_env_name=${1%%=*}
            case "$bootstrap_stage3_seen_env" in
                *":$bootstrap_stage3_env_name:"*) exit 1 ;;
            esac
            bootstrap_stage3_seen_env=\
"$bootstrap_stage3_seen_env$bootstrap_stage3_env_name:"
            printf 'explicit-env:%s:%s\n' "${#1}" "$1"
            shift
        done
        [ "${1-}" = -- ] || exit 1
        shift
        [ "$#" -gt 0 ] || exit 1
        case "$1" in
            *'
'*) exit 1 ;;
        esac
        printf 'executable:%s:%s\n' "${#1}" "$1"
        shift
        for bootstrap_stage3_command_arg in "$@"; do
            case "$bootstrap_stage3_command_arg" in
                *'
'*) exit 1 ;;
            esac
            printf 'argv:%s:%s\n' "${#bootstrap_stage3_command_arg}" \
                "$bootstrap_stage3_command_arg"
        done
    ) >"$bootstrap_stage3_transcript_tmp" || {
        rm -f "$bootstrap_stage3_transcript_tmp"
        return 1
    }
    mv "$bootstrap_stage3_transcript_tmp" "$bootstrap_stage3_transcript"
}

bootstrap_stage3_verify_command_transcript() {
    bootstrap_stage3_transcript=$1
    bootstrap_stage3_command_cwd=$2
    shift 2
    [ -f "$bootstrap_stage3_transcript" ] &&
        [ ! -L "$bootstrap_stage3_transcript" ] || return 1
    bootstrap_stage3_expected="${bootstrap_stage3_transcript}.expected.$$"
    bootstrap_stage3_host="${bootstrap_stage3_transcript}.host.$$"
    # Inherited records are forbidden: the producer executes with env -i.
    ! grep -Eq '^inherited-env:' "$bootstrap_stage3_transcript" || return 1
    grep '^host-env:' "$bootstrap_stage3_transcript" \
        >"$bootstrap_stage3_host" || {
        rm -f "$bootstrap_stage3_expected" "$bootstrap_stage3_host"
        return 1
    }
    [ "$(wc -l <"$bootstrap_stage3_host" | tr -d ' ')" = 5 ] || {
        rm -f "$bootstrap_stage3_expected" "$bootstrap_stage3_host"
        return 1
    }
    awk -F: '
        function valid(record, declared, payload) {
            payload = substr(record, index(record, $3))
            return declared == length(payload)
        }
        /^host-env:[0-9]+:(HOME|PATH|TMPDIR)=/ {
            if (!valid($0, $2)) exit 1
            name = $3
            sub(/=.*/, "", name)
            seen[name]++
            next
        }
        /^host-env:[0-9]+:(LC_ALL|LANG)=C$/ {
            if (!valid($0, $2)) exit 1
            name = $3
            sub(/=.*/, "", name)
            seen[name]++
            next
        }
        { exit 1 }
        END {
            if (seen["HOME"] != 1 || seen["PATH"] != 1 ||
                seen["TMPDIR"] != 1 || seen["LC_ALL"] != 1 ||
                seen["LANG"] != 1) exit 1
        }
    ' "$bootstrap_stage3_host" || {
        rm -f "$bootstrap_stage3_expected" "$bootstrap_stage3_host"
        return 1
    }
    bootstrap_stage3_recorded_home=$(
        sed -n 's/^host-env:[0-9][0-9]*:HOME=//p' \
            "$bootstrap_stage3_host"
    ) || return 1
    bootstrap_stage3_recorded_tmpdir=$(
        sed -n 's/^host-env:[0-9][0-9]*:TMPDIR=//p' \
            "$bootstrap_stage3_host"
    ) || return 1
    bootstrap_stage3_recorded_path=$(
        sed -n 's/^host-env:[0-9][0-9]*:PATH=//p' \
            "$bootstrap_stage3_host"
    ) || return 1
    for bootstrap_stage3_recorded_directory in \
        "$bootstrap_stage3_recorded_home" "$bootstrap_stage3_recorded_tmpdir"; do
        [ -d "$bootstrap_stage3_recorded_directory" ] &&
            [ ! -L "$bootstrap_stage3_recorded_directory" ] &&
            [ "$(bootstrap_stage3_canonical_path \
                "$bootstrap_stage3_recorded_directory")" = \
                "$bootstrap_stage3_recorded_directory" ] || {
            rm -f "$bootstrap_stage3_expected" "$bootstrap_stage3_host"
            return 1
        }
    done
    case "$bootstrap_stage3_recorded_path" in
        /*) ;;
        *)
            rm -f "$bootstrap_stage3_expected" "$bootstrap_stage3_host"
            return 1
            ;;
    esac
    if printf '%s\n' "$bootstrap_stage3_recorded_path" |
        grep -Eq '(^|:)([^/]|$)'; then
        rm -f "$bootstrap_stage3_expected" "$bootstrap_stage3_host"
        return 1
    fi
    (
        echo "schema=simple-bootstrap-command-transcript-v2"
        printf 'cwd:%s:%s\n' "${#bootstrap_stage3_command_cwd}" \
            "$bootstrap_stage3_command_cwd"
        cat "$bootstrap_stage3_host" || exit 1
        while [ "$#" -gt 0 ] && [ "$1" != -- ]; do
            printf 'explicit-env:%s:%s\n' "${#1}" "$1"
            shift
        done
        [ "${1-}" = -- ] || exit 1
        shift
        [ "$#" -gt 0 ] || exit 1
        printf 'executable:%s:%s\n' "${#1}" "$1"
        shift
        for bootstrap_stage3_command_arg in "$@"; do
            printf 'argv:%s:%s\n' "${#bootstrap_stage3_command_arg}" \
                "$bootstrap_stage3_command_arg"
        done
    ) >"$bootstrap_stage3_expected" || {
        rm -f "$bootstrap_stage3_expected" "$bootstrap_stage3_host"
        return 1
    }
    cmp -s "$bootstrap_stage3_expected" "$bootstrap_stage3_transcript"
    bootstrap_stage3_transcript_status=$?
    rm -f "$bootstrap_stage3_expected" "$bootstrap_stage3_host"
    return "$bootstrap_stage3_transcript_status"
}

bootstrap_stage3_run_transcribed() {
    bootstrap_stage3_run_transcript=$1
    bootstrap_stage3_run_cwd=$2
    bootstrap_stage3_run_log=$3
    bootstrap_stage3_run_home=$4
    bootstrap_stage3_run_tmpdir=$5
    bootstrap_stage3_run_path=$6
    shift 6
    for bootstrap_stage3_run_directory in "$bootstrap_stage3_run_home" \
        "$bootstrap_stage3_run_tmpdir"; do
        [ -d "$bootstrap_stage3_run_directory" ] &&
            [ ! -L "$bootstrap_stage3_run_directory" ] &&
            [ "$(bootstrap_stage3_canonical_path \
                "$bootstrap_stage3_run_directory")" = \
                "$bootstrap_stage3_run_directory" ] || return 1
    done
    case "$bootstrap_stage3_run_path" in
        /*) ;;
        *) return 1 ;;
    esac
    printf '%s\n' "$bootstrap_stage3_run_path" |
        grep -Eq '(^|:)([^/]|$)' && return 1
    bootstrap_stage3_write_command_transcript \
        "$bootstrap_stage3_run_transcript" "$bootstrap_stage3_run_cwd" \
        "$bootstrap_stage3_run_home" "$bootstrap_stage3_run_tmpdir" \
        "$bootstrap_stage3_run_path" \
        "$@" || return 1
    bootstrap_stage3_run_transcript_sha_before=$(
        bootstrap_stage3_hash_file "$bootstrap_stage3_run_transcript"
    ) || return 1
    (
        cd "$bootstrap_stage3_run_cwd" || exit 1
        env -i "HOME=$bootstrap_stage3_run_home" \
            "PATH=$bootstrap_stage3_run_path" \
            "TMPDIR=$bootstrap_stage3_run_tmpdir" \
            "LC_ALL=C" "LANG=C" /bin/sh -c '
                while [ "$#" -gt 0 ] && [ "$1" != -- ]; do
                    export "$1" || exit 1
                    shift
                done
                [ "${1-}" = -- ] || exit 1
                shift
                [ "$#" -gt 0 ] || exit 1
                exec "$@"
            ' sh "$@"
    ) >"$bootstrap_stage3_run_log" 2>&1
    bootstrap_stage3_run_status=$?
    bootstrap_stage3_run_transcript_sha_after=$(
        bootstrap_stage3_hash_file "$bootstrap_stage3_run_transcript"
    ) || return 1
    [ "$bootstrap_stage3_run_transcript_sha_before" = \
        "$bootstrap_stage3_run_transcript_sha_after" ] || return 125
    bootstrap_stage3_verify_command_transcript \
        "$bootstrap_stage3_run_transcript" "$bootstrap_stage3_run_cwd" \
        "$@" || return 125
    return "$bootstrap_stage3_run_status"
}

bootstrap_stage3_transcript_host_value() {
    bootstrap_stage3_host_transcript=$1
    bootstrap_stage3_host_name=$2
    bootstrap_stage3_host_count=$(
        grep -c "^host-env:[0-9][0-9]*:${bootstrap_stage3_host_name}=" \
            "$bootstrap_stage3_host_transcript" || true
    )
    [ "$bootstrap_stage3_host_count" = 1 ] || return 1
    sed -n \
        "s/^host-env:[0-9][0-9]*:${bootstrap_stage3_host_name}=//p" \
        "$bootstrap_stage3_host_transcript"
}

# Return one explicitly recorded environment value after checking that the
# transcript contains exactly one well-formed, length-prefixed record for it.
bootstrap_stage3_transcript_explicit_env_value() {
    bootstrap_stage3_explicit_transcript=$1
    bootstrap_stage3_explicit_name=$2
    case "$bootstrap_stage3_explicit_name" in
        ''|[0-9]*|*[!A-Z0-9_]*) return 1 ;;
        *) ;;
    esac
    bootstrap_stage3_explicit_record=$(
        grep "^explicit-env:[0-9][0-9]*:${bootstrap_stage3_explicit_name}=" \
            "$bootstrap_stage3_explicit_transcript" || true
    )
    [ -n "$bootstrap_stage3_explicit_record" ] &&
        [ "$(printf '%s\n' "$bootstrap_stage3_explicit_record" | wc -l | tr -d ' ')" = 1 ] ||
        return 1
    bootstrap_stage3_explicit_declared=${bootstrap_stage3_explicit_record#explicit-env:}
    bootstrap_stage3_explicit_declared=${bootstrap_stage3_explicit_declared%%:*}
    bootstrap_stage3_explicit_payload=${bootstrap_stage3_explicit_record#*:*:}
    [ "${#bootstrap_stage3_explicit_payload}" = \
        "$bootstrap_stage3_explicit_declared" ] || return 1
    printf '%s\n' "${bootstrap_stage3_explicit_payload#*=}"
}

# Return the argv record immediately following one exact option. Every argv
# row is length-prefixed; reject malformed, missing, duplicate, or terminal
# options so recovery never guesses at an admitted command.
bootstrap_stage3_transcript_argv_value_after() {
    [ "$#" = 2 ] || return 1
    awk -v wanted="$2" '
        BEGIN { waiting = 0; found = 0 }
        /^argv:[0-9]+:/ {
            declared = $0
            sub(/^argv:/, "", declared)
            sub(/:.*/, "", declared)
            payload = $0
            sub(/^argv:[0-9]+:/, "", payload)
            if (length(payload) != declared) exit 2
            if (waiting) {
                print payload
                waiting = 0
                found++
                next
            }
            if (payload == wanted) waiting = 1
        }
        END { if (waiting || found != 1) exit 1 }
    ' "$1"
}

# One independent byte/link-target pass. The public wrapper performs this
# twice and accepts only byte-identical, independently hashed results.
bootstrap_stage3_source_snapshot_once() {
    bootstrap_stage3_snapshot=$1
    bootstrap_stage3_root=$2
    bootstrap_stage3_tmp="${bootstrap_stage3_snapshot}.tmp.$$"
    perl -MDigest::SHA=sha256_hex -MFile::Find -MFcntl=O_RDONLY -e '
        use strict;
        use warnings;
        my ($root, @roots) = @ARGV;
        sub lexical_absolute {
            my ($base, $path) = @_;
            my $joined = $path =~ m{^/} ? $path : "$base/$path";
            my @normalized;
            for my $part (split m{/+}, $joined) {
                next if $part eq "" || $part eq ".";
                if ($part eq "..") {
                    @normalized or die "link escapes filesystem root\n";
                    pop @normalized;
                    next;
                }
                push @normalized, $part;
            }
            return "/" . join("/", @normalized);
        }
        sub pruned_path {
            return $_[0] =~ m{/src/app/vscode_extension/(?:[.]vscode-test|node_modules)(?:/|$)};
        }
        sub canonical_missing {
            my ($path) = @_;
            my @suffix;
            my $cursor = $path;
            while (!lstat($cursor)) {
                $cursor =~ m{^(.*)/([^/]+)$} or die "missing target path\n";
                unshift @suffix, $2;
                $cursor = $1 eq "" ? "/" : $1;
            }
            grep { $_ eq "." || $_ eq ".." } @suffix and
                die "ambiguous missing target path\n";
            my $base = Cwd::abs_path($cursor);
            defined($base) && (!@suffix || -d $base)
                or die "invalid missing target parent\n";
            return lexical_absolute($base, join("/", @suffix));
        }
        sub identity {
            my (@stat) = @_;
            return join(":", @stat[0, 1, 2, 7, 9, 10]);
        }
        sub read_regular {
            my ($path) = @_;
            my @path_before = lstat($path);
            @path_before && !-l _ && -f _
                or die "source file type changed\n";
            my $flags = O_RDONLY;
            my $no_follow = eval { Fcntl::O_NOFOLLOW() } || 0;
            $flags |= $no_follow;
            sysopen(my $fh, $path, $flags) or die "open\n";
            binmode($fh, ":raw") or die "binmode\n";
            my @fd_before = stat($fh);
            @fd_before && -f $fh &&
                $path_before[0] == $fd_before[0] &&
                $path_before[1] == $fd_before[1]
                or die "source file identity changed\n";
            local $/;
            my $bytes = <$fh>;
            defined($bytes) or die "read\n";
            my @fd_after = stat($fh);
            identity(@fd_before) eq identity(@fd_after)
                or die "source file changed while reading\n";
            close $fh or die "close\n";
            my @path_after = lstat($path);
            @path_after &&
                identity(@path_before) eq identity(@path_after)
                or die "source path changed while reading\n";
            return ($bytes, identity(@path_after));
        }
        my @records;
        my @links;
        my @missing_links;
        my %direct_hash;
        my %direct_identity;
        my @owned = map { "$root/$_" } @roots;
        for my $relative_root (@roots) {
            my $authority = "$root/$relative_root";
            -d $authority or die "missing authority root\n";
            find(
                {
                    no_chdir => 1,
                    wanted => sub {
                        my $absolute = $File::Find::name;
                        if (pruned_path($absolute)) {
                            $File::Find::prune = 1 if -d $absolute;
                            return;
                        }
                        if (-l $absolute) {
                            my $link_text = readlink($absolute);
                            defined($link_text) or die "readlink\n";
                            require Cwd;
                            my $parent = $absolute;
                            $parent =~ s{/[^/]+$}{};
                            my $target_path = $link_text =~ m{^/}
                                ? $link_text : "$parent/$link_text";
                            if (!lstat($target_path)) {
                                my $missing =
                                    canonical_missing($target_path);
                                index($missing, "$root/") == 0 &&
                                    !pruned_path($missing)
                                    or die "external missing authority symlink\n";
                                my $relative = substr(
                                    $absolute, length($root) + 1
                                );
                                my $missing_relative = substr(
                                    $missing, length($root) + 1
                                );
                                push @missing_links, [
                                    $absolute, $link_text, $target_path,
                                    $missing, $relative, $missing_relative
                                ];
                                return;
                            }
                            my $resolved = Cwd::abs_path($target_path);
                            defined($resolved) &&
                                (-f $resolved || -d $resolved) &&
                                !-l $resolved
                                or die "invalid authority symlink\n";
                            my $inside = 0;
                            for my $owned_root (@owned) {
                                if ($resolved eq $owned_root ||
                                    index($resolved, "$owned_root/") == 0) {
                                    $inside = 1;
                                    last;
                                }
                            }
                            $inside or die "external authority symlink\n";
                            my $relative = substr(
                                $absolute, length($root) + 1
                            );
                            my $resolved_relative = substr(
                                $resolved, length($root) + 1
                            );
                            my $kind = -d $resolved ? "dir" : "file";
                            push @links, [
                                $absolute, $link_text, $target_path,
                                $resolved, $relative, $resolved_relative,
                                $kind
                            ];
                            return;
                        }
                        return unless -f $absolute;
                        my ($bytes, $file_identity) =
                            read_regular($absolute);
                        my $relative = substr($absolute, length($root) + 1);
                        my $path_hex = unpack("H*", $relative);
                        my $executable = -x $absolute ? 1 : 0;
                        my $content_hash = sha256_hex($bytes);
                        $direct_hash{$absolute} = $content_hash;
                        $direct_identity{$absolute} = $file_identity;
                        push @records, join(
                            ":", "file-hex", length($relative),
                            $path_hex, $executable, $content_hash
                        );
                    },
                },
                $authority
            );
        }
        for my $missing (@missing_links) {
            my ($absolute, $link_text, $target_path, $resolved_missing,
                $relative,
                $missing_relative) = @$missing;
            -l $absolute or die "missing authority symlink changed\n";
            my $current_text = readlink($absolute);
            defined($current_text) && $current_text eq $link_text
                or die "missing authority symlink changed\n";
            !lstat($target_path)
                or die "missing authority symlink target appeared\n";
            canonical_missing($target_path) eq $resolved_missing
                or die "missing authority symlink target changed\n";
            push @records, join(
                ":", "link-missing-hex", unpack("H*", $relative),
                unpack("H*", $link_text),
                unpack("H*", $missing_relative)
            );
        }
        for my $path (keys %direct_identity) {
            my @current = lstat($path);
            @current && !-l _ && -f _ &&
                identity(@current) eq $direct_identity{$path}
                or die "source file changed after reading\n";
        }
        for my $link (@links) {
            my ($absolute, $link_text, $target_path, $resolved, $relative,
                $resolved_relative, $kind) = @$link;
            -l $absolute or die "authority symlink changed\n";
            my $current_text = readlink($absolute);
            defined($current_text) && $current_text eq $link_text
                or die "authority symlink changed\n";
            my $current_resolved = Cwd::abs_path($target_path);
            defined($current_resolved) && $current_resolved eq $resolved
                or die "authority symlink target changed\n";
            if ($kind eq "dir") {
                -d $resolved or die "authority symlink type changed\n";
                push @records, join(
                    ":", "link-dir-hex", unpack("H*", $relative),
                    unpack("H*", $link_text),
                    unpack("H*", $resolved_relative)
                );
                next;
            }
            -f $resolved && exists($direct_hash{$resolved})
                or die "unbound authority symlink target\n";
            push @records, join(
                ":", "link-hex", unpack("H*", $relative),
                unpack("H*", $link_text),
                unpack("H*", $resolved_relative), $direct_hash{$resolved}
            );
        }
        @records or die "empty authority\n";
        print join("\n", sort @records), "\n";
    ' "$bootstrap_stage3_root" src/compiler src/app src/lib examples/10_tooling \
        >"$bootstrap_stage3_tmp" || {
        rm -f "$bootstrap_stage3_tmp"
        return 1
    }
    mv "$bootstrap_stage3_tmp" "$bootstrap_stage3_snapshot"
}

bootstrap_stage3_source_snapshot() {
    bootstrap_stage3_source_output=$1
    bootstrap_stage3_root=$2
    bootstrap_stage3_first="${bootstrap_stage3_source_output}.first.$$"
    bootstrap_stage3_second="${bootstrap_stage3_source_output}.second.$$"
    bootstrap_stage3_source_snapshot_once "$bootstrap_stage3_first" \
        "$bootstrap_stage3_root" || return 1
    bootstrap_stage3_first_sha=$(
        bootstrap_stage3_hash_file "$bootstrap_stage3_first"
    ) || {
        rm -f "$bootstrap_stage3_first" "$bootstrap_stage3_second"
        return 1
    }
    bootstrap_stage3_source_snapshot_once "$bootstrap_stage3_second" \
        "$bootstrap_stage3_root" || {
        rm -f "$bootstrap_stage3_first" "$bootstrap_stage3_second"
        return 1
    }
    bootstrap_stage3_second_sha=$(
        bootstrap_stage3_hash_file "$bootstrap_stage3_second"
    ) || {
        rm -f "$bootstrap_stage3_first" "$bootstrap_stage3_second"
        return 1
    }
    [ "$bootstrap_stage3_first_sha" = "$bootstrap_stage3_second_sha" ] &&
        cmp -s "$bootstrap_stage3_first" "$bootstrap_stage3_second" || {
        rm -f "$bootstrap_stage3_first" "$bootstrap_stage3_second"
        return 1
    }
    mv "$bootstrap_stage3_second" "$bootstrap_stage3_source_output" || {
        rm -f "$bootstrap_stage3_first" "$bootstrap_stage3_second"
        return 1
    }
    rm -f "$bootstrap_stage3_first"
}

bootstrap_stage3_manifest_value() {
    bootstrap_stage3_key=$1
    bootstrap_stage3_manifest=$2
    bootstrap_stage3_count=$(
        grep -c "^${bootstrap_stage3_key}=" "$bootstrap_stage3_manifest" ||
            true
    )
    [ "$bootstrap_stage3_count" = 1 ] || return 1
    sed -n "s/^${bootstrap_stage3_key}=//p" "$bootstrap_stage3_manifest"
}

bootstrap_stage3_verify_bound_file() {
    bootstrap_stage3_binding_manifest=$1
    bootstrap_stage3_binding_path_key=$2
    bootstrap_stage3_binding_sha_key=$3
    bootstrap_stage3_binding_path=$(
        bootstrap_stage3_manifest_value "$bootstrap_stage3_binding_path_key" \
            "$bootstrap_stage3_binding_manifest"
    ) || return 1
    [ -f "$bootstrap_stage3_binding_path" ] &&
        [ ! -L "$bootstrap_stage3_binding_path" ] || return 1
    [ "$(bootstrap_stage3_canonical_file "$bootstrap_stage3_binding_path")" = \
        "$bootstrap_stage3_binding_path" ] || return 1
    [ "$(bootstrap_stage3_manifest_value "$bootstrap_stage3_binding_sha_key" \
        "$bootstrap_stage3_binding_manifest")" = \
        "$(bootstrap_stage3_hash_file "$bootstrap_stage3_binding_path")" ]
}
