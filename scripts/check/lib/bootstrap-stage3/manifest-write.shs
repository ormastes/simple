bootstrap_stage3_write_manifest() {
    [ "$(CDPATH= cd -- "$BSTAGE3_ROOT" && pwd -P)" = "$BSTAGE3_ROOT" ] ||
        bootstrap_stage3_provenance_fail "repository-root-not-canonical" ||
        return 1
    [ "$(bootstrap_stage3_canonical_path "$BSTAGE3_MANIFEST")" = \
        "$BSTAGE3_MANIFEST" ] ||
        bootstrap_stage3_provenance_fail "manifest-path-not-canonical" ||
        return 1
    [ "$BSTAGE3_PLATFORM" = "$(bootstrap_stage3_host_platform)" ] ||
        bootstrap_stage3_provenance_fail "stage3-platform-not-host" ||
        return 1
    for bootstrap_stage3_directory in "$BSTAGE3_STAGE2_CACHE_DIR" \
        "$BSTAGE3_STAGE3_CACHE_DIR" \
        "$BSTAGE3_RUNTIME_PATH" "$BSTAGE3_LOCK"; do
        [ -d "$bootstrap_stage3_directory" ] &&
            [ ! -L "$bootstrap_stage3_directory" ] &&
            [ "$(bootstrap_stage3_canonical_path \
                "$bootstrap_stage3_directory")" = \
                "$bootstrap_stage3_directory" ] ||
            bootstrap_stage3_provenance_fail \
                "required-directory-not-canonical" ||
            return 1
    done
    [ "$BSTAGE3_STAGE2_COMMAND_OUTPUT" = "$BSTAGE3_STAGE2" ] &&
        [ "$BSTAGE3_STAGE3_COMMAND_OUTPUT" = "$BSTAGE3_STAGE3" ] ||
        bootstrap_stage3_provenance_fail "command-output-path-not-canonical" ||
        return 1
    cmp -s "$BSTAGE3_SOURCE_BEFORE" "$BSTAGE3_SOURCE_AFTER" ||
        bootstrap_stage3_provenance_fail "sources-changed-during-bootstrap" ||
        return 1
    cmp -s "$BSTAGE3_GIT_BEFORE" "$BSTAGE3_GIT_AFTER" ||
        bootstrap_stage3_provenance_fail \
            "git-head-or-dirty-state-changed-during-bootstrap" ||
        return 1
    bootstrap_stage3_script_after=$(
        bootstrap_stage3_hash_file "$BSTAGE3_BOOTSTRAP_SCRIPT"
    ) || return 1
    [ "$bootstrap_stage3_script_after" = \
        "$BSTAGE3_BOOTSTRAP_SCRIPT_SHA256_BEFORE" ] ||
        bootstrap_stage3_provenance_fail \
            "bootstrap-script-changed-during-bootstrap" ||
        return 1
    bootstrap_stage3_helper_after=$(
        bootstrap_stage3_hash_file "$BSTAGE3_HELPER"
    ) || return 1
    [ "$bootstrap_stage3_helper_after" = "$BSTAGE3_HELPER_SHA256_BEFORE" ] ||
        bootstrap_stage3_provenance_fail \
            "provenance-helper-changed-during-bootstrap" ||
        return 1
    bootstrap_stage3_helper_bundle_after=$(
        bootstrap_stage3_helper_bundle_fingerprint
    ) || return 1
    [ "$bootstrap_stage3_helper_bundle_after" = \
        "$BSTAGE3_HELPER_BUNDLE_FINGERPRINT_BEFORE" ] ||
        bootstrap_stage3_provenance_fail \
            "provenance-helper-bundle-changed-during-bootstrap" ||
        return 1

    for bootstrap_stage3_required in \
        "$BSTAGE3_SEED" "$BSTAGE3_NATIVE_ALL" "$BSTAGE3_STAGE2" \
        "$BSTAGE3_STAGE2_ADMITTED" "$BSTAGE3_STAGE3" \
        "$BSTAGE3_STAGE2_LOG" "$BSTAGE3_STAGE3_LOG" \
        "$BSTAGE3_SEED_STAMP" "$BSTAGE3_HELPER" \
        "$BSTAGE3_GIT_BEFORE" "$BSTAGE3_GIT_AFTER" \
        "$BSTAGE3_STAGE2_TRANSCRIPT" \
        "$BSTAGE3_STAGE3_TRANSCRIPT" "$BSTAGE3_STAGE2_SANITY" \
        "$BSTAGE3_STAGE3_SANITY" "$BSTAGE3_BOOTSTRAP_SCRIPT" \
        "$BSTAGE3_SOURCE_BEFORE" "$BSTAGE3_SOURCE_AFTER" \
        "$BSTAGE3_RUNTIME_ORIGIN_BEFORE" "$BSTAGE3_RUNTIME_ORIGIN_AFTER" \
        "$BSTAGE3_RUNTIME_ADMITTED_SNAPSHOT" "$BSTAGE3_TOOL_AUTHORITY"; do
        [ -f "$bootstrap_stage3_required" ] &&
            [ ! -L "$bootstrap_stage3_required" ] ||
            bootstrap_stage3_provenance_fail "required-input-missing" ||
            return 1
        [ "$(bootstrap_stage3_canonical_file "$bootstrap_stage3_required")" = \
            "$bootstrap_stage3_required" ] ||
            bootstrap_stage3_provenance_fail \
                "required-input-not-canonical" ||
            return 1
    done
    bootstrap_stage3_verify_seed_stamp "$BSTAGE3_SEED_STAMP" \
        "$BSTAGE3_SEED_INPUTS_FINGERPRINT" "$BSTAGE3_SEED" \
        "$BSTAGE3_NATIVE_ALL" "$BSTAGE3_BACKFILL" ||
        bootstrap_stage3_provenance_fail "seed-input-stamp-stale" ||
        return 1
    cmp -s "$BSTAGE3_RUNTIME_ORIGIN_BEFORE" \
        "$BSTAGE3_RUNTIME_ORIGIN_AFTER" &&
        cmp -s "$BSTAGE3_RUNTIME_ORIGIN_AFTER" \
            "$BSTAGE3_RUNTIME_ADMITTED_SNAPSHOT" ||
        bootstrap_stage3_provenance_fail \
            "runtime-authority-admission-mismatch" ||
        return 1
    bootstrap_stage3_seed_authority_path=$(
        bootstrap_stage3_transcript_host_value \
            "$BSTAGE3_STAGE2_TRANSCRIPT" PATH
    ) || return 1
    bootstrap_stage3_seed_inputs_rederived=$(
        bootstrap_stage3_seed_inputs_fingerprint "$BSTAGE3_ROOT" \
            "$BSTAGE3_BACKEND" "$BSTAGE3_SEED_FEATURES" \
            "$bootstrap_stage3_seed_authority_path" "$BSTAGE3_PLATFORM"
    ) || return 1
    [ "$bootstrap_stage3_seed_inputs_rederived" = \
        "$BSTAGE3_SEED_INPUTS_FINGERPRINT" ] ||
        bootstrap_stage3_provenance_fail \
            "seed-input-fingerprint-not-rederived" ||
        return 1
    bootstrap_stage3_verify_sanity_evidence \
        "$BSTAGE3_STAGE2_SANITY" "$BSTAGE3_STAGE2" \
        "$BSTAGE3_ROOT" "$BSTAGE3_BACKEND" \
        "$(bootstrap_stage3_transcript_host_value \
            "$BSTAGE3_STAGE2_TRANSCRIPT" HOME)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$BSTAGE3_STAGE2_TRANSCRIPT" TMPDIR)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$BSTAGE3_STAGE2_TRANSCRIPT" PATH)" ||
        bootstrap_stage3_provenance_fail "stage2-sanity-evidence-invalid" ||
        return 1
    bootstrap_stage3_verify_sanity_evidence \
        "$BSTAGE3_STAGE3_SANITY" "$BSTAGE3_STAGE3" \
        "$BSTAGE3_ROOT" "$BSTAGE3_BACKEND" \
        "$(bootstrap_stage3_transcript_host_value \
            "$BSTAGE3_STAGE3_TRANSCRIPT" HOME)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$BSTAGE3_STAGE3_TRANSCRIPT" TMPDIR)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$BSTAGE3_STAGE3_TRANSCRIPT" PATH)" ||
        bootstrap_stage3_provenance_fail "stage3-sanity-evidence-invalid" ||
        return 1
    [ -d "$BSTAGE3_LOCK" ] && [ ! -L "$BSTAGE3_LOCK" ] &&
        [ "$(tr -d '[:space:]' <"$BSTAGE3_LOCK/pid")" = "$$" ] ||
        bootstrap_stage3_provenance_fail "bootstrap-lock-not-owned" ||
        return 1

    bootstrap_stage3_source_count=$(
        wc -l <"$BSTAGE3_SOURCE_AFTER" | tr -d ' '
    )
    bootstrap_stage3_source_sha=$(
        bootstrap_stage3_hash_file "$BSTAGE3_SOURCE_AFTER"
    ) || return 1
    bootstrap_stage3_backfill_status=absent
    bootstrap_stage3_backfill_sha=absent
    if [ -f "$BSTAGE3_BACKFILL" ]; then
        [ ! -L "$BSTAGE3_BACKFILL" ] &&
            [ "$(bootstrap_stage3_canonical_file "$BSTAGE3_BACKFILL")" = \
                "$BSTAGE3_BACKFILL" ] || return 1
        bootstrap_stage3_backfill_status=present
        bootstrap_stage3_backfill_sha=$(
            bootstrap_stage3_hash_file "$BSTAGE3_BACKFILL"
        ) || return 1
    else
        [ "$(bootstrap_stage3_canonical_path "$BSTAGE3_BACKFILL")" = \
            "$BSTAGE3_BACKFILL" ] || return 1
    fi

    bootstrap_stage3_manifest_tmp="${BSTAGE3_MANIFEST}.tmp.$$"
    umask 077
    {
        echo "schema=simple-bootstrap-stage3-provenance-v3"
        echo "status=pass"
        echo "artifact_kind=pure-simple-bootstrap-compiler"
        echo "full_cli_status=separate-not-proven"
        echo "native_build_backfill_status=bound-bootstrap-native-all"
        echo "created_at_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "platform=$BSTAGE3_PLATFORM"
        echo "backend=$BSTAGE3_BACKEND"
        echo "mode=$BSTAGE3_MODE"
        echo "build_rust_log=$BSTAGE3_RUST_LOG"
        echo "source_roots=src/compiler:src/app:src/lib"
        echo "source_file_count=$bootstrap_stage3_source_count"
        echo "source_fingerprint=$bootstrap_stage3_source_sha"
        echo "git_state_path=$BSTAGE3_GIT_AFTER"
        echo "git_state_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_GIT_AFTER")"
        echo "git_head=$(bootstrap_stage3_manifest_value head "$BSTAGE3_GIT_AFTER")"
        echo "git_dirty_fingerprint=$(bootstrap_stage3_manifest_value dirty_fingerprint "$BSTAGE3_GIT_AFTER")"
        echo "bootstrap_lock_path=$BSTAGE3_LOCK"
        echo "bootstrap_lock_owner_pid=$$"
        echo "seed_path=$BSTAGE3_SEED"
        echo "seed_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_SEED")"
        echo "seed_inputs_fingerprint=$BSTAGE3_SEED_INPUTS_FINGERPRINT"
        echo "seed_backend=$BSTAGE3_BACKEND"
        echo "seed_features=$BSTAGE3_SEED_FEATURES"
        echo "seed_inputs_stamp_path=$BSTAGE3_SEED_STAMP"
        echo "seed_inputs_stamp_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_SEED_STAMP")"
        echo "native_all_path=$BSTAGE3_NATIVE_ALL"
        echo "native_all_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_NATIVE_ALL")"
        echo "compiler_backfill_path=$BSTAGE3_BACKFILL"
        echo "compiler_backfill_status=$bootstrap_stage3_backfill_status"
        echo "compiler_backfill_sha256=$bootstrap_stage3_backfill_sha"
        echo "stage2_path=$BSTAGE3_STAGE2"
        echo "stage2_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_STAGE2")"
        echo "stage2_admitted_path=$BSTAGE3_STAGE2_ADMITTED"
        echo "stage2_admitted_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_STAGE2_ADMITTED")"
        echo "stage2_threads=$BSTAGE3_STAGE2_THREADS"
        echo "stage2_command_output=$BSTAGE3_STAGE2_COMMAND_OUTPUT"
        echo "stage2_build_args_sha256=$BSTAGE3_STAGE2_ARGS_SHA256"
        echo "stage2_command_transcript_path=$BSTAGE3_STAGE2_TRANSCRIPT"
        echo "stage2_command_transcript_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_STAGE2_TRANSCRIPT")"
        echo "stage2_build_log_path=$BSTAGE3_STAGE2_LOG"
        echo "stage2_build_log_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_STAGE2_LOG")"
        echo "stage2_sanity_status=pass"
        echo "stage2_sanity_evidence_path=$BSTAGE3_STAGE2_SANITY"
        echo "stage2_sanity_evidence_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_STAGE2_SANITY")"
        echo "stage3_path=$BSTAGE3_STAGE3"
        echo "stage3_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_STAGE3")"
        echo "stage3_threads=$BSTAGE3_STAGE3_THREADS"
        echo "stage3_command_output=$BSTAGE3_STAGE3_COMMAND_OUTPUT"
        echo "stage3_build_args_sha256=$BSTAGE3_STAGE3_ARGS_SHA256"
        echo "stage3_command_transcript_path=$BSTAGE3_STAGE3_TRANSCRIPT"
        echo "stage3_command_transcript_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_STAGE3_TRANSCRIPT")"
        echo "stage3_build_log_path=$BSTAGE3_STAGE3_LOG"
        echo "stage3_build_log_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_STAGE3_LOG")"
        echo "stage3_sanity_status=pass"
        echo "stage3_sanity_evidence_path=$BSTAGE3_STAGE3_SANITY"
        echo "stage3_sanity_evidence_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_STAGE3_SANITY")"
        echo "stage2_native_cache_dir=$BSTAGE3_STAGE2_CACHE_DIR"
        echo "stage3_native_cache_dir=$BSTAGE3_STAGE3_CACHE_DIR"
        echo "runtime_path=$BSTAGE3_RUNTIME_PATH"
        echo "runtime_origin_snapshot_path=$BSTAGE3_RUNTIME_ORIGIN_AFTER"
        echo "runtime_origin_snapshot_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_RUNTIME_ORIGIN_AFTER")"
        echo "runtime_admitted_snapshot_path=$BSTAGE3_RUNTIME_ADMITTED_SNAPSHOT"
        echo "runtime_admitted_snapshot_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_RUNTIME_ADMITTED_SNAPSHOT")"
        echo "tool_authority_path=$BSTAGE3_TOOL_AUTHORITY"
        echo "tool_authority_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_TOOL_AUTHORITY")"
        echo "bootstrap_script_path=$BSTAGE3_BOOTSTRAP_SCRIPT"
        echo "bootstrap_script_sha256=$bootstrap_stage3_script_after"
        echo "provenance_helper_path=$BSTAGE3_HELPER"
        echo "provenance_helper_sha256=$bootstrap_stage3_helper_after"
        echo "provenance_helper_bundle_fingerprint=$bootstrap_stage3_helper_bundle_after"
        echo "source_snapshot_path=$BSTAGE3_SOURCE_AFTER"
        echo "source_snapshot_sha256=$bootstrap_stage3_source_sha"
        echo "output_path=$BSTAGE3_STAGE3"
        echo "output_sha256=$(bootstrap_stage3_hash_file "$BSTAGE3_STAGE3")"
    } >"$bootstrap_stage3_manifest_tmp" || return 1
    mv "$bootstrap_stage3_manifest_tmp" "$BSTAGE3_MANIFEST"
}

# Stage 2 needs an independently admissible receipt because Stage 3 is allowed
# to fail.  Keep it in the Stage 3 helper bundle so both receipts share one
# authority and transcript implementation.
bootstrap_stage2_cache_snapshot() {
    bootstrap_stage2_cache_output=$1
    bootstrap_stage2_cache_root=$2
    [ -d "$bootstrap_stage2_cache_root" ] &&
        [ ! -L "$bootstrap_stage2_cache_root" ] &&
        [ "$(bootstrap_stage3_canonical_path \
            "$bootstrap_stage2_cache_root")" = \
            "$bootstrap_stage2_cache_root" ] || return 1
    perl -MDigest::SHA=sha256_hex -MFile::Find -e '
        use strict;
        use warnings;
        my ($root) = @ARGV;
        my @records;
        find(
            {
                no_chdir => 1,
                wanted => sub {
                    my $absolute = $File::Find::name;
                    return if $absolute eq $root;
                    -l $absolute and die "cache symlink rejected\n";
                    return unless -f $absolute;
                    open my $fh, "<:raw", $absolute or die "open\n";
                    local $/;
                    my $bytes = <$fh>;
                    close $fh or die "close\n";
                    my $relative = substr($absolute, length($root) + 1);
                    push @records, join(
                        ":", "file-hex", unpack("H*", $relative),
                        (-x $absolute ? 1 : 0), sha256_hex($bytes)
                    );
                },
            },
            $root
        );
        print @records ? join("\n", sort @records) . "\n" : "empty\n";
    ' "$bootstrap_stage2_cache_root" >"$bootstrap_stage2_cache_output"
}

bootstrap_stage2_write_manifest() (
    [ "$(bootstrap_stage3_canonical_path "$BSTAGE2_MANIFEST")" = \
        "$BSTAGE2_MANIFEST" ] &&
        [ "$(bootstrap_stage3_canonical_path "$BSTAGE2_MANIFEST_SHA")" = \
            "$BSTAGE2_MANIFEST_SHA" ] || return 1
    [ ! -e "$BSTAGE2_MANIFEST" ] && [ ! -L "$BSTAGE2_MANIFEST" ] &&
        [ ! -e "$BSTAGE2_MANIFEST_SHA" ] &&
        [ ! -L "$BSTAGE2_MANIFEST_SHA" ] || return 1
    bootstrap_stage2_manifest_tmp=
    bootstrap_stage2_manifest_sha_tmp=
    bootstrap_stage2_publish_cleanup() {
        [ -z "$bootstrap_stage2_manifest_tmp" ] ||
            rm -f "$bootstrap_stage2_manifest_tmp"
        [ -z "$bootstrap_stage2_manifest_sha_tmp" ] ||
            rm -f "$bootstrap_stage2_manifest_sha_tmp"
    }
    trap bootstrap_stage2_publish_cleanup EXIT
    trap 'bootstrap_stage2_publish_cleanup; exit 1' HUP INT TERM
    cmp -s "$BSTAGE2_SOURCE_BEFORE" "$BSTAGE2_SOURCE_AFTER" &&
        cmp -s "$BSTAGE2_GIT_BEFORE" "$BSTAGE2_GIT_AFTER" &&
        cmp -s "$BSTAGE2_TOOL_BEFORE" "$BSTAGE2_TOOL_AFTER" &&
        cmp -s "$BSTAGE2_RUNTIME_BEFORE" "$BSTAGE2_RUNTIME_AFTER" ||
        bootstrap_stage3_provenance_fail \
            "stage2-checkpoint-changed-during-build" ||
        return 1
    [ "$(bootstrap_stage3_hash_file "$BSTAGE2_BOOTSTRAP_SCRIPT")" = \
        "$BSTAGE2_BOOTSTRAP_SCRIPT_SHA256_BEFORE" ] &&
        [ "$(bootstrap_stage3_hash_file "$BSTAGE2_HELPER")" = \
            "$BSTAGE2_HELPER_SHA256_BEFORE" ] &&
        [ "$(bootstrap_stage3_helper_bundle_fingerprint)" = \
            "$BSTAGE2_HELPER_BUNDLE_FINGERPRINT_BEFORE" ] ||
        bootstrap_stage3_provenance_fail \
            "stage2-provenance-helper-changed-during-build" ||
        return 1
    [ "$BSTAGE2_STAGE2" = "$BSTAGE2_COMMAND_OUTPUT" ] &&
        [ "$(bootstrap_stage3_hash_file "$BSTAGE2_STAGE2")" = \
            "$(bootstrap_stage3_hash_file "$BSTAGE2_STAGE2_ADMITTED")" ] ||
        return 1
    bootstrap_stage3_verify_seed_stamp "$BSTAGE2_SEED_STAMP" \
        "$BSTAGE2_SEED_INPUTS_FINGERPRINT" "$BSTAGE2_SEED" \
        "$BSTAGE2_NATIVE_ALL" "$BSTAGE2_BACKFILL" || return 1
    bootstrap_stage3_verify_sanity_evidence \
        "$BSTAGE2_SANITY" "$BSTAGE2_STAGE2" "$BSTAGE2_ROOT" \
        "$BSTAGE2_BACKEND" \
        "$(bootstrap_stage3_transcript_host_value \
            "$BSTAGE2_TRANSCRIPT" HOME)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$BSTAGE2_TRANSCRIPT" TMPDIR)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$BSTAGE2_TRANSCRIPT" PATH)" || return 1

    bootstrap_stage2_backfill_status=absent
    bootstrap_stage2_backfill_sha=absent
    if [ -f "$BSTAGE2_BACKFILL" ]; then
        bootstrap_stage2_backfill_status=present
        bootstrap_stage2_backfill_sha=$(
            bootstrap_stage3_hash_file "$BSTAGE2_BACKFILL"
        ) || return 1
    fi
    bootstrap_stage2_source_sha=$(
        bootstrap_stage3_hash_file "$BSTAGE2_SOURCE_AFTER"
    ) || return 1
    bootstrap_stage2_manifest_tmp="${BSTAGE2_MANIFEST}.tmp.$$"
    umask 077
    {
        echo "schema=simple-bootstrap-stage2-provenance-v1"
        echo "status=pass"
        echo "artifact_kind=pure-simple-stage2-bootstrap-compiler"
        echo "checkpoint_status=source-git-tool-runtime-stable"
        echo "created_at_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "platform=$BSTAGE2_PLATFORM"
        echo "backend=$BSTAGE2_BACKEND"
        echo "mode=$BSTAGE2_MODE"
        echo "verbose=$BSTAGE2_VERBOSE"
        echo "build_rust_log=$BSTAGE2_RUST_LOG"
        echo "source_roots=src/compiler:src/app:src/lib"
        echo "source_file_count=$(wc -l <"$BSTAGE2_SOURCE_AFTER" | tr -d ' ')"
        echo "source_fingerprint=$bootstrap_stage2_source_sha"
        echo "source_before_path=$BSTAGE2_SOURCE_BEFORE"
        echo "source_before_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_SOURCE_BEFORE")"
        echo "source_after_path=$BSTAGE2_SOURCE_AFTER"
        echo "source_after_sha256=$bootstrap_stage2_source_sha"
        echo "git_before_path=$BSTAGE2_GIT_BEFORE"
        echo "git_before_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_GIT_BEFORE")"
        echo "git_after_path=$BSTAGE2_GIT_AFTER"
        echo "git_after_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_GIT_AFTER")"
        echo "git_head=$(bootstrap_stage3_manifest_value head "$BSTAGE2_GIT_AFTER")"
        echo "git_dirty_fingerprint=$(bootstrap_stage3_manifest_value dirty_fingerprint "$BSTAGE2_GIT_AFTER")"
        echo "tool_before_path=$BSTAGE2_TOOL_BEFORE"
        echo "tool_before_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_TOOL_BEFORE")"
        echo "tool_after_path=$BSTAGE2_TOOL_AFTER"
        echo "tool_after_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_TOOL_AFTER")"
        echo "runtime_path=$BSTAGE2_RUNTIME_PATH"
        echo "runtime_before_path=$BSTAGE2_RUNTIME_BEFORE"
        echo "runtime_before_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_RUNTIME_BEFORE")"
        echo "runtime_after_path=$BSTAGE2_RUNTIME_AFTER"
        echo "runtime_after_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_RUNTIME_AFTER")"
        echo "seed_path=$BSTAGE2_SEED"
        echo "seed_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_SEED")"
        echo "seed_inputs_fingerprint=$BSTAGE2_SEED_INPUTS_FINGERPRINT"
        echo "seed_backend=$BSTAGE2_BACKEND"
        echo "seed_features=$BSTAGE2_SEED_FEATURES"
        echo "seed_inputs_stamp_path=$BSTAGE2_SEED_STAMP"
        echo "seed_inputs_stamp_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_SEED_STAMP")"
        echo "native_all_path=$BSTAGE2_NATIVE_ALL"
        echo "native_all_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_NATIVE_ALL")"
        echo "compiler_backfill_path=$BSTAGE2_BACKFILL"
        echo "compiler_backfill_status=$bootstrap_stage2_backfill_status"
        echo "compiler_backfill_sha256=$bootstrap_stage2_backfill_sha"
        echo "stage2_path=$BSTAGE2_STAGE2"
        echo "stage2_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_STAGE2")"
        echo "stage2_admitted_path=$BSTAGE2_STAGE2_ADMITTED"
        echo "stage2_admitted_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_STAGE2_ADMITTED")"
        echo "stage2_threads=$BSTAGE2_THREADS"
        echo "stage2_command_output=$BSTAGE2_COMMAND_OUTPUT"
        echo "stage2_build_args_sha256=$BSTAGE2_ARGS_SHA256"
        echo "stage2_command_transcript_path=$BSTAGE2_TRANSCRIPT"
        echo "stage2_command_transcript_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_TRANSCRIPT")"
        echo "stage2_build_log_path=$BSTAGE2_LOG"
        echo "stage2_build_log_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_LOG")"
        echo "stage2_sanity_status=pass"
        echo "stage2_sanity_evidence_path=$BSTAGE2_SANITY"
        echo "stage2_sanity_evidence_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_SANITY")"
        echo "stage2_native_cache_dir=$BSTAGE2_CACHE_DIR"
        echo "stage2_cache_before_path=$BSTAGE2_CACHE_BEFORE"
        echo "stage2_cache_before_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_CACHE_BEFORE")"
        echo "stage2_cache_after_path=$BSTAGE2_CACHE_AFTER"
        echo "stage2_cache_after_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_CACHE_AFTER")"
        echo "bootstrap_script_path=$BSTAGE2_BOOTSTRAP_SCRIPT"
        echo "bootstrap_script_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_BOOTSTRAP_SCRIPT")"
        echo "provenance_helper_path=$BSTAGE2_HELPER"
        echo "provenance_helper_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_HELPER")"
        echo "provenance_helper_bundle_fingerprint=$(bootstrap_stage3_helper_bundle_fingerprint)"
        echo "output_path=$BSTAGE2_STAGE2"
        echo "output_sha256=$(bootstrap_stage3_hash_file "$BSTAGE2_STAGE2")"
    } >"$bootstrap_stage2_manifest_tmp" || return 1
    ln "$bootstrap_stage2_manifest_tmp" "$BSTAGE2_MANIFEST" || return 1
    rm -f "$bootstrap_stage2_manifest_tmp"
    bootstrap_stage2_manifest_tmp=
    chmod 400 "$BSTAGE2_MANIFEST" || return 1
    bootstrap_stage2_manifest_sha_tmp="${BSTAGE2_MANIFEST_SHA}.tmp.$$"
    bootstrap_stage3_hash_file "$BSTAGE2_MANIFEST" \
        >"$bootstrap_stage2_manifest_sha_tmp" || return 1
    ln "$bootstrap_stage2_manifest_sha_tmp" "$BSTAGE2_MANIFEST_SHA" ||
        return 1
    rm -f "$bootstrap_stage2_manifest_sha_tmp"
    bootstrap_stage2_manifest_sha_tmp=
    chmod 400 "$BSTAGE2_MANIFEST_SHA" || return 1
    trap - EXIT HUP INT TERM
)

# Re-derive all mutable bindings. Consumers must additionally require the
# canonical manifest path appropriate to their bootstrap output directory.
