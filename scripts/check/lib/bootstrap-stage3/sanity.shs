bootstrap_stage3_sanity_fail() {
    printf 'stage2-sanity-error: %s\n' "$1" >&2
    return 1
}

# Print the one bootstrap product version admitted by the repository.  The SDN
# authority owns the value; VERSION and the compiled bootstrap identity are
# checked projections.  Keeping this parser here makes Stage 2 production,
# resume, receipt verification, and manifest verification use one rule.
bootstrap_stage3_canonical_version() (
    bootstrap_stage3_version_root=$1
    bootstrap_stage3_version_authority="$bootstrap_stage3_version_root/release/version.sdn"
    bootstrap_stage3_version_projection="$bootstrap_stage3_version_root/VERSION"
    bootstrap_stage3_version_identity="$bootstrap_stage3_version_root/src/app/cli/bootstrap_identity.spl"
    for bootstrap_stage3_version_file in \
        "$bootstrap_stage3_version_authority" \
        "$bootstrap_stage3_version_projection" \
        "$bootstrap_stage3_version_identity"; do
        [ -f "$bootstrap_stage3_version_file" ] &&
            [ ! -L "$bootstrap_stage3_version_file" ] || return 1
    done
    [ "$(grep -Ec '^[[:space:]]*schema:' \
        "$bootstrap_stage3_version_authority")" = 1 ] || return 1
    [ "$(grep -Ec '^[[:space:]]*schema:[[:space:]]*simple-release-version/1[[:space:]]*$' \
        "$bootstrap_stage3_version_authority")" = 1 ] || return 1
    bootstrap_stage3_version_semver=$(sed -n \
        's/^[[:space:]]*semver:[[:space:]]*\([^[:space:]#][^[:space:]#]*\)[[:space:]]*$/\1/p' \
        "$bootstrap_stage3_version_authority") || return 1
    [ -n "$bootstrap_stage3_version_semver" ] || return 1
    [ "$(grep -Ec \
        '^[[:space:]]*semver:[[:space:]]*[^[:space:]#][^[:space:]#]*[[:space:]]*$' \
        "$bootstrap_stage3_version_authority")" = 1 ] ||
        return 1
    printf '%s\n' "$bootstrap_stage3_version_semver" |
        grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?$' ||
        return 1
    [ "$(awk 'END { print NR }' "$bootstrap_stage3_version_projection")" = 1 ] ||
        return 1
    bootstrap_stage3_version_projected=$(sed -n '1p' \
        "$bootstrap_stage3_version_projection") || return 1
    [ "$bootstrap_stage3_version_projected" = "$bootstrap_stage3_version_semver" ] ||
        return 1
    [ "$(grep -Ec '^[[:space:]]*pub fn bootstrap_version[(][)] -> text:[[:space:]]*$' \
        "$bootstrap_stage3_version_identity")" = 1 ] || return 1
    bootstrap_stage3_version_compiled=$(awk '
        /^[[:space:]]*pub fn bootstrap_version[(][)] -> text:[[:space:]]*$/ {
            if (seen++) exit 2
            if ((getline next_line) <= 0) exit 3
            if (next_line !~ /^[[:space:]]*"[^"]*"[[:space:]]*$/) exit 4
            sub(/^[[:space:]]*"/, "", next_line)
            sub(/"[[:space:]]*$/, "", next_line)
            print next_line
            body_seen=1
            next
        }
        body_seen && $0 !~ /^[[:space:]]*$/ { exit 5 }
        END { if (!body_seen) exit 6 }
    ' "$bootstrap_stage3_version_identity") || return 1
    [ -n "$bootstrap_stage3_version_compiled" ] ||
        return 1
    [ "$bootstrap_stage3_version_compiled" = "$bootstrap_stage3_version_semver" ] ||
        return 1
    printf '%s\n' "$bootstrap_stage3_version_semver"
)

bootstrap_stage3_sanity_expect() {
    bootstrap_stage3_sanity_expect_key=$1
    bootstrap_stage3_sanity_expect_file=$2
    bootstrap_stage3_sanity_expect_value=$3
    bootstrap_stage3_sanity_expect_actual=$(
        bootstrap_stage3_manifest_value \
            "$bootstrap_stage3_sanity_expect_key" \
            "$bootstrap_stage3_sanity_expect_file"
    ) || bootstrap_stage3_sanity_fail \
"field '$bootstrap_stage3_sanity_expect_key' unreadable in $bootstrap_stage3_sanity_expect_file" ||
        return 1
    [ "$bootstrap_stage3_sanity_expect_actual" = \
        "$bootstrap_stage3_sanity_expect_value" ] ||
        bootstrap_stage3_sanity_fail \
"field '$bootstrap_stage3_sanity_expect_key' was '$bootstrap_stage3_sanity_expect_actual', expected '$bootstrap_stage3_sanity_expect_value'" ||
        return 1
}

bootstrap_stage3_verify_sanity_evidence_receipt() (
    [ "$#" = 3 ] || return 1
    bootstrap_stage3_sanity_file=$1
    bootstrap_stage3_sanity_candidate=$2
    bootstrap_stage3_sanity_root=$3
    [ -f "$bootstrap_stage3_sanity_file" ] &&
        [ ! -L "$bootstrap_stage3_sanity_file" ] ||
        bootstrap_stage3_sanity_fail \
"sanity evidence '$bootstrap_stage3_sanity_file' is missing or is a symlink" ||
        return 1
    for bootstrap_stage3_sanity_key in schema status candidate_sha256_before \
        version_status version_output unsupported_status \
        unsupported_output_sha256 frontend_smoke_status \
        frontend_smoke_bootstrap_mode_status \
        frontend_smoke_output_sha256 \
        candidate_sha256_after; do
        bootstrap_stage3_manifest_value "$bootstrap_stage3_sanity_key" \
            "$bootstrap_stage3_sanity_file" >/dev/null ||
            bootstrap_stage3_sanity_fail \
"required field '$bootstrap_stage3_sanity_key' absent from $bootstrap_stage3_sanity_file" ||
            return 1
    done
    bootstrap_stage3_sanity_expect schema "$bootstrap_stage3_sanity_file" \
        simple-bootstrap-sanity-evidence-v1 || return 1
    bootstrap_stage3_sanity_expect status "$bootstrap_stage3_sanity_file" \
        pass || return 1
    bootstrap_stage3_sanity_expect version_status \
        "$bootstrap_stage3_sanity_file" 0 || return 1
    bootstrap_stage3_sanity_canonical=$(bootstrap_stage3_canonical_version \
        "$bootstrap_stage3_sanity_root") || bootstrap_stage3_sanity_fail \
"canonical release version authority is invalid under '$bootstrap_stage3_sanity_root'" ||
        return 1
    bootstrap_stage3_sanity_expected=$(bootstrap_stage3_manifest_value \
        version_expected "$bootstrap_stage3_sanity_file" 2>/dev/null || true)
    if [ -n "$bootstrap_stage3_sanity_expected" ]; then
        bootstrap_stage3_sanity_expect version_expect_status \
            "$bootstrap_stage3_sanity_file" 0 || return 1
        bootstrap_stage3_sanity_expect version_match_status \
            "$bootstrap_stage3_sanity_file" 0 || return 1
        [ "$bootstrap_stage3_sanity_expected" = \
            "$bootstrap_stage3_sanity_canonical" ] || bootstrap_stage3_sanity_fail \
"field 'version_expected' was '$bootstrap_stage3_sanity_expected', canonical release version is '$bootstrap_stage3_sanity_canonical'" ||
            return 1
    else
        bootstrap_stage3_sanity_expected=$bootstrap_stage3_sanity_canonical
    fi
    bootstrap_stage3_sanity_expect version_output \
        "$bootstrap_stage3_sanity_file" \
        "simple-bootstrap $bootstrap_stage3_sanity_expected" || return 1
    bootstrap_stage3_sanity_expect unsupported_status \
        "$bootstrap_stage3_sanity_file" 1 || return 1
    bootstrap_stage3_sanity_expect frontend_smoke_status \
        "$bootstrap_stage3_sanity_file" 0 || return 1
    bootstrap_stage3_sanity_expect frontend_smoke_bootstrap_mode_status \
        "$bootstrap_stage3_sanity_file" 0 || return 1
    bootstrap_stage3_sanity_candidate_sha=$(
        bootstrap_stage3_hash_file "$bootstrap_stage3_sanity_candidate"
    ) || bootstrap_stage3_sanity_fail \
"candidate '$bootstrap_stage3_sanity_candidate' could not be hashed" ||
        return 1
    bootstrap_stage3_sanity_expect candidate_sha256_before \
        "$bootstrap_stage3_sanity_file" \
        "$bootstrap_stage3_sanity_candidate_sha" || return 1
    bootstrap_stage3_sanity_expect candidate_sha256_after \
        "$bootstrap_stage3_sanity_file" \
        "$bootstrap_stage3_sanity_candidate_sha" || return 1
    bootstrap_stage3_sanity_unsupported_sha=$(
        bootstrap_stage3_manifest_value unsupported_output_sha256 \
            "$bootstrap_stage3_sanity_file"
    ) || bootstrap_stage3_sanity_fail \
"field 'unsupported_output_sha256' unreadable in $bootstrap_stage3_sanity_file" ||
        return 1
    printf '%s\n' "$bootstrap_stage3_sanity_unsupported_sha" |
        grep -Eq '^[0-9a-f]{64}$' ||
        bootstrap_stage3_sanity_fail \
"field 'unsupported_output_sha256' is not a sha256: '$bootstrap_stage3_sanity_unsupported_sha'" ||
        return 1
    bootstrap_stage3_sanity_frontend_sha=$(
        bootstrap_stage3_manifest_value frontend_smoke_output_sha256 \
            "$bootstrap_stage3_sanity_file"
    ) || bootstrap_stage3_sanity_fail \
"field 'frontend_smoke_output_sha256' unreadable in $bootstrap_stage3_sanity_file" ||
        return 1
    printf '%s\n' "$bootstrap_stage3_sanity_frontend_sha" |
        grep -Eq '^[0-9a-f]{64}$' ||
        bootstrap_stage3_sanity_fail \
"field 'frontend_smoke_output_sha256' is not a sha256: '$bootstrap_stage3_sanity_frontend_sha'" ||
        return 1
)

bootstrap_stage3_verify_receiver_evidence_receipt() (
    bootstrap_stage3_receiver_file=$1
    bootstrap_stage3_receiver_candidate=$2
    bootstrap_stage3_receiver_runtime_snapshot=$3
    bootstrap_stage3_receiver_expected_log=$4
    [ -f "$bootstrap_stage3_receiver_file" ] &&
        [ ! -L "$bootstrap_stage3_receiver_file" ] || return 1
    [ -f "$bootstrap_stage3_receiver_candidate" ] &&
        [ ! -L "$bootstrap_stage3_receiver_candidate" ] || return 1
    [ -f "$bootstrap_stage3_receiver_runtime_snapshot" ] &&
        [ ! -L "$bootstrap_stage3_receiver_runtime_snapshot" ] || return 1
    for bootstrap_stage3_receiver_key in schema status probe_exit \
        candidate_sha256_before candidate_sha256_after \
        runtime_snapshot_sha256 probe_log probe_log_sha256; do
        bootstrap_stage3_manifest_value "$bootstrap_stage3_receiver_key" \
            "$bootstrap_stage3_receiver_file" >/dev/null || return 1
    done
    [ "$(bootstrap_stage3_manifest_value schema \
        "$bootstrap_stage3_receiver_file")" = \
        simple-bootstrap-stage2-receiver-evidence-v1 ] || return 1
    [ "$(bootstrap_stage3_manifest_value status \
        "$bootstrap_stage3_receiver_file")" = pass ] || return 1
    [ "$(bootstrap_stage3_manifest_value probe_exit \
        "$bootstrap_stage3_receiver_file")" = 0 ] || return 1
    bootstrap_stage3_receiver_candidate_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_receiver_candidate") || return 1
    [ "$(bootstrap_stage3_manifest_value candidate_sha256_before \
        "$bootstrap_stage3_receiver_file")" = \
        "$bootstrap_stage3_receiver_candidate_sha" ] || return 1
    [ "$(bootstrap_stage3_manifest_value candidate_sha256_after \
        "$bootstrap_stage3_receiver_file")" = \
        "$bootstrap_stage3_receiver_candidate_sha" ] || return 1
    [ "$(bootstrap_stage3_manifest_value runtime_snapshot_sha256 \
        "$bootstrap_stage3_receiver_file")" = \
        "$(bootstrap_stage3_hash_file \
            "$bootstrap_stage3_receiver_runtime_snapshot")" ] || return 1
    bootstrap_stage3_receiver_log=$(bootstrap_stage3_manifest_value probe_log \
        "$bootstrap_stage3_receiver_file") || return 1
    [ "$bootstrap_stage3_receiver_log" = \
        "$bootstrap_stage3_receiver_expected_log" ] || return 1
    [ -f "$bootstrap_stage3_receiver_log" ] &&
        [ ! -L "$bootstrap_stage3_receiver_log" ] || return 1
    [ "$(bootstrap_stage3_manifest_value probe_log_sha256 \
        "$bootstrap_stage3_receiver_file")" = \
        "$(bootstrap_stage3_hash_file "$bootstrap_stage3_receiver_log")" ] ||
        return 1
)

bootstrap_stage3_stage2_admission_identity() {
    [ "$#" = 9 ] || return 1
    for bootstrap_stage3_identity_sha in "$1" "$2" "$3" "$4" "$5" \
        "$6" "$7" "$9"; do
        printf '%s\n' "$bootstrap_stage3_identity_sha" |
            grep -Eq '^[0-9a-f]{64}$' || return 1
    done
    case "$8" in deps/libspl_hosted_runtime-*.rlib) ;; *) return 1 ;; esac
    {
        echo 'schema=simple-bootstrap-stage2-admission-identity-v1'
        echo "artifact_sha256=$1"
        echo "source_snapshot_sha256=$2"
        echo "runtime_snapshot_sha256=$3"
        echo "tool_authority_sha256=$4"
        echo "build_args_sha256=$5"
        echo "sanity_evidence_sha256=$6"
        echo "receiver_evidence_sha256=$7"
        echo "hosted_runtime_relative_path=$8"
        echo "hosted_runtime_sha256=$9"
    } | bootstrap_stage3_hash_stream
}

bootstrap_stage3_write_stage2_admission_receipt() (
    [ "$#" = 9 ] || return 1
    bootstrap_stage3_admission_receipt=$1
    bootstrap_stage3_admission_candidate=$2
    bootstrap_stage3_admission_source=$3
    bootstrap_stage3_admission_runtime=$4
    bootstrap_stage3_admission_tool=$5
    bootstrap_stage3_admission_args_sha=$6
    bootstrap_stage3_admission_sanity=$7
    bootstrap_stage3_admission_receiver=$8
    bootstrap_stage3_admission_root=$9
    bootstrap_stage3_admission_abi_policy=${SIMPLE_ABI_POLICY:-}
    case "$bootstrap_stage3_admission_abi_policy" in
        v1)
            bootstrap_stage3_admission_abi_version=1
            bootstrap_stage3_admission_abi_deferred=0
            ;;
        *) return 1 ;;
    esac
    [ ! -e "$bootstrap_stage3_admission_receipt" ] || return 1
    for bootstrap_stage3_admission_file in \
        "$bootstrap_stage3_admission_candidate" \
        "$bootstrap_stage3_admission_source" \
        "$bootstrap_stage3_admission_runtime" \
        "$bootstrap_stage3_admission_tool" \
        "$bootstrap_stage3_admission_sanity" \
        "$bootstrap_stage3_admission_receiver"; do
        [ -f "$bootstrap_stage3_admission_file" ] &&
            [ ! -L "$bootstrap_stage3_admission_file" ] || return 1
    done
    printf '%s\n' "$bootstrap_stage3_admission_args_sha" |
        grep -Eq '^[0-9a-f]{64}$' || return 1
    bootstrap_stage3_verify_sanity_evidence_receipt \
        "$bootstrap_stage3_admission_sanity" \
        "$bootstrap_stage3_admission_candidate" \
        "$bootstrap_stage3_admission_root" || return 1
    bootstrap_stage3_verify_receiver_evidence_receipt \
        "$bootstrap_stage3_admission_receiver" \
        "$bootstrap_stage3_admission_candidate" \
        "$bootstrap_stage3_admission_runtime" \
        "$(dirname -- "$bootstrap_stage3_admission_receiver")/stage2-receiver.log" ||
        return 1
    bootstrap_stage3_admission_candidate_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_admission_candidate") || return 1
    bootstrap_stage3_admission_source_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_admission_source") || return 1
    bootstrap_stage3_admission_runtime_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_admission_runtime") || return 1
    bootstrap_stage3_admission_tool_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_admission_tool") || return 1
    bootstrap_stage3_admission_sanity_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_admission_sanity") || return 1
    bootstrap_stage3_admission_receiver_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_admission_receiver") || return 1
    bootstrap_stage3_admission_runtime_authority=\
"$(dirname -- "$bootstrap_stage3_admission_runtime")/stage2-runtime-authority"
    bootstrap_stage3_verify_hosted_runtime_authority \
        "$bootstrap_stage3_admission_runtime_authority" || return 1
    bootstrap_stage3_admission_hosted_relative=\
$BOOTSTRAP_STAGE3_HOSTED_RUNTIME_RELATIVE_PATH
    bootstrap_stage3_admission_hosted_sha=\
$BOOTSTRAP_STAGE3_HOSTED_RUNTIME_SHA256
    bootstrap_stage3_admission_identity=$(
        bootstrap_stage3_stage2_admission_identity \
            "$bootstrap_stage3_admission_candidate_sha" \
            "$bootstrap_stage3_admission_source_sha" \
            "$bootstrap_stage3_admission_runtime_sha" \
            "$bootstrap_stage3_admission_tool_sha" \
            "$bootstrap_stage3_admission_args_sha" \
            "$bootstrap_stage3_admission_sanity_sha" \
            "$bootstrap_stage3_admission_receiver_sha" \
            "$bootstrap_stage3_admission_hosted_relative" \
            "$bootstrap_stage3_admission_hosted_sha"
    ) || return 1
    bootstrap_stage3_admission_tmp="${bootstrap_stage3_admission_receipt}.tmp.$$"
    trap 'rm -f "$bootstrap_stage3_admission_tmp"' EXIT INT TERM HUP
    umask 077
    {
        echo 'schema=simple-bootstrap-stage2-admission-v2'
        echo 'status=admitted'
        echo "candidate_path=$bootstrap_stage3_admission_candidate"
        echo "candidate_sha256=$bootstrap_stage3_admission_candidate_sha"
        echo "source_snapshot_path=$bootstrap_stage3_admission_source"
        echo "source_snapshot_sha256=$bootstrap_stage3_admission_source_sha"
        echo "runtime_snapshot_path=$bootstrap_stage3_admission_runtime"
        echo "runtime_snapshot_sha256=$bootstrap_stage3_admission_runtime_sha"
        echo "runtime_authority_path=$bootstrap_stage3_admission_runtime_authority"
        echo "hosted_runtime_relative_path=$bootstrap_stage3_admission_hosted_relative"
        echo "hosted_runtime_sha256=$bootstrap_stage3_admission_hosted_sha"
        echo "tool_authority_path=$bootstrap_stage3_admission_tool"
        echo "tool_authority_sha256=$bootstrap_stage3_admission_tool_sha"
        echo "build_args_sha256=$bootstrap_stage3_admission_args_sha"
        echo "simple_abi_policy=$bootstrap_stage3_admission_abi_policy"
        echo "simple_abi_version=$bootstrap_stage3_admission_abi_version"
        echo "simple_abi_deferred=$bootstrap_stage3_admission_abi_deferred"
        echo "sanity_evidence_path=$bootstrap_stage3_admission_sanity"
        echo "sanity_evidence_sha256=$bootstrap_stage3_admission_sanity_sha"
        echo "receiver_evidence_path=$bootstrap_stage3_admission_receiver"
        echo "receiver_evidence_sha256=$bootstrap_stage3_admission_receiver_sha"
        echo "admission_identity=$bootstrap_stage3_admission_identity"
        echo 'checks_executed_at_admission=1'
        echo 'checks_replayed_during_stage3=0'
    } >"$bootstrap_stage3_admission_tmp" || return 1
    chmod 400 "$bootstrap_stage3_admission_tmp" || return 1
    mv "$bootstrap_stage3_admission_tmp" \
        "$bootstrap_stage3_admission_receipt" || return 1
    trap - EXIT INT TERM HUP
)

bootstrap_stage3_verify_stage2_admission_receipt() (
    [ "$#" = 9 ] || return 1
    bootstrap_stage3_admission_receipt=$1
    bootstrap_stage3_admission_candidate=$2
    bootstrap_stage3_admission_source=$3
    bootstrap_stage3_admission_runtime=$4
    bootstrap_stage3_admission_tool=$5
    bootstrap_stage3_admission_args_sha=$6
    bootstrap_stage3_admission_sanity=$7
    bootstrap_stage3_admission_receiver=$8
    bootstrap_stage3_admission_root=$9
    bootstrap_stage3_admission_abi_policy=${SIMPLE_ABI_POLICY:-}
    case "$bootstrap_stage3_admission_abi_policy" in
        v1)
            bootstrap_stage3_admission_abi_version=1
            bootstrap_stage3_admission_abi_deferred=0
            ;;
        *) return 1 ;;
    esac
    bootstrap_stage3_verify_sanity_evidence_receipt \
        "$bootstrap_stage3_admission_sanity" \
        "$bootstrap_stage3_admission_candidate" \
        "$bootstrap_stage3_admission_root" || return 1
    [ -f "$bootstrap_stage3_admission_receipt" ] &&
        [ ! -L "$bootstrap_stage3_admission_receipt" ] || return 1
    for bootstrap_stage3_admission_key in schema status candidate_path \
        candidate_sha256 source_snapshot_path source_snapshot_sha256 \
        runtime_snapshot_path runtime_snapshot_sha256 tool_authority_path \
        runtime_authority_path hosted_runtime_relative_path \
        hosted_runtime_sha256 \
        tool_authority_sha256 build_args_sha256 sanity_evidence_path \
        simple_abi_policy simple_abi_version simple_abi_deferred \
        sanity_evidence_sha256 receiver_evidence_path \
        receiver_evidence_sha256 admission_identity \
        checks_executed_at_admission checks_replayed_during_stage3; do
        bootstrap_stage3_manifest_value "$bootstrap_stage3_admission_key" \
            "$bootstrap_stage3_admission_receipt" >/dev/null || return 1
    done
    [ "$(bootstrap_stage3_manifest_value schema \
        "$bootstrap_stage3_admission_receipt")" = \
        simple-bootstrap-stage2-admission-v2 ] || return 1
    [ "$(bootstrap_stage3_manifest_value status \
        "$bootstrap_stage3_admission_receipt")" = admitted ] || return 1
    [ "$(bootstrap_stage3_manifest_value checks_executed_at_admission \
        "$bootstrap_stage3_admission_receipt")" = 1 ] || return 1
    [ "$(bootstrap_stage3_manifest_value checks_replayed_during_stage3 \
        "$bootstrap_stage3_admission_receipt")" = 0 ] || return 1
    [ "$(bootstrap_stage3_manifest_value simple_abi_policy \
        "$bootstrap_stage3_admission_receipt")" = \
        "$bootstrap_stage3_admission_abi_policy" ] || return 1
    [ "$(bootstrap_stage3_manifest_value simple_abi_version \
        "$bootstrap_stage3_admission_receipt")" = \
        "$bootstrap_stage3_admission_abi_version" ] || return 1
    [ "$(bootstrap_stage3_manifest_value simple_abi_deferred \
        "$bootstrap_stage3_admission_receipt")" = \
        "$bootstrap_stage3_admission_abi_deferred" ] || return 1
    for bootstrap_stage3_admission_binding in \
        "candidate_path:$bootstrap_stage3_admission_candidate" \
        "source_snapshot_path:$bootstrap_stage3_admission_source" \
        "runtime_snapshot_path:$bootstrap_stage3_admission_runtime" \
        "tool_authority_path:$bootstrap_stage3_admission_tool" \
        "sanity_evidence_path:$bootstrap_stage3_admission_sanity" \
        "receiver_evidence_path:$bootstrap_stage3_admission_receiver"; do
        bootstrap_stage3_admission_key=${bootstrap_stage3_admission_binding%%:*}
        bootstrap_stage3_admission_expected=${bootstrap_stage3_admission_binding#*:}
        [ "$(bootstrap_stage3_manifest_value \
            "$bootstrap_stage3_admission_key" \
            "$bootstrap_stage3_admission_receipt")" = \
            "$bootstrap_stage3_admission_expected" ] || return 1
    done
    bootstrap_stage3_admission_runtime_authority=\
"$(dirname -- "$bootstrap_stage3_admission_runtime")/stage2-runtime-authority"
    [ "$(bootstrap_stage3_manifest_value runtime_authority_path \
        "$bootstrap_stage3_admission_receipt")" = \
        "$bootstrap_stage3_admission_runtime_authority" ] || return 1
    bootstrap_stage3_verify_hosted_runtime_authority \
        "$bootstrap_stage3_admission_runtime_authority" || return 1
    bootstrap_stage3_admission_hosted_relative=\
$BOOTSTRAP_STAGE3_HOSTED_RUNTIME_RELATIVE_PATH
    bootstrap_stage3_admission_hosted_sha=\
$BOOTSTRAP_STAGE3_HOSTED_RUNTIME_SHA256
    [ "$(bootstrap_stage3_manifest_value hosted_runtime_relative_path \
        "$bootstrap_stage3_admission_receipt")" = \
        "$bootstrap_stage3_admission_hosted_relative" ] || return 1
    [ "$(bootstrap_stage3_manifest_value hosted_runtime_sha256 \
        "$bootstrap_stage3_admission_receipt")" = \
        "$bootstrap_stage3_admission_hosted_sha" ] || return 1
    bootstrap_stage3_admission_candidate_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_admission_candidate") || return 1
    bootstrap_stage3_admission_source_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_admission_source") || return 1
    bootstrap_stage3_admission_runtime_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_admission_runtime") || return 1
    bootstrap_stage3_admission_tool_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_admission_tool") || return 1
    bootstrap_stage3_admission_sanity_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_admission_sanity") || return 1
    bootstrap_stage3_admission_receiver_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_admission_receiver") || return 1
    for bootstrap_stage3_admission_binding in \
        "candidate_sha256:$bootstrap_stage3_admission_candidate_sha" \
        "source_snapshot_sha256:$bootstrap_stage3_admission_source_sha" \
        "runtime_snapshot_sha256:$bootstrap_stage3_admission_runtime_sha" \
        "tool_authority_sha256:$bootstrap_stage3_admission_tool_sha" \
        "build_args_sha256:$bootstrap_stage3_admission_args_sha" \
        "sanity_evidence_sha256:$bootstrap_stage3_admission_sanity_sha" \
        "receiver_evidence_sha256:$bootstrap_stage3_admission_receiver_sha"; do
        bootstrap_stage3_admission_key=${bootstrap_stage3_admission_binding%%:*}
        bootstrap_stage3_admission_expected=${bootstrap_stage3_admission_binding#*:}
        bootstrap_stage3_admission_actual=$(bootstrap_stage3_manifest_value \
            "$bootstrap_stage3_admission_key" \
            "$bootstrap_stage3_admission_receipt")
        if [ "$bootstrap_stage3_admission_actual" != \
            "$bootstrap_stage3_admission_expected" ]; then
            # Say WHICH binding disagreed. A bare `return 1` here surfaces to
            # the operator only as a resume that stops with no output at all,
            # which is the same fail-mute this tree has already had to fix in
            # the seed-input fingerprint. The recorded value belongs to the
            # admitted Stage 2; the expected value is recomputed now, so a
            # mismatch means the admitted state no longer describes this tree.
            echo "bootstrap-stage3-admission-mismatch: ${bootstrap_stage3_admission_key} recorded=${bootstrap_stage3_admission_actual} expected=${bootstrap_stage3_admission_expected} receipt=${bootstrap_stage3_admission_receipt}" >&2
            return 1
        fi
    done
    bootstrap_stage3_admission_identity=$(
        bootstrap_stage3_stage2_admission_identity \
            "$bootstrap_stage3_admission_candidate_sha" \
            "$bootstrap_stage3_admission_source_sha" \
            "$bootstrap_stage3_admission_runtime_sha" \
            "$bootstrap_stage3_admission_tool_sha" \
            "$bootstrap_stage3_admission_args_sha" \
            "$bootstrap_stage3_admission_sanity_sha" \
            "$bootstrap_stage3_admission_receiver_sha" \
            "$bootstrap_stage3_admission_hosted_relative" \
            "$bootstrap_stage3_admission_hosted_sha"
    ) || return 1
    [ "$(bootstrap_stage3_manifest_value admission_identity \
        "$bootstrap_stage3_admission_receipt")" = \
        "$bootstrap_stage3_admission_identity" ] || return 1
)

bootstrap_stage3_verify_sanity_evidence() (
    bootstrap_stage3_sanity_file=$1
    bootstrap_stage3_sanity_candidate=$2
    bootstrap_stage3_sanity_root=$3
    bootstrap_stage3_sanity_backend=$4
    bootstrap_stage3_sanity_home=$5
    bootstrap_stage3_sanity_tmpdir=$6
    bootstrap_stage3_sanity_path=$7
    bootstrap_stage3_verify_sanity_evidence_receipt \
        "$bootstrap_stage3_sanity_file" \
        "$bootstrap_stage3_sanity_candidate" \
        "$bootstrap_stage3_sanity_root" || return 1
    for bootstrap_stage3_sanity_env_name in $(env | sed 's/=.*//'); do
        unset "$bootstrap_stage3_sanity_env_name"
    done
    HOME=$bootstrap_stage3_sanity_home
    TMPDIR=$bootstrap_stage3_sanity_tmpdir
    PATH=$bootstrap_stage3_sanity_path
    LC_ALL=C
    LANG=C
    export HOME TMPDIR PATH LC_ALL LANG
    bootstrap_stage3_sanity_unsupported_sha=$(
        bootstrap_stage3_manifest_value unsupported_output_sha256 \
            "$bootstrap_stage3_sanity_file"
    ) || return 1
    bootstrap_stage3_sanity_frontend_sha=$(
        bootstrap_stage3_manifest_value frontend_smoke_output_sha256 \
            "$bootstrap_stage3_sanity_file"
    ) || return 1
    if ! command -v candidate_frontend_smoke >/dev/null 2>&1; then
        [ -f "$bootstrap_stage3_sanity_root/scripts/check/cert/redeploy_gate/candidate_frontend_admission.shs" ] ||
            bootstrap_stage3_sanity_fail \
"frontend admission helper missing under root '$bootstrap_stage3_sanity_root'" ||
            return 1
        . "$bootstrap_stage3_sanity_root/scripts/check/cert/redeploy_gate/candidate_frontend_admission.shs"
    fi
    bootstrap_stage3_sanity_frontend_log=\
"${bootstrap_stage3_sanity_file}.frontend.replay.$$"
    bootstrap_stage3_sanity_frontend_status=0
    CANDIDATE_FRONTEND_ROOT="$bootstrap_stage3_sanity_root" \
    CANDIDATE_FRONTEND_BACKEND="$bootstrap_stage3_sanity_backend" \
    COMPILER_PROBE_TIMEOUT_SECONDS=5 \
    COMPILER_BUILD_TIMEOUT_SECONDS=60 \
    COMPILER_EXEC_TIMEOUT_SECONDS=5 \
    COMPILER_CHECK_KILL_GRACE_SECONDS=1 \
        candidate_frontend_smoke "$bootstrap_stage3_sanity_candidate" \
        >"$bootstrap_stage3_sanity_frontend_log" 2>&1 ||
        bootstrap_stage3_sanity_frontend_status=$?
    bootstrap_stage3_sanity_frontend_replay_sha=$(
        bootstrap_stage3_hash_file \
            "$bootstrap_stage3_sanity_frontend_log"
    ) || {
        rm -f "$bootstrap_stage3_sanity_frontend_log"
        bootstrap_stage3_sanity_fail \
"frontend smoke replay log could not be hashed"
        return 1
    }
    rm -f "$bootstrap_stage3_sanity_frontend_log"
    bootstrap_stage3_sanity_recorded_frontend_status=$(
        bootstrap_stage3_manifest_value frontend_smoke_status \
            "$bootstrap_stage3_sanity_file"
    )
    [ "$bootstrap_stage3_sanity_frontend_status" = \
        "$bootstrap_stage3_sanity_recorded_frontend_status" ] ||
        bootstrap_stage3_sanity_fail \
"frontend smoke replay exit status $bootstrap_stage3_sanity_frontend_status does not match recorded frontend_smoke_status=$bootstrap_stage3_sanity_recorded_frontend_status" ||
        return 1
    [ "$bootstrap_stage3_sanity_frontend_status" = 0 ] ||
        bootstrap_stage3_sanity_fail \
"frontend smoke replay failed with exit status $bootstrap_stage3_sanity_frontend_status" ||
        return 1
    [ "$bootstrap_stage3_sanity_frontend_replay_sha" = \
        "$bootstrap_stage3_sanity_frontend_sha" ] ||
        bootstrap_stage3_sanity_fail \
"frontend smoke replay output sha256 $bootstrap_stage3_sanity_frontend_replay_sha does not match recorded $bootstrap_stage3_sanity_frontend_sha" ||
        return 1
    bootstrap_stage3_sanity_version_status=0
    bootstrap_stage3_sanity_version=$(
        "$bootstrap_stage3_sanity_candidate" --version 2>&1
    ) || bootstrap_stage3_sanity_version_status=$?
    [ "$bootstrap_stage3_sanity_version_status" = 0 ] ||
        bootstrap_stage3_sanity_fail \
"candidate '--version' exited $bootstrap_stage3_sanity_version_status: $bootstrap_stage3_sanity_version" ||
        return 1
    bootstrap_stage3_sanity_expected=$(bootstrap_stage3_canonical_version \
        "$bootstrap_stage3_sanity_root") || bootstrap_stage3_sanity_fail \
"canonical release version authority is invalid under '$bootstrap_stage3_sanity_root'" ||
        return 1
    [ "$bootstrap_stage3_sanity_version" = \
        "simple-bootstrap $bootstrap_stage3_sanity_expected" ] ||
        bootstrap_stage3_sanity_fail \
"candidate '--version' printed '$bootstrap_stage3_sanity_version', expected 'simple-bootstrap $bootstrap_stage3_sanity_expected'" ||
        return 1
    bootstrap_stage3_sanity_unsupported_status=0
    bootstrap_stage3_sanity_unsupported=$(
        "$bootstrap_stage3_sanity_candidate" run \
            scripts/check/cert/redeploy_gate/fixtures/p2_add.spl 2>&1
    ) || bootstrap_stage3_sanity_unsupported_status=$?
    [ "$bootstrap_stage3_sanity_unsupported_status" = 1 ] ||
        bootstrap_stage3_sanity_fail \
"candidate 'run' exited $bootstrap_stage3_sanity_unsupported_status, expected 1 (unsupported command): $bootstrap_stage3_sanity_unsupported" ||
        return 1
    case "$bootstrap_stage3_sanity_unsupported" in
        *"unknown command 'run'"*) ;;
        *)
            bootstrap_stage3_sanity_fail \
"candidate 'run' output did not contain \"unknown command 'run'\": $bootstrap_stage3_sanity_unsupported"
            return 1
            ;;
    esac
    bootstrap_stage3_sanity_unsupported_replay_sha=$(
        printf '%s' "$bootstrap_stage3_sanity_unsupported" |
            bootstrap_stage3_hash_stream
    )
    [ "$bootstrap_stage3_sanity_unsupported_replay_sha" = \
        "$bootstrap_stage3_sanity_unsupported_sha" ] ||
        bootstrap_stage3_sanity_fail \
"candidate 'run' output sha256 $bootstrap_stage3_sanity_unsupported_replay_sha does not match recorded $bootstrap_stage3_sanity_unsupported_sha" ||
        return 1
    return 0
)
# Required environment:
#   BSTAGE3_ROOT BSTAGE3_MANIFEST BSTAGE3_PLATFORM BSTAGE3_BACKEND
#   BSTAGE3_MODE BSTAGE3_SEED BSTAGE3_NATIVE_ALL BSTAGE3_BACKFILL
#   BSTAGE3_SEED_STAMP BSTAGE3_HELPER BSTAGE3_HELPER_SHA256_BEFORE
#   BSTAGE3_STAGE2 BSTAGE3_STAGE2_ADMITTED BSTAGE3_STAGE2_ADMISSION
#   BSTAGE3_STAGE3
#   BSTAGE3_SOURCE_BEFORE BSTAGE3_SOURCE_AFTER
#   BSTAGE3_STAGE2_LOG BSTAGE3_STAGE3_LOG BSTAGE3_STAGE2_ARGS_SHA256
#   BSTAGE3_STAGE3_ARGS_SHA256 BSTAGE3_BOOTSTRAP_SCRIPT
#   BSTAGE3_STAGE2_THREADS BSTAGE3_STAGE3_THREADS
#   BSTAGE3_STAGE2_CACHE_DIR BSTAGE3_STAGE3_CACHE_DIR
#   BSTAGE3_RUNTIME_PATH BSTAGE3_STAGE2_COMMAND_OUTPUT
#   BSTAGE3_STAGE3_COMMAND_OUTPUT
#   BSTAGE3_BOOTSTRAP_SCRIPT_SHA256_BEFORE BSTAGE3_SEED_INPUTS_FINGERPRINT
#   BSTAGE3_SEED_FEATURES BSTAGE3_GIT_BEFORE BSTAGE3_GIT_AFTER
#   BSTAGE3_STAGE2_TRANSCRIPT BSTAGE3_STAGE3_TRANSCRIPT
#   BSTAGE3_STAGE2_SANITY BSTAGE3_STAGE2_RECEIVER BSTAGE3_STAGE3_SANITY
#   BSTAGE3_TOOL_AUTHORITY BSTAGE3_TOOL_AUTHORITY_BEFORE
#   BSTAGE3_LOCK
