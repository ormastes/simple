#!/bin/sh
# Canonical Stage 3 bootstrap provenance helpers.
#
# This file is sourced by bootstrap-from-scratch.sh and by consumers that need
# to admit the bootstrap compiler without mistaking it for the full CLI.

bootstrap_stage3_provenance_fail() {
    echo "bootstrap Stage 3 provenance: FAIL ($1)" >&2
    return 1
}

bootstrap_stage3_hash_file() {
    [ -f "$1" ] || return 1
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v sha256 >/dev/null 2>&1; then
        sha256 -q "$1"
    else
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    fi
}

# Bind one canonical, non-symlinked comparator executable and its hash.
bootstrap_stage3_compare_bind() {
    bootstrap_stage3_compare_candidate=${BOOTSTRAP_STAGE3_COMPARE_TOOL:-}
    if [ -z "$bootstrap_stage3_compare_candidate" ]; then
        bootstrap_stage3_compare_candidate=$(command -v cmp 2>/dev/null) || return 2
    fi
    bootstrap_stage3_compare_canonical=$(bootstrap_stage3_canonical_file \
        "$bootstrap_stage3_compare_candidate") || return 2
    [ "$bootstrap_stage3_compare_candidate" = \
        "$bootstrap_stage3_compare_canonical" ] || return 2
    bootstrap_stage3_compare_hash=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_compare_canonical") || return 2
    BOOTSTRAP_STAGE3_COMPARE_TOOL="$bootstrap_stage3_compare_canonical"
    BOOTSTRAP_STAGE3_COMPARE_TOOL_SHA256="$bootstrap_stage3_compare_hash"
    export BOOTSTRAP_STAGE3_COMPARE_TOOL \
        BOOTSTRAP_STAGE3_COMPARE_TOOL_SHA256
}

# Compare two regular files with cmp-compatible status semantics. Equal files
# return 0, different files return 1, and missing/unreadable inputs or an
# unavailable/comparator-drifted executable return 2 (or another status >1).
bootstrap_stage3_compare_files() {
    [ "$#" -eq 2 ] || return 2
    [ -f "$1" ] && [ -f "$2" ] || return 2
    [ -n "${BOOTSTRAP_STAGE3_COMPARE_TOOL:-}" ] ||
        bootstrap_stage3_compare_bind || return $?
    bootstrap_stage3_compare_ambient=$(command -v cmp 2>/dev/null) ||
        return 2
    bootstrap_stage3_compare_ambient=$(bootstrap_stage3_canonical_file \
        "$bootstrap_stage3_compare_ambient") || return 2
    [ "$bootstrap_stage3_compare_ambient" = \
        "$BOOTSTRAP_STAGE3_COMPARE_TOOL" ] || return 2
    [ "$(bootstrap_stage3_canonical_file \
        "$BOOTSTRAP_STAGE3_COMPARE_TOOL")" = \
        "$BOOTSTRAP_STAGE3_COMPARE_TOOL" ] || return 2
    [ "$(bootstrap_stage3_hash_file \
        "$BOOTSTRAP_STAGE3_COMPARE_TOOL")" = \
        "${BOOTSTRAP_STAGE3_COMPARE_TOOL_SHA256:-}" ] || return 2
    "$BOOTSTRAP_STAGE3_COMPARE_TOOL" -s "$1" "$2"
}

# Classify a required equality gate without allowing set -e to erase the
# distinction between content drift and comparator infrastructure failure.
bootstrap_stage3_require_equal() {
    bootstrap_stage3_compare_context=$1
    shift
    if bootstrap_stage3_compare_files "$@"; then
        bootstrap_stage3_compare_status=0
    else
        bootstrap_stage3_compare_status=$?
    fi
    case "$bootstrap_stage3_compare_status" in
        0) return 0 ;;
        1)
            echo "error: ${bootstrap_stage3_compare_context} changed: $1 differs from $2" >&2
            return 1
            ;;
        *)
            echo "error: ${bootstrap_stage3_compare_context} comparator unavailable or I/O failed: $1 $2 status=${bootstrap_stage3_compare_status}" >&2
            return "$bootstrap_stage3_compare_status"
            ;;
    esac
}

bootstrap_stage3_hash_stdin() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then shasum -a 256 | awk '{print $1}'
    elif command -v sha256 >/dev/null 2>&1; then sha256 -q
    else return 1
    fi
}

bootstrap_stage3_hash_stream() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | awk '{print $1}'
    elif command -v sha256 >/dev/null 2>&1; then
        sha256 | awk '{print $NF}'
    else
        openssl dgst -sha256 | awk '{print $NF}'
    fi
}

bootstrap_stage3_normalized_absolute() {
    [ "$#" -eq 1 ] || return 1
    case "$1" in
        /) return 0 ;;
        /*) ;;
        *) return 1 ;;
    esac
    case "$1" in *//*|*/./*|*/../*|*/.|*/..|*/) return 1 ;; esac
    printf '%s\n' "$1" | LC_ALL=C grep -Eq '[[:space:][:cntrl:]]' && return 1
    case "$1" in *'*'*|*'?'*|*'['*|*']'*|*'{'*|*'}'*|*'='*) return 1 ;; esac
    return 0
}

bootstrap_stage3_descriptor_map_value() {
    [ "$#" -eq 3 ] || return 1
    bootstrap_stage3_dm_file=$1 bootstrap_stage3_dm_role=$2 bootstrap_stage3_dm_field=$3
    bootstrap_stage3_manifest_value "${bootstrap_stage3_dm_role}_${bootstrap_stage3_dm_field}" \
        "$bootstrap_stage3_dm_file"
}

bootstrap_stage3_vector_frame() {
    for bootstrap_stage3_vf_value in "$@"; do
        bootstrap_stage3_vf_len=${#bootstrap_stage3_vf_value}
        bootstrap_stage3_vf_shift=56
        while [ "$bootstrap_stage3_vf_shift" -ge 0 ]; do
            bootstrap_stage3_vf_byte=$(( (bootstrap_stage3_vf_len >> bootstrap_stage3_vf_shift) & 255 ))
            printf "\\$(printf '%03o' "$bootstrap_stage3_vf_byte")"
            bootstrap_stage3_vf_shift=$((bootstrap_stage3_vf_shift - 8))
        done
        printf %s "$bootstrap_stage3_vf_value"
    done
}

bootstrap_stage3_validate_descriptor_map() (
    [ "$#" -eq 6 ] || return 1
    bootstrap_stage3_dm_snapshot_dir=
    bootstrap_stage3_dm_snapshot=
    bootstrap_stage3_dm_keys=
    bootstrap_stage3_dm_vector_file=
    bootstrap_stage3_dm_cleanup() {
        [ -z "$bootstrap_stage3_dm_keys" ] || rm -f -- "$bootstrap_stage3_dm_keys"
        [ -z "$bootstrap_stage3_dm_vector_file" ] || rm -f -- "$bootstrap_stage3_dm_vector_file"
        [ -z "$bootstrap_stage3_dm_snapshot" ] || rm -f -- "$bootstrap_stage3_dm_snapshot"
        [ -z "$bootstrap_stage3_dm_snapshot_dir" ] ||
            rmdir -- "$bootstrap_stage3_dm_snapshot_dir" 2>/dev/null || :
    }
    trap bootstrap_stage3_dm_cleanup EXIT HUP INT TERM
    bootstrap_stage3_dm_file=$1 bootstrap_stage3_dm_external_sha=$2
    bootstrap_stage3_dm_schema=$3 bootstrap_stage3_dm_run=$4
    bootstrap_stage3_dm_arch=$5 bootstrap_stage3_dm_roles=$6
    expr "$bootstrap_stage3_dm_file" : \
        '/proc/[1-9][0-9]*/fd/[1-9][0-9]*$' >/dev/null || return 1
    [ -f "$bootstrap_stage3_dm_file" ] || return 1
    printf '%s\n' "$bootstrap_stage3_dm_external_sha" | grep -Eq '^[0-9a-f]{64}$' || return 1
    [ "$(bootstrap_stage3_hash_file "$bootstrap_stage3_dm_file")" = "$bootstrap_stage3_dm_external_sha" ] || return 1
    bootstrap_stage3_dm_snapshot_dir=$(mktemp -d "${TMPDIR:-/tmp}/stage3-dmap.XXXXXX") || return 1
    chmod 0700 "$bootstrap_stage3_dm_snapshot_dir" || return 1
    bootstrap_stage3_dm_snapshot="$bootstrap_stage3_dm_snapshot_dir/map"
    (umask 077; set -C; : >"$bootstrap_stage3_dm_snapshot") || return 1
    dd if="$bootstrap_stage3_dm_file" of="$bootstrap_stage3_dm_snapshot" bs=65536 2>/dev/null || return 1
    chmod 0400 "$bootstrap_stage3_dm_snapshot" || return 1
    [ "$(bootstrap_stage3_hash_file "$bootstrap_stage3_dm_snapshot")" = "$bootstrap_stage3_dm_external_sha" ] || return 1
    bootstrap_stage3_dm_file=$bootstrap_stage3_dm_snapshot
    [ "$(bootstrap_stage3_manifest_value schema "$bootstrap_stage3_dm_file")" = "$bootstrap_stage3_dm_schema" ] || return 1
    [ "$(bootstrap_stage3_manifest_value status "$bootstrap_stage3_dm_file")" = ready ] || return 1
    [ "$(bootstrap_stage3_manifest_value run_id "$bootstrap_stage3_dm_file")" = "$bootstrap_stage3_dm_run" ] || return 1
    [ "$(bootstrap_stage3_manifest_value architecture "$bootstrap_stage3_dm_file")" = "$bootstrap_stage3_dm_arch" ] || return 1
    bootstrap_stage3_dm_owner=$(bootstrap_stage3_manifest_value descriptor_owner_pid "$bootstrap_stage3_dm_file") || return 1
    bootstrap_stage3_dm_start=$(bootstrap_stage3_manifest_value descriptor_owner_start_ticks "$bootstrap_stage3_dm_file") || return 1
    case "$bootstrap_stage3_dm_owner:$bootstrap_stage3_dm_start" in *[!0-9:]*|:*|*:) return 1 ;; esac
    [ -r "/proc/$bootstrap_stage3_dm_owner/stat" ] || return 1
    bootstrap_stage3_dm_live_start=$(sed 's/^.*) //' "/proc/$bootstrap_stage3_dm_owner/stat" | awk '{print $20}') || return 1
    [ "$bootstrap_stage3_dm_live_start" = "$bootstrap_stage3_dm_start" ] || return 1
    set -- $bootstrap_stage3_dm_roles
    [ "$(bootstrap_stage3_manifest_value entry_count "$bootstrap_stage3_dm_file")" = "$#" ] || return 1
    bootstrap_stage3_dm_actual=$(sed -n 's/^\([a-z0-9_]*\)_descriptor=.*/\1/p' "$bootstrap_stage3_dm_file" | tr '\n' ' ' | sed 's/ $//')
    [ "$bootstrap_stage3_dm_actual" = "$bootstrap_stage3_dm_roles" ] || return 1
    bootstrap_stage3_dm_expected_lines=$((8 + $# * 6))
    [ "$(wc -l <"$bootstrap_stage3_dm_file" | tr -d ' ')" = "$bootstrap_stage3_dm_expected_lines" ] || return 1
    bootstrap_stage3_dm_keys="${TMPDIR:-/tmp}/stage3-dmap-keys.$$.txt"
    (umask 077; set -C; : >"$bootstrap_stage3_dm_keys") || return 1
    printf '%s\n' schema status run_id architecture descriptor_owner_pid \
        descriptor_owner_start_ticks entry_count map_vector_sha256 >"$bootstrap_stage3_dm_keys"
    for bootstrap_stage3_dm_role in $bootstrap_stage3_dm_roles; do
        for bootstrap_stage3_dm_field in descriptor display_token dev ino mode sha256; do
            printf '%s_%s\n' "$bootstrap_stage3_dm_role" "$bootstrap_stage3_dm_field" >>"$bootstrap_stage3_dm_keys"
        done
    done
    bootstrap_stage3_dm_actual_keys="${TMPDIR:-/tmp}/stage3-dmap-actual.$$.txt"
    sed 's/=.*//' "$bootstrap_stage3_dm_file" >"$bootstrap_stage3_dm_actual_keys" || {
        rm -f "$bootstrap_stage3_dm_keys" "$bootstrap_stage3_dm_actual_keys"
        return 1
    }
    if bootstrap_stage3_require_equal "descriptor map keys" \
        "$bootstrap_stage3_dm_actual_keys" "$bootstrap_stage3_dm_keys"; then
        :
    else
        bootstrap_stage3_dm_compare_status=$?
        rm -f "$bootstrap_stage3_dm_keys" "$bootstrap_stage3_dm_actual_keys"
        return "$bootstrap_stage3_dm_compare_status"
    fi
    rm -f "$bootstrap_stage3_dm_keys" "$bootstrap_stage3_dm_actual_keys"
    bootstrap_stage3_dm_vector_file="${TMPDIR:-/tmp}/stage3-descriptor-vector.$$.bin"
    (umask 077; set -C; : >"$bootstrap_stage3_dm_vector_file") || return 1
    for bootstrap_stage3_dm_role in $bootstrap_stage3_dm_roles; do
        bootstrap_stage3_dm_descriptor=$(bootstrap_stage3_descriptor_map_value "$bootstrap_stage3_dm_file" "$bootstrap_stage3_dm_role" descriptor) || return 1
        bootstrap_stage3_dm_display=$(bootstrap_stage3_descriptor_map_value "$bootstrap_stage3_dm_file" "$bootstrap_stage3_dm_role" display_token) || return 1
        bootstrap_stage3_normalized_absolute "$bootstrap_stage3_dm_display" || return 1
        bootstrap_stage3_dm_dev=$(bootstrap_stage3_descriptor_map_value "$bootstrap_stage3_dm_file" "$bootstrap_stage3_dm_role" dev) || return 1
        bootstrap_stage3_dm_ino=$(bootstrap_stage3_descriptor_map_value "$bootstrap_stage3_dm_file" "$bootstrap_stage3_dm_role" ino) || return 1
        bootstrap_stage3_dm_mode=$(bootstrap_stage3_descriptor_map_value "$bootstrap_stage3_dm_file" "$bootstrap_stage3_dm_role" mode) || return 1
        bootstrap_stage3_dm_sha=$(bootstrap_stage3_descriptor_map_value "$bootstrap_stage3_dm_file" "$bootstrap_stage3_dm_role" sha256) || return 1
        if [ "$bootstrap_stage3_dm_descriptor" = descriptor-absent ]; then
            [ "$bootstrap_stage3_dm_role" = compiler_backfill ] || return 1
            [ "$bootstrap_stage3_dm_dev:$bootstrap_stage3_dm_ino:$bootstrap_stage3_dm_mode:$bootstrap_stage3_dm_sha" = absent:absent:absent:absent ] || return 1
        else
            case "$bootstrap_stage3_dm_descriptor" in "/proc/$bootstrap_stage3_dm_owner/fd/"[0-9]*) ;; *) return 1 ;; esac
            bootstrap_stage3_dm_fd=${bootstrap_stage3_dm_descriptor##*/}; case "$bootstrap_stage3_dm_fd" in ''|*[!0-9]*) return 1 ;; esac
            [ -e "$bootstrap_stage3_dm_descriptor" ] || return 1
            set -- $(stat -Lc '%d %i %f' "$bootstrap_stage3_dm_descriptor") || return 1
            bootstrap_stage3_dm_actual_dev=$1 bootstrap_stage3_dm_actual_ino=$2
            bootstrap_stage3_dm_actual_mode=$(printf '%d' "0x$3") || return 1
            [ "$bootstrap_stage3_dm_actual_dev:$bootstrap_stage3_dm_actual_ino:$bootstrap_stage3_dm_actual_mode" = "$bootstrap_stage3_dm_dev:$bootstrap_stage3_dm_ino:$bootstrap_stage3_dm_mode" ] || return 1
            if [ -d "$bootstrap_stage3_dm_descriptor" ]; then
                [ "$bootstrap_stage3_dm_sha" = identity-only ] || return 1
            else
                printf '%s\n' "$bootstrap_stage3_dm_sha" | grep -Eq '^[0-9a-f]{64}$' || return 1
                [ "$(bootstrap_stage3_hash_file "$bootstrap_stage3_dm_descriptor")" = "$bootstrap_stage3_dm_sha" ] || return 1
            fi
        fi
        bootstrap_stage3_vector_frame "$bootstrap_stage3_dm_role" \
            "$bootstrap_stage3_dm_descriptor" "$bootstrap_stage3_dm_display" \
            "$bootstrap_stage3_dm_dev" "$bootstrap_stage3_dm_ino" \
            "$bootstrap_stage3_dm_mode" "$bootstrap_stage3_dm_sha" \
            >>"$bootstrap_stage3_dm_vector_file" || return 1
    done
    bootstrap_stage3_dm_vector=$(bootstrap_stage3_hash_file "$bootstrap_stage3_dm_vector_file") || return 1
    [ "$(bootstrap_stage3_manifest_value map_vector_sha256 "$bootstrap_stage3_dm_file")" = "$bootstrap_stage3_dm_vector" ] || return 1
    bootstrap_stage3_dm_cleanup
    trap - EXIT HUP INT TERM
)

# Hash an ordered newline-delimited path manifest without starting a hash and
# parser process for every file. The authority manifests already reject
# newline-bearing paths; NUL-delimited xargs keeps every other shell character
# opaque while batching to the host's argument limit. sha256/openssl retain the
# portable single-file path because their multi-file output formats differ.
#
# Large manifests are split into contiguous blocks hashed concurrently, one
# worker per block. Order is still exact: within a block xargs runs its batches
# strictly sequentially in argument order and each hash invocation emits one
# line per input file in the order given, and the blocks themselves are
# contiguous and concatenated in index order -- so output line N still
# corresponds to input line N, which is what the callers that discard the
# filename field and match positionally require. Concurrency is a pure
# throughput change with no effect on the bytes produced.
bootstrap_stage3_hash_path_list_block() {
    # $1 = newline-delimited path file, $2 = hash tool
    if [ "$2" = sha256sum ]; then
        while IFS= read -r bootstrap_stage3_hash_path; do
            printf '%s\0' "$bootstrap_stage3_hash_path"
        done <"$1" |
            xargs -0 sha256sum --
    else
        while IFS= read -r bootstrap_stage3_hash_path; do
            printf '%s\0' "$bootstrap_stage3_hash_path"
        done <"$1" |
            xargs -0 shasum -a 256 --
    fi
}

# Workers for a manifest of $1 lines: an explicit SIMPLE_NATIVE_BUILD_THREADS
# wins, else the host CPU count. Forking is not worth it for a short manifest,
# and a block below the floor buys nothing, so both are clamped -- a small list
# deterministically resolves to 1 worker and the original sequential path.
bootstrap_stage3_hash_worker_count() {
    bootstrap_stage3_hash_wc=${SIMPLE_NATIVE_BUILD_THREADS:-}
    case "$bootstrap_stage3_hash_wc" in
        ''|*[!0-9]*)
            bootstrap_stage3_hash_wc=$(getconf _NPROCESSORS_ONLN 2>/dev/null) ||
                bootstrap_stage3_hash_wc=1
            ;;
    esac
    case "$bootstrap_stage3_hash_wc" in ''|*[!0-9]*) bootstrap_stage3_hash_wc=1 ;; esac
    [ "$bootstrap_stage3_hash_wc" -ge 1 ] 2>/dev/null || bootstrap_stage3_hash_wc=1
    [ "$1" -ge 4096 ] 2>/dev/null || bootstrap_stage3_hash_wc=1
    while [ "$bootstrap_stage3_hash_wc" -gt 1 ] &&
        [ $(( $1 / bootstrap_stage3_hash_wc )) -lt 1024 ]; do
        bootstrap_stage3_hash_wc=$(( bootstrap_stage3_hash_wc - 1 ))
    done
    printf '%s\n' "$bootstrap_stage3_hash_wc"
}

bootstrap_stage3_hash_path_list() {
    [ "$#" -eq 1 ] || return 1
    bootstrap_stage3_hash_paths=$1
    [ -f "$bootstrap_stage3_hash_paths" ] || return 1
    [ -s "$bootstrap_stage3_hash_paths" ] || return 0
    bootstrap_stage3_hash_tool=
    if command -v xargs >/dev/null 2>&1 &&
        printf '' | xargs -0 true >/dev/null 2>&1; then
        if command -v sha256sum >/dev/null 2>&1; then
            bootstrap_stage3_hash_tool=sha256sum
        elif command -v shasum >/dev/null 2>&1; then
            bootstrap_stage3_hash_tool=shasum
        fi
    fi
    if [ -n "$bootstrap_stage3_hash_tool" ]; then
        bootstrap_stage3_hash_lines=$(wc -l <"$bootstrap_stage3_hash_paths") ||
            return 1
        bootstrap_stage3_hash_lines=${bootstrap_stage3_hash_lines# }
        bootstrap_stage3_hash_workers=$(
            bootstrap_stage3_hash_worker_count "$bootstrap_stage3_hash_lines"
        ) || return 1
        if [ "$bootstrap_stage3_hash_workers" -le 1 ]; then
            bootstrap_stage3_hash_path_list_block \
                "$bootstrap_stage3_hash_paths" "$bootstrap_stage3_hash_tool"
            return
        fi
        bootstrap_stage3_hash_dir=$(mktemp -d) || return 1
        bootstrap_stage3_hash_per=$((
            ( bootstrap_stage3_hash_lines + bootstrap_stage3_hash_workers - 1 ) /
            bootstrap_stage3_hash_workers
        ))
        awk -v per="$bootstrap_stage3_hash_per" \
            -v dir="$bootstrap_stage3_hash_dir" '
            { print > sprintf("%s/in.%04d", dir, int((NR - 1) / per)) }
        ' "$bootstrap_stage3_hash_paths" || {
            rm -rf -- "$bootstrap_stage3_hash_dir"
            return 1
        }
        bootstrap_stage3_hash_pids=
        for bootstrap_stage3_hash_block in "$bootstrap_stage3_hash_dir"/in.*; do
            bootstrap_stage3_hash_path_list_block \
                "$bootstrap_stage3_hash_block" \
                "$bootstrap_stage3_hash_tool" \
                >"${bootstrap_stage3_hash_block}.out" &
            bootstrap_stage3_hash_pids="$bootstrap_stage3_hash_pids $!"
        done
        bootstrap_stage3_hash_rc=0
        for bootstrap_stage3_hash_pid in $bootstrap_stage3_hash_pids; do
            wait "$bootstrap_stage3_hash_pid" || bootstrap_stage3_hash_rc=1
        done
        # Emit what was produced even on a partial failure and report the
        # status, exactly as the sequential xargs pipeline does -- callers
        # decide, and swallowing the output here would itself be a behaviour
        # change.
        for bootstrap_stage3_hash_block in \
            "$bootstrap_stage3_hash_dir"/in.*; do
            case "$bootstrap_stage3_hash_block" in *.out) continue ;; esac
            cat -- "${bootstrap_stage3_hash_block}.out" ||
                bootstrap_stage3_hash_rc=1
        done
        rm -rf -- "$bootstrap_stage3_hash_dir"
        return "$bootstrap_stage3_hash_rc"
    fi
    while IFS= read -r bootstrap_stage3_hash_path; do
        bootstrap_stage3_path_hash=$(
            bootstrap_stage3_hash_file "$bootstrap_stage3_hash_path"
        ) || return 1
        printf '%s  %s\n' "$bootstrap_stage3_path_hash" \
            "$bootstrap_stage3_hash_path" || return 1
    done <"$bootstrap_stage3_hash_paths"
}

bootstrap_stage3_args_sha256() {
    for bootstrap_stage3_arg in "$@"; do
        printf '%s:%s\n' "${#bootstrap_stage3_arg}" "$bootstrap_stage3_arg"
    done | bootstrap_stage3_hash_stream
}

bootstrap_stage3_stage2_canonical_env_names() {
    [ "$#" -eq 1 ] || return 1
    printf '%s' 'RUST_LOG LIBRARY_PATH SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256 SIMPLE_BOOTSTRAP SIMPLE_ABI_POLICY SIMPLE_PLUGIN_MANIFEST_POLICY SIMPLE_KERNEL_K1_POLICY SIMPLE_COVERAGE_CUTOVER_STATE SIMPLE_K1_COMPOSITION_SHA256_BEFORE SIMPLE_NO_DEPRECATED_WARNINGS SIMPLE_NATIVE_BUILD_RUST SIMPLE_NO_STUB_FALLBACK SIMPLE_BUILD_PROGRESS_EVENTS SIMPLE_FRONTEND_CACHE SIMPLE_FRONTEND_CACHE_DIR'
    case "$1" in
        *windows-gnu*)
            printf ' %s' 'SIMPLE_WINDOWS_ABI SIMPLE_LINKER_FLAVOR'
            ;;
        *windows-msvc*)
            printf ' %s' 'SIMPLE_WINDOWS_ABI SIMPLE_LINKER_FLAVOR CC CXX'
            ;;
    esac
    printf ' %s\n' 'SIMPLE_PHASE2_COMPATIBILITY_MANIFEST_WRITE SIMPLE_PHASE3_COMPATIBILITY_CACHE_ROOT SIMPLE_BINARY'
}

bootstrap_stage3_env_assignment_names() {
    [ "$#" -gt 0 ] || return 1
    bootstrap_stage3_env_names=
    bootstrap_stage3_env_seen=' '
    for bootstrap_stage3_env_assignment in "$@"; do
        case "$bootstrap_stage3_env_assignment" in
            [A-Z_][A-Z0-9_]*=*) ;;
            *) return 1 ;;
        esac
        bootstrap_stage3_env_name=${bootstrap_stage3_env_assignment%%=*}
        case "$bootstrap_stage3_env_seen" in
            *" $bootstrap_stage3_env_name "*) return 1 ;;
        esac
        bootstrap_stage3_env_seen="${bootstrap_stage3_env_seen}${bootstrap_stage3_env_name} "
        bootstrap_stage3_env_names="${bootstrap_stage3_env_names}${bootstrap_stage3_env_names:+ }${bootstrap_stage3_env_name}"
    done
    printf '%s\n' "$bootstrap_stage3_env_names"
}

# Emit the Stage 3 diagnostic pass-through environment, one NAME=1 assignment
# per line, in a fixed lexical order.
#
# WHY THIS EXISTS.  Stage 3 executes under `env -i` with an explicit allowlist
# (see bootstrap_stage3_run_transcribed).  Every env-gated diagnostic probe
# inside the compiler therefore reads EMPTY during Stage 3 and stays silent,
# even when it was compiled into the admitted Stage 2 binary.  Measured
# 2026-08-17: SIMPLE_HIR_PAYLOAD_LOOKUP_TRACE's literal is present in the
# admitted Stage 2 binary (`strings`) yet emitted zero lines in Stage 3.  About
# ten probes on the Stage 3 compile path were unreachable for the same reason.
# See doc/08_tracking/bug/stage3_env_gated_probes_unreachable_2026-08-17.md.
#
# WHY IT CANNOT WEAKEN THE PROVENANCE GATE.
#  1. NAME allowlist.  Only the fixed names below are considered; there is no
#     prefix rule, no wildcard, and no "pass everything" escape.  Each was
#     read and confirmed to be a pure `if env == "1": print ...` gate on the
#     Stage 3 compile path.  Deliberately EXCLUDED: any path- or level-valued
#     knob (SIMPLE_DIAG_FILE, SIMPLE_MEM_DUMP_PATH, SIMPLE_KEEP_LLVM_IR,
#     SIMPLE_DEBUG_INFO_LEVEL, SIMPLE_OBJDUMP) -- those write files, run tools,
#     or change debug info in the emitted object, i.e. they can alter what
#     Stage 3 BUILDS rather than only what it PRINTS.
#  2. VALUE is constrained to the single literal `1`.  Any other value
#     (including `0`, `2`, a path, or the empty string) is dropped.  A
#     pass-through var therefore cannot carry a payload into the compiler; it
#     can only flip a print gate on.  This also makes the emitted list safe for
#     unquoted word splitting by construction.
#  3. The emitted assignments are appended to the SAME explicit-env vector that
#     both bootstrap_stage3_args_sha256 and the recorded command transcript
#     consume, so the args hash and the transcript keep describing the real
#     invocation.  Turning a probe on DOES change stage3_build_args_sha256 --
#     that is correct and intended: a hash that omitted part of the environment
#     would be the weaker gate.
#  4. With no allowlisted var set to 1 this emits nothing, so the explicit-env
#     vector, the transcript bytes, and the args hash are unchanged.
#
# Note the seed-delegation gate greps the Stage 3 log for `^Build complete: N
# compiled` / `^Linked: ... via clang` and FAILS on their presence.  A probe can
# only ADD lines, so this pass-through can make that gate fail closed but can
# never make it falsely pass.
bootstrap_stage3_diagnostic_env() {
    for bootstrap_stage3_diag_name in \
        SIMPLE_BOOTSTRAP_DIAG \
        SIMPLE_COMPILER_TRACE \
        SIMPLE_HIR_EXPORT_ORIGIN_TRACE \
        SIMPLE_HIR_PAYLOAD_LOOKUP_TRACE \
        SIMPLE_HIR_SIBLING_TRACE \
        SIMPLE_MIR_TAG_PROBE \
        SIMPLE_MIRB_TRACE \
        SIMPLE_MIR_DEFAULT_PAD_TRACE \
        SIMPLE_MIR_FIELD_TRACE \
        SIMPLE_MIR_RET_TRACE; do
        bootstrap_stage3_diag_value=$(
            eval "printf '%s' \"\${${bootstrap_stage3_diag_name}-}\""
        ) || return 1
        [ "$bootstrap_stage3_diag_value" = 1 ] || continue
        printf '%s=1\n' "$bootstrap_stage3_diag_name"
    done
}

# Return one canonical absolute path and reject a symlinked leaf.  pwd -P
# resolves every parent component, so comparing a recorded path with this value
# also rejects aliases through symlinked directories.
bootstrap_stage3_canonical_path() {
    bootstrap_stage3_input=$1
    case "$bootstrap_stage3_input" in
        /*) ;;
        *) return 1 ;;
    esac
    [ ! -L "$bootstrap_stage3_input" ] || return 1
    bootstrap_stage3_parent=$(
        CDPATH= cd -- "$(dirname -- "$bootstrap_stage3_input")" &&
            pwd -P
    ) || return 1
    printf '%s/%s\n' "$bootstrap_stage3_parent" \
        "$(basename -- "$bootstrap_stage3_input")"
}

bootstrap_stage3_canonical_file() {
    [ -f "$1" ] || return 1
    bootstrap_stage3_canonical_path "$1"
}

# Resolve a Stage 3 output directory against the two explicit trust roots.
# Repository-relative inputs remain supported. Absolute inputs are accepted
# only below the physical repository build directory or at/below the separately
# configured external-output root. Canonical equality rejects symlink aliases and the
# component-boundary cases reject prefix collisions (for example /fast/x-evil
# when /fast/x is trusted).
bootstrap_stage3_resume_output_path() {
    [ "$#" -eq 3 ] || return 1
    bootstrap_stage3_resume_requested=$1
    bootstrap_stage3_resume_repo=$2
    bootstrap_stage3_resume_external=$3

    bootstrap_stage3_normalized_absolute "$bootstrap_stage3_resume_repo" || return 1
    [ -d "$bootstrap_stage3_resume_repo" ] &&
        [ ! -L "$bootstrap_stage3_resume_repo" ] || return 1
    bootstrap_stage3_resume_repo_physical=$(
        CDPATH= cd -- "$bootstrap_stage3_resume_repo" && pwd -P
    ) || return 1
    [ "$bootstrap_stage3_resume_repo_physical" = "$bootstrap_stage3_resume_repo" ] || return 1
    bootstrap_stage3_resume_build="$bootstrap_stage3_resume_repo/build"
    [ -d "$bootstrap_stage3_resume_build" ] &&
        [ ! -L "$bootstrap_stage3_resume_build" ] || return 1
    bootstrap_stage3_resume_build_physical=$(
        CDPATH= cd -- "$bootstrap_stage3_resume_build" && pwd -P
    ) || return 1
    [ "$bootstrap_stage3_resume_build_physical" = \
        "$bootstrap_stage3_resume_build" ] || return 1

    if [ -n "$bootstrap_stage3_resume_external" ]; then
        bootstrap_stage3_normalized_absolute "$bootstrap_stage3_resume_external" || return 1
        [ "$bootstrap_stage3_resume_external" != / ] || return 1
        [ -d "$bootstrap_stage3_resume_external" ] &&
            [ ! -L "$bootstrap_stage3_resume_external" ] || return 1
        bootstrap_stage3_resume_external_physical=$(
            CDPATH= cd -- "$bootstrap_stage3_resume_external" && pwd -P
        ) || return 1
        [ "$bootstrap_stage3_resume_external_physical" = \
            "$bootstrap_stage3_resume_external" ] || return 1
    fi

    case "$bootstrap_stage3_resume_requested" in
        /*) bootstrap_stage3_resume_candidate=$bootstrap_stage3_resume_requested ;;
        *../*|../*|*/..|..|'') return 1 ;;
        *) bootstrap_stage3_resume_candidate="$bootstrap_stage3_resume_repo/$bootstrap_stage3_resume_requested" ;;
    esac
    bootstrap_stage3_normalized_absolute "$bootstrap_stage3_resume_candidate" || return 1
    [ -d "$bootstrap_stage3_resume_candidate" ] &&
        [ ! -L "$bootstrap_stage3_resume_candidate" ] || return 1
    bootstrap_stage3_resume_physical=$(
        CDPATH= cd -- "$bootstrap_stage3_resume_candidate" && pwd -P
    ) || return 1
    [ "$bootstrap_stage3_resume_physical" = "$bootstrap_stage3_resume_candidate" ] || return 1

    case "$bootstrap_stage3_resume_physical" in
        "$bootstrap_stage3_resume_build"/*) ;;
        *)
            [ -n "$bootstrap_stage3_resume_external" ] || return 1
            case "$bootstrap_stage3_resume_physical" in
                "$bootstrap_stage3_resume_external"|"$bootstrap_stage3_resume_external"/*) ;;
                *) return 1 ;;
            esac
            ;;
    esac
    BOOTSTRAP_STAGE3_RESUME_OUTPUT=$bootstrap_stage3_resume_physical
    export BOOTSTRAP_STAGE3_RESUME_OUTPUT
}

# Resolve the one writable Cargo/seed authority target. Callers may place the
# whole target on a larger filesystem, but may not split generations, markers,
# locks, and the compatibility view across trust roots. The parent must already
# exist and both the requested leaf and its parent chain are resolved without
# accepting a symlink leaf.
bootstrap_stage3_prepare_authority_target_root() {
    [ "$#" -eq 1 ] || return 1
    bootstrap_stage3_authority_requested=$1
    case "$bootstrap_stage3_authority_requested" in /*) ;; *) return 1 ;; esac
    [ ! -L "$bootstrap_stage3_authority_requested" ] || return 1
    bootstrap_stage3_authority_canonical=$(
        bootstrap_stage3_canonical_path \
            "$bootstrap_stage3_authority_requested"
    ) || return 1
    if [ -e "$bootstrap_stage3_authority_requested" ]; then
        [ -d "$bootstrap_stage3_authority_requested" ] || return 1
    else
        mkdir "$bootstrap_stage3_authority_canonical" || return 1
    fi
    [ -d "$bootstrap_stage3_authority_canonical" ] &&
        [ ! -L "$bootstrap_stage3_authority_canonical" ] || return 1
    bootstrap_stage3_authority_physical=$(
        CDPATH= cd -- "$bootstrap_stage3_authority_canonical" && pwd -P
    ) || return 1
    [ "$bootstrap_stage3_authority_physical" = \
        "$bootstrap_stage3_authority_canonical" ] || return 1
    printf '%s\n' "$bootstrap_stage3_authority_canonical"
}

# Bind an existing directory authority to its physical root.  A worktree may
# intentionally provide the authority root as a symlink to a completed Rust
# bootstrap tree.  Resolving only the root keeps directory_snapshot's stricter
# invariant intact: symlinks contained by that tree are still rejected.
bootstrap_stage3_physical_directory() (
    [ -d "$1" ] || return 1
    CDPATH= cd -- "$1" && pwd -P
)

bootstrap_stage3_host_platform() {
    bootstrap_stage3_host_arch=$(uname -m 2>/dev/null) || return 1
    bootstrap_stage3_host_os=$(uname -s 2>/dev/null) || return 1
    case "$bootstrap_stage3_host_arch:$bootstrap_stage3_host_os" in
        arm64:Darwin|aarch64:Darwin) echo aarch64-apple-darwin ;;
        x86_64:Darwin) echo x86_64-apple-darwin ;;
        x86_64:Linux) echo x86_64-unknown-linux-gnu ;;
        arm64:Linux|aarch64:Linux) echo aarch64-unknown-linux-gnu ;;
        x86_64:FreeBSD) echo x86_64-unknown-freebsd ;;
        arm64:FreeBSD|aarch64:FreeBSD) echo aarch64-unknown-freebsd ;;
        x86_64:MINGW*|x86_64:MSYS*|x86_64:CYGWIN*|x86_64:Windows*)
            case "${SIMPLE_WINDOWS_ABI:-${MSYSTEM:+gnu}}" in
                gnu) echo x86_64-pc-windows-gnu ;;
                ""|msvc) echo x86_64-pc-windows-msvc ;;
                *) return 1 ;;
            esac
            ;;
        *) return 1 ;;
    esac
}

bootstrap_stage3_target_c_compiler() {
    case "$1" in
        *-pc-windows-msvc)
            # Honor an explicitly selected MSVC-compatible compiler.  This is
            # needed on hosts where cl.exe passes the lightweight authority
            # probe but fails later in cc-rs while clang-cl succeeds under the
            # same MSVC ABI and hermetic environment.  The runnable compiler
            # probe remains the admission gate, and its exact path is included
            # in the tool-authority fingerprint.
            if [ -n "${CC:-}" ]; then
                bootstrap_stage3_windows_runnable_compiler "$CC" '/?' &&
                    return 0
            fi
            bootstrap_stage3_windows_runnable_compiler cl.exe '/?' ||
                bootstrap_stage3_windows_runnable_compiler clang-cl.exe '--version'
            ;;
        x86_64-pc-windows-gnu)
            command -v "${CC_x86_64_pc_windows_gnu:-gcc}" 2>/dev/null
            ;;
        *)
            command -v cc 2>/dev/null
            ;;
    esac
}

bootstrap_stage3_windows_msvc_candidate_path() {
    case "$1" in
        */msys*/*|*/mingw*/*) return 1 ;;
        *) return 0 ;;
    esac
}

bootstrap_stage3_windows_runnable_compiler() {
    bootstrap_stage3_windows_name=$1
    bootstrap_stage3_windows_probe_arg=$2
    bootstrap_stage3_windows_candidates=""
    if command -v where.exe >/dev/null 2>&1; then
        bootstrap_stage3_windows_candidates=$(
            where.exe "$bootstrap_stage3_windows_name" 2>/dev/null |
                tr -d '\r'
        ) || bootstrap_stage3_windows_candidates=""
    fi
    if [ -z "$bootstrap_stage3_windows_candidates" ]; then
        bootstrap_stage3_windows_candidate=$(
            command -v "$bootstrap_stage3_windows_name" 2>/dev/null
        ) || return 1
        bootstrap_stage3_windows_candidates=$bootstrap_stage3_windows_candidate
    fi

    bootstrap_stage3_windows_old_ifs=$IFS
    IFS='
'
    for bootstrap_stage3_windows_candidate in $bootstrap_stage3_windows_candidates; do
        IFS=$bootstrap_stage3_windows_old_ifs
        if command -v cygpath >/dev/null 2>&1; then
            bootstrap_stage3_windows_candidate=$(
                cygpath -u "$bootstrap_stage3_windows_candidate" 2>/dev/null
            ) || continue
        fi
        # A clang-cl shipped inside an MSYS2/MinGW toolchain is not an MSVC
        # authority. It may run through the owning POSIX shell while failing
        # from Cargo's native CreateProcess path (for example 0xc0000135 when
        # its MinGW runtime DLL is unavailable or shadowed).
        bootstrap_stage3_windows_msvc_candidate_path \
            "$bootstrap_stage3_windows_candidate" || continue
        bootstrap_stage3_windows_probe_source=$(mktemp \
            "${TMPDIR:-/tmp}/simple-cc-probe.XXXXXX.c") || return 1
        bootstrap_stage3_windows_probe_object=\
"${bootstrap_stage3_windows_probe_source%.c}.obj"
        printf 'int simple_cc_probe(void) { return 0; }\n' \
            >"$bootstrap_stage3_windows_probe_source" || return 1
        bootstrap_stage3_windows_probe_source_arg=\
$bootstrap_stage3_windows_probe_source
        bootstrap_stage3_windows_probe_object_arg=\
$bootstrap_stage3_windows_probe_object
        if command -v cygpath >/dev/null 2>&1; then
            bootstrap_stage3_windows_probe_source_arg=$(cygpath -w \
                "$bootstrap_stage3_windows_probe_source") || return 1
            bootstrap_stage3_windows_probe_object_arg=$(cygpath -w \
                "$bootstrap_stage3_windows_probe_object") || return 1
        fi
        # Admission must match the hermetic Rust-authority Cargo environment.
        # Compile a translation unit rather than trusting --version: some
        # broken Windows installations start their driver but fail when the
        # frontend or a runtime DLL is loaded by Cargo's cc-rs.
        if [ -x "$bootstrap_stage3_windows_candidate" ] &&
           env -i PATH="$PATH" LC_ALL=C LANG=C \
                MSYS2_ARG_CONV_EXCL='*' \
                INCLUDE="${INCLUDE:-}" LIB="${LIB:-}" \
                LIBPATH="${LIBPATH:-}" \
                SystemRoot="${SystemRoot:-${SYSTEMROOT:-${WINDIR:-${windir:-}}}}" \
                SystemDrive="${SystemDrive:-${SYSTEMDRIVE:-}}" \
                ProgramData="${ProgramData:-${PROGRAMDATA:-}}" \
                TEMP="${TEMP:-${TMPDIR:-/tmp}}" \
                "$bootstrap_stage3_windows_candidate" \
                /nologo /c "/Fo$bootstrap_stage3_windows_probe_object_arg" \
                "$bootstrap_stage3_windows_probe_source_arg" \
                >/dev/null 2>&1; then
            rm -f "$bootstrap_stage3_windows_probe_source" \
                "$bootstrap_stage3_windows_probe_object"
            printf '%s\n' "$bootstrap_stage3_windows_candidate"
            IFS=$bootstrap_stage3_windows_old_ifs
            return 0
        fi
        rm -f "$bootstrap_stage3_windows_probe_source" \
            "$bootstrap_stage3_windows_probe_object"
        IFS='
'
    done
    IFS=$bootstrap_stage3_windows_old_ifs
    return 1
}

# rustc is native on Windows, so --print sysroot can return a drive path and
# CRLF even when this authority runs under a POSIX shell. Normalize only that
# representation; relative paths and additional output are never authorities.
bootstrap_stage3_rust_sysroot_path() (
    [ "$#" -eq 1 ] || return 1
    bootstrap_stage3_sysroot_input=${1%"$(printf '\r')"}
    case "$bootstrap_stage3_sysroot_input" in
        [A-Za-z]:[\\/]*)
            command -v cygpath >/dev/null 2>&1 || return 1
            bootstrap_stage3_sysroot_input=$(
                cygpath -u "$bootstrap_stage3_sysroot_input"
            ) || return 1
            ;;
        /*) ;;
        *) return 1 ;;
    esac
    case "$bootstrap_stage3_sysroot_input" in /*) ;; *) return 1 ;; esac
    if printf '%s\n' "$bootstrap_stage3_sysroot_input" |
        LC_ALL=C grep -q '[[:cntrl:]]'; then
        return 1
    fi
    case "$bootstrap_stage3_sysroot_input" in *'
'*) return 1 ;; esac
    CDPATH= cd -- "$bootstrap_stage3_sysroot_input" && pwd -P
)

# Prefer the installed toolchain behind a canonical rustup proxy.  Invoking the
# proxy to discover its sysroot is avoidable ambient state: on Windows the
# native proxy has intermittently failed under the otherwise valid `env -i`
# authority environment.  The proxy location, rustup settings, repository
# policy channel, and recorded host tuple name one installed directory without
# a PATH search.  Status 2 means the frontend is not a standard rustup layout;
# status 1 means it is a recognized layout whose authority is invalid and must
# fail closed rather than falling back to the proxy.
bootstrap_stage3_rust_toolchain_trace() {
    [ "${BOOTSTRAP_STAGE3_FINGERPRINT_TRACE:-0}" = 1 ] || return 0
    case "$1" in
        *[!A-Za-z0-9._=-]*) return 1 ;;
    esac
    printf 'rust-toolchain-check=%s\n' "$1" >&2
}

# Native metadata commands are read-only. Recorded Windows launch failures have
# not reproduced in focused probes of the same installed executable and PATH.
# Permit one immediate second launch with identical argv and clean environment.
# Bind the executable's bytes around each launch; publish only successful stdout
# and retain both attempt statuses/stderr when recovery is needed. This helper
# must not wrap builds or other commands with side effects.
bootstrap_stage3_native_metadata_probe() (
    [ "$#" -ge 3 ] || return 1
    bootstrap_stage3_probe_label=$1
    shift
    case "$bootstrap_stage3_probe_label" in
        ''|*[!A-Za-z0-9._-]*) return 1 ;;
    esac
    bootstrap_stage3_probe_tool=$1
    case "$bootstrap_stage3_probe_tool" in
        /*) ;;
        *) return 1 ;;
    esac
    [ -f "$bootstrap_stage3_probe_tool" ] &&
        [ -x "$bootstrap_stage3_probe_tool" ] || return 1
    bootstrap_stage3_probe_sha=$(
        bootstrap_stage3_hash_file "$bootstrap_stage3_probe_tool"
    ) || return 1
    [ "${#bootstrap_stage3_probe_sha}" -eq 64 ] || return 1
    case "$bootstrap_stage3_probe_sha" in *[!0-9a-f]*) return 1 ;; esac
    bootstrap_stage3_probe_tmp=$(mktemp -d \
        "${TMPDIR:-/tmp}/bootstrap-native-probe.XXXXXX") || return 1
    trap 'rm -rf -- "$bootstrap_stage3_probe_tmp"' EXIT HUP INT TERM
    for bootstrap_stage3_probe_attempt in 1 2; do
        bootstrap_stage3_probe_current=$(
            bootstrap_stage3_hash_file "$bootstrap_stage3_probe_tool"
        ) || return 1
        [ "$bootstrap_stage3_probe_current" = "$bootstrap_stage3_probe_sha" ] || {
            printf 'bootstrap-native-metadata-probe=%s result=binary-changed\n' \
                "$bootstrap_stage3_probe_label" >&2
            return 1
        }
        bootstrap_stage3_probe_status=0
        env -i PATH="$PATH" LC_ALL=C LANG=C "$@" \
            >"$bootstrap_stage3_probe_tmp/stdout" \
            2>"$bootstrap_stage3_probe_tmp/stderr" || bootstrap_stage3_probe_status=$?
        if [ "$bootstrap_stage3_probe_status" -ne 0 ] ||
            [ "$bootstrap_stage3_probe_attempt" -eq 2 ]; then
            printf 'bootstrap-native-metadata-probe=%s attempt=%s shell-status=%s\n' \
                "$bootstrap_stage3_probe_label" "$bootstrap_stage3_probe_attempt" \
                "$bootstrap_stage3_probe_status" >&2
            head -c 4096 "$bootstrap_stage3_probe_tmp/stderr" >&2
            printf '\n' >&2
        fi
        bootstrap_stage3_probe_current=$(
            bootstrap_stage3_hash_file "$bootstrap_stage3_probe_tool"
        ) || return 1
        [ "$bootstrap_stage3_probe_current" = "$bootstrap_stage3_probe_sha" ] || {
            printf 'bootstrap-native-metadata-probe=%s result=binary-changed\n' \
                "$bootstrap_stage3_probe_label" >&2
            return 1
        }
        if [ "$bootstrap_stage3_probe_status" -eq 0 ]; then
            cat "$bootstrap_stage3_probe_tmp/stdout"
            return $?
        fi
    done
    return "$bootstrap_stage3_probe_status"
)

bootstrap_stage3_installed_rust_toolchain() (
    [ "$#" -eq 4 ] || return 1
    bootstrap_stage3_installed_frontend=$1
    bootstrap_stage3_installed_channel=$2
    bootstrap_stage3_installed_path=$3
    bootstrap_stage3_installed_root=$4
    case "$bootstrap_stage3_installed_frontend" in
        */.cargo/bin/rustc)
            bootstrap_stage3_installed_prefix=\
${bootstrap_stage3_installed_frontend%/.cargo/bin/rustc}
            ;;
        */.cargo/bin/rustc.exe)
            bootstrap_stage3_installed_prefix=\
${bootstrap_stage3_installed_frontend%/.cargo/bin/rustc.exe}
            ;;
        *)
            bootstrap_stage3_rust_toolchain_trace layout=non-rustup
            return 2
            ;;
    esac
    bootstrap_stage3_rust_toolchain_trace layout=rustup
    bootstrap_stage3_installed_home=\
"$bootstrap_stage3_installed_prefix/.rustup"
    [ -d "$bootstrap_stage3_installed_home" ] || {
        bootstrap_stage3_rust_toolchain_trace rustup-home=absent
        return 2
    }
    [ ! -L "$bootstrap_stage3_installed_home" ] || {
        bootstrap_stage3_rust_toolchain_trace rustup-home=symlink
        return 1
    }
    bootstrap_stage3_installed_home_physical=$(
        CDPATH= cd -- "$bootstrap_stage3_installed_home" && pwd -P
    ) || {
        bootstrap_stage3_rust_toolchain_trace rustup-home=unreadable
        return 1
    }
    [ "$bootstrap_stage3_installed_home_physical" = \
        "$bootstrap_stage3_installed_home" ] || {
        bootstrap_stage3_rust_toolchain_trace rustup-home=noncanonical
        return 1
    }
    bootstrap_stage3_rust_toolchain_trace rustup-home=pass
    bootstrap_stage3_installed_settings=\
"$bootstrap_stage3_installed_home/settings.toml"
    [ "$(bootstrap_stage3_canonical_file \
        "$bootstrap_stage3_installed_settings")" = \
        "$bootstrap_stage3_installed_settings" ] || {
        bootstrap_stage3_rust_toolchain_trace settings=noncanonical
        return 1
    }
    bootstrap_stage3_installed_host=$(
        awk -F= -v channel="$bootstrap_stage3_installed_channel" '
            /^[[:space:]]*default_host_tuple[[:space:]]*=/ {
                value = $2
                gsub(/^[[:space:]]*"/, "", value)
                gsub(/"[[:space:]]*$/, "", value)
                legacy = value
                legacy_count += 1
            }
            /^[[:space:]]*default_toolchain[[:space:]]*=/ {
                value = $2
                gsub(/^[[:space:]]*"/, "", value)
                gsub(/"[[:space:]]*$/, "", value)
                modern = value
                modern_count += 1
            }
            END {
                if (legacy_count > 1 || modern_count > 1) exit 1
                if (legacy_count == 1) {
                    if (modern_count == 1) {
                        prefix = channel "-"
                        if (index(modern, prefix) != 1) exit 1
                        modern_host = substr(modern, length(prefix) + 1)
                        if (modern_host == "" || modern_host != legacy) exit 1
                    }
                    print legacy
                    exit 0
                }
                if (modern_count != 1) exit 1
                prefix = channel "-"
                if (index(modern, prefix) != 1) exit 1
                host = substr(modern, length(prefix) + 1)
                if (host == "") exit 1
                print host
            }
        ' "$bootstrap_stage3_installed_settings"
    ) || {
        bootstrap_stage3_rust_toolchain_trace settings-host=parse-fail
        return 1
    }
    case "$bootstrap_stage3_installed_host" in
        ''|*[!A-Za-z0-9._-]*)
            bootstrap_stage3_rust_toolchain_trace settings-host=invalid
            return 1
            ;;
    esac
    bootstrap_stage3_rust_toolchain_trace settings-host=pass
    case "$bootstrap_stage3_installed_channel" in
        *-"$bootstrap_stage3_installed_host")
            bootstrap_stage3_installed_name=\
$bootstrap_stage3_installed_channel
            ;;
        *)
            bootstrap_stage3_installed_name=\
"$bootstrap_stage3_installed_channel-$bootstrap_stage3_installed_host"
            ;;
    esac
    bootstrap_stage3_installed_toolchain=\
"$bootstrap_stage3_installed_home/toolchains/$bootstrap_stage3_installed_name"
    [ -d "$bootstrap_stage3_installed_toolchain" ] &&
        [ ! -L "$bootstrap_stage3_installed_toolchain" ] || {
        bootstrap_stage3_rust_toolchain_trace toolchain-directory=invalid
        return 1
    }
    [ "$(CDPATH= cd -- "$bootstrap_stage3_installed_toolchain" && pwd -P)" = \
        "$bootstrap_stage3_installed_toolchain" ] || {
        bootstrap_stage3_rust_toolchain_trace toolchain-directory=noncanonical
        return 1
    }
    bootstrap_stage3_rust_toolchain_trace toolchain-directory=pass
    bootstrap_stage3_installed_suffix=
    case "$bootstrap_stage3_installed_host" in
        *-pc-windows-gnu|*-pc-windows-msvc) bootstrap_stage3_installed_suffix=.exe ;;
    esac
    bootstrap_stage3_installed_rustc=\
"$bootstrap_stage3_installed_toolchain/bin/rustc$bootstrap_stage3_installed_suffix"
    bootstrap_stage3_installed_cargo=\
"$bootstrap_stage3_installed_toolchain/bin/cargo$bootstrap_stage3_installed_suffix"
    for bootstrap_stage3_installed_binary in \
        "$bootstrap_stage3_installed_rustc" \
        "$bootstrap_stage3_installed_cargo"; do
        [ "$(bootstrap_stage3_canonical_file \
            "$bootstrap_stage3_installed_binary")" = \
            "$bootstrap_stage3_installed_binary" ] || {
            bootstrap_stage3_rust_toolchain_trace installed-binary=invalid
            return 1
        }
    done
    bootstrap_stage3_rust_toolchain_trace installed-binaries=pass
    bootstrap_stage3_installed_reported_sysroot=$(
        PATH="$bootstrap_stage3_installed_path" \
            bootstrap_stage3_native_metadata_probe rustc-sysroot \
            "$bootstrap_stage3_installed_rustc" --print sysroot
    ) || {
        bootstrap_stage3_rust_toolchain_trace rustc-sysroot-command=fail
        return 1
    }
    bootstrap_stage3_rust_toolchain_trace rustc-sysroot-command=pass
    bootstrap_stage3_installed_reported_sysroot=$(
        bootstrap_stage3_rust_sysroot_path \
            "$bootstrap_stage3_installed_reported_sysroot"
    ) || {
        bootstrap_stage3_rust_toolchain_trace rustc-sysroot-path=invalid
        return 1
    }
    [ "$bootstrap_stage3_installed_reported_sysroot" = \
        "$bootstrap_stage3_installed_toolchain" ] || {
        bootstrap_stage3_rust_toolchain_trace rustc-sysroot-match=fail
        return 1
    }
    bootstrap_stage3_rust_toolchain_trace rustc-sysroot-match=pass
    bootstrap_stage3_installed_version=$(
        PATH="$bootstrap_stage3_installed_path" \
            bootstrap_stage3_native_metadata_probe rustc-version \
            "$bootstrap_stage3_installed_rustc" -vV
    ) || {
        bootstrap_stage3_rust_toolchain_trace rustc-version-command=fail
        return 1
    }
    bootstrap_stage3_installed_reported_host=$(
        printf '%s\n' "$bootstrap_stage3_installed_version" |
            awk '
                { sub(/\r$/, "") }
                /^host: / { print substr($0, 7); count += 1 }
                END { if (count != 1) exit 1 }
            '
    ) || {
        bootstrap_stage3_rust_toolchain_trace rustc-version-host=parse-fail
        return 1
    }
    [ "$bootstrap_stage3_installed_reported_host" = \
        "$bootstrap_stage3_installed_host" ] || {
        bootstrap_stage3_rust_toolchain_trace rustc-version-host=mismatch
        return 1
    }
    bootstrap_stage3_rust_toolchain_trace rustc-version-host=pass
    PATH="$bootstrap_stage3_installed_path" \
        bootstrap_stage3_native_metadata_probe cargo-version \
        "$bootstrap_stage3_installed_cargo" -V >/dev/null || {
        bootstrap_stage3_rust_toolchain_trace cargo-version-command=fail
        return 1
    }
    bootstrap_stage3_rust_toolchain_trace cargo-version-command=pass
    printf 'rustup-home-path=%s\nrustup-settings-path=%s\n' \
        "$bootstrap_stage3_installed_home" \
        "$bootstrap_stage3_installed_settings"
    printf 'rustup-settings-sha256=%s\nrust-toolchain-name=%s\n' \
        "$(bootstrap_stage3_hash_file \
            "$bootstrap_stage3_installed_settings")" \
        "$bootstrap_stage3_installed_name"
    printf 'rust-host=%s\nrust-sysroot=%s\nrustc-path=%s\ncargo-path=%s\n' \
        "$bootstrap_stage3_installed_host" \
        "$bootstrap_stage3_installed_toolchain" \
        "$bootstrap_stage3_installed_rustc" \
        "$bootstrap_stage3_installed_cargo"
)

bootstrap_stage3_resolve_rust_toolchain() (
    bootstrap_stage3_rust_toolchain_trace resolver=entered
    [ "$#" -eq 2 ] || {
        bootstrap_stage3_rust_toolchain_trace resolver-arguments=invalid
        return 1
    }
    bootstrap_stage3_rust_root=$1
    bootstrap_stage3_rust_path=$2
    [ "$(bootstrap_stage3_canonical_path \
        "$bootstrap_stage3_rust_root")" = \
        "$bootstrap_stage3_rust_root" ] || {
        bootstrap_stage3_rust_toolchain_trace resolver-root=noncanonical
        return 1
    }
    bootstrap_stage3_rust_toolchain_trace resolver-root=pass
    case "$bootstrap_stage3_rust_path" in
        /*) ;;
        *)
            bootstrap_stage3_rust_toolchain_trace resolver-path=relative
            return 1
            ;;
    esac
    if printf '%s\n' "$bootstrap_stage3_rust_path" |
        grep -Eq '(^|:)([^/]|$)'; then
        bootstrap_stage3_rust_toolchain_trace resolver-path=invalid
        return 1
    fi
    bootstrap_stage3_rust_toolchain_trace resolver-path=pass
    PATH=$bootstrap_stage3_rust_path
    export PATH
    bootstrap_stage3_rust_policy=\
"$bootstrap_stage3_rust_root/src/compiler_rust/rust-toolchain.toml"
    [ "$(bootstrap_stage3_canonical_file \
        "$bootstrap_stage3_rust_policy")" = \
        "$bootstrap_stage3_rust_policy" ] || {
        bootstrap_stage3_rust_toolchain_trace resolver-policy=noncanonical
        return 1
    }
    bootstrap_stage3_rust_channel=$(
        awk -F= '
            /^[[:space:]]*channel[[:space:]]*=/ {
                value = $2
                gsub(/^[[:space:]]*"/, "", value)
                gsub(/"[[:space:]]*$/, "", value)
                print value
                count += 1
            }
            END { if (count != 1) exit 1 }
        ' "$bootstrap_stage3_rust_policy"
    ) || {
        bootstrap_stage3_rust_toolchain_trace resolver-channel=parse-fail
        return 1
    }
    case "$bootstrap_stage3_rust_channel" in
        ''|*[!A-Za-z0-9._-]*)
            bootstrap_stage3_rust_toolchain_trace resolver-channel=invalid
            return 1
            ;;
    esac
    bootstrap_stage3_rust_toolchain_trace resolver-policy=pass
    bootstrap_stage3_rust_frontend=$(command -v rustc) || {
        bootstrap_stage3_rust_toolchain_trace resolver-frontend=absent
        return 1
    }
    bootstrap_stage3_rust_toolchain_trace resolver-frontend=pass
    if bootstrap_stage3_rust_installed=$(
        bootstrap_stage3_installed_rust_toolchain \
            "$bootstrap_stage3_rust_frontend" \
            "$bootstrap_stage3_rust_channel" "$PATH" \
            "$bootstrap_stage3_rust_root"
    ); then
        printf 'rust-policy-path=%s\nrust-policy-sha256=%s\nrust-channel=%s\n' \
            "$bootstrap_stage3_rust_policy" \
            "$(bootstrap_stage3_hash_file "$bootstrap_stage3_rust_policy")" \
            "$bootstrap_stage3_rust_channel"
        printf '%s\n' "$bootstrap_stage3_rust_installed"
        return 0
    else
        bootstrap_stage3_rust_installed_status=$?
    fi
    [ "$bootstrap_stage3_rust_installed_status" -eq 2 ] || return 1
    bootstrap_stage3_rust_sysroot=$(
        env -i PATH="$PATH" \
            RUSTUP_TOOLCHAIN="$bootstrap_stage3_rust_channel" \
            "$bootstrap_stage3_rust_frontend" --print sysroot
    ) || return 1
    bootstrap_stage3_rust_sysroot=$(
        bootstrap_stage3_rust_sysroot_path "$bootstrap_stage3_rust_sysroot"
    ) || {
        echo 'bootstrap Rust authority: invalid or inaccessible sysroot' >&2
        return 1
    }
    bootstrap_stage3_rust_suffix=
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) bootstrap_stage3_rust_suffix=.exe ;;
    esac
    bootstrap_stage3_rustc="$bootstrap_stage3_rust_sysroot/bin/rustc$bootstrap_stage3_rust_suffix"
    bootstrap_stage3_cargo="$bootstrap_stage3_rust_sysroot/bin/cargo$bootstrap_stage3_rust_suffix"
    for bootstrap_stage3_rust_binary in \
        "$bootstrap_stage3_rustc" "$bootstrap_stage3_cargo"; do
        [ -x "$bootstrap_stage3_rust_binary" ] &&
            [ ! -L "$bootstrap_stage3_rust_binary" ] &&
            [ "$(bootstrap_stage3_canonical_file \
                "$bootstrap_stage3_rust_binary")" = \
                "$bootstrap_stage3_rust_binary" ] || return 1
    done
    printf 'rust-policy-path=%s\nrust-policy-sha256=%s\nrust-channel=%s\n' \
        "$bootstrap_stage3_rust_policy" \
        "$(bootstrap_stage3_hash_file "$bootstrap_stage3_rust_policy")" \
        "$bootstrap_stage3_rust_channel"
    printf 'rust-sysroot=%s\nrustc-path=%s\ncargo-path=%s\n' \
        "$bootstrap_stage3_rust_sysroot" "$bootstrap_stage3_rustc" \
        "$bootstrap_stage3_cargo"
)

# The MSVC `LIB` search path is a semicolon-separated list of NATIVE Windows
# directories. Emit it as newline-separated POSIX paths so the `.lib` token
# branch can test each one. Empty when LIB is unset (a non-MSVC lane), which
# makes the caller's loop a no-op rather than an error.
bootstrap_stage3_llvm_msvc_lib_dirs() {
    [ -n "${LIB:-}" ] || return 0
    command -v cygpath >/dev/null 2>&1 || return 0
    # Trailing newline is load-bearing: with `printf '%s'` the final LIB entry
    # is unterminated and `read` discards it -- which silently dropped the
    # Windows SDK `um/x64` directory, the one holding psapi.lib.
    printf '%s
' "$LIB" | tr ';' '
' | while IFS= read -r bootstrap_stage3_llvm_msvc_raw; do
        [ -n "$bootstrap_stage3_llvm_msvc_raw" ] || continue
        cygpath -u "$bootstrap_stage3_llvm_msvc_raw" 2>/dev/null || true
    done
}

# Print the first directory-qualified match for an MSVC import library, or
# nothing. $1 is the bare token (`psapi.lib`), $2 the LLVM libdir searched
# ahead of the SDK path. Reads line-oriented so directories containing spaces
# survive.
bootstrap_stage3_llvm_msvc_find_lib() {
    [ "$#" -eq 2 ] || return 0
    bootstrap_stage3_llvm_msvc_token=$1
    { printf '%s
' "$2"; bootstrap_stage3_llvm_msvc_lib_dirs; } |
        while IFS= read -r bootstrap_stage3_llvm_msvc_dir; do
            [ -n "$bootstrap_stage3_llvm_msvc_dir" ] || continue
            if [ -f "$bootstrap_stage3_llvm_msvc_dir/$bootstrap_stage3_llvm_msvc_token" ]; then
                printf '%s
' "$bootstrap_stage3_llvm_msvc_dir/$bootstrap_stage3_llvm_msvc_token"
                break
            fi
        done
}

bootstrap_stage3_resolve_llvm_build_authority() (
    [ "$#" -eq 2 ] || return 1
    bootstrap_stage3_llvm_path=$1
    bootstrap_stage3_llvm_features=$2
    case "$bootstrap_stage3_llvm_features" in
        *llvm*) ;;
        *)
            echo 'llvm-build-status=disabled'
            return 0
            ;;
    esac
    case "$bootstrap_stage3_llvm_path" in
        /*) ;;
        *) return 1 ;;
    esac
    PATH=$bootstrap_stage3_llvm_path
    export PATH
    bootstrap_stage3_llvm_config=$(command -v llvm-config) || return 1
    bootstrap_stage3_llvm_config_canonical=$(
        perl -MCwd=abs_path -e \
            'my $p = abs_path($ARGV[0]); defined($p) or exit 1; print $p' \
            "$bootstrap_stage3_llvm_config"
    ) || return 1
    bootstrap_stage3_llvm_version=$(
        env -i PATH="$PATH" LC_ALL=C LANG=C \
            "$bootstrap_stage3_llvm_config" --version
    ) || return 1
    bootstrap_stage3_llvm_major=${bootstrap_stage3_llvm_version%%.*}
    case "$bootstrap_stage3_llvm_major" in
        ''|*[!0-9]*) return 1 ;;
    esac
    bootstrap_stage3_llvm_prefix=$(
        env -i PATH="$PATH" LC_ALL=C LANG=C \
            "$bootstrap_stage3_llvm_config" --prefix
    ) || return 1
    bootstrap_stage3_llvm_prefix=$(
        CDPATH= cd -- "$bootstrap_stage3_llvm_prefix" && pwd -P
    ) || return 1
    bootstrap_stage3_llvm_libfiles=$(
        env -i PATH="$PATH" LC_ALL=C LANG=C \
            "$bootstrap_stage3_llvm_config" --link-static --libfiles
    ) || return 1
    [ -n "$bootstrap_stage3_llvm_libfiles" ] || return 1
    case "$bootstrap_stage3_llvm_libfiles" in
        *'
'*|*'	'*) return 1 ;;
    esac
    # On MSYS2/Cygwin, llvm-config is a native Windows program and reports
    # native drive-letter paths (`C:/msys64/mingw64/lib/libLLVMCore.a`). Every
    # consumer below -- and the `/*` absolute-path guard in particular -- speaks
    # POSIX, so a Windows host failed the guard for EVERY library and returned 1
    # with no diagnostic at all. `--prefix` and `--libdir` escaped this only
    # because they are laundered through `cd ... && pwd -P`, which accepts a
    # drive path and emits a POSIX one; `--libfiles` is consumed literally.
    # Normalize once, here, so nothing downstream needs to know the difference.
    case "$(uname -s 2>/dev/null || echo unknown)" in
        MSYS*|MINGW*|CYGWIN*)
            command -v cygpath >/dev/null 2>&1 || {
                echo 'llvm authority: cygpath is required to normalize llvm-config --libfiles on Windows' >&2
                return 1
            }
            bootstrap_stage3_llvm_libfiles=$(
                printf '%s
' "$bootstrap_stage3_llvm_libfiles" |
                    tr ' ' '
' | cygpath -u -f - | tr '
' ' '
            ) || return 1
            bootstrap_stage3_llvm_libfiles=${bootstrap_stage3_llvm_libfiles% }
            ;;
    esac
    bootstrap_stage3_llvm_libdir=$(
        env -i PATH="$PATH" LC_ALL=C LANG=C \
            "$bootstrap_stage3_llvm_config" --libdir
    ) || return 1
    bootstrap_stage3_llvm_libdir=$(
        CDPATH= cd -- "$bootstrap_stage3_llvm_libdir" && pwd -P
    ) || return 1
    bootstrap_stage3_llvm_system_libs=$(
        env -i PATH="$PATH" LC_ALL=C LANG=C \
            "$bootstrap_stage3_llvm_config" --link-static --system-libs
    ) || return 1
    case "$bootstrap_stage3_llvm_system_libs" in
        *'
'*|*'	'*) return 1 ;;
    esac
    bootstrap_stage3_llvm_sdkroot=
    bootstrap_stage3_llvm_sdk_version=
    if command -v xcrun >/dev/null 2>&1; then
        bootstrap_stage3_llvm_sdkroot=$(
            env -i PATH="$PATH" LC_ALL=C LANG=C \
                xcrun --sdk macosx --show-sdk-path
        ) || return 1
        bootstrap_stage3_llvm_sdkroot=$(
            CDPATH= cd -- "$bootstrap_stage3_llvm_sdkroot" && pwd -P
        ) || return 1
        bootstrap_stage3_llvm_sdk_version=$(
            env -i PATH="$PATH" LC_ALL=C LANG=C \
                xcrun --sdk macosx --show-sdk-version
        ) || return 1
    fi
    bootstrap_stage3_llvm_homebrew_prefix=
    bootstrap_stage3_llvm_library_path=
    if command -v brew >/dev/null 2>&1; then
        bootstrap_stage3_llvm_homebrew_prefix=$(
            env -i HOME=/var/empty PATH="$PATH" LC_ALL=C LANG=C \
                brew --prefix
        ) || return 1
        bootstrap_stage3_llvm_homebrew_prefix=$(
            CDPATH= cd -- "$bootstrap_stage3_llvm_homebrew_prefix" && pwd -P
        ) || return 1
        bootstrap_stage3_llvm_library_path=\
"$bootstrap_stage3_llvm_homebrew_prefix/lib"
        [ -d "$bootstrap_stage3_llvm_library_path" ] || return 1
    fi
    bootstrap_stage3_llvm_resolve_system_lib() {
        [ "$#" -eq 1 ] || return 1
        bootstrap_stage3_llvm_system_name=$1
        case "$bootstrap_stage3_llvm_system_name" in
            ''|*[!A-Za-z0-9_+.-]*) return 1 ;;
        esac
        for bootstrap_stage3_llvm_system_dir in \
            "$bootstrap_stage3_llvm_libdir" \
            "$bootstrap_stage3_llvm_library_path" \
            "${bootstrap_stage3_llvm_sdkroot:+$bootstrap_stage3_llvm_sdkroot/usr/lib}"
        do
            [ -n "$bootstrap_stage3_llvm_system_dir" ] || continue
            for bootstrap_stage3_llvm_system_suffix in dylib so tbd a; do
                bootstrap_stage3_llvm_system_candidate=\
"$bootstrap_stage3_llvm_system_dir/lib$bootstrap_stage3_llvm_system_name.$bootstrap_stage3_llvm_system_suffix"
                [ -f "$bootstrap_stage3_llvm_system_candidate" ] || continue
                bootstrap_stage3_llvm_system_canonical=$(
                    perl -MCwd=abs_path -e \
                        'my $p = abs_path($ARGV[0]); defined($p) or exit 1; print $p' \
                        "$bootstrap_stage3_llvm_system_candidate"
                ) || return 1
                [ -f "$bootstrap_stage3_llvm_system_canonical" ] || return 1
                printf '%s\n%s\n' "$bootstrap_stage3_llvm_system_candidate" \
                    "$bootstrap_stage3_llvm_system_canonical"
                return 0
            done
        done
        bootstrap_stage3_llvm_system_cc=$(command -v cc) || return 1
        for bootstrap_stage3_llvm_system_suffix in so dylib a; do
            bootstrap_stage3_llvm_system_candidate=$(
                env -i PATH="$PATH" LC_ALL=C LANG=C \
                    "$bootstrap_stage3_llvm_system_cc" -print-file-name=\
"lib$bootstrap_stage3_llvm_system_name.$bootstrap_stage3_llvm_system_suffix"
            ) || return 1
            case "$bootstrap_stage3_llvm_system_candidate" in
                /*) ;;
                *) continue ;;
            esac
            [ -f "$bootstrap_stage3_llvm_system_candidate" ] || continue
            bootstrap_stage3_llvm_system_canonical=$(
                perl -MCwd=abs_path -e \
                    'my $p = abs_path($ARGV[0]); defined($p) or exit 1; print $p' \
                    "$bootstrap_stage3_llvm_system_candidate"
            ) || return 1
            [ -f "$bootstrap_stage3_llvm_system_canonical" ] || return 1
            printf '%s\n%s\n' "$bootstrap_stage3_llvm_system_candidate" \
                "$bootstrap_stage3_llvm_system_canonical"
            return 0
        done
        return 1
    }
    printf 'llvm-build-status=enabled\nllvm-major=%s\n' \
        "$bootstrap_stage3_llvm_major"
    printf 'llvm-prefix=%s\nllvm-libdir=%s\nllvm-config-path=%s\n' \
        "$bootstrap_stage3_llvm_prefix" "$bootstrap_stage3_llvm_libdir" \
        "$bootstrap_stage3_llvm_config_canonical"
    printf 'llvm-config-sha256=%s\n' \
        "$(bootstrap_stage3_hash_file \
            "$bootstrap_stage3_llvm_config_canonical")"
    printf 'llvm-sdkroot=%s\nllvm-sdk-version=%s\n' \
        "$bootstrap_stage3_llvm_sdkroot" "$bootstrap_stage3_llvm_sdk_version"
    printf 'llvm-homebrew-prefix=%s\nllvm-library-path=%s\n' \
        "$bootstrap_stage3_llvm_homebrew_prefix" \
        "$bootstrap_stage3_llvm_library_path"
    set -f
    bootstrap_stage3_llvm_saved_ifs=$IFS
    IFS=' '
    # llvm-config defines libfiles as a space-delimited link-order list.
    # Whitespace inside paths was rejected above, so positional splitting is
    # deterministic and cannot expand globs.
    set -- $bootstrap_stage3_llvm_libfiles
    IFS=$bootstrap_stage3_llvm_saved_ifs
    [ "$#" -gt 0 ] || return 1
    printf 'llvm-static-lib-count=%s\n' "$#"
    bootstrap_stage3_llvm_index=0
    for bootstrap_stage3_llvm_lib in "$@"; do
        case "$bootstrap_stage3_llvm_lib" in
            /*) ;;
            *)
                # Never fail mute here: this rejection previously surfaced only
                # as `error: failed to fingerprint Rust seed inputs`, with the
                # offending path nowhere in any log or error manifest.
                echo "llvm authority: llvm-config --libfiles returned a non-absolute path: ${bootstrap_stage3_llvm_lib}" >&2
                return 1
                ;;
        esac
        bootstrap_stage3_llvm_lib=$(
            bootstrap_stage3_canonical_file "$bootstrap_stage3_llvm_lib"
        ) || return 1
        bootstrap_stage3_llvm_index=$((bootstrap_stage3_llvm_index + 1))
        bootstrap_stage3_llvm_key=$(
            printf '%04d' "$bootstrap_stage3_llvm_index"
        ) || return 1
        printf 'llvm-static-lib-%s-path=%s\n' \
            "$bootstrap_stage3_llvm_key" "$bootstrap_stage3_llvm_lib"
        printf 'llvm-static-lib-%s-sha256=%s\n' \
            "$bootstrap_stage3_llvm_key" \
            "$(bootstrap_stage3_hash_file "$bootstrap_stage3_llvm_lib")"
    done
    IFS=' '
    # Preserve the exact system-link token order as well as each resolved
    # library file. Other compiler/linker flags remain explicit ordered tokens
    # and are covered transitively by the bound compiler/linker authorities.
    set -- $bootstrap_stage3_llvm_system_libs
    IFS=$bootstrap_stage3_llvm_saved_ifs
    printf 'llvm-system-lib-count=%s\n' "$#"
    bootstrap_stage3_llvm_index=0
    while [ "$#" -gt 0 ]; do
        bootstrap_stage3_llvm_system_token=$1
        shift
        bootstrap_stage3_llvm_index=$((bootstrap_stage3_llvm_index + 1))
        bootstrap_stage3_llvm_key=$(
            printf '%04d' "$bootstrap_stage3_llvm_index"
        ) || return 1
        printf 'llvm-system-lib-%s-token=%s\n' \
            "$bootstrap_stage3_llvm_key" "$bootstrap_stage3_llvm_system_token"
        case "$bootstrap_stage3_llvm_system_token" in
            -l?*)
                bootstrap_stage3_llvm_system_resolution=$(
                    bootstrap_stage3_llvm_resolve_system_lib \
                        "${bootstrap_stage3_llvm_system_token#-l}"
                ) || return 1
                bootstrap_stage3_llvm_system_requested=$(
                    printf '%s\n' "$bootstrap_stage3_llvm_system_resolution" |
                        sed -n '1p'
                ) || return 1
                bootstrap_stage3_llvm_system_canonical=$(
                    printf '%s\n' "$bootstrap_stage3_llvm_system_resolution" |
                        sed -n '2p'
                ) || return 1
                [ -n "$bootstrap_stage3_llvm_system_requested" ] &&
                    [ -n "$bootstrap_stage3_llvm_system_canonical" ] ||
                    return 1
                printf 'llvm-system-lib-%s-requested=%s\n' \
                    "$bootstrap_stage3_llvm_key" \
                    "$bootstrap_stage3_llvm_system_requested"
                printf 'llvm-system-lib-%s-path=%s\n' \
                    "$bootstrap_stage3_llvm_key" \
                    "$bootstrap_stage3_llvm_system_canonical"
                printf 'llvm-system-lib-%s-sha256=%s\n' \
                    "$bootstrap_stage3_llvm_key" \
                    "$(bootstrap_stage3_hash_file \
                        "$bootstrap_stage3_llvm_system_canonical")"
                ;;
            /*)
                bootstrap_stage3_llvm_system_canonical=$(
                    bootstrap_stage3_canonical_file \
                        "$bootstrap_stage3_llvm_system_token"
                ) || return 1
                printf 'llvm-system-lib-%s-path=%s\n' \
                    "$bootstrap_stage3_llvm_key" \
                    "$bootstrap_stage3_llvm_system_canonical"
                printf 'llvm-system-lib-%s-sha256=%s\n' \
                    "$bootstrap_stage3_llvm_key" \
                    "$(bootstrap_stage3_hash_file \
                        "$bootstrap_stage3_llvm_system_canonical")"
                ;;
            -framework)
                [ "$#" -gt 0 ] || return 1
                bootstrap_stage3_llvm_framework=$1
                shift
                bootstrap_stage3_llvm_index=$((bootstrap_stage3_llvm_index + 1))
                bootstrap_stage3_llvm_key=$(
                    printf '%04d' "$bootstrap_stage3_llvm_index"
                ) || return 1
                case "$bootstrap_stage3_llvm_framework" in
                    ''|*[!A-Za-z0-9_+.-]*) return 1 ;;
                esac
                printf 'llvm-system-lib-%s-token=%s\n' \
                    "$bootstrap_stage3_llvm_key" \
                    "$bootstrap_stage3_llvm_framework"
                [ -n "$bootstrap_stage3_llvm_sdkroot" ] || return 1
                bootstrap_stage3_llvm_framework_path=\
"$bootstrap_stage3_llvm_sdkroot/System/Library/Frameworks/$bootstrap_stage3_llvm_framework.framework/$bootstrap_stage3_llvm_framework.tbd"
                bootstrap_stage3_llvm_framework_path=$(
                    perl -MCwd=abs_path -e \
                        'my $p = abs_path($ARGV[0]); defined($p) or exit 1; print $p' \
                        "$bootstrap_stage3_llvm_framework_path"
                ) || return 1
                [ -f "$bootstrap_stage3_llvm_framework_path" ] || return 1
                printf 'llvm-system-lib-%s-path=%s\n' \
                    "$bootstrap_stage3_llvm_key" \
                    "$bootstrap_stage3_llvm_framework_path"
                printf 'llvm-system-lib-%s-sha256=%s\n' \
                    "$bootstrap_stage3_llvm_key" \
                    "$(bootstrap_stage3_hash_file \
                        "$bootstrap_stage3_llvm_framework_path")"
                ;;
            # llvm-config system link output participates in the actual linker
            # search. Accept only token forms whose resolution is bound above;
            # silently preserving flags such as -L would leave their searched
            # directories and selected files outside the authority record.
            -*)
                echo "llvm authority: unsupported llvm-config --system-libs flag token: ${bootstrap_stage3_llvm_system_token}" >&2
                return 1
                ;;
            *.lib|*.LIB)
                # An MSVC-built llvm-config reports bare import-library names
                # (`psapi.lib shell32.lib ... libxml2s.lib`) rather than the
                # GNU `-lpsapi` form the branch above is written against.
                # Resolve them exactly the way the linker will: LLVM's own
                # libdir first, then each entry of the MSVC `LIB` search path.
                # Binding them is what lets the receipt name the Windows SDK
                # import libraries it actually linked, so this is a stronger
                # record than the GNU path, not a weaker one.
                # Resolved in a command substitution, NOT an unquoted `for`:
                # every MSVC/SDK directory contains a space ("Program Files"),
                # which word-splitting silently shreds into unmatchable
                # fragments.
                bootstrap_stage3_llvm_msvc_found=$(
                    bootstrap_stage3_llvm_msvc_find_lib                         "$bootstrap_stage3_llvm_system_token"                         "$bootstrap_stage3_llvm_libdir"
                )
                [ -n "$bootstrap_stage3_llvm_msvc_found" ] || {
                    echo "llvm authority: llvm-config --system-libs named '${bootstrap_stage3_llvm_system_token}', which is in neither the LLVM libdir (${bootstrap_stage3_llvm_libdir}) nor any LIB entry; is the MSVC environment set?" >&2
                    return 1
                }
                bootstrap_stage3_llvm_system_canonical=$(
                    bootstrap_stage3_canonical_file                         "$bootstrap_stage3_llvm_msvc_found"
                ) || return 1
                printf 'llvm-system-lib-%s-requested=%s
'                     "$bootstrap_stage3_llvm_key"                     "$bootstrap_stage3_llvm_msvc_found"
                printf 'llvm-system-lib-%s-path=%s
'                     "$bootstrap_stage3_llvm_key"                     "$bootstrap_stage3_llvm_system_canonical"
                printf 'llvm-system-lib-%s-sha256=%s
'                     "$bootstrap_stage3_llvm_key"                     "$(bootstrap_stage3_hash_file                         "$bootstrap_stage3_llvm_system_canonical")"
                ;;
            *)
                echo "llvm authority: unresolvable llvm-config --system-libs token: ${bootstrap_stage3_llvm_system_token}" >&2
                return 1
                ;;
        esac
    done
)

bootstrap_stage3_tool_requested_path() {
    bootstrap_stage3_requested_name=$1
    bootstrap_stage3_selected_c_name=$2
    bootstrap_stage3_selected_c_path=$3
    if [ "$bootstrap_stage3_requested_name" = "$bootstrap_stage3_selected_c_name" ]; then
        printf '%s\n' "$bootstrap_stage3_selected_c_path"
    else
        command -v "$bootstrap_stage3_requested_name" 2>/dev/null
    fi
}

bootstrap_stage3_tool_authority_snapshot() (
    bootstrap_stage3_tool_output=$1
    bootstrap_stage3_tool_path=$2
    bootstrap_stage3_tool_root=$3
    bootstrap_stage3_tool_tmp="${bootstrap_stage3_tool_output}.tmp.$$"
    trap 'rm -f "$bootstrap_stage3_tool_tmp" \
        "${bootstrap_stage3_tool_tmp}.version" \
        "${bootstrap_stage3_tool_tmp}.arch"' EXIT
    case "$bootstrap_stage3_tool_path" in
        /*) ;;
        *) return 1 ;;
    esac
    : >"$bootstrap_stage3_tool_tmp" || return 1
    printf 'PATH=%s\n' "$bootstrap_stage3_tool_path" \
        >>"$bootstrap_stage3_tool_tmp" || return 1
    bootstrap_stage3_tool_old_ifs=$IFS
    IFS=:
    for bootstrap_stage3_tool_dir in $bootstrap_stage3_tool_path; do
        IFS=$bootstrap_stage3_tool_old_ifs
        [ -d "$bootstrap_stage3_tool_dir" ] || return 1
        bootstrap_stage3_tool_dir_canonical=$(
            CDPATH= cd -- "$bootstrap_stage3_tool_dir" && pwd -P
        ) || return 1
        [ "$bootstrap_stage3_tool_dir" = \
            "$bootstrap_stage3_tool_dir_canonical" ] || return 1
        printf 'path-component=%s\n' "$bootstrap_stage3_tool_dir_canonical" \
            >>"$bootstrap_stage3_tool_tmp" || return 1
        IFS=:
    done
    IFS=$bootstrap_stage3_tool_old_ifs
    PATH=$bootstrap_stage3_tool_path
    export PATH
    bootstrap_stage3_rust_authority=$(
        bootstrap_stage3_resolve_rust_toolchain \
            "$bootstrap_stage3_tool_root" "$bootstrap_stage3_tool_path"
    ) || return 1
    bootstrap_stage3_real_rustc=$(
        printf '%s\n' "$bootstrap_stage3_rust_authority" |
            sed -n 's/^rustc-path=//p'
    ) || return 1
    bootstrap_stage3_real_cargo=$(
        printf '%s\n' "$bootstrap_stage3_rust_authority" |
            sed -n 's/^cargo-path=//p'
    ) || return 1
    [ -n "$bootstrap_stage3_real_rustc" ] &&
        [ -n "$bootstrap_stage3_real_cargo" ] || return 1
    bootstrap_stage3_tool_c_name=cc
    # Unix hosts bind their cc command. Both Windows ABIs must use the same
    # target C-compiler owner as the Rust build: GNU installations may provide
    # gcc.exe without a cc alias, and MSVC selects a runnable cl/clang-cl.
    # The requested-path helper consumes this exact selected identity.
    bootstrap_stage3_tool_c_path=$(command -v cc 2>/dev/null || printf '')
    case "$(bootstrap_stage3_host_platform)" in
        *-pc-windows-msvc|*-pc-windows-gnu)
            bootstrap_stage3_tool_c_path=$(
                bootstrap_stage3_target_c_compiler \
                    "$(bootstrap_stage3_host_platform)"
            ) || return 1
            bootstrap_stage3_tool_c_name=$(basename \
                "$bootstrap_stage3_tool_c_path")
            bootstrap_stage3_tool_c_name=${bootstrap_stage3_tool_c_name%.exe}
            ;;
    esac
    bootstrap_stage3_hash_tool=""
    for bootstrap_stage3_hash_candidate in \
        sha256sum shasum sha256 openssl; do
        if command -v "$bootstrap_stage3_hash_candidate" >/dev/null 2>&1; then
            bootstrap_stage3_hash_tool=$bootstrap_stage3_hash_candidate
            break
        fi
    done
    [ -n "$bootstrap_stage3_hash_tool" ] || return 1
    for bootstrap_stage3_tool_name in \
        cargo rustc "$bootstrap_stage3_tool_c_name" clang ld ar ranlib sh env perl sed file cmp \
        "$bootstrap_stage3_hash_tool"; do
        bootstrap_stage3_tool_requested=$(bootstrap_stage3_tool_requested_path \
            "$bootstrap_stage3_tool_name" "$bootstrap_stage3_tool_c_name" \
            "$bootstrap_stage3_tool_c_path") || return 1
        case "$bootstrap_stage3_tool_requested" in
            /*) ;;
            *) return 1 ;;
        esac
        bootstrap_stage3_tool_canonical=$(
            perl -MCwd=abs_path -e \
                'my $p = abs_path($ARGV[0]); defined($p) or exit 1; print $p' \
                "$bootstrap_stage3_tool_requested"
        ) || return 1
        [ -f "$bootstrap_stage3_tool_canonical" ] || return 1
        # BSD userland tools such as macOS sed(1) and ld(1) do not implement
        # GNU-style --version.  The executable bytes remain authoritative; bind
        # the probe status and first diagnostic line without requiring success.
        # Invoke the requested path, not the resolved target: rustup proxies
        # dispatch cargo/rustc according to argv[0].
        bootstrap_stage3_tool_version_output=\
"${bootstrap_stage3_tool_tmp}.version"
        bootstrap_stage3_tool_version_status=0
        bootstrap_stage3_tool_version_executable=\
"$bootstrap_stage3_tool_requested"
        case "$bootstrap_stage3_tool_name" in
            rustc) bootstrap_stage3_tool_version_executable=$bootstrap_stage3_real_rustc ;;
            cargo) bootstrap_stage3_tool_version_executable=$bootstrap_stage3_real_cargo ;;
        esac
        env -i PATH="$PATH" LC_ALL=C LANG=C \
            "$bootstrap_stage3_tool_version_executable" --version \
            >"$bootstrap_stage3_tool_version_output" 2>&1 ||
            bootstrap_stage3_tool_version_status=$?
        bootstrap_stage3_tool_version=$(
            sed -n '1p' "$bootstrap_stage3_tool_version_output"
        ) || {
            rm -f "$bootstrap_stage3_tool_version_output"
            return 1
        }
        rm -f "$bootstrap_stage3_tool_version_output"
        [ -n "$bootstrap_stage3_tool_version" ] ||
            bootstrap_stage3_tool_version=absent
        # Darwin file(1) emits one summary plus per-architecture continuation
        # lines for universal binaries. Keep this line-oriented snapshot to one
        # deterministic summary record; the executable SHA binds all bytes.
        bootstrap_stage3_tool_arch_output="${bootstrap_stage3_tool_tmp}.arch"
        file -b "$bootstrap_stage3_tool_canonical" \
            >"$bootstrap_stage3_tool_arch_output" 2>&1 || {
            rm -f "$bootstrap_stage3_tool_arch_output"
            return 1
        }
        bootstrap_stage3_tool_arch=$(
            sed -n '1p' "$bootstrap_stage3_tool_arch_output"
        ) || {
            rm -f "$bootstrap_stage3_tool_arch_output"
            return 1
        }
        rm -f "$bootstrap_stage3_tool_arch_output"
        [ -n "$bootstrap_stage3_tool_arch" ] || return 1
        printf 'tool=%s|requested=%s|canonical=%s|sha256=%s|version-status=%s|version=%s|arch=%s\n' \
            "$bootstrap_stage3_tool_name" "$bootstrap_stage3_tool_requested" \
            "$bootstrap_stage3_tool_canonical" \
            "$(bootstrap_stage3_hash_file \
                "$bootstrap_stage3_tool_canonical")" \
            "$bootstrap_stage3_tool_version_status" \
            "$bootstrap_stage3_tool_version" "$bootstrap_stage3_tool_arch" \
            >>"$bootstrap_stage3_tool_tmp" || return 1
        if [ "$bootstrap_stage3_tool_name" = rustc ]; then
            printf '%s\n' "$bootstrap_stage3_rust_authority" \
                >>"$bootstrap_stage3_tool_tmp" || return 1
            printf 'rustc-toolchain-sha256=%s\ncargo-toolchain-sha256=%s\n' \
                "$(bootstrap_stage3_hash_file \
                    "$bootstrap_stage3_real_rustc")" \
                "$(bootstrap_stage3_hash_file \
                    "$bootstrap_stage3_real_cargo")" \
                >>"$bootstrap_stage3_tool_tmp" || return 1
        fi
    done
    if command -v llvm-config >/dev/null 2>&1; then
        bootstrap_stage3_tool_llvm_requested=$(command -v llvm-config) ||
            return 1
        bootstrap_stage3_tool_llvm_canonical=$(
            perl -MCwd=abs_path -e \
                'my $p = abs_path($ARGV[0]); defined($p) or exit 1; print $p' \
                "$bootstrap_stage3_tool_llvm_requested"
        ) || return 1
        [ -f "$bootstrap_stage3_tool_llvm_canonical" ] || return 1
        bootstrap_stage3_tool_llvm_version=$(
            env -i PATH="$PATH" LC_ALL=C LANG=C \
                "$bootstrap_stage3_tool_llvm_requested" --version
        ) || return 1
        bootstrap_stage3_tool_llvm_prefix=$(
            env -i PATH="$PATH" LC_ALL=C LANG=C \
                "$bootstrap_stage3_tool_llvm_requested" --prefix
        ) || return 1
        printf 'llvm-config-requested=%s|canonical=%s|sha256=%s|version=%s|prefix=%s\n' \
            "$bootstrap_stage3_tool_llvm_requested" \
            "$bootstrap_stage3_tool_llvm_canonical" \
            "$(bootstrap_stage3_hash_file \
                "$bootstrap_stage3_tool_llvm_canonical")" \
            "$bootstrap_stage3_tool_llvm_version" \
            "$bootstrap_stage3_tool_llvm_prefix" \
            >>"$bootstrap_stage3_tool_tmp" || return 1
    else
        echo 'llvm-config=absent' >>"$bootstrap_stage3_tool_tmp" || return 1
    fi
    if command -v xcrun >/dev/null 2>&1; then
        # An inherited or cached default SDKROOT may name a removed Command
        # Line Tools SDK even when the selected Xcode has a valid macOS SDK.
        # Select the platform explicitly for deterministic authority.
        bootstrap_stage3_sdk_path=$(
            xcrun --sdk macosx --show-sdk-path
        ) || return 1
        bootstrap_stage3_sdk_canonical=$(
            CDPATH= cd -- "$bootstrap_stage3_sdk_path" && pwd -P
        ) || return 1
        bootstrap_stage3_sdk_version=$(
            xcrun --sdk macosx --show-sdk-version
        ) || return 1
        printf 'sdk-path=%s|sdk-version=%s\n' \
            "$bootstrap_stage3_sdk_canonical" \
            "$bootstrap_stage3_sdk_version" \
            >>"$bootstrap_stage3_tool_tmp" || return 1
    fi
    mv "$bootstrap_stage3_tool_tmp" "$bootstrap_stage3_tool_output"
)

bootstrap_stage3_directory_snapshot() {
    bootstrap_stage3_directory_snapshot_output=$1
    bootstrap_stage3_directory_snapshot_root=$2
    # The pid is used only to pin the trusted /proc/<pid>/fd magic-link arm
    # below. A host without procfs can never present such a root, so leave the
    # pid empty there: the arm cannot match and the "/proc/*) return 1" arm
    # still rejects every other /proc path, keeping this fail-closed.
    if [ -r /proc/self/stat ]; then
        IFS=' ' read -r bootstrap_stage3_directory_snapshot_pid \
            bootstrap_stage3_directory_snapshot_stat_rest </proc/self/stat ||
            return 1
        case "$bootstrap_stage3_directory_snapshot_pid" in
            ''|0|*[!0-9]*) return 1 ;;
        esac
    else
        bootstrap_stage3_directory_snapshot_pid=''
    fi
    case "$bootstrap_stage3_directory_snapshot_root" in
        "/proc/$bootstrap_stage3_directory_snapshot_pid/fd/"[1-9]*)
            expr "$bootstrap_stage3_directory_snapshot_root" : \
                "/proc/$bootstrap_stage3_directory_snapshot_pid/fd/[1-9][0-9]*$" \
                >/dev/null || return 1
            [ -d "$bootstrap_stage3_directory_snapshot_root" ] || return 1
            # The exact local procfd component is the trusted magic-link
            # anchor.  Resolve only that anchor; File::Find still lstats and
            # rejects every descendant symlink.
            bootstrap_stage3_directory_snapshot_scan=\
"$bootstrap_stage3_directory_snapshot_root/."
            ;;
        /proc/*) return 1 ;;
        *)
            [ -d "$bootstrap_stage3_directory_snapshot_root" ] &&
                [ ! -L "$bootstrap_stage3_directory_snapshot_root" ] || return 1
            bootstrap_stage3_directory_snapshot_scan=\
"$bootstrap_stage3_directory_snapshot_root"
            ;;
    esac
    # Digest::SHA::addfile streams in binary mode. Authority archives can be
    # hundreds of MiB, so retaining a whole file here is both unnecessary and
    # capable of exhausting a constrained bootstrap host.
    perl -MDigest::SHA -MFile::Find -e '
        use strict;
        use warnings;
        my ($root) = @ARGV;
        my $relative_root = $root;
        $relative_root =~ s{/\.$}{};
        my @records;
        find(
            {
                no_chdir => 1,
                wanted => sub {
                    my $absolute = $File::Find::name;
                    return if $absolute eq $root ||
                        $absolute eq $relative_root;
                    -l $absolute and die "authority symlink rejected\n";
                    return unless -f $absolute;
                    my $sha = Digest::SHA->new(256);
                    $sha->addfile($absolute, "b") or die "hash\n";
                    my $relative;
                    if (index($absolute, "$root/") == 0) {
                        $relative = substr($absolute, length($root) + 1);
                    } elsif (index($absolute, "$relative_root/") == 0) {
                        $relative = substr(
                            $absolute, length($relative_root) + 1
                        );
                    } else {
                        die "authority path escaped root\n";
                    }
                    push @records, join(
                        ":", "file-hex", unpack("H*", $relative),
                        (-x $absolute ? 1 : 0), $sha->hexdigest
                    );
                },
            },
            $root
        );
        @records or die "empty authority\n";
        print join("\n", sort @records), "\n";
    ' "$bootstrap_stage3_directory_snapshot_scan" \
        >"$bootstrap_stage3_directory_snapshot_output"
}

bootstrap_stage3_copy_authority() {
    bootstrap_stage3_copy_source=$1
    bootstrap_stage3_copy_destination=$2
    [ -d "$bootstrap_stage3_copy_source" ] &&
        [ ! -L "$bootstrap_stage3_copy_source" ] || return 1
    [ ! -e "$bootstrap_stage3_copy_destination" ] || return 1
    mkdir -p "$bootstrap_stage3_copy_destination" || return 1
    perl -MFile::Find -MFile::Copy=copy -MFile::Path=make_path -e '
        use strict;
        use warnings;
        my ($source, $destination) = @ARGV;
        my @directories;
        find(
            {
                no_chdir => 1,
                wanted => sub {
                    my $absolute = $File::Find::name;
                    return if $absolute eq $source;
                    -l $absolute and die "authority symlink rejected\n";
                    my $relative = substr($absolute, length($source) + 1);
                    my $target = "$destination/$relative";
                    if (-d $absolute) {
                        make_path($target, { mode => 0700 });
                        push @directories, $target;
                        return;
                    }
                    return unless -f $absolute;
                    my $parent = $target;
                    $parent =~ s{/[^/]+$}{};
                    make_path($parent, { mode => 0700 }) unless -d $parent;
                    copy($absolute, $target) or die "copy\n";
                    chmod((-x $absolute ? 0500 : 0400), $target) or die "chmod\n";
                },
            },
            $source
        );
        # Freeze directories only after all descendants have been populated.
        # Freezing during traversal prevents later child/sibling creation.
        for my $directory (sort { length($b) <=> length($a) } @directories) {
            chmod(0500, $directory) or die "chmod directory\n";
        }
    ' "$bootstrap_stage3_copy_source" "$bootstrap_stage3_copy_destination" ||
        return 1
    chmod 500 "$bootstrap_stage3_copy_destination"
}

# Project the immutable Rust bootstrap authority from Cargo's profile tree.
# Cargo's profile directory also contains thousands of dependency artifacts;
# none are part of the admitted authority contract. Copy exactly the seed,
# native runtime archive, and compiler backfill archive, while detecting a
# producer that changes any member during projection.
bootstrap_stage3_copy_seed_tuple() {
    [ "$#" -eq 5 ] || return 64
    bootstrap_stage3_tuple_source=$1
    bootstrap_stage3_tuple_destination=$2
    shift 2
    [ -d "$bootstrap_stage3_tuple_source" ] &&
        [ ! -L "$bootstrap_stage3_tuple_source" ] || return 1
    [ ! -e "$bootstrap_stage3_tuple_destination" ] || return 1

    # Stage4 consumes the non-LTO Rust static runtime directly from deps.
    # Do not infer authority from everything Cargo happened to leave in the
    # profile directory (notably the cdylib: the native linker deliberately
    # forces the Simple runtime static).  Derive the target spelling from the
    # native-all archive selected by the platform owner.
    case "$2" in
        libsimple_native_all.a)
            bootstrap_stage3_tuple_runtime_name=deps/libsimple_runtime.a
            ;;
        simple_native_all.lib)
            bootstrap_stage3_tuple_runtime_name=deps/simple_runtime.lib
            ;;
        *) return 1 ;;
    esac
    set -- "$@" "$bootstrap_stage3_tuple_runtime_name"

    # The hosted GPU/backend linker needs the Rust hosted-runtime rlib, but it
    # must never rediscover it from a mutable Cargo target after admission.
    # Cargo owns exactly one hash-named product in the selected profile's deps
    # directory.  Project that one leaf into the immutable generation; reject
    # missing, duplicate, nested, or symlink candidates.
    bootstrap_stage3_hosted_deps="$bootstrap_stage3_tuple_source/deps"
    [ -d "$bootstrap_stage3_hosted_deps" ] &&
        [ ! -L "$bootstrap_stage3_hosted_deps" ] || return 1
    bootstrap_stage3_hosted_candidates=
    bootstrap_stage3_hosted_count=0
    for bootstrap_stage3_hosted_path in \
        "$bootstrap_stage3_hosted_deps"/libspl_hosted_runtime-*.rlib; do
        [ -e "$bootstrap_stage3_hosted_path" ] || continue
        [ -f "$bootstrap_stage3_hosted_path" ] &&
            [ ! -L "$bootstrap_stage3_hosted_path" ] || return 1
        bootstrap_stage3_hosted_count=$((bootstrap_stage3_hosted_count + 1))
        if [ -z "$bootstrap_stage3_hosted_candidates" ] ||
            [ "$bootstrap_stage3_hosted_path" -nt                 "$bootstrap_stage3_hosted_candidates" ]; then
            bootstrap_stage3_hosted_candidates=$bootstrap_stage3_hosted_path
        fi
    done
    # The comment above assumed "Cargo owns exactly one hash-named product in
    # the selected profile's deps directory". That is FALSE for this bootstrap:
    # it deliberately runs the same `bootstrap` profile twice with different LTO
    # settings (rust-runtime-nolto-build passes CARGO_PROFILE_BOOTSTRAP_LTO=off)
    # into ONE CARGO_TARGET_DIR, so two metadata-distinct rlibs legitimately
    # coexist. Measured on x86_64-pc-windows-msvc: both 288,302 bytes with the
    # same 26 win32 symbols, differing only in embedded metadata.
    #
    # Refusing outright surfaced as a bare "could not prepare immutable Rust
    # authority generation" naming nothing, after four successful builds.
    #
    # Newest-wins matches the semantics this bootstrap ALREADY documents for the
    # sibling archive slot ("The last cargo invocation wins the deps/ archive
    # slot", bootstrap-from-scratch.sh) -- so the tuple is frozen from the same
    # final state of the target dir rather than from an arbitrary member.
    #
    # Zero candidates is still fatal, and the choice is never silent.
    [ "$bootstrap_stage3_hosted_count" -ge 1 ] || return 1
    if [ "$bootstrap_stage3_hosted_count" -gt 1 ]; then
        echo "bootstrap authority: $bootstrap_stage3_hosted_count spl_hosted_runtime rlibs in $bootstrap_stage3_hosted_deps; freezing the newest: $bootstrap_stage3_hosted_candidates" >&2
    fi
    bootstrap_stage3_hosted_name=deps/$(basename -- \
        "$bootstrap_stage3_hosted_candidates")
    set -- "$@" "$bootstrap_stage3_hosted_name"

    bootstrap_stage3_tuple_seen='|'
    for bootstrap_stage3_tuple_name in "$@"; do
        [ -n "$bootstrap_stage3_tuple_name" ] || return 1
        case "$bootstrap_stage3_tuple_name" in
            ''|/*|*\\*|.|..|*/.|*/..|../*|*/../*|*[!A-Za-z0-9._/-]*)
                return 1
                ;;
        esac
        case "$bootstrap_stage3_tuple_seen" in
            *"|$bootstrap_stage3_tuple_name|"*) return 1 ;;
        esac
        bootstrap_stage3_tuple_seen=\
"$bootstrap_stage3_tuple_seen$bootstrap_stage3_tuple_name|"
        bootstrap_stage3_tuple_path=\
"$bootstrap_stage3_tuple_source/$bootstrap_stage3_tuple_name"
        [ -f "$bootstrap_stage3_tuple_path" ] &&
            [ ! -L "$bootstrap_stage3_tuple_path" ] || return 1
    done

    # One process owns the whole vector.  It binds every source identity and
    # digest before copying, copies from O_NOFOLLOW descriptors, then rechecks
    # the complete vector.  A writer cannot produce a silently torn tuple by
    # changing an early member while a later member is copied.
    perl -MDigest::SHA -MFcntl=:DEFAULT,:mode -e '
        use strict;
        use warnings;
        my ($source, $destination, @names) = @ARGV;
        my @source_root_stat = lstat($source);
        @source_root_stat && S_ISDIR($source_root_stat[2]) &&
            !S_ISLNK($source_root_stat[2]) or die "unsafe source root\n";
        mkdir($destination, 0700) or die "mkdir destination: $!\n";
        my (@before, @targets);
        sub source_path {
            my ($root, $name) = @_;
            my @rst = lstat($root);
            @rst && S_ISDIR($rst[2]) && !S_ISLNK($rst[2]) &&
                $rst[0] == $source_root_stat[0] &&
                $rst[1] == $source_root_stat[1]
                or die "source root changed\n";
            my @parts = split m{/}, $name;
            pop @parts;
            my $parent = $root;
            for my $part (@parts) {
                $parent .= "/$part";
                my @st = lstat($parent);
                @st && S_ISDIR($st[2]) && !S_ISLNK($st[2])
                    or die "unsafe source parent\n";
            }
            return "$root/$name";
        }
        sub open_bound {
            my ($path) = @_;
            my @lst = lstat($path);
            @lst && S_ISREG($lst[2]) && !S_ISLNK($lst[2])
                or die "unsafe source leaf\n";
            my $flags = O_RDONLY;
            $flags |= O_NOFOLLOW if defined(&O_NOFOLLOW);
            sysopen(my $fh, $path, $flags) or die "open source: $!\n";
            binmode($fh) or die "binmode source: $!\n";
            my @st = stat($fh);
            @st && S_ISREG($st[2]) && $st[0] == $lst[0] &&
                $st[1] == $lst[1] or die "source identity raced\n";
            return ($fh, \@st);
        }
        sub digest_fh {
            my ($fh) = @_;
            seek($fh, 0, 0) or die "seek source: $!\n";
            my $sha = Digest::SHA->new(256);
            $sha->addfile($fh);
            return $sha->hexdigest;
        }
        for my $name (@names) {
            my $path = source_path($source, $name);
            my ($fh, $st) = open_bound($path);
            my $digest = digest_fh($fh);
            push @before, [$name, $st->[0], $st->[1], $st->[2],
                $st->[7], $st->[9], $st->[10], $digest];
            close($fh) or die "close source: $!\n";
        }
        my $copied = 0;
        for my $record (@before) {
            my ($name, $dev, $ino, $source_mode, $size, $mtime, $ctime,
                $digest) = @$record;
            my $path = source_path($source, $name);
            my ($in, $now) = open_bound($path);
            ($now->[0] == $dev && $now->[1] == $ino && $now->[2] == $source_mode)
                or die "source identity changed\n";
            my @parts = split m{/}, $name;
            my $leaf = pop @parts;
            my $parent = $destination;
            for my $part (@parts) {
                $parent .= "/$part";
                if (!-e $parent) { mkdir($parent, 0700) or die "mkdir parent: $!\n"; }
                my @pst = lstat($parent);
                @pst && S_ISDIR($pst[2]) && !S_ISLNK($pst[2])
                    or die "unsafe destination parent\n";
            }
            my $target = "$parent/$leaf";
            my $pending = "$target.pending.$$";
            sysopen(my $out, $pending, O_WRONLY | O_CREAT | O_EXCL, 0600)
                or die "create target: $!\n";
            binmode($out) or die "binmode target: $!\n";
            seek($in, 0, 0) or die "seek copy: $!\n";
            my $copy_sha = Digest::SHA->new(256);
            my $buffer;
            while (1) {
                my $read = sysread($in, $buffer, 1024 * 1024);
                defined($read) or die "read source: $!\n";
                last if $read == 0;
                $copy_sha->add(substr($buffer, 0, $read));
                my $offset = 0;
                while ($offset < $read) {
                    my $written = syswrite($out, $buffer, $read - $offset, $offset);
                    defined($written) && $written > 0 or die "write target: $!\n";
                    $offset += $written;
                }
            }
            $copy_sha->hexdigest eq $digest or die "copy digest changed\n";
            my $wanted = ($source_mode & 0111) ? 0500 : 0400;
            chmod($wanted, $out) or die "chmod target: $!\n";
            my @dst = stat($out);
            my $got = S_IMODE($dst[2]);
            unless ($got == $wanted) {
                # Windows has no per-user permission bits and no mode-based
                # execute bit: MSYS maps any read-only file to 0444 whatever
                # was requested. Measured on msys perl -- chmod 0400 -> 0444,
                # chmod 0500 -> 0444 -- so both the owner-only narrowing and
                # the execute bit are unrepresentable and exact equality can
                # never hold there.
                #
                # The property this check exists to enforce is that the frozen
                # generation is IMMUTABLE, and that IS representable: assert
                # the file carries no write bit. Executability is decided by
                # the PE header on Windows, not by mode, so it is left
                # unasserted rather than asserted falsely.
                #
                # Unix is unchanged: exact equality is still required there.
                die "target mode mismatch\n"
                    unless $^O =~ /^(?:MSWin32|msys|cygwin)$/
                        && ($got & 0222) == 0;
            }
            close($out) or die "close target: $!\n";
            close($in) or die "close source: $!\n";
            rename($pending, $target) or die "publish target: $!\n";
            push @targets, [$target, $wanted, $digest];
            $copied++;
            if ($copied == 1 && ($ENV{BOOTSTRAP_STAGE3_TEST_MUTATE_AFTER_TUPLE_COPY} // q{}) eq q{1}) {
                open(my $mutate, ">>", $path) or die "test mutation: $!\n";
                print {$mutate} "test-source-mutation\n";
                close($mutate) or die "test mutation close: $!\n";
            }
            if ($copied == 1 && ($ENV{BOOTSTRAP_STAGE3_TEST_REPLACE_AFTER_TUPLE_COPY} // q{}) eq q{1}) {
                my $replacement = "$path.replacement";
                open(my $replace, ">", $replacement) or die "test replacement: $!\n";
                print {$replace} "replacement\n";
                close($replace) or die "test replacement close: $!\n";
                rename($replacement, $path) or die "test replacement rename: $!\n";
            }
        }
        for my $record (@before) {
            my ($name, $dev, $ino, $mode, $size, $mtime, $ctime, $digest) = @$record;
            my ($fh, $now) = open_bound(source_path($source, $name));
            ($now->[0] == $dev && $now->[1] == $ino && $now->[2] == $mode &&
             $now->[7] == $size && $now->[9] == $mtime && $now->[10] == $ctime &&
             digest_fh($fh) eq $digest) or die "source vector changed\n";
            close($fh) or die "close verify source: $!\n";
        }
        for my $target (@targets) {
            my ($path, $wanted, $digest) = @$target;
            my @st = lstat($path);
            @st && S_ISREG($st[2]) && !S_ISLNK($st[2])
                or die "target identity/mode changed\n";
            # Same Windows mode limitation as the copy step above: MSYS
            # reports 0444 for anything read-only, so an exact match on
            # 0400/0500 is unattainable. Immutability is still asserted.
            unless (S_IMODE($st[2]) == $wanted) {
                die "target identity/mode changed\n"
                    unless $^O =~ /^(?:MSWin32|msys|cygwin)$/
                        && (S_IMODE($st[2]) & 0222) == 0;
            }
            my ($fh) = open_bound($path);
            digest_fh($fh) eq $digest or die "target digest changed\n";
            close($fh) or die "close verify target: $!\n";
        }
        for my $name (@names) {
            next unless $name =~ m{/};
            my $parent = $destination;
            my @parts = split m{/}, $name;
            pop @parts;
            for my $part (@parts) {
                $parent .= "/$part";
                chmod(0500, $parent) or die "freeze parent: $!\n";
            }
        }
        chmod(0500, $destination) or die "freeze destination: $!\n";
    ' "$bootstrap_stage3_tuple_source" \
        "$bootstrap_stage3_tuple_destination" "$@" || return 1

    # Publish a small receipt beside the frozen capsule.  Consumers resolve
    # only this authority-relative path; Cargo target/latest/env paths are not
    # inputs to the contract.
    chmod 700 "$bootstrap_stage3_tuple_destination" || return 1
    bootstrap_stage3_hosted_relative=$bootstrap_stage3_hosted_name
    bootstrap_stage3_hosted_projected=\
"$bootstrap_stage3_tuple_destination/$bootstrap_stage3_hosted_relative"
    bootstrap_stage3_hosted_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_hosted_projected") || return 1
    bootstrap_stage3_hosted_receipt=\
"$bootstrap_stage3_tuple_destination/hosted-runtime.env"
    bootstrap_stage3_hosted_pending="${bootstrap_stage3_hosted_receipt}.tmp.$$"
    [ ! -e "$bootstrap_stage3_hosted_receipt" ] &&
        [ ! -L "$bootstrap_stage3_hosted_receipt" ] || return 1
    {
        echo 'schema=simple-bootstrap-hosted-runtime-authority-v1'
        echo 'status=frozen'
        echo "relative_path=$bootstrap_stage3_hosted_relative"
        echo "sha256=$bootstrap_stage3_hosted_sha"
    } >"$bootstrap_stage3_hosted_pending" || return 1
    chmod 400 "$bootstrap_stage3_hosted_pending" || return 1
    mv "$bootstrap_stage3_hosted_pending" \
        "$bootstrap_stage3_hosted_receipt" || return 1
    chmod 500 "$bootstrap_stage3_tuple_destination" || return 1
    bootstrap_stage3_verify_hosted_runtime_authority \
        "$bootstrap_stage3_tuple_destination"
}

bootstrap_stage3_verify_hosted_runtime_authority() {
    [ "$#" -eq 1 ] || return 64
    bootstrap_stage3_hosted_root=$1
    # Windows ships find.exe and admitted tool PATHs may place System32 ahead
    # of the MSYS utilities. Its command-line grammar is unrelated to POSIX
    # find(1): `-name libspl_hosted_runtime-*.rlib` becomes the misleading
    # `File not found - libspl_hosted_runtime-*.rlib`. Bind every traversal in
    # this verifier to the MSYS/Cygwin utility, as the seed-input fingerprint
    # already does, so an existing hosted runtime cannot be reported missing.
    bootstrap_stage3_hosted_find=find
    case "$(uname -s 2>/dev/null || echo unknown)" in
        MSYS*|MINGW*|CYGWIN*)
            [ -x /usr/bin/find ] || return 1
            bootstrap_stage3_hosted_find=/usr/bin/find
            ;;
    esac
    if [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" = 1 ]; then
        expr "$bootstrap_stage3_hosted_root" : \
            '/proc/[1-9][0-9]*/fd/[1-9][0-9]*$' >/dev/null || return 1
        [ -d "$bootstrap_stage3_hosted_root" ] || return 1
        perl -MFcntl=:mode -e '
            my @st = stat($ARGV[0]);
            @st && S_ISDIR($st[2]) && S_IMODE($st[2]) == oct("0500")
                or exit 1;
        ' "$bootstrap_stage3_hosted_root" || return 1
        bootstrap_stage3_hosted_walk_root="$bootstrap_stage3_hosted_root/."
    else
        [ -d "$bootstrap_stage3_hosted_root" ] &&
            [ ! -L "$bootstrap_stage3_hosted_root" ] || return 1
        bootstrap_stage3_hosted_walk_root=$bootstrap_stage3_hosted_root
    fi
    bootstrap_stage3_hosted_receipt="$bootstrap_stage3_hosted_walk_root/hosted-runtime.env"
    [ -f "$bootstrap_stage3_hosted_receipt" ] &&
        [ ! -L "$bootstrap_stage3_hosted_receipt" ] || return 1
    awk -F= '
        $1 == "schema" || $1 == "status" || $1 == "relative_path" ||
        $1 == "sha256" { count[$1]++; next }
        { exit 1 }
        END {
            if (count["schema"] != 1 || count["status"] != 1 ||
                count["relative_path"] != 1 || count["sha256"] != 1)
                exit 1
        }
    ' "$bootstrap_stage3_hosted_receipt" || return 1
    [ "$(bootstrap_stage3_manifest_value schema "$bootstrap_stage3_hosted_receipt")" = \
        simple-bootstrap-hosted-runtime-authority-v1 ] || return 1
    [ "$(bootstrap_stage3_manifest_value status "$bootstrap_stage3_hosted_receipt")" = \
        frozen ] || return 1
    bootstrap_stage3_hosted_relative=$(bootstrap_stage3_manifest_value \
        relative_path "$bootstrap_stage3_hosted_receipt") || return 1
    case "$bootstrap_stage3_hosted_relative" in
        deps/libspl_hosted_runtime-*.rlib) ;;
        *) return 1 ;;
    esac
    case "$bootstrap_stage3_hosted_relative" in *../*|*/..|/*) return 1 ;; esac
    bootstrap_stage3_hosted_expected=$(bootstrap_stage3_manifest_value \
        sha256 "$bootstrap_stage3_hosted_receipt") || return 1
    printf '%s\n' "$bootstrap_stage3_hosted_expected" |
        grep -Eq '^[0-9a-f]{64}$' || return 1
    bootstrap_stage3_hosted_path=\
"$bootstrap_stage3_hosted_walk_root/$bootstrap_stage3_hosted_relative"
    [ -f "$bootstrap_stage3_hosted_path" ] &&
        [ ! -L "$bootstrap_stage3_hosted_path" ] || return 1
    [ "$(bootstrap_stage3_hash_file "$bootstrap_stage3_hosted_path")" = \
        "$bootstrap_stage3_hosted_expected" ] || return 1
    set -- $(stat -Lc '%d %i' "$bootstrap_stage3_hosted_walk_root" 2>/dev/null || stat -Lf '%d %i' "$bootstrap_stage3_hosted_walk_root") || return 1
    bootstrap_stage3_hosted_root_dev=$1
    bootstrap_stage3_hosted_root_ino=$2
    perl -MFile::Find -MFcntl=:mode -e '
        use strict; use warnings;
        my ($root, $root_dev, $root_ino) = @ARGV;
        my $first = 1;
        find({ no_chdir => 1, wanted => sub {
            if ($first) {
                $first = 0;
                my @root_st = stat($File::Find::name);
                @root_st && S_ISDIR($root_st[2]) &&
                    $root_st[0] == $root_dev && $root_st[1] == $root_ino
                    or die "hosted runtime root identity changed\n";
                return;
            }
            my @st = lstat($File::Find::name);
            @st or die "hosted runtime lstat failed\n";
            -l _ and die "hosted runtime symlink rejected\n";
        }}, $root);
    ' "$bootstrap_stage3_hosted_walk_root" \
        "$bootstrap_stage3_hosted_root_dev" \
        "$bootstrap_stage3_hosted_root_ino" || return 1
    bootstrap_stage3_hosted_count=$("$bootstrap_stage3_hosted_find" "$bootstrap_stage3_hosted_walk_root/deps" \
        -maxdepth 1 -type f -name 'libspl_hosted_runtime-*.rlib' |
        wc -l | tr -d ' ') || return 1
    [ "$bootstrap_stage3_hosted_count" -eq 1 ] || return 1
    # Nothing in a frozen generation may be writable. On Windows that is only
    # enforceable for FILES: MSYS cannot clear the write bit on a directory.
    # Measured on this staging tree after the chmod 0500 freeze --
    #   simple.exe 555, *.lib 444, hosted-runtime.env 444   (correctly frozen)
    #   every directory                            755      (freeze ignored)
    # -- so the unrestricted scan reports the directories and nothing else.
    #
    # Restrict the scan to regular files there rather than skipping it: the
    # artifacts this guard exists to protect are files, they DO freeze, and a
    # writable one still fails. Directory immutability is simply not
    # representable on this platform and is not claimed.
    case "$(uname -s 2>/dev/null || echo unknown)" in
        MSYS*|MINGW*|CYGWIN*)
            [ -z "$("$bootstrap_stage3_hosted_find" \
                "$bootstrap_stage3_hosted_walk_root" \
                -type f -perm /0222 -print -quit)" ] || return 1
            ;;
        *)
            # POSIX -perm -MODE rather than GNU -perm /MODE: BSD find (macOS)
            # rejects the /MODE form outright. PR #97 rewrites this same line
            # for exactly that reason; adopting its spelling here keeps the two
            # branches from conflicting, and the POSIX form is accepted by GNU
            # find too, so Linux is unaffected.
            [ -z "$("$bootstrap_stage3_hosted_find" \
                "$bootstrap_stage3_hosted_walk_root" \
                \( -perm -0200 -o -perm -0020 -o -perm -0002 \) \
                -print -quit)" ] || return 1
            ;;
    esac
    perl -MFcntl=:mode -e '
        use strict; use warnings;
        # Windows cannot represent these modes: MSYS reports 0444 for any
        # read-only file (losing both the owner-only narrowing and the execute
        # bit) and ignores the freeze on directories entirely, leaving them
        # 0755. Measured on a frozen staging tree. Assert what IS representable
        # -- the entry exists, is not a symlink, and no FILE is writable -- and
        # do not claim directory immutability the platform cannot provide.
        my $win = $^O =~ /^(?:MSWin32|msys|cygwin)$/;
        for my $pair (@ARGV) {
            my ($path, $wanted) = split(/=/, $pair, 2);
            my @st = lstat($path);
            @st && !S_ISLNK($st[2]) or exit 1;
            next if S_IMODE($st[2]) == oct($wanted);
            exit 1 unless $win;
            exit 1 if !S_ISDIR($st[2]) && (S_IMODE($st[2]) & 0222);
        }
    ' "$bootstrap_stage3_hosted_walk_root/deps=0500" \
        "$bootstrap_stage3_hosted_receipt=0400" \
        "$bootstrap_stage3_hosted_path=0400" || return 1
    if [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" != 1 ]; then
        # Same platform limitation as the sibling tolerance a few lines above
        # (the $win check on deps/receipt/hosted-path, and the uname-gated
        # writability scan before it): chmod on a DIRECTORY is a no-op on
        # MSYS/MinGW/Cygwin -- measured directly (`chmod 0500 d` returns rc=0
        # and leaves the directory at 755) -- so asserting exact mode 0500 on
        # $bootstrap_stage3_hosted_root unconditionally fails 100% of the time
        # on Windows, regardless of retries. This block was missed when that
        # tolerance was added; do not "fix" it back to a bare equality check.
        # Existence, non-symlink, and directory-ness stay asserted everywhere;
        # only the exact-mode equality is relaxed, and only on those platforms.
        perl -MFcntl=:mode -e '
            my @st = lstat($ARGV[0]);
            @st && !S_ISLNK($st[2]) && S_ISDIR($st[2]) or exit 1;
            my $win = $^O =~ /^(?:MSWin32|msys|cygwin)$/;
            exit 1 unless $win || S_IMODE($st[2]) == oct("0500");
        ' "$bootstrap_stage3_hosted_root" || return 1
    fi
    BOOTSTRAP_STAGE3_HOSTED_RUNTIME_RELATIVE_PATH=$bootstrap_stage3_hosted_relative
    BOOTSTRAP_STAGE3_HOSTED_RUNTIME_SHA256=$bootstrap_stage3_hosted_expected
    BOOTSTRAP_STAGE3_HOSTED_RUNTIME_PATH=$bootstrap_stage3_hosted_path
}

bootstrap_stage3_write_seed_stamp() {
    bootstrap_stage3_stamp=$1
    bootstrap_stage3_stamp_inputs=$2
    bootstrap_stage3_stamp_seed=$3
    bootstrap_stage3_stamp_native_all=$4
    bootstrap_stage3_stamp_backfill=$5
    bootstrap_stage3_stamp_tmp="${bootstrap_stage3_stamp}.tmp.$$"
    [ -x "$bootstrap_stage3_stamp_seed" ] &&
        [ -f "$bootstrap_stage3_stamp_native_all" ] || return 1
    bootstrap_stage3_stamp_backfill_status=absent
    bootstrap_stage3_stamp_backfill_sha=absent
    if [ -f "$bootstrap_stage3_stamp_backfill" ]; then
        bootstrap_stage3_stamp_backfill_status=present
        bootstrap_stage3_stamp_backfill_sha=$(
            bootstrap_stage3_hash_file "$bootstrap_stage3_stamp_backfill"
        ) || return 1
    fi
    {
        echo "schema=simple-bootstrap-seed-artifact-stamp-v2"
        echo "inputs_fingerprint=$bootstrap_stage3_stamp_inputs"
        echo "seed_sha256=$(bootstrap_stage3_hash_file \
            "$bootstrap_stage3_stamp_seed")"
        echo "native_all_sha256=$(bootstrap_stage3_hash_file \
            "$bootstrap_stage3_stamp_native_all")"
        echo "backfill_status=$bootstrap_stage3_stamp_backfill_status"
        echo "backfill_sha256=$bootstrap_stage3_stamp_backfill_sha"
        bootstrap_stage3_stamp_details="${bootstrap_stage3_stamp}.details.env"
        if [ -f "$bootstrap_stage3_stamp_details" ] &&
            [ ! -L "$bootstrap_stage3_stamp_details" ]; then
            echo "fingerprint_details_file=$(basename -- "$bootstrap_stage3_stamp_details")"
            echo "fingerprint_details_sha256=$(bootstrap_stage3_hash_file "$bootstrap_stage3_stamp_details")"
        fi
    } >"$bootstrap_stage3_stamp_tmp" || return 1
    mv "$bootstrap_stage3_stamp_tmp" "$bootstrap_stage3_stamp"
}

bootstrap_stage3_verify_seed_stamp() {
    bootstrap_stage3_stamp=$1
    bootstrap_stage3_stamp_inputs=$2
    bootstrap_stage3_stamp_seed=$3
    bootstrap_stage3_stamp_native_all=$4
    bootstrap_stage3_stamp_backfill=$5
    [ -f "$bootstrap_stage3_stamp" ] || return 1
    if [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" = 1 ]; then
        expr "$bootstrap_stage3_stamp" : \
            '/proc/[1-9][0-9]*/fd/[1-9][0-9]*$' >/dev/null || return 1
    else
        [ ! -L "$bootstrap_stage3_stamp" ] || return 1
    fi
    [ "$(bootstrap_stage3_manifest_value schema \
        "$bootstrap_stage3_stamp")" = \
        simple-bootstrap-seed-artifact-stamp-v2 ] || return 1
    [ "$(bootstrap_stage3_manifest_value inputs_fingerprint \
        "$bootstrap_stage3_stamp")" = "$bootstrap_stage3_stamp_inputs" ] ||
        return 1
    [ "$(bootstrap_stage3_manifest_value seed_sha256 \
        "$bootstrap_stage3_stamp")" = \
        "$(bootstrap_stage3_hash_file "$bootstrap_stage3_stamp_seed")" ] ||
        return 1
    [ "$(bootstrap_stage3_manifest_value native_all_sha256 \
        "$bootstrap_stage3_stamp")" = \
        "$(bootstrap_stage3_hash_file "$bootstrap_stage3_stamp_native_all")" ] ||
        return 1
    if [ -f "$bootstrap_stage3_stamp_backfill" ]; then
        [ "$(bootstrap_stage3_manifest_value backfill_status \
            "$bootstrap_stage3_stamp")" = present ] &&
            [ "$(bootstrap_stage3_manifest_value backfill_sha256 \
                "$bootstrap_stage3_stamp")" = \
                "$(bootstrap_stage3_hash_file \
                    "$bootstrap_stage3_stamp_backfill")" ] || return 1
    else
        [ "$(bootstrap_stage3_manifest_value backfill_status \
            "$bootstrap_stage3_stamp")" = absent ] &&
            [ "$(bootstrap_stage3_manifest_value backfill_sha256 \
                "$bootstrap_stage3_stamp")" = absent ] || return 1
    fi
    bootstrap_stage3_stamp_details_file=$(bootstrap_stage3_manifest_value \
        fingerprint_details_file "$bootstrap_stage3_stamp" 2>/dev/null || true)
    bootstrap_stage3_stamp_details_sha=$(bootstrap_stage3_manifest_value \
        fingerprint_details_sha256 "$bootstrap_stage3_stamp" 2>/dev/null || true)
    if [ -n "$bootstrap_stage3_stamp_details_file" ] ||
        [ -n "$bootstrap_stage3_stamp_details_sha" ]; then
        case "$bootstrap_stage3_stamp_details_file" in
            ''|.|..|/*|*/*|*[!A-Za-z0-9_.-]*) return 1 ;;
        esac
        bootstrap_stage3_valid_fingerprint "$bootstrap_stage3_stamp_details_sha" || return 1
        bootstrap_stage3_stamp_details_path="$(dirname -- "$bootstrap_stage3_stamp")/$bootstrap_stage3_stamp_details_file"
        [ -f "$bootstrap_stage3_stamp_details_path" ] &&
            [ ! -L "$bootstrap_stage3_stamp_details_path" ] || return 1
        [ "$(bootstrap_stage3_hash_file "$bootstrap_stage3_stamp_details_path")" = \
            "$bootstrap_stage3_stamp_details_sha" ] || return 1
        [ "$(bootstrap_stage3_manifest_value schema \
            "$bootstrap_stage3_stamp_details_path")" = \
            simple-bootstrap-fingerprint-details-v1 ] || return 1
        [ "$(bootstrap_stage3_manifest_value aggregate_sha256 \
            "$bootstrap_stage3_stamp_details_path")" = \
            "$bootstrap_stage3_stamp_inputs" ] || return 1
    fi
}

bootstrap_stage3_valid_fingerprint() {
    [ "$#" -eq 1 ] || return 1
    [ "${#1}" -eq 64 ] || return 1
    case "$1" in *[!0-9a-f]*) return 1 ;; esac
}

bootstrap_stage3_safe_generation_name() {
    [ "$#" -eq 1 ] || return 1
    case "$1" in ''|.|..|*/*|*\\*|*[!A-Za-z0-9._-]*) return 1 ;; esac
}

bootstrap_stage3_rust_tuple_requires_complete_rebuild() {
    [ "$#" -eq 4 ] || return 1
    [ -x "$1" ] && [ -f "$2" ] && [ -f "$3" ] && [ "$4" -eq 0 ] &&
        return 1
    return 0
}

bootstrap_stage3_pin_private_authority() {
    [ "$#" -eq 4 ] || return 1
    bootstrap_stage3_private_root=$1
    bootstrap_stage3_private_seed_name=$2
    bootstrap_stage3_private_native_name=$3
    bootstrap_stage3_private_backfill_name=$4
    [ -d "$bootstrap_stage3_private_root" ] &&
        [ ! -L "$bootstrap_stage3_private_root" ] &&
        [ -x "$bootstrap_stage3_private_root/$bootstrap_stage3_private_seed_name" ] &&
        [ -f "$bootstrap_stage3_private_root/$bootstrap_stage3_private_native_name" ] &&
        [ -f "$bootstrap_stage3_private_root/$bootstrap_stage3_private_backfill_name" ] || return 1
    BOOTSTRAP_STAGE3_PRIVATE_RUNTIME=$bootstrap_stage3_private_root
    BOOTSTRAP_STAGE3_PRIVATE_SEED=\
"$bootstrap_stage3_private_root/$bootstrap_stage3_private_seed_name"
    BOOTSTRAP_STAGE3_PRIVATE_NATIVE_ALL=\
"$bootstrap_stage3_private_root/$bootstrap_stage3_private_native_name"
    BOOTSTRAP_STAGE3_PRIVATE_BACKFILL=\
"$bootstrap_stage3_private_root/$bootstrap_stage3_private_backfill_name"
}

# Prepare and publish immutable Rust authority generations. The current marker
# is the commit record; a generation is never mutated after marker admission.
bootstrap_stage3_prepare_seed_generation() {
    [ "$#" -eq 7 ] || return 1
    bootstrap_stage3_generation_source=$1
    bootstrap_stage3_generation_root=$2
    bootstrap_stage3_generation_inputs=$3
    bootstrap_stage3_generation_seed_name=$4
    bootstrap_stage3_generation_native_name=$5
    bootstrap_stage3_generation_backfill_name=$6
    bootstrap_stage3_generation_nonce=$7
    bootstrap_stage3_valid_fingerprint "$bootstrap_stage3_generation_inputs" || return 1
    bootstrap_stage3_generation_staging=\
"$bootstrap_stage3_generation_root/.staging.$bootstrap_stage3_generation_nonce"
    rm -rf "$bootstrap_stage3_generation_staging"
    mkdir -p "$bootstrap_stage3_generation_root" || return 1
    bootstrap_stage3_copy_seed_tuple "$bootstrap_stage3_generation_source" \
        "$bootstrap_stage3_generation_staging" \
        "$bootstrap_stage3_generation_seed_name" \
        "$bootstrap_stage3_generation_native_name" \
        "$bootstrap_stage3_generation_backfill_name" || return 1
    # Carry the successful fingerprint sidecar into the immutable generation.
    # It is optional for legacy callers and is never accepted from a symlink.
    bootstrap_stage3_generation_details_source=${BOOTSTRAP_STAGE3_FINGERPRINT_DETAILS_SOURCE:-}
    if [ -n "$bootstrap_stage3_generation_details_source" ]; then
        [ -f "$bootstrap_stage3_generation_details_source" ] &&
            [ ! -L "$bootstrap_stage3_generation_details_source" ] || return 1
    fi
    # Tuple projection returns a frozen 0500 root.  Thaw only that staging
    # root, after all optional inputs have been validated, so generation-owned
    # metadata can be added before publication.  Descendant directories and
    # tuple members remain frozen; no marker can admit this staging path.
    chmod 700 "$bootstrap_stage3_generation_staging" || return 1
    if [ -n "$bootstrap_stage3_generation_details_source" ]; then
        cp -p -- "$bootstrap_stage3_generation_details_source" \
            "$bootstrap_stage3_generation_staging/$bootstrap_stage3_generation_seed_name.inputs.sha256.details.env" || return 1
        chmod 400 "$bootstrap_stage3_generation_staging/$bootstrap_stage3_generation_seed_name.inputs.sha256.details.env" || return 1
    fi
    bootstrap_stage3_generation_stamp=\
"$bootstrap_stage3_generation_staging/$bootstrap_stage3_generation_seed_name.inputs.sha256"
    bootstrap_stage3_write_seed_stamp "$bootstrap_stage3_generation_stamp" \
        "$bootstrap_stage3_generation_inputs" \
        "$bootstrap_stage3_generation_staging/$bootstrap_stage3_generation_seed_name" \
        "$bootstrap_stage3_generation_staging/$bootstrap_stage3_generation_native_name" \
        "$bootstrap_stage3_generation_staging/$bootstrap_stage3_generation_backfill_name" || return 1
    chmod 400 "$bootstrap_stage3_generation_stamp" || return 1
    bootstrap_stage3_verify_seed_stamp "$bootstrap_stage3_generation_stamp" \
        "$bootstrap_stage3_generation_inputs" \
        "$bootstrap_stage3_generation_staging/$bootstrap_stage3_generation_seed_name" \
        "$bootstrap_stage3_generation_staging/$bootstrap_stage3_generation_native_name" \
        "$bootstrap_stage3_generation_staging/$bootstrap_stage3_generation_backfill_name" || return 1
    bootstrap_stage3_generation_snapshot=\
"$bootstrap_stage3_generation_root/.snapshot.$bootstrap_stage3_generation_nonce"
    bootstrap_stage3_directory_snapshot "$bootstrap_stage3_generation_snapshot" \
        "$bootstrap_stage3_generation_staging" || return 1
    bootstrap_stage3_generation_hash=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_generation_snapshot") || return 1
    rm -f "$bootstrap_stage3_generation_snapshot"
    BOOTSTRAP_STAGE3_PREPARED_GENERATION=\
"$bootstrap_stage3_generation_root/$bootstrap_stage3_generation_inputs-$bootstrap_stage3_generation_hash"
    BOOTSTRAP_STAGE3_PREPARED_STAGING=$bootstrap_stage3_generation_staging
    BOOTSTRAP_STAGE3_PREPARED_HASH=$bootstrap_stage3_generation_hash
    # Keep only the staging root owner-writable until publication.  Its files
    # and descendant directories are already frozen by the copy/stamp owners.
    # macOS can reject rename(2) of a pre-frozen directory in hosted-runner
    # workspaces; immutability begins after the same-parent atomic rename and
    # before any marker can admit the generation.
    chmod 700 "$bootstrap_stage3_generation_staging" || return 1
}

bootstrap_stage3_publish_seed_generation() {
    [ "$#" -eq 7 ] || return 1
    bootstrap_stage3_publish_staging=$1
    bootstrap_stage3_publish_final=$2
    bootstrap_stage3_publish_marker=$3
    bootstrap_stage3_publish_inputs=$4
    bootstrap_stage3_publish_hash=$5
    bootstrap_stage3_publish_observed_inputs=$6
    bootstrap_stage3_publish_compatibility=$7
    [ "$bootstrap_stage3_publish_inputs" = \
        "$bootstrap_stage3_publish_observed_inputs" ] || return 1
    bootstrap_stage3_valid_fingerprint "$bootstrap_stage3_publish_inputs" || return 1
    bootstrap_stage3_valid_fingerprint "$bootstrap_stage3_publish_hash" || return 1
    bootstrap_stage3_publish_root=$(dirname -- "$bootstrap_stage3_publish_final")
    bootstrap_stage3_publish_name=$(basename -- "$bootstrap_stage3_publish_final")
    bootstrap_stage3_safe_generation_name "$bootstrap_stage3_publish_name" || return 1
    [ "$bootstrap_stage3_publish_name" = \
        "$bootstrap_stage3_publish_inputs-$bootstrap_stage3_publish_hash" ] || return 1
    if [ -d "$bootstrap_stage3_publish_staging" ]; then
        bootstrap_stage3_publish_material=$bootstrap_stage3_publish_staging
    elif [ -d "$bootstrap_stage3_publish_final" ]; then
        bootstrap_stage3_publish_material=$bootstrap_stage3_publish_final
    else
        return 1
    fi
    # The prepared directory can wait for the publication lock.  Rebind its
    # complete bytes and executable-mode vector at the commit boundary rather
    # than trusting a hash returned before that wait.
    bootstrap_stage3_publish_snapshot=\
"$bootstrap_stage3_publish_root/.publish.$$.snapshot"
    bootstrap_stage3_directory_snapshot "$bootstrap_stage3_publish_snapshot" \
        "$bootstrap_stage3_publish_material" || return 1
    bootstrap_stage3_publish_observed_hash=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_publish_snapshot") || return 1
    rm -f "$bootstrap_stage3_publish_snapshot"
    [ "$bootstrap_stage3_publish_observed_hash" = \
        "$bootstrap_stage3_publish_hash" ] || return 1
    set -- "$bootstrap_stage3_publish_material"/*.inputs.sha256
    [ "$#" -eq 1 ] && [ -f "$1" ] || return 1
    bootstrap_stage3_publish_stamp=$1
    [ "$(bootstrap_stage3_manifest_value inputs_fingerprint \
        "$bootstrap_stage3_publish_stamp")" = \
        "$bootstrap_stage3_publish_inputs" ] || return 1
    bootstrap_stage3_publish_stamp_hash=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_publish_stamp") || return 1
    bootstrap_stage3_publish_mode=new
    if [ -d "$bootstrap_stage3_publish_final" ]; then
        bootstrap_stage3_publish_existing=\
"$bootstrap_stage3_publish_root/.existing.$$"
        bootstrap_stage3_directory_snapshot "$bootstrap_stage3_publish_existing" \
            "$bootstrap_stage3_publish_final" || return 1
        [ "$(bootstrap_stage3_hash_file "$bootstrap_stage3_publish_existing")" = \
            "$bootstrap_stage3_publish_hash" ] || return 1
        rm -f "$bootstrap_stage3_publish_existing"
        chmod -R u+w "$bootstrap_stage3_publish_staging" 2>/dev/null || true
        rm -rf "$bootstrap_stage3_publish_staging"
        bootstrap_stage3_publish_mode=existing
    fi
    bootstrap_stage3_publish_helper=\
"${BOOTSTRAP_STAGE3_AUTHORITY_PUBLISH_HELPER:-\
$(dirname -- "$BOOTSTRAP_STAGE3_FACADE_PATH")/bootstrap-authority-generation-publish.pl}"
    [ -f "$bootstrap_stage3_publish_helper" ] || return 1
    perl "$bootstrap_stage3_publish_helper" \
        "$bootstrap_stage3_publish_mode" \
        "$bootstrap_stage3_publish_staging" \
        "$bootstrap_stage3_publish_final" \
        "$bootstrap_stage3_publish_marker" \
        "$bootstrap_stage3_publish_compatibility" \
        "$bootstrap_stage3_publish_inputs" \
        "$bootstrap_stage3_publish_hash" \
        "$bootstrap_stage3_publish_stamp_hash"
}

bootstrap_stage3_recover_seed_transaction() {
    [ "$#" -eq 3 ] || return 1
    bootstrap_stage3_recover_root=$1
    bootstrap_stage3_recover_marker=$2
    bootstrap_stage3_recover_compatibility=$3
    bootstrap_stage3_recover_transaction=\
"$bootstrap_stage3_recover_marker.transaction"
    [ -f "$bootstrap_stage3_recover_transaction" ] &&
        [ ! -L "$bootstrap_stage3_recover_transaction" ] || return 1
    [ "$(bootstrap_stage3_manifest_value schema \
        "$bootstrap_stage3_recover_transaction")" = \
        simple-bootstrap-authority-transaction-v1 ] || return 1
    bootstrap_stage3_recover_name=$(bootstrap_stage3_manifest_value generation \
        "$bootstrap_stage3_recover_transaction") || return 1
    bootstrap_stage3_recover_inputs=$(bootstrap_stage3_manifest_value \
        inputs_fingerprint "$bootstrap_stage3_recover_transaction") || return 1
    bootstrap_stage3_recover_hash=$(bootstrap_stage3_manifest_value \
        generation_sha256 "$bootstrap_stage3_recover_transaction") || return 1
    bootstrap_stage3_recover_stamp_hash=$(bootstrap_stage3_manifest_value \
        stamp_sha256 "$bootstrap_stage3_recover_transaction") || return 1
    bootstrap_stage3_safe_generation_name "$bootstrap_stage3_recover_name" || return 1
    bootstrap_stage3_valid_fingerprint "$bootstrap_stage3_recover_inputs" || return 1
    bootstrap_stage3_valid_fingerprint "$bootstrap_stage3_recover_hash" || return 1
    bootstrap_stage3_valid_fingerprint "$bootstrap_stage3_recover_stamp_hash" || return 1
    [ "$bootstrap_stage3_recover_name" = \
        "$bootstrap_stage3_recover_inputs-$bootstrap_stage3_recover_hash" ] || return 1
    bootstrap_stage3_recover_generation=\
"$bootstrap_stage3_recover_root/$bootstrap_stage3_recover_name"
    [ -d "$bootstrap_stage3_recover_generation" ] &&
        [ ! -L "$bootstrap_stage3_recover_generation" ] || return 1
    bootstrap_stage3_recover_snapshot="$bootstrap_stage3_recover_root/.recover.$$"
    bootstrap_stage3_directory_snapshot "$bootstrap_stage3_recover_snapshot" \
        "$bootstrap_stage3_recover_generation" || return 1
    [ "$(bootstrap_stage3_hash_file "$bootstrap_stage3_recover_snapshot")" = \
        "$bootstrap_stage3_recover_hash" ] || return 1
    rm -f "$bootstrap_stage3_recover_snapshot"
    set -- "$bootstrap_stage3_recover_generation"/*.inputs.sha256
    [ "$#" -eq 1 ] && [ -f "$1" ] || return 1
    [ "$(bootstrap_stage3_hash_file "$1")" = \
        "$bootstrap_stage3_recover_stamp_hash" ] || return 1
    [ "$(bootstrap_stage3_manifest_value inputs_fingerprint "$1")" = \
        "$bootstrap_stage3_recover_inputs" ] || return 1
    bootstrap_stage3_publish_compatibility_pointer \
        "$bootstrap_stage3_recover_compatibility" \
        "$bootstrap_stage3_recover_generation" \
        "$bootstrap_stage3_recover_root" || return 1
    bootstrap_stage3_recover_tmp="$bootstrap_stage3_recover_marker.tmp.$$"
    {
        echo 'schema=simple-bootstrap-authority-current-v1'
        echo "generation=$bootstrap_stage3_recover_name"
        echo "inputs_fingerprint=$bootstrap_stage3_recover_inputs"
        echo "generation_sha256=$bootstrap_stage3_recover_hash"
        echo "stamp_sha256=$bootstrap_stage3_recover_stamp_hash"
    } >"$bootstrap_stage3_recover_tmp" || return 1
    mv "$bootstrap_stage3_recover_tmp" "$bootstrap_stage3_recover_marker" || return 1
    rm -f "$bootstrap_stage3_recover_transaction"
    bootstrap_stage3_resolve_committed_seed "$bootstrap_stage3_recover_root" \
        "$bootstrap_stage3_recover_marker"
}

bootstrap_stage3_resolve_committed_seed() {
    [ "$#" -eq 2 ] || return 1
    bootstrap_stage3_resolve_root=$1
    bootstrap_stage3_resolve_marker=$2
    [ -d "$bootstrap_stage3_resolve_root" ] &&
        [ ! -L "$bootstrap_stage3_resolve_root" ] &&
        [ -f "$bootstrap_stage3_resolve_marker" ] &&
        [ ! -L "$bootstrap_stage3_resolve_marker" ] || return 1
    [ ! -e "$bootstrap_stage3_resolve_marker.transaction" ] || return 1
    [ "$(bootstrap_stage3_manifest_value schema \
        "$bootstrap_stage3_resolve_marker")" = \
        simple-bootstrap-authority-current-v1 ] || return 1
    bootstrap_stage3_resolve_name=$(bootstrap_stage3_manifest_value generation \
        "$bootstrap_stage3_resolve_marker") || return 1
    bootstrap_stage3_safe_generation_name "$bootstrap_stage3_resolve_name" || return 1
    bootstrap_stage3_resolve_inputs=$(bootstrap_stage3_manifest_value \
        inputs_fingerprint "$bootstrap_stage3_resolve_marker") || return 1
    bootstrap_stage3_valid_fingerprint "$bootstrap_stage3_resolve_inputs" || return 1
    bootstrap_stage3_resolve_marker_hash=$(bootstrap_stage3_manifest_value \
        generation_sha256 "$bootstrap_stage3_resolve_marker") || return 1
    bootstrap_stage3_valid_fingerprint \
        "$bootstrap_stage3_resolve_marker_hash" || return 1
    [ "$bootstrap_stage3_resolve_name" = \
        "$bootstrap_stage3_resolve_inputs-$bootstrap_stage3_resolve_marker_hash" ] || return 1
    bootstrap_stage3_resolve_dir=\
"$bootstrap_stage3_resolve_root/$bootstrap_stage3_resolve_name"
    [ -d "$bootstrap_stage3_resolve_dir" ] &&
        [ ! -L "$bootstrap_stage3_resolve_dir" ] || return 1
    bootstrap_stage3_resolve_snapshot="$bootstrap_stage3_resolve_root/.resolve.$$"
    bootstrap_stage3_directory_snapshot "$bootstrap_stage3_resolve_snapshot" \
        "$bootstrap_stage3_resolve_dir" || return 1
    bootstrap_stage3_resolve_hash=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_resolve_snapshot") || return 1
    rm -f "$bootstrap_stage3_resolve_snapshot"
    [ "$bootstrap_stage3_resolve_hash" = \
        "$bootstrap_stage3_resolve_marker_hash" ] || return 1
    set -- "$bootstrap_stage3_resolve_dir"/*.inputs.sha256
    [ "$#" -eq 1 ] && [ -f "$1" ] || return 1
    [ "$(bootstrap_stage3_manifest_value inputs_fingerprint "$1")" = \
        "$bootstrap_stage3_resolve_inputs" ] || return 1
    [ "$(bootstrap_stage3_hash_file "$1")" = \
        "$(bootstrap_stage3_manifest_value stamp_sha256 \
            "$bootstrap_stage3_resolve_marker")" ] || return 1
    BOOTSTRAP_STAGE3_COMMITTED_AUTHORITY=$bootstrap_stage3_resolve_dir
}

bootstrap_stage3_publish_compatibility_pointer() {
    [ "$#" -eq 3 ] || return 1
    bootstrap_stage3_compatibility_path=$1
    bootstrap_stage3_compatibility_generation=$2
    bootstrap_stage3_compatibility_root=$3
    bootstrap_stage3_compatibility_marker=\
"$bootstrap_stage3_compatibility_path.migration.env"
    bootstrap_stage3_compatibility_name=$(basename -- \
        "$bootstrap_stage3_compatibility_generation")
    {
        echo 'schema=simple-bootstrap-authority-migration-v1'
        echo "generation=$bootstrap_stage3_compatibility_name"
    } >"$bootstrap_stage3_compatibility_marker.tmp.$$" || return 1
    mv "$bootstrap_stage3_compatibility_marker.tmp.$$" \
        "$bootstrap_stage3_compatibility_marker" || return 1
    if [ -d "$bootstrap_stage3_compatibility_path" ] &&
        [ ! -L "$bootstrap_stage3_compatibility_path" ]; then
        bootstrap_stage3_compatibility_snapshot=\
"$bootstrap_stage3_compatibility_root/.legacy.$$"
        bootstrap_stage3_directory_snapshot \
            "$bootstrap_stage3_compatibility_snapshot" \
            "$bootstrap_stage3_compatibility_path" || return 1
        bootstrap_stage3_compatibility_legacy_hash=$(bootstrap_stage3_hash_file \
            "$bootstrap_stage3_compatibility_snapshot") || return 1
        rm -f "$bootstrap_stage3_compatibility_snapshot"
        bootstrap_stage3_compatibility_legacy=\
"$bootstrap_stage3_compatibility_root/legacy-$bootstrap_stage3_compatibility_legacy_hash"
        if [ ! -e "$bootstrap_stage3_compatibility_legacy" ]; then
            mv "$bootstrap_stage3_compatibility_path" \
                "$bootstrap_stage3_compatibility_legacy" || return 1
        else
            return 1
        fi
    fi
    bootstrap_stage3_compatibility_parent=$(dirname -- \
        "$bootstrap_stage3_compatibility_path")
    bootstrap_stage3_compatibility_relative=\
"$(basename -- "$bootstrap_stage3_compatibility_root")/$bootstrap_stage3_compatibility_name"
    bootstrap_stage3_compatibility_tmp=\
"$bootstrap_stage3_compatibility_parent/.bootstrap-link.$$"
    rm -f "$bootstrap_stage3_compatibility_tmp"
    bootstrap_stage3_create_compatibility_link \
        "$bootstrap_stage3_compatibility_relative" \
        "$bootstrap_stage3_compatibility_tmp" || return 1
    perl -e 'rename($ARGV[0], $ARGV[1]) or die "rename: $!\n"' \
        "$bootstrap_stage3_compatibility_tmp" \
        "$bootstrap_stage3_compatibility_path" || return 1
    rm -f "$bootstrap_stage3_compatibility_marker"
}

bootstrap_stage3_create_compatibility_link() {
    [ "$#" -eq 2 ] || return 1
    bootstrap_stage3_link_target=$1
    bootstrap_stage3_link_path=$2
    case "$(uname -s 2>/dev/null || echo unknown)" in
    MINGW*|MSYS*|CYGWIN*)
        bootstrap_stage3_link_parent=$(dirname -- "$bootstrap_stage3_link_path") || return 1
        bootstrap_stage3_link_target_abs=$(CDPATH= cd -- \
            "$bootstrap_stage3_link_parent/$bootstrap_stage3_link_target" && pwd -P) || return 1
        bootstrap_stage3_link_path_win=$(cygpath -w "$bootstrap_stage3_link_path") || return 1
        bootstrap_stage3_link_target_win=$(cygpath -w "$bootstrap_stage3_link_target_abs") || return 1
        # Directory junctions preserve the directory-only compatibility ABI and
        # require no SeCreateSymbolicLinkPrivilege.  Build the junction at the
        # transaction's private temporary name; the caller atomically renames
        # that reparse point into place only after this exact-target check.
        cmd.exe //d //c mklink //J "$bootstrap_stage3_link_path_win" \
            "$bootstrap_stage3_link_target_win" >/dev/null || return 1
        if ! fsutil.exe reparsepoint query "$bootstrap_stage3_link_path_win" \
            >/dev/null 2>&1 ||
            [ "$(CDPATH= cd -- "$bootstrap_stage3_link_path" && pwd -P)" != \
              "$bootstrap_stage3_link_target_abs" ]; then
            rm -rf "$bootstrap_stage3_link_path"
            return 1
        fi
        return 0
        ;;
    esac
    MSYS="${MSYS:+${MSYS} }winsymlinks:nativestrict" \
        ln -s "$bootstrap_stage3_link_target" \
            "$bootstrap_stage3_link_path" || return 1
    [ -L "$bootstrap_stage3_link_path" ] || {
        rm -rf "$bootstrap_stage3_link_path"
        return 1
    }
}

bootstrap_stage3_compatibility_pointer_valid() {
    [ "$#" -eq 1 ] || return 1
    bootstrap_stage3_pointer_path=$1
    [ -d "$bootstrap_stage3_pointer_path" ] || return 1
    if [ -L "$bootstrap_stage3_pointer_path" ]; then
        return 0
    fi
    case "$(uname -s 2>/dev/null || echo unknown)" in
    MINGW*|MSYS*|CYGWIN*)
        bootstrap_stage3_pointer_win=$(cygpath -w "$bootstrap_stage3_pointer_path") || return 1
        fsutil.exe reparsepoint query "$bootstrap_stage3_pointer_win" >/dev/null 2>&1
        ;;
    *) return 1 ;;
    esac
}

# Bind the checked-out commit plus the actual tracked dirty bytes/symlink
# targets and untracked bytes/symlink targets.  A porcelain path list alone is
# insufficient because an already-dirty file can change without changing it.
# Read-only native v2 consumer. Keep this boundary in the Stage3 authority;
# it never invokes the producer or creates/replaces checkout aliases.
bootstrap_stage3_materialized_native_source() {
    cat <<'STAGE3_NATIVE'
$ErrorActionPreference = "Stop"
try {
Add-Type -TypeDefinition @'
using System;
using System.IO;
using System.Text;
using System.Collections.Generic;
using System.Runtime.InteropServices;
using Microsoft.Win32.SafeHandles;
public static class Stage3MaterializedConsumer {
    [StructLayout(LayoutKind.Sequential)] struct Info {
        public uint Attributes, CreationLow, CreationHigh, AccessLow, AccessHigh,
            WriteLow, WriteHigh, Volume, SizeHigh, SizeLow, Links, IndexHigh, IndexLow;
    }
    [StructLayout(LayoutKind.Sequential)] struct TagInfo { public uint Attributes, Tag; }
    [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
    static extern SafeFileHandle CreateFileW(string p, uint access, uint share,
        IntPtr security, uint disposition, uint flags, IntPtr template);
    [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
    static extern uint GetFileAttributesW(string p);
    [DllImport("kernel32.dll", SetLastError=true)]
    static extern bool GetFileInformationByHandle(SafeFileHandle h, out Info info);
    [DllImport("kernel32.dll", SetLastError=true)]
    static extern bool GetFileInformationByHandleEx(SafeFileHandle h, int cls, out TagInfo info, uint size);
    static Exception Error(string predicate) {
        return new IOException(predicate + ":win32=" + Marshal.GetLastWin32Error());
    }
    static SafeFileHandle Open(string p, bool raw, uint access) {
        var h = CreateFileW(p, access, 1, IntPtr.Zero, 3,
            0x02000000u | (raw ? 0x00200000u : 0), IntPtr.Zero);
        if (h.IsInvalid) { h.Dispose(); throw Error("api.open:" + p); }
        return h;
    }
    static TagInfo Tag(SafeFileHandle h) {
        TagInfo i;
        if (!GetFileInformationByHandleEx(h, 9, out i, 8)) throw Error("api.attribute-tag");
        return i;
    }
    static Info Identity(SafeFileHandle h) {
        Info i;
        if (!GetFileInformationByHandle(h, out i)) throw Error("api.file-identity");
        return i;
    }
    // Retain handles without write/delete sharing through the protected action.
    // Starting at the volume/share root prevents ancestor rename/reparse swaps.
    static void Parents(string path, bool create, List<SafeFileHandle> held) {
        string full = Path.GetFullPath(path), root = Path.GetPathRoot(full);
        string parent = Path.GetDirectoryName(full);
        if (String.IsNullOrEmpty(parent)) parent = root;
        string current = root;
        var parts = parent.Substring(root.Length).Split(new char[] {'\\'}, StringSplitOptions.RemoveEmptyEntries);
        // Read-only prefix walk: stop at the first missing pending ancestor.
        int n;
        for (n = -1; n < parts.Length; n++) {
            string candidate = n >= 0 ? Path.Combine(current, parts[n]) : current;
            uint attrs = GetFileAttributesW(candidate);
            if (attrs != 0xFFFFFFFFu && (attrs & 0x400u) != 0)
                throw new IOException("ancestor.reparse:" + candidate);
            var h = CreateFileW(candidate, 0, 1, IntPtr.Zero, 3, 0x02200000u, IntPtr.Zero);
            if (h.IsInvalid) {
                int error = Marshal.GetLastWin32Error(); h.Dispose();
                if (n >= 0 && error == 2) {
                    return;
                }
                throw new IOException("api.open-parent:" + candidate + ":win32=" + error);
            }
            held.Add(h);
            var t = Tag(h);
            if ((t.Attributes & 0x400) != 0) throw new IOException("ancestor.reparse:" + candidate);
            if ((t.Attributes & 0x10) == 0) throw new IOException("ancestor.not-directory:" + candidate);
            Identity(h);
            current = candidate;
        }
    }
    public static void Validate(string link, string target, bool directory) {
        var held = new List<SafeFileHandle>();
        try {
            Parents(link, false, held); Parents(target, false, held);
            using (var raw = Open(link, true, 0)) {
                var tag = Tag(raw);
                if (directory ? tag.Tag != 0xA0000003u : (tag.Attributes & 0x400) != 0)
                    throw new IOException("tag.expected=" + (directory ? "0xA0000003" : "non-reparse") +
                        ":actual=0x" + tag.Tag.ToString("X8"));
                using (var expected = Open(target, true, 0)) {
                    var et = Tag(expected);
                    if ((et.Attributes & 0x400) != 0) throw new IOException("target.reparse");
                    if (((et.Attributes & 0x10) != 0) != directory) throw new IOException("target.kind");
                    using (var final = Open(link, false, 0)) {
                        var x = Identity(final); var y = Identity(expected);
                        if (x.Volume != y.Volume || x.IndexHigh != y.IndexHigh || x.IndexLow != y.IndexLow)
                            throw new IOException("identity.volume-file-id.mismatch");
                    }
                }
            }
        } finally { foreach (var h in held) h.Dispose(); }
    }
    [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
    static extern uint GetFinalPathNameByHandleW(SafeFileHandle h, StringBuilder path, uint size, uint flags);
    static string FinalPath(SafeFileHandle h) {
        var path = new StringBuilder(32768);
        uint n = GetFinalPathNameByHandleW(h, path, (uint)path.Capacity, 0);
        if (n == 0 || n >= path.Capacity) throw Error("target.final-path");
        string p = path.ToString();
        if (!p.StartsWith(@"\\?\") || p.Length < 7 || p[5] != ':' || p[6] != '\\' ||
            !((p[4] >= 'A' && p[4] <= 'Z') || (p[4] >= 'a' && p[4] <= 'z')))
            throw new IOException("target.unsupported-final-namespace");
        return p.Substring(0, 4) + Char.ToUpperInvariant(p[4]) + p.Substring(5);
    }
    // Schema v2 consumer contract: target_resolved_hex is strict UTF-8 of the
    // normalized Win32 extended DOS final path (\\?\C:\...), no newline.
    // Only drive volumes are admitted; UNC/device namespaces fail closed.
    // Consumers must explicitly accept v2, decode as native Windows path, and
    // compare volume + high:low file ID, unsigned decimal byte size and SHA256.
    // Directory size is the handle's size, SHA is '-'; no POSIX stat semantics.
    public static string Metadata(string link, string target) {
        var held = new List<SafeFileHandle>();
        try {
            Parents(target, false, held); Parents(link, false, held);
            held.Add(Open(link, true, 0));
            // Read sharing only excludes existing/future writers and deletion,
            // including writes through hardlinks. The stream owns this handle.
            using (var h = Open(target, true, 0x80000000)) {
                var tag = Tag(h);
                if ((tag.Attributes & 0x400) != 0) throw new IOException("target.reparse");
                bool directory = (tag.Attributes & 0x10) != 0;
                var before = Identity(h);
                Charge(((ulong)before.SizeHigh << 32) | before.SizeLow);
                string path = FinalPath(h);
                Validate(link, target, directory);
                // Bind validation to this exact held target, not a later reopen.
                using (var actual = Open(link, false, 0)) {
                    var i = Identity(actual);
                    if (i.Volume != before.Volume || i.IndexHigh != before.IndexHigh || i.IndexLow != before.IndexLow)
                        throw new IOException("target.replacement");
                }
                string sha = "-";
                FileStream stream = null;
                try {
                    if (!directory) {
                        stream = new FileStream(h, FileAccess.Read);
                        using (var hash = System.Security.Cryptography.SHA256.Create())
                            sha = BitConverter.ToString(hash.ComputeHash(stream)).Replace("-", "").ToLowerInvariant();
                    }
                    var after = Identity(h);
                    if (before.Volume != after.Volume || before.IndexHigh != after.IndexHigh || before.IndexLow != after.IndexLow ||
                        before.SizeHigh != after.SizeHigh || before.SizeLow != after.SizeLow ||
                        before.WriteHigh != after.WriteHigh || before.WriteLow != after.WriteLow || path != FinalPath(h))
                        throw new IOException("target.changed-during-capture");
                    byte[] bytes = new UTF8Encoding(false, true).GetBytes(path);
                    return bytes.Length.ToString() + "|" + BitConverter.ToString(bytes).Replace("-", "").ToLowerInvariant() + "|" +
                        before.Volume.ToString() + "|" + before.IndexHigh.ToString() + ":" + before.IndexLow.ToString() + "|" +
                        (((ulong)before.SizeHigh << 32) | before.SizeLow).ToString() + "|" + sha;
                } finally { if (stream != null) stream.Dispose(); }
            }
        } finally { foreach (var h in held) h.Dispose(); }
    }
    static string Decode(string hex) {
        if (hex.Length == 0 || hex.Length > 262136 || hex.Length % 2 != 0 ||
            !System.Text.RegularExpressions.Regex.IsMatch(hex, "\\A[0-9a-f]+\\z")) throw new IOException("receipt.hex");
        byte[] bytes = new byte[hex.Length/2];
        for (int n=0;n<bytes.Length;n++) bytes[n]=Convert.ToByte(hex.Substring(n*2,2),16);
        return new UTF8Encoding(false,true).GetString(bytes);
    }
    static string Fingerprint(SafeFileHandle h) {
        var i = Identity(h); var t = Tag(h);
        return i.Volume + ":" + i.IndexHigh + ":" + i.IndexLow + ":" + t.Attributes + ":" + t.Tag;
    }
    public static void ParseMetadata(string path, string kind) {
        string text = new UTF8Encoding(false, true).GetString(File.ReadAllBytes(path));
        if (text.EndsWith("\r\n")) text = text.Substring(0, text.Length-2);
        else if (text.EndsWith("\n")) text = text.Substring(0, text.Length-1);
        ParseMetadataText(text, kind);
    }
    static void ParseMetadataText(string text, string kind) {
        string[] f = text.Split('|');
        if (f.Length != 6 || text.IndexOfAny(new char[] {'\r','\n'}) >= 0) throw new IOException("metadata.fields");
        ulong length = Number(f[0], 131068), volume = Number(f[2], UInt32.MaxValue);
        Number(f[4], UInt64.MaxValue);
        string[] id = f[3].Split(':');
        if (id.Length != 2) throw new IOException("metadata.id");
        Number(id[0], UInt32.MaxValue); Number(id[1], UInt32.MaxValue);
        if (length < 7 || (ulong)f[1].Length != length * 2 || !System.Text.RegularExpressions.Regex.IsMatch(f[1], "\\A[0-9a-fA-F]+\\z")) throw new IOException("metadata.hex");
        byte[] bytes = new byte[(int)length];
        for (int n=0; n<bytes.Length; n++) bytes[n] = Convert.ToByte(f[1].Substring(n*2,2),16);
        string resolved = new UTF8Encoding(false,true).GetString(bytes);
        if (!resolved.StartsWith(@"\\?\") || resolved.Length < 7 || resolved[5] != ':' || resolved[6] != '\\' ||
            !((resolved[4] >= 'A' && resolved[4] <= 'Z') || (resolved[4] >= 'a' && resolved[4] <= 'z')))
            throw new IOException("metadata.namespace");
        foreach (char c in resolved) if (Char.IsControl(c)) throw new IOException("metadata.control");
        if (kind == "directory" ? f[5] != "-" : kind != "file" || !System.Text.RegularExpressions.Regex.IsMatch(f[5], "\\A[0-9a-fA-F]{64}\\z")) throw new IOException("metadata.sha");
    }
    static ulong Number(string value, ulong max) {
        ulong n;
        if (!System.Text.RegularExpressions.Regex.IsMatch(value, "\\A(?:0|[1-9][0-9]*)\\z") || !UInt64.TryParse(value, out n) || n > max) throw new IOException("metadata.number");
        return n;
    }
    static string Relative(string hex, string length, bool target) {
        ulong size = Number(length, 131068);
        if (size == 0 || (ulong)hex.Length != size * 2) throw new IOException("receipt.byte-length");
        string value = Decode(hex);
        bool ordinary = false;
        foreach (string part in value.Split('/')) {
            if (target && part == ".." && !ordinary) continue;
            ordinary = true;
            if (part.Length == 0 || part == "." || part == ".." || part.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0 ||
                part.IndexOf('\\') >= 0 || part.EndsWith(".") || part.EndsWith(" ") ||
                System.Text.RegularExpressions.Regex.IsMatch(part, "\\A(?i:CON|PRN|AUX|NUL|COM[1-9¹²³]|LPT[1-9¹²³])(?:\\.|\\z)"))
                throw new IOException("receipt.relative-path");
            foreach (char c in part) if (Char.IsControl(c)) throw new IOException("receipt.relative-path");
        }
        if (!ordinary) throw new IOException("receipt.relative-path");
        return value;
    }

    static readonly UTF8Encoding Utf8 = new UTF8Encoding(false, true);
    static readonly System.Diagnostics.Stopwatch Clock = System.Diagnostics.Stopwatch.StartNew();
    // Callers may tighten budgets, never increase the admitted ceilings.
    static readonly int MaxEntries = (int)Budget("BOOTSTRAP_STAGE3_GIT_MAX_ENTRIES", 100000);
    const int MaxOutput = 16 * 1024 * 1024;
    static readonly ulong MaxBytes = Budget("BOOTSTRAP_STAGE3_GIT_MAX_BYTES", 512UL * 1024 * 1024);
    static readonly int MaxMillis = (int)Budget("BOOTSTRAP_STAGE3_GIT_MAX_MILLISECONDS", 28000);
    static ulong bytes;
    static int entries;
    static System.Diagnostics.Process ActiveChild;
    static ulong Budget(string name, ulong ceiling) {
        string value = Environment.GetEnvironmentVariable(name);
        ulong n = String.IsNullOrEmpty(value) ? ceiling : Number(value, ceiling);
        if (n == 0) throw new IOException("bound.zero"); return n;
    }
    static void Tick() { if (Clock.ElapsedMilliseconds >= MaxMillis) throw new IOException("bound.time"); }
    static void Charge(ulong n) { Tick(); if (n > MaxBytes - bytes) throw new IOException("bound.bytes"); bytes += n; }
    static string Hash(byte[] b) { using (var h = System.Security.Cryptography.SHA256.Create()) return Hex(h.ComputeHash(b)); }
    static string Hex(byte[] b) { return BitConverter.ToString(b).Replace("-", "").ToLowerInvariant(); }
    static string Text(byte[] b) { return Utf8.GetString(b); }
    static byte[] ReadHeld(string path, List<SafeFileHandle> held, int max) {
        Parents(path, false, held);
        var lockHandle = Open(path, true, 0); held.Add(lockHandle);
        if ((Tag(lockHandle).Attributes & 0x410) != 0) throw new IOException("input.kind");
        using (var stream = new FileStream(Open(path, true, 0x80000000), FileAccess.Read)) {
            if (stream.Length > max) throw new IOException("bound.input");
            Charge((ulong)stream.Length);
            using (var mem = new MemoryStream()) { stream.CopyTo(mem); return mem.ToArray(); }
        }
    }
    static string Quote(string s) {
        var b = new StringBuilder("\""); int slash = 0;
        foreach (char c in s) {
            if (c == '\\') { slash++; continue; }
            if (c == '"') { b.Append('\\', slash * 2 + 1); b.Append(c); slash = 0; continue; }
            b.Append('\\', slash); slash = 0; b.Append(c);
        }
        b.Append('\\', slash * 2); return b.Append('"').ToString();
    }
    static byte[] ReadBound(Stream stream) {
        using (var mem = new MemoryStream()) {
            byte[] buffer = new byte[65536]; int n;
            while ((n = stream.Read(buffer, 0, buffer.Length)) != 0) {
                if (mem.Length + n > MaxOutput) throw new IOException("bound.command-output");
                mem.Write(buffer, 0, n);
            }
            return mem.ToArray();
        }
    }
    static byte[] Command(string root, string tool, byte[] input, params string[] args) {
        Tick(); var start = new System.Diagnostics.ProcessStartInfo(tool);
        start.WorkingDirectory = root; start.UseShellExecute = false; start.CreateNoWindow = true;
        start.RedirectStandardOutput = true; start.RedirectStandardError = true; start.RedirectStandardInput = true;
        start.EnvironmentVariables["GIT_OPTIONAL_LOCKS"] = "0";
        start.EnvironmentVariables["LC_ALL"] = "C";
        start.EnvironmentVariables["GIT_CONFIG_NOSYSTEM"] = "1";
        var argv = new List<string>(); foreach (string arg in args) argv.Add(Quote(arg));
        start.Arguments = String.Join(" ", argv.ToArray());
        using (var process = System.Diagnostics.Process.Start(start)) {
            ActiveChild = process;
            try {
                var stdout = System.Threading.Tasks.Task.Factory.StartNew(() => ReadBound(process.StandardOutput.BaseStream));
                var stderr = System.Threading.Tasks.Task.Factory.StartNew(() => ReadBound(process.StandardError.BaseStream));
                var stdin = System.Threading.Tasks.Task.Factory.StartNew(() => { if (input != null) process.StandardInput.BaseStream.Write(input, 0, input.Length); process.StandardInput.Close(); });
                while (!process.WaitForExit(20)) { Tick(); if (stdout.IsFaulted || stderr.IsFaulted || stdin.IsFaulted) throw new IOException("command.io"); }
                if (!System.Threading.Tasks.Task.WaitAll(new System.Threading.Tasks.Task[] {stdout, stderr, stdin}, Math.Max(1, MaxMillis - (int)Clock.ElapsedMilliseconds))) throw new IOException("bound.command");
                if (process.ExitCode != 0) throw new IOException("command.failed:" + process.ExitCode);
                return stdout.Result;
            } finally { if (!process.HasExited) process.Kill(); ActiveChild = null; }
        }
    }
    static byte[] Git(string root, params string[] args) {
        var all = new List<string>(new string[] {"-c", "core.quotePath=false", "-c", "core.fsmonitor=false", "-c", "core.untrackedCache=false"});
        all.AddRange(args); return Command(root, Environment.GetEnvironmentVariable("STAGE3_GIT"), null, all.ToArray());
    }
    static string[] Nul(byte[] b) {
        string s = Text(b); if (s.Length == 0) return new string[0];
        if (!s.EndsWith("\0")) throw new IOException("git.nul-format");
        return s.Substring(0, s.Length - 1).Split('\0');
    }
    static void CheckPath(string path) {
        byte[] b = Utf8.GetBytes(path); Relative(Hex(b), b.Length.ToString(), false);
        // The retained Stage3 line protocol cannot encode these names safely.
        if (path.IndexOfAny(new char[] {'\n','\r','\t','\\',':','*','?','[',']'}) >= 0) throw new IOException("path.unsupported");
    }
    static Dictionary<string,string> HeadLinks(string root, string head) {
        var links = new Dictionary<string,string>(StringComparer.Ordinal);
        var cases = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var components = new Dictionary<string,string>(StringComparer.OrdinalIgnoreCase);
        foreach (string row in Nul(Git(root, "ls-tree", "-rz", "--full-tree", head))) {
            if (++entries > MaxEntries) throw new IOException("bound.entries");
            int tab = row.IndexOf('\t'); if (tab < 0) throw new IOException("git.tree-format");
            string path = row.Substring(tab + 1); CheckPath(path);
            if (!cases.Add(path)) throw new IOException("path.case-collision");
            string prefix = "";
            foreach (string part in path.Split('/')) {
                prefix = prefix.Length == 0 ? part : prefix + "/" + part;
                string previous;
                if (components.TryGetValue(prefix, out previous) && previous != prefix) throw new IOException("path.component-case-collision");
                components[prefix] = prefix;
            }
            string[] f = row.Substring(0, tab).Split(' ');
            if (f.Length != 3 || f[1] != "blob" || (f[0] != "100644" && f[0] != "100755" && f[0] != "120000")) throw new IOException("git.tree-kind");
            if (f[0] == "120000") {
                byte[] blob = Git(root, "cat-file", "blob", f[2]);
                links.Add(path, Relative(Hex(blob), blob.Length.ToString(), true));
                if (links.Count > 4096) throw new IOException("bound.aliases");
            }
        }
        return links;
    }
    static void AuditTree(string root, Dictionary<string,string> aliases, List<SafeFileHandle> held) {
        var todo = new Stack<string>(); todo.Push(root);
        Parents(Path.Combine(root, "leaf"), false, held);
        var cases = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        while (todo.Count != 0) {
            Tick(); string dir = todo.Pop();
            // Enumerate one ordinary directory at a time, never recurse through
            // an alias, even if Git would eventually classify it as ignored.
            foreach (string item in Directory.EnumerateFileSystemEntries(dir)) {
                if (++entries > MaxEntries) throw new IOException("bound.entries");
                string relative = item.Substring(root.Length + 1).Replace('\\','/');
                if (relative == ".git") continue;
                CheckPath(relative);
                if (!cases.Add(relative)) throw new IOException("path.case-collision");
                if (Path.GetFileName(item).Equals(".git", StringComparison.OrdinalIgnoreCase)) throw new IOException("path.nested-repository");
                var raw = Open(item, true, 0); held.Add(raw);
                {
                    var tag = Tag(raw);
                    if (aliases.ContainsKey(relative) && aliases[relative] == "directory") continue;
                    if ((tag.Attributes & 0x400) != 0) throw new IOException("path.unreceipted-reparse");
                    if ((tag.Attributes & 0x40) != 0) throw new IOException("path.special");
                    if ((tag.Attributes & 0x10) != 0) todo.Push(item);
                }
            }
        }
    }
    static void CheckPending(Dictionary<string,string> links, List<string> targets, string[] policy, List<SafeFileHandle> held) {
        foreach (var pair in links) {
            string relative = pair.Key.Substring(Environment.GetEnvironmentVariable("STAGE3_ROOT").TrimEnd('\\').Length + 1).Replace('\\','/');
            if (Array.IndexOf(policy, relative + "\t" + pair.Value) < 0 || Text(ReadHeld(pair.Key, held, 131068)) != pair.Value) throw new IOException("pending.bytes-policy");
        }
        foreach (string target in targets) {
            Parents(target, false, held);
            uint attr = GetFileAttributesW(target); int error = Marshal.GetLastWin32Error();
            if (attr != 0xFFFFFFFFu || (error != 2 && error != 3)) throw new IOException("pending.not-absent-at-use");
        }
    }
    static string Inventory(string root, string head, Dictionary<string,string> aliases) {
        byte[] diff = Git(root, "diff", "--binary", "--full-index", "--no-ext-diff", "--no-textconv", "HEAD", "--");
        var args = new List<string>(new string[] {"ls-files", "--others", "--exclude-standard", "-z", "--", "."});
        var collapsed = new List<string>();
        foreach (var pair in aliases) if (pair.Value == "directory") collapsed.Add(pair.Key);
        collapsed.Sort((a,b) => CompareBytes(Utf8.GetBytes(a), Utf8.GetBytes(b)));
        var collapse = new StringBuilder();
        foreach (string path in collapsed) {
            args.Add(":(top,literal,exclude)" + path);
            collapse.Append("alias-collapse-directory:").Append(Utf8.GetByteCount(path)).Append(':').Append(Hex(Utf8.GetBytes(path))).Append('\n');
        }
        string[] paths = Nul(Git(root, args.ToArray()));
        if (paths.Length > MaxEntries) throw new IOException("bound.untracked");
        Array.Sort(paths, (a,b) => CompareBytes(Utf8.GetBytes(a), Utf8.GetBytes(b)));
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (string path in paths) {
            CheckPath(path); if (!seen.Add(path)) throw new IOException("untracked.duplicate-case");
            foreach (string alias in collapsed) if (path.Equals(alias, StringComparison.OrdinalIgnoreCase) || path.StartsWith(alias + "/", StringComparison.OrdinalIgnoreCase)) throw new IOException("git.alias-traversal");
        }
        byte[] flags = Command(root, Environment.GetEnvironmentVariable("STAGE3_SH"), Utf8.GetBytes(paths.Length == 0 ? "" : String.Join("\0", paths) + "\0"), "-c", "while IFS= read -r -d '' p; do if test -x \"$p\"; then printf 1; else printf 0; fi; done");
        if (flags.Length != paths.Length) throw new IOException("untracked.mode-count");
        var records = new StringBuilder("tracked-diff-sha256=" + Hash(diff) + "\n");
        var held = new List<SafeFileHandle>();
        try {
            for (int n=0; n<paths.Length; n++) {
                string path = paths[n];
                byte[] content = ReadHeld(Path.Combine(root, path.Replace('/','\\')), held, (int)MaxBytes);
                if (flags[n] != '0' && flags[n] != '1') throw new IOException("untracked.mode");
                records.Append("untracked-file:").Append(Utf8.GetByteCount(path)).Append(':').Append(path).Append(':').Append((char)flags[n]).Append(':').Append(Hash(content)).Append('\n');
            }
            // Collapse metadata is separately bound; the tracked diff remains
            // byte-for-byte Git's ordinary HEAD diff, including dirty aliases.
            return "head=" + head + "\ndirty_fingerprint=" + Hash(Utf8.GetBytes(records.ToString())) +
                "\nalias_collapse_count=" + collapsed.Count + "\nalias_collapse_sha256=" + Hash(Utf8.GetBytes(collapse.ToString())) + "\n" + collapse;
        } finally { foreach (var h in held) h.Dispose(); }
    }
    static int CompareBytes(byte[] a, byte[] b) { for (int n=0;n<Math.Min(a.Length,b.Length);n++) if (a[n] != b[n]) return a[n].CompareTo(b[n]); return a.Length.CompareTo(b.Length); }
    public static void Run() {
        var held = new List<SafeFileHandle>(); FileStream policyStream = null;
        // The watchdog also interrupts a stalled filesystem read. The outer
        // shell owns cleanup; it never publishes the private result on failure.
        var watchdog = new System.Threading.Timer(delegate {
            try { var child = ActiveChild; if (child != null && !child.HasExited) child.Kill(); } catch { }
            Environment.Exit(124);
        }, null, MaxMillis, System.Threading.Timeout.Infinite);
        try {
            string root = Environment.GetEnvironmentVariable("STAGE3_ROOT").TrimEnd('\\');
            string source = Environment.GetEnvironmentVariable("STAGE3_RECEIPT");
            string head = Text(Git(root, "rev-parse", "--verify", "HEAD")).TrimEnd('\n');
            string top = Text(Git(root, "rev-parse", "--show-toplevel")).TrimEnd('\n').Replace('/','\\');
            string posixRoot = Text(Convert.FromBase64String(Environment.GetEnvironmentVariable("STAGE3_ROOT_B64"))).Replace('/','\\');
            if (!top.Equals(root, StringComparison.OrdinalIgnoreCase) && !top.Equals(posixRoot, StringComparison.Ordinal)) throw new IOException("root.git-mismatch");
            string producerHash = Hash(ReadHeld(Path.Combine(root, "scripts", "setup", "materialize-symlinks-windows.shs"), held, 1024 * 1024));
            var headLinks = HeadLinks(root, head);
            var pending = new List<string>();
            byte[] receiptBytes = ReadHeld(source, held, 8 * 1024 * 1024);
            string receiptText = new UTF8Encoding(false,true).GetString(receiptBytes);
            if (!receiptText.EndsWith("\n") || receiptText.IndexOf('\r') >= 0) throw new IOException("receipt.line-format");
            var all = receiptText.Substring(0,receiptText.Length-1).Split('\n');
            var headers = new Dictionary<string,string>();
            var rows = new List<string>();
            bool inRecords = false;
            int beginCount = 0, endCount = 0;
            foreach (string line in all) {
                if (endCount != 0) throw new IOException("receipt.trailing-data");
                if (line == "records_begin") { if (inRecords || ++beginCount != 1) throw new IOException("receipt.records-markers"); inRecords = true; continue; }
                if (line == "records_end") { if (!inRecords || ++endCount != 1) throw new IOException("receipt.records-markers"); inRecords = false; continue; }
                if (inRecords) { rows.Add(line); continue; }
                int split = line.IndexOf('=');
                if (split <= 0) throw new IOException("receipt.header-format");
                string key = line.Substring(0, split);
                if (headers.ContainsKey(key)) throw new IOException("receipt.header-duplicate");
                headers.Add(key, line.Substring(split + 1));
            }
            if (!inRecords && beginCount == 1 && endCount == 1) { }
            else throw new IOException("receipt.records-markers");
            string[] required = new string[] {"schema","root","head","producer_sha256","policy_sha256","tracked_mode120000","created","already_ok","skipped_pending","failed","pending_untracked","record_count","records_sha256","pending_count","pending_requires_consumer_revalidation","result"};
            if (headers.Count != required.Length) throw new IOException("receipt.header-set");
            foreach (string key in required) if (!headers.ContainsKey(key)) throw new IOException("receipt.header-missing");
            foreach (string key in new string[] {"producer_sha256","policy_sha256","records_sha256"})
                if (!System.Text.RegularExpressions.Regex.IsMatch(headers[key], "\\A[0-9a-f]{64}\\z")) throw new IOException("receipt.header-digest");
            if (!System.Text.RegularExpressions.Regex.IsMatch(headers["head"], "\\A(?:[0-9a-f]{40}|[0-9a-f]{64})\\z")) throw new IOException("receipt.header-head");
            string expectedRoot = Encoding.UTF8.GetString(Convert.FromBase64String(Environment.GetEnvironmentVariable("STAGE3_ROOT_B64")));
            if (headers["schema"] != "simple-windows-materialized-links-v2" || headers["root"] != expectedRoot ||
                headers["head"] != head ||
                headers["producer_sha256"] != producerHash ||
                headers["policy_sha256"] != Hash(ReadHeld(Path.Combine(root, "scripts", "setup", "windows-materialized-pending-policy.tsv"), held, 1024 * 1024)))
                throw new IOException("receipt.header-mismatch");
            string policyFile = Path.Combine(root, "scripts", "setup", "windows-materialized-pending-policy.tsv");
            Parents(policyFile, false, held);
            var policyHandle = Open(policyFile, true, 0x80000000); held.Add(policyHandle);
            if ((Tag(policyHandle).Attributes & 0x410) != 0) throw new IOException("receipt.policy-kind");
            string policyIdentity = Fingerprint(policyHandle);
            policyStream = new FileStream(policyHandle, FileAccess.Read);
            byte[] policyBytes;
            using (var snapshot = new MemoryStream()) { if (policyStream.Length > 1024 * 1024) throw new IOException("bound.policy"); policyStream.CopyTo(snapshot); policyBytes = snapshot.ToArray(); }
            string[] policyRows = new UTF8Encoding(false,true).GetString(policyBytes).Split('\n');
            string policyDigest;
            using (var hash = System.Security.Cryptography.SHA256.Create())
                policyDigest = BitConverter.ToString(hash.ComputeHash(policyBytes)).Replace("-", "").ToLowerInvariant();
            if (policyDigest != headers["policy_sha256"]) throw new IOException("receipt.policy-digest-mismatch");
            var recordText = new StringBuilder();
            foreach (string row in rows) recordText.Append(row).Append('\n');
            string digest = BitConverter.ToString(System.Security.Cryptography.SHA256.Create().ComputeHash(Encoding.UTF8.GetBytes(recordText.ToString()))).Replace("-", "").ToLowerInvariant();
            if (headers["records_sha256"] != digest) throw new IOException("receipt.records-digest-mismatch");
            var counts = new Dictionary<string,ulong>();
            foreach (string key in new string[] {"tracked_mode120000","created","already_ok","skipped_pending","failed","pending_untracked","record_count","pending_count"}) counts.Add(key, Number(headers[key], Int32.MaxValue));
            if (headers["result"] != "complete" || headers["failed"] != "0" || headers["pending_requires_consumer_revalidation"] != "1" ||
                counts["record_count"] != (ulong)rows.Count || counts["tracked_mode120000"] != counts["record_count"] ||
                counts["created"] + counts["already_ok"] + counts["pending_untracked"] != counts["record_count"] ||
                counts["skipped_pending"] != 0 || counts["pending_untracked"] != counts["pending_count"])
                throw new IOException("receipt.count-mismatch");
            ulong createdRows = 0, existingRows = 0;
            var paths = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            string[] keys = "path_len|path_hex|target_len|target_hex|target_resolved_len|target_resolved_hex|target_volume|target_file_id|target_size|target_sha256|kind|state".Split('|');
            if (rows.Count > 4096) throw new IOException("bound.aliases");
            var aliases = new Dictionary<string,string>(StringComparer.OrdinalIgnoreCase);
            var targets = new List<string>();
            var pendingLinks = new Dictionary<string,string>();
            foreach (string row in rows) {
                Tick();
                var fields = new Dictionary<string,string>();
                string[] cells = row.Split('|');
                if (cells.Length != keys.Length) throw new IOException("receipt.row-fields");
                for (int n=0;n<keys.Length;n++) {
                    if (!cells[n].StartsWith(keys[n] + "=", StringComparison.Ordinal)) throw new IOException("receipt.row-order");
                    fields.Add(keys[n],cells[n].Substring(keys[n].Length+1));
                }
                string path = Relative(fields["path_hex"], fields["path_len"], false);
                if (!paths.Add(path)) throw new IOException("receipt.duplicate-path");
                CheckPath(path);
                if (!headLinks.ContainsKey(path)) throw new IOException("receipt.unexpected-row");
                string link = Path.Combine(root, path.Replace('/', '\\'));
                string relative = Relative(fields["target_hex"], fields["target_len"], true);
                if (headLinks[path] != relative) throw new IOException("receipt.head-blob");
                Parents(link, false, held);
                held.Add(Open(link, true, 0));
                string target = Path.GetFullPath(Path.Combine(Path.GetDirectoryName(link), relative.Replace('/', '\\')));
                if (!target.StartsWith(root.TrimEnd('\\') + "\\", StringComparison.OrdinalIgnoreCase) || String.Equals(target,link,StringComparison.OrdinalIgnoreCase)) throw new IOException("receipt.target-escape");
                Parents(target, false, held);
                targets.Add(target);
                // Alias ownership is case-insensitive on Windows.  Keep the
                // rejection typed here instead of allowing Dictionary.Add to
                // surface an implementation exception for duplicate or
                // case-colliding rows.
                if (aliases.ContainsKey(path)) throw new IOException("alias.duplicate-or-case-collision");
                aliases.Add(path, fields["kind"]);
                if (fields["state"] == "pending-untracked") {
                    if (fields["kind"] != "unknown" || fields["target_resolved_len"] != "0") throw new IOException("receipt.pending-metadata");
                    foreach (string key in new string[] {"target_resolved_hex","target_volume","target_file_id","target_size","target_sha256"})
                        if (fields[key] != "-") throw new IOException("receipt.pending-metadata");
                    string policy = Decode(fields["path_hex"]) + "\t" + relative;
                    if (Array.IndexOf(policyRows, policy) < 0) throw new IOException("pending.policy");
                    uint pendingAttributes = GetFileAttributesW(target);
                    int pendingError = Marshal.GetLastWin32Error();
                    if (pendingAttributes != 0xFFFFFFFFu || (pendingError != 2 && pendingError != 3)) throw new IOException("pending.not-absent");
                    pending.Add(target);
                    pendingLinks.Add(link, relative);
                    if (new UTF8Encoding(false,true).GetString(ReadHeld(link, held, 131068)) != relative) throw new IOException("pending.placeholder");
                } else {
                    if (fields["kind"] != "file" && fields["kind"] != "directory") throw new IOException("receipt.kind");
                    if (fields["state"] == "created") createdRows++;
                    else if (fields["state"] == "already") existingRows++;
                    else throw new IOException("receipt.state");
                    var h = Open(target, true, 0x80000000); held.Add(h);
                    Validate(link, target, fields["kind"] == "directory");
                    string actual = Metadata(link, target);
                    string expected = fields["target_resolved_len"] + "|" + fields["target_resolved_hex"] + "|" + fields["target_volume"] + "|" + fields["target_file_id"] + "|" + fields["target_size"] + "|" + fields["target_sha256"];
                    ParseMetadataText(expected, fields["kind"]);
                    if (actual != expected) throw new IOException("publication.metadata-changed");
                }
            }
            if ((ulong)pending.Count != counts["pending_count"] || createdRows != counts["created"] || existingRows != counts["already_ok"]) throw new IOException("receipt.pending-count-mismatch");

            if (headLinks.Count != rows.Count) throw new IOException("receipt.missing-row");
            foreach (string a in aliases.Keys) {
                string full = Path.Combine(root, a.Replace('/', '\\'));
                foreach (string other in aliases.Keys)
                    if (other.StartsWith(a + "/", StringComparison.OrdinalIgnoreCase)) throw new IOException("alias.overlap");
                foreach (string target in targets)
                    if (target.Equals(full, StringComparison.OrdinalIgnoreCase) || target.StartsWith(full + "\\", StringComparison.OrdinalIgnoreCase)) throw new IOException("alias.target-overlap");
            }
            // Canonical targets may be shared or nested (for example, two
            // aliases can hardlink the same file, or one can target a
            // directory while another targets a child).  Ownership remains
            // unambiguous because aliases themselves are unique and no target
            // may equal or descend from an alias path; do not reject equal or
            // nested canonical target paths here.
            AuditTree(root, aliases, held);
            // Held policy/placeholder bytes are authoritative until Git returns.
            // Absence itself cannot be locked: check at use and again at finish.
            CheckPending(pendingLinks, pending, policyRows, held);
            string result = Inventory(root, head, aliases);
            CheckPending(pendingLinks, pending, policyRows, held);
            if (Text(Git(root, "rev-parse", "--verify", "HEAD")).TrimEnd('\n') != head) throw new IOException("head.changed");
            if (Fingerprint(policyHandle) != policyIdentity) throw new IOException("policy.changed");
            Tick();
            File.WriteAllText(Environment.GetEnvironmentVariable("STAGE3_RESULT"), result, new UTF8Encoding(false));
            File.Move(Environment.GetEnvironmentVariable("STAGE3_RESULT"), Environment.GetEnvironmentVariable("STAGE3_OUTPUT"));

        } finally { watchdog.Dispose(); if (policyStream != null) policyStream.Dispose(); foreach (var h in held) h.Dispose(); }
    }
}
'@
[Stage3MaterializedConsumer]::Run()
exit 0
} catch {
    [Console]::Error.WriteLine("stage3-materialized-consumer: " + $_.Exception.Message)
    exit 1
}
STAGE3_NATIVE
}

# Three-argument v2 entry; its caller supplies the wrapper environment default.
# Private temporary directory, no stdout and no destination change on refusal.
bootstrap_stage3_materialized_git_state() (
    [ "$#" -eq 3 ] || exit 1
    case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) ;; *) exit 1 ;; esac
    root=$(CDPATH= cd -- "$1" && pwd -P) || exit 1
    output=$2 receipt=$3
    work=$(mktemp -d "${TMPDIR:-/tmp}/stage3-consumer.XXXXXX") || exit 1
    trap 'rm -f -- "$work/api.ps1" "$work/result"; rmdir -- "$work"' EXIT
    trap 'exit 1' HUP INT TERM
    bootstrap_stage3_materialized_native_source >"$work/api.ps1" || exit 1
    STAGE3_ROOT=$(cygpath -aw "$root") || exit 1
    STAGE3_ROOT_B64=$(printf %s "$root" | base64 -w0) || exit 1
    STAGE3_RECEIPT=$(cygpath -aw "$receipt") || exit 1
    STAGE3_RESULT=$(cygpath -aw "$work/result") || exit 1
    STAGE3_OUTPUT=$(cygpath -aw "$output") || exit 1
    STAGE3_GIT=$(cygpath -aw "$(command -v git)") || exit 1
    STAGE3_SH=$(cygpath -aw /usr/bin/sh.exe) || exit 1
    export STAGE3_ROOT STAGE3_ROOT_B64 STAGE3_RECEIPT STAGE3_RESULT STAGE3_OUTPUT STAGE3_GIT STAGE3_SH
    /usr/bin/timeout -k 2s 30s powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$(cygpath -aw "$work/api.ps1")" >/dev/null || exit 1
)

bootstrap_stage3_git_state() {
    [ "$#" -ge 2 ] && [ "$#" -le 3 ] || return 1
    # All bootstrap/recovery callers inherit the wrapper receipt. An explicit
    # third argument must not silently disable an exported receipt.
    bootstrap_stage3_git_receipt=${3:-${SIMPLE_WINDOWS_MATERIALIZED_LINKS_RECEIPT:-}}
    if [ -n "$bootstrap_stage3_git_receipt" ]; then
        bootstrap_stage3_materialized_git_state "$1" "$2" "$bootstrap_stage3_git_receipt"
        return $?
    fi
    bootstrap_stage3_git_root=$1
    bootstrap_stage3_git_output=$2
    bootstrap_stage3_git_diff="${bootstrap_stage3_git_output}.diff.$$"
    bootstrap_stage3_git_untracked="${bootstrap_stage3_git_output}.untracked.$$"
    bootstrap_stage3_git_untracked_sorted="${bootstrap_stage3_git_output}.untracked.sorted.$$"
    bootstrap_stage3_git_records="${bootstrap_stage3_git_output}.records.$$"
    bootstrap_stage3_git_template="${bootstrap_stage3_git_output}.template.$$"
    bootstrap_stage3_git_files_only="${bootstrap_stage3_git_output}.files-only.$$"
    bootstrap_stage3_git_file_shas="${bootstrap_stage3_git_output}.file-shas.$$"
    bootstrap_stage3_jj_stderr="${bootstrap_stage3_git_output}.jj-stderr.$$"
    if ! (
        cd "$bootstrap_stage3_git_root" &&
            git rev-parse --verify HEAD >/dev/null 2>&1
    ); then
        command -v jj >/dev/null 2>&1 || return 1
        (
            cd "$bootstrap_stage3_git_root" || exit 1
            bootstrap_stage3_git_head=$(
                jj --no-pager --color=never log -r @ --no-graph \
                    -T 'commit_id ++ "\n"' 2>"$bootstrap_stage3_jj_stderr"
            ) || exit 1
            [ ! -s "$bootstrap_stage3_jj_stderr" ] || exit 1
            jj --ignore-working-copy --no-pager --color=never diff \
                --git -r "$bootstrap_stage3_git_head" \
                >"$bootstrap_stage3_git_diff" \
                2>"$bootstrap_stage3_jj_stderr" || exit 1
            [ ! -s "$bootstrap_stage3_jj_stderr" ] || exit 1
            printf 'jj-working-copy-diff-sha256=%s\n' \
                "$(bootstrap_stage3_hash_file "$bootstrap_stage3_git_diff")" \
                >"$bootstrap_stage3_git_records" || exit 1
            bootstrap_stage3_git_dirty=$(
                bootstrap_stage3_hash_file "$bootstrap_stage3_git_records"
            ) || exit 1
            printf 'head=%s\n' "$bootstrap_stage3_git_head"
            printf 'dirty_fingerprint=%s\n' "$bootstrap_stage3_git_dirty"
        ) >"${bootstrap_stage3_git_output}.tmp.$$" || {
            rm -f "${bootstrap_stage3_git_output}.tmp.$$" \
                "$bootstrap_stage3_git_diff" "$bootstrap_stage3_git_records" \
                "$bootstrap_stage3_jj_stderr"
            return 1
        }
        rm -f "$bootstrap_stage3_git_diff" "$bootstrap_stage3_git_records" \
            "$bootstrap_stage3_jj_stderr"
        mv "${bootstrap_stage3_git_output}.tmp.$$" \
            "$bootstrap_stage3_git_output"
        return
    fi
    (
        cd "$bootstrap_stage3_git_root" || exit 1
        bootstrap_stage3_git_head=$(git rev-parse --verify HEAD) || exit 1
        git diff --binary --full-index --no-ext-diff --no-textconv HEAD -- \
            >"$bootstrap_stage3_git_diff" || exit 1
        # Keep non-ASCII path bytes literal. Git's default core.quotePath=true
        # emits a C-quoted display name, which is not an addressable pathname
        # and makes the authority snapshot fail for otherwise valid Unicode
        # files. Newline/NUL-bearing paths remain outside this line protocol
        # and therefore continue to fail closed below.
        git -c core.quotePath=false ls-files --others --exclude-standard \
            >"$bootstrap_stage3_git_untracked" || exit 1
        LC_ALL=C sort -u "$bootstrap_stage3_git_untracked" \
            >"$bootstrap_stage3_git_untracked_sorted" || exit 1
        : >"$bootstrap_stage3_git_records" || exit 1
        printf 'tracked-diff-sha256=%s\n' \
            "$(bootstrap_stage3_hash_file "$bootstrap_stage3_git_diff")" \
            >>"$bootstrap_stage3_git_records" || exit 1
        # First pass: classify each untracked path in sorted order without
        # spawning a hash-tool process per regular file. Symlinks keep the
        # original per-item treatment (readlink + hash_stream on a short
        # in-memory string; symlinks are a small minority of this
        # population, and no batched multi-target primitive exists), so a
        # symlink record is written to the template immediately, in place.
        # A regular file instead gets a "pending" placeholder carrying every
        # field except its content hash, plus its path appended to a
        # files-only list; the second pass below hashes ALL of those paths
        # in one (or a handful of) batched invocations instead of one
        # sha256sum+awk spawn pair per file, which is the change that
        # collapses the dominant cost of this loop. `else -> exit 1` (fail
        # closed on anything that is neither a symlink nor a regular file)
        # is unchanged.
        : >"$bootstrap_stage3_git_template" || exit 1
        : >"$bootstrap_stage3_git_files_only" || exit 1
        exec 8>>"$bootstrap_stage3_git_template" \
            9>>"$bootstrap_stage3_git_files_only" || exit 1
        while IFS= read -r bootstrap_stage3_git_path; do
            [ -n "$bootstrap_stage3_git_path" ] || continue
            if [ -L "$bootstrap_stage3_git_path" ]; then
                bootstrap_stage3_git_target=$(
                    readlink "$bootstrap_stage3_git_path"
                ) || exit 1
                bootstrap_stage3_git_target_sha=$(
                    printf '%s' "$bootstrap_stage3_git_target" |
                        bootstrap_stage3_hash_stream
                ) || exit 1
                printf 'untracked-link:%s:%s:%s:%s\n' \
                    "${#bootstrap_stage3_git_path}" "$bootstrap_stage3_git_path" \
                    "${#bootstrap_stage3_git_target}" \
                    "$bootstrap_stage3_git_target_sha" >&8 || exit 1
            elif [ -f "$bootstrap_stage3_git_path" ]; then
                bootstrap_stage3_git_executable=0
                [ ! -x "$bootstrap_stage3_git_path" ] ||
                    bootstrap_stage3_git_executable=1
                printf 'untracked-file-pending:%s:%s:%s:\n' \
                    "${#bootstrap_stage3_git_path}" "$bootstrap_stage3_git_path" \
                    "$bootstrap_stage3_git_executable" >&8 || exit 1
                printf '%s\n' "$bootstrap_stage3_git_path" >&9 || exit 1
            else
                exit 1
            fi
        done <"$bootstrap_stage3_git_untracked_sorted"
        exec 8>&- 9>&- || exit 1
        # Second pass: hash every regular file's contents in one batched
        # pass via bootstrap_stage3_hash_path_list (which itself resolves
        # the hash tool once and, when xargs -0 is available, invokes
        # sha256sum/shasum across the whole list in large multi-file
        # batches instead of once per file). Only the first
        # whitespace-delimited field of each output line is kept — exactly
        # what bootstrap_stage3_hash_file already extracts per file via
        # `awk '{print $1}'` — so a path that trips sha256sum's
        # backslash-escaping convention is handled identically to the
        # un-batched code path; the escaped filename text itself is never
        # parsed back out, since the path is already known from
        # bootstrap_stage3_git_files_only. Order is preserved: xargs without
        # -P issues its batches strictly in argument order and strictly
        # sequentially, and each underlying sha256sum/shasum invocation
        # emits one output line per input file in the order given, so output
        # line N corresponds to input line N.
        if [ -s "$bootstrap_stage3_git_files_only" ]; then
            bootstrap_stage3_hash_path_list "$bootstrap_stage3_git_files_only" \
                >"${bootstrap_stage3_git_file_shas}.raw" || exit 1
            awk '{print $1}' "${bootstrap_stage3_git_file_shas}.raw" \
                >"$bootstrap_stage3_git_file_shas" || exit 1
            rm -f "${bootstrap_stage3_git_file_shas}.raw"
            bootstrap_stage3_git_sha_count=$(
                wc -l <"$bootstrap_stage3_git_file_shas"
            ) || exit 1
            bootstrap_stage3_git_path_count=$(
                wc -l <"$bootstrap_stage3_git_files_only"
            ) || exit 1
            [ "$bootstrap_stage3_git_sha_count" -eq \
                "$bootstrap_stage3_git_path_count" ] || exit 1
        else
            : >"$bootstrap_stage3_git_file_shas" || exit 1
        fi
        # Third pass: replay the template in the exact sorted order from
        # the first pass, substituting each pending file record's batched
        # sha256 in turn. Line N of the sha list corresponds to the Nth
        # "untracked-file-pending:" template line, by construction above.
        # NOTE: this deliberately compares FILENAME rather than using the
        # common `FNR == NR` "am I still in the first file" idiom. That
        # idiom silently breaks when the first file (the sha list) has ZERO
        # lines -- e.g. an untracked tree with no regular files, only
        # symlinks -- because NR then advances in lock-step with the second
        # file's FNR from its very first line, so `FNR == NR` reads true for
        # every line of the template and the whole merge is swallowed with
        # no error. Reproduced directly against this host's awk before this
        # fix landed.
        awk -v bootstrap_stage3_awk_shafile="$bootstrap_stage3_git_file_shas" '
            FILENAME == bootstrap_stage3_awk_shafile {
                bootstrap_stage3_awk_sha[FNR] = $0
                next
            }
            sub(/^untracked-file-pending:/, "untracked-file:") {
                bootstrap_stage3_awk_n++
                print $0 bootstrap_stage3_awk_sha[bootstrap_stage3_awk_n]
                next
            }
            { print }
        ' "$bootstrap_stage3_git_file_shas" "$bootstrap_stage3_git_template" \
            >>"$bootstrap_stage3_git_records" || exit 1
        bootstrap_stage3_git_dirty=$(
            bootstrap_stage3_hash_file "$bootstrap_stage3_git_records"
        ) || exit 1
        printf 'head=%s\n' "$bootstrap_stage3_git_head"
        printf 'dirty_fingerprint=%s\n' "$bootstrap_stage3_git_dirty"
    ) >"${bootstrap_stage3_git_output}.tmp.$$" || {
        rm -f "${bootstrap_stage3_git_output}.tmp.$$" \
            "$bootstrap_stage3_git_diff" "$bootstrap_stage3_git_untracked" \
            "$bootstrap_stage3_git_untracked_sorted" \
            "$bootstrap_stage3_git_records" \
            "$bootstrap_stage3_git_template" "$bootstrap_stage3_git_files_only" \
            "$bootstrap_stage3_git_file_shas" "${bootstrap_stage3_git_file_shas}.raw"
        return 1
    }
    rm -f "$bootstrap_stage3_git_diff" "$bootstrap_stage3_git_untracked" \
        "$bootstrap_stage3_git_untracked_sorted" \
        "$bootstrap_stage3_git_records" \
        "$bootstrap_stage3_git_template" "$bootstrap_stage3_git_files_only" \
        "$bootstrap_stage3_git_file_shas" "${bootstrap_stage3_git_file_shas}.raw"
    mv "${bootstrap_stage3_git_output}.tmp.$$" "$bootstrap_stage3_git_output"
}

# Retain only bounded, category-level observations for successful fingerprints.
# The aggregate fingerprint remains the exact hash of `records`; this sidecar
# deliberately does not alter that compatibility-sensitive byte stream.  It is
# enough to explain a later aggregate mismatch without retaining source text,
# command output, or credentials.
bootstrap_stage3_write_seed_fingerprint_details() (
    [ "$#" -eq 3 ] || return 64
    bootstrap_stage3_detail_path=$1
    bootstrap_stage3_detail_records=$2
    bootstrap_stage3_detail_tmp_root=$3
    [ -f "$bootstrap_stage3_detail_records" ] || return 1
    case "$bootstrap_stage3_detail_path" in
        ''|*[!A-Za-z0-9_./:-]*) return 1 ;;
    esac
    case "$bootstrap_stage3_detail_path" in /*) ;; *) return 1 ;; esac
    bootstrap_stage3_detail_parent=$(dirname -- "$bootstrap_stage3_detail_path") || return 1
    mkdir -p "$bootstrap_stage3_detail_parent" || return 1
    bootstrap_stage3_detail_out="${bootstrap_stage3_detail_path}.tmp.$$"
    [ ! -e "$bootstrap_stage3_detail_out" ] || return 1
    bootstrap_stage3_detail_categories='compiler_sources cargo_path_dependencies runtime_sources policy toolchain native_tools recipes unclassified'
    bootstrap_stage3_detail_files=
    for bootstrap_stage3_detail_category in $bootstrap_stage3_detail_categories; do
        bootstrap_stage3_detail_file="${bootstrap_stage3_detail_tmp_root}/details.${bootstrap_stage3_detail_category}"
        rm -f "$bootstrap_stage3_detail_file"
        awk -v wanted="$bootstrap_stage3_detail_category" '
            function is_hash(s) { return length(s) == 64 && s !~ /[^0-9a-f]/ }
            {
                category = "unclassified"
                path = $2
                sub(/^\*/, "", path)
                if (is_hash($1) && path ~ /^src\/compiler_rust\// && path !~ /\/Cargo\.lock$/)
                    category = "compiler_sources"
                else if (is_hash($1) && path ~ /^src\/runtime\//)
                    category = "runtime_sources"
                else if (is_hash($1) && path !~ /^src\/compiler_rust\// && path !~ /^src\/runtime\//)
                    category = "cargo_path_dependencies"
                else if ($0 ~ /^(profile=|target-|windows-)/ ||
                         $0 ~ /(^|[[:space:]\/])(Cargo[.]lock|VERSION)$/)
                    category = "policy"
                else if ($0 ~ /^(rust-|rustc-|cargo-|rustc |cargo [0-9]|host:|release:|commit-hash:|commit-date:)/)
                    category = "toolchain"
                else if ($0 ~ /^(cc-|llvm-|native-)/)
                    category = "native_tools"
                else if ($0 ~ /^recipe[.]/)
                    category = "recipes"
                if (category == wanted) print
            }
        ' "$bootstrap_stage3_detail_records" >"$bootstrap_stage3_detail_file" || return 1
        bootstrap_stage3_detail_files="$bootstrap_stage3_detail_files $bootstrap_stage3_detail_file"
    done
    {
        printf 'schema=simple-bootstrap-fingerprint-details-v1\n'
        printf 'aggregate_sha256=%s\n' "$(bootstrap_stage3_hash_file "$bootstrap_stage3_detail_records")"
        printf 'category_count=%s\n' "$(printf '%s' "$bootstrap_stage3_detail_categories" | awk '{print NF}')"
        for bootstrap_stage3_detail_category in $bootstrap_stage3_detail_categories; do
            bootstrap_stage3_detail_file="${bootstrap_stage3_detail_tmp_root}/details.${bootstrap_stage3_detail_category}"
            bootstrap_stage3_detail_count=$(wc -l <"$bootstrap_stage3_detail_file" | tr -d ' ') || return 1
            bootstrap_stage3_detail_hash=$(bootstrap_stage3_hash_file "$bootstrap_stage3_detail_file") || return 1
            printf 'category_%s_count=%s\n' "$bootstrap_stage3_detail_category" "$bootstrap_stage3_detail_count"
            printf 'category_%s_sha256=%s\n' "$bootstrap_stage3_detail_category" "$bootstrap_stage3_detail_hash"
        done
    } >"$bootstrap_stage3_detail_out" || return 1
    chmod 400 "$bootstrap_stage3_detail_out" || return 1
    mv -f "$bootstrap_stage3_detail_out" "$bootstrap_stage3_detail_path" || return 1
    rm -f $bootstrap_stage3_detail_files
)

# Re-derive the Rust seed input fingerprint using the same complete authority
# as bootstrap-from-scratch.sh.  The caller supplies the selected backend and
# LLVM feature set and the exact canonical tool PATH used by the build. Tool
# identity is re-derived from that recorded PATH, never from verifier ambient
# state.
bootstrap_stage3_seed_inputs_fingerprint() (
    bootstrap_stage3_seed_trace() {
        [ "${BOOTSTRAP_STAGE3_FINGERPRINT_TRACE:-0}" = 1 ] || return 0
        printf 'fingerprint-step=%s\n' "$1" >&2
    }
    bootstrap_stage3_seed_trace validate-arguments
    case "$#" in
        4|5) ;;
        *) return 1 ;;
    esac
    bootstrap_stage3_seed_root=$1
    bootstrap_stage3_seed_backend=$2
    bootstrap_stage3_seed_features=$3
    bootstrap_stage3_seed_tool_path=$4
    bootstrap_stage3_seed_target=${5:-}
    bootstrap_stage3_seed_abi_policy=${SIMPLE_ABI_POLICY:-}
    case "$bootstrap_stage3_seed_abi_policy" in
        v1) ;;
        *) return 1 ;;
    esac
    if [ -z "$bootstrap_stage3_seed_target" ]; then
        bootstrap_stage3_seed_target=$(bootstrap_stage3_host_platform) ||
            return 1
    fi
    case "$bootstrap_stage3_seed_target" in
        *-pc-windows-gnu|*-pc-windows-msvc|*-unknown-linux-gnu|\
        *-apple-darwin|*-unknown-freebsd) ;;
        *) return 1 ;;
    esac
    case "$bootstrap_stage3_seed_tool_path" in
        /*) ;;
        *) return 1 ;;
    esac
    if printf '%s\n' "$bootstrap_stage3_seed_tool_path" |
        grep -Eq '(^|:)([^/]|$)'; then
        return 1
    fi
    PATH=$bootstrap_stage3_seed_tool_path
    export PATH
    # Windows ships find.exe ahead of the MSYS utilities on some admitted
    # host PATHs. Its command-line grammar is unrelated to POSIX find and
    # makes the authority fingerprint fail before it can observe inputs.
    # Bind the traversal tool explicitly while preserving the recorded build
    # PATH used for compiler/linker identity.
    bootstrap_stage3_seed_find=find
    bootstrap_stage3_seed_sort=sort
    case "$bootstrap_stage3_seed_target" in
        *-pc-windows-gnu|*-pc-windows-msvc)
            [ ! -x /usr/bin/find ] || bootstrap_stage3_seed_find=/usr/bin/find
            [ ! -x /usr/bin/sort ] || bootstrap_stage3_seed_sort=/usr/bin/sort
            ;;
    esac
    bootstrap_stage3_seed_tmp=$(
        mktemp -d "${TMPDIR:-/tmp}/bootstrap-stage3-seed.XXXXXX"
    ) || return 1
    bootstrap_stage3_seed_records="$bootstrap_stage3_seed_tmp/records"
    : >"$bootstrap_stage3_seed_records" || {
        rm -rf "$bootstrap_stage3_seed_tmp"
        return 1
    }
    (
        cd "$bootstrap_stage3_seed_root" || exit 1
        bootstrap_stage3_seed_trace reject-symlink-inputs
        if "$bootstrap_stage3_seed_find" src/compiler_rust src/runtime \
            \( -type d -name target -prune \) -o \
            -type l -print -quit | grep -q .; then
            exit 1
        fi
        bootstrap_stage3_seed_trace collect-compiler-inputs
        "$bootstrap_stage3_seed_find" src/compiler_rust \
            \( -type d -name target \) -prune -o \
            -type f -print 2>/dev/null \
            >"$bootstrap_stage3_seed_tmp/compiler.unsorted" || exit 1
        LC_ALL=C "$bootstrap_stage3_seed_sort" -u "$bootstrap_stage3_seed_tmp/compiler.unsorted" \
            >"$bootstrap_stage3_seed_tmp/compiler.paths" || exit 1
        bootstrap_stage3_hash_path_list \
            "$bootstrap_stage3_seed_tmp/compiler.paths" \
            >>"$bootstrap_stage3_seed_records" || exit 1
        # Cargo path dependencies may live outside src/compiler_rust (the
        # hosted runtime currently does). Discover them from dependency
        # sections instead of maintaining a partial hand-written allowlist.
        # Every resolved dependency must stay inside this checkout, must not
        # traverse a symlink, and must contribute all Cargo.toml/Rust inputs.
        bootstrap_stage3_seed_trace collect-cargo-path-dependencies
        "$bootstrap_stage3_seed_find" src/compiler_rust -name Cargo.toml -type f \
            -not -path '*/target/*' -print \
            >"$bootstrap_stage3_seed_tmp/cargo-manifests" || exit 1
        : >"$bootstrap_stage3_seed_tmp/path-deps.unsorted" || exit 1
        while IFS= read -r bootstrap_stage3_seed_manifest; do
            bootstrap_stage3_seed_manifest_dir=$(
                dirname -- "$bootstrap_stage3_seed_manifest"
            ) || exit 1
            awk '
                /^\[/ {
                    dependency_section = 0
                    if ($0 ~ /^\[(dependencies|build-dependencies)([.][^]]+)?\]$/)
                        dependency_section = 1
                    if ($0 ~ /^\[target[.][^]]+[.](dependencies|build-dependencies)([.][^]]+)?\]$/)
                        dependency_section = 1
                    if ($0 ~ /^\[workspace[.]dependencies([.][^]]+)?\]$/)
                        dependency_section = 1
                    if ($0 ~ /^\[patch[.][^]]+([.][^]]+)?\]$/)
                        dependency_section = 1
                    if ($0 ~ /^\[replace\]$/)
                        dependency_section = 1
                }
                dependency_section && match($0, /path[[:space:]]*=[[:space:]]*"[^"]+"/) {
                    value = substr($0, RSTART, RLENGTH)
                    sub(/^[^"]*"/, "", value)
                    sub(/"$/, "", value)
                    print value
                    next
                }
                dependency_section && match($0, /\{[^}]*path[[:space:]]*=[[:space:]]*"[^"]+"/) {
                    value = substr($0, RSTART, RLENGTH)
                    sub(/^.*path[[:space:]]*=[[:space:]]*"/, "", value)
                    sub(/"$/, "", value)
                    print value
                }
            ' "$bootstrap_stage3_seed_manifest" |
                while IFS= read -r bootstrap_stage3_seed_dep; do
                    [ -n "$bootstrap_stage3_seed_dep" ] || exit 1
                    bootstrap_stage3_seed_dep_absolute=$(
                        CDPATH= cd -- \
                            "$bootstrap_stage3_seed_manifest_dir/$bootstrap_stage3_seed_dep" &&
                            pwd -P
                    ) || exit 1
                    [ ! -L \
                        "$bootstrap_stage3_seed_manifest_dir/$bootstrap_stage3_seed_dep" ] ||
                        exit 1
                    case "$bootstrap_stage3_seed_dep_absolute" in
                        "$bootstrap_stage3_seed_root"/src/compiler_rust/*)
                            ;;
                        "$bootstrap_stage3_seed_root"/*)
                            printf '%s\n' \
                                "${bootstrap_stage3_seed_dep_absolute#"$bootstrap_stage3_seed_root"/}" \
                                >>"$bootstrap_stage3_seed_tmp/path-deps.unsorted" ||
                                exit 1
                            ;;
                        *) exit 1 ;;
                    esac
                done || exit 1
        done <"$bootstrap_stage3_seed_tmp/cargo-manifests"
        LC_ALL=C "$bootstrap_stage3_seed_sort" -u "$bootstrap_stage3_seed_tmp/path-deps.unsorted" \
            >"$bootstrap_stage3_seed_tmp/path-deps" || exit 1
        bootstrap_stage3_seed_trace hash-cargo-path-dependencies
        while IFS= read -r bootstrap_stage3_seed_dep_root; do
            [ -n "$bootstrap_stage3_seed_dep_root" ] || continue
            case "$bootstrap_stage3_seed_dep_root" in
                */target|*/target/*) exit 1 ;;
            esac
            "$bootstrap_stage3_seed_find" "$bootstrap_stage3_seed_dep_root" \
                \( -type d -name target -prune \) -o \
                -type f -print \
                >"$bootstrap_stage3_seed_tmp/path-dep-files.unsorted" ||
                exit 1
            LC_ALL=C "$bootstrap_stage3_seed_sort" -u \
                "$bootstrap_stage3_seed_tmp/path-dep-files.unsorted" \
                >"$bootstrap_stage3_seed_tmp/path-dep-files" || exit 1
            [ -s "$bootstrap_stage3_seed_tmp/path-dep-files" ] || exit 1
            bootstrap_stage3_hash_path_list \
                "$bootstrap_stage3_seed_tmp/path-dep-files" \
                >>"$bootstrap_stage3_seed_records" || exit 1
        done <"$bootstrap_stage3_seed_tmp/path-deps"
        bootstrap_stage3_seed_trace collect-runtime-inputs
        "$bootstrap_stage3_seed_find" src/runtime \( -name '*.c' -o -name '*.h' \) \
            -type f -print 2>/dev/null \
            >"$bootstrap_stage3_seed_tmp/runtime.unsorted" || exit 1
        LC_ALL=C "$bootstrap_stage3_seed_sort" -u "$bootstrap_stage3_seed_tmp/runtime.unsorted" \
            >"$bootstrap_stage3_seed_tmp/runtime.paths" || exit 1
        bootstrap_stage3_hash_path_list \
            "$bootstrap_stage3_seed_tmp/runtime.paths" \
            >>"$bootstrap_stage3_seed_records" || exit 1
        bootstrap_stage3_seed_trace hash-root-policy-inputs
        bootstrap_stage3_seed_lock_hash=$(
            bootstrap_stage3_hash_file src/compiler_rust/Cargo.lock
        ) || exit 1
        printf '%s  %s\n' "$bootstrap_stage3_seed_lock_hash" \
            src/compiler_rust/Cargo.lock \
            >>"$bootstrap_stage3_seed_records" || exit 1
        bootstrap_stage3_version_hash=$(
            bootstrap_stage3_hash_file VERSION
        ) || exit 1
        printf '%s  %s\n' "$bootstrap_stage3_version_hash" VERSION \
            >>"$bootstrap_stage3_seed_records" || exit 1
        printf 'profile=bootstrap backend=%s features=%s target=%s\n' \
            "$bootstrap_stage3_seed_backend" \
            "$bootstrap_stage3_seed_features" \
            "$bootstrap_stage3_seed_target" \
            >>"$bootstrap_stage3_seed_records" || exit 1
        printf 'simple-abi-policy=%s\n' \
            "$bootstrap_stage3_seed_abi_policy" \
            >>"$bootstrap_stage3_seed_records" || exit 1
        if [ "$bootstrap_stage3_seed_target" = \
            x86_64-pc-windows-gnu ]; then
            printf 'target-linker=%s\ntarget-cc=%s\ntarget-ar=%s\n' \
                "${CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER:-gcc}" \
                "${CC_x86_64_pc_windows_gnu:-gcc}" \
                "${AR_x86_64_pc_windows_gnu:-ar}" \
                >>"$bootstrap_stage3_seed_records" || exit 1
        elif [ "$bootstrap_stage3_seed_target" = \
            x86_64-pc-windows-msvc ]; then
            printf 'windows-INCLUDE=%s\nwindows-LIB=%s\nwindows-LIBPATH=%s\nwindows-SystemRoot=%s\nwindows-TEMP=%s\n' \
                "${INCLUDE:-}" "${LIB:-}" "${LIBPATH:-}" \
                "${SystemRoot:-}" "${TEMP:-}" \
                >>"$bootstrap_stage3_seed_records" || exit 1
        fi
        bootstrap_stage3_seed_llvm_authority=$(
            bootstrap_stage3_resolve_llvm_build_authority \
                "$PATH" "$bootstrap_stage3_seed_features"
        ) || exit 1
        printf '%s\n' "$bootstrap_stage3_seed_llvm_authority" \
            >>"$bootstrap_stage3_seed_records" || exit 1
        printf '%s\n' \
            'recipe.1=cargo build --locked --offline --manifest-path src/compiler_rust/Cargo.toml --profile bootstrap --target <selected-platform> -p simple-driver <selected-llvm-features>' \
            'recipe.2=cargo build --locked --offline --manifest-path src/compiler_rust/Cargo.toml --profile bootstrap --target <selected-platform> -p simple-native-all <selected-llvm-features>' \
            'recipe.3=env CARGO_PROFILE_BOOTSTRAP_LTO=off cargo build --locked --offline --manifest-path src/compiler_rust/Cargo.toml --profile bootstrap --target <selected-platform> -p simple-runtime --features runtime-symbol-table' \
            'recipe.4=cargo build --locked --offline --manifest-path src/compiler_rust/Cargo.toml --profile bootstrap --target <selected-platform> -p simple-compiler-backfill' \
            >>"$bootstrap_stage3_seed_records" || exit 1
        # Rust authority builds execute under env -i with explicit RUSTC/CC
        # paths. Ambient SDK/LLVM/general flag variables are therefore not
        # build inputs. The target and its MinGW tool selections are bound
        # above; tool versions and backend/features are bound below.
        bootstrap_stage3_seed_trace resolve-rust-toolchain
        bootstrap_stage3_seed_rust_authority=$(
            bootstrap_stage3_resolve_rust_toolchain \
                "$bootstrap_stage3_seed_root" "$PATH"
        ) || exit 1
        bootstrap_stage3_seed_trace rust-toolchain-resolver-returned
        bootstrap_stage3_seed_rust_sysroot=$(
            printf '%s\n' "$bootstrap_stage3_seed_rust_authority" |
                sed -n 's/^rust-sysroot=//p'
        ) || exit 1
        # Consume the exact executable identities returned by the resolver.
        # Reconstructing these names from the sysroot drops the required .exe
        # suffix under MSYS/MinGW and makes every Windows fingerprint fail even
        # though the resolver admitted canonical rustc.exe/cargo.exe paths.
        bootstrap_stage3_seed_rustc=$(
            printf '%s\n' "$bootstrap_stage3_seed_rust_authority" |
                sed -n 's/^rustc-path=//p'
        ) || exit 1
        bootstrap_stage3_seed_cargo=$(
            printf '%s\n' "$bootstrap_stage3_seed_rust_authority" |
                sed -n 's/^cargo-path=//p'
        ) || exit 1
        bootstrap_stage3_seed_trace rust-toolchain-fields-parsed
        [ -n "$bootstrap_stage3_seed_rust_sysroot" ] || exit 1
        [ -n "$bootstrap_stage3_seed_rustc" ] || exit 1
        [ -n "$bootstrap_stage3_seed_cargo" ] || exit 1
        [ -x "$bootstrap_stage3_seed_rustc" ] || exit 1
        [ -x "$bootstrap_stage3_seed_cargo" ] || exit 1
        bootstrap_stage3_seed_trace rust-toolchain-binaries-executable
        bootstrap_stage3_seed_trace hash-rust-toolchain
        printf '%s\n' "$bootstrap_stage3_seed_rust_authority" \
            >>"$bootstrap_stage3_seed_records" || exit 1
        printf 'rustc-toolchain-sha256=%s\ncargo-toolchain-sha256=%s\n' \
            "$(bootstrap_stage3_hash_file \
                "$bootstrap_stage3_seed_rustc")" \
            "$(bootstrap_stage3_hash_file \
                "$bootstrap_stage3_seed_cargo")" \
            >>"$bootstrap_stage3_seed_records" || exit 1
        bootstrap_stage3_native_metadata_probe rustc-fingerprint-version \
            "$bootstrap_stage3_seed_rustc" -vV \
            >"$bootstrap_stage3_seed_tmp/rustc-version" ||
            exit 1
        [ -s "$bootstrap_stage3_seed_tmp/rustc-version" ] || exit 1
        cat "$bootstrap_stage3_seed_tmp/rustc-version" \
            >>"$bootstrap_stage3_seed_records" || exit 1
        bootstrap_stage3_native_metadata_probe cargo-fingerprint-version \
            "$bootstrap_stage3_seed_cargo" -V \
            >>"$bootstrap_stage3_seed_records" || exit 1
        bootstrap_stage3_seed_trace resolve-native-toolchain
        bootstrap_stage3_seed_cc=$(
            bootstrap_stage3_target_c_compiler \
                "$bootstrap_stage3_seed_target"
        ) || exit 1
        bootstrap_stage3_seed_trace native-cc-selected
        if [ -n "$bootstrap_stage3_seed_cc" ]; then
            bootstrap_stage3_seed_cc_canonical=$(
                perl -MCwd=abs_path -e \
                    'my $p = abs_path($ARGV[0]); defined($p) or exit 1; print $p' \
                    "$bootstrap_stage3_seed_cc"
            ) || exit 1
            bootstrap_stage3_seed_trace native-cc-canonicalized
            printf 'cc-path=%s\ncc-sha256=%s\n' \
                "$bootstrap_stage3_seed_cc_canonical" \
                "$(bootstrap_stage3_hash_file \
                    "$bootstrap_stage3_seed_cc_canonical")" \
                >>"$bootstrap_stage3_seed_records" || exit 1
            bootstrap_stage3_seed_trace native-cc-identity-recorded
            bootstrap_stage3_seed_cc_version=\
"$bootstrap_stage3_seed_tmp/cc-version"
            bootstrap_stage3_seed_cc_status=0
            env -i PATH="$PATH" LC_ALL=C LANG=C \
                "$bootstrap_stage3_seed_cc" --version \
                >"$bootstrap_stage3_seed_cc_version" 2>&1 ||
                bootstrap_stage3_seed_cc_status=$?
            bootstrap_stage3_seed_trace "native-cc-version-status=$bootstrap_stage3_seed_cc_status"
            printf 'cc-version-status=%s\n' \
                "$bootstrap_stage3_seed_cc_status" \
                >>"$bootstrap_stage3_seed_records" || exit 1
            sed -n '1p' "$bootstrap_stage3_seed_cc_version" \
                >>"$bootstrap_stage3_seed_records" || exit 1
        fi
        bootstrap_stage3_seed_trace native-cc-recorded
        if command -v llvm-config >/dev/null 2>&1; then
            bootstrap_stage3_seed_llvm_config=$(command -v llvm-config) ||
                exit 1
            bootstrap_stage3_seed_trace native-llvm-selected
            bootstrap_stage3_seed_llvm_config_canonical=$(
                perl -MCwd=abs_path -e \
                    'my $p = abs_path($ARGV[0]); defined($p) or exit 1; print $p' \
                    "$bootstrap_stage3_seed_llvm_config"
            ) || exit 1
            bootstrap_stage3_seed_trace native-llvm-canonicalized
            printf 'llvm-config-path=%s\nllvm-config-sha256=%s\n' \
                "$bootstrap_stage3_seed_llvm_config_canonical" \
                "$(bootstrap_stage3_hash_file \
                    "$bootstrap_stage3_seed_llvm_config_canonical")" \
                >>"$bootstrap_stage3_seed_records" || exit 1
            bootstrap_stage3_seed_trace native-llvm-identity-recorded
            bootstrap_stage3_seed_llvm_version=$(
                bootstrap_stage3_native_metadata_probe llvm-config-version \
                    "$bootstrap_stage3_seed_llvm_config" --version
            ) || exit 1
            bootstrap_stage3_seed_trace native-llvm-version-returned
            bootstrap_stage3_seed_llvm_prefix=$(
                bootstrap_stage3_native_metadata_probe llvm-config-prefix \
                    "$bootstrap_stage3_seed_llvm_config" --prefix
            ) || exit 1
            bootstrap_stage3_seed_trace native-llvm-prefix-returned
            printf 'llvm-config-version=%s\n' \
                "$bootstrap_stage3_seed_llvm_version" \
                >>"$bootstrap_stage3_seed_records" || exit 1
            printf 'llvm-config-prefix=%s\n' \
                "$bootstrap_stage3_seed_llvm_prefix" \
                >>"$bootstrap_stage3_seed_records" || exit 1
        else
            echo "llvm-config=absent" >>"$bootstrap_stage3_seed_records" ||
                exit 1
        fi
        bootstrap_stage3_seed_trace finalize-records
    ) || {
        rm -rf "$bootstrap_stage3_seed_tmp"
        return 1
    }
    if [ -n "${BOOTSTRAP_STAGE3_FINGERPRINT_DETAILS_PATH:-}" ]; then
        bootstrap_stage3_write_seed_fingerprint_details \
            "${BOOTSTRAP_STAGE3_FINGERPRINT_DETAILS_PATH}" \
            "$bootstrap_stage3_seed_records" "$bootstrap_stage3_seed_tmp" || {
            rm -rf "$bootstrap_stage3_seed_tmp"
            return 1
        }
    fi
    bootstrap_stage3_seed_result=$(
        bootstrap_stage3_hash_file "$bootstrap_stage3_seed_records"
    ) || {
        rm -rf "$bootstrap_stage3_seed_tmp"
        return 1
    }
    rm -rf "$bootstrap_stage3_seed_tmp"
    printf '%s\n' "$bootstrap_stage3_seed_result"
)

# Store the literal command and the exact sanitized environment used to execute
# it. Every record is length-prefixed, including values with spaces.
# Arguments before "--" are explicit NAME=VALUE entries; arguments after it are
# the executable and argv exactly as passed to env(1).
