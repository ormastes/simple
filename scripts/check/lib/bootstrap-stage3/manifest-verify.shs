bootstrap_stage3_verify_manifest() {
    bootstrap_stage3_manifest=$1
    bootstrap_stage3_root=$2
    bootstrap_stage3_expected_output=$3
    bootstrap_stage3_root_canonical=$(
        CDPATH= cd -- "$bootstrap_stage3_root" && pwd -P
    ) || return 1
    [ "$bootstrap_stage3_root" = "$bootstrap_stage3_root_canonical" ] ||
        bootstrap_stage3_provenance_fail "repository-root-not-canonical" ||
        return 1
    [ -f "$bootstrap_stage3_manifest" ] &&
        [ ! -L "$bootstrap_stage3_manifest" ] ||
        bootstrap_stage3_provenance_fail "manifest-missing-or-symlinked" ||
        return 1
    [ "$(bootstrap_stage3_canonical_file "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_manifest" ] ||
        bootstrap_stage3_provenance_fail "manifest-path-not-canonical" ||
        return 1

    for bootstrap_stage3_key in schema status artifact_kind full_cli_status \
        created_at_utc platform backend mode build_rust_log \
        native_build_backfill_status source_roots source_file_count \
        source_fingerprint git_state_path git_state_sha256 git_head \
        git_dirty_fingerprint bootstrap_lock_path bootstrap_lock_owner_pid \
        seed_path seed_sha256 seed_inputs_fingerprint seed_backend seed_features \
        seed_inputs_stamp_path seed_inputs_stamp_sha256 \
        native_all_path native_all_sha256 compiler_backfill_path \
        compiler_backfill_status compiler_backfill_sha256 stage2_path \
        stage2_sha256 stage2_admitted_path stage2_admitted_sha256 \
        stage2_threads stage2_command_output \
        stage2_build_args_sha256 stage2_build_log_sha256 \
        stage2_build_log_path stage2_command_transcript_path \
        stage2_command_transcript_sha256 stage2_sanity_status \
        stage2_sanity_evidence_path stage2_sanity_evidence_sha256 \
        stage3_path stage3_sha256 stage3_threads \
        stage3_command_output stage3_build_args_sha256 stage3_build_log_sha256 \
        stage3_build_log_path stage3_command_transcript_path \
        stage3_command_transcript_sha256 stage3_sanity_status \
        stage3_sanity_evidence_path stage3_sanity_evidence_sha256 \
        stage2_native_cache_dir stage3_native_cache_dir runtime_path \
        runtime_origin_snapshot_path runtime_origin_snapshot_sha256 \
        runtime_admitted_snapshot_path runtime_admitted_snapshot_sha256 \
        tool_authority_path tool_authority_sha256 \
        bootstrap_script_path bootstrap_script_sha256 \
        provenance_helper_path provenance_helper_sha256 \
        provenance_helper_bundle_fingerprint \
        source_snapshot_path source_snapshot_sha256 output_path output_sha256; do
        bootstrap_stage3_manifest_value "$bootstrap_stage3_key" \
            "$bootstrap_stage3_manifest" >/dev/null ||
            bootstrap_stage3_provenance_fail \
                "manifest-${bootstrap_stage3_key}-not-singular" ||
            return 1
    done

    [ "$(bootstrap_stage3_manifest_value schema "$bootstrap_stage3_manifest")" = \
        simple-bootstrap-stage3-provenance-v3 ] || return 1
    [ "$(bootstrap_stage3_manifest_value status "$bootstrap_stage3_manifest")" = \
        pass ] || return 1
    [ "$(bootstrap_stage3_manifest_value artifact_kind "$bootstrap_stage3_manifest")" = \
        pure-simple-bootstrap-compiler ] || return 1
    [ "$(bootstrap_stage3_manifest_value full_cli_status "$bootstrap_stage3_manifest")" = \
        separate-not-proven ] || return 1
    [ "$(bootstrap_stage3_manifest_value native_build_backfill_status "$bootstrap_stage3_manifest")" = \
        bound-bootstrap-native-all ] || return 1
    [ "$(bootstrap_stage3_manifest_value source_roots "$bootstrap_stage3_manifest")" = \
        src/compiler:src/app:src/lib ] || return 1
    [ "$(bootstrap_stage3_manifest_value stage2_sanity_status \
        "$bootstrap_stage3_manifest")" = pass ] || return 1
    [ "$(bootstrap_stage3_manifest_value stage3_sanity_status \
        "$bootstrap_stage3_manifest")" = pass ] || return 1
    [ "$(bootstrap_stage3_manifest_value bootstrap_script_path \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_root/scripts/bootstrap/bootstrap-from-scratch.sh" ] ||
        return 1
    [ "$(bootstrap_stage3_manifest_value provenance_helper_path \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_root/scripts/check/lib/bootstrap-stage3-provenance.shs" ] ||
        return 1
    [ "$(bootstrap_stage3_manifest_value provenance_helper_bundle_fingerprint \
        "$bootstrap_stage3_manifest")" = \
        "$(bootstrap_stage3_helper_bundle_fingerprint)" ] || return 1
    bootstrap_stage3_manifest_dir=$(
        CDPATH= cd -- "$(dirname -- "$bootstrap_stage3_manifest")" &&
            pwd -P
    ) || return 1
    bootstrap_stage3_link_compat_dir=\
"$bootstrap_stage3_manifest_dir/link-compat"
    bootstrap_stage3_link_compat_file=\
"$bootstrap_stage3_link_compat_dir/libunwind.so"
    bootstrap_stage3_link_library_path=
    bootstrap_stage3_link_compat_sha256=absent
    if [ -e "$bootstrap_stage3_link_compat_file" ] ||
        [ -L "$bootstrap_stage3_link_compat_file" ]; then
        [ -d "$bootstrap_stage3_link_compat_dir" ] &&
            [ ! -L "$bootstrap_stage3_link_compat_dir" ] &&
            [ "$(bootstrap_stage3_canonical_path \
                "$bootstrap_stage3_link_compat_dir")" = \
                "$bootstrap_stage3_link_compat_dir" ] || return 1
        [ -f "$bootstrap_stage3_link_compat_file" ] &&
            [ ! -L "$bootstrap_stage3_link_compat_file" ] &&
            [ "$(bootstrap_stage3_canonical_file \
                "$bootstrap_stage3_link_compat_file")" = \
                "$bootstrap_stage3_link_compat_file" ] || return 1
        bootstrap_stage3_link_library_path=$bootstrap_stage3_link_compat_dir
        bootstrap_stage3_link_compat_sha256=$(
            bootstrap_stage3_hash_file \
                "$bootstrap_stage3_link_compat_file"
        ) || return 1
    fi
    [ "$(bootstrap_stage3_manifest_value source_snapshot_path \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_manifest_dir/source-inputs-after.txt" ] || return 1
    for bootstrap_stage3_sha_key in source_fingerprint seed_sha256 \
        seed_inputs_fingerprint seed_inputs_stamp_sha256 native_all_sha256 \
        stage2_sha256 stage2_admitted_sha256 \
        stage2_build_args_sha256 stage2_build_log_sha256 \
        stage2_command_transcript_sha256 stage2_sanity_evidence_sha256 \
        stage3_sha256 stage3_build_args_sha256 stage3_build_log_sha256 \
        stage3_command_transcript_sha256 stage3_sanity_evidence_sha256 \
        runtime_origin_snapshot_sha256 runtime_admitted_snapshot_sha256 \
        tool_authority_sha256 \
        git_state_sha256 git_dirty_fingerprint \
        bootstrap_script_sha256 provenance_helper_sha256 \
        provenance_helper_bundle_fingerprint \
        source_snapshot_sha256 output_sha256; do
        bootstrap_stage3_sha_value=$(
            bootstrap_stage3_manifest_value "$bootstrap_stage3_sha_key" \
                "$bootstrap_stage3_manifest"
        ) || return 1
        printf '%s\n' "$bootstrap_stage3_sha_value" |
            grep -Eq '^[0-9a-f]{64}$' || return 1
    done
    bootstrap_stage3_platform=$(
        bootstrap_stage3_manifest_value platform "$bootstrap_stage3_manifest"
    ) || return 1
    [ "$bootstrap_stage3_platform" = \
        "$(bootstrap_stage3_host_platform)" ] ||
        bootstrap_stage3_provenance_fail "manifest-platform-not-host" ||
        return 1
    bootstrap_stage3_backend=$(
        bootstrap_stage3_manifest_value backend "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_mode=$(
        bootstrap_stage3_manifest_value mode "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_rust_log=$(
        bootstrap_stage3_manifest_value build_rust_log \
            "$bootstrap_stage3_manifest"
    ) || return 1
    case "$bootstrap_stage3_rust_log" in
        '')
            return 1
            ;;
        *'
'*)
            return 1
            ;;
    esac
    bootstrap_stage3_stage2_threads=$(
        bootstrap_stage3_manifest_value stage2_threads \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_stage3_threads=$(
        bootstrap_stage3_manifest_value stage3_threads \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_stage2_cache_dir=$(
        bootstrap_stage3_manifest_value stage2_native_cache_dir \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_stage3_cache_dir=$(
        bootstrap_stage3_manifest_value stage3_native_cache_dir \
            "$bootstrap_stage3_manifest"
    ) || return 1
    [ "$bootstrap_stage3_stage2_cache_dir" = \
        "$bootstrap_stage3_manifest_dir/stage2-native-cache" ] || return 1
    [ "$bootstrap_stage3_stage3_cache_dir" = \
        "$bootstrap_stage3_manifest_dir/stage3-native-cache" ] || return 1
    [ "$bootstrap_stage3_stage2_cache_dir" != \
        "$bootstrap_stage3_stage3_cache_dir" ] || return 1
    [ -d "$bootstrap_stage3_stage2_cache_dir" ] &&
        [ "$(bootstrap_stage3_canonical_path \
            "$bootstrap_stage3_stage2_cache_dir")" = \
            "$bootstrap_stage3_stage2_cache_dir" ] || return 1
    [ -d "$bootstrap_stage3_stage3_cache_dir" ] &&
        [ "$(bootstrap_stage3_canonical_path \
            "$bootstrap_stage3_stage3_cache_dir")" = \
            "$bootstrap_stage3_stage3_cache_dir" ] || return 1
    bootstrap_stage3_runtime_path=$(
        bootstrap_stage3_manifest_value runtime_path \
            "$bootstrap_stage3_manifest"
    ) || return 1
    [ "$bootstrap_stage3_runtime_path" = \
        "$bootstrap_stage3_manifest_dir/stage2-runtime-authority" ] ||
        return 1
    [ "$(bootstrap_stage3_canonical_path "$bootstrap_stage3_runtime_path")" = \
        "$bootstrap_stage3_runtime_path" ] || return 1
    bootstrap_stage3_stage2_command_output=$(
        bootstrap_stage3_manifest_value stage2_command_output \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_stage3_command_output=$(
        bootstrap_stage3_manifest_value stage3_command_output \
            "$bootstrap_stage3_manifest"
    ) || return 1
    case "$bootstrap_stage3_stage2_command_output" in
        /*) bootstrap_stage3_stage2_command_abs=$bootstrap_stage3_stage2_command_output ;;
        *) bootstrap_stage3_stage2_command_abs="$bootstrap_stage3_root/$bootstrap_stage3_stage2_command_output" ;;
    esac
    case "$bootstrap_stage3_stage3_command_output" in
        /*) bootstrap_stage3_stage3_command_abs=$bootstrap_stage3_stage3_command_output ;;
        *) bootstrap_stage3_stage3_command_abs="$bootstrap_stage3_root/$bootstrap_stage3_stage3_command_output" ;;
    esac
    [ "$(bootstrap_stage3_manifest_value stage2_path \
        "$bootstrap_stage3_manifest")" = "$bootstrap_stage3_stage2_command_abs" ] ||
        return 1
    [ "$(bootstrap_stage3_manifest_value stage3_path \
        "$bootstrap_stage3_manifest")" = "$bootstrap_stage3_stage3_command_abs" ] ||
        return 1
    bootstrap_stage3_manifest_output_root=$(
        CDPATH= cd -- "$bootstrap_stage3_manifest_dir/../.." && pwd -P
    ) || return 1
    bootstrap_stage3_expected_stage2_path=\
"$bootstrap_stage3_manifest_output_root/stage2/$bootstrap_stage3_platform/simple"
    case "$bootstrap_stage3_platform" in
        *windows*) bootstrap_stage3_expected_stage2_path="${bootstrap_stage3_expected_stage2_path}.exe" ;;
    esac
    [ "$(bootstrap_stage3_manifest_value stage2_path \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_stage2_path" ] ||
        bootstrap_stage3_provenance_fail "stage2-path-outside-canonical-lane" ||
        return 1
    bootstrap_stage3_expected_stage2_admitted_path=\
"$bootstrap_stage3_manifest_dir/stage2-admitted/simple"
    case "$bootstrap_stage3_platform" in
        *windows*) bootstrap_stage3_expected_stage2_admitted_path="${bootstrap_stage3_expected_stage2_admitted_path}.exe" ;;
    esac
    [ "$(bootstrap_stage3_manifest_value stage2_admitted_path \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_stage2_admitted_path" ] || return 1
    [ "$(bootstrap_stage3_manifest_value stage2_admitted_sha256 \
        "$bootstrap_stage3_manifest")" = \
        "$(bootstrap_stage3_manifest_value stage2_sha256 \
            "$bootstrap_stage3_manifest")" ] || return 1
    bootstrap_stage3_expected_stage3_path=\
"$bootstrap_stage3_manifest_output_root/stage3/$bootstrap_stage3_platform/simple"
    case "$bootstrap_stage3_platform" in
        *windows*) bootstrap_stage3_expected_stage3_path="${bootstrap_stage3_expected_stage3_path}.exe" ;;
    esac
    [ "$(bootstrap_stage3_manifest_value stage3_path \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_stage3_path" ] ||
        bootstrap_stage3_provenance_fail "stage3-path-outside-canonical-lane" ||
        return 1
    for bootstrap_stage3_layout_pair in \
        "git_state_path:$bootstrap_stage3_manifest_dir/git-state-after.env" \
        "stage2_command_transcript_path:$bootstrap_stage3_manifest_dir/stage2-command.transcript" \
        "stage3_command_transcript_path:$bootstrap_stage3_manifest_dir/stage3-command.transcript" \
        "stage2_sanity_evidence_path:$bootstrap_stage3_manifest_dir/stage2-sanity.env" \
        "stage3_sanity_evidence_path:$bootstrap_stage3_manifest_dir/stage3-sanity.env"; do
        bootstrap_stage3_layout_key=${bootstrap_stage3_layout_pair%%:*}
        bootstrap_stage3_layout_path=${bootstrap_stage3_layout_pair#*:}
        [ "$(bootstrap_stage3_manifest_value \
            "$bootstrap_stage3_layout_key" "$bootstrap_stage3_manifest")" = \
            "$bootstrap_stage3_layout_path" ] || return 1
    done
    bootstrap_stage3_expected_stage2_args=$(
        bootstrap_stage3_args_sha256 \
            "RUST_LOG=$bootstrap_stage3_rust_log" \
            "LIBRARY_PATH=$bootstrap_stage3_link_library_path" \
            "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage3_link_compat_sha256" \
            "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
            "SIMPLE_NATIVE_BUILD_RUST=1" \
            "SIMPLE_NO_STUB_FALLBACK=1" \
            "SIMPLE_NATIVE_ARENA_DECLS=1" \
            "SIMPLE_BINARY=$(bootstrap_stage3_manifest_value seed_path \
                "$bootstrap_stage3_manifest")" \
            native-build --target "$bootstrap_stage3_platform" \
            --backend "$bootstrap_stage3_backend" \
            --runtime-bundle core-c-bootstrap \
            --source src/compiler --source src/app --source src/lib \
            --entry-closure --threads "$bootstrap_stage3_stage2_threads" \
            --cache-dir "$bootstrap_stage3_stage2_cache_dir" \
            --mode "$bootstrap_stage3_mode" \
            --entry src/app/cli/bootstrap_main.spl \
            --runtime-path "$bootstrap_stage3_runtime_path" \
            -o "$bootstrap_stage3_stage2_command_output"
    )
    [ "$(bootstrap_stage3_manifest_value stage2_build_args_sha256 \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_stage2_args" ] || return 1
    bootstrap_stage3_stage2_transcript=$(
        bootstrap_stage3_manifest_value stage2_command_transcript_path \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_seed_executable=$(
        bootstrap_stage3_manifest_value seed_path "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_verify_command_transcript \
        "$bootstrap_stage3_stage2_transcript" "$bootstrap_stage3_root" \
        "RUST_LOG=$bootstrap_stage3_rust_log" \
        "LIBRARY_PATH=$bootstrap_stage3_link_library_path" \
        "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage3_link_compat_sha256" \
        "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
        "SIMPLE_NATIVE_BUILD_RUST=1" "SIMPLE_NO_STUB_FALLBACK=1" \
        "SIMPLE_NATIVE_ARENA_DECLS=1" \
        "SIMPLE_BINARY=$bootstrap_stage3_seed_executable" -- \
        "$bootstrap_stage3_seed_executable" \
        native-build --target "$bootstrap_stage3_platform" \
        --backend "$bootstrap_stage3_backend" \
        --runtime-bundle core-c-bootstrap \
        --source src/compiler --source src/app --source src/lib \
        --entry-closure --threads "$bootstrap_stage3_stage2_threads" \
        --cache-dir "$bootstrap_stage3_stage2_cache_dir" \
        --mode "$bootstrap_stage3_mode" \
        --entry src/app/cli/bootstrap_main.spl \
        --runtime-path "$bootstrap_stage3_runtime_path" \
        -o "$bootstrap_stage3_stage2_command_output" || return 1
    bootstrap_stage3_expected_stage3_args=$(
        bootstrap_stage3_args_sha256 \
            "RUST_LOG=$bootstrap_stage3_rust_log" \
            "LIBRARY_PATH=$bootstrap_stage3_link_library_path" \
            "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage3_link_compat_sha256" \
            "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
            "SIMPLE_NO_STUB_FALLBACK=1" \
            "SIMPLE_NATIVE_RUNTIME_BUNDLE=all" \
            "SIMPLE_NATIVE_ARENA_DECLS=1" \
            "LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING=1" \
            "SIMPLE_BINARY=$(bootstrap_stage3_manifest_value stage2_admitted_path \
                "$bootstrap_stage3_manifest")" \
            native-build --target "$bootstrap_stage3_platform" \
            --backend "$bootstrap_stage3_backend" \
            --threads "$bootstrap_stage3_stage3_threads" \
            --cache-dir "$bootstrap_stage3_stage3_cache_dir" \
            --mode "$bootstrap_stage3_mode" \
            --runtime-path "$bootstrap_stage3_runtime_path" \
            -o "$bootstrap_stage3_stage3_command_output" \
            src/app/cli/bootstrap_main.spl
    )
    [ "$(bootstrap_stage3_manifest_value stage3_build_args_sha256 \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_stage3_args" ] || return 1
    bootstrap_stage3_stage3_transcript=$(
        bootstrap_stage3_manifest_value stage3_command_transcript_path \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_stage2_executable=$(
        bootstrap_stage3_manifest_value stage2_admitted_path \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_verify_command_transcript \
        "$bootstrap_stage3_stage3_transcript" "$bootstrap_stage3_root" \
        "RUST_LOG=$bootstrap_stage3_rust_log" \
        "LIBRARY_PATH=$bootstrap_stage3_link_library_path" \
        "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage3_link_compat_sha256" \
        "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
        "SIMPLE_NO_STUB_FALLBACK=1" \
        "SIMPLE_NATIVE_RUNTIME_BUNDLE=all" \
        "SIMPLE_NATIVE_ARENA_DECLS=1" \
        "LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING=1" \
        "SIMPLE_BINARY=$bootstrap_stage3_stage2_executable" -- \
        "$bootstrap_stage3_stage2_executable" \
        native-build --target "$bootstrap_stage3_platform" \
        --backend "$bootstrap_stage3_backend" \
        --threads "$bootstrap_stage3_stage3_threads" \
        --cache-dir "$bootstrap_stage3_stage3_cache_dir" \
        --mode "$bootstrap_stage3_mode" \
        --runtime-path "$bootstrap_stage3_runtime_path" \
        -o "$bootstrap_stage3_stage3_command_output" \
        src/app/cli/bootstrap_main.spl || return 1

    bootstrap_stage3_output=$(
        bootstrap_stage3_manifest_value output_path "$bootstrap_stage3_manifest"
    ) || return 1
    [ "$bootstrap_stage3_output" = "$bootstrap_stage3_expected_output" ] ||
        return 1
    [ "$(bootstrap_stage3_canonical_file "$bootstrap_stage3_expected_output")" = \
        "$bootstrap_stage3_expected_output" ] || return 1
    [ -x "$bootstrap_stage3_output" ] &&
        [ ! -L "$bootstrap_stage3_output" ] || return 1
    [ "$(bootstrap_stage3_manifest_value output_sha256 "$bootstrap_stage3_manifest")" = \
        "$(bootstrap_stage3_hash_file "$bootstrap_stage3_output")" ] || return 1
    [ "$(bootstrap_stage3_manifest_value stage3_path "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_output" ] || return 1
    [ "$(bootstrap_stage3_manifest_value stage3_sha256 "$bootstrap_stage3_manifest")" = \
        "$(bootstrap_stage3_hash_file "$bootstrap_stage3_output")" ] || return 1

    for bootstrap_stage3_pair in \
        seed_path:seed_sha256 native_all_path:native_all_sha256 \
        stage2_path:stage2_sha256 \
        stage2_admitted_path:stage2_admitted_sha256 \
        stage2_build_log_path:stage2_build_log_sha256 \
        stage2_command_transcript_path:stage2_command_transcript_sha256 \
        stage2_sanity_evidence_path:stage2_sanity_evidence_sha256 \
        stage3_build_log_path:stage3_build_log_sha256 \
        stage3_command_transcript_path:stage3_command_transcript_sha256 \
        stage3_sanity_evidence_path:stage3_sanity_evidence_sha256 \
        git_state_path:git_state_sha256 \
        bootstrap_script_path:bootstrap_script_sha256 \
        provenance_helper_path:provenance_helper_sha256 \
        runtime_origin_snapshot_path:runtime_origin_snapshot_sha256 \
        runtime_admitted_snapshot_path:runtime_admitted_snapshot_sha256 \
        tool_authority_path:tool_authority_sha256 \
        seed_inputs_stamp_path:seed_inputs_stamp_sha256 \
        source_snapshot_path:source_snapshot_sha256; do
        bootstrap_stage3_path_key=${bootstrap_stage3_pair%%:*}
        bootstrap_stage3_sha_key=${bootstrap_stage3_pair#*:}
        bootstrap_stage3_verify_bound_file "$bootstrap_stage3_manifest" \
            "$bootstrap_stage3_path_key" "$bootstrap_stage3_sha_key" ||
            return 1
    done
    bootstrap_stage3_runtime_origin_snapshot=$(
        bootstrap_stage3_manifest_value runtime_origin_snapshot_path \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_runtime_admitted_snapshot=$(
        bootstrap_stage3_manifest_value runtime_admitted_snapshot_path \
            "$bootstrap_stage3_manifest"
    ) || return 1
    cmp -s "$bootstrap_stage3_runtime_origin_snapshot" \
        "$bootstrap_stage3_runtime_admitted_snapshot" || return 1
    bootstrap_stage3_runtime_verify_snapshot=\
"${bootstrap_stage3_manifest}.runtime.verify.$$"
    bootstrap_stage3_directory_snapshot \
        "$bootstrap_stage3_runtime_verify_snapshot" \
        "$bootstrap_stage3_runtime_path" || return 1
    cmp -s "$bootstrap_stage3_runtime_admitted_snapshot" \
        "$bootstrap_stage3_runtime_verify_snapshot" || {
        rm -f "$bootstrap_stage3_runtime_verify_snapshot"
        return 1
    }
    rm -f "$bootstrap_stage3_runtime_verify_snapshot"
    bootstrap_stage3_tool_authority_path=$(
        bootstrap_stage3_manifest_value tool_authority_path \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_tool_verify=\
"${bootstrap_stage3_manifest}.tools.verify.$$"
    bootstrap_stage3_tool_authority_snapshot \
        "$bootstrap_stage3_tool_verify" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage2_transcript" PATH)" \
        "$bootstrap_stage3_root" || return 1
    cmp -s "$bootstrap_stage3_tool_authority_path" \
        "$bootstrap_stage3_tool_verify" || {
        rm -f "$bootstrap_stage3_tool_verify"
        return 1
    }
    rm -f "$bootstrap_stage3_tool_verify"
    bootstrap_stage3_seed_stamp=$(
        bootstrap_stage3_manifest_value seed_inputs_stamp_path \
            "$bootstrap_stage3_manifest"
    )
    bootstrap_stage3_seed_path=$(
        bootstrap_stage3_manifest_value seed_path "$bootstrap_stage3_manifest"
    )
    bootstrap_stage3_native_all_path=$(
        bootstrap_stage3_manifest_value native_all_path \
            "$bootstrap_stage3_manifest"
    )
    bootstrap_stage3_runtime_dir="$bootstrap_stage3_runtime_path"
    case "$bootstrap_stage3_seed_path" in
        "$bootstrap_stage3_runtime_dir/simple"|"$bootstrap_stage3_runtime_dir/simple.exe") ;;
        *) return 1 ;;
    esac
    case "$bootstrap_stage3_native_all_path" in
        "$bootstrap_stage3_runtime_dir/libsimple_native_all.a"|\
        "$bootstrap_stage3_runtime_dir/simple_native_all.lib") ;;
        *) return 1 ;;
    esac
    [ "$bootstrap_stage3_seed_stamp" = \
        "${bootstrap_stage3_seed_path}.inputs.sha256" ] || return 1
    bootstrap_stage3_verify_seed_stamp "$bootstrap_stage3_seed_stamp" \
        "$(bootstrap_stage3_manifest_value seed_inputs_fingerprint \
            "$bootstrap_stage3_manifest")" \
        "$bootstrap_stage3_seed_path" "$bootstrap_stage3_native_all_path" \
        "$(bootstrap_stage3_manifest_value compiler_backfill_path \
            "$bootstrap_stage3_manifest")" || return 1
    [ "$(bootstrap_stage3_manifest_value seed_backend \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_backend" ] || return 1
    bootstrap_stage3_seed_features=$(
        bootstrap_stage3_manifest_value seed_features \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_seed_authority_path=$(
        bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage2_transcript" PATH
    ) || return 1
    bootstrap_stage3_seed_fingerprint_rederived=$(
        bootstrap_stage3_seed_inputs_fingerprint "$bootstrap_stage3_root" \
            "$bootstrap_stage3_backend" "$bootstrap_stage3_seed_features" \
            "$bootstrap_stage3_seed_authority_path" \
            "$bootstrap_stage3_platform"
    ) || return 1
    [ "$bootstrap_stage3_seed_fingerprint_rederived" = \
        "$(bootstrap_stage3_manifest_value seed_inputs_fingerprint \
            "$bootstrap_stage3_manifest")" ] ||
        bootstrap_stage3_provenance_fail \
            "seed-input-fingerprint-current-authority-mismatch" ||
        return 1

    bootstrap_stage3_stage2_sanity=$(
        bootstrap_stage3_manifest_value stage2_sanity_evidence_path \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_stage3_sanity=$(
        bootstrap_stage3_manifest_value stage3_sanity_evidence_path \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_verify_sanity_evidence \
        "$bootstrap_stage3_stage2_sanity" \
        "$bootstrap_stage3_stage2_executable" \
        "$bootstrap_stage3_root" "$bootstrap_stage3_backend" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage2_transcript" HOME)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage2_transcript" TMPDIR)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage2_transcript" PATH)" || return 1
    bootstrap_stage3_verify_sanity_evidence \
        "$bootstrap_stage3_stage3_sanity" \
        "$bootstrap_stage3_output" \
        "$bootstrap_stage3_root" "$bootstrap_stage3_backend" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage3_transcript" HOME)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage3_transcript" TMPDIR)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage3_transcript" PATH)" || return 1

    bootstrap_stage3_recorded_lock=$(
        bootstrap_stage3_manifest_value bootstrap_lock_path \
            "$bootstrap_stage3_manifest"
    ) || return 1
    [ "$bootstrap_stage3_recorded_lock" = \
        "${bootstrap_stage3_manifest_output_root}.lock" ] || return 1
    [ "$(bootstrap_stage3_canonical_path "$bootstrap_stage3_recorded_lock")" = \
        "$bootstrap_stage3_recorded_lock" ] || return 1
    bootstrap_stage3_recorded_lock_pid=$(
        bootstrap_stage3_manifest_value bootstrap_lock_owner_pid \
            "$bootstrap_stage3_manifest"
    ) || return 1
    case "$bootstrap_stage3_recorded_lock_pid" in
        ''|*[!0-9]*|0) return 1 ;;
    esac

    bootstrap_stage3_verify_git_before="${bootstrap_stage3_manifest}.git.verify.before.$$"
    bootstrap_stage3_verify_git_after="${bootstrap_stage3_manifest}.git.verify.after.$$"
    bootstrap_stage3_git_state "$bootstrap_stage3_root" \
        "$bootstrap_stage3_verify_git_before" || return 1
    bootstrap_stage3_verify_snapshot="${bootstrap_stage3_manifest}.verify.$$"
    bootstrap_stage3_source_snapshot "$bootstrap_stage3_verify_snapshot" \
        "$bootstrap_stage3_root" || return 1
    bootstrap_stage3_git_state "$bootstrap_stage3_root" \
        "$bootstrap_stage3_verify_git_after" || {
        rm -f "$bootstrap_stage3_verify_snapshot" \
            "$bootstrap_stage3_verify_git_before"
        return 1
    }
    cmp -s "$bootstrap_stage3_verify_git_before" \
        "$bootstrap_stage3_verify_git_after" || {
        rm -f "$bootstrap_stage3_verify_snapshot" \
            "$bootstrap_stage3_verify_git_before" \
            "$bootstrap_stage3_verify_git_after"
        return 1
    }
    bootstrap_stage3_current_count=$(
        wc -l <"$bootstrap_stage3_verify_snapshot" | tr -d ' '
    )
    bootstrap_stage3_current_sha=$(
        bootstrap_stage3_hash_file "$bootstrap_stage3_verify_snapshot"
    )
    bootstrap_stage3_current_git_sha=$(
        bootstrap_stage3_hash_file "$bootstrap_stage3_verify_git_after"
    )
    bootstrap_stage3_current_git_head=$(
        bootstrap_stage3_manifest_value head \
            "$bootstrap_stage3_verify_git_after"
    )
    bootstrap_stage3_current_git_dirty=$(
        bootstrap_stage3_manifest_value dirty_fingerprint \
            "$bootstrap_stage3_verify_git_after"
    )
    rm -f "$bootstrap_stage3_verify_snapshot" \
        "$bootstrap_stage3_verify_git_before" \
        "$bootstrap_stage3_verify_git_after"
    [ "$(bootstrap_stage3_manifest_value source_file_count "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_count" ] || return 1
    [ "$(bootstrap_stage3_manifest_value source_fingerprint "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_sha" ] || return 1
    [ "$(bootstrap_stage3_manifest_value source_snapshot_sha256 "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_sha" ] || return 1
    [ "$(bootstrap_stage3_manifest_value git_state_sha256 \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_git_sha" ] || return 1
    [ "$(bootstrap_stage3_manifest_value git_head \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_git_head" ] || return 1
    [ "$(bootstrap_stage3_manifest_value git_dirty_fingerprint \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_git_dirty" ] || return 1

    bootstrap_stage3_backfill_status=$(
        bootstrap_stage3_manifest_value compiler_backfill_status \
            "$bootstrap_stage3_manifest"
    )
    bootstrap_stage3_backfill_path=$(
        bootstrap_stage3_manifest_value compiler_backfill_path \
            "$bootstrap_stage3_manifest"
    )
    bootstrap_stage3_backfill_sha=$(
        bootstrap_stage3_manifest_value compiler_backfill_sha256 \
            "$bootstrap_stage3_manifest"
    )
    case "$bootstrap_stage3_backfill_status" in
        present)
            case "$bootstrap_stage3_backfill_path" in
                "$bootstrap_stage3_runtime_dir/libsimple_compiler_backfill.a"|\
                "$bootstrap_stage3_runtime_dir/simple_compiler_backfill.lib") ;;
                *) return 1 ;;
            esac
            [ -f "$bootstrap_stage3_backfill_path" ] &&
                [ ! -L "$bootstrap_stage3_backfill_path" ] &&
                [ "$(bootstrap_stage3_canonical_file \
                    "$bootstrap_stage3_backfill_path")" = \
                    "$bootstrap_stage3_backfill_path" ] &&
                [ "$bootstrap_stage3_backfill_sha" = \
                    "$(bootstrap_stage3_hash_file "$bootstrap_stage3_backfill_path")" ] ||
                return 1
            ;;
        absent)
            case "$bootstrap_stage3_backfill_path" in
                "$bootstrap_stage3_runtime_dir/libsimple_compiler_backfill.a"|\
                "$bootstrap_stage3_runtime_dir/simple_compiler_backfill.lib") ;;
                *) return 1 ;;
            esac
            [ "$(bootstrap_stage3_canonical_path \
                "$bootstrap_stage3_backfill_path")" = \
                "$bootstrap_stage3_backfill_path" ] || return 1
            [ ! -e "$bootstrap_stage3_backfill_path" ] &&
                [ "$bootstrap_stage3_backfill_sha" = absent ] || return 1
            ;;
        *) return 1 ;;
    esac

    printf 'bootstrap_stage3_provenance_status=pass\n'
    printf 'bootstrap_stage3_compiler_path=%s\n' "$bootstrap_stage3_output"
}

bootstrap_stage2_native_binary() {
    bootstrap_stage2_native_path=$1
    bootstrap_stage2_native_platform=$2
    bootstrap_stage2_native_magic=$(
        od -An -tx1 -N4 "$bootstrap_stage2_native_path" |
            tr -d '[:space:]'
    ) || return 1
    case "$bootstrap_stage2_native_platform:$bootstrap_stage2_native_magic" in
        *-linux-*:*|*-freebsd:*|*-unknown-linux-*:*|*-unknown-freebsd:*)
            [ "$bootstrap_stage2_native_magic" = 7f454c46 ]
            ;;
        *-apple-darwin:feedfacf|*-apple-darwin:cffaedfe) return 0 ;;
        *-pc-windows-*:4d5a*) return 0 ;;
        *) return 1 ;;
    esac
}

bootstrap_stage2_verify_manifest() {
    bootstrap_stage2_manifest=$1
    bootstrap_stage2_root=$2
    bootstrap_stage2_expected_output=$3
    bootstrap_stage2_manifest_sha="${bootstrap_stage2_manifest}.sha256"
    [ "$(CDPATH= cd -- "$bootstrap_stage2_root" && pwd -P)" = \
        "$bootstrap_stage2_root" ] || return 1
    [ -f "$bootstrap_stage2_manifest" ] &&
        [ ! -L "$bootstrap_stage2_manifest" ] &&
        [ -f "$bootstrap_stage2_manifest_sha" ] &&
        [ ! -L "$bootstrap_stage2_manifest_sha" ] || return 1
    [ "$(bootstrap_stage3_canonical_file "$bootstrap_stage2_manifest")" = \
        "$bootstrap_stage2_manifest" ] &&
        [ "$(bootstrap_stage3_canonical_file "$bootstrap_stage2_manifest_sha")" = \
            "$bootstrap_stage2_manifest_sha" ] || return 1
    [ "$(awk 'NF { print; count += 1 } END { if (count != 1) exit 1 }' \
        "$bootstrap_stage2_manifest_sha")" = \
        "$(bootstrap_stage3_hash_file "$bootstrap_stage2_manifest")" ] ||
        return 1

    for bootstrap_stage2_key in schema status artifact_kind \
        checkpoint_status created_at_utc platform backend mode verbose \
        build_rust_log source_roots source_file_count source_fingerprint \
        source_before_path source_before_sha256 source_after_path \
        source_after_sha256 git_before_path git_before_sha256 git_after_path \
        git_after_sha256 git_head git_dirty_fingerprint tool_before_path \
        tool_before_sha256 tool_after_path tool_after_sha256 runtime_path \
        runtime_before_path runtime_before_sha256 runtime_after_path \
        runtime_after_sha256 seed_path seed_sha256 seed_inputs_fingerprint \
        seed_backend seed_features seed_inputs_stamp_path \
        seed_inputs_stamp_sha256 native_all_path native_all_sha256 \
        compiler_backfill_path compiler_backfill_status \
        compiler_backfill_sha256 stage2_path stage2_sha256 \
        stage2_admitted_path stage2_admitted_sha256 stage2_threads \
        stage2_command_output stage2_build_args_sha256 \
        stage2_command_transcript_path stage2_command_transcript_sha256 \
        stage2_build_log_path stage2_build_log_sha256 stage2_sanity_status \
        stage2_sanity_evidence_path stage2_sanity_evidence_sha256 \
        stage2_native_cache_dir stage2_cache_before_path \
        stage2_cache_before_sha256 stage2_cache_after_path \
        stage2_cache_after_sha256 bootstrap_script_path \
        bootstrap_script_sha256 provenance_helper_path \
        provenance_helper_sha256 provenance_helper_bundle_fingerprint \
        output_path output_sha256; do
        bootstrap_stage3_manifest_value "$bootstrap_stage2_key" \
            "$bootstrap_stage2_manifest" >/dev/null || return 1
    done
    [ "$(bootstrap_stage3_manifest_value schema \
        "$bootstrap_stage2_manifest")" = \
        simple-bootstrap-stage2-provenance-v1 ] &&
        [ "$(bootstrap_stage3_manifest_value status \
            "$bootstrap_stage2_manifest")" = pass ] &&
        [ "$(bootstrap_stage3_manifest_value artifact_kind \
            "$bootstrap_stage2_manifest")" = \
            pure-simple-stage2-bootstrap-compiler ] &&
        [ "$(bootstrap_stage3_manifest_value checkpoint_status \
            "$bootstrap_stage2_manifest")" = \
            source-git-tool-runtime-stable ] &&
        [ "$(bootstrap_stage3_manifest_value source_roots \
            "$bootstrap_stage2_manifest")" = \
            src/compiler:src/app:src/lib ] &&
        [ "$(bootstrap_stage3_manifest_value stage2_sanity_status \
            "$bootstrap_stage2_manifest")" = pass ] || return 1

    bootstrap_stage2_dir=$(
        CDPATH= cd -- "$(dirname -- "$bootstrap_stage2_manifest")" && pwd -P
    ) || return 1
    [ "$bootstrap_stage2_manifest" = \
        "$bootstrap_stage2_dir/stage2-provenance.env" ] &&
        [ "$bootstrap_stage2_expected_output" = \
            "$(bootstrap_stage3_manifest_value output_path \
                "$bootstrap_stage2_manifest")" ] &&
        [ "$bootstrap_stage2_expected_output" = \
            "$(bootstrap_stage3_manifest_value stage2_path \
                "$bootstrap_stage2_manifest")" ] &&
        [ "$bootstrap_stage2_expected_output" = \
            "$(bootstrap_stage3_manifest_value stage2_command_output \
                "$bootstrap_stage2_manifest")" ] || return 1
    [ -x "$bootstrap_stage2_expected_output" ] &&
        [ ! -L "$bootstrap_stage2_expected_output" ] &&
        [ "$(bootstrap_stage3_canonical_file \
            "$bootstrap_stage2_expected_output")" = \
            "$bootstrap_stage2_expected_output" ] || return 1
    bootstrap_stage2_expected_name=simple
    case "$(bootstrap_stage3_manifest_value platform \
        "$bootstrap_stage2_manifest")" in
        *windows*) bootstrap_stage2_expected_name=simple.exe ;;
    esac
    [ "$bootstrap_stage2_expected_output" = \
        "$bootstrap_stage2_dir/$bootstrap_stage2_expected_name" ] || return 1

    for bootstrap_stage2_path_key in source_before_path source_after_path \
        git_before_path git_after_path tool_before_path tool_after_path \
        runtime_before_path runtime_after_path seed_path \
        seed_inputs_stamp_path native_all_path stage2_path \
        stage2_admitted_path stage2_command_transcript_path \
        stage2_build_log_path stage2_sanity_evidence_path \
        stage2_cache_before_path stage2_cache_after_path \
        bootstrap_script_path provenance_helper_path output_path; do
        bootstrap_stage2_bound_path=$(
            bootstrap_stage3_manifest_value "$bootstrap_stage2_path_key" \
                "$bootstrap_stage2_manifest"
        ) || return 1
        [ -f "$bootstrap_stage2_bound_path" ] &&
            [ ! -L "$bootstrap_stage2_bound_path" ] &&
            [ "$(bootstrap_stage3_canonical_file \
                "$bootstrap_stage2_bound_path")" = \
                "$bootstrap_stage2_bound_path" ] || return 1
    done
    for bootstrap_stage2_hash_pair in \
        source_before source_after git_before git_after tool_before tool_after \
        runtime_before runtime_after seed seed_inputs_stamp native_all stage2 \
        stage2_admitted stage2_command_transcript stage2_build_log \
        stage2_sanity_evidence stage2_cache_before stage2_cache_after \
        bootstrap_script provenance_helper output; do
        bootstrap_stage2_bound_path=$(
            bootstrap_stage3_manifest_value \
                "${bootstrap_stage2_hash_pair}_path" \
                "$bootstrap_stage2_manifest"
        ) || return 1
        [ "$(bootstrap_stage3_manifest_value \
            "${bootstrap_stage2_hash_pair}_sha256" \
            "$bootstrap_stage2_manifest")" = \
            "$(bootstrap_stage3_hash_file "$bootstrap_stage2_bound_path")" ] ||
            return 1
    done
    cmp -s "$(bootstrap_stage3_manifest_value source_before_path \
        "$bootstrap_stage2_manifest")" \
        "$(bootstrap_stage3_manifest_value source_after_path \
            "$bootstrap_stage2_manifest")" &&
        cmp -s "$(bootstrap_stage3_manifest_value git_before_path \
            "$bootstrap_stage2_manifest")" \
            "$(bootstrap_stage3_manifest_value git_after_path \
                "$bootstrap_stage2_manifest")" &&
        cmp -s "$(bootstrap_stage3_manifest_value tool_before_path \
            "$bootstrap_stage2_manifest")" \
            "$(bootstrap_stage3_manifest_value tool_after_path \
                "$bootstrap_stage2_manifest")" &&
        cmp -s "$(bootstrap_stage3_manifest_value runtime_before_path \
            "$bootstrap_stage2_manifest")" \
            "$(bootstrap_stage3_manifest_value runtime_after_path \
                "$bootstrap_stage2_manifest")" || return 1
    [ "$(bootstrap_stage3_manifest_value source_fingerprint \
        "$bootstrap_stage2_manifest")" = \
        "$(bootstrap_stage3_manifest_value source_after_sha256 \
            "$bootstrap_stage2_manifest")" ] &&
        [ "$(bootstrap_stage3_manifest_value source_file_count \
            "$bootstrap_stage2_manifest")" = \
            "$(wc -l <"$(bootstrap_stage3_manifest_value source_after_path \
                "$bootstrap_stage2_manifest")" | tr -d ' ')" ] &&
        [ "$(bootstrap_stage3_manifest_value git_head \
            "$bootstrap_stage2_manifest")" = \
            "$(bootstrap_stage3_manifest_value head \
                "$(bootstrap_stage3_manifest_value git_after_path \
                    "$bootstrap_stage2_manifest")")" ] &&
        [ "$(bootstrap_stage3_manifest_value git_dirty_fingerprint \
            "$bootstrap_stage2_manifest")" = \
            "$(bootstrap_stage3_manifest_value dirty_fingerprint \
                "$(bootstrap_stage3_manifest_value git_after_path \
                    "$bootstrap_stage2_manifest")")" ] || return 1

    bootstrap_stage2_platform=$(
        bootstrap_stage3_manifest_value platform "$bootstrap_stage2_manifest"
    ) || return 1
    bootstrap_stage2_native_binary "$bootstrap_stage2_expected_output" \
        "$bootstrap_stage2_platform" || return 1
    bootstrap_stage2_backend=$(
        bootstrap_stage3_manifest_value backend "$bootstrap_stage2_manifest"
    ) || return 1
    bootstrap_stage2_mode=$(
        bootstrap_stage3_manifest_value mode "$bootstrap_stage2_manifest"
    ) || return 1
    bootstrap_stage2_verbose=$(
        bootstrap_stage3_manifest_value verbose "$bootstrap_stage2_manifest"
    ) || return 1
    bootstrap_stage2_threads=$(
        bootstrap_stage3_manifest_value stage2_threads \
            "$bootstrap_stage2_manifest"
    ) || return 1
    bootstrap_stage2_rust_log=$(
        bootstrap_stage3_manifest_value build_rust_log \
            "$bootstrap_stage2_manifest"
    ) || return 1
    [ "$bootstrap_stage2_platform" = "$(bootstrap_stage3_host_platform)" ] ||
        return 1
    case "$bootstrap_stage2_verbose" in 0|1) ;; *) return 1 ;; esac
    case "$bootstrap_stage2_threads" in ''|*[!0-9]*|0) return 1 ;; esac

    bootstrap_stage2_transcript=$(
        bootstrap_stage3_manifest_value stage2_command_transcript_path \
            "$bootstrap_stage2_manifest"
    ) || return 1
    bootstrap_stage2_transcript_dir=$(
        CDPATH= cd -- "$(dirname -- "$bootstrap_stage2_transcript")" && pwd -P
    ) || return 1
    bootstrap_stage2_link_library_path=
    bootstrap_stage2_link_compat_sha=absent
    if [ -f "$bootstrap_stage2_transcript_dir/link-compat/libunwind.so" ]; then
        bootstrap_stage2_link_library_path=\
"$bootstrap_stage2_transcript_dir/link-compat"
        bootstrap_stage2_link_compat_sha=$(
            bootstrap_stage3_hash_file \
                "$bootstrap_stage2_link_library_path/libunwind.so"
        ) || return 1
    fi
    bootstrap_stage2_seed=$(
        bootstrap_stage3_manifest_value seed_path "$bootstrap_stage2_manifest"
    ) || return 1
    bootstrap_stage2_cache=$(
        bootstrap_stage3_manifest_value stage2_native_cache_dir \
            "$bootstrap_stage2_manifest"
    ) || return 1
    bootstrap_stage2_runtime=$(
        bootstrap_stage3_manifest_value runtime_path "$bootstrap_stage2_manifest"
    ) || return 1
    for bootstrap_stage2_directory in "$bootstrap_stage2_cache" \
        "$bootstrap_stage2_runtime"; do
        [ -d "$bootstrap_stage2_directory" ] &&
            [ ! -L "$bootstrap_stage2_directory" ] &&
            [ "$(bootstrap_stage3_canonical_path \
                "$bootstrap_stage2_directory")" = \
                "$bootstrap_stage2_directory" ] || return 1
    done
    [ "$(bootstrap_stage3_manifest_value seed_path \
        "$bootstrap_stage2_manifest")" = \
        "$bootstrap_stage2_runtime/$bootstrap_stage2_expected_name" ] &&
        [ "$(bootstrap_stage3_manifest_value seed_inputs_stamp_path \
            "$bootstrap_stage2_manifest")" = \
            "$bootstrap_stage2_runtime/$bootstrap_stage2_expected_name.inputs.sha256" ] ||
        return 1
    case "$(bootstrap_stage3_manifest_value native_all_path \
        "$bootstrap_stage2_manifest")" in
        "$bootstrap_stage2_runtime/libsimple_native_all.a"|\
        "$bootstrap_stage2_runtime/simple_native_all.lib") ;;
        *) return 1 ;;
    esac
    [ "$(bootstrap_stage3_manifest_value stage2_admitted_path \
        "$bootstrap_stage2_manifest")" = \
        "$bootstrap_stage2_transcript_dir/stage2-admitted/$bootstrap_stage2_expected_name" ] &&
        [ "$(bootstrap_stage3_manifest_value stage2_sha256 \
            "$bootstrap_stage2_manifest")" = \
            "$(bootstrap_stage3_manifest_value stage2_admitted_sha256 \
                "$bootstrap_stage2_manifest")" ] &&
        [ "$(bootstrap_stage3_manifest_value output_sha256 \
            "$bootstrap_stage2_manifest")" = \
            "$(bootstrap_stage3_manifest_value stage2_sha256 \
                "$bootstrap_stage2_manifest")" ] || return 1
    bootstrap_stage2_output=$bootstrap_stage2_expected_output
    set -- "$bootstrap_stage2_seed" native-build \
        --target "$bootstrap_stage2_platform" \
        --backend "$bootstrap_stage2_backend" \
        --runtime-bundle core-c-bootstrap \
        --source src/compiler --source src/app --source src/lib \
        --entry-closure --threads "$bootstrap_stage2_threads"
    [ "$bootstrap_stage2_verbose" -eq 0 ] || set -- "$@" --verbose
    set -- "$@" --cache-dir "$bootstrap_stage2_cache" \
        --mode "$bootstrap_stage2_mode" \
        --entry src/app/cli/bootstrap_main.spl \
        --runtime-path "$bootstrap_stage2_runtime" -o "$bootstrap_stage2_output"
    bootstrap_stage3_verify_command_transcript "$bootstrap_stage2_transcript" \
        "$bootstrap_stage2_root" \
        "RUST_LOG=$bootstrap_stage2_rust_log" \
        "LIBRARY_PATH=$bootstrap_stage2_link_library_path" \
        "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage2_link_compat_sha" \
        "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
        "SIMPLE_NATIVE_BUILD_RUST=1" "SIMPLE_NO_STUB_FALLBACK=1" \
        "SIMPLE_NATIVE_ARENA_DECLS=1" \
        "SIMPLE_BINARY=$bootstrap_stage2_seed" -- "$@" || return 1
    shift
    bootstrap_stage2_expected_args=$(
        bootstrap_stage3_args_sha256 \
            "RUST_LOG=$bootstrap_stage2_rust_log" \
            "LIBRARY_PATH=$bootstrap_stage2_link_library_path" \
            "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage2_link_compat_sha" \
            "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
            "SIMPLE_NATIVE_BUILD_RUST=1" "SIMPLE_NO_STUB_FALLBACK=1" \
            "SIMPLE_NATIVE_ARENA_DECLS=1" \
            "SIMPLE_BINARY=$bootstrap_stage2_seed" \
            "$@"
    ) || return 1
    [ "$bootstrap_stage2_expected_args" = \
        "$(bootstrap_stage3_manifest_value stage2_build_args_sha256 \
            "$bootstrap_stage2_manifest")" ] || return 1

    bootstrap_stage3_verify_seed_stamp \
        "$(bootstrap_stage3_manifest_value seed_inputs_stamp_path \
            "$bootstrap_stage2_manifest")" \
        "$(bootstrap_stage3_manifest_value seed_inputs_fingerprint \
            "$bootstrap_stage2_manifest")" "$bootstrap_stage2_seed" \
        "$(bootstrap_stage3_manifest_value native_all_path \
            "$bootstrap_stage2_manifest")" \
        "$(bootstrap_stage3_manifest_value compiler_backfill_path \
            "$bootstrap_stage2_manifest")" || return 1
    bootstrap_stage2_backfill_path=$(
        bootstrap_stage3_manifest_value compiler_backfill_path \
            "$bootstrap_stage2_manifest"
    ) || return 1
    case "$bootstrap_stage2_backfill_path" in
        "$bootstrap_stage2_runtime/libsimple_compiler_backfill.a"|\
        "$bootstrap_stage2_runtime/simple_compiler_backfill.lib") ;;
        *) return 1 ;;
    esac
    case "$(bootstrap_stage3_manifest_value compiler_backfill_status \
        "$bootstrap_stage2_manifest")" in
        present)
            [ -f "$bootstrap_stage2_backfill_path" ] &&
                [ ! -L "$bootstrap_stage2_backfill_path" ] &&
                [ "$(bootstrap_stage3_manifest_value \
                    compiler_backfill_sha256 "$bootstrap_stage2_manifest")" = \
                    "$(bootstrap_stage3_hash_file \
                        "$bootstrap_stage2_backfill_path")" ] || return 1
            ;;
        absent)
            [ ! -e "$bootstrap_stage2_backfill_path" ] &&
                [ ! -L "$bootstrap_stage2_backfill_path" ] &&
                [ "$(bootstrap_stage3_manifest_value \
                    compiler_backfill_sha256 "$bootstrap_stage2_manifest")" = \
                    absent ] || return 1
            ;;
        *) return 1 ;;
    esac
    [ "$(bootstrap_stage3_manifest_value seed_backend \
        "$bootstrap_stage2_manifest")" = "$bootstrap_stage2_backend" ] ||
        return 1
    bootstrap_stage2_seed_inputs=$(
        bootstrap_stage3_seed_inputs_fingerprint "$bootstrap_stage2_root" \
            "$bootstrap_stage2_backend" \
            "$(bootstrap_stage3_manifest_value seed_features \
                "$bootstrap_stage2_manifest")" \
            "$(bootstrap_stage3_transcript_host_value \
                "$bootstrap_stage2_transcript" PATH)" \
            "$bootstrap_stage2_platform"
    ) || return 1
    [ "$bootstrap_stage2_seed_inputs" = \
        "$(bootstrap_stage3_manifest_value seed_inputs_fingerprint \
            "$bootstrap_stage2_manifest")" ] || return 1
    bootstrap_stage3_verify_sanity_evidence \
        "$(bootstrap_stage3_manifest_value stage2_sanity_evidence_path \
            "$bootstrap_stage2_manifest")" "$bootstrap_stage2_output" \
        "$bootstrap_stage2_root" "$bootstrap_stage2_backend" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage2_transcript" HOME)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage2_transcript" TMPDIR)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage2_transcript" PATH)" || return 1

    [ "$(bootstrap_stage3_manifest_value provenance_helper_bundle_fingerprint \
        "$bootstrap_stage2_manifest")" = \
        "$(bootstrap_stage3_helper_bundle_fingerprint)" ] || return 1
    [ "$(bootstrap_stage3_manifest_value bootstrap_script_path \
        "$bootstrap_stage2_manifest")" = \
        "$bootstrap_stage2_root/scripts/bootstrap/bootstrap-from-scratch.sh" ] &&
        [ "$(bootstrap_stage3_manifest_value provenance_helper_path \
            "$bootstrap_stage2_manifest")" = \
            "$bootstrap_stage2_root/scripts/check/lib/bootstrap-stage3-provenance.shs" ] ||
        return 1
    bootstrap_stage2_current_source="${bootstrap_stage2_manifest}.source.$$"
    bootstrap_stage2_current_git="${bootstrap_stage2_manifest}.git.$$"
    bootstrap_stage2_current_tool="${bootstrap_stage2_manifest}.tool.$$"
    bootstrap_stage2_current_runtime="${bootstrap_stage2_manifest}.runtime.$$"
    bootstrap_stage2_current_cache="${bootstrap_stage2_manifest}.cache.$$"
    bootstrap_stage3_source_snapshot "$bootstrap_stage2_current_source" \
        "$bootstrap_stage2_root" &&
        bootstrap_stage3_git_state "$bootstrap_stage2_root" \
            "$bootstrap_stage2_current_git" &&
        bootstrap_stage3_tool_authority_snapshot "$bootstrap_stage2_current_tool" \
            "$(bootstrap_stage3_transcript_host_value \
                "$bootstrap_stage2_transcript" PATH)" "$bootstrap_stage2_root" &&
        bootstrap_stage3_directory_snapshot "$bootstrap_stage2_current_runtime" \
            "$bootstrap_stage2_runtime" &&
        bootstrap_stage2_cache_snapshot "$bootstrap_stage2_current_cache" \
            "$bootstrap_stage2_cache" || {
        rm -f "$bootstrap_stage2_current_source" "$bootstrap_stage2_current_git" \
            "$bootstrap_stage2_current_tool" "$bootstrap_stage2_current_runtime" \
            "$bootstrap_stage2_current_cache"
        return 1
    }
    cmp -s "$bootstrap_stage2_current_source" \
        "$(bootstrap_stage3_manifest_value source_after_path \
            "$bootstrap_stage2_manifest")" &&
        cmp -s "$bootstrap_stage2_current_git" \
            "$(bootstrap_stage3_manifest_value git_after_path \
                "$bootstrap_stage2_manifest")" &&
        cmp -s "$bootstrap_stage2_current_tool" \
            "$(bootstrap_stage3_manifest_value tool_after_path \
                "$bootstrap_stage2_manifest")" &&
        cmp -s "$bootstrap_stage2_current_runtime" \
            "$(bootstrap_stage3_manifest_value runtime_after_path \
                "$bootstrap_stage2_manifest")" &&
        cmp -s "$bootstrap_stage2_current_cache" \
            "$(bootstrap_stage3_manifest_value stage2_cache_after_path \
                "$bootstrap_stage2_manifest")"
    bootstrap_stage2_current_status=$?
    rm -f "$bootstrap_stage2_current_source" "$bootstrap_stage2_current_git" \
        "$bootstrap_stage2_current_tool" "$bootstrap_stage2_current_runtime" \
        "$bootstrap_stage2_current_cache"
    return "$bootstrap_stage2_current_status"
}

# Focused negative contract used by the macOS GPU build wrapper. It exercises
# the provenance primitives without running a bootstrap or native build.
