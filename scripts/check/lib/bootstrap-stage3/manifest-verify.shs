        bootstrap_stage3_path_key=${bootstrap_stage3_rest%%:*}; bootstrap_stage3_sha_key=${bootstrap_stage3_rest#*:}
        [ "$(bootstrap_stage3_manifest_value "$bootstrap_stage3_path_key" "$bootstrap_stage3_manifest")" = "$(bootstrap_stage3_map_value "${bootstrap_stage3_role}_display")" ] || return 1
        [ "$(bootstrap_stage3_manifest_value "$bootstrap_stage3_sha_key" "$bootstrap_stage3_manifest")" = "$(bootstrap_stage3_map_value "${bootstrap_stage3_role}_sha256")" ] || return 1
    done
