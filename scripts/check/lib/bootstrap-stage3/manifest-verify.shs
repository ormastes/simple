    done
    bootstrap_stage3_manifest_a_failure_code=
    bootstrap_stage3_manifest_phase_emit B
    bootstrap_stage3_stage2_transcript=$(bootstrap_stage3_map_value stage2_command_transcript_authority) || return 1
    bootstrap_stage3_stage3_transcript=$(bootstrap_stage3_map_value stage3_command_transcript_authority) || return 1
    bootstrap_stage3_stage2_library_path=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage2_transcript" LIBRARY_PATH
    ) || return 1
    bootstrap_stage3_stage2_link_compat=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage2_transcript" \
            SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256
    ) || return 1
    bootstrap_stage3_stage2_progress=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage2_transcript" SIMPLE_BUILD_PROGRESS_EVENTS
    ) || return 1
    bootstrap_stage3_stage2_compile_stack_mib=$(
        bootstrap_stage3_transcript_argv_value_after \
            "$bootstrap_stage3_stage2_transcript" --compile-stack-mib
    ) || return 1
    case "$bootstrap_stage3_stage2_compile_stack_mib" in
        ''|*[!0-9]*|0) return 1 ;;
    esac
    bootstrap_stage3_stage2_timeout=$(
        bootstrap_stage3_transcript_argv_value_after \
            "$bootstrap_stage3_stage2_transcript" --timeout
    ) || return 1
    case "$bootstrap_stage3_stage2_timeout" in
        ''|*[!0-9]*) return 1 ;;
    esac
    bootstrap_stage3_stage3_library_path=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" LIBRARY_PATH
    ) || return 1
    bootstrap_stage3_stage3_link_compat=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" \
            SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256
    ) || return 1
    bootstrap_stage3_stage3_progress=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" SIMPLE_BUILD_PROGRESS_EVENTS
    ) || return 1
    bootstrap_stage3_stage3_profile=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" SIMPLE_COMPILER_PHASE_PROFILE_FILE
    ) || return 1
    bootstrap_stage3_stage3_memory=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" SIMPLE_MEM_SNAPSHOT_FILE
    ) || return 1
    bootstrap_stage3_stage3_evidence_run=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" SIMPLE_EVIDENCE_RUN_ID
    ) || return 1
    bootstrap_stage3_stage3_timeout=$(
        bootstrap_stage3_transcript_argv_value_after \
            "$bootstrap_stage3_stage3_transcript" --timeout
    ) || return 1
    case "$bootstrap_stage3_stage3_timeout" in
        ''|*[!0-9]*) return 1 ;;
    esac
    bootstrap_stage3_stage3_arena_decls=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" SIMPLE_NATIVE_ARENA_DECLS
    ) || return 1
    bootstrap_stage3_stage3_streaming=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" SIMPLE_STAGE3_STREAMING_SURFACES
    ) || return 1
    bootstrap_stage3_malloc_arena_max=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" MALLOC_ARENA_MAX
    ) || return 1
    bootstrap_stage3_malloc_trim_threshold=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" MALLOC_TRIM_THRESHOLD_
    ) || return 1
    bootstrap_stage3_expected_progress=\
"$bootstrap_stage3_manifest_output_root/bootstrap-build-progress.events"
    [ "$bootstrap_stage3_stage2_library_path" = \
        "$bootstrap_stage3_stage3_library_path" ] &&
        [ "$bootstrap_stage3_stage2_link_compat" = \
            "$bootstrap_stage3_stage3_link_compat" ] &&
        [ "$bootstrap_stage3_stage3_arena_decls" = 1 ] &&
        [ "$bootstrap_stage3_stage3_streaming" = 1 ] &&
        [ "$bootstrap_stage3_malloc_arena_max" = 2 ] &&
        [ "$bootstrap_stage3_malloc_trim_threshold" = 0 ] || return 1
    case "$bootstrap_stage3_stage2_progress" in
        ''|"$bootstrap_stage3_expected_progress") ;;
        *) bootstrap_stage3_provenance_fail "build-progress-path-outside-output-root"; return 1 ;;
    esac
    [ "$bootstrap_stage3_stage3_progress" = "$bootstrap_stage3_expected_progress" ] ||
        bootstrap_stage3_provenance_fail "build-progress-path-outside-output-root" ||
        return 1
    [ "$bootstrap_stage3_stage3_profile" = \
        "$bootstrap_stage3_manifest_dir/phase-profile-v1.events" ] &&
        [ "$bootstrap_stage3_stage3_memory" = \
            "$bootstrap_stage3_manifest_dir/memory-snapshot-v1.events" ] || return 1
    [ "$(bootstrap_stage3_transcript_host_value \
        "$bootstrap_stage3_stage3_transcript" HOME)" = \
        "$bootstrap_stage3_manifest_dir/stage3-home" ] &&
        [ "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage3_transcript" TMPDIR)" = \
            "$bootstrap_stage3_manifest_dir/stage3-tmp" ] || return 1
    bootstrap_stage3_expected_stage2_args=$(
        bootstrap_stage3_args_sha256 \
            "RUST_LOG=$bootstrap_stage3_rust_log" \
            "LIBRARY_PATH=$bootstrap_stage3_stage2_library_path" \
            "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage3_stage2_link_compat" \
            "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
            "SIMPLE_NATIVE_BUILD_RUST=1" \
            "SIMPLE_NO_STUB_FALLBACK=1" \
            "SIMPLE_BUILD_PROGRESS_EVENTS=$bootstrap_stage3_stage2_progress" \
            "SIMPLE_BINARY=$(bootstrap_stage3_map_value seed_display)" \
            native-build --target "$bootstrap_stage3_platform" \
            --backend "$bootstrap_stage3_backend" \
            --runtime-bundle core-c-bootstrap \
            --source src/compiler --source src/app --source src/lib \
            --entry-closure --threads "$bootstrap_stage3_stage2_threads" \
            --timeout "$bootstrap_stage3_stage2_timeout" \
            --compile-stack-mib "$bootstrap_stage3_stage2_compile_stack_mib" \
            --cache-dir "$(bootstrap_stage3_map_value stage2_native_cache_dir_display)" \
            --mode "$bootstrap_stage3_mode" \
            --entry src/app/cli/bootstrap_main.spl \
            --runtime-path "$(bootstrap_stage3_map_value runtime_path_display)" \
            -o "$(bootstrap_stage3_map_value stage2_display)"
    )
    [ "$(bootstrap_stage3_verify_value stage2_build_args_sha256 \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_stage2_args" ] || return 1
    bootstrap_stage3_seed_executable=$(bootstrap_stage3_map_value seed_display) || return 1
    bootstrap_stage3_verify_command_transcript \
        "$bootstrap_stage3_stage2_transcript" "$bootstrap_stage3_root" \
        "RUST_LOG=$bootstrap_stage3_rust_log" \
        "LIBRARY_PATH=$bootstrap_stage3_stage2_library_path" \
        "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage3_stage2_link_compat" \
        "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
        "SIMPLE_NATIVE_BUILD_RUST=1" "SIMPLE_NO_STUB_FALLBACK=1" \
        "SIMPLE_BUILD_PROGRESS_EVENTS=$bootstrap_stage3_stage2_progress" \
        "SIMPLE_BINARY=$bootstrap_stage3_seed_executable" -- \
        "$bootstrap_stage3_seed_executable" \
        native-build --target "$bootstrap_stage3_platform" \
        --backend "$bootstrap_stage3_backend" \
        --runtime-bundle core-c-bootstrap \
        --source src/compiler --source src/app --source src/lib \
        --entry-closure --threads "$bootstrap_stage3_stage2_threads" \
        --timeout "$bootstrap_stage3_stage2_timeout" \
        --compile-stack-mib "$bootstrap_stage3_stage2_compile_stack_mib" \
        --cache-dir "$(bootstrap_stage3_map_value stage2_native_cache_dir_display)" \
        --mode "$bootstrap_stage3_mode" \
        --entry src/app/cli/bootstrap_main.spl \
        --runtime-path "$(bootstrap_stage3_map_value runtime_path_display)" \
        -o "$(bootstrap_stage3_map_value stage2_display)" || { bootstrap_stage3_provenance_fail "manifest-stage-stage2-transcript"; return 1; }
    bootstrap_stage3_expected_stage3_args=$(
        bootstrap_stage3_args_sha256 \
            "RUST_LOG=$bootstrap_stage3_rust_log" \
            "LIBRARY_PATH=$bootstrap_stage3_stage3_library_path" \
            "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage3_stage3_link_compat" \
            "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
            "SIMPLE_STAGE3_STREAMING_SURFACES=$bootstrap_stage3_stage3_streaming" \
            "SIMPLE_FRONTEND_CACHE=0" \
            "MALLOC_ARENA_MAX=$bootstrap_stage3_malloc_arena_max" \
            "MALLOC_TRIM_THRESHOLD_=$bootstrap_stage3_malloc_trim_threshold" \
            "SIMPLE_NATIVE_ARENA_DECLS=$bootstrap_stage3_stage3_arena_decls" \
            "SIMPLE_NO_STUB_FALLBACK=1" \
            "SIMPLE_PACKAGE_INDEX_COLD_INIT=1" \
            "SIMPLE_BUILD_PROGRESS_EVENTS=$bootstrap_stage3_stage3_progress" \
            "SIMPLE_COMPILER_PHASE_PROFILE=1" \
            "SIMPLE_COMPILER_PHASE_PROFILE_FILE=$bootstrap_stage3_stage3_profile" \
            "SIMPLE_MEM_SNAPSHOT_FILE=$bootstrap_stage3_stage3_memory" \
            "SIMPLE_EVIDENCE_RUN_ID=$bootstrap_stage3_stage3_evidence_run" \
            "LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING=1" \
            "SIMPLE_NATIVE_BUILD_TARGET=$bootstrap_stage3_platform" \
            "SIMPLE_NATIVE_BUILD_THREADS=$bootstrap_stage3_stage3_threads" \
            "SIMPLE_NATIVE_BUILD_CACHE_DIR=$(bootstrap_stage3_map_value stage3_native_cache_dir_display)" \
            "SIMPLE_RUNTIME_PATH=$(bootstrap_stage3_map_value runtime_path_display)" \
            "SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap" \
            "SIMPLE_BINARY=$(bootstrap_stage3_map_value stage2_admitted_display)" \
            native-build --target "$bootstrap_stage3_platform" \
            --backend "$bootstrap_stage3_backend" \
            --runtime-bundle core-c-bootstrap \
            --threads "$bootstrap_stage3_stage3_threads" \
            --timeout "$bootstrap_stage3_stage3_timeout" \
            --cache-dir "$(bootstrap_stage3_map_value stage3_native_cache_dir_display)" \
            --mode "$bootstrap_stage3_mode" \
            --runtime-path "$(bootstrap_stage3_map_value runtime_path_display)" \
            -o "$bootstrap_stage3_expected_output_display" \
            src/app/cli/bootstrap_main.spl
    )
    [ "$(bootstrap_stage3_verify_value stage3_build_args_sha256 \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_stage3_args" ] || return 1
    bootstrap_stage3_stage2_executable_authority=$(bootstrap_stage3_map_value stage2_admitted_authority) || return 1
    bootstrap_stage3_stage2_executable_display=$(bootstrap_stage3_map_value stage2_admitted_display) || return 1
    bootstrap_stage3_verify_command_transcript \
        "$bootstrap_stage3_stage3_transcript" "$bootstrap_stage3_root" \
        "RUST_LOG=$bootstrap_stage3_rust_log" \
        "LIBRARY_PATH=$bootstrap_stage3_stage3_library_path" \
        "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage3_stage3_link_compat" \
        "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
        "SIMPLE_STAGE3_STREAMING_SURFACES=$bootstrap_stage3_stage3_streaming" \
        "SIMPLE_FRONTEND_CACHE=0" \
        "MALLOC_ARENA_MAX=$bootstrap_stage3_malloc_arena_max" \
        "MALLOC_TRIM_THRESHOLD_=$bootstrap_stage3_malloc_trim_threshold" \
        "SIMPLE_NATIVE_ARENA_DECLS=$bootstrap_stage3_stage3_arena_decls" \
        "SIMPLE_NO_STUB_FALLBACK=1" \
        "SIMPLE_PACKAGE_INDEX_COLD_INIT=1" \
        "SIMPLE_BUILD_PROGRESS_EVENTS=$bootstrap_stage3_stage3_progress" \
        "SIMPLE_COMPILER_PHASE_PROFILE=1" \
        "SIMPLE_COMPILER_PHASE_PROFILE_FILE=$bootstrap_stage3_stage3_profile" \
        "SIMPLE_MEM_SNAPSHOT_FILE=$bootstrap_stage3_stage3_memory" \
        "SIMPLE_EVIDENCE_RUN_ID=$bootstrap_stage3_stage3_evidence_run" \
        "LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING=1" \
        "SIMPLE_NATIVE_BUILD_TARGET=$bootstrap_stage3_platform" \
        "SIMPLE_NATIVE_BUILD_THREADS=$bootstrap_stage3_stage3_threads" \
        "SIMPLE_NATIVE_BUILD_CACHE_DIR=$(bootstrap_stage3_map_value stage3_native_cache_dir_display)" \
        "SIMPLE_RUNTIME_PATH=$(bootstrap_stage3_map_value runtime_path_display)" \
        "SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap" \
        "SIMPLE_BINARY=$bootstrap_stage3_stage2_executable_display" -- \
        "$bootstrap_stage3_stage2_executable_display" \
        native-build --target "$bootstrap_stage3_platform" \
        --backend "$bootstrap_stage3_backend" \
        --runtime-bundle core-c-bootstrap \
        --threads "$bootstrap_stage3_stage3_threads" \
        --timeout "$bootstrap_stage3_stage3_timeout" \
        --cache-dir "$(bootstrap_stage3_map_value stage3_native_cache_dir_display)" \
        --mode "$bootstrap_stage3_mode" \
        --runtime-path "$(bootstrap_stage3_map_value runtime_path_display)" \
        -o "$bootstrap_stage3_expected_output_display" \
        src/app/cli/bootstrap_main.spl || { bootstrap_stage3_provenance_fail "manifest-stage-stage3-transcript"; return 1; }
    bootstrap_stage3_manifest_phase_emit C

    bootstrap_stage3_output=$(bootstrap_stage3_map_value output_authority) || return 1
    [ "$(bootstrap_stage3_verify_value output_path "$bootstrap_stage3_manifest")" = "$bootstrap_stage3_expected_output_display" ] || return 1
    [ -x "$bootstrap_stage3_output" ] || return 1
    [ "$(bootstrap_stage3_verify_value output_sha256 "$bootstrap_stage3_manifest")" = \
        "$(bootstrap_stage3_hash_file "$bootstrap_stage3_output")" ] || return 1
    [ "$(bootstrap_stage3_verify_value stage3_path "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_output_display" ] || return 1
    [ "$(bootstrap_stage3_verify_value stage3_sha256 "$bootstrap_stage3_manifest")" = \
        "$(bootstrap_stage3_hash_file "$bootstrap_stage3_output")" ] || return 1

    for bootstrap_stage3_pair in \
        seed:seed_path:seed_sha256 native_all:native_all_path:native_all_sha256 \
        stage2:stage2_path:stage2_sha256 stage2_admitted:stage2_admitted_path:stage2_admitted_sha256 \
        stage2_build_log:stage2_build_log_path:stage2_build_log_sha256 \
        stage2_command_transcript:stage2_command_transcript_path:stage2_command_transcript_sha256 \
        stage2_sanity_evidence:stage2_sanity_evidence_path:stage2_sanity_evidence_sha256 \
        stage2_receiver_evidence:stage2_receiver_evidence_path:stage2_receiver_evidence_sha256 \
        stage2_admission_receipt:stage2_admission_receipt_path:stage2_admission_receipt_sha256 \
        stage3_build_log:stage3_build_log_path:stage3_build_log_sha256 \
        stage3_command_transcript:stage3_command_transcript_path:stage3_command_transcript_sha256 \
        stage3_sanity_evidence:stage3_sanity_evidence_path:stage3_sanity_evidence_sha256 \
        jobs_receipt:stage3_jobs_receipt_path:stage3_jobs_receipt_sha256 \
        git_state:git_state_path:git_state_sha256 bootstrap_script:bootstrap_script_path:bootstrap_script_sha256 \
        provenance_helper:provenance_helper_path:provenance_helper_sha256 \
        runtime_origin_snapshot:runtime_origin_snapshot_path:runtime_origin_snapshot_sha256 \
        runtime_admitted_snapshot:runtime_admitted_snapshot_path:runtime_admitted_snapshot_sha256 \
        tool_authority:tool_authority_path:tool_authority_sha256 \
        seed_inputs_stamp:seed_inputs_stamp_path:seed_inputs_stamp_sha256 \
        source_snapshot:source_snapshot_path:source_snapshot_sha256; do
        bootstrap_stage3_role=${bootstrap_stage3_pair%%:*}; bootstrap_stage3_rest=${bootstrap_stage3_pair#*:}
        bootstrap_stage3_path_key=${bootstrap_stage3_rest%%:*}; bootstrap_stage3_sha_key=${bootstrap_stage3_rest#*:}
        [ "$(bootstrap_stage3_verify_value "$bootstrap_stage3_path_key" "$bootstrap_stage3_manifest")" = "$(bootstrap_stage3_map_value "${bootstrap_stage3_role}_display")" ] || return 1
        [ "$(bootstrap_stage3_verify_value "$bootstrap_stage3_sha_key" "$bootstrap_stage3_manifest")" = "$(bootstrap_stage3_map_value "${bootstrap_stage3_role}_sha256")" ] || return 1
    done
    bootstrap_stage3_manifest_phase_emit D
    bootstrap_stage3_runtime_origin_snapshot=$(bootstrap_stage3_map_value runtime_origin_snapshot_authority) || return 1
    bootstrap_stage3_runtime_admitted_snapshot=$(bootstrap_stage3_map_value runtime_admitted_snapshot_authority) || return 1
    cmp -s "$bootstrap_stage3_runtime_origin_snapshot" \
        "$bootstrap_stage3_runtime_admitted_snapshot" || return 1
    bootstrap_stage3_runtime_verify_snapshot=\
"${TMPDIR:?}/stage3-runtime.verify.$bootstrap_stage3_local_pid"
    if [ "$bootstrap_stage3_portable_map" = 1 ]; then
        bootstrap_stage3_descriptor_read 6 "$bootstrap_stage3_runtime_binding" \
            directory-snapshot "$bootstrap_stage3_runtime_path" \
            "$bootstrap_stage3_runtime_verify_snapshot" || {
            bootstrap_stage3_provenance_fail "manifest-stage-runtime-snapshot"
            return 1
        }
    else
    bootstrap_stage3_directory_snapshot \
        "$bootstrap_stage3_runtime_verify_snapshot" \
        "$bootstrap_stage3_runtime_path" || { bootstrap_stage3_provenance_fail "manifest-stage-runtime-snapshot"; return 1; }
    fi
    cmp -s "$bootstrap_stage3_runtime_admitted_snapshot" \
        "$bootstrap_stage3_runtime_verify_snapshot" || {
        rm -f "$bootstrap_stage3_runtime_verify_snapshot"
        bootstrap_stage3_provenance_fail "manifest-stage-runtime-snapshot-mismatch"
        return 1
    }
    rm -f "$bootstrap_stage3_runtime_verify_snapshot"
    bootstrap_stage3_tool_authority_path=$(bootstrap_stage3_map_value tool_authority_authority) || return 1
    bootstrap_stage3_tool_verify=\
"${TMPDIR:?}/stage3-tools.verify.$bootstrap_stage3_local_pid"
    bootstrap_stage3_tool_authority_snapshot \
        "$bootstrap_stage3_tool_verify" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage2_transcript" PATH)" \
        "$bootstrap_stage3_root" || { bootstrap_stage3_provenance_fail "manifest-stage-tool-snapshot"; return 1; }
    cmp -s "$bootstrap_stage3_tool_authority_path" \
        "$bootstrap_stage3_tool_verify" || {
        # Clang-only policy (2026-09-24): bootstrap_stage3_tool_authority_snapshot
        # now names the C driver "clang" (previously "cc") and no longer lists a
        # separate "clang" tool entry. An admitted generation recorded BEFORE
        # this change will legitimately fail this byte-for-byte cmp even though
        # nothing on disk was tampered with -- the recorded snapshot still says
        # "tool=cc|...". Recognize that specific, expected transition and say so
        # plainly instead of leaving it as an unexplained mismatch: the fix is to
        # reseal (regenerate) the admitted authority under the new naming, not to
        # investigate for tampering.
        if grep -q '^tool=cc|' "$bootstrap_stage3_tool_authority_path" 2>/dev/null &&
            ! grep -q '^tool=cc|' "$bootstrap_stage3_tool_verify" 2>/dev/null; then
            echo "bootstrap Stage 3 provenance: NOTE — recorded tool authority" \
                "predates the 2026-09-24 clang-only policy (tool named 'cc'," \
                "not 'clang'); this is an expected invalidation, not tampering." \
                "Reseal by re-running Stage 3 admission for this generation so a" \
                "fresh tool_authority snapshot is recorded under the current" \
                "naming." >&2
        fi
        rm -f "$bootstrap_stage3_tool_verify"
        bootstrap_stage3_provenance_fail "manifest-stage-tool-snapshot-mismatch"
        return 1
    }
    rm -f "$bootstrap_stage3_tool_verify"
    bootstrap_stage3_manifest_phase_emit E
    bootstrap_stage3_seed_stamp=$(bootstrap_stage3_map_value seed_inputs_stamp_authority)
    bootstrap_stage3_seed_path=$(bootstrap_stage3_map_value seed_authority)
    bootstrap_stage3_native_all_path=$(bootstrap_stage3_map_value native_all_authority)
    bootstrap_stage3_seed_stamp_display=$(bootstrap_stage3_map_value seed_inputs_stamp_display) || return 1
    bootstrap_stage3_seed_display=$(bootstrap_stage3_map_value seed_display) || return 1
    bootstrap_stage3_native_all_display=$(bootstrap_stage3_map_value native_all_display) || return 1
    bootstrap_stage3_runtime_display=$(bootstrap_stage3_map_value runtime_path_display) || return 1
    for bootstrap_stage3_runtime_layout_display in \
        "$bootstrap_stage3_seed_stamp_display" "$bootstrap_stage3_seed_display" \
        "$bootstrap_stage3_native_all_display" "$bootstrap_stage3_runtime_display"; do
        bootstrap_stage3_normalized_absolute \
            "$bootstrap_stage3_runtime_layout_display" || return 1
    done
    case "$bootstrap_stage3_seed_display" in
        "$bootstrap_stage3_runtime_display/simple"|"$bootstrap_stage3_runtime_display/simple.exe") ;;
        *) return 1 ;;
    esac
    case "$bootstrap_stage3_native_all_display" in
        "$bootstrap_stage3_runtime_display/libsimple_native_all.a"|\
        "$bootstrap_stage3_runtime_display/simple_native_all.lib") ;;
        *) return 1 ;;
    esac
    [ "$bootstrap_stage3_seed_stamp_display" = \
        "${bootstrap_stage3_seed_display}.inputs.sha256" ] || return 1
    bootstrap_stage3_verify_seed_stamp "$bootstrap_stage3_seed_stamp" \
        "$(bootstrap_stage3_verify_value seed_inputs_fingerprint \
            "$bootstrap_stage3_manifest")" \
        "$bootstrap_stage3_seed_path" "$bootstrap_stage3_native_all_path" \
        "$(bootstrap_stage3_map_value compiler_backfill_authority)" || { bootstrap_stage3_provenance_fail "manifest-stage-seed-stamp"; return 1; }
    [ "$(bootstrap_stage3_verify_value seed_backend \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_backend" ] || return 1
    bootstrap_stage3_seed_features=$(
        bootstrap_stage3_verify_value seed_features \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_seed_authority_path=$(
        bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage2_transcript" PATH
    ) || return 1
    bootstrap_stage3_seed_fingerprint_rederived=$(
        bootstrap_stage3_seed_inputs_fingerprint "$bootstrap_stage3_root" \
            "$bootstrap_stage3_backend" "$bootstrap_stage3_seed_features" \
            "$bootstrap_stage3_seed_authority_path" \
            "$bootstrap_stage3_platform"
    ) || return 1
    [ "$bootstrap_stage3_seed_fingerprint_rederived" = \
        "$(bootstrap_stage3_verify_value seed_inputs_fingerprint \
            "$bootstrap_stage3_manifest")" ] ||
        bootstrap_stage3_provenance_fail \
            "seed-input-fingerprint-current-authority-mismatch" ||
        return 1

    bootstrap_stage3_stage2_sanity=$(bootstrap_stage3_map_value stage2_sanity_evidence_authority) || return 1
    bootstrap_stage3_stage2_sanity_authority=$bootstrap_stage3_stage2_sanity
    bootstrap_stage3_stage2_sanity_display=$(bootstrap_stage3_map_value stage2_sanity_evidence_display) || return 1
    bootstrap_stage3_stage2_sanity_companion_parent=$(bootstrap_stage3_map_value stage2_sanity_companion_parent_authority) || return 1
    bootstrap_stage3_stage2_receiver=$(bootstrap_stage3_map_value stage2_receiver_evidence_authority) || return 1
    bootstrap_stage3_stage2_admission=$(bootstrap_stage3_map_value stage2_admission_receipt_authority) || return 1
    bootstrap_stage3_stage3_sanity=$(bootstrap_stage3_map_value stage3_sanity_evidence_authority) || return 1
    bootstrap_stage3_stage3_sanity_display=$(bootstrap_stage3_map_value stage3_sanity_evidence_display) || return 1
    bootstrap_stage3_stage3_sanity_companion_parent=$(bootstrap_stage3_map_value stage3_sanity_companion_parent_authority) || return 1
    bootstrap_stage3_verify_sanity_evidence_receipt \
        "$bootstrap_stage3_stage2_sanity_authority" \
        "$bootstrap_stage3_stage2_sanity_display" \
        "$bootstrap_stage3_stage2_sanity_companion_parent" \
        "$bootstrap_stage3_stage2_executable_authority" \
        "$bootstrap_stage3_root" || { bootstrap_stage3_provenance_fail "manifest-stage-stage2-sanity"; return 1; }
    bootstrap_stage3_verify_receiver_evidence_receipt \
        "$bootstrap_stage3_stage2_receiver" "$(bootstrap_stage3_map_value stage2_receiver_evidence_display)" \
        "$bootstrap_stage3_stage2_executable_authority" "$bootstrap_stage3_stage2_executable_display" \
        "$bootstrap_stage3_runtime_admitted_snapshot" "$(bootstrap_stage3_map_value runtime_admitted_snapshot_display)" \
        "$(bootstrap_stage3_map_value stage2_receiver_log_authority)" "$(bootstrap_stage3_map_value stage2_receiver_log_display)" || { bootstrap_stage3_provenance_fail "manifest-stage-stage2-receiver"; return 1; }
    bootstrap_stage3_verify_stage2_admission_receipt \
        "$bootstrap_stage3_stage2_admission" "$(bootstrap_stage3_map_value stage2_admission_receipt_display)" \
        "$bootstrap_stage3_stage2_executable_authority" "$bootstrap_stage3_stage2_executable_display" \
        "$(bootstrap_stage3_map_value source_inputs_before_authority)" "$(bootstrap_stage3_map_value source_inputs_before_display)" \
        "$bootstrap_stage3_runtime_admitted_snapshot" "$(bootstrap_stage3_map_value runtime_admitted_snapshot_display)" \
        "$bootstrap_stage3_runtime_path" "$(bootstrap_stage3_map_value runtime_path_display)" \
        "$(bootstrap_stage3_map_value tool_authority_before_authority)" "$(bootstrap_stage3_map_value tool_authority_before_display)" \
        "$(bootstrap_stage3_verify_value stage2_build_args_sha256 \
            "$bootstrap_stage3_manifest")" \
        "$bootstrap_stage3_stage2_sanity_authority" \
        "$bootstrap_stage3_stage2_sanity_display" \
        "$bootstrap_stage3_stage2_sanity_companion_parent" \
        "$bootstrap_stage3_stage2_receiver" "$(bootstrap_stage3_map_value stage2_receiver_evidence_display)" \
        "$(bootstrap_stage3_map_value stage2_receiver_log_authority)" "$(bootstrap_stage3_map_value stage2_receiver_log_display)" \
        "$bootstrap_stage3_root" || { bootstrap_stage3_provenance_fail "manifest-stage-stage2-admission"; return 1; }
    bootstrap_stage3_expected_admission_identity=$(
        bootstrap_stage3_stage2_admission_identity \
            "$(bootstrap_stage3_hash_file \
                "$bootstrap_stage3_stage2_executable_authority")" \
            "$(bootstrap_stage3_verify_value source_snapshot_sha256 \
                "$bootstrap_stage3_manifest")" \
            "$(bootstrap_stage3_verify_value \
                runtime_admitted_snapshot_sha256 \
                "$bootstrap_stage3_manifest")" \
            "$(bootstrap_stage3_verify_value tool_authority_sha256 \
                "$bootstrap_stage3_manifest")" \
            "$(bootstrap_stage3_verify_value stage2_build_args_sha256 \
                "$bootstrap_stage3_manifest")" \
            "$(bootstrap_stage3_verify_value \
                stage2_sanity_evidence_sha256 \
                "$bootstrap_stage3_manifest")" \
            "$(bootstrap_stage3_verify_value \
                stage2_receiver_evidence_sha256 \
                "$bootstrap_stage3_manifest")" \
            "$(bootstrap_stage3_verify_value \
                hosted_runtime_relative_path \
                "$bootstrap_stage3_stage2_admission")" \
            "$(bootstrap_stage3_verify_value hosted_runtime_sha256 \
                "$bootstrap_stage3_stage2_admission")"
    ) || { bootstrap_stage3_provenance_fail "manifest-stage-admission-identity-derive"; return 1; }
    [ "$(bootstrap_stage3_verify_value stage2_admission_identity \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_admission_identity" ] || { bootstrap_stage3_provenance_fail "manifest-stage-admission-identity-manifest"; return 1; }
    [ "$(bootstrap_stage3_verify_value admission_identity \
        "$bootstrap_stage3_stage2_admission")" = \
        "$bootstrap_stage3_expected_admission_identity" ] || { bootstrap_stage3_provenance_fail "manifest-stage-admission-identity-receipt"; return 1; }
    bootstrap_stage3_manifest_phase_emit F
    bootstrap_stage3_verify_sanity_evidence \
        "$bootstrap_stage3_stage3_sanity" \
        "$bootstrap_stage3_stage3_sanity_display" \
        "$bootstrap_stage3_stage3_sanity_companion_parent" \
        "$bootstrap_stage3_output" \
        "$bootstrap_stage3_root" "$bootstrap_stage3_backend" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage3_transcript" HOME)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage3_transcript" TMPDIR)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage3_transcript" PATH)" || { bootstrap_stage3_provenance_fail "manifest-stage-stage3-replay"; return 1; }
    bootstrap_stage3_manifest_phase_emit G

    bootstrap_stage3_recorded_lock=$(
        bootstrap_stage3_verify_value bootstrap_lock_path \
            "$bootstrap_stage3_manifest"
    ) || return 1
    [ "$bootstrap_stage3_recorded_lock" = \
        "${bootstrap_stage3_manifest_output_root}.lock" ] || return 1
    [ "$(bootstrap_stage3_canonical_path "$bootstrap_stage3_recorded_lock")" = \
        "$bootstrap_stage3_recorded_lock" ] || return 1
    bootstrap_stage3_recorded_lock_pid=$(
        bootstrap_stage3_verify_value bootstrap_lock_owner_pid \
            "$bootstrap_stage3_manifest"
    ) || return 1
    case "$bootstrap_stage3_recorded_lock_pid" in
        ''|*[!0-9]*|0) return 1 ;;
    esac

    if [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" != 1 ]; then
        bootstrap_stage3_verify_git_before="${TMPDIR:?}/stage3-git.verify.before.$bootstrap_stage3_local_pid"
        bootstrap_stage3_git_state "$bootstrap_stage3_root" \
            "$bootstrap_stage3_verify_git_before" || return 1
    fi
    bootstrap_stage3_verify_snapshot="${TMPDIR:?}/stage3-source.verify.$bootstrap_stage3_local_pid"
    if [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" = 1 ]; then
        cp -- "$bootstrap_stage3_parent_source" \
            "$bootstrap_stage3_verify_snapshot" || {
            bootstrap_stage3_provenance_fail "descriptor-source-copy-failed"
            return 1
        }
    else
        bootstrap_stage3_source_snapshot "$bootstrap_stage3_verify_snapshot" \
            "$bootstrap_stage3_root" || return 1
    fi
    bootstrap_stage3_current_count=$(
        wc -l <"$bootstrap_stage3_verify_snapshot" | tr -d ' '
    ) || {
        bootstrap_stage3_provenance_fail "descriptor-source-count-failed"
        return 1
    }
    bootstrap_stage3_current_sha=$(
        bootstrap_stage3_hash_file "$bootstrap_stage3_verify_snapshot"
    ) || {
        bootstrap_stage3_provenance_fail "descriptor-source-hash-failed"
        return 1
    }
    if [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" = 1 ]; then
        bootstrap_stage3_captured_git=$(bootstrap_stage3_map_value git_state_authority) || { bootstrap_stage3_provenance_fail "manifest-stage-parent-git-map"; return 1; }
        [ "$(wc -l <"$bootstrap_stage3_captured_git" | tr -d ' ')" = 2 ] || { bootstrap_stage3_provenance_fail "manifest-stage-parent-git-map-shape"; return 1; }
        [ "$(sed 's/=.*//' "$bootstrap_stage3_captured_git" | tr '\n' ' ')" = \
            'head dirty_fingerprint ' ] || { bootstrap_stage3_provenance_fail "manifest-stage-parent-git-map-schema"; return 1; }
        bootstrap_stage3_current_git_sha=$(bootstrap_stage3_hash_file \
            "$bootstrap_stage3_captured_git") || return 1
        [ "$bootstrap_stage3_current_git_sha" = \
            "$(bootstrap_stage3_map_value git_state_sha256)" ] || { bootstrap_stage3_provenance_fail "manifest-stage-parent-git-map-hash"; return 1; }
        [ "$bootstrap_stage3_current_git_sha" = \
            "$(bootstrap_stage3_hash_file "$bootstrap_stage3_parent_git")" ] || { bootstrap_stage3_provenance_fail "manifest-stage-parent-git-external-hash"; return 1; }
        [ "$(wc -l <"$bootstrap_stage3_parent_git" | tr -d ' ')" = 2 ] || { bootstrap_stage3_provenance_fail "manifest-stage-parent-git-external-shape"; return 1; }
        [ "$(sed 's/=.*//' "$bootstrap_stage3_parent_git" | tr '\n' ' ')" = \
            'head dirty_fingerprint ' ] || { bootstrap_stage3_provenance_fail "manifest-stage-parent-git-external-schema"; return 1; }
        bootstrap_stage3_current_git_head=$(bootstrap_stage3_verify_value \
            head "$bootstrap_stage3_captured_git") || return 1
        bootstrap_stage3_current_git_dirty=$(bootstrap_stage3_verify_value \
            dirty_fingerprint "$bootstrap_stage3_captured_git") || return 1
    else
        bootstrap_stage3_verify_git_after="${TMPDIR:?}/stage3-git.verify.after.$bootstrap_stage3_local_pid"
        bootstrap_stage3_git_state "$bootstrap_stage3_root" \
            "$bootstrap_stage3_verify_git_after" || {
            rm -f "$bootstrap_stage3_verify_snapshot" \
                "$bootstrap_stage3_verify_git_before"
            return 1
        }
        cmp -s "$bootstrap_stage3_verify_git_before" \
            "$bootstrap_stage3_verify_git_after" || {
            rm -f "$bootstrap_stage3_verify_snapshot" \
                "$bootstrap_stage3_verify_git_before" \
                "$bootstrap_stage3_verify_git_after"
            return 1
        }
        bootstrap_stage3_current_git_sha=$(bootstrap_stage3_hash_file \
            "$bootstrap_stage3_verify_git_after") || return 1
        bootstrap_stage3_current_git_head=$(bootstrap_stage3_verify_value \
            head "$bootstrap_stage3_verify_git_after") || return 1
        bootstrap_stage3_current_git_dirty=$(bootstrap_stage3_verify_value \
            dirty_fingerprint "$bootstrap_stage3_verify_git_after") || return 1
        rm -f "$bootstrap_stage3_verify_git_before" \
            "$bootstrap_stage3_verify_git_after"
    fi
    rm -f "$bootstrap_stage3_verify_snapshot"
    [ "$(bootstrap_stage3_verify_value source_file_count "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_count" ] || {
        bootstrap_stage3_provenance_fail "descriptor-source-count-mismatch"
        return 1
    }
    [ "$(bootstrap_stage3_verify_value source_fingerprint "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_sha" ] || {
        bootstrap_stage3_provenance_fail "descriptor-source-fingerprint-mismatch"
        return 1
    }
    [ "$(bootstrap_stage3_verify_value source_snapshot_sha256 "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_sha" ] || {
        bootstrap_stage3_provenance_fail "descriptor-source-manifest-hash-mismatch"
        return 1
    }
    if [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" = 1 ]; then
        [ "$bootstrap_stage3_current_sha" = \
            "$(bootstrap_stage3_map_value source_inputs_before_sha256)" ] &&
            [ "$bootstrap_stage3_current_sha" = \
                "$(bootstrap_stage3_map_value source_snapshot_sha256)" ] || {
            bootstrap_stage3_provenance_fail "descriptor-source-map-hash-mismatch"
            return 1
        }
    fi
    [ "$(bootstrap_stage3_verify_value git_state_sha256 \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_git_sha" ] || return 1
    [ "$(bootstrap_stage3_verify_value git_head \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_git_head" ] || return 1
    [ "$(bootstrap_stage3_verify_value git_dirty_fingerprint \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_git_dirty" ] || return 1
    bootstrap_stage3_manifest_phase_emit H

    bootstrap_stage3_backfill_status=$(
        bootstrap_stage3_verify_value compiler_backfill_status \
            "$bootstrap_stage3_manifest"
    )
    bootstrap_stage3_backfill_path=$(bootstrap_stage3_map_value compiler_backfill_authority)
    bootstrap_stage3_backfill_display=$(bootstrap_stage3_map_value compiler_backfill_display)
    bootstrap_stage3_backfill_sha=$(
        bootstrap_stage3_verify_value compiler_backfill_sha256 \
            "$bootstrap_stage3_manifest"
    )
    case "$bootstrap_stage3_backfill_status" in
        present)
            bootstrap_stage3_normalized_absolute \
                "$bootstrap_stage3_backfill_display" || return 1
            case "$bootstrap_stage3_backfill_display" in
                "$bootstrap_stage3_runtime_display/libsimple_compiler_backfill.a"|\
                "$bootstrap_stage3_runtime_display/simple_compiler_backfill.lib") ;;
                *) bootstrap_stage3_provenance_fail "backfill-display-layout-mismatch"; return 1 ;;
            esac
            bootstrap_stage3_sanity_regular_authority \
                "$bootstrap_stage3_backfill_path" &&
                [ "$bootstrap_stage3_backfill_sha" = \
                    "$(bootstrap_stage3_hash_file "$bootstrap_stage3_backfill_path")" ] ||
                bootstrap_stage3_provenance_fail "backfill-authority-content-mismatch"
                return 1
            ;;
        absent)
            [ "$bootstrap_stage3_backfill_path" = descriptor-absent ] &&
                [ "$bootstrap_stage3_backfill_sha" = absent ] || {
                bootstrap_stage3_provenance_fail "backfill-absent-binding-mismatch"
                return 1
            }
            ;;
        *) bootstrap_stage3_provenance_fail "backfill-status-invalid"; return 1 ;;
    esac

    bootstrap_stage3_manifest_phase_emit I
    printf 'bootstrap_stage3_provenance_status=pass\n'
    printf 'bootstrap_stage3_compiler_path=%s\n' "$bootstrap_stage3_output"
}

# Public verification is deliberately process-scoped: the implementation pins
# immutable inputs on FDs 6-9, and must never close or replace descriptors held
# by a sourced caller.
bootstrap_stage3_verify_manifest() (
    bootstrap_stage3_bound_map_snapshot=
    bootstrap_stage3_bound_map_snapshot_owned=0
    bootstrap_stage3_manifest_snapshot=
    bootstrap_stage3_manifest_snapshot_owned=0
    bootstrap_stage3_manifest_a_failure_code=
    if bootstrap_stage3_verify_manifest_impl "$@"; then
        bootstrap_stage3_verify_manifest_status=0
    else
        bootstrap_stage3_verify_manifest_status=$?
    fi
    if [ "$bootstrap_stage3_verify_manifest_status" -ne 0 ] &&
        [ -n "${bootstrap_stage3_manifest_a_failure_code:-}" ]; then
        case "$bootstrap_stage3_manifest_a_failure_code" in
            [0-9A-V][0-9A-V])
                bootstrap_stage3_manifest_phase_emit \
                    "a$bootstrap_stage3_manifest_a_failure_code" ;;
            l[0-9A-V][0-9A-V])
                bootstrap_stage3_manifest_phase_emit \
                    "$bootstrap_stage3_manifest_a_failure_code" ;;
            *) : ;;
        esac
    fi
    exec 9<&- 2>/dev/null || :
    exec 7<&- 2>/dev/null || :
    exec 6<&- 2>/dev/null || :
    exec 8<&- 2>/dev/null || :
    if [ "${bootstrap_stage3_bound_map_snapshot_owned:-0}" = 1 ] &&
        [ -n "${bootstrap_stage3_bound_map_snapshot:-}" ]; then
        rm -f -- "$bootstrap_stage3_bound_map_snapshot" 2>/dev/null || :
    fi
    if [ "${bootstrap_stage3_manifest_snapshot_owned:-0}" = 1 ] &&
        [ -n "${bootstrap_stage3_manifest_snapshot:-}" ]; then
        rm -f -- "$bootstrap_stage3_manifest_snapshot" 2>/dev/null || :
    fi
    return "$bootstrap_stage3_verify_manifest_status"
)

# Focused negative contract used by the macOS GPU build wrapper. It exercises
# the provenance primitives without running a bootstrap or native build.
