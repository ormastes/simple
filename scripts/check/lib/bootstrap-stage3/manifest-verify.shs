# v5 focused invocations are reconstructed from bound manifest inputs. v4 keeps
# the legacy descriptor-candidate recipe below; never infer the route from argv.
bootstrap_stage3_focused_compositions_verify() {
    [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" = 0 ] || return 1
    bsfc_policy=$(bootstrap_stage3_verify_value focused_k1_policy "$bootstrap_stage3_manifest") || return 1
    case "$bsfc_policy" in
        llvm-cranelift) bsfc_k1="$bootstrap_stage3_root/src/compositions/kernel_llvm_cranelift" ;;
        llvm) bsfc_k1="$bootstrap_stage3_root/src/compositions/kernel_llvm" ;;
        *) return 1 ;;
    esac
    bsfc_manifest="$bootstrap_stage3_root/src/compiler/simple.sdn"
    bsfc_cuda_enabled=$(bootstrap_stage3_focused_cuda_setting enabled) || return 1
    bsfc_cuda_placement=$(bootstrap_stage3_focused_cuda_setting placement) || return 1
    case "$bsfc_cuda_enabled:$bsfc_cuda_placement" in
        true:static) bsfc_template="$bootstrap_stage3_root/src/plugins/backend_registry/selected_cuda_backend.spl" ;;
        true:dynamic) bsfc_template="$bootstrap_stage3_root/src/compositions/cuda_dynamic/plugins/backend_registry/selected_cuda_backend.spl" ;;
        false:static|false:dynamic) bsfc_template="$bootstrap_stage3_root/src/compositions/cuda_disabled/plugins/backend_registry/selected_cuda_backend.spl" ;;
        *) return 1 ;;
    esac
    # The builder compiles from the repo composition dir (cuda_<mode>);
    # the generated overlay below only pins the backend-selection content.
    case "$bsfc_cuda_enabled:$bsfc_cuda_placement" in
        true:static) bsfc_cuda_mode=static ;;
        true:dynamic) bsfc_cuda_mode=dynamic ;;
        false:static|false:dynamic) bsfc_cuda_mode=disabled ;;
        *) return 1 ;;
    esac
    bsfc_manifest_sha=$(bootstrap_stage3_verify_value focused_cuda_manifest_sha256 "$bootstrap_stage3_manifest") || return 1
    bsfc_template_sha=$(bootstrap_stage3_verify_value focused_cuda_template_sha256 "$bootstrap_stage3_manifest") || return 1
    bsfc_cuda="$bootstrap_stage3_manifest_output_root/compositions/cuda-$bsfc_manifest_sha-$bsfc_template_sha"
    # The generated root is a single-file overlay. A matching selector cannot
    # authorize additional stale or injected modules under that source root.
    [ "$(find "$bsfc_cuda" ! -type d -print 2>/dev/null)" = \
        "$bsfc_cuda/plugins/backend_registry/selected_cuda_backend.spl" ] || return 1
    for bsfc_binding in \
        "focused_k1_sha256:$bsfc_k1/compiler/driver/bootstrap_k1_selected.spl" \
        "focused_cuda_manifest_sha256:$bsfc_manifest" \
        "focused_cuda_template_sha256:$bsfc_template" \
        "focused_cuda_template_sha256:$bsfc_cuda/plugins/backend_registry/selected_cuda_backend.spl" \
        "focused_k1_receipt_sha256:$bootstrap_stage3_manifest_output_root/logs/$bootstrap_stage3_platform/stage2-stage3-k1-composition.env"; do
        bsfc_key=${bsfc_binding%%:*}; bsfc_file=${bsfc_binding#*:}
        bsfc_sha=$(bootstrap_stage3_verify_value "$bsfc_key" "$bootstrap_stage3_manifest") || return 1
        printf '%s\n' "$bsfc_sha" | grep -Eq '^[0-9a-f]{64}$' || return 1
        [ -f "$bsfc_file" ] && [ ! -L "$bsfc_file" ] &&
            [ "$(bootstrap_stage3_canonical_path "$bsfc_file")" = "$bsfc_file" ] &&
            [ "$(bootstrap_stage3_hash_file "$bsfc_file")" = "$bsfc_sha" ] || return 1
    done
    bsfc_k1_receipt="$bootstrap_stage3_manifest_output_root/logs/$bootstrap_stage3_platform/stage2-stage3-k1-composition.env"
    [ "$(bootstrap_stage3_manifest_value schema "$bsfc_k1_receipt")" = simple-bootstrap-k1-composition-receipt-v1 ] &&
        [ "$(bootstrap_stage3_manifest_value status "$bsfc_k1_receipt")" = pass ] &&
        [ "$(bootstrap_stage3_manifest_value policy "$bsfc_k1_receipt")" = "$bsfc_policy" ] &&
        [ "$(bootstrap_stage3_manifest_value selected_composition_sha256 "$bsfc_k1_receipt")" = "$(bootstrap_stage3_verify_value focused_k1_sha256 "$bootstrap_stage3_manifest")" ] || return 1
    for bsfc_phase in stage2 stage3; do
        [ "$(bootstrap_stage3_manifest_value "${bsfc_phase}_transcript_sha256" "$bsfc_k1_receipt")" = "$(bootstrap_stage3_map_value "${bsfc_phase}_command_transcript_sha256")" ] &&
            [ "$(bootstrap_stage3_manifest_value "${bsfc_phase}_log_sha256" "$bsfc_k1_receipt")" = "$(bootstrap_stage3_map_value "${bsfc_phase}_build_log_sha256")" ] || return 1
    done
}

bootstrap_stage3_focused_cuda_setting() {
    awk -v key="$1" '
        /^compiler_backends:[[:space:]]*$/ { section=1; next }
        /^[^[:space:]#]/ { section=0; cuda=0 }
        section && /^  cuda:[[:space:]]*$/ { cuda=1; next }
        section && /^  [^[:space:]#]/ { cuda=0 }
        section && cuda && $1 == key ":" { count++; value=$2 }
        END { if (count != 1 || value == "") exit 1; print value }
    ' "$bsfc_manifest"
}

# action=hash excludes the executable; action=transcript retains the exact
# env/argv separation expected by the existing byte-for-byte transcript checker.
bootstrap_stage3_focused_command() (
    bsfc_action=$1; bsfc_phase=$2
    case "$bsfc_phase" in stage2|stage3) ;; *) return 1 ;; esac
    bsfc_transcript=$(bootstrap_stage3_map_value "${bsfc_phase}_command_transcript_authority") || return 1
    bsfc_cache=$(bootstrap_stage3_map_value "${bsfc_phase}_native_cache_dir_display") || return 1
    bsfc_runtime=$(bootstrap_stage3_map_value runtime_path_display) || return 1
    bsfc_jobs=$(bootstrap_stage3_verify_value "${bsfc_phase}_threads" "$bootstrap_stage3_manifest") || return 1
    bsfc_admission=$(bootstrap_stage3_map_value stage2_admission_receipt_display) || return 1
    bsfc_compat="$bootstrap_stage3_stage2_output_display/stage3/$bootstrap_stage3_platform/phase2-compatibility.manifest"
    bsfc_low=$(bootstrap_stage3_verify_value focused_low_memory "$bootstrap_stage3_manifest") || return 1
    case "$bsfc_low" in 0|1) ;; *) return 1 ;; esac
    set --
    # Frontend shard rows are prepended by run_transcribed AFTER the builder's
    # env-name check and ARE part of the recorded command. Replay them first,
    # in recorded order, from the transcript (recorded authority, cold-init
    # precedent). Non-Windows transcripts lack them; skip quietly.
    for bsfc_frontend_name in SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB \
            SIMPLE_HIR_SHARD_WORKER_KB SIMPLE_PARSE_SHARD_WORKER_KB \
            SIMPLE_PARSE_SHARD_MAX SIMPLE_SHARD_MEM_CLAMP; do
        if bsfc_frontend_value=$(bootstrap_stage3_transcript_explicit_env_value \
                "$bsfc_transcript" "$bsfc_frontend_name" 2>/dev/null); then
            set -- "$@" "$bsfc_frontend_name=$bsfc_frontend_value"
        fi
    done
    if [ "$bsfc_phase" = stage2 ]; then
        for bsfc_name in SIMPLE_LLVM_BIN SIMPLE_LLVM_PATH MIMALLOC_EAGER_COMMIT; do
            bsfc_value=$(bootstrap_stage3_transcript_explicit_env_value "$bsfc_transcript" "$bsfc_name") || return 1
            set -- "$@" "$bsfc_name=$bsfc_value"
        done
        set -- "$@" MIMALLOC_ARENA_EAGER_COMMIT=0 MIMALLOC_PURGE_DELAY=0 MIMALLOC_PURGE_DECOMMITS=1 \
            "LLVM_SYS_231_PREFIX=$(bootstrap_stage3_transcript_explicit_env_value "$bsfc_transcript" LLVM_SYS_231_PREFIX)" \
            "PATH=$(bootstrap_stage3_transcript_host_value "$bsfc_transcript" PATH)"
    fi
    set -- "$@" "RUST_LOG=$bootstrap_stage3_rust_log" \
        "LIBRARY_PATH=$(bootstrap_stage3_transcript_explicit_env_value "$bsfc_transcript" LIBRARY_PATH)" \
        "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$(bootstrap_stage3_transcript_explicit_env_value "$bsfc_transcript" SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256)" \
        SIMPLE_BOOTSTRAP=1
    [ "$bsfc_phase" != stage3 ] || set -- "$@" SIMPLE_BOOTSTRAP_STAGE3=1
    set -- "$@" SIMPLE_ABI_POLICY=v1
    [ "$bsfc_phase" != stage3 ] || set -- "$@" "SIMPLE_ABI_ADMISSION_RECEIPT=$bsfc_admission"
    set -- "$@" SIMPLE_PLUGIN_MANIFEST_POLICY=simple-sdn "SIMPLE_KERNEL_K1_POLICY=$bsfc_policy" \
        SIMPLE_COVERAGE_CUTOVER_STATE=atomic-apk-only \
        "SIMPLE_K1_COMPOSITION_SHA256_BEFORE=$(bootstrap_stage3_verify_value focused_k1_sha256 "$bootstrap_stage3_manifest")" \
        SIMPLE_NO_DEPRECATED_WARNINGS=1
    if [ "$bsfc_phase" = stage2 ]; then
        bsfc_compiler=$(bootstrap_stage3_map_value seed_display) || return 1
        set -- "$@" SIMPLE_NATIVE_BUILD_RUST=1 SIMPLE_NO_STUB_FALLBACK=1 \
            "SIMPLE_BUILD_PROGRESS_EVENTS=$(bootstrap_stage3_transcript_explicit_env_value "$bsfc_transcript" SIMPLE_BUILD_PROGRESS_EVENTS)"
    else
        bsfc_compiler=$(bootstrap_stage3_map_value stage2_admitted_display) || return 1
        set -- "$@" SIMPLE_STAGE3_STREAMING_SURFACES=0 \
            "SIMPLE_KEEP_SOURCE_CONTENTS=$(bootstrap_stage3_transcript_explicit_env_value "$bsfc_transcript" SIMPLE_KEEP_SOURCE_CONTENTS)" \
            "SIMPLE_MIR_TAG_PROBE=$(bootstrap_stage3_transcript_explicit_env_value "$bsfc_transcript" SIMPLE_MIR_TAG_PROBE)"
    fi
    set -- "$@" SIMPLE_FRONTEND_CACHE=1 "SIMPLE_FRONTEND_CACHE_DIR=$bsfc_cache/frontend" \
        SIMPLE_HIR_CACHE=1 "SIMPLE_HIR_CACHE_DIR=$bsfc_cache/hir"
    if [ "$bsfc_phase" = stage2 ]; then
        case "$bootstrap_stage3_platform" in *apple-darwin*)
            for bsfc_name in CC CXX AR LD LLVM_CONFIG SIMPLE_LLVM_REQUIRED_VERSION; do
                bsfc_value=$(bootstrap_stage3_transcript_explicit_env_value "$bsfc_transcript" "$bsfc_name") || return 1
                set -- "$@" "$bsfc_name=$bsfc_value"
            done ;; esac
    else
        set -- "$@" "SIMPLE_PHASE2_COMPATIBILITY_MANIFEST_READ=$bsfc_compat" \
            "SIMPLE_PHASE3_COMPATIBILITY_CACHE_ROOT=$bsfc_cache" \
            MALLOC_ARENA_MAX=2 MALLOC_TRIM_THRESHOLD_=0 SIMPLE_NATIVE_ARENA_DECLS=1 \
            SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_PACKAGE_INDEX_COLD_INIT=1
        bsfc_mc=$(bootstrap_stage3_verify_value focused_mission_critical "$bootstrap_stage3_manifest") || return 1
        case "$bsfc_mc" in 0) ;; 1) set -- "$@" SIMPLE_SAFETY_PROFILE=critical SIMPLE_ASSURANCE_WARNING_PHASE=1 ;; *) return 1 ;; esac
        set -- "$@" "SIMPLE_BUILD_PROGRESS_EVENTS=$bootstrap_stage3_manifest_output_root/bootstrap-build-progress.events" \
            SIMPLE_COMPILER_PHASE_PROFILE=1 \
            "SIMPLE_COMPILER_PHASE_PROFILE_FILE=$bootstrap_stage3_manifest_dir/phase-profile-v1.events" \
            "SIMPLE_MEM_SNAPSHOT_FILE=$bootstrap_stage3_manifest_dir/memory-snapshot-v1.events" \
            "SIMPLE_EVIDENCE_RUN_ID=$(bootstrap_stage3_transcript_explicit_env_value "$bsfc_transcript" SIMPLE_EVIDENCE_RUN_ID)" \
            LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING=1 \
            "SIMPLE_NATIVE_BUILD_TARGET=$bootstrap_stage3_platform" "SIMPLE_NATIVE_BUILD_THREADS=$bsfc_jobs" \
            "SIMPLE_NATIVE_BUILD_CACHE_DIR=$bsfc_cache" "SIMPLE_RUNTIME_PATH=$bsfc_runtime" SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap
    fi
    case "$bootstrap_stage3_platform" in *windows*)
        case "$bootstrap_stage3_platform" in *msvc) bsfc_abi=msvc ;; *gnu) bsfc_abi=gnu ;; *) return 1 ;; esac
        set -- "$@" "SIMPLE_WINDOWS_ABI=$bsfc_abi" "SIMPLE_LINKER_FLAVOR=$bsfc_abi"
        if [ "$bsfc_abi" = msvc ]; then
            for bsfc_name in CC INCLUDE LIB LIBPATH; do
                bsfc_value=$(bootstrap_stage3_transcript_explicit_env_value "$bsfc_transcript" "$bsfc_name") || return 1
                set -- "$@" "$bsfc_name=$bsfc_value"
            done
        fi ;; esac
    if [ "$bsfc_phase" = stage2 ]; then
        set -- "$@" "SIMPLE_PHASE2_COMPATIBILITY_MANIFEST_WRITE=$bsfc_compat" \
            "SIMPLE_PHASE3_COMPATIBILITY_CACHE_ROOT=$(bootstrap_stage3_map_value stage3_native_cache_dir_display)"
    fi
    set -- "$@" "SIMPLE_BINARY=$bsfc_compiler"
    if [ "$bsfc_phase" = stage3 ]; then
        for bsfc_name in SIMPLE_BOOTSTRAP_DIAG SIMPLE_COMPILER_TRACE SIMPLE_HIR_EXPORT_ORIGIN_TRACE \
            SIMPLE_HIR_PAYLOAD_LOOKUP_TRACE SIMPLE_HIR_SIBLING_TRACE SIMPLE_MIRB_TRACE \
            SIMPLE_MIR_DEFAULT_PAD_TRACE SIMPLE_MIR_FIELD_TRACE SIMPLE_MIR_RET_TRACE; do
            if grep -q "^explicit-env:[0-9][0-9]*:$bsfc_name=" "$bsfc_transcript"; then
                [ "$(bootstrap_stage3_transcript_explicit_env_value "$bsfc_transcript" "$bsfc_name")" = 1 ] || return 1
                set -- "$@" "$bsfc_name=1"
            fi
        done
    elif grep -q '^explicit-env:[0-9][0-9]*:SIMPLE_SCV_INVENTORY_COLD_INIT=' "$bsfc_transcript"; then
        [ "$(bootstrap_stage3_transcript_explicit_env_value "$bsfc_transcript" SIMPLE_SCV_INVENTORY_COLD_INIT)" = 1 ] || return 1
        set -- "$@" SIMPLE_SCV_INVENTORY_COLD_INIT=1
    fi
    bsfc_compiler_ceiling=$(bootstrap_stage3_transcript_compiler_ceiling "$bsfc_transcript") || return 1
    [ -z "$bsfc_compiler_ceiling" ] || set -- "$@" "SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB=$bsfc_compiler_ceiling"
    # Parent preflight context: recorded on the transcript by the stage2
    # builder (policy-silent, like cold-init); replay it verbatim when present.
    if grep -q '^explicit-env:[^:]*:SIMPLE_BOOTSTRAP_PREFLIGHT_CONTEXT_V1=' "$bsfc_transcript"; then
        set -- "$@" "SIMPLE_BOOTSTRAP_PREFLIGHT_CONTEXT_V1=$(bootstrap_stage3_transcript_explicit_env_value "$bsfc_transcript" SIMPLE_BOOTSTRAP_PREFLIGHT_CONTEXT_V1)"
    fi
    case "$bsfc_action" in hash) ;; transcript) set -- "$@" -- "$bsfc_compiler" ;; *) return 1 ;; esac
    # Source argv must byte-match the builder (bootstrap-from-scratch.sh):
    # k1 is repo-relative (k1_composition_source_root strips the repo prefix),
    # cuda is the repo composition dir, and the plugins root is always passed.
    bsfc_k1_argv=${bsfc_k1#"$bootstrap_stage3_root/"}
    bsfc_cuda_argv="$bootstrap_stage3_root/src/compositions/cuda_$bsfc_cuda_mode"
    set -- "$@" native-build --target "$bootstrap_stage3_platform" --backend "$bootstrap_stage3_backend" \
        --runtime-bundle core-c-bootstrap --source "$bsfc_k1_argv" --source "$bsfc_cuda_argv" \
        --source src/compiler --source src/app --source src/lib \
        --source "$bootstrap_stage3_root/src/plugins" --entry-closure --threads "$bsfc_jobs"
    if [ "$bsfc_phase" = stage2 ]; then
        bsfc_verbose=$(bootstrap_stage3_verify_value focused_stage2_verbose "$bootstrap_stage3_manifest") || return 1
        case "$bsfc_verbose" in 0) ;; 1) set -- "$@" --verbose ;; *) return 1 ;; esac
        bsfc_timeout=$(bootstrap_stage3_verify_value focused_stage2_timeout "$bootstrap_stage3_manifest") || return 1
        case "$bsfc_timeout" in '') ;; *[!0-9]*) return 1 ;; *) set -- "$@" --timeout "$bsfc_timeout" ;; esac
        set -- "$@" --cache-dir "$bsfc_cache"
        [ "$bsfc_low" = 0 ] || set -- "$@" --low-memory
        set -- "$@" --mode "$bootstrap_stage3_mode" --entry src/app/cli/bootstrap_main.spl --runtime-path "$bsfc_runtime"
    else
        set -- "$@" --cache-dir "$bsfc_cache" --mode "$bootstrap_stage3_mode"
        [ "$bsfc_low" = 0 ] || set -- "$@" --low-memory
        set -- "$@" --runtime-path "$bsfc_runtime" --entry src/app/cli/bootstrap_main.spl
    fi
    set -- "$@" -o "$(bootstrap_stage3_map_value "${bsfc_phase}_display")"
    if [ "$bsfc_action" = hash ]; then bootstrap_stage3_args_sha256 "$@"
    else bootstrap_stage3_verify_command_transcript "$bsfc_transcript" "$bootstrap_stage3_root" "$@"; fi
)

# Validate either exact legacy rows or the Windows materialization inventory.
# Keep the receipt bytes intact: before/after comparison must still detect drift.
bootstrap_stage3_git_state_schema_valid() {
    perl - "$1" <<'BOOTSTRAP_GIT_STATE_SCHEMA_PL'
use strict;
use warnings;
use utf8;
use Digest::SHA qw(sha256_hex);
use Encode qw(decode FB_CROAK LEAVE_SRC);
use Fcntl qw(S_ISREG);
use Time::HiRes qw(stat);

eval {
    open my $receipt, '<:raw', $ARGV[0] or die "open receipt: $!";
    my @before = stat($receipt);
    S_ISREG($before[2]) && $before[7] <= 1048576 or die "bounded regular receipt required";
    my $data = '';
    while (1) {
        my $read = sysread($receipt, my $part, 65536);
        defined $read or die "read receipt: $!";
        last if $read == 0;
        $data .= $part;
        length($data) <= 1048576 or die "receipt exceeds bound";
    }
    my @after = stat($receipt);
    join(':', @before[0,1,2,7,9,10]) eq join(':', @after[0,1,2,7,9,10]) or die "receipt changed while reading";
    close $receipt or die "close receipt: $!";
    my @rows = split /(?<=\n)/, $data;
    @rows >= 2 && $rows[0] =~ /\Ahead=(?:[0-9a-f]{40}|[0-9a-f]{64})\n\z/ &&
        $rows[1] =~ /\Adirty_fingerprint=[0-9a-f]{64}\n\z/ or die "invalid common fields";
    if (@rows != 2) {
        @rows >= 4 or die "missing alias fields";
        my ($count) = $rows[2] =~ /\Aalias_collapse_count=(0|[1-9][0-9]*)\n\z/;
        my ($digest) = $rows[3] =~ /\Aalias_collapse_sha256=([0-9a-f]{64})\n\z/;
        defined($count) && defined($digest) && $count eq ''.(@rows - 4) or die "invalid alias count or digest";
        my @aliases = @rows > 4 ? @rows[4..$#rows] : ();
        sha256_hex(join('', @aliases)) eq $digest or die "alias digest mismatch";
        my $previous;
        for my $row (@aliases) {
            my ($size, $hex) = $row =~ /\Aalias-collapse-directory:([1-9][0-9]*):([0-9a-f]+)\n\z/;
            defined($hex) && length($hex) % 2 == 0 or die "invalid alias row";
            my $path = pack('H*', $hex);
            $size eq ''.length($path) && length($path) <= 131068 or die "alias byte length mismatch";
            my $name = decode('UTF-8', $path, FB_CROAK | LEAVE_SRC);
            $name !~ /[\\:*?"<>|\p{Cc}]/ or die "noncanonical relative alias";
            for my $part (split m{/}, $name, -1) {
                length($part) && $part ne '.' && $part ne '..' && $part !~ /[. ]\z/ &&
                    $part !~ /\A(?:CON|PRN|AUX|NUL|COM[1-9¹²³]|LPT[1-9¹²³])(?:\.|\z)/i or die "noncanonical relative alias component";
            }
            !defined($previous) || $path gt $previous or die "unsorted or duplicate alias";
            # Byte order/duplicates are schema properties. Native receipt
            # validation owns Windows OrdinalIgnoreCase identity semantics.
            $previous = $path;
        }
    }
    1;
} or do {
    print STDERR "invalid git state schema: $@\n";
    exit 1;
};
BOOTSTRAP_GIT_STATE_SCHEMA_PL
}

# Positioned reads never reopen a pathname or change the inherited offset.
# Keep this implementation in the byte-bound verifier module. Python is included
# in tool authority on hosts without procfs; -I excludes ambient Python inputs.
bootstrap_stage3_descriptor_read() {
    "${bootstrap_stage3_portable_python:-python3}" -I - "$@" <<'BOOTSTRAP_POSITIONED_READ_PY'
import hashlib
import os
import re
import stat
import sys
import tempfile


def positioned_read(fd, expected=None, source_path=None):
    before = os.fstat(fd)
    if not stat.S_ISREG(before.st_mode) or before.st_size > 1048576:
        raise ValueError("descriptor is not a bounded regular authority file")
    def identity(st):
        return (st.st_dev, st.st_ino, st.st_mode, st.st_size,
                st.st_mtime_ns, st.st_ctime_ns)
    if source_path is not None:
        path_before = os.lstat(source_path)
        if not stat.S_ISREG(path_before.st_mode) or identity(path_before) != identity(before):
            raise ValueError("source pathname does not identify retained descriptor")
    parts = []
    offset = 0
    while offset < before.st_size:
        part = os.pread(fd, min(65536, before.st_size - offset), offset)
        if not part:
            raise ValueError("short authority read")
        parts.append(part)
        offset += len(part)
    data = b"".join(parts)
    if identity(os.fstat(fd)) != identity(before):
        raise ValueError("authority mutated during positioned read")
    if source_path is not None and identity(os.lstat(source_path)) != identity(before):
        raise ValueError("source pathname changed during positioned read")
    digest = hashlib.sha256(data).hexdigest()
    receipt = ":".join(map(str, (before.st_dev, before.st_ino, before.st_mode,
                                 before.st_size, digest)))
    if expected is not None and receipt != expected:
        raise ValueError("retained authority identity or content changed")
    return data, receipt, digest


def role_snapshot(path, kind, expected_identity=None):
    if kind not in ("file", "directory"):
        raise ValueError("invalid role type")
    def identity(st):
        return (st.st_dev, st.st_ino, st.st_mode, st.st_size,
                st.st_mtime_ns, st.st_ctime_ns)
    before = os.lstat(path)
    predicate = stat.S_ISREG if kind == "file" else stat.S_ISDIR
    if not predicate(before.st_mode):
        raise ValueError("wrong role type or symlink")
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    if kind == "directory":
        flags |= os.O_DIRECTORY
    fd = os.open(path, flags)
    try:
        opened = os.fstat(fd)
        if identity(opened) != identity(before):
            raise ValueError("role replaced during open")
        if expected_identity is not None and (opened.st_dev, opened.st_ino, stat.S_IMODE(opened.st_mode)) != expected_identity:
            raise ValueError("role identity mismatch")
        digest = "-"
        if kind == "file":
            hasher = hashlib.sha256()
            offset = 0
            while offset < opened.st_size:
                data = os.pread(fd, min(1048576, opened.st_size - offset), offset)
                if not data:
                    raise ValueError("short role read")
                hasher.update(data)
                offset += len(data)
            digest = hasher.hexdigest()
        if identity(os.fstat(fd)) != identity(opened) or identity(os.lstat(path)) != identity(opened):
            raise ValueError("role changed during verification")
        return opened.st_dev, opened.st_ino, stat.S_IMODE(opened.st_mode), digest
    finally:
        os.close(fd)


def verify_role(path, expected):
    fields = expected.split(":")
    if len(fields) != 5 or fields[0] not in ("file", "directory"):
        raise ValueError("invalid role binding")
    kind, dev, ino, mode, digest = fields
    if not dev.isdigit() or not ino.isdigit() or not re.fullmatch(r"[0-7]+", mode):
        raise ValueError("invalid role identity")
    if kind == "file" and not re.fullmatch(r"[0-9a-f]{64}", digest):
        raise ValueError("invalid role digest")
    if kind == "directory" and digest != "-":
        raise ValueError("invalid directory binding")
    actual = role_snapshot(path, kind, (int(dev), int(ino), int(mode, 8)))
    if actual[:3] != (int(dev), int(ino), int(mode, 8)):
        raise ValueError("role identity mismatch")
    if actual[3] != digest:
        raise ValueError("role digest mismatch")


def directory_identity(fd, expected, source_path):
    fields = expected.split(":")
    if len(fields) != 5 or fields[0] != "directory" or fields[4] != "-":
        raise ValueError("invalid runtime directory binding")
    if not fields[1].isdigit() or not fields[2].isdigit() or not re.fullmatch(r"[0-7]+", fields[3]):
        raise ValueError("invalid runtime directory identity")
    held = os.fstat(fd)
    path = os.lstat(source_path)
    if not stat.S_ISDIR(held.st_mode) or not stat.S_ISDIR(path.st_mode):
        raise ValueError("runtime directory type or symlink")
    expected_identity = int(fields[1]), int(fields[2]), int(fields[3], 8)
    for current in (held, path):
        if (current.st_dev, current.st_ino, stat.S_IMODE(current.st_mode)) != expected_identity:
            raise ValueError("runtime directory identity mismatch")
    return held


def directory_snapshot(fd, expected, source_path, hosted=None):
    def identity(st):
        return (st.st_dev, st.st_ino, st.st_mode, st.st_size,
                st.st_mtime_ns, st.st_ctime_ns)
    root_before = directory_identity(fd, expected, source_path)
    if hosted is not None and stat.S_IMODE(root_before.st_mode) != 0o500:
        raise ValueError("hosted runtime root is not frozen mode 0500")
    records = []
    def walk(directory_fd, prefix):
        before = os.fstat(directory_fd)
        # openat(".") creates a fresh open-file description; listdir cannot
        # consume the inherited directory descriptor's shared seek offset.
        scan_fd = os.open(".", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                          dir_fd=directory_fd)
        try:
            names = os.listdir(scan_fd)
        finally:
            os.close(scan_fd)
        for name in names:
            path_before = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
            if stat.S_ISLNK(path_before.st_mode):
                raise ValueError("runtime descendant symlink")
            relative = prefix + os.fsencode(name)
            if stat.S_ISDIR(path_before.st_mode):
                flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
            elif stat.S_ISREG(path_before.st_mode):
                flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
            else:
                raise ValueError("unsupported runtime descendant type")
            child_fd = os.open(name, flags, dir_fd=directory_fd)
            try:
                opened = os.fstat(child_fd)
                if identity(opened) != identity(path_before):
                    raise ValueError("runtime descendant replaced during open")
                if hosted is not None:
                    if stat.S_IMODE(opened.st_mode) & 0o222:
                        raise ValueError("writable hosted runtime descendant")
                    hosted["modes"][relative] = stat.S_IMODE(opened.st_mode)
                    if relative == b"deps" and not stat.S_ISDIR(opened.st_mode):
                        raise ValueError("hosted deps is not a directory")
                    if relative == b"hosted-runtime.env" and (not stat.S_ISREG(opened.st_mode) or opened.st_size > 1048576):
                        raise ValueError("invalid hosted runtime receipt file")
                if stat.S_ISDIR(opened.st_mode):
                    walk(child_fd, relative + b"/")
                else:
                    hasher = hashlib.sha256()
                    offset = 0
                    while offset < opened.st_size:
                        chunk = os.pread(child_fd, min(1048576, opened.st_size - offset), offset)
                        if not chunk:
                            raise ValueError("short runtime descendant read")
                        hasher.update(chunk)
                        if hosted is not None and relative == b"hosted-runtime.env":
                            hosted["receipt"].append(chunk)
                        offset += len(chunk)
                    if hosted is not None and re.fullmatch(rb"deps/libspl_hosted_runtime-[^/\n]*\.rlib", relative):
                        hosted["libraries"][relative] = hasher.hexdigest().encode("ascii")
                    executable = int(os.access(name, os.X_OK, dir_fd=directory_fd,
                                               effective_ids=True, follow_symlinks=False))
                    records.append(b"file-hex:" + relative.hex().encode("ascii") + b":" +
                                   str(executable).encode("ascii") + b":" + hasher.hexdigest().encode("ascii"))
                if identity(os.fstat(child_fd)) != identity(opened) or identity(os.stat(name, dir_fd=directory_fd, follow_symlinks=False)) != identity(opened):
                    raise ValueError("runtime descendant mutated during snapshot")
            finally:
                os.close(child_fd)
        if identity(os.fstat(directory_fd)) != identity(before):
            raise ValueError("runtime directory mutated during snapshot")
    walk(fd, b"")
    if identity(directory_identity(fd, expected, source_path)) != identity(root_before):
        raise ValueError("runtime root mutated during snapshot")
    if not records:
        raise ValueError("empty runtime authority")
    return b"\n".join(sorted(records)) + b"\n"


def verify_hosted_runtime(fd, expected, source_path):
    hosted = {"receipt": [], "libraries": {}, "modes": {}}
    directory_snapshot(fd, expected, source_path, hosted)
    data = b"".join(hosted["receipt"])
    rows = data.split(b"\n")
    if rows and rows[-1] == b"":
        rows.pop()
    values = {}
    for row in rows:
        key, separator, value = row.partition(b"=")
        if not separator or key not in (b"schema", b"status", b"relative_path", b"sha256") or key in values:
            raise ValueError("invalid or repeated hosted receipt key")
        values[key] = value
    if len(values) != 4 or values[b"schema"] != b"simple-bootstrap-hosted-runtime-authority-v1" or values[b"status"] != b"frozen":
        raise ValueError("invalid hosted receipt schema or status")
    relative, digest = values[b"relative_path"], values[b"sha256"]
    if not re.fullmatch(rb"deps/libspl_hosted_runtime-[^/\n]*\.rlib", relative) or not re.fullmatch(rb"[0-9a-f]{64}", digest):
        raise ValueError("invalid hosted library path or digest")
    if len(hosted["libraries"]) != 1 or hosted["libraries"].get(relative) != digest:
        raise ValueError("hosted library count or digest mismatch")
    if hosted["modes"].get(b"deps") != 0o500 or hosted["modes"].get(b"hosted-runtime.env") != 0o400 or hosted["modes"].get(relative) != 0o400:
        raise ValueError("hosted deps, receipt, or library mode mismatch")
    return relative, digest


def publish_directory_snapshot(path, data):
    fd, temporary = tempfile.mkstemp(prefix=".stage3-runtime-", dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "wb") as output:
            output.write(data)
        # Exclusive publication never follows or replaces an existing target.
        os.link(temporary, path, follow_symlinks=False)
    finally:
        os.unlink(temporary)


def main(args):
    if len(args) not in (4, 5) or not args[0].isdigit():
        raise ValueError("expected fd, receipt, operation, argument, optional output")
    fd, expected, operation, argument = args[:4]
    if len(args) == 5 and operation != "directory-snapshot":
        raise ValueError("unexpected output argument")
    if operation == "hosted-runtime":
        if int(fd) < 3:
            raise ValueError("reserved hosted directory descriptor")
        relative, digest = verify_hosted_runtime(int(fd), expected, argument)
        sys.stdout.buffer.write(relative + b"\n" + digest + b"\n")
        return
    if operation in ("directory-check", "directory-snapshot"):
        if int(fd) < 3:
            raise ValueError("reserved directory descriptor")
        if operation == "directory-check":
            directory_identity(int(fd), expected, argument)
        else:
            if len(args) != 5:
                raise ValueError("runtime snapshot output required")
            publish_directory_snapshot(args[4], directory_snapshot(int(fd), expected, argument))
        return
    if operation == "role-receipt":
        dev, ino, mode, digest = role_snapshot(argument, expected)
        print(f"{dev} {ino} {mode:o} {digest}")
        return
    if operation == "role":
        verify_role(argument, expected)
        return
    if int(fd) < 3:
        raise ValueError("reserved descriptor")
    data, receipt, digest = positioned_read(
        int(fd), None if operation == "seal" else expected,
        argument if operation == "seal" else None)
    if operation == "seal":
        print(receipt)
    elif operation == "hash":
        print(digest)
    elif operation == "read":
        sys.stdout.buffer.write(data)
    elif operation == "value":
        if not re.fullmatch(r"[a-zA-Z0-9_]+", argument):
            raise ValueError("invalid authority key")
        prefix = argument.encode("ascii") + b"="
        values = [line[len(prefix):] for line in data.split(b"\n") if line.startswith(prefix)]
        if len(values) != 1:
            raise ValueError("authority key absent or repeated")
        sys.stdout.buffer.write(values[0] + b"\n")
    elif operation == "roles":
        roles = re.findall(rb"^([a-z0-9_]+)_authority=", data, re.MULTILINE)
        sys.stdout.buffer.write(b" ".join(roles) + b"\n")
    elif operation == "lines":
        print(data.count(b"\n"))
    elif operation == "vector":
        print(hashlib.sha256(b"\n".join(data.split(b"\n")[4:])).hexdigest())
    else:
        raise ValueError("unknown authority operation")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (OSError, ValueError) as error:
        print("bootstrap positioned authority: " + str(error), file=sys.stderr)
        sys.exit(1)
BOOTSTRAP_POSITIONED_READ_PY
}

bootstrap_stage3_prepare_portable_python() {
    command -v python3 >/dev/null 2>&1 || {
        bootstrap_stage3_provenance_fail "portable-authority-python3-required"
        return 1
    }
    bootstrap_stage3_portable_python=$(bootstrap_stage3_resolve_symlinks \
        "$(command -v python3)") || return 1
    bootstrap_stage3_portable_python_sha=$(bootstrap_stage3_hash_file \
        "$bootstrap_stage3_portable_python") || return 1
}

# Bind the interpreter actually used for map reads, not only the recorded PATH.
bootstrap_stage3_verify_portable_python() {
    [ "$#" = 1 ] || return 1
    bootstrap_stage3_python_row=$(awk -F '|' '$1 == "tool=python3" {print; count++} END {if (count != 1) exit 1}' "$1") || return 1
    printf '%s\n' "$bootstrap_stage3_python_row" | awk -F '|' \
        -v canonical="$bootstrap_stage3_portable_python" \
        -v digest="$bootstrap_stage3_portable_python_sha" '
        { for (i = 2; i <= NF; i++) {
            if ($i == "canonical=" canonical) paths++
            if ($i == "sha256=" digest) hashes++
          }
          if (paths != 1 || hashes != 1) exit 1
        }' || return 1
    [ "$(bootstrap_stage3_hash_file "$bootstrap_stage3_portable_python")" = \
        "$bootstrap_stage3_portable_python_sha" ]
}

# Only the currently retained manifest is dispatched to fd8. Other receipts
# retain the existing helper behavior; no descriptor token is accepted as a path.
bootstrap_stage3_verify_value() {
    [ "$#" = 2 ] || return 1
    if [ "${bootstrap_stage3_portable_manifest:-0}" = 1 ] &&
        [ "$2" = "$bootstrap_stage3_manifest" ]; then
        bootstrap_stage3_descriptor_read 8 "$bootstrap_stage3_manifest_receipt" value "$1"
    else
        bootstrap_stage3_manifest_value "$@"
    fi
}

bootstrap_stage3_verify_portable_role() {
    [ "$#" = 3 ] || return 1
    bootstrap_stage3_role_binding="$3:$(bootstrap_stage3_map_value "${2}_dev"):$(bootstrap_stage3_map_value "${2}_ino"):$(bootstrap_stage3_map_value "${2}_mode")" || return 1
    if [ "$3" = file ]; then
        bootstrap_stage3_role_digest=$(bootstrap_stage3_map_value "${2}_sha256") || return 1
    else
        bootstrap_stage3_role_digest=-
    fi
    bootstrap_stage3_descriptor_read 0 "$bootstrap_stage3_role_binding:$bootstrap_stage3_role_digest" role "$1"
}

bootstrap_stage3_map_hash() {
    if [ "${bootstrap_stage3_portable_map:-0}" = 1 ]; then
        bootstrap_stage3_descriptor_read 9 "$bootstrap_stage3_map_receipt" hash ''
    else
        bootstrap_stage3_hash_file "$bootstrap_stage3_bound_map"
    fi
}

# Writing to an inherited fd by path. Linux spells that /proc/self/fd/N; every
# host without procfs (macOS, the BSDs) spells it /dev/fd/N. Unlike the READ
# views further down -- where /dev/fd's dup-not-reopen semantics silently breaks
# repeated reads, see
# doc/08_tracking/bug/bootstrap_stage3_proc_fd_protocol_has_no_darwin_equivalent_2026-09-12.md
# -- a single append-style write is unaffected by a shared offset, so this one
# is a safe direct substitution.
bootstrap_stage3_phase_status_path() {
    if [ -r /proc/self/stat ]; then
        printf '/proc/self/fd/%s\n' "$1"
    else
        printf '/dev/fd/%s\n' "$1"
    fi
}

bootstrap_stage3_manifest_phase_emit() {
    [ "${BOOTSTRAP_STAGE3_PHASE_STATUS_FD:-}" = 159 ] || return 0
    { printf '%s' "$1" >"$(bootstrap_stage3_phase_status_path 159)"; } 2>/dev/null || :
}

# The caller's own pid. Linux reads field 1 of /proc/self/stat, which is the
# pid of the process actually doing the read; elsewhere POSIX `$$` is the same
# value, because $$ names the ORIGINAL shell and is not re-expanded in a
# subshell. (`$PPID` of a single external command is NOT an equivalent: measured
# on /bin/sh here, `$(sh -c 'echo $PPID')` returns the command-substitution
# subshell -- 48559 against a real $$ of 48549 -- so it must not be used.) The
# positive-integer check at the call site is the fail-closed arm for both
# sources and is deliberately unchanged.
bootstrap_stage3_own_pid() {
    if [ -r /proc/self/stat ]; then
        IFS=' ' read -r bootstrap_stage3_local_pid bootstrap_stage3_local_stat_rest \
            </proc/self/stat || return 1
    else
        bootstrap_stage3_local_pid=$$
        bootstrap_stage3_local_stat_rest=
    fi
}

bootstrap_stage3_verify_manifest_impl() {
    bootstrap_stage3_own_pid || return 1
    case "$bootstrap_stage3_local_pid" in
        ''|0|*[!0-9]*) return 1 ;;
    esac
    bootstrap_stage3_manifest_phase_emit 1
    [ "$#" = 6 ] || [ "$#" = 8 ] || return 1
    bootstrap_stage3_portable_manifest=0
    bootstrap_stage3_manifest=$1
    bootstrap_stage3_manifest_display=$2
    bootstrap_stage3_root=$3
    bootstrap_stage3_expected_output=$4
    bootstrap_stage3_expected_output_display=$5
    bootstrap_stage3_bound_map=$6
    bootstrap_stage3_parent_git=${7-}
    bootstrap_stage3_parent_source=${8-}
    if [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" = 1 ]; then
        [ "$#" = 8 ] || return 1
        bootstrap_stage3_sanity_regular_authority "$bootstrap_stage3_parent_git" || { bootstrap_stage3_provenance_fail "manifest-stage-parent-git-authority"; return 1; }
        bootstrap_stage3_sanity_regular_authority "$bootstrap_stage3_parent_source" || { bootstrap_stage3_provenance_fail "manifest-stage-parent-source-authority"; return 1; }
    fi
    bootstrap_stage3_manifest_phase_emit 2
    bootstrap_stage3_normalized_absolute "$bootstrap_stage3_manifest_display" || { bootstrap_stage3_provenance_fail "manifest-entry-manifest-display"; return 1; }
    bootstrap_stage3_normalized_absolute "$bootstrap_stage3_expected_output_display" || { bootstrap_stage3_provenance_fail "manifest-entry-output-display"; return 1; }
    [ -n "$bootstrap_stage3_manifest_display" ] &&
        [ "${bootstrap_stage3_manifest_display#/}" != \
            "$bootstrap_stage3_manifest_display" ] || { bootstrap_stage3_provenance_fail "manifest-entry-manifest-display-empty"; return 1; }
    bootstrap_stage3_manifest_phase_emit 3
    bootstrap_stage3_portable_map=0
    if [ ! -r /proc/self/stat ]; then
        [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" != 1 ] || {
            bootstrap_stage3_provenance_fail "portable-descriptor-capsule-not-supported"
            return 1
        }
        bootstrap_stage3_prepare_portable_python || return 1
        bootstrap_stage3_normalized_absolute "$bootstrap_stage3_bound_map" || return 1
        [ -f "$bootstrap_stage3_bound_map" ] && [ ! -L "$bootstrap_stage3_bound_map" ] || return 1
        exec 9<"$bootstrap_stage3_bound_map" || return 1
        bootstrap_stage3_map_receipt=$(bootstrap_stage3_descriptor_read \
            9 '' seal "$bootstrap_stage3_bound_map") || {
            bootstrap_stage3_provenance_fail "portable-authority-map-seal"
            return 1
        }
        bootstrap_stage3_portable_map=1
        bootstrap_stage3_manifest_phase_emit 8
        bootstrap_stage3_map_value() {
            bootstrap_stage3_descriptor_read 9 "$bootstrap_stage3_map_receipt" value "$1"
        }
    else
    case "$bootstrap_stage3_bound_map" in
        /proc/[1-9][0-9]*/fd/[1-9][0-9]*) [ -f "$bootstrap_stage3_bound_map" ] || { bootstrap_stage3_provenance_fail "manifest-entry-bound-map-missing"; return 1; } ;;
        *)
            bootstrap_stage3_normalized_absolute "$bootstrap_stage3_bound_map" || { bootstrap_stage3_provenance_fail "manifest-entry-bound-map-path"; return 1; }
            [ -f "$bootstrap_stage3_bound_map" ] && [ ! -L "$bootstrap_stage3_bound_map" ] || { bootstrap_stage3_provenance_fail "manifest-entry-bound-map-regular"; return 1; }
            exec 9<"$bootstrap_stage3_bound_map" || { bootstrap_stage3_provenance_fail "manifest-entry-bound-map-open"; return 1; }
            bootstrap_stage3_bound_map=\
"/proc/$bootstrap_stage3_local_pid/fd/9" ;;
    esac
    bootstrap_stage3_manifest_phase_emit 4
    bootstrap_stage3_bound_map_external_sha=$(bootstrap_stage3_hash_file "$bootstrap_stage3_bound_map") || { bootstrap_stage3_provenance_fail "manifest-entry-bound-map-hash"; return 1; }
    bootstrap_stage3_manifest_phase_emit 5
    bootstrap_stage3_bound_map_snapshot="${TMPDIR:-/tmp}/stage3-bound-map.$bootstrap_stage3_local_pid.snapshot"
    (umask 077; set -C; : >"$bootstrap_stage3_bound_map_snapshot") || { bootstrap_stage3_provenance_fail "manifest-entry-bound-map-snapshot-create"; return 1; }
    bootstrap_stage3_bound_map_snapshot_owned=1
    bootstrap_stage3_manifest_phase_emit 6
    dd if="$bootstrap_stage3_bound_map" of="$bootstrap_stage3_bound_map_snapshot" bs=65536 2>/dev/null || { rm -f "$bootstrap_stage3_bound_map_snapshot"; bootstrap_stage3_provenance_fail "manifest-entry-bound-map-snapshot-copy"; return 1; }
    chmod 0400 "$bootstrap_stage3_bound_map_snapshot" || { rm -f "$bootstrap_stage3_bound_map_snapshot"; bootstrap_stage3_provenance_fail "manifest-entry-bound-map-snapshot-mode"; return 1; }
    [ "$(bootstrap_stage3_hash_file "$bootstrap_stage3_bound_map_snapshot")" = "$bootstrap_stage3_bound_map_external_sha" ] || { rm -f "$bootstrap_stage3_bound_map_snapshot"; bootstrap_stage3_provenance_fail "manifest-entry-bound-map-snapshot-hash"; return 1; }
    bootstrap_stage3_manifest_phase_emit 7
    exec 7<"$bootstrap_stage3_bound_map_snapshot" || { rm -f "$bootstrap_stage3_bound_map_snapshot"; bootstrap_stage3_provenance_fail "manifest-entry-bound-map-snapshot-open"; return 1; }
    rm -f "$bootstrap_stage3_bound_map_snapshot" || { bootstrap_stage3_provenance_fail "manifest-entry-bound-map-snapshot-remove"; return 1; }
    bootstrap_stage3_manifest_phase_emit 8
    bootstrap_stage3_bound_map="/proc/$bootstrap_stage3_local_pid/fd/7"
    bootstrap_stage3_map_value() {
        bootstrap_stage3_verify_value "$1" "$bootstrap_stage3_bound_map"
    }
    fi
    [ "$(bootstrap_stage3_map_value schema)" = simple-stage3-bound-artifact-authority-map-v2 ] || { bootstrap_stage3_provenance_fail "manifest-stage-map-schema"; return 1; }
    [ "$(bootstrap_stage3_map_value status)" = ready ] || { bootstrap_stage3_provenance_fail "manifest-stage-map-status"; return 1; }
    [ "$(bootstrap_stage3_map_value entry_count)" = 31 ] || { bootstrap_stage3_provenance_fail "manifest-stage-map-count"; return 1; }
    bootstrap_stage3_map_roles='seed native_all compiler_backfill stage2 stage2_admitted stage2_build_log stage2_command_transcript stage2_sanity_evidence stage2_sanity_companion_parent stage2_receiver_evidence stage2_receiver_log stage2_admission_receipt stage3_build_log stage3_command_transcript stage3_sanity_evidence stage3_sanity_companion_parent git_state runtime_origin_snapshot runtime_admitted_snapshot tool_authority seed_inputs_stamp source_snapshot output bootstrap_script provenance_helper stage2_native_cache_dir stage3_native_cache_dir runtime_path source_inputs_before tool_authority_before jobs_receipt'
    if [ "$bootstrap_stage3_portable_map" = 1 ]; then
        bootstrap_stage3_map_actual_roles=$(bootstrap_stage3_descriptor_read \
            9 "$bootstrap_stage3_map_receipt" roles '') || return 1
        bootstrap_stage3_map_actual_lines=$(bootstrap_stage3_descriptor_read \
            9 "$bootstrap_stage3_map_receipt" lines '') || return 1
        bootstrap_stage3_map_vector=$(bootstrap_stage3_descriptor_read \
            9 "$bootstrap_stage3_map_receipt" vector '') || return 1
    else
    bootstrap_stage3_map_actual_roles=$(sed -n 's/^\([a-z0-9_]*\)_authority=.*/\1/p' "$bootstrap_stage3_bound_map" | tr '\n' ' ' | sed 's/ $//')
    bootstrap_stage3_map_actual_lines=$(wc -l <"$bootstrap_stage3_bound_map" | tr -d ' ') || return 1
    bootstrap_stage3_map_vector=$(tail -n +5 "$bootstrap_stage3_bound_map" | bootstrap_stage3_hash_stream) || return 1
    fi
    [ "$bootstrap_stage3_map_actual_roles" = "$bootstrap_stage3_map_roles" ] || { bootstrap_stage3_provenance_fail "manifest-stage-map-roles"; return 1; }
    bootstrap_stage3_map_expected_lines=185
    [ "$(bootstrap_stage3_map_value compiler_backfill_authority)" = descriptor-absent ] && bootstrap_stage3_map_expected_lines=184
    [ "$bootstrap_stage3_map_actual_lines" = "$bootstrap_stage3_map_expected_lines" ] || { bootstrap_stage3_provenance_fail "manifest-stage-map-lines"; return 1; }
    [ "$(bootstrap_stage3_map_value map_vector_sha256)" = "$bootstrap_stage3_map_vector" ] || { bootstrap_stage3_provenance_fail "manifest-stage-map-vector"; return 1; }
    bootstrap_stage3_manifest_phase_emit 9
    for bootstrap_stage3_map_role in $bootstrap_stage3_map_roles; do
        bootstrap_stage3_map_authority=$(bootstrap_stage3_map_value "${bootstrap_stage3_map_role}_authority") || return 1
        bootstrap_stage3_map_display=$(bootstrap_stage3_map_value "${bootstrap_stage3_map_role}_display") || return 1
        bootstrap_stage3_normalized_absolute "$bootstrap_stage3_map_display" || return 1
        for bootstrap_stage3_map_identity in dev ino mode; do bootstrap_stage3_map_value "${bootstrap_stage3_map_role}_${bootstrap_stage3_map_identity}" >/dev/null || return 1; done
        if [ "$bootstrap_stage3_map_authority" = descriptor-absent ]; then
            [ "$bootstrap_stage3_map_role" = compiler_backfill ] || return 1
            continue
        fi
        if [ "$bootstrap_stage3_portable_map" = 1 ]; then
            case "$bootstrap_stage3_map_role" in
                stage2_sanity_companion_parent|stage3_sanity_companion_parent|stage2_native_cache_dir|stage3_native_cache_dir|runtime_path)
                    bootstrap_stage3_role_kind=directory ;;
                *) bootstrap_stage3_role_kind=file ;;
            esac
            bootstrap_stage3_verify_portable_role "$bootstrap_stage3_map_authority" \
                "$bootstrap_stage3_map_role" "$bootstrap_stage3_role_kind" || {
                bootstrap_stage3_provenance_fail "portable-authority-role-$bootstrap_stage3_map_role"
                return 1
            }
        else
        case "$bootstrap_stage3_map_role" in
            stage2_sanity_companion_parent|stage3_sanity_companion_parent|stage2_native_cache_dir|stage3_native_cache_dir|runtime_path)
                [ -d "$bootstrap_stage3_map_authority" ] || return 1 ;;
            *)
                [ -f "$bootstrap_stage3_map_authority" ] || return 1
                [ "$(bootstrap_stage3_map_value "${bootstrap_stage3_map_role}_sha256")" = "$(bootstrap_stage3_hash_file "$bootstrap_stage3_map_authority")" ] || return 1 ;;
        esac
        set -- $(stat -Lc '%d %i %a' "$bootstrap_stage3_map_authority") || return 1
        [ "$(bootstrap_stage3_map_value "${bootstrap_stage3_map_role}_dev")" = "$1" ] &&
        [ "$(bootstrap_stage3_map_value "${bootstrap_stage3_map_role}_ino")" = "$2" ] &&
        [ "$(bootstrap_stage3_map_value "${bootstrap_stage3_map_role}_mode")" = "$3" ] || return 1
        fi
    done
    if [ "$bootstrap_stage3_portable_map" = 1 ]; then
        bootstrap_stage3_verify_portable_python \
            "$(bootstrap_stage3_map_value tool_authority_authority)" || {
            bootstrap_stage3_provenance_fail "portable-authority-python3-binding"
            return 1
        }
    fi
    bootstrap_stage3_manifest_phase_emit A
    bootstrap_stage3_manifest_a_failure_code=V0
    [ -f "$bootstrap_stage3_expected_output" ] &&
        [ -x "$bootstrap_stage3_expected_output" ] || return 1
    if [ "$bootstrap_stage3_portable_map" = 1 ]; then
        bootstrap_stage3_verify_portable_role "$bootstrap_stage3_expected_output" output file || return 1
    else
    set -- $(stat -Lc '%d %i %a' "$bootstrap_stage3_expected_output") ||
        return 1
    [ "$(bootstrap_stage3_map_value output_dev)" = "$1" ] &&
        [ "$(bootstrap_stage3_map_value output_ino)" = "$2" ] &&
        [ "$(bootstrap_stage3_map_value output_mode)" = "$3" ] || return 1
    [ "$(bootstrap_stage3_hash_file "$bootstrap_stage3_expected_output")" = \
        "$(bootstrap_stage3_map_value output_sha256)" ] || return 1
    fi
    [ "$(bootstrap_stage3_map_value output_display)" = "$bootstrap_stage3_expected_output_display" ] || return 1
    bootstrap_stage3_manifest_a_failure_code=U0
    bootstrap_stage3_root_canonical=$(
        CDPATH= cd -- "$bootstrap_stage3_root" && pwd -P
    ) || return 1
    [ "$bootstrap_stage3_root" = "$bootstrap_stage3_root_canonical" ] ||
        bootstrap_stage3_provenance_fail "repository-root-not-canonical" ||
        return 1
    bootstrap_stage3_manifest_a_failure_code=U1
    case "$bootstrap_stage3_manifest" in
        /proc/*)
            if expr "$bootstrap_stage3_manifest" : \
                '/proc/[1-9][0-9]*/fd/[1-9][0-9]*$' >/dev/null; then
                :
            elif expr "$bootstrap_stage3_manifest" : \
                '/proc/[1-9][0-9]*/fd/[1-9][0-9]*/[A-Za-z0-9_.-][A-Za-z0-9_.-]*$' \
                >/dev/null; then
                :
            else
                return 1
            fi
            [ -f "$bootstrap_stage3_manifest" ] || return 1 ;;
        *) [ -f "$bootstrap_stage3_manifest" ] &&
            [ ! -L "$bootstrap_stage3_manifest" ] &&
            [ "$(bootstrap_stage3_canonical_file "$bootstrap_stage3_manifest")" = \
                "$bootstrap_stage3_manifest" ] ||
            bootstrap_stage3_provenance_fail "manifest-path-not-canonical" || return 1 ;;
    esac
    bootstrap_stage3_manifest_a_failure_code=U2
    exec 8<"$bootstrap_stage3_manifest" || return 1
    if [ "$bootstrap_stage3_portable_map" = 1 ]; then
        bootstrap_stage3_manifest_receipt=$(bootstrap_stage3_descriptor_read \
            8 '' seal "$bootstrap_stage3_manifest") || {
            bootstrap_stage3_provenance_fail "portable-authority-manifest-seal"
            return 1
        }
        bootstrap_stage3_portable_manifest=1
    else
    bootstrap_stage3_manifest_source_before=$(
        stat -Lc '%d %i %f %s' \
            "/proc/$bootstrap_stage3_local_pid/fd/8"
    ) || return 1
    [ -f "/proc/$bootstrap_stage3_local_pid/fd/8" ] || return 1
    bootstrap_stage3_manifest_a_failure_code=U3
    bootstrap_stage3_manifest_snapshot="${TMPDIR:-/tmp}/stage3-manifest.$bootstrap_stage3_local_pid.snapshot"
    (umask 077; set -C; : >"$bootstrap_stage3_manifest_snapshot") || return 1
    bootstrap_stage3_manifest_snapshot_owned=1
    bootstrap_stage3_manifest_a_failure_code=U4
    dd of="$bootstrap_stage3_manifest_snapshot" bs=65536 <&8 2>/dev/null ||
        return 1
    chmod 0400 "$bootstrap_stage3_manifest_snapshot" || return 1
    bootstrap_stage3_manifest_a_failure_code=U5
    bootstrap_stage3_manifest_source_after=$(
        stat -Lc '%d %i %f %s' \
            "/proc/$bootstrap_stage3_local_pid/fd/8"
    ) || return 1
    [ "$bootstrap_stage3_manifest_source_before" = \
        "$bootstrap_stage3_manifest_source_after" ] || return 1
    bootstrap_stage3_manifest_source_size=${bootstrap_stage3_manifest_source_before##* }
    [ "$(wc -c <"$bootstrap_stage3_manifest_snapshot" | tr -d ' ')" = \
        "$bootstrap_stage3_manifest_source_size" ] || return 1
    bootstrap_stage3_manifest_a_failure_code=U6
    bootstrap_stage3_manifest_snapshot_sha=$(
        bootstrap_stage3_hash_file "$bootstrap_stage3_manifest_snapshot"
    ) || return 1
    [ "$(bootstrap_stage3_hash_file "$bootstrap_stage3_manifest_snapshot")" = \
        "$bootstrap_stage3_manifest_snapshot_sha" ] || return 1
    [ "$(bootstrap_stage3_hash_file \
        "/proc/$bootstrap_stage3_local_pid/fd/8")" = \
        "$bootstrap_stage3_manifest_snapshot_sha" ] || return 1
    bootstrap_stage3_manifest_a_failure_code=T0
    exec 8<"$bootstrap_stage3_manifest_snapshot" || return 1
    bootstrap_stage3_manifest_a_failure_code=T1
    bootstrap_stage3_manifest_snapshot_path_identity=$(
        stat -Lc '%d %i %f %s' "$bootstrap_stage3_manifest_snapshot"
    ) || return 1
    bootstrap_stage3_manifest_snapshot_fd_identity=$(
        stat -Lc '%d %i %f %s' \
            "/proc/$bootstrap_stage3_local_pid/fd/8"
    ) || return 1
    [ "$bootstrap_stage3_manifest_snapshot_path_identity" = \
        "$bootstrap_stage3_manifest_snapshot_fd_identity" ] || return 1
    set -- $bootstrap_stage3_manifest_snapshot_fd_identity
    [ "$3" = 8100 ] &&
        [ "$4" = "$bootstrap_stage3_manifest_source_size" ] || return 1
    bootstrap_stage3_manifest_a_failure_code=T2
    [ "$(bootstrap_stage3_hash_file \
        "/proc/$bootstrap_stage3_local_pid/fd/8")" = \
        "$bootstrap_stage3_manifest_snapshot_sha" ] || return 1
    bootstrap_stage3_manifest_a_failure_code=T3
    grep -Eq '^schema=simple-bootstrap-stage3-provenance-v[45]$' \
        "/proc/$bootstrap_stage3_local_pid/fd/8" || return 1
    bootstrap_stage3_manifest="/proc/$bootstrap_stage3_local_pid/fd/8"
    fi
    bootstrap_stage3_manifest_a_failure_code=U8
    bootstrap_stage3_manifest_schema=$(
        bootstrap_stage3_verify_value schema "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_manifest_a_failure_code=U9
    case "$bootstrap_stage3_manifest_schema" in
        simple-bootstrap-stage3-provenance-v4|simple-bootstrap-stage3-provenance-v5) ;;
        *) return 1 ;;
    esac

    bootstrap_stage3_manifest_singular_index=0
    bootstrap_stage3_manifest_base32=0123456789ABCDEFGHIJKLMNOPQRSTUV
    for bootstrap_stage3_key in schema status artifact_kind full_cli_status \
        created_at_utc platform backend mode build_rust_log \
        native_build_backfill_status source_roots source_file_count \
        source_fingerprint git_state_path git_state_sha256 git_head \
        git_dirty_fingerprint bootstrap_lock_path bootstrap_lock_owner_pid \
        seed_path seed_sha256 seed_inputs_fingerprint seed_backend seed_features \
        seed_inputs_stamp_path seed_inputs_stamp_sha256 \
        native_all_path native_all_sha256 compiler_backfill_path \
        compiler_backfill_status compiler_backfill_sha256 stage2_path \
        stage2_sha256 stage2_admitted_path stage2_admitted_sha256 \
        stage2_threads stage2_command_output \
        stage2_build_args_sha256 stage2_build_log_sha256 \
        stage2_build_log_path stage2_command_transcript_path \
        stage2_command_transcript_sha256 stage2_sanity_status \
        stage2_sanity_evidence_path stage2_sanity_evidence_sha256 \
        stage2_receiver_status stage2_receiver_evidence_path \
        stage2_receiver_evidence_sha256 stage2_check_policy \
        stage2_admission_identity stage2_admission_receipt_path \
        stage2_admission_receipt_sha256 \
        stage2_checks_executed_at_admission \
        stage2_checks_replayed_during_stage3 \
        stage3_path stage3_sha256 stage3_threads \
        stage3_command_output stage3_build_args_sha256 stage3_build_log_sha256 \
        stage3_build_log_path stage3_command_transcript_path \
        stage3_command_transcript_sha256 stage3_sanity_status \
        stage3_sanity_evidence_path stage3_sanity_evidence_sha256 \
        stage3_jobs_receipt_path stage3_jobs_receipt_sha256 \
        stage2_native_cache_dir stage3_native_cache_dir runtime_path \
        runtime_origin_snapshot_path runtime_origin_snapshot_sha256 \
        runtime_admitted_snapshot_path runtime_admitted_snapshot_sha256 \
        tool_authority_path tool_authority_sha256 \
        bootstrap_script_path bootstrap_script_sha256 \
        provenance_helper_path provenance_helper_sha256 \
        provenance_helper_bundle_fingerprint \
        source_snapshot_path source_snapshot_sha256 output_path output_sha256 \
        bound_artifact_authority_map_path bound_artifact_authority_map_sha256; do
        bootstrap_stage3_manifest_singular_index=$((bootstrap_stage3_manifest_singular_index + 1))
        bootstrap_stage3_manifest_base32_high=$((bootstrap_stage3_manifest_singular_index / 32))
        bootstrap_stage3_manifest_base32_low=$((bootstrap_stage3_manifest_singular_index % 32))
        bootstrap_stage3_manifest_base32_rest=$bootstrap_stage3_manifest_base32
        while [ "$bootstrap_stage3_manifest_base32_high" -gt 0 ]; do
            bootstrap_stage3_manifest_base32_rest=${bootstrap_stage3_manifest_base32_rest#?}
            bootstrap_stage3_manifest_base32_high=$((bootstrap_stage3_manifest_base32_high - 1))
        done
        bootstrap_stage3_manifest_a_failure_code=${bootstrap_stage3_manifest_base32_rest%"${bootstrap_stage3_manifest_base32_rest#?}"}
        bootstrap_stage3_manifest_base32_rest=$bootstrap_stage3_manifest_base32
        while [ "$bootstrap_stage3_manifest_base32_low" -gt 0 ]; do
            bootstrap_stage3_manifest_base32_rest=${bootstrap_stage3_manifest_base32_rest#?}
            bootstrap_stage3_manifest_base32_low=$((bootstrap_stage3_manifest_base32_low - 1))
        done
        bootstrap_stage3_manifest_a_failure_code=${bootstrap_stage3_manifest_a_failure_code}${bootstrap_stage3_manifest_base32_rest%"${bootstrap_stage3_manifest_base32_rest#?}"}
        bootstrap_stage3_verify_value "$bootstrap_stage3_key" \
            "$bootstrap_stage3_manifest" >/dev/null ||
            bootstrap_stage3_provenance_fail \
                "manifest-${bootstrap_stage3_key}-not-singular" ||
            return 1
    done

    bootstrap_stage3_manifest_a_failure_code=V2
    [ "$(bootstrap_stage3_verify_value schema "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_manifest_schema" ] || return 1
    [ "$(bootstrap_stage3_verify_value status "$bootstrap_stage3_manifest")" = \
        pass ] || return 1
    [ "$(bootstrap_stage3_verify_value artifact_kind "$bootstrap_stage3_manifest")" = \
        pure-simple-bootstrap-compiler ] || return 1
    [ "$(bootstrap_stage3_verify_value full_cli_status "$bootstrap_stage3_manifest")" = \
        separate-not-proven ] || return 1
    [ "$(bootstrap_stage3_verify_value native_build_backfill_status "$bootstrap_stage3_manifest")" = \
        bound-bootstrap-native-all ] || return 1
    if [ "$bootstrap_stage3_manifest_schema" = simple-bootstrap-stage3-provenance-v4 ]; then
        [ "$(bootstrap_stage3_verify_value source_roots "$bootstrap_stage3_manifest")" = \
            src/compiler:src/app:src/lib ] || return 1
    else
        [ "$(bootstrap_stage3_verify_value invocation_contract "$bootstrap_stage3_manifest")" = full-bootstrap-focused-v1 ] || return 1
        for bsfc_key in focused_k1_policy focused_k1_sha256 focused_cuda_manifest_sha256 \
            focused_cuda_template_sha256 focused_k1_receipt_sha256 focused_low_memory \
            focused_stage2_verbose focused_stage2_timeout focused_mission_critical; do
            bootstrap_stage3_verify_value "$bsfc_key" "$bootstrap_stage3_manifest" >/dev/null || return 1
        done
    fi
    [ "$(bootstrap_stage3_verify_value stage2_sanity_status \
        "$bootstrap_stage3_manifest")" = pass ] || return 1
    [ "$(bootstrap_stage3_verify_value stage2_receiver_status \
        "$bootstrap_stage3_manifest")" = pass ] || return 1
    [ "$(bootstrap_stage3_verify_value stage2_check_policy \
        "$bootstrap_stage3_manifest")" = \
        identity-scoped-receipt-reuse ] || return 1
    [ "$(bootstrap_stage3_verify_value stage2_checks_executed_at_admission \
        "$bootstrap_stage3_manifest")" = 1 ] || return 1
    [ "$(bootstrap_stage3_verify_value stage2_checks_replayed_during_stage3 \
        "$bootstrap_stage3_manifest")" = 0 ] || return 1
    [ "$(bootstrap_stage3_verify_value stage3_sanity_status \
        "$bootstrap_stage3_manifest")" = pass ] || return 1
    [ "$(bootstrap_stage3_verify_value bootstrap_script_path \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_root/scripts/bootstrap/bootstrap-from-scratch.sh" ] ||
        return 1
    [ "$(bootstrap_stage3_verify_value provenance_helper_path \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_root/scripts/check/lib/bootstrap-stage3-provenance.shs" ] ||
        return 1
    bootstrap_stage3_manifest_a_failure_code=V3
    [ "$(bootstrap_stage3_verify_value provenance_helper_bundle_fingerprint \
        "$bootstrap_stage3_manifest")" = \
        "$(bootstrap_stage3_helper_bundle_fingerprint)" ] || return 1
    bootstrap_stage3_manifest_a_failure_code=V4
    bootstrap_stage3_manifest_dir=$(dirname -- "$bootstrap_stage3_manifest_display")
    [ "$(bootstrap_stage3_verify_value source_snapshot_path \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_manifest_dir/source-inputs-after.txt" ] || return 1
    for bootstrap_stage3_sha_key in source_fingerprint seed_sha256 \
        seed_inputs_fingerprint seed_inputs_stamp_sha256 native_all_sha256 \
        stage2_sha256 stage2_admitted_sha256 \
        stage2_build_args_sha256 stage2_build_log_sha256 \
        stage2_command_transcript_sha256 stage2_sanity_evidence_sha256 \
        stage2_receiver_evidence_sha256 stage2_admission_identity \
        stage2_admission_receipt_sha256 \
        stage3_sha256 stage3_build_args_sha256 stage3_build_log_sha256 \
        stage3_command_transcript_sha256 stage3_sanity_evidence_sha256 \
        stage3_jobs_receipt_sha256 \
        runtime_origin_snapshot_sha256 runtime_admitted_snapshot_sha256 \
        tool_authority_sha256 \
        git_state_sha256 git_dirty_fingerprint \
        bootstrap_script_sha256 provenance_helper_sha256 \
        provenance_helper_bundle_fingerprint \
        source_snapshot_sha256 output_sha256 \
        bound_artifact_authority_map_sha256; do
        bootstrap_stage3_sha_value=$(
            bootstrap_stage3_verify_value "$bootstrap_stage3_sha_key" \
                "$bootstrap_stage3_manifest"
        ) || return 1
        printf '%s\n' "$bootstrap_stage3_sha_value" |
            grep -Eq '^[0-9a-f]{64}$' || return 1
    done
    [ "$(bootstrap_stage3_verify_value bound_artifact_authority_map_path "$bootstrap_stage3_manifest")" = "${bootstrap_stage3_manifest_display}.authority-map.env" ] || return 1
    [ "$(bootstrap_stage3_verify_value bound_artifact_authority_map_sha256 "$bootstrap_stage3_manifest")" = "$(bootstrap_stage3_map_hash)" ] || return 1
    bootstrap_stage3_platform=$(
        bootstrap_stage3_verify_value platform "$bootstrap_stage3_manifest"
    ) || return 1
    [ "$bootstrap_stage3_platform" = \
        "$(bootstrap_stage3_host_platform)" ] ||
        bootstrap_stage3_provenance_fail "manifest-platform-not-host" ||
        return 1
    bootstrap_stage3_backend=$(
        bootstrap_stage3_verify_value backend "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_mode=$(
        bootstrap_stage3_verify_value mode "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_rust_log=$(
        bootstrap_stage3_verify_value build_rust_log \
            "$bootstrap_stage3_manifest"
    ) || return 1
    case "$bootstrap_stage3_rust_log" in
        '')
            return 1
            ;;
        *'
'*)
            return 1
            ;;
    esac
    bootstrap_stage3_stage2_threads=$(
        bootstrap_stage3_verify_value stage2_threads \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_stage3_threads=$(
        bootstrap_stage3_verify_value stage3_threads \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_manifest_a_failure_code=V5
    bootstrap_stage3_stage2_cache_dir=$(bootstrap_stage3_map_value stage2_native_cache_dir_authority) || return 1
    bootstrap_stage3_stage3_cache_dir=$(bootstrap_stage3_map_value stage3_native_cache_dir_authority) || return 1
    [ "$(bootstrap_stage3_verify_value stage2_native_cache_dir "$bootstrap_stage3_manifest")" = \
        "$(bootstrap_stage3_map_value stage2_native_cache_dir_display)" ] || return 1
    [ "$(bootstrap_stage3_verify_value stage3_native_cache_dir "$bootstrap_stage3_manifest")" = \
        "$(bootstrap_stage3_map_value stage3_native_cache_dir_display)" ] || return 1
    [ "$bootstrap_stage3_stage2_cache_dir" != \
        "$bootstrap_stage3_stage3_cache_dir" ] || return 1
    [ -d "$bootstrap_stage3_stage2_cache_dir" ] &&
    :
    [ -d "$bootstrap_stage3_stage3_cache_dir" ] &&
    :
    bootstrap_stage3_runtime_path=$(bootstrap_stage3_map_value runtime_path_authority) || return 1
    if [ "$bootstrap_stage3_portable_map" = 1 ]; then
        bootstrap_stage3_runtime_binding="directory:$(bootstrap_stage3_map_value runtime_path_dev):$(bootstrap_stage3_map_value runtime_path_ino):$(bootstrap_stage3_map_value runtime_path_mode):-" || return 1
        exec 6<"$bootstrap_stage3_runtime_path/." || return 1
        bootstrap_stage3_descriptor_read 6 "$bootstrap_stage3_runtime_binding" \
            directory-check "$bootstrap_stage3_runtime_path" || {
            bootstrap_stage3_provenance_fail "portable-runtime-directory-binding"
            return 1
        }
    fi
    case "$bootstrap_stage3_runtime_path" in
        /proc/[1-9][0-9]*/fd/[1-9][0-9]*)
            expr "$bootstrap_stage3_runtime_path" : \
                '/proc/[1-9][0-9]*/fd/[1-9][0-9]*$' >/dev/null || return 1
            exec 6<"$bootstrap_stage3_runtime_path/." || return 1
            bootstrap_stage3_runtime_path=\
"/proc/$bootstrap_stage3_local_pid/fd/6"
            set -- $(stat -Lc '%d %i %a' "$bootstrap_stage3_runtime_path") || return 1
            [ "$(bootstrap_stage3_map_value runtime_path_dev)" = "$1" ] &&
                [ "$(bootstrap_stage3_map_value runtime_path_ino)" = "$2" ] &&
                [ "$(bootstrap_stage3_map_value runtime_path_mode)" = "$3" ] ||
                return 1
            ;;
    esac
    [ "$(bootstrap_stage3_verify_value runtime_path "$bootstrap_stage3_manifest")" = \
        "$(bootstrap_stage3_map_value runtime_path_display)" ] || return 1
    bootstrap_stage3_manifest_a_failure_code=V6
    bootstrap_stage3_stage2_command_output=$(
        bootstrap_stage3_verify_value stage2_command_output \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_stage3_command_output=$(
        bootstrap_stage3_verify_value stage3_command_output \
            "$bootstrap_stage3_manifest"
    ) || return 1
    case "$bootstrap_stage3_stage2_command_output" in
        /*) bootstrap_stage3_stage2_command_abs=$bootstrap_stage3_stage2_command_output ;;
        *) bootstrap_stage3_stage2_command_abs="$bootstrap_stage3_root/$bootstrap_stage3_stage2_command_output" ;;
    esac
    case "$bootstrap_stage3_stage3_command_output" in
        /*) bootstrap_stage3_stage3_command_abs=$bootstrap_stage3_stage3_command_output ;;
        *) bootstrap_stage3_stage3_command_abs="$bootstrap_stage3_root/$bootstrap_stage3_stage3_command_output" ;;
    esac
    [ "$(bootstrap_stage3_verify_value stage2_path \
        "$bootstrap_stage3_manifest")" = "$bootstrap_stage3_stage2_command_abs" ] ||
        return 1
    [ "$(bootstrap_stage3_verify_value stage3_path \
        "$bootstrap_stage3_manifest")" = "$bootstrap_stage3_stage3_command_abs" ] ||
        return 1
    bootstrap_stage3_manifest_output_root=$(
        CDPATH= cd -- "$bootstrap_stage3_manifest_dir/../.." && pwd -P
    ) || return 1
    bootstrap_stage3_expected_stage2_path=$(bootstrap_stage3_map_value stage2_display) || return 1
    bootstrap_stage3_normalized_absolute "$bootstrap_stage3_expected_stage2_path" || return 1
    bootstrap_stage3_stage2_suffix="/stage2/$bootstrap_stage3_platform/simple"
    case "$bootstrap_stage3_platform" in
        *windows*) bootstrap_stage3_stage2_suffix="${bootstrap_stage3_stage2_suffix}.exe" ;;
    esac
    case "$bootstrap_stage3_expected_stage2_path" in
        *"$bootstrap_stage3_stage2_suffix") ;;
        *) bootstrap_stage3_provenance_fail "stage2-path-outside-canonical-lane"; return 1 ;;
    esac
    bootstrap_stage3_stage2_output_display=${bootstrap_stage3_expected_stage2_path%"$bootstrap_stage3_stage2_suffix"}
    bootstrap_stage3_normalized_absolute "$bootstrap_stage3_stage2_output_display" || return 1
    # Current producers place Stage 2 directly in this manifest's output root.
    # Retain support for independently bound historical transaction/output donors.
    case "$bootstrap_stage3_stage2_output_display" in
        "$bootstrap_stage3_manifest_output_root"|*/output) ;;
        *) bootstrap_stage3_provenance_fail "stage2-path-outside-canonical-lane"; return 1 ;;
    esac
    [ "$(bootstrap_stage3_verify_value stage2_path \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_stage2_path" ] ||
        bootstrap_stage3_provenance_fail "stage2-path-outside-canonical-lane" ||
        return 1
    bootstrap_stage3_expected_stage2_admitted_path=\
"$bootstrap_stage3_stage2_output_display/stage3/$bootstrap_stage3_platform/stage2-admitted/simple"
    case "$bootstrap_stage3_platform" in
        *windows*) bootstrap_stage3_expected_stage2_admitted_path="${bootstrap_stage3_expected_stage2_admitted_path}.exe" ;;
    esac
    [ "$(bootstrap_stage3_map_value stage2_admitted_display)" = \
        "$bootstrap_stage3_expected_stage2_admitted_path" ] || return 1
    [ "$(bootstrap_stage3_verify_value stage2_admitted_path \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_stage2_admitted_path" ] || return 1
    [ "$(bootstrap_stage3_verify_value stage2_admitted_sha256 \
        "$bootstrap_stage3_manifest")" = \
        "$(bootstrap_stage3_verify_value stage2_sha256 \
            "$bootstrap_stage3_manifest")" ] || return 1
    bootstrap_stage3_expected_stage3_path=\
"$bootstrap_stage3_manifest_output_root/stage3/$bootstrap_stage3_platform/simple"
    case "$bootstrap_stage3_platform" in
        *windows*) bootstrap_stage3_expected_stage3_path="${bootstrap_stage3_expected_stage3_path}.exe" ;;
    esac
    [ "$(bootstrap_stage3_map_value output_display)" = \
        "$bootstrap_stage3_expected_stage3_path" ] || return 1
    [ "$(bootstrap_stage3_verify_value stage3_path \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_stage3_path" ] ||
        bootstrap_stage3_provenance_fail "stage3-path-outside-canonical-lane" ||
        return 1
    for bootstrap_stage3_layout_pair in \
        "git_state_path:git_state:$bootstrap_stage3_manifest_dir/git-state-after.env" \
        "stage2_command_transcript_path:stage2_command_transcript:$bootstrap_stage3_stage2_output_display/stage3/$bootstrap_stage3_platform/stage2-command.transcript" \
        "stage3_command_transcript_path:stage3_command_transcript:$bootstrap_stage3_manifest_dir/stage3-command.transcript" \
        "stage2_sanity_evidence_path:stage2_sanity_evidence:$bootstrap_stage3_stage2_output_display/stage3/$bootstrap_stage3_platform/stage2-sanity.env" \
        "stage2_receiver_evidence_path:stage2_receiver_evidence:$bootstrap_stage3_stage2_output_display/stage3/$bootstrap_stage3_platform/stage2-receiver.env" \
        "stage2_admission_receipt_path:stage2_admission_receipt:$bootstrap_stage3_stage2_output_display/stage3/$bootstrap_stage3_platform/stage2-admitted/admission.env" \
        "stage3_sanity_evidence_path:stage3_sanity_evidence:$bootstrap_stage3_manifest_dir/stage3-sanity.env"; do
        bootstrap_stage3_layout_key=${bootstrap_stage3_layout_pair%%:*}
        bootstrap_stage3_layout_rest=${bootstrap_stage3_layout_pair#*:}
        bootstrap_stage3_layout_role=${bootstrap_stage3_layout_rest%%:*}
        bootstrap_stage3_layout_path=${bootstrap_stage3_layout_rest#*:}
        [ "$(bootstrap_stage3_map_value "${bootstrap_stage3_layout_role}_display")" = \
            "$bootstrap_stage3_layout_path" ] || { bootstrap_stage3_provenance_fail "manifest-stage-layout-map"; return 1; }
        [ "$(bootstrap_stage3_verify_value \
            "$bootstrap_stage3_layout_key" "$bootstrap_stage3_manifest")" = \
            "$bootstrap_stage3_layout_path" ] || { bootstrap_stage3_provenance_fail "manifest-stage-layout-manifest"; return 1; }
    done
    bootstrap_stage3_manifest_a_failure_code=
    bootstrap_stage3_manifest_phase_emit B
    bootstrap_stage3_stage2_transcript=$(bootstrap_stage3_map_value stage2_command_transcript_authority) || return 1
    bootstrap_stage3_stage3_transcript=$(bootstrap_stage3_map_value stage3_command_transcript_authority) || return 1
    if [ "$bootstrap_stage3_manifest_schema" = simple-bootstrap-stage3-provenance-v5 ]; then
        bootstrap_stage3_stage2_executable_authority=$(bootstrap_stage3_map_value stage2_admitted_authority) || return 1
        bootstrap_stage3_stage2_executable_display=$(bootstrap_stage3_map_value stage2_admitted_display) || return 1
        bootstrap_stage3_focused_compositions_verify || return 1
        [ "$(bootstrap_stage3_verify_value source_roots "$bootstrap_stage3_manifest")" = \
            "$bsfc_k1:$bsfc_cuda:src/compiler:src/app:src/lib" ] || return 1
        for bsfc_phase in stage2 stage3; do
            bsfc_transcript=$(bootstrap_stage3_map_value "${bsfc_phase}_command_transcript_authority") || return 1
            if [ "$bsfc_phase" = stage2 ]; then bsfc_evidence_root="$bootstrap_stage3_stage2_output_display/stage3/$bootstrap_stage3_platform"
            else bsfc_evidence_root=$bootstrap_stage3_manifest_dir; fi
            [ "$(bootstrap_stage3_transcript_host_value "$bsfc_transcript" HOME)" = "$bsfc_evidence_root/${bsfc_phase}-home" ] &&
                [ "$(bootstrap_stage3_transcript_host_value "$bsfc_transcript" TMPDIR)" = "$bsfc_evidence_root/${bsfc_phase}-tmp" ] || return 1
            bsfc_expected_hash=$(bootstrap_stage3_focused_command hash "$bsfc_phase") || return 1
            [ "$(bootstrap_stage3_verify_value "${bsfc_phase}_build_args_sha256" "$bootstrap_stage3_manifest")" = "$bsfc_expected_hash" ] || return 1
            bootstrap_stage3_focused_command transcript "$bsfc_phase" || return 1
        done
    else

    bootstrap_stage3_stage2_compiler_ceiling=$(bootstrap_stage3_transcript_compiler_ceiling \
        "$bootstrap_stage3_stage2_transcript") || return 1
    bootstrap_stage3_stage3_compiler_ceiling=$(bootstrap_stage3_transcript_compiler_ceiling \
        "$bootstrap_stage3_stage3_transcript") || return 1

    bootstrap_stage3_stage2_library_path=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage2_transcript" LIBRARY_PATH
    ) || return 1
    bootstrap_stage3_stage2_link_compat=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage2_transcript" \
            SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256
    ) || return 1
    bootstrap_stage3_stage2_progress=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage2_transcript" SIMPLE_BUILD_PROGRESS_EVENTS
    ) || return 1
    bootstrap_stage3_stage2_compile_stack_mib=$(
        bootstrap_stage3_transcript_argv_value_after \
            "$bootstrap_stage3_stage2_transcript" --compile-stack-mib
    ) || return 1
    case "$bootstrap_stage3_stage2_compile_stack_mib" in
        ''|*[!0-9]*|0) return 1 ;;
    esac
    bootstrap_stage3_stage2_timeout=$(
        bootstrap_stage3_transcript_argv_value_after \
            "$bootstrap_stage3_stage2_transcript" --timeout
    ) || return 1
    case "$bootstrap_stage3_stage2_timeout" in
        ''|*[!0-9]*) return 1 ;;
    esac
    bootstrap_stage3_stage3_library_path=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" LIBRARY_PATH
    ) || return 1
    bootstrap_stage3_stage3_link_compat=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" \
            SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256
    ) || return 1
    bootstrap_stage3_stage3_progress=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" SIMPLE_BUILD_PROGRESS_EVENTS
    ) || return 1
    bootstrap_stage3_stage3_profile=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" SIMPLE_COMPILER_PHASE_PROFILE_FILE
    ) || return 1
    bootstrap_stage3_stage3_memory=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" SIMPLE_MEM_SNAPSHOT_FILE
    ) || return 1
    bootstrap_stage3_stage3_evidence_run=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" SIMPLE_EVIDENCE_RUN_ID
    ) || return 1
    bootstrap_stage3_stage3_timeout=$(
        bootstrap_stage3_transcript_argv_value_after \
            "$bootstrap_stage3_stage3_transcript" --timeout
    ) || return 1
    case "$bootstrap_stage3_stage3_timeout" in
        ''|*[!0-9]*) return 1 ;;
    esac
    bootstrap_stage3_stage3_arena_decls=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" SIMPLE_NATIVE_ARENA_DECLS
    ) || return 1
    bootstrap_stage3_stage3_streaming=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" SIMPLE_STAGE3_STREAMING_SURFACES
    ) || return 1
    bootstrap_stage3_malloc_arena_max=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" MALLOC_ARENA_MAX
    ) || return 1
    bootstrap_stage3_malloc_trim_threshold=$(
        bootstrap_stage3_transcript_explicit_env_value \
            "$bootstrap_stage3_stage3_transcript" MALLOC_TRIM_THRESHOLD_
    ) || return 1
    bootstrap_stage3_expected_progress=\
"$bootstrap_stage3_manifest_output_root/bootstrap-build-progress.events"
    [ "$bootstrap_stage3_stage2_library_path" = \
        "$bootstrap_stage3_stage3_library_path" ] &&
        [ "$bootstrap_stage3_stage2_link_compat" = \
            "$bootstrap_stage3_stage3_link_compat" ] &&
        [ "$bootstrap_stage3_stage3_arena_decls" = 1 ] &&
        [ "$bootstrap_stage3_stage3_streaming" = 1 ] &&
        [ "$bootstrap_stage3_malloc_arena_max" = 2 ] &&
        [ "$bootstrap_stage3_malloc_trim_threshold" = 0 ] || return 1
    case "$bootstrap_stage3_stage2_progress" in
        ''|"$bootstrap_stage3_expected_progress") ;;
        *) bootstrap_stage3_provenance_fail "build-progress-path-outside-output-root"; return 1 ;;
    esac
    [ "$bootstrap_stage3_stage3_progress" = "$bootstrap_stage3_expected_progress" ] ||
        bootstrap_stage3_provenance_fail "build-progress-path-outside-output-root" ||
        return 1
    [ "$bootstrap_stage3_stage3_profile" = \
        "$bootstrap_stage3_manifest_dir/phase-profile-v1.events" ] &&
        [ "$bootstrap_stage3_stage3_memory" = \
            "$bootstrap_stage3_manifest_dir/memory-snapshot-v1.events" ] || return 1
    [ "$(bootstrap_stage3_transcript_host_value \
        "$bootstrap_stage3_stage3_transcript" HOME)" = \
        "$bootstrap_stage3_manifest_dir/stage3-home" ] &&
        [ "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage3_transcript" TMPDIR)" = \
            "$bootstrap_stage3_manifest_dir/stage3-tmp" ] || return 1
    bootstrap_stage3_expected_stage2_args=$(
        bootstrap_stage3_args_sha256 \
            "RUST_LOG=$bootstrap_stage3_rust_log" \
            "LIBRARY_PATH=$bootstrap_stage3_stage2_library_path" \
            "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage3_stage2_link_compat" \
            "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
            "SIMPLE_NATIVE_BUILD_RUST=1" \
            "SIMPLE_NO_STUB_FALLBACK=1" \
            "SIMPLE_BUILD_PROGRESS_EVENTS=$bootstrap_stage3_stage2_progress" \
            "SIMPLE_BINARY=$(bootstrap_stage3_map_value seed_display)" \
            ${bootstrap_stage3_stage2_compiler_ceiling:+"SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB=$bootstrap_stage3_stage2_compiler_ceiling"} \
            native-build --target "$bootstrap_stage3_platform" \
            --backend "$bootstrap_stage3_backend" \
            --runtime-bundle core-c-bootstrap \
            --source src/compiler --source src/app --source src/lib \
            --entry-closure --threads "$bootstrap_stage3_stage2_threads" \
            --timeout "$bootstrap_stage3_stage2_timeout" \
            --compile-stack-mib "$bootstrap_stage3_stage2_compile_stack_mib" \
            --cache-dir "$(bootstrap_stage3_map_value stage2_native_cache_dir_display)" \
            --mode "$bootstrap_stage3_mode" \
            --entry src/app/cli/bootstrap_main.spl \
            --runtime-path "$(bootstrap_stage3_map_value runtime_path_display)" \
            -o "$(bootstrap_stage3_map_value stage2_display)"
    )
    [ "$(bootstrap_stage3_verify_value stage2_build_args_sha256 \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_stage2_args" ] || return 1
    bootstrap_stage3_seed_executable=$(bootstrap_stage3_map_value seed_display) || return 1
    bootstrap_stage3_verify_command_transcript \
        "$bootstrap_stage3_stage2_transcript" "$bootstrap_stage3_root" \
        "RUST_LOG=$bootstrap_stage3_rust_log" \
        "LIBRARY_PATH=$bootstrap_stage3_stage2_library_path" \
        "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage3_stage2_link_compat" \
        "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
        "SIMPLE_NATIVE_BUILD_RUST=1" "SIMPLE_NO_STUB_FALLBACK=1" \
        "SIMPLE_BUILD_PROGRESS_EVENTS=$bootstrap_stage3_stage2_progress" \
        "SIMPLE_BINARY=$bootstrap_stage3_seed_executable" \
        ${bootstrap_stage3_stage2_compiler_ceiling:+"SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB=$bootstrap_stage3_stage2_compiler_ceiling"} -- \
        "$bootstrap_stage3_seed_executable" \
        native-build --target "$bootstrap_stage3_platform" \
        --backend "$bootstrap_stage3_backend" \
        --runtime-bundle core-c-bootstrap \
        --source src/compiler --source src/app --source src/lib \
        --entry-closure --threads "$bootstrap_stage3_stage2_threads" \
        --timeout "$bootstrap_stage3_stage2_timeout" \
        --compile-stack-mib "$bootstrap_stage3_stage2_compile_stack_mib" \
        --cache-dir "$(bootstrap_stage3_map_value stage2_native_cache_dir_display)" \
        --mode "$bootstrap_stage3_mode" \
        --entry src/app/cli/bootstrap_main.spl \
        --runtime-path "$(bootstrap_stage3_map_value runtime_path_display)" \
        -o "$(bootstrap_stage3_map_value stage2_display)" || { bootstrap_stage3_provenance_fail "manifest-stage-stage2-transcript"; return 1; }
    bootstrap_stage3_expected_stage3_args=$(
        bootstrap_stage3_args_sha256 \
            "RUST_LOG=$bootstrap_stage3_rust_log" \
            "LIBRARY_PATH=$bootstrap_stage3_stage3_library_path" \
            "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage3_stage3_link_compat" \
            "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
            "SIMPLE_STAGE3_STREAMING_SURFACES=$bootstrap_stage3_stage3_streaming" \
            "SIMPLE_FRONTEND_CACHE=0" \
            "MALLOC_ARENA_MAX=$bootstrap_stage3_malloc_arena_max" \
            "MALLOC_TRIM_THRESHOLD_=$bootstrap_stage3_malloc_trim_threshold" \
            "SIMPLE_NATIVE_ARENA_DECLS=$bootstrap_stage3_stage3_arena_decls" \
            "SIMPLE_NO_STUB_FALLBACK=1" \
            "SIMPLE_PACKAGE_INDEX_COLD_INIT=1" \
            "SIMPLE_BUILD_PROGRESS_EVENTS=$bootstrap_stage3_stage3_progress" \
            "SIMPLE_COMPILER_PHASE_PROFILE=1" \
            "SIMPLE_COMPILER_PHASE_PROFILE_FILE=$bootstrap_stage3_stage3_profile" \
            "SIMPLE_MEM_SNAPSHOT_FILE=$bootstrap_stage3_stage3_memory" \
            "SIMPLE_EVIDENCE_RUN_ID=$bootstrap_stage3_stage3_evidence_run" \
            "LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING=1" \
            "SIMPLE_NATIVE_BUILD_TARGET=$bootstrap_stage3_platform" \
            "SIMPLE_NATIVE_BUILD_THREADS=$bootstrap_stage3_stage3_threads" \
            "SIMPLE_NATIVE_BUILD_CACHE_DIR=$(bootstrap_stage3_map_value stage3_native_cache_dir_display)" \
            "SIMPLE_RUNTIME_PATH=$(bootstrap_stage3_map_value runtime_path_display)" \
            "SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap" \
            "SIMPLE_BINARY=$(bootstrap_stage3_map_value stage2_admitted_display)" \
            ${bootstrap_stage3_stage3_compiler_ceiling:+"SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB=$bootstrap_stage3_stage3_compiler_ceiling"} \
            native-build --target "$bootstrap_stage3_platform" \
            --backend "$bootstrap_stage3_backend" \
            --runtime-bundle core-c-bootstrap \
            --threads "$bootstrap_stage3_stage3_threads" \
            --timeout "$bootstrap_stage3_stage3_timeout" \
            --cache-dir "$(bootstrap_stage3_map_value stage3_native_cache_dir_display)" \
            --mode "$bootstrap_stage3_mode" \
            --runtime-path "$(bootstrap_stage3_map_value runtime_path_display)" \
            -o "$bootstrap_stage3_expected_output_display" \
            src/app/cli/bootstrap_main.spl
    )
    [ "$(bootstrap_stage3_verify_value stage3_build_args_sha256 \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_stage3_args" ] || return 1
    bootstrap_stage3_stage2_executable_authority=$(bootstrap_stage3_map_value stage2_admitted_authority) || return 1
    bootstrap_stage3_stage2_executable_display=$(bootstrap_stage3_map_value stage2_admitted_display) || return 1
    bootstrap_stage3_verify_command_transcript \
        "$bootstrap_stage3_stage3_transcript" "$bootstrap_stage3_root" \
        "RUST_LOG=$bootstrap_stage3_rust_log" \
        "LIBRARY_PATH=$bootstrap_stage3_stage3_library_path" \
        "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=$bootstrap_stage3_stage3_link_compat" \
        "SIMPLE_BOOTSTRAP=1" "SIMPLE_NO_DEPRECATED_WARNINGS=1" \
        "SIMPLE_STAGE3_STREAMING_SURFACES=$bootstrap_stage3_stage3_streaming" \
        "SIMPLE_FRONTEND_CACHE=0" \
        "MALLOC_ARENA_MAX=$bootstrap_stage3_malloc_arena_max" \
        "MALLOC_TRIM_THRESHOLD_=$bootstrap_stage3_malloc_trim_threshold" \
        "SIMPLE_NATIVE_ARENA_DECLS=$bootstrap_stage3_stage3_arena_decls" \
        "SIMPLE_NO_STUB_FALLBACK=1" \
        "SIMPLE_PACKAGE_INDEX_COLD_INIT=1" \
        "SIMPLE_BUILD_PROGRESS_EVENTS=$bootstrap_stage3_stage3_progress" \
        "SIMPLE_COMPILER_PHASE_PROFILE=1" \
        "SIMPLE_COMPILER_PHASE_PROFILE_FILE=$bootstrap_stage3_stage3_profile" \
        "SIMPLE_MEM_SNAPSHOT_FILE=$bootstrap_stage3_stage3_memory" \
        "SIMPLE_EVIDENCE_RUN_ID=$bootstrap_stage3_stage3_evidence_run" \
        "LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING=1" \
        "SIMPLE_NATIVE_BUILD_TARGET=$bootstrap_stage3_platform" \
        "SIMPLE_NATIVE_BUILD_THREADS=$bootstrap_stage3_stage3_threads" \
        "SIMPLE_NATIVE_BUILD_CACHE_DIR=$(bootstrap_stage3_map_value stage3_native_cache_dir_display)" \
        "SIMPLE_RUNTIME_PATH=$(bootstrap_stage3_map_value runtime_path_display)" \
        "SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap" \
        "SIMPLE_BINARY=$bootstrap_stage3_stage2_executable_display" \
        ${bootstrap_stage3_stage3_compiler_ceiling:+"SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB=$bootstrap_stage3_stage3_compiler_ceiling"} -- \
        "$bootstrap_stage3_stage2_executable_display" \
        native-build --target "$bootstrap_stage3_platform" \
        --backend "$bootstrap_stage3_backend" \
        --runtime-bundle core-c-bootstrap \
        --threads "$bootstrap_stage3_stage3_threads" \
        --timeout "$bootstrap_stage3_stage3_timeout" \
        --cache-dir "$(bootstrap_stage3_map_value stage3_native_cache_dir_display)" \
        --mode "$bootstrap_stage3_mode" \
        --runtime-path "$(bootstrap_stage3_map_value runtime_path_display)" \
        -o "$bootstrap_stage3_expected_output_display" \
        src/app/cli/bootstrap_main.spl || { bootstrap_stage3_provenance_fail "manifest-stage-stage3-transcript"; return 1; }
    fi
    bootstrap_stage3_manifest_phase_emit C

    bootstrap_stage3_output=$(bootstrap_stage3_map_value output_authority) || return 1
    [ "$(bootstrap_stage3_verify_value output_path "$bootstrap_stage3_manifest")" = "$bootstrap_stage3_expected_output_display" ] || return 1
    [ -x "$bootstrap_stage3_output" ] || return 1
    [ "$(bootstrap_stage3_verify_value output_sha256 "$bootstrap_stage3_manifest")" = \
        "$(bootstrap_stage3_hash_file "$bootstrap_stage3_output")" ] || return 1
    [ "$(bootstrap_stage3_verify_value stage3_path "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_output_display" ] || return 1
    [ "$(bootstrap_stage3_verify_value stage3_sha256 "$bootstrap_stage3_manifest")" = \
        "$(bootstrap_stage3_hash_file "$bootstrap_stage3_output")" ] || return 1

    for bootstrap_stage3_pair in \
        seed:seed_path:seed_sha256 native_all:native_all_path:native_all_sha256 \
        stage2:stage2_path:stage2_sha256 stage2_admitted:stage2_admitted_path:stage2_admitted_sha256 \
        stage2_build_log:stage2_build_log_path:stage2_build_log_sha256 \
        stage2_command_transcript:stage2_command_transcript_path:stage2_command_transcript_sha256 \
        stage2_sanity_evidence:stage2_sanity_evidence_path:stage2_sanity_evidence_sha256 \
        stage2_receiver_evidence:stage2_receiver_evidence_path:stage2_receiver_evidence_sha256 \
        stage2_admission_receipt:stage2_admission_receipt_path:stage2_admission_receipt_sha256 \
        stage3_build_log:stage3_build_log_path:stage3_build_log_sha256 \
        stage3_command_transcript:stage3_command_transcript_path:stage3_command_transcript_sha256 \
        stage3_sanity_evidence:stage3_sanity_evidence_path:stage3_sanity_evidence_sha256 \
        jobs_receipt:stage3_jobs_receipt_path:stage3_jobs_receipt_sha256 \
        git_state:git_state_path:git_state_sha256 bootstrap_script:bootstrap_script_path:bootstrap_script_sha256 \
        provenance_helper:provenance_helper_path:provenance_helper_sha256 \
        runtime_origin_snapshot:runtime_origin_snapshot_path:runtime_origin_snapshot_sha256 \
        runtime_admitted_snapshot:runtime_admitted_snapshot_path:runtime_admitted_snapshot_sha256 \
        tool_authority:tool_authority_path:tool_authority_sha256 \
        seed_inputs_stamp:seed_inputs_stamp_path:seed_inputs_stamp_sha256 \
        source_snapshot:source_snapshot_path:source_snapshot_sha256; do
        bootstrap_stage3_role=${bootstrap_stage3_pair%%:*}; bootstrap_stage3_rest=${bootstrap_stage3_pair#*:}
        bootstrap_stage3_path_key=${bootstrap_stage3_rest%%:*}; bootstrap_stage3_sha_key=${bootstrap_stage3_rest#*:}
        [ "$(bootstrap_stage3_verify_value "$bootstrap_stage3_path_key" "$bootstrap_stage3_manifest")" = "$(bootstrap_stage3_map_value "${bootstrap_stage3_role}_display")" ] || return 1
        [ "$(bootstrap_stage3_verify_value "$bootstrap_stage3_sha_key" "$bootstrap_stage3_manifest")" = "$(bootstrap_stage3_map_value "${bootstrap_stage3_role}_sha256")" ] || return 1
    done
    bootstrap_stage3_manifest_phase_emit D
    bootstrap_stage3_runtime_origin_snapshot=$(bootstrap_stage3_map_value runtime_origin_snapshot_authority) || return 1
    bootstrap_stage3_runtime_admitted_snapshot=$(bootstrap_stage3_map_value runtime_admitted_snapshot_authority) || return 1
    cmp -s "$bootstrap_stage3_runtime_origin_snapshot" \
        "$bootstrap_stage3_runtime_admitted_snapshot" || return 1
    bootstrap_stage3_runtime_verify_snapshot=\
"${TMPDIR:?}/stage3-runtime.verify.$bootstrap_stage3_local_pid"
    if [ "$bootstrap_stage3_portable_map" = 1 ]; then
        bootstrap_stage3_descriptor_read 6 "$bootstrap_stage3_runtime_binding" \
            directory-snapshot "$bootstrap_stage3_runtime_path" \
            "$bootstrap_stage3_runtime_verify_snapshot" || {
            bootstrap_stage3_provenance_fail "manifest-stage-runtime-snapshot"
            return 1
        }
    else
    bootstrap_stage3_directory_snapshot \
        "$bootstrap_stage3_runtime_verify_snapshot" \
        "$bootstrap_stage3_runtime_path" || { bootstrap_stage3_provenance_fail "manifest-stage-runtime-snapshot"; return 1; }
    fi
    cmp -s "$bootstrap_stage3_runtime_admitted_snapshot" \
        "$bootstrap_stage3_runtime_verify_snapshot" || {
        rm -f "$bootstrap_stage3_runtime_verify_snapshot"
        bootstrap_stage3_provenance_fail "manifest-stage-runtime-snapshot-mismatch"
        return 1
    }
    rm -f "$bootstrap_stage3_runtime_verify_snapshot"
    bootstrap_stage3_tool_authority_path=$(bootstrap_stage3_map_value tool_authority_authority) || return 1
    bootstrap_stage3_tool_verify=\
"${TMPDIR:?}/stage3-tools.verify.$bootstrap_stage3_local_pid"
    bootstrap_stage3_tool_authority_snapshot \
        "$bootstrap_stage3_tool_verify" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage2_transcript" PATH)" \
        "$bootstrap_stage3_root" || { bootstrap_stage3_provenance_fail "manifest-stage-tool-snapshot"; return 1; }
    cmp -s "$bootstrap_stage3_tool_authority_path" \
        "$bootstrap_stage3_tool_verify" || {
        # Clang-only policy (2026-09-24): bootstrap_stage3_tool_authority_snapshot
        # now names the C driver "clang" (previously "cc") and no longer lists a
        # separate "clang" tool entry. An admitted generation recorded BEFORE
        # this change will legitimately fail this byte-for-byte cmp even though
        # nothing on disk was tampered with -- the recorded snapshot still says
        # "tool=cc|...". Recognize that specific, expected transition and say so
        # plainly instead of leaving it as an unexplained mismatch: the fix is to
        # reseal (regenerate) the admitted authority under the new naming, not to
        # investigate for tampering.
        if grep -q '^tool=cc|' "$bootstrap_stage3_tool_authority_path" 2>/dev/null &&
            ! grep -q '^tool=cc|' "$bootstrap_stage3_tool_verify" 2>/dev/null; then
            echo "bootstrap Stage 3 provenance: NOTE — recorded tool authority" \
                "predates the 2026-09-24 clang-only policy (tool named 'cc'," \
                "not 'clang'); this is an expected invalidation, not tampering." \
                "Reseal by re-running Stage 3 admission for this generation so a" \
                "fresh tool_authority snapshot is recorded under the current" \
                "naming." >&2
        fi
        rm -f "$bootstrap_stage3_tool_verify"
        bootstrap_stage3_provenance_fail "manifest-stage-tool-snapshot-mismatch"
        return 1
    }
    rm -f "$bootstrap_stage3_tool_verify"
    bootstrap_stage3_manifest_phase_emit E
    bootstrap_stage3_seed_stamp=$(bootstrap_stage3_map_value seed_inputs_stamp_authority)
    bootstrap_stage3_seed_path=$(bootstrap_stage3_map_value seed_authority)
    bootstrap_stage3_native_all_path=$(bootstrap_stage3_map_value native_all_authority)
    bootstrap_stage3_seed_stamp_display=$(bootstrap_stage3_map_value seed_inputs_stamp_display) || return 1
    bootstrap_stage3_seed_display=$(bootstrap_stage3_map_value seed_display) || return 1
    bootstrap_stage3_native_all_display=$(bootstrap_stage3_map_value native_all_display) || return 1
    bootstrap_stage3_runtime_display=$(bootstrap_stage3_map_value runtime_path_display) || return 1
    for bootstrap_stage3_runtime_layout_display in \
        "$bootstrap_stage3_seed_stamp_display" "$bootstrap_stage3_seed_display" \
        "$bootstrap_stage3_native_all_display" "$bootstrap_stage3_runtime_display"; do
        bootstrap_stage3_normalized_absolute \
            "$bootstrap_stage3_runtime_layout_display" || return 1
    done
    case "$bootstrap_stage3_seed_display" in
        "$bootstrap_stage3_runtime_display/simple"|"$bootstrap_stage3_runtime_display/simple.exe") ;;
        *) return 1 ;;
    esac
    case "$bootstrap_stage3_native_all_display" in
        "$bootstrap_stage3_runtime_display/libsimple_native_all.a"|\
        "$bootstrap_stage3_runtime_display/simple_native_all.lib") ;;
        *) return 1 ;;
    esac
    [ "$bootstrap_stage3_seed_stamp_display" = \
        "${bootstrap_stage3_seed_display}.inputs.sha256" ] || return 1
    bootstrap_stage3_verify_seed_stamp "$bootstrap_stage3_seed_stamp" \
        "$(bootstrap_stage3_verify_value seed_inputs_fingerprint \
            "$bootstrap_stage3_manifest")" \
        "$bootstrap_stage3_seed_path" "$bootstrap_stage3_native_all_path" \
        "$(bootstrap_stage3_map_value compiler_backfill_authority)" || { bootstrap_stage3_provenance_fail "manifest-stage-seed-stamp"; return 1; }
    [ "$(bootstrap_stage3_verify_value seed_backend \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_backend" ] || return 1
    bootstrap_stage3_seed_features=$(
        bootstrap_stage3_verify_value seed_features \
            "$bootstrap_stage3_manifest"
    ) || return 1
    bootstrap_stage3_seed_authority_path=$(
        bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage2_transcript" PATH
    ) || return 1
    bootstrap_stage3_seed_fingerprint_rederived=$(
        bootstrap_stage3_seed_inputs_fingerprint "$bootstrap_stage3_root" \
            "$bootstrap_stage3_backend" "$bootstrap_stage3_seed_features" \
            "$bootstrap_stage3_seed_authority_path" \
            "$bootstrap_stage3_platform"
    ) || return 1
    [ "$bootstrap_stage3_seed_fingerprint_rederived" = \
        "$(bootstrap_stage3_verify_value seed_inputs_fingerprint \
            "$bootstrap_stage3_manifest")" ] ||
        bootstrap_stage3_provenance_fail \
            "seed-input-fingerprint-current-authority-mismatch" ||
        return 1

    bootstrap_stage3_stage2_sanity=$(bootstrap_stage3_map_value stage2_sanity_evidence_authority) || return 1
    bootstrap_stage3_stage2_sanity_authority=$bootstrap_stage3_stage2_sanity
    bootstrap_stage3_stage2_sanity_display=$(bootstrap_stage3_map_value stage2_sanity_evidence_display) || return 1
    bootstrap_stage3_stage2_sanity_companion_parent=$(bootstrap_stage3_map_value stage2_sanity_companion_parent_authority) || return 1
    bootstrap_stage3_stage2_receiver=$(bootstrap_stage3_map_value stage2_receiver_evidence_authority) || return 1
    bootstrap_stage3_stage2_admission=$(bootstrap_stage3_map_value stage2_admission_receipt_authority) || return 1
    bootstrap_stage3_stage3_sanity=$(bootstrap_stage3_map_value stage3_sanity_evidence_authority) || return 1
    bootstrap_stage3_stage3_sanity_display=$(bootstrap_stage3_map_value stage3_sanity_evidence_display) || return 1
    bootstrap_stage3_stage3_sanity_companion_parent=$(bootstrap_stage3_map_value stage3_sanity_companion_parent_authority) || return 1
    bootstrap_stage3_verify_sanity_evidence_receipt \
        "$bootstrap_stage3_stage2_sanity_authority" \
        "$bootstrap_stage3_stage2_sanity_display" \
        "$bootstrap_stage3_stage2_sanity_companion_parent" \
        "$bootstrap_stage3_stage2_executable_authority" \
        "$bootstrap_stage3_root" || { bootstrap_stage3_provenance_fail "manifest-stage-stage2-sanity"; return 1; }
    bootstrap_stage3_verify_receiver_evidence_receipt \
        "$bootstrap_stage3_stage2_receiver" "$(bootstrap_stage3_map_value stage2_receiver_evidence_display)" \
        "$bootstrap_stage3_stage2_executable_authority" "$bootstrap_stage3_stage2_executable_display" \
        "$bootstrap_stage3_runtime_admitted_snapshot" "$(bootstrap_stage3_map_value runtime_admitted_snapshot_display)" \
        "$(bootstrap_stage3_map_value stage2_receiver_log_authority)" "$(bootstrap_stage3_map_value stage2_receiver_log_display)" || { bootstrap_stage3_provenance_fail "manifest-stage-stage2-receiver"; return 1; }
    bootstrap_stage3_verify_stage2_admission_receipt \
        "$bootstrap_stage3_stage2_admission" "$(bootstrap_stage3_map_value stage2_admission_receipt_display)" \
        "$bootstrap_stage3_stage2_executable_authority" "$bootstrap_stage3_stage2_executable_display" \
        "$(bootstrap_stage3_map_value source_inputs_before_authority)" "$(bootstrap_stage3_map_value source_inputs_before_display)" \
        "$bootstrap_stage3_runtime_admitted_snapshot" "$(bootstrap_stage3_map_value runtime_admitted_snapshot_display)" \
        "$bootstrap_stage3_runtime_path" "$(bootstrap_stage3_map_value runtime_path_display)" \
        "$(bootstrap_stage3_map_value tool_authority_before_authority)" "$(bootstrap_stage3_map_value tool_authority_before_display)" \
        "$(bootstrap_stage3_verify_value stage2_build_args_sha256 \
            "$bootstrap_stage3_manifest")" \
        "$bootstrap_stage3_stage2_sanity_authority" \
        "$bootstrap_stage3_stage2_sanity_display" \
        "$bootstrap_stage3_stage2_sanity_companion_parent" \
        "$bootstrap_stage3_stage2_receiver" "$(bootstrap_stage3_map_value stage2_receiver_evidence_display)" \
        "$(bootstrap_stage3_map_value stage2_receiver_log_authority)" "$(bootstrap_stage3_map_value stage2_receiver_log_display)" \
        "$bootstrap_stage3_root" || { bootstrap_stage3_provenance_fail "manifest-stage-stage2-admission"; return 1; }
    bootstrap_stage3_expected_admission_identity=$(
        bootstrap_stage3_stage2_admission_identity \
            "$(bootstrap_stage3_hash_file \
                "$bootstrap_stage3_stage2_executable_authority")" \
            "$(bootstrap_stage3_verify_value source_snapshot_sha256 \
                "$bootstrap_stage3_manifest")" \
            "$(bootstrap_stage3_verify_value \
                runtime_admitted_snapshot_sha256 \
                "$bootstrap_stage3_manifest")" \
            "$(bootstrap_stage3_verify_value tool_authority_sha256 \
                "$bootstrap_stage3_manifest")" \
            "$(bootstrap_stage3_verify_value stage2_build_args_sha256 \
                "$bootstrap_stage3_manifest")" \
            "$(bootstrap_stage3_verify_value \
                stage2_sanity_evidence_sha256 \
                "$bootstrap_stage3_manifest")" \
            "$(bootstrap_stage3_verify_value \
                stage2_receiver_evidence_sha256 \
                "$bootstrap_stage3_manifest")" \
            "$(bootstrap_stage3_verify_value \
                hosted_runtime_relative_path \
                "$bootstrap_stage3_stage2_admission")" \
            "$(bootstrap_stage3_verify_value hosted_runtime_sha256 \
                "$bootstrap_stage3_stage2_admission")"
    ) || { bootstrap_stage3_provenance_fail "manifest-stage-admission-identity-derive"; return 1; }
    [ "$(bootstrap_stage3_verify_value stage2_admission_identity \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_expected_admission_identity" ] || { bootstrap_stage3_provenance_fail "manifest-stage-admission-identity-manifest"; return 1; }
    [ "$(bootstrap_stage3_verify_value admission_identity \
        "$bootstrap_stage3_stage2_admission")" = \
        "$bootstrap_stage3_expected_admission_identity" ] || { bootstrap_stage3_provenance_fail "manifest-stage-admission-identity-receipt"; return 1; }
    bootstrap_stage3_manifest_phase_emit F
    bootstrap_stage3_verify_sanity_evidence \
        "$bootstrap_stage3_stage3_sanity" \
        "$bootstrap_stage3_stage3_sanity_display" \
        "$bootstrap_stage3_stage3_sanity_companion_parent" \
        "$bootstrap_stage3_output" \
        "$bootstrap_stage3_root" "$bootstrap_stage3_backend" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage3_transcript" HOME)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage3_transcript" TMPDIR)" \
        "$(bootstrap_stage3_transcript_host_value \
            "$bootstrap_stage3_stage3_transcript" PATH)" || { bootstrap_stage3_provenance_fail "manifest-stage-stage3-replay"; return 1; }
    bootstrap_stage3_manifest_phase_emit G

    bootstrap_stage3_recorded_lock=$(
        bootstrap_stage3_verify_value bootstrap_lock_path \
            "$bootstrap_stage3_manifest"
    ) || return 1
    [ "$bootstrap_stage3_recorded_lock" = \
        "${bootstrap_stage3_manifest_output_root}.lock" ] || return 1
    [ "$(bootstrap_stage3_canonical_path "$bootstrap_stage3_recorded_lock")" = \
        "$bootstrap_stage3_recorded_lock" ] || return 1
    bootstrap_stage3_recorded_lock_pid=$(
        bootstrap_stage3_verify_value bootstrap_lock_owner_pid \
            "$bootstrap_stage3_manifest"
    ) || return 1
    case "$bootstrap_stage3_recorded_lock_pid" in
        ''|*[!0-9]*|0) return 1 ;;
    esac

    if [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" != 1 ]; then
        bootstrap_stage3_verify_git_before="${TMPDIR:?}/stage3-git.verify.before.$bootstrap_stage3_local_pid"
        bootstrap_stage3_git_state "$bootstrap_stage3_root" \
            "$bootstrap_stage3_verify_git_before" || return 1
    fi
    bootstrap_stage3_verify_snapshot="${TMPDIR:?}/stage3-source.verify.$bootstrap_stage3_local_pid"
    if [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" = 1 ]; then
        cp -- "$bootstrap_stage3_parent_source" \
            "$bootstrap_stage3_verify_snapshot" || {
            bootstrap_stage3_provenance_fail "descriptor-source-copy-failed"
            return 1
        }
    else
        bootstrap_stage3_source_snapshot "$bootstrap_stage3_verify_snapshot" \
            "$bootstrap_stage3_root" || return 1
    fi
    bootstrap_stage3_current_count=$(
        wc -l <"$bootstrap_stage3_verify_snapshot" | tr -d ' '
    ) || {
        bootstrap_stage3_provenance_fail "descriptor-source-count-failed"
        return 1
    }
    bootstrap_stage3_current_sha=$(
        bootstrap_stage3_hash_file "$bootstrap_stage3_verify_snapshot"
    ) || {
        bootstrap_stage3_provenance_fail "descriptor-source-hash-failed"
        return 1
    }
    if [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" = 1 ]; then
        bootstrap_stage3_captured_git=$(bootstrap_stage3_map_value git_state_authority) || { bootstrap_stage3_provenance_fail "manifest-stage-parent-git-map"; return 1; }
        bootstrap_stage3_git_state_schema_valid "$bootstrap_stage3_captured_git" || { bootstrap_stage3_provenance_fail "manifest-stage-parent-git-map-schema"; return 1; }
        bootstrap_stage3_current_git_sha=$(bootstrap_stage3_hash_file \
            "$bootstrap_stage3_captured_git") || return 1
        [ "$bootstrap_stage3_current_git_sha" = \
            "$(bootstrap_stage3_map_value git_state_sha256)" ] || { bootstrap_stage3_provenance_fail "manifest-stage-parent-git-map-hash"; return 1; }
        [ "$bootstrap_stage3_current_git_sha" = \
            "$(bootstrap_stage3_hash_file "$bootstrap_stage3_parent_git")" ] || { bootstrap_stage3_provenance_fail "manifest-stage-parent-git-external-hash"; return 1; }
        bootstrap_stage3_git_state_schema_valid "$bootstrap_stage3_parent_git" || { bootstrap_stage3_provenance_fail "manifest-stage-parent-git-external-schema"; return 1; }
        bootstrap_stage3_current_git_head=$(bootstrap_stage3_verify_value \
            head "$bootstrap_stage3_captured_git") || return 1
        bootstrap_stage3_current_git_dirty=$(bootstrap_stage3_verify_value \
            dirty_fingerprint "$bootstrap_stage3_captured_git") || return 1
    else
        bootstrap_stage3_verify_git_after="${TMPDIR:?}/stage3-git.verify.after.$bootstrap_stage3_local_pid"
        bootstrap_stage3_git_state "$bootstrap_stage3_root" \
            "$bootstrap_stage3_verify_git_after" || {
            rm -f "$bootstrap_stage3_verify_snapshot" \
                "$bootstrap_stage3_verify_git_before"
            return 1
        }
        cmp -s "$bootstrap_stage3_verify_git_before" \
            "$bootstrap_stage3_verify_git_after" || {
            rm -f "$bootstrap_stage3_verify_snapshot" \
                "$bootstrap_stage3_verify_git_before" \
                "$bootstrap_stage3_verify_git_after"
            return 1
        }
        bootstrap_stage3_current_git_sha=$(bootstrap_stage3_hash_file \
            "$bootstrap_stage3_verify_git_after") || return 1
        bootstrap_stage3_current_git_head=$(bootstrap_stage3_verify_value \
            head "$bootstrap_stage3_verify_git_after") || return 1
        bootstrap_stage3_current_git_dirty=$(bootstrap_stage3_verify_value \
            dirty_fingerprint "$bootstrap_stage3_verify_git_after") || return 1
        rm -f "$bootstrap_stage3_verify_git_before" \
            "$bootstrap_stage3_verify_git_after"
    fi
    rm -f "$bootstrap_stage3_verify_snapshot"
    [ "$(bootstrap_stage3_verify_value source_file_count "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_count" ] || {
        bootstrap_stage3_provenance_fail "descriptor-source-count-mismatch"
        return 1
    }
    [ "$(bootstrap_stage3_verify_value source_fingerprint "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_sha" ] || {
        bootstrap_stage3_provenance_fail "descriptor-source-fingerprint-mismatch"
        return 1
    }
    [ "$(bootstrap_stage3_verify_value source_snapshot_sha256 "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_sha" ] || {
        bootstrap_stage3_provenance_fail "descriptor-source-manifest-hash-mismatch"
        return 1
    }
    if [ "${BOOTSTRAP_STAGE3_DESCRIPTOR_CAPSULE:-0}" = 1 ]; then
        [ "$bootstrap_stage3_current_sha" = \
            "$(bootstrap_stage3_map_value source_inputs_before_sha256)" ] &&
            [ "$bootstrap_stage3_current_sha" = \
                "$(bootstrap_stage3_map_value source_snapshot_sha256)" ] || {
            bootstrap_stage3_provenance_fail "descriptor-source-map-hash-mismatch"
            return 1
        }
    fi
    [ "$(bootstrap_stage3_verify_value git_state_sha256 \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_git_sha" ] || return 1
    [ "$(bootstrap_stage3_verify_value git_head \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_git_head" ] || return 1
    [ "$(bootstrap_stage3_verify_value git_dirty_fingerprint \
        "$bootstrap_stage3_manifest")" = \
        "$bootstrap_stage3_current_git_dirty" ] || return 1
    bootstrap_stage3_manifest_phase_emit H

    bootstrap_stage3_backfill_status=$(
        bootstrap_stage3_verify_value compiler_backfill_status \
            "$bootstrap_stage3_manifest"
    )
    bootstrap_stage3_backfill_path=$(bootstrap_stage3_map_value compiler_backfill_authority)
    bootstrap_stage3_backfill_display=$(bootstrap_stage3_map_value compiler_backfill_display)
    bootstrap_stage3_backfill_sha=$(
        bootstrap_stage3_verify_value compiler_backfill_sha256 \
            "$bootstrap_stage3_manifest"
    )
    case "$bootstrap_stage3_backfill_status" in
        present)
            bootstrap_stage3_normalized_absolute \
                "$bootstrap_stage3_backfill_display" || return 1
            case "$bootstrap_stage3_backfill_display" in
                "$bootstrap_stage3_runtime_display/libsimple_compiler_backfill.a"|\
                "$bootstrap_stage3_runtime_display/simple_compiler_backfill.lib") ;;
                *) bootstrap_stage3_provenance_fail "backfill-display-layout-mismatch"; return 1 ;;
            esac
            bootstrap_stage3_sanity_regular_authority \
                "$bootstrap_stage3_backfill_path" &&
                [ "$bootstrap_stage3_backfill_sha" = \
                    "$(bootstrap_stage3_hash_file "$bootstrap_stage3_backfill_path")" ] ||
                bootstrap_stage3_provenance_fail "backfill-authority-content-mismatch"
                return 1
            ;;
        absent)
            [ "$bootstrap_stage3_backfill_path" = descriptor-absent ] &&
                [ "$bootstrap_stage3_backfill_sha" = absent ] || {
                bootstrap_stage3_provenance_fail "backfill-absent-binding-mismatch"
                return 1
            }
            ;;
        *) bootstrap_stage3_provenance_fail "backfill-status-invalid"; return 1 ;;
    esac

    bootstrap_stage3_manifest_phase_emit I
    printf 'bootstrap_stage3_provenance_status=pass\n'
    printf 'bootstrap_stage3_compiler_path=%s\n' "$bootstrap_stage3_output"
}

# Public verification is deliberately process-scoped: the implementation pins
# immutable inputs on FDs 6-9, and must never close or replace descriptors held
# by a sourced caller.
bootstrap_stage3_verify_manifest() (
    bootstrap_stage3_bound_map_snapshot=
    bootstrap_stage3_bound_map_snapshot_owned=0
    bootstrap_stage3_manifest_snapshot=
    bootstrap_stage3_manifest_snapshot_owned=0
    bootstrap_stage3_manifest_a_failure_code=
    if bootstrap_stage3_verify_manifest_impl "$@"; then
        bootstrap_stage3_verify_manifest_status=0
    else
        bootstrap_stage3_verify_manifest_status=$?
    fi
    if [ "$bootstrap_stage3_verify_manifest_status" -ne 0 ] &&
        [ -n "${bootstrap_stage3_manifest_a_failure_code:-}" ]; then
        case "$bootstrap_stage3_manifest_a_failure_code" in
            [0-9A-V][0-9A-V])
                bootstrap_stage3_manifest_phase_emit \
                    "a$bootstrap_stage3_manifest_a_failure_code" ;;
            l[0-9A-V][0-9A-V])
                bootstrap_stage3_manifest_phase_emit \
                    "$bootstrap_stage3_manifest_a_failure_code" ;;
            *) : ;;
        esac
    fi
    exec 9<&- 2>/dev/null || :
    exec 7<&- 2>/dev/null || :
    exec 6<&- 2>/dev/null || :
    exec 8<&- 2>/dev/null || :
    if [ "${bootstrap_stage3_bound_map_snapshot_owned:-0}" = 1 ] &&
        [ -n "${bootstrap_stage3_bound_map_snapshot:-}" ]; then
        rm -f -- "$bootstrap_stage3_bound_map_snapshot" 2>/dev/null || :
    fi
    if [ "${bootstrap_stage3_manifest_snapshot_owned:-0}" = 1 ] &&
        [ -n "${bootstrap_stage3_manifest_snapshot:-}" ]; then
        rm -f -- "$bootstrap_stage3_manifest_snapshot" 2>/dev/null || :
    fi
    return "$bootstrap_stage3_verify_manifest_status"
)

# Focused negative contract used by the macOS GPU build wrapper. It exercises
# the provenance primitives without running a bootstrap or native build.
