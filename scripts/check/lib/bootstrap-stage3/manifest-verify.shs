    bootstrap_stage3_manifest_a_failure_code=U3
    bootstrap_stage3_manifest_snapshot="${TMPDIR:-/tmp}/stage3-manifest.$bootstrap_stage3_local_pid.snapshot"
    (umask 077; set -C; : >"$bootstrap_stage3_manifest_snapshot") || return 1
