# Canonical caller for the Stage-3 unit supervisor and shared evidence runner.
# The future outer transaction coordinator owns these BSTAGE3_RUN_* bindings;
# this function owns no lock, run-id minting, rollback, or final admission.
bootstrap_stage3_run_evidenced() {
    [ "$#" -eq 0 ] || return 64
    for bootstrap_stage3_run_required in \
        BSTAGE3_RUN_ROOT BSTAGE3_RUN_EVIDENCE BSTAGE3_RUN_ID \
        BSTAGE3_RUN_ARCHITECTURE BSTAGE3_RUN_HEAVY_LOCK \
        BSTAGE3_RUN_OWNER_JOURNAL BSTAGE3_RUN_QUARANTINE \
        BSTAGE3_RUN_SYSTEMD_RUN BSTAGE3_RUN_SYSTEMCTL BSTAGE3_RUN_CGROUP_ROOT \
        BSTAGE3_RUN_HOME BSTAGE3_RUN_TMPDIR BSTAGE3_RUN_PATH \
        BSTAGE3_RUN_SOURCE_OUTPUT BSTAGE3_RUN_STAGE2_TRANSACTION_ROOT \
        BSTAGE3_RUN_COMPATIBILITY_MARKER \
        BSTAGE3_RUN_RAW BSTAGE3_RUN_MEMORY BSTAGE3_RUN_PHASE \
        BSTAGE3_RUN_DESCRIPTOR BSTAGE3_RUN_PARENT_PROVENANCE \
        BSTAGE3_RUN_PARENT_PROVENANCE_VERIFY BSTAGE3_RUN_SOURCE_SNAPSHOT \
        BSTAGE3_RUN_GIT_RECEIPT BSTAGE3_RUN_RUNTIME_SNAPSHOT \
        BSTAGE3_RUN_TOOL_SNAPSHOT BSTAGE3_RUN_STAGE2_ADMISSION \
        BSTAGE3_RUN_PLANNER_RECEIPT BSTAGE3_RUN_CACHE \
        BSTAGE3_RUN_RUNTIME BSTAGE3_RUN_CANDIDATE \
        BSTAGE3_RUN_CANDIDATE_PROVENANCE BSTAGE3_RUN_PROGRESS \
        BSTAGE3_RUN_SUPERVISOR BSTAGE3_RUN_GATE BSTAGE3_RUN_RUNNER \
        BSTAGE3_RUN_SAMPLER BSTAGE3_RUN_ANALYZER \
        BSTAGE3_RUN_ADMITTED_COMPILER BSTAGE3_RUN_DASH BSTAGE3_RUN_PERL \
        BSTAGE3_RUN_ENV_TOOL BSTAGE3_RUN_SESSION_HELPER \
        BSTAGE3_RUN_BOOTSTRAP_SCRIPT BSTAGE3_RUN_CANDIDATE_BUILDER \
        BSTAGE3_RUN_PLANNER BSTAGE3_RUN_PROVENANCE_VERIFIER \
        BSTAGE3_RUN_FACADE BSTAGE3_RUN_SAMPLER_SHA256 \
        BSTAGE3_RUN_ANALYZER_SHA256 BSTAGE3_RUN_ADMITTED_COMPILER_SHA256 \
        BSTAGE3_RUN_DASH_SHA256 BSTAGE3_RUN_CANDIDATE_BUILDER_SHA256 \
        BSTAGE3_RUN_RUNNER_SHA256 BSTAGE3_RUN_PROVENANCE_VERIFIER_SHA256; do
        eval "bootstrap_stage3_run_value=\${$bootstrap_stage3_run_required-}"
        [ -n "$bootstrap_stage3_run_value" ] || {
            echo "bootstrap Stage 3 runner: missing $bootstrap_stage3_run_required" >&2
            return 64
        }
    done
    [ "$BSTAGE3_RUN_ARCHITECTURE" = x86_64-unknown-linux-gnu ] || return 64
    [ "$BSTAGE3_RUN_ID" = "${SIMPLE_EVIDENCE_RUN_ID:-$BSTAGE3_RUN_ID}" ] || return 64
    [ "$(bootstrap_stage3_hash_file "$BSTAGE3_RUN_SAMPLER")" = \
        "$BSTAGE3_RUN_SAMPLER_SHA256" ] || return 65
    [ "$(bootstrap_stage3_hash_file "$BSTAGE3_RUN_ANALYZER")" = \
        "$BSTAGE3_RUN_ANALYZER_SHA256" ] || return 65
    [ "$(bootstrap_stage3_hash_file "$BSTAGE3_RUN_ADMITTED_COMPILER")" = \
        "$BSTAGE3_RUN_ADMITTED_COMPILER_SHA256" ] || return 65
    [ "$(bootstrap_stage3_hash_file "$BSTAGE3_RUN_DASH")" = \
        "$BSTAGE3_RUN_DASH_SHA256" ] || return 65
    [ "$(bootstrap_stage3_hash_file "$BSTAGE3_RUN_CANDIDATE_BUILDER")" = \
        "$BSTAGE3_RUN_CANDIDATE_BUILDER_SHA256" ] || return 65
    [ "$(bootstrap_stage3_hash_file "$BSTAGE3_RUN_RUNNER")" = \
        "$BSTAGE3_RUN_RUNNER_SHA256" ] || return 65
    [ "$(bootstrap_stage3_hash_file "$BSTAGE3_RUN_PROVENANCE_VERIFIER")" = \
        "$BSTAGE3_RUN_PROVENANCE_VERIFIER_SHA256" ] || return 65
    bootstrap_stage3_run_systemd_run_sha256=$(bootstrap_stage3_hash_file \
        "$BSTAGE3_RUN_SYSTEMD_RUN") || return 65
    bootstrap_stage3_run_systemctl_sha256=$(bootstrap_stage3_hash_file \
        "$BSTAGE3_RUN_SYSTEMCTL") || return 65
    [ ! "$BSTAGE3_RUN_SAMPLER" -ef "$BSTAGE3_RUN_ANALYZER" ] &&
        [ ! "$BSTAGE3_RUN_SAMPLER" -ef "$BSTAGE3_RUN_ADMITTED_COMPILER" ] &&
        [ ! "$BSTAGE3_RUN_ANALYZER" -ef "$BSTAGE3_RUN_ADMITTED_COMPILER" ] || {
        echo "bootstrap Stage 3 runner: executable role identity aliases" >&2
        return 65
    }

    "$BSTAGE3_RUN_SUPERVISOR" --phase=stage3 \
        --root="$BSTAGE3_RUN_ROOT" --evidence-dir="$BSTAGE3_RUN_EVIDENCE" \
        --run-id="$BSTAGE3_RUN_ID" --architecture="$BSTAGE3_RUN_ARCHITECTURE" \
        --memory-max=8589934592 --heavy-lock="$BSTAGE3_RUN_HEAVY_LOCK" \
        --owner-journal="$BSTAGE3_RUN_OWNER_JOURNAL" \
        --quarantine="$BSTAGE3_RUN_QUARANTINE" \
        --systemd-run="$BSTAGE3_RUN_SYSTEMD_RUN" \
        --systemctl="$BSTAGE3_RUN_SYSTEMCTL" \
        --cgroup-root="$BSTAGE3_RUN_CGROUP_ROOT" \
        --env="HOME=$BSTAGE3_RUN_HOME" --env="TMPDIR=$BSTAGE3_RUN_TMPDIR" \
        --env="PATH=$BSTAGE3_RUN_PATH" --env=LC_ALL=C --env=LANG=C \
        --env=RUST_LOG=error --env=LIBRARY_PATH= \
        --env=SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=absent \
        --env=SIMPLE_BOOTSTRAP=1 --env=SIMPLE_NO_DEPRECATED_WARNINGS=1 \
        --env=SIMPLE_STAGE3_STREAMING_SURFACES=1 --env=MALLOC_ARENA_MAX=2 \
        --env=MALLOC_TRIM_THRESHOLD_=0 --env=SIMPLE_NATIVE_ARENA_DECLS=1 \
        --env=SIMPLE_NO_STUB_FALLBACK=1 \
        --env="SIMPLE_BUILD_PROGRESS_EVENTS=$BSTAGE3_RUN_PROGRESS" \
        --env=SIMPLE_COMPILER_PHASE_PROFILE=1 \
        --env="SIMPLE_COMPILER_PHASE_PROFILE_FILE=$BSTAGE3_RUN_PHASE" \
        --env="SIMPLE_MEM_SNAPSHOT_FILE=$BSTAGE3_RUN_MEMORY" \
        --env="SIMPLE_EVIDENCE_RUN_ID=$BSTAGE3_RUN_ID" \
        --env=LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING=1 \
        --env="SIMPLE_NATIVE_BUILD_TARGET=$BSTAGE3_RUN_ARCHITECTURE" \
        --env=SIMPLE_NATIVE_BUILD_THREADS=1 \
        --env="SIMPLE_NATIVE_BUILD_CACHE_DIR=$BSTAGE3_RUN_CACHE" \
        --env="SIMPLE_RUNTIME_PATH=$BSTAGE3_RUN_RUNTIME" \
        --env=SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap \
        --env="SIMPLE_BINARY=$BSTAGE3_RUN_ADMITTED_COMPILER" \
        --role="analyzer=$BSTAGE3_RUN_ANALYZER" \
        --role="bootstrap_script=$BSTAGE3_RUN_BOOTSTRAP_SCRIPT" \
        --role="candidate_builder=$BSTAGE3_RUN_CANDIDATE_BUILDER" \
        --role="dash=$BSTAGE3_RUN_DASH" \
        --role="env=$BSTAGE3_RUN_ENV_TOOL" \
        --role="facade=$BSTAGE3_RUN_FACADE" \
        --role="gate_helper=$BSTAGE3_RUN_GATE" \
        --role="gate_interpreter=$BSTAGE3_RUN_DASH" \
        --role="payload=$BSTAGE3_RUN_PERL" \
        --role="planner=$BSTAGE3_RUN_PLANNER" \
        --role="provenance_verifier=$BSTAGE3_RUN_PROVENANCE_VERIFIER" \
        --role="sampler=$BSTAGE3_RUN_SAMPLER" \
        --role="session_helper=$BSTAGE3_RUN_SESSION_HELPER" \
        --role="shared_runner=$BSTAGE3_RUN_RUNNER" \
        --role="transaction_supervisor=$BSTAGE3_RUN_SUPERVISOR" \
        --arg='{role:payload}' --arg='{role:shared_runner}' \
        --arg=--payload-exec --arg='{role:payload}' \
        --arg=--runner-exec --arg='{role:shared_runner}' \
        --arg=--root --arg="$BSTAGE3_RUN_ROOT" \
        --arg=--unit-evidence --arg="$BSTAGE3_RUN_EVIDENCE" \
        --arg=--active-cgroup-receipt \
        --arg="$BSTAGE3_RUN_OWNER_JOURNAL.cgroup" \
        --arg=--run-id --arg="$BSTAGE3_RUN_ID" \
        --arg=--architecture --arg="$BSTAGE3_RUN_ARCHITECTURE" \
        --arg=--source-output --arg="$BSTAGE3_RUN_SOURCE_OUTPUT" \
        --arg=--stage2-transaction-root \
        --arg="$BSTAGE3_RUN_STAGE2_TRANSACTION_ROOT" \
        --arg=--compatibility-marker --arg="$BSTAGE3_RUN_COMPATIBILITY_MARKER" \
        --arg=--raw --arg="$BSTAGE3_RUN_RAW" \
        --arg=--descriptor --arg="$BSTAGE3_RUN_DESCRIPTOR" \
        --arg=--parent-provenance --arg="$BSTAGE3_RUN_PARENT_PROVENANCE" \
        --arg=--parent-provenance-verify-receipt \
        --arg="$BSTAGE3_RUN_PARENT_PROVENANCE_VERIFY" \
        --arg=--source-snapshot --arg="$BSTAGE3_RUN_SOURCE_SNAPSHOT" \
        --arg=--git-receipt --arg="$BSTAGE3_RUN_GIT_RECEIPT" \
        --arg=--runtime-snapshot --arg="$BSTAGE3_RUN_RUNTIME_SNAPSHOT" \
        --arg=--tool-snapshot --arg="$BSTAGE3_RUN_TOOL_SNAPSHOT" \
        --arg=--stage2-admission --arg="$BSTAGE3_RUN_STAGE2_ADMISSION" \
        --arg=--planner-receipt --arg="$BSTAGE3_RUN_PLANNER_RECEIPT" \
        --arg=--candidate-output --arg="$BSTAGE3_RUN_CANDIDATE" \
        --arg=--candidate-provenance --arg="$BSTAGE3_RUN_CANDIDATE_PROVENANCE" \
        --arg=--facade --arg="$BSTAGE3_RUN_FACADE" \
        --arg=--systemd-run --arg="$BSTAGE3_RUN_SYSTEMD_RUN" \
        --arg=--systemd-run-sha256 \
        --arg="$bootstrap_stage3_run_systemd_run_sha256" \
        --arg=--systemctl --arg="$BSTAGE3_RUN_SYSTEMCTL" \
        --arg=--systemctl-sha256 \
        --arg="$bootstrap_stage3_run_systemctl_sha256" \
        --arg=--sampler-exec --arg='{role:sampler}' \
        --arg=--sampler-sha256 --arg="$BSTAGE3_RUN_SAMPLER_SHA256" \
        --arg=--analyzer-exec --arg='{role:analyzer}' \
        --arg=--analyzer-sha256 --arg="$BSTAGE3_RUN_ANALYZER_SHA256" \
        --arg=--admitted-compiler --arg="$BSTAGE3_RUN_ADMITTED_COMPILER" \
        --arg=--admitted-compiler-sha256 \
        --arg="$BSTAGE3_RUN_ADMITTED_COMPILER_SHA256" \
        --arg=--dash-exec --arg='{role:dash}' \
        --arg=--dash-sha256 --arg="$BSTAGE3_RUN_DASH_SHA256" \
        --arg=--candidate-builder-sha256 --arg="$BSTAGE3_RUN_CANDIDATE_BUILDER_SHA256" \
        --arg=--runner-sha256 --arg="$BSTAGE3_RUN_RUNNER_SHA256" \
        --arg=--provenance-verifier-sha256 \
        --arg="$BSTAGE3_RUN_PROVENANCE_VERIFIER_SHA256"
}
