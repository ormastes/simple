#!/bin/sh
# xray-inprocess-e2e-lib.shs — the ISA-neutral body of the XRay native
# in-process end-to-end checks. Sourced, never run:
#   scripts/check/check-xray-native-inprocess-e2e.shs         (AArch64, PR5b)
#   scripts/check/check-xray-native-x86-64-inprocess-e2e.shs  (x86-64 SysV)
#
# The sourcing wrapper sets, before calling xr_main "$@":
#   XR_NAME        script name for --help / temp dirs
#   XR_UNAME_M     required `uname -m` (the full run ERRORs on any other host)
#   XR_TRIPLE      target triple of the OFF twin build
# and defines XR_ISA_SELFTEST_CHECKS plus four ISA hooks (all but the first
# read files under $WORK):
#   xr_isa_selftest      the ISA classifiers' fixtures; 0 when all judged
#                        right (run by --selftest on every host)
#   xr_isa_sleds         count sleds + direct trampoline calls in on.dis;
#                        print the sled count and return 0, or print a FAIL
#                        reason and return 1
#   xr_isa_off_sleds     print the number of sleds in off.dis
#   xr_isa_twin          compare the linked trampoline with its Simple twin
#                        and check the handler is a leaf; 0 ok, 1 FAIL
#                        (reason echoed), 2 ERROR (reason echoed)
#
# Shared flow (see the wrappers' headers for the per-ISA facts):
#   1. build test/fixtures/xray/xray_inprocess_prog.spl through `cli_compile`
#      with and without --xray (shared-library intent);
#   2. link inspection: .simple_xray_map, PROTECTED trampoline + runtime entry
#      points, direct sled calls (hook), an OFF module free of XRay artifacts;
#   3. trampoline twin + handler leaf rules (hook);
#   4. test/fixtures/xray/xray_native_inprocess_host.spl in ONE process:
#      dlopen, map, admission, registration, aspect pointcuts -> selection ->
#      real rt_mprotect patching across two sessions; per-session verdicts.
# Verdict (last stdout line): PASS — / FAIL — / ERROR — nothing was checked.

# field <log> <session> <key>: value of "E2E <session> ... key=value".
xr_field() {
    sed -n "s/^E2E $2 .*$3=\([^ ]*\).*/\1/p" "$1" | head -1
}

# Session verdict over a host log: 0 ok, 1 wrong.
# xr_session_ok <log> <label> <expected words_on> <expected record count>
xr_session_ok() {
    [ "$(xr_field "$1" "$2" words_on)" = "$3" ] || return 1
    [ "$(xr_field "$1" "$2" words_off | tr -d 'B')" = "" ] || return 1
    [ -n "$(xr_field "$1" "$2" words_off)" ] || return 1
    on=$(xr_field "$1" "$2" results_on); base=$(xr_field "$1" "$2" baseline); off=$(xr_field "$1" "$2" results_off)
    [ -n "$base" ] && [ "$on" = "$base" ] && [ "$off" = "$base" ] || return 1
    [ "$(xr_field "$1" "$2" records_after_stop)" = "0" ] || return 1
    n=$(sed -n "s/^E2E $2 records=\[\(.*\)\]$/\1/p" "$1" | tr ',' '\n' | grep -c ':')
    [ "$n" -eq "$4" ] || return 1
    return 0
}

xr_selftest() {
    t=$(mktemp "${TMPDIR:-/tmp}/xray-inproc-selftest.XXXXXX") || return 1
    printf '%s\n' "E2E s1 selected_sites=[1, 2] words_on=NNB" \
        "E2E s1 results_on=1,2, baseline=1,2," \
        "E2E s1 records=[1:1:1, 2:1:2]" "E2E s1 words_off=BBB" \
        "E2E s1 results_off=1,2, records_after_stop=0 lost=0" > "$t"
    xr_session_ok "$t" s1 NNB 2 || { rm -f "$t"; return 1; }
    # each mutation must be rejected
    sed 's/words_off=BBB/words_off=BNB/' "$t" > "$t.m"; xr_session_ok "$t.m" s1 NNB 2 && { rm -f "$t" "$t.m"; return 1; }
    sed 's/results_on=1,2,/results_on=1,3,/' "$t" > "$t.m"; xr_session_ok "$t.m" s1 NNB 2 && { rm -f "$t" "$t.m"; return 1; }
    sed 's/records_after_stop=0/records_after_stop=1/' "$t" > "$t.m"; xr_session_ok "$t.m" s1 NNB 2 && { rm -f "$t" "$t.m"; return 1; }
    xr_session_ok "$t" s1 NNB 3 && { rm -f "$t" "$t.m"; return 1; }
    xr_session_ok "$t" s1 NNN 2 && { rm -f "$t" "$t.m"; return 1; }
    : > "$t.m"; xr_session_ok "$t.m" s1 NNB 2 && { rm -f "$t" "$t.m"; return 1; }
    rm -f "$t" "$t.m"
    return 0
}

xr_main() {
    ROOT=$(cd "$(dirname "$0")/../.." && pwd)
    SIMPLE_BIN=${SIMPLE_BIN:-}
    KEEP=0
    SELFTEST_ONLY=0
    CC=${CLANG:-clang}
    OBJDUMP=${LLVM_OBJDUMP:-llvm-objdump}
    READELF=${LLVM_READELF:-llvm-readelf}
    STEP_TIMEOUT=${XRAY_E2E_TIMEOUT:-1500}

    while [ $# -gt 0 ]; do
        case "$1" in
            --simple) SIMPLE_BIN=${2:-}; shift 2 ;;
            --keep) KEEP=1; shift ;;
            --selftest) SELFTEST_ONLY=1; shift ;;
            -h|--help) sed -n '2,/^set -u/p' "$0" | sed '$d'; exit 0 ;;
            *) echo "ERROR — nothing was checked (unknown argument: $1)"; exit 2 ;;
        esac
    done

    if ! xr_selftest; then
        echo "ERROR — nothing was checked (selftest failed: session verdict misjudged a fixture)"
        exit 2
    fi
    if ! xr_isa_selftest; then
        echo "ERROR — nothing was checked (selftest failed: an ISA classifier misjudged a fixture)"
        exit 2
    fi
    if [ "$SELFTEST_ONLY" -eq 1 ]; then
        echo "PASS — $((7 + XR_ISA_SELFTEST_CHECKS)) check(s) (selftest: session verdict + ISA classifier fixtures)"
        exit 0
    fi

    [ -n "$SIMPLE_BIN" ] || { echo "ERROR — nothing was checked (no --simple binary)"; exit 2; }
    case "$SIMPLE_BIN" in /*) ;; */*) SIMPLE_BIN=$(cd "$(dirname "$SIMPLE_BIN")" && pwd)/$(basename "$SIMPLE_BIN") ;; esac
    if [ "$(uname -m)" != "$XR_UNAME_M" ] || [ "$(uname -s)" != "Linux" ]; then
        echo "ERROR — nothing was checked (in-process patching needs a $XR_UNAME_M Linux host, this is $(uname -m) $(uname -s))"
        exit 2
    fi
    for tool in "$SIMPLE_BIN" "$CC" "$OBJDUMP" "$READELF"; do
        command -v "$tool" >/dev/null 2>&1 || { echo "ERROR — nothing was checked (missing tool: $tool)"; exit 2; }
    done

    WORK=$(mktemp -d "${TMPDIR:-/tmp}/$XR_NAME.XXXXXX") || {
        echo "ERROR — nothing was checked (cannot create temp dir)"; exit 2; }
    trap 'xr_cleanup' EXIT
    cd "$ROOT" || { echo "ERROR — nothing was checked (cannot cd to $ROOT)"; exit 2; }

    PROG=test/fixtures/xray/xray_inprocess_prog.spl
    STEM=xray_inprocess_prog
    checks=0

    # ---- 1. build ON and OFF modules through the CLI entry
    # The native shared link invokes `cc`; on hosts where that is GCC, shadow
    # it with clang + lld (repo rule: never GCC).
    mkdir -p "$WORK/ccshim" && printf '#!/bin/sh\nexec %s -fuse-ld=lld "$@"\n' "$(command -v "$CC")" > "$WORK/ccshim/cc" && chmod +x "$WORK/ccshim/cc"
    xr_build "$WORK/libon.so" 1 || { echo "FAIL — --xray build failed: $(grep -E 'error|CLI-COMPILE' "$WORK/libon.so.log" | head -1)"; exit 1; }
    xr_build "$WORK/liboff.so" 0 || { echo "FAIL — OFF build failed: $(grep -E 'error|CLI-COMPILE' "$WORK/liboff.so.log" | head -1)"; exit 1; }

    # ---- 2. link inspection
    "$READELF" -S -W --dyn-syms "$WORK/libon.so" > "$WORK/on.inspect" 2>&1
    grep -qE '\] \.simple_xray_map ' "$WORK/on.inspect" || { echo "FAIL — --xray module has no .simple_xray_map"; exit 1; }
    for sym in __simple_xray_trampoline_v1 simple_xray_native_register_module_v1 simple_xray_native_install_v1; do
        grep -qE "FUNC +GLOBAL +PROTECTED .* $sym\$" "$WORK/on.inspect" || { echo "FAIL — $sym is not a PROTECTED global function"; exit 1; }
    done
    checks=$((checks + 4))
    "$OBJDUMP" -d "$WORK/libon.so" > "$WORK/on.dis" 2>&1
    XR_SLEDS=$(xr_isa_sleds) || { echo "FAIL — $XR_SLEDS"; exit 1; }
    checks=$((checks + 1))
    "$READELF" -S -W -s "$WORK/liboff.so" > "$WORK/off.inspect" 2>&1
    [ "$(grep -cE 'simple_xray|__xray_' "$WORK/off.inspect")" -eq 0 ] || { echo "FAIL — OFF module carries XRay sections/symbols"; exit 1; }
    "$OBJDUMP" -d "$WORK/liboff.so" > "$WORK/off.dis" 2>&1
    [ "$(xr_isa_off_sleds)" -eq 0 ] || { echo "FAIL — OFF module carries sleds"; exit 1; }
    checks=$((checks + 2))

    # ---- 3. trampoline twin + handler leaf rules (read from the module the
    # driver actually linked, not a fresh build)
    reason=$(xr_isa_twin)
    case $? in
        0) checks=$((checks + 2)) ;;
        1) echo "FAIL — $reason"; exit 1 ;;
        *) echo "ERROR — nothing was checked ($reason)"; exit 2 ;;
    esac

    # ---- 4. in-process sessions
    env XRAY_E2E_LIB="$WORK/libon.so" XRAY_E2E_FUNCTIONS="traced,scaled" \
        XRAY_E2E_POINTCUTS_1="traced" XRAY_E2E_POINTCUTS_2="scaled" \
        timeout "$STEP_TIMEOUT" "$SIMPLE_BIN" run test/fixtures/xray/xray_native_inprocess_host.spl > "$WORK/host.log" 2>&1
    host_rc=$?
    grep -E '^E2E' "$WORK/host.log" > "$WORK/host.e2e"
    if ! grep -q '^E2E-HOST-OK' "$WORK/host.e2e"; then
        echo "FAIL — in-process host did not complete (rc=$host_rc): $(grep -E 'E2E-HOST-ERROR' "$WORK/host.e2e" | head -1)"
        exit 1
    fi
    # Map order is sorted by name: add1 (2 sites), scaled (3: two returns),
    # traced (2). Words in site order. Baseline values are the source
    # semantics: traced(x) = (x+1)*2+40, scaled(0) = 7, scaled(x) = 3x.
    base=$(sed -n 's/^E2E baseline=\(.*\)/\1/p' "$WORK/host.e2e")
    [ "$base" = "42,60,32,7,27,-15," ] || { echo "FAIL — untraced results are wrong: $base"; exit 1; }
    checks=$((checks + 1))
    fns=$(sed -n 's/^E2E map functions=\[\(.*\)\] sites=.*/\1/p' "$WORK/host.e2e")
    case "$fns" in *".$STEM.add1, "*".$STEM.scaled, "*".$STEM.traced"|"$STEM.add1, $STEM.scaled, $STEM.traced") true ;; *) false ;; esac || { echo "FAIL — unexpected map functions: $fns"; exit 1; }
    checks=$((checks + 1))
    # s1 = traced: its 2 sleds on; 3 calls of traced -> 3 entry + 3 exit;
    # scaled untraced. add1 (called by traced) is not selected and records
    # nothing.
    xr_session_ok "$WORK/host.e2e" s1 BBBBBNN 6 || { echo "FAIL — session 1 (pointcut traced): $(grep '^E2E s1' "$WORK/host.e2e" | tr '\n' ' ')"; exit 1; }
    # s2 = scaled: its 3 sleds on; 3 calls -> 3 entries + 3 exits (one per
    # return taken).
    xr_session_ok "$WORK/host.e2e" s2 BBNNNBB 6 || { echo "FAIL — session 2 (pointcut scaled): $(grep '^E2E s2' "$WORK/host.e2e" | tr '\n' ' ')"; exit 1; }
    checks=$((checks + 2))
    s1_ids=$(sed -n 's/^E2E s1 records=\[\(.*\)\]$/\1/p' "$WORK/host.e2e" | tr ',' '\n' | sed 's/ //g' | cut -d: -f2 | sort -u | tr '\n' ' ')
    s2_ids=$(sed -n 's/^E2E s2 records=\[\(.*\)\]$/\1/p' "$WORK/host.e2e" | tr ',' '\n' | sed 's/ //g' | cut -d: -f2 | sort -u | tr '\n' ' ')
    [ "$s1_ids" = "3 " ] && [ "$s2_ids" = "2 " ] || { echo "FAIL — records name the wrong functions (s1: $s1_ids, s2: $s2_ids)"; exit 1; }
    checks=$((checks + 1))
    echo "PASS — $checks check(s) (link: 7, twin+handler: 2, in-process: $((checks - 9)); sleds=$XR_SLEDS; $(uname -m))"
    exit 0
}

xr_cleanup() {
    if [ "$KEEP" -eq 1 ]; then echo "kept: $WORK" >&2; else rm -rf "$WORK"; fi
}

xr_build() { # <out> <xray 0|1>
    entry=""; target=""
    # The OFF twin calls the driver entry directly, so it names entry/target
    # the way the CLI would; the --xray route derives them itself.
    [ "$2" = 1 ] || { entry=$PROG; target=$XR_TRIPLE; }
    PATH="$WORK/ccshim:$PATH" XR_SRC=$PROG XR_OUT=$1 XR_XRAY=$2 SIMPLE_NATIVE_BUILD_EMIT_OBJECT=shared \
        SIMPLE_NATIVE_BUILD_ENTRY=$entry SIMPLE_NATIVE_BUILD_TARGET=$target \
        timeout "$STEP_TIMEOUT" "$SIMPLE_BIN" run test/fixtures/xray/xray_native_cli_compile_driver.spl \
        > "$1.log" 2>&1
    grep -q '^CLI-COMPILE rc=0' "$1.log" && [ -s "$1" ]
}
