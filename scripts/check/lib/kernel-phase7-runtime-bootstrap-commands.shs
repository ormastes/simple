#!/bin/sh

kernel_phase7_bootstrap_stage2() {
  k7_runner=$1 k7_root=$2 k7_output=$3
  "$k7_runner" "$k7_root/scripts/bootstrap/bootstrap-from-scratch.sh" \
    --backend=llvm \
    --mode=dynload \
    --full-bootstrap \
    --stop-after-stage2 \
    --no-mcp \
    --jobs=2 \
    --output="$k7_output"
}

kernel_phase7_produce_stage4_admission() {
  k7_runner=$1 k7_root=$2 k7_output=$3 k7_parent=$4 k7_receipt=$5
  "$k7_runner" "$k7_root/scripts/bootstrap/produce-bootstrap-planner-admission-v2.shs" \
    --target=//bootstrap:stage4 \
    --reason=self-host-convergence-check \
    --parent-compiler="$k7_parent" \
    --bootstrap-output="$k7_output" \
    --out="$k7_receipt"
}

kernel_phase7_bootstrap_stage4() {
  k7_runner=$1 k7_root=$2 k7_output=$3 k7_receipt=$4
  "$k7_runner" "$k7_root/scripts/bootstrap/bootstrap-from-scratch.sh" \
    --backend=llvm \
    --mode=dynload \
    --full-bootstrap \
    --full-cli \
    --bootstrap-receipt="$k7_receipt" \
    --no-mcp \
    --jobs=2 \
    --output="$k7_output"
}
