#!/bin/sh
# check-non-optional-nil-return.shs
#
# Guard for the SFFI non-optional return contract (E-SFFI-016, wired by
# 2a59ff7f5e5): a Simple `fn` declared `-> T` where T is NOT optional aborts at
# runtime the moment its body evaluates to nil.
#
# The fault surface is NOT the extern declaration on its own — the validator
# (src/compiler_rust/compiler/src/interpreter_call/core/function_exec.rs,
# validate_sffi_return_contract) runs only on user-defined Simple function
# returns. What kills a build is a THIN WRAPPER: a Simple fn with a
# non-optional declared return type whose body just forwards an `rt_*` extern
# whose interpreter implementation has a `Value::Nil` return path. That is the
# exact shape of `flat_bridge_env_get` (fixed 7825f01def2) and of
# `file_read_lines` / `Channel.try_recv` / `Channel.recv` /
# `cranelift_file_read_bytes` (fixed 2026-08-21).
#
# This guard derives the nil-capable `rt_*` set from the RUST SOURCE — the
# `insert_simple!("rt_x", impl)` registrations under
# src/compiler_rust/compiler/src/interpreter_extern/ cross-referenced against
# which impl functions contain a `Value::Nil` return — never a hand-maintained
# list, so a newly nil-capable extern is covered the day it lands.
#
# Verdict is always the LAST line of stdout:
#   PASS  — <n> wrapper(s) checked, 0 returning nil through a non-optional type
#   FAIL  — <n> wrapper(s) checked, <k> offender(s): <names>          exit 1
#   ERROR — nothing was checked (<reason>)                            exit 2
# A run that examined 0 wrappers or derived 0 nil-capable externs is ERROR,
# never a pass: absence of evidence is not evidence of absence.
#
# Four legs, three ratcheted baselines (a header-preserving rewrite of all three
# is `--regen-baseline`):
#   class (a)  `extern fn rt_x(..) -> T` with T non-optional while rt_x is
#              nil-capable (the declaration itself lies), plus the same check on
#              the `decl:` of every scripts/check/rt_alias_map.sdn entry.
#              Baseline non_optional_nil_return_classa_baseline.txt, keyed
#              <file>:<extern>:<type> (alias map: rt_alias_map:<extern>:<type>).
#              Raw-ABI / void-sentinel externs that cannot be optional are listed
#              WITH A WRITTEN REASON in non_optional_nil_return_classa_optout.txt
#              (`<extern> <type> <reason>`; a row without a reason is an ERROR).
#   class (b)  thin Simple wrapper `fn f() -> T` forwarding such an extern.
#   class (c)  hand-written `return nil` / nil tail under `-> T`.
#   mixed      an extern declared both optional and non-optional somewhere in the
#              tree. Reported as a count; its non-optional sides are enforced by
#              class (a).
#
# Usage:  sh scripts/check/check-non-optional-nil-return.shs [--root DIR]
#         sh scripts/check/check-non-optional-nil-return.shs --selftest
#         sh scripts/check/check-non-optional-nil-return.shs --regen-baseline
#         sh scripts/check/check-non-optional-nil-return.shs --explain

set -u
LC_ALL=C; export LC_ALL

ROOT=""
SELFTEST_ONLY=0
REGEN=0
EXPLAIN=0
while [ $# -gt 0 ]; do
    case "$1" in
        --root) ROOT="$2"; shift 2 ;;
        --selftest) SELFTEST_ONLY=1; shift ;;
        --regen-baseline) REGEN=1; shift ;;
        --explain) EXPLAIN=1; shift ;;
        *) echo "unknown argument: $1" >&2; echo "ERROR — nothing was checked (bad usage)"; exit 2 ;;
    esac
done

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
[ -n "$ROOT" ] || ROOT="$REPO_ROOT"

TMP=$(mktemp -d) || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
trap 'rm -rf "$TMP"' EXIT INT TERM

# ---------------------------------------------------------------- awk programs
cat > "$TMP/wrap.awk" <<'AWKEOF'
function flush() {
  if (nb==1 && curr!="" && curr !~ /\?[ \t]*$/ && curr !~ /^(Option|Optional)</ && curr!="()" && curr!="void" && curr!="unit" && curr!="Unit" && body ~ /^(return[ \t]+)?rt_[a-z0-9_]+\(.*\)$/ && body !~ /\?\?/ && body !~ /!/)
    printf "%s:%d:%s:%s:%s\n", pf, bline, curf, curr, body
  curf=""; nb=0
}
FNR==1 { flush(); curf="" }
/^[ \t]*(pub[ \t]+)?fn[ \t]+[A-Za-z_]/ {
  flush()
  match($0,/^[ \t]*/); curind=RLENGTH
  fname=""; rtype=""
  if (match($0,/fn[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) { fname=substr($0,RSTART,RLENGTH); sub(/fn[ \t]+/,"",fname) }
  if (match($0,/->[ \t]*[^:]+/)) { rtype=substr($0,RSTART,RLENGTH); sub(/->[ \t]*/,"",rtype); gsub(/[ \t]+$/,"",rtype) }
  curf=fname; curr=rtype; nb=0; body=""; bline=0; pf=FILENAME; next
}
{
  if (curf=="") next
  if ($0 ~ /^[ \t]*#/) next
  if ($0 ~ /^[ \t]*$/) next
  match($0,/^[ \t]*/); i=RLENGTH
  if (i<=curind) { flush(); next }
  if (nb==0) { bline=FNR; body=$0; gsub(/^[ \t]+|[ \t]+$/,"",body) }
  nb++
}
END { flush() }
AWKEOF

# nil.awk -- fn names whose body PRODUCES a Value::Nil. A line counts only if it
# constructs the nil value: comments, `matches!(.., Value::Nil)`, `== / !=
# Value::Nil` tests and pattern arms (`Value::Nil =>`, `| Value::Nil`,
# `Some(Value::Nil) =>`, `if let Value::Nil`) READ a nil, they never return one.
# Counting them is how the total rt_value_is_*, rt_vulkan_* and rt_path_absolute
# were wrongly derived as nil-capable.
cat > "$TMP/nil.awk" <<'AWKEOF'
# some .rs files are CRLF: a lone "\r" line is not blank and would end the fn early
{ sub(/\r$/,"") }
FNR==1 { cur="" }
/^[ \t]*(pub[ \t]*(\([a-z()]*\))?[ \t]*)?fn[ \t]+[A-Za-z_]/ {
  if (match($0,/fn[ \t]+[A-Za-z0-9_]*/)) { f=substr($0,RSTART,RLENGTH); sub(/fn[ \t]+/,"",f) }
  match($0,/^[ \t]*/); ci=RLENGTH; cur=f; found=0; next
}
{ if (cur=="") next
  match($0,/^[ \t]*/); i=RLENGTH
  if ($0 ~ /^[ \t]*\}/ && i<=ci) { cur=""; next }
  if ($0 !~ /^[ \t]*$/ && i<=ci && $0 !~ /^[ \t]*[})]/) { cur=""; next }
  s=$0; sub(/\/\/.*$/,"",s)
  if (s ~ /^[ \t]*\*/) next
  if (s !~ /Value::Nil/) next
  if (s ~ /matches!/) next
  if (s ~ /(==|!=)[ \t]*Value::Nil/) next
  if (s ~ /Value::Nil[ \t]*(\||=>)/) next
  if (s ~ /Value::Nil[ \t]*\)[ \t]*(\||=>|if )/) next
  if (s ~ /(if|while) let Value::Nil/) next
  if (!found) { print cur; found=1 }
}
AWKEOF

# call.awk -- <caller> <callee> pairs, one per line, for every FREE call
# `identifier(` textually inside a fn's body (heuristic, not a real call graph).
# `.name(` METHOD calls are not counted: a method sharing a name with some
# nil-capable free fn (`get`, `read`, `len`...) says nothing about that fn, and
# counting them let common method names convict every caller. `Type::name(`
# with a capitalised qualifier (an associated fn of another type) is skipped
# too; `module::name(` and `Self::name(` still count. Exists to catch a wrapper
# like `rt_env_get` whose OWN body has no literal `Value::Nil` because it
# delegates to a shared helper (`runtime_to_value`) that does -- nil.awk alone
# is blind to that one hop (see non_optional_wrappers_return_nil_sweep_2026-08-21.md).
cat > "$TMP/call.awk" <<'AWKEOF'
# some .rs files are CRLF: a lone "\r" line is not blank and would end the fn early
{ sub(/\r$/,"") }
FNR==1 { cur="" }
/^[ \t]*(pub[ \t]*(\([a-z()]*\))?[ \t]*)?fn[ \t]+[A-Za-z_]/ {
  if (match($0,/fn[ \t]+[A-Za-z0-9_]*/)) { f=substr($0,RSTART,RLENGTH); sub(/fn[ \t]+/,"",f) }
  match($0,/^[ \t]*/); ci=RLENGTH; cur=f; next
}
{ if (cur=="") next
  match($0,/^[ \t]*/); i=RLENGTH
  if ($0 ~ /^[ \t]*\}/ && i<=ci) { cur=""; next }
  if ($0 !~ /^[ \t]*$/ && i<=ci && $0 !~ /^[ \t]*[})]/) { cur=""; next }
  n=$0; sub(/\/\/.*$/,"",n)
  while (match(n,/[A-Za-z_][A-Za-z0-9_]*\(/)) {
    rs=RSTART; rl=RLENGTH   # the qualifier match() below clobbers RSTART/RLENGTH
    callee=substr(n,rs,rl-1)
    pre=(rs>1)?substr(n,rs-1,1):""
    free=1
    if (pre=="." || pre ~ /[A-Za-z0-9_]/) free=0
    if (pre==":" && rs>2) {
      q=substr(n,1,rs-3)
      if (match(q,/[A-Za-z_][A-Za-z0-9_]*$/)) { qn=substr(q,RSTART,RLENGTH); if (qn ~ /^[A-Z]/ && qn!="Self") free=0 }
    }
    if (free) print cur, callee
    n=substr(n,rs+rl)
  }
}
AWKEOF

cat > "$TMP/classc.awk" <<'AWKEOF'
# class (c): explicit `return nil` / bare-nil tail under a NON-OPTIONAL declared
# return type. Not extern related -- a hand-written nil under `-> T` aborts the
# moment its branch is taken. `-> any` / `-> Any` are NON-OPTIONAL contracts
# (sffi_return_contract classifies Type::Simple(_) as NonOptional with no escape
# for any/Any), which is exactly why that bucket is the largest and most
# surprising one.
function toplevel_ret(l,   i,n,c,d,r) {
  # the declared return type is the text after the LAST `->` that sits at paren
  # depth 0. A closure PARAMETER (`predicate: fn(Any) -> bool`) carries its own
  # `->` inside the argument list; taking the first or the textually-last `->`
  # misreads those signatures, and misread them as non-optional.
  d=0; r=""; n=length(l)
  for (i=1;i<=n;i++) {
    c=substr(l,i,1)
    if (c=="-" && substr(l,i+1,1)==">") { if (d==0) r=substr(l,i+2); i++; continue }
    if (c=="(" || c=="[" || c=="{" || c=="<") d++
    else if (c==")" || c=="]" || c=="}" || c==">") d--
  }
  return r
}
function nonopt(t) {
  gsub(/^[ \t]+|[ \t]+$/,"",t)
  if (t=="") return 0
  if (t ~ /\?$/) return 0
  if (t=="()" || t=="void" || t=="unit" || t=="Unit" || t=="Never" || t=="never") return 0
  if (t ~ /^(Option|Optional)</) return 0
  return 1
}
function flush() {
  if (curf!="" && nonopt(curr) && tailln>0 && tail=="nil")
    printf "%s:%d:%s:%s:tail-nil\n", pf, tailln, curf, curr
  curf=""; tail=""; tailln=0
}
FNR==1 { flush() }
/^[ \t]*(pub[ \t]+)?fn[ \t]+[A-Za-z_]/ && /->/ {
  flush()
  match($0,/^[ \t]*/); curind=RLENGTH
  line=$0
  sub(/[ \t]*(#.*)?$/,"",line)
  sub(/:[ \t]*$/,"",line)
  rt=toplevel_ret(line)
  fname=""
  if (match($0,/fn[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) { fname=substr($0,RSTART,RLENGTH); sub(/fn[ \t]+/,"",fname) }
  curf=fname; curr=rt; pf=FILENAME; tail=""; tailln=0; next
}
{
  if (curf=="") next
  if ($0 ~ /^[ \t]*$/) next
  if ($0 ~ /^[ \t]*#/) next
  match($0,/^[ \t]*/); i=RLENGTH
  if (i<=curind) { flush(); next }
  s=$0; gsub(/^[ \t]+|[ \t]+$/,"",s)
  if (s ~ /^return[ \t]+nil[ \t]*$/ && nonopt(curr)) printf "%s:%d:%s:%s:return-nil\n", FILENAME, FNR, curf, curr
  tail=s; tailln=FNR
}
END { flush() }
AWKEOF


# ret.awk -- shared by classa.awk and alias.awk.
#   toplevel_ret: text after the LAST `->` at bracket depth 0 (a closure
#   PARAMETER's own `->` sits inside the parens and is ignored).
#   kindof: "none" (no type, or unit/void/Never), "opt" (`T?`, `Option<..>`),
#   "non" (everything else, i.e. a non-optional contract).
cat > "$TMP/ret.awk" <<'AWKEOF'
function toplevel_ret(l,   i,n,c,d,r) {
  d=0; r=""; n=length(l)
  for (i=1;i<=n;i++) {
    c=substr(l,i,1)
    if (c=="-" && substr(l,i+1,1)==">") { if (d==0) r=substr(l,i+2); i++; continue }
    if (c=="(" || c=="[" || c=="{" || c=="<") d++
    else if (c==")" || c=="]" || c=="}" || c==">") d--
  }
  gsub(/^[ \t]+|[ \t]+$/,"",r)
  return r
}
function kindof(t) {
  if (t=="" || t=="()" || t=="void" || t=="unit" || t=="Unit" || t=="Never" || t=="never") return "none"
  if (t ~ /\?$/ || t ~ /^(Option|Optional)</) return "opt"
  return "non"
}
function depth(l,   i,n,c,d) {
  d=0; n=length(l)
  for (i=1;i<=n;i++) { c=substr(l,i,1); if (c=="(") d++; else if (c==")") d-- }
  return d
}
AWKEOF

# classa.awk -- one TSV row per `extern fn rt_x(..) -> T` declaration:
# <file> <extern> <none|opt|non> <type, whitespace removed>. Handles a
# declaration split over several lines and a trailing `# comment`.
cat > "$TMP/classa.awk" <<'AWKEOF'
function emit(buf,   nm,t) {
  if (!match(buf,/rt_[a-z0-9_]+/)) return
  nm=substr(buf,RSTART,RLENGTH)
  t=toplevel_ret(buf)
  k=kindof(t); gsub(/[ \t]+/,"",t)
  printf "%s\t%s\t%s\t%s\n", FILENAME, nm, k, t
}
FNR==1 { st=0 }
{
  if (st==0) {
    if ($0 !~ /^[ \t]*(pub[ \t]+)?extern[ \t]+fn[ \t]+rt_[a-z0-9_]+/) next
    buf=$0; sub(/[ \t]*#.*$/,"",buf); nl=1
    if (depth(buf)>0) { st=1; next }
    emit(buf); next
  }
  l=$0; sub(/[ \t]*#.*$/,"",l); buf=buf " " l; nl++
  if (depth(buf)<=0 || nl>40) { st=0; emit(buf) }
}
AWKEOF

# alias.awk -- the entry-level `decl:` of every rt_alias_map.sdn entry, in the
# same TSV shape (file field is the literal `rt_alias_map`). `variants:` decls
# (8-space `- decl:`) are deliberate legacy-contract aliases and are not read.
cat > "$TMP/alias.awk" <<'AWKEOF'
/^    rt_[a-z0-9_]+:[ \t]*$/ { nm=$1; sub(/:$/,"",nm); next }
/^      decl:[ \t]*"/ {
  if (nm=="") next
  d=$0; sub(/^      decl:[ \t]*"/,"",d); sub(/"[ \t]*$/,"",d)
  t=toplevel_ret(d); k=kindof(t); gsub(/[ \t]+/,"",t)
  printf "rt_alias_map\t%s\t%s\t%s\n", nm, k, t
  nm=""
}
AWKEOF

# ------------------------------------------------------------------- functions
# derive_nil_externs <extern_dir> <out>  — rt_* names whose impl can return Nil
derive_nil_externs() {
    _dir="$1"; _out="$2"
    [ -d "$_dir" ] || { : > "$_out"; return 0; }
    find "$_dir" -name '*.rs' -print0 2>/dev/null \
        | xargs -0 -n200 awk -f "$TMP/nil.awk" 2>/dev/null | sort -u > "$TMP/_nilfns.txt"
    # One-hop (to fixpoint, bounded) transitive closure: a fn whose own body
    # has no literal `Value::Nil` but that CALLS a fn already known to be
    # nil-capable (e.g. a shared `runtime_to_value` conversion helper) is
    # itself nil-capable. Without this, a thin delegator like `rt_env_get`
    # is invisible to the direct scan above.
    find "$_dir" -name '*.rs' -print0 2>/dev/null \
        | xargs -0 -n200 awk -f "$TMP/call.awk" 2>/dev/null | sort -u > "$TMP/_calls.txt"
    cp "$TMP/_nilfns.txt" "$TMP/_nilfns_direct.txt"
    cp "$TMP/_nilfns.txt" "$TMP/_nilfns_prev.txt"
    _iter=0
    while [ "$_iter" -lt 5 ]; do
        _iter=$((_iter + 1))
        awk 'NR==FNR{nil[$1]=1;next} nil[$2]{print $1}' "$TMP/_nilfns_prev.txt" "$TMP/_calls.txt" \
            >> "$TMP/_nilfns_prev.txt"
        sort -u "$TMP/_nilfns_prev.txt" > "$TMP/_nilfns_next.txt"
        cmp -s "$TMP/_nilfns_prev.txt" "$TMP/_nilfns_next.txt" 2>/dev/null && { mv "$TMP/_nilfns_next.txt" "$TMP/_nilfns_prev.txt"; break; }
        mv "$TMP/_nilfns_next.txt" "$TMP/_nilfns_prev.txt"
    done
    mv "$TMP/_nilfns_prev.txt" "$TMP/_nilfns.txt"
    grep -rh 'insert_simple!("rt_' "$_dir" 2>/dev/null \
        | sed 's/.*insert_simple!("\(rt_[a-z0-9_]*\)"[, ]*\(.*\)/\1 \2/' \
        | sed 's/);*[ ]*$//' \
        | awk '{n=$2; sub(/.*::/,"",n); print $1, n}' | sort -u > "$TMP/_map.txt"
    awk 'NR==FNR{n[$1]=1;next} n[$2]{print $1}' "$TMP/_nilfns.txt" "$TMP/_map.txt" | sort -u > "$_out"
    # rt_* nil-capable by their OWN body alone (for --explain: the closure adds
    # the difference).
    awk 'NR==FNR{n[$1]=1;next} n[$2]{print $1}' "$TMP/_nilfns_direct.txt" "$TMP/_map.txt" | sort -u > "$TMP/nil_direct_rt.txt"
}

# scan_wrappers <spl_root> <out>
scan_wrappers() {
    _sroot="$1"; _out="$2"
    : > "$_out"
    [ -d "$_sroot" ] || return 0
    find "$_sroot" -name '*.spl' -not -path '*/vendor/*' -print0 2>/dev/null \
        | xargs -0 -n200 awk -f "$TMP/wrap.awk" 2>/dev/null > "$_out"
}

# scan_classc <spl_root> <out>  -- append class (c) sites found under <spl_root>
scan_classc() {
    _sroot="$1"; _out="$2"
    [ -d "$_sroot" ] || return 0
    find "$_sroot" -name '*.spl' -not -path '*/vendor/*' -print0 2>/dev/null \
        | xargs -0 -n200 awk -f "$TMP/classc.awk" 2>/dev/null >> "$_out"
}

# normalize_classc <raw> <out>
# Drop the absolute path prefix and the LINE NUMBER: line numbers churn on every
# unrelated edit, so a line-keyed baseline goes stale for reasons that have
# nothing to do with the defect. Key is <repo-relative file>:<fn>:<kind>.
normalize_classc() {
    awk -F: -v root="$ROOT/" '{
        f=$1; sub("^" root, "", f)
        print f ":" $3 ":" $NF
    }' "$1" | sed 's/: */:/g' | sort -u > "$2"
}

# match_nil_callee <nil_set> <wrappers> <out>
# Exact-name join on the forwarded callee. A substring match (`grep -F -f`) is
# wrong here: runtime names nest (`rt_vulkan_free` is a prefix of
# `rt_vulkan_free_buffer`), so a nil-capable SHORTER name silently convicted a
# wrapper that forwards a different, total, longer-named extern.
match_nil_callee() {
    awk -F: 'NR==FNR { n[$0]=1; next }
             { body=$NF
               if (match(body,/rt_[a-z0-9_]+/)) { c=substr(body,RSTART,RLENGTH); if (c in n) print $0 } }' \
        "$1" "$2" > "$3" 2>/dev/null
}

# drop_locally_defined <offenders_in> <offenders_out>
# A file that DEFINES its own Simple `fn rt_x(...)` (src/runtime/simple_core is
# the pure-Simple implementation OF the runtime primitives) is calling that
# local definition, not the interpreter extern that happens to share the name.
# Matching on the name alone reports those as offenders; the local definition
# shadows the extern, so filter them out.
drop_locally_defined() {
    _in="$1"; _out="$2"
    : > "$_out"
    while IFS= read -r _ln; do
        [ -n "$_ln" ] || continue
        _f=${_ln%%:*}
        _callee=$(printf '%s\n' "$_ln" | sed 's/.*[:  ]\(rt_[a-z0-9_]*\)(.*/\1/')
        case "$_callee" in
            rt_*) ;;
            *) printf '%s\n' "$_ln" >> "$_out"; continue ;;
        esac
        if [ -f "$_f" ] && grep -qE "^[ \t]*(pub[ \t]+)?fn[ \t]+$_callee\(" "$_f" 2>/dev/null; then
            continue
        fi
        printf '%s\n' "$_ln" >> "$_out"
    done < "$_in"
}


# scan_externs <spl_root> <out> -- append decl rows for every extern under root
scan_externs() {
    _sroot="$1"; _out="$2"
    [ -d "$_sroot" ] || return 0
    grep -rl --include='*.spl' 'extern fn rt_' "$_sroot" 2>/dev/null | grep -v '/vendor/' | tr '\n' '\0' \
        | xargs -0 -n200 awk -f "$TMP/ret.awk" -f "$TMP/classa.awk" 2>/dev/null >> "$_out"
}

# scan_alias <sdn> <out> -- append alias-map decl rows
scan_alias() {
    [ -f "$1" ] || return 0
    awk -f "$TMP/ret.awk" -f "$TMP/alias.awk" "$1" >> "$2" 2>/dev/null
}

# load_optout <file> <out_tsv>  -- `<extern> <type> <reason...>` rows to
# `extern<TAB>type`. A row with no written reason is an error (rc 1, rows on
# stderr): an opt-out is a statement that a decl may stay non-optional, and a
# statement needs its justification.
load_optout() {
    : > "$2"
    [ -f "$1" ] || return 0
    awk -v out="$2" '
        /^[ \t]*#/ || /^[ \t]*$/ { next }
        NF<3 { printf "%s:%d: opt-out row has no written reason: %s\n", FILENAME, FNR, $0 > "/dev/stderr"; bad=1; next }
        { printf "%s\t%s\n", $1, $2 >> out }
        END { exit bad }' "$1"
}

# classa_keys <raw_decl_rows> <nil_names> <optout_tsv> <used_out> <keys_out>
# Non-optional decl of a nil-capable extern, minus opted-out (extern,type) pairs.
# Appends the opt-out pairs that matched something to <used_out> (stale check).
classa_keys() {
    : >> "$4"
    awk -F'\t' -v used="$4" -v root="$ROOT/" '
        FILENAME==ARGV[1] { nil[$1]=1; next }
        FILENAME==ARGV[2] { oo[$1 SUBSEP $2]=1; next }
        $3=="non" && ($2 in nil) {
            k=$2 SUBSEP $4
            if (k in oo) { print $2 "\t" $4 >> used; next }
            f=$1; sub("^" root, "", f)
            print f ":" $2 ":" $4
        }' "$2" "$3" "$1" | sort -u > "$5"
}

# mixed_externs <raw_decl_rows> <nil_names> <out>  -- `<extern> <nil|total>` for
# every extern declared both `T?` and non-optional `T`.
mixed_externs() {
    awk -F'\t' '
        FILENAME==ARGV[1] { nil[$1]=1; next }
        $3=="opt" { o[$2]=1 } $3=="non" { n[$2]=1 }
        END { for (e in o) if (e in n) print e, ((e in nil) ? "nil" : "total") }' "$2" "$1" | sort -u > "$3"
}

# write_baseline <file> <keys> -- rewrite a baseline, keeping its leading
# comment/blank header untouched.
write_baseline() {
    _wf="$1"; _wk="$2"
    {
        if [ -s "$_wf" ]; then awk '/^#/ || /^[ \t]*$/ { print; next } { exit }' "$_wf"; fi
        cat "$_wk"
    } > "$TMP/wb.new" && cat "$TMP/wb.new" > "$_wf"
}

# ------------------------------------------------------------------- selftest

NFIX=19   # assertions made inline by the original fixtures; st_has / st_not add one each
# st_has <file> <literal> <msg>  /  st_not <file> <literal> <msg>
st_has() { NFIX=$((NFIX + 1)); grep -qF -- "$2" "$1" 2>/dev/null || { echo "selftest FAIL: $3"; _fail=1; }; }
st_not() { NFIX=$((NFIX + 1)); grep -qF -- "$2" "$1" 2>/dev/null && { echo "selftest FAIL: $3"; _fail=1; }; return 0; }

selftest() {
    _fail=0
    _sd="$TMP/selftest"
    rm -rf "$_sd"; mkdir -p "$_sd/rust" "$_sd/spl"

    cat > "$_sd/rust/impls.rs" <<'RSEOF'
pub fn rt_maybe_nil(args: &[Value]) -> Result<Value, CompileError> {
    match read(args) {
        Ok(v) => Ok(v),
        Err(_) => Ok(Value::Nil),
    }
}
pub fn rt_always_total(args: &[Value]) -> Result<Value, CompileError> {
    for a in args {
        if a.is_ok() {
            return Ok(Value::Bool(true));
        }
    }
    Ok(Value::Bool(false))
}

const SOME_TABLE: &[Value] = &[Value::Nil];
RSEOF
    cat > "$_sd/rust/reg.rs" <<'RSEOF'
    insert_simple!("rt_maybe_nil", impls::rt_maybe_nil);
    insert_simple!("rt_always_total", impls::rt_always_total);
RSEOF
    derive_nil_externs "$_sd/rust" "$_sd/nil.txt"
    if ! grep -qx 'rt_maybe_nil' "$_sd/nil.txt" 2>/dev/null; then
        echo "selftest FAIL: nil-capable extern rt_maybe_nil was not derived"; _fail=1
    fi
    if grep -qx 'rt_always_total' "$_sd/nil.txt" 2>/dev/null; then
        echo "selftest FAIL: total extern rt_always_total was wrongly derived as nil-capable"; _fail=1
    fi

    # fixture 1: the incident shape — must be flagged
    cat > "$_sd/spl/bad.spl" <<'SPEOF'
extern fn rt_maybe_nil(k: text) -> text

fn bad_wrapper(k: text) -> text:
    rt_maybe_nil(k)
SPEOF
    # fixture 2: optional return — must NOT be flagged
    cat > "$_sd/spl/opt.spl" <<'SPEOF'
extern fn rt_maybe_nil(k: text) -> text?

fn opt_wrapper(k: text) -> text?:
    rt_maybe_nil(k)
SPEOF
    # fixture 3: total body via ?? — must NOT be flagged
    cat > "$_sd/spl/total.spl" <<'SPEOF'
extern fn rt_maybe_nil(k: text) -> text?

fn total_wrapper(k: text) -> text:
    rt_maybe_nil(k) ?? ""
SPEOF
    # fixture 4: forwards a TOTAL extern — must NOT be flagged
    cat > "$_sd/spl/fine.spl" <<'SPEOF'
extern fn rt_always_total(k: text) -> i64

fn fine_wrapper(k: text) -> i64:
    rt_always_total(k)
SPEOF
    # fixture: a file that defines its own `fn rt_maybe_nil` is calling that
    # local definition, not the extern -- must NOT be flagged
    # fixture: `rt_maybe_nil_ext` is TOTAL but has the nil-capable
    # `rt_maybe_nil` as a strict prefix -- must NOT be flagged
    cat > "$_sd/spl/prefix.spl" <<'SPEOF'
extern fn rt_maybe_nil_ext(k: text) -> text

fn prefix_wrapper(k: text) -> text:
    rt_maybe_nil_ext(k)
SPEOF
    cat > "$_sd/spl/local_def.spl" <<'SPEOF'
fn rt_maybe_nil(k: text) -> text:
    if k == "":
        return "fallback"
    k

fn local_def_wrapper(k: text) -> text:
    rt_maybe_nil(k)
SPEOF
    scan_wrappers "$_sd/spl" "$_sd/wrap.txt"
    match_nil_callee "$_sd/nil.txt" "$_sd/wrap.txt" "$_sd/off_raw.txt"
    drop_locally_defined "$_sd/off_raw.txt" "$_sd/off.txt"
    grep -q ':prefix_wrapper:' "$_sd/off.txt" 2>/dev/null && { echo "selftest FAIL: a wrapper forwarding a total extern whose name merely CONTAINS a nil-capable name was flagged"; _fail=1; }
    grep -q ':local_def_wrapper:' "$_sd/off.txt" 2>/dev/null && { echo "selftest FAIL: a wrapper calling a same-file Simple fn definition was wrongly flagged as forwarding the extern"; _fail=1; }

    grep -q ':bad_wrapper:' "$_sd/off.txt" 2>/dev/null || { echo "selftest FAIL: bad_wrapper not flagged"; _fail=1; }
    grep -q ':opt_wrapper:' "$_sd/off.txt" 2>/dev/null && { echo "selftest FAIL: opt_wrapper wrongly flagged"; _fail=1; }
    grep -q ':total_wrapper:' "$_sd/off.txt" 2>/dev/null && { echo "selftest FAIL: total_wrapper wrongly flagged"; _fail=1; }
    grep -q ':fine_wrapper:' "$_sd/off.txt" 2>/dev/null && { echo "selftest FAIL: fine_wrapper wrongly flagged"; _fail=1; }

    # fixture 5: an empty tree must yield 0 wrappers so the caller is forced to ERROR
    mkdir -p "$_sd/empty"
    scan_wrappers "$_sd/empty" "$_sd/empty.txt"
    if [ -s "$_sd/empty.txt" ]; then echo "selftest FAIL: empty tree produced wrappers"; _fail=1; fi
    # ---- class (c) fixtures -------------------------------------------------
    mkdir -p "$_sd/cls"
    cat > "$_sd/cls/pos_return.spl" <<'SPEOF'
fn c_bad_return(k: text) -> text:
    if k == "":
        return nil
    k
SPEOF
    cat > "$_sd/cls/pos_tail_any.spl" <<'SPEOF'
fn c_bad_tail(k: text) -> any:
    if k != "":
        return k
    nil
SPEOF
    cat > "$_sd/cls/neg_opt.spl" <<'SPEOF'
fn c_good_opt(k: text) -> text?:
    if k == "":
        return nil
    k
SPEOF
    cat > "$_sd/cls/neg_void.spl" <<'SPEOF'
fn c_good_void(k: text) -> void:
    log(k)
    nil
SPEOF
    cat > "$_sd/cls/neg_closure_param.spl" <<'SPEOF'
fn c_good_closure_param(xs: [i64], p: fn(i64) -> bool):
    for x in xs:
        if p(x):
            return x
    nil
SPEOF
    cat > "$_sd/cls/neg_generic_ret.spl" <<'SPEOF'
fn c_good_generic_ret(id: usize) -> Option<fn() -> i64>:
    if id == 0:
        return nil
    nil
SPEOF
    : > "$_sd/cls_off.txt"
    scan_classc "$_sd/cls" "$_sd/cls_off.txt"
    grep -q ':c_bad_return:' "$_sd/cls_off.txt" 2>/dev/null || { echo "selftest FAIL: class (c) explicit 'return nil' under -> text not flagged"; _fail=1; }
    grep -q ':c_bad_tail:' "$_sd/cls_off.txt" 2>/dev/null || { echo "selftest FAIL: class (c) bare-nil tail under -> any not flagged"; _fail=1; }
    grep -q ':c_good_opt:' "$_sd/cls_off.txt" 2>/dev/null && { echo "selftest FAIL: class (c) optional return type wrongly flagged"; _fail=1; }
    grep -q ':c_good_void:' "$_sd/cls_off.txt" 2>/dev/null && { echo "selftest FAIL: class (c) void return type wrongly flagged"; _fail=1; }
    grep -q ':c_good_generic_ret:' "$_sd/cls_off.txt" 2>/dev/null && { echo "selftest FAIL: class (c) misread a -> nested inside a generic return type"; _fail=1; }
    grep -q ':c_good_closure_param:' "$_sd/cls_off.txt" 2>/dev/null && { echo "selftest FAIL: class (c) misread a closure PARAMETER's -> as the declared return type"; _fail=1; }

    # ---- baseline ratchet fixtures ------------------------------------------
    # normalize_classc drops the absolute prefix and the line number, and the
    # baseline comparison must surface BOTH a new offender and a stale entry.
    printf '%s/a.spl:12:kept_fn: any:return-nil\n%s/b.spl:99:new_fn: text:tail-nil\n' "$ROOT" "$ROOT" > "$_sd/raw.txt"
    normalize_classc "$_sd/raw.txt" "$_sd/norm.txt"
    grep -qx 'a.spl:kept_fn:return-nil' "$_sd/norm.txt" || { echo "selftest FAIL: normalize_classc did not strip the root prefix and line number"; _fail=1; }
    printf 'a.spl:kept_fn:return-nil\ngone.spl:removed_fn:tail-nil\n' | sort -u > "$_sd/base.txt"
    comm -23 "$_sd/norm.txt" "$_sd/base.txt" > "$_sd/new.txt"
    comm -13 "$_sd/norm.txt" "$_sd/base.txt" > "$_sd/stale.txt"
    grep -qx 'b.spl:new_fn:tail-nil' "$_sd/new.txt" || { echo "selftest FAIL: a new class (c) offender was not reported against the baseline"; _fail=1; }
    grep -qx 'a.spl:kept_fn:return-nil' "$_sd/new.txt" && { echo "selftest FAIL: a baselined class (c) offender was reported as new"; _fail=1; }
    grep -qx 'gone.spl:removed_fn:tail-nil' "$_sd/stale.txt" || { echo "selftest FAIL: a stale baseline entry was not reported"; _fail=1; }

    # an empty tree must yield 0 class (c) sites
    : > "$_sd/cls_empty.txt"
    scan_classc "$_sd/empty" "$_sd/cls_empty.txt"
    if [ -s "$_sd/cls_empty.txt" ]; then echo "selftest FAIL: empty tree produced class (c) sites"; _fail=1; fi

    # ---- precision fixtures (nil.awk / call.awk) -----------------------------
    cat > "$_sd/rust/precision.rs" <<'RSEOF'
pub fn rt_cmp_only(args: &[Value]) -> Result<Value, CompileError> {
    // Ok(Value::Nil) inside a comment never counts
    if args[0] == Value::Nil {
        return Ok(Value::Bool(false));
    }
    if args[1] != Value::Nil {
        return Ok(Value::Bool(true));
    }
    if matches!(args[2], Value::Nil) {
        return Ok(Value::Int(1));
    }
    if let Value::Nil = args[3] {
        return Ok(Value::Int(2));
    }
    match args[4] {
        Value::Nil => Ok(Value::Int(3)),
        Value::Int(_) | Value::Nil => Ok(Value::Int(4)),
        _ => Ok(Value::Int(5)),
    }
}
pub fn rt_some_arm_only(args: &[Value]) -> Result<Value, CompileError> {
    match args.first() {
        Some(Value::Nil) | None => Ok(Value::Int(0)),
        Some(_) => Ok(Value::Int(1)),
    }
}
fn shared_helper(v: &Value) -> Value {
    Value::Nil
}
pub fn rt_via_free(args: &[Value]) -> Result<Value, CompileError> {
    Ok(shared_helper(&args[0]))
}
pub fn rt_via_method(args: &[Value]) -> Result<Value, CompileError> {
    Ok(args[0].shared_helper())
}
pub fn rt_via_type_path(args: &[Value]) -> Result<Value, CompileError> {
    Ok(Other::shared_helper(&args[0]))
}
RSEOF
    # CRLF file with a blank line inside the body: the "\r"-only line must not end the fn
    printf 'pub fn rt_crlf_blank(args: &[Value]) -> Result<Value, CompileError> {\r\n    let x = 1;\r\n\r\n    Ok(Value::Nil)\r\n}\r\n' > "$_sd/rust/crlf.rs"
    cat >> "$_sd/rust/reg.rs" <<'RSEOF'
    insert_simple!("rt_cmp_only", impls::rt_cmp_only);
    insert_simple!("rt_some_arm_only", impls::rt_some_arm_only);
    insert_simple!("rt_via_free", impls::rt_via_free);
    insert_simple!("rt_via_method", impls::rt_via_method);
    insert_simple!("rt_via_type_path", impls::rt_via_type_path);
    insert_simple!("rt_crlf_blank", impls::rt_crlf_blank);
RSEOF
    derive_nil_externs "$_sd/rust" "$_sd/nil.txt"
    st_has "$_sd/nil.txt" 'rt_via_free' "an extern reaching Value::Nil through a FREE helper call was not derived (closure broken)"
    st_has "$TMP/nil_direct_rt.txt" 'rt_maybe_nil' "direct nil-capable set lost rt_maybe_nil"
    st_not "$TMP/nil_direct_rt.txt" 'rt_via_free' "a closure-only extern leaked into the direct set"
    st_has "$_sd/nil.txt" 'rt_crlf_blank' "a CRLF .rs file with a blank line in the body was cut short (nil path missed)"
    st_not "$_sd/nil.txt" 'rt_cmp_only' "comparisons / matches! / pattern arms / comments were counted as producing Value::Nil"
    st_not "$_sd/nil.txt" 'rt_some_arm_only' "a \`Some(Value::Nil) =>\` pattern arm was counted as producing Value::Nil"
    st_not "$_sd/nil.txt" 'rt_via_method' "a .method() call was counted as a call of the nil-capable free fn of the same name"
    st_not "$_sd/nil.txt" 'rt_via_type_path' "Type::name() was counted as a call of the nil-capable free fn of the same name"

    # ---- class (a) fixtures --------------------------------------------------
    mkdir -p "$_sd/ext"
    cat > "$_sd/ext/pos.spl" <<'SPEOF'
extern fn rt_maybe_nil(k: text) -> text
extern fn rt_via_free(
    k: text,
    n: i64
) -> i64   # -> trailing comment must not be read as the type
extern fn rt_via_free(cb: fn(i64) -> bool) -> [text]
SPEOF
    cat > "$_sd/ext/neg.spl" <<'SPEOF'
extern fn rt_maybe_nil(k: text) -> text?
extern fn rt_maybe_nil(k: text) -> Option<text>
extern fn rt_maybe_nil(k: text)
extern fn rt_maybe_nil(k: text) -> ()
extern fn rt_maybe_nil(k: text) -> void
extern fn rt_always_total(k: text) -> text
extern fn rt_via_method(k: text) -> i64
extern fn rt_always_opt(k: text) -> text?
extern fn rt_always_opt2(k: text) -> text?
SPEOF
    : > "$_sd/ext_raw.txt"
    scan_externs "$_sd/ext" "$_sd/ext_raw.txt"
    : > "$_sd/oo.tsv"; : > "$_sd/used.txt"
    classa_keys "$_sd/ext_raw.txt" "$_sd/nil.txt" "$_sd/oo.tsv" "$_sd/used.txt" "$_sd/ca_keys.txt"
    st_has "$_sd/ca_keys.txt" "$_sd/ext/pos.spl:rt_maybe_nil:text" "class (a): non-optional decl of a nil-capable extern not flagged"
    st_has "$_sd/ca_keys.txt" "$_sd/ext/pos.spl:rt_via_free:i64" "class (a): multi-line decl (type after the closing paren) not flagged / trailing comment misread"
    st_has "$_sd/ca_keys.txt" "$_sd/ext/pos.spl:rt_via_free:[text]" "class (a): closure parameter's -> misread as the declared return type"
    st_not "$_sd/ca_keys.txt" "neg.spl:rt_maybe_nil" "class (a): an optional / Option<> / unit / void / absent return was flagged"
    st_not "$_sd/ca_keys.txt" "rt_always_total" "class (a): a TOTAL extern was flagged"
    st_not "$_sd/ca_keys.txt" "rt_via_method" "class (a): a non-nil-capable extern was flagged"
    # opt-out: a row with a reason suppresses and is recorded as used; a bare row is an error
    printf '# c\nrt_maybe_nil text raw ABI: nil is the void sentinel, see impl\n' > "$_sd/oo.txt"
    load_optout "$_sd/oo.txt" "$_sd/oo.tsv" 2>/dev/null || { echo "selftest FAIL: a well-formed opt-out row was rejected"; _fail=1; }
    : > "$_sd/used.txt"
    classa_keys "$_sd/ext_raw.txt" "$_sd/nil.txt" "$_sd/oo.tsv" "$_sd/used.txt" "$_sd/ca_keys.txt"
    st_not "$_sd/ca_keys.txt" "pos.spl:rt_maybe_nil:text" "class (a): an opted-out (extern,type) was still flagged"
    st_has "$_sd/ca_keys.txt" "pos.spl:rt_via_free:i64" "class (a): an opt-out for another extern suppressed this one"
    st_has "$_sd/used.txt" "rt_maybe_nil	text" "class (a): a matching opt-out row was not recorded as used"
    printf 'rt_maybe_nil text\n' > "$_sd/oo_bare.txt"
    if load_optout "$_sd/oo_bare.txt" "$_sd/oo_bare.tsv" 2>/dev/null; then echo "selftest FAIL: an opt-out row with no written reason was accepted"; _fail=1; fi
    NFIX=$((NFIX + 1))
    # mixed declarations
    mixed_externs "$_sd/ext_raw.txt" "$_sd/nil.txt" "$_sd/mixed.txt"
    st_has "$_sd/mixed.txt" "rt_maybe_nil nil" "mixed: extern declared both T? and T not reported"
    st_not "$_sd/mixed.txt" "rt_always_opt" "mixed: an only-optional extern was reported"
    st_not "$_sd/mixed.txt" "rt_always_total" "mixed: an only-non-optional extern was reported"
    # alias map decl
    cat > "$_sd/alias.sdn" <<'SDNEOF'
rt_alias_map:
  entries:
    rt_maybe_nil:
      class: same
      decl: "(key: text) -> text"
      variants:
        - decl: "(key: text) -> text"
    rt_via_free:
      class: same
      decl: "(key: text) -> i64?"
    rt_via_method:
      class: same
      decl: "(key: text) -> i64"
SDNEOF
    : > "$_sd/alias_raw.txt"
    scan_alias "$_sd/alias.sdn" "$_sd/alias_raw.txt"
    : > "$_sd/used.txt"
    : > "$_sd/oo_none.tsv"
    classa_keys "$_sd/alias_raw.txt" "$_sd/nil.txt" "$_sd/oo_none.tsv" "$_sd/used.txt" "$_sd/al_keys.txt"
    st_has "$_sd/al_keys.txt" "rt_alias_map:rt_maybe_nil:text" "alias map: non-optional decl of a nil-capable extern not flagged"
    st_not "$_sd/al_keys.txt" "rt_via_free" "alias map: an optional decl was flagged"
    st_not "$_sd/al_keys.txt" "rt_via_method" "alias map: a non-nil-capable extern was flagged"
    # --regen-baseline keeps the header, replaces the rows
    printf '# header one\n#\n# header two\nstale:row:x\n' > "$_sd/bl.txt"
    printf 'new:row:a\nnew:row:b\n' > "$_sd/bl_keys.txt"
    write_baseline "$_sd/bl.txt" "$_sd/bl_keys.txt"
    [ "$(sed -n 1,3p "$_sd/bl.txt")" = "$(printf '# header one\n#\n# header two')" ] || { echo "selftest FAIL: --regen-baseline lost the baseline header"; _fail=1; }
    st_has "$_sd/bl.txt" "new:row:b" "--regen-baseline did not write the new rows"
    st_not "$_sd/bl.txt" "stale:row" "--regen-baseline kept a stale row"
    NFIX=$((NFIX + 2))

    return $_fail
}

# --------------------------------------------------------------------- driver
if ! selftest; then
    echo "ERROR — nothing was checked (selftest failed)"
    exit 2
fi
if [ "$SELFTEST_ONLY" -eq 1 ]; then
    echo "PASS — selftest only, $NFIX fixture(s) checked, 0 failures"
    exit 0
fi

EXTERN_DIR="$ROOT/src/compiler_rust/compiler/src/interpreter_extern"
derive_nil_externs "$EXTERN_DIR" "$TMP/nil.txt"
NIL_N=$(awk "END{print NR}" "$TMP/nil.txt" 2>/dev/null); [ -n "$NIL_N" ] || NIL_N=0
if [ "$NIL_N" -eq 0 ]; then
    echo "ERROR — nothing was checked (0 nil-capable rt_* externs derived from $EXTERN_DIR)"
    exit 2
fi

# Roots scanned by BOTH legs. src/app and src/runtime/simple_core were added
# 2026-08-21 once their class (b) siblings were fixed; a root that does not
# exist is skipped, never an error.
SCAN_ROOTS="src/compiler src/lib src/app src/runtime/simple_core"

: > "$TMP/wrap.txt"
for _r in $SCAN_ROOTS; do
    scan_wrappers "$ROOT/$_r" "$TMP/wrap_one.txt"
    cat "$TMP/wrap_one.txt" >> "$TMP/wrap.txt"
done
WRAP_N=$(awk "END{print NR}" "$TMP/wrap.txt" 2>/dev/null); [ -n "$WRAP_N" ] || WRAP_N=0
if [ "$WRAP_N" -eq 0 ]; then
    echo "ERROR — nothing was checked (0 non-optional rt_* forwarding wrappers found under $ROOT/src/compiler + $ROOT/src/lib)"
    exit 2
fi

match_nil_callee "$TMP/nil.txt" "$TMP/wrap.txt" "$TMP/off_raw.txt"
drop_locally_defined "$TMP/off_raw.txt" "$TMP/off_all.txt"

# Baseline ratchet, same convention/mechanism as the class (c) leg below: the
# one-hop transitive nil-capability closure (added 2026-08-21, see
# doc/08_tracking/bug/non_optional_wrappers_return_nil_sweep_2026-08-21.md)
# newly surfaces offenders that were always real but invisible to the direct
# `Value::Nil`-in-body scan (e.g. thin wrappers over `rt_env_get`, which
# delegates its nil path through the shared `runtime_to_value` helper). They
# cannot all be fixed in one change; baselining keeps the guard live against
# NEW class (b) debt without pretending the pre-existing set is clean. A
# baselined entry that is no longer an offender is a STALE baseline and also
# FAILs, same as every other ratchet in this file.
BASELINE_B="$SCRIPT_DIR/non_optional_nil_return_classb_baseline.txt"
normalize_classc "$TMP/off_all.txt" "$TMP/off_norm.txt"
if [ -f "$BASELINE_B" ]; then
    grep -v '^#' "$BASELINE_B" | grep -v '^[[:space:]]*$' | sort -u > "$TMP/base_b.txt"
else
    : > "$TMP/base_b.txt"
fi
comm -23 "$TMP/off_norm.txt" "$TMP/base_b.txt" > "$TMP/off_new_keys.txt"
comm -13 "$TMP/off_norm.txt" "$TMP/base_b.txt" > "$TMP/off_stale.txt"
BASE_B_N=$(awk "END{print NR}" "$TMP/base_b.txt" 2>/dev/null); [ -n "$BASE_B_N" ] || BASE_B_N=0
OFF_STALE_N=$(awk "END{print NR}" "$TMP/off_stale.txt" 2>/dev/null); [ -n "$OFF_STALE_N" ] || OFF_STALE_N=0
# Re-expand the surviving (non-baselined) normalized keys back to full
# file:line:fn:type:body rows for display, keyed the same way normalize_classc
# built the key (<rel-file>:<fn>:<body>, collapsed colon-space runs).
awk -F: -v root="$ROOT/" 'NR==FNR{k[$0]=1;next}
    { f=$1; sub("^"root,"",f); key=f ":" $3 ":" $NF; gsub(/: */,":",key); if (key in k) print }' \
    "$TMP/off_new_keys.txt" "$TMP/off_all.txt" > "$TMP/off.txt"
OFF_N=$(awk "END{print NR}" "$TMP/off.txt" 2>/dev/null); [ -n "$OFF_N" ] || OFF_N=0

# ------------------------------------------------------- class (c) leg
# Hand-written `return nil` / bare-nil tail under a non-optional declared
# return type. Independent of any extern: each such site aborts the moment its
# branch is taken.
: > "$TMP/classc.txt"
CLSC_FILES=0
for _r in $SCAN_ROOTS; do
    [ -d "$ROOT/$_r" ] || continue
    _n=$(find "$ROOT/$_r" -name '*.spl' -not -path '*/vendor/*' 2>/dev/null | awk 'END{print NR}')
    [ -n "$_n" ] || _n=0
    CLSC_FILES=$((CLSC_FILES + _n))
    scan_classc "$ROOT/$_r" "$TMP/classc.txt"
done
if [ "$CLSC_FILES" -eq 0 ]; then
    echo "ERROR — nothing was checked (0 .spl files found under $SCAN_ROOTS in $ROOT for the class (c) leg)"
    exit 2
fi
normalize_classc "$TMP/classc.txt" "$TMP/classc_norm.txt"

# Baseline: sites that are a REAL contract violation but cannot be fixed today,
# each with a bug reference in the file. `T?` is the correct fix for all of
# them and it regresses more than it fixes right now -- widening a tuple-valued
# `-> any` to `any?` makes the seed wrap the tuple in an Option enum and break
# `.0`/`.1` access (doc/08_tracking/bug/free_fn_optional_wrap_2026-06-26.md).
# Recording them keeps the guard live against NEW debt without pretending these
# are clean. Same convention as the other ratchets in this directory: a
# baselined site that is no longer an offender is a STALE baseline and also
# FAILs, because a baseline that no longer describes the tree is how a ratchet
# silently stops ratcheting.
BASELINE="$SCRIPT_DIR/non_optional_nil_return_classc_baseline.txt"
if [ -f "$BASELINE" ]; then
    grep -v '^#' "$BASELINE" | grep -v '^[[:space:]]*$' | sort -u > "$TMP/base.txt"
else
    : > "$TMP/base.txt"
fi
comm -23 "$TMP/classc_norm.txt" "$TMP/base.txt" > "$TMP/classc_new.txt"
comm -13 "$TMP/classc_norm.txt" "$TMP/base.txt" > "$TMP/classc_stale.txt"
BASE_N=$(awk "END{print NR}" "$TMP/base.txt" 2>/dev/null); [ -n "$BASE_N" ] || BASE_N=0
CLSC_N=$(awk "END{print NR}" "$TMP/classc_new.txt" 2>/dev/null); [ -n "$CLSC_N" ] || CLSC_N=0
STALE_N=$(awk "END{print NR}" "$TMP/classc_stale.txt" 2>/dev/null); [ -n "$STALE_N" ] || STALE_N=0
cp "$TMP/classc_new.txt" "$TMP/classc.txt"

# ------------------------------------------------------------ class (a) leg
# `extern fn rt_x(..) -> T`, T non-optional, rt_x nil-capable. Scans the same
# roots plus src/os and src/compiler_rust/lib, and the alias map's `decl:` rows.
CLSA_ROOTS="$SCAN_ROOTS src/os src/compiler_rust/lib"
: > "$TMP/ext_raw.txt"
for _r in $CLSA_ROOTS; do
    scan_externs "$ROOT/$_r" "$TMP/ext_raw.txt"
done
EXT_N=$(awk "END{print NR}" "$TMP/ext_raw.txt" 2>/dev/null); [ -n "$EXT_N" ] || EXT_N=0
if [ "$EXT_N" -eq 0 ]; then
    echo "ERROR — nothing was checked (0 'extern fn rt_*' declarations found under $CLSA_ROOTS in $ROOT)"
    exit 2
fi
: > "$TMP/alias_raw.txt"
scan_alias "$ROOT/scripts/check/rt_alias_map.sdn" "$TMP/alias_raw.txt"
ALIAS_N=$(awk "END{print NR}" "$TMP/alias_raw.txt" 2>/dev/null); [ -n "$ALIAS_N" ] || ALIAS_N=0

OPTOUT="$SCRIPT_DIR/non_optional_nil_return_classa_optout.txt"
if ! load_optout "$OPTOUT" "$TMP/optout.tsv" 2> "$TMP/optout.err"; then
    cat "$TMP/optout.err"
    echo "ERROR — nothing was checked (opt-out rows in $OPTOUT need a written reason: '<extern> <type> <reason>')"
    exit 2
fi
OPTOUT_N=$(awk "END{print NR}" "$TMP/optout.tsv" 2>/dev/null); [ -n "$OPTOUT_N" ] || OPTOUT_N=0
: > "$TMP/optout_used.txt"
classa_keys "$TMP/ext_raw.txt" "$TMP/nil.txt" "$TMP/optout.tsv" "$TMP/optout_used.txt" "$TMP/classa_ext_keys.txt"
classa_keys "$TMP/alias_raw.txt" "$TMP/nil.txt" "$TMP/optout.tsv" "$TMP/optout_used.txt" "$TMP/classa_alias_keys.txt"
sort -u "$TMP/classa_ext_keys.txt" "$TMP/classa_alias_keys.txt" > "$TMP/classa_norm.txt"
sort -u "$TMP/optout_used.txt" > "$TMP/optout_used.s"
awk -F'\t' '{print $1 "\t" $2}' "$TMP/optout.tsv" | sort -u > "$TMP/optout.s"
comm -13 "$TMP/optout_used.s" "$TMP/optout.s" > "$TMP/optout_stale.txt"
OPTOUT_STALE_N=$(awk "END{print NR}" "$TMP/optout_stale.txt" 2>/dev/null); [ -n "$OPTOUT_STALE_N" ] || OPTOUT_STALE_N=0
mixed_externs "$TMP/ext_raw.txt" "$TMP/nil.txt" "$TMP/mixed.txt"
MIXED_N=$(awk "END{print NR}" "$TMP/mixed.txt" 2>/dev/null); [ -n "$MIXED_N" ] || MIXED_N=0
MIXED_NIL_N=$(awk '$2=="nil"{n++} END{print n+0}' "$TMP/mixed.txt")

BASELINE_A="$SCRIPT_DIR/non_optional_nil_return_classa_baseline.txt"
if [ -f "$BASELINE_A" ]; then
    grep -v '^#' "$BASELINE_A" | grep -v '^[[:space:]]*$' | sort -u > "$TMP/base_a.txt"
else
    : > "$TMP/base_a.txt"
fi
comm -23 "$TMP/classa_norm.txt" "$TMP/base_a.txt" > "$TMP/classa_new.txt"
comm -13 "$TMP/classa_norm.txt" "$TMP/base_a.txt" > "$TMP/classa_stale.txt"
BASE_A_N=$(awk "END{print NR}" "$TMP/base_a.txt" 2>/dev/null); [ -n "$BASE_A_N" ] || BASE_A_N=0
CLSA_N=$(awk "END{print NR}" "$TMP/classa_new.txt" 2>/dev/null); [ -n "$CLSA_N" ] || CLSA_N=0
CLSA_STALE_N=$(awk "END{print NR}" "$TMP/classa_stale.txt" 2>/dev/null); [ -n "$CLSA_STALE_N" ] || CLSA_STALE_N=0

if [ "$EXPLAIN" -eq 1 ]; then
    echo "== nil-capable rt_* by their own body: $(awk 'END{print NR}' "$TMP/nil_direct_rt.txt")"
    echo "== nil-capable rt_* total (with transitive closure): $NIL_N"
    echo "== added by the closure only:"
    comm -13 "$TMP/nil_direct_rt.txt" "$TMP/nil.txt" > "$TMP/closure_only.txt"
    # <extern> -> <impl fn> via <nil-capable callees> ("*" marks a callee that
    # produces Value::Nil itself; unmarked callees are nil-capable only via the closure)
    awk 'FILENAME==ARGV[1] { c[$1]=1; next }
         FILENAME==ARGV[2] { m[$1]=$2; next }
         FILENAME==ARGV[3] { d[$1]=1; next }
         FILENAME==ARGV[4] { n[$1]=1; next }
         { cl[$1] = cl[$1] " " $2 }
         END { for (r in c) { f=m[r]; v="";
                 split(cl[f], a, " ");
                 for (i in a) if (a[i] in n) v = v " " a[i] ((a[i] in d) ? "*" : "")
                 print r " -> " f " via" v } }' \
        "$TMP/closure_only.txt" "$TMP/_map.txt" "$TMP/_nilfns_direct.txt" "$TMP/_nilfns.txt" "$TMP/_calls.txt" | sort
    echo "== mixed optional/non-optional externs ($MIXED_N, $MIXED_NIL_N nil-capable):"
    cat "$TMP/mixed.txt"
    echo "== opt-outs: $OPTOUT_N row(s), $OPTOUT_STALE_N stale"
fi

# ------------------------------------------------------------ --regen-baseline
if [ "$REGEN" -eq 1 ]; then
    write_baseline "$BASELINE_A" "$TMP/classa_norm.txt"
    write_baseline "$BASELINE_B" "$TMP/off_norm.txt"
    write_baseline "$BASELINE" "$TMP/classc_norm.txt"
    echo "regenerated: class (a) $(awk 'END{print NR}' "$TMP/classa_norm.txt") ($OPTOUT_N opted out), class (b) $(awk 'END{print NR}' "$TMP/off_norm.txt"), class (c) $(awk 'END{print NR}' "$TMP/classc_norm.txt"); header comments preserved."
    echo "PASS — baselines rewritten against the tree; review the diff before committing"
    exit 0
fi

REGEN_HINT="regenerate with: sh scripts/check/check-non-optional-nil-return.shs --regen-baseline (after confirming each removed row was fixed, not hidden)"
if [ "$OFF_N" -gt 0 ] || [ "$CLSC_N" -gt 0 ] || [ "$STALE_N" -gt 0 ] || [ "$OFF_STALE_N" -gt 0 ] || [ "$CLSA_N" -gt 0 ] || [ "$CLSA_STALE_N" -gt 0 ] || [ "$OPTOUT_STALE_N" -gt 0 ]; then
    if [ "$CLSA_N" -gt 0 ]; then
        echo "class (a) offenders NOT in the baseline (file:extern:type -- declare the return \`T?\`, or add a reasoned row to $OPTOUT):"
        cat "$TMP/classa_new.txt"
    fi
    if [ "$CLSA_STALE_N" -gt 0 ]; then
        echo "stale class (a) baseline entries (no longer offenders -- remove them from $BASELINE_A; $REGEN_HINT):"
        cat "$TMP/classa_stale.txt"
    fi
    if [ "$OPTOUT_STALE_N" -gt 0 ]; then
        echo "stale class (a) opt-out rows (extern<TAB>type no longer a nil-capable non-optional decl -- remove them from $OPTOUT):"
        cat "$TMP/optout_stale.txt"
    fi
    if [ "$OFF_N" -gt 0 ]; then
        echo "class (b) offenders NOT in the baseline (file:line:fn:return-type:body):"
        cat "$TMP/off.txt"
    fi
    if [ "$OFF_STALE_N" -gt 0 ]; then
        echo "stale class (b) baseline entries (no longer offenders -- remove them from $BASELINE_B; $REGEN_HINT):"
        cat "$TMP/off_stale.txt"
    fi
    if [ "$CLSC_N" -gt 0 ]; then
        echo "class (c) offenders NOT in the baseline (file:fn:kind):"
        cat "$TMP/classc.txt"
    fi
    if [ "$STALE_N" -gt 0 ]; then
        echo "stale class (c) baseline entries (no longer offenders -- remove them from $BASELINE; $REGEN_HINT):"
        cat "$TMP/classc_stale.txt"
    fi
    NAMES=$( { [ "$CLSA_N" -gt 0 ] && awk -F: '{print $2}' "$TMP/classa_new.txt"; [ "$CLSA_STALE_N" -gt 0 ] && awk -F: '{print $2}' "$TMP/classa_stale.txt"; [ "$OFF_N" -gt 0 ] && awk -F: '{print $3}' "$TMP/off.txt"; [ "$CLSC_N" -gt 0 ] && awk -F: '{print $2}' "$TMP/classc.txt"; [ "$STALE_N" -gt 0 ] && awk -F: '{print $2}' "$TMP/classc_stale.txt"; } | sort -u | tr '\n' ' ' | sed 's/ $//')
    echo "FAIL — $WRAP_N wrapper(s) and $EXT_N extern decl(s) + $ALIAS_N alias decl(s) checked against $NIL_N nil-capable extern(s), $CLSC_FILES file(s) scanned for hand-written nil returns; $CLSA_N new + $CLSA_STALE_N stale class (a) (baseline $BASE_A_N, $OPTOUT_N opted out, $OPTOUT_STALE_N stale opt-out), $OFF_N new + $OFF_STALE_N stale class (b), $CLSC_N new + $STALE_N stale class (c) (baseline $BASE_N); mixed optional/non-optional externs: $MIXED_N ($MIXED_NIL_N nil-capable): $NAMES"
    exit 1
fi

echo "PASS — $WRAP_N wrapper(s) and $EXT_N extern decl(s) + $ALIAS_N alias decl(s) checked against $NIL_N nil-capable extern(s): class (a) $BASE_A_N baselined + $OPTOUT_N opted out (0 new, 0 stale), class (b) $BASE_B_N baselined (0 new, 0 stale), class (c) $BASE_N baselined over $CLSC_FILES file(s) (0 new, 0 stale); mixed optional/non-optional externs: $MIXED_N ($MIXED_NIL_N nil-capable, non-optional sides counted in class (a))"
exit 0
