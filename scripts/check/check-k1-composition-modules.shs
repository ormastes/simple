#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
neutral_relative=src/compiler/80.driver/driver_aot_pipeline.spl
combined_relative=src/compositions/kernel_llvm_cranelift/compiler/driver/bootstrap_k1_selected.spl
unselected_relative=src/compositions/kernel_cranelift_only/compiler/driver/bootstrap_k1_selected.spl
closure_relative=doc/04_architecture/compiler/plugin_arch/kernel_closure.sdn
neutral=$root/$neutral_relative
combined=$root/$combined_relative
closure=$root/$closure_relative
relocation_map=$root/scripts/check/kernel-phase5-backend-relocations.tsv
misplaced_report=$root/build/review/final_phase5_misplaced_backends.txt

verify_relocations() {
  check_root=$1
  check_map=$2
  check_report=$3
  expected_count=$4
  [ -f "$check_report" ] || {
    echo "FAIL — relocation audit report is missing: $check_report" >&2
    return 1
  }
  actual_count=$(awk -F '\t' 'NF == 2 { count++ } END { print count+0 }' "$check_map")
  [ "$actual_count" -eq "$expected_count" ] || {
    echo "FAIL — relocation map has $actual_count entries, expected $expected_count" >&2
    return 1
  }
  duplicate_source=$(cut -f1 "$check_map" | LC_ALL=C sort | uniq -d | head -1)
  duplicate_target=$(cut -f2 "$check_map" | LC_ALL=C sort | uniq -d | head -1)
  [ -z "$duplicate_source" ] && [ -z "$duplicate_target" ] || {
    echo 'FAIL — relocation map contains a duplicate source or target' >&2
    return 1
  }
  report_count=$(awk 'NF { count++ } END { print count+0 }' "$check_report")
  [ "$report_count" -eq "$expected_count" ] || {
    echo "FAIL — relocation audit report has $report_count entries, expected $expected_count" >&2
    return 1
  }
  report_sources=${TMPDIR:-/tmp}/simple-phase5-report-sources.$$
  map_sources=${TMPDIR:-/tmp}/simple-phase5-map-sources.$$
  awk 'NF { print }' "$check_report" | LC_ALL=C sort >"$report_sources"
  cut -f1 "$check_map" | LC_ALL=C sort >"$map_sources"
  if ! cmp -s "$report_sources" "$map_sources"; then
    echo 'FAIL — relocation map sources differ from the audited P-static backend list' >&2
    rm -f "$report_sources" "$map_sources"
    return 1
  fi
  rm -f "$report_sources" "$map_sources"
  relocation_failed=0
  while IFS="$(printf '\t')" read -r old_path new_path extra; do
    [ -n "$old_path" ] && [ -n "$new_path" ] && [ -z "${extra:-}" ] || {
      echo 'FAIL — malformed relocation map entry' >&2
      relocation_failed=1
      continue
    }
    case "$old_path:$new_path" in
      src/compiler/70.backend/backend/*:src/plugins/backend_*/*) ;;
      *)
        echo "FAIL — relocation escapes Phase5 ownership: $old_path -> $new_path" >&2
        relocation_failed=1
        continue
        ;;
    esac
    if [ -e "$check_root/$old_path" ] || [ -L "$check_root/$old_path" ]; then
      echo "FAIL — duplicate old backend path remains: $old_path" >&2
      relocation_failed=1
    fi
    if [ ! -f "$check_root/$new_path" ] || [ -L "$check_root/$new_path" ]; then
      echo "FAIL — relocated backend target is missing or a symlink: $new_path" >&2
      relocation_failed=1
    fi
  done <"$check_map"
  [ "$relocation_failed" -eq 0 ]
}

verify_no_stale_relocation_imports() {
  check_root=$1
  check_map=$2
  old_modules=${TMPDIR:-/tmp}/simple-phase5-old-modules.$$
  import_lines=${TMPDIR:-/tmp}/simple-phase5-import-lines.$$
  awk -F '\t' 'NF == 2 {
    path = $1
    sub(/^src\/compiler\/70[.]backend\/backend\//, "", path)
    sub(/[.]spl$/, "", path)
    gsub(/\//, ".", path)
    print "compiler.backend." path
  }' "$check_map" >"$old_modules"
  : >"$import_lines"
  for source_root in src/compiler src/plugins src/compositions; do
    [ -d "$check_root/$source_root" ] || continue
    find "$check_root/$source_root" -type f -name '*.spl' \
      -exec grep -HnE '^[[:space:]]*(export[[:space:]]+)?use[[:space:]]+compiler[.]backend[.]' {} + \
      >>"$import_lines" 2>/dev/null || true
  done
  stale_imports=$(awk '
    NR == FNR { old[$1] = 1; next }
    {
      line = $0
      sub(/^[^:]*:[0-9]+:/, "", line)
      sub(/^[[:space:]]*(export[[:space:]]+)?use[[:space:]]+/, "", line)
      split(line, token, /[^A-Za-z0-9_.]/)
      path = token[1]
      sub(/[.]$/, "", path)
      for (module in old) {
        if (path == module || index(path, module ".") == 1) print $0
      }
    }
  ' "$old_modules" "$import_lines")
  rm -f "$old_modules" "$import_lines"
  [ -z "$stale_imports" ] || {
    echo "FAIL — relocated backend imports still use compiler-owned module paths" >&2
    echo "$stale_imports" >&2
    return 1
  }
}

verify_committed_file() {
  check_root=$1
  relative=$2
  if [ -d "$check_root/.jj" ] && command -v jj >/dev/null 2>&1; then
    jj -R "$check_root" --ignore-working-copy file show -r @ "$relative" 2>/dev/null |
      cmp -s - "$check_root/$relative" || {
        echo "FAIL — $relative differs from the committed Jujutsu snapshot" >&2
        return 1
      }
    return 0
  fi
  git -C "$check_root" show "HEAD:$relative" 2>/dev/null |
    cmp -s - "$check_root/$relative" || {
      echo "FAIL — $relative differs from the committed Git snapshot" >&2
      return 1
    }
}

verify_committed_absence() {
  check_root=$1
  relative=$2
  if [ -d "$check_root/.jj" ] && command -v jj >/dev/null 2>&1; then
    committed=$(jj -R "$check_root" --ignore-working-copy file list -r @ "$relative" 2>/dev/null) || {
      echo "FAIL — could not inspect the committed Jujutsu snapshot" >&2
      return 1
    }
    [ -z "$committed" ] || {
      echo "FAIL — unselected committed composition remains: $relative" >&2
      return 1
    }
    return 0
  fi
  if git -C "$check_root" cat-file -e "HEAD:$relative" 2>/dev/null; then
    echo "FAIL — unselected committed composition remains: $relative" >&2
    return 1
  fi
}

if [ "${1:-}" = --selftest ]; then
  fixture=$(mktemp -d)
  fixture_map=$fixture/relocations.tsv
  fixture_report=$fixture/misplaced.txt
  trap 'rm -rf "$fixture"' EXIT HUP INT TERM
  mkdir -p "$fixture/src/plugins/backend_fixture"
  printf 'fn moved() -> bool: true\n' >"$fixture/src/plugins/backend_fixture/moved.spl"
  printf '%s\t%s\n' \
    src/compiler/70.backend/backend/moved.spl \
    src/plugins/backend_fixture/moved.spl >"$fixture_map"
  printf '%s\n' src/compiler/70.backend/backend/moved.spl >"$fixture_report"
  verify_relocations "$fixture" "$fixture_map" "$fixture_report" 1
  mkdir -p "$fixture/src/compiler/70.backend/backend"
  printf 'fn duplicate() -> bool: true\n' >"$fixture/src/compiler/70.backend/backend/moved.spl"
  if verify_relocations "$fixture" "$fixture_map" "$fixture_report" 1 >/dev/null 2>&1; then
    echo 'FAIL — duplicate old-path mutation was accepted' >&2
    exit 1
  fi
  rm "$fixture/src/compiler/70.backend/backend/moved.spl"
  rm "$fixture/src/plugins/backend_fixture/moved.spl"
  ln -s nowhere "$fixture/src/plugins/backend_fixture/moved.spl"
  if verify_relocations "$fixture" "$fixture_map" "$fixture_report" 1 >/dev/null 2>&1; then
    echo 'FAIL — symlink-target mutation was accepted' >&2
    exit 1
  fi
  rm "$fixture/src/plugins/backend_fixture/moved.spl"
  printf 'fn moved() -> bool: true\n' >"$fixture/src/plugins/backend_fixture/moved.spl"
  printf 'use compiler.backend.moved.{moved}\n' \
    >"$fixture/src/plugins/backend_fixture/stale_import.spl"
  if verify_no_stale_relocation_imports "$fixture" "$fixture_map" >/dev/null 2>&1; then
    echo 'FAIL — stale compiler-owned import mutation was accepted' >&2
    exit 1
  fi
  echo 'PASS — Phase5 relocation map rejects duplicate paths, symlinks, and stale imports'
  exit 0
fi

failed=0
if ! verify_committed_file "$root" "$neutral_relative"; then
  failed=1
fi
if ! verify_committed_file "$root" "$combined_relative"; then
  failed=1
fi
if ! verify_committed_file "$root" "$closure_relative"; then
  failed=1
fi
if ! verify_committed_absence "$root" "$unselected_relative"; then
  failed=1
fi

grep -Fq 'use compiler.driver.bootstrap_k1_selected.{' "$neutral"
if grep -Eq 'driver_bootstrap\.|driver_bootstrap_cranelift|bootstrap_lower_to_mir_context' "$neutral"; then
  echo 'FAIL — neutral AOT orchestration imports a concrete K1 implementation' >&2
  exit 1
fi
grep -Fq 'driver_bootstrap.{' "$combined"
grep -Fq 'static_backend_cranelift_port' "$combined"
grep -Fq 'static_backend_interpreter_port' "$combined"
grep -Fq 'static_backend_llvm_port' "$combined"
grep -Fxq '  k1_policy: llvm-cranelift' "$closure"
[ ! -e "$root/src/compositions/kernel_cranelift_only" ] || {
  echo 'FAIL — unselected Cranelift-only composition remains' >&2
  exit 1
}

if ! verify_relocations "$root" "$relocation_map" "$misplaced_report" 71; then
  failed=1
fi
if ! verify_no_stale_relocation_imports "$root" "$relocation_map"; then
  failed=1
fi
[ "$failed" -eq 0 ] || exit 1
echo 'PASS — selected LLVM+Cranelift K1 root matches the committed snapshot and 71 non-bootstrap backends live under plugins'
