#!/bin/sh
# Build an immutable, directly compiled core-C runtime capsule.
#
# This owner intentionally invokes only the host C compiler, archiver, nm,
# and the C self-check. It does not pass through a language compiler lane.
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT_DIR"

die() {
    echo "core_c_runtime_capsule_status=fail"
    echo "core_c_runtime_capsule_reason=$1"
    exit 1
}

OUTPUT_ROOT=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --output)
            [ "$#" -ge 2 ] || die "missing-output-value"
            OUTPUT_ROOT=$2
            shift 2
            ;;
        --help)
            echo "usage: sh scripts/check/build-core-c-bootstrap-runtime-capsule.shs --output DIR"
            exit 0
            ;;
        *)
            die "unknown-argument:$1"
            ;;
    esac
done

[ -n "$OUTPUT_ROOT" ] || die "output-required"
case "$OUTPUT_ROOT" in
    /*) ;;
    *) OUTPUT_ROOT="$ROOT_DIR/$OUTPUT_ROOT" ;;
esac
mkdir -p "$OUTPUT_ROOT"
OUTPUT_ROOT=$(CDPATH= cd -- "$OUTPUT_ROOT" && pwd)
FINAL_DIR="$OUTPUT_ROOT/core-c-bootstrap"
[ ! -e "$FINAL_DIR" ] || die "output-already-exists:$FINAL_DIR"

CC_NAME=${CC:-cc}
AR_NAME=${AR:-ar}
NM_NAME=${NM:-nm}
command -v "$CC_NAME" >/dev/null 2>&1 || die "cc-not-found:$CC_NAME"
command -v "$AR_NAME" >/dev/null 2>&1 || die "ar-not-found:$AR_NAME"
command -v "$NM_NAME" >/dev/null 2>&1 || die "nm-not-found:$NM_NAME"

absolute_tool_path() {
    tool_path=$(command -v "$1")
    case "$tool_path" in
        /*) printf '%s\n' "$tool_path" ;;
        *)
            tool_dir=$(CDPATH= cd -- "$(dirname -- "$tool_path")" && pwd)
            printf '%s/%s\n' "$tool_dir" "$(basename -- "$tool_path")"
            ;;
    esac
}

CC_PATH=$(absolute_tool_path "$CC_NAME")
AR_PATH=$(absolute_tool_path "$AR_NAME")
NM_PATH=$(absolute_tool_path "$NM_NAME")

hash_stream() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | awk '{print $1}'
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum | awk '{print $1}'
    else
        die "sha256-tool-not-found"
    fi
}

hash_file() {
    hash_stream <"$1"
}

RUNTIME_DIR="src/runtime"
if [ -d "$ROOT_DIR/.jj" ] && command -v jj >/dev/null 2>&1; then
    RUNTIME_STATUS=$(jj -R "$ROOT_DIR" diff --name-only "$RUNTIME_DIR" 2>&1) || \
        die "runtime-source-status-unavailable"
    [ -z "$RUNTIME_STATUS" ] || die "runtime-source-dirty"
elif git -C "$ROOT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    RUNTIME_STATUS=$(git -C "$ROOT_DIR" status --porcelain --untracked-files=all -- "$RUNTIME_DIR")
    [ -z "$RUNTIME_STATUS" ] || die "runtime-source-dirty"
else
    die "runtime-source-status-unavailable"
fi

CHECKS_RUN=0
record_check() {
    CHECKS_RUN=$((CHECKS_RUN + 1))
}

SOURCE_FILES="
runtime_native.c
runtime_contracts.c
runtime_coverage_core.c
runtime_framebuffer.c
runtime_directx_core.c
runtime_legacy_core.c
runtime_fork.c
runtime_memtrack.c
runtime_process.c
runtime_font.c
runtime_thread.c
runtime_simd_utf8.c
runtime_simd_dispatch.c
"
HEADER_FILES="
runtime_value.h
runtime.h
runtime_fork.h
runtime_memtrack.h
runtime_simd_dispatch.h
runtime_thread.h
runtime_memory_guard.h
platform/platform.h
platform/windows_command_line_private.h
"

PLATFORM=$(uname -s)
ARCH=$(uname -m)
case "$PLATFORM" in
    Linux)
        SOURCE_FILES="${SOURCE_FILES}
hosted_cocoa.c
hosted_win32.c
"
        ;;
    Darwin)
        HEADER_FILES="${HEADER_FILES}
platform/platform_macos.h
platform/unix_common.h
stb_truetype.h
"
        ;;
    *) die "unsupported-host:$PLATFORM" ;;
esac

for input in $SOURCE_FILES $HEADER_FILES; do
    [ -f "$RUNTIME_DIR/$input" ] || die "missing-runtime-input:$input"
done

TMP_DIR=$(mktemp -d "$OUTPUT_ROOT/.core-c-bootstrap.tmp.XXXXXX")
trap 'rm -rf "$TMP_DIR"' EXIT INT TERM
OBJECT_DIR="$TMP_DIR/objects"
REPEAT_OBJECT_DIR="$TMP_DIR/repeat-objects"
LOCAL_INPUTS_FILE="$TMP_DIR/local-runtime-inputs.txt"
mkdir -p "$OBJECT_DIR" "$REPEAT_OBJECT_DIR"
: >"$LOCAL_INPUTS_FILE"

CC_VERSION_FILE="$TMP_DIR/cc.version.txt"
AR_VERSION_FILE="$TMP_DIR/ar.version.txt"
NM_VERSION_FILE="$TMP_DIR/nm.version.txt"
"$CC_PATH" --version >"$CC_VERSION_FILE" 2>&1 ||
    die "cc-version-failed"
if ! "$AR_PATH" --version >"$AR_VERSION_FILE" 2>&1; then
    "$AR_PATH" -V >"$AR_VERSION_FILE" 2>&1 || true
fi
[ -s "$AR_VERSION_FILE" ] || printf '%s\n' "version-output-unavailable" >"$AR_VERSION_FILE"
if ! "$NM_PATH" --version >"$NM_VERSION_FILE" 2>&1; then
    "$NM_PATH" -V >"$NM_VERSION_FILE" 2>&1 || true
fi
[ -s "$NM_VERSION_FILE" ] || printf '%s\n' "version-output-unavailable" >"$NM_VERSION_FILE"

COMMON_FLAGS="-c -Os -ffunction-sections -fdata-sections -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-stack-protector -fPIC -std=gnu11 -DSIMPLE_CORE_C_STANDALONE=1"
TARGET_FLAGS=""
case "$ARCH" in
    arm64|aarch64) TARGET_FLAGS="-mno-outline-atomics" ;;
esac

OBJECTS=""
for source in $SOURCE_FILES; do
    object="$OBJECT_DIR/$(basename "$source" .c).o"
    depfile="$OBJECT_DIR/$(basename "$source" .c).d"
    # Deliberate word splitting applies the frozen flag vectors above.
    # shellcheck disable=SC2086
    "$CC_PATH" $COMMON_FLAGS $TARGET_FLAGS \
        -MMD -MF "$depfile" \
        -I"$RUNTIME_DIR" -I"$RUNTIME_DIR/platform" \
        "$RUNTIME_DIR/$source" -o "$object" ||
        die "compile-failed:$source"
    OBJECTS="$OBJECTS $object"
    sed 's/\\$//' "$depfile" |
        tr '\n' ' ' |
        cut -d: -f2- |
        tr ' ' '\n' |
        while IFS= read -r dependency; do
            case "$dependency" in
                "$RUNTIME_DIR"/*) printf '%s\n' "$dependency" ;;
                "$ROOT_DIR/$RUNTIME_DIR"/*)
                    printf '%s\n' "${dependency#"$ROOT_DIR/"}"
                    ;;
            esac
        done >>"$LOCAL_INPUTS_FILE"
done
for declared_input in $SOURCE_FILES $HEADER_FILES; do
    printf '%s\n' "$RUNTIME_DIR/$declared_input" >>"$LOCAL_INPUTS_FILE"
done
printf '%s\n' "$RUNTIME_DIR/test/rt_string_free_selfcheck.c" >>"$LOCAL_INPUTS_FILE"
printf '%s\n' "$RUNTIME_DIR/test/runtime_coverage_core_selfcheck.c" >>"$LOCAL_INPUTS_FILE"
printf '%s\n' "$RUNTIME_DIR/test/rt_transient_heap_scope_selfcheck.c" >>"$LOCAL_INPUTS_FILE"
printf '%s\n' "$RUNTIME_DIR/test/rt_mem_guard_native_selfcheck.c" >>"$LOCAL_INPUTS_FILE"
printf '%s\n' "$RUNTIME_DIR/test/rt_mem_guard_stale_slot_selfcheck.c" >>"$LOCAL_INPUTS_FILE"
printf '%s\n' "$RUNTIME_DIR/test/rt_mem_guard_after_sweep_selfcheck.c" >>"$LOCAL_INPUTS_FILE"
printf '%s\n' "$RUNTIME_DIR/test/rt_tls13_sha256_sleep_selfcheck.c" >>"$LOCAL_INPUTS_FILE"
sort -u -o "$LOCAL_INPUTS_FILE" "$LOCAL_INPUTS_FILE"

ARCHIVE="$TMP_DIR/libsimple_runtime.a"
# Deliberate word splitting preserves canonical source/object order.
# shellcheck disable=SC2086
if [ "$PLATFORM" = "Darwin" ]; then
    # Apple ar has no D option; ZERO_AR_DATE is its deterministic mode.
    # shellcheck disable=SC2086
    ZERO_AR_DATE=1 "$AR_PATH" rcs "$ARCHIVE" $OBJECTS ||
        die "archive-failed"
    ARCHIVE_MODE="ZERO_AR_DATE=1 ar rcs"
else
    # shellcheck disable=SC2086
    "$AR_PATH" rcsD "$ARCHIVE" $OBJECTS ||
        die "archive-failed"
    ARCHIVE_MODE="ar rcsD"
fi
[ -s "$ARCHIVE" ] || die "archive-empty"
"$AR_PATH" t "$ARCHIVE" >"$TMP_DIR/archive.members.txt" ||
    die "archive-members-failed"

# Repeat the complete compile and archive pass into a distinct directory.
# Equality is retained in the manifest instead of inferred from archive mode.
REPEAT_OBJECTS=""
for source in $SOURCE_FILES; do
    repeat_object="$REPEAT_OBJECT_DIR/$(basename "$source" .c).o"
    # shellcheck disable=SC2086
    "$CC_PATH" $COMMON_FLAGS $TARGET_FLAGS \
        -I"$RUNTIME_DIR" -I"$RUNTIME_DIR/platform" \
        "$RUNTIME_DIR/$source" -o "$repeat_object" ||
        die "repeat-compile-failed:$source"
    REPEAT_OBJECTS="$REPEAT_OBJECTS $repeat_object"
done
REPEAT_ARCHIVE="$TMP_DIR/libsimple_runtime.repeat.a"
if [ "$PLATFORM" = "Darwin" ]; then
    # shellcheck disable=SC2086
    ZERO_AR_DATE=1 "$AR_PATH" rcs "$REPEAT_ARCHIVE" $REPEAT_OBJECTS ||
        die "repeat-archive-failed"
else
    # shellcheck disable=SC2086
    "$AR_PATH" rcsD "$REPEAT_ARCHIVE" $REPEAT_OBJECTS ||
        die "repeat-archive-failed"
fi
[ -s "$REPEAT_ARCHIVE" ] || die "repeat-archive-empty"
ARCHIVE_SHA256=$(hash_file "$ARCHIVE")
REPEAT_ARCHIVE_SHA256=$(hash_file "$REPEAT_ARCHIVE")
[ "$ARCHIVE_SHA256" = "$REPEAT_ARCHIVE_SHA256" ] ||
    die "repeat-build-archive-mismatch"
record_check
{
    echo "repeated_build_equal=true"
    echo "archive_sha256=$ARCHIVE_SHA256"
    echo "repeat_archive_sha256=$REPEAT_ARCHIVE_SHA256"
} >"$TMP_DIR/repeated-build.receipt"

"$NM_PATH" -g "$ARCHIVE" >"$TMP_DIR/archive.nm.txt" 2>&1 ||
    die "archive-nm-failed"
"$NM_PATH" -g "$OBJECT_DIR/runtime_native.o" >"$TMP_DIR/runtime_native.nm.txt" 2>&1 ||
    die "runtime-native-nm-failed"
"$NM_PATH" -g "$OBJECT_DIR/runtime_coverage_core.o" >"$TMP_DIR/runtime_coverage_core.nm.txt" 2>&1 ||
    die "runtime-coverage-core-nm-failed"
"$NM_PATH" -g "$OBJECT_DIR/runtime_contracts.o" >"$TMP_DIR/runtime_contracts.nm.txt" 2>&1 ||
    die "runtime-contracts-nm-failed"

nm_has_text_symbol() {
    awk -v expected="$2" '
        NF >= 3 {
            type = $(NF - 1)
            symbol = $NF
            sub(/^_/, "", symbol)
            if (type == "T" && symbol == expected) found = 1
        }
        END { exit(found ? 0 : 1) }
    ' "$1"
}

nm_has_text_symbol "$TMP_DIR/archive.nm.txt" rt_string_free ||
    die "archive-rt-string-free-provider-missing"
record_check
nm_has_text_symbol "$TMP_DIR/runtime_native.nm.txt" rt_string_free ||
    die "runtime-native-rt-string-free-provider-missing"
record_check
for symbol in rt_tls13_sha256 rt_sleep_nanos; do
    nm_has_text_symbol "$TMP_DIR/archive.nm.txt" "$symbol" ||
        die "archive-$symbol-provider-missing"
    record_check
    nm_has_text_symbol "$TMP_DIR/runtime_native.nm.txt" "$symbol" ||
        die "runtime-native-$symbol-provider-missing"
    record_check
done
# Contract-check ABI moved out of runtime_native.c into its own archive member
# (see the note in src/runtime/runtime_native.c); assert it there, not in
# runtime_native.o.
for symbol in simple_contract_check simple_contract_check_msg; do
    nm_has_text_symbol "$TMP_DIR/archive.nm.txt" "$symbol" ||
        die "archive-$symbol-provider-missing"
    record_check
    nm_has_text_symbol "$TMP_DIR/runtime_contracts.nm.txt" "$symbol" ||
        die "runtime-contracts-$symbol-provider-missing"
    record_check
done
for symbol in rt_coverage_enabled rt_coverage_clear rt_coverage_dump_sdn rt_coverage_free_sdn rt_coverage_decision_probe rt_coverage_condition_probe; do
    nm_has_text_symbol "$TMP_DIR/archive.nm.txt" "$symbol" ||
        die "archive-$symbol-provider-missing"
    record_check
    nm_has_text_symbol "$TMP_DIR/runtime_coverage_core.nm.txt" "$symbol" ||
        die "runtime-coverage-core-$symbol-provider-missing"
    record_check
done

# Exactly one archive member may define each of these; -z muldefs makes a
# duplicate definition silent at link time rather than fatal.
assert_single_provider() {
    assert_symbol=$1
    assert_expected=$2
    assert_slug=$(printf '%s' "$assert_symbol" | tr '_' '-')
    PROVIDER_FILE="$TMP_DIR/$assert_symbol.providers.txt"
    : >"$PROVIDER_FILE"
    for object in $OBJECT_DIR/*.o; do
        "$NM_PATH" -g "$object" 2>/dev/null |
            awk -v member="$(basename "$object")" -v expected="$assert_symbol" '
                NF >= 3 {
                    type = $(NF - 1)
                    symbol = $NF
                    sub(/^_/, "", symbol)
                    if (type == "T" && symbol == expected) print member
                }
            ' >>"$PROVIDER_FILE"
    done
    [ "$(wc -l <"$PROVIDER_FILE" | tr -d ' ')" = "1" ] ||
        die "$assert_slug-provider-count"
    [ "$(sed -n '1p' "$PROVIDER_FILE")" = "$assert_expected" ] ||
        die "$assert_slug-provider-not-$assert_expected"
    record_check
}
assert_single_provider rt_string_free runtime_native.o
assert_single_provider simple_contract_check runtime_contracts.o
assert_single_provider simple_contract_check_msg runtime_contracts.o

SELF_CHECK_BIN="$TMP_DIR/rt_string_free_selfcheck"
SELF_CHECK_LOG="$TMP_DIR/rt_string_free_selfcheck.out"
SELF_CHECK_LIBS="-lm -lpthread"
[ "$PLATFORM" != "Linux" ] || SELF_CHECK_LIBS="$SELF_CHECK_LIBS -ldl"
# shellcheck disable=SC2086
"$CC_PATH" -std=gnu11 -O1 \
    "$RUNTIME_DIR/test/rt_string_free_selfcheck.c" \
    "$ARCHIVE" $SELF_CHECK_LIBS -o "$SELF_CHECK_BIN" ||
    die "rt-string-free-selfcheck-link-failed"
"$SELF_CHECK_BIN" >"$SELF_CHECK_LOG" 2>&1 ||
    die "rt-string-free-selfcheck-failed"
grep -q '^SELFCHECK PASSED (0 failures)$' "$SELF_CHECK_LOG" ||
    die "rt-string-free-selfcheck-receipt-missing"
record_check

COVERAGE_SELF_CHECK_BIN="$TMP_DIR/runtime_coverage_core_selfcheck"
COVERAGE_SELF_CHECK_LOG="$TMP_DIR/runtime_coverage_core_selfcheck.out"
# shellcheck disable=SC2086
"$CC_PATH" -std=gnu11 -O1 \
    "$RUNTIME_DIR/test/runtime_coverage_core_selfcheck.c" \
    "$OBJECT_DIR/runtime_coverage_core.o" $SELF_CHECK_LIBS -o "$COVERAGE_SELF_CHECK_BIN" ||
    die "runtime-coverage-core-selfcheck-link-failed"
"$COVERAGE_SELF_CHECK_BIN" >"$COVERAGE_SELF_CHECK_LOG" 2>&1 ||
    die "runtime-coverage-core-selfcheck-failed"
record_check
{
    echo "runtime_coverage_core_selfcheck=pass"
    echo "runtime_coverage_core_selfcheck_output_sha256=$(hash_file "$COVERAGE_SELF_CHECK_LOG")"
} >"$TMP_DIR/runtime-coverage-core-selfcheck.receipt"

TRANSIENT_SELF_CHECK_BIN="$TMP_DIR/rt_transient_heap_scope_selfcheck"
TRANSIENT_SELF_CHECK_LOG="$TMP_DIR/rt_transient_heap_scope_selfcheck.out"
# shellcheck disable=SC2086
"$CC_PATH" -std=gnu11 -O1 \
    "$RUNTIME_DIR/test/rt_transient_heap_scope_selfcheck.c" \
    "$ARCHIVE" $SELF_CHECK_LIBS -o "$TRANSIENT_SELF_CHECK_BIN" ||
    die "rt-transient-heap-scope-selfcheck-link-failed"
"$TRANSIENT_SELF_CHECK_BIN" >"$TRANSIENT_SELF_CHECK_LOG" 2>&1 ||
    die "rt-transient-heap-scope-selfcheck-failed"
grep -q '^SELFCHECK PASSED (0 failures)$' "$TRANSIENT_SELF_CHECK_LOG" ||
    die "rt-transient-heap-scope-selfcheck-receipt-missing"
record_check

MEM_GUARD_SELF_CHECK_BIN="$TMP_DIR/rt_mem_guard_native_selfcheck"
MEM_GUARD_SELF_CHECK_LOG="$TMP_DIR/rt_mem_guard_native_selfcheck.out"
# shellcheck disable=SC2086
"$CC_PATH" -std=gnu11 -O1 \
    "$RUNTIME_DIR/test/rt_mem_guard_native_selfcheck.c" \
    "$ARCHIVE" $SELF_CHECK_LIBS -o "$MEM_GUARD_SELF_CHECK_BIN" ||
    die "rt-mem-guard-native-selfcheck-link-failed"
"$MEM_GUARD_SELF_CHECK_BIN" >"$MEM_GUARD_SELF_CHECK_LOG" 2>&1 ||
    die "rt-mem-guard-native-selfcheck-failed"
grep -q '^SELFCHECK PASSED (0 failures)$' "$MEM_GUARD_SELF_CHECK_LOG" ||
    die "rt-mem-guard-native-selfcheck-receipt-missing"
record_check

MEM_GUARD_STALE_SLOT_SELF_CHECK_BIN="$TMP_DIR/rt_mem_guard_stale_slot_selfcheck"
MEM_GUARD_STALE_SLOT_SELF_CHECK_LOG="$TMP_DIR/rt_mem_guard_stale_slot_selfcheck.out"
# shellcheck disable=SC2086
"$CC_PATH" -std=gnu11 -O1 \
    "$RUNTIME_DIR/test/rt_mem_guard_stale_slot_selfcheck.c" \
    "$ARCHIVE" $SELF_CHECK_LIBS -o "$MEM_GUARD_STALE_SLOT_SELF_CHECK_BIN" ||
    die "rt-mem-guard-stale-slot-selfcheck-link-failed"
"$MEM_GUARD_STALE_SLOT_SELF_CHECK_BIN" >"$MEM_GUARD_STALE_SLOT_SELF_CHECK_LOG" 2>&1 ||
    die "rt-mem-guard-stale-slot-selfcheck-failed"
grep -q '^SELFCHECK PASSED (0 failures)$' "$MEM_GUARD_STALE_SLOT_SELF_CHECK_LOG" ||
    die "rt-mem-guard-stale-slot-selfcheck-receipt-missing"
record_check

MEM_GUARD_AFTER_SWEEP_SELF_CHECK_BIN="$TMP_DIR/rt_mem_guard_after_sweep_selfcheck"
MEM_GUARD_AFTER_SWEEP_SELF_CHECK_LOG="$TMP_DIR/rt_mem_guard_after_sweep_selfcheck.out"
# shellcheck disable=SC2086
"$CC_PATH" -std=gnu11 -O1 \
    "$RUNTIME_DIR/test/rt_mem_guard_after_sweep_selfcheck.c" \
    "$ARCHIVE" $SELF_CHECK_LIBS -o "$MEM_GUARD_AFTER_SWEEP_SELF_CHECK_BIN" ||
    die "rt-mem-guard-after-sweep-selfcheck-link-failed"
"$MEM_GUARD_AFTER_SWEEP_SELF_CHECK_BIN" >"$MEM_GUARD_AFTER_SWEEP_SELF_CHECK_LOG" 2>&1 ||
    die "rt-mem-guard-after-sweep-selfcheck-failed"
grep -q '^SELFCHECK PASSED (0 failures)$' "$MEM_GUARD_AFTER_SWEEP_SELF_CHECK_LOG" ||
    die "rt-mem-guard-after-sweep-selfcheck-receipt-missing"
record_check

HOST_PRIMITIVE_SELF_CHECK_BIN="$TMP_DIR/rt_tls13_sha256_sleep_selfcheck"
HOST_PRIMITIVE_SELF_CHECK_LOG="$TMP_DIR/rt_tls13_sha256_sleep_selfcheck.out"
# shellcheck disable=SC2086
"$CC_PATH" -std=gnu11 -O1 \
    "$RUNTIME_DIR/test/rt_tls13_sha256_sleep_selfcheck.c" \
    "$ARCHIVE" $SELF_CHECK_LIBS -o "$HOST_PRIMITIVE_SELF_CHECK_BIN" ||
    die "rt-tls13-sha256-sleep-selfcheck-link-failed"
"$HOST_PRIMITIVE_SELF_CHECK_BIN" >"$HOST_PRIMITIVE_SELF_CHECK_LOG" 2>&1 ||
    die "rt-tls13-sha256-sleep-selfcheck-failed"
grep -q '^SELFCHECK PASSED (0 failures)$' "$HOST_PRIMITIVE_SELF_CHECK_LOG" ||
    die "rt-tls13-sha256-sleep-selfcheck-receipt-missing"
record_check

# A run that reached here having executed fewer checks than the capsule
# declares is a vacuous pass, not a pass. The floor is raised whenever a
# check is added; it is never lowered to make a run green.
CHECKS_EXPECTED=33
[ "$CHECKS_RUN" -ge "$CHECKS_EXPECTED" ] ||
    die "checks-executed-below-floor:$CHECKS_RUN/$CHECKS_EXPECTED"

if [ -d "$ROOT_DIR/.jj" ] && command -v jj >/dev/null 2>&1; then
    HEAD_REVISION=$(jj -R "$ROOT_DIR" log -r @ --no-graph -T 'commit_id ++ "\n"') || \
        die "jj-head-revision-unavailable"
    RUNTIME_TREE=$(
        while IFS= read -r input; do
            printf '%s %s\n' "$(hash_file "$input")" "$input"
        done <"$LOCAL_INPUTS_FILE" | hash_stream
    ) || die "jj-runtime-tree-unavailable"
else
    HEAD_REVISION=$(git rev-parse HEAD) || die "git-head-revision-unavailable"
    RUNTIME_TREE=$(git rev-parse HEAD:src/runtime) || die "git-runtime-tree-unavailable"
fi
SOURCE_LIST_SHA256=$(printf '%s\n' $SOURCE_FILES | hash_stream)
HEADER_LIST_SHA256=$(printf '%s\n' $HEADER_FILES | hash_stream)
LOCAL_INPUT_LIST_SHA256=$(hash_file "$LOCAL_INPUTS_FILE")

MANIFEST="$TMP_DIR/capsule.manifest"
{
    echo "schema=core-c-bootstrap-runtime-capsule-v1"
    echo "status=pass"
    echo "head_revision=$HEAD_REVISION"
    echo "runtime_tree=$RUNTIME_TREE"
    echo "platform=$PLATFORM"
    echo "arch=$ARCH"
    echo "cc_path=$CC_PATH"
    echo "cc_binary_sha256=$(hash_file "$CC_PATH")"
    echo "cc_version_sha256=$(hash_file "$CC_VERSION_FILE")"
    echo "ar_path=$AR_PATH"
    echo "ar_binary_sha256=$(hash_file "$AR_PATH")"
    echo "ar_version_sha256=$(hash_file "$AR_VERSION_FILE")"
    echo "nm_path=$NM_PATH"
    echo "nm_binary_sha256=$(hash_file "$NM_PATH")"
    echo "nm_version_sha256=$(hash_file "$NM_VERSION_FILE")"
    echo "common_flags=$COMMON_FLAGS"
    echo "target_flags=$TARGET_FLAGS"
    echo "archive_mode=$ARCHIVE_MODE"
    echo "source_list_sha256=$SOURCE_LIST_SHA256"
    echo "header_list_sha256=$HEADER_LIST_SHA256"
    echo "local_input_list_sha256=$LOCAL_INPUT_LIST_SHA256"
    echo "archive_sha256=$ARCHIVE_SHA256"
    echo "repeat_archive_sha256=$REPEAT_ARCHIVE_SHA256"
    echo "repeated_build_equal=true"
    echo "repeated_build_receipt_sha256=$(hash_file "$TMP_DIR/repeated-build.receipt")"
    echo "archive_members_sha256=$(hash_file "$TMP_DIR/archive.members.txt")"
    echo "rt_string_free_archive_symbol=T"
    echo "rt_string_free_provider=runtime_native.o"
    echo "rt_string_free_selfcheck=pass"
    echo "rt_string_free_selfcheck_output_sha256=$(hash_file "$SELF_CHECK_LOG")"
    echo "runtime_coverage_core_selfcheck=pass"
    echo "runtime_coverage_core_selfcheck_receipt_sha256=$(hash_file "$TMP_DIR/runtime-coverage-core-selfcheck.receipt")"
    echo "runtime_coverage_core_selfcheck_output_sha256=$(hash_file "$COVERAGE_SELF_CHECK_LOG")"
    echo "rt_transient_heap_scope_selfcheck=pass"
    echo "rt_transient_heap_scope_selfcheck_output_sha256=$(hash_file "$TRANSIENT_SELF_CHECK_LOG")"
    echo "rt_mem_guard_native_selfcheck=pass"
    echo "rt_mem_guard_native_selfcheck_output_sha256=$(hash_file "$MEM_GUARD_SELF_CHECK_LOG")"
    echo "rt_mem_guard_stale_slot_selfcheck=pass"
    echo "rt_mem_guard_stale_slot_selfcheck_output_sha256=$(hash_file "$MEM_GUARD_STALE_SLOT_SELF_CHECK_LOG")"
    echo "rt_mem_guard_after_sweep_selfcheck=pass"
    echo "rt_mem_guard_after_sweep_selfcheck_output_sha256=$(hash_file "$MEM_GUARD_AFTER_SWEEP_SELF_CHECK_LOG")"
    echo "rt_tls13_sha256_provider=runtime_native.o"
    echo "rt_sleep_nanos_provider=runtime_native.o"
    echo "rt_tls13_sha256_sleep_selfcheck=pass"
    echo "rt_tls13_sha256_sleep_selfcheck_output_sha256=$(hash_file "$HOST_PRIMITIVE_SELF_CHECK_LOG")"
    echo "simple_contract_check_archive_symbol=T"
    echo "simple_contract_check_provider=runtime_contracts.o"
    echo "simple_contract_check_msg_archive_symbol=T"
    echo "simple_contract_check_msg_provider=runtime_contracts.o"
    echo "checks_executed=$CHECKS_RUN"
    echo "producer_script_sha256=$(hash_file scripts/check/build-core-c-bootstrap-runtime-capsule.shs)"
    while IFS= read -r input; do
        key=$(printf '%s' "${input#"$RUNTIME_DIR/"}" | tr '/.' '__')
        echo "input_${key}_sha256=$(hash_file "$input")"
    done <"$LOCAL_INPUTS_FILE"
    for object in $OBJECT_DIR/*.o; do
        member=$(basename "$object")
        key=$(printf '%s' "$member" | tr '/.' '__')
        echo "object_${key}_sha256=$(hash_file "$object")"
    done
} >"$MANIFEST"

MANIFEST_SHA256=$(hash_file "$MANIFEST")
mv "$TMP_DIR" "$FINAL_DIR"
trap - EXIT INT TERM

echo "core_c_runtime_capsule_status=pass"
echo "core_c_runtime_capsule_dir=$FINAL_DIR"
echo "core_c_runtime_capsule_archive=$FINAL_DIR/libsimple_runtime.a"
echo "core_c_runtime_capsule_archive_sha256=$ARCHIVE_SHA256"
echo "core_c_runtime_capsule_manifest=$FINAL_DIR/capsule.manifest"
echo "core_c_runtime_capsule_manifest_sha256=$MANIFEST_SHA256"
echo "core_c_runtime_capsule_rt_string_free_provider=runtime_native.o"
echo "core_c_runtime_capsule_simple_contract_check_provider=runtime_contracts.o"
echo "core_c_runtime_capsule_selfcheck=pass"
echo "core_c_runtime_capsule_checks_executed=$CHECKS_RUN"
