#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
build_dir="$repo_root/build/check-simpleos-posix-ext-positioned-io"
contract_test="$repo_root/test/01_unit/os/simpleos_posix_ext_positioned_io_contract_test.c"

mkdir -p "$build_dir"
cc -std=c11 -Wall -Wextra -Werror \
    -I"$repo_root/src/os/libc" \
    -I"$repo_root/src/os/libc/include" \
    "$contract_test" -o "$build_dir/contract_test"
"$build_dir/contract_test"

echo "simpleos_posix_ext_positioned_io_status=pass"
