#!/bin/sh
# Fence: `[T]()` is NOT a typed-empty-array constructor in Simple.
#
# `var xs = [i64]()` does not build an empty [i64]. The `[` opens an ARRAY
# LITERAL, so `i64` is parsed as a variable reference and the whole thing is a
# call of a list value. Measured on the Rust bootstrap seed (bin/simple), the
# form fails uniformly for EVERY element type -- primitives, class types and
# nested `[[u8]]()` alike, in assignment, argument and field-init position:
#
#   interpreter lane : error: semantic: variable `i64` not found
#                      error: semantic: value is not callable   (class element)
#   JIT lane         : SIGSEGV (rc=139) -- a hard crash, not a diagnostic
#
# There is no element type for which `[T]()` works, so any hit is a defect.
# Correct forms:
#     var xs: [T] = []          # binding
#     field: []                 # named field-init where the field is typed [T]
#
# History: doc/08_tracking/bug/typed_empty_array_constructor_rejected_2026-08-10.md
# Two earlier sweeps under-counted this family because they anchored the grep on
# assignment position (`= \[u8\]()`), missing argument/field-init/return uses.
# This fence therefore anchors on the EXPRESSION-START position instead, which
# is the only thing that distinguishes the defect from the legitimate
# postfix-index-then-call form `self.bindings[name]()` (src/compiler/00.common/di.spl).
#
# Uses /usr/bin/grep deliberately: bare `grep` here is a wrapped ugrep that
# honours .gitignore and UNDER-reports.

set -u
cd "$(dirname "$0")/../.." || exit 2
LOG="${TMPDIR:-/tmp}/check-typed-empty-array-ctor.$$.log"

GREP=/usr/bin/grep
[ -x "$GREP" ] || { echo "ERROR — nothing was checked: $GREP missing"; exit 2; }

# Expression-start `[Ident]()`: preceded by start-of-line or a char that cannot
# end a postfix-indexable expression. Excludes `foo[k]()` and `a.b[k]()`.
PAT='(^|[^]A-Za-z0-9_.)])\[[A-Za-z_][A-Za-z0-9_]*\]\(\)'

# Directories owned by other agents / vendored, plus `sizeof[T]()` prose.
EXCLUDE='^src/lib/blink/|^src/lib/cc/|^src/lib/content/|browser_engine/|^src/compiler_rust/|/vendor/|sizeof\['

SCAN_DIRS=""
for d in src/lib src/app src/compiler src/runtime; do
    [ -d "$d" ] && SCAN_DIRS="$SCAN_DIRS $d"
done
# A sweep that searches a nonexistent directory silently "passes". Fail closed.
[ -n "$SCAN_DIRS" ] || { echo "ERROR — nothing was checked: no scan dirs exist"; exit 2; }

# --- control: the pattern MUST match a known-bad fixture, or the regex is dead.
CTRL="${TMPDIR:-/tmp}/typed-empty-array-ctrl.$$.spl"
{
    printf 'fn main():\n'
    printf '    var a = [i64]()\n'          # must be flagged
    printf '    var b: [i64] = []\n'        # must NOT be flagged
    printf '    val c = self.bindings[name]()\n'  # must NOT be flagged
} > "$CTRL"
CTRL_HITS=$($GREP -cE "$PAT" "$CTRL" 2>/dev/null || true)
rm -f "$CTRL"
if [ "$CTRL_HITS" != "1" ]; then
    echo "ERROR — nothing was checked: control fixture matched $CTRL_HITS, expected 1 (regex is broken)"
    exit 2
fi

FILES=$($GREP -rlE "$PAT" --include=*.spl $SCAN_DIRS 2>/dev/null | $GREP -vE "$EXCLUDE" || true)
$GREP -rnE "$PAT" --include=*.spl $SCAN_DIRS 2>/dev/null | $GREP -vE "$EXCLUDE" > "$LOG" 2>&1 || true
HITS=$(wc -l < "$LOG" | tr -d ' ')

SCANNED=$($GREP -rl --include=*.spl 'fn ' $SCAN_DIRS 2>/dev/null | wc -l | tr -d ' ')
[ "$SCANNED" -gt 0 ] || { echo "ERROR — nothing was checked: 0 .spl files scanned"; exit 2; }

if [ "$HITS" != "0" ]; then
    echo "--- offending sites ---"
    cat "$LOG"
    echo "-----------------------"
    echo "log preserved at: $LOG"
    echo "FAIL — $HITS site(s) use \`[T]()\`, which is not a typed-empty-array constructor (control=1, scanned=$SCANNED files). Use \`var x: [T] = []\`."
    exit 1
fi

rm -f "$LOG"
echo "PASS — $SCANNED .spl files scanned, control=1, offending=0 (no \`[T]()\` pseudo-constructor in owned source)"
exit 0
