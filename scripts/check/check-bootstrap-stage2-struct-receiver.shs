#!/bin/sh
# Fail-fast capability probe for a freshly built bootstrap-stage compiler.
set -eu

if [ "$#" -lt 2 ] || [ "$#" -gt 4 ]; then
    echo "usage: $0 <stage2-compiler> <runtime-archive-or-directory> [target] [backend]" >&2
    exit 2
fi

stage2_compiler=$1
stage2_runtime=$2
stage2_target=${3:-x86_64-unknown-linux-gnu}
stage2_backend=${4:-cranelift}

[ -x "$stage2_compiler" ] || {
    echo "error: stage2 compiler is not executable: $stage2_compiler" >&2
    exit 2
}
[ -e "$stage2_runtime" ] || {
    echo "error: stage2 runtime is missing: $stage2_runtime" >&2
    exit 2
}
if [ -d "$stage2_runtime" ]; then
    stage2_runtime_dir=$stage2_runtime
else
    stage2_runtime_dir=$(dirname -- "$stage2_runtime")
fi

stage2_probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/simple-stage2-receiver.XXXXXX")
trap 'rm -rf "$stage2_probe_dir"' EXIT HUP INT TERM

stage2_probe_bin="$stage2_probe_dir/bootstrap-struct-receiver-guard"
if ! env SIMPLE_BOOTSTRAP=1 SIMPLE_NO_DEPRECATED_WARNINGS=1 \
    "$stage2_compiler" native-build \
    --target "$stage2_target" \
    --backend "$stage2_backend" \
    --source src/compiler --source src/app --source src/lib \
    --entry-closure \
    --threads 1 \
    --cache-dir "$stage2_probe_dir/cache" \
    --entry test/04_smoke/bootstrap_struct_receiver_guard.spl \
    --runtime-path "$stage2_runtime_dir" \
    -o "$stage2_probe_bin"; then
    echo "error: stage2 lacks the mutable receiver/runtime capability" >&2
    exit 1
fi

[ -x "$stage2_probe_bin" ] || {
    echo "error: stage2 receiver probe produced no executable" >&2
    exit 1
}

set +e
stage2_probe_output=$($stage2_probe_bin 2>&1)
stage2_probe_status=$?
set -e
[ "$stage2_probe_status" -eq 0 ] || {
    echo "error: stage2 receiver probe failed with status $stage2_probe_status: $stage2_probe_output" >&2
    exit 1
}
[ "$stage2_probe_output" = "bootstrap struct receiver guard" ] || {
    echo "error: stage2 receiver probe returned unexpected output" >&2
    exit 1
}

echo "bootstrap_stage2_struct_receiver=PASS"
