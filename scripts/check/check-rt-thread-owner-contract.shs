#!/bin/sh
# Runner for src/runtime/test/rt_thread_owner_contract_selfcheck.c.
#
# The C rt_thread_* family must stay a twin of the Rust owner because
# --runtime-owner picks one of them per link. This compiles the core-C runtime
# composition (source list read from runtime_compiler.spl, defines mirroring
# its branch for a native-all link) plus the selfcheck, links and runs it.
#
#   sh scripts/check/check-rt-thread-owner-contract.shs [work-dir]
#
# Verdict is the last stdout line: PASS (exit 0) / FAIL (exit 1) /
# ERROR — nothing was checked (exit 2).
set -u

repo=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "ERROR — nothing was checked (not in a git checkout)"; exit 2; }
work=${1:-$(mktemp -d)}
mkdir -p "$work" || { echo "ERROR — nothing was checked (cannot create $work)"; exit 2; }
rt="$repo/src/runtime"
rc_spl="$repo/src/compiler/70.backend/backend/runtime_compiler.spl"
sources=$(awk '/^pub fn runtime_core_c_sources_v1/ {f=1} f && /^    \["/ {print; exit}' "$rc_spl" |
    sed 's/^    \[\(.*\)\]$/\1/' | tr -d '" ' | tr ',' ' ')
[ -n "$sources" ] || { echo "ERROR — nothing was checked (no core-C source list in $rc_spl)"; exit 2; }

case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) msvc=1 ;;
    *) msvc=0 ;;
esac

objs=""
compile() {
    name=$1; src=$2
    if [ "$msvc" = 1 ]; then
        out="$work/$name.obj"
        MSYS2_ARG_CONV_EXCL='*' clang-cl /nologo /c /O2 /MD /std:c11 /I "$rt" /I "$rt/platform" \
            /DSIMPLE_ABI_VERSION=1 /DSIMPLE_ABI_VERSION_DEFERRED=0 /DSIMPLE_RUNTIME_TIMESTAMP_OWNER=1 \
            /DSIMPLE_RUNTIME_MEMORY_OWNER=1 /DSIMPLE_CORE_C_STANDALONE=1 "/Fo$out" "$src" > "$work/$name.log" 2>&1
    else
        out="$work/$name.o"
        "${CC:-cc}" -c -O2 -std=gnu11 -fPIC -I "$rt" -I "$rt/platform" \
            -DSIMPLE_ABI_VERSION=1 -DSIMPLE_ABI_VERSION_DEFERRED=0 -DSIMPLE_RUNTIME_TIMESTAMP_OWNER=1 \
            -DSIMPLE_RUNTIME_MEMORY_OWNER=1 -DSIMPLE_CORE_C_STANDALONE=1 -o "$out" "$src" > "$work/$name.log" 2>&1
    fi
    status=$?
    [ "$status" -eq 0 ] || { echo "FAIL — $name.c did not compile (see $work/$name.log)"; exit 1; }
    objs="$objs $out"
}

for name in $sources; do compile "$name" "$rt/$name.c"; done
if [ "$msvc" = 0 ] && [ "$(uname -s)" = Linux ]; then
    for name in hosted_cocoa hosted_win32; do compile "$name" "$rt/$name.c"; done
fi
compile selfcheck "$rt/test/rt_thread_owner_contract_selfcheck.c"

exe="$work/rt_thread_owner_contract_selfcheck"
if [ "$msvc" = 1 ]; then
    exe="$exe.exe"
    # shellcheck disable=SC2086
    MSYS2_ARG_CONV_EXCL='*' clang-cl /nologo $objs "/Fe$exe" kernel32.lib user32.lib ws2_32.lib bcrypt.lib \
        advapi32.lib userenv.lib ntdll.lib d3d11.lib dxgi.lib pdh.lib netapi32.lib psapi.lib powrprof.lib \
        dbghelp.lib ole32.lib oleaut32.lib shell32.lib crypt32.lib secur32.lib ncrypt.lib iphlpapi.lib \
        gdi32.lib synchronization.lib > "$work/link.log" 2>&1
else
    # shellcheck disable=SC2086
    "${CC:-cc}" $objs -o "$exe" -lpthread -ldl -lm > "$work/link.log" 2>&1
fi
status=$?
[ "$status" -eq 0 ] || { echo "FAIL — selfcheck did not link (see $work/link.log)"; exit 1; }

"$exe"
status=$?
[ "$status" -eq 0 ] || { echo "FAIL — rt_thread_owner_contract_selfcheck exited $status"; exit 1; }
echo "PASS — 1 selfcheck executed (thread owner contract), $(printf '%s' "$sources" | wc -w | tr -d ' ') core-C objects linked"
