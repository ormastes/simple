#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
work_dir=$(mktemp -d)
trap 'rm -r "$work_dir"' EXIT HUP INT TERM

common_flags='-std=c11 -O2 -fPIC -fvisibility=hidden -fno-asynchronous-unwind-tables -fno-unwind-tables -fno-stack-protector -fcf-protection=none'
cc $common_flags -c "$repo_dir/src/runtime/aspect/mcdc_vector_aspect_v1.c" -o "$work_dir/provider-a.o"
cc $common_flags -c "$repo_dir/src/runtime/aspect/mcdc_vector_aspect_v1.c" -o "$work_dir/provider-b.o"
cmp "$work_dir/provider-a.o" "$work_dir/provider-b.o"

cc -std=c11 -O2 -Wall -Wextra -Werror -pedantic \
  "$repo_dir/test/01_unit/runtime/mcdc_aspect_object_converter_selfcheck.c" \
  -o "$work_dir/selfcheck"
"$work_dir/selfcheck" "$work_dir/provider-a.o"

# Exercise the runtime address bridge used by retained inner-SMF relocation,
# plus the fully disarmed patchpoint. Linker wrapping makes the zero-allocation
# result observable rather than inferred from source.
cc -std=gnu11 -O2 -Wall -Wextra -Werror -pedantic \
  "$repo_dir/test/01_unit/runtime/mcdc_aspect_smf_activation_selfcheck.c" \
  "$repo_dir/src/runtime/runtime_coverage_core.c" \
  -Wl,--wrap=malloc -Wl,--wrap=calloc -Wl,--wrap=realloc -Wl,--wrap=free \
  -Wl,--wrap=mmap -Wl,--wrap=mprotect -Wl,--wrap=munmap \
  -Wl,--wrap=dlopen -Wl,--wrap=dlsym -Wl,--wrap=dlclose \
  -lm -lpthread -ldl -o "$work_dir/smf-activation-selfcheck"
activation_receipt=$("$work_dir/smf-activation-selfcheck")
printf '%s\n' "$activation_receipt"
printf '%s\n' "$activation_receipt" | grep -Eq \
  'baseline_mean_ns=[0-9]+ disarmed_mean_ns=[0-9]+ disarmed_delta_ns=[0-9]+ .*heap_allocations=0 mapping_calls=0 dynload_calls=0' || {
    echo 'FAIL dynamic-disarmed-minimal-overhead-receipt' >&2
    exit 1
  }

# Deterministically pause a reader after its speculative target load. Unbind
# must be allowed to settle, and the reader's post-lease revalidation must then
# reject the stale target rather than entering unloaded code.
cc -std=gnu11 -O2 -Wall -Wextra -Werror -pedantic \
  -DSIMPLE_MCDC_DYNAMIC_RACE_TEST \
  "$repo_dir/test/01_unit/runtime/mcdc_dynamic_patchpoint_race_selfcheck.c" \
  "$repo_dir/src/runtime/runtime_coverage_core.c" \
  -lm -lpthread -ldl -o "$work_dir/patchpoint-race-selfcheck"
"$work_dir/patchpoint-race-selfcheck"

# The policy owner must branch before conversion, hashing, or packing. This is
# a source-level zero-work guard that remains meaningful without a Simple CLI.
policy_file="$repo_dir/src/compiler/99.loader/mcdc_aspect_pack_payload.spl"
awk '
  /fn mcdc_build_aspect_pack_for_policy_v1/ { in_fn=1 }
  in_fn && /if policy == McdcPolicy.StaticOff/ { off=NR }
  in_fn && /mcdc_build_aspect_pack_v1\(object_bytes\)/ { build=NR }
  END { if (!off || !build || off >= build) exit 1 }
' "$policy_file"

# Publication is the final phase: exact relocation preflight, RW patching and
# RX restoration must all precede target registration/binding.
activation_file="$repo_dir/src/compiler/99.loader/loader/module_loader.spl"
awk '
  /fn moduleloader_activate_mcdc_aspect_payload_v1/ { in_fn=1 }
  in_fn && /apply_smf_relocations\(/ && !apply { apply=NR }
  in_fn && /native_make_executable\(address/ && !rx { rx=NR }
  in_fn && /val bind_status = rt_mcdc_dynamic_bind_v1\(/ && !publish { publish=NR }
  END { if (!apply || !rx || !publish || apply >= publish || rx >= publish) exit 1 }
' "$activation_file"

hash_a=$(sha256sum "$work_dir/provider-a.o" | cut -d ' ' -f 1)
hash_b=$(sha256sum "$work_dir/provider-b.o" | cut -d ' ' -f 1)
test "$hash_a" = "$hash_b"
printf 'PASS reproducible_object_sha256=%s static_off_build_calls=0\n' "$hash_a"
