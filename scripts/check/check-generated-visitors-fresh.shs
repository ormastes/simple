#!/bin/sh
# check-generated-visitors-fresh.shs — the fold-style AST/HIR visitors must be
# GENERATED, never hand-edited (hardening plan §11.5 / §11.9, lanes C3 + C4).
#
# Sibling of check-compiler-schema-fresh.shs, and the same argument: a walker
# that is hand-maintained silently skips the variant somebody added yesterday.
# These two files are emitted from the same authoritative enum declarations
# that feed the A1 registry, so this gate is what makes "generated" true rather
# than aspirational — without it the checked-in copy is just source that
# happens to have a header claiming it was generated.
#
# Regenerates every dialect into a temp tree and byte-compares each file
# against the checked-in copy. A stale file is a FAIL; regenerating 0 files
# (missing declaration sources) is an ERROR, never a pass.
#
# Verdict is always the LAST line of stdout:
#   PASS — <n> generated visitor(s) checked, fresh          exit 0
#   FAIL — stale: <files>                                    exit 1
#   ERROR — nothing was checked (<reason>)                   exit 2
#
# --root <dir> checks an alternate tree (both the declaration SOURCES and the
# generated files are resolved under it); default is the repo root. The
# generator itself always runs from the repo, since module resolution needs
# the stdlib.
#
# --selftest runs first and is fatal.

set -u

# Phase 9: mint an evidence receipt for this gate's verdict (additive; never
# changes the verdict or the exit status). See scripts/check/lib/emit_receipt.shs.
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/lib/emit_receipt.shs"

REPO_ROOT=${REPO_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}
SIMPLE_BIN=${SIMPLE_BIN:-"$REPO_ROOT/bin/simple"}
GEN_MAIN="src/app/compiler_schema/main.spl"

# Every generated fold visitor, as paths relative to a tree root. Kept in sync
# with fold_gen.spl's dialect table by the selftest, which fails if the
# generator emits a file this list does not name.
GEN_FILES="src/compiler/20.hir/generated/hir_visitor.spl
src/compiler/10.frontend/generated/ast_visitor.spl"

verdict_error() {
    echo "ERROR — nothing was checked ($1)"
    exit 2
}

# Regenerate <root>'s declarations into <out_tree>; echo the file count.
regen() {
    _root=$1
    _out=$2
    ( cd "$REPO_ROOT" && SIMPLE_REPO_ROOT="$_root" "$SIMPLE_BIN" run "$GEN_MAIN" folds "$_out" ) \
        > "$_out.log" 2>&1
    _rc=$?
    if [ "$_rc" -ne 0 ]; then
        return 1
    fi
    grep -o 'generated [0-9]* fold visitor file' "$_out.log" | head -1 | awk '{print $2}'
    return 0
}

scan() {
    _root=$1
    _tmp=$(mktemp -d) || verdict_error "mktemp failed"
    _out="$_tmp/tree"
    mkdir -p "$_out"
    _count=$(regen "$_root" "$_out")
    if [ -z "$_count" ]; then
        rm -rf "$_tmp"
        verdict_error "generator failed in $_root"
    fi
    if [ "$_count" -eq 0 ]; then
        rm -rf "$_tmp"
        verdict_error "generator emitted 0 visitor files (missing declaration sources?)"
    fi
    # Every emitted file must be one this script knows about; an unlisted new
    # dialect would otherwise go unchecked forever.
    _emitted=$(cd "$_out" && find . -name '*_visitor.spl' | sed 's|^\./||' | sort)
    _known=$(echo "$GEN_FILES" | sort)
    if [ "$_emitted" != "$_known" ]; then
        rm -rf "$_tmp"
        verdict_error "generator emitted files this check does not list: $_emitted"
    fi
    _checked=0
    _stale=""
    for rel in $GEN_FILES; do
        if [ ! -f "$_root/$rel" ]; then
            _stale="$_stale $rel(missing)"
            _checked=$((_checked + 1))
            continue
        fi
        if ! cmp -s "$_out/$rel" "$_root/$rel"; then
            _stale="$_stale $rel"
        fi
        _checked=$((_checked + 1))
    done
    rm -rf "$_tmp"
    if [ "$_checked" -eq 0 ]; then
        verdict_error "0 files compared"
    fi
    # Receipts only for a scan of the REAL repo root — the selftest drives this
    # same function against fixture repos (see check-compiler-schema-fresh.shs
    # for the same guard and the same reason).
    if [ -n "$_stale" ]; then
        _verdict="FAIL — stale:$_stale"
        echo "$_verdict"
        [ "$_root" = "$REPO_ROOT" ] && { emit_receipt "check-generated-visitors-fresh" "$_verdict" || true; }
        exit 1
    fi
    _verdict="PASS — $_checked generated visitor(s) checked, fresh"
    echo "$_verdict"
    [ "$_root" = "$REPO_ROOT" ] && { emit_receipt "check-generated-visitors-fresh" "$_verdict" || true; }
    exit 0
}

selftest() {
    _st=$(mktemp -d) || { echo "selftest ERROR: mktemp failed"; exit 2; }
    _fix="$_st/repo"
    mkdir -p "$_fix"
    ( cd "$REPO_ROOT" && tar cf - src/app/compiler_schema \
        src/compiler/20.hir/hir_definitions.spl src/compiler/20.hir/hir_types.spl \
        src/compiler/10.frontend/ast.spl src/compiler/10.frontend/parser_types_expr.spl \
        src/compiler/20.hir/generated/hir_visitor.spl \
        src/compiler/10.frontend/generated/ast_visitor.spl ) | ( cd "$_fix" && tar xf - )

    # 1. A freshly generated tree must PASS.
    _r=$( scan "$_fix" ); _rc=$?
    case "$_r" in
        PASS*) : ;;
        *) echo "selftest FAIL: fresh fixture did not PASS: $_r"; rm -rf "$_st"; exit 2 ;;
    esac
    [ "$_rc" -eq 0 ] || { echo "selftest FAIL: fresh fixture exit $_rc"; rm -rf "$_st"; exit 2; }

    # 2. A hand-edited generated file must FAIL.
    echo "# hand edited" >> "$_fix/src/compiler/20.hir/generated/hir_visitor.spl"
    _r=$( scan "$_fix" ); _rc=$?
    case "$_r" in
        FAIL*) : ;;
        *) echo "selftest FAIL: hand-edited visitor did not FAIL: $_r"; rm -rf "$_st"; exit 2 ;;
    esac
    [ "$_rc" -eq 1 ] || { echo "selftest FAIL: hand-edited exit $_rc (want 1)"; rm -rf "$_st"; exit 2; }

    # 3. A DELETED generated file must FAIL, not silently pass.
    rm -f "$_fix/src/compiler/10.frontend/generated/ast_visitor.spl"
    _r=$( scan "$_fix" ); _rc=$?
    case "$_r" in
        FAIL*) : ;;
        *) echo "selftest FAIL: deleted visitor did not FAIL: $_r"; rm -rf "$_st"; exit 2 ;;
    esac

    # 4. A tree with no declaration sources must ERROR, not pass.
    _empty="$_st/empty"
    mkdir -p "$_empty"
    ( cd "$REPO_ROOT" && tar cf - src/app/compiler_schema ) | ( cd "$_empty" && tar xf - )
    _r=$( scan "$_empty" ); _rc=$?
    case "$_r" in
        ERROR*) : ;;
        *) echo "selftest FAIL: missing sources did not ERROR: $_r"; rm -rf "$_st"; exit 2 ;;
    esac
    [ "$_rc" -eq 2 ] || { echo "selftest FAIL: missing-source exit $_rc (want 2)"; rm -rf "$_st"; exit 2; }

    rm -rf "$_st"
    echo "selftest: 4/4 fixtures OK"
}

SCAN_ROOT="$REPO_ROOT"
DO_SELFTEST_ONLY=0
while [ $# -gt 0 ]; do
    case "$1" in
        --selftest) DO_SELFTEST_ONLY=1; shift ;;
        --root) shift; [ $# -gt 0 ] || verdict_error "--root needs a directory"
                SCAN_ROOT=$(cd "$1" 2>/dev/null && pwd) || verdict_error "--root directory not found"
                shift ;;
        *) verdict_error "unknown argument: $1" ;;
    esac
done

selftest || exit 2
if [ "$DO_SELFTEST_ONLY" -eq 1 ]; then
    exit 0
fi
scan "$SCAN_ROOT"
