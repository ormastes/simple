#!/bin/sh
# Serialized, fail-closed UNO Q server verification receipt producer.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
DEVICE=${UNOQ_DEVICE:-3655308719}
OUT_ROOT=${UNOQ_RECEIPT_OUT_ROOT:-$ROOT/build/test-artifacts/simpleos-server-execution-matrix/uno-q}
LOCK_PATH=/tmp/unoq-server-matrix.lock
PRODUCER=$ROOT/scripts/check/collect-unoq-server-verification-receipt.shs
GPU_RUNNER=$ROOT/scripts/check/run-unoq-qrb2210-native-2d-live.shs
CPU_RUNNER=$ROOT/scripts/check/run-unoq-qrb2210-cpu-server-live.shs

case "$DEVICE" in ''|*[!A-Za-z0-9._:-]*) echo "invalid UNOQ_DEVICE" >&2; exit 1 ;; esac
for tool in adb flock sha256sum; do command -v "$tool" >/dev/null 2>&1 || { echo "$tool missing" >&2; exit 2; }; done

START_UTC=$(date -u +%Y-%m-%dT%H:%M:%SZ)
RUN_STAMP=$(date -u +%Y%m%dT%H%M%SZ)
FINAL_DIR=$OUT_ROOT/verify-$RUN_STAMP
TMP_DIR=$OUT_ROOT/.verify-$RUN_STAMP-$$.tmp
mkdir -p "$OUT_ROOT" "$TMP_DIR"
chmod 700 "$TMP_DIR"
cleanup() { [ ! -d "$TMP_DIR" ] || rm -rf "$TMP_DIR"; }
trap cleanup EXIT HUP INT TERM

cp "$PRODUCER" "$TMP_DIR/producer.snapshot.shs"
PRODUCER_SHA=$(sha256sum "$PRODUCER" | awk '{print $1}')
SNAPSHOT_SHA=$(sha256sum "$TMP_DIR/producer.snapshot.shs" | awk '{print $1}')
[ "$PRODUCER_SHA" = "$SNAPSHOT_SHA" ] || { echo "producer snapshot mismatch" >&2; exit 1; }

exec 9>"$LOCK_PATH"
flock -n 9 || { echo "unoq receipt lock busy" >&2; exit 3; }
LOCK_OWNER_PID=$$
HEAD=$(git -C "$ROOT" rev-parse HEAD)
GPU_RUNNER_SHA=$(sha256sum "$GPU_RUNNER" | awk '{print $1}')

run_capture() {
    name=$1
    command_text=$2
    shift 2
    printf '%s\n' "$command_text" >"$TMP_DIR/$name.command"
    set +e
    "$@" >"$TMP_DIR/$name.stdout" 2>"$TMP_DIR/$name.stderr"
    rc=$?
    set -e
    printf '%s\n' "$rc" >"$TMP_DIR/$name.exit"
}

run_capture adb_devices "adb devices -l" adb devices -l
run_capture board_model "adb -s $DEVICE exec-out cat /proc/device-tree/model" adb -s "$DEVICE" exec-out cat /proc/device-tree/model
run_capture board_arch "adb -s $DEVICE shell uname -m" adb -s "$DEVICE" shell uname -m
run_capture board_os_release "adb -s $DEVICE shell cat /etc/os-release" adb -s "$DEVICE" shell cat /etc/os-release
run_capture board_boot_id "adb -s $DEVICE shell cat /proc/sys/kernel/random/boot_id" adb -s "$DEVICE" shell cat /proc/sys/kernel/random/boot_id

CPU_EXPECTED_PATH=scripts/check/run-unoq-qrb2210-cpu-server-live.shs
run_capture cpu_runner_executable "test -x $CPU_EXPECTED_PATH" test -x "$CPU_RUNNER"
cpu_probe_rc=$(tr -d '\r\n' <"$TMP_DIR/cpu_runner_executable.exit")
if [ "$cpu_probe_rc" -eq 0 ]; then
    CPU_COMMAND="sh $CPU_EXPECTED_PATH --device $DEVICE --output-dir build/test-artifacts/simpleos-server-execution-matrix/uno-q/cpu"
    run_capture cpu_preflight "$CPU_COMMAND" sh "$CPU_RUNNER" --device "$DEVICE" --output-dir "$OUT_ROOT/cpu"
    cpu_status=executed
    cpu_reason=canonical-runner-present-see-command-receipt
else
    cpu_status=blocked
    cpu_reason=canonical-runner-not-executable
fi

GPU_RUNNER_PATH=scripts/check/run-unoq-qrb2210-native-2d-live.shs
GPU_COMMAND="sh $GPU_RUNNER_PATH --device $DEVICE --output-dir build/test-artifacts/simpleos-server-execution-matrix/uno-q/gpu"
run_capture gpu_preflight "$GPU_COMMAND" sh "$GPU_RUNNER" --device "$DEVICE" --output-dir "$OUT_ROOT/gpu"
gpu_rc=$(tr -d '\r\n' <"$TMP_DIR/gpu_preflight.exit")

field() {
    key=$1
    count=$(sed -n "s/^$key=//p" "$TMP_DIR/gpu_preflight.stdout" | wc -l | tr -d ' ')
    [ "$count" -eq 1 ] || { echo "GPU field $key missing or duplicate" >&2; exit 1; }
    sed -n "s/^$key=//p" "$TMP_DIR/gpu_preflight.stdout"
}
gpu_status=$(field unoq_native_2d_live_status)
gpu_reason=$(field unoq_native_2d_live_reason)
gpu_evidence_class=$(field unoq_native_2d_live_evidence_class)
[ "$gpu_evidence_class" = live-runner-owned ] || { echo "invalid GPU evidence class" >&2; exit 1; }
case "$gpu_status:$gpu_rc" in blocked:2|fail:1|pass:0) ;; *) echo "GPU status/exit mismatch" >&2; exit 1 ;; esac
case "$gpu_reason" in ''|*[!A-Za-z0-9._:-]*) echo "unsafe GPU reason" >&2; exit 1 ;; esac

model=$(tr -d '\000\r\n' <"$TMP_DIR/board_model.stdout")
arch=$(tr -d '\r\n' <"$TMP_DIR/board_arch.stdout")
os_name=$(sed -n 's/^PRETTY_NAME=//p' "$TMP_DIR/board_os_release.stdout" | head -1 | sed 's/^"//; s/"$//')
boot_id=$(tr -d '\r\n' <"$TMP_DIR/board_boot_id.stdout")

: >"$TMP_DIR/command-receipts.env"
for name in adb_devices board_model board_arch board_os_release board_boot_id cpu_runner_executable gpu_preflight; do
    command_sha=$(sha256sum "$TMP_DIR/$name.command" | awk '{print $1}')
    stdout_sha=$(sha256sum "$TMP_DIR/$name.stdout" | awk '{print $1}')
    stderr_sha=$(sha256sum "$TMP_DIR/$name.stderr" | awk '{print $1}')
    exit_value=$(tr -d '\r\n' <"$TMP_DIR/$name.exit")
    {
        echo "${name}_command_path=$name.command"
        echo "${name}_command_sha256=$command_sha"
        echo "${name}_stdout_path=$name.stdout"
        echo "${name}_stdout_sha256=$stdout_sha"
        echo "${name}_stderr_path=$name.stderr"
        echo "${name}_stderr_sha256=$stderr_sha"
        echo "${name}_exit=$exit_value"
    } >>"$TMP_DIR/command-receipts.env"
done
if [ "$cpu_probe_rc" -eq 0 ]; then
    for suffix in command stdout stderr exit; do
        sha=$(sha256sum "$TMP_DIR/cpu_preflight.$suffix" | awk '{print $1}')
        echo "cpu_preflight_${suffix}_path=cpu_preflight.$suffix" >>"$TMP_DIR/command-receipts.env"
        echo "cpu_preflight_${suffix}_sha256=$sha" >>"$TMP_DIR/command-receipts.env"
    done
fi

FINISH_UTC=$(date -u +%Y-%m-%dT%H:%M:%SZ)
cat >"$TMP_DIR/status.env" <<EOF
schema=simpleos-unoq-server-verification-receipt-v1
start_utc=$START_UTC
finish_utc=$FINISH_UTC
head=$HEAD
producer_path=scripts/check/collect-unoq-server-verification-receipt.shs
producer_snapshot_path=producer.snapshot.shs
producer_sha256=$PRODUCER_SHA
producer_snapshot_sha256=$SNAPSHOT_SHA
gpu_runner_path=$GPU_RUNNER_PATH
gpu_runner_sha256=$GPU_RUNNER_SHA
lock_path=$LOCK_PATH
lock_owner_pid=$LOCK_OWNER_PID
lock_acquired=true
adb_serial=$DEVICE
board_model=$model
board_arch=$arch
board_os=$os_name
board_boot_id=$boot_id
cpu_expected_runner_path=$CPU_EXPECTED_PATH
cpu_runner_executable_exit=$cpu_probe_rc
cpu_status=$cpu_status
cpu_reason=$cpu_reason
gpu_status=$gpu_status
gpu_reason=$gpu_reason
gpu_evidence_class=$gpu_evidence_class
gpu_exit=$gpu_rc
mutation_boundary=identity-reads-and-fail-closed-preflight-only
board_mutated=false
download_performed=false
boot_changed=false
provider_executed=false
EOF

(cd "$TMP_DIR" && sha256sum producer.snapshot.shs *.command *.stdout *.stderr *.exit command-receipts.env status.env >SHA256SUMS)
mv "$TMP_DIR" "$FINAL_DIR"
trap - EXIT HUP INT TERM
printf '%s\n' "$FINAL_DIR"
exit "$gpu_rc"
