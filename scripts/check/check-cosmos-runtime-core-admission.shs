#!/bin/sh
# Fail closed until the production Cosmos firmware build links the core object.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
BUILD="$ROOT/src/os/kernel/arch/arm32/cosmos/build.shs"
POLICY_GATE="$ROOT/scripts/check/check-cosmos-runtime-core-policy.shs"

fail() {
    echo "FAIL cosmos-runtime-core-admission: $*" >&2
    exit 1
}

[ -f "$BUILD" ] || fail "missing Cosmos production build"
[ -x "$POLICY_GATE" ] || fail "missing executable runtime-core policy gate"

grep -F 'cosmos_runtime_core.spl' "$BUILD" >/dev/null ||
    fail "production build omits the pure-Simple runtime-core entry"
grep -F 'cosmos_runtime_core_simple.o' "$BUILD" >/dev/null ||
    fail "production build omits cosmos_runtime_core_simple.o"
grep -F 'OBJECTS="$OBJECTS $OBJ/cosmos_runtime_core_simple.o"' \
    "$BUILD" >/dev/null ||
    fail "production link omits the runtime-core object"
grep -F 'cosmos_runtime_core_copy' "$BUILD" >/dev/null ||
    fail "production build omits runtime-core export guards"
grep -F 'RUNTIME_CORE_OBJECT_UNDEFINED' "$BUILD" >/dev/null ||
    fail "production build omits runtime-core undefined-closure guard"

exec "$POLICY_GATE"
