#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
selfcheck="$root/src/runtime/test/rt_m3_atomic_publication_selfcheck.c"
cc=${CC:-cc}

case $(uname -s) in
  Darwin)
    dead_strip='-Wl,-dead_strip'
    libraries='-lm'
    ;;
  *)
    dead_strip='-Wl,--gc-sections'
    libraries='-ldl -lm'
    ;;
esac

for provider in runtime.c runtime_native.c; do
  output=$(mktemp "${TMPDIR:-/tmp}/simple-m3-publication.XXXXXX")
  trap 'rm -f "$output"' EXIT INT TERM HUP
  # shellcheck disable=SC2086
  "$cc" -std=gnu11 -O0 -ffunction-sections -fdata-sections \
    -I"$root/src/runtime" "$root/src/runtime/$provider" "$selfcheck" \
    $dead_strip $libraries -o "$output"
  "$output"
  rm -f "$output"
  trap - EXIT INT TERM HUP
done

echo 'PASS: M3 staging is complete before atomic no-replace final publication'
