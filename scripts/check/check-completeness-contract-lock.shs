#!/bin/sh
# check-completeness-contract-lock.shs — Phase 0 exit gate of
#   doc/03_plan/compiler/hardening/critical_hardening_plan_2026-08-21.md
# (design: doc/01_research/compiler/hardening/simple_hardening_plan_2026-08-21.md
# §15 Phase 0 / §20.2 Wave 0).
#
# WHAT IT LOCKS
#   The two normative contract docs
#     doc/02_requirements/language/critical_completeness.md
#     doc/04_architecture/compiler/extension_completeness.md
#   name, per frozen contract item, the file that embodies it. This gate:
#     1. extracts every embodying path from both docs and requires it to EXIST;
#     2. delegates registry freshness to check-compiler-schema-fresh.shs;
#     3. runs the machine-readable census (any-escape census + transition
#        coverage) TWICE and requires byte-identical output;
#     4. hashes the artifact list (sorted `path sha256(content)` rows) and
#        compares it with spec/compiler_schema/contract_lock.sdn. Any drift of
#        a contract artifact without a reviewed lock update is a FAIL.
#
# VERDICT (always the last line of stdout)
#   PASS  — <n> contract artifact(s) checked, census regenerates byte-identically   exit 0
#   FAIL  — ...                                                                      exit 1
#   ERROR — nothing was checked (<reason>)                                           exit 2
#   0 artifacts is ERROR, never a pass. A missing bin/simple is ERROR.
#
# USAGE
#   sh scripts/check/check-completeness-contract-lock.shs               # full gate
#   sh scripts/check/check-completeness-contract-lock.shs --selftest    # fixtures only
#   sh scripts/check/check-completeness-contract-lock.shs --update-lock # REVIEWED step
#   sh scripts/check/check-completeness-contract-lock.shs --no-census   # skip step 2+3
#                                                                        # (hash/existence only;
#                                                                        # verdict says so)

set -u

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$REPO_ROOT" || { echo "ERROR — nothing was checked (cannot cd to repo root)"; exit 2; }

DOCS="doc/02_requirements/language/critical_completeness.md doc/04_architecture/compiler/extension_completeness.md"
LOCK="spec/compiler_schema/contract_lock.sdn"
SCHEMA_FRESH="scripts/check/check-compiler-schema-fresh.shs"
CENSUS_ANY="scripts/check/check-any-escape-census.shs"
CENSUS_TRANS="scripts/check/check-compiler-transition-coverage.shs"

MODE="scan"
CENSUS=1
while [ $# -gt 0 ]; do
    case "$1" in
        --selftest) MODE="selftest"; shift ;;
        --update-lock) MODE="update"; shift ;;
        --no-census) CENSUS=0; shift ;;
        *) echo "ERROR — nothing was checked (unknown argument: $1)"; exit 2 ;;
    esac
done

TMP=$(mktemp -d) || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
trap 'rm -rf "$TMP"' EXIT

sha_file() { sha256sum "$1" | cut -d' ' -f1; }

# extract_artifacts <root> <out-file> <docs...>
# Pulls every backticked `src/...`, `spec/...`, `scripts/...` path out of the
# docs, expands globs, drops paths marked UNLANDED on the same row, and writes
# the sorted unique list. Never filters by existence — a missing one is a FAIL.
extract_artifacts() {
    _root=$1; _out=$2; shift 2
    : > "$_out.raw"
    for _d in "$@"; do
        grep -v 'UNLANDED' "$_root/$_d" 2>/dev/null \
          | grep -o '`\(src\|spec\|scripts\)/[^`]*`' | tr -d '`' \
          | grep -v '^spec/compiler_schema/contract_lock.sdn$' >> "$_out.raw"
    done
    : > "$_out"
    while IFS= read -r _p; do
        case "$_p" in
            *\**) ( cd "$_root" && for _g in $_p; do echo "$_g"; done ) >> "$_out" ;;
            *)    echo "$_p" >> "$_out" ;;
        esac
    done < "$_out.raw"
    sort -u -o "$_out" "$_out"
}

# hash_artifacts <root> <list> <rows-out>  -> echoes contract hash; rows-out
# gets `path sha` lines. Missing files are written as `path MISSING`.
hash_artifacts() {
    _root=$1; _list=$2; _rows=$3
    : > "$_rows"
    while IFS= read -r _p; do
        [ -n "$_p" ] || continue
        if [ -f "$_root/$_p" ]; then
            echo "$_p $(sha_file "$_root/$_p")" >> "$_rows"
        else
            echo "$_p MISSING" >> "$_rows"
        fi
    done < "$_list"
    sha256sum "$_rows" | cut -d' ' -f1
}

write_lock() {
    # write_lock <lock-path> <hash> <count> <rows>
    {
        echo "# Contract lock — Phase 0 of critical_hardening_plan_2026-08-21."
        echo "# GENERATED by scripts/check/check-completeness-contract-lock.shs --update-lock."
        echo "# Regenerate ONLY as a reviewed step after a deliberate contract change."
        echo "contract_hash: $2"
        echo "artifact_count: $3"
        echo "artifacts:"
        sed 's/^/  - /' "$4"
    } > "$1"
}

# ---------------------------------------------------------------------------
# SELFTEST — fatal, runs before every scan. Four fixtures on a synthetic tree:
#   clean       lock matches               -> ok
#   drift       artifact content changed   -> hash differs
#   missing     artifact deleted           -> MISSING row
#   empty       doc names no artifact      -> 0 artifacts (caller must ERROR)
# ---------------------------------------------------------------------------
selftest() {
    _fail=0
    _r="$TMP/fx"
    mkdir -p "$_r/src/x" "$_r/doc"
    printf 'a\n' > "$_r/src/x/a.spl"; printf 'b\n' > "$_r/src/x/b.spl"
    printf '| a | `src/x/a.spl` |\n| b | `src/x/b.spl` |\n| u | `src/x/nope.spl` UNLANDED |\n' > "$_r/doc/c.md"
    extract_artifacts "$_r" "$TMP/st.list" doc/c.md
    _n=$(wc -l < "$TMP/st.list" | tr -d ' ')
    [ "$_n" -eq 2 ] || { echo "selftest: clean: expected 2 artifacts, got $_n"; _fail=1; }
    _h1=$(hash_artifacts "$_r" "$TMP/st.list" "$TMP/st.rows")
    _h1b=$(hash_artifacts "$_r" "$TMP/st.list" "$TMP/st.rows")
    [ "$_h1" = "$_h1b" ] || { echo "selftest: clean: hash not reproducible"; _fail=1; }
    printf 'a2\n' > "$_r/src/x/a.spl"
    _h2=$(hash_artifacts "$_r" "$TMP/st.list" "$TMP/st.rows")
    [ "$_h1" != "$_h2" ] || { echo "selftest: drift: content change must change hash"; _fail=1; }
    rm "$_r/src/x/b.spl"
    hash_artifacts "$_r" "$TMP/st.list" "$TMP/st.rows" > /dev/null
    grep -q '^src/x/b.spl MISSING$' "$TMP/st.rows" || { echo "selftest: missing: deleted artifact not reported MISSING"; _fail=1; }
    printf 'no paths here\n' > "$_r/doc/e.md"
    extract_artifacts "$_r" "$TMP/st.empty" doc/e.md
    _n=$(wc -l < "$TMP/st.empty" | tr -d ' ')
    [ "$_n" -eq 0 ] || { echo "selftest: empty: expected 0 artifacts, got $_n"; _fail=1; }
    return $_fail
}

selftest
if [ $? -ne 0 ]; then
    echo "FAIL — selftest failed; no scan was attempted"
    exit 1
fi
if [ "$MODE" = "selftest" ]; then
    echo "PASS — 4 contract artifact(s) checked, selftest only (no tree scan requested)"
    exit 0
fi

# ---------------------------------------------------------------------------
# SCAN
# ---------------------------------------------------------------------------
for _d in $DOCS; do
    [ -f "$_d" ] || { echo "ERROR — nothing was checked (contract doc $_d missing)"; exit 2; }
done
extract_artifacts "$REPO_ROOT" "$TMP/list" $DOCS
# The docs themselves are locked too: editing a row IS a contract change.
for _d in $DOCS; do echo "$_d" >> "$TMP/list"; done; sort -u -o "$TMP/list" "$TMP/list"
N=$(wc -l < "$TMP/list" | tr -d ' ')
[ "$N" -gt 0 ] || { echo "ERROR — nothing was checked (contract docs name 0 artifacts)"; exit 2; }

HASH=$(hash_artifacts "$REPO_ROOT" "$TMP/list" "$TMP/rows")
MISSING=$(grep ' MISSING$' "$TMP/rows" | cut -d' ' -f1)
if [ -n "$MISSING" ]; then
    echo "FAIL — $N contract artifact(s) checked, missing: $(echo "$MISSING" | tr '\n' ' ')"
    exit 1
fi

if [ "$MODE" = "update" ]; then
    write_lock "$LOCK" "$HASH" "$N" "$TMP/rows"
    echo "PASS — $N contract artifact(s) checked, lock REGENERATED at $LOCK ($HASH)"
    exit 0
fi

[ -f "$LOCK" ] || { echo "ERROR — nothing was checked (no lock at $LOCK; run --update-lock as a reviewed step)"; exit 2; }
LOCKED=$(grep '^contract_hash:' "$LOCK" | awk '{print $2}')
if [ "$LOCKED" != "$HASH" ]; then
    grep '^  - ' "$LOCK" | sed 's/^  - //' | sort > "$TMP/lock.rows"
    echo "contract drift (locked vs tree):"
    diff "$TMP/lock.rows" "$TMP/rows" | grep '^[<>]' | head -20
    echo "FAIL — $N contract artifact(s) checked, contract hash drifted ($LOCKED -> $HASH) without a lock update"
    exit 1
fi

if [ "$CENSUS" -eq 0 ]; then
    echo "PASS — $N contract artifact(s) checked, hash locked (census SKIPPED by --no-census)"
    exit 0
fi

[ -x bin/simple ] || { echo "ERROR — nothing was checked (no executable bin/simple)"; exit 2; }

run_gate() { # run_gate <script> <out>  — rc read directly, never via a pipe
    nice -n 10 sh "$1" > "$2" 2>"$2.err"
    _rc=$?
    return $_rc
}

run_gate "$SCHEMA_FRESH" "$TMP/fresh.out"
if [ $? -ne 0 ]; then
    tail -1 "$TMP/fresh.out"
    echo "FAIL — $N contract artifact(s) checked, schema registry not fresh"
    exit 1
fi

for _c in "$CENSUS_ANY" "$CENSUS_TRANS"; do
    _b=$(basename "$_c" .shs)
    run_gate "$_c" "$TMP/$_b.1"; _rc1=$?
    run_gate "$_c" "$TMP/$_b.2"; _rc2=$?
    if [ "$_rc1" -eq 2 ] || [ "$_rc2" -eq 2 ]; then
        echo "ERROR — nothing was checked ($_b could not run: $(tail -1 "$TMP/$_b.1"))"
        exit 2
    fi
    if [ "$_rc1" -ne 0 ] || [ "$_rc2" -ne 0 ]; then
        tail -1 "$TMP/$_b.1"
        echo "FAIL — $N contract artifact(s) checked, census gate $_b failed (rc $_rc1/$_rc2)"
        exit 1
    fi
    if ! cmp -s "$TMP/$_b.1" "$TMP/$_b.2"; then
        diff "$TMP/$_b.1" "$TMP/$_b.2" | head -10
        echo "FAIL — $N contract artifact(s) checked, census $_b is NOT byte-identical across two runs"
        exit 1
    fi
done

echo "PASS — $N contract artifact(s) checked, census regenerates byte-identically"
exit 0
