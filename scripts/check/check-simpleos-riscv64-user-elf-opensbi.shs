#!/bin/sh
# riscv64 fs-exec user-ELF kernel gate (link stage).
#
# Builds examples/09_embedded/simple_os/arch/riscv64/fs_exec_hello_entry.spl
# as a freestanding riscv64 kernel (seed native-build, LLVM backend,
# SIMPLE_BOOT_MINIMAL=1) and reports every undefined symbol at link.
#
#   sh scripts/check/check-simpleos-riscv64-user-elf-opensbi.shs --link-only
#
# Env: SIMPLE_BIN (seed with --features llvm, required),
#      SIMPLE_COMPILER_RT_BUILTINS (riscv64 libclang_rt.builtins; never libgcc),
#      OUT (default build/verify/simpleos-riscv64-user-elf).
# Bug: doc/08_tracking/bug/riscv64_fs_exec_kernel_link_undefined_runtime_2026-11-19.md
#
# Last stdout line is the verdict:
#   PASS - kernel linked (<bytes> bytes), 0 undefined symbols      (exit 0)
#   FAIL - <n> undefined symbol(s): <names>                        (exit 1)
#   ERROR - nothing was checked (<reason>)                         (exit 2)
set -eu
verdict_error() { echo "ERROR - nothing was checked ($*)"; exit 2; }

MODE=${1:-}
[ "$MODE" = "--link-only" ] || verdict_error "only --link-only is implemented; QEMU boot stage lands separately"

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"
SIMPLE_BIN=${SIMPLE_BIN:-}
[ -n "$SIMPLE_BIN" ] && [ -x "$SIMPLE_BIN" ] || verdict_error "SIMPLE_BIN not set to an executable seed"
for tool in openssl od tail; do
    command -v "$tool" >/dev/null 2>&1 || verdict_error "missing tool: $tool"
done

ENTRY=examples/09_embedded/simple_os/arch/riscv64/fs_exec_hello_entry.spl
LDS=examples/09_embedded/simple_os/arch/riscv64/linker.ld
OUT=${OUT:-$ROOT/build/verify/simpleos-riscv64-user-elf}
mkdir -p "$OUT"

# Pinned trust config: a throwaway Ed25519 key per run. The link stage needs
# only the generated module's shape; the boot stage signs with the same key.
openssl genpkey -algorithm ed25519 -out "$OUT/auth.pem" >/dev/null 2>&1 || verdict_error "openssl ed25519 keygen failed"
openssl pkey -in "$OUT/auth.pem" -pubout -outform DER -out "$OUT/auth.der" >/dev/null 2>&1 || verdict_error "openssl pubkey export failed"
tail -c 32 "$OUT/auth.der" > "$OUT/auth.raw"
root_hex=$(od -An -tx1 -v "$OUT/auth.raw" | tr -d ' \n')
root_hash=$(openssl dgst -sha256 -r "$OUT/auth.raw" | cut -d' ' -f1)
GEN=$OUT/generated; mkdir -p "$GEN"
{
    printf 'pub fn rv64_authenticated_pinned_key_id_v1() -> text: "rv64-qemu-acceptance-v1"\n'
    printf 'pub fn rv64_authenticated_pinned_public_key_hex_v1() -> text: "%s"\n' "$root_hex"
    printf 'pub fn rv64_authenticated_pinned_public_key_hash_v1() -> text: "%s"\n' "$root_hash"
    printf 'export rv64_authenticated_pinned_key_id_v1, rv64_authenticated_pinned_public_key_hex_v1, rv64_authenticated_pinned_public_key_hash_v1\n'
} > "$GEN/rv64_auth_trust_config.spl"

KERNEL=$OUT/kernel.elf
LOG=$OUT/kernel-build.log
rm -f "$KERNEL"
set +e
SIMPLE_BOOT_MINIMAL=1 SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LIB="$ROOT/src" \
"$SIMPLE_BIN" native-build --cache-dir "$OUT/native-cache" --source "$GEN" --source src/os \
    --source src/lib --source examples/09_embedded/simple_os --backend llvm \
    --opt-level=aggressive --log off --timeout 1200 --entry-closure --entry "$ENTRY" \
    --target riscv64-unknown-none --linker-script "$LDS" --output "$KERNEL" \
    >"$LOG" 2>&1
rc=$?
set -e

undef=$(grep -o 'undefined symbol: [A-Za-z0-9_.$]*' "$LOG" | sed 's/undefined symbol: //' | sort -u)
n=$(printf '%s\n' "$undef" | grep -c . || true)
if [ "$n" -gt 0 ]; then
    printf '%s\n' "$undef" > "$OUT/undefined.txt"
    echo "FAIL - $n undefined symbol(s): $(printf '%s' "$undef" | tr '\n' ' ')"
    exit 1
fi
[ "$rc" -eq 0 ] && [ -s "$KERNEL" ] || { tail -20 "$LOG" >&2; verdict_error "kernel native-build failed (rc=$rc), log $LOG"; }
[ "$(od -An -tx1 -N4 "$KERNEL" | tr -d ' \n')" = 7f454c46 ] || verdict_error "$KERNEL is not ELF"
echo "PASS - kernel linked ($(wc -c < "$KERNEL") bytes), 0 undefined symbols"
