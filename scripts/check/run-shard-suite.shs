#!/bin/bash
# usage: run-shard-suite.shs <filelist> <logname> [timeout_secs]
# v2 (of /tmp/run_shard.sh): kills the whole process tree after each spec so hung grandchildren
# (e.g. seed-interpreter child CLI invocations) cannot leak and saturate the host.
cd /c/Users/ormas/dev/simple/mainlane
PURE=/c/Users/ormas/dev/simple/bin/simple.exe
export SIMPLE_BINARY="$PURE"
list="$1"; log="$2"; tmo="${3:-240}"
while IFS= read -r f; do
  [ -z "$f" ] && continue
  "$PURE" test "$f" --mode=interpreter > /tmp/shard_one_$$.log 2>&1 &
  pid=$!
  waited=0
  while kill -0 "$pid" 2>/dev/null; do
    sleep 2
    waited=$((waited+2))
    if [ "$waited" -ge "$tmo" ]; then
      taskkill //PID "$pid" //T //F >/dev/null 2>&1
      break
    fi
  done
  wait "$pid" 2>/dev/null
  rc=$?
  if [ $rc -ge 128 ] || [ $rc -eq 124 ]; then echo "  CRASH rc=$rc $f" >> "$log"; continue; fi
  grep -E '^(PASS|FAIL)' /tmp/shard_one_$$.log | head -1 | sed 's/^/  /' >> "$log"
done < "$list"
rm -f /tmp/shard_one_$$.log
echo "SHARD DONE $log"
