# Census driver for THREE ungated spec-vacuity families.
#
# Family 3 -- VALUE-TYPE HELPER MUTATES A COPY (codes VTM001/VTM002).
#   A `struct` in Simple is a VALUE type. A spec helper declared
#       fn delete_key(tree: BTree, k: text):
#           tree.root.keys.remove(k)
#   mutates a COPY; the caller's `var` is untouched, so the call is a silent
#   no-op. The failure is ASYMMETRIC: positive/presence assertions sail
#   through a no-op, only negative/absence assertions go red -- which is why
#   these sat green for months. `class` receivers are REFERENCES and are NOT
#   affected, so the type kind must be resolved, never guessed.
#   A `mut` parameter writes back and is CORRECT -- never flagged.
#   Background: doc/08_tracking/bug/spec_value_type_helper_mutates_copy_family_2026-08-10.md
#
# Family 4 -- SPEC RE-IMPLEMENTS THE CODE UNDER TEST (codes SHADOW/NOSRC).
#   A spec that re-declares its own `struct LeaseManager` and reimplements the
#   logic inside the spec never touches src/. Such a spec can be 100% green
#   while testing nothing in src/.
#   SHADOW is precise (name-level collision with a src/ declaration).
#   NOSRC (a spec importing nothing from src/) is a LOW-PRECISION signal and
#   is reported as a bare count for triage only.
#
# Family 5 -- COMMENT-CHEAT / HOLLOW SOURCE ASSERTION (code HOLLOW).
#   A spec reads a product file and asserts a needle appears in it, but the
#   needle only ever occurs inside a COMMENT of that file. The assertion is
#   green while the behaviour is absent.
#   Background: doc/08_tracking/bug/census_spec_vacuity_comment_detection_false_positives_2026-08-10.md
#
# Usage:
#   bin/simple run scripts/check/census-spec-vacuity.spl [roots...]
#   bin/simple run scripts/check/census-spec-vacuity.spl --selftest
#   bin/simple run scripts/check/census-spec-vacuity.spl --list [roots...]
#
# This is a CENSUS at WARNING severity, not a gate: it exits 0 whenever it
# actually scanned something, however many findings it reports.
#
#   REPORT -- <n> file(s) scanned, ...              (exit 0)
#   ERROR  -- nothing was scanned                   (exit 2)
#
# --selftest runs a positive control before every scan and is FATAL. A
# "0 findings" result from a scorer whose control never fired is
# indistinguishable from a scorer that silently stopped working, so this
# script refuses to scan at all rather than report a vacuous zero.

use std.nogc_sync_mut.io_runtime.{file_read, file_exists, dir_walk, dir_exists, get_args, exit}

# ------------------------------------------------------------------ utilities

fn list_has(xs: [text], v: text) -> bool:
    for x in xs:
        if x == v:
            return true
    false

fn norm_path(p: text) -> text:
    var s = p
    while s.starts_with("./"):
        s = s.substring(2, s.len())
    s

fn index_from(s: text, needle: text, start: i64) -> i64:
    if needle.len() == 0:
        return -1
    var i = start
    while i + needle.len() <= s.len():
        if s.substring(i, i + needle.len()) == needle:
            return i
        i = i + 1
    -1

fn index_of(s: text, needle: text) -> i64:
    index_from(s, needle, 0)

fn is_ident_char(c: text) -> bool:
    if c == "_":
        return true
    if c >= "a" and c <= "z":
        return true
    if c >= "A" and c <= "Z":
        return true
    if c >= "0" and c <= "9":
        return true
    false

fn indent_of(line: text) -> i64:
    var i: i64 = 0
    while i < line.len():
        if line.substring(i, i + 1) != " ":
            return i
        i = i + 1
    i

fn strip_comment(line: text) -> text:
    # Drop a trailing `#` comment unless it sits inside a quoted run.
    # Fast path: the char-by-char walk below rebuilds the text one character
    # at a time, which is quadratic on a value-type `text`.
    if not line.contains("#"):
        return line
    var out: text = ""
    var i: i64 = 0
    var q = ""
    while i < line.len():
        val c = line.substring(i, i + 1)
        if q == "":
            if c == "#":
                return out
            if c == "\"" or c == "'":
                q = c
        else:
            if c == q:
                q = ""
        out = out + c
        i = i + 1
    out

fn should_scan_spl(path: text) -> bool:
    if not path.ends_with(".spl"):
        return false
    if path.contains("/vendor/") or path.contains("/node_modules/"):
        return false
    if path.contains("/target/") or path.contains("/build/"):
        return false
    true

fn is_spec_file(path: text) -> bool:
    path.ends_with("_spec.spl")

# ------------------------------------------------------------------ hashed map
#
# PERFORMANCE DEFECT (fixed here): the previous index was a linear scan over a
# flat name array, so building it cost O(n^2) over 13,232 corpus type names and
# never finished under the interpreter -- four whole-corpus attempts died inside
# the index phase with no verdict line, which reads as "0 findings".
#
# This is an open-addressing-free chained hash: flat parallel arrays plus a
# per-bucket singly-linked list of indices. All arrays are fields of a `class`
# (a REFERENCE) so pushes do not copy, and no nested arrays are used.
#
# The hash never calls char_code_at (quadratic on this runtime); it mixes the
# length with the ordinal of three characters looked up in a fixed alphabet,
# which is constant time per call.

val HASH_ALPHA: text = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_/.-"
val HASH_BUCKETS: i64 = 2048

fn hash_bucket(s: text) -> i64:
    var h: i64 = s.len() * 131
    if s.len() > 0:
        h = h + (index_of(HASH_ALPHA, s.substring(0, 1)) + 2) * 7
    if s.len() > 1:
        h = h + (index_of(HASH_ALPHA, s.substring(s.len() - 1, s.len())) + 2) * 1301
    if s.len() > 3:
        h = h + (index_of(HASH_ALPHA, s.substring(2, 3)) + 2) * 17
    var r = h % HASH_BUCKETS
    if r < 0:
        r = 0 - r
    r

class SMap:
    heads: [i64]
    keys: [text]
    vals: [text]
    nxt: [i64]

fn smap_new() -> SMap:
    var h: [i64] = []
    var i: i64 = 0
    while i < HASH_BUCKETS:
        h.push(-1)
        i = i + 1
    SMap(heads: h, keys: [], vals: [], nxt: [])

fn smap_find(m: SMap, k: text) -> i64:
    var e = m.heads[hash_bucket(k)]
    while e >= 0:
        if m.keys[e] == k:
            return e
        e = m.nxt[e]
    -1

fn smap_get(m: SMap, k: text) -> text:
    val e = smap_find(m, k)
    if e < 0:
        return ""
    m.vals[e]

fn smap_has(m: SMap, k: text) -> bool:
    smap_find(m, k) >= 0

fn smap_put(m: SMap, k: text, v: text) -> SMap:
    val e = smap_find(m, k)
    if e >= 0:
        m.vals[e] = v
        return m
    val b = hash_bucket(k)
    m.keys.push(k)
    m.vals.push(v)
    m.nxt.push(m.heads[b])
    m.heads[b] = m.keys.len() - 1
    m

fn smap_len(m: SMap) -> i64:
    m.keys.len()

# -------------------------------------------------------------- type-kind index
#
# Family 3 hinges entirely on struct-vs-class, so the kind is RESOLVED from
# declarations, never inferred from the name. A name declared BOTH ways
# anywhere in the corpus is marked ambiguous and never flagged.

fn decl_name_on(line: text, kw: text) -> text:
    if not line.starts_with(kw + " "):
        return ""
    var rest = line.substring(kw.len() + 1, line.len())
    var i: i64 = 0
    while i < rest.len() and is_ident_char(rest.substring(i, i + 1)):
        i = i + 1
    rest.substring(0, i)

fn kind_index_add(idx: SMap, name: text, kind: text) -> SMap:
    val prev = smap_get(idx, name)
    if prev == "":
        return smap_put(idx, name, kind)
    if prev != kind:
        return smap_put(idx, name, "ambiguous")
    idx

fn kind_of(idx: SMap, name: text) -> text:
    smap_get(idx, name)

fn index_source(idx: SMap, src: text) -> SMap:
    var acc = idx
    for raw in src.split("\n"):
        # A declaration is column-anchored, so a trailing comment cannot
        # change the name; skipping strip_comment here is what makes a
        # whole-corpus index affordable.
        if not (raw.starts_with("struct ") or raw.starts_with("class ")):
            continue
        val s = decl_name_on(raw, "struct")
        if s != "":
            acc = kind_index_add(acc, s, "struct")
            continue
        val c = decl_name_on(raw, "class")
        if c != "":
            acc = kind_index_add(acc, c, "class")
    acc

fn build_kind_index(roots: [text]) -> SMap:
    var idx = smap_new()
    for root in roots:
        if not dir_exists(root):
            continue
        for p in dir_walk(root):
            if should_scan_spl(p):
                idx = index_source(idx, file_read(p))
    idx

# ---------------------------------------------------------- family 3: scoring

struct Param:
    name: text
    type_: text
    is_mut: bool

fn base_type(t: text) -> text:
    var s = t.trim()
    var i: i64 = 0
    while i < s.len() and is_ident_char(s.substring(i, i + 1)):
        i = i + 1
    s.substring(0, i)

fn split_top_commas(s: text) -> [text]:
    var out: [text] = []
    var depth: i64 = 0
    var cur: text = ""
    var i: i64 = 0
    var q = ""
    while i < s.len():
        val c = s.substring(i, i + 1)
        if q != "":
            if c == q:
                q = ""
            cur = cur + c
            i = i + 1
            continue
        if c == "\"" or c == "'":
            q = c
            cur = cur + c
            i = i + 1
            continue
        if c == "(" or c == "[" or c == "<" or c == "{":
            depth = depth + 1
        if c == ")" or c == "]" or c == ">" or c == "}":
            depth = depth - 1
        if c == "," and depth == 0:
            out.push(cur)
            cur = ""
            i = i + 1
            continue
        cur = cur + c
        i = i + 1
    if cur.trim() != "":
        out.push(cur)
    out

fn parse_params(header: text) -> [Param]:
    val open = index_of(header, "(")
    if open < 0:
        return []
    var depth: i64 = 0
    var i = open
    var inner: text = ""
    while i < header.len():
        val c = header.substring(i, i + 1)
        if c == "(":
            depth = depth + 1
            if depth == 1:
                i = i + 1
                continue
        if c == ")":
            depth = depth - 1
            if depth == 0:
                break
        inner = inner + c
        i = i + 1
    var out: [Param] = []
    for piece in split_top_commas(inner):
        var p = piece.trim()
        if p == "" or p == "self":
            continue
        var is_mut = false
        if p.starts_with("mut "):
            is_mut = true
            p = p.substring(4, p.len()).trim()
        val colon = index_of(p, ":")
        if colon < 0:
            continue
        val nm = p.substring(0, colon).trim()
        val ty = base_type(p.substring(colon + 1, p.len()))
        if nm == "" or ty == "":
            continue
        out.push(Param(name: nm, type_: ty, is_mut: is_mut))
    out

# DEFECT 5 (fixed): `add` was treated as an unconditional in-place mutator, but
# `Vector.add` is a PURE combinator -- `return v.add(v)` produces a new value and
# is not a mutation of anything. `add` therefore stays in the list, but the
# discarded-result gate below is what makes it sound: a call whose result is
# consumed is never a claim of in-place mutation.
fn mutator_names() -> [text]:
    ["push", "pop", "insert", "remove", "set", "clear", "sort", "reverse",
     "extend", "append", "truncate", "resize", "fill", "push_str", "add",
     "delete", "put", "retain", "drain", "swap"]

# Does `line` mutate the receiver named `p`? Returns "" or a finding code.
#   VTM001 -- field / index assignment through the parameter
#   VTM002 -- a known in-place mutator method called through the parameter
#
# DEFECT 4 (fixed): the receiver occurrence must begin the STATEMENT. Everything
# to its left on the line must be blank. Two false-positive families die here:
#
#   * `dict[param.field] = v`  -- the assignment target is `dict`, not `param`;
#     `param.field` is a subscript READ. 19 of the 33 published hits (the
#     `make_module` / `make_hir_module` helper family, e.g.
#     `functions[func.symbol] = func`) were exactly this shape.
#   * `acc.push(param.name)` / `return param.add(param)` -- the parameter is an
#     ARGUMENT or the call's result is CONSUMED, so nothing is being mutated
#     in place through the parameter.
#
# The residual cost is that a mutation tucked into an inline `if c: p.x = 1`
# body is not reported. That is a deliberate under-report: the silent-no-op
# failure mode this census exists to find is a statement whose ONLY effect is
# the discarded mutation.
fn mutation_code(line: text, p: text) -> text:
    var i: i64 = 0
    while i >= 0:
        val at = index_from(line, p, i)
        if at < 0:
            return ""
        i = at + p.len()
        # word boundary on both sides
        if at > 0 and is_ident_char(line.substring(at - 1, at)):
            continue
        if i >= line.len():
            continue
        val nxt = line.substring(i, i + 1)
        if nxt != "." and nxt != "[":
            continue
        # STATEMENT-HEAD gate -- see the DEFECT 4 note above.
        if at > 0 and line.substring(0, at).trim() != "":
            continue
        # Walk the postfix chain after the receiver.
        var j = i
        var saw_call = false
        var last_method: text = ""
        var depth: i64 = 0
        while j < line.len():
            val c = line.substring(j, j + 1)
            if c == "(" or c == "[":
                depth = depth + 1
                j = j + 1
                continue
            if c == ")" or c == "]":
                depth = depth - 1
                if depth < 0:
                    break
                j = j + 1
                continue
            if depth > 0:
                j = j + 1
                continue
            if c == ".":
                var k = j + 1
                var nm: text = ""
                while k < line.len() and is_ident_char(line.substring(k, k + 1)):
                    nm = nm + line.substring(k, k + 1)
                    k = k + 1
                if k < line.len() and line.substring(k, k + 1) == "(":
                    saw_call = true
                    last_method = nm
                j = k
                continue
            if c == " ":
                j = j + 1
                continue
            # A compound assignment (`+=`, `-=`, `*=`, `/=`) mutates too.
            if c == "+" or c == "-" or c == "*" or c == "/":
                if j + 1 < line.len() and line.substring(j + 1, j + 2) == "=":
                    return "VTM001"
                break
            if c == "=":
                # An assignment TARGET, but not `==`, `!=`, `>=`, `<=`.
                if j + 1 < line.len() and line.substring(j + 1, j + 2) == "=":
                    break
                if j > 0:
                    val prev = line.substring(j - 1, j).trim()
                    if prev == "!" or prev == ">" or prev == "<" or prev == "+" or prev == "-":
                        if prev == "+" or prev == "-":
                            return "VTM001"
                        break
                return "VTM001"
            break
        if saw_call and list_has(mutator_names(), last_method):
            # The chain must be the WHOLE statement: a trailing `=`, `)` or
            # operator means the result is consumed, not discarded.
            val tail = line.substring(j, line.len()).trim()
            if tail == "":
                return "VTM002"
    ""

# ------------------------------------------------------------------- findings

struct Row:
    file: text
    code: text
    fn_name: text
    param: text
    type_: text
    line: i64
    dup: bool

fn fn_name_of(line: text) -> text:
    var rest = line.substring(3, line.len())
    var i: i64 = 0
    var nm: text = ""
    while i < rest.len() and is_ident_char(rest.substring(i, i + 1)):
        nm = nm + rest.substring(i, i + 1)
        i = i + 1
    nm

# Scores one file's SOURCE for family 3. Kept separate from file IO so the
# positive control exercises exactly the code the census runs.
fn check_value_helper_mutation(src: text, idx: SMap) -> [Row]:
    var rows: [Row] = []
    val lines = src.split("\n")
    var i: i64 = 0
    var in_triple = false
    while i < lines.len():
        val raw = lines[i]
        # Triple-quoted blocks contain arbitrary column-0 text; skip them so
        # a docstring can never be read as code.
        var tcount: i64 = 0
        var s2: i64 = 0
        while s2 + 3 <= raw.len():
            if raw.substring(s2, s2 + 3) == "\"\"\"":
                tcount = tcount + 1
                s2 = s2 + 3
                continue
            s2 = s2 + 1
        if tcount % 2 == 1:
            in_triple = not in_triple
            i = i + 1
            continue
        if in_triple:
            i = i + 1
            continue
        val line = strip_comment(raw)
        val ind = indent_of(line)
        val trimmed = line.trim()
        if not trimmed.starts_with("fn "):
            i = i + 1
            continue
        val fname = fn_name_of(trimmed)
        val params = parse_params(trimmed)
        # Only value-typed (struct) parameters that are not `mut` can be hit.
        var watched: [Param] = []
        for p in params:
            if p.is_mut:
                continue
            if kind_of(idx, p.type_) == "struct":
                watched.push(p)
        if watched.len() == 0:
            i = i + 1
            continue
        var j = i + 1
        var reported: [text] = []
        while j < lines.len():
            val braw = lines[j]
            if braw.trim() == "":
                j = j + 1
                continue
            if indent_of(braw) <= ind:
                break
            val b = strip_comment(braw).trim()
            for p in watched:
                if list_has(reported, p.name):
                    continue
                val code = mutation_code(b, p.name)
                if code != "":
                    reported.push(p.name)
                    rows.push(Row(file: "", code: code, fn_name: fname,
                                  param: p.name, type_: p.type_,
                                  line: j + 1, dup: false))
            j = j + 1
        i = j
    rows

# ---------------------------------------------------------- family 4: scoring

fn declared_types(src: text) -> [text]:
    var out: [text] = []
    for raw in src.split("\n"):
        if not (raw.starts_with("struct ") or raw.starts_with("class ") or raw.starts_with("enum ")):
            continue
        val s = decl_name_on(raw, "struct")
        if s != "" and not list_has(out, s):
            out.push(s)
        val c = decl_name_on(raw, "class")
        if c != "" and not list_has(out, c):
            out.push(c)
        val e = decl_name_on(raw, "enum")
        if e != "" and not list_has(out, e):
            out.push(e)
    out

fn imports_anything(src: text) -> bool:
    for raw in src.split("\n"):
        val line = strip_comment(raw).trim()
        if line.starts_with("use "):
            return true
    false

fn src_type_names(roots: [text]) -> SMap:
    var out = smap_new()
    for root in roots:
        if not dir_exists(root):
            continue
        for p in dir_walk(root):
            if not should_scan_spl(p):
                continue
            for t in declared_types(file_read(p)):
                out = smap_put(out, t, "1")
    out

# ------------------------------------------------- family 5: comment-cheat rules
#
# DEFECT 1 (fixed): a leading `*` is a block-comment CONTINUATION only in
# C-family files. In shell, `*)` opens a `case` arm -- executable dispatch, and
# frequently the exact behaviour the gate exists to prove. Treating shell case
# arms as comments falsely hollowed 16 sound gates
# (check-simpleos-wm-fullscreen-evidence.shs:802, macos-gui-run.shs:72,
#  check-widget-showcase-4k-200fps.shs:38, check-macos-gpu-2d-live-evidence.shs:10).
#
# DEFECT 2 (fixed): `#` in a C-family file is a PREPROCESSOR DIRECTIVE, not a
# comment. `#include "runtime_memtrack.h"` and `#define FORK_CAPTURE_LIMIT ...`
# are code (runtime_fork.c:50,74; runtime_thread.c:13; runtime_sdl3.c:30,33;
# freestanding_runtime.c:1657; runtime_simd_dispatch.c:657,871,939).

fn is_c_family(path: text) -> bool:
    path.ends_with(".c") or path.ends_with(".h") or path.ends_with(".cpp")
        or path.ends_with(".cc") or path.ends_with(".hpp") or path.ends_with(".cxx")
        or path.ends_with(".js") or path.ends_with(".ts") or path.ends_with(".ld")
        or path.ends_with(".rs") or path.ends_with(".java") or path.ends_with(".m")
        or path.ends_with(".mm") or path.ends_with(".css")

fn is_hash_comment_lang(path: text) -> bool:
    path.ends_with(".spl") or path.ends_with(".shs") or path.ends_with(".sh")
        or path.ends_with(".py") or path.ends_with(".sdn") or path.ends_with(".toml")
        or path.ends_with(".yml") or path.ends_with(".yaml") or path.ends_with(".cmake")
        or path.ends_with(".mk") or path.ends_with("Makefile") or path.ends_with(".bash")

# Is `line` (raw) a comment line in the language of `path`?
fn is_comment_line(path: text, line: text) -> bool:
    val t = line.trim()
    if t == "":
        return true
    if is_c_family(path):
        # `#` is a preprocessor directive here -- CODE. (DEFECT 2)
        if t.starts_with("//") or t.starts_with("/*"):
            return true
        if t.starts_with("*"):
            return true
        return false
    if is_hash_comment_lang(path):
        # `*` here is a shell `case` arm or a glob -- CODE. (DEFECT 1)
        return t.starts_with("#")
    # Unknown extension: accept the union of the two conservative markers, but
    # still never treat a bare `*` as a comment.
    t.starts_with("#") or t.starts_with("//") or t.starts_with("/*")

# Extract every double-quoted literal on a line.
fn string_literals(line: text) -> [text]:
    var out: [text] = []
    var i: i64 = 0
    var inq = false
    var cur: text = ""
    while i < line.len():
        val c = line.substring(i, i + 1)
        if c == "\\":
            if inq:
                cur = cur + c
            i = i + 2
            continue
        if c == "\"":
            if inq:
                out.push(cur)
                cur = ""
                inq = false
            else:
                inq = true
            i = i + 1
            continue
        if inq:
            cur = cur + c
        i = i + 1
    out

fn product_root_prefixes() -> [text]:
    ["src/", "scripts/", "tools/", "config/", "bin/", "doc/"]

fn looks_like_product_path(s: text) -> bool:
    if s.contains(" ") or s.len() < 5:
        return false
    if not s.contains("."):
        return false
    var ok = false
    for pre in product_root_prefixes():
        if s.starts_with(pre):
            ok = true
    if not ok:
        return false
    # must have a file extension after the last slash
    var last: i64 = -1
    var i: i64 = 0
    while i < s.len():
        if s.substring(i, i + 1) == "/":
            last = i
        i = i + 1
    s.substring(last + 1, s.len()).contains(".")

# A spec line that asserts ABSENCE cannot be comment-cheated: the needle is
# claimed NOT to be there. Same for a negated matcher.
fn is_negative_assertion(line: text) -> bool:
    line.contains("to_not") or line.contains("not_to") or line.contains("never")
        or line.contains("assert_false") or line.contains("not ")
        or line.contains("to_equal(false)") or line.contains("== false")

# Does this spec actually read product SOURCE TEXT? If it does not, its needles
# are asserted against RETURN VALUES or runtime output and can never be
# comment-cheats (bug D-S3: 5 of 18 surviving rows were exactly this).
fn reads_source_text(src: text) -> bool:
    src.contains("file_read") or src.contains("read_file")
        or src.contains("read_to_string") or src.contains("read_text")

# Every product path the spec references -- NOT just the nearest preceding one.
# DEFECT 3 (fixed): nearest-preceding-path pairing mis-attributed 12 of 18
# surviving rows to a file the spec never reads. A needle is now classified
# against the UNION of all product files the spec references, so a hollow
# verdict requires the needle to be comment-only in EVERY candidate.
fn spec_product_paths(src: text) -> [text]:
    var out: [text] = []
    for raw in src.split("\n"):
        if not raw.contains("\""):
            continue
        for lit in string_literals(raw):
            if looks_like_product_path(lit) and not list_has(out, lit):
                out.push(lit)
    out

struct Needle:
    text_: text
    line: i64

fn spec_needles(src: text, paths: [text]) -> [Needle]:
    var out: [Needle] = []
    var seen: [text] = []
    val lines = src.split("\n")
    var i: i64 = 0
    while i < lines.len():
        val raw = lines[i]
        i = i + 1
        if not (raw.contains("to_contain(\"") or raw.contains(".contains(\"")):
            continue
        if is_negative_assertion(raw):
            continue
        for lit in string_literals(raw):
            if lit.len() < 4:
                continue
            # A path ARGUMENT is not an assertion needle. (bug: path arguments)
            if looks_like_product_path(lit) or list_has(paths, lit):
                continue
            if list_has(seen, lit):
                continue
            seen.push(lit)
            out.push(Needle(text_: lit, line: i))
    out

# "code" | "comment" | "absent"
fn classify_needle(needle: text, paths: [text], cache: SMap) -> text:
    var found_comment = false
    for p in paths:
        if not smap_has(cache, p):
            continue
        val content = smap_get(cache, p)
        if not content.contains(needle):
            continue
        for line in content.split("\n"):
            if not line.contains(needle):
                continue
            if is_comment_line(p, line):
                found_comment = true
            else:
                return "code"
    if found_comment:
        return "comment"
    "absent"

fn load_paths(cache: SMap, paths: [text]) -> SMap:
    var acc = cache
    for p in paths:
        if smap_has(acc, p):
            continue
        if not file_exists(p):
            continue
        acc = smap_put(acc, p, file_read(p))
    acc

# ------------------------------------------------------------- positive control
#
# Written as in-memory source strings so a deliberately-broken .spl can never
# be picked up by lint, the test runner or any other repo sweep.
#
# The SILENT half is not decoration: a scorer that flagged every helper would
# look identical to a working one without it. Every false-positive family named
# in the bug record has a planted case here that MUST stay silent.

fn control_index() -> SMap:
    var idx = smap_new()
    idx = kind_index_add(idx, "CtrlStruct", "struct")
    idx = kind_index_add(idx, "CtrlClass", "class")
    idx = kind_index_add(idx, "MirFunction", "struct")
    idx = kind_index_add(idx, "Vec4f", "struct")
    idx

fn control_source() -> text:
    var s: text = ""
    # --- MUST FIRE
    s = s + "fn ctrl_field_assign(t: CtrlStruct, k: text):\n"
    s = s + "    t.count = 1\n"
    s = s + "\n"
    s = s + "fn ctrl_nested_push(t: CtrlStruct, k: text):\n"
    s = s + "    t.root.keys.push(k)\n"
    s = s + "\n"
    s = s + "fn ctrl_index_assign(t: CtrlStruct, i: i64):\n"
    s = s + "    t.cells[i] = 3\n"
    s = s + "\n"
    s = s + "fn ctrl_remove(t: CtrlStruct, k: text):\n"
    s = s + "    t.keys.remove(k)\n"
    s = s + "\n"
    s = s + "fn ctrl_plus_eq(t: CtrlStruct):\n"
    s = s + "    t.count += 1\n"
    s = s + "\n"
    # --- MUST STAY SILENT
    # A class receiver is a REFERENCE: mutation writes back and is correct.
    s = s + "fn ctrl_ok_class(t: CtrlClass, k: text):\n"
    s = s + "    t.root.keys.push(k)\n"
    s = s + "\n"
    # `mut` writes back to the caller and is correct.
    s = s + "fn ctrl_ok_mut(mut t: CtrlStruct, k: text):\n"
    s = s + "    t.root.keys.push(k)\n"
    s = s + "\n"
    # Read-only use of a struct parameter is correct.
    s = s + "fn ctrl_ok_read(t: CtrlStruct) -> i64:\n"
    s = s + "    t.count + t.other.len()\n"
    s = s + "\n"
    # A comparison is not an assignment.
    s = s + "fn ctrl_ok_compare(t: CtrlStruct) -> bool:\n"
    s = s + "    t.count == 1\n"
    s = s + "\n"
    # A non-mutating method call is correct.
    s = s + "fn ctrl_ok_query(t: CtrlStruct, k: text) -> bool:\n"
    s = s + "    t.keys.contains(k)\n"
    s = s + "\n"
    # An unknown / unindexed type must not be guessed at.
    s = s + "fn ctrl_ok_unknown(t: MysteryType, k: text):\n"
    s = s + "    t.keys.push(k)\n"
    s = s + "\n"
    # A LOCAL of the same base name is a different thing.
    s = s + "fn ctrl_ok_prefix(t: CtrlStruct, k: text) -> i64:\n"
    s = s + "    val total = t.count\n"
    s = s + "    total\n"
    s = s + "\n"
    # Mutating a DIFFERENT local, not the parameter.
    s = s + "fn ctrl_ok_other(t: CtrlStruct, k: text) -> [text]:\n"
    s = s + "    var acc: [text] = []\n"
    s = s + "    acc.push(t.name)\n"
    s = s + "    acc\n"
    s = s + "\n"
    # DEFECT 4 -- `dict[param.field] = v` assigns to `dict`, not to `func`.
    # This is the `make_module` helper family: 19 of 33 published hits.
    s = s + "fn ctrl_ok_dict_index_by_field(func: MirFunction) -> i64:\n"
    s = s + "    var functions: Dict<SymbolId, MirFunction> = {}\n"
    s = s + "    functions[func.symbol] = func\n"
    s = s + "    functions.len()\n"
    s = s + "\n"
    # DEFECT 5 -- `add` is a PURE combinator here; the result is returned.
    s = s + "fn ctrl_ok_returned_add(v: Vec4f) -> Vec4f:\n"
    s = s + "    return v.add(v)\n"
    s = s + "\n"
    # Same shape without `return`, still consumed.
    s = s + "fn ctrl_ok_bound_add(v: Vec4f) -> Vec4f:\n"
    s = s + "    val doubled = v.add(v)\n"
    s = s + "    doubled\n"
    s

fn control_names() -> [text]:
    ["ctrl_field_assign", "ctrl_nested_push", "ctrl_index_assign",
     "ctrl_remove", "ctrl_plus_eq",
     "ctrl_ok_class", "ctrl_ok_mut", "ctrl_ok_read", "ctrl_ok_compare",
     "ctrl_ok_query", "ctrl_ok_unknown", "ctrl_ok_prefix", "ctrl_ok_other",
     "ctrl_ok_dict_index_by_field", "ctrl_ok_returned_add", "ctrl_ok_bound_add"]

fn control_must_fire(name: text) -> bool:
    not name.starts_with("ctrl_ok_")

# Family 5 control: in-memory "product files" with the exact shapes the bug
# record proved were misclassified.
fn control_cache() -> SMap:
    var c = smap_new()
    # A SHELL case arm -- leading `*` is CODE here. (DEFECT 1)
    c = smap_put(c, "scripts/ctrl_case_arm.shs",
        "case \"$mode\" in\n  bootstrap*seed) echo seed ;;\n  *rust-built*|*rust*seed*) echo rustbuilt ;;\nesac\n")
    # A C preprocessor directive -- `#` is CODE here. (DEFECT 2)
    c = smap_put(c, "src/runtime/ctrl_preproc.c",
        "// header\n#include \"runtime_memtrack.h\"\n#define FORK_CAPTURE_LIMIT 64\n")
    # DEFECT 3 -- the needle is real CODE, but in the SECOND path the spec
    # references, not the nearest preceding one.
    c = smap_put(c, "src/ctrl_decoy.spl", "# ctrl_paired_needle appears here only in a comment\nfn other():\n    0\n")
    c = smap_put(c, "src/ctrl_real.spl", "fn ctrl_paired_needle() -> i64:\n    1\n")
    # A genuinely hollow file: the needle exists ONLY in a comment.
    c = smap_put(c, "src/ctrl_hollow.spl", "# TODO: ctrl_hollow_needle is not implemented yet\nfn nothing():\n    0\n")
    # A C-family block comment continuation -- `*` IS a comment here.
    c = smap_put(c, "src/runtime/ctrl_block.c", "/*\n * ctrl_block_needle is only documented\n */\nint x = 1;\n")
    c

struct HollowCase:
    label: text
    needle: text
    paths: [text]
    want: text

fn control_hollow_cases() -> [HollowCase]:
    var out: [HollowCase] = []
    # MUST BE SILENT (classified as code)
    out.push(HollowCase(label: "shell_case_arm", needle: "rust-built",
                        paths: ["scripts/ctrl_case_arm.shs"], want: "code"))
    out.push(HollowCase(label: "c_preprocessor", needle: "runtime_memtrack.h",
                        paths: ["src/runtime/ctrl_preproc.c"], want: "code"))
    out.push(HollowCase(label: "c_define", needle: "FORK_CAPTURE_LIMIT",
                        paths: ["src/runtime/ctrl_preproc.c"], want: "code"))
    out.push(HollowCase(label: "mispaired_path", needle: "ctrl_paired_needle",
                        paths: ["src/ctrl_decoy.spl", "src/ctrl_real.spl"], want: "code"))
    # MUST FIRE
    out.push(HollowCase(label: "genuine_hollow", needle: "ctrl_hollow_needle",
                        paths: ["src/ctrl_hollow.spl"], want: "comment"))
    out.push(HollowCase(label: "c_block_continuation", needle: "ctrl_block_needle",
                        paths: ["src/runtime/ctrl_block.c"], want: "comment"))
    out

fn control_spec_source() -> text:
    var s: text = ""
    s = s + "use std.nogc_sync_mut.io_runtime.{file_read}\n"
    s = s + "describe \"ctrl\":\n"
    s = s + "    it \"reads\":\n"
    s = s + "        val a = file_read(\"src/ctrl_decoy.spl\")\n"
    s = s + "        val b = file_read(\"src/ctrl_real.spl\")\n"
    s = s + "        expect(b).to_contain(\"ctrl_paired_needle\")\n"
    s = s + "        expect(a).to_not_contain(\"ctrl_absent_needle\")\n"
    s

fn run_control() -> bool:
    var ok = true
    var fired: [text] = []
    var codes: [text] = []
    for r in check_value_helper_mutation(control_source(), control_index()):
        if not list_has(fired, r.fn_name):
            fired.push(r.fn_name)
        codes.push(r.fn_name + "=" + r.code)
    for want in control_names():
        val hit = list_has(fired, want)
        val need = control_must_fire(want)
        if hit != need:
            ok = false
            print("  control MISMATCH {want}: detected={hit} expected={need}")
    if not list_has(codes, "ctrl_field_assign=VTM001"):
        ok = false
        print("  control MISMATCH ctrl_field_assign did not land in VTM001")
    if not list_has(codes, "ctrl_remove=VTM002"):
        ok = false
        print("  control MISMATCH ctrl_remove did not land in VTM002")

    # Family 4 control.
    val spec_src = "struct LeaseManager:\n    n: i64\n\nstruct SpecOnlyThing:\n    n: i64\n"
    val known = ["LeaseManager", "RequestQueue"]
    var shadow: [text] = []
    for t in declared_types(spec_src):
        if list_has(known, t):
            shadow.push(t)
    if not list_has(shadow, "LeaseManager"):
        ok = false
        print("  control MISMATCH SHADOW did not detect the LeaseManager collision")
    if list_has(shadow, "SpecOnlyThing"):
        ok = false
        print("  control MISMATCH SHADOW fired on a spec-only type")

    # Family 5 control -- one planted case per named false-positive pattern.
    val cache = control_cache()
    for hc in control_hollow_cases():
        val got = classify_needle(hc.needle, hc.paths, cache)
        if got != hc.want:
            ok = false
            print("  control MISMATCH hollow/{hc.label}: got={got} expected={hc.want}")
    # Path pairing must see BOTH referenced paths, not just the nearest.
    val cpaths = spec_product_paths(control_spec_source())
    if not (list_has(cpaths, "src/ctrl_decoy.spl") and list_has(cpaths, "src/ctrl_real.spl")):
        ok = false
        print("  control MISMATCH hollow/path_union: did not collect both referenced paths")
    # A negative assertion must not become a needle.
    var cneedles: [text] = []
    for n in spec_needles(control_spec_source(), cpaths):
        cneedles.push(n.text_)
    if list_has(cneedles, "ctrl_absent_needle"):
        ok = false
        print("  control MISMATCH hollow/negative_assertion: absence assertion became a needle")
    if not list_has(cneedles, "ctrl_paired_needle"):
        ok = false
        print("  control MISMATCH hollow/positive_needle: real needle was not collected")

    # Hash index control: a name declared both ways is ambiguous, never flagged.
    var ki = smap_new()
    ki = kind_index_add(ki, "Dual", "struct")
    ki = kind_index_add(ki, "Dual", "class")
    if kind_of(ki, "Dual") != "ambiguous":
        ok = false
        print("  control MISMATCH kind index did not mark a dual declaration ambiguous")

    if ok:
        print("control: 5 planted VTM violations detected, 11 correct forms silent")
        print("control: SHADOW fires on a colliding name, silent on a spec-only name")
        print("control: HOLLOW fires on 2 planted comment-only needles, silent on")
        print("         shell case arm, C preprocessor, C define, mispaired path,")
        print("         negative assertion")
    ok

# ------------------------------------------------------------------------ scan
#
# DEDUP -- DEFECT (fixed): `is_duplicate_tree` was a bare PREFIX test, so every
# file under test/01_unit/ etc. was dropped from the "deduped" column whether or
# not a twin existed. The numbered trees are SUPERSETS: 5,731 files have no twin
# at all, and 888 paired files genuinely DIVERGE in content -- two different
# tests, not one counted twice. A file is now a duplicate only when its twin
# EXISTS and its content is IDENTICAL.

fn twin_path(p: text) -> text:
    if p.starts_with("test/01_unit/"):
        return "test/unit/" + p.substring(13, p.len())
    if p.starts_with("test/02_integration/"):
        return "test/integration/" + p.substring(20, p.len())
    if p.starts_with("test/03_system/"):
        return "test/system/" + p.substring(15, p.len())
    if p.starts_with("test/04_external/"):
        return "test/external/" + p.substring(17, p.len())
    if p.starts_with("test/05_perf/"):
        return "test/perf/" + p.substring(13, p.len())
    ""

fn total(rows: [Row], deduped: bool) -> i64:
    var n: i64 = 0
    for r in rows:
        if deduped and r.dup:
            continue
        n = n + 1
    n

fn count_code(rows: [Row], code: text, deduped: bool) -> i64:
    var n: i64 = 0
    for r in rows:
        if deduped and r.dup:
            continue
        if r.code == code:
            n = n + 1
    n

fn main():
    val argv = get_args()
    var roots: [text] = []
    var selftest = false
    var listing = false
    var i: i64 = 0
    while i < argv.len():
        val a = argv[i]
        if a == "--selftest":
            selftest = true
            i = i + 1
            continue
        if a == "--list":
            listing = true
            i = i + 1
            continue
        if a.starts_with("--") or a.ends_with("/simple") or a == "run" or a.ends_with(".spl"):
            i = i + 1
            continue
        roots.push(a)
        i = i + 1

    if not run_control():
        print("ERROR -- positive control did not reproduce; scan not attempted")
        exit(2)
        return
    if selftest:
        print("REPORT -- positive control reproduced")
        return

    if roots.len() == 0:
        roots.push("test")

    var index_roots: [text] = ["src"]
    for r in roots:
        index_roots.push(r)
    val idx = build_kind_index(index_roots)
    val src_types = src_type_names(["src"])

    var rows: [Row] = []
    var shadow_files: [text] = []
    var shadow_names: [text] = []
    var shadow_dup: i64 = 0
    var shadow_raw: i64 = 0
    var nosrc_raw: i64 = 0
    var nosrc_dedup: i64 = 0
    var nspec: i64 = 0
    var ndup: i64 = 0
    var nunpaired: i64 = 0
    var ndiverged: i64 = 0
    var hollow_rows: [text] = []
    var hollow_raw: i64 = 0
    var hollow_dedup: i64 = 0
    var needles_code: i64 = 0
    var needles_absent: i64 = 0
    var cache = smap_new()

    for root in roots:
        if not dir_exists(root):
            continue
        for p in dir_walk(root):
            if not should_scan_spl(p) or not is_spec_file(p):
                continue
            nspec = nspec + 1
            val rel = norm_path(p)
            val src = file_read(p)

            # --- dedup: pair existence AND content identity
            var dup = false
            val twin = twin_path(rel)
            if twin != "":
                if not file_exists(twin):
                    nunpaired = nunpaired + 1
                else:
                    if file_read(twin) == src:
                        dup = true
                        ndup = ndup + 1
                    else:
                        ndiverged = ndiverged + 1

            for r in check_value_helper_mutation(src, idx):
                rows.push(Row(file: rel, code: r.code, fn_name: r.fn_name,
                              param: r.param, type_: r.type_, line: r.line,
                              dup: dup))
            var hit = false
            for t in declared_types(src):
                if smap_has(src_types, t):
                    hit = true
                    if not list_has(shadow_names, t):
                        shadow_names.push(t)
            if hit:
                shadow_raw = shadow_raw + 1
                if dup:
                    shadow_dup = shadow_dup + 1
                else:
                    shadow_files.push(rel)
            if not imports_anything(src):
                nosrc_raw = nosrc_raw + 1
                if not dup:
                    nosrc_dedup = nosrc_dedup + 1

            # --- family 5
            if reads_source_text(src):
                val paths = spec_product_paths(src)
                if paths.len() > 0:
                    cache = load_paths(cache, paths)
                    for n in spec_needles(src, paths):
                        val verdict = classify_needle(n.text_, paths, cache)
                        if verdict == "code":
                            needles_code = needles_code + 1
                            continue
                        if verdict == "absent":
                            needles_absent = needles_absent + 1
                            continue
                        hollow_raw = hollow_raw + 1
                        if not dup:
                            hollow_dedup = hollow_dedup + 1
                            hollow_rows.push("HOLLOW {rel}:{n.line} needle=\"{n.text_}\"")

    print("=== spec vacuity census: value-type helpers, self-reimplementation, comment cheats ===")
    print("spec files scanned            : {nspec}")
    print("struct/class names indexed    : {smap_len(idx)}")
    print("dedup: true duplicates        : {ndup}")
    print("dedup: numbered-tree files with NO twin  : {nunpaired}")
    print("dedup: paired but CONTENT-DIVERGENT      : {ndiverged}   [counted, not deduped]")
    print("")
    print("--- family 3: value-type helper mutates a copy (deduped / raw) ---")
    print("VTM001 field/index assign via struct param : {count_code(rows, \"VTM001\", true)} / {count_code(rows, \"VTM001\", false)}")
    print("VTM002 in-place mutator via struct param   : {count_code(rows, \"VTM002\", true)} / {count_code(rows, \"VTM002\", false)}")
    print("total                                      : {total(rows, true)} / {total(rows, false)}")
    print("")
    print("--- family 4: spec re-implements the code under test ---")
    print("SHADOW spec files declaring a src/ type name : {shadow_files.len()} / {shadow_raw}")
    print("distinct shadowed type names                 : {shadow_names.len()}")
    print("NOSRC  spec files importing nothing at all   : {nosrc_dedup} / {nosrc_raw}   [LOW PRECISION -- triage signal only]")
    print("")
    print("--- family 5: comment-cheat / hollow source assertion ---")
    print("HOLLOW needles comment-only in every referenced file : {hollow_dedup} / {hollow_raw}")
    print("needles located as real CODE                         : {needles_code}")
    print("needles not located in any referenced file           : {needles_absent}   [heuristic residue, not a finding]")
    print("product files read into the cache                    : {smap_len(cache)}")

    if listing:
        print("")
        print("--- family 3 findings ---")
        for r in rows:
            var tag = ""
            if r.dup:
                tag = "  [dup-tree]"
            print("  {r.code} {r.file}:{r.line} fn {r.fn_name}({r.param}: {r.type_}){tag}")
        print("")
        print("--- family 4 SHADOW files (deduped) ---")
        for f in shadow_files:
            print("  SHADOW {f}")
        print("")
        print("--- shadowed type names ---")
        for n in shadow_names:
            print("  {n}")
        print("")
        print("--- family 5 HOLLOW findings (deduped) ---")
        for h in hollow_rows:
            print("  {h}")

    if nspec == 0:
        print("ERROR -- nothing was scanned")
        exit(2)
        return
    print("REPORT -- {nspec} file(s) scanned, {total(rows, true)} deduped VTM finding(s), {total(rows, false)} raw; {shadow_files.len()} deduped SHADOW file(s); {hollow_dedup} deduped HOLLOW needle(s)")
