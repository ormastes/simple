#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
output=${1:-build/check/kernel-phase7/runtime-bootstrap}
receipt=${2:-build/check/kernel-phase7/runtime.env}
capture=${3:-phase7-runtime.env}
tmp=${capture}.tmp.$$
trap 'rm -f "$tmp"' EXIT HUP INT TERM

set +e
sh "$root/scripts/check/prepare-kernel-phase7-runtime.shs" \
  "$output" "$receipt" >"$tmp"
rc=$?
set -e
tee "$capture" <"$tmp"
[ "$rc" -eq 0 ] || exit "$rc"
cat "$capture" >>"${GITHUB_ENV:?GITHUB_ENV is required}"
