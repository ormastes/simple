#!/bin/sh
# LINK lane Phase-1 parity gate (re-scoped oracle, 2026-07-31).
#
# The in-repo SMF writer/reader are unimplemented scaffolding (see
# doc/08_tracking/bug/smf_reader_writer_externs_unimplemented_2026-07-31.md),
# so "byte-identical SMF output" has no oracle. Phase-1 acceptance instead
# gates on the verified deterministic link route: two independent
# native-build runs of the same entry must produce byte-identical binaries.
# Route and rationale: .spipe/link_manager/smf_linker_map.md §5.
#
# Exit 0 = parity holds. Exit 1 = build failed or outputs differ.

set -eu

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
ENTRY="${1:-examples/01_getting_started/hello_native.spl}"
SIMPLE="${SIMPLE_BIN:-$ROOT/bin/simple}"
TMP="${TMPDIR:-/tmp}/link_parity_$$"
mkdir -p "$TMP"
trap 'rm -rf "$TMP"' EXIT

for i in 1 2; do
    "$SIMPLE" native-build --entry "$ROOT/$ENTRY" -o "$TMP/out$i" \
        --entry-closure --runtime-bundle auto >"$TMP/build$i.log" 2>&1 || {
        echo "FAIL: native-build run $i failed (log: $TMP/build$i.log)" >&2
        tail -5 "$TMP/build$i.log" >&2
        trap - EXIT
        exit 1
    }
done

H1=$(sha256sum "$TMP/out1" | cut -d' ' -f1)
H2=$(sha256sum "$TMP/out2" | cut -d' ' -f1)
if [ "$H1" = "$H2" ]; then
    echo "OK: link parity holds for $ENTRY (sha256 $H1)"
else
    echo "FAIL: non-deterministic link output for $ENTRY ($H1 vs $H2)" >&2
    exit 1
fi
