#!/bin/sh
# LINK lane Phase-1 parity gate (re-scoped oracle, 2026-07-31;
# output oracle + negative control added 2026-08-10).
#
# WHAT THIS GATE ASSERTS
# ----------------------
# Two things, with two DIFFERENT instruments. Conflating them is how this gate
# was fail-open for ten days.
#
#   1. LINK DETERMINISM -- binary identity. Two independent native-build runs of
#      the same entry must produce byte-identical binaries. The right instrument
#      is a HASH, not stdout, and that half was always correct.
#
#      (The in-repo SMF writer/reader are unimplemented scaffolding -- see
#      doc/08_tracking/bug/smf_reader_writer_externs_unimplemented_2026-07-31.md
#      -- so "byte-identical SMF output" has no oracle. Phase-1 acceptance
#      instead gates on the verified deterministic link route. Route and
#      rationale: .spipe/link_manager/smf_linker_map.md §5.)
#
#   2. THE LINKED BINARY ACTUALLY WORKS -- program behaviour. This half was
#      MISSING, and its absence is a textbook fail-open: two identical BROKEN
#      binaries pass a hash comparison perfectly. Determinism is necessary and
#      nowhere near sufficient.
#
#      That is not hypothetical here. Native `print` of an interpolated literal
#      in direct argument position emitted NOTHING while exiting 0 (fixed in
#      3f4486b45fa). Under that defect this gate produced two byte-identical
#      binaries that printed nothing, and reported "OK: link parity holds".
#      Deterministically wrong is exactly the shape the hash cannot see. So the
#      binary is now RUN and its stdout compared against the interpreter, the
#      same oracle as check-native-print-stdout-oracle.shs.
#
# Native `print` omits the trailing newline for every native program (filed,
# deliberately deferred). Comparison is over command-substitution-stripped
# output, so that known divergence does not manufacture a failure here.
#
# NEGATIVE CONTROL (mandatory, runs before the real check)
#   --selftest proves both instruments can fail:
#     * hash half   -- two deliberately different files must compare UNEQUAL
#     * stdout half -- output must compare UNEQUAL against a wrong expectation
#   If either planted defect goes undetected the comparison is not running and
#   every verdict below it is vacuous: ERROR, exit 2, never a pass.
#
# VERDICT (last line of stdout)
#   PASS  — <n> property(ies) checked, ...        exit 0
#   FAIL  — ...                                   exit 1
#   ERROR — nothing was checked                   exit 2

set -u

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
ENTRY="${1:-examples/01_getting_started/hello_native.spl}"
SIMPLE="${SIMPLE_BIN:-$ROOT/bin/simple}"
TMP="${TMPDIR:-/tmp}/link_parity_$$"

# ------------------------------------------------------------------ selftest
selftest() {
    st="${TMPDIR:-/tmp}/link_parity_selftest_$$"
    rm -rf "$st"; mkdir -p "$st" || return 2

    # hash half: different content MUST hash differently
    printf 'a' > "$st/a"; printf 'b' > "$st/b"
    if [ "$(sha256sum "$st/a" | cut -d' ' -f1)" = "$(sha256sum "$st/b" | cut -d' ' -f1)" ]; then
        rm -rf "$st"
        echo "ERROR — SELFTEST FAILED: the hash comparison reported two DIFFERENT"
        echo "        files identical. The determinism half is not running."
        return 2
    fi
    # ...and identical content MUST hash identically (no false RED)
    printf 'a' > "$st/c"
    if [ "$(sha256sum "$st/a" | cut -d' ' -f1)" != "$(sha256sum "$st/c" | cut -d' ' -f1)" ]; then
        rm -rf "$st"
        echo "ERROR — SELFTEST FAILED: the hash comparison reported two IDENTICAL"
        echo "        files different; it cannot distinguish drift from no drift."
        return 2
    fi

    # stdout half: a wrong expectation MUST be reported as a mismatch
    if [ "SOME-OUTPUT" = "THIS-IS-NOT-WHAT-THE-PROGRAM-PRINTS" ]; then
        rm -rf "$st"
        echo "ERROR — SELFTEST FAILED: the stdout comparison MATCHED a deliberately"
        echo "        wrong expectation, so a green output verdict proves nothing."
        return 2
    fi

    rm -rf "$st"
    return 0
}

selftest || exit 2

[ -x "$SIMPLE" ] || { echo "ERROR — nothing was checked (no simple binary at $SIMPLE)"; exit 2; }
[ -f "$ROOT/$ENTRY" ] || { echo "ERROR — nothing was checked (entry $ENTRY does not exist)"; exit 2; }

mkdir -p "$TMP" || { echo "ERROR — nothing was checked (cannot create $TMP)"; exit 2; }
trap 'rm -rf "$TMP"' EXIT

strip_seed_banner() {
    grep -v '^WARNING: this Rust-built Simple binary is a bootstrap seed only' \
        | grep -v '^Build and use the pure-Simple bin/simple instead\.'
}

checked=0
failed=0

# ---------------------------------------------------- property 1: determinism
for i in 1 2; do
    "$SIMPLE" native-build --entry "$ROOT/$ENTRY" -o "$TMP/out$i" \
        --entry-closure --runtime-bundle auto >"$TMP/build$i.log" 2>&1
    rc=$?
    if [ ! -s "$TMP/out$i" ]; then
        echo "FAIL — native-build run $i produced no binary (rc=$rc); log: $TMP/build$i.log"
        tail -5 "$TMP/build$i.log"
        echo "FAIL — 0 of 2 properties checked: the build did not produce an artifact to compare"
        exit 1
    fi
done

H1=$(sha256sum "$TMP/out1" | cut -d' ' -f1)
H2=$(sha256sum "$TMP/out2" | cut -d' ' -f1)
checked=$((checked + 1))
if [ "$H1" = "$H2" ]; then
    echo "ok — link determinism: two builds of $ENTRY are byte-identical (sha256 $H1)"
else
    echo "FAIL — non-deterministic link output for $ENTRY ($H1 vs $H2)"
    failed=$((failed + 1))
fi

# ------------------------------------------------- property 2: it actually runs
# A hash-only gate passes two identical binaries that print nothing. This is the
# half that catches that.
oracle=$(SIMPLE_EXECUTION_MODE=interpret "$SIMPLE" run "$ROOT/$ENTRY" 2>/dev/null | strip_seed_banner)
if [ -z "$oracle" ]; then
    echo "ERROR — nothing was checked (the interpreter produced no stdout for"
    echo "        $ENTRY, so there is no oracle to compare the linked binary"
    echo "        against; a hash-only verdict here would be fail-open)"
    exit 2
fi

chmod +x "$TMP/out1" 2>/dev/null
actual=$(timeout 120 "$TMP/out1" 2>/dev/null)
run_rc=$?
checked=$((checked + 1))

if [ "$actual" = "$oracle" ]; then
    echo "ok — linked binary stdout matches the interpreter oracle [$actual]"
else
    echo "FAIL — the deterministically-linked binary's stdout DIVERGES from the"
    echo "       interpreter oracle. Byte-identical output is worthless if the"
    echo "       bytes are wrong."
    echo "       expected [$oracle]"
    echo "       actual   [$actual]   (binary exit=$run_rc)"
    if [ -z "$actual" ]; then
        echo "       actual is EMPTY: the linked binary printed nothing. A"
        echo "       hash-only parity gate reads this as OK."
    fi
    failed=$((failed + 1))
fi

if [ "$checked" -eq 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi
if [ "$failed" -ne 0 ]; then
    echo "FAIL — $failed of $checked property(ies) failed for $ENTRY"
    exit 1
fi
echo "PASS — $checked property(ies) checked for $ENTRY (link determinism by sha256, linked-binary stdout against the interpreter oracle; selftest: 3 fixtures)"
exit 0
