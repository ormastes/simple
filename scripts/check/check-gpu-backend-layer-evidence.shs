#!/bin/sh
# Artifact-first GPU backend evidence.  Runtime/device admission is deliberately
# a separate stage: an unavailable host, tool, or device is never reported PASS.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
PORTABLE_CHECK="${GPU_BACKEND_LAYER_PORTABLE_CHECK:-$ROOT_DIR/scripts/check/check-portable-compute-toolchains.shs}"
BUILD_DIR="${GPU_BACKEND_LAYER_BUILD_DIR:-$ROOT_DIR/build/gpu-backend-layer}"
TARGETS="${GPU_BACKEND_LAYER_TARGETS:-cuda,vulkan,metal,hip,opencl}"
RUN_RUNTIME=false
SELF_TEST=false
MATRIX_SELF_TEST=false

while [ "$#" -gt 0 ]; do
    case "$1" in
        --targets) TARGETS="$2"; shift 2 ;;
        --runtime) RUN_RUNTIME=true; shift ;;
        --self-test) SELF_TEST=true; shift ;;
        --matrix-self-test) MATRIX_SELF_TEST=true; shift ;;
        *) echo "unknown argument: $1" >&2; exit 64 ;;
    esac
done

validate_targets() {
    case "$TARGETS" in
        ''|,*|*,|*,,*)
            echo "invalid backend target list: $TARGETS" >&2
            exit 64
            ;;
    esac
    invalid_targets="$(printf '%s\n' "$TARGETS" | tr ',' '\n' | grep -Ev '^(cuda|vulkan|metal|hip|opencl)$' || true)"
    if [ -n "$invalid_targets" ]; then
        echo "unknown backend target: $(printf '%s\n' "$invalid_targets" | head -n 1)" >&2
        exit 64
    fi
    duplicate_targets="$(printf '%s\n' "$TARGETS" | tr ',' '\n' | sort | uniq -d | head -n 1)"
    if [ -n "$duplicate_targets" ]; then
        echo "duplicate backend target: $duplicate_targets" >&2
        exit 64
    fi
}

validate_targets

field_of() {
    key="$1" file="$2"
    sed -n "s/^${key}=//p" "$file" | tail -n 1
}

has_target() {
    case ",$TARGETS," in *,"$1",*) return 0 ;; *) return 1 ;; esac
}

layer_result() {
    layer_backend="$1" layer_stage="$2" layer_status="$3"
    layer_reason="$4" layer_probe="$5"
    printf '%s_%s_result=%s\n' "$layer_backend" "$layer_stage" "$layer_status"
    printf '%s_%s_reason=%s\n' "$layer_backend" "$layer_stage" "$layer_reason"
    printf '%s_%s_probe=%s\n' "$layer_backend" "$layer_stage" "$layer_probe"
}

classify_artifact() {
    backend="$1" status="$2" reason="$3" artifact="$4"
    case "$reason" in
        missing-primary-tool|missing-validator-tool|missing-validator-provenance|\
        missing-compiler-provenance|missing-metallib-tool|missing-cuda-arch|\
        glslang-diagnostic-only-missing-clean-loader-provenance)
            layer_result "$backend" validate SKIP_UNAVAILABLE "$reason" "$artifact"
            layer_result "$backend" link SKIP_UNAVAILABLE validation-unavailable "$artifact"
            return
            ;;
    esac
    case "$status" in
        compiled_artifact_verified)
            if [ -s "$artifact" ]; then
                layer_result "$backend" validate PASS artifact-validated "$artifact"
                layer_result "$backend" link PASS loadable-artifact-produced "$artifact"
            else
                layer_result "$backend" validate FAIL verified-status-without-artifact "$artifact"
                layer_result "$backend" link FAIL missing-artifact "$artifact"
            fi
            ;;
        unavailable)
            layer_result "$backend" validate SKIP_UNAVAILABLE "$reason" "$artifact"
            layer_result "$backend" link SKIP_UNAVAILABLE validation-unavailable "$artifact"
            ;;
        generated_source_failed)
            layer_result "$backend" validate FAIL source-emission-failed "$artifact"
            layer_result "$backend" link FAIL source-emission-failed "$artifact"
            ;;
        *)
            layer_result "$backend" validate FAIL "${reason:-artifact-validation-failed}" "$artifact"
            layer_result "$backend" link FAIL artifact-not-admitted "$artifact"
            ;;
    esac
}

classify_fixture() {
    status="$1" artifact="$2" reason="${3:-fixture-reason}"
    classify_artifact cuda "$status" "$reason" "$artifact"
}

classify_runtime() {
    backend="$1" code="$2" stdout_file="$3" stderr_file="$4"
    if [ "$code" -eq 0 ]; then
        if grep -Eq '(^|_)status=pass$|readback_status=pass$' "$stdout_file"; then
            layer_result "$backend" runtime PASS device-readback-verified "$stdout_file"
        else
            layer_result "$backend" runtime FAIL zero-exit-without-pass-receipt "$stdout_file"
        fi
    elif grep -Eqi 'unavailable|missing-(tool|device|host)|requires .*host|no .*device' "$stdout_file" "$stderr_file"; then
        layer_result "$backend" runtime SKIP_UNAVAILABLE runtime-capability-unavailable "$stderr_file"
    else
        layer_result "$backend" runtime FAIL runtime-check-failed "$stderr_file"
    fi
}

matrix_summary() {
    summary_file="$1"
    runtime_requested="$2"
    if [ ! -f "$summary_file" ]; then
        printf 'gpu_backend_matrix status=ERROR reason=missing-evidence-file file=%s\n' "$summary_file"
        echo "ERROR — nothing was checked (no evidence file at $summary_file)"
        return 2
    fi
    selected_count=0
    for backend in cuda vulkan metal hip opencl; do
        has_target "$backend" && selected_count=$((selected_count + 1))
    done
    expected_count=$((selected_count * 4))
    actual_count="$(grep -Ec '_(emit|validate|link|runtime)_result=(PASS|FAIL|SKIP_UNAVAILABLE)$' "$summary_file" || true)"
    unique_count="$(sed -n 's/^\([^=]*_\(emit\|validate\|link\|runtime\)_result\)=.*/\1/p' "$summary_file" | sort -u | wc -l | tr -d ' ')"
    pass_count="$(grep -Ec '_result=PASS$' "$summary_file" || true)"
    failure_count="$(grep -Ec '_result=FAIL$' "$summary_file" || true)"
    skip_count="$(grep -Ec '_result=SKIP_UNAVAILABLE$' "$summary_file" || true)"

    if [ "$expected_count" -eq 0 ] || [ "$actual_count" -eq 0 ]; then
        printf 'gpu_backend_matrix status=ERROR backends=%s layers=%s unique=%s expected=%s pass=%s failures=%s skips=%s runtime=%s reason=empty-matrix\n' \
            "$selected_count" "$actual_count" "$unique_count" "$expected_count" \
            "$pass_count" "$failure_count" "$skip_count" "$runtime_requested"
        echo "ERROR — nothing was checked (0 GPU backend layers evaluated)"
        return 2
    fi
    if [ "$actual_count" -ne "$expected_count" ] || [ "$unique_count" -ne "$expected_count" ]; then
        printf 'gpu_backend_matrix status=FAIL backends=%s layers=%s unique=%s expected=%s pass=%s failures=%s skips=%s runtime=%s reason=incomplete-matrix\n' \
            "$selected_count" "$actual_count" "$unique_count" "$expected_count" \
            "$pass_count" "$failure_count" "$skip_count" "$runtime_requested"
        echo "FAIL — $actual_count GPU backend layer(s) checked, incomplete matrix (expected $expected_count)"
        return 1
    fi
    if [ "$failure_count" -gt 0 ]; then
        matrix_status=FAIL
    elif [ "$skip_count" -gt 0 ]; then
        matrix_status=SKIP_UNAVAILABLE
    else
        matrix_status=PASS
    fi
    printf 'gpu_backend_matrix status=%s backends=%s layers=%s unique=%s expected=%s pass=%s failures=%s skips=%s runtime=%s\n' \
        "$matrix_status" "$selected_count" "$actual_count" "$unique_count" \
        "$expected_count" "$pass_count" "$failure_count" "$skip_count" "$runtime_requested"

    # Verdict convention (.claude/rules/vcs.md).  This guard is artifact-first:
    # a PASS layer is real source/artifact evidence read off the tree, which is
    # available on ANY host.  So skips alongside >=1 verified layer are a
    # legitimate RECORDED skip and the count is stated.  But zero verified
    # layers means the guard proved nothing -> ERROR, never exit 0.
    if [ "$failure_count" -gt 0 ]; then
        echo "FAIL — $actual_count GPU backend layer(s) checked, $failure_count failure(s), $skip_count skip(s)"
        return 1
    fi
    if [ "$pass_count" -eq 0 ]; then
        echo "ERROR — nothing was checked ($skip_count GPU backend layer(s) skipped as unavailable, 0 verified)"
        return 2
    fi
    echo "PASS — $actual_count GPU backend layer(s) checked, $pass_count verified, $skip_count recorded skip(s)"
    return 0
}

matrix_self_test() {
    tmp_dir="${TMPDIR:-/tmp}/gpu-layer-matrix-self-test.$$"
    mkdir -p "$tmp_dir"
    trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
    artifact="$tmp_dir/artifact.bin"
    stdout_file="$tmp_dir/runtime.out"
    stderr_file="$tmp_dir/runtime.err"
    summary_file="$tmp_dir/evidence.env"
    printf 'artifact\n' >"$artifact"
    : >"$stderr_file"
    : >"$summary_file"
    for backend in cuda vulkan metal hip opencl; do
        has_target "$backend" || continue
        layer_result "$backend" emit PASS source-emitted "$artifact" >>"$summary_file"
        classify_artifact "$backend" compiled_artifact_verified verified "$artifact" >>"$summary_file"
        printf '%s_status=pass\n' "$backend" >"$stdout_file"
        classify_runtime "$backend" 0 "$stdout_file" "$stderr_file" >>"$summary_file"
    done
    cat "$summary_file"
    matrix_summary "$summary_file" true
}

self_test() {
    tmp="${TMPDIR:-/tmp}/gpu-layer-self-test.$$"
    trap 'rm -f "$tmp" "$tmp.out" "$tmp.err"' EXIT HUP INT TERM
    printf '.version 8.0\n.visible .entry kernel() {}\n' >"$tmp"
    pass="$(classify_fixture compiled_artifact_verified "$tmp")"
    skip="$(classify_fixture unavailable "$tmp.missing")"
    fail="$(classify_fixture toolchain_failed "$tmp.missing")"
    missing="$(classify_fixture compiled_artifact_verified "$tmp.missing")"
    missing_tool="$(classify_fixture invalid "$tmp.missing" missing-validator-tool)"
    emission_fail="$(classify_fixture generated_source_failed "$tmp.missing")"
    unknown="$(classify_fixture future_status "$tmp.missing" unknown-artifact-status)"
    printf '%s\n' "$pass" | grep -q '^cuda_validate_result=PASS$'
    printf '%s\n' "$pass" | grep -q '^cuda_link_result=PASS$'
    printf '%s\n' "$skip" | grep -q '^cuda_validate_result=SKIP_UNAVAILABLE$'
    ! printf '%s\n' "$skip" | grep -q '=PASS$'
    printf '%s\n' "$fail" | grep -q '^cuda_validate_result=FAIL$'
    printf '%s\n' "$missing" | grep -q '^cuda_validate_reason=verified-status-without-artifact$'
    printf '%s\n' "$missing_tool" | grep -q '^cuda_validate_result=SKIP_UNAVAILABLE$'
    printf '%s\n' "$emission_fail" | grep -q '^cuda_validate_reason=source-emission-failed$'
    printf '%s\n' "$unknown" | grep -q '^cuda_validate_reason=unknown-artifact-status$'
    : >"$tmp.out"
    : >"$tmp.err"
    printf 'cuda_generated_status=pass\n' >"$tmp.out"
    runtime_pass="$(classify_runtime cuda 0 "$tmp.out" "$tmp.err")"
    printf 'no pass receipt\n' >"$tmp.out"
    runtime_zero_fail="$(classify_runtime cuda 0 "$tmp.out" "$tmp.err")"
    printf 'missing-device\n' >"$tmp.err"
    runtime_skip="$(classify_runtime cuda 1 "$tmp.out" "$tmp.err")"
    printf 'kernel launch failed\n' >"$tmp.err"
    runtime_fail="$(classify_runtime cuda 1 "$tmp.out" "$tmp.err")"
    printf '%s\n' "$runtime_pass" | grep -q '^cuda_runtime_result=PASS$'
    printf '%s\n' "$runtime_zero_fail" | grep -q '^cuda_runtime_reason=zero-exit-without-pass-receipt$'
    printf '%s\n' "$runtime_skip" | grep -q '^cuda_runtime_result=SKIP_UNAVAILABLE$'
    printf '%s\n' "$runtime_fail" | grep -q '^cuda_runtime_reason=runtime-check-failed$'
    printf '%s\n' "$pass" "$skip" "$fail" "$missing" "$missing_tool" "$emission_fail" "$unknown"
    printf '%s\n' "$runtime_pass" "$runtime_zero_fail" "$runtime_skip" "$runtime_fail"
    printf '%s\n' 'metal_layer=portable_compute_renderer' 'metal_backend_kind=false'
    printf '%s\n' 'hip_backend_kind_status=unimplemented' 'opencl_backend_kind_status=implemented'
    printf '%s\n' 'gpu_backend_layer_self_test=PASS'
}

# Fixture-driven proof of the VERDICT contract (PASS / FAIL / ERROR).  Feeds
# matrix_summary synthetic summary files so every branch is exercised, and is
# FATAL: it runs before every scan.
verdict_self_test() {
    vt_dir="${TMPDIR:-/tmp}/gpu-layer-verdict-self-test.$$"
    mkdir -p "$vt_dir"
    vt_fail=0
    vt_saved_targets="$TARGETS"
    TARGETS=cuda
    vt_case() { # name file expect_exit expect_substr
        # Never read an exit code through a pipe: run to a file, capture $? on
        # the very next line, then read the verdict (last line) from the file.
        if matrix_summary "$2" false >"$vt_dir/out.txt" 2>/dev/null; then vt_ec=0; else vt_ec=$?; fi
        vt_out="$(tail -n 1 "$vt_dir/out.txt")"
        if [ "$vt_ec" -ne "$3" ]; then
            echo "verdict selftest FAIL $1: exit $vt_ec expected $3 ($vt_out)" >&2
            vt_fail=$((vt_fail + 1)); return 0
        fi
        case "$vt_out" in
            *"$4"*) ;;
            *) echo "verdict selftest FAIL $1: '$vt_out' lacks '$4'" >&2; vt_fail=$((vt_fail + 1)) ;;
        esac
    }
    # must-PASS: all four cuda layers verified
    for st in emit validate link runtime; do
        printf 'cuda_%s_result=PASS\n' "$st"
    done >"$vt_dir/all_pass.env"
    vt_case must-pass "$vt_dir/all_pass.env" 0 "PASS — 4 GPU backend layer(s) checked, 4 verified, 0 recorded skip(s)"
    # must-PASS with recorded skips: verified evidence exists, skips stated
    { printf 'cuda_emit_result=PASS\ncuda_validate_result=PASS\n'
      printf 'cuda_link_result=SKIP_UNAVAILABLE\ncuda_runtime_result=SKIP_UNAVAILABLE\n'; } >"$vt_dir/mixed.env"
    vt_case must-pass-with-skips "$vt_dir/mixed.env" 0 "PASS — 4 GPU backend layer(s) checked, 2 verified, 2 recorded skip(s)"
    # must-FAIL
    { printf 'cuda_emit_result=PASS\ncuda_validate_result=FAIL\n'
      printf 'cuda_link_result=FAIL\ncuda_runtime_result=SKIP_UNAVAILABLE\n'; } >"$vt_dir/fail.env"
    vt_case must-fail "$vt_dir/fail.env" 1 "FAIL — 4 GPU backend layer(s) checked, 2 failure(s), 1 skip(s)"
    # must-ERROR: every layer skipped, nothing verified
    for st in emit validate link runtime; do
        printf 'cuda_%s_result=SKIP_UNAVAILABLE\n' "$st"
    done >"$vt_dir/all_skip.env"
    vt_case must-error-all-skipped "$vt_dir/all_skip.env" 2 "ERROR — nothing was checked (4 GPU backend layer(s) skipped as unavailable, 0 verified)"
    # must-ERROR: nonexistent evidence file -> zero layers evaluated
    vt_case must-error-missing-evidence "$vt_dir/does-not-exist.env" 2 "ERROR — nothing was checked"
    rm -rf "$vt_dir"
    TARGETS="$vt_saved_targets"
    if [ "$vt_fail" -gt 0 ]; then
        echo "gpu_backend_verdict_selftest status=FAIL cases_failed=$vt_fail" >&2
        return 1
    fi
    echo "gpu_backend_verdict_selftest status=PASS cases=5"
    return 0
}

if [ "$SELF_TEST" = true ]; then
    verdict_self_test || exit 1
    self_test
    exit 0
fi

if ! verdict_self_test; then
    echo "ERROR — nothing was checked (verdict selftest failed)"
    exit 2
fi

if [ "$MATRIX_SELF_TEST" = true ]; then
    matrix_self_test
    exit $?
fi

mkdir -p "$BUILD_DIR"
SUMMARY="$BUILD_DIR/evidence.env"
: >"$SUMMARY"

for backend in cuda vulkan metal hip opencl; do
    has_target "$backend" || continue
    target_dir="$BUILD_DIR/$backend"
    mkdir -p "$target_dir"
    portable_out="$target_dir/portable.out"
    portable_err="$target_dir/portable.err"
    # The producer must run before any device probe.  Strict admission is
    # disabled here so missing optional toolchains can be classified as SKIP.
    if PORTABLE_COMPUTE_TARGETS="$backend" \
       BUILD_DIR="$target_dir/portable" \
       REPORT_PATH="$target_dir/portable-report.md" \
       PORTABLE_COMPUTE_REQUIRE_VERIFIED=0 \
       sh "$PORTABLE_CHECK" >"$portable_out" 2>"$portable_err"; then
        producer_code=0
    else
        producer_code=$?
    fi
    evidence="$target_dir/portable/evidence.env"
    printf '%s_emit_probe=%s\n' "$backend" "$PORTABLE_CHECK" >>"$SUMMARY"
    if [ ! -f "$evidence" ]; then
        layer_result "$backend" emit FAIL "producer-exit-$producer_code-without-evidence" "$portable_err" >>"$SUMMARY"
        layer_result "$backend" validate FAIL no-producer-evidence "$evidence" >>"$SUMMARY"
        layer_result "$backend" link FAIL no-producer-evidence "$evidence" >>"$SUMMARY"
    else
        if [ "$backend" = vulkan ]; then
            status="$(field_of vulkan_font_status "$evidence")"
            reason="$(field_of vulkan_font_reason "$evidence")"
            artifact="$(field_of vulkan_font_artifact "$evidence")"
        else
            status="$(field_of "${backend}_status" "$evidence")"
            reason="$(field_of "${backend}_reason" "$evidence")"
            artifact="$(field_of "${backend}_artifact" "$evidence")"
        fi
        case "$status" in
            generated_source_failed|'') layer_result "$backend" emit FAIL "${reason:-missing-emission-status}" "$evidence" ;;
            *) layer_result "$backend" emit PASS source-emitted "$evidence" ;;
        esac >>"$SUMMARY"
        classify_artifact "$backend" "$status" "$reason" "$artifact" >>"$SUMMARY"
    fi

    if [ "$RUN_RUNTIME" != true ]; then
        layer_result "$backend" runtime SKIP_UNAVAILABLE runtime-not-requested artifact-first-only >>"$SUMMARY"
        continue
    fi
    case "$backend" in
        cuda) runtime_check="$ROOT_DIR/scripts/check/check-cuda-generated-2d-readback.shs" ;;
        vulkan) runtime_check="$ROOT_DIR/scripts/check/check-vulkan-engine2d-readback.shs" ;;
        metal) runtime_check="$ROOT_DIR/scripts/check/check-metal-generated-2d-readback.shs" ;;
        hip) runtime_check="$ROOT_DIR/scripts/check/check-rocm-generated-2d-readback.shs" ;;
        opencl) runtime_check="$ROOT_DIR/scripts/check/check-opencl-generated-2d-readback.shs" ;;
    esac
    runtime_out="$target_dir/runtime.out"
    runtime_err="$target_dir/runtime.err"
    if [ ! -f "$runtime_check" ]; then
        layer_result "$backend" runtime SKIP_UNAVAILABLE missing-runtime-check "$runtime_check" >>"$SUMMARY"
    else
        if sh "$runtime_check" >"$runtime_out" 2>"$runtime_err"; then runtime_code=0; else runtime_code=$?; fi
        classify_runtime "$backend" "$runtime_code" "$runtime_out" "$runtime_err" >>"$SUMMARY"
    fi
done

{
    echo 'metal_layer=portable_compute_renderer'
    echo 'metal_backend_kind=false'
    echo 'hip_backend_kind_status=unimplemented'
    echo 'opencl_backend_kind_status=implemented'
} >>"$SUMMARY"

cat "$SUMMARY"
matrix_summary "$SUMMARY" "$RUN_RUNTIME"
