#!/bin/sh
set -eu
src=examples/09_embedded/simple_os/arch/arm64/boot/crt0.S
body=$(awk '/^_fault_handler:/{inside=1} inside{print} /^\.Lfault_halt:/{exit}' "$src")
printf '%s\n' "$body" | grep -Fq 'mrs     x2, far_el1' || { echo 'FAIL: FAR_EL1 receipt absent' >&2; exit 1; }
printf '%s\n' "$body" | grep -Fq 'mov     x2, x19' || { echo 'FAIL: user x19 receipt absent' >&2; exit 1; }
for label in .Lfar_loop .Lfar_digit .Lfar_emit .Lx19_loop .Lx19_digit .Lx19_emit .Lx20_loop .Lx20_digit .Lx20_emit .Lx0_loop .Lx0_digit .Lx0_emit .Lx1_loop .Lx1_digit .Lx1_emit; do
    printf '%s\n' "$body" | grep -Fq "$label" || { echo "FAIL: missing closed hex receipt label $label" >&2; exit 1; }
done
printf '%s\n' "$body" | grep -Fq 'ldr     x14, [sp, #160]' || { echo 'FAIL: saved-frame x20 receipt absent' >&2; exit 1; }
printf '%s\n' "$body" | grep -Fq 'ldr     x12, [sp, #0]' || { echo 'FAIL: saved-frame x0 receipt absent' >&2; exit 1; }
printf '%s\n' "$body" | grep -Fq 'ldr     x13, [sp, #8]' || { echo 'FAIL: saved-frame x1 receipt absent' >&2; exit 1; }
echo 'PASS: ARM64 fault receipt closes FAR_EL1 and restored x19/x20/x0/x1 operands'
