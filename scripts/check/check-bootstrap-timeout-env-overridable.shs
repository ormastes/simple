#!/bin/sh
# check-bootstrap-timeout-env-overridable.shs
#
# The bootstrap compiler-budget knobs (COMPILER_PROBE_TIMEOUT_SECONDS,
# COMPILER_BUILD_TIMEOUT_SECONDS, COMPILER_EXEC_TIMEOUT_SECONDS,
# COMPILER_CHECK_KILL_GRACE_SECONDS) must be env-overridable at every site that
# sets them, while keeping their historical defaults byte-identical when unset.
#
# Incident 2026-08-25 (doc/08_tracking/bug/bootstrap_build_timeout_not_env_overridable_2026-08-25.md):
# `scripts/check/cert/redeploy_gate/candidate_frontend_admission.shs` honours
# the environment, but its callers overwrote it with an UNCONDITIONAL
# `COMPILER_BUILD_TIMEOUT_SECONDS=60` immediately before sourcing it. On a box
# at load ~39 a perfectly good Stage 2 candidate (757 compiled, 0 failed) was
# rejected `sanity FAIL - frontend smoke exited 1`; a hand replay of the same
# smoke against the preserved `simple.rejected` exited 0 in 8.5s. The gate was a
# load-sensitive false negative that no operator could widen.
#
# Three properties are proved, not asserted:
#   (a) unset  -> the historical default (5/60/5/1)
#   (b) exported value is honoured
#   (c) a deliberately tiny budget still FAILS CLOSED (a slow candidate is
#       killed and reported as a failure, never silently passed)
#
# Verdict convention: last stdout line is
#   PASS — ...   exit 0
#   FAIL — ...   exit 1
#   ERROR — nothing was checked   exit 2
# `--selftest` runs before every scan and is fatal.

set -u

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)

VARS='COMPILER_PROBE_TIMEOUT_SECONDS:5
COMPILER_BUILD_TIMEOUT_SECONDS:60
COMPILER_EXEC_TIMEOUT_SECONDS:5
COMPILER_CHECK_KILL_GRACE_SECONDS:1'

# Sites that must be env-overridable. A path that does not exist in this tree is
# skipped (some are only present on branches that carry the resume lane), but a
# run that ends up scanning zero sites is an ERROR, never a pass.
SITES='scripts/bootstrap/bootstrap-from-scratch.sh
scripts/bootstrap/resume-stage3-from-admitted.sh
scripts/check/lib/bootstrap-stage3/sanity.shs
scripts/check/cert/redeploy_gate/candidate_frontend_admission.shs'

CHECKED=0
OFFENDERS=''

note_offender() {
  OFFENDERS="$OFFENDERS
  - $1"
}

# scan_file <file> <label-prefix>
# For each knob assignment found in FILE, evaluate the assignment in an isolated
# subshell twice: once with the variable unset (must yield the default) and once
# with it exported to a probe value (must yield the probe value). This executes
# the real line from the real file, so a regression to a bare `VAR=60` is caught
# by behaviour rather than by a text pattern.
scan_file() {
  file=$1
  label=$2
  for row in $VARS; do
    var=${row%%:*}
    def=${row##*:}
    # The assignment line, with any command-prefix continuation backslash and
    # leading indentation stripped so it can be evaluated standalone.
    line=$(grep -E "^[[:space:]]*${var}=" "$file" 2>/dev/null | head -n 1 |
      sed -e 's/[[:space:]]*\\[[:space:]]*$//' -e 's/^[[:space:]]*//')
    [ -n "$line" ] || continue
    CHECKED=$((CHECKED + 1))

    got_unset=$(env -u "$var" sh -c "$line; printf '%s' \"\$$var\"" 2>/dev/null)
    if [ "$got_unset" != "$def" ]; then
      note_offender "$label: $var unset yielded '$got_unset', expected default '$def'"
      continue
    fi

    probe=$((def + 537))
    got_set=$(env "$var=$probe" sh -c "$line; printf '%s' \"\$$var\"" 2>/dev/null)
    if [ "$got_set" != "$probe" ]; then
      note_offender "$label: $var=$probe was clobbered to '$got_set' (not env-overridable)"
    fi
  done
}

# fail_closed_probe
# Property (c): the admission helper's smoke path must still FAIL when the
# budget is too small for the candidate. Exercised against a stub candidate that
# simply sleeps, under COMPILER_BUILD_TIMEOUT_SECONDS=1. A helper that "honours
# the env" by ignoring the budget entirely would pass (a)+(b) and still be
# broken; this is the check that catches it.
fail_closed_probe() {
  helper=$root/scripts/check/cert/redeploy_gate/candidate_frontend_admission.shs
  [ -f "$helper" ] || return 0
  command -v timeout >/dev/null 2>&1 || command -v gtimeout >/dev/null 2>&1 || return 0
  d=$(mktemp -d "${TMPDIR:-/tmp}/timeout-envcheck.XXXXXX") || return 0
  trap 'rm -rf "$d"' EXIT HUP INT TERM
  cat >"$d/slowcand" <<'STUB'
#!/bin/sh
sleep 30
STUB
  chmod +x "$d/slowcand"
  CHECKED=$((CHECKED + 1))
  start=$(date +%s)
  (
    COMPILER_BUILD_TIMEOUT_SECONDS=1 \
    COMPILER_CHECK_KILL_GRACE_SECONDS=1 \
    COMPILER_EXEC_TIMEOUT_SECONDS=1 \
    COMPILER_PROBE_TIMEOUT_SECONDS=1 \
    CANDIDATE_FRONTEND_ROOT="$root" \
      sh -c '. "$1"; candidate_frontend_smoke "$2"' _ "$helper" "$d/slowcand"
  ) >/dev/null 2>&1
  rc=$?
  elapsed=$(( $(date +%s) - start ))
  rm -rf "$d"
  if [ "$rc" -eq 0 ]; then
    note_offender "fail-closed: a 1s budget let a 30s candidate PASS (rc=0)"
  elif [ "$elapsed" -gt 20 ]; then
    note_offender "fail-closed: 1s budget was not honoured (took ${elapsed}s to fail)"
  fi
}

selftest() {
  d=$(mktemp -d "${TMPDIR:-/tmp}/timeout-envcheck-selftest.XXXXXX") || {
    echo "selftest: cannot create temp dir" >&2
    exit 2
  }
  trap 'rm -rf "$d"' EXIT HUP INT TERM
  rc=0

  # Fixture 1: correct form must produce no offenders.
  printf 'COMPILER_BUILD_TIMEOUT_SECONDS=${COMPILER_BUILD_TIMEOUT_SECONDS:-60}\n' >"$d/good.sh"
  CHECKED=0 OFFENDERS=''
  scan_file "$d/good.sh" good
  [ "$CHECKED" -eq 1 ] || { echo "selftest: good fixture checked $CHECKED, expected 1" >&2; rc=1; }
  [ -z "$OFFENDERS" ] || { echo "selftest: good fixture flagged an offender" >&2; rc=1; }

  # Fixture 2: the incident's exact shape (unconditional 60) must be flagged.
  printf 'COMPILER_BUILD_TIMEOUT_SECONDS=60\n' >"$d/bad.sh"
  CHECKED=0 OFFENDERS=''
  scan_file "$d/bad.sh" bad
  [ "$CHECKED" -eq 1 ] || { echo "selftest: bad fixture checked $CHECKED, expected 1" >&2; rc=1; }
  case "$OFFENDERS" in
    *"not env-overridable"*) : ;;
    *) echo "selftest: unconditional assignment was NOT flagged" >&2; rc=1 ;;
  esac

  # Fixture 3: a wrong default must be flagged even though it is overridable.
  printf 'COMPILER_BUILD_TIMEOUT_SECONDS=${COMPILER_BUILD_TIMEOUT_SECONDS:-9}\n' >"$d/drift.sh"
  CHECKED=0 OFFENDERS=''
  scan_file "$d/drift.sh" drift
  case "$OFFENDERS" in
    *"expected default '60'"*) : ;;
    *) echo "selftest: default drift was NOT flagged" >&2; rc=1 ;;
  esac

  # Fixture 4: command-prefix form with a trailing continuation backslash (the
  # shape used in scripts/check/lib/bootstrap-stage3/sanity.shs) must parse.
  printf '    COMPILER_EXEC_TIMEOUT_SECONDS=${COMPILER_EXEC_TIMEOUT_SECONDS:-5} \\\n' >"$d/cont.sh"
  CHECKED=0 OFFENDERS=''
  scan_file "$d/cont.sh" cont
  [ "$CHECKED" -eq 1 ] || { echo "selftest: continuation fixture checked $CHECKED, expected 1" >&2; rc=1; }
  [ -z "$OFFENDERS" ] || { echo "selftest: continuation fixture flagged an offender: $OFFENDERS" >&2; rc=1; }

  # Fixture 5: a file with no knobs at all must contribute zero checks, so an
  # empty scan is forced to ERROR rather than laundered into a pass.
  printf 'echo hello\n' >"$d/empty.sh"
  CHECKED=0 OFFENDERS=''
  scan_file "$d/empty.sh" empty
  [ "$CHECKED" -eq 0 ] || { echo "selftest: empty fixture checked $CHECKED, expected 0" >&2; rc=1; }

  rm -rf "$d"
  CHECKED=0
  OFFENDERS=''
  [ "$rc" -eq 0 ] || { echo "selftest FAILED" >&2; exit 2; }
}

selftest

case "${1:-}" in
  --selftest)
    echo "PASS — selftest only: 5 fixture(s) checked"
    exit 0
    ;;
esac

scanned_sites=0
for rel in $SITES; do
  f=$root/$rel
  [ -f "$f" ] || continue
  scanned_sites=$((scanned_sites + 1))
  scan_file "$f" "$rel"
done

fail_closed_probe

if [ "$scanned_sites" -eq 0 ] || [ "$CHECKED" -eq 0 ]; then
  echo "ERROR — nothing was checked"
  exit 2
fi

if [ -n "$OFFENDERS" ]; then
  n=$(printf '%s' "$OFFENDERS" | grep -c '^  - ')
  printf '%s\n' "$OFFENDERS" | sed '/^$/d'
  echo "FAIL — $CHECKED assertion(s) across $scanned_sites site(s), $n offender(s)"
  exit 1
fi

echo "PASS — $CHECKED assertion(s) across $scanned_sites site(s), 0 offenders (defaults intact, env honoured, tiny budget fails closed)"
exit 0
