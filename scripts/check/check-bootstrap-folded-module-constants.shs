#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
cd "$repo_root"
simple_bin=${SIMPLE_BIN:-bin/simple}
artifact_dir=build/test-artifacts/bootstrap_folded_module_constants
candidate=$artifact_dir/probe
build_log=$artifact_dir/native-build.log
run_log=$artifact_dir/native-run.log

version=$($simple_bin --version 2>&1) || exit 1
case "$version" in
  *Rust-built*|*"bootstrap seed only"*)
    echo "STATUS: BLOCKED folded-module-constants reason=rust-seed-forbidden"
    exit 2
    ;;
esac

mkdir -p "$artifact_dir"
env -u SIMPLE_BOOTSTRAP -u SIMPLE_RUNTIME_PATH SIMPLE_NO_STUB_FALLBACK=1 \
  "$simple_bin" compile test/fixtures/bootstrap_folded_module_constants/main.spl \
  --native -o "$candidate" >"$build_log" 2>&1
timeout 30 "$candidate" >"$run_log" 2>&1
grep -Fq 'CONST-PROBE:41:0:2.5:true:folded:42' "$run_log"
echo "STATUS: PASS folded-module-constants branches=int,zero,float,bool,text,binary"
