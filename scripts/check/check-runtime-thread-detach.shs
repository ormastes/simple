#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
out=$(mktemp -d "${TMPDIR:-/tmp}/simple-thread-detach.XXXXXX")
trap 'rm -rf "$out"' EXIT HUP INT TERM
case $(uname -s) in
    Darwin) libs= ;;
    *) libs=-ldl ;;
esac
"${CC:-cc}" -std=gnu11 -g -O1 -pthread ${CFLAGS:-} \
    "$root/src/runtime/test/runtime_thread_detach_selfcheck.c" \
    "$root/src/runtime/runtime_memtrack.c" $libs -o "$out/check"
"$out/check"
if "$out/check" --negative-control >"$out/negative.log" 2>&1; then
    echo "thread detach negative control unexpectedly passed" >&2
    exit 1
fi
grep -q 'intentional negative control' "$out/negative.log"
echo "runtime thread detach negative control: PASS (failure detected)"
