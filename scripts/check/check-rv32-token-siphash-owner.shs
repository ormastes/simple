#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
out=${RV32_SIPHASH_TEST_DIR:-/mnt/data/.simple/rv32-siphash-owner-test}
mkdir -p "$out"
source_count=$(grep -R --include='*.c' -h \
    '^uint64_t rt_rv32_token_siphash24(' "$root/src" "$root/examples" | wc -l)
if [ "$source_count" -ne 1 ]; then
    echo "FAIL rv32 SipHash strong source owner count=$source_count" >&2
    exit 1
fi
catalog_count=$(grep -F '"src/os/kernel/arch/common/rv32_token_siphash.c"' \
    "$root/src/os/port/_SimpleosMultiplatformBuild/platform_target_catalog.spl" | wc -l)
if [ "$catalog_count" -ne 1 ]; then
    echo "FAIL rv32 SipHash catalog selection count=$catalog_count" >&2
    exit 1
fi
cc -std=c11 -Wall -Wextra -Werror \
    -I"$root/src/os/kernel/arch/common" \
    "$root/src/os/kernel/arch/common/rv32_token_siphash.c" \
    "$root/test/01_unit/os/kernel/arch/rv32_token_siphash_kat.c" \
    -o "$out/rv32-token-siphash-kat"
count=$(nm -g --defined-only "$out/rv32-token-siphash-kat" | \
    awk '$3 == "rt_rv32_token_siphash24" { n += 1 } END { print n + 0 }')
if [ "$count" -ne 1 ]; then
    echo "FAIL rv32 SipHash owner count=$count" >&2
    exit 1
fi
"$out/rv32-token-siphash-kat"
