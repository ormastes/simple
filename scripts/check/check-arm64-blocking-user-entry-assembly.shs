#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
asm="$root/examples/09_embedded/simple_os/arch/arm64/boot/crt0.S"

grep -qF 'arm64_enter_user_virtual:' "$asm"
grep -qF 'stp     x29, x30, [sp, #80]' "$asm"
grep -qF 'eret' "$asm"
grep -qF 'arm64_user_exit_resume:' "$asm"
grep -qF 'ldp     x29, x30, [sp, #80]' "$asm"
grep -qF 'ret' "$asm"
printf '%s\n' 'ARM64 blocking user-entry assembly contract PASS'
