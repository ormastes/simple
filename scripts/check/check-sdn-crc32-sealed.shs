#!/bin/sh
# check-sdn-crc32-sealed.shs — every sealed SDN file in the committed tree must
# verify against its `.csm` sidecar seal (the script keeps its historical name
# and the push-gate id `push-sdn-crc32-sealed`; the seal is no longer crc32-only).
#
# SEAL FORMAT
# -----------
# `dir/X.sdn` is sealed by an EMPTY sibling file `dir/X.<algo>_<hex>.csm`
# (algo in {crc32 (8 hex), xxh3 (16), blake3 (64)}), hash over the LF-normalized
# file. Shared logic: scripts/check/sdn-seal-lib.shs; loader twin:
# src/lib/nogc_sync_mut/database/csm_seal.spl. The old in-file line-1
# `#sdn-crc32:<n>` header is LEGACY: accepted with a deprecation note for one
# release, never produced any more.
#
# WHY THIS EXISTS
# ---------------
# The loader verifies fail-CLOSED: a content/seal mismatch makes the whole file
# load as nil, silently. On 2026-09-23 a merge landed bug_db.sdn with a stale
# header and the entire bug database disappeared for every consumer. No other
# push gate looks at seals.
#
# STATES (per sealed file, from COMMITTED content at --rev, never the checkout)
#   OK               exactly one matching sidecar, algorithm == policy
#   CORRUPT          one sidecar that mismatches / unknown algo / bad width   FAIL
#   MERGED_UNSEALED  more than one sidecar                      FAIL ("run reseal")
#   MISSING          policy-listed file with no sidecar         FAIL
#   RESEAL_NEEDED    OK but algorithm differs from the policy   FAIL
#   LEGACY           line-1 `#sdn-crc32:` header, matching       accepted (note)
#   orphan seal      a .csm whose data file is absent            FAIL
# Policy: config/check/sdn_seal_policy.sdn (path glob -> algo), read at --rev.
#
# Verdict, always the last line of stdout:
#   PASS  — <n> sealed .sdn file(s) checked at <rev>, 0 stale    exit 0
#   FAIL  — <n> sealed .sdn file(s) checked at <rev>, <k> stale: <paths>  exit 1
#   ERROR — nothing was checked (<reason>)                       exit 2
# Non-vacuous: n is always > 0; a revision with no sealed .sdn at all is ERROR.
# --selftest runs before every scan and is fatal (3 fixture repos covering OK, CORRUPT, MERGED_UNSEALED, MISSING, LEGACY, CRLF, unknown algo, width, policy mismatch, orphan, empty).
#
# Usage:
#   sh scripts/check/check-sdn-crc32-sealed.shs --rev <sha> [--root <repo>]
#   sh scripts/check/check-sdn-crc32-sealed.shs --range <base>..<head> [--root <repo>]
#   sh scripts/check/check-sdn-crc32-sealed.shs --selftest
#
# RANGE MODE (--range): judge the tree at <head>, but FAIL only for sealed files
# whose .sdn or any of whose .csm sidecars CHANGED in <base>..<head> (a changed
# config/check/sdn_seal_policy.sdn puts every file in scope). Drift in files the
# range did not touch prints `NOTE drift (not in range): <path>` and does not
# fail: one session that forgets to reseal must not fail every other PR. Use
# --rev (full mode) on main and in the extended job, where all drift is visible.

set -u

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
. "$SELF_DIR/sdn-seal-lib.shs"
POLICY_REL="config/check/sdn_seal_policy.sdn"

REV=""; RANGE_BASE=""
RANGE=""
ROOT=""
SELFTEST_ONLY=0
SKIP_SELFTEST=0
while [ $# -gt 0 ]; do
    case "$1" in
        --rev) REV=${2:-}; shift 2 ;;
        --range) RANGE=${2:-}; shift 2 ;;
        --root) ROOT=${2:-}; shift 2 ;;
        --selftest) SELFTEST_ONLY=1; shift ;;
        --no-selftest) SKIP_SELFTEST=1; shift ;;
        *) echo "unknown argument: $1" >&2; echo "ERROR — nothing was checked (unknown argument $1)"; exit 2 ;;
    esac
done

# scan <root> <rev> -> prints the verdict, returns 0/1/2
scan() {
    _root=$1; _rev=$2; _base=${3:-}
    _work=$(csm_mktemp_dir) || { echo "ERROR — nothing was checked (mktemp failed)"; return 2; }
    # Range mode: scope.txt lists the data files whose .sdn/.csm changed in base..rev
    # (all_scope=1 when the policy itself changed). Empty _base = full mode.
    : > "$_work/scope.txt"; _all_scope=0; _inrange=0
    if [ -n "$_base" ]; then
        git -C "$_root" rev-parse --verify --quiet "$_base^{commit}" >/dev/null 2>&1 ||
            { rm -rf "$_work"; echo "ERROR — nothing was checked ($_base is not a commit in $_root)"; return 2; }
        git -C "$_root" diff --name-only --no-renames "$_base" "$_rev" > "$_work/changed.txt" 2>/dev/null ||
            { rm -rf "$_work"; echo "ERROR — nothing was checked (cannot diff $_base..$_rev)"; return 2; }
        grep -qxF "$POLICY_REL" "$_work/changed.txt" && _all_scope=1
        sed -n -e 's|^\(.*\)\.[^./]*_[^./]*\.csm$|\1.sdn|p' -e 's|\.sdn$|&|p' "$_work/changed.txt" | grep '\.sdn$' | LC_ALL=C sort -u > "$_work/scope.txt"
    fi
    # _flag <path> <message>: a stale finding; in range mode out-of-scope drift is only a NOTE.
    _flag() {
        if [ -n "$_base" ] && [ "$_all_scope" -eq 0 ] && ! grep -qxF "$1" "$_work/scope.txt"; then
            echo "NOTE drift (not in range): $1 ($2)"
        else
            _k=$((_k + 1)); _stale="$_stale $1"; echo "$2"
        fi
    }
    git -C "$_root" rev-parse --verify --quiet "$_rev^{commit}" >/dev/null 2>&1 ||
        { rm -rf "$_work"; echo "ERROR — nothing was checked ($_rev is not a commit in $_root)"; return 2; }
    git -C "$_root" show "$_rev:$POLICY_REL" > "$_work/policy.sdn" 2>/dev/null || : > "$_work/policy.sdn"

    # data-file <TAB> tag, for every sidecar in the tree
    git -C "$_root" ls-tree -r --name-only "$_rev" 2>/dev/null | grep '\.csm$' |
        sed -n 's|^\(.*\)\.\([^./]*_[^./]*\)\.csm$|\1.sdn\t\2|p' | LC_ALL=C sort > "$_work/seals.tsv"
    # legacy-headered .sdn files (line 1 only)
    git -C "$_root" grep -l '^#sdn-crc32:' "$_rev" -- '*.sdn' 2>/dev/null | sed "s/^[^:]*://" > "$_work/legacy.txt"
    # exact (glob-free) policy rows must have a seal
    awk '/^    / { s=$0; sub(/^    /, "", s); if (s ~ /^#/) next; sub(/,.*/, "", s); gsub(/[ \t\r]/, "", s); if (s != "" && s !~ /[*?]/) print s }' "$_work/policy.sdn" > "$_work/listed.txt"

    # candidate files: those with seals, legacy headers, or policy rows
    { cut -f1 "$_work/seals.tsv"; cat "$_work/legacy.txt"; cat "$_work/listed.txt"; } | grep -v '^$' | LC_ALL=C sort -u > "$_work/files.txt"

    # PASS 1: copy every single-sealed blob out of git and hash them per
    # algorithm in ONE batch call each (xxh3/blake3 go through the pure-Simple
    # CLI whose ~5 s startup must be paid once per algorithm, not per file).
    mkdir -p "$_work/h"
    _i=0
    : > "$_work/algos.txt"
    while IFS= read -r _path; do
        _i=$((_i + 1))
        [ -n "$_path" ] || continue
        _tags=$(awk -F'\t' -v p="$_path" '$1 == p { print $2 }' "$_work/seals.tsv")
        [ -n "$_tags" ] && [ "$(printf '%s\n' "$_tags" | wc -l | tr -d ' ')" -eq 1 ] || continue
        _a=${_tags%%_*}
        csm_hex_len "$_a" >/dev/null || continue
        git -C "$_root" cat-file -e "$_rev:$_path" 2>/dev/null || continue
        git -C "$_root" show "$_rev:$_path" > "$_work/h/blob.$_i" 2>/dev/null || continue
        printf '%s\t%s\n' "$_a" "$_i" >> "$_work/algos.txt"
    done < "$_work/files.txt"
    : > "$_work/h/empty"
    for _a in $(cut -f1 "$_work/algos.txt" | LC_ALL=C sort -u); do
        _idx=$(awk -F'\t' -v a="$_a" '$1 == a { print $2 }' "$_work/algos.txt")
        # The first input is an EMPTY file: its digest must equal the published
        # known answer, so a hasher that is the wrong algorithm/variant is caught
        # in the same process instead of silently disagreeing with the loader.
        _args="$_work/h/empty"; for _x in $_idx; do _args="$_args $_work/h/blob.$_x"; done
        case "$_a" in xxh3) _kat=$CSM_KAT_XXH3_EMPTY ;; blake3) _kat=$CSM_KAT_BLAKE3_EMPTY ;; *) _kat=00000000 ;; esac
        # shellcheck disable=SC2086
        if csm_hash_batch "$_a" "$_work/h/out.$_a" $_args 2>"$_work/h/err.$_a" && [ "$(sed -n 1p "$_work/h/out.$_a")" = "$_kat" ]; then
            _j=1
            for _x in $_idx; do _j=$((_j + 1)); sed -n "${_j}p" "$_work/h/out.$_a" > "$_work/h/hash.$_x"; done
        else
            echo "hasher for $_a unavailable or failed its known-answer check: $(head -1 "$_work/h/err.$_a" 2>/dev/null) (every $_a-sealed file is treated as CORRUPT)"
        fi   # a failed batch leaves no hash files => every file of that algo is CORRUPT (fail closed)
    done
    # PASS 2: judge each file.
    _i=0; _n=0; _k=0; _stale=""; _legacy=0
    while IFS= read -r _path; do
        _i=$((_i + 1))
        [ -n "$_path" ] || continue
        _tags=$(awk -F'\t' -v p="$_path" '$1 == p { print $2 }' "$_work/seals.tsv")
        _is_listed=0; grep -qxF "$_path" "$_work/listed.txt" && _is_listed=1
        if ! git -C "$_root" cat-file -e "$_rev:$_path" 2>/dev/null; then
            if [ -n "$_tags" ]; then _n=$((_n + 1)); _flag "$_path" "orphan seal (data file absent): $_path"; fi
            continue
        fi
        git -C "$_root" show "$_rev:$_path" > "$_work/copy.sdn" 2>/dev/null ||
            { rm -rf "$_work"; echo "ERROR — nothing was checked (cannot read $_rev:$_path)"; return 2; }
        _has_legacy=0; grep -qxF "$_path" "$_work/legacy.txt" && case "$(head -1 "$_work/copy.sdn")" in '#sdn-crc32:'*) _has_legacy=1 ;; esac
        if [ -z "$_tags" ] && [ "$_has_legacy" -eq 0 ] && [ "$_is_listed" -eq 0 ]; then continue; fi
        _n=$((_n + 1))
        if [ -n "$_base" ] && { [ "$_all_scope" -eq 1 ] || grep -qxF "$_path" "$_work/scope.txt"; }; then _inrange=$((_inrange + 1)); fi
        _got=$(cat "$_work/h/hash.$_i" 2>/dev/null); [ -n "$_got" ] || _got="-"
        # shellcheck disable=SC2086
        _res=$(csm_judge "$_work/copy.sdn" "$_got" $_tags)
        _state=${_res%% *}
        case "$_state" in
            OK)
                _want=$(csm_policy_algo_strict "$_work/policy.sdn" "$_path")
                _have=${_res#OK }
                if [ "$_have" != "$_want" ]; then
                    _flag "$_path" "RESEAL_NEEDED $_path: sealed with $_have, policy says $_want (run scripts/check/reseal-sdn-crc32.shs)"
                fi ;;
            LEGACY)
                _legacy=$((_legacy + 1))
                echo "note: $_path still carries a deprecated #sdn-crc32 header (accepted for one release; run scripts/check/reseal-sdn-crc32.shs to migrate)" ;;
            MISSING)
                _flag "$_path" "MISSING seal for policy-listed $_path (the loader fails closed; run scripts/check/reseal-sdn-crc32.shs and commit the .csm)" ;;
            MERGED_UNSEALED)
                _flag "$_path" "MERGED_UNSEALED $_path: ${_res#MERGED_UNSEALED } .csm files (run scripts/check/reseal-sdn-crc32.shs, which keeps exactly one)" ;;
            *)
                _flag "$_path" "CORRUPT $_path: ${_res#CORRUPT } (the loader reads this file as nil; run scripts/check/reseal-sdn-crc32.shs on it and commit)" ;;
        esac
    done < "$_work/files.txt"
    rm -rf "$_work"
    if [ "$_n" -eq 0 ]; then
        echo "ERROR — nothing was checked (no sealed .sdn file at $_rev)"
        return 2
    fi
    _scope_txt=""; [ -z "$_base" ] || _scope_txt=" (range $_base..$_rev, $_inrange in range)"
    if [ "$_k" -ne 0 ]; then
        echo "fix: sh scripts/check/reseal-sdn-crc32.shs <each stale .sdn>, then git add the .sdn + its .csm and commit (or: sh scripts/check/reseal-range.shs --base <base> --commit)"
        echo "FAIL — $_n sealed .sdn file(s) checked at $_rev$_scope_txt, $_k stale:$_stale"
        return 1
    fi
    echo "PASS — $_n sealed .sdn file(s) checked at $_rev$_scope_txt, 0 stale"
    return 0
}

# Fixtures are real git repositories scanned by the real scan(), never a mock.
selftest() {
    _t=$(csm_mktemp_dir) || return 1
    _fails=0
    _mk() { mkdir -p "$1" && git -C "$1" init -q && git -C "$1" config user.email s@t && git -C "$1" config user.name selftest && git -C "$1" config core.autocrlf false; }
    _commit() { git -C "$1" add -A && git -C "$1" commit -q -m fixture; }
    _last() { printf '%s' "$1" | tail -1; }
    _expect() { # name rc want_rc output want_substring
        if [ "$2" -ne "$3" ] || ! printf '%s' "$4" | grep -qF -- "$5"; then
            echo "selftest FAIL $1: rc=$2 (want $3), wanted '$5' in: $(_last "$4")"; _fails=$((_fails + 1))
        fi
    }

    # --- repo A: every offending state in ONE repo (git init is the slow part)
    _mk "$_t/a"; mkdir -p "$_t/a/config/check" "$_t/a/doc"
    printf 'seal_policy |glob, algo|\n    doc/listed.sdn, crc32\n    doc/policy.sdn, xxh3\n' > "$_t/a/config/check/sdn_seal_policy.sdn"
    # CORRUPT: content changed after sealing
    printf 'bugs |id|\n    a\n' > "$_t/a/doc/corrupt.sdn"; csm_seal_file "$_t/a/doc/corrupt.sdn" crc32 >/dev/null
    printf 'bugs |id|\n    a\n    b\n' > "$_t/a/doc/corrupt.sdn"
    # MERGED_UNSEALED: two sidecars
    printf 'bugs |id|\n    a\n' > "$_t/a/doc/merged.sdn"; csm_seal_file "$_t/a/doc/merged.sdn" crc32 >/dev/null
    : > "$_t/a/doc/merged.crc32_00000001.csm"
    # MISSING: policy-listed, no sidecar
    printf 'bugs |id|\n    a\n' > "$_t/a/doc/listed.sdn"
    # unknown algorithm / wrong width fail closed
    printf 'bugs |id|\n    a\n' > "$_t/a/doc/unknown.sdn"; : > "$_t/a/doc/unknown.md5_cbf43926.csm"
    printf 'bugs |id|\n    a\n' > "$_t/a/doc/width.sdn"; : > "$_t/a/doc/width.crc32_cbf4.csm"
    # policy mismatch: sealed crc32, policy wants xxh3
    printf 'bugs |id|\n    a\n' > "$_t/a/doc/policy.sdn"; csm_seal_file "$_t/a/doc/policy.sdn" crc32 >/dev/null
    # wrong legacy header; orphan seal (data file absent)
    printf '#sdn-crc32:12345\nbugs |id|\n    z\n' > "$_t/a/doc/badold.sdn"
    : > "$_t/a/doc/gone.crc32_00000000.csm"
    _commit "$_t/a"
    _out=$(scan "$_t/a" HEAD); _rc=$?
    _expect a-verdict "$_rc" 1 "$_out" "FAIL — 8 sealed .sdn file(s) checked at HEAD, 8 stale:"
    for _w in "CORRUPT doc/corrupt.sdn" "MERGED_UNSEALED doc/merged.sdn" "MISSING seal for policy-listed doc/listed.sdn" \
              "CORRUPT doc/unknown.sdn: unknown algorithm" "CORRUPT doc/width.sdn: wrong digest width" \
              "RESEAL_NEEDED doc/policy.sdn" "CORRUPT doc/badold.sdn" "orphan seal (data file absent): doc/gone.sdn"; do
        case "$_out" in *"$_w"*) ;; *) echo "selftest FAIL a: missing report '$_w'"; _fails=$((_fails + 1)) ;; esac
    done

    # --- repo B: every accepted state; the verdict must be PASS
    _mk "$_t/b"; mkdir -p "$_t/b/doc" "$_t/b/config/check"
    printf 'seal_policy |glob, algo|
    doc/x3.sdn, xxh3
    doc/b3.sdn, blake3
    doc/*.sdn, crc32
' > "$_t/b/config/check/sdn_seal_policy.sdn"
    printf 'bugs |id|
    x
' > "$_t/b/doc/x3.sdn"; csm_seal_file "$_t/b/doc/x3.sdn" xxh3 >/dev/null
    printf 'bugs |id|
    x
' > "$_t/b/doc/b3.sdn"
    # blake3 needs b3sum or a deployed CLI; a runner has neither. The fixture is
    # then dropped (loudly) instead of failing the guard on a missing tool.
    _nb=6
    if csm_hasher_kat blake3 2>/dev/null; then csm_seal_file "$_t/b/doc/b3.sdn" blake3 >/dev/null
    else rm -f "$_t/b/doc/b3.sdn"; _nb=5; echo "selftest NOTE: blake3 fixture skipped (no b3sum / CLI hasher here)" >&2; fi
    printf 'bugs |id, status|\n    a, open\n' > "$_t/b/doc/good.sdn"; csm_seal_file "$_t/b/doc/good.sdn" crc32 >/dev/null
    printf 'bugs |id, status|\n    d, open\n' > "$_t/b/doc/unsealed.sdn"
    # CRLF content verifies against the LF seal
    printf 'bugs |id|\n    a\n' > "$_t/b/doc/crlf.sdn"; csm_seal_file "$_t/b/doc/crlf.sdn" crc32 >/dev/null
    printf 'bugs |id|\r\n    a\r\n' > "$_t/b/doc/crlf.sdn"
    # a merged file after reseal collapses to one seal
    printf 'bugs |id|\n    a\n' > "$_t/b/doc/resealed.sdn"; : > "$_t/b/doc/resealed.crc32_00000001.csm"
    csm_seal_file "$_t/b/doc/resealed.sdn" crc32 >/dev/null
    # valid legacy header: accepted with a note
    printf 'bugs |id|\n    a\n' > "$_t/b/body"
    _lc=$(gzip -c -n < "$_t/b/body" | tail -c 8 | head -c 4 | od -An -tu4 | tr -d ' \n')
    { printf '#sdn-crc32:%s\n' "$_lc"; cat "$_t/b/body"; } > "$_t/b/doc/legacy.sdn"; rm "$_t/b/body"
    # a header that is not on line 1 does not seal the file
    printf 'bugs |id|\n#sdn-crc32:5\n    a\n' > "$_t/b/doc/later.sdn"
    _commit "$_t/b"
    _out=$(scan "$_t/b" HEAD); _rc=$?
    _expect b-pass "$_rc" 0 "$_out" "PASS — $_nb sealed .sdn file(s) checked at HEAD, 0 stale"
    case "$_out" in *"note: doc/legacy.sdn still carries"*) ;; *) echo "selftest FAIL b: valid legacy header not accepted with a note"; _fails=$((_fails + 1)) ;; esac
    case "$_out" in *unsealed.sdn*|*later.sdn*) echo "selftest FAIL b: unsealed/body-header file reported"; _fails=$((_fails + 1)) ;; esac
    # the working copy must not decide
    printf 'bugs |id|\n    zzz\n' > "$_t/b/doc/good.sdn"
    _out=$(scan "$_t/b" HEAD); _rc=$?
    [ "$_rc" -eq 0 ] || { echo "selftest FAIL b2: uncommitted edit changed the verdict"; _fails=$((_fails + 1)); }

    # --- repo C: nothing sealed => ERROR, never a pass
    _mk "$_t/c"; printf 'bugs |id|\n    a\n' > "$_t/c/plain.sdn"; printf 'bugs |id|\n#sdn-crc32:5\n    a\n' > "$_t/c/later.sdn"; _commit "$_t/c"
    _out=$(scan "$_t/c" HEAD); _rc=$?
    _expect c-empty "$_rc" 2 "$_out" "ERROR — nothing was checked"

    # --- repo D: range mode. Drift outside the range is a NOTE, inside it a FAIL.
    _mk "$_t/d"; mkdir -p "$_t/d/doc" "$_t/d/config/check"
    printf 'seal_policy |glob, algo|\n    doc/*.sdn, crc32\n' > "$_t/d/config/check/sdn_seal_policy.sdn"
    printf 'bugs |id|\n    a\n' > "$_t/d/doc/ok.sdn"; csm_seal_file "$_t/d/doc/ok.sdn" crc32 >/dev/null
    printf 'bugs |id|\n    a\n' > "$_t/d/doc/drift.sdn"; csm_seal_file "$_t/d/doc/drift.sdn" crc32 >/dev/null
    printf 'bugs |id|\n    a\n    b\n' > "$_t/d/doc/drift.sdn"        # stale seal, committed in d1
    _commit "$_t/d"; _d1=$(git -C "$_t/d" rev-parse HEAD)
    printf 'x\n' > "$_t/d/unrelated.txt"; _commit "$_t/d"; _d2=$(git -C "$_t/d" rev-parse HEAD)
    _out=$(scan "$_t/d" HEAD "$_d1"); _rc=$?
    _expect d-note "$_rc" 0 "$_out" "NOTE drift (not in range): doc/drift.sdn"
    _expect d-pass "$_rc" 0 "$_out" "PASS — 2 sealed .sdn file(s) checked at HEAD (range $_d1..HEAD, 0 in range), 0 stale"
    _out=$(scan "$_t/d" HEAD); _rc=$?   # full mode still fails on the same tree
    _expect d-full "$_rc" 1 "$_out" "FAIL — 2 sealed .sdn file(s) checked at HEAD, 1 stale: doc/drift.sdn"
    # a range that touches the drifted .sdn fails, naming only it
    printf 'bugs |id|\n    a\n    b\n    c\n' > "$_t/d/doc/drift.sdn"; _commit "$_t/d"
    _out=$(scan "$_t/d" HEAD "$_d2"); _rc=$?
    _expect d-touched "$_rc" 1 "$_out" "FAIL — 2 sealed .sdn file(s) checked at HEAD (range $_d2..HEAD, 1 in range), 1 stale: doc/drift.sdn"
    # a range that changes ONLY a .csm sidecar maps back to its data file
    _d3=$(git -C "$_t/d" rev-parse HEAD)
    csm_seal_file "$_t/d/doc/drift.sdn" crc32 >/dev/null; rm -f "$_t/d/doc/ok".crc32_*.csm; : > "$_t/d/doc/ok.crc32_00000000.csm"; _commit "$_t/d"
    _out=$(scan "$_t/d" HEAD "$_d3"); _rc=$?
    _expect d-csm-only "$_rc" 1 "$_out" "CORRUPT doc/ok.sdn"
    case "$_out" in *"stale: doc/ok.sdn"*) ;; *) echo "selftest FAIL d-csm-only: resealed drift.sdn should be clean, ok.sdn corrupt only"; _fails=$((_fails + 1)) ;; esac
    # a changed policy puts every file in scope
    _d4=$(git -C "$_t/d" rev-parse HEAD)
    csm_seal_file "$_t/d/doc/ok.sdn" crc32 >/dev/null; printf 'bugs |id|\n    zz\n' > "$_t/d/doc/ok.sdn"
    printf 'seal_policy |glob, algo|\n    doc/*.sdn, crc32\n    doc/other.sdn, crc32\n' > "$_t/d/config/check/sdn_seal_policy.sdn"; _commit "$_t/d"
    _out=$(scan "$_t/d" HEAD "$_d4"); _rc=$?
    _expect d-policy "$_rc" 1 "$_out" "stale: doc/ok.sdn"
    _out=$(scan "$_t/d" HEAD "$_d4..bogus" 2>&1); _rc=$?
    _expect d-badbase "$_rc" 2 "$_out" "ERROR — nothing was checked"

    rm -rf "$_t"
    [ "$_fails" -eq 0 ] || { echo "selftest: $_fails fixture(s) failed"; return 1; }
    echo "selftest: 4 repos, 16 states + 7 range cases, 3 algorithms passed"
}

[ "$SKIP_SELFTEST" -eq 1 ] || selftest || { echo "ERROR — nothing was checked (selftest failed; the guard itself is not trustworthy)"; exit 2; }
if [ "$SELFTEST_ONLY" -eq 1 ]; then
    echo "PASS — 3 fixture repo(s) checked, selftest only"
    exit 0
fi
if [ -n "$RANGE" ]; then
    case "$RANGE" in *..*) REV=${RANGE#*..}; RANGE_BASE=${RANGE%%..*} ;; *) echo "ERROR — nothing was checked (--range needs <base>..<head>)"; exit 2 ;; esac
    [ -n "$REV" ] && [ -n "$RANGE_BASE" ] || { echo "ERROR — nothing was checked (--range needs <base>..<head>)"; exit 2; }
fi
[ -n "$REV" ] || { echo "ERROR — nothing was checked (--rev <sha> or --range <base>..<head> is required)"; exit 2; }
if [ -z "$ROOT" ]; then
    ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT=""
    [ -n "$ROOT" ] || { echo "ERROR — nothing was checked (not inside a git repository and no --root)"; exit 2; }
fi
scan "$ROOT" "$REV" "${RANGE_BASE:-}"
exit $?
