#!/bin/sh
# Local App Sandbox launch preflight. This does not qualify a container provider.
set -eu

if [ "$(uname -s)" != Darwin ]; then
    printf '%s\n' 'requires a macOS host' >&2
    exit 2
fi
if [ "$#" -ne 1 ] || [ ! -f "$1" ] || [ ! -r "$1" ] || [ -L "$1" ]; then
    printf '%s\n' 'usage: check-native-macos-simple-container-sandbox.shs HOST_SENTINEL_FILE' >&2
    exit 2
fi
case "$1" in
    /*) ;;
    *) printf '%s\n' 'host sentinel must be an absolute path' >&2; exit 2 ;;
esac

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
fixture="$repo_root/test/fixtures/native_macos_simple_container"
probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/simple-macos-sandbox.XXXXXX")
trap 'rm -rf "$probe_dir"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
sentinel_dir=$(dirname -- "$1")
sentinel_base=$(basename -- "$1")
sentinel=$(CDPATH= cd -- "$sentinel_dir" && pwd -P)/$sentinel_base
sentinel_identity=$(/usr/bin/stat -f '%d:%i:%z:%m' "$sentinel")
expected_control=$(printf 'PROBE_STARTED\nOPEN_STATUS=ALLOWED')
expected_denial=$(printf 'PROBE_STARTED\nOPEN_STATUS=DENIED')

/usr/bin/clang "$fixture/probe.c" -o "$probe_dir/probe"
cp "$probe_dir/probe" "$probe_dir/control"
baseline=$("$probe_dir/control" "$sentinel")
if [ "$baseline" != "$expected_control" ]; then
    printf '%s\n' 'control could not read the host sentinel' >&2
    exit 1
fi

/usr/bin/codesign --force --sign - \
    --identifier org.simple.codex.sandboxprobe \
    --entitlements "$fixture/sandbox.entitlements.plist" "$probe_dir/probe"
/usr/bin/codesign --verify --strict "$probe_dir/probe"

set +e
cli_output=$("$probe_dir/probe" "$sentinel" 2>&1)
cli_status=$?
set -e
printf 'signed CLI status: %s\n%s\n' "$cli_status" "$cli_output"
if [ "$("$probe_dir/control" "$sentinel")" != "$expected_control" ] ||
        [ "$(/usr/bin/stat -f '%d:%i:%z:%m' "$sentinel")" != "$sentinel_identity" ]; then
    printf '%s\n' 'host sentinel changed after signed CLI probe' >&2
    exit 1
fi

app="$probe_dir/Probe.app"
mkdir -p "$app/Contents/MacOS"
cp "$probe_dir/probe" "$app/Contents/MacOS/Probe"
cp "$fixture/Probe.Info.plist" "$app/Contents/Info.plist"
/usr/bin/codesign --force --sign - \
    --entitlements "$fixture/sandbox.entitlements.plist" "$app"
/usr/bin/codesign --verify --strict "$app"

set +e
app_output=$("$app/Contents/MacOS/Probe" "$sentinel" 2>&1)
app_status=$?
set -e
printf 'signed app status: %s\n%s\n' "$app_status" "$app_output"
if [ "$("$probe_dir/control" "$sentinel")" != "$expected_control" ] ||
        [ "$(/usr/bin/stat -f '%d:%i:%z:%m' "$sentinel")" != "$sentinel_identity" ]; then
    printf '%s\n' 'host sentinel changed after signed app probe' >&2
    exit 1
fi

if [ "$cli_status" -eq 0 ] && [ "$cli_output" = "$expected_denial" ]; then
    printf '%s\n' 'candidate CLI denial; verify actual sandbox state and workspace separately'
    exit 0
fi
if [ "$app_status" -eq 0 ] && [ "$app_output" = "$expected_denial" ]; then
    printf '%s\n' 'candidate app denial; verify actual sandbox state and workspace separately'
    exit 0
fi
printf '%s\n' 'no qualifying signed launch and host-sentinel denial observed' >&2
exit 1
