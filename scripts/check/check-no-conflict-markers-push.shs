#!/bin/sh
# Refuse to push literal conflict markers left in file CONTENT.
#
# scripts/check/check-no-conflict-tree-push.shs already blocks jj CONFLICT
# TREES (a commit whose git tree is only .jjconflict-base-0/.jjconflict-side-N/
# entries, real content absent). This script closes a different gap: a `jj
# rebase` can also inject literal conflict-marker TEXT into otherwise-normal
# file content, without the commit being tree-conflicted.
#
# This happened on 2026-07-30: a peer's rebase wrote conflict markers into the
# content of 38 tracked files, including the Rust seed file
# src/compiler_rust/runtime/src/value/mod.rs (inside a `pub use {...}` list),
# breaking every seed build with "unknown start of token" / "encountered diff
# marker". Two of the 38 were .spl files under src/compiler/. Had any of these
# been pushed, literal "<<<<<<< conflict" text would have landed on `main`.
# The tree-conflict guard would not have caught this — the trees were fine,
# only the content was corrupted.
#
# jj and git use different marker vocabularies; both are detected:
#   jj:  <<<<<<< conflict 1 of 2 / %%%%%%% diff from: ... / \\\\\\\ to: ... /
#        +++++++ <rev> (rebased revision) / >>>>>>> conflict 1 of 2 ends
#   git: <<<<<<< HEAD / ======= / >>>>>>> <branch>
#
# False-positive handling: legitimate files (this repo's own vcs.md, jj's
# vendored docs under src/compiler_rust/vendor/, bug reports describing THIS
# incident) may mention marker syntax in prose without containing a real
# conflict block. To avoid flagging those, a file is only flagged when it
# contains a MATCHING PAIR — both an open marker line (^<<<<<<< ) and a close
# marker line (^>>>>>>> ) — which prose mentions essentially never produce.
# If a genuine false positive ever shows up, add its path to ALLOWLIST below
# rather than weakening the pair requirement.
#
# Only the OUTGOING RANGE is scanned (files actually changed by commits being
# pushed) — never the whole working copy, which legitimately holds thousands
# of stale modified files from parallel sessions and would make this guard
# fire constantly.
#
# ---------------------------------------------------------------------------
# FAIL-CLOSED CONTRACT (added 2026-08-01 after two proved fail-opens)
# ---------------------------------------------------------------------------
# Two ways this guard used to report success without running:
#
#  1. CWD FAIL-OPEN. Run from a directory that is not a git repository — which
#     is exactly what the standard landing workflow produces, because agents
#     build in a `git archive` worktree under /dev/shm or /run/user/1000 with
#     no .git — every git call failed into an empty string and the script
#     printed "nothing to push in <range>" and exited 0, having checked
#     nothing. PROVED 2026-08-01 with marker fixture commit 432498ffa91: exit 1
#     from the repo root, exit 0 from an archived worktree.
#
#  2. FILENAME WORD-SPLITTING. The old loop was `for f in $changed_paths`, so a
#     path containing a SPACE was split into fragments; each fragment's
#     `git show` failed and the old `|| continue` silently skipped it. PROVED
#     2026-08-01: fixture commit 1071e9630ca adds a file named
#     "FIXTURE marked space.txt" with a matched marker pair, and the old guard
#     exited 0 — a clean PASS on a genuinely poisoned commit, FROM THE REPO
#     ROOT. Fixed by reading `git diff --name-status` line-by-line and by
#     turning an unreadable non-deleted path into a hard ERROR instead of a
#     skip.
#
# The rules now are:
#   * Every `git` invocation's exit status is checked. A git failure is an
#     ERROR (exit 2), never a clean result.
#   * cwd must be inside a git repository, and both range endpoints must exist
#     as commits in it. Otherwise: ERROR (exit 2).
#   * An EXPLICITLY SUPPLIED range that resolves to zero commits is a
#     contradiction and is an ERROR (exit 2), not a pass.
#   * A range with commits but zero changed paths cannot be meaningfully
#     verified: ERROR (exit 2).
#   * A changed path whose content cannot be read at the tip, and which was not
#     deleted, is an ERROR (exit 2) — never a silent skip.
#   * The verdict line names how many files were actually scanned, so a vacuous
#     run cannot be mistaken for a real one.
#
# NOTE ON PIPES: a piped exit status is the LAST command's, so `guard | tail`
# discards this script's status entirely. Redirect to a FILE and read the file.
# To limit the damage when that rule is forgotten, the final verdict line always
# goes to stdout and always begins with PASS:, FAIL: or ERROR:.
#
# Usage: check-no-conflict-markers-push.shs [rev-range]
#   default range: main@origin..@-   (what a `jj git push --bookmark main` sends)
#   An explicit range MUST contain ".." — a bare rev makes `git diff` compare
#   against the WORKING TREE, which is not what this guard is for.
# Exit 0 = safe to push, 1 = markers found, 2 = could not determine.

set -u

SELF=check-no-conflict-markers-push

# Pin grep: the interactive default on this machine is ugrep, not GNU grep.
GREP=grep
[ -x /usr/bin/grep ] && GREP=/usr/bin/grep

TAB=$(printf '\t')

TMPD=$(mktemp -d 2>/dev/null) || TMPD=""
cleanup() { [ -n "$TMPD" ] && rm -rf "$TMPD"; }
trap cleanup EXIT HUP INT TERM

die() {
    code=$1
    shift
    echo "$SELF: ERROR — $*" >&2
    echo "$SELF: ERROR — nothing was checked (exit $code)"
    exit "$code"
}

[ -n "$TMPD" ] || die 2 "cannot create a temporary directory (mktemp -d failed)"

# Paths to skip entirely even if they somehow contain a matching pair (e.g. a
# deliberate test fixture). One path per line — NOT space-separated, because
# tracked paths may contain spaces. Empty by default; add a path only with a
# comment explaining why it is legitimately allowed to contain markers.
ALLOWLIST=""

# Explicit, RECORDED per-push escape (added 2026-08-18, lane FPGUARD).
# `--allow <path>` (repeatable, must precede the range) exempts exactly one
# tracked path for exactly this run and NAMES it in the verdict line, following
# the `--expect-files <n>` / `--expect-removals <n>` precedent. It is
# path-scoped on purpose: a count-based escape here would wave through a real
# rebase-injected marker in some OTHER file, which is the whole failure this
# guard exists to catch. A path-scoped escape cannot.
# Proven false positive it exists for: a legitimate documentation page that
# SHOWS conflict-marker syntax in a fenced example (e.g. a "how to resolve a
# conflict" guide) has a matching open+close pair in committed content and is
# rejected identically to a poisoned source file. Reproducer:
#   doc/08_tracking/bug/pre_push_guard_false_positives_2026-08-18.md
CLI_ALLOW=""

while [ "${1:-}" = "--allow" ]; do
    shift
    [ "$#" -gt 0 ] || { echo "$SELF: ERROR — --allow needs a path" >&2; exit 2; }
    CLI_ALLOW="$CLI_ALLOW$1
"
    ALLOWLIST="$ALLOWLIST$1
"
    shift
done

range="${1:-}"
explicit=0
[ -n "$range" ] && explicit=1

# --- 1. cwd must be inside a git repository ---------------------------------
toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || toplevel=""
if [ -z "$toplevel" ]; then
    die 2 "cwd '$(pwd)' is not inside a git repository.
  This guard must run from the repo root of the clone you are about to push.
  A 'git archive' worktree under /dev/shm or /run/user/1000 has no .git and
  CANNOT be checked from — cd to the real clone and re-run."
fi
toplevel=$(CDPATH= cd -- "$toplevel" && pwd -P) || die 2 "cannot canonicalise toplevel"

# --- 2. cross-check: are we checking the repo this script ships in? ---------
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P) || script_dir=""
if [ -n "$script_dir" ]; then
    script_root=$(CDPATH= cd -- "$script_dir/../.." 2>/dev/null && pwd -P) || script_root=""
fi
if [ -n "${script_root:-}" ] && [ "$script_root" != "$toplevel" ]; then
    if [ -e "$script_root/.git" ]; then
        die 2 "repository mismatch.
  This script lives in the git repo at: $script_root
  but cwd resolves to the git repo at:  $toplevel
  Refusing to report on a different repository than the one being guarded."
    fi
    echo "$SELF: WARNING — script at $script_dir is outside the repo being checked ($toplevel)" >&2
fi

# --- 3. resolve the range, fail closed -------------------------------------
if [ "$explicit" -eq 0 ]; then
    base=$(jj --ignore-working-copy log -r 'main@origin' --no-graph -T 'commit_id' 2>/dev/null) || base=""
    tip=$(jj --ignore-working-copy log -r '@-' --no-graph -T 'commit_id' 2>/dev/null) || tip=""
    if [ -z "$base" ] || [ -z "$tip" ]; then
        die 2 "cannot resolve main@origin..@- via jj (is jj available and is this a jj workspace?).
  Pass an explicit range instead, e.g. $SELF '<base-sha>..<tip-sha>'."
    fi
    range="$base..$tip"
else
    case "$range" in
        *..*) : ;;
        *) die 2 "explicit range '$range' does not contain '..'.
  A bare revision makes 'git diff' compare against the WORKING TREE, which is
  not what this guard is for. Pass '<base>..<tip>'." ;;
    esac
fi

# --- 4. both endpoints must exist as commits in THIS repo ------------------
left=${range%%..*}
right=${range#*..}
right=${right#.}          # tolerate the A...B form
[ -n "$left" ]  || die 2 "range '$range' has an empty left endpoint"
[ -n "$right" ] || die 2 "range '$range' has an empty right endpoint"
for ep in "$left" "$right"; do
    git rev-parse --verify --quiet "$ep^{commit}" >/dev/null 2>&1 \
        || die 2 "revision '$ep' (from range '$range') does not exist in the repository at $toplevel.
  Either you are in the wrong clone, or the commit was never fetched here."
done

# --- 5. enumerate the range, checking git's exit status --------------------
git rev-list "$range" > "$TMPD/revs" 2>/dev/null
rl=$?
[ "$rl" -eq 0 ] || die 2 "git rev-list '$range' failed with status $rl"

ncommits=$(wc -l < "$TMPD/revs" | tr -d ' ')
if [ "$ncommits" -eq 0 ]; then
    if [ "$explicit" -eq 1 ]; then
        die 2 "explicit range '$range' resolved to 0 commits.
  You asked this guard to check a range and there is nothing in it. That is a
  caller error (wrong base, wrong tip, or endpoints already equal) — it is NOT
  a clean result, so it is reported as a failure rather than a pass."
    fi
    echo "$SELF: NOTHING TO PUSH — $range is empty; NO FILES WERE CHECKED"
    exit 0
fi

# git rev-list lists newest first, so the first line is the range tip — the
# state that actually gets pushed. Take it from the verified right endpoint
# instead of trusting the ordering.
tip=$(git rev-parse --verify --quiet "$right^{commit}") \
    || die 2 "cannot resolve range tip '$right'"

is_allowlisted() {
    [ -n "$ALLOWLIST" ] || return 1
    printf '%s\n' "$ALLOWLIST" | "$GREP" -qxF -- "$1"
}

# --- 6. collect changed paths, NUL-safe against spaces in filenames --------
# --no-renames keeps every record to exactly "<status><TAB><path>", so a path
# containing spaces survives intact when read as the rest of the line.
# core.quotePath=false stops git from octal-escaping non-ASCII names.
git -c core.quotePath=false diff --name-status --no-renames "$range" -- \
    > "$TMPD/paths" 2>/dev/null
dl=$?
[ "$dl" -eq 0 ] || die 2 "git diff --name-status '$range' failed with status $dl"

nlines=$(wc -l < "$TMPD/paths" | tr -d ' ')
if [ "$nlines" -eq 0 ]; then
    die 2 "range '$range' contains $ncommits commit(s) but 0 changed paths.
  Nothing could be scanned, so this guard cannot vouch for the push. If the
  commits really are empty, they should not be pushed either."
fi

found=0
scanned=0
exempted=0
skipped_deleted=0

while IFS= read -r line; do
    [ -n "$line" ] || continue
    status=${line%%"$TAB"*}
    path=${line#*"$TAB"}
    case "$status" in
        D*) skipped_deleted=$((skipped_deleted + 1)); continue ;;
    esac
    if is_allowlisted "$path"; then
        exempted=$((exempted + 1))
        continue
    fi
    if ! git show "$tip:$path" > "$TMPD/content" 2>"$TMPD/showerr"; then
        die 2 "cannot read '$path' at $tip (status was '$status', so it is not a deletion).
  A path that cannot be read cannot be cleared. Refusing to pass.
  git said: $(head -1 "$TMPD/showerr" 2>/dev/null)"
    fi
    scanned=$((scanned + 1))
    # jj picks a marker LENGTH per file (>=7) so the markers cannot collide with
    # the content being wrapped -- a materialized conflict is routinely 10 chars
    # (`<<<<<<<<<< Conflict 1 of 1`). The old fixed-width `^<<<<<<< ` required a
    # space at column 8 and so silently missed every marker longer than 7. That
    # is not hypothetical: .spipe/scv-remaining/impl_ws_a.md reached origin with
    # a 10-char pair while this guard reported clean (found 2026-08-02).
    #
    # The label is optional too. `git merge-file -L '' -L '' -L ''` emits
    # "<<<<<<< " / ">>>>>>> " -- marker, space, EMPTY label -- and any
    # trailing-whitespace strip (every formatter, this repo's own fmt/lint, most
    # editors on save) turns those into a bare "<<<<<<<" / ">>>>>>>". PROVED
    # 2026-08-02: the pre-strip block matched, the post-strip block did not, so a
    # real conflict block survived a formatter and became invisible. Requiring a
    # space at the end of the run was the same fixed-shape mistake as requiring
    # it at column 8.
    #
    # `^<{7,}( |$)` accepts >=7 markers followed by a space OR end of line, and
    # still rejects a shorter run and a run glued to other text ("<<<<<<<x").
    # Measured across all 109,516 files of the tree at 4834c449124: zero files
    # gain a matching pair from the relaxation, so it costs no false positive.
    open_lines=$("$GREP" -nE '^<{7,}( |$)' "$TMPD/content" 2>/dev/null)
    close_lines=$("$GREP" -nE '^>{7,}( |$)' "$TMPD/content" 2>/dev/null)
    if [ -n "$open_lines" ] && [ -n "$close_lines" ]; then
        echo "CONFLICT MARKERS: $path" >&2
        printf '%s\n' "$open_lines" | while IFS=: read -r ln _; do
            echo "  open  line $ln" >&2
        done
        printf '%s\n' "$close_lines" | while IFS=: read -r ln _; do
            echo "  close line $ln" >&2
        done
        found=1
    fi
done < "$TMPD/paths"

# Verdict suffix that RECORDS any escape actually used, so a passing run can
# never hide the fact that a path was exempted.
allow_note=""
if [ -n "$CLI_ALLOW" ]; then
    allow_note=", $(printf '%s' "$CLI_ALLOW" | "$GREP" -c . ) path(s) exempted by explicit --allow: $(printf '%s' "$CLI_ALLOW" | tr '\n' ' ' | sed 's/ $//')"
fi

if [ "$scanned" -eq 0 ]; then
    # Still fail closed when the zero came from anything OTHER than paths the
    # caller named on the command line for this run.
    if [ "$exempted" -eq 0 ] || [ -z "$CLI_ALLOW" ] || [ "$exempted" -ne "$(printf '%s' "$CLI_ALLOW" | "$GREP" -c .)" ]; then
        die 2 "range '$range' changed $nlines path(s) but 0 were scanned
  ($skipped_deleted deletion(s), the rest allowlisted). Nothing was verified."
    fi
    echo "$SELF: PASS — 0 file(s) scanned at $tip across $ncommits commit(s) in $range$allow_note (repo $toplevel)"
    exit 0
fi

if [ "$found" -ne 0 ]; then
    # Working-copy-conflict tripwire (added 2026-08-11, see
    # doc/08_tracking/bug/conflict_markers_reported_at_origin_were_working_copy_only_2026-08-11.md):
    # every marker match above came from `git show "$tip:$path"` — COMMITTED
    # content only, never the working tree — so this guard cannot itself
    # confuse a stalled local cherry-pick for a poisoned commit. But a human
    # reading this FAIL and about to blame the SHA in $tip needs that ruled
    # out explicitly, because a separate, unrelated stalled cherry-pick in
    # THIS working copy produces near-identical-looking marker text and was
    # mistaken for an origin defect on 2026-08-11. Report the working-copy
    # conflict state here so that confusion cannot happen silently again.
    cph="no"; [ -f "$toplevel/.git/CHERRY_PICK_HEAD" ] && cph="yes"
    mh="no"; [ -f "$toplevel/.git/MERGE_HEAD" ] && mh="yes"
    unmerged=$(git -C "$toplevel" ls-files -u 2>/dev/null | wc -l | tr -d ' ')
    echo "$SELF: working-copy-conflict-state CHERRY_PICK_HEAD=$cph MERGE_HEAD=$mh unmerged_index_entries=$unmerged (0/no/no = working copy is clean; a nonzero/yes value here means a LOCAL, uncommitted conflict exists and the FAIL below must not be blamed on \$tip=$tip without first checking whether it is that local state, not $tip's committed content, that is poisoned)" >&2
    cat >&2 <<'EOF'

DO NOT PUSH. The files above contain literal conflict-marker text from an
unresolved (or badly resolved) jj rebase. Resolve the conflict properly —
do not just delete the marker lines, verify the surrounding code is correct —
then re-check:
  jj resolve --list
  jj log -r 'roots(conflicts())'    # resolve the ROOT, descendants auto-rebase
EOF
    echo "$SELF: FAIL — conflict markers found in $range ($scanned file(s) scanned$allow_note)"
    exit 1
fi

echo "$SELF: PASS — $scanned file(s) scanned at $tip across $ncommits commit(s) in $range, 0 conflict markers$allow_note (repo $toplevel)"
exit 0
