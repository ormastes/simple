#!/bin/sh
# Scoped C-oracle parity, decision evidence, and native build/link guards for
# the 22-function Cosmos MMU/cache policy migration.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
SOURCE_DIR="$ROOT/src/os/kernel/arch/arm32/cosmos"
TEST_DIR="$ROOT/test/02_integration/os/cosmos"
SIMPLE_SOURCE="$SOURCE_DIR/cosmos_mmu_cache_policy.spl"
SIMPLE_HEADER="$SOURCE_DIR/cosmos_mmu_cache_policy.h"
C_OWNER="$SOURCE_DIR/cosmos_mmu_cache.c"
UNIT_SPEC="$ROOT/test/01_unit/os/arch/arm32/cosmos_mmu_cache_policy_spec.spl"
EVIDENCE_DIR="$ROOT/build/coverage/cosmos-mmu-cache-policy"
SCRATCH=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-mmu-cache-policy.XXXXXX")
trap 'case ${SCRATCH:-} in /tmp/cosmos-mmu-cache-policy.*|${TMPDIR:-/tmp}/cosmos-mmu-cache-policy.*) [ ! -d "$SCRATCH" ] || rm -r -- "$SCRATCH" ;; esac' EXIT HUP INT TERM

fail() {
    echo "FAIL cosmos-mmu-cache-policy: $*" >&2
    exit 1
}

pick_llvm_toolchain() {
    for version in 20 19 18; do
        if command -v "clang-$version" >/dev/null 2>&1; then
            CLANG="clang-$version"
            return
        fi
    done
    fail "clang 18 or newer is required"
}

expected_exports='cosmos_mmu_cache_policy_cache_enable_allowed
cosmos_mmu_cache_policy_cache_setway_operand
cosmos_mmu_cache_policy_cache_way_shift
cosmos_mmu_cache_policy_coarse_descriptor
cosmos_mmu_cache_policy_control_policy_contract
cosmos_mmu_cache_policy_control_registers_valid
cosmos_mmu_cache_policy_device_section
cosmos_mmu_cache_policy_firmware_l2_descriptor_for_address
cosmos_mmu_cache_policy_l1_descriptor_for_address
cosmos_mmu_cache_policy_l2_descriptor_executable
cosmos_mmu_cache_policy_l2_descriptor_priv_writable
cosmos_mmu_cache_policy_l2_descriptor_write_execute
cosmos_mmu_cache_policy_mmu_poll_allowed
cosmos_mmu_cache_policy_ocm_l2_descriptor_for_address
cosmos_mmu_cache_policy_sctlr_apply_policy
cosmos_mmu_cache_policy_sctlr_policy_valid
cosmos_mmu_cache_policy_scu_invalidate_mask
cosmos_mmu_cache_policy_section_descriptor
cosmos_mmu_cache_policy_small_page_cached_rw_xn_descriptor
cosmos_mmu_cache_policy_small_page_cached_rx_descriptor
cosmos_mmu_cache_policy_small_page_descriptor
cosmos_mmu_cache_policy_ttbr0_value'
expected_c_imports='cosmos_mmu_cache_policy_cache_enable_allowed
cosmos_mmu_cache_policy_cache_setway_operand
cosmos_mmu_cache_policy_cache_way_shift
cosmos_mmu_cache_policy_coarse_descriptor
cosmos_mmu_cache_policy_control_policy_contract
cosmos_mmu_cache_policy_control_registers_valid
cosmos_mmu_cache_policy_firmware_l2_descriptor_for_address
cosmos_mmu_cache_policy_l1_descriptor_for_address
cosmos_mmu_cache_policy_l2_descriptor_write_execute
cosmos_mmu_cache_policy_mmu_poll_allowed
cosmos_mmu_cache_policy_ocm_l2_descriptor_for_address
cosmos_mmu_cache_policy_sctlr_apply_policy
cosmos_mmu_cache_policy_scu_invalidate_mask
cosmos_mmu_cache_policy_section_descriptor
cosmos_mmu_cache_policy_small_page_cached_rw_xn_descriptor
cosmos_mmu_cache_policy_small_page_cached_rx_descriptor
cosmos_mmu_cache_policy_small_page_descriptor
cosmos_mmu_cache_policy_ttbr0_value'

mkdir -p "$EVIDENCE_DIR"
pick_llvm_toolchain
READELF=${READELF:-readelf}

# The frozen C contract/oracle path must remain standalone and must not silently
# resolve through the new Simple implementation.
"$CLANG" -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow \
    -Wconversion -Wstrict-prototypes -DCOSMOS_CONTRACT_TEST \
    -I"$SOURCE_DIR" \
    "$TEST_DIR/cosmos_mmu_cache_contract_bridge_test.c" "$C_OWNER" \
    -o "$SCRATCH/c-contract"
"$SCRATCH/c-contract" > "$EVIDENCE_DIR/c-contract.out"
"$CLANG" -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow \
    -Wconversion -Wstrict-prototypes -I"$SOURCE_DIR" -I"$TEST_DIR" \
    -c "$TEST_DIR/cosmos_mmu_cache_policy_oracle.c" \
    -o "$SCRATCH/c-oracle.o"

# Production C must import policy and retain CP15/MMIO ownership. This guard is
# useful even when Stage 4 is absent; native Simple emission below still fails
# closed without admitted provenance.
"$CLANG" --target=armv7-none-eabi -mcpu=cortex-a9 -marm -ffreestanding \
    -nostdlib -fno-builtin -Wall -Wextra -Werror -DCOSMOS_SILICON=1 \
    -include "$SOURCE_DIR/cosmos_profile_openssd2_8ch8way_v300.h" \
    -O2 -c "$C_OWNER" -o "$SCRATCH/cosmos_mmu_cache.o"
c_imports=$(
    "$READELF" -sW "$SCRATCH/cosmos_mmu_cache.o" |
        awk '$7 == "UND" && $8 ~ /^cosmos_mmu_cache_policy_/ { print $8 }' |
        LC_ALL=C sort -u
)
[ "$c_imports" = "$expected_c_imports" ] ||
    fail "production C does not import the exact 18-function policy closure"

SIMPLE_BIN=${SIMPLE_BIN:-$ROOT/bin/simple}
[ -x "$SIMPLE_BIN" ] || fail "missing executable pure-Simple compiler"
BOOTSTRAP_STAGE3_FACADE_PATH="$ROOT/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="$ROOT/scripts/check/lib/stage4-candidate-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"
SIMPLE_CANONICAL=$(bootstrap_stage3_canonical_file "$SIMPLE_BIN") ||
    fail "admitted Stage-4 compiler binary/provenance is required; candidate cannot be resolved"
SIMPLE_PROVENANCE=${SIMPLE_PROVENANCE:-${SIMPLE_CANONICAL}.provenance.env}
stage4_verify_candidate_provenance \
    "$SIMPLE_PROVENANCE" "$SIMPLE_CANONICAL" "$ROOT" ||
    fail "admitted Stage-4 provenance is required for native integration"
case $($SIMPLE_CANONICAL --version 2>&1 || true) in
    *"Rust-built Simple binary is a bootstrap seed"*)
        fail "a bootstrap seed cannot prove native policy integration" ;;
esac

SIMPLE_LIB="$ROOT/src" "$SIMPLE_CANONICAL" native-build \
    --backend llvm --source "$SOURCE_DIR" --entry-closure \
    --entry "$SIMPLE_SOURCE" --target x86_64-unknown-linux-gnu \
    --emit-object --no-mangle --cache-dir "$SCRATCH/host-cache" \
    -o "$SCRATCH/cosmos_mmu_cache_policy_host.o"
host_symbols=$($READELF -sW "$SCRATCH/cosmos_mmu_cache_policy_host.o")
source_exports=$(
    sed -n 's/^[[:space:]]*@export("C", name: "\([^"]*\)").*/\1/p' \
        "$SIMPLE_SOURCE" | LC_ALL=C sort -u
)
[ "$source_exports" = "$expected_exports" ] ||
    fail "pure-Simple source does not declare exactly the 22 policy exports"
printf '%s\n' "$expected_exports" | while IFS= read -r symbol; do
    printf '%s\n' "$host_symbols" |
        awk -v symbol="$symbol" \
            '$4 == "FUNC" && $5 == "GLOBAL" && $7 != "UND" &&
             $8 == symbol { count++ } END { exit count != 1 }' ||
        fail "missing or duplicate pure-Simple policy export: $symbol"
done
host_undefined=$(
    printf '%s\n' "$host_symbols" |
        awk '$7 == "UND" && $8 != "" { print $8 }' | LC_ALL=C sort -u
)
[ -z "$host_undefined" ] || fail "host policy object has runtime dependencies: $host_undefined"

"$CLANG" -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow \
    -Wconversion -Wstrict-prototypes -I"$SOURCE_DIR" -I"$TEST_DIR" \
    "$TEST_DIR/cosmos_mmu_cache_policy_oracle.c" \
    "$TEST_DIR/cosmos_mmu_cache_policy_parity_test.c" \
    "$SCRATCH/cosmos_mmu_cache_policy_host.o" \
    -o "$SCRATCH/parity"
"$SCRATCH/parity" > "$EVIDENCE_DIR/c-oracle-parity.out"
parity_cases=$(awk '$1 == "COSMOS_MMU_C_ORACLE_PARITY_CASES" { print $2 }' \
    "$EVIDENCE_DIR/c-oracle-parity.out")
[ "$parity_cases" = 2829 ] || fail "unexpected parity case count: $parity_cases"

SIMPLE_LIB="$ROOT/src" "$SIMPLE_CANONICAL" test "$UNIT_SPEC" \
    --quick --no-limits --no-session-daemon \
    > "$EVIDENCE_DIR/simple-decisions.out" 2>&1 ||
    fail "pure-Simple policy spec failed"
grep -Fq 'COSMOS_MMU_SIMPLE_DECISIONS 37/37 outcomes=74/74' \
    "$EVIDENCE_DIR/simple-decisions.out" ||
    fail "37 named Simple decisions did not record all 74 outcomes"

SIMPLE_LIB="$ROOT/src" "$SIMPLE_CANONICAL" native-build \
    --backend llvm --source "$SOURCE_DIR" --entry-closure \
    --entry "$SIMPLE_SOURCE" --target armv7-unknown-none-eabi \
    --emit-object --no-mangle --cache-dir "$SCRATCH/arm-cache" \
    -o "$SCRATCH/cosmos_mmu_cache_policy_arm.o"
arm_header=$($READELF -hW "$SCRATCH/cosmos_mmu_cache_policy_arm.o")
printf '%s\n' "$arm_header" | grep -Eq 'Class:[[:space:]]+ELF32' &&
    printf '%s\n' "$arm_header" | grep -Eq 'Machine:[[:space:]]+ARM' ||
    fail "native policy object is not ELF32 ARM"
arm_symbols=$($READELF -sW "$SCRATCH/cosmos_mmu_cache_policy_arm.o")
arm_undefined=$(
    printf '%s\n' "$arm_symbols" |
        awk '$7 == "UND" && $8 != "" { print $8 }' | LC_ALL=C sort -u
)
[ -z "$arm_undefined" ] || fail "ARM policy object has runtime dependencies: $arm_undefined"
ld.lld -r "$SCRATCH/cosmos_mmu_cache.o" \
    "$SCRATCH/cosmos_mmu_cache_policy_arm.o" -o "$SCRATCH/mmu-policy-linked.o"
linked_policy_undefined=$(
    "$READELF" -sW "$SCRATCH/mmu-policy-linked.o" |
        awk '$7 == "UND" && $8 ~ /^cosmos_mmu_cache_policy_/ { print $8 }'
)
[ -z "$linked_policy_undefined" ] ||
    fail "production C-to-Simple policy link is unresolved"

receipt="$EVIDENCE_DIR/receipt.sdn"
{
    echo "schema=cosmos-mmu-cache-policy-evidence-v1"
    echo "claim_scope=cosmos-mmu-cache-pure-policy-and-c-hardware-boundary-only"
    echo "whole_hal_claim=false"
    echo "board_evidence=separate-not-included"
    echo "pure_policy_function_count=22"
    echo "c_oracle_parity_cases=$parity_cases"
    echo "simple_named_decisions=37"
    echo "simple_decision_outcomes_hit=74"
    echo "simple_decision_outcomes_total=74"
    echo "native_target=armv7-unknown-none-eabi"
    echo "native_link_guard=pass"
    echo "stage4_provenance=$SIMPLE_PROVENANCE"
    echo "simple_source_sha256=$(sha256sum "$SIMPLE_SOURCE" | awk '{print $1}')"
    echo "c_owner_sha256=$(sha256sum "$C_OWNER" | awk '{print $1}')"
    echo "c_oracle_sha256=$(sha256sum "$TEST_DIR/cosmos_mmu_cache_policy_oracle.c" | awk '{print $1}')"
} > "$receipt"

echo "cosmos_mmu_cache_policy_exports=22/22"
echo "cosmos_mmu_cache_c_oracle_parity_cases=$parity_cases"
echo "cosmos_mmu_cache_simple_decisions=37/37 outcomes=74/74"
echo "cosmos_mmu_cache_native_link=pass"
echo "cosmos_mmu_cache_whole_hal_claim=false"
echo "cosmos_mmu_cache_receipt=$receipt"
echo "STATUS: PASS cosmos-mmu-cache pure-policy migration"
