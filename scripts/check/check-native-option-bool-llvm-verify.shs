#!/bin/sh
# Regression gate for AOT (`native-build`) LLVM legality of a bool value
# crossing a `ptr`-typed ABI boundary (Option<bool> boxing).
#
# WHY THIS EXISTS: `bin/simple test` hard-defaults to the tree-walk interpreter
# and has no AOT mode, so a spec can only ever prove the interpreter lane.
# Only a script that actually drives `native-build` (and the real LLVM
# verifier) can fence the AOT lane.
#
# Bug: doc/08_tracking/bug/llvm_bool_bitcast_to_ptr_invalid_ir_2026-08-03.md
# ("LLVM shard emits invalid `bitcast i1 ... to ptr`" -- FIXED 2026-08-03,
# widens i1 -> native int -> inttoptr instead of the illegal bare bitcast).
# That fix was "verified only once, no fixture" per
# doc/09_report/infra/aot_lane_regression_fence_audit_2026-08-07.md (row 7).
#
# SCOPE NOTE: the fixture (test/fixtures/native_option_bool_llvm_verify/main.spl)
# is a real bool-crossing-a-ptr-boundary AOT case (Option<bool> boxing via
# rt_enum_new), but it does NOT force the *exact* `i1 -> ptr` bitcast MIR
# shape -- confirmed by inspecting the emitted IR: rt_enum_new's boxing call
# accepts an `i1` payload argument directly, so no value_as_type(_, "i1",
# "ptr") coercion is requested here. That EXACT positive-emission scenario is
# fenced directly (and exists already; the audit's "no fixture" claim for row
# 7 was wrong) at
# test/01_unit/compiler/backend/llvm_bitcast_pointer_bool_spec.spl, which
# synthesizes the i1-local/ptr-return-type shape via MirToLlvm's test-only
# visibility and string-matches the emitted zext/inttoptr instructions and
# the absence of `bitcast i1 ... to ptr`. What that spec does NOT do is run
# the emitted module through the real LLVM verifier -- it only string-matches
# the IR text. This script closes that gap for the bool/ptr-crossing family:
#   1. native-build succeeds WITH the real LLVM verifier enabled
#      (SIMPLE_LLVM_BITCODE_DEBUG=1 -> llvm-as + `opt -passes=verify` on the
#      actual emitted module, not a hand-written stand-in) -- the module is
#      legal LLVM, not just legal-looking text.
#   2. the resulting binary's stdout matches the interpreter reference.
#   3. tripwire (not positive coverage -- see scope note): the dumped .ll
#      contains zero occurrences of the illegal `bitcast i1 ... to ptr`
#      shape. If this ever regresses to firing that shape, the verifier in
#      (1) would ALSO already have failed the build; this is redundant-by-
#      design defense in depth on the literal instruction pattern.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

SIMPLE_BINARY="${SIMPLE_BINARY:-bin/simple}"
WORK_DIR="${WORK_DIR:-/tmp/check-native-option-bool-llvm-verify.$$}"
FIXTURE="test/fixtures/native_option_bool_llvm_verify/main.spl"

test -x "$SIMPLE_BINARY"
mkdir -p "$WORK_DIR"
trap 'rm -rf "$WORK_DIR"' EXIT HUP INT TERM

fail=0

# --- Tool availability: llvm-as/opt/llc must exist, or this gate cannot run.
for tool in llvm-as opt llc; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "NOTE — $tool not found; SIMPLE_LLVM_BITCODE_DEBUG verifier path"
        echo "       cannot run on this host. This gate is SKIPPED, not"
        echo "       passing -- do not treat a skip as a green regression"
        echo "       check. Install LLVM (apt install llvm) to enable it."
        # exit 2, NOT 0: the text above says "SKIPPED, not passing" while an
        # exit 0 tells every caller and CI aggregator the opposite. The exit
        # code is the only part a gate consumer reads.
        exit 2
    fi
done

# --- Sabotage-mechanism proof: confirm llvm-as itself rejects the historical
# illegal shape, so a build failure below is known to be a real signal and
# not a tooling accident.
bad_ll="$WORK_DIR/bad_shape.ll"
cat > "$bad_ll" <<'BADEOF'
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define ptr @bitcast_return(i1 %l0) nounwind {
bb0:
  %t1 = bitcast i1 %l0 to ptr
  ret ptr %t1
}
BADEOF
if llvm-as "$bad_ll" -o "$WORK_DIR/bad_shape.bc" >"$WORK_DIR/bad_shape.log" 2>&1; then
    echo "FAIL — llvm-as unexpectedly ACCEPTED the historical illegal"
    echo "       'bitcast i1 ... to ptr' shape; the verifier mechanism this"
    echo "       gate relies on is not doing what we think it does."
    sed -n '1,20p' "$WORK_DIR/bad_shape.log"
    fail=1
elif ! grep -q "invalid cast opcode for cast from 'i1' to 'ptr'" "$WORK_DIR/bad_shape.log"; then
    echo "FAIL — llvm-as rejected the bad shape for an UNEXPECTED reason"
    echo "       (expected the classic 'invalid cast opcode' diagnostic):"
    sed -n '1,20p' "$WORK_DIR/bad_shape.log"
    fail=1
fi

# --- Build the real fixture through native-build with the LLVM verifier on.
binary="$WORK_DIR/option-bool"
build_log="$WORK_DIR/build.log"
if ! env -u SIMPLE_BOOTSTRAP SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LLVM_BITCODE_DEBUG=1 \
    "$SIMPLE_BINARY" native-build \
    --source test/fixtures --entry-closure --entry "$FIXTURE" \
    --cache-dir "$WORK_DIR/cache" --output "$binary" >"$build_log" 2>&1; then
    echo "FAIL — native-build failed with the LLVM verifier enabled"
    echo "       (SIMPLE_LLVM_BITCODE_DEBUG=1); either a real IR-legality"
    echo "       regression or an environment problem. Log tail:"
    tail -n 40 "$build_log"
    exit 1
fi

ir_path="$(sed -n 's/^\[llvm-bitcode-debug\] ir //p' "$build_log" | tail -1)"
if [ -z "$ir_path" ] || [ ! -f "$ir_path" ]; then
    echo "FAIL — build succeeded but no '[llvm-bitcode-debug] ir <path>' line"
    echo "       was found in the log (or the file is gone); cannot confirm"
    echo "       the verifier actually ran against this fixture's module."
    tail -n 40 "$build_log"
    exit 1
fi
echo "PASS — native-build succeeded WITH the real LLVM verifier"
echo "       (llvm-as + opt -passes=verify) on the emitted module: $ir_path"

# --- Runtime output must match the interpreter reference.
out="$(timeout 20 "$binary" 2>>"$build_log")"
expected="$(printf 'a: match\nb: match')"
if [ "$out" != "$expected" ]; then
    echo "FAIL — native-build Option<bool> output regressed"
    echo "  expected: $expected"
    echo "  actual:   $out"
    fail=1
else
    echo "PASS — native-build Option<bool> output matches interpreter reference"
fi

# --- Tripwire (defense in depth, not positive coverage -- see header).
if grep -Eq 'bitcast[[:space:]]+i1[[:space:]].*to[[:space:]]+ptr' "$ir_path"; then
    echo "FAIL — emitted IR contains the illegal 'bitcast i1 ... to ptr'"
    echo "       shape directly (the verifier above should have already"
    echo "       failed the build first; seeing this means the negative"
    echo "       tripwire caught something the verifier step did not, which"
    echo "       is itself worth investigating):"
    grep -n 'bitcast' "$ir_path" | head -5
    fail=1
else
    echo "PASS — no illegal 'bitcast i1 ... to ptr' in emitted IR"
fi

if [ "$fail" -ne 0 ]; then
    exit 1
fi

echo "PASS — native-build option-bool LLVM verify gate: module legal, output correct, no illegal bitcast"
