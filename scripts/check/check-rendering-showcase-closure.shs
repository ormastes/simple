#!/bin/sh
# check-rendering-showcase-closure.shs — NFR-001 loading-overhead census for
# the rendering showcases (doc/02_requirements/nfr/rendering_showcases.md).
#
# For each lane pair (tui/gui/wm core|full, 2d/web core|extended) under
# examples/06_io/ui/rendering/, compute the transitive module-closure count of
# the core/brief entry and of its full/extended sibling, print both counts and
# the ratio, and fail the gate when any ratio exceeds 0.60.
#
# Mechanism (union census, fail-closed):
#   closure(entry) = deps_fast_paths(entry) ∪ static_use_closure(entry)
#
#   1. `bin/simple deps fast <entry>` — the seed's dependency listing (same
#      closure source as scripts/check/check-ui-slim-closure.shs). It knows
#      resolver semantics the static scan cannot see, BUT under the current
#      Rust seed it silently drops import edges for these showcase entries
#      (a full-tier closure comes out identical to its core sibling modulo
#      the entry file itself — the deps_fast dropped-edge defect class in
#      doc/08_tracking/bug/deps_fast_ignores_bare_tier_rooted_imports_2026-09-05.md),
#      so it cannot be trusted alone.
#   2. Static transitive closure: parse every closure file's top-level
#      `use A.B.C`, `use .relative`, `import sibling`, and `export use A.B.*`
#      lines (comments and """ docstrings stripped), resolve dotted module
#      names against SIMPLE_LIB=src roots plus the examples/ tree — including
#      the dotted-directory package forms from the canonical resolver
#      (src/compiler_rust/compiler/src/pipeline/module_loader.rs) — and BFS
#      until fixpoint.
#   A `use`d module with no on-disk candidate is BLOCKED unless its name
#   appears in the deps fast output (which may know resolver forms this gate
#   does not); fail-closed, never a blind PASS.
#
# Proxy limits (honest):
#   - Counts module FILES, not symbols, bytecode size, or compile time; a lane
#     with few huge modules could game the ratio. Complement with the NFR-002
#     capture gate for end-to-end evidence.
#   - The closure is static: conditionally-used imports count even when a
#     given run never exercises them (standard for import-closure gates).
#   - `bin/simple` is the Rust seed (bootstrap warning expected); `deps fast`
#     failing entirely is BLOCKED (the static arm alone cannot prove it is
#     complete for these entries).
#
# Context: doc/03_plan/sys_test/rendering_showcases.md "Runtime gates" and
# doc/05_design/rendering_showcases.md. Style follows
# scripts/check/check-ui-slim-closure.shs (POSIX sh, BSD-tool portable, no
# readlink -f, no grep -P, verdict as the LAST stdout line).
#
# Verdict is ALWAYS the LAST stdout line:
#   STATUS: PASS     — every lane ratio <= 0.60                       exit 0
#   STATUS: FAIL     — >= 1 lane ratio > 0.60 (names the lanes)       exit 1
#   STATUS: BLOCKED  — entry unreadable / census arm failed (why)     exit 2
#
# Usage:
#   sh scripts/check/check-rendering-showcase-closure.shs

set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
cd "$ROOT" || { echo "STATUS: BLOCKED — cannot cd to repo root"; exit 2; }

SEED="${SIMPLE_SEED:-bin/simple}"
DEPS_TIMEOUT="${DEPS_TIMEOUT_SECONDS:-240}"
RATIO_LIMIT="${NFR001_RATIO_LIMIT:-0.60}"
DIR="examples/06_io/ui/rendering"

if [ ! -x "$SEED" ]; then
    echo "STATUS: BLOCKED — no executable seed at '$SEED'"
    exit 2
fi

# Portable bounded-runner: GNU timeout, else gtimeout, else unbounded (the
# deps fast listing is normally seconds; the bound only guards a wedged seed).
if command -v timeout >/dev/null 2>&1; then
    RUNNER="timeout $DEPS_TIMEOUT"
elif command -v gtimeout >/dev/null 2>&1; then
    RUNNER="gtimeout $DEPS_TIMEOUT"
else
    RUNNER=""
fi

# ---- dotted_candidates ROOT DOTTED_MODULE (from check-ui-slim-closure.shs) --
# Emits every on-disk file path a dotted module name can legally denote under
# ROOT, including dotted-directory package forms (mirrors dotted_dir_from /
# resolve_parts_from_root in the canonical resolver,
# src/compiler_rust/compiler/src/pipeline/module_loader.rs).
dotted_candidates() {
    dc_root="$1"
    dc_mod="$2"
    printf '%s\n' "$dc_mod" | awk -v root="$dc_root" '
        {
            n = split($0, seg, ".")
            if (n < 1) next
            path = root
            for (i = 1; i < n; i++) path = path "/" seg[i]
            print path "/" seg[n] ".spl"
            print path "/" seg[n] "/__init.spl"
            for (k = 1; k < n; k++) {
                prefix = root
                for (i = 1; i <= k; i++) prefix = prefix "/" seg[i]
                dir = ""
                for (i = k + 1; i < n; i++) dir = (dir == "" ? seg[i] : dir "." seg[i])
                if (dir != "") print prefix "/" dir "/" seg[n] ".spl"
                pkg = ""
                for (i = k + 1; i <= n; i++) pkg = (pkg == "" ? seg[i] : pkg "." seg[i])
                if (pkg != "" && pkg != seg[n]) {
                    print prefix "/" pkg "/__init.spl"
                    print prefix "/" pkg "/mod.spl"
                }
            }
        }
    '
}

# ---- extract_uses FILE ------------------------------------------------------
# Prints the module names of every import edge in FILE, one per line:
#   use A.B.C.{...}      -> A.B.C      use .rel.mod.{...} -> .rel.mod
#   use A.B.C.*          -> A.B.C      import sibling      -> .sibling
#   export use A.B.*     -> A.B.C
# Comment tails and whole lines inside """ docstrings are ignored.
extract_uses() {
    awk '
        BEGIN { indoc = 0 }
        {
            raw = $0
            cnt = gsub(/"""/, "\"\"\"", raw)
            if (indoc) {
                if (cnt % 2 == 1) indoc = 0
                next
            }
            if (cnt % 2 == 1) { indoc = 1; next }
            line = $0
            hashpos = index(line, "#")
            if (hashpos > 0) line = substr(line, 1, hashpos - 1)
            gsub(/^[[:space:]]+/, "", line)
            gsub(/[[:space:]]+$/, "", line)
            if (substr(line, 1, 4) == "use ") print line
            else if (substr(line, 1, 7) == "import ") print "." line
            else if (substr(line, 1, 11) == "export use ") print line
        }
    ' "$1" | sed \
        -e 's/^use //' \
        -e 's/^import /./' \
        -e 's/^export use //' \
        -e 's/\.{.*//' \
        -e 's/\.\*.*//' \
        -e 's/ as .*//' \
        -e 's/ (.*//' \
        -e 's/[[:space:]]*$//'
}

# ---- resolve_module FILE MODULE --------------------------------------------
# Prints THE resolved module file (exactly one path), or nothing when the
# module cannot be resolved to a file. Mirrors the canonical resolver order in
# src/app/deps/scanner.spl (_deps_resolve_module_nofold), which mirrors
# src/compiler/10.frontend/core/interpreter/module_loader_resolve.spl:
#   relative `.a.b`/`..a` -> local dir -> SIMPLE_LIB -> src/ -> tier-root
#   src/lib/<rel> -> dotted-directory folds -> cross-tier variant search
#   (first existing tier wins, order = _deps_lib_tiers()) -> numbered folds.
# std.X/lib.X map to relpath lib/X (std is an alias for lib/).
LIB_TIERS="nogc_async_mut nogc_async_immut nogc_sync_immut nogc_sync_mut common gc_async_mut gc_async_immut gc_sync_mut gc_sync_immut nogc_async_mut_noalloc"

# try_forms BASE REL — print first existing of BASE/REL{.spl,/mod.spl,
# /__init.spl}; return 0 when one printed.
try_forms() {
    for suffix in ".spl" "/mod.spl" "/__init.spl"; do
        if [ -e "$1/$2$suffix" ]; then
            printf '%s\n' "$1/$2$suffix"
            return 0
        fi
    done
    return 1
}

# is_lib_tier SEG
is_lib_tier() {
    case " $LIB_TIERS " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

# dotted_try ROOT MODULE — dotted-directory fold forms under ROOT, first
# existing wins (see dotted_candidates above for the fold semantics).
dotted_try() {
    dt_root="$1"
    dt_mod="$2"
    dt_found=""
    for cand in $(dotted_candidates "$dt_root" "$dt_mod"); do
        if [ -e "$cand" ]; then
            dt_found="$cand"
            break
        fi
    done
    [ -n "$dt_found" ] && printf '%s\n' "$dt_found"
}

resolve_module() {
    rm_file="$1"
    rm_mod="$2"
    rm_dir=$(dirname -- "$rm_file")

    # Relative imports: `.sibling`, `..parent.sibling` (one '..' per level).
    case "$rm_mod" in
        .*)
            rm_rel="$rm_mod"
            rm_base="$rm_dir"
            while :; do
                case "$rm_rel" in
                    ..*) rm_rel=${rm_rel#..}
                         rm_base=$(dirname -- "$rm_base") ;;
                    .*)  rm_rel=${rm_rel#.} ;;
                    *)   break ;;
                esac
            done
            rm_seg=$(printf '%s' "$rm_rel" | tr '.' '/')
            if [ -n "$rm_seg" ]; then
                try_forms "$rm_base" "$rm_seg" && return 0
            fi
            return 1
            ;;
    esac

    # std.X / lib.X -> relpath lib/X (std is an alias for lib/).
    rm_rel=$(printf '%s' "$rm_mod" | tr '.' '/')
    case "$rm_mod" in
        std.*|lib.*) rm_rel="lib/$(printf '%s' "$rm_mod" | sed -e 's/^std\.//' -e 's/^lib\.//' | tr '.' '/')" ;;
    esac
    rm_first=$(printf '%s' "$rm_rel" | cut -d/ -f1)
    rm_rest=${rm_rel#*/}
    [ "$rm_rest" = "$rm_rel" ] && rm_rest=""

    # 1. Local directory (relative to the importing file).
    try_forms "$rm_dir" "$rm_rel" && return 0

    # 2/3. SIMPLE_LIB (=src) and src/ fallbacks (identical here).
    try_forms "src" "$rm_rel" && return 0

    # 3b. Bare tier-rooted import: first segment is a tier dir under src/lib/.
    if is_lib_tier "$rm_first" && [ -n "$rm_rest" ]; then
        try_forms "src/lib" "$rm_rel" && return 0
    fi

    # examples.* lives in the examples/ tree (single root, unambiguous).
    case "$rm_mod" in
        examples.*)
            ex_rel=$(printf '%s' "$rm_mod" | sed 's/^examples\.//' | tr '.' '/')
            try_forms "examples" "$ex_rel" && return 0
            ;;
    esac

    # 3c. Dotted-directory packages (src/app/ui.tui/app.spl et al.).
    rm_rel_dot=$(printf '%s' "$rm_rel" | tr '/' '.')
    dotted_try "$rm_dir" "$rm_rel_dot" && return 0
    dotted_try "src" "$rm_rel_dot" && return 0
    dotted_try "src/lib" "$rm_rel_dot" && return 0

    # 4. Cross-tier variant search: `std.simd` -> src/lib/nogc_sync_mut/simd.spl;
    #    `common.ui.theme_package` -> src/lib/nogc_sync_mut/ui/theme_package.spl.
    #    First existing tier in LIB_TIERS order wins.
    rm_tier_rel=""
    case "$rm_rel" in
        lib/*) rm_tier_rel=${rm_rel#lib/} ;;
        *)     if is_lib_tier "$rm_first" && [ -n "$rm_rest" ]; then
                   rm_tier_rel="$rm_rest"
               fi ;;
    esac
    if [ -n "$rm_tier_rel" ]; then
        for tier in $LIB_TIERS; do
            try_forms "src/lib/$tier" "$rm_tier_rel" && return 0
        done
    fi

    return 1
}

# resolve_edge FILE MODULE — resolve one import edge: first the full module
# name; when it does not resolve, retry with exactly one trailing segment
# dropped (member import `use std.a.b.Symbol` names a symbol in module
# std.a.b). The member fallback accepts only an ordinary module FILE, never
# a package __init.spl/mod.spl — mirrors the guard in src/app/deps/scanner.spl.
resolve_edge() {
    re_file="$1"
    re_mod="$2"
    resolve_module "$re_file" "$re_mod" && return 0
    re_parent=${re_mod%.*}
    [ "$re_parent" != "$re_mod" ] || return 1
    re_hit=$(resolve_module "$re_file" "$re_parent") || return 1
    case "$re_hit" in
        */__init.spl|*/mod.spl) return 1 ;;
        *) printf '%s\n' "$re_hit" ;;
    esac
}

# ---- closure_paths ENTRY OUTFILE -------------------------------------------
# Prints the sorted union closure paths to OUTFILE. Returns 0 on success; 1
# when deps fast is unavailable; 2 when the static arm hits an unresolvable
# import (fail-closed; the module name is printed to stdout before return).
closure_paths() {
    cp_entry="$1"
    cp_out="$2"
    cp_work=$(mktemp -d "${TMPDIR:-/tmp}/rendering-closure-paths.XXXXXX") || return 1
    cp_seen="$cp_work/seen"
    mkdir -p "$cp_seen"

    # Arm 1: deps fast (failure of this arm is BLOCKED for this gate).
    cp_deps_out=$(SIMPLE_LIB=src $RUNNER "$SEED" deps fast "$cp_entry" 2>/dev/null)
    cp_rc=$?
    if [ "$cp_rc" -ne 0 ]; then
        rm -rf "$cp_work"
        return 1
    fi
    printf '%s\n' "$cp_deps_out" | awk '
        {
            for (i = 1; i <= NF; i++) {
                t = $i
                if (substr(t, 1, 4) == "src/" || substr(t, 1, 9) == "examples/") print t
            }
        }
    ' | sort -u > "$cp_work/deps_paths"

    # Arm 2: static BFS over use/import/export-use edges, seeded with the
    # entry and every deps-fast path (so re-export-only modules deps fast
    # already found are re-scanned for edges deps fast dropped).
    : > "$cp_work/queue"
    printf '%s\n' "$cp_entry" >> "$cp_work/queue"
    cat "$cp_work/deps_paths" >> "$cp_work/queue"

    while IFS= read -r cur; do
        [ -e "$cp_seen/$cur" ] && continue
        mkdir -p "$cp_seen/$cur" 2>/dev/null || continue
        [ -f "$cur" ] || continue
        extract_uses "$cur" | while IFS= read -r mod; do
            [ -n "$mod" ] || continue
            if cand=$(resolve_edge "$cur" "$mod"); then
                printf '%s\n' "$cand" >> "$cp_work/queue"
            else
                # Unresolvable by the static arm. Tolerable only when the
                # module name appears in the raw deps fast output (deps fast
                # may know resolver forms this gate does not); otherwise
                # fail closed — never a blind PASS.
                if ! printf '%s\n' "$cp_deps_out" | grep -qF -- "$mod"; then
                    printf 'UNRESOLVED %s (imported from %s)\n' "$mod" "$cur" >> "$cp_work/unresolved"
                fi
            fi
        done
    done < "$cp_work/queue"

    if [ -f "$cp_work/unresolved" ]; then
        cat "$cp_work/unresolved"
        rm -rf "$cp_work"
        return 2
    fi

    # Union: deps-fast paths + BFS-visited files (dirs in $cp_seen).
    ( cat "$cp_work/deps_paths"
      ( CDPATH= cd -- "$cp_seen" && find . -type d | sed 's|^\./||' ) ) \
        | sort -u | grep '\.spl$' > "$cp_out"
    rm -rf "$cp_work"
    return 0
}

# lane pairs: "<lane> <core entry> <full/extended entry>"
LANES="tui $DIR/rendering_tui_core.spl $DIR/rendering_tui_full.spl
gui $DIR/rendering_gui_core.spl $DIR/rendering_gui_full.spl
wm $DIR/rendering_wm_core.spl $DIR/rendering_wm_full.spl
2d $DIR/rendering_2d_core.spl $DIR/rendering_2d_extended.spl
web $DIR/rendering_web_core.spl $DIR/rendering_web_extended.spl"

echo "# NFR-001 closure census (deps fast ∪ static use-BFS, SIMPLE_LIB=src)"
echo "# lane  core_n  full_n  ratio (gate <= $RATIO_LIMIT)"

REPORT=$(mktemp "${TMPDIR:-/tmp}/rendering-closure.XXXXXX") || {
    echo "STATUS: BLOCKED — mktemp failed"
    exit 2
}
# NOTE: no EXIT trap while the lane loop below runs — the loop is a pipeline
# subshell and would inherit (and fire) the trap on subshell exit, deleting
# the report before the parent reads it. Cleanup is explicit on every path.

printf '%s\n' "$LANES" | { while IFS= read -r lane_line; do
    [ -n "$lane_line" ] || continue
    # shellcheck disable=SC2086
    set -- $lane_line
    lane="$1"; core_e="$2"; full_e="$3"

    unreadable=""
    for e in "$core_e" "$full_e"; do
        [ -r "$e" ] || unreadable="$e"
    done
    if [ -n "$unreadable" ]; then
        echo "STATUS: BLOCKED — entry '$unreadable' is not readable"
        exit 2
    fi

    core_paths=$(mktemp "${TMPDIR:-/tmp}/rendering-lane.XXXXXX") || exit 2
    full_paths=$(mktemp "${TMPDIR:-/tmp}/rendering-lane.XXXXXX") || exit 2

    unresolved=$(closure_paths "$core_e" "$core_paths") || {
        case "$?" in
            1) echo "STATUS: BLOCKED — deps fast failed for '$core_e'" ;;
            *) echo "STATUS: BLOCKED — unresolvable import edge(s) in $lane core: $unresolved" ;;
        esac
        rm -f "$core_paths" "$full_paths"
        exit 2
    }
    unresolved=$(closure_paths "$full_e" "$full_paths") || {
        case "$?" in
            1) echo "STATUS: BLOCKED — deps fast failed for '$full_e'" ;;
            *) echo "STATUS: BLOCKED — unresolvable import edge(s) in $lane full: $unresolved" ;;
        esac
        rm -f "$core_paths" "$full_paths"
        exit 2
    }
    core_n=$(grep -c . "$core_paths" 2>/dev/null || true)
    full_n=$(grep -c . "$full_paths" 2>/dev/null || true)
    rm -f "$core_paths" "$full_paths"
    [ -n "$core_n" ] || core_n=0
    [ -n "$full_n" ] || full_n=0

    mark=$(awk -v c="$core_n" -v f="$full_n" -v lim="$RATIO_LIMIT" '
        BEGIN {
            if (f <= 0) { printf "BLOCKED:zero-full"; exit 0 }
            r = c / f
            printf "%.4f  %s", r, (r > lim ? "FAIL (exceeds limit)" : "ok")
        }')
    case "$mark" in
        BLOCKED:*)
            echo "STATUS: BLOCKED — $lane full closure count is zero"
            exit 2 ;;
    esac

    echo "$lane  $core_n  $full_n  $mark"
done > "$REPORT"; }

# The loop body writes only to $REPORT; a mid-loop `exit 2` leaves a STATUS
# line as the last line of $REPORT.
cat "$REPORT"

if grep -q "^STATUS: BLOCKED" "$REPORT"; then
    blocked_reason=$(tail -1 "$REPORT")
    rm -f "$REPORT"
    echo "STATUS: BLOCKED — ${blocked_reason#STATUS: BLOCKED — }"
    exit 2
fi
fail_lanes=$(awk '$5 == "FAIL" {print $1}' "$REPORT" | tr '\n' ' ')
rm -f "$REPORT"

if [ -n "$fail_lanes" ]; then
    echo "STATUS: FAIL — ratio > $RATIO_LIMIT for lane(s): $fail_lanes"
    exit 1
fi
echo "STATUS: PASS — all lane ratios <= $RATIO_LIMIT"
exit 0
