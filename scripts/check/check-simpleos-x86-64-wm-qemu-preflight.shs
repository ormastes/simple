#!/bin/sh
# Static-only x86_64 SimpleOS WM preflight. This intentionally never starts
# QEMU: live boot/capture is gated on current host evidence.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
ENTRY="$ROOT_DIR/examples/09_embedded/simple_os/arch/x86_64/gui_entry_desktop.spl"
CORE="$ROOT_DIR/src/os/compositor/engine2d_baremetal_core.spl"
COMPAT="$ROOT_DIR/scripts/check/check-simpleos-x86-64-wm-render-event-evidence.shs"
CANONICAL="$ROOT_DIR/scripts/check/check-simpleos-wm-fullscreen-evidence.shs"
# The canonical wrapper was refactored into sourced components; the properties
# asserted below now live in the component that owns them, not in the wrapper.
CANONICAL_LIB="$ROOT_DIR/scripts/check/lib/simpleos-wm-fullscreen"
CANONICAL_ADMISSION="$CANONICAL_LIB/admission.shs"
CANONICAL_RUNTIME="$CANONICAL_LIB/runtime.shs"
X86_STUBS="$ROOT_DIR/examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c"
HDA_SERVICE="$ROOT_DIR/src/os/services/audio/audio_service.spl"

fail() {
    echo "simpleos_x86_64_wm_qemu_preflight_status=fail"
    echo "simpleos_x86_64_wm_qemu_preflight_reason=$1"
    exit 1
}

[ -f "$ENTRY" ] || fail "canonical-entry-missing"
[ -f "$CORE" ] || fail "engine2d-core-missing"
[ -x "$COMPAT" ] || fail "x86-compat-wrapper-missing-or-not-executable"
[ -x "$CANONICAL" ] || fail "canonical-wrapper-missing-or-not-executable"
[ -f "$CANONICAL_ADMISSION" ] || fail "canonical-wrapper-admission-component-missing"
[ -f "$CANONICAL_RUNTIME" ] || fail "canonical-wrapper-runtime-component-missing"
grep -q '\. "\$WM_FULLSCREEN_ADMISSION"' "$CANONICAL" || fail "canonical-wrapper-admission-not-sourced"
grep -q '\. "\$WM_FULLSCREEN_RUNTIME"' "$CANONICAL" || fail "canonical-wrapper-runtime-not-sourced"
[ -f "$X86_STUBS" ] || fail "x86-simd-runtime-source-missing"
[ -f "$HDA_SERVICE" ] || fail "hda-service-missing"
[ -x "$(command -v clang 2>/dev/null || true)" ] || fail "clang-not-on-PATH"

theme_line="$(grep -n 'val theme_snapshot = install_generated_simpleos_wm_theme()' "$ENTRY" | head -n 1 | cut -d: -f1)"
executor_line="$(grep -n 'Engine2dWmFrameExecutor.create_host_gpu' "$ENTRY" | head -n 1 | cut -d: -f1)"
first_frame_line="$(grep -n 'shell.render_baremetal_first_frame(wm_frame_executor)' "$ENTRY" | head -n 1 | cut -d: -f1)"
vfs_mount_line="$(grep -n 'g_vfs_mounted = vfs_boot_init()' "$ENTRY" | head -n 1 | cut -d: -f1)"
theme_override_line="$(grep -n 'apply_simpleos_css_theme_override(theme_css)' "$ENTRY" | head -n 1 | cut -d: -f1)"
[ -n "$theme_line" ] || fail "generated-theme-snapshot-not-installed"
[ -n "$executor_line" ] || fail "engine2d-frame-executor-not-constructed"
[ -n "$first_frame_line" ] || fail "canonical-first-frame-not-rendered"
[ -n "$vfs_mount_line" ] || fail "vfs-mount-not-started"
[ -n "$theme_override_line" ] || fail "boot-theme-css-not-applied"
[ "$theme_line" -lt "$executor_line" ] || fail "theme-install-after-frame-executor"
[ "$vfs_mount_line" -lt "$theme_override_line" ] || fail "boot-theme-css-applied-before-vfs-mount"
[ "$theme_override_line" -lt "$executor_line" ] || fail "boot-theme-css-applied-after-frame-executor"
[ "$executor_line" -lt "$first_frame_line" ] || fail "first-frame-before-frame-executor"

grep -q 'baremetal_simd_fill_hits' "$ENTRY" || fail "desktop-simd-hit-receipt-missing"
grep -q 'baremetal_simd_fill_chunks' "$ENTRY" || fail "desktop-simd-chunk-receipt-missing"
grep -q '\[engine2d-simd\] arch=x86_64 isa=sse2 enabled=1' "$ENTRY" || fail "desktop-sse2-receipt-marker-missing"
grep -q 'extern fn rt_gui_fill4' "$CORE" || fail "engine2d-core-fill-owner-missing"
grep -q 'rt_gui_simd_fill_enabled' "$CORE" || fail "engine2d-core-simd-dispatch-receipt-missing"
grep -q 'simpleos_hda_start()' "$ENTRY" || fail "hda-service-not-started-by-desktop"
grep -q 'hda_dma_prepare_silent_stream(resources)' "$HDA_SERVICE" || fail "hda-bdl-pcm-prepare-missing"
grep -q 'idt_register_handler(' "$HDA_SERVICE" || fail "hda-irq-handler-registration-missing"
grep -q 'ioapic_route_intx(irq, g_simpleos_hda_irq_vector)' "$HDA_SERVICE" || fail "hda-ioapic-route-missing"
grep -q 'controller.start_stream(stream_id)' "$HDA_SERVICE" || fail "hda-stream-start-missing"
grep -q '^int64_t rt_pci_device_count(void)' "$X86_STUBS" || fail "hda-pci-count-provider-missing"
grep -q '^int64_t rt_pci_get_field(int64_t index, int64_t field)' "$X86_STUBS" || fail "hda-pci-field-provider-missing"
grep -q '^int64_t rt_pci_read_bar0(int64_t index)' "$X86_STUBS" || fail "hda-pci-bar-provider-missing"
grep -q '^int64_t rt_pci_enable_memory_bus_master(int64_t index)' "$X86_STUBS" || fail "hda-pci-enable-provider-missing"
grep -q '^int64_t rt_ptr_read_i64(int64_t addr, int64_t offset)' "$X86_STUBS" || fail "hda-dma-pointer-read-provider-missing"
grep -q '^int64_t rt_ptr_write_i64(int64_t addr, int64_t offset, int64_t value)' "$X86_STUBS" || fail "hda-dma-pointer-write-provider-missing"

grep -q 'check-simpleos-wm-fullscreen-evidence.shs' "$COMPAT" || fail "x86-wrapper-not-delegated"
if grep -Eq '(^|[[:space:]])ENTRY=.*arch/x86_64/wm_entry\.spl' "$COMPAT"; then
    fail "legacy-wm-entry-still-routed"
fi
grep -q 'ENTRY="examples/09_embedded/simple_os/arch/x86_64/gui_entry_desktop.spl"' "$CANONICAL_ADMISSION" || fail "canonical-wrapper-entry-mismatch"
grep -q 'input-send-event' "$CANONICAL_RUNTIME" || fail "canonical-wrapper-qmp-input-missing"
grep -q 'pmemsave' "$CANONICAL_RUNTIME" || fail "canonical-wrapper-framebuffer-readback-missing"
grep -q 'scancode=87 kind=press' "$CANONICAL_RUNTIME" || fail "canonical-wrapper-f11-press-receipt-missing"
grep -q 'scancode=215 kind=release' "$CANONICAL_RUNTIME" || fail "canonical-wrapper-f11-release-receipt-missing"
grep -q 'wait_release_receipt' "$CANONICAL_RUNTIME" || fail "canonical-wrapper-release-correlation-missing"
grep -q -- '-device intel-hda' "$CANONICAL_RUNTIME" || fail "canonical-wrapper-hda-device-missing"
grep -q -- '-device hda-output' "$CANONICAL_RUNTIME" || fail "canonical-wrapper-hda-output-missing"
grep -q 'guest-hda-repeated-irq-missing' "$CANONICAL_RUNTIME" || fail "canonical-wrapper-hda-irq-gate-missing"
grep -q 'pending_fullscreen_release_sequence' "$ROOT_DIR/src/os/compositor/compositor.spl" || fail "canonical-guest-f11-release-state-missing"
# shell.spl was split into os.desktop._DesktopShell.* components it re-exports;
# the F11 release receipt is emitted by the runtime-methods component now.
SHELL_RUNTIME="$ROOT_DIR/src/os/desktop/_DesktopShell/shell_runtime_methods.spl"
[ -f "$SHELL_RUNTIME" ] || fail "canonical-guest-shell-runtime-component-missing"
grep -q 'export use os.desktop._DesktopShell.shell_runtime_methods' "$ROOT_DIR/src/os/desktop/shell.spl" || fail "canonical-guest-shell-runtime-not-reexported"
grep -q 'scancode=215 kind=release' "$SHELL_RUNTIME" || fail "canonical-guest-f11-release-receipt-missing"

# Compile only the x86_64 C runtime to target assembly. The older shared
# checker also compiles ARM64 and disassembles ELF objects with the host's
# objdump; Apple objdump cannot read those ELF objects, turning an unrelated
# ARM/tool choice into a false x86 lane failure. Target assembly is portable
# and directly proves the SSE2 instructions emitted for rt_gui_fill4.
TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/simpleos-x86-wm-preflight.XXXXXX")"
trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM
ASM="$TMP_DIR/baremetal_stubs_x86_64.s"
if ! clang -target x86_64-unknown-none-elf -S -m64 -ffreestanding -fno-pic \
    -fno-pie -mno-red-zone -O2 -Wno-error=implicit-function-declaration \
    -o "$ASM" "$X86_STUBS"; then
    fail "x86-simd-runtime-assembly-compile-failed"
fi
fill_asm="$(awk '/^rt_gui_fill4:/{active=1} active{print} /^\.size[[:space:]]+rt_gui_fill4/{if (active) exit}' "$ASM")"
case "$fill_asm" in
    *pshufd*) ;;
    *) fail "x86-sse2-pshufd-missing" ;;
esac
case "$fill_asm" in
    *movdqu*) ;;
    *) fail "x86-sse2-movdqu-missing" ;;
esac
grep -q '^rt_gui_simd_fill_enabled:' "$ASM" || fail "x86-simd-enabled-symbol-missing"
grep -q '^rt_gui_simd_fill_hits:' "$ASM" || fail "x86-simd-hits-symbol-missing"
grep -q '^rt_gui_simd_fill_chunks:' "$ASM" || fail "x86-simd-chunks-symbol-missing"
grep -q '^rt_gui_simd_fill_tail_pixels:' "$ASM" || fail "x86-simd-tail-symbol-missing"
grep -q '^rt_pci_enable_memory_bus_master:' "$ASM" || fail "hda-pci-enable-assembly-symbol-missing"
grep -q '^rt_ptr_read_i64:' "$ASM" || fail "hda-dma-pointer-read-assembly-symbol-missing"
grep -q '^rt_ptr_write_i64:' "$ASM" || fail "hda-dma-pointer-write-assembly-symbol-missing"
printf '%s\n' "simpleos_x86_64_wm_qemu_preflight_status=pass"
printf '%s\n' "simpleos_x86_64_wm_qemu_preflight_entry=examples/09_embedded/simple_os/arch/x86_64/gui_entry_desktop.spl"
printf '%s\n' "simpleos_x86_64_wm_qemu_preflight_theme_before_executor=true"
printf '%s\n' "simpleos_x86_64_wm_qemu_preflight_theme_css_after_vfs_before_executor=true"
printf '%s\n' "simpleos_x86_64_wm_qemu_preflight_simd=x86_64-sse2-pshufd-movdqu-and-receipts"
printf '%s\n' "simpleos_x86_64_wm_qemu_preflight_live_qemu=not-started-host-gate"
