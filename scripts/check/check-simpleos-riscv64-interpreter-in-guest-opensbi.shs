#!/bin/sh
# check-simpleos-riscv64-interpreter-in-guest-opensbi.shs
#
# Proves that the SIMPLE INTERPRETER actually RUNS INSIDE SimpleOS on riscv64
# and evaluates a hello-world Simple program, and that a build-and-run sanity
# row builds a program (frontend + real MIR lowering) and then runs it — both
# printing THEIR OWN output to the serial console.
#
# A PROCESS THAT STARTS AND PRINTS A BANNER IS NOT EVIDENCE. Every row below is
# rung on output that only the INTERPRETED PROGRAM can produce, carrying a
# per-run NONCE this gate generated itself. The must-FAIL selftest fixtures
# include a banner-only transcript built by stripping exactly those lines, so a
# guest that boots and prints nothing useful cannot pass.
#
# NONCE ANCHORING (the anti-vacuity mechanism)
# --------------------------------------------
# This gate generates a fresh nonce, passes it to the kernel builder, and then
# requires that exact nonce on the serial console. The nonce reaches serial only
# by being embedded in the interpreted program's SOURCE TEXT and printed by that
# program while the in-guest interpreter evaluates it. A stale kernel Image, a
# replayed transcript, or a fixed banner string therefore cannot satisfy this
# gate. Success is anchored on the nonce, never on a fixed banner.
#
# Boot is real OpenSBI v1.4 built as `fw_payload` with the guest Image embedded,
# handed to QEMU as `-bios` ONLY. NEVER QEMU `-kernel`, NEVER isa-debug-exit:
# fw_dynamic's next-stage address is populated by QEMU's `-kernel` machinery,
# which is exactly the banned pass semantics, whereas fw_payload is a real
# board-shipping configuration (how OpenSBI ships on flash on JH7110-class
# boards) — the FIRMWARE performs the S-mode handover to 0x80200000. The full
# rationale lives in check-simpleos-riscv64-opensbi-guest-boot.shs, whose
# firmware construction this gate reuses. The assembled QEMU argv is
# self-checked for both forbidden flags before each VM is started.
#
# WEAK-NIL STUB CHECK (a clean link is not evidence)
# --------------------------------------------------
# boot/baremetal_stubs.c weak-defines handlers, and this tree has seen
# rt_closure_new resolve to a synthesized 8-byte WEAK nil stub despite the file
# deliberately leaving it unresolved to fail closed — a green link, then a fault
# at runtime. Before booting anything this gate `nm`s each kernel ELF and FAILs
# on any runtime symbol the interpreter depends on that resolved WEAK, and on
# any remaining UNDEFINED runtime symbol.
#
# COMPILER: the RUST SEED. The pure-Simple self-hosted compiler cannot compile
# anything in this tree yet, so this lane's artifacts are seed-built and the
# verdict says so rather than implying self-hosting.
#
# HONEST SCOPE, stated rather than papered over:
#   * Both rows run in S-mode (kernel mode), linked into the guest image — not
#     as U-mode processes loaded off the guest's own filesystem. This is the
#     same scope as every other in-guest row in this tree. riscv64 DOES carry a
#     U-mode ELF loader (boot/rv64_fs_exec_loader.inc.c, Sv39 page tables) and a
#     scheduler/enter-user path (arch/riscv64/entry.spl `_rv64_enter_user`), but
#     its public execution entry rt_riscv_fs_exec_run() DELIBERATELY FAILS
#     CLOSED (returns -13) pending an authority token bound to digest,
#     mount/file identity and content generation. Routing around that
#     fail-closed to manufacture a U-mode row would defeat a security control,
#     not produce evidence, so this lane does not do it.
#   * The build-and-run row does frontend + real MIR lowering and then RUNS the
#     program. It does NOT do LLVM codegen, object emission or an in-guest link:
#     simpleos_compile_native_file pins CodegenTarget.SimpleOS_X86_64 and links
#     through link_simpleos_x86_64_external, which a freestanding riscv64 S-mode
#     image has no linker, filesystem or process model to drive.
#   These are limits of scope, not of evidence: within that scope every step is
#   a real round-trip through unmodified product source.
#
# ROWS (serial log). Boot rungs are preconditions; each row needs BOTH its
# evidence line and its nonce-carrying marker.
#   interp    B "OpenSBI v"                                     real firmware ran
#             B "[interp] SimpleOS riscv64 in-guest Simple interpreter"
#             B "[interp] serial up, interpreting a hello world"
#               "[interp] hir ready, invoking InterpreterBackendImpl"
#               "HELLO_INTERP_SIMPLEOS_RISCV64_OK nonce=<NONCE>"  *** interpreted
#                                                                     program's
#                                                                     own output
#               "HELLO_INTERP_SIMPLEOS_RISCV64 second line"      it kept running
#               "[interp] interpreter row exited rc=0"
#   buildrun  B "OpenSBI v"
#             B "[buildrun] SimpleOS riscv64 in-guest build-and-run sanity"
#               "[buildrun] phase=hir-ok"
#               "[buildrun] phase=mir-ok"                        the BUILD half
#               "BUILDRUN_SIMPLEOS_RISCV64_OK sum=42 nonce=<NONCE>"  the RUN half
#               "[buildrun] build-and-run row exited rc=0"
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> row(s) checked, ...   exit 0
#   FAIL  — ...                       exit 1
#   ERROR — nothing was checked: ...  exit 2
# 0 rows evaluated is an ERROR, never a PASS. Offline with no cached OpenSBI
# checkout is an ERROR, never a PASS. A boot rung that never appeared is an
# ERROR (nothing was checked), not a FAIL — a guest that never reached the entry
# evaluated no row.
#
# `--selftest` (also run, fatally, before every real scan) proves the serial
# evaluator, the nonce anchoring and the argv guard on fixtures.
#
# Env: SIMPLE_BIN (fresh seed), SKIP_KERNEL=1, BOOT_WAIT (180), OPENSBI_SRC,
#      NONCE (override, for reproducing a specific run).
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT"

OUT=$ROOT/build/os/riscv64_interp
WORK=$OUT/run
BOOT_WAIT=${BOOT_WAIT:-180}
SIMPLE_BIN=${SIMPLE_BIN:-$ROOT/src/compiler_rust/target/release/simple}
OPENSBI_SRC=${OPENSBI_SRC:-$ROOT/build/os/rv64_opensbi_guest/opensbi-src}
OPENSBI_TAG=v1.4
OPENSBI_SHA=a2b255b88918715173942f2c5e1f97ac9e90c877  # v1.4 peeled commit, same pin as the sibling gates

fail()    { printf 'FAIL — %s\n' "$1"; exit 1; }
nothing() { printf 'ERROR — nothing was checked: %s\n' "$1"; exit 2; }

# ---------------------------------------------------------------------------
# Serial evaluators. Each takes <log> <nonce> and returns 0 only when the row's
# OWN output — not a boot banner — is present with the expected nonce.
# ---------------------------------------------------------------------------
interp_boot_ok() {
    [ -s "$1" ] || return 1
    grep -aqF 'OpenSBI v' "$1" || return 1
    grep -aqF '[interp] SimpleOS riscv64 in-guest Simple interpreter' "$1" || return 1
    grep -aqF '[interp] serial up, interpreting a hello world' "$1" || return 1
    return 0
}

interp_row_ok() {
    sl=$1; nonce=$2
    [ -s "$sl" ] || return 1
    grep -aqF '[interp] hir ready, invoking InterpreterBackendImpl' "$sl" || return 1
    # The interpreted program's OWN output, carrying THIS run's nonce.
    grep -aqF "HELLO_INTERP_SIMPLEOS_RISCV64_OK nonce=$nonce" "$sl" || return 1
    grep -aqF 'HELLO_INTERP_SIMPLEOS_RISCV64 second line proves the interpreter kept running' "$sl" || return 1
    grep -aqF '[interp] interpreter row exited rc=0' "$sl" || return 1
    return 0
}

buildrun_boot_ok() {
    [ -s "$1" ] || return 1
    grep -aqF 'OpenSBI v' "$1" || return 1
    grep -aqF '[buildrun] SimpleOS riscv64 in-guest build-and-run sanity' "$1" || return 1
    grep -aqF '[buildrun] serial up, building then running a Simple program' "$1" || return 1
    return 0
}

buildrun_row_ok() {
    sl=$1; nonce=$2
    [ -s "$sl" ] || return 1
    grep -aqF '[buildrun] phase=hir-ok' "$sl" || return 1
    grep -aqF '[buildrun] phase=mir-ok' "$sl" || return 1
    grep -aqF "BUILDRUN_SIMPLEOS_RISCV64_OK sum=42 nonce=$nonce" "$sl" || return 1
    grep -aqF '[buildrun] build-and-run row exited rc=0' "$sl" || return 1
    return 0
}

# argv self-check. Needles are assembled from fragments so this check can
# neither be defeated by, nor accidentally fire on, the surrounding prose.
assert_real_firmware_argv() {
    k_flag="-kern""el"
    d_dev="isa-debug""-exit"
    case " $1 " in
        *" $k_flag "*) echo "argv uses QEMU $k_flag pass semantics"; return 1 ;;
    esac
    case "$1" in
        *"$d_dev"*) echo "argv uses $d_dev"; return 1 ;;
    esac
    case "$1" in
        *"-bios "*) ;;
        *) echo "argv has no -bios firmware"; return 1 ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# WEAK-NIL STUB CHECK. A clean link is not evidence: baremetal_stubs.c
# weak-defines handlers, and a WEAK 8-byte nil stub has previously satisfied a
# link that was meant to fail closed. Returns 0 when the ELF is clean; prints
# the offending symbols and returns 1 otherwise.
# ---------------------------------------------------------------------------
elf_free_of_weak_nil_stubs() {
    elf=$1
    command -v nm >/dev/null 2>&1 || { echo "no nm available"; return 1; }
    tbl=$(nm "$elf" 2>/dev/null) || { echo "nm could not read $elf"; return 1; }

    # nm prints "ADDR TYPE NAME" for defined symbols but "        U NAME" for
    # undefined ones, so the type column is $(NF-1) in BOTH shapes and $1 is NOT.
    # Indexing on $1 silently matched nothing for defined symbols and let a real
    # WEAK stub through — caught by this gate's own must-FAIL fixture.
    #
    # Any runtime symbol still UNDEFINED after a "successful" link.
    undef=$(printf '%s\n' "$tbl" | awk 'NF >= 2 && $(NF-1) == "U" && $NF ~ /^rt_/ { print $NF }' | sort -u | tr '\n' ' ')
    # Any runtime symbol resolved WEAK (lowercase w = weak undefined,
    # v = weak object undefined, W = weak defined, V = weak object defined). A
    # weak DEFINED runtime symbol is the exact synthesized-nil-stub shape this
    # check exists to catch.
    weak=$(printf '%s\n' "$tbl" | awk 'NF >= 2 && ($(NF-1) == "w" || $(NF-1) == "v" || $(NF-1) == "W" || $(NF-1) == "V") && $NF ~ /^rt_/ { print $NF }' | sort -u | tr '\n' ' ')

    if [ -n "$undef" ] || [ -n "$weak" ]; then
        printf '%s' "${undef:+undefined runtime symbols: $undef}${weak:+${undef:+; }weak/nil-stub runtime symbols: $weak}"
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
selftest() {
    st=$(mktemp -d "${TMPDIR:-/tmp}/rv64-interp-selftest.XXXXXX")
    st_fail=0
    n=0
    N=SELFTESTNONCE01
    OTHER=SELFTESTNONCE99

    # ---- interpreter row fixtures -----------------------------------------
    {
        echo 'OpenSBI v1.4'
        echo '[interp] SimpleOS riscv64 in-guest Simple interpreter (OpenSBI fw_payload)'
        echo '[interp] serial up, interpreting a hello world'
        echo '[interp] lowering hello-world source through the real frontend'
        echo '[interp] hir ready, invoking InterpreterBackendImpl.interpret_hir_module'
        echo "HELLO_INTERP_SIMPLEOS_RISCV64_OK nonce=$N"
        echo 'HELLO_INTERP_SIMPLEOS_RISCV64 second line proves the interpreter kept running'
        echo '[interp] interpreter returned Ok'
        echo '[interp] interpreter row exited rc=0'
    } > "$st/interp_good.log"

    n=$((n+1))
    interp_boot_ok "$st/interp_good.log" || { echo "selftest: good interp boot rungs not seen" >&2; st_fail=1; }
    n=$((n+1))
    interp_row_ok "$st/interp_good.log" "$N" || { echo "selftest: interp must-PASS fixture did not pass" >&2; st_fail=1; }

    # (must-FAIL) BANNER-ONLY: firmware + kernel banners, program silent. This
    # is the exact vacuous-green this gate exists to prevent.
    {
        echo 'OpenSBI v1.4'
        echo '[interp] SimpleOS riscv64 in-guest Simple interpreter (OpenSBI fw_payload)'
        echo '[interp] serial up, interpreting a hello world'
    } > "$st/interp_banner.log"
    n=$((n+1))
    if interp_row_ok "$st/interp_banner.log" "$N"; then
        echo "selftest: BANNER-ONLY interp fixture wrongly passed" >&2; st_fail=1
    fi
    # ...and it must still be recognised as having BOOTED, so the caller
    # classifies it as a row FAIL and not as "nothing was checked".
    n=$((n+1))
    interp_boot_ok "$st/interp_banner.log" \
        || { echo "selftest: banner-only fixture should still show boot rungs" >&2; st_fail=1; }

    # (must-FAIL) WRONG NONCE — a stale image or replayed transcript.
    sed "s/$N/$OTHER/" "$st/interp_good.log" > "$st/interp_stale.log"
    n=$((n+1))
    if interp_row_ok "$st/interp_stale.log" "$N"; then
        echo "selftest: stale-nonce interp fixture wrongly passed" >&2; st_fail=1
    fi

    # (must-FAIL) interpreter invoked but produced NO program output.
    grep -av 'HELLO_INTERP_SIMPLEOS_RISCV64' "$st/interp_good.log" > "$st/interp_silent.log"
    n=$((n+1))
    if interp_row_ok "$st/interp_silent.log" "$N"; then
        echo "selftest: silent-interpreter fixture wrongly passed" >&2; st_fail=1
    fi

    # (must-FAIL) row exited non-zero.
    sed 's/exited rc=0/exited rc=nonzero/' "$st/interp_good.log" > "$st/interp_rc.log"
    n=$((n+1))
    if interp_row_ok "$st/interp_rc.log" "$N"; then
        echo "selftest: non-zero-exit interp fixture wrongly passed" >&2; st_fail=1
    fi

    # (must-FAIL) empty log.
    : > "$st/empty.log"
    n=$((n+1))
    if interp_row_ok "$st/empty.log" "$N"; then
        echo "selftest: empty fixture wrongly passed" >&2; st_fail=1
    fi
    n=$((n+1))
    if interp_boot_ok "$st/empty.log"; then
        echo "selftest: empty fixture wrongly reported booted" >&2; st_fail=1
    fi

    # (must-FAIL) program output but NO firmware banner — started some way other
    # than through real firmware.
    grep -av 'OpenSBI v' "$st/interp_good.log" > "$st/interp_nofw.log"
    n=$((n+1))
    if interp_boot_ok "$st/interp_nofw.log"; then
        echo "selftest: firmware-less interp transcript wrongly passed boot check" >&2; st_fail=1
    fi

    # ---- build-and-run row fixtures ---------------------------------------
    {
        echo 'OpenSBI v1.4'
        echo '[buildrun] SimpleOS riscv64 in-guest build-and-run sanity (OpenSBI fw_payload)'
        echo '[buildrun] serial up, building then running a Simple program'
        echo '[buildrun] phase=hir-ok'
        echo '[buildrun] phase=mir-ok functions lowered'
        echo '[buildrun] running the built program'
        echo "BUILDRUN_SIMPLEOS_RISCV64_OK sum=42 nonce=$N"
        echo '[buildrun] program returned Ok'
        echo '[buildrun] build-and-run row exited rc=0'
    } > "$st/br_good.log"

    n=$((n+1))
    buildrun_boot_ok "$st/br_good.log" || { echo "selftest: good buildrun boot rungs not seen" >&2; st_fail=1; }
    n=$((n+1))
    buildrun_row_ok "$st/br_good.log" "$N" || { echo "selftest: buildrun must-PASS fixture did not pass" >&2; st_fail=1; }

    # (must-FAIL) BANNER-ONLY buildrun.
    {
        echo 'OpenSBI v1.4'
        echo '[buildrun] SimpleOS riscv64 in-guest build-and-run sanity (OpenSBI fw_payload)'
        echo '[buildrun] serial up, building then running a Simple program'
    } > "$st/br_banner.log"
    n=$((n+1))
    if buildrun_row_ok "$st/br_banner.log" "$N"; then
        echo "selftest: BANNER-ONLY buildrun fixture wrongly passed" >&2; st_fail=1
    fi

    # (must-FAIL) built but never ran — mir-ok present, program output absent.
    grep -av 'BUILDRUN_SIMPLEOS_RISCV64_OK' "$st/br_good.log" > "$st/br_norun.log"
    n=$((n+1))
    if buildrun_row_ok "$st/br_norun.log" "$N"; then
        echo "selftest: built-but-never-ran fixture wrongly passed" >&2; st_fail=1
    fi

    # (must-FAIL) ran but the BUILD half never happened — no mir-ok.
    grep -av 'phase=mir-ok' "$st/br_good.log" > "$st/br_nomir.log"
    n=$((n+1))
    if buildrun_row_ok "$st/br_nomir.log" "$N"; then
        echo "selftest: no-MIR fixture wrongly passed" >&2; st_fail=1
    fi

    # (must-FAIL) stale nonce on the buildrun row.
    sed "s/$N/$OTHER/" "$st/br_good.log" > "$st/br_stale.log"
    n=$((n+1))
    if buildrun_row_ok "$st/br_stale.log" "$N"; then
        echo "selftest: stale-nonce buildrun fixture wrongly passed" >&2; st_fail=1
    fi

    # ---- argv fixtures -----------------------------------------------------
    n=$((n+1))
    assert_real_firmware_argv "-machine virt -bios fw_payload.bin -serial file:x" >/dev/null \
        || { echo "selftest: clean argv wrongly rejected" >&2; st_fail=1; }
    n=$((n+1))
    if assert_real_firmware_argv "-machine virt -bios fw.bin -kern""el k.Image" >/dev/null 2>&1; then
        echo "selftest: -kernel argv wrongly accepted" >&2; st_fail=1
    fi
    n=$((n+1))
    if assert_real_firmware_argv "-machine virt -bios fw.bin -device isa-debug""-exit" >/dev/null 2>&1; then
        echo "selftest: isa-debug-exit argv wrongly accepted" >&2; st_fail=1
    fi
    n=$((n+1))
    if assert_real_firmware_argv "-machine virt -serial file:x" >/dev/null 2>&1; then
        echo "selftest: firmware-less argv wrongly accepted" >&2; st_fail=1
    fi

    # ---- weak-nil stub detector fixtures ----------------------------------
    # Built as real object files probed by the real detector, so the check
    # cannot rot into a text comparison against a hand-written nm listing.
    if command -v cc >/dev/null 2>&1 && command -v nm >/dev/null 2>&1; then
        # clean: a strongly-defined runtime symbol.
        printf 'long rt_clean_symbol(void){return 1;}\n' > "$st/clean.c"
        cc -c "$st/clean.c" -o "$st/clean.o" 2>/dev/null && {
            n=$((n+1))
            elf_free_of_weak_nil_stubs "$st/clean.o" >/dev/null \
                || { echo "selftest: clean object wrongly flagged as stubbed" >&2; st_fail=1; }
        }
        # dirty: a WEAK definition — the synthesized-nil-stub shape.
        printf '__attribute__((weak)) long rt_weak_nil_stub(void){return 0;}\n' > "$st/weak.c"
        cc -c "$st/weak.c" -o "$st/weak.o" 2>/dev/null && {
            n=$((n+1))
            if elf_free_of_weak_nil_stubs "$st/weak.o" >/dev/null 2>&1; then
                echo "selftest: WEAK runtime symbol wrongly accepted" >&2; st_fail=1
            fi
        }
        # dirty: an UNDEFINED runtime symbol surviving the link.
        printf 'extern long rt_missing_symbol(void);\nlong use(void){return rt_missing_symbol();}\n' > "$st/undef.c"
        cc -c "$st/undef.c" -o "$st/undef.o" 2>/dev/null && {
            n=$((n+1))
            if elf_free_of_weak_nil_stubs "$st/undef.o" >/dev/null 2>&1; then
                echo "selftest: UNDEFINED runtime symbol wrongly accepted" >&2; st_fail=1
            fi
        }
    fi

    rm -rf "$st"
    [ "$st_fail" -eq 0 ] || return 1
    SELFTEST_N=$n
    printf '[rv64-interp] selftest OK (%s fixtures)\n' "$n"
    return 0
}

selftest || nothing "selftest failed — the serial evaluator cannot be trusted"
if [ "${1:-}" = "--selftest" ]; then
    [ "${SELFTEST_N:-0}" -gt 0 ] || nothing "selftest executed 0 fixtures"
    printf 'PASS — %s selftest fixture(s) checked, serial evaluator, nonce anchoring, weak-nil-stub detector and argv guard all discriminate\n' "$SELFTEST_N"
    exit 0
fi

# --- the nonce: generated HERE so the gate knows what it must see ------------
if [ -z "${NONCE:-}" ]; then
    NONCE=$( (od -An -N8 -tx1 /dev/urandom 2>/dev/null || date +%s%N) | tr -d ' \n' )
fi
[ -n "$NONCE" ] || nothing "could not generate a nonce"

# --- build both kernels (Simple source -> flat Images, by the Rust seed) -----
if [ "${SKIP_KERNEL:-0}" != "1" ]; then
    mkdir -p "$OUT"
    SIMPLE_BIN="$SIMPLE_BIN" NONCE="$NONCE" \
        sh "$ROOT/scripts/os/build-simpleos-riscv64-interpreter-kernel.shs" >"$OUT/gate-kernel.log" 2>&1 \
        || nothing "interpreter kernel build failed: $(tail -3 "$OUT/gate-kernel.log" 2>/dev/null | tr '\n' ' ')"
        # The excerpt is flattened with tr: a multi-line diagnostic embedded in
        # the verdict would push the verdict off the LAST line of stdout, which
        # is the one contract every caller of this gate relies on.
fi

command -v qemu-system-riscv64 >/dev/null 2>&1 || nothing "missing qemu-system-riscv64"
OPENSBI_CROSS=
for c in riscv64-linux-gnu- riscv64-unknown-elf-; do
    command -v "${c}gcc" >/dev/null 2>&1 && { OPENSBI_CROSS=$c; break; }
done
[ -n "$OPENSBI_CROSS" ] || nothing "no riscv64 cross-gcc to build OpenSBI"

mkdir -p "$WORK"

# --- OpenSBI v1.4 checkout: reuse the pinned one, else clone -----------------
if [ -d "$OPENSBI_SRC/.git" ]; then
    have=$(git -C "$OPENSBI_SRC" rev-parse HEAD 2>/dev/null || echo none)
    [ "$have" = "$OPENSBI_SHA" ] \
        || nothing "OpenSBI checkout $OPENSBI_SRC is at $have, not pinned $OPENSBI_SHA — refusing to build unpinned firmware"
else
    git clone --depth 1 --branch "$OPENSBI_TAG" \
        https://github.com/riscv-software-src/opensbi.git "$OPENSBI_SRC" >"$WORK/clone.log" 2>&1 \
        || nothing "no cached OpenSBI checkout and clone failed (offline?) — see $WORK/clone.log"
    have=$(git -C "$OPENSBI_SRC" rev-parse HEAD)
    [ "$have" = "$OPENSBI_SHA" ] || nothing "cloned OpenSBI $OPENSBI_TAG is $have, not pinned $OPENSBI_SHA"
fi

# ---------------------------------------------------------------------------
# boot_row <subdir> — build fw_payload around that row's Image and run it.
# Sets ROW_LOG. Returns non-zero only for environment failures (the caller
# distinguishes "did not boot" from "row failed" by the boot evaluators).
# ---------------------------------------------------------------------------
boot_row() {
    rd=$1
    img=$OUT/$rd/kernel.Image
    elf=$OUT/$rd/kernel.elf
    ROW_LOG=$WORK/$rd-serial.log

    [ -s "$img" ] || nothing "missing flat Image $img"
    [ -s "$elf" ] || nothing "missing kernel ELF $elf"

    # A clean link is not evidence — nm the ELF before believing it.
    why=$(elf_free_of_weak_nil_stubs "$elf") \
        || fail "$rd kernel ELF is not safely linked: $why (a clean link is not evidence; see the WEAK-NIL STUB CHECK header)"

    # OpenSBI embeds the payload with `.incbin "$(FW_PAYLOAD_PATH)"` and does
    # NOT list that path as a prerequisite of fw_payload.o. Its make is
    # incremental, so the SECOND row's build finds fw_payload.o already up to
    # date and silently reuses the FIRST row's Image -- both rows then boot the
    # same guest. Measured 2026-09-01: buildrun-fw_payload.bin contained 2
    # `HELLO_INTERP_SIMPLEOS_RISCV64` markers and ZERO `BUILDRUN` markers, and
    # the build-and-run guest emitted `[interp]` rungs and panicked on
    # `src/os/rv64_interp_hello.spl` -- the interpreter row's program. The gate
    # reported that as "the build-and-run guest never reached its entry", which
    # is not what happened: it reached a DIFFERENT row's entry.
    #
    # Deleting the firmware objects forces the incbin to be re-read. It is not
    # a full `make clean` -- the platform library and the rest of the tree stay
    # warm, so this costs seconds, not a rebuild.
    rm -rf "$OPENSBI_SRC/build/platform/generic/firmware"

    make -C "$OPENSBI_SRC" PLATFORM=generic CROSS_COMPILE="$OPENSBI_CROSS" \
        FW_PAYLOAD=y FW_PAYLOAD_PATH="$img" FW_PAYLOAD_OFFSET=0x200000 -j4 \
        >"$WORK/$rd-opensbi-build.log" 2>&1 \
        || { tail -20 "$WORK/$rd-opensbi-build.log" >&2; nothing "OpenSBI fw_payload build failed for $rd"; }
    fw=$OPENSBI_SRC/build/platform/generic/firmware/fw_payload.bin
    [ -s "$fw" ] || nothing "fw_payload.bin missing after build for $rd"

    # POSITIVE embed assertion (hazard: "assert positively that the firmware
    # embeds YOUR Image"). A firmware that built cleanly is not evidence it
    # carries THIS row's payload -- that is exactly the failure above, which
    # was invisible for as long as nobody checked. Requiring the row's whole
    # flat Image to appear verbatim inside the firmware cannot be satisfied by
    # a stale sibling: the two Images differ.
    python3 - "$fw" "$img" "$rd" <<'EMBED_CHECK'
import sys
fw, img, rd = sys.argv[1], sys.argv[2], sys.argv[3]
with open(fw, 'rb') as f:
    firmware = f.read()
with open(img, 'rb') as f:
    image = f.read()
if not image:
    sys.exit("row %s: flat Image is empty" % rd)
if image not in firmware:
    sys.exit(
        "row %s: fw_payload.bin (%d bytes) does NOT embed its own kernel.Image "
        "(%d bytes) -- the firmware carries some other payload, so booting it "
        "would measure the wrong guest" % (rd, len(firmware), len(image))
    )
EMBED_CHECK
    [ $? -eq 0 ] || nothing "fw_payload for $rd does not embed that row's kernel.Image"

    cp "$fw" "$WORK/$rd-fw_payload.bin"

    rm -f "$ROW_LOG"

    # Assemble the argv FIRST, self-check it, then boot.
    qa="-no-user-config -machine virt -cpu rv64 -smp 1 -m 512M"
    qa="$qa -bios $WORK/$rd-fw_payload.bin"
    qa="$qa -serial file:$ROW_LOG"
    qa="$qa -display none -monitor none -net none -no-reboot"

    why=$(assert_real_firmware_argv "$qa") \
        || fail "$why (script bug, not an environment gap)"

    # The guest parks in crt0.S's wfi loop, so QEMU never exits on its own and
    # `timeout` killing it is the NORMAL path. The transcript is the artifact.
    # shellcheck disable=SC2086
    timeout "$BOOT_WAIT" qemu-system-riscv64 $qa >/dev/null 2>&1 || true
}

CHECKED=0
OFFENDERS=

# --- row 1: the interpreter --------------------------------------------------
boot_row interp
INTERP_LOG=$ROW_LOG
interp_boot_ok "$INTERP_LOG" \
    || nothing "the interpreter guest never reached its entry — no boot rungs on serial, so no row was evaluated (log: $INTERP_LOG)"
CHECKED=$((CHECKED + 1))
interp_row_ok "$INTERP_LOG" "$NONCE" \
    || OFFENDERS="${OFFENDERS:+$OFFENDERS; }interpreter row: the interpreted hello world did not print its own nonce-carrying output (log: $INTERP_LOG)"

# --- row 2: build-and-run sanity --------------------------------------------
boot_row buildrun
BR_LOG=$ROW_LOG
buildrun_boot_ok "$BR_LOG" \
    || nothing "the build-and-run guest never reached its entry — no boot rungs on serial (log: $BR_LOG)"
CHECKED=$((CHECKED + 1))
buildrun_row_ok "$BR_LOG" "$NONCE" \
    || OFFENDERS="${OFFENDERS:+$OFFENDERS; }build-and-run row: the program was not built and run to a correct result (log: $BR_LOG)"

[ "$CHECKED" -gt 0 ] || nothing "no rows were evaluated"

if [ -n "$OFFENDERS" ]; then
    printf 'FAIL — %s row(s) checked in-guest under real OpenSBI %s firmware (nonce %s), offender(s): %s\n' \
        "$CHECKED" "$OPENSBI_TAG" "$NONCE" "$OFFENDERS"
    exit 1
fi

printf 'PASS — %s row(s) checked: the Simple INTERPRETER evaluated a hello world and a build-and-run sanity program was MIR-lowered then run, both in-guest on SimpleOS riscv64 under real OpenSBI %s firmware via -bios fw_payload (no -kernel, no isa-debug-exit), each printing its own output carrying this run'"'"'s nonce %s; kernels seed-built (%s); logs %s\n' \
    "$CHECKED" "$OPENSBI_TAG" "$NONCE" "$SIMPLE_BIN" "$WORK"
