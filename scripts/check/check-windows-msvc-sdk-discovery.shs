#!/usr/bin/env bash
# Exercise the production SDK discovery block under the caller's strict flags.
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
work=$(mktemp -d "${TMPDIR:-/tmp}/msvc-sdk-discovery.XXXXXX")
trap 'rm -rf -- "$work"' EXIT
awk '/^  simple_msvc_sdk_ver=\$\($/ {copy=1} copy {print} copy && /^  unset simple_msvc_s_dir$/ {exit}' \
  "$root/scripts/setup/windows-msvc-bootstrap-env.shs" >"$work/discovery.sh"
[ -s "$work/discovery.sh" ] || { echo 'FAIL: SDK discovery owner absent' >&2; exit 1; }
cat >"$work/case.sh" <<'SH'
simple_msvc_sdk_root=$1
if [ "${3:-}" = sort-failure ]; then
  sort() { return 42; }
fi
. "$2"
printf 'selected=%s\n' "$simple_msvc_sdk_ver"
SH
passed=0
positive() {
  local name=$1 expected=$2
  if "$BASH" --noprofile --norc -euo pipefail "$work/case.sh" "$work/$name" "$work/discovery.sh" >"$work/$name.log" 2>&1; then
    [ "$(cat "$work/$name.log")" = "selected=$expected" ] || { cat "$work/$name.log" >&2; exit 1; }
  else
    cat "$work/$name.log" >&2; echo "FAIL: $name" >&2; exit 1
  fi
  passed=$((passed + 1))
}
negative() {
  local name=$1 expected=$2 mode=${3:-} result=0
  "$BASH" --noprofile --norc -euo pipefail "$work/case.sh" "$work/$name" "$work/discovery.sh" "$mode" >"$work/$name.log" 2>&1 || result=$?
  [ "$result" -eq "$expected" ] || { cat "$work/$name.log" >&2; echo "FAIL: $name exit=$result" >&2; exit 1; }
  if [ "$mode" != sort-failure ]; then
    grep -Fq 'no versioned Windows SDK' "$work/$name.log"
  fi
  ! grep -q '^selected=' "$work/$name.log"
  passed=$((passed + 1))
}
mkdir -p "$work/trailing-wdf/Include/10.0.26100.0/ucrt" "$work/trailing-wdf/Include/wdf"
positive trailing-wdf 10.0.26100.0
mkdir -p "$work/version-order/Include/10.0.9/ucrt" "$work/version-order/Include/10.0.10/ucrt" "$work/version-order/Include/10.0.99"
positive version-order 10.0.10
mkdir -p "$work/empty/Include" "$work/wdf-only/Include/wdf"
negative empty 1
negative wdf-only 1
mkdir -p "$work/sort-failure/Include/10.0.26100.0/ucrt"
negative sort-failure 42 sort-failure
printf 'PASS: %s SDK discovery cases under errexit/nounset/pipefail\n' "$passed"
