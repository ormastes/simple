#!/bin/sh
# check-numeric-method-family-dispatch.shs
#
# Fences doc/08_tracking/bug/float_and_int_math_methods_missing_on_numeric_receivers_2026-08-10.md.
#
# DEFECT. Only five math METHODS resolved on a numeric receiver:
# sqrt/abs/floor/ceil/round -- exactly the inline Cranelift-instruction set in
# codegen/instr/methods.rs and codegen/instr/closures_structs.rs. Everything
# else declared in the method registry (trunc/sin/cos/tan/.../pow/max/min) had
# NO reachable lowering and failed at runtime:
#
#     val b: f64 = 16.0
#     print b.sin()     # Runtime error: Function 'f64.sin' not found
#     print b.trunc()   # Runtime error: Function 'f64.trunc' not found
#     print b.pow(2.0)  # Runtime error: Function 'f64.pow' not found
#     print b.max(7.0)  # Runtime error: Function 'f64.max' not found
#     val i: i64 = -3
#     print i.abs()     # Runtime error: Function 'i64.abs' not found
#
# ROOT CAUSE (two independent points, both required):
#  1. `Lowerer::builtin_numeric_method_result_type` (hir/lower/expr/mod.rs)
#     only stamped a concrete result type (F64/F32) for sqrt/abs/floor/ceil/
#     round. Every other math method stayed TypeId::ANY, which is immaterial
#     to whether codegen even attempts a static lowering (Dynamic vs Static
#     DispatchMode both funnel through `MirInst::MethodCallStatic`), but which
#     regressed float-boxing at the call site if left unfixed alongside point 2.
#  2. `try_compile_builtin_method_call` (codegen/instr/closures_structs.rs) --
#     the ACTUAL dispatch site for method calls lowered as
#     `MirInst::MethodCallStatic` -- only special-cased sqrt/abs/floor/ceil/
#     round as native Cranelift instructions and had no fallback to the
#     already-existing `rt_math_*` runtime symbols (which the FREE-FUNCTION
#     forms `sin(x)`/`pow(a,b)` already used via
#     `mir/lower/lowering_expr_builtin.rs::lower_libm_math`). A SEPARATE,
#     decoy dispatch table of the same name lives in
#     `codegen/instr/methods.rs::compile_builtin_method`, reached only via
#     `MirInst::BuiltinMethod` -- which real method-call HIR never emits. Fixing
#     only that decoy table (an earlier iteration of this fix) changed nothing
#     observable; the fix must land in closures_structs.rs.
#     Additionally, `codegen/common_backend.rs::referenced_call_names` must
#     pre-declare the `rt_math_*` symbols this path can now emit (mirroring
#     the pre-existing `MirInst::BuiltinMethod` arm), or codegen panics with
#     "missing runtime fn 'rt_math_sin'" the first time an uncommon one is hit.
#
# WHY THIS ASSERTS COMPUTED VALUES. All of these previously errored loudly, so
# just checking "did not error" is not enough; each row's expected value is
# hand-computed so a wrong-but-non-erroring codegen path (e.g. `max` computing
# `min`, or `trunc` computing `round`) is still caught.
#
# RELATION TO SIBLING CHECKS. check-numeric-builtin-result-type.shs covers the
# free-FUNCTION forms (`sqrt(16.0)`). check-float-method-argument-position.shs
# covers the argument-position float-boxing defect for the five ALREADY-WORKING
# methods. This check is the METHOD-receiver complement for the family that had
# NO lowering at all. None of the three subsumes another.
#
# LANES. Default (`run`, JIT-first with interpreter fallback) and
# SIMPLE_JIT_STRICT=1 (JIT, no silent fallback).
#
# Verdict line is the last line of stdout:
#   PASS  -- <n> assertions checked, n > 0    exit 0
#   FAIL  -- ...                              exit 1
#   ERROR -- nothing was checked               exit 2

set -u

BIN="${SIMPLE_BIN:-bin/release/x86_64-unknown-linux-gnu/simple}"
if [ ! -x "$BIN" ]; then
    echo "ERROR — nothing was checked (no runnable binary at $BIN)"
    exit 2
fi

# PROVENANCE GUARD — same rationale as the sibling checks: a binary built
# before the fix source landed fails these assertions for the wrong reason.
_prov_files="src/compiler_rust/compiler/src/codegen/instr/closures_structs.rs src/compiler_rust/compiler/src/codegen/common_backend.rs src/compiler_rust/compiler/src/hir/lower/expr/mod.rs"
_bin_epoch=$(stat -c '%Y' "$BIN" 2>/dev/null || stat -f '%m' "$BIN" 2>/dev/null)
if [ -n "$_bin_epoch" ]; then
    for _f in $_prov_files; do
        [ -f "$_f" ] || continue
        _src_iso=$(git log -1 --format='%cI' -- "$_f" 2>/dev/null)
        [ -n "$_src_iso" ] || continue
        _src_epoch=$(date -d "$_src_iso" +%s 2>/dev/null || date -j -f '%Y-%m-%dT%H:%M:%S%z' "$_src_iso" +%s 2>/dev/null)
        [ -n "$_src_epoch" ] || continue
        if [ "$_src_epoch" -gt "$_bin_epoch" ]; then
            echo "ERROR — nothing was checked ($BIN predates fix commit for $_f: binary mtime $_bin_epoch < source commit $_src_epoch — rebuild/redeploy the binary before trusting this gate's verdict)"
            exit 2
        fi
    done
fi

WORK="${TMPDIR:-/tmp}/nummethodfamily.$$"
mkdir -p "$WORK" || { echo "ERROR — nothing was checked (cannot create $WORK)"; exit 2; }
trap 'rm -rf "$WORK"' EXIT INT TERM

CHECKED=0
FAILED=0

run_case() {
    _label="$1"; _lane="$2"; _src="$3"; _expect="$4"
    printf '%s\n' "$_src" > "$WORK/case.spl"
    case "$_lane" in
        default) _got=$(SIMPLE_RUST_SEED_WARNING=0 "$BIN" run "$WORK/case.spl" 2>/dev/null) ;;
        jit)     _got=$(SIMPLE_JIT_STRICT=1 SIMPLE_RUST_SEED_WARNING=0 "$BIN" "$WORK/case.spl" 2>/dev/null) ;;
        *)       echo "ERROR — nothing was checked (bad lane $_lane)"; exit 2 ;;
    esac
    CHECKED=$((CHECKED + 1))
    if [ "$_got" = "$_expect" ]; then
        echo "  ok   [$_lane] $_label -> $_got"
        return 0
    fi
    echo "  FAIL [$_lane] $_label: expected '$_expect', got '$_got'"
    FAILED=$((FAILED + 1))
    return 1
}

echo "check-numeric-method-family-dispatch — binary: $BIN"
ls -l "$BIN" 2>/dev/null | awk '{print "  size/mtime: " $5 " " $6 " " $7 " " $8}'
echo

for LANE in default jit; do
    echo "--- lane: $LANE ---"

    # ---- THE PREVIOUSLY-UNRESOLVED FAMILY ----
    run_case "b.trunc()"    "$LANE" 'fn main():
    val b: f64 = 3.7
    print b.trunc()' '3.0'
    run_case "b.trunc() (neg)" "$LANE" 'fn main():
    val b: f64 = -3.7
    print b.trunc()' '-3.0'
    run_case "b.sin()"      "$LANE" 'fn main():
    val b: f64 = 0.0
    print b.sin()' '0.0'
    run_case "b.cos()"      "$LANE" 'fn main():
    val b: f64 = 0.0
    print b.cos()' '1.0'
    run_case "b.pow(x)"     "$LANE" 'fn main():
    val b: f64 = 2.0
    print b.pow(3.0)' '8.0'
    run_case "b.max(x)"     "$LANE" 'fn main():
    val b: f64 = 3.0
    print b.max(5.0)' '5.0'
    run_case "b.min(x)"     "$LANE" 'fn main():
    val b: f64 = 3.0
    print b.min(5.0)' '3.0'
    run_case "i.abs() (i64)" "$LANE" 'fn main():
    val i: i64 = -3
    print i.abs()' '3'
    run_case "i.abs() (positive control)" "$LANE" 'fn main():
    val i: i64 = 3
    print i.abs()' '3'

    # ---- REGRESSION CONTROL: the five methods that already worked must keep
    # working after adding native Cranelift `trunc`/`iabs` to the same guarded
    # block they share code with. ----
    run_case "b.sqrt() (control)" "$LANE" 'fn main():
    val b: f64 = 16.0
    print b.sqrt()' '4.0'
    run_case "b.abs() (float, control)" "$LANE" 'fn main():
    val b: f64 = -1.5
    print b.abs()' '1.5'
    run_case "b.floor() (control)" "$LANE" 'fn main():
    val b: f64 = 1.7
    print b.floor()' '1.0'
    run_case "b.ceil() (control)" "$LANE" 'fn main():
    val b: f64 = 1.2
    print b.ceil()' '2.0'
    run_case "b.round() (control)" "$LANE" 'fn main():
    val b: f64 = 1.7
    print b.round()' '2.0'

    echo
done

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi
if [ "$FAILED" -ne 0 ]; then
    echo "FAIL — $FAILED of $CHECKED assertions failed"
    exit 1
fi
echo "PASS — $CHECKED assertions checked, all matched the computed expected value"
exit 0
