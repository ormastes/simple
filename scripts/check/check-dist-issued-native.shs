#!/bin/sh
# Build exact Linux distributed-build native candidates from an admitted
# self-hosted Stage 4 compiler. This does not install or authorize workers.
set -eu

usage() {
    echo "usage: $0 STAGE4_BINARY STAGE4_PROVENANCE" >&2
    exit 2
}
[ "$#" -eq 2 ] || usage
[ "$(uname -s)" = Linux ] || {
    echo 'dist-issued-native: BLOCKED reason=linux-qualification-host-required' >&2
    exit 2
}

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
BOOTSTRAP_STAGE3_FACADE_PATH="$repo_root/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="$repo_root/scripts/check/lib/stage4-candidate-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"
. "$repo_root/scripts/lib/host-executable.shs"
unset SIMPLE_HOST_RESOLVER_FIXTURE_MODE

compiler=$(bootstrap_stage3_canonical_file "$1") || {
    echo 'dist-issued-native: BLOCKED reason=compiler-path-not-canonical' >&2
    exit 2
}
provenance=$(bootstrap_stage3_canonical_file "$2") || {
    echo 'dist-issued-native: BLOCKED reason=provenance-path-not-canonical' >&2
    exit 2
}
[ -x "$compiler" ] && [ "$provenance" = "${compiler}.provenance.env" ] || {
    echo 'dist-issued-native: BLOCKED reason=stage4-provenance-not-adjacent' >&2
    exit 2
}
source_clean() {
    status=$(git -C "$repo_root" status --porcelain --untracked-files=all \
        --ignore-submodules=none) || return 1
    [ -z "$status" ]
}
valid_sha256() {
    case "$1" in ''|*[!0-9a-f]*) return 1 ;; esac
    [ "${#1}" -eq 64 ]
}

# Require a clean checkout, then compile a private archive of HEAD. The
# mutable working tree is never a source input to the native builds.
if ! source_clean; then
    echo 'dist-issued-native: BLOCKED reason=source-worktree-not-clean' >&2
    exit 2
fi
stage4_verify_candidate_provenance "$provenance" "$compiler" "$repo_root" || {
    echo 'dist-issued-native: BLOCKED reason=stage4-provenance-invalid' >&2
    exit 2
}
source_commit=$(git -C "$repo_root" rev-parse HEAD)
source_tree=$(git -C "$repo_root" rev-parse 'HEAD^{tree}')
case "$repo_root:$compiler:$provenance" in
    *[!A-Za-z0-9/._:-]*)
        echo 'dist-issued-native: BLOCKED reason=input-path-not-receipt-safe' >&2
        exit 2
        ;;
esac
compiler_hash=$(sha256sum "$compiler")
compiler_hash=${compiler_hash%% *}
provenance_hash=$(sha256sum "$provenance")
provenance_hash=${provenance_hash%% *}
valid_sha256 "$compiler_hash" && valid_sha256 "$provenance_hash" || {
    echo 'dist-issued-native: BLOCKED reason=input-hash-invalid' >&2
    exit 2
}
admitted_compiler_hash=$(bootstrap_stage3_manifest_value output_sha256 \
    "$provenance") || exit 2
if [ "$compiler_hash" != "$admitted_compiler_hash" ]; then
    echo 'dist-issued-native: BLOCKED reason=stage4-output-changed' >&2
    exit 2
fi
if [ -x /usr/bin/clang ]; then
    host_cc=/usr/bin/clang
elif [ -x /usr/bin/cc ]; then
    host_cc=/usr/bin/cc
else
    echo 'dist-issued-native: BLOCKED reason=host-c-compiler-unavailable' >&2
    exit 2
fi
host_cc=$(readlink -f "$host_cc") || exit 2
host_ld=$(readlink -f /usr/bin/ld) || exit 2
[ -x "$host_cc" ] && [ -x "$host_ld" ] || {
    echo 'dist-issued-native: BLOCKED reason=host-linker-unavailable' >&2
    exit 2
}
host_cc_hash=$(sha256sum "$host_cc") || exit 2
host_cc_hash=${host_cc_hash%% *}
host_ld_hash=$(sha256sum "$host_ld") || exit 2
host_ld_hash=${host_ld_hash%% *}
valid_sha256 "$host_cc_hash" && valid_sha256 "$host_ld_hash" || exit 2

umask 077
if [ -L "$repo_root/build" ]; then
    echo 'dist-issued-native: BLOCKED reason=build-root-symlinked' >&2
    exit 2
fi
mkdir -p "$repo_root/build"
candidate_root=$(mktemp -d "$repo_root/build/dist-issued-native.XXXXXX") || exit 2
printf 'dist-issued-native: candidate_root=%s\n' "$candidate_root"
source_root="$candidate_root/source"
mkdir "$source_root" || exit 2
git -C "$repo_root" archive --format=tar --output="$candidate_root/source.tar" \
    "$source_commit" || exit 2
source_archive_hash=$(sha256sum "$candidate_root/source.tar")
source_archive_hash=${source_archive_hash%% *}
valid_sha256 "$source_archive_hash" || exit 2
tar -xf "$candidate_root/source.tar" -C "$source_root" || exit 2
chmod -R a-w "$source_root" || exit 2
captured_compiler="$candidate_root/stage4-simple"
captured_provenance="$candidate_root/stage4-simple.provenance.env"
cp "$compiler" "$captured_compiler" || exit 2
cp "$provenance" "$captured_provenance" || exit 2
chmod 500 "$captured_compiler" || exit 2
captured_hash=$(sha256sum "$captured_compiler")
captured_hash=${captured_hash%% *}
captured_provenance_hash=$(sha256sum "$captured_provenance")
captured_provenance_hash=${captured_provenance_hash%% *}
if [ "$captured_hash" != "$compiler_hash" ] ||
   [ "$captured_provenance_hash" != "$provenance_hash" ]; then
    echo 'dist-issued-native: BLOCKED reason=captured-toolchain-mismatch' >&2
    exit 2
fi

build_one() {
    name=$1
    entry=$2
    output="$candidate_root/$name"
    cache="$candidate_root/cache-$name"
    log="$candidate_root/$name.build.log"
    if ! (cd "$source_root" && timeout -k 15s 1800s \
        env -i PATH=/usr/bin:/bin HOME="$candidate_root" TMPDIR="$candidate_root" \
        SIMPLE_CC="$host_cc" SIMPLE_LIB="$source_root/src" \
        SIMPLE_RUNTIME_PATH= SIMPLE_NATIVE_RUNTIME_BUNDLE= \
        SIMPLE_NO_STUB_FALLBACK=1 \
        "$captured_compiler" native-build \
        --source src/compiler --source src/app --source src/lib \
        --entry-closure --entry "$entry" --strip \
        --runtime-bundle core-c-bootstrap \
        --cache-dir "$cache" --output "$output") >"$log" 2>&1; then
        printf 'dist-issued-native: BLOCKED reason=native-build-failed entry=%s log=%s\n' "$entry" "$log" >&2
        return 1
    fi
    if [ -L "$output" ] || [ ! -f "$output" ] || [ ! -x "$output" ] ||
       ! simple_host_executable_compatible "$output" linux; then
        printf 'dist-issued-native: BLOCKED reason=native-output-incompatible entry=%s log=%s\n' "$entry" "$log" >&2
        return 1
    fi
    output_hash=$(sha256sum "$output") || return 1
    output_hash=${output_hash%% *}
    log_hash=$(sha256sum "$log") || return 1
    log_hash=${log_hash%% *}
    valid_sha256 "$output_hash" && valid_sha256 "$log_hash" || return 1
    printf '%s\n' "$output_hash" >"$output.sha256" || return 1
    printf 'product=%s|%s|%s|%s|%s\n' "$name" "$entry" \
        "$output_hash" "$log_hash" "$output" >>"$candidate_root/products.tmp" || return 1
}

if ! build_one simple_dist_build_issued_graph_parent \
        src/app/build/scheduler/parent_issued_graph_main.spl ||
   ! build_one simple_dist_build_issued_parent \
        src/app/build/scheduler/parent_issued_staged_main.spl ||
   ! build_one simple-build-worker \
        src/app/build/scheduler/worker_main.spl ||
   ! build_one simple_dist_exec_verifier \
        src/app/build/scheduler/dist_exec_verifier_main.spl ||
   ! build_one simple_dist_exec_worker \
        src/app/build/scheduler/dist_exec_worker.spl; then
    echo 'dist-issued-native: BLOCKED reason=candidate-incomplete' >&2
    exit 2
fi

# A source change during native-build invalidates the candidate. The checker
# does not copy any binary into bin/release or write administrator config.
source_commit_after=$(git -C "$repo_root" rev-parse HEAD) || exit 2
source_tree_after=$(git -C "$repo_root" rev-parse 'HEAD^{tree}') || exit 2
if ! source_clean ||
   [ "$source_commit_after" != "$source_commit" ] ||
   [ "$source_tree_after" != "$source_tree" ]; then
    echo 'dist-issued-native: BLOCKED reason=source-changed-during-build' >&2
    exit 2
fi
compiler_hash_after=$(sha256sum "$compiler")
compiler_hash_after=${compiler_hash_after%% *}
provenance_hash_after=$(sha256sum "$provenance")
provenance_hash_after=${provenance_hash_after%% *}
captured_hash_after=$(sha256sum "$captured_compiler")
captured_hash_after=${captured_hash_after%% *}
host_cc_hash_after=$(sha256sum "$host_cc")
host_cc_hash_after=${host_cc_hash_after%% *}
host_ld_hash_after=$(sha256sum "$host_ld")
host_ld_hash_after=${host_ld_hash_after%% *}
if [ "$compiler_hash_after" != "$compiler_hash" ] ||
   [ "$provenance_hash_after" != "$provenance_hash" ] ||
   [ "$captured_hash_after" != "$compiler_hash" ] ||
   [ "$host_cc_hash_after" != "$host_cc_hash" ] ||
   [ "$host_ld_hash_after" != "$host_ld_hash" ]; then
    echo 'dist-issued-native: BLOCKED reason=compiler-or-provenance-changed-during-build' >&2
    exit 2
fi

{
    printf 'schema=simple-dist-issued-native-candidate-v1\n'
    printf 'status=CANDIDATE_BUILT_UNQUALIFIED\n'
    printf 'source_commit=%s\nsource_tree=%s\n' "$source_commit" "$source_tree"
    printf 'source_archive_sha256=%s\n' "$source_archive_hash"
    printf 'compiler_path=%s\ncompiler_sha256=%s\n' "$compiler" "$compiler_hash"
    printf 'stage4_provenance_sha256=%s\n' "$provenance_hash"
    printf 'host_cc_path=%s\nhost_cc_sha256=%s\n' "$host_cc" "$host_cc_hash"
    # The compiler driver may select another linker; these are host hints,
    # not proof of the linker that was invoked.
    printf 'host_ld_hint_path=%s\nhost_ld_hint_sha256=%s\n' "$host_ld" "$host_ld_hash"
    printf 'runtime_bundle=core-c-bootstrap\n'
    printf 'build_path=/usr/bin:/bin\n'
    printf 'host=linux\n'
    printf 'product_count=5\n'
    cat "$candidate_root/products.tmp"
} >"$candidate_root/receipt.tmp"
mv "$candidate_root/receipt.tmp" "$candidate_root/receipt.env"
mv "$candidate_root/products.tmp" "$candidate_root/products.txt"
printf 'dist-issued-native: CANDIDATE_BUILT_UNQUALIFIED receipt=%s\n' \
    "$candidate_root/receipt.env"
