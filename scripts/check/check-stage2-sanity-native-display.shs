#!/bin/sh
# Native syntax is admitted only for immutable sanity display, not authorities.
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
. "$root/scripts/check/lib/bootstrap-stage3/authority.shs"
. "$root/scripts/check/lib/bootstrap-stage3/sanity.shs"
count=0
native_fixture=SKIPPED-non-Windows
reject() {
  if bootstrap_stage3_sanity_display_absolute "$1"; then
    printf 'FAIL: admitted display %s\n' "$1"; exit 1
  fi
  count=$((count + 1))
}
bootstrap_stage3_sanity_display_absolute /owned/sanity.env
count=$((count + 1))
for invalid in 'C:relative.env' 'C:/a/../sanity.env' 'C:/a/./sanity.env' \
  'C:/a//sanity.env' 'C:/a/sanity.env:stream' 'C:\a\sanity.env' \
  'C:/a/' '//server/share/sanity.env' 'C:/a/*.env' 'C:/a/[x].env' \
  'C:/C:/a.env' 'C:/a b.env'; do reject "$invalid"; done
case "$(uname -s)" in
  MSYS*|MINGW*|CYGWIN*)
    bootstrap_stage3_sanity_display_absolute C:/owned/sanity.env
    count=$((count + 1))
    if bootstrap_stage3_normalized_absolute C:/owned/sanity.env; then
      echo 'FAIL: unrelated POSIX authority validator widened'; exit 1
    fi
    count=$((count + 1))
    native_fixture=PASS
    SIMPLE_TEST_SANITY_NATIVE_DISPLAY=1 sh "$root/scripts/check/check-stage2-sanity-artifact-binding.shs"
    ;;
esac
# Host simulation proves drive displays fail closed without native Windows.
uname() { printf 'Linux\n'; }
reject C:/owned/sanity.env
printf 'PASS: %s display cases; unchanged POSIX authority; native bound/relocated fixture=%s\n' "$count" "$native_fixture"