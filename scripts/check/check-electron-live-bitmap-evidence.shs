#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

BUILD_DIR="${BUILD_DIR:-build/electron_live_bitmap_evidence}"
REPORT_PATH="${REPORT_PATH:-doc/09_report/electron_live_bitmap_evidence_$(date -u +%F).md}"
export BUILD_DIR REPORT_PATH

# Compatibility entrypoint; the canonical gate owns exact-ARGB fixture wiring.
exec sh scripts/check/check-electron-simple-web-engine2d-image-taskbar-command-bitmap-evidence.shs
