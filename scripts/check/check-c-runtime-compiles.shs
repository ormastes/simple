#!/bin/sh
# check-c-runtime-compiles.shs -- sixth mandatory pre-push guard.
#
# WHY THIS EXISTS
# ---------------
# The other five guards are all git-TREE-shaped: they recognise .jjconflict*
# entries, literal conflict-marker text, structurally wrong tree sizes, test
# tree divergence, and large-scale reverts. NONE of them opens a C file and
# asks a compiler whether it is valid. That gap let
# src/runtime/runtime_native.c reach main in a state that DID NOT COMPILE AT
# ALL -- the unsigned-value-semantics campaign landed 8 call sites referencing
# RtCoreUInt / rt_core_as_heap_uint / rt_value_u64 / rt_value_as_u64 while the
# typedef, kind constant, allocator, accessor and registry entry were never
# written. 33 clang errors sat at origin/main, green, for days, and it was the
# reason there was NO working native compile path on any host.
# See doc/08_tracking/bug/
#   runtime_native_c_uncompilable_unsigned_box_never_implemented_2026-08-11.md
#
# WHAT IT CHECKS
# --------------
# Every src/runtime/*.c is syntax-checked with the SAME flags the real build
# lane uses (src/compiler/70.backend/backend/runtime_compiler.spl: -std=gnu11,
# -I src/runtime, -I src/runtime/platform). A file that does not compile is a
# FAIL. This is deliberately a syntax/semantic check, not a link: it is fast
# (a few seconds) and it catches the entire class of defect above.
#
# VERDICT CONVENTION (matches the other five guards; last line of stdout):
#   PASS  -- <n> file(s) checked, 0 errors        exit 0   (n is always > 0)
#   FAIL  -- <n> file(s) failed to compile: ...   exit 1
#   ERROR -- nothing was checked                  exit 2
# A run that checks 0 files is an ERROR, not a pass.
#
# --selftest runs before every scan and is FATAL.

set -u

SKIP_REASON_counterpart_worker_runtime="needs vendored simple_counterpart_abi.h (external SDK header)"
SKIP_REASON_scv_wasm_shim="needs wasmtime.h (external wasmtime C API)"

verdict_error() {
    printf 'ERROR -- nothing was checked (%s)\n' "$1"
    exit 2
}

# Fail closed on cwd: these guards have historically passed vacuously when run
# from an archive worktree with no .git. Refuse rather than check nothing.
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || \
    verdict_error "not inside a git repository"
[ -n "$REPO_ROOT" ] || verdict_error "could not resolve repo root"
cd "$REPO_ROOT" || verdict_error "could not enter repo root"
[ -d src/runtime ] || verdict_error "src/runtime is missing"

CC=""
for cand in /usr/bin/clang clang gcc cc; do
    if command -v "$cand" >/dev/null 2>&1; then CC="$cand"; break; fi
done
[ -n "$CC" ] || verdict_error "no C compiler found (clang/gcc/cc)"

CFLAGS_SYNTAX="-fsyntax-only -std=gnu11 -I src/runtime -I src/runtime/platform"

# Compile one file. Echoes nothing on success; on failure echoes diagnostics.
# Returns 0 = clean, 1 = real error, 2 = failed ONLY because an external
# third-party header is absent (allowed for the two roster-skipped files).
compile_one() {
    _f=$1
    # Key on the compiler's EXIT STATUS, never on output emptiness: several
    # runtime files legitimately emit WARNINGS, and treating any non-empty
    # stderr as failure made this guard fire on clean files.
    _out=$($CC $CFLAGS_SYNTAX "$_f" 2>&1)
    if [ $? -eq 0 ]; then return 0; fi
    # A missing EXTERNAL header is the one tolerated shape, and only for files
    # on the skip roster. Anything else -- including a syntax error in those
    # same files -- is a real failure, so the skip cannot fail open.
    if printf '%s' "$_out" | grep -q "fatal error: '.*\.h' file not found" && \
       [ "$(printf '%s' "$_out" | grep -c 'error:')" -eq 1 ]; then
        return 2
    fi
    printf '%s\n' "$_out" | grep 'error:' | head -5
    return 1
}

is_skipped() {
    case $1 in
        counterpart_worker_runtime|scv_wasm_shim) return 0 ;;
        *) return 1 ;;
    esac
}

# ---------------------------------------------------------------- selftest --
# Fatal, runs before every scan. Proves the checker actually reports RED on a
# broken file and GREEN on a good one -- i.e. that a PASS means something.
run_selftest() {
    _tmp=$(mktemp -d) || verdict_error "mktemp failed"
    _fixtures=0
    _bad=0

    # Fixture 1: a well-formed translation unit must be clean.
    cat > "$_tmp/good.c" <<'EOF'
#include <stdint.h>
typedef struct Box { uint32_t kind; uint32_t scope; uint64_t value; } Box;
static uint64_t read_box(Box* b) { return b->value; }
uint64_t entry(Box* b) { return read_box(b); }
EOF
    _fixtures=$((_fixtures + 1))
    if ! $CC $CFLAGS_SYNTAX "$_tmp/good.c" >/dev/null 2>&1; then
        echo "selftest: FIXTURE 'good' should compile clean but did not"
        _bad=$((_bad + 1))
    fi

    # Fixture 2: EXACTLY the shape of the defect this guard exists for --
    # a call site using an undeclared box type and accessor.
    cat > "$_tmp/undeclared_box.c" <<'EOF'
#include <stdint.h>
int64_t entry(int64_t v) {
    RtCoreUInt* u = rt_core_as_heap_uint(v);
    return u ? (int64_t)u->value : 0;
}
EOF
    _fixtures=$((_fixtures + 1))
    if $CC $CFLAGS_SYNTAX "$_tmp/undeclared_box.c" >/dev/null 2>&1; then
        echo "selftest: FIXTURE 'undeclared_box' compiled -- guard is FAIL-OPEN"
        _bad=$((_bad + 1))
    fi

    # Fixture 2b: a file that compiles but emits WARNINGS must be clean. The
    # first cut of this guard keyed on output emptiness instead of exit status
    # and so reported FAIL on src/runtime/runtime.c, which only warns.
    cat > "$_tmp/warns.c" <<'EOF'
#include <stdint.h>
int entry(void) { int unused_local = 5; (void)0; return 0; }
EOF
    _fixtures=$((_fixtures + 1))
    compile_one "$_tmp/warns.c" >/dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo "selftest: FIXTURE 'warns' must be clean (warnings are not errors)"
        _bad=$((_bad + 1))
    fi

    # Fixture 3: a missing EXTERNAL header must be classified 2, not 1, so the
    # roster skip is exercised rather than assumed.
    cat > "$_tmp/extern_header.c" <<'EOF'
#include <definitely_not_a_real_header_xyz.h>
int entry(void) { return 0; }
EOF
    _fixtures=$((_fixtures + 1))
    compile_one "$_tmp/extern_header.c" >/dev/null 2>&1
    if [ $? -ne 2 ]; then
        echo "selftest: FIXTURE 'extern_header' misclassified"
        _bad=$((_bad + 1))
    fi

    # Fixture 4: a skip-rostered shape with a REAL syntax error must still be
    # classified 1 -- proves the skip cannot launder a genuine defect.
    cat > "$_tmp/broken_syntax.c" <<'EOF'
int entry(void) { return ; ; ) }
EOF
    _fixtures=$((_fixtures + 1))
    compile_one "$_tmp/broken_syntax.c" >/dev/null 2>&1
    if [ $? -ne 1 ]; then
        echo "selftest: FIXTURE 'broken_syntax' misclassified"
        _bad=$((_bad + 1))
    fi

    rm -rf "$_tmp"
    if [ "$_bad" -ne 0 ]; then
        printf 'FAIL -- selftest %d/%d fixtures wrong\n' "$_bad" "$_fixtures"
        exit 1
    fi
    printf 'check-c-runtime-compiles: selftest %d/%d fixtures correct\n' \
        "$_fixtures" "$_fixtures"
}

run_selftest
[ "${1:-}" = "--selftest" ] && exit 0

# -------------------------------------------------------------------- scan --
checked=0
skipped=0
failed=0
failed_names=""

for f in src/runtime/*.c; do
    [ -e "$f" ] || continue
    name=$(basename "$f" .c)
    compile_one "$f"
    rc=$?
    if [ $rc -eq 0 ]; then
        checked=$((checked + 1))
    elif [ $rc -eq 2 ] && is_skipped "$name"; then
        skipped=$((skipped + 1))
    else
        checked=$((checked + 1))
        failed=$((failed + 1))
        failed_names="$failed_names $name"
        echo "  ^^ in $f"
    fi
done

if [ "$checked" -eq 0 ]; then
    verdict_error "no src/runtime/*.c files were compiled"
fi

if [ "$failed" -ne 0 ]; then
    printf 'FAIL -- %d of %d file(s) failed to compile:%s\n' \
        "$failed" "$checked" "$failed_names"
    exit 1
fi

printf 'PASS -- %d file(s) checked, 0 errors (%d skipped: external headers)\n' \
    "$checked" "$skipped"
exit 0
