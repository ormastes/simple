#!/bin/sh
# check-mcp-config-launchable.shs
#
# Asserts that every path-form stdio server declared in an MCP config file
# actually LAUNCHES on this platform and answers a real `initialize` request
# with a well-formed `serverInfo`.
#
# Why this exists
# ---------------
# `.mcp.json` declares `"command": "bin/simple_mcp_server"` — a forward-slash,
# extensionless, repo-relative path. Whether that string launches on Windows
# depends entirely on HOW the client spawns it, and the two mechanisms disagree:
#
#   * Claude Code resolves the launcher itself (PATHEXT-aware, slash-tolerant)
#     and connects.  Measured 2026-09-01: `claude mcp list` => "✔ Connected".
#   * A cmd.exe-mediated spawn (Node `spawn(..., {shell:true})`, or Node
#     spawning a `.cmd` at all) FAILS with rc=1 and
#     "'bin' is not recognized as an internal or external command".
#
# So a config that "looks fine" can be dead for one client and alive for
# another, and liveness alone proves nothing: this exact server was previously
# a perfect silent green (rc=0, 0 bytes stdout, 0 bytes stderr). This guard
# therefore asserts CONTENT (`serverInfo` + a non-empty server name), never
# just an exit status.
#
# Resolution model (deliberately mirrors what a client must do):
#   Windows/MSYS : the literal path, else the same path + .cmd / .bat / .exe
#                  (PATHEXT).  A `.cmd` sibling is a legitimate resolution.
#   POSIX        : the literal path, and it must be executable.
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> declared server(s) checked, <n> answered initialize   exit 0
#   FAIL  — ... naming every offender                                 exit 1
#   ERROR — nothing was checked (<reason>)                            exit 2
# A run that checked 0 servers is ERROR, never a pass.
#
# Usage:
#   sh scripts/check/check-mcp-config-launchable.shs [config.json ...]
#   sh scripts/check/check-mcp-config-launchable.shs --selftest

set -u

TIMEOUT_SECONDS="${MCP_LAUNCH_PROBE_TIMEOUT:-90}"

is_windows_host() {
    case "$(uname -s 2>/dev/null || printf 'unknown')" in
        MINGW*|MSYS*|CYGWIN*) return 0 ;;
        *) return 1 ;;
    esac
}

probe_timeout() {
    _seconds=$1
    shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "${_seconds}" "$@"
    elif command -v gtimeout >/dev/null 2>&1; then
        gtimeout "${_seconds}" "$@"
    else
        "$@"
    fi
}

# Emit "name<TAB>command" for each server in an MCP config's mcpServers block.
extract_servers() {
    awk '
        /"mcpServers"[[:space:]]*:/ { in_servers = 1; next }
        in_servers && /^[[:space:]]*"[A-Za-z0-9_.-]+"[[:space:]]*:[[:space:]]*\{/ {
            line = $0
            sub(/^[[:space:]]*"/, "", line)
            sub(/"[[:space:]]*:.*$/, "", line)
            name = line
            next
        }
        in_servers && /"command"[[:space:]]*:/ {
            line = $0
            sub(/^.*"command"[[:space:]]*:[[:space:]]*"/, "", line)
            sub(/".*$/, "", line)
            if (name != "") { printf "%s\t%s\n", name, line; name = "" }
        }
    ' "$1"
}

# Resolve a declared command to a launchable file path, or print nothing.
resolve_launcher() {
    _root=$1
    _cmd=$2
    if is_windows_host; then
        # A backslash form is the cmd.exe-safe spelling; normalise it for the
        # filesystem probe so both spellings are checked identically.
        _cmd="$(printf '%s' "${_cmd}" | tr '\\' '/')"
    fi
    _base="${_root}/${_cmd}"
    if is_windows_host; then
        for _ext in ".cmd" ".bat" ".exe" ".com" ""; do
            if [ -f "${_base}${_ext}" ]; then
                printf '%s' "${_base}${_ext}"
                return 0
            fi
        done
    else
        if [ -x "${_base}" ]; then
            printf '%s' "${_base}"
            return 0
        fi
    fi
    return 1
}

# Run a real initialize handshake through a resolved launcher.
# Prints the raw stdout; returns 0 only when serverInfo with a name came back.
probe_initialize() {
    _launcher=$1
    _root=$2
    _out=$3
    _req='{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"mcp-config-launchable-guard","version":"1"}}}'
    (
        cd "${_root}" || exit 127
        printf '%s\n' "${_req}" | \
            SIMPLE_LOG=error RUST_LOG=error \
            probe_timeout "${TIMEOUT_SECONDS}" "${_launcher}" >"${_out}" 2>/dev/null
    )
    # Content, not liveness: a silent exit 0 must not pass.
    if grep -q '"serverInfo"' "${_out}" 2>/dev/null \
        && grep -q '"protocolVersion"' "${_out}" 2>/dev/null \
        && grep -qE '"serverInfo"[[:space:]]*:[[:space:]]*\{[^}]*"name"[[:space:]]*:[[:space:]]*"[^"]+"' "${_out}" 2>/dev/null; then
        return 0
    fi
    return 1
}

scan_config() {
    _config=$1
    _root=$2
    if [ ! -f "${_config}" ]; then
        printf 'missing config: %s\n' "${_config}" >&2
        return 2
    fi
    _pairs="$(extract_servers "${_config}")"
    if [ -z "${_pairs}" ]; then
        printf 'no mcpServers entries parsed from %s\n' "${_config}" >&2
        return 2
    fi
    _tmp="$(mktemp 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}/mcp_probe.$$")"
    printf '%s\n' "${_pairs}" | while IFS="$(printf '\t')" read -r name cmd; do
        [ -n "${name}" ] || continue
        case "${cmd}" in
            */*|*\\*) : ;;
            *)
                printf 'SKIP   %-16s command=%s (PATH-resolved external launcher)\n' "${name}" "${cmd}"
                continue
                ;;
        esac
        launcher="$(resolve_launcher "${_root}" "${cmd}")"
        if [ -z "${launcher}" ]; then
            printf 'FAIL   %-16s command=%s (no launchable file resolves on this platform)\n' "${name}" "${cmd}"
            printf '%s\n' "${name}" >>"${_tmp}.offenders"
            printf '%s\n' "${name}" >>"${_tmp}.checked"
            continue
        fi
        if probe_initialize "${launcher}" "${_root}" "${_tmp}.out"; then
            server_name="$(sed -n 's/.*"serverInfo"[^{]*{[^}]*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${_tmp}.out" | head -1)"
            printf 'OK     %-16s command=%s resolved=%s serverInfo.name=%s\n' \
                "${name}" "${cmd}" "${launcher#"${_root}/"}" "${server_name}"
        else
            printf 'FAIL   %-16s command=%s resolved=%s (no well-formed serverInfo; bytes=%s)\n' \
                "${name}" "${cmd}" "${launcher#"${_root}/"}" "$(wc -c <"${_tmp}.out" 2>/dev/null | tr -d ' ')"
            printf '%s\n' "${name}" >>"${_tmp}.offenders"
        fi
        printf '%s\n' "${name}" >>"${_tmp}.checked"
    done
    CHECKED_COUNT=0
    OFFENDER_COUNT=0
    OFFENDER_NAMES=""
    if [ -f "${_tmp}.checked" ]; then
        CHECKED_COUNT="$(wc -l <"${_tmp}.checked" | tr -d ' ')"
    fi
    if [ -f "${_tmp}.offenders" ]; then
        OFFENDER_COUNT="$(wc -l <"${_tmp}.offenders" | tr -d ' ')"
        OFFENDER_NAMES="$(tr '\n' ' ' <"${_tmp}.offenders" | sed 's/ *$//')"
    fi
    rm -f "${_tmp}" "${_tmp}.out" "${_tmp}.checked" "${_tmp}.offenders"
    return 0
}

selftest() {
    _dir="$(mktemp -d 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}/mcp_guard_selftest.$$")"
    mkdir -p "${_dir}/bin" || return 1
    _fails=0
    _ran=0

    _mk_good() {
        # $1 = basename (no extension)
        cat >"${_dir}/bin/$1" <<'SH'
#!/bin/sh
read -r _line
printf '{"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"2025-06-18","capabilities":{},"serverInfo":{"name":"fixture-server","version":"1.0.0"}}}\n'
SH
        chmod +x "${_dir}/bin/$1"
        if is_windows_host; then
            printf '@echo off\r\nset /p _line=\r\necho {"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"2025-06-18","capabilities":{},"serverInfo":{"name":"fixture-server","version":"1.0.0"}}}\r\n' \
                >"${_dir}/bin/$1.cmd"
        fi
    }

    _mk_silent() {
        cat >"${_dir}/bin/$1" <<'SH'
#!/bin/sh
exit 0
SH
        chmod +x "${_dir}/bin/$1"
        if is_windows_host; then
            printf '@echo off\r\nexit /b 0\r\n' >"${_dir}/bin/$1.cmd"
        fi
    }

    _write_cfg() {
        # $1 = file, $2 = server name, $3 = command
        cat >"$1" <<EOF
{
  "mcpServers": {
    "$2": {
      "command": "$3",
      "args": [],
      "cwd": "."
    }
  }
}
EOF
    }

    _assert() {
        # $1 = label, $2 = expected verdict word, $3 = actual verdict word
        _ran=$((_ran + 1))
        if [ "$2" = "$3" ]; then
            printf 'selftest OK   %s (expected %s)\n' "$1" "$2"
        else
            printf 'selftest FAIL %s (expected %s, got %s)\n' "$1" "$2" "$3"
            _fails=$((_fails + 1))
        fi
    }

    _verdict_of() {
        # runs a scan and echoes PASS/FAIL/ERROR
        scan_config "$1" "$2" >/dev/null 2>&1
        _rc=$?
        if [ "${_rc}" -eq 2 ]; then printf 'ERROR'; return 0; fi
        if [ "${CHECKED_COUNT:-0}" -eq 0 ]; then printf 'ERROR'; return 0; fi
        if [ "${OFFENDER_COUNT:-0}" -gt 0 ]; then printf 'FAIL'; return 0; fi
        printf 'PASS'
    }

    # (a) a launcher that answers initialize with serverInfo must PASS
    _mk_good good_server
    _write_cfg "${_dir}/good.json" "fixture" "bin/good_server"
    _assert "answering launcher" "PASS" "$(_verdict_of "${_dir}/good.json" "${_dir}")"

    # (b) silent green (exit 0, zero output) must FAIL, not pass on liveness
    _mk_silent silent_server
    _write_cfg "${_dir}/silent.json" "fixture" "bin/silent_server"
    _assert "silent-green launcher" "FAIL" "$(_verdict_of "${_dir}/silent.json" "${_dir}")"

    # (c) a command that resolves to no file must FAIL
    _write_cfg "${_dir}/missing.json" "fixture" "bin/no_such_launcher"
    _assert "unresolvable command" "FAIL" "$(_verdict_of "${_dir}/missing.json" "${_dir}")"

    # (d) a config with no mcpServers entries must ERROR, never pass
    printf '{\n  "mcpServers": {\n  }\n}\n' >"${_dir}/empty.json"
    _assert "empty config" "ERROR" "$(_verdict_of "${_dir}/empty.json" "${_dir}")"

    # (e) a PATH-form external launcher is SKIPped, so a config of only those
    #     checks nothing and must ERROR rather than report a vacuous pass
    _write_cfg "${_dir}/external.json" "fixture" "bash"
    _assert "external-only config" "ERROR" "$(_verdict_of "${_dir}/external.json" "${_dir}")"

    rm -rf "${_dir}"
    printf 'selftest %s/%s fixtures correct\n' "$((_ran - _fails))" "${_ran}"
    [ "${_fails}" -eq 0 ]
}

main() {
    if [ "${1:-}" = "--selftest" ]; then
        if selftest; then
            printf 'PASS — selftest only\n'
            exit 0
        fi
        printf 'FAIL — selftest fixtures disagree\n'
        exit 1
    fi

    if ! selftest >/dev/null 2>&1; then
        printf 'ERROR — nothing was checked (selftest failed; run --selftest)\n'
        exit 2
    fi

    root="$(CDPATH= cd "$(dirname "$0")/../.." && pwd)"
    if [ "$#" -eq 0 ]; then
        set -- "${root}/.mcp.json"
    fi

    total_checked=0
    total_offenders=0
    all_offenders=""
    for config in "$@"; do
        printf '== %s ==\n' "${config}"
        if ! scan_config "${config}" "${root}"; then
            printf 'ERROR — nothing was checked (unreadable or unparsable config: %s)\n' "${config}"
            exit 2
        fi
        total_checked=$((total_checked + CHECKED_COUNT))
        total_offenders=$((total_offenders + OFFENDER_COUNT))
        if [ -n "${OFFENDER_NAMES}" ]; then
            all_offenders="${all_offenders} ${OFFENDER_NAMES}"
        fi
    done

    if [ "${total_checked}" -eq 0 ]; then
        printf 'ERROR — nothing was checked (0 path-form servers declared)\n'
        exit 2
    fi
    if [ "${total_offenders}" -gt 0 ]; then
        printf 'FAIL — %s declared server(s) checked, %s did not answer initialize:%s\n' \
            "${total_checked}" "${total_offenders}" "${all_offenders}"
        exit 1
    fi
    printf 'PASS — %s declared server(s) checked, %s answered initialize with serverInfo\n' \
        "${total_checked}" "${total_checked}"
    exit 0
}

main "$@"
