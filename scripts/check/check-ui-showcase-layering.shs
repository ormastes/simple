#!/bin/sh
# check-ui-showcase-layering.shs — enforce the SimpleOS UI-showcase layering rule.
#
# THE RULE
#   src/app/ui_showcase/*.spl                 (STRICT, depth 1)
#       May import ONLY:  std.*  |  common.ui.*  |  the ScreenHost trait
#                         |  a sibling module inside src/app/ui_showcase/
#       Must NOT import:  engine2d, SDL/SDL2, winit, os.*, virtio, or any other
#                         backend-specific module.
#   src/app/ui_showcase/hosts/**/*.spl        (PERMISSIVE)
#       May import backend-specific modules freely, but must NOT import os.*
#       (that boundary keeps Workstream B out of Workstream C's kernel/driver
#       territory).
#
# This is what makes "same logic, different HAL" mechanically verifiable rather
# than aspirational: the showcase logic literally cannot name a backend.
#
# WHY A SCRIPT AND NOT `bin/simple check-arch`
#   The repo's arch mechanism (src/app/cli/arch_check.spl) is real and supports
#   allow/deny import patterns — but its rules live EXCLUSIVELY in `arch { }`
#   blocks inside `__init__.spl` files (scan_arch_rules() at line 283 does
#   `find <root> -name '__init__.spl'`, and ArchRule.rule_file is only ever set
#   to that discovered path or ""). There is NO out-of-tree rule-file
#   mechanism. Expressing this rule there would require creating
#   src/app/ui_showcase/__init__.spl and src/app/ui_showcase/hosts/__init__.spl
#   — files owned by another workstream. It would also inherit the collision
#   the split was designed to avoid: one `__init__.spl` rule applies to every
#   file in its module, so the strict rule would fire on the host impls it is
#   meant to permit. Hence this standalone guard, which honors the split
#   directly. Its import extraction MIRRORS _parse_imports_from_content()
#   (arch_check.spl:334): line-leading `use `, path terminated by space, `(`,
#   `{`, or `*`, trailing dot stripped — so a violation cannot hide in a form
#   the production parser accepts and this one misses.
#
# FAIL-CLOSED CONTRACT (this repo has a documented history of vacuous guards)
#   Exactly one verdict line is printed, always last on stdout:
#     PASS  — <n> file(s) checked ...        exit 0   (n is ALWAYS > 0)
#     FAIL  — <n> file(s) checked, <v> ...   exit 1
#     SKIP  — ...                            exit 0   ONLY with --allow-missing
#     ERROR — nothing was checked ...        exit 2
#   A directory that is absent, or present but holding zero .spl files, is an
#   ERROR by default — never a PASS. `--allow-missing` downgrades the absent
#   case to SKIP for pre-landing CI wiring; SKIP is textually distinct from
#   PASS, so a vacuous run can never be mistaken for a real one.
#   A `--selftest` runs BEFORE every real scan and is fatal: it builds a
#   compliant tree and a violating tree in a temp dir and asserts PASS/FAIL.
#
# USAGE
#   sh scripts/check/check-ui-showcase-layering.shs [--root DIR] [--allow-missing]
#   sh scripts/check/check-ui-showcase-layering.shs --selftest-only

set -u

SELF=check-ui-showcase-layering
SHOWCASE_REL=src/app/ui_showcase

ROOT=""
ALLOW_MISSING=0
SELFTEST_ONLY=0

while [ $# -gt 0 ]; do
    case "$1" in
        --root) ROOT="${2:-}"; shift 2 || exit 2 ;;
        --root=*) ROOT="${1#--root=}"; shift ;;
        --allow-missing) ALLOW_MISSING=1; shift ;;
        --selftest-only) SELFTEST_ONLY=1; shift ;;
        -h|--help)
            sed -n '2,50p' "$0"; exit 0 ;;
        *)
            echo "$SELF: ERROR — unknown argument '$1'" >&2
            echo "$SELF: ERROR — nothing was checked (exit 2)"
            exit 2 ;;
    esac
done

die_error() {
    echo "$SELF: ERROR — $1" >&2
    echo "$SELF: ERROR — nothing was checked (exit 2)"
    exit 2
}

# ---------------------------------------------------------------------------
# Import extraction — mirrors arch_check.spl:_parse_imports_from_content
# ---------------------------------------------------------------------------
# Emits one dot-notation module path per line. Also recognises `from X use Y`,
# which the production parser does not model, so that form cannot be used as an
# escape hatch.
extract_imports() {
    # $1 = file
    sed -e 's/^[[:space:]]*//' "$1" 2>/dev/null \
    | sed -n -e 's/^use[[:space:]]\{1,\}\([^[:space:](\{\*]\{1,\}\).*$/\1/p' \
             -e 's/^from[[:space:]]\{1,\}\([^[:space:](\{\*]\{1,\}\).*$/\1/p' \
    | sed -e 's/\.$//' \
    | grep -v '^$'
}

# ---------------------------------------------------------------------------
# Classifiers
# ---------------------------------------------------------------------------
# A backend-specific module the STRICT dir must never name. Matched first so
# the failure message can say "forbidden backend module" rather than the vaguer
# "not on allowlist".
is_backend_module() {
    case "$1" in
        engine2d|engine2d.*|*.engine2d|*.engine2d.*) return 0 ;;
        sdl|sdl.*|sdl2|sdl2.*|*.sdl|*.sdl.*|*.sdl2|*.sdl2.*) return 0 ;;
        winit|winit.*|*.winit|*.winit.*) return 0 ;;
        virtio|virtio.*|*.virtio|*.virtio.*) return 0 ;;
        wgpu|wgpu.*|x11|x11.*|wayland|wayland.*|drm|drm.*) return 0 ;;
        *) return 1 ;;
    esac
}

# os.* — forbidden in BOTH tiers (Workstream C territory).
is_os_module() {
    case "$1" in
        os|os.*|std.os|std.os.*) return 0 ;;
        *) return 1 ;;
    esac
}

# What the STRICT tier is permitted to name.
# STRICT_DIR is set by scan_tree; a dotless module name is admitted ONLY when a
# real sibling file exists for it. Without that gate, `use framebuffer` /
# `use compositor` / `use gpu_backend` would sail through as "bare sibling
# name" — an open-ended hole that would force the deny list to carry work the
# allowlist should be doing.
strict_allows() {
    m=$1
    is_os_module "$m" && return 1
    is_backend_module "$m" && return 1
    case "$m" in
        std|std.*)                     return 0 ;;   # standard library
        common.ui|common.ui.*)         return 0 ;;   # render-land
        lib.common.ui|lib.common.ui.*) return 0 ;;
        screen_host|*.screen_host)     return 0 ;;   # the ScreenHost trait
        ui_showcase.hosts|ui_showcase.hosts.*) return 1 ;;  # never reach down
        ui_showcase|ui_showcase.*)     return 0 ;;   # sibling in strict dir
        app.ui_showcase.hosts|app.ui_showcase.hosts.*) return 1 ;;
        app.ui_showcase|app.ui_showcase.*) return 0 ;;
        *.*)                           return 1 ;;
        *)                             return 0 ;;   # bare sibling module name
    esac
}

# ---------------------------------------------------------------------------
# The scan. Prints violations to stderr; echoes "<checked> <violations>".
# ---------------------------------------------------------------------------
scan_tree() {
    tree_root=$1
    dir="$tree_root/$SHOWCASE_REL"
    checked=0
    violations=0

    # STRICT tier: depth-1 .spl files.
    strict_list=$(find "$dir" -maxdepth 1 -name '*.spl' -type f 2>/dev/null | sort)
    # PERMISSIVE tier: everything under hosts/.
    hosts_list=$(find "$dir/hosts" -name '*.spl' -type f 2>/dev/null | sort)

    oldifs=$IFS
    IFS='
'
    for f in $strict_list; do
        [ -n "$f" ] || continue
        [ -r "$f" ] || { echo "$SELF: unreadable: $f" >&2; violations=$((violations + 1)); continue; }
        checked=$((checked + 1))
        rel=${f#"$tree_root"/}
        for m in $(extract_imports "$f"); do
            if is_os_module "$m"; then
                echo "$SELF: VIOLATION [strict] $rel imports '$m' — os.* is kernel/driver territory (Workstream C)" >&2
                violations=$((violations + 1))
            elif is_backend_module "$m"; then
                echo "$SELF: VIOLATION [strict] $rel imports '$m' — forbidden backend module; showcase logic must be target-agnostic" >&2
                violations=$((violations + 1))
            elif ! strict_allows "$m"; then
                echo "$SELF: VIOLATION [strict] $rel imports '$m' — not on allowlist (std.* | common.ui.* | ScreenHost | ui_showcase sibling)" >&2
                violations=$((violations + 1))
            fi
        done
    done

    for f in $hosts_list; do
        [ -n "$f" ] || continue
        [ -r "$f" ] || { echo "$SELF: unreadable: $f" >&2; violations=$((violations + 1)); continue; }
        checked=$((checked + 1))
        rel=${f#"$tree_root"/}
        for m in $(extract_imports "$f"); do
            if is_os_module "$m"; then
                echo "$SELF: VIOLATION [hosts] $rel imports '$m' — hosts may use backends but never os.* (Workstream C territory)" >&2
                violations=$((violations + 1))
            fi
        done
    done
    IFS=$oldifs

    echo "$checked $violations"
}

# ---------------------------------------------------------------------------
# Selftest — fatal, runs before every real scan.
# ---------------------------------------------------------------------------
run_selftest() {
    tmp=$(mktemp -d) || die_error "cannot mktemp"

    # Fixture A: compliant.
    mkdir -p "$tmp/good/$SHOWCASE_REL/hosts" || die_error "cannot build fixture A"
    cat > "$tmp/good/$SHOWCASE_REL/showcase_core.spl" <<'EOF'
use std.text
use common.ui.layout
use common.ui.screen_host.ScreenHost
fn render() -> text: "ok"
EOF
    cat > "$tmp/good/$SHOWCASE_REL/hosts/sdl_host.spl" <<'EOF'
use engine2d.canvas
use sdl2.window
use common.ui.screen_host.ScreenHost
EOF

    # Fixture B: strict file reaching for a backend, plus a host reaching for os.*.
    mkdir -p "$tmp/bad/$SHOWCASE_REL/hosts" || die_error "cannot build fixture B"
    cat > "$tmp/bad/$SHOWCASE_REL/showcase_core.spl" <<'EOF'
use std.text
use engine2d.canvas
EOF
    cat > "$tmp/bad/$SHOWCASE_REL/hosts/kernel_host.spl" <<'EOF'
use os.virtio_gpu
EOF

    good=$(scan_tree "$tmp/good" 2>/dev/null)
    bad=$(scan_tree "$tmp/bad" 2>/dev/null)
    empty=$(scan_tree "$tmp/nonexistent" 2>/dev/null)
    rm -rf "$tmp"

    ok=1
    [ "$good" = "2 0" ] || { echo "$SELF: selftest: compliant fixture gave '$good', want '2 0'" >&2; ok=0; }
    [ "$bad" = "2 2" ]  || { echo "$SELF: selftest: violating fixture gave '$bad', want '2 2'" >&2; ok=0; }
    [ "$empty" = "0 0" ] || { echo "$SELF: selftest: absent tree gave '$empty', want '0 0'" >&2; ok=0; }
    [ "$ok" = 1 ] || die_error "selftest failed; the detector is not trustworthy"
    SELFTEST_FIXTURES=3
}

SELFTEST_FIXTURES=0
# Always. There is no flag or env var that turns this off.
run_selftest

if [ "$SELFTEST_ONLY" = 1 ]; then
    echo "$SELF: PASS — $SELFTEST_FIXTURES fixture(s) checked (selftest only, scan skipped)"
    exit 0
fi

# ---------------------------------------------------------------------------
# Real scan.
# ---------------------------------------------------------------------------
if [ -z "$ROOT" ]; then
    ROOT=$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd) || die_error "cannot resolve repo root"
fi
[ -d "$ROOT" ] || die_error "root '$ROOT' is not a directory"

DIR="$ROOT/$SHOWCASE_REL"
if [ ! -d "$DIR" ]; then
    if [ "$ALLOW_MISSING" = 1 ]; then
        echo "$SELF: SKIP — $SHOWCASE_REL does not exist yet (0 files checked, $SELFTEST_FIXTURES selftest fixture(s) passed); rerun once it lands"
        exit 0
    fi
    die_error "$SHOWCASE_REL does not exist under $ROOT (pass --allow-missing to downgrade to SKIP)"
fi

result=$(scan_tree "$ROOT")
CHECKED=${result% *}
VIOLATIONS=${result#* }

if [ "$CHECKED" -eq 0 ]; then
    if [ "$ALLOW_MISSING" = 1 ]; then
        echo "$SELF: SKIP — $SHOWCASE_REL exists but holds no .spl files (0 files checked)"
        exit 0
    fi
    die_error "$SHOWCASE_REL exists but holds no .spl files"
fi

if [ "$VIOLATIONS" -gt 0 ]; then
    echo "$SELF: FAIL — $CHECKED file(s) checked in $SHOWCASE_REL, $VIOLATIONS layering violation(s) (listed above)"
    exit 1
fi
echo "$SELF: PASS — $CHECKED file(s) checked in $SHOWCASE_REL, 0 layering violation(s) (root $ROOT)"
exit 0
