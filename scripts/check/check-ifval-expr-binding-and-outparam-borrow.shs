#!/bin/sh
# Fail-closed gate for the two defects fixed in
# doc/08_tracking/bug/io_runtime_import_borrow_local13_native_build_2026-08-24.md
#
#   Defect 1 (seed interpreter): `Expr::If` carries `let_pattern`, but the
#     EXPRESSION-position evaluator (interpreter/expr/control.rs) destructured
#     it away with `..`. `val x = if val v = e: ... else: ...` therefore took
#     the then-branch on truthiness with `v` NEVER BOUND, and every read of `v`
#     died with `variable `v` not found`. The compiler's own
#     `lower_index_expr` (50.mir/_MirLoweringExpr/expr_dispatch.spl:1794) uses
#     exactly that shape, so native-build of any module whose lowering reached
#     it failed with `variable `type_` not found`.
#
#   Defect 2 (borrow checker): 55.borrow never ends a borrow -- `end_borrow`
#     has no callers and `propagate_borrows` copies every borrow forward
#     unconditionally -- and the `Return` arm ignored the `liveness` argument
#     it was handed. So EVERY function containing any `Ref` was rejected at
#     EVERY return. `process_read_stdout_result`'s out-parameter borrow
#     (`f(pid, &mut status)`), which the call consumes and which never escapes,
#     produced `borrow of `local(13)` may still be active at return`.
#
# Verdict is the LAST line of stdout:
#   PASS — <n> case(s) checked   exit 0
#   FAIL — ...                   exit 1
#   ERROR — nothing was checked  exit 2
#
# --selftest runs FIRST and is FATAL.

set -u

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
SEED="$ROOT/src/compiler_rust/target/release/simple"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

CHECKED=0
FAILED=""

die_error() {
    printf 'ERROR — nothing was checked (%s)\n' "$1"
    exit 2
}

# ---------------------------------------------------------------- selftest --
# The selftest proves the scanner's own primitives discriminate, using
# fixtures whose verdicts are known independently of the compiler under test.
selftest() {
    st_fail=""

    # 1. absent-signature detection must FIRE on a log that contains it.
    printf 'error: semantic: variable `type_` not found\n' > "$WORK/st1.log"
    if ! grep -q 'variable `type_` not found' "$WORK/st1.log"; then
        st_fail="$st_fail signature-detect-miss"
    fi
    # 2. ...and must NOT fire on a clean log.
    printf 'all good\n' > "$WORK/st2.log"
    if grep -q 'variable `type_` not found' "$WORK/st2.log"; then
        st_fail="$st_fail signature-detect-false-positive"
    fi
    # 3. borrow signature detection, both directions.
    printf 'borrow of `local(13)` may still be active at return\n' > "$WORK/st3.log"
    if ! grep -q 'may still be active at return' "$WORK/st3.log"; then
        st_fail="$st_fail borrow-detect-miss"
    fi
    if grep -q 'may still be active at return' "$WORK/st2.log"; then
        st_fail="$st_fail borrow-detect-false-positive"
    fi
    # 4. exit-status capture must read the command's OWN status, never a
    #    pipeline's. Four false greens in this repo came from piped `$?`.
    (exit 7)
    st_rc=$?
    if [ "$st_rc" -ne 7 ]; then
        st_fail="$st_fail exit-status-capture-broken"
    fi
    # 5. the seed must exist and be executable; absence of a compiler is
    #    absence of evidence, never a pass.
    if [ ! -x "$SEED" ]; then
        st_fail="$st_fail seed-missing"
    fi

    if [ -n "$st_fail" ]; then
        printf 'ERROR — nothing was checked (selftest failed:%s)\n' "$st_fail"
        exit 2
    fi
}

selftest

if [ "${1:-}" = "--selftest" ]; then
    printf 'PASS — 5 selftest fixture(s) checked\n'
    exit 0
fi

# ------------------------------------------------------------- case A --
# `if val` in EXPRESSION position must bind its name. Runs under the seed
# directly (no native-build), so this isolates defect 1.
# NOTE: the payload is `text`, deliberately. An i64 Option payload comes back
# left-shifted by 3 (`Some(40)` binds as 320) under the seed -- a SEPARATE,
# PRE-EXISTING tagging defect that reproduces identically in the STATEMENT
# form (`if val v = ...:` as a statement), so it is not this fix's business
# and must not be baked into this gate's expectations.
cat > "$WORK/a.spl" <<'EOF'
fn name_of(n: i64) -> text?:
    if n > 0:
        return Some("alpha")
    return nil

fn pick(n: i64) -> text:
    val out = if val v = name_of(n):
        "then:" + v
    else:
        "else"
    out

fn main():
    print(pick(3))
    print(pick(-1))
EOF
"$SEED" run "$WORK/a.spl" > "$WORK/a.log" 2>&1
A_RC=$?
CHECKED=$((CHECKED + 1))
if [ "$A_RC" -ne 0 ]; then
    FAILED="$FAILED ifval-expr-binding(rc=$A_RC)"
elif ! grep -q 'then:alpha' "$WORK/a.log"; then
    FAILED="$FAILED ifval-expr-binding(name-not-bound)"
elif ! grep -q '^else$' "$WORK/a.log"; then
    FAILED="$FAILED ifval-expr-binding(nil-did-not-take-else)"
fi

# ------------------------------------------------------------- case B --
# The sharp edge the fix changed: presence, not truthiness, decides the
# branch. `Some(0)` is PRESENT and must take the THEN branch. The pre-fix
# code decided by `truthy()` on the condition value.
cat > "$WORK/b.spl" <<'EOF'
fn zero() -> i64?:
    Some(0)

fn main():
    val r = if val v = zero():
        "then"
    else:
        "else"
    print("r={r}")
EOF
"$SEED" run "$WORK/b.spl" > "$WORK/b.log" 2>&1
B_RC=$?
CHECKED=$((CHECKED + 1))
if [ "$B_RC" -ne 0 ]; then
    FAILED="$FAILED ifval-some-zero(rc=$B_RC)"
elif ! grep -q 'r=then' "$WORK/b.log"; then
    FAILED="$FAILED ifval-some-zero(took-else)"
fi

# ------------------------------------------------------------- case C --
# End-to-end: a module that needed defect 1's fix must native-build AND run.
cat > "$WORK/c.spl" <<'EOF'
use std.nogc_sync_mut.io.signal_stubs

fn main():
    print("c ok")
EOF
"$SEED" native-build "$WORK/c.spl" -o "$WORK/c.bin" > "$WORK/c.log" 2>&1
C_RC=$?
CHECKED=$((CHECKED + 1))
if [ "$C_RC" -ne 0 ]; then
    FAILED="$FAILED signal-stubs-native-build(rc=$C_RC)"
else
    "$WORK/c.bin" > "$WORK/c.out" 2>&1
    C_RUN=$?
    if [ "$C_RUN" -ne 0 ] || ! grep -q 'c ok' "$WORK/c.out"; then
        FAILED="$FAILED signal-stubs-run(rc=$C_RUN)"
    fi
fi

# ------------------------------------------------------------- case D --
# The io_runtime importer from the bug record. Neither filed signature may
# appear. This case deliberately does NOT require rc=0: a THIRD, separate
# defect (`E-BACKEND-LLVM-INST-ResultMatchSemantic`: the LLVM backend does not
# lower ResultMatchSemantic) still blocks this module and is out of scope
# here. Asserting rc=0 would make this gate untrue; asserting signature
# absence is exactly what these two fixes are responsible for.
cat > "$WORK/d.spl" <<'EOF'
use std.nogc_sync_mut.io_runtime

fn main():
    val v = env_get("HOME")
    print("d ok")
EOF
"$SEED" native-build "$WORK/d.spl" -o "$WORK/d.bin" > "$WORK/d.log" 2>&1
D_RC=$?
CHECKED=$((CHECKED + 1))
if grep -q 'variable `type_` not found' "$WORK/d.log"; then
    FAILED="$FAILED io_runtime-type_-unbound"
fi
CHECKED=$((CHECKED + 1))
if grep -q 'may still be active at return' "$WORK/d.log"; then
    FAILED="$FAILED io_runtime-outparam-borrow-at-return"
fi
# Non-vacuity: the log must show the build actually ran the pipeline. An
# empty or truncated log would make the two greps above vacuously pass.
if [ ! -s "$WORK/d.log" ]; then
    die_error "io_runtime native-build produced no output"
fi

# ------------------------------------------------------------- verdict --
if [ "$CHECKED" -eq 0 ]; then
    die_error "no case executed"
fi

if [ -n "$FAILED" ]; then
    printf 'FAIL — %d case(s) checked, offender(s):%s\n' "$CHECKED" "$FAILED"
    exit 1
fi

printf 'PASS — %d case(s) checked\n' "$CHECKED"
exit 0
