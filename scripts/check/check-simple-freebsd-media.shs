#!/bin/sh
# Focused contract test for offline FreeBSD QEMU media supply and wrapper wiring.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
media=${root}/scripts/qemu/simple-freebsd-media.shs
wrapper=${root}/scripts/check/check-freebsd-bootstrap-qemu.shs

sh -n "${media}"
sh -n "${wrapper}"
"${media}" --self-test | grep -qx 'freebsd_media_self_test=pass'
grep -Fq 'simple_qemu_image_root=' "${root}/scripts/qemu/simple-big-storage-root.shs"
grep -Fq 'FREEBSD_MEDIA_CHECKER=' "${wrapper}"
grep -Fq 'preflight_base_image_integrity' "${wrapper}"
grep -Fq 'SIMPLE_FREEBSD_MEDIA_SHA256="${QEMU_BASE_VM_SHA256:-}"' "${wrapper}"
printf '%s\n' 'simple_freebsd_media_contract=pass'
