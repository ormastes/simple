#!/bin/sh
set -eu

cmo=src/lib/nogc_async_mut_noalloc/baremetal/riscv/cmo.spl
rv32=src/os/kernel/arch/riscv32/hal_cache.spl
rv64=src/os/kernel/arch/riscv64/hal_cache.spl

tagged=$(grep -c '^@unsafe(reason: ".*unsigned target provider", capabilities: \[ffi\])$' "$cmo")
test "$tagged" -eq 8 || {
    echo "FAIL: expected 8 tagged CMO declarations, found $tagged" >&2
    exit 1
}

lexical=$(grep -c '^    unsafe(capabilities: \[ffi\]):$' "$cmo")
test "$lexical" -eq 8 || {
    echo "FAIL: expected 8 lexical CMO calls, found $lexical" >&2
    exit 1
}

for text in \
    '1u64 + (len - 1u64) / stride' \
    'if count > 0xFFFFFFFFu64: 0xFFFFFFFFu32 else: count as u32' \
    'or stride == 0u32'; do
    grep -Fq "$text" "$cmo" || {
        echo "FAIL: missing O(1) count contract: $text" >&2
        exit 1
    }
done

for file in "$rv32" "$rv64"; do
    grep -Fq 'val last_addr = addr + len - 1' "$file" || {
        echo "FAIL: $file missing overflow-safe last address" >&2
        exit 1
    }
    grep -Fq 'if last_addr - cur < stride' "$file" || {
        echo "FAIL: $file missing overflow-safe terminal line check" >&2
        exit 1
    }
    if grep -Fq 'val end_addr = addr + len' "$file"; then
        echo "FAIL: $file retains wrapping cache-range endpoint" >&2
        exit 1
    fi
done

count=$(grep -c 'stride > 0u32 and len > 0u64' "$rv64")
test "$count" -eq 3 || {
    echo "FAIL: RV64 production loops do not all reject zero stride" >&2
    exit 1
}

if grep -Eiq '(malloc|calloc|realloc|dlsym|dlopen|mutex|sleep|retry)' "$cmo" "$rv32" "$rv64"; then
    echo 'FAIL: CMO hot path gained allocation, lookup, lock, or retry work' >&2
    exit 1
fi

echo 'PASS: RISC-V CMO authority, O(1) counts, and overflow-safe hot-path shape'
