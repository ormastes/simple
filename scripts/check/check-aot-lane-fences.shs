#!/bin/sh
# check-aot-lane-fences.shs — run every AOT-lane regression fence, fail closed.
#
# WHY THIS EXISTS
# ---------------
# `bin/simple test` hard-defaults to the tree-walk interpreter and
# TestExecutionMode has no AOT/native variant, so NO SPEC CAN EVER OBSERVE the
# `native-build` lane. AOT defects therefore hide behind a fully green spec
# corpus. The only working fence for that lane is a script that drives the real
# native-build binary — which is what each script listed below does.
#
# But on 2026-08-08 an audit found that none of those nine scripts was
# referenced by any workflow, hook, or aggregate gate. Nine fences that nothing
# runs are ADVERTISED COVERAGE THAT DOES NOT EXIST — arguably worse than no
# fence, because their presence in the tree reads as protection. This aggregator
# is the missing caller.
#
# EXIT CODES (matching the repo's pre-push guard convention)
#   0  PASS  — every fence ran and passed. The verdict line states how many.
#   1  FAIL  — at least one fence reported a real regression.
#   2  ERROR — nothing (or not everything) was actually measured. NOT a pass.
#
# An exit 2 is deliberately distinct from exit 1: "the gate could not run" and
# "the gate ran and found a defect" demand different responses, and collapsing
# them is how a vacuous run gets mistaken for a green one.
#
# Individual fences use exit 2 for the same meaning (missing llvm-as, absent
# strace, an unparseable cache receipt, a native-build timeout). Those propagate
# here as ERROR, never as PASS.
#
# Usage:
#   sh scripts/check/check-aot-lane-fences.shs            # run all
#   sh scripts/check/check-aot-lane-fences.shs --list     # print the roster
#
# Env:
#   AOT_FENCE_ONLY="name1 name2"   run only these (basename, no .shs)
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
cd "$REPO_ROOT" || { echo "ERROR — nothing was checked (cannot cd to repo root)"; exit 2; }

# The roster. Adding an AOT fence WITHOUT adding it here leaves it unrun, which
# is the exact failure this script was written to end.
FENCES="
check-native-tuple-to-text
check-native-enum-match-payload
check-native-extern-fabrication
check-native-object-cache-granularity
check-native-option-eq-representation
check-native-utf8-slice
check-rt-io-file-native-jit-stub
check-native-option-bool-llvm-verify
check-u32-array-not-packed
"

if [ "${1:-}" = "--list" ]; then
    for f in $FENCES; do echo "$f"; done
    exit 0
fi

only="${AOT_FENCE_ONLY:-}"

# Fail closed on an empty roster: a `FENCES` list that got emptied by a bad edit
# would otherwise sail through every loop below and print a green verdict having
# run nothing at all.
count_total=0
for f in $FENCES; do count_total=$((count_total + 1)); done
if [ "$count_total" -eq 0 ]; then
    echo "ERROR — nothing was checked (the fence roster is empty)"
    exit 2
fi

# Fail closed on a missing fence file: treating an absent script as a skip is how
# a deleted or never-committed fence becomes invisible. Three of these nine were
# uncommitted working-copy files as recently as 2026-08-08.
missing=""
for f in $FENCES; do
    [ -f "scripts/check/$f.shs" ] || missing="$missing $f"
done
if [ -n "$missing" ]; then
    echo "ERROR — nothing was checked; these fences are named in the roster but absent from the tree:$missing"
    echo "        A missing fence is NOT a skip. Either restore it or remove it from FENCES."
    exit 2
fi

LOG_DIR="${AOT_FENCE_LOG_DIR:-build/check/aot-lane-fences}"
mkdir -p "$LOG_DIR" || { echo "ERROR — nothing was checked (cannot create $LOG_DIR)"; exit 2; }

n_run=0
n_pass=0
n_fail=0
n_error=0
failed_names=""
error_names=""

for f in $FENCES; do
    if [ -n "$only" ]; then
        case " $only " in
            *" $f "*) ;;
            *) continue ;;
        esac
    fi
    log="$LOG_DIR/$f.log"
    printf '=== %s ===\n' "$f"
    rc=0
    sh "scripts/check/$f.shs" >"$log" 2>&1 || rc=$?
    n_run=$((n_run + 1))
    # Echo the fence's own verdict lines so CI output is readable without
    # downloading artifacts. Each fence prints PASS/FAIL/KNOWN-OPEN/NOTE/ERROR
    # at the start of a line by convention.
    grep -E '^(PASS|FAIL|ERROR|WARN|NOTE|KNOWN-OPEN|SKIPPED)' "$log" || tail -n 5 "$log"
    case "$rc" in
        0) n_pass=$((n_pass + 1)) ;;
        2) n_error=$((n_error + 1)); error_names="$error_names $f" ;;
        *) n_fail=$((n_fail + 1)); failed_names="$failed_names $f" ;;
    esac
    printf '    -> rc=%s (log: %s)\n\n' "$rc" "$log"
done

if [ "$n_run" -eq 0 ]; then
    echo "ERROR — nothing was checked (AOT_FENCE_ONLY='$only' matched no fence in the roster)"
    exit 2
fi

if [ "$n_error" -gt 0 ]; then
    echo "ERROR — $n_run fence(s) invoked, but$error_names could not measure anything (exit 2)."
    echo "        This is NOT a pass and NOT a defect report — the gate did not run."
    [ "$n_fail" -gt 0 ] && echo "        Additionally FAILED:$failed_names"
    exit 2
fi

if [ "$n_fail" -gt 0 ]; then
    echo "FAIL — $n_run fence(s) checked, $n_pass passed, $n_fail failed:$failed_names"
    exit 1
fi

echo "PASS — $n_run AOT-lane fence(s) checked, all $n_pass passed"
exit 0
