#!/bin/sh
# check-no-document-symlinks-push.shs — fail-closed push guard.
#
# Incident 2026-09-12/13: commit df7ac9f6cc2 rewrote 57 tracked symlinks so the
# git blob under mode 120000 held the WHOLE TEXT of the file the link used to
# point at (e.g. `.claude/commands/*.md` at ~150 KB, `bin/mail`,
# `src/app/lint/main.spl`). A symlink's blob IS its target path, so checkout
# calls symlink() with a multi-kilobyte "target": on macOS that fails with
# ENAMETOOLONG (PATH_MAX 1024) and every fresh checkout/rebase of main dies —
# taking the required CI gate with it, because CI cannot even check out.
#
# Every existing push guard is blind to this: conflict-tree and conflict-marker
# guards read CONTENT, the tree-size guard counts FILES, and the content here is
# a perfectly well-formed document. Only the MODE is wrong.
#
# Classification (a tree property, so this guard scans the whole NEW tip, not
# the range delta — a base that is already broken must not launder later pushes
# into a green verdict, the fail-open shape vcs.md documents for the seed guard):
# a `120000` entry whose blob is > 1024 bytes, or contains a newline, or is
# empty, is a document, not a link target.
#
# Verdict is always the LAST line of stdout:
#   PASS  — <n> symlink entr(y|ies) checked, 0 document-content        exit 0
#   FAIL  — <n> checked, <k> carry document content: <names>           exit 1
#   ERROR — nothing was checked (<reason>)                             exit 2
# A run that examined 0 TREE ENTRIES is ERROR; a tree with zero symlinks is a
# legitimate PASS (n counts tree entries scanned, which is never 0 for a repo).

set -u

MAX_TARGET_BYTES=1024

usage() {
    echo "usage: $0 [--rev <commit>] [--selftest]" >&2
}

scan_rev() {
    # $1 = rev. Prints offenders one per line; sets globals via a temp file.
    _rev=$1
    _entries=$(git ls-tree -r "$_rev" 2>/dev/null | wc -l | tr -d ' ')
    [ -n "$_entries" ] || _entries=0
    if [ "$_entries" -eq 0 ]; then
        EV_CHECKED=0
        EV_SYMLINKS=0
        EV_OFFENDERS=""
        EV_OFFENDER_COUNT=0
        return 0
    fi
    _tmp=$(mktemp) || return 2
    git ls-tree -r "$_rev" | while IFS= read -r _line; do
        case "$_line" in
            120000\ *) ;;
            *) continue ;;
        esac
        _blob=$(printf '%s' "$_line" | awk '{print $3}')
        _path=$(printf '%s' "$_line" | cut -f2-)
        _size=$(git cat-file -s "$_blob" 2>/dev/null)
        [ -n "$_size" ] || _size=0
        _nl=$(git cat-file blob "$_blob" 2>/dev/null | LC_ALL=C tr -cd '\n' | wc -c | tr -d ' ')
        [ -n "$_nl" ] || _nl=0
        if [ "$_size" -gt "$MAX_TARGET_BYTES" ] || [ "$_nl" -gt 0 ] || [ "$_size" -eq 0 ]; then
            printf '%s\t%s\n' "$_path" "$_size" >> "$_tmp"
        fi
        printf 'S\n' >> "$_tmp.s"
    done
    EV_CHECKED=$_entries
    EV_SYMLINKS=$( [ -f "$_tmp.s" ] && wc -l < "$_tmp.s" | tr -d ' ' || echo 0 )
    EV_OFFENDER_COUNT=$( [ -f "$_tmp" ] && wc -l < "$_tmp" | tr -d ' ' || echo 0 )
    EV_OFFENDERS=$( [ -f "$_tmp" ] && cut -f1 "$_tmp" | tr '\n' ' ' || echo "" )
    rm -f "$_tmp" "$_tmp.s"
    return 0
}

selftest() {
    SKIP_DOCSYM_SELFTEST=1; export SKIP_DOCSYM_SELFTEST
    _st=$(mktemp -d) || return 2
    _rc=0

    # fixture 1: a document under symlink mode must FAIL and name the path.
    _f1="$_st/f1"
    mkdir -p "$_f1" && ( cd "$_f1" && git init -q . ) || return 2
    _doc=$(printf '# a document\nwith several\nlines of text\n' | git -C "$_f1" hash-object -w --stdin)
    _ok=$(printf 'ok\n' | git -C "$_f1" hash-object -w --stdin)
    git -C "$_f1" update-index --add --cacheinfo 120000,"$_doc",bad.md || return 2
    git -C "$_f1" update-index --add --cacheinfo 100644,"$_ok",plain.txt || return 2
    _t1=$(git -C "$_f1" write-tree) || return 2
    _c1=$(git -C "$_f1" commit-tree "$_t1" -m f1) || return 2
    _out=$( cd "$_f1" && sh "$SELF" --rev "$_c1" 2>&1 )
    case "$_out" in
        *"FAIL"*"bad.md"*) echo "selftest 1 (document symlink must FAIL): ok" ;;
        *) echo "selftest 1 FAILED: $_out"; _rc=1 ;;
    esac

    # fixture 2: a genuine short link target must PASS.
    _f2="$_st/f2"
    mkdir -p "$_f2" && ( cd "$_f2" && git init -q . ) || return 2
    _tgt=$(printf '../../positive/01_arithmetic.spl' | git -C "$_f2" hash-object -w --stdin)
    git -C "$_f2" update-index --add --cacheinfo 120000,"$_tgt",link.spl || return 2
    _t2=$(git -C "$_f2" write-tree) || return 2
    _c2=$(git -C "$_f2" commit-tree "$_t2" -m f2) || return 2
    _out=$( cd "$_f2" && sh "$SELF" --rev "$_c2" 2>&1 )
    case "$_out" in
        *"PASS"*) echo "selftest 2 (short link target must PASS): ok" ;;
        *) echo "selftest 2 FAILED: $_out"; _rc=1 ;;
    esac

    # fixture 3: an oversized single-line target must FAIL (ENAMETOOLONG shape
    # with no newline anywhere — the size half of the rule, proven live).
    _f3="$_st/f3"
    mkdir -p "$_f3" && ( cd "$_f3" && git init -q . ) || return 2
    _long=$(awk 'BEGIN{s="";for(i=0;i<1200;i++)s=s "x";printf "%s",s}' | git -C "$_f3" hash-object -w --stdin)
    git -C "$_f3" update-index --add --cacheinfo 120000,"$_long",toolong || return 2
    _t3=$(git -C "$_f3" write-tree) || return 2
    _c3=$(git -C "$_f3" commit-tree "$_t3" -m f3) || return 2
    _out=$( cd "$_f3" && sh "$SELF" --rev "$_c3" 2>&1 )
    case "$_out" in
        *"FAIL"*"toolong"*) echo "selftest 3 (oversized target must FAIL): ok" ;;
        *) echo "selftest 3 FAILED: $_out"; _rc=1 ;;
    esac

    # fixture 4: an empty tree must scan 0 entries so the caller is forced to ERROR.
    _f4="$_st/f4"
    mkdir -p "$_f4" && ( cd "$_f4" && git init -q . ) || return 2
    _t4=$(git -C "$_f4" write-tree) || return 2
    _c4=$(git -C "$_f4" commit-tree "$_t4" -m f4) || return 2
    _out=$( cd "$_f4" && sh "$SELF" --rev "$_c4" 2>&1 )
    _o_rc=$?
    if [ "$_o_rc" -eq 2 ]; then
        echo "selftest 4 (empty tree must ERROR): ok"
    else
        echo "selftest 4 FAILED (exit $_o_rc): $_out"; _rc=1
    fi

    rm -rf "$_st"
    return $_rc
}

SELF="$0"
case "$SELF" in /*) ;; *) SELF="$(pwd)/$SELF" ;; esac
case "${1:-}" in
    --selftest)
        if selftest; then
            echo "selftest: 4 fixture(s) passed"
            exit 0
        fi
        echo "ERROR — nothing was checked (selftest failed)"
        exit 2
        ;;
esac

REV=HEAD
while [ $# -gt 0 ]; do
    case "$1" in
        --rev) REV=${2:-}; shift 2 || exit 2 ;;
        -h|--help) usage; exit 2 ;;
        *) usage; exit 2 ;;
    esac
done

[ -n "$REV" ] || { echo "ERROR — nothing was checked (no rev)"; exit 2; }

# The selftest is fatal and runs before every real scan, exactly like the
# sibling guards: a guard whose own fixtures do not discriminate proves nothing.
if [ "${SKIP_DOCSYM_SELFTEST:-0}" != 1 ]; then
    _st_out=$(SKIP_DOCSYM_SELFTEST=1 sh "$SELF" --selftest 2>&1)
    _st_rc=$?
    if [ "$_st_rc" -ne 0 ]; then
        printf '%s\n' "$_st_out"
        echo "ERROR — nothing was checked (selftest failed)"
        exit 2
    fi
fi

git rev-parse --verify "$REV^{commit}" >/dev/null 2>&1 || {
    echo "ERROR — nothing was checked (cannot resolve rev $REV)"
    exit 2
}

EV_CHECKED=0
EV_SYMLINKS=0
EV_OFFENDER_COUNT=0
EV_OFFENDERS=""
scan_rev "$REV" || { echo "ERROR — nothing was checked (scan failed)"; exit 2; }

if [ "$EV_CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked (tree at $REV has 0 entries)"
    exit 2
fi

if [ "$EV_OFFENDER_COUNT" -gt 0 ]; then
    echo "FAIL — $EV_CHECKED tree entr(y/ies) checked at $REV, $EV_SYMLINKS symlink(s), $EV_OFFENDER_COUNT carry document content under mode 120000: $EV_OFFENDERS"
    exit 1
fi

echo "PASS — $EV_CHECKED tree entr(y/ies) checked at $REV, $EV_SYMLINKS symlink(s), 0 carry document content"
exit 0
