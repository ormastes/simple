#!/bin/sh
# Verify doc/06_spec executable-spec migration successors and, only after a
# complete pass, optionally emit a deterministic removal manifest. Never deletes.
set -eu

self=check-doc06-spec-layout-migration
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
generator=
manifest=

die() { echo "$self: ERROR: $*" >&2; exit 2; }
fail() { echo "$self: FAIL: $*" >&2; exit 1; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    --root) [ "$#" -ge 2 ] || die '--root requires a path'; root=$2; shift 2 ;;
    --generate-with) [ "$#" -ge 2 ] || die '--generate-with requires an executable'; generator=$2; shift 2 ;;
    --removal-manifest) [ "$#" -ge 2 ] || die '--removal-manifest requires a path'; manifest=$2; shift 2 ;;
    --help)
      echo "usage: $self [--root DIR] [--generate-with SIMPLE] [--removal-manifest FILE]"
      exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

root=$(CDPATH= cd -- "$root" && pwd -P) || die 'root is not a directory'
spec_root=$root/doc/06_spec
[ -d "$spec_root" ] || die "missing directory: $spec_root"
[ -z "$generator" ] || [ -x "$generator" ] || die "generator is not executable: $generator"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/doc06-layout.XXXXXX") || die 'cannot create temporary directory'
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
inventory=$tmp/inventory
find "$spec_root" -type f -name '*_spec.spl' -print | LC_ALL=C sort >"$inventory"

manual_is_safe() {
  candidate=$1
  source_spec=$2
  [ -f "$candidate" ] && [ ! -L "$candidate" ] && [ -s "$candidate" ] || return 1
  cmp -s "$source_spec" "$candidate" && return 1
  grep -Eq '^#{1,6}[[:space:]]' "$candidate" || return 1
  # Generated manuals may contain fenced Simple examples. Only executable
  # syntax outside fences indicates a renamed spec masquerading as a manual.
  awk '
    /^```/ { fenced = !fenced; next }
    !fenced && /^[[:space:]]*(#!.*simple|use[[:space:]]|export[[:space:]]+use[[:space:]]|describe([[:space:]].*)?:[[:space:]]*$|context([[:space:]].*)?:[[:space:]]*$|it([[:space:]].*)?:[[:space:]]*$|(pub[[:space:]]+)?(fn|class|enum|impl|extern[[:space:]]+fn)[[:space:]])/ { bad = 1 }
    END { exit bad ? 1 : 0 }
  ' "$candidate"
}

checked=0
failures=0
while IFS= read -r misplaced; do
  relative=${misplaced#"$spec_root/"}
  successor=$spec_root/${relative%.spl}.md
  if ! manual_is_safe "$successor" "$misplaced"; then
    if [ -n "$generator" ]; then
      canonical=$root/test/$relative
      if [ ! -f "$canonical" ] || [ -L "$canonical" ]; then
        echo "$self: FAIL: unsafe or missing successor and no canonical generator input: $relative" >&2
        failures=$((failures + 1))
        continue
      fi
      if ! "$generator" spipe-docgen "$canonical" --output "$spec_root" --no-index >/dev/null 2>&1; then
        echo "$self: FAIL: generation failed: $relative" >&2
        failures=$((failures + 1))
        continue
      fi
    fi
  fi
  if ! manual_is_safe "$successor" "$misplaced"; then
    echo "$self: FAIL: unsafe or missing Markdown successor: ${relative%.spl}.md" >&2
    failures=$((failures + 1))
    continue
  fi
  checked=$((checked + 1))
done <"$inventory"

if [ "$failures" -ne 0 ]; then
  echo "$self: FAIL: checked=$checked failures=$failures deletion_performed=0" >&2
  exit 1
fi

if [ -n "$manifest" ]; then
  manifest_dir=$(dirname -- "$manifest")
  [ -d "$manifest_dir" ] || die "manifest parent is not a directory: $manifest_dir"
  out=$tmp/removal-manifest
  {
    echo 'schema=doc06-spec-layout-removal-v1'
    echo "count=$checked"
    while IFS= read -r misplaced; do
      relative=${misplaced#"$root/"}
      successor=${relative%.spl}.md
      spec_sha=$(sha256sum "$root/$relative" | awk '{print $1}')
      manual_sha=$(sha256sum "$root/$successor" | awk '{print $1}')
      printf 'remove=%s|successor=%s|spec_sha256=%s|manual_sha256=%s\n' \
        "$relative" "$successor" "$spec_sha" "$manual_sha"
    done <"$inventory"
  } >"$out"
  mv "$out" "$manifest"
fi

echo "$self: PASS: checked=$checked deletion_performed=0"
