#!/bin/sh
# Compiler-instrumented evidence for the C acquisition bridge only. The seams
# are deliberately not represented as pure-Simple or ECC-oracle evidence.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
BRIDGE=src/os/kernel/arch/arm32/cosmos/cosmos_nfc_ecc_bridge.c
HARNESS=test/02_integration/os/cosmos/cosmos_nfc_ecc_bridge_coverage_test.c
OUT="$ROOT/build/coverage/cosmos-nfc-ecc-bridge"
SCRATCH=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-nfc-ecc-bridge.XXXXXX")
trap 'case ${SCRATCH:-} in /tmp/cosmos-nfc-ecc-bridge.*|${TMPDIR:-/tmp}/cosmos-nfc-ecc-bridge.*) [ ! -d "$SCRATCH" ] || rm -r -- "$SCRATCH" ;; esac' EXIT HUP INT TERM

fail() {
    echo "FAIL cosmos-nfc-ecc-bridge-coverage: $*" >&2
    exit 1
}

for version in 20 19 18; do
    if command -v "clang-$version" >/dev/null 2>&1 &&
       command -v "llvm-profdata-$version" >/dev/null 2>&1 &&
       command -v "llvm-cov-$version" >/dev/null 2>&1; then
        CLANG="clang-$version"
        LLVM_PROFDATA="llvm-profdata-$version"
        LLVM_COV="llvm-cov-$version"
        break
    fi
done
[ -n "${CLANG:-}" ] || fail "matching LLVM coverage tools are required"
mkdir -p "$OUT"

"$CLANG" -std=c11 -O0 -g -fprofile-instr-generate -fcoverage-mapping \
    -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes \
    -Wformat=2 -Wno-int-to-pointer-cast \
    -I"$ROOT/src/os/kernel/arch/arm32/cosmos" \
    "$ROOT/$BRIDGE" "$ROOT/$HARNESS" -o "$SCRATCH/bridge-coverage"
LLVM_PROFILE_FILE="$SCRATCH/bridge.profraw" "$SCRATCH/bridge-coverage" \
    > "$OUT/bridge-output.txt"
"$LLVM_PROFDATA" merge -sparse "$SCRATCH/bridge.profraw" \
    -o "$SCRATCH/bridge.profdata"
"$LLVM_COV" report "$SCRATCH/bridge-coverage" \
    -instr-profile="$SCRATCH/bridge.profdata" "$ROOT/$BRIDGE" \
    > "$OUT/bridge-llvm-cov.txt"

pair=$(awk '$1 ~ /cosmos_nfc_ecc_bridge[.]c$/ { print $(NF-2), $(NF-1) }' \
    "$OUT/bridge-llvm-cov.txt")
set -- $pair
[ "$#" -eq 2 ] || fail "cannot parse branch counters"
total=$1
missed=$2
hit=$((total - missed))
[ "$total" -gt 0 ] || fail "branch denominator is zero"
[ "$hit" -eq "$total" ] || fail "uncovered bridge outcomes: $hit/$total"

receipt="$OUT/receipt.sdn"
{
    echo "schema=cosmos-nfc-ecc-bridge-coverage-v1"
    echo "claim_scope=volatile-acquisition-and-c-abi-bridge-only"
    echo "simple_policy_evidence=blocked-not-included"
    echo "c_oracle_parity=blocked-not-included"
    echo "board_evidence=separate-not-included"
    echo "branches_hit=$hit"
    echo "branches_total=$total"
    echo "bridge_sha256=$(sha256sum "$ROOT/$BRIDGE" | awk '{print $1}')"
    echo "harness_sha256=$(sha256sum "$ROOT/$HARNESS" | awk '{print $1}')"
    echo "raw_report_sha256=$(sha256sum "$OUT/bridge-llvm-cov.txt" | awk '{print $1}')"
} > "$receipt"

echo "cosmos_nfc_ecc_c_bridge_branches=$hit/$total"
echo "cosmos_nfc_ecc_simple_policy=blocked-not-included"
echo "cosmos_nfc_ecc_c_oracle_parity=blocked-not-included"
echo "cosmos_nfc_ecc_board_evidence=separate-not-included"
echo "cosmos_nfc_ecc_bridge_receipt=$receipt"
echo "STATUS: PASS cosmos-nfc-ecc scoped C bridge coverage"
