#!/bin/sh
# check-bare-field-references.shs
#
# Fences the in-scope clusters against bare (unqualified) instance-field
# references inside methods -- a form that NO lane of the compiler accepts.
#
# See doc/08_tracking/bug/bare_field_reference_in_methods_is_illegal_but_pervasive_2026-08-10.md
#
# Covered clusters (static scan):
#   src/os/kernel/arch/riscv_shared/    (fixed in 9dc8d6e8ef6)
#   src/compiler/10.frontend/domain/    (domain_hardening.spl fixed in 904dc148477)
#   vhdl_*.spl anywhere under src/
#   src/os/http/**, src/os/hosted/**
#   smux_*.spl anywhere under src/
#   src/os/kernel/arch/riscv64/     (added 2026-08-10, 42 genuine sites)
#   src/os/smf/                     (added 2026-08-10, 21 genuine sites)
#
# The check is fail-closed and carries its OWN controls: before trusting a clean
# result it proves that BOTH detection lanes really do surface a bare field
# reference, and that the analyzer is not simply flagging everything.
#   control A: the compiler lane rejects the positive fixture
#   control B: the static analyzer flags the positive fixture
#   control C: on the false-positive fixture the analyzer reports EXACTLY the one
#              genuine site it contains -- no more (FP regression), no less (blind)
# If any control does not hold, the check reports ERROR rather than PASS -- a scan
# that finds nothing may have scanned nothing.
#
# The static analyzer is field-aware: it flags an identifier used inside a method
# only when that identifier names a field of the enclosing class and is neither a
# parameter nor a local of that method, and is not qualified by self./me. .
# Locals include pattern binders (`case Some(x):`, `Ok(x):`, `| Some(x) ->`,
# `if val Some(x) = ...`) and parameters of MULTI-LINE signatures; label positions
# (`f: v`, `f=v`) and call targets (`f(...)`) are not reads.
#
# Known-unfixed sites are recorded in scripts/check/bare_field_reference_baseline.txt
# as `path<TAB>class<TAB>field` triples (line-number independent). The scan FAILs on
# any NEW site, and also FAILs when a baselined site is gone (stale baseline) so the
# baseline can only ever shrink deliberately. Regenerate with --generate-baseline
# ONLY after reading the diff.
#
# Usage:
#   check-bare-field-references.shs                 static scan + behavioural specs
#   check-bare-field-references.shs --static-only   static scan only (fast pre-push lane)
#   check-bare-field-references.shs --generate-baseline
#
# Verdict line is the LAST line of stdout:
#   PASS  -- <n> checks ran, all green            exit 0
#   FAIL  -- <what failed>                        exit 1
#   ERROR -- nothing was checked / control dead   exit 2

set -u

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT" || { echo "ERROR — nothing was checked: cannot enter repo root"; exit 2; }

SIMPLE=bin/simple
FIXTURE=test/fixtures/repro/compiler/bare_field_ref/bare_field_reference_repro.spl
FP_FIXTURE=test/fixtures/repro/compiler/bare_field_ref/bare_field_reference_false_positive_repro.spl
BASELINE=scripts/check/bare_field_reference_baseline.txt
MARKER='not found'

MODE=full
case "${1:-}" in
    --static-only)       MODE=static ;;
    --generate-baseline) MODE=genbaseline ;;
    "")                  ;;
    *) echo "ERROR — nothing was checked: unknown argument '$1'"; exit 2 ;;
esac

[ -x "$SIMPLE" ] || { echo "ERROR — nothing was checked: $SIMPLE missing or not executable"; exit 2; }
[ -f "$FIXTURE" ] || { echo "ERROR — nothing was checked: control fixture $FIXTURE missing"; exit 2; }
[ -f "$FP_FIXTURE" ] || { echo "ERROR — nothing was checked: negative-control fixture $FP_FIXTURE missing"; exit 2; }

TMPD=$(mktemp -d) || { echo "ERROR — nothing was checked: cannot create temp dir"; exit 2; }
trap 'rm -rf "$TMPD"' EXIT INT TERM

checks=0

# ---------------------------------------------------------------- the analyzer
# Emitted to a temp file rather than kept as a stray .awk in the tree (repo rule:
# tooling lives in .spl/.shs). This is the shell script's own data.
SCAN="$TMPD/scan.awk"
cat > "$SCAN" <<'AWKEOF'
function flush_method(   i, line, ln, name, prev, nxt, rest, tok, key) {
    if (mcount == 0) { delete locals; return }
    for (i = 1; i <= mcount; i++) {
        line = strip_strings(mbody[i])
        if (match(line, /^[ \t]*(val|var|const)[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) {
            tok = substr(line, RSTART, RLENGTH); sub(/^[ \t]*(val|var|const)[ \t]+/, "", tok); locals[tok] = 1
        }
        if (match(line, /^[ \t]*for[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) {
            tok = substr(line, RSTART, RLENGTH); sub(/^[ \t]*for[ \t]+/, "", tok); locals[tok] = 1
        }
        if (match(line, /^[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*(=|\+=|-=|\*=|\/=)[^=]/)) {
            tok = substr(line, RSTART, RLENGTH)
            sub(/^[ \t]*/, "", tok); sub(/[ \t]*(=|\+=|-=|\*=|\/=).*$/, "", tok); locals[tok] = 1
        }
        register_binders(line)
    }
    for (i = 1; i <= mcount; i++) {
        line = strip_strings(mbody[i]); ln = mline[i]; rest = line
        while (match(rest, /[A-Za-z_][A-Za-z0-9_]*/)) {
            name = substr(rest, RSTART, RLENGTH)
            prev = (RSTART > 1) ? substr(rest, RSTART - 1, 1) : " "
            nxt  = substr(rest, RSTART + RLENGTH, 1)
            # nxt == ":" -> a named-argument LABEL, not a read.
            # nxt == "(" -> a call target, not a field read.
            # nxt == "=" with no space -> a `kwarg=value` LABEL (a real bare-field
            #   assignment `f = v` is registered as a local above, so nothing is lost).
            if (prev != "." && nxt != ":" && nxt != "(" && nxt != "=" && \
                (name in fields) && !(name in locals) && !(name in params)) {
                key = FILENAME "\t" cls "\t" name
                if (!(key in seen)) { seen[key] = 1; keys[++nkeys] = key }
                printf "%s:%d: bare field reference `%s` (class %s) -> %s\n", FILENAME, ln, name, cls, trim(mbody[i]) > "/dev/stderr"
            }
            rest = substr(rest, RSTART + RLENGTH)
        }
    }
    mcount = 0
    delete locals
}
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
# A `case`/`if val`/`while val` arm -- and the bare, `case`-less match-arm form
# `Ok(backend):` that real code also uses -- introduces LOCAL bindings for the
# lowercase identifiers in its pattern. Without registering them, every later use
# of a binder whose name collides with a field of the enclosing class is
# misreported as a bare field reference. This was the largest measured
# false-positive family (2026-08-10). For `if/while val` only the PATTERN side
# (before `=`) is scanned; the right-hand side is an ordinary expression and must
# stay subject to the check.
function register_binders(line,   pat, name, prev, isarm) {
    isarm = 0
    if (line ~ /^[ \t]*case[ \t]/) isarm = 1
    else if (line ~ /(^|[^A-Za-z0-9_])(if|while)[ \t]+val[ \t]/) isarm = 2
    else if (line ~ /^[ \t]*[A-Za-z_][A-Za-z0-9_]*\(.*\)[ \t]*:[ \t]*$/) isarm = 1
    else if (line ~ /^[ \t]*\|/) isarm = 3
    if (!isarm) return
    pat = line
    if (isarm == 2) sub(/=.*$/, "", pat)
    else if (isarm == 3) { sub(/^[ \t]*\|[ \t]*/, "", pat); sub(/->.*$/, "", pat) }
    else sub(/:[ \t]*$/, "", pat)
    sub(/^[ \t]*case[ \t]+/, "", pat)
    while (match(pat, /[A-Za-z_][A-Za-z0-9_]*/)) {
        name = substr(pat, RSTART, RLENGTH)
        prev = (RSTART > 1) ? substr(pat, RSTART - 1, 1) : " "
        if (prev != "." && name ~ /^[a-z_]/ && name != "if" && name != "while" && name != "val")
            locals[name] = 1
        pat = substr(pat, RSTART + RLENGTH)
    }
}
function paren_balance(s,   t, i, c, n) {
    t = strip_strings(s); n = 0
    for (i = 1; i <= length(t); i++) { c = substr(t, i, 1); if (c == "(") n++; else if (c == ")") n-- }
    return n
}
# Register the declared parameter names of a (possibly re-joined multi-line)
# signature. Only the single-line form was parsed before, so a method whose
# parameter list spans lines had an EMPTY params set and every `self.f = f`
# assignment of a same-named field read as a bare field reference.
function parse_params(sig,   plist, n, parts, j, p) {
    if (!match(sig, /\(.*\)/)) return
    plist = substr(sig, RSTART + 1, RLENGTH - 2)
    n = split(plist, parts, ",")
    for (j = 1; j <= n; j++) {
        p = trim(parts[j]); sub(/[:=].*$/, "", p); p = trim(p)
        if (p ~ /^[A-Za-z_][A-Za-z0-9_]*$/) params[p] = 1
    }
}
# Blank out quoted-string content and `#` comments. Backslash escapes are
# honoured: without that, a line like `out + ",\"tid\":"` toggles the quote state
# on the ESCAPED quote, leaves the string body unblanked, and every field name
# mentioned inside the literal is reported as a bare field reference.
function strip_strings(s,   out, i, c, q) {
    out = ""; q = ""
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "\\" && q != "") { out = out "  "; i++; continue }
        if (q == "") {
            if (c == "\"" || c == "'") { q = c; out = out " " }
            else if (c == "#") { break }
            else out = out c
        } else { if (c == q) q = ""; out = out " " }
    }
    return out
}
function indent_of(s,   i, n) { n = 0; for (i = 1; i <= length(s); i++) { if (substr(s, i, 1) == " ") n++; else break } return n }
# Remove triple-quoted ("""...""") docstring/raw-text content, carrying the open
# state across records so MULTI-LINE blocks are stripped too; a same-line
# open+close pair is stripped in place and the surrounding code is kept. Without
# this, docstring prose is read as class-body/method-body source: a line like
# `    Returns: the width` registers a phantom field, and prose words inside a
# method body are then reported as bare field references. Runs BEFORE every other
# rule; `indoc` is reset per file so an unterminated block cannot leak sideways.
function doc_filter(s,   out, pos, rest) {
    out = ""; rest = s
    while (1) {
        pos = index(rest, "\"\"\"")
        if (!indoc) {
            if (pos == 0) { out = out rest; break }
            out = out substr(rest, 1, pos - 1)
            rest = substr(rest, pos + 3); indoc = 1
        } else {
            if (pos == 0) break
            rest = substr(rest, pos + 3); indoc = 0
        }
    }
    return out
}
BEGIN { mcount = 0; nkeys = 0; cls = ""; inclass = 0; infn = 0; indoc = 0; insig = 0; sigbuf = "" }
FNR == 1 { indoc = 0 }
{ $0 = doc_filter($0) }
FNR == 1 { flush_method(); delete fields; delete params; cls = ""; inclass = 0; infn = 0; insig = 0; sigbuf = "" }
/^(class|struct)[ \t]+[A-Za-z_]/ {
    flush_method(); delete fields; delete params
    cls = $2; sub(/[(:<].*$/, "", cls); inclass = 1; infn = 0; next
}
/^[A-Za-z_@#]/ { flush_method(); inclass = 0; infn = 0; delete fields; delete params; cls = ""; next }
{
    if (!inclass) next
    if (trim($0) == "") next
    ind = indent_of($0); line = $0
    # Continuation of a signature whose parameter list spans lines: keep joining
    # until the parens balance, THEN parse the whole thing as one signature.
    if (insig) {
        sigbuf = sigbuf " " trim(line)
        if (paren_balance(sigbuf) <= 0) { parse_params(sigbuf); insig = 0 }
        next
    }
    if (ind == 4 && line ~ /^[ \t]*(me|mut|fn|fun|pub|static|async|shared)[ \t]/) {
        flush_method(); delete params; infn = 1
        if (paren_balance(line) > 0) { insig = 1; sigbuf = trim(line); next }
        parse_params(line)
        next
    }
    if (ind == 4) {
        if (match(line, /^[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*[A-Za-z_]/)) {
            f = trim(line); sub(/[ \t]*:.*$/, "", f); fields[f] = 1
        }
        next
    }
    if (infn && ind >= 8) { mcount++; mbody[mcount] = line; mline[mcount] = FNR }
}
END { flush_method(); for (i = 1; i <= nkeys; i++) print keys[i] }
AWKEOF

# ---------------------------------------------------------------- file set
FILELIST="$TMPD/files.txt"
{
    ls src/os/kernel/arch/riscv_shared/*.spl 2>/dev/null
    ls src/compiler/10.frontend/domain/*.spl 2>/dev/null
    find src/os/http src/os/hosted -name '*.spl' 2>/dev/null
    find src \( -name 'vhdl_*.spl' -o -name 'smux_*.spl' \) 2>/dev/null
    ls src/os/kernel/arch/riscv64/*.spl 2>/dev/null
    ls src/os/smf/*.spl 2>/dev/null
} | sort -u > "$FILELIST"
nfiles=$(wc -l < "$FILELIST" | tr -d ' ')
if [ "$nfiles" -lt 100 ]; then
    echo "ERROR — nothing was checked: cluster file set collapsed to $nfiles files (expected >= 100)"
    exit 2
fi

# ---------------------------------------------------------------- control A
# The fixture's Desc.bare() returns `xlen` with no self. prefix. The compiler lane
# MUST reject it. If this comes back clean, the detector is broken, not the source.
ctl_out=$("$SIMPLE" run "$FIXTURE" 2>&1)
if ! printf '%s' "$ctl_out" | grep -q "variable .xlen. $MARKER"; then
    echo "control output was:"
    printf '%s\n' "$ctl_out" | tail -5
    echo "ERROR — nothing was checked: positive control A did not fire; a bare field reference"
    echo "        in $FIXTURE was NOT rejected by the compiler lane, so a clean result proves nothing."
    exit 2
fi
checks=$((checks + 1))
echo "controlA OK  — compiler lane rejects a known bare field reference"

# ---------------------------------------------------------------- control B
# The static analyzer must independently flag the same fixture.
ctlb=$(awk -f "$SCAN" "$FIXTURE" 2>/dev/null)
if ! printf '%s' "$ctlb" | grep -q "	Desc	xlen"; then
    echo "control B analyzer output was: [$ctlb]"
    echo "ERROR — nothing was checked: positive control B did not fire; the static analyzer"
    echo "        did NOT flag the known bare field reference in $FIXTURE."
    exit 2
fi
checks=$((checks + 1))
echo "controlB OK  — static analyzer flags a known bare field reference"

# ---------------------------------------------------------------- control C
# NEGATIVE control. $FP_FIXTURE holds six shapes that LOOK like bare field
# references but are not (pattern binders, multi-line parameter lists,
# named-argument values, `| Some(x) ->` arms, escaped-quote string literals,
# call/kwarg labels) plus ONE genuine site. The analyzer must report EXACTLY the
# genuine one. Reporting more means a false-positive family has regressed;
# reporting none means the analyzer went blind and controls A/B were lucky.
ctlc=$(awk -f "$SCAN" "$FP_FIXTURE" 2>/dev/null)
ctlc_n=$(printf '%s\n' "$ctlc" | grep -c '	')
if [ "$ctlc_n" != "1" ] || ! printf '%s' "$ctlc" | grep -q "	GenuineSite	real_field"; then
    echo "control C analyzer output was ($ctlc_n triple(s)):"
    printf '%s\n' "$ctlc"
    echo "ERROR — nothing was checked: negative control C did not hold; the analyzer must report"
    echo "        exactly one triple (GenuineSite/real_field) on $FP_FIXTURE."
    exit 2
fi
checks=$((checks + 1))
echo "controlC OK  — analyzer reports exactly the 1 genuine site in the false-positive fixture"

# ---------------------------------------------------------------- static scan
CUR="$TMPD/current.txt"
DETAIL="$TMPD/detail.txt"
xargs awk -f "$SCAN" < "$FILELIST" > "$CUR" 2>"$DETAIL"
sort -o "$CUR" "$CUR"

if [ "$MODE" = genbaseline ]; then
    cp "$CUR" "$BASELINE" || { echo "ERROR — nothing was checked: cannot write $BASELINE"; exit 2; }
    echo "wrote $BASELINE ($(wc -l < "$BASELINE" | tr -d ' ') known sites over $nfiles files)"
    echo "PASS — $checks checks ran, baseline regenerated (review the diff before committing)"
    exit 0
fi

[ -f "$BASELINE" ] || { echo "ERROR — nothing was checked: baseline $BASELINE missing"; exit 2; }
BASE="$TMPD/base.txt"
sort "$BASELINE" > "$BASE"

NEWSITES=$(comm -23 "$CUR" "$BASE")
GONE=$(comm -13 "$CUR" "$BASE")

if [ -n "$NEWSITES" ]; then
    echo "NEW bare field reference sites (path / class / field):"
    printf '%s\n' "$NEWSITES"
    echo "-- source lines --"
    printf '%s\n' "$NEWSITES" | cut -f1 | sort -u | while read -r f; do grep -F "$f:" "$DETAIL" | head -20; done
    echo "FAIL — new bare field reference(s) introduced in a fenced cluster"
    exit 1
fi
if [ -n "$GONE" ]; then
    echo "baselined sites no longer present (baseline is stale — fixes landed, good):"
    printf '%s\n' "$GONE"
    echo "FAIL — stale baseline: re-run with --generate-baseline and commit the shrunk baseline"
    exit 1
fi
checks=$((checks + 1))
echo "static   OK  — $nfiles files scanned, $(wc -l < "$CUR" | tr -d ' ') known site(s), 0 new, 0 stale"

if [ "$MODE" = static ]; then
    echo "PASS — $checks checks ran, all green (both controls fired, static scan matches baseline)"
    exit 0
fi

# ---------------------------------------------------------------- behavioural
# Only specs that actually exist and that import a covered cluster. A bare field
# ref anywhere in the imported modules surfaces here as
# `semantic: variable '<name>' not found`.
#
# TODO(2026-08-10): test/01_unit/os/smux_spec.spl and
# test/01_unit/compiler/vhdl_subprogram_spec.spl also cover fenced clusters, but on
# this contended shared working copy both returned a harness NON-VERDICT (no
# `SPEC FILE VERDICT` line within 280s) and so could not be proven green before
# being wired in. Wiring an unmeasurable spec would make full mode ERROR
# permanently. Add them once they produce a verdict.
for spec in \
    test/unit/os/riscv_dual_arch_spec.spl \
    test/01_unit/os/riscv_dual_arch_spec.spl
do
    [ -f "$spec" ] || continue
    # Back-to-back spec runs contend on the shared light test daemon; a stale lock
    # makes the NEXT spec exit with no verdict line at all. Reset between legs.
    rm -rf .build/test_daemon_light 2>/dev/null
    out=$("$SIMPLE" test "$spec" 2>&1)
    verdict=$(printf '%s' "$out" | grep 'SPEC FILE VERDICT' | tail -1)
    if [ -z "$verdict" ]; then
        rm -rf .build/test_daemon_light 2>/dev/null
        out=$("$SIMPLE" test "$spec" 2>&1)
        verdict=$(printf '%s' "$out" | grep 'SPEC FILE VERDICT' | tail -1)
    fi
    if [ -z "$verdict" ]; then
        echo "ERROR — nothing was checked: no verdict line from $spec (ran nothing?)"
        exit 2
    fi
    echo "$verdict"
    if printf '%s' "$out" | grep -q "semantic: variable .* $MARKER"; then
        printf '%s\n' "$out" | grep "semantic: variable .* $MARKER" | sort -u
        echo "FAIL — bare field reference still reachable from $spec"
        exit 1
    fi
    case "$verdict" in
        *"failed=0"*) ;;
        *) echo "FAIL — $spec is not fully green"; exit 1 ;;
    esac
    checks=$((checks + 1))
done

if [ "$checks" -lt 6 ]; then
    echo "ERROR — nothing was checked: only $checks check(s) ran"
    exit 2
fi

echo "PASS — $checks checks ran, all green (both controls fired, static scan matches baseline, spec legs green)"
exit 0
