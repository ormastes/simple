#!/bin/sh
# check-env-get-nil-abort-guard.shs
#
# Positive control for the silent function-abort family rooted in rt_env_get.
#
# THE DEFECT
#   `rt_env_get` is declared `-> text`, but the runtime returns Value::Nil for an
#   UNSET variable and the interpreter does not enforce the declared signature.
#   Several `env_get` wrappers are bare `rt_env_get(key)` passthroughs that
#   inherit the lie. Calling a text method on the result ABORTS THE ENCLOSING
#   FUNCTION -- it never reaches ANY return.
#
# WHY THIS CHECK IS SHAPED THIS WAY
#   The failure mode is a SILENT ABORT: an aborted function and a correct one
#   look identical from outside (the caller just sees an empty value, sometimes
#   with no diagnostic at all). So it is NOT enough to assert "no error printed".
#   Part A therefore asserts the probe function REACHED ITS RETURN by requiring a
#   REACHED_ marker in the output -- the marker is only produced on the line
#   AFTER the method call, so an abort cannot forge it.
#
# WHY THE ROOT WAS NOT CHANGED
#   Making the wrappers return "" for unset would silently regress 36 call sites
#   that rely on the nil leak to apply a NON-EMPTY `??` default
#   (e.g. `env_get("SIMPLE_BINARY") ?? "bin/simple"` would become ""). The
#   contract violation is filed rather than normalised away; see
#   doc/08_tracking/bug/rt_env_get_nil_silently_aborts_enclosing_function_2026-08-08.md
#
# Verdict line is the LAST line of stdout: PASS / FAIL / ERROR.
set -u

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT" || { echo "ERROR — nothing was checked (cannot cd to repo root)"; exit 2; }

# Fail closed on cwd: these are the artifacts under test.
GUARDED_FILE="src/lib/nogc_sync_mut/test_runner/test_runner_async.spl"
[ -f "$GUARDED_FILE" ] || { echo "ERROR — nothing was checked (missing $GUARDED_FILE)"; exit 2; }
[ -d "src/lib" ] || { echo "ERROR — nothing was checked (no src/lib; bundled-stdlib trap)"; exit 2; }

SIMPLE="bin/simple"
[ -x "$SIMPLE" ] || { echo "ERROR — nothing was checked (no executable $SIMPLE)"; exit 2; }

TMPROOT="${TMPDIR:-/tmp}/env_get_nil_guard_$$"
mkdir -p "$TMPROOT" || { echo "ERROR — nothing was checked (cannot mkdir $TMPROOT)"; exit 2; }
PROBE="$ROOT/probe_env_get_nil_guard_$$.spl"
trap 'rm -rf "$TMPROOT" "$PROBE"' EXIT

CHECKED=0
FAILED=0

# ---------------------------------------------------------------------------
# Part A -- mechanism control, run against the REAL unguarded wrapper.
#   p_guarded   uses the `?? ""` form the fix applies  -> MUST reach its return
#   p_unguarded uses the bare form the fix removed     -> MUST NOT reach it
# The probe lives at the repo root so `src/lib/` resolves (running it from a
# directory without src/lib silently serves a BUNDLED stdlib).
# ---------------------------------------------------------------------------
cat > "$PROBE" <<'PROBE_EOF'
use std.nogc_sync_mut.io.env_ops.{env_get as ops_env_get}

val UNSET_KEY = "SIMPLE_ENV_GET_NIL_GUARD_DEFINITELY_UNSET_KEY"

fn p_guarded() -> text:
    val v = (ops_env_get(UNSET_KEY) ?? "").trim()
    val fallback = if v != "": v else: "/tmp"
    "REACHED_GUARDED=[{fallback}]"

fn p_unguarded() -> text:
    val v = ops_env_get(UNSET_KEY).trim()
    "REACHED_UNGUARDED=[{v}]"

fn main():
    print p_guarded()
    print p_unguarded()
    print "PROBE_END"
PROBE_EOF

# Strip the vars out of the environment so the unset path is the one exercised.
OUT=$(env -u TMPDIR -u TEMP -u TMP \
      SIMPLE_ENV_GET_NIL_GUARD_DEFINITELY_UNSET_KEY= \
      env -u SIMPLE_ENV_GET_NIL_GUARD_DEFINITELY_UNSET_KEY \
      "$SIMPLE" run "$PROBE" 2>&1)

CHECKED=$((CHECKED + 1))
if printf '%s\n' "$OUT" | grep -q 'REACHED_GUARDED=\[/tmp\]'; then
    :
else
    echo "  A1 FAIL: guarded form did not reach its return with the /tmp fallback"
    printf '%s\n' "$OUT" | sed 's/^/       | /' | head -20
    FAILED=$((FAILED + 1))
fi

CHECKED=$((CHECKED + 1))
if printf '%s\n' "$OUT" | grep -q 'REACHED_UNGUARDED='; then
    echo "  A2 FAIL: unguarded form REACHED its return -- the defect no longer"
    echo "       reproduces, so this control is vacuous. Re-derive the family"
    echo "       before trusting any 'already safe' verdict in the bug doc."
    FAILED=$((FAILED + 1))
fi

# ---------------------------------------------------------------------------
# Part B -- regression control on the fixed source. Goes RED if the guard is
# reverted. Both TEMP and TMPDIR reads must be coalesced before `.trim()`.
# ---------------------------------------------------------------------------
for KEY in TEMP TMPDIR; do
    CHECKED=$((CHECKED + 1))
    if grep -q "(env_get(\"$KEY\") ?? \"\").trim()" "$GUARDED_FILE"; then
        :
    else
        echo "  B FAIL: $GUARDED_FILE no longer coalesces env_get(\"$KEY\") before .trim()"
        echo "       _get_temp_dir aborts before ANY return whenever $KEY is unset."
        FAILED=$((FAILED + 1))
    fi
done

# Part B2 -- no bare `env_get("X").trim()` may return to this function.
CHECKED=$((CHECKED + 1))
if grep -Eq '[^?] env_get\("(TEMP|TMPDIR|TMP)"\)\.[a-z_]' "$GUARDED_FILE"; then
    echo "  B2 FAIL: a bare unguarded env_get(...).method reappeared in $GUARDED_FILE"
    FAILED=$((FAILED + 1))
fi

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi

if [ "$FAILED" -ne 0 ]; then
    echo "FAIL — $FAILED of $CHECKED assertion(s) failed"
    exit 1
fi

echo "PASS — $CHECKED assertion(s) checked (nil-abort reproduces; guarded path reaches its return)"
exit 0
