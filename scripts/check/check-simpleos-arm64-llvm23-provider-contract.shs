#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo_root"
producer="$repo_root/scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs"
signed_provider="$repo_root/scripts/check/lib/llvm-23-1-signed-provider.shs"
snapshot_provider="$repo_root/scripts/check/lib/llvm-23-1-provider-snapshot.shs"
builder="$repo_root/scripts/setup/build-llvm-23-1-provider.shs"
test_source_dir="${SIMPLE_LLVM_23_1_TEST_SOURCE_DIR:-}"
test_prefix_dir=""

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

cleanup() {
    llvm_23_1_cleanup_isolated_keyring
    if [ -n "$test_prefix_dir" ]; then
        rm -rf "$test_prefix_dir"
    fi
}

[ -f "$producer" ] || fail "missing ARM64 LLVM provider producer"
[ -f "$signed_provider" ] || fail "missing isolated LLVM signing-key helper"
[ -f "$snapshot_provider" ] || fail "missing private LLVM provider snapshot helper"
[ -f "$builder" ] || fail "missing LLVM provider builder"
sh -n "$producer" || fail "ARM64 LLVM provider producer is not valid POSIX shell"
sh -n "$signed_provider" || fail "isolated LLVM signing-key helper is not valid POSIX shell"
sh -n "$snapshot_provider" || fail "LLVM provider snapshot helper is not valid POSIX shell"
for snapshot_required in \
    'llvm_23_1_snapshot_create()' \
    '[ "$#" -eq 4 ]' \
    'LLVM_23_1_SNAPSHOT_PREFIX' \
    'LLVM_23_1_SNAPSHOT_MANIFEST' \
    'llvm-as'; do
    grep -Fq "$snapshot_required" "$snapshot_provider" ||
        fail "LLVM provider snapshot helper is missing contract token: $snapshot_required"
done

for required in \
    'LLVM_23_1_EXPECTED_PROVIDER_SCHEMA="llvm-23.1-provider-v3"' \
    'LLVM_PROVIDER_SCHEMA' \
    'LLVM_NM_23_1' \
    'LLVM_READOBJ_23_1' \
    'LLVM_AS_23_1' \
    'llvm_23_1_snapshot_create' \
    'LLVM_23_1_EXPECTED_MANIFEST_SHA256' \
    'LLVM_23_1_EXPECTED_SNAPSHOT_MANIFEST' \
    'LLVM_23_1_EXPECTED_SNAPSHOT_MANIFEST_SHA256' \
    'llvm_provider_origin_manifest_expected_path=' \
    'llvm_provider_origin_manifest_expected_sha256=' \
    'llvm_provider_snapshot_manifest_expected_path=' \
    'llvm_provider_snapshot_manifest_expected_sha256=' \
    'LLVM_23_1_SNAPSHOT_PREFIX' \
    'LLVM_23_1_SNAPSHOT_MANIFEST' \
    'llvm_nm_path=' \
    'llvm_readobj_path=' \
    'verify_llvm_23_1_provider_unchanged'
do
    grep -Fq "$required" "$producer" ||
        fail "ARM64 producer is missing provider contract token: $required"
done
for required in \
    'llvm_provider_schema' \
    'LLVM_23_1_ORIGIN_MANIFEST="${LLVM_23_1_ORIGIN_MANIFEST:-}"' \
    'LLVM_23_1_EXPECTED_MANIFEST_SHA256="${LLVM_23_1_EXPECTED_MANIFEST_SHA256:-}"' \
    'LLVM_23_1_EXPECTED_SNAPSHOT_MANIFEST="${LLVM_23_1_EXPECTED_SNAPSHOT_MANIFEST:-}"' \
    'LLVM_23_1_EXPECTED_SNAPSHOT_MANIFEST_SHA256="${LLVM_23_1_EXPECTED_SNAPSHOT_MANIFEST_SHA256:-}"' \
    'independent-llvm-origin-manifest-input-required' \
    'independent-llvm-snapshot-manifest-sha256-input-required' \
    'llvm_nm_path' \
    'llvm_nm_sha256' \
    'llvm_readobj_path' \
    'llvm_readobj_sha256' \
    'llvm_as_path' \
    'llvm_as_sha256' \
    'LLVM_23_1_PROVIDER_SCHEMA=llvm-23.1-provider-v3' \
    'verify_manifest_provider_tool llvm-nm' \
    'verify_manifest_provider_tool llvm-readobj'
do
    grep -Fq "$required" "$repo_root/scripts/check/check-simpleos-arm64-qmp-input-evidence.shs" ||
        fail "ARM64 QMP consumer is missing provider contract token: $required"
done

. "$signed_provider"
trap cleanup EXIT HUP INT TERM
LLVM_23_1_SIGNED_GNUPGHOME=/tmp
llvm_23_1_cleanup_isolated_keyring
[ "$LLVM_23_1_SIGNED_GNUPGHOME" = /tmp ] || fail "cleanup altered caller GNUPGHOME before initialization"
llvm_23_1_prepare_isolated_keyring || fail "checked-in LLVM release key was rejected"
[ -d "$LLVM_23_1_SIGNED_GNUPGHOME" ] || fail "isolated LLVM keyring was not created"
llvm_23_1_cleanup_isolated_keyring
[ "$LLVM_23_1_SIGNED_GNUPGHOME" = /tmp ] || fail "cleanup did not restore caller GNUPGHOME"
if llvm_23_1_prepare_isolated_keyring "$LLVM_23_1_RELEASE_SIGNER_KEY" \
    0000000000000000000000000000000000000000 >/dev/null 2>&1; then
    fail "untrusted LLVM signer fingerprint was accepted"
fi
[ "$LLVM_23_1_SIGNED_GNUPGHOME" = /tmp ] || fail "failed signing-key setup altered caller GNUPGHOME"
if [ -z "$test_source_dir" ] || [ ! -d "$test_source_dir/.git" ]; then
    printf 'UNAVAILABLE: signed LLVM 23.1.0 test checkout is not configured; set SIMPLE_LLVM_23_1_TEST_SOURCE_DIR\n' >&2
    exit 2
fi
test_prefix_dir=$(mktemp -d /tmp/simple-llvm23-provider-prefix.XXXXXX)
llvm_23_1_prepare_isolated_keyring || fail "isolated keyring setup for builder regression failed"
if builder_output=$(env GNUPGHOME="$LLVM_23_1_SIGNED_GNUPGHOME" sh "$builder" \
    --source-dir "$test_source_dir" --prefix "$test_prefix_dir" --verify-only 2>&1); then
    fail "builder regression unexpectedly accepted an empty provider"
fi
printf '%s\n' "$builder_output" | grep -Fq "missing installed clang: $test_prefix_dir/bin/clang" ||
    fail "isolated builder regression did not reach provider validation after git verify-tag"
llvm_23_1_cleanup_isolated_keyring
printf 'arm64_llvm_provider_isolated_keyring_status=pass\n'
printf 'arm64_llvm_provider_untrusted_signer_rejection_status=pass\n'
printf 'arm64_llvm_provider_isolated_builder_verify_tag_status=pass\n'

self_test_output=$(sh "$producer" --llvm-provider-self-test) ||
    fail "executable ARM64 LLVM provider contract self-test failed"
for receipt in \
    arm64_llvm_provider_canonical_rejection_status=pass \
    arm64_llvm_provider_version_rejection_status=pass \
    arm64_llvm_provider_tag_commit_rejection_status=pass \
    arm64_llvm_provider_contract_self_test_status=pass
do
    printf '%s\n' "$self_test_output" | grep -qx "$receipt" ||
        fail "missing executable negative-test receipt: $receipt"
done

printf 'PASS: ARM64 LLVM 23.1 provider rejects escaped tools, LLVM 18 tools, and retargeted tag receipts\n'
