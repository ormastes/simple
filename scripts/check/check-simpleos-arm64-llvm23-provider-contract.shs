#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
producer="$repo_root/scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs"

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

[ -f "$producer" ] || fail "missing ARM64 LLVM provider producer"
sh -n "$producer" || fail "ARM64 LLVM provider producer is not valid POSIX shell"

self_test_output=$(sh "$producer" --llvm-provider-self-test) ||
    fail "executable ARM64 LLVM provider contract self-test failed"
for receipt in \
    arm64_llvm_provider_canonical_rejection_status=pass \
    arm64_llvm_provider_version_rejection_status=pass \
    arm64_llvm_provider_tag_commit_rejection_status=pass \
    arm64_llvm_provider_contract_self_test_status=pass
do
    printf '%s\n' "$self_test_output" | grep -qx "$receipt" ||
        fail "missing executable negative-test receipt: $receipt"
done

printf 'PASS: ARM64 LLVM 23.1 provider rejects escaped tools, LLVM 18 tools, and retargeted tag receipts\n'
