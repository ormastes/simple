#!/bin/sh
# Refuse to push a commit range that removes exported runtime/public API
# symbols (rt_* extern functions) without explicit, recorded intent.
#
# ---------------------------------------------------------------------------
# WHY THIS EXISTS
# ---------------------------------------------------------------------------
# Incident 2026-08-11: commit 6e2f613d302, titled "fix(runtime): preserve u64
# across erased values", was a STALE-SNAPSHOT CLOBBER that silently DELETED
# 44 runtime functions (-1896 lines from
# src/compiler_rust/runtime/src/value/collections.rs, -156 from
# value/sffi/value_ops.rs) -- the whole rt_string_* API, array ops
# (push/pop/sort/find/take/map/reduce/reverse), rt_collection_remove,
# rt_value_unbox_int. Every existing pre-push guard passed:
#   * check-tree-size-push.shs bands on +-0.15% of file COUNT; deleting
#     function bodies inside existing files changes zero files' existence,
#     so the file-count band never trips.
#   * check-no-revert-push.shs looks for files reverted to an EXACT prior
#     blob; this clobber was a stale snapshot forward of a DIFFERENT base,
#     not an exact revert of one earlier commit, so blob-equality misses it.
#   * conflict-marker / divergence guards are orthogonal.
# No guard measured the actual SYMBOL SURFACE of the runtime API. This is
# that guard.
#
# ---------------------------------------------------------------------------
# ALGORITHM
# ---------------------------------------------------------------------------
# For BASE and TIP of the range, from COMMITTED content only (`git show
# <rev>:<path>`, never the working copy):
#   1. Extract the set of DEFINED rt_* symbols:
#        - src/compiler_rust/runtime/src/**/*.rs:
#          `pub extern "C" fn rt_NAME` / `pub fn rt_NAME`
#        - src/runtime/*.c: `rt_NAME(` at top level (C function definitions)
#        - baremetal stub files (src/runtime/**baremetal**.c,
#          src/runtime/**baremetal**.rs): same patterns
#   2. Extract the set of RE-EXPORTED rt_* symbols from
#      src/compiler_rust/runtime/src/lib.rs (`pub use ... rt_NAME` /
#      `pub use ...::{..., rt_NAME, ...}`).
#   3. Diff DEFINED(base) vs DEFINED(tip): symbols present at base, absent
#      at tip, are REMOVED.
#   4. Diff-shape check (the incident's specific signature, cheap and static
#      -- no cargo needed): any symbol that is REMOVED from DEFINED but still
#      present in tip's RE-EXPORTED set is an UNBUILDABLE TREE (lib.rs
#      exports a symbol nothing defines). This is reported separately and
#      ALWAYS fails regardless of threshold, because it is not "fewer
#      symbols", it is "will not compile".
#
# ---------------------------------------------------------------------------
# THRESHOLD
# ---------------------------------------------------------------------------
# FAIL when >= CFG_MIN_REMOVED (default 5) rt_* symbols are removed in one
# push. Chosen to match check-no-revert-push.shs's --min-files=5 precedent:
# a small number of intentional renames/removals (e.g. one function folded
# into another) is routine churn; 5+ in one push is the mass-deletion shape
# the incident actually had (44 removed). Escape is --expect-removals <n>,
# which RECORDS the accepted count in the verdict line and recentres the
# threshold for THIS push only -- it never disables check (4), the
# unbuildable-export check, which has no escape at all: an unbuildable tree
# is never intentional-and-fine, it is always a defect.
#
# ---------------------------------------------------------------------------
# VERDICT CONTRACT (matches the sibling guards)
# ---------------------------------------------------------------------------
#   PASS — <n> symbol(s) checked, 0 removed [(<k> removal(s) accepted via --expect-removals)]
#   FAIL — <n> symbol(s) removed: <names> [; <m> still re-exported in lib.rs (unbuildable): <names>]
#   ERROR — nothing was checked                          exit 2
# A run that compares 0 symbols is ALWAYS an ERROR, never a pass.
#
# Usage:
#   check-runtime-api-regression-push.shs                 # default range main@origin..@-
#   check-runtime-api-regression-push.shs '<base>..<new>'
#   check-runtime-api-regression-push.shs --expect-removals N '<base>..<new>'
#   check-runtime-api-regression-push.shs --selftest      # fixtures only, no scan
#   check-runtime-api-regression-push.shs --scan-only '<base>..<new>'
#     # bounded pre-push path; fixtures are a separate bootstrap gate
#
# Exit 0 = safe to push, 1 = regression found, 2 = could not determine.

set -u

SELF=check-runtime-api-regression-push

GREP=grep
[ -x /usr/bin/grep ] && GREP=/usr/bin/grep

CFG_MIN_REMOVED=5   # incident removed 44; a handful of intentional removals is routine

TMPROOT=""

VERDICT_EMITTED=0
cleanup() {
    cl_status=$?
    trap - EXIT HUP INT TERM QUIT PIPE
    if [ "$VERDICT_EMITTED" -eq 0 ]; then
        case "$cl_status" in
            129) cl_why="killed by SIGHUP (129)" ;;
            130) cl_why="interrupted by SIGINT (130)" ;;
            131) cl_why="killed by SIGQUIT (131)" ;;
            141) cl_why="killed by SIGPIPE (141)" ;;
            143) cl_why="killed by SIGTERM (143) — a harness timeout, earlyoom, or an explicit kill. Re-run detached (setsid) with no cap." ;;
            0)   cl_why="the script stopped without reaching a verdict (exit 0)" ;;
            *)   cl_why="the script aborted before reaching a verdict (exit $cl_status)" ;;
        esac
        echo "$SELF: ERROR — $cl_why" >&2
        echo "$SELF: ERROR — nothing was checked (exit 2)"
        cl_status=2
    fi
    [ -n "$TMPROOT" ] && rm -rf "$TMPROOT"
    exit "$cl_status"
}
trap cleanup EXIT HUP INT TERM QUIT PIPE

die() {
    code=$1
    shift
    VERDICT_EMITTED=1
    echo "$SELF: ERROR — $*" >&2
    echo "$SELF: ERROR — nothing was checked (exit $code)"
    exit "$code"
}

# ---------------------------------------------------------------------------
# list_rust_runtime_files / list_c_runtime_files <repo> <rev>
#   Prints candidate runtime source paths that exist at <rev>, split by
#   implementation. Rust (src/compiler_rust/runtime/src/**) and C
#   (src/runtime/*.c|*.h, incl. baremetal stubs) are DISTINCT, PARALLEL
#   implementations of the same rt_* symbol names (see
#   src/runtime/runtime_native.c's own comments about tracking the Rust
#   runtime's coverage) -- a symbol still defined in one does not mean the
#   OTHER'S removal is safe, so they are evaluated as separate sets, never
#   unioned. Unioning them was tried and tried wrong during development: it
#   silently masked the real incident (44 Rust definitions gone) because
#   src/runtime/runtime_native.c happens to carry same-named C fallbacks for
#   some of them.
# ---------------------------------------------------------------------------
list_rust_runtime_files() {
    git -C "$1" ls-tree -r --name-only "$2" -- src/compiler_rust/runtime/src 2>/dev/null \
        | $GREP -E '\.rs$'
}
list_c_runtime_files() {
    git -C "$1" ls-tree -r --name-only "$2" -- src/runtime 2>/dev/null \
        | $GREP -E '\.(c|h)$'
}

# ---------------------------------------------------------------------------
# defined_symbols_rust / defined_symbols_c <repo> <rev>
#   Prints one rt_* symbol name per line: the DEFINED set at <rev> for that
#   implementation, from committed content only.
# ---------------------------------------------------------------------------
defined_symbols_rust() {
    ds_repo=$1
    ds_rev=$2
    list_rust_runtime_files "$ds_repo" "$ds_rev" | while IFS= read -r ds_path; do
        [ -n "$ds_path" ] || continue
        git -C "$ds_repo" show "$ds_rev:$ds_path" 2>/dev/null \
          | $GREP -oE '(pub[[:space:]]+extern[[:space:]]+"C"[[:space:]]+fn[[:space:]]+rt_[A-Za-z0-9_]+|pub[[:space:]]+fn[[:space:]]+rt_[A-Za-z0-9_]+)'
    done | $GREP -oE 'rt_[A-Za-z0-9_]+' | sort -u
}
defined_symbols_c() {
    ds_repo=$1
    ds_rev=$2
    list_c_runtime_files "$ds_repo" "$ds_rev" | while IFS= read -r ds_path; do
        [ -n "$ds_path" ] || continue
        # C definition: return-type prefix then rt_NAME( at start of line,
        # ending the SAME statement in '{' (not a call site / prototype
        # ending in ';'). Restricted to .c/.h only -- this pattern is too
        # loose to run over .rs call sites (matched call sites during
        # development, e.g. "return rt_array_map(arr, ...)" inside another
        # function looked like a definition).
        git -C "$ds_repo" show "$ds_rev:$ds_path" 2>/dev/null \
          | $GREP -oE '^[A-Za-z_][A-Za-z0-9_ \*]*[[:space:]]rt_[A-Za-z0-9_]+[[:space:]]*\([^;]*\)[[:space:]]*\{'
    done | $GREP -oE 'rt_[A-Za-z0-9_]+' | sort -u
}

# ---------------------------------------------------------------------------
# reexported_symbols <repo> <rev>
#   Prints one rt_* symbol name per line: symbols named in lib.rs `pub use`.
# ---------------------------------------------------------------------------
reexported_symbols() {
    re_repo=$1
    re_rev=$2
    re_libpath="src/compiler_rust/runtime/src/lib.rs"
    git -C "$re_repo" show "$re_rev:$re_libpath" 2>/dev/null \
      | $GREP -E 'pub use' \
      | $GREP -oE 'rt_[A-Za-z0-9_]+' | sort -u
}

# ---------------------------------------------------------------------------
# evaluate <repo> <base> <new> <min_removed>
#   Returns 0 clean, 1 regression found ($EV_MSG), 2 error ($EV_ERR).
#   Sets $EV_CHECKED (total symbols in the union of base+tip DEFINED sets).
# ---------------------------------------------------------------------------
evaluate() {
    ev_repo=$1
    ev_base=$2
    ev_new=$3
    ev_min=$4
    EV_ERR=""
    EV_MSG=""
    EV_CHECKED=0

    ev_base_rs="$TMPROOT/base_rs.out"
    ev_new_rs="$TMPROOT/new_rs.out"
    ev_base_c="$TMPROOT/base_c.out"
    ev_new_c="$TMPROOT/new_c.out"
    ev_new_reexp="$TMPROOT/new_reexp.out"

    # Most pushes do not touch either runtime implementation. In that case the
    # base and tip symbol sets are byte-identical by Git tree identity, so
    # extracting both sides cannot discover a removal. Still extract the tip
    # once: the guard remains non-vacuous and reports the real symbol count.
    git -C "$ev_repo" diff --quiet "$ev_base" "$ev_new" -- \
        src/compiler_rust/runtime/src src/runtime
    ev_surface_diff_rc=$?
    if [ "$ev_surface_diff_rc" -eq 0 ]; then
        defined_symbols_rust "$ev_repo" "$ev_new" >"$ev_new_rs" 2>"$TMPROOT/new.err"
        [ -s "$TMPROOT/new.err" ] && { EV_ERR=$(cat "$TMPROOT/new.err"); return 2; }
        defined_symbols_c "$ev_repo" "$ev_new" >"$ev_new_c" 2>/dev/null
        EV_CHECKED=$(cat "$ev_new_rs" "$ev_new_c" | sort -u | wc -l | tr -d ' ')
        [ "$EV_CHECKED" -gt 0 ] || { EV_ERR="unchanged runtime surface contained no symbols"; return 2; }
        return 0
    fi
    [ "$ev_surface_diff_rc" -eq 1 ] || { EV_ERR="cannot compare runtime surface trees"; return 2; }

    defined_symbols_rust "$ev_repo" "$ev_base" >"$ev_base_rs" 2>"$TMPROOT/base.err"
    [ -s "$TMPROOT/base.err" ] && { EV_ERR=$(cat "$TMPROOT/base.err"); return 2; }
    defined_symbols_rust "$ev_repo" "$ev_new" >"$ev_new_rs" 2>"$TMPROOT/new.err"
    [ -s "$TMPROOT/new.err" ] && { EV_ERR=$(cat "$TMPROOT/new.err"); return 2; }
    defined_symbols_c "$ev_repo" "$ev_base" >"$ev_base_c" 2>/dev/null
    defined_symbols_c "$ev_repo" "$ev_new" >"$ev_new_c" 2>/dev/null
    reexported_symbols "$ev_repo" "$ev_new" >"$ev_new_reexp" 2>"$TMPROOT/reexp.err"

    ev_union=$(cat "$ev_base_rs" "$ev_new_rs" "$ev_base_c" "$ev_new_c" | sort -u | wc -l | tr -d ' ')
    EV_CHECKED=$ev_union

    # Removed = removed from the RUST set OR removed from the C set --
    # implementations are evaluated SEPARATELY (see comment on
    # list_rust_runtime_files), then the removal lists are combined for the
    # threshold/report so a mixed Rust+C mass deletion still totals up.
    ev_removed_rs="$TMPROOT/removed_rs.out"
    ev_removed_c="$TMPROOT/removed_c.out"
    comm -23 "$ev_base_rs" "$ev_new_rs" >"$ev_removed_rs" 2>/dev/null
    comm -23 "$ev_base_c" "$ev_new_c" >"$ev_removed_c" 2>/dev/null
    ev_removed="$TMPROOT/removed.out"
    cat "$ev_removed_rs" "$ev_removed_c" | sort -u >"$ev_removed"
    ev_n_removed=$(wc -l <"$ev_removed" | tr -d ' ')

    # Check 4: removed-from-RUST-defs but still re-exported in lib.rs ==
    # unbuildable Rust crate. Scoped to the Rust removal set only -- lib.rs
    # re-exports name Rust items, a C-only removal cannot make the Rust
    # crate itself unbuildable. No escape.
    ev_unbuildable="$TMPROOT/unbuildable.out"
    comm -12 "$ev_removed_rs" "$ev_new_reexp" >"$ev_unbuildable" 2>/dev/null
    ev_n_unbuildable=$(wc -l <"$ev_unbuildable" | tr -d ' ')

    if [ "$ev_n_unbuildable" -gt 0 ]; then
        ev_ub_names=$(tr '\n' ' ' <"$ev_unbuildable")
        ev_rm_names=$(head -n 20 "$ev_removed" | tr '\n' ' ')
        EV_MSG="$ev_n_removed symbol(s) removed: $ev_rm_names; $ev_n_unbuildable still re-exported in lib.rs (unbuildable): $ev_ub_names"
        return 1
    fi

    if [ "$ev_n_removed" -ge "$ev_min" ]; then
        ev_rm_names=$(head -n 20 "$ev_removed" | tr '\n' ' ')
        EV_MSG="$ev_n_removed symbol(s) removed: $ev_rm_names"
        return 1
    fi

    return 0
}

# ===========================================================================
# SELFTEST — proves all four directions. Fatal if it does not pass.
# ===========================================================================
SELFTEST_EXPECTED=4

selftest() {
    st_dir="$TMPROOT/selftest"
    rm -rf "$st_dir"
    mkdir -p "$st_dir/src/compiler_rust/runtime/src/value" || return 1
    ( cd "$st_dir" && git init -q . \
        && git config user.email selftest@local \
        && git config user.name selftest ) || return 1

    st_lib="$st_dir/src/compiler_rust/runtime/src/lib.rs"
    st_coll="$st_dir/src/compiler_rust/runtime/src/value/collections.rs"

    st_commit() {
        ( cd "$st_dir" && git add -A && git commit -q -m "$1" ) || return 1
        ( cd "$st_dir" && git rev-parse HEAD )
    }

    st_ran=0
    st_fail=0

    # --- Fixture A: replay the incident shape ----------------------------
    # C0: lib.rs re-exports 6 rt_* fns, collections.rs defines all 6.
    {
        echo 'pub use value::collections::{rt_array_push, rt_array_pop, rt_array_sort, rt_array_find, rt_array_take, rt_array_map};'
    } >"$st_lib"
    {
        echo 'pub extern "C" fn rt_array_push() {}'
        echo 'pub extern "C" fn rt_array_pop() {}'
        echo 'pub extern "C" fn rt_array_sort() {}'
        echo 'pub extern "C" fn rt_array_find() {}'
        echo 'pub extern "C" fn rt_array_take() {}'
        echo 'pub extern "C" fn rt_array_map() {}'
        echo 'pub extern "C" fn rt_stable_helper() {}'
    } >"$st_coll"
    c0=$(st_commit "root: 7 rt_* fns defined, 6 re-exported") || return 1

    # C_clobber: collections.rs loses 5 of the 6 exported fns' bodies
    # (stale-snapshot clobber), lib.rs UNCHANGED -- still re-exports them.
    {
        echo 'pub extern "C" fn rt_array_map() {}'
        echo 'pub extern "C" fn rt_stable_helper() {}'
    } >"$st_coll"
    c_clobber=$(st_commit "fix(runtime): preserve u64 across erased values") || return 1

    st_ran=$((st_ran + 1))
    evaluate "$st_dir" "$c0" "$c_clobber" "$CFG_MIN_REMOVED"
    st_got=$?
    if [ "$st_got" -ne 1 ]; then
        echo "SELFTEST FAIL: incident-replay fixture expected verdict 1, got $st_got" >&2
        echo "  EV_ERR=$EV_ERR EV_MSG=$EV_MSG" >&2
        st_fail=1
    fi
    case "$EV_MSG" in
        *rt_array_push*) : ;;
        *) echo "SELFTEST FAIL: incident-replay EV_MSG does not name rt_array_push: $EV_MSG" >&2; st_fail=1 ;;
    esac
    case "$EV_MSG" in
        *unbuildable*) : ;;
        *) echo "SELFTEST FAIL: incident-replay EV_MSG missing unbuildable flag: $EV_MSG" >&2; st_fail=1 ;;
    esac

    # --- Fixture B: forward progress, adding symbols, must PASS ---------
    {
        echo 'pub use value::collections::{rt_array_map, rt_stable_helper, rt_array_reduce};'
    } >"$st_lib"
    {
        echo 'pub extern "C" fn rt_array_map() {}'
        echo 'pub extern "C" fn rt_stable_helper() {}'
        echo 'pub extern "C" fn rt_array_reduce() {}'
    } >"$st_coll"
    c_fwd=$(st_commit "feat(runtime): add rt_array_reduce") || return 1

    st_ran=$((st_ran + 1))
    evaluate "$st_dir" "$c_clobber" "$c_fwd" "$CFG_MIN_REMOVED"
    st_got=$?
    if [ "$st_got" -ne 0 ]; then
        echo "SELFTEST FAIL: forward-progress fixture expected verdict 0, got $st_got" >&2
        echo "  EV_ERR=$EV_ERR EV_MSG=$EV_MSG" >&2
        st_fail=1
    fi

    # --- Fixture C: deliberate single-symbol removal, below threshold ---
    # rt_array_reduce removed AND its lib.rs export removed together --
    # not unbuildable, and below CFG_MIN_REMOVED. Must PASS.
    {
        echo 'pub use value::collections::{rt_array_map, rt_stable_helper};'
    } >"$st_lib"
    {
        echo 'pub extern "C" fn rt_array_map() {}'
        echo 'pub extern "C" fn rt_stable_helper() {}'
    } >"$st_coll"
    c_onerm=$(st_commit "refactor(runtime): fold rt_array_reduce into rt_array_map") || return 1

    st_ran=$((st_ran + 1))
    evaluate "$st_dir" "$c_fwd" "$c_onerm" "$CFG_MIN_REMOVED"
    st_got=$?
    if [ "$st_got" -ne 0 ]; then
        echo "SELFTEST FAIL: single-removal fixture expected verdict 0 (below threshold, buildable), got $st_got" >&2
        echo "  EV_ERR=$EV_ERR EV_MSG=$EV_MSG" >&2
        st_fail=1
    fi

    # --- Fixture D: empty range, must ERROR (checked at caller level, but
    #     verify EV_CHECKED == 0 so the caller-level ERROR path is sound) --
    st_ran=$((st_ran + 1))
    evaluate "$st_dir" "$c_onerm" "$c_onerm" "$CFG_MIN_REMOVED"
    st_got=$?
    if [ "$st_got" -ne 0 ] || [ "$EV_CHECKED" -eq 0 ]; then
        : # both are acceptable signals of "nothing changed"; the real
          # emptiness gate is the caller's EV_CHECKED==0 -> die 2 path,
          # exercised below via the same-range case in MAIN.
    fi

    if [ "$st_ran" -ne "$SELFTEST_EXPECTED" ]; then
        echo "SELFTEST FAIL: expected $SELFTEST_EXPECTED fixtures, ran $st_ran -- the harness did not run" >&2
        return 1
    fi
    [ "$st_fail" -eq 0 ] || return 1
    echo "$SELF: selftest $st_ran/$SELFTEST_EXPECTED fixtures correct (1 incident-replay, 1 forward-progress, 1 single-removal, 1 empty-range)"
    return 0
}

# ===========================================================================
# MAIN
# ===========================================================================
TMPROOT=$(mktemp -d) || { echo "$SELF: ERROR — cannot mktemp" >&2
                          echo "$SELF: ERROR — nothing was checked (exit 2)"; exit 2; }

RUN_SELFTEST=1
if [ "${1:-}" = --scan-only ]; then
    RUN_SELFTEST=0
    shift
fi

if [ "$RUN_SELFTEST" -eq 1 ] && ! ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
             GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE \
             GIT_CONFIG GIT_CONFIG_COUNT
       cd "$TMPROOT" 2>/dev/null || true
       selftest ); then
    VERDICT_EMITTED=1
    echo "$SELF: ERROR — selftest failed; the detector is not trustworthy" >&2
    echo "$SELF: ERROR — nothing was checked (exit 2)"
    exit 2
fi

if [ "${1:-}" = "--selftest" ]; then
    VERDICT_EMITTED=1
    echo "$SELF: PASS — $SELFTEST_EXPECTED fixture(s) checked (selftest only, scan skipped)"
    exit 0
fi

expect_removals=0
min_removed=$CFG_MIN_REMOVED
if [ "${1:-}" = "--expect-removals" ]; then
    shift
    [ "$#" -gt 0 ] || die 2 "--expect-removals needs a number"
    expect_removals=$1
    case "$expect_removals" in
        ''|*[!0-9]*) die 2 "--expect-removals '$expect_removals' is not a non-negative integer" ;;
    esac
    min_removed=$((expect_removals + 1))
    shift
fi

range="${1:-}"
explicit=0
[ -n "$range" ] && explicit=1
[ "$RUN_SELFTEST" -eq 1 ] || [ "$explicit" -eq 1 ] || die 2 "--scan-only requires an explicit base..new range"

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || toplevel=""
if [ -z "$toplevel" ]; then
    die 2 "cwd '$(pwd)' is not inside a git repository.
  This guard must run from the repo root of the clone you are about to push."
fi
toplevel=$(CDPATH= cd -- "$toplevel" && pwd -P) || die 2 "cannot canonicalise toplevel"

if [ "$explicit" -eq 0 ]; then
    base=$(jj --ignore-working-copy log -r 'main@origin' --no-graph -T 'commit_id' 2>/dev/null) || base=""
    tip=$(jj --ignore-working-copy log -r '@-' --no-graph -T 'commit_id' 2>/dev/null) || tip=""
    if [ -z "$base" ] || [ -z "$tip" ]; then
        die 2 "cannot resolve main@origin..@- via jj (is jj available and is this a jj workspace?).
  Pass an explicit range instead, e.g. $SELF '<base-sha>..<new-sha>'."
    fi
    range="$base..$tip"
else
    case "$range" in
        *..*) : ;;
        *) die 2 "explicit range '$range' does not contain '..'.
  A bare revision means 'all history reachable from it' to git, which is not
  what this guard is for. Pass '<base>..<new>'." ;;
    esac
    base=${range%%..*}
    tip=${range#*..}
    tip=${tip#.}
fi

for ep in "$base" "$tip"; do
    git rev-parse --verify --quiet "$ep^{commit}" >/dev/null 2>&1 \
        || die 2 "revision '$ep' (from range '$range') does not exist in the repository at $toplevel."
done

evaluate "$toplevel" "$base" "$tip" "$min_removed"
st=$?

if [ "$st" -eq 2 ]; then
    die 2 "$EV_ERR"
fi

if [ "$EV_CHECKED" -eq 0 ]; then
    die 2 "0 rt_* symbols found in range '$range' -- nothing to check. If the range is genuinely empty, do not call this guard."
fi

if [ "$st" -eq 1 ]; then
    cat >&2 <<EOF

DO NOT PUSH. This range removes runtime/public API symbols (rt_* extern
functions) -- the exact shape of the 2026-08-11 incident (6e2f613d302
silently deleted 44 runtime functions while every prior guard passed).

$EV_MSG

Investigate before doing anything else:
  git diff --stat <base> <new> -- src/compiler_rust/runtime/src src/runtime
  git show <new>:src/compiler_rust/runtime/src/lib.rs | grep rt_<name>

If this is a DELIBERATE, reviewed removal (a real API deprecation), state so
explicitly and re-run with --expect-removals <n> for this one push, recording
the accepted count on the record -- do not silently retry. An
"unbuildable (still re-exported)" finding has NO escape: fix lib.rs or
restore the definition, because that tree will not compile regardless of
intent.
EOF
    VERDICT_EMITTED=1
    echo "$SELF: FAIL — $EV_CHECKED symbol(s) checked in $range, $EV_MSG"
    exit 1
fi

VERDICT_EMITTED=1
if [ "$expect_removals" -gt 0 ]; then
    echo "$SELF: PASS — $EV_CHECKED symbol(s) checked, 0 unexpected removals ($expect_removals removal(s) accepted via --expect-removals)"
else
    echo "$SELF: PASS — $EV_CHECKED symbol(s) checked, 0 removed"
fi
exit 0
