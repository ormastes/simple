#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
BUILD_DIR="${BUILD_DIR:-$ROOT/build/check/engine2d-vulkan-mixed-8k}"
SAMPLES="${ENGINE2D_VULKAN_SAMPLES:-31}"
GLYPHS="${ENGINE2D_VULKAN_GLYPHS:-1024}"
LINES="${ENGINE2D_VULKAN_LINES:-16}"
REQUIRE_PHYSICAL="${ENGINE2D_VULKAN_REQUIRE_PHYSICAL:-0}"
REQUIRE_80FPS="${ENGINE2D_VULKAN_REQUIRE_80FPS:-0}"
case "$(uname -s)" in
    Darwin)
        RUNTIME_LIB="$ROOT/src/compiler_rust/target/release/libsimple_runtime.dylib"
        ICD="${VK_ICD_FILENAMES:-}"
        NM_ARGS='-gU'
        NM_WINDOW=_rt_vulkan_init_window_present
        NM_HEADLESS=_rt_vulkan_init_headless_present
        PLATFORM_LIBS='-lpthread -lm'
        ;;
    *)
        RUNTIME_LIB="$ROOT/src/compiler_rust/target/release/libsimple_runtime.so"
        ICD="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/lvp_icd.json}"
        NM_ARGS='-D'
        NM_WINDOW=rt_vulkan_init_window_present
        NM_HEADLESS=rt_vulkan_init_headless_present
        PLATFORM_LIBS='-lpthread -ldl -lm'
        ;;
esac
run_with_icd() {
    if [ -n "$ICD" ]; then VK_ICD_FILENAMES="$ICD" "$@"
    else "$@"
    fi
}
hash_stdin() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'
    else shasum -a 256 | awk '{print $1}'
    fi
}
mkdir -p "$BUILD_DIR"
if [ -n "$ICD" ] && [ ! -f "$ICD" ]; then echo "engine2d_vulkan_mixed_status=blocked reason=missing-icd"; exit 2; fi
# Rebuild when the lib is missing OR was built without the vulkan feature
# (featureless build = identical return-0 stubs; rt_vulkan_init silently fails
# and this gate dies with no verdict — 2026-08-31 incident).
need_build=0
if [ ! -f "$RUNTIME_LIB" ]; then
    need_build=1
elif command -v nm >/dev/null 2>&1; then
    addr_a=$(nm $NM_ARGS "$RUNTIME_LIB" | awk -v symbol="$NM_WINDOW" '$3==symbol{print $1}')
    addr_b=$(nm $NM_ARGS "$RUNTIME_LIB" | awk -v symbol="$NM_HEADLESS" '$3==symbol{print $1}')
    if [ -z "$addr_a" ] || { [ -n "$addr_b" ] && [ "$addr_a" = "$addr_b" ]; }; then
        need_build=1
    fi
fi
if [ "$need_build" = 1 ]; then
    (cd "$ROOT/src/compiler_rust" && cargo build -p simple-runtime --release --no-default-features --features vulkan)
fi
for shader in clear rect_filled image_copy font_atlas_packed; do
    glslangValidator -V "$ROOT/test/09_baselines/engine2d_vulkan/$shader.comp" -o "$BUILD_DIR/$shader.spv" >/dev/null
done
${CC:-cc} -O2 -Wall -Wextra -Werror "$ROOT/test/09_baselines/engine2d_vulkan/engine2d_vulkan_mixed_8k_bench.c" \
    -L"$ROOT/src/compiler_rust/target/release" -lsimple_runtime \
    -Wl,-rpath,"$ROOT/src/compiler_rust/target/release" $PLATFORM_LIBS -o "$BUILD_DIR/bench"
run_with_icd "$BUILD_DIR/bench" "$BUILD_DIR" "$SAMPLES" "$GLYPHS" "$LINES" > "$BUILD_DIR/receipt.env" 2>&1 || bench_rc=$?
grep -q '^engine2d_vulkan_mixed_mismatch_count=0$' "$BUILD_DIR/receipt.env"
grep -q '^engine2d_vulkan_mixed_submission_count=1$' "$BUILD_DIR/receipt.env"
grep -q '^engine2d_vulkan_mixed_timed_readback_bytes=0$' "$BUILD_DIR/receipt.env"
if [ "$REQUIRE_PHYSICAL" = 1 ]; then
    grep -Eq '^engine2d_vulkan_mixed_adapter_type=(discrete|integrated)$' "$BUILD_DIR/receipt.env" || {
        echo 'engine2d_vulkan_mixed_status=blocked reason=physical-adapter-required'
        exit 2
    }
fi
if [ "$REQUIRE_80FPS" = 1 ]; then
    grep -q '^engine2d_vulkan_mixed_within_80fps_budget=true$' "$BUILD_DIR/receipt.env" || {
        echo 'engine2d_vulkan_mixed_status=failed reason=p95-over-80fps-budget'
        exit 1
    }
fi
field() { awk -F= -v key="$1" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$BUILD_DIR/receipt.env"; }
workload="mixed-retained-v1;7680x4320;glyphs=$GLYPHS;lines=$LINES;image=7680x50;image-upload=setup;submissions=1"
workload_hash=$(printf '%s' "$workload" | hash_stdin)
device_hash=$(printf '%s' "$(field engine2d_vulkan_mixed_adapter_name)|$(field engine2d_vulkan_mixed_adapter_identity)" | hash_stdin)
cat >"$BUILD_DIR/c-feature.receipt" <<EOF
schema=engine2d-vulkan-feature-perf-v1
implementation=c
backend=vulkan
feature=mixed-retained
workload_hash=$workload_hash
device_hash=$device_hash
width=$(field engine2d_vulkan_mixed_width)
height=$(field engine2d_vulkan_mixed_height)
warmup_count=1
sample_count=$(field engine2d_vulkan_mixed_samples)
timing_scope=params-upload-command-record-submit-and-fence
p50_ns=$(field engine2d_vulkan_mixed_frame_p50_ns)
p95_ns=$(field engine2d_vulkan_mixed_frame_p95_ns)
submission_count=$(field engine2d_vulkan_mixed_samples)
fence_count=$(field engine2d_vulkan_mixed_samples)
evidence_readback_bytes=$(field engine2d_vulkan_mixed_evidence_readback_bytes)
presented=$(field engine2d_vulkan_mixed_swapchain_presented)
timed_readback_bytes=$(field engine2d_vulkan_mixed_timed_readback_bytes)
mismatch_count=$(field engine2d_vulkan_mixed_mismatch_count)
checksum=$(field engine2d_vulkan_mixed_checksum)
completion=known
fallback=none
EOF
echo "engine2d_vulkan_mixed_feature_receipt=$BUILD_DIR/c-feature.receipt"
echo "engine2d_vulkan_mixed_status=pass"
