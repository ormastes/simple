#!/bin/sh
# Regression guard for the "a check script's own --selftest mutates the
# invoking repo" defect class.
#
# ---------------------------------------------------------------------------
# WHY THIS EXISTS
# ---------------------------------------------------------------------------
# Two independent incidents of the SAME defect class:
#
#   doc/08_tracking/bug/pre_push_hook_selftest_commits_fixtures_into_invoking_repo_2026-08-21.md
#     A `--selftest` run created fixture commits and leaked
#     `git config user.email=guard@selftest` into the repo the guard was
#     invoked from, moving HEAD off the real landing commit.
#
#   doc/08_tracking/bug/seed_builds_guard_selftest_commits_into_real_repo_2026-08-19.md
#     `check-seed-builds-push.shs --selftest` committed two fixture commits
#     into the real branch and left the index wiped from 116,204 to 45 files
#     across 11 commits.
#
# A check script's `--selftest` must build any git fixtures under a private
# `mktemp -d` repo, never touch the invoking repo's HEAD, index, working
# tree, or git config. This guard proves that mechanically for every listed
# script by comparing `git rev-parse HEAD` and `git status --porcelain`
# before and after running `--selftest`, instead of relying on someone
# reading the script's source and trusting a comment.
#
# Verdict convention (.claude/rules/vcs.md § Pre-push guards): the LAST line
# of stdout is PASS/FAIL/ERROR; a run that checked zero scripts is ERROR,
# never PASS.

set -e

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"

selftest() {
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    fails=0
    echo "=== check-guard-selftest-repo-isolation --selftest ==="

    # 1. must-PASS: a well-behaved guard whose --selftest touches no git state.
    mkdir -p "$tmp/clean/scripts/check"
    ( cd "$tmp/clean" && git init -q && git config user.email t@t.com && \
      git config user.name t && echo x >README && git add README && \
      git -c user.email=t@t.com -c user.name=t commit -qm init )
    cat >"$tmp/clean/scripts/check/g.shs" <<'EOF'
#!/bin/sh
case "${1:-}" in --selftest) echo ok; exit 0;; esac
EOF
    run1() (
        cd "$tmp/clean" || exit 2
        bh="$(git rev-parse HEAD)"; bs="$(git status --porcelain)"
        sh scripts/check/g.shs --selftest >/dev/null 2>&1 || true
        ah="$(git rev-parse HEAD)"; as="$(git status --porcelain)"
        [ "$bh" = "$ah" ] && [ "$bs" = "$as" ]
    )
    if run1; then
        echo "  selftest ok [well-behaved guard must show no HEAD/status change]"
    else
        echo "  SELFTEST FAIL [well-behaved guard must show no HEAD/status change]"
        fails=$((fails + 1))
    fi

    # 2. must-detect: a guard that commits straight into the caller's repo,
    #    replaying the incident shape from both bug records this guards.
    mkdir -p "$tmp/dirty/scripts/check"
    ( cd "$tmp/dirty" && git init -q && git config user.email t@t.com && \
      git config user.name t && echo x >README && git add README && \
      git -c user.email=t@t.com -c user.name=t commit -qm init )
    cat >"$tmp/dirty/scripts/check/g.shs" <<'EOF'
#!/bin/sh
case "${1:-}" in
    --selftest)
        echo bad >>fixture.txt
        git add fixture.txt
        git -c user.email=guard@selftest -c user.name=guard commit -qm "selftest fixture (BAD)"
        exit 0
        ;;
esac
EOF
    run2() (
        cd "$tmp/dirty" || exit 2
        bh="$(git rev-parse HEAD)"; bs="$(git status --porcelain)"
        sh scripts/check/g.shs --selftest >/dev/null 2>&1 || true
        ah="$(git rev-parse HEAD)"; as="$(git status --porcelain)"
        [ "$bh" != "$ah" ] || [ "$bs" != "$as" ]
    )
    if run2; then
        echo "  selftest ok [incident-shaped guard's HEAD move is detectable]"
    else
        echo "  SELFTEST FAIL [incident-shaped guard's HEAD move went undetected]"
        fails=$((fails + 1))
    fi

    if [ "$fails" -ne 0 ]; then
        echo "FAIL — selftest: $fails of 2 fixture(s) failed"
        exit 1
    fi
    echo "  (2 selftest fixture(s) passed)"
}

case "${1:-}" in
    --selftest)
        selftest
        exit 0
        ;;
esac

selftest || exit 1

cd "$ROOT_DIR"

# Scripts previously found (or plausibly could be found) to leak git state
# from their --selftest into the invoking repo. Add to this list as new
# guards with a --selftest and a git-touching fixture are written.
GUARDS="scripts/check/check-ghdl-gate-rc-swallow.shs
scripts/check/check-seed-builds-push.shs
scripts/check/check-tree-size-push.shs"

checked=0
bad=""

for g in $GUARDS; do
    [ -f "$g" ] || continue

    # check-seed-builds-push.shs's selftest compiles Cargo fixtures and is
    # expensive; SKIP_EXPENSIVE=1 lets a caller exclude it from a fast run
    # while still checking the cheap guards. Skipped guards are NOT counted
    # as checked -- a skip must never be laundered into "checked and clean".
    if [ "${SKIP_EXPENSIVE:-0}" = "1" ] && [ "$g" = "scripts/check/check-seed-builds-push.shs" ]; then
        continue
    fi

    checked=$((checked + 1))

    before_head="$(git rev-parse HEAD)"
    before_status="$(git status --porcelain)"

    sh "$g" --selftest >/tmp/.guard-isolation-$$-out 2>&1 || true
    rm -f /tmp/.guard-isolation-$$-out

    after_head="$(git rev-parse HEAD)"
    after_status="$(git status --porcelain)"

    if [ "$before_head" != "$after_head" ]; then
        bad="$bad $g(HEAD moved $before_head->$after_head)"
        continue
    fi
    if [ "$before_status" != "$after_status" ]; then
        bad="$bad $g(working-tree/index status changed)"
        continue
    fi
done

if [ "$checked" -eq 0 ]; then
    echo "ERROR — nothing was checked: no guard scripts found under $ROOT_DIR"
    exit 2
fi

if [ -n "$bad" ]; then
    echo "FAIL — $checked guard(s) checked, selftest mutated the invoking repo:$bad"
    exit 1
fi

echo "PASS — $checked guard(s) checked, 0 mutated the invoking repo's HEAD or status"
exit 0
