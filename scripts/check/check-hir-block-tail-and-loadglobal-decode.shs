#!/bin/sh
# check-hir-block-tail-and-loadglobal-decode.shs
#
# Fences the two 2026-08-24 defects fixed in the `io_runtime` native-build
# chain, both of the same family (a type word dropped or mis-assumed at an
# erased boundary, plus a stale assertion in a comment):
#
#   1. E-HIR-BLOCK-VALUE-TYPE-DECAYED was a TAUTOLOGY.
#      src/compiler/20.hir/hir_lowering/_Expressions/block_and_asm_lowering.spl
#      re-forms every value-block tail as `has_type_: false, type_: nil` at
#      PROBE A, then PROBE B tested `rt_heap_ref_wellformed(type_)` -- which is
#      0 for nil by construction. Measured: 349 firings against 349 captures on
#      the io_runtime repro, with ZERO real malformations at capture
#      (has_type_=false type_ok=false span_ok=true in all 349). The 349 bogus
#      lines pushed 95605 of 107605 bytes of worker stderr into the middle-drop
#      truncator, hiding the genuine diagnostics underneath.
#
#   2. The MirToLlvm LoadGlobal handler decoded its enum payload RAW
#      (rt_enum_payload + rt_tuple_get + `slot >> 32`) on the premise that a
#      one-field SymbolId "decays to its raw i64 when crossing the staged
#      enum-payload ABI". Measured FALSE on the seed's tree-walk interpreter --
#      the engine the native-build worker runs -- where slot 1 is a live
#      SymbolId Object, so the shift reached Value::as_int and failed the whole
#      build with `type mismatch: cannot convert object to int`, reported with
#      NO callee and NO span. It now reads through the typed MirInst accessors
#      bootstrap_load_global_dest_local_id / bootstrap_load_global_symbol_id,
#      the same shape translate_store_global_at has always used.
#
# This guard does NOT grep source for a symbol (see .claude/skills/spipe.md,
# "Source-text assertions are not evidence"). It RUNS a native-build of a
# program that imports std.nogc_sync_mut.io_runtime and classifies the real
# worker output. The exit status is read DIRECTLY into a variable on the line
# after the command, NEVER through a pipe.
#
# Verdict is the LAST line of stdout, per .claude/rules/vcs.md convention:
#   PASS  - <n> case(s) checked, ...          exit 0
#   FAIL  - ...                               exit 1
#   ERROR - nothing was checked (<reason>)    exit 2
# A run that classified 0 cases is ERROR, never a pass. A missing seed binary
# is ERROR, never a pass -- absence of a compiler is absence of evidence.
#
# WHAT THIS GATE ASSERTS, AND WHY IT IS NOT RC=0 YET.
# The two fenced signatures being ABSENT is the assertion. Requiring the build
# to also EXIT 0 is deliberately NOT the default, because a FIFTH blocker sits
# underneath: native_compile does not terminate on an io_runtime importer
# (NB_RC=124, filed as
# doc/08_tracking/bug/native_compile_nonterminating_io_runtime_2026-08-24.md).
# A gate that is red at birth pins nothing -- a real DECAYED regression and the
# known hang would both exit 1, and nobody could tell them apart without
# reading prose. So the residual exit status is REPORTED IN THE VERDICT LINE
# rather than asserted, which keeps the claim honest in both directions: the
# gate never says the build succeeded, and it still fails loudly the moment
# either fenced defect returns. Pass --require-success to assert exit 0 as
# well; flip that on as the default once blocker #5 lands.
#
# --selftest runs FIRST and is FATAL. It mutation-tests the classifier in BOTH
# directions over crafted worker-output fixtures, so a classifier that always
# says PASS (or always says FAIL) cannot ship.
#
# Usage:
#   sh scripts/check/check-hir-block-tail-and-loadglobal-decode.shs [--binary PATH] [--require-success]
#   sh scripts/check/check-hir-block-tail-and-loadglobal-decode.shs --selftest

set -u

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
BINARY="$REPO_ROOT/src/compiler_rust/target/release/simple"
SELFTEST_ONLY=0
# FLIPPED TO REQUIRED 2026-08-24. This defaulted to 0 while blocker #7 of the
# io_runtime native-build chain kept native-build at rc=1 for reasons this gate
# does not own; it was always meant to become mandatory once the chain reached
# rc=0, which it now has (two llc-invalid-IR defects fixed: the alloca-slot gate
# rejecting the erasable ResultMatchSemantic witness, and translate_ref
# hardcoding native_int for a borrow). `--allow-residual-failure` restores the
# advisory behaviour for a lane that is knowingly mid-repair; it is an explicit,
# recorded choice, not a default.
# See doc/08_tracking/bug/native_compile_unresolved_option_result_io_modules_2026-08-24.md
REQUIRE_SUCCESS=1
BUILD_TIMEOUT=${BUILD_TIMEOUT:-3600}

while [ $# -gt 0 ]; do
    case "$1" in
        --binary) BINARY="$2"; shift 2 ;;
        --selftest) SELFTEST_ONLY=1; shift ;;
        --require-success) REQUIRE_SUCCESS=1; shift ;;
        --allow-residual-failure) REQUIRE_SUCCESS=0; shift ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

# ---------------------------------------------------------------------------
# classify_log LOGFILE RC
#   Echoes one of: OK | DECAYED:<n> | OBJINT:<n> | RC:<n>
#   Never reads an exit status through a pipe.
# ---------------------------------------------------------------------------
classify_log() {
    cl_log=$1
    cl_rc=$2
    if [ ! -f "$cl_log" ]; then
        echo "NOLOG"
        return
    fi
    cl_decayed=$(grep -c "E-HIR-BLOCK-VALUE-TYPE-DECAYED" "$cl_log" 2>/dev/null || true)
    cl_decayed=${cl_decayed:-0}
    if [ "$cl_decayed" -gt 0 ]; then
        echo "DECAYED:$cl_decayed"
        return
    fi
    cl_objint=$(grep -c "cannot convert object to int" "$cl_log" 2>/dev/null || true)
    cl_objint=${cl_objint:-0}
    if [ "$cl_objint" -gt 0 ]; then
        echo "OBJINT:$cl_objint"
        return
    fi
    if [ "$cl_rc" != "0" ]; then
        echo "RC:$cl_rc"
        return
    fi
    echo "OK"
}

# ---------------------------------------------------------------------------
# Selftest -- mutation-tests classify_log in BOTH directions.
# ---------------------------------------------------------------------------
run_selftest() {
    st_dir=$(mktemp -d) || { echo "ERROR - nothing was checked (mktemp failed)"; exit 2; }
    st_fail=0
    st_n=0

    # F1: a clean successful build must classify OK (must-PASS direction).
    printf '[build] native_compile 1/7 done\nLinker: Ubuntu LLD 23.1.0\n' > "$st_dir/f1.log"
    st_got=$(classify_log "$st_dir/f1.log" 0); st_n=$((st_n + 1))
    [ "$st_got" = "OK" ] || { echo "selftest F1 (clean build) expected OK, got $st_got" >&2; st_fail=1; }

    # F2: the DECAYED tautology must be caught (must-FAIL, replays defect 1).
    printf 'E-HIR-BLOCK-VALUE-TYPE-DECAYED: block tail expression type_/span word became a non-well-formed heap reference\nE-HIR-BLOCK-VALUE-TYPE-DECAYED: again\n' > "$st_dir/f2.log"
    st_got=$(classify_log "$st_dir/f2.log" 0); st_n=$((st_n + 1))
    [ "$st_got" = "DECAYED:2" ] || { echo "selftest F2 (decayed) expected DECAYED:2, got $st_got" >&2; st_fail=1; }

    # F2b: DECAYED must FAIL even when the build's own exit status is 0 --
    # the 349 bogus lines never failed a build, they only truncated stderr.
    st_got=$(classify_log "$st_dir/f2.log" 0); st_n=$((st_n + 1))
    case "$st_got" in DECAYED:*) : ;; *) echo "selftest F2b expected DECAYED with rc=0, got $st_got" >&2; st_fail=1 ;; esac

    # F3: the object-to-int mismatch must be caught (must-FAIL, replays defect 2).
    printf 'error: semantic: type mismatch: cannot convert object to int\n' > "$st_dir/f3.log"
    st_got=$(classify_log "$st_dir/f3.log" 1); st_n=$((st_n + 1))
    [ "$st_got" = "OBJINT:1" ] || { echo "selftest F3 (obj->int) expected OBJINT:1, got $st_got" >&2; st_fail=1; }

    # F4: a non-zero rc with no known signature must still FAIL, not pass --
    # a sixth blocker underneath must never launder into a green verdict.
    printf 'error: MIR lowering error: something else entirely\n' > "$st_dir/f4.log"
    st_got=$(classify_log "$st_dir/f4.log" 1); st_n=$((st_n + 1))
    [ "$st_got" = "RC:1" ] || { echo "selftest F4 (other failure) expected RC:1, got $st_got" >&2; st_fail=1; }

    # F4b: RC:<n> must remain distinguishable from OK -- the residual-exit
    # PASS is reported in the verdict, never collapsed into the clean verdict.
    st_got=$(classify_log "$st_dir/f4.log" 124); st_n=$((st_n + 1))
    [ "$st_got" = "RC:124" ] || { echo "selftest F4b (timeout) expected RC:124, got $st_got" >&2; st_fail=1; }

    # F4c: a DECAYED regression must still outrank a non-zero exit, so the
    # residual-exit allowance can never mask a real regression.
    printf 'E-HIR-BLOCK-VALUE-TYPE-DECAYED: x\n' > "$st_dir/f4c.log"
    st_got=$(classify_log "$st_dir/f4c.log" 124); st_n=$((st_n + 1))
    [ "$st_got" = "DECAYED:1" ] || { echo "selftest F4c expected DECAYED:1 under rc=124, got $st_got" >&2; st_fail=1; }

    # F5: a missing log must be NOLOG so the caller is forced to ERROR.
    st_got=$(classify_log "$st_dir/nonexistent.log" 0); st_n=$((st_n + 1))
    [ "$st_got" = "NOLOG" ] || { echo "selftest F5 (missing log) expected NOLOG, got $st_got" >&2; st_fail=1; }

    rm -rf "$st_dir"
    if [ "$st_fail" -ne 0 ]; then
        echo "FAIL - selftest failed ($st_n fixture(s) run); the classifier is untrustworthy, no scan was performed"
        exit 1
    fi
    echo "selftest: $st_n fixture(s) passed"
}

run_selftest

if [ "$SELFTEST_ONLY" -eq 1 ]; then
    echo "PASS - 8 case(s) checked, selftest only (no native-build performed)"
    exit 0
fi

# ---------------------------------------------------------------------------
# Real scan.
# ---------------------------------------------------------------------------
if [ ! -x "$BINARY" ]; then
    echo "ERROR - nothing was checked (no executable seed at $BINARY; absence of a compiler is absence of evidence)"
    exit 2
fi

WORK=$(mktemp -d) || { echo "ERROR - nothing was checked (mktemp failed)"; exit 2; }
trap 'rm -rf "$WORK"' EXIT

cat > "$WORK/control.spl" <<'SPL'
use std.nogc_sync_mut.io_runtime

fn main():
    val v = env_get("HOME")
    print("control ok")
SPL

timeout "$BUILD_TIMEOUT" "$BINARY" native-build "$WORK/control.spl" -o "$WORK/control.bin" > "$WORK/build.log" 2>&1
NB_RC=$?

# The worker truncates its own stderr from the MIDDLE and saves the full stream
# to a side file. Classify over the FULL stream when one exists, since counting
# over a truncated head+tail is explicitly unreliable.
FULL=$(grep -o '/mnt/data/tmp/native-build-stderr-[0-9]*\.log' "$WORK/build.log" 2>/dev/null | head -1)
SCANNED="$WORK/build.log"
if [ -n "${FULL:-}" ] && [ -f "$FULL" ]; then
    cat "$WORK/build.log" "$FULL" > "$WORK/scan.log"
    SCANNED="$WORK/scan.log"
fi

VERDICT=$(classify_log "$SCANNED" "$NB_RC")
CHECKED=2   # the two fenced signatures

case "$VERDICT" in
    NOLOG)
        echo "ERROR - nothing was checked (native-build produced no log)"
        exit 2
        ;;
    DECAYED:*)
        echo "FAIL - $CHECKED case(s) checked, E-HIR-BLOCK-VALUE-TYPE-DECAYED fired ${VERDICT#DECAYED:} time(s); PROBE B is tautological again (it must never test type_ while has_type_ is false)"
        exit 1
        ;;
    OBJINT:*)
        echo "FAIL - $CHECKED case(s) checked, 'cannot convert object to int' occurred ${VERDICT#OBJINT:} time(s); a raw enum-payload decode is reading a live object as a packed scalar again"
        exit 1
        ;;
    RC:*)
        if [ "$REQUIRE_SUCCESS" -eq 1 ]; then
            echo "FAIL - $CHECKED case(s) checked, both fenced signatures are absent but native-build exited ${VERDICT#RC:} and --require-success was given"
            exit 1
        fi
        echo "PASS - $CHECKED case(s) checked, 0 E-HIR-BLOCK-VALUE-TYPE-DECAYED and 0 object-to-int; native-build exited ${VERDICT#RC:}, NOT success -- blocker #5 is open (doc/08_tracking/bug/native_compile_nonterminating_io_runtime_2026-08-24.md); pass --require-success to assert exit 0"
        exit 0
        ;;
    OK)
        echo "PASS - $CHECKED case(s) checked, 0 E-HIR-BLOCK-VALUE-TYPE-DECAYED and 0 object-to-int, native-build of an io_runtime importer exited 0"
        exit 0
        ;;
    *)
        echo "ERROR - nothing was checked (classifier returned an unrecognised verdict: $VERDICT)"
        exit 2
        ;;
esac
