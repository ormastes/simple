run_guard "$named_ctor_unknown_field_guard" "named-constructor unknown-field rejection probe (full scan, not range-bound)"

# check-trait-solver-method-resolution-variant.shs: static shape guard --
# `try_trait_method_with_solver` must construct a `MethodResolution.<Variant>`
# enum value, never the struct-style field bag `MethodResolution(...)`, which
