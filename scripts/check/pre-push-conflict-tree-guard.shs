run_guard "$spipe_docgen_live_guard" "spipe docgen live-regeneration meta-guard (full scan, not range-bound)"
run_guard "$sspec_evidence_regen_guard" "sspec evidence regeneration determinism guard (full scan, not range-bound)"
run_guard "$ui_showcase_layering_guard" "ui_showcase import-layering guard (full scan, not range-bound)"
run_guard "$bootstrap_handoff_selftest_guard" "bootstrap platform handoff readiness gate self-test (full scan, not range-bound)" --self-test

