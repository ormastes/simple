#!/bin/sh
# git pre-push hook: refuse to push jj conflict commits.
#
# Install:
#   ln -sf ../../scripts/check/pre-push-conflict-tree-guard.shs .git/hooks/pre-push
#   chmod +x scripts/check/pre-push-conflict-tree-guard.shs
#
# Why this exists: scripts/check/check-no-conflict-tree-push.shs already detects
# the hazard correctly, but on 2026-07-25 a conflict commit reached `main`
# anyway, because the guard only runs when a human remembers to run it.
# `jj git push` does NOT block a conflict commit. This hook closes that gap by
# running the guard on every push, unconditionally.
#
# Range discipline: git feeds this hook one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# The outgoing range is therefore "<remote sha>..<local sha>" — exactly what is
# about to be sent. We never use main@{0}, which would sweep the whole reflog.
#
# Exit-status discipline: the guard is invoked WITHOUT a pipe and its output is
# captured to a file. Reading $? at the end of a pipeline yields the LAST
# command's status (e.g. `tail`'s 0), which has already caused an agent to
# record GUARD_EXIT=0 while the guard was printing DO NOT PUSH. We check the
# guard's real exit status AND scan its text for the refusal marker, and fail
# closed if either says stop.

# 2026-08-01: this hook previously ran ONLY the conflict-TREE guard, so literal
# conflict-MARKER text in file content could still be pushed through it. Both
# guards now run on every ref. The file keeps its original name because other
# docs reference it by path.
#
# 2026-08-01: `repo_root=... || exit 0` used to let a push through whenever
# `git rev-parse` failed — the same fail-open class this hook exists to close.
# It now refuses.
#
# 2026-08-01 (second amendment): a THIRD guard now runs on every ref —
# scripts/check/check-tree-size-push.shs, the tree-STRUCTURE gate. The two
# conflict guards only recognise `.jjconflict*` entries and literal marker text,
# so a tree truncated by anything else went straight through them. `main` was
# wiped to near-zero files twice in 24 hours with every guard green; the only
# thing that ever caught it was a human counting `git ls-tree -r | wc -l`. The
# tree-size guard automates that count plus a duplicate-entry check, a `src/`
# entry band and load-bearing-path floors. The file keeps its original name
# because other docs reference it by path.

set -u

GREP=grep
[ -x /usr/bin/grep ] && GREP=/usr/bin/grep

# 2026-08-08 (third amendment): TOPLEVEL PREFLIGHT.
# `repo_root` below is the anchor for every guard this hook runs. On 2026-08-08
# a stray `core.worktree = /tmp/simple-stage4-codex.QM6dqU` (plus `core.bare =
# true`) in the SHARED .git/config made `git rev-parse --show-toplevel` resolve
# to a temp worktree, so all four guards — including the tree-WIPE gate — were
# scanning a tree nobody was pushing. It only surfaced because one guard is
# fail-CLOSED and went loud; a content-dependent guard would have reported clean
# on the wrong files and passed the push silently. See
# doc/08_tracking/bug/shared_git_config_core_worktree_misdirects_prepush_guards_2026-08-08.md
#
# Git chdirs to the root of the working tree before invoking a hook, so in a
# HEALTHY repo the resolved toplevel is this very directory. That holds for a
# genuine LINKED worktree too: a linked worktree resolves its root through its
# own gitdir/commondir pointer pair, so toplevel is that worktree's own root —
# it differs from the main checkout, which is correct and must NOT be flagged.
# The check is therefore "toplevel IS the invoking tree", not "toplevel is the
# main checkout". Both sides are physically resolved (`pwd -P`) so a symlinked
# path does not produce a spurious refusal, and an invocation from a
# EQUALITY, NOT ANCESTRY. A first cut of this check also accepted "toplevel is
# an ancestor of cwd", to tolerate invocation from a subdirectory. That is
# fail-OPEN and was caught by a fixture: with `core.worktree = /tmp` and cwd
# `/tmp/<scratch>/main`, the ancestor form PASSED the exact pathology it exists
# to catch. Git chdirs to the working-tree root before invoking a hook, so
# equality is the correct and strictest test here.
is_bare=$(git rev-parse --is-bare-repository 2>/dev/null) || is_bare=""
if [ "$is_bare" != "false" ]; then
    echo "pre-push: git reports is-bare-repository='$is_bare' (expected 'false')" >&2
    echo "pre-push: a stray core.bare in .git/config misdirects every guard — refusing to push blind" >&2
    exit 1
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || repo_root=""
if [ -z "$repo_root" ]; then
    echo "pre-push: cannot locate the repository toplevel — refusing to push blind" >&2
    exit 1
fi

here_phys=$(pwd -P) || here_phys=""
root_phys=$(cd "$repo_root" 2>/dev/null && pwd -P) || root_phys=""
if [ -z "$here_phys" ] || [ -z "$root_phys" ]; then
    echo "pre-push: cannot physically resolve cwd ('$here_phys') or toplevel ('$root_phys')" >&2
    echo "pre-push: refusing to push blind" >&2
    exit 1
fi
case "$here_phys" in
    "$root_phys") : ;;
    *)
        echo "pre-push: TOPLEVEL MISMATCH — refusing to push blind." >&2
        echo "  git rev-parse --show-toplevel : $repo_root" >&2
        echo "  resolved                      : $root_phys" >&2
        echo "  invoking tree (pwd -P)        : $here_phys" >&2
        echo "pre-push: the guards would scan a tree nobody is pushing." >&2
        echo "pre-push: most likely a stray core.worktree in the SHARED .git/config —" >&2
        echo "  check with: git config --show-origin --get-all core.worktree" >&2
        echo "  and:        git config --show-origin --get-all core.bare" >&2
        exit 1
        ;;
esac

# Wiring check runs FIRST and unconditionally, before any range is derived.
# It is cheap (no object walks) and it is the only check that can catch the
# class of failure where this hook itself is half-installed. If we are running
# at all, most of its checks already passed — but it also fences the guards
# this hook shells out to, and it is the artifact a human/agent runs by hand
# before a plumbing push, which is the path that has no hook at all.
# See doc/08_tracking/bug/fourth_tree_wipe_6f86ff32a7d_guard_not_enforced_2026-08-11.md
hook_wiring_guard="$repo_root/scripts/check/check-hook-installation.shs"
if [ -f "$hook_wiring_guard" ]; then
    if ! sh "$hook_wiring_guard"; then
        printf 'pre-push: BLOCKED by check-hook-installation.shs — the guard wiring\n'
        printf '  itself is defective, so the other guards cannot be trusted to have run.\n'
        exit 1
    fi
else
    printf 'pre-push: BLOCKED — %s is missing.\n' "$hook_wiring_guard"
    exit 1
fi

tree_guard="$repo_root/scripts/check/check-no-conflict-tree-push.shs"
markers_guard="$repo_root/scripts/check/check-no-conflict-markers-push.shs"
size_guard="$repo_root/scripts/check/check-tree-size-push.shs"
seed_build_guard="$repo_root/scripts/check/check-seed-builds-push.shs"
runtime_api_guard="$repo_root/scripts/check/check-runtime-api-regression-push.shs"
jit_guard="$repo_root/scripts/check/check-jit-closure-blockers.shs"
try_op_guard="$repo_root/scripts/check/check-try-operator-error-propagation.shs"
list_shift_guard="$repo_root/scripts/check/check-untyped-list-element-shift.shs"
cuda_ntt_guard="$repo_root/scripts/check/check-x25519mlkem768-cuda-ntt.shs"
vulkan_ntt_guard="$repo_root/scripts/check/check-x25519mlkem768-vulkan-ntt.shs"
spec_tail_verdict_guard="$repo_root/scripts/check/check-spec-runner-tail-expression-verdict.shs"
use_warning_oracle_guard="$repo_root/scripts/check/check-use-warning-oracle-deployed.shs"
extern_fabrication_guard="$repo_root/scripts/check/check-native-extern-fabrication.shs"
implicit_self_field_guard="$repo_root/scripts/check/check-implicit-self-field-assignment.shs"
jit_module_drop_guard="$repo_root/scripts/check/check-no-jit-module-drop.shs"
native_option_bool_eq_guard="$repo_root/scripts/check/check-native-option-bool-eq-vs-literal.shs"
native_option_eq_repr_guard="$repo_root/scripts/check/check-native-option-eq-representation.shs"
jit_array_oob_guard="$repo_root/scripts/check/check-jit-array-oob-nil-sentinel.shs"
native_enum_match_payload_guard="$repo_root/scripts/check/check-native-enum-match-payload.shs"
native_utf8_slice_guard="$repo_root/scripts/check/check-native-utf8-slice.shs"
utf8_slice_audit_live_guard="$repo_root/scripts/check/check-utf8-slice-audit-live.shs"
test_tree_divergence_guard="$repo_root/scripts/check/check-test-tree-divergence.shs"
sabotage_residue_guard="$repo_root/scripts/check/check-no-sabotage-residue.shs"
vacuous_specs_guard="$repo_root/scripts/check/check-vacuous-specs.shs"
lint_binary_staleness_guard="$repo_root/scripts/check/check-lint-binary-staleness.shs"
env_get_nil_abort_guard="$repo_root/scripts/check/check-env-get-nil-abort-guard.shs"
env_get_dead_fallback_guard="$repo_root/scripts/check/check-env-get-dead-fallback-guard.shs"
rules_sdl_guard="$repo_root/scripts/check/check-rules-sdl.shs"
rules_sdl_integrity_guard="$repo_root/scripts/check/check-rules-sdl-integrity.shs"

# Parser / language-semantics correctness probes (2026-08-08 batch of 8): each
# drives a real `bin/simple run`/`native-build`/`lint` probe against a fixed
# fixture proving a specific, previously-silent correctness defect stays
# fixed (or, for the two KNOWN-OPEN canaries, stays pinned at its documented
# current behaviour). Full scan, not range-bound, same convention as the
# other compiler-probe/meta guards above.
lexer_radix_suffix_guard="$repo_root/scripts/check/check-lexer-radix-literal-suffix.shs"
for_loop_scoping_guard="$repo_root/scripts/check/check-for-loop-variable-scoping.shs"
tuple_index_oob_guard="$repo_root/scripts/check/check-tuple-index-out-of-range.shs"
array_remove_element_guard="$repo_root/scripts/check/check-array-remove-returns-element.shs"
named_ctor_unknown_field_guard="$repo_root/scripts/check/check-named-ctor-unknown-field-rejected.shs"
trait_solver_variant_guard="$repo_root/scripts/check/check-trait-solver-method-resolution-variant.shs"
pipe_lambda_parse_guard="$repo_root/scripts/check/check-pure-simple-pipe-lambda-parse.shs"
native_object_cache_granularity_guard="$repo_root/scripts/check/check-native-object-cache-granularity.shs"
spipe_docgen_live_guard="$repo_root/scripts/check/check-spipe-docgen-regeneration-live.shs"
sspec_evidence_regen_guard="$repo_root/scripts/check/check-sspec-evidence-regeneration.shs"
ui_showcase_layering_guard="$repo_root/scripts/check/check-ui-showcase-layering.shs"
bootstrap_handoff_selftest_guard="$repo_root/scripts/check/check-bootstrap-platform-handoff-readiness.shs"
gpu_backend_layer_evidence_guard="$repo_root/scripts/check/check-gpu-backend-layer-evidence.shs"
cpu_backend_artifacts_guard="$repo_root/scripts/check/check-cpu-backend-artifacts.shs"
mlkem_simd_c_lane_guard="$repo_root/scripts/check/build-mlkem-simd-c-lane.shs"
mlkem_cpu_simd_guard="$repo_root/scripts/check/check-x25519mlkem768-cpu-simd.shs"
mlkem_metal_ntt_guard="$repo_root/scripts/check/check-x25519mlkem768-metal-ntt.shs"
simpleos_io_audio_qemu_preflight_guard="$repo_root/scripts/check/check-simpleos-io-audio-qemu.shs"
simpleos_virtio_snd_qemu_selftest_guard="$repo_root/scripts/check/check-simpleos-virtio-snd-qemu.shs"
render_perf_milestone_gate_guard="$repo_root/scripts/check/check-render-perf-milestone-gate.shs"
wm_lane_boundary_guard="$repo_root/scripts/check/check-wm-lane-boundary.shs"
class_identity_matrix_guard="$repo_root/scripts/check/check-class-identity-engine-matrix.shs"
native_inprocess_positional_guard="$repo_root/scripts/check/check-native-inprocess-positional-nonvacuous.shs"
predicate_parser_native_build_guard="$repo_root/scripts/check/check-predicate-parser-native-build.shs"

# 2026-08-09 batch-3 re-verification (doc/08_tracking/bug/guard_wiring_optout_false_exemptions_2026-08-06.md):
# both re-confirmed GREEN from a clean host with base tools only, fast
# (well under a minute each), source-shape/doc-presence checks, no hardware
# deps. Their opt-out entries already said "NOT genuinely exempt; wire it"
# in batch 3 on 2026-08-06; still true on re-run.
gui_web_2d_completion_criteria_guard="$repo_root/scripts/check/check-gui-web-2d-completion-criteria-placeholders.shs"
gui_web_2d_parallel_review_guard="$repo_root/scripts/check/check-gui-web-2d-parallel-agent-review-evidence.shs"

# 2026-08-09 batch-4 (guard-wiring hardening campaign): four more guards found
# unwired by check-guard-wiring.shs. Each verified standalone before wiring —
# see the header comment near each run_guard call below for what was measured.
class_identity_seed_matrix_guard="$repo_root/scripts/check/check-class-identity-seed-matrix.shs"
engine_claiming_specs_guard="$repo_root/scripts/check/check-engine-claiming-specs-use-probe.shs"
engine_claiming_specs_delta_guard="$repo_root/scripts/check/check-engine-claiming-specs-use-probe-delta.shs"
engine_differential_guard="$repo_root/scripts/check/check-engine-differential.shs"
lint_cached_guard="$repo_root/scripts/check/lint-cached.shs"

# 2026-08-09 batch-5: native-build omitted-trailing-default-parameter regression
# gate, found unwired by check-guard-wiring.shs. See run_guard call near the
# other native-build probe guards below for verification detail.
native_trailing_default_param_guard="$repo_root/scripts/check/check-native-trailing-default-param.shs"

for g in "$tree_guard" "$markers_guard" "$size_guard" "$seed_build_guard" "$runtime_api_guard" "$jit_guard" \
         "$try_op_guard" "$list_shift_guard" \
         "$cuda_ntt_guard" "$vulkan_ntt_guard" \
         "$spec_tail_verdict_guard" "$use_warning_oracle_guard" \
         "$extern_fabrication_guard" "$implicit_self_field_guard" \
         "$jit_module_drop_guard" \
         "$native_option_bool_eq_guard" "$native_option_eq_repr_guard" \
         "$jit_array_oob_guard" "$native_enum_match_payload_guard" \
         "$native_utf8_slice_guard" "$utf8_slice_audit_live_guard" \
         "$test_tree_divergence_guard" "$sabotage_residue_guard" \
         "$vacuous_specs_guard" "$lint_binary_staleness_guard" \
         "$env_get_nil_abort_guard" "$env_get_dead_fallback_guard" \
         "$lexer_radix_suffix_guard" "$for_loop_scoping_guard" \
         "$tuple_index_oob_guard" "$array_remove_element_guard" \
         "$named_ctor_unknown_field_guard" "$trait_solver_variant_guard" \
         "$pipe_lambda_parse_guard" "$native_object_cache_granularity_guard" \
         "$spipe_docgen_live_guard" "$sspec_evidence_regen_guard" \
         "$ui_showcase_layering_guard" "$bootstrap_handoff_selftest_guard" \
         "$gpu_backend_layer_evidence_guard" "$cpu_backend_artifacts_guard" \
         "$mlkem_simd_c_lane_guard" "$mlkem_cpu_simd_guard" "$mlkem_metal_ntt_guard" \
         "$simpleos_io_audio_qemu_preflight_guard" "$simpleos_virtio_snd_qemu_selftest_guard" \
         "$render_perf_milestone_gate_guard" "$wm_lane_boundary_guard" \
         "$class_identity_matrix_guard" \
         "$native_inprocess_positional_guard" "$predicate_parser_native_build_guard" \
         "$gui_web_2d_completion_criteria_guard" "$gui_web_2d_parallel_review_guard" \
         "$class_identity_seed_matrix_guard" "$engine_claiming_specs_guard" \
         "$engine_differential_guard" "$lint_cached_guard" \
         "$native_trailing_default_param_guard"; do
    [ -f "$g" ] || {
        echo "pre-push: guard script missing at $g — refusing to push blind" >&2
        exit 1
    }
done

zero='0000000000000000000000000000000000000000'
status=0

# JIT closure-blocker gate runs once per push (not per-ref, not range-bound):
# it statically scans the hot render/UI lanes on disk for lambda/`_`-closure
# forms the seed JIT refuses to compile (see the guard's own header). Unlike
# the three guards above it does not inspect the outgoing commit range.

# Run one guard, capture to a FILE (never a pipe — a pipeline's $? is the last
# command's, which has already caused an agent to record GUARD_EXIT=0 while the
# guard was printing DO NOT PUSH). Sets `status` on any refusal.
run_guard() {
    _g=$1
    _range=$2
    shift 2
    _out=$(mktemp) || exit 1
    sh "$_g" "$@" >"$_out" 2>&1
    _st=$?
    # Belt and braces: trust neither signal alone. Fail closed on either.
    if "$GREP" -q -e 'DO NOT PUSH' -e 'ERROR —' "$_out" || [ "$_st" -ne 0 ]; then
        cat "$_out" >&2
        echo "" >&2
        echo "pre-push: BLOCKED by $(basename "$_g") (status $_st) for range $_range" >&2
        echo "pre-push: override only if you have read the guard output above:" >&2
        echo "  git push --no-verify ..." >&2
        status=1
    fi
    rm -f "$_out"
}

pushed_sha_file=$(mktemp) || exit 1
pushed_base_file=$(mktemp) || exit 1
trap 'rm -f "$pushed_sha_file" "$pushed_base_file"' EXIT INT TERM

while read -r _local_ref local_sha _remote_ref remote_sha; do
    # Deleting a remote ref: nothing to inspect.
    [ "$local_sha" = "$zero" ] && continue

    # Record the last non-deleted local_sha for guards that run AFTER this
    # loop (once per push, full scan) but still need the exact commit being
    # pushed -- e.g. check-test-tree-divergence.shs --ref. Written to a file,
    # not just left in the shell variable: on some shells `while read` here
    # runs in a subshell (stdin is a pipe from git), so a plain variable does
    # not survive past `done`.
    printf '%s\n' "$local_sha" > "$pushed_sha_file"
    # Same trick for the range BASE, needed by the divergence guard's
    # half-landed-fix check (--base): it must see which paths the outgoing
    # range actually edited. Empty for a new ref (no base to diff against);
    # the guard then reports the half-landed check as skipped rather than
    # silently passing it.
    if [ "$remote_sha" != "$zero" ]; then
        printf '%s\n' "$remote_sha" > "$pushed_base_file"
    fi

    if [ "$remote_sha" = "$zero" ]; then
        # New ref: bound the walk by whatever the remote already has, so we do
        # not walk the entire history of the repository.
        #
        # ORDER IS LOAD-BEARING. This used to be
        #     range="--not --remotes=origin $local_sha"
        # which puts $local_sha AFTER --not, so git rev-list EXCLUDES it and
        # walks ZERO commits. Paired with the old guard's "0 commits => nothing
        # to push => exit 0", every new-ref push was waved through unchecked.
        # PROVED 2026-08-01 against a conflict-tree fixture commit. The
        # positive rev must come FIRST.
        remotes=$(git rev-parse --remotes=origin 2>/dev/null | tr '\n' ' ')
        markers_range=""
        if [ -n "$remotes" ]; then
            # shellcheck disable=SC2086
            mb=$(git merge-base --octopus "$local_sha" $remotes 2>/dev/null) || mb=""
            [ -n "$mb" ] && markers_range="$mb..$local_sha"
        fi
        run_guard "$tree_guard" "new ref $local_sha (not on origin)" \
            --rev-list-args "$local_sha" --not --remotes=origin
        run_guard "$size_guard" "new ref $local_sha (not on origin)" \
            --rev-list-args "$local_sha" --not --remotes=origin
        # check-seed-builds-push.shs: cannot resolve a two-endpoint range on a
        # brand-new ref via --rev-list-args (it needs base..new, not a
        # rev-list exclusion set), so it is skipped here and relies on the
        # markers-range branch below when one can be derived.
    else
        markers_range="$remote_sha..$local_sha"
        run_guard "$tree_guard" "$remote_sha..$local_sha" "$remote_sha..$local_sha"
        # The size guard takes the SAME range and uses its left endpoint —
        # exactly the tree this push replaces — as the reference count for the
        # relative band.
        run_guard "$size_guard" "$remote_sha..$local_sha" "$remote_sha..$local_sha"
        # check-seed-builds-push.shs (added 2026-08-11, incident:
        # origin_main_unbuildable_rust_seed_2026-08-11.md): none of the
        # structural guards above compile anything, so a structurally clean
        # tree could still fail `cargo build`. Fast path-filtered (PASS
        # immediately if the range doesn't touch src/compiler_rust or
        # src/runtime); only runs `cargo check --release --bin simple`
        # against an isolated worktree of the pushed tip when it does.
        run_guard "$seed_build_guard" "$remote_sha..$local_sha" "$remote_sha..$local_sha"
        # check-runtime-api-regression-push.shs (added 2026-08-11, incident:
        # 6e2f613d302 silently deleted 44 exported rt_* runtime functions
        # while every guard above passed -- tree-size bands on file COUNT
        # not symbol count, seed-build only runs when cargo check happens to
        # be invoked downstream of this hook). Diffs the DEFINED rt_* symbol
        # set (Rust + C runtime implementations, evaluated separately) at
        # the range endpoints from committed content; FAILs on >=5 removed
        # in one push, or on ANY symbol still re-exported in lib.rs but no
        # longer defined anywhere (unbuildable Rust crate, no escape).
        run_guard "$runtime_api_guard" "$remote_sha..$local_sha" "$remote_sha..$local_sha"
        # rules.sdl shrink gates (2026-08-11): the guards above prove the tree is
        # STRUCTURALLY sound; none of them notice a tree that is intact but has
        # fewer tests, doctests, or check scripts in it than the one it replaces.
        # Deleting the failing test is the cheapest way for an agent to show green,
        # and it reads as a tidy-up in a diff. Quick group only — the heavy scenario
        # lanes belong to bootstrap, which runs --group full.
        run_guard "$rules_sdl_guard" "$local_sha (rules.sdl quick gates)" \
            --group quick --ref "$local_sha"
        # ...and the registry itself may not shrink to escape the registry.
        run_guard "$rules_sdl_integrity_guard" "$remote_sha..$local_sha" \
            "$remote_sha" "$local_sha"
    fi

    if [ -z "$markers_range" ]; then
        echo "pre-push: cannot derive a two-endpoint range for the conflict-marker" >&2
        echo "  guard on a brand-new ref with no shared origin history — refusing" >&2
        echo "  to push unverified. Fetch origin first, or push with --no-verify" >&2
        echo "  only after checking the content by hand." >&2
        status=1
    else
        run_guard "$markers_guard" "$markers_range" "$markers_range"

        # lint-cached.shs: content-addressed fast path for `bin/simple lint`
        # (scripts/check/lint-cached.shs header: ~11.7s fixed startup + ~3-4s
        # per function under the uncached linter, so re-linting an unchanged
        # tree every push is wasteful; a CLEAN result is cached by exact
        # binary+config+content hash and a dirty one is never cached). Lints
        # only the .spl files this ref's range actually touches, same range
        # discipline as markers_guard above. Verified standalone 2026-08-09:
        # a clean file PASSes and a repeat run hits the cache (0 linted).
        changed_spl=$(git diff --name-only --diff-filter=ACMR "$markers_range" -- '*.spl' 2>/dev/null | tr '\n' ' ')
        if [ -n "$changed_spl" ]; then
            # shellcheck disable=SC2086
            run_guard "$lint_cached_guard" "$markers_range (changed .spl files)" $changed_spl
        fi
    fi
done

# These two compiler-probe guards fence live-tracked regressions (`?`-operator
# Err propagation, and the untyped `: list` element-read <<3 corruption). Like
# the JIT closure gate above, they compile and run a fixed probe through the
# compiler under test rather than inspecting the outgoing diff, so they are not
# range-bound either -- they run once per push, full scan.
run_guard "$try_op_guard" "compiler probe (full scan, not range-bound)"
run_guard "$list_shift_guard" "compiler probe (full scan, not range-bound)"

run_guard "$jit_guard" "hot lanes (full scan, not range-bound)"

# X25519/ML-KEM768 NTT correctness guards: silent number-theoretic-transform
# corruption in a post-quantum crypto primitive is a security-grade risk. Both
# guards compile+run a fixed probe against the real device and are hardware-
# gated: on a host without ptxas+nvidia-smi (CUDA) or glslangValidator+
# spirv-val (Vulkan) they self-report "STATUS: BLOCKED <reason>" with exit 2,
# never a false PASS — consistent with this repo's fail-closed convention for
# BLOCKED (see check-native-option-bool-llvm-verify.shs: "exit 2, NOT 0"). A
# host with the hardware/tooling present gets a real correctness check; a host
# without it must explicitly override with --no-verify to push, same as the
# jit_guard above. Full scan, not range-bound.
run_guard "$cuda_ntt_guard" "x25519mlkem768 CUDA NTT probe (full scan, not range-bound)"
run_guard "$vulkan_ntt_guard" "x25519mlkem768 Vulkan NTT probe (full scan, not range-bound)"

# Meta-guards: these two police the spec/lint HARNESS itself, not application
# code, so their blast radius is every other guard and spec's "verified" claim
# in this repo. Both run a fixed positive-control probe rather than inspecting
# the outgoing diff, so like the guards above they run once per push, full
# scan, not range-bound.
#
# check-spec-runner-tail-expression-verdict.shs: proves `describe(...)` as the
# tail expression of `fn main()` no longer manufactures a false exit-1 verdict,
# and that the runner's `dropped == 0` completeness gate has not been silently
# reverted (it was once, by a commit whose subject was unrelated).
#
# check-use-warning-oracle-deployed.shs: proves the deployed `bin/simple`'s
# `[use-warning]` unresolved-import oracle is actually live and not
# over/under-firing. As of 2026-08-08 this guard is RED for a live reason: the
# extern-fn/extern-class branch was removed from
# `locally_defined_names()` in
# src/compiler_rust/compiler/src/interpreter_module/module_loader.rs (a
# "SABOTAGE-TEMP ... RESTORE" comment was left in and never reverted), so the
# oracle now false-positives on every `extern fn`/`extern class` surface
# repo-wide. Wiring it in is correct: it should block pushes until that branch
# is restored, not be silenced to get a clean wire-in.
run_guard "$spec_tail_verdict_guard" "spec-harness verdict meta-guard (full scan, not range-bound)"
run_guard "$use_warning_oracle_guard" "use-warning oracle deployed-binary meta-guard (full scan, not range-bound)"

# check-native-extern-fabrication.shs: guards the AOT (`native-build`) host-
# target linker against fabricated/stub `@extern fn` bindings masquerading as
# real ones (doc/08_tracking/bug/native_link_fabricates_weak_empty_extern_definitions_2026-08-01.md).
# As of 2026-08-08 the underlying defect is a documented KNOWN-OPEN gap: the
# guard's own control+default probes assert the CURRENT (defective) fabrication
# behaviour rather than silently absorbing it, so a normal run reports
# KNOWN-OPEN lines and still exits 0/PASS; it only fails if the shape of the
# defect changes unexpectedly (an unrelated build break, or the gap closing
# without the guard being promoted). Drives real `native-build` compiles, so
# like the probe guards above it is not range-bound -- full scan, once per push.
run_guard "$extern_fabrication_guard" "native-build extern-fabrication probe (full scan, not range-bound)"

# check-implicit-self-field-assignment.shs: a bare `field = value` inside a
# method must be a hard error naming the field on every engine, never a silent
# no-op that discards the write
# (doc/08_tracking/bug/interp_implicit_self_field_assignment_silent_noop_2026-07-17.md).
# Drives `bin/simple run` directly under both interpreter and JIT settings
# rather than inspecting the outgoing diff -- full scan, not range-bound.
run_guard "$implicit_self_field_guard" "implicit self-field-assignment probe (full scan, not range-bound)"

# check-no-jit-module-drop.shs: fail-closed fence against a paren-less
# accessor (`.length`/`.len`/`.size`/`.empty`/`.chars`/`.first`/`.last`/
# `.capacity`) on a builtin container silently dropping its WHOLE ENCLOSING
# MODULE from the JIT to the tree-walk interpreter -- a documented ~100-1000x
# perf cliff invisible to `run`, only surfaced by `compile`
# (doc/08_tracking/bug/paren_less_accessor_whole_module_de_jit_2026-08-08.md).
# This is a structural/diagnostic fence, not a wall-clock timing measurement:
# the oracle is the compiler's own "cannot infer field type while lowering"
# diagnostic on a per-file `compile` pass, not a stopwatch. `--candidates`
# narrows the scan to files that textually contain a paren-less accessor (a
# pure superset filter) to bound the cost of the otherwise whole-tree,
# per-file-compile scan the guard's own header flags as multi-minute. Full
# scan, not range-bound, same as the other compiler-probe guards above.
run_guard "$jit_module_drop_guard" "jit module-drop de-JIT probe (full scan, not range-bound)" --candidates

# Native/JIT engine representation-correctness probes (2026-08-08 batch): six
# guards that drive real `native-build`/`compile --native`/`run` invocations to
# fence documented AOT/JIT engine defects no `*_spec.spl` can observe (the
# interpreter-only default execution mode never reaches these lanes). Several
# of these are KNOWN-OPEN fences by design -- they pin the CURRENT (defective)
# behaviour so a change in either direction (regression, or the gap silently
# closing) is caught, rather than the guard being silenced to get a clean
# wire-in. Full scan, not range-bound, same convention as the other compiler-
# probe guards above.
#
# check-native-option-bool-eq-vs-literal.shs: AOT `Option<bool>` equality
# against a raw bool/nil literal (doc/08_tracking/bug/native_option_bool_eq_against_raw_literal_2026-08-06.md).
run_guard "$native_option_bool_eq_guard" "native Option<bool>-vs-literal eq probe (full scan, not range-bound)"

# check-native-option-eq-representation.shs: AOT inlined `Option<text>` return
# equality, free-function and struct-method shapes (doc/08_tracking/bug/native_inlined_option_return_representation_mismatch_2026-08-02.md).
run_guard "$native_option_eq_repr_guard" "native inlined Option<text> eq representation probe (full scan, not range-bound)"

# check-jit-array-oob-nil-sentinel.shs: JIT array out-of-bounds read leaking
# the raw RT_NIL sentinel word instead of panicking
# (doc/08_tracking/bug/jit_array_oob_read_leaks_raw_rt_nil_sentinel_2026-08-07.md).
# KNOWN-OPEN by design -- the JIT lane still leaks the sentinel as of
# 2026-08-08; this guard asserts the interpreter reference lane is correct and
# records the JIT gap so it flips loudly if either side changes.
run_guard "$jit_array_oob_guard" "JIT array-OOB nil-sentinel-leak probe (full scan, not range-bound)"

# check-native-enum-match-payload.shs: AOT (`--native`) payload-bearing enum
# `match` (doc/08_tracking/bug/match_on_enum_native_lowering_status_2026-08-07.md).
# KNOWN-OPEN by design -- payload-free enum match compiles/runs correctly
# under --native; payload-bearing match is still fail-closed with the
# documented PatternMatch diagnostic.
run_guard "$native_enum_match_payload_guard" "native enum-match payload-bearing probe (full scan, not range-bound)"

# check-native-utf8-slice.shs: AOT/JIT-vs-interpreter UTF-8 mid-codepoint
# slicing divergence across three named policies plus native-build/compile
# --native reachability (doc/08_tracking/bug/native_slice_splits_utf8_three_divergent_policies_2026-08-01.md).
# KNOWN-OPEN by design -- pins the current (known-wrong) raw-bytes-no-
# validation behaviour on all three policies so any engine change is caught
# here instead of landing unfenced.
run_guard "$native_utf8_slice_guard" "native/JIT UTF-8 mid-codepoint slice divergence probe (full scan, not range-bound)"

# check-utf8-slice-audit-live.shs: proves the SIMPLE_UTF8_SLICE_AUDIT
# instrument is actually compiled into and live in the deployed `bin/simple`
# binary (a self-proving self_test violation line), not just present in
# source -- on 2026-08-02 the module was an ancestor of main but the deployed
# binary was never rebuilt from a tree containing it, so the instrument was
# silently inert.
run_guard "$utf8_slice_audit_live_guard" "utf8-slice-audit-instrument liveness probe (full scan, not range-bound)"

# Self-integrity meta-guards + known-crash guards (2026-08-08 batch of 6):
# these police the repo's OWN measurement/verification apparatus and two
# already-tracked, still-open crash-class defects. Full scan, not range-bound,
# same convention as the other compiler-probe/meta guards above.
#
# check-test-tree-divergence.shs: fences the LIVE duplicate test trees
# (test/01_unit vs test/unit, test/02_integration vs test/integration) from
# drifting further apart without anyone noticing
# (doc/08_tracking/bug/test_tree_divergence_982_diagnosis_2026-08-08.md).
# Baseline-relative: only NEW divergence or a stale (now-identical) baseline
# entry fails it. As of 2026-08-08 it is EXPECTED GREEN against the 981-pair
# baseline recorded in scripts/check/test_tree_divergence_baseline.txt -- the
# real divergence is tracked separately and is not this guard's job to fix.
# 2026-08-08: this guard used to read the live on-disk working copy, so
# another concurrent session's uncommitted scratch edits under test/ (this
# host runs several agent sessions against ONE shared WC) could flip its
# verdict for a push that never touched test/ at all -- `git push` only ever
# sends committed content. `--ref <pushed-sha>` makes it compare the
# COMMITTED tree actually being pushed instead (see pushed_sha_file above).
pushed_sha=$(cat "$pushed_sha_file" 2>/dev/null)
pushed_base=$(cat "$pushed_base_file" 2>/dev/null)
if [ -n "$pushed_sha" ] && [ -n "$pushed_base" ]; then
    run_guard "$test_tree_divergence_guard" "test-tree mirrored-pair divergence + half-landed-fix meta-guard" --ref "$pushed_sha" --base "$pushed_base"
elif [ -n "$pushed_sha" ]; then
    run_guard "$test_tree_divergence_guard" "test-tree mirrored-pair divergence meta-guard (full scan, not range-bound)" --ref "$pushed_sha"
else
    # No non-deleted ref went out (e.g. a delete-only push) -- nothing was
    # actually pushed for this guard to check against; skip rather than fall
    # back to the live WC, which would reintroduce the exact hazard above.
    echo "pre-push: no pushed commit to check test-tree divergence against — skipping (delete-only push)" >&2
fi

# check-no-sabotage-residue.shs: fences unrestored sabotage/verification
# markers (SABOTAGE, MARKER-/MARKER_, TEMP-PROBE, XXX-DEBUG, DEBUGME) left in
# the working copy but absent from origin/main.
run_guard "$sabotage_residue_guard" "sabotage-verification residue meta-guard (full scan, not range-bound)"

# check-vacuous-specs.shs: mechanically enumerates the non-discriminating
# ("vacuous") spec family (Tier A: zero-assertion blocks, tautologies,
# constant-subject assertions, weak shape-only assertions, stub-helper-only
# blocks) across every *_spec.spl in the corpus. --selftest always runs first
# and is fatal, guarding against this repo's documented fail-open sweep
# patterns (anchored-regex-line-1-only, path-prefix-missing, def-keyword
# collision).
run_guard "$vacuous_specs_guard" "vacuous-spec Tier-A sweep meta-guard (full scan, not range-bound)"

# check-lint-binary-staleness.shs: proves the deployed lint oracle
# (bin/release/x86_64-unknown-linux-gnu/simple) actually contains fresh
# diagnostic markers (MEXH006, W-MC-RES-001) landed in pure-Simple source.
# EXPECTED RED as of 2026-08-08: the deployed binary is the Rust bootstrap
# seed itself, not a genuinely self-hosted build -- see WP-3.5
# (doc/03_plan/language/assurance/aerospace_hardening_plan_2026-08-07.md) and
# the Stage-3 self-host SIGSEGV blocker
# (doc/08_tracking/bug/t3_full_bootstrap_stage3_unresolved_type_byteorder_cache_validator_2026-08-06.md).
# Wired in RED on purpose: it should keep reminding every push that
# `bin/simple lint` is not a trustworthy oracle for source-level lint claims
# until a genuine redeploy lands; do not silence it to force a clean wire-in.
run_guard "$lint_binary_staleness_guard" "deployed lint-binary staleness meta-guard (full scan, not range-bound)"

# check-env-get-nil-abort-guard.shs / check-env-get-dead-fallback-guard.shs:
# positive controls for the two-sided rt_env_get `??` defect family --
# unguarded env_get(...).method() silently aborts the enclosing function on an
# unset var (doc/08_tracking/bug/rt_env_get_nil_silently_aborts_enclosing_function_2026-08-08.md),
# and the sibling guarded wrapper makes `env_get(K) ?? "default"` a dead
# fallback that can never fire (doc/08_tracking/bug/env_get_nil_coalesce_dead_fallback_2026-07-25.md).
# Both drive a real `bin/simple run` probe proving the mechanism still
# reproduces (so the control cannot go vacuous) plus a structural regression
# check on the landed call sites.
run_guard "$env_get_nil_abort_guard" "env_get nil silent-abort mechanism probe (full scan, not range-bound)"
run_guard "$env_get_dead_fallback_guard" "env_get dead-fallback mechanism probe (full scan, not range-bound)"

# check-lexer-radix-literal-suffix.shs: pins the radix-literal-suffix lexer
# fix (b0f5308993 / fd3d8c1da3) via its own *_spec.spl, run with
# --no-session-daemon so the harness actually emits a SPEC FILE VERDICT line.
run_guard "$lexer_radix_suffix_guard" "lexer radix-literal-suffix spec probe (full scan, not range-bound)"

# check-for-loop-variable-scoping.shs: `for x in ...` must not leak its
# binding into, or clobber a pre-existing `val` in, the enclosing scope
# (doc/08_tracking/bug/for_loop_variable_leaks_into_enclosing_scope_2026-08-04.md).
