# fast (well under a minute), deterministic, no hardware deps.
run_guard "$wm_lane_boundary_guard" "WM/GUI/web/2D portable-lane boundary ratchet (full scan, not range-bound)"

# check-class-identity-engine-matrix.shs: its own header states it MEASURES
# rather than gates correctness (both seed engines are known-wrong in
# opposite directions, see
# doc/03_plan/ui/perf/f1_class_identity_kind_propagation_plan_2026-08-09.md).
# What it DOES gate is a distinct, correctness-adjacent risk: that the
# pure-Simple frontend-interpreter lane silently falls back to executing on
# the seed instead of reaching its own engine, which would make every
# reading from that lane a false positive. PASS proves genuine divergence
# from seedINTERP; FAIL/ERROR mean "suspect silent fallback" / "no readings
# at all" -- a real, non-decorative pass/fail signal despite the "measures"
# framing. Verified standalone 2026-08-09: exits 0 in well under 300s (9/10
# readings, diverging on 6 cases) -- the header's "tens of minutes on a
# loaded box" warning describes worst-case host contention, not the typical
# runtime. Full scan, not range-bound, same as the probes above.
run_guard "$class_identity_matrix_guard" "class-identity engine-matrix divergence probe (full scan, not range-bound)"

# check-native-inprocess-positional-nonvacuous.shs: fences the pure-Simple
# IN-PROCESS native-build lane (`native-build <one.spl> --output X` with NO
# `--source` and NO `--entry`) -- the only invocation shape that goes through
# native_build_single_spl_positional instead of delegating to the Rust seed
# FFI. Every other native-build guard in this file uses the --source/--entry
# shape, so until this guard existed the in-process lane had zero coverage;
# that gap let a MIR-lowering defect and a vacuous stub binary both go
# undetected for days (doc/08_tracking/bug/stage3_vacuous_binary_is_enum_discriminant_garbage_not_a_link_failure_2026-08-08.md).
# Verified standalone 2026-08-09: exits 0 in ~2m15s. Full scan, not
# range-bound, same convention as the other compiler-probe guards above.
run_guard "$native_inprocess_positional_guard" "in-process positional native-build nonvacuous probe (full scan, not range-bound)"

# check-predicate-parser-native-build.shs: narrow native-build regression
# check scoped to src/compiler/00.common/predicate_parser.spl, guarding
# against undeclared-symbol codegen errors like the has_paren_idx bug where a
# typo'd local variable passed the interpreter silently (unresolved variable
# references are only a warning there) but broke LLVM codegen
# (doc/08_tracking/bug/stage2_native_build_has_paren_idx_undeclared_global_2026-08-09.md).
# Verified standalone 2026-08-09: exits 0 in ~1m22s. Full scan, not
# range-bound, same convention as the other compiler-probe guards above.
run_guard "$predicate_parser_native_build_guard" "predicate-parser native-build regression probe (full scan, not range-bound)"

# check-gui-web-2d-completion-criteria-placeholders.shs and
