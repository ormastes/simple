# during the batch-3 opt-out re-verification pass. Both are fast
# (well under a minute), deterministic, source-shape/doc-presence checks with
# no hardware/GPU/display dependency -- re-run clean twice on a plain Linux
# host. Full scan, not range-bound, same convention as the probes above.
run_guard "$gui_web_2d_completion_criteria_guard" "gui-web-2d completion-criteria placeholder gate (full scan, not range-bound)"
run_guard "$gui_web_2d_parallel_review_guard" "gui-web-2d parallel-agent-review evidence gate (full scan, not range-bound)"

# check-class-identity-seed-matrix.shs: fast-lane companion to
# class_identity_matrix_guard above -- the two-column SEED-only (seedJIT vs
# seedINTERP) class/struct identity corpus, meant to run once per seed
# rebuild rather than the tens-of-minutes three-engine matrix. Its own header
# states it MEASURES rather than asserts a correctness contract (both seed
# engines are known-wrong in opposite directions as of 2026-08-09); what it
# DOES gate is completeness -- a truncated run (an engine came up short) is a
# real FAIL, not a decorative one. Verified standalone 2026-08-09: PASS,
# complete 11/11 readings on both engines, well under a minute.
run_guard "$class_identity_seed_matrix_guard" "class-identity SEED-only matrix completeness probe (full scan, not range-bound)"

# check-engine-claiming-specs-use-probe.shs: ratchet guard against a spec
# whose describe/it TITLE claims JIT/native/codegen/AOT coverage while its
# body physically executes on the tree-walking interpreter (the only engine a
# *_spec.spl can ever reach -- see the script's own header for the 4 stacked
# layers that force this). Baseline-relative: only a NEW unbaselined offender
# fails it. --selftest gates every scan and is fatal. Verified standalone
# 2026-08-09: PASS, well under a minute (25024 spec files scanned, 197
# engine-claiming, 192 already baselined).
# 2026-08-17: this used to be a FULL WORKING-TREE scan, which is structurally
# wrong for a push gate -- a push only ever sends COMMITTED content. Measured on
# this host: of 56 reported offenders, 52 were already committed at origin/main
# (other lanes' pre-existing debt) and 4 were UNTRACKED scratch files from one of
# ~16 concurrent agent sessions sharing this single working copy, so one lane's
# temporary file blocked every lane's push. Now range-scoped and
# committed-content-only via the delta helper, exactly as
# check-test-tree-divergence.shs already is (.claude/rules/vcs.md). The ratchet
# itself is NOT weakened: a newly introduced offender still hard-blocks, and the
# helper requires the pre-existing offender list to be recorded before landing.
if [ -n "$pushed_sha" ] && [ -n "$pushed_base" ]; then
    run_guard "$engine_claiming_specs_delta_guard" "$pushed_base..$pushed_sha (engine-claiming-spec-without-probe ratchet, committed content only)" \
        "$pushed_base" "$pushed_sha"
elif [ -n "$pushed_sha" ]; then
    # New ref with no base on origin: no two-endpoint range exists, so evaluate
    # the pushed commit's committed content directly. Still never the working copy.
    run_guard "$engine_claiming_specs_guard" "engine-claiming-spec-without-probe ratchet at $pushed_sha (new ref, committed content only)" \
        --ref "$pushed_sha"
else
    echo "pre-push: no pushed commit to check the engine-claiming-spec ratchet against — skipping (delete-only push)" >&2
fi

# check-engine-differential.shs: multi-engine differential harness comparing
# interpret/jit/native readings against a fixed fixture corpus, baseline-
# relative (only a NEW unbaselined divergence fails it). DIFF_LANES=interpret,jit
# is this script's own documented "fast pre-push configuration" -- the native
# lane drives a full native-build per fixture and costs several minutes, and
# on this host it additionally reports LANE_ERROR (native-build produced no
# artifact), which the harness fails closed on rather than counting as a
# divergence. EXPECTED RED as of 2026-08-09: even the fast two-lane config
# surfaces one genuine NEW unbaselined divergence (i64_boundary_values: JIT
# wraps large p60/p62/i64-max constants to negative/zero while the
# interpreter does not) alongside the one already-baselined UTF-8-slice
# divergence. Wired in RED on purpose, same convention as
# lint_binary_staleness_guard and native_object_cache_granularity_guard
# above: this is a live, previously-unfenced correctness gap, and silencing
# the guard to force a clean wire-in would hide it again. File the
# i64_boundary_values divergence and baseline it (or fix it) to turn this
# green; do not weaken the guard.
DIFF_LANES=interpret,jit run_guard "$engine_differential_guard" "interpret-vs-jit engine differential probe (full scan, not range-bound)"

# check-native-trailing-default-param.shs: native-build (AOT) regression gate
# for omitted TRAILING default parameters
# (doc/08_tracking/bug/native_trailing_default_param_reads_uninitialized_2026-08-09.md).
# `bin/simple test` hard-defaults to the tree-walk interpreter, which binds
# defaults correctly from HirFunction.params directly, so no *_spec.spl can
# ever observe this lane -- only a script that actually drives native-build
# can fence it. Covers every call shape the predecessor fix missed: same-
# module free function (2 arities), cross-module free function with a
# CALL-expression default and a CONST-expression default, instance method
# (receiver + synthetic self alignment), and static method. Verified
# standalone 2026-08-09: PASS in ~2m56s. Drives a real native-build compile
# rather than inspecting the outgoing diff, so like the other native-build
# probe guards above it is not range-bound -- full scan, once per push.
run_guard "$native_trailing_default_param_guard" "native-build trailing-default-parameter probe (full scan, not range-bound)"

exit $status
