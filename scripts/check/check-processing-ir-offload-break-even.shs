#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

BUILD_DIR="${BUILD_DIR:-build/simpleos_gpu_host/offload_break_even}"
READBACK_DIR="${READBACK_DIR:-$BUILD_DIR/current_emitter_cuda}"
EVIDENCE="$BUILD_DIR/evidence.env"
RAW_SAMPLES="$BUILD_DIR/raw-samples.tsv"
HARNESS_SOURCE="test/05_perf/local_gpu_check/c_cuda/processing_ir_offload_break_even.c"
HARNESS="$BUILD_DIR/processing_ir_offload_break_even"
FILL_CHECKER="scripts/check/check-processing-ir-offload-fill-u32-break-even.shs"
CC_TOOL="${CC_TOOL:-cc}"
WARMUPS="${WARMUPS:-3}"
SAMPLES="${SAMPLES:-5}"
BATCHES="${BATCHES:-64 65536 1048576 8388608}"
WORKLOAD="${PROCESSING_IR_OFFLOAD_WORKLOAD:-alpha_u32_v1}"
EXPECTED_EVIDENCE_KIND=live

mkdir -p "$BUILD_DIR"

value_of() {
    key="$1"
    file="$2"
    grep "^$key=" "$file" 2>/dev/null | head -1 | cut -d= -f2- || true
}

is_positive() { printf '%s\n' "$1" | grep -Eq '^[1-9][0-9]*$'; }
is_nonnegative() { printf '%s\n' "$1" | grep -Eq '^[0-9]+$'; }

raw_median() {
    raw_file="$1"
    raw_batch="$2"
    raw_mode="$3"
    raw_column="$4"
    raw_samples="$5"
    awk -v batch="$raw_batch" -v mode="$raw_mode" -v column="$raw_column" \
        '$1 == batch && $2 == mode { print $column }' "$raw_file" |
        sort -n |
        awk -v target="$((raw_samples / 2 + 1))" 'NR == target { print; exit }'
}

raw_sample_ids_valid() {
    awk -v batch="$2" -v mode="$3" '$1 == batch && $2 == mode { print $3 }' "$1" |
        sort -n |
        awk -v expected="$4" '$1 != NR - 1 { exit 1 } END { if (NR != expected) exit 1 }'
}

write_unavailable() {
    reason="$1"
    {
        echo "processing_ir_offload_status=unavailable"
        echo "processing_ir_offload_reason=$reason"
        echo "processing_ir_offload_schema=processing-ir-offload-v1"
        echo "processing_ir_offload_execution=processing_ir"
        echo "processing_ir_offload_backend=cuda"
        echo "processing_ir_offload_evidence_kind=unavailable"
        echo "processing_ir_offload_raw_samples=$RAW_SAMPLES"
        echo "processing_ir_offload_provenance_env=$READBACK_DIR/evidence.env"
    } >"$EVIDENCE"
}

mark_failed() {
    reason="$1"
    tmp="$EVIDENCE.tmp"
    if [ ! -s "$EVIDENCE" ]; then
        {
            echo "processing_ir_offload_status=fail"
            echo "processing_ir_offload_reason=$reason"
            echo "processing_ir_offload_schema=processing-ir-offload-v1"
            echo "processing_ir_offload_execution=processing_ir"
            echo "processing_ir_offload_backend=cuda"
        } >"$EVIDENCE"
        return
    fi
    awk -F= -v reason="$reason" '
        /^processing_ir_offload_status=/ { print "processing_ir_offload_status=fail"; seen_status=1; next }
        /^processing_ir_offload_reason=/ { print "processing_ir_offload_reason=" reason; seen_reason=1; next }
        { print }
        END { if (!seen_status) print "processing_ir_offload_status=fail"; if (!seen_reason) print "processing_ir_offload_reason=" reason }
    ' "$EVIDENCE" >"$tmp"
    mv "$tmp" "$EVIDENCE"
}

validate_receipt() {
    [ -s "$EVIDENCE" ] || return 1
    [ "$(value_of processing_ir_offload_status "$EVIDENCE")" = "pass" ] || return 1
    for key in schema execution backend evidence_kind cpu_workload_id gpu_workload_id aggregate timing_unit rss_source warmup_samples measured_samples row_count cpu_rss_kb gpu_rss_kb peak_rss_kb communication_overhead_us break_even_batch raw_samples provenance_env ptx_path ptx_sha256 ptx_status ptx_artifact_validated ptx_source_hash_equal; do
        [ "$(grep -c "^processing_ir_offload_$key=" "$EVIDENCE" || true)" -eq 1 ] || return 1
    done
    [ "$(value_of processing_ir_offload_schema "$EVIDENCE")" = "processing-ir-offload-v1" ] || return 1
    [ "$(value_of processing_ir_offload_execution "$EVIDENCE")" = "processing_ir" ] || return 1
    [ "$(value_of processing_ir_offload_backend "$EVIDENCE")" = "cuda" ] || return 1
    [ "$(value_of processing_ir_offload_evidence_kind "$EVIDENCE")" = "$EXPECTED_EVIDENCE_KIND" ] || return 1
    cpu_workload="$(value_of processing_ir_offload_cpu_workload_id "$EVIDENCE")"
    gpu_workload="$(value_of processing_ir_offload_gpu_workload_id "$EVIDENCE")"
    [ -n "$cpu_workload" ] && [ "$cpu_workload" = "$gpu_workload" ] || return 1
    output_only=0
    case "$cpu_workload" in
        alpha_u32_v1) ;;
        fill_u32_v1)
            output_only=1
            [ "$(value_of processing_ir_offload_workload_kind "$EVIDENCE")" = "output_only" ] || return 1
            for key in break_even_found source_path source_sha256 artifact artifact_sha256 device_name device_uuid device_identity executor_timing coverage_max_batch provenance_manifest_path provenance_manifest_sha256 raw_samples_sha256; do
                [ "$(grep -c "^processing_ir_offload_$key=" "$EVIDENCE" || true)" -eq 1 ] || return 1
            done
            [ "$(value_of processing_ir_offload_executor_timing "$EVIDENCE")" = "allocation_us+launch_sync_us+readback_us+conversion_cleanup_us" ] || return 1
            [ -n "$(value_of processing_ir_offload_device_name "$EVIDENCE")" ] || return 1
            printf '%s\n' "$(value_of processing_ir_offload_device_uuid "$EVIDENCE")" | grep -Eq '^[0-9a-f]{32}$' || return 1
            is_positive "$(value_of processing_ir_offload_device_identity "$EVIDENCE")" || return 1
            for key in source_path artifact; do [ -s "$(value_of processing_ir_offload_$key "$EVIDENCE")" ] || return 1; done
            for key in source_sha256 artifact_sha256; do printf '%s\n' "$(value_of processing_ir_offload_$key "$EVIDENCE")" | grep -Eq '^[0-9a-f]{64}$' || return 1; done
            printf '%s\n' "$(value_of processing_ir_offload_raw_samples_sha256 "$EVIDENCE")" | grep -Eq '^[0-9a-f]{64}$' || return 1
            is_positive "$(value_of processing_ir_offload_coverage_max_batch "$EVIDENCE")" || return 1
            [ "$(value_of processing_ir_offload_coverage_max_batch "$EVIDENCE")" -ge 1048576 ] || return 1
            [ "$(sha256sum "$(value_of processing_ir_offload_source_path "$EVIDENCE")" | cut -d' ' -f1)" = "$(value_of processing_ir_offload_source_sha256 "$EVIDENCE")" ] || return 1
            [ "$(sha256sum "$(value_of processing_ir_offload_artifact "$EVIDENCE")" | cut -d' ' -f1)" = "$(value_of processing_ir_offload_artifact_sha256 "$EVIDENCE")" ] || return 1
            ;;
        *) return 1 ;;
    esac
    [ "$(value_of processing_ir_offload_aggregate "$EVIDENCE")" = "median" ] || return 1
    [ "$(value_of processing_ir_offload_timing_unit "$EVIDENCE")" = "us" ] || return 1
    [ "$(value_of processing_ir_offload_rss_source "$EVIDENCE")" = "procfs" ] || return 1
    warmups="$(value_of processing_ir_offload_warmup_samples "$EVIDENCE")"
    samples="$(value_of processing_ir_offload_measured_samples "$EVIDENCE")"
    rows="$(value_of processing_ir_offload_row_count "$EVIDENCE")"
    is_positive "$warmups" && [ "$warmups" -ge 3 ] || return 1
    is_positive "$samples" && [ "$samples" -ge 5 ] || return 1
    is_positive "$rows" || return 1
    if [ "$output_only" -eq 1 ]; then
        [ "$rows" -ge 3 ] || return 1
    else
        [ "$rows" -ge 4 ] || return 1
    fi
    [ "$warmups" -le 64 ] && [ "$samples" -le 64 ] && [ "$rows" -le 16 ] || return 1
    for key in cpu_rss_kb gpu_rss_kb peak_rss_kb; do is_positive "$(value_of processing_ir_offload_$key "$EVIDENCE")" || return 1; done
    communication="$(value_of processing_ir_offload_communication_overhead_us "$EVIDENCE")"
    is_nonnegative "$communication" || return 1
    raw_samples="$(value_of processing_ir_offload_raw_samples "$EVIDENCE")"
    provenance="$(value_of processing_ir_offload_provenance_env "$EVIDENCE")"
    ptx_path="$(value_of processing_ir_offload_ptx_path "$EVIDENCE")"
    [ -s "$raw_samples" ] || return 1
    [ -s "$provenance" ] || return 1
    [ -s "$ptx_path" ] || return 1
    [ "$(value_of processing_ir_offload_ptx_status "$EVIDENCE")" = "compiled_artifact_verified" ] || return 1
    [ "$(value_of processing_ir_offload_ptx_artifact_validated "$EVIDENCE")" = "true" ] || return 1
    [ "$(value_of processing_ir_offload_ptx_source_hash_equal "$EVIDENCE")" = "true" ] || return 1
    ptx_sha="$(value_of processing_ir_offload_ptx_sha256 "$EVIDENCE")"
    printf '%s\n' "$ptx_sha" | grep -Eq '^[0-9a-f]{64}$' || return 1
    command -v sha256sum >/dev/null 2>&1 || return 1
    [ "$(sha256sum "$ptx_path" | cut -d' ' -f1)" = "$ptx_sha" ] || return 1
    if [ "$output_only" -eq 1 ]; then
        [ "$(sha256sum "$raw_samples" | cut -d' ' -f1)" = "$(value_of processing_ir_offload_raw_samples_sha256 "$EVIDENCE")" ] || return 1
        [ "$(value_of processing_ir_offload_provenance_status "$provenance")" = "pass" ] || return 1
        for key in source_path source_sha256 artifact artifact_sha256 ptx_path ptx_sha256 raw_samples raw_samples_sha256 device_uuid device_identity coverage_max_batch; do
            [ "$(value_of processing_ir_offload_provenance_$key "$provenance")" = "$(value_of processing_ir_offload_$key "$EVIDENCE")" ] || return 1
        done
        manifest="$(value_of processing_ir_offload_provenance_manifest_path "$provenance")"
        manifest_sha="$(value_of processing_ir_offload_provenance_manifest_sha256 "$provenance")"
        [ -s "$manifest" ] || return 1
        printf '%s\n' "$manifest_sha" | grep -Eq '^[0-9a-f]{64}$' || return 1
        [ "$(sha256sum "$manifest" | cut -d' ' -f1)" = "$manifest_sha" ] || return 1
        [ "$(value_of processing_ir_offload_provenance_manifest_schema "$manifest")" = "processing-ir-offload-provenance-v1" ] || return 1
        for key in source_path source_sha256 artifact artifact_sha256 ptx_path ptx_sha256 raw_samples raw_samples_sha256 device_uuid device_identity coverage_max_batch; do
            [ "$(value_of processing_ir_offload_provenance_$key "$manifest")" = "$(value_of processing_ir_offload_provenance_$key "$provenance")" ] || return 1
        done
        awk -v expected="$((rows * samples))" '
            /^#/ { next }
            NF != 10 || $1 !~ /^[0-9]+$/ || $2 != "output_only" || $3 !~ /^[0-9]+$/ ||
            $4 !~ /^[0-9]+$/ || $5 !~ /^[0-9]+$/ || $6 !~ /^[0-9]+$/ || $7 !~ /^[0-9]+$/ ||
            $8 !~ /^[0-9]+$/ || $9 !~ /^[0-9]+$/ || $10 !~ /^[0-9]+$/ ||
            $4 < 1 || $5 < 1 || $6 < 1 || $7 < 1 || $8 < 1 || $9 != $5 + $6 + $7 + $8 || $10 != 0 { exit 1 }
            { count++ }
            END { if (count != expected) exit 1 }
        ' "$raw_samples" || return 1
    else
        [ "$(value_of cuda_generated_2d_readback_status "$provenance")" = "pass" ] || return 1
        [ "$(value_of cuda_generated_2d_readback_ptx_sha256_after "$provenance")" = "$ptx_sha" ] || return 1
        [ "$(value_of cuda_generated_2d_readback_ptx_artifact_validated "$provenance")" = "true" ] || return 1
        [ "$(value_of cuda_generated_2d_readback_ptx_source_hash_equal "$provenance")" = "true" ] || return 1
        awk -v expected="$((rows * samples))" '
            /^#/ { next }
            NF != 10 { exit 1 }
            $1 !~ /^[0-9]+$/ || ($2 != "batched" && $2 != "per_command") ||
            $3 !~ /^[0-9]+$/ || $4 !~ /^[0-9]+$/ || $5 !~ /^[0-9]+$/ ||
            $6 !~ /^[0-9]+$/ || $7 !~ /^[0-9]+$/ || $8 !~ /^[0-9]+$/ ||
            $9 !~ /^[0-9]+$/ || $10 !~ /^[0-9]+$/ ||
            $4 < 1 || $5 < 1 || $6 < 1 || $7 < 1 ||
            $8 != $5 + $7 || $9 != $5 + $6 + $7 || $10 != 0 { exit 1 }
            { count++ }
            END { if (count != expected) exit 1 }
        ' "$raw_samples" || return 1
    fi
    previous=0
    previous_mode=""
    first_fast=0
    first_fast_transfer=0
    largest_slow_batch=0
    saw_lower_slow=0
    first_transfer_bytes=0
    first_command_count=0
    varied_transfer_size=0
    varied_command_count=0
    saw_batched=0
    saw_per_command=0
    i=0
    while [ "$i" -lt "$rows" ]; do
        for field in batch workload_id cpu_us upload_us device_us readback_us transfer_us total_us upload_bytes readback_bytes command_count submission_mode readback_source readback_exact readback_mismatch_count decision; do
            [ "$(grep -c "^processing_ir_offload_row_${i}_${field}=" "$EVIDENCE" || true)" -eq 1 ] || return 1
        done
        if [ "$output_only" -eq 1 ]; then
            for field in executor_allocation_us executor_launch_sync_us executor_conversion_cleanup_us executor_total_us; do
                [ "$(grep -c "^processing_ir_offload_row_${i}_${field}=" "$EVIDENCE" || true)" -eq 1 ] || return 1
            done
        fi
        batch="$(value_of processing_ir_offload_row_${i}_batch "$EVIDENCE")"
        workload="$(value_of processing_ir_offload_row_${i}_workload_id "$EVIDENCE")"
        cpu="$(value_of processing_ir_offload_row_${i}_cpu_us "$EVIDENCE")"
        upload="$(value_of processing_ir_offload_row_${i}_upload_us "$EVIDENCE")"
        device="$(value_of processing_ir_offload_row_${i}_device_us "$EVIDENCE")"
        readback="$(value_of processing_ir_offload_row_${i}_readback_us "$EVIDENCE")"
        transfer="$(value_of processing_ir_offload_row_${i}_transfer_us "$EVIDENCE")"
        total="$(value_of processing_ir_offload_row_${i}_total_us "$EVIDENCE")"
        upload_bytes="$(value_of processing_ir_offload_row_${i}_upload_bytes "$EVIDENCE")"
        readback_bytes="$(value_of processing_ir_offload_row_${i}_readback_bytes "$EVIDENCE")"
        command_count="$(value_of processing_ir_offload_row_${i}_command_count "$EVIDENCE")"
        mode="$(value_of processing_ir_offload_row_${i}_submission_mode "$EVIDENCE")"
        readback_source="$(value_of processing_ir_offload_row_${i}_readback_source "$EVIDENCE")"
        readback_exact="$(value_of processing_ir_offload_row_${i}_readback_exact "$EVIDENCE")"
        mismatch_count="$(value_of processing_ir_offload_row_${i}_readback_mismatch_count "$EVIDENCE")"
        decision="$(value_of processing_ir_offload_row_${i}_decision "$EVIDENCE")"
        [ -n "$workload" ] && [ "$workload" = "$cpu_workload" ] || return 1
        is_positive "$batch" && is_positive "$cpu" && is_positive "$device" && is_positive "$readback" && is_positive "$transfer" && is_positive "$total" || return 1
        is_positive "$readback_bytes" && is_positive "$command_count" || return 1
        if [ "$output_only" -eq 1 ]; then
            [ "$upload" = 0 ] && [ "$upload_bytes" = 0 ] && [ "$mode" = "output_only" ] || return 1
            allocation="$(value_of processing_ir_offload_row_${i}_executor_allocation_us "$EVIDENCE")"
            launch="$(value_of processing_ir_offload_row_${i}_executor_launch_sync_us "$EVIDENCE")"
            cleanup="$(value_of processing_ir_offload_row_${i}_executor_conversion_cleanup_us "$EVIDENCE")"
            executor_total="$(value_of processing_ir_offload_row_${i}_executor_total_us "$EVIDENCE")"
            is_positive "$allocation" && is_positive "$launch" && is_positive "$cleanup" && [ "$executor_total" = "$total" ] || return 1
        else
            is_positive "$upload" && is_positive "$upload_bytes" || return 1
            [ "$mode" = "batched" ] || [ "$mode" = "per_command" ] || return 1
        fi
        [ "$readback_source" = "device_readback" ] || return 1
        [ "$readback_exact" = "true" ] || return 1
        [ "$mismatch_count" = "0" ] || return 1
        [ "$batch" -le 67108864 ] && [ "$cpu" -le 1000000000000 ] &&
            [ "$upload" -le 1000000000000 ] && [ "$device" -le 1000000000000 ] &&
            [ "$readback" -le 1000000000000 ] && [ "$total" -le 1000000000000 ] &&
            [ "$upload_bytes" -le 1000000000000 ] && [ "$readback_bytes" -le 1000000000000 ] &&
            [ "$command_count" -le 1000000 ] ||
            return 1
        if [ "$output_only" -eq 1 ]; then
            [ "$batch" -gt "$previous" ] || return 1
        elif [ "$mode" = "batched" ]; then
            [ "$batch" -gt "$previous" ] || return 1
        else
            [ "$previous_mode" = "batched" ] && [ "$batch" -eq "$previous" ] || return 1
        fi
        [ "$transfer" -eq $((upload + readback)) ] || return 1
        group_count="$(awk -v batch="$batch" -v mode="$mode" '$1 == batch && $2 == mode { count++ } END { print count + 0 }' "$raw_samples")"
        [ "$group_count" -eq "$samples" ] || return 1
        raw_sample_ids_valid "$raw_samples" "$batch" "$mode" "$samples" || return 1
        [ "$(raw_median "$raw_samples" "$batch" "$mode" 4 "$samples")" = "$cpu" ] || return 1
        if [ "$output_only" -eq 1 ]; then
            [ "$(raw_median "$raw_samples" "$batch" "$mode" 5 "$samples")" = "$allocation" ] || return 1
            [ "$(raw_median "$raw_samples" "$batch" "$mode" 6 "$samples")" = "$launch" ] || return 1
            [ "$(raw_median "$raw_samples" "$batch" "$mode" 7 "$samples")" = "$readback" ] || return 1
            [ "$(raw_median "$raw_samples" "$batch" "$mode" 8 "$samples")" = "$cleanup" ] || return 1
            [ "$(raw_median "$raw_samples" "$batch" "$mode" 9 "$samples")" = "$total" ] || return 1
            [ "$(raw_median "$raw_samples" "$batch" "$mode" 10 "$samples")" = "$mismatch_count" ] || return 1
        else
            [ "$(raw_median "$raw_samples" "$batch" "$mode" 5 "$samples")" = "$upload" ] || return 1
            [ "$(raw_median "$raw_samples" "$batch" "$mode" 6 "$samples")" = "$device" ] || return 1
            [ "$(raw_median "$raw_samples" "$batch" "$mode" 7 "$samples")" = "$readback" ] || return 1
            [ "$(raw_median "$raw_samples" "$batch" "$mode" 9 "$samples")" = "$total" ] || return 1
            [ "$(raw_median "$raw_samples" "$batch" "$mode" 10 "$samples")" = "$mismatch_count" ] || return 1
            if [ "$first_transfer_bytes" -eq 0 ]; then first_transfer_bytes=$((upload_bytes + readback_bytes)); elif [ "$first_transfer_bytes" -ne $((upload_bytes + readback_bytes)) ]; then varied_transfer_size=1; fi
            if [ "$first_command_count" -eq 0 ]; then first_command_count="$command_count"; elif [ "$first_command_count" -ne "$command_count" ]; then varied_command_count=1; fi
            if [ "$mode" = "batched" ]; then saw_batched=1; else saw_per_command=1; fi
        fi
        if [ "$total" -lt "$cpu" ]; then
            [ "$output_only" -eq 0 ] || return 1
            [ "$decision" = "gpu" ] || return 1
            if [ "$first_fast" -eq 0 ]; then
                first_fast="$batch"
                first_fast_transfer="$transfer"
                if [ "$largest_slow_batch" -gt 0 ] && [ "$largest_slow_batch" -lt "$batch" ]; then
                    saw_lower_slow=1
                fi
            fi
        else
            [ "$decision" = "cpu" ] || return 1
            [ "$batch" -gt "$largest_slow_batch" ] && largest_slow_batch="$batch"
        fi
        previous="$batch"
        previous_mode="$mode"
        i=$((i + 1))
    done
    if [ "$output_only" -eq 1 ]; then
        [ "$previous" = "$(value_of processing_ir_offload_coverage_max_batch "$EVIDENCE")" ] || return 1
        [ "$(value_of processing_ir_offload_break_even_found "$EVIDENCE")" = "false" ] || return 1
        [ "$(value_of processing_ir_offload_break_even_batch "$EVIDENCE")" = "0" ] || return 1
        [ "$communication" = 0 ] || return 1
    else
        [ "$first_fast" -gt 0 ] || return 1
        [ "$communication" = "$first_fast_transfer" ] || return 1
        [ "$saw_lower_slow" -eq 1 ] || return 1
        [ "$varied_transfer_size" -eq 1 ] || return 1
        [ "$varied_command_count" -eq 1 ] || return 1
        [ "$saw_batched" -eq 1 ] && [ "$saw_per_command" -eq 1 ] || return 1
        [ "$(value_of processing_ir_offload_break_even_batch "$EVIDENCE")" = "$first_fast" ] || return 1
    fi
    return 0
}

self_test() {
    self_dir="$BUILD_DIR/self-test"
    mkdir -p "$self_dir"
    old_evidence="$EVIDENCE"
    old_evidence_kind="$EXPECTED_EVIDENCE_KIND"
    EVIDENCE="$self_dir/evidence.env"
    EXPECTED_EVIDENCE_KIND=validator-self-test
    raw="$self_dir/raw.tsv"
    provenance="$self_dir/provenance.env"
    ptx="$self_dir/test.ptx"
    printf 'validator ptx\n' >"$ptx"
    ptx_hash="$(sha256sum "$ptx" | cut -d' ' -f1)"
    {
        echo "# batch mode sample cpu_us upload_us device_us readback_us transfer_us total_us mismatch_count"
        for descriptor in "1 batched 1 1 3 1" "1 per_command 1 1 3 2" "2 batched 10 2 2 2" "2 per_command 10 2 3 3"; do
            set -- $descriptor
            for sample in 0 1 2 3 4; do
                echo "$1 $2 $sample $3 $4 $5 $6 $(($4 + $6)) $(($4 + $5 + $6)) 0"
            done
        done
    } >"$raw"
    cat >"$provenance" <<EOF
cuda_generated_2d_readback_status=pass
cuda_generated_2d_readback_ptx_sha256_after=$ptx_hash
cuda_generated_2d_readback_ptx_artifact_validated=true
cuda_generated_2d_readback_ptx_source_hash_equal=true
EOF
    cat >"$EVIDENCE" <<EOF
processing_ir_offload_status=pass
processing_ir_offload_reason=self-test
processing_ir_offload_schema=processing-ir-offload-v1
processing_ir_offload_execution=processing_ir
processing_ir_offload_backend=cuda
processing_ir_offload_evidence_kind=validator-self-test
processing_ir_offload_cpu_workload_id=alpha_u32_v1
processing_ir_offload_gpu_workload_id=alpha_u32_v1
processing_ir_offload_aggregate=median
processing_ir_offload_timing_unit=us
processing_ir_offload_rss_source=procfs
processing_ir_offload_warmup_samples=3
processing_ir_offload_measured_samples=5
processing_ir_offload_row_count=4
processing_ir_offload_cpu_rss_kb=1
processing_ir_offload_gpu_rss_kb=1
processing_ir_offload_peak_rss_kb=1
processing_ir_offload_communication_overhead_us=4
processing_ir_offload_break_even_batch=2
processing_ir_offload_raw_samples=$raw
processing_ir_offload_provenance_env=$provenance
processing_ir_offload_ptx_path=$ptx
processing_ir_offload_ptx_sha256=$ptx_hash
processing_ir_offload_ptx_status=compiled_artifact_verified
processing_ir_offload_ptx_artifact_validated=true
processing_ir_offload_ptx_source_hash_equal=true
processing_ir_offload_row_0_batch=1
processing_ir_offload_row_0_workload_id=alpha_u32_v1
processing_ir_offload_row_0_cpu_us=1
processing_ir_offload_row_0_upload_us=1
processing_ir_offload_row_0_device_us=3
processing_ir_offload_row_0_readback_us=1
processing_ir_offload_row_0_transfer_us=2
processing_ir_offload_row_0_total_us=5
processing_ir_offload_row_0_upload_bytes=8
processing_ir_offload_row_0_readback_bytes=4
processing_ir_offload_row_0_command_count=1
processing_ir_offload_row_0_submission_mode=batched
processing_ir_offload_row_0_readback_source=device_readback
processing_ir_offload_row_0_readback_exact=true
processing_ir_offload_row_0_readback_mismatch_count=0
processing_ir_offload_row_0_decision=cpu
processing_ir_offload_row_1_batch=1
processing_ir_offload_row_1_workload_id=alpha_u32_v1
processing_ir_offload_row_1_cpu_us=1
processing_ir_offload_row_1_upload_us=1
processing_ir_offload_row_1_device_us=3
processing_ir_offload_row_1_readback_us=2
processing_ir_offload_row_1_transfer_us=3
processing_ir_offload_row_1_total_us=6
processing_ir_offload_row_1_upload_bytes=8
processing_ir_offload_row_1_readback_bytes=4
processing_ir_offload_row_1_command_count=4
processing_ir_offload_row_1_submission_mode=per_command
processing_ir_offload_row_1_readback_source=device_readback
processing_ir_offload_row_1_readback_exact=true
processing_ir_offload_row_1_readback_mismatch_count=0
processing_ir_offload_row_1_decision=cpu
processing_ir_offload_row_2_batch=2
processing_ir_offload_row_2_workload_id=alpha_u32_v1
processing_ir_offload_row_2_cpu_us=10
processing_ir_offload_row_2_upload_us=2
processing_ir_offload_row_2_device_us=2
processing_ir_offload_row_2_readback_us=2
processing_ir_offload_row_2_transfer_us=4
processing_ir_offload_row_2_total_us=6
processing_ir_offload_row_2_upload_bytes=16
processing_ir_offload_row_2_readback_bytes=8
processing_ir_offload_row_2_command_count=1
processing_ir_offload_row_2_submission_mode=batched
processing_ir_offload_row_2_readback_source=device_readback
processing_ir_offload_row_2_readback_exact=true
processing_ir_offload_row_2_readback_mismatch_count=0
processing_ir_offload_row_2_decision=gpu
processing_ir_offload_row_3_batch=2
processing_ir_offload_row_3_workload_id=alpha_u32_v1
processing_ir_offload_row_3_cpu_us=10
processing_ir_offload_row_3_upload_us=2
processing_ir_offload_row_3_device_us=3
processing_ir_offload_row_3_readback_us=3
processing_ir_offload_row_3_transfer_us=5
processing_ir_offload_row_3_total_us=8
processing_ir_offload_row_3_upload_bytes=16
processing_ir_offload_row_3_readback_bytes=8
processing_ir_offload_row_3_command_count=4
processing_ir_offload_row_3_submission_mode=per_command
processing_ir_offload_row_3_readback_source=device_readback
processing_ir_offload_row_3_readback_exact=true
processing_ir_offload_row_3_readback_mismatch_count=0
processing_ir_offload_row_3_decision=gpu
EOF
    validate_receipt || { EVIDENCE="$old_evidence"; EXPECTED_EVIDENCE_KIND="$old_evidence_kind"; return 1; }
    sed 's/^processing_ir_offload_row_1_transfer_us=.*/processing_ir_offload_row_1_transfer_us=2/' "$EVIDENCE" >"$EVIDENCE.bad"
    mv "$EVIDENCE.bad" "$EVIDENCE"
    if validate_receipt; then EVIDENCE="$old_evidence"; EXPECTED_EVIDENCE_KIND="$old_evidence_kind"; return 1; fi
    source="$self_dir/fill-source.c"
    artifact="$self_dir/fill-artifact"
    printf 'fill source\n' >"$source"
    printf 'fill artifact\n' >"$artifact"
    source_hash="$(sha256sum "$source" | cut -d' ' -f1)"
    artifact_hash="$(sha256sum "$artifact" | cut -d' ' -f1)"
    manifest="$self_dir/provenance.manifest"
    {
        echo "# batch mode sample cpu_us allocation_us launch_sync_us readback_us conversion_cleanup_us total_us mismatch_count"
        for descriptor in "4 1 1 1 1 1" "8 2 1 1 1 1" "1048576 3 1 1 1 1"; do
            set -- $descriptor
            for sample in 0 1 2 3 4; do
                echo "$1 output_only $sample $2 $3 $4 $5 $6 $(($3 + $4 + $5 + $6)) 0"
            done
        done
    } >"$raw"
    raw_hash="$(sha256sum "$raw" | cut -d' ' -f1)"
    {
        echo "processing_ir_offload_provenance_manifest_schema=processing-ir-offload-provenance-v1"
        echo "processing_ir_offload_provenance_source_path=$source"
        echo "processing_ir_offload_provenance_source_sha256=$source_hash"
        echo "processing_ir_offload_provenance_artifact=$artifact"
        echo "processing_ir_offload_provenance_artifact_sha256=$artifact_hash"
        echo "processing_ir_offload_provenance_ptx_path=$ptx"
        echo "processing_ir_offload_provenance_ptx_sha256=$ptx_hash"
        echo "processing_ir_offload_provenance_raw_samples=$raw"
        echo "processing_ir_offload_provenance_raw_samples_sha256=$raw_hash"
        echo "processing_ir_offload_provenance_device_uuid=0123456789abcdef0123456789abcdef"
        echo "processing_ir_offload_provenance_device_identity=1"
        echo "processing_ir_offload_provenance_coverage_max_batch=1048576"
    } >"$manifest"
    manifest_hash="$(sha256sum "$manifest" | cut -d' ' -f1)"
    cat >"$provenance" <<EOF
processing_ir_offload_provenance_status=pass
processing_ir_offload_provenance_manifest_path=$manifest
processing_ir_offload_provenance_manifest_sha256=$manifest_hash
processing_ir_offload_provenance_source_path=$source
processing_ir_offload_provenance_source_sha256=$source_hash
processing_ir_offload_provenance_artifact=$artifact
processing_ir_offload_provenance_artifact_sha256=$artifact_hash
processing_ir_offload_provenance_ptx_path=$ptx
processing_ir_offload_provenance_ptx_sha256=$ptx_hash
processing_ir_offload_provenance_raw_samples=$raw
processing_ir_offload_provenance_raw_samples_sha256=$raw_hash
processing_ir_offload_provenance_device_uuid=0123456789abcdef0123456789abcdef
processing_ir_offload_provenance_device_identity=1
processing_ir_offload_provenance_coverage_max_batch=1048576
EOF
    {
        echo "processing_ir_offload_status=pass"
        echo "processing_ir_offload_reason=self-test-output-only"
        echo "processing_ir_offload_schema=processing-ir-offload-v1"
        echo "processing_ir_offload_execution=processing_ir"
        echo "processing_ir_offload_backend=cuda"
        echo "processing_ir_offload_evidence_kind=validator-self-test"
        echo "processing_ir_offload_cpu_workload_id=fill_u32_v1"
        echo "processing_ir_offload_gpu_workload_id=fill_u32_v1"
        echo "processing_ir_offload_workload_kind=output_only"
        echo "processing_ir_offload_aggregate=median"
        echo "processing_ir_offload_timing_unit=us"
        echo "processing_ir_offload_rss_source=procfs"
        echo "processing_ir_offload_warmup_samples=3"
        echo "processing_ir_offload_measured_samples=5"
        echo "processing_ir_offload_row_count=3"
        echo "processing_ir_offload_cpu_rss_kb=1"
        echo "processing_ir_offload_gpu_rss_kb=1"
        echo "processing_ir_offload_peak_rss_kb=1"
        echo "processing_ir_offload_communication_overhead_us=0"
        echo "processing_ir_offload_break_even_found=false"
        echo "processing_ir_offload_break_even_batch=0"
        echo "processing_ir_offload_coverage_max_batch=1048576"
        echo "processing_ir_offload_raw_samples=$raw"
        echo "processing_ir_offload_raw_samples_sha256=$raw_hash"
        echo "processing_ir_offload_provenance_env=$provenance"
        echo "processing_ir_offload_provenance_manifest_path=$manifest"
        echo "processing_ir_offload_provenance_manifest_sha256=$manifest_hash"
        echo "processing_ir_offload_ptx_path=$ptx"
        echo "processing_ir_offload_ptx_sha256=$ptx_hash"
        echo "processing_ir_offload_ptx_status=compiled_artifact_verified"
        echo "processing_ir_offload_ptx_artifact_validated=true"
        echo "processing_ir_offload_ptx_source_hash_equal=true"
        echo "processing_ir_offload_source_path=$source"
        echo "processing_ir_offload_source_sha256=$source_hash"
        echo "processing_ir_offload_artifact=$artifact"
        echo "processing_ir_offload_artifact_sha256=$artifact_hash"
        echo "processing_ir_offload_device_name=synthetic-cuda"
        echo "processing_ir_offload_device_uuid=0123456789abcdef0123456789abcdef"
        echo "processing_ir_offload_device_identity=1"
        echo "processing_ir_offload_executor_timing=allocation_us+launch_sync_us+readback_us+conversion_cleanup_us"
        i=0
        for descriptor in "4 1" "8 2" "1048576 3"; do
            set -- $descriptor
            echo "processing_ir_offload_row_${i}_batch=$1"
            echo "processing_ir_offload_row_${i}_workload_id=fill_u32_v1"
            echo "processing_ir_offload_row_${i}_cpu_us=$2"
            echo "processing_ir_offload_row_${i}_upload_us=0"
            echo "processing_ir_offload_row_${i}_device_us=3"
            echo "processing_ir_offload_row_${i}_readback_us=1"
            echo "processing_ir_offload_row_${i}_transfer_us=1"
            echo "processing_ir_offload_row_${i}_total_us=4"
            echo "processing_ir_offload_row_${i}_upload_bytes=0"
            echo "processing_ir_offload_row_${i}_readback_bytes=$(($1 * 4))"
            echo "processing_ir_offload_row_${i}_command_count=1"
            echo "processing_ir_offload_row_${i}_submission_mode=output_only"
            echo "processing_ir_offload_row_${i}_readback_source=device_readback"
            echo "processing_ir_offload_row_${i}_readback_exact=true"
            echo "processing_ir_offload_row_${i}_readback_mismatch_count=0"
            echo "processing_ir_offload_row_${i}_executor_allocation_us=1"
            echo "processing_ir_offload_row_${i}_executor_launch_sync_us=1"
            echo "processing_ir_offload_row_${i}_executor_conversion_cleanup_us=1"
            echo "processing_ir_offload_row_${i}_executor_total_us=4"
            echo "processing_ir_offload_row_${i}_decision=cpu"
            i=$((i + 1))
        done
    } >"$EVIDENCE"
    validate_receipt || { EVIDENCE="$old_evidence"; EXPECTED_EVIDENCE_KIND="$old_evidence_kind"; return 1; }
    cp "$manifest" "$manifest.good"
    printf 'tampered=true\n' >>"$manifest"
    if validate_receipt; then EVIDENCE="$old_evidence"; EXPECTED_EVIDENCE_KIND="$old_evidence_kind"; return 1; fi
    mv "$manifest.good" "$manifest"
    sed 's/^processing_ir_offload_row_0_decision=.*/processing_ir_offload_row_0_decision=gpu/' "$EVIDENCE" >"$EVIDENCE.bad"
    mv "$EVIDENCE.bad" "$EVIDENCE"
    if validate_receipt; then EVIDENCE="$old_evidence"; EXPECTED_EVIDENCE_KIND="$old_evidence_kind"; return 1; fi
    sed 's/^processing_ir_offload_row_0_decision=.*/processing_ir_offload_row_0_decision=cpu/' "$EVIDENCE" >"$EVIDENCE.bad"
    mv "$EVIDENCE.bad" "$EVIDENCE"
    sed 's/^processing_ir_offload_row_0_upload_us=.*/processing_ir_offload_row_0_upload_us=1/' "$EVIDENCE" >"$EVIDENCE.bad"
    mv "$EVIDENCE.bad" "$EVIDENCE"
    if validate_receipt; then EVIDENCE="$old_evidence"; EXPECTED_EVIDENCE_KIND="$old_evidence_kind"; return 1; fi
    EVIDENCE="$old_evidence"
    EXPECTED_EVIDENCE_KIND="$old_evidence_kind"
    echo "processing_ir_offload_self_test=pass"
}

if [ "${1:-}" = "--self-test" ]; then
    self_test
    exit 0
fi
if [ "${1:-}" = "--validate" ]; then
    [ "$#" -eq 2 ] || exit 2
    EVIDENCE="$2"
    EXPECTED_EVIDENCE_KIND=live
    validate_receipt
    echo "processing_ir_offload_validation=pass"
    exit 0
fi

rm -f "$EVIDENCE" "$RAW_SAMPLES" "$BUILD_DIR"/harness.out "$BUILD_DIR"/harness.err
if [ "$WORKLOAD" = "fill_u32_v1" ]; then
    if ! BUILD_DIR="$BUILD_DIR/fill_u32" WARMUPS="$WARMUPS" SAMPLES="$SAMPLES" BATCHES="$BATCHES" CC_TOOL="$CC_TOOL" \
        sh "$FILL_CHECKER" "$EVIDENCE" >"$BUILD_DIR/harness.out" 2>"$BUILD_DIR/harness.err"; then
        mark_failed "cuda-fill-u32-harness-run-failed"
    elif ! validate_receipt; then
        mark_failed "receipt-validation-failed"
    fi
elif [ "$WORKLOAD" != "alpha_u32_v1" ]; then
    write_unavailable "unsupported-processing-ir-workload"
elif ! command -v "$CC_TOOL" >/dev/null 2>&1; then
    write_unavailable "missing-c-compiler"
elif ! BUILD_DIR="$READBACK_DIR" REPORT_PATH="$READBACK_DIR/report.md" \
    sh scripts/check/check-cuda-generated-2d-readback.shs >"$BUILD_DIR/provenance.out" 2>"$BUILD_DIR/provenance.err"; then
    write_unavailable "current-emitter-cuda-provenance-or-device-failed"
elif [ "$(value_of cuda_generated_2d_readback_status "$READBACK_DIR/evidence.env")" != "pass" ] ||
     [ "$(value_of cuda_generated_2d_readback_ptx_status "$READBACK_DIR/evidence.env")" != "compiled_artifact_verified" ] ||
     [ "$(value_of cuda_generated_2d_readback_ptx_artifact_validated "$READBACK_DIR/evidence.env")" != "true" ] ||
     [ "$(value_of cuda_generated_2d_readback_ptx_source_hash_equal "$READBACK_DIR/evidence.env")" != "true" ]; then
    write_unavailable "current-emitter-cuda-provenance-invalid"
elif ! "$CC_TOOL" -O2 -std=c99 -Wall -Wextra -Werror "$HARNESS_SOURCE" -lcuda -o "$HARNESS" >"$BUILD_DIR/cc.out" 2>"$BUILD_DIR/cc.err"; then
    write_unavailable "cuda-harness-compile-failed"
else
    ptx="$(value_of cuda_generated_2d_readback_ptx_path "$READBACK_DIR/evidence.env")"
    if ! "$HARNESS" "$ptx" "$WARMUPS" "$SAMPLES" "$RAW_SAMPLES" $BATCHES >"$EVIDENCE" 2>"$BUILD_DIR/harness.err"; then
        if [ "$(value_of processing_ir_offload_status "$EVIDENCE")" != "fail" ]; then
            mark_failed "cuda-harness-run-failed"
        fi
    fi
    {
        echo "processing_ir_offload_raw_samples=$RAW_SAMPLES"
        echo "processing_ir_offload_provenance_env=$READBACK_DIR/evidence.env"
        echo "processing_ir_offload_ptx_path=$ptx"
        echo "processing_ir_offload_ptx_sha256=$(value_of cuda_generated_2d_readback_ptx_sha256_after "$READBACK_DIR/evidence.env")"
        echo "processing_ir_offload_ptx_status=$(value_of cuda_generated_2d_readback_ptx_status "$READBACK_DIR/evidence.env")"
        echo "processing_ir_offload_ptx_artifact_validated=$(value_of cuda_generated_2d_readback_ptx_artifact_validated "$READBACK_DIR/evidence.env")"
        echo "processing_ir_offload_ptx_source_hash_equal=$(value_of cuda_generated_2d_readback_ptx_source_hash_equal "$READBACK_DIR/evidence.env")"
    } >>"$EVIDENCE"
    if [ "$(value_of processing_ir_offload_status "$EVIDENCE")" = "pass" ] &&
       ! validate_receipt; then
        mark_failed "receipt-validation-failed"
    fi
fi

cat "$EVIDENCE"
[ "$(value_of processing_ir_offload_status "$EVIDENCE")" = "pass" ]
