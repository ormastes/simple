#!/bin/sh
# check-link-corpus-baseline.shs — lane A5 (linker corpus + relocation census).
#
# Two independent things, selected by mode flag:
#
#   --census <dir-or-.o-file>...
#       For each .o found (a directory is scanned non-recursively for *.o;
#       bare arguments are taken as file paths), run `llvm-readelf -r`
#       (falling back to `readelf -r` if llvm-readelf is absent; ERROR if
#       NEITHER tool exists — absence of a reader is absence of evidence, not
#       a clean scan). Every relocation type name found (the `R_<ARCH>_*`
#       token in readelf's "Type" column) is counted and grouped by its ARCH
#       prefix (the token between the first and second underscore, e.g.
#       AARCH64, X86_64, RISCV, ARM), regardless of which producer emitted the
#       object — the caller names the producer via the file/dir path, this
#       script only reads what is actually in the bytes.
#
#   --recipes <DIR>
#       Every *.sdn file directly under DIR must declare, each on its own
#       line inside a `corpus:` block, all five required keys: inputs,
#       linker_script, target_triple, expected_outcome, status. A file
#       missing any of them is a named offender.
#
#   --selftest
#       Runs unconditionally and fatally before every --census/--recipes scan
#       (not just when passed explicitly) — see the dispatch section at the
#       bottom, which invokes it before entering either mode regardless of
#       which flags were given. Its fixtures call do_census/do_recipes
#       directly as in-script functions inside `( ... )` subshells (never a
#       nested `sh "$0"` re-exec), so there is no recursion to guard against
#       and no environment variable that a caller could set to bypass it.
#       Exercises: 0 objects -> ERROR; a real relocatable object (built with
#       the C compiler already required elsewhere in this repo's toolchain)
#       is censused correctly and finds at least one real relocation type; a
#       garbage non-object file must NOT pass (reader fails on it -> ERROR);
#       a clean recipe dir passes; a recipe missing one required key fails,
#       naming it and the key.
#
# Verdict is the last line of stdout:
#   PASS — <n> ... checked, ...                exit 0
#   FAIL — <n> ... checked, ...                 exit 1
#   ERROR — nothing was checked (<reason>)      exit 2
set -u

SELF=check-link-corpus-baseline

REQUIRED_KEYS="inputs linker_script target_triple expected_outcome status"

die_error() {
    # $* = reason
    echo "$SELF: ERROR — nothing was checked ($*)"
    exit 2
}

find_reader() {
    # Prints the reader command to stdout, or nothing if neither exists.
    if command -v llvm-readelf >/dev/null 2>&1; then
        echo "llvm-readelf"
    elif command -v readelf >/dev/null 2>&1; then
        echo "readelf"
    fi
}

# --- census -----------------------------------------------------------------
# Resolve dirs/files given on the command line to a flat list of .o files.
# Prints one path per line; does not touch the reader at all.
resolve_object_files() {
    for arg in "$@"; do
        if [ -d "$arg" ]; then
            for f in "$arg"/*.o; do
                [ -e "$f" ] && printf '%s\n' "$f"
            done
        elif [ -f "$arg" ]; then
            printf '%s\n' "$arg"
        fi
    done
}

# $1 = reader command name. $2 = one object file path. $3 = scratch file to
# receive the reader's raw stdout (caller-owned; not cleaned up here).
# Returns the READER's own exit status — 0 only if the reader itself
# considered the file a valid object, whatever it printed. A non-zero return
# means the file could not be read as an object at all (garbage, truncated,
# wrong format) and the caller must treat it as an offender, never as "0
# relocations found".
census_one() {
    reader=$1
    file=$2
    outfile=$3
    "$reader" -r "$file" >"$outfile" 2>/dev/null
    return $?
}

# Prints one "ARCH TYPE" pair per relocation entry found in $1 (a file holding
# a reader's raw stdout), unsorted. Prints nothing if the object legitimately
# carries no relocations.
extract_relocs() {
    awk '
        /^[0-9a-fA-F]+  +[0-9a-fA-F]+ +R_/ {
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^R_[A-Za-z0-9]+_/) {
                    tok = $i
                    rest = tok
                    sub(/^R_/, "", rest)
                    n = index(rest, "_")
                    if (n > 0) {
                        arch = substr(rest, 1, n - 1)
                        print arch, tok
                    }
                    break
                }
            }
        }
    ' "$1"
}

do_census() {
    shift_count=$#
    [ "$shift_count" -gt 0 ] || die_error "--census needs at least one file or directory"
    reader=$(find_reader)
    [ -n "$reader" ] || die_error "neither llvm-readelf nor readelf is on PATH"
    objects=$(resolve_object_files "$@")
    n=0
    [ -n "$objects" ] && n=$(printf '%s\n' "$objects" | grep -c .)
    if [ "$n" -eq 0 ]; then
        die_error "0 relocatable object(s) found under: $*"
    fi

    census_tmp=$(mktemp -d) || die_error "mktemp failed"
    ok_count=0
    fail_count=0
    failed_files=""
    lines=""
    idx=0
    IFS='
'
    for f in $objects; do
        idx=$((idx + 1))
        one_out="$census_tmp/$idx.out"
        if census_one "$reader" "$f" "$one_out"; then
            ok_count=$((ok_count + 1))
            one=$(extract_relocs "$one_out")
            [ -n "$one" ] && lines="$lines
$one"
        else
            fail_count=$((fail_count + 1))
            failed_files="$failed_files $f"
        fi
    done
    unset IFS
    rm -rf "$census_tmp"
    lines=$(printf '%s\n' "$lines" | sed '/^$/d')

    # A reader failure on EVERY input means no evidence was ever produced —
    # that is ERROR, not FAIL: there is nothing to report a verdict about.
    if [ "$ok_count" -eq 0 ]; then
        die_error "$reader could not read any of $n object(s) as valid objects (not ELF / truncated / wrong format):$failed_files"
    fi
    # Zero relocation RECORDS across every successfully-read object is never a
    # clean pass — either every object genuinely carries none (unusual enough
    # for a census to be worth re-checking, not rubber-stamping) or the reader
    # silently produced no usable output. Either way: ERROR, never PASS.
    if [ -z "$lines" ]; then
        die_error "$ok_count object(s) read via $reader but 0 relocation record(s) were found across any of them"
    fi

    table=$(printf '%s\n' "$lines" | awk '{ key = $1 "|" $2; count[key]++ } END { for (k in count) { split(k, parts, "|"); print parts[1], parts[2], count[k] } }' \
        | sort | awk '
            {
                if ($1 != prev) { if (prev != "") print ""; print $1 ":"; prev = $1 }
                printf "  %s=%s\n", $2, $3
            }')
    printf '%s\n' "$table"
    ntypes=$(printf '%s\n' "$lines" | awk '{print $1"|"$2}' | sort -u | wc -l)
    narches=$(printf '%s\n' "$lines" | awk '{print $1}' | sort -u | wc -l)

    if [ "$fail_count" -gt 0 ]; then
        echo "FAIL — $n object(s) checked via $reader, $fail_count unreadable offender(s) (not counted in the $ntypes relocation type(s) found across $narches arch(es)):$failed_files"
        exit 1
    fi
    echo "PASS — $n object(s) checked via $reader, $ntypes distinct relocation type(s) across $narches arch(es)"
    exit 0
}

# --- recipes ------------------------------------------------------------------
recipe_missing_keys() {
    # $1 = file. Prints missing key names (one per line), nothing if complete.
    f=$1
    for key in $REQUIRED_KEYS; do
        grep -qE "^ +${key}:" "$f" || echo "$key"
    done
}

do_recipes() {
    dir=$1
    [ -d "$dir" ] || die_error "recipes directory '$dir' does not exist"
    files=$(find "$dir" -maxdepth 1 -name '*.sdn' 2>/dev/null | sort)
    [ -n "$files" ] || die_error "0 .sdn recipe file(s) under '$dir'"
    nfiles=0
    offenders=""
    for f in $files; do
        nfiles=$((nfiles + 1))
        missing=$(recipe_missing_keys "$f")
        if [ -n "$missing" ]; then
            names=$(printf '%s' "$missing" | tr '\n' ',' | sed 's/,$//')
            offenders="$offenders $f(missing:$names)"
        fi
    done
    if [ -n "$offenders" ]; then
        echo "FAIL — $nfiles recipe(s) checked, offender(s):$offenders"
        exit 1
    fi
    echo "PASS — $nfiles recipe(s) checked, all required keys present ($REQUIRED_KEYS)"
    exit 0
}

# --- selftest -----------------------------------------------------------------
run_selftest() {
    td=$(mktemp -d) || die_error "mktemp failed"
    trap 'rm -rf "$td"' EXIT

    # Fixtures below call do_census/do_recipes directly, each inside its own
    # `( ... )` subshell: the subshell isolates their `exit` calls (an exit
    # inside `( ... )` only ends the subshell, captured here as $rc) and their
    # variable mutations, exactly like a nested process would, but with no
    # re-exec and therefore nothing to bypass via the environment.

    # 1. 0 objects -> ERROR
    mkdir -p "$td/empty"
    out=$( do_census "$td/empty" 2>&1 ); rc=$?
    case "$out" in
        *"ERROR"*) : ;;
        *) echo "SELFTEST FAIL: empty dir census did not ERROR: $out"; exit 2 ;;
    esac
    [ "$rc" -eq 2 ] || { echo "SELFTEST FAIL: empty dir census exit=$rc, want 2"; exit 2; }

    # 2. a real relocatable object, built with whatever C compiler this repo
    #    already requires elsewhere (clang/cc/gcc; the C-runtime push gate
    #    already assumes one exists, see .claude/rules/vcs.md).
    cc_bin=""
    for c in cc clang gcc; do
        command -v "$c" >/dev/null 2>&1 && { cc_bin=$c; break; }
    done
    [ -n "$cc_bin" ] || die_error "selftest needs a C compiler (cc/clang/gcc) and none is on PATH"
    cat > "$td/probe.c" <<'EOF'
extern int helper(int x);
int global_counter = 0;
int helper(int x) { global_counter += x; return global_counter; }
int main(void) { return helper(1); }
EOF
    "$cc_bin" -c -O0 -fPIC "$td/probe.c" -o "$td/probe.o" 2>/dev/null \
        || die_error "selftest: $cc_bin failed to build the fixture object"
    out=$( do_census "$td/probe.o" 2>&1 ); rc=$?
    case "$out" in
        *"PASS"*) : ;;
        *) echo "SELFTEST FAIL: real object census did not PASS: $out"; exit 2 ;;
    esac
    [ "$rc" -eq 0 ] || { echo "SELFTEST FAIL: real object census exit=$rc, want 0"; exit 2; }
    case "$out" in
        *"R_"*) : ;;
        *) echo "SELFTEST FAIL: real object census PASSed but found no R_* relocation type: $out"; exit 2 ;;
    esac

    # 2b. a garbage non-object file must NEVER pass: the reader fails on it
    #     outright, so this must ERROR (every input failed), not PASS with 0
    #     relocations found.
    printf 'this is not an object file\n' > "$td/junk.o"
    out=$( do_census "$td/junk.o" 2>&1 ); rc=$?
    case "$out" in
        *"PASS"*) echo "SELFTEST FAIL: garbage .o census incorrectly PASSed: $out"; exit 2 ;;
        *"ERROR"*) : ;;
        *) echo "SELFTEST FAIL: garbage .o census gave neither PASS nor ERROR: $out"; exit 2 ;;
    esac
    [ "$rc" -eq 2 ] || { echo "SELFTEST FAIL: garbage .o census exit=$rc, want 2"; exit 2; }

    # 3. recipes: clean dir passes
    mkdir -p "$td/recipes_ok"
    cat > "$td/recipes_ok/a.sdn" <<'EOF'
corpus:
  name: "a"
  inputs: "cmd"
  linker_script: "none"
  target_triple: "x86_64-unknown-linux-gnu"
  expected_outcome: "links"
  status: "runnable-here"
EOF
    out=$( do_recipes "$td/recipes_ok" 2>&1 ); rc=$?
    case "$out" in
        *"PASS"*) : ;;
        *) echo "SELFTEST FAIL: clean recipe dir did not PASS: $out"; exit 2 ;;
    esac
    [ "$rc" -eq 0 ] || { echo "SELFTEST FAIL: clean recipe dir exit=$rc, want 0"; exit 2; }

    # 4. recipes: a file missing 'status' fails, naming it
    mkdir -p "$td/recipes_bad"
    cat > "$td/recipes_bad/b.sdn" <<'EOF'
corpus:
  name: "b"
  inputs: "cmd"
  linker_script: "none"
  target_triple: "x86_64-unknown-linux-gnu"
  expected_outcome: "links"
EOF
    out=$( do_recipes "$td/recipes_bad" 2>&1 ); rc=$?
    case "$out" in
        *"FAIL"*"status"*) : ;;
        *) echo "SELFTEST FAIL: missing-key recipe did not FAIL naming 'status': $out"; exit 2 ;;
    esac
    [ "$rc" -eq 1 ] || { echo "SELFTEST FAIL: missing-key recipe exit=$rc, want 1"; exit 2; }

    rm -rf "$td"
    trap - EXIT
    echo "SELFTEST PASS — 5 fixture(s) checked"
}

# --- dispatch -----------------------------------------------------------------
# --selftest is tracked but NOT trusted to be the whole story: census and
# recipes modes below run the selftest unconditionally regardless of whether
# --selftest was actually passed, so `--selftest --recipes DIR` cannot ever
# silently skip it again by one flag clobbering mode's tracking of the other.
mode=""
args=""
for a in "$@"; do
    case "$a" in
        --selftest) [ -z "$mode" ] && mode=selftest ;;
        --census) mode=census ;;
        --recipes) mode=recipes ;;
        *) args="$args $a" ;;
    esac
done

# No environment variable gates this: run_selftest's own fixtures call
# do_census/do_recipes as in-script functions inside subshells, never a
# nested re-exec of this script, so there is nothing for a caller to bypass
# and this unconditionally runs on every real census/recipes invocation.
case "$mode" in
    census|recipes)
        run_selftest
        rc=$?
        [ "$rc" -eq 0 ] || exit 2
        ;;
esac

case "$mode" in
    census)
        # shellcheck disable=SC2086
        set -- $args
        [ "$#" -gt 0 ] || die_error "--census needs at least one file or directory"
        do_census "$@"
        ;;
    recipes)
        # shellcheck disable=SC2086
        set -- $args
        [ "$#" -eq 1 ] || die_error "--recipes needs exactly one directory argument"
        do_recipes "$1"
        ;;
    selftest)
        run_selftest
        rc=$?
        [ "$rc" -eq 0 ] || exit 2
        exit 0
        ;;
    "")
        die_error "no mode given; use --selftest, --census <dir|.o...>, or --recipes <dir>"
        ;;
esac
