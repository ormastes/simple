#!/bin/sh
# check-spec-missing-path-vacuity.shs
#
# VACUITY SHAPE: a spec asserts against a product file that DOES NOT EXIST.
#
# A spec that reads a missing path gets empty content back. Any NEGATIVE leg
# --- to_equal(false), a negated to_contain, an absence check --- then passes
# VACUOUSLY. This overturns the previously-assumed rule that "negative /
# absence assertions cannot be vacuous". They can, and seven confirmed sites
# were found by hand before this scanner existed (Q24, e46ebc94f10..5de52d5ae0c).
#
# WHAT IT DOES
#   For every *_spec.spl under test/, extract literal paths consumed by file-read/existence APIs
#   (directly or through literal val/var bindings), and report the ones that do not exist in
#   the committed tree (git ls-files) nor on disk.
#
# NON-VACUITY / FAIL-CLOSED CONTRACT
#   * --selftest runs BEFORE every scan and is FATAL. It plants a fixture spec
#     naming a path that cannot exist and requires the scanner to flag it, then
#     removes the fixture defect and requires the scanner to fall silent. A
#     scanner that flags nothing in the positive case, or flags the negative
#     case, aborts with ERROR exit 2 --- it cannot be used to certify anything.
#   * A run that examines ZERO specs is an ERROR (exit 2), never a pass.
#   * The verdict line is ALWAYS the last line of stdout:
#       PASS  -- <n> specs checked, 0 missing-path references   exit 0
#       FAIL  -- <n> specs checked, <m> missing-path references exit 1
#       ERROR -- nothing was checked                            exit 2
#
# EXTRACTION RULES (hand-verified against a sample; see the header note in
# doc/08_tracking/ for the audit)
#   * Comments (including trailing comments), docstrings, content assertions,
#     and categorizer/example strings are not file-read subjects.
#   * Direct literal arguments and literal val/var bindings consumed by the
#     named file APIs are inspected; dynamic/alias/interprocedural paths are
#     outside this lexical detector. A clean scan is not proof of those paths.
#   * Only literals with a '/' and a known repo root prefix are considered:
#     src/ scripts/ test/ tools/ examples/ config/ bin/ doc/ .spipe/
#   * Literals containing interpolation ({...}), globs (*?[]), or a trailing
#     path separator are skipped --- they are not single concrete paths.
#   * A path is considered PRESENT if git ls-files matches it exactly, or if it
#     is a tracked DIRECTORY prefix, or if it exists on disk (build outputs).
#
# Usage:
#   sh scripts/check/check-spec-missing-path-vacuity.shs [--selftest-only] [ROOT...]

set -u

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "ERROR -- nothing was checked"
  exit 2
}
cd "$REPO" || { echo "ERROR -- nothing was checked"; exit 2; }

WORK=$(mktemp -d) || { echo "ERROR -- nothing was checked"; exit 2; }
trap 'rm -rf "$WORK"' EXIT INT TERM

TRACKED="$WORK/tracked.txt"
git ls-files > "$TRACKED" 2>/dev/null
if [ ! -s "$TRACKED" ]; then
  echo "ERROR -- nothing was checked"
  exit 2
fi
# Directory prefixes of every tracked file, so a spec naming a directory counts.
awk '{ n = split($0, seg, "/"); acc = seg[1]; for (i = 2; i < n; i++) { print acc; acc = acc "/" seg[i] } if (n > 1) print acc }' "$TRACKED" \
  | sort -u > "$WORK/dirs.txt"
sort -u "$TRACKED" "$WORK/dirs.txt" > "$WORK/known.txt"

# extract_paths <specfile> -> stdout: one candidate path per line
extract_paths() {
  awk '
    BEGIN { scope_stack[0] = 0; indents[0] = 0; scope = 0 }
    function token(kind, value) { count++; kinds[count] = kind; values[count] = value; scopes[count] = scope }
    function path(value) {
      if (value !~ /\// || value ~ /[{}*?\[\]\\]/ || value ~ /\/$/) return
      if (value ~ /^(src|scripts|test|tools|examples|config|bin|doc)\// || value ~ /^\.spipe\//)
        print value
    }
    function reader(value) {
      return value ~ /(^|\.)(read_file|read_text|read_bytes|file_read|file_read_text|file_read_bytes|rt_file_read_text|rt_file_read_bytes|file_exists|rt_file_exists)$/
    }
    {
      if (!doc && !literal && $0 !~ /^[ \t]*(#|$)/) {
        match($0, /^[ \t]*/); indent = RLENGTH
        while (depth > 0 && indent < indents[depth]) depth--
        if (indent > indents[depth]) {
          parent[++scope_count] = scope_stack[depth]
          depth++; indents[depth] = indent; scope_stack[depth] = scope_count
        }
        scope = scope_stack[depth]
      }
      # Tokenize before interpreting calls: quotes inside comments/docstrings
      # and escaped quotes inside literals must not invent read operations.
      for (pos = 1; pos <= length($0); pos++) {
        ch = substr($0, pos, 1)
        if (doc) {
          if (substr($0, pos, 3) == "\"\"\"") { doc = 0; pos += 2 }
          continue
        }
        if (literal) {
          if (escaped) { text = text "\\" ch; escaped = 0; continue }
          if (ch == "\\") { escaped = 1; continue }
          if (ch == "\"") { token("string", text); literal = 0; text = "" }
          else text = text ch
          continue
        }
        if (ch == "#") break
        if (substr($0, pos, 3) == "\"\"\"") { doc = 1; pos += 2; continue }
        if (ch == "\"") { literal = 1; text = ""; continue }
        if (ch ~ /[A-Za-z_]/) {
          name = ch
          while (substr($0, pos + 1, 1) ~ /[A-Za-z0-9_.]/) {
            pos++; name = name substr($0, pos, 1)
          }
          token("name", name)
        } else if (ch !~ /[ \t\r]/) token(ch, ch)
      }
      token("newline", "")
    }
    END {
      # Resolve literal bindings in their lexical indentation scope. A path
      # used only as an example in a sibling scenario must not leak into a
      # read of a same-named variable in another scenario.
      for (i = 1; i <= count; i++) {
        if (kinds[i] == "name" && (values[i] == "val" || values[i] == "var")) {
          binding = values[i + 1]
          j = i + 2
          while (j <= count && kinds[j] != "=" && kinds[j] != "newline") j++
          if (kinds[j] == "=") {
            bound[scopes[i], binding] = ""
            if (kinds[j + 1] == "string" && kinds[j + 2] == "newline")
              bound[scopes[i], binding] = values[j + 1]
          }
        }
        if (kinds[i] != "name" || !reader(values[i]) || kinds[i + 1] != "(") continue
        j = i + 2
        while (kinds[j] == "newline") j++
        endarg = j + 1
        while (kinds[endarg] == "newline") endarg++
        if (kinds[endarg] != ")" && kinds[endarg] != ",") continue
        if (kinds[j] == "string") path(values[j])
        else if (kinds[j] == "name") {
          lookup = scopes[i]
          while (!((lookup, values[j]) in bound) && lookup + 0 != 0) lookup = parent[lookup]
          path(bound[lookup, values[j]])
        }
      }
    }
  ' "$1"
}

scan() {
  # $1 = file listing specs to scan; writes hits to $2; echoes "<specs> <hits>"
  _list="$1"; _out="$2"
  : > "$_out"
  _cand="$_out.cand"
  : > "$_cand"
  _nspecs=0
  while IFS= read -r spec; do
    [ -f "$spec" ] || continue
    _nspecs=$((_nspecs + 1))
    extract_paths "$spec" | sort -u | while IFS= read -r p; do
      [ -n "$p" ] || continue
      printf '%s\t%s\n' "$p" "$spec" >> "$_cand"
    done
  done < "$_list"
  # Batch existence check: one pass over the known-path set, not one grep per
  # candidate (a per-candidate grep over 110k tracked paths does not terminate).
  if [ -s "$_cand" ]; then
    sort -u "$_cand" > "$_cand.s"
    awk -F'\t' 'NR==FNR { known[$0]=1; next } { if (!($1 in known)) print $2 "\t" $1 }' \
      "$WORK/known.txt" "$_cand.s" > "$_cand.missing"
    # second gate: present on disk but untracked (build outputs) is NOT a miss
    while IFS="$(printf '\t')" read -r sp pp; do
      [ -n "$pp" ] || continue
      [ -e "$pp" ] && continue
      printf '%s\t%s\n' "$sp" "$pp" >> "$_out"
    done < "$_cand.missing"
  fi
  echo "$_nspecs"
}

# ---------------------------------------------------------------------------
# SELFTEST (fatal, runs before every scan)
# ---------------------------------------------------------------------------
selftest() {
  st="$WORK/st"; mkdir -p "$st"
  # POSITIVE control: a spec naming a path that cannot exist -> MUST be flagged.
  cat > "$st/pos_spec.spl" <<'EOF'
describe "positive control":
    it "reads a nonexistent product file":
        val c = read_file("src/compiler/__q28_selftest_absent__/nope.spl")
        expect(c.contains("anything")).to_equal(false)
EOF
  # NEGATIVE control: same spec shape, but the path exists -> MUST NOT be flagged.
  cat > "$st/neg_spec.spl" <<'EOF'
describe "negative control":
    it "reads a real product file":
        val c = read_file("scripts/check/check-spec-missing-path-vacuity.shs")
        expect(c.contains("anything")).to_equal(false)
EOF
  # CONTROL 3: the needle appears only inside a spec COMMENT -> MUST NOT be flagged.
  cat > "$st/cmt_spec.spl" <<'EOF'
# see src/compiler/__q28_selftest_absent__/nope.spl for background
describe "comment control":
    it "asserts nothing about a path":
        expect(1).to_equal(1)
EOF
  # Read positions stay visible across newlines and through literal bindings.
  cat > "$st/bound_spec.spl" <<'EOF'
val SUBJECT: text = "src/compiler/__q28_selftest_absent__/bound.spl"
val source = read_file(SUBJECT)
val other = rt_file_read_text(
    "src/compiler/__q28_selftest_absent__/multiline.spl"
)
EOF
  # These strings describe content/examples, rather than files being read.
  cat > "$st/nonread_spec.spl" <<'EOF'
"""
read_file("src/compiler/__q28_selftest_absent__/docstring.spl")
"""
val description = "read_file(\"src/compiler/__q28_selftest_absent__/escaped.spl\")"
expect(source).to_contain("src/compiler/__q28_selftest_absent__/content.spl")
expect(categorize("src/compiler/__q28_selftest_absent__/category.spl")).to_equal("source")
val present = read_file("scripts/check/check-spec-missing-path-vacuity.shs") # read_file("src/compiler/__q28_selftest_absent__/trailing.spl")
val PRESENT = "scripts/check/check-spec-missing-path-vacuity.shs"
val bound_present = read_file(PRESENT)
val dynamic = make_path()
val outside_lexical_scope = read_file(dynamic)
describe "sibling scope control":
    it "only categorizes a path":
        val path = "src/compiler/__q28_selftest_absent__/scoped_example.spl"
        expect(categorize(path)).to_equal("source")
    it "reads a different path with the same variable name":
        val path = "scripts/check/check-spec-missing-path-vacuity.shs"
        val source = read_file(path)
EOF
  echo "$st/pos_spec.spl" > "$st/pos.list"
  echo "$st/neg_spec.spl" > "$st/neg.list"
  echo "$st/cmt_spec.spl" > "$st/cmt.list"
  echo "$st/bound_spec.spl" > "$st/bound.list"
  echo "$st/nonread_spec.spl" > "$st/nonread.list"

  np=$(scan "$st/pos.list" "$st/pos.hits")
  nn=$(scan "$st/neg.list" "$st/neg.hits")
  nc=$(scan "$st/cmt.list" "$st/cmt.hits")
  nb=$(scan "$st/bound.list" "$st/bound.hits")
  nr=$(scan "$st/nonread.list" "$st/nonread.hits")

  ok=1
  [ "$np" = "1" ] || { echo "selftest: positive spec not counted"; ok=0; }
  [ -s "$st/pos.hits" ] || { echo "selftest: FAILED -- planted missing path was NOT flagged (scanner is vacuous)"; ok=0; }
  [ "$nn" = "1" ] || { echo "selftest: negative spec not counted"; ok=0; }
  [ -s "$st/neg.hits" ] && { echo "selftest: FAILED -- existing path was flagged (false positive)"; ok=0; }
  [ -s "$st/cmt.hits" ] && { echo "selftest: FAILED -- path inside a spec comment was harvested"; ok=0; }
  [ "$nb" = "1" ] && [ "$(wc -l < "$st/bound.hits" | tr -d " ")" = "2" ] || {
    echo "selftest: FAILED -- bound/multiline missing reads not both flagged"; ok=0;
  }
  [ "$nr" = "1" ] && [ ! -s "$st/nonread.hits" ] || {
    echo "selftest: FAILED -- non-read/comment/docstring literals harvested"; ok=0;
  }
  [ "$ok" = "1" ] || return 1
  echo "selftest: OK -- 5 controls (missing, present, comment, bound/multiline, non-read discrimination)"
  return 0
}

if ! selftest; then
  echo "ERROR -- nothing was checked"
  exit 2
fi

case "${1:-}" in
  --selftest-only)
    echo "PASS -- selftest only, 5 controls checked"
    exit 0
    ;;
esac

ROOTS="$*"
[ -n "$ROOTS" ] || ROOTS="test"
find $ROOTS -name '*_spec.spl' -type f 2>/dev/null | sort > "$WORK/specs.list"
if [ ! -s "$WORK/specs.list" ]; then
  echo "ERROR -- nothing was checked"
  exit 2
fi

N=$(scan "$WORK/specs.list" "$WORK/hits.txt")
if [ -z "$N" ] || [ "$N" -eq 0 ] 2>/dev/null; then
  echo "ERROR -- nothing was checked"
  exit 2
fi

M=$(wc -l < "$WORK/hits.txt" | tr -d ' ')
if [ "$M" -gt 0 ]; then
  sort -u "$WORK/hits.txt"
  echo "FAIL -- $N specs checked, $M missing-path references"
  exit 1
fi
echo "PASS -- $N specs checked, 0 missing-path references"
exit 0
