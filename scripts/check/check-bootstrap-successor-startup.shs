#!/bin/sh
set -eu
binary=${1:-}
[ -n "$binary" ] && [ -x "$binary" ] || { echo "FAIL: usage: $0 <successor>" >&2; exit 1; }
out=$(mktemp "${TMPDIR:-/tmp}/simple-version.XXXXXX")
trap 'rm -f "$out"' EXIT HUP INT TERM
"$binary" --version >"$out" 2>&1 || { cat "$out" >&2; exit 1; }
grep -Fq simple-bootstrap "$out"
! grep -Fq 'registered more than once' "$out"
echo "PASS: successor starts without duplicate LLVM registration"
