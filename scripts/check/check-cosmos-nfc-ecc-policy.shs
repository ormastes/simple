#!/bin/sh
# Host-only C-oracle parity and scoped branch evidence for the migrated Cosmos
# NFC ECC policy. Physical-board evidence is deliberately excluded.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
CHECKER="$ROOT/scripts/check/check-cosmos-nfc-ecc-policy.shs"
SOURCE_DIR="$ROOT/src/os/kernel/arch/arm32/cosmos"
SIMPLE_SOURCE="$SOURCE_DIR/cosmos_nfc_ecc.spl"
C_BRIDGE="$SOURCE_DIR/cosmos_nfc_ecc_bridge.c"
C_ORACLE="$ROOT/test/02_integration/os/cosmos/cosmos_nfc_ecc_policy_oracle_test.c"
SIMPLE_SPEC="$ROOT/test/01_unit/os/arch/arm32/cosmos_nfc_ecc_spec.spl"
EVIDENCE_DIR="$ROOT/build/coverage/cosmos-nfc-ecc"
RECEIPT="$EVIDENCE_DIR/receipt.sdn"
RECEIPT_TMP="$EVIDENCE_DIR/.receipt.sdn.tmp.$$"
SCRATCH=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-nfc-ecc.XXXXXX")
trap 'case ${SCRATCH:-} in /tmp/cosmos-nfc-ecc.*|${TMPDIR:-/tmp}/cosmos-nfc-ecc.*) [ ! -d "$SCRATCH" ] || rm -r -- "$SCRATCH" ;; esac; rm -f "$RECEIPT_TMP"' EXIT HUP INT TERM

fail() {
    echo "FAIL cosmos-nfc-ecc-policy: $*" >&2
    exit 1
}

blocked() {
    echo "BLOCKED cosmos-nfc-ecc-policy: $*" >&2
    exit 2
}

hash_file() {
    sha256sum "$1" | awk '{print $1}'
}

verify_hash() {
    [ "$(hash_file "$1")" = "$2" ] || fail "$3 changed during evidence run"
}

pick_llvm_toolchain() {
    for version in 20 19 18; do
        if command -v "clang-$version" >/dev/null 2>&1 &&
           command -v "llvm-profdata-$version" >/dev/null 2>&1 &&
           command -v "llvm-cov-$version" >/dev/null 2>&1; then
            CLANG="clang-$version"
            LLVM_PROFDATA="llvm-profdata-$version"
            LLVM_COV="llvm-cov-$version"
            return
        fi
    done
    fail "matching clang, llvm-profdata, and llvm-cov are required"
}

[ "${SIMPLE_STAGE4_BIN+x}" = x ] && [ -n "$SIMPLE_STAGE4_BIN" ] ||
    blocked "set SIMPLE_STAGE4_BIN to an admitted Stage-4 compiler"
[ -x "$SIMPLE_STAGE4_BIN" ] || blocked "Stage-4 compiler is not executable"
BOOTSTRAP_STAGE3_FACADE_PATH="$ROOT/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="$ROOT/scripts/check/lib/stage4-candidate-provenance.shs"
# Freeze sourced helper bytes before loading either provenance contract.
CHECKER_SHA256=$(hash_file "$CHECKER")
BOOTSTRAP_STAGE3_FACADE_SHA256=$(hash_file "$BOOTSTRAP_STAGE3_FACADE_PATH")
STAGE4_PROVENANCE_HELPER_SHA256=$(hash_file "$STAGE4_PROVENANCE_HELPER_PATH")
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"
SIMPLE_CANONICAL=$(bootstrap_stage3_canonical_file "$SIMPLE_STAGE4_BIN") ||
    blocked "cannot resolve pure-Simple compiler canonically"
SIMPLE_PROVENANCE="${SIMPLE_CANONICAL}.provenance.env"
[ -f "$SIMPLE_PROVENANCE" ] || blocked "adjacent Stage-4 provenance is missing"

# Freeze every executable/source input before any evidence command runs.
SIMPLE_SHA256=$(hash_file "$SIMPLE_CANONICAL")
PROVENANCE_SHA256=$(hash_file "$SIMPLE_PROVENANCE")
SIMPLE_SOURCE_SHA256=$(hash_file "$SIMPLE_SOURCE")
C_BRIDGE_SHA256=$(hash_file "$C_BRIDGE")
C_ORACLE_SHA256=$(hash_file "$C_ORACLE")
SIMPLE_SPEC_SHA256=$(hash_file "$SIMPLE_SPEC")
stage4_verify_candidate_provenance \
    "$SIMPLE_PROVENANCE" "$SIMPLE_CANONICAL" "$ROOT" ||
    blocked "admitted Stage-4 provenance is required"
case "$("$SIMPLE_CANONICAL" --version 2>&1 || true)" in
    *"Rust-built Simple binary is a bootstrap seed"*|*"bootstrap seed only"*)
        blocked "a bootstrap seed cannot prove the pure-Simple policy" ;;
esac

mkdir -p "$EVIDENCE_DIR"
rm -f "$RECEIPT" "$RECEIPT_TMP"
pick_llvm_toolchain
SIMPLE_LIB="$ROOT/src" "$SIMPLE_CANONICAL" native-build \
    --backend llvm \
    --source "$SOURCE_DIR" \
    --entry-closure \
    --entry "$SIMPLE_SOURCE" \
    --target x86_64-unknown-linux-gnu \
    --emit-object \
    --no-mangle \
    --cache-dir "$SCRATCH/simple-cache" \
    -o "$SCRATCH/cosmos_nfc_ecc_simple.o"

READELF=${READELF:-readelf}
symbols=$("$READELF" -sW "$SCRATCH/cosmos_nfc_ecc_simple.o")
for symbol in cosmos_nfc_ecc_policy_crc_valid \
    cosmos_nfc_ecc_policy_spare_valid cosmos_nfc_ecc_policy_page_valid \
    cosmos_nfc_ecc_policy_worst_chunk_errors \
    cosmos_nfc_ecc_policy_needs_refresh cosmos_nfc_ecc_policy_status
do
    printf '%s\n' "$symbols" |
        awk -v symbol="$symbol" \
            '$4 == "FUNC" && $5 == "GLOBAL" && $7 != "UND" &&
             $8 == symbol { count++ } END { exit count != 1 }' ||
        fail "missing or duplicate Simple export: $symbol"
done
undefined=$(printf '%s\n' "$symbols" |
    awk '$7 == "UND" && $8 != "" { print $8 }' | LC_ALL=C sort -u)
[ -z "$undefined" ] || fail "unexpected Simple object dependency: $undefined"

"$CLANG" -std=c11 -O0 -g -fprofile-instr-generate \
    -fcoverage-mapping -Wall -Wextra -Werror -Wpedantic -Wshadow \
    -Wstrict-prototypes -Wformat=2 -Wno-int-to-pointer-cast \
    -ffunction-sections \
    -I"$SOURCE_DIR" \
    "$C_BRIDGE" "$C_ORACLE" \
    "$SCRATCH/cosmos_nfc_ecc_simple.o" \
    -Wl,--gc-sections -o "$SCRATCH/cosmos_nfc_ecc_oracle"
LLVM_PROFILE_FILE="$SCRATCH/cosmos-nfc-ecc.profraw" \
    "$SCRATCH/cosmos_nfc_ecc_oracle" > "$EVIDENCE_DIR/c-oracle-output.txt"
"$LLVM_PROFDATA" merge -sparse "$SCRATCH/cosmos-nfc-ecc.profraw" \
    -o "$SCRATCH/cosmos-nfc-ecc.profdata"
"$LLVM_COV" report "$SCRATCH/cosmos_nfc_ecc_oracle" \
    -instr-profile="$SCRATCH/cosmos-nfc-ecc.profdata" \
    "$C_BRIDGE" > "$EVIDENCE_DIR/c-bridge-llvm-cov.txt"

branch_pair=$(awk '$1 ~ /cosmos_nfc_ecc_bridge[.]c$/ { print $(NF-2), $(NF-1) }' \
    "$EVIDENCE_DIR/c-bridge-llvm-cov.txt")
set -- $branch_pair
[ "$#" -eq 2 ] || fail "cannot parse C bridge branch counters"
branch_total=$1
branch_missed=$2
branch_hit=$((branch_total - branch_missed))
[ "$branch_total" -gt 0 ] || fail "C bridge branch denominator is zero"
[ "$branch_hit" -eq "$branch_total" ] ||
    fail "C bridge has uncovered branch outcomes: $branch_hit/$branch_total"

SIMPLE_LIB="$ROOT/src" "$SIMPLE_CANONICAL" test "$SIMPLE_SPEC" \
    --quick --no-limits > "$EVIDENCE_DIR/simple-decision-output.txt"
simple_pair=$(awk '$1 == "COSMOS_NFC_ECC_SIMPLE_DECISIONS" {
    split($2, count, "/"); print count[1], count[2]
}' "$EVIDENCE_DIR/simple-decision-output.txt" | tail -n 1)
set -- $simple_pair
[ "$#" -eq 2 ] || fail "cannot parse pure-Simple decision counters"
simple_hit=$1
simple_total=$2
[ "$simple_total" -gt 0 ] || fail "Simple decision denominator is zero"
[ "$simple_hit" -eq "$simple_total" ] ||
    fail "pure-Simple policy has uncovered decisions: $simple_hit/$simple_total"

oracle_cases=$(awk '$1 == "COSMOS_NFC_ECC_C_ORACLE_CASES" { print $2 }' \
    "$EVIDENCE_DIR/c-oracle-output.txt")
[ "$oracle_cases" = 6144 ] || fail "unexpected C-oracle case count"

umask 077
{
    echo "schema=cosmos-nfc-ecc-policy-evidence-v1"
    echo "claim_scope=cosmos-nfc-ecc-acquisition-bridge-and-pure-policy-only"
    echo "board_evidence=separate-not-included"
    echo "whole_nand_ftl_claim=false"
    echo "c_oracle_cases=$oracle_cases"
    echo "c_bridge_branches_hit=$branch_hit"
    echo "c_bridge_branches_total=$branch_total"
    echo "simple_manifest_id=cosmos-nfc-ecc-pure-policy-v1"
    echo "simple_decisions_hit=$simple_hit"
    echo "simple_decisions_total=$simple_total"
    echo "stage4_compiler_path=$SIMPLE_CANONICAL"
    echo "stage4_compiler_sha256=$SIMPLE_SHA256"
    echo "stage4_provenance_path=$SIMPLE_PROVENANCE"
    echo "stage4_provenance_sha256=$PROVENANCE_SHA256"
    echo "checker_sha256=$CHECKER_SHA256"
    echo "bootstrap_stage3_facade_sha256=$BOOTSTRAP_STAGE3_FACADE_SHA256"
    echo "stage4_provenance_helper_sha256=$STAGE4_PROVENANCE_HELPER_SHA256"
    echo "simple_source_sha256=$SIMPLE_SOURCE_SHA256"
    echo "c_bridge_sha256=$C_BRIDGE_SHA256"
    echo "c_oracle_sha256=$C_ORACLE_SHA256"
    echo "simple_spec_sha256=$SIMPLE_SPEC_SHA256"
    echo "c_oracle_output_sha256=$(hash_file "$EVIDENCE_DIR/c-oracle-output.txt")"
    echo "c_bridge_coverage_sha256=$(hash_file "$EVIDENCE_DIR/c-bridge-llvm-cov.txt")"
    echo "simple_decision_output_sha256=$(hash_file "$EVIDENCE_DIR/simple-decision-output.txt")"
} > "$RECEIPT_TMP"

# Re-admit Stage 4 and every frozen input immediately before atomic publication.
stage4_verify_candidate_provenance \
    "$SIMPLE_PROVENANCE" "$SIMPLE_CANONICAL" "$ROOT" ||
    fail "Stage-4 provenance changed during evidence run"
verify_hash "$SIMPLE_CANONICAL" "$SIMPLE_SHA256" compiler
verify_hash "$SIMPLE_PROVENANCE" "$PROVENANCE_SHA256" provenance
verify_hash "$CHECKER" "$CHECKER_SHA256" checker
verify_hash "$BOOTSTRAP_STAGE3_FACADE_PATH" "$BOOTSTRAP_STAGE3_FACADE_SHA256" bootstrap-stage3-facade
verify_hash "$STAGE4_PROVENANCE_HELPER_PATH" "$STAGE4_PROVENANCE_HELPER_SHA256" stage4-provenance-helper
verify_hash "$SIMPLE_SOURCE" "$SIMPLE_SOURCE_SHA256" simple-source
verify_hash "$C_BRIDGE" "$C_BRIDGE_SHA256" c-bridge
verify_hash "$C_ORACLE" "$C_ORACLE_SHA256" c-oracle
verify_hash "$SIMPLE_SPEC" "$SIMPLE_SPEC_SHA256" simple-spec
mv -f -- "$RECEIPT_TMP" "$RECEIPT"

echo "cosmos_nfc_ecc_c_oracle_cases=$oracle_cases"
echo "cosmos_nfc_ecc_c_bridge_branches=$branch_hit/$branch_total"
echo "cosmos_nfc_ecc_simple_policy_decisions=$simple_hit/$simple_total"
echo "cosmos_nfc_ecc_board_evidence=separate-not-included"
echo "cosmos_nfc_ecc_receipt=$RECEIPT"
echo "cosmos_nfc_ecc_receipt_sha256=$(hash_file "$RECEIPT")"
echo "STATUS: PASS cosmos-nfc-ecc pure-policy migration"
