#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)"
. "$ROOT_DIR/scripts/lib/simple-compiler-select.shs"
BUILD_DIR="${BUILD_DIR:-$ROOT_DIR/build/electron_mdi_evidence}"
SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE:-explicit-env}"
SIMPLE_BIN_STATUS=pass
is_rust_seed_simple() {
    # Identity probe, not just a path pattern (2026-07-28).
    # This used to test ONLY for a src/compiler_rust/ path. The deployed Rust
    # seed lives at bin/release/<triple>/simple, which matches none of those
    # patterns, so the seed was classified "not a seed" and every self-hosted
    # claim in this script was asserted against it. Ask the binary instead.
    # Audit: doc/08_tracking/todo/check_scripts_seed_identity_fail_open_2026-07-28.md
    case "$1" in
        src/compiler_rust/*|./src/compiler_rust/*|*/src/compiler_rust/*) return 0 ;;
    esac
    # Not runnable: leave it to the caller's own missing-binary branch, which
    # already fails. Do not report "seed" for something we never ran.
    [ -n "${1:-}" ] && [ -x "$1" ] || return 1
    # Executable but unverifiable => treat as forbidden (fail closed). The seed
    # self-identifies on stderr, so 2>&1 is required.
    if command -v timeout >/dev/null 2>&1; then
        _irss_v="$(timeout 10 "$1" --version 2>&1)" || return 0
    else
        _irss_v="$("$1" --version 2>&1)" || return 0
    fi
    [ -n "$_irss_v" ] || return 0
    case "$_irss_v" in
        *"bootstrap seed only"*|*"Rust-built"*|*"debug build"*) return 0 ;;
    esac
    return 1
}
if [ "${SIMPLE_BIN:-}" = "" ]; then
    SIMPLE_BIN_SOURCE="missing-self-hosted"
    # Was a first-match-wins loop that accepted on bare `-x` (fail-open: takes
    # the first executable, including a seed or a cross-target payload). Now
    # delegates to the shared positive-capability probe.
    SIMPLE_BIN="$(simple_compiler_select --root "$ROOT_DIR" --quiet 2>/dev/null || true)"
    [ -n "$SIMPLE_BIN" ] && SIMPLE_BIN_SOURCE="repo-self-hosted-fallback"
    if [ "${SIMPLE_BIN:-}" = "" ] && [ "${ALLOW_PATH_SIMPLE_BIN:-0}" = "1" ] && command -v simple >/dev/null 2>&1; then
        SIMPLE_BIN="$(command -v simple)"
        SIMPLE_BIN_SOURCE="path-opt-in"
    fi
else
    SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE:-explicit-env}"
fi
SIMPLE_BIN="${SIMPLE_BIN:-}"
if [ "$SIMPLE_BIN" = "" ]; then
    SIMPLE_BIN_STATUS=missing
elif is_rust_seed_simple "$SIMPLE_BIN"; then
    SIMPLE_BIN_STATUS=forbidden
    SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE}-rust-seed-forbidden"
elif [ ! -x "$SIMPLE_BIN" ]; then
    SIMPLE_BIN_STATUS=missing
    SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE}-missing"
fi
export SIMPLE_BIN SIMPLE_BIN_SOURCE SIMPLE_BIN_STATUS
ENTRY="$ROOT_DIR/examples/06_io/ui/electron_wm.spl"
VALIDATOR="$ROOT_DIR/scripts/check/validate-electron-mdi-proof.js"
PROOF_PATH="$BUILD_DIR/electron_mdi_proof.json"
SCREENSHOT_PATH="$BUILD_DIR/electron_mdi.png"
LOG_PATH="$BUILD_DIR/electron_mdi.log"
TIMEOUT_SECS="${ELECTRON_MDI_TIMEOUT_SECS:-60}"

mkdir -p "$BUILD_DIR"
rm -f "$PROOF_PATH" "$SCREENSHOT_PATH"

fail() {
    echo "status=fail"
    echo "reason=$1"
    echo "electron_mdi_simple_bin=$SIMPLE_BIN"
    echo "electron_mdi_simple_bin_source=$SIMPLE_BIN_SOURCE"
    echo "electron_mdi_simple_bin_status=$SIMPLE_BIN_STATUS"
    exit 1
}

echo "electron_mdi_simple_bin=$SIMPLE_BIN"
echo "electron_mdi_simple_bin_source=$SIMPLE_BIN_SOURCE"
echo "electron_mdi_simple_bin_status=$SIMPLE_BIN_STATUS"

if [ "$SIMPLE_BIN_STATUS" = "forbidden" ]; then
    fail "simple-bin-forbidden"
fi
if [ "$SIMPLE_BIN_STATUS" != "pass" ]; then
    fail "missing-simple-bin"
fi

command -v node >/dev/null 2>&1 || fail "node not found"
command -v npm >/dev/null 2>&1 || fail "npm not found"
command -v xvfb-run >/dev/null 2>&1 || fail "xvfb-run not found"
test -x "$SIMPLE_BIN" || fail "host Simple runtime missing: $SIMPLE_BIN"
test -f "$ENTRY" || fail "Electron MDI entry missing: $ENTRY"
test -f "$VALIDATOR" || fail "Electron MDI proof validator missing: $VALIDATOR"

if [ ! -x "$ROOT_DIR/tools/electron-shell/node_modules/.bin/electron" ] \
    && [ ! -x "$ROOT_DIR/tools/electron-shell/node_modules/electron/dist/electron" ]; then
    fail "Electron dependency missing under tools/electron-shell/node_modules"
fi

if command -v timeout >/dev/null 2>&1; then
    timeout "$TIMEOUT_SECS" xvfb-run -a --server-args="-screen 0 1280x720x24" \
        env SIMPLE_ELECTRON_MDI_PROOF_PATH="$PROOF_PATH" \
            SIMPLE_ELECTRON_MDI_SCREENSHOT_PATH="$SCREENSHOT_PATH" \
            npm --prefix "$ROOT_DIR/tools/electron-shell" exec -- electron --no-sandbox "$ROOT_DIR/tools/electron-shell" \
            --simple-bin "$SIMPLE_BIN" --entry "$ENTRY" > "$LOG_PATH" 2>&1 \
        || fail "Electron MDI proof run failed; see $LOG_PATH"
else
    xvfb-run -a --server-args="-screen 0 1280x720x24" \
        env SIMPLE_ELECTRON_MDI_PROOF_PATH="$PROOF_PATH" \
            SIMPLE_ELECTRON_MDI_SCREENSHOT_PATH="$SCREENSHOT_PATH" \
            npm --prefix "$ROOT_DIR/tools/electron-shell" exec -- electron --no-sandbox "$ROOT_DIR/tools/electron-shell" \
            --simple-bin "$SIMPLE_BIN" --entry "$ENTRY" > "$LOG_PATH" 2>&1 \
        || fail "Electron MDI proof run failed; see $LOG_PATH"
fi

test -s "$PROOF_PATH" || fail "Electron MDI proof missing: $PROOF_PATH"
test -s "$SCREENSHOT_PATH" || fail "Electron MDI screenshot missing: $SCREENSHOT_PATH"

node "$VALIDATOR" "$PROOF_PATH" "$SCREENSHOT_PATH" || fail "electron-mdi-json-proof-failed"

"$SIMPLE_BIN" run "$ROOT_DIR/scripts/check/ios_mdi_probe_server.spl" --mode=interpreter --validate-screenshot \
    "$SCREENSHOT_PATH" electron_mdi_screenshot
"$SIMPLE_BIN" run "$ROOT_DIR/scripts/check/ios_mdi_probe_server.spl" --mode=interpreter --validate-electron-mdi-screenshot \
    "$SCREENSHOT_PATH"

echo "electron_mdi_screenshot=$SCREENSHOT_PATH"
echo "electron_mdi_proof=$PROOF_PATH"
echo "electron_mdi_simple_bin=$SIMPLE_BIN"
echo "electron_mdi_simple_bin_source=$SIMPLE_BIN_SOURCE"
echo "electron_mdi_simple_bin_status=$SIMPLE_BIN_STATUS"
echo "status=pass"
