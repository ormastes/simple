#!/bin/sh
# check-undefined-import-run-exit-code.shs
#
# Fail-closed gate: running a `.spl` file that IMPORTS AND CALLS a symbol which
# exists nowhere must NOT exit 0.
#
# ---------------------------------------------------------------------------
# WHY THIS CHECK EXISTS
# ---------------------------------------------------------------------------
# 2026-08-17, src/lib/gc_async_mut/gpu/engine2d/engine.spl:41 imported five
# functions that existed nowhere in the tree and called all five. The seed
# printed `[use-warning]` lines and exited **rc=0**, so every downstream
# "it parses / it runs" verification was worthless.
#
# CURRENT CONTRACT (seed module loader): a braced `use m.{a, b}` naming a name
# that module `m` does not provide is a HARD COMPILE ERROR
# (CompileError::semantic):
#
#   `NAME` is named in `use LABEL.{...}` but module `LABEL` (PATH) does not
#   provide it (imported from IMPORTER); import it from the module that defines
#   it
#
# The program does not execute and the exit code is non-zero, whether or not
# the bad name is ever called. `SIMPLE_NO_DEPRECATED_WARNINGS` no longer affects
# it. Extern fn / extern class names still count as provided. Modules whose
# source has a top-level `@when(` or `@cfg(` line are not checked at all.
#
# This gate pins that contract on the binary under test, so a regression back
# to warn-and-continue (rc 0) is caught.
#
# WHAT IS ASSERTED (from one run of the binary under test per fixture)
#   1. CONTROL — a fixture importing `uw_probe_plain_provided` (an ordinary fn)
#      and `uw_probe_extern_provided` (an `extern fn`, must not be a false
#      positive) and calling the plain one must print CONTROL_OK, exit 0 and
#      print no "does not provide it" line. If the control fails, the harness
#      is measuring nothing: ERROR, not PASS.
#   2. DEFECT-A — the fixture importing and calling `uw_probe_zzz_absent`
#      (deliberately absent from the probe module) must exit NONZERO, not
#      signal-die (rc < 128), print a "does not provide it" error naming it,
#      and must NOT print REACHED.
#   3. DEFECT-B — the same undefined import, but CALLED FROM A FUNCTION THAT IS
#      NEVER EXECUTED (the engine.spl shape). Same requirements as DEFECT-A:
#      the check is on the `use`, not on the call being reached.
#
# FIXTURE COUPLING: the probe module `src/lib/common/use_warning_probe.spl` is
# shared with check-use-warning-oracle-deployed.shs and must keep declaring
# `uw_probe_plain_provided` / `uw_probe_extern_provided` and NOT declaring
# `uw_probe_zzz_absent`.
#
# EXIT CODES (repo pre-push guard convention; verdict is the LAST stdout line)
#   0 PASS  — `PASS — <n> fixture(s) checked, ...`  (n is always > 0)
#   1 FAIL  — a defect was observed
#   2 ERROR — nothing was checked (no binary, no `timeout`, control broken)
#
# Usage: sh scripts/check/check-undefined-import-run-exit-code.shs [--selftest]
# Env:   UIEC_BIN=<path>  binary under test (default bin/simple). Used by the
#                         selftest to drive stub binaries.
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
# The hard-error contract is opt-in (SIMPLE_STRICT_USE=1); the default lane only# warns until the re-exposed-import census is empty.export SIMPLE_STRICT_USE=1
PROBE_MODULE="$REPO_ROOT/src/lib/common/use_warning_probe.spl"
RUN_TIMEOUT="${UIEC_TIMEOUT:-300}"

CHECKED=0
FAILURES=""

die_error() {
    echo "$1"
    echo "ERROR — nothing was checked"
    exit 2
}

# Write the two fixtures into $1 (a directory). Returns paths via globals.
write_fixtures() {
    _d="$1"
    F_CONTROL="$_d/uiec_control.spl"
    F_ABSENT="$_d/uiec_zzz_absent.spl"
    F_UNREACHED="$_d/uiec_zzz_absent_unreached.spl"
    cat >"$F_CONTROL" <<'EOF'
use std.common.use_warning_probe.{uw_probe_plain_provided, uw_probe_extern_provided}

fn main():
    val x = uw_probe_plain_provided()
    print("CONTROL_OK")
EOF
    cat >"$F_ABSENT" <<'EOF'
use std.common.use_warning_probe.{uw_probe_zzz_absent}

fn main():
    val x = uw_probe_zzz_absent(1)
    print("REACHED")
EOF
    cat >"$F_UNREACHED" <<'EOF'
use std.common.use_warning_probe.{uw_probe_zzz_absent}

fn never_called() -> i64:
    return uw_probe_zzz_absent(1)

fn main():
    print("REACHED")
EOF
}

# run_fixture <bin> <file> <outfile>  -> sets RC (never read through a pipe)
run_fixture() {
    ( cd "$REPO_ROOT" && timeout "$RUN_TIMEOUT" "$1" run "$2" >"$3" 2>&1 )
    RC=$?
}

# check_absent <label> <rc> <log> <failtag> [symbol]
# One absent-name fixture must be a hard "does not provide it" error: rc != 0,
# rc < 128, error names the symbol, body never ran.
check_absent() {
    _lbl="$1"; _rc="$2"; _log="$3"; _tag="$4"; _sym="${5:-uw_probe_zzz_absent}"
    CHECKED=$((CHECKED + 1))
    if [ "$_rc" -eq 0 ]; then
        echo "  [defect] $_lbl: undefined named import accepted, exit 0 (LENIENT)"
        grep -nE 'does not provide it|use-warning|^error' "$_log" | head -n 5 | sed 's/^/  | /'
        FAILURES="${FAILURES}${_tag}-exits-0 "
    elif [ "$_rc" -ge 128 ]; then
        echo "  [defect] $_lbl: signal death rc=$_rc (crash, not a diagnostic)"
        FAILURES="${FAILURES}${_tag}-crashes(rc=$_rc) "
    elif grep -q 'REACHED' "$_log"; then
        echo "  [defect] $_lbl: body executed (printed REACHED) despite rc=$_rc"
        FAILURES="${FAILURES}${_tag}-body-ran "
    elif ! grep 'does not provide it' "$_log" | grep -q "$_sym"; then
        echo "  [defect] $_lbl: rc=$_rc but no \"does not provide it\" error naming $_sym"
        head -n 5 "$_log" | sed 's/^/  | /'
        FAILURES="${FAILURES}${_tag}-wrong-diagnostic "
    else
        echo "  [ok] $_lbl: hard error \"does not provide it\", exit $_rc, did not run — fail-closed"
    fi
}

# scan <bin> <workdir> -> prints findings, sets CHECKED/FAILURES
scan() {
    _bin="$1"
    _work="$2"
    write_fixtures "$_work"

    run_fixture "$_bin" "$F_CONTROL" "$_work/control.log"
    _crc=$RC
    if [ "$_crc" -ne 0 ] || ! grep -q 'CONTROL_OK' "$_work/control.log"; then
        die_error "  control fixture did not run cleanly (rc=$_crc); the harness is measuring nothing"
    fi
    if grep -q 'does not provide it' "$_work/control.log"; then
        echo "  [defect] control importing only provided names (incl. extern fn) drew \"does not provide it\" (FALSE POSITIVE)"
        grep -n 'does not provide it' "$_work/control.log" | head -n 3 | sed 's/^/  | /'
        FAILURES="${FAILURES}false-positive-on-provided-name "
    fi
    CHECKED=$((CHECKED + 1))
    echo "  [control] provided names (plain fn + extern fn) ran, printed CONTROL_OK, exit 0 — harness live"

    run_fixture "$_bin" "$F_ABSENT" "$_work/absent.log"
    check_absent "uw_probe_zzz_absent (executed path)" "$RC" "$_work/absent.log" undefined-import

    run_fixture "$_bin" "$F_UNREACHED" "$_work/unreached.log"
    check_absent "uw_probe_zzz_absent (off executed path)" "$RC" "$_work/unreached.log" unreached-undefined-import

    # An `export use` facade whose source lacks a re-exported name must fail
    # its importer too (it used to load as an empty dict, silently).
    run_fixture "$_bin" "$REPO_ROOT/test/fixtures/export_alias_owner/bad_facade_import.spl" "$_work/facade.log"
    check_absent "zzz_absent_facade (export use re-export)" "$RC" "$_work/facade.log" facade-reexport-undefined zzz_absent
}

# --------------------------------------------------------------------------
# selftest — fatal, runs before every real scan, drives stub binaries in BOTH
# directions and proves fail-closedness by MUTATION of the stub's exit code.
# --------------------------------------------------------------------------
make_stub() {
    # $1 = path, $2 = rc for the absent fixture, $3 = rc for the control fixture
    cat >"$1" <<EOF
#!/bin/sh
f="\$2"
if grep -q zzz_absent "\$f" 2>/dev/null; then
    echo "error: semantic: 'uw_probe_zzz_absent' is named in use x.{...} but module x does not provide it" >&2
    exit $2
fi
echo CONTROL_OK
exit $3
EOF
    chmod +x "$1"
}

selftest() {
    _st="$(mktemp -d)" || die_error "  mktemp failed"
    _fails=0
    _n=0

    # fixture 1: fail-open stub (the real defect) -> guard must FAIL (1)
    make_stub "$_st/stub_open" 0 0
    # fixture 2: fail-closed stub (mutation of fixture 1's exit code) -> PASS (0)
    make_stub "$_st/stub_closed" 1 0
    # fixture 3: crashing stub -> FAIL (1); a SIGSEGV is not a diagnostic
    make_stub "$_st/stub_crash" 139 0
    # fixture 4: broken control -> ERROR (2); a dead harness never passes
    make_stub "$_st/stub_nocontrol" 1 3

    for _case in "stub_open 1" "stub_closed 0" "stub_crash 1" "stub_nocontrol 2"; do
        _stub="${_case% *}"
        _want="${_case#* }"
            _n=$((_n + 1))
        UIEC_BIN="$_st/$_stub" sh "$0" --inner >"$_st/$_stub.log" 2>&1
        _got=$?
        if [ "$_got" -ne "$_want" ]; then
            echo "  selftest FAIL: $_stub expected exit $_want, got $_got"
            sed 's/^/    | /' "$_st/$_stub.log"
            _fails=$((_fails + 1))
        else
            echo "  selftest ok: $_stub -> exit $_got"
        fi
    done

    rm -rf "$_st"
    if [ "$_fails" -ne 0 ] || [ "$_n" -eq 0 ]; then
        echo "FAIL — selftest: $_fails of $_n fixture(s) wrong"
        exit 1
    fi
    echo "  selftest: $_n/$_n fixtures correct (both directions, mutation-proved)"
}

# --------------------------------------------------------------------------
main() {
    _inner=0
    [ "${1:-}" = "--inner" ] && _inner=1

    command -v timeout >/dev/null 2>&1 || die_error "  no \`timeout\` on this host"

    BIN="${UIEC_BIN:-$REPO_ROOT/bin/simple}"
    [ -x "$BIN" ] || die_error "  binary under test not executable: $BIN"

    if [ "$_inner" -eq 0 ]; then
        [ -f "$PROBE_MODULE" ] || die_error "  missing fixture module: $PROBE_MODULE"
        grep -q 'uw_probe_plain_provided' "$PROBE_MODULE" \
            || die_error "  fixture module no longer declares uw_probe_plain_provided"
        # Declaration-shaped lines only — the file's header COMMENT mentions
        # `uw_probe_zzz_absent` by design ("Do not add it"), and a bare grep
        # would read that prose as a declaration.
        if grep -qE '^[[:space:]]*(pub |export |extern |async |@extern )*(fn|class|struct|enum|trait|mixin|actor|interface|type|alias|macro|val|var|let|const|global|object)[[:space:]]+uw_probe_zzz_absent\b' "$PROBE_MODULE"; then
            die_error "  fixture module now declares uw_probe_zzz_absent — the absent name is no longer absent"
        fi
        selftest
    fi

    WORK="$(mktemp -d)" || die_error "  mktemp failed"
    scan "$BIN" "$WORK"
    rm -rf "$WORK"

    if [ "$CHECKED" -eq 0 ]; then
        echo "ERROR — nothing was checked"
        exit 2
    fi
    if [ -n "$FAILURES" ]; then
        echo "FAIL — $CHECKED fixture(s) checked with $BIN, defect(s): $FAILURES"
        exit 1
    fi
    echo "PASS — $CHECKED fixture(s) checked with $BIN, an undefined called import exits nonzero"
    exit 0
}

case "${1:-}" in
    --selftest)
        command -v timeout >/dev/null 2>&1 || die_error "  no \`timeout\` on this host"
        selftest
        echo "PASS — 4 selftest fixture(s) checked, guard is fail-closed"
        exit 0
        ;;
esac

main "${1:-}"
