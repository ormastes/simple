#!/bin/sh
# Web-renderer COMBINATION MATRIX vs Chrome: tag x tag nesting, tag x CSS and
# CSS x CSS pairs, compared per element against real Chrome (>= 159).
#
#   sh scripts/check/check-web-combo-matrix-chrome.shs                 # run the ratchet
#   sh scripts/check/check-web-combo-matrix-chrome.shs --selftest      # comparator fixtures only
#   sh scripts/check/check-web-combo-matrix-chrome.shs --generate-baseline
#
# Fixtures: test/fixtures/browser/combo_matrix/ (generated, committed; the
# generator is scripts/generate/generate-web-combo-matrix.shs). Each cell is
# a 400x140 slot holding a parent and 1-3 children, every one with an id.
#
# Both sides lay the SAME page out once at 900x2000:
#   Chrome  the geometry differ's `--harvest` mode (walker rows carry `id=`)
#   Simple  `layout_geometry_diff.spl simple-geom` (one layout pass per page)
# Rows are joined on the shared nth-path key and looked up by id.
#
# What "matches" means, for every id in cells.tsv (tolerance 1 px, each of
# x, y, w, h):
#   - a slot is compared in PAGE coordinates (group `slot`);
#   - every other element is compared RELATIVE TO ITS SLOT ORIGIN on each
#     side, so one wrong cell cannot shift the verdict of the cells after it;
#   - an element Chrome does not render (checkVisibility() false: display:none
#     and its subtree) has no position; it matches when Simple generates no
#     box, or a 0x0 one. Position is not compared for it;
#   - an id Simple has no box for, or whose nth-path holds a different tag on
#     the Simple side, is a MISMATCH (reason in the `simple=` field), never
#     dropped.
#
# RATCHET. web_combo_matrix_baseline.txt lists the element ids that mismatch
# today. FAIL on any mismatching id that is not baselined (a regression) and
# on any baselined id that now matches or no longer exists (a stale baseline;
# remove the row in the same change as the fix). `--generate-baseline` is for
# reviewed updates only: read the mismatch lines first.
#
# Output: one line per mismatching element
#   cell=<tag>/<css> id=<id> chrome=x,y,w,h simple=x,y,w,h
# then a per-group table (cells, matching, %), then the verdict, which is the
# LAST line of stdout:
#   PASS  — <n> cell(s) compared, <m> mismatching (ratchet <file>)   exit 0
#   FAIL  — ...                                                       exit 1
#   ERROR — nothing was checked (<reason>)                            exit 2
# 0 cells compared, no Chrome, an old Chrome, stale fixtures, a degraded
# Simple render and a manifest id Chrome does not report are all ERROR.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

FIX_DIR="test/fixtures/browser/combo_matrix"
MANIFEST="$FIX_DIR/cells.tsv"
BASELINE="scripts/check/web_combo_matrix_baseline.txt"
GENERATOR="scripts/generate/generate-web-combo-matrix.shs"
HARVESTER="scripts/check/check-chrome-layout-geometry-diff.shs"
GEOM_APP="src/app/ui/chrome_showcase/layout_geometry_diff.spl"
BUILD_DIR="${COMBO_BUILD_DIR:-build/web_combo_matrix}"
PAGES="tag_tag tag_css css_css"
WIDTH=900
HEIGHT=2000
TOLERANCE=1
MIN_CHROME_MAJOR=159

err() {
    echo "ERROR — nothing was checked ($1)"
    exit 2
}

# compare <manifest> <baseline> <rows> -> mismatch lines, table, verdict line.
# rows: C<TAB>page<TAB>path<TAB>tag<TAB>x<TAB>y<TAB>w<TAB>h<TAB>rendered<TAB>id
#       S<TAB>page<TAB>path<TAB>tag<TAB>x<TAB>y<TAB>w<TAB>h
# Exit status: 0 PASS, 1 FAIL, 2 ERROR.
compare() {
    LC_ALL=C awk -F '\t' -v manifest="$1" -v baseline="$2" -v tol="$TOLERANCE" \
        -v label="${3##*/}" -v chrome_ver="${CHROME_VERSION:-unknown}" '
    function abs(v) { return v < 0 ? -v : v }
    function near(a, b) { return abs(a - b) <= tol }
    $1 == "C" {
        if ($10 == "") next
        ck = $2 SUBSEP $3
        cid_key[$10] = ck; ctag[ck] = $4
        cx[ck] = $5; cy[ck] = $6; cw[ck] = $7; ch[ck] = $8; crend[ck] = $9
        next
    }
    $1 == "S" {
        sk = $2 SUBSEP $3
        stag[sk] = $4; sx[sk] = $5; sy[sk] = $6; sw[sk] = $7; sh[sk] = $8
        shave[sk] = 1
        next
    }
    END {
        n = 0
        while ((getline line < manifest) > 0) {
            split(line, f, "\t")
            if (f[1] == "") continue
            n++
            ids[n] = f[1]; slot_of[f[1]] = f[2]; group_of[f[1]] = f[3]; label_of[f[1]] = f[4]
            known[f[1]] = 1
        }
        nb = 0
        while ((getline line < baseline) > 0) {
            if (line == "" || line ~ /^#/) continue
            based[line] = 1; nb++
        }
        absent = 0; mism = 0; new_n = 0; stale_n = 0
        for (i = 1; i <= n; i++) {
            id = ids[i]
            if (!(id in cid_key)) { absent++; absent_names = absent_names " " id; continue }
            ck = cid_key[id]
            slot = slot_of[id]
            is_slot = (slot == "-")
            cell_slot = is_slot ? id : slot
            if (is_slot) grp[id] = ""
            # Chrome side.
            ox = 0; oy = 0
            if (!is_slot) {
                if (!(slot in cid_key)) { absent++; absent_names = absent_names " " slot; continue }
                ox = cx[cid_key[slot]]; oy = cy[cid_key[slot]]
                grp[slot] = group_of[id]
            }
            c_txt = (cx[ck] - ox) "," (cy[ck] - oy) "," cw[ck] "," ch[ck]
            rendered = (crend[ck] != "false")
            # Simple side.
            bad = 0
            if (!(ck in shave)) {
                s_txt = "missing"
                bad = rendered
            } else if (stag[ck] != ctag[ck]) {
                s_txt = "tag:" stag[ck]
                bad = 1
            } else {
                px = 0; py = 0; slot_ok = 1
                if (!is_slot) {
                    sk = cid_key[slot]
                    if (sk in shave) { px = sx[sk]; py = sy[sk] } else slot_ok = 0
                }
                s_txt = (sx[ck] - px) "," (sy[ck] - py) "," sw[ck] "," sh[ck]
                if (!rendered) {
                    c_txt = "not-rendered"
                    bad = !(sw[ck] == 0 && sh[ck] == 0)
                } else if (!slot_ok) {
                    s_txt = "missing-slot"
                    bad = 1
                } else {
                    bad = !(near(cx[ck] - ox, sx[ck] - px) && near(cy[ck] - oy, sy[ck] - py) && \
                            near(cw[ck], sw[ck]) && near(ch[ck], sh[ck]))
                }
            }
            compared++
            cell_seen[cell_slot] = 1
            if (bad) {
                mism++
                cell_bad[cell_slot] = 1
                lab = label_of[id]; gsub(/ /, "_", lab)
                tag = ""
                if (!(id in based)) { new_n++; tag = " NEW"; new_names = new_names " " id }
                printf "cell=%s id=%s chrome=%s simple=%s%s\n", lab, id, c_txt, s_txt, tag
                if (mism_file != "") print id > mism_file
            } else if (id in based) {
                stale_n++; stale_names = stale_names " " id
            }
        }
        for (b in based) if (!(b in known)) { stale_n++; stale_names = stale_names " " b }

        cells = 0; cells_bad = 0
        for (s in cell_seen) {
            cells++
            g = grp[s]; if (g == "") g = "(slot only)"
            gc[g]++
            if (s in cell_bad) { cells_bad++; gb[g]++ }
        }
        # Slots as their own row: a slot box that is wrong is one finding.
        slots = 0; slots_bad = 0
        for (i = 1; i <= n; i++) if (slot_of[ids[i]] == "-" && (ids[i] in cid_key)) {
            slots++
        }
        print ""
        printf "%-28s %6s %9s %7s\n", "group", "cells", "matching", "%"
        ng = 0
        for (g in gc) order[++ng] = g
        for (i = 1; i <= ng; i++) for (j = i + 1; j <= ng; j++) if (order[j] < order[i]) {
            t = order[i]; order[i] = order[j]; order[j] = t
        }
        for (i = 1; i <= ng; i++) {
            g = order[i]; ok = gc[g] - gb[g]
            printf "%-28s %6d %9d %6.1f%%\n", g, gc[g], ok, 100.0 * ok / gc[g]
        }
        if (cells > 0)
            printf "%-28s %6d %9d %6.1f%%\n", "TOTAL", cells, cells - cells_bad, 100.0 * (cells - cells_bad) / cells
        printf "element ids compared: %d, mismatching: %d (baselined %d)\n", compared, mism, nb
        if (absent > 0) {
            printf "ERROR — nothing was checked (%d manifest id(s) absent from Chrome:%s)\n", absent, substr(absent_names, 1, 300)
            exit 2
        }
        if (cells == 0) {
            print "ERROR — nothing was checked (0 cell(s) compared)"
            exit 2
        }
        if (new_n > 0 || stale_n > 0) {
            printf "FAIL — %d cell(s) compared, %d mismatching; %d new mismatching id(s):%s; %d stale baseline id(s):%s (ratchet %s, Chrome %s)\n", \
                cells, cells_bad, new_n, substr(new_names, 1, 400), stale_n, substr(stale_names, 1, 400), baseline, chrome_ver
            exit 1
        }
        printf "PASS — %d cell(s) compared, %d mismatching (ratchet %s, %d id(s) baselined, Chrome %s)\n", \
            cells, cells_bad, baseline, nb, chrome_ver
    }' mism_file="${MISM_FILE:-}" "$3"
}

# ------------------------------------------------------------------ selftest
selftest() {
    st="$(mktemp -d "${TMPDIR:-/tmp}/combo-selftest.XXXXXX")"
    trap 'rm -rf "$st"' EXIT
    printf 'a-s\t-\tslot\tdiv/span\na-p\ta-s\ttag-tag\tdiv/span\na-c\ta-s\ttag-tag\tdiv/span\nn-s\t-\tslot\tdiv/display:none\nn-t\tn-s\ttag-css/display\tdiv/display:none\n' >"$st/cells.tsv"
    # Chrome: slot a at y=0, slot n at y=140; n-t is not rendered.
    chrome_rows() {
        printf 'C\tp\t0\tdiv\t0\t0\t400\t140\ttrue\ta-s\n'
        printf 'C\tp\t0/0\tdiv\t0\t0\t400\t24\ttrue\ta-p\n'
        printf 'C\tp\t0/0/0\tspan\t20\t%s\t30\t17\ttrue\ta-c\n' "$1"
        printf 'C\tp\t1\tdiv\t0\t140\t400\t140\ttrue\tn-s\n'
        printf 'C\tp\t1/0\tdiv\t0\t0\t0\t0\tfalse\tn-t\n'
    }
    # Simple: every slot is shifted 50px down the page, which the slot group
    # must report and the slot-relative rows must NOT inherit.
    simple_rows() {
        printf 'S\tp\t0\tdiv\t0\t%s\t400\t140\n' "$1"
        printf 'S\tp\t0/0\tdiv\t0\t%s\t400\t24\n' "$1"
        [ "$2" = "nochild" ] || printf 'S\tp\t0/0/0\t%s\t20\t%s\t30\t18\n' "$2" "$(($1 + 3))"
        printf 'S\tp\t1\tdiv\t0\t%s\t400\t140\n' "$(($1 + 140))"
        printf 'S\tp\t1/0\tdiv\t0\t999\t%s\t0\n' "$3"
    }
    st_fail=0
    st_n=0
    # expect <name> <want rc> <want substring> <baseline content>
    expect() {
        st_n=$((st_n + 1))
        printf '%s' "$4" >"$st/base.txt"
        set +e
        st_out="$(MISM_FILE="" compare "$st/cells.tsv" "$st/base.txt" "$st/rows.tsv")"
        st_rc=$?
        set -e
        case "$st_out" in
            *"$3"*) st_hit=1 ;;
            *) st_hit=0 ;;
        esac
        if [ "$st_rc" -eq "$2" ] && [ "$st_hit" -eq 1 ]; then
            echo "selftest $1: PASS"
        else
            echo "selftest $1: FAIL (rc=$st_rc want $2; wanted text: $3)"
            echo "$st_out" | tail -n 3
            st_fail=$((st_fail + 1))
        fi
    }
    { chrome_rows 3; simple_rows 0 span 0; } >"$st/rows.tsv"
    expect "identical-within-tolerance" 0 "PASS — 2 cell(s) compared, 0 mismatching" ""
    { chrome_rows 9; simple_rows 0 span 0; } >"$st/rows.tsv"
    expect "wrong-chrome-expectation-is-reported" 1 "cell=div/span id=a-c chrome=20,9,30,17 simple=20,3,30,18 NEW" ""
    expect "baselined-mismatch-passes" 0 "PASS — 2 cell(s) compared, 1 mismatching" "a-c
"
    { chrome_rows 3; simple_rows 0 span 0; } >"$st/rows.tsv"
    expect "stale-baseline-fails" 1 "1 stale baseline id(s): a-c" "a-c
"
    expect "unknown-baseline-id-fails" 1 "1 stale baseline id(s): gone-id" "gone-id
"
    { chrome_rows 3; simple_rows 50 span 0; } >"$st/rows.tsv"
    expect "shifted-slot-does-not-cascade" 0 "PASS — 2 cell(s) compared, 2 mismatching" "a-s
n-s
"
    { chrome_rows 3; simple_rows 0 nochild 0; } >"$st/rows.tsv"
    expect "missing-in-simple-is-a-mismatch" 1 "id=a-c chrome=20,3,30,17 simple=missing NEW" ""
    { chrome_rows 3; simple_rows 0 em 0; } >"$st/rows.tsv"
    expect "tag-desync-is-a-mismatch" 1 "id=a-c chrome=20,3,30,17 simple=tag:em NEW" ""
    { chrome_rows 3; simple_rows 0 span 12; } >"$st/rows.tsv"
    expect "not-rendered-needs-empty-box" 1 "id=n-t chrome=not-rendered simple=0,859,12,0 NEW" ""
    { chrome_rows 3 | grep -v 'a-c$'; simple_rows 0 span 0; } >"$st/rows.tsv"
    expect "id-absent-from-chrome-is-error" 2 "ERROR — nothing was checked (1 manifest id(s) absent from Chrome: a-c)" ""
    : >"$st/rows.tsv"
    : >"$st/cells.tsv"
    expect "empty-compare-is-error" 2 "ERROR — nothing was checked (0 cell(s) compared)" ""
    if [ "$st_fail" -ne 0 ]; then
        echo "FAIL — $st_n selftest fixture(s) checked, $st_fail failed"
        return 1
    fi
    echo "selftest: $st_n fixture(s) checked, 0 failed"
    return 0
}

MODE="${1:-run}"
set +e
selftest_out="$(selftest)"
selftest_rc=$?
set -e
if [ "$MODE" = "--selftest" ]; then
    echo "$selftest_out"
    [ "$selftest_rc" -eq 0 ] || exit 1
    echo "PASS — 11 fixture(s) checked, 0 failed"
    exit 0
fi
if [ "$selftest_rc" -ne 0 ]; then
    echo "$selftest_out"
    err "comparator selftest failed"
fi
case "$MODE" in
    run|--generate-baseline) : ;;
    *) err "unknown argument $MODE" ;;
esac

# ---------------------------------------------------------------------- run
[ -f "$MANIFEST" ] || err "no manifest at $MANIFEST; run $GENERATOR"
mkdir -p "$BUILD_DIR"

# The committed fixtures must be exactly what the generator produces.
regen="$BUILD_DIR/regen"
rm -rf "$regen"
set +e
sh "$GENERATOR" "$ROOT_DIR/$regen" >"$BUILD_DIR/regen.log" 2>&1
regen_rc=$?
set -e
[ "$regen_rc" -eq 0 ] || err "fixture generator failed, see $BUILD_DIR/regen.log"
for f in cells.tsv $(for p in $PAGES; do echo "$p.html"; done); do
    cmp -s "$regen/$f" "$FIX_DIR/$f" || err "committed $FIX_DIR/$f differs from the generator's output; rerun $GENERATOR"
done

if [ -z "${SIMPLE_BIN:-}" ]; then
    for b in bin/simple build/cargo-r2/release/simple bin/release/*/simple; do
        [ -x "$b" ] && { SIMPLE_BIN="$b"; break; }
    done
fi
[ -x "${SIMPLE_BIN:-}" ] || err "no simple binary; set SIMPLE_BIN"

set +e
CHROME="$(sh "$HARVESTER" --print-chrome 2>/dev/null)"
chrome_rc=$?
set -e
{ [ "$chrome_rc" -eq 0 ] && [ -x "$CHROME" ]; } || err "no Chrome found; set CHROME_BIN"
CHROME_VERSION="$("$CHROME" --version 2>/dev/null | sed -n 's/^[^0-9]*\([0-9][0-9.]*\).*$/\1/p' | head -n 1)"
chrome_major="${CHROME_VERSION%%.*}"
case "$chrome_major" in
    ''|*[!0-9]*) err "cannot read the version of $CHROME" ;;
esac
# An older Chrome has an older UA stylesheet; its numbers are not the oracle.
[ "$chrome_major" -ge "$MIN_CHROME_MAJOR" ] || \
    err "Chrome $CHROME_VERSION at $CHROME is older than $MIN_CHROME_MAJOR; set CHROME_BIN"

export SIMPLE_EXECUTION_MODE="${SIMPLE_EXECUTION_MODE:-interpreter}"
export SIMPLE_TIMEOUT_SECONDS="${SIMPLE_TIMEOUT_SECONDS:-0}"
# Same reason as the geometry differ: this is a correctness measurement, and a
# deadline-truncated layout is not a layout. A tripped budget is ERROR below.
export SIMPLE_WEB_RENDER_BUDGET_MS="${SIMPLE_WEB_RENDER_BUDGET_MS:-1800000}"

ROWS="$BUILD_DIR/rows.tsv"
: >"$ROWS"
for p in $PAGES; do
    src="$FIX_DIR/$p.html"
    cg="$BUILD_DIR/$p.chrome.geom"
    set +e
    GEOM_DIFF_WIDTH="$WIDTH" GEOM_DIFF_HEIGHT="$HEIGHT" \
    GEOM_DIFF_CHROME_EXTRA_FLAGS="--hide-scrollbars --force-device-scale-factor=1" \
    BUILD_DIR="$BUILD_DIR/harvest" CHROME_BIN="$CHROME" \
        sh "$HARVESTER" --harvest "$src" "$ROOT_DIR/$cg" >"$BUILD_DIR/$p.harvest.log" 2>&1
    h_rc=$?
    set -e
    [ "$h_rc" -eq 0 ] || err "Chrome harvest failed for $p, see $BUILD_DIR/$p.harvest.log"
    # Walker row: GEOM|path|tag|x|y|w|h|<features...>|rendered=<b>|id=<id>
    awk -F '|' -v page="$p" '{
        id = $NF; sub(/^id=/, "", id)
        r = $(NF - 1); sub(/^rendered=/, "", r)
        printf "C\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", page, $2, $3, $4, $5, $6, $7, r, id
    }' "$cg" >>"$ROWS"

    sg="$BUILD_DIR/$p.simple.geom"
    set +e
    "$SIMPLE_BIN" run "$GEOM_APP" simple-geom "$src" "$WIDTH" "$HEIGHT" >"$sg" 2>"$BUILD_DIR/$p.simple.err"
    s_rc=$?
    set -e
    [ "$s_rc" -eq 0 ] || err "Simple layout exited $s_rc for $p, see $BUILD_DIR/$p.simple.err"
    if grep -q 'budget-break' "$BUILD_DIR/$p.simple.err"; then
        err "Simple render of $p tripped its wall-clock render budget"
    fi
    s_boxes="$(sed -n 's/^simple_boxes=//p' "$sg" | tail -n 1)"
    case "$s_boxes" in
        ''|0|*[!0-9]*) err "Simple produced no boxes for $p" ;;
    esac
    awk -F '|' -v page="$p" '$1 == "GEOM" {
        printf "S\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", page, $2, $3, $4, $5, $6, $7
    }' "$sg" >>"$ROWS"
done

export CHROME_VERSION
MISM_FILE="$BUILD_DIR/mismatching_ids.txt"
: >"$MISM_FILE"
if [ "$MODE" = "--generate-baseline" ]; then
    : >"$BUILD_DIR/empty_baseline.txt"
    set +e
    MISM_FILE="$MISM_FILE" compare "$MANIFEST" "$BUILD_DIR/empty_baseline.txt" "$ROWS" >"$BUILD_DIR/report.txt"
    g_rc=$?
    set -e
    [ "$g_rc" -ne 2 ] || { tail -n 1 "$BUILD_DIR/report.txt"; exit 2; }
    {
        echo "# Element ids of the web combination matrix that mismatch Chrome today."
        echo "# One id per line, LC_ALL=C sorted. A row leaves this file in the same"
        echo "# change as the fix that makes it match; never add a row to hide a regression."
        LC_ALL=C sort "$MISM_FILE"
    } >"$BASELINE"
    echo "baseline written: $BASELINE ($(grep -vc '^#' "$BASELINE") id(s))"
fi
set +e
MISM_FILE="$MISM_FILE" compare "$MANIFEST" "$BASELINE" "$ROWS" >"$BUILD_DIR/report.txt"
rc=$?
set -e
cat "$BUILD_DIR/report.txt"
exit "$rc"
