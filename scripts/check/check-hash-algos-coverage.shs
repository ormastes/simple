#!/bin/sh
# Fail-closed 100% decision + condition coverage gate for the hash/signature
# algorithms the bootstrap compiler, the content-addressed caches and SCV rely
# on (SHA-1/256/512, XXH3, BLAKE3, Ed25519, djb2).
#
# Coverage comes from the interpreter (SIMPLE_EXECUTION_MODE=interpreter,
# SIMPLE_COVERAGE=1) running each driving spec with `run <spec>`; every run's
# artifact is merged and filtered to the scope files below. The interpreter
# enumerates every decision/condition site of each loaded file statically, so
# a site that never runs is in the denominator (see
# doc/07_guide/infra/testing/coverage.md "Decision and condition semantics").
#
#   decision  = if / elif / while (incl. the `val` pattern forms), match-arm
#               guard, if-expression, standalone `and`/`or`; covered when it
#               evaluated both true and false.
#   condition = each atomic operand of an `and`/`or` tree; covered when it
#               evaluated both true and false.
#
# Usage:
#   sh scripts/check/check-hash-algos-coverage.shs [--bin <simple>] [--report]
#   sh scripts/check/check-hash-algos-coverage.shs --selftest [--bin <simple>]
#
#   --bin <path>  interpreter binary (default: $SIMPLE_COV_BIN, else bin/simple)
#   --report      also list every uncovered decision/condition row
#   --selftest    run only the fixtures (they also run before every scan)
#   HASH_COV_SPECS=<paths>  replace the driving spec list
#   HASH_COV_SCOPE=<paths>  replace the scope file list (measurement only)
#
# Verdict is always the LAST line of stdout:
#   PASS — <n> files checked, 100% decision and condition (<d> decisions, <c> conditions, <x> justified exclusion(s))
#   FAIL — <n> files checked, <m> below 100%: <names>
#   ERROR — nothing was checked
# Exit codes: 0 PASS, 1 FAIL, 2 ERROR. Not wired into the push tier.

SELF="check-hash-algos-coverage"

err() {
    echo "$SELF: ERROR — $*" >&2
    echo "ERROR — nothing was checked"
    exit 2
}

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || err "not inside a git working tree"
cd "$toplevel" || err "cannot cd to $toplevel"
[ -e "$toplevel/.git" ] || err "no .git at repo toplevel — refusing to check an archive worktree"

BIN="${SIMPLE_COV_BIN:-$toplevel/bin/simple}"
REPORT=0
SELFTEST_ONLY=0
while [ $# -gt 0 ]; do
    case "$1" in
        --bin) shift; BIN="$1" ;;
        --bin=*) BIN="${1#--bin=}" ;;
        --report) REPORT=1 ;;
        --selftest) SELFTEST_ONLY=1 ;;
        *) err "unknown argument: $1" ;;
    esac
    shift
done
[ -x "$BIN" ] || err "interpreter binary not executable: $BIN"

# Scope: the algorithm files. std.crypto.sha256 (src/lib/crypto/sha256.spl) is
# a pure `export use` re-export with no decision sites; it resolves to
# src/lib/common/crypto/sha256.spl, which is listed.
SCOPE="${HASH_COV_SCOPE:-
src/lib/common/crypto/sha256.spl
src/lib/common/crypto/sha256_core.spl
src/lib/common/crypto/sha1.spl
src/lib/common/crypto/sha512.spl
src/lib/common/crypto/xxh3.spl
src/lib/common/crypto/blake3.spl
src/lib/common/crypto/ed25519.spl
src/lib/common/crypto/ed25519_field.spl
src/lib/common/crypto/ed25519_scalar.spl
src/lib/common/hash/djb2.spl
}"

# Specs that drive the scope. Each must pass. HASH_COV_SPECS (whitespace-
# separated paths) replaces the list, e.g. to measure a baseline.
SPECS="${HASH_COV_SPECS:-
test/01_unit/lib/common/crypto/sha256_core_vectors_spec.spl
test/01_unit/lib/common/crypto/sha256_boundary_vectors_spec.spl
test/01_unit/lib/common/crypto/sha1_sha512_boundary_vectors_spec.spl
test/01_unit/lib/common/crypto/xxh3_kat_spec.spl
test/01_unit/lib/common/crypto/xxh3_reference_vectors_spec.spl
test/01_unit/lib/common/crypto/blake3_kat_spec.spl
test/01_unit/lib/common/crypto/ed25519_strict_verify_spec.spl
test/01_unit/lib/common/crypto/ed25519_rfc8032_vectors_negatives_spec.spl
test/01_unit/lib/common/hash/djb2_spec.spl
}"

# Justified exclusions: sites that cannot take both outcomes under the
# interpreter on this host. Key: <file>:<line>:D (decision) or
# <file>:<line>:C<n> (condition n of the decision on that line). An excluded
# row must still exist and still be uncovered; otherwise the exclusion is
# stale and the gate FAILs. Never add a row to raise a number -- each needs a
# reason that holds for every input the public API accepts.
EXCLUDE="
src/lib/common/crypto/sha256.spl:236:D accelerator: rt_tls13_sha256 always returns 32 bytes on a hosted runtime; the pure fallback is only taken where the extern is absent
src/lib/common/crypto/sha256.spl:404:C1 volatile wipe: the interpreter cannot address boxed arrays (rt_array_data_ptr == 0) so the wipe never verifies; native codegen always verifies
src/lib/common/crypto/sha256.spl:404:C2 volatile wipe: short-circuited behind C1 (always true under the interpreter)
src/lib/common/crypto/sha256.spl:415:D volatile wipe: zeroizing digest is nil under the interpreter (wipe unverifiable), a 64-char digest natively
src/lib/common/crypto/sha256.spl:570:D volatile wipe: Sha256StreamV1.zeroize() reports unverified under the interpreter, verified natively
src/lib/common/crypto/sha256.spl:570:C0 volatile wipe: as 570:D, state_report.verified() is false under the interpreter
src/lib/common/crypto/sha256.spl:570:C1 volatile wipe: short-circuited behind C0
src/lib/common/crypto/sha256.spl:570:C2 volatile wipe: short-circuited behind C0
src/lib/common/crypto/ed25519.spl:700:D self-test failure arm: true only if keypair derivation disagrees with RFC 8032 TEST 1
src/lib/common/crypto/ed25519.spl:704:D self-test failure arm: true only if signing disagrees with RFC 8032 TEST 1
src/lib/common/crypto/ed25519.spl:707:D self-test failure arm: true only if verify rejects the RFC 8032 TEST 1 signature
src/lib/common/crypto/ed25519.spl:716:D self-test failure arm: true only if verify accepts a corrupted signature
src/lib/common/crypto/ed25519.spl:746:D self-test failure arm: true only if keypair derivation disagrees with RFC 8032 TEST 2
src/lib/common/crypto/ed25519.spl:750:D self-test failure arm: true only if signing disagrees with RFC 8032 TEST 2
src/lib/common/crypto/ed25519.spl:753:D self-test failure arm: true only if verify rejects the RFC 8032 TEST 2 signature
"

WORK=$(mktemp -d "${TMPDIR:-/tmp}/$SELF.XXXXXX") || err "mktemp failed"
trap 'rm -rf "$WORK"' EXIT INT TERM

# Run the interpreter with coverage on. Bounded: wall-clock timeout, and a
# memory-capped scope when a user systemd is available.
cov_run() {
    # $1 = artifact path, $2 = source file
    if systemd-run --user --scope -q -p MemoryMax=6G -p MemorySwapMax=0 true >/dev/null 2>&1; then
        SIMPLE_EXECUTION_MODE=interpreter SIMPLE_COVERAGE=1 SIMPLE_COVERAGE_OUTPUT="$1" \
            systemd-run --user --scope -q -p MemoryMax=6G -p MemorySwapMax=0 \
            timeout "${COV_TIMEOUT:-1200}" "$BIN" run "$2" >"$1.log" 2>&1
    else
        SIMPLE_EXECUTION_MODE=interpreter SIMPLE_COVERAGE=1 SIMPLE_COVERAGE_OUTPUT="$1" \
            timeout "${COV_TIMEOUT:-1200}" "$BIN" run "$2" >"$1.log" 2>&1
    fi
}

# Merge decision/condition rows of every artifact given on stdin-listed paths
# and print one summary line per file:
#   F <file> <dec_total> <dec_covered> <cond_total> <cond_covered>
# and, for uncovered rows:
#   UD <file>:<line> id=<id> true=<t> false=<f>
#   UC <file>:<line> decision=<id> condition=<cid> true=<t> false=<f>
merge_artifacts() {
    awk '
    FNR == 1 { section = "" }
    /^decisions \|/ { section = "d"; next }
    /^conditions \|/ { section = "c"; next }
    /^[^ ]/ { section = ""; next }
    /^$/ { section = ""; next }
    section == "d" {
        n = split($0, p, ", ")
        if (n < 6) next
        gsub(/^ +/, "", p[1])
        k = p[1] SUBSEP p[2] SUBSEP p[3] SUBSEP p[4]
        dt[k] += p[5]; df[k] += p[6]; dfile[k] = p[2]; dline[k] = p[3]; did[k] = p[1]
        next
    }
    section == "c" {
        n = split($0, p, ", ")
        if (n < 7) next
        gsub(/^ +/, "", p[1])
        k = p[1] SUBSEP p[2] SUBSEP p[3] SUBSEP p[4] SUBSEP p[5]
        ct[k] += p[6]; cf[k] += p[7]; cfile[k] = p[3]; cline[k] = p[4]; cdid[k] = p[1]; ccid[k] = p[2]
        next
    }
    END {
        for (k in dt) {
            f = dfile[k]; files[f] = 1; DT[f]++
            if (dt[k] > 0 && df[k] > 0) DC[f]++
            else printf "UD %s:%s id=%s true=%d false=%d\n", f, dline[k], did[k], dt[k], df[k]
        }
        for (k in ct) {
            f = cfile[k]; files[f] = 1; CT[f]++
            if (ct[k] > 0 && cf[k] > 0) CC[f]++
            else printf "UC %s:%s decision=%s condition=%s true=%d false=%d\n", f, cline[k], cdid[k], ccid[k], ct[k], cf[k]
        }
        for (f in files) printf "F %s %d %d %d %d\n", f, DT[f], DC[f] + 0, CT[f] + 0, CC[f] + 0
    }' "$@"
}

# ---------------------------------------------------------------- selftest --
# Fixed fixture with a hand-counted denominator. Fatal: a tool that cannot
# reproduce these exact numbers cannot gate anything.
selftest() {
    st="$WORK/selftest"
    mkdir -p "$st" || return 1
    cat >"$st/cov_fixture.spl" <<'FIXTURE_EOF'
fn both(n: i64, m: i64) -> text:
    if n > 0 and m > 0:
        return "both"
    if n == 99:
        return "x"
    elif n < 0 or m < 0:
        return "neg"
    return "other"

fn never_called(n: i64) -> i64:
    if n > 5:
        return 1
    return 0

fn pick(n: i64) -> i64:
    val v = if n > 0: 1 else: 2
    var i = 0
    while i < n:
        i = i + 1
    return v + i

fn flag(a: bool, b: bool) -> bool:
    return a and b

fn guarded(n: i64) -> i64:
    match n:
        case 1 if n > 0:
            return 10
        case _:
            return 20

print(both(1, 1))
print(both(-1, 1))
print(both(1, -1))
print(both(0, 0))
print(pick(1))
print(pick(0))
print(flag(true, false))
print(flag(false, true))
print(guarded(1))
print(guarded(2))
FIXTURE_EOF
    cov_run "$st/a.sdn" "$st/cov_fixture.spl"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        echo "$SELF: selftest fixture run exited $rc" >&2
        tail -5 "$st/a.sdn.log" >&2
        return 1
    fi
    got=$(merge_artifacts "$st/a.sdn" | awk '$1 == "F" && $2 ~ /cov_fixture\.spl$/ { print $3, $4, $5, $6 }')
    # Decisions: if(and) / if / elif(or) / uncalled if / if-expr / while /
    # standalone and / guard = 8; covered: and-if, elif, if-expr, while = 4.
    # Conditions: 2 + 2 + 2 = 6; only `b` of `a and b` is one-sided = 5.
    if [ "$got" != "8 4 6 5" ]; then
        echo "$SELF: selftest fixture: expected 'decisions 8 4 conditions 6 5', got '$got'" >&2
        return 1
    fi
    # Second run of the same file: merge must add counts, not duplicate rows.
    cov_run "$st/b.sdn" "$st/cov_fixture.spl" || return 1
    got2=$(merge_artifacts "$st/a.sdn" "$st/b.sdn" | awk '$1 == "F" && $2 ~ /cov_fixture\.spl$/ { print $3, $4, $5, $6 }')
    if [ "$got2" != "8 4 6 5" ]; then
        echo "$SELF: selftest merge of two runs: expected '8 4 6 5', got '$got2'" >&2
        return 1
    fi
    # The never-called function's decision must be listed as uncovered at
    # its own line with zero counts (the denominator defect).
    if ! merge_artifacts "$st/a.sdn" | grep -q "^UD .*cov_fixture\.spl:11 .* true=0 false=0$"; then
        echo "$SELF: selftest: uncalled decision at line 11 not reported uncovered" >&2
        return 1
    fi
    # An empty artifact set must produce no file rows (so the caller ERRORs).
    : >"$st/empty.sdn"
    if [ -n "$(merge_artifacts "$st/empty.sdn")" ]; then
        echo "$SELF: selftest: empty artifact produced rows" >&2
        return 1
    fi
    return 0
}

selftest || {
    echo "FAIL — selftest failed; coverage numbers from $BIN cannot be trusted"
    exit 1
}
if [ "$SELFTEST_ONLY" -eq 1 ]; then
    echo "PASS — selftest: 4 fixture checks passed on $BIN"
    exit 0
fi

# -------------------------------------------------------------------- scan --
n=0
spec_fail=""
artifacts=""
for spec in $SPECS; do
    [ -f "$spec" ] || err "driving spec missing: $spec"
    n=$((n + 1))
    out="$WORK/run$n.sdn"
    cov_run "$out" "$spec"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        spec_fail="$spec_fail $spec(rc=$rc)"
        continue
    fi
    [ -s "$out" ] || err "no coverage artifact written for $spec"
    artifacts="$artifacts $out"
done
[ -n "$artifacts" ] || err "no spec produced a coverage artifact"

# shellcheck disable=SC2086
merge_artifacts $artifacts >"$WORK/merged.txt"

# Uncovered rows as exclusion keys: "<rel>:<line>:D" / "<rel>:<line>:C<n>".
sed -n -e "s#^UD $toplevel/\([^ ]*\) .*#\1:D#p" \
       -e "s#^UC $toplevel/\([^ ]*\) decision=[0-9]* condition=\([0-9]*\) .*#\1:C\2#p" \
       "$WORK/merged.txt" | sort -u >"$WORK/uncovered.txt"
# Only exclusions of files in scope are live (and can be stale).
echo "$SCOPE" | awk 'NF { print $1 ":" }' >"$WORK/scope_prefixes.txt"
echo "$EXCLUDE" | awk 'NF { print $1 }' | grep -F -f "$WORK/scope_prefixes.txt" | sort -u >"$WORK/excluded.txt"
stale=$(comm -13 "$WORK/uncovered.txt" "$WORK/excluded.txt" | tr '\n' ' ')

checked=0
below=""
total_d=0
total_c=0
total_x=0
printf '%-48s %14s %14s\n' "file" "decisions" "conditions"
for rel in $SCOPE; do
    [ -f "$rel" ] || err "scope file missing: $rel"
    abs="$toplevel/$rel"
    row=$(awk -v f="$abs" '$1 == "F" && $2 == f { print $3, $4, $5, $6 }' "$WORK/merged.txt")
    checked=$((checked + 1))
    if [ -z "$row" ]; then
        printf '%-48s %14s %14s\n' "$rel" "not loaded" "-"
        below="$below $rel(not-loaded)"
        continue
    fi
    set -- $row
    printf '%-48s %8s/%-5s %8s/%-5s\n' "$rel" "$2" "$1" "$4" "$3"
    total_d=$((total_d + $1))
    total_c=$((total_c + $3))
    # Uncovered rows of this file that are not justified exclusions.
    open_rows=$(grep "^$rel:" "$WORK/uncovered.txt" | comm -23 - "$WORK/excluded.txt" | wc -l)
    x_rows=$(grep "^$rel:" "$WORK/uncovered.txt" | comm -12 - "$WORK/excluded.txt" | wc -l)
    total_x=$((total_x + x_rows))
    if [ "$1" -eq 0 ] || [ "$open_rows" -ne 0 ]; then
        below="$below $rel"
    fi
    if [ "$REPORT" -eq 1 ]; then
        grep -E "^U[DC] $abs:" "$WORK/merged.txt" | sed "s#$toplevel/##" | sort -t: -k2 -n
        [ "$x_rows" -gt 0 ] && echo "   ($x_rows uncovered row(s) above are justified exclusions)"
    fi
done

[ "$checked" -gt 0 ] || err "no scope file was checked"
if [ -n "$spec_fail" ]; then
    echo "FAIL — $checked files checked, driving spec(s) failed:$spec_fail"
    exit 1
fi
if [ -n "$stale" ]; then
    echo "FAIL — $checked files checked, stale exclusion(s) (covered or no longer present): $stale"
    exit 1
fi
if [ -n "$below" ]; then
    count=$(echo "$below" | wc -w)
    echo "FAIL — $checked files checked, $count below 100%:$below"
    exit 1
fi
echo "PASS — $checked files checked, 100% decision and condition ($total_d decisions, $total_c conditions, $total_x justified exclusion(s))"
exit 0
