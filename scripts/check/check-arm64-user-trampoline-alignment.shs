#!/bin/sh
set -eu

src=examples/09_embedded/simple_os/arch/arm64/boot/crt0.S
csrc=examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c

awk '
    /\.balign 4/ { aligned=NR }
    /\.globl arm64_enter_user_virtual/ {
        if (aligned != NR - 1) exit 1
        found=1
    }
    END { if (!found) exit 1 }
' "$src" || {
    echo 'FAIL: arm64_enter_user_virtual lacks immediately preceding .balign 4' >&2
    exit 1
}

body=$(awk '/^arm64_enter_user_virtual:/{inside=1} inside{print} /^[[:space:]]*\.size arm64_enter_user_virtual/{exit}' "$src")
printf '%s\n' "$body" | grep -Eq '^[[:space:]]*mov[[:space:]]+x0,[[:space:]]*x5' || {
    echo 'FAIL: trampoline does not preload user arg0 from x5' >&2; exit 1;
}
printf '%s\n' "$body" | grep -Eq '^[[:space:]]*mov[[:space:]]+x1,[[:space:]]*x6' || {
    echo 'FAIL: trampoline does not preload user arg1 from x6' >&2; exit 1;
}
if printf '%s\n' "$body" | grep -Eq 'arm64_user_entry_arg|ldp[[:space:]]+x0,[[:space:]]*x1'; then
    echo 'FAIL: trampoline retains a post-TTBR global argument load' >&2; exit 1
fi
grep -Fq 'uint64_t tcr, uint64_t user_arg0,' "$csrc" || {
    echo 'FAIL: C declaration lacks seven-register handoff ABI' >&2; exit 1;
}
grep -Fq 'arm64_user_entry_arg0, arm64_user_entry_arg1);' "$csrc" || {
    echo 'FAIL: C caller does not preload both user arguments' >&2; exit 1;
}

if [ "$#" -gt 0 ]; then
    elf=$1
    [ -f "$elf" ] || { echo "FAIL: missing ELF: $elf" >&2; exit 1; }
    symbol=$(llvm-nm -n "$elf" | awk '$3 == "arm64_enter_user_virtual" {print $1; exit}')
    [ -n "$symbol" ] || { echo 'FAIL: trampoline symbol absent' >&2; exit 1; }
    address=$((0x$symbol))
    [ $((address % 4)) -eq 0 ] || {
        echo "FAIL: trampoline symbol is not 4-byte aligned: 0x$symbol" >&2
        exit 1
    }
    target=$(llvm-objdump -d "$elf" | awk '
        /<rt_arm64_enter_recorded_user_live>:/ {inside=1; next}
        inside && /^$/ {inside=0}
        inside && /bl[[:space:]]+0x[0-9a-f]+ <arm64_enter_user_virtual>/ {
            for (i=1; i<=NF; i++) if ($i ~ /^0x[0-9a-f]+$/) {print substr($i,3); exit}
        }
    ')
    [ "$target" = "$(printf '%x' "$address")" ] || {
        echo "FAIL: caller target 0x${target:-missing} differs from trampoline 0x$symbol" >&2
        exit 1
    }
    linked_body=$(llvm-objdump -d "$elf" | awk '
        /<arm64_enter_user_virtual>:/ {inside=1}
        inside {print}
        inside && /eret/ {exit}
    ')
    printf '%s\n' "$linked_body" | grep -Eq 'mov[[:space:]]+x0, x5' || {
        echo 'FAIL: linked trampoline lacks x5 to x0 preload' >&2; exit 1;
    }
    printf '%s\n' "$linked_body" | grep -Eq 'mov[[:space:]]+x1, x6' || {
        echo 'FAIL: linked trampoline lacks x6 to x1 preload' >&2; exit 1;
    }
    if printf '%s\n' "$linked_body" | grep -Eq 'ldp[[:space:]]+x0, x1|adrp'; then
        echo 'FAIL: linked trampoline retains a post-switch memory dependency' >&2
        exit 1
    fi
fi

echo 'PASS: ARM64 user trampoline source and call target are exactly aligned'
