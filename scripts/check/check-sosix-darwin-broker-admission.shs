#!/bin/sh
# Direct-child admission evidence. No disjoint coalition or generic V4 claim.
set -eu
if [ "$(uname -s)" != Darwin ]; then
    echo 'SKIP: Darwin broker admission requires macOS'
    exit 77
fi
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
scratch=$(mktemp -d /tmp/sosix-admission.XXXXXXXX)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
"${CC:-cc}" -std=c11 -Wall -Wextra -Werror -Wno-deprecated-declarations -Wno-unused-function \
    "$root/src/runtime/sosix_darwin_broker_helper.c" \
    "$root/src/runtime/test/rt_sosix_darwin_broker_premain_selfcheck.c" -o "$scratch/helper"
"${CC:-cc}" -std=c11 -Wall -Wextra -Werror -Wno-deprecated-declarations -Wno-unused-function \
    "$root/src/runtime/test/rt_sosix_darwin_broker_admission_selfcheck.c" -o "$scratch/check"
"${CC:-cc}" -dynamiclib "$root/src/runtime/test/rt_sosix_darwin_broker_injection_selfcheck.c" -o "$scratch/inject.dylib"
# RED control: an ordinary unbound startup executes the injected constructor
# before the canonical helper can inspect or reject its environment in main.
if env DYLD_INSERT_LIBRARIES="$scratch/inject.dylib" SOSIX_INJECTION_MARKER="$scratch/injected" "$scratch/helper"; then
    echo 'FAIL: hostile ordinary startup unexpectedly succeeded' >&2
    exit 1
fi
test -f "$scratch/injected"
rm "$scratch/injected"
echo 'unbound_dyld_constructor_control: executes_before_main'
"$scratch/check" "$scratch/helper" "$scratch" "$scratch/leaked-fd" "$scratch/inject.dylib"
