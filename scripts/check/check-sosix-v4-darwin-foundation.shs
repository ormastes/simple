#!/bin/sh
# Native runtime foundation only; this does not certify the Simple facade or V4 launch.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
if [ "$(uname -s)" != Darwin ]; then
    echo 'SOSIX V4 Darwin foundation: SKIP (requires macOS)'
    exit 77
fi
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/sosix-v4-darwin.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
${CC:-cc} -std=c11 -O0 -pthread "$root/src/runtime/test/runtime_process_observation_v4_darwin_selfcheck.c" -o "$tmp_dir/selfcheck"
"$tmp_dir/selfcheck"
