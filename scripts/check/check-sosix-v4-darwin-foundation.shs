#!/bin/sh
# Native Darwin observation V4 owner: cwd pins and refusal surface, the live
# START_SUSPENDED owner, and the real snapshot executable pin. This does not
# certify the Simple facade; the hello BuildRunner lane does that.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
if [ "$(uname -s)" != Darwin ]; then
    echo 'SOSIX V4 Darwin foundation: SKIP (requires macOS)'
    exit 77
fi
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/sosix-v4-darwin.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
: "${MACOSX_DEPLOYMENT_TARGET:=14.0}"
export MACOSX_DEPLOYMENT_TARGET
for check in runtime_process_observation_v4_darwin_selfcheck \
             runtime_process_observation_v4_darwin_interrupted_wait_selfcheck \
             runtime_process_observation_v4_darwin_live_selfcheck \
             runtime_process_darwin_pin_selfcheck; do
    ${CC:-cc} -std=c11 -O0 -Wall -Wextra -Werror -pthread \
        "$root/src/runtime/test/$check.c" "$root/src/runtime/runtime_process_tree.c" \
        -o "$tmp_dir/$check"
    (cd "$tmp_dir" && "./$check")
done
