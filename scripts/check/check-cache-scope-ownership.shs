#!/bin/sh
# check-cache-scope-ownership.shs — fail-closed guard: refuse to reuse a native
# build cache directory that was last written by a DIFFERENT lane.
#
# Concurrent bootstrap lanes (phase-1 seed, phase-2 stage, phase-3 self-host,
# phase-4 full CLI, census, tool builds) may run different compiler binaries over
# the same source tree. Sharing one native_cache lets a phase-2 entry be picked up
# by a phase-3 lane. Each lane now owns build/bootstrap/native_cache/<lane>/, and
# each cache dir records its owner in a `.cache_scope` marker (written both by
# this script and by the compilers themselves — see
# src/compiler_rust/compiler/src/pipeline/native_project/mod.rs `write_cache_scope_marker`
# and src/compiler/80.driver/driver_aot_native_output.spl).
#
# Policy on mismatch: REFUSE (exit 1) naming both scopes. A silent switch to the
# correct dir would hide the script bug that pointed the lane at a foreign cache.
#
# Usage:
#   check-cache-scope-ownership.shs <cache-dir> <lane>
#   check-cache-scope-ownership.shs --selftest
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> marker(s) checked, ...        exit 0
#   FAIL  — ...                               exit 1
#   ERROR — nothing was checked               exit 2
set -u

marker_of() { printf '%s/.cache_scope' "$1"; }

# Check one dir; echoes nothing, returns 0 ok / 1 mismatch / 2 unusable args.
scope_check_one() {
  sco_dir=$1
  sco_lane=$2
  [ -n "${sco_dir}" ] || return 2
  [ -n "${sco_lane}" ] || return 2
  sco_marker=$(marker_of "${sco_dir}")
  if [ ! -f "${sco_marker}" ]; then
    # Unowned or brand-new cache: claim it. An empty dir cannot poison anything.
    mkdir -p "${sco_dir}" 2>/dev/null || return 2
    printf 'lane=%s\n' "${sco_lane}" > "${sco_marker}" 2>/dev/null || return 2
    return 0
  fi
  sco_owner=$(sed -n 's/^lane=//p' "${sco_marker}" 2>/dev/null | head -1)
  [ -n "${sco_owner}" ] || return 1
  [ "${sco_owner}" = "${sco_lane}" ] || return 1
  return 0
}

selftest() {
  st_root=$(mktemp -d) || { echo "ERROR — nothing was checked"; exit 2; }
  st_fail=0

  # 1. fresh dir is claimed and passes
  scope_check_one "${st_root}/a" "stage2" || st_fail=1
  [ -f "${st_root}/a/.cache_scope" ] || st_fail=1

  # 2. same lane re-uses the same dir (in-scope reuse)
  scope_check_one "${st_root}/a" "stage2" || st_fail=1

  # 3. different lane on the SAME dir is refused (cross-scope MISS)
  if scope_check_one "${st_root}/a" "stage3"; then st_fail=1; fi

  # 4. a corrupt/empty marker is refused, not treated as unowned
  : > "${st_root}/a/.cache_scope"
  if scope_check_one "${st_root}/a" "stage2"; then st_fail=1; fi

  # 5. missing arguments are an error, never a pass
  scope_check_one "" "stage2"; [ $? -eq 2 ] || st_fail=1
  scope_check_one "${st_root}/b" ""; [ $? -eq 2 ] || st_fail=1

  rm -rf "${st_root}"
  if [ "${st_fail}" -ne 0 ]; then
    echo "FAIL — selftest fixtures did not behave as specified"
    exit 1
  fi
  return 0
}

if [ "${1:-}" = "--selftest" ]; then
  selftest
  echo "PASS — 6 selftest fixture(s) checked, cache-scope ownership logic correct"
  exit 0
fi

selftest || exit 1

cache_dir=${1:-}
lane=${2:-}
if [ -z "${cache_dir}" ] || [ -z "${lane}" ]; then
  echo "usage: check-cache-scope-ownership.shs <cache-dir> <lane>" >&2
  echo "ERROR — nothing was checked"
  exit 2
fi

scope_check_one "${cache_dir}" "${lane}"
rc=$?
if [ "${rc}" -eq 2 ]; then
  echo "ERROR — nothing was checked"
  exit 2
fi
if [ "${rc}" -ne 0 ]; then
  owner=$(sed -n 's/^lane=//p' "$(marker_of "${cache_dir}")" 2>/dev/null | head -1)
  [ -n "${owner}" ] || owner="<unreadable>"
  echo "FAIL — 1 marker checked: ${cache_dir} is owned by lane '${owner}', requested lane '${lane}'; refusing to reuse another lane's cache"
  exit 1
fi
echo "PASS — 1 marker checked, ${cache_dir} owned by lane '${lane}'"
exit 0
