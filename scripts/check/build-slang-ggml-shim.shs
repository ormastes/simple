#!/bin/sh
# Builds the slang ggml backend shim into build/sffi/libslang_ggml.so
# (build/sffi/slang_ggml.dll on Windows).
#
# Not part of the main runtime link: the shim needs llama.h, an external SDK
# header that is deliberately not vendored (CLAUDE.md Owned-Code Scope). The
# C-runtime gate therefore classifies slang_ggml_shim.c as SKIP, not as a
# compile failure -- same treatment as scv_wasm_shim.c.
#
# LLAMA_ROOT must point at a built llama.cpp checkout (one holding
# include/llama.h and build/bin/libllama.so). It stays outside this repo.
#
# Verdict is the last line of stdout, same convention as scripts/check/*:
#   PASS  -- <n> symbol(s) exported, <path>        exit 0
#   FAIL  -- <reason>                              exit 1
#   ERROR -- nothing was built (<reason>)          exit 2
#
# Windows (MSYS/Git Bash), default lane = llvm-mingw UCRT (toolchain policy:
# never GCC, never cl). LLAMA_ROOT must be set (no Linux default applies); the
# build dir defaults to $LLAMA_ROOT/build-mingw when it holds bin/libllama.dll,
# else $LLAMA_ROOT/build. Needs a llama.cpp built with llvm-mingw and
# BUILD_SHARED_LIBS=ON: bin/libllama.dll plus the import library
# src/libllama.dll.a (LLAMA_IMPLIB overrides). The compiler is CC, else
# $SIMPLE_MINGW_ROOT/bin/clang, else the newest repo-managed
# ~/.simple/toolchains/llvm-mingw-*-ucrt-x86_64; a bare `clang` on PATH may be
# an MSVC-target clang (e.g. ROCm's), so the target is checked with
# -dumpmachine. libllama.dll, ggml*.dll and the mingw runtime DLLs
# (libc++.dll, libunwind.dll, libwinpthread-1.dll) are copied next to the shim.
# Note the DLL naming trap: mingw builds produce libllama.dll, MSVC llama.dll.
#
# Optional MSVC lane (SLANG_SHIM_MSVC=1): clang-cl + lld-link. Needs the MSVC/SDK env
# (`. scripts/setup/windows-msvc-bootstrap-env.shs`) and a llama.cpp built
# with BUILD_SHARED_LIBS=ON, i.e. build/bin/llama.dll plus the import library
# build/src/llama.lib (LLAMA_IMPLIB overrides). Exports come from a .def
# generated from the COMPILED object, so functions behind a disabled #if never
# reach the export table. llama.dll and ggml*.dll are copied next to the shim:
# Windows does not search a DLL's own directory for its imports, and the slang
# loader (backend.spl) preloads those siblings before opening the shim.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
OUT_DIR=${SLANG_SHIM_OUT_DIR:-$ROOT/build/sffi}
SRC=$ROOT/src/runtime/slang_ggml_shim.c

case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) IS_WINDOWS=1 ;;
    *) IS_WINDOWS=0 ;;
esac
WIN_MSVC=0
if [ "$IS_WINDOWS" -eq 1 ] && [ "${SLANG_SHIM_MSVC:-0}" = 1 ]; then
    WIN_MSVC=1
fi

if [ "$IS_WINDOWS" -eq 1 ]; then
    [ -n "${LLAMA_ROOT:-}" ] || { echo "ERROR -- nothing was built (LLAMA_ROOT is not set)"; exit 2; }
    if [ "$WIN_MSVC" -eq 0 ] && [ -z "${LLAMA_BUILD_DIR:-}" ] && [ -f "$LLAMA_ROOT/build-mingw/bin/libllama.dll" ]; then
        LLAMA_BUILD_DIR=$LLAMA_ROOT/build-mingw
    fi
else
    LLAMA_ROOT=${LLAMA_ROOT:-/home/yoon/dev/llama.cpp}
fi
LLAMA_BUILD_DIR=${LLAMA_BUILD_DIR:-$LLAMA_ROOT/build}

if [ "$WIN_MSVC" -eq 1 ]; then
    OUT=$OUT_DIR/slang_ggml.dll
    LLAMA_LIB=$LLAMA_BUILD_DIR/bin/llama.dll
    LLAMA_IMPLIB=${LLAMA_IMPLIB:-$LLAMA_BUILD_DIR/src/llama.lib}
elif [ "$IS_WINDOWS" -eq 1 ]; then
    OUT=$OUT_DIR/slang_ggml.dll
    LLAMA_LIB=$LLAMA_BUILD_DIR/bin/libllama.dll
    LLAMA_IMPLIB=${LLAMA_IMPLIB:-$LLAMA_BUILD_DIR/src/libllama.dll.a}
    if [ -z "${CC:-}" ]; then
        if [ -n "${SIMPLE_MINGW_ROOT:-}" ] && [ -x "$SIMPLE_MINGW_ROOT/bin/clang.exe" ]; then
            CC=$SIMPLE_MINGW_ROOT/bin/clang.exe
        else
            for cand in $(ls -d "$HOME"/.simple/toolchains/llvm-mingw-*-ucrt-x86_64/bin 2>/dev/null | sort -r); do
                CC=$cand/clang.exe
                break
            done
        fi
    fi
    CC=${CC:-clang}
    command -v "$CC" >/dev/null 2>&1 || { echo "ERROR -- nothing was built (no llvm-mingw clang: $CC)"; exit 2; }
    MINGW_BIN=$(CDPATH= cd -- "$(dirname "$(command -v "$CC")")" && pwd -P)
    case "$("$CC" -dumpmachine 2>/dev/null)" in
        *-w64-mingw32*|*-windows-gnu*) ;;
        *) echo "ERROR -- nothing was built ($CC does not target mingw; set SIMPLE_MINGW_ROOT or CC to llvm-mingw clang)"; exit 2 ;;
    esac
    READOBJ=$MINGW_BIN/llvm-readobj.exe
    MINGW_RT_DIR=$MINGW_BIN/../x86_64-w64-mingw32/bin
else
    OUT=$OUT_DIR/libslang_ggml.so
    LLAMA_LIB=$LLAMA_BUILD_DIR/bin/libllama.so
fi

# Defined exports of a shared library, normalised to nm's "<addr> T <name>"
# shape so the required-symbol checks below are shared across platforms.
list_exports() {
    if [ "$IS_WINDOWS" -eq 1 ]; then
        "${READOBJ:-llvm-readobj}" --coff-exports "$1" 2>/dev/null | sed -n 's/^ *Name: \(.*\)$/0 T \1/p'
    else
        nm -D --defined-only "$1" 2>/dev/null
    fi
}

# Every precondition is ERROR, never PASS: absence of a toolchain or of the
# external SDK is absence of evidence, not evidence of success.
[ -f "$SRC" ] || { echo "ERROR -- nothing was built (missing $SRC)"; exit 2; }
[ -f "$LLAMA_ROOT/include/llama.h" ] || { echo "ERROR -- nothing was built (no llama.h under LLAMA_ROOT=$LLAMA_ROOT)"; exit 2; }
[ -f "$LLAMA_LIB" ] || { echo "ERROR -- nothing was built (no $(basename "$LLAMA_LIB") under $LLAMA_BUILD_DIR/bin)"; exit 2; }

mkdir -p "$OUT_DIR"

if [ "$IS_WINDOWS" -eq 1 ] && [ "$WIN_MSVC" -eq 0 ]; then
    [ -f "$LLAMA_IMPLIB" ] || { echo "ERROR -- nothing was built (no import library $LLAMA_IMPLIB)"; exit 2; }
    [ -x "$READOBJ" ] || { echo "ERROR -- nothing was built (missing tool: $READOBJ)"; exit 2; }
    for rt in libwinpthread-1.dll libunwind.dll libc++.dll; do
        [ -f "$MINGW_RT_DIR/$rt" ] || { echo "ERROR -- nothing was built (no mingw runtime $rt under $MINGW_RT_DIR)"; exit 2; }
    done
    winpath() { cygpath -m "$1" 2>/dev/null || printf '%s' "$1"; }
    # mingw ld auto-exports every non-static function when none is marked
    # dllexport, so functions behind a disabled #if never reach the exports.
    cc_rc=0
    "$CC" -O2 -shared -o "$(winpath "$OUT")" "$(winpath "$SRC")" \
        -I"$(winpath "$LLAMA_ROOT/include")" -I"$(winpath "$LLAMA_ROOT/ggml/include")" \
        "$(winpath "$LLAMA_IMPLIB")" >"$OUT_DIR/build.log" 2>&1 || cc_rc=$?
    if [ "$cc_rc" -eq 0 ]; then
        for dep in ggml-base.dll ggml-cpu.dll ggml.dll libllama.dll; do
            if [ -f "$LLAMA_BUILD_DIR/bin/$dep" ]; then
                cp -f "$LLAMA_BUILD_DIR/bin/$dep" "$OUT_DIR/$dep"
            fi
        done
        for rt in libwinpthread-1.dll libunwind.dll libc++.dll; do
            cp -f "$MINGW_RT_DIR/$rt" "$OUT_DIR/$rt"
        done
    fi
elif [ "$IS_WINDOWS" -eq 1 ]; then
    [ -f "$LLAMA_IMPLIB" ] || { echo "ERROR -- nothing was built (no import library $LLAMA_IMPLIB)"; exit 2; }
    CC=${CC:-clang-cl}
    for tool in "$CC" lld-link llvm-nm llvm-readobj; do
        command -v "$tool" >/dev/null 2>&1 || { echo "ERROR -- nothing was built (missing tool: $tool)"; exit 2; }
    done
    # MSYS argument conversion mangles flag-glued paths (-FoC:/x is split on
    # ':' as a path list), so turn it off and hand the tools native C:/ paths.
    MSYS2_ARG_CONV_EXCL='*'; MSYS_NO_PATHCONV=1
    export MSYS2_ARG_CONV_EXCL MSYS_NO_PATHCONV
    winpath() { cygpath -m "$1" 2>/dev/null || printf '%s' "$1"; }
    OUT_DIR=$(winpath "$OUT_DIR"); OUT=$(winpath "$OUT"); SRC=$(winpath "$SRC")
    LLAMA_ROOT=$(winpath "$LLAMA_ROOT"); LLAMA_IMPLIB=$(winpath "$LLAMA_IMPLIB")
    obj=$OUT_DIR/slang_ggml.obj
    def=$OUT_DIR/slang_ggml.def
    # -MD: llama.dll is built against the dynamic CRT; do not mix CRTs.
    cc_rc=0
    "$CC" -nologo -c -O2 -MD -Fo"$obj" "$SRC" \
        -I"$LLAMA_ROOT/include" -I"$LLAMA_ROOT/ggml/include" >"$OUT_DIR/build.log" 2>&1 || cc_rc=$?
    if [ "$cc_rc" -eq 0 ]; then
        { echo "EXPORTS"; llvm-nm --defined-only --extern-only "$obj" | awk '$2 == "T" && $3 ~ /^slang_ggml_/ { print "    " $3 }'; } >"$def"
        lld-link -nologo -dll -def:"$def" -out:"$OUT" "$obj" "$LLAMA_IMPLIB" >>"$OUT_DIR/build.log" 2>&1 || cc_rc=$?
    fi
    if [ "$cc_rc" -eq 0 ]; then
        for dep in ggml-base.dll ggml-cpu.dll ggml.dll llama.dll; do
            if [ -f "$LLAMA_BUILD_DIR/bin/$dep" ]; then
                cp -f "$LLAMA_BUILD_DIR/bin/$dep" "$OUT_DIR/$dep"
            fi
        done
    fi
else
    CC=${CC:-cc}
    command -v "$CC" >/dev/null 2>&1 || { echo "ERROR -- nothing was built (no C compiler: $CC)"; exit 2; }
    # Status is captured with `|| cc_rc=$?`, never through a pipe (a
    # pipeline's $? is the last stage's) and never bare under `set -e`
    # (which would exit before the verdict line is printed).
    cc_rc=0
    "$CC" -O2 -fPIC -shared -o "$OUT" "$SRC" \
        -I"$LLAMA_ROOT/include" -I"$LLAMA_ROOT/ggml/include" \
        -L"$LLAMA_BUILD_DIR/bin" -lllama \
        -Wl,-rpath,"$LLAMA_BUILD_DIR/bin" 2>"$OUT_DIR/build.log" || cc_rc=$?
fi
if [ "$cc_rc" -ne 0 ]; then
    echo "compile output:" >&2
    cat "$OUT_DIR/build.log" >&2
    echo "FAIL -- compile failed (exit $cc_rc)"
    exit 1
fi

[ -f "$OUT" ] || { echo "ERROR -- nothing was built (compiler reported success but $OUT is absent)"; exit 2; }

# Non-vacuity: a library that exports none of our entries is a failed build
# that happens to link, which is exactly the shape a symbol-count check catches.
symbols=$OUT_DIR/slang_ggml_symbols.txt
list_exports "$OUT" >"$symbols"
n_sym=$(grep -c ' T slang_ggml_' "$symbols" || true)
[ "$n_sym" -gt 0 ] || { echo "FAIL -- built $OUT but it exports 0 slang_ggml_* symbols"; exit 1; }
for required in \
    slang_ggml_request_configure slang_ggml_request_create \
    slang_ggml_request_close slang_ggml_request_cancel \
    slang_ggml_request_str_reset slang_ggml_request_str_push \
    slang_ggml_request_out_len slang_ggml_request_out_byte \
    slang_ggml_request_n_ctx slang_ggml_request_tokenize \
    slang_ggml_request_token_at slang_ggml_request_prefix_prepare \
    slang_ggml_request_eval_prompt slang_ggml_request_eval \
    slang_ggml_request_sample slang_ggml_request_piece \
    slang_ggml_request_kv_clear slang_ggml_request_chat_render
do
    grep -q " T $required\$" "$symbols" || {
        echo "FAIL -- built $OUT but required S3 symbol $required is absent"
        exit 1
    }
done

if [ -f "$LLAMA_ROOT/include/llama-slang-paged.h" ]; then
    native_symbols=$OUT_DIR/llama_slang_paged_symbols.txt
    list_exports "$LLAMA_LIB" >"$native_symbols"
    for required_native in \
        llama_slang_paged_abi_version llama_slang_paged_page_seal \
        llama_slang_paged_fail llama_slang_paged_commit_and_copy \
        llama_slang_paged_page_bytes
    do
        grep -q " T $required_native\$" "$native_symbols" || {
            echo "FAIL -- compatible header found but native symbol $required_native is absent"
            exit 1
        }
    done
    for required in \
        slang_ggml_page_abi_version slang_ggml_page_execution_namespace \
        slang_ggml_page_pool_create slang_ggml_page_pool_destroy \
        slang_ggml_page_reserve slang_ggml_page_release slang_ggml_page_seal \
        slang_ggml_page_copy_tail slang_ggml_page_table_begin \
        slang_ggml_page_table_push slang_ggml_page_prefill \
        slang_ggml_page_decode slang_ggml_page_boundary_logits \
        slang_ggml_page_table_commit slang_ggml_page_table_abort \
        slang_ggml_page_allocated_bytes slang_ggml_page_bytes \
        slang_ggml_page_request_create
    do
        grep -q " T $required\$" "$symbols" || {
            echo "FAIL -- compatible paged llama.cpp found but required symbol $required is absent"
            exit 1
        }
    done
    # lld-link already rejects an unresolved import when linking a DLL, so the
    # ldd -r runtime-resolution check is ELF-only.
    ldd_output=$OUT_DIR/slang_ggml_ldd.txt
    if [ "$IS_WINDOWS" -eq 1 ]; then
        :
    elif ! ldd -r "$OUT" >"$ldd_output" 2>&1; then
        echo "FAIL -- unable to resolve paged shim runtime dependencies"
        exit 1
    fi
    if grep -q 'undefined symbol:' "$ldd_output"; then
        echo "FAIL -- paged shim has unresolved runtime symbols"
        exit 1
    fi
fi

echo "PASS -- $n_sym symbol(s) exported, $OUT"
