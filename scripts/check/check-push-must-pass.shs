#!/bin/sh
# Lightweight push-tier mandatory check. Reads normal pre-push ref rows on stdin.
set -u

ROOT=${MUST_CHECK_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null)}
[ -n "$ROOT" ] || { echo "push-must-check: FAIL — cannot locate repository root" >&2; exit 1; }
ROOT=$(CDPATH= cd -- "$ROOT" 2>/dev/null && pwd -P) || {
    echo "push-must-check: FAIL — cannot canonicalize repository root" >&2
    exit 1
}
LEDGER_REL=${MUST_CHECK_LEDGER_REL:-doc/08_tracking/check/must_check_db.sdn}
MANIFEST_REL=${MUST_CHECK_MANIFEST_REL:-config/check/must_check_gates.sdn}
ZERO=0000000000000000000000000000000000000000
MAX_PUSH_REF_ROWS=2
MAX_EVIDENCE_BYTES=67108864
ALLOW_EXTERNAL_EVIDENCE=0
EVIDENCE_REV=""

die() { echo "push-must-check: FAIL — $*" >&2; exit 1; }

fingerprint_rev() {
    _rev=$1
    _tree=$(mktemp) || return 1
    git -C "$ROOT" ls-tree -r "$_rev" -- src scripts config test rules.sdl doc/07_guide doc/00_llm_process doc/glossary.md >"$_tree" 2>/dev/null || { rm -f "$_tree"; return 1; }
    sed "\|[[:space:]]$LEDGER_REL$|d" "$_tree" | sha256sum | awk '{print $1}'
    _rc=$?
    rm -f "$_tree"
    return "$_rc"
}

hash_file() { sha256sum -- "$1" 2>/dev/null | awk '{print $1}'; }

resolve_evidence_path() {
    _candidate=$1
    case "$_candidate" in
        /*)
            [ "$ALLOW_EXTERNAL_EVIDENCE" -eq 1 ] || return 1
            EVIDENCE_PATH=$_candidate
            ;;
        ''|..|../*|*/../*|*/..)
            return 1
            ;;
        *) EVIDENCE_PATH="$ROOT/$_candidate" ;;
    esac
    if [ "$ALLOW_EXTERNAL_EVIDENCE" -eq 1 ]; then
        _evidence_dir=$(CDPATH= cd -- "$(dirname -- "$EVIDENCE_PATH")" 2>/dev/null && pwd -P) || return 1
        EVIDENCE_PATH="$_evidence_dir/$(basename -- "$EVIDENCE_PATH")"
        [ -f "$EVIDENCE_PATH" ] && [ ! -L "$EVIDENCE_PATH" ] || return 1
        EVIDENCE_SIZE=$(wc -c < "$EVIDENCE_PATH" | tr -d ' ') || return 1
        EVIDENCE_SHA=$(hash_file "$EVIDENCE_PATH") || return 1
        return 0
    fi
    _rel=${EVIDENCE_PATH#"$ROOT/"}
    [ -n "$EVIDENCE_REV" ] || return 1
    _entry=$(git -C "$ROOT" ls-tree "$EVIDENCE_REV" -- "$_rel" 2>/dev/null) || return 1
    [ "$(printf '%s\n' "$_entry" | wc -l | tr -d ' ')" -eq 1 ] || return 1
    _mode=$(printf '%s\n' "$_entry" | awk '{print $1}')
    case "$_mode" in 100644|100755) ;; *) return 1 ;; esac
    EVIDENCE_SIZE=$(git -C "$ROOT" cat-file -s "$EVIDENCE_REV:$_rel" 2>/dev/null) || return 1
    EVIDENCE_SHA=$(git -C "$ROOT" show "$EVIDENCE_REV:$_rel" 2>/dev/null | sha256sum | awk '{print $1}') || return 1
}

field_from_text() {
    _key=$1
    awk -v key="$_key" '$1 == key ":" {gsub(/^[^:]*:[[:space:]]*/, ""); if (substr($0,1,1)=="\"") $0=substr($0,2); if (substr($0,length($0),1)=="\"") $0=substr($0,1,length($0)-1); print; exit}'
}

validate_ledger_text() {
    _manifest=$1
    _ledger=$2
    _want_fp=$3
    _schema=$(printf '%s\n' "$_ledger" | field_from_text schema)
    [ "$_schema" = simple.must-check-ledger/v3 ] || return 10
    _got_fp=$(printf '%s\n' "$_ledger" | field_from_text source_fingerprint)
    [ "$_got_fp" = "$_want_fp" ] || return 11
    _manifest_ids=$(printf '%s\n' "$_manifest" | awk -F, '/^[[:space:]]+[a-z0-9][a-z0-9-]*,[[:space:]]*bootstrap,/ {x=$1; gsub(/^[[:space:]]+/,"",x); print x}')
    _ledger_ids=$(printf '%s\n' "$_ledger" | awk -F, '/^[[:space:]]+[a-z0-9][a-z0-9-]*,[[:space:]]*(pass|todo|blocked|fail),/ {x=$1; gsub(/^[[:space:]]+/,"",x); print x}')
    [ -n "$_manifest_ids" ] && [ -n "$_ledger_ids" ] || return 12
    [ "$(printf '%s\n' "$_manifest_ids" | sort | uniq -d | wc -l)" -eq 0 ] || return 13
    [ "$(printf '%s\n' "$_ledger_ids" | sort | uniq -d | wc -l)" -eq 0 ] || return 14
    [ "$(printf '%s\n' "$_manifest_ids" | sort)" = "$(printf '%s\n' "$_ledger_ids" | sort)" ] || return 15
    _todo=0
    _evidence_total=0
    printf '%s\n' "$_manifest" | awk '/^[[:space:]]+[a-z0-9][a-z0-9-]*,[[:space:]]*bootstrap,/ {print}' |
    while IFS=, read -r _id _tier _blocking _mode _command _description; do
        _id=$(printf '%s' "$_id" | tr -d ' ')
        _blocking=$(printf '%s' "$_blocking" | tr -d ' ')
        _row=$(printf '%s\n' "$_ledger" | awk -F, -v id="$_id" '{x=$1; gsub(/^[[:space:]]+/, "", x); if (x==id) {print; exit}}')
        [ -n "$_row" ] || exit 20
        _status=$(printf '%s\n' "$_row" | awk -F, '{x=$2; gsub(/[[:space:]]/, "", x); print x}')
        _passed_at=$(printf '%s\n' "$_row" | awk -F, '{x=$3; gsub(/[[:space:]]/, "", x); print x}')
        _evidence=$(printf '%s\n' "$_row" | awk -F, '{x=$5; gsub(/^[[:space:]]+|[[:space:]]+$/, "", x); gsub(/^"|"$/, "", x); print x}')
        _evidence_sha=$(printf '%s\n' "$_row" | awk -F, '{x=$6; gsub(/[[:space:]"]/, "", x); print x}')
        _ledger_command=$(printf '%s\n' "$_row" | awk -F, '{x=$4; gsub(/^[[:space:]]+|[[:space:]]+$/, "", x); gsub(/^"|"$/, "", x); print x}')
        _owner=$(printf '%s\n' "$_row" | awk -F, '{x=$7; gsub(/^[[:space:]]+|[[:space:]]+$/, "", x); gsub(/^"|"$/, "", x); print x}')
        _unblock=$(printf '%s\n' "$_row" | awk -F, '{x=$8; gsub(/^[[:space:]]+|[[:space:]]+$/, "", x); gsub(/^"|"$/, "", x); print x}')
        _manifest_command=$(printf '%s' "$_command" | sed 's/^[[:space:]]*"//;s/"[[:space:]]*$//')
        [ "$_ledger_command" = "$_manifest_command" ] || exit 26
        [ -n "$_owner" ] && [ "$_owner" != unassigned ] || exit 30
        if [ "$_status" = pass ]; then
            printf '%s\n' "$_passed_at" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' || exit 23
            [ -n "$_evidence" ] && [ "$_evidence" != never ] && [ "$_evidence" != "pending required evidence" ] || exit 25
            printf '%s\n' "$_evidence_sha" | grep -Eq '^[0-9a-f]{64}$' || exit 27
            resolve_evidence_path "$_evidence" || exit 28
            _evidence_size=$EVIDENCE_SIZE
            case "$_evidence_size" in ''|*[!0-9]*) exit 33 ;; esac
            _evidence_total=$(( _evidence_total + _evidence_size ))
            [ "$_evidence_total" -le "$MAX_EVIDENCE_BYTES" ] || exit 34
            [ "$EVIDENCE_SHA" = "$_evidence_sha" ] || exit 29
            [ "$_unblock" = none ] || exit 31
        elif [ "$_passed_at" != never ]; then
            exit 24
        fi
        if [ "$_blocking" = true ] && [ "$_status" != pass ]; then exit 21; fi
        if [ "$_status" = todo ] || [ "$_status" = blocked ]; then
            [ -n "$_unblock" ] && [ "$_unblock" != none ] || exit 32
            echo "push-must-check: TODO $_id" >&2
        elif [ "$_status" != pass ]; then
            exit 22
        fi
    done
    return $?
}

run_manifest_push_gates() {
    _manifest=$1
    _range=$2
    _ref=$3
    _push_rows=$(mktemp) || return 2
    printf '%s\n' "$_manifest" | awk '/^[[:space:]]+[a-z0-9][a-z0-9-]*,[[:space:]]*push,/ {print}' > "$_push_rows"
    [ -s "$_push_rows" ] || { rm -f "$_push_rows"; return 2; }
    while IFS=, read -r _id _tier _blocking _mode _command _description; do
        _id=$(printf '%s' "$_id" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        _mode=$(printf '%s' "$_mode" | tr -d ' ')
        _command=$(printf '%s' "$_command" | sed 's/^[[:space:]]*"//;s/"[[:space:]]*$//')
        [ -n "$_command" ] || { rm -f "$_push_rows"; return 2; }
        case "$_id:$_mode:$_command" in
            'push-conflict-tree:range:sh scripts/check/check-no-conflict-tree-push.shs')
                sh "$ROOT/scripts/check/check-no-conflict-tree-push.shs" "$_range" || { rm -f "$_push_rows"; return 1; } ;;
            'push-tree-size:range:sh scripts/check/check-tree-size-push.shs')
                sh "$ROOT/scripts/check/check-tree-size-push.shs" --push-tip "$_range" || { rm -f "$_push_rows"; return 1; } ;;
            'push-conflict-markers:range:sh scripts/check/check-no-conflict-markers-push.shs')
                sh "$ROOT/scripts/check/check-no-conflict-markers-push.shs" "$_range" || { rm -f "$_push_rows"; return 1; } ;;
            'push-rules-quick:ref:sh scripts/check/check-rules-sdl.shs --group quick --ref')
                sh "$ROOT/scripts/check/check-rules-sdl.shs" --group quick --ref "$_ref" || { rm -f "$_push_rows"; return 1; } ;;
            'push-interpreter-module-owners:ref:sh scripts/check/check-interpreter-module-owners.shs --ref')
                sh "$ROOT/scripts/check/check-interpreter-module-owners.shs" --ref "$_ref" || { rm -f "$_push_rows"; return 1; } ;;
            *) rm -f "$_push_rows"; return 2 ;;
        esac
    done < "$_push_rows"
    rm -f "$_push_rows"
}

if [ "${1:-}" = --self-test ]; then
    _tmp=$(mktemp -d) || exit 2
    trap 'rm -rf "$_tmp"' EXIT INT TERM
    cp "$ROOT/$MANIFEST_REL" "$_tmp/manifest"
    cp "$ROOT/$LEDGER_REL" "$_tmp/ledger"
    printf '%s\n' 'self-test authoritative evidence' > "$_tmp/evidence"
    _evidence_sha=$(hash_file "$_tmp/evidence") || exit 1
    sed 's/source_fingerprint: "unrecorded"/source_fingerprint: "abc"/; s/compiler-stage1, todo, never/compiler-stage1, pass, 2000-01-01T00:00:00Z/; s/compiler-stage2, todo, never/compiler-stage2, pass, 2000-01-01T00:00:00Z/; s/compiler-stage3, todo, never/compiler-stage3, pass, 2000-01-01T00:00:00Z/; s/compiler-stage4, todo, never/compiler-stage4, pass, 2000-01-01T00:00:00Z/' "$_tmp/ledger" > "$_tmp/pass-raw"
    awk -F, -v ev="$_tmp/evidence" -v sha="$_evidence_sha" 'BEGIN{OFS=","} $2 ~ /pass/ {$5=" \"" ev "\""; $6=" \"" sha "\""; $8=" \"none\""} {print}' "$_tmp/pass-raw" > "$_tmp/pass"
    ALLOW_EXTERNAL_EVIDENCE=1
    validate_ledger_text "$(cat "$_tmp/manifest")" "$(cat "$_tmp/pass")" abc || die "valid fixture rejected"
    validate_ledger_text "$(cat "$_tmp/manifest")" "$(cat "$_tmp/pass")" stale && die "stale fixture accepted"
    sed 's/compiler-stage4, pass/compiler-stage4, fail/' "$_tmp/pass" > "$_tmp/fail"
    validate_ledger_text "$(cat "$_tmp/manifest")" "$(cat "$_tmp/fail")" abc && die "failed blocking row accepted"
    sed '/compiler-stage4,/d' "$_tmp/pass" > "$_tmp/missing"
    validate_ledger_text "$(cat "$_tmp/manifest")" "$(cat "$_tmp/missing")" abc && die "missing row accepted"
    cp "$_tmp/pass" "$_tmp/duplicate"
    sed -n '/compiler-stage4,/p' "$_tmp/pass" >> "$_tmp/duplicate"
    validate_ledger_text "$(cat "$_tmp/manifest")" "$(cat "$_tmp/duplicate")" abc && die "duplicate row accepted"
    printf '%s\n' 'must_check_gates |id, tier, push_blocking, mode, command, description|' > "$_tmp/empty-manifest"
    validate_ledger_text "$(cat "$_tmp/empty-manifest")" "$(cat "$_tmp/fail")" abc && die "empty manifest accepted"
    sed 's/compiler-stage4, pass, 2000-01-01T00:00:00Z/compiler-stage4, pass, never/' "$_tmp/pass" > "$_tmp/no-pass-time"
    validate_ledger_text "$(cat "$_tmp/manifest")" "$(cat "$_tmp/no-pass-time")" abc && die "PASS without timestamp accepted"
    awk -F, 'BEGIN{OFS=","} $1 ~ /compiler-stage4/ {$5=" \"\""} {print}' "$_tmp/pass" > "$_tmp/no-evidence"
    validate_ledger_text "$(cat "$_tmp/manifest")" "$(cat "$_tmp/no-evidence")" abc && die "PASS without evidence reference accepted"
    sed 's/authoritative evidence/tampered evidence/' "$_tmp/evidence" > "$_tmp/tampered"
    mv "$_tmp/tampered" "$_tmp/evidence"
    validate_ledger_text "$(cat "$_tmp/manifest")" "$(cat "$_tmp/pass")" abc && die "tampered evidence accepted"
    sed 's/, "compiler-team", "none"$/, "unassigned", "none"/' "$_tmp/pass" > "$_tmp/no-owner"
    validate_ledger_text "$(cat "$_tmp/manifest")" "$(cat "$_tmp/no-owner")" abc && die "unowned row accepted"
    sed 's/, "compiler-team", "none"$/, "compiler-team", "still pending"/' "$_tmp/pass" > "$_tmp/pass-with-unblock"
    validate_ledger_text "$(cat "$_tmp/manifest")" "$(cat "$_tmp/pass-with-unblock")" abc && die "PASS with pending unblock accepted"
    sed 's/compiler-stage4, pass, 2000-01-01T00:00:00Z/compiler-stage4, todo, never/; s/, "compiler-team", "none"$/, "compiler-team", "none"/' "$_tmp/pass" > "$_tmp/todo-without-unblock"
    validate_ledger_text "$(cat "$_tmp/manifest")" "$(cat "$_tmp/todo-without-unblock")" abc && die "TODO without unblock accepted"
    printf '%s\n' 'self-test authoritative evidence' > "$_tmp/evidence"
    ALLOW_EXTERNAL_EVIDENCE=0
    validate_ledger_text "$(cat "$_tmp/manifest")" "$(cat "$_tmp/pass")" abc && die "external absolute evidence accepted"
    awk -F, 'BEGIN{OFS=","} $2 ~ /pass/ {$5=" \"../outside-evidence\""} {print}' "$_tmp/pass" > "$_tmp/traversal"
    validate_ledger_text "$(cat "$_tmp/manifest")" "$(cat "$_tmp/traversal")" abc && die "parent-traversal evidence accepted"
    ALLOW_EXTERNAL_EVIDENCE=1
    MAX_EVIDENCE_BYTES=1
    validate_ledger_text "$(cat "$_tmp/manifest")" "$(cat "$_tmp/pass")" abc && die "oversize aggregate evidence accepted"
    echo "push-must-check: PASS — 15 ledger fixtures checked"
    exit 0
fi

[ -f "$ROOT/$MANIFEST_REL" ] || die "missing manifest $MANIFEST_REL"
_refs=$(mktemp) || exit 2
_unique_refs=$(mktemp) || exit 2
trap 'rm -f "$_refs" "$_unique_refs"' EXIT INT TERM
cat > "$_refs"
[ -s "$_refs" ] || die "no pushed refs were provided"

awk 'NF != 4 {bad=1; next} !seen[$2 SUBSEP $4]++ {print} END {exit bad}' "$_refs" > "$_unique_refs" ||
    die "malformed pushed ref row"
_ref_count=$(wc -l < "$_unique_refs" | tr -d ' ')
[ "$_ref_count" -gt 0 ] || die "no non-duplicate pushed refs were provided"
[ "$_ref_count" -le "$MAX_PUSH_REF_ROWS" ] ||
    die "$_ref_count unique ref updates exceed the bounded limit $MAX_PUSH_REF_ROWS; split the push"

while read -r _local_ref _local_sha _remote_ref _remote_sha; do
    [ "$_local_sha" = "$ZERO" ] && continue
    _ledger=$(git -C "$ROOT" show "$_local_sha:$LEDGER_REL" 2>/dev/null) || die "ledger is missing from $_local_sha"
    _manifest=$(git -C "$ROOT" show "$_local_sha:$MANIFEST_REL" 2>/dev/null) || die "manifest is missing from $_local_sha"
    _fp=$(fingerprint_rev "$_local_sha") || die "cannot fingerprint $_local_sha"
    EVIDENCE_REV=$_local_sha
    validate_ledger_text "$_manifest" "$_ledger" "$_fp" || die "ledger is malformed stale or has a non-passing push-blocking row"
    _range="$_remote_sha..$_local_sha"
    if [ "$_remote_sha" = "$ZERO" ]; then
        _base=$(git -C "$ROOT" merge-base "$_local_sha" origin/main 2>/dev/null) || die "cannot derive new-ref base"
        _range="$_base..$_local_sha"
    fi
    run_manifest_push_gates "$_manifest" "$_range" "$_local_sha" ||
        die "one or more manifest-declared push gates failed"
done < "$_unique_refs"

echo "push-must-check: PASS — lightweight committed-tree and bootstrap-ledger checks passed"
