#!/bin/sh
# check-no-decls-dropped.shs [base] — for every changed .spl file, verify that no
# top-level declaration present at <base> (default HEAD) is missing from the
# working copy.
#
# Why: repairing a clobber means restoring a file from an older revision, and an
# older revision can legitimately lack work the current tree added. A restore is
# supposed to ADD back deleted declarations; this guard fails closed if one
# silently dropped something HEAD had. It is the mechanical form of the
# "diff BOTH directions before overwriting" rule in .claude/rules/vcs.md.
#
# Verdict is the last line of stdout:
#   PASS  — <n> file(s) checked, 0 declaration(s) dropped
#   FAIL  — <n> file(s) checked, <k> dropped: <file:name ...>
#   ERROR — nothing was checked (<reason>)
# A run that compared 0 files is ERROR, never a pass.
set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"
BASE="${1:-HEAD}"
T=$(mktemp -d) || { echo "ERROR — nothing was checked: mktemp failed"; exit 2; }
trap 'rm -rf "$T"' EXIT

extract_decls() {
    grep -oE '^[[:space:]]*(pub )?(fn|struct|class|enum|trait) [A-Za-z_0-9]+' \
      | sed -E 's/^[[:space:]]*(pub )?//' | sort -u
}

CHECKED=0
DROPPED=0
NAMES=""
for f in $(git diff --name-only "$BASE" -- 'src/*.spl' 'src/**/*.spl' 2>/dev/null); do
    [ -f "$f" ] || continue
    git show "$BASE:$f" 2>/dev/null | extract_decls > "$T/base"
    [ -s "$T/base" ] || continue
    extract_decls < "$f" > "$T/now"
    CHECKED=$((CHECKED + 1))
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        DROPPED=$((DROPPED + 1))
        NAMES="$NAMES $f:$(echo "$d" | tr ' ' ':')"
    done < "$(comm -23 "$T/base" "$T/now" > "$T/gone"; echo "$T/gone")"
done

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked: no changed .spl files against $BASE"
    exit 2
fi
if [ "$DROPPED" -gt 0 ]; then
    echo "FAIL — $CHECKED file(s) checked, $DROPPED declaration(s) dropped:$NAMES"
    exit 1
fi
echo "PASS — $CHECKED file(s) checked, 0 declaration(s) dropped vs $BASE"
