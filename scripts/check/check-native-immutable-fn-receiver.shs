#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

SIMPLE_BIN="${SIMPLE_BIN:-}"
BUILD_DIR="${BUILD_DIR:-build/native-immutable-fn-receiver}"
ENTRY="test/fixtures/compiler/native_immutable_fn_receiver.spl"

[ -n "$SIMPLE_BIN" ] && [ -x "$SIMPLE_BIN" ] || {
    echo "immutable fn receiver closure: missing self-hosted SIMPLE_BIN" >&2
    exit 2
}
case "$SIMPLE_BIN" in *src/compiler_rust/*|src/compiler_rust/*)
    echo "immutable fn receiver closure: Rust seed is forbidden" >&2
    exit 2
esac

mkdir -p "$BUILD_DIR/cache"
rm -f "$BUILD_DIR/probe"
SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LIB="$ROOT_DIR/src" "$SIMPLE_BIN" native-build \
    --backend cranelift --source test/fixtures/compiler --entry "$ENTRY" --entry-closure \
    --cache-dir "$BUILD_DIR/cache" --output "$BUILD_DIR/probe" \
    >"$BUILD_DIR/native-build.log" 2>&1
[ -x "$BUILD_DIR/probe" ] || exit 1
actual="$("$BUILD_DIR/probe")"
[ "$actual" = immutable-fn-receiver-ok ] || {
    echo "immutable fn receiver closure: wrong result '$actual'" >&2
    exit 1
}
echo "native_immutable_fn_receiver_status=pass"
