#!/bin/sh
# Produce measured Gen2 qualification inputs in private scratch only.  The
# admitted Simple receipt writer is the only component permitted to create
# final evidence.
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
PRODUCT=riscv-gen2-zca-trap-single-outstanding-v3
RV32_ROW=rv32-zca-cjal-critical
RV64_ROW=rv64-zca-addiw-critical
RV32_PROFILE=riscv-gen2-rv32-zca-cjal-critical
RV64_PROFILE=riscv-gen2-rv64-zca-addiw-critical
RV32_ENTITY=riscv_gen2_zca_rv32_cjal_trap_single_outstanding_frontend
RV64_ENTITY=riscv_gen2_zca_rv64_addiw_trap_single_outstanding_frontend
SCRATCH_PARENT=build/riscv-gen2-hwir-qualification-scratch
FINAL_PARENT=build/evidence/riscv_gen2_hwir_foundation
COVERAGE_SCOPE=scripts/check/riscv-gen2-hwir-qualification-coverage-scope.env
COVERAGE_SCOPE_SCHEMA=riscv-gen2-hwir-coverage-scope-v1
COVERAGE_SCOPE_MAX_BYTES=65536
COVERAGE_SPEC_EXPECTED=test/03_system/app/hardware/feature/riscv_gen2_hwir_foundation_spec.spl
QUALIFICATION_RUNNER=scripts/check/run-riscv-gen2-hwir-qualification.shs
QUALIFICATION_PRODUCER=scripts/check/produce-riscv-gen2-hwir-qualification-evidence.shs
COVERAGE_SPEC=
SCOPE_OWNER_LIST=
STAGE4_CLI=
STAGE4_PROVENANCE=
SCRATCH_DIR=
MANIFEST=
REQUEST_PRODUCT=
RUN_ID=
GHDL_BIN=
EXPECTED_RUNNER_SHA256=
EXPECTED_PRODUCER_SHA256=
EXPECTED_COVERAGE_SCOPE_SHA256=
EXPECTED_COVERAGE_SPEC_SHA256=
ROW_ONE=
ROW_TWO=

fail() {
    printf '%s\n' 'riscv_gen2_hwir_producer_status=fail'
    printf '%s\n' "riscv_gen2_hwir_producer_reason=$1"
    exit 1
}

need_value() {
    [ -n "$2" ] || fail "empty-value:$1"
}

safe_relative_path() {
    case "$1" in
        ''|/*|./*|*'/./'*|*'//'*) return 1 ;;
    esac
    case "$1" in
        *..*|*\\*) return 1 ;;
    esac
    return 0
}

root_relative_file() {
    case "$1" in
        "$ROOT_DIR"/*) printf '%s\n' "${1#"$ROOT_DIR"/}" ;;
        *) return 1 ;;
    esac
}

sha_file() {
    value=$(bootstrap_stage3_hash_file "$1") || return 1
    printf '%s\n' "$value" | awk 'length($0) == 64 && $0 ~ /^[0-9a-fA-F]+$/ { ok = 1 } END { exit !ok }' || return 1
    printf '%s\n' "$value"
}

valid_sha256() {
    printf '%s\n' "$1" |
        awk 'length($0) == 64 && $0 ~ /^[0-9a-fA-F]+$/ { ok = 1 } END { exit !ok }'
}

json_hash() {
    matches=$(grep -Eo "\"$2\":\"[0-9a-fA-F]{64}\"" "$1" | sed -n "s/^\"$2\":\"\([0-9a-fA-F][0-9a-fA-F]*\)\"$/\1/p") || return 1
    [ "$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')" = 1 ] || return 1
    printf '%s\n' "$matches" | awk 'length($0) == 64 && $0 ~ /^[0-9a-fA-F]+$/ { print; ok = 1 } END { exit !ok }'
}

require_manifest_text() {
    grep -Fq "$2" "$1" || fail "product-manifest-missing:$3"
}

write_testbench() {
    tb=$1
    entity=$2
    tb_entity=$3
    address_bits=$4
    xlen=$5
    pc_literal=$6
    marker=$7
    selected_parcel=$8
    selected_canonical=$9
    selected_assertion=${10}
    cat_prefix="${address_bits}"
    [ "$cat_prefix" = 32 ] || [ "$cat_prefix" = 56 ] || fail 'unsupported-address-width'
    printf '%s\n' \
        'library ieee;' \
        'use ieee.std_logic_1164.all;' \
        'use ieee.numeric_std.all;' \
        'use std.env.all;' \
        "entity $tb_entity is end entity;" \
        "architecture tb of $tb_entity is" \
        " signal clk: std_logic := '0'; signal rst: std_logic := '1'; signal fetch_valid: std_logic := '0'; signal fetch_parcel: std_logic_vector(15 downto 0) := (others=>'0'); signal fetch_pc: std_logic_vector($((address_bits - 1)) downto 0) := (others=>'0'); signal rs1_index: std_logic_vector(4 downto 0) := (others=>'0'); signal rs1_value: std_logic_vector($((xlen - 1)) downto 0) := (others=>'0'); signal dispatch_accept,retire_valid: std_logic := '0'; signal retire_lineage,dispatch_lineage: std_logic_vector(63 downto 0) := (others=>'0'); signal retire_original_parcel: std_logic_vector(15 downto 0) := $selected_parcel; signal retire_canonical_instruction: std_logic_vector(31 downto 0) := $selected_canonical; signal retire_original_length_bytes: std_logic_vector(1 downto 0) := \"10\"; signal fetch_ready,dispatch_valid,protocol_fault: std_logic; signal original_parcel: std_logic_vector(15 downto 0); signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0); signal legal,redirect_valid,trap_valid: std_logic; signal next_pc,redirect_target: std_logic_vector($((address_bits - 1)) downto 0); signal trap_cause,trap_tval: std_logic_vector($((xlen - 1)) downto 0);" \
        'begin' \
        ' clk <= not clk after 5 ns;' \
        " dut: entity work.$entity port map(clk,rst,fetch_valid,fetch_parcel,fetch_pc,rs1_index,rs1_value,dispatch_accept,retire_valid,retire_lineage,retire_original_parcel,retire_canonical_instruction,retire_original_length_bytes,fetch_ready,dispatch_valid,dispatch_lineage,protocol_fault,original_parcel,canonical_instruction,original_length_bytes,legal,next_pc,redirect_valid,redirect_target,trap_valid,trap_cause,trap_tval);" \
        ' stim: process begin' \
        "  wait until rising_edge(clk); rst <= '0'; fetch_valid <= '1'; fetch_parcel <= $selected_parcel; fetch_pc <= $pc_literal;" \
        "  wait until rising_edge(clk); fetch_valid <= '0'; wait for 1 ns; assert dispatch_valid='1' and protocol_fault='0' and canonical_instruction=$selected_canonical and legal='1' and $selected_assertion report \"generated product failed its selected target-row path\" severity failure;" \
        "  dispatch_accept <= '1'; wait until rising_edge(clk); dispatch_accept <= '0'; wait for 1 ns; assert fetch_ready='0' and trap_valid='0' report \"generated product failed its single-outstanding transition\" severity failure;" \
        "  retire_valid <= '1'; retire_lineage <= dispatch_lineage; wait until rising_edge(clk); retire_valid <= '0'; wait for 1 ns; assert fetch_ready='1' and protocol_fault='0' report \"generated product failed its matching retirement transition\" severity failure;" \
        "  fetch_valid <= '1'; fetch_parcel <= x\"9002\"; wait until rising_edge(clk); fetch_valid <= '0'; wait for 1 ns; assert dispatch_valid='1' and trap_valid='1' and canonical_instruction=x\"00100073\" and legal='1' and trap_cause=std_logic_vector(to_unsigned(3,$xlen)) report \"generated product failed its precise C.EBREAK path\" severity failure;" \
        "  assert false report \"$marker\" severity note; finish; end process;" \
        'end architecture;' > "$tb"
}

# The scope is a strict data artifact, never sourced or evaluated.  Parsing
# writes only validated values into the private runner scratch directory.
parse_coverage_scope() {
    scope_input=$1
    scope_output=$2
    [ -f "$scope_input" ] && [ ! -L "$scope_input" ] && [ -s "$scope_input" ] || return 1
    scope_bytes=$(wc -c < "$scope_input" | tr -d ' ') || return 1
    [ "$scope_bytes" -le "$COVERAGE_SCOPE_MAX_BYTES" ] || return 1
    [ "$(tail -c 1 "$scope_input" | wc -l | tr -d ' ')" = 1 ] || return 1
    [ ! -e "$scope_output" ] && [ ! -L "$scope_output" ] || return 1
    mkdir "$scope_output" || return 1
    if ! awk -v schema="$COVERAGE_SCOPE_SCHEMA" \
            -v coverage_spec_expected="$COVERAGE_SPEC_EXPECTED" \
            -v output="$scope_output" '
        function safe_path(path) {
            return path ~ /^[A-Za-z0-9][A-Za-z0-9._/-]*$/ &&
                path !~ /(^|\/)\.\.?($|\/)/ && path !~ /\/\//
        }
        function append(name, value) { print value >> (output "/" name) }
        function unique(kind, value) {
            key = kind SUBSEP value
            if (seen[key]++) exit 1
        }
        {
            separator = index($0, "=")
            if (separator < 2 || $0 !~ /^[a-z_]+=/) exit 1
            key = substr($0, 1, separator - 1)
            value = substr($0, separator + 1)
            if (value == "") exit 1
            if (key == "schema") {
                if (++schema_count != 1 || value != schema) exit 1
            } else if (key == "coverage_spec") {
                if (++coverage_spec_count != 1 || value != coverage_spec_expected ||
                        !safe_path(value)) exit 1
                coverage_spec = value
                append("coverage_spec", value)
            } else if (key == "coverage_owner") {
                if (!safe_path(value) || value !~ /\.spl$/) exit 1
                unique(key, value); owners[value] = 1; owner_count++
                append("coverage_owners", value)
            } else if (key == "changed_file") {
                if (!safe_path(value) || value !~ /\.spl$/) exit 1
                unique(key, value); changed[value] = 1; changed_count++
                append("changed_files", value)
            } else if (key == "direct_test") {
                if (!safe_path(value) || value !~ /^test\//) exit 1
                unique(key, value); direct_tests[value] = 1; direct_test_count++
                append("direct_tests", value)
            } else if (key == "exclusion") {
                count = split(value, exclusion, "|")
                if (count != 2 || !safe_path(exclusion[1]) ||
                        exclusion[2] !~ /^[a-z0-9-]+$/) exit 1
                unique(key, value); exclusion_count++
                append("exclusions.psv", value)
            } else exit 1
        }
        END {
            if (schema_count != 1 || coverage_spec_count != 1 || owner_count == 0 ||
                    changed_count == 0 || direct_test_count == 0 || exclusion_count == 0 ||
                    !owners[coverage_spec]) exit 1
            for (path in changed) if (!owners[path]) exit 1
        }
    ' "$scope_input"; then
        rm -rf "$scope_output"
        return 1
    fi
    [ -s "$scope_output/coverage_spec" ] && [ -s "$scope_output/coverage_owners" ] &&
        [ -s "$scope_output/changed_files" ] && [ -s "$scope_output/direct_tests" ] &&
        [ -s "$scope_output/exclusions.psv" ] || {
        rm -rf "$scope_output"
        return 1
    }
}

coverage_basis_points() {
    awk '
        $0 == "# Coverage Report" { header++; next }
        $0 == "coverage_extension: decision-condition-v1" { extension++; next }
        /^decisions \|id, file, line, column, true_count, false_count\|$/ { decisions++; in_decisions = 1; next }
        in_decisions && /^$/ { in_decisions = 0; ended = 1; next }
        in_decisions {
            row = $0
            sub(/^    /, "", row)
            count = split(row, field, ", ")
            if (count != 6 || field[1] !~ /^[0-9]+$/ || field[3] !~ /^[0-9]+$/ || field[4] !~ /^[0-9]+$/ || field[5] !~ /^[0-9]+$/ || field[6] !~ /^[0-9]+$/) exit 1
            key = field[1] SUBSEP field[2] SUBSEP field[3] SUBSEP field[4]
            if (seen[key]++) exit 1
            outcomes += 2
            if (field[5] > 0) covered += 1
            if (field[6] > 0) covered += 1
        }
        END {
            if (header != 1 || extension != 1 || decisions != 1 || !ended || outcomes == 0) exit 1
            printf "%d %d %d\n", covered, outcomes, (covered * 10000) / outcomes
        }
    ' "$1"
}

coverage_owner_allowed() {
    # Exact members only: coverage may not silently expand to a neighboring
    # compiler, runtime, or test-runner implementation owner.
    grep -Fxq -- "$1" "$SCOPE_OWNER_LIST"
}

coverage_decision_owners_complete() {
    # Interim completeness gate: every declared canonical owner must contribute
    # at least one scoped decision.  This deliberately does not claim a full
    # decision inventory or digest; that requires a separately versioned
    # expected-decision specification.
    coverage_records=$1
    [ -f "$coverage_records" ] && [ ! -L "$coverage_records" ] && [ -s "$coverage_records" ] || return 1
    while IFS= read -r coverage_owner; do
        [ -n "$coverage_owner" ] || continue
        awk -F '|' -v owner="$coverage_owner" '
            $1 == "D" && $2 == owner { found = 1 }
            END { exit !found }
        ' "$coverage_records" || return 1
    done < "$SCOPE_OWNER_LIST"
}

coverage_source_path_safe() {
    case "$1" in *'|'*) return 1 ;; esac
    safe_relative_path "$1" || return 1
    case "$1" in
        *.spl) return 0 ;;
        *) return 1 ;;
    esac
}

scope_coverage_sdn() {
    coverage_input=$1
    coverage_output=$2
    coverage_rows=$coverage_output.rows.$$
    coverage_tmp=$coverage_output.tmp.$$
    [ -f "$coverage_input" ] && [ ! -L "$coverage_input" ] && [ -s "$coverage_input" ] || return 1
    [ ! -e "$coverage_output" ] && [ ! -L "$coverage_output" ] || return 1
    umask 077
    if ! awk '
        NR == 1 { if ($0 != "# Coverage Report") exit 1; header = 1; next }
        $0 == "version: 1.0" { if (++version != 1 || decisions != 0) exit 1; next }
        $0 == "coverage_extension: decision-condition-v1" { if (++extension != 1 || decisions != 0) exit 1; next }
        $0 == "decisions |id, file, line, column, true_count, false_count|" {
            if (++decisions != 1 || version != 1 || extension != 1 || closed) exit 1
            in_decisions = 1
            next
        }
        in_decisions && $0 == "" {
            if (rows == 0) exit 1
            in_decisions = 0
            closed = 1
            next
        }
        in_decisions {
            if ($0 !~ /^    [0-9]+, [^,[:space:]]+, [0-9]+, [0-9]+, [0-9]+, [0-9]+$/) exit 1
            row = $0
            sub(/^    /, "", row)
            count = split(row, field, ", ")
            if (count != 6 || field[1] !~ /^[0-9]+$/ || field[2] ~ /\|/ || field[3] !~ /^[0-9]+$/ || field[4] !~ /^[0-9]+$/ || field[5] !~ /^[0-9]+$/ || field[6] !~ /^[0-9]+$/) exit 1
            key = field[1] SUBSEP field[2] SUBSEP field[3] SUBSEP field[4]
            if (seen[key]++) exit 1
            print "D|" field[2] "|" field[1] "||" field[3] "|" field[4] "|" field[5] "|" field[6]
            rows++
            next
        }
        $0 == "conditions |decision_id, condition_id, file, line, column, true_count, false_count|" {
            if (++conditions != 1 || !closed || conditions_closed) exit 1
            in_conditions = 1
            next
        }
        in_conditions && $0 == "" {
            in_conditions = 0
            conditions_closed = 1
            next
        }
        in_conditions {
            if ($0 !~ /^    [0-9]+, [0-9]+, [^,[:space:]]+, [0-9]+, [0-9]+, [0-9]+, [0-9]+$/) exit 1
            row = $0
            sub(/^    /, "", row)
            count = split(row, field, ", ")
            if (count != 7 || field[1] !~ /^[0-9]+$/ || field[2] !~ /^[0-9]+$/ || field[3] ~ /\|/ || field[4] !~ /^[0-9]+$/ || field[5] !~ /^[0-9]+$/ || field[6] !~ /^[0-9]+$/ || field[7] !~ /^[0-9]+$/) exit 1
            key = field[1] SUBSEP field[2] SUBSEP field[3] SUBSEP field[4] SUBSEP field[5]
            if (condition_seen[key]++) exit 1
            print "C|" field[3] "|" field[1] "|" field[2] "|" field[4] "|" field[5] "|" field[6] "|" field[7]
            next
        }
        $0 == "# Coverage Report" || $0 == "decisions |id, file, line, column, true_count, false_count|" || $0 == "conditions |decision_id, condition_id, file, line, column, true_count, false_count|" { exit 1 }
        END { if (header != 1 || version != 1 || extension != 1 || decisions != 1 || !closed || in_decisions || in_conditions || (conditions == 1 && !conditions_closed)) exit 1 }
    ' "$coverage_input" > "$coverage_rows"; then
        rm -f "$coverage_rows"
        return 1
    fi
    coverage_decision_owners_complete "$coverage_rows" || {
        rm -f "$coverage_rows"
        return 4
    }
    {
        printf '%s\n' '# Coverage Report'
        printf '%s\n' 'version: 1.0'
        printf '%s\n' 'coverage_extension: decision-condition-v1'
        printf '%s\n' ''
        printf '%s\n' 'decisions |id, file, line, column, true_count, false_count|'
        while IFS='|' read -r record_kind source_path first_id second_id line column true_count false_count; do
            case "$record_kind" in
                D) decision_id=$first_id ;;
                C) : ;;
                *)
                    rm -f "$coverage_rows" "$coverage_tmp"
                    return 1
                    ;;
            esac
            coverage_source_path_safe "$source_path" || {
                rm -f "$coverage_rows" "$coverage_tmp"
                return 2
            }
            coverage_owner_allowed "$source_path" || {
                rm -f "$coverage_rows" "$coverage_tmp"
                return 3
            }
            if [ "$record_kind" = D ]; then
                printf '    %s, %s, %s, %s, %s, %s\n' "$decision_id" "$source_path" "$line" "$column" "$true_count" "$false_count"
            fi
        done < "$coverage_rows"
        printf '%s\n' ''
    } > "$coverage_tmp"
    rm -f "$coverage_rows"
    [ -s "$coverage_tmp" ] && [ ! -L "$coverage_tmp" ] || {
        rm -f "$coverage_tmp"
        return 1
    }
    mv "$coverage_tmp" "$coverage_output"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --stage4-cli) [ "$#" -ge 2 ] || fail "missing-value:$1"; need_value "$1" "$2"; [ -z "$STAGE4_CLI" ] || fail 'duplicate-stage4-cli'; STAGE4_CLI=$2; shift 2 ;;
        --stage4-provenance) [ "$#" -ge 2 ] || fail "missing-value:$1"; need_value "$1" "$2"; [ -z "$STAGE4_PROVENANCE" ] || fail 'duplicate-stage4-provenance'; STAGE4_PROVENANCE=$2; shift 2 ;;
        --scratch-dir) [ "$#" -ge 2 ] || fail "missing-value:$1"; need_value "$1" "$2"; [ -z "$SCRATCH_DIR" ] || fail 'duplicate-scratch-dir'; SCRATCH_DIR=$2; shift 2 ;;
        --manifest) [ "$#" -ge 2 ] || fail "missing-value:$1"; need_value "$1" "$2"; [ -z "$MANIFEST" ] || fail 'duplicate-manifest'; MANIFEST=$2; shift 2 ;;
        --ghdl-bin) [ "$#" -ge 2 ] || fail "missing-value:$1"; need_value "$1" "$2"; [ -z "$GHDL_BIN" ] || fail 'duplicate-ghdl-bin'; GHDL_BIN=$2; shift 2 ;;
        --expected-runner-sha256) [ "$#" -ge 2 ] || fail "missing-value:$1"; need_value "$1" "$2"; [ -z "$EXPECTED_RUNNER_SHA256" ] || fail 'duplicate-expected-runner-sha256'; EXPECTED_RUNNER_SHA256=$2; shift 2 ;;
        --expected-producer-sha256) [ "$#" -ge 2 ] || fail "missing-value:$1"; need_value "$1" "$2"; [ -z "$EXPECTED_PRODUCER_SHA256" ] || fail 'duplicate-expected-producer-sha256'; EXPECTED_PRODUCER_SHA256=$2; shift 2 ;;
        --expected-coverage-scope-sha256) [ "$#" -ge 2 ] || fail "missing-value:$1"; need_value "$1" "$2"; [ -z "$EXPECTED_COVERAGE_SCOPE_SHA256" ] || fail 'duplicate-expected-coverage-scope-sha256'; EXPECTED_COVERAGE_SCOPE_SHA256=$2; shift 2 ;;
        --expected-coverage-spec-sha256) [ "$#" -ge 2 ] || fail "missing-value:$1"; need_value "$1" "$2"; [ -z "$EXPECTED_COVERAGE_SPEC_SHA256" ] || fail 'duplicate-expected-coverage-spec-sha256'; EXPECTED_COVERAGE_SPEC_SHA256=$2; shift 2 ;;
        --product) [ "$#" -ge 2 ] || fail "missing-value:$1"; need_value "$1" "$2"; [ -z "$REQUEST_PRODUCT" ] || fail 'duplicate-product'; REQUEST_PRODUCT=$2; shift 2 ;;
        --required-row) [ "$#" -ge 2 ] || fail "missing-value:$1"; need_value "$1" "$2"; if [ -z "$ROW_ONE" ]; then ROW_ONE=$2; elif [ -z "$ROW_TWO" ]; then ROW_TWO=$2; else fail 'too-many-required-rows'; fi; shift 2 ;;
        --run-id) [ "$#" -ge 2 ] || fail "missing-value:$1"; need_value "$1" "$2"; [ -z "$RUN_ID" ] || fail 'duplicate-run-id'; RUN_ID=$2; shift 2 ;;
        *) fail "unknown-argument:$1" ;;
    esac
done

[ -n "$STAGE4_CLI" ] || fail 'missing-stage4-cli'
[ -n "$STAGE4_PROVENANCE" ] || fail 'missing-stage4-provenance'
[ -n "$SCRATCH_DIR" ] || fail 'missing-scratch-dir'
[ -n "$MANIFEST" ] || fail 'missing-manifest'
[ -n "$GHDL_BIN" ] || fail 'missing-ghdl-bin'
[ -n "$EXPECTED_RUNNER_SHA256" ] || fail 'missing-expected-runner-sha256'
[ -n "$EXPECTED_PRODUCER_SHA256" ] || fail 'missing-expected-producer-sha256'
[ -n "$EXPECTED_COVERAGE_SCOPE_SHA256" ] || fail 'missing-expected-coverage-scope-sha256'
[ -n "$EXPECTED_COVERAGE_SPEC_SHA256" ] || fail 'missing-expected-coverage-spec-sha256'
valid_sha256 "$EXPECTED_RUNNER_SHA256" || fail 'expected-runner-sha256-invalid'
valid_sha256 "$EXPECTED_PRODUCER_SHA256" || fail 'expected-producer-sha256-invalid'
valid_sha256 "$EXPECTED_COVERAGE_SCOPE_SHA256" || fail 'expected-coverage-scope-sha256-invalid'
valid_sha256 "$EXPECTED_COVERAGE_SPEC_SHA256" || fail 'expected-coverage-spec-sha256-invalid'
[ "$REQUEST_PRODUCT" = "$PRODUCT" ] || fail 'wrong-product'
[ "$ROW_ONE" = "$RV32_ROW" ] && [ "$ROW_TWO" = "$RV64_ROW" ] || fail 'required-rows-not-exact'
case "$RUN_ID" in ''|*[!A-Za-z0-9_-]*) fail 'run-id-unsafe' ;; esac
[ "${#RUN_ID}" -le 128 ] || fail 'run-id-unsafe'
safe_relative_path "$SCRATCH_DIR" || fail 'scratch-path-unsafe'
safe_relative_path "$MANIFEST" || fail 'manifest-path-unsafe'
case "$SCRATCH_DIR" in "$SCRATCH_PARENT"/*) : ;; *) fail 'scratch-path-not-private' ;; esac
[ "$MANIFEST" = "$SCRATCH_DIR/qualification_manifest.env" ] || fail 'manifest-path-not-fixed'

BOOTSTRAP_STAGE3_FACADE_PATH=$ROOT_DIR/scripts/check/lib/bootstrap-stage3-provenance.shs
STAGE4_PROVENANCE_HELPER_PATH=$ROOT_DIR/scripts/check/lib/stage4-candidate-provenance.shs
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"

simple=$(bootstrap_stage3_canonical_file "$STAGE4_CLI") || fail 'stage4-cli-missing-symlinked-or-noncanonical'
[ -x "$simple" ] || fail 'stage4-cli-not-executable'
provenance=$(bootstrap_stage3_canonical_file "$STAGE4_PROVENANCE") || fail 'stage4-provenance-missing-symlinked-or-noncanonical'
[ "$provenance" = "$simple.provenance.env" ] || fail 'stage4-provenance-not-adjacent'
stage4_verify_candidate_provenance "$provenance" "$simple" "$ROOT_DIR" || fail 'stage4-cli-provenance-not-admitted'
command -v ghdl >/dev/null 2>&1 || fail 'ghdl-missing'

scratch_abs=$ROOT_DIR/$SCRATCH_DIR
manifest_abs=$ROOT_DIR/$MANIFEST
[ -d "$scratch_abs" ] && [ ! -L "$scratch_abs" ] || fail 'scratch-missing-symlinked-or-not-directory'
scratch_canonical=$(bootstrap_stage3_canonical_path "$scratch_abs") || fail 'scratch-noncanonical'
[ "$scratch_canonical" = "$scratch_abs" ] || fail 'scratch-path-changed'
[ ! -e "$manifest_abs" ] && [ ! -L "$manifest_abs" ] || fail 'manifest-already-exists'
[ ! -e "$ROOT_DIR/$FINAL_PARENT/$RUN_ID" ] && [ ! -L "$ROOT_DIR/$FINAL_PARENT/$RUN_ID" ] || fail 'final-run-directory-preexists'
cli_rel=$(root_relative_file "$simple") || fail 'stage4-cli-outside-repository'
provenance_rel=$(root_relative_file "$provenance") || fail 'stage4-provenance-outside-repository'
cli_sha256=$(sha_file "$simple") || fail 'stage4-cli-hash-failed'
provenance_sha256=$(sha_file "$provenance") || fail 'stage4-provenance-hash-failed'
postbootstrap_log_rel=$SCRATCH_DIR/postbootstrap-stage4-sspec.log
vhdl_cli_rel=$SCRATCH_DIR/qualified-tools/simple_vhdl_gen2
vhdl_cli_build_log_rel=$SCRATCH_DIR/qualified-tools/vhdl-build.log
receipt_cli_rel=$SCRATCH_DIR/qualified-tools/simple_riscv_gen2_receipt
receipt_cli_build_log_rel=$SCRATCH_DIR/qualified-tools/receipt-build.log
postbootstrap_log=$ROOT_DIR/$postbootstrap_log_rel
vhdl_cli=$ROOT_DIR/$vhdl_cli_rel
vhdl_cli_build_log=$ROOT_DIR/$vhdl_cli_build_log_rel
receipt_cli=$ROOT_DIR/$receipt_cli_rel
receipt_cli_build_log=$ROOT_DIR/$receipt_cli_build_log_rel
[ -f "$postbootstrap_log" ] && [ ! -L "$postbootstrap_log" ] || fail 'postbootstrap-log-missing-or-symlinked'
[ -f "$vhdl_cli" ] && [ ! -L "$vhdl_cli" ] && [ -x "$vhdl_cli" ] || fail 'vhdl-cli-missing-symlinked-or-not-executable'
vhdl_cli_canonical=$(bootstrap_stage3_canonical_file "$vhdl_cli") || fail 'vhdl-cli-noncanonical'
[ "$vhdl_cli_canonical" = "$vhdl_cli" ] || fail 'vhdl-cli-path-changed'
[ -f "$vhdl_cli_build_log" ] && [ ! -L "$vhdl_cli_build_log" ] || fail 'vhdl-cli-build-log-missing-or-symlinked'
[ -f "$receipt_cli" ] && [ ! -L "$receipt_cli" ] && [ -x "$receipt_cli" ] || fail 'receipt-cli-missing-symlinked-or-not-executable'
receipt_cli_canonical=$(bootstrap_stage3_canonical_file "$receipt_cli") || fail 'receipt-cli-noncanonical'
[ "$receipt_cli_canonical" = "$receipt_cli" ] || fail 'receipt-cli-path-changed'
[ -f "$receipt_cli_build_log" ] && [ ! -L "$receipt_cli_build_log" ] || fail 'receipt-cli-build-log-missing-or-symlinked'
postbootstrap_log_sha256=$(sha_file "$postbootstrap_log") || fail 'postbootstrap-log-hash-failed'
vhdl_cli_sha256=$(sha_file "$vhdl_cli") || fail 'vhdl-cli-hash-failed'
vhdl_cli_build_log_sha256=$(sha_file "$vhdl_cli_build_log") || fail 'vhdl-cli-build-log-hash-failed'
receipt_cli_sha256=$(sha_file "$receipt_cli") || fail 'receipt-cli-hash-failed'
receipt_cli_build_log_sha256=$(sha_file "$receipt_cli_build_log") || fail 'receipt-cli-build-log-hash-failed'
ghdl=$(bootstrap_stage3_canonical_file "$GHDL_BIN") || fail 'ghdl-missing-symlinked-or-noncanonical'
[ "$ghdl" = "$GHDL_BIN" ] && [ -x "$ghdl" ] || fail 'ghdl-path-changed-or-not-executable'
ghdl_sha256=$(sha_file "$ghdl") || fail 'ghdl-hash-failed'
ghdl_version=$scratch_abs/ghdl.version
"$ghdl" --version > "$ghdl_version" 2>&1 || fail 'ghdl-version-failed'
[ -s "$ghdl_version" ] && [ ! -L "$ghdl_version" ] || fail 'ghdl-version-empty-or-symlinked'
ghdl_version_sha256=$(sha_file "$ghdl_version") || fail 'ghdl-version-hash-failed'
source_revision=$(bootstrap_stage3_manifest_value source_revision "$provenance") || fail 'source-revision-missing'
printf '%s\n' "$source_revision" | awk 'length($0) == 64 && $0 ~ /^[0-9a-fA-F]+$/ { ok = 1 } END { exit !ok }' || fail 'source-revision-invalid'
runner=$ROOT_DIR/$QUALIFICATION_RUNNER
producer=$ROOT_DIR/$QUALIFICATION_PRODUCER
coverage_scope=$ROOT_DIR/$COVERAGE_SCOPE
[ -f "$runner" ] && [ ! -L "$runner" ] && [ -x "$runner" ] || fail 'qualification-runner-missing-symlinked-or-not-executable'
[ -f "$producer" ] && [ ! -L "$producer" ] && [ -x "$producer" ] || fail 'qualification-producer-missing-symlinked-or-not-executable'
[ -f "$coverage_scope" ] && [ ! -L "$coverage_scope" ] || fail 'coverage-scope-missing-or-symlinked'
runner_canonical=$(bootstrap_stage3_canonical_file "$runner") || fail 'qualification-runner-noncanonical'
producer_canonical=$(bootstrap_stage3_canonical_file "$producer") || fail 'qualification-producer-noncanonical'
coverage_scope_canonical=$(bootstrap_stage3_canonical_file "$coverage_scope") || fail 'coverage-scope-noncanonical'
[ "$runner_canonical" = "$runner" ] || fail 'qualification-runner-path-changed'
[ "$producer_canonical" = "$producer" ] || fail 'qualification-producer-path-changed'
[ "$coverage_scope_canonical" = "$coverage_scope" ] || fail 'coverage-scope-path-changed'
producer_invocation=$(bootstrap_stage3_canonical_file "$0") || fail 'qualification-producer-invocation-noncanonical'
[ "$producer_invocation" = "$producer" ] || fail 'qualification-producer-invocation-not-fixed'
runner_sha256=$(sha_file "$runner") || fail 'qualification-runner-hash-failed'
producer_sha256=$(sha_file "$producer") || fail 'qualification-producer-hash-failed'
coverage_scope_sha256=$(sha_file "$coverage_scope") || fail 'coverage-scope-hash-failed'
[ "$runner_sha256" = "$EXPECTED_RUNNER_SHA256" ] || fail 'qualification-runner-hash-changed-before-producer'
[ "$producer_sha256" = "$EXPECTED_PRODUCER_SHA256" ] || fail 'qualification-producer-hash-changed-before-producer'
[ "$coverage_scope_sha256" = "$EXPECTED_COVERAGE_SCOPE_SHA256" ] || fail 'coverage-scope-hash-changed-before-producer'
scope_state=$scratch_abs/coverage-scope
parse_coverage_scope "$coverage_scope" "$scope_state" || fail 'coverage-scope-invalid'
COVERAGE_SPEC=$(sed -n '1p' "$scope_state/coverage_spec")
SCOPE_OWNER_LIST=$scope_state/coverage_owners
safe_relative_path "$COVERAGE_SPEC" || fail 'coverage-spec-path-unsafe'
coverage_spec=$ROOT_DIR/$COVERAGE_SPEC
[ -f "$coverage_spec" ] && [ ! -L "$coverage_spec" ] || fail 'coverage-spec-missing-or-symlinked'
coverage_spec_canonical=$(bootstrap_stage3_canonical_file "$coverage_spec") || fail 'coverage-spec-noncanonical'
[ "$coverage_spec_canonical" = "$coverage_spec" ] || fail 'coverage-spec-path-changed'
coverage_spec_sha256=$(sha_file "$coverage_spec") || fail 'coverage-spec-hash-failed'
[ "$coverage_spec_sha256" = "$EXPECTED_COVERAGE_SPEC_SHA256" ] || fail 'coverage-spec-hash-changed-before-producer'

run_product() {
    arch=$1 target=$2 profile=$3 entity=$4 address_bits=$5 xlen=$6 pc_literal=$7 selected_parcel=$8 selected_canonical=$9 selected_assertion=${10}
    vhdl_rel=$SCRATCH_DIR/$arch.vhd
    vhdl=$ROOT_DIR/$vhdl_rel
    product_manifest_rel=$vhdl_rel.gen.json
    product_manifest=$ROOT_DIR/$product_manifest_rel
    compile_log=$scratch_abs/$arch.compile.log
    compile_command=$scratch_abs/$arch.compile.command
    analyze_log=$scratch_abs/$arch.analyze.log
    analyze_command=$scratch_abs/$arch.analyze.command
    elaborate_log=$scratch_abs/$arch.elaborate.log
    elaborate_command=$scratch_abs/$arch.elaborate.command
    run_log=$scratch_abs/$arch.run.log
    run_command=$scratch_abs/$arch.run.command
    tb=$scratch_abs/$arch.qualification_tb.vhd
    tb_entity=${arch}_riscv_gen2_qualification_tb
    workdir=$scratch_abs/$arch.ghdl-work
    marker=GEN2_${arch}_QUALIFICATION_TB_PASS
    [ ! -e "$vhdl" ] && [ ! -e "$product_manifest" ] && [ ! -e "$tb" ] || fail "row-artifact-preexists:$arch"
    printf 'SIMPLE_SAFETY_PROFILE=critical %s --riscv-gen2-product %s --riscv-gen2-target %s --output %s\n' "$vhdl_cli_rel" "$PRODUCT" "$target" "$vhdl_rel" > "$compile_command"
    SIMPLE_SAFETY_PROFILE=critical "$vhdl_cli" --riscv-gen2-product "$PRODUCT" --riscv-gen2-target "$target" --output "$vhdl_rel" > "$compile_log" 2>&1 || fail "product-compile-failed:$arch"
    [ -f "$vhdl" ] && [ ! -L "$vhdl" ] && [ -s "$vhdl" ] || fail "vhdl-missing:$arch"
    [ -f "$product_manifest" ] && [ ! -L "$product_manifest" ] && [ -s "$product_manifest" ] || fail "product-manifest-missing:$arch"
    require_manifest_text "$product_manifest" "\"entry_entity\":\"$entity\"" "$arch-entry-entity"
    require_manifest_text "$product_manifest" '"generation_route":"hwir-gen2-trap-stateful-product-v3"' "$arch-generation-route"
    require_manifest_text "$product_manifest" "\"config_profile\":\"$profile\"" "$arch-profile"
    # Physical-address width is a testbench-only concern.  The emitted
    # compiler-product target is the architectural XLEN closure.
    require_manifest_text "$product_manifest" "\"target\":{\"name\":\"riscv$xlen\",\"xlen\":$xlen,\"profile\":\"$profile\"}" "$arch-target"
    require_manifest_text "$product_manifest" '"source_closure":[]' "$arch-source-closure"
    require_manifest_text "$product_manifest" '"implementation_scope":"frontend-predecode-only"' "$arch-implementation-scope"
    require_manifest_text "$product_manifest" '"assurance_policy":{' "$arch-assurance-policy"
    source_identity=$(json_hash "$product_manifest" source_closure_sha256) || fail "source-identity-missing:$arch"
    graph_identity=$(json_hash "$product_manifest" graph_sha256) || fail "graph-identity-missing:$arch"
    assurance_policy_hash=$(json_hash "$product_manifest" policy_hash) || fail "assurance-policy-hash-missing:$arch"
    require_manifest_text "$product_manifest" "\"hwir\":{\"module_node_id\":\"$entity:module\",\"config_profile\":\"$profile\",\"graph_sha256\":\"$graph_identity\"}" "$arch-hwir-closure"
    require_manifest_text "$product_manifest" "\"sha256\":\"$vhdl_cli_sha256\"" "$arch-compiler-sha"
    grep -Fq "entity $entity is" "$vhdl" || fail "vhdl-entity-missing:$arch"
    grep -Fq "route=hwir-gen2-trap-stateful-product-v3 profile=$profile graph=$graph_identity" "$vhdl" || fail "vhdl-provenance-missing:$arch"
    write_testbench "$tb" "$entity" "$tb_entity" "$address_bits" "$xlen" "$pc_literal" "$marker" "$selected_parcel" "$selected_canonical" "$selected_assertion"
    mkdir "$workdir" || fail "ghdl-workdir-create-failed:$arch"
    printf '%s -a --std=08 --workdir=%s %s && %s -a --std=08 --workdir=%s %s\n' "$ghdl" "$workdir" "$vhdl_rel" "$ghdl" "$workdir" "${tb#"$ROOT_DIR"/}" > "$analyze_command"
    "$ghdl" -a --std=08 --workdir="$workdir" "$vhdl" > "$analyze_log" 2>&1 || fail "ghdl-analyze-product-failed:$arch"
    "$ghdl" -a --std=08 --workdir="$workdir" "$tb" >> "$analyze_log" 2>&1 || fail "ghdl-analyze-testbench-failed:$arch"
    printf '%s -e --std=08 --workdir=%s %s\n' "$ghdl" "$workdir" "$tb_entity" > "$elaborate_command"
    "$ghdl" -e --std=08 --workdir="$workdir" "$tb_entity" > "$elaborate_log" 2>&1 || fail "ghdl-elaborate-failed:$arch"
    printf '%s -r --std=08 --workdir=%s %s --stop-time=100ns\n' "$ghdl" "$workdir" "$tb_entity" > "$run_command"
    "$ghdl" -r --std=08 --workdir="$workdir" "$tb_entity" --stop-time=100ns > "$run_log" 2>&1 || fail "ghdl-run-failed:$arch"
    grep -Fq "$marker" "$run_log" || fail "ghdl-pass-marker-missing:$arch"
    eval "ROW_${arch}_COMMAND=\$(tr '\\n' ' ' < \"$compile_command\" | sed 's/[[:space:]]*$//')"
    eval "ROW_${arch}_MANIFEST=$product_manifest_rel"
    eval "ROW_${arch}_VHDL=$vhdl_rel"
    eval "ROW_${arch}_ANALYZE=${SCRATCH_DIR}/$arch.analyze.log"
    eval "ROW_${arch}_ELABORATE=${SCRATCH_DIR}/$arch.elaborate.log"
    eval "ROW_${arch}_RUN=${SCRATCH_DIR}/$arch.run.log"
    eval "ROW_${arch}_TESTBENCH=${SCRATCH_DIR}/$arch.qualification_tb.vhd"
    eval "ROW_${arch}_COMPILE_COMMAND=${SCRATCH_DIR}/$arch.compile.command"
    eval "ROW_${arch}_ANALYZE_COMMAND=${SCRATCH_DIR}/$arch.analyze.command"
    eval "ROW_${arch}_ELABORATE_COMMAND=${SCRATCH_DIR}/$arch.elaborate.command"
    eval "ROW_${arch}_RUN_COMMAND=${SCRATCH_DIR}/$arch.run.command"
    eval "ROW_${arch}_SOURCE_IDENTITY=$source_identity"
    eval "ROW_${arch}_CONFIG_IDENTITY=\$(printf 'product=%s\\ntarget=%s\\nprofile=%s\\nentity=%s\\n' \"$PRODUCT\" \"$target\" \"$profile\" \"$entity\" | bootstrap_stage3_hash_stream)"
    eval "ROW_${arch}_GRAPH_IDENTITY=$graph_identity"
}

cd "$ROOT_DIR" || fail 'repository-root-unavailable'
run_product rv32 "$RV32_ROW" "$RV32_PROFILE" "$RV32_ENTITY" 32 32 'x"00000100"' 'x"2001"' 'x"000000EF"' "redirect_valid='1' and redirect_target=x\"00000100\" and next_pc=x\"00000100\" and trap_valid='0'"
run_product rv64 "$RV64_ROW" "$RV64_PROFILE" "$RV64_ENTITY" 56 64 'x"00000000000100"' 'x"2085"' 'x"0010809B"' "redirect_valid='0' and redirect_target=x\"00000000000100\" and next_pc=x\"00000000000102\" and trap_valid='0'"

coverage_capture_raw=$scratch_abs/branch_coverage.capture.sdn
coverage_raw=$scratch_abs/branch_coverage.sdn
coverage_log=$scratch_abs/branch_coverage.log
coverage_command=$scratch_abs/branch_coverage.command
printf 'SIMPLE_COVERAGE=1 SIMPLE_COVERAGE_OUTPUT=%s %s test %s --coverage --mode=native --no-cache\n' "${coverage_capture_raw#"$ROOT_DIR"/}" "$cli_rel" "$COVERAGE_SPEC" > "$coverage_command"
SIMPLE_COVERAGE=1 SIMPLE_COVERAGE_OUTPUT="${coverage_capture_raw#"$ROOT_DIR"/}" "$simple" test "$COVERAGE_SPEC" --coverage --mode=native --no-cache > "$coverage_log" 2>&1 || fail 'focused-coverage-command-failed'
[ -f "$coverage_capture_raw" ] && [ ! -L "$coverage_capture_raw" ] && [ -s "$coverage_capture_raw" ] || fail 'coverage-artifact-missing'
if scope_coverage_sdn "$coverage_capture_raw" "$coverage_raw"; then
    :
else
    scope_status=$?
    case "$scope_status" in
        2) fail 'coverage-path-malformed' ;;
        3) fail 'coverage-owner-unrecognized' ;;
        4) fail 'coverage-owner-missing-decision' ;;
        *) fail 'coverage-format-invalid' ;;
    esac
fi
[ -f "$coverage_raw" ] && [ ! -L "$coverage_raw" ] && [ -s "$coverage_raw" ] || fail 'coverage-scoped-artifact-missing'
coverage_summary=$(coverage_basis_points "$coverage_raw") || fail 'coverage-decisions-missing'
set -- $coverage_summary
coverage_covered=$1 coverage_total=$2 coverage_bp=$3
[ "$coverage_bp" -ge 8000 ] || fail 'branch-coverage-below-8000bp'
printf 'coverage_spec=%s\ncoverage_raw_sha256=%s\nbranch_outcomes_covered=%s\nbranch_outcomes_total=%s\nbranch_coverage_basis_points=%s\n' "$COVERAGE_SPEC" "$(sha_file "$coverage_raw")" "$coverage_covered" "$coverage_total" "$coverage_bp" >> "$coverage_log"
coverage_sha256=$(sha_file "$coverage_log") || fail 'coverage-log-hash-failed'

row_hash() { sha_file "$ROOT_DIR/$1" || fail "artifact-hash-failed:$1"; }
manifest_tmp=$manifest_abs.tmp.$$
umask 077
{
    printf '%s\n' 'schema=riscv-gen2-hwir-qualification-run-v4'
    printf '%s\n' 'status=passed'
    printf 'cli_path=%s\ncli_sha256=%s\ncli_provenance_path=%s\ncli_provenance_sha256=%s\nsource_revision=%s\n' "$cli_rel" "$cli_sha256" "$provenance_rel" "$provenance_sha256" "$source_revision"
    printf 'runner_path=%s\nrunner_sha256=%s\nproducer_path=%s\nproducer_sha256=%s\ncoverage_spec_path=%s\ncoverage_spec_sha256=%s\ncoverage_scope_path=%s\ncoverage_scope_sha256=%s\n' "$QUALIFICATION_RUNNER" "$runner_sha256" "$QUALIFICATION_PRODUCER" "$producer_sha256" "$COVERAGE_SPEC" "$coverage_spec_sha256" "$COVERAGE_SCOPE" "$coverage_scope_sha256"
    printf 'postbootstrap_log_path=%s\npostbootstrap_log_sha256=%s\nvhdl_cli_path=%s\nvhdl_cli_sha256=%s\nvhdl_cli_build_log_path=%s\nvhdl_cli_build_log_sha256=%s\nreceipt_cli_path=%s\nreceipt_cli_sha256=%s\nreceipt_cli_build_log_path=%s\nreceipt_cli_build_log_sha256=%s\n' "$postbootstrap_log_rel" "$postbootstrap_log_sha256" "$vhdl_cli_rel" "$vhdl_cli_sha256" "$vhdl_cli_build_log_rel" "$vhdl_cli_build_log_sha256" "$receipt_cli_rel" "$receipt_cli_sha256" "$receipt_cli_build_log_rel" "$receipt_cli_build_log_sha256"
    printf 'ghdl_path=%s\nghdl_sha256=%s\nghdl_version_path=%s\nghdl_version_sha256=%s\n' "$ghdl" "$ghdl_sha256" "${ghdl_version#"$ROOT_DIR"/}" "$ghdl_version_sha256"
    printf 'coverage_kind=branch\nbranch_coverage_threshold_basis_points=8000\nbranch_coverage_basis_points=%s\nbranch_coverage_log_path=%s\nbranch_coverage_log_sha256=%s\nbranch_coverage_raw_path=%s\nbranch_coverage_raw_sha256=%s\n' "$coverage_bp" "$SCRATCH_DIR/branch_coverage.log" "$coverage_sha256" "${coverage_raw#"$ROOT_DIR"/}" "$(sha_file "$coverage_raw")"
    printf 'row_1_architecture=rv32\nrow_1_product_id=%s\nrow_1_target=%s\nrow_1_profile=%s\nrow_1_command=%s\nrow_1_exit_code=0\n' "$PRODUCT" "$RV32_ROW" "$RV32_PROFILE" "$ROW_rv32_COMMAND"
    printf 'row_1_manifest_path=%s\nrow_1_manifest_sha256=%s\nrow_1_vhdl_path=%s\nrow_1_vhdl_sha256=%s\nrow_1_testbench_path=%s\nrow_1_testbench_sha256=%s\nrow_1_compile_command_path=%s\nrow_1_compile_command_sha256=%s\nrow_1_analyze_command_path=%s\nrow_1_analyze_command_sha256=%s\nrow_1_elaborate_command_path=%s\nrow_1_elaborate_command_sha256=%s\nrow_1_run_command_path=%s\nrow_1_run_command_sha256=%s\nrow_1_analyze_log_path=%s\nrow_1_analyze_log_sha256=%s\nrow_1_elaborate_log_path=%s\nrow_1_elaborate_log_sha256=%s\nrow_1_run_log_path=%s\nrow_1_run_log_sha256=%s\nrow_1_source_identity_sha256=%s\nrow_1_config_identity_sha256=%s\nrow_1_graph_identity_sha256=%s\n' "$ROW_rv32_MANIFEST" "$(row_hash "$ROW_rv32_MANIFEST")" "$ROW_rv32_VHDL" "$(row_hash "$ROW_rv32_VHDL")" "$ROW_rv32_TESTBENCH" "$(row_hash "$ROW_rv32_TESTBENCH")" "$ROW_rv32_COMPILE_COMMAND" "$(row_hash "$ROW_rv32_COMPILE_COMMAND")" "$ROW_rv32_ANALYZE_COMMAND" "$(row_hash "$ROW_rv32_ANALYZE_COMMAND")" "$ROW_rv32_ELABORATE_COMMAND" "$(row_hash "$ROW_rv32_ELABORATE_COMMAND")" "$ROW_rv32_RUN_COMMAND" "$(row_hash "$ROW_rv32_RUN_COMMAND")" "$ROW_rv32_ANALYZE" "$(row_hash "$ROW_rv32_ANALYZE")" "$ROW_rv32_ELABORATE" "$(row_hash "$ROW_rv32_ELABORATE")" "$ROW_rv32_RUN" "$(row_hash "$ROW_rv32_RUN")" "$ROW_rv32_SOURCE_IDENTITY" "$ROW_rv32_CONFIG_IDENTITY" "$ROW_rv32_GRAPH_IDENTITY"
    printf 'row_2_architecture=rv64\nrow_2_product_id=%s\nrow_2_target=%s\nrow_2_profile=%s\nrow_2_command=%s\nrow_2_exit_code=0\n' "$PRODUCT" "$RV64_ROW" "$RV64_PROFILE" "$ROW_rv64_COMMAND"
    printf 'row_2_manifest_path=%s\nrow_2_manifest_sha256=%s\nrow_2_vhdl_path=%s\nrow_2_vhdl_sha256=%s\nrow_2_testbench_path=%s\nrow_2_testbench_sha256=%s\nrow_2_compile_command_path=%s\nrow_2_compile_command_sha256=%s\nrow_2_analyze_command_path=%s\nrow_2_analyze_command_sha256=%s\nrow_2_elaborate_command_path=%s\nrow_2_elaborate_command_sha256=%s\nrow_2_run_command_path=%s\nrow_2_run_command_sha256=%s\nrow_2_analyze_log_path=%s\nrow_2_analyze_log_sha256=%s\nrow_2_elaborate_log_path=%s\nrow_2_elaborate_log_sha256=%s\nrow_2_run_log_path=%s\nrow_2_run_log_sha256=%s\nrow_2_source_identity_sha256=%s\nrow_2_config_identity_sha256=%s\nrow_2_graph_identity_sha256=%s\n' "$ROW_rv64_MANIFEST" "$(row_hash "$ROW_rv64_MANIFEST")" "$ROW_rv64_VHDL" "$(row_hash "$ROW_rv64_VHDL")" "$ROW_rv64_TESTBENCH" "$(row_hash "$ROW_rv64_TESTBENCH")" "$ROW_rv64_COMPILE_COMMAND" "$(row_hash "$ROW_rv64_COMPILE_COMMAND")" "$ROW_rv64_ANALYZE_COMMAND" "$(row_hash "$ROW_rv64_ANALYZE_COMMAND")" "$ROW_rv64_ELABORATE_COMMAND" "$(row_hash "$ROW_rv64_ELABORATE_COMMAND")" "$ROW_rv64_RUN_COMMAND" "$(row_hash "$ROW_rv64_RUN_COMMAND")" "$ROW_rv64_ANALYZE" "$(row_hash "$ROW_rv64_ANALYZE")" "$ROW_rv64_ELABORATE" "$(row_hash "$ROW_rv64_ELABORATE")" "$ROW_rv64_RUN" "$(row_hash "$ROW_rv64_RUN")" "$ROW_rv64_SOURCE_IDENTITY" "$ROW_rv64_CONFIG_IDENTITY" "$ROW_rv64_GRAPH_IDENTITY"
} > "$manifest_tmp"
[ -s "$manifest_tmp" ] && [ ! -L "$manifest_tmp" ] || fail 'manifest-build-failed'
mv "$manifest_tmp" "$manifest_abs" || fail 'manifest-install-failed'
[ ! -e "$ROOT_DIR/$FINAL_PARENT/$RUN_ID" ] && [ ! -L "$ROOT_DIR/$FINAL_PARENT/$RUN_ID" ] || fail 'producer-created-final-evidence-forbidden'
printf '%s\n' 'riscv_gen2_hwir_producer_status=pass'
printf '%s\n' "riscv_gen2_hwir_producer_manifest=$MANIFEST"
