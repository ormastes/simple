#!/bin/sh
set -eu
r=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd); o=${1:-/mnt/data/pg-dispatch-port}; mkdir -p "$o"
cc -std=gnu11 -O1 -ffunction-sections "$r/src/runtime/test/rt_pg_dispatch_port_selfcheck.c" "$r/src/runtime/runtime_db.c" -Wl,--gc-sections -pthread -o "$o/check"
"$o/check" | tee "$o/receipt.txt"
