#!/bin/sh
# check-stage4-dynamic-runtime-lane.shs
#
# The Stage4 self-hosted compiler entry must be able to link the SHARED runtime
# (`libsimple_runtime.so`) instead of being forced onto the static core-C
# archive.
#
# WHY THIS GATE EXISTS. `selected_runtime_library`
# (src/compiler_rust/compiler/src/pipeline/native_project/config.rs) used to
# short-circuit every authorized Stage4 compiler entry onto the core-C archive
# built by `build_core_c_runtime_library`, returning BEFORE the code that would
# consult any richer runtime, and hard-erroring
#   "Stage4 compiler entry requires the core-c-bootstrap runtime lane"
# for any other lane. That archive carries only the Simple/C core ABI, so the
# Stage4 link failed with 167 unresolved `rt_*` symbols that no
# `--runtime-path` / `SIMPLE_RUNTIME_PATH` setting could satisfy. Chasing them
# led into an LLVM libunwind question that is a dead end on the merits:
# `libunwind.so.8` defines ZERO `_Unwind_*` while `libgcc_s.so.1` defines 18,
# so the entry the link was being dragged toward could never have resolved them.
#
# The lane guard's own intent (6c97e5709ad) was anti-silent-substitution: an
# entry asking for a lane it will not get must be TOLD, never re-routed behind
# its back. `dynamic-runtime` honours that intent -- it is an explicit, named
# request answered with exactly the runtime it named.
#
# WHAT IS CHECKED, and why it drives the real binary rather than `cargo test`.
# The `simple-compiler` lib-test target does not currently compile on this
# branch for reasons unrelated to this lane (a pre-existing `intersection` call
# on a `BTreeMap` in `native_project/tests.rs`), so a `cargo test` gate would
# report ERROR forever and check nothing. This gate instead exercises the
# deployed seed end to end, which is also the stronger evidence:
#
#   1. the `--runtime-bundle dynamic-runtime` name is ACCEPTED by the CLI.
#      Pre-fix the driver's allowlist rejected it outright with
#      "invalid --runtime-bundle value", before lane resolution ever ran.
#   2. the lane is REFUSED, by name, for an entry that is not the Stage4
#      compiler. Pre-fix that refusal message did not exist, because the lane
#      did not exist; post-fix it proves the blast radius is one entry and the
#      freestanding / core-C / simple-core / host-gpu lanes are untouched.
#
# Both are POSITIVE assertions on observed output, not "the bad string is
# absent", so neither can pass vacuously.
#
# Verdict is the LAST line of stdout, per this repo's guard convention:
#   PASS  -- <n> assertion(s) checked, ...      exit 0
#   FAIL  -- ...                                exit 1
#   ERROR -- nothing was checked (<reason>)     exit 2
# A run that executed 0 assertions is ERROR, never a pass, and a missing seed
# binary is ERROR: absence of something to test is absence of evidence.

set -u

repo_root=$(cd "$(dirname "$0")/../.." && pwd)

# Locate a seed/compiler binary. An explicit SIMPLE_SEED_BIN wins so a lane can
# point at the binary it just built; otherwise try the conventional locations.
seed="${SIMPLE_SEED_BIN:-}"
if [ -z "$seed" ]; then
  for candidate in \
    "$repo_root/src/compiler_rust/target/bootstrap/simple" \
    "$repo_root/src/compiler_rust/target/release/simple" \
    "$repo_root/bin/simple"
  do
    if [ -x "$candidate" ]; then seed="$candidate"; break; fi
  done
fi

if [ -z "$seed" ] || [ ! -x "$seed" ]; then
  echo "ERROR — nothing was checked (no seed binary; set SIMPLE_SEED_BIN to one that can run native-build)"
  exit 2
fi

# Run from the repo root: the core-C lane resolves its runtime SOURCES relative
# to the checkout (find_core_c_runtime_source_root), so an arbitrary cwd makes
# the control in assertion 3 fail for a reason that has nothing to do with the
# lane under test.
cd "$repo_root" || { echo "ERROR — nothing was checked (cannot cd to $repo_root)"; exit 2; }

# The fixture lives UNDER the checkout, not in /tmp: a --source directory
# outside the repo root does not resolve, so an out-of-tree fixture fails for a
# reason unrelated to the lane. `build/` is gitignored, so nothing is left
# tracked.
tmp="$repo_root/build/.dynamic-runtime-lane-check-$$"
mkdir -p "$tmp" || { echo "ERROR — nothing was checked (cannot create $tmp)"; exit 2; }
cleanup() { rm -rf "$tmp"; }
trap cleanup EXIT INT TERM

# A non-Stage4 entry, used by assertion 2. It must COMPILE cleanly, otherwise
# the build dies in an earlier phase and never reaches runtime selection, which
# is the thing under test -- a self-contained hello world is the shape that
# survives to the link.
mkdir -p "$tmp/src" "$tmp/rt"
printf 'fn main() -> i64:\n    print("lane probe")\n    return 0\n' > "$tmp/src/hello.spl"
# A placeholder shared runtime: assertion 2 must fail on the LANE SCOPE, not on
# a missing library, so the library has to be findable.
printf 'placeholder' > "$tmp/rt/libsimple_runtime.so"

checked=0
failures=""

# --- Assertion 1: the CLI accepts the bundle name -------------------------
out1=$(SIMPLE_BOOTSTRAP=1 SIMPLE_NO_DEPRECATED_WARNINGS=1 "$seed" native-build \
        --runtime-bundle dynamic-runtime \
        --source "$tmp/src" --entry "$tmp/src/hello.spl" --entry-closure \
        --backend llvm-lib --timeout 900 --threads 4 \
        --cache-dir "$tmp/cache" \
        --runtime-path "$tmp/rt" -o "$tmp/out1" 2>&1)
checked=$((checked + 1))
if printf '%s' "$out1" | grep -q "invalid --runtime-bundle value"; then
  failures="${failures} bundle-name-rejected-by-cli"
fi

# --- Assertion 2: the lane is refused for a non-Stage4 entry ---------------
#
# Asserted DIFFERENTIALLY, on whether a binary is produced, not on the refusal
# text. The refusal is raised inside the native-build WORKER, and the parent
# process discards the worker's stderr -- it reports only "native-build worker
# exited with code 1". That swallowing is a pre-existing diagnostic gap in the
# seed, filed as
# doc/08_tracking/bug/native_build_worker_stderr_swallowed_2026-09-06.md; this
# gate must not depend on text it cannot see.
#
# The same fixture on `core-c-bootstrap` DOES produce a binary, so "no binary on
# the dynamic lane" isolates the lane decision rather than a broken fixture.
# That control is assertion 3.
checked=$((checked + 1))
if [ -f "$tmp/out1" ]; then
  failures="${failures} non-stage4-entry-was-NOT-refused(binary-produced)"
fi

# --- Assertion 3: control -- the same fixture builds on the core-C lane ----
# Without this the check above could pass because the fixture never compiles,
# which is the "a scan that finds nothing may have scanned nothing" trap.
out2=$(SIMPLE_BOOTSTRAP=1 SIMPLE_NO_DEPRECATED_WARNINGS=1 "$seed" native-build \
        --runtime-bundle core-c-bootstrap \
        --source "$tmp/src" --entry "$tmp/src/hello.spl" --entry-closure \
        --backend llvm-lib --timeout 900 --threads 4 \
        --cache-dir "$tmp/cache" \
        -o "$tmp/out2" 2>&1)
checked=$((checked + 1))
if [ ! -f "$tmp/out2" ]; then
  failures="${failures} core-c-control-did-not-build(fixture-or-core-lane-broken)"
fi

if [ "$checked" -eq 0 ]; then
  echo "ERROR — nothing was checked (no assertion ran)"
  exit 2
fi

if [ -n "$failures" ]; then
  echo "--- native-build output ---"
  printf '%s\n' "$out1" | tail -20
  echo "FAIL — $checked assertion(s) checked, offending:${failures}"
  exit 1
fi

echo "PASS — $checked assertion(s) checked (CLI accepts dynamic-runtime; non-Stage4 entry refused on that lane; same fixture builds on core-c-bootstrap as control)"
exit 0
