# --- ANYVTJIT (2026-08-22): a bare method on an ERASED receiver (`x: Any`, a
# trait-typed parameter) is dispatched at runtime over the receiver's vtable
# identity instead of bailing the whole module with [CODEGEN-AMBIGUOUS-METHOD].
# That gate alone dropped the stage1 closure (BlockRegistry.register/
# register_block/with_block on `block_def: Any`) to the tree-walking
# interpreter. Two soundness fixes ride along and must not regress: a by-value
# copy of a vtable-bearing struct must include the 8-byte header, and a vtable
# slot pointing at a selfless body must go through its receiver-dropping thunk.
must_contain     "ANYVTJIT seed: vtable type switch emitted"      "$ROOT/src/compiler_rust/compiler/src/codegen/instr/closures_structs.rs" 'fn try_emit_vtable_type_switch<M: Module>('
must_contain     "ANYVTJIT seed: switch tried before refusing"    "$ROOT/src/compiler_rust/compiler/src/codegen/instr/closures_structs.rs" 'if try_emit_vtable_type_switch(ctx, builder, dest, receiver, args, method_part, &cands)? {'
must_contain     "ANYVTJIT seed: struct(Trait) records an impl"   "$ROOT/src/compiler_rust/compiler/src/hir/lower/module_lowering/module_pass.rs" 'if let Some(trait_name) = struct_implements_trait(s) {'
must_contain     "ANYVTJIT seed: aggregate copy keeps vtable hdr" "$ROOT/src/compiler_rust/compiler/src/codegen/instr/mod.rs" '*byte_size + 8, &shifted'
must_contain     "ANYVTJIT seed: selfless vtable slot thunked"    "$ROOT/src/compiler_rust/compiler/src/codegen/closure_boxed_entry.rs" 'pub fn emit_vtable_selfless_entries('
must_contain     "ANYVTJIT seed: no-bail test present"            "$ROOT/src/compiler_rust/compiler/tests/any_receiver_vtable_dispatch_jit.rs" 'must JIT-compile'
must_contain     "ANYVTJIT src: SmfReaderImpl declares the trait" "$ROOT/src/compiler/70.backend/linker/smf_reader.spl" 'impl SmfReader for SmfReaderImpl:'
echo ""
if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked (no mechanism rows ran)"
    exit 2
fi
if [ "$CHECKED" -lt "$ROW_FLOOR" ]; then
    echo "FAIL — $CHECKED mechanism(s) checked, below the monotonic floor $ROW_FLOOR"
    echo "  rows were deleted from this guard; recover them instead of lowering ROW_FLOOR"
    exit 1
fi
if [ "$FAILED" -ne 0 ]; then
    echo "FAIL — $CHECKED mechanism(s) checked, $FAILED regressed:$OFFENDERS"
    exit 1
fi
echo "PASS — $CHECKED mechanism(s) checked, 0 regressed"
exit 0
