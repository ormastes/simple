# (compiler_services.spl:168) no longer bails the WHOLE stage1 closure to the
# tree-walking interpreter (~30x/statement). The guard must stay narrowed to
# bodiless/extern names only.
must_contain     "FNREFJIT seed: fn-value boxed entries emitted"  "$ROOT/src/compiler_rust/compiler/src/codegen/common_backend.rs" 'self.emit_boxed_fn_value_entries(mir, &functions)?;'
