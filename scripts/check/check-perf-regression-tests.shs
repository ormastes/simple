#!/bin/sh
# check-perf-regression-tests.shs — umbrella gate for the perf fixes landed
# since 2026-08-14.
#
# WHY THIS EXISTS. A perf fix with no test is indistinguishable from a perf fix
# that has been reverted. On 2026-08-21 an audit found exactly that: commit
# 8f3efdfbd65 removed two O(n^2) steps from the test-manifest reindex, and
# f13adc2eca5 silently clobbered both of them with a stale snapshot while adding
# an unrelated forward change. `main` carried the quadratic reindex again for
# three days and every existing guard was green, because every one of them
# checks tree structure, symbols, or compilability — none of them knows what a
# fix was FOR.
#
# Each row below pins ONE landed perf fix by its MECHANISM: the identifier,
# call, or data structure whose absence IS the regression. A budget in wall time
# would be noise on this shared box; a mechanism pin is deterministic and would
# have caught the clobber the hour it landed.
#
# Verdict is the LAST line of stdout, same convention as the pre-push guards:
#   PASS — <n> mechanism(s) checked, 0 regressed     exit 0
#   FAIL — <n> mechanism(s) checked, <k> regressed   exit 1
#   ERROR — nothing was checked (<reason>)           exit 2
# A run that checked 0 mechanisms is ERROR, never a pass.
#
# --selftest runs first, unconditionally, and is fatal.

set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
# Monotonic row floor. On 2026-08-23 a stale-base rewrite (e24b2845b3b) silently
# dropped 48 mechanism rows from this file and the guard still reported PASS,
# because a smaller row set is indistinguishable from a passing one. The floor
# makes that class self-detecting: the count may only ever GROW. Raise it in the
# same commit that adds rows; lowering it requires a reviewed deletion.
ROW_FLOOR=131
CHECKED=0
FAILED=0
OFFENDERS=""

# must_contain <label> <file> <needle>
must_contain() {
    _label=$1; _file=$2; _needle=$3
    CHECKED=$((CHECKED + 1))
    if [ ! -f "$_file" ]; then
        echo "  MISSING FILE  $_label: $_file"
        FAILED=$((FAILED + 1)); OFFENDERS="$OFFENDERS $_label"; return
    fi
    if grep -qF -- "$_needle" "$_file"; then
        echo "  ok            $_label"
    else
        echo "  REGRESSED     $_label: '$_needle' absent from $_file"
        FAILED=$((FAILED + 1)); OFFENDERS="$OFFENDERS $_label"
    fi
}

# must_not_contain <label> <file> <needle>  (comment lines are ignored)
must_not_contain() {
    _label=$1; _file=$2; _needle=$3
    CHECKED=$((CHECKED + 1))
    if [ ! -f "$_file" ]; then
        echo "  MISSING FILE  $_label: $_file"
        FAILED=$((FAILED + 1)); OFFENDERS="$OFFENDERS $_label"; return
    fi
    if grep -v '^[[:space:]]*#' "$_file" | grep -v '^[[:space:]]*//' | grep -qF -- "$_needle"; then
        echo "  REGRESSED     $_label: '$_needle' is back in $_file"
        FAILED=$((FAILED + 1)); OFFENDERS="$OFFENDERS $_label"
    else
        echo "  ok            $_label"
    fi
}

selftest() {
    _d=$(mktemp -d) || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
    printf 'alpha\nbeta\n' > "$_d/good"
    printf '# alpha\nbeta\n' > "$_d/commented"
    _sc=$CHECKED; _sf=$FAILED; _so=$OFFENDERS
    CHECKED=0; FAILED=0; OFFENDERS=""
    must_contain     st1 "$_d/good"      alpha    >/dev/null
    must_contain     st2 "$_d/good"      gamma    >/dev/null   # must FAIL
    must_contain     st3 "$_d/nope"      alpha    >/dev/null   # must FAIL
    must_not_contain st4 "$_d/good"      gamma    >/dev/null
    must_not_contain st5 "$_d/good"      alpha    >/dev/null   # must FAIL
    must_not_contain st6 "$_d/commented" alpha    >/dev/null   # comment ignored -> pass
    rm -rf "$_d"
    if [ "$CHECKED" -ne 6 ] || [ "$FAILED" -ne 3 ]; then
        echo "ERROR — nothing was checked (selftest broken: checked=$CHECKED failed=$FAILED, want 6/3)"
        exit 2
    fi
    echo "selftest: 6 fixtures, 3 expected failures — ok"
    CHECKED=$_sc; FAILED=$_sf; OFFENDERS=$_so
}

selftest

echo "perf-regression mechanism pins:"

# --- 8f3efdfbd65 / restored 2026-08-21: test-manifest reindex O(n^2) ---
SCANNER="$ROOT/src/lib/nogc_sync_mut/test_runner/test_manifest_scanner.spl"
must_contain     "8f3efdfbd65 reindex path->index dict"        "$SCANNER" "old_index: {text: i64}"
must_contain     "8f3efdfbd65 sdoctest path->index dict"       "$SCANNER" "old_sd_index: {text: i64}"
must_not_contain "8f3efdfbd65 no linear manifest_find_entry"   "$SCANNER" "manifest_find_entry(old,"
must_not_contain "8f3efdfbd65 no linear find_sdoctest_entry"   "$SCANNER" "manifest_find_sdoctest_entry(old,"
must_not_contain "8f3efdfbd65 no struct-field push in walk"    "$SCANNER" "manifest.entries.push("
must_not_contain "8f3efdfbd65 no sdoctest struct-field push"   "$SCANNER" "manifest.sdoctest_entries.push("

# --- 7a6f6459a81: daemon backlog bypass had ZERO production call sites ---
must_contain "7a6f6459a81 backlog bypass wired into client" \
    "$ROOT/src/app/test_runner_new/test_runner_client.spl" "daemon_backlog_bypass"
must_contain "7a6f6459a81 backlog bypass policy spec" \
    "$ROOT/test/01_unit/app/test_runner_new/daemon_backlog_bypass_spec.spl" "daemon_backlog_bypass(0)"

# --- 8d3b7d009b9: native find() instead of per-character interpreted loops ---
EZRULES="$ROOT/src/lib/nogc_sync_mut/tooling/easy_fix/rules.spl"
must_contain "8d3b7d009b9 dup-args line fast reject"  "$EZRULES" "if not line.contains(sig.name):"
must_contain "8d3b7d009b9 native find in call scan"   "$EZRULES" "val rel = _tail.find(sig.name)"
must_contain "8d3b7d009b9 native find in text search" "$EZRULES" "val rel = _sfx.find(needle)"

# --- e73a0bec647 (and 408fb57b109, which it supersedes): CowEnv scope chain ---
must_contain "e73a0bec647 per-call env O(args) cargo test" \
    "$ROOT/src/compiler_rust/compiler/tests/interpreter_call_env_o_args.rs" \
    "per_call_env_setup_does_not_scale_with_module_global_count"
must_contain "e73a0bec647 ratio assertion is the pin" \
    "$ROOT/src/compiler_rust/compiler/tests/interpreter_call_env_o_args.rs" "ratio < 3.0"
# --- match-expression arm write-back is dirty-only (seed_match_expression_return_arm_statement_cost_cliff_2026-08-22) ---
MATCHCLIFF="$ROOT/src/compiler_rust/compiler/tests/interpreter_match_expr_post_statement_cost.rs"
must_contain "match-expr write-back: dirty-only in source" \
    "$ROOT/src/compiler_rust/compiler/src/interpreter/expr/control.rs" "block_exec::copy_back_block_writes(&arm_env, env)"
must_contain "match-expr write-back: ratio pin"  "$MATCHCLIFF" "ratio < 3.0"
must_contain "match-expr write-back: spec twin" \
    "$ROOT/test/01_unit/compiler/interpreter/match_expr_post_statement_cost_spec.spl" "floor * 3"

MEPUSH="$ROOT/src/compiler_rust/compiler/tests/interpreter_me_method_field_push_in_place.rs"
must_contain "me-method receiver released: counter pin"   "$MEPUSH" "assert_eq!(clones, 0"
must_contain "me-method receiver released: linear pin"    "$MEPUSH" "ratio < 9.0"
must_contain "me-method receiver moved (f8681a7afa6): args evaluated before the move" \
    "$ROOT/src/compiler_rust/compiler/src/interpreter_helpers/patterns.rs" "evaluate_call_args(args, env, functions, classes, enums, impl_methods)"

SHEMPTY="$ROOT/src/compiler_rust/compiler/tests/interpreter_shared_empty_captured_env.rs"
must_contain "shared empty captured env: holder-count pin" "$SHEMPTY" "after >= before + N"
must_contain "shared empty captured env: filter site uses it" \
    "$ROOT/src/compiler_rust/compiler/src/module_cache.rs" "captured_env: Env::shared_empty()"

FDMEMO="$ROOT/src/compiler_rust/compiler/tests/interpreter_filtered_module_dict_memo.rs"
must_contain "filtered module dict memo: hit-count pin" "$FDMEMO" "hits >= (IMPORTERS as u64) - 1"
must_contain "filtered module dict memo: memo keyed on source Arc" \
    "$ROOT/src/compiler_rust/compiler/src/module_cache.rs" "FILTERED_DICT_CACHE.with"

# --- a865dced154 / 5c783d9935d / 331c7d16d54: HIR registry sweep memos ---
HIRSPEC="$ROOT/test/01_unit/compiler/hir/hir_package_dependency_scan_memo_spec.spl"
must_contain "a865dced154 HIR registry memo spec" "$HIRSPEC" "describe"

# --- 809ce6d4e71: native object cache never persisted entries ---
must_contain "809ce6d4e71 object cache second-build-hits spec" \
    "$ROOT/test/02_integration/compiler/driver/native_build_cache_second_build_hits_spec.spl" \
    "describe"

# --- MATCHRET / IMPLIDX: first-time HIR import registration ~85 ms -> ~14 ms
# per symbol. A `val kind = match ...:` whose arms `return` made every later
# statement in register_imported_symbol_inner cost ~10 ms on the seed; the
# impl sweep per imported type is replaced by a per-surface index.
# Record: doc/08_tracking/bug/hir_phase_per_module_cost_2026-08-21.md
HIRREG="$ROOT/src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl"
must_not_contain "MATCHRET no match-expression with return arms" "$HIRREG" "val kind = match composite.kind:"
must_contain     "MATCHRET hoisted early-exit"                    "$HIRREG" 'val kind = if composite.kind == "class": SymbolKind.Class else: SymbolKind.Struct'
must_contain     "IMPLIDX per-surface impl index"                 "$ROOT/src/compiler/20.hir/hir_lowering/_Items/module_reexport_materialization.spl" "val impl_positions = self.imported_impl_positions(imported_mod, imported_name)"
must_contain     "MATCHRET/IMPLIDX cost spec"                     "$ROOT/test/01_unit/compiler/hir/hir_import_registration_per_symbol_cost_spec.spl" "PER_REGISTRATION_BUDGET_US"

# --- NAMEIDX / SCOPEROW / EXCL / seed hot-path (2026-08-22, 7th session of the
# same record). NAMEIDX: the six linear name sweeps per first-time registration
# become Dict probes on a per-surface index (one sweep per surface, pinned by
# name_index_build_count == packages). SCOPEROW: SymbolTable.define probes the
# scope row in place instead of copying it. Seed: decision coverage resolves the
# file only when coverage is ON; block-scope shadow capture computes the owner
# target only when there is a prior value; CowEnv per-frame maps use ahash.
must_contain     "NAMEIDX per-surface name index"                 "$HIRREG" 'val surface_key = self.ensure_surface_name_index(imported_mod)'
must_not_contain "NAMEIDX no linear composite scan"               "$HIRREG" 'val composite_position = module_surface_name_position('
must_contain     "NAMEIDX build count pinned"                     "$ROOT/test/01_unit/compiler/hir/hir_import_registration_per_symbol_cost_spec.spl" "expect(lowering.name_index_build_count).to_equal(FIXTURE_PACKAGES)"
must_contain     "SCOPEROW define probes scope row in place"      "$ROOT/src/compiler/20.hir/hir_types.spl" 'val existing = self.scopes[self.current_scope.id].symbols.get(name)'
must_contain     "EXCL exclusive slot time"                       "$ROOT/src/compiler/20.hir/hir_lowering/hir_phase_profile.spl" '_hir_prof_excl_ms[slot] = _hir_prof_excl_ms[slot] + (elapsed - child_ms)'
must_contain     "seed: decision coverage checks enabled first"   "$ROOT/src/compiler_rust/compiler/src/interpreter_control.rs" 'record_decision_coverage_here('
must_not_contain "seed: no eager coverage file per decision"      "$ROOT/src/compiler_rust/compiler/src/interpreter_control.rs" 'record_decision_coverage_sffi(&current_coverage_file(),'
must_contain     "seed: CowEnv frame maps on ahash"               "$ROOT/src/compiler_rust/compiler/src/value.rs" 'pub(crate) type FrameMap<K, V> = HashMap<K, V, ahash::RandomState>;'
must_contain     "seed: shadow capture tests prior value first"   "$ROOT/src/compiler_rust/compiler/src/interpreter/block_exec.rs" 'if let Some(value) = prior_value.as_ref() {'

# --- pure-Simple core interpreter: collection writes through the owner, not a
# temp alias (`var v = val_arrays[x]; v.push(e); val_arrays[x] = v` deep-copies
# the whole array per write under COW value semantics: 22.3 s vs 1 ms at N=16k).
# Record: doc/08_tracking/bug/pure_interp_cow_alias_primitives_2026-08-22.md
PINTERP="$ROOT/src/compiler/10.frontend/core/interpreter"
must_contain     "pure-interp upsert pushes through owner"  "$PINTERP/value.spl" "val_struct_fields[vid].push(field_name)"
must_not_contain "pure-interp upsert no alias writeback"   "$PINTERP/value.spl" "val_struct_values[vid] = values"
must_contain     "pure-interp array push through owner"    "$PINTERP/_EvalOps/call_method_eval.spl" "val_arrays[receiver].push(new_elem)"
must_not_contain "pure-interp index-assign no alias"       "$PINTERP/eval_access.spl" "val_arrays[base_val] = elements"
must_contain     "pure-interp owner-mutation spec present" "$ROOT/test/01_unit/compiler/interpreter/pure_interp_owner_mutation_spec.spl" "val_arrays[receiver].push(new_elem)"

# --- COW-alias ratchet must keep scanning src/lib (7,864 files, 83% of the
# owned .spl tree) and the JS VM object store must mutate through the owner.
# Pre-fix the ratchet hardcoded src/compiler only and reported 7 offenders
# while the tree carried 218; `remove_property` deep-copied SEVEN
# whole-heap-sized parallel arrays per call.
# Record: doc/08_tracking/bug/cow_alias_ratchet_blind_to_src_lib_2026-08-23.md
must_contain     "COWLIB ratchet scans src/lib"            "$ROOT/scripts/check/check-cow-alias-hotpath.shs" 'LIBSRC="$ROOT/src/lib"'
must_contain     "COWLIB ratchet lib scan is invoked"      "$ROOT/scripts/check/check-cow-alias-hotpath.shs" 'scan "$LIBSRC" "lib/"'
must_contain     "COWLIB 0 lib files is ERROR not a pass"  "$ROOT/scripts/check/check-cow-alias-hotpath.shs" 'if [ "$FILES_L" -eq 0 ]; then'
must_contain     "COWLIB baseline carries lib rows"        "$ROOT/scripts/check/cow_alias_hotpath_baseline.txt" 'lib/common/js/engine'
must_contain     "COWLIB object store owner-mutates"       "$ROOT/src/lib/common/js/engine/vm_object_store.spl" 'self.prop_obj_ids.push(obj_id)'
must_contain     "COWLIB set_property in-place through owner" "$ROOT/src/lib/common/js/engine/vm_object_store.spl" 'self.prop_values[existing_i] = value'
must_not_contain "COWLIB object store no alias writeback"    "$ROOT/src/lib/common/js/engine/vm_object_store.spl" 'self.prop_configurables = prop_configurables'
must_not_contain "COWLIB object store takes no array alias"  "$ROOT/src/lib/common/js/engine/vm_object_store.spl" 'var prop_obj_ids: [i64] = self.prop_obj_ids'

# --- pure MIR `!` arm: recover the class owner from the Option inner type, as the
# .unwrap() arm does; otherwise `m!.method()` lowers to the const-0 placeholder.
# Record: doc/08_tracking/bug/pure_mir_force_unwrap_class_receiver_unresolved_2026-08-22.md
must_contain "pure-mir ! arm recovers owner from inner Named type" \
    "$ROOT/src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl" "self.struct_value_syms[result_local_uw.id] = bang_owner_sym.name"
must_contain "pure-mir force-unwrap provenance spec present" \
    "$ROOT/test/01_unit/compiler/mir/force_unwrap_class_method_provenance_spec.spl" "force_unwrap.Cell.get_n"

# --- test-runner fixed session cost: loader compat surface must not shadow
# the real sffi types. A duplicate `TypeInfo`/`CompilerContext` with a
# different field shape made HIR lowering fail field inference and drop the
# WHOLE test-runner module to the interpreter (~100-1000x). Measured
# 2026-08-21 on origin/main: `simple test test/01_unit/compiler/config/` =
# 413s wall for 7 specs whose execution was 4.2s (discovery was 64ms).
# Record: doc/08_tracking/bug/test_runner_fixed_session_cost_2026-08-21.md
SFFI_COMPAT="$ROOT/src/compiler/99.loader/compiler_sffi.spl"
must_not_contain "loader compat does not shadow TypeInfo" "$SFFI_COMPAT" "class TypeInfo:"
must_not_contain "loader compat does not shadow CompilerContext" "$SFFI_COMPAT" "class CompilerContext:"
must_contain "loader compat re-exports the real sffi types" "$SFFI_COMPAT" \
    "export use compiler.loader.loader.compiler_sffi."
must_contain "shadow-type mechanism spec present" \
    "$ROOT/test/01_unit/compiler/loader/compiler_sffi_no_shadow_types_spec.spl" "describe"

# --- lint cost: the budget gate itself must still exist and self-test ---
must_contain "lint cost budget gate present" \
    "$ROOT/scripts/check/check-lint-cost-budget.shs" "selftest"

# --- PAYLOADMISS (2026-08-22). Payload/callable origin materialization re-ran a
# FULL failed origin search (owner declarations + re-export routes + whole
# import table) for every occurrence and every importer of a name the owner
# does not have. Builtin CONTAINER spellings dominated: stage-1 run14 emitted
# ~31,700 in-flight advisories for them alone (Dict 14,847, Option 9,857,
# Result 7,015, fn 290), none of them a terminal error.
# The fix must NOT be a capitalized-name filter: `lower_named_kind` places the
# container arms AFTER the symbol lookup so a DECLARED type of that name wins,
# and 42 `Result` / 14 `Option` / 10 `Array` / 1 `Dict` declarations exist in
# this tree (commit 1aa81cac8c6). It is a NEGATIVE memo keyed (owner, name):
# only a MISS is cached, so a declaration still resolves on step 1 every time.
# Record: doc/08_tracking/bug/hir_builtin_container_origin_search_storm_2026-08-22.md
RXMAT="$ROOT/src/compiler/20.hir/hir_lowering/_Items/module_reexport_materialization.spl"
PLMSPEC="$ROOT/test/01_unit/compiler/hir/hir_payload_origin_miss_memo_spec.spl"
must_contain     "PAYLOADMISS negative memo consulted before the search" "$RXMAT" 'if self.payload_origin_miss_memo.contains_key(miss_key):'
must_contain     "PAYLOADMISS miss recorded, owner-scoped key"           "$RXMAT" 'val miss_key = hir_payload_origin_miss_key(imported_mod_name, dependency)'
must_contain     "PAYLOADMISS callable advisory keyspace kept separate"  "$RXMAT" 'hir_payload_origin_miss_key("callable " + imported_mod.module_name, dependency)'
must_not_contain "PAYLOADMISS builtin filter stays lowercase-only"       "$RXMAT" 'dependency == "Dict"'
must_contain     "PAYLOADMISS O(1)-per-name spec"                        "$PLMSPEC" "expect(lowering.payload_origin_miss_skip_count).to_equal(2)"
must_contain     "PAYLOADMISS declared-Result control fixture"           "$PLMSPEC" 'decl.enum_names = ["Result"]'

# --- HIR closure cache re-key: the interface digest must stay COMPLETE before
# anyone keys the HIR closure digest on it. `hir_cache_closure_digest` folds raw
# file content_hash, so the incremental HIR hit rate is 0% by construction on a
# ~60min phase. The obvious fix (key on interface_digest_of_source) is BLOCKED:
# the textual v1 extractor under-captures struct/class FIELD lines, and an
# under-capture is a stale cache HIT, i.e. a silently wrong compiler binary.
# The differential spec ran RED at 6/12 pre-fix; extend decls and re-export
# aliases were closed, fields could not be. These rows pin BOTH halves: the two
# closed constructs must stay closed, and the closure digest must stay keyed on
# content_hash while the field gap is open.
# Record: doc/08_tracking/bug/hir_closure_digest_rekey_blocked_by_incomplete_interface_digest_2026-08-23.md
AKEY="$ROOT/src/compiler/80.driver/cache/action_key.spl"
IFDIFF="$ROOT/test/01_unit/compiler/driver/interface_digest_differential_spec.spl"
must_contain "interface digest captures extend headers"        "$AKEY" 't.starts_with("extend ")'
must_contain "interface digest captures use/re-export aliases" "$AKEY" 't.starts_with("use ")'
must_contain "interface-digest differential spec present"      "$IFDIFF" "struct fields are NOT yet part of the interface (blocking gap)"
must_contain "differential spec pins the extend construct"     "$IFDIFF" "changes the digest when the extended type changes"
must_contain "HIR closure digest still keyed on content_hash"  "$ROOT/src/compiler/80.driver/driver_hir_cache.spl" "content_hash"

# --- memory: peak-RSS budget gate must exist and self-test.
# Pins the 2026-08-21 survey (interpreter lint 12-13.6 GB -> 0.69 GB; JIT lint
# 0.45 GB). Both headline cases were fixed once and re-reported later by another
# lane because nothing measured them continuously.
must_contain "memory budget gate present" \
    "$ROOT/scripts/check/check-memory-budget.shs" "selftest"

# The census the survey depends on must stay wired: report() is unreachable from
# lint/native-build except via this explicit call, and without it
# SIMPLE_MEM_TRACE=1 silently prints nothing (measured 0 lines pre-fix).
must_contain "mem census emitted before terminal exit" \
    "$ROOT/src/compiler_rust/driver/src/main.rs" "mem_trace::report"

# --- C runtime dict: delete-heavy churn must not grow the table forever.
# rt_core_dict_put resized only by doubling, and the 70% load test counts
# tombstones, so `d[k]=v; d.remove(k)` in a loop doubled capacity on tombstones
# alone: a dict with ZERO live entries reached 34.9 MB after 1.6M churn pairs.
# The fix rehashes in place at the SAME capacity when tombstones outnumber live
# entries and the live set is sparse. The absence of that same-cap branch IS the
# regression, so pin it plus the selfcheck that measures the curve.
must_contain "dict churn same-cap rehash present" \
    "$ROOT/src/runtime/runtime_native.c" "next_cap = d->cap;"
must_contain "dict churn growth selfcheck present" \
    "$ROOT/src/runtime/test/rt_dict_tombstone_churn_growth_selfcheck.c" \
    "dict table growing with churn count"


# --- lint per-character lexical walk (2026-08-23).
# The sampler's two largest interpreted-lint frames, `count_triple_quotes`
# (5.8%) and `raw_rt_lexical_code_lines` (5.5%), paid one interpreted
# `substring` + one array push PER CHARACTER on characters no branch of the
# scanner can act on. Run-based scanning cut ARR_MUT_CALLS by 4.2x over 150
# real src/**/*.spl files with byte-identical output.
# Each needle below IS the fix; its absence IS the regression.
# See doc/08_tracking/bug/lint_per_char_lexical_walk_2026-08-23.md
LINTTEXT="$ROOT/src/compiler/35.semantics/lint/lint_text.spl"
RAWRT="$ROOT/src/compiler/35.semantics/lint/raw_rt_access.spl"
LEXWALKSPEC="$ROOT/test/05_perf/lint/lint_lexical_char_walk_perf_spec.spl"

# --- Restored 2026-08-23: rows 50 rows were clobbered by e24b2845b3b (a
# stale-base rewrite of this file, 116 rows -> 68). Recovered from 50a379f83b7
# and UNIONed with everything later lanes appended; nothing was replaced.
GLBREG="$ROOT/src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl"
GLBSPEC="$ROOT/test/01_unit/compiler/hir/hir_glob_reachable_miss_memo_spec.spl"
GLBTYPES="$ROOT/src/compiler/20.hir/hir_lowering/types.spl"
GPUSH="$ROOT/src/compiler_rust/compiler/tests/interpreter_global_array_push_in_place.rs"
GPUSH2="$ROOT/src/compiler_rust/compiler/tests/interpreter_global_array_push_linear.rs"
HIRCODECW="$ROOT/src/compiler/20.hir/hir_codec_support.spl"
HOPPARK="$ROOT/src/compiler_rust/compiler/src/interpreter_call/core/function_exec.rs"
HOPTEST="$ROOT/src/compiler_rust/compiler/tests/interpreter_receiver_hop_depth_linear.rs"
QTYPES="$ROOT/src/compiler/20.hir/hir_types.spl"
QTYPESPEC="$ROOT/test/01_unit/compiler/hir/qualified_type_lookup_scaling_spec.spl"

must_contain "CHARWALK triple-quote scan rejects lines with no \"\"\"" \
    "$LINTTEXT" 'if line.index_of("\"\"\"") < 0: return 0'
must_contain "CHARWALK clean line skips the per-char walk entirely" \
    "$RAWRT" 'if not self.in_string and not self.in_triple and not raw_line.contains("\"") and not raw_line.contains("#"):'
must_contain "CHARWALK ordinary text copied one run at a time" \
    "$RAWRT" 'pieces.push(raw_line.substring(i, run_end))'
must_contain "CHARWALK comment tail blanked in one repeat" \
    "$RAWRT" 'pieces.push(" ".repeat(line_len - i))'
must_contain "CHARWALK triple-quoted span blanked in one repeat" \
    "$RAWRT" 'val close = raw_line.index_of("\"\"\"", i)'
# The 3-char probe must stay behind the quote test: taking it unconditionally
# was half the per-character cost.
must_not_contain "CHARWALK no unconditional 3-char probe per character" \
    "$RAWRT" 'val triple = i + 2 < raw_line.len()'
must_contain "CHARWALK ratio pin spec present" \
    "$LEXWALKSPEC" 'expect(runs_us * 3 < dense_us).to_equal(true)'
must_contain "CHARWALK byte-identity reference walk kept in the spec" \
    "$LEXWALKSPEC" 'fn reference_lexical_code_lines(source: text) -> [text]:'
# --- mono type-arg inference from pattern/loop bindings (2026-08-23). The
# inference environment was seeded only from params and `let`s, so a call whose
# argument is a match-arm payload binding or a for-loop variable fail-closed to
# E-MONO-032 -> E-MONO-033 ("refusing to lower non-monomorphic HIR to MIR").
# 67 of the ~76 real root generic call sites in the whole stage1 closure are
# match-arm bindings in `20.hir/generated/hir_hash.spl`, so losing this is
# losing the whole step-3 phase again. Pin the three mechanisms plus the spec.
MONOINT="$ROOT/src/compiler/40.mono/monomorphize_integration.spl"
must_contain "MONO match-arm pattern bindings enter env" \
    "$MONOINT" "self.collect_pattern_bindings(mt.pattern)"
must_contain "MONO enum payload types collected" \
    "$MONOINT" 'self.enum_payload_types["{en.name}::{vt.name}::{ti}"] = tt'
must_contain "MONO for-loop variable bound from element type" \
    "$MONOINT" "self.bind_iteration_var(var_, fit)"
# The class was swept, not just the instance: EVERY binding form that carries
# no `let` and is not a parameter must enter the environment.
must_contain "MONO comprehension for-clause bound" \
    "$MONOINT" "self.bind_iteration_var(cvar, ci)"
must_contain "MONO with-item target bound" \
    "$MONOINT" "self.env[ws.id] = wtt"
must_contain "MONO scrutinee-derived enum name hint" \
    "$MONOINT" "self.match_enum_hint = scrut_enum"
# `match node.kind:` over an enum whose variant name is shared by other enums
# (`IntLit` is declared by 4 in-tree) must resolve to the RIGHT enum, never to
# the ambiguous variant-suffix fallback. Pinned by spec, not by mechanism: the
# resolution comes from HIR's recorded scrutinee type, so there is no line of
# 40.mono to point at.
must_contain "MONO ambiguous-variant field scrutinee pinned" \
    "$ROOT/test/01_unit/compiler/mono/mono_pattern_bound_type_arg_inference_spec.spl" \
    "infers through a FIELD scrutinee when the variant name is shared by two enums"
must_contain "MONO pattern/loop inference spec pinned" \
    "$ROOT/test/01_unit/compiler/mono/mono_pattern_bound_type_arg_inference_spec.spl" \
    "expect(stats.unresolved_generic_calls).to_equal(0)"
# --- generic STRUCT declaration gate stays OPEN (2026-08-23, #158 Phase C
# extended to structs). Re-adding the declaration-site fatal would re-block
# every generic-struct fixture; loudness lives at the use site instead.
must_not_contain "generic struct declaration fatal not reintroduced" \
    "$ROOT/src/compiler/20.hir/hir_lowering/_Items/declaration_lowering.spl" \
    "generic structs are not supported on the native build path yet"


