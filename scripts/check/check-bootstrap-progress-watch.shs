#!/bin/sh
set -eu

fail() { echo "FAIL: $*" >&2; exit 1; }
watcher=scripts/bootstrap/bootstrap-progress-watch.shs
wrapper=scripts/bootstrap/bootstrap-from-scratch.sh
tmp_dir=${TMPDIR:-/tmp}/simple-bootstrap-progress-test.$$
mkdir -p "$tmp_dir"
trap 'rm -rf "$tmp_dir"' EXIT INT TERM

help=$(sh "$watcher" --help)
printf '%s\n' "$help" | grep -Fq -- '--expected-start=TEXT' || fail "stale-PID help missing"
wrapper_help=$(sh "$wrapper" --help)
printf '%s\n' "$wrapper_help" | grep -Fq -- '--progress[=<path>]' || fail "wrapper progress option missing"
grep -Fq 'trap bootstrap_cleanup EXIT INT TERM' "$wrapper" || fail "wrapper cleanup trap missing"
grep -Fq 'bootstrap-progress-watch.shs' "$wrapper" || fail "wrapper watcher launch missing"
grep -Fq 'bootstrap_progress_mark stage4 ' "$wrapper" || fail "Stage 4 milestone missing"

sleep 5 &
live_pid=$!
printf 'milestone=stage-test\nmain_log=%s\n' "$tmp_dir/main.log" >"$tmp_dir/state"
printf 'abc' >"$tmp_dir/main.log"
sh "$watcher" --pid="$live_pid" --state-file="$tmp_dir/state" \
  --progress-log="$tmp_dir/live.progress" --interval=1 --once
# Assert the three live-sample facts as whole FIELDS, not by position.
#
# This assertion previously ended in `main_log_bytes=3$`, anchoring on
# main_log_bytes being the LAST field on the line. The watcher later gained
# phase/unit_kind/done/total/tasks_*/failed/cached/current/terminal fields,
# which pushed main_log_bytes into the middle of the sample and made this
# guard fail on a watcher that was working correctly. Nothing ran the guard,
# so the drift went unnoticed until it was wired (2026-08-02).
#
# The `( |$)` tail keeps the match exact -- main_log_bytes=30 still fails --
# so this repairs the coupling to field ORDER without weakening the check.
grep -Eq 'status=alive .*milestone=stage-test .*main_log_bytes=3( |$)' "$tmp_dir/live.progress" || fail "live sample missing metrics/state"

wait "$live_pid" 2>/dev/null || true
sh "$watcher" --pid="$live_pid" --progress-log="$tmp_dir/exited.progress" --once
grep -Fq 'status=exited' "$tmp_dir/exited.progress" || fail "exited process not detected"

set +e
sh "$watcher" --pid="$$" --expected-start=definitely-not-this-process \
  --progress-log="$tmp_dir/stale.progress" --once
stale_status=$?
set -e
[ "$stale_status" -eq 3 ] || fail "stale PID returned $stale_status, expected 3"
grep -Fq 'status=stale' "$tmp_dir/stale.progress" || fail "stale PID not logged"

echo "PASS: bootstrap progress watcher live/exited/stale coverage"
