#!/bin/sh
# check-cross-module-ladder-family-not-name-bound.shs
#
# WHAT THIS PINS
# --------------
# The SECOND `Poll.unwrap` bind site (fixed 2026-08-25). Sibling of
# `check-erased-receiver-family-not-suffix-bound.shs`, which pins the FIRST.
#
# In `compile_method_call_static`'s cross-module branch
# (codegen/instr/closures_structs.rs) a method name is resolved by a four-step
# ladder:
#
#   1. `ctx.use_map.get(func_name)`                  -- BARE name, direct hit
#   2. scan `use_map`    for a key ending ".{name}"  -- first-wins, `break`
#   3. scan `import_map` for a key ending ".{name}"  -- first-wins, `break`
#   4. `ctx.import_map.get(lookup_name)`             -- BARE name fallback
#
# Only step 4 carried the Option/Result-family exclusion. Steps 1-3 ran FIRST
# and were unguarded, so for an erased `T?` receiver -- which `mir/lower` emits
# as `MethodCallStatic { func_name: "unwrap" }`, because `T?` is
# `HirType::Pointer` and has no registered type name -- step 1 hit
# `use_map["unwrap"]`, which `imports.rs` populates with BARE raw method names.
# In the self-host closure the only library defining an `unwrap` method is
# `nogc_async_mut/async/poll.spl`, so the call bound to
# `lib__nogc_async_mut__async__poll__Poll_dot_unwrap`. That function tests
# Poll::Ready/Poll::Pending, matches neither `Some` tag, falls through and
# returns 0; 0 is `< 4096`, so `rt_heap_ref_wellformed` reports the payload
# malformed -- E-DRIVER-HIR-RETAINED-SURFACES-MALFORMED, Stage 2/3 SEGV rc=139.
#
# Steps 2 and 3 additionally take the FIRST match out of a `HashMap` iteration,
# which is nondeterministic, so leaving them unguarded is a latent flake even
# when step 1 misses.
#
# THE INVARIANT: every one of the four steps must be skipped for an unqualified
# Option/Result-family name. Skipping is a ROUTE, not a refusal -- `None` falls
# through to `try_compile_builtin_method_call`, which lowers the call to the
# runtime enum builtins. Measured callee on a real Stage 2: `rt_enum_payload`
# (NOT `rt_unwrap_or_trap`); the gate header of
# check-stage2-option-unwrap-not-stolen.shs names both as correct. Qualified spellings are unaffected: `lookup_name` is
# `func_name` with `_dot_` rewritten to `.`, so matching a bare spelling exactly
# implies no type qualifier.
#
# VERDICT (always the last line of stdout):
#   PASS  -- <n> invariant(s) checked, ...    exit 0   (n is always > 0)
#   FAIL  -- <n> invariant(s) checked, ...    exit 1
#   ERROR -- nothing was checked (<reason>)   exit 2
# A run that checked 0 invariants is ERROR, never a pass.
#
# `--selftest` runs FIRST, unconditionally, and is FATAL. Mutation-tested BOTH
# directions against the real pre-fix and post-fix source shapes.
#
# Record: doc/08_tracking/bug/poll_unwrap_second_bind_site_lower_and_check_impl_2026-08-25.md

set -u

TARGET=src/compiler_rust/compiler/src/codegen/instr/closures_structs.rs
SELFTEST_ONLY=0
for _a in "$@"; do
    case "$_a" in
        --selftest) SELFTEST_ONLY=1 ;;
        --target=*) TARGET=${_a#--target=} ;;
        *) echo "ERROR -- nothing was checked (unknown argument '$_a')"; exit 2 ;;
    esac
done

# ---------------------------------------------------------------------------
# classify_file -- single source of truth.
# Echoes one of: OK | UNGUARDED_LADDER | MISSING_PREDICATE | NO_FILE
# ---------------------------------------------------------------------------
classify_file() {
    _f=$1
    [ -f "$_f" ] || { echo NO_FILE; return; }

    # The family predicate must exist and be bound to the family list.
    grep -q 'is_erased_enum_helper_family' "$_f" || { echo MISSING_PREDICATE; return; }

    # Step 1 must not be an unconditional bare use_map hit. The defect shape is
    # `let mut resolved_name = ctx.use_map.get(func_name)` with nothing gating it.
    _bare=$(grep -c 'let mut resolved_name = ctx\.use_map\.get(func_name)' "$_f")
    if [ "$_bare" -ge 1 ]; then echo UNGUARDED_LADDER; return; fi

    # Steps 2, 3 and 4 must each carry the exclusion. Three `is_none()` guards
    # plus the step-1 else-branch is the fixed shape.
    _guards=$(grep -c '!is_erased_enum_helper_family' "$_f")
    if [ "$_guards" -lt 3 ]; then echo UNGUARDED_LADDER; return; fi

    echo OK
}

# ---------------------------------------------------------------------------
# SELFTEST -- fatal, runs before any scan.
# ---------------------------------------------------------------------------
run_selftest() {
    _tmp=$(mktemp -d "${TMPDIR:-/tmp}/xmod-ladder-gate-selftest.XXXXXX") ||
        { echo "ERROR -- nothing was checked (cannot mktemp)"; exit 2; }
    _fails=0
    _n=0

    # fixture 1: FIXED shape must classify OK
    cat > "$_tmp/fixed.rs" <<'EOF'
        let is_erased_enum_helper_family = matches!(lookup_name, "unwrap");
        let mut resolved_name = if is_erased_enum_helper_family {
            None
        } else {
            ctx.use_map.get(func_name).map(|s| s.as_str())
        };
        if resolved_name.is_none() && !is_erased_enum_helper_family { }
        if resolved_name.is_none() && !is_erased_enum_helper_family { }
        if resolved_name.is_none() && !is_erased_enum_helper_family { }
EOF
    _n=$((_n+1))
    _r=$(classify_file "$_tmp/fixed.rs")
    [ "$_r" = "OK" ] || { echo "selftest FAIL: fixed fixture -> $_r (want OK)"; _fails=$((_fails+1)); }

    # fixture 2: the REAL pre-fix shape -- step 1 unguarded, only step 4 excluded.
    cat > "$_tmp/defect.rs" <<'EOF'
        let mut resolved_name = ctx.use_map.get(func_name).map(|s| s.as_str());
        if resolved_name.is_none() {
            let method_suffix = format!(".{}", func_name);
        }
        if resolved_name.is_none()
            && !matches!(
                lookup_name,
                "unwrap" | "unwrap_or" | "unwrap_err" | "expect" | "is_some" | "is_none" | "is_ok" | "is_err"
            )
        {
            resolved_name = ctx.import_map.get(lookup_name).map(|s| s.as_str());
        }
EOF
    _n=$((_n+1))
    _r=$(classify_file "$_tmp/defect.rs")
    [ "$_r" = "MISSING_PREDICATE" ] || { echo "selftest FAIL: pre-fix fixture -> $_r (want MISSING_PREDICATE)"; _fails=$((_fails+1)); }

    # fixture 3: predicate present but step 1 reverted to the unguarded bare hit
    # (the exact partial-revert this gate exists to catch).
    cat > "$_tmp/partial.rs" <<'EOF'
        let is_erased_enum_helper_family = matches!(lookup_name, "unwrap");
        let mut resolved_name = ctx.use_map.get(func_name).map(|s| s.as_str());
        if resolved_name.is_none() && !is_erased_enum_helper_family { }
        if resolved_name.is_none() && !is_erased_enum_helper_family { }
        if resolved_name.is_none() && !is_erased_enum_helper_family { }
EOF
    _n=$((_n+1))
    _r=$(classify_file "$_tmp/partial.rs")
    [ "$_r" = "UNGUARDED_LADDER" ] || { echo "selftest FAIL: partial-revert fixture -> $_r (want UNGUARDED_LADDER)"; _fails=$((_fails+1)); }

    # fixture 4: predicate present, step 1 routed, but a suffix scan lost its guard.
    cat > "$_tmp/scan.rs" <<'EOF'
        let is_erased_enum_helper_family = matches!(lookup_name, "unwrap");
        let mut resolved_name = if is_erased_enum_helper_family {
            None
        } else {
            ctx.use_map.get(func_name).map(|s| s.as_str())
        };
        if resolved_name.is_none() { }
        if resolved_name.is_none() { }
        if resolved_name.is_none() && !is_erased_enum_helper_family { }
EOF
    _n=$((_n+1))
    _r=$(classify_file "$_tmp/scan.rs")
    [ "$_r" = "UNGUARDED_LADDER" ] || { echo "selftest FAIL: lost-scan-guard fixture -> $_r (want UNGUARDED_LADDER)"; _fails=$((_fails+1)); }

    # fixture 5: absent file must classify NO_FILE (drives ERROR, never a pass)
    _n=$((_n+1))
    _r=$(classify_file "$_tmp/does-not-exist.rs")
    [ "$_r" = "NO_FILE" ] || { echo "selftest FAIL: missing file -> $_r (want NO_FILE)"; _fails=$((_fails+1)); }

    rm -rf "$_tmp"
    if [ "$_n" -eq 0 ]; then
        echo "ERROR -- nothing was checked (selftest executed 0 fixtures)"; exit 2
    fi
    if [ "$_fails" -ne 0 ]; then
        echo "ERROR -- nothing was checked (selftest failed $_fails/$_n fixtures; the gate itself is broken)"
        exit 2
    fi
    SELFTEST_N=$_n
}

run_selftest

if [ "$SELFTEST_ONLY" -eq 1 ]; then
    echo "PASS -- $SELFTEST_N invariant(s) checked, selftest only (no tree scanned)"
    exit 0
fi

VERDICT=$(classify_file "$TARGET")
CHECKED=1

case "$VERDICT" in
    OK)
        echo "PASS -- $((CHECKED + SELFTEST_N)) invariant(s) checked ($SELFTEST_N selftest + $CHECKED source), every step of the cross-module resolution ladder skips unqualified Option/Result-family names; resolution routes on to the runtime enum builtins (measured callee on Stage 2: rt_enum_payload)"
        exit 0
        ;;
    UNGUARDED_LADDER)
        echo "FAIL -- $((CHECKED + SELFTEST_N)) invariant(s) checked, a step of the cross-module resolution ladder in $TARGET can bind an unqualified Option/Result-family name by NAME (bare use_map hit or an unguarded first-wins suffix scan): .unwrap() is stolen by Poll.unwrap, Stage 2/3 SEGV rc=139"
        exit 1
        ;;
    MISSING_PREDICATE)
        echo "FAIL -- $((CHECKED + SELFTEST_N)) invariant(s) checked, the is_erased_enum_helper_family exclusion is absent from $TARGET"
        exit 1
        ;;
    NO_FILE)
        echo "ERROR -- nothing was checked (target not found: $TARGET)"
        exit 2
        ;;
    *)
        echo "ERROR -- nothing was checked (unclassifiable result '$VERDICT')"
        exit 2
        ;;
esac
