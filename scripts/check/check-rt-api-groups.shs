#!/bin/sh
# check-rt-api-groups.shs — every rt_* API belongs to a NAMED GROUP, and no
# group's direct call sites grow.
#
# Verdict is ALWAYS the last stdout line:
#   PASS — <n> ... checked, ...        exit 0   (n is always > 0)
#   FAIL — ...                         exit 1
#   ERROR — nothing was checked (...)  exit 2   (a 0-item run is NEVER a pass)
#
# Policy: doc/04_architecture/runtime/rt_api/rt_api_group_policy.md
# Registry: config/api/api_registry.sdn (generated by
#           scripts/check/gen-api-registry.shs — never hand-edit rows)
# Baseline: scripts/check/rt_api_group_baseline.txt (FROZEN, reviewed; the
#           generator never writes it — only --generate-baseline here does)
#
# ---- Why a baseline exists at all, and what it fixes -----------------------
# 2026-09-06 audit: the first cut of this gate ratcheted against the
# `sites` column of config/api/api_registry.sdn, and treated the residual
# bucket `misc` as if it were a group. Both were laundered by the registry's
# own regeneration:
#
#   * a new rt_* symbol IS caught (check A below fired for real on this very
#     tree: `FAIL — 4076 rt_* symbol(s) checked, 2 ungrouped ... rt_fd_pread
#     rt_fd_pwrite`), but the required remedy is to run gen-api-registry.shs,
#     which drops any small family straight into `misc` and reports it as
#     grouped. So "ungrouped" was only ever "absent from the file", never
#     "has no group".
#   * that same mandatory regeneration REWRITES every `sites` cell, so the
#     ratchet floor moved with the debt it was meant to hold. Measured on
#     this tree: one regeneration silently moved the floor for `misc`
#     (846 -> 836) and `port` (55 -> 53) with no reviewer input.
#
# The fix is one frozen, reviewed artifact that the generator cannot touch:
#   scripts/check/rt_api_group_baseline.txt
# It records (i) the `misc` population at freeze time — the symbols that are
# admitted as ungrouped debt — and (ii) the per-group forbidden call-site
# budget. Only `--generate-baseline` writes it. The registry's `sites` column
# stays informative; it is no longer the floor.
#
# ---- How this COMPOSES with the gates that already exist -------------------
# It deliberately duplicates none of them and weakens none of them:
#
#   check-no-direct-rt.shs        ratchets the GLOBAL forbidden call-site
#                                 count against one integer baseline. This
#                                 gate ratchets the SAME population PER GROUP
#                                 against the frozen per-group budgets, which
#                                 is strictly stronger: a lane can no longer
#                                 add 40 rt_vulkan_* calls and stay green by
#                                 deleting 40 rt_file_* ones. The scanner
#                                 definition (RT_RE / DECL_RE / the allowlist)
#                                 is that gate's, reused verbatim through
#                                 scripts/check/rt-call-site-census.shs, so
#                                 "forbidden" means exactly the same thing in
#                                 both, and an allowlisted provider is exactly
#                                 that gate's allowlisted provider.
#   check-rt-dual-implementation-ratchet.shs
#                                 freezes the single-lane population. This
#                                 gate records the lane per symbol but does
#                                 not re-adjudicate it.
#   extern-backing-census.shs     is the authority on whether an extern is
#                                 backed. This gate does not re-derive that;
#                                 the registry's `backing` column records
#                                 which instrument (nm / text) saw the symbol.
#
# ---- Four checks -----------------------------------------------------------
#   A. REGISTRATION. Every rt_* symbol currently visible — defined in the C
#      runtime, defined in the Rust runtime, or CALLED from product Simple —
#      must have a registry row with a non-empty group.
#   B. UNGROUPED RATCHET. A symbol whose registry group is the residual
#      bucket `misc` is NOT grouped (policy §1 says so in as many words).
#      A `misc` symbol absent from the frozen baseline FAILS. This is the
#      error the owner asked for: adding an rt_* API without giving it a
#      group is an error, and the remedy is a row in
#      config/api/api_group_overrides.sdn assigning it to a real group — not
#      a wider baseline.
#   C. STALE BASELINE. A baselined `misc` symbol that now has a real group,
#      or has left the tree, also FAILS — a baseline that no longer describes
#      the tree is how a ratchet silently stops ratcheting. Same rule, same
#      direction, as check-unbacked-extern-ratchet.shs.
#   D. PER-GROUP CALL-SITE RATCHET. A group's forbidden direct call sites must
#      not exceed its frozen budget. A group with no budget row is an offender,
#      not a free pass.
#
# ---- Measurement limit, stated rather than papered over --------------------
# The default (cheap) universe is TEXT-derived: C/Rust definition lines plus
# called symbols. nm sees ~100 symbols with no greppable definition line
# (macro-generated definitions), and those are already registered, so the
# cheap path cannot tell "registered and nm-only" from "stale". Therefore the
# STALE-ROW check (registry row whose symbol is gone) runs only with
# --census FILE (a scripts/check/rt-dual-implementation-census.shs TSV), and a
# brand-new nm-only symbol is invisible to a cheap run. Pass --census on the
# lane that can afford it. Check C above is a DIFFERENT question — it is about
# the baseline, not the registry, and runs unconditionally.
#
# Usage:
#   sh scripts/check/check-rt-api-groups.shs [--root DIR] [--registry FILE]
#          [--baseline FILE] [--census FILE] [--critical] [--selftest]
#          [--selftest-only] [--offenders FILE] [--generate-baseline]

set -u

ROOT=""
REGISTRY=""
BASELINE=""
CENSUS=""
CRITICAL=0
SELFTEST_ONLY=0
OFFENDERS=""
GENERATE_BASELINE=0

while [ $# -gt 0 ]; do
    case "$1" in
        --root) ROOT="$2"; shift 2 ;;
        --registry) REGISTRY="$2"; shift 2 ;;
        --baseline) BASELINE="$2"; shift 2 ;;
        --census) CENSUS="$2"; shift 2 ;;
        --critical) CRITICAL=1; shift ;;
        --selftest|--selftest-only) SELFTEST_ONLY=1; shift ;;
        --offenders) OFFENDERS="$2"; shift 2 ;;
        --generate-baseline) GENERATE_BASELINE=1; shift ;;
        *) echo "ERROR — nothing was checked (unknown argument: $1)"; exit 2 ;;
    esac
done

SELF_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
CENSUS_SCRIPT="$SELF_DIR/rt-call-site-census.shs"

# ---------------------------------------------------------------------------
# scan <root> <registry> <baseline> [census] -> prints
#   "<checked> <unregistered> <overbudget> <stalerow> <unowned> <ungrouped>
#    <stalebase>|<names>"
# or the single token ERR:<reason>. Never writes a verdict itself, so the
# selftest can call it directly.
#
# With RT_API_GEN_BASELINE=1 the baseline argument is the file to WRITE and
# is not required to exist; the comparison checks B/C/D are skipped.
# ---------------------------------------------------------------------------
scan() {
    sc_root="$1"; sc_reg="$2"; sc_base="$3"; sc_census="${4:-}"
    [ -d "$sc_root" ] || { echo "ERR:no root $sc_root"; return; }
    [ -f "$sc_reg" ]  || { echo "ERR:no registry $sc_reg"; return; }
    sc_gen=${RT_API_GEN_BASELINE:-0}
    if [ "$sc_gen" != "1" ]; then
        [ -n "$sc_base" ] || { echo "ERR:no baseline given"; return; }
        [ -s "$sc_base" ] || { echo "ERR:no baseline $sc_base"; return; }
    fi

    sc_work=$(mktemp -d) || { echo "ERR:mktemp"; return; }

    # Current text-visible definitions, both runtime lanes.
    find "$sc_root/src/runtime" \( -name '*.c' -o -name '*.h' \) \
         -not -path '*/vendor/*' -print0 2>/dev/null \
        | xargs -0 grep -hoE '\brt_[A-Za-z0-9_]+[[:space:]]*\([^;]*\)[[:space:]]*\{' 2>/dev/null \
        | grep -oE '^rt_[A-Za-z0-9_]+' | sort -u > "$sc_work/defs.txt"
    find "$sc_root/src/compiler_rust/runtime/src" -name '*.rs' -print0 2>/dev/null \
        | xargs -0 grep -hoE '\bfn[[:space:]]+rt_[A-Za-z0-9_]+' 2>/dev/null \
        | grep -oE 'rt_[A-Za-z0-9_]+' | sort -u >> "$sc_work/defs.txt"

    # Called symbols + per-symbol forbidden site counts, from the shared census.
    sh "$CENSUS_SCRIPT" --root "$sc_root" --roots src --out "$sc_work/sites.tsv" \
        >/dev/null 2>&1
    sc_rc=$?
    if [ $sc_rc -ne 0 ]; then
        rm -rf "$sc_work"; echo "ERR:call-site census produced nothing"; return
    fi
    grep -v '^#' "$sc_work/sites.tsv" | cut -f1 >> "$sc_work/defs.txt"
    sort -u "$sc_work/defs.txt" -o "$sc_work/defs.txt"

    if [ -n "$sc_census" ] && [ -f "$sc_census" ]; then
        grep -v '^#' "$sc_census" | grep -v '^symbol	' | cut -f1 \
            >> "$sc_work/defs.txt"
        sort -u "$sc_work/defs.txt" -o "$sc_work/defs.txt"
        sc_stale_mode=1
    else
        sc_stale_mode=0
    fi

    if [ ! -s "$sc_work/defs.txt" ]; then
        rm -rf "$sc_work"; echo "ERR:0 rt_* symbols visible in $sc_root"; return
    fi

    # The baseline is fed to awk as a file; an absent one (generate mode) is
    # substituted by /dev/null so the ARGV positions stay fixed.
    sc_basein="$sc_base"
    if [ "$sc_gen" = "1" ] && [ ! -s "$sc_basein" ]; then sc_basein=/dev/null; fi

    awk -v stale_mode="$sc_stale_mode" -v genmode="$sc_gen" -v baseout="$sc_base" '
        # --- registry: api_groups rows (6 fields) and api_symbols rows (10) ---
        FILENAME == ARGV[1] {
            line = $0
            if (substr(line, 1, 1) == "#") next
            if (line !~ /^    /) next
            nf = split(line, f, /, /)
            sub(/^ +/, "", f[1])
            for (i = 1; i <= nf; i++) { gsub(/^[ \t"]+|[ \t"]+$/, "", f[i]) }
            if (nf == 6) { gaccess[f[1] SUBSEP f[2]] = f[6]
                           if (f[1] == "rt") { ngrow++; isgroup[f[2]] = 1 }
                           next }
            if (nf == 10) { if (f[1] != "rt") next
                            reg[f[3]] = f[2]; nreg++
                            next }
            next
        }
        # --- frozen baseline: `ungrouped <sym>` and `budget <group> <n>` ------
        FILENAME == ARGV[2] {
            if (substr($0, 1, 1) == "#" || $0 == "") next
            if ($1 == "ungrouped" && NF >= 2) { bung[$2] = 1; nbung++; next }
            if ($1 == "budget" && NF >= 3)    { bbud[$2] = $3 + 0; nbbud++; next }
            next
        }
        # --- per-symbol current site counts ---
        FILENAME == ARGV[3] { if (substr($0, 1, 1) != "#") cur[$1] = $2 + 0; next }
        # --- currently visible symbols ---
        {
            sym = $0
            seen[sym] = 1
            nseen++
            if (!(sym in reg) || reg[sym] == "") { unreg[++nunreg] = sym; next }
            # B. `misc` is the residual bucket, not a group: a symbol there is
            #    ungrouped, and only the frozen baseline admits it.
            if (reg[sym] == "misc") {
                miscnow[sym] = 1
                if (genmode != "1" && !(sym in bung)) ungrouped[++nungrouped] = sym
            }
        }
        END {
            if (nreg == 0 || ngrow == 0) { print "ERR:registry has no rt rows"; exit }
            if (genmode != "1" && nbbud == 0) { print "ERR:baseline has no budget rows"; exit }

            # per-group current sites
            for (s in cur) {
                g = (s in reg) ? reg[s] : "?"
                gcur[g] += cur[s]
            }
            if (genmode != "1") {
                # D. per-group ratchet against the FROZEN budget.
                for (g in gcur) {
                    if (g == "?") continue
                    if (!(g in bbud)) { over[++nover] = g "(no baseline budget)"; continue }
                    if (gcur[g] > bbud[g]) over[++nover] = sprintf("%s:%d>%d", g, gcur[g], bbud[g])
                }
                # C. stale baseline: a baselined `misc` symbol that is now
                #    grouped, or gone from the tree.
                for (s in bung) {
                    if (!(s in seen)) { stalebase[++nstalebase] = s "(gone)"; continue }
                    if (!(s in miscnow)) stalebase[++nstalebase] = s "(now " reg[s] ")"
                }
            }
            if (stale_mode) {
                for (s in reg) if (!(s in seen)) stale[++nstale] = s
            }
            for (k in gaccess) if (gaccess[k] == "unowned") nunowned++

            if (genmode == "1") {
                printf "# rt API group baseline — FROZEN, reviewed, ratcheted.\n" > baseout
                printf "#\n" > baseout
                printf "# Written ONLY by `check-rt-api-groups.shs --generate-baseline`.\n" > baseout
                printf "# scripts/check/gen-api-registry.shs never touches this file: that is\n" > baseout
                printf "# the whole point — the registry is a mirror of the tree, this is the\n" > baseout
                printf "# reviewed floor the mirror is measured against.\n" > baseout
                printf "#\n" > baseout
                printf "#   ungrouped <symbol>    a symbol sitting in the residual bucket `misc`.\n" > baseout
                printf "#                         `misc` is NOT an API group. Every line here is\n" > baseout
                printf "#                         admitted debt. A NEW one is an error; the remedy\n" > baseout
                printf "#                         is a row in config/api/api_group_overrides.sdn,\n" > baseout
                printf "#                         not a line here.\n" > baseout
                printf "#   budget <group> <n>    forbidden direct rt_* call sites permitted for\n" > baseout
                printf "#                         that group under src/. Same population and same\n" > baseout
                printf "#                         allowlist as check-no-direct-rt.shs.\n" > baseout
                printf "#\n" > baseout
                printf "# Do NOT regenerate to clear a FAIL without reading the diff.\n" > baseout
                nu = 0
                for (s in miscnow) { uarr[++nu] = s }
                isort(uarr, nu)
                for (i = 1; i <= nu; i++) printf "ungrouped\t%s\n", uarr[i] > baseout
                nb = 0
                for (g in isgroup) { barr[++nb] = g }
                isort(barr, nb)
                for (i = 1; i <= nb; i++) printf "budget\t%s\t%d\n", barr[i], gcur[barr[i]] + 0 > baseout
                printf "%d %d %d %d %d %d %d|generated %d ungrouped + %d budget row(s)\n",
                       nseen + 0, nunreg + 0, 0, 0, nunowned + 0, 0, 0, nu, nb
                exit
            }

            names = ""
            for (i = 1; i <= nunreg     && i <= 12; i++) names = names " " unreg[i]
            for (i = 1; i <= nungrouped && i <= 12; i++) names = names " ungrouped:" ungrouped[i]
            for (i = 1; i <= nover      && i <= 12; i++) names = names " " over[i]
            for (i = 1; i <= nstalebase && i <= 12; i++) names = names " stale-baseline:" stalebase[i]
            for (i = 1; i <= nstale     && i <= 12; i++) names = names " stale-row:" stale[i]
            printf "%d %d %d %d %d %d %d|%s\n", nseen + 0, nunreg + 0, nover + 0,
                   nstale + 0, nunowned + 0, nungrouped + 0, nstalebase + 0, names
            if (ENVIRON["RT_API_OFFENDERS"] != "") {
                of = ENVIRON["RT_API_OFFENDERS"]
                for (i = 1; i <= nunreg;     i++) print "unregistered\t"   unreg[i]     > of
                for (i = 1; i <= nungrouped; i++) print "ungrouped\t"      ungrouped[i] > of
                for (i = 1; i <= nover;      i++) print "overbudget\t"     over[i]      > of
                for (i = 1; i <= nstalebase; i++) print "stale-baseline\t" stalebase[i] > of
                for (i = 1; i <= nstale;     i++) print "stale-row\t"      stale[i]     > of
            }
        }
        function isort(a, n,   i, j, t) {
            for (i = 2; i <= n; i++) { t = a[i]; j = i - 1
                while (j > 0 && a[j] > t) { a[j+1] = a[j]; j-- }
                a[j+1] = t }
        }
    ' "$sc_reg" "$sc_basein" "$sc_work/sites.tsv" "$sc_work/defs.txt"
    rm -rf "$sc_work"
}

# ---------------------------------------------------------------------------
# selftest — runs FIRST, always, and is fatal.
# ---------------------------------------------------------------------------
mkfixture() {
    # mkfixture <dir> <registry-body> [baseline-body]
    fx="$1"; body="$2"; base="${3:-}"
    mkdir -p "$fx/src/runtime" "$fx/src/lib/x" "$fx/scripts/check" "$fx/config/api"
    : > "$fx/scripts/check/no_direct_rt_allowlist.txt"
    printf 'int rt_demo_one(void) { return 1; }\n' > "$fx/src/runtime/demo.c"
    printf 'fn f():\n    y = rt_demo_one()\n' > "$fx/src/lib/x/call.spl"
    printf '%s' "$body" > "$fx/config/api/api_registry.sdn"
    printf '%s' "$base" > "$fx/scripts/check/rt_api_group_baseline.txt"
}

st_fail() {
    echo "ERROR — selftest failed: $1"
    rm -rf "$st_root"
    exit 2
}

selftest() {
    st_root=$(mktemp -d) || { echo "ERROR — nothing was checked (selftest mktemp)"; exit 2; }
    st_n=0

    REG_DEMO='api_groups |surface, group, symbols, sites, provider, access|
    rt, demo, 1, 1, "-", unowned

api_symbols |surface, group, symbol, lane, backing, class, sites, twin, alias, desc|
    rt, demo, rt_demo_one, c, text, provider, 1, no, -, "demo: one"
'
    BASE_DEMO='budget	demo	1
'

    # fixture 1: registered, grouped, on budget -> 0 offenders.
    mkfixture "$st_root/a" "$REG_DEMO" "$BASE_DEMO"
    r=$(scan "$st_root/a" "$st_root/a/config/api/api_registry.sdn" \
             "$st_root/a/scripts/check/rt_api_group_baseline.txt")
    st_n=$((st_n + 1))
    case "$r" in ERR:*) st_fail "clean fixture errored ($r)" ;; esac
    set -- ${r%%|*}
    [ "${2:-x}" = "0" ] && [ "${3:-x}" = "0" ] && [ "${6:-x}" = "0" ] && [ "${7:-x}" = "0" ] \
        || st_fail "clean fixture reported offenders (got '$r')"

    # fixture 2: an UNREGISTERED symbol must be caught. Check A.
    mkfixture "$st_root/b" "$REG_DEMO" "$BASE_DEMO"
    printf 'int rt_ghost_two(void) { return 2; }\n' > "$st_root/b/src/runtime/ghost.c"
    r=$(scan "$st_root/b" "$st_root/b/config/api/api_registry.sdn" \
             "$st_root/b/scripts/check/rt_api_group_baseline.txt")
    st_n=$((st_n + 1))
    set -- ${r%%|*}
    [ "${2:-x}" = "1" ] || st_fail "unregistered rt_ghost_two not caught (got '$r')"
    case "${r#*|}" in *rt_ghost_two*) ;; *) st_fail "offender not named (got '$r')" ;; esac

    # fixture 3: a NEW symbol that IS registered but lands in the residual
    # bucket `misc` and is not in the frozen baseline must FAIL as UNGROUPED.
    # This is the error the gate exists to raise.
    mkfixture "$st_root/c" 'api_groups |surface, group, symbols, sites, provider, access|
    rt, demo, 1, 1, "-", unowned
    rt, misc, 1, 0, "-", unowned

api_symbols |surface, group, symbol, lane, backing, class, sites, twin, alias, desc|
    rt, demo, rt_demo_one, c, text, provider, 1, no, -, "demo: one"
    rt, misc, rt_oneoff_hook, c, text, provider, 0, no, -, "misc: oneoff hook"
' 'budget	demo	1
budget	misc	0
'
    printf 'int rt_oneoff_hook(void) { return 3; }\n' > "$st_root/c/src/runtime/oneoff.c"
    r=$(scan "$st_root/c" "$st_root/c/config/api/api_registry.sdn" \
             "$st_root/c/scripts/check/rt_api_group_baseline.txt")
    st_n=$((st_n + 1))
    set -- ${r%%|*}
    [ "${6:-x}" = "1" ] || st_fail "ungrouped (misc, unbaselined) rt_oneoff_hook not caught (got '$r')"
    case "${r#*|}" in *ungrouped:rt_oneoff_hook*) ;; *) st_fail "ungrouped offender not named (got '$r')" ;; esac

    # fixture 4: the SAME symbol assigned to a real group by an override row
    # must PASS. Without this the ungrouped error would have no remedy other
    # than widening the baseline, which is exactly what it exists to prevent.
    mkfixture "$st_root/d" 'api_groups |surface, group, symbols, sites, provider, access|
    rt, demo, 2, 1, "-", unowned

api_symbols |surface, group, symbol, lane, backing, class, sites, twin, alias, desc|
    rt, demo, rt_demo_one, c, text, provider, 1, no, -, "demo: one"
    rt, demo, rt_oneoff_hook, c, text, provider, 0, no, -, "demo: oneoff hook"
' 'budget	demo	1
'
    printf 'int rt_oneoff_hook(void) { return 3; }\n' > "$st_root/d/src/runtime/oneoff.c"
    r=$(scan "$st_root/d" "$st_root/d/config/api/api_registry.sdn" \
             "$st_root/d/scripts/check/rt_api_group_baseline.txt")
    st_n=$((st_n + 1))
    set -- ${r%%|*}
    [ "${6:-x}" = "0" ] && [ "${2:-x}" = "0" ] \
        || st_fail "override-grouped symbol did not pass (got '$r')"

    # fixture 5: a group over its FROZEN budget must FAIL. Check D.
    mkfixture "$st_root/e" "$REG_DEMO" 'budget	demo	0
'
    r=$(scan "$st_root/e" "$st_root/e/config/api/api_registry.sdn" \
             "$st_root/e/scripts/check/rt_api_group_baseline.txt")
    st_n=$((st_n + 1))
    set -- ${r%%|*}
    [ "${3:-x}" = "1" ] || st_fail "over-budget group not caught (got '$r')"

    # fixture 6: a STALE baseline entry — baselined as `misc` but now grouped
    # — must FAIL. Check C.
    mkfixture "$st_root/f" "$REG_DEMO" 'ungrouped	rt_demo_one
budget	demo	1
'
    r=$(scan "$st_root/f" "$st_root/f/config/api/api_registry.sdn" \
             "$st_root/f/scripts/check/rt_api_group_baseline.txt")
    st_n=$((st_n + 1))
    set -- ${r%%|*}
    [ "${7:-x}" = "1" ] || st_fail "stale baseline entry (now grouped) not caught (got '$r')"

    # fixture 7: a baselined symbol that has LEFT the tree is also stale.
    mkfixture "$st_root/g" "$REG_DEMO" 'ungrouped	rt_vanished_sym
budget	demo	1
'
    r=$(scan "$st_root/g" "$st_root/g/config/api/api_registry.sdn" \
             "$st_root/g/scripts/check/rt_api_group_baseline.txt")
    st_n=$((st_n + 1))
    set -- ${r%%|*}
    [ "${7:-x}" = "1" ] || st_fail "stale baseline entry (gone) not caught (got '$r')"

    # fixture 8: a registry row for a symbol that no longer exists is a STALE
    # ROW — but only with --census, since the cheap universe cannot tell
    # stale from nm-only. Both halves are asserted.
    mkfixture "$st_root/h" 'api_groups |surface, group, symbols, sites, provider, access|
    rt, demo, 2, 1, "-", unowned

api_symbols |surface, group, symbol, lane, backing, class, sites, twin, alias, desc|
    rt, demo, rt_demo_one, c, text, provider, 1, no, -, "demo: one"
    rt, demo, rt_demo_gone, c, nm, provider, 0, no, -, "demo: gone"
' "$BASE_DEMO"
    printf '# c_lane_mode=nm\nsymbol\tc_lane\trust_lane\tsimple_twin\tdual_pair\tclass\nrt_demo_one\tyes\tno\tno\tno\tc-only\n' \
        > "$st_root/h/census.tsv"
    r=$(scan "$st_root/h" "$st_root/h/config/api/api_registry.sdn" \
             "$st_root/h/scripts/check/rt_api_group_baseline.txt")
    st_n=$((st_n + 1))
    set -- ${r%%|*}
    [ "${4:-x}" = "0" ] || st_fail "stale row detected without --census (got '$r')"
    r=$(scan "$st_root/h" "$st_root/h/config/api/api_registry.sdn" \
             "$st_root/h/scripts/check/rt_api_group_baseline.txt" "$st_root/h/census.tsv")
    st_n=$((st_n + 1))
    set -- ${r%%|*}
    [ "${4:-x}" = "1" ] || st_fail "stale row not caught with --census (got '$r')"

    # fixture 9: a tree with no rt_* at all must yield ERR, never a pass —
    # a run that checked nothing is not evidence of anything.
    mkdir -p "$st_root/i/src/runtime" "$st_root/i/src/lib" "$st_root/i/scripts/check" "$st_root/i/config/api"
    : > "$st_root/i/scripts/check/no_direct_rt_allowlist.txt"
    printf 'int plain(void) { return 0; }\n' > "$st_root/i/src/runtime/plain.c"
    printf 'api_symbols |surface, group, symbol, lane, backing, class, sites, twin, alias, desc|\n' \
        > "$st_root/i/config/api/api_registry.sdn"
    printf 'budget\tdemo\t0\n' > "$st_root/i/scripts/check/rt_api_group_baseline.txt"
    r=$(scan "$st_root/i" "$st_root/i/config/api/api_registry.sdn" \
             "$st_root/i/scripts/check/rt_api_group_baseline.txt")
    st_n=$((st_n + 1))
    case "$r" in ERR:*) ;; *) st_fail "empty tree did not ERR (got '$r')" ;; esac

    # fixture 10: a missing registry must ERR, not silently pass.
    r=$(scan "$st_root/a" "$st_root/a/config/api/does_not_exist.sdn" \
             "$st_root/a/scripts/check/rt_api_group_baseline.txt")
    st_n=$((st_n + 1))
    case "$r" in ERR:*) ;; *) st_fail "missing registry did not ERR (got '$r')" ;; esac

    # fixture 11: a missing baseline must ERR on a verification run. Absence
    # of a floor is absence of evidence, never a pass.
    r=$(scan "$st_root/a" "$st_root/a/config/api/api_registry.sdn" \
             "$st_root/a/scripts/check/does_not_exist.txt")
    st_n=$((st_n + 1))
    case "$r" in ERR:*) ;; *) st_fail "missing baseline did not ERR (got '$r')" ;; esac

    # fixture 12: a VERIFICATION run must NEVER rewrite the tracked baseline;
    # only --generate-baseline may. Regression fence for the recurring
    # baseline-auto-write defect (see check-no-direct-rt.shs fixture 6).
    st_before=$(cat "$st_root/e/scripts/check/rt_api_group_baseline.txt")
    scan "$st_root/e" "$st_root/e/config/api/api_registry.sdn" \
         "$st_root/e/scripts/check/rt_api_group_baseline.txt" >/dev/null
    st_after=$(cat "$st_root/e/scripts/check/rt_api_group_baseline.txt")
    st_n=$((st_n + 1))
    [ "$st_before" = "$st_after" ] \
        || st_fail "verification run rewrote the tracked baseline"
    RT_API_GEN_BASELINE=1 scan "$st_root/e" "$st_root/e/config/api/api_registry.sdn" \
         "$st_root/e/scripts/check/rt_api_group_baseline.txt" >/dev/null
    st_gen=$(cat "$st_root/e/scripts/check/rt_api_group_baseline.txt")
    st_n=$((st_n + 1))
    [ "$st_gen" != "$st_before" ] \
        || st_fail "--generate-baseline did not update the baseline"
    unset RT_API_GEN_BASELINE

    rm -rf "$st_root"
    SELFTEST_N=$st_n
}

selftest
if [ "$SELFTEST_ONLY" -eq 1 ]; then
    echo "PASS — $SELFTEST_N selftest fixture(s) checked"
    exit 0
fi

# ---- real scan -------------------------------------------------------------
[ -n "$ROOT" ] || ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$ROOT" ] || [ ! -d "$ROOT/src" ]; then
    echo "ERROR — nothing was checked (no repo root; pass --root)"
    exit 2
fi
[ -n "$REGISTRY" ] || REGISTRY="$ROOT/config/api/api_registry.sdn"
[ -n "$BASELINE" ] || BASELINE="$ROOT/scripts/check/rt_api_group_baseline.txt"

if [ -n "$OFFENDERS" ]; then
    mkdir -p "$(dirname "$OFFENDERS")"; : > "$OFFENDERS"
    RT_API_OFFENDERS="$OFFENDERS"; export RT_API_OFFENDERS
fi

if [ "$GENERATE_BASELINE" -eq 1 ]; then
    RT_API_GEN_BASELINE=1; export RT_API_GEN_BASELINE
fi

result=$(scan "$ROOT" "$REGISTRY" "$BASELINE" "$CENSUS")
case "$result" in
    ERR:*) echo "ERROR — nothing was checked (${result#ERR:})"; exit 2 ;;
esac

agg=${result%%|*}
names=${result#*|}
set -- $agg
if [ $# -ne 7 ]; then
    echo "ERROR — nothing was checked (scan produced no counts)"
    exit 2
fi
checked=$1; unreg=$2; over=$3; stale=$4; unowned=$5; ungrouped=$6; stalebase=$7

if [ "$checked" -le 0 ]; then
    echo "ERROR — nothing was checked (0 rt_* symbols visible)"
    exit 2
fi

if [ "$GENERATE_BASELINE" -eq 1 ]; then
    echo "PASS — $checked rt_* symbol(s) checked, baseline rewritten at $BASELINE ($names)"
    exit 0
fi

stale_note="stale-row check OFF (no --census)"
[ -n "$CENSUS" ] && stale_note="stale-row=$stale"

if [ "$unreg" -gt 0 ] || [ "$ungrouped" -gt 0 ] || [ "$over" -gt 0 ] \
   || [ "$stalebase" -gt 0 ] || { [ -n "$CENSUS" ] && [ "$stale" -gt 0 ]; }; then
    echo "FAIL — $checked rt_* symbol(s) checked, $unreg unregistered, $ungrouped ungrouped (in \`misc\`, not in the frozen baseline), $over group(s) over their frozen call-site budget, $stalebase stale baseline entry(ies), $stale_note;$names"
    exit 1
fi

if [ "$CRITICAL" -eq 1 ] && [ "$unowned" -gt 0 ]; then
    echo "FAIL — critical mode: $checked rt_* symbol(s) checked, all registered and grouped, but $unowned group(s) have no allowlisted provider (access=unowned)"
    exit 1
fi

echo "PASS — $checked rt_* symbol(s) checked, 0 unregistered, 0 newly ungrouped, 0 group(s) over budget, 0 stale baseline entries, $stale_note, $unowned group(s) still unowned"
exit 0
