#!/bin/sh
# Trace WHATWG HTML elements and W3C CSS property inventory to SSpec coverage.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

BUILD_DIR="${BUILD_DIR:-build/html_css_sspec_traceability}"
REPORT_PATH="${REPORT_PATH:-doc/09_report/html_css_sspec_traceability_$(date -u +%F).md}"
OUT_ENV="$BUILD_DIR/evidence.env"

mkdir -p "$BUILD_DIR" "$(dirname -- "$REPORT_PATH")"
tmp_env="$OUT_ENV.tmp"

set +e
HTML_CSS_SSPEC_BEHAVIOR_EVIDENCE="${HTML_CSS_SSPEC_BEHAVIOR_EVIDENCE:-$BUILD_DIR/behavior.env}" \
HTML_CSS_SSPEC_FETCH="${HTML_CSS_SSPEC_FETCH:-1}" \
HTML_CSS_SSPEC_OUTPUT_DIR="$BUILD_DIR" \
python3 - <<'PY' >"$tmp_env"
from html.parser import HTMLParser
from pathlib import Path
from urllib.request import Request, urlopen
import hashlib
import os
import re
import subprocess
import sys

ROOT = Path.cwd()
HTML_URL = "https://html.spec.whatwg.org/multipage/indices.html"
CSS_URL = "https://www.w3.org/TR/CSS/"

HTML_TEST_ROOTS = [
    "test/01_unit/lib/common/web",
    "test/01_unit/lib/gc_async_mut/gpu/browser_engine",
    "test/01_unit/app/ui",
    "test/02_integration/rendering",
    "test/03_system/gui",
    "test/03_system/feature/web_platform/html",
]

CSS_TEST_ROOTS = [
    "test/01_unit/lib/gc_async_mut/gpu/browser_engine",
    "test/01_unit/app/ui",
    "test/02_integration/rendering",
    "test/03_system/gui",
    "test/03_system/feature/web_platform/css",
]

TRACE_DOC = ROOT / "doc/03_plan/sys_test/html_css_spec_traceability.md"
BEHAVIOR_EVIDENCE = Path(os.environ["HTML_CSS_SSPEC_BEHAVIOR_EVIDENCE"])
FETCH_INVENTORY = os.environ["HTML_CSS_SSPEC_FETCH"] != "0"
OUTPUT_DIR = Path(os.environ["HTML_CSS_SSPEC_OUTPUT_DIR"])

HTML_BEHAVIOR_ROOT = "test/03_system/feature/web_platform/html/"
CSS_BEHAVIOR_ROOT = "test/03_system/feature/web_platform/css/"
FROZEN_STEPS = {
    'step("Verify executable HTML and CSS traceability")',
    'step("Trace HTML elements through Web semantics and Draw IR")',
    'step("Trace implemented CSS properties through canonical rendering")',
    'step("Classify unsupported CSS properties without false implementation claims")',
}
MATRIX_HEADER = [
    "kind", "name", "req", "support", "spec", "scenario", "manual",
    "source_sha256", "semantic_oracle", "layout_draw_ir_oracle",
    "engine2d_oracle", "negative_control",
]
BEHAVIOR_KEYS = [
    "runner_path", "runner_sha256", "source_revision", "matrix_path",
    "matrix_sha256",
]
HTML_REQUIRED_EXTRA = {"h1", "h2", "h3", "h4", "h5", "h6", "sub", "sup"}

CSS_IMPLEMENTED_SPEC = "test/01_unit/lib/gc_async_mut/gpu/browser_engine/simple_web_generated_html_css_combinations_spec.spl"
CSS_INVENTORY_SPEC = "test/01_unit/lib/gc_async_mut/gpu/browser_engine/simple_web_css_inventory_traceability_spec.spl"

CSS_SUPPORTED = {
    "accent-color",
    "align-content", "align-items", "align-self",
    "animation", "animation-delay", "animation-direction", "animation-duration", "animation-fill-mode", "animation-iteration-count", "animation-name", "animation-play-state", "animation-timing-function",
    "aspect-ratio",
    "transform-box", "transform-origin", "transform-style",
    "backface-visibility", "background", "background-attachment", "background-blend-mode", "background-clip", "background-color", "background-origin", "background-image", "background-position", "background-repeat", "background-size", "border", "border-collapse", "border-spacing", "border-bottom", "border-bottom-color",
    "border-bottom-style", "border-bottom-width", "border-color", "border-left", "border-left-color",
    "border-left-style", "border-left-width", "border-right", "border-right-color", "border-right-style",
    "border-right-width", "border-style", "border-top", "border-top-color", "border-top-style",
    "border-top-width", "border-width", "border-radius", "border-bottom-left-radius",
    "border-bottom-right-radius", "border-top-left-radius", "border-top-right-radius",
    "border-start-start-radius", "border-start-end-radius", "border-end-start-radius", "border-end-end-radius",
    "border-block", "border-block-color", "border-block-end", "border-block-end-color",
    "border-block-end-style", "border-block-end-width", "border-block-start",
    "border-block-start-color", "border-block-start-style", "border-block-start-width",
    "border-block-style", "border-block-width",
    "border-inline", "border-inline-color", "border-inline-end", "border-inline-end-color",
    "border-inline-end-style", "border-inline-end-width", "border-inline-start",
    "border-inline-start-color", "border-inline-start-style", "border-inline-start-width",
    "border-inline-style", "border-inline-width",
    "box-shadow", "box-sizing",
    "caption-side", "caret-color", "clear", "clip", "clip-path", "color", "color-adjust", "color-scheme", "column-count", "column-width", "columns", "column-rule", "column-rule-color", "column-rule-style", "column-rule-width", "column-gap", "content", "content-visibility", "contain", "cursor", "direction", "display", "empty-cells", "filter", "flex", "flex-basis", "forced-color-adjust", "flex-direction", "flex-flow",
    "flex-grow", "flex-shrink", "flex-wrap", "font", "font-family", "font-feature-settings", "font-language-override", "font-variation-settings", "font-variant", "font-variant-alternates", "font-variant-caps", "font-variant-east-asian", "font-variant-emoji", "font-variant-ligatures", "font-variant-numeric", "font-variant-position", "font-kerning", "font-optical-sizing", "font-palette", "font-stretch", "font-width", "font-size", "font-size-adjust", "font-style", "font-synthesis", "font-synthesis-small-caps", "font-synthesis-position", "font-synthesis-style", "font-synthesis-weight", "font-weight", "gap", "grid", "grid-area", "grid-auto-flow", "grid-column", "grid-column-gap", "grid-column-start", "grid-gap", "grid-row", "grid-row-gap", "grid-row-start", "grid-template", "grid-template-areas", "grid-template-columns", "grid-template-rows",
    "float", "height", "image-rendering", "inline-size", "inset", "inset-block", "inset-block-end", "inset-block-start", "inset-inline", "inset-inline-end", "inset-inline-start", "justify-content", "justify-items", "justify-self", "left", "letter-spacing", "line-height", "line-break", "hyphens", "list-style", "list-style-image", "list-style-position", "list-style-type", "bottom", "margin", "margin-block", "margin-block-end", "margin-block-start", "margin-bottom",
    "margin-inline", "margin-inline-end", "margin-inline-start", "margin-left", "margin-right", "margin-top", "max-block-size", "max-height", "max-inline-size", "max-width",
    "min-block-size", "min-height", "min-inline-size", "min-width", "object-fit", "object-position", "opacity", "order", "orphans", "outline", "outline-color",
    "outline-offset", "outline-style", "outline-width", "overflow", "overflow-wrap", "overflow-x",
    "overflow-y", "padding", "padding-block", "padding-block-end", "padding-block-start", "padding-bottom", "padding-inline", "padding-inline-end", "padding-inline-start", "padding-left", "padding-right",
    "padding-top", "place-content", "place-items", "place-self", "position", "print-color-adjust", "quotes", "resize", "rotate", "scale", "scrollbar-color", "scrollbar-width", "right", "row-gap", "tab-size", "table-layout", "text-align", "text-align-all", "text-decoration",
    "text-align-last", "text-decoration-color", "text-decoration-line", "text-decoration-style", "text-decoration-thickness", "text-emphasis", "text-emphasis-color", "text-emphasis-position", "text-emphasis-style", "text-indent", "text-combine-upright", "text-justify", "text-orientation", "text-overflow", "text-shadow", "text-transform", "text-underline-offset", "text-underline-position", "top", "transform",
    "transition", "transition-delay", "transition-duration", "transition-property", "transition-timing-function", "translate",
    "unicode-bidi", "vertical-align", "visibility", "white-space", "widows", "width", "block-size", "will-change", "word-break", "word-spacing", "word-wrap", "writing-mode", "z-index",
}

CSS_NAME_RE = re.compile(
    r"^(accent|align|all|animation|appearance|aspect|azimuth|backdrop|backface|"
    r"background|block|border|bottom|box|break|caption|caret|clear|clip|color|"
    r"column|contain|container|content|counter|cursor|direction|display|empty|"
    r"field|filter|flex|float|font|gap|grid|height|hyphen|image|initial|inline|"
    r"inset|isolation|justify|left|letter|line|list|margin|marker|mask|max|min|"
    r"mix|object|offset|opacity|order|orphans|outline|overflow|overscroll|padding|"
    r"page|paint|perspective|pitch|place|play|pointer|position|print|property|"
    r"quotes|resize|rest|richness|right|rotate|row|ruby|scale|scroll|shape|speak|"
    r"tab|table|text|top|touch|transform|transition|translate|unicode|user|"
    r"vertical|view|visibility|voice|white|widows|width|will|word|writing|z-index)"
)


def fetch(url: str) -> str:
    req = Request(url, headers={"User-Agent": "simple-html-css-traceability"})
    with urlopen(req, timeout=30) as response:
        return response.read().decode("utf-8", "replace")


def html_tags(source: str) -> list[str]:
    tags = set()
    for match in re.finditer(r"<code id=elements-3:the-([a-z0-9-]+)-element><a [^>]*>([a-z0-9-]+)</a></code>", source):
        tags.add(match.group(2))
    # The current index groups these shared-definition elements outside the
    # per-element anchors matched above. Keep them in the inventory explicitly.
    return sorted(tags | HTML_REQUIRED_EXTRA)


def css_properties(source: str) -> list[str]:
    props = set()
    for match in re.finditer(r"<a[^>]*href=\"[^\"]*#(?:propdef-|propertydef-)([a-zA-Z0-9_-]+)\"[^>]*>(--[a-zA-Z0-9_-]+|[a-zA-Z-]+)</a>", source):
        props.add(match.group(2))
    for match in re.finditer(r"<code[^>]*>([a-zA-Z-]{2,})</code>", source):
        name = match.group(1)
        if CSS_NAME_RE.match(name):
            props.add(name)
    return sorted(props)


def read_roots(roots: list[str]) -> str:
    parts = []
    for root in roots:
        base = ROOT / root
        if not base.exists():
            continue
        for path in base.rglob("*"):
            if path.suffix == ".spl":
                parts.append(f"\nFILE:{path.relative_to(ROOT)}\n")
                parts.append(path.read_text(encoding="utf-8", errors="ignore"))
    return "".join(parts)


def read_text(path: str) -> str:
    file_path = ROOT / path
    if not file_path.exists():
        return ""
    return file_path.read_text(encoding="utf-8", errors="ignore")


def text_has_html_tag(blob: str, tag: str) -> bool:
    esc = re.escape(tag)
    return re.search(rf"<{esc}(\s|>|/)|['\"]{esc}['\"]|\b{esc}\b", blob, re.I) is not None


def text_has_css_property(blob: str, prop: str) -> bool:
    esc = re.escape(prop)
    return re.search(rf"(^|[^a-zA-Z-]){esc}\s*:|['\"]{esc}['\"]|\b{esc}\b", blob, re.I | re.M) is not None


def text_has_css_inventory_property(blob: str, prop: str) -> bool:
    esc = re.escape(prop)
    return re.search(rf"(?<![a-zA-Z0-9_-]){esc}(?![a-zA-Z0-9_-])", blob, re.I) is not None


def emit(key: str, value) -> None:
    text = "" if value is None else str(value)
    print(f"{key}={text.replace(chr(10), ' ')}")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def valid_sha256(value: str) -> bool:
    return re.fullmatch(r"[0-9a-f]{64}", value) is not None


def read_env(path: Path) -> dict[str, str]:
    values = {}
    if not path.is_file():
        return values
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if "=" not in raw or raw.startswith("#"):
            continue
        key, value = raw.split("=", 1)
        values[key.strip()] = value.strip()
    return values


def repo_path(value: str) -> Path | None:
    path = Path(value)
    if path.is_absolute() or ".." in path.parts:
        return None
    resolved = ROOT / path
    try:
        resolved.relative_to(ROOT)
    except ValueError:
        return None
    return resolved


def canonical_manual(spec: str) -> str:
    if not spec.startswith("test/") or not spec.endswith(".spl"):
        return ""
    return "doc/06_spec/" + spec[len("test/"):-len(".spl")] + ".md"


def qualified_runner(path_text: str, expected_sha: str) -> bool:
    path = Path(path_text)
    if not path.is_absolute():
        path = ROOT / path
    try:
        relative = path.resolve().relative_to(ROOT.resolve()).as_posix()
    except ValueError:
        return False
    if re.fullmatch(r"bin/release/[^/]+/simple", relative) is None:
        return False
    if not path.is_file() or not os.access(path, os.X_OK):
        return False
    if not valid_sha256(expected_sha) or sha256_file(path) != expected_sha:
        return False
    for seed in (
        ROOT / "src/compiler_rust/target/bootstrap/simple",
        ROOT / "bin/simple",
    ):
        if seed.is_file() and sha256_file(seed) == expected_sha:
            return False
    return True


def oracle_bound(value: str, source: str) -> bool:
    return value.startswith("n/a:") or value in source


def scenario_body(source: str, scenario: str) -> str:
    lines = source.splitlines()
    marker = f'    it "{scenario}":'
    for index, line in enumerate(lines):
        if line != marker:
            continue
        end = index + 1
        while end < len(lines) and not lines[end].startswith("    it \""):
            end += 1
        return "\n".join(lines[index:end])
    return ""


def validate_matrix(path: Path, html: list[str], css: list[str]):
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    if not lines or lines[0].split("\t") != MATRIX_HEADER:
        return False, "invalid-matrix-header", []

    seen = set()
    specs = set()
    manuals = set()
    scenarios = set()
    rows = []
    for line in lines[1:]:
        if not line.strip():
            continue
        fields = line.split("\t")
        if len(fields) != len(MATRIX_HEADER):
            return False, "invalid-matrix-row", []
        row = dict(zip(MATRIX_HEADER, fields))
        key = (row["kind"], row["name"])
        if key in seen or row["kind"] not in {"html", "css"}:
            return False, "invalid-matrix-name", []
        seen.add(key)
        if row["support"] not in {"full", "unsupported-fail-closed", "excluded-nonproperty"}:
            return False, "invalid-matrix-support", []
        if not row["req"].startswith("REQ-WEB-BROWSER-"):
            return False, "missing-matrix-requirement", []
        if not row["scenario"].startswith("should "):
            return False, "nonbehavioral-matrix-scenario", []
        required_root = HTML_BEHAVIOR_ROOT if row["kind"] == "html" else CSS_BEHAVIOR_ROOT
        if not row["spec"].startswith(required_root):
            return False, "noncanonical-matrix-spec", []
        if row["manual"] != canonical_manual(row["spec"]):
            return False, "noncanonical-matrix-manual", []
        spec_path = repo_path(row["spec"])
        manual_path = repo_path(row["manual"])
        if spec_path is None or manual_path is None or not spec_path.is_file() or not manual_path.is_file():
            return False, "missing-matrix-artifact", []
        source_sha = sha256_file(spec_path)
        if row["source_sha256"] != source_sha:
            return False, "stale-matrix-source-hash", []
        source = spec_path.read_text(encoding="utf-8", errors="replace")
        manual = manual_path.read_text(encoding="utf-8", errors="replace")
        body = scenario_body(source, row["scenario"])
        req_pattern = rf"(?m)^\s*# @req(?: .*)?\b{re.escape(row['req'])}\b"
        if not body or re.search(req_pattern, body) is None:
            return False, "missing-executable-matrix-binding", []
        if not any(step in body for step in FROZEN_STEPS):
            return False, "missing-frozen-step", []
        if row["scenario"] not in manual or f"Source SHA-256: `{source_sha}`" not in manual:
            return False, "stale-matrix-manual", []
        oracles = [
            row["semantic_oracle"], row["layout_draw_ir_oracle"],
            row["engine2d_oracle"], row["negative_control"],
        ]
        if any(not value or not oracle_bound(value, body) for value in oracles):
            return False, "missing-behavior-oracle", []
        if row["support"] == "full" and any(value.startswith("n/a:") for value in oracles):
            return False, "full-row-missing-behavior-oracle", []
        if row["support"] != "full" and row["negative_control"].startswith("n/a:"):
            return False, "missing-negative-control", []
        specs.add(row["spec"])
        manuals.add(row["manual"])
        scenarios.add((row["spec"], row["scenario"]))
        rows.append(row)

    expected = {("html", name) for name in html} | {("css", name) for name in css}
    if seen != expected:
        return False, "incomplete-matrix-inventory", []
    return True, "pass", rows


def current_source_revision() -> str:
    result = subprocess.run(
        ["jj", "log", "--no-graph", "-r", "@", "-T", "commit_id"],
        cwd=ROOT, text=True, capture_output=True, timeout=30,
    )
    revision = result.stdout.strip()
    if result.returncode != 0 or re.fullmatch(r"[0-9a-f]{40,64}", revision) is None:
        return ""
    return revision


def result_marker(row: dict[str, str], revision: str) -> str:
    identity = f"{row['kind']}:{row['name']}"
    scenario_sha = hashlib.sha256(
        f"{row['spec']}\0{row['scenario']}".encode("utf-8")
    ).hexdigest()
    return (
        f"HTML_CSS_TRACEABILITY_RESULT id={identity} status=pass "
        f"scenario_sha256={scenario_sha} source_sha256={row['source_sha256']} "
        f"revision={revision}"
    )


def fresh_runner_results(runner_text: str, rows: list[dict[str, str]], revision: str):
    runner = Path(runner_text)
    if not runner.is_absolute():
        runner = ROOT / runner
    specs = sorted({row["spec"] for row in rows})
    scenarios = {(row["spec"], row["scenario"]) for row in rows}
    output_parts = []
    environment = os.environ.copy()
    environment["SIMPLE_NO_STUB_FALLBACK"] = "1"

    for spec in specs:
        try:
            result = subprocess.run(
                [str(runner), "test", spec, "--mode=native"],
                cwd=ROOT, env=environment, text=True, capture_output=True,
                timeout=600,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            return False, f"runner-execution-failed:{type(exc).__name__}", {}, ""
        combined = result.stdout + result.stderr
        output_parts.append(
            f"COMMAND spec={spec} exit={result.returncode}\n{combined}"
        )
        if result.returncode != 0:
            return False, "runner-scenario-failure", {}, "\n".join(output_parts)
        for row in rows:
            if row["spec"] == spec and result_marker(row, revision) not in combined:
                return False, "missing-runner-row-result", {}, "\n".join(output_parts)

    execution_log = "\n".join(output_parts)
    if "rust bootstrap seed" in execution_log.lower():
        return False, "seed-runner-rejected", {}, execution_log
    counts = {
        "executed_count": str(len(scenarios)),
        "passed_count": str(len(scenarios)),
        "failed_count": "0",
        "empty_count": "0" if scenarios else "1",
        "stub_count": "0",
        "spec_count": str(len(specs)),
        "manual_count": str(len({row["manual"] for row in rows})),
    }
    return True, "pass", counts, execution_log


def validate_behavior(html: list[str], css: list[str]) -> tuple[bool, str, dict[str, str]]:
    raw = read_env(BEHAVIOR_EVIDENCE)
    values = {key: raw.get(f"html_css_behavior_{key}", "") for key in BEHAVIOR_KEYS}
    values.update({
        "execution_log_path": "",
        "execution_log_sha256": "",
        "executed_count": "0",
        "passed_count": "0",
        "failed_count": "0",
        "empty_count": "",
        "stub_count": "",
        "spec_count": "",
        "manual_count": "",
        "receipt_sha256": "",
    })
    if not raw:
        return False, "missing-behavior-evidence", values
    if any(values[key] == "" for key in BEHAVIOR_KEYS):
        return False, "incomplete-behavior-evidence", values
    # No repository-owned receipt currently proves a full target CLI is both
    # pure-Simple and bound to this exact jj revision. Fail closed until that
    # existing bootstrap/release workflow emits a reviewed admission format.
    return False, "trusted-runner-admission-unavailable", values


def main() -> int:
    inventory_status = "pass"
    inventory_reason = "pass"
    html = []
    css = []
    if FETCH_INVENTORY:
        try:
            html = html_tags(fetch(HTML_URL))
            css = css_properties(fetch(CSS_URL))
        except Exception as exc:
            inventory_status = "evidence-blocked"
            inventory_reason = f"inventory-fetch-failed:{type(exc).__name__}"
    else:
        inventory_status = "evidence-blocked"
        inventory_reason = "inventory-fetch-disabled"

    html_blob = read_roots(HTML_TEST_ROOTS)
    css_blob = read_roots(CSS_TEST_ROOTS)
    inventory_blob = read_text(CSS_INVENTORY_SPEC)

    missing_html = [tag for tag in html if not text_has_html_tag(html_blob, tag)]

    indexed_implemented_css = [prop for prop in css if prop in CSS_SUPPORTED]
    unsupported_css = [prop for prop in css if prop not in CSS_SUPPORTED]
    missing_implemented_css_assignment = []
    missing_unsupported_css_assignment = []
    for prop in css:
        if prop in CSS_SUPPORTED:
            if not text_has_css_property(css_blob, prop):
                missing_implemented_css_assignment.append(prop)
        else:
            if not text_has_css_inventory_property(inventory_blob, prop):
                missing_unsupported_css_assignment.append(prop)
    missing_css_assignment = missing_implemented_css_assignment + missing_unsupported_css_assignment

    if inventory_status == "pass" and len(html) != 113:
        inventory_status = "fail"
        inventory_reason = "unexpected-html-tag-count"
    elif inventory_status == "pass" and len(css) < 390:
        inventory_status = "fail"
        inventory_reason = "unexpected-css-property-count"
    elif inventory_status == "pass" and missing_html:
        inventory_status = "fail"
        inventory_reason = "html-tags-missing-inventory-assignment"
    elif inventory_status == "pass" and missing_css_assignment:
        inventory_status = "fail"
        inventory_reason = "css-properties-missing-inventory-assignment"

    behavior_valid, behavior_reason, behavior = validate_behavior(html, css)
    status = "pass"
    reason = "pass"
    if not behavior_valid:
        status = "evidence-blocked"
        reason = behavior_reason
    elif inventory_status != "pass":
        status = "evidence-blocked"
        reason = inventory_reason
    elif not TRACE_DOC.is_file():
        status = "evidence-blocked"
        reason = "missing-traceability-plan"

    emit("html_css_sspec_traceability_status", status)
    emit("html_css_sspec_traceability_reason", reason)
    emit("html_css_sspec_traceability_inventory_status", inventory_status)
    emit("html_css_sspec_traceability_inventory_reason", inventory_reason)
    emit("html_css_sspec_traceability_behavior_evidence", BEHAVIOR_EVIDENCE)
    emit("html_css_sspec_traceability_behavior_evidence_valid", str(behavior_valid).lower())
    emit("html_css_sspec_traceability_html_url", HTML_URL)
    emit("html_css_sspec_traceability_css_url", CSS_URL)
    emit("html_css_sspec_traceability_html_tag_count", len(html))
    emit("html_css_sspec_traceability_required_html_tag_count", 113)
    emit("html_css_sspec_traceability_html_tag_missing", ",".join(missing_html))
    emit("html_css_sspec_traceability_css_property_count", len(css))
    emit("html_css_sspec_traceability_required_css_property_min_count", 390)
    emit("html_css_sspec_traceability_css_property_missing_count", len(missing_css_assignment))
    emit("html_css_sspec_traceability_css_property_missing", ",".join(missing_css_assignment[:120]))
    emit("html_css_sspec_traceability_implemented_css_property_count", len(CSS_SUPPORTED))
    emit("html_css_sspec_traceability_implemented_css_property_indexed_count", len(indexed_implemented_css))
    emit("html_css_sspec_traceability_implemented_css_property_missing_count", len(missing_implemented_css_assignment))
    emit("html_css_sspec_traceability_implemented_css_property_missing", ",".join(missing_implemented_css_assignment[:120]))
    emit("html_css_sspec_traceability_unsupported_css_property_count", len(unsupported_css))
    emit("html_css_sspec_traceability_unsupported_css_properties", ",".join(unsupported_css))
    emit("html_css_sspec_traceability_unsupported_css_property_missing_count", len(missing_unsupported_css_assignment))
    emit("html_css_sspec_traceability_unsupported_css_property_missing", ",".join(missing_unsupported_css_assignment[:120]))
    emit("html_css_sspec_traceability_implemented_css_subset_spec", CSS_IMPLEMENTED_SPEC)
    emit("html_css_sspec_traceability_unsupported_css_inventory_spec", CSS_INVENTORY_SPEC)
    emit("html_css_sspec_traceability_runner_path", behavior.get("runner_path", ""))
    emit("html_css_sspec_traceability_runner_sha256", behavior.get("runner_sha256", ""))
    emit("html_css_sspec_traceability_source_revision", behavior.get("source_revision", ""))
    emit("html_css_sspec_traceability_matrix_path", behavior.get("matrix_path", ""))
    emit("html_css_sspec_traceability_matrix_sha256", behavior.get("matrix_sha256", ""))
    emit("html_css_sspec_traceability_execution_log_path", behavior.get("execution_log_path", ""))
    emit("html_css_sspec_traceability_execution_log_sha256", behavior.get("execution_log_sha256", ""))
    emit("html_css_sspec_traceability_executed_count", behavior.get("executed_count", "0"))
    emit("html_css_sspec_traceability_passed_count", behavior.get("passed_count", "0"))
    emit("html_css_sspec_traceability_failed_count", behavior.get("failed_count", "0"))
    emit("html_css_sspec_traceability_empty_count", behavior.get("empty_count", ""))
    emit("html_css_sspec_traceability_stub_count", behavior.get("stub_count", ""))
    emit("html_css_sspec_traceability_spec_count", behavior.get("spec_count", ""))
    emit("html_css_sspec_traceability_manual_count", behavior.get("manual_count", ""))
    emit("html_css_sspec_traceability_receipt_sha256", behavior.get("receipt_sha256", ""))
    return 0 if status == "pass" else 1


try:
    sys.exit(main())
except Exception as exc:
    emit("html_css_sspec_traceability_status", "evidence-blocked")
    emit("html_css_sspec_traceability_reason", "traceability-exception")
    emit("html_css_sspec_traceability_error", f"{type(exc).__name__}:{exc}")
    emit("html_css_sspec_traceability_html_url", HTML_URL)
    emit("html_css_sspec_traceability_css_url", CSS_URL)
    emit("html_css_sspec_traceability_required_html_tag_count", 113)
    emit("html_css_sspec_traceability_required_css_property_min_count", 390)
    sys.exit(1)
PY
code=$?
set -e

mv "$tmp_env" "$OUT_ENV"

status="$(sed -n 's/^html_css_sspec_traceability_status=//p' "$OUT_ENV" | tail -n 1)"
reason="$(sed -n 's/^html_css_sspec_traceability_reason=//p' "$OUT_ENV" | tail -n 1)"
html_count="$(sed -n 's/^html_css_sspec_traceability_html_tag_count=//p' "$OUT_ENV" | tail -n 1)"
css_count="$(sed -n 's/^html_css_sspec_traceability_css_property_count=//p' "$OUT_ENV" | tail -n 1)"
implemented_css_count="$(sed -n 's/^html_css_sspec_traceability_implemented_css_property_count=//p' "$OUT_ENV" | tail -n 1)"
implemented_css_spec="$(sed -n 's/^html_css_sspec_traceability_implemented_css_subset_spec=//p' "$OUT_ENV" | tail -n 1)"
inventory_css_spec="$(sed -n 's/^html_css_sspec_traceability_unsupported_css_inventory_spec=//p' "$OUT_ENV" | tail -n 1)"

{
    echo "# HTML/CSS SSpec Traceability"
    echo
    echo "- status: $status"
    echo "- reason: $reason"
    echo "- WHATWG HTML elements: $html_count/113"
    echo "- W3C CSS property-like entries: $css_count >= 390"
    echo "- implemented Simple Web CSS properties: $implemented_css_count"
    echo "- implemented CSS subset spec: $implemented_css_spec"
    echo "- unsupported CSS inventory spec: $inventory_css_spec"
    echo "- qualified executed scenarios: $(sed -n 's/^html_css_sspec_traceability_executed_count=//p' "$OUT_ENV" | tail -n 1)"
    echo "- qualified passed scenarios: $(sed -n 's/^html_css_sspec_traceability_passed_count=//p' "$OUT_ENV" | tail -n 1)"
    echo "- qualified failed scenarios: $(sed -n 's/^html_css_sspec_traceability_failed_count=//p' "$OUT_ENV" | tail -n 1)"
    echo "- qualified runner SHA-256: $(sed -n 's/^html_css_sspec_traceability_runner_sha256=//p' "$OUT_ENV" | tail -n 1)"
    echo "- matrix SHA-256: $(sed -n 's/^html_css_sspec_traceability_matrix_sha256=//p' "$OUT_ENV" | tail -n 1)"
    echo
    echo "## Raw Evidence"
    sed 's/^/- /' "$OUT_ENV"
} >"$REPORT_PATH"

cat "$OUT_ENV"

if [ "$status" = "pass" ]; then
    echo "PASS: executable HTML/CSS SSpec traceability html_tags=$html_count css_properties=$css_count"
    echo "PASS: implemented CSS subset spec=$implemented_css_spec"
    echo "PASS: unsupported CSS inventory spec=$inventory_css_spec"
    exit 0
fi

exit "$code"
