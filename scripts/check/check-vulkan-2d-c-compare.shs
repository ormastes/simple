#!/bin/sh
# check-vulkan-2d-c-compare.shs — Engine2D Vulkan 2D perf vs the C reference.
#
# THE CONTRACT
#   test/05_perf/bench/vulkan_2d_c/vk2d_bench.c is the C Vulkan reference (adapted from the
#   Magicalbat/videos single-file headless compute example): per frame it does
#   vkCmdFillBuffer clear + N rect-fill compute dispatches + optional host
#   readback, with a retained three-slot ring and nonblocking completion polls.
#   test/05_perf/bench/vulkan_2d_c/vk2d_bench.spl drives Simple's Engine2D vulkan backend
#   through the identical workload (clear + N draw_rect_filled + submit_batch
#   + present + read_pixels_with_source).
#
#   This script runs both and aggregates an evidence file in one immutable
#   run directory:
#     build/vulkan-2d-c-compare/runs/<run_id>/evidence.env
#   with compare_ratio_x1000 = simple_p95_ns * 1000 / c_p95_ns and
#   compare_status=pass when the ratio meets the selected upper bound (2.0x,
#   override with VK2D_BUDGET_X1000).
#
# MODES
#   (default)          live: build+run what the machine offers, then aggregate.
#                      A leg that cannot run (no clang/vulkan headers, no
#                      MoltenVK ICD, no vulkan seed binary) is recorded as
#                      status=skipped with an explicit reason — never a fake
#                      pass.
#   --aggregate DIR    read the direct immutable DIR/c.env + DIR/simple.env
#                      and emit the aggregate to stdout only. A latest
#                      pointer is deliberately not accepted as DIR.
#
# Exit: 0 when aggregate is pass or skipped, 1 when both legs ran and the
# ratio is below budget.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
BENCH_DIR="$ROOT/test/05_perf/bench/vulkan_2d_c"
OUT_DIR="$ROOT/build/vulkan-2d-c-compare"
ADMISSION_LIB="$ROOT/scripts/check/lib/perf-comparison-admission.shs"
\. "$ADMISSION_LIB"
IMMUTABLE_RUN_LIB="$ROOT/scripts/check/lib/immutable-perf-run.shs"
\. "$IMMUTABLE_RUN_LIB"
BUDGET_X1000=${VK2D_BUDGET_X1000:-2000}
W=${VK2D_W:-800}
H=${VK2D_H:-600}
RECTS=${VK2D_RECTS:-64}
FRAMES=${VK2D_FRAMES:-300}
WARMUPS=5
SIMPLE_BIN=${SIMPLE_BIN:-"$ROOT/bin/simple"}
ICD=${VK_ICD_FILENAMES:-/opt/homebrew/etc/vulkan/icd.d/MoltenVK_icd.json}

fail() { echo "check-vulkan-2d-c-compare: $*" >&2; exit 1; }

for numeric_value in "$BUDGET_X1000" "$W" "$H" "$RECTS" "$FRAMES" "$WARMUPS"; do
    perf_admission_positive_integer "$numeric_value" || fail "invalid positive integer input"
done
[ "$W" -le 16384 ] && [ "$H" -le 16384 ] || fail "viewport exceeds 16384"
[ "$RECTS" -le 1000000 ] && [ "$FRAMES" -le 1000000 ] || fail "workload count exceeds contract bound"
[ "$BUDGET_X1000" -le 1000000 ] || fail "budget exceeds contract bound"

if command -v sha256sum >/dev/null 2>&1; then
    SHA256_TOOL=$(command -v sha256sum)
    SHA256_STYLE=gnu
elif command -v shasum >/dev/null 2>&1; then
    SHA256_TOOL=$(command -v shasum)
    SHA256_STYLE=bsd
else
    fail "SHA-256 tool unavailable"
fi

hash_file() {
    if [ ! -f "$1" ]; then
        return 0
    fi
    if [ "$SHA256_STYLE" = gnu ]; then
        "$SHA256_TOOL" "$1" | sed 's/[[:space:]].*$//'
    else
        "$SHA256_TOOL" -a 256 "$1" | sed 's/[[:space:]].*$//'
    fi
}

hash_stdin() {
    if [ "$SHA256_STYLE" = gnu ]; then
        "$SHA256_TOOL" | sed 's/[[:space:]].*$//'
    else
        "$SHA256_TOOL" -a 256 | sed 's/[[:space:]].*$//'
    fi
}

WRAPPER_PATH="$ROOT/scripts/check/check-vulkan-2d-c-compare.shs"
IMMUTABLE_RUN_HELPER_PATH="$ROOT/scripts/check/lib/immutable-perf-run.shs"
ADMISSION_HELPER_PATH="$ROOT/scripts/check/lib/perf-comparison-admission.shs"

valid_git_object() {
    case "${#1}" in 40|64) ;; *) return 1 ;; esac
    case "$1" in *[!0-9a-f]*) return 1 ;; esac
}

valid_utc_timestamp() {
    printf '%s\n' "$1" | awk '
        function leap(y) { return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 }
        length($0) == 20 &&
        $0 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z$/ {
            y = substr($0, 1, 4) + 0; m = substr($0, 6, 2) + 0; d = substr($0, 9, 2) + 0
            h = substr($0, 12, 2) + 0; minute = substr($0, 15, 2) + 0; s = substr($0, 18, 2) + 0
            days[1]=31; days[2]=28 + leap(y); days[3]=31; days[4]=30; days[5]=31; days[6]=30
            days[7]=31; days[8]=31; days[9]=30; days[10]=31; days[11]=30; days[12]=31
            if (y >= 1 && m >= 1 && m <= 12 && d >= 1 && d <= days[m] && h <= 23 && minute <= 59 && s <= 59) ok=1
        }
        END { exit !ok }
    '
}

valid_run_nonce() {
    printf '%s\n' "$1" | awk '
        /^[0-9]+-[0-9]+-[0-9]+-[A-Za-z0-9]+$/ { ok=1 }
        END { exit !ok }
    '
}

valid_manifest_scalar() {
    manifest_cr=$(printf '\r')
    case "$1" in
        *"$manifest_cr"*) return 1 ;;
    esac
    manifest_without_newlines=$(printf '%s' "$1" | tr -d '\n')
    [ "$manifest_without_newlines" = "$1" ]
}

git_tracked_dirty() {
    if git -C "$ROOT" diff --quiet --ignore-submodules HEAD -- 2>/dev/null &&
       git -C "$ROOT" diff --cached --quiet --ignore-submodules 2>/dev/null; then
        printf 'false\n'
    else
        printf 'true\n'
    fi
}

git_tracked_diff_sha256() {
    provenance_diff_tmp=$(mktemp "${TMPDIR:-/tmp}/vk2d-git-diff.XXXXXX") || return 1
    if ! LC_ALL=C git -C "$ROOT" diff --binary --full-index --no-ext-diff --no-textconv --no-renames --ignore-submodules HEAD -- >"$provenance_diff_tmp"; then
        rm -f "$provenance_diff_tmp"
        return 1
    fi
    provenance_diff_hash=$(hash_file "$provenance_diff_tmp")
    rm -f "$provenance_diff_tmp"
    perf_admission_valid_sha256 "$provenance_diff_hash" || return 1
    printf '%s\n' "$provenance_diff_hash"
}

git_commit=$(git -C "$ROOT" rev-parse --verify HEAD 2>/dev/null || true)
git_tree=$(git -C "$ROOT" rev-parse --verify HEAD^{tree} 2>/dev/null || true)
git_dirty=$(git_tracked_dirty)
git_diff_sha256=$(git_tracked_diff_sha256) || fail "cannot bind tracked Git diff provenance"
valid_git_object "$git_commit" || fail "cannot bind git commit provenance"
valid_git_object "$git_tree" || fail "cannot bind git tree provenance"
case "$git_dirty" in true|false) ;; *) fail "cannot bind git dirty provenance" ;; esac
WRAPPER_SHA256=$(hash_file "$WRAPPER_PATH")
IMMUTABLE_RUN_HELPER_SHA256=$(hash_file "$IMMUTABLE_RUN_HELPER_PATH")
ADMISSION_HELPER_SHA256=$(hash_file "$ADMISSION_HELPER_PATH")
for provenance_hash in "$WRAPPER_SHA256" "$IMMUTABLE_RUN_HELPER_SHA256" "$ADMISSION_HELPER_SHA256"; do
    perf_admission_valid_sha256 "$provenance_hash" || fail "cannot bind helper provenance"
done
for provenance_scalar in "$ROOT" "$BENCH_DIR" "$WRAPPER_PATH" "$IMMUTABLE_RUN_HELPER_PATH" "$ADMISSION_HELPER_PATH" "$SIMPLE_BIN" "$ICD"; do
    valid_manifest_scalar "$provenance_scalar" || fail "manifest path contains a newline"
done

SOURCE_REVISION=$( {
    hash_file "$BENCH_DIR/vk2d_bench.c"
    hash_file "$BENCH_DIR/vk2d_bench.spl"
    hash_file "$BENCH_DIR/rect.comp.glsl"
    hash_file "$BENCH_DIR/scenes.txt"
} | hash_stdin )
WORKLOAD_REVISION=$SOURCE_REVISION
C_SOURCE_REVISION=$(hash_file "$BENCH_DIR/vk2d_bench.c")
SIMPLE_SOURCE_REVISION=$(hash_file "$BENCH_DIR/vk2d_bench.spl")
FIXTURE_REVISION=$(hash_file "$BENCH_DIR/scenes.txt")
CONFIG_REVISION=$(printf '%s\n' \
    "width=$W" "height=$H" "rects=$RECTS" "frames=$FRAMES" \
    "warmups=$WARMUPS" "budget_x1000=$BUDGET_X1000" \
    "readback=post-timing-full-frame" "capture=single-post-timing-capture" \
    | hash_stdin)
ICD_SHA256=$(hash_file "$ICD")

line_value() {
    printf '%s\n' "$1" | awk -v wanted="$2" '{
        for (i = 1; i <= NF; i++) {
            eq = index($i, "=")
            if (eq > 1 && substr($i, 1, eq - 1) == wanted) {
                print substr($i, eq + 1); exit
            }
        }
    }'
}

unsigned_integer() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
}

simple_binary_is_seed() {
    case "$1" in *compiler_rust*|*bootstrap*|*rust-seed*|*/seed/*|*seed-simple*) return 0 ;; esac
    if command -v strings >/dev/null 2>&1 &&
       LC_ALL=C strings "$1" 2>/dev/null | grep -Eqi 'bootstrap seed only|compiler_rust/target|rust-built Simple binary'; then
        return 0
    fi
    return 1
}

# ratio_status C_P95_NS SIMPLE_P95_NS C_STATUS SIMPLE_STATUS C_REASON SIMPLE_REASON
# Emits the four aggregate lines on stdout.
aggregate() {
    c_p95=$1; s_p95=$2; c_st=$3; s_st=$4; c_reason=$5; s_reason=$6
    c_env=$7; simple_env=$8
    echo "compare_budget_x1000=$BUDGET_X1000"
    if [ "$c_st" != admitted ]; then
        echo "compare_status=skipped"
        echo "compare_ratio_x1000=0"
        echo "compare_reason=c-leg-$c_st:$c_reason"
        return 0
    fi
    if [ "$s_st" != admitted ]; then
        echo "compare_status=skipped"
        echo "compare_ratio_x1000=0"
        echo "compare_reason=simple-leg-$s_st:$s_reason"
        return 0
    fi
    perf_compare_admit_env "$c_env" c_ "$simple_env" simple_
    if [ "$PERF_ADMISSION_STATUS" != admitted ]; then
        echo "compare_status=skipped"
        echo "compare_ratio_x1000=0"
        echo "compare_reason=admission-$PERF_ADMISSION_REASON"
        return 0
    fi
    case "$c_p95:$s_p95" in
        *[!0-9:]*|:*|*:)
            echo "compare_status=fail"
            echo "compare_ratio_x1000=0"
            echo "compare_reason=p95-not-unsigned-integer"
            return 1
            ;;
    esac
    if [ "$c_p95" -le 0 ] || [ "$s_p95" -le 0 ]; then
        echo "compare_status=fail"
        echo "compare_ratio_x1000=0"
        echo "compare_reason=p95-nonpositive:c=$c_p95:simple=$s_p95"
        return 1
    fi
    ratio=$((s_p95 * 1000 / c_p95))
    echo "compare_ratio_x1000=$ratio"
    if [ "$ratio" -le "$BUDGET_X1000" ]; then
        echo "compare_status=pass"
        echo "compare_reason=within-budget:$ratio<=$BUDGET_X1000"
        return 0
    fi
    echo "compare_status=fail"
    echo "compare_reason=above-budget:$ratio>$BUDGET_X1000"
    return 1
}

value_of() {
    perf_admission_value_of "$1" "$2"
}

project_row() {
    input=$1; prefix=$2; output=$3
    LC_ALL=C awk -v prefix="$prefix" '
        BEGIN {
            projection = "workload_id viewport_width viewport_height warmup_count sample_count timing_scope readback_mode capture_mode gpu_identity fallback_state source_path source_revision checksum_semantics binary_kind binary_path binary_sha256 binary_admission_path binary_admission_sha256 artifact_path artifact_sha256 checksum"
            consumer = "status reason p95_ns"
            n = split(projection, names, " "); for (i = 1; i <= n; i++) allowed[names[i]] = "projection"
            m = split(consumer, extra, " "); for (i = 1; i <= m; i++) allowed[extra[i]] = "consumer"
        }
        {
            eq = index($0, "="); if (eq <= 1) exit 2
            key = substr($0, 1, eq - 1)
            if (substr(key, 1, length(prefix)) != prefix) exit 2
            suffix = substr(key, length(prefix) + 1)
            if (!(suffix in allowed) || ++seen[suffix] != 1) exit 2
            if (allowed[suffix] == "projection") print $0
        }
        END {
            for (i = 1; i <= n; i++) if (!(names[i] in seen)) exit 2
            for (i = 1; i <= m; i++) if (!(extra[i] in seen)) exit 2
        }
    ' "$input" >"$output"
}

manifest_value_exact() {
    LC_ALL=C awk -v wanted="$2" '
        index($0, "\r") != 0 { exit 2 }
        {
            eq = index($0, "=")
            if (eq <= 1) exit 2
            key = substr($0, 1, eq - 1)
            if (key == wanted) {
                if (++seen != 1) exit 2
                value = substr($0, eq + 1)
            }
        }
        END { if (seen != 1) exit 2; print value }
    ' "$1"
}

manifest_hash_matches_file() {
    provenance_manifest=$1
    provenance_path_key=$2
    provenance_hash_key=$3
    provenance_expected_path=$4
    provenance_path=$(manifest_value_exact "$provenance_manifest" "$provenance_path_key") || return 1
    provenance_hash=$(manifest_value_exact "$provenance_manifest" "$provenance_hash_key") || return 1
    [ "$provenance_path" = "$provenance_expected_path" ] || return 1
    perf_admission_valid_sha256 "$provenance_hash" || return 1
    [ "$PERF_PROVENANCE_STATUS" = cross-revision ] && return 0
    [ ! -L "$provenance_path" ] && [ -f "$provenance_path" ] || return 1
    [ "$(hash_file "$provenance_path")" = "$provenance_hash" ]
}

manifest_digest_matches() {
    provenance_manifest=$1
    provenance_declared_digest=$(manifest_value_exact "$provenance_manifest" manifest_digest_sha256) || return 1
    perf_admission_valid_sha256 "$provenance_declared_digest" || return 1
    provenance_actual_digest=$(awk '!/^manifest_digest_sha256=/' "$provenance_manifest" | hash_stdin) || return 1
    [ "$provenance_actual_digest" = "$provenance_declared_digest" ]
}

validate_manifest_provenance() {
    provenance_manifest=$1
    provenance_dir=$2
    PERF_PROVENANCE_STATUS=current
    PERF_PROVENANCE_REASON=admitted
    manifest_digest_matches "$provenance_manifest" || return 1

    provenance_policy=$(manifest_value_exact "$provenance_manifest" source_policy) || return 1
    [ "$provenance_policy" = current-git-tree-v1 ] ||
        [ "$provenance_policy" = declared-revision-v1 ] || return 1
    provenance_commit=$(manifest_value_exact "$provenance_manifest" git_commit) || return 1
    provenance_tree=$(manifest_value_exact "$provenance_manifest" git_tree) || return 1
    provenance_dirty=$(manifest_value_exact "$provenance_manifest" git_dirty) || return 1
    provenance_diff_hash=$(manifest_value_exact "$provenance_manifest" git_tracked_diff_sha256) || return 1
    provenance_started=$(manifest_value_exact "$provenance_manifest" run_started_utc) || return 1
    provenance_started_epoch=$(manifest_value_exact "$provenance_manifest" run_started_epoch) || return 1
    provenance_nonce=$(manifest_value_exact "$provenance_manifest" run_nonce) || return 1
    valid_git_object "$provenance_commit" || return 1
    valid_git_object "$provenance_tree" || return 1
    case "$provenance_dirty" in true|false) ;; *) return 1 ;; esac
    perf_admission_valid_sha256 "$provenance_diff_hash" || return 1
    valid_utc_timestamp "$provenance_started" || return 1
    perf_admission_positive_integer "$provenance_started_epoch" || return 1
    valid_run_nonce "$provenance_nonce" || return 1
    [ "${provenance_nonce%%-*}" = "$provenance_started_epoch" ] || return 1

    if [ "$provenance_policy" = declared-revision-v1 ]; then
        PERF_PROVENANCE_STATUS=cross-revision
        PERF_PROVENANCE_REASON=declared-revision-analysis-only
    else
        current_commit=$(git -C "$ROOT" rev-parse --verify HEAD 2>/dev/null || true)
        current_tree=$(git -C "$ROOT" rev-parse --verify HEAD^{tree} 2>/dev/null || true)
        current_dirty=$(git_tracked_dirty)
        current_diff_hash=$(git_tracked_diff_sha256) || return 1
        if [ "$provenance_commit" != "$current_commit" ] ||
           [ "$provenance_tree" != "$current_tree" ] ||
           [ "$provenance_dirty" != "$current_dirty" ] ||
           [ "$provenance_diff_hash" != "$current_diff_hash" ]; then
            PERF_PROVENANCE_STATUS=cross-revision
            PERF_PROVENANCE_REASON=source-revision-mismatch
        fi
    fi

    manifest_hash_matches_file "$provenance_manifest" wrapper_path wrapper_sha256 "$WRAPPER_PATH" || return 1
    manifest_hash_matches_file "$provenance_manifest" immutable_run_helper_path immutable_run_helper_sha256 "$IMMUTABLE_RUN_HELPER_PATH" || return 1
    manifest_hash_matches_file "$provenance_manifest" admission_helper_path admission_helper_sha256 "$ADMISSION_HELPER_PATH" || return 1

    provenance_fixture_path=$(manifest_value_exact "$provenance_manifest" fixture_path) || return 1
    provenance_fixture_hash=$(manifest_value_exact "$provenance_manifest" fixture_sha256) || return 1
    [ "$provenance_fixture_path" = "$BENCH_DIR/scenes.txt" ] || return 1
    perf_admission_valid_sha256 "$provenance_fixture_hash" || return 1
    if [ "$PERF_PROVENANCE_STATUS" = current ]; then
        [ ! -L "$provenance_fixture_path" ] && [ -f "$provenance_fixture_path" ] || return 1
        [ "$(hash_file "$provenance_fixture_path")" = "$provenance_fixture_hash" ] || return 1
    fi
    provenance_shader_path="$BENCH_DIR/rect.comp.glsl"
    provenance_shader_hash=$(manifest_value_exact "$provenance_manifest" shader_source_sha256) || return 1
    perf_admission_valid_sha256 "$provenance_shader_hash" || return 1
    provenance_c_source_hash=$(manifest_value_exact "$provenance_manifest" c_source_sha256) || return 1
    provenance_simple_source_hash=$(manifest_value_exact "$provenance_manifest" simple_source_sha256) || return 1
    perf_admission_valid_sha256 "$provenance_c_source_hash" || return 1
    perf_admission_valid_sha256 "$provenance_simple_source_hash" || return 1
    if [ "$PERF_PROVENANCE_STATUS" = current ]; then
        [ "$(hash_file "$provenance_shader_path")" = "$provenance_shader_hash" ] || return 1
        [ "$(hash_file "$BENCH_DIR/vk2d_bench.c")" = "$provenance_c_source_hash" ] || return 1
        [ "$(hash_file "$BENCH_DIR/vk2d_bench.spl")" = "$provenance_simple_source_hash" ] || return 1
    fi

    provenance_width=$(manifest_value_exact "$provenance_manifest" viewport_width) || return 1
    provenance_height=$(manifest_value_exact "$provenance_manifest" viewport_height) || return 1
    provenance_rects=$(manifest_value_exact "$provenance_manifest" rect_count) || return 1
    provenance_frames=$(manifest_value_exact "$provenance_manifest" sample_count) || return 1
    provenance_warmups=$(manifest_value_exact "$provenance_manifest" warmup_count) || return 1
    provenance_budget=$(manifest_value_exact "$provenance_manifest" budget_x1000) || return 1
    for provenance_number in "$provenance_width" "$provenance_height" "$provenance_rects" "$provenance_frames" "$provenance_warmups" "$provenance_budget"; do
        perf_admission_positive_integer "$provenance_number" || return 1
    done
    [ "$provenance_width" -le 16384 ] && [ "$provenance_height" -le 16384 ] || return 1
    [ "$provenance_rects" -le 1000000 ] && [ "$provenance_frames" -le 1000000 ] || return 1
    [ "$provenance_budget" -le 1000000 ] || return 1
    provenance_config_hash=$(manifest_value_exact "$provenance_manifest" config_sha256) || return 1
    perf_admission_valid_sha256 "$provenance_config_hash" || return 1
    provenance_expected_config=$(printf '%s\n' \
        "width=$provenance_width" "height=$provenance_height" "rects=$provenance_rects" \
        "frames=$provenance_frames" "warmups=$provenance_warmups" \
        "budget_x1000=$provenance_budget" "readback=post-timing-full-frame" \
        "capture=single-post-timing-capture" | hash_stdin)
    [ "$provenance_expected_config" = "$provenance_config_hash" ] || return 1

    provenance_c_argv_0=$(manifest_value_exact "$provenance_manifest" c_command_argv_0) || return 1
    provenance_c_argc=$(manifest_value_exact "$provenance_manifest" c_command_argc) || return 1
    provenance_c_argv_1=$(manifest_value_exact "$provenance_manifest" c_command_argv_1) || return 1
    provenance_c_argv_2=$(manifest_value_exact "$provenance_manifest" c_command_argv_2) || return 1
    provenance_c_argv_3=$(manifest_value_exact "$provenance_manifest" c_command_argv_3) || return 1
    provenance_c_argv_4=$(manifest_value_exact "$provenance_manifest" c_command_argv_4) || return 1
    provenance_c_argv_5=$(manifest_value_exact "$provenance_manifest" c_command_argv_5) || return 1
    provenance_c_argv_6=$(manifest_value_exact "$provenance_manifest" c_command_argv_6) || return 1
    [ "$provenance_c_argc" = 7 ] || return 1
    [ "$provenance_c_argv_0" = ./vk2d_bench ] || return 1
    [ "$provenance_c_argv_1" = "$provenance_width" ] || return 1
    [ "$provenance_c_argv_2" = "$provenance_height" ] || return 1
    [ "$provenance_c_argv_3" = "$provenance_rects" ] || return 1
    [ "$provenance_c_argv_4" = "$provenance_frames" ] || return 1
    [ "$provenance_c_argv_5" = 1 ] || return 1
    [ "$provenance_c_argv_6" = "$provenance_warmups" ] || return 1
    provenance_c_argv_hash=$(manifest_value_exact "$provenance_manifest" c_command_argv_sha256) || return 1
    perf_admission_valid_sha256 "$provenance_c_argv_hash" || return 1
    [ "$(printf '%s\n' "$provenance_c_argv_0" "$provenance_c_argv_1" "$provenance_c_argv_2" "$provenance_c_argv_3" "$provenance_c_argv_4" "$provenance_c_argv_5" "$provenance_c_argv_6" | hash_stdin)" = "$provenance_c_argv_hash" ] || return 1

    provenance_simple_path=$(manifest_value_exact "$provenance_manifest" simple_binary_path) || return 1
    provenance_simple_argc=$(manifest_value_exact "$provenance_manifest" simple_command_argc) || return 1
    provenance_simple_argv_0=$(manifest_value_exact "$provenance_manifest" simple_command_argv_0) || return 1
    provenance_simple_argv_1=$(manifest_value_exact "$provenance_manifest" simple_command_argv_1) || return 1
    provenance_simple_argv_2=$(manifest_value_exact "$provenance_manifest" simple_command_argv_2) || return 1
    [ "$provenance_simple_argc" = 3 ] || return 1
    valid_manifest_scalar "$provenance_simple_path" || return 1
    valid_manifest_scalar "$provenance_simple_argv_0" || return 1
    [ "$provenance_simple_argv_0" = "$provenance_simple_path" ] || return 1
    [ "$provenance_simple_argv_1" = run ] || return 1
    [ "$provenance_simple_argv_2" = test/05_perf/bench/vulkan_2d_c/vk2d_bench.spl ] || return 1
    provenance_simple_argv_hash=$(manifest_value_exact "$provenance_manifest" simple_command_argv_sha256) || return 1
    perf_admission_valid_sha256 "$provenance_simple_argv_hash" || return 1
    [ "$(printf '%s\n' "$provenance_simple_argv_0" "$provenance_simple_argv_1" "$provenance_simple_argv_2" | hash_stdin)" = "$provenance_simple_argv_hash" ] || return 1

    return 0
}

validate_manifest_file_binding() {
    immutable_manifest=$1
    immutable_dir=$2
    immutable_path_key=$3
    immutable_hash_key=$4
    immutable_name=$5
    immutable_path=$(manifest_value_exact "$immutable_manifest" "$immutable_path_key") || return 1
    immutable_hash=$(manifest_value_exact "$immutable_manifest" "$immutable_hash_key") || return 1
    [ "$immutable_path" = "$immutable_dir/$immutable_name" ] || return 1
    [ ! -L "$immutable_path" ] && [ -f "$immutable_path" ] || return 1
    if stat -f '%l' "$immutable_path" >/dev/null 2>&1; then
        [ "$(stat -f '%l' "$immutable_path")" -eq 1 ] || return 1
    elif stat -c '%h' "$immutable_path" >/dev/null 2>&1; then
        [ "$(stat -c '%h' "$immutable_path")" -eq 1 ] || return 1
    else
        return 1
    fi
    perf_admission_valid_sha256 "$immutable_hash" || return 1
    [ "$(hash_file "$immutable_path")" = "$immutable_hash" ]
}

if [ "${1:-}" = "--aggregate" ]; then
    [ $# -eq 2 ] || fail "--aggregate needs a row directory"
    dir=$2
    case "$dir" in ''|-*) fail "unsafe row directory path" ;; esac
    dir_parent=${dir%/*}
    [ "$dir_parent" != "$dir" ] || dir_parent=.
    dir_root=${dir_parent%/*}
    [ "$dir_root" != "$dir_parent" ] || dir_root=.
    [ "${dir_parent##*/}" = runs ] || fail "invalid row directory"
    [ ! -L "$dir_root" ] && [ ! -L "$dir_parent" ] && [ ! -L "$dir" ] && [ -d "$dir" ] || fail "invalid row directory"
    dir=$(CDPATH= cd -- "$dir" && pwd -P) || fail "invalid row directory"
    run_id=${dir##*/}
    perf_immutable_valid_run_id "$run_id" || fail "invalid row directory"
    manifest_source="$dir/run.manifest.env"
    [ ! -L "$manifest_source" ] && [ -f "$manifest_source" ] || fail "invalid immutable run manifest"
    projection_dir=$(mktemp -d "${TMPDIR:-/tmp}/vk2d-admission.XXXXXX") || fail "cannot create projection directory"
    trap 'rm -rf "$projection_dir"' EXIT HUP INT TERM
    cp "$manifest_source" "$projection_dir/run.manifest.env" || fail "cannot snapshot immutable run manifest"
    manifest="$projection_dir/run.manifest.env"
    [ "$(manifest_value_exact "$manifest" schema)" = immutable-vulkan-2d-c-run-v1 ] || fail "invalid immutable run schema"
    [ "$(manifest_value_exact "$manifest" run_id)" = "$run_id" ] || fail "invalid immutable run id"
    [ "$(manifest_value_exact "$manifest" run_dir)" = "$dir" ] || fail "stale immutable run path"
    validate_manifest_provenance "$manifest" "$dir" || fail "invalid immutable run provenance"
    BUDGET_X1000=$provenance_budget
    for immutable_binding in \
        'c_row:c_row_sha256:c.env' \
        'combined_raw_row:combined_raw_row_sha256:c.env.raw' \
        'simple_row:simple_row_sha256:simple.env' \
        'aggregate_evidence:aggregate_evidence_sha256:evidence.env' \
        'c_raw_stdout:c_raw_stdout_sha256:c.stdout.raw' \
        'c_raw_stderr:c_raw_stderr_sha256:c.stderr.raw' \
        'c_runtime_receipt:c_runtime_receipt_sha256:c.runtime.env' \
        'c_toolchain_receipt:c_toolchain_receipt_sha256:c.toolchain.env' \
        'simple_raw_stdout:simple_raw_stdout_sha256:simple.stdout.raw' \
        'simple_raw_stderr:simple_raw_stderr_sha256:simple.stderr.raw' \
        'simple_runtime_receipt:simple_runtime_receipt_sha256:simple.runtime.env'; do
        immutable_path_key=${immutable_binding%%:*}
        immutable_remainder=${immutable_binding#*:}
        immutable_hash_key=${immutable_remainder%%:*}
        immutable_name=${immutable_remainder#*:}
        validate_manifest_file_binding "$manifest" "$dir" "$immutable_path_key" "$immutable_hash_key" "$immutable_name" ||
            fail "stale immutable run receipt:$immutable_name"
    done
    [ ! -L "$dir/c.env" ] && [ -f "$dir/c.env" ] || fail "invalid $dir/c.env"
    [ ! -L "$dir/simple.env" ] && [ -f "$dir/simple.env" ] || fail "invalid $dir/simple.env"
    cp "$dir/c.env" "$projection_dir/c.env.snapshot" || fail "cannot snapshot immutable C row"
    cp "$dir/simple.env" "$projection_dir/simple.env.snapshot" || fail "cannot snapshot immutable Simple row"
    [ "$(hash_file "$projection_dir/c.env.snapshot")" = "$(manifest_value_exact "$manifest" c_row_sha256)" ] ||
        fail "racing immutable C row"
    [ "$(hash_file "$projection_dir/simple.env.snapshot")" = "$(manifest_value_exact "$manifest" simple_row_sha256)" ] ||
        fail "racing immutable Simple row"
    project_row "$projection_dir/c.env.snapshot" c_ "$projection_dir/c.env" || fail "malformed or inexact C row"
    project_row "$projection_dir/simple.env.snapshot" simple_ "$projection_dir/simple.env" || fail "malformed or inexact Simple row"
    if [ "$PERF_PROVENANCE_STATUS" = cross-revision ]; then
        echo "compare_budget_x1000=$BUDGET_X1000"
        echo "compare_status=skipped"
        echo "compare_ratio_x1000=0"
        echo "compare_reason=provenance-cross-revision:$PERF_PROVENANCE_REASON"
        exit 0
    fi
    aggregate \
        "$(value_of "$dir/c.env" c_p95_ns)" \
        "$(value_of "$dir/simple.env" simple_p95_ns)" \
        "$(value_of "$dir/c.env" c_status)" \
        "$(value_of "$dir/simple.env" simple_status)" \
        "$(value_of "$dir/c.env" c_reason)" \
        "$(value_of "$dir/simple.env" simple_reason)" \
        "$projection_dir/c.env" "$projection_dir/simple.env"
    exit $?
fi

# ── live mode ──────────────────────────────────────────────────────────────
# Every live invocation gets one immutable run directory.  The explicit
# VK2D_RUN_ID form is preferred for externally coordinated evidence; the
# generated form remains unique for ordinary local runs.  A repeated ID is a
# hard collision and never reuses or overwrites an earlier receipt.
OUT_ROOT=${VK2D_OUT_DIR:-$OUT_DIR}
RUN_ID=${VK2D_RUN_ID:-}
if perf_immutable_prepare_run "$OUT_ROOT" "$RUN_ID"; then
    :
else
    prepare_rc=$?
    if [ "$prepare_rc" -eq 2 ]; then
        fail "run-id-collision:${RUN_ID:-generated}"
    fi
    fail "cannot prepare immutable run directory"
fi
RUN_ID=$PERF_IMMUTABLE_RUN_ID
OUT_ROOT=$PERF_IMMUTABLE_ROOT
RUN_DIR=$PERF_IMMUTABLE_STAGE_DIR
FINAL_RUN_DIR=$PERF_IMMUTABLE_FINAL_DIR
OUT_DIR=$RUN_DIR
trap 'perf_immutable_remove_stage "$RUN_DIR"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

c_status=skipped; c_reason=not-attempted; c_p95=0; c_bin="$OUT_DIR/vk2d_bench"
c_device=; c_checksum=; c_bin_sha=; c_timing_scope=draw-plus-submit-to-fence-p95
c_artifact="$OUT_DIR/c-framebuffer.rgba"; c_artifact_sha=
c_stdout_raw="$OUT_DIR/c.stdout.raw"; c_stderr_raw="$OUT_DIR/c.stderr.raw"
c_metrics="$OUT_DIR/c.runtime.env"; c_toolchain="$OUT_DIR/c.toolchain.env"
c_bin_public="$FINAL_RUN_DIR/vk2d_bench"
c_artifact_public="$FINAL_RUN_DIR/c-framebuffer.rgba"
c_stdout_raw_public="$FINAL_RUN_DIR/c.stdout.raw"
c_stderr_raw_public="$FINAL_RUN_DIR/c.stderr.raw"
c_metrics_public="$FINAL_RUN_DIR/c.runtime.env"
c_toolchain_public="$FINAL_RUN_DIR/c.toolchain.env"
c_max_rss_bytes=unavailable
C_COMMAND_ARGV_0=./vk2d_bench
C_COMMAND_ARGV_1=$W
C_COMMAND_ARGV_2=$H
C_COMMAND_ARGV_3=$RECTS
C_COMMAND_ARGV_4=$FRAMES
C_COMMAND_ARGV_5=1
C_COMMAND_ARGV_6=$WARMUPS
C_COMMAND_ARGV_SHA256=$(printf '%s\n' "$C_COMMAND_ARGV_0" "$C_COMMAND_ARGV_1" "$C_COMMAND_ARGV_2" "$C_COMMAND_ARGV_3" "$C_COMMAND_ARGV_4" "$C_COMMAND_ARGV_5" "$C_COMMAND_ARGV_6" | hash_stdin)
: >"$c_stdout_raw"
: >"$c_stderr_raw"
if ! command -v clang >/dev/null 2>&1; then
    c_reason=no-clang
elif ! command -v glslangValidator >/dev/null 2>&1; then
    c_reason=no-glslangValidator
elif [ ! -f /opt/homebrew/include/vulkan/vulkan.h ]; then
    c_reason=no-vulkan-headers
elif [ ! -f "$ICD" ]; then
    c_reason=no-vulkan-icd
else
    c_compiler=$(command -v clang)
    shader_compiler=$(command -v glslangValidator)
    c_compiler_sha=$(hash_file "$c_compiler")
    shader_compiler_sha=$(hash_file "$shader_compiler")
    perf_admission_valid_sha256 "$c_compiler_sha" || fail "cannot bind C compiler identity"
    perf_admission_valid_sha256 "$shader_compiler_sha" || fail "cannot bind shader compiler identity"
    {
        echo "schema=vulkan-2d-c-toolchain-v1"
        echo "run_id=$RUN_ID"
        echo "status=available"
        echo "c_compiler_path=$c_compiler"
        echo "c_compiler_sha256=$c_compiler_sha"
        echo "c_compiler_version=$("$c_compiler" --version | sed -n '1p')"
        echo "c_compiler_flags=-std=c99 -O2 -I/opt/homebrew/include -L/opt/homebrew/lib -lvulkan"
        echo "shader_compiler_path=$shader_compiler"
        echo "shader_compiler_sha256=$shader_compiler_sha"
        echo "shader_compiler_version=$("$shader_compiler" --version | sed -n '1p')"
        echo "shader_compiler_flags=-V"
    } >"$c_toolchain"
    (cd "$OUT_DIR" && "$shader_compiler" -V "$BENCH_DIR/rect.comp.glsl" -o rect.spv) &&
    "$c_compiler" -std=c99 -O2 "$BENCH_DIR/vk2d_bench.c" \
        -I/opt/homebrew/include -L/opt/homebrew/lib -lvulkan -o "$c_bin" ||
        fail "C reference build failed (toolchain present but compile broke)"
    rm -f "$c_artifact" "$c_stdout_raw" "$c_stderr_raw"
    if [ "$(uname -s)" = Darwin ] && [ -x /usr/bin/time ]; then
        (cd "$OUT_DIR" && /usr/bin/time -l env \
            VK_ICD_FILENAMES="$ICD" VK2D_SCENES="$BENCH_DIR/scenes.txt" \
            VK2D_DUMP_FB="$c_artifact" \
            ./vk2d_bench "$W" "$H" "$RECTS" "$FRAMES" 1 "$WARMUPS" \
            >"$c_stdout_raw" 2>"$c_stderr_raw") || fail "C reference run failed"
        c_max_rss_bytes=$(LC_ALL=C awk '/maximum resident set size/ { print $1; exit }' "$c_stderr_raw")
        case "$c_max_rss_bytes" in
            ''|*[!0-9]*|0) c_max_rss_bytes=unavailable ;;
        esac
    else
        (cd "$OUT_DIR" && env \
            VK_ICD_FILENAMES="$ICD" VK2D_SCENES="$BENCH_DIR/scenes.txt" \
            VK2D_DUMP_FB="$c_artifact" \
            ./vk2d_bench "$W" "$H" "$RECTS" "$FRAMES" 1 "$WARMUPS" \
            >"$c_stdout_raw" 2>"$c_stderr_raw") || fail "C reference run failed"
    fi
    c_out=$(tail -1 "$c_stdout_raw")
    c_device=$(sed -n 's/^device: //p' "$c_stdout_raw" | tail -1)
    case $c_out in
        c-vulkan-2d*p95_ns=*)
            c_p50_candidate=$(line_value "$c_out" p50_ns)
            c_p95_candidate=$(line_value "$c_out" p95_ns)
            c_checksum_candidate=$(line_value "$c_out" checksum)
            c_polls=$(line_value "$c_out" completion_polls)
            c_retained=$(line_value "$c_out" retained_buffer_bytes)
            c_released=$(line_value "$c_out" teardown_released_bytes)
            c_capture_bytes=$(line_value "$c_out" capture_readback_bytes)
            c_upload_bytes=$(line_value "$c_out" upload_bytes)
            c_vendor=$(line_value "$c_out" device_vendor)
            c_device_id=$(line_value "$c_out" device_id)
            c_device_lc=$(printf '%s\n' "$c_device" | tr '[:upper:]' '[:lower:]')
            expected_capture_bytes=$((W * H * 4))
            expected_upload_bytes=$((FRAMES * RECTS * 28))
            expected_damage_pixels=$((W * H * FRAMES))
            if [ -z "$c_device" ] || [ -z "$ICD_SHA256" ] ||
               ! perf_admission_positive_integer "$c_p50_candidate" ||
               ! perf_admission_positive_integer "$c_p95_candidate" ||
               [ "$c_p50_candidate" -gt "$c_p95_candidate" ] ||
               ! unsigned_integer "$c_checksum_candidate" ||
               ! perf_admission_positive_integer "$c_polls" ||
               [ "$c_polls" -lt "$FRAMES" ] ||
               ! perf_admission_positive_integer "$c_retained" ||
               [ "$c_retained" != "$c_released" ] ||
               [ "$c_capture_bytes" != "$expected_capture_bytes" ] ||
               [ "$c_upload_bytes" != "$expected_upload_bytes" ] ||
               ! perf_admission_positive_integer "$c_max_rss_bytes" ||
               [ -z "$c_vendor" ] || [ -z "$c_device_id" ] ||
               [ "$(line_value "$c_out" w)" != "$W" ] ||
               [ "$(line_value "$c_out" h)" != "$H" ] ||
               [ "$(line_value "$c_out" rects)" != "$RECTS" ] ||
               [ "$(line_value "$c_out" warmups)" != "$WARMUPS" ] ||
               [ "$(line_value "$c_out" samples)" != "$FRAMES" ] ||
               [ "$(line_value "$c_out" scene_source)" != table ] ||
               [ "$(line_value "$c_out" ring)" != 3 ] ||
               [ "$(line_value "$c_out" max_frames_in_flight)" != 3 ] ||
               [ "$(line_value "$c_out" unconditional_submit_wait)" != false ] ||
               [ "$(line_value "$c_out" timed_buffer_allocation_count)" != 0 ] ||
               [ "$(line_value "$c_out" timed_full_frame_upload_count)" != 0 ] ||
               [ "$(line_value "$c_out" timed_readback_bytes)" != 0 ] ||
               [ "$(line_value "$c_out" capture_count)" != 1 ] ||
               [ "$(line_value "$c_out" fence_completions)" != "$FRAMES" ] ||
               [ "$(line_value "$c_out" cpu_completion_wait_count)" != 0 ] ||
               [ "$(line_value "$c_out" event_generations)" != "$FRAMES" ] ||
               [ "$(line_value "$c_out" damage_area_pixels)" != "$expected_damage_pixels" ]; then
                c_status=fail; c_reason=invalid-live-contract
            elif case "$c_vendor:$c_device_id" in *[!0-9A-Fa-f:]*) true ;; *) false ;; esac; then
                c_status=fail; c_reason=invalid-device-identity
            elif case "$c_device_lc" in *software*|*swiftshader*|*lavapipe*|*llvmpipe*|*fallback*|*cpu*) true ;; *) false ;; esac; then
                c_status=fail; c_reason=software-fallback-device
            elif [ ! -s "$c_artifact" ]; then
                c_status=fail; c_reason=missing-post-timing-capture
            elif [ "$(wc -c <"$c_artifact" | tr -d '[:space:]')" != "$expected_capture_bytes" ]; then
                c_status=fail; c_reason=invalid-post-timing-capture-size
            else
                c_status=measured-unadmitted; c_reason=receipt-needs-common-admission
                c_p95=$c_p95_candidate
                c_checksum=$c_checksum_candidate
                c_bin_sha=$(hash_file "$c_bin")
                c_artifact_sha=$(hash_file "$c_artifact")
                echo "c_line=$c_out"
            fi
            ;;
        *) c_status=fail; c_reason="no-fps-line:$(echo "$c_out" | head -c 80)" ;;
    esac
fi
if [ ! -f "$c_toolchain" ]; then
    {
        echo "schema=vulkan-2d-c-toolchain-v1"
        echo "run_id=$RUN_ID"
        echo "status=skipped"
        echo "reason=$c_reason"
    } >"$c_toolchain"
fi

simple_status=skipped; simple_reason=not-attempted; s_p95=0
simple_device=; simple_checksum=; simple_bin_sha=; simple_timing_scope=draw-plus-submit-to-fence-p95
simple_artifact="$OUT_DIR/simple-framebuffer.rgba"; simple_artifact_sha=
simple_artifact_public="$FINAL_RUN_DIR/simple-framebuffer.rgba"
simple_stdout_raw="$OUT_DIR/simple.stdout.raw"; simple_stderr_raw="$OUT_DIR/simple.stderr.raw"
simple_metrics="$OUT_DIR/simple.runtime.env"
simple_stdout_raw_public="$FINAL_RUN_DIR/simple.stdout.raw"
simple_stderr_raw_public="$FINAL_RUN_DIR/simple.stderr.raw"
simple_metrics_public="$FINAL_RUN_DIR/simple.runtime.env"
simple_exit=0
: >"$simple_stdout_raw"
: >"$simple_stderr_raw"
SIMPLE_COMMAND_ARGV_0=$SIMPLE_BIN
SIMPLE_COMMAND_ARGV_1=run
SIMPLE_COMMAND_ARGV_2=test/05_perf/bench/vulkan_2d_c/vk2d_bench.spl
SIMPLE_COMMAND_ARGV_SHA256=$(printf '%s\n' "$SIMPLE_COMMAND_ARGV_0" "$SIMPLE_COMMAND_ARGV_1" "$SIMPLE_COMMAND_ARGV_2" | hash_stdin)
if [ "$c_status" = skipped ]; then
    simple_reason=c-leg-skipped
elif [ ! -x "$SIMPLE_BIN" ]; then
    simple_reason=no-selfhosted-simple-binary
elif [ -L "$SIMPLE_BIN" ] || simple_binary_is_seed "$SIMPLE_BIN"; then
    simple_reason=bootstrap-seed-forbidden
else
    rm -f "$simple_artifact" "$simple_stdout_raw" "$simple_stderr_raw"
    set +e
    (cd "$ROOT" && SIMPLE_RUST_SEED_WARNING=0 SIMPLE_LIB=src \
        VK_ICD_FILENAMES="$ICD" VK2D_W="$W" VK2D_H="$H" VK2D_RECTS="$RECTS" VK2D_FRAMES="$FRAMES" \
        VK2D_WARMUPS="$WARMUPS" VK2D_READBACK=1 VK2D_DUMP_FB="$simple_artifact" \
        "$SIMPLE_BIN" run test/05_perf/bench/vulkan_2d_c/vk2d_bench.spl \
        >"$simple_stdout_raw" 2>"$simple_stderr_raw")
    simple_exit=$?
    set -e
    s_out=$(grep '^simple-vulkan-2d' "$simple_stdout_raw" | tail -1 || true)
    case $s_out in
        simple-vulkan-2d*p95_ns=*)
            simple_reported_status=$(line_value "$s_out" status)
            if [ "$simple_reported_status" = blocked ]; then
                simple_status=blocked
                simple_reason=$(line_value "$s_out" reason)
            elif [ "$simple_reported_status" != admitted ]; then
                simple_status=fail; simple_reason=invalid-live-status
            elif [ "$(line_value "$s_out" w)" != "$W" ] ||
                 [ "$(line_value "$s_out" h)" != "$H" ] ||
                 [ "$(line_value "$s_out" rects)" != "$RECTS" ] ||
                 [ "$(line_value "$s_out" warmups)" != "$WARMUPS" ] ||
                 [ "$(line_value "$s_out" samples)" != "$FRAMES" ] ||
                 [ "$(line_value "$s_out" unconditional_submit_wait)" != false ] ||
                 [ "$(line_value "$s_out" timed_readback_bytes)" != 0 ] ||
                 [ "$(line_value "$s_out" capture_count)" != 1 ] ||
                 [ "$(line_value "$s_out" cpu_completion_wait_count)" != 0 ] ||
                 [ ! -s "$simple_artifact" ]; then
                simple_status=fail; simple_reason=invalid-live-contract
            else
                simple_status=measured-unadmitted; simple_reason=receipt-needs-common-admission
                s_p95=$(line_value "$s_out" p95_ns)
                simple_device=$(printf '%s\n' "$s_out" | sed -n 's/.* device=\(.*\) driver=.*/\1/p')
                simple_checksum=$(line_value "$s_out" checksum)
                simple_bin_sha=$(hash_file "$SIMPLE_BIN")
                simple_artifact_sha=$(hash_file "$simple_artifact")
                if [ -z "$simple_device" ]; then
                    simple_status=fail; simple_reason=missing-gpu-device-identity
                elif [ "$c_device" != "$simple_device" ]; then
                    simple_status=blocked; simple_reason=gpu-device-mismatch
                fi
                echo "simple_line=$s_out"
            fi
            ;;
        *) simple_status=fail; simple_reason="no-fps-line:$(echo "$s_out" | head -c 80)" ;;
    esac
fi

{
    echo "run_id=$RUN_ID"
    echo "run_dir=$FINAL_RUN_DIR"
    echo "run_publish_schema=immutable-perf-run-v1"
    echo "c_status=$c_status"
    echo "c_reason=$c_reason"
    echo "c_p95_ns=$c_p95"
    echo "simple_status=$simple_status"
    echo "simple_reason=$simple_reason"
    echo "simple_p95_ns=$s_p95"
    echo "c_workload_id=vulkan-2d-c-rects-v1-${W}x${H}-rects${RECTS}-scene${WORKLOAD_REVISION}"
    echo "simple_workload_id=vulkan-2d-c-rects-v1-${W}x${H}-rects${RECTS}-scene${WORKLOAD_REVISION}"
    echo "c_viewport_width=$W"
    echo "c_viewport_height=$H"
    echo "simple_viewport_width=$W"
    echo "simple_viewport_height=$H"
    echo "c_warmup_count=$WARMUPS"
    echo "simple_warmup_count=$WARMUPS"
    echo "c_sample_count=$FRAMES"
    echo "simple_sample_count=$FRAMES"
    echo "c_timing_scope=$c_timing_scope"
    echo "simple_timing_scope=$simple_timing_scope"
    echo "c_readback_mode=post-timing-full-frame"
    echo "simple_readback_mode=post-timing-full-frame"
    echo "c_capture_mode=single-post-timing-capture"
    echo "simple_capture_mode=single-post-timing-capture"
    echo "c_gpu_identity=device:${c_device};icd_sha256=$ICD_SHA256"
    echo "simple_gpu_identity=device:${simple_device};icd_sha256=$ICD_SHA256"
    echo "c_fallback_state=none"
    if [ "$simple_status" = measured-unadmitted ]; then
        echo "simple_fallback_state=none"
    else
        echo "simple_fallback_state=${simple_status:-skipped}"
    fi
    echo "c_source_path=$BENCH_DIR/vk2d_bench.c"
    echo "simple_source_path=$BENCH_DIR/vk2d_bench.spl"
    echo "c_source_revision=$C_SOURCE_REVISION"
    echo "simple_source_revision=$SIMPLE_SOURCE_REVISION"
    echo "c_binary_kind=native-reference"
    echo "simple_binary_kind=admitted-selfhosted"
    echo "c_binary_path=$c_bin_public"
    echo "simple_binary_path=$SIMPLE_BIN"
    echo "c_binary_sha256=$c_bin_sha"
    echo "simple_binary_sha256=$simple_bin_sha"
    echo "c_binary_admission_path="
    echo "simple_binary_admission_path="
    echo "c_binary_admission_sha256="
    echo "simple_binary_admission_sha256="
    echo "c_artifact_path=$c_artifact_public"
    echo "simple_artifact_path=$simple_artifact_public"
    echo "c_artifact_sha256=$c_artifact_sha"
    echo "simple_artifact_sha256=$simple_artifact_sha"
    echo "c_checksum_semantics=sampled-u32-xor-stride-4096"
    echo "simple_checksum_semantics=sampled-u32-xor-stride-4096"
    echo "c_checksum=$c_checksum"
    echo "simple_checksum=$simple_checksum"
} | tee "$OUT_DIR/c.env.raw" >/dev/null
{
    echo "schema=vulkan-2d-c-runtime-metrics-v1"
    echo "run_id=$RUN_ID"
    echo "c_max_rss_bytes=$c_max_rss_bytes"
    echo "c_stdout_path=$c_stdout_raw_public"
    echo "c_stdout_sha256=$(hash_file "$c_stdout_raw")"
    echo "c_stderr_path=$c_stderr_raw_public"
    echo "c_stderr_sha256=$(hash_file "$c_stderr_raw")"
    echo "c_toolchain_path=$c_toolchain_public"
} >"$c_metrics"
{
    echo "schema=vulkan-2d-simple-runtime-metrics-v1"
    echo "run_id=$RUN_ID"
    echo "simple_exit_code=$simple_exit"
    echo "simple_stdout_path=$simple_stdout_raw_public"
    echo "simple_stdout_sha256=$(hash_file "$simple_stdout_raw")"
    echo "simple_stderr_path=$simple_stderr_raw_public"
    echo "simple_stderr_sha256=$(hash_file "$simple_stderr_raw")"
    echo "simple_artifact_path=$simple_artifact_public"
    echo "simple_artifact_sha256=$simple_artifact_sha"
} >"$simple_metrics"
# Split rows for the --aggregate contract path.
sed -n 's/^c_/c_/p' "$OUT_DIR/c.env.raw" > "$OUT_DIR/c.env"
sed -n 's/^simple_/simple_/p' "$OUT_DIR/c.env.raw" > "$OUT_DIR/simple.env"

live_commit=$(git -C "$ROOT" rev-parse --verify HEAD 2>/dev/null || true)
live_tree=$(git -C "$ROOT" rev-parse --verify HEAD^{tree} 2>/dev/null || true)
live_dirty=$(git_tracked_dirty)
live_diff_sha256=$(git_tracked_diff_sha256) || fail "cannot revalidate tracked Git diff provenance"
if [ "$live_commit" != "$git_commit" ] || [ "$live_tree" != "$git_tree" ] ||
   [ "$live_dirty" != "$git_dirty" ] || [ "$live_diff_sha256" != "$git_diff_sha256" ]; then
    {
        echo "compare_budget_x1000=$BUDGET_X1000"
        echo "compare_status=skipped"
        echo "compare_ratio_x1000=0"
        echo "compare_reason=provenance-cross-revision:source-changed-during-run"
    } >"$OUT_DIR/evidence.env"
    aggregate_rc=0
else
    set +e
    aggregate "$c_p95" "$s_p95" "$c_status" "$simple_status" "$c_reason" "$simple_reason" \
        "$OUT_DIR/c.env" "$OUT_DIR/simple.env" \
        >"$OUT_DIR/evidence.env"
    aggregate_rc=$?
    set -e
fi
{
    cat "$OUT_DIR/evidence.env"
    echo "run_id=$RUN_ID"
    echo "run_dir=$FINAL_RUN_DIR"
    echo "run_authority=immutable-published-directory"
    echo "latest_pointer=$OUT_ROOT/latest"
} >"$OUT_DIR/evidence.env.complete"
mv "$OUT_DIR/evidence.env.complete" "$OUT_DIR/evidence.env"
{
    echo "schema=immutable-vulkan-2d-c-run-v1"
    echo "run_id=$RUN_ID"
    echo "run_dir=$FINAL_RUN_DIR"
    echo "source_policy=current-git-tree-v1"
    echo "git_commit=$git_commit"
    echo "git_tree=$git_tree"
    echo "git_dirty=$git_dirty"
    echo "git_tracked_diff_sha256=$git_diff_sha256"
    echo "run_started_utc=$PERF_IMMUTABLE_STARTED_UTC"
    echo "run_started_epoch=$PERF_IMMUTABLE_STARTED_EPOCH"
    echo "run_nonce=$PERF_IMMUTABLE_RUN_NONCE"
    echo "wrapper_path=$WRAPPER_PATH"
    echo "wrapper_sha256=$WRAPPER_SHA256"
    echo "immutable_run_helper_path=$IMMUTABLE_RUN_HELPER_PATH"
    echo "immutable_run_helper_sha256=$IMMUTABLE_RUN_HELPER_SHA256"
    echo "admission_helper_path=$ADMISSION_HELPER_PATH"
    echo "admission_helper_sha256=$ADMISSION_HELPER_SHA256"
    echo "config_sha256=$CONFIG_REVISION"
    echo "viewport_width=$W"
    echo "viewport_height=$H"
    echo "rect_count=$RECTS"
    echo "sample_count=$FRAMES"
    echo "warmup_count=$WARMUPS"
    echo "budget_x1000=$BUDGET_X1000"
    echo "fixture_path=$BENCH_DIR/scenes.txt"
    echo "fixture_sha256=$FIXTURE_REVISION"
    echo "c_source_sha256=$C_SOURCE_REVISION"
    echo "simple_source_sha256=$SIMPLE_SOURCE_REVISION"
    echo "shader_source_sha256=$(hash_file "$BENCH_DIR/rect.comp.glsl")"
    echo "shader_binary=$FINAL_RUN_DIR/rect.spv"
    echo "shader_binary_sha256=$(hash_file "$OUT_DIR/rect.spv")"
    echo "icd_path=$ICD"
    echo "icd_sha256=$ICD_SHA256"
    echo "c_binary_path=$c_bin_public"
    echo "simple_binary_path=$SIMPLE_BIN"
    echo "c_binary_sha256=$c_bin_sha"
    echo "simple_binary_sha256=$simple_bin_sha"
    echo "c_raw_stdout=$c_stdout_raw_public"
    echo "c_raw_stdout_sha256=$(hash_file "$c_stdout_raw")"
    echo "c_raw_stderr=$c_stderr_raw_public"
    echo "c_raw_stderr_sha256=$(hash_file "$c_stderr_raw")"
    echo "c_runtime_receipt=$c_metrics_public"
    echo "c_runtime_receipt_sha256=$(hash_file "$c_metrics")"
    echo "c_toolchain_receipt=$c_toolchain_public"
    echo "c_toolchain_receipt_sha256=$(hash_file "$c_toolchain")"
    echo "simple_raw_stdout=$simple_stdout_raw_public"
    echo "simple_raw_stdout_sha256=$(hash_file "$simple_stdout_raw")"
    echo "simple_raw_stderr=$simple_stderr_raw_public"
    echo "simple_raw_stderr_sha256=$(hash_file "$simple_stderr_raw")"
    echo "simple_runtime_receipt=$simple_metrics_public"
    echo "simple_runtime_receipt_sha256=$(hash_file "$simple_metrics")"
    echo "c_row=$FINAL_RUN_DIR/c.env"
    echo "c_row_sha256=$(hash_file "$OUT_DIR/c.env")"
    echo "combined_raw_row=$FINAL_RUN_DIR/c.env.raw"
    echo "combined_raw_row_sha256=$(hash_file "$OUT_DIR/c.env.raw")"
    echo "simple_row=$FINAL_RUN_DIR/simple.env"
    echo "simple_row_sha256=$(hash_file "$OUT_DIR/simple.env")"
    echo "aggregate_evidence=$FINAL_RUN_DIR/evidence.env"
    echo "aggregate_evidence_sha256=$(hash_file "$OUT_DIR/evidence.env")"
    echo "c_framebuffer=$c_artifact_public"
    echo "simple_framebuffer=$simple_artifact_public"
    echo "evidence_env=$FINAL_RUN_DIR/evidence.env"
    echo "c_command_argc=7"
    echo "c_command_argv_0=$C_COMMAND_ARGV_0"
    echo "c_command_argv_1=$C_COMMAND_ARGV_1"
    echo "c_command_argv_2=$C_COMMAND_ARGV_2"
    echo "c_command_argv_3=$C_COMMAND_ARGV_3"
    echo "c_command_argv_4=$C_COMMAND_ARGV_4"
    echo "c_command_argv_5=$C_COMMAND_ARGV_5"
    echo "c_command_argv_6=$C_COMMAND_ARGV_6"
    echo "c_command_argv_sha256=$C_COMMAND_ARGV_SHA256"
    echo "simple_command_argc=3"
    echo "simple_command_argv_0=$SIMPLE_COMMAND_ARGV_0"
    echo "simple_command_argv_1=$SIMPLE_COMMAND_ARGV_1"
    echo "simple_command_argv_2=$SIMPLE_COMMAND_ARGV_2"
    echo "simple_command_argv_sha256=$SIMPLE_COMMAND_ARGV_SHA256"
} >"$OUT_DIR/run.manifest.env.provisional"
printf 'manifest_digest_sha256=%s\n' "$(hash_file "$OUT_DIR/run.manifest.env.provisional")" >>"$OUT_DIR/run.manifest.env.provisional"
mv "$OUT_DIR/run.manifest.env.provisional" "$OUT_DIR/run.manifest.env"
perf_immutable_publish_run "$RUN_DIR" "$FINAL_RUN_DIR" || fail "immutable run publication failed"
trap - EXIT HUP INT TERM
if ! perf_immutable_publish_latest_pointer "$OUT_ROOT" "$FINAL_RUN_DIR"; then
    echo "check-vulkan-2d-c-compare: warning: non-authoritative latest pointer was not updated" >&2
fi
cat "$FINAL_RUN_DIR/evidence.env"
exit "$aggregate_rc"
