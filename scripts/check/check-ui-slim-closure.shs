#!/bin/sh
# check-ui-slim-closure.shs — fail-closed gate: an entry's import closure
# must exclude a list of forbidden path prefixes.
#
# Context: doc/03_plan/ui/slim_kernel_plugin/plan.md (Wave 0, package A01) and
# doc/02_requirements/nfr/ui_slim_kernel_plugin.md (NFR-UI-SLIM-002). The slim
# TUI/GUI kernel/plugin work needs proof that a "slim" entry point (e.g. the
# TUI route adapter) does not transitively pull in heavy or layering-violating
# subsystems (compositor, kernel, drivers, skia, gpu) in ordinary mode. This
# gate is the mechanical proof: it runs `deps fast` on the entry, extracts the
# real file paths from its closure listing, and fails if any of them starts
# with a forbidden prefix.
#
# Shape and verdict convention follow the two existing fail-closed gates:
#   scripts/check/check-no-direct-rt.shs
#   scripts/check/check-pure-simple-lint-runnable.shs
# and .claude/rules/vcs.md "Pre-push guards" verdict table.
#
# Verdict is ALWAYS the LAST stdout line:
#   PASS  — <n> file(s) in closure, 0 forbidden                      exit 0
#   FAIL  — <n> file(s) in closure, <k> forbidden: <paths>           exit 1
#   ERROR — nothing was checked (<reason>)                           exit 2
#
# Usage:
#   sh scripts/check/check-ui-slim-closure.shs [--seed PATH] ENTRY.spl FORBIDDEN_PREFIX...
#   sh scripts/check/check-ui-slim-closure.shs --selftest
#
# POSIX sh only. Must run on macOS BSD tools and Linux: no `awk -v`, no
# `grep -P`, no `readlink -f`. Portable equivalents are used throughout.

set -u

SEED="${SIMPLE_SEED:-src/compiler_rust/target/bootstrap/simple}"
SELFTEST=0
ARGS=""

while [ $# -gt 0 ]; do
    case "$1" in
        --seed) SEED="$2"; shift 2 ;;
        --selftest) SELFTEST=1; shift ;;
        --) shift; break ;;
        *) ARGS="$ARGS $1"; shift ;;
    esac
done
# Any remaining args (after a literal --) are positional too.
for a in "$@"; do
    ARGS="$ARGS $a"
done

# Portable repo-root resolution (no readlink -f).
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
cd "$ROOT" || { echo "ERROR — nothing was checked (cannot cd to repo root)"; exit 2; }

# ---- core scan logic, reusable by --selftest and the real run ----
# run_closure_scan SEED_PATH ENTRY FORBIDDEN...
# Prints the verdict line to stdout and returns 0 (PASS), 1 (FAIL), 2 (ERROR).
run_closure_scan() {
    scan_seed="$1"; shift
    scan_entry="$1"; shift
    # remaining "$@" are forbidden prefixes

    if [ -z "$scan_seed" ] || [ ! -x "$scan_seed" ]; then
        echo "ERROR — nothing was checked (no executable seed at '$scan_seed')"
        return 2
    fi
    if [ -z "$scan_entry" ]; then
        echo "ERROR — nothing was checked (no entry file given)"
        return 2
    fi

    scan_out=$("$scan_seed" deps fast "$scan_entry" 2>/dev/null)
    scan_rc=$?
    if [ "$scan_rc" -ne 0 ]; then
        echo "ERROR — nothing was checked (deps fast exited $scan_rc for '$scan_entry')"
        return 2
    fi

    # Extract every whitespace-separated token that literally starts with
    # "src/", from every line, deduped and sorted. This picks up direct
    # imports, transitive files, the entry-file echoed in the header, and
    # each hop of a cycle chain (a -> b -> c), without depending on leading
    # indentation or trailing "(N transitive files)" suffixes.
    scan_paths=$(printf '%s\n' "$scan_out" | awk '
        {
            for (i = 1; i <= NF; i++) {
                if (substr($i, 1, 4) == "src/") print $i
            }
        }
    ' | sort -u)

    if [ -z "$scan_paths" ]; then
        echo "ERROR — nothing was checked (0 src/ paths extracted from deps fast output)"
        return 2
    fi

    scan_n=$(printf '%s\n' "$scan_paths" | grep -c .)

    scan_entry_found=0
    for p in $scan_paths; do
        if [ "$p" = "$scan_entry" ]; then
            scan_entry_found=1
            break
        fi
    done
    if [ "$scan_entry_found" -eq 0 ]; then
        echo "ERROR — nothing was checked (entry '$scan_entry' does not appear in its own closure)"
        return 2
    fi

    scan_forbidden_list=""
    scan_k=0
    for p in $scan_paths; do
        for prefix in "$@"; do
            case "$p" in
                "$prefix"*)
                    scan_k=$((scan_k + 1))
                    if [ -z "$scan_forbidden_list" ]; then
                        scan_forbidden_list="$p"
                    else
                        scan_forbidden_list="$scan_forbidden_list, $p"
                    fi
                    break
                    ;;
            esac
        done
    done

    if [ "$scan_k" -gt 0 ]; then
        echo "FAIL — $scan_n file(s) in closure, $scan_k forbidden: $scan_forbidden_list"
        return 1
    fi

    echo "PASS — $scan_n file(s) in closure, 0 forbidden"
    return 0
}

# ---- selftest ----
if [ "$SELFTEST" -eq 1 ]; then
    ST_DIR=$(mktemp -d "${TMPDIR:-/tmp}/ui-slim-closure-selftest.XXXXXX") || {
        echo "ERROR — nothing was checked (mktemp failed)"
        exit 2
    }
    trap 'rm -rf "$ST_DIR"' EXIT

    st_pass=0
    st_total=5

    # Fixture 1: clean closure (entry present, no forbidden path) -> PASS
    ST_SEED_CLEAN="$ST_DIR/seed_clean.sh"
    cat > "$ST_SEED_CLEAN" <<'EOF'
#!/bin/sh
cat <<'OUT'
=== deps fast: src/entry.spl ===
Direct imports: 1

  src/util.spl  (2 transitive files)
    src/entry.spl
    src/util.spl

=== CYCLES ===
  none
OUT
exit 0
EOF
    chmod +x "$ST_SEED_CLEAN"
    st_out1=$(run_closure_scan "$ST_SEED_CLEAN" "src/entry.spl" "src/forbidden")
    st_rc1=$?
    case "$st_out1" in
        "PASS — "*) [ "$st_rc1" -eq 0 ] && st_pass=$((st_pass + 1)) ;;
    esac
    [ "$st_rc1" -eq 0 ] || echo "selftest fixture 1 (clean -> PASS) FAILED: rc=$st_rc1 out=$st_out1"

    # Fixture 2: one forbidden path -> FAIL naming it
    ST_SEED_FORBIDDEN="$ST_DIR/seed_forbidden.sh"
    cat > "$ST_SEED_FORBIDDEN" <<'EOF'
#!/bin/sh
cat <<'OUT'
=== deps fast: src/entry.spl ===
Direct imports: 2

  src/util.spl  (1 transitive files)
    src/util.spl
  src/forbidden/bad.spl  (1 transitive files)
    src/forbidden/bad.spl

=== CYCLES ===
  none
OUT
exit 0
EOF
    chmod +x "$ST_SEED_FORBIDDEN"
    st_out2=$(run_closure_scan "$ST_SEED_FORBIDDEN" "src/entry.spl" "src/forbidden")
    st_rc2=$?
    case "$st_out2" in
        "FAIL — "*"src/forbidden/bad.spl"*) [ "$st_rc2" -eq 1 ] && st_pass=$((st_pass + 1)) ;;
    esac
    [ "$st_rc2" -eq 1 ] || echo "selftest fixture 2 (forbidden -> FAIL) FAILED: rc=$st_rc2 out=$st_out2"

    # Fixture 3: empty output -> ERROR
    ST_SEED_EMPTY="$ST_DIR/seed_empty.sh"
    cat > "$ST_SEED_EMPTY" <<'EOF'
#!/bin/sh
exit 0
EOF
    chmod +x "$ST_SEED_EMPTY"
    st_out3=$(run_closure_scan "$ST_SEED_EMPTY" "src/entry.spl" "src/forbidden")
    st_rc3=$?
    case "$st_out3" in
        "ERROR — "*) [ "$st_rc3" -eq 2 ] && st_pass=$((st_pass + 1)) ;;
    esac
    [ "$st_rc3" -eq 2 ] || echo "selftest fixture 3 (empty -> ERROR) FAILED: rc=$st_rc3 out=$st_out3"

    # Fixture 4: fake seed exits 3 -> ERROR
    ST_SEED_EXIT3="$ST_DIR/seed_exit3.sh"
    cat > "$ST_SEED_EXIT3" <<'EOF'
#!/bin/sh
echo "some output"
exit 3
EOF
    chmod +x "$ST_SEED_EXIT3"
    st_out4=$(run_closure_scan "$ST_SEED_EXIT3" "src/entry.spl" "src/forbidden")
    st_rc4=$?
    case "$st_out4" in
        "ERROR — "*) [ "$st_rc4" -eq 2 ] && st_pass=$((st_pass + 1)) ;;
    esac
    [ "$st_rc4" -eq 2 ] || echo "selftest fixture 4 (seed exit 3 -> ERROR) FAILED: rc=$st_rc4 out=$st_out4"

    # Fixture 5: missing seed -> ERROR
    ST_SEED_MISSING="$ST_DIR/does_not_exist.sh"
    st_out5=$(run_closure_scan "$ST_SEED_MISSING" "src/entry.spl" "src/forbidden")
    st_rc5=$?
    case "$st_out5" in
        "ERROR — "*) [ "$st_rc5" -eq 2 ] && st_pass=$((st_pass + 1)) ;;
    esac
    [ "$st_rc5" -eq 2 ] || echo "selftest fixture 5 (missing seed -> ERROR) FAILED: rc=$st_rc5 out=$st_out5"

    rm -rf "$ST_DIR"
    trap - EXIT

    if [ "$st_pass" -ne "$st_total" ]; then
        echo "ERROR — nothing was checked (selftest: $st_pass/$st_total passed)"
        exit 2
    fi
    echo "selftest: $st_pass/$st_total passed"
fi

# ---- real run ----
# ARGS holds ENTRY followed by FORBIDDEN_PREFIX...; if --selftest was the
# only thing given, there is nothing further to check.
# shellcheck disable=SC2086
set -- $ARGS
if [ "$#" -eq 0 ]; then
    if [ "$SELFTEST" -eq 1 ]; then
        exit 0
    fi
    echo "ERROR — nothing was checked (no ENTRY.spl given)"
    exit 2
fi

ENTRY="$1"; shift
if [ "$#" -eq 0 ]; then
    echo "ERROR — nothing was checked (no FORBIDDEN_PREFIX given)"
    exit 2
fi

if [ ! -x "$SEED" ]; then
    echo "ERROR — nothing was checked (no executable seed at '$SEED')"
    exit 2
fi

run_closure_scan "$SEED" "$ENTRY" "$@"
exit $?
