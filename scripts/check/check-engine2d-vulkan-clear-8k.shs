#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
BUILD_DIR="${BUILD_DIR:-$ROOT/build/check/engine2d-vulkan-clear-8k}"
ICD="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/lvp_icd.json}"
WIDTH="${ENGINE2D_VULKAN_WIDTH:-7680}"
HEIGHT="${ENGINE2D_VULKAN_HEIGHT:-4320}"
SAMPLES="${ENGINE2D_VULKAN_SAMPLES:-15}"
ACTIVE="${ENGINE2D_VULKAN_ACTIVE_BASIS_POINTS:-10000}"
RECT_COUNT="${ENGINE2D_VULKAN_RECT_COUNT:-0}"
OPERATION="${ENGINE2D_VULKAN_OPERATION:-rect}"
RUNTIME_LIB="$ROOT/src/compiler_rust/target/release/libsimple_runtime.so"
REQUIRE_PHYSICAL="${ENGINE2D_VULKAN_REQUIRE_PHYSICAL:-0}"
REQUIRE_80FPS="${ENGINE2D_VULKAN_REQUIRE_80FPS:-0}"

mkdir -p "$BUILD_DIR"
if [ ! -f "$ICD" ]; then echo "engine2d_vulkan_evidence_status=blocked reason=missing-icd"; exit 2; fi
# Rebuild when the lib is missing OR was built without the vulkan feature.
# A featureless build leaves every rt_vulkan_* as an identical return-0 stub
# (rt_vulkan_init silently fails, bench exits 3 with no output) — detected by
# stub symbols sharing one address (2026-08-31 incident: merge-day rebuild
# shipped a non-vulkan libsimple_runtime.so and this gate died with no verdict).
need_build=0
if [ ! -f "$RUNTIME_LIB" ]; then
    need_build=1
elif command -v nm >/dev/null 2>&1; then
    addr_a=$(nm -D "$RUNTIME_LIB" | awk '$3=="rt_vulkan_init_window_present"{print $1}')
    addr_b=$(nm -D "$RUNTIME_LIB" | awk '$3=="rt_vulkan_init_headless_present"{print $1}')
    if [ -z "$addr_a" ] || { [ -n "$addr_b" ] && [ "$addr_a" = "$addr_b" ]; }; then
        need_build=1
    fi
fi
if [ "$need_build" = 1 ]; then
    (cd "$ROOT/src/compiler_rust" && cargo build -p simple-runtime --release \
        --no-default-features --features vulkan)
fi
glslangValidator -V "$ROOT/test/09_baselines/engine2d_vulkan/clear.comp" \
    -o "$BUILD_DIR/clear.spv" >/dev/null
glslangValidator -V "$ROOT/test/09_baselines/engine2d_vulkan/rect_filled.comp" \
    -o "$BUILD_DIR/rect_filled.spv" >/dev/null
glslangValidator -V "$ROOT/test/09_baselines/engine2d_vulkan/line.comp" \
    -o "$BUILD_DIR/line.spv" >/dev/null
glslangValidator -V "$ROOT/test/09_baselines/engine2d_vulkan/image_copy.comp" \
    -o "$BUILD_DIR/image_copy.spv" >/dev/null
gcc -O2 -Wall -Wextra -Werror \
    "$ROOT/test/09_baselines/engine2d_vulkan/engine2d_vulkan_clear_8k_bench.c" \
    -L"$ROOT/src/compiler_rust/target/release" -lsimple_runtime \
    -Wl,-rpath,"$ROOT/src/compiler_rust/target/release" -lpthread -ldl -lm \
    -o "$BUILD_DIR/bench"
if [ "$RECT_COUNT" -gt 0 ]; then
    PRIMITIVE_SPV="$BUILD_DIR/rect_filled.spv"
    if [ "$OPERATION" = "line" ]; then PRIMITIVE_SPV="$BUILD_DIR/line.spv"; fi
    if [ "$OPERATION" = "image" ]; then PRIMITIVE_SPV="$BUILD_DIR/image_copy.spv"; fi
    if [ "$OPERATION" = "axis-line" ]; then
        PRIMITIVE_SPV="$BUILD_DIR/axis_line_rect.spv"
        cp "$BUILD_DIR/rect_filled.spv" "$PRIMITIVE_SPV"
    fi
    VK_ICD_FILENAMES="$ICD" "$BUILD_DIR/bench" "$BUILD_DIR/clear.spv" \
        "$WIDTH" "$HEIGHT" "$SAMPLES" "$ACTIVE" \
        "$PRIMITIVE_SPV" "$RECT_COUNT" | tee "$BUILD_DIR/receipt.env"
else
    VK_ICD_FILENAMES="$ICD" "$BUILD_DIR/bench" "$BUILD_DIR/clear.spv" \
        "$WIDTH" "$HEIGHT" "$SAMPLES" "$ACTIVE" | tee "$BUILD_DIR/receipt.env"
fi
grep -q '^engine2d_vulkan_mismatch_count=0$' "$BUILD_DIR/receipt.env"
grep -q '^engine2d_vulkan_timed_readback_bytes=0$' "$BUILD_DIR/receipt.env"
grep -q '^engine2d_vulkan_swapchain_presented=false$' "$BUILD_DIR/receipt.env"
grep -q '^engine2d_vulkan_dynamic_frame_80fps_proven=false$' "$BUILD_DIR/receipt.env"
if [ "$REQUIRE_PHYSICAL" = 1 ]; then
    grep -Eq '^engine2d_vulkan_adapter_type=(discrete|integrated)$' "$BUILD_DIR/receipt.env" || {
        echo 'engine2d_vulkan_evidence_status=blocked reason=physical-adapter-required'
        exit 2
    }
fi
if [ "$REQUIRE_80FPS" = 1 ]; then
    grep -q '^engine2d_vulkan_within_80fps_budget=true$' "$BUILD_DIR/receipt.env" || {
        echo 'engine2d_vulkan_evidence_status=failed reason=p95-over-80fps-budget'
        exit 1
    }
fi
if [ "$RECT_COUNT" -gt 0 ]; then
    field() { awk -F= -v key="$1" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$BUILD_DIR/receipt.env"; }
    feature=$(field engine2d_vulkan_operation)
    workload="primitive-v2;${WIDTH}x${HEIGHT};feature=$feature;active-bp=$ACTIVE;count=$RECT_COUNT"
    workload_hash=$(printf '%s' "$workload" | sha256sum | awk '{print $1}')
    device_hash=$(printf '%s' "$(field engine2d_vulkan_adapter_name)|$(field engine2d_vulkan_adapter_identity)" | sha256sum | awk '{print $1}')
    cat >"$BUILD_DIR/c-feature.receipt" <<EOF
schema=engine2d-vulkan-feature-perf-v1
implementation=c
backend=vulkan
feature=$feature
workload_hash=$workload_hash
device_hash=$device_hash
width=$(field engine2d_vulkan_width)
height=$(field engine2d_vulkan_height)
warmup_count=1
sample_count=$(field engine2d_vulkan_samples)
timing_scope=descriptor-command-record-submit-and-fence
p50_ns=$(field engine2d_vulkan_submit_fence_p50_ns)
p95_ns=$(field engine2d_vulkan_submit_fence_p95_ns)
timed_readback_bytes=$(field engine2d_vulkan_timed_readback_bytes)
mismatch_count=$(field engine2d_vulkan_mismatch_count)
checksum=$(field engine2d_vulkan_checksum)
completion=known
fallback=none
EOF
    echo "engine2d_vulkan_feature_receipt=$BUILD_DIR/c-feature.receipt"
fi
echo "engine2d_vulkan_evidence_status=pass"
