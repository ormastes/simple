#!/bin/sh
# Focused fixture only: no compiler/build/qualification execution.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
temporary=$(mktemp -d "${TMPDIR:-/tmp}/committed-controls-test.XXXXXX")
trap 'rm -rf "$temporary"' EXIT HUP INT TERM
repository=$temporary/source
git -c init.defaultBranch=fixture init --quiet --template= "$repository"
mkdir -p "$repository/scripts/build/deep" "$repository/nested" "$repository/.git/info"
printf '%s\n' 'scripts/build export-ignore' '*.txt export-subst' >"$repository/.gitattributes"
printf '%s\n' '* export-ignore export-subst' >"$repository/scripts/build/.gitattributes"
printf '%s\n' '* export-subst' >"$repository/nested/.gitattributes"
printf '%s\n' '#!/bin/sh' 'echo committed' >"$repository/scripts/build/deep/control.shs"
chmod 755 "$repository/scripts/build/deep/control.shs"
printf '%s\n' '$Format:%H$' >"$repository/nested/version.txt"
printf 'literal\r\nbytes\000end\n' >"$repository/binary.dat"
ln -s ../nested/version.txt "$repository/scripts/version-link"
git -C "$repository" add .
git -C "$repository" -c user.name=Fixture -c user.email=fixture@example.invalid commit --quiet -m fixture
commit=$(git -C "$repository" rev-parse HEAD)
# Source-local overrides and dirty contents must neither leak nor be edited.
printf '%s\n' '* export-ignore export-subst' >"$repository/.git/info/attributes"
cp "$repository/.git/info/attributes" "$temporary/original-attributes"
printf 'dirty working bytes\n' >"$repository/nested/version.txt"
printf 'untracked\n' >"$repository/untracked.txt"
sh "$root/scripts/bootstrap/lib/materialize-committed-controls.shs" \
    "$repository" "$commit" "$temporary/result"
checks=0
check() { "$@" || { echo "FAIL: $*" >&2; exit 1; }; checks=$((checks + 1)); }
check test -f "$temporary/result/scripts/build/deep/control.shs"
check test -f "$temporary/result/scripts/build/.gitattributes"
check test -x "$temporary/result/scripts/build/deep/control.shs"
check test -L "$temporary/result/scripts/version-link"
check test "$(readlink "$temporary/result/scripts/version-link")" = ../nested/version.txt
check test ! -e "$temporary/result/untracked.txt"
check cmp "$repository/.git/info/attributes" "$temporary/original-attributes"
for path in .gitattributes scripts/build/.gitattributes scripts/build/deep/control.shs nested/.gitattributes nested/version.txt binary.dat; do
    git -C "$repository" show "$commit:$path" >"$temporary/blob"
    check cmp "$temporary/blob" "$temporary/result/$path"
done
# Output reuse refuses without modifying the existing materialized file.
if sh "$root/scripts/bootstrap/lib/materialize-committed-controls.shs" \
    "$repository" "$commit" "$temporary/result"; then
    echo 'FAIL: reused output accepted' >&2; exit 1
fi
checks=$((checks + 1))
git -C "$repository" show "$commit:nested/version.txt" >"$temporary/blob"
check cmp "$temporary/blob" "$temporary/result/nested/version.txt"
echo "PASS: $checks committed materialization assertions; no compiler executed"
