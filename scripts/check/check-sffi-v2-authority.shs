#!/bin/sh
# Mandatory aggregate for the SFFI v2 source-authority guards introduced by
# PR 75. This list is intentionally explicit: check-guard-wiring.shs can prove
# every child is reachable, and a missing or renamed child fails closed.
set -u

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." 2>/dev/null && pwd -P) || {
    echo "sffi-v2-authority: ERROR — cannot resolve repository root"
    exit 2
}

guard_count=0
guard_failures=0
run_tmp=$(mktemp -d "${TMPDIR:-/tmp}/simple-sffi-v2-authority.XXXXXX") || {
    echo "sffi-v2-authority: ERROR — cannot create output directory"
    exit 2
}
guard_output="$run_tmp/guard.out"
cleanup() {
    rm -f "$guard_output"
    rmdir "$run_tmp"
}
trap cleanup EXIT HUP INT TERM

run_guard() {
    guard_rel=$1
    guard_count=$((guard_count + 1))
    if [ ! -f "$ROOT/$guard_rel" ]; then
        echo "sffi-v2-authority: MISSING $guard_rel"
        guard_failures=$((guard_failures + 1))
        return
    fi
    echo "sffi-v2-authority: RUN $guard_rel"
    : > "$guard_output"
    if sh "$ROOT/$guard_rel" >"$guard_output" 2>&1; then
        tail -n 1 "$guard_output"
    else
        cat "$guard_output"
        echo "sffi-v2-authority: FAIL $guard_rel"
        guard_failures=$((guard_failures + 1))
    fi
}

run_guard "scripts/audit/app-check-sffi-authority.shs"
run_guard "scripts/audit/app-io-hub-sffi-authority.shs"
run_guard "scripts/audit/backend-compile-c-sffi-authority.shs"
run_guard "scripts/audit/backend-exhaustiveness-sffi-authority.shs"
run_guard "scripts/audit/bench-report-sffi-authority.shs"
run_guard "scripts/audit/bootstrap-main-sffi-authority.shs"
run_guard "scripts/audit/bootstrap-probe-args-sffi-authority.shs"
run_guard "scripts/audit/compiler-cache-admission-sffi-authority.shs"
run_guard "scripts/audit/compiler-cache-cas-store-sffi-authority.shs"
run_guard "scripts/audit/compiler-cache-fast-gc-sffi-authority.shs"
run_guard "scripts/audit/compiler-cache-lease-sffi-authority.shs"
run_guard "scripts/audit/compiler-cache-mark-sweep-sffi-authority.shs"
run_guard "scripts/audit/dashboard-remote-collector-sffi-authority.shs"
run_guard "scripts/audit/dashboard-schedule-collector-sffi-authority.shs"
run_guard "scripts/audit/dashboard-scheduler-sffi-authority.shs"
run_guard "scripts/audit/dashboard-stats-clock-sffi-authority.shs"
run_guard "scripts/audit/engine-math2d-sffi-authority.shs"
run_guard "scripts/audit/gpu-engine3d-math-sffi-authority.shs"
run_guard "scripts/audit/interpreter-env-sffi-authority.shs"
run_guard "scripts/audit/interpreter-error-sffi-authority.shs"
run_guard "scripts/audit/interpreter-eval-ast-sffi-authority.shs"
run_guard "scripts/audit/io-sffi-authority.shs"
run_guard "scripts/audit/jwt-clock-sffi-authority.shs"
run_guard "scripts/audit/legacy-actor-hook-sffi-authority.shs"
run_guard "scripts/audit/lint-cross-ref-sffi-authority.shs"
run_guard "scripts/audit/log-sffi-authority.shs"
run_guard "scripts/audit/mono-cache-sffi-authority.shs"
run_guard "scripts/audit/mono-hot-reload-sffi-authority.shs"
run_guard "scripts/audit/parse-probe-all-sffi-authority.shs"
run_guard "scripts/audit/play-session-store-sffi-authority.shs"
run_guard "scripts/audit/portal-server-sffi-authority.shs"
run_guard "scripts/audit/portal-template-sffi-authority.shs"
run_guard "scripts/audit/redis-clock-sffi-authority.shs"
run_guard "scripts/audit/rt-time-contract.shs"
run_guard "scripts/audit/scalar-math-sffi-authority.shs"
run_guard "scripts/audit/sffi-unsafe-backlog.shs"
run_guard "scripts/audit/simd-text-sffi-authority.shs"
run_guard "scripts/audit/ssh-gcm-sffi-v2-authority.shs"
run_guard "scripts/audit/ssh-unbacked-sffi-authority.shs"
run_guard "scripts/audit/test-codegen-quick-sffi-authority.shs"
run_guard "scripts/audit/test-runner-single-sffi-authority.shs"
run_guard "scripts/audit/tiered-jit-clock-sffi-authority.shs"
run_guard "scripts/audit/time-utils-sffi-authority.shs"
run_guard "scripts/audit/tls-oidc-clock-sffi-authority.shs"
run_guard "scripts/audit/torch-dyn-sffi-authority.shs"
run_guard "scripts/audit/wm-lane-boundary-sffi-authority.shs"

if [ "$guard_count" -ne 46 ]; then
    echo "sffi-v2-authority: ERROR — expected 46 guards, ran $guard_count"
    exit 2
fi
if [ "$guard_failures" -ne 0 ]; then
    echo "sffi_v2_authority_ok=false"
    echo "sffi-v2-authority: FAIL — $guard_failures of $guard_count guard(s) failed"
    exit 1
fi

echo "sffi_v2_authority_ok=true"
echo "sffi-v2-authority: PASS — all $guard_count guard(s) passed"
