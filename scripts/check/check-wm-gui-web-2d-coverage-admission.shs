#!/bin/sh
# Strictly admit retained Simple decision/condition coverage.
set -eu
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"
python3 - "$@" <<'PY'
from pathlib import Path
import hashlib, os, re, stat, subprocess, sys, tempfile

ROOT=Path.cwd(); CLASSIFIER="src/lib/common/ui/host_env_contract.spl"
OWNERS=[CLASSIFIER,"src/app/test/test_host_env.spl","src/os/hosted/hosted_entry.spl","src/lib/common/ui/window_scene_draw_ir.spl","src/app/test/renderdoc_replay_inspect.spl","scripts/build/cpu-simd-engine2d-evidence/cpu_simd_engine2d_evidence.spl"]
KEYS=["wm_gui_web_2d_coverage_status","wm_gui_web_2d_coverage_source_revision_kind","wm_gui_web_2d_coverage_source_revision","wm_gui_web_2d_coverage_executable_path","wm_gui_web_2d_coverage_executable_sha256","wm_gui_web_2d_coverage_executable_kind","wm_gui_web_2d_coverage_executable_provenance_path","wm_gui_web_2d_coverage_executable_provenance_sha256","wm_gui_web_2d_coverage_run_id","wm_gui_web_2d_coverage_executable_report_binding_sha256","wm_gui_web_2d_coverage_report_path","wm_gui_web_2d_coverage_report_sha256","wm_gui_web_2d_coverage_classifier_owner","wm_gui_web_2d_coverage_owner_paths","wm_gui_web_2d_coverage_owner_decision_totals","wm_gui_web_2d_coverage_owner_decision_covered","wm_gui_web_2d_coverage_owner_decision_percents"]
SHA=re.compile(r"^[0-9a-f]{64}$"); LAST_REASON=""
def emit(k,v): print(f"{k}={v}")
def result(status,reason,v=None,counts=None):
 global LAST_REASON; LAST_REASON=reason; v=v or {}; counts=counts or {p:(0,0) for p in OWNERS}
 for k,x in [("admission_status",status),("admission_reason",reason),("classifier_threshold_percent",100),("overall_threshold_percent",98),("classifier_decisions_covered",counts[CLASSIFIER][0]),("classifier_decisions_total",counts[CLASSIFIER][1]),("overall_decisions_covered",sum(x[0] for x in counts.values())),("overall_decisions_total",sum(x[1] for x in counts.values())),("owner_paths","|".join(OWNERS)),("owner_decision_counts","|".join(f"{p}:{counts[p][0]}/{counts[p][1]}" for p in OWNERS)),("evidence_path",v.get("_evidence_path","")),("report_path",v.get("wm_gui_web_2d_coverage_report_path","")),("report_sha256",v.get("wm_gui_web_2d_coverage_report_sha256","")),("source_revision",v.get("wm_gui_web_2d_coverage_source_revision","")),("executable_path",v.get("wm_gui_web_2d_coverage_executable_path","")),("executable_sha256",v.get("wm_gui_web_2d_coverage_executable_sha256",""))]: emit("wm_gui_web_2d_coverage_"+k,x)
 return status=="pass"
def exact(text):
 out={}
 for raw in text.splitlines():
  if not raw or raw.startswith("#"): continue
  if "=" not in raw: raise ValueError("malformed-coverage-evidence-line")
  k,v=raw.split("=",1)
  if k in out: raise ValueError("duplicate-coverage-evidence-key:"+k)
  out[k]=v
 if set(out)!=set(KEYS): raise ValueError("missing-or-unknown-coverage-evidence-key")
 return out
def regular(p): return p.is_file() and not p.is_symlink() and p.stat().st_nlink==1
def digest(p): return hashlib.sha256(p.read_bytes()).hexdigest()
def revision():
 h=hashlib.sha256()
 for owner in OWNERS:
  p=ROOT/owner
  if not regular(p): raise ValueError("coverage-owner-not-current-regular:"+owner)
  h.update(owner.encode()+b"\0"+p.read_bytes()+b"\0")
 return h.hexdigest()
def binding(exe_sha,rev,run_id): return hashlib.sha256((exe_sha+"\0"+rev+"\0"+run_id).encode()).hexdigest()
def native(p):
 m=p.read_bytes()[:4]; return m==b"\x7fELF" or m in {b"\xcf\xfa\xed\xfe",b"\xfe\xed\xfa\xcf"} or m[:2]==b"MZ"
def stage3_admitted(exe,manifest,exe_sha,manifest_sha):
 facade=ROOT/"scripts/check/lib/bootstrap-stage3-provenance.shs"
 command='set -eu; BOOTSTRAP_STAGE3_FACADE_PATH=$1; export BOOTSTRAP_STAGE3_FACADE_PATH; . "$1"; bootstrap_stage3_verify_manifest "$2" "$3" "$4" >/dev/null'
 try:
  if digest(exe)!=exe_sha or digest(manifest)!=manifest_sha: return False
  completed=subprocess.run(["/bin/sh","-c",command,"coverage-admission",str(facade),str(manifest),str(ROOT.resolve()),str(exe)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=300)
  if digest(exe)!=exe_sha or digest(manifest)!=manifest_sha: return False
 except (OSError,subprocess.TimeoutExpired): return False
 return completed.returncode==0
def parse_report(text):
 section=""; versions=0; headers=[0,0,0]; meta={}; summary={}; decisions=[]; conditions=[]; ds=set(); cs=set()
 allowed={"producer_executable_kind","producer_executable_sha256","source_revision_kind","source_revision","coverage_run_id","executable_report_binding_sha256"}
 for raw in text.splitlines():
  line=raw.strip()
  if not line or line.startswith("#"): continue
  if line.startswith("version:"):
   versions+=1
   if line!="version: 1.0": raise ValueError("unsupported-coverage-report-version")
   continue
  if section=="" and ":" in line and line.split(":",1)[0] in allowed:
   k,v=line.split(":",1); v=v.strip()
   if k in meta or not v: raise ValueError("missing-or-duplicate-coverage-report-metadata")
   meta[k]=v; continue
  if line=="decisions |id, file, line, column, true_count, false_count|": headers[0]+=1; section="d"; continue
  if line=="conditions |decision_id, condition_id, file, line, column, true_count, false_count|": headers[1]+=1; section="c"; continue
  if line=="summary:": headers[2]+=1; section="s"; continue
  if section=="s":
   q=line.split(":",1)
   if len(q)!=2 or q[0].strip() in summary or not q[1].strip().isdecimal(): raise ValueError("malformed-or-duplicate-coverage-summary")
   summary[q[0].strip()]=int(q[1].strip()); continue
  q=[x.strip() for x in line.split(",")]
  if section=="d":
   if len(q)!=6 or not q[0] or not q[1] or any(not x.isdecimal() for x in q[2:]): raise ValueError("malformed-coverage-decision-row")
   key=tuple(q[:4])
   if key in ds: raise ValueError("duplicate-coverage-decision-row")
   ds.add(key); decisions.append((q[1],int(q[4]),int(q[5]))); continue
  if section=="c":
   if len(q)!=7 or not q[0] or not q[1] or not q[2] or any(not x.isdecimal() for x in q[3:]): raise ValueError("malformed-coverage-condition-row")
   key=tuple(q[:5])
   if key in cs: raise ValueError("duplicate-coverage-condition-row")
   cs.add(key); conditions.append((int(q[5]),int(q[6]))); continue
  raise ValueError("coverage-row-outside-section")
 if versions!=1: raise ValueError("missing-or-duplicate-coverage-report-version")
 if headers!=[1,1,1]: raise ValueError("missing-or-duplicate-coverage-section")
 if set(meta)!=allowed: raise ValueError("missing-or-unknown-coverage-report-metadata")
 if meta["producer_executable_kind"]!="pure-simple-self-hosted": raise ValueError("report-executable-not-pure-simple")
 if meta["source_revision_kind"]!="content-sha256": raise ValueError("invalid-report-source-revision-kind")
 if not meta["coverage_run_id"] or any(not SHA.fullmatch(meta[k]) for k in ["producer_executable_sha256","source_revision","executable_report_binding_sha256"]): raise ValueError("malformed-coverage-report-attestation")
 dc=sum(1 for _,t,f in decisions if t>0 and f>0); cc=sum(1 for t,f in conditions if t>0 and f>0)
 wanted={"total_decisions":len(decisions),"covered_decisions":dc,"total_conditions":len(conditions),"covered_conditions":cc,"decision_percent":dc*100//len(decisions) if decisions else 0,"condition_percent":cc*100//len(conditions) if conditions else 0}
 if summary!=wanted: raise ValueError("forged-coverage-summary")
 return decisions,meta
def validate(text,evidence_path="",trusted_executable=None):
 try: v=exact(text)
 except ValueError as e: return result("fail",str(e))
 v["_evidence_path"]=evidence_path
 try:
  if v["wm_gui_web_2d_coverage_status"]!="pass": raise ValueError("producer-coverage-status-not-pass")
  if v["wm_gui_web_2d_coverage_source_revision_kind"]!="content-sha256": raise ValueError("invalid-coverage-source-revision-kind")
  if v["wm_gui_web_2d_coverage_executable_kind"]!="pure-simple-self-hosted": raise ValueError("coverage-executable-not-pure-simple")
  if not v["wm_gui_web_2d_coverage_run_id"]: raise ValueError("missing-coverage-run-id")
  for k in ["wm_gui_web_2d_coverage_source_revision","wm_gui_web_2d_coverage_executable_sha256","wm_gui_web_2d_coverage_executable_provenance_sha256","wm_gui_web_2d_coverage_executable_report_binding_sha256","wm_gui_web_2d_coverage_report_sha256"]:
   if not SHA.fullmatch(v[k]): raise ValueError("malformed-coverage-sha256:"+k)
  if v["wm_gui_web_2d_coverage_classifier_owner"]!=CLASSIFIER: raise ValueError("wrong-coverage-classifier-owner")
  if v["wm_gui_web_2d_coverage_owner_paths"].split("|")!=OWNERS: raise ValueError("wrong-or-reordered-coverage-owner-paths")
  if v["wm_gui_web_2d_coverage_source_revision"]!=revision(): raise ValueError("stale-coverage-source-revision")
  exe=Path(v["wm_gui_web_2d_coverage_executable_path"]); provenance=Path(v["wm_gui_web_2d_coverage_executable_provenance_path"]); report=Path(v["wm_gui_web_2d_coverage_report_path"]); exe=exe if exe.is_absolute() else ROOT/exe; provenance=provenance if provenance.is_absolute() else ROOT/provenance; report=report if report.is_absolute() else ROOT/report
  if not regular(exe) or not (exe.stat().st_mode&stat.S_IXUSR) or exe.name!="simple" or not native(exe): raise ValueError("unadmitted-pure-simple-coverage-executable")
  if digest(exe)!=v["wm_gui_web_2d_coverage_executable_sha256"]: raise ValueError("stale-coverage-executable-sha256")
  if not regular(provenance): raise ValueError("missing-or-substituted-coverage-executable-provenance")
  if digest(provenance)!=v["wm_gui_web_2d_coverage_executable_provenance_sha256"]: raise ValueError("stale-coverage-executable-provenance-sha256")
  identity=(str(exe.resolve()),digest(exe),str(provenance.resolve()),digest(provenance))
  if (trusted_executable is None and not stage3_admitted(exe.resolve(),provenance.resolve(),v["wm_gui_web_2d_coverage_executable_sha256"],v["wm_gui_web_2d_coverage_executable_provenance_sha256"])) or (trusted_executable is not None and identity!=trusted_executable): raise ValueError("unadmitted-pure-simple-coverage-executable")
  if not regular(report): raise ValueError("missing-or-substituted-coverage-report")
  if digest(report)!=v["wm_gui_web_2d_coverage_report_sha256"]: raise ValueError("stale-coverage-report-sha256")
  decisions,meta=parse_report(report.read_text(encoding="utf-8")); b=binding(v["wm_gui_web_2d_coverage_executable_sha256"],v["wm_gui_web_2d_coverage_source_revision"],v["wm_gui_web_2d_coverage_run_id"])
  if v["wm_gui_web_2d_coverage_executable_report_binding_sha256"]!=b: raise ValueError("invalid-coverage-executable-report-binding")
  expected={"producer_executable_kind":v["wm_gui_web_2d_coverage_executable_kind"],"producer_executable_sha256":v["wm_gui_web_2d_coverage_executable_sha256"],"source_revision_kind":v["wm_gui_web_2d_coverage_source_revision_kind"],"source_revision":v["wm_gui_web_2d_coverage_source_revision"],"coverage_run_id":v["wm_gui_web_2d_coverage_run_id"],"executable_report_binding_sha256":b}
  if meta!=expected: raise ValueError("coverage-executable-report-substitution")
  counts={p:[0,0] for p in OWNERS}
  for owner,t,f in decisions:
   if owner in counts: counts[owner][1]+=1; counts[owner][0]+=1 if t>0 and f>0 else 0
  counts={p:tuple(x) for p,x in counts.items()}
  try: totals=[int(x) for x in v["wm_gui_web_2d_coverage_owner_decision_totals"].split(",")]; covered=[int(x) for x in v["wm_gui_web_2d_coverage_owner_decision_covered"].split(",")]; percents=[int(x) for x in v["wm_gui_web_2d_coverage_owner_decision_percents"].split(",")]
  except ValueError: raise ValueError("malformed-coverage-owner-count")
  if not(len(totals)==len(covered)==len(percents)==len(OWNERS)): raise ValueError("coverage-owner-count-cardinality-mismatch")
  for i,p in enumerate(OWNERS):
   c,t=counts[p]; pct=c*100//t if t else 0
   if (totals[i],covered[i],percents[i])!=(t,c,pct): raise ValueError("forged-coverage-owner-count:"+p)
   if not t: raise ValueError("missing-coverage-owner:"+p)
  cc,ct=counts[CLASSIFIER]; oc=sum(x[0] for x in counts.values()); ot=sum(x[1] for x in counts.values())
  if cc!=ct: raise ValueError("classifier-coverage-below-100")
  if oc*100<ot*98: raise ValueError("overall-coverage-below-98")
  return result("pass","pass",v,counts)
 except (ValueError,OSError,UnicodeError) as e: return result("fail",str(e),v)
def fixture(exe_sha,rev,classifier=100,other=98):
 run_id="self-test-run"; b=binding(exe_sha,rev,run_id); rows=[]; totals=[]; covered=[]
 for p in OWNERS:
  n=classifier if p==CLASSIFIER else other; totals.append(100); covered.append(n)
  for i in range(100): rows.append(f"    d{len(rows)+1}, {p}, {i+1}, 1, 1, {1 if i<n else 0}")
 report="\n".join(["version: 1.0","producer_executable_kind: pure-simple-self-hosted",f"producer_executable_sha256: {exe_sha}","source_revision_kind: content-sha256",f"source_revision: {rev}",f"coverage_run_id: {run_id}",f"executable_report_binding_sha256: {b}","decisions |id, file, line, column, true_count, false_count|",*rows,"conditions |decision_id, condition_id, file, line, column, true_count, false_count|",f"    d1, c1, {CLASSIFIER}, 1, 1, 1, 1","summary:","    total_decisions: 600",f"    covered_decisions: {sum(covered)}","    total_conditions: 1","    covered_conditions: 1",f"    decision_percent: {sum(covered)*100//600}","    condition_percent: 100"])
 v={k:"x" for k in KEYS}; v.update({"wm_gui_web_2d_coverage_status":"pass","wm_gui_web_2d_coverage_source_revision_kind":"content-sha256","wm_gui_web_2d_coverage_source_revision":rev,"wm_gui_web_2d_coverage_executable_sha256":exe_sha,"wm_gui_web_2d_coverage_executable_kind":"pure-simple-self-hosted","wm_gui_web_2d_coverage_run_id":run_id,"wm_gui_web_2d_coverage_executable_report_binding_sha256":b,"wm_gui_web_2d_coverage_report_sha256":hashlib.sha256(report.encode()).hexdigest(),"wm_gui_web_2d_coverage_classifier_owner":CLASSIFIER,"wm_gui_web_2d_coverage_owner_paths":"|".join(OWNERS),"wm_gui_web_2d_coverage_owner_decision_totals":",".join(map(str,totals)),"wm_gui_web_2d_coverage_owner_decision_covered":",".join(map(str,covered)),"wm_gui_web_2d_coverage_owner_decision_percents":",".join(map(str,covered))})
 return v,report
def self_test():
 cases=[]
 def run(name,expected,mutation="",classifier=100,other=98):
  with tempfile.TemporaryDirectory() as d:
   base=Path(d); exe=base/"simple"; provenance=base/"provenance.env"; report_path=base/"coverage.sdn"; exe.write_bytes(b"\x7fELFself-test"); exe.chmod(0o700); provenance.write_text("not-a-stage3-manifest\n"); v,report=fixture(digest(exe),revision(),classifier,other)
   replacements={"version_missing":("version: 1.0\n",""),"version_duplicate":("version: 1.0","version: 1.0\nversion: 1.0"),"version_bad":("version: 1.0","version: 2.0"),"blank_decision":("    d1, ","    , "),"blank_condition":("    d1, c1, ","    d1, , "),"duplicate_condition":("summary:",f"    d1, c1, {CLASSIFIER}, 1, 1, 1, 1\nsummary:"),"condition_summary":("covered_conditions: 1","covered_conditions: 0"),"duplicate_decision":("conditions |",report.splitlines()[8]+"\nconditions |"),"forged_summary":(f"covered_decisions: {classifier+other*5}","covered_decisions: 600"),"substitution":(v["wm_gui_web_2d_coverage_executable_sha256"],"f"*64)}
   if mutation in replacements: report=report.replace(*replacements[mutation],1)
   report_path.write_text(report); v["wm_gui_web_2d_coverage_executable_path"]=str(exe); v["wm_gui_web_2d_coverage_executable_provenance_path"]=str(provenance); v["wm_gui_web_2d_coverage_executable_provenance_sha256"]=digest(provenance); v["wm_gui_web_2d_coverage_report_path"]=str(report_path); v["wm_gui_web_2d_coverage_report_sha256"]=digest(report_path)
   if mutation=="revision": v["wm_gui_web_2d_coverage_source_revision"]="0"*64
   elif mutation=="order": v["wm_gui_web_2d_coverage_owner_paths"]="|".join(reversed(OWNERS))
   elif mutation=="cardinality": v["wm_gui_web_2d_coverage_owner_decision_totals"]="100"
   elif mutation=="count": v["wm_gui_web_2d_coverage_owner_decision_covered"]="99,"+",".join(v["wm_gui_web_2d_coverage_owner_decision_covered"].split(",")[1:])
   elif mutation=="report_sha": v["wm_gui_web_2d_coverage_report_sha256"]="0"*64
   elif mutation=="exe_sha": v["wm_gui_web_2d_coverage_executable_sha256"]="0"*64
   elif mutation=="status": v["wm_gui_web_2d_coverage_status"]="fail"
   elif mutation=="kind": v["wm_gui_web_2d_coverage_source_revision_kind"]="git"
   elif mutation=="exe_kind": v["wm_gui_web_2d_coverage_executable_kind"]="rust-seed"
   elif mutation=="symlink_report": real=base/"real.sdn"; report_path.rename(real); report_path.symlink_to(real)
   elif mutation=="hardlink_report": os.link(report_path,base/"report-link")
   elif mutation=="symlink_exe": real=base/"real-simple"; exe.rename(real); exe.symlink_to(real)
   elif mutation=="hardlink_exe": os.link(exe,base/"simple-link")
   evidence="\n".join(f"{k}={v[k]}" for k in KEYS)+("\nwm_gui_web_2d_coverage_status=pass" if mutation=="duplicate_key" else "")
   trusted=(str(exe.resolve()),digest(exe),str(provenance.resolve()),digest(provenance))
   ok=validate(evidence,"self-test",None if mutation=="arbitrary_elf" else trusted)
  passed=(ok and expected=="pass") or (not ok and LAST_REASON==expected); emit("wm_gui_web_2d_coverage_self_test_"+name,"pass" if passed else "fail"); cases.append(passed)
 run("100_98","pass"); run("classifier_99","classifier-coverage-below-100",classifier=99); run("overall_97","overall-coverage-below-98",other=97)
 checks=[("version_missing","missing-or-duplicate-coverage-report-version"),("version_duplicate","missing-or-duplicate-coverage-report-version"),("version_bad","unsupported-coverage-report-version"),("blank_decision","malformed-coverage-decision-row"),("blank_condition","malformed-coverage-condition-row"),("duplicate_condition","duplicate-coverage-condition-row"),("condition_summary","forged-coverage-summary"),("duplicate_decision","duplicate-coverage-decision-row"),("forged_summary","forged-coverage-summary"),("revision","stale-coverage-source-revision"),("order","wrong-or-reordered-coverage-owner-paths"),("cardinality","coverage-owner-count-cardinality-mismatch"),("count","forged-coverage-owner-count:"+CLASSIFIER),("report_sha","stale-coverage-report-sha256"),("exe_sha","stale-coverage-executable-sha256"),("substitution","coverage-executable-report-substitution"),("symlink_report","missing-or-substituted-coverage-report"),("hardlink_report","missing-or-substituted-coverage-report"),("symlink_exe","unadmitted-pure-simple-coverage-executable"),("hardlink_exe","unadmitted-pure-simple-coverage-executable"),("arbitrary_elf","unadmitted-pure-simple-coverage-executable"),("status","producer-coverage-status-not-pass"),("kind","invalid-coverage-source-revision-kind"),("exe_kind","coverage-executable-not-pure-simple"),("duplicate_key","duplicate-coverage-evidence-key:wm_gui_web_2d_coverage_status")]
 for n,r in checks: run(n,r,n)
 missing=not result("fail","missing-coverage-evidence") and LAST_REASON=="missing-coverage-evidence"; emit("wm_gui_web_2d_coverage_self_test_missing","pass" if missing else "fail"); cases.append(missing)
 emit("wm_gui_web_2d_coverage_self_test_status","pass" if all(cases) else "fail"); return all(cases)
if sys.argv[1:]==["--self-test"]: raise SystemExit(0 if self_test() else 1)
if sys.argv[1:]: result("fail","unsupported-argument"); raise SystemExit(1)
if os.environ.get("WM_GUI_WEB_2D_COVERAGE_FIXTURE"): result("fail","coverage-fixture-forbidden-outside-self-test"); raise SystemExit(1)
evidence_text=os.environ.get("WM_GUI_WEB_2D_COVERAGE_EVIDENCE","build/coverage/wm_gui_web_2d_coverage.env"); evidence=Path(evidence_text); evidence=evidence if evidence.is_absolute() else ROOT/evidence
if not regular(evidence): result("fail","missing-coverage-evidence",{"_evidence_path":evidence_text}); raise SystemExit(1)
ok=validate(evidence.read_text(encoding="utf-8"),evidence_text); raise SystemExit(0 if ok else 1)
PY
