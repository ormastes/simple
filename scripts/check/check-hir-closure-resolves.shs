#!/bin/sh
# check-hir-closure-resolves.shs
#
# Gate: every name an entry closure uses must resolve in HIR.
#
# Why: the phase-4 bootstrap (p4-phase2 lane, 2026-10-20) stopped in HIR on 27
# src/os files with 67 `unresolved name:` / `unresolved type:` errors
# (pci_bdf_bus, draw_text_shadow, spawn_binary_with_args, _inc32, SurfaceDesc,
# ...). Those names had been missing for a long time: earlier lanes resolved
# lazily, so a call that never ran was never looked up. HIR lowering resolves
# eagerly; this gate runs a compile far enough to pass HIR over a given entry
# closure and fails on any unresolved name, type or import, so the next
# missing name is found when it lands and not at the next bootstrap.
#
# Mechanism: `<compiler> compile <entry> --format=smf -o <tmp>` (the only
# compile format the bootstrap CLI has; it lowers the entry's whole source
# closure through parse + HIR + MIR before packaging). The verdict is read
# from the compiler's own output, NOT from its exit status: on a Windows host
# the SMF packaging step fails after HIR and MIR succeed ("SMF packaging
# needs ELF object code, but the backend produced a COFF object"), so a
# non-zero exit does not mean HIR failed. Per entry:
#   - any `unresolved name: X` / `unresolved type: X` / `unresolved import 'M'`
#     line                                                    -> FAIL (names X / M)
#   - otherwise, exit 0 or a `phase=mir` / `phase=smf_package` progress line
#     (HIR finished and handed off)                           -> PASS
#   - otherwise (parse error, crash, timeout, no HIR hand-off) -> ERROR
# The compiler exit status is captured directly into a variable, never
# through a pipe.
#
# --selftest builds two fixtures with the SAME compiler and is fatal: a good
# fixture must PASS, and a bad fixture whose only defect is a call to an
# undefined function inside a never-called function must FAIL naming that
# function. It runs before every scan.
#
# Verdict is the LAST line of stdout, per .claude/rules/vcs.md:
#   PASS  - <n> entry closure(s) passed HIR, 0 unresolved names     exit 0
#   FAIL  - <k> of <n> entry closure(s) have unresolved names: ...  exit 1
#   ERROR - nothing was checked (<reason>)                          exit 2
#
# Not registered in config/check/must_check_gates.sdn; that is an owner
# decision.
#
# Usage:
#   sh scripts/check/check-hir-closure-resolves.shs [--compiler PATH] [--root DIR] <entry.spl>...
#   sh scripts/check/check-hir-closure-resolves.shs --selftest [--compiler PATH]
# Env: SIMPLE_BIN (default compiler), HIR_CHECK_TIMEOUT (seconds per entry, default 1800).

set -u

COMPILER="${SIMPLE_BIN:-bin/simple}"
ROOT=""
SELFTEST_ONLY=0
ENTRIES=""
ENTRY_COUNT=0

while [ $# -gt 0 ]; do
    case "$1" in
        --compiler) COMPILER="$2"; shift 2 ;;
        --root) ROOT="$2"; shift 2 ;;
        --selftest) SELFTEST_ONLY=1; shift ;;
        --help|-h) sed -n '2,50p' "$0"; exit 0 ;;
        --*) printf 'ERROR - nothing was checked (unknown argument: %s)\n' "$1"; exit 2 ;;
        *) ENTRIES="$ENTRIES
$1"; ENTRY_COUNT=$((ENTRY_COUNT + 1)); shift ;;
    esac
done

if [ -z "$ROOT" ]; then
    ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
fi

case "$COMPILER" in
    /*|[A-Za-z]:*) ;;
    *) COMPILER="$ROOT/$COMPILER" ;;
esac

if [ ! -x "$COMPILER" ] && [ ! -x "$COMPILER.exe" ]; then
    printf 'ERROR - nothing was checked (compiler not executable: %s)\n' "$COMPILER"
    exit 2
fi

WORK="${TMPDIR:-/tmp}/hir-closure-resolves.$$"
mkdir -p "$WORK" || { printf 'ERROR - nothing was checked (cannot create %s)\n' "$WORK"; exit 2; }
trap 'rm -rf "$WORK"' EXIT INT TERM

TIMEOUT_SECS="${HIR_CHECK_TIMEOUT:-1800}"
if command -v timeout >/dev/null 2>&1; then
    TIMEOUT_CMD="timeout $TIMEOUT_SECS"
else
    TIMEOUT_CMD=""
fi

# check_entry <project_root> <entry> <log>
# Sets ENTRY_STATE (PASS|FAIL|ERROR) and ENTRY_DETAIL.
check_entry() {
    _root="$1"; _entry="$2"; _log="$3"
    (
        cd "$_root" || exit 97
        SIMPLE_PROJECT_ROOT="$_root" MSYS2_ARG_CONV_EXCL='*' \
            $TIMEOUT_CMD "$COMPILER" compile "$_entry" --format=smf -o "$WORK/out.smf" >"$_log" 2>&1
    )
    _rc=$?
    _unresolved=$(grep -a -o -E "unresolved (name|type): [A-Za-z_][A-Za-z0-9_.]*|unresolved import '[^']*'" "$_log" \
        | sed -e 's/^unresolved name: //' -e 's/^unresolved type: //' -e "s/^unresolved import '\\(.*\\)'\$/import:\\1/" \
        | sort -u | tr '\n' ',' | sed 's/,$//')
    if [ -n "$_unresolved" ]; then
        ENTRY_STATE=FAIL
        ENTRY_DETAIL="$_unresolved"
        return
    fi
    if [ "$_rc" -eq 0 ] || grep -a -q -E 'phase=(mir|optimize_mir|monomorphize|smf_package) state=' "$_log"; then
        ENTRY_STATE=PASS
        ENTRY_DETAIL="rc=$_rc"
        return
    fi
    ENTRY_STATE=ERROR
    if [ "$_rc" -eq 124 ]; then
        ENTRY_DETAIL="timed out after ${TIMEOUT_SECS}s"
    elif grep -a -q 'parse error' "$_log"; then
        ENTRY_DETAIL="parse error before HIR (rc=$_rc)"
    else
        ENTRY_DETAIL="HIR did not complete (rc=$_rc)"
    fi
}

run_selftest() {
    _st="$WORK/selftest"
    mkdir -p "$_st/src/app/hirsel" || return 1
    printf 'fn helper(x: i64) -> i64:\n    x + 1\n\nfn main() -> i64:\n    helper(1)\n' > "$_st/src/app/hirsel/good.spl"
    printf 'fn never_called(x: i64) -> i64:\n    hir_selftest_undefined_fn(x)\n\nfn main() -> i64:\n    0\n' > "$_st/src/app/hirsel/bad.spl"
    check_entry "$_st" src/app/hirsel/good.spl "$WORK/selftest-good.log"
    if [ "$ENTRY_STATE" != PASS ]; then
        printf 'selftest: good fixture was %s (%s); log tail:\n' "$ENTRY_STATE" "$ENTRY_DETAIL" >&2
        tail -5 "$WORK/selftest-good.log" >&2
        return 1
    fi
    check_entry "$_st" src/app/hirsel/bad.spl "$WORK/selftest-bad.log"
    if [ "$ENTRY_STATE" != FAIL ] || [ "$ENTRY_DETAIL" != hir_selftest_undefined_fn ]; then
        printf 'selftest: bad fixture was %s (%s), expected FAIL naming hir_selftest_undefined_fn\n' "$ENTRY_STATE" "$ENTRY_DETAIL" >&2
        tail -5 "$WORK/selftest-bad.log" >&2
        return 1
    fi
    printf 'selftest: good fixture PASS, bad fixture FAIL naming hir_selftest_undefined_fn\n' >&2
    return 0
}

if ! run_selftest; then
    printf 'ERROR - nothing was checked (selftest failed with compiler %s)\n' "$COMPILER"
    exit 2
fi

if [ "$SELFTEST_ONLY" -eq 1 ] && [ "$ENTRY_COUNT" -eq 0 ]; then
    printf 'PASS - selftest: 2 fixture(s) compiled, good PASS and bad FAIL as required\n'
    exit 0
fi

if [ "$ENTRY_COUNT" -eq 0 ]; then
    printf 'ERROR - nothing was checked (no entry files given)\n'
    exit 2
fi

CHECKED=0
FAILED=0
ERRORED=0
FAIL_LIST=""
ERROR_LIST=""
IDX=0
OLD_IFS=$IFS
IFS='
'
for entry in $ENTRIES; do
    IFS=$OLD_IFS
    [ -n "$entry" ] || continue
    IDX=$((IDX + 1))
    if [ ! -f "$ROOT/$entry" ] && [ ! -f "$entry" ]; then
        ERRORED=$((ERRORED + 1))
        ERROR_LIST="$ERROR_LIST $entry(missing)"
        continue
    fi
    check_entry "$ROOT" "$entry" "$WORK/entry-$IDX.log"
    printf 'hir-closure: %s %s %s\n' "$ENTRY_STATE" "$entry" "$ENTRY_DETAIL" >&2
    case "$ENTRY_STATE" in
        PASS) CHECKED=$((CHECKED + 1)) ;;
        FAIL) CHECKED=$((CHECKED + 1)); FAILED=$((FAILED + 1)); FAIL_LIST="$FAIL_LIST $entry: $ENTRY_DETAIL;" ;;
        *) ERRORED=$((ERRORED + 1)); ERROR_LIST="$ERROR_LIST $entry($ENTRY_DETAIL)" ;;
    esac
done
IFS=$OLD_IFS

if [ "$FAILED" -gt 0 ]; then
    printf 'FAIL - %s of %s entry closure(s) have unresolved names:%s\n' "$FAILED" "$ENTRY_COUNT" "$FAIL_LIST"
    exit 1
fi
if [ "$ERRORED" -gt 0 ] || [ "$CHECKED" -eq 0 ]; then
    printf 'ERROR - nothing was checked (%s of %s entry closure(s) did not reach HIR:%s)\n' "$ERRORED" "$ENTRY_COUNT" "$ERROR_LIST"
    exit 2
fi
printf 'PASS - %s entry closure(s) passed HIR, 0 unresolved names\n' "$CHECKED"
exit 0
