# FIXTURE — not compiled, not on any import path. Planted DEFECT input for
# scripts/check/check-extern-abi-signatures.shs --selftest-only.
# This is the exact live defect the gate was extended to catch: a text
# argument declared as a bare `ptr` after the runtime moved to (ptr, len).
# Both declaration shapes are planted so neither extractor can be vacuous.
me emit_runtime_declarations():
    self.builder.emit("declare i8 @rt_selftest_spl_text(ptr)")

fn declare_lib_runtime(mod_, ctx):
    declare_fn(mod_, "rt_selftest_spl_fn", llvm_function_type(i8_ty, [ptr_ty], false))
