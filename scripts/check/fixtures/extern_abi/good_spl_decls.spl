# FIXTURE — not compiled, not on any import path. Planted input for
# scripts/check/check-extern-abi-signatures.shs --selftest-only.
# Mirrors the two shapes the pure-Simple LLVM backends use to declare rt_*:
#   1. textual IR   -- `declare <ty> @rt_x(<args>)` inside an emitted string
#   2. LLVM-C build -- declare_fn(mod_, "rt_x", llvm_function_type(<ret>, [..]))
# Both agree with good_spec.rs, so the gate must report NO mismatch here.
me emit_runtime_declarations():
    self.builder.emit("declare i8 @rt_selftest_spl_text(ptr, i64)")

fn declare_lib_runtime(mod_, ctx):
    declare_fn(mod_, "rt_selftest_spl_fn", llvm_function_type(i8_ty, [ptr_ty, i64_ty], false))
