# GENUINELY erased: one Any-typed parameter, two different concrete
# classes at two call sites. No static receiver type exists at the
# lowering site and native class instances carry no runtime type tag,
# so this MUST fail closed at build time (or rt_panic at run time).
# It must NEVER build and print P=7 twice.
class Dog:
    fn speak(self) -> i64:
        return 7

class Cat:
    fn speak(self) -> i64:
        return 42

fn call_it(x: Any) -> i64:
    return x.speak()

fn main() -> i64:
    print "P={call_it(Dog())}"
    print "Q={call_it(Cat())}"
    return 0
