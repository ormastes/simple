"""

# Used only by scripts/check/check-test-runner-executes-bodies.shs. It lives under
# scripts/check/fixtures/ (not test/) so whole-suite discovery never picks it up.
use std.spec

describe "test-runner calibration (green)":
    it "executes an it body that passes":
        step("Run a trivially-true assertion inside the it body")
        # @req REQ-TEST-RUNNER-CALIBRATION-001
        # @capture(assertion): the runner's reported pass/fail for this body
        expect(1).to_equal(1)
