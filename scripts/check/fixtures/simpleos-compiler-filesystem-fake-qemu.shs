#!/bin/sh
set -eu

arch=$1
timeout=$2
out=$3
image_path=$4
image=$5
nonce=$6
expected_stdout=$7
case_name=${SIMPLEOS_COMPILER_FS_FAKE_CASE:-pass}
sha=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
stdout=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
binary=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd

{
    echo "SIMPLEOS_COMPILER_FS_BEGIN arch=$arch timeout=$timeout nonce=$nonce"
    for path in /usr/bin/simple /usr/bin/simple.smf /bin/simple /bin/simple.smf /sys/apps/simple /sys/apps/simple.smf /sys/apps/simple_compiler /sys/apps/simple_compiler.smf /sys/apps/simple_interpreter /sys/apps/simple_interpreter.smf /sys/apps/simple_loader /sys/apps/simple_loader.smf /SYS/SIMPLETOOL.SDN; do
        [ "$case_name" = missing-role ] && [ "$path" = /bin/simple ] && continue
        role_sha=$sha
        [ "$case_name" = malformed-hash ] && [ "$path" = /bin/simple ] && role_sha=xyz
        [ "$case_name" = role-version-mismatch ] && [ "$path" = /usr/bin/simple ] && role_sha=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
        echo "SIMPLEOS_COMPILER_FS_ROLE path=$path sha256=$role_sha"
    done
    echo "SIMPLEOS_COMPILER_FS_VERSION path=/usr/bin/simple simple_sha256=$sha stdout_sha256=$stdout status=pass"
    hello_nonce=$nonce
    [ "$case_name" = nonce-mismatch ] && hello_nonce=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    hello_stdout=$expected_stdout
    [ "$case_name" = stdout-mismatch ] && hello_stdout=$stdout
    duplicate_nonce=
    [ "$case_name" = duplicate-field ] && duplicate_nonce=" nonce=$nonce"
    echo "SIMPLEOS_COMPILER_FS_HELLO compiler=/usr/bin/simple source=/tmp/hello.spl nonce=$hello_nonce$duplicate_nonce source_sha256=$stdout binary=/tmp/hello binary_sha256=$binary stdout_sha256=$hello_stdout status=pass"
    [ "$case_name" = guest-skip ] && echo "TRIVIAL_SELFHOST_SKIP reason=no-exec"
    pass_image=$image_path
    [ "$case_name" = image-mismatch ] && pass_image=/tmp/not-the-launched-image
    echo "SIMPLEOS_COMPILER_FS_PASS arch=$arch image=$pass_image image_sha256=$image simple_sha256=$sha"
    [ "$case_name" = duplicate-pass ] && echo "SIMPLEOS_COMPILER_FS_PASS arch=$arch image=$image_path image_sha256=$image simple_sha256=$sha"
} >"$out"

if [ "$case_name" = runner-fail ]; then
    exit 9
fi
