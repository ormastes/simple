#!/bin/sh
set -eu

arch=$1
timeout=$2
out=$3
case_name=${SIMPLEOS_COMPILER_FS_FAKE_CASE:-pass}
sha=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
image=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
stdout=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
binary=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd

{
    echo "SIMPLEOS_COMPILER_FS_BEGIN arch=$arch timeout=$timeout"
    for path in /usr/bin/simple /usr/bin/simple.smf /bin/simple /bin/simple.smf /sys/apps/simple /sys/apps/simple.smf /sys/apps/simple_compiler /sys/apps/simple_compiler.smf /sys/apps/simple_interpreter /sys/apps/simple_interpreter.smf /sys/apps/simple_loader /sys/apps/simple_loader.smf /SYS/SIMPLETOOL.SDN; do
        [ "$case_name" = missing-role ] && [ "$path" = /bin/simple ] && continue
        echo "SIMPLEOS_COMPILER_FS_ROLE path=$path sha256=$sha"
    done
    echo "SIMPLEOS_COMPILER_FS_VERSION path=/usr/bin/simple simple_sha256=$sha stdout_sha256=$stdout status=pass"
    echo "SIMPLEOS_COMPILER_FS_HELLO compiler=/usr/bin/simple source=/tmp/hello.spl source_sha256=$stdout binary=/tmp/hello binary_sha256=$binary stdout_sha256=$stdout status=pass"
    [ "$case_name" = guest-skip ] && echo "TRIVIAL_SELFHOST_SKIP reason=no-exec"
    echo "SIMPLEOS_COMPILER_FS_PASS arch=$arch image_sha256=$image simple_sha256=$sha"
    [ "$case_name" = duplicate-pass ] && echo "SIMPLEOS_COMPILER_FS_PASS arch=$arch image_sha256=$image simple_sha256=$sha"
} >"$out"

if [ "$case_name" = runner-fail ]; then
    exit 9
fi
