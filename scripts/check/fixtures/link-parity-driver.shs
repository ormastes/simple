#!/bin/sh
# Test double for the parity gate's exit/error handling, not linker evidence.
set -u
operation=$1
shift
case "$operation" in
    native-build)
        output=''
        while [ "$#" -gt 0 ]; do
            if [ "$1" = -o ]; then shift; output=$1; fi
            shift
        done
        [ -n "$output" ] || exit 2
        cat > "$output" <<'PROGRAM'
#!/bin/sh
echo 'link parity fixture'
if [ "${PARITY_TEST_MODE:-}" = run-fail ]; then exit 9; fi
PROGRAM
        chmod +x "$output"
        case "${PARITY_TEST_MODE:-}" in
            build-fail) exit 7 ;;
            matrix-fail) [ "${SIMPLE_LINKER:-}" != mold ] || exit 7 ;;
        esac
        exit 0 ;;
    run)
        echo 'link parity fixture'
        [ "${PARITY_TEST_MODE:-}" != oracle-fail ] || exit 8
        exit 0 ;;
    *) exit 2 ;;
esac
