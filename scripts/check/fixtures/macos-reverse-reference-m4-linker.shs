#!/bin/sh
set -eu
[ -n "${M4_REAL_CC:-}" ] || { echo "M4 linker wrapper: M4_REAL_CC missing" >&2; exit 2; }
[ -n "${M4_LINK_COUNT_FILE:-}" ] || { echo "M4 linker wrapper: M4_LINK_COUNT_FILE missing" >&2; exit 2; }
printf 'link\n' >>"$M4_LINK_COUNT_FILE"
printf 'argv=' >>"$M4_LINK_COUNT_FILE.args"
printf ' %s' "$@" >>"$M4_LINK_COUNT_FILE.args"
printf '\n' >>"$M4_LINK_COUNT_FILE.args"
if [ -n "${M4_LINK_BLOCK_FILE:-}" ]; then
  printf '%s\n' "$$" >"$M4_LINK_BLOCK_FILE.pid"
  : >"$M4_LINK_BLOCK_FILE.ready"
  trap 'exit 143' HUP INT TERM
  while [ -e "$M4_LINK_BLOCK_FILE" ]; do sleep 1; done
fi
exec "$M4_REAL_CC" "$@"
