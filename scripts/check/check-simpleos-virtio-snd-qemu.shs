#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
arch=aarch64
build=yes
allow_seed=no

while [ "$#" -gt 0 ]; do
    case "$1" in
        --arch) arch=${2:?missing architecture}; shift 2 ;;
        --no-build) build=no; shift ;;
        --diagnostic-seed|--diagnostic-compiler) allow_seed=yes; shift ;;
        --self-test) echo simpleos_virtio_snd_qemu_runner_self_test=pass; exit 0 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

case "$arch" in
    aarch64)
        target=aarch64-unknown-none
        qemu=qemu-system-aarch64
        entry=examples/09_embedded/simple_os/arch/arm64/virtio_snd_probe_entry.spl
        linker=examples/09_embedded/simple_os/arch/arm64/linker.ld
        load_address=0x40000000
        machine_args='-machine virt -cpu cortex-a72'
        ;;
    riscv64)
        target=riscv64-unknown-none
        qemu=qemu-system-riscv64
        entry=examples/09_embedded/simple_os/arch/riscv64/virtio_snd_probe_entry.spl
        linker=examples/09_embedded/simple_os/arch/riscv64/linker.ld
        load_address=0x80200000
        machine_args='-machine virt'
        ;;
    *) echo "unsupported architecture: $arch" >&2; exit 2 ;;
esac

out_dir=${SIMPLEOS_IO_AUDIO_EVIDENCE_DIR:-$root/build/verify/simpleos-io-audio}
simple=${SIMPLE_BIN:-$root/bin/release/x86_64-unknown-linux-gnu/simple}
kernel=$out_dir/$arch-virtio-snd-probe.elf
serial=$out_dir/$arch-virtio-snd.serial.log
build_log=$out_dir/$arch-virtio-snd.build.log
provenance=$out_dir/$arch-virtio-snd.provenance
qmp=$out_dir/$arch-virtio-snd.qmp
mkdir -p "$out_dir"

command -v "$qemu" >/dev/null 2>&1 || { echo "qemu missing: $qemu" >&2; exit 2; }
command -v readelf >/dev/null 2>&1 || { echo 'readelf missing' >&2; exit 2; }
command -v python3 >/dev/null 2>&1 || { echo 'python3 missing' >&2; exit 2; }
test -x "$simple" || { echo "Simple compiler missing: $simple" >&2; exit 2; }

compiler_sha=$(sha256sum "$simple" | awk '{print $1}')
compiler_manifest=${SIMPLE_COMPILER_PROVENANCE:-${simple}.provenance.env}
manifest_value() {
    sed -n "s/^$1=//p" "$compiler_manifest" 2>/dev/null | head -n 1
}
version=$($simple --version 2>&1 || true)
case "$version" in
    *'bootstrap seed only'*|*'Rust-built Simple binary'*|*'Rust-built'*)
        if [ "$allow_seed" != yes ]; then
            echo 'simpleos_virtio_snd_qemu_status=untestable reason=compiler-is-bootstrap-seed' >&2
            exit 2
        fi
        compiler_kind=diagnostic-seed
        ;;
    *'simple-bootstrap'*)
        if [ -f "$compiler_manifest" ] && \
            [ "$(manifest_value status)" = pass ] && \
            [ "$(manifest_value artifact_kind)" = pure-simple-bootstrap-compiler ] && \
            [ "$(manifest_value output_sha256)" = "$compiler_sha" ]; then
            compiler_kind=pure-simple-stage3
        elif [ "$allow_seed" != yes ]; then
            echo 'simpleos_virtio_snd_qemu_status=untestable reason=compiler-is-temporary-stage2' >&2
            exit 2
        else
            compiler_kind=diagnostic-stage2
        fi
        ;;
    *) compiler_kind=pure-simple ;;
esac

if [ "$build" = yes ]; then
    rm -f "$kernel" "$build_log"
    if ! SIMPLE_BOOT_MINIMAL=1 SIMPLE_OS_LOG_MODE=on SIMPLE_TIMEOUT_SECONDS=180 \
        "$simple" native-build \
        --source build/os/generated --source src/os --source src/lib --source examples/09_embedded \
        --backend cranelift --opt-level=aggressive --entry-closure --entry "$entry" \
        --target "$target" --output "$kernel" --linker-script "$linker" \
        >"$build_log" 2>&1
    then
        echo "simpleos_virtio_snd_qemu_status=fail reason=guest-build arch=$arch" >&2
        exit 1
    fi
fi

test -s "$kernel" || { echo "guest kernel missing: $kernel" >&2; exit 1; }
readelf -Ws "$kernel" | grep -Eq '[[:space:]]spl_start$' || {
    echo 'simpleos_virtio_snd_qemu_status=fail reason=spl-start-missing' >&2
    exit 1
}
kernel_sha=$(sha256sum "$kernel" | awk '{print $1}')
source_sha=$(sha256sum \
    src/os/drivers/virtio/virtio_snd_mmio.spl \
    src/os/drivers/virtio/virtio_snd_dma_resources.spl \
    src/os/drivers/virtio/virtio_input_wire.spl \
    src/os/drivers/virtio/virtio_input_mmio.spl \
    src/os/services/audio/virtio_snd_service.spl \
    examples/09_embedded/simple_os/arch/common/virtio_snd_probe.spl \
    examples/09_embedded/simple_os/arch/common/virtio_input_probe.spl | sha256sum | awk '{print $1}')

rm -f "$serial" "$qmp"
set -- $machine_args -m 384M -nographic -no-reboot \
    -global virtio-mmio.force-legacy=false \
    -audiodev driver=none,id=audio0 \
    -device virtio-sound-device,audiodev=audio0 \
    -device virtio-keyboard-device \
    -device virtio-mouse-device \
    -qmp "unix:$qmp,server=on,wait=off" \
    -kernel "$kernel"
if [ "$arch" = aarch64 ]; then
    set -- "$@" -device "loader,addr=$load_address,cpu-num=0"
fi

timeout 25s "$qemu" "$@" >"$serial" 2>&1 &
qemu_pid=$!
attempt=0
while [ "$attempt" -lt 200 ]; do
    if [ -S "$qmp" ] && grep -Fq "SIMPLEOS_INPUT_READY status=ready arch=$arch" "$serial" 2>/dev/null; then
        break
    fi
    kill -0 "$qemu_pid" 2>/dev/null || break
    sleep 0.05
    attempt=$((attempt + 1))
done
if ! [ -S "$qmp" ] || ! grep -Fq "SIMPLEOS_INPUT_READY status=ready arch=$arch" "$serial" 2>/dev/null; then
    kill "$qemu_pid" 2>/dev/null || true
    wait "$qemu_pid" 2>/dev/null || true
    echo "simpleos_virtio_snd_qemu_status=fail reason=input-ready-missing arch=$arch" >&2
    exit 1
fi
python3 "$root/scripts/check/qmp-send-virtio-input.py" "$qmp" || {
    kill "$qemu_pid" 2>/dev/null || true
    wait "$qemu_pid" 2>/dev/null || true
    echo "simpleos_virtio_snd_qemu_status=fail reason=qmp-input-injection arch=$arch" >&2
    exit 1
}
set +e
wait "$qemu_pid"
qemu_rc=$?
set -e
if [ "$qemu_rc" -ne 0 ] && [ "$qemu_rc" -ne 124 ]; then
    echo "simpleos_virtio_snd_qemu_status=fail reason=qemu-exit-$qemu_rc arch=$arch" >&2
    exit 1
fi

grep -Fq "SIMPLEOS_VIRTIO_SND status=driver_ok arch=$arch" "$serial" || {
    echo "simpleos_virtio_snd_qemu_status=fail reason=driver-receipt-missing arch=$arch" >&2
    exit 1
}
grep -Eq '^SIMPLEOS_INPUT_EVENT sequence=[1-9][0-9]* kind=keyboard .*order=monotonic' "$serial" || {
    echo "simpleos_virtio_snd_qemu_status=fail reason=keyboard-receipt-missing arch=$arch" >&2
    exit 1
}
grep -Eq '^SIMPLEOS_INPUT_EVENT sequence=[1-9][0-9]* kind=pointer .*order=monotonic' "$serial" || {
    echo "simpleos_virtio_snd_qemu_status=fail reason=pointer-receipt-missing arch=$arch" >&2
    exit 1
}
grep -Eq '^SIMPLEOS_AUDIO_PLAYBACK non_silent=1 frames=[1-9][0-9]* ' "$serial" || {
    echo "simpleos_virtio_snd_qemu_status=fail reason=playback-receipt-missing arch=$arch" >&2
    exit 1
}
capture=$(grep -E '^SIMPLEOS_AUDIO_CAPTURE status=completed ' "$serial" | tail -n 1 || true)
test -n "$capture" || {
    echo "simpleos_virtio_snd_qemu_status=fail reason=capture-receipt-missing arch=$arch" >&2
    exit 1
}
capture_field() {
    key=$1
    printf '%s\n' "$capture" | tr ' ' '\n' | sed -n "s/^${key}=//p" | head -n 1
}
capture_session=$(capture_field session)
capture_generation=$(capture_field generation)
capture_frames=$(capture_field frames)
capture_samples=$(capture_field samples)
capture_hash=$(capture_field hash)
test -n "$capture_session" && test "$capture_session" -gt 0 || {
    echo "simpleos_virtio_snd_qemu_status=fail reason=capture-session-missing arch=$arch" >&2
    exit 1
}
test -n "$capture_generation" && test "$capture_generation" -gt 0 || {
    echo "simpleos_virtio_snd_qemu_status=fail reason=capture-generation-missing arch=$arch" >&2
    exit 1
}
test -n "$capture_frames" && test "$capture_frames" -gt 0 && test "$capture_frames" -le 256 || {
    echo "simpleos_virtio_snd_qemu_status=fail reason=capture-frame-bounds arch=$arch" >&2
    exit 1
}
test -n "$capture_samples" && test "$capture_samples" -ge "$capture_frames" && test "$capture_samples" -le 4096 || {
    echo "simpleos_virtio_snd_qemu_status=fail reason=capture-sample-bounds arch=$arch" >&2
    exit 1
}
test -n "$capture_hash" && test "$capture_hash" -gt 0 || {
    echo "simpleos_virtio_snd_qemu_status=fail reason=capture-hash-missing arch=$arch" >&2
    exit 1
}
case " $capture " in
    *' bounded=1 '*) ;;
    *)
        echo "simpleos_virtio_snd_qemu_status=fail reason=capture-unbounded arch=$arch" >&2
        exit 1
        ;;
esac
grep -Fq 'SIMPLEOS_AUDIO_SHUTDOWN live_dma_resources=0 receipts=1' "$serial" || {
    echo "simpleos_virtio_snd_qemu_status=fail reason=shutdown-receipt-missing arch=$arch" >&2
    exit 1
}
grep -Fq "SIMPLEOS_VIRTIO_SND_PROBE_PASS arch=$arch" "$serial" || {
    echo "simpleos_virtio_snd_qemu_status=fail reason=probe-pass-missing arch=$arch" >&2
    exit 1
}

{
    echo "arch=$arch"
    echo "compiler_kind=$compiler_kind"
    echo "compiler_sha256=$compiler_sha"
    if [ -f "$compiler_manifest" ]; then
        echo "compiler_provenance_sha256=$(sha256sum "$compiler_manifest" | awk '{print $1}')"
    fi
    printf 'compiler_version=%s\n' "$version" | tr '\n' ' '
    echo
    echo "kernel_sha256=$kernel_sha"
    echo "source_set_sha256=$source_sha"
    echo "qemu=$qemu"
    echo 'guest_execution=1'
} >"$provenance"

if [ "$compiler_kind" != pure-simple ] && [ "$compiler_kind" != pure-simple-stage3 ]; then
    echo "simpleos_virtio_snd_qemu_status=diagnostic-pass arch=$arch compiler=$compiler_kind"
    exit 2
fi
echo "simpleos_virtio_snd_qemu_status=pass arch=$arch compiler=$compiler_kind"
