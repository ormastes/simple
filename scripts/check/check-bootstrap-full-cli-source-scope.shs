#!/bin/sh
# Exercise the real Stage4 argv owner without invoking a compiler or watchdog.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
sed -n '/^bootstrap_native_build_main() {$/,/^}$/p' \
  "$root/scripts/bootstrap/bootstrap-from-scratch.sh" >"$scratch/owner"
[ -s "$scratch/owner" ] || exit 1
. "$scratch/owner"
# Capture the process-owner boundary; no compiler/runtime result is simulated.
perl() { printf '%s\n' "$@" >"$scratch/argv"; }
bootstrap_tree_rss_resolve() {
  bootstrap_tree_rss_summary=test-only
  bootstrap_tree_rss_cap_kib=1048576
  bootstrap_tree_rss_source=contract
  bootstrap_tree_rss_bound=contract
}
absolute_path() { printf '%s\n' "$1"; }
PLATFORM=x86_64-pc-windows-msvc backend=llvm cuda_source_root=src/compositions/cuda_static
plugin_policy_source_root=src/plugins NATIVE_FILE_TIMEOUT_SECONDS=1200 NATIVE_LOW_MEMORY=1
selfhost_jobs=1 repo_root=$root native_cache_dir="$scratch/cache" log_dir=$scratch
bootstrap_runtime_authority_path="$scratch/runtime" build_progress_events=1
bootstrap_native_build_main /genuine/compiler "$scratch/output"
for source in src/compositions/cuda_static src/compiler src/app src/lib src/os src/plugins examples/10_tooling; do
  awk -v expected="$source" 'previous == "--source" && $0 == expected {found=1}
    {previous=$0} END {exit !found}' "$scratch/argv" || {
    echo "full-cli-source-scope: missing admitted root $source" >&2; exit 1;
  }
done
grep -Fxq -- '--entry-closure' "$scratch/argv"
awk 'previous == "--entry" && $0 == "src/app/cli/main.spl" {found=1}
  {previous=$0} END {exit !found}' "$scratch/argv"
echo 'bootstrap-full-cli-source-scope: PASS'
