#!/bin/sh
# Every open checkbox in a plan listed by the plan-remains acceptance lane must
# have an `it` in that plan's acceptance spec, and every acceptance spec must
# carry the in-development tag.
#
# Verdict is the LAST line of stdout, same convention as the push guards:
#   PASS  — <n> plan(s) checked, 0 uncovered    exit 0
#   FAIL  — ...                                 exit 1
#   ERROR — nothing was checked                 exit 2
# A run that checked 0 plans is an ERROR, never a pass.
set -u

CONTRACT="doc/03_plan/agent_tasks/plan_remains_acceptance_2026-09-05.md"
SPECDIR="test/03_system/plan_acceptance"
MIN_SCORE="${SIMPLE_SSPEC_MIN_SCORE:-90}"

selftest() {
    tmp="${TMPDIR:-/tmp}/plan_acc_selftest.$$"
    rm -rf "$tmp"; mkdir -p "$tmp"
    printf -- '- [ ] a\n- [ ] b\n- [x] c\n' > "$tmp/p.md"
    [ "$(open_boxes "$tmp/p.md")" = "2" ] || { echo "selftest: open_boxes miscounted"; rm -rf "$tmp"; return 1; }
    printf -- '# @tag:in-development\n    it "a":\n    it "b":\n' > "$tmp/s.spl"
    [ "$(it_count "$tmp/s.spl")" = "2" ] || { echo "selftest: it_count miscounted"; rm -rf "$tmp"; return 1; }
    [ "$(tag_count "$tmp/s.spl")" = "1" ] || { echo "selftest: tag not seen"; rm -rf "$tmp"; return 1; }
    printf -- 'it "a":\n' > "$tmp/untagged.spl"
    [ "$(tag_count "$tmp/untagged.spl")" = "0" ] || { echo "selftest: false tag"; rm -rf "$tmp"; return 1; }
    rm -rf "$tmp"
    return 0
}

open_boxes() { n=$(grep -cE '^[[:space:]]*[-*] \[ \]' "$1" 2>/dev/null); echo "${n:-0}"; }
it_count()   { n=$(grep -cE '^[[:space:]]*(it|slow_it) ' "$1" 2>/dev/null); echo "${n:-0}"; }
tag_count()  { n=$(grep -c '@tag:in-development' "$1" 2>/dev/null); echo "${n:-0}"; }


EXEMPT="scripts/check/plan_acceptance_exemptions.txt"

# -> allowed shortfall for a slug (0 when unlisted, -1 when no spec is required)
allowed_short() {
    [ -f "$EXEMPT" ] || { echo 0; return; }
    v=$(awk -F'|' -v s="$1" '$1 == s { print $2; exit }' "$EXEMPT")
    echo "${v:-0}"
}

slug_of() { b=$(basename "$1" .md); if [ "$b" = "plan" ]; then b=$(basename "$(dirname "$1")"); fi; echo "$b" | sed -E 's/_2026-[0-9]{2}-[0-9]{2}$//'; }

selftest || { echo "ERROR — nothing was checked (selftest failed)"; exit 2; }

[ -f "$CONTRACT" ] || { echo "ERROR — nothing was checked (missing $CONTRACT)"; exit 2; }

checked=0; exempt=0; offenders=""
# Plan paths are the 4th pipe-separated column of the contract's table rows.
plans=$(awk -F'|' '/^\| *[0-9]+ *\|/ { gsub(/^ +| +$/,"",$4); if ($4 != "") print $4 }' "$CONTRACT")
[ -n "$plans" ] || { echo "ERROR — nothing was checked (no plan rows parsed from $CONTRACT)"; exit 2; }

for rel in $plans; do
    plan="doc/03_plan/$rel"
    [ -f "$plan" ] || { offenders="$offenders missing-plan:$rel"; continue; }
    slug=$(slug_of "$plan")
    spec="$SPECDIR/${slug}_spec.spl"
    checked=$((checked + 1))
    if [ ! -f "$spec" ]; then
        if [ "$(allowed_short "$slug")" = "-1" ]; then
            exempt=$((exempt + 1))
            continue
        fi
        offenders="$offenders no-spec:$slug"
        continue
    fi
    [ "$(tag_count "$spec")" -ge 1 ] || offenders="$offenders untagged:$slug"
    ob=$(open_boxes "$plan"); ic=$(it_count "$spec"); ob=$((ob - $(allowed_short "$slug")))
    [ "$ic" -ge "$ob" ] || offenders="$offenders short:$slug($ic/$ob)"
    grep -qE '^[[:space:]]*(pending|skip)\(' "$spec" && offenders="$offenders uses-pending-or-skip:$slug"
done

[ "$checked" -gt 0 ] || { echo "ERROR — nothing was checked (0 plans)"; exit 2; }

if [ -n "$offenders" ]; then
    echo "FAIL — $checked plan(s) checked, offenders:$offenders"
    exit 1
fi
echo "PASS — $checked plan(s) checked, 0 uncovered, $exempt exempt by name (score bar $MIN_SCORE is NOT checked here; see the contract's measurement-blocked note)"
exit 0
