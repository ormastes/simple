#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/simple-fd-stat-v1.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

cc=${CC:-cc}
"$cc" -std=c11 -D_GNU_SOURCE -Wall -Wextra -Werror -pedantic \
    -I"$root/src/runtime" \
    "$root/src/runtime/test/rt_fd_stat_v1_selfcheck.c" \
    -o "$build_dir/rt_fd_stat_v1_selfcheck"
"$build_dir/rt_fd_stat_v1_selfcheck"

case $("$cc" -dumpmachine) in
    *mingw*|*windows*)
        "$cc" -std=c11 -Wall -Wextra -Werror -pedantic \
            -I"$root/src/runtime" \
            "$root/src/runtime/test/rt_fd_stat_v1_windows_include_order_selfcheck.c" \
            -o "$build_dir/rt_fd_stat_v1_windows_include_order_selfcheck.exe"
        "$build_dir/rt_fd_stat_v1_windows_include_order_selfcheck.exe"
        # Match the core-C bootstrap compilation, with no Windows version override.
        "$cc" -c -Os -ffunction-sections -fdata-sections -fno-unwind-tables \
            -fno-asynchronous-unwind-tables -fno-stack-protector -fPIC -std=gnu11 \
            -DSIMPLE_CORE_C_STANDALONE=1 -DSIMPLE_RUNTIME_MEMORY_OWNER=1 \
            -I"$root/src/runtime" -I"$root/src/runtime/platform" \
            "$root/src/runtime/runtime_native.c" -o "$build_dir/runtime_native.obj"
        ;;
esac
