#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/simple-fd-stat-v1.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

cc=${CC:-cc}
"$cc" -std=c11 -D_GNU_SOURCE -Wall -Wextra -Werror -pedantic \
    -I"$root/src/runtime" \
    "$root/src/runtime/test/rt_fd_stat_v1_selfcheck.c" \
    -o "$build_dir/rt_fd_stat_v1_selfcheck"
"$build_dir/rt_fd_stat_v1_selfcheck"
