#!/bin/sh
# check-stage2-option-unwrap-not-stolen.shs
#
# ADVISORY (landed honestly RED, 2026-08-24). See the STATUS section below.
#
# WHAT THIS PINS
# --------------
# `.unwrap()` on an OPTION whose receiver type is erased must not be bound, by
# method-name suffix alone, to an unrelated type's `unwrap`. Proven by
# disassembly of a Stage-2 binary on 2026-08-24: in
# `driver_hir_pipeline_lowering`'s `lower_and_check_impl`,
#
#   e0ca33: mov  0x78(%r11),%rdi              # load self.ctx.module_surfaces
#   e0ca37: lea  <Poll_dot_unwrap>(%rip),%rsi
#   e0ca3e: call *%rsi                        # WRONG CALLEE
#
# the callee is `lib__nogc_async_mut__async__poll__Poll_dot_unwrap`, which
# checks the Poll::Ready / Poll::Pending discriminants, matches neither Some
# tag, falls through and returns 0. Zero is `< 4096` after masking, which is
# exactly what the driver's formation guard rejects
# (`E-DRIVER-HIR-RETAINED-SURFACES-MALFORMED`), while the field still holds a
# real enum object so the Option keeps comparing non-nil. The whole Stage-2/3
# self-host lane dies on that: rc=139.
#
# TWO CHECKS, both over a Stage-2 compiler you supply with `--stage2 <path>`:
#
#   1. SYMBOLIC. Disassemble the driver's HIR-entry function and count call
#      sites whose target is a `*_dot_unwrap` SIMPLE method symbol. A correct
#      build routes an Option unwrap through the runtime builtin
#      (`rt_enum_payload` / `rt_unwrap_or_trap`), never through a user method,
#      so any such call site is an offender. This is the mechanism check and
#      it is what a fix has to move.
#   2. BEHAVIOURAL. Build a three-line hello world and assert the
#      malformed-surfaces signature is ABSENT and the compiler did not crash.
#      Signature-absence plus a crash test, not `rc == 0`: a Stage-2 build has
#      other, unrelated failure modes and this gate must not claim to pin them.
#
# The exit status of every subprocess is read DIRECTLY into a variable on the
# line after the invocation -- never through a pipe, whose `$?` is the last
# stage's status and has produced false greens in this repo before.
#
# VERDICT (always the last line of stdout):
#   PASS  -- <n> check(s) performed, ...     exit 0   (n is always > 0)
#   FAIL  -- <n> check(s) performed: ...     exit 1
#   ERROR -- nothing was checked (<reason>)  exit 2
# A run that performed 0 checks is ERROR, never a pass. No `--stage2`, a
# missing `objdump`/`nm`, or a stripped artifact with no symbol table are all
# ERROR -- absence of evidence is never a pass.
#
# `--selftest` runs FIRST, unconditionally, and is FATAL.
#
# STATUS: ADVISORY, honestly RED. Measured 2026-08-24 against a Stage 2 built
# from origin/main:
#   FIX2_NATIVE_BUILD_RC=139, malformed signature present,
#   4 `*_dot_unwrap` call sites inside lower_and_check_impl.
# A first attempted fix (widening the erased-receiver refusal in
# compiler/src/codegen/instr/closures_structs.rs) did NOT move either number
# and was therefore NOT landed -- the actual bind site is still unidentified.
# Promote this guard to MANDATORY once a real fix makes it green.
#
# See doc/08_tracking/bug/stage3_n_modules_zero_segv_mir_lowering_x86_64_2026-08-24.md
# and doc/08_tracking/bug/codegen_bare_method_receiver_type_blind_candidate_selection_2026-07-28.md

set -u

STAGE2=""
SELFTEST_ONLY=0
FN_SYMBOL="lower_and_check_impl"

while [ $# -gt 0 ]; do
    case "$1" in
        --stage2) STAGE2="$2"; shift 2 ;;
        --stage2=*) STAGE2="${1#--stage2=}"; shift ;;
        --selftest) SELFTEST_ONLY=1; shift ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

# Counts `*_dot_unwrap` call targets inside the named function of a binary.
# Prints an integer, or NOSYM / NOTOOL / NOFILE.
count_stolen_unwraps() {
    _bin="$1"
    _fn="$2"
    [ -f "$_bin" ] || { echo "NOFILE"; return; }
    command -v nm >/dev/null 2>&1 || { echo "NOTOOL"; return; }
    command -v objdump >/dev/null 2>&1 || { echo "NOTOOL"; return; }

    _addr=$(nm "$_bin" 2>/dev/null | grep " T .*$_fn" | head -1 | awk '{print $1}')
    [ -n "$_addr" ] || { echo "NOSYM"; return; }

    _start=$(printf '%d' "0x$_addr" 2>/dev/null) || { echo "NOSYM"; return; }
    _end=$((_start + 0x9000))
    # The bind is emitted as `lea <sym>(%rip),%reg` + `call *%reg`, NOT as a
    # direct `call <sym>` -- grepping for "call.*_dot_unwrap" misses it and
    # produced a false green during this investigation. Match the symbol
    # reference itself.
    objdump -d --start-address="$_start" --stop-address="$_end" "$_bin" 2>/dev/null \
        | grep -c "_dot_unwrap>"
}

selftest() {
    _tmp=$(mktemp -d) || { echo "selftest: mktemp failed" >&2; return 1; }
    trap 'rm -rf "$_tmp"' EXIT HUP INT TERM
    _rc=0

    # A missing binary must report NOFILE so the caller is forced to ERROR.
    _got=$(count_stolen_unwraps "$_tmp/nope" "$FN_SYMBOL")
    [ "$_got" = "NOFILE" ] || { echo "selftest FAILED: missing binary gave '$_got', want NOFILE" >&2; _rc=1; }

    # A real ELF with no such symbol must report NOSYM, never 0.
    if command -v cc >/dev/null 2>&1; then
        printf 'int main(void){return 0;}\n' > "$_tmp/t.c"
        cc -o "$_tmp/t" "$_tmp/t.c" 2>/dev/null
        CC_RC=$?
        if [ "$CC_RC" = "0" ]; then
            _got=$(count_stolen_unwraps "$_tmp/t" "$FN_SYMBOL")
            [ "$_got" = "NOSYM" ] || { echo "selftest FAILED: symbol-less ELF gave '$_got', want NOSYM" >&2; _rc=1; }
        fi
    fi

    # The offender grep must match the `lea <sym>(%rip)` form, which is how the
    # real miscall is emitted, and must NOT be satisfied by a direct-call-only
    # pattern. Exercised on text so it needs no toolchain.
    _lea='  e0ca37:	48 8d 35 ab 84 07 00 	lea    0x784ab(%rip),%rsi        # e84ee9 <lib__nogc_async_mut__async__poll__Poll_dot_unwrap>'
    echo "$_lea" | grep -q "_dot_unwrap>" || { echo "selftest FAILED: offender pattern misses the lea form" >&2; _rc=1; }
    echo "$_lea" | grep -q "call.*_dot_unwrap" && { echo "selftest FAILED: direct-call pattern must NOT match the lea form" >&2; _rc=1; }

    # A clean line must not be flagged.
    echo '  e0ca40:	lea    0x317630(%rip),%rsi        # 1124077 <rt_enum_payload>' \
        | grep -q "_dot_unwrap>" && { echo "selftest FAILED: clean line flagged" >&2; _rc=1; }

    # A missing toolchain must be NOTOOL (-> ERROR), never 0.
    ( PATH=/nonexistent; export PATH
      command -v nm >/dev/null 2>&1 && exit 1
      exit 0 )
    PATHLESS_RC=$?
    [ "$PATHLESS_RC" = "0" ] || { echo "selftest FAILED: nm still resolvable with empty PATH" >&2; _rc=1; }

    rm -rf "$_tmp"
    return $_rc
}

if ! selftest; then
    echo "ERROR -- nothing was checked (selftest failed; the checker itself is broken)"
    exit 2
fi

if [ "$SELFTEST_ONLY" = "1" ]; then
    echo "PASS -- 6 selftest fixture(s) checked, checker behaves as specified"
    exit 0
fi

if [ -z "$STAGE2" ]; then
    echo "ERROR -- nothing was checked (no --stage2 <path>; this guard needs a Stage-2 compiler to examine)"
    exit 2
fi
if [ ! -x "$STAGE2" ]; then
    echo "ERROR -- nothing was checked (--stage2 '$STAGE2' is not an executable file)"
    exit 2
fi
# The behavioural check runs the compiler from a private temp cwd, so a RELATIVE
# --stage2 would resolve to nothing there: the invocation would fail 127, emit no
# signature, and be scored CLEAN. That fail-open was hit for real while writing
# this guard. Make the path absolute before anything uses it.
case "$STAGE2" in
    /*) : ;;
    *) STAGE2="$(cd "$(dirname "$STAGE2")" 2>/dev/null && pwd)/$(basename "$STAGE2")" ;;
esac
if [ ! -x "$STAGE2" ]; then
    echo "ERROR -- nothing was checked (--stage2 could not be resolved to an absolute executable path)"
    exit 2
fi

CHECKS=0
OFFENDERS=""

STOLEN=$(count_stolen_unwraps "$STAGE2" "$FN_SYMBOL")
case "$STOLEN" in
    NOFILE|NOSYM)
        echo "ERROR -- nothing was checked ($STAGE2 has no '$FN_SYMBOL' symbol; stripped or not a Stage-2 compiler)"
        exit 2 ;;
    NOTOOL)
        echo "ERROR -- nothing was checked (nm/objdump unavailable; absence of a disassembler is not evidence)"
        exit 2 ;;
esac
CHECKS=$((CHECKS + 1))
if [ "$STOLEN" -gt 0 ]; then
    OFFENDERS="$OFFENDERS $STOLEN Simple '*_dot_unwrap' call site(s) inside $FN_SYMBOL -- an Option unwrap bound to a user method instead of the runtime builtin;"
fi

WD=$(mktemp -d) || { echo "ERROR -- nothing was checked (mktemp failed)"; exit 2; }
trap 'rm -rf "$WD"' EXIT HUP INT TERM
printf 'fn main():\n    print "hello"\n' > "$WD/hello.spl"
( cd "$WD" && "$STAGE2" native-build hello.spl --output="$WD/out" ) > "$WD/log" 2>&1
S2_RC=$?
CHECKS=$((CHECKS + 1))
# A run that produced no output at all did not exercise the compiler; scoring it
# clean is exactly the fail-open this guard exists to avoid.
if [ ! -s "$WD/log" ]; then
    rm -rf "$WD"
    echo "ERROR -- nothing was checked (the Stage-2 hello-world invocation produced no output; rc=$S2_RC)"
    exit 2
fi
if grep -a -q "E-DRIVER-HIR-RETAINED-SURFACES-MALFORMED" "$WD/log" 2>/dev/null; then
    OFFENDERS="$OFFENDERS hello world emitted E-DRIVER-HIR-RETAINED-SURFACES-MALFORMED (rc=$S2_RC);"
elif [ "$S2_RC" -ge 128 ] || [ "$S2_RC" = "124" ]; then
    OFFENDERS="$OFFENDERS hello world crashed the Stage-2 compiler (rc=$S2_RC);"
fi
rm -rf "$WD"

if [ "$CHECKS" -le 0 ]; then
    echo "ERROR -- nothing was checked (0 checks performed)"
    exit 2
fi
if [ -n "$OFFENDERS" ]; then
    echo "FAIL -- $CHECKS check(s) performed:$OFFENDERS"
    exit 1
fi
echo "PASS -- $CHECKS check(s) performed, 0 stolen Option unwraps in $FN_SYMBOL and a hello world built with no malformed-surfaces signature"
exit 0
