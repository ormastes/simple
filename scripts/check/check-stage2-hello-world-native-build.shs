#!/bin/sh
# check-stage2-hello-world-native-build.shs
#
# Stage 2/3 admission gate: a candidate bootstrap compiler must be able to
# native-build a TRIVIAL program, and must never CRASH doing it.
#
# WHY THIS EXISTS (measured 2026-08-25, evidence in
# doc/08_tracking/bug/stage2_admitted_while_hello_world_native_build_segv_2026-08-25.md):
#
# `bootstrap-from-scratch.sh` admits Stage 2 on two gates -- "running bootstrap
# compiler sanity" (bootstrap_stage_sanity) and "proving struct
# receiver/runtime capability". Both PASSED on a candidate that SIGSEGV'd
# (rc=139) native-building a two-line hello world with
# E-DRIVER-HIR-RETAINED-SURFACES-MALFORMED.
#
# The naive diagnosis -- "the gates never native-build a trivial program" -- is
# FALSE, and this script is deliberately not built on it.
# `candidate_frontend_smoke` (scripts/check/cert/redeploy_gate/candidate_frontend_admission.shs)
# already native-builds AND executes two fixtures (p2_add, stage2_mir_retention)
# and requires their stdout. Measured: the real known-bad Stage 2 binaries
# (build/bootstrap/s5 and s5full, 2026-08-25) PASS that smoke completely.
#
# The actual gap is an ARGUMENT-FORM axis. Same binary, same flags, same env:
#
#   native-build --entry-closure --runtime-bundle core-c-bootstrap \
#                --mode one-binary --entry hello.spl --output hw.bin   -> rc=0, prints hello
#   native-build --entry-closure --runtime-bundle core-c-bootstrap \
#                --mode one-binary        hello.spl --output hw.bin    -> rc=139 (SEGV)
#
# The gates only ever use the `--entry` flag form, so the crash on the
# POSITIONAL entry form -- the form a human types, and the form the Stage 3
# investigation used -- was never exercised. Hence two arms below.
#
# ARM 2 IS DELIBERATELY A NO-CRASH CHECK, NOT A MUST-SUCCEED CHECK.
# The positional form exits CLEANLY non-zero (rc=1, "missing importing module
# surface") on the Rust seed for an out-of-tree fixture. Demanding success
# there would false-reject a legitimate compiler -- the exact over-scoping
# failure mode that cost this repo two blockers on 2026-08-24. A crash is
# always a defect; a clean diagnostic is not.
#
# ROOT CAUSE OF THE 2026-08-25 INCIDENT IS ALREADY FIXED at origin
# (src/runtime/runtime_native.c rt_heap_ref_wellformed, 2026-08-24). This gate
# is REGRESSION FENCING for the gate-coverage hole, not an open-defect probe.
#
# Verdict is the LAST line on stdout:
#   PASS  — <n> case(s) checked          exit 0
#   FAIL  — ...                          exit 1
#   ERROR — nothing was checked (...)    exit 2

set -u

HW_BUILD_TIMEOUT_SECONDS=${HW_BUILD_TIMEOUT_SECONDS:-300}
HW_EXEC_TIMEOUT_SECONDS=${HW_EXEC_TIMEOUT_SECONDS:-10}
HW_KILL_GRACE_SECONDS=${HW_KILL_GRACE_SECONDS:-5}
HW_BACKEND=${HW_BACKEND:-cranelift}
HW_THREADS=${HW_THREADS:-1}
HW_EXPECT=hello
# The fixture must live INSIDE the repo tree and be named by a repo-root-relative
# path, exactly as candidate_frontend_smoke names p2_add.spl. Measured
# 2026-08-25: an out-of-tree fixture is rejected outright by a HEALTHY compiler
# ("missing importing module surface", rc=1) -- so an out-of-tree fixture would
# have made this gate false-reject every good binary.
# Source inventory admits src/test families. The older cert fixture under
# scripts/ is still used by legacy callers, but is outside those families.
HW_FIXTURE=${HW_FIXTURE:-test/04_smoke/bootstrap_hello_world.spl}
HW_ROOT=${HW_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)}
HW_GATE_SCRIPT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")
HW_RECEIPT_HELPER=$(dirname -- "$HW_GATE_SCRIPT")/lib/item5-hello-receipt.py
HW_RECEIPT_MODE=0

hw_receipt() {
    python3 "$HW_RECEIPT_HELPER" "$1" "$hwc_work" "$hwc_candidate" \
        "$HW_PRODUCER_IDENTITY_JSON" "$HW_PRODUCER_SOURCE_ROOT" \
        "$HW_RUNTIME_ARCHIVE" "$HW_BACKEND" "$HW_TARGET" \
        "$HW_ROOT/$HW_FIXTURE" "$HW_RECEIPT_JSON" "$HW_GATE_SCRIPT"
}

gate_error() {
    printf 'ERROR — nothing was checked (%s)\n' "$1"
    exit 2
}

# Cleanup registry for mktemp'd work dirs. A single trap registered ONCE here
# (rather than a fresh `trap ... EXIT` at every mktemp site) because
# hw_check_candidate's own work dir is created and torn down NESTED inside
# hw_selftest's work dir's lifetime (hw_selftest calls hw_check_candidate per
# fixture) -- a per-site EXIT trap would silently clobber the outer one when
# the inner function returns, leaving the outer dir unprotected against a
# later interrupt. Accumulating into one list and trapping once avoids that.
HW_CLEANUP_DIRS=""
hw_register_cleanup_dir() {
    HW_CLEANUP_DIRS="$HW_CLEANUP_DIRS $1"
}
hw_cleanup_all() {
    for hw_cleanup_dir in $HW_CLEANUP_DIRS; do
        rm -rf "$hw_cleanup_dir"
    done
}
trap hw_cleanup_all EXIT HUP INT TERM

case "$HW_THREADS" in
    ''|*[!0-9]*|0) gate_error "HW_THREADS must be a positive integer" ;;
esac

timeout_bin=$(command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true)
[ -n "$timeout_bin" ] || gate_error "no timeout(1) on PATH; a build half without a timeout cannot classify a hang"

[ -f "$HW_ROOT/$HW_FIXTURE" ] ||
    gate_error "fixture not found: $HW_ROOT/$HW_FIXTURE"

# hw_probe <candidate> <workdir> <form>
# form = entry     -> `--entry <path>`, must build AND run AND print the fixture output
# form = positional-> positional <path>, must merely NOT CRASH
#
# Sets: HW_RC (build rc), HW_CLASS (ok|crash|hang|fail), HW_DETAIL
# The build exit status is read DIRECTLY into a variable on the line AFTER the
# invocation. Never through a pipe: a pipeline's $? is the LAST element's
# status, which has produced false greens in this repo repeatedly.
hw_probe() {
    hw_candidate=$1
    hw_work=$2
    hw_form=$3
    hw_out=$hw_work/out-$hw_form.bin
    hw_log=$hw_work/build-$hw_form.log
    hw_cache=$hw_work/cache-$hw_form
    rm -rf "$hw_cache" "$hw_out"
    HW_DETAIL=""
    hw_fixture=${HW_PROBE_FIXTURE:-$HW_FIXTURE}
    cd "${HW_PROBE_ROOT:-$HW_ROOT}" || return 1

    # `--entry-closure` is MANDATORY on both forms and must never be dropped:
    # measured 2026-08-25, without it the candidate scans the DEFAULT source
    # roots (whole project) and runs unbounded -- >20min on a two-line fixture.
    # That shape must never enter this gate.
    set -- "$hw_candidate" native-build --backend "$HW_BACKEND" \
        --runtime-bundle core-c-bootstrap --entry-closure --mode one-binary \
        --threads "$HW_THREADS" --cache-dir "$hw_cache"
    if [ "$HW_RECEIPT_MODE" = 1 ] && [ "${HW_SELFTEST_ACTIVE:-0}" = 0 ]; then
        hw_receipt_runtime_dir=$(CDPATH= cd -- "$(dirname -- "$HW_RUNTIME_ARCHIVE")" && pwd) || return 1
        SIMPLE_RUNTIME_PATH=$hw_receipt_runtime_dir
        export SIMPLE_RUNTIME_PATH
        set -- "$@" --target "$HW_TARGET" --runtime-path "$hw_receipt_runtime_dir"
    fi
    if [ "$hw_form" = entry ]; then set -- "$@" --entry "$hw_fixture"
    else set -- "$@" "$hw_fixture"; fi
    set -- "$@" --output "$hw_out"
    printf '%s\000' "$@" > "$hw_work/command-$hw_form.argv"
    "$timeout_bin" -k "${HW_KILL_GRACE_SECONDS}s" "${HW_BUILD_TIMEOUT_SECONDS}s" \
        "$@" >"$hw_log" 2>&1
    HW_RC=$?
    printf '%s\n' "$HW_RC" > "$hw_work/build-$hw_form.status"

    # rc=124 is a TIMEOUT: not a pass and not a crash. Distinct class, because a
    # compiler that hangs and one that dies need different investigations.
    if [ "$HW_RC" -eq 124 ]; then
        HW_CLASS=hang
        HW_DETAIL="build timed out after ${HW_BUILD_TIMEOUT_SECONDS}s"
        return 0
    fi
    # >=128 is death by signal (139 = SEGV, 134 = abort). Always a defect,
    # on EITHER form, regardless of what the candidate printed.
    if [ "$HW_RC" -ge 128 ]; then
        HW_CLASS=crash
        HW_DETAIL="killed by signal $((HW_RC - 128)) (rc=$HW_RC)"
        return 0
    fi

    if [ "$hw_form" = positional ]; then
        # No-crash arm. A clean non-zero diagnostic is ACCEPTED on purpose --
        # see the header. Only crash/hang fail here.
        HW_CLASS=ok
        return 0
    fi

    if [ "$HW_RC" -ne 0 ]; then
        HW_CLASS=fail
        HW_DETAIL="build exited $HW_RC"
        # Echo the build log's tail. Without this the gate emits a one-line
        # verdict naming only the exit code, the mktemp'd work dir is removed
        # by the cleanup trap, and the ONLY evidence of why the build failed is
        # gone -- which on 2026-09-06 cost an hour on a failure that does not
        # reproduce standalone (the gate runs concurrently with the stage
        # engine, so contention-only failures are exactly the ones needing this
        # log). Printed BEFORE the verdict so the last-line verdict contract,
        # which bootstrap-qualify-stage2.shs greps, is untouched.
        if [ -s "$hw_log" ]; then
            echo "--- build log tail ($hw_form form, rc=$HW_RC) ---" >&2
            tail -n 30 "$hw_log" >&2
            echo "--- end build log tail ---" >&2
        fi
        return 0
    fi
    if [ ! -x "$hw_out" ]; then
        HW_CLASS=fail
        HW_DETAIL="build reported success but produced no executable"
        return 0
    fi
    if [ "$HW_RECEIPT_MODE" = 1 ] && [ "${HW_SELFTEST_ACTIVE:-0}" = 0 ]; then
        python3 "$HW_RECEIPT_HELPER" native-hash "$hw_out" "$HW_TARGET" > "$hw_work/entry-before.sha256" ||
            gate_error "cannot bind entry executable before execution"
    fi

    # The produced binary must RUN and print the expected output. A build that
    # exits 0 proves nothing about the artifact -- this repo has already been
    # burned by a stage binary whose --version answered cleanly while every
    # real command SEGV'd (.claude/rules/vcs.md, check-stage-binaries-runnable.shs).
    "$timeout_bin" -k "${HW_KILL_GRACE_SECONDS}s" \
        "${HW_EXEC_TIMEOUT_SECONDS}s" "$hw_out" > "$hw_work/run-$hw_form.stdout" 2> "$hw_work/run-$hw_form.stderr"
    hw_run_rc=$?
    printf '%s\n' "$hw_run_rc" > "$hw_work/run-$hw_form.status"
    hw_stdout=$(cat "$hw_work/run-$hw_form.stdout")
    if [ "$hw_run_rc" -eq 124 ]; then
        HW_CLASS=hang
        HW_DETAIL="produced binary hung"
        return 0
    fi
    if [ "$hw_run_rc" -ge 128 ]; then
        HW_CLASS=crash
        HW_DETAIL="produced binary killed by signal $((hw_run_rc - 128))"
        return 0
    fi
    if [ "$hw_run_rc" -ne 0 ]; then
        HW_CLASS=fail
        HW_DETAIL="produced binary exited $hw_run_rc"
        return 0
    fi
    if [ "$hw_stdout" != "$HW_EXPECT" ]; then
        HW_CLASS=fail
        HW_DETAIL="produced binary printed '$hw_stdout', expected '$HW_EXPECT'"
        return 0
    fi
    HW_CLASS=ok
}

# hw_check_candidate <candidate>
# Runs both arms. Appends to HW_FAILURES on any offender. Increments HW_CHECKED
# once per ARM actually executed.
hw_check_candidate() {
    hwc_candidate=$1
    hwc_name=$(basename "$hwc_candidate")
    hwc_retain=0
    if [ -n "${HW_ARTIFACT_DIR:-}" ] && [ "${HW_SELFTEST_ACTIVE:-0}" = 0 ]; then
        # Explicitly owned evidence is never registered for trap cleanup. Logs
        # are written here directly, so TERM/KILL need no last-minute copy.
        case "$HW_ARTIFACT_DIR" in /*) ;; *) gate_error "HW_ARTIFACT_DIR must be absolute" ;; esac
        [ -d "$HW_ARTIFACT_DIR" ] || gate_error "HW_ARTIFACT_DIR must already exist"
        hwc_work=$(mktemp -d "$HW_ARTIFACT_DIR/hw-native-build.XXXXXX") ||
            gate_error "cannot create retained artifact directory"
        hwc_retain=1
        printf 'ARTIFACTS %s\n' "$hwc_work"
    else
        hwc_work=$(mktemp -d "${TMPDIR:-/tmp}/hw-native-build.XXXXXX") || return 1
        hw_register_cleanup_dir "$hwc_work"
    fi

    if [ "$HW_RECEIPT_MODE" = 1 ] && [ "${HW_SELFTEST_ACTIVE:-0}" = 0 ]; then
        hw_receipt begin || gate_error "producer identity preflight rejected"
    fi
    hw_probe "$hwc_candidate" "$hwc_work" entry
    HW_CHECKED=$((HW_CHECKED + 1))
    if [ "$HW_CLASS" != ok ]; then
        HW_FAILURES="$HW_FAILURES ${hwc_name}:entry-form:${HW_CLASS}(${HW_DETAIL})"
    fi

    hw_probe "$hwc_candidate" "$hwc_work" positional
    HW_CHECKED=$((HW_CHECKED + 1))
    if [ "$HW_CLASS" != ok ]; then
        HW_FAILURES="$HW_FAILURES ${hwc_name}:positional-form:${HW_CLASS}(${HW_DETAIL})"
    fi

    if [ "$HW_RECEIPT_MODE" = 1 ] && [ "${HW_SELFTEST_ACTIVE:-0}" = 0 ] && [ -z "$HW_FAILURES" ]; then
        hw_receipt finish || gate_error "producer receipt publication rejected"
    fi

    if [ "$hwc_retain" = 0 ]; then rm -rf "$hwc_work"; fi
}

# ---------------------------------------------------------------- selftest --
# Runs FIRST and is FATAL. Fixtures are real executables driven by the real
# prober, mutating in BOTH directions: every must-FAIL fixture replays a shape
# seen on a real artifact, and the must-PASS fixtures pin the behaviours this
# gate must never reject.
hw_selftest() {
    hw_selftest_saved_receipt_mode=$HW_RECEIPT_MODE
    HW_RECEIPT_MODE=0
    HW_SELFTEST_ACTIVE=1
    st_work=$(mktemp -d "${TMPDIR:-/tmp}/hw-native-build-selftest.XXXXXX") ||
        gate_error "selftest could not create a work dir"
    hw_register_cleanup_dir "$st_work"
    st_fail=""
    st_n=0

    # A fake candidate parses just enough of the real CLI to find --output and
    # to tell the two argument forms apart.
    st_make() {
        st_path=$st_work/$1
        shift
        {
            echo '#!/bin/sh'
            echo 'out=""; positional=0; prev=""'
            echo 'for a in "$@"; do'
            echo '  if [ "$prev" = --output ]; then out=$a; fi'
            echo '  case "$a" in *hello_world.spl) [ "$prev" = --entry ] || positional=1 ;; esac'
            echo '  prev=$a'
            echo 'done'
            cat
        } >"$st_path"
        chmod +x "$st_path"
    }

    # good: builds on both forms, artifact prints the expected output.
    st_make good <<'EOF'
printf '#!/bin/sh\necho hello\n' >"$out"; chmod +x "$out"; exit 0
EOF
    # positional-segv: the REAL incident shape -- entry form fine, positional
    # form SEGVs. This is the fixture the shipped gates could not see.
    st_make positional-segv <<'EOF'
if [ "$positional" = 1 ]; then kill -SEGV $$; sleep 5; fi
printf '#!/bin/sh\necho hello\n' >"$out"; chmod +x "$out"; exit 0
EOF
    # positional-clean-error: the REAL Rust seed shape -- exits 1 with a
    # diagnostic on the positional form. MUST PASS. This fixture is the
    # false-positive fence; if it ever fails, the gate has over-scoped.
    st_make positional-clean-error <<'EOF'
if [ "$positional" = 1 ]; then echo "error: missing importing module surface" >&2; exit 1; fi
printf '#!/bin/sh\necho hello\n' >"$out"; chmod +x "$out"; exit 0
EOF
    # hang: must be classified HANG, distinctly from crash.
    st_make hang <<'EOF'
sleep 3600
EOF
    # wrong-output: builds fine, artifact prints the wrong thing.
    st_make wrong-output <<'EOF'
printf '#!/bin/sh\necho goodbye\n' >"$out"; chmod +x "$out"; exit 0
EOF
    # silent-success: exits 0 but produces NO artifact.
    st_make silent-success <<'EOF'
exit 0
EOF

    st_expect() {
        st_name=$1
        st_want=$2
        st_n=$((st_n + 1))
        HW_CHECKED=0
        HW_FAILURES=""
        HW_BUILD_TIMEOUT_SECONDS=5 hw_check_candidate "$st_work/$st_name"
        if [ "$HW_CHECKED" -ne 2 ]; then
            st_fail="$st_fail $st_name:arms-not-run($HW_CHECKED)"
            return 0
        fi
        case "$st_want" in
            pass)
                [ -z "$HW_FAILURES" ] ||
                    st_fail="$st_fail $st_name:false-positive($HW_FAILURES)" ;;
            *)
                case "$HW_FAILURES" in
                    *"$st_want"*) ;;
                    "") st_fail="$st_fail $st_name:not-detected" ;;
                    *) st_fail="$st_fail $st_name:misclassified($HW_FAILURES)" ;;
                esac ;;
        esac
    }

    st_expect good pass
    st_expect positional-clean-error pass
    st_expect positional-segv "positional-form:crash"
    st_expect hang "entry-form:hang"
    st_expect wrong-output "entry-form:fail"
    st_expect silent-success "entry-form:fail"
    [ ! -e "$hwc_work" ] || st_fail="$st_fail default:artifacts-not-cleaned"

    # Retention is evidence only: preserve a real clean-error diagnostic while
    # retaining exactly the existing two-arm verdict. Selftest evidence itself
    # lives under the selftest owner, never in the caller's artifact directory.
    st_n=$((st_n + 1))
    st_saved_artifacts=${HW_ARTIFACT_DIR:-}
    mkdir "$st_work/retained" || gate_error "selftest artifact directory"
    HW_ARTIFACT_DIR=$st_work/retained
    HW_SELFTEST_ACTIVE=0
    HW_CHECKED=0
    HW_FAILURES=""
    hw_check_candidate "$st_work/positional-clean-error"
    if [ "$HW_CHECKED" -ne 2 ] || [ -n "$HW_FAILURES" ] ||
       ! grep -q 'missing importing module surface' "$hwc_work/build-positional.log" ||
       [ ! -x "$hwc_work/out-entry.bin" ]; then
        st_fail="$st_fail retained:missing-artifacts-or-changed-verdict"
    fi
    HW_ARTIFACT_DIR=$st_saved_artifacts
    HW_SELFTEST_ACTIVE=1

    # An empty candidate list must leave 0 arms run, forcing the caller to ERROR.
    st_n=$((st_n + 1))
    HW_CHECKED=0
    HW_FAILURES=""
    [ "$HW_CHECKED" -eq 0 ] || st_fail="$st_fail empty:non-vacuity-broken"

    rm -rf "$st_work"
    if [ -n "$st_fail" ]; then
        printf 'selftest FAILED:%s\n' "$st_fail" >&2
        printf 'FAIL — selftest failed (%s case(s)):%s\n' "$st_n" "$st_fail"
        exit 1
    fi
    HW_SELFTEST_CASES=$st_n
    HW_SELFTEST_ACTIVE=0
    HW_RECEIPT_MODE=$hw_selftest_saved_receipt_mode
}

# -------------------------------------------------------------------- main --
HW_SELFTEST_ONLY=0
HW_CANDIDATES=""
while [ $# -gt 0 ]; do
    case "$1" in
        --selftest) HW_SELFTEST_ONLY=1 ;;
        --candidate) shift; [ $# -gt 0 ] || gate_error "--candidate needs a path"
                     HW_CANDIDATES="$HW_CANDIDATES $1" ;;
        -h|--help)
            echo "usage: check-stage2-hello-world-native-build.shs [--selftest] [--candidate PATH]..."
            exit 0 ;;
        -*) gate_error "unknown option: $1" ;;
        *) HW_CANDIDATES="$HW_CANDIDATES $1" ;;
    esac
    shift
done

# Receipt mode is prospective, single-candidate and requires retained evidence.
# A plain gate PASS or selftest can never be converted into a producer receipt.
if [ -n "${HW_RECEIPT_JSON:-}" ]; then
    [ "$HW_SELFTEST_ONLY" = 0 ] || gate_error "selftest cannot publish a producer receipt"
    set -- $HW_CANDIDATES
    [ "$#" = 1 ] || gate_error "receipt mode requires exactly one candidate"
    [ -n "${HW_PRODUCER_IDENTITY_JSON:-}" ] && [ -n "${HW_PRODUCER_SOURCE_ROOT:-}" ] &&
        [ -n "${HW_RUNTIME_ARCHIVE:-}" ] && [ -n "${HW_TARGET:-}" ] &&
        [ -n "${HW_ARTIFACT_DIR:-}" ] || gate_error "receipt identity/source/runtime/target/artifacts required"
    command -v python3 >/dev/null 2>&1 || gate_error "receipt mode requires python3"
    HW_RECEIPT_MODE=1
fi

# Selftest runs first, unconditionally, and is fatal.
hw_selftest

if [ "$HW_SELFTEST_ONLY" = 1 ]; then
    printf 'PASS — %s case(s) checked (selftest only)\n' "$HW_SELFTEST_CASES"
    exit 0
fi

[ -n "${HW_CANDIDATES# }" ] ||
    gate_error "no candidate given; pass --candidate PATH (absence of an artifact is absence of evidence, never a pass)"

HW_CHECKED=0
HW_FAILURES=""
for hw_c in $HW_CANDIDATES; do
    [ -x "$hw_c" ] || gate_error "candidate is not executable: $hw_c"
    hw_check_candidate "$hw_c"
done

# A run that executed 0 arms is ERROR, never a pass.
[ "$HW_CHECKED" -gt 0 ] || gate_error "0 arms executed"

if [ -n "$HW_FAILURES" ]; then
    printf 'FAIL — %s case(s) checked,%s\n' "$HW_CHECKED" "$HW_FAILURES"
    exit 1
fi
printf 'PASS — %s case(s) checked\n' "$HW_CHECKED"
exit 0
