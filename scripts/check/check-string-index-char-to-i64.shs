#!/bin/sh
# Guard: string-indexed char .to_i64() silent-zero family.
# Flags recv[idx].to_i64() sites whose receiver resolves (by in-file
# declaration) to a scalar text/String — the pattern that silently yields
# 0 / digit-value instead of a char code. Byte lists and [text] split-parts
# are benign and NOT flagged. See
# doc/08_tracking/bug/indexed_char_to_i64_silent_zero_family_2026-08-10.md
#
# Verdict (last line of stdout):
#   PASS — <n> site(s) scanned, 0 string-indexed hits, control hit OK
#   FAIL — <k> string-indexed hit(s) ...
#   ERROR — nothing was checked / control fixture not detected
# Scans ALL of src/lib — no directory is excluded for any reason.
set -u
cd "$(dirname "$0")/../.." || { echo "ERROR — nothing was checked (bad cwd)"; exit 2; }

scan() {
  # $1 = file
  awk '
    {
      line = $0; ln = NR
      lines[ln] = line
      while (match(line, /[A-Za-z_][A-Za-z_0-9]*\[[^][]+\]\.to_i64\(\)/)) {
        hit = substr(line, RSTART, RLENGTH)
        recv = hit; sub(/\[.*/, "", recv)
        idx = hit; sub(/^[^[]*\[/, "", idx); sub(/\].*/, "", idx)
        if (idx !~ /:/) { nsite++; sites[nsite] = ln "\t" recv }
        line = substr(line, RSTART + RLENGTH)
      }
      body = body "\n" $0
    }
    END {
      for (i = 1; i <= nsite; i++) {
        split(sites[i], a, "\t"); ln = a[1]; r = a[2]
        # benign receiver types first
        if (body ~ (r "[ \t]*:[ \t]*\\[")) continue                # any list type
        if (body ~ ("(val|var|let)[ \t]+" r "[ \t]*=[^\n]*\\.(split|split_char|lines|to_bytes|bytes|as_bytes|to_utf8)\\(")) continue
        if (body ~ (r "[ \t]*=[^\n]*(rt_string_bytes|text_to_bytes|str_split)")) continue
        isstr = 0
        if (body ~ (r "[ \t]*:[ \t]*(text|str|string|String|Text)[^\\]]")) isstr = 1
        if (body ~ ("(val|var|let)[ \t]+" r "[ \t]*=[ \t]*\"")) isstr = 1
        if (body ~ (r "\\.char_code_at\\(")) isstr = 1
        if (body ~ (r "\\.substring\\(")) isstr = 1
        if (isstr) printf "HIT\t%s\t%d\t%s\n", FILENAME, ln, r
        total++
      }
      printf "SCANNED\t%d\n", nsite
    }
  ' "$1"
}

TMPD=$(mktemp -d) || { echo "ERROR — nothing was checked (mktemp)"; exit 2; }
trap 'rm -rf "$TMPD"' EXIT

# --- control fixture: a planted dangerous site the scanner MUST find ---
cat > "$TMPD/control.spl" <<'EOF'
fn classify(s: text) -> i64:
    val c = s[0].to_i64()
    return c
EOF
if ! scan "$TMPD/control.spl" | /usr/bin/grep -q '^HIT'; then
  echo "ERROR — nothing was checked (control fixture not detected)"
  exit 2
fi

scanned=0; hits=0; hitlines=""
for f in $(/usr/bin/grep -rl --include='*.spl' ']\.to_i64()' src/lib 2>/dev/null); do
  out=$(scan "$f")
  n=$(printf '%s\n' "$out" | awk -F'\t' '/^SCANNED/{print $2}')
  scanned=$((scanned + ${n:-0}))
  h=$(printf '%s\n' "$out" | /usr/bin/grep '^HIT' || true)
  if [ -n "$h" ]; then
    hits=$((hits + $(printf '%s\n' "$h" | wc -l)))
    printf '%s\n' "$h"
  fi
done

if [ "$scanned" -eq 0 ]; then
  echo "ERROR — nothing was checked (0 sites scanned)"
  exit 2
fi
if [ "$hits" -gt 0 ]; then
  echo "FAIL — $hits string-indexed .to_i64() hit(s) across $scanned scanned site(s); use char_code_at"
  exit 1
fi
echo "PASS — $scanned site(s) scanned, 0 string-indexed hits, control hit OK"
exit 0
