#!/bin/sh
# Produce an immutable host-GPU runtime capsule for the strict web build.
#
# The capsule contains the Rust host-GPU archive and the small hosted-TLS C
# supplement.  Admission is fail-closed: the runtime source tree is hashed
# before and after the build, and the manifest binds every selected binary
# input (archive, TLS source/object, and libcrypto) to those exact bytes.
#
# Usage:
#   sh scripts/check/build-host-gpu-runtime-capsule.shs --output DIR
#
# DIR must be below the repository root.  The output is published atomically
# and must not already exist; this keeps an old capsule from being silently
# replaced while another build is using it.
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT_DIR"

fail() {
    echo "host_gpu_runtime_capsule_status=fail"
    echo "host_gpu_runtime_capsule_reason=$1"
    exit 1
}

OUTPUT_ROOT=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --output)
            [ "$#" -ge 2 ] || fail "missing-output-value"
            OUTPUT_ROOT=$2
            shift 2
            ;;
        --help)
            echo "usage: sh scripts/check/build-host-gpu-runtime-capsule.shs --output DIR"
            exit 0
            ;;
        *)
            fail "unknown-argument:$1"
            ;;
    esac
done
[ -n "$OUTPUT_ROOT" ] || fail "output-required"
case "$OUTPUT_ROOT" in
    /*) ;;
    *) OUTPUT_ROOT="$ROOT_DIR/$OUTPUT_ROOT" ;;
esac
OUTPUT_PARENT=$(dirname -- "$OUTPUT_ROOT")
mkdir -p "$OUTPUT_PARENT"
OUTPUT_ROOT=$(CDPATH= cd -- "$OUTPUT_PARENT" && pwd)/$(basename -- "$OUTPUT_ROOT")
case "$OUTPUT_ROOT" in
    "$ROOT_DIR"/*) ;;
    *) fail "output-must-be-under-repository-root" ;;
esac
[ ! -e "$OUTPUT_ROOT" ] && [ ! -L "$OUTPUT_ROOT" ] || fail "output-already-exists:$OUTPUT_ROOT"

HOST_CC=${CC:-cc}
HOST_NM=${NM:-nm}
command -v "$HOST_CC" >/dev/null 2>&1 || fail "cc-not-found:$HOST_CC"
command -v "$HOST_NM" >/dev/null 2>&1 || fail "nm-not-found:$HOST_NM"
command -v cargo >/dev/null 2>&1 || fail "cargo-not-found"

hash_file() {
    sha256sum "$1" | awk '{print $1}'
}

# This definition is intentionally identical to the strict web wrapper and
# its focused link-plan gate.  It covers the Rust runtime inputs, the runtime
# symbol table used by native linking, and the standalone C runtime inputs;
# vendored/large image/font headers are excluded by policy.
runtime_source_tree_sha256() {
    (
        cd "$ROOT_DIR"
        git ls-files --cached --others --exclude-standard -- \
            src/compiler_rust/runtime src/compiler_rust/common/src/runtime_symbols.rs src/runtime \
            | LC_ALL=C sort \
            | while IFS= read -r source; do
                case "$source" in
                    src/runtime/vendor/*|src/runtime/.simple/*|*/target/*) continue ;;
                    src/runtime/*.o|src/runtime/*.a|src/runtime/*.so) continue ;;
                    src/runtime/miniaudio.h|src/runtime/stb_image.h|src/runtime/stb_truetype.h) continue ;;
                esac
                [ -f "$source" ] && sha256sum "$source"
            done
    ) | sha256sum | awk '{print $1}'
}

SOURCE_TREE_BEFORE=$(runtime_source_tree_sha256)
HEAD_REVISION=$(git rev-parse HEAD)
FINAL_DIR="$OUTPUT_ROOT"
PARENT_DIR=$(dirname -- "$FINAL_DIR")
mkdir -p "$PARENT_DIR"
TMP_DIR=$(mktemp -d "$PARENT_DIR/.host-gpu-runtime-capsule.tmp.XXXXXX")
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT HUP INT TERM

CARGO_TARGET_DIR="$TMP_DIR/cargo-target"
mkdir -p "$CARGO_TARGET_DIR"
CARGO_LOG="$TMP_DIR/cargo.log"
set +e
CARGO_TARGET_DIR="$CARGO_TARGET_DIR" cargo build --locked --offline \
    --manifest-path "$ROOT_DIR/src/compiler_rust/Cargo.toml" \
    --package simple-runtime --lib --profile bootstrap \
    --features vulkan,cuda >"$CARGO_LOG" 2>&1
CARGO_STATUS=$?
set -e
[ "$CARGO_STATUS" -eq 0 ] || {
    sed -n '1,160p' "$CARGO_LOG" >&2
    fail "cargo-build-exit:$CARGO_STATUS"
}

RUNTIME_ARCHIVE="$CARGO_TARGET_DIR/bootstrap/libsimple_runtime.a"
[ -s "$RUNTIME_ARCHIVE" ] || fail "runtime-archive-missing"

TLS_SOURCE="$ROOT_DIR/src/runtime/runtime_tls_hosted.c"
TLS_OBJECT="$TMP_DIR/runtime_tls_hosted.o"
"$HOST_CC" -std=gnu11 -O2 -ffunction-sections -fdata-sections \
    -I"$ROOT_DIR/src/runtime" -c "$TLS_SOURCE" -o "$TLS_OBJECT" \
    || fail "hosted-tls-compile-failed"

for symbol in \
    rt_cuda_available rt_cuda_device_count rt_cuda_init rt_cuda_launch_kernel \
    rt_vulkan_provider_is_available rt_vulkan_provider_device_count \
    rt_vulkan_init rt_vulkan_compile_spirv_raw rt_vulkan_create_compute_pipeline
do
    "$HOST_NM" -g --defined-only "$RUNTIME_ARCHIVE" 2>/dev/null \
        | awk -v expected="$symbol" 'NF >= 1 && $NF == expected { found = 1 } END { exit(found ? 0 : 1) }' \
        || fail "runtime-gpu-symbol-missing:$symbol"
done
for symbol in rt_byte_char rt_rsa_decrypt rt_wire_to_hex rt_hex_to_wire rt_random_i64; do
    "$HOST_NM" -g --defined-only "$TLS_OBJECT" 2>/dev/null \
        | awk -v expected="$symbol" 'NF >= 1 && $NF == expected { found = 1 } END { exit(found ? 0 : 1) }' \
        || fail "hosted-tls-symbol-missing:$symbol"
done

CRYPTO_LINK_NAME=$($HOST_CC -print-file-name=libcrypto.so)
[ "$CRYPTO_LINK_NAME" != libcrypto.so ] && [ -f "$CRYPTO_LINK_NAME" ] || \
    fail "host-cc-cannot-resolve-libcrypto"
CRYPTO_PROVIDER=$(realpath "$CRYPTO_LINK_NAME")

# Detect a source move during Cargo/TLS compilation before publishing.  A
# manifest that describes only the pre-build tree would otherwise create a
# plausible but stale web artifact.
SOURCE_TREE_AFTER=$(runtime_source_tree_sha256)
[ "$SOURCE_TREE_BEFORE" = "$SOURCE_TREE_AFTER" ] || fail "runtime-source-tree-changed-during-build"
HEAD_AFTER=$(git rev-parse HEAD)
[ "$HEAD_REVISION" = "$HEAD_AFTER" ] || fail "git-head-changed-during-build"

# Keep the capsule self-contained: the final runtime path is the capsule's
# cargo target, while the supplement and receipt live beside it.
mkdir -p "$TMP_DIR/capsule"
mv "$CARGO_TARGET_DIR" "$TMP_DIR/capsule/cargo-target"
mv "$TLS_OBJECT" "$TMP_DIR/capsule/runtime_tls_hosted.o"
RUNTIME_ARCHIVE="$TMP_DIR/capsule/cargo-target/bootstrap/libsimple_runtime.a"
TLS_OBJECT="$TMP_DIR/capsule/runtime_tls_hosted.o"

OUTPUT_REL=${FINAL_DIR#"$ROOT_DIR/"}
ARCHIVE_REL="$OUTPUT_REL/cargo-target/bootstrap/libsimple_runtime.a"
TLS_OBJECT_REL="$OUTPUT_REL/runtime_tls_hosted.o"

MANIFEST="$TMP_DIR/capsule/capsule.manifest"
{
    echo "schema=simple-host-gpu-runtime-capsule-v1"
    echo "status=pass"
    echo "head_revision=$HEAD_REVISION"
    echo "producer=scripts/check/build-host-gpu-runtime-capsule.shs"
    echo "producer_script_sha256=$(hash_file scripts/check/build-host-gpu-runtime-capsule.shs)"
    echo "runtime_source_tree_sha256=$SOURCE_TREE_BEFORE"
    echo "archive=$ARCHIVE_REL"
    echo "archive_sha256=$(hash_file "$RUNTIME_ARCHIVE")"
    echo "runtime_features=vulkan,cuda"
    echo "cargo_lock_sha256=$(hash_file src/compiler_rust/Cargo.lock)"
    echo "tls_provider_source=src/runtime/runtime_tls_hosted.c"
    echo "tls_provider_source_sha256=$(hash_file "$TLS_SOURCE")"
    echo "tls_provider_object=$TLS_OBJECT_REL"
    echo "tls_provider_object_sha256=$(hash_file "$TLS_OBJECT")"
    echo "tls_compile_flags=-std=gnu11 -O2 -ffunction-sections -fdata-sections"
    echo "tls_symbols=rt_byte_char,rt_rsa_decrypt,rt_wire_to_hex,rt_hex_to_wire,rt_random_i64"
    echo "tls_symbol_owner=runtime_tls_hosted.o"
    echo "gpu_symbol_owner=libsimple_runtime.a"
    echo "gpu_archive_symbols=rt_cuda_available,rt_cuda_device_count,rt_cuda_init,rt_cuda_launch_kernel,rt_vulkan_provider_is_available,rt_vulkan_provider_device_count,rt_vulkan_init,rt_vulkan_compile_spirv_raw,rt_vulkan_create_compute_pipeline"
    echo "crypto_provider=$CRYPTO_PROVIDER"
    echo "crypto_provider_sha256=$(hash_file "$CRYPTO_PROVIDER")"
    echo "host_cc=$(command -v "$HOST_CC")"
    echo "host_cc_sha256=$(hash_file "$(command -v "$HOST_CC")")"
    echo "host_nm=$(command -v "$HOST_NM")"
    echo "host_nm_sha256=$(hash_file "$(command -v "$HOST_NM")")"
} >"$MANIFEST"

# The destination was checked before the build; repeat the check immediately
# before rename so a concurrent producer cannot turn this into a nested move.
[ ! -e "$FINAL_DIR" ] && [ ! -L "$FINAL_DIR" ] || fail "output-created-during-build:$FINAL_DIR"
mv "$TMP_DIR/capsule" "$FINAL_DIR"
trap - EXIT HUP INT TERM

echo "host_gpu_runtime_capsule_status=pass"
echo "host_gpu_runtime_capsule_dir=$FINAL_DIR"
echo "host_gpu_runtime_capsule_runtime_path=$FINAL_DIR/cargo-target/bootstrap"
echo "host_gpu_runtime_capsule_archive=$FINAL_DIR/cargo-target/bootstrap/libsimple_runtime.a"
echo "host_gpu_runtime_capsule_tls_object=$FINAL_DIR/runtime_tls_hosted.o"
echo "host_gpu_runtime_capsule_manifest=$FINAL_DIR/capsule.manifest"
echo "host_gpu_runtime_capsule_runtime_source_tree_sha256=$SOURCE_TREE_BEFORE"
echo "host_gpu_runtime_capsule_archive_sha256=$(hash_file "$FINAL_DIR/cargo-target/bootstrap/libsimple_runtime.a")"
