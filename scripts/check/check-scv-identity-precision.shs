#!/bin/sh
# check-scv-identity-precision.shs — SCV-IMPL-I-05 confidence calibration gate.
#
# Runs the curated rename/move/extract corpus (test/fixtures/scv_identity_corpus,
# one dir per case: old/<rel>, new/<rel>, truth.sdn) through the landed I-04
# matcher (std.scv.refactoring_relations) via the I-05 oracle
# (std.scv.entity_graph.scv_corpus_evaluate) and gates auto-accepted relation
# precision at >= 99.5% (accepted-correct / accepted-total, milli-x100 integer
# math — never floats). Classes reported: Explicit / Verified-high / Inferred /
# Unresolved. An accepted row over ambiguous ground truth is a hard FAIL
# regardless of precision (ambiguity is never silently accepted).
#
# Bounds are enforced by the oracle itself: < 30 or > 200 cases is ERROR, and
# 0 accepted rows is ERROR (non-vacuity) — a shrunken corpus cannot pass.
#
# Verdict is ALWAYS the last stdout line:
#   PASS — precision <p>/100000 >= 99500/100000 ...   exit 0
#   FAIL — ...                                        exit 1
#   ERROR — nothing was checked (...)                 exit 2
#
# --selftest (runs before every scan, fatal): a copy of the corpus with one
# deliberately wrong truth label must FAIL with a lower precision, proving the
# gate discriminates and is not tuned-to-pass.
set -u
cd "$(dirname "$0")/../.." || { echo "ERROR — nothing was checked (cannot cd to repo root)"; exit 2; }
CORPUS="test/fixtures/scv_identity_corpus"
DRV="${TMPDIR:-/tmp}/scv-identity-precision.$$.spl"
OUT="${TMPDIR:-/tmp}/scv-identity-precision.$$.out"
trap 'rm -f "$DRV" "$OUT"; rm -rf "${SELF_CORPUS:-}"' EXIT

run_oracle() {
  # $1 = corpus root. Prints the oracle record; returns oracle-implied rc.
  cat > "$DRV" <<EOF
use std.scv.entity_graph.{scv_corpus_evaluate}
fn main() -> i64:
    print(scv_corpus_evaluate("$1"))
    0
EOF
  SIMPLE_TIMEOUT_SECONDS=900 bin/simple run "$DRV" > "$OUT" 2>&1
  rc=$?
  # Print the oracle record only (from its header on), dropping compile noise.
  awk '/^identity_precision:|^ERROR — nothing was checked/{seen=1} seen{print}' "$OUT"
  [ "$rc" -eq 0 ] || return 2
  return 0
}

# --- selftest (always, fatal) ------------------------------------------------
SELF_CORPUS="${TMPDIR:-/tmp}/scv-identity-precision-selftest.$$"
rm -rf "$SELF_CORPUS"
cp -r "$CORPUS" "$SELF_CORPUS" 2>/dev/null || { echo "ERROR — nothing was checked (corpus missing: $CORPUS)"; exit 2; }
WRONG=$(find "$SELF_CORPUS" -path "*rename*" -name truth.sdn | sort | head -1)
[ -n "$WRONG" ] || { echo "ERROR — nothing was checked (selftest: no truth.sdn in corpus)"; exit 2; }
# Poison one accept row: the matcher's (still-correct) accepted output no
# longer matches ground truth, so precision must drop below the gate.
sed -i 's/^accept|/accept|POISONED_/' "$WRONG"
SELF_REPORT=$(run_oracle "$SELF_CORPUS")
SELF_LAST=$(printf '%s\n' "$SELF_REPORT" | tail -1)
case "$SELF_LAST" in
  FAIL*precision*) : ;;
  *) echo "$SELF_REPORT"; echo "ERROR — nothing was checked (selftest: poisoned corpus did not FAIL: $SELF_LAST)"; exit 2 ;;
esac

if [ "${1:-}" = "--selftest" ]; then
  echo "PASS — selftest: poisoned corpus FAILed as required ($SELF_LAST)"
  exit 0
fi

# --- real scan ---------------------------------------------------------------
REPORT=$(run_oracle "$CORPUS")
orc=$?
echo "$REPORT"
LAST=$(printf '%s\n' "$REPORT" | tail -1)
if [ "$orc" -ne 0 ]; then
  echo "ERROR — nothing was checked (oracle driver failed, rc=$orc)"
  exit 2
fi
case "$LAST" in
  PASS*) exit 0 ;;
  FAIL*) exit 1 ;;
  *) exit 2 ;;
esac
