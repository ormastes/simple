#!/bin/sh
# Refuse code that references things which do not exist anywhere in the tree.
#
# Two real incidents on main, both landed by a "sync" commit that resurrected
# reverted code without the module that supported it, and both invisible to
# every existing check until a full bootstrap blew up:
#
#   1. src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl called
#      self.register_glob_imported_symbols_depth(...) -- a method DEFINED
#      NOWHERE in the repo -- on the hot path for every glob import.
#      Repaired in commit 4283bb222893.
#   2. The same file plus src/compiler/80.driver/driver.spl imported
#      compiler.hir.hir_lowering.module_registry.{hir_registry_reset, ...}
#      AFTER module_registry.spl had been deleted. Repaired in 24ebf39ffcdc.
#
# What this checks, over tracked .spl files under src/ (vendored trees excluded
# per CLAUDE.md "Owned-Code Scope"):
#
#   [1] MODULE  -- `use a.b.c.{...}` / `use a.b.c.*` naming a module that no
#                  file plausibly provides.
#   [2] METHOD  -- `self.foo(...)` where neither `me foo` nor `fn foo` is
#                  defined in ANY src file.
#   [3] SYMBOL  -- `use mod.{A, B}` where A/B are declared by no file at all.
#
# ---------------------------------------------------------------------------
# HEURISTICS -- deliberately lossy, tuned to prefer FALSE NEGATIVES.
# A noisy checker gets ignored, and an ignored checker catches nothing.
# ---------------------------------------------------------------------------
#
# * LAST-TWO-SEGMENT module matching. This repo has symlinked tier directories
#   (src/compiler/hir -> 20.hir, frontend -> 10.frontend, std -> lib, ...) and
#   several legal spellings for the same module, so an exact path cannot be
#   derived from a dotted name. Instead every real file contributes the keys
#   "<basename>" and "<parent-dir>.<basename>" (numeric tier prefixes stripped,
#   `mod.spl` folded onto its directory, `_Items`-style split dirs registered
#   both ways). A `use` is accepted when the LAST TWO dotted segments of its
#   module path hit a known key, OR -- because tier aliases such as `std.io`
#   never spell their real parent directory (`src/lib/gc_sync_mut/io.spl`) --
#   when the FINAL segment alone matches a known module basename.
#   Consequence: a module moved between parents is NOT flagged, and neither is
#   one whose basename is reused elsewhere. Intentional: the failure mode we
#   care about is a module that exists nowhere at all.
#
# * Only brace (`.{`) and glob (`.*`) forms have their module path checked.
#   In a bare `use a.b.c` the trailing segment may be a module OR an imported
#   symbol; the boundary is unknowable from the text, so those are skipped.
#
# * Relative imports (`use .sibling.{...}`) resolve against the importing file,
#   not the tree, so their module path is not checked (their item list is).
#
# * A `self.foo(...)` or a braced name is flagged only when its definition count
#   tree-wide is exactly ZERO. Anything defined even once anywhere -- in another
#   module, another tier, behind a trait -- is accepted. Struct field names,
#   enum variants and local bindings count as definitions too, so a
#   closure-valued field invoked as self.field() does not trip [2].
#
# * Aliased imports (`use m.{A as B}`) are not checked at the CALL SITE. They
#   are still indexed as DEFINITIONS when the form is `export use` -- that is
#   the only place the alias B is ever spelled, so without it every consumer of
#   B reported "declared in no src file" (5 false NvfsHostedDriver findings,
#   2026-07-28). A plain `use m.{A as B}` binds B file-locally and does not
#   re-export it, so it contributes no definition.
#
# ---------------------------------------------------------------------------
# NON-VACUITY (2026-08-17). Until this date both scan passes were `xargs | awk`
# whose exit status was never read, so ANY awk failure was laundered into a
# clean verdict: awk's `fatal:` aborts the whole batch, every remaining file in
# it went unscanned, `viol.txt` came back empty and the script printed
# `OK -- no dangling references` and exited 0. Reproduced with a real dangling
# reference present: a single unreadable tracked .spl file (the exact shape a
# concurrent jj checkout produces) turned `FAIL -- 1 dangling reference(s)`
# (exit 1) into `OK` (exit 0). Now: both passes have their status read on the
# line AFTER the command (never through a pipe -- a pipeline's $? is the last
# stage's), pass 2 counts the files awk actually opened and requires that count
# to equal the target count, and the verdict states the count so a run that
# scanned nothing cannot be mistaken for a clean one. `--selftest` runs three
# fixtures (clean must-PASS, dangling must-FAIL, unreadable-file must-ERROR)
# and is fatal.
#
# Usage: check-dangling-references.shs [--quiet] [--path FILE|DIR]...
#   --quiet    print only the final verdict line
#   --path P   check P instead of the default tracked-src set; repeatable.
#              Definitions are still indexed from the whole tree, so this can
#              be pointed at a scratch copy of a historical blob.
#   --selftest run the fixture self-check only, then exit
# Verdict (always the last line of stdout):
#   PASS -- <n> file(s) checked, 0 dangling references     exit 0
#   FAIL -- <n> dangling reference(s) in <m> file(s)       exit 1
#   ERROR -- nothing was checked: <why>                    exit 2
# A run that scanned 0 files is ERROR, never a pass.

set -u

quiet=0
targets=""
have_targets=0
selftest_only=0

self_path=$(cd -- "$(dirname -- "$0")" && pwd -P)/$(basename -- "$0")

# --------------------------------------------------------------------------
# Self-check. Three fixture repos, each a throwaway git repo scanned by THIS
# script through its normal entry point, so neutering any branch above turns
# the selftest red.
#   1. clean tree                -> must PASS, exit 0, count > 0
#   2. one dangling self.method  -> must FAIL, exit 1
#   3. fixture 2 plus ONE unreadable tracked .spl (the incident replay)
#                                -> must ERROR, exit 2 (never PASS)
# --------------------------------------------------------------------------
selftest_repo() {
    _st_dir=$1
    mkdir -p "$_st_dir/src/lib"
    ( cd "$_st_dir" \
      && git init -q . \
      && git config user.email selftest@invalid \
      && git config user.name selftest ) >/dev/null 2>&1 || return 1
    printf 'fn alpha():\n    pass\n' > "$_st_dir/src/lib/alpha.spl"
    printf 'fn beta():\n    pass\n' > "$_st_dir/src/lib/beta.spl"
    printf 'fn gamma():\n    pass\n' > "$_st_dir/src/lib/gamma.spl"
    ( cd "$_st_dir" && git add -A && git commit -qm fixture ) >/dev/null 2>&1
}

run_selftest() {
    _st_fail=0
    _st_root=$(mktemp -d) || { echo "ERROR -- nothing was checked: selftest mktemp failed"; return 2; }

    # Fixture 1 -- clean.
    selftest_repo "$_st_root/clean" || { echo "selftest: cannot build fixture 1" >&2; rm -rf "$_st_root"; return 2; }
    _st_out=$( cd "$_st_root/clean" && DANGLING_REF_SELFTEST_CHILD=1 sh "$self_path" --quiet 2>/dev/null )
    _st_rc=$?
    case "$_st_rc:$_st_out" in
        0:*PASS\ --\ [1-9]*) : ;;
        *) echo "selftest: FIXTURE 1 (clean) expected exit 0 and a PASS with a nonzero count, got rc=$_st_rc out='$_st_out'" >&2; _st_fail=$((_st_fail + 1)) ;;
    esac

    # Fixture 2 -- a genuine dangling reference must be reported.
    selftest_repo "$_st_root/dirty" || { echo "selftest: cannot build fixture 2" >&2; rm -rf "$_st_root"; return 2; }
    printf 'fn delta():\n    self.no_such_method_selftest_xyz()\n' > "$_st_root/dirty/src/lib/zzz.spl"
    ( cd "$_st_root/dirty" && git add -A && git commit -qm dirty ) >/dev/null 2>&1
    _st_out=$( cd "$_st_root/dirty" && DANGLING_REF_SELFTEST_CHILD=1 sh "$self_path" --quiet 2>/dev/null )
    _st_rc=$?
    case "$_st_rc:$_st_out" in
        1:*FAIL\ --*) : ;;
        *) echo "selftest: FIXTURE 2 (dangling) expected exit 1 and a FAIL verdict, got rc=$_st_rc out='$_st_out'" >&2; _st_fail=$((_st_fail + 1)) ;;
    esac

    # Fixture 3 -- incident replay: the same dangling reference, plus one
    # tracked file awk cannot open. Before 2026-08-17 this printed OK/exit 0.
    selftest_repo "$_st_root/poison" || { echo "selftest: cannot build fixture 3" >&2; rm -rf "$_st_root"; return 2; }
    printf 'fn delta():\n    self.no_such_method_selftest_xyz()\n' > "$_st_root/poison/src/lib/zzz.spl"
    ( cd "$_st_root/poison" && git add -A && git commit -qm dirty ) >/dev/null 2>&1
    chmod 000 "$_st_root/poison/src/lib/beta.spl"
    if [ -r "$_st_root/poison/src/lib/beta.spl" ]; then
        # Running as root (or on a filesystem ignoring the mode): the fixture
        # cannot be constructed, so the incident cannot be replayed. Absence of
        # evidence is not a pass.
        chmod 644 "$_st_root/poison/src/lib/beta.spl"
        rm -rf "$_st_root"
        echo "ERROR -- nothing was checked: selftest cannot build the unreadable-file fixture (running as uid $(id -u)?)"
        return 2
    fi
    _st_out=$( cd "$_st_root/poison" && DANGLING_REF_SELFTEST_CHILD=1 sh "$self_path" --quiet 2>/dev/null )
    _st_rc=$?
    chmod 644 "$_st_root/poison/src/lib/beta.spl"
    case "$_st_rc:$_st_out" in
        2:*ERROR\ --*) : ;;
        *) echo "selftest: FIXTURE 3 (unreadable file) expected exit 2 and an ERROR verdict, got rc=$_st_rc out='$_st_out'" >&2; _st_fail=$((_st_fail + 1)) ;;
    esac

    rm -rf "$_st_root"
    if [ "$_st_fail" -ne 0 ]; then
        echo "ERROR -- nothing was checked: selftest failed with $_st_fail fixture failure(s)"
        return 2
    fi
    return 0
}

while [ $# -gt 0 ]; do
    case "$1" in
        --quiet|-q) quiet=1 ;;
        --selftest) selftest_only=1 ;;
        --path)
            shift
            [ $# -gt 0 ] || { echo "check-dangling-references: --path needs an argument" >&2; exit 2; }
            targets="$targets
$1"
            have_targets=1
            ;;
        --path=*)
            targets="$targets
${1#--path=}"
            have_targets=1
            ;;
        -h|--help) sed -n '2,90p' "$0"; exit 0 ;;
        *) echo "check-dangling-references: unknown argument: $1" >&2; exit 2 ;;
    esac
    shift
done

# The selftest re-enters this script, so the recursive children skip it.
if [ "${DANGLING_REF_SELFTEST_CHILD:-0}" != 1 ]; then
    run_selftest || exit 2
fi
[ "$selftest_only" -eq 1 ] && { echo "check-dangling-references: selftest 3/3 fixtures correct"; exit 0; }

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "check-dangling-references: ERROR -- nothing was checked: not inside a git repository"
    exit 2
}
cd "$repo_root" || exit 2

tmp=$(mktemp -d) || exit 2
trap 'rm -rf "$tmp"' EXIT INT TERM

# Vendored / third-party trees are not owned code (CLAUDE.md "Owned-Code Scope").
git ls-files -- 'src/*.spl' 2>/dev/null \
    | grep -v '^src/compiler_rust/vendor/' \
    | grep -v '^src/runtime/vendor/' \
    > "$tmp/all.txt"

if [ ! -s "$tmp/all.txt" ]; then
    echo "check-dangling-references: ERROR -- nothing was checked: no tracked src/**/*.spl files found"
    exit 2
fi

# Index the WORKING COPY, not the git index: a file deleted locally must stop
# providing definitions -- that deletion is exactly incident 2. But if a large
# fraction is absent, the tree is being rewritten underneath us by a parallel
# jj checkout / sync, and indexing it would invent thousands of fake dangling
# references. Refuse rather than lie.
tracked=$(wc -l < "$tmp/all.txt" | tr -d ' ')
while IFS= read -r f; do
    [ -f "$f" ] && printf '%s\n' "$f"
done < "$tmp/all.txt" > "$tmp/present.txt"
present=$(wc -l < "$tmp/present.txt" | tr -d ' ')
missing=$((tracked - present))
if [ "$present" -eq 0 ] || [ $((missing * 10)) -gt "$tracked" ]; then
    echo "check-dangling-references: ERROR -- nothing was checked: $missing of $tracked tracked src files absent from the working copy -- refusing to index a partial tree"
    exit 2
fi
mv "$tmp/present.txt" "$tmp/all.txt"

if [ "$have_targets" -eq 1 ]; then
    : > "$tmp/targets.txt"
    printf '%s\n' "$targets" | grep -v '^[ 	]*$' > "$tmp/raw_targets.txt"
    while IFS= read -r p; do
        if [ -d "$p" ]; then
            find "$p" -name '*.spl' -type f >> "$tmp/targets.txt"
        elif [ -f "$p" ]; then
            printf '%s\n' "$p" >> "$tmp/targets.txt"
        else
            echo "check-dangling-references: ERROR -- nothing was checked: no such path: $p"
            exit 2
        fi
    done < "$tmp/raw_targets.txt"
else
    cp "$tmp/all.txt" "$tmp/targets.txt"
fi

if [ ! -s "$tmp/targets.txt" ]; then
    echo "check-dangling-references: ERROR -- nothing was checked: target set resolved to 0 files"
    exit 2
fi

# --------------------------------------------------------------------------
# Pass 1 -- index every module key and every declared name in the whole tree.
# Streamed through xargs so the file list never has to fit in ARG_MAX, and so
# awk reads each file exactly once.
# --------------------------------------------------------------------------
cat > "$tmp/index.awk" <<'INDEX_AWK'
function norm(s) { sub(/^[0-9]+\./, "", s); return s }
# Module keys are tagged with the file that contributes them (tab-separated)
# so pass 2 can tell whether a key's only provider is the importing file
# itself -- see the final-segment-fallback exclusion in known_module().
function emit_mod(k,   kk) {
    kk = k SUBSEP FILENAME
    if (!(kk in seen_m)) { seen_m[kk] = 1; print "M " k "\t" FILENAME }
}
function emit_def(n) { if (!(n in seen_d)) { seen_d[n] = 1; print "D " n } }
function emit_fn(n,   i, a, cnt, s) {
    if (!(n in seen_f)) { seen_f[n] = 1; print "F " n }
    # Methods are frequently declared type-prefixed at module scope --
    # `me copypropagation_propagate_operand(self: CopyPropagation, ...)` is
    # invoked as self.propagate_operand(...). Register every underscore
    # suffix so the call site resolves.
    cnt = split(n, a, "_")
    s = ""
    for (i = cnt; i >= 2; i--) {
        s = (s == "") ? a[i] : a[i] "_" s
        if (!(s in seen_f)) { seen_f[s] = 1; print "F " s }
    }
}
BEGIN {
    split("pub export static me fn async extern unsafe inline override virtual mut pure gen open final abstract", mk, " ")
    for (i in mk) modkw[mk[i]] = 1
    split("struct enum class trait mixin actor interface impl type const effect union module namespace", tk, " ")
    for (i in tk) typekw[tk[i]] = 1
    split("val var let", bk, " ")
    for (i in bk) bindkw[bk[i]] = 1
}
function decl_name(line,   cnt, w, i, saw_fn, t) {
    # Walk leading modifier keywords; the first non-modifier word is the name.
    # Handles `fn f`, `me f`, `me fn f`, `pub static fn f`, `export fn f`.
    gsub(/^[ \t]+/, "", line)
    cnt = split(line, w, /[ \t]+/)
    saw_fn = 0
    for (i = 1; i <= cnt; i++) {
        t = w[i]
        if (t == "fn" || t == "me") { saw_fn = 1; continue }
        if (t in modkw) continue
        break
    }
    if (!saw_fn || i > cnt) return ""
    t = w[i]
    sub(/[^A-Za-z0-9_].*$/, "", t)
    if (t !~ /^[A-Za-z_][A-Za-z0-9_]*$/) return ""
    return t
}
FNR == 1 {
    in_export_use = 0
    in_type_block = 0
    type_indent = -1
    p = FILENAME
    sub(/\.spl$/, "", p)
    n = split(p, seg, "/")
    for (i = 1; i <= n; i++) seg[i] = norm(seg[i])
    base = seg[n]
    emit_mod(base)
    if (n >= 2) {
        # Any directory holding .spl files is itself a module namespace
        # (dir/mod.spl, dir/__init__.spl, or plain dir-of-modules).
        emit_mod(seg[n-1])
        emit_mod(seg[n-1] "." base)
        if (n >= 3) emit_mod(seg[n-2] "." seg[n-1])
        d = seg[n-1]
        if (substr(d, 1, 1) == "_") {
            emit_mod(substr(d, 2) "." base)
            if (n >= 3) emit_mod(seg[n-2] "." base)
        }
    }
}
{
    line = $0
    # Track whether we are inside a type BODY (struct/class/enum/... fields
    # and variants). The indented-bare-name rule at the bottom of this block
    # is only sound there; applied to a function body it reads an indented
    # CALL as a declaration, so a function that exists nowhere defines itself
    # away and the check goes silently fail-open for it. Dedent to at or past
    # the type's own indent ends the body.
    if (line ~ /[^ \t]/) {
        cur_ind = match(line, /[^ \t]/) - 1
        if (in_type_block && cur_ind <= type_indent) in_type_block = 0
    }
    # `export use m.{A as B}` DEFINES B here: the re-exporting file is the only
    # place B is ever spelled, so without this every consumer of B is reported
    # "declared in no src file". Only the `export` form re-exports (the parser
    # records a re-export surface for `export use` alone -- see
    # 10.frontend/core/parser_decls_use.spl:_export_record_reexport_surface), so
    # a plain `use m.{A as B}` -- a file-local binding -- contributes nothing.
    if (in_export_use || line ~ /^[ \t]*export[ \t]+use[ \t]/) {
        if (line ~ /^[ \t]*export[ \t]+use[ \t]/)
            in_export_use = (line ~ /\{/ && line !~ /\}/)
        else if (line ~ /\}/)
            in_export_use = 0
        al = line
        while (match(al, /[A-Za-z_][A-Za-z0-9_]*[ \t]+as[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) {
            aseg = substr(al, RSTART, RLENGTH)
            al = substr(al, RSTART + RLENGTH)
            acnt = split(aseg, aw, /[ \t]+/)
            emit_def(aw[acnt])
        }
    }
    if (line ~ /^[ \t]*([a-z]+[ \t]+)*(fn|me)[ \t]/) {
        nm = decl_name(line)
        # A method body is not a field list -- leave any enclosing type body.
        if (nm != "") { in_type_block = 0; emit_fn(nm); emit_def(nm); next }
    }
    # `extern` and `abstract` are real declaration modifiers here -- 20 and 2
    # uses in src respectively. Omitting them made every `extern class X`
    # invisible to the index, so consumers of X were reported "declared in no
    # src file" when X is declared and the actual defect (if any) lies in
    # linking, not in the declaration. Deliberately NOT a generic [a-z]+
    # prefix: that matches prose in comments and docstrings.
    if (match(line, /^[ \t]*(pub[ \t]+)?(export[ \t]+)?(extern[ \t]+)?(abstract[ \t]+)?(struct|enum|class|trait|mixin|actor|interface|impl|type|const|effect|union|module|namespace)[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) {
        s = substr(line, RSTART, RLENGTH)
        cnt = split(s, w, /[ \t]+/)
        emit_def(w[cnt])
        in_type_block = 1
        type_indent = cur_ind
        next
    }
    if (match(line, /^[ \t]*(pub[ \t]+)?(export[ \t]+)?(val|var|let)[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) {
        s = substr(line, RSTART, RLENGTH)
        cnt = split(s, w, /[ \t]+/)
        emit_def(w[cnt])
        next
    }
    # Indented bare names: struct/class fields and enum variants. Counted as
    # definitions so closure-valued fields and imported variants stay quiet.
    # Restricted to an actual type body -- see the in_type_block note above.
    if (in_type_block && match(line, /^[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*[:(]/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/^[ \t]+/, "", s)
        sub(/[ \t]*[:(]$/, "", s)
        emit_def(s)
    }
}
INDEX_AWK

# Status is read on the line AFTER the command, never through a pipe: a
# pipeline's $? is `sort`'s, which is 0 even when every awk in the batch died.
xargs -a "$tmp/all.txt" -d '\n' awk -f "$tmp/index.awk" > "$tmp/index.raw"
index_rc=$?
if [ "$index_rc" -ne 0 ]; then
    echo "check-dangling-references: ERROR -- nothing was checked: index pass exited $index_rc (awk could not read part of the tree); the definition index would be incomplete and every finding unsound"
    exit 2
fi
sort -u "$tmp/index.raw" > "$tmp/index.txt"

if [ ! -s "$tmp/index.txt" ]; then
    echo "check-dangling-references: indexing produced nothing" >&2
    exit 2
fi

# --------------------------------------------------------------------------
# Pass 2 -- check the target files against the index.
# --------------------------------------------------------------------------
cat > "$tmp/check.awk" <<'CHECK_AWK'
BEGIN {
    while ((getline l < idx) > 0) {
        k = substr(l, 1, 1); v = substr(l, 3)
        if (k == "M") {
            ti = index(v, "\t")
            mkey = substr(v, 1, ti - 1)
            mfile = substr(v, ti + 1)
            mods[mkey] = 1
            # Track providers per key so the final-segment fallback (below,
            # in known_module) can require a provider OTHER than the
            # importing file itself -- a module must not be "found" only
            # because it shares a basename with the file doing the `use`.
            if ((mkey in mod_file) && mod_file[mkey] != mfile) mod_multi[mkey] = 1
            else mod_file[mkey] = mfile
        }
        else if (k == "D") defs[v] = 1
        else if (k == "F") fns[v] = 1
    }
    close(idx)
    SQ = sprintf("%c", 39)
    # `self.<field>_<op>(...)` is an established idiom here for reaching a
    # collection-typed field without a chained call on an erased receiver
    # (self.scopes_get(k), self.errors_is_empty(e), self.roots_remove(r)).
    # Accept those when <field> is a declared name and <op> is a container op.
    split("get set put push pop len length contains remove insert delete keys values " \
          "is_empty last first slice reverse clear add append has at count size iter " \
          "sort find index_of join clone copy to_f64 to_i64 to_text to_string extend " \
          "take drop peek front back empty fill map filter each next update merge",
          ops, " ")
    for (o in ops) container_op[ops[o]] = 1
}
function method_known(nm,   i, a, cnt, pre, suf, j) {
    if (nm in fns) return 1
    if (nm in defs) return 1
    cnt = split(nm, a, "_")
    for (i = 1; i < cnt; i++) {
        pre = a[1]
        for (j = 2; j <= i; j++) pre = pre "_" a[j]
        suf = a[i+1]
        for (j = i+2; j <= cnt; j++) suf = suf "_" a[j]
        if ((suf in container_op) && (pre in defs)) return 1
    }
    return 0
}
function strip_comment(s,   i, c, q) {
    q = ""
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (q != "") { if (c == "\\") i++; else if (c == q) q = "" }
        else if (c == "\"" || c == SQ) q = c
        else if (c == "#") return substr(s, 1, i - 1)
    }
    return s
}
function known_module(m, importer,   n, a, k) {
    n = split(m, a, ".")
    if (n == 0) return 1
    if (a[n] in mods) {                              # final segment alone
        # Exclude the importing file from the provider set for this match:
        # otherwise a file named X.spl that (wrongly) imports a nonexistent
        # module ending in ".X" is accepted only because X.spl itself
        # contributes the key "X" to the index.
        if ((a[n] in mod_multi) || mod_file[a[n]] != importer) return 1
    }
    if (n >= 2) { k = a[n-1] "." a[n]; if (k in mods) return 1 }
    return 0
}
function report(f, ln, msg) { printf "%s:%d: %s\n", f, ln, msg }
function check_items(blob, f, ln,   n, a, i, t) {
    gsub(/[{}]/, " ", blob)
    n = split(blob, a, ",")
    for (i = 1; i <= n; i++) {
        t = a[i]
        gsub(/^[ \t]+/, "", t); gsub(/[ \t]+$/, "", t)
        if (t == "" || t == "*" || t == "self") continue
        if (t ~ /[ \t]/) continue          # aliased (`A as B`) -- skipped by design
        if (t !~ /^[A-Za-z_][A-Za-z0-9_]*$/) continue
        # `Type__method` is the exported spelling of a static/associated
        # function (Atom__new for `static fn new` in class Atom). Accept when
        # both halves are declared.
        if (index(t, "__") > 1) {
            split(t, dd, "__")
            if ((dd[1] in defs) && (dd[2] in defs)) continue
        }
        if (!(t in defs))
            report(f, ln, "SYMBOL: imported name `" t "` is declared in no src file")
    }
}
FNR == 1 { scanned++; pend = 0; buf = ""; bufln = 0; indoc = 0 }
# Docstrings routinely contain ```simple fenced examples whose `use` lines are
# illustrative, not real imports. Skip everything inside a triple-quoted block.
{
    dq = $0
    nq = gsub(/"""/, "", dq)
    if (indoc) { if (nq % 2 == 1) indoc = 0; next }
    if (nq % 2 == 1) { indoc = 1; next }
}
{
    line = (index($0, "#") > 0) ? strip_comment($0) : $0

    if (pend) {                                    # multi-line `use m.{` list
        buf = buf " " line
        if (line ~ /\}/) { pend = 0; sub(/\}.*$/, "", buf); check_items(buf, FILENAME, bufln) }
        next
    }

    if (match(line, /^[ \t]*(export[ \t]+)?use[ \t]+[.A-Za-z_][A-Za-z0-9_.]*/)) {
        head = substr(line, RSTART, RLENGTH)
        rest = substr(line, RSTART + RLENGTH)
        cnt = split(head, w, /[ \t]+/)
        raw = w[cnt]
        mod = raw
        sub(/\.+$/, "", mod)

        braced  = (rest ~ /^\{/)
        starred = (rest ~ /^\*/)

        if (substr(raw, 1, 1) != "." && (braced || starred)) {
            if (mod != "" && !known_module(mod, FILENAME))
                report(FILENAME, FNR, "MODULE: `use " mod "` -- no src file provides this module")
        }

        if (braced) {
            if (line ~ /\}/) {
                items = line
                sub(/^[^{]*\{/, "", items)
                sub(/\}.*$/, "", items)
                check_items(items, FILENAME, FNR)
            } else {
                pend = 1; bufln = FNR
                buf = line
                sub(/^[^{]*\{/, "", buf)
            }
        }
        next
    }

    s = line
    while (match(s, /self\.[A-Za-z_][A-Za-z0-9_]*[ \t]*\(/)) {
        tok = substr(s, RSTART, RLENGTH)
        s = substr(s, RSTART + RLENGTH)
        sub(/^self\./, "", tok)
        sub(/[ \t]*\($/, "", tok)
        if (!method_known(tok))
            report(FILENAME, FNR, "METHOD: self." tok "(...) -- no `me " tok "` or `fn " tok "` anywhere in src")
    }
}
END { printf "#SCANNED\t%d\n", scanned + 0 }
CHECK_AWK

# Same rule as pass 1: capture the status on the NEXT line, not through a pipe.
xargs -a "$tmp/targets.txt" -d '\n' \
    awk -v idx="$tmp/index.txt" -f "$tmp/check.awk" > "$tmp/raw.txt"
scan_rc=$?

# xargs may split the target list across several awk invocations, so the
# per-invocation scan counters are summed.
scanned=$(awk -F'\t' '$1 == "#SCANNED" { s += $2 } END { print s + 0 }' "$tmp/raw.txt")
grep -v '^#SCANNED	' "$tmp/raw.txt" > "$tmp/viol.txt" || :
targets_n=$(wc -l < "$tmp/targets.txt" | tr -d ' ')

if [ "$scan_rc" -ne 0 ]; then
    echo "check-dangling-references: ERROR -- nothing was checked: scan pass exited $scan_rc after opening $scanned of $targets_n target file(s); an aborted awk batch leaves its remaining files unscanned, so a clean result would be a lie"
    exit 2
fi

# A 0-byte file produces no records, so awk's per-file counter never fires for
# it even though the file WAS opened and holds nothing to find. Six such files
# exist under src/ (empty 99.loader stubs), so the accounting excludes them
# rather than false-ERRORing on a healthy tree.
empty_n=0
while IFS= read -r f; do
    [ -s "$f" ] || empty_n=$((empty_n + 1))
done < "$tmp/targets.txt"
expected_n=$((targets_n - empty_n))

if [ "$scanned" -ne "$expected_n" ]; then
    echo "check-dangling-references: ERROR -- nothing was checked: scan pass opened $scanned of $expected_n non-empty target file(s) ($targets_n targets, $empty_n empty); an aborted awk batch leaves its remaining files unscanned"
    exit 2
fi

if [ "$scanned" -eq 0 ]; then
    echo "check-dangling-references: ERROR -- nothing was checked: scan pass opened 0 files"
    exit 2
fi

n=$(wc -l < "$tmp/viol.txt" | tr -d ' ')

if [ "$n" -gt 0 ]; then
    [ "$quiet" -eq 1 ] || sort "$tmp/viol.txt" >&2
    echo "check-dangling-references: FAIL -- $n dangling reference(s) in $scanned file(s)"
    exit 1
fi

echo "check-dangling-references: PASS -- $scanned file(s) checked, 0 dangling references"
exit 0
