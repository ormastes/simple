#!/bin/sh
# check-text-len-unit-mix.shs — fail when one function uses byte_len() on a
# receiver AND indexes/slices that same receiver with the `[ ]` operator.
#
# Rule (doc/05_design/language/text/text_len_counts_characters_2026-11-07.md):
# `s[i]` / `s[a..b]` are code-point operators; `byte_len()` / `byte_at` /
# `substring` are the byte family. Mixing them on one receiver is wrong on
# non-ASCII text (and silently so). A byte scan is bounded by byte_len() and
# cut with substring(); a character loop is bounded by len() and indexed s[i].
#
# Usage: sh scripts/check/check-text-len-unit-mix.shs [--selftest] [root ...]
#   default roots: src/lib src/app src/compiler
# Rule 2: another text X that is passed to a byte-family method of a
# byte-scanned receiver (s.starts_with(X), s.index_of(X), s.replace(X, ..))
# is a byte width when it offsets that receiver; `X.len()` in the same
# function is flagged as "(len() as byte width)" — write `X.byte_len()`.
#
# Verdict (last stdout line): PASS — <n> function(s) checked, 0 mixed
#                            FAIL — <n> function(s) checked, <k> mixed: ...
#                            ERROR — nothing was checked
# Exit 0 / 1 / 2. --selftest runs 13 fixtures first and is fatal.
#
# Rule 4 (len()-bounded byte scan, bug
# doc/08_tracking/bug/len_bounded_byte_scanners_non_ascii_2026_11_14.md):
# a function that never calls byte_len() but has a receiver r with both
# r.len() (non-emptiness use) and r.substring(/byte_at(/char_code_at( bounds
# a byte scan in code points and truncates non-ASCII text. Pre-existing hits
# are frozen in scripts/check/text_len_bounded_byte_scan_baseline.txt
# ("file fn recv" rows, ratchet): a hit not in the baseline FAILs, and a
# baseline row that no longer hits is stale and FAILs too.
# --generate-baseline rewrites it (reviewed updates only).

set -u

scan_file() {
  # prints "file:line receiver" for each byte_len() line whose enclosing fn
  # also applies `recv[` ; prints "FNCOUNT <n>" on stderr-free channel last
  awk -v F="$1" '
    function flush(   r, l, x, scanned) {
      scanned = 0
      for (r in bl) {
        scanned = 1
        if ((r) in ix) {
          n = split(bl[r], ls, ",")
          for (l = 1; l <= n; l++) if (ls[l] != "") print F ":" ls[l] " " r
        }
      }
      for (r in bf) scanned = 1
      # Rule 2: another text X whose len() reaches a byte-family call on a
      # byte-scanned receiver -- directly as an argument (s.substring(0,
      # X.len())), through an alias (val w = X.len(); s.substring(0, w)) or
      # on the same line as that receiver byte_len()/byte op -- is a byte
      # width in the wrong unit. Flag every X.len() line in the function.
      if (scanned) {
        for (x in lu) {
          if ((x) in bl) continue
          hit = 0
          if ((x) in argref) hit = 1
          if ((x) in sameline) hit = 1
          for (a in alias) if (alias[a] == x && ((a) in argref)) hit = 1
          if (hit) {
            n = split(lu[x], ls, ",")
            for (l = 1; l <= n; l++) if (ls[l] != "") print F ":" ls[l] " " x " (len() as byte width)"
          }
        }
      }
      # Rule 4: len()-bounded byte scan in a function with no byte_len().
      if (!fnbl) for (r in lb) if ((r) in bop) print "R4 " F " " fname " " r
      delete bl; delete ix; delete bf; delete argref; delete lu; delete alias; delete sameline
      delete lb; delete bop; fnbl = 0
    }
    /^[ \t]*(pub |export )?(fn|me|async fn|async me|static fn) / {
      flush(); fncount++
      fname = $0; sub(/^[ \t]*(pub |export )?(async |static )?(fn|me) +/, "", fname); sub(/[^A-Za-z_0-9].*$/, "", fname)
    }
    /^[ \t]*#/ { next }
    {
      # Docstrings (triple-quoted blocks) are prose, not code.
      q = gsub(/"""/, "\"\"\"")
      if (q % 2 == 1) { in_doc = !in_doc; next }
      if (q > 0) next
      if (in_doc) next
      line = $0
      sub(/#.*$/, "", line)
      if (line ~ /\.byte_len\(\)/) fnbl = 1
      tmp = line
      while (match(tmp, /[A-Za-z_][A-Za-z_0-9]*\.(substring|byte_at|char_code_at)\(/)) {
        r = substr(tmp, RSTART, RLENGTH); sub(/\..*$/, "", r); bop[r] = 1
        tmp = substr(tmp, RSTART + RLENGTH)
      }
      tmp = line
      while (match(tmp, /[A-Za-z_][A-Za-z_0-9]*\.len\(\)/)) {
        r = substr(tmp, RSTART, RLENGTH - 6)
        rest = substr(tmp, RSTART + RLENGTH)
        if (rest !~ /^ *(==|!=|>|<=) *0([^0-9]|$)/) lb[r] = 1
        tmp = rest
      }
      tmp = line
      while (match(tmp, /[A-Za-z_][A-Za-z_0-9]*\.byte_len\(\)/)) {
        r = substr(tmp, RSTART, RLENGTH - 11)
        bl[r] = bl[r] "," NR
        tmp = substr(tmp, RSTART + RLENGTH)
      }
      # Byte-family calls on a receiver, and the identifiers they take as
      # offsets/widths (argref); `val w = X.len()` aliases; X.len() uses.
      bytecall_here = 0
      tmp = line
      while (match(tmp, /[A-Za-z_][A-Za-z_0-9]*\.(byte_len\(\)|byte_at\(|substring\(|slice\(|index_of\(|find\(|starts_with\(|ends_with\(|split\(|replace\(|contains\()/)) {
        mstart = RSTART; mlen = RLENGTH
        seg = substr(tmp, mstart, mlen)
        r = seg; sub(/\..*$/, "", r)
        bf[r] = 1
        if (seg ~ /byte_len\(\)$/) bytecall_here = 1
        args = substr(tmp, mstart + mlen)
        sub(/\).*$/, "", args)
        # Only offset-taking calls make an argument a byte offset/width;
        # starts_with/ends_with/split/replace/contains take whole texts.
        if (seg !~ /\.(substring|slice|byte_at|index_of|find)\($/) args = ""
        while (match(args, /[A-Za-z_][A-Za-z_0-9]*/)) {
          a = substr(args, RSTART, RLENGTH)
          if (a != r && a !~ /^(val|var|if|and|or|not|true|false|nil|as|i64|text)$/) argref[a] = 1
          args = substr(args, RSTART + RLENGTH)
        }
        tmp = substr(tmp, mstart + mlen)
      }
      if (match(line, /(val|var) +[A-Za-z_][A-Za-z_0-9]* *(: *i64)? *= *[A-Za-z_][A-Za-z_0-9]*\.len\(\)/)) {
        decl = substr(line, RSTART, RLENGTH)
        sub(/^(val|var) +/, "", decl)
        aname = decl; sub(/[^A-Za-z_0-9].*$/, "", aname)
        src = decl; sub(/\.len\(\)$/, "", src); sub(/^.*[^A-Za-z_0-9]/, "", src)
        alias[aname] = src
      }
      tmp = line
      while (match(tmp, /[A-Za-z_][A-Za-z_0-9]*\.len\(\)/)) {
        r = substr(tmp, RSTART, RLENGTH - 6)
        lu[r] = lu[r] "," NR
        rest = substr(tmp, RSTART + RLENGTH)
        # An emptiness test (X.len() == 0 / != 0 / > 0) is unit-free.
        if (bytecall_here && rest !~ /^ *(==|!=|>|<=) *0([^0-9]|$)/) sameline[r] = 1
        tmp = substr(tmp, RSTART + RLENGTH)
      }
      # Rule 3: a text LITERAL whose len() sits in a byte-unit expression
      # ("APOLV2-".len() next to value.byte_len()) is the same cross-receiver
      # unit mix; a literal has no receiver name, so report it directly.
      if (bytecall_here) {
        tmp = line
        while (match(tmp, /"[^"]*"\.len\(\)/)) {
          rest = substr(tmp, RSTART + RLENGTH)
          if (rest !~ /^ *(==|!=|>|<=) *0([^0-9]|$)/) print F ":" NR " <literal> (len() as byte width)"
          tmp = rest
        }
      }
      tmp = line
      while (match(tmp, /(^|[^A-Za-z_0-9.])[A-Za-z_][A-Za-z_0-9]*\[/)) {
        seg = substr(tmp, RSTART, RLENGTH)
        sub(/^[^A-Za-z_]/, "", seg)
        r = substr(seg, 1, length(seg) - 1)
        ix[r] = 1
        tmp = substr(tmp, RSTART + RLENGTH)
      }
    }
    END { flush(); printf "FNCOUNT %d\n", fncount }
  ' "$1"
}

# cmp_set HITS BASELINE LABEL — ratchet one hit set against its baseline.
# Restricted to the files in $scope_files when that is non-empty (diff mode).
# Sets cmp_new / cmp_stale and prints the offending rows.
cmp_set() {
  touch "$2" 2>/dev/null
  if [ -n "$scope_files" ]; then
    awk 'NR==FNR{s[$0]=1; next} ($1 in s)' "$scope_files" "$2"
  else
    cat "$2"
  fi | grep . | sort -u > "$tmp_base" || true
  cmp_new=$(comm -23 "$1" "$tmp_base")
  cmp_stale=$(comm -13 "$1" "$tmp_base")
  cmp_nn=$(printf '%s\n' "$cmp_new" | grep -c . || true)
  cmp_ns=$(printf '%s\n' "$cmp_stale" | grep -c . || true)
  [ "$cmp_nn" -gt 0 ] && printf '%s\n' "$cmp_new" | sed "s|\$| (NEW $3)|"
  [ "$cmp_ns" -gt 0 ] && printf '%s\n' "$cmp_stale" | sed 's/$/ (STALE baseline row; remove it)/'
  return 0
}

run_scan() {
  if [ -n "$scope_files" ]; then
    while read -r f; do [ -f "$f" ] && scan_file "$f"; done < "$scope_files"
    echo "FNCOUNT 0"
  else
    for root in "$@"; do
      [ -e "$root" ] || continue
      find "$root" -name '*.spl' -type f | while read -r f; do scan_file "$f"; done
    done
  fi > "$tmp_out"
  total_fn=$(awk '/^FNCOUNT /{s+=$2} END{print s+0}' "$tmp_out")
  # Old-rule hits are "file:line recv ..."; the baseline key drops the line
  # number (it churns on every edit above the site): "file recv ...".
  grep -v -e '^FNCOUNT ' -e '^R4 ' "$tmp_out" | sed 's/^\([^ :]*\):[0-9][0-9]* /\1 /' | sort -u > "$tmp_mix"
  grep '^R4 ' "$tmp_out" | cut -c4- | sort -u > "$tmp_r4"
  k=$(grep -c . "$tmp_mix" || true)
  r4=$(grep -c . "$tmp_r4" || true)
  if [ -n "$scope_files" ]; then
    nf=$(grep -c . "$scope_files" || true)
    [ "$nf" -eq 0 ] && { echo "ERROR — nothing was checked (no .spl file in range)"; return 2; }
  else
    [ "$total_fn" -eq 0 ] && { echo "ERROR — nothing was checked"; return 2; }
  fi
  if [ "$gen_baseline" -eq 1 ]; then
    cp "$tmp_r4" "$baseline"; cp "$tmp_mix" "$mix_baseline"
    echo "baseline: wrote $r4 rule-4 row(s) to $baseline, $k rule-1..3 row(s) to $mix_baseline"
  fi
  cmp_set "$tmp_r4" "$baseline" "len()-bounded byte scan; bound with byte_len()"; n4=$cmp_nn; s4=$cmp_ns
  cmp_set "$tmp_mix" "$mix_baseline" "byte/code-point unit mix"; nm=$cmp_nn; sm=$cmp_ns
  what="$total_fn function(s) checked"
  [ -n "$scope_files" ] && what="$nf touched file(s) checked"
  if [ $((n4 + s4 + nm + sm)) -gt 0 ]; then
    echo "FAIL — $what, $nm new / $sm stale unit-mix row(s), $n4 new / $s4 stale len()-bounded byte scan(s) (see lines above)"
    return 1
  fi
  echo "PASS — $what, $k unit-mix + $r4 len()-bounded row(s) all baselined, 0 new, 0 stale"
  return 0
}

tmp_out=$(mktemp); tmp_r4=$(mktemp); tmp_base=$(mktemp); tmp_mix=$(mktemp); scope_files=""
trap 'rm -f "$tmp_out" "$tmp_r4" "$tmp_base" "$tmp_mix" ${scope_files:+"$scope_files"}; rm -rf "${fx:-}"' EXIT
baseline="${TEXT_LEN_BASELINE:-scripts/check/text_len_bounded_byte_scan_baseline.txt}"
mix_baseline="${TEXT_LEN_MIX_BASELINE:-scripts/check/text_len_unit_mix_baseline.txt}"
gen_baseline=0

selftest() {
  fx=$(mktemp -d)
  mkdir -p "$fx/a" "$fx/b" "$fx/c"
  printf 'fn byte_scan(s: text) -> i64:\n    var i = 0\n    while i < s.byte_len():\n        if s.byte_at(i) == 32: return i\n        i = i + 1\n    s.substring(0, 1)\n    -1\n\nfn chars(s: text) -> i64:\n    var i = 0\n    while i < s.len():\n        if s[i] == '"'"' '"'"': return i\n        i = i + 1\n    -1\n' > "$fx/a/clean.spl"
  printf 'fn mixed(s: text) -> text:\n    var i = 0\n    while i < s.byte_len():\n        if s[i:i + 1] == " ": return s[0:i]\n        i = i + 1\n    s\n' > "$fx/b/mixed.spl"
  printf 'fn other(s: text, arr: [i64]) -> i64:\n    # s[0] in a comment must not count\n    val n = s.byte_len()\n    arr[0] + n\n\nfn has_prefix(s: text, prefix: text) -> bool:\n    if prefix.byte_len() > s.byte_len(): return false\n    s.substring(0, prefix.byte_len()) == prefix\n' > "$fx/c/other_recv.spl"
  mkdir -p "$fx/d"
  printf 'fn has_prefix(s: text, prefix: text) -> bool:\n    val plen = prefix.len()\n    if plen > s.byte_len(): return false\n    s.substring(0, plen) == prefix\n' > "$fx/d/width.spl"
  v=$(run_scan "$fx/a"); rc=$?; [ $rc -eq 0 ] || { echo "selftest: clean fixture must PASS, got rc=$rc: $v"; exit 2; }
  v=$(run_scan "$fx/b"); rc=$?; [ $rc -eq 1 ] || { echo "selftest: mixed fixture must FAIL, got rc=$rc"; exit 2; }
  printf '%s\n' "$v" | grep -q 'mixed.spl s' || { echo "selftest: mixed fixture must name mixed.spl:3 s"; exit 2; }
  v=$(run_scan "$fx/c"); rc=$?; [ $rc -eq 0 ] || { echo "selftest: other-receiver/comment fixture must PASS, got rc=$rc: $v"; exit 2; }
  v=$(run_scan "$fx/d"); rc=$?; [ $rc -eq 1 ] || { echo "selftest: other-text len() as byte width must FAIL, got rc=$rc: $v"; exit 2; }
  printf '%s\n' "$v" | grep -q 'width.spl prefix (len() as byte width)' || { echo "selftest: width fixture must name width.spl:2 prefix"; exit 2; }
  # Cross-receiver comparison/arithmetic: byte_len() of one text vs len() of
  # another (named receiver, dotted receiver, and string literal) must FAIL;
  # the all-byte_len() twin must PASS.
  mkdir -p "$fx/e" "$fx/f"
  printf 'fn cmp(a: text, b: text) -> bool:\n    a.byte_len() != b.len()\n\nfn dotted(a: text, j: Journal) -> bool:\n    a.byte_len() != j.head.len()\n\nfn lit(v: text) -> bool:\n    v.byte_len() == "APOLV2-".len()\n' > "$fx/e/cross.spl"
  printf 'fn cmp(a: text, b: text) -> bool:\n    a.byte_len() != b.byte_len()\n\nfn lit(v: text) -> bool:\n    v.byte_len() == "APOLV2-".byte_len() or v.len() == 0\n' > "$fx/f/cross_ok.spl"
  v=$(run_scan "$fx/e"); rc=$?; [ $rc -eq 1 ] || { echo "selftest: cross-receiver unit mix must FAIL, got rc=$rc: $v"; exit 2; }
  printf '%s\n' "$v" | grep -q 'cross.spl b (len() as byte width)' || { echo "selftest: cross fixture must name cross.spl:2 b"; exit 2; }
  printf '%s\n' "$v" | grep -q 'cross.spl head (len() as byte width)' || { echo "selftest: cross fixture must name cross.spl:5 head"; exit 2; }
  printf '%s\n' "$v" | grep -q 'cross.spl <literal> (len() as byte width)' || { echo "selftest: cross fixture must name cross.spl:8 <literal>"; exit 2; }
  v=$(run_scan "$fx/f"); rc=$?; [ $rc -eq 0 ] || { echo "selftest: all-byte_len() cross twin must PASS, got rc=$rc: $v"; exit 2; }
  v=$(run_scan "$fx/none"); rc=$?; [ $rc -eq 2 ] || { echo "selftest: empty scan must ERROR, got rc=$rc"; exit 2; }
  # Rule 4: a len()-bounded byte scan (no byte_len() anywhere in the fn) is
  # NEW unless baselined; a baselined row that no longer hits is STALE.
  mkdir -p "$fx/g"
  printf 'fn quote_end(s: text) -> i64:\n    var i = 0\n    while i < s.len():\n        if s.substring(i, i + 1) == "q": return i\n        i = i + 1\n    -1\n\nfn ok_scan(s: text) -> i64:\n    if s.len() == 0: return -1\n    var i = 0\n    while i < s.byte_len():\n        if s.byte_at(i) == 113: return i\n        i = i + 1\n    -1\n' > "$fx/g/scan.spl"
  v=$(run_scan "$fx/g"); rc=$?; [ $rc -eq 1 ] || { echo "selftest: len()-bounded byte scan must FAIL as new, got rc=$rc: $v"; exit 2; }
  printf '%s\n' "$v" | grep -q "scan.spl quote_end s (NEW" || { echo "selftest: rule-4 fixture must name quote_end s: $v"; exit 2; }
  printf '%s\n' "$v" | grep -q "ok_scan" && { echo "selftest: byte_len()-bounded twin must not be flagged: $v"; exit 2; }
  printf '%s quote_end s\n' "$fx/g/scan.spl" > "$fx/base_g"
  v=$(baseline="$fx/base_g"; run_scan "$fx/g"); rc=$?; [ $rc -eq 0 ] || { echo "selftest: baselined rule-4 hit must PASS, got rc=$rc: $v"; exit 2; }
  v=$(baseline="$fx/base_g"; run_scan "$fx/a"); rc=$?; [ $rc -eq 1 ] || { echo "selftest: stale baseline row must FAIL, got rc=$rc: $v"; exit 2; }
  printf '%s\n' "$v" | grep -q "quote_end s (STALE" || { echo "selftest: stale row must be named: $v"; exit 2; }
  # Old-rule hits ratchet the same way: a baselined mix PASSes.
  printf '%s s\n' "$fx/b/mixed.spl" > "$fx/base_b"
  v=$(mix_baseline="$fx/base_b"; run_scan "$fx/b"); rc=$?; [ $rc -eq 0 ] || { echo "selftest: baselined unit-mix row must PASS, got rc=$rc: $v"; exit 2; }
  # Diff mode: only touched files are scanned, and only their baseline rows
  # can be stale; a new hit in a touched file still FAILs.
  printf '%s\n' "$fx/a/clean.spl" > "$fx/scope_a"
  v=$(baseline="$fx/base_g"; scope_files="$fx/scope_a"; run_scan); rc=$?; [ $rc -eq 0 ] || { echo "selftest: diff mode must ignore rows of untouched files, got rc=$rc: $v"; exit 2; }
  printf '%s\n' "$fx/g/scan.spl" > "$fx/scope_g"
  v=$(scope_files="$fx/scope_g"; run_scan); rc=$?; [ $rc -eq 1 ] || { echo "selftest: diff mode must FAIL a new hit in a touched file, got rc=$rc: $v"; exit 2; }
  echo "selftest: 13 fixtures OK"
}

do_selftest=0
roots=""
range=""
want_range=0
for a in "$@"; do
  if [ "$want_range" -eq 1 ]; then range="$a"; want_range=0; continue; fi
  case "$a" in
    --selftest) do_selftest=1 ;;
    --generate-baseline) gen_baseline=1 ;;
    --changed) want_range=1 ;;
    *) roots="$roots $a" ;;
  esac
done
if [ "$do_selftest" -eq 1 ]; then
  real_baseline="$baseline"; real_mix="$mix_baseline"
  baseline="$(mktemp)"; mix_baseline="$(mktemp)"
  selftest
  rm -f "$baseline" "$mix_baseline"; baseline="$real_baseline"; mix_baseline="$real_mix"
fi
[ -z "$roots" ] && roots="src/lib src/app src/compiler"
if [ -n "$range" ]; then
  # Diff-scoped mode (push tier): scan only the .spl files the range touches
  # under the roots; a deleted file is kept in scope so its rows go stale.
  case "$range" in *..*) ;; *) echo "ERROR — nothing was checked (--changed needs BASE..HEAD)"; exit 2 ;; esac
  scope_files=$(mktemp)
  # shellcheck disable=SC2086
  git diff --name-only "$range" -- $roots 2>/dev/null | grep '\.spl$' | sort -u > "$scope_files" \
    || { [ -s "$scope_files" ] || { echo "PASS — 0 touched .spl file(s) in $range under $roots; nothing to ratchet"; exit 0; }; }
fi
# shellcheck disable=SC2086
run_scan $roots
