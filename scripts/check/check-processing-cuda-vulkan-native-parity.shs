#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT_DIR"

CUDA_PROBE_BIN=${PROCESSING_PARITY_CUDA_PROBE_BIN:-build/simpleos_gpu_host/cuda_fill_native/processing_cuda_fill_probe}
VULKAN_PROBE_BIN=${PROCESSING_PARITY_VULKAN_PROBE_BIN:-build/simpleos_gpu_host/vulkan_fault_native/processing_vulkan_fault_probe}
TIMEOUT_SECONDS=${PROCESSING_PARITY_TIMEOUT_SECONDS:-30}

PROCESSING_CUDA_FILL_PROBE_BIN="$CUDA_PROBE_BIN" \
PROCESSING_CUDA_FILL_TIMEOUT_SECONDS="$TIMEOUT_SECONDS" \
PROCESSING_CUDA_FILL_MODE=parity \
    sh scripts/check/check-processing-cuda-fill-native.shs

PROCESSING_VULKAN_FAULT_PROBE_BIN="$VULKAN_PROBE_BIN" \
PROCESSING_VULKAN_FAULT_TIMEOUT_SECONDS="$TIMEOUT_SECONDS" \
    sh scripts/check/check-processing-vulkan-fault-native.shs

echo "processing_cuda_vulkan_native_parity_status=pass"
