#!/bin/sh
# check-unsafe-block-native-build.shs
#
# Fail-closed behavioural gate for lexical `unsafe(capabilities: [...]):` under
# NATIVE codegen, in BOTH syntactic forms:
#
#   statement/block form:   unsafe(capabilities: [ffi]):
#                               x = 42
#   expression/value form:  val x = unsafe(capabilities: [ffi]):
#                               41 + 1
#
# WHY THIS GATE IS BEHAVIOURAL, NOT A SOURCE GREP
# -----------------------------------------------
# `unsafe` is a CAPABILITY ASSERTION, not a runtime construct. The capability
# list is compile-time metadata: HIR keeps `HirExprKind::UnsafeBlock` so the
# safety pass (`hir/analysis/unsafe_ffi_checker.rs`) can see it, and MIR then
# ERASES it (`mir/lower/lowering_expr.rs`: `UnsafeBlock(stmts) =>
# self.lower_block_expr(stmts)`). Codegen therefore never sees the node BY
# DESIGN — `grep UnsafeBlock src/compiler_rust/compiler/src/codegen/` returning
# zero lines is the CORRECT state, not a defect. A previous localization read
# that zero as a missing codegen case; see the bug record. So the only honest
# check is to native-build the two forms and RUN the results.
#
# The defect this gate pins (bug: unsafe_expression_import_lowering_2026-08-24)
# is that a regression in the PARSER — losing the value-bound `unsafe(...):`
# header from primary-expression position — degrades the construct into an
# ordinary call to a function named `unsafe` with `ffi` as an argument,
# producing exactly these two signatures:
#
#     error[E1002]: function `unsafe` not found
#     GlobalLoad: unresolved identifier 'ffi'
#
# Both are asserted ABSENT below, in addition to the build+run succeeding, so a
# reintroduction is named explicitly rather than showing up as a generic fail.
#
# Verdict line is ALWAYS the last line of stdout:
#   PASS  — <n> case(s) checked ...        exit 0   (n > 0 always)
#   FAIL  — ...                            exit 1
#   ERROR — nothing was checked (<reason>) exit 2
#
# A run that executed 0 native-builds is ERROR, never a pass. A missing seed
# binary is ERROR, never a pass: absence of a compiler is absence of evidence.
#
# Seed binary resolution (first hit wins):
#   $SIMPLE_SEED_BIN
#   src/compiler_rust/target/release/simple
#   $CARGO_TARGET_DIR/release/simple
# Build one with: cd src/compiler_rust && cargo build --release --bin simple
#
# Usage:
#   sh scripts/check/check-unsafe-block-native-build.shs [--selftest-only]

set -u

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
WORK=$(mktemp -d "${TMPDIR:-/tmp}/unsafe-nb.XXXXXX") || exit 2
trap 'rm -rf "$WORK"' EXIT

EV_CHECKED=0
OFFENDERS=""

# ---------------------------------------------------------------------------
# Fixture writers. Kept as functions so the selftest reuses the exact shapes
# the real scan uses -- a selftest that tested different source would prove
# nothing about the real cases.
# ---------------------------------------------------------------------------

write_expr_form() {
    # Value-bound (expression) unsafe block. Tail value must survive as 42.
    cat > "$1" <<'SPL'
fn get() -> i64:
    val x = unsafe(capabilities: [ffi]):
        41 + 1
    x

fn main():
    print(get())
SPL
}

write_block_form() {
    # Statement unsafe block mutating an outer var. Must print 42.
    cat > "$1" <<'SPL'
fn main():
    var x = 0
    unsafe(capabilities: [ffi]):
        x = 42
    print(x)
SPL
}

write_ordinary_call() {
    # Disambiguation guard: `unsafe(...)` with NO trailing `:` is an ordinary
    # call, and must stay one. If the parser over-triggers on the identifier
    # `unsafe` this fixture stops compiling, which is a real regression.
    cat > "$1" <<'SPL'
fn unsafe(n: i64) -> i64:
    n + 1

fn main():
    print(unsafe(41))
SPL
}

# ---------------------------------------------------------------------------
# Core: native-build a fixture and run it, expecting `want_out` on stdout.
# Exit status is read DIRECTLY into a variable on the line AFTER each command,
# never through a pipe -- a pipeline's $? is the LAST command's status and has
# produced false greens in this repo before.
# ---------------------------------------------------------------------------
run_case() {
    seed=$1; src=$2; want_out=$3; label=$4

    bin="$WORK/$label.bin"
    log="$WORK/$label.log"

    "$seed" native-build "$src" -o "$bin" > "$log" 2>&1
    NB_RC=$?

    if [ "$NB_RC" -ne 0 ]; then
        # Name the two known degradation signatures explicitly when present.
        if grep -qiE "function .unsafe. not found" "$log"; then
            echo "  $label: native-build failed (NB_RC=$NB_RC) -- 'function unsafe not found'"
            OFFENDERS="$OFFENDERS $label(unsafe-not-found)"
        elif grep -qiE "unresolved identifier 'ffi'" "$log"; then
            echo "  $label: native-build failed (NB_RC=$NB_RC) -- unresolved identifier 'ffi'"
            OFFENDERS="$OFFENDERS $label(ffi-unresolved)"
        else
            echo "  $label: native-build failed (NB_RC=$NB_RC)"
            grep -E "^error" "$log" | sort -u | head -3 | sed 's/^/      /'
            OFFENDERS="$OFFENDERS $label(build-rc=$NB_RC)"
        fi
        return 1
    fi

    # Even on a successful build, the degradation signatures must be absent:
    # a JIT failure that silently falls back must not read as a pass.
    if grep -qiE "function .unsafe. not found|unresolved identifier 'ffi'" "$log"; then
        echo "  $label: built, but degradation signature present in build log"
        OFFENDERS="$OFFENDERS $label(signature-present)"
        return 1
    fi

    if [ ! -x "$bin" ]; then
        echo "  $label: native-build reported success but produced no executable"
        OFFENDERS="$OFFENDERS $label(no-binary)"
        return 1
    fi

    got=$("$bin" 2>&1)
    RUN_RC=$?

    if [ "$RUN_RC" -ne 0 ]; then
        echo "  $label: built binary exited non-zero (RUN_RC=$RUN_RC)"
        OFFENDERS="$OFFENDERS $label(run-rc=$RUN_RC)"
        return 1
    fi

    # Value check: proves the unsafe block's tail VALUE survived erasure,
    # not merely that something compiled.
    if [ "$got" != "$want_out" ]; then
        echo "  $label: wrong output -- want [$want_out], got [$got]"
        OFFENDERS="$OFFENDERS $label(output)"
        return 1
    fi

    echo "  $label: OK (NB_RC=0, RUN_RC=0, output [$got])"
    return 0
}

# ---------------------------------------------------------------------------
# SELFTEST -- runs FIRST and is FATAL. Proves the scanner's failure detection
# is live rather than a function that always returns success.
# ---------------------------------------------------------------------------
selftest() {
    st_fail=0

    # Fixture 1: a fake "seed" that always fails a build must be detected.
    fake_fail="$WORK/fake_fail"
    cat > "$fake_fail" <<'SH'
#!/bin/sh
echo "error[E1002]: function \`unsafe\` not found"
exit 1
SH
    chmod +x "$fake_fail"
    write_expr_form "$WORK/st1.spl"
    OFFENDERS=""
    if run_case "$fake_fail" "$WORK/st1.spl" "42" "st-alwaysfail" >/dev/null 2>&1; then
        echo "selftest: FAILED -- always-failing seed was accepted"
        st_fail=1
    fi
    case "$OFFENDERS" in
        *unsafe-not-found*) : ;;
        *) echo "selftest: FAILED -- 'unsafe not found' signature not classified"; st_fail=1 ;;
    esac

    # Fixture 2: a build that "succeeds" but emits the ffi signature must FAIL.
    fake_sig="$WORK/fake_sig"
    cat > "$fake_sig" <<'SH'
#!/bin/sh
out=""
while [ $# -gt 0 ]; do [ "$1" = "-o" ] && { out=$2; shift; }; shift; done
echo "GlobalLoad: unresolved identifier 'ffi'"
printf '#!/bin/sh\necho 42\n' > "$out"; chmod +x "$out"
exit 0
SH
    chmod +x "$fake_sig"
    OFFENDERS=""
    if run_case "$fake_sig" "$WORK/st1.spl" "42" "st-sig" >/dev/null 2>&1; then
        echo "selftest: FAILED -- degradation signature on a green build was accepted"
        st_fail=1
    fi

    # Fixture 3: a build that succeeds but prints the WRONG value must FAIL.
    # This is what catches an unsafe block whose tail value is dropped.
    fake_wrong="$WORK/fake_wrong"
    cat > "$fake_wrong" <<'SH'
#!/bin/sh
out=""
while [ $# -gt 0 ]; do [ "$1" = "-o" ] && { out=$2; shift; }; shift; done
printf '#!/bin/sh\necho 0\n' > "$out"; chmod +x "$out"
exit 0
SH
    chmod +x "$fake_wrong"
    OFFENDERS=""
    if run_case "$fake_wrong" "$WORK/st1.spl" "42" "st-wrong" >/dev/null 2>&1; then
        echo "selftest: FAILED -- wrong output value was accepted"
        st_fail=1
    fi
    case "$OFFENDERS" in
        *output*) : ;;
        *) echo "selftest: FAILED -- wrong-output not classified"; st_fail=1 ;;
    esac

    # Fixture 4: a fully correct fake seed must PASS -- otherwise the gate is
    # simply always-red and proves nothing when it goes green.
    fake_ok="$WORK/fake_ok"
    cat > "$fake_ok" <<'SH'
#!/bin/sh
out=""
while [ $# -gt 0 ]; do [ "$1" = "-o" ] && { out=$2; shift; }; shift; done
printf '#!/bin/sh\necho 42\n' > "$out"; chmod +x "$out"
exit 0
SH
    chmod +x "$fake_ok"
    OFFENDERS=""
    if ! run_case "$fake_ok" "$WORK/st1.spl" "42" "st-ok" >/dev/null 2>&1; then
        echo "selftest: FAILED -- correct seed was rejected"
        st_fail=1
    fi

    # Fixture 5: a build that claims success but emits no binary must FAIL.
    fake_nobin="$WORK/fake_nobin"
    printf '#!/bin/sh\nexit 0\n' > "$fake_nobin"
    chmod +x "$fake_nobin"
    OFFENDERS=""
    if run_case "$fake_nobin" "$WORK/st1.spl" "42" "st-nobin" >/dev/null 2>&1; then
        echo "selftest: FAILED -- missing output binary was accepted"
        st_fail=1
    fi

    OFFENDERS=""
    return $st_fail
}

echo "== selftest =="
selftest
ST_RC=$?
if [ "$ST_RC" -ne 0 ]; then
    echo "ERROR — nothing was checked (selftest failed)"
    exit 2
fi
echo "selftest: OK (5 fixtures)"

if [ "${1:-}" = "--selftest-only" ]; then
    echo "PASS — 5 case(s) checked (selftest only; no real scan requested)"
    exit 0
fi

# ---------------------------------------------------------------------------
# Resolve the seed binary. Missing => ERROR, never a pass.
# ---------------------------------------------------------------------------
SEED=""
for cand in \
    "${SIMPLE_SEED_BIN:-}" \
    "$REPO_ROOT/src/compiler_rust/target/release/simple" \
    "${CARGO_TARGET_DIR:-}/release/simple"
do
    [ -n "$cand" ] || continue
    if [ -x "$cand" ]; then SEED=$cand; break; fi
done

if [ -z "$SEED" ]; then
    echo "ERROR — nothing was checked (no seed binary; set SIMPLE_SEED_BIN or build with: cd src/compiler_rust && cargo build --release --bin simple)"
    exit 2
fi

echo "== scan =="
echo "seed: $SEED"
ls -l "$SEED" | awk '{print "  size="$5" mtime="$6" "$7" "$8}'

# ---------------------------------------------------------------------------
# Real cases.
# ---------------------------------------------------------------------------
write_expr_form     "$WORK/expr.spl"
write_block_form    "$WORK/block.spl"
write_ordinary_call "$WORK/call.spl"

run_case "$SEED" "$WORK/expr.spl"  "42" "unsafe-expression-form" ; EV_CHECKED=$((EV_CHECKED+1))
run_case "$SEED" "$WORK/block.spl" "42" "unsafe-statement-form"  ; EV_CHECKED=$((EV_CHECKED+1))
run_case "$SEED" "$WORK/call.spl"  "42" "ordinary-call-disambig" ; EV_CHECKED=$((EV_CHECKED+1))

# ---------------------------------------------------------------------------
# Verdict -- ALWAYS the last line of stdout.
# ---------------------------------------------------------------------------
if [ "$EV_CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked (0 native-builds executed)"
    exit 2
fi

if [ -n "$OFFENDERS" ]; then
    echo "FAIL — $EV_CHECKED case(s) checked, offender(s):$OFFENDERS"
    exit 1
fi

echo "PASS — $EV_CHECKED case(s) checked, both unsafe forms native-build and run correctly"
exit 0
