#!/bin/sh
# Produce real Aetheric Web/GUI evidence. The admission wrapper remains the
# authority for PASS; Electron exposes its exact live DOM through the canonical
# Simple UI access protocol while the native Simple renderer captures pixels.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"
ELECTRON_RESOLVER_ROOT="$ROOT_DIR"
. "$ROOT_DIR/scripts/check/lib/pinned-electron-resolver.shs"

BUILD_DIR="${BUILD_DIR:-build/aetheric-host-web-gui-evidence}"
SIMPLE_BIN="${SIMPLE_BIN:-}"
PROOF_PATH="${AETHERIC_HOST_WEB_GUI_PROOF:-$BUILD_DIR/aetheric-host-web-gui.env}"
WIDTH="${AETHERIC_HOST_WEB_GUI_WIDTH:-960}"
HEIGHT="${AETHERIC_HOST_WEB_GUI_HEIGHT:-640}"
RENDERER_WM_PROVIDER="${AETHERIC_HOST_WEB_GUI_WM_PROVIDER:-$ROOT_DIR/build/sffi/libsimple_runtime_wm.dylib}"
RENDERER_C_WM_PROVIDER="${AETHERIC_HOST_WEB_GUI_C_WM_PROVIDER:-$ROOT_DIR/build/sffi/libsimple_runtime_c_wm.dylib}"

fail() {
    echo "produce-aetheric-host-web-gui-evidence: $1" >&2
    exit 2
}

sha256_file() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        sha256sum "$1" | awk '{print $1}'
    fi
}

canonical_regular_file() {
    [ -f "$1" ] && [ ! -L "$1" ] || fail "provider is missing, non-regular, or symlinked: $1"
    provider_dir="$(CDPATH= cd -- "$(dirname -- "$1")" && pwd -P)"
    printf '%s/%s\n' "$provider_dir" "$(basename -- "$1")"
}

require_global_symbol() {
    provider="$1"
    symbol="$2"
    nm -gU "$provider" 2>/dev/null | grep -Eq "(_| )${symbol}$" ||
        fail "provider lacks required symbol $symbol: $provider"
}

[ -n "$SIMPLE_BIN" ] && [ -x "$SIMPLE_BIN" ] ||
    fail "SIMPLE_BIN must name an explicit Stage4 executable"
BOOTSTRAP_STAGE3_FACADE_PATH="$ROOT_DIR/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="$ROOT_DIR/scripts/check/lib/stage4-candidate-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"
SIMPLE_BIN="$(bootstrap_stage3_canonical_file "$SIMPLE_BIN")" ||
    fail "SIMPLE_BIN is not canonical"
stage4_verify_candidate_provenance "${SIMPLE_BIN}.provenance.env" \
    "$SIMPLE_BIN" "$ROOT_DIR" || fail "SIMPLE_BIN Stage4 provenance rejected"

mkdir -p "$BUILD_DIR"
BUILD_DIR="$(CDPATH= cd -- "$BUILD_DIR" && pwd -P)"
HTML_PATH="$BUILD_DIR/aetheric_dark_production.html"
SOURCE_LOG="$BUILD_DIR/source-generation.log"
SIMPLE_PIXELS="$BUILD_DIR/aetheric_dark_engine2d.argb.json"
ELECTRON_PIXELS="$BUILD_DIR/aetheric_dark_electron.argb.json"
SCREENSHOT="$BUILD_DIR/aetheric_dark_electron.png"
OBSERVATION="$BUILD_DIR/aetheric_dark_electron_observation.json"
UI_ACCESS_DIR="$BUILD_DIR/ui-access"
UI_ACCESS_READY="$UI_ACCESS_DIR/ready.env"
UI_ACCESS_DONE="$UI_ACCESS_DIR/done.env"
UI_ACCESS_PORT="${AETHERIC_HOST_WEB_GUI_UI_ACCESS_PORT:-23841}"
REVISION="$(git rev-parse HEAD)"
GENERATOR_BIN="$BUILD_DIR/aetheric-host-web-gui-generator"
RENDERER_BIN="$BUILD_DIR/aetheric-host-web-gui-renderer"
UI_CLI_BIN="$BUILD_DIR/aetheric-host-web-gui-ui-access"
NATIVE_CACHE="$BUILD_DIR/native-cache"
PROVIDER_DIR="$BUILD_DIR/providers"
SQLITE_PROVIDER_DIR="$PROVIDER_DIR/sqlite"
PROVIDER_PROVENANCE="$PROVIDER_DIR/provenance.env"

[ "$(uname -s)" = Darwin ] || fail "this production host evidence producer requires macOS"
command -v xcrun >/dev/null 2>&1 || fail "xcrun is required"
command -v nm >/dev/null 2>&1 || fail "nm is required"
resolve_electron_bin || fail "$ELECTRON_RESOLVER_REASON"
ELECTRON_PACKAGE_ROOT="$ROOT_DIR/tools/electron-shell/node_modules/electron"
ELECTRON_APP_EXECUTABLE="$ELECTRON_PACKAGE_ROOT/dist/Electron.app/Contents/MacOS/Electron"
ELECTRON_PACKAGE="$ELECTRON_PACKAGE_ROOT/package.json"
ELECTRON_LOCK="$ROOT_DIR/tools/electron-shell/package-lock.json"

RENDERER_WM_PROVIDER="$(canonical_regular_file "$RENDERER_WM_PROVIDER")"
RENDERER_C_WM_PROVIDER="$(canonical_regular_file "$RENDERER_C_WM_PROVIDER")"
require_global_symbol "$RENDERER_WM_PROVIDER" rt_engine2d_simd_fill_row_u32
require_global_symbol "$RENDERER_C_WM_PROVIDER" rt_engine2d_rocm_download_pixels

mkdir -p "$SQLITE_PROVIDER_DIR"
SQLITE_SOURCE="$(canonical_regular_file "$ROOT_DIR/src/runtime/runtime_sqlite.c")"
SQLITE_OBJECT="$SQLITE_PROVIDER_DIR/runtime_sqlite.o"
SDK_PATH="$(xcrun --show-sdk-path)"
SQLITE_SYSTEM_PROVIDER="$(canonical_regular_file "$SDK_PATH/usr/lib/libsqlite3.tbd")"
CLANG_PATH="$(canonical_regular_file "$(xcrun --find clang)")"
SQLITE_COMPILE_FLAGS="-Os -ffunction-sections -fdata-sections -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-stack-protector -fno-builtin -fPIC -std=gnu11"
"$CLANG_PATH" -c -Os -ffunction-sections -fdata-sections \
    -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-stack-protector \
    -fno-builtin -fPIC -std=gnu11 -isysroot "$SDK_PATH" \
    -I"$ROOT_DIR/src/runtime" -I"$ROOT_DIR/src/runtime/platform" \
    "$SQLITE_SOURCE" -o "$SQLITE_OBJECT"
[ -s "$SQLITE_OBJECT" ] || fail "SQLite provider object was not produced"
require_global_symbol "$SQLITE_OBJECT" rt_sqlite_open
require_global_symbol "$SQLITE_OBJECT" rt_sqlite_query_next

build_native() {
    entry="$1"
    output="$2"
    log="$3"
    cache="$4"
    link_objects="${5:-}"
    extra_source="${6:-}"
    if [ -n "$extra_source" ]; then
        set -- --source "$extra_source"
    else
        set --
    fi
    SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LIB="$ROOT_DIR/src" SIMPLE_LINK_OBJECTS="$link_objects" \
        "$SIMPLE_BIN" native-build \
        --source "$entry" "$@" --entry "$entry" --entry-closure --strip \
        --backend cranelift --cache-dir "$cache" --mode dynload --output "$output" \
        >"$log" 2>&1
    [ -x "$output" ] || return 1
    ! grep -Eq 'FAILED FILES|non-critical file\(s\) failed|Generating [1-9][0-9]* stub functions|Warning: [1-9][0-9]* files failed' "$log"
}

build_native src/app/test/aetheric_host_web_gui_producer.spl "$GENERATOR_BIN" \
    "$BUILD_DIR/generator-native-build.log" "$NATIVE_CACHE/generator" || {
    tail -n 40 "$BUILD_DIR/generator-native-build.log" >&2
    exit 2
}
build_native tools/pixel_compare/render_simple_html.spl "$RENDERER_BIN" \
    "$BUILD_DIR/renderer-native-build.log" "$NATIVE_CACHE/renderer" \
    "$RENDERER_WM_PROVIDER:$RENDERER_C_WM_PROVIDER" src/lib/nogc_sync_mut/failsafe/core.spl || {
    tail -n 40 "$BUILD_DIR/renderer-native-build.log" >&2
    exit 2
}
build_native src/app/test/ui_access_cli_driver.spl "$UI_CLI_BIN" \
    "$BUILD_DIR/ui-access-native-build.log" "$NATIVE_CACHE/ui-access" \
    "$SQLITE_OBJECT:$SQLITE_SYSTEM_PROVIDER" || {
    tail -n 40 "$BUILD_DIR/ui-access-native-build.log" >&2
    exit 2
}

PROVIDER_PROVENANCE_TMP="$PROVIDER_PROVENANCE.tmp.$$"
umask 077
{
    echo "schema=aetheric-host-web-gui-provider-provenance-v1"
    echo "status=pass"
    echo "source_revision=$REVISION"
    echo "compiler_path=$(canonical_regular_file "$SIMPLE_BIN")"
    echo "compiler_sha256=$(sha256_file "$SIMPLE_BIN")"
    echo "renderer_wm_provider_path=$RENDERER_WM_PROVIDER"
    echo "renderer_wm_provider_sha256=$(sha256_file "$RENDERER_WM_PROVIDER")"
    echo "renderer_c_wm_provider_path=$RENDERER_C_WM_PROVIDER"
    echo "renderer_c_wm_provider_sha256=$(sha256_file "$RENDERER_C_WM_PROVIDER")"
    echo "sqlite_source_path=$SQLITE_SOURCE"
    echo "sqlite_source_sha256=$(sha256_file "$SQLITE_SOURCE")"
    echo "sqlite_object_path=$SQLITE_OBJECT"
    echo "sqlite_object_sha256=$(sha256_file "$SQLITE_OBJECT")"
    echo "sqlite_system_provider_path=$SQLITE_SYSTEM_PROVIDER"
    echo "sqlite_system_provider_sha256=$(sha256_file "$SQLITE_SYSTEM_PROVIDER")"
    echo "sqlite_compiler_path=$CLANG_PATH"
    echo "sqlite_compiler_sha256=$(sha256_file "$CLANG_PATH")"
    echo "sqlite_sdk_path=$SDK_PATH"
    echo "sqlite_compile_flags=$SQLITE_COMPILE_FLAGS"
    echo "generator_cache_path=$NATIVE_CACHE/generator"
    echo "renderer_cache_path=$NATIVE_CACHE/renderer"
    echo "ui_access_cache_path=$NATIVE_CACHE/ui-access"
    echo "generator_binary_sha256=$(sha256_file "$GENERATOR_BIN")"
    echo "renderer_binary_sha256=$(sha256_file "$RENDERER_BIN")"
    echo "ui_driver_binary_sha256=$(sha256_file "$UI_CLI_BIN")"
} >"$PROVIDER_PROVENANCE_TMP"
mv "$PROVIDER_PROVENANCE_TMP" "$PROVIDER_PROVENANCE"
"$GENERATOR_BIN" "$HTML_PATH" >"$SOURCE_LOG"
PIXEL_HTML="$HTML_PATH" PIXEL_W="$WIDTH" PIXEL_H="$HEIGHT" PIXEL_BACKEND="cpu_simd" PIXEL_OUT="$SIMPLE_PIXELS" \
    "$RENDERER_BIN"
mkdir -p "$UI_ACCESS_DIR"
rm -f "$UI_ACCESS_READY" "$UI_ACCESS_DONE"
ELECTRON_PID=
cleanup() {
    if [ -n "${ELECTRON_PID:-}" ]; then
        kill "$ELECTRON_PID" 2>/dev/null || true
        wait "$ELECTRON_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM
ELECTRON_CAPTURE_HTML="$HTML_PATH" ELECTRON_CAPTURE_WIDTH="$WIDTH" ELECTRON_CAPTURE_HEIGHT="$HEIGHT" \
    ELECTRON_CAPTURE_OUTPUT="$ELECTRON_PIXELS" ELECTRON_CAPTURE_PNG_OUTPUT="$SCREENSHOT" \
    ELECTRON_CAPTURE_AETHERIC_OBSERVATION_PATH="$OBSERVATION" ELECTRON_CAPTURE_SETTLE_MS=200 \
    ELECTRON_CAPTURE_UI_ACCESS_PORT="$UI_ACCESS_PORT" \
    ELECTRON_CAPTURE_UI_ACCESS_READY_PATH="$UI_ACCESS_READY" \
    ELECTRON_CAPTURE_UI_ACCESS_DONE_PATH="$UI_ACCESS_DONE" \
    "$ELECTRON_RESOLVED_BIN" --no-sandbox --disable-gpu tools/electron-live-bitmap/capture_html_argb.js \
    >"$UI_ACCESS_DIR/electron.log" 2>&1 &
ELECTRON_PID=$!

ready=0
i=0
while [ "$i" -lt 100 ]; do
    if [ -s "$UI_ACCESS_READY" ]; then
        ready=1
        break
    fi
    kill -0 "$ELECTRON_PID" 2>/dev/null || { tail -n 40 "$UI_ACCESS_DIR/electron.log" >&2; exit 2; }
    i=$((i + 1))
    sleep 0.1
done
[ "$ready" -eq 1 ] || { echo "produce-aetheric-host-web-gui-evidence: UI-access adapter did not become ready" >&2; exit 2; }

"$UI_CLI_BIN" snapshot --port "$UI_ACCESS_PORT" --json >"$UI_ACCESS_DIR/snapshot.json"
"$UI_CLI_BIN" surface main --port "$UI_ACCESS_PORT" --json >"$UI_ACCESS_DIR/surface.json"
"$UI_CLI_BIN" find --surface main --kind button --text apply-theme --limit 10 --port "$UI_ACCESS_PORT" --json >"$UI_ACCESS_DIR/find.json"

ui_act() {
    stem="$1"
    canonical="$2"
    action="$3"
    "$UI_CLI_BIN" snapshot --port "$UI_ACCESS_PORT" --json >"$UI_ACCESS_DIR/$stem-revision.json"
    revision="$(sed -n 's/.*"snapshot_revision":\([0-9][0-9]*\).*/\1/p' "$UI_ACCESS_DIR/$stem-revision.json" | tail -n 1)"
    [ -n "$revision" ] || { echo "produce-aetheric-host-web-gui-evidence: missing UI revision for $stem" >&2; exit 2; }
    "$UI_CLI_BIN" act --canonical "$canonical" --action "$action" --revision "$revision" \
        --port "$UI_ACCESS_PORT" --timeout 2000 --json >"$UI_ACCESS_DIR/$stem.json"
}

ui_act act-focus main#theme-name focus
ui_act act-pointer-down main#apply-theme pointer_down
ui_act act-pointer-up main#apply-theme pointer_up
ui_act act-keyboard main#theme-name keyboard_x
ui_act act-text main#theme-name text_x
"$UI_CLI_BIN" find --surface main --canonical main#theme-name --focused-only --limit 1 \
    --port "$UI_ACCESS_PORT" --json >"$UI_ACCESS_DIR/post-action.json"
"$UI_CLI_BIN" history --surface main --count 20 --port "$UI_ACCESS_PORT" --json >"$UI_ACCESS_DIR/history.json"
printf 'status=done\n' >"$UI_ACCESS_DONE"
wait "$ELECTRON_PID"
ELECTRON_PID=
trap - EXIT INT TERM
node tools/electron-live-bitmap/write_aetheric_host_web_gui_proof.js \
    --source-log "$SOURCE_LOG" --html "$HTML_PATH" --simple-pixels "$SIMPLE_PIXELS" --electron-pixels "$ELECTRON_PIXELS" \
    --observation "$OBSERVATION" --screenshot "$SCREENSHOT" --binary "$SIMPLE_BIN" \
    --generator-binary "$GENERATOR_BIN" --renderer-binary "$RENDERER_BIN" --ui-driver-binary "$UI_CLI_BIN" \
    --provider-provenance "$PROVIDER_PROVENANCE" \
    --renderer-wm-provider "$RENDERER_WM_PROVIDER" --renderer-c-wm-provider "$RENDERER_C_WM_PROVIDER" \
    --ui-sqlite-provider "$SQLITE_OBJECT" --ui-sqlite-system-provider "$SQLITE_SYSTEM_PROVIDER" \
    --electron-launcher "$ELECTRON_RESOLVED_BIN" --electron-app-executable "$ELECTRON_APP_EXECUTABLE" \
    --electron-package "$ELECTRON_PACKAGE" --electron-lock "$ELECTRON_LOCK" \
    --revision "$REVISION" --ui-access-dir "$UI_ACCESS_DIR" --output "$PROOF_PATH"

echo "aetheric_host_web_gui_producer_status=complete"
echo "aetheric_host_web_gui_proof=$PROOF_PATH"
