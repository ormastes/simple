#!/bin/sh
# check-test-runner-single-lane-paths.shs
#
# Guard: `bin/simple test --no-session-daemon` must never silently drop
# positional spec paths and still exit 0.
#
# Incident (doc/08_tracking/bug/test_runner_single_lane_drops_extra_paths_2026-08-27.md):
# `src/app/test_runner_new/test_runner_single.spl:parse_child_run` kept only the
# FIRST positional path (`if not arg.starts_with("-") and path == "": path = arg`)
# and discarded every later one WITHOUT a word. So
#   bin/simple test --no-session-daemon good_spec.spl failing_spec.spl
# ran only `good_spec.spl`, printed only its verdict, and exited 0 — a silent
# false green for the failing file. Measured on the default (session-daemon)
# lane the same invocation correctly exits 1.
#
# Verdict is the LAST line of stdout, per .claude/rules/vcs.md:
#   PASS  — <n> invocation(s) executed, 0 false green(s)        exit 0
#   FAIL  — ...                                                 exit 1
#   ERROR — nothing was checked (<reason>)                      exit 2
# A run that executed 0 invocations is ERROR, never a pass.
#
# Exit statuses are read DIRECTLY into a variable on the line after the
# invocation, never through a pipe — a pipeline's $? is the last command's
# status and has produced false greens in this repo before.

set -u

ROOT=${ROOT:-$(pwd)}
SIMPLE=${SIMPLE:-$ROOT/bin/simple}
TIMEOUT=${SINGLE_LANE_GUARD_TIMEOUT:-900}
EV_CHECKED=0
OFFENDERS=""

fail_verdict() {
    echo "FAIL — $EV_CHECKED invocation(s) executed, false green(s): $1"
    exit 1
}

error_verdict() {
    echo "ERROR — nothing was checked ($1)"
    exit 2
}

# ---------------------------------------------------------------- selftest
# Fatal and unconditional: proves the scanner's own classification, so a
# scanner that can no longer detect the defect cannot report PASS.
selftest() {
    st_tmp=$(mktemp -d) || return 1
    # A fake runner replaying the defect: takes the first path, ignores the
    # rest, exits 0. The classifier below must call this a false green.
    cat > "$st_tmp/bad" <<'EOF'
#!/bin/sh
echo "PASS first-only"
exit 0
EOF
    # A fixed runner: refuses the second path, non-zero.
    cat > "$st_tmp/good" <<'EOF'
#!/bin/sh
echo "error: single-file lane accepts exactly one test file"
exit 1
EOF
    chmod +x "$st_tmp/bad" "$st_tmp/good"

    "$st_tmp/bad" a b >/dev/null 2>&1
    bad_rc=$?
    "$st_tmp/good" a b >/dev/null 2>&1
    good_rc=$?
    rm -rf "$st_tmp"

    # Fixture 1: a zero exit on a multi-path invocation is the defect.
    [ "$bad_rc" -eq 0 ] || return 1
    # Fixture 2: a non-zero exit is the fixed behaviour.
    [ "$good_rc" -ne 0 ] || return 1
    return 0
}

selftest
if [ $? -ne 0 ]; then
    error_verdict "selftest failed"
fi

# ---------------------------------------------------------------- preconditions
[ -x "$SIMPLE" ] || [ -L "$SIMPLE" ] || error_verdict "no runnable simple binary at $SIMPLE"

GOOD_SPEC=${GOOD_SPEC:-test/01_unit/lib/std/common/text_helpers_spec.spl}
[ -f "$ROOT/$GOOD_SPEC" ] || error_verdict "fixture spec missing: $GOOD_SPEC"

# A second path that MUST NOT be silently dropped. A nonexistent path is used
# deliberately: if the lane honours it at all it fails loudly, and if it drops
# it the run is a provable false green. This keeps the guard cheap (no second
# spec compile) while testing exactly the dropped-path property.
MISSING_SPEC=test/01_unit/lib/std/common/__guard_absent_spec.spl
[ -f "$ROOT/$MISSING_SPEC" ] && error_verdict "control path unexpectedly exists: $MISSING_SPEC"

OUT=$(mktemp) || error_verdict "cannot create temp file"

# ---------------------------------------------------------------- scan
# Case 1: two positional paths on the single-file lane.
( cd "$ROOT" && timeout "$TIMEOUT" "$SIMPLE" test --no-session-daemon "$GOOD_SPEC" "$MISSING_SPEC" ) > "$OUT" 2>/dev/null
rc_two=$?
EV_CHECKED=$((EV_CHECKED + 1))
if [ "$rc_two" -eq 0 ]; then
    OFFENDERS="$OFFENDERS --no-session-daemon(2 paths, rc=0)"
fi

# Case 2: the same, with --timeout, the documented trap shape.
( cd "$ROOT" && timeout "$TIMEOUT" "$SIMPLE" test --no-session-daemon --timeout 60 "$GOOD_SPEC" "$MISSING_SPEC" ) > "$OUT" 2>/dev/null
rc_two_t=$?
EV_CHECKED=$((EV_CHECKED + 1))
if [ "$rc_two_t" -eq 0 ]; then
    OFFENDERS="$OFFENDERS --no-session-daemon --timeout(2 paths, rc=0)"
fi

# Case 3 (non-regression): ONE path on the same lane must still succeed, so the
# fix cannot be "reject everything".
( cd "$ROOT" && timeout "$TIMEOUT" "$SIMPLE" test --no-session-daemon "$GOOD_SPEC" ) > "$OUT" 2>/dev/null
rc_one=$?
EV_CHECKED=$((EV_CHECKED + 1))
if [ "$rc_one" -ne 0 ]; then
    OFFENDERS="$OFFENDERS single-path-regression(rc=$rc_one)"
fi

# Case 4 (option arity): a separated value owned by a forwarded option is not
# a second path. This was the P1 neighbour of the original fix: `json` was
# classified as an extra path even though `--format` consumes it.
( cd "$ROOT" && timeout "$TIMEOUT" "$SIMPLE" test --no-session-daemon "$GOOD_SPEC" --format json ) > "$OUT" 2>/dev/null
rc_format=$?
EV_CHECKED=$((EV_CHECKED + 1))
if [ "$rc_format" -ne 0 ]; then
    OFFENDERS="$OFFENDERS format-value-misclassified(rc=$rc_format)"
fi

rm -f "$OUT"

[ "$EV_CHECKED" -gt 0 ] || error_verdict "0 invocations executed"
[ -z "$OFFENDERS" ] || fail_verdict "$OFFENDERS"

echo "PASS — $EV_CHECKED invocation(s) executed, 0 false green(s)"
exit 0
