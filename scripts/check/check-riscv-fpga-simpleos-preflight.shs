#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"
. scripts/check/riscv-fpga-preflight-common.shs
PREFLIGHT_FAILURES=0

LOCAL_ONLY=0
if [ "${1:-}" = "--local-only" ]; then
    LOCAL_ONLY=1
fi

pass() { printf 'PASS %s\n' "$1"; }
fail() {
    printf 'FAIL %s\n' "$1"
    PREFLIGHT_FAILURES=$((PREFLIGHT_FAILURES + 1))
}
info() { printf 'INFO %s\n' "$1"; }

if [ "$LOCAL_ONLY" = "1" ]; then
    if ! sh scripts/check/check-riscv64-fpga-simpleos-preflight.shs --local-only; then
        PREFLIGHT_FAILURES=$((PREFLIGHT_FAILURES + 1))
    fi
else
    if ! sh scripts/check/check-riscv64-fpga-simpleos-preflight.shs; then
        PREFLIGHT_FAILURES=$((PREFLIGHT_FAILURES + 1))
    fi
fi

check_artifact() {
    name="$1"
    path="$2"
    if [ -s "$path" ]; then
        bytes="$(wc -c <"$path" | tr -d ' ')"
        pass "$name"
        info "${name}_path=$path"
        info "${name}_bytes=$bytes"
    else
        fail "$name"
        info "${name}_path=$path"
    fi
}

rv32_elf="${RV32_FPGA_ELF:-build/os/simpleos_riscv32_fpga.elf}"
rv32_bin="${RV32_FPGA_BIN:-build/vhdl/rv32/simpleos_riscv32_fpga.bin}"
rv32_bit="${RV32_FPGA_BIT:-build/build/rv32_fpga/gateware/rv32_fpga.bit}"

check_artifact "artifact_rv32_simpleos_elf" "$rv32_elf"
check_artifact "artifact_rv32_simpleos_bin" "$rv32_bin"
check_artifact "artifact_rv32_simpleos_bitstream" "$rv32_bit"

rv32_vhdl_dir="${RV32_VHDL_DIR:-build/vhdl/rv32}"
rv32_product_core_vhdl="${RV32_FPGA_PRODUCT_CORE_VHDL:-$rv32_vhdl_dir/core32_protected_product.vhd}"
rv32_product_wb_vhdl="${RV32_FPGA_PRODUCT_WB_VHDL:-$rv32_vhdl_dir/rv32imac_core_product_wb.vhd}"
rv32_external_ddr_vhdl="${RV32_FPGA_EXTERNAL_DDR_VHDL:-$rv32_vhdl_dir/soc_top_rv32_external_ddr.vhd}"
rv32_k26_pl_vhdl="${RV32_FPGA_K26_PL_VHDL:-$rv32_vhdl_dir/soc_top_rv32_k26_pl.vhd}"
rv32_wb64_axi_vhdl="${RV32_FPGA_WB64_AXI_VHDL:-$rv32_vhdl_dir/wb64_axi_hp_bridge.vhd}"
rv32_load_log="${RV32_FPGA_LOAD_LOG:-build/fpga/rv32/load_elf_rv32.log}"
rv32_synth_util="${RV32_FPGA_SYNTH_UTIL:-build/fpga/k26_rv32/k26_rv32_product/k26_rv32_product.runs/synth_1/k26_ps_bd_wrapper_utilization_synth.rpt}"
rv32_run_log="${RV32_FPGA_RUN_LOG:-build/fpga/rv32/rv32_simpleos_run.log}"
rv32_run_marker="${RV32_FPGA_RUN_MARKER:-FPGA-RV32}"
rv32_root_fixture="${RV32_FPGA_ROOT_FIXTURE:-SIMPLE_RISCV_LINUX_LOGIN_LS_PASS}"
rv32_ghdl_log="${RV32_FPGA_GHDL_LOG:-build/fpga/rv32/rv32_simpleos_ghdl.log}"
rv32_product_pmp_log="${RV32_PRODUCT_PMP_GHDL_LOG:-build/ghdl/rv32_product_sv32_pmp/sim.log}"
rv32_product_pmp_provenance="${RV32_PRODUCT_PMP_PROVENANCE:-build/ghdl/rv32_product_sv32_pmp/provenance.sha256}"
rv32_product_pmp_tb="test/01_unit/lib/hardware/fpga_linux/rv32_product_sv32_pmp_ghdl/tb_rv32_product_sv32_pmp.vhd"
rv32_product_pmp_fixture="test/01_unit/lib/hardware/fpga_linux/rv32_product_sv32_pmp_ghdl/rv32_product_sv32_pmp.S"

newer_rv32_dep=""
for dep in "$rv32_product_core_vhdl" "$rv32_product_wb_vhdl" "$rv32_external_ddr_vhdl" "$rv32_k26_pl_vhdl" "$rv32_wb64_axi_vhdl"; do
    if [ -s "$rv32_bit" ] && [ -s "$dep" ] && [ -n "$(find "$dep" -newer "$rv32_bit" -print -quit 2>/dev/null)" ]; then
        newer_rv32_dep="$dep"
        break
    fi
done
if [ -z "$newer_rv32_dep" ] && [ -s "$rv32_bit" ]; then
    pass "rv32_fpga_bitstream_freshness"
    info "rv32_fpga_bitstream=$rv32_bit"
else
    fail "rv32_fpga_bitstream_freshness"
    info "rv32_fpga_bitstream=$rv32_bit"
    info "rv32_fpga_newer_input=$newer_rv32_dep"
    info "rv32_fpga_bitstream_reason=older-than-generated-input"
fi

if [ -s "$rv32_product_core_vhdl" ] &&
    grep -q 'entity core32_protected_product_entry is' "$rv32_product_core_vhdl" &&
    [ -s "$rv32_product_wb_vhdl" ] && grep -q 'entity rv32imac_core_product_wb is' "$rv32_product_wb_vhdl" &&
    [ -s "$rv32_external_ddr_vhdl" ] && grep -q 'entity soc_top_rv32_external_ddr is' "$rv32_external_ddr_vhdl" &&
    [ -s "$rv32_k26_pl_vhdl" ] && grep -q 'entity soc_top_rv32_k26_pl is' "$rv32_k26_pl_vhdl" &&
    [ -s "$rv32_wb64_axi_vhdl" ] && grep -q 'entity wb64_axi_hp_bridge is' "$rv32_wb64_axi_vhdl"; then
    pass "rv32_fpga_product_ps_ddr"
    info "rv32_fpga_product_core_vhdl=$rv32_product_core_vhdl"
    info "rv32_fpga_product_wb_vhdl=$rv32_product_wb_vhdl"
    info "rv32_fpga_external_ddr_vhdl=$rv32_external_ddr_vhdl"
    info "rv32_fpga_k26_pl_vhdl=$rv32_k26_pl_vhdl"
    info "rv32_fpga_wb64_axi_vhdl=$rv32_wb64_axi_vhdl"
else
    fail "rv32_fpga_product_ps_ddr"
    info "rv32_fpga_product_reason=missing-required-product-ps-ddr-rtl"
fi

if preflight_bound_marker "$rv32_product_pmp_log" "$rv32_product_pmp_provenance" RV32_PRODUCT_SV32_PMP_GHDL_PASS \
    "$rv32_product_core_vhdl" "$rv32_product_wb_vhdl" \
    "$rv32_product_pmp_tb" "$rv32_product_pmp_fixture" \
    scripts/fpga/ghdl_rv32_product_sv32_pmp.shs; then
    pass "rv32_product_sv32_pmp_ghdl"
    info "rv32_product_sv32_pmp_log=$rv32_product_pmp_log"
    info "rv32_product_sv32_pmp_provenance=$rv32_product_pmp_provenance"
else
    fail "rv32_product_sv32_pmp_ghdl"
    info "rv32_product_sv32_pmp_log=$rv32_product_pmp_log"
    info "rv32_product_sv32_pmp_provenance=$rv32_product_pmp_provenance"
    info "rv32_product_sv32_pmp_reason=missing-failed-or-stale-real-dut-proof"
fi

if preflight_nonzero_luts "$rv32_synth_util"; then
    pass "rv32_fpga_synth_logic"
    info "rv32_fpga_synth_util=$rv32_synth_util"
else
    fail "rv32_fpga_synth_logic"
    info "rv32_fpga_synth_util=$rv32_synth_util"
    info "rv32_fpga_synth_reason=missing-malformed-or-zero-utilization"
fi

if [ -f "$rv32_load_log" ] &&
    grep -q 'DDR_LOAD' "$rv32_load_log" &&
    grep -q 'DDR_FIRST_WORD' "$rv32_load_log" &&
    grep -q 'RISC-V core started from translated DDR' "$rv32_load_log" &&
    ! grep -Eiq 'error|Invalid context' "$rv32_load_log" &&
    ! preflight_has_legacy_physical_evidence "$rv32_load_log"; then
    pass "rv32_fpga_elf_load_context"
    info "rv32_fpga_load_context=xsdb-ps-ddr"
    info "rv32_fpga_load_log=$rv32_load_log"
else
    fail "rv32_fpga_elf_load_context"
    info "rv32_fpga_load_log=$rv32_load_log"
    info "rv32_fpga_load_context=missing-ddr-load-or-xsdb-error"
fi

if preflight_ordered_terminal "$rv32_run_log" "$rv32_root_fixture" &&
    ! preflight_has_legacy_physical_evidence "$rv32_run_log"; then
    pass "rv32_fpga_simpleos_run"
    info "rv32_fpga_run_log=$rv32_run_log"
    info "rv32_fpga_root_fixture=$rv32_root_fixture"
else
    fail "rv32_fpga_simpleos_run"
    info "rv32_fpga_run_log=$rv32_run_log"
    info "rv32_fpga_root_fixture=$rv32_root_fixture"
    info "rv32_fpga_run_context=missing-bidirectional-login-shell-ls-root-fixture"
fi

if [ -f "$rv32_ghdl_log" ] &&
    grep -q 'RV32_UART_MARKER_SEEN' "$rv32_ghdl_log" &&
    grep -q 'Simulation PASSED' "$rv32_ghdl_log"; then
    pass "rv32_fpga_ghdl_marker"
    info "rv32_fpga_ghdl_log=$rv32_ghdl_log"
    info "rv32_fpga_ghdl_marker=$rv32_run_marker"
else
    fail "rv32_fpga_ghdl_marker"
    info "rv32_fpga_ghdl_log=$rv32_ghdl_log"
    info "rv32_fpga_ghdl_marker=$rv32_run_marker"
    info "rv32_fpga_ghdl_context=missing-decoded-marker"
fi

info "dual_arch_preflight_complete=true"
if [ "$PREFLIGHT_FAILURES" -ne 0 ]; then
    info "dual_arch_preflight_failures=$PREFLIGHT_FAILURES"
    exit 1
fi
