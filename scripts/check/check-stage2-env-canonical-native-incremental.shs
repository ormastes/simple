#!/bin/sh
# Selftest for the fix to
# doc/08_tracking/bug/stage2_env_canonical_list_missing_native_incremental_2026-09-12.md
#
# PR #674 forwards SIMPLE_NATIVE_INCREMENTAL into the Stage 2 native-build
# child env (bootstrap_run_stage2_native in bootstrap-from-scratch.sh) but the
# canonical env-name allowlist check
# (bootstrap_stage3_stage2_canonical_env_names in
# scripts/check/lib/bootstrap-stage3/authority.shs) was not extended, so
# setting SIMPLE_NATIVE_INCREMENTAL=1 made every Stage 2 run abort with
# "stage2 env assignment names do not match the canonical list". This script
# proves the fix: the check PASSES with the var set, PASSES with the var
# unset, and still FAILS (fail-closed) for a genuinely unknown env name.
#
# Exit 0 = all fixtures pass. Exit 1 = a fixture failed (regression).

set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
lib="${repo_root}/scripts/check/lib/bootstrap-stage3/authority.shs"

# shellcheck source=lib/bootstrap-stage3/authority.shs
. "$lib"

fail_count=0

check_case() {
    case_name=$1
    expect_rc=$2
    shift 2
    actual_names=$("$@") 2>/dev/null
    actual_rc=$?
    if [ "$actual_rc" -eq "$expect_rc" ]; then
        echo "PASS: ${case_name} (rc=${actual_rc})"
    else
        echo "FAIL: ${case_name} (expected rc=${expect_rc}, got rc=${actual_rc}, names='${actual_names}')" >&2
        fail_count=$((fail_count + 1))
    fi
}

platform="x86_64-unknown-linux-gnu"

# Fixture 1: SIMPLE_NATIVE_INCREMENTAL unset -- the assignment list built by
# bootstrap_run_stage2_native (via the `${VAR:+...}` conditional) omits the
# name, and the canonical list must agree.
unset SIMPLE_NATIVE_INCREMENTAL 2>/dev/null || true
assignment_unset='RUST_LOG=x LIBRARY_PATH=x SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=x SIMPLE_BOOTSTRAP=1 SIMPLE_ABI_POLICY=x SIMPLE_PLUGIN_MANIFEST_POLICY=x SIMPLE_KERNEL_K1_POLICY=x SIMPLE_COVERAGE_CUTOVER_STATE=x SIMPLE_K1_COMPOSITION_SHA256_BEFORE=x SIMPLE_NO_DEPRECATED_WARNINGS=1 SIMPLE_NATIVE_BUILD_RUST=1 SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_BUILD_PROGRESS_EVENTS=x SIMPLE_FRONTEND_CACHE=1 SIMPLE_FRONTEND_CACHE_DIR=x SIMPLE_PHASE2_COMPATIBILITY_MANIFEST_WRITE=x SIMPLE_PHASE3_COMPATIBILITY_CACHE_ROOT=x SIMPLE_BINARY=x'
# shellcheck disable=SC2086
actual_unset=$(bootstrap_stage3_env_assignment_names $assignment_unset)
expected_unset=$(bootstrap_stage3_stage2_canonical_env_names "$platform")
if [ "$actual_unset" = "$expected_unset" ]; then
    echo "PASS: var unset -- assignment names match canonical list"
else
    echo "FAIL: var unset -- mismatch" >&2
    printf '  actual:   %s\n' "$actual_unset" >&2
    printf '  expected: %s\n' "$expected_unset" >&2
    fail_count=$((fail_count + 1))
fi

# Fixture 2: SIMPLE_NATIVE_INCREMENTAL=1 set -- the assignment list gains the
# name (matching the `${SIMPLE_NATIVE_INCREMENTAL:+"SIMPLE_NATIVE_INCREMENTAL=${SIMPLE_NATIVE_INCREMENTAL}"}`
# conditional in bootstrap_run_stage2_native) and the canonical list must too.
SIMPLE_NATIVE_INCREMENTAL=1
export SIMPLE_NATIVE_INCREMENTAL
assignment_set='RUST_LOG=x LIBRARY_PATH=x SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=x SIMPLE_BOOTSTRAP=1 SIMPLE_ABI_POLICY=x SIMPLE_PLUGIN_MANIFEST_POLICY=x SIMPLE_KERNEL_K1_POLICY=x SIMPLE_COVERAGE_CUTOVER_STATE=x SIMPLE_K1_COMPOSITION_SHA256_BEFORE=x SIMPLE_NO_DEPRECATED_WARNINGS=1 SIMPLE_NATIVE_BUILD_RUST=1 SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_BUILD_PROGRESS_EVENTS=x SIMPLE_FRONTEND_CACHE=1 SIMPLE_FRONTEND_CACHE_DIR=x SIMPLE_NATIVE_INCREMENTAL=1 SIMPLE_PHASE2_COMPATIBILITY_MANIFEST_WRITE=x SIMPLE_PHASE3_COMPATIBILITY_CACHE_ROOT=x SIMPLE_BINARY=x'
# shellcheck disable=SC2086
actual_set=$(bootstrap_stage3_env_assignment_names $assignment_set)
expected_set=$(bootstrap_stage3_stage2_canonical_env_names "$platform")
if [ "$actual_set" = "$expected_set" ]; then
    echo "PASS: var=1 set -- assignment names match canonical list (regression fixture for PR #674/#683)"
else
    echo "FAIL: var=1 set -- mismatch (this is the exact defect from PR #683's record)" >&2
    printf '  actual:   %s\n' "$actual_set" >&2
    printf '  expected: %s\n' "$expected_set" >&2
    fail_count=$((fail_count + 1))
fi
unset SIMPLE_NATIVE_INCREMENTAL 2>/dev/null || true

# Fixture 3: an unrelated unknown env name must still FAIL the comparison --
# the fix must stay fail-closed, not turn into an open allowlist.
assignment_unknown='RUST_LOG=x LIBRARY_PATH=x SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=x SIMPLE_BOOTSTRAP=1 SIMPLE_ABI_POLICY=x SIMPLE_PLUGIN_MANIFEST_POLICY=x SIMPLE_KERNEL_K1_POLICY=x SIMPLE_COVERAGE_CUTOVER_STATE=x SIMPLE_K1_COMPOSITION_SHA256_BEFORE=x SIMPLE_NO_DEPRECATED_WARNINGS=1 SIMPLE_NATIVE_BUILD_RUST=1 SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_BUILD_PROGRESS_EVENTS=x SIMPLE_FRONTEND_CACHE=1 SIMPLE_FRONTEND_CACHE_DIR=x SIMPLE_TOTALLY_UNKNOWN_VAR=1 SIMPLE_PHASE2_COMPATIBILITY_MANIFEST_WRITE=x SIMPLE_PHASE3_COMPATIBILITY_CACHE_ROOT=x SIMPLE_BINARY=x'
unset SIMPLE_NATIVE_INCREMENTAL 2>/dev/null || true
# shellcheck disable=SC2086
actual_unknown=$(bootstrap_stage3_env_assignment_names $assignment_unknown)
expected_unknown=$(bootstrap_stage3_stage2_canonical_env_names "$platform")
if [ "$actual_unknown" != "$expected_unknown" ]; then
    echo "PASS: unknown var name -- correctly rejected (fail-closed preserved)"
else
    echo "FAIL: unknown var name -- was incorrectly accepted (allowlist is no longer fail-closed)" >&2
    fail_count=$((fail_count + 1))
fi

if [ "$fail_count" -eq 0 ]; then
    echo "PASS -- 3 fixture(s) checked, 0 failed"
    exit 0
fi
echo "FAIL -- 3 fixture(s) checked, ${fail_count} failed"
exit 1
