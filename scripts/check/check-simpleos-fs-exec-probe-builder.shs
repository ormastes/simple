#!/bin/sh
set -eu

# The x86_64 scheduler-owned row executes the real mounted filesystem payload;
# it must never fall back to an architecture-template probe.
entry=examples/09_embedded/simple_os/arch/x86_64/fs_exec_entry.spl
wrapper=scripts/check/rebuild-sosix-qemu-media.shs
grep -Fq 'x86_64_fs_exec_spawn_scheduler_owned("/FSEXEC.ELF"' "$entry"
grep -Fq 'x86_32|arm32|arm64|riscv32|riscv64)' "$wrapper"
if grep -Eq 'x86_64\|.*build_simpleos_fs_exec_probe|x86_64\).*build_simpleos_fs_exec_probe' "$wrapper"; then
    echo 'x86_64 row incorrectly depends on a template payload' >&2
    exit 1
fi
echo 'simpleos_fs_exec_probe_builder_x86_64_real_payload_self_test=pass'
