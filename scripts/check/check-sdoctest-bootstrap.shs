#!/bin/sh
# Bootstrap-only whole-tree sdoctest gate. A process exit code is not a verdict:
# require a non-vacuous canonical summary with every discovered test passing.
set -u

ROOT=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
SIMPLE=${SIMPLE_BINARY:-$ROOT/bin/simple}

results_are_green() {
    _results_file=$1
    [ "$(grep -Ec '^Results: [0-9]+ total, [0-9]+ passed, [0-9]+ failed$' "$_results_file")" -eq 1 ] || return 1
    _results_line=$(grep -E '^Results: [0-9]+ total, [0-9]+ passed, [0-9]+ failed$' "$_results_file" | tail -n 1)
    [ -n "$_results_line" ] || return 1
    _counts=$(printf '%s\n' "$_results_line" | sed -n 's/^Results: \([0-9][0-9]*\) total, \([0-9][0-9]*\) passed, \([0-9][0-9]*\) failed$/\1 \2 \3/p')
    set -- $_counts
    [ "$#" -eq 3 ] && [ "$1" -gt 0 ] && [ "$1" -eq "$2" ] && [ "$3" -eq 0 ]
}

lane_is_green() {
    _results_file=$1
    _label=$2
    [ "$(grep -Ec "^${_label}: +[0-9]+ passed, [0-9]+ failed, [0-9]+ skipped$" "$_results_file")" -eq 1 ] || return 1
    _line=$(grep -E "^${_label}: +[0-9]+ passed, [0-9]+ failed, [0-9]+ skipped$" "$_results_file")
    [ -n "$_line" ] || return 1
    _counts=$(printf '%s\n' "$_line" | sed -n "s/^${_label}: *\\([0-9][0-9]*\\) passed, \\([0-9][0-9]*\\) failed, \\([0-9][0-9]*\\) skipped$/\\1 \\2 \\3/p")
    set -- $_counts
    [ "$#" -eq 3 ] && [ "$1" -gt 0 ] && [ "$2" -eq 0 ] && [ "$3" -eq 0 ]
}

run_explicit_fixture() {
    _flag=$1
    _path=$2
    _label=$3
    _fixture_out=$(mktemp) || return 2
    (cd "$ROOT" && "$SIMPLE" test "$_flag" "$_path" --mode=interpreter) >"$_fixture_out" 2>&1
    _fixture_rc=$?
    if [ "$_fixture_rc" -ne 0 ] || ! results_are_green "$_fixture_out" || ! lane_is_green "$_fixture_out" "$_label"; then
        tail -n 20 "$_fixture_out" >&2
        rm -f "$_fixture_out"
        return 1
    fi
    rm -f "$_fixture_out"
}

if [ "${1:-}" = --self-test ]; then
    _tmp=$(mktemp -d) || exit 2
    trap 'rm -rf "$_tmp"' EXIT INT TERM
    printf '%s\n' 'Sdoctest: 3 passed, 0 failed, 0 skipped' 'SPL Doctest: 5 passed, 0 failed, 0 skipped' 'Results: 8 total, 8 passed, 0 failed' > "$_tmp/green"
    printf '%s\n' 'Sdoctest: 2 passed, 0 failed, 1 skipped' 'Results: 2 total, 2 passed, 0 failed' > "$_tmp/skipped"
    printf '%s\n' 'Results: 8 total, 7 passed, 1 failed' > "$_tmp/failed"
    printf '%s\n' 'Results: 0 total, 0 passed, 0 failed' > "$_tmp/empty"
    printf '%s\n' 'Results: 8 total, 8 passed, 0 failed trailing' > "$_tmp/malformed"
    printf '%s\n' 'Sdoctest: 3 passed, 0 failed, 0 skipped' 'Sdoctest: 3 passed, 0 failed, 0 skipped' 'Results: 6 total, 6 passed, 0 failed' > "$_tmp/duplicate"
    results_are_green "$_tmp/green" || exit 1
    lane_is_green "$_tmp/green" Sdoctest || exit 1
    lane_is_green "$_tmp/green" 'SPL Doctest' || exit 1
    ! lane_is_green "$_tmp/skipped" Sdoctest || exit 1
    ! results_are_green "$_tmp/failed" || exit 1
    ! results_are_green "$_tmp/empty" || exit 1
    ! results_are_green "$_tmp/malformed" || exit 1
    ! lane_is_green "$_tmp/duplicate" Sdoctest || exit 1

    cat > "$_tmp/simple" <<'FAKE'
#!/bin/sh
printf '%s\n' "$*" >> "$SDOCTEST_SELFTEST_LOG"
case "$*" in
  "test --sdoctest test/fixtures/doctest/green.md --mode=interpreter")
    printf '%s\n' 'Sdoctest: 1 passed, 0 failed, 0 skipped' 'Results: 1 total, 1 passed, 0 failed' ;;
  "test --spl-doctest test/fixtures/doctest/green.spl --mode=interpreter")
    printf '%s\n' 'SPL Doctest: 1 passed, 0 failed, 0 skipped' 'Results: 1 total, 1 passed, 0 failed' ;;
  "test test --whole --mode=interpreter")
    case "${SDOCTEST_SELFTEST_CASE:-green}" in
      green) printf '%s\n' 'Sdoctest: 7 passed, 0 failed, 0 skipped' 'SPL Doctest: 11 passed, 0 failed, 0 skipped' 'Results: 30 total, 30 passed, 0 failed' ;;
      empty-markdown) printf '%s\n' 'Sdoctest: 0 passed, 0 failed, 0 skipped' 'SPL Doctest: 11 passed, 0 failed, 0 skipped' 'Results: 19 total, 19 passed, 0 failed' ;;
      empty-comment) printf '%s\n' 'Sdoctest: 7 passed, 0 failed, 0 skipped' 'SPL Doctest: 0 passed, 0 failed, 0 skipped' 'Results: 19 total, 19 passed, 0 failed' ;;
      skipped-markdown) printf '%s\n' 'Sdoctest: 6 passed, 0 failed, 1 skipped' 'SPL Doctest: 11 passed, 0 failed, 0 skipped' 'Results: 29 total, 29 passed, 0 failed' ;;
      skipped-comment) printf '%s\n' 'Sdoctest: 7 passed, 0 failed, 0 skipped' 'SPL Doctest: 10 passed, 0 failed, 1 skipped' 'Results: 29 total, 29 passed, 0 failed' ;;
      missing-markdown) printf '%s\n' 'SPL Doctest: 11 passed, 0 failed, 0 skipped' 'Results: 23 total, 23 passed, 0 failed' ;;
      missing-comment) printf '%s\n' 'Sdoctest: 7 passed, 0 failed, 0 skipped' 'Results: 19 total, 19 passed, 0 failed' ;;
      duplicate-markdown) printf '%s\n' 'Sdoctest: 7 passed, 0 failed, 0 skipped' 'Sdoctest: 7 passed, 0 failed, 0 skipped' 'SPL Doctest: 11 passed, 0 failed, 0 skipped' 'Results: 37 total, 37 passed, 0 failed' ;;
      duplicate-comment) printf '%s\n' 'Sdoctest: 7 passed, 0 failed, 0 skipped' 'SPL Doctest: 11 passed, 0 failed, 0 skipped' 'SPL Doctest: 11 passed, 0 failed, 0 skipped' 'Results: 41 total, 41 passed, 0 failed' ;;
      missing-results) printf '%s\n' 'Sdoctest: 7 passed, 0 failed, 0 skipped' 'SPL Doctest: 11 passed, 0 failed, 0 skipped' ;;
      duplicate-results) printf '%s\n' 'Sdoctest: 7 passed, 0 failed, 0 skipped' 'SPL Doctest: 11 passed, 0 failed, 0 skipped' 'Results: 30 total, 30 passed, 0 failed' 'Results: 30 total, 30 passed, 0 failed' ;;
    esac ;;
  *) exit 64 ;;
esac
FAKE
    chmod +x "$_tmp/simple"
    : > "$_tmp/commands"
    SDOCTEST_SELFTEST_CASE=green SDOCTEST_SELFTEST_LOG="$_tmp/commands" SIMPLE_BINARY="$_tmp/simple" sh "$0" > "$_tmp/production-green" 2>&1 || exit 1
    [ "$(wc -l < "$_tmp/commands" | tr -d ' ')" -eq 3 ] || exit 1
    grep -Fxq 'test --sdoctest test/fixtures/doctest/green.md --mode=interpreter' "$_tmp/commands" || exit 1
    grep -Fxq 'test --spl-doctest test/fixtures/doctest/green.spl --mode=interpreter' "$_tmp/commands" || exit 1
    grep -Fxq 'test test --whole --mode=interpreter' "$_tmp/commands" || exit 1
    grep -Fxq 'STATUS: PASS sdoctest-markdown-comments' "$_tmp/production-green" || exit 1
    for _case in empty-markdown empty-comment skipped-markdown skipped-comment \
        missing-markdown missing-comment duplicate-markdown duplicate-comment \
        missing-results duplicate-results; do
        if SDOCTEST_SELFTEST_CASE=$_case SDOCTEST_SELFTEST_LOG="$_tmp/commands" SIMPLE_BINARY="$_tmp/simple" sh "$0" > "$_tmp/production-$_case" 2>&1; then
            echo "sdoctest bootstrap self-test accepted $_case" >&2
            exit 1
        fi
        grep -Fxq 'STATUS: FAIL sdoctest-markdown-comments' "$_tmp/production-$_case" || exit 1
    done
    echo 'Sdoctest bootstrap production-path fixtures: PASS'
    echo 'STATUS: PASS sdoctest-bootstrap-self-test'
    exit 0
fi
[ "$#" -eq 0 ] || { echo "usage: $0 [--self-test]" >&2; exit 2; }

_out=$(mktemp) || exit 2
trap 'rm -f "$_out"' EXIT INT TERM
run_explicit_fixture --sdoctest test/fixtures/doctest/green.md Sdoctest || {
    echo 'STATUS: FAIL sdoctest-markdown-fixture' >&2
    exit 1
}
run_explicit_fixture --spl-doctest test/fixtures/doctest/green.spl 'SPL Doctest' || {
    echo 'STATUS: FAIL sdoctest-comment-fixture' >&2
    exit 1
}
(cd "$ROOT" && "$SIMPLE" test test --whole --mode=interpreter) > "$_out" 2>&1
_rc=$?
if [ "$_rc" -ne 0 ] || ! results_are_green "$_out" ||
   ! lane_is_green "$_out" Sdoctest ||
   ! lane_is_green "$_out" 'SPL Doctest'; then
    tail -n 20 "$_out" >&2
    echo 'STATUS: FAIL sdoctest-markdown-comments' >&2
    exit 1
fi
echo 'STATUS: PASS sdoctest-markdown-comments'
