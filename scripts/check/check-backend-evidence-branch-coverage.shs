#!/bin/sh
# Admit backend evidence checker coverage only from measured LCOV branch data.
# This script validates evidence; it does not infer coverage from test cases.
set -eu

THRESHOLD=95
COVERAGE_FILE=
CPU_MATRIX=
GPU_MATRIX=

usage() {
    echo "usage: $0 --coverage <lcov.info> --cpu-matrix <checker.log> --gpu-matrix <checker.log> [--threshold <0-100>]" >&2
    exit 64
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --coverage) [ "$#" -ge 2 ] || usage; COVERAGE_FILE="$2"; shift 2 ;;
        --cpu-matrix) [ "$#" -ge 2 ] || usage; CPU_MATRIX="$2"; shift 2 ;;
        --gpu-matrix) [ "$#" -ge 2 ] || usage; GPU_MATRIX="$2"; shift 2 ;;
        --threshold) [ "$#" -ge 2 ] || usage; THRESHOLD="$2"; shift 2 ;;
        *) usage ;;
    esac
done

case "$THRESHOLD" in
    ''|*[!0-9]*) usage ;;
esac
[ "$THRESHOLD" -le 100 ] || usage
[ -n "$COVERAGE_FILE" ] && [ -n "$CPU_MATRIX" ] && [ -n "$GPU_MATRIX" ] || usage

measurement_unavailable() {
    echo "backend_branch_coverage status=MEASUREMENT_UNAVAILABLE reason=$1 threshold=$THRESHOLD"
    exit 2
}

fail() {
    echo "backend_branch_coverage status=FAIL reason=$1 threshold=$THRESHOLD"
    exit 1
}

[ -s "$COVERAGE_FILE" ] || measurement_unavailable coverage-evidence-missing
[ -s "$CPU_MATRIX" ] || fail cpu-matrix-evidence-missing
[ -s "$GPU_MATRIX" ] || fail gpu-matrix-evidence-missing

validate_cpu_matrix() {
    matrix_file="$1"
    row_total="$(grep -Ec '^backend=' "$matrix_file" || true)"
    [ "$row_total" -eq 18 ] || return 1
    for backend in llvm cranelift wasm; do
        for stage in \
            "emit backend IR" "validate backend IR" "emit object" \
            "validate object" "link artifact" "run or read back"
        do
            count="$(grep -Ec "^backend=$backend step=$stage status=(PASS|FAIL|SKIP_UNAVAILABLE|NOT_APPLICABLE) reason=[^ ]+ artifact=.+$" "$matrix_file" || true)"
            [ "$count" -eq 1 ] || return 1
        done
    done
    summary_count="$(grep -Ec '^cpu_backend_matrix status=(PASS|FAIL|SKIP_UNAVAILABLE) ' "$matrix_file" || true)"
    [ "$summary_count" -eq 1 ] || return 1
    summary="$(grep -E '^cpu_backend_matrix status=(PASS|FAIL|SKIP_UNAVAILABLE) ' "$matrix_file")"
    summary_status="$(printf '%s\n' "$summary" | sed -n 's/^cpu_backend_matrix status=\([^ ]*\).*/\1/p')"
    summary_failures="$(printf '%s\n' "$summary" | tr ' ' '\n' | sed -n 's/^failures=//p')"
    summary_skips="$(printf '%s\n' "$summary" | tr ' ' '\n' | sed -n 's/^skips=//p')"
    summary_required="$(printf '%s\n' "$summary" | tr ' ' '\n' | sed -n 's/^require_all=//p')"
    summary_not_applicable="$(printf '%s\n' "$summary" | tr ' ' '\n' | sed -n 's/^not_applicable=//p')"
    case "$summary_failures:$summary_skips:$summary_required" in
        *[!0-9:]*|'') return 1 ;;
    esac
    [ "$summary_required" = 0 ] || [ "$summary_required" = 1 ] || return 1
    failures="$(grep -Ec '^backend=.* status=FAIL ' "$matrix_file" || true)"
    skips="$(grep -Ec '^backend=.* status=SKIP_UNAVAILABLE ' "$matrix_file" || true)"
    not_applicable="$(grep -Ec '^backend=.* status=NOT_APPLICABLE ' "$matrix_file" || true)"
    [ "$summary_failures" -eq "$failures" ] || return 1
    [ "$summary_skips" -eq "$skips" ] || return 1
    if [ "$not_applicable" -gt 0 ]; then
        [ "$summary_not_applicable" = "$not_applicable" ] || return 1
    elif [ -n "$summary_not_applicable" ]; then
        [ "$summary_not_applicable" = 0 ] || return 1
    fi
    if [ "$failures" -gt 0 ] || { [ "$summary_required" = 1 ] && [ "$skips" -gt 0 ]; }; then
        expected_status=FAIL
    elif [ "$skips" -gt 0 ]; then
        expected_status=SKIP_UNAVAILABLE
    else
        expected_status=PASS
    fi
    [ "$summary_status" = "$expected_status" ]
}

validate_gpu_matrix() {
    matrix_file="$1"
    row_total="$(grep -Ec '^(cuda|vulkan|metal|hip|opencl)_(emit|validate|link|runtime)_result=' "$matrix_file" || true)"
    [ "$row_total" -eq 20 ] || return 1
    for backend in cuda vulkan metal hip opencl; do
        for stage in emit validate link runtime; do
            count="$(grep -Ec "^${backend}_${stage}_result=(PASS|FAIL|SKIP_UNAVAILABLE|NOT_APPLICABLE)$" "$matrix_file" || true)"
            [ "$count" -eq 1 ] || return 1
            reason_count="$(grep -Ec "^${backend}_${stage}_reason=.+$" "$matrix_file" || true)"
            probe_count="$(grep -Ec "^${backend}_${stage}_probe=.+$" "$matrix_file" || true)"
            [ "$reason_count" -eq 1 ] || return 1
            [ "$probe_count" -eq 1 ] || return 1
        done
    done
    summary_count="$(grep -Ec '^gpu_backend_matrix status=(PASS|FAIL|SKIP_UNAVAILABLE) ' "$matrix_file" || true)"
    [ "$summary_count" -eq 1 ] || return 1
    summary="$(grep -E '^gpu_backend_matrix status=(PASS|FAIL|SKIP_UNAVAILABLE) ' "$matrix_file")"
    summary_status="$(printf '%s\n' "$summary" | sed -n 's/^gpu_backend_matrix status=\([^ ]*\).*/\1/p')"
    summary_backends="$(printf '%s\n' "$summary" | tr ' ' '\n' | sed -n 's/^backends=//p')"
    summary_layers="$(printf '%s\n' "$summary" | tr ' ' '\n' | sed -n 's/^layers=//p')"
    summary_unique="$(printf '%s\n' "$summary" | tr ' ' '\n' | sed -n 's/^unique=//p')"
    summary_expected="$(printf '%s\n' "$summary" | tr ' ' '\n' | sed -n 's/^expected=//p')"
    summary_pass="$(printf '%s\n' "$summary" | tr ' ' '\n' | sed -n 's/^pass=//p')"
    summary_failures="$(printf '%s\n' "$summary" | tr ' ' '\n' | sed -n 's/^failures=//p')"
    summary_skips="$(printf '%s\n' "$summary" | tr ' ' '\n' | sed -n 's/^skips=//p')"
    summary_not_applicable="$(printf '%s\n' "$summary" | tr ' ' '\n' | sed -n 's/^not_applicable=//p')"
    summary_runtime="$(printf '%s\n' "$summary" | tr ' ' '\n' | sed -n 's/^runtime=//p')"
    case "$summary_backends:$summary_layers:$summary_unique:$summary_expected:$summary_pass:$summary_failures:$summary_skips" in
        *[!0-9:]*|'') return 1 ;;
    esac
    [ "$summary_backends" -eq 5 ] || return 1
    [ "$summary_layers" -eq 20 ] || return 1
    [ "$summary_unique" -eq 20 ] || return 1
    [ "$summary_expected" -eq 20 ] || return 1
    [ "$summary_runtime" = true ] || [ "$summary_runtime" = false ] || return 1
    passes="$(grep -Ec '_result=PASS$' "$matrix_file" || true)"
    failures="$(grep -Ec '_result=FAIL$' "$matrix_file" || true)"
    skips="$(grep -Ec '_result=SKIP_UNAVAILABLE$' "$matrix_file" || true)"
    not_applicable="$(grep -Ec '_result=NOT_APPLICABLE$' "$matrix_file" || true)"
    [ "$summary_pass" -eq "$passes" ] || return 1
    [ "$summary_failures" -eq "$failures" ] || return 1
    [ "$summary_skips" -eq "$skips" ] || return 1
    if [ "$not_applicable" -gt 0 ]; then
        [ "$summary_not_applicable" = "$not_applicable" ] || return 1
    elif [ -n "$summary_not_applicable" ]; then
        [ "$summary_not_applicable" = 0 ] || return 1
    fi
    if [ "$failures" -gt 0 ]; then
        expected_status=FAIL
    elif [ "$skips" -gt 0 ]; then
        expected_status=SKIP_UNAVAILABLE
    else
        expected_status=PASS
    fi
    [ "$summary_status" = "$expected_status" ]
}

validate_cpu_matrix "$CPU_MATRIX" || fail cpu-matrix-incomplete-or-malformed
validate_gpu_matrix "$GPU_MATRIX" || fail gpu-matrix-incomplete-or-malformed

PARSED="${TMPDIR:-/tmp}/backend-branch-coverage.$$.parsed"
trap 'rm -f "$PARSED"' EXIT HUP INT TERM

if ! awk '
function checker_for(path) {
    if (path == cpu_path || index(path, "/" cpu_path) == length(path) - length(cpu_path)) return "cpu"
    if (path == gpu_path || index(path, "/" gpu_path) == length(path) - length(gpu_path)) return "gpu"
    return ""
}
function flush_record(    key) {
    key = checker_for(source)
    if (key == "") return
    records[key]++
    if (!have_brf || !have_brh) unavailable[key] = 1
    else {
        reachable[key] += brf
        covered[key] += brh
    }
}
BEGIN {
    cpu_path = "scripts/check/check-cpu-backend-artifacts.shs"
    gpu_path = "scripts/check/check-gpu-backend-layer-evidence.shs"
}
/^SF:/ {
    if (in_record) flush_record()
    source = substr($0, 4)
    in_record = 1
    have_brf = have_brh = 0
    brf = brh = 0
    next
}
/^BRF:/ {
    if ($0 !~ /^BRF:[0-9]+$/) { print "ERROR malformed-branch-count"; exit 3 }
    brf = substr($0, 5) + 0
    have_brf = 1
    next
}
/^BRH:/ {
    if ($0 !~ /^BRH:[0-9]+$/) { print "ERROR malformed-branch-count"; exit 3 }
    brh = substr($0, 5) + 0
    have_brh = 1
    next
}
/^end_of_record$/ {
    if (in_record) flush_record()
    in_record = 0
    source = ""
    next
}
END {
    if (in_record) flush_record()
    if (records["cpu"] != 1 || records["gpu"] != 1) {
        print "ERROR coverage-source-matrix-incomplete-or-duplicate"
        exit 4
    }
    for (i = 1; i <= 2; i++) {
        key = (i == 1 ? "cpu" : "gpu")
        if (unavailable[key] || reachable[key] == 0) print "UNAVAILABLE " key
        else if (covered[key] > reachable[key]) print "ERROR covered-exceeds-reachable-" key
        else print "ROW " key " " covered[key] " " reachable[key]
    }
}
' "$COVERAGE_FILE" >"$PARSED"; then
    reason="$(sed -n 's/^ERROR //p' "$PARSED" | head -n 1)"
    fail "${reason:-malformed-lcov-evidence}"
fi

if grep -q '^ERROR ' "$PARSED"; then
    reason="$(sed -n 's/^ERROR //p' "$PARSED" | head -n 1)"
    fail "$reason"
fi
if grep -q '^UNAVAILABLE ' "$PARSED"; then
    checkers="$(sed -n 's/^UNAVAILABLE //p' "$PARSED" | tr '\n' ',' | sed 's/,$//')"
    measurement_unavailable "branch-counts-unavailable-for-$checkers"
fi

cpu_covered="$(awk '$1 == "ROW" && $2 == "cpu" { print $3 }' "$PARSED")"
cpu_reachable="$(awk '$1 == "ROW" && $2 == "cpu" { print $4 }' "$PARSED")"
gpu_covered="$(awk '$1 == "ROW" && $2 == "gpu" { print $3 }' "$PARSED")"
gpu_reachable="$(awk '$1 == "ROW" && $2 == "gpu" { print $4 }' "$PARSED")"

if [ $((cpu_covered * 100)) -lt $((cpu_reachable * THRESHOLD)) ]; then
    fail cpu-checker-below-threshold
fi
if [ $((gpu_covered * 100)) -lt $((gpu_reachable * THRESHOLD)) ]; then
    fail gpu-checker-below-threshold
fi

covered=$((cpu_covered + gpu_covered))
reachable=$((cpu_reachable + gpu_reachable))
percent_hundredths=$((covered * 10000 / reachable))
printf 'backend_branch_coverage status=PASS threshold=%s covered=%s reachable=%s percent=%s.%02d cpu=%s/%s gpu=%s/%s cpu_matrix=18/18 gpu_matrix=20/20\n' \
    "$THRESHOLD" "$covered" "$reachable" "$((percent_hundredths / 100))" \
    "$((percent_hundredths % 100))" "$cpu_covered" "$cpu_reachable" \
    "$gpu_covered" "$gpu_reachable"
