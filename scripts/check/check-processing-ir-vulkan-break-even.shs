#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

BUILD_DIR="${BUILD_DIR:-build/simpleos_gpu_host/vulkan_break_even}"
EVIDENCE="${EVIDENCE:-$BUILD_DIR/evidence.env}"
RAW_SAMPLES="${RAW_SAMPLES:-$BUILD_DIR/raw-samples.tsv}"
PROVENANCE="${PROVENANCE:-$BUILD_DIR/provenance.env}"
PRODUCER_SOURCE="${PRODUCER_SOURCE:-test/05_perf/local_gpu_check/vulkan_processing_ir_offload_break_even.c}"
PRODUCER="${PRODUCER:-$BUILD_DIR/processing_ir_vulkan_break_even}"
SPIRV_MODULE="${SPIRV_MODULE:-$BUILD_DIR/fill.comp.spv}"
SPIRV_VAL_TOOL="${SPIRV_VAL_TOOL:-spirv-val}"
SPIRV_VAL_TARGET="${SPIRV_VAL_TARGET:-vulkan1.0}"
CC_TOOL="${CC_TOOL:-cc}"
VULKAN_CFLAGS="${VULKAN_CFLAGS:-}"
VULKAN_LIBS="${VULKAN_LIBS:--ldl -lrt}"
WARMUPS="${WARMUPS:-3}"
SAMPLES="${SAMPLES:-5}"
BATCHES="${BATCHES:-64 65536 1048576}"
EXPECTED_EVIDENCE_KIND=live

mkdir -p "$BUILD_DIR"

value_of() { grep "^$1=" "$2" 2>/dev/null | head -1 | cut -d= -f2- || true; }
positive() { printf '%s\n' "$1" | grep -Eq '^[1-9][0-9]*$'; }
nonnegative() { printf '%s\n' "$1" | grep -Eq '^[0-9]+$'; }
sha256() { sha256sum "$1" | cut -d' ' -f1; }

raw_median() {
    awk -v b="$2" -v m="$3" -v c="$4" '$1 == b && $2 == m { print $c }' "$1" |
        sort -n | awk -v n="$((SAMPLES / 2 + 1))" 'NR == n { print; exit }'
}

raw_ids() {
    awk -v b="$2" -v m="$3" '$1 == b && $2 == m { print $3 }' "$1" |
        sort -n | awk -v n="$SAMPLES" '$1 != NR - 1 { exit 1 } END { if (NR != n) exit 1 }'
}

validate_receipt() {
    [ -s "$EVIDENCE" ] || return 1
    declared_raw="$(value_of processing_ir_vulkan_offload_raw_samples "$EVIDENCE")"
    declared_provenance="$(value_of processing_ir_vulkan_offload_provenance_env "$EVIDENCE")"
    [ -n "$declared_raw" ] && [ -n "$declared_provenance" ] || return 1
    RAW_SAMPLES="$declared_raw"
    PROVENANCE="$declared_provenance"
    [ -s "$RAW_SAMPLES" ] && [ -s "$PROVENANCE" ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_status "$EVIDENCE")" = pass ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_schema "$EVIDENCE")" = processing-ir-offload-v1 ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_execution "$EVIDENCE")" = processing_ir ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_backend "$EVIDENCE")" = vulkan ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_evidence_kind "$EVIDENCE")" = "$EXPECTED_EVIDENCE_KIND" ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_aggregate "$EVIDENCE")" = median ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_timing_unit "$EVIDENCE")" = us ] || return 1
    cpu_workload="$(value_of processing_ir_vulkan_offload_cpu_workload_id "$EVIDENCE")"
    [ "$cpu_workload" = dispatch_fill_u32_repeated_v1 ] && [ "$(value_of processing_ir_vulkan_offload_gpu_workload_id "$EVIDENCE")" = "$cpu_workload" ] || return 1
    warmups="$(value_of processing_ir_vulkan_offload_warmup_samples "$EVIDENCE")"
    samples="$(value_of processing_ir_vulkan_offload_measured_samples "$EVIDENCE")"
    rows="$(value_of processing_ir_vulkan_offload_row_count "$EVIDENCE")"
    positive "$warmups" && positive "$samples" && positive "$rows" || return 1
    [ "$warmups" -le 64 ] && [ "$samples" -le 64 ] && [ "$rows" -le 32 ] || return 1
    [ "$warmups" = "$WARMUPS" ] && [ "$samples" = "$SAMPLES" ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_physical_device_admitted "$EVIDENCE")" = true ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_device_type "$EVIDENCE")" = physical ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_cpu_fallback "$EVIDENCE")" = false ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_software_fallback "$EVIDENCE")" = false ] || return 1
    device_type_code="$(value_of processing_ir_vulkan_offload_device_type_code "$EVIDENCE")"
    [ "$device_type_code" = 1 ] || [ "$device_type_code" = 2 ] || return 1
    positive "$(value_of processing_ir_vulkan_offload_device_identity "$EVIDENCE")" || return 1
    positive "$(value_of processing_ir_vulkan_offload_vendor_id "$EVIDENCE")" || return 1
    positive "$(value_of processing_ir_vulkan_offload_device_id "$EVIDENCE")" || return 1
    positive "$(value_of processing_ir_vulkan_offload_api_version "$EVIDENCE")" || return 1
    positive "$(value_of processing_ir_vulkan_offload_driver_version "$EVIDENCE")" || return 1
    nonnegative "$(value_of processing_ir_vulkan_offload_queue_family "$EVIDENCE")" || return 1
    device_name="$(value_of processing_ir_vulkan_offload_device_name "$EVIDENCE")"
    [ -n "$device_name" ] || return 1
    printf '%s\n' "$device_name" | grep -Eiq 'llvmpipe|lavapipe|swiftshader|software' && return 1
    driver_available="$(value_of processing_ir_vulkan_offload_driver_properties_available "$EVIDENCE")"
    [ "$driver_available" = true ] || [ "$driver_available" = false ] || return 1
    if [ "$driver_available" = true ]; then
        positive "$(value_of processing_ir_vulkan_offload_driver_id "$EVIDENCE")" || return 1
        driver_name="$(value_of processing_ir_vulkan_offload_driver_name "$EVIDENCE")"
        [ -n "$driver_name" ] || return 1
        printf '%s\n' "$driver_name" | grep -Eiq 'llvmpipe|lavapipe|swiftshader|software' && return 1
    fi
    [ "$(value_of processing_ir_vulkan_offload_readback_source "$EVIDENCE")" = device_readback ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_readback_exact "$EVIDENCE")" = true ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_mismatch_count "$EVIDENCE")" = 0 ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_producer_source "$EVIDENCE")" = "$(value_of processing_ir_vulkan_offload_source_path "$EVIDENCE")" ] || return 1
    source="$(value_of processing_ir_vulkan_offload_producer_source "$EVIDENCE")"
    artifact="$(value_of processing_ir_vulkan_offload_producer_artifact "$EVIDENCE")"
    source_hash="$(value_of processing_ir_vulkan_offload_producer_source_sha256 "$EVIDENCE")"
    artifact_hash="$(value_of processing_ir_vulkan_offload_producer_artifact_sha256 "$EVIDENCE")"
    spirv="$(value_of processing_ir_vulkan_offload_spirv_module "$EVIDENCE")"
    spirv_hash="$(value_of processing_ir_vulkan_offload_spirv_sha256 "$EVIDENCE")"
    [ -s "$source" ] && [ -s "$artifact" ] && [ -s "$spirv" ] || return 1
    printf '%s\n' "$source_hash" "$artifact_hash" "$spirv_hash" | grep -Eq '^[0-9a-f]{64}$' || return 1
    [ "$source_hash" = "$(sha256 "$source")" ] || return 1
    [ "$artifact_hash" = "$(sha256 "$artifact")" ] || return 1
    [ "$spirv_hash" = "$(sha256 "$spirv")" ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_spirv_validated "$EVIDENCE")" = true ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_source_hash_equal "$EVIDENCE")" = true ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_provenance_source_sha256 "$PROVENANCE")" = "$source_hash" ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_provenance_artifact_sha256 "$PROVENANCE")" = "$artifact_hash" ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_provenance_source_path "$PROVENANCE")" = "$source" ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_provenance_artifact "$PROVENANCE")" = "$artifact" ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_provenance_spirv_module "$PROVENANCE")" = "$spirv" ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_provenance_spirv_sha256 "$PROVENANCE")" = "$spirv_hash" ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_provenance_status "$PROVENANCE")" = pass ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_provenance_physical_device_admitted "$PROVENANCE")" = true ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_provenance_cpu_fallback "$PROVENANCE")" = false ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_provenance_device_type "$PROVENANCE")" = "$device_type_code" ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_provenance_vendor_id "$PROVENANCE")" = "$(value_of processing_ir_vulkan_offload_vendor_id "$EVIDENCE")" ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_provenance_device_id "$PROVENANCE")" = "$(value_of processing_ir_vulkan_offload_device_id "$EVIDENCE")" ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_provenance_driver_properties_available "$PROVENANCE")" = "$driver_available" ] || return 1
    if [ "$driver_available" = true ]; then
        [ "$(value_of processing_ir_vulkan_offload_provenance_driver_id "$PROVENANCE")" = "$(value_of processing_ir_vulkan_offload_driver_id "$EVIDENCE")" ] || return 1
        [ "$(value_of processing_ir_vulkan_offload_provenance_driver_name "$PROVENANCE")" = "$(value_of processing_ir_vulkan_offload_driver_name "$EVIDENCE")" ] || return 1
    fi
    awk -v n="$((rows * samples))" '
        /^#/ { next } NF != 10 { exit 1 }
        $1 !~ /^[0-9]+$/ || ($2 != "batched" && $2 != "per_command") ||
        $3 !~ /^[0-9]+$/ || $4 !~ /^[0-9]+$/ || $5 !~ /^[0-9]+$/ || $6 !~ /^[0-9]+$/ ||
        $7 !~ /^[0-9]+$/ || $8 !~ /^[0-9]+$/ || $9 !~ /^[0-9]+$/ || $10 !~ /^[0-9]+$/ ||
        $4 < 1 || $5 < 1 || $6 < 1 || $7 < 1 || $8 != $5 + $7 || $9 != $5 + $6 + $7 || $10 != 0 { exit 1 }
        { count++ } END { if (count != n) exit 1 }
    ' "$RAW_SAMPLES" || return 1
    previous=0; previous_mode=""; first_fast=0; first_fast_communication=0; largest_slow=0; saw_lower_slow=0; saw_batched=0; saw_per=0; batched_count=0
    i=0
    while [ "$i" -lt "$rows" ]; do
        prefix=processing_ir_vulkan_offload_row_${i}_
        for field in batch workload_id cpu_us upload_us device_us readback_us transfer_us total_us upload_bytes readback_bytes command_count dispatch_count workgroup_count submission_mode readback_source readback_exact readback_mismatch_count decision; do
            [ "$(grep -c "^${prefix}${field}=" "$EVIDENCE" || true)" -eq 1 ] || return 1
        done
        b="$(value_of "${prefix}batch" "$EVIDENCE")"; mode="$(value_of "${prefix}submission_mode" "$EVIDENCE")"
        cpu="$(value_of "${prefix}cpu_us" "$EVIDENCE")"; up="$(value_of "${prefix}upload_us" "$EVIDENCE")"; dev="$(value_of "${prefix}device_us" "$EVIDENCE")"; down="$(value_of "${prefix}readback_us" "$EVIDENCE")"; tr="$(value_of "${prefix}transfer_us" "$EVIDENCE")"; total="$(value_of "${prefix}total_us" "$EVIDENCE")"
        upload_bytes="$(value_of "${prefix}upload_bytes" "$EVIDENCE")"; readback_bytes="$(value_of "${prefix}readback_bytes" "$EVIDENCE")"; command_count="$(value_of "${prefix}command_count" "$EVIDENCE")"
        dispatch_count="$(value_of "${prefix}dispatch_count" "$EVIDENCE")"; workgroup_count="$(value_of "${prefix}workgroup_count" "$EVIDENCE")"
        [ "$(value_of "${prefix}workload_id" "$EVIDENCE")" = "$cpu_workload" ] || return 1
        positive "$b" && positive "$cpu" && positive "$up" && positive "$dev" && positive "$down" && positive "$tr" && positive "$total" || return 1
        positive "$upload_bytes" && positive "$readback_bytes" && positive "$command_count" && positive "$dispatch_count" && positive "$workgroup_count" || return 1
        [ "$b" -le 67108864 ] && [ "$cpu" -le 1000000000000 ] && [ "$up" -le 1000000000000 ] && [ "$dev" -le 1000000000000 ] && [ "$down" -le 1000000000000 ] && [ "$tr" -le 1000000000000 ] && [ "$total" -le 1000000000000 ] || return 1
        [ "$mode" = batched ] || [ "$mode" = per_command ] || return 1
        if [ "$mode" = batched ]; then [ "$command_count" = 1 ] || return 1; else [ "$command_count" = 4 ] || return 1; fi
        [ "$dispatch_count" -eq "$((command_count * 64))" ] || return 1
        [ "$(value_of "${prefix}readback_source" "$EVIDENCE")" = device_readback ] && [ "$(value_of "${prefix}readback_exact" "$EVIDENCE")" = true ] && [ "$(value_of "${prefix}readback_mismatch_count" "$EVIDENCE")" = 0 ] || return 1
        [ "$mode" = batched ] && { [ "$b" -gt "$previous" ] || return 1; saw_batched=1; batched_count=$((batched_count + 1)); } || { [ "$previous_mode" = batched ] && [ "$b" -eq "$previous" ] || return 1; saw_per=1; }
        [ "$(awk -v b="$b" -v m="$mode" '$1 == b && $2 == m { n++ } END { print n + 0 }' "$RAW_SAMPLES")" -eq "$samples" ] || return 1
        raw_ids "$RAW_SAMPLES" "$b" "$mode" || return 1
        [ "$(raw_median "$RAW_SAMPLES" "$b" "$mode" 4)" = "$cpu" ] && [ "$(raw_median "$RAW_SAMPLES" "$b" "$mode" 5)" = "$up" ] && [ "$(raw_median "$RAW_SAMPLES" "$b" "$mode" 6)" = "$dev" ] && [ "$(raw_median "$RAW_SAMPLES" "$b" "$mode" 7)" = "$down" ] && [ "$(raw_median "$RAW_SAMPLES" "$b" "$mode" 8)" = "$tr" ] && [ "$(raw_median "$RAW_SAMPLES" "$b" "$mode" 9)" = "$total" ] || return 1
        if [ "$total" -lt "$cpu" ]; then [ "$(value_of "${prefix}decision" "$EVIDENCE")" = gpu ] || return 1; if [ "$first_fast" -eq 0 ]; then first_fast="$b"; first_fast_communication=$((up + down)); fi; [ "$largest_slow" -gt 0 ] && [ "$largest_slow" -lt "$b" ] && saw_lower_slow=1; else [ "$(value_of "${prefix}decision" "$EVIDENCE")" = cpu ] || return 1; [ "$b" -gt "$largest_slow" ] && largest_slow="$b"; fi
        previous="$b"; previous_mode="$mode"; i=$((i + 1))
    done
    [ "$first_fast" -gt 0 ] && [ "$saw_lower_slow" -eq 1 ] && [ "$saw_batched" -eq 1 ] && [ "$saw_per" -eq 1 ] && [ "$batched_count" -ge 3 ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_break_even_batch "$EVIDENCE")" = "$first_fast" ] || return 1
    [ "$(value_of processing_ir_vulkan_offload_communication_overhead_us "$EVIDENCE")" = "$first_fast_communication" ] || return 1
}

self_test() {
    [ -n "$SPIRV_VAL_TARGET" ] || return 1
    d="$BUILD_DIR/self-test"; mkdir -p "$d"; old_e="$EVIDENCE"; old_p="$PROVENANCE"; old_k="$EXPECTED_EVIDENCE_KIND"
    EVIDENCE="$d/evidence.env"; PROVENANCE="$d/provenance.env"; EXPECTED_EVIDENCE_KIND=validator-self-test
    source="$d/producer.c"; artifact="$d/producer"; spirv="$d/fill.spv"
    printf 'synthetic producer\n' >"$source"; printf 'synthetic artifact\n' >"$artifact"; printf '\003\002#\007synthetic\n' >"$spirv"
    source_hash="$(sha256 "$source")"; artifact_hash="$(sha256 "$artifact")"; spirv_hash="$(sha256 "$spirv")"
    {
        echo '# batch mode sample cpu_us upload_us device_us readback_us transfer_us total_us mismatch_count'
        for x in '1 batched 2 1 1 1' '1 per_command 2 1 1 2' '2 batched 20 1 1 1' '2 per_command 20 1 1 2' '4 batched 30 1 1 1' '4 per_command 30 1 1 2'; do set -- $x; for s in 0 1 2 3 4; do echo "$1 $2 $s $3 $4 $5 $6 $(( $4 + $6 )) $(( $4 + $5 + $6 )) 0"; done; done
    } >"$RAW_SAMPLES"
    cat >"$PROVENANCE" <<EOF
processing_ir_vulkan_offload_provenance_status=pass
processing_ir_vulkan_offload_provenance_source_path=$source
processing_ir_vulkan_offload_provenance_artifact=$artifact
processing_ir_vulkan_offload_provenance_source_sha256=$source_hash
processing_ir_vulkan_offload_provenance_artifact_sha256=$artifact_hash
processing_ir_vulkan_offload_provenance_spirv_module=$spirv
processing_ir_vulkan_offload_provenance_spirv_sha256=$spirv_hash
processing_ir_vulkan_offload_provenance_physical_device_admitted=true
processing_ir_vulkan_offload_provenance_cpu_fallback=false
processing_ir_vulkan_offload_provenance_device_type=2
processing_ir_vulkan_offload_provenance_vendor_id=1
processing_ir_vulkan_offload_provenance_device_id=1
processing_ir_vulkan_offload_provenance_driver_properties_available=true
processing_ir_vulkan_offload_provenance_driver_id=1
processing_ir_vulkan_offload_provenance_driver_name=synthetic-driver
EOF
    {
        echo 'processing_ir_vulkan_offload_status=pass'; echo 'processing_ir_vulkan_offload_schema=processing-ir-offload-v1'; echo 'processing_ir_vulkan_offload_execution=processing_ir'; echo 'processing_ir_vulkan_offload_backend=vulkan'; echo 'processing_ir_vulkan_offload_evidence_kind=validator-self-test'; echo 'processing_ir_vulkan_offload_cpu_workload_id=dispatch_fill_u32_repeated_v1'; echo 'processing_ir_vulkan_offload_gpu_workload_id=dispatch_fill_u32_repeated_v1'; echo 'processing_ir_vulkan_offload_aggregate=median'; echo 'processing_ir_vulkan_offload_timing_unit=us'; echo 'processing_ir_vulkan_offload_warmup_samples=3'; echo 'processing_ir_vulkan_offload_measured_samples=5'; echo 'processing_ir_vulkan_offload_row_count=6'; echo 'processing_ir_vulkan_offload_physical_device_admitted=true'; echo 'processing_ir_vulkan_offload_device_type=physical'; echo 'processing_ir_vulkan_offload_device_type_code=2'; echo 'processing_ir_vulkan_offload_cpu_fallback=false'; echo 'processing_ir_vulkan_offload_software_fallback=false'; echo 'processing_ir_vulkan_offload_device_identity=1'; echo 'processing_ir_vulkan_offload_device_name=synthetic-gpu'; echo 'processing_ir_vulkan_offload_vendor_id=1'; echo 'processing_ir_vulkan_offload_device_id=1'; echo 'processing_ir_vulkan_offload_api_version=1'; echo 'processing_ir_vulkan_offload_driver_version=1'; echo 'processing_ir_vulkan_offload_queue_family=0'; echo 'processing_ir_vulkan_offload_driver_properties_available=true'; echo 'processing_ir_vulkan_offload_driver_id=1'; echo 'processing_ir_vulkan_offload_driver_name=synthetic-driver'; echo 'processing_ir_vulkan_offload_readback_source=device_readback'; echo 'processing_ir_vulkan_offload_readback_exact=true'; echo 'processing_ir_vulkan_offload_mismatch_count=0'; echo "processing_ir_vulkan_offload_raw_samples=$RAW_SAMPLES"; echo "processing_ir_vulkan_offload_producer_source=$source"; echo "processing_ir_vulkan_offload_source_path=$source"; echo "processing_ir_vulkan_offload_producer_source_sha256=$source_hash"; echo "processing_ir_vulkan_offload_producer_artifact=$artifact"; echo "processing_ir_vulkan_offload_producer_artifact_sha256=$artifact_hash"; echo "processing_ir_vulkan_offload_spirv_module=$spirv"; echo "processing_ir_vulkan_offload_spirv_sha256=$spirv_hash"; echo 'processing_ir_vulkan_offload_spirv_validated=true'; echo 'processing_ir_vulkan_offload_source_hash_equal=true'; echo "processing_ir_vulkan_offload_provenance_env=$PROVENANCE"; echo 'processing_ir_vulkan_offload_communication_overhead_us=2'; echo 'processing_ir_vulkan_offload_break_even_batch=2'
        i=0; for x in '1 batched 2 1 1 1 cpu' '1 per_command 2 1 1 2 cpu' '2 batched 20 1 1 1 gpu' '2 per_command 20 1 1 2 gpu' '4 batched 30 1 1 1 gpu' '4 per_command 30 1 1 2 gpu'; do set -- $x; if [ "$2" = batched ]; then commands=1; else commands=4; fi; echo "processing_ir_vulkan_offload_row_${i}_batch=$1"; echo "processing_ir_vulkan_offload_row_${i}_workload_id=dispatch_fill_u32_repeated_v1"; echo "processing_ir_vulkan_offload_row_${i}_cpu_us=$3"; echo "processing_ir_vulkan_offload_row_${i}_upload_us=$4"; echo "processing_ir_vulkan_offload_row_${i}_device_us=$5"; echo "processing_ir_vulkan_offload_row_${i}_readback_us=$6"; echo "processing_ir_vulkan_offload_row_${i}_transfer_us=$(( $4 + $6 ))"; echo "processing_ir_vulkan_offload_row_${i}_total_us=$(( $4 + $5 + $6 ))"; echo "processing_ir_vulkan_offload_row_${i}_upload_bytes=4"; echo "processing_ir_vulkan_offload_row_${i}_readback_bytes=4"; echo "processing_ir_vulkan_offload_row_${i}_command_count=$commands"; echo "processing_ir_vulkan_offload_row_${i}_dispatch_count=$((commands * 64))"; echo "processing_ir_vulkan_offload_row_${i}_workgroup_count=$((commands * 64))"; echo "processing_ir_vulkan_offload_row_${i}_submission_mode=$2"; echo "processing_ir_vulkan_offload_row_${i}_readback_source=device_readback"; echo "processing_ir_vulkan_offload_row_${i}_readback_exact=true"; echo "processing_ir_vulkan_offload_row_${i}_readback_mismatch_count=0"; echo "processing_ir_vulkan_offload_row_${i}_decision=$7"; i=$((i+1)); done
    } >"$EVIDENCE"
    validate_receipt || return 1
    EXPECTED_EVIDENCE_KIND=live
    if validate_receipt; then return 1; fi
    EVIDENCE="$old_e"; PROVENANCE="$old_p"; EXPECTED_EVIDENCE_KIND="$old_k"; echo processing_ir_vulkan_self_test=pass
}

case "${1:-}" in
    --self-test) self_test; exit 0 ;;
    --validate) [ "$#" -eq 2 ] || exit 2; EVIDENCE="$2"; validate_receipt; echo processing_ir_vulkan_validation=pass; exit 0 ;;
    --help) echo "usage: $0 [--self-test|--validate EVIDENCE]"; exit 0 ;;
esac

rm -f "$EVIDENCE" "$RAW_SAMPLES" "$PROVENANCE" "$PRODUCER" "$SPIRV_MODULE"
[ -s "$PRODUCER_SOURCE" ] || { echo processing_ir_vulkan_status=unavailable; echo processing_ir_vulkan_reason=producer-source-missing; exit 1; }
source_hash="$(sha256 "$PRODUCER_SOURCE")"
# The producer owns device admission and emits the receipt; this wrapper only compiles and validates it.
if ! $CC_TOOL $VULKAN_CFLAGS -O2 -std=c99 -Wall -Wextra -Werror "$PRODUCER_SOURCE" $VULKAN_LIBS -o "$PRODUCER" >"$BUILD_DIR/compile.out" 2>"$BUILD_DIR/compile.err"; then exit 1; fi
command -v "$SPIRV_VAL_TOOL" >/dev/null 2>&1 || { echo processing_ir_vulkan_status=unavailable; echo processing_ir_vulkan_reason=spirv-val-missing; exit 1; }
"$PRODUCER" --dump-spirv "$SPIRV_MODULE"
"$SPIRV_VAL_TOOL" --target-env "$SPIRV_VAL_TARGET" "$SPIRV_MODULE" >"$BUILD_DIR/spirv-val.out" 2>"$BUILD_DIR/spirv-val.err"
source_hash="$(sha256 "$PRODUCER_SOURCE")"
if ! VULKAN_PROCESSING_IR_SOURCE_SHA256="$source_hash" VULKAN_PROCESSING_IR_SOURCE_PATH="$PRODUCER_SOURCE" \
    "$PRODUCER" "$RAW_SAMPLES" "$PROVENANCE" "$WARMUPS" "$SAMPLES" $BATCHES \
    >"$BUILD_DIR/producer.out" 2>"$BUILD_DIR/producer.err"; then exit 1; fi
grep '^processing_ir_vulkan_offload_' "$BUILD_DIR/producer.out" >"$EVIDENCE"
artifact_hash="$(sha256 "$PRODUCER")"
spirv_hash="$(sha256 "$SPIRV_MODULE")"
{
    echo "processing_ir_vulkan_offload_producer_source=$PRODUCER_SOURCE"
    echo "processing_ir_vulkan_offload_source_path=$PRODUCER_SOURCE"
    echo "processing_ir_vulkan_offload_producer_source_sha256=$source_hash"
    echo "processing_ir_vulkan_offload_producer_artifact=$PRODUCER"
    echo "processing_ir_vulkan_offload_producer_artifact_sha256=$artifact_hash"
    echo "processing_ir_vulkan_offload_spirv_module=$SPIRV_MODULE"
    echo "processing_ir_vulkan_offload_spirv_sha256=$spirv_hash"
    echo "processing_ir_vulkan_offload_spirv_validated=true"
    echo "processing_ir_vulkan_offload_source_hash_equal=true"
} >>"$EVIDENCE"
{
    echo "processing_ir_vulkan_offload_provenance_artifact=$PRODUCER"
    echo "processing_ir_vulkan_offload_provenance_artifact_sha256=$artifact_hash"
    echo "processing_ir_vulkan_offload_provenance_spirv_module=$SPIRV_MODULE"
    echo "processing_ir_vulkan_offload_provenance_spirv_sha256=$spirv_hash"
} >>"$PROVENANCE"
validate_receipt
cat "$EVIDENCE"
