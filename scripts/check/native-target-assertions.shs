#!/bin/sh

require_nonempty_target_object() {
    [ -s "$1" ]
}

require_target_machine() (
    readelf_tool="$1"
    target_object="$2"
    elf_class="$3"
    machine="$4"
    require_nonempty_target_object "$target_object"
    target_header="$(LC_ALL=C "$readelf_tool" -h "$target_object")"
    printf '%s\n' "$target_header" | grep -Eq "Class:[[:space:]]+$elf_class"
    printf '%s\n' "$target_header" | grep -Eq 'Type:[[:space:]]+REL([[:space:]]|$)'
    printf '%s\n' "$target_header" | grep -Eq "Machine:[[:space:]]+$machine([[:space:]]|$)"
)

require_coff_machine() (
    readobj_tool="$1"
    target_object="$2"
    coff_format="$3"
    machine="$4"
    require_nonempty_target_object "$target_object"
    target_header="$("$readobj_tool" --file-headers "$target_object")"
    printf '%s\n' "$target_header" | grep -Fq "Format: $coff_format"
    printf '%s\n' "$target_header" | grep -Fq "Machine: $machine"
    printf '%s\n' "$target_header" | grep -Eq 'OptionalHeaderSize:[[:space:]]+0([[:space:]]|$)'
    if printf '%s\n' "$target_header" | grep -Fq 'IMAGE_FILE_EXECUTABLE_IMAGE'; then
        return 1
    fi
)

require_runtime_exit() (
    expected_exit="$1"
    shift
    runtime_status=0
    "$@" || runtime_status=$?
    [ "$runtime_status" -eq "$expected_exit" ]
)
