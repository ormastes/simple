#!/bin/sh
# Prove the `simpleos_screen_*` evidence gate FAILS CLOSED.
#
# A gate that has never been shown to fail is not a gate. This wrapper builds a
# synthetic evidence file in which every one of the 28 required
# `simpleos_screen_<T>_<suffix>` rows is present and valid, confirms the
# checker exits 0, then deletes ONE row at a time and confirms the checker
# exits non-zero with a `blocked:screen-<T>:...` verdict.
#
# The five pre-existing aggregate statuses are declared directly in the file
# (`status_or_default` honours a declared row) so this proof isolates the
# screen gate. `simpleos_screen_evidence_status` is deliberately NOT honoured
# from the file -- it is always derived -- which this proof also demonstrates
# by planting a false `simpleos_screen_evidence_status=pass` row.
#
# Usage: sh scripts/check/check-simpleos-screen-evidence-gate-proof.shs

set -e

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"

CHECKER="scripts/check/check_simpleos_multiconfig_live_evidence.spl"
OUT_DIR="${SIMPLEOS_SCREEN_GATE_PROOF_DIR:-build/os/screen_evidence_gate_proof}"
BASE="$OUT_DIR/screen-evidence-full.txt"
REPORT="$OUT_DIR/gate-proof.txt"

rm -rf "$OUT_DIR"
mkdir -p "$OUT_DIR"

SCREEN_TYPES="wm 2d web gui"
SUFFIXES="boot_status selected_effective serial_marker_count screendump_path screendump_bytes screendump_distinct_colors fallback_reason"

emit_row() {
    # $1 = type, $2 = suffix
    case "$2" in
        boot_status)                 echo "simpleos_screen_$1_boot_status=pass" ;;
        selected_effective)          echo "simpleos_screen_$1_selected_effective=$1" ;;
        serial_marker_count)         echo "simpleos_screen_$1_serial_marker_count=1" ;;
        screendump_path)             echo "simpleos_screen_$1_screendump_path=$OUT_DIR/$1.ppm" ;;
        screendump_bytes)            echo "simpleos_screen_$1_screendump_bytes=2359311" ;;
        screendump_distinct_colors)  echo "simpleos_screen_$1_screendump_distinct_colors=1274" ;;
        fallback_reason)             echo "simpleos_screen_$1_fallback_reason=none" ;;
    esac
}

write_evidence() {
    # $1 = target file, $2 = "type:suffix" row to OMIT (or "" for none)
    omit="$2"
    {
        echo "simpleos_qemu_service_evidence_status=pass"
        echo "simpleos_fpga_serial_evidence_status=pass"
        echo "simpleos_engine2d_vulkan_evidence_status=pass"
        echo "simpleos_renderdoc_artifact_evidence_status=pass"
        echo "simpleos_wm_structured_compare_evidence_status=pass"
        echo "simpleos_wm_renderdoc_evidence_status=pass"
        # Deliberately false: must NOT be honoured, the status is derived.
        echo "simpleos_screen_evidence_status=pass"
        for t in $SCREEN_TYPES; do
            for s in $SUFFIXES; do
                [ "$t:$s" = "$omit" ] && continue
                emit_row "$t" "$s"
            done
        done
    } > "$1"
}

run_checker() {
    set +e
    bin/simple run "$CHECKER" --evidence "$1" > "$2" 2>&1
    code=$?
    set -e
    echo "$code"
}

: > "$REPORT"
FAILURES=0

# --- baseline: every required row present -> exit 0 -------------------------
write_evidence "$BASE" ""
BASE_LOG="$OUT_DIR/baseline.log"
BASE_CODE=$(run_checker "$BASE" "$BASE_LOG")
BASE_VERDICT=$(grep -a '^simpleos_multiconfig_live_status=' "$BASE_LOG" | tail -1)
BASE_SCREEN=$(grep -a '^simpleos_screen_evidence_status=' "$BASE_LOG" | tail -1)
echo "screen_gate_baseline_exit_code=$BASE_CODE" >> "$REPORT"
echo "screen_gate_baseline_$BASE_VERDICT" >> "$REPORT"
echo "screen_gate_baseline_$BASE_SCREEN" >> "$REPORT"
if [ "$BASE_CODE" -ne 0 ]; then
    echo "screen_gate_baseline_status=fail" >> "$REPORT"
    FAILURES=$((FAILURES + 1))
else
    echo "screen_gate_baseline_status=pass" >> "$REPORT"
fi

# --- delete each required row in turn -> must exit non-zero -----------------
CHECKED=0
for t in $SCREEN_TYPES; do
    for s in $SUFFIXES; do
        f="$OUT_DIR/missing-$t-$s.txt"
        l="$OUT_DIR/missing-$t-$s.log"
        write_evidence "$f" "$t:$s"
        code=$(run_checker "$f" "$l")
        screen=$(grep -a '^simpleos_screen_evidence_status=' "$l" | tail -1)
        CHECKED=$((CHECKED + 1))
        if [ "$code" -eq 0 ]; then
            echo "screen_gate_row_${t}_${s}=FAIL-OPEN exit=$code $screen" >> "$REPORT"
            FAILURES=$((FAILURES + 1))
        else
            echo "screen_gate_row_${t}_${s}=gated exit=$code $screen" >> "$REPORT"
        fi
    done
done

echo "screen_gate_rows_checked=$CHECKED" >> "$REPORT"
echo "screen_gate_report=$REPORT" >> "$REPORT"

if [ "$FAILURES" -ne 0 ]; then
    echo "FAIL — $FAILURES of $((CHECKED + 1)) screen-evidence gate checks did not fail closed (see $REPORT)"
    exit 1
fi

echo "PASS — $CHECKED required simpleos_screen_* rows each flip the verdict to fail when deleted; baseline with all rows exits 0 (see $REPORT)"
