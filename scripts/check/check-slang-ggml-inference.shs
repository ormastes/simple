#!/bin/sh
# Evidence gate: every model in a real model root reaches a verdict THROUGH
# CARET -- generated tokens, or a refusal that says why -- and none is silently
# dropped.
#
# WHY IT DRIVES CARET AND NOT SLANG DIRECTLY
#
# The claim under test is "a local model runs through caret", so the check
# invokes caret exactly as an operator would. Driving slang's entrypoint
# directly would prove a smaller thing and would let a caret-side regression
# (a provider not registered, a response field left nil, an error swallowed)
# pass unnoticed -- and a nil response field is precisely what broke this path
# during bring-up.
#
# WHAT FAILURE IT EXISTS TO CATCH
#
# Not "inference is broken" -- that is loud. The quiet one: slang pointed at a
# root holding three real multi-gigabyte models reported NOTHING and looked
# healthy doing it. So the gate asserts a COUNT (every directory reaches a
# verdict) and asserts that no refusal is empty. A refusal without a reason is
# a FAIL here even though nothing crashed.
#
# MEMORY
#
# Models are loaded one at a time and released between runs, because this class
# of host (DGX Spark GB10) shares one 128 GB pool between CPU and GPU: a model
# that does not fit does not swap, it takes the machine down. slang refuses an
# over-budget load itself; this gate never overrides that, and a refusal for
# non-fit is recorded as a refusal, never as a pass.
#
# Verdict is the last line of stdout:
#   PASS  -- <n> model(s) reached a verdict, <k> generated, <r> refused ...  exit 0
#   FAIL  -- <reason>                                                        exit 1
#   ERROR -- nothing was checked (<reason>)                                  exit 2
#
# Non-vacuity is absolute: zero models is ERROR, a missing binary is ERROR, a
# missing backend library is ERROR. Absence of evidence is never a pass.
set -u

ROOT=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
cd "$ROOT" || { echo "ERROR -- nothing was checked (cannot cd to repo root)"; exit 2; }

MODEL_ROOT=${SLANG_MODEL_ROOT:-}
LIB=${SLANG_GGML_LIB:-$ROOT/build/sffi/libslang_ggml.so}
MAX_TOKENS=${SLANG_PROBE_MAX_TOKENS:-40}
TIMEOUT_S=${SLANG_PROBE_TIMEOUT_SECONDS:-1800}
SELFTEST_ONLY=0
PROMPT="In one sentence: what is a compiler?"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --models) MODEL_ROOT=${2:-}; shift 2 ;;
        --models=*) MODEL_ROOT=${1#--models=}; shift ;;
        --selftest) SELFTEST_ONLY=1; shift ;;
        --help|-h)
            echo "usage: sh scripts/check/check-slang-ggml-inference.shs --models DIR"
            echo "  (or set SLANG_MODEL_ROOT). SLANG_GGML_LIB overrides the backend path."
            exit 0 ;;
        *) echo "ERROR -- nothing was checked (unknown argument: $1)"; exit 2 ;;
    esac
done

# ---------------------------------------------------------------- selftest --
# Classifies one caret run. Kept as a function so the part that can turn a bad
# run into a good one is itself under test.
#
# Echoes one of: "generated", "refused <reason>", "silent".
classify_caret_run() {
    _file=$1
    _err=$(grep -m1 '^ERROR: ' "$_file" 2>/dev/null | sed 's/^ERROR: //')
    if [ -n "$_err" ]; then
        printf 'refused %s\n' "$_err"
        return 0
    fi
    # An error line with nothing after it is the silent-refusal shape: caret
    # reported a failure and told the operator nothing usable.
    if grep -q '^ERROR:[[:space:]]*$' "$_file" 2>/dev/null; then
        echo silent
        return 0
    fi
    _answer=$(grep -vE '^\[gc-warning\]|^warning:|^\[use-warning\]|^ggml_|^llama_|^load_|^create_tensor|^print_info|^init_|^sched_|^graph_|^resolve_fused|^CUDA |^\.+$|^[[:space:]]*$|^[[:space:]]*\||^[[:space:]]*-->|^Use |^Example' "$_file" 2>/dev/null | tail -1)
    if [ -n "$_answer" ]; then
        echo generated
        return 0
    fi
    echo silent
}

self_test() {
    _t=$(mktemp -d) || return 2

    printf '%s\n' 'ggml_backend_cuda: loading' 'A compiler translates source code.' > "$_t/ok"
    [ "$(classify_caret_run "$_t/ok")" = "generated" ] || { echo "selftest: a real answer was not classified as generated" >&2; rm -rf "$_t"; return 1; }

    printf '%s\n' 'ERROR: safetensors recognised; the ggml backend reads GGUF only' > "$_t/refused"
    case "$(classify_caret_run "$_t/refused")" in
        "refused safetensors recognised; the ggml backend reads GGUF only") : ;;
        *) echo "selftest: a refusal did not carry its reason through" >&2; rm -rf "$_t"; return 1 ;;
    esac

    # The bug this gate exists to catch: a failure with no reason attached.
    printf '%s\n' 'ERROR: ' > "$_t/silent"
    [ "$(classify_caret_run "$_t/silent")" = "silent" ] || { echo "selftest: a reasonless refusal was not flagged silent" >&2; rm -rf "$_t"; return 1; }

    # Backend noise alone is not an answer -- otherwise a run that loaded a
    # model and produced no tokens would score as a pass.
    printf '%s\n' 'ggml_backend_cuda: loading' 'load_tensors: offloaded 49/49' '.........' > "$_t/noise"
    [ "$(classify_caret_run "$_t/noise")" = "silent" ] || { echo "selftest: backend noise was mistaken for an answer" >&2; rm -rf "$_t"; return 1; }

    # An empty run must not read as success.
    : > "$_t/empty"
    [ "$(classify_caret_run "$_t/empty")" = "silent" ] || { echo "selftest: empty output was not flagged silent" >&2; rm -rf "$_t"; return 1; }

    # A refusal wins over trailing noise, so an error is never masked by a log
    # line that happens to come after it.
    printf '%s\n' 'ERROR: would not fit' 'ggml_backend_cuda: teardown' 'trailing' > "$_t/both"
    case "$(classify_caret_run "$_t/both")" in
        refused*) : ;;
        *) echo "selftest: an error was masked by trailing output" >&2; rm -rf "$_t"; return 1 ;;
    esac

    rm -rf "$_t"
    return 0
}

self_test || { echo "FAIL -- selftest failed"; exit 1; }
[ "$SELFTEST_ONLY" -eq 1 ] && { echo "PASS -- 6 selftest fixture(s) checked, scan not requested"; exit 0; }

# ------------------------------------------------------------ preconditions --
[ -n "$MODEL_ROOT" ] || { echo "ERROR -- nothing was checked (no model root: pass --models DIR or set SLANG_MODEL_ROOT)"; exit 2; }
[ -d "$MODEL_ROOT" ] || { echo "ERROR -- nothing was checked (model root $MODEL_ROOT does not exist)"; exit 2; }
[ -f "$LIB" ] || { echo "ERROR -- nothing was checked (ggml backend $LIB absent; build it with scripts/check/build-slang-ggml-shim.shs)"; exit 2; }
command -v timeout >/dev/null 2>&1 || { echo "ERROR -- nothing was checked (no timeout(1) to bound a run)"; exit 2; }

if [ -n "${SIMPLE_BINARY:-}" ]; then
    SIMPLE=$SIMPLE_BINARY
elif [ -x "$ROOT/bin/simple" ]; then
    SIMPLE=$ROOT/bin/simple
elif [ -x "$ROOT/src/compiler_rust/target/bootstrap/simple" ]; then
    # The bootstrap seed. Named in the verdict so no reader mistakes a seed run
    # for self-hosted evidence.
    SIMPLE=$ROOT/src/compiler_rust/target/bootstrap/simple
else
    echo "ERROR -- nothing was checked (no Simple binary: bin/simple absent and no bootstrap seed)"
    exit 2
fi

WORK=$(mktemp -d) || { echo "ERROR -- nothing was checked (cannot create temp dir)"; exit 2; }
trap 'rm -rf "$WORK"' EXIT HUP INT TERM

# Directory names only. Which of these is a model, what format it is, whether it
# fits and whether it can run are all slang's decisions, reached inside caret --
# this loop just refuses to skip any of them.
models=$(find "$MODEL_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)
[ -n "$models" ] || { echo "ERROR -- nothing was checked (no directories under $MODEL_ROOT)"; exit 2; }

total=0
generated=0
refused=0
silent=0
silent_names=""

for m in $models; do
    total=$((total + 1))
    log=$WORK/$m.log
    SLANG_MODEL_ROOT=$MODEL_ROOT SLANG_GGML_LIB=$LIB \
        timeout "$TIMEOUT_S" "$SIMPLE" run src/app/llm_caret/main.spl \
        --provider slang_local --model "$m" --prompt "$PROMPT" > "$log" 2>&1
    # Read the status on the next line, never through a pipe: a pipeline's $?
    # belongs to its last stage and has produced false greens in this repo.
    run_rc=$?
    if [ "$run_rc" -eq 124 ]; then
        echo "MODEL $m -> TIMEOUT after ${TIMEOUT_S}s"
        silent=$((silent + 1))
        silent_names="$silent_names $m(timeout)"
        continue
    fi
    verdict=$(classify_caret_run "$log")
    case "$verdict" in
        generated)
            generated=$((generated + 1))
            answer=$(grep -vE '^\[gc-warning\]|^warning:|^\[use-warning\]|^ggml_|^llama_|^load_|^create_tensor|^print_info|^init_|^sched_|^graph_|^resolve_fused|^CUDA |^\.+$|^[[:space:]]*$|^[[:space:]]*\||^[[:space:]]*-->|^Use |^Example' "$log" | tail -1)
            echo "MODEL $m -> GENERATED: $answer"
            ;;
        refused*)
            refused=$((refused + 1))
            echo "MODEL $m -> REFUSED: ${verdict#refused }"
            ;;
        *)
            silent=$((silent + 1))
            silent_names="$silent_names $m"
            echo "MODEL $m -> SILENT (no answer and no reason; exit $run_rc)"
            ;;
    esac
done

if [ "$total" -eq 0 ]; then
    echo "ERROR -- nothing was checked (no model directory reached a verdict)"
    exit 2
fi

if [ "$silent" -gt 0 ]; then
    echo "FAIL -- $total model(s) reached a verdict, $silent silent (no answer and no reason):$silent_names"
    exit 1
fi

if [ "$generated" -eq 0 ]; then
    echo "FAIL -- $total model(s) reached a verdict, all $refused refused, none generated: no model was actually run"
    exit 1
fi

echo "PASS -- $total model(s) reached a verdict, $generated generated, $refused refused with a reason, 0 silent (binary: $SIMPLE)"
exit 0
