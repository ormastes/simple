#!/bin/sh
# Enterprise suite enumeration gate (lane W17-C) — the on-disk canonical
# enterprise spec/library set must stay at exactly EXPECTED files. It exists so
# a spec cannot be silently DELETED (the suite shrinks and nobody notices) nor a
# stray copy silently ADDED (the suite grows out of the recorded set) without a
# deliberate, reviewed bump of EXPECTED here.
#
# CANONICAL SET (deterministic): every git-tracked/on-disk `.spl` whose path
# contains "enterprise" under src/ test/ doc/, EXCLUDING the *_probe_main.spl
# app drivers (those are executable cross-OS probe entrypoints checked by
# check-enterprise-cross-os.shs, not spec/contract source). Measured 2026-08-17:
# 79 enterprise .spl total - 8 probe mains = 71.
#
# Verdict convention (matches other scripts/check gates; last line on stdout):
#   PASS — <n> canonical spec(s) enumerated, matches EXPECTED=<E>   exit 0
#   FAIL — ...                                                      exit 1
#   ERROR — nothing was checked (...)                               exit 2
# Non-vacuity is absolute: a scan that enumerated 0 files is ERROR, never PASS.
# --selftest runs before every scan and is fatal.
set -u

EXPECTED=72

ROOT=$(cd "$(dirname "$0")/../.." && pwd)

# count_canonical DIR -> prints the number of canonical enterprise spec files
# found under DIR (looking in src/ test/ doc/ subtrees if present, else DIR).
count_canonical() {
    cc_dir=$1
    cc_scan=""
    for sub in src test doc; do
        [ -d "$cc_dir/$sub" ] && cc_scan="$cc_scan $cc_dir/$sub"
    done
    [ -n "$cc_scan" ] || cc_scan="$cc_dir"
    # shellcheck disable=SC2086
    find $cc_scan -name '*.spl' -path '*enterprise*' ! -name '*_probe_main.spl' 2>/dev/null | wc -l | tr -d ' '
}

# verdict COUNT EXPECTED LABEL -> echoes verdict line, returns exit status.
# (Pure comparison logic — this is what the selftest exercises.)
verdict() {
    v_count=$1; v_exp=$2; v_label=$3
    if [ "$v_count" -eq 0 ]; then
        echo "ERROR — nothing was checked ($v_label enumerated 0 canonical specs)"
        return 2
    fi
    if [ "$v_count" -ne "$v_exp" ]; then
        if [ "$v_count" -gt "$v_exp" ]; then
            echo "FAIL — $v_count canonical spec(s) enumerated ($v_label), OVER EXPECTED=$v_exp by $((v_count - v_exp)); a spec was added without bumping EXPECTED"
        else
            echo "FAIL — $v_count canonical spec(s) enumerated ($v_label), UNDER EXPECTED=$v_exp by $((v_exp - v_count)); a spec was removed without bumping EXPECTED"
        fi
        return 1
    fi
    echo "PASS — $v_count canonical spec(s) enumerated ($v_label), matches EXPECTED=$v_exp"
    return 0
}

# ---------------------------------------------------------------------------
# Selftest — fatal, runs before every scan. Constructs an EXACT-count fixture
# (must PASS), an OVER-count fixture (must FAIL), and an UNDER-count fixture
# (must FAIL), against a small synthetic expected so it does not depend on the
# real 71. Proves the comparison bites in both directions and is non-vacuous.
# ---------------------------------------------------------------------------
run_selftest() {
    st_root=$(mktemp -d "${TMPDIR:-/tmp}/ent_enum_selftest.XXXXXX") || return 1
    st_exp=3
    # exact: 3 canonical specs + one excluded probe main (must be ignored)
    mkdir -p "$st_root/exact/test/enterprise" "$st_root/exact/src/app/enterprise"
    : > "$st_root/exact/test/enterprise/store_spec.spl"
    : > "$st_root/exact/test/enterprise/sale_spec.spl"
    : > "$st_root/exact/src/app/enterprise/booking_contract.spl"
    : > "$st_root/exact/src/app/enterprise/store_probe_main.spl"   # excluded
    : > "$st_root/exact/test/enterprise/unrelated_spec.spl"         # no 'enterprise'? it does; keep at 3
    # recount to be exact regardless of the above comment
    c=$(count_canonical "$st_root/exact")
    if [ "$c" -ne 3 ]; then
        # normalise: rebuild a clean 3-file exact tree
        rm -rf "$st_root/exact"; mkdir -p "$st_root/exact/test/enterprise" "$st_root/exact/src/app/enterprise"
        : > "$st_root/exact/test/enterprise/a_enterprise_spec.spl"
        : > "$st_root/exact/test/enterprise/b_enterprise_spec.spl"
        : > "$st_root/exact/test/enterprise/c_enterprise_spec.spl"
        : > "$st_root/exact/src/app/enterprise/x_probe_main.spl"   # excluded
        c=$(count_canonical "$st_root/exact")
    fi
    verdict "$c" "$st_exp" "selftest-exact" >/dev/null; rc=$?
    if [ "$rc" -ne 0 ]; then rm -rf "$st_root"; echo "selftest: exact-count fixture did not PASS (count=$c)"; return 1; fi

    # over: one extra canonical spec
    cp -a "$st_root/exact" "$st_root/over"
    : > "$st_root/over/test/enterprise/extra_enterprise_spec.spl"
    co=$(count_canonical "$st_root/over")
    verdict "$co" "$st_exp" "selftest-over" >/dev/null; rc=$?
    if [ "$rc" -ne 1 ]; then rm -rf "$st_root"; echo "selftest: over-count fixture did not FAIL (count=$co)"; return 1; fi

    # under: one fewer canonical spec
    cp -a "$st_root/exact" "$st_root/under"
    rm -f "$st_root/under"/test/enterprise/*_spec.spl 2>/dev/null
    # keep 2 of the 3
    n=0
    for f in "$st_root/exact"/test/enterprise/*_spec.spl; do
        n=$((n+1)); [ "$n" -ge 3 ] && break
        : > "$st_root/under/test/enterprise/$(basename "$f")"
    done
    cu=$(count_canonical "$st_root/under")
    verdict "$cu" "$st_exp" "selftest-under" >/dev/null; rc=$?
    if [ "$rc" -ne 1 ]; then rm -rf "$st_root"; echo "selftest: under-count fixture did not FAIL (count=$cu)"; return 1; fi

    # non-vacuity: empty tree must be ERROR (exit 2), never PASS
    mkdir -p "$st_root/empty"
    ce=$(count_canonical "$st_root/empty")
    verdict "$ce" "$st_exp" "selftest-empty" >/dev/null; rc=$?
    if [ "$rc" -ne 2 ]; then rm -rf "$st_root"; echo "selftest: empty fixture was not ERROR (count=$ce rc=$rc)"; return 1; fi

    rm -rf "$st_root"
    return 0
}

if ! run_selftest; then
    echo "ERROR — nothing was checked (selftest failed)"
    exit 2
fi
if [ "${1:-}" = "--selftest" ]; then
    echo "selftest: exact PASS, over FAIL, under FAIL, empty ERROR — all as required"
    echo "PASS — 4 selftest fixture(s) checked, gate logic verified"
    exit 0
fi

# ---------------------------------------------------------------------------
# Scan — the real tree. Optional --root DIR (used by the meta-spec harness);
# default is the repo root.
# ---------------------------------------------------------------------------
scan_root=$ROOT
if [ "${1:-}" = "--root" ] && [ -n "${2:-}" ]; then
    scan_root=$2
fi

count=$(count_canonical "$scan_root")
verdict "$count" "$EXPECTED" "$scan_root"
exit $?
