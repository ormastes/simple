#!/bin/sh
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
. "$repo/scripts/check/lib/bootstrap-stage3/authority.shs"

scratch=$(mktemp -d "${TMPDIR:-/tmp}/stage3-target-prune.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT HUP INT TERM
fixture="$scratch/repo"
mkdir -p "$fixture/src/compiler_rust/vendor/cc/src/target" \
    "$fixture/src/runtime" "$fixture/tools/counterpart/sdk/c" \
    "$fixture/driver/rust[fixture]/src/target" "$fixture/src/compiler_rust/target" \
    "$fixture/src/compiler_rust/vendor/cc/target" \
    "$fixture/driver/rust[fixture]/target" "$fixture/src/runtime/test-dependency*/src/target" \
    "$fixture/src/runtime/test-dependency*/target"
printf '1.0.0\n' >"$fixture/VERSION"
printf '[workspace]\n' >"$fixture/src/compiler_rust/Cargo.toml"
printf 'version = 3\n' >"$fixture/src/compiler_rust/Cargo.lock"
printf 'channel = "stable"\n' >"$fixture/src/compiler_rust/rust-toolchain.toml"
printf '[dependencies]\ncommon = { path = "../../driver/rust[fixture]" }\nruntime_dep = { path = "../runtime/test-dependency*" }\n' \
    >"$fixture/src/compiler_rust/Cargo.toml"
printf '[package]\nname = "common"\nversion = "0.1.0"\n' \
    >"$fixture/driver/rust[fixture]/Cargo.toml"
printf 'pub fn common() {}\n' >"$fixture/driver/rust[fixture]/src/lib.rs"
printf '[package]\nname = "runtime-dependency"\nversion = "0.1.0"\n' \
    >"$fixture/src/runtime/test-dependency*/Cargo.toml"
printf 'pub fn runtime_dependency() {}\n' \
    >"$fixture/src/runtime/test-dependency*/src/lib.rs"
printf 'int runtime_input;\n' >"$fixture/src/runtime/runtime.c"
printf '/* counterpart */\n' \
    >"$fixture/tools/counterpart/sdk/c/simple_counterpart_abi.h"
printf 'tracked vendor baseline\n' \
    >"$fixture/src/compiler_rust/vendor/cc/src/target/tracked.rs"
printf 'generated compiler cache\n' >"$fixture/src/compiler_rust/target/cache.bin"
printf 'generated vendor cache\n' >"$fixture/src/compiler_rust/vendor/cc/target/cache.bin"
printf 'generated driver cache\n' >"$fixture/driver/rust[fixture]/target/cache.bin"
printf 'generated runtime dependency cache\n' \
    >"$fixture/src/runtime/test-dependency*/target/cache.bin"
printf 'tracked runtime dependency nested target\n' \
    >"$fixture/src/runtime/test-dependency*/src/target/tracked.rs"
mkdir -p "$fixture/src/compiler_rust/vendor/cc/build/target-lookalike"
printf 'prefix lookalike\n' \
    >"$fixture/src/compiler_rust/vendor/cc/build/target-lookalike/tracked.rs"

# Keep the real fingerprint traversal and hashing, while making tool identity
# deterministic so this self-test needs no compiler build or host toolchain.
bootstrap_stage3_resolve_llvm_build_authority() {
    printf 'llvm-build-status=disabled\n'
}
bootstrap_stage3_resolve_rust_toolchain() {
    printf 'rust-sysroot=%s\nrustc-path=%s\ncargo-path=%s\n' \
        "$scratch/sysroot" "$scratch/fake-rustc" "$scratch/fake-cargo"
}
bootstrap_stage3_seed_rust_policy_identity() { printf 'rust-policy=self-test\n'; }
bootstrap_stage3_native_metadata_probe() {
    case "$1" in
        rustc-fingerprint-version) printf 'rustc 1.0.0\nhost: self-test\n' ;;
        cargo-fingerprint-version) printf 'cargo 1.0.0\n' ;;
        *) return 1 ;;
    esac
}
bootstrap_stage3_target_c_compiler() { printf '\n'; }
touch "$scratch/fake-rustc" "$scratch/fake-cargo"
chmod +x "$scratch/fake-rustc" "$scratch/fake-cargo"

fingerprint() (
    cd "$fixture"
    bootstrap_stage3_test_digest=$(SIMPLE_ABI_POLICY=v1 PATH=/usr/bin:/bin \
        bootstrap_stage3_seed_inputs_fingerprint \
            "$fixture" cranelift '' /usr/bin:/bin x86_64-unknown-linux-gnu) || exit 1
    [ -n "$bootstrap_stage3_test_digest" ] || exit 1
    printf '%s\n' "$bootstrap_stage3_test_digest"
)
assert_changed() {
    label=$1
    path=$2
    before=$(fingerprint) || { echo "FAIL: $label initial fingerprint failed" >&2; exit 1; }
    printf 'changed bytes\n' >>"$fixture/$path"
    after=$(fingerprint) || { echo "FAIL: $label changed fingerprint failed" >&2; exit 1; }
    [ "$before" != "$after" ] || { echo "FAIL: $label mutation was omitted" >&2; exit 1; }
    printf 'restored baseline\n' >"$fixture/$path"
}
assert_ignored() {
    label=$1
    path=$2
    before=$(fingerprint) || { echo "FAIL: $label initial fingerprint failed" >&2; exit 1; }
    printf 'changed generated bytes\n' >>"$fixture/$path"
    after=$(fingerprint) || { echo "FAIL: $label changed fingerprint failed" >&2; exit 1; }
    [ "$before" = "$after" ] || { echo "FAIL: $label generated mutation changed digest" >&2; exit 1; }
    printf 'generated baseline\n' >"$fixture/$path"
}

assert_changed 'vendored nested target' \
    src/compiler_rust/vendor/cc/src/target/tracked.rs
assert_changed 'target prefix lookalike' \
    src/compiler_rust/vendor/cc/build/target-lookalike/tracked.rs
assert_changed 'external dependency nested target' \
    'driver/rust[fixture]/src/target/tracked.rs'
assert_changed 'runtime dependency nested target' \
    'src/runtime/test-dependency*/src/target/tracked.rs'
assert_ignored 'compiler generated target' src/compiler_rust/target/cache.bin
assert_changed 'vendored target directory' src/compiler_rust/vendor/cc/target/cache.bin
assert_ignored 'external direct target' \
    'driver/rust[fixture]/target/cache.bin'
assert_ignored 'runtime dependency direct target' \
    'src/runtime/test-dependency*/target/cache.bin'

cat >"$fixture/src/compiler_rust/vendor/cc/src/target/Cargo.toml" <<'EOF'
[build-dependencies]
missing = { path = "../../../../../../missing" }
EOF
if fingerprint >/dev/null 2>&1; then
    echo 'FAIL: nested target Cargo.toml with missing dependency was skipped' >&2
    exit 1
fi
rm "$fixture/src/compiler_rust/vendor/cc/src/target/Cargo.toml"

ln -s /etc/passwd "$fixture/src/compiler_rust/target/linked.rs"
fingerprint >/dev/null || {
    echo 'FAIL: symlink beneath compiler generated target was not pruned' >&2
    exit 1
}
rm "$fixture/src/compiler_rust/target/linked.rs"
ln -s /etc/passwd "$fixture/driver/rust[fixture]/target/linked.rs"
fingerprint >/dev/null || {
    echo 'FAIL: symlink beneath external generated target was not pruned' >&2
    exit 1
}
rm "$fixture/driver/rust[fixture]/target/linked.rs"
ln -s /etc/passwd "$fixture/src/runtime/test-dependency*/target/linked.rs"
fingerprint >/dev/null || {
    echo 'FAIL: symlink beneath runtime dependency target was not pruned' >&2
    exit 1
}
rm "$fixture/src/runtime/test-dependency*/target/linked.rs"

ln -s /etc/passwd "$fixture/src/compiler_rust/vendor/cc/src/target/linked.rs"
if fingerprint >/dev/null 2>&1; then
    echo 'FAIL: nested-source target symlink was accepted' >&2
    exit 1
fi
rm "$fixture/src/compiler_rust/vendor/cc/src/target/linked.rs"

mv "$fixture/src/compiler_rust/target" "$fixture/compiler-target-saved"
ln -s "$fixture/compiler-target-saved" "$fixture/src/compiler_rust/target"
if fingerprint >/dev/null 2>&1; then
    echo 'FAIL: compiler generated target root symlink was accepted' >&2
    exit 1
fi
rm "$fixture/src/compiler_rust/target"
mv "$fixture/compiler-target-saved" "$fixture/src/compiler_rust/target"

mv "$fixture/driver/rust[fixture]/target" "$fixture/driver-target-saved"
ln -s "$fixture/driver-target-saved" "$fixture/driver/rust[fixture]/target"
if fingerprint >/dev/null 2>&1; then
    echo 'FAIL: external generated target root symlink was accepted' >&2
    exit 1
fi
rm "$fixture/driver/rust[fixture]/target"
mv "$fixture/driver-target-saved" "$fixture/driver/rust[fixture]/target"

mv "$fixture/src/runtime/test-dependency*/target" "$fixture/runtime-target-saved"
ln -s "$fixture/runtime-target-saved" \
    "$fixture/src/runtime/test-dependency*/target"
if fingerprint >/dev/null 2>&1; then
    echo 'FAIL: runtime dependency target root symlink was accepted' >&2
    exit 1
fi
rm "$fixture/src/runtime/test-dependency*/target"
mv "$fixture/runtime-target-saved" \
    "$fixture/src/runtime/test-dependency*/target"

printf '%s\n' 'STATUS: PASS bootstrap-stage3-seed-target-pruning-self-test'
