#!/bin/sh
# Producer-scoped Stage-2 Phase2->Phase3 compatibility-manifest gate.
#
# Usage:
#   sh scripts/check/check-stage2-compat-manifest-gate.shs --selftest
#   sh scripts/check/check-stage2-compat-manifest-gate.shs \
#        --producer-kind=<pure-simple|rust-seed> \
#        --manifest=<path> [--evidence=<path>] [--producer-path=<path>]
#
# The selftest runs first and is FATAL on every real invocation. The verdict is
# always the last line of stdout: PASS (0) / FAIL (1) / ERROR (2).
#
# Rationale, measured causes and the fail-closed argument live in the library:
#   scripts/check/lib/bootstrap-stage3/phase2-compat-manifest.shs
set -u

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "${script_dir}/lib/bootstrap-stage3/phase2-compat-manifest.shs"

selftest_only=0
producer_kind=
manifest=
evidence=
producer_path=

for arg in "$@"; do
  case "${arg}" in
    --selftest) selftest_only=1 ;;
    --producer-kind=*) producer_kind=${arg#*=} ;;
    --manifest=*) manifest=${arg#*=} ;;
    --evidence=*) evidence=${arg#*=} ;;
    --producer-path=*) producer_path=${arg#*=} ;;
    *) echo "ERROR — nothing was checked (unknown argument '${arg}')"; exit 2 ;;
  esac
done

bootstrap_phase2_compat_selftest || {
  echo "ERROR — nothing was checked (selftest failed)"
  exit 2
}

if [ "${selftest_only}" -eq 1 ]; then
  echo "PASS — 12 selftest fixture(s) checked, 0 failures"
  exit 0
fi

bootstrap_phase2_compat_manifest_gate \
  "${producer_kind}" "${manifest}" "${evidence}" "${producer_path}"
