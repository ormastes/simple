#!/bin/sh
# Native trusted-snapshot component evidence; not sealed V4 qualification.
set -eu
if [ "$(uname -s)" != Darwin ]; then
    echo 'SKIP: Darwin snapshot process check requires macOS'
    exit 77
fi
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/sosix-darwin-process.XXXXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
"${CC:-cc}" -std=c11 -O0 -Wno-deprecated-declarations \
    "$root/src/runtime/test/rt_sosix_darwin_process_selfcheck.c" \
    -o "$scratch/selfcheck"
"$scratch/selfcheck"
