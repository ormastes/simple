#!/bin/sh
# Guard against guards that nothing invokes.
#
# WHY THIS EXISTS
# ---------------
# A check script that no hook and no CI job runs is decoration. On 2026-08-01 an
# audit of a8da6446 found 364 of 413 tracked shell guards (88.1%) unreachable
# from any hook or workflow -- including check-extern-registration.shs, which had
# been landed, hardened with a fixed extractor, a raised vacuity bound and named
# sabotage controls, and wired into nothing at all.
#
# The cause is structural. The two places that list guards
# (.github/workflows/*.yml and scripts/hooks/pre-commit) are HAND-MAINTAINED.
# Every new guard must be remembered into them and nothing detects the omission,
# so "deliberately not a gate" and "someone forgot" are indistinguishable states.
# This script makes them distinguishable: a guard must either be reachable from a
# root, or be listed in the opt-out file with a written reason. Adding a guard
# now wires it automatically; SKIPPING one becomes the deliberate act that needs
# justification.
#
# See doc/08_tracking/bug/check_script_wiring_orphans_2026-08-01.md.
#
# THIS IS A RATCHET, NOT AN AMNESTY
# ---------------------------------
# scripts/check/guard_wiring_optout.txt is seeded with the 364 orphans that
# existed on 2026-08-01. That is an honest baseline of existing debt, in the same
# style as ui_backend_isolation_baseline.txt and cpu_lane_hotloop_baseline.txt.
# Shrinking it is a follow-up program. Do NOT add new entries to keep a build
# green: an entry is a written statement that a guard is deliberately not a gate.
#
# Most of the seeded entries are heavyweight evidence producers -- QEMU boots,
# GPU/Vulkan/DirectX readbacks, Electron and Bun browser bitmap captures, FPGA
# and RISC-V hardware gates. They genuinely cannot run on a general-purpose CI
# runner. That is a legitimate opt-out. "I forgot" is not.
#
# HOOKS MUST RESOLVE TO TRACKED, CURRENT SOURCES
# ----------------------------------------------
# Also checked here. On 2026-08-01 the shared repo's installed .git/hooks/pre-push
# was a 2,668-byte COPY, two revisions behind the tracked script -- it predated
# 5f1b96ad9a8, the commit that fixed three fail-opens in the conflict guards. So
# every hardening landed that session was absent from the hook that actually ran.
# The canonical installer now uses one deliberate exception to the symlink rule:
# an exact copy of scripts/hooks/pre-push-worktree-launcher. The launcher must be
# a copy because a symlink anchored in the shared Git directory cannot select the
# linked worktree that initiated a push. Exact content equality keeps that copy
# fail-closed: any stale or foreign copy is still rejected.
#
# OUTPUT CONTRACT
# ---------------
#   PASS  — <n> guard(s) checked          (n is ALWAYS > 0)
#   FAIL  — unwired guards / stale opt-outs, exit 1
#   ERROR — nothing was checked, exit 2
# The count is what makes a vacuous run visible. Never read this script's status
# from a pipeline: $? is the LAST command's.

set -u

GREP=grep
[ -x /usr/bin/grep ] && GREP=/usr/bin/grep

# Extract every fixed-string pattern occurrence from stdin. Same reason as the
# recursive scan below: this runs once per matched file (943 of them on this
# tree) with ~1,500 -F patterns, and BSD grep is pathological at that. Verified
# byte-identical output against `/usr/bin/grep -o -F -f` over 25 real guard
# scripts before switching.
if command -v rg >/dev/null 2>&1; then
    _fixed_strings_only() { rg -o -F -f "$1" --no-line-number --no-filename 2>/dev/null; }
else
    _fixed_strings_only() { $GREP -o -F -f "$1" 2>/dev/null; }
fi

# A tree this size always has hundreds of guards. Anything near zero means the
# enumerator broke, not that the tree got clean. Raise as the tree grows; never
# lower it to make a run pass.
MIN_GUARDS=300

# ---------------------------------------------------------------------------
# scan_wiring <root> <optout-file> <workdir>
#
# Parameterised on <root> so the selftest can run the identical code path over
# synthetic fixtures. Writes <workdir>/guards, /reached, /orphans.
# ---------------------------------------------------------------------------
scan_wiring() {
    _root=$1
    _optout=$2
    _wd=$3

    # 1. Enumerate guards. -print into `while IFS= read -r` (never `for f in
    #    $list`): a bare for-loop word-splits on filenames containing spaces and
    #    silently drops them, which has already hidden files from a check here.
    #    scripts/check/lib/** is EXCLUDED: those files are sourced helper
    #    libraries (they define shell functions and have no entry point, no
    #    verdict line and no exit contract), not guards. Counting them made 14
    #    non-gates show up as unwired debt, and the only ways to clear them were
    #    to wire a library into CI -- which does nothing -- or to write an
    #    opt-out line asserting a library is "deliberately not a gate", which is
    #    a false statement in a file whose whole value is that its statements
    #    are true. A helper is reached exactly when its caller is, so the caller
    #    is what this guard must judge. Fixture: st-lib-helper.
    : > "$_wd/guardpaths"
    for _d in "$_root/scripts/check" "$_root/scripts/audit"; do
        [ -d "$_d" ] || continue
        find "$_d" -type f \( -name '*.shs' -o -name '*.sh' \) -print >> "$_wd/guardpaths"
    done
    if [ -d "$_root/scripts" ]; then
        find "$_root/scripts" -maxdepth 1 -type f -name 'check-*.shs' -print \
            >> "$_wd/guardpaths"
    fi
    sort -u "$_wd/guardpaths" -o "$_wd/guardpaths"
    sed 's#.*/##' "$_wd/guardpaths" | sort -u > "$_wd/guards"

    #    scripts/check/lib/** holds sourced function libraries, not gates: no
    #    entry point, no verdict line, no exit contract. They must stay in
    #    "$_wd/guards" so they remain traversable NODES -- a guard named ONLY
    #    inside a helper reaches a root THROUGH that helper, and dropping the
    #    helper from the node set silently orphaned three such guards
    #    (check-aspect-seal, check-critical-release-seal, check-f64-call-abi)
    #    when this exclusion was first written at the enumeration step. So they
    #    are subtracted here instead, at the point where orphanhood is decided.
    #    Judging them as gates made 14 non-gates show up as unwired debt whose
    #    only remedies were wiring a library into CI (which does nothing) or
    #    writing "deliberately not a gate" about a library -- a false statement
    #    in a file whose entire value is that its statements are true.
    #    Fixtures: st-lib-helper.
    : > "$_wd/libhelpers"
    $GREP '/scripts/check/lib/' "$_wd/guardpaths" 2>/dev/null |
        sed 's#.*/##' | sort -u > "$_wd/libhelpers" || :

    # 2. Roots. The installed pre-push hook is NOT under scripts/hooks/ -- it is
    #    scripts/check/pre-push-conflict-tree-guard.shs, which setup.shs installs
    #    into .git/hooks/pre-push. Omitting it would falsely orphan the three
    #    push guards it drives.
    : > "$_wd/roots"
    [ -d "$_root/.github/workflows" ] &&
        find "$_root/.github/workflows" -type f -print >> "$_wd/roots"
    [ -d "$_root/scripts/hooks" ] &&
        find "$_root/scripts/hooks" -type f -print >> "$_wd/roots"
    [ -f "$_root/scripts/check/pre-push-conflict-tree-guard.shs" ] &&
        echo "$_root/scripts/check/pre-push-conflict-tree-guard.shs" >> "$_wd/roots"
    sort -u "$_wd/roots" -o "$_wd/roots"

    # 3. Edges, referrer-path -> guard-basename.
    #
    #    Deliberately a BROAD textual model: any mention of the basename counts,
    #    not just `sh <path>` call syntax. A narrow call-syntax model misses the
    #    `var="$repo_root/scripts/check/x.shs"` assignment form -- which is
    #    exactly how the pre-push hook names its three sub-guards -- and would
    #    report them orphaned. Over-approximating reachability under-reports
    #    orphans, so this errs toward NOT failing a build on a parse gap.
    : > "$_wd/searchdirs"
    for _d in scripts .github src bin tools config; do
        [ -d "$_root/$_d" ] && echo "$_root/$_d" >> "$_wd/searchdirs"
    done
    : > "$_wd/hits"
    if [ -s "$_wd/guards" ] && [ -s "$_wd/searchdirs" ]; then
        # xargs -d is not portable; searchdirs are repo-relative and space-free.
        # shellcheck disable=SC2046
        # Prefer ripgrep for this one scan. `grep -F -f` with ~1,500 patterns
        # is fine on GNU grep (Aho-Corasick) and pathological on the BSD grep
        # that ships as /usr/bin/grep on macOS. Measured 2026-09-03 on this
        # tree, identical inputs (1,539 patterns, 943 matching files):
        #     /usr/bin/grep -r -I -l -F -f   >47 min, still running when killed
        #     rg -F -f -l --no-ignore --hidden   0.17 s
        # That is not a micro-optimisation: check-guard-wiring is a BLOCKING
        # push-tier gate, so on a mac every `git push` sat in this one grep for
        # an hour or more and looked hung. Output equivalence was verified
        # before switching — byte-identical file lists from both tools over
        # config/, bin/, tools/ and .github/. --no-ignore --hidden are required
        # (.github is a dot-directory and rg honours .gitignore by default);
        # rg skips binaries like -I and lists names like -l.
        if command -v rg >/dev/null 2>&1; then
            # rg is often a NATIVE binary (Windows/MSYS, and this is the only
            # tool here that is): it rewrites an absolute POSIX argument like
            # /tmp/x into C:/Users/.../Temp/x and emits '\' separators, so its
            # output never string-equals the find-produced paths used as BFS
            # edge keys -- every guard then looks orphaned (measured
            # 2026-09-06: 0 reached, selftest red). Search RELATIVE dirs from
            # inside $_root, then re-normalise separators and re-prefix. On
            # Linux this is byte-identical to passing absolute dirs.
            # shellcheck disable=SC2046
            ( cd "$_root" && rg -F -f "$_wd/guards" -l --no-ignore --hidden \
                $(sed "s#^$_root/##" "$_wd/searchdirs") 2>/dev/null ) |
                tr '\\' '/' | sed "s#^#$_root/#" > "$_wd/reffiles" || :
        else
            # shellcheck disable=SC2046
            $GREP -r -I -l -F -f "$_wd/guards" $(cat "$_wd/searchdirs") \
                2>/dev/null > "$_wd/reffiles" || :
        fi
        while IFS= read -r _f; do
            # Drop human-facing report/help-text prose lines before matching.
            # A handful of aggregate guards (e.g. check-metal-generated-2d-
            # readback.shs) build a single-line string like
            # metal_report_note="... run sh scripts/check/check-x.shs ..." that
            # tells an OPERATOR what to run next -- it is not an executed
            # invocation. Textually that line contains a real basename
            # substring (even "sh <path>"), which without this filter creates
            # a phantom wiring edge. The line shape is narrow and specific
            # (an assignment to a `*_note=`/`*_report=`/`*_report_note=`
            # variable) so it cannot swallow genuine `sh script.shs`,
            # `. script.shs`, or `run_child ... "script.shs" ...` call sites,
            # which never start with that shape.
            $GREP -v -E '^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*_(report_note|note|report)="' \
                "$_f" 2>/dev/null |
                _fixed_strings_only "$_wd/guards" |sort -u |
                while IFS= read -r _b; do
                    printf '%s\t%s\n' "$_f" "$_b"
                done
        done < "$_wd/reffiles" >> "$_wd/hits"
    fi
    # A file never counts as invoking itself.
    awk -F'\t' '{n=$1; sub(/.*\//,"",n); if (n != $2) print}' "$_wd/hits" |
        sort -u > "$_wd/edges"

    # 4. BFS from the roots.
    cp "$_wd/roots" "$_wd/frontier"
    : > "$_wd/reached"
    _i=0
    while [ "$_i" -lt 12 ]; do
        _i=$((_i + 1))
        : > "$_wd/new"
        while IFS= read -r _f; do
            awk -F'\t' -v F="$_f" '$1==F{print $2}' "$_wd/edges" >> "$_wd/new"
        done < "$_wd/frontier"
        sort -u "$_wd/new" -o "$_wd/new"
        comm -12 "$_wd/new" "$_wd/guards" > "$_wd/new2"
        sort -u "$_wd/reached" > "$_wd/reached.s"
        comm -23 "$_wd/new2" "$_wd/reached.s" > "$_wd/add"
        [ -s "$_wd/add" ] || break
        cat "$_wd/add" >> "$_wd/reached"
        sort -u "$_wd/reached" -o "$_wd/reached"
        : > "$_wd/frontier"
        while IFS= read -r _b; do
            $GREP -x ".*/$_b" "$_wd/guardpaths" >> "$_wd/frontier" 2>/dev/null || :
        done < "$_wd/add"
        sort -u "$_wd/frontier" -o "$_wd/frontier"
    done
    sort -u "$_wd/reached" -o "$_wd/reached"
    comm -23 "$_wd/guards" "$_wd/reached" > "$_wd/orphans_all"
    comm -23 "$_wd/orphans_all" "$_wd/libhelpers" > "$_wd/orphans"

    # 5. Opt-out list: "<basename><whitespace><reason>". A reason is REQUIRED --
    #    a bare basename is an unexplained skip and is rejected below.
    : > "$_wd/optout"
    : > "$_wd/optout_noreason"
    if [ -f "$_optout" ]; then
        $GREP -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$_optout" \
            > "$_wd/optout_raw" 2>/dev/null || :
        awk '{print $1}' "$_wd/optout_raw" | sort -u > "$_wd/optout"
        awk 'NF<2{print $1}' "$_wd/optout_raw" | sort -u > "$_wd/optout_noreason"
    fi
}

# ---------------------------------------------------------------------------
# scan_installed_hooks <root> <hookdir> <workdir>
#
# Classify repository-managed hook installation state. Symlinks must resolve to
# tracked files in this worktree. The only accepted regular-file hook is the
# exact canonical pre-push worktree launcher installed by
# install-must-check-hooks.shs; a one-byte drift makes it invalid.
# ---------------------------------------------------------------------------
scan_installed_hooks() {
    _root=$1
    _hookdir=$2
    _wd=$3

    : > "$_wd/allhooks"
    : > "$_wd/badhooks"
    [ -d "$_hookdir" ] || return 0

    _root_phys=$(CDPATH= cd -- "$_root" 2>/dev/null && pwd -P) || return 1
    _launcher="$_root_phys/scripts/hooks/pre-push-worktree-launcher"
    _launcher_tracked=0
    git -C "$_root_phys" ls-files --error-unmatch \
        scripts/hooks/pre-push-worktree-launcher >/dev/null 2>&1 &&
        _launcher_tracked=1

    find "$_hookdir" -maxdepth 1 ! -name '*.sample' ! -name '*.local' \
        ! -name hooks -print > "$_wd/allhooks" 2>/dev/null || :
    while IFS= read -r _h; do
        [ -n "$_h" ] || continue
        _b=${_h##*/}
        if [ -L "$_h" ]; then
            _target=$(readlink -f "$_h" 2>/dev/null || printf '')
            case "$_target" in
                "$_root_phys"/*)
                    _rel=${_target#"$_root_phys"/}
                    git -C "$_root_phys" ls-files --error-unmatch "$_rel" \
                        >/dev/null 2>&1 || echo "$_h" >> "$_wd/badhooks"
                    ;;
                *) echo "$_h" >> "$_wd/badhooks" ;;
            esac
            continue
        fi

        # The canonical worktree-resolving launcher is intentionally copied.
        # Content identity, tracked provenance, basename, and executability are
        # all load-bearing; no other copied hook is grandfathered.
        if [ "$_b" = pre-push ] && [ -x "$_h" ] &&
           [ "$_launcher_tracked" -eq 1 ] && [ -f "$_launcher" ] &&
           cmp -s "$_launcher" "$_h"; then
            continue
        fi

        # Same exception, same terms, for the repo-managed pre-commit added
        # 2026-09-03 (scripts/hooks/pre-commit-root-guard). Linked worktrees
        # share one hooks directory, which is exactly why a symlink into any
        # single worktree is not usable and the launcher is copied instead; a
        # managed pre-commit has the identical constraint. Content identity,
        # tracked provenance, basename and executability are all still
        # load-bearing — a one-byte drift is still invalid — so this widens the
        # rule by exactly one named, tracked file and grandfathers nothing.
        if [ "$_b" = pre-commit ] && [ -x "$_h" ] &&
           git -C "$_root_phys" ls-files --error-unmatch \
               scripts/hooks/pre-commit-root-guard >/dev/null 2>&1 &&
           [ -f "$_root_phys/scripts/hooks/pre-commit-root-guard" ] &&
           cmp -s "$_root_phys/scripts/hooks/pre-commit-root-guard" "$_h"; then
            continue
        fi

        if [ -x "$_h" ]; then
            echo "$_h" >> "$_wd/badhooks"
        else
            case "$_b" in
                applypatch-msg|pre-applypatch|post-applypatch|pre-commit|\
                pre-merge-commit|prepare-commit-msg|commit-msg|post-commit|\
                pre-rebase|post-checkout|post-merge|pre-push|pre-receive|\
                update|post-receive|post-update|push-to-checkout|\
                pre-auto-gc|post-rewrite|sendemail-validate|fsmonitor-watchman)
                    echo "$_h" >> "$_wd/badhooks" ;;
            esac
        fi
    done < "$_wd/allhooks"
    sort -u "$_wd/badhooks" -o "$_wd/badhooks"
}

# ---------------------------------------------------------------------------
# SELFTEST. Fixtures exercise every verdict this script can reach. A sabotage
# matrix is only as good as its fixture coverage: on 2026-08-01 one of eight
# neutered-check sabotages of check-tree-size-push.shs initially passed green
# because no fixture uniquely exercised it. Each fixture below is the ONLY one
# that turns its verdict, so neutering any branch turns this selftest red.
# ---------------------------------------------------------------------------
selftest() {
    _t=$(mktemp -d) || return 1
    mkdir -p "$_t/scripts/check" "$_t/scripts/check/lib" \
        "$_t/.github/workflows" "$_t/scripts/hooks"

    # direct: named by a workflow.
    echo '#!/bin/sh' > "$_t/scripts/check/st-direct.shs"
    # indirect: named only by st-direct.shs, which is itself reachable.
    echo '#!/bin/sh' > "$_t/scripts/check/st-indirect.shs"
    echo 'sh scripts/check/st-indirect.shs' >> "$_t/scripts/check/st-direct.shs"
    # orphan-justified: unreferenced, but listed in the opt-out with a reason.
    echo '#!/bin/sh' > "$_t/scripts/check/st-optout.shs"
    # orphan-unjustified: unreferenced and unlisted. MUST fail.
    echo '#!/bin/sh' > "$_t/scripts/check/st-orphan.shs"
    # lib helper: a sourced function library under scripts/check/lib/. It is
    # itself unreferenced, so to the old code it looked exactly like
    # st-orphan.shs. It must NOT be judged as a gate -- but it must still be a
    # traversable node, because st-viahelper.shs is named ONLY inside it.
    # Deleting it from the node set orphaned three real guards in the tree.
    echo '#!/bin/sh' > "$_t/scripts/check/lib/st-lib-helper.shs"
    echo 'sh scripts/check/st-viahelper.shs' >> "$_t/scripts/check/lib/st-lib-helper.shs"
    echo '#!/bin/sh' > "$_t/scripts/check/st-viahelper.shs"
    echo '. scripts/check/lib/st-lib-helper.shs' >> "$_t/scripts/check/st-direct.shs"
    printf 'run: sh scripts/check/st-direct.shs\n' > "$_t/.github/workflows/w.yml"

    printf '# fixture\nst-optout.shs  needs real hardware\n' > "$_t/optout.txt"

    _w=$(mktemp -d) || return 1
    scan_wiring "$_t" "$_t/optout.txt" "$_w"

    _fail=0
    _assert() { # <desc> <expect> <actual>
        if [ "$2" != "$3" ]; then
            echo "SELFTEST FAILED: $1 (expected '$2', got '$3')"
            _fail=1
        fi
    }
    _has() { $GREP -qx "$2" "$_w/$1" && echo yes || echo no; }

    _assert "guards enumerated" 6 "$(wc -l < "$_w/guards" | tr -d ' ')"
    _assert "lib helper stays a traversable node" yes \
        "$(_has guards st-lib-helper.shs)"
    _assert "lib helper is never judged an orphan" no \
        "$(_has orphans st-lib-helper.shs)"
    _assert "guard named only inside a lib helper is still reachable" yes \
        "$(_has reached st-viahelper.shs)"
    _assert "guard named only inside a lib helper is not an orphan" no \
        "$(_has orphans st-viahelper.shs)"
    _assert "direct guard reachable"   yes "$(_has reached st-direct.shs)"
    _assert "indirect guard reachable" yes "$(_has reached st-indirect.shs)"
    _assert "optout guard is an orphan" yes "$(_has orphans st-optout.shs)"
    _assert "unlisted guard is an orphan" yes "$(_has orphans st-orphan.shs)"
    _assert "reachable guard is NOT an orphan" no "$(_has orphans st-direct.shs)"

    # The verdict the whole script exists to produce.
    comm -23 "$_w/orphans" "$_w/optout" > "$_w/st_unjust"
    _assert "unjustified set is exactly st-orphan.shs" \
        "st-orphan.shs" "$(cat "$_w/st_unjust" | tr '\n' ' ' | sed 's/ *$//')"

    # A bare basename with no reason must be rejected, not silently honoured.
    printf 'st-orphan.shs\n' >> "$_t/optout.txt"
    _w2=$(mktemp -d) || return 1
    scan_wiring "$_t" "$_t/optout.txt" "$_w2"
    _assert "reasonless opt-out detected" yes \
        "$($GREP -qx 'st-orphan.shs' "$_w2/optout_noreason" && echo yes || echo no)"

    # RATCHET fixtures. The set arithmetic that decides "new unwired" vs "known
    # debt" vs "stale baseline" lives outside scan_wiring, so it is exercised
    # here on explicit sets rather than inferred from the real tree.
    printf 'st-orphan.shs\n' | sort -u > "$_w/fx_base"
    printf 'st-orphan.shs\nst-brandnew.shs\n' | sort -u > "$_w/fx_unjust"
    _assert "baselined orphan is not NEW debt" "st-brandnew.shs" \
        "$(comm -23 "$_w/fx_unjust" "$_w/fx_base" | tr '\n' ' ' | sed 's/ *$//')"
    printf 'st-direct.shs\n' | sort -u > "$_w/fx_base2"
    _assert "baselined guard that became wired is stale" "st-direct.shs" \
        "$(comm -12 "$_w/fx_base2" "$_w/reached" | tr '\n' ' ' | sed 's/ *$//')"
    _assert "baselined guard that no longer exists is stale" "st-gone.shs" \
        "$(printf 'st-gone.shs\n' | comm -23 - "$_w/guards" | tr '\n' ' ' | sed 's/ *$//')"

    # Hook-shape fixtures exercise the exact canonical-copy exception. This is
    # intentionally inside the gate's selftest so future broad exemptions or a
    # basename-only check cannot silently accept a stale launcher again.
    git -C "$_t" init -q
    mkdir -p "$_t/scripts/hooks" "$_t/hooks"
    printf '#!/bin/sh\necho canonical\n' > "$_t/scripts/hooks/pre-push-worktree-launcher"
    git -C "$_t" add scripts/hooks/pre-push-worktree-launcher
    cp "$_t/scripts/hooks/pre-push-worktree-launcher" "$_t/hooks/pre-push"
    chmod +x "$_t/hooks/pre-push"
    _hw=$(mktemp -d) || return 1
    scan_installed_hooks "$_t" "$_t/hooks" "$_hw"
    _assert "exact canonical launcher copy accepted" 0 \
        "$(wc -l < "$_hw/badhooks" | tr -d ' ')"

    printf '# stale\n' >> "$_t/hooks/pre-push"
    scan_installed_hooks "$_t" "$_t/hooks" "$_hw"
    _assert "stale canonical launcher copy rejected" 1 \
        "$(wc -l < "$_hw/badhooks" | tr -d ' ')"

    rm -f "$_t/hooks/pre-push"
    ln -s ../scripts/hooks/pre-push-worktree-launcher "$_t/hooks/pre-push"
    scan_installed_hooks "$_t" "$_t/hooks" "$_hw"
    _assert "tracked in-tree hook symlink accepted" 0 \
        "$(wc -l < "$_hw/badhooks" | tr -d ' ')"

    rm -f "$_t/hooks/pre-push"
    printf '#!/bin/sh\necho foreign\n' > "$_t/hooks/pre-push"
    chmod +x "$_t/hooks/pre-push"
    scan_installed_hooks "$_t" "$_t/hooks" "$_hw"
    _assert "foreign executable hook copy rejected" 1 \
        "$(wc -l < "$_hw/badhooks" | tr -d ' ')"

    printf '#!/bin/sh\n' > "$_t/untracked-hook"
    rm -f "$_t/hooks/pre-push"
    ln -s ../untracked-hook "$_t/hooks/pre-push"
    scan_installed_hooks "$_t" "$_t/hooks" "$_hw"
    _assert "untracked hook symlink rejected" 1 \
        "$(wc -l < "$_hw/badhooks" | tr -d ' ')"

    rm -rf "$_t" "$_w" "$_w2" "$_hw"
    if [ "$_fail" -ne 0 ]; then
        echo "check-guard-wiring: SELFTEST FAILED -- the wiring scan is broken."
        echo "Fix the scan. Do NOT delete these fixtures."
        return 1
    fi
    echo "check-guard-wiring: selftest 20/20 fixtures correct"
    return 0
}

selftest || exit 2
[ "${1:-}" = "--selftest-only" ] && exit 0

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT=""
if [ -z "$ROOT" ]; then
    echo "check-guard-wiring: ERROR — nothing was checked: not inside a git repository."
    echo "Run this from the repo root. Both push guards once exited 0 from a"
    echo "non-repo cwd while printing 'nothing to push'; this refuses instead."
    exit 2
fi
# TOPLEVEL PREFLIGHT (2026-08-08)
# ROOT anchors the whole scan. On 2026-08-08 a stray `core.worktree` + `core.bare
# = true` in the SHARED .git/config made `git rev-parse --show-toplevel` resolve
# to an unrelated temp worktree, so every path-anchored guard — this one included
# — scanned a tree nobody was pushing. Git chdirs to the working-tree root before
# running a hook, and a genuine LINKED worktree resolves its own root through its
# gitdir/commondir pointer pair, so in any healthy tree the toplevel IS the
# invoking tree. Both sides are physically resolved so a symlinked path is not a
# spurious refusal. The test is EQUALITY, not ancestry: an ancestry form is
# fail-OPEN (with `core.worktree = /tmp` and cwd `/tmp/x/main` it passes the
# exact pathology it exists to catch), and this script is documented as
# run-from-the-repo-root anyway. See
# doc/08_tracking/bug/shared_git_config_core_worktree_misdirects_prepush_guards_2026-08-08.md
IS_BARE=$(git rev-parse --is-bare-repository 2>/dev/null) || IS_BARE=""
if [ "$IS_BARE" != "false" ]; then
    echo "check-guard-wiring: ERROR — nothing was checked: is-bare-repository="
    echo "'$IS_BARE' (expected 'false'). A stray core.bare in .git/config"
    echo "misdirects every path-anchored guard. Fix the config, not this script."
    exit 2
fi

HERE_PHYS=$(pwd -P) || HERE_PHYS=""
ROOT_PHYS=$(cd "$ROOT" 2>/dev/null && pwd -P) || ROOT_PHYS=""
if [ -z "$HERE_PHYS" ] || [ -z "$ROOT_PHYS" ]; then
    echo "check-guard-wiring: ERROR — nothing was checked: cannot physically"
    echo "resolve cwd ('$HERE_PHYS') or toplevel ('$ROOT_PHYS')."
    exit 2
fi
case "$HERE_PHYS" in
    "$ROOT_PHYS") : ;;
    *)
        echo "check-guard-wiring: ERROR — nothing was checked: toplevel mismatch."
        echo "  git rev-parse --show-toplevel : $ROOT"
        echo "  resolved                      : $ROOT_PHYS"
        echo "  invoking tree (pwd -P)        : $HERE_PHYS"
        echo "The scan would anchor on a tree nobody is working in. Most likely a"
        echo "stray core.worktree in the SHARED .git/config; check with:"
        echo "  git config --show-origin --get-all core.worktree"
        echo "  git config --show-origin --get-all core.bare"
        exit 2
        ;;
esac

OPTOUT="$ROOT/scripts/check/guard_wiring_optout.txt"
# UNWIRED RATCHET (2026-08-23)
# ----------------------------
# This script sat permanently RED (414 unwired) for weeks, which is the worst of
# both worlds: the debt was real but the verdict carried no information, so every
# reader learned to ignore it -- and a genuinely NEW unwired guard was
# indistinguishable from the standing backlog. That is exactly how
# check-type-walk-constructor-parity.shs went unenforced for a day while its bug
# record claimed it existed.
#
# The backlog is frozen here instead of being moved into the OPT-OUT file. The
# distinction is deliberate and load-bearing: an opt-out line asserts "this guard
# is deliberately not a gate"; a baseline line asserts only "this guard is not
# wired YET, and that is known debt". Laundering 414 unwired guards through the
# opt-out file would have made the debt permanent and honest-looking. Growth
# fails; the count stays printed; shrinking is the follow-up program.
#
# Regeneration is DELETIONS-ONLY by construction: an entry that becomes wired is
# reported as a stale baseline and fails, so the file cannot silently keep
# describing a tree that has moved on. --generate-baseline exists for reviewed
# updates only; do not reach for it to turn a FAIL green.
BASELINE="$ROOT/scripts/check/guard_wiring_unwired_baseline.txt"

WD=$(mktemp -d) || exit 2
trap 'rm -rf "$WD"' EXIT
scan_wiring "$ROOT" "$OPTOUT" "$WD"

n_guards=$(wc -l < "$WD/guards" | tr -d ' ')
if [ "$n_guards" -lt "$MIN_GUARDS" ]; then
    echo "check-guard-wiring: ERROR — nothing was checked: only $n_guards guard(s)"
    echo "enumerated (expected >= $MIN_GUARDS). The enumerator is broken -- most"
    echo "likely a find(1) path or extension stopped matching. Fix it; do not"
    echo "lower MIN_GUARDS."
    exit 2
fi

n_reached=$(wc -l < "$WD/reached" | tr -d ' ')
n_orphan=$(wc -l < "$WD/orphans" | tr -d ' ')

comm -23 "$WD/orphans" "$WD/optout" > "$WD/unjustified"
# Stale opt-outs: a listed guard that is now wired, or no longer exists. Both
# mean the baseline is lying about the tree, so both fail.
comm -12 "$WD/optout" "$WD/reached" > "$WD/optout_now_wired"
comm -23 "$WD/optout" "$WD/guards" > "$WD/optout_gone"

: > "$WD/baseline"
if [ -f "$BASELINE" ]; then
    $GREP -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$BASELINE" 2>/dev/null |
        awk '{print $1}' | sort -u > "$WD/baseline" || :
fi
if [ "${1:-}" = --generate-baseline ]; then
    {
        echo "# Frozen backlog of guards that nothing invokes yet (NOT an opt-out:"
        echo "# an opt-out means 'deliberately not a gate'; a line here means"
        echo "# 'unwired debt, known'). Regenerated $(date -u +%Y-%m-%d) for a"
        echo "# REVIEWED update only. Growth fails; entries that become wired fail"
        echo "# as stale. Shrinking this file is the follow-up program."
        cat "$WD/unjustified"
    } > "$BASELINE"
    echo "check-guard-wiring: wrote $(wc -l < "$WD/unjustified" | tr -d ' ') baselined guard(s) to $BASELINE"
    exit 0
fi
comm -23 "$WD/unjustified" "$WD/baseline" > "$WD/unjustified_new"
# A baselined guard that is now wired (or gone) means the baseline is lying about
# the tree -- the same staleness rule the opt-out file is held to.
comm -12 "$WD/baseline" "$WD/reached" > "$WD/baseline_now_wired"
comm -23 "$WD/baseline" "$WD/guards" > "$WD/baseline_gone"
n_unjust_new=$(wc -l < "$WD/unjustified_new" | tr -d ' ')
n_baselined=$(wc -l < "$WD/baseline" | tr -d ' ')
n_base_wired=$(wc -l < "$WD/baseline_now_wired" | tr -d ' ')
n_base_gone=$(wc -l < "$WD/baseline_gone" | tr -d ' ')
n_unjust=$(wc -l < "$WD/unjustified" | tr -d ' ')
n_wired_now=$(wc -l < "$WD/optout_now_wired" | tr -d ' ')
n_gone=$(wc -l < "$WD/optout_gone" | tr -d ' ')
n_noreason=$(wc -l < "$WD/optout_noreason" | tr -d ' ')

echo "guard_total=$n_guards"
echo "guard_invoked=$n_reached"
echo "guard_orphaned=$n_orphan"
echo "guard_optout_listed=$(wc -l < "$WD/optout" | tr -d ' ')"
echo "guard_unwired_baselined=$n_baselined"
echo "guard_unwired_new=$n_unjust_new"

# ---------------------------------------------------------------------------
# Installed-hook shape. Repository hooks must resolve to tracked current source.
# ---------------------------------------------------------------------------
n_hooks=0
n_badhooks=0
# GitHub's checkout environment can carry ephemeral Git-LFS hooks in the fresh
# clone. They are runner state, not an installation of this repository's hook
# policy, and disappear with the job. Auditing those four files as though they
# were developer hook wiring produced the PR36 false positive. CI still checks
# the tracked installer/launcher sources and the full guard reachability graph;
# local runs audit the actual hook directory that Git will execute.
if [ "${GITHUB_ACTIONS:-}" = true ]; then
    : > "$WD/allhooks"
    : > "$WD/badhooks"
    echo "installed_hooks_scan=skipped_ephemeral_github_actions"
else
    HOOKDIR=$(git rev-parse --git-path hooks 2>/dev/null) || HOOKDIR=""
    case "$HOOKDIR" in
        /*) : ;;
        '') : ;;
        *) HOOKDIR="$ROOT/$HOOKDIR" ;;
    esac
    scan_installed_hooks "$ROOT" "$HOOKDIR" "$WD" || {
        echo "check-guard-wiring: ERROR — hook scan could not resolve tracked sources."
        exit 2
    }
    n_hooks=$(wc -l < "$WD/allhooks" | tr -d ' ')
    n_badhooks=$(wc -l < "$WD/badhooks" | tr -d ' ')
fi
echo "installed_hooks=$n_hooks"
echo "installed_hooks_not_canonical=$n_badhooks"
if [ "$n_hooks" -eq 0 ]; then
    echo "NOTE: no repository-local hook installation was evaluated here."
fi

status=0

if [ "$n_unjust_new" -gt 0 ]; then
    echo "guard_wiring_ok=false"
    echo "== guards invoked by nothing, not opted out, and NOT in the frozen baseline =="
    while IFS= read -r b; do
        [ -n "$b" ] && echo "unwired_guard=$b"
    done < "$WD/unjustified_new"
    echo ""
    echo "A guard that no hook and no CI job runs is decoration. Wire it into"
    echo ".github/workflows/ or scripts/hooks/, or add it to"
    echo "scripts/check/guard_wiring_optout.txt WITH A REASON. Do not weaken the"
    echo "guard, and do not add an opt-out line merely to make this pass."
    status=1
fi

if [ "$n_base_wired" -gt 0 ] || [ "$n_base_gone" -gt 0 ]; then
    echo "guard_wiring_ok=false"
    echo "== stale unwired-baseline entries (ratchet: remove them) =="
    while IFS= read -r b; do
        [ -n "$b" ] && echo "stale_baseline_now_wired=$b"
    done < "$WD/baseline_now_wired"
    while IFS= read -r b; do
        [ -n "$b" ] && echo "stale_baseline_missing=$b"
    done < "$WD/baseline_gone"
    echo "Wiring a baselined guard is progress -- delete its line in the same"
    echo "commit. A baseline that no longer describes the tree is how a ratchet"
    echo "silently stops ratcheting."
    status=1
fi

if [ "$n_noreason" -gt 0 ]; then
    echo "guard_wiring_ok=false"
    echo "== opt-out entries with no reason =="
    while IFS= read -r b; do
        [ -n "$b" ] && echo "optout_without_reason=$b"
    done < "$WD/optout_noreason"
    echo "Every opt-out line must be '<script.shs>  <why it is not a gate>'."
    status=1
fi

if [ "$n_wired_now" -gt 0 ]; then
    echo "guard_wiring_ok=false"
    echo "== opt-out entries that are now wired (ratchet: remove them) =="
    while IFS= read -r b; do
        [ -n "$b" ] && echo "stale_optout_now_wired=$b"
    done < "$WD/optout_now_wired"
    status=1
fi

if [ "$n_gone" -gt 0 ]; then
    echo "guard_wiring_ok=false"
    echo "== opt-out entries for scripts that no longer exist =="
    while IFS= read -r b; do
        [ -n "$b" ] && echo "stale_optout_missing=$b"
    done < "$WD/optout_gone"
    status=1
fi

if [ "$n_badhooks" -gt 0 ]; then
    echo "guard_wiring_ok=false"
    echo "== installed hooks that do not resolve to canonical tracked source =="
    while IFS= read -r h; do
        [ -n "$h" ] && echo "hook_is_noncanonical=$h"
    done < "$WD/badhooks"
    echo ""
    echo "A stale or foreign hook copy can bypass the tracked dispatcher. On"
    echo "2026-08-01 the installed pre-push hook was two revisions behind and"
    echo "missed every fail-open fix landed that session. Re-run"
    echo "scripts/setup/install-must-check-hooks.shs --install; its exact"
    echo "worktree launcher copy is the only accepted non-symlink hook."
    status=1
fi

if [ "$status" -ne 0 ]; then
    echo "check-guard-wiring: FAIL — $n_guards guard(s) checked, $n_unjust_new NEW unwired" \
         "($n_baselined baselined as known debt)," \
         "$((n_wired_now + n_gone + n_noreason + n_base_wired + n_base_gone)) stale/bad baseline or opt-out line(s)," \
         "$n_badhooks copied hook(s)"
    exit 1
fi

echo "guard_wiring_ok=true"
echo "check-guard-wiring: PASS — $n_guards guard(s) checked, $n_reached invoked," \
     "$n_orphan orphaned ($n_baselined baselined as known unwired debt, rest justified)," \
     "0 NEW unwired, $n_badhooks copied hook(s)"
exit 0
