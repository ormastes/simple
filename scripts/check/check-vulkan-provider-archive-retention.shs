#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

fail() {
    printf '%s\n' "vulkan provider archive retention check: $*" >&2
    exit 1
}

for tool in cc ar nm; do
    command -v "$tool" >/dev/null 2>&1 || fail "missing-tool-$tool"
done

LLVM_OWNER=src/compiler/70.backend/backend/llvm_native_link_orchestrator.spl
LINK_OWNER=src/compiler/70.backend/linker/_LinkerWrapper/native_linking.spl
POLICY_OWNER=src/compiler/70.backend/linker/_LinkerWrapper/archive_retention.spl

grep -Fq 'llvm_external_provider_retained_symbols(external_providers)' "$LLVM_OWNER" ||
    fail "provider-retention-scan-not-wired"
grep -Fq 'retained_symbols: retained_symbols' "$LLVM_OWNER" ||
    fail "provider-retention-roots-not-forwarded"
grep -Fq 'native_retained_symbol_direct_args(config.retained_symbols, os)' "$LINK_OWNER" ||
    fail "direct-linker-retention-not-wired"
grep -Fq -- '--undefined=' "$POLICY_OWNER" ||
    fail "elf-retention-policy-missing"
grep -Fq -- '--export-dynamic-symbol=' "$POLICY_OWNER" ||
    fail "elf-dynamic-export-policy-missing"
grep -Fq -- '-Wl,-u,' "$POLICY_OWNER" ||
    fail "darwin-retention-policy-missing"
grep -Fq -- '-Wl,-export_dynamic' "$POLICY_OWNER" ||
    fail "darwin-dynamic-export-policy-missing"
grep -Fq -- '/EXPORT:' "$POLICY_OWNER" ||
    fail "msvc-dynamic-export-policy-missing"
if grep -Fq -- '--whole-archive' "$POLICY_OWNER"; then
    fail "whole-archive-breaks-provider-quarantine"
fi

TMP_BASE="${TMPDIR:-/tmp}"
FIXTURE_DIR="$(mktemp -d "$TMP_BASE/simple-vulkan-provider-retention.XXXXXX")"
cleanup() {
    case "$FIXTURE_DIR" in
        "$TMP_BASE"/simple-vulkan-provider-retention.*) rm -rf "$FIXTURE_DIR" ;;
        *) fail "unsafe-fixture-cleanup-path" ;;
    esac
}
trap cleanup EXIT HUP INT TERM

cat >"$FIXTURE_DIR/weak.c" <<'EOF'
#include <dlfcn.h>
#include <stdint.h>

typedef int64_t (*vulkan_provider_available_fn)(void);

__attribute__((weak))
int64_t rt_vulkan_is_available(void) {
    void *resolved = dlsym(
        RTLD_DEFAULT,
        "rt_vulkan_provider_is_available"
    );
    if (resolved) {
        return ((vulkan_provider_available_fn)resolved)();
    }
    return 0;
}
EOF

cat >"$FIXTURE_DIR/strong.c" <<'EOF'
#include <stdint.h>

int64_t rt_vulkan_provider_is_available(void) {
    return 73;
}
EOF

cat >"$FIXTURE_DIR/main.c" <<'EOF'
#include <stdint.h>
#include <stdio.h>

int64_t rt_vulkan_is_available(void);

int main(void) {
    printf(
        "provider_available=%lld\n",
        (long long)rt_vulkan_is_available()
    );
    return 0;
}
EOF

cc -O0 -c "$FIXTURE_DIR/weak.c" -o "$FIXTURE_DIR/weak.o"
cc -O0 -c "$FIXTURE_DIR/strong.c" -o "$FIXTURE_DIR/strong.o"
cc -O0 -c "$FIXTURE_DIR/main.c" -o "$FIXTURE_DIR/main.o"
ar rcs "$FIXTURE_DIR/libvulkan-provider-fixture.a" \
    "$FIXTURE_DIR/weak.o" "$FIXTURE_DIR/strong.o"

members="$(
    ar t "$FIXTURE_DIR/libvulkan-provider-fixture.a" |
        awk '
            /^__.SYMDEF/ { next }
            {
                sub(/^.*\//, "", $0)
                print
            }
        '
)"
[ "$members" = "$(printf 'weak.o\nstrong.o')" ] ||
    fail "fixture-archive-order-mismatch"

case "$(uname -s)" in
    Darwin)
        cc "$FIXTURE_DIR/main.o" \
            "$FIXTURE_DIR/libvulkan-provider-fixture.a" \
            -o "$FIXTURE_DIR/baseline"
        ;;
    *)
        cc "$FIXTURE_DIR/main.o" \
            "$FIXTURE_DIR/libvulkan-provider-fixture.a" \
            -ldl -o "$FIXTURE_DIR/baseline"
        ;;
esac
baseline="$("$FIXTURE_DIR/baseline")"
[ "$baseline" = "provider_available=0" ] ||
    fail "baseline-unexpectedly-extracted-provider:$baseline"
if nm -g "$FIXTURE_DIR/baseline" |
    grep -Eq '[[:space:]]_?rt_vulkan_provider_is_available$'; then
    fail "baseline-unexpectedly-contains-provider"
fi

case "$(uname -s)" in
    Darwin)
        cc "$FIXTURE_DIR/main.o" \
            "-Wl,-u,_rt_vulkan_provider_is_available" \
            "-Wl,-export_dynamic" \
            "$FIXTURE_DIR/libvulkan-provider-fixture.a" \
            -o "$FIXTURE_DIR/retained"
        ;;
    *)
        cc "$FIXTURE_DIR/main.o" \
            "-Wl,--undefined=rt_vulkan_provider_is_available" \
            "-Wl,--export-dynamic-symbol=rt_vulkan_provider_is_available" \
            "$FIXTURE_DIR/libvulkan-provider-fixture.a" \
            -ldl -o "$FIXTURE_DIR/retained"
        ;;
esac

retained="$("$FIXTURE_DIR/retained")"
[ "$retained" = "provider_available=73" ] ||
    fail "retained-provider-not-reached:$retained"
nm -g "$FIXTURE_DIR/retained" |
    grep -Eq '[[:space:]]_?rt_vulkan_provider_is_available$' ||
    fail "retained-provider-symbol-missing"

printf '%s\n' \
    "vulkan_provider_archive_fixture=true" \
    "weak_compatibility_first=true" \
    "baseline_provider_available=0" \
    "retained_provider_available=73" \
    "provider_dlsym_discoverable=true" \
    "whole_archive_used=false" \
    "live_vulkan_executed=false"
