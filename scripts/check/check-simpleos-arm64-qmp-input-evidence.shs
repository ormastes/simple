#!/bin/sh
set -eu

# Live-only ARM64 SimpleOS WM input evidence. This wrapper never builds a guest:
# it consumes the canonical, already-built desktop kernel and disk, injects real
# QMP input events, and admits PASS only when guest-owned receipts correlate
# those events with later WM frames and distinct RAMFB screendumps.

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

. scripts/check/lib/simpleos-arm64-guest-source-fingerprint.shs
. scripts/check/lib/qemu-frozen-source-admission.shs

KERNEL="build/os/simpleos_arm64_desktop_engine2d.elf"
DISK="build/os/fat32-arm64-desktop.img"
DISK_PRODUCER="build/os/make_os_disk"
BUILD_MANIFEST="build/os/simpleos_arm64_desktop_engine2d.build-manifest.env"
FROZEN_BUILD_MANIFEST="${BUILD_MANIFEST}.frozen-source-admission.env"
EVIDENCE_DIR="${SIMPLEOS_ARM64_QMP_EVIDENCE_DIR:-build/os/arm64_qmp_input_evidence}"
EVIDENCE_ENV="$EVIDENCE_DIR/evidence.env"
EVIDENCE_REPORT="$EVIDENCE_DIR/report.md"
SERIAL_LOG="$EVIDENCE_DIR/serial.log"
QEMU_LOG="$EVIDENCE_DIR/qemu.stderr.log"
QMP_LOG="$EVIDENCE_DIR/qmp-input.log"
BEFORE_PPM="$EVIDENCE_DIR/before-input.ppm"
AFTER_PPM="$EVIDENCE_DIR/after-input.ppm"
QMP_SOCKET="$EVIDENCE_DIR/qmp.sock"
SIMPLE_CORE_ARCHIVE="$ROOT_DIR/build/os/simple-core-simpleos-aarch64/libsimple_runtime.a"
MAX_CHECKSUM_US="${SIMPLEOS_ARM64_QMP_MAX_CHECKSUM_US:-5000000}"
QEMU_PID=""

mkdir -p "$EVIDENCE_DIR"
rm -f "$EVIDENCE_ENV" "$EVIDENCE_REPORT" "$SERIAL_LOG" "$QEMU_LOG" "$QMP_LOG" \
    "$BEFORE_PPM" "$AFTER_PPM" "$QMP_SOCKET"

cleanup() {
    if [ -n "$QEMU_PID" ]; then
        kill "$QEMU_PID" >/dev/null 2>&1 || true
        wait "$QEMU_PID" >/dev/null 2>&1 || true
    fi
    rm -f "$QMP_SOCKET"
}
trap cleanup EXIT INT TERM

sha256_file() {
    sha256_line="$(qemu_admission_sha256 "$1")" || return 1
    sha256_value="${sha256_line%% *}"
    case "$sha256_value" in
        *[!0-9a-f]*|"") return 1 ;;
    esac
    [ "${#sha256_value}" -eq 64 ] || return 1
    printf '%s\n' "$sha256_value"
}

fail_evidence() {
    reason="$1"
    {
        echo "arm64_qmp_input_status=fail"
        echo "arm64_qmp_input_reason=$reason"
        echo "arm64_qmp_input_kernel=$KERNEL"
        echo "arm64_qmp_input_disk=$DISK"
        echo "arm64_qmp_input_build_manifest=$BUILD_MANIFEST"
        echo "arm64_qmp_input_report=$EVIDENCE_REPORT"
        echo "arm64_qmp_input_serial_log=$SERIAL_LOG"
        echo "arm64_qmp_input_qmp_log=$QMP_LOG"
        echo "arm64_qmp_input_before_ppm=$BEFORE_PPM"
        echo "arm64_qmp_input_after_ppm=$AFTER_PPM"
    } >"$EVIDENCE_ENV"
    cat "$EVIDENCE_ENV"
    exit 1
}

[ -f "$KERNEL" ] && [ -s "$KERNEL" ] ||
    fail_evidence "canonical-kernel-missing"
[ -f "$DISK" ] && [ -s "$DISK" ] ||
    fail_evidence "canonical-desktop-disk-missing"
[ -f "$BUILD_MANIFEST" ] && [ -s "$BUILD_MANIFEST" ] ||
    fail_evidence "canonical-build-manifest-missing"
[ -f "$FROZEN_BUILD_MANIFEST" ] && [ -s "$FROZEN_BUILD_MANIFEST" ] ||
    fail_evidence "canonical-frozen-source-admission-missing"

for frozen_key in schema repo_revision dirty_state_policy frozen_worktree \
    entry_path entry_sha256 source_roots source_fingerprint source_file_count \
    compiler_path compiler_sha256 build_command output_path output_sha256
do
    frozen_count="$(grep -c "^${frozen_key}=" "$FROZEN_BUILD_MANIFEST" || true)"
    [ "$frozen_count" -eq 1 ] || fail_evidence "canonical-frozen-source-admission-invalid"
done

frozen_field() {
    sed -n "s/^$1=//p" "$FROZEN_BUILD_MANIFEST"
}

for key in \
    artifact_kind \
    source_revision \
    source_roots \
    source_fingerprint \
    source_file_count \
    entry_path \
    entry_sha256 \
    kernel_path \
    kernel_sha256 \
    disk_path \
    disk_sha256 \
    disk_producer_path \
    disk_producer_sha256 \
    compiler_path \
    compiler_sha256 \
    compiler_version \
    compiler_format \
    compiler_arch \
    simple_core_path \
    simple_core_sha256 \
    target_os \
    target_arch \
    native_backend \
    build_command \
    build_environment
do
    count="$(grep -c "^${key}=" "$BUILD_MANIFEST" || true)"
    [ "$count" -eq 1 ] || fail_evidence "canonical-build-manifest-invalid"
done

manifest_field() {
    sed -n "s/^$1=//p" "$BUILD_MANIFEST"
}

MANIFEST_ARTIFACT_KIND="$(manifest_field artifact_kind)"
MANIFEST_SOURCE_REVISION="$(manifest_field source_revision)"
MANIFEST_SOURCE_ROOTS="$(manifest_field source_roots)"
MANIFEST_SOURCE_FINGERPRINT="$(manifest_field source_fingerprint)"
MANIFEST_SOURCE_FILE_COUNT="$(manifest_field source_file_count)"
MANIFEST_ENTRY_PATH="$(manifest_field entry_path)"
MANIFEST_ENTRY_SHA256="$(manifest_field entry_sha256)"
MANIFEST_KERNEL_PATH="$(manifest_field kernel_path)"
MANIFEST_KERNEL_SHA256="$(manifest_field kernel_sha256)"
MANIFEST_DISK_PATH="$(manifest_field disk_path)"
MANIFEST_DISK_SHA256="$(manifest_field disk_sha256)"
MANIFEST_DISK_PRODUCER_PATH="$(manifest_field disk_producer_path)"
MANIFEST_DISK_PRODUCER_SHA256="$(manifest_field disk_producer_sha256)"
MANIFEST_COMPILER_PATH="$(manifest_field compiler_path)"
MANIFEST_COMPILER_SHA256="$(manifest_field compiler_sha256)"
MANIFEST_COMPILER_VERSION="$(manifest_field compiler_version)"
MANIFEST_COMPILER_FORMAT="$(manifest_field compiler_format)"
MANIFEST_COMPILER_ARCH="$(manifest_field compiler_arch)"
MANIFEST_SIMPLE_CORE_PATH="$(manifest_field simple_core_path)"
MANIFEST_SIMPLE_CORE_SHA256="$(manifest_field simple_core_sha256)"
MANIFEST_TARGET_OS="$(manifest_field target_os)"
MANIFEST_TARGET_ARCH="$(manifest_field target_arch)"
MANIFEST_NATIVE_BACKEND="$(manifest_field native_backend)"
MANIFEST_BUILD_COMMAND="$(manifest_field build_command)"
MANIFEST_BUILD_ENVIRONMENT="$(manifest_field build_environment)"
HOST_SOURCE_REVISION="$(git rev-parse --verify HEAD 2>/dev/null)" ||
    fail_evidence "host-source-revision-unavailable"
[ "$(frozen_field schema)" = "qemu-frozen-source-admission-v1" ] ||
    fail_evidence "canonical-frozen-source-admission-schema-mismatch"
[ "$(frozen_field repo_revision)" = "$HOST_SOURCE_REVISION" ] ||
    fail_evidence "canonical-frozen-source-admission-revision-mismatch"
[ "$(frozen_field dirty_state_policy)" = "scoped-tracked-and-untracked-clean" ] ||
    fail_evidence "canonical-frozen-source-admission-dirty-policy-mismatch"
[ "$(frozen_field frozen_worktree)" = "linked-clean" ] ||
    fail_evidence "canonical-frozen-source-admission-worktree-mismatch"
[ "$(frozen_field arch)" = "arm64" ] ||
    fail_evidence "canonical-frozen-source-admission-arch-mismatch"
[ "$(frozen_field entry_path)" = "$MANIFEST_ENTRY_PATH" ] ||
    fail_evidence "canonical-frozen-source-admission-entry-path-mismatch"
[ "$(frozen_field entry_sha256)" = "$MANIFEST_ENTRY_SHA256" ] ||
    fail_evidence "canonical-frozen-source-admission-entry-sha256-mismatch"
[ "$(frozen_field source_roots)" = "$MANIFEST_SOURCE_ROOTS" ] ||
    fail_evidence "canonical-frozen-source-admission-source-roots-mismatch"
[ "$(frozen_field source_fingerprint)" = "$MANIFEST_SOURCE_FINGERPRINT" ] ||
    fail_evidence "canonical-frozen-source-admission-source-fingerprint-mismatch"
[ "$(frozen_field source_file_count)" = "$MANIFEST_SOURCE_FILE_COUNT" ] ||
    fail_evidence "canonical-frozen-source-admission-source-file-count-mismatch"
[ "$(frozen_field compiler_path)" = "$MANIFEST_COMPILER_PATH" ] ||
    fail_evidence "canonical-frozen-source-admission-compiler-path-mismatch"
[ "$(frozen_field compiler_sha256)" = "$MANIFEST_COMPILER_SHA256" ] ||
    fail_evidence "canonical-frozen-source-admission-compiler-sha256-mismatch"
[ "$(frozen_field build_command)" = "$MANIFEST_BUILD_COMMAND" ] ||
    fail_evidence "canonical-frozen-source-admission-build-command-mismatch"
[ "$(frozen_field output_path)" = "$KERNEL" ] ||
    fail_evidence "canonical-frozen-source-admission-output-path-mismatch"
[ "$(frozen_field output_sha256)" = "$MANIFEST_KERNEL_SHA256" ] ||
    fail_evidence "canonical-frozen-source-admission-output-sha256-mismatch"

[ "$MANIFEST_ARTIFACT_KIND" = "simpleos-arm64-desktop-engine2d" ] ||
    fail_evidence "canonical-build-manifest-artifact-kind-mismatch"
[ "$MANIFEST_SOURCE_REVISION" = "$HOST_SOURCE_REVISION" ] ||
    fail_evidence "canonical-build-manifest-source-revision-mismatch"
[ "$MANIFEST_SOURCE_ROOTS" = "$(arm64_guest_source_roots_text)" ] ||
    fail_evidence "canonical-build-manifest-source-roots-mismatch"
printf '%s\n' "$MANIFEST_SOURCE_FINGERPRINT" |
    grep -Eq '^[0-9a-f]{64}$' ||
    fail_evidence "canonical-build-manifest-source-fingerprint-invalid"
printf '%s\n' "$MANIFEST_SOURCE_FILE_COUNT" |
    grep -Eq '^[1-9][0-9]*$' ||
    fail_evidence "canonical-build-manifest-source-file-count-invalid"
[ "$MANIFEST_ENTRY_PATH" = "examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl" ] ||
    fail_evidence "canonical-build-manifest-entry-path-mismatch"
[ -f "$MANIFEST_ENTRY_PATH" ] && [ ! -L "$MANIFEST_ENTRY_PATH" ] ||
    fail_evidence "canonical-build-manifest-entry-unavailable"
printf '%s\n' "$MANIFEST_ENTRY_SHA256" |
    grep -Eq '^[0-9a-f]{64}$' ||
    fail_evidence "canonical-build-manifest-entry-sha256-invalid"
[ "$(sha256_file "$MANIFEST_ENTRY_PATH")" = "$MANIFEST_ENTRY_SHA256" ] ||
    fail_evidence "canonical-build-manifest-entry-sha256-mismatch"
[ "$MANIFEST_KERNEL_PATH" = "$KERNEL" ] ||
    fail_evidence "canonical-build-manifest-kernel-path-mismatch"
[ "$MANIFEST_DISK_PATH" = "$DISK" ] ||
    fail_evidence "canonical-build-manifest-disk-path-mismatch"
printf '%s\n' "$MANIFEST_KERNEL_SHA256" |
    grep -Eq '^[0-9a-f]{64}$' ||
    fail_evidence "canonical-build-manifest-kernel-sha256-invalid"
printf '%s\n' "$MANIFEST_DISK_SHA256" |
    grep -Eq '^[0-9a-f]{64}$' ||
    fail_evidence "canonical-build-manifest-disk-sha256-invalid"
[ "$MANIFEST_DISK_PRODUCER_PATH" = "$DISK_PRODUCER" ] ||
    fail_evidence "canonical-build-manifest-disk-producer-path-mismatch"
[ -x "$DISK_PRODUCER" ] && [ -f "$DISK_PRODUCER" ] &&
    [ ! -L "$DISK_PRODUCER" ] ||
    fail_evidence "canonical-build-manifest-disk-producer-unavailable"
printf '%s\n' "$MANIFEST_DISK_PRODUCER_SHA256" |
    grep -Eq '^[0-9a-f]{64}$' ||
    fail_evidence "canonical-build-manifest-disk-producer-sha256-invalid"
case "$MANIFEST_COMPILER_PATH" in
    bin/release/*/simple|/*) ;;
    *) fail_evidence "canonical-build-manifest-compiler-path-mismatch" ;;
esac
[ -x "$MANIFEST_COMPILER_PATH" ] && [ -f "$MANIFEST_COMPILER_PATH" ] &&
    [ ! -L "$MANIFEST_COMPILER_PATH" ] ||
    fail_evidence "canonical-build-manifest-compiler-unavailable"
arm64_guest_validate_native_compiler "$MANIFEST_COMPILER_PATH" ||
    fail_evidence "canonical-build-manifest-compiler-format-arch-invalid"
[ "$ARM64_GUEST_COMPILER_FORMAT" = "$MANIFEST_COMPILER_FORMAT" ] ||
    fail_evidence "canonical-build-manifest-compiler-format-mismatch"
[ "$ARM64_GUEST_COMPILER_ARCH" = "$MANIFEST_COMPILER_ARCH" ] ||
    fail_evidence "canonical-build-manifest-compiler-arch-mismatch"
printf '%s\n' "$MANIFEST_COMPILER_SHA256" |
    grep -Eq '^[0-9a-f]{64}$' ||
    fail_evidence "canonical-build-manifest-compiler-sha256-invalid"
[ -n "$MANIFEST_COMPILER_VERSION" ] ||
    fail_evidence "canonical-build-manifest-compiler-version-missing"
[ "$MANIFEST_SIMPLE_CORE_PATH" = "$SIMPLE_CORE_ARCHIVE" ] ||
    fail_evidence "canonical-build-manifest-simple-core-path-mismatch"
[ -f "$MANIFEST_SIMPLE_CORE_PATH" ] && [ -s "$MANIFEST_SIMPLE_CORE_PATH" ] &&
    [ ! -L "$MANIFEST_SIMPLE_CORE_PATH" ] ||
    fail_evidence "canonical-build-manifest-simple-core-unavailable"
printf '%s\n' "$MANIFEST_SIMPLE_CORE_SHA256" |
    grep -Eq '^[0-9a-f]{64}$' ||
    fail_evidence "canonical-build-manifest-simple-core-sha256-invalid"
[ "$MANIFEST_TARGET_OS" = "simpleos" ] ||
    fail_evidence "canonical-build-manifest-target-os-mismatch"
[ "$MANIFEST_TARGET_ARCH" = "arm64" ] ||
    fail_evidence "canonical-build-manifest-target-arch-mismatch"
case "$MANIFEST_NATIVE_BACKEND" in
    llvm|cranelift) ;;
    *) fail_evidence "canonical-build-manifest-native-backend-invalid" ;;
esac
printf '%s\n' "$MANIFEST_BUILD_COMMAND" |
    grep -Fq "sh scripts/os/make_os_disk.shs 128 $DISK '' arm64 desktop-fonts" ||
    fail_evidence "canonical-build-manifest-disk-command-mismatch"
for command_token in \
    "$MANIFEST_COMPILER_PATH native-build --verbose" \
    "--backend $MANIFEST_NATIVE_BACKEND" \
    "--runtime-bundle simple-core" \
    "--entry-closure --entry $MANIFEST_ENTRY_PATH" \
    "--target aarch64-unknown-none -o $KERNEL" \
    "--linker-script examples/09_embedded/simple_os/arch/arm64/linker.ld"
do
    printf '%s\n' "$MANIFEST_BUILD_COMMAND" | grep -Fq -- "$command_token" ||
        fail_evidence "canonical-build-manifest-command-mismatch"
done
for environment_token in \
    "-u SIMPLE_ALLOW_FREESTANDING_STUBS" \
    "SIMPLE_TARGET_OS=simpleos" \
    "SIMPLE_TARGET_ARCH=arm64" \
    "SIMPLE_NATIVE_BUILD_ENTRY=examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl" \
    "SIMPLE_SIMPLE_CORE_PATH=$ROOT_DIR/build/os/simple-core-simpleos-aarch64" \
    "SIMPLE_NATIVE_RUNTIME_BUNDLE=simple-core" \
    "SIMPLE_STRICT_FABRICATED_STUB_RATCHET=1" \
    "SIMPLE_NO_STUB_FALLBACK=1"
do
    printf '%s\n' "$MANIFEST_BUILD_ENVIRONMENT" | grep -Fq -- "$environment_token" ||
        fail_evidence "canonical-build-manifest-environment-mismatch"
done

if arm64_guest_source_dirty; then
    fail_evidence "guest-source-worktree-dirty-before-launch"
else
    SOURCE_DIRTY_CODE=$?
    [ "$SOURCE_DIRTY_CODE" -eq 1 ] ||
        fail_evidence "guest-source-git-status-failed-before-launch"
fi
arm64_guest_source_snapshot ||
    fail_evidence "pre-launch-source-fingerprint-failed"
PRE_LAUNCH_SOURCE_FINGERPRINT="$ARM64_GUEST_SOURCE_FINGERPRINT"
PRE_LAUNCH_SOURCE_FILE_COUNT="$ARM64_GUEST_SOURCE_FILE_COUNT"
[ "$PRE_LAUNCH_SOURCE_FINGERPRINT" = "$MANIFEST_SOURCE_FINGERPRINT" ] ||
    fail_evidence "guest-source-fingerprint-manifest-mismatch"
[ "$PRE_LAUNCH_SOURCE_FILE_COUNT" = "$MANIFEST_SOURCE_FILE_COUNT" ] ||
    fail_evidence "guest-source-file-count-manifest-mismatch"

KERNEL_SHA256="$(sha256_file "$KERNEL")" ||
    fail_evidence "canonical-kernel-sha256-failed"
DISK_SHA256="$(sha256_file "$DISK")" ||
    fail_evidence "canonical-disk-sha256-failed"
DISK_PRODUCER_SHA256="$(sha256_file "$DISK_PRODUCER")" ||
    fail_evidence "canonical-disk-producer-sha256-failed"
COMPILER_SHA256="$(sha256_file "$MANIFEST_COMPILER_PATH")" ||
    fail_evidence "canonical-compiler-sha256-failed"
SIMPLE_CORE_SHA256="$(sha256_file "$MANIFEST_SIMPLE_CORE_PATH")" ||
    fail_evidence "canonical-simple-core-sha256-failed"
[ "$KERNEL_SHA256" = "$MANIFEST_KERNEL_SHA256" ] ||
    fail_evidence "canonical-kernel-manifest-sha256-mismatch"
[ "$DISK_SHA256" = "$MANIFEST_DISK_SHA256" ] ||
    fail_evidence "canonical-disk-manifest-sha256-mismatch"
[ "$DISK_PRODUCER_SHA256" = "$MANIFEST_DISK_PRODUCER_SHA256" ] ||
    fail_evidence "canonical-disk-producer-manifest-sha256-mismatch"
[ "$COMPILER_SHA256" = "$MANIFEST_COMPILER_SHA256" ] ||
    fail_evidence "canonical-compiler-manifest-sha256-mismatch"
[ "$SIMPLE_CORE_SHA256" = "$MANIFEST_SIMPLE_CORE_SHA256" ] ||
    fail_evidence "canonical-simple-core-manifest-sha256-mismatch"

command -v qemu-system-aarch64 >/dev/null 2>&1 ||
    fail_evidence "qemu-system-aarch64-missing"
printf '%s\n' "$MAX_CHECKSUM_US" | grep -Eq '^[1-9][0-9]*$' ||
    fail_evidence "invalid-max-checksum-us"
[ "$MAX_CHECKSUM_US" -le 5000000 ] ||
    fail_evidence "max-checksum-us-exceeds-release-ceiling"

# Re-hash immediately at the launch boundary. The post-run check below also
# rejects artifacts mutated while evidence was being collected.
LAUNCH_KERNEL_SHA256="$(sha256_file "$KERNEL")" ||
    fail_evidence "canonical-kernel-launch-sha256-failed"
LAUNCH_DISK_SHA256="$(sha256_file "$DISK")" ||
    fail_evidence "canonical-disk-launch-sha256-failed"
LAUNCH_SIMPLE_CORE_SHA256="$(sha256_file "$MANIFEST_SIMPLE_CORE_PATH")" ||
    fail_evidence "canonical-simple-core-launch-sha256-failed"
LAUNCH_SOURCE_REVISION="$(git rev-parse --verify HEAD 2>/dev/null)" ||
    fail_evidence "launch-source-revision-unavailable"
[ "$LAUNCH_SOURCE_REVISION" = "$MANIFEST_SOURCE_REVISION" ] ||
    fail_evidence "launch-source-revision-manifest-mismatch"
[ "$LAUNCH_KERNEL_SHA256" = "$MANIFEST_KERNEL_SHA256" ] ||
    fail_evidence "canonical-kernel-launch-sha256-mismatch"
[ "$LAUNCH_DISK_SHA256" = "$MANIFEST_DISK_SHA256" ] ||
    fail_evidence "canonical-disk-launch-sha256-mismatch"
[ "$LAUNCH_SIMPLE_CORE_SHA256" = "$MANIFEST_SIMPLE_CORE_SHA256" ] ||
    fail_evidence "canonical-simple-core-launch-sha256-mismatch"

qemu-system-aarch64 \
    -no-user-config \
    -machine virt \
    -cpu cortex-a72 \
    -m 512M \
    -serial "file:$SERIAL_LOG" \
    -display none \
    -monitor none \
    -net none \
    -no-reboot \
    -kernel "$KERNEL" \
    -device ramfb \
    -device virtio-keyboard-device \
    -device virtio-mouse-device \
    -global virtio-mmio.force-legacy=false \
    -drive "file=$DISK,if=none,id=armdesktop,format=raw" \
    -device virtio-blk-device,drive=armdesktop \
    -qmp "unix:$QMP_SOCKET,server=on,wait=off" \
    >"$QEMU_LOG" 2>&1 &
QEMU_PID=$!

set +e
python3 - "$QMP_SOCKET" "$SERIAL_LOG" "$BEFORE_PPM" "$AFTER_PPM" \
    "$MAX_CHECKSUM_US" >"$QMP_LOG" 2>&1 <<'PY'
import hashlib
import json
import os
import re
import socket
import sys
import time

socket_path, serial_path, before_path, after_path = sys.argv[1:5]
max_checksum_us = int(sys.argv[5])
deadline = time.monotonic() + 15
while time.monotonic() < deadline and not os.path.exists(socket_path):
    time.sleep(0.05)
if not os.path.exists(socket_path):
    raise RuntimeError("qmp socket timeout")

sock = socket.socket(socket.AF_UNIX)
sock.settimeout(5)
sock.connect(socket_path)
stream = sock.makefile("rwb", buffering=0)

def read_message():
    while True:
        line = stream.readline()
        if not line:
            raise RuntimeError("qmp closed")
        message = json.loads(line)
        if "event" not in message:
            return message

greeting = read_message()
if "QMP" not in greeting:
    raise RuntimeError("qmp greeting missing")

next_id = 1
def qmp(command, arguments=None):
    global next_id
    command_id = next_id
    next_id += 1
    request = {"execute": command, "id": command_id}
    if arguments is not None:
        request["arguments"] = arguments
    stream.write(json.dumps(request).encode() + b"\n")
    stream.flush()
    while True:
        response = read_message()
        if response.get("id") != command_id:
            continue
        if "error" in response:
            raise RuntimeError("qmp rejected %s: %r" % (command, response["error"]))
        if "return" not in response:
            raise RuntimeError("qmp command unacknowledged")
        return response["return"]

def serial_text():
    try:
        return open(serial_path, "r", errors="replace").read()
    except FileNotFoundError:
        return ""

def wait_serial(pattern, timeout):
    deadline = time.monotonic() + timeout
    compiled = re.compile(pattern, re.M)
    while time.monotonic() < deadline:
        text = serial_text()
        match = compiled.search(text)
        if match:
            return match, text
        time.sleep(0.05)
    raise RuntimeError("serial receipt timeout: " + pattern)

def screendump(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    qmp("screendump", {"filename": os.path.abspath(path)})
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        if os.path.exists(path) and os.path.getsize(path) > 16:
            return
        time.sleep(0.05)
    raise RuntimeError("screendump timeout")

def ppm(path):
    data = open(path, "rb").read()
    tokens = []
    offset = 0
    while len(tokens) < 4:
        while offset < len(data) and data[offset] in b" \t\r\n":
            offset += 1
        if offset < len(data) and data[offset:offset + 1] == b"#":
            while offset < len(data) and data[offset] not in b"\r\n":
                offset += 1
            continue
        end = offset
        while end < len(data) and data[end] not in b" \t\r\n":
            end += 1
        tokens.append(data[offset:end])
        offset = end
    if offset >= len(data) or data[offset] not in b" \t\r\n":
        raise RuntimeError("PPM raster delimiter missing")
    # P6 requires one whitespace delimiter after maxval. Consuming more would
    # corrupt a legal raster whose first pixel byte is itself whitespace.
    offset += 1
    if tokens[0] != b"P6" or tokens[3] != b"255":
        raise RuntimeError("invalid PPM header")
    width, height = int(tokens[1]), int(tokens[2])
    pixels = data[offset:]
    if width <= 0 or height <= 0 or len(pixels) != width * height * 3:
        raise RuntimeError("invalid PPM payload")
    return width, height, pixels, hashlib.sha256(data).hexdigest()

qmp("qmp_capabilities")
ready, _ = wait_serial(
    r"^\[desktop-gui-arm64\] desktop-ready revision=(\d+)\r?$", 45
)
baseline_revision = int(ready.group(1))

def require_simd_receipt(text):
    receipt_lines = [
        line.rstrip("\r") for line in text.splitlines()
        if line.startswith("[engine2d-simd]")
    ]
    if len(receipt_lines) != 1:
        raise RuntimeError(
            "expected exactly one guest Engine2D SIMD receipt, found %d"
            % len(receipt_lines)
        )
    match = re.fullmatch(
        r"\[engine2d-simd\] arch=aarch64 isa=neon enabled=1 "
        r"fill_hits=(\d+) fill_chunks=(\d+) fill_tail_pixels=(\d+) "
        r"scalar_parity=bit-exact",
        receipt_lines[0],
    )
    if not match:
        raise RuntimeError(
            "guest Engine2D SIMD receipt reports fallback or contract mismatch"
        )
    native_hits, vector_chunks, scalar_tail_pixels = (
        int(value) for value in match.groups()
    )
    if native_hits <= 0 or vector_chunks <= 0 or scalar_tail_pixels < 0:
        raise RuntimeError(
            "guest Engine2D SIMD receipt lacks native vector execution"
        )
    return {
        "arch": "aarch64",
        "isa": "neon",
        "enabled": 1,
        "native_hits": native_hits,
        "vector_chunks": vector_chunks,
        "scalar_tail_pixels": scalar_tail_pixels,
        "required_kernel_kinds": "fill",
        "executed_kernel_kinds": "fill",
        "fallback": "none",
        "scalar_parity": "bit-exact",
    }

def require_fps_receipt(text):
    receipt_lines = [
        line.rstrip("\r") for line in text.splitlines()
        if line.startswith("[engine2d-fps]")
    ]
    if len(receipt_lines) != 1:
        raise RuntimeError(
            "expected exactly one guest Engine2D FPS receipt, found %d"
            % len(receipt_lines)
        )
    match = re.fullmatch(
        r"\[engine2d-fps\] path=shared-wm-draw-ir-engine2d backend=baremetal "
        r"warmup_frames=(\d+) sample_frames=(\d+) elapsed_us=(\d+) "
        r"fps_x1000=(\d+) minimum_fps_x1000=(\d+) "
        r"simd_fill_hits_delta=(\d+) simd_fill_chunks_delta=(\d+) status=pass",
        receipt_lines[0],
    )
    if not match:
        raise RuntimeError("guest Engine2D FPS receipt contract mismatch")
    warmup_frames, sample_frames, elapsed_us, fps_x1000, minimum_fps_x1000, simd_hits_delta, simd_chunks_delta = (
        int(value) for value in match.groups()
    )
    if warmup_frames != 4 or sample_frames != 64:
        raise RuntimeError("guest Engine2D FPS sample window mismatch")
    if elapsed_us <= 0 or elapsed_us > 10000000:
        raise RuntimeError("guest Engine2D FPS elapsed time is invalid")
    if minimum_fps_x1000 != 39000 or fps_x1000 < minimum_fps_x1000:
        raise RuntimeError("guest Engine2D frame rate is below 39 FPS")
    if simd_hits_delta <= 0 or simd_chunks_delta <= 0:
        raise RuntimeError("guest Engine2D FPS interval lacks SIMD execution")
    return {
        "path": "shared-wm-draw-ir-engine2d",
        "backend": "baremetal",
        "warmup_frames": warmup_frames,
        "sample_frames": sample_frames,
        "elapsed_us": elapsed_us,
        "fps_x1000": fps_x1000,
        "minimum_fps_x1000": minimum_fps_x1000,
        "simd_fill_hits_delta": simd_hits_delta,
        "simd_fill_chunks_delta": simd_chunks_delta,
    }

# The freestanding ARM64 Engine2D desktop has one required target-native
# kernel kind: fill. Reject missing, duplicate, fallback, wrong-ISA, or
# non-vector receipts before any QMP input or capture can be admitted.
simd_receipt = require_simd_receipt(serial_text())
fps_receipt = require_fps_receipt(serial_text())
wait_serial(
    r"^\[backend2d-event-blocker\] backend=simpleos-qemu-arm64 "
    r"event_backend=virtio-mmio keyboard=transport-ready "
    r"pointer=transport-ready owner=InputBackend "
    r"reason=live-qmp-evidence-pending\r?$",
    5,
)
commit_pattern = re.compile(
    r"^\[ramfb-visual-commit\] input_seq=(\d+) address=(\d+) "
    r"width=(\d+) height=(\d+) stride=(\d+) format=bgra8888 "
    r"rendered_revision=(\d+) frame_id=(\d+) "
    r"checksum=([0-9a-fA-F]+) checksum_us=(\d+) "
    r"damage_kind=conservative-full-frame "
    r"damage_bound_x=(\d+) damage_bound_y=(\d+) "
    r"damage_bound_width=(\d+) damage_bound_height=(\d+) "
    r"status=success\r?$",
    re.M,
)

def parse_commit(match):
    values = [int(value) for value in match.groups()[:7]]
    checksum = match.group(8).lower()
    checksum_us = int(match.group(9))
    region = tuple(int(value) for value in match.groups()[9:13])
    (
        seq, address, width, height, stride, rendered_revision, frame_id
    ) = values
    x, y, damage_width, damage_height = region
    if (
        address <= 0 or width <= 0 or height <= 0 or
        width > 16384 or height > 16384 or
        stride < width * 4 or stride % 4 != 0 or
        rendered_revision <= 0 or frame_id <= 0 or
        checksum_us <= 0 or checksum_us > max_checksum_us or
        not checksum.strip("0") or
        region != (0, 0, width, height) or
        x < 0 or y < 0 or damage_width < 0 or damage_height < 0 or
        x + damage_width > width or y + damage_height > height
    ):
        raise RuntimeError("invalid guest RAMFB visual-commit receipt")
    return {
        "seq": seq,
        "address": address,
        "width": width,
        "height": height,
        "stride": stride,
        "rendered_revision": rendered_revision,
        "frame_id": frame_id,
        "checksum": checksum,
        "checksum_us": checksum_us,
        "region": region,
    }

def commit_for_sequence(text, seq):
    matches = [
        parse_commit(match) for match in commit_pattern.finditer(text)
        if int(match.group(1)) == seq
    ]
    if len(matches) != 1:
        raise RuntimeError(
            "expected exactly one guest RAMFB visual commit for input_seq=%d" % seq
        )
    return matches[0]

# The baseline capture is attributable only when the guest reports the exact
# RAMFB buffer and successful visual commit that produced its initial frame.
_, baseline_serial = wait_serial(
    r"^\[ramfb-visual-commit\] input_seq=0 address=\d+ width=\d+ "
    r"height=\d+ stride=\d+ format=bgra8888 rendered_revision=\d+ "
    r"frame_id=\d+ checksum=[0-9a-fA-F]+ "
    r"checksum_us=\d+ damage_kind=conservative-full-frame "
    r"damage_bound_x=\d+ damage_bound_y=\d+ damage_bound_width=\d+ "
    r"damage_bound_height=\d+ status=success\r?$",
    5,
)
baseline_commit = commit_for_sequence(baseline_serial, 0)
if baseline_commit["rendered_revision"] != baseline_revision:
    raise RuntimeError("baseline RAMFB renderer revision does not match desktop revision")
screendump(before_path)

def inject_and_wait(events, poll_pattern, frame_label):
    # Keep one logical input in flight until the guest proves its poll, frame,
    # and RAMFB presentation. This prevents scheduler-dependent attribution of
    # several queued inputs to one render.
    qmp("input-send-event", {"events": events})
    poll, _ = wait_serial(poll_pattern, 10)
    seq = int(poll.group(1))
    frame, serial = wait_serial(
        r"^\[%s\] input_seq=%d rendered_revision=(\d+) "
        r"frame_id=(\d+)\r?$" % (frame_label, seq),
        15,
    )
    _, serial = wait_serial(
        r"^\[ramfb-visual-commit\] input_seq=%d .* status=success\r?$" % seq,
        15,
    )
    commit = commit_for_sequence(serial, seq)
    if (
        int(frame.group(1)) != commit["rendered_revision"] or
        int(frame.group(2)) != commit["frame_id"]
    ):
        raise RuntimeError("input frame does not match RAMFB render provenance")
    return seq, commit

# Preserve the guest's declared six-event order. Each logical input action
# completes its own
# guest poll/frame/commit cycle before the next QMP command is admitted.
move_seq, move_commit = inject_and_wait(
    [
        {"type": "rel", "data": {"axis": "x", "value": 24}},
        {"type": "rel", "data": {"axis": "y", "value": 16}},
    ],
    r"^\[wm-pointer-poll\] source=poll input_seq=(\d+) "
    r"x=\d+ y=\d+ button_code=\d+ kind_code=3\r?$",
    "wm-pointer-frame",
)
down_seq, down_commit = inject_and_wait(
    [{"type": "btn", "data": {"down": True, "button": "left"}}],
    r"^\[wm-pointer-poll\] source=poll input_seq=(\d+) "
    r"x=\d+ y=\d+ button_code=\d+ kind_code=1\r?$",
    "wm-pointer-frame",
)
up_seq, up_commit = inject_and_wait(
    [{"type": "btn", "data": {"down": False, "button": "left"}}],
    r"^\[wm-pointer-poll\] source=poll input_seq=(\d+) "
    r"x=\d+ y=\d+ button_code=\d+ kind_code=2\r?$",
    "wm-pointer-frame",
)
key_down_seq, key_down_commit = inject_and_wait(
    [{"type": "key", "data": {
        "down": True, "key": {"type": "qcode", "data": "tab"}
    }}],
    r"^\[wm-key-poll\] source=poll input_seq=(\d+) "
    r"edge=press code=15\r?$",
    "wm-key-frame",
)
key_up_seq, key_up_commit = inject_and_wait(
    [{"type": "key", "data": {
        "down": False, "key": {"type": "qcode", "data": "tab"}
    }}],
    r"^\[wm-key-poll\] source=poll input_seq=(\d+) "
    r"edge=release code=15\r?$",
    "wm-key-frame",
)

_, serial = wait_serial(
    r"^\[backend2d-event-receipt\] backend=simpleos-qemu-arm64 "
    r"event_backend=virtio-mmio event_count=6 "
    r"sequence=focus,pointer_move,pointer_down,pointer_up,key_down,key_up "
    r"delivered=true\r?$",
    10,
)

def sequence(pattern):
    matches = [int(value) for value in re.findall(pattern, serial, re.M)]
    if not matches:
        raise RuntimeError("missing guest sequence: " + pattern)
    return matches[-1]

raw_down_seq = sequence(
    r"^\[virtio-input-device\] input_seq=(\d+) device=pointer "
    r"type=1 code=272 value=1 frame=raw-edge\r?$"
)
raw_up_seq = sequence(
    r"^\[virtio-input-device\] input_seq=(\d+) device=pointer "
    r"type=1 code=272 value=0 frame=raw-edge\r?$"
)
raw_key_down_seq = sequence(
    r"^\[virtio-input-device\] input_seq=(\d+) device=keyboard "
    r"type=1 code=15 value=1\r?$"
)
raw_key_up_seq = sequence(
    r"^\[virtio-input-device\] input_seq=(\d+) device=keyboard "
    r"type=1 code=15 value=0\r?$"
)
if (
    raw_down_seq != down_seq or raw_up_seq != up_seq or
    raw_key_down_seq != key_down_seq or raw_key_up_seq != key_up_seq
):
    raise RuntimeError("raw device sequence does not match delivered WM sequence")
if not (move_seq < down_seq < up_seq < key_down_seq < key_up_seq):
    raise RuntimeError("guest input sequences are not strictly ordered")

input_sequences = [move_seq, down_seq, up_seq, key_down_seq, key_up_seq]
input_commits = [
    move_commit, down_commit, up_commit, key_down_commit, key_up_commit
]
previous_frame_id = baseline_commit["frame_id"]
for commit in input_commits:
    if (
        commit["address"] != baseline_commit["address"] or
        commit["width"] != baseline_commit["width"] or
        commit["height"] != baseline_commit["height"] or
        commit["stride"] != baseline_commit["stride"] or
        commit["frame_id"] <= previous_frame_id
    ):
        raise RuntimeError("RAMFB visual commits are not stable and monotonic")
    previous_frame_id = commit["frame_id"]

if not re.search(
    r"^\[virtio-input-device\] input_seq=%d device=pointer "
    r"type=2 code=0 value=24 frame=raw-summary\r?$" % move_seq,
    serial, re.M,
) or not re.search(
    r"^\[virtio-input-device\] input_seq=%d device=pointer "
    r"type=2 code=1 value=16 frame=raw-summary\r?$" % move_seq,
    serial, re.M,
):
    raise RuntimeError("pointer relative-motion receipt mismatch")

expected_pointer_x = baseline_commit["width"] // 2 + 24
expected_pointer_y = baseline_commit["height"] // 2 + 16
pointer_focus = {}
for seq, kind, button in (
    (move_seq, 3, 0),
    (down_seq, 1, 1),
    (up_seq, 2, 1),
):
    if not re.search(
        r"^\[wm-pointer-poll\] source=poll input_seq=%d "
        r"x=%d y=%d button_code=%d kind_code=%d\r?$"
        % (seq, expected_pointer_x, expected_pointer_y, button, kind),
        serial, re.M,
    ):
        raise RuntimeError("pointer poll correlation missing")
    state = re.search(
        r"^\[wm-pointer-state\] input_seq=%d focused_idx=(-?\d+)\r?$" % seq,
        serial, re.M,
    )
    if not state:
        raise RuntimeError("pointer state correlation missing")
    pointer_focus[seq] = int(state.group(1))
    frame = re.search(
        r"^\[wm-pointer-frame\] input_seq=%d rendered_revision=(\d+) "
        r"frame_id=(\d+)\r?$" % seq,
        serial, re.M,
    )
    commit = commit_for_sequence(serial, seq)
    if (
        not frame or
        int(frame.group(1)) != commit["rendered_revision"] or
        int(frame.group(2)) != commit["frame_id"]
    ):
        raise RuntimeError("pointer frame correlation missing")

key_focus = {}
for seq, edge, changed in (
    (key_down_seq, "press", "true"),
    (key_up_seq, "release", "false"),
):
    if not re.search(
        r"^\[wm-key-poll\] source=poll input_seq=%d edge=%s code=15\r?$"
        % (seq, edge), serial, re.M,
    ):
        raise RuntimeError("key poll correlation missing")
    state = re.search(
        r"^\[wm-key-state\] input_seq=%d edge=%s changed=%s "
        r"focused_idx=(-?\d+)\r?$" % (seq, edge, changed), serial, re.M,
    )
    if not state:
        raise RuntimeError("key state correlation missing")
    key_focus[seq] = int(state.group(1))
    frame = re.search(
        r"^\[wm-key-frame\] input_seq=%d rendered_revision=(\d+) "
        r"frame_id=(\d+)\r?$" % seq,
        serial, re.M,
    )
    commit = commit_for_sequence(serial, seq)
    if (
        not frame or
        int(frame.group(1)) != commit["rendered_revision"] or
        int(frame.group(2)) != commit["frame_id"]
    ):
        raise RuntimeError("key frame correlation missing")

if key_focus[key_down_seq] == pointer_focus[up_seq]:
    raise RuntimeError("Tab key-down did not change focused window")
if key_focus[key_up_seq] != key_focus[key_down_seq]:
    raise RuntimeError("Tab key-up unexpectedly changed focused window")

screendump(after_path)
before_w, before_h, before_pixels, before_sha = ppm(before_path)
after_w, after_h, after_pixels, after_sha = ppm(after_path)
if (before_w, before_h) != (after_w, after_h):
    raise RuntimeError("capture dimensions changed")
changed_bytes = sum(a != b for a, b in zip(before_pixels, after_pixels))
if before_sha == after_sha or changed_bytes <= 0:
    raise RuntimeError("post-input RAMFB capture is identical")
if (
    before_w != baseline_commit["width"] or
    before_h != baseline_commit["height"]
):
    raise RuntimeError("QMP capture dimensions do not match guest RAMFB receipt")

damage_bounds = [
    commit["region"] for commit in input_commits
    if commit["region"][2] > 0 and commit["region"][3] > 0
]
if not damage_bounds:
    raise RuntimeError("guest reported no RAMFB damage bound")
changed_pixels = 0
outside_pixels = 0
for y in range(before_h):
    for x in range(before_w):
        offset = (y * before_w + x) * 3
        if before_pixels[offset:offset + 3] == after_pixels[offset:offset + 3]:
            continue
        changed_pixels += 1
        if not any(
            rx <= x < rx + rw and ry <= y < ry + rh
            for rx, ry, rw, rh in damage_bounds
        ):
            outside_pixels += 1
if changed_pixels <= 0 or outside_pixels != 0:
    raise RuntimeError("QMP pixel delta is outside guest-declared damage bounds")

final_commit = input_commits[-1]
if final_commit["checksum"] == baseline_commit["checksum"]:
    raise RuntimeError("guest RAMFB checksum did not change")
# Reject a later uncorrelated repaint that could make the after capture belong
# to a frame other than the final injected input.
latest_commits = [parse_commit(match) for match in commit_pattern.finditer(serial_text())]
if (
    not latest_commits or
    latest_commits[-1]["frame_id"] != final_commit["frame_id"]
):
    raise RuntimeError("uncorrelated RAMFB commit occurred before after capture")

# Recheck the whole final transcript so a duplicate or fallback receipt emitted
# after desktop-ready cannot survive into the PASS record.
final_simd_receipt = require_simd_receipt(serial_text())
if final_simd_receipt != simd_receipt:
    raise RuntimeError("guest Engine2D SIMD receipt changed during run")
final_fps_receipt = require_fps_receipt(serial_text())
if final_fps_receipt != fps_receipt:
    raise RuntimeError("guest Engine2D FPS receipt changed during run")

print("qmp_transport=input-send-event")
print("capture_origin=qemu-ramfb-screendump")
print("simd_arch=%s" % final_simd_receipt["arch"])
print("simd_isa=%s" % final_simd_receipt["isa"])
print("simd_enabled=%d" % final_simd_receipt["enabled"])
print("simd_native_hits=%d" % final_simd_receipt["native_hits"])
print("simd_vector_chunks=%d" % final_simd_receipt["vector_chunks"])
print("simd_scalar_tail_pixels=%d" % final_simd_receipt["scalar_tail_pixels"])
print(
    "simd_required_kernel_kinds=%s"
    % final_simd_receipt["required_kernel_kinds"]
)
print(
    "simd_executed_kernel_kinds=%s"
    % final_simd_receipt["executed_kernel_kinds"]
)
print("simd_fallback=%s" % final_simd_receipt["fallback"])
print("simd_scalar_parity=%s" % final_simd_receipt["scalar_parity"])
print("fps_path=%s" % final_fps_receipt["path"])
print("fps_backend=%s" % final_fps_receipt["backend"])
print("fps_warmup_frames=%d" % final_fps_receipt["warmup_frames"])
print("fps_sample_frames=%d" % final_fps_receipt["sample_frames"])
print("fps_elapsed_us=%d" % final_fps_receipt["elapsed_us"])
print("fps_x1000=%d" % final_fps_receipt["fps_x1000"])
print("fps_minimum_x1000=%d" % final_fps_receipt["minimum_fps_x1000"])
print("fps_simd_fill_hits_delta=%d" % final_fps_receipt["simd_fill_hits_delta"])
print("fps_simd_fill_chunks_delta=%d" % final_fps_receipt["simd_fill_chunks_delta"])
print("baseline_revision=%d" % baseline_revision)
print("pointer_sequences=%d,%d,%d" % (move_seq, down_seq, up_seq))
print("key_sequences=%d,%d" % (key_down_seq, key_up_seq))
print("before_sha256=%s" % before_sha)
print("after_sha256=%s" % after_sha)
print("changed_rgb_bytes=%d" % changed_bytes)
print("changed_rgb_pixels=%d" % changed_pixels)
print("outside_damage_bound_pixels=%d" % outside_pixels)
print("damage_bound_kind=conservative-full-frame")
print("baseline_rendered_revision=%d" % baseline_commit["rendered_revision"])
print("after_rendered_revision=%d" % final_commit["rendered_revision"])
print("baseline_ramfb_frame_id=%d" % baseline_commit["frame_id"])
print("after_ramfb_frame_id=%d" % final_commit["frame_id"])
print("baseline_ramfb_checksum=%s" % baseline_commit["checksum"])
print("after_ramfb_checksum=%s" % final_commit["checksum"])
print("max_checksum_us=%d" % max_checksum_us)
print("peak_checksum_us=%d" % max(
    [baseline_commit["checksum_us"]] +
    [commit["checksum_us"] for commit in input_commits]
))
print("capture_width=%d" % before_w)
print("capture_height=%d" % before_h)
PY
QMP_CODE=$?
set -e

[ "$QMP_CODE" -eq 0 ] || fail_evidence "qmp-input-or-correlation-failed"

field() {
    sed -n "s/^$1=//p" "$QMP_LOG" | tail -n 1
}

BEFORE_SHA256="$(field before_sha256)"
AFTER_SHA256="$(field after_sha256)"
CHANGED_RGB_BYTES="$(field changed_rgb_bytes)"
[ -n "$BEFORE_SHA256" ] && [ -n "$AFTER_SHA256" ] ||
    fail_evidence "capture-digest-missing"
[ "$BEFORE_SHA256" != "$AFTER_SHA256" ] ||
    fail_evidence "captures-identical"
[ "${CHANGED_RGB_BYTES:-0}" -gt 0 ] ||
    fail_evidence "capture-payload-unchanged"

END_KERNEL_SHA256="$(sha256_file "$KERNEL")" ||
    fail_evidence "canonical-kernel-post-capture-sha256-failed"
END_DISK_SHA256="$(sha256_file "$DISK")" ||
    fail_evidence "canonical-disk-post-capture-sha256-failed"
END_SIMPLE_CORE_SHA256="$(sha256_file "$MANIFEST_SIMPLE_CORE_PATH")" ||
    fail_evidence "canonical-simple-core-post-capture-sha256-failed"
[ "$END_KERNEL_SHA256" = "$LAUNCH_KERNEL_SHA256" ] ||
    fail_evidence "canonical-kernel-mutated-during-run"
[ "$END_DISK_SHA256" = "$LAUNCH_DISK_SHA256" ] ||
    fail_evidence "canonical-disk-mutated-during-run"
[ "$END_SIMPLE_CORE_SHA256" = "$LAUNCH_SIMPLE_CORE_SHA256" ] ||
    fail_evidence "canonical-simple-core-mutated-during-run"
END_SOURCE_REVISION="$(git rev-parse --verify HEAD 2>/dev/null)" ||
    fail_evidence "post-capture-source-revision-unavailable"
[ "$END_SOURCE_REVISION" = "$LAUNCH_SOURCE_REVISION" ] ||
    fail_evidence "source-revision-changed-during-run"
if arm64_guest_source_dirty; then
    fail_evidence "guest-source-worktree-dirty-after-capture"
else
    SOURCE_DIRTY_CODE=$?
    [ "$SOURCE_DIRTY_CODE" -eq 1 ] ||
        fail_evidence "guest-source-git-status-failed-after-capture"
fi
arm64_guest_source_snapshot ||
    fail_evidence "post-capture-source-fingerprint-failed"
[ "$ARM64_GUEST_SOURCE_FINGERPRINT" = "$PRE_LAUNCH_SOURCE_FINGERPRINT" ] ||
    fail_evidence "guest-source-fingerprint-changed-during-run"
[ "$ARM64_GUEST_SOURCE_FINGERPRINT" = "$MANIFEST_SOURCE_FINGERPRINT" ] ||
    fail_evidence "post-capture-source-fingerprint-manifest-mismatch"
[ "$ARM64_GUEST_SOURCE_FILE_COUNT" = "$PRE_LAUNCH_SOURCE_FILE_COUNT" ] ||
    fail_evidence "guest-source-file-count-changed-during-run"

{
    echo "arm64_qmp_input_status=pass"
    echo "arm64_qmp_input_reason=live-qmp-guest-frame-ramfb-correlation-pass"
    echo "arm64_qmp_input_transport=input-send-event"
    echo "arm64_qmp_input_capture_origin=qemu-ramfb-screendump"
    echo "arm64_qmp_input_build_manifest=$BUILD_MANIFEST"
    echo "arm64_qmp_input_report=$EVIDENCE_REPORT"
    echo "arm64_qmp_input_simd_arch=$(field simd_arch)"
    echo "arm64_qmp_input_simd_isa=$(field simd_isa)"
    echo "arm64_qmp_input_simd_enabled=$(field simd_enabled)"
    echo "arm64_qmp_input_simd_native_hits=$(field simd_native_hits)"
    echo "arm64_qmp_input_simd_vector_chunks=$(field simd_vector_chunks)"
    echo "arm64_qmp_input_simd_scalar_tail_pixels=$(field simd_scalar_tail_pixels)"
    echo "arm64_qmp_input_simd_required_kernel_kinds=$(field simd_required_kernel_kinds)"
    echo "arm64_qmp_input_simd_executed_kernel_kinds=$(field simd_executed_kernel_kinds)"
    echo "arm64_qmp_input_simd_fallback=$(field simd_fallback)"
    echo "arm64_qmp_input_simd_scalar_parity=$(field simd_scalar_parity)"
    echo "arm64_qmp_input_fps_path=$(field fps_path)"
    echo "arm64_qmp_input_fps_backend=$(field fps_backend)"
    echo "arm64_qmp_input_fps_warmup_frames=$(field fps_warmup_frames)"
    echo "arm64_qmp_input_fps_sample_frames=$(field fps_sample_frames)"
    echo "arm64_qmp_input_fps_elapsed_us=$(field fps_elapsed_us)"
    echo "arm64_qmp_input_fps_x1000=$(field fps_x1000)"
    echo "arm64_qmp_input_fps_minimum_x1000=$(field fps_minimum_x1000)"
    echo "arm64_qmp_input_fps_simd_fill_hits_delta=$(field fps_simd_fill_hits_delta)"
    echo "arm64_qmp_input_fps_simd_fill_chunks_delta=$(field fps_simd_fill_chunks_delta)"
    echo "arm64_qmp_input_guest_source_revision=$MANIFEST_SOURCE_REVISION"
    echo "arm64_qmp_input_host_source_revision=$HOST_SOURCE_REVISION"
    echo "arm64_qmp_input_guest_source_roots=$MANIFEST_SOURCE_ROOTS"
    echo "arm64_qmp_input_guest_source_fingerprint=$MANIFEST_SOURCE_FINGERPRINT"
    echo "arm64_qmp_input_guest_source_file_count=$MANIFEST_SOURCE_FILE_COUNT"
    echo "arm64_qmp_input_compiler_path=$MANIFEST_COMPILER_PATH"
    echo "arm64_qmp_input_compiler_sha256=$MANIFEST_COMPILER_SHA256"
    echo "arm64_qmp_input_compiler_version=$MANIFEST_COMPILER_VERSION"
    echo "arm64_qmp_input_compiler_format=$MANIFEST_COMPILER_FORMAT"
    echo "arm64_qmp_input_compiler_arch=$MANIFEST_COMPILER_ARCH"
    echo "arm64_qmp_input_simple_core_path=$MANIFEST_SIMPLE_CORE_PATH"
    echo "arm64_qmp_input_simple_core_sha256=$MANIFEST_SIMPLE_CORE_SHA256"
    echo "arm64_qmp_input_build_command=$MANIFEST_BUILD_COMMAND"
    echo "arm64_qmp_input_build_environment=$MANIFEST_BUILD_ENVIRONMENT"
    echo "arm64_qmp_input_kernel=$KERNEL"
    echo "arm64_qmp_input_kernel_sha256=$LAUNCH_KERNEL_SHA256"
    echo "arm64_qmp_input_disk=$DISK"
    echo "arm64_qmp_input_disk_sha256=$LAUNCH_DISK_SHA256"
    echo "arm64_qmp_input_disk_producer=$MANIFEST_DISK_PRODUCER_PATH"
    echo "arm64_qmp_input_disk_producer_sha256=$MANIFEST_DISK_PRODUCER_SHA256"
    echo "arm64_qmp_input_pointer_sequences=$(field pointer_sequences)"
    echo "arm64_qmp_input_key_sequences=$(field key_sequences)"
    echo "arm64_qmp_input_before_ppm=$BEFORE_PPM"
    echo "arm64_qmp_input_before_sha256=$BEFORE_SHA256"
    echo "arm64_qmp_input_after_ppm=$AFTER_PPM"
    echo "arm64_qmp_input_after_sha256=$AFTER_SHA256"
    echo "arm64_qmp_input_changed_rgb_bytes=$CHANGED_RGB_BYTES"
    echo "arm64_qmp_input_changed_rgb_pixels=$(field changed_rgb_pixels)"
    echo "arm64_qmp_input_outside_damage_bound_pixels=$(field outside_damage_bound_pixels)"
    echo "arm64_qmp_input_damage_bound_kind=$(field damage_bound_kind)"
    echo "arm64_qmp_input_baseline_rendered_revision=$(field baseline_rendered_revision)"
    echo "arm64_qmp_input_after_rendered_revision=$(field after_rendered_revision)"
    echo "arm64_qmp_input_baseline_ramfb_frame_id=$(field baseline_ramfb_frame_id)"
    echo "arm64_qmp_input_after_ramfb_frame_id=$(field after_ramfb_frame_id)"
    echo "arm64_qmp_input_baseline_ramfb_checksum=$(field baseline_ramfb_checksum)"
    echo "arm64_qmp_input_after_ramfb_checksum=$(field after_ramfb_checksum)"
    echo "arm64_qmp_input_max_checksum_us=$(field max_checksum_us)"
    echo "arm64_qmp_input_peak_checksum_us=$(field peak_checksum_us)"
    echo "arm64_qmp_input_capture_width=$(field capture_width)"
    echo "arm64_qmp_input_capture_height=$(field capture_height)"
    echo "arm64_qmp_input_serial_log=$SERIAL_LOG"
    echo "arm64_qmp_input_qmp_log=$QMP_LOG"
} >"$EVIDENCE_ENV"

{
    echo "# ARM64 SimpleOS QMP input evidence"
    echo
    echo "- status: pass"
    echo "- SIMD architecture: $(field simd_arch)"
    echo "- SIMD ISA: $(field simd_isa)"
    echo "- SIMD enabled: $(field simd_enabled)"
    echo "- SIMD native hits: $(field simd_native_hits)"
    echo "- SIMD vector chunks: $(field simd_vector_chunks)"
    echo "- SIMD scalar tail pixels: $(field simd_scalar_tail_pixels)"
    echo "- SIMD required kernel kinds: $(field simd_required_kernel_kinds)"
    echo "- SIMD executed kernel kinds: $(field simd_executed_kernel_kinds)"
    echo "- SIMD fallback: $(field simd_fallback)"
    echo "- SIMD scalar parity: $(field simd_scalar_parity)"
    echo "- guest canonical WM FPS x1000: $(field fps_x1000)"
    echo "- required FPS x1000: $(field fps_minimum_x1000)"
    echo "- measured frames: $(field fps_sample_frames)"
    echo "- measured elapsed us: $(field fps_elapsed_us)"
    echo "- baseline capture SHA-256: $BEFORE_SHA256"
    echo "- post-input capture SHA-256: $AFTER_SHA256"
    echo "- changed RGB bytes: $CHANGED_RGB_BYTES"
} >"$EVIDENCE_REPORT"

cat "$EVIDENCE_ENV"
