#!/bin/sh
# Guard: an engine probe must never spawn itself unboundedly.
#
# Incident 2026-08-24 (doc/08_tracking/bug/engine_probe_self_exe_fork_bomb_2026-08-24.md):
# `simple_binary()` in src/lib/nogc_sync_mut/spec/engine_probe.spl resolves the
# compiler to spawn via /proc/self/exe. That is a compiler only while the spec
# is being INTERPRETED by one. `native-build` a spec that uses the probe into a
# standalone binary and /proc/self/exe becomes the SPEC: every spawn re-runs the
# spec, which spawns again, orphaned as each 120s parent timeout fires. Measured
# on this host: 61 processes at 23:19, 52,491 at 00:22, still growing to 61,838
# during the first sweep; load average 19,272 on 32 cores.
#
# No existing guard could see it. The pre-push guards check trees, ranges and
# source text; check-c-runtime-compiles-push.shs runs a compiler but over
# SOURCE; check-stage-binaries-runnable.shs executes artifacts but only the two
# bootstrap-CLI commands on a hello world, which terminates. A binary that runs
# CORRECTLY and merely never stops multiplying is invisible to all of them.
#
# Three fail-closed checks, none of which ever spawns an unbounded fleet:
#   1. mechanism  -- the reentrancy guard is present and wired into the spawn path
#   2. behaviour  -- a REAL jailed run proves the guard refuses to spawn (RLIMIT_NPROC
#                    bounded, setsid-detached, timeout-bounded, count asserted after)
#   3. similar    -- static scan for any OTHER self-exe respawn with no cycle guard
#
# Verdict is the last line of stdout, per .claude/rules/vcs.md:
#   PASS — <n> check(s) run, 0 failed        exit 0
#   FAIL — ...                               exit 1
#   ERROR — nothing was checked (<reason>)   exit 2
set -u

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
PROBE="$ROOT/src/lib/nogc_sync_mut/spec/engine_probe.spl"
DEPTH_VAR="SIMPLE_ENGINE_PROBE_ACTIVE"
CHECKED=0
FAILED=""

fail() { FAILED="$FAILED $1"; echo "  FAIL  $1: $2"; }
ok()   { echo "  ok    $1"; }

# ---------------------------------------------------------------- selftest ---
# Fatal, runs first. Proves the scanner discriminates rather than always
# agreeing: a fixture WITHOUT the guard must be reported unguarded, one WITH it
# must not. Without this a typo'd grep pattern silently passes everything.
selftest() {
    d=$(mktemp -d) || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
    trap 'rm -rf "$d"' EXIT

    cat > "$d/unguarded.spl" <<'EOF'
val self_path = rt_path_absolute("/proc/self/exe") ?? ""
val result = rt_process_run_bounded(self_path, ["run", spl_path], 1000, 1000)
EOF
    cat > "$d/guarded.spl" <<'EOF'
val self_path = rt_path_absolute("/proc/self/exe") ?? ""
if probe_spawn_is_reentrant():
    return ("", "refusing", -1)
val result = rt_process_run_bounded(self_path, ["run", spl_path], 1000, 1000)
EOF

    if ! scan_unguarded "$d/unguarded.spl"; then
        echo "ERROR — nothing was checked (selftest: unguarded fixture not detected)"; exit 2
    fi
    if scan_unguarded "$d/guarded.spl"; then
        echo "ERROR — nothing was checked (selftest: guarded fixture wrongly flagged)"; exit 2
    fi

    # The jail itself must work, or check 2 would be vacuous. A deliberate
    # fork bomb under the jail must be contained and must not survive it.
    cat > "$d/bomb.sh" <<'EOF'
#!/bin/sh
"$0" & "$0" &
wait
EOF
    chmod +x "$d/bomb.sh"
    before=$(count_procs)
    jailed "$d/bomb.sh" >/dev/null 2>&1
    sleep 1
    pkill -9 -f "$d/bomb.sh" 2>/dev/null
    sleep 1
    after=$(count_procs)
    grew=$((after - before))
    if [ "$grew" -gt 400 ]; then
        echo "ERROR — nothing was checked (selftest: jail did not contain a fork bomb, +$grew procs)"; exit 2
    fi
    rm -rf "$d"; trap - EXIT
}

count_procs() { ls -d /proc/[0-9]* 2>/dev/null | wc -l; }

# Run a command so a runaway cannot take the box down:
#   setsid   -- own process group, so one pkill reaches every descendant
#   ulimit -u -- RLIMIT_NPROC is PER-USER, so the cap must be current + headroom,
#                never a small absolute (that would kill the user's own shells)
#   timeout  -- bounded wall clock even if the guard works and it just hangs
jailed() {
    cap=$(( $(count_procs) + 60 ))
    setsid sh -c "ulimit -u $cap 2>/dev/null; exec timeout -s KILL 30 \"\$@\"" sh "$@"
}

# A file is unguarded when it spawns a process using a /proc/self/exe-derived
# path and carries no reentrancy check. Text-level by necessity — the point is
# to catch a NEW copy of this pattern before it ever runs.
scan_unguarded() {
    f=$1
    grep -q '/proc/self/exe' "$f" 2>/dev/null || return 1
    grep -q 'rt_process_run_bounded\|rt_process_run\|process_spawn' "$f" 2>/dev/null || return 1
    grep -q "probe_spawn_is_reentrant\|$DEPTH_VAR" "$f" 2>/dev/null && return 1
    return 0
}

selftest

echo "engine probe self-spawn guard"

# --- 1. mechanism -------------------------------------------------------------
CHECKED=$((CHECKED + 1))
if [ ! -f "$PROBE" ]; then
    echo "ERROR — nothing was checked (engine_probe.spl not found at $PROBE)"; exit 2
fi
if grep -q "probe_spawn_is_reentrant" "$PROBE" && \
   grep -q "if probe_spawn_is_reentrant():" "$PROBE" && \
   grep -q "env_set(PROBE_DEPTH_VAR" "$PROBE"; then
    ok "reentrancy guard defined, checked before spawn, and exported to the child"
else
    fail "mechanism" "engine_probe.spl lost its reentrancy guard (defined/checked/exported)"
fi

# The guard must be checked BEFORE the spawn, not after it.
CHECKED=$((CHECKED + 1))
guard_line=$(grep -n "if probe_spawn_is_reentrant():" "$PROBE" | head -1 | cut -d: -f1)
spawn_line=$(grep -n "rt_process_run_bounded(binary" "$PROBE" | head -1 | cut -d: -f1)
if [ -n "$guard_line" ] && [ -n "$spawn_line" ] && [ "$guard_line" -lt "$spawn_line" ]; then
    ok "guard is checked before the spawn (line $guard_line < $spawn_line)"
else
    fail "ordering" "guard at '${guard_line:-none}' does not precede spawn at '${spawn_line:-none}'"
fi

# --- 2. behaviour: a real, jailed run -----------------------------------------
# The honest check. Pre-fix this spawns; post-fix it refuses. Bounded either way.
CHECKED=$((CHECKED + 1))
SIMPLE_BIN="$ROOT/bin/simple"
if [ ! -x "$SIMPLE_BIN" ]; then
    echo "ERROR — nothing was checked (no runnable bin/simple to exercise the guard)"; exit 2
fi

wd=$(mktemp -d) || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
cat > "$wd/reentrant_probe.spl" <<'EOF'
use std.spec.engine_probe.{run_under_engine}

fn main() -> void:
    # Stands in for a native-built spec: the depth var is already set, exactly
    # as it would be inside a probe child. Spawning again is the fork bomb.
    val (_out, err, code) = run_under_engine("test/03_system/feature/usage/networking_jit_probe.spl", "interpret")
    if code == -1 and err.contains("refusing to spawn"):
        print("GUARD VERDICT: REFUSED")
    else:
        print("GUARD VERDICT: SPAWNED (exit " + code.to_text() + ")")
EOF

before=$(count_procs)
out=$(cd "$ROOT" && env "$DEPTH_VAR=1" \
      $(command -v setsid) sh -c "ulimit -u $((before + 60)) 2>/dev/null; exec timeout -s KILL 180 '$SIMPLE_BIN' run '$wd/reentrant_probe.spl'" 2>&1)
rc=$?
pkill -9 -f "$wd/reentrant_probe.spl" 2>/dev/null
sleep 1
after=$(count_procs)
grew=$((after - before))
rm -rf "$wd"

case "$out" in
    *"GUARD VERDICT: REFUSED"*)
        ok "a reentrant run_under_engine refuses to spawn (process count +$grew)" ;;
    *"GUARD VERDICT: SPAWNED"*)
        fail "behaviour" "run_under_engine spawned from inside a probe child (+$grew procs) — the fork bomb is live" ;;
    *)
        # rc 137/124 means the jail had to kill it: that is a runaway, not a skip.
        if [ "$rc" -ge 124 ]; then
            fail "behaviour" "reentrant run was killed by the jail (rc=$rc, +$grew procs) — treat as unbounded"
        else
            echo "ERROR — nothing was checked (reentrant probe printed no verdict, rc=$rc: $(echo "$out" | tail -3 | tr '\n' ' '))"
            exit 2
        fi ;;
esac

if [ "$grew" -gt 50 ]; then
    fail "growth" "process count grew by $grew during a single guarded run"
else
    CHECKED=$((CHECKED + 1)); ok "process count bounded across the run (+$grew)"
fi

# --- 3. similar defects elsewhere ---------------------------------------------
# The same shape anywhere else is the same bug waiting. Owned code only, per
# CLAUDE.md's Owned-Code Scope.
CHECKED=$((CHECKED + 1))
offenders=""
scanned=0
for f in $(find "$ROOT/src" -name '*.spl' -not -path '*/vendor/*' 2>/dev/null); do
    scanned=$((scanned + 1))
    if scan_unguarded "$f"; then
        offenders="$offenders ${f#$ROOT/}"
    fi
done
if [ "$scanned" -eq 0 ]; then
    echo "ERROR — nothing was checked (found no .spl files to scan)"; exit 2
fi
if [ -z "$offenders" ]; then
    ok "no other unguarded /proc/self/exe respawn in $scanned .spl file(s)"
else
    fail "similar" "unguarded self-exe respawn:$offenders"
fi

echo
if [ -z "$FAILED" ]; then
    echo "PASS — $CHECKED check(s) run, 0 failed"
    exit 0
fi
echo "FAIL — $CHECKED check(s) run, failed:$FAILED"
exit 1
