#!/bin/sh
# Exactly one enabled native control, then one original frozen SDK compile.
set -eu
workspace=${GITHUB_WORKSPACE:?workflow workspace is required}
control="$workspace/control"
data="$workspace/data"
out="$workspace/build/verify/sdk-worker-observer-cycle1"
compiler="$out/handoff/linux-x86_64-p1/simple"
evidence="$control/scripts/check/sdk-observer-evidence-v1.py"
mkdir -p "$out/control" "$out/sdk/src/app" "$out/sdk/cache"
printf 'schema: sdk-observer-cycle1-outcome-v1\nsdk: NOT_RUN\nqualification: none\np3: skipped\n' > "$out/outcome.sdn"
python3 - "$out/heartbeat.log" "$$" <<'PYHEART' &
import datetime, os, pathlib, subprocess, sys, time
path, owner = pathlib.Path(sys.argv[1]), int(sys.argv[2])
end = time.monotonic() + 3600
with path.open('w', buffering=1) as out:
    out.write(f'heartbeat_pid={os.getpid()} heartbeat_pgid={os.getpgrp()} shell_pid={owner}\n')
    while time.monotonic() < end and pathlib.Path(f'/proc/{owner}').is_dir():
        out.write(datetime.datetime.now(datetime.timezone.utc).isoformat() + '\n')
        for name in ('meminfo', 'swaps'):
            out.write(pathlib.Path('/proc', name).read_text())
        status = subprocess.run(['ps', '-eo', 'pid,ppid,pgid,rss,stat,comm', '--sort=-rss'],
                                text=True, capture_output=True, timeout=5)
        out.write('\n'.join(status.stdout.splitlines()[:16]) + '\n')
        out.flush()
        time.sleep(30)
PYHEART
heartbeat=$!
trap 'kill "$heartbeat" 2>/dev/null || true' EXIT
test "$GITHUB_RUN_ATTEMPT" = 1
test "$(git -C "$control" rev-parse HEAD)" = "$CONTROL_SOURCE"
test "$(git -C "$data" rev-parse HEAD)" = 0d9debaf39e604c531b5214f014c290c7c3e044f
test "$(git -C "$data" rev-parse HEAD:src/compiler)" = 2ad653b6a28c4b7ba1a23027c6f3f74a0e5bdffd
test "$(git -C "$data" rev-parse HEAD:src/lib)" = e3206c4c74b3b8bcdc4d967b28e359f314bc22f4
git -C "$data" diff --exit-code -- src/compiler src/lib > "$out/data-before.diff"
grep -Fxq 'pub const SDK_ERRNO_OBSERVER_ENABLED_V1: bool = true' "$control/src/compiler/00.common/sdk_errno_observer_v1.spl"
test -s "$out/producer-binding.sdn"
chmod 755 "$compiler"
sha256sum "$compiler" > "$out/compiler-before.sha256"
set +e
ldd "$compiler" > "$out/compiler-linked-libraries.txt" 2>&1
linked_status=$?
set -e
printf '%s\n' "$linked_status" > "$out/compiler-linked-libraries.exit"
sha256sum "$data/src/lib/nogc_sync_mut/io/path_identity.spl" \
  "$data/src/compiler/70.backend/backend/simpleos_sysroot_receipt.spl" > "$out/data-source.sha256"

control_lane="$out/control"
set +e
/usr/bin/time -v -o "$control_lane/compile.resources" timeout --verbose --signal=TERM --kill-after=5s 600s \
  env RUST_LOG=error SIMPLE_BOOTSTRAP=1 SIMPLE_MONO_ROOT_DISCOVERY=1 \
    SIMPLE_SCV_INVENTORY_COLD_INIT=1 SIMPLE_PARSE_SHARDING=1 \
    SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_RTI_DIAGNOSTICS=1 \
    "$compiler" native-build --source "$control/src/compiler" --source "$control/src/lib" \
      --source "$control/test/fixtures/compiler" --entry-closure \
      --entry "$control/test/fixtures/compiler/sdk_errno_observer_enabled_v1.spl" \
      --mode dynload --low-memory --threads 4 --cache-dir "$control_lane/cache" \
      --output "$control_lane/program" > "$control_lane/compile.stdout" 2> "$control_lane/compile.stderr"
code=$?
set -e
printf '%s\n' "$code" > "$control_lane/compile.exit"
test "$code" = 0
test -s "$control_lane/program" && test ! -L "$control_lane/program"
sha256sum "$control_lane/program" > "$control_lane/program.sha256"
set +e
timeout --verbose --signal=TERM --kill-after=5s 120s "$control_lane/program" \
  > "$control_lane/runtime.stdout" 2> "$control_lane/runtime.stderr"
code=$?
set -e
printf '%s\n' "$code" > "$control_lane/runtime.exit"
test "$code" = 0
test ! -s "$control_lane/runtime.stdout"
python3 "$evidence" records --kind control --log "$control_lane/runtime.stderr" \
  --output "$control_lane/capture.sdn"

# Original SDK command/selected source bytes, with separate stdout/stderr capture.
lane="$out/sdk"
python3 - "$lane/environment.sdn" <<'PYENV'
import json, os, pathlib, sys
names = ('SIMPLE_NATIVE_BUILD_TARGET', 'SIMPLE_NATIVE_LIBRARY_MODE', 'SIMPLE_LIBRARY_MODE',
         'SIMPLE_STAGE3_STREAMING_SURFACES', 'SIMPLE_BOOTSTRAP_STAGE4', 'SIMPLE_STAGE4_STREAMING_SURFACES')
pathlib.Path(sys.argv[1]).write_text('schema: sdk-observer-ambient-context-v1\n' +
    ''.join(f'{key}: {json.dumps(os.environ.get(key, ""))}\n' for key in names))
PYENV
cp "$data/test/fixtures/compiler/simpleos_sysroot_receipt_owner/main.spl" "$lane/src/app/simpleos_sdk_owner_probe.spl"
printf '%s  %s\n' 98602bc41839ce44421338ff9dd4d7d7de329aa93df89d568f40a31bcb119808 \
  "$lane/src/app/simpleos_sdk_owner_probe.spl" | sha256sum --check --strict > "$lane/entry-binding.txt"
printf '%s  %s\n' a4a1904d68e355d6cc95ceff7867edd26454c66afdb0db812fe7dd0e36886d3b \
  "$data/src/compiler/70.backend/backend/simpleos_sysroot_receipt.spl" | sha256sum --check --strict > "$lane/owner-binding.txt"
{
  printf 'schema: sdk-observer-original-attempt-v1\noriginal_run: 45194358128\n'
  printf 'data_source: 0d9debaf39e604c531b5214f014c290c7c3e044f\n'
  printf 'producer_source: %s\nproducer_sha256: %s\n' "$PRODUCER_SOURCE" "$PRODUCER_SHA256"
  printf 'mode: dynload\nlow_memory: true\nthreads: 4\nrequested_target: omitted\nrequested_library_mode: omitted\n'
  printf 'compile_timeout_seconds: 1000\nexecution_timeout_seconds: 120\n'
  printf 'output_capture_change: separate-stdout-stderr\n'
  printf 'environment: RUST_LOG=error,SIMPLE_BOOTSTRAP=1,SIMPLE_MONO_ROOT_DISCOVERY=1,SIMPLE_SCV_INVENTORY_COLD_INIT=1,SIMPLE_PARSE_SHARDING=1,SIMPLE_NO_STUB_FALLBACK=1,SIMPLE_RTI_DIAGNOSTICS=1\n'
} > "$lane/attempt.sdn"
(
  cd "$data"
  printf '%s\n' "$compiler" native-build --source "$data/src/compiler" --source "$data/src/lib" \
    --source "$lane/src/app" --entry-closure --entry "$lane/src/app/simpleos_sdk_owner_probe.spl" \
    --mode dynload --low-memory --threads 4 --cache-dir "$lane/cache" --output "$lane/program" > "$lane/argv-lines.txt"
  printf 'schema: sdk-observer-cycle1-outcome-v1\nsdk: ATTEMPTED\ncollection: PENDING\nqualification: none\np3: skipped\n' > "$out/outcome.sdn"
  set +e
  /usr/bin/time -v -o "$lane/resources.txt" timeout --verbose --signal=TERM --kill-after=5s 1000s \
    env RUST_LOG=error SIMPLE_BOOTSTRAP=1 SIMPLE_MONO_ROOT_DISCOVERY=1 \
      SIMPLE_SCV_INVENTORY_COLD_INIT=1 SIMPLE_PARSE_SHARDING=1 \
      SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_RTI_DIAGNOSTICS=1 \
      "$compiler" native-build --source "$data/src/compiler" --source "$data/src/lib" --source "$lane/src/app" \
        --entry-closure --entry "$lane/src/app/simpleos_sdk_owner_probe.spl" \
        --mode dynload --low-memory --threads 4 --cache-dir "$lane/cache" --output "$lane/program" \
        > "$lane/native-build.stdout" 2> "$lane/native-build.stderr"
  code=$?
  set -e
  printf '%s\n' "$code" > "$lane/native-build.exit"
)
set +e
python3 "$evidence" records --kind sdk --data-root "$data" --log "$lane/native-build.stderr" --output "$lane/capture.sdn" \
  > "$lane/capture-check.stdout" 2> "$lane/capture-check.stderr"
capture=$?
set -e
printf '%s\n' "$capture" > "$lane/capture-check.exit"
if [ "$capture" != 0 ]; then
  printf 'schema: sdk-observer-capture-v1\nstatus: INCOMPLETE\nresolver_fix_proved: false\nsdk_qualification: none\n' > "$lane/capture.sdn"
fi
execution=NOT_RUN
run_code=125
if [ "$(cat "$lane/native-build.exit")" = 0 ] && [ -s "$lane/program" ]; then
  sha256sum "$lane/program" > "$lane/program.sha256"
  digest=$(sha256sum "$lane/program" | awk '{print $1}')
  set +e
  (
    cd "$data"
    timeout --verbose --signal=TERM --kill-after=5s 120s \
      env CC="$(command -v clang)" AR="$(command -v llvm-ar)" \
      sh test/fixtures/compiler/simpleos_sysroot_receipt_owner/run.shs "$lane/program" "$digest"
  ) > "$lane/wrapper.stdout" 2> "$lane/wrapper.stderr"
  run_code=$?
  set -e
  execution=FAIL
  if [ "$run_code" = 0 ]; then execution=PASS; fi
fi
printf '%s\n' "$run_code" > "$lane/execution.exit"
printf '%s\n' "$execution" > "$lane/execution.status"
git -C "$data" diff --exit-code -- src/compiler src/lib > "$out/data-after.diff"
sha256sum --check --strict "$out/compiler-before.sha256" > "$out/compiler-after-binding.txt"
worker_records=INCOMPLETE
if [ "$capture" = 0 ]; then worker_records=CAPTURED_DIAGNOSTIC_DATA; fi
printf 'schema: sdk-observer-cycle1-outcome-v1\nraw_collection: COMPLETE\nworker_records: %s\nsdk_native_exit: %s\nexecution: %s\nobserver_capture_exit: %s\nqualification: diagnostic-only\nsdk_qualification: none\np3: skipped\n' \
  "$worker_records" "$(cat "$lane/native-build.exit")" "$execution" "$capture" > "$out/outcome.sdn"
# Successful collection is not compiler or SDK admission.
