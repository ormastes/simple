#!/bin/sh
# LLVM/Cranelift builtin-method parity: native-build the fixture with both
# backends; outputs must be identical and equal to the expected text.
# usage: check-llvm-builtin-method-parity.shs <seed-simple-with-llvm-feature>
set -u
seed=${1:?usage: $0 <seed-simple>}
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
fx="$root/test/native/llvm_builtin_parity"
tmp=$(mktemp -d) || exit 2
trap 'rm -rf "$tmp"' EXIT
for be in cranelift llvm; do
  (cd "$fx" && SIMPLE_NATIVE_BUILD_RUST=1 "$seed" native-build builtin_method_parity.spl \
    --source . --backend "$be" -o "$tmp/$be") >"$tmp/$be.log" 2>&1
  rc=$?
  [ "$rc" -eq 0 ] || { echo "FAIL - $be build rc=$rc: $(grep -m1 'cannot resolve' "$tmp/$be.log")"; exit 1; }
  "$tmp/$be" >"$tmp/$be.out"
done
cmp -s "$tmp/cranelift.out" "$tmp/llvm.out" || { echo "FAIL - backend outputs differ"; exit 1; }
cmp -s "$tmp/llvm.out" "$fx/expected_output.txt" || { echo "FAIL - output differs from expected"; exit 1; }
echo "PASS - 2 backend(s) built, outputs identical and match expected"
