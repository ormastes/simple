#!/bin/sh
set -eu

# Real entrypoint receipt for checked dynSMF startup. FIFO paths make any
# accidental help/no-op config or raw-APK read block until timeout.
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
case_dir=$(mktemp -d "${TMPDIR:-/tmp}/simple-app-root-dynload.XXXXXX")
trap 'rm -rf "$case_dir"' EXIT HUP INT TERM

config_fifo="$case_dir/config.fifo"
raw_fifo="$case_dir/raw.fifo"
mkfifo "$config_fifo" "$raw_fifo"

run_main() {
    output_path=$1
    app_arg=$2
    shift 2
    set +e
    if [ "$app_arg" = "" ]; then
        timeout 30 env SIMPLE_LIB="$repo_root/src" "$@" \
            "$repo_root/bin/simple" run "$repo_root/src/app/main.spl" \
            >"$output_path" 2>&1
    else
        timeout 30 env SIMPLE_LIB="$repo_root/src" "$@" \
            "$repo_root/bin/simple" run "$repo_root/src/app/main.spl" "$app_arg" \
            >"$output_path" 2>&1
    fi
    command_status=$?
    set -e
}

assert_status() {
    expected=$1
    label=$2
    if [ "$command_status" -ne "$expected" ]; then
        echo "FAIL: $label: expected status $expected, got $command_status" >&2
        tail -20 "$case_dir/$label.out" >&2
        exit 1
    fi
}

assert_contains() {
    path=$1
    pattern=$2
    label=$3
    if ! grep -F "$pattern" "$path" >/dev/null; then
        echo "FAIL: $label: missing '$pattern'" >&2
        tail -20 "$path" >&2
        exit 1
    fi
}

assert_absent() {
    path=$1
    pattern=$2
    label=$3
    if grep -F "$pattern" "$path" >/dev/null; then
        echo "FAIL: $label: unexpected '$pattern'" >&2
        tail -20 "$path" >&2
        exit 1
    fi
}

# No-op and help must return without opening either FIFO.
run_main "$case_dir/noop.out" "" \
    SIMPLE_DYNLOAD_CONFIG="$config_fifo" SIMPLE_ASPECT_PACKS="$raw_fifo"
assert_status 0 noop
assert_absent "$case_dir/noop.out" "dynsmf-trace:" noop
assert_absent "$case_dir/noop.out" "dynload_config" noop

run_main "$case_dir/help.out" --help \
    SIMPLE_DYNLOAD_CONFIG="$config_fifo" SIMPLE_ASPECT_PACKS="$raw_fifo"
assert_status 0 help
assert_contains "$case_dir/help.out" "USAGE:" help
assert_absent "$case_dir/help.out" "dynsmf-trace:" help
assert_absent "$case_dir/help.out" "dynload_config" help

# Checked config failures must fail closed and propagate through main.
missing_config="$case_dir/missing.sdn"
run_main "$case_dir/missing.out" --dynsmf-status SIMPLE_DYNLOAD_CONFIG="$missing_config"
assert_status 1 missing
assert_contains "$case_dir/missing.out" "dynload_config" missing
assert_contains "$case_dir/missing.out" "missing_explicit_dynload_config" missing

mkdir "$case_dir/unreadable.sdn"
run_main "$case_dir/unreadable.out" --dynsmf-status \
    SIMPLE_DYNLOAD_CONFIG="$case_dir/unreadable.sdn"
assert_status 1 unreadable
assert_contains "$case_dir/unreadable.out" "dynload_config" unreadable
assert_contains "$case_dir/unreadable.out" "unreadable_explicit_dynload_config" unreadable

# Trace is opt-in and emitted exactly once by the product entrypoint.
run_main "$case_dir/trace-off.out" --dynsmf-status
assert_status 0 trace-off
assert_absent "$case_dir/trace-off.out" "dynsmf-trace:" trace-off

run_main "$case_dir/trace-on.out" --dynsmf-status SIMPLE_DYNSMF_TRACE=1
assert_status 0 trace-on
trace_count=$(grep -c -F "dynsmf-trace:" "$case_dir/trace-on.out")
if [ "$trace_count" -ne 1 ]; then
    echo "FAIL: trace-on: expected one trace, got $trace_count" >&2
    exit 1
fi

echo "PASS: app-root checked dynload startup entrypoint"
