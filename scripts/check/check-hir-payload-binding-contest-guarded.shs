#!/bin/sh
# check-hir-payload-binding-contest-guarded.shs
#
# Fail-closed guard for the Stage 3 blocker
#   `enum payload dependency <X> resolved to non-type binding <Y> (kind `const`)`
#
# 2026-11 refactor: `claim_materialized_payload_binding` MOVED from
# src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl to
# src/compiler/20.hir/hir_lowering/_Items/module_reexport_materialization.spl
# (struct method, "me" receiver). The `hir_payload_binding_names_agree`
# predicate was replaced by `hir_payload_terminal_identity` triple
# comparison -- the triple (defining_module, name, terminal_kind) is built
# from the FETCHED symbol's own name, so positive name agreement is inherent
# in the identity contest (`if existing != wanted:`). A non-type existing
# symbol no longer silently loses a gated contest: it is the hard error this
# guard historically protected against becoming mis-reported, now with a
# SIMPLE_HIR_PAYLOAD_LOOKUP_TRACE=1 probe to separate resolver defects from
# native-codegen Dict bracket-read defects. The register_imported_type_methods
# re-entrancy breaker (list-based, has failed open as a Dict) moved with it.
#
# This guard fails if the identity contest can fire without name agreement,
# if a non-type binding silently contests, or if the re-entrancy breaker's
# list-based shape is lost.
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> ... checked                       exit 0
#   FAIL  — ...                                   exit 1
#   ERROR — nothing was checked                   exit 2
# A run that checked 0 things is ERROR, never a pass.
#
# --selftest is fatal and runs before every scan.
#
# See doc/08_tracking/bug/stage3_register_imported_type_methods_infinite_recursion_2026-08-17.md

set -u

REPO_ROOT=${REPO_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}
TARGET_REL="src/compiler/20.hir/hir_lowering/_Items/module_reexport_materialization.spl"

# scan_file <path>
# Prints one finding per line to stdout; sets nothing else.
# Returns 0 if the file was scanned, 1 if it could not be scanned.
scan_file() {
    _f=$1
    [ -f "$_f" ] || return 1

    # 1. The claim method must exist (post-2026-11: struct method in
    #    module_reexport_materialization.spl).
    if ! grep -q 'me claim_materialized_payload_binding(' "$_f"; then
        echo "missing claim method claim_materialized_payload_binding"
    fi

    # 2. The wanted identity must be the full origin triple.
    if ! grep -q 'val wanted = hir_payload_terminal_identity(origin.module_name, origin.item_name, origin.item_kind)' "$_f"; then
        echo "wanted identity not derived from origin triple"
    fi

    # 3. Name-agreement successor: the existing identity must be built from
    #    the FETCHED symbol's own name (positive name agreement is what makes
    #    the identity contest sound).
    if ! grep -q 'hir_payload_terminal_identity(existing_owner, symbol.name, existing_kind)' "$_f"; then
        echo "name agreement dropped from existing identity"
    fi

    # 4. The identity contest itself must be present.
    if ! grep -q 'if existing != wanted:' "$_f"; then
        echo "identity contest missing"
    fi

    # 5. A non-type existing symbol must hard-error with the Stage 3 blocker
    #    message (optionally trace-probed), never silently contest or win.
    if ! grep -q 'resolved to non-type binding' "$_f"; then
        echo "non-type binding does not hard-error (silent contest)"
    fi

    # 6. The kind predicate must stay a positive enumeration, never the
    #    emptiness test that never fired (513cbb7b4).
    if grep -q 'if existing_kind == "":' "$_f"; then
        echo "emptiness test 'existing_kind == \"\"' reintroduced (never fires)"
    fi

    # 7. The re-entrancy breaker for the SIGSEGV must stay, and stay a list.
    if ! grep -q 'if self.imported_type_methods_in_progress_has(reentry_key):' "$_f"; then
        echo "register_imported_type_methods re-entrancy breaker removed"
    fi
    if grep -q 'imported_type_methods_in_progress: {text' "$_f"; then
        echo "re-entrancy breaker converted to a Dict (has failed open before)"
    fi

    return 0
}

CHECKS_PER_FILE=7

selftest() {
    _tmp=$(mktemp -d) || { echo "ERROR — nothing was checked"; exit 2; }
    _fail=0
    _n=0

    # Fixture A: the APPLIED arm (post-2026-11 shape) — must produce zero findings.
    cat > "$_tmp/applied.spl" <<'EOF'
    me claim_materialized_payload_binding(local_name: text, origin: HirMaterializedPayloadOrigin, import_span: Span) -> bool:
        val wanted = hir_payload_terminal_identity(origin.module_name, origin.item_name, origin.item_kind)
            val existing = hir_payload_terminal_identity(existing_owner, symbol.name, existing_kind)
                if existing != wanted:
                    return false
                if not hir_payload_kind_is_type(existing_kind):
                    self.error("enum payload dependency `{local_name}` resolved to non-type binding `{symbol.name}` (kind `{existing_kind}`) in `{existing_owner}`; expected the type `{wanted}`", import_span)
                    return false
        if self.imported_type_methods_in_progress_has(reentry_key):
            return
EOF
    _out=$(scan_file "$_tmp/applied.spl"); _rc=$?
    _n=$((_n + 1))
    if [ "$_rc" -ne 0 ] || [ -n "$_out" ]; then
        echo "selftest: applied fixture should be clean, got: $_out"
        _fail=1
    fi

    # Fixture B: the REVERTED arm (non-type silently contests) — MUST fail.
    cat > "$_tmp/reverted.spl" <<'EOF'
    me claim_materialized_payload_binding(local_name: text, origin: HirMaterializedPayloadOrigin, import_span: Span) -> bool:
        val wanted = hir_payload_terminal_identity(origin.module_name, origin.item_name, origin.item_kind)
            val existing = hir_payload_terminal_identity(existing_owner, symbol.name, existing_kind)
                if existing != wanted:
                    return false
                if not hir_payload_kind_is_type(existing_kind):
                    return false
        if self.imported_type_methods_in_progress_has(reentry_key):
            return
EOF
    _out=$(scan_file "$_tmp/reverted.spl"); _rc=$?
    _n=$((_n + 1))
    if [ "$_rc" -ne 0 ] || [ -z "$_out" ]; then
        echo "selftest: reverted fixture must produce findings (control failed to fail)"
        _fail=1
    else
        case "$_out" in
            *"non-type binding does not hard-error"*) : ;;
            *) echo "selftest: reverted fixture findings did not name the silent contest: $_out"; _fail=1 ;;
        esac
    fi

    # Fixture C: breaker removed — must be caught.
    cat > "$_tmp/nobreaker.spl" <<'EOF'
    me claim_materialized_payload_binding(local_name: text, origin: HirMaterializedPayloadOrigin, import_span: Span) -> bool:
        val wanted = hir_payload_terminal_identity(origin.module_name, origin.item_name, origin.item_kind)
            val existing = hir_payload_terminal_identity(existing_owner, symbol.name, existing_kind)
                if existing != wanted:
                    return false
                if not hir_payload_kind_is_type(existing_kind):
                    self.error("enum payload dependency `{local_name}` resolved to non-type binding `{symbol.name}` (kind `{existing_kind}`) in `{existing_owner}`; expected the type `{wanted}`", import_span)
                    return false
EOF
    _out=$(scan_file "$_tmp/nobreaker.spl"); _n=$((_n + 1))
    case "$_out" in
        *"re-entrancy breaker removed"*) : ;;
        *) echo "selftest: removed breaker was not detected"; _fail=1 ;;
    esac

    # Fixture D: Dict-based breaker — must be caught.
    cat > "$_tmp/dictbreaker.spl" <<'EOF'
    me claim_materialized_payload_binding(local_name: text, origin: HirMaterializedPayloadOrigin, import_span: Span) -> bool:
        val wanted = hir_payload_terminal_identity(origin.module_name, origin.item_name, origin.item_kind)
            val existing = hir_payload_terminal_identity(existing_owner, symbol.name, existing_kind)
                if existing != wanted:
                    return false
                if not hir_payload_kind_is_type(existing_kind):
                    self.error("enum payload dependency `{local_name}` resolved to non-type binding `{symbol.name}` (kind `{existing_kind}`) in `{existing_owner}`; expected the type `{wanted}`", import_span)
                    return false
        if self.imported_type_methods_in_progress_has(reentry_key):
            return
        imported_type_methods_in_progress: {text: bool}
EOF
    _out=$(scan_file "$_tmp/dictbreaker.spl"); _n=$((_n + 1))
    case "$_out" in
        *"converted to a Dict"*) : ;;
        *) echo "selftest: Dict breaker was not detected"; _fail=1 ;;
    esac

    # Fixture E: a missing file must be UNSCANNABLE, never a silent clean pass.
    scan_file "$_tmp/does-not-exist.spl" >/dev/null 2>&1; _rc=$?
    _n=$((_n + 1))
    if [ "$_rc" -eq 0 ]; then
        echo "selftest: missing file reported as scanned (fail-open)"
        _fail=1
    fi

    rm -rf "$_tmp"
    if [ "$_n" -eq 0 ]; then
        echo "selftest: 0 fixtures ran"
        return 2
    fi
    return "$_fail"
}

# --- main -------------------------------------------------------------------

MODE=scan
case "${1:-}" in
    --selftest) MODE=selftest ;;
    "") : ;;
    *) echo "usage: $0 [--selftest]"; echo "ERROR — nothing was checked"; exit 2 ;;
esac

selftest_out=$(selftest); selftest_rc=$?
if [ "$selftest_rc" -ne 0 ]; then
    printf '%s\n' "$selftest_out"
    echo "FAIL — selftest failed (5 fixtures); guard is not trustworthy"
    exit 1
fi

if [ "$MODE" = selftest ]; then
    echo "PASS — 5 selftest fixture(s) checked, guard behaves as specified"
    exit 0
fi

TARGET="$REPO_ROOT/$TARGET_REL"
findings=$(scan_file "$TARGET"); scan_rc=$?
if [ "$scan_rc" -ne 0 ]; then
    echo "could not read $TARGET_REL under REPO_ROOT=$REPO_ROOT"
    echo "ERROR — nothing was checked"
    exit 2
fi

checked=$CHECKS_PER_FILE
if [ "$checked" -le 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi

if [ -n "$findings" ]; then
    printf '%s\n' "$findings"
    count=$(printf '%s\n' "$findings" | grep -c .)
    echo "FAIL — $checked invariant(s) checked in $TARGET_REL, $count violated"
    exit 1
fi

echo "PASS — $checked invariant(s) checked in $TARGET_REL, 0 violated"
exit 0
