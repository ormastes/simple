#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
selfcheck="$root/src/runtime/test/rt_file_exists_probe_selfcheck.c"
cc=${CC:-cc}

for provider in runtime.c runtime_native.c; do
    out=$(mktemp "${TMPDIR:-/tmp}/simple-file-exists-probe.XXXXXX")
    trap 'rm -f "$out"' EXIT INT TERM HUP
    "$cc" -std=gnu11 -O0 -ffunction-sections -fdata-sections \
        -DSIMPLE_RUNTIME_TESTING -I"$root/src/runtime" \
        "$root/src/runtime/$provider" "$selfcheck" \
        -Wl,--gc-sections -ldl -lm -o "$out"
    "$out"
    rm -f "$out"
    trap - EXIT INT TERM HUP
done

echo "file-exists-probe-c: runtime.c and runtime_native.c passed lifecycle, stale-token, and overflow selfchecks"
