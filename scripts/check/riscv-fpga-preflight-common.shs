#!/bin/sh

preflight_nonzero_luts() {
    report="$1"
    [ -s "$report" ] || return 1
    awk -F '|' '
      /CLB LUTs/ {
        value = $3
        gsub(/[^0-9]/, "", value)
        if (value != "" && value + 0 > 0) found = 1
      }
      END { exit(found ? 0 : 1) }
    ' "$report"
}

preflight_has_legacy_physical_evidence() {
    grep -Eiq 'ILA_CAPTURE_STATUS|ENABLE_UART_ILA|uart[_ -]?ila|rtl[ _-]?preload|preloaded|rv(32|64)_payload\.mem|vivado-ila|GHDL_EVIDENCE_STATUS|Invalid context' "$1"
}

preflight_ordered_terminal() {
    log="$1"
    fixture="$2"
    [ -s "$log" ] || return 1
    awk -v fixture="$fixture" '
      state == 0 && /login:/ { state = 1; next }
      state == 1 && /UART_TX_INPUT=root/ { state = 2; next }
      state == 2 && /simple-riscv#[[:space:]]/ { state = 3; next }
      state == 3 && /UART_TX_INPUT=ls \// { state = 4; next }
      state == 4 && index($0, fixture) { state = 5 }
      END { exit(state == 5 ? 0 : 1) }
    ' "$log"
}

if [ "${0##*/}" = "riscv-fpga-preflight-common.shs" ] &&
    [ "${1:-}" = "--self-test" ]; then
    test_dir="$(mktemp -d)"
    trap 'rm -rf "$test_dir"' EXIT HUP INT TERM
    printf '| CLB LUTs | 1,234 |\n' >"$test_dir/util_ok"
    printf '| CLB LUTs | 0 |\n' >"$test_dir/util_zero"
    cat >"$test_dir/terminal_ok" <<'EOF'
login:
UART_TX_INPUT=root
simple-riscv# 
UART_TX_INPUT=ls /
SIMPLE_RISCV_LINUX_LOGIN_LS_PASS
EOF
    cat >"$test_dir/terminal_bad" <<'EOF'
login:
SIMPLE_RISCV_LINUX_LOGIN_LS_PASS
UART_TX_INPUT=root
simple-riscv# 
UART_TX_INPUT=ls /
EOF
    cp "$test_dir/terminal_ok" "$test_dir/legacy"
    printf 'ILA_CAPTURE_STATUS=PASS\n' >>"$test_dir/legacy"
    preflight_nonzero_luts "$test_dir/util_ok"
    ! preflight_nonzero_luts "$test_dir/util_zero"
    preflight_ordered_terminal "$test_dir/terminal_ok" SIMPLE_RISCV_LINUX_LOGIN_LS_PASS
    ! preflight_ordered_terminal "$test_dir/terminal_bad" SIMPLE_RISCV_LINUX_LOGIN_LS_PASS
    preflight_has_legacy_physical_evidence "$test_dir/legacy"
    printf 'RISCV_FPGA_PREFLIGHT_COMMON_SELF_TEST: PASS\n'
fi
