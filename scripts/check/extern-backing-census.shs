#!/bin/sh
# Reproduce the unbacked-extern census (report only; never gates).
#
# Classifies every distinct `extern`-declared symbol in owned .spl source by
# whether anything actually backs it AT RUNTIME, rather than by whether its
# name appears somewhere in C/Rust text. That distinction matters: the older
# scripts/check/check-extern-registration.shs scores a symbol "registered" if
# `sym(` appears anywhere in any .c/.h/.rs file, so every CALL SITE counts as
# evidence of a DEFINITION and the unbacked count comes out far too low.
#
# Backed tiers, in priority order:
#   bare_exempt             @extern("bare", ...) — freestanding, host-unresolvable by design
#   in_deployed_binary      defined symbol in the deployed `simple` (nm --defined-only)
#   libc_libm               defined in libc/libm/libgcc_s, i.e. resolvable by dlsym
#   interp_extern_registry  a string literal in interpreter_extern/**.rs (name-dispatched)
# Candidate-unbacked sub-classes:
#   c_runtime_source_only     defined in owned src/runtime or src/os C/C++ but absent from the seed binary
#   rust_source_feature_gated `pub extern "C" fn` in src/compiler_rust but absent from the binary
#   external_library_symbol   SDL_/gl/cu/vk/... — resolved from a dlopen'd library, if present
#   SHADOWED_BY_SPL_FN        a pure-Simple `fn` of the same name exists somewhere
#   DEAD_DECLARATION          zero call sites in the declaring module's own directory
#   GENUINELY_MISSING         live call sites in the declaring module, no backing found
#
# Call sites are counted MODULE-SCOPED (declaring file's directory), not
# tree-wide: Simple resolution is module-scoped, so a tree-wide count credits
# `env_get`/`json_parse`/`path_join`-style name collisions with thousands of
# calls that never reach the extern. Tree-wide scoring inflated
# GENUINELY_MISSING from 1,203 to 1,320 in exactly that way.
#
# Usage: sh scripts/check/extern-backing-census.shs [output.tsv]
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "${root}"
OUT="${1:-/dev/stdout}"
if [ -n "${SIMPLE_BIN:-}" ]; then
  BIN=$SIMPLE_BIN
elif [ -x "${root}/bin/release/x86_64-unknown-linux-gnu/simple" ]; then
  BIN=${root}/bin/release/x86_64-unknown-linux-gnu/simple
else
  BIN=${root}/bin/simple
fi
W=$(mktemp -d); trap 'rm -rf "$W"' EXIT INT TERM

grep -rnE --include='*.spl' --exclude-dir=vendor \
  '@extern|^[[:space:]]*(pub[[:space:]]+)?extern[[:space:]]+fn[[:space:]]' src test 2>/dev/null \
| perl -ne 'chomp; next unless /^([^:]+):(\d+):(.*)$/; my($f,$l,$t)=($1,$2,$3); next if $t=~/^\s*#/;
  my($abi,$sym)=("host","");
  if($t=~/\@extern\(\s*"([^"]+)"\s*,\s*"([^"]+)"\s*\)/){$abi=$1;$sym=$2;}
  elsif($t=~/\@extern\(\s*"([^"]+)"\s*\)/){$sym=$1;}
  elsif($t=~/\@extern\s+fn\s+([A-Za-z_]\w*)/){$sym=$1;}
  elsif($t=~/^\s*(?:pub\s+)?extern\s+fn\s+([A-Za-z_]\w*)/){$sym=$1;}
  print "$abi\t$sym\t$f:$l\n" if $sym ne "";' | sort -u > "$W/decls.tsv"

n=$(wc -l < "$W/decls.tsv" | tr -d ' ')
if [ "$n" -lt 5000 ]; then
  echo "ERROR — nothing was checked: only $n declarations found; the extractor is broken." >&2
  exit 2
fi
[ -x "$BIN" ] || { echo "ERROR — nothing was checked: no binary at $BIN" >&2; exit 2; }

cut -f2 "$W/decls.tsv" | sort -u > "$W/syms.txt"
awk -F'\t' '$1=="bare"{print $2}' "$W/decls.tsv" | sort -u > "$W/bare.txt"
nm -a --defined-only "$BIN" 2>/dev/null | awk '{print $NF}' | sort -u > "$W/bin.txt"
# NON-VACUITY: `in_deployed_binary` is the census's PRIMARY evidence that a
# declared extern is backed. If the binary carries no symbol table, every
# lookup misses and the census silently reclassifies the whole tree as
# unbacked -- a scan that found nothing because it scanned nothing.
#
# Measured 2026-09-02 on Windows/MSYS: `nm -a --defined-only bin/simple.exe`
# answers "no symbols" (the deployed .exe is stripped), so bin.txt was EMPTY
# and check-unbacked-extern-ratchet.shs reported "FAIL — 1603 symbol(s)
# checked, 255 newly unbacked" naming symbols such as __rt_vec_push that are
# demonstrably present. That is a false RED produced by absent evidence.
# Absence of a symbol table is absence of evidence, never a finding.
#
# Cross-platform impact: none. An unstripped ELF or Mach-O `simple` defines
# tens of thousands of symbols, so this floor is unreachable on Linux and
# macOS; it fires only where the census had no evidence to begin with.
BIN_SYMS=$(wc -l < "$W/bin.txt" | tr -d ' ')
BIN_SYM_FLOOR=${EXTERN_CENSUS_BIN_SYM_FLOOR:-100}
if [ "$BIN_SYMS" -lt "$BIN_SYM_FLOOR" ]; then
  echo "ERROR — nothing was checked: $BIN yielded $BIN_SYMS defined symbol(s) (floor $BIN_SYM_FLOOR); it is stripped or not a readable object for this nm. Backing classification would be vacuous." >&2
  exit 2
fi
for L in libc.so.6 libm.so.6 libgcc_s.so.1 libpthread.so.0 libdl.so.2; do
  [ -e "/lib/x86_64-linux-gnu/$L" ] && nm -D --defined-only "/lib/x86_64-linux-gnu/$L" 2>/dev/null | awk 'NF>=3{print $3}' | sed 's/@.*//'
done | sort -u > "$W/libc.txt"
grep -rhoE '"[A-Za-z_][A-Za-z0-9_]{2,}"' src/compiler_rust/compiler/src/interpreter_extern/ --include=*.rs \
  | tr -d '"' | sort -u > "$W/interp.txt"
find src/runtime src/os -name '*.c' | grep -v '/vendor/' > "$W/c-source-files.txt"
find src/runtime src/os \( -name '*.cc' -o -name '*.cpp' -o -name '*.cxx' \) \
  | grep -v '/vendor/' > "$W/cxx-source-files.txt"
find src/runtime src/os \( -name '*.h' -o -name '*.hh' -o -name '*.hpp' \) \
  | grep -v '/vendor/' | grep -vE 'miniaudio.h|stb_image.h|stb_truetype.h' \
  > "$W/c-header-files.txt"
extract_native_definitions() {
  files=$1
  output=$2
  if [ -s "$files" ]; then
    xargs -a "$files" grep -hoE '^[A-Za-z_][A-Za-z0-9_ \*]*[ \*]([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*\([^;]*$' 2>/dev/null \
      | grep -oE '[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(' | tr -d ' (' | sort -u > "$output"
  else
    : > "$output"
  fi
}
extract_native_definitions "$W/c-source-files.txt" "$W/cdefs.txt"
extract_native_definitions "$W/cxx-source-files.txt" "$W/cxxdefs.txt"
extract_native_definitions "$W/c-header-files.txt" "$W/cheaderdefs.txt"
grep -rhoE '(pub[[:space:]]+(unsafe[[:space:]]+)?extern[[:space:]]+"C"[[:space:]]+fn|#\[no_mangle\][[:space:]]*pub[[:space:]]+fn)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*' \
  src/compiler_rust --include=*.rs 2>/dev/null | awk '{print $NF}' | sort -u > "$W/rsdefs.txt"
grep -rhoE '^[[:space:]]*(pub[[:space:]]+)?fn[[:space:]]+[A-Za-z_][A-Za-z0-9_]*' --include='*.spl' \
  --exclude-dir=vendor src test 2>/dev/null | awk '{print $NF}' | sort -u > "$W/splfns.txt"
# Scan every Simple source once. GNU grep's `-Ff` matcher becomes extremely
# slow with the several-thousand-symbol extern set (observed at >1 hour),
# because this report asks it to retain line/filename detail for every match.
# Loading the exact symbol set into a hash keeps this O(source bytes + hits),
# while preserving the same `file:line:symbol(` interchange below.
export EXTERN_CENSUS_SYMBOLS="$W/syms.txt"
find src test -type f -name '*.spl' ! -path '*/vendor/*' -print0 |
xargs -0 -r -n 200 perl -ne '
  BEGIN {
    open my $fh, "<", $ENV{EXTERN_CENSUS_SYMBOLS} or die $!;
    while (my $symbol = <$fh>) {
      chomp $symbol;
      $wanted{$symbol}=1 if $symbol ne "";
    }
  }
  while (/\b([A-Za-z_]\w*)\s*\(/g) {
    print "$ARGV:$.:$1(\n" if $wanted{$1};
  }
  close ARGV if eof;
' > "$W/occ.txt"

W="$W" OUT="$OUT" python3 - <<'PY'
import os,collections
W=os.environ["W"]; OUT=os.environ["OUT"]
S=lambda f:set(open(f"{W}/{f}").read().split())
syms=[l.strip() for l in open(f"{W}/syms.txt") if l.strip()]; sset=set(syms)
declfiles=collections.defaultdict(set); decllines=collections.defaultdict(set)
for L in open(f"{W}/decls.tsv"):
    a=L.rstrip("\n").split("\t")
    if len(a)<3: continue
    f,ln=a[2].rsplit(":",1); declfiles[a[1]].add(f); decllines[a[1]].add((f,ln))
occ=collections.defaultdict(list)
for L in open(f"{W}/occ.txt"):
    try: f,ln,m=L.rstrip("\n").split(":",2)
    except ValueError: continue
    s=m.rstrip("(")
    if s in sset: occ[s].append((f,ln))
bare,binf,libc,interp=S("bare.txt"),S("bin.txt"),S("libc.txt"),S("interp.txt")
cdefs,cxxdefs,cheaderdefs=S("cdefs.txt"),S("cxxdefs.txt"),S("cheaderdefs.txt")
rsdefs,splfns=S("rsdefs.txt"),S("splfns.txt")
EXT=("SDL_","SDL3_","sqlite3_","gl","cu","nv","cl","Vk","vk","av","Py_","ma_","stbi_","curl_","SSL_","EVP_","BIO_","X509_","LLVM")
rows=[];c=collections.Counter()
for s in syms:
    dfs=declfiles[s]; dirs={os.path.dirname(f) for f in dfs}
    n=len([1 for (f,l) in occ[s] if (f,l) not in decllines[s] and (f in dfs or os.path.dirname(f) in dirs)])
    if   s in bare:   k="bare_exempt"
    elif s in binf:   k="in_deployed_binary"
    elif s in libc:   k="libc_libm"
    elif s in interp: k="interp_extern_registry"
    elif s in cdefs or s in cxxdefs or s in cheaderdefs: k="c_runtime_source_only"
    elif s in rsdefs: k="rust_source_feature_gated"
    elif s.startswith(EXT): k="external_library_symbol"
    elif n==0:        k="DEAD_DECLARATION"
    elif s in splfns: k="SHADOWED_BY_SPL_FN"
    else:             k="GENUINELY_MISSING"
    languages=[]
    if s in cdefs: languages.append("c")
    if s in cxxdefs: languages.append("cxx")
    if s in cheaderdefs: languages.append("c_or_cxx_header")
    if s in rsdefs: languages.append("rust_export")
    if s in interp: languages.append("rust_interpreter")
    if s in libc: languages.append("system_c")
    if s.startswith(EXT): languages.append("external_c_abi")
    if s in bare: languages.append("freestanding")
    if s in binf and not languages: languages.append("linked_native_unknown")
    if not languages: languages.append("none_observed")
    c[k]+=1; rows.append((s,k,n,sorted(dfs)[0] if dfs else "",",".join(languages)))
with open(OUT,"w") as fh:
    fh.write("symbol\tclass\tscoped_callsites\tfirst_declaring_file\tsource_languages\n")
    for r in sorted(rows,key=lambda t:(t[1],-t[2],t[0])): fh.write("\t".join(map(str,r))+"\n")
import sys
for k,v in c.most_common(): print(f"{v:6d}  {k}", file=sys.stderr)
print(f"{len(syms):6d}  TOTAL distinct extern symbols", file=sys.stderr)
PY
