#!/bin/sh
# Build and run the exact Engine2D MSL -> Metal library path without a window.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)"
cd "$ROOT_DIR"
ADMISSION_HELPER=\
"$ROOT_DIR/scripts/check/lib/macos-gpu-trusted-build-admission.shs"
[ -f "$ADMISSION_HELPER" ] || {
    echo "macOS Metal MSL diagnostic: FAIL (manifest-admission-helper-missing)" >&2
    exit 1
}
. "$ADMISSION_HELPER"

BUILD_DIR="${METAL_MSL_DIAGNOSTIC_BUILD_DIR:-$ROOT_DIR/build/macos_metal_msl_library_micro_diagnostic}"
ENTRY="test/02_integration/rendering/macos_metal_msl_library_micro_diagnostic.spl"
OUTPUT="$BUILD_DIR/macos_metal_msl_library_micro_diagnostic"
PROBE_STDOUT="$BUILD_DIR/probe.stdout"
PROBE_STDERR="$BUILD_DIR/probe.stderr"
BUILD_STDOUT="$BUILD_DIR/native-build.stdout"
BUILD_STDERR="$BUILD_DIR/native-build.stderr"
EVIDENCE="$BUILD_DIR/evidence.env"
TRUSTED_MANIFEST="$ROOT_DIR/build/macos_gpu_2d_live_native/metal/trusted-build.env"
PROCESS_TIMEOUT_SECS="${METAL_MSL_DIAGNOSTIC_TIMEOUT_SECS:-240}"
PROCESS_TERM_GRACE_SECS="${METAL_MSL_DIAGNOSTIC_TERM_GRACE_SECS:-10}"
STREAM_HEAD_BYTES=4096
STREAM_TAIL_BYTES=4096
STREAM_MAX_BYTES=8256
BUILD_EXIT=""
PROBE_EXIT=""

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        return 1
    fi
}

file_bytes() {
    if [ -f "$1" ]; then wc -c <"$1" | tr -d '[:space:]'; else echo 0; fi
}

positive_integer() {
    case "${1:-}" in
        ""|0|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

nonnegative_integer() {
    case "${1:-}" in
        ""|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

manifest_value() {
    key="$1"
    file="$2"
    count="$(grep -c "^${key}=" "$file" || true)"
    [ "$count" = 1 ] || return 1
    sed -n "s/^${key}=//p" "$file"
}

verify_trusted_manifest() {
    macos_gpu_trusted_manifest_admit \
        "$TRUSTED_MANIFEST" metal "$ROOT_DIR" || return 1
    COMPILER="$MACOS_GPU_ADMISSION_COMPILER"
    PROVIDER="$MACOS_GPU_ADMISSION_PROVIDER"
    RUNTIME_C_PROVIDER="$MACOS_GPU_ADMISSION_RUNTIME_C_PROVIDER"
    COMPILER_IDENTITY="$MACOS_GPU_ADMISSION_COMPILER_IDENTITY"
    COMPILER_SOURCE_KIND="$MACOS_GPU_ADMISSION_COMPILER_SOURCE_KIND"
    MANIFEST_REPO_REVISION="$MACOS_GPU_ADMISSION_REPO_REVISION"
    MANIFEST_SOURCE_INPUT_FINGERPRINT=\
"$MACOS_GPU_ADMISSION_SOURCE_INPUT_FINGERPRINT"
}

bounded_stream() {
    perl -e '
        my ($head_max, $tail_max) = @ARGV;
        my ($head, $tail, $full, $total) = ("", "", "", 0);
        while (1) {
            my $read = read(STDIN, my $chunk, 4096);
            last if !defined($read) || $read == 0;
            $total += $read;
            if (length($head) < $head_max) {
                my $take = $head_max - length($head);
                $take = $read if $take > $read;
                $head .= substr($chunk, 0, $take);
            }
            if (length($full) < $head_max + $tail_max) {
                my $take = $head_max + $tail_max - length($full);
                $take = $read if $take > $read;
                $full .= substr($chunk, 0, $take);
            }
            $tail .= $chunk;
            if (length($tail) > $tail_max) {
                substr($tail, 0, length($tail) - $tail_max, "");
            }
        }
        if ($total <= $head_max + $tail_max) {
            print $full;
        } else {
            print $head;
            print "\n--- omitted ", $total - $head_max - $tail_max,
                " process bytes ---\n";
            print $tail;
        }
    ' "$STREAM_HEAD_BYTES" "$STREAM_TAIL_BYTES"
}

# Shared bounded process facade for both native compilation and probe launch.
# Each child becomes its own session/process-group leader. This means a timeout
# terminates compiler/probe descendants as well as the immediate process, and
# the FIFO readers are independently bounded if a hostile child keeps a writer
# open after the group has been terminated.
pid_running() {
    kill -0 "$1" 2>/dev/null
}

wait_for_pid_until() {
    pid="$1"
    deadline="$2"
    while pid_running "$pid"; do
        [ "$(date +%s)" -lt "$deadline" ] || return 1
        sleep 1
    done
    return 0
}

group_running() {
    /bin/kill -0 "-$1" 2>/dev/null
}

terminate_process_group() {
    group_leader="$1"
    grace_secs="$2"
    /bin/kill -TERM "-$group_leader" 2>/dev/null || true
    group_deadline=$(($(date +%s) + grace_secs))
    while group_running "$group_leader"; do
        if [ "$(date +%s)" -ge "$group_deadline" ]; then
            /bin/kill -KILL "-$group_leader" 2>/dev/null || true
            break
        fi
        sleep 1
    done
}

terminate_filter() {
    filter_pid="$1"
    grace_secs="$2"
    /bin/kill -TERM "$filter_pid" 2>/dev/null || true
    filter_deadline=$(($(date +%s) + grace_secs))
    if ! wait_for_pid_until "$filter_pid" "$filter_deadline"; then
        /bin/kill -KILL "$filter_pid" 2>/dev/null || true
    fi
}

run_bounded_process() {
    stdout_path="$1"
    stderr_path="$2"
    timeout_secs="$3"
    grace_secs="$4"
    shift 4

    positive_integer "$timeout_secs" || return 125
    positive_integer "$grace_secs" || return 125
    stdout_fifo="$BUILD_DIR/stdout.fifo.$$"
    stderr_fifo="$BUILD_DIR/stderr.fifo.$$"
    rm -f "$stdout_fifo" "$stderr_fifo"
    mkfifo "$stdout_fifo" "$stderr_fifo"
    bounded_stream <"$stdout_fifo" >"$stdout_path" &
    stdout_filter_pid=$!
    bounded_stream <"$stderr_fifo" >"$stderr_path" &
    stderr_filter_pid=$!

    # `setsid` is called before exec so $! remains both target PID and process
    # group ID. Do not put this in a command substitution: the caller must own
    # the child in order to wait for its exact exit status.
    perl -MPOSIX=setsid -e 'setsid() >= 0 or die "setsid: $!\n"; exec @ARGV or die "exec: $!\n"' \
        "$@" >"$stdout_fifo" 2>"$stderr_fifo" &
    target_pid=$!
    deadline=$(($(date +%s) + timeout_secs))
    timed_out=0
    while pid_running "$target_pid"; do
        if [ "$(date +%s)" -ge "$deadline" ]; then
            timed_out=1
            terminate_process_group "$target_pid" "$grace_secs"
            break
        fi
        sleep 1
    done

    set +e
    wait "$target_pid"
    process_status=$?
    drain_deadline=$(($(date +%s) + grace_secs))
    drain_failed=0
    if ! wait_for_pid_until "$stdout_filter_pid" "$drain_deadline"; then
        drain_failed=1
    fi
    if ! wait_for_pid_until "$stderr_filter_pid" "$drain_deadline"; then
        drain_failed=1
    fi
    # A detached descendant can keep a FIFO open even after the direct target
    # exits. Terminate the original group before forcing either reader down.
    if [ "$drain_failed" = 1 ]; then
        terminate_process_group "$target_pid" "$grace_secs"
        terminate_filter "$stdout_filter_pid" "$grace_secs"
        terminate_filter "$stderr_filter_pid" "$grace_secs"
    fi
    wait "$stdout_filter_pid"
    stdout_status=$?
    wait "$stderr_filter_pid"
    stderr_status=$?
    set -e
    rm -f "$stdout_fifo" "$stderr_fifo"

    [ "$drain_failed" = 0 ] || return 125
    [ "$stdout_status" = 0 ] && [ "$stderr_status" = 0 ] || return 125
    [ "$(file_bytes "$stdout_path")" -le "$STREAM_MAX_BYTES" ] || return 125
    [ "$(file_bytes "$stderr_path")" -le "$STREAM_MAX_BYTES" ] || return 125
    if [ "$timed_out" = 1 ]; then
        return 124
    fi
    return "$process_status"
}

write_evidence() {
    status="$1"
    reason="$2"
    mkdir -p "$BUILD_DIR"
    {
        echo "metal_msl_library_diagnostic_wrapper_status=$status"
        echo "metal_msl_library_diagnostic_wrapper_reason=$reason"
        echo "metal_msl_library_diagnostic_repo_revision=$(git rev-parse HEAD)"
        echo "metal_msl_library_diagnostic_entry=$ENTRY"
        echo "metal_msl_library_diagnostic_entry_sha256=$(if [ -f "$ENTRY" ]; then sha256_file "$ENTRY"; fi)"
        echo "metal_msl_library_diagnostic_trusted_manifest=$TRUSTED_MANIFEST"
        echo "metal_msl_library_diagnostic_trusted_manifest_sha256=$(if [ -f "$TRUSTED_MANIFEST" ]; then sha256_file "$TRUSTED_MANIFEST"; fi)"
        echo "metal_msl_library_diagnostic_compiler=${COMPILER:-}"
        echo "metal_msl_library_diagnostic_compiler_sha256=$(if [ -f "${COMPILER:-}" ]; then sha256_file "$COMPILER"; fi)"
        echo "metal_msl_library_diagnostic_compiler_identity=${COMPILER_IDENTITY:-}"
        echo "metal_msl_library_diagnostic_compiler_source_kind=${COMPILER_SOURCE_KIND:-}"
        echo "metal_msl_library_diagnostic_manifest_repo_revision=${MANIFEST_REPO_REVISION:-}"
        echo "metal_msl_library_diagnostic_manifest_source_input_fingerprint=${MANIFEST_SOURCE_INPUT_FINGERPRINT:-}"
        echo "metal_msl_library_diagnostic_provider=${PROVIDER:-}"
        echo "metal_msl_library_diagnostic_provider_sha256=$(if [ -f "${PROVIDER:-}" ]; then sha256_file "$PROVIDER"; fi)"
        echo "metal_msl_library_diagnostic_runtime_c_provider=${RUNTIME_C_PROVIDER:-}"
        echo "metal_msl_library_diagnostic_runtime_c_provider_sha256=$(if [ -f "${RUNTIME_C_PROVIDER:-}" ]; then sha256_file "$RUNTIME_C_PROVIDER"; fi)"
        echo "metal_msl_library_diagnostic_native_build_exit=${BUILD_EXIT:-}"
        echo "metal_msl_library_diagnostic_probe_exit=${PROBE_EXIT:-}"
        echo "metal_msl_library_diagnostic_stream_max_bytes=$STREAM_MAX_BYTES"
        for stream in "$BUILD_STDOUT" "$BUILD_STDERR" "$PROBE_STDOUT" "$PROBE_STDERR"; do
            stream_key="$(basename -- "$stream" | tr '.-' '__')"
            echo "metal_msl_library_diagnostic_${stream_key}_path=$stream"
            echo "metal_msl_library_diagnostic_${stream_key}_bytes=$(file_bytes "$stream")"
            echo "metal_msl_library_diagnostic_${stream_key}_sha256=$(if [ -f "$stream" ]; then sha256_file "$stream"; fi)"
        done
    } >"$EVIDENCE"
}

fail() {
    reason="$1"
    write_evidence fail "$reason"
    cat "$EVIDENCE"
    exit 1
}

probe_output_schema_valid() {
    [ "$(file_bytes "$PROBE_STDOUT")" -le "$STREAM_MAX_BYTES" ] || return 1
    grep -Fxq "metal_msl_library_probe_schema=macos-metal-msl-library-micro-v1" "$PROBE_STDOUT" || return 1
    for field in \
        status reason source_sha256 source_bytes is_available init device_count \
        device_create_status compiler_status library_create_status error_abi \
        error_raw_bytes error_bounded_bytes error_truncated error library_destroyed \
        device_destroyed cpu_fallback window_system; do
        grep -Eq "^metal_msl_library_probe_${field}=.*$" "$PROBE_STDOUT" || return 1
    done
    grep -Eq '^metal_msl_library_probe_source_sha256=[0-9a-f]{64}$' "$PROBE_STDOUT" || return 1
    grep -Fxq "metal_msl_library_probe_error_abi=typed-cstring-to-text" "$PROBE_STDOUT" || return 1
    error_raw_bytes="$(manifest_value metal_msl_library_probe_error_raw_bytes "$PROBE_STDOUT")" || return 1
    error_bytes="$(manifest_value metal_msl_library_probe_error_bounded_bytes "$PROBE_STDOUT")" || return 1
    nonnegative_integer "$error_raw_bytes" || return 1
    nonnegative_integer "$error_bytes" || return 1
    [ "$error_bytes" -le 1024 ] || return 1
    error_truncated="$(manifest_value metal_msl_library_probe_error_truncated "$PROBE_STDOUT")" || return 1
    [ "$error_truncated" = 0 ] || [ "$error_truncated" = 1 ] || return 1
    grep -Fxq "metal_msl_library_probe_cpu_fallback=unused" "$PROBE_STDOUT" || return 1
    grep -Fxq "metal_msl_library_probe_window_system=unused" "$PROBE_STDOUT" || return 1
}

probe_output_success_valid() {
    [ "$(manifest_value metal_msl_library_probe_status "$PROBE_STDOUT")" = pass ] || return 1
    [ "$(manifest_value metal_msl_library_probe_reason "$PROBE_STDOUT")" = metal-library-created ] || return 1
    [ "$(manifest_value metal_msl_library_probe_is_available "$PROBE_STDOUT")" = 1 ] || return 1
    [ "$(manifest_value metal_msl_library_probe_init "$PROBE_STDOUT")" = 1 ] || return 1
    device_count="$(manifest_value metal_msl_library_probe_device_count "$PROBE_STDOUT")" || return 1
    positive_integer "$device_count" || return 1
    [ "$(manifest_value metal_msl_library_probe_device_create_status "$PROBE_STDOUT")" = pass ] || return 1
    [ "$(manifest_value metal_msl_library_probe_compiler_status "$PROBE_STDOUT")" = pass ] || return 1
    [ "$(manifest_value metal_msl_library_probe_library_create_status "$PROBE_STDOUT")" = pass ] || return 1
    [ "$(manifest_value metal_msl_library_probe_error_bounded_bytes "$PROBE_STDOUT")" = 0 ] || return 1
    [ "$(manifest_value metal_msl_library_probe_error_raw_bytes "$PROBE_STDOUT")" = 0 ] || return 1
    [ "$(manifest_value metal_msl_library_probe_error_truncated "$PROBE_STDOUT")" = 0 ] || return 1
    grep -Fxq "metal_msl_library_probe_error=" "$PROBE_STDOUT" || return 1
    grep -Fxq "metal_msl_library_probe_library_destroyed=1" "$PROBE_STDOUT" || return 1
    grep -Fxq "metal_msl_library_probe_device_destroyed=1" "$PROBE_STDOUT" || return 1
}

[ "$(uname -s)" = Darwin ] || fail "macos-required"
[ -f "$ENTRY" ] || fail "diagnostic-entry-missing"
mkdir -p "$BUILD_DIR"
rm -f "$OUTPUT" "$PROBE_STDOUT" "$PROBE_STDERR" "$BUILD_STDOUT" "$BUILD_STDERR" "$EVIDENCE"

COMPILER=""
PROVIDER=""
RUNTIME_C_PROVIDER=""
verify_trusted_manifest || fail "trusted-compiler-provider-manifest-invalid"

for symbol in \
    _rt_metal_is_available _rt_metal_init _rt_metal_device_count \
    _rt_metal_create_device _rt_metal_destroy_device \
    _rt_metal_compile_shader _rt_metal_destroy_shader \
    _rt_metal_get_last_error; do
    nm -gU "$PROVIDER" | grep -Fq "$symbol" ||
        fail "provider-symbol-missing-${symbol#_}"
done

set +e
run_bounded_process "$BUILD_STDOUT" "$BUILD_STDERR" \
    "$PROCESS_TIMEOUT_SECS" "$PROCESS_TERM_GRACE_SECS" \
    env SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LIB=src \
    SIMPLE_LINK_OBJECTS="$PROVIDER:$RUNTIME_C_PROVIDER" \
    "$COMPILER" native-build --backend cranelift --threads 4 \
    --cache-dir "$BUILD_DIR/native-cache" --runtime-bundle core-c-bootstrap \
    --source src/lib --source test/02_integration/rendering \
    --entry-closure --entry "$ENTRY" --strip --output "$OUTPUT"
BUILD_EXIT=$?
set -e
[ "$BUILD_EXIT" != 124 ] || fail "native-build-timeout"
[ "$BUILD_EXIT" = 0 ] || fail "native-build-failed-status-$BUILD_EXIT"
[ -x "$OUTPUT" ] || fail "native-output-missing"

provider_dir="$(dirname -- "$PROVIDER")"
runtime_c_provider_dir="$(dirname -- "$RUNTIME_C_PROVIDER")"
set +e
run_bounded_process "$PROBE_STDOUT" "$PROBE_STDERR" \
    "$PROCESS_TIMEOUT_SECS" "$PROCESS_TERM_GRACE_SECS" \
    env DYLD_PRINT_LIBRARIES=1 \
    DYLD_LIBRARY_PATH="$provider_dir:$runtime_c_provider_dir:${DYLD_LIBRARY_PATH:-}" \
    "$OUTPUT"
PROBE_EXIT=$?
set -e
[ "$PROBE_EXIT" != 124 ] || fail "probe-timeout"
probe_output_schema_valid || fail "probe-output-schema-invalid-or-unbounded"
grep -Fq "$PROVIDER" "$PROBE_STDERR" || fail "provider-dyld-resolution-missing"

if [ "$PROBE_EXIT" = 0 ]; then
    probe_output_success_valid || fail "probe-output-success-contract-invalid"
    write_evidence pass "metal-library-probe-complete"
else
    write_evidence fail "metal-library-probe-failed-status-$PROBE_EXIT"
fi
{
    echo "metal_msl_library_diagnostic_provider_dyld_resolution_status=pass"
    sed -n '1,32p' "$PROBE_STDOUT"
} >>"$EVIDENCE"
cat "$EVIDENCE"
[ "$PROBE_EXIT" = 0 ]
