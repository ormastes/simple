#!/bin/sh
# check-runtime-http-framing.shs - native C HTTP framing: byte-exact loopback
# responses, no external services. POSIX only (the core-C HTTP client is POSIX).
# Builds src/runtime/test/rt_http_framing_selfcheck.c (client over the real
# runtime_native.c) and rt_http_framing_server.c (one-shot loopback server),
# Default: 33 framing cases x write strides 1/7/4096 = 99 runs.
# --matrix transfer-coding: 19 coding-list cases x those strides = 57 runs.
# Valid cases: exit 0 and stdout byte-equal. Rejected cases: exit 2, empty
# stdout, non-empty stderr. Last stdout line: cases=N passed=P failed=F.
# Usage: sh scripts/check/check-runtime-http-framing.shs --output DIR [--matrix transfer-coding]
# Exit: 0 all pass / 1 failures / 2 usage or build error.
set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
OUT=
MATRIX=framing
while [ $# -gt 0 ]; do
    case "$1" in
        --output) OUT=$2; shift 2 ;;
        --matrix) MATRIX=$2; shift 2 ;;
        *) echo "ERROR - unknown argument: $1" >&2; exit 2 ;;
    esac
done
case "$MATRIX" in framing|transfer-coding) ;; *) echo 'ERROR - invalid matrix' >&2; exit 2 ;; esac
[ -n "$OUT" ] || { echo "ERROR - --output DIR required" >&2; exit 2; }
[ ! -e "$OUT" ] || { echo "ERROR - output exists: $OUT" >&2; exit 2; }
mkdir -p "$OUT" || exit 2
OUT=$(cd "$OUT" && pwd)
W="$OUT/work"; mkdir -p "$W"
CLIENT="$OUT/http-framing"; SERVER="$OUT/http-framing-server"
: > "$OUT/compile.log"
"${CC:-clang}" -O2 -ffunction-sections -fdata-sections -std=gnu11 \
    -DSIMPLE_CORE_C_STANDALONE=1 -DSIMPLE_RUNTIME_MEMORY_OWNER=1 \
    -I"$ROOT/src/runtime" -I"$ROOT/src/runtime/platform" \
    "$ROOT/src/runtime/test/rt_http_framing_selfcheck.c" \
    -Wl,--gc-sections -lm -lpthread -o "$CLIENT" >>"$OUT/compile.log" 2>&1 \
    || { echo "ERROR - client compile failed (see $OUT/compile.log)" >&2; exit 2; }
"${CC:-clang}" -O2 -std=gnu11 "$ROOT/src/runtime/test/rt_http_framing_server.c" \
    -o "$SERVER" >>"$OUT/compile.log" 2>&1 \
    || { echo "ERROR - server compile failed (see $OUT/compile.log)" >&2; exit 2; }

BIN='\000\177\200\377'
CASES="$W/cases"; : > "$CASES"
# add_case NAME HEADERS(printf fmt) BODY(printf fmt) EXPECT(printf fmt, or REJECT)
add_case() {
    printf '%s\n' "$1" >> "$CASES"
    printf "$2" > "$W/$1.hdr"
    printf "$3" > "$W/$1.body"
    if [ "$4" = REJECT ]; then : > "$W/$1.reject"; else printf "$4" > "$W/$1.expect"; fi
}
CL='Content-Length: '; TE='Transfer-Encoding: chunked'
if [ "$MATRIX" = framing ]; then
add_case length-binary "${CL}4" "$BIN" "$BIN"
add_case length-empty "${CL}0" '' ''
add_case length-short "${CL}5" "$BIN" REJECT
add_case length-overflow "${CL}18446744073709551616" '' REJECT
add_case length-negative "${CL}-1" '' REJECT
add_case length-suffix "${CL}4x" "$BIN" REJECT
add_case length-duplicate-same "${CL}4\r\n${CL}4" "$BIN" "$BIN"
add_case length-duplicate-conflict "${CL}4\r\n${CL}5" "$BIN" REJECT
add_case chunk-binary "$TE" "4\r\n${BIN}\r\n0\r\n\r\n" "$BIN"
add_case chunk-empty "$TE" '0\r\n\r\n' ''
add_case chunk-extensions-trailer "$TE" '1;foo=bar\r\na\r\n0\r\nX-End: yes\r\n\r\n' 'a'
add_case chunk-missing-zero "$TE" '1\r\na\r\n' REJECT
add_case chunk-missing-final-crlf "$TE" '0\r\n' REJECT
add_case chunk-empty-wire "$TE" '' REJECT
add_case chunk-size-suffix "$TE" '1z\r\na\r\n0\r\n\r\n' REJECT
add_case chunk-size-sign "$TE" '+1\r\na\r\n0\r\n\r\n' REJECT
add_case chunk-size-space "$TE" ' 1\r\na\r\n0\r\n\r\n' REJECT
add_case chunk-size-prefix "$TE" '0x1\r\na\r\n0\r\n\r\n' REJECT
add_case chunk-size-overflow "$TE" '10000000000000000\r\na\r\n0\r\n\r\n' REJECT
add_case chunk-trailer-truncated "$TE" '0\r\nX-End: yes\r\n' REJECT
# Every nonempty proper prefix of a valid binary chunked body (14 bytes).
printf "4\r\n${BIN}\r\n0\r\n\r\n" > "$W/full.bin"
end=1
while [ "$end" -lt 14 ]; do
    name=chunk-prefix-$end
    printf '%s\n' "$name" >> "$CASES"
    printf '%s' "$TE" > "$W/$name.hdr"
    head -c "$end" "$W/full.bin" > "$W/$name.body"
    : > "$W/$name.reject"
    end=$((end + 1))
done
else
    # RFC 9112 sections 6.1/6.3: codings are ordered, never repeated chunked.
    # RFC 9110 section 5.6.1.2: tolerate reasonable empty list elements.
    PAYLOAD="abcdef0123456789${BIN}"
    CHUNK="14\r\n${PAYLOAD}\r\n0\r\n\r\n"
    add_case te-case-ows 'tRaNsFeR-EnCoDiNg:\tChUnKeD\t' "$CHUNK" "$PAYLOAD"
    add_case te-empty-elements 'Transfer-Encoding: , chunked, ,' "$CHUNK" "$PAYLOAD"
    add_case te-empty-field-then-chunked 'Transfer-Encoding:\r\nTransfer-Encoding: chunked' "$CHUNK" "$PAYLOAD"
    add_case te-duplicate-list 'Transfer-Encoding: chunked, chunked' "$CHUNK" REJECT
    add_case te-duplicate-fields 'Transfer-Encoding: chunked\r\nTransfer-Encoding: chunked' "$CHUNK" REJECT
    add_case te-duplicate-case 'Transfer-Encoding: CHUNKED, chunked' "$CHUNK" REJECT
    add_case te-missing-comma 'Transfer-Encoding: chunked chunked' "$CHUNK" REJECT
    add_case te-empty 'Transfer-Encoding:' "$PAYLOAD" REJECT
    add_case te-empty-list 'Transfer-Encoding: , ,' "$PAYLOAD" REJECT
    add_case te-unknown 'Transfer-Encoding: madeup' "$PAYLOAD" REJECT
    add_case te-parameter 'Transfer-Encoding: chunked; foo=bar' "$CHUNK" REJECT
    add_case te-cl-after 'Transfer-Encoding: chunked\r\nContent-Length: 20' "$CHUNK" REJECT
    add_case te-cl-before 'Content-Length: 20\r\nTransfer-Encoding: chunked' "$CHUNK" REJECT
    add_case te-cl-malformed 'Transfer-Encoding: chunked\r\nContent-Length: invalid' "$CHUNK" REJECT
    add_case te-cl-overflow 'Transfer-Encoding: chunked\r\nContent-Length: 18446744073709551616' "$CHUNK" REJECT
    # Valid gzip transfer coding is unsupported by this owner; do not return
    # undecoded transport bytes as successful application content.
    printf "$PAYLOAD" | gzip -n > "$W/compressed"
    add_case te-gzip 'Transfer-Encoding: gzip' '' REJECT
    cp "$W/compressed" "$W/te-gzip.body"
    add_case te-gzip-chunked 'Transfer-Encoding: gzip, chunked' '' REJECT
    { printf '%x\r\n' "$(wc -c < "$W/compressed")"; cat "$W/compressed"; printf '\r\n0\r\n\r\n'; } > "$W/te-gzip-chunked.body"
    add_case te-gzip-split 'Transfer-Encoding: gzip\r\nTransfer-Encoding: chunked' '' REJECT
    cp "$W/te-gzip-chunked.body" "$W/te-gzip-split.body"
    add_case te-chunked-gzip 'Transfer-Encoding: chunked, gzip' '' REJECT
    printf "$CHUNK" | gzip -n > "$W/te-chunked-gzip.body"
fi

RESULTS="$OUT/results.txt"; : > "$RESULTS"
total=0; failed=0
while read -r name; do
    for stride in 1 7 4096; do
        total=$((total + 1))
        rm -f "$W/port"
        { printf 'HTTP/1.1 200 OK\r\n'; cat "$W/$name.hdr"
          printf '\r\nConnection: close\r\n\r\n'; cat "$W/$name.body"; } > "$W/wire"
        cp "$W/wire" "$W/$name.wire"
        "$SERVER" "$W/port" "$stride" "$W/wire" &
        spid=$!
        i=0
        while [ ! -s "$W/port" ] && [ "$i" -lt 500 ]; do sleep 0.02; i=$((i + 1)); done
        port=$(cat "$W/port" 2>/dev/null)
        if [ -n "$port" ]; then
            timeout 8 "$CLIENT" "http://127.0.0.1:$port/" > "$W/stdout" 2> "$W/stderr"
            rc=$?
        else
            rc=125; : > "$W/stdout"; : > "$W/stderr"
        fi
        wait "$spid"; src=$?
        good=0
        if [ "$src" -eq 0 ]; then
            if [ -f "$W/$name.reject" ]; then
                [ "$rc" -eq 2 ] && [ ! -s "$W/stdout" ] && [ -s "$W/stderr" ] && good=1
            else
                [ "$rc" -eq 0 ] && cmp -s "$W/stdout" "$W/$name.expect" && good=1
            fi
        fi
        hex=$(od -An -tx1 -v "$W/stdout" | tr -d ' \n')
        err=$(tr -d '\r' < "$W/stderr" | tr '\n' ' ' | sed 's/ *$//')
        if [ "$good" -eq 1 ]; then v=PASS; else v=FAIL; failed=$((failed + 1)); fi
        printf '%s %s stride=%s rc=%s body=%s error=%s\n' "$v" "$name" "$stride" "$rc" "$hex" "$err" >> "$RESULTS"
    done
done < "$CASES"

for f in "$ROOT/src/runtime/runtime_native.c" "$ROOT/src/runtime/test/rt_http_framing_selfcheck.c" \
         "$ROOT/src/runtime/test/rt_http_framing_server.c" "$ROOT/scripts/check/check-runtime-http-framing.shs" "$CLIENT"; do
    [ "$f" = "$CLIENT" ] || cp "$f" "$OUT/$(basename "$f")"
    echo "SHA256 $(sha256sum "$f" | cut -d' ' -f1) $f"
done
grep '^FAIL' "$RESULTS" | head -20
echo "cases=$total passed=$((total - failed)) failed=$failed"
[ "$failed" -eq 0 ]
