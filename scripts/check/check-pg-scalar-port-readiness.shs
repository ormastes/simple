#!/bin/sh
set -eu
r=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
f="$r/src/lib/nogc_async_mut/database/postgres_mimic/scalar_dispatch_adapter.spl"

grep -q '^class PgScalarDispatchPortV1:' "$f"
grep -q 'extern fn rt_pg_dispatch_port_new() -> i64' "$f"
grep -q 'extern fn rt_pg_dispatch_port_release(port: i64) -> i64' "$f"
grep -q 'static fn create() -> PgScalarDispatchPortV1?:' "$f"
grep -q 'val token = rt_pg_dispatch_port_new()' "$f"
grep -q 'fn frontend(connection_id: i64) -> PgScalarFrontendAdapter?:' "$f"
grep -q 'fn owner() -> PgScalarDispatchOwner?:' "$f"
grep -q 'rt_pg_dispatch_port_release(self.port_token)' "$f"
grep -q 'if self.released: return false' "$f"

# The readiness constructor is scalar-only and must remain isolated from the
# aggregate live server path until its worker migration is separately admitted.
if grep -q 'PgDispatchGate\|PgWireServerConfig\|extern fn .*Any' "$f"; then
    exit 1
fi
printf '%s\n' 'PASS pg_scalar_port_readiness_source_contract'
