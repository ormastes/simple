#!/bin/sh
# External diagnostic receipt. A successful readback is never presentation or
# Chrome-parity admission. This script does not build or select a seed compiler.
set -eu
LC_ALL=C
export LC_ALL
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT"

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        shasum -a 256 "$1" | awk '{print $1}'
    fi
}
field() {
    awk -v key="$2" 'index($0,key "=")==1 {n++; value=substr($0,length(key)+2)}
        END {if(n!=1) exit 1; print value}' "$1"
}
positive() { awk -v n="$1" 'BEGIN {exit !(n ~ /^[0-9]+([.][0-9]+)?$/ && n+0>0)}'; }
check_receipt() {
    receipt=$1
    [ -f "$receipt" ] || { echo 'STATUS: FAIL missing-receipt'; return 1; }
    for pair in 'schema=simple.web-showcase-external/v1' 'width=3840' 'height=2160' \
        'requested_backend=vulkan' 'comparison_admitted=false'; do
        key=${pair%%=*}; expected=${pair#*=}
        actual=$(field "$receipt" "$key") || { echo "STATUS: FAIL missing-or-duplicate-$key"; return 1; }
        [ "$actual" = "$expected" ] || { echo "STATUS: FAIL invalid-$key"; return 1; }
    done
    status=$(field "$receipt" status) || return 1
    reason=$(field "$receipt" reason) || return 1
    case "$status" in
        BLOCKED) echo "STATUS: BLOCKED $reason"; return 2 ;;
        FAIL) echo "STATUS: FAIL $reason"; return 1 ;;
        MEASURED) ;;
        *) echo 'STATUS: FAIL invalid-status'; return 1 ;;
    esac
    for key in binary source_fixture runner_source; do
        path=$(field "$receipt" "${key}_path") || return 1
        digest=$(field "$receipt" "${key}_sha256") || return 1
        [ -f "$path" ] && [ "$(sha256 "$path")" = "$digest" ] || {
            echo "STATUS: FAIL stale-$key"; return 1;
        }
    done
    for key in process_wall_seconds process_max_rss_bytes; do
        value=$(field "$receipt" "$key") || return 1
        positive "$value" || { echo "STATUS: FAIL invalid-$key"; return 1; }
    done
    # This receipt has no completion timestamp, warm series, adapter admission,
    # composed-fixture digest or all-tab pixel comparison. Never promote it.
    echo 'STATUS: BLOCKED measured-readback-only-presentation-and-parity-unverified'
    return 2
}

if [ "${1:-}" = --check ]; then
    [ "$#" -eq 2 ] || exit 1
    check_receipt "$2"
    exit $?
fi
case "$(uname -s):$(uname -m)" in
    # Match bin/release/simple: the non-macho artifact is the deployed
    # self-hosted runtime.  The -macho sibling is a bootstrap CLI and must
    # never be selected for an admitted renderer receipt.
    Darwin:arm64|Darwin:aarch64) binary="$ROOT/bin/release/aarch64-apple-darwin/simple" ;;
    Linux:x86_64) binary="$ROOT/bin/release/x86_64-unknown-linux-gnu/simple" ;;
    Linux:aarch64) binary="$ROOT/bin/release/aarch64-unknown-linux-gnu/simple" ;;
    *) binary="$ROOT/bin/release/unsupported-host/simple" ;;
esac
if [ "${1:-}" = --binary ] && [ "$#" -eq 2 ]; then
    binary=$2
elif [ "$#" -ne 0 ]; then
    echo 'Usage: sh scripts/check/check-web-showcase-4k-receipt.shs [--binary DEPLOYED_RELEASE_BINARY | --check RECEIPT]'
    exit 1
fi
fixture="$ROOT/examples/06_io/ui/browser_common_elements_showcase.html"
runner="$ROOT/examples/06_io/ui/web_render_file_gui.spl"
mkdir -p "$ROOT/build/web_renderer_vulkan_4k_showcase_hardening/simple"
out=$(mktemp -d "$ROOT/build/web_renderer_vulkan_4k_showcase_hardening/simple/receipt.XXXXXX")
status=BLOCKED
reason=preflight-incomplete
binary_digest=unavailable
wall=unavailable
rss=unavailable
process_exit=unavailable
source_revision=$(git rev-parse HEAD)
fixture_digest=$(sha256 "$fixture")
runner_digest=$(sha256 "$runner")
git diff --binary HEAD -- src examples/06_io/ui test/05_perf/web_render_chrome > "$out/tracked-source.patch"
source_dirty_digest=$(sha256 "$out/tracked-source.patch")
write_receipt() {
    {
        printf 'schema=simple.web-showcase-external/v1\nstatus=%s\nreason=%s\n' "$status" "$reason"
        printf 'binary_path=%s\nbinary_sha256=%s\n' "$binary" "$binary_digest"
        printf 'source_fixture_path=%s\nsource_fixture_sha256=%s\n' "$fixture" "$fixture_digest"
        printf 'runner_source_path=%s\nrunner_source_sha256=%s\n' "$runner" "$runner_digest"
        printf 'source_revision=%s\nsource_tracked_diff_sha256=%s\nsource_closure_digest=unavailable\n' "$source_revision" "$source_dirty_digest"
        printf 'composed_fixture_sha256=unavailable\ninventory_digest=unavailable\n'
        printf 'width=3840\nheight=2160\nrequested_backend=vulkan\nmode=headless-readback\n'
        printf 'process_wall_seconds=%s\nprocess_max_rss_bytes=%s\nprocess_exit=%s\n' "$wall" "$rss" "$process_exit"
        printf 'timing_origin=external-process-start\ntiming_end=process-exit\nrss_scope=timed-command-high-water\n'
        printf 'timeout_seconds=20\ncache_state=uncontrolled\nscanout_status=unverified\nwarm_sample_count=0\n'
        printf 'physical_vulkan_status=unverified\ncomparison_admitted=false\n'
        printf 'host_os=%s\nhost_arch=%s\ngenerated_utc=%s\n' "$(uname -s)" "$(uname -m)" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    } > "$out/receipt.env"
    printf 'receipt=%s/receipt.env\n' "$out"
}
blocked() { reason=$1; write_receipt; echo "STATUS: BLOCKED $reason"; exit 2; }
failed() { status=FAIL; reason=$1; write_receipt; echo "STATUS: FAIL $reason"; exit 1; }
[ -x "$binary" ] || blocked deployed-binary-unavailable
# Resolve links before checking the lane; bin/local and compiler_rust can never
# be admitted through a symlink placed under bin/release.
binary=$(realpath "$binary") || blocked binary-path-unresolvable
case "$binary" in "$ROOT"/bin/release/*/simple) ;; *) blocked non-deployed-binary-forbidden ;; esac
binary_digest=$(sha256 "$binary")
if command -v timeout >/dev/null 2>&1; then limiter=timeout
elif command -v gtimeout >/dev/null 2>&1; then limiter=gtimeout
else blocked timeout-unavailable
fi
[ -x /usr/bin/time ] || blocked process-timer-unavailable
# Bounded probes precede any renderer execution. Log size is capped as well.
if ! (ulimit -f 2048; "$limiter" -k 1 3 "$binary" --version) >"$out/version.log" 2>&1; then
    blocked cli-version-unavailable
fi
if grep -Eiq 'bootstrap|rust.seed' "$out/version.log"; then
    blocked unsupported-bootstrap-cli
fi
if ! (ulimit -f 2048; "$limiter" -k 1 3 "$binary" --help) >"$out/help.log" 2>&1; then
    blocked cli-help-unavailable
fi
grep -Fq '<file.spl>' "$out/help.log" || blocked cli-source-entry-unavailable
# Readback mode exits after one frame. Interactive process lifetime must not
# be misreported as startup latency. This is a diagnostic source-run boundary,
# not the required cached-artifact production startup boundary.
set +e
case "$(uname -s)" in
    Darwin)
        (ulimit -f 2048; /usr/bin/time -lp "$limiter" -k 1 20 env SIMPLE_GUI=0 SIMPLE_GUI_BACKEND=vulkan SHOWCASE_RESOLUTION=4k \
            "$binary" "$runner") >"$out/stdout.log" 2>"$out/process.log"
        process_exit=$?
        wall=$(awk '$1=="real" && NF==2 {print $2}' "$out/process.log")
        rss=$(awk '/maximum resident set size/ {print $1}' "$out/process.log") ;;
    Linux)
        (ulimit -f 2048; /usr/bin/time -f 'external_wall_seconds=%e\nexternal_max_rss_kib=%M' "$limiter" -k 1 20 env SIMPLE_GUI=0 SIMPLE_GUI_BACKEND=vulkan SHOWCASE_RESOLUTION=4k \
            "$binary" "$runner") >"$out/stdout.log" 2>"$out/process.log"
        process_exit=$?
        wall=$(sed -n 's/^external_wall_seconds=//p' "$out/process.log")
        rss=$(awk -F= '$1=="external_max_rss_kib" {printf "%.0f\n",$2*1024}' "$out/process.log") ;;
esac
set -e
[ "$process_exit" -eq 0 ] || failed renderer-process-failed-or-timeout
[ "$(sha256 "$binary")" = "$binary_digest" ] || failed binary-changed-during-run
[ "$(sha256 "$fixture")" = "$fixture_digest" ] || failed fixture-changed-during-run
[ "$(sha256 "$runner")" = "$runner_digest" ] || failed runner-changed-during-run
positive "$wall" && positive "$rss" || failed missing-process-metrics
awk '
    /^web_standards_showcase / && / width=/ {
        rows++; delete f
        for(i=1;i<=NF;i++) {split($i,p,"="); if(p[1] in f) bad=1; f[p[1]]=p[2]}
        if(f["status"]!="measured" || f["width"]!="3840" || f["height"]!="2160" ||
           f["requested"]!="vulkan" || f["resolved"]!="vulkan" ||
           f["source"]!="device_readback" || f["pixels"]!="8294400" ||
           f["backend_handle"]+0<=0 || f["device_identity"]+0<=0 ||
           f["checksum"]+0==0 || f["nonzero"]+0<=0) bad=1
    }
    /status=fail/ {bad=1}
    END {exit !(rows==1 && !bad)}' "$out/stdout.log" || failed invalid-vulkan-4k-readback-record
status=MEASURED
reason=readback-process-only
write_receipt
check_receipt "$out/receipt.env"
