#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

SIMPLE_BIN="${SIMPLE_BIN:-bin/simple}"
BUILD_DIR="${BUILD_DIR:-build/web-draw-ir-route-key-sdn-overhead}"
HARNESS="test/05_perf/web_render_chrome/web_draw_ir_route_key_cost_spec.spl"
LOG="$BUILD_DIR/benchmark.log"
EVIDENCE="$BUILD_DIR/evidence.env"
mkdir -p "$BUILD_DIR"
rm -f "$LOG" "$EVIDENCE"

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | cut -d' ' -f1
    else
        return 1
    fi
}

HARNESS_SHA256="$(sha256_file "$HARNESS" || true)"

write_receipt() {
    {
        echo "web_draw_ir_sdn_schema=web-draw-ir-sdn-v1"
        echo "web_draw_ir_sdn_status=$1"
        echo "web_draw_ir_sdn_reason=$2"
        echo "web_draw_ir_sdn_evidence_kind=$3"
        echo "web_draw_ir_sdn_execution=serializer_proxy"
        echo "web_draw_ir_sdn_backend=web"
        echo "web_draw_ir_sdn_harness=$HARNESS"
        echo "web_draw_ir_sdn_log=$LOG"
        echo "web_draw_ir_sdn_simple_bin=$SIMPLE_BIN"
        echo "web_draw_ir_sdn_simple_bin_real=${SIMPLE_BIN_REAL:-}"
        echo "web_draw_ir_sdn_source_revision=$(git rev-parse HEAD)"
        echo "web_draw_ir_sdn_harness_sha256=$HARNESS_SHA256"
        echo "web_draw_ir_sdn_warmup_samples=3"
        echo "web_draw_ir_sdn_measured_samples=3"
        echo "web_draw_ir_sdn_small_us=${small_us:-}"
        echo "web_draw_ir_sdn_medium_us=${medium_us:-}"
        echo "web_draw_ir_sdn_large_us=${large_us:-}"
        echo "web_draw_ir_sdn_small_bytes=${small_bytes:-}"
        echo "web_draw_ir_sdn_medium_bytes=${medium_bytes:-}"
        echo "web_draw_ir_sdn_large_bytes=${large_bytes:-}"
    } >"$EVIDENCE"
    cat "$EVIDENCE"
}

if [ -z "$HARNESS_SHA256" ]; then
    write_receipt unavailable missing-sha256-tool host-dependency
    exit 125
fi

if [ ! -x "$SIMPLE_BIN" ]; then
    write_receipt unavailable missing-admitted-pure-simple-binary host-dependency
    exit 125
fi

SIMPLE_BIN_REAL="$(realpath "$SIMPLE_BIN" 2>/dev/null || true)"
case "$SIMPLE_BIN_REAL" in
    "$ROOT_DIR"/bin/release/*/simple|"$ROOT_DIR"/build/bootstrap/stage3/simple|"$ROOT_DIR"/build/bootstrap/stage3/*/simple) ;;
    *)
        write_receipt unavailable unrecognized-pure-simple-deployment host-dependency
        exit 125
        ;;
esac

if ! version="$("$SIMPLE_BIN" --version 2>&1)" || [ -z "$version" ]; then
    write_receipt unavailable simple-version-probe-failed host-dependency
    exit 125
fi
version="$(printf '%s' "$version" | tr '\n' ' ')"
case "$version" in
    *"bootstrap seed only"*|*"Rust-built"*|*"debug build"*)
        write_receipt unavailable rust-seed-forbidden host-dependency
        exit 125
        ;;
esac
if [ "$("$SIMPLE_BIN" -c 'print(6 * 7)' 2>/dev/null || true)" != 42 ]; then
    write_receipt unavailable simple-language-probe-failed host-dependency
    exit 125
fi

timeout_secs="${WEB_DRAW_IR_SDN_TIMEOUT_SECS:-180}"
run_benchmark() {
    if command -v timeout >/dev/null 2>&1; then
        timeout "$timeout_secs" "$SIMPLE_BIN" test "$HARNESS" --mode=interpreter
    else
        "$SIMPLE_BIN" test "$HARNESS" --mode=interpreter
    fi
}
if ! SIMPLE_LIB=src SIMPLE_EXECUTION_MODE=interpret run_benchmark >"$LOG" 2>&1; then
    write_receipt fail benchmark-command-failed source-matched-incremental
    exit 1
fi

line_count="$(grep -c '^WEB_DRAW_IR_KEY_SDN_COST ' "$LOG" || true)"
line="$(grep '^WEB_DRAW_IR_KEY_SDN_COST ' "$LOG" || true)"
field() {
    printf '%s\n' "$line" | tr ' ' '\n' | awk -F= -v key="$1" '$1 == key { print $2; exit }'
}
small_us="$(field small_us)"
medium_us="$(field medium_us)"
large_us="$(field large_us)"
small_bytes="$(field small_bytes)"
medium_bytes="$(field medium_bytes)"
large_bytes="$(field large_bytes)"
is_positive() { printf '%s\n' "$1" | grep -Eq '^[1-9][0-9]*$'; }
if [ "$line_count" -ne 1 ] \
    || ! is_positive "$small_us" || ! is_positive "$medium_us" || ! is_positive "$large_us" \
    || ! is_positive "$small_bytes" || ! is_positive "$medium_bytes" || ! is_positive "$large_bytes" \
    || [ "$small_bytes" -ge "$medium_bytes" ] || [ "$medium_bytes" -ge "$large_bytes" ]; then
    write_receipt fail malformed-benchmark-receipt source-matched-incremental
    exit 1
fi

write_receipt pass measured-serializer-proxy admitted-pure-simple-incremental
