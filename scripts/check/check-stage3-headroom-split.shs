#!/bin/sh
# Selftest for bootstrap_stage3_memory_split_headroom
# (scripts/check/lib/bootstrap-stage3/memory-admission.shs): HEADROOM is the
# Stage 3 launch floor and the default for the unit MemoryHigh and the live
# free-memory reserve; set separately, each keeps its own value; a bad value
# is refused; resume-stage3-from-admitted.sh uses the split settings.
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
BOOTSTRAP_STAGE3_FACADE_PATH="$repo_root/scripts/check/lib/bootstrap-stage3-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$repo_root/scripts/check/lib/bootstrap-stage3/memory-admission.shs"

fail() { echo "FAIL — $*"; exit 1; }
checked=0

(
    unset SIMPLE_BOOTSTRAP_STAGE3_MEMORY_HIGH_MIB SIMPLE_BOOTSTRAP_STAGE3_RUNTIME_RESERVE_MIB
    SIMPLE_BOOTSTRAP_STAGE3_HEADROOM_MIB=49152
    bootstrap_stage3_memory_split_headroom &&
        [ "$SIMPLE_BOOTSTRAP_STAGE3_MEMORY_HIGH_MIB" = 49152 ] &&
        [ "$SIMPLE_BOOTSTRAP_STAGE3_RUNTIME_RESERVE_MIB" = 49152 ]
) || fail "unset MemoryHigh/reserve did not default to HEADROOM"
checked=$((checked + 1))
(
    SIMPLE_BOOTSTRAP_STAGE3_HEADROOM_MIB=32768
    SIMPLE_BOOTSTRAP_STAGE3_MEMORY_HIGH_MIB=73728
    SIMPLE_BOOTSTRAP_STAGE3_RUNTIME_RESERVE_MIB=16384
    bootstrap_stage3_memory_split_headroom &&
        [ "$SIMPLE_BOOTSTRAP_STAGE3_HEADROOM_MIB" = 32768 ] &&
        [ "$SIMPLE_BOOTSTRAP_STAGE3_MEMORY_HIGH_MIB" = 73728 ] &&
        [ "$SIMPLE_BOOTSTRAP_STAGE3_RUNTIME_RESERVE_MIB" = 16384 ]
) || fail "separately set values were not kept"
checked=$((checked + 1))
for bad in abc 0 -1; do
    (
        SIMPLE_BOOTSTRAP_STAGE3_HEADROOM_MIB=49152
        SIMPLE_BOOTSTRAP_STAGE3_RUNTIME_RESERVE_MIB=$bad
        ! bootstrap_stage3_memory_split_headroom
    ) || fail "invalid reserve '$bad' was accepted"
    checked=$((checked + 1))
done
resume="$repo_root/scripts/bootstrap/resume-stage3-from-admitted.sh"
grep -Fq 'MemoryHigh=${SIMPLE_BOOTSTRAP_STAGE3_MEMORY_HIGH_MIB}M' "$resume" ||
    fail "Stage 3 unit MemoryHigh does not use the MemoryHigh setting"
grep -Fq 'stage3_guard_reserve_kib=$((SIMPLE_BOOTSTRAP_STAGE3_RUNTIME_RESERVE_MIB * 1024))' "$resume" ||
    fail "Stage 3 live reserve does not use the reserve setting"
grep -Fq 'MemoryHigh=${SIMPLE_BOOTSTRAP_STAGE3_HEADROOM_MIB}M' "$resume" &&
    fail "Stage 3 unit MemoryHigh still reads HEADROOM"
checked=$((checked + 3))
echo "PASS — $checked headroom-split check(s)"
