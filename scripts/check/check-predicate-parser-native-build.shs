#!/bin/sh
# Narrow native-build regression check for src/compiler/00.common/predicate_parser.spl.
#
# Guards against undeclared-symbol codegen errors like the has_paren_idx bug
# (doc/08_tracking/bug/stage2_native_build_has_paren_idx_undeclared_global_2026-08-09.md):
# a typo'd local-variable name (declared as `paren_idx`, referenced as
# `has_paren_idx` / `paren_idx_value`) passed the interpreter path silently
# (unresolved variable references are a warning there, not a hard error) but
# broke LLVM codegen with "llvm global load referenced undeclared symbol".
#
# Scoped to src/compiler/00.common only, so this is a ~10s check, not a full
# bootstrap. Automated bootstrap callers bind the admitted Stage 4 candidate
# through SIMPLE_BINARY/SIMPLE_BIN. An explicit path remains available for
# focused diagnostics; SIMPLE_STAGE2_BIN is the legacy fallback.
set -eu

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

resolve_binary() {
    if [ -n "${1:-}" ]; then
        printf '%s\n' "$1"
    elif [ -n "${SIMPLE_BINARY:-}" ]; then
        printf '%s\n' "$SIMPLE_BINARY"
    elif [ -n "${SIMPLE_BIN:-}" ]; then
        printf '%s\n' "$SIMPLE_BIN"
    elif [ -n "${SIMPLE_STAGE2_BIN:-}" ]; then
        printf '%s\n' "$SIMPLE_STAGE2_BIN"
    else
        printf '%s\n' "$REPO_ROOT/bin/simple"
    fi
}

if [ "${1:-}" = "--self-test" ]; then
    [ "$(SIMPLE_BINARY=/stage4 SIMPLE_BIN=/other SIMPLE_STAGE2_BIN=/stage2 resolve_binary /explicit)" = /explicit ]
    [ "$(SIMPLE_BINARY=/stage4 SIMPLE_BIN=/other SIMPLE_STAGE2_BIN=/stage2 resolve_binary)" = /stage4 ]
    [ "$(SIMPLE_BINARY= SIMPLE_BIN=/stage4-bin SIMPLE_STAGE2_BIN=/stage2 resolve_binary)" = /stage4-bin ]
    [ "$(SIMPLE_BINARY= SIMPLE_BIN= SIMPLE_STAGE2_BIN=/stage2 resolve_binary)" = /stage2 ]
    [ "$(SIMPLE_BINARY= SIMPLE_BIN= SIMPLE_STAGE2_BIN= resolve_binary)" = "$REPO_ROOT/bin/simple" ]
    echo 'PASS — predicate-parser compiler resolver preserves explicit override and exact Stage4 priority'
    exit 0
fi

BIN="$(resolve_binary "${1:-}")"

if [ ! -x "$BIN" ]; then
    echo "ERROR — stage2 binary not found/executable: $BIN" >&2
    exit 2
fi

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

cat > "$WORK/main.spl" <<'EOF'
fn main():
    print("hi")
EOF

OUT="$WORK/out"
LOG="$WORK/build.log"

if ! "$BIN" native-build --backend llvm --mode dynload \
        --entry "$WORK/main.spl" \
        --source "$REPO_ROOT/src/compiler/00.common" \
        --output "$OUT" > "$LOG" 2>&1; then
    echo "FAIL — native-build of src/compiler/00.common failed" >&2
    tail -n 40 "$LOG" >&2
    exit 1
fi

if grep -q "llvm global load referenced undeclared symbol" "$LOG"; then
    echo "FAIL — undeclared-symbol codegen error detected" >&2
    grep "llvm global load referenced undeclared symbol" "$LOG" >&2
    exit 1
fi

# native-build reporting rc=0 is NOT proof anything runnable was produced --
# see doc/08_tracking/bug/native_build_reports_success_for_functionless_artifact_2026-08-10.md
# and scripts/check/check-native-build-artifact-has-functions.shs, whose model
# this retrofit reuses. Two independent real checks replace the former
# exit-code-only trust:
#   1. the artifact carries at least one defined FUNC symbol (structurally not
#      empty), via the existing FUNC-symbol helper script.
#   2. the artifact actually EXECUTES and produces the expected program output
#      ("hi"), not merely that the linker/compiler pipeline returned 0.
FUNC_HELPER="$REPO_ROOT/scripts/check/check-native-build-artifact-has-functions.shs"
if [ ! -x "$OUT" ] && [ ! -f "$OUT" ]; then
    echo "FAIL — native-build reported success but produced no artifact at $OUT" >&2
    exit 1
fi
if ! sh "$FUNC_HELPER" "$OUT" > "$WORK/func-check.log" 2>&1; then
    echo "FAIL — native-build artifact has no defined FUNC symbols (structurally empty)" >&2
    cat "$WORK/func-check.log" >&2
    exit 1
fi

RUN_LOG="$WORK/run.log"
if [ ! -x "$OUT" ]; then
    chmod +x "$OUT" 2>/dev/null || true
fi
if ! "$OUT" > "$RUN_LOG" 2>&1; then
    echo "FAIL — native-build artifact built and has FUNC symbols but failed to execute" >&2
    cat "$RUN_LOG" >&2
    exit 1
fi
if [ "$(cat "$RUN_LOG")" != "hi" ]; then
    echo "FAIL — native-build artifact executed but printed unexpected output" >&2
    echo "  expected: hi" >&2
    echo "  actual:   $(cat "$RUN_LOG")" >&2
    exit 1
fi

echo "PASS — 3 check(s) verified: src/compiler/00.common native-build clean, artifact has FUNC symbols, artifact executes and prints 'hi'"
