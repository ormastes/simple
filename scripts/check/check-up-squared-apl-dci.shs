#!/usr/bin/env sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
MODE="${1:---contract}"
CONNECTION_RECEIPT="${UP2_DCI_CONNECTION_RECEIPT:-}"

fail() { echo "up2_dci_status=fail"; echo "up2_dci_reason=$1"; exit 1; }
blocked() { echo "up2_dci_status=blocked"; echo "up2_dci_reason=$1"; exit 2; }
receipt_value() { awk -F= -v key="$2" '$1==key {sub(/^[^=]*=/, ""); print; exit}' "$1"; }

contract() {
    rg -q 'DCI is not a block-storage protocol' \
        "$ROOT_DIR/doc/01_research/domain/up_squared_apl_intel_dci_debug.md"
    rg -q 'Do not copy `simpleos.elf`' \
        "$ROOT_DIR/doc/07_guide/platform/simpleos/up_squared_apl_intel_dci_debug.md"
    rg -q 'not a USB 3.x DbC cable' \
        "$ROOT_DIR/doc/01_research/local/up_squared_apl_intel_dci_debug.md"
    rg -q 'No option is selected yet' \
        "$ROOT_DIR/doc/02_requirements/feature/up_squared_apl_intel_dci_debug_options.md"
    rg -q 'direct_rip_boot=forbidden' \
        "$ROOT_DIR/scripts/check/inspect-up-squared-apl-dci-elf.shs"
    echo up2_dci_contract_status=pass
    echo mutations=none
    echo dci_role=run-control,trace,physical-memory
    echo storage_role=target-side-driver-required
    echo apollo_lake_openrc_warm_reset=forbidden
}

toolkit_path() {
    for path in \
        /opt/intel/system_debugger \
        /opt/intel/oneapi/system-bring-up-toolkit \
        /opt/intel/system-bring-up-toolkit; do
        if test -d "$path"; then
            printf '%s\n' "$path"
            return 0
        fi
    done
    return 1
}

validate_receipt() {
    receipt="$1"
    test -s "$receipt" || blocked connection-receipt-missing
    test "$(receipt_value "$receipt" schema)" = up2-dci-connection-v1 || fail connection-receipt-schema
    test "$(receipt_value "$receipt" status)" = pass || fail connection-receipt-status
    test "$(receipt_value "$receipt" target)" = original-up-squared-apollo-lake || fail connection-receipt-target
    test "$(receipt_value "$receipt" connection)" = usb3-dbc || fail connection-receipt-transport
    test "$(receipt_value "$receipt" debug_interface)" = enabled-unlocked || fail debug-interface-not-ready
    test "$(receipt_value "$receipt" reset_policy)" = hardware-baseline-openrc-warm-reset-forbidden || \
        fail unsafe-reset-policy
    for key in board_fab bios_version tool_version cable_identity timestamp_utc; do
        test -n "$(receipt_value "$receipt" "$key")" || fail "connection-receipt-missing-$key"
    done
}

inventory() {
    echo up2_dci_inventory=read-only
    if command -v lsusb >/dev/null 2>&1; then
        if lsusb -d 0ea0:2211 2>/dev/null | grep -q .; then
            echo observed_smart_km_link=0ea0:2211,non-dci-usb2-composite
        fi
        if lsusb -d 0403:6010 2>/dev/null | grep -q .; then
            echo observed_tigard=0403:6010,non-dci-ft2232h
        fi
    else
        echo usb_inventory=unavailable
    fi
    if toolkit="$(toolkit_path)"; then
        echo intel_toolkit="$toolkit"
    else
        echo intel_toolkit=missing
        blocked intel-system-debugger-not-installed
    fi
    test -e /etc/udev/rules.d/99-dci.rules || blocked intel-dci-udev-rules-missing
    test -n "$CONNECTION_RECEIPT" || blocked connection-receipt-not-supplied
    validate_receipt "$CONNECTION_RECEIPT"
    echo up2_dci_status=ready
    echo connection_receipt="$CONNECTION_RECEIPT"
    echo allowed_next_step=read-only-run-control-validation
    echo persistent_writes=none
}

self_test() {
    contract >/dev/null
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    printf '%s\n' \
        schema=up2-dci-connection-v1 \
        status=pass \
        target=original-up-squared-apollo-lake \
        connection=usb3-dbc \
        debug_interface=enabled-unlocked \
        reset_policy=hardware-baseline-openrc-warm-reset-forbidden \
        board_fab=TEST \
        bios_version=TEST \
        tool_version=TEST \
        cable_identity=TEST \
        timestamp_utc=1970-01-01T00:00:00Z > "$tmp"
    validate_receipt "$tmp"
    printf '%s\n' schema=wrong > "$tmp"
    set +e
    output="$(validate_receipt "$tmp" 2>&1)"
    rc=$?
    set -e
    test "$rc" -eq 1 || fail self-test-malformed-receipt-verdict
    printf '%s\n' "$output" | grep -q 'up2_dci_reason=connection-receipt-schema' || \
        fail self-test-malformed-receipt-reason
    echo up2_dci_self_test_status=pass
    echo bios_writes=0
    echo msr_writes=0
    echo storage_writes=0
}

case "$MODE" in
    --contract) contract ;;
    --inventory) inventory ;;
    --self-test) self_test ;;
    *) echo "usage: $0 [--contract|--inventory|--self-test]" >&2; exit 64 ;;
esac
