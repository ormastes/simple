#!/bin/sh
# check-native-binary-symbol-gate.shs — fail-closed gate: a linked native
# binary must actually carry the symbols its user objects define.
#
# Motivation: doc/08_tracking/bug/t3_full_bootstrap_stage3_unresolved_type_byteorder_cache_validator_2026-08-06.md
# (2026-08-08 update) — Stage 3 exited 0 with a ~22 KB stub binary while the
# real 1.16 MB bootstrap_main.o sat beside it unlinked. Exit status and
# "error:" line counts are fail-open readings in that lane; the honest
# completion test is a symbol check on the emitted binary against the objects
# that were supposed to be linked into it.
#
# Usage:
#   sh scripts/check/check-native-binary-symbol-gate.shs --binary <path> [--objects <o1> <o2> ...] [--min-coverage <pct>]
#   sh scripts/check/check-native-binary-symbol-gate.shs --selftest
#
# With no --objects, sibling objects matching "<binary>.*.o" are used (the
# driver's object_base naming: {output}.{module}.o).
#
# Checks (all fail-closed):
#   1. Non-vacuity: at least one object, and the objects define >= 1 global.
#   2. __simple_main: if any object defines it, the binary must define it too.
#   3. Coverage: >= min-coverage % (default 90) of the distinct global symbols
#      defined across the objects must be defined in the binary.
#   4. Readability: unreadable/stripped binary or objects => ERROR, never PASS.
#
# Verdict convention (same as the other scripts/check guards): last stdout line
#   PASS — <n> symbol(s) checked, ...          exit 0
#   FAIL — ...                                 exit 1
#   ERROR — nothing was checked[: reason]      exit 2
# --selftest runs before every scan and is fatal.

set -u

err() { printf '%s\n' "ERROR — nothing was checked: $1"; exit 2; }

find_nm() {
    for c in llvm-nm nm; do
        if command -v "$c" >/dev/null 2>&1; then printf '%s' "$c"; return 0; fi
    done
    return 1
}

# Print distinct global *defined* symbol names of a file, one per line.
# nm -g: external only; portable "defined" = type letter not U/w/v.
# Exit status of nm is read directly, never through the pipe tail.
defined_globals() {
    _dg_file=$1
    _dg_out=$("$NM" -g -P "$_dg_file" 2>/dev/null)
    _dg_status=$?
    if [ "$_dg_status" -ne 0 ]; then return 1; fi
    printf '%s\n' "$_dg_out" | awk '$2 != "U" && $2 != "w" && $2 != "v" && $1 != "" { print $1 }' | sort -u
}

run_gate() {
    binary=$1; shift
    min_coverage=$1; shift
    # remaining args: object files
    [ -f "$binary" ] || err "binary not found: $binary"
    if [ "$#" -eq 0 ]; then
        err "no object files supplied and none matched ${binary}.*.o"
    fi

    obj_syms=$(mktemp) || err "mktemp failed"
    bin_syms=$(mktemp) || { rm -f "$obj_syms"; err "mktemp failed"; }
    trap 'rm -f "$obj_syms" "$bin_syms"' EXIT

    for obj in "$@"; do
        [ -f "$obj" ] || err "object not found: $obj"
        defined_globals "$obj" >> "$obj_syms" || err "nm failed on object: $obj"
    done
    sort -u -o "$obj_syms" "$obj_syms"
    total=$(grep -c . "$obj_syms")
    if [ "$total" -eq 0 ]; then
        err "objects define no global symbols (nothing to verify)"
    fi

    defined_globals "$binary" > "$bin_syms" || err "nm failed on binary: $binary"
    if ! grep -q . "$bin_syms"; then
        err "binary has no readable defined globals (stripped?): $binary"
    fi

    matched=$(comm -12 "$obj_syms" "$bin_syms" | grep -c .)

    if grep -qx '__simple_main' "$obj_syms" && ! grep -qx '__simple_main' "$bin_syms"; then
        printf '%s\n' "FAIL — $total symbol(s) checked, __simple_main defined in objects but absent from binary $binary"
        exit 1
    fi

    # integer percent, floor
    pct=$(( matched * 100 / total ))
    if [ "$pct" -lt "$min_coverage" ]; then
        missing=$(comm -23 "$obj_syms" "$bin_syms" | head -5 | tr '\n' ' ')
        printf '%s\n' "FAIL — $total symbol(s) checked, only $matched present in $binary (${pct}% < ${min_coverage}%); first missing: $missing"
        exit 1
    fi

    printf '%s\n' "PASS — $total symbol(s) checked, $matched present in $binary (${pct}% >= ${min_coverage}%)"
    exit 0
}

selftest() {
    CC=""
    for c in cc clang gcc; do
        if command -v "$c" >/dev/null 2>&1; then CC=$c; break; fi
    done
    [ -n "$CC" ] || err "selftest requires a C compiler (cc/clang/gcc)"

    st_dir=$(mktemp -d) || err "selftest mktemp failed"
    st_fail=""

    # Fixture: real module object defining __simple_main + a helper, entry shim
    # calling it — mirrors compile_entry_point_c's shape.
    cat > "$st_dir/module.c" <<'EOF'
long long spl_helper_alpha(void) { return 7; }
long long spl_helper_beta(void) { return 9; }
long long __simple_main(void) { return spl_helper_alpha() + spl_helper_beta(); }
EOF
    cat > "$st_dir/entry.c" <<'EOF'
extern long long __simple_main(void);
int main(void) { return (int)__simple_main(); }
EOF
    # Incident replay: a tiny wrong object with its own __simple_main.
    cat > "$st_dir/stub.c" <<'EOF'
long long __simple_main(void) { return 0; }
EOF
    "$CC" -c -o "$st_dir/module.o" "$st_dir/module.c" 2>/dev/null || err "selftest fixture compile failed (module.c)"
    "$CC" -c -o "$st_dir/entry.o"  "$st_dir/entry.c"  2>/dev/null || err "selftest fixture compile failed (entry.c)"
    "$CC" -c -o "$st_dir/stub.o"   "$st_dir/stub.c"   2>/dev/null || err "selftest fixture compile failed (stub.c)"
    "$CC" -o "$st_dir/good_bin" "$st_dir/entry.o" "$st_dir/module.o" 2>/dev/null || err "selftest fixture link failed (good_bin)"
    # Vacuous binary: linked from the stub only — the incident shape.
    "$CC" -o "$st_dir/vacuous_bin" "$st_dir/entry.o" "$st_dir/stub.o" 2>/dev/null || err "selftest fixture link failed (vacuous_bin)"
    # Stripped binary for the ERROR fixture.
    cp "$st_dir/good_bin" "$st_dir/stripped_bin"
    strip "$st_dir/stripped_bin" 2>/dev/null || true

    # Each fixture re-invokes this script WITHOUT --selftest.
    self=$0
    # 1. Correct link must PASS.
    out=$(sh "$self" --no-selftest --binary "$st_dir/good_bin" --objects "$st_dir/module.o"); rc=$?
    [ "$rc" -eq 0 ] || st_fail="good-link-must-pass (rc=$rc: $out)"
    # 2. Incident replay must FAIL: real module.o claimed as input, vacuous binary.
    if [ -z "$st_fail" ]; then
        out=$(sh "$self" --no-selftest --binary "$st_dir/vacuous_bin" --objects "$st_dir/module.o"); rc=$?
        [ "$rc" -eq 1 ] || st_fail="vacuous-link-must-fail (rc=$rc: $out)"
        case "$out" in *FAIL*) : ;; *) st_fail="vacuous-link-must-print-FAIL ($out)";; esac
    fi
    # 3. Stripped binary must ERROR (2), never pass — but only when strip
    #    actually removed the symtab (some strips keep dynsym entries).
    if [ -z "$st_fail" ]; then
        out=$(sh "$self" --no-selftest --binary "$st_dir/stripped_bin" --objects "$st_dir/module.o"); rc=$?
        [ "$rc" -ne 0 ] || st_fail="stripped-binary-must-not-pass (rc=$rc: $out)"
    fi
    # 4. Zero objects must ERROR.
    if [ -z "$st_fail" ]; then
        out=$(sh "$self" --no-selftest --binary "$st_dir/good_bin" --objects); rc=$?
        [ "$rc" -eq 2 ] || st_fail="zero-objects-must-error (rc=$rc: $out)"
    fi
    # 5. Missing binary must ERROR.
    if [ -z "$st_fail" ]; then
        out=$(sh "$self" --no-selftest --binary "$st_dir/no_such_bin" --objects "$st_dir/module.o"); rc=$?
        [ "$rc" -eq 2 ] || st_fail="missing-binary-must-error (rc=$rc: $out)"
    fi

    rm -rf "$st_dir"
    if [ -n "$st_fail" ]; then
        err "selftest fixture failed: $st_fail"
    fi
}

NM=$(find_nm) || err "requires llvm-nm or nm"

binary=""
min_coverage=90
objects_mode=0
run_selftest_only=0
skip_selftest=0
set -- "$@"
objs=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --selftest) run_selftest_only=1; shift ;;
        --no-selftest) skip_selftest=1; shift ;;
        --binary) [ "$#" -ge 2 ] || err "--binary requires a path"; binary=$2; shift 2 ;;
        --min-coverage) [ "$#" -ge 2 ] || err "--min-coverage requires a percent"; min_coverage=$2; shift 2 ;;
        --objects) objects_mode=1; shift ;;
        --*) err "unknown flag: $1" ;;
        *)
            if [ "$objects_mode" -eq 1 ]; then
                objs="$objs
$1"
                shift
            else
                err "unexpected argument: $1"
            fi
            ;;
    esac
done
case "$min_coverage" in ''|*[!0-9]*) err "--min-coverage must be a whole percent" ;; esac

if [ "$run_selftest_only" -eq 1 ]; then
    selftest
    printf '%s\n' "PASS — 5 selftest fixture(s) checked, gate behaves fail-closed"
    exit 0
fi

# Selftest runs before every real scan and is fatal (skipped only for the
# selftest's own recursive invocations).
if [ "$skip_selftest" -eq 0 ]; then
    selftest
fi

[ -n "$binary" ] || err "--binary is required"
if [ -z "$objs" ] && [ "$objects_mode" -eq 0 ]; then
    # Auto-discover sibling objects: {binary}.{module}.o
    for f in "$binary".*.o; do
        [ -f "$f" ] && objs="$objs
$f"
    done
fi

# shellcheck disable=SC2086 — intentional word splitting on newline list
old_ifs=$IFS; IFS='
'
set -- $objs
IFS=$old_ifs
run_gate "$binary" "$min_coverage" "$@"
