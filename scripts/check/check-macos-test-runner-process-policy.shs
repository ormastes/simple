#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
BINARY=${SIMPLE_PHASE2_FULL_CLI:-}
EXPECTED_SHA256=${SIMPLE_PHASE2_FULL_CLI_SHA256:-}
RSS_MAX_KIB=${MACOS_TEST_RUNNER_POLICY_RSS_MAX_KIB:-1048576}
OUT=${MACOS_TEST_RUNNER_POLICY_OUT:-"$ROOT/build/evidence/macos-test-runner-process-policy"}

usage() {
    echo "usage: SIMPLE_PHASE2_FULL_CLI=/abs/simple SIMPLE_PHASE2_FULL_CLI_SHA256=<sha256> $0" >&2
    exit 2
}

# A qualification run is green only when the process succeeds AND its output
# reports every counted test as passed. In particular, zero tests or a partial
# pass count is not sufficient qualification evidence.
case_is_nonvacuous_green() {
    _case_rc=$1
    _case_log=$2
    [ "$_case_rc" -eq 0 ] || return 1
    [ -f "$_case_log" ] || return 1
    awk '
        function canonical_count(value) {
            return value == "0" || value ~ /^[1-9][0-9]*$/
        }
        function results_green(line, fields, count) {
            if (line !~ /^Results:[[:space:]]*(0|[1-9][0-9]*) total,[[:space:]]*(0|[1-9][0-9]*) passed,[[:space:]]*(0|[1-9][0-9]*) failed$/) return 0
            count = split(line, fields, /[[:space:],]+/)
            if (count != 7 || fields[1] != "Results:" || fields[3] != "total" || fields[5] != "passed" || fields[7] != "failed") return 0
            return canonical_count(fields[2]) && canonical_count(fields[4]) && canonical_count(fields[6]) && fields[2] != "0" && fields[4] == fields[2] && fields[6] == "0"
        }
        function fallback_status(line, fields, count) {
            if (line ~ /^[[:space:]]*(0|[1-9][0-9]*) examples?, (0|[1-9][0-9]*) failures[[:space:]]*$/) {
                count = split(line, fields, /[[:space:],]+/)
                if (count == 4 && canonical_count(fields[1]) && fields[1] != "0" && canonical_count(fields[3])) return fields[3] == "0" ? 1 : -1
            }
            if (line ~ /^[[:space:]]*(0|[1-9][0-9]*) passed, (0|[1-9][0-9]*) failed[[:space:]]*$/) {
                count = split(line, fields, /[[:space:],]+/)
                if (count == 4 && canonical_count(fields[1]) && canonical_count(fields[3])) return fields[1] != "0" && fields[3] == "0" ? 1 : -1
            }
            return 0
        }
        {
            esc = sprintf("%c", 27)
            gsub(esc "\\[[0-9;]*m", "", $0)
            if ($0 ~ /^Results:/) {
                saw_results = 1
                final_results = $0
            } else if (!saw_results) {
                status = fallback_status($0)
                if (status != 0) {
                    saw_fallback = 1
                    final_fallback = status
                }
            }
        }
        END {
            if (saw_results) exit results_green(final_results) ? 0 : 1
            if (saw_fallback) exit final_fallback == 1 ? 0 : 1
            exit 1
        }
    ' "$_case_log"
}

selftest_summary_contract() {
    _selftest_dir=$(mktemp -d 2>/dev/null) || {
        echo "FAIL: cannot create summary self-test directory" >&2
        return 1
    }
    trap 'rm -rf "$_selftest_dir"' EXIT INT TERM

    _expect_case() {
        _name=$1
        _rc=$2
        _want=$3
        _summary=$4
        _file="$_selftest_dir/$_name.log"
        printf '%b\n' "$_summary" >"$_file"
        if case_is_nonvacuous_green "$_rc" "$_file"; then
            _got=pass
        else
            _got=reject
        fi
        [ "$_got" = "$_want" ] || {
            echo "FAIL: summary self-test $_name expected $_want, got $_got" >&2
            return 1
        }
    }

    _expect_case real-green 0 pass 'Results: 2 total, 2 passed, 0 failed' || return 1
    _expect_case zero-results 0 reject 'Results: 0 total, 0 passed, 0 failed' || return 1
    _expect_case all-skipped 0 reject 'Results: 3 total, 0 passed, 0 failed, 3 skipped' || return 1
    _expect_case malformed 0 reject 'all tests passed without a result summary' || return 1
    _expect_case failed-summary 0 reject 'Results: 1 total, 0 passed, 1 failed' || return 1
    _expect_case earlier-green-final-red 0 reject 'Results: 1 total, 1 passed, 0 failed\nResults: 1 total, 0 passed, 1 failed' || return 1
    _expect_case earlier-green-final-zero 0 reject 'Results: 1 total, 1 passed, 0 failed\nResults: 0 total, 0 passed, 0 failed' || return 1
    _expect_case earlier-green-final-leading-zero 0 reject 'Results: 1 total, 1 passed, 0 failed\nResults: 1 total, 1 passed, 01 failed' || return 1
    _expect_case earlier-red-final-green 0 pass 'Results: 1 total, 0 passed, 1 failed\nResults: 1 total, 1 passed, 0 failed' || return 1
    _expect_case earlier-green-final-malformed 0 reject '2 examples, 0 failures\nResults: malformed' || return 1
    _expect_case canonical-over-fallback 0 pass 'Results: 1 total, 1 passed, 0 failed\n0 examples, 1 failures' || return 1
    _expect_case leading-zero-total 0 reject 'Results: 01 total, 1 passed, 0 failed' || return 1
    _expect_case leading-zero-passed 0 reject 'Results: 1 total, 01 passed, 0 failed' || return 1
    _expect_case leading-zero-failed 0 reject 'Results: 1 total, 1 passed, 01 failed' || return 1
    _expect_case inconsistent-counts 0 reject 'Results: 1 total, 2 passed, 0 failed' || return 1
    _expect_case incomplete-pass-count 0 reject 'Results: 9 total, 2 passed, 0 failed' || return 1
    _expect_case explicit-skips 0 reject 'Results: 3 total, 2 passed, 0 failed, 1 skipped' || return 1
    _expect_case trailing-data 0 reject 'Results: 1 total, 1 passed, 0 failed extra' || return 1
    _expect_case fallback-green 0 pass '2 examples, 0 failures' || return 1
    _expect_case fallback-passed 0 pass '2 passed, 0 failed' || return 1
    _expect_case fallback-ansi-green 0 pass '\033[32m2 examples, 0 failures\033[0m' || return 1
    _expect_case fallback-earlier-green-final-red 0 reject '2 examples, 0 failures\n1 examples, 1 failures' || return 1
    _expect_case nonzero-with-green-summary 1 reject 'Results: 1 total, 1 passed, 0 failed' || return 1
    _expect_case nonzero-with-failed-summary 1 reject 'Results: 1 total, 0 passed, 1 failed' || return 1
    trap - EXIT INT TERM
    rm -rf "$_selftest_dir"
    echo "PASS: macOS test-runner summary rejects vacuous, skipped, malformed, and failed results"
}

if [ "${1:-}" = "--selftest-summary" ]; then
    selftest_summary_contract
    exit $?
fi

[ "$(uname -s)" = Darwin ] || { echo "BLOCKED: macOS host required" >&2; exit 2; }
[ -n "$BINARY" ] && [ -x "$BINARY" ] && [ -n "$EXPECTED_SHA256" ] || usage

actual_sha256=$(shasum -a 256 "$BINARY" | awk '{print $1}')
[ "$actual_sha256" = "$EXPECTED_SHA256" ] || {
    echo "FAIL: full CLI hash mismatch expected=$EXPECTED_SHA256 actual=$actual_sha256" >&2
    exit 1
}
"$BINARY" --help 2>&1 | grep -Eq '(^|[[:space:]])test([[:space:]]|$)' || {
    echo "BLOCKED: admitted binary has no test command" >&2
    exit 2
}

mkdir -p "$OUT"
uid_processes=$(ps -U "$(id -u)" -o pid= | wc -l | tr -d ' ')
[ "$uid_processes" -gt 64 ] || {
    echo "BLOCKED: baseline needs more than 64 live UID processes (observed $uid_processes)" >&2
    exit 2
}

set +e
/bin/sh -c 'ulimit -u 64 || exit 124; /bin/sh -c true' >"$OUT/baseline.out" 2>"$OUT/baseline.err"
baseline_rc=$?
set -e
[ "$baseline_rc" -ne 0 ] || {
    echo "FAIL: historical ulimit -u 64 baseline unexpectedly forked" >&2
    exit 1
}

host_soft_max_procs=$(/bin/sh -c 'ulimit -u')
case "$host_soft_max_procs" in
    *[!0-9]*|'') explicit_max_procs=1048576 ;;
    *) explicit_max_procs=$host_soft_max_procs ;;
esac
[ "$explicit_max_procs" -gt "$uid_processes" ] || {
    echo "BLOCKED: host process limit $explicit_max_procs is not above current UID count $uid_processes" >&2
    exit 2
}

max_rss_kib=0
run_case() {
    name=$1
    shift
    time_file="$OUT/$name.time"
    log_file="$OUT/$name.log"
    set +e
    (cd "$ROOT" && /usr/bin/time -l -o "$time_file" "$BINARY" "$@") >"$log_file" 2>&1
    rc=$?
    set -e
    [ "$rc" -eq 0 ] || { echo "FAIL: $name exited $rc (see $log_file)" >&2; exit 1; }
    case_is_nonvacuous_green "$rc" "$log_file" || {
        echo "FAIL: $name lacks non-vacuous green summary" >&2
        exit 1
    }
    rss_bytes=$(awk '/maximum resident set size/ {print $1; exit}' "$time_file")
    case "$rss_bytes" in ''|*[!0-9]*) echo "FAIL: $name has no Darwin RSS sample" >&2; exit 1 ;; esac
    rss_kib=$(( (rss_bytes + 1023) / 1024 ))
    [ "$rss_kib" -le "$RSS_MAX_KIB" ] || {
        echo "FAIL: $name RSS ${rss_kib}KiB exceeds ${RSS_MAX_KIB}KiB" >&2
        exit 1
    }
    [ "$rss_kib" -le "$max_rss_kib" ] || max_rss_kib=$rss_kib
}

run_case macos_policy test test/01_unit/app/test_runner_new/macos_process_policy_spec.spl --mode=interpreter
run_case safe_caps test test/01_unit/app/test_runner_new/safe_mode_caps_spec.spl --mode=interpreter
run_case args test test/01_unit/app/test_runner/args_spec.spl --mode=interpreter
run_case single_args test test/01_unit/app/test_runner_new/single_lane_arg_parsing_neighbors_spec.spl --mode=interpreter
run_case live_default test scripts/check/fixtures/test_runner_calibration_green_spec.spl --mode=interpreter
run_case live_explicit test scripts/check/fixtures/test_runner_calibration_green_spec.spl --mode=interpreter --max-procs="$explicit_max_procs"
run_case live_safe_unlimited test scripts/check/fixtures/test_runner_calibration_green_spec.spl --mode=interpreter --safe-mode --no-limits

cat >"$OUT/receipt.env" <<EOF
schema=macos-test-runner-process-policy-v1
status=PASS
binary=$BINARY
binary_sha256=$actual_sha256
uid_processes=$uid_processes
historical_max_procs=64
historical_baseline_rc=$baseline_rc
default_policy=inherit
explicit_max_procs=$explicit_max_procs
safe_mode_no_limits=PASS
max_rss_kib=$max_rss_kib
rss_ceiling_kib=$RSS_MAX_KIB
sosix_compatibility=unchanged-host-only-test-policy
EOF

echo "PASS: macOS test runner process policy (max_rss_kib=$max_rss_kib)"
