#!/bin/sh
# check-rt-pointer-ref-map.shs: SRT004 C pointer-return and SRT003/SNULL parameter map.
# POSIX sh + one awk (scripts/check/lib/rt-scan.awk); replaces check-rt-pointer-ref-map.py.
# Usage: check-rt-pointer-ref-map.shs [--root DIR] [--regen-baseline] [--regen-param-baseline] [--selftest]
# Last stdout line is the verdict: PASS (0), FAIL (1), ERROR nothing checked (2).
# Deliberate deviations from the Python original: see the header of lib/rt-scan.awk.
LC_ALL=C; export LC_ALL
here=$(cd "$(dirname "$0")" && pwd) || exit 2
root=$(cd "$here/../.." && pwd) || exit 2
selftest=0; regen=0; regen_param=0
while [ $# -gt 0 ]; do
  case $1 in
    --selftest) selftest=1 ;;
    --regen-baseline) regen=1 ;;
    --regen-param-baseline) regen_param=1 ;;
    --root) shift; root=${1:-}; [ -n "$root" ] || { echo "ERROR — --root needs a value"; exit 2; } ;;
    *) ;;
  esac
  shift
done
if [ "$selftest" = 1 ]; then
  RT_ROOT= awk -v MODE=ptr -v SELFTEST=1 -f "$here/lib/rt-scan.awk" </dev/null
  exit $?
fi
RT_ROOT=$root
export RT_ROOT
tops=
for d in src/runtime src/compiler src/lib src/app src/os; do
  [ -d "$root/$d" ] && tops="$tops $root/$d"
done
[ -n "$tops" ] || { echo "ERROR — nothing was checked (0 C pointer symbols or 0 extern edges)"; exit 2; }
# shellcheck disable=SC2086
find $tops -type f \( -name '*.c' -o -name '*.h' -o -name '*.spl' \) 2>/dev/null |
  awk -v MODE=ptr -v REGEN=$regen -v REGEN_PARAM=$regen_param -f "$here/lib/rt-scan.awk"
