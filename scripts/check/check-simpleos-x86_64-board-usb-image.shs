#!/bin/sh
# check-simpleos-x86_64-board-usb-image.shs
#
# Verifies, WITHOUT a physical board, that
# scripts/os/build-simpleos-x86_64-board-usb.shs produced a structurally
# correct GPT+FAT32 USB boot image: a valid GPT partition table, one
# partition typed EFI System (ef00), a FAT32 filesystem at that partition's
# offset, and a non-trivially-sized BOOTX64.EFI + startup.nsh inside it.
#
# This does NOT prove the image boots real firmware — that step is
# hardware-blocked, see doc/07_guide/os/simpleos_board_bringup.md. It proves
# the artifact this repo can produce today is the right SHAPE for a board to
# accept, which is everything checkable without the board in hand.
#
# Verdict is always the last line of stdout:
#   PASS — <n> check(s) passed, image structurally sound
#   FAIL — <reason>
#   ERROR — nothing was checked (missing tools/image; not a verdict either way)

set -eu

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
DISK=${DISK:-$REPO_ROOT/build/os/x86_64_board_usb/board-usb.img}

fail() { printf 'FAIL — %s\n' "$1"; exit 1; }
err()  { printf 'ERROR — nothing was checked (%s)\n' "$1"; exit 2; }

command -v sgdisk >/dev/null 2>&1 || err "sgdisk not installed"
command -v mdir >/dev/null 2>&1 || err "mtools (mdir) not installed"
command -v llvm-readobj >/dev/null 2>&1 || err "llvm-readobj not installed"
[ -f "$DISK" ] || err "no image at $DISK — run scripts/os/build-simpleos-x86_64-board-usb.shs first"

CHECKS=0

# 1. Primary/backup GPT structures and CRCs verify, then retain the partition
# listing. `sgdisk --print` does not emit the legacy `GPT: present` phrase on
# current gdisk releases, so successful structured verification is the oracle.
GPT_CHECK=$(mktemp "${TMPDIR:-/tmp}/simpleos-usb-gpt.XXXXXX")
trap 'rm -f "$GPT_CHECK"' EXIT HUP INT TERM
sgdisk --verify "$DISK" >"$GPT_CHECK" 2>&1 || fail "sgdisk could not verify GPT from $DISK"
grep -q "No problems found" "$GPT_CHECK" || fail "GPT verification did not report a clean primary/backup table"
sgdisk --print "$DISK" >"$GPT_CHECK" 2>&1 || fail "sgdisk could not read GPT from $DISK"
CHECKS=$((CHECKS + 1))

# 2. Exactly one partition, typed EF00 (EFI System Partition).
PART_LINE=$(grep -E "^   1 " "$GPT_CHECK" || true)
[ -n "$PART_LINE" ] || fail "no partition 1 found in GPT of $DISK"
echo "$PART_LINE" | grep -qi "EF00" || fail "partition 1 is not typed EF00 (EFI System): $PART_LINE"
CHECKS=$((CHECKS + 1))

PART2_LINE=$(grep -E "^   2 " "$GPT_CHECK" || true)
[ -z "$PART2_LINE" ] || fail "expected exactly one partition, found a second: $PART2_LINE"
CHECKS=$((CHECKS + 1))
rm -f "$GPT_CHECK"
trap - EXIT HUP INT TERM

# 3. Partition starts at sector 2048 (matches the builder's fixed offset,
#    so `dd ... seek=2048` in the builder actually lands inside it).
START_SECT=$(sgdisk --info=1 "$DISK" 2>/dev/null | grep "First sector" | sed -E 's/.*: ([0-9]+) .*/\1/')
[ "$START_SECT" = "2048" ] || fail "partition 1 starts at sector $START_SECT, expected 2048"
CHECKS=$((CHECKS + 1))

# 4. FAT32 filesystem at that offset holds the expected boot files.
OFFSET_BYTES=$((2048 * 512))
MTOOLS_SKIP_CHECK=1
export MTOOLS_SKIP_CHECK
DRV_LETTER="Z"
DRIVE_CFG=$(mktemp)
printf 'drive %s: file="%s" offset=%d\n' "$DRV_LETTER" "$DISK" "$OFFSET_BYTES" > "$DRIVE_CFG"
LISTING=$(MTOOLSRC="$DRIVE_CFG" mdir -i "${DISK}@@${OFFSET_BYTES}" "::" 2>&1) \
    || fail "could not read FAT filesystem at partition offset in $DISK"
rm -f "$DRIVE_CFG"
echo "$LISTING" | grep -qi "STARTUP" || fail "startup.nsh missing from ESP filesystem"
CHECKS=$((CHECKS + 1))

MTOOLS_SKIP_CHECK=1
export MTOOLS_SKIP_CHECK
EFI_LISTING=$(mdir -i "${DISK}@@${OFFSET_BYTES}" "::EFI/BOOT" 2>&1) \
    || fail "could not list EFI/BOOT directory in ESP"
echo "$EFI_LISTING" | grep -qi "BOOTX64" || fail "BOOTX64.EFI missing from EFI/BOOT"
echo "$EFI_LISTING" | grep -qi "GRUBX64" || fail "GRUBX64.EFI fallback missing from EFI/BOOT"
CHECKS=$((CHECKS + 1))

# 5. BOOTX64.EFI is non-trivially sized (a truncated/zero-byte write must not
#    read as success).
# mtools prints the 8.3 basename and extension as separate columns:
# `BOOTX64  EFI  <size> ...`.
BOOTX64_SIZE=$(echo "$EFI_LISTING" | awk 'toupper($1)=="BOOTX64" && toupper($2)=="EFI" {print $3; exit}')
case "$BOOTX64_SIZE" in
    ''|*[!0-9]*) fail "could not parse BOOTX64.EFI size from mdir output" ;;
esac
[ "$BOOTX64_SIZE" -gt 1024 ] || fail "BOOTX64.EFI is only $BOOTX64_SIZE bytes (< 1024 floor)"
CHECKS=$((CHECKS + 1))

# 6. BOOTX64 is the resident mailbox publisher and GRUBX64 is the self-contained
#    fallback carrying the admitted Multiboot2/module contract.
EFI_COPY=$(mktemp "${TMPDIR:-/tmp}/simpleos-bootx64.XXXXXX")
GRUB_COPY=$(mktemp "${TMPDIR:-/tmp}/simpleos-grubx64.XXXXXX")
trap 'rm -f "$EFI_COPY" "$GRUB_COPY"' EXIT HUP INT TERM
mcopy -i "${DISK}@@${OFFSET_BYTES}" "::EFI/BOOT/BOOTX64.EFI" "$EFI_COPY" >/dev/null 2>&1 \
    || fail "could not extract BOOTX64.EFI for loader-contract verification"
llvm-readobj --file-headers "$EFI_COPY" | grep -q 'Subsystem: IMAGE_SUBSYSTEM_EFI_APPLICATION' \
    || fail "BOOTX64.EFI is not a PE32+ EFI application"
strings "$EFI_COPY" | grep -Fq 'UP2 DCI UEFI resident-ready mailbox=0x' \
    || fail "BOOTX64.EFI does not publish the resident mailbox marker"
strings "$EFI_COPY" | grep -Fq 'UP2 DCI UEFI fallback=grub' \
    || fail "BOOTX64.EFI does not carry the fail-closed GRUB fallback marker"
mcopy -i "${DISK}@@${OFFSET_BYTES}" "::EFI/BOOT/GRUBX64.EFI" "$GRUB_COPY" >/dev/null 2>&1 \
    || fail "could not extract GRUBX64.EFI for fallback-contract verification"
strings "$GRUB_COPY" | grep -Fq 'multiboot2 /boot/loader.elf' \
    || fail "GRUBX64.EFI does not embed the ELF32 Multiboot2 loader command"
strings "$GRUB_COPY" | grep -Fq 'module2 /boot/kernel.elf simpleos-kernel' \
    || fail "GRUBX64.EFI does not embed the ELF64 kernel module command"
strings "$GRUB_COPY" | grep -Fq '[UP2-SHIM] elf64-loaded' \
    || fail "GRUBX64.EFI does not embed the ELF64 loader shim"
strings "$GRUB_COPY" | grep -Fq 'UP2 loader-ready' \
    || fail "GRUBX64.EFI does not embed the serial loader-ready marker"
strings "$GRUB_COPY" | grep -Fq 'UP2 kernel-admitted' \
    || fail "GRUBX64.EFI does not embed the serial kernel-admitted marker"
rm -f "$EFI_COPY" "$GRUB_COPY"
trap - EXIT HUP INT TERM
CHECKS=$((CHECKS + 1))

[ "$CHECKS" -gt 0 ] || err "no checks executed"
printf 'PASS — %d check(s) passed, image structurally sound\n' "$CHECKS"
