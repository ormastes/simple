#!/bin/sh
# check-simpleos-x86_64-board-usb-image.shs
#
# Verifies, WITHOUT a physical board, that
# scripts/os/build-simpleos-x86_64-board-usb.shs produced a structurally
# correct GPT+FAT32 USB boot image: a valid GPT partition table, one
# partition typed EFI System (ef00), a FAT32 filesystem at that partition's
# offset, and a non-trivially-sized BOOTX64.EFI + startup.nsh inside it.
#
# This does NOT prove the image boots real firmware — that step is
# hardware-blocked, see doc/07_guide/os/simpleos_board_bringup.md. It proves
# the artifact this repo can produce today is the right SHAPE for a board to
# accept, which is everything checkable without the board in hand.
#
# Verdict is always the last line of stdout:
#   PASS — <n> check(s) passed, image structurally sound
#   FAIL — <reason>
#   ERROR — nothing was checked (missing tools/image; not a verdict either way)

set -eu

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
DISK=${DISK:-$REPO_ROOT/build/os/up-squared-apollo-lake/usb/board-usb.img}

fail() { printf 'FAIL — %s\n' "$1"; exit 1; }
err()  { printf 'ERROR — nothing was checked (%s)\n' "$1"; exit 2; }

command -v sgdisk >/dev/null 2>&1 || err "sgdisk not installed"
command -v mdir >/dev/null 2>&1 || err "mtools (mdir) not installed"
[ -f "$DISK" ] || err "no image at $DISK — run scripts/os/build-simpleos-x86_64-board-usb.shs first"

CHECKS=0

# 1. Both GPT copies and their CRCs validate. `sgdisk --print` output differs
# across releases and does not universally include the phrase `GPT: present`.
# The verifier is the stable semantic oracle; retain print output for the
# partition-shape checks below.
sgdisk --verify "$DISK" >/tmp/simpleos_usb_gpt_verify.$$ 2>&1 \
    || fail "primary/backup GPT verification failed for $DISK"
grep -q "No problems found" /tmp/simpleos_usb_gpt_verify.$$ \
    || fail "GPT verifier did not confirm a clean primary/backup table"
rm -f /tmp/simpleos_usb_gpt_verify.$$
sgdisk --print "$DISK" >/tmp/simpleos_usb_gpt_check.$$ 2>&1 \
    || fail "sgdisk could not read GPT from $DISK"
CHECKS=$((CHECKS + 1))

# 2. Exactly one partition, typed EF00 (EFI System Partition).
PART_LINE=$(grep -E "^   1 " /tmp/simpleos_usb_gpt_check.$$ || true)
[ -n "$PART_LINE" ] || fail "no partition 1 found in GPT of $DISK"
echo "$PART_LINE" | grep -qi "EF00" || fail "partition 1 is not typed EF00 (EFI System): $PART_LINE"
CHECKS=$((CHECKS + 1))

PART2_LINE=$(grep -E "^   2 " /tmp/simpleos_usb_gpt_check.$$ || true)
[ -z "$PART2_LINE" ] || fail "expected exactly one partition, found a second: $PART2_LINE"
CHECKS=$((CHECKS + 1))
rm -f /tmp/simpleos_usb_gpt_check.$$

# 3. Partition starts at sector 2048 (matches the builder's fixed offset,
#    so `dd ... seek=2048` in the builder actually lands inside it).
START_SECT=$(sgdisk --info=1 "$DISK" 2>/dev/null | grep "First sector" | sed -E 's/.*: ([0-9]+) .*/\1/')
[ "$START_SECT" = "2048" ] || fail "partition 1 starts at sector $START_SECT, expected 2048"
CHECKS=$((CHECKS + 1))

# 4. FAT32 filesystem at that offset holds the expected boot files.
OFFSET_BYTES=$((2048 * 512))
MTOOLS_SKIP_CHECK=1
export MTOOLS_SKIP_CHECK
DRV_LETTER="Z"
DRIVE_CFG=$(mktemp)
printf 'drive %s: file="%s" offset=%d\n' "$DRV_LETTER" "$DISK" "$OFFSET_BYTES" > "$DRIVE_CFG"
LISTING=$(MTOOLSRC="$DRIVE_CFG" mdir -i "${DISK}@@${OFFSET_BYTES}" "::" 2>&1) \
    || fail "could not read FAT filesystem at partition offset in $DISK"
rm -f "$DRIVE_CFG"
echo "$LISTING" | grep -qi "STARTUP" || fail "startup.nsh missing from ESP filesystem"
CHECKS=$((CHECKS + 1))

MTOOLS_SKIP_CHECK=1
export MTOOLS_SKIP_CHECK
EFI_LISTING=$(mdir -i "${DISK}@@${OFFSET_BYTES}" "::EFI/BOOT" 2>&1) \
    || fail "could not list EFI/BOOT directory in ESP"
echo "$EFI_LISTING" | grep -qi "BOOTX64" || fail "BOOTX64.EFI missing from EFI/BOOT"
CHECKS=$((CHECKS + 1))

# 5. BOOTX64.EFI is non-trivially sized (a truncated/zero-byte write must not
#    read as success). Use mcopy directly to avoid fragile mdir field parsing.
BOOTX64_TMP="$(mktemp)"
trap 'rm -f "$BOOTX64_TMP"' EXIT
mcopy -i "${DISK}@@${OFFSET_BYTES}" "::EFI/BOOT/BOOTX64.EFI" "$BOOTX64_TMP" \
    || fail "could not copy BOOTX64.EFI from ESP"
BOOTX64_SIZE="$(wc -c < "$BOOTX64_TMP")"
[ "$BOOTX64_SIZE" -gt 1024 ] || fail "BOOTX64.EFI is only $BOOTX64_SIZE bytes (< 1024 floor)"
rm -f "$BOOTX64_TMP"
CHECKS=$((CHECKS + 1))

[ "$CHECKS" -gt 0 ] || err "no checks executed"
printf 'PASS — %d check(s) passed, image structurally sound\n' "$CHECKS"
