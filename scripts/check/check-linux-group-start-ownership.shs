#!/bin/sh
# Fault-injected host component evidence; not V4 descendant admission.
set -eu
if [ "$(uname -s)" != Linux ]; then
    echo 'linux-group-start-ownership: requires Linux (not a PASS)' >&2
    exit 77
fi
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/linux-group-start-ownership.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
"${CC:-cc}" -std=c11 -O1 -Wall -Wextra -Werror \
    "$root/src/runtime/test/runtime_linux_group_start_ownership_selfcheck.c" \
    -o "$scratch/selfcheck"
timeout 10 "$scratch/selfcheck"
