#!/bin/sh
# Refuse to push a commit range carrying WINDOWS-CHECKOUT DAMAGE.
#
# Motivating incident: PR #232 (merged 2026-09-01, repaired by #245/#246). A
# Windows checkout without SeCreateSymbolicLinkPrivilege, and with
# core.autocrlf active, wrote three mechanically distinct kinds of damage back
# into main, and EVERY existing pre-push guard passed over all three:
#
#   1. SYMLINK MATERIALIZATION — a tracked symlink (mode 120000) became a
#      regular file (mode 100644) whose CONTENT is the old link target text.
#      git renders this as delete+add, so a reviewer reading the PR sees an
#      ordinary small file being edited. 9 paths landed this way
#      (src/app/leak_finder/*.spl, src/app/lint/main.spl).
#   2. ABSOLUTE WINDOWS SYMLINK TARGETS — a mode-120000 blob rewritten to an
#      absolute Windows path, e.g.
#      `test/01_unit/app/desugar/app -> C:/Users/ormas/dev/simple/src/app`.
#      The mode STAYS 120000, so the diff status is `M`, not `T`: signature 1
#      cannot see this one. 4 paths landed this way.
#   3. NEWLY-INTRODUCED CRLF in tracked text blobs (interpreter_eval.rs gained
#      1860 CRLF lines). CRLF in a .spl breaks the indentation-sensitive
#      parser; in a shebang script it breaks exec outright.
#
# Why this is a SIBLING of check-no-new-symlinks-push(.shs), not an extension of
# it: that guard detects the OPPOSITE direction (a range that ADDS a symlink,
# because a jj-managed Windows workspace then cannot check the range out). It
# grandfathers the repo's 93 existing symlinks and carries a recorded escape
# (--expect-new-symlinks) for adding more, since adding one is a legitimate,
# established repo convention. Every one of those properties is wrong here:
# destroying a symlink, pointing one at C:\, and Windows-ifying line endings
# are never legitimate, so this guard has NO escape hatch, and folding two
# opposite-signed predicates into one script would make both verdicts and both
# selftests incoherent.
#
# Usage: check-windows-checkout-damage-push.shs [--scan-only] [rev-range]
#   default range: main@origin..@-   (what a `jj git push --bookmark main` sends)
#   An explicit range MUST contain ".." — a bare rev is rejected.
# Exit 0 = safe to push, 1 = damage found, 2 = could not determine.
#
# --selftest runs first, unconditionally, and is FATAL.

set -u

SELF=check-windows-checkout-damage-push

die() {
    code=$1
    shift
    echo "$SELF: ERROR — $*" >&2
    echo "ERROR — nothing was checked (exit $code)"
    exit "$code"
}

TAB=$(printf '\t')

# ---------------------------------------------------------------------------
# Vendored trees are EXEMT from the CRLF check only: Cargo verifies exact bytes
# of vendored crates, so normalising line endings there breaks the checksum.
# Symlink signatures still apply everywhere.
# ---------------------------------------------------------------------------
is_vendored() {
    case "$1" in
        src/compiler_rust/vendor/*|src/runtime/vendor/*) return 0 ;;
        src/runtime/miniaudio.h|src/runtime/stb_image.h|src/runtime/stb_truetype.h) return 0 ;;
        *) return 1 ;;
    esac
}

# A path whose committed .gitattributes marks it eol=crlf stores LF in the repo
# and is CHECKED OUT as CRLF — such a file is not damaged and must not be
# flagged. `git check-attr --source=<rev>` (git >= 2.40) reads the attributes
# from COMMITTED content, which is what this guard must do; the working tree is
# shared and stale. `bin/simple_lsp_mcp_server.cmd` is the worked example
# (.gitattributes: `*.cmd text eol=crlf`).
attr_allows_crlf() {
    _rev=$1
    _path=$2
    _out=$(git check-attr --source="$_rev" eol -- "$_path" 2>/dev/null)
    _rc=$?
    [ "$_rc" -eq 0 ] || return 1
    case "$_out" in
        *": eol: crlf") return 0 ;;
        *) return 1 ;;
    esac
}

blob_has_crlf() {
    # $1 = blob sha. Writes to a temp file — never into a shell variable, which
    # would eat NUL bytes and mangle binary content.
    git cat-file blob "$1" > "$SCRATCH/blob" 2>/dev/null
    _rc=$?
    [ "$_rc" -eq 0 ] || return 2
    if LC_ALL=C grep -q "$(printf '\r')$" "$SCRATCH/blob" 2>/dev/null; then
        return 0
    fi
    return 1
}

# ---------------------------------------------------------------------------
# The scan. Prints one "<signature>\t<path>" line per offender on fd 3-style
# stdout capture; sets EV_CHECKED via a temp file (a `while read` in a pipeline
# runs in a subshell and cannot export a count).
# ---------------------------------------------------------------------------
scan_range() {
    _base=$1
    _tip=$2
    _raw=$(git diff --raw --no-renames --no-color "$_base" "$_tip" -- 2>/dev/null)
    _rc=$?
    [ "$_rc" -eq 0 ] || return "$_rc"

    # Binary paths, per `git diff --numstat` (which prints "-\t-\tpath").
    _numstat=$(git diff --numstat --no-renames --no-color "$_base" "$_tip" -- 2>/dev/null)
    _rc=$?
    [ "$_rc" -eq 0 ] || return "$_rc"
    printf '%s\n' "$_numstat" | awk -F"$TAB" '$1 == "-" && $2 == "-" {print $3}' > "$SCRATCH/binary"

    : > "$SCRATCH/offenders"
    _checked=0
    printf '%s\n' "$_raw" > "$SCRATCH/raw"
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        meta=${line%%"$TAB"*}
        path=${line#*"$TAB"}
        old_mode=$(printf '%s' "$meta" | awk '{print $1}' | sed 's/^://')
        new_mode=$(printf '%s' "$meta" | awk '{print $2}')
        old_sha=$(printf '%s' "$meta" | awk '{print $3}')
        new_sha=$(printf '%s' "$meta" | awk '{print $4}')
        _checked=$((_checked + 1))

        # --- signature 1: symlink materialized into a regular file ----------
        if [ "$old_mode" = "120000" ] && { [ "$new_mode" = "100644" ] || [ "$new_mode" = "100755" ]; }; then
            printf 'symlink-materialized%s%s\n' "$TAB" "$path" >> "$SCRATCH/offenders"
            continue
        fi

        # --- signature 2: absolute Windows symlink target -------------------
        # Any path that IS a symlink at the tip, whatever the diff status (M
        # keeps mode 120000, A/T land in it) — mode 1 alone cannot see M.
        if [ "$new_mode" = "120000" ]; then
            target=$(git cat-file blob "$new_sha" 2>/dev/null)
            if printf '%s' "$target" | LC_ALL=C grep -Eq '^[A-Za-z]:[\\/]'; then
                printf 'absolute-windows-symlink-target%s%s\n' "$TAB" "$path" >> "$SCRATCH/offenders"
            fi
            continue
        fi

        # --- signature 3: NEWLY-introduced CRLF -----------------------------
        case "$new_mode" in 100644|100755) ;; *) continue ;; esac
        [ "$new_sha" = "0000000000000000000000000000000000000000" ] && continue
        is_vendored "$path" && continue
        grep -Fqx -- "$path" "$SCRATCH/binary" 2>/dev/null && continue
        attr_allows_crlf "$_tip" "$path" && continue
        blob_has_crlf "$new_sha"
        _has=$?
        [ "$_has" -eq 0 ] || continue
        # Grandfather: only NEW CRLF is damage. A file that already had CRLF at
        # the base is out of scope by design.
        if [ "$old_mode" != "000000" ] && [ "$old_sha" != "0000000000000000000000000000000000000000" ]; then
            blob_has_crlf "$old_sha"
            _had=$?
            [ "$_had" -eq 0 ] && continue
        fi
        printf 'new-crlf%s%s\n' "$TAB" "$path" >> "$SCRATCH/offenders"
    done < "$SCRATCH/raw"

    echo "$_checked" > "$SCRATCH/checked"
    return 0
}

# --- selftest ---------------------------------------------------------------
run_selftest() {
    st_dir=$(mktemp -d) || { echo "$SELF: SELFTEST ERROR — mktemp failed" >&2; return 2; }
    st_scratch=$(mktemp -d) || { rm -rf "$st_dir"; return 2; }
    saved_scratch=$SCRATCH
    SCRATCH=$st_scratch

    git init -q "$st_dir" >/dev/null 2>&1 || { rm -rf "$st_dir" "$st_scratch"; return 2; }
    git -C "$st_dir" config user.email selftest@example.com
    git -C "$st_dir" config user.name selftest

    hb() { printf '%s' "$1" | git -C "$st_dir" hash-object -w --stdin; }

    attrs=$(hb '* text=auto eol=lf
*.cmd text eol=crlf
')
    lf_file=$(hb 'alpha
beta
')
    crlf_file=$(printf 'alpha\r\nbeta\r\n' | git -C "$st_dir" hash-object -w --stdin)
    link_rel=$(hb '../../src/app')
    link_abs=$(hb 'C:/Users/ormas/dev/simple/src/app')
    materialized=$(hb '../../src/app')

    # mktree cannot take nested paths, so build trees through a temp index.
    mk_tree() {
        _idx="$st_dir/.selftest-index"
        rm -f "$_idx"
        printf '%s' "$1" > "$SCRATCH/treespec"
        while IFS= read -r _l; do
            [ -n "$_l" ] || continue
            _m=$(printf '%s' "$_l" | awk '{print $1}')
            _s=$(printf '%s' "$_l" | awk '{print $3}')
            _p=${_l#*"$TAB"}
            GIT_INDEX_FILE="$_idx" git -C "$st_dir" update-index --add --cacheinfo "$_m,$_s,$_p" || return 1
        done < "$SCRATCH/treespec"
        GIT_INDEX_FILE="$_idx" git -C "$st_dir" write-tree
    }
    mk_commit() {
        if [ -n "$2" ]; then git -C "$st_dir" commit-tree "$1" -p "$2" -m "$3"
        else git -C "$st_dir" commit-tree "$1" -m "$3"; fi
    }

    base_tree=$(mk_tree "100644 blob $attrs	.gitattributes
100644 blob $lf_file	owned.rs
100644 blob $lf_file	src/compiler_rust/vendor/v.rs
100644 blob $lf_file	tool.cmd
120000 blob $link_rel	linked
")
    C0=$(mk_commit "$base_tree" "" base)

    fails=0; total=0
    # $1 label, $2 base, $3 tip, $4 expected rc (0 pass / 1 fail), $5 expected offender substring ("" = none), $6 expect checked>0 (yes/no)
    check_case() {
        total=$((total + 1))
        ( cd "$st_dir" && GIT_DIR="$st_dir/.git" GIT_WORK_TREE="$st_dir" true )
        _old_pwd=$(pwd)
        cd "$st_dir" || return 2
        scan_range "$2" "$3"
        _src=$?
        cd "$_old_pwd" || return 2
        if [ "$_src" -ne 0 ]; then
            echo "$SELF: SELFTEST FAIL — $1: scan errored ($_src)" >&2
            fails=$((fails + 1)); return 0
        fi
        _n=$(cat "$SCRATCH/checked" 2>/dev/null || echo 0)
        _off=$(cat "$SCRATCH/offenders" 2>/dev/null)
        if [ -n "$_off" ]; then _actual=1; else _actual=0; fi
        if [ "$_actual" != "$4" ]; then
            echo "$SELF: SELFTEST FAIL — $1: expected verdict $4, got $_actual (offenders: $_off)" >&2
            fails=$((fails + 1)); return 0
        fi
        if [ -n "$5" ] && ! printf '%s' "$_off" | grep -Fq "$5"; then
            echo "$SELF: SELFTEST FAIL — $1: offender list missing '$5' (got: $_off)" >&2
            fails=$((fails + 1)); return 0
        fi
        if [ "$6" = yes ] && [ "$_n" -le 0 ]; then
            echo "$SELF: SELFTEST FAIL — $1: expected checked>0, got $_n" >&2
            fails=$((fails + 1)); return 0
        fi
        if [ "$6" = no ] && [ "$_n" -ne 0 ]; then
            echo "$SELF: SELFTEST FAIL — $1: expected 0 checked, got $_n" >&2
            fails=$((fails + 1)); return 0
        fi
    }

    # 1. symlink materialized (120000 -> 100644) must FAIL
    t=$(mk_tree "100644 blob $attrs	.gitattributes
100644 blob $lf_file	owned.rs
100644 blob $lf_file	src/compiler_rust/vendor/v.rs
100644 blob $lf_file	tool.cmd
100644 blob $materialized	linked
")
    C=$(mk_commit "$t" "$C0" materialize)
    check_case "symlink-materialized" "$C0" "$C" 1 "symlink-materialized${TAB}linked" yes

    # 2. absolute C:/ symlink target, mode stays 120000, must FAIL
    t=$(mk_tree "100644 blob $attrs	.gitattributes
100644 blob $lf_file	owned.rs
100644 blob $lf_file	src/compiler_rust/vendor/v.rs
100644 blob $lf_file	tool.cmd
120000 blob $link_abs	linked
")
    C=$(mk_commit "$t" "$C0" absolutise)
    check_case "absolute-windows-symlink-target" "$C0" "$C" 1 "absolute-windows-symlink-target${TAB}linked" yes

    # 3. newly-introduced CRLF in an OWNED file must FAIL
    t=$(mk_tree "100644 blob $attrs	.gitattributes
100644 blob $crlf_file	owned.rs
100644 blob $lf_file	src/compiler_rust/vendor/v.rs
100644 blob $lf_file	tool.cmd
120000 blob $link_rel	linked
")
    C=$(mk_commit "$t" "$C0" crlfify)
    check_case "new-crlf-owned" "$C0" "$C" 1 "new-crlf${TAB}owned.rs" yes

    # 4. CRLF inside a VENDORED path must PASS (exempt — Cargo checksums bytes)
    t=$(mk_tree "100644 blob $attrs	.gitattributes
100644 blob $lf_file	owned.rs
100644 blob $crlf_file	src/compiler_rust/vendor/v.rs
100644 blob $lf_file	tool.cmd
120000 blob $link_rel	linked
")
    C=$(mk_commit "$t" "$C0" vendor-crlf)
    check_case "vendored-crlf-exempt" "$C0" "$C" 0 "" yes

    # 5. a file legitimately marked eol=crlf must PASS
    t=$(mk_tree "100644 blob $attrs	.gitattributes
100644 blob $lf_file	owned.rs
100644 blob $lf_file	src/compiler_rust/vendor/v.rs
100644 blob $crlf_file	tool.cmd
120000 blob $link_rel	linked
")
    C=$(mk_commit "$t" "$C0" cmd-crlf)
    check_case "gitattributes-eol-crlf-exempt" "$C0" "$C" 0 "" yes

    # 6. a clean forward range must PASS
    lf_more=$(hb 'alpha
beta
gamma
')
    t=$(mk_tree "100644 blob $attrs	.gitattributes
100644 blob $lf_more	owned.rs
100644 blob $lf_file	src/compiler_rust/vendor/v.rs
100644 blob $lf_file	tool.cmd
120000 blob $link_rel	linked
")
    C=$(mk_commit "$t" "$C0" clean-forward)
    check_case "clean-forward-range" "$C0" "$C" 0 "" yes

    # 7. an EMPTY range must examine 0 files, so the caller ERRORs
    C=$(mk_commit "$base_tree" "$C0" empty)
    check_case "empty-range-is-vacuous" "$C0" "$C" 0 "" no

    SCRATCH=$saved_scratch
    rm -rf "$st_dir" "$st_scratch"
    if [ "$fails" -ne 0 ]; then
        echo "$SELF: selftest FAILED ($fails/$total fixtures wrong)" >&2
        return 1
    fi
    echo "$SELF: selftest $total/$total fixtures correct"
    return 0
}

SCRATCH=$(mktemp -d) || { echo "$SELF: ERROR — mktemp failed" >&2; echo "ERROR — nothing was checked (exit 2)"; exit 2; }
trap 'rm -rf "$SCRATCH"' EXIT INT TERM

if [ "${1:-}" = "--selftest" ]; then
    run_selftest
    exit $?
fi

run_selftest
selftest_rc=$?
[ "$selftest_rc" -eq 0 ] || die 2 "selftest failed; refusing to trust the real scan"

# --scan-only is accepted for manifest-command parity with the other push
# gates; this guard never mutates anything, so it is already scan-only.
[ "${1:-}" = "--scan-only" ] && shift

range="${1:-}"
explicit=0
[ -n "$range" ] && explicit=1
case "$range" in
    --*) die 2 "unknown option '$range'" ;;
esac

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || toplevel=""
[ -n "$toplevel" ] || die 2 "cwd '$(pwd)' is not inside a git repository."

if [ "$explicit" -eq 0 ]; then
    base=$(jj --ignore-working-copy log -r 'main@origin' --no-graph -T 'commit_id' 2>/dev/null) || base=""
    tip=$(jj --ignore-working-copy log -r '@-' --no-graph -T 'commit_id' 2>/dev/null) || tip=""
    [ -n "$base" ] && [ -n "$tip" ] || die 2 "cannot resolve main@origin..@- via jj. Pass an explicit '<base>..<tip>' range."
    range="$base..$tip"
else
    case "$range" in
        *..*) : ;;
        *) die 2 "explicit range '$range' does not contain '..'. A bare revision means 'all history reachable from it'." ;;
    esac
fi

left=${range%%..*}
right=${range#*..}
right=${right#.}
[ -n "$left" ]  || die 2 "range '$range' has an empty left endpoint"
[ -n "$right" ] || die 2 "range '$range' has an empty right endpoint"
for ep in "$left" "$right"; do
    git rev-parse --verify --quiet "$ep^{commit}" >/dev/null 2>&1 \
        || die 2 "revision '$ep' (from range '$range') does not exist"
done

scan_range "$left" "$right"
scan_rc=$?
[ "$scan_rc" -eq 0 ] || die 2 "git failed while diffing '$range' (exit $scan_rc)"

checked=$(cat "$SCRATCH/checked" 2>/dev/null || echo 0)
case "$checked" in ''|*[!0-9]*) die 2 "could not determine how many paths were examined" ;; esac
[ "$checked" -gt 0 ] || die 2 "range '$range' examined 0 paths"

n_off=$(wc -l < "$SCRATCH/offenders" | tr -d ' ')
if [ "$n_off" -gt 0 ]; then
    echo "$SELF: offenders in $range:" >&2
    sed 's/^/  /' "$SCRATCH/offenders" >&2
    names=$(awk -F"$TAB" '{printf "%s(%s) ", $2, $1}' "$SCRATCH/offenders")
    n_mat=$(awk -F"$TAB" '$1 == "symlink-materialized"' "$SCRATCH/offenders" | wc -l | tr -d ' ')
    n_abs=$(awk -F"$TAB" '$1 == "absolute-windows-symlink-target"' "$SCRATCH/offenders" | wc -l | tr -d ' ')
    n_crlf=$(awk -F"$TAB" '$1 == "new-crlf"' "$SCRATCH/offenders" | wc -l | tr -d ' ')
    echo "FAIL — $checked path(s) checked in $range, $n_off Windows-checkout-damaged ($n_mat materialized symlink(s), $n_abs absolute Windows symlink target(s), $n_crlf newly-CRLF file(s)): $names"
    exit 1
fi
echo "PASS — $checked path(s) checked in $range, 0 Windows-checkout damage (0 materialized symlinks, 0 absolute Windows symlink targets, 0 newly-CRLF files)"
exit 0
