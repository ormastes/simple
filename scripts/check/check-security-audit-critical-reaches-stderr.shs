#!/bin/sh
# check-security-audit-critical-reaches-stderr.shs
#
# Fences src/lib/common/security/audit_log.spl (OPEN 2 of
# doc/08_tracking/bug/logging_surfaces_that_suppress_errors_by_default_family_2026-08-10.md).
#
# AuditConfig.default() sets log_to_stdout: false, so a Critical security event
# -- a privilege escalation, an auth failure -- went ONLY into
# tmp/security_audit.log. Reproduction confirmed the file sink genuinely works
# (entries do land, so the events were not lost), but with the default config a
# Critical event produced ZERO stderr lines in both lanes. A security audit log
# that no human reads by default is the worst instance of the silent-failure
# class.
#
# Error/Critical now reach stderr unconditionally. log_to_stdout keeps its
# meaning for levels BELOW Error.
#
# FOUR-SIDED. A positive-only probe would pass on a "fix" that made
# log_security_event print everything, or one that deleted the severity filter:
#   positive         -- Critical AND Error each produce a LABELLED
#                       "[CRITICAL] ... " / "[ERROR] ... " stderr line under the
#                       DEFAULT config. The label matters: a bare line cannot
#                       tell an operator the severity of what just happened.
#   negative control -- Info under the default config emits ZERO stderr lines.
#                       This is what catches a fix that removed the gate rather
#                       than flooring it at Error.
#   min_severity     -- a config with min_severity: Critical must still suppress
#                       an Error event entirely (both sinks). Proves the
#                       unconditional stderr path did not bypass the existing
#                       severity floor.
#   enabled: false   -- must still suppress a Critical event entirely. Proves
#                       the operator retains a real off switch.
#
# The file sink is asserted alongside, so a regression that traded the file for
# stderr is caught rather than silently accepted.
#
# Verdict line is the last line of stdout:
#   PASS -- <n> assertion(s) checked ...   exit 0
#   FAIL -- ...                            exit 1
#   ERROR -- nothing was checked           exit 2
#
# Usage: sh scripts/check/check-security-audit-critical-reaches-stderr.shs

set -u

REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$REPO_ROOT" || { echo "ERROR -- nothing was checked (cannot cd to repo root)"; exit 2; }

SIMPLE_BIN="./bin/simple"
if [ ! -e "$SIMPLE_BIN" ]; then
    echo "ERROR -- nothing was checked (no $SIMPLE_BIN in $REPO_ROOT)"
    exit 2
fi

WORK=$(mktemp -d) || { echo "ERROR -- nothing was checked (mktemp failed)"; exit 2; }
trap 'rm -rf "$WORK"' EXIT INT TERM

# Keep the fixture's file sink inside the temp dir so the check never writes to
# the repo's tmp/security_audit.log.
LOGFILE="$WORK/audit.log"

FIXTURE="$WORK/security_audit_probe.spl"
cat > "$FIXTURE" <<SPL
# Fixture for check-security-audit-critical-reaches-stderr.shs.
use std.common.security.types.{AuditEntry, AuditConfig, SecuritySeverity, SecurityEvent}
use std.common.security.audit_log.{log_security_event}

fn mk(sev: SecuritySeverity, mark: text) -> AuditEntry:
    AuditEntry(
        event: SecurityEvent.AuthFailure("root", mark),
        correlation_id: "c1",
        module_path: "secaudit",
        severity: sev)

fn main():
    val base = AuditConfig.default()

    # DEFAULT config (log_to_stdout is false) -- the case the bug is about.
    val cfg = AuditConfig(
        enabled: true,
        log_file: "$LOGFILE",
        log_to_stdout: false,
        min_severity: SecuritySeverity.Info,
        mask_secrets: true)
    log_security_event(mk(SecuritySeverity.Critical, "SECMARK_CRITICAL"), cfg)
    log_security_event(mk(SecuritySeverity.Error, "SECMARK_ERROR"), cfg)
    log_security_event(mk(SecuritySeverity.Info, "SECMARK_INFO"), cfg)

    # min_severity floor must still apply.
    val strict = AuditConfig(
        enabled: true,
        log_file: "$LOGFILE",
        log_to_stdout: false,
        min_severity: SecuritySeverity.Critical,
        mask_secrets: true)
    log_security_event(mk(SecuritySeverity.Error, "SECMARK_BELOW_FLOOR"), strict)

    # enabled: false must still be a real off switch.
    val off = AuditConfig(
        enabled: false,
        log_file: "$LOGFILE",
        log_to_stdout: false,
        min_severity: SecuritySeverity.Info,
        mask_secrets: true)
    log_security_event(mk(SecuritySeverity.Critical, "SECMARK_DISABLED"), off)

    # Guard against the default drifting away from the audited shape.
    if base.log_file.len() == 0:
        print "SECMARK_DEFAULT_HAS_NO_FILE"
SPL

FAILURES=0
ASSERTIONS=0

fail() {
    echo "  FAIL: $1"
    FAILURES=$((FAILURES + 1))
}

# Engines diverge in this repo, so check both lanes.
for MODE in interpreter jit; do
    echo "== lane: $MODE =="
    rm -f "$LOGFILE"

    SIMPLE_EXECUTION_MODE="$MODE" timeout 300 "$SIMPLE_BIN" run "$FIXTURE" \
        > "$WORK/out.$MODE" 2> "$WORK/err.$MODE"
    RC=$?
    if [ $RC -ne 0 ]; then
        fail "$MODE: fixture exited $RC (expected 0)"
        ASSERTIONS=$((ASSERTIONS + 1))
        continue
    fi

    E="$WORK/err.$MODE"

    # --- POSITIVE: Critical and Error labelled, on stderr, DEFAULT config ---
    ASSERTIONS=$((ASSERTIONS + 1))
    if ! grep -q '\[CRITICAL\].*SECMARK_CRITICAL' "$E"; then
        fail "$MODE: a Critical security event produced no labelled '[CRITICAL] ...' line on STDERR under the default config -- security events are silently file-only"
    fi

    ASSERTIONS=$((ASSERTIONS + 1))
    if ! grep -q '\[ERROR\].*SECMARK_ERROR' "$E"; then
        fail "$MODE: an Error security event produced no labelled '[ERROR] ...' line on STDERR under the default config"
    fi

    # --- NEGATIVE CONTROL: sub-Error stays quiet ---------------------------
    ASSERTIONS=$((ASSERTIONS + 1))
    N_INFO=$(grep -c 'SECMARK_INFO' "$E")
    if [ "$N_INFO" -ne 0 ]; then
        fail "$MODE: negative control -- an Info event emitted $N_INFO stderr line(s) with log_to_stdout false (below Error must stay gated; the filter looks removed rather than floored)"
    fi

    # --- min_severity floor still honoured ---------------------------------
    ASSERTIONS=$((ASSERTIONS + 1))
    if grep -q 'SECMARK_BELOW_FLOOR' "$E"; then
        fail "$MODE: an Error event below min_severity Critical still reached stderr -- the unconditional path bypassed the severity floor"
    fi
    ASSERTIONS=$((ASSERTIONS + 1))
    if grep -q 'SECMARK_BELOW_FLOOR' "$LOGFILE" 2>/dev/null; then
        fail "$MODE: an Error event below min_severity Critical still reached the log FILE"
    fi

    # --- enabled: false is still a real off switch -------------------------
    ASSERTIONS=$((ASSERTIONS + 1))
    if grep -q 'SECMARK_DISABLED' "$E"; then
        fail "$MODE: enabled:false still emitted a Critical event to stderr -- the operator has no off switch"
    fi

    # --- file sink must NOT have been traded away for stderr ---------------
    ASSERTIONS=$((ASSERTIONS + 1))
    if ! grep -q 'SECMARK_CRITICAL' "$LOGFILE" 2>/dev/null; then
        fail "$MODE: the Critical event is missing from the log FILE -- stderr must be added alongside the file sink, not instead of it"
    fi

    echo "  stderr SECMARK line(s): $(grep -c SECMARK "$E"); file SECMARK line(s): $(grep -c SECMARK "$LOGFILE" 2>/dev/null || echo 0); info=$N_INFO (expect info==0)"
done

if [ "$ASSERTIONS" -eq 0 ]; then
    echo "ERROR -- nothing was checked"
    exit 2
fi

if [ "$FAILURES" -ne 0 ]; then
    echo "FAIL -- $FAILURES of $ASSERTIONS assertion(s) failed across 2 execution lanes"
    exit 1
fi

echo "PASS -- $ASSERTIONS assertion(s) checked across 2 execution lanes (interpreter, jit), including the sub-Error negative control, the min_severity floor, the enabled:false off switch, and the file-sink retention control"
exit 0
