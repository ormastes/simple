#!/bin/sh
# reseal-sdn-crc32.shs
#
# Reseals an SDN data file after a hand edit or merge: strips any legacy
# `#sdn-crc32:` header, writes the ONE empty sidecar `X.<algo>_<hex>.csm` for
# the current content, and deletes every other sidecar (so a MERGED_UNSEALED
# file collapses back to one seal). The algorithm comes from
# config/check/sdn_seal_policy.sdn (default crc32 until xxh3 lands).
#
# Why this exists: src/lib/nogc_sync_mut/database/csm_seal.spl verifies the seal
# fail-CLOSED -- a content/seal mismatch makes the whole file load as nil. The
# hash is over the LF-normalized file (CR dropped), shared with the loader
# through scripts/check/sdn-seal-lib.shs.
#
# Verdict is ALWAYS the last line of stdout:
#   PASS — <file> resealed, <algo>_<hex>         exit 0
#   PASS — <file> already sealed, <algo>_<hex>   exit 0
#   ERROR — nothing was checked                  exit 2
#
# Usage:
#   sh scripts/check/reseal-sdn-crc32.shs [--selftest] <file.sdn>

set -u
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
. "$HERE/sdn-seal-lib.shs"
POLICY="$HERE/../../config/check/sdn_seal_policy.sdn"

selftest() {
    _t=$(mktemp -d) || return 1
    _fails=0
    printf 'bugs |id, status, valid|\n    a, open, true\n' > "$_t/f1.sdn"
    _r=$(csm_seal_file "$_t/f1.sdn" crc32)
    case "$_r" in resealed\ crc32_*) ;; *) echo "selftest FAIL: fresh file not sealed ($_r)"; _fails=$((_fails+1)) ;; esac
    _r=$(csm_seal_file "$_t/f1.sdn" crc32)
    case "$_r" in already\ crc32_*) ;; *) echo "selftest FAIL: not idempotent ($_r)"; _fails=$((_fails+1)) ;; esac

    # legacy header stripped, body preserved byte-for-byte
    printf '#sdn-crc32:1\n#sdn-crc32:2\nbugs |id|\n    a\n' > "$_t/f2.sdn"
    csm_seal_file "$_t/f2.sdn" crc32 >/dev/null
    printf 'bugs |id|\n    a\n' > "$_t/want"
    cmp -s "$_t/want" "$_t/f2.sdn" || { echo "selftest FAIL: legacy header not stripped cleanly"; _fails=$((_fails+1)); }

    # several seals collapse to one
    : > "$_t/f2.crc32_00000001.csm"; : > "$_t/f2.crc32_00000002.csm"
    csm_seal_file "$_t/f2.sdn" crc32 >/dev/null
    [ "$(csm_fs_tags "$_t/f2.sdn" | wc -l | tr -d ' ')" = 1 ] || { echo "selftest FAIL: merged seals not collapsed"; _fails=$((_fails+1)); }

    # CRLF checkout hashes like the LF blob
    printf 'bugs |id|\r\n    a\r\n' > "$_t/f3.sdn"; printf 'bugs |id|\n    a\n' > "$_t/f3lf.sdn"
    [ "$(csm_hash_hex crc32 "$_t/f3.sdn")" = "$(csm_hash_hex crc32 "$_t/f3lf.sdn")" ] || { echo "selftest FAIL: CR not normalized"; _fails=$((_fails+1)); }
    # crc32 known-answer test
    printf '123456789' > "$_t/kat"
    [ "$(csm_hash_hex crc32 "$_t/kat")" = cbf43926 ] || { echo "selftest FAIL: crc32 KAT"; _fails=$((_fails+1)); }

    rm -rf "$_t"
    [ "$_fails" -eq 0 ] || { echo "selftest: $_fails fixture(s) failed"; return 1; }
    echo "selftest: 5 fixtures passed"
}

SELFTEST_ONLY=0
SKIP_SELFTEST=0
FILE=""
while [ $# -gt 0 ]; do
    case "$1" in
        --selftest) SELFTEST_ONLY=1; shift ;;
        --no-selftest) SKIP_SELFTEST=1; shift ;;
        *) FILE="$1"; shift ;;
    esac
done

[ "$SKIP_SELFTEST" -eq 1 ] || selftest || { echo "ERROR — nothing was checked"; exit 2; }
if [ "$SELFTEST_ONLY" -eq 1 ]; then
    echo "PASS — 5 fixture(s) checked, selftest only"
    exit 0
fi
case "$FILE" in *.sdn) ;; *) echo "ERROR — nothing was checked"; exit 2 ;; esac
[ -f "$FILE" ] || { echo "ERROR — nothing was checked"; exit 2; }
ALGO=$(csm_policy_algo "$POLICY" "$FILE")
RES=$(csm_seal_file "$FILE" "$ALGO") || { echo "ERROR — nothing was checked"; exit 2; }
case "$RES" in
    resealed\ *) echo "PASS — $FILE resealed, ${RES#resealed }" ;;
    already\ *)  echo "PASS — $FILE already sealed, ${RES#already }" ;;
    *)           echo "ERROR — nothing was checked"; exit 2 ;;
esac
exit 0
