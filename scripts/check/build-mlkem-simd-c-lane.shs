#!/bin/sh
# build-mlkem-simd-c-lane.shs — build and run the ML-KEM NTT SIMD C lane from
# committed sources only.
#
# Background: this lane's only paired scalar-vs-SIMD timing result previously
# rested on a prebuilt binary with no build script in the tree. A naive
#   cc -O2 -Isrc/runtime -o t <test>.c runtime_simd_dispatch.c
# LINKS CLEANLY and then SEGFAULTS with zero output, because
# runtime_simd_dispatch.h did not declare rt_mlkem_ntt_simd_batch. C defaults
# an undeclared function to `int`, so gcc truncated the returned SplArray*
# to 32 bits (`cltq`) and the first dereference faulted. The declarations now
# live in src/runtime/runtime_simd_dispatch.h and the test includes it.
#
# Scope honesty: the benchmark this runs is a focused NTT-primitive mean
# (the binary prints mlkem_ntt_benchmark_scope=...). It is NOT a full ML-KEM
# speedup and NOT a promotion gate.
#
# Usage:
#   sh scripts/check/build-mlkem-simd-c-lane.shs [iters]
# Env:
#   CC                     compiler (default: cc)
#   MLKEM_SIMD_BENCH_ITERS benchmark iterations (default: 20000, or $1)
#   MLKEM_SIMD_CFLAGS      extra CFLAGS appended
#   MLKEM_SIMD_OUT_DIR     output dir (default: build/check/mlkem-simd-c-lane)

set -e

REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$REPO_ROOT"

CC_BIN="${CC:-cc}"
ITERS="${1:-${MLKEM_SIMD_BENCH_ITERS:-20000}}"
OUT_DIR="${MLKEM_SIMD_OUT_DIR:-build/check/mlkem-simd-c-lane}"

TEST_SOURCE="test/09_baselines/crypto/x25519mlkem768/mlkem_ntt_simd_c_test.c"
RUNTIME_SOURCE="src/runtime/runtime_simd_dispatch.c"

for f in "$TEST_SOURCE" "$RUNTIME_SOURCE" src/runtime/runtime_simd_dispatch.h; do
    if [ ! -f "$f" ]; then
        echo "mlkem_simd_c_lane_reason=missing-source:$f"
        echo "MLKEM_SIMD_C_LANE: FAIL"
        exit 1
    fi
done

mkdir -p "$OUT_DIR"
TEST_OBJ="$OUT_DIR/mlkem_ntt_simd_c_test.o"
RUNTIME_OBJ="$OUT_DIR/runtime_simd_dispatch.o"
TEST_BIN="$OUT_DIR/mlkem_ntt_simd_c_test"
BUILD_LOG="$OUT_DIR/build.log"
RUN_LOG="$OUT_DIR/output.txt"

# Same flags the original ad-hoc build used, plus -Werror on the exact warning
# class that caused the segfault, so the failure mode can never come back.
CFLAGS="-O2 -std=gnu11 -Wall -Wextra -pthread \
-ffunction-sections -fdata-sections \
-Werror=implicit-function-declaration -Werror=int-conversion \
-Isrc/runtime ${MLKEM_SIMD_CFLAGS:-}"

rm -f "$TEST_OBJ" "$RUNTIME_OBJ" "$TEST_BIN" "$BUILD_LOG" "$RUN_LOG"

echo "mlkem_simd_c_lane_cc=$($CC_BIN --version 2>/dev/null | head -1)"
echo "mlkem_simd_c_lane_cflags=$CFLAGS"

build_ok=1
# shellcheck disable=SC2086
$CC_BIN $CFLAGS -c "$RUNTIME_SOURCE" -o "$RUNTIME_OBJ" >>"$BUILD_LOG" 2>&1 || build_ok=0
if [ "$build_ok" -eq 1 ]; then
    # shellcheck disable=SC2086
    $CC_BIN $CFLAGS -c "$TEST_SOURCE" -o "$TEST_OBJ" >>"$BUILD_LOG" 2>&1 || build_ok=0
fi
if [ "$build_ok" -eq 1 ]; then
    # shellcheck disable=SC2086
    $CC_BIN $CFLAGS -Wl,--gc-sections "$RUNTIME_OBJ" "$TEST_OBJ" -o "$TEST_BIN" \
        >>"$BUILD_LOG" 2>&1 || build_ok=0
fi

if [ "$build_ok" -ne 1 ]; then
    sed -n '1,60p' "$BUILD_LOG"
    echo "mlkem_simd_c_lane_reason=compile-failed (see $BUILD_LOG)"
    echo "MLKEM_SIMD_C_LANE: FAIL"
    exit 1
fi

implicit_warnings=$(grep -c 'implicit declaration' "$BUILD_LOG" 2>/dev/null || true)
[ -n "$implicit_warnings" ] || implicit_warnings=0
echo "mlkem_simd_c_lane_implicit_declaration_warnings=$implicit_warnings"
if [ "$implicit_warnings" -ne 0 ]; then
    echo "mlkem_simd_c_lane_reason=implicit-declarations-present"
    echo "MLKEM_SIMD_C_LANE: FAIL"
    exit 1
fi

# Take $? from the binary itself, never from a pipe. `set -e` must be
# suspended here: a bare command's nonzero exit under `set -e` aborts the
# script on the spot, before `run_rc=$?` runs — every FAIL branch below
# would be dead code and the script would exit silently with no verdict
# line at all. Confirmed 2026-08-08: this masked a real NTT correctness
# mismatch as a silent exit-2 with zero diagnostic output.
set +e
MLKEM_SIMD_BENCH_ITERS="$ITERS" "$TEST_BIN" >"$RUN_LOG" 2>&1
run_rc=$?
set -e

cat "$RUN_LOG"
echo "mlkem_simd_c_lane_bench_iters=$ITERS"
echo "mlkem_simd_c_lane_exit_code=$run_rc"

if [ "$run_rc" -eq 77 ]; then
    echo "mlkem_simd_c_lane_reason=no-simd-backend-on-this-host"
    echo "MLKEM_SIMD_C_LANE: SKIP"
    exit 0
fi

if [ "$run_rc" -ne 0 ]; then
    echo "mlkem_simd_c_lane_reason=test-exited-$run_rc"
    echo "MLKEM_SIMD_C_LANE: FAIL"
    exit 1
fi

if ! grep -q 'MLKEM_NTT_SIMD_C_TEST: PASS' "$RUN_LOG"; then
    echo "mlkem_simd_c_lane_reason=missing-pass-line"
    echo "MLKEM_SIMD_C_LANE: FAIL"
    exit 1
fi

backend=$(grep '^mlkem_ntt_simd_backend=' "$RUN_LOG" | head -1 | cut -d= -f2)
if [ "${backend:-0}" = "0" ]; then
    echo "mlkem_simd_c_lane_reason=backend-0"
    echo "MLKEM_SIMD_C_LANE: FAIL"
    exit 1
fi

echo "MLKEM_SIMD_C_LANE: PASS backend=$backend iters=$ITERS bin=$TEST_BIN"
exit 0
