#!/bin/sh
# check-spec-vacuity.shs
#
# BASELINE-RATCHETED gate for two of the four vacuous-spec families this repo
# keeps rediscovering by hand (see the censuses this gate is built from):
#   doc/08_tracking/bug/vacuous_spec_census_2026-07-30.md
#   doc/08_tracking/bug/vacuous_spec_corpus_census_and_inert_assertion_forms_2026-08-02.md
#   doc/08_tracking/bug/census_spec_vacuity_comment_detection_false_positives_2026-08-10.md
#
# FAMILIES IMPLEMENTED (mechanically detectable, high precision)
#   F1 EXPECT_TAIL  -- `expect(<subject>)` with NO chained `.matcher(...)` call
#                      and the subject is not itself a boolean expression. A
#                      bare `expect(x)` on a non-bool subject asserts nothing
#                      but truthiness of a reference, which is trivially true.
#                      (The spec-DSL runtime now rejects this at RUN time --
#                      62c075bbe3cf -- but that requires executing the whole
#                      suite; this gate catches it statically, pre-push, file
#                      by file, without running anything.)
#   F2 PENDING_STUB -- the `pending_reason` skip-placeholder shape from the
#                      2026-07-30 census: a spec whose only live assertion is
#                      `expect(<reason var>.len()).to_be_greater_than(0)`
#                      guarded by an `it "skipped"`/`it "pending"` name, with
#                      the real body commented out. Trivially true by
#                      construction (905 files, the single largest known
#                      cluster). Exact-string match, zero ambiguity.
#
# FAMILIES DELIBERATELY NOT IMPLEMENTED HERE
#   Family "needle matches only a COMMENT" (general form) and families 3/4
#   (value-type copy mutation, spec-reimplements-subject) are SEMANTIC: they
#   require classifying comments per source-language (C vs shell vs .spl),
#   pairing a needle to the RIGHT referenced file out of several, and reading
#   value-type vs class semantics. A prior naive detector for exactly this got
#   corrected three times (D-S1/D-S2/D-S3, 2026-08-10 doc above) and even the
#   corrected version takes ~1,685s over the full corpus -- too slow for a
#   pre-push gate. That work already exists and is landed as family 5 (HOLLOW)
#   plus families 3/4 in `scripts/check/census-spec-vacuity.spl`; this gate
#   does not duplicate it. Run that script by hand for a full semantic census.
#
# NON-VACUITY / FAIL-CLOSED CONTRACT
#   * --selftest runs BEFORE every scan and is FATAL. Fixtures:
#       - one genuinely vacuous spec (bare `expect(x)`, no matcher)  -> MUST FAIL
#       - one genuinely vacuous spec (pending_reason placeholder)    -> MUST FAIL
#       - one sound spec (chained matchers, bare bool expect, multi-
#         line chained matcher)                                      -> MUST PASS
#       - two near-miss shapes analogous to the 2026-08-10 false-positive
#         class for THIS detector's own families (bare boolean expect;
#         matcher chained on a continuation line)                     -> MUST NOT FLAG
#   * A run that scans ZERO specs is an ERROR (exit 2), never a pass.
#   * BASELINE-RATCHETED: known-vacuous specs are recorded in
#     scripts/check/spec_vacuity_baseline.txt as `path<TAB>family` pairs (file
#     granularity, not line-granularity -- line numbers drift). The gate FAILs
#     only on a NEW (path, family) pair not in the baseline, and also FAILs
#     when a baselined pair is no longer reproduced (stale baseline, forces
#     deliberate shrink-only maintenance). Regenerate with --generate-baseline
#     only after reading the diff.
#   * Verdict line is ALWAYS the last line of stdout:
#       PASS  -- <n> spec(s) checked, 0 new vacuous finding(s)          exit 0
#       FAIL  -- <n> spec(s) checked, <m> new vacuous finding(s)        exit 1
#       ERROR -- nothing was checked                                   exit 2
#
# Usage:
#   sh scripts/check/check-spec-vacuity.shs [--selftest-only] [ROOT...]
#   sh scripts/check/check-spec-vacuity.shs --generate-baseline [ROOT...]

set -u

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "ERROR -- nothing was checked"
  exit 2
}
cd "$REPO" || { echo "ERROR -- nothing was checked"; exit 2; }

BASELINE="scripts/check/spec_vacuity_baseline.txt"
[ -f "$BASELINE" ] || : > "$BASELINE"

WORK=$(mktemp -d) || { echo "ERROR -- nothing was checked"; exit 2; }
trap 'rm -rf "$WORK"' EXIT INT TERM

AWK_SCAN="$WORK/scan.awk"
cat > "$AWK_SCAN" <<'AWKEOF'
# Blank the contents of double-quoted string literals so parens/keywords
# inside string text never confuse the scanner. Preserves length/quotes.
function strip_strings(s,    out, i, c, in_str, n) {
    out = ""; in_str = 0; n = length(s)
    for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (c == "\"") { in_str = !in_str; out = out c; continue }
        out = out (in_str ? "X" : c)
    }
    return out
}

function ltrim(s) { sub(/^[ \t]+/, "", s); return s }

function is_bool_subject(s) {
    # a comparison / logical expression is a REAL assertion of truthiness,
    # not a vacuous reference check -- exclude it.
    if (s ~ /==|!=|<=|>=|[<>]| and | or | not |^not |^!|^(true|false)$/) return 1
    return 0
}

# find_close(s, start) -> index of the ")" matching the "(" at index start,
# or -1 if unbalanced on this line.
function find_close(s, start,    depth, i, c, n) {
    depth = 0; n = length(s)
    for (i = start; i <= n; i++) {
        c = substr(s, i, 1)
        if (c == "(") depth++
        else if (c == ")") { depth--; if (depth == 0) return i }
    }
    return -1
}

FNR == 1 { pend_reason = 0; pend_skip = 0 }

{
    raw = $0
    trimmed = ltrim(raw)
    if (trimmed ~ /^#/) next   # whole-line comment in .spl/.shs/.sh -- skip

    stripped = strip_strings(raw)

    # ---- F2: pending_reason skip-placeholder (exact-string, zero ambiguity)
    if (raw ~ /pending_reason/) pend_reason = 1
    if (raw ~ /it[ \t]*"(skipped|pending)"/) pend_skip = 1

    # ---- F1: expect(...) with no chained matcher, non-bool subject
    # (only the first expect() per line is examined -- precision over recall;
    # a second expect() on the same line is rare in this corpus)
    if (match(stripped, /expect\(/)) {
        open_idx = RSTART + RLENGTH - 1
        close_idx = find_close(stripped, open_idx)
        if (close_idx != -1) {   # multi-line call: not handled statically, skip
            subject = substr(stripped, open_idx + 1, close_idx - open_idx - 1)
            rtrim_rest = substr(stripped, close_idx + 1)
            gsub(/^[ \t;,]+/, "", rtrim_rest)
            chained = (rtrim_rest ~ /^\.[A-Za-z_][A-Za-z0-9_]*[ \t]*\(/)
            if (!chained && rtrim_rest == "" && !is_bool_subject(ltrim(subject))) {
                # matcher may be chained on the NEXT non-blank line -- peek ahead
                save_fnr = FNR
                if ((getline nxt) > 0) {
                    nxt_t = ltrim(nxt)
                    if (nxt_t !~ /^\.[A-Za-z_][A-Za-z0-9_]*[ \t]*\(/)
                        printf "F1_EXPECT_TAIL\t%s\t%d\n", FILENAME, save_fnr
                    # the peeked line still needs its own F2 scan
                    trimmed2 = ltrim(nxt)
                    if (trimmed2 !~ /^#/) {
                        if (nxt ~ /pending_reason/) pend_reason = 1
                        if (nxt ~ /it[ \t]*"(skipped|pending)"/) pend_skip = 1
                    }
                } else {
                    printf "F1_EXPECT_TAIL\t%s\t%d\n", FILENAME, save_fnr
                }
            }
        }
    }
}

ENDFILE {
    if (pend_reason && pend_skip)
        printf "F2_PENDING_STUB\t%s\t0\n", FILENAME
}
AWKEOF

# scan <list-file> <out-file> -> echoes n specs scanned
scan() {
  _list="$1"; _out="$2"
  : > "$_out"
  _n=0
  while IFS= read -r spec; do
    [ -f "$spec" ] || continue
    _n=$((_n + 1))
    awk -f "$AWK_SCAN" "$spec" >> "$_out" 2>/dev/null
  done < "$_list"
  echo "$_n"
}

# ---------------------------------------------------------------------------
# SELFTEST (fatal, runs before every scan)
# ---------------------------------------------------------------------------
selftest() {
  st="$WORK/st"; mkdir -p "$st"

  cat > "$st/vac_expect_spec.spl" <<'EOF'
describe "positive control: bare expect":
    it "asserts nothing":
        val x = build_thing()
        expect(x)
EOF

  cat > "$st/vac_pending_spec.spl" <<'EOF'
describe "positive control: pending stub":
    it "skipped":
        val pending_reason = "pre-existing test failures"
        expect(pending_reason.len()).to_be_greater_than(0)
EOF

  cat > "$st/sound_spec.spl" <<'EOF'
describe "negative control: sound assertions":
    it "chains a real matcher":
        val x = build_thing()
        expect(x).to_equal(5)
    it "asserts a bare boolean":
        val a = 1
        val b = 1
        expect(a == b)
    it "chains a matcher on the next line":
        val x = build_thing()
        expect(x)
            .to_equal(5)
EOF

  # Near-miss shapes analogous to the 2026-08-10 false-positive class, scoped
  # to THIS detector's own two families:
  cat > "$st/fp_bool_expect_spec.spl" <<'EOF'
describe "false-positive control: bare boolean expect":
    it "is a real truthiness assertion":
        expect(1 == 1)
    it "is a real truthiness assertion with not":
        expect(not false)
EOF

  cat > "$st/fp_chain_next_line_spec.spl" <<'EOF'
describe "false-positive control: matcher chained on continuation":
    it "chains to_contain on the next line":
        val items = build_list()
        expect(items)
            .to_contain(3)
EOF

  echo "$st/vac_expect_spec.spl" > "$st/vac_expect.list"
  echo "$st/vac_pending_spec.spl" > "$st/vac_pending.list"
  echo "$st/sound_spec.spl" > "$st/sound.list"
  echo "$st/fp_bool_expect_spec.spl" > "$st/fp_bool.list"
  echo "$st/fp_chain_next_line_spec.spl" > "$st/fp_chain.list"

  scan "$st/vac_expect.list" "$st/vac_expect.hits" > /dev/null
  scan "$st/vac_pending.list" "$st/vac_pending.hits" > /dev/null
  scan "$st/sound.list" "$st/sound.hits" > /dev/null
  scan "$st/fp_bool.list" "$st/fp_bool.hits" > /dev/null
  scan "$st/fp_chain.list" "$st/fp_chain.hits" > /dev/null

  ok=1
  grep -q '^F1_EXPECT_TAIL' "$st/vac_expect.hits" 2>/dev/null || { echo "selftest: FAILED -- bare expect(x) was NOT flagged (F1 is vacuous)"; ok=0; }
  grep -q '^F2_PENDING_STUB' "$st/vac_pending.hits" 2>/dev/null || { echo "selftest: FAILED -- pending_reason stub was NOT flagged (F2 is vacuous)"; ok=0; }
  [ -s "$st/sound.hits" ] && { echo "selftest: FAILED -- sound spec was flagged (false positive): $(cat "$st/sound.hits")"; ok=0; }
  [ -s "$st/fp_bool.hits" ] && { echo "selftest: FAILED -- bare boolean expect was flagged (false positive)"; ok=0; }
  [ -s "$st/fp_chain.hits" ] && { echo "selftest: FAILED -- next-line-chained matcher was flagged (false positive)"; ok=0; }
  [ "$ok" = "1" ] || return 1
  echo "selftest: OK -- 2 positive controls flagged (F1, F2), sound spec silent, 2 false-positive-shape controls silent"
  return 0
}

if ! selftest; then
  echo "ERROR -- nothing was checked"
  exit 2
fi

case "${1:-}" in
  --selftest-only)
    echo "PASS -- selftest only, 5 controls checked"
    exit 0
    ;;
  --generate-baseline)
    shift
    ROOTS="$*"; [ -n "$ROOTS" ] || ROOTS="test"
    find $ROOTS -name '*_spec.spl' -type f 2>/dev/null | sort > "$WORK/specs.list"
    N=$(scan "$WORK/specs.list" "$WORK/hits.txt")
    if [ -z "$N" ] || [ "$N" -eq 0 ] 2>/dev/null; then
      echo "ERROR -- nothing was checked"
      exit 2
    fi
    awk -F'\t' '{ print $2 "\t" $1 }' "$WORK/hits.txt" | sort -u > "$BASELINE"
    echo "generated baseline: $(wc -l < "$BASELINE" | tr -d ' ') entries from $N specs"
    exit 0
    ;;
esac

ROOTS="$*"
[ -n "$ROOTS" ] || ROOTS="test"
find $ROOTS -name '*_spec.spl' -type f 2>/dev/null | sort > "$WORK/specs.list"
if [ ! -s "$WORK/specs.list" ]; then
  echo "ERROR -- nothing was checked"
  exit 2
fi

N=$(scan "$WORK/specs.list" "$WORK/hits.txt")
if [ -z "$N" ] || [ "$N" -eq 0 ] 2>/dev/null; then
  echo "ERROR -- nothing was checked"
  exit 2
fi

# hits.txt: FAMILY \t path \t line   -> current set as (family, path) pairs
awk -F'\t' '{ print $1 "\t" $2 }' "$WORK/hits.txt" | sort -u > "$WORK/current.txt"
sort -u "$BASELINE" > "$WORK/baseline.txt"

# NEW findings: in current, not in baseline (note baseline column order is
# path<TAB>family; current is family<TAB>path -- normalize both to the same
# order before diffing)
awk -F'\t' '{ print $2 "\t" $1 }' "$WORK/baseline.txt" | sort -u > "$WORK/baseline_norm.txt"
comm -23 "$WORK/current.txt" "$WORK/baseline_norm.txt" > "$WORK/new.txt"
# STALE baseline entries: baselined but no longer reproduced
comm -13 "$WORK/current.txt" "$WORK/baseline_norm.txt" > "$WORK/stale.txt"

NEW_N=$(wc -l < "$WORK/new.txt" | tr -d ' ')
STALE_N=$(wc -l < "$WORK/stale.txt" | tr -d ' ')

if [ "$NEW_N" -gt 0 ]; then
  echo "--- NEW vacuous findings (not in baseline) ---"
  sed 's/^/  /' "$WORK/new.txt"
fi
if [ "$STALE_N" -gt 0 ]; then
  echo "--- STALE baseline entries (no longer reproduced -- shrink the baseline) ---"
  sed 's/^/  /' "$WORK/stale.txt"
fi

if [ "$NEW_N" -gt 0 ] || [ "$STALE_N" -gt 0 ]; then
  echo "FAIL -- $N spec(s) checked, $NEW_N new vacuous finding(s), $STALE_N stale baseline entry(ies)"
  exit 1
fi

echo "PASS -- $N spec(s) checked, 0 new vacuous finding(s)"
exit 0
