#!/bin/sh
# Compile the actual generated C header with the Windows MSVC-ABI LLVM lane.
set -eu
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) ;; *) echo 'SKIP: Windows-only C header check'; exit 0 ;; esac

repo_root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
. "$repo_root/scripts/setup/windows-msvc-bootstrap-env.shs"
simple_bin=${SIMPLE_BIN:-$repo_root/bin/simple}
llvm_bin=${LLVM_SYS_231_PREFIX:-/c/dev/tool/clang+llvm-23.1.1-x86_64-pc-windows-msvc}/bin
clang_cl="$llvm_bin/clang-cl.exe"
"$clang_cl" --version | grep -F 'version 23.1.1' >/dev/null || {
    echo 'FAIL: expected LLVM clang-cl 23.1.1' >&2; exit 1;
}
case "$clang_cl" in *clang-cl.exe) ;; *) echo 'FAIL: compiler is not clang-cl' >&2; exit 1 ;; esac

probe_dir=$(mktemp -d)
trap 'rm -rf -- "$probe_dir"' EXIT HUP INT TERM
if ! "$simple_bin" run "$repo_root/test/01_unit/compiler/tools/c_header_c_mode_emit.spl" \
        >"$probe_dir/c_mode_probe.h" 2>"$probe_dir/emitter.log"; then
    cat "$probe_dir/emitter.log" >&2
    echo 'FAIL: C header emitter failed' >&2
    exit 1
fi
grep -F '/* Generated by Simple compiler' "$probe_dir/c_mode_probe.h" >/dev/null || {
    cat "$probe_dir/emitter.log" >&2
    echo 'FAIL: C header emitter did not produce a header' >&2
    exit 1
}
grep -E 'int64_t.*probe_scalar|probe_scalar.*int64_t' \
    "$probe_dir/c_mode_probe.h" >/dev/null || {
    echo 'FAIL: emitted C header lacks the mapped scalar API' >&2
    exit 1
}
printf '#include "c_mode_probe.h"\nint main(void) { return 0; }\n' >"$probe_dir/probe.c"
MSYS2_ARG_CONV_EXCL='*' "$clang_cl" /nologo /TC /Zs \
    "$(cygpath -m "$probe_dir/probe.c")"
echo 'PASS: generated header compiles as C with LLVM clang-cl 23.1.1'
