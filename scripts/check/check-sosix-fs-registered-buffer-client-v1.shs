#!/bin/sh
set -eu

source_file=src/os/sosix/fs/registered_buffer_client_v1.spl
spec_file=test/01_unit/os/sosix/fs_registered_buffer_client_v1_spec.spl
manual_file=doc/06_spec/01_unit/os/sosix/fs_registered_buffer_client_v1_spec.md

test -f "$source_file"
test -f "$spec_file"
test -f "$manual_file"
grep -q 'sosix_fs_client_plan_registered_v1' "$source_file"
grep -q 'syscall(' "$source_file"
grep -q '132,' "$source_file"
grep -q 'plan.payload.ptr() as u64' "$source_file"
grep -q 'service-registration-unconfirmed' "$source_file"
grep -q 'buffer-access-denied' "$source_file"
! grep -Eq 'syscall\(133|NOTIFICATION_WAIT|recv_owned|pass_todo|expect\(true\)\.to_equal\(true\)' "$source_file" "$spec_file"
! grep -Eq 'raw_buffer_address|unsafe_addr_of' "$source_file"
grep -q 'no receive or blocking wait occurs' "$manual_file"
printf '%s\n' 'PASS: SOSIX FS registered-buffer client v1 static contract'
