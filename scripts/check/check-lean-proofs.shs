#!/bin/sh
set -eu

# Lean Proof Integrity Check
#
# Usage:
#   sh scripts/check/check-lean-proofs.shs
#   sh scripts/check/check-lean-proofs.shs --self-test
#   sh scripts/check/check-lean-proofs.shs --project <lake-project-dir> [label]
#
# Iterates all Lake projects under src/verification/ and the std proofs
# project under src/compiler_rust/lib/std/src/, runs `lake build` in each,
# greps sources for Lean proof-trust bypasses (excluding comments),
# exits nonzero on any failure, and prints a per-project PASS/FAIL table.
#
# Env knobs:
#   LAKE_BIN    lake binary (default: auto-detected via elan or PATH)
#   BUILD_TIMEOUT  seconds before a build is killed as TIMEOUT (default: 300)

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

BUILD_TIMEOUT="${BUILD_TIMEOUT:-300}"
TRUST_RE='(^|[^A-Za-z0-9_])(sorry|admit)($|[^A-Za-z0-9_])|^[[:space:]]*((private|protected|noncomputable|partial)[[:space:]]+)*(axiom|constant|opaque|unsafe|set_option[[:space:]]+autoImplicit[[:space:]]+true|set_option[[:space:]]+maxHeartbeats[[:space:]]+0)\b'

pass()  { printf '  PASS  %s\n' "$1"; }
fail()  { printf '  FAIL  %s  --  %s\n' "$1" "$2"; }
info()  { printf '  ...   %s\n' "$1"; }

OVERALL=0
# Counted only for projects that reached the trust scan. check_project returns
# early on a missing lakefile, a build failure, a timeout or a zero-.lean-file
# tree WITHOUT incrementing these, so a FAIL verdict can legitimately read
# "0 project(s), 0 .lean file(s) checked" while a project was in fact attempted.
# That is only ever on a FAIL/ERROR path, so it cannot be mistaken for a pass --
# the per-project `FAIL <label> -- <reason>` line above it names what happened.
PROJECTS_CHECKED=0
LEAN_FILES_CHECKED=0

# Strip Lean comments before the trust grep.
#
# WHY AN AWK STATE MACHINE AND NOT `sed 's/--.*//'`
# -------------------------------------------------
# The old stripper removed only `--` LINE comments. Lean's block comments
# (`/- ... -/`) and docstrings (`/-- ... -/`) survived it, so every module
# docstring that says "a sorry-free proof of ..." was counted as a proof-trust
# BYPASS. An ad-hoc prose allowlist (`without sorry` / `no sorry` / `zero
# sorry`) papered over some phrasings and missed others: on 2026-08-06 the tree
# had 21 such hits, ALL of them prose in `/- -/` docstrings, of which 11 said
# "sorry-free" and were therefore NOT allowlisted. That falsely failed
# verification/kernel_capabilities (1 hit) and verification/os_enforcement (8),
# and the header contract "excluding comments" was simply untrue.
#
# The fix is to make "outside comments" mean what it says. This does not relax
# the detector: a real `sorry`/`axiom`/`unsafe` outside a comment is still
# counted, including one that follows a closed block comment on the SAME line
# (fixture `afterComment` in --self-test).
#
# Nesting: Lean block comments nest, and depth is counted here, so `/- /- -/ -/`
# closes correctly. Note the scanner is not string-literal aware -- a `--` or
# `/-` inside a Lean string literal would be treated as a comment opener. No
# such literal exists in the verification tree; if one appears, the symptom is a
# MISSED hit, so extend this rather than trusting it blindly.
#
# Depth is reset at FNR==1 so an unterminated block comment in one file cannot
# swallow the next file's code (that would be a fail-open).
strip_lean_comments() {
    awk '
    FNR == 1 { depth = 0 }
    {
        line = $0; out = ""; i = 1; n = length(line)
        while (i <= n) {
            two = substr(line, i, 2)
            if (depth > 0) {
                if (two == "/-") { depth++; i += 2; continue }
                if (two == "-/") { depth--; i += 2; continue }
                i++; continue
            }
            if (two == "/-") { depth++; i += 2; continue }
            if (two == "--") { break }
            out = out substr(line, i, 1); i++
        }
        print out
    }' "$@"
}

count_trust_hits() {
    proj_dir="$1"
    _files=$(find "$proj_dir" -name '*.lean' -not -path '*/.lake/*' 2>/dev/null)
    if [ -z "$_files" ]; then
        echo 0
        return
    fi
    # Newline-split the file list. Verification paths are space-free; a path with
    # a space would split and awk would report it as missing, which fails LOUD.
    _oifs=$IFS
    IFS='
'
    # shellcheck disable=SC2086
    set -- $_files
    IFS=$_oifs
    strip_lean_comments "$@" \
        | grep -Eh "$TRUST_RE" \
        | grep -cv 'without .sorry.\|zero sorry\|no sorry\|No sorry' || true
}

# Number of .lean files a project scan actually looked at. A project with zero
# .lean files used to score trust_hits=0 and PASS -- a vacuous pass that is
# indistinguishable from a clean one. check_project now refuses it.
count_lean_files() {
    find "$1" -name '*.lean' -not -path '*/.lake/*' 2>/dev/null | grep -c . || true
}

if [ "${1:-}" = "--self-test" ]; then
    tmp="${TMPDIR:-/tmp}/lean-proof-check-selftest.$$"
    rm -rf "$tmp"
    mkdir -p "$tmp"
    {
        echo 'theorem ok : True := by'
        echo '  exact True.intro'
        echo 'theorem badSorry : True := by'
        echo '  exact (by sorry)'
        echo 'theorem badAdmit : True := by'
        echo '  exact admit,'
        echo 'axiom trustedFact : True'
        echo 'private axiom privateTrustedFact : True'
        echo 'private unsafe def unsafeTrustedFact : True := True.intro'
        echo '-- sorry in a comment is ignored'
        # Block-comment fixtures (added 2026-08-06). Before these existed the
        # stripper handled only `--`, so every `/- ... -/` docstring saying
        # "sorry-free" scored as a trust bypass. Each fixture below is the ONLY
        # one exercising its branch: delete one and the expected count moves.
        echo '/- sorry inside a one-line block comment is ignored -/'
        echo '/-'
        echo '  a multi-line block comment mentioning sorry and admit'
        echo '  and even an axiom line is ignored'
        echo '-/'
        echo '/-- docstring: a sorry-free proof of the invariant -/'
        echo '/- /- nested -/ sorry still inside the outer comment -/'
        # ...but a real bypass AFTER a closed block comment on the same line
        # must still count. This is the fixture that proves the stripper did not
        # simply become "ignore any line containing /-".
        echo '/- lead-in -/ axiom afterComment : True'
    } >"$tmp/SelfTest.lean"
    # A SECOND file proves depth is reset per file: this unterminated block
    # comment must not swallow the trust hit in a following file.
    printf '/- unterminated block comment\n' >"$tmp/AUnterminated.lean"
    printf 'axiom notSwallowed : True\n' >"$tmp/BAfterUnterminated.lean"
    hits="$(count_trust_hits "$tmp")"
    files="$(count_lean_files "$tmp")"
    rm -rf "$tmp"
    # 5 line-level bypasses + afterComment + notSwallowed = 7.
    if [ "$hits" = 7 ] && [ "$files" = 3 ]; then
        echo "STATUS: PASS lean-proof-check self-test (7/7 trust fixtures detected, 3 files scanned)"
        exit 0
    fi
    echo "STATUS: FAIL lean-proof-check self-test expected hits=7 files=3, actual hits=$hits files=$files" >&2
    exit 1
fi

# Detect lake binary
if [ -n "${LAKE_BIN:-}" ]; then
    LAKE="$LAKE_BIN"
elif [ -x "$HOME/.elan/bin/lake" ]; then
    LAKE="$HOME/.elan/bin/lake"
elif command -v lake >/dev/null 2>&1; then
    LAKE="lake"
else
    printf 'error: lake not found; install via elan or set LAKE_BIN\n' >&2
    exit 1
fi

# Check a single lake project directory.
# Prints PASS, FAIL, or TIMEOUT and sets OVERALL=1 on any non-pass result.
check_project() {
    proj_dir="$1"
    label="$2"

    if [ ! -f "$proj_dir/lakefile.toml" ] && [ ! -f "$proj_dir/lakefile.lean" ]; then
        fail "$label" "no lakefile found"
        OVERALL=1
        return
    fi

    info "building $label"
    build_out=$(cd "$proj_dir" && timeout "$BUILD_TIMEOUT" "$LAKE" build 2>&1) && build_rc=0 || build_rc=$?

    if [ "$build_rc" -eq 124 ]; then
        fail "$label" "TIMEOUT (>${BUILD_TIMEOUT}s)"
        OVERALL=1
        return
    fi

    if [ "$build_rc" -ne 0 ]; then
        first_err=$(printf '%s' "$build_out" | grep -m1 'error:' || true)
        fail "$label" "${first_err:-build exited $build_rc}"
        OVERALL=1
        return
    fi

    # Grep for real proof-trust bypasses: whole project tree (srcDir varies per
    # project), excluding the .lake build dir, comment lines, and doc-text
    # mentions like "without sorry".
    lean_files=$(count_lean_files "$proj_dir")
    if [ "${lean_files:-0}" -lt 1 ]; then
        # Zero .lean files scores zero trust hits and used to PASS. A scan that
        # looked at nothing is not a clean scan.
        fail "$label" "ERROR — nothing was checked: 0 .lean file(s) found under $proj_dir"
        OVERALL=1
        return
    fi
    trust_hits=$(count_trust_hits "$proj_dir")
    PROJECTS_CHECKED=$((PROJECTS_CHECKED + 1))
    LEAN_FILES_CHECKED=$((LEAN_FILES_CHECKED + lean_files))

    if [ "${trust_hits:-0}" -gt 0 ]; then
        fail "$label" "contains $trust_hits proof trust bypass(es) outside comments ($lean_files .lean file(s) scanned)"
        OVERALL=1
        return
    fi

    pass "$label ($lean_files .lean file(s) scanned, 0 trust bypass(es))"
}

if [ "${1:-}" = "--project" ]; then
    test -n "${2:-}" || {
        echo "usage: sh scripts/check/check-lean-proofs.shs --project <lake-project-dir> [label]" >&2
        exit 2
    }
    check_project "$2" "${3:-$2}"
    if [ "$OVERALL" -eq 0 ]; then
        echo "STATUS: PASS lean-proof-check project — $PROJECTS_CHECKED project(s), $LEAN_FILES_CHECKED .lean file(s) checked"
        exit 0
    fi
    echo "STATUS: FAIL lean-proof-check project — $PROJECTS_CHECKED project(s), $LEAN_FILES_CHECKED .lean file(s) checked" >&2
    exit 1
fi

printf '\n=== Lean Proof Integrity Check ===\n\n'

# Verification sub-projects: auto-discover every Lake project under
# src/verification (any depth) so newly added models are never silently
# skipped by a stale hardcoded list.
VDIR="$ROOT_DIR/src/verification"
for lakefile in $(find "$VDIR" -maxdepth 3 \( -name 'lakefile.toml' -o -name 'lakefile.lean' \) -not -path '*/.lake/*' | sort); do
    proj_dir="$(dirname "$lakefile")"
    label="verification/${proj_dir#$VDIR/}"
    check_project "$proj_dir" "$label"
done

# L3 std proofs project
check_project "$ROOT_DIR/src/compiler_rust/lib/std/src" "compiler_rust/lib/std"

printf '\n'
if [ "$PROJECTS_CHECKED" -lt 1 ]; then
    printf 'lean-proof-check: ERROR — nothing was checked: 0 Lake project(s) reached\n' >&2
    exit 2
fi
if [ "$OVERALL" -eq 0 ]; then
    printf 'lean-proof-check: PASS — %s project(s), %s .lean file(s) checked\n' \
        "$PROJECTS_CHECKED" "$LEAN_FILES_CHECKED"
    exit 0
else
    printf 'lean-proof-check: FAIL — %s project(s), %s .lean file(s) checked\n' \
        "$PROJECTS_CHECKED" "$LEAN_FILES_CHECKED" >&2
    exit 1
fi
