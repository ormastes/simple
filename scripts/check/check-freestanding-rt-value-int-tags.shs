#!/bin/sh
# check-freestanding-rt-value-int-tags.shs
#
# Reproduce guard for
# doc/08_tracking/bug/freestanding_riscv64_for_in_array_yields_nil_after_first_element_2026-08-31.md
#
# WHAT IT PINS. Every freestanding/baremetal C definition of `rt_value_int` must
# TAG its argument (TAG_INT encode, i.e. `<< 3` or `ENCODE_INT`). A definition
# that returns its argument verbatim is the defect this guard exists to catch:
# cranelift lowers `MirInst::BoxInt` to `call rt_value_int`, and the freestanding
# `rt_index_get` (baremetal_stubs.c) opens with
# `if (!IS_INT(index)) return NIL_VALUE;`. An identity `rt_value_int` therefore
# hands rt_index_get a RAW index:
#
#   raw 0    -> 0 & 7 == 0 -> IS_INT true  -> element 0, CORRECT
#   raw 1..6 -> n & 7 != 0 -> IS_INT false -> NIL_VALUE
#
# i.e. `for x in <array>` binds a good element on iteration 1 and nil on every
# later iteration. This guard was RED on origin/main before the fix
# (baremetal_runtime_core.inc.c's rt_value_int was `return value;`).
#
# Why a SOURCE check and not an objdump of a built ELF: the ELF check is real
# and was run by hand (`llvm-objdump -d --disassemble-symbols=rt_value_int`
# showing `slli a0, a0, 0x3`), but it needs a full riscv64 freestanding
# native-build + cross toolchain. This runs in under a second on every push and
# catches the same defect at its source.
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> definition(s) checked, 0 untagged     exit 0
#   FAIL  — ...                                       exit 1
#   ERROR — nothing was checked                       exit 2
# A run that examined 0 definitions is ERROR, never a pass.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

# Classify one C source: print "TAGGED", "UNTAGGED" or "NONE" for its
# rt_value_int definition body. Weak nil-returning auto_stubs are ignored:
# those are link fallbacks, not the real definition, and are recognised by
# __attribute__((weak)).
classify_file() {
    _f=$1
    awk '
        # skip weak stub declarations entirely
        /__attribute__\(\(weak\)\).*rt_value_int/ { next }
        # a definition opens with a type, the name, one parameter, and either
        # a brace on this line or the next.
        /^[A-Za-z_][A-Za-z0-9_ *]*[ *]rt_value_int[ ]*\(/ && !/;[ ]*$/ {
            found = 1; depth = 0; body = ""
        }
        found {
            body = body " " $0
            n = gsub(/\{/, "{"); depth += n
            m = gsub(/\}/, "}"); depth -= m
            if (depth <= 0 && body ~ /\{/) {
                if (body ~ /ENCODE_INT/ || body ~ /<<[ ]*3/) print "TAGGED"
                else print "UNTAGGED"
                found = 0; exit
            }
        }
        END { if (!printed) { } }
    ' "$_f"
}

scan_root() {
    _root=$1
    _checked=0
    _bad=""
    # Freestanding/baremetal runtime C sources only. Hosted runtime
    # (src/runtime/runtime_native.c et al) is covered by its own selfchecks.
    for f in $(find "$_root/examples/09_embedded/simple_os" "$_root/src/os" \
                    -name '*.c' -o -name '*.inc.c' 2>/dev/null | sort); do
        [ -f "$f" ] || continue
        grep -q 'rt_value_int' "$f" 2>/dev/null || continue
        v=$(classify_file "$f" || true)
        case "$v" in
            TAGGED)   _checked=$((_checked + 1)) ;;
            UNTAGGED) _checked=$((_checked + 1))
                      _bad="$_bad ${f#$_root/}" ;;
            *)        : ;;
        esac
    done
    EV_CHECKED=$_checked
    EV_BAD=$_bad
}

selftest() {
    d=$(mktemp -d)
    trap 'rm -rf "$d"' EXIT
    mkdir -p "$d/examples/09_embedded/simple_os" "$d/src/os"

    # fixture 1: tagged via ENCODE_INT -> must be TAGGED
    cat >"$d/examples/09_embedded/simple_os/good_encode.c" <<'EOF'
RuntimeValue rt_value_int(RuntimeValue value)
{
    return ENCODE_INT(value);
}
EOF
    # fixture 2: tagged via << 3 -> must be TAGGED
    cat >"$d/examples/09_embedded/simple_os/good_shift.c" <<'EOF'
spl_i64 rt_value_int(spl_i64 value) {
    return value << 3;
}
EOF
    # fixture 3: THE INCIDENT — identity body, must be UNTAGGED
    cat >"$d/src/os/bad_identity.c" <<'EOF'
RuntimeValue rt_value_int(RuntimeValue value)
{
    return value;
}
EOF
    # fixture 4: weak auto-stub must be IGNORED, not counted
    cat >"$d/src/os/weak_stub.c" <<'EOF'
__attribute__((weak)) RuntimeValue rt_value_int(RuntimeValue a) { return NIL_VALUE; }
EOF

    for want in TAGGED:good_encode.c TAGGED:good_shift.c; do
        exp=${want%%:*}; fn=${want#*:}
        got=$(classify_file "$d/examples/09_embedded/simple_os/$fn")
        [ "$got" = "$exp" ] || { echo "selftest FAIL: $fn expected $exp got '$got'"; exit 2; }
    done
    got=$(classify_file "$d/src/os/bad_identity.c")
    [ "$got" = "UNTAGGED" ] || { echo "selftest FAIL: bad_identity expected UNTAGGED got '$got'"; exit 2; }
    got=$(classify_file "$d/src/os/weak_stub.c")
    [ -z "$got" ] || { echo "selftest FAIL: weak_stub should be ignored, got '$got'"; exit 2; }

    # fixture 5: the incident tree as a whole must FAIL the scan
    scan_root "$d"
    [ "$EV_CHECKED" -eq 3 ] || { echo "selftest FAIL: expected 3 definitions, got $EV_CHECKED"; exit 2; }
    case "$EV_BAD" in *bad_identity.c*) : ;; *) echo "selftest FAIL: incident fixture not flagged"; exit 2 ;; esac

    # fixture 6: an empty tree must check 0 so the caller is forced to ERROR
    e=$(mktemp -d); mkdir -p "$e/examples/09_embedded/simple_os" "$e/src/os"
    scan_root "$e"; rm -rf "$e"
    [ "$EV_CHECKED" -eq 0 ] || { echo "selftest FAIL: empty tree checked $EV_CHECKED"; exit 2; }

    rm -rf "$d"; trap - EXIT
}

case "${1-}" in
    --selftest) selftest; echo "selftest: 6 fixture(s) OK"; exit 0 ;;
esac

# selftest runs before every scan and is fatal.
selftest >/dev/null || { echo "ERROR — nothing was checked (selftest failed)"; exit 2; }

scan_root "$ROOT"

if [ "$EV_CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked (no freestanding rt_value_int definition found)"
    exit 2
fi
if [ -n "$EV_BAD" ]; then
    echo "FAIL — $EV_CHECKED definition(s) checked, untagged rt_value_int in:$EV_BAD"
    exit 1
fi
echo "PASS — $EV_CHECKED definition(s) checked, 0 untagged"
exit 0
