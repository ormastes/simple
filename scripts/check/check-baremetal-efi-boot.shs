#!/bin/sh
# Baremetal build + REAL-FIRMWARE boot check (x86_64, i686, aarch64, riscv64, riscv32, arm32).
#
# Builds examples/09_embedded/freestanding_hello/main.spl (or $BM_SRC) for
# <arch>-unknown-none with the Simple compiler (--emit-object), links it with
# the committed freestanding runtime:
#   src/lib/nogc_async_mut_noalloc/baremetal/freestanding/bm_rt.spl  (pure Simple)
#   src/lib/nogc_async_mut_noalloc/baremetal/freestanding/crt0_<arch>.S (_start,
#     stack, putc, byte load/store, halt)
# and boots it through real firmware:
#   x86_64  OVMF pflash   -> FAT ESP BOOTX64.EFI  -> flat image
#   i686    OVMF32 (IA32) pflash -> FAT ESP BOOTIA32.EFI -> flat image linked at 16 MiB
#   aarch64 AAVMF pflash  -> FAT ESP BOOTAA64.EFI -> flat image
#   riscv64 OpenSBI fw_payload (v1.4, built with clang LLVM=1) via -bios
#   arm32   (opt-in, --arch arm32) AAVMF32 pflash, qemu-system-arm virt/cortex-a15, vfat ESP image
#           on virtio-blk-pci, BOOTARM.EFI. lld-link emits PE machine 0x01c4 but EDK2 ARM
#           loads only 0x01c2: pe_patch_machine rewrites it (checked; --selftest proves it).
#   riscv32 OpenSBI 1.7 fw_payload (XLEN=32, clang LLVM=1) via -bios; uses the
#           32-bit runtime bm_rt32.spl (bm_rt.spl declares i64 params, which the
#           32-bit backend does not pass that way)
# PASS needs the exact transcript on serial, in order:
#   hello from Simple bare metal / n=42 / ints 0 -7 MAX MIN / panic: boom
# and NOT "after panic" (proves rt_panic halted).
#
# .claude/rules/board-runnable.md: real firmware only -- no QEMU -kernel, no
# isa-debug-exit. Board path: x86_64/aarch64 copy esp/EFI/BOOT/BOOT*.EFI to a
# FAT USB stick (aarch64: assemble crt0 with BM_A64_UART=<board PL011 base>);
# riscv64 flash fw_payload.bin per the board's OpenSBI flow (BM_RV_UART).
# Board run not yet evidenced.
#
# Usage: sh scripts/check/check-baremetal-efi-boot.shs [--arch x86_64|i686|aarch64|riscv64|riscv32|all]
#            [--linker lld|simple] [--keep]
#   --linker simple (i686, arm32): in-house Simple linker + PE32 emitter (arm32: Thumb-2 stub, machine 0x01c2).
#   --linker simple (x86_64/aarch64/riscv64): use elf_boot_link and FAIL unless
#   allocated-section layout equals lld's for the same inputs (layout.diff); x86_64/aarch64
#   link efi_stub_<arch>.S first and are wrapped by the in-house PE32+ emitter.
# Env:   OPENSBI32_SRC (riscv32, OpenSBI 1.7 tree), SIMPLE_BIN (default bin/simple),
#        SIMPLE_LINK_BIN (CLI with `run`, default SIMPLE_BIN), BM_SRC, BM_WORK, BM_TIMEOUT_S (30),
#        CLANG (clang), OVMF_CODE/OVMF_VARS, OVMF32_CODE/OVMF32_VARS (~/.simple/firmware/ovmf-ia32),
#        BM_QEMU_MEM (256M), AAVMF_CODE/AAVMF_VARS, BM_A64_UART, BM_RV_UART, OPENSBI_SRC (default ~/.cache/simple/opensbi-v1.4).
# Verdict (last line): PASS -- <n> arch(es) booted / FAIL -- ... / ERROR -- nothing was checked
set -u

arch_sel=all
keep=0
selftest_only=0
linker=lld
while [ $# -gt 0 ]; do
    case "$1" in
        --arch) arch_sel="$2"; shift 2 ;;
        --linker) linker="$2"; shift 2
            case "$linker" in lld|simple) ;; *) echo "ERROR -- nothing was checked (unsupported --linker $linker)"; exit 2 ;; esac ;;
        --keep) keep=1; shift ;;
        --selftest) selftest_only=1; shift ;;
        -h|--help) sed -n "2,39p" "$0"; exit 0 ;;
        *) echo "unknown argument: $1"; echo "ERROR -- nothing was checked (bad argument)"; exit 2 ;;
    esac
done

repo_root=$(cd "$(dirname "$0")/../.." && pwd)
SIMPLE_BIN=${SIMPLE_BIN:-$repo_root/bin/simple}
SIMPLE_LINK_BIN=${SIMPLE_LINK_BIN:-$SIMPLE_BIN}
BM_SRC=${BM_SRC:-$repo_root/examples/09_embedded/freestanding_hello/main.spl}
RT_DIR=$repo_root/src/lib/nogc_async_mut_noalloc/baremetal/freestanding
BM_TIMEOUT_S=${BM_TIMEOUT_S:-30}
CLANG=${CLANG:-clang}
OPENSBI_SRC=${OPENSBI_SRC:-$HOME/.cache/simple/opensbi-v1.4}
OPENSBI32_SRC=${OPENSBI32_SRC:-$HOME/.simple/firmware/src/opensbi-1.7}
I686_BASE=0x1000000  # link base; the i686 image is position independent and runs where AnyPages puts it
OPENSBI_TAG=v1.4
OPENSBI_SHA=a2b255b88918715173942f2c5e1f97ac9e90c877  # same pin as check-simpleos-riscv64-opensbi-guest-boot.shs
work=${BM_WORK:-$(mktemp -d "${TMPDIR:-/tmp}/bm-efi-boot.XXXXXX")}
RT_SYMS="rt_string_new rt_string_new_literal rt_string_data rt_string_len rt_raw_i64_to_string rt_strcat_tagged rt_interp_cstr rt_println_str rt_println rt_panic"
EXPECT="hello from Simple bare metal
n=42
ints 0 -7 9223372036854775807 -9223372036854775808
panic: boom"

# pe_patch_machine <file>: lld-link -machine:arm writes IMAGE_FILE_MACHINE_ARMNT
# (0x01c4) but EDK2 ARM loads only IMAGE_FILE_MACHINE_ARMTHUMB_MIXED (0x01c2);
# lld-link has no option to choose it. Checked rewrite of the 2 machine bytes:
# fails unless the file has the DOS 'MZ' magic, a 'PE\0\0' signature at e_lfanew
# and machine == 0x01c4, and reads 0x01c2 back afterwards.
pe_patch_machine() {
    pf=$1
    [ -s "$pf" ] || return 1
    [ "$(od -An -tx1 -N2 "$pf" | tr -d ' \n')" = 4d5a ] || return 1
    lfa=$(od -An -tu4 -j60 -N4 "$pf" | tr -d ' \n')
    [ -n "$lfa" ] && [ "$lfa" -ge 64 ] || return 1
    [ "$(od -An -tx1 -j"$lfa" -N4 "$pf" | tr -d ' \n')" = 50450000 ] || return 1
    [ "$(od -An -tx1 -j$((lfa + 4)) -N2 "$pf" | tr -d ' \n')" = c401 ] || return 1
    printf '\302\001' | dd of="$pf" bs=1 seek=$((lfa + 4)) conv=notrunc 2>/dev/null || return 1
    [ "$(od -An -tx1 -j$((lfa + 4)) -N2 "$pf" | tr -d ' \n')" = c201 ]
}

# pe_machine_is_thumb <file>: read-only check for the Simple-linker lane, whose
# PE emitter already writes 0x01c2 (nothing to patch); fails closed otherwise.
pe_machine_is_thumb() {
    pf=$1
    [ -s "$pf" ] || return 1
    [ "$(od -An -tx1 -N2 "$pf" | tr -d ' \n')" = 4d5a ] || return 1
    lfa=$(od -An -tu4 -j60 -N4 "$pf" | tr -d ' \n')
    [ -n "$lfa" ] && [ "$lfa" -ge 64 ] || return 1
    [ "$(od -An -tx1 -j"$lfa" -N4 "$pf" | tr -d ' \n')" = 50450000 ] || return 1
    [ "$(od -An -tx1 -j$((lfa + 4)) -N2 "$pf" | tr -d ' \n')" = c201 ]
}

# Fixture proof: a good ARMNT header is rewritten (and nothing else changes);
# wrong magic, wrong signature, already-patched and wrong-machine files are all
# refused. Returns non-zero on any mismatch.
pe_selftest() {
    t=$(mktemp -d "${TMPDIR:-/tmp}/bm-pe-selftest.XXXXXX") || return 1
    mk() { # mk <file> <mz> <sig> <machine-escaped>
        { printf "$2"; dd if=/dev/zero bs=1 count=58 2>/dev/null; printf '\100\000\000\000'
          printf "$3$4"; printf 'tail'; } > "$1"
    }
    mk "$t/good" 'MZ' 'PE\000\000' '\304\001'
    cp "$t/good" "$t/good.orig"
    pe_patch_machine "$t/good" || { echo "selftest: good header refused"; rm -rf "$t"; return 1; }
    [ "$(od -An -tx1 -j68 -N2 "$t/good" | tr -d ' \n')" = c201 ] || { echo "selftest: not patched"; rm -rf "$t"; return 1; }
    [ "$(cmp -l "$t/good" "$t/good.orig" | wc -l | tr -d ' ')" = 1 ] || { echo "selftest: more than 1 byte changed"; rm -rf "$t"; return 1; }
    pe_patch_machine "$t/good" && { echo "selftest: re-patch accepted"; rm -rf "$t"; return 1; }
    mk "$t/badmz" 'XX' 'PE\000\000' '\304\001'
    pe_patch_machine "$t/badmz" && { echo "selftest: bad MZ accepted"; rm -rf "$t"; return 1; }
    mk "$t/badsig" 'MZ' 'XE\000\000' '\304\001'
    pe_patch_machine "$t/badsig" && { echo "selftest: bad PE signature accepted"; rm -rf "$t"; return 1; }
    mk "$t/amd64" 'MZ' 'PE\000\000' '\144\206'
    pe_patch_machine "$t/amd64" && { echo "selftest: amd64 machine accepted"; rm -rf "$t"; return 1; }
    : > "$t/empty"
    pe_patch_machine "$t/empty" && { echo "selftest: empty file accepted"; rm -rf "$t"; return 1; }
    pe_machine_is_thumb "$t/good" || { echo "selftest: thumb check refused a 0x01c2 header"; rm -rf "$t"; return 1; }
    pe_machine_is_thumb "$t/good.orig" && { echo "selftest: thumb check accepted 0x01c4"; rm -rf "$t"; return 1; }
    pe_machine_is_thumb "$t/amd64" && { echo "selftest: thumb check accepted amd64"; rm -rf "$t"; return 1; }
    rm -rf "$t"
    return 0
}

need_tools="$CLANG ld.lld lld-link llvm-objcopy llvm-nm llvm-readelf timeout"
for t in $need_tools; do
    if ! command -v "$t" >/dev/null 2>&1; then
        echo "ERROR -- nothing was checked (missing tool: $t)"; exit 2
    fi
done
if [ $selftest_only -eq 0 ] && [ ! -x "$SIMPLE_BIN" ]; then
    echo "ERROR -- nothing was checked (no compiler at SIMPLE_BIN=$SIMPLE_BIN)"; exit 2
fi

firmware_for() {
    # prints "<code> <vars> <qemu>" or nothing (riscv64: "<opensbi-src> - <qemu>")
    case "$1" in
        x86_64)
            c=${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}; v=${OVMF_VARS:-/usr/share/OVMF/OVMF_VARS_4M.fd}
            q=qemu-system-x86_64 ;;
        i686)
            o32=${OVMF32_DIR:-$HOME/.simple/firmware/ovmf-ia32/usr/share/OVMF}
            c=${OVMF32_CODE:-$o32/OVMF32_CODE_4M.fd}; v=${OVMF32_VARS:-$o32/OVMF32_VARS_4M.fd}
            q=qemu-system-i386 ;;
        aarch64)
            c=${AAVMF_CODE:-/usr/share/AAVMF/AAVMF_CODE.fd}; v=${AAVMF_VARS:-/usr/share/AAVMF/AAVMF_VARS.fd}
            q=qemu-system-aarch64 ;;
        arm32)
            c=${AAVMF32_CODE:-/usr/share/AAVMF/AAVMF32_CODE.fd}; v=${AAVMF32_VARS:-/usr/share/AAVMF/AAVMF32_VARS.fd}
            q=qemu-system-arm
            command -v mkfs.vfat >/dev/null 2>&1 && command -v mcopy >/dev/null 2>&1 && command -v mmd >/dev/null 2>&1 || return ;;
        riscv64)
            command -v qemu-system-riscv64 >/dev/null 2>&1 && command -v make >/dev/null 2>&1 \
                && echo "opensbi - qemu-system-riscv64"
            return ;;
        riscv32)
            [ -f "$OPENSBI32_SRC/Makefile" ] && command -v qemu-system-riscv32 >/dev/null 2>&1 \
                && command -v make >/dev/null 2>&1 && echo "opensbi32 - qemu-system-riscv32"
            return ;;
    esac
    [ -f "$c" ] && [ -f "$v" ] && command -v "$q" >/dev/null 2>&1 && echo "$c $v $q"
}

tgt_for() { if [ "$1" = arm32 ]; then echo armv7-unknown-none; else echo "$1-unknown-none"; fi; }

compile_obj() {
    # compile_obj <src> <arch> <out> <log>
    SIMPLE_FILE_WORKERS=0 timeout 900 "$SIMPLE_BIN" native-build "$1" \
        --target "$(tgt_for "$2")" --emit-object -o "$3" > "$4" 2>&1
    rc=$?
    [ $rc -eq 0 ] && [ -s "$3" ]
}

layout_of() {
    # layout_of <elf> <out>: allocated-section layout "<name> <addr> <size>"
    # (SHF_ALLOC only, sorted). Columns after the [Nr] strip:
    # Name Type Address Off Size ES Flg. readelf's status is checked directly.
    llvm-readelf -S -W "$1" > "$2.raw" 2>&1 || return 1
    awk '/^ *\[ *[0-9]+\]/ { sub(/^ *\[ *[0-9]+\] */, "");
        if ($7 ~ /A/ && $1 != "") print $1, $3, $5 }' "$2.raw" | sort > "$2"
}

# Builds <d>/image.bin (flat) linked at <base>. Returns non-zero with $why set.
reloc_guard() {
    # reloc_guard <dir> <obj>...: fail closed on absolute relocations (sets why).
    d=$1; shift
    llvm-readelf -r "$@" > "$d/relocs.txt" 2>&1 || { why=readelf; return 1; }
    if grep -E -q 'R_X86_64_(32S?|64) |R_386_(32|16|8) |R_AARCH64_(ABS(16|32|64)|MOVW_UABS)|R_ARM_(ABS32|MOVW_ABS_NC|MOVT_ABS|THM_MOVW_ABS_NC|THM_MOVT_ABS|TARGET1) ' "$d/relocs.txt"; then
        why=absolute-reloc; return 1
    fi
}

build_image() {
    a=$1; d=$2; base=$3
    compile_obj "$BM_SRC" "$a" "$d/main.o" "$d/build.log" || { why=compile; return 1; }
    rtm=bm_rt; case "$a" in riscv32|i686) rtm=bm_rt32 ;; esac   # 32-bit ABI widths, see bm_rt32.spl header
    compile_obj "$RT_DIR/$rtm.spl" "$a" "$d/bm_rt.o" "$d/rt-build.log" || { why=rt-compile; return 1; }
    # The compiler module-prefixes definitions (<module path>.bm_rt.<name>);
    # bind the plain ABI names. Every runtime symbol must be found.
    redef=""
    for s in $RT_SYMS; do
        m=$(llvm-nm --defined-only "$d/bm_rt.o" | awk -v s="$s" -v m="$rtm" '{ n=$NF; if (n ~ ("\\." m "\\." s "$") || n == (m "." s)) print n }' | head -1)
        [ -n "$m" ] || { why="rt-missing-$s"; return 1; }
        if [ "$a" = arm32 ]; then redef="$redef --redefine-sym $m=bm32_$s"; else redef="$redef --redefine-sym $m=$s"; fi
    done
    llvm-objcopy $redef "$d/bm_rt.o" "$d/bm_rt_abi.o" || { why=rt-redefine; return 1; }
    case "$a" in
        x86_64) cflags="--target=x86_64-unknown-elf" ;;
        i686) cflags="--target=i686-unknown-elf" ;;
        aarch64) cflags="--target=aarch64-unknown-elf -DBM_UART=${BM_A64_UART:-0x09000000}" ;;
        riscv64) cflags="--target=riscv64-unknown-elf -march=rv64imac -mabi=lp64 -DBM_UART=${BM_RV_UART:-0x10000000}" ;;
        riscv32) cflags="--target=riscv32-unknown-elf -march=rv32imac -mabi=ilp32 -DBM_UART=${BM_RV_UART:-0x10000000}" ;;
        arm32) cflags="--target=armv7-unknown-none-eabi -mfloat-abi=soft -DBM_UART=${BM_A32_UART:-0x09000000}" ;;
    esac
    "$CLANG" $cflags -c "$RT_DIR/crt0_$a.S" -o "$d/crt0.o" > "$d/crt0.log" 2>&1 || { why=crt0; return 1; }
    if [ "$linker" = simple ] && [ "$a" = i686 ]; then
        # In-house Simple linker: IA32 EFI stub first, flat image at $base,
        # wrapped by the in-house PE32 emitter (no ld.lld, no lld-link).
        "$CLANG" $cflags -c "$RT_DIR/efi_stub_$a.S" -o "$d/efi_stub.o" > "$d/stub.log" 2>&1 || { why=efi-stub; return 1; }
        "${SIMPLE_LINK_BIN:-$SIMPLE_BIN}" run "$repo_root/scripts/check/baremetal-elf32-link.spl" -- "$a" "$base" efi_entry \
            "$d/image.bin" "$d/efi_stub.o" "$d/crt0.o" "$d/main.o" "$d/bm_rt_abi.o" > "$d/link.log" 2>&1 || {
            why=link; return 1; }
        return 0
    fi
    if [ "$linker" = simple ] && [ "$a" = arm32 ]; then
        # In-house Simple linker: Thumb-2 EFI stub first, ARM crt0, flat image
        # at $base, wrapped by the in-house PE32 emitter as machine 0x01c2.
        # Same absolute-relocation guard as the lld path (image runs wherever
        # AllocatePages put it).
        "$CLANG" $cflags -c "$RT_DIR/efi_stub_$a.S" -o "$d/efi_stub.o" > "$d/stub.log" 2>&1 || { why=efi-stub; return 1; }
        reloc_guard "$d" "$d/efi_stub.o" "$d/crt0.o" "$d/main.o" "$d/bm_rt_abi.o" || return 1
        "${SIMPLE_LINK_BIN:-$SIMPLE_BIN}" run "$repo_root/scripts/check/baremetal-elf32-link.spl" -- "$a" "$base" efi_entry \
            "$d/image.bin" "$d/efi_stub.o" "$d/crt0.o" "$d/main.o" "$d/bm_rt_abi.o" > "$d/link.log" 2>&1 || {
            why=link; return 1; }
        return 0
    fi
    printf '%s\n' 'ENTRY(_start)' \
        "SECTIONS { . = $base; .text : { *(.text.boot) *(.text*) } . = ALIGN(16); .rodata : { *(.rodata*) *(.srodata*) } . = ALIGN(16); .data : { *(.data*) *(.sdata*) *(.bss*) *(.sbss*) *(COMMON) } /DISCARD/ : { *(.ARM.exidx*) *(.ARM.extab*) *(.comment) } }" > "$d/image.ld"
    if [ "$linker" = simple ]; then
        # In-house Simple linker; lld links the same inputs only as the
        # section-layout reference (allocated name/addr/size must match).
        # EFI arches put the copy-to-AllocatePages stub first (pe_efi_blob
        # contract), so the PE is emitted in-house by baremetal-efi-wrap.spl.
        stub=""
        case "$a" in x86_64|aarch64)
            "$CLANG" $cflags -c "$RT_DIR/efi_stub_$a.S" -o "$d/efi_stub.o" > "$d/stub.log" 2>&1 || { why=efi-stub; return 1; }
            stub="$d/efi_stub.o" ;;
        esac
        "$SIMPLE_LINK_BIN" run "$repo_root/scripts/check/baremetal-simple-link.spl" -- "$a" "$d/image.ld" \
            "$d/image.elf" $stub "$d/crt0.o" "$d/main.o" "$d/bm_rt_abi.o" > "$d/link.log" 2>&1
        rc=$?
        [ $rc -eq 0 ] && [ -s "$d/image.elf" ] || { why=simple-link; return 1; }
        # elf_boot_link never relaxes RISC-V code; compare against lld --no-relax.
        lld_ref_flags=""; case "$a" in riscv*) lld_ref_flags="--no-relax" ;; esac
        ld.lld $lld_ref_flags -T "$d/image.ld" -o "$d/image-lld.elf" $stub "$d/crt0.o" "$d/main.o" "$d/bm_rt_abi.o" > "$d/link-lld.log" 2>&1 || {
            why=lld-reference-link; return 1; }
        layout_of "$d/image.elf" "$d/layout-simple.txt" || { why=layout-read; return 1; }
        layout_of "$d/image-lld.elf" "$d/layout-lld.txt" || { why=layout-read; return 1; }
        [ -s "$d/layout-lld.txt" ] && [ -s "$d/layout-simple.txt" ] || { why=layout-empty; return 1; }
        if ! cmp -s "$d/layout-simple.txt" "$d/layout-lld.txt"; then
            diff "$d/layout-lld.txt" "$d/layout-simple.txt" > "$d/layout.diff"
            why=layout-mismatch; return 1
        fi
    else
        ld.lld -T "$d/image.ld" -o "$d/image.elf" "$d/crt0.o" "$d/main.o" "$d/bm_rt_abi.o" > "$d/link.log" 2>&1 || {
            why=link; return 1; }
    fi
    # No undefined runtime symbol may survive (fail closed on a partial runtime).
    if llvm-nm -u "$d/image.elf" | grep -q .; then why=undefined; return 1; fi
    # x86_64/aarch64 images are linked at 0 but run wherever AllocatePages put
    # them, so any absolute relocation would point at the wrong address. Fail
    # closed rather than boot a silently mis-relocated image.
    if [ "$a" != riscv64 ] && [ "$a" != riscv32 ]; then
        reloc_guard "$d" "$d/crt0.o" "$d/main.o" "$d/bm_rt_abi.o" || return 1
    fi
    llvm-objcopy -O binary "$d/image.elf" "$d/image.bin" || { why=objcopy; return 1; }
}

build_efi() {
    # Wrap image.bin in a PE/COFF EFI application on a FAT ESP.
    a=$1; d=$2
    case "$a" in
        x86_64) wt=x86_64-unknown-windows; mach=amd64; boot=BOOTX64.EFI; sdef="" ;;
        i686) wt=i686-unknown-windows; mach=x86; boot=BOOTIA32.EFI; sdef="-DIA32 -DIMAGE_BASE=$I686_BASE" ;;
        arm32) wt=thumbv7-unknown-windows; mach=arm; boot=BOOTARM.EFI; sdef="-DARM32" ;;
        *) wt=aarch64-unknown-windows; mach=arm64; boot=BOOTAA64.EFI; sdef="" ;;
    esac
    mkdir -p "$d/esp/EFI/BOOT"
    if [ "$linker" = simple ]; then
        wa=$a; [ "$a" = arm32 ] && wa=arm   # emitter arch name (PE machine 0x01c2, Thumb entry)
        "${SIMPLE_LINK_BIN:-$SIMPLE_BIN}" run "$repo_root/scripts/check/baremetal-efi-wrap.spl" -- "$wa" \
            "$d/image.bin" "$d/esp/EFI/BOOT/$boot" > "$d/efi.log" 2>&1
        return $?
    fi
    # The image writes its own .data (arena + stack) and executes its .text,
    # but AAVMF maps PE sections W^X (a section-resident image faulted with
    # "Synchronous Exception" at its first write). So the stub copies it into
    # BootServices->AllocatePages(AnyPages, EfiLoaderCode) pages, which the
    # firmware leaves RWX, and jumps there. Offsets: SystemTable->BootServices
    # at 96, BootServices->AllocatePages at 40 (UEFI 2.x table layout).
    cat > "$d/stub.c" <<'EOF'
__asm__(".section .rdata,\"dr\"\n.balign 16\nimage_start:\n.incbin \"image.bin\"\nimage_end:\n.section .text\n");
extern const unsigned char image_start[], image_end[];
typedef unsigned long long u64;
#if defined(ARM32)
/* UEFI ARM 32: UINTN/pointers 32 bit, EFI_PHYSICAL_ADDRESS 64. BootServices at
 * SystemTable+60, AllocatePages at +32; AnyPages. */
typedef unsigned int uintn;
#define ST_BS_OFF 60
#define BS_ALLOC_OFF 32
#define ALLOC_TYPE 0
#elif defined(IA32)
/* UEFI IA32: UINTN/pointers are 32 bit. SystemTable->BootServices at 60,
 * BootServices->AllocatePages at 32. crt0_i686 is position independent
 * (GOTPC/GOTOFF), so AnyPages works; OVMF IA32 has no free memory at a fixed
 * 16 MiB address (AllocateAddress returned EFI_NOT_FOUND). */
typedef unsigned int uintn;
#define ST_BS_OFF 60
#define BS_ALLOC_OFF 32
#define ALLOC_TYPE 0
#else
typedef u64 uintn;
#define ST_BS_OFF 96
#define BS_ALLOC_OFF 40
#define ALLOC_TYPE 0
#endif
typedef uintn (*alloc_pages_fn)(uintn type, uintn mem_type, uintn pages, u64 *addr);
u64 efi_main(void *h, void *st) {
    void *bs = *(void **)((char *)st + ST_BS_OFF);
    alloc_pages_fn alloc = *(alloc_pages_fn *)((char *)bs + BS_ALLOC_OFF);
    u64 n = (u64)(image_end - image_start), addr = 0;
    if (alloc(ALLOC_TYPE, 1, (n + 4095) / 4096, &addr) != 0) { for (;;) {} }
    for (u64 i = 0; i < n; i++) ((volatile unsigned char *)(uintn)addr)[i] = image_start[i];
#if defined(__arm__)
    /* ARMv7 cache maintenance by MVA: clean D to PoU, invalidate I, flush BP. */
    for (u64 i = 0; i < n; i += 32) { unsigned long a = (unsigned long)addr + (unsigned long)i; __asm__ volatile("mcr p15, 0, %0, c7, c11, 1" :: "r"(a)); }
    __asm__ volatile("dsb");
    for (u64 i = 0; i < n; i += 32) { unsigned long a = (unsigned long)addr + (unsigned long)i; __asm__ volatile("mcr p15, 0, %0, c7, c5, 1" :: "r"(a)); }
    __asm__ volatile("mcr p15, 0, %0, c7, c5, 6" :: "r"(0));
    __asm__ volatile("dsb\nisb");
#endif
#if defined(__aarch64__)
    for (u64 i = 0; i < n; i += 64) __asm__ volatile("dc cvau, %0" :: "r"(addr + i));
    __asm__ volatile("dsb ish");
    for (u64 i = 0; i < n; i += 64) __asm__ volatile("ic ivau, %0" :: "r"(addr + i));
    __asm__ volatile("dsb ish\nisb");
#endif
    ((void (*)(void))(uintn)addr)();
    for (;;) {}
    return 0;
}
EOF
    (cd "$d" && "$CLANG" --target="$wt" -ffreestanding -fno-stack-protector $sdef -c stub.c -o stub.o) || return 1
    lld-link /subsystem:efi_application /entry:efi_main /machine:$mach /nodefaultlib \
        /out:"$d/esp/EFI/BOOT/$boot" "$d/stub.o" > "$d/efi.log" 2>&1
}

build_opensbi() {
    # build_opensbi <payload.bin> <outdir>: pinned OpenSBI v1.4 fw_payload, clang only.
    if [ -d "$OPENSBI_SRC/.git" ]; then
        have=$(git -C "$OPENSBI_SRC" rev-parse HEAD 2>/dev/null || echo none)
        [ "$have" = "$OPENSBI_SHA" ] || { echo "OpenSBI at $have, not pinned $OPENSBI_SHA"; return 1; }
    else
        mkdir -p "$(dirname "$OPENSBI_SRC")"
        git clone -q --depth 1 --branch "$OPENSBI_TAG" \
            https://github.com/riscv-software-src/opensbi.git "$OPENSBI_SRC" > "$2/clone.log" 2>&1 || return 1
        have=$(git -C "$OPENSBI_SRC" rev-parse HEAD)
        [ "$have" = "$OPENSBI_SHA" ] || { echo "cloned OpenSBI is $have, not $OPENSBI_SHA"; return 1; }
    fi
    make -C "$OPENSBI_SRC" O="$2/opensbi-build" PLATFORM=generic LLVM=1 \
        FW_PAYLOAD=y FW_PAYLOAD_PATH="$1" FW_PAYLOAD_OFFSET=0x200000 -j4 > "$2/opensbi.log" 2>&1 || return 1
    [ -s "$2/opensbi-build/platform/generic/firmware/fw_payload.bin" ]
}

transcript_ok() {
    # Exact expected lines, consecutive, starting at the first "hello from Simple".
    tr -d '\r' < "$1" | tr -c '[:print:]\n' '?' | sed -n '/hello from Simple/,$p' | head -4 > "$1.got"
    printf '%s\n' "$EXPECT" > "$1.want"
    cmp -s "$1.got" "$1.want" && ! grep -a -q "after panic" "$1"
}

if ! pe_selftest; then echo "FAIL -- pe_patch_machine selftest"; exit 1; fi
if [ $selftest_only -eq 1 ]; then echo "PASS -- pe_patch_machine selftest (9 fixtures)"; exit 0; fi

booted=0
failed=""
checked=0
case "$arch_sel" in
    arm32) arches=arm32 ;;
    all) arches="x86_64 aarch64 riscv64" ;;   # riscv32/i686/arm32 are opt-in (--arch): need OPENSBI32_SRC / OVMF32 firmware
    x86_64|i686|aarch64|riscv64|riscv32|arm32) arches="$arch_sel" ;;
    *) echo "ERROR -- nothing was checked (unsupported --arch $arch_sel)"; exit 2 ;;
esac

for a in $arches; do
    fw=$(firmware_for "$a")
    if [ -z "$fw" ]; then
        echo "[$a] firmware or qemu missing"; failed="$failed $a(no-firmware)"; continue
    fi
    set -- $fw; fw_code=$1; fw_vars=$2; qemu=$3
    d="$work/$a"; rm -rf "$d"; mkdir -p "$d"
    why=""
    case "$a" in riscv64) base=0x80200000 ;; riscv32) base=0x80400000 ;; i686) base=$I686_BASE ;; *) base=0 ;; esac
    build_image "$a" "$d" "$base" || { echo "[$a] image build failed: $why ($d)"; failed="$failed $a($why)"; continue; }

    rm -f "$d/serial.log"
    case "$a" in
        x86_64|i686)
            build_efi "$a" "$d" || { echo "[$a] EFI wrap failed ($d/efi.log)"; failed="$failed $a(efi)"; continue; }
            cp "$fw_vars" "$d/vars.fd"; cp "$fw_code" "$d/code.fd"
            set -- -machine q35 -m "${BM_QEMU_MEM:-256M}" \
                -drive if=pflash,format=raw,readonly=on,file="$d/code.fd" \
                -drive if=pflash,format=raw,file="$d/vars.fd" \
                -drive file=fat:rw:"$d/esp",format=raw ;;
        aarch64)
            build_efi "$a" "$d" || { echo "[$a] EFI wrap failed ($d/efi.log)"; failed="$failed $a(efi)"; continue; }
            # AAVMF images must fill the 64 MiB virt pflash banks.
            truncate -s 64M "$d/code.fd"; dd if="$fw_code" of="$d/code.fd" conv=notrunc 2>/dev/null
            cp "$fw_vars" "$d/vars.fd"; truncate -s 64M "$d/vars.fd"
            set -- -machine virt -cpu cortex-a57 -m "${BM_QEMU_MEM:-256M}" \
                -drive if=pflash,format=raw,readonly=on,file="$d/code.fd" \
                -drive if=pflash,format=raw,file="$d/vars.fd" \
                -drive file=fat:rw:"$d/esp",format=raw ;;
        arm32)
            build_efi "$a" "$d" || { echo "[$a] EFI wrap failed ($d/efi.log)"; failed="$failed $a(efi)"; continue; }
            # EDK2 ARM accepts only machine 0x01c2; lld-link emits 0x01c4.
            if [ "$linker" = simple ]; then pe_fix=pe_machine_is_thumb; else pe_fix=pe_patch_machine; fi
            $pe_fix "$d/esp/EFI/BOOT/BOOTARM.EFI" || { echo "[$a] PE machine check/patch failed"; failed="$failed $a(pe-patch)"; continue; }
            # Real vfat ESP image on virtio-blk-pci (AAVMF32 ignores QEMU vvfat).
            truncate -s 64M "$d/esp.img"
            mkfs.vfat -F 32 "$d/esp.img" > "$d/mkfs.log" 2>&1 \
                && mmd -i "$d/esp.img" ::EFI ::EFI/BOOT > "$d/mtools.log" 2>&1 \
                && mcopy -i "$d/esp.img" "$d/esp/EFI/BOOT/BOOTARM.EFI" ::EFI/BOOT/BOOTARM.EFI >> "$d/mtools.log" 2>&1 \
                || { echo "[$a] vfat ESP build failed ($d/mkfs.log, $d/mtools.log)"; failed="$failed $a(esp)"; continue; }
            cp "$fw_vars" "$d/vars.fd"; cp "$fw_code" "$d/code.fd"
            set -- -machine virt -cpu cortex-a15 -m "${BM_QEMU_MEM:-512M}" \
                -drive if=pflash,format=raw,unit=0,readonly=on,file="$d/code.fd" \
                -drive if=pflash,format=raw,unit=1,file="$d/vars.fd" \
                -drive if=none,id=esp,file="$d/esp.img",format=raw \
                -device virtio-blk-pci,drive=esp ;;
        riscv64)
            build_opensbi "$d/image.bin" "$d" || { echo "[$a] OpenSBI fw_payload build failed ($d)"; failed="$failed $a(opensbi)"; continue; }
            set -- -machine virt -cpu rv64 -smp 1 -m "${BM_QEMU_MEM:-256M}" \
                -bios "$d/opensbi-build/platform/generic/firmware/fw_payload.bin" ;;
        riscv32)
            # OpenSBI 1.7 XLEN=32 fw_payload; rv32 default payload offset 0x400000
            # => payload at 0x80400000 (the link base above). Never -kernel.
            make -C "$OPENSBI32_SRC" O="$d/opensbi-build" PLATFORM=generic PLATFORM_RISCV_XLEN=32 LLVM=1 \
                FW_PAYLOAD=y FW_PAYLOAD_PATH="$d/image.bin" FW_PAYLOAD_OFFSET=0x400000 -j4 > "$d/opensbi.log" 2>&1 \
                && [ -s "$d/opensbi-build/platform/generic/firmware/fw_payload.bin" ] \
                || { echo "[$a] OpenSBI fw_payload build failed ($d/opensbi.log)"; failed="$failed $a(opensbi)"; continue; }
            set -- -machine virt -smp 1 -m "${BM_QEMU_MEM:-256M}" \
                -bios "$d/opensbi-build/platform/generic/firmware/fw_payload.bin" ;;
    esac
    set -- "$@" -display none -no-reboot -net none -serial file:"$d/serial.log" -monitor none
    for arg in "$@"; do
        case "$arg" in -kernel|*isa-debug-exit*) echo "FAIL -- forbidden QEMU flag $arg"; exit 1 ;; esac
    done
    # The image halts (no exit device by rule); the timeout ends the run.
    timeout "$BM_TIMEOUT_S" "$qemu" "$@" > "$d/qemu.log" 2>&1
    checked=$((checked + 1))
    if [ -f "$d/serial.log" ] && transcript_ok "$d/serial.log"; then
        echo "[$a] booted via firmware: $(tr '\n' '|' < "$d/serial.log.got")"
        booted=$((booted + 1))
    else
        echo "[$a] transcript mismatch ($d/serial.log): $(tr '\n' '|' < "$d/serial.log.got" 2>/dev/null)"
        failed="$failed $a(boot)"
    fi
done

[ $keep -eq 1 ] || [ -n "${BM_WORK:-}" ] || rm -rf "$work"
real_failures=$(printf '%s\n' $failed | grep -v 'no-firmware' | grep -c .)
if [ -n "$failed" ]; then
    if [ "$real_failures" -eq 0 ] && [ $booted -eq 0 ]; then
        echo "ERROR -- nothing was checked (firmware/qemu missing:$failed)"; exit 2
    fi
    echo "FAIL -- $booted of $checked boot(s) passed; failed:$failed"; exit 1
fi
if [ $booted -eq 0 ]; then echo "ERROR -- nothing was checked"; exit 2; fi
echo "PASS -- $booted arch(es) booted through real firmware (exact serial transcript, panic halted)"
exit 0
