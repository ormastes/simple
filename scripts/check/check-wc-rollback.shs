#!/bin/sh
# Detect working-copy files that were silently REWOUND to an older ancestor
# version rather than genuinely edited — i.e. content that byte-matches some
# earlier blob of the SAME path in origin/main's history, not the current
# origin/main blob AND not the local HEAD's blob.
#
# This happened on 2026-07-30: a chain of 22 `jj restore --from @- --
# <batch-of-unrelated-paths>` calls, run while resolving jj-conflicted "chore:
# consolidate completed agent session work" commits, each blanket-picked one
# side (usually the OLDER parent) for dozens of unrelated files at once. One
# op (8767e92a0f91) restored 65 paths in a single call. `git status` showed
# all of it as ordinary modifications — nothing errored. Casualties included
# a fix its own commit called "the sole redeploy blocker" (mid-codepoint text
# slices corrupting to U+FFFD), a SIMPLE_BOOTSTRAP=1 fix, a parser
# line-continuation fix, a dropped duplicate-Origin-header smuggling check,
# and Zeroize/secure_wipe calls that left key material unwiped.
#
# CRITICAL TRAP 1 — do NOT "simplify" this to `git cat-file -e <blob>`:
# jj is colocated and continuously snapshots the working copy into the git
# object store, so nearly all working-copy content already exists as SOME
# object regardless of whether it was ever committed anywhere. A first
# attempt using cat-file -e reported "145 rollbacks, 0 novel edits" — which
# is impossible since two files had just been hand-edited. It was measuring
# jj's snapshotting, not rollbacks. The only valid test is: does the on-disk
# content match a blob from THAT PATH's OWN history on origin/main, and does
# it differ from origin/main's CURRENT blob for that path.
#
# CRITICAL TRAP 2 — "behind origin" is NOT "rewound". In this shared,
# constantly-fetched tree, origin/main routinely advances past the local
# working copy; a file whose disk content simply hasn't caught up yet will
# legitimately byte-match an OLDER origin/main blob even though nothing was
# ever rewound. A first version of this script conflated the two and reported
# 69 "rollbacks" where 57 were verified to be exactly this: disk == local
# HEAD blob for that path, i.e. the working copy is exactly at the commit it
# claims to be checked out at — merely behind origin, not damaged. The real
# incident signature is the opposite: disk is OLDER than the working copy's
# OWN HEAD for that path (e.g. browser_renderer_protocol.spl had 12
# `initiator_origin` refs at HEAD and 0 on disk). So the rule is:
#   ROLLBACK = (disk != origin/main blob) AND (disk != HEAD blob)
#              AND (disk byte-matches some ancestor blob d_commit)
#              AND (d_commit is NOT HEAD's-path-commit or a descendant of it)
# (that last clause is refined further in CRITICAL TRAP 5 below — a raw
# blob-equality check against HEAD is not quite enough on its own). Files
# that are merely behind (same-or-newer than HEAD's own content, just short
# of origin's tip) are reported separately as informational BEHIND, not as
# ROLLBACK, and do NOT affect the exit code.
#
# CRITICAL TRAP 3 — hashing disk content WITH filters applied (plain
# `git hash-object`, no flag) is WRONG here, not a fix: several .cmd/.bat
# files carry an `eol=crlf`/`text=set` gitattribute, but their blobs were
# committed before/without that normalization consistently applied, so their
# STORED blob content itself still contains raw CRLF bytes. Filtered
# hash-object recomputes "what this would hash to if added fresh under
# today's attributes" (a renormalize-style transform) and disagrees with the
# actual stored blob EVEN WHEN THE RAW DISK BYTES ARE BYTE-IDENTICAL to that
# blob (verified: `diff <(git show HEAD:bin/simple.cmd) bin/simple.cmd` is
# empty, yet plain `git hash-object` disagreed with both the origin AND HEAD
# blob hash). Blob IDs in the object database are always raw bytes, never
# filtered, so the correct comparison is raw-vs-raw: `--no-filters`
# everywhere below, never plain `git hash-object`.
#
# CRITICAL TRAP 4 — re-resolving `origin/main` / `HEAD` by name PER FILE is
# racy: another session in this shared working copy can `git fetch` or
# commit mid-scan, moving those refs partway through a multi-hundred-file
# loop and making different files get compared against different snapshots.
# Both refs are resolved to fixed commit SHAs ONCE at the top of this script
# and reused for every file.
#
# CRITICAL TRAP 5 — "disk != HEAD blob" is not proof of rollback either: a
# path's blob at local HEAD can itself be stale relative to a partial
# fetch/restore that already advanced just that one file's on-disk content
# past HEAD without a matching local commit. Example found live: a .spl file
# whose disk content matched origin/main commit 7b80bd17 (2026-07-30
# 07:36:22), while local HEAD's own blob for that same path came from an
# EARLIER commit a4e58712 (2026-07-29 17:39:02) — the disk was actually
# NEWER than HEAD's recorded content, just still short of origin/main's
# absolute tip. That is the same harmless "behind" story, not damage. The
# only real damage signature is disk content that is OLDER than what HEAD
# itself already had for that path. So once an ancestor match is found (blob
# `d` equals some commit `d_commit`'s blob for this path), it is only a real
# ROLLBACK if `d_commit` is NOT a descendant of (or equal to) the commit that
# produced HEAD's own blob for this path — checked via
# `git merge-base --is-ancestor <head_commit_for_path> <d_commit>`.
#
# Usage: check-wc-rollback.shs [path-or-pathspec]
#   No argument: scope is every path that differs between the working tree
#   and origin/main (git diff --name-only origin/main). With an argument,
#   the same diff is filtered to that pathspec (a single file or a directory
#   prefix both work, same as `git diff -- <pathspec>`).
#
# Vendored/third-party paths (CLAUDE.md Owned-Code Scope) are excluded
# unconditionally: src/compiler_rust/vendor/**, src/runtime/vendor/**,
# src/runtime/miniaudio.h, src/runtime/stb_image.h, src/runtime/stb_truetype.h.
#
# This script is READ-ONLY: only diff/rev-parse/rev-list/cat-file/hash-object
# (all with --no-optional-locks / non-mutating equivalents). It never runs
# checkout/add/commit/stash/reset, and never writes the index.
#
# Exit 0 = clean (no real rollbacks; BEHIND files, if any, are informational),
# 1 = real rollback(s) found, 2 = could not determine (e.g. origin/main does
# not resolve, or mktemp failed).

set -u

scope="${1:-}"

if ! ORIGIN_SHA=$(git rev-parse --verify -q origin/main 2>/dev/null); then
    echo "check-wc-rollback: origin/main does not resolve — fetch it first (this script never fetches)" >&2
    exit 2
fi

if ! HEAD_SHA=$(git rev-parse --verify -q HEAD 2>/dev/null); then
    echo "check-wc-rollback: HEAD does not resolve" >&2
    exit 2
fi

# Paths that differ between the working tree and origin/main, pinned to the
# SHA captured above (not the moving ref name). --no-optional-locks keeps
# this from opportunistically refreshing/writing the index (another session
# may be actively committing and holding .git/index.lock).
changed=$(git --no-optional-locks diff --name-only "$ORIGIN_SHA" -- $scope 2>/dev/null)

# Owned-Code Scope exclusions (CLAUDE.md) — vendored/third-party, never ours
# to flag as rewound.
changed=$(printf '%s\n' "$changed" | grep -vE \
    '^src/compiler_rust/vendor/|^src/runtime/vendor/|^src/runtime/(miniaudio|stb_image|stb_truetype)\.h$')

if [ -z "$changed" ]; then
    echo "check-wc-rollback: OK — no paths differ from origin/main${scope:+ under $scope}"
    exit 0
fi

# The read-loop below is piped from printf, so it runs in a subshell and
# cannot mutate parent-shell counters directly. Record hits to temp files
# instead and re-derive the counts afterward. mktemp is the only filesystem
# write this script performs, and it's outside the repo and outside the git
# index.
ROLLBACK_TMPFILE=$(mktemp "${TMPDIR:-/tmp}/check-wc-rollback.rollback.XXXXXX") || {
    echo "check-wc-rollback: mktemp failed" >&2
    exit 2
}
BEHIND_TMPFILE=$(mktemp "${TMPDIR:-/tmp}/check-wc-rollback.behind.XXXXXX") || {
    echo "check-wc-rollback: mktemp failed" >&2
    rm -f "$ROLLBACK_TMPFILE"
    exit 2
}
trap 'rm -f "$ROLLBACK_TMPFILE" "$BEHIND_TMPFILE"' EXIT INT TERM

# IFS/read-loop so filenames with spaces survive; NUL-safe isn't needed here
# since git diff --name-only outputs one path per line and this repo's paths
# don't contain newlines.
printf '%s\n' "$changed" | while IFS= read -r p; do
    [ -z "$p" ] && continue

    # Sparse checkout / deletion: absent on disk is NOT a rollback, skip it.
    [ -e "$p" ] || continue

    # Current origin/main blob for this path. If the path doesn't exist there
    # (a genuinely new file), there is no history to have been rewound to.
    o=$(git rev-parse -q --verify "$ORIGIN_SHA:$p" 2>/dev/null) || continue

    # --no-filters: compare raw disk bytes against raw blob bytes. Blob IDs
    # are always raw; applying attribute-driven filters here would recompute
    # a hypothetical "renormalized" hash instead of testing actual content
    # equality (see CRITICAL TRAP 3 above).
    d=$(git hash-object --no-filters "$p" 2>/dev/null) || continue

    # Matches origin/main's current content — not a rollback (and not even
    # a diff in substance; git diff can list mode-only changes).
    [ "$d" = "$o" ] && continue

    # Matches the LOCAL HEAD's blob for this path — the working copy is
    # exactly at the commit it claims, just behind origin/main. Not damage.
    h=$(git rev-parse -q --verify "$HEAD_SHA:$p" 2>/dev/null)
    if [ -n "$h" ] && [ "$d" = "$h" ]; then
        echo "$p" >> "$BEHIND_TMPFILE"
        continue
    fi

    # Neither origin/main's nor HEAD's current content explains the disk
    # content. Only now pay for the expensive check: does the on-disk
    # content byte-match an ANCESTOR version of this same path (rewound), as
    # opposed to novel edited content nobody has seen before? Cap history
    # depth at 40 commits touching this path — validated sufficient in
    # practice, and keeps this from running unbounded on hot files. Unlike a
    # plain existence check, this also records WHICH commit produced the
    # matching blob (d_commit), since that is needed for the ordering test
    # below (CRITICAL TRAP 5) — so this walks revs directly instead of a
    # batch-check existence probe.
    d_commit=""
    for r in $(git rev-list "$ORIGIN_SHA" -- "$p" 2>/dev/null | head -40); do
        b=$(git rev-parse -q --verify "$r:$p" 2>/dev/null)
        if [ "$b" = "$d" ]; then
            d_commit="$r"
            break
        fi
    done

    [ -z "$d_commit" ] && continue   # no ancestor match at all — novel content, not a rollback signal

    if [ -z "$h" ]; then
        # Path doesn't exist in HEAD's tree at all (introduced by origin
        # after HEAD) yet disk holds old content different from origin's
        # tip — no HEAD baseline to compare ordering against. Flag it
        # conservatively; this is a rare edge case, not the common path.
        echo "ROLLBACK: $p"
        echo "$p" >> "$ROLLBACK_TMPFILE"
        continue
    fi

    h_commit=$(git log -1 --format=%H "$HEAD_SHA" -- "$p" 2>/dev/null)
    if [ -n "$h_commit" ] && git merge-base --is-ancestor "$h_commit" "$d_commit" 2>/dev/null; then
        # d_commit is the same as, or a descendant (newer) of, the commit
        # that produced HEAD's own blob for this path — disk is same-or-newer
        # than what HEAD already had. Merely behind origin's tip, not damage.
        echo "$p" >> "$BEHIND_TMPFILE"
    else
        # d_commit predates (or is unrelated to) HEAD's own version of this
        # path — disk genuinely regressed below content HEAD already had.
        echo "ROLLBACK: $p"
        echo "$p" >> "$ROLLBACK_TMPFILE"
    fi
done

rollback_count=0
behind_count=0
[ -s "$ROLLBACK_TMPFILE" ] && rollback_count=$(wc -l < "$ROLLBACK_TMPFILE" | tr -d ' ')
[ -s "$BEHIND_TMPFILE" ] && behind_count=$(wc -l < "$BEHIND_TMPFILE" | tr -d ' ')

if [ "$behind_count" -gt 0 ]; then
    echo "check-wc-rollback: INFO — $behind_count file(s) are behind origin/main but match local HEAD (not rewound)"
fi

if [ "$rollback_count" -gt 0 ]; then
    echo "" >&2
    echo "check-wc-rollback: FOUND $rollback_count file(s) rewound to an older ancestor version (not origin/main, not HEAD)" >&2
    exit 1
fi

echo "check-wc-rollback: OK — no rollbacks among $(printf '%s\n' "$changed" | grep -c .) changed path(s)${scope:+ under $scope} ($behind_count behind-origin, informational)"
exit 0
