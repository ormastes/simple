#!/bin/sh
set -eu

# The hosted native bundle is one link lane. runtime_native.c and the weak
# SimpleOS stubs are alternate core/embedded lanes and must not be added to
# these link inputs: simple-runtime, bundled by simple-native-all, owns this ABI.
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
rust_root="$repo_root/src/compiler_rust"
target_dir=${CARGO_TARGET_DIR:-"$rust_root/target"}
archive="$target_dir/debug/libsimple_native_all.a"

cargo build --quiet --manifest-path "$rust_root/Cargo.toml" -p simple-native-all

test -f "$archive" || {
    echo "FAIL: native-all archive missing: $archive" >&2
    exit 1
}

# Count archive members, not a deduplicated symbol list. This catches a second
# strong provider even when both definitions have the same unmangled name.
provider_count=$(
    nm -g --defined-only "$archive" 2>/dev/null |
        awk 'NF >= 2 { name=$NF; sub(/^_/, "", name); type=$(NF-1); if (name == "rt_file_atomic_write" && type ~ /^[TDBR]$/) count++ } END { print count+0 }'
)
test "$provider_count" -eq 1 || {
    echo "FAIL: expected exactly one strong rt_file_atomic_write in hosted link inputs, found $provider_count" >&2
    exit 1
}

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/simple-native-all-atomic.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM

cat >"$tmp_dir/consumer.c" <<'EOF'
#include <stdint.h>
#include <stdio.h>
#include <string.h>

typedef uint64_t RuntimeValue;
extern RuntimeValue rt_string_new(const uint8_t *, uint64_t);
extern int64_t rt_file_atomic_write(RuntimeValue, RuntimeValue);

int main(int argc, char **argv) {
    const char content[] = "runtime-owned atomic write";
    char actual[sizeof content] = {0};
    if (argc != 2) return 10;
    RuntimeValue path = rt_string_new((const uint8_t *)argv[1], strlen(argv[1]));
    RuntimeValue text = rt_string_new((const uint8_t *)content, sizeof(content) - 1);
    if (rt_file_atomic_write(path, text) != 1) return 11;
    FILE *file = fopen(argv[1], "rb");
    if (!file) return 12;
    size_t read = fread(actual, 1, sizeof(actual), file);
    if (fclose(file) != 0) return 13;
    return read == sizeof(content) - 1 && memcmp(actual, content, sizeof(content) - 1) == 0 ? 0 : 14;
}
EOF

# Intentionally link only the hosted bundle. Adding runtime_native.c or the
# weak embedded stub here would violate the bundle policy and mask ownership.
# Match the production bundle's duplicate-definition policy for its separately
# baselined legacy providers; the strict atomic-write count above remains the
# ownership gate and cannot be relaxed by this linker option.
case $(uname -s) in
    Darwin) duplicate_policy="-Wl,-multiply_defined,suppress" ;;
    *) duplicate_policy="-Wl,-z,muldefs" ;;
esac
cc "$tmp_dir/consumer.c" "$archive" -o "$tmp_dir/consumer" \
    "$duplicate_policy" -ldl -lpthread -lm -lrt -lutil
"$tmp_dir/consumer" "$tmp_dir/state.txt"

echo "PASS: native-all has one runtime-owned atomic-write provider and an external ABI consumer links and runs"
