#!/bin/sh
# Refuse a deployed `bin/simple` whose unprovided-`use`-name check is missing,
# lenient, or noisy.
#
# ---------------------------------------------------------------------------
# WHY THIS CHECK EXISTS
# ---------------------------------------------------------------------------
# A braced `use m.{A, B}` that names a symbol module `m` does not actually
# provide is the "imported symbol declared nowhere" family — 766 distinct
# undeclared names across 380 files, per
# doc/08_tracking/bug/undeclared_imported_symbols_census.md.
#
# History: this check was first a WARNING (`[use-warning] ... does not provide
# it`, stderr only, rc 0) and that warning once FIRED NOWHERE because it never
# reached the deployed binary (`strings -a ... | grep -c use-warning` -> 0 while
# the source was correct). The seed's module loader contract has since changed:
# the same finding is now a HARD COMPILE ERROR
# (CompileError::semantic):
#
#   `NAME` is named in `use LABEL.{...}` but module `LABEL` (PATH) does not
#   provide it (imported from IMPORTER); import it from the module that defines
#   it
#
# The program does not execute and the exit code is non-zero.
# `SIMPLE_NO_DEPRECATED_WARNINGS` no longer affects it. Modules whose source has
# a top-level `@when(` or `@cfg(` line are not checked at all.
#
# The defect still lives in the gap between the source tree and the artifact
# that runs, so the check interrogates the ARTIFACT by RUNNING it, not by
# reading strings out of it.
#
# ---------------------------------------------------------------------------
# WHAT IS ASSERTED (all must hold)
# ---------------------------------------------------------------------------
#   A. POSITIVE  — running an importer that names `uw_probe_zzz_absent`, which
#                  `src/lib/common/use_warning_probe.spl` does not declare in
#                  any form, MUST print a "does not provide it" error naming
#                  it, exit NON-ZERO (and not by signal), and MUST NOT print the
#                  `use-warning-probe-ran` marker (the program must not run).
#   B. FP GUARD  — a separate importer naming only provided names, including
#                  `uw_probe_extern_provided` (declared `extern fn`), MUST run:
#                  print the ran-marker, exit 0, and emit no "does not provide
#                  it" line. Extern fn / extern class names count as provided
#                  (census §6b, the `rt_font_glyph_advance` false positive).
#   C. CONTROL   — the same guard importer also names `uw_probe_plain_provided`,
#                  an ordinary `fn`; it must not be reported either. Without
#                  this, a checker that rejected EVERY name would pass A.
#
# A + B/C together cannot pass vacuously: one run must fail closed on exactly
# the absent name, another must run clean on the provided names.
#
# ---------------------------------------------------------------------------
# FAIL-CLOSED CONTRACT
# ---------------------------------------------------------------------------
# Verdict is always the LAST line of stdout, matching the other scripts/check
# guards:
#
#   PASS  — exit 0. States what was actually observed; counts are always > 0.
#   FAIL  — exit 1. The check regressed (lenient or noisy). Do not ship this
#           binary.
#   ERROR — exit 2. Nothing was checked (no binary, no `timeout`, fixture
#           missing, guard importer did not run for a non-diagnostic reason).
#           NEVER reported as a pass.
#
# Usage:  sh scripts/check/check-use-warning-oracle-deployed.shs [path-to-simple]

set -u

VERDICT_PASS=0

fail()  { printf 'FAIL — %s\n' "$1"; exit 1; }
oops()  { printf 'ERROR — nothing was checked: %s\n' "$1"; exit 2; }

# --- locate the repo and the DEPLOYED binary --------------------------------
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || oops "cannot resolve script dir"
repo_root=$(CDPATH= cd -- "$script_dir/../.." && pwd) || oops "cannot resolve repo root"

if [ "$#" -ge 1 ] && [ -n "$1" ]; then
    BIN=$1
else
    BIN=$repo_root/bin/simple
fi

[ -e "$BIN" ] || oops "deployed binary not found: $BIN"
[ -x "$BIN" ] || oops "deployed binary is not executable: $BIN"

command -v timeout >/dev/null 2>&1 || oops "\`timeout\` is required to bound the probe"

# --- fixture ----------------------------------------------------------------
# The provider is COMMITTED under a real module root (src/lib, `std.common.*`),
# because the provided-names check only runs on library-path module resolution.
# The absent-name importer is committed too; the guard importer (provided names
# only) is generated into a temp dir — it names the library path, so it still
# reaches the check.
IMPORTER=$repo_root/scripts/check/fixtures/use_warning_probe_importer.spl
PROVIDER=$repo_root/src/lib/common/use_warning_probe.spl

[ -f "$IMPORTER" ] || oops "fixture importer missing: $IMPORTER"
[ -f "$PROVIDER" ] || oops "fixture provider missing: $PROVIDER"

work_pre=$(mktemp -d) || oops "cannot create temp dir"
trap 'rm -rf "$work_pre" "${work:-}"' EXIT INT TERM

# Comments in the provider legitimately NAME all three probe symbols to explain
# the contract, so every fixture-integrity grep below scores code lines only.
provider_code=$work_pre/provider_code.txt
grep -v '^[[:space:]]*#' "$PROVIDER" > "$provider_code" 2>/dev/null

# The provider must NOT declare the name the positive assertion depends on.
if grep -q 'uw_probe_zzz_absent' "$provider_code" 2>/dev/null; then
    oops "fixture provider $PROVIDER declares uw_probe_zzz_absent — the positive assertion can no longer distinguish a strict loader from a lenient one. Remove that declaration."
fi
# ...and it must still declare the two names the guard assertions depend on.
grep -q "extern fn uw_probe_extern_provided" "$provider_code" 2>/dev/null \
    || oops "fixture provider $PROVIDER no longer declares \`extern fn uw_probe_extern_provided\` — the false-positive guard would pass vacuously."
grep -q "fn uw_probe_plain_provided" "$provider_code" 2>/dev/null \
    || oops "fixture provider $PROVIDER no longer declares \`fn uw_probe_plain_provided\` — the control assertion would pass vacuously."
# The provider must not carry a top-level @when(/@cfg( line: such modules are
# skipped by the check and the positive assertion would measure nothing.
if grep -qE '^(@when\(|@cfg\()' "$provider_code" 2>/dev/null; then
    oops "fixture provider $PROVIDER has a top-level @when(/@cfg( line — the loader skips such modules, so the probe would measure nothing."
fi
# The committed absent-name importer must actually name the absent symbol.
grep -q 'uw_probe_zzz_absent' "$IMPORTER" 2>/dev/null \
    || oops "fixture importer $IMPORTER no longer names uw_probe_zzz_absent — the positive assertion would be vacuous."

work=$(mktemp -d) || oops "cannot create temp dir"

GUARD=$work/uw_probe_guard_importer.spl
cat > "$GUARD" <<'EOF'
# Generated by check-use-warning-oracle-deployed.shs: provided names only.
use std.common.use_warning_probe.{uw_probe_plain_provided, uw_probe_extern_provided}

print("use-warning-probe-ran")
print(uw_probe_plain_provided())
EOF

# --- run --------------------------------------------------------------------
# rc is read directly after each invocation, never through a pipe.
( cd "$repo_root" && timeout 300 "$BIN" run "$IMPORTER" > "$work/abs_out.txt" 2> "$work/abs_err.txt" )
abs_rc=$?
( cd "$repo_root" && timeout 300 "$BIN" run "$GUARD" > "$work/grd_out.txt" 2> "$work/grd_err.txt" )
grd_rc=$?

for f in abs_out abs_err grd_out grd_err; do
    [ -f "$work/$f.txt" ] || oops "probe produced no $f file"
done

# --- A: POSITIVE ------------------------------------------------------------
# Scored on stdout+stderr combined: the error may be routed to either stream.
cat "$work/abs_out.txt" "$work/abs_err.txt" > "$work/abs_all.txt"
n_absent=$(grep 'does not provide it' "$work/abs_all.txt" 2>/dev/null | grep -c 'uw_probe_zzz_absent' || true)
[ -n "$n_absent" ] || n_absent=0

if grep -q 'use-warning-probe-ran' "$work/abs_all.txt" 2>/dev/null; then
    fail "unprovided-use check is LENIENT in $BIN — the importer naming 'uw_probe_zzz_absent' still EXECUTED (printed use-warning-probe-ran, rc=$abs_rc). The loader must reject it as a compile error before running."
fi
if [ "$abs_rc" -eq 0 ]; then
    fail "unprovided-use check is LENIENT in $BIN — 'uw_probe_zzz_absent' is declared nowhere in src/lib/common/use_warning_probe.spl yet the run exited 0. It must be a hard compile error (non-zero exit)."
fi
if [ "$abs_rc" -ge 128 ]; then
    fail "importer naming 'uw_probe_zzz_absent' died by signal/timeout (rc=$abs_rc) in $BIN — a crash is not a diagnostic; stderr head: $(head -c 300 "$work/abs_err.txt" 2>/dev/null | tr '\n' ' ')"
fi
if [ "$n_absent" -lt 1 ]; then
    fail "rc=$abs_rc but no \"does not provide it\" error naming 'uw_probe_zzz_absent' in $BIN — it failed for some other reason; output head: $(head -c 300 "$work/abs_all.txt" 2>/dev/null | tr '\n' ' ')"
fi
VERDICT_PASS=$((VERDICT_PASS + 1))

# --- B + C: FALSE-POSITIVE GUARD / CONTROL ----------------------------------
cat "$work/grd_out.txt" "$work/grd_err.txt" > "$work/grd_all.txt"
n_fp=$(grep -c 'does not provide it' "$work/grd_all.txt" 2>/dev/null || true)
[ -n "$n_fp" ] || n_fp=0
if [ "$n_fp" -gt 0 ]; then
    fail "false positive — the importer naming ONLY provided names (incl. extern fn 'uw_probe_extern_provided') drew $n_fp \"does not provide it\" line(s) in $BIN. collect_provided_names must include Node::Extern and Node::ExternClass (module_loader.rs). First: $(grep -m1 'does not provide it' "$work/grd_all.txt")"
fi
if ! grep -q 'use-warning-probe-ran' "$work/grd_out.txt" 2>/dev/null; then
    oops "guard importer never executed (rc=$grd_rc; timeout, kill, or an unrelated compile failure); output head: $(head -c 300 "$work/grd_all.txt" 2>/dev/null | tr '\n' ' ')"
fi
if [ "$grd_rc" -ne 0 ]; then
    fail "guard importer naming only provided names printed the ran-marker but exited rc=$grd_rc in $BIN"
fi
VERDICT_PASS=$((VERDICT_PASS + 1))

printf 'PASS — %s assertions checked against %s: absent name rejected as hard error (rc=%s, did not run), provided names (extern fn + plain fn) ran clean (rc=0, no "does not provide it")\n' \
    "$VERDICT_PASS" "$BIN" "$abs_rc"
exit 0
