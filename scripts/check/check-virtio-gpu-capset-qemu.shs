#!/bin/sh
set -eu
# Unit V3 (doc/03_plan/ui/testing/render_2d_vulkan_functional_coverage_plan_2026-08-07.md):
# QEMU virtio-gpu headless smoke -- boots a SimpleOS guest via OVMF pflash
# (never `-kernel` pass semantics, never isa-debug-exit, per
# .claude/rules/board-runnable.md), attaches `-device virtio-gpu-pci`, and
# expects the guest to run the capset query path (gpu_query_capsets) and
# print `VIRTIO_GPU_CAPSETS n=<count> venus=<0|1>` to the serial console.
#
# Fail-closed: a missing VIRTIO_GPU_CAPSETS line in the serial log is a FAIL.
# An aborted/empty run (no serial log at all, or the guest image does not
# exist) is an ERROR, never a silent pass -- this is the
# probe-harness-fall-through-exit-0 trap the plan calls out by name.
#
# HONEST GAP (2026-08-08, filed as
# doc/08_tracking/bug/virtio_gpu_capset_qemu_smoke_needs_guest_probe_image_2026-08-08.md):
# the QEMU + OVMF + virtio-gpu-pci device LAYER is proven to work in this
# sandbox (OVMF_CODE_4M.fd is installed at /usr/share/OVMF/, and
# `qemu-system-x86_64 -M q35 -drive if=pflash,...OVMF_CODE_4M.fd -device
# virtio-gpu-pci -display none` starts cleanly with zero device errors). What
# does NOT exist yet is a SimpleOS x86_64 guest image that boots via that
# firmware, enumerates the virtio-gpu-pci device, runs gpu_query_capsets, and
# prints the VIRTIO_GPU_CAPSETS line to serial -- no such kernel/boot target
# is wired in this tree (checked: no build/os/*.elf or disk image with a
# virtio-gpu capset-probe entry point). This script therefore reports the gap
# honestly (FAIL, not a fabricated PASS) rather than skipping or faking one.

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$REPO_ROOT"

OVMF_CODE="${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}"
GUEST_IMAGE="${SIMPLEOS_VIRTIO_GPU_GUEST_IMAGE:-build/os/simpleos_x86_64_virtio_gpu_capset_probe.img}"
LOG="${SIMPLEOS_VIRTIO_GPU_QEMU_LOG:-build/test-artifacts/virtio-gpu-capset-qemu/serial.log}"
TIMEOUT="${SIMPLEOS_VIRTIO_GPU_QEMU_TIMEOUT:-300}"

mkdir -p "$(dirname "$LOG")"

[ -f "$OVMF_CODE" ] || { echo "ERROR — OVMF firmware not found at $OVMF_CODE"; exit 2; }

if [ ! -f "$GUEST_IMAGE" ]; then
  echo "ERROR — guest capset-probe image not found at $GUEST_IMAGE"
  echo "This is the honest gap: no SimpleOS x86_64 guest build target yet runs"
  echo "gpu_query_capsets at boot and prints VIRTIO_GPU_CAPSETS to serial."
  echo "See doc/08_tracking/bug/virtio_gpu_capset_qemu_smoke_needs_guest_probe_image_2026-08-08.md"
  exit 2
fi

: > "$LOG"
timeout "$TIMEOUT" qemu-system-x86_64 -M q35 -m 512 \
  -drive if=pflash,format=raw,readonly=on,file="$OVMF_CODE" \
  -drive if=virtio,format=raw,file="$GUEST_IMAGE" \
  -device virtio-gpu-pci \
  -display none -serial file:"$LOG" -monitor none -no-reboot \
  || true

if [ ! -s "$LOG" ]; then
  echo "ERROR — no serial log produced (aborted/empty run)"
  exit 2
fi

if grep -qE '^VIRTIO_GPU_CAPSETS n=[0-9]+ venus=[01]$' "$LOG"; then
  LINE=$(grep -E '^VIRTIO_GPU_CAPSETS n=[0-9]+ venus=[01]$' "$LOG" | head -1)
  N=$(echo "$LINE" | sed -E 's/.*n=([0-9]+).*/\1/')
  if [ "$N" -ge 1 ]; then
    echo "PASS — $LINE"
    exit 0
  fi
  echo "FAIL — capset count is 0: $LINE"
  exit 1
fi

echo "FAIL — no VIRTIO_GPU_CAPSETS line found in $LOG"
tail -20 "$LOG"
exit 1
