    validate_report "$native_report" >/dev/null
    sed -e "s|simpleos_qemu_host_gpu_2d_linux_x86_64_qemu_device_args=$x86_native_qemu_args|simpleos_qemu_host_gpu_2d_linux_x86_64_qemu_device_args=$x86_qemu_args|" \
        -e 's/simpleos_qemu_host_gpu_2d_linux_x86_64_render_latency_applicability=native-isa/simpleos_qemu_host_gpu_2d_linux_x86_64_render_latency_applicability=cross-isa-tcg-correctness-only/' \
