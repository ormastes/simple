    exit 0
fi
if [ "${SIMPLE_FRONTEND_DELEGATED:-1}" = 0 ] &&
   [ -n "${SIMPLE_FRONTEND_DELEGATE:-}" ] &&
   [ "$SIMPLE_FRONTEND_DELEGATE" != "$0" ]
then
    exec "$SIMPLE_FRONTEND_DELEGATE" "$@"
fi
