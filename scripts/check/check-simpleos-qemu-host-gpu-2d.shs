        done
        emit_row linux x86_64 pass ok "$x86_log" cuda
        emit_row_execution_evidence linux x86_64 "QEMU emulator version 9.0.0" "$x86_qemu_args" 65536 65536 131072
        emit_render_latency_evidence linux x86_64 "$x86_log" "$x86_qemu_args"
        emit_processing_perf_evidence linux x86_64 "$x86_log" "$x86_daemon_log"
        emit_row linux aarch64 pass ok "$pass_log" cuda
