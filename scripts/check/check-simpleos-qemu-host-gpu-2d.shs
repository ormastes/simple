        exit 1
    fi
    grep -v '^simpleos_qemu_host_gpu_2d_linux_aarch64_production_serial_log=' "$pass_report" >"$bad_backend_report"
    if validate_report "$bad_backend_report" >/dev/null 2>&1; then
        echo "simpleos_qemu_host_gpu_2d_self_test=fail"
        exit 1
    fi
    sed 's/simpleos_qemu_host_gpu_2d_linux_aarch64_daemon_max_rss_kib=65536/simpleos_qemu_host_gpu_2d_linux_aarch64_daemon_max_rss_kib=0/' "$pass_report" >"$bad_backend_report"
    if validate_report "$bad_backend_report" >/dev/null 2>&1; then
        echo "simpleos_qemu_host_gpu_2d_self_test=fail"
        exit 1
    fi
    grep -v '^simpleos_qemu_host_gpu_2d_linux_aarch64_processing_cpu_us=' "$pass_report" >"$bad_backend_report"
    if validate_report "$bad_backend_report" >/dev/null 2>&1; then
        echo "simpleos_qemu_host_gpu_2d_self_test=fail"
        exit 1
    fi
    sed 's/simpleos_qemu_host_gpu_2d_linux_aarch64_processing_preference=preferred/simpleos_qemu_host_gpu_2d_linux_aarch64_processing_preference=available-not-preferred/' "$pass_report" >"$bad_backend_report"
    if validate_report "$bad_backend_report" >/dev/null 2>&1; then
        echo "simpleos_qemu_host_gpu_2d_self_test=fail"
        exit 1
    fi
    sed -e 's/simpleos_qemu_host_gpu_2d_status=pass/simpleos_qemu_host_gpu_2d_status=fail/' \
        -e 's/simpleos_qemu_host_gpu_2d_reason=all-linux-host-gpu-rows-pass/simpleos_qemu_host_gpu_2d_reason=one-or-more-linux-host-gpu-rows-failed/' \
        -e '/^simpleos_qemu_host_gpu_2d_linux_aarch64_qemu_version=/d' "$pass_report" >"$bad_backend_report"
    if validate_report "$bad_backend_report" >/dev/null 2>&1; then
        echo "simpleos_qemu_host_gpu_2d_self_test=fail"
        exit 1
    fi
    { cat "$pass_report"; grep '^simpleos_qemu_host_gpu_2d_linux_aarch64_qemu_version=' "$pass_report"; } >"$bad_backend_report"
    if validate_report "$bad_backend_report" >/dev/null 2>&1; then
        echo "simpleos_qemu_host_gpu_2d_self_test=fail"
        exit 1
    fi
    { cat "$pass_report"; echo simpleos_qemu_host_gpu_2d_processing_selector=auto; echo simpleos_qemu_host_gpu_2d_processing_selector=auto; } >"$bad_backend_report"
    if validate_report "$bad_backend_report" >/dev/null 2>&1; then
        echo "simpleos_qemu_host_gpu_2d_self_test=fail"
        exit 1
    fi
    {
        echo simpleos_qemu_host_gpu_2d_host=linux
        echo simpleos_qemu_host_gpu_2d_host_arch=$HOST_ARCH
        echo simpleos_qemu_host_gpu_2d_status=pass
        echo simpleos_qemu_host_gpu_2d_reason=all-linux-host-gpu-rows-pass
    } >"$fake_report"
    if validate_report "$fake_report" >/dev/null 2>&1; then
        echo "simpleos_qemu_host_gpu_2d_self_test=fail"
        exit 1
    fi
    # A Metal fixture may still exercise the generic protocol implementation,
    # but it is never admissible as macOS Simple2D completion evidence.
    # Select the complete Metal protocol contract only while deriving the
    # internally consistent negative-fixture metrics.  The subshell prevents
    # any fixture-only contract state from weakening production validation.
    (
        BACKEND=metal
        PROCESSING_BACKEND=metal
        EXPECTED_RENDER_MASK=2
        EXPECTED_PROCESSING_MASK=2
        EXPECTED_PROCESSING_RECEIPT=metal
        {
        for report_host in linux windows; do
            for report_isa in x86_64 aarch64 riscv64; do
                emit_row "$report_host" "$report_isa" unsupported "requires-$report_host-host" none
            done
        done
        emit_row macos x86_64 pass ok "$metal_x86_log" metal
        emit_row_execution_evidence macos x86_64 "QEMU emulator version 9.0.0" "$x86_qemu_args" 65536 65536 131072
        emit_render_latency_evidence macos x86_64 "$metal_x86_log" "$x86_qemu_args"
        emit_processing_perf_evidence macos x86_64 "$metal_x86_log" "$metal_x86_daemon_log"
        emit_row macos aarch64 pass ok "$metal_log" metal
        emit_row_execution_evidence macos aarch64 "QEMU emulator version 9.0.0" "$arm_qemu_args" 65536 65536 131072
        emit_render_latency_evidence macos aarch64 "$metal_log" "$arm_qemu_args"
        emit_processing_perf_evidence macos aarch64 "$metal_log" "$metal_daemon_log"
        emit_arm64_production_evidence macos "$metal_production_log" "$arm_production_qemu_args"
        emit_row macos riscv64 pass ok "$metal_riscv_log" metal
        emit_row_execution_evidence macos riscv64 "QEMU emulator version 9.0.0" "$rv_qemu_args" 65536 65536 131072
        emit_render_latency_evidence macos riscv64 "$metal_riscv_log" "$rv_qemu_args"
        emit_processing_perf_evidence macos riscv64 "$metal_riscv_log" "$metal_riscv_daemon_log"
        echo simpleos_qemu_host_gpu_2d_host=macos
        echo simpleos_qemu_host_gpu_2d_host_arch=$HOST_ARCH
        echo simpleos_qemu_host_gpu_2d_status=pass
        echo simpleos_qemu_host_gpu_2d_reason=all-macos-host-gpu-rows-pass
        echo simpleos_qemu_host_gpu_2d_backend=metal
        echo simpleos_qemu_host_gpu_2d_processing_backend=metal
        echo simpleos_qemu_host_gpu_2d_rows=3
        echo simpleos_qemu_host_gpu_2d_passed=3
        echo simpleos_qemu_host_gpu_2d_blocked=0
        echo simpleos_qemu_host_gpu_2d_failed=0
        } >"$metal_pass_report"
    )
    # validate_report re-derives the canonical macOS Vulkan contract and must
    # reject the internally consistent Metal receipts above.
    if validate_report "$metal_pass_report" >/dev/null 2>&1; then
        echo "simpleos_qemu_host_gpu_2d_self_test=fail"
        exit 1
    fi
    set_host_contract windows
    serial_has_pass "$directx_log" aarch64
    serial_has_pass "$directx_vulkan_log" aarch64
    arm64_production_serial_has_correlated_frame "$directx_production_log" "$arm_production_qemu_args"
    if serial_has_pass "$directx_wrong_mask_log" aarch64 ||
       serial_has_pass "$directx_wrong_backend_log" aarch64 ||
       serial_has_pass "$directx_wrong_identity_log" aarch64
    then
        echo "simpleos_qemu_host_gpu_2d_self_test=fail"
        exit 1
    fi
    {
        for report_host in linux macos; do
            for report_isa in x86_64 aarch64 riscv64; do
                emit_row "$report_host" "$report_isa" unsupported "requires-$report_host-host" none
            done
        done
        emit_row windows x86_64 pass ok "$directx_x86_log" cuda
        emit_row_execution_evidence windows x86_64 "QEMU emulator version 9.0.0" "$x86_qemu_args" 65536 65536 131072
        emit_render_latency_evidence windows x86_64 "$directx_x86_log" "$x86_qemu_args"
        emit_processing_perf_evidence windows x86_64 "$directx_x86_log" "$directx_x86_daemon_log"
        emit_row windows aarch64 pass ok "$directx_log" cuda
        emit_row_execution_evidence windows aarch64 "QEMU emulator version 9.0.0" "$arm_qemu_args" 65536 65536 131072
        emit_render_latency_evidence windows aarch64 "$directx_log" "$arm_qemu_args"
        emit_processing_perf_evidence windows aarch64 "$directx_log" "$directx_daemon_log"
        emit_arm64_production_evidence windows "$directx_production_log" "$arm_production_qemu_args"
        emit_row windows riscv64 pass ok "$directx_riscv_log" cuda
        emit_row_execution_evidence windows riscv64 "QEMU emulator version 9.0.0" "$rv_qemu_args" 65536 65536 131072
        emit_render_latency_evidence windows riscv64 "$directx_riscv_log" "$rv_qemu_args"
        emit_processing_perf_evidence windows riscv64 "$directx_riscv_log" "$directx_riscv_daemon_log"
        echo simpleos_qemu_host_gpu_2d_host=windows
        echo simpleos_qemu_host_gpu_2d_host_arch=$HOST_ARCH
        echo simpleos_qemu_host_gpu_2d_status=pass
        echo simpleos_qemu_host_gpu_2d_reason=all-windows-host-gpu-rows-pass
        echo simpleos_qemu_host_gpu_2d_backend=directx
        echo simpleos_qemu_host_gpu_2d_processing_backend=cuda-preferred-vulkan-fallback
        echo simpleos_qemu_host_gpu_2d_rows=3
        echo simpleos_qemu_host_gpu_2d_passed=3
        echo simpleos_qemu_host_gpu_2d_blocked=0
        echo simpleos_qemu_host_gpu_2d_failed=0
    } >"$directx_pass_report"
    validate_report "$directx_pass_report" >/dev/null
    set_host_contract linux
    echo "simpleos_qemu_host_gpu_2d_self_test=pass"
}

self_test_metrics() (
    metrics_dir=$(mktemp -d)
    metrics_file="$metrics_dir/rss"
    metrics_daemon_pid=
    cleanup_metrics_test() {
        case ${metrics_daemon_pid:-} in ''|*[!0-9]*) ;; *) kill "$metrics_daemon_pid" 2>/dev/null || true; wait "$metrics_daemon_pid" 2>/dev/null || true ;; esac
        rm -rf "$metrics_dir"
    }
    trap 'cleanup_metrics_test' EXIT
    trap 'exit 130' HUP INT TERM
    timeout_bin=$(find_timeout)
    TIMEOUT_BIN=$timeout_bin
    QEMU_KILL_GRACE_SECONDS=1
    RSS_SAMPLE_INTERVAL=0.02

    row_rss_evidence_valid 1 2 3
    if row_rss_evidence_valid 0 2 3 ||
       row_rss_evidence_valid bad 2 3 ||
       row_rss_evidence_valid 4 2 3 ||
       row_rss_evidence_valid 2 2 5
    then
        exit 1
    fi

    sleep 10 &
    metrics_daemon_pid=$!
    run_qemu_with_rss 1 "$metrics_dir/qemu-phase-1.log" "$metrics_daemon_pid" "$metrics_file" sleep 2
    first_qemu_rss=$(rss_metric_value "$metrics_file" qemu_max_rss_kib)
    first_combined_rss=$(rss_metric_value "$metrics_file" combined_max_rss_kib)

    run_qemu_with_rss 1 "$metrics_dir/qemu-phase-2.log" "$metrics_daemon_pid" "$metrics_file" \
        sh -c 'trap "" TERM; while :; do sleep 1; done'
    daemon_rss=$(rss_metric_value "$metrics_file" daemon_max_rss_kib)
    qemu_rss=$(rss_metric_value "$metrics_file" qemu_max_rss_kib)
    combined_rss=$(rss_metric_value "$metrics_file" combined_max_rss_kib)
    row_rss_evidence_valid "$daemon_rss" "$qemu_rss" "$combined_rss"
    [ "$qemu_rss" -ge "$first_qemu_rss" ]
    [ "$combined_rss" -ge "$first_combined_rss" ]

    RSS_SAMPLE_INTERVAL=0.5
    lifetime_daemon_pid=
    (sleep 0.05) &
    lifetime_daemon_pid=$!
    if run_qemu_with_rss 2 "$metrics_dir/qemu-daemon-exit.log" "$lifetime_daemon_pid" "$metrics_file" sleep 0.2; then
        exit 1
    fi
    [ "$(rss_metric_value "$metrics_file" daemon_lifetime)" = failed ]
    wait "$lifetime_daemon_pid" 2>/dev/null || true
    echo "simpleos_qemu_host_gpu_2d_metrics_self_test=pass"
)

self_test_qemu_accel() {
    [ "$(preferred_native_accel linux)" = kvm ]
    [ "$(preferred_native_accel macos)" = hvf ]
    [ "$(preferred_native_accel windows)" = whpx ]
    [ "$(qemu_host_gpu_transport_kind yes no no)" = ivshmem-plain ]
    [ "$(qemu_host_gpu_transport_kind yes yes yes)" = ivshmem-plain ]
    [ "$(qemu_host_gpu_transport_kind no yes no)" = file-backed-ram-tail ]
    [ "$(qemu_host_gpu_transport_kind no no yes)" = virtio-serial-unimplemented ]
    [ "$(qemu_host_gpu_transport_kind no no no)" = unavailable ]
    macos_file_backed_ram_tail_contract_valid 528482304 0x5f800000 536870912 hvf on
    if macos_file_backed_ram_tail_contract_valid 528482303 0x5f800000 536870912 hvf on || macos_file_backed_ram_tail_contract_valid 528482304 0x5f700000 536870912 hvf on || macos_file_backed_ram_tail_contract_valid 528482304 0x5f800000 536870912 tcg on || macos_file_backed_ram_tail_contract_valid 528482304 0x5f800000 536870870 hvf on; then return 1; fi
    qemu_test_shm=/tmp/simpleos-host-gpu-self-test.shm
    if [ "$ACTIVE_HOST" = macos ]; then
        qemu_test_probe=$(encode_argv_hex -machine virt,memory-backend=guestmem -accel hvf -cpu host -m 512M \
            -kernel "$(kernel_for_isa aarch64)" -nographic -device virtio-net-pci \
            -object "memory-backend-file,id=guestmem,share=on,mem-path=$qemu_test_shm,size=512M")
        qemu_test_production=$(encode_argv_hex -machine virt,memory-backend=guestmem -accel hvf -cpu host -m 512M \
            -kernel "$(arm64_production_kernel)" -nographic -device ramfb -device virtio-net-pci \
            -object "memory-backend-file,id=guestmem,share=on,mem-path=$qemu_test_shm,size=512M")
        qemu_test_wrong_cpu=$(encode_argv_hex -machine virt,memory-backend=guestmem -accel hvf -cpu cortex-a72 -m 512M \
            -kernel "$(kernel_for_isa aarch64)" -nographic -device virtio-net-pci \
            -object "memory-backend-file,id=guestmem,share=on,mem-path=$qemu_test_shm,size=512M")
    else
        qemu_test_probe=$(encode_argv_hex -machine virt -accel hvf -cpu host -m 512M \
            -kernel "$(kernel_for_isa aarch64)" -nographic -device virtio-net-pci \
            -object "memory-backend-file,id=hostgpu,share=on,mem-path=$qemu_test_shm,size=8M" \
            -device ivshmem-plain,memdev=hostgpu)
        qemu_test_production=$(encode_argv_hex -machine virt -accel hvf -cpu host -m 512M \
            -kernel "$(arm64_production_kernel)" -nographic -device ramfb -device virtio-net-pci \
            -object "memory-backend-file,id=hostgpu,share=on,mem-path=$qemu_test_shm,size=8M" \
            -device ivshmem-plain,memdev=hostgpu)
        qemu_test_wrong_cpu=$(encode_argv_hex -machine virt -accel hvf -cpu cortex-a72 -m 512M \
            -kernel "$(kernel_for_isa aarch64)" -nographic -device virtio-net-pci \
            -object "memory-backend-file,id=hostgpu,share=on,mem-path=$qemu_test_shm,size=8M" \
            -device ivshmem-plain,memdev=hostgpu)
    fi
    qemu_test_wrong_size=$(printf '%s' "$qemu_test_probe" | sed 's/3531324d/3531314d/')
    qemu_test_wrong_share=$(printf '%s' "$qemu_test_probe" | sed 's/73686172653d6f6e/73686172653d6f6666/')
    qemu_test_wrong_accel=$(printf '%s' "$qemu_test_probe" | sed 's/687666/746367/')
    qemu_argv_evidence_valid aarch64 "$qemu_test_probe"
    qemu_argv_evidence_valid aarch64 "$qemu_test_production" production
    if qemu_argv_evidence_valid aarch64 "$qemu_test_wrong_cpu"; then
        return 1
    fi
    if qemu_argv_evidence_valid aarch64 "$qemu_test_wrong_size" || qemu_argv_evidence_valid aarch64 "$qemu_test_wrong_share" || qemu_argv_evidence_valid aarch64 "$qemu_test_wrong_accel"; then
        return 1
    fi
    echo "simpleos_qemu_host_gpu_2d_qemu_accel_self_test=pass"
}

self_test_guest_isa_contract() {
    set_guest_isa_contract x86_64,aarch64,riscv64
    [ "$GUEST_ISAS" = "x86_64 aarch64 riscv64" ]
    [ "$GUEST_ISA_COUNT" -eq 3 ]
    set_guest_isa_contract aarch64
    [ "$GUEST_ISAS" = aarch64 ]
    [ "$GUEST_ISA_COUNT" -eq 1 ]
    if set_guest_isa_contract "" ||
       set_guest_isa_contract arm64 ||
       set_guest_isa_contract x86_64 ||
       set_guest_isa_contract aarch64,riscv64 ||
       set_guest_isa_contract x86_64,aarch64,riscv64,aarch64
    then
        return 1
    fi
    set +e
    env SIMPLEOS_HOST_GPU_GUEST_ISAS= sh "$0" --self-test-guest-isas >/dev/null 2>&1
    empty_status=$?
    env SIMPLEOS_HOST_GPU_GUEST_ISAS=arm64 sh "$0" --self-test-guest-isas >/dev/null 2>&1
    unknown_status=$?
    set -e
    [ "$empty_status" -eq 2 ]
    [ "$unknown_status" -eq 2 ]
    set_guest_isa_contract x86_64,aarch64,riscv64
    echo "simpleos_qemu_host_gpu_2d_guest_isa_contract_self_test=pass"
}

preflight() {
    preflight_status=pass
    for preflight_isa in $GUEST_ISAS; do
        preflight_prefix="simpleos_qemu_host_gpu_2d_preflight_${preflight_isa}"
        preflight_qemu=$(qemu_bin_for_isa "$preflight_isa")
        if ! command -v "$preflight_qemu" >/dev/null 2>&1; then
            echo "${preflight_prefix}_status=blocked"
            echo "${preflight_prefix}_reason=qemu-binary-missing"
            preflight_status=blocked
            continue
        fi
        preflight_devices="$BUILD_DIR/qemu-capabilities/$preflight_isa-devices.log"
        mkdir -p "$(dirname "$preflight_devices")"
        "$preflight_qemu" -device help >"$preflight_devices" 2>&1 || true
        preflight_accel=$(qemu_accel_for_isa "$preflight_isa" "$preflight_qemu" || true)
        if grep -Eq 'virtio-(gpu|vga)' "$preflight_devices"; then
            preflight_virtio_gpu_2d=yes
        else
            preflight_virtio_gpu_2d=no
        fi
        if grep -Fq ivshmem-plain "$preflight_devices"; then
            preflight_ivshmem_plain=yes
        else
            preflight_ivshmem_plain=no
        fi
        if [ "$ACTIVE_HOST:$preflight_isa" = macos:aarch64 ] && "$preflight_qemu" -object help 2>/dev/null | grep -Fq memory-backend-file; then
            preflight_file_backed_ram_tail=yes
        else
            preflight_file_backed_ram_tail=no
        fi
        if grep -Eq 'virtio-serial-(device|pci)' "$preflight_devices"; then
            preflight_virtio_serial=yes
        else
            preflight_virtio_serial=no
        fi
        if grep -Eq 'virtio-(gpu|vga)-gl|rutabaga' "$preflight_devices"; then
            preflight_gl_or_rutabaga=yes
        else
            preflight_gl_or_rutabaga=no
        fi
        preflight_transport=$(qemu_host_gpu_transport_kind "$preflight_ivshmem_plain" "$preflight_file_backed_ram_tail" "$preflight_virtio_serial")
        echo "${preflight_prefix}_qemu=$preflight_qemu"
        echo "${preflight_prefix}_accel=${preflight_accel:-unavailable}"
        echo "${preflight_prefix}_virtio_gpu_2d=$preflight_virtio_gpu_2d"
        echo "${preflight_prefix}_ivshmem_plain=$preflight_ivshmem_plain"
        echo "${preflight_prefix}_file_backed_ram_tail=$preflight_file_backed_ram_tail"
        echo "${preflight_prefix}_virtio_serial=$preflight_virtio_serial"
        echo "${preflight_prefix}_host_gpu_transport=$preflight_transport"
        echo "${preflight_prefix}_gl_or_rutabaga=$preflight_gl_or_rutabaga"
        if [ -n "$preflight_accel" ] && { [ "$preflight_transport" = ivshmem-plain ] || [ "$preflight_transport" = file-backed-ram-tail ]; }; then
            echo "${preflight_prefix}_status=ready"
            echo "${preflight_prefix}_reason=qemu-host-offload-transport-available"
        elif [ "$preflight_transport" = virtio-serial-unimplemented ]; then
            echo "${preflight_prefix}_status=blocked"
            echo "${preflight_prefix}_reason=virtio-serial-guest-transport-unimplemented"
            preflight_status=blocked
        else
            echo "${preflight_prefix}_status=blocked"
            echo "${preflight_prefix}_reason=qemu-host-offload-transport-missing"
            preflight_status=blocked
        fi
    done
    echo "simpleos_qemu_host_gpu_2d_preflight_host=$ACTIVE_HOST"
    echo "simpleos_qemu_host_gpu_2d_preflight_host_arch=$HOST_ARCH"
    echo "simpleos_qemu_host_gpu_2d_preflight_status=$preflight_status"
    [ "$preflight_status" = pass ]
}

if [ "${1:-}" = --self-test ]; then
    self_test
    exit 0
fi
if [ "${1:-}" = --self-test-daemon-ready ]; then
    [ "$#" -eq 1 ] || exit 2
    daemon_ready_self_test
    exit $?
fi
if [ "${1:-}" = --self-test-runtime-provider ]; then
    [ "$#" -eq 1 ] || exit 2
    runtime_provider_closure_self_test
    exit $?
fi
if [ "${1:-}" = --self-test-metrics ]; then
    self_test_metrics
    exit 0
fi
if [ "${1:-}" = --self-test-qemu-accel ]; then
    self_test_qemu_accel
    exit 0
fi
if [ "${1:-}" = --self-test-guest-isas ]; then
    self_test_guest_isa_contract
    exit 0
fi
if [ "${1:-}" = --self-test-metal-guest-contract ]; then
    self_test_metal_guest_contract
    exit $?
fi
if [ "${1:-}" = --validate-report ]; then
    [ "$#" -eq 2 ] || exit 2
    validate_report "$2"
    exit $?
fi
if [ "${1:-}" = --preflight ]; then
    [ "$#" -eq 1 ] || exit 2
    preflight
    exit $?
fi

cleanup_active_guest() {
    qemu_process_pid=$(sed -n '1p' "${qemu_pid_file:-/dev/null}" 2>/dev/null || true)
    case ${qemu_process_pid:-} in ''|*[!0-9]*|0) ;; *) kill "$qemu_process_pid" 2>/dev/null || true ;; esac
    case ${qemu_timeout_pid:-} in ''|*[!0-9]*) ;; *)
        if [ "$qemu_timeout_pid" -gt 0 ]; then
            kill "$qemu_timeout_pid" 2>/dev/null || true
            case ${qemu_process_pid:-} in ''|*[!0-9]*|0) ;; *) kill -9 "$qemu_process_pid" 2>/dev/null || true ;; esac
            kill -9 "$qemu_timeout_pid" 2>/dev/null || true
            wait "$qemu_timeout_pid" 2>/dev/null || true
        fi
        ;;
    esac
    qemu_timeout_pid=
    qemu_pid_file=
    case ${rss_monitor_pid:-} in ''|*[!0-9]*) ;; *)
        if [ "$rss_monitor_pid" -gt 0 ]; then
            kill "$rss_monitor_pid" 2>/dev/null || true
            wait "$rss_monitor_pid" 2>/dev/null || true
        fi
        ;;
    esac
    rss_monitor_pid=
    case ${daemon_pid:-} in ''|*[!0-9]*) ;; *)
        if [ "$daemon_pid" -gt 0 ]; then
            kill "$daemon_pid" 2>/dev/null || true
            wait "$daemon_pid" 2>/dev/null || true
        fi
        ;;
    esac
    daemon_pid=
}

daemon_pid=
qemu_timeout_pid=
qemu_pid_file=
rss_monitor_pid=
trap 'cleanup_active_guest' EXIT
trap 'exit 130' HUP INT TERM

mkdir -p "$BUILD_DIR"

host=$ACTIVE_HOST

for other_host in linux macos windows; do
    if [ "$other_host" != "$host" ]; then
        for isa in $GUEST_ISAS; do
            emit_row "$other_host" "$isa" unsupported "requires-$other_host-host" none
        done
    fi
done

if [ "$host" != linux ] && [ "$host" != macos ] && [ "$host" != windows ]; then
    for isa in $GUEST_ISAS; do
        emit_row "$host" "$isa" unsupported host-daemon-backend-not-implemented none
    done
    echo "simpleos_qemu_host_gpu_2d_status=unsupported"
    echo "simpleos_qemu_host_gpu_2d_host=$host"
    echo "simpleos_qemu_host_gpu_2d_host_arch=$HOST_ARCH"
    echo "simpleos_qemu_host_gpu_2d_reason=host-daemon-backend-not-implemented"
    exit 0
fi

# The generic host-GPU/QEMU matrix must not promote macOS from Linux-style
# synthetic rows. macOS remains an emulator/readiness lane until the dedicated
# Vulkan/MoltenVK wrapper records source-matched DrawIR -> Engine2D -> Vulkan
# submit, fence and device-readback evidence on a prepared Mac.
if [ "$host" = macos ]; then
    for isa in $GUEST_ISAS; do
        emit_row macos "$isa" unsupported macos-vulkan-live-evidence-required none vulkan
    done
    echo "simpleos_qemu_host_gpu_2d_host=macos"
    echo "simpleos_qemu_host_gpu_2d_host_arch=$HOST_ARCH"
    echo "simpleos_qemu_host_gpu_2d_status=unsupported"
    echo "simpleos_qemu_host_gpu_2d_reason=macos-vulkan-live-evidence-required"
    echo "simpleos_qemu_host_gpu_2d_backend=vulkan"
    echo "simpleos_qemu_host_gpu_2d_processing_backend=vulkan"
    echo "simpleos_qemu_host_gpu_2d_execution=emulator-only"
    echo "simpleos_qemu_host_gpu_2d_readiness_wrapper=scripts/check/check-macos-vulkan-2d-live-evidence.shs"
    exit 0
fi

simple_bin=$(find_simple || true)
if [ -z "$simple_bin" ] && { [ -z "${SIMPLEOS_GPU_HOST_BIN:-}" ] || [ "${SIMPLEOS_HOST_GPU_USE_EXISTING_GUESTS:-0}" != 1 ]; }; then
    for isa in $GUEST_ISAS; do emit_row "$host" "$isa" blocked pure-simple-compiler-missing none; done
    echo "simpleos_qemu_host_gpu_2d_host=$host"
    echo "simpleos_qemu_host_gpu_2d_host_arch=$HOST_ARCH"
    echo "simpleos_qemu_host_gpu_2d_status=blocked"
    echo "simpleos_qemu_host_gpu_2d_reason=pure-simple-compiler-missing"
    exit 1
fi

default_daemon=$BUILD_DIR/simpleos_gpu_host
if [ "$host" = windows ]; then
    default_daemon=$BUILD_DIR/simpleos_gpu_host.exe
fi
daemon_entry=src/app/simpleos_gpu_host/main.spl
if [ "$host" = macos ]; then
    daemon_entry=src/app/simpleos_gpu_host/main_macos.spl
fi
daemon=${SIMPLEOS_GPU_HOST_BIN:-$default_daemon}
if [ -z "${SIMPLEOS_GPU_HOST_BIN:-}" ]; then
    runtime_reason=vulkan-cuda-runtime-artifact-missing
    if [ "$host" = macos ]; then
        runtime_reason=metal-runtime-artifact-missing
    elif [ "$host" = windows ]; then
        runtime_reason=directx-runtime-artifact-missing
    fi
    if [ "$host" = linux ] && ! prepare_linux_runtime; then
        runtime_provider_log=none
        [ ! -f "$BUILD_DIR/runtime-build.log" ] || runtime_provider_log="$BUILD_DIR/runtime-build.log"
        for isa in $GUEST_ISAS; do emit_row "$host" "$isa" blocked runtime-provider-closure-missing "$runtime_provider_log"; done
        echo "simpleos_qemu_host_gpu_2d_host=$host"
        echo "simpleos_qemu_host_gpu_2d_host_arch=$HOST_ARCH"
        echo "simpleos_qemu_host_gpu_2d_status=blocked"
        echo "simpleos_qemu_host_gpu_2d_reason=runtime-provider-closure-missing"
        exit 1
    fi
    if [ ! -d "$RUNTIME_PATH" ] || { [ "$host" = macos ] && ! core_c_bootstrap_runtime_available; }; then
        for isa in $GUEST_ISAS; do emit_row "$host" "$isa" blocked "$runtime_reason" none; done
        echo "simpleos_qemu_host_gpu_2d_host=$host"
        echo "simpleos_qemu_host_gpu_2d_host_arch=$HOST_ARCH"
        echo "simpleos_qemu_host_gpu_2d_status=blocked"
        echo "simpleos_qemu_host_gpu_2d_reason=$runtime_reason"
        exit 1
    fi
    if ! run_daemon_native_build \
        --backend cranelift --source src/app --source src/lib --entry-closure \
        --entry "$daemon_entry" --runtime-bundle core-c-bootstrap \
        --runtime-path "$RUNTIME_PATH" --cache-dir "$BUILD_DIR/daemon-cache" \
        --timeout 90 --output "$daemon" >"$BUILD_DIR/daemon-build.log" 2>&1
    then
        for isa in $GUEST_ISAS; do emit_row "$host" "$isa" blocked host-daemon-build-failed "$BUILD_DIR/daemon-build.log"; done
        echo "simpleos_qemu_host_gpu_2d_host=$host"
        echo "simpleos_qemu_host_gpu_2d_host_arch=$HOST_ARCH"
        echo "simpleos_qemu_host_gpu_2d_status=blocked"
        echo "simpleos_qemu_host_gpu_2d_reason=host-daemon-build-failed"
        exit 1
    fi
elif [ ! -x "$daemon" ]; then
    for isa in $GUEST_ISAS; do emit_row "$host" "$isa" blocked provided-host-daemon-missing none; done
    echo "simpleos_qemu_host_gpu_2d_host=$host"
    echo "simpleos_qemu_host_gpu_2d_host_arch=$HOST_ARCH"
    echo "simpleos_qemu_host_gpu_2d_status=blocked"
    echo "simpleos_qemu_host_gpu_2d_reason=provided-host-daemon-missing"
    exit 1
fi

if [ "$host" = macos ] && ! metal_guest_contract_available; then
    for isa in $GUEST_ISAS; do emit_row macos "$isa" blocked metal-guest-probe-contract-missing none; done
    echo "simpleos_qemu_host_gpu_2d_host=macos"
    echo "simpleos_qemu_host_gpu_2d_host_arch=$HOST_ARCH"
    echo "simpleos_qemu_host_gpu_2d_status=blocked"
    echo "simpleos_qemu_host_gpu_2d_reason=metal-guest-probe-contract-missing"
    echo "simpleos_qemu_host_gpu_2d_backend=metal"
    echo "simpleos_qemu_host_gpu_2d_processing_backend=metal"
    echo "simpleos_qemu_host_gpu_2d_rows=$GUEST_ISA_COUNT"
    echo "simpleos_qemu_host_gpu_2d_passed=0"
    echo "simpleos_qemu_host_gpu_2d_blocked=$GUEST_ISA_COUNT"
    echo "simpleos_qemu_host_gpu_2d_failed=0"
    echo "simpleos_qemu_host_gpu_2d_daemon=$daemon"
    exit 1
fi

build_guest() {
    isa=$1
    GUEST_BUILD_REASON=guest-build-failed
    GUEST_BUILD_LOG="$BUILD_DIR/$isa-build.log"
    if [ "${SIMPLEOS_HOST_GPU_USE_EXISTING_GUESTS:-0}" = 1 ]; then
        if [ ! -f "$(kernel_for_isa "$isa")" ]; then
            GUEST_BUILD_REASON=guest-artifact-missing
            GUEST_BUILD_LOG=$(kernel_for_isa "$isa")
            return 1
        fi
        if [ "$isa" = aarch64 ] && [ ! -f "$(arm64_production_kernel)" ]; then
            GUEST_BUILD_REASON=production-guest-artifact-missing
            GUEST_BUILD_LOG=$(arm64_production_kernel)
            return 1
        fi
        return 0
    fi
    mkdir -p build/os/generated/generated build/os
    cp src/generated/simpleos_log_config.spl build/os/generated/generated/simpleos_log_config.spl
    case "$isa" in
        x86_64)
            entry=examples/09_embedded/simple_os/arch/x86_64/host_gpu_smoke_entry.spl
            target=x86_64-unknown-none
            output=build/os/simpleos_x86_64_host_gpu_probe.elf
            linker=examples/09_embedded/simple_os/arch/x86_64/linker.ld
            set -- --cpu x86-64-v1
            ;;
        aarch64)
            entry=examples/09_embedded/simple_os/arch/arm64/host_gpu_smoke_entry.spl
            [ "$ACTIVE_HOST" != linux ] || entry=examples/09_embedded/simple_os/arch/arm64/host_gpu_vulkan_smoke_entry.spl
            [ "$ACTIVE_HOST" != macos ] || entry=examples/09_embedded/simple_os/arch/arm64/host_gpu_file_backed_ram_tail_smoke_entry.spl
            target=aarch64-unknown-none
            output=build/os/simpleos_arm64_host_gpu_probe.elf
            linker=examples/09_embedded/simple_os/arch/arm64/linker.ld
            set --
            ;;
        riscv64)
            entry=examples/09_embedded/simple_os/arch/riscv64/host_gpu_smoke_entry.spl
            target=riscv64-unknown-none
            output=build/os/simpleos_riscv64_host_gpu_probe.elf
            linker=examples/09_embedded/simple_os/arch/riscv64/linker.ld
            set --
            ;;
    esac
    rm -f "$output"
    if ! SIMPLE_BOOT_MINIMAL=1 SIMPLE_OS_LOG_MODE=on run_pinned_native_build \
        --source build/os/generated --source src/os --source src/lib \
        --source examples/09_embedded/simple_os --backend cranelift "$@" \
        --opt-level=aggressive --log on --entry-closure --entry "$entry" \
        --target "$target" -o "$output" --linker-script "$linker" \
        >"$GUEST_BUILD_LOG" 2>&1
    then
        return 1
    fi
    if [ "$isa" != aarch64 ]; then
        return 0
    fi
    GUEST_BUILD_REASON=production-guest-build-failed
    GUEST_BUILD_LOG="$BUILD_DIR/aarch64-production-build.log"
    rm -f build/os/simpleos_arm64_desktop_engine2d.elf
    production_entry=examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl
    [ "$ACTIVE_HOST" != linux ] || production_entry=examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop_linux_qemu.spl
    [ "$ACTIVE_HOST" != macos ] || production_entry=examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop_macos_qemu.spl
    SIMPLE_BOOTSTRAP=1 SIMPLE_ALLOW_FREESTANDING_STUBS=1 SIMPLE_OS_LOG_MODE=on run_pinned_native_build \
        --source build/os/generated --source src/os --source src/lib \
        --source examples/09_embedded/simple_os --backend cranelift \
        --opt-level=aggressive --log on --timeout 870 --entry-closure \
        --entry "$production_entry" \
        --target aarch64-unknown-none -o build/os/simpleos_arm64_desktop_engine2d.elf \
        --linker-script examples/09_embedded/simple_os/arch/arm64/linker.ld \
        >"$GUEST_BUILD_LOG" 2>&1
}

run_guest() {
    isa=$1
    qemu_bin=$(qemu_bin_for_isa "$isa")
    qemu_accel=$(qemu_accel_for_isa "$isa" "$qemu_bin")
    shm="$BUILD_DIR/$isa.shm"
    serial="$BUILD_DIR/$isa-serial.log"
    rss_file="$BUILD_DIR/$isa-rss-metrics"
    kernel=$(kernel_for_isa "$isa")
    new_daemon_instance "$BUILD_DIR" "$isa-daemon"
    rm -f "$shm" "$serial" "$rss_file"
    if [ "$ACTIVE_HOST:$isa" = macos:aarch64 ]; then
        size_macos_arm64_ram_tail_file "$shm"
        set -- "--shm=$shm" "--shm-offset=$MACOS_ARM64_RAM_TAIL_OFFSET"
    else
        size_shared_file "$shm"
        set -- "--shm=$shm"
    fi
    if [ "$PROCESSING_SELECTOR" = vulkan ]; then
        set -- "$@" --processing-backend=vulkan
    fi
    set -- "$@" --processing-verify-cpu
    "$daemon" "$@" >"$daemon_log" 2>&1 &
    daemon_pid=$!
    printf '%s\n' "$daemon_pid" >"$daemon_identity"
    if ! wait_for_daemon_selector "$daemon_pid" "$daemon_log" "$daemon_identity"; then
        cleanup_active_guest
        return 1
    fi
    case "$isa" in
        x86_64)
            set -- -machine q35 -accel "$qemu_accel" -m 512M -kernel "$kernel" -nographic -no-reboot \
                -device virtio-net-pci -object memory-backend-file,id=hostgpu,share=on,mem-path="$shm",size=8M \
                -device ivshmem-plain,memdev=hostgpu
            ;;
        aarch64)
            qemu_cpu=cortex-a72
            [ "$qemu_accel" = tcg ] || qemu_cpu=host
            if [ "$ACTIVE_HOST" = macos ]; then
                set -- -machine virt,memory-backend=guestmem -accel "$qemu_accel" -cpu "$qemu_cpu" -m 512M -kernel "$kernel" -nographic \
                    -device virtio-net-pci -object memory-backend-file,id=guestmem,share=on,mem-path="$shm",size=512M
            else
                set -- -machine virt -accel "$qemu_accel" -cpu "$qemu_cpu" -m 512M -kernel "$kernel" -nographic \
                    -device virtio-net-pci -object memory-backend-file,id=hostgpu,share=on,mem-path="$shm",size=8M \
                    -device ivshmem-plain,memdev=hostgpu
            fi
            ;;
        riscv64)
            set -- -machine virt -accel "$qemu_accel" -m 512M -kernel "$kernel" -nographic \
                -object memory-backend-file,id=hostgpu,share=on,mem-path="$shm",size=8M \
                -device ivshmem-plain,memdev=hostgpu
            ;;
    esac
    qemu_version=$("$qemu_bin" --version 2>&1 | sed -n '1p')
    qemu_device_args=$(encode_argv_hex "$@")
    if ! daemon_ready_for_qemu "$daemon_pid" "$daemon_log" "$daemon_identity"; then
        cleanup_active_guest
        return 1
    fi
    probe_qemu_lifetime_valid=0
    if run_qemu_with_rss "$QEMU_TIMEOUT" "$serial" "$daemon_pid" "$rss_file" "$qemu_bin" "$@"; then
        probe_qemu_lifetime_valid=1
    fi
    printf '\n%s\n' "HOST_GPU_QEMU_EXECUTION argv=$qemu_device_args" >>"$serial"
    if [ "$probe_qemu_lifetime_valid" = 1 ] && serial_has_pass "$serial" "$isa" "$qemu_device_args"; then probe_valid=1; else probe_valid=0; fi
    if [ "$probe_valid" = 1 ] &&
       processing_selector_evidence_valid "$daemon_log" "$PROCESSING_SELECTOR" &&
       processing_perf_evidence_valid "$serial" "$daemon_log" "$isa"
    then
        processing_perf_valid=1
    else
        processing_perf_valid=0
    fi
    production_serial=
    production_qemu_args=
    production_qemu_lifetime_valid=1
    if [ "$isa" = aarch64 ] && [ "$probe_valid" = 1 ]; then
        production_serial="$BUILD_DIR/aarch64-production-serial.log"
        rm -f "$production_serial"
        if [ "$ACTIVE_HOST" = macos ]; then
            set -- -machine virt,memory-backend=guestmem -accel "$qemu_accel" -cpu "$qemu_cpu" -m 512M -kernel "$(arm64_production_kernel)" -nographic \
                -device ramfb -device virtio-net-pci -object memory-backend-file,id=guestmem,share=on,mem-path="$shm",size=512M
        else
            set -- -machine virt -accel "$qemu_accel" -cpu "$qemu_cpu" -m 512M -kernel "$(arm64_production_kernel)" -nographic \
                -device ramfb -device virtio-net-pci -object memory-backend-file,id=hostgpu,share=on,mem-path="$shm",size=8M -device ivshmem-plain,memdev=hostgpu
        fi
        production_qemu_args=$(encode_argv_hex "$@")
        if ! daemon_ready_for_qemu "$daemon_pid" "$daemon_log" "$daemon_identity"; then
            cleanup_active_guest
            return 1
        fi
        production_qemu_lifetime_valid=0
        if run_qemu_with_rss "$PRODUCTION_QEMU_TIMEOUT" "$production_serial" "$daemon_pid" "$rss_file" "$qemu_bin" "$@"; then
            production_qemu_lifetime_valid=1
        fi
        printf '\n%s\n' "HOST_GPU_QEMU_EXECUTION argv=$production_qemu_args" >>"$production_serial"
    fi
    cleanup_active_guest
    daemon_rss_kib=$(rss_metric_value "$rss_file" daemon_max_rss_kib || true)
    qemu_rss_kib=$(rss_metric_value "$rss_file" qemu_max_rss_kib || true)
    combined_rss_kib=$(rss_metric_value "$rss_file" combined_max_rss_kib || true)
    if qemu_argv_evidence_valid "$isa" "$qemu_device_args"; then qemu_args_valid=1; else qemu_args_valid=0; fi
    if row_rss_evidence_valid "$daemon_rss_kib" "$qemu_rss_kib" "$combined_rss_kib"; then
        execution_evidence_valid=1
    else
        execution_evidence_valid=0
    fi
    if [ -z "$qemu_version" ] || [ "$qemu_args_valid" != 1 ]; then
        execution_evidence_valid=0
    fi
    production_valid=1
    production_args_valid=1
    if [ "$isa" = aarch64 ]; then
        production_valid=0
        production_args_valid=0
        if [ -n "$production_qemu_args" ] && qemu_argv_evidence_valid aarch64 "$production_qemu_args" production; then
            production_args_valid=1
        fi
        if [ "$production_args_valid" = 1 ] && arm64_production_evidence_valid "$serial" "$qemu_device_args" "$production_serial" "$production_qemu_args"; then
            production_valid=1
        fi
    fi
    if [ "$probe_valid" = 1 ] && [ "$processing_perf_valid" = 1 ] && [ "$execution_evidence_valid" = 1 ] && [ "$production_valid" = 1 ] && [ "$production_qemu_lifetime_valid" = 1 ]; then
        emit_row "$host" "$isa" pass ok "$serial" "$(serial_processing_backend "$serial" "$isa")"
        emit_render_latency_evidence "$host" "$isa" "$serial" "$qemu_device_args"
        emit_processing_perf_evidence "$host" "$isa" "$serial" "$daemon_log"
        row_result=0
    elif [ "$probe_qemu_lifetime_valid" != 1 ] || [ "$(rss_metric_value "$rss_file" daemon_lifetime || true)" = failed ]; then
        emit_row "$host" "$isa" fail daemon-exited-during-qemu "$serial" "$(serial_processing_backend "$serial" "$isa")"
        row_result=1
    elif [ "$probe_valid" != 1 ]; then
        emit_row "$host" "$isa" fail "$(serial_reason "$serial" "$isa")" "$serial"
        row_result=1
    elif [ "$processing_perf_valid" != 1 ]; then
        emit_row "$host" "$isa" fail processing-perf-evidence-missing "$serial" "$(serial_processing_backend "$serial" "$isa")"
        row_result=1
    elif [ "$execution_evidence_valid" != 1 ]; then
        emit_row "$host" "$isa" fail execution-evidence-missing "$serial" "$(serial_processing_backend "$serial" "$isa")"
        row_result=1
    elif [ "$production_args_valid" != 1 ]; then
        emit_row "$host" "$isa" fail production-execution-evidence-missing "$production_serial" "$(serial_processing_backend "$serial" "$isa")"
        row_result=1
    elif [ "$production_qemu_lifetime_valid" != 1 ]; then
        emit_row "$host" "$isa" fail daemon-exited-during-qemu "$production_serial" "$(serial_processing_backend "$serial" "$isa")"
        row_result=1
    else
        emit_row "$host" "$isa" fail production-frame-evidence-missing "$production_serial" "$(serial_processing_backend "$serial" "$isa")"
        row_result=1
    fi
    emit_row_execution_evidence "$host" "$isa" "$qemu_version" "$qemu_device_args" \
        "${daemon_rss_kib:-unknown}" "${qemu_rss_kib:-unknown}" "${combined_rss_kib:-unknown}"
    if [ "$isa" = aarch64 ] && [ -n "$production_qemu_args" ]; then
        emit_arm64_production_evidence "$host" "$production_serial" "$production_qemu_args"
    fi
    return "$row_result"
}

overall=pass
passed=0
blocked=0
failed=0
TIMEOUT_BIN=$(find_timeout || true)
for isa in $GUEST_ISAS; do
    qemu_bin=$(qemu_bin_for_isa "$isa")
    case "$isa" in x86_64) qemu_machine=q35 ;; *) qemu_machine=virt ;; esac
    if [ -z "$TIMEOUT_BIN" ]; then
        emit_row "$host" "$isa" blocked timeout-command-missing none
        overall=fail
        blocked=$((blocked + 1))
        continue
    fi
    if ! command -v "$qemu_bin" >/dev/null 2>&1; then
        emit_row "$host" "$isa" blocked qemu-binary-missing none
        overall=fail
        blocked=$((blocked + 1))
        continue
    fi
    if ! qemu_capabilities_available "$isa" "$qemu_bin" "$qemu_machine"; then
        emit_row "$host" "$isa" blocked qemu-host-gpu-capability-missing "$BUILD_DIR/qemu-capabilities/$isa-devices.log"
        overall=fail
        blocked=$((blocked + 1))
        continue
    fi
    if ! build_guest "$isa"; then
        emit_row "$host" "$isa" fail "$GUEST_BUILD_REASON" "$GUEST_BUILD_LOG"
        overall=fail
        failed=$((failed + 1))
        continue
    fi
    if ! run_guest "$isa"; then
        overall=fail
        failed=$((failed + 1))
    else
        passed=$((passed + 1))
    fi
done

reported_overall=$overall
reported_reason=$(if [ "$overall" = pass ]; then echo "all-$host-host-gpu-rows-pass"; else echo "one-or-more-$host-host-gpu-rows-failed"; fi)
if [ "$ALLOW_BOOTSTRAP_DIAGNOSTIC" = 1 ]; then
    reported_overall=diagnostic
    reported_reason="diagnostic-phase2-non-attested-$overall"
    echo "simpleos_qemu_host_gpu_2d_evidence_class=diagnostic-phase2-non-attested"
    echo "simpleos_qemu_host_gpu_2d_attestation_status=not-claimed"
fi
echo "simpleos_qemu_host_gpu_2d_status=$reported_overall"
echo "simpleos_qemu_host_gpu_2d_host=$host"
echo "simpleos_qemu_host_gpu_2d_host_arch=$HOST_ARCH"
echo "simpleos_qemu_host_gpu_2d_reason=$reported_reason"
echo "simpleos_qemu_host_gpu_2d_backend=$BACKEND"
echo "simpleos_qemu_host_gpu_2d_processing_backend=$PROCESSING_BACKEND"
echo "simpleos_qemu_host_gpu_2d_processing_selector=$PROCESSING_SELECTOR"
echo "simpleos_qemu_host_gpu_2d_rows=$GUEST_ISA_COUNT"
echo "simpleos_qemu_host_gpu_2d_passed=$passed"
echo "simpleos_qemu_host_gpu_2d_blocked=$blocked"
echo "simpleos_qemu_host_gpu_2d_failed=$failed"
echo "simpleos_qemu_host_gpu_2d_daemon=$daemon"
[ "$overall" = pass ]
