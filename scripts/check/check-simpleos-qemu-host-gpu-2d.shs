       negotiation_timing_evidence_valid "$missing_attempt_log" aarch64 probe native-isa vulkan ||
       negotiation_timing_evidence_valid "$duplicate_attempt_log" aarch64 probe native-isa vulkan ||
       negotiation_timing_evidence_valid "$stale_attempt_log" aarch64 probe native-isa vulkan ||
       negotiation_timing_evidence_valid "$wrong_attempt_status_log" aarch64 probe native-isa vulkan ||
       negotiation_timing_evidence_valid "$wrong_attempt_reason_log" aarch64 probe native-isa vulkan ||
       negotiation_timing_evidence_valid "$wrong_timeout_reason_log" aarch64 probe native-isa vulkan ||
       negotiation_timing_evidence_valid "$budget_negotiation_log" aarch64 probe native-isa vulkan ||
       negotiation_timing_evidence_valid "$wrong_budget_log" aarch64 probe native-isa vulkan ||
       negotiation_timing_evidence_valid "$undercounted_elapsed_log" aarch64 probe native-isa vulkan ||
       negotiation_timing_evidence_valid "$wrong_attempt_order_log" aarch64 probe native-isa vulkan ||
       negotiation_timing_evidence_valid "$late_map_log" aarch64 probe native-isa vulkan ||
       negotiation_timing_evidence_valid "$invalid_alias_log" aarch64 probe native-isa vulkan ||
