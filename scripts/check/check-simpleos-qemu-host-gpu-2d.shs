    negotiation_timing_evidence_valid "$stale_negotiation_log" aarch64 probe native-isa vulkan
    negotiation_timing_evidence_valid "$zero_attempt_fallback_log" aarch64 probe native-isa vulkan
    if negotiation_timing_evidence_valid "$over_budget_log" aarch64 probe native-isa vulkan ||
