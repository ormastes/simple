        -e "s|simpleos_qemu_host_gpu_2d_linux_x86_64_qemu_device_args=$x86_qemu_args|simpleos_qemu_host_gpu_2d_linux_x86_64_qemu_device_args=$x86_native_qemu_args|" \
        -e 's/simpleos_qemu_host_gpu_2d_linux_x86_64_render_readback_p95_us=16000/simpleos_qemu_host_gpu_2d_linux_x86_64_render_readback_p95_us=16700/' \
        -e 's/simpleos_qemu_host_gpu_2d_linux_x86_64_render_latency_applicability=cross-isa-tcg-correctness-only/simpleos_qemu_host_gpu_2d_linux_x86_64_render_latency_applicability=native-isa/' \
