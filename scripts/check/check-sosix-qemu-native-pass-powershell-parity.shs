#!/bin/sh
# Static parity guard for hosts where PowerShell is unavailable.
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
unix=$repo_root/scripts/check/produce-sosix-qemu-native-pass-bundle.shs
ps=$repo_root/scripts/check/produce-sosix-qemu-native-pass-bundle.ps1
wrapper=$repo_root/scripts/check/check-sosix-qemu-matrix.ps1
policy=$repo_root/scripts/check/lib/sosix-qemu-compiler-designation-v1.tsv
helper=$repo_root/scripts/check/lib/sosix-qemu-compiler-designation.shs
ps_policy=$repo_root/scripts/check/lib/sosix-qemu-compiler-designation.ps1
for token in schema_version source_identity compiler_identity compiler_payload_identity compiler_image_identity compiler_alias_identity compiler_manifest_identity kernel_identity image_identity qemu_identity qemu_argv accelerator_identity firmware_identity firmware_mode firmware_path firmware_version firmware_sha256 firmware_stage_markers boot_correlation_marker run_nonce transcript_identity program_identity compiler_in_filesystem compiler_designation_scope compiler_version_evidence_path compiler_hello_evidence_path compiler_alias_evidence_path compiler_manifest_evidence_path artifact_count host-admission.env qemu.argv qemu.version transcript.log kernel.elf guest.img program.elf firmware.bin required-markers.txt compiler-version.txt compiler-hello.txt compiler-aliases.txt compiler-manifest.env; do
    grep -F "$token" "$unix" >/dev/null
    grep -F "$token" "$ps" >/dev/null
done
SOSIX_QEMU_COMPILER_DESIGNATION_POLICY=$policy
export SOSIX_QEMU_COMPILER_DESIGNATION_POLICY
. "$helper"
sosix_qemu_compiler_designation_policy_validate "$policy"
cells=0
for host in linux windows macos freebsd; do
    for guest in x86_32 x86_64 arm32 arm64 riscv32 riscv64; do
        expected=$(awk -F'|' -v h="$host" -v g="$guest" '$1==h && $2==g {print $3}' "$policy")
        actual=$(sosix_qemu_compiler_designation_live "$host" "$guest")
        [ "$actual" = "$expected" ]
        cells=$((cells + 1))
    done
done
[ "$cells" -eq 24 ]
grep -F 'Read-SosixQemuCompilerDesignationPolicy' "$ps" >/dev/null
grep -F 'Read-SosixQemuCompilerDesignationPolicy' "$wrapper" >/dev/null
grep -F 'sosix-qemu-compiler-designation-v1.tsv' "$ps" >/dev/null
grep -F 'sosix-qemu-compiler-designation-v1.tsv' "$wrapper" >/dev/null
! grep -F '$liveCompilerDesignation = "false"' "$ps" >/dev/null
grep -F 'Publish-NativePass $row' "$wrapper" >/dev/null
grep -F 'native-pass-publication-failed:' "$wrapper" >/dev/null
grep -F 'produce-sosix-qemu-native-pass-bundle.ps1' "$wrapper" >/dev/null
grep -F 'QEMU binary changed after admission' "$ps" >/dev/null
grep -F 'execution nonce must occur only after guest-entry' "$ps" >/dev/null
grep -F 'boot-correlation marker must occur as exactly one complete line' "$ps" >/dev/null
grep -F 'firmware stage must occur as exactly one complete line' "$ps" >/dev/null
grep -F 'source worktree is not clean' "$ps" >/dev/null
grep -F 'CompilerInFilesystem' "$ps" >/dev/null
grep -F 'CompilerVersionEvidence' "$ps" >/dev/null
grep -F 'CompilerHelloEvidence' "$ps" >/dev/null
grep -F 'CompilerAliasEvidence' "$ps" >/dev/null
grep -F 'CompilerManifestEvidence' "$ps" >/dev/null
grep -F 'BootCorrelationMarker' "$ps" >/dev/null
grep -F 'CompilerInFilesystem' "$wrapper" >/dev/null
grep -F 'BootCorrelationMarker=$d.boot_correlation_marker' "$wrapper" >/dev/null
grep -F 'Assert-CurrentGuestReceipt' "$wrapper" >/dev/null
grep -F 'native-pass-receipt-stale' "$wrapper" >/dev/null
grep -F 'kernel_identity' "$wrapper" >/dev/null
grep -F 'image_identity' "$wrapper" >/dev/null
grep -F 'SOSIX_QEMU_NONCE' "$wrapper" >/dev/null
grep -F 'CompilerAliasEvidence=$compilerAliasPath' "$wrapper" >/dev/null
grep -F 'CompilerManifestEvidence=$compilerManifestPath' "$wrapper" >/dev/null
if ! command -v pwsh >/dev/null 2>&1; then
    echo 'sosix_qemu_native_pass_powershell_static_parity=pass'
    echo 'sosix_qemu_native_pass_powershell_policy_status=BLOCKED'
    echo 'sosix_qemu_native_pass_powershell_policy_reason=pwsh-unavailable'
    exit 2
fi
work=$(mktemp -d "${TMPDIR:-/tmp}/sosix-powershell-policy.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
LC_ALL=C sort "$policy" > "$work/expected"
pwsh -NoProfile -File "$ps_policy" -Dump -Consumer producer -PolicyPath "$policy" > "$work/producer-decisions"
cmp "$work/expected" "$work/producer-decisions"
pwsh -NoProfile -File "$ps_policy" -Dump -Consumer matrix -PolicyPath "$policy" > "$work/matrix-decisions"
cmp "$work/expected" "$work/matrix-decisions"
cp "$policy" "$work/duplicate"; sed -n '1p' "$policy" >> "$work/duplicate"
sed '$d' "$policy" > "$work/missing"
sed '1s/false$/invalid/' "$policy" > "$work/malformed"
for bad in duplicate missing malformed; do
    if pwsh -NoProfile -File "$ps_policy" -Dump -PolicyPath "$work/$bad" > "$work/$bad.out" 2>&1; then
        echo "FAIL: PowerShell accepted $bad designation policy" >&2
        exit 1
    fi
done
echo 'sosix_qemu_native_pass_powershell_policy_cells=24'
echo 'sosix_qemu_native_pass_powershell_static_parity=pass'
