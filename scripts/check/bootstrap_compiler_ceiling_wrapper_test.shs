#!/bin/sh
# @req BOOTSTRAP-COMPILER-HEADROOM-001
# Test actual wrapper argv/environment with the real policy and an inert guard.
set -eu
PATH=/usr/bin:/bin
export PATH
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/compiler-ceiling-wrapper.XXXXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
mkdir -p "$tmp/repo/scripts/bootstrap/lib" "$tmp/repo/scripts/resource" "$tmp/bin"
cp "$root/scripts/bootstrap/run-process-group-timeout.shs" "$tmp/repo/scripts/bootstrap/"
cp "$root/scripts/bootstrap/lib/tree-rss-policy.shs" "$tmp/repo/scripts/bootstrap/lib/"
cat >"$tmp/repo/scripts/resource/process-tree-rss-watchdog.pl" <<'PERL'
use strict; use warnings;
print join("\n", @ARGV), "\n";
print "ceiling_env=", ($ENV{SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB}//'absent'), "\n";
print "cap_env=", ($ENV{SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB}//'absent'), "\n";
PERL
wrapper=$tmp/repo/scripts/bootstrap/run-process-group-timeout.shs
export TMPDIR=$tmp
unset SIMPLE_BOOTSTRAP_SESSION_ID SIMPLE_BOOTSTRAP_SESSION_EXEC
unset SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB SIMPLE_PROCESS_TREE_RSS_CAP_KIB
export SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB=524288 SIMPLE_BOOTSTRAP_RSS_CAP_MODE=enforce
sh "$wrapper" 10 1 compiler check src >"$tmp/legacy"
grep -q '^--max-rss-kib=524288$' "$tmp/legacy"
grep -q '^cap_env=524288$' "$tmp/legacy"
export SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB=12582912 SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB=12582912
sh "$wrapper" 10 1 compiler native-build --threads 8 >"$tmp/native"
grep -q '^--compiler-ceiling-kib=12582912$' "$tmp/native"
grep -q '^--compiler-jobs=8$' "$tmp/native"
grep -q '^--max-rss-kib=12582912$' "$tmp/native"
grep -q '^ceiling_env=12582912$' "$tmp/native"
sh "$wrapper" 10 1 compiler check src >"$tmp/helper"
grep -q '^--max-rss-kib=5859375$' "$tmp/helper"
grep -q '^ceiling_env=absent$' "$tmp/helper"
grep -q '^cap_env=absent$' "$tmp/helper"
! grep -q '^--compiler-ceiling-kib=' "$tmp/helper"
export SIMPLE_PROCESS_TREE_RSS_CAP_KIB=524288
sh "$wrapper" 10 1 compiler test spec >"$tmp/generic"
grep -q '^--max-rss-kib=524288$' "$tmp/generic"
reject() {
  if sh "$wrapper" 10 1 "$@" >"$tmp/refusal" 2>&1; then
    echo 'FAIL wrapper accepted invalid policy' >&2; exit 1
  else status=$?; fi
  [ "$status" = 125 ]
}
reject compiler native-build
export SIMPLE_PROCESS_TREE_RSS_CAP_KIB=999999999999999
reject compiler test spec
unset SIMPLE_PROCESS_TREE_RSS_CAP_KIB
export SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB=012582912
reject compiler check src
export SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB=12582912 SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB=12582913
reject compiler check src
unset SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB
reject compiler check src
printf 'PASS: 9 compiler/helper wrapper transport cases; no workload executed\n'
