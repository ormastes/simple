#!/bin/sh
# Fail-closed binding between a signed external target and a performance lane's
# closed environment receipt. This runs before expensive artifact validation.
set -eu
LC_ALL=C
export LC_ALL

GATE=""; RUN_ID=""; TARGET=""; ENVIRONMENT=""
fail() { echo "STATUS: FAIL performance-target-identity — $*" >&2; exit 1; }
while [ "$#" -gt 0 ]; do
    case "$1" in
        --gate) GATE=$2; shift 2 ;;
        --run-id) RUN_ID=$2; shift 2 ;;
        --target) TARGET=$2; shift 2 ;;
        --environment) ENVIRONMENT=$2; shift 2 ;;
        *) fail "unknown-argument-$1" ;;
    esac
done
[ "$GATE" = rust-go-benchmark-parity ] && [ -n "$RUN_ID" ] || fail unsupported-or-missing-identity
for file in "$TARGET" "$ENVIRONMENT"; do [ -f "$file" ] && [ ! -L "$file" ] || fail missing-evidence-blob; done
field() { [ "$(grep -c "^$2=" "$1" 2>/dev/null || true)" -eq 1 ] || return 1; sed -n "s/^$2=//p" "$1"; }
eqf() { value=$(field "$1" "$2") || fail "missing-$2"; [ "$value" = "$3" ] || fail "$2"; }
token() { value=$(field "$1" "$2") || fail "missing-$2"; case "$value" in ''|*[!A-Za-z0-9._:@+/-]*) fail "invalid-$2" ;; esac; printf %s "$value"; }

[ "$(wc -l <"$TARGET" | tr -d ' ')" -eq 6 ] || fail target-field-count
eqf "$TARGET" evidence_schema simple.must-check-target/v1
eqf "$TARGET" gate_id "$GATE"
eqf "$TARGET" run_id "$RUN_ID"
eqf "$TARGET" target_kind native-host
target_id=$(token "$TARGET" target_id)
eqf "$TARGET" final_verdict PASS

[ "$(wc -l <"$ENVIRONMENT" | tr -d ' ')" -eq 23 ] || fail environment-field-count
eqf "$ENVIRONMENT" environment_schema simple.rust-go-benchmark-environment/v1
eqf "$ENVIRONMENT" gate_id "$GATE"
eqf "$ENVIRONMENT" run_id "$RUN_ID"
eqf "$ENVIRONMENT" os linux
host_id=$(token "$ENVIRONMENT" host_id)
[ "$target_id" = "$host_id" ] || fail target-environment-host-mismatch

echo "STATUS: PASS performance-target-identity — gate=$GATE target=$target_id"
