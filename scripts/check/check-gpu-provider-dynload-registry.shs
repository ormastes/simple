#!/bin/sh
# Prove that core-C opens a GPU provider explicitly, validates its ABI/backend,
# resolves probe symbols against that handle, and has no provider link edge.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
TMP_BASE="${TMPDIR:-/tmp}"
TMP="$(mktemp -d "$TMP_BASE/simple-gpu-provider-registry.XXXXXX")"
cleanup() {
    case "$TMP" in
        "$TMP_BASE"/simple-gpu-provider-registry.*) rm -rf "$TMP" ;;
        *) exit 2 ;;
    esac
}
trap cleanup EXIT HUP INT TERM

cat >"$TMP/provider.c" <<'EOF'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
/* An external marker observes mapping without invoking a demanding getter. */
static void provider_lifetime_marker(char event) {
    const char *path = getenv("SIMPLE_TEST_PROVIDER_LIFETIME_MARKER");
    FILE *marker;
    if (!path || !*path) return;
    marker = fopen(path, "ab");
    if (!marker || fputc(event, marker) == EOF || fclose(marker) != 0) abort();
}
__attribute__((constructor)) static void provider_loaded_marker(void) {
    provider_lifetime_marker('C');
}
__attribute__((destructor)) static void provider_unloaded_marker(void) {
    provider_lifetime_marker('D');
}
#ifndef PROVIDER_ABI
#define PROVIDER_ABI 1
#endif
#ifndef PROVIDER_DEVICE_COUNT
#define PROVIDER_DEVICE_COUNT 7
#endif
#ifndef PROVIDER_BUFFER_HANDLE
#define PROVIDER_BUFFER_HANDLE 73
#endif
int64_t rt_simple_gpu_provider_abi_version(void) { return PROVIDER_ABI; }
int64_t rt_simple_gpu_provider_backend_bits(void) { return 2; }
int64_t rt_vulkan_provider_is_available(void) { return 1; }
int64_t rt_vulkan_provider_device_count(void) { return PROVIDER_DEVICE_COUNT; }
int32_t rt_vk_provider_available(void) { return 1; }
int64_t rt_vulkan_init(void) { return 1; }
int64_t rt_vulkan_alloc_buffer(int64_t size, int64_t usage) {
    return size == 4096 && usage == 3 ? PROVIDER_BUFFER_HANDLE : 0;
}
#define STUB(name) int64_t name(void) { return 1; }
STUB(rt_vulkan_shutdown)
STUB(rt_vulkan_select_device)
STUB(rt_vulkan_free_buffer)
STUB(rt_vulkan_copy_to_buffer_raw)
STUB(rt_vulkan_copy_from_buffer_raw)
STUB(rt_vulkan_copy_from_buffer_strided_raw)
STUB(rt_vulkan_copy_from_buffer_regions_raw)
STUB(rt_vulkan_compile_spirv_raw)
STUB(rt_vulkan_destroy_shader)
#ifndef OMIT_PIPELINE_RAW
STUB(rt_vulkan_create_compute_pipeline_raw)
#endif
STUB(rt_vulkan_destroy_pipeline)
STUB(rt_vulkan_create_descriptor_set)
STUB(rt_vulkan_bind_buffer)
STUB(rt_vulkan_destroy_descriptor_set)
STUB(rt_vulkan_begin_compute)
STUB(rt_vulkan_bind_pipeline)
STUB(rt_vulkan_bind_descriptors)
STUB(rt_vulkan_push_constants_raw)
STUB(rt_vulkan_dispatch)
STUB(rt_vulkan_end_compute)
STUB(rt_vulkan_discard_command)
STUB(rt_vulkan_fence_submission_supported)
STUB(rt_vulkan_accepted_compute_submit_count)
STUB(rt_vulkan_submit_and_wait_fence)
STUB(rt_vulkan_submit_no_wait)
STUB(rt_vulkan_wait_fence)
STUB(rt_vulkan_destroy_fence)
STUB(rt_vulkan_wait_idle)
STUB(rt_vulkan_device_name)
STUB(rt_vulkan_device_type)
STUB(rt_vulkan_selected_device_type)
STUB(rt_vulkan_device_driver_identity)
STUB(rt_vulkan_selected_device_driver_identity)
STUB(rt_vulkan_selected_device_driver_identity_hash)
STUB(rt_vulkan_get_last_error)
STUB(rt_vulkan_init_headless_present)
STUB(rt_vulkan_init_window_present)
STUB(rt_vulkan_init_external_window_present)
STUB(rt_vulkan_present_buffer)
STUB(rt_vulkan_present_buffer_regions_raw)
STUB(rt_vulkan_last_present_copy_bytes)
STUB(rt_vulkan_last_present_copy_rects)
STUB(rt_vulkan_destroy_swapchain)
EOF

cat >"$TMP/cuda_provider.c" <<'EOF'
#include <stdint.h>
#include <string.h>
int64_t rt_simple_gpu_provider_abi_version(void) { return 1; }
int64_t rt_simple_gpu_provider_backend_bits(void) { return 1; }
int64_t rt_cuda_provider_available(void) { return 1; }
int64_t rt_cuda_provider_device_count(void) { return 1; }
int64_t rt_cuda_init(void) { return 0; }
int64_t rt_cuda_mem_alloc(int64_t size) { return size == 16 ? 91 : -1; }
int64_t rt_cuda_memset_d32(int64_t ptr, int64_t pattern, int64_t count) {
    return ptr == 91 && pattern == 0x5a5a5a5a && count == 4 ? 0 : -1;
}
int64_t rt_cuda_memcpy_dtoh(int64_t dst, int64_t src, int64_t size) {
    if (!dst || src != 91 || size != 16) return -1;
    memset((void *)(intptr_t)dst, 0x5a, 16);
    return 0;
}
/* Device queries answer only for the expected handle so the harness proves
 * each forwarder passes its argument through, not merely that it links. */
int64_t rt_cuda_device_get(int64_t id) { return id == 0 ? 5 : -1; }
int64_t rt_cuda_device_compute_capability(int64_t device) { return device == 5 ? 121 : -1; }
int64_t rt_cuda_device_identity(int64_t device) { return device == 5 ? 77 : 0; }
int64_t rt_cuda_f64_slice_2d(int64_t a1, int64_t a2, int64_t a3, int64_t a4, int64_t a5,
        int64_t a6, int64_t a7, int64_t a8, int64_t a9) {
    return a1 + 2 * a2 + 3 * a3 + 4 * a4 + 5 * a5 + 6 * a6 + 7 * a7 + 8 * a8 + 9 * a9;
}
int64_t rt_cuda_module_load_data(const uint8_t *ptx, uint64_t len) {
    return ptx && len == 3 && memcmp(ptx, "ptx", 3) == 0 ? 3 : -1;
}
int64_t rt_cuda_launch_kernel(int64_t module, const uint8_t *name, uint64_t len,
        int64_t gx, int64_t gy, int64_t gz, int64_t bx, int64_t by, int64_t bz, int64_t args) {
    if (!name || len != 4 || memcmp(name, "kern", 4) != 0) return -1;
    return module + 2 * gx + 3 * gy + 4 * gz + 5 * bx + 6 * by + 7 * bz + 8 * args;
}
const char fake_cuda_name_storage[] = "fake-cuda";
#ifdef REENTRANT_LOAD
#include <dlfcn.h>
/* A provider constructor that calls back into the loader it is being loaded
 * by: the loader thread must not wait on itself. */
int64_t fake_reentry_result = 99;
__attribute__((constructor)) static void reentrant_provider_load(void) {
    int64_t (*init)(void) = (int64_t (*)(void))dlsym(RTLD_DEFAULT, "rt_cuda_init");
    fake_reentry_result = init ? init() : 98;
}
#endif
#ifdef SLOW_LOAD
#include <dlfcn.h>
#include <stdatomic.h>
#include <time.h>
/* Widens the LOADING window so a second thread's first call lands in it,
 * and tells the harness (if it exports the flag) that LOADING has begun. */
__attribute__((constructor)) static void slow_provider_load(void) {
    struct timespec delay = {0, 200000000};
    atomic_int *started = (atomic_int *)dlsym(RTLD_DEFAULT, "fake_loading_started");
    if (started) atomic_store(started, 1);
    nanosleep(&delay, 0);
}
#endif
#define STUB(name) int64_t name(void) { return 0; }
STUB(rt_cuda_ctx_create)
STUB(rt_cuda_ctx_set_current)
STUB(rt_cuda_ctx_destroy)
STUB(rt_cuda_ctx_synchronize)
STUB(rt_cuda_mem_free)
STUB(rt_cuda_memcpy_htod)
#ifndef OMIT_CUDA_DTOD
STUB(rt_cuda_memcpy_dtod)
#endif
STUB(rt_cuda_memset)
STUB(rt_cuda_module_load_data_bytes)
STUB(rt_cuda_module_unload)
STUB(rt_cuda_launch_kernel_name)
STUB(rt_cuda_sync)
const char *rt_cuda_device_name(int64_t device) { return device == 5 ? fake_cuda_name_storage : "bad"; }
const char *rt_cuda_get_error_string(int64_t code) { (void)code; return "fake-error"; }
EOF

cat >"$TMP/cuda_harness.c" <<'EOF'
#include <dlfcn.h>
#include <pthread.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <stdatomic.h>
#include <string.h>
#include <sys/wait.h>
#include <time.h>
#include <unistd.h>
int64_t rt_gpu_provider_loaded(int64_t);
int64_t rt_cuda_available(void);
int64_t rt_cuda_init(void);
int64_t rt_cuda_mem_alloc(int64_t);
int64_t rt_cuda_memset_d32(int64_t, int64_t, int64_t);
int64_t rt_cuda_memcpy_dtoh(int64_t, int64_t, int64_t);
int64_t rt_cuda_device_get(int64_t);
int64_t rt_cuda_device_compute_capability(int64_t);
int64_t rt_cuda_device_identity(int64_t);
const char *rt_cuda_device_name(int64_t);
const char *rt_cuda_get_error_string(int64_t);
int64_t rt_cuda_f64_slice_2d(int64_t, int64_t, int64_t, int64_t, int64_t,
    int64_t, int64_t, int64_t, int64_t);
int64_t rt_cuda_module_load_data(const uint8_t *, uint64_t);
int64_t rt_cuda_launch_kernel(int64_t, const uint8_t *, uint64_t, int64_t, int64_t,
    int64_t, int64_t, int64_t, int64_t, int64_t);
atomic_int fake_loading_started;
static int64_t race_results[2];
static void *race_init(void *slot) {
    *(int64_t *)slot = rt_cuda_init();
    return 0;
}
int main(int argc, char **argv) {
    uint32_t words[4] = {0, 0, 0, 0};
    int64_t ptr;
    int64_t fill;
    int64_t dtoh;
    int64_t device;
    const char *name;
    void *provider;
    if (argc < 2 || setenv("SIMPLE_CUDA_PROVIDER_PATH", argv[1], 1) != 0) return 2;
    if (argc == 3 && strcmp(argv[2], "race") == 0) {
        /* Two first calls at once: the one that finds LOADING must wait. */
        pthread_t a, b;
        if (pthread_create(&a, 0, race_init, &race_results[0]) != 0 ||
                pthread_create(&b, 0, race_init, &race_results[1]) != 0) return 2;
        pthread_join(a, 0);
        pthread_join(b, 0);
        printf("race=%lld,%lld\n", (long long)race_results[0], (long long)race_results[1]);
        return 0;
    }
    if (argc == 3 && strcmp(argv[2], "reentry") == 0) {
        int64_t init_rc;
        alarm(5);
        init_rc = rt_cuda_init();
        provider = dlopen(argv[1], RTLD_NOW | RTLD_NOLOAD);
        printf("reentry=%lld init=%lld\n",
            provider && dlsym(provider, "fake_reentry_result") ?
                (long long)*(int64_t *)dlsym(provider, "fake_reentry_result") : -1LL,
            (long long)init_rc);
        return 0;
    }
    if (argc == 3 && strcmp(argv[2], "fork") == 0) {
        /* Fork while another thread is LOADING: the child can never see that
         * load finish, so its first call must answer "unavailable" (3), not
         * hang. alarm() turns a hang into SIGALRM. */
        pthread_t a;
        struct timespec poll = {0, 1000000};
        int waited = 0;
        int status = 0;
        pid_t child;
        if (pthread_create(&a, 0, race_init, &race_results[0]) != 0) return 2;
        /* Fork only once the provider constructor reports LOADING. */
        while (!atomic_load(&fake_loading_started) && waited++ < 5000) nanosleep(&poll, 0);
        if (!atomic_load(&fake_loading_started)) return 2;
        child = fork();
        if (child == 0) {
            alarm(5);
            _exit((int)rt_cuda_init());
        }
        if (child < 0 || waitpid(child, &status, 0) != child) return 2;
        pthread_join(a, 0);
        printf("fork_child=%s parent=%lld\n",
            WIFEXITED(status) ? (WEXITSTATUS(status) == 3 ? "3" : "other") : "killed",
            (long long)race_results[0]);
        return 0;
    }
    ptr = rt_cuda_mem_alloc(16);
    fill = rt_cuda_memset_d32(ptr, 0x5a5a5a5a, 4);
    dtoh = rt_cuda_memcpy_dtoh((int64_t)(intptr_t)words, ptr, 16);
    printf("loaded=%lld available=%lld init=%lld ptr=%lld fill=%lld dtoh=%lld word=%08x\n",
        (long long)rt_gpu_provider_loaded(1), (long long)rt_cuda_available(),
        (long long)rt_cuda_init(), (long long)ptr,
        (long long)fill, (long long)dtoh, words[0]);
    device = rt_cuda_device_get(0);
    printf("dev=%lld cc=%lld id=%lld name=%s err=%s slice2d=%lld module=%lld\n",
        (long long)device, (long long)rt_cuda_device_compute_capability(device),
        (long long)rt_cuda_device_identity(device), rt_cuda_device_name(device),
        rt_cuda_get_error_string(-100),
        (long long)rt_cuda_f64_slice_2d(1, 2, 3, 4, 5, 6, 7, 8, 9),
        (long long)rt_cuda_module_load_data((const uint8_t *)"ptx", 3));
    /* The returned name must be a runtime-owned copy, never the provider's
     * own storage (which an unload would unmap). */
    name = rt_cuda_device_name(device);
    provider = dlopen(argv[1], RTLD_NOW | RTLD_NOLOAD);
    printf("launch=%lld name_owned=%d\n",
        (long long)rt_cuda_launch_kernel(1, (const uint8_t *)"kern", 4, 1, 1, 1, 1, 1, 1, 1),
        provider && dlsym(provider, "fake_cuda_name_storage") != (void *)name &&
            strcmp(name, "fake-cuda") == 0 ? 1 : 0);
    return 0;
}
EOF

cat >"$TMP/harness.c" <<'EOF'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pthread.h>
#include <stdatomic.h>
int64_t rt_gpu_provider_loaded(int64_t backend_bit);
int64_t rt_gpu_provider_abi_version(int64_t backend_bit);
int64_t rt_gpu_provider_backend_bits(int64_t backend_bit);
const char *rt_gpu_provider_path(int64_t backend_bit);
int64_t rt_gpu_provider_unload(int64_t backend_bit);
int64_t rt_vulkan_is_available(void);
int64_t rt_vulkan_device_count(void);
int32_t rt_vk_available(void);
int64_t rt_vulkan_init(void);
int64_t rt_vulkan_alloc_buffer(int64_t size, int64_t usage);
static atomic_int concurrent_failures = 0;
static void *exercise_provider(void *unused) {
    int i;
    (void)unused;
    for (i = 0; i < 100; i++) {
        if (rt_gpu_provider_loaded(2) != 1 || rt_vulkan_device_count() != 7 ||
                rt_vulkan_alloc_buffer(4096, 3) != 73) {
            atomic_fetch_add_explicit(&concurrent_failures, 1, memory_order_relaxed);
        }
    }
    return NULL;
}
int main(int argc, char **argv) {
    int64_t unloaded;
    pthread_t threads[8];
    int i;
    if (argc != 3) return 2;
    if (setenv("SIMPLE_VULKAN_PROVIDER_PATH", argv[1], 1) != 0) return 3;
    printf("loaded=%lld abi=%lld bits=%lld path=%d available=%lld count=%lld vk=%d init=%lld buffer=%lld\n",
        (long long)rt_gpu_provider_loaded(2),
        (long long)rt_gpu_provider_abi_version(2),
        (long long)rt_gpu_provider_backend_bits(2),
        strcmp(rt_gpu_provider_path(2), argv[1]) == 0,
        (long long)rt_vulkan_is_available(),
        (long long)rt_vulkan_device_count(), (int)rt_vk_available(),
        (long long)rt_vulkan_init(),
        (long long)rt_vulkan_alloc_buffer(4096, 3));
    for (i = 0; i < 8; i++) if (pthread_create(&threads[i], NULL, exercise_provider, NULL) != 0) return 5;
    for (i = 0; i < 8; i++) if (pthread_join(threads[i], NULL) != 0) return 6;
    printf("concurrent=%d\n", atomic_load_explicit(&concurrent_failures, memory_order_relaxed) == 0);
    unloaded = rt_gpu_provider_unload(2);
    if (setenv("SIMPLE_VULKAN_PROVIDER_PATH", argv[2], 1) != 0) return 4;
    printf("unloaded=%lld reloaded=%lld count=%lld buffer=%lld path=%d\n",
        (long long)unloaded, (long long)rt_gpu_provider_loaded(2),
        (long long)rt_vulkan_device_count(),
        (long long)rt_vulkan_alloc_buffer(4096, 3),
        strcmp(rt_gpu_provider_path(2), argv[2]) == 0);
    return 0;
}
EOF

cat >"$TMP/demand_harness.c" <<'EOF'
#include <errno.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
int64_t rt_vulkan_device_count(void);
int64_t rt_vulkan_alloc_buffer(int64_t, int64_t);
int64_t rt_gpu_provider_unload(int64_t);
static int marker_is(const char *path, const char *expected) {
    char bytes[8];
    size_t count;
    int failed;
    FILE *marker = fopen(path, "rb");
    if (!marker) return errno == ENOENT && expected[0] == '\0';
    count = fread(bytes, 1, sizeof(bytes), marker);
    failed = ferror(marker);
    if (fclose(marker) != 0) failed = 1;
    return !failed && count == strlen(expected) &&
        memcmp(bytes, expected, count) == 0;
}
int main(int argc, char **argv) {
    int i;
    if (argc != 3) return 2;
    /* The marker environment is set before process startup, so even a
     * constructor loaded before main is visible to this first assertion. */
    if (!marker_is(argv[2], "")) return 10;
    if (setenv("SIMPLE_VULKAN_PROVIDER_PATH", argv[1], 1) != 0) return 11;
    if (!marker_is(argv[2], "")) return 12;
    /* This operation is the first actual capability demand. */
    if (rt_vulkan_device_count() != 7) return 13;
    if (!marker_is(argv[2], "C")) return 14;
    for (i = 0; i < 128; i++) {
        if (rt_vulkan_device_count() != 7 ||
                rt_vulkan_alloc_buffer(4096, 3) != 73) return 15;
    }
    if (!marker_is(argv[2], "C")) return 16;
    /* A leaked dlopen reference per repeated call would prevent D here. */
    if (rt_gpu_provider_unload(2) != 1) return 17;
    if (!marker_is(argv[2], "CD")) return 18;
    if (rt_vulkan_device_count() != 7) return 19;
    if (!marker_is(argv[2], "CDC")) return 20;
    if (rt_gpu_provider_unload(2) != 1) return 21;
    if (!marker_is(argv[2], "CDCD")) return 22;
    puts("gpu_provider_demand_lifetime=CDCD repeated_demands=128");
    return 0;
}
EOF

cc -shared -fPIC "$TMP/provider.c" -o "$TMP/provider.so"
cc -shared -fPIC -DPROVIDER_DEVICE_COUNT=9 -DPROVIDER_BUFFER_HANDLE=88 \
    "$TMP/provider.c" -o "$TMP/replacement.so"
cc -shared -fPIC -DPROVIDER_ABI=99 "$TMP/provider.c" -o "$TMP/wrong.so"
cc -shared -fPIC -DOMIT_PIPELINE_RAW "$TMP/provider.c" -o "$TMP/incomplete.so"
cc -shared -fPIC "$TMP/cuda_provider.c" -o "$TMP/cuda_provider.so"
cc -shared -fPIC -DOMIT_CUDA_DTOD "$TMP/cuda_provider.c" -o "$TMP/cuda_incomplete.so"
cc -shared -fPIC -DSLOW_LOAD "$TMP/cuda_provider.c" -o "$TMP/cuda_slow.so" -ldl
cc -shared -fPIC -DREENTRANT_LOAD "$TMP/cuda_provider.c" -o "$TMP/cuda_reentrant.so" -ldl
cc -D_GNU_SOURCE -std=gnu11 -O0 -ffunction-sections -fdata-sections \
    -DSIMPLE_RUNTIME_DYNLOAD_OWNER=1 \
    -I"$ROOT/src/runtime" -I"$ROOT/src/runtime/platform" \
    -c "$ROOT/src/runtime/runtime_native.c" -o "$TMP/runtime_native.o"
cc -D_GNU_SOURCE -std=gnu11 -O0 -ffunction-sections -fdata-sections \
    -I"$ROOT/src/runtime" -I"$ROOT/src/runtime/platform" \
    -c "$ROOT/src/runtime/runtime_dynload.c" -o "$TMP/runtime_dynload.o"
cc -Wl,--gc-sections "$TMP/harness.c" "$TMP/runtime_native.o" \
    "$TMP/runtime_dynload.o" -ldl -lm -pthread -o "$TMP/harness"
cc -Wl,--gc-sections "$TMP/cuda_harness.c" "$TMP/runtime_native.o" \
    "$TMP/runtime_dynload.o" -ldl -lm -pthread -Wl,--export-dynamic-symbol=rt_cuda_init -Wl,--export-dynamic-symbol=fake_loading_started -o "$TMP/cuda_harness"
cc -Wl,--gc-sections "$TMP/demand_harness.c" "$TMP/runtime_native.o" \
    "$TMP/runtime_dynload.o" -ldl -lm -o "$TMP/demand_harness"

demand="$(SIMPLE_TEST_PROVIDER_LIFETIME_MARKER="$TMP/demand.marker" \
    "$TMP/demand_harness" "$TMP/provider.so" "$TMP/demand.marker")"
[ "$demand" = "gpu_provider_demand_lifetime=CDCD repeated_demands=128" ]
# Mutation control: a real pre-main mapping must trip the zero-demand check.
set +e
SIMPLE_TEST_PROVIDER_LIFETIME_MARKER="$TMP/premature.marker" \
    LD_PRELOAD="$TMP/provider.so" \
    "$TMP/demand_harness" "$TMP/provider.so" "$TMP/premature.marker"
premature_status=$?
set -e
[ "$premature_status" -eq 10 ]

good="$($TMP/harness "$TMP/provider.so" "$TMP/replacement.so")"
bad="$($TMP/harness "$TMP/wrong.so" "$TMP/wrong.so")"
missing="$($TMP/harness "$TMP/missing.so" "$TMP/missing.so")"
incomplete="$($TMP/harness "$TMP/incomplete.so" "$TMP/incomplete.so")"
cuda_good="$($TMP/cuda_harness "$TMP/cuda_provider.so")"
cuda_incomplete="$($TMP/cuda_harness "$TMP/cuda_incomplete.so")"
cuda_race="$($TMP/cuda_harness "$TMP/cuda_slow.so" race)"
cuda_fork="$($TMP/cuda_harness "$TMP/cuda_slow.so" fork)"
cuda_reentry="$($TMP/cuda_harness "$TMP/cuda_reentrant.so" reentry)"
[ "$good" = "loaded=1 abi=1 bits=2 path=1 available=1 count=7 vk=1 init=1 buffer=73
concurrent=1
unloaded=1 reloaded=1 count=9 buffer=88 path=1" ]
[ "$bad" = "loaded=0 abi=0 bits=0 path=0 available=0 count=0 vk=0 init=0 buffer=0
concurrent=0
unloaded=1 reloaded=0 count=0 buffer=0 path=0" ]
[ "$missing" = "$bad" ]
[ "$incomplete" = "$bad" ]
[ "$cuda_good" = "loaded=1 available=1 init=0 ptr=91 fill=0 dtoh=0 word=5a5a5a5a
dev=5 cc=121 id=77 name=fake-cuda err=CUDA_ERROR_NO_DEVICE slice2d=285 module=3
launch=36 name_owned=1" ]
# A second first-call that lands in LOADING waits for the loader, never "unavailable".
[ "$cuda_race" = "race=0,0" ]
# A fork child of a process mid-load fails the load instead of waiting forever.
[ "$cuda_fork" = "fork_child=3 parent=0" ]
# The loader thread re-entering during its own load answers "unavailable".
[ "$cuda_reentry" = "reentry=3 init=0" ]
# Rejected provider: every query takes the Rust non-cuda twin's sentinel.
[ "$cuda_incomplete" = "loaded=0 available=0 init=3 ptr=-3 fill=-3 dtoh=-3 word=00000000
dev=-3 cc=0 id=0 name=No CUDA err=CUDA_ERROR_NO_DEVICE slice2d=-3 module=-3
launch=-3 name_owned=0" ]

if command -v readelf >/dev/null 2>&1; then
    if readelf -d "$TMP/harness" | grep -Fq 'provider.so'; then
        echo "gpu provider registry: provider is statically linked" >&2
        exit 1
    fi
fi

printf '%s\n' \
    "gpu_provider_zero_load_before_demand=true" \
    "gpu_provider_constructor_once_per_lifetime=true" \
    "gpu_provider_repeated_demand_reuses_mapping=true" \
    "gpu_provider_early_load_mutation_rejected=true" \
    "gpu_provider_dynamic_load=true" \
    "gpu_provider_handle_local_resolution=true" \
    "gpu_provider_scalar_operation_dispatch=true" \
    "gpu_provider_abi_v1_admitted=true" \
    "gpu_provider_wrong_abi_rejected=true" \
    "gpu_provider_incomplete_surface_rejected=true" \
    "gpu_provider_provenance_reported=true" \
    "gpu_provider_unload_reload=true" \
    "gpu_provider_replacement_without_host_rebuild=true" \
    "gpu_provider_concurrent_registry_access=true" \
    "cuda_provider_operation_dispatch=true" \
    "cuda_provider_device_query_dispatch=true" \
    "cuda_provider_concurrent_first_call_waits=true" \
    "cuda_provider_fork_child_never_waits=true" \
    "cuda_provider_loader_reentry_never_waits=true" \
    "cuda_provider_device_name_runtime_owned=true" \
    "cuda_provider_incomplete_surface_rejected=true" \
    "cuda_provider_missing_operation_fails_closed=true" \
    "gpu_provider_missing_rejected=true" \
    "gpu_provider_static_dependency=false"
