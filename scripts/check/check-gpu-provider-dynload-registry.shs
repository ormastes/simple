#!/bin/sh
# Prove that core-C opens a GPU provider explicitly, validates its ABI/backend,
# resolves probe symbols against that handle, and has no provider link edge.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
TMP_BASE="${TMPDIR:-/tmp}"
TMP="$(mktemp -d "$TMP_BASE/simple-gpu-provider-registry.XXXXXX")"
cleanup() {
    case "$TMP" in
        "$TMP_BASE"/simple-gpu-provider-registry.*) rm -rf "$TMP" ;;
        *) exit 2 ;;
    esac
}
trap cleanup EXIT HUP INT TERM

cat >"$TMP/provider.c" <<'EOF'
#include <stdint.h>
#ifndef PROVIDER_ABI
#define PROVIDER_ABI 1
#endif
int64_t rt_simple_gpu_provider_abi_version(void) { return PROVIDER_ABI; }
int64_t rt_simple_gpu_provider_backend_bits(void) { return 2; }
int64_t rt_vulkan_provider_is_available(void) { return 1; }
int64_t rt_vulkan_provider_device_count(void) { return 7; }
int32_t rt_vk_provider_available(void) { return 1; }
int64_t rt_vulkan_init(void) { return 1; }
int64_t rt_vulkan_alloc_buffer(int64_t size, int64_t usage) {
    return size == 4096 && usage == 3 ? 73 : 0;
}
#define STUB(name) int64_t name(void) { return 1; }
STUB(rt_vulkan_shutdown)
STUB(rt_vulkan_select_device)
STUB(rt_vulkan_free_buffer)
STUB(rt_vulkan_copy_to_buffer_raw)
STUB(rt_vulkan_copy_from_buffer_raw)
STUB(rt_vulkan_copy_from_buffer_strided_raw)
STUB(rt_vulkan_copy_from_buffer_regions_raw)
STUB(rt_vulkan_compile_spirv_raw)
STUB(rt_vulkan_destroy_shader)
#ifndef OMIT_PIPELINE_RAW
STUB(rt_vulkan_create_compute_pipeline_raw)
#endif
STUB(rt_vulkan_destroy_pipeline)
STUB(rt_vulkan_create_descriptor_set)
STUB(rt_vulkan_bind_buffer)
STUB(rt_vulkan_destroy_descriptor_set)
STUB(rt_vulkan_begin_compute)
STUB(rt_vulkan_bind_pipeline)
STUB(rt_vulkan_bind_descriptors)
STUB(rt_vulkan_push_constants_raw)
STUB(rt_vulkan_dispatch)
STUB(rt_vulkan_end_compute)
STUB(rt_vulkan_discard_command)
STUB(rt_vulkan_fence_submission_supported)
STUB(rt_vulkan_accepted_compute_submit_count)
STUB(rt_vulkan_submit_and_wait_fence)
STUB(rt_vulkan_submit_no_wait)
STUB(rt_vulkan_wait_fence)
STUB(rt_vulkan_destroy_fence)
STUB(rt_vulkan_wait_idle)
STUB(rt_vulkan_device_name)
STUB(rt_vulkan_device_type)
STUB(rt_vulkan_selected_device_type)
STUB(rt_vulkan_device_driver_identity)
STUB(rt_vulkan_selected_device_driver_identity)
STUB(rt_vulkan_selected_device_driver_identity_hash)
STUB(rt_vulkan_get_last_error)
STUB(rt_vulkan_init_headless_present)
STUB(rt_vulkan_init_window_present)
STUB(rt_vulkan_init_external_window_present)
STUB(rt_vulkan_present_buffer)
STUB(rt_vulkan_present_buffer_regions_raw)
STUB(rt_vulkan_last_present_copy_bytes)
STUB(rt_vulkan_last_present_copy_rects)
STUB(rt_vulkan_destroy_swapchain)
EOF

cat >"$TMP/cuda_provider.c" <<'EOF'
#include <stdint.h>
#include <string.h>
int64_t rt_simple_gpu_provider_abi_version(void) { return 1; }
int64_t rt_simple_gpu_provider_backend_bits(void) { return 1; }
int64_t rt_cuda_provider_available(void) { return 1; }
int64_t rt_cuda_provider_device_count(void) { return 1; }
int64_t rt_cuda_init(void) { return 0; }
int64_t rt_cuda_mem_alloc(int64_t size) { return size == 16 ? 91 : -1; }
int64_t rt_cuda_memset_d32(int64_t ptr, int64_t pattern, int64_t count) {
    return ptr == 91 && pattern == 0x5a5a5a5a && count == 4 ? 0 : -1;
}
int64_t rt_cuda_memcpy_dtoh(int64_t dst, int64_t src, int64_t size) {
    if (!dst || src != 91 || size != 16) return -1;
    memset((void *)(intptr_t)dst, 0x5a, 16);
    return 0;
}
#define STUB(name) int64_t name(void) { return 0; }
STUB(rt_cuda_device_get)
STUB(rt_cuda_device_compute_capability)
STUB(rt_cuda_ctx_create)
STUB(rt_cuda_ctx_set_current)
STUB(rt_cuda_ctx_destroy)
STUB(rt_cuda_ctx_synchronize)
STUB(rt_cuda_mem_free)
STUB(rt_cuda_memcpy_htod)
#ifndef OMIT_CUDA_DTOD
STUB(rt_cuda_memcpy_dtod)
#endif
STUB(rt_cuda_memset)
STUB(rt_cuda_module_load_data_bytes)
STUB(rt_cuda_module_unload)
STUB(rt_cuda_launch_kernel_name)
STUB(rt_cuda_sync)
const char *rt_cuda_device_name(int64_t device) { (void)device; return "fake-cuda"; }
const char *rt_cuda_get_error_string(int64_t code) { (void)code; return "fake-error"; }
EOF

cat >"$TMP/cuda_harness.c" <<'EOF'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
int64_t rt_gpu_provider_loaded(int64_t);
int64_t rt_cuda_available(void);
int64_t rt_cuda_init(void);
int64_t rt_cuda_mem_alloc(int64_t);
int64_t rt_cuda_memset_d32(int64_t, int64_t, int64_t);
int64_t rt_cuda_memcpy_dtoh(int64_t, int64_t, int64_t);
int main(int argc, char **argv) {
    uint32_t words[4] = {0, 0, 0, 0};
    int64_t ptr;
    int64_t fill;
    int64_t dtoh;
    if (argc != 2 || setenv("SIMPLE_CUDA_PROVIDER_PATH", argv[1], 1) != 0) return 2;
    ptr = rt_cuda_mem_alloc(16);
    fill = rt_cuda_memset_d32(ptr, 0x5a5a5a5a, 4);
    dtoh = rt_cuda_memcpy_dtoh((int64_t)(intptr_t)words, ptr, 16);
    printf("loaded=%lld available=%lld init=%lld ptr=%lld fill=%lld dtoh=%lld word=%08x\n",
        (long long)rt_gpu_provider_loaded(1), (long long)rt_cuda_available(),
        (long long)rt_cuda_init(), (long long)ptr,
        (long long)fill, (long long)dtoh, words[0]);
    return 0;
}
EOF

cat >"$TMP/harness.c" <<'EOF'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
int64_t rt_gpu_provider_loaded(int64_t backend_bit);
int64_t rt_gpu_provider_abi_version(int64_t backend_bit);
int64_t rt_gpu_provider_backend_bits(int64_t backend_bit);
const char *rt_gpu_provider_path(int64_t backend_bit);
int64_t rt_vulkan_is_available(void);
int64_t rt_vulkan_device_count(void);
int32_t rt_vk_available(void);
int64_t rt_vulkan_init(void);
int64_t rt_vulkan_alloc_buffer(int64_t size, int64_t usage);
int main(int argc, char **argv) {
    if (argc != 2) return 2;
    if (setenv("SIMPLE_VULKAN_PROVIDER_PATH", argv[1], 1) != 0) return 3;
    printf("loaded=%lld abi=%lld bits=%lld path=%d available=%lld count=%lld vk=%d init=%lld buffer=%lld\n",
        (long long)rt_gpu_provider_loaded(2),
        (long long)rt_gpu_provider_abi_version(2),
        (long long)rt_gpu_provider_backend_bits(2),
        strcmp(rt_gpu_provider_path(2), argv[1]) == 0,
        (long long)rt_vulkan_is_available(),
        (long long)rt_vulkan_device_count(), (int)rt_vk_available(),
        (long long)rt_vulkan_init(),
        (long long)rt_vulkan_alloc_buffer(4096, 3));
    return 0;
}
EOF

cc -shared -fPIC "$TMP/provider.c" -o "$TMP/provider.so"
cc -shared -fPIC -DPROVIDER_ABI=99 "$TMP/provider.c" -o "$TMP/wrong.so"
cc -shared -fPIC -DOMIT_PIPELINE_RAW "$TMP/provider.c" -o "$TMP/incomplete.so"
cc -shared -fPIC "$TMP/cuda_provider.c" -o "$TMP/cuda_provider.so"
cc -shared -fPIC -DOMIT_CUDA_DTOD "$TMP/cuda_provider.c" -o "$TMP/cuda_incomplete.so"
cc -D_GNU_SOURCE -std=gnu11 -O0 -ffunction-sections -fdata-sections \
    -I"$ROOT/src/runtime" -I"$ROOT/src/runtime/platform" \
    -c "$ROOT/src/runtime/runtime_native.c" -o "$TMP/runtime_native.o"
cc -Wl,--gc-sections "$TMP/harness.c" "$TMP/runtime_native.o" \
    -ldl -lm -o "$TMP/harness"
cc -Wl,--gc-sections "$TMP/cuda_harness.c" "$TMP/runtime_native.o" \
    -ldl -lm -o "$TMP/cuda_harness"

good="$($TMP/harness "$TMP/provider.so")"
bad="$($TMP/harness "$TMP/wrong.so")"
missing="$($TMP/harness "$TMP/missing.so")"
incomplete="$($TMP/harness "$TMP/incomplete.so")"
cuda_good="$($TMP/cuda_harness "$TMP/cuda_provider.so")"
cuda_incomplete="$($TMP/cuda_harness "$TMP/cuda_incomplete.so")"
[ "$good" = "loaded=1 abi=1 bits=2 path=1 available=1 count=7 vk=1 init=1 buffer=73" ]
[ "$bad" = "loaded=0 abi=0 bits=0 path=0 available=0 count=0 vk=0 init=0 buffer=0" ]
[ "$missing" = "loaded=0 abi=0 bits=0 path=0 available=0 count=0 vk=0 init=0 buffer=0" ]
[ "$incomplete" = "loaded=0 abi=0 bits=0 path=0 available=0 count=0 vk=0 init=0 buffer=0" ]
[ "$cuda_good" = "loaded=1 available=1 init=0 ptr=91 fill=0 dtoh=0 word=5a5a5a5a" ]
[ "$cuda_incomplete" = "loaded=0 available=0 init=3 ptr=-3 fill=-3 dtoh=-3 word=00000000" ]

if command -v readelf >/dev/null 2>&1; then
    if readelf -d "$TMP/harness" | grep -Fq 'provider.so'; then
        echo "gpu provider registry: provider is statically linked" >&2
        exit 1
    fi
fi

printf '%s\n' \
    "gpu_provider_dynamic_load=true" \
    "gpu_provider_handle_local_resolution=true" \
    "gpu_provider_scalar_operation_dispatch=true" \
    "gpu_provider_abi_v1_admitted=true" \
    "gpu_provider_wrong_abi_rejected=true" \
    "gpu_provider_incomplete_surface_rejected=true" \
    "gpu_provider_provenance_reported=true" \
    "cuda_provider_operation_dispatch=true" \
    "cuda_provider_incomplete_surface_rejected=true" \
    "cuda_provider_missing_operation_fails_closed=true" \
    "gpu_provider_missing_rejected=true" \
    "gpu_provider_static_dependency=false"
