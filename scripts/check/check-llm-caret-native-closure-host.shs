#!/bin/sh
# Harness contracts only: no compiler, runtime, or product PASS is simulated.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
. "$ROOT/scripts/lib/host-executable.shs"
GATE="$ROOT/scripts/check/check-llm-caret-native-closure.shs"
TMP=$(mktemp -d)
trap 'rm -f "$TMP"/*; rmdir "$TMP"' EXIT HUP INT TERM
# Read actual production helper bodies, stopping at their top-level closing brace.
for helper in detect_host_target scan_closure_symbols closure_has_forbidden_imports closure_validate_imports closure_validate_version sha256_file; do
    sed -n "/^${helper}() {/,/^}/p" "$GATE" >>"$TMP/helpers.sh"
done
. "$TMP/helpers.sh"
uname() { case "$1" in -s) printf '%s\n' "$TEST_OS" ;; -m) printf '%s\n' "$TEST_ARCH" ;; esac; }
TEST_OS=MSYS_NT-10.0
TEST_ARCH=x86_64
MSYSTEM=MSYS
unset SIMPLE_WINDOWS_ABI
[ "$(detect_host_target)" = x86_64-pc-windows-msvc ]
MSYSTEM=UCRT64
[ "$(detect_host_target)" = x86_64-pc-windows-gnu ]
SIMPLE_WINDOWS_ABI=msvc
[ "$(detect_host_target)" = x86_64-pc-windows-msvc ]
TEST_ARCH=arm64
[ "$(detect_host_target)" = aarch64-pc-windows-msvc ]
SIMPLE_WINDOWS_ABI=bogus
if detect_host_target >/dev/null; then echo 'FAIL invalid ABI admitted'; exit 1; fi
unset SIMPLE_WINDOWS_ABI
TEST_ARCH=x86_64
for TEST_OS in Linux Darwin FreeBSD; do
    case "$TEST_OS" in Linux) expected=x86_64-unknown-linux-gnu ;; Darwin) expected=x86_64-apple-darwin ;; FreeBSD) expected=x86_64-unknown-freebsd ;; esac
    [ "$(detect_host_target)" = "$expected" ]
done
TEST_ARCH=unknown
if detect_host_target >/dev/null; then echo 'FAIL unknown architecture admitted'; exit 1; fi
[ "$(simple_exe_suffix windows)" = .exe ]
[ -z "$(simple_exe_suffix linux)" ]
# Exercise the Windows scan's output and exit validation, never a build receipt.
HOST_FAMILY=windows
ARTIFACT_ROOT=$TMP
OUTPUT_NATIVE='C:\private path\caret-native-closure.exe'
cat >"$TMP/llvm-readobj" <<'CHECKER'
#!/bin/sh
[ "$1" = --coff-imports ] || exit 8
[ "$2" = 'C:\private path\caret-native-closure.exe' ] || exit 9
case "$CHECKER_CASE" in
    good) printf 'Format: COFF-x86-64\n' ;;
    wrong-format) printf 'Format: ELF64-x86-64\n' ;;
    empty) : ;;
    failure) printf 'Format: COFF-x86-64\n'; exit 7 ;;
esac
CHECKER
chmod +x "$TMP/llvm-readobj"
PATH="$TMP:$PATH"
export PATH CHECKER_CASE
CHECKER_CASE=good
scan_closure_symbols
if closure_has_forbidden_imports; then echo 'FAIL clean PE rejected'; exit 1; fi
printf '  Symbol: rt_terminal_enable_raw_mode (1)\n' >>"$TMP/undefined-symbols.txt"
closure_has_forbidden_imports
if closure_validate_imports; then exit 1; else [ "$?" -eq 1 ]; fi
printf '                 U _rt_process_run_inherit\n' >"$TMP/undefined-symbols.txt"
closure_has_forbidden_imports
for CHECKER_CASE in wrong-format empty failure; do
    if scan_closure_symbols; then echo "FAIL checker $CHECKER_CASE admitted"; exit 1; fi
done
closure_validate_imports
rm "$TMP/undefined-symbols.txt"
if closure_validate_imports 2>/dev/null; then exit 1; else [ "$?" -eq 2 ]; fi
printf 'Simple 1.0\n' >"$TMP/runtime.version.txt"
: >"$TMP/runtime.version.stderr.txt"
closure_validate_version
printf 'Rust seed\n' >"$TMP/runtime.version.stderr.txt"
if closure_validate_version; then exit 1; else [ "$?" -eq 1 ]; fi
rm "$TMP/runtime.version.stderr.txt"
if closure_validate_version 2>/dev/null; then exit 1; else [ "$?" -eq 2 ]; fi
# Check failed and malformed hashers cannot mint an empty receipt identity.
sha256sum() { case "$HASH_CASE" in failure) return 7 ;; malformed) printf 'not-a-hash  file\n' ;; good) printf '%064d  file\n' 0 ;; esac; }
HASH_CASE=good
[ "$(sha256_file sha256sum ignored)" = "$(printf '%064d' 0)" ]
for HASH_CASE in failure malformed; do
    if sha256_file sha256sum ignored; then echo 'FAIL invalid digest admitted'; exit 1; fi
done
echo 'PASS Caret closure host and PE checker contracts (no product qualification)'
