#!/bin/sh
# check-riscv-hardware-gates.shs — single entrypoint for the RISC-V hardware gates.
#
# Runs, in order, capturing pass/fail per gate:
#   1. All JTAG debug testbenches (GHDL, VHDL-2008):
#        tb_jtag_dtm_dmi   -> "JTAG STAGE1 PASS"
#        tb_debug_module   -> "JTAG STAGE2 PASS"
#        tb_abstract_cmds  -> "JTAG STAGE3 PASS"
#        tb_debug_csrs     -> "JTAG STAGE4 PASS"
#        tb_sba            -> "JTAG STAGE5 PASS"
#      (tb_openocd_bitbang is skipped with a warning: it needs the VHPIDIRECT
#       openocd_bitbang_glue.c shared object and a live OpenOCD socket.)
#   2. The soc/core `bin/simple run` probes (each must print "ALL PASS"):
#        test/01_unit/lib/hardware/soc_rtl/soc_top_64_probe.spl
#        test/01_unit/lib/hardware/soc_rtl/boot64_probe.spl
#        test/01_unit/lib/hardware/rv64gc_rtl/core64_probe.spl
#        test/01_unit/lib/hardware/debug_hooks/hart_debug_probe.spl (rv32 hart
#          debug-hook probe; optional-if-missing, asserted when present)
#   3. scripts/fpga/ghdl_validate_rv32.shs --analyze, only when the generated
#      VHDL (build/vhdl/rv32/soc_top_rv32_sim.vhd) is present; otherwise a
#      warning (generation needs an rv32 payload ELF not kept in the tree).
#
# Verdict convention (.claude/rules/vcs.md § Pre-push guards): the LAST line of
# stdout is always one of
#   PASS  — <n> gate(s) checked, ...   exit 0   (n is always > 0)
#   FAIL  — ...                        exit 1
#   ERROR — nothing was checked: ...   exit 2
# A run that checked zero gates is an ERROR, never a PASS.
#
# PROVENANCE (fixed 2026-08-17, see
# doc/08_tracking/bug/riscv_gate_evidence_seed_attributed_bin_release_clobbered_2026-07-27.md):
# every probe result was attributed to whatever `resolve_simple` happened to
# find -- in practice `bin/release/<triple>/simple`, which on this machine is
# the RUST SEED and says so on its own first stdout line:
#
#   $ bin/simple --version
#   WARNING: this Rust-built Simple binary is a bootstrap seed only; do not use
#   it as the normal tool.
#
# The gate printed only `simple binary: <path>` and then `RISCV-HW-GATES: n/m
# PASS`, so a green run read as a self-hosted result. That is a misattribution,
# not a crash. Fixed: the engine is probed and CLASSIFIED before any gate runs,
# the classification is carried into the final verdict line (`engine=rust-seed`
# / `engine=self-hosted`), and a binary whose provenance cannot be determined is
# an ERROR (exit 2) -- absence of evidence is never a pass.
#
# Missing OPTIONAL inputs warn; missing REQUIRED inputs fail (fail-closed).
#
# Env:
#   SIMPLE_BIN           path to the simple binary (default: auto-discover)
#   RISCV_GATE_TIMEOUT   per-gate timeout in seconds (default 600)
#
# Flags:
#   --selftest           fatal fixture run (shim binaries, no hardware needed)

set -u

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

TIMEOUT_SECS="${RISCV_GATE_TIMEOUT:-600}"
if command -v timeout >/dev/null 2>&1; then
    RUN_TIMEOUT="timeout $TIMEOUT_SECS"
else
    RUN_TIMEOUT=""
fi

# classify_engine <bin>
# Echoes "rust-seed" or "self-hosted" and returns 0; on an indeterminate binary
# echoes a reason and returns 2. rc is assigned on the line AFTER the command --
# never through a pipe, whose $? is the last stage's.
classify_engine() {
    _ce_bin="$1"
    _ce_out="$("$_ce_bin" --version 2>&1)" && _ce_rc=0 || _ce_rc=$?
    if [ "$_ce_rc" -ne 0 ]; then
        echo "--version exited $_ce_rc"
        return 2
    fi
    if [ -z "$_ce_out" ]; then
        echo "--version produced no output"
        return 2
    fi
    if printf '%s\n' "$_ce_out" | grep -q "bootstrap seed only"; then
        echo "rust-seed"
    else
        echo "self-hosted"
    fi
    return 0
}

selftest() {
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    fails=0
    n=0
    mk() { # mk <name> <exit> <text>
        printf '#!/bin/sh\nprintf %%s\\\\n "%s"\nexit %s\n' "$3" "$2" >"$tmp/$1"
        chmod +x "$tmp/$1"
    }
    expect() { # expect <desc> <bin> <want_rc> <want_stdout>
        n=$((n + 1))
        got="$(classify_engine "$tmp/$2")" && rc=0 || rc=$?
        if [ "$rc" = "$3" ] && [ "$got" = "$4" ]; then
            echo "  selftest ok [$1]"
        else
            echo "  SELFTEST FAIL [$1]: rc=$rc out='$got', wanted rc=$3 out='$4'"
            fails=$((fails + 1))
        fi
    }

    echo "=== check-riscv-hardware-gates --selftest ==="
    # Incident replay: the real bin/release/<triple>/simple prints exactly this.
    mk seed 0 'WARNING: this Rust-built Simple binary is a bootstrap seed only; do not use it as the normal tool.'
    mk hosted 0 'Simple Language v1.0.0-RC'
    mk broken 1 'segfault'
    mk silent 0 ''
    expect "seed banner must classify as rust-seed, never self-hosted" seed 0 "rust-seed"
    expect "no seed banner must classify as self-hosted" hosted 0 "self-hosted"
    expect "unrunnable binary must be indeterminate (ERROR), never a pass" broken 2 "--version exited 1"
    expect "silent --version must be indeterminate, never self-hosted" silent 2 "--version produced no output"

    if [ "$fails" -ne 0 ]; then
        echo "FAIL — selftest: $fails of $n fixture(s) failed"
        exit 1
    fi
    echo "PASS — $n selftest fixture(s) checked"
    exit 0
}

case "${1:-}" in
    --selftest) selftest ;;
    "") ;;
    *) echo "usage: $0 [--selftest]"
       echo "ERROR — nothing was checked: unknown argument '$1'"
       exit 2 ;;
esac

TOTAL=0
PASS=0
FAIL=0
WARN=0

gate_pass() { TOTAL=$((TOTAL + 1)); PASS=$((PASS + 1)); echo "PASS  $1"; }
gate_fail() { TOTAL=$((TOTAL + 1)); FAIL=$((FAIL + 1)); echo "FAIL  $1 -- $2"; }
gate_warn() { WARN=$((WARN + 1)); echo "WARN  $1 -- $2 (skipped, not counted)"; }

LOG_DIR="build/riscv_hw_gates"
mkdir -p "$LOG_DIR"

echo "=== RISC-V hardware gates ==="
echo "root: $ROOT_DIR"

# ---------------------------------------------------------------------------
# 1. JTAG debug testbenches (GHDL)
# ---------------------------------------------------------------------------
DEBUG_DIR="src/lib/hardware/debug"
GHDL_WORK="build/ghdl/jtag_gates"
mkdir -p "$GHDL_WORK"

# Support units first (analysis order matters), then the testbenches.
JTAG_UNITS="jtag_tap dmi_bus debug_registers riscv_dtm riscv_debug_module sba_test_mem"
JTAG_TBS="tb_jtag_dtm_dmi:1 tb_debug_module:2 tb_abstract_cmds:3 tb_debug_csrs:4 tb_sba:5"

if ! command -v ghdl >/dev/null 2>&1; then
    for spec in $JTAG_TBS; do
        gate_fail "jtag ${spec%%:*}" "ghdl not found in PATH"
    done
else
    analyze_ok=1
    for unit in $JTAG_UNITS $(for s in $JTAG_TBS; do echo "${s%%:*}"; done); do
        src="$DEBUG_DIR/$unit.vhd"
        if [ ! -f "$src" ]; then
            echo "ERROR missing required VHDL source: $src"
            analyze_ok=0
            continue
        fi
        out="$(ghdl -a --std=08 --workdir="$GHDL_WORK" "$src" 2>&1)"
        rc=$?
        if [ $rc -ne 0 ] || echo "$out" | grep -q ":error:"; then
            echo "ERROR analyzing $src:"
            echo "$out" | tail -20
            analyze_ok=0
        fi
    done
    # Optional bitbang server tb: only analyzable, needs VHPIDIRECT .so to run.
    if [ -f "$DEBUG_DIR/tb_openocd_bitbang.vhd" ]; then
        gate_warn "jtag tb_openocd_bitbang" "needs openocd_bitbang_glue.c VHPIDIRECT .so + live OpenOCD"
    else
        gate_warn "jtag tb_openocd_bitbang" "file not present"
    fi

    for spec in $JTAG_TBS; do
        tb="${spec%%:*}"
        stage="${spec##*:}"
        marker="JTAG STAGE$stage PASS"
        if [ $analyze_ok -ne 1 ]; then
            gate_fail "jtag $tb" "VHDL analysis failed (see errors above)"
            continue
        fi
        log="$LOG_DIR/$tb.log"
        if ! ghdl -e --std=08 --workdir="$GHDL_WORK" "$tb" >"$log" 2>&1; then
            gate_fail "jtag $tb" "ghdl elaboration failed (see $log)"
            continue
        fi
        $RUN_TIMEOUT ghdl -r --std=08 --workdir="$GHDL_WORK" "$tb" >"$log" 2>&1
        rc=$?
        if grep -q "$marker" "$log"; then
            gate_pass "jtag $tb ($marker)"
        elif [ $rc -eq 124 ]; then
            gate_fail "jtag $tb" "timed out after ${TIMEOUT_SECS}s without '$marker'"
        else
            gate_fail "jtag $tb" "no '$marker' (rc=$rc, see $log)"
            tail -10 "$log" | sed 's/^/      /'
        fi
    done
fi

# ---------------------------------------------------------------------------
# 2. soc/core probes via `simple run`
# ---------------------------------------------------------------------------
resolve_simple() {
    if [ -n "${SIMPLE_BIN:-}" ] && [ -x "${SIMPLE_BIN}" ]; then
        echo "$SIMPLE_BIN"; return 0
    fi
    for cand in \
        "$ROOT_DIR/bin/simple" \
        "$ROOT_DIR/src/compiler_rust/target/bootstrap/simple" \
        "$ROOT_DIR"/bin/release/*/simple; do
        if [ -x "$cand" ]; then echo "$cand"; return 0; fi
    done
    command -v simple 2>/dev/null && return 0
    return 1
}

# name|path|required(1/0). hart_debug_probe is the rv32 hart debug-hook probe:
# asserted when present, warned when absent.
PROBES="soc_top_64_probe|test/01_unit/lib/hardware/soc_rtl/soc_top_64_probe.spl|1
boot64_probe|test/01_unit/lib/hardware/soc_rtl/boot64_probe.spl|1
core64_probe|test/01_unit/lib/hardware/rv64gc_rtl/core64_probe.spl|1
muldiv_overflow|test/01_unit/lib/hardware/rv64gc_rtl/muldiv_overflow_probe.spl|1
fpu_probe|test/01_unit/lib/hardware/rv64gc_rtl/fpu_probe.spl|1
core_fpu_integration|test/01_unit/lib/hardware/rv64gc_rtl/core_fpu_integration_probe.spl|1
csr_machine_id|test/01_unit/lib/hardware/rv64gc_rtl/csr_machine_id_probe.spl|1
rv32_uart_console|test/01_unit/lib/hardware/soc_rtl/rv32_uart_console_probe.spl|1
rv32_mmio_consistency|test/01_unit/lib/hardware/soc_rtl/rv32_mmio_map_consistency_probe.spl|1
addr4g_probe|test/01_unit/lib/hardware/soc_rtl/addr4g_probe.spl|0
hart_debug_probe_rv32|test/01_unit/lib/hardware/debug_hooks/hart_debug_probe.spl|0
aop_pointcut_parity|test/01_unit/compiler/frontend/core/aop_pointcut_matcher_parity_probe.spl|0
link_mux_frame|test/01_unit/lib/hardware/link_mux/frame_probe.spl|1
link_mux_mux|test/01_unit/lib/hardware/link_mux/mux_probe.spl|1
link_mux_jtag_route|test/01_unit/lib/hardware/link_mux/jtag_route_probe.spl|1
link_mux_jtag_debug|test/01_unit/lib/hardware/link_mux/jtag_debug_probe.spl|1"

# Probes that must run under the interpreter (space-separated names). The FPU
# model uses the spl_f64_to_bits float extern, which this Rust seed miscompiles
# under JIT (wrong bits + broken i64 equality); the interpreter is correct. Same
# interpreter-only convention as the rv64 soak probe. rv32_uart_console drives
# the soc_top rv32 model whose serial output the seed JIT miscompiles past the
# first byte, and rv32_mmio_consistency reads u32 consts via `as i64` — both seed
# JIT defects (see seed_jit_u32_cross_module_const_import_zero_2026-07-23.md);
# the interpreter is the synthesis reference for the hardware model either way.
# link_mux_jtag_debug drives the rv64 core model (soc_top_64) through the muxed
# JTAG debug stack; the same seed JIT rv64-core defects apply, so it is
# interpreter-only like the rv64 soak probe.
INTERP_PROBES="fpu_probe core_fpu_integration rv32_uart_console rv32_mmio_consistency link_mux_jtag_debug"

SIMPLE="$(resolve_simple)" || SIMPLE=""
ENGINE="unknown"
if [ -z "$SIMPLE" ]; then
    # No simple binary: every required probe is blocked -> fail-closed.
    OLDIFS=$IFS; IFS='
'
    for row in $PROBES; do
        name="${row%%|*}"; rest="${row#*|}"; req="${rest##*|}"
        if [ "$req" = "1" ]; then
            gate_fail "probe $name" "blocked: no simple binary (set SIMPLE_BIN)"
        else
            gate_warn "probe $name" "blocked: no simple binary (set SIMPLE_BIN)"
        fi
    done
    IFS=$OLDIFS
else
    # --- Provenance, BEFORE any gate runs -------------------------------------
    # rc is assigned on the line AFTER the command; a pipeline's $? would be the
    # last stage's, which has produced false greens in this repo before.
    SIMPLE_REAL="$(readlink -f "$SIMPLE" 2>/dev/null || echo "$SIMPLE")"
    ENGINE="$(classify_engine "$SIMPLE")" && crc=0 || crc=$?
    if [ "$crc" -ne 0 ]; then
        echo "ERROR — nothing was checked: cannot determine engine provenance of $SIMPLE_REAL ($ENGINE)"
        exit 2
    fi
    echo "simple binary: $SIMPLE_REAL"
    echo "engine: $ENGINE ($(stat -c '%s bytes, mtime %y' "$SIMPLE_REAL" 2>/dev/null || echo 'stat unavailable'))"
    OLDIFS=$IFS; IFS='
'
    for row in $PROBES; do
        IFS=$OLDIFS
        name="${row%%|*}"; rest="${row#*|}"
        path="${rest%%|*}"; req="${rest##*|}"
        if [ ! -f "$path" ]; then
            if [ "$req" = "1" ]; then
                gate_fail "probe $name" "required file missing: $path"
            else
                gate_warn "probe $name" "optional file missing: $path"
            fi
            IFS='
'
            continue
        fi
        log="$LOG_DIR/$name.log"
        mode_env=""
        case " $INTERP_PROBES " in
            *" $name "*) mode_env="SIMPLE_EXECUTION_MODE=interpreter" ;;
        esac
        env $mode_env $RUN_TIMEOUT "$SIMPLE" run "$path" >"$log" 2>&1
        rc=$?
        if [ $rc -eq 0 ] && grep -q "ALL PASS" "$log"; then
            gate_pass "probe $name (ALL PASS)"
        elif [ $rc -eq 124 ]; then
            gate_fail "probe $name" "timed out after ${TIMEOUT_SECS}s"
        else
            gate_fail "probe $name" "rc=$rc or no 'ALL PASS' (see $log)"
            tail -10 "$log" | sed 's/^/      /'
        fi
        IFS='
'
    done
    IFS=$OLDIFS
fi

# ---------------------------------------------------------------------------
# 3. Generated-RTL analyze gate (only when generated VHDL is present)
# ---------------------------------------------------------------------------
RV32_VALIDATE="scripts/fpga/ghdl_validate_rv32.shs"
RV32_GEN_MARKER="build/vhdl/rv32/soc_top_rv32_sim.vhd"
if [ ! -f "$RV32_VALIDATE" ]; then
    gate_warn "ghdl_validate_rv32 --analyze (ANALYZE-ONLY: no elaboration/simulation)" "script missing: $RV32_VALIDATE"
elif [ ! -f "$RV32_GEN_MARKER" ]; then
    gate_warn "ghdl_validate_rv32 --analyze (ANALYZE-ONLY: no elaboration/simulation)" "generated VHDL absent ($RV32_GEN_MARKER); run scripts/fpga/generate_rv32_vhdl.shs first"
else
    log="$LOG_DIR/ghdl_validate_rv32.log"
    if $RUN_TIMEOUT sh "$RV32_VALIDATE" --analyze >"$log" 2>&1; then
        gate_pass "ghdl_validate_rv32 --analyze (ANALYZE-ONLY: no elaboration/simulation)"
    else
        gate_fail "ghdl_validate_rv32 --analyze (ANALYZE-ONLY: no elaboration/simulation)" "nonzero exit (see $log)"
        tail -10 "$log" | sed 's/^/      /'
    fi
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
echo "---"
[ $WARN -gt 0 ] && echo "warnings (optional gates skipped): $WARN"
echo "RISCV-HW-GATES: $PASS/$TOTAL PASS"
if [ $TOTAL -eq 0 ]; then
    # Non-vacuity is absolute: a run that evaluated zero gates proved nothing.
    echo "ERROR — nothing was checked: 0 gates evaluated"
    exit 2
fi
if [ $FAIL -gt 0 ] || [ $PASS -ne $TOTAL ]; then
    echo "FAIL — $TOTAL gate(s) checked, $FAIL failed (engine=$ENGINE)"
    exit 1
fi
# The engine is stated IN the verdict so a green line can never be read as a
# self-hosted result when it was produced by the Rust seed.
echo "PASS — $TOTAL gate(s) checked, 0 failed (engine=$ENGINE)"
exit 0
