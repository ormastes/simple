#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
build_dir="$repo_root/build/test/runtime_simd_search_native_check"
cc_bin=${CC:-cc}
mkdir -p "$build_dir"

# No -D_GNU_SOURCE: the runtime source must expose its own libc declaration.
"$cc_bin" -O2 -std=c99 -Werror=implicit-function-declaration -Werror=int-conversion \
    -I"$repo_root/src/runtime" -c "$repo_root/src/runtime/runtime_simd_search.c" \
    -o "$build_dir/runtime_simd_search.o"
"$cc_bin" -O2 -std=c99 -Werror=implicit-function-declaration -Werror=int-conversion \
    -I"$repo_root/src/runtime" \
    "$repo_root/test/01_unit/runtime/simd_text/runtime_simd_search_native_test.c" \
    -o "$build_dir/runtime_simd_search_native_test"
"$build_dir/runtime_simd_search_native_test"
