#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
runtime="$root/examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c"
grep -qF '[ARM64_HANDOFF_PREFLIGHT] stage=' "$runtime"
for field in ' entry=' ' sp=' ' root=' ' arena=' ' entry_phys=' ' stack_phys='; do
    grep -qF "serial_puts(\"$field\")" "$runtime"
done
for stage in 1 2 3 4 5; do
    grep -qF "arm64_handoff_preflight_receipt(${stage}U);" "$runtime"
done
live=$(sed -n '/RuntimeValue rt_arm64_enter_recorded_user_live(void)/,/^}/p' "$runtime")
[ "$(printf '%s\n' "$live" | grep -c 'return (RuntimeValue)-14;')" -eq 2 ]
[ "$(printf '%s\n' "$live" | grep -c 'arm64_handoff_preflight_receipt(')" -eq 2 ]
! printf '%s\n' "$live" | grep -q 'if .*return (RuntimeValue)-14;'
echo 'PASS ARM64 closed numeric handoff preflight receipts'
