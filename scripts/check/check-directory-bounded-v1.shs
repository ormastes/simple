#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
case "$(uname -s)" in
    Linux|Darwin|FreeBSD) ;;
    *) echo "UNSUPPORTED bounded directory native selfcheck on this host"; exit 2 ;;
esac
WORK=$(mktemp -d "${TMPDIR:-/tmp}/simple-directory-bounded-check.XXXXXX")
trap 'rm -rf "$WORK"' EXIT HUP INT TERM
"${CC:-cc}" -std=c11 -D_GNU_SOURCE -Wall -Wextra -Werror -pthread \
    -I "$ROOT/src/runtime" "$ROOT/src/runtime/test/runtime_directory_bounded_v1_selfcheck.c" \
    -o "$WORK/selfcheck"
"$WORK/selfcheck" "$@"
