#!/bin/sh
set -eu
LC_ALL=C; export LC_ALL
usage(){ echo "usage: $0 --profile mixed-criticality-high-assurance --evidence DIR [--contract-fixture --tool-dir DIR]" >&2; exit 2; }
profile= evidence= fixture=false tool_dir=
seen_options=
mark_option(){ case " $seen_options " in *" $1 "*) usage;; esac; seen_options="$seen_options $1"; }
while [ "$#" -gt 0 ]; do
 case "$1" in
  --profile|--evidence|--tool-dir) option=$1; mark_option "$option"; [ "$#" -ge 2 ] || usage; case "$2" in --*) usage;; esac; value=$2; shift 2; case "$option" in --profile) profile=$value;; --evidence) evidence=$value;; --tool-dir) tool_dir=$value;; esac;;
  --contract-fixture) mark_option "$1"; fixture=true; shift;;
  *) usage;;
 esac
done
[ "$profile" = mixed-criticality-high-assurance ] && [ -n "$evidence" ] || usage
root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
case "$evidence" in /*) out=$evidence;; *) out=$root/$evidence;; esac
relative=${out#"$root"/}; [ "$relative" != "$out" ] || { echo 'BLOCKED: evidence must be below repository root' >&2; exit 2; }
old_ifs=$IFS; IFS=/; for component in $relative; do case "$component" in ''|.|..) IFS=$old_ifs; echo 'BLOCKED: non-canonical evidence path' >&2; exit 2;; esac; done; IFS=$old_ifs
parent=$(dirname "$out"); [ -d "$parent" ] || mkdir -p "$parent"; parent=$(CDPATH= cd -- "$parent" && pwd -P)
case "$parent/$(basename "$out")" in "$root"/*) out=$parent/$(basename "$out");; *) echo 'BLOCKED: evidence resolves outside repository root' >&2; exit 2;; esac
[ "$fixture" = true ] || tool_dir=$root/scripts/check
if [ "$fixture" = true ]; then [ -n "$tool_dir" ] || usage; tool_dir=$(CDPATH= cd -- "$tool_dir" && pwd -P); fi
blocked(){ echo "BLOCKED: $*" >&2; exit 2; }; need(){ eval "v=\${$1-}"; [ -n "$v" ] || blocked "missing external/live prerequisite: $1"; }
regular(){ [ -f "$1" ] && [ ! -L "$1" ]; }
hash_file(){
 if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
 elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
 elif command -v openssl >/dev/null 2>&1; then openssl dgst -sha256 "$1" | sed 's/^.*= //'
 else blocked 'no SHA-256 implementation is available'; fi
}
dir_identity(){ if stat -c '%d:%i' "$1" >/dev/null 2>&1; then stat -c '%d:%i' "$1"; else stat -f '%d:%i' "$1"; fi; }
file_identity(){ regular "$1" || return 1; if stat -c '%d:%i' "$1" >/dev/null 2>&1; then stat -c '%d:%i' "$1"; else stat -f '%d:%i' "$1"; fi; }
tool(){ p=$tool_dir/$1; regular "$p" && [ -x "$p" ] || blocked "missing canonical executable: $p"; printf '%s\n' "$p"; }
simpleos_mission_critical_gate(){
 if [ "$fixture" = true ]; then
  tool check-simpleos-mission-critical-release.shs
 else
  p=$root/scripts/check/check-simpleos-mission-critical-release.shs
  regular "$p" && [ -x "$p" ] || blocked "missing canonical executable: $p"
  printf '%s\n' "$p"
 fi
}
for n in MCI_RUN_ID MCI_SOURCE_HASH MCI_CONFIGURATION_HASH MCI_CAPTURED_AT_UTC_NS MCI_VALID_UNTIL_UTC_NS MCI_NOW_UTC_NS MCI_PRODUCER_PRIVATE_KEY MCI_PRODUCER_PUBLIC_KEY MCI_PRODUCER_KEY_ID MCI_REVIEWER_PUBLIC_KEY MCI_REVIEWER_KEY_ID MCI_REVIEW_DECISION MCI_REVIEW_DECISION_SIGNATURE MCI_REVIEWER_TRUST_POLICY; do need "$n"; done
for f in "$MCI_PRODUCER_PRIVATE_KEY" "$MCI_PRODUCER_PUBLIC_KEY" "$MCI_REVIEWER_PUBLIC_KEY" "$MCI_REVIEW_DECISION" "$MCI_REVIEW_DECISION_SIGNATURE" "$MCI_REVIEWER_TRUST_POLICY"; do regular "$f" || blocked "external prerequisite is not a regular file: $f"; done
[ "$MCI_PRODUCER_KEY_ID" != "$MCI_REVIEWER_KEY_ID" ] && [ "$(hash_file "$MCI_PRODUCER_PUBLIC_KEY")" != "$(hash_file "$MCI_REVIEWER_PUBLIC_KEY")" ] || blocked 'producer and reviewer trust roots must differ'
timeout_s=${MCI_RELEASE_GATE_TIMEOUT_SECONDS:-900}; capture_n=${MCI_RELEASE_CAPTURE_LIMIT_BYTES:-1048576}; memory_kb=${MCI_RELEASE_MEMORY_LIMIT_KB:-2097151}; process_n=${MCI_RELEASE_PROCESS_LIMIT:-256}; case "$timeout_s$capture_n$memory_kb$process_n" in *[!0-9]*) usage;; esac
bounded_positive(){ awk -v value="$1" -v maximum="$2" 'BEGIN{sub(/^0+/,"",value); if(value=="")exit 1; exit !((length(value)<length(maximum))||(length(value)==length(maximum)&&value<=maximum))}'; }
bounded_positive "$timeout_s" 86400 || blocked 'timeout limit must be between 1 and 86400 seconds'
bounded_positive "$capture_n" 1073741824 || blocked 'capture limit must be between 1 and 1073741824 bytes'
bounded_positive "$memory_kb" 2097151 || blocked 'memory limit must be between 1 and 2097151 KiB'
bounded_positive "$process_n" 4096 || blocked 'process limit must be between 1 and 4096'
command -v timeout >/dev/null 2>&1 || blocked 'timeout is required for bounded release execution'; memory_bytes=$((memory_kb * 1024))
if command -v prlimit >/dev/null 2>&1; then limiter=prlimit
elif (ulimit -d "$memory_kb" && ulimit -u "$process_n") 2>/dev/null; then limiter=ulimit
else blocked 'host provides neither prlimit nor supported data/process ulimit controls'; fi
[ ! -e "$out" ] && [ ! -L "$out" ] || blocked 'evidence collision; use a fresh directory'; mkdir "$out"; mkdir "$out/orchestrator-captures"
out_identity=$(dir_identity "$out") || blocked 'cannot pin evidence directory identity'
manifest=$out/orchestrator-run.env
{ echo orchestrator_schema=mci-v2-release-orchestrator-v1; echo mode=$(if [ "$fixture" = true ]; then echo CONTRACT_ONLY; else echo live; fi); echo profile=$profile; echo run_id=$MCI_RUN_ID; echo source_hash=$MCI_SOURCE_HASH; echo configuration_hash=$MCI_CONFIGURATION_HASH; echo timeout_seconds=$timeout_s; echo capture_limit_bytes=$capture_n; } > "$manifest"
captures_identity=$(dir_identity "$out/orchestrator-captures") || blocked 'cannot pin capture directory identity'
manifest_identity=$(file_identity "$manifest") || blocked 'cannot pin orchestrator manifest identity'
orchestrator_paths_unchanged(){ [ -d "$out" ] && [ ! -L "$out" ] && [ "$(dir_identity "$out")" = "$out_identity" ] && [ -d "$out/orchestrator-captures" ] && [ ! -L "$out/orchestrator-captures" ] && [ "$(dir_identity "$out/orchestrator-captures")" = "$captures_identity" ] && [ "$(file_identity "$manifest")" = "$manifest_identity" ]; }
run_gate(){ id=$1; shift; orchestrator_paths_unchanged || blocked 'orchestrator directory or manifest identity changed'; o=$out/orchestrator-captures/$id.stdout; e=$out/orchestrator-captures/$id.stderr; [ ! -e "$o" ] && [ ! -e "$e" ] || blocked "capture collision: $id"; blocks=$(( (capture_n + 511) / 512 )); set +e; if [ "$limiter" = prlimit ]; then (set -C; ulimit -f "$blocks"; exec timeout -k 5 "$timeout_s" prlimit --as="$memory_bytes" --nproc="$process_n" -- "$@") >"$o" 2>"$e"; else (set -C; ulimit -f "$blocks"; ulimit -d "$memory_kb"; ulimit -u "$process_n"; exec timeout -k 5 "$timeout_s" "$@") >"$o" 2>"$e"; fi; rc=$?; set -e; orchestrator_paths_unchanged || blocked 'orchestrator directory or manifest identity changed during stage'; os=$(wc -c <"$o"); es=$(wc -c <"$e"); if [ "$os" -gt "$capture_n" ] || [ "$es" -gt "$capture_n" ]; then echo "stage=$id|BLOCKED|capture-overflow|$rc|$os|$es" >>"$manifest"; return 124; fi; echo "stage=$id|$(if [ "$rc" -eq 0 ]; then echo PASS; else echo BLOCKED; fi)|exit-$rc|$rc|$os|$es" >>"$manifest"; return "$rc"; }
validate_simpleos_mission_critical_evidence(){
 gate_dir=$out/simpleos-mission-critical-release
 report=$gate_dir/report.md
 matrix_out=$gate_dir/matrix.out
 matrix_err=$gate_dir/matrix.err
 sidecar=$out/simpleos-mission-critical-gate-v1.env
 [ -d "$gate_dir" ] && [ ! -L "$gate_dir" ] || blocked 'SimpleOS mission-critical gate evidence directory is missing or symlinked'
 regular "$report" || blocked 'SimpleOS mission-critical gate report missing or symlinked'
 regular "$matrix_out" || blocked 'SimpleOS mission-critical matrix output missing or symlinked'
 regular "$matrix_err" || blocked 'SimpleOS mission-critical matrix error output missing or symlinked'
 [ "$(grep -c '^simpleos_hardening_matrix_status=pass$' "$matrix_out")" -eq 1 ] || blocked 'SimpleOS mission-critical matrix status is not PASS'
 [ "$(grep -c '^simpleos_hardening_mission_critical_release_status=pass$' "$matrix_out")" -eq 1 ] || blocked 'SimpleOS mission-critical release status is not PASS'
 [ "$(grep -c '^simpleos_hardening_mission_critical_release_blockers=none$' "$matrix_out")" -eq 1 ] || blocked 'SimpleOS mission-critical release blockers are not none'
 [ "$(grep -c '^simpleos_hardening_matrix_passed=26/26$' "$matrix_out")" -eq 1 ] || blocked 'SimpleOS mission-critical matrix is not 26/26'
 decimal_le(){ awk -v a="$1" -v b="$2" 'BEGIN{sub(/^0+/,"",a);sub(/^0+/,"",b);if(a=="")a="0";if(b=="")b="0";exit !((length(a)<length(b))||(length(a)==length(b)&&a<=b))}'; }
 # Subtract decimal strings digit-by-digit.  Awk numeric subtraction is
 # lossy for nanosecond timestamps above 2^53 and can admit stale evidence.
 decimal_age_ok(){ awk -v a="$1" -v b="$2" 'BEGIN{sub(/^0+/,"",a);sub(/^0+/,"",b);if(a=="")a="0";if(b=="")b="0";if(length(b)<length(a)||(length(b)==length(a)&&b<a))exit 1;borrow=0;out="";i=length(b);j=length(a);while(i>0){x=substr(b,i,1)+0-borrow;y=(j>0?substr(a,j,1)+0:0);if(x<y){x+=10;borrow=1}else borrow=0;out=(x-y) out;i--;j--}sub(/^0+/,"",out);if(out=="")out="0";lim="86400000000000";exit !((length(out)<length(lim))||(length(out)==length(lim)&&out<=lim))}'; }
 grep -Fqx -- '- passed: 26/26' "$report" || blocked 'SimpleOS mission-critical report is not 26/26'
 grep -q '^STATUS: PASS simpleos-mission-critical-release ' "$out/orchestrator-captures/simpleos-mission-critical.stdout" || blocked 'SimpleOS mission-critical gate PASS status is missing'
 for f in "$report" "$matrix_out" "$matrix_err" "$out/orchestrator-captures/simpleos-mission-critical.stdout" "$out/orchestrator-captures/simpleos-mission-critical.stderr"; do
  bytes=$(wc -c <"$f" | tr -d ' ')
  [ "$bytes" -le "$capture_n" ] || blocked "SimpleOS mission-critical evidence exceeds capture limit: $f"
 done
 report_sha=$(hash_file "$report")
 matrix_out_sha=$(hash_file "$matrix_out")
 matrix_err_sha=$(hash_file "$matrix_err")
 stdout_sha=$(hash_file "$out/orchestrator-captures/simpleos-mission-critical.stdout")
 stderr_sha=$(hash_file "$out/orchestrator-captures/simpleos-mission-critical.stderr")
 [ ! -e "$sidecar" ] && [ ! -L "$sidecar" ] || blocked 'SimpleOS mission-critical gate sidecar collision'
 {
  echo gate_schema=simpleos-mission-critical-gate-v1
  echo gate_status=pass
  echo execution_mode=$(if [ "$fixture" = true ]; then echo CONTRACT_ONLY; else echo live; fi)
  echo fixture_contract_only=$(if [ "$fixture" = true ]; then echo true; else echo false; fi)
  echo qemu_claim=not-made-by-orchestrator
  echo run_id=$MCI_RUN_ID
  echo source_hash=$MCI_SOURCE_HASH
  echo configuration_hash=$MCI_CONFIGURATION_HASH
  echo matrix_passed=26/26
  echo captured_at_utc_ns=$MCI_CAPTURED_AT_UTC_NS
  echo valid_until_utc_ns=$MCI_VALID_UNTIL_UTC_NS
  echo admission_now_utc_ns=$MCI_NOW_UTC_NS
  echo report_relpath=simpleos-mission-critical-release/report.md
  echo report_sha256=$report_sha
  echo matrix_out_relpath=simpleos-mission-critical-release/matrix.out
  echo matrix_out_sha256=$matrix_out_sha
  echo matrix_err_relpath=simpleos-mission-critical-release/matrix.err
  echo matrix_err_sha256=$matrix_err_sha
  echo gate_stdout_relpath=orchestrator-captures/simpleos-mission-critical.stdout
  echo gate_stdout_sha256=$stdout_sha
  echo gate_stderr_relpath=orchestrator-captures/simpleos-mission-critical.stderr
  echo gate_stderr_sha256=$stderr_sha
  echo gate_report_common_identity=not-supported-by-gate
  echo orchestrator_identity_binding=run-source-configuration-v1
 } >"$sidecar"
 regular "$sidecar" || blocked 'SimpleOS mission-critical gate sidecar publication failed'
 captured=$(sed -n 's/^captured_at_utc_ns=//p' "$sidecar" | tail -1); valid=$(sed -n 's/^valid_until_utc_ns=//p' "$sidecar" | tail -1); admission=$(sed -n 's/^admission_now_utc_ns=//p' "$sidecar" | tail -1)
 case "$captured:$valid:$admission" in *[!0-9:]*|:*|*::* ) blocked 'SimpleOS gate sidecar lifetime fields are invalid';; esac
 decimal_le "$captured" "$admission" && decimal_le "$admission" "$valid" && decimal_age_ok "$captured" "$valid" || blocked 'SimpleOS gate sidecar lifetime is stale or invalid'
}
revalidate_simpleos_gate(){
 sidecar=$out/simpleos-mission-critical-gate-v1.env
 regular "$sidecar" || blocked 'SimpleOS gate sidecar was deleted'
 [ "$(sed -n 's/^matrix_passed=//p' "$sidecar" | tail -1)" = 26/26 ] || blocked 'SimpleOS gate matrix is not 26/26'
 for gate_hash in report_sha256 matrix_out_sha256 matrix_err_sha256 gate_stdout_sha256 gate_stderr_sha256; do
  printf '%s\n' "$(sed -n "s/^$gate_hash=//p" "$sidecar" | tail -1)" | grep -Eq '^[0-9a-f]{64}$' || blocked "SimpleOS gate hash is invalid: $gate_hash"
 done
 for bound_file in "$out/simpleos-mission-critical-release/report.md" "$out/simpleos-mission-critical-release/matrix.out" "$out/simpleos-mission-critical-release/matrix.err" "$out/orchestrator-captures/simpleos-mission-critical.stdout" "$out/orchestrator-captures/simpleos-mission-critical.stderr"; do
  regular "$bound_file" || blocked "SimpleOS gate bound file was deleted: $bound_file"
 done
 [ "$(hash_file "$out/simpleos-mission-critical-release/report.md")" = "$(sed -n 's/^report_sha256=//p' "$sidecar")" ] || blocked 'SimpleOS gate report mutated'
 [ "$(hash_file "$out/simpleos-mission-critical-release/matrix.out")" = "$(sed -n 's/^matrix_out_sha256=//p' "$sidecar")" ] || blocked 'SimpleOS gate matrix output mutated'
 [ "$(hash_file "$out/simpleos-mission-critical-release/matrix.err")" = "$(sed -n 's/^matrix_err_sha256=//p' "$sidecar")" ] || blocked 'SimpleOS gate matrix error mutated'
 [ "$(hash_file "$out/orchestrator-captures/simpleos-mission-critical.stdout")" = "$(sed -n 's/^gate_stdout_sha256=//p' "$sidecar")" ] || blocked 'SimpleOS gate stdout mutated'
 [ "$(hash_file "$out/orchestrator-captures/simpleos-mission-critical.stderr")" = "$(sed -n 's/^gate_stderr_sha256=//p' "$sidecar")" ] || blocked 'SimpleOS gate stderr mutated'
 if [ "$fixture" = false ]; then
  sidecar_sha=$(hash_file "$sidecar")
  grep -qx "simpleos_gate_sidecar_sha256=$sidecar_sha" "$out/receipts/simpleos.receipt" || blocked 'signed SimpleOS receipt is not bound to current gate sidecar'
  regular "$out/artifacts/simpleos.evidence" || blocked 'signed SimpleOS artifact was deleted'
  [ "$(hash_file "$out/artifacts/simpleos.evidence")" = "$(sed -n 's/^artifact_sha256=//p' "$out/receipts/simpleos.receipt")" ] || blocked 'signed SimpleOS artifact mutated'
 fi
}
run_simpleos_mission_critical_gate(){
 simpleos_gate_dir=$out/simpleos-mission-critical-release
 simpleos_gate_report=$simpleos_gate_dir/report.md
 if [ "$fixture" = true ]; then
  run_gate simpleos-mission-critical env BUILD_DIR="$simpleos_gate_dir" REPORT_PATH="$simpleos_gate_report" KV260_BOOT_LANE=off "$(simpleos_mission_critical_gate)" || blocked 'SimpleOS mission-critical 26/26 gate failed'
 else
  run_gate simpleos-mission-critical env BUILD_DIR="$simpleos_gate_dir" REPORT_PATH="$simpleos_gate_report" "$(simpleos_mission_critical_gate)" || blocked 'SimpleOS mission-critical 26/26 gate failed'
 fi
 validate_simpleos_mission_critical_evidence
}
validate_args(){ file=$1; shift; awk -v required="$*" 'BEGIN{n=split(required,r," ")} {a[NR]=$0} END{if(NR%2)exit 1;for(i=1;i<=NR;i+=2){if(a[i]!~/^--[A-Za-z0-9-]+$/||seen[a[i]]++)exit 1}for(j=1;j<=n;j++){found=0;for(i=1;i<=NR;i+=2)if(a[i]==r[j])found++;if(found!=1)exit 1}}' "$file"; }
common="--evidence $out --run-id $MCI_RUN_ID --source-hash $MCI_SOURCE_HASH --configuration-hash $MCI_CONFIGURATION_HASH --captured-at-utc-ns $MCI_CAPTURED_AT_UTC_NS --valid-until-utc-ns $MCI_VALID_UNTIL_UTC_NS --now-utc-ns $MCI_NOW_UTC_NS"
if [ "$fixture" = true ]; then
 for id in compiler tooling traceability simpleos rendering allocation process-safety stress; do
  lane_id=$id
  [ "$lane_id" = simpleos ] && run_simpleos_mission_critical_gate
  if [ "$lane_id" = simpleos ]; then MCI_SIMPLEOS_GATE_SIDECAR="$out/simpleos-mission-critical-gate-v1.env" run_gate "$lane_id" "$(tool check-mci-v2-$lane_id.shs)" --orchestrated $common || blocked "$lane_id producer failed"; else run_gate "$lane_id" "$(tool check-mci-v2-$lane_id.shs)" --orchestrated $common || blocked "$lane_id producer failed"; fi
 done
else
 # Lane-specific argv is supplied as one whitespace-free argument per line. The
 # orchestrator owns the executable and verifies the shared identity tuple.
 for id in compiler tooling traceability simpleos rendering allocation process-safety stress; do
   lane_id=$id
   [ "$lane_id" = simpleos ] && run_simpleos_mission_critical_gate
   var=MCI_$(printf '%s' "$lane_id" | tr 'a-z-' 'A-Z_')_ARGS_FILE; need "$var"; eval "af=\$$var"; regular "$af" || blocked "$var is not a regular argv file"
   case "$(sed -n '1p' "$af")" in --*) :;; *) blocked "$var has invalid argv format";; esac
   validate_args "$af" --evidence --run-id --source-hash --configuration-hash || blocked "$var has duplicate, missing, or non-paired options"
   awk -v e="$out" -v r="$MCI_RUN_ID" -v s="$MCI_SOURCE_HASH" -v c="$MCI_CONFIGURATION_HASH" 'p=="--evidence"&&$0!=e{exit 1} p=="--run-id"&&$0!=r{exit 1} p=="--source-hash"&&$0!=s{exit 1} p=="--configuration-hash"&&$0!=c{exit 1} {p=$0}' "$af" || blocked "$var has mismatched common identity pair"
   if grep -Eq '[[:space:]]' "$af"; then blocked "$var arguments must be one whitespace-free value per line"; fi
   # Deliberate field splitting turns the validated argv file into arguments.
   set --; while IFS= read -r arg || [ -n "$arg" ]; do set -- "$@" "$arg"; done < "$af"
   lane_tool=check-mci-v2-$lane_id.shs
   [ "$lane_id" = simpleos ] && lane_tool=check-mci-v2-simpleos-manifest.shs
   if [ "$lane_id" = simpleos ]; then set -- env MCI_SIMPLEOS_GATE_SIDECAR="$out/simpleos-mission-critical-gate-v1.env" "$(tool "$lane_tool")" "$@"; else set -- "$(tool "$lane_tool")" "$@"; fi
   if ! run_gate "$lane_id" "$@"; then
     [ "$lane_id" = compiler ] && blocked 'compiler live prerequisite remains BLOCKED; no unsigned template was produced'
     blocked "$lane_id producer failed"
   fi
 done
fi
for lane in compiler tooling traceability simpleos rendering allocation fault-injection process-safety stress; do
 if [ "$fixture" = true ]; then run_gate "sign-$lane" "$(tool sign-mci-v2-lane.shs)" --orchestrated --lane "$lane" --evidence "$out" || blocked "$lane signer failed"
 else
  case "$lane" in compiler) t=compiler.unsigned.template; a=compiler.evidence;; tooling) t=tooling.unsigned.template; a=tooling-generation-v1.tar;; simpleos) t=simpleos.receipt.unsigned.template; a=simpleos.evidence;; rendering) t=rendering.unsigned.template; a=rendering-v1.evidence;; allocation) t=allocation.unsigned.template; a=allocation-domain-arena-v1.evidence;; fault-injection) t=fault-injection.unsigned.template; a=fault-injection-domain-arena-v1.evidence;; process-safety) t=process-safety.receipt.unsigned.template; a=process-safety.evidence;; stress) t=stress.receipt.unsigned.template; a=stress.evidence;; traceability) t=traceability.unsigned.template; a=traceability-v1.env;; esac
  set -- --evidence "$out" --lane "$lane" --template "$out/receipts/$t" --artifact "$out/artifacts/$a" --private-key "$MCI_PRODUCER_PRIVATE_KEY" --trusted-key-id "$MCI_PRODUCER_KEY_ID"; [ "$lane" != stress ] || set -- "$@" --valid-until-utc-ns "$MCI_VALID_UNTIL_UTC_NS"
  run_gate "sign-$lane" "$(tool sign-mci-v2-lane.shs)" "$@" || blocked "$lane signing failed"
 fi
done
 revalidate_simpleos_gate
sidecar_sha=$(hash_file "$out/simpleos-mission-critical-gate-v1.env")
if [ "$fixture" = true ]; then :; else grep -qx "simpleos_gate_sidecar_sha256=$sidecar_sha" "$out/receipts/simpleos.receipt" || blocked 'signed SimpleOS receipt is not bound to mission-critical gate sidecar'; fi
aggregate=$(tool check-mci-v2-aggregate.shs); reviewer=$(tool check-mci-v2-independent-review.shs)
 if [ "$fixture" = true ]; then
	 if run_gate aggregate-candidate "$aggregate" --orchestrated --pass candidate --evidence "$out"; then rc=0; else rc=$?; fi; [ "$rc" -eq 2 ] || blocked 'candidate aggregate must block before reviewer activation'
 revalidate_simpleos_gate
 run_gate reviewer "$reviewer" --orchestrated --evidence "$out" || blocked 'reviewer activation failed'; revalidate_simpleos_gate; run_gate aggregate-final "$aggregate" --orchestrated --pass final --evidence "$out" || blocked 'final aggregate failed'; revalidate_simpleos_gate
 echo result=CONTRACT_ONLY >>"$manifest"; echo 'CONTRACT_ONLY: synthetic MCI-v2 workflow completed; no live release claimed'
else
	 if run_gate aggregate-candidate "$aggregate" --evidence "$out" --run-id "$MCI_RUN_ID" --source-hash "$MCI_SOURCE_HASH" --configuration-hash "$MCI_CONFIGURATION_HASH" --now-utc-ns "$MCI_NOW_UTC_NS" --trusted-key "$MCI_PRODUCER_PUBLIC_KEY" --trusted-key-id "$MCI_PRODUCER_KEY_ID" --reviewer-key "$MCI_REVIEWER_PUBLIC_KEY" --reviewer-key-id "$MCI_REVIEWER_KEY_ID"; then rc=0; else rc=$?; fi
 [ "$rc" -eq 1 ] || blocked 'candidate aggregate did not return the expected blocked status'
 candidate_report=$out/aggregate-candidate-report-v1.env
 regular "$candidate_report" || blocked 'candidate aggregate report missing'
 [ "$(grep -c '^result=' "$candidate_report")" -eq 1 ] || blocked 'candidate aggregate report result is indeterminate'
 grep -qx 'result=BLOCKED' "$candidate_report" || blocked 'candidate aggregate report is not BLOCKED'
 revalidate_simpleos_gate
 run_gate reviewer "$reviewer" --evidence "$out" --aggregate-report "$out/aggregate-candidate-report-v1.env" --candidate-graph "$out/aggregate-candidate-v1.env" --decision "$MCI_REVIEW_DECISION" --decision-signature "$MCI_REVIEW_DECISION_SIGNATURE" --reviewer-key "$MCI_REVIEWER_PUBLIC_KEY" --reviewer-key-id "$MCI_REVIEWER_KEY_ID" --reviewer-trust-policy "$MCI_REVIEWER_TRUST_POLICY" --producer-key "$MCI_PRODUCER_PUBLIC_KEY" --producer-key-id "$MCI_PRODUCER_KEY_ID" --now-utc-ns "$MCI_NOW_UTC_NS" || blocked 'reviewer activation failed'
 revalidate_simpleos_gate
 run_gate aggregate-final "$aggregate" --evidence "$out" --run-id "$MCI_RUN_ID" --source-hash "$MCI_SOURCE_HASH" --configuration-hash "$MCI_CONFIGURATION_HASH" --now-utc-ns "$MCI_NOW_UTC_NS" --trusted-key "$MCI_PRODUCER_PUBLIC_KEY" --trusted-key-id "$MCI_PRODUCER_KEY_ID" --reviewer-key "$MCI_REVIEWER_PUBLIC_KEY" --reviewer-key-id "$MCI_REVIEWER_KEY_ID" || blocked 'final aggregate failed'
 revalidate_simpleos_gate
 grep -qx release_blockers=none "$out/aggregate-final-report-v1.env" || blocked 'release blockers remain'
 regular "$out/aggregate-report-v1.env" || blocked 'compatibility aggregate report missing'
 cmp -s "$out/aggregate-final-report-v1.env" "$out/aggregate-report-v1.env" || blocked 'compatibility aggregate report differs from final report'
 revalidate_simpleos_gate
 echo result=PASS >>"$manifest"; echo 'PASS: live MCI-v2 release evidence admitted'
fi
