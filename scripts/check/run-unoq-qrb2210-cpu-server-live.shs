#!/bin/sh
# Live, fail-closed UNO Q SimpleOS CPU server acceptance runner.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
DEVICE=""
OUT_DIR=$ROOT/build/test-artifacts/simpleos-server-execution-matrix/uno-q/cpu
LOCK_PATH=/tmp/unoq-server-matrix.lock
REMOTE_PROVIDER=/usr/bin/simpleos-unoq-cpu-server-evidence
REMOTE_SERVER=/usr/bin/simpleos-servers
REMOTE_PROVENANCE=/usr/lib/simpleos/servers/unoq-cpu-server.provenance.env
REMOTE_RECEIPT=/run/simpleos/evidence/unoq-cpu-server.env
REMOTE_BOOT_IDENTITY=/etc/simpleos-qrb2210-boot.env
REMOTE_CREDENTIAL=/run/simpleos/evidence/unoq-cpu.credential
REMOTE_CREDENTIAL_SCAN=/run/simpleos/evidence/unoq-cpu-credential-scan.bin
MAX_RECEIPT_BYTES=65536

blocked() { echo "unoq_cpu_server_status=blocked"; echo "unoq_cpu_server_reason=$1"; echo "unoq_cpu_server_evidence_class=live-runner-owned"; exit 2; }
failed() { echo "unoq_cpu_server_status=fail"; echo "unoq_cpu_server_reason=$1"; echo "unoq_cpu_server_evidence_class=live-runner-owned"; exit 1; }

receipt_value() {
    receipt=$1; key=$2
    count=$(sed -n "s/^$key=//p" "$receipt" | wc -l | tr -d ' ')
    [ "$count" -eq 1 ] || return 1
    value=$(sed -n "s/^$key=//p" "$receipt")
    case "$value" in ''|*[!A-Za-z0-9._:+-]*) return 1 ;; esac
    printf '%s\n' "$value"
}

is_sha256() {
    value=$1
    [ "${#value}" -eq 64 ] || return 1
    case "$value" in *[!0-9a-f]*) return 1 ;; esac
}

validate_receipt() {
    receipt=$1; expected_serial=$2; expected_boot=$3; expected_server_sha=$4; expected_provenance_sha=$5
    [ "$(receipt_value "$receipt" schema)" = SimpleOsServerExecutionReceiptV1 ] || return 1
    [ "$(receipt_value "$receipt" mode)" = unoq-cpu ] || return 1
    [ "$(receipt_value "$receipt" status)" = pass ] || return 1
    [ "$(receipt_value "$receipt" board_id)" = qrb2210-uno-q ] || return 1
    [ "$(receipt_value "$receipt" adb_serial)" = "$expected_serial" ] || return 1
    [ "$(receipt_value "$receipt" boot_id)" = "$expected_boot" ] || return 1
    [ "$(receipt_value "$receipt" simpleos_boot)" = true ] || return 1
    [ "$(receipt_value "$receipt" os_identity)" = simpleos ] || return 1
    [ "$(receipt_value "$receipt" server_sha256)" = "$expected_server_sha" ] || return 1
    [ "$(receipt_value "$receipt" provenance_sha256)" = "$expected_provenance_sha" ] || return 1
    for hash_key in server_sha256 provenance_sha256 provider_sha256 bundle_sha256 \
        source_manifest_sha256 compiler_admission_sha256 command_sha256 \
        http_expected_sha256 http_body_sha256 db_commit_sha256 \
        db_read_before_reboot_sha256 db_read_after_reboot_sha256 maps_sha256 \
        credential_scan_sha256; do
        hash_value=$(receipt_value "$receipt" "$hash_key") || return 1
        is_sha256 "$hash_value" || return 1
    done
    [ "$(receipt_value "$receipt" cpu_only)" = true ] || return 1
    [ "$(receipt_value "$receipt" gpu_selected)" = false ] || return 1
    [ "$(receipt_value "$receipt" gpu_libraries_loaded)" = false ] || return 1
    [ "$(receipt_value "$receipt" gpu_provider_invoked)" = false ] || return 1
    [ "$(receipt_value "$receipt" gpu_submit_completed)" = false ] || return 1
    [ "$(receipt_value "$receipt" device_readback_verified)" = false ] || return 1
    [ "$(receipt_value "$receipt" forced_cpu_backend)" = true ] || return 1
    [ "$(receipt_value "$receipt" accelerator_provider_loaded)" = false ] || return 1
    [ "$(receipt_value "$receipt" http_status)" = pass ] || return 1
    [ "$(receipt_value "$receipt" http_filesystem_bytes_match)" = true ] || return 1
    [ "$(receipt_value "$receipt" http_verified)" = true ] || return 1
    [ "$(receipt_value "$receipt" http_expected_sha256)" = "$(receipt_value "$receipt" http_body_sha256)" ] || return 1
    receipt_value "$receipt" http_body_sha256 >/dev/null || return 1
    [ "$(receipt_value "$receipt" db_authenticated_write)" = pass ] || return 1
    [ "$(receipt_value "$receipt" db_restart)" = pass ] || return 1
    [ "$(receipt_value "$receipt" db_authenticated_read)" = pass ] || return 1
    [ "$(receipt_value "$receipt" db_restart_value_match)" = true ] || return 1
    receipt_value "$receipt" db_commit_sha256 >/dev/null || return 1
    receipt_value "$receipt" db_read_before_reboot_sha256 >/dev/null || return 1
    receipt_value "$receipt" db_read_after_reboot_sha256 >/dev/null || return 1
    [ "$(receipt_value "$receipt" db_read_before_reboot_sha256)" = "$(receipt_value "$receipt" db_read_after_reboot_sha256)" ] || return 1
    generation=$(receipt_value "$receipt" db_generation) || return 1
    case "$generation" in ''|*[!0-9]*|0) return 1 ;; esac
    [ "$(receipt_value "$receipt" fresh_reboot_count)" = 1 ] || return 1
    before_boot=$(receipt_value "$receipt" boot_id_before_reboot) || return 1
    after_boot=$(receipt_value "$receipt" boot_id_after_reboot) || return 1
    [ "$before_boot" != "$after_boot" ] || return 1
    [ "$(receipt_value "$receipt" clean_shutdown)" = true ] || return 1
    [ "$(receipt_value "$receipt" mutable_state_owner)" = host-parent ] || return 1
    [ "$(receipt_value "$receipt" raw_pointer_transport)" = false ] || return 1
    [ "$(receipt_value "$receipt" parent_authoritative_commit)" = true ] || return 1
    [ "$(receipt_value "$receipt" credential_ephemeral)" = true ] || return 1
    [ "$(receipt_value "$receipt" credential_destroyed)" = true ] || return 1
    [ "$(receipt_value "$receipt" credential_bytes_retained)" = false ] || return 1
    [ "$(receipt_value "$receipt" credential_live_matches)" = 0 ] || return 1
    [ "$(receipt_value "$receipt" blocker)" = none ] || return 1
}

self_test() {
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT HUP INT TERM
    printf '%s\n' \
        'schema=SimpleOsServerExecutionReceiptV1' 'mode=unoq-cpu' 'status=pass' \
        'board_id=qrb2210-uno-q' 'adb_serial=test-board' 'boot_id=test-boot' \
        'simpleos_boot=false' 'os_identity=debian' \
        'server_sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' \
        'provenance_sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' \
        'provider_sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' \
        'bundle_sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' \
        'source_manifest_sha256=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc' \
        'compiler_admission_sha256=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd' \
        'command_sha256=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee' \
        'maps_sha256=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff' \
        'credential_scan_sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' \
        'cpu_only=true' 'gpu_selected=false' 'gpu_libraries_loaded=false' \
        'gpu_provider_invoked=false' 'gpu_submit_completed=false' \
        'device_readback_verified=false' 'forced_cpu_backend=true' \
        'accelerator_provider_loaded=false' 'http_status=pass' \
        'http_filesystem_bytes_match=true' 'http_verified=true' \
        'http_expected_sha256=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd' \
        'http_body_sha256=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd' \
        'db_authenticated_write=pass' 'db_restart=pass' \
        'db_authenticated_read=pass' 'db_restart_value_match=true' \
        'db_commit_sha256=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee' \
        'db_read_before_reboot_sha256=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff' \
        'db_read_after_reboot_sha256=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff' \
        'db_generation=1' 'fresh_reboot_count=1' \
        'boot_id_before_reboot=before-boot' 'boot_id_after_reboot=after-boot' \
        'clean_shutdown=true' \
        'mutable_state_owner=host-parent' 'raw_pointer_transport=false' \
        'parent_authoritative_commit=true' 'credential_ephemeral=true' \
        'credential_destroyed=true' 'credential_bytes_retained=false' \
        'credential_live_matches=0' \
        'blocker=none' >"$dir/debian.env"
    if validate_receipt "$dir/debian.env" test-board test-boot \
        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
        bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb; then
        echo "unoq_cpu_server_self_test_status=fail reason=debian-receipt-admitted"
        exit 1
    fi
    sed 's/gpu_selected=false/gpu_selected=true/; s/simpleos_boot=false/simpleos_boot=true/; s/os_identity=debian/os_identity=simpleos/' "$dir/debian.env" >"$dir/gpu.env"
    if validate_receipt "$dir/gpu.env" test-board test-boot \
        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
        bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb; then
        echo "unoq_cpu_server_self_test_status=fail reason=gpu-receipt-admitted"
        exit 1
    fi
    sed 's/http_body_sha256=dddd/http_body_sha256=aaaa/' "$dir/gpu.env" | sed 's/gpu_selected=true/gpu_selected=false/' >"$dir/http-mismatch.env"
    if validate_receipt "$dir/http-mismatch.env" test-board test-boot \
        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
        bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb; then exit 1; fi
    sed 's/boot_id_after_reboot=after-boot/boot_id_after_reboot=before-boot/' "$dir/gpu.env" | sed 's/gpu_selected=true/gpu_selected=false/' >"$dir/no-reboot.env"
    if validate_receipt "$dir/no-reboot.env" test-board test-boot \
        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
        bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb; then exit 1; fi
    sed 's/maps_sha256=ffffffff/maps_sha256=UPPERFFF/' "$dir/gpu.env" | sed 's/gpu_selected=true/gpu_selected=false/' >"$dir/bad-hash.env"
    if validate_receipt "$dir/bad-hash.env" test-board test-boot \
        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
        bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb; then exit 1; fi
    sed 's/db_read_after_reboot_sha256=ffffffff/db_read_after_reboot_sha256=aaaaaaaa/' "$dir/gpu.env" | sed 's/gpu_selected=true/gpu_selected=false/' >"$dir/db-mismatch.env"
    if validate_receipt "$dir/db-mismatch.env" test-board test-boot \
        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
        bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb; then exit 1; fi
    sed 's/credential_live_matches=0/credential_live_matches=1/' "$dir/gpu.env" | sed 's/gpu_selected=true/gpu_selected=false/' >"$dir/credential.env"
    if validate_receipt "$dir/credential.env" test-board test-boot \
        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
        bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb; then exit 1; fi
    cp "$dir/gpu.env" "$dir/duplicate.env"
    printf 'status=pass\n' >>"$dir/duplicate.env"
    if validate_receipt "$dir/duplicate.env" test-board test-boot \
        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
        bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb; then exit 1; fi
    echo "unoq_cpu_server_self_test_status=pass"
    echo "unoq_cpu_server_self_test_evidence=negative-only-no-adb"
    exit 0
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --device) shift; DEVICE=${1:-} ;;
        --output-dir) shift; OUT_DIR=${1:-} ;;
        --self-test) self_test ;;
        *) failed "unknown-argument" ;;
    esac
    shift
done
[ -n "$DEVICE" ] || blocked "adb-device-required"
case "$DEVICE" in *[!A-Za-z0-9._:-]*) failed "unsafe-adb-device-id" ;; esac

if [ -n "${UNOQ_SERVER_MATRIX_LOCK_FD:-}" ]; then
    case "$UNOQ_SERVER_MATRIX_LOCK_FD" in *[!0-9]*|'') blocked "inherited-lock-fd-invalid" ;; esac
    inherited_lock_target=$(readlink "/proc/$$/fd/$UNOQ_SERVER_MATRIX_LOCK_FD" 2>/dev/null || true)
    [ "$inherited_lock_target" = "$LOCK_PATH" ] || blocked "inherited-lock-fd-not-unoq-lock"
    flock -n "$UNOQ_SERVER_MATRIX_LOCK_FD" || blocked "inherited-lock-fd-not-locked"
else
    exec 9>"$LOCK_PATH"
    flock -n 9 || blocked "unoq-server-matrix-lock-busy"
fi

command -v adb >/dev/null 2>&1 || blocked "adb-missing"
command -v timeout >/dev/null 2>&1 || blocked "timeout-missing"
command -v sha256sum >/dev/null 2>&1 || blocked "sha256sum-missing"
command -v realpath >/dev/null 2>&1 || blocked "realpath-missing"
command -v nc >/dev/null 2>&1 || blocked "netcat-missing"
command -v od >/dev/null 2>&1 || blocked "od-missing"

# Current-source compiler and target payload admission precede every board read.
LOCAL_SERVER_ELF=${UNOQ_CPU_SERVER_ELF:-}
LOCAL_COMPILER_ADMISSION=${UNOQ_CPU_COMPILER_ADMISSION:-}
LOCAL_SOURCE_MANIFEST=${UNOQ_CPU_SOURCE_MANIFEST:-}
[ -n "$LOCAL_SERVER_ELF" ] && [ -f "$LOCAL_SERVER_ELF" ] && [ ! -L "$LOCAL_SERVER_ELF" ] || blocked "admitted-current-source-aarch64-server-elf-missing"
[ -n "$LOCAL_COMPILER_ADMISSION" ] && [ -f "$LOCAL_COMPILER_ADMISSION" ] && [ ! -L "$LOCAL_COMPILER_ADMISSION" ] || blocked "compiler-admission-receipt-missing"
[ -n "$LOCAL_SOURCE_MANIFEST" ] && [ -f "$LOCAL_SOURCE_MANIFEST" ] && [ ! -L "$LOCAL_SOURCE_MANIFEST" ] || blocked "source-manifest-missing"
grep -Fqx 'schema=simpleos-arm64-current-source-compiler-admission-v1' "$LOCAL_COMPILER_ADMISSION" || blocked "compiler-admission-schema-invalid"
local_server_sha=$(sha256sum "$LOCAL_SERVER_ELF" | awk '{print $1}')
local_manifest_sha=$(sha256sum "$LOCAL_SOURCE_MANIFEST" | awk '{print $1}')
grep -Fqx "native_smoke_output_sha256=$local_server_sha" "$LOCAL_COMPILER_ADMISSION" || blocked "compiler-admission-server-hash-mismatch"
grep -Fqx "source_manifest_sha256=$local_manifest_sha" "$LOCAL_COMPILER_ADMISSION" || blocked "compiler-admission-source-manifest-mismatch"
source_revision=$(git -C "$ROOT" rev-parse HEAD)
grep -Fqx "source_revision=$source_revision" "$LOCAL_COMPILER_ADMISSION" || blocked "compiler-admission-head-stale"
grep -Fqx 'native_smoke_status=pass' "$LOCAL_COMPILER_ADMISSION" || blocked "compiler-admission-native-smoke-missing"
grep -Fqx 'stub_fallback=forbidden' "$LOCAL_COMPILER_ADMISSION" || blocked "compiler-admission-stub-policy-invalid"
compiler_admission_sha=$(sha256sum "$LOCAL_COMPILER_ADMISSION" | awk '{print $1}')
adb_run() { timeout 120 adb -s "$DEVICE" "$@"; }

# Identity is authoritative only when SimpleOS supplies its release marker and
# the vendor Debian marker is absent. Never relabel Debian as SimpleOS.
adb_run shell test -r /etc/simpleos-release >/dev/null 2>&1 || blocked "physical-simpleos-identity-missing"
if adb_run shell test -e /etc/debian_version >/dev/null 2>&1; then blocked "vendor-debian-is-not-simpleos"; fi
adb_run shell test -r "$REMOTE_BOOT_IDENTITY" >/dev/null 2>&1 || blocked "authoritative-simpleos-qrb2210-boot-identity-missing"
adb_run shell grep -Fqx 'board_id=qrb2210-uno-q' "$REMOTE_BOOT_IDENTITY" >/dev/null 2>&1 || blocked "simpleos-boot-board-mismatch"
adb_run shell grep -Fq 'bundle_sha256=' "$REMOTE_BOOT_IDENTITY" >/dev/null 2>&1 || blocked "simpleos-signed-boot-bundle-unproven"
adb_run shell grep -Fq 'recovery_sha256=' "$REMOTE_BOOT_IDENTITY" >/dev/null 2>&1 || blocked "simpleos-recovery-identity-unproven"
model=$(adb_run exec-out cat /proc/device-tree/model 2>/dev/null | tr -d '\000\r\n')
case "$model" in *Arduino*Imola*) ;; *) blocked "physical-board-identity-mismatch" ;; esac
boot_id=$(adb_run shell cat /proc/sys/kernel/random/boot_id 2>/dev/null | tr -d '\r\n')
[ -n "$boot_id" ] || blocked "boot-identity-missing"
bundle_sha=$(adb_run shell sed -n 's/^bundle_sha256=//p' "$REMOTE_BOOT_IDENTITY" | tr -d '\r\n')
is_sha256 "$bundle_sha" || blocked "simpleos-signed-boot-bundle-hash-invalid"

adb_run shell test -x "$REMOTE_PROVIDER" >/dev/null 2>&1 || blocked "cpu-server-evidence-provider-missing"
adb_run shell test -x "$REMOTE_SERVER" >/dev/null 2>&1 || blocked "filesystem-server-executable-missing"
adb_run shell test -r "$REMOTE_PROVENANCE" >/dev/null 2>&1 || blocked "server-provenance-missing"
server_sha=$(adb_run shell sha256sum "$REMOTE_SERVER" | awk '{print $1}')
provenance_sha=$(adb_run shell sha256sum "$REMOTE_PROVENANCE" | awk '{print $1}')
provenance_server_sha=$(adb_run shell sed -n 's/^server_sha256=//p' "$REMOTE_PROVENANCE" | tr -d '\r\n')
[ "$server_sha" = "$provenance_server_sha" ] || blocked "server-provenance-hash-mismatch"
[ "$server_sha" = "$local_server_sha" ] || blocked "board-server-is-not-admitted-current-source-elf"
adb_run shell grep -Fqx "source_revision=$source_revision" "$REMOTE_PROVENANCE" >/dev/null 2>&1 || blocked "remote-provenance-source-revision-mismatch"
adb_run shell grep -Fqx "source_manifest_sha256=$local_manifest_sha" "$REMOTE_PROVENANCE" >/dev/null 2>&1 || blocked "remote-provenance-source-manifest-mismatch"
adb_run shell grep -Fqx "compiler_admission_sha256=$compiler_admission_sha" "$REMOTE_PROVENANCE" >/dev/null 2>&1 || blocked "remote-provenance-compiler-admission-mismatch"

canonical_output=$(realpath -m "$OUT_DIR")
case "$canonical_output" in "$ROOT"/build/test-artifacts/*) ;; *) blocked "unsafe-output-directory" ;; esac
[ "$canonical_output" = "$OUT_DIR" ] || blocked "output-directory-not-canonical"
[ ! -L "$OUT_DIR" ] || blocked "output-directory-symlink-forbidden"
mkdir -p "$OUT_DIR"
run_dir=$(mktemp -d "$OUT_DIR/.unoq-cpu-live-XXXXXX.tmp")
chmod 700 "$run_dir"
cleanup_live() {
    set +e
    adb -s "$DEVICE" shell rm -f "$REMOTE_RECEIPT" "$REMOTE_CREDENTIAL" "$REMOTE_CREDENTIAL_SCAN" >/dev/null 2>&1
    adb -s "$DEVICE" shell pkill -f simpleos-unoq-cpu-server-evidence >/dev/null 2>&1
    adb -s "$DEVICE" forward --remove tcp:18080 >/dev/null 2>&1
    adb -s "$DEVICE" forward --remove tcp:15433 >/dev/null 2>&1
    credential=
    rm -rf "$run_dir"
}
trap cleanup_live EXIT HUP INT TERM
credential=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
is_sha256 "$credential" || failed "ephemeral-credential-generation-failed"
printf '%s' "$credential" >"$run_dir/credential"
chmod 600 "$run_dir/credential"
adb -s "$DEVICE" push "$run_dir/credential" "$REMOTE_CREDENTIAL" >"$run_dir/credential-push.stdout" 2>"$run_dir/credential-push.stderr" || blocked "ephemeral-credential-transfer-failed"
adb_run shell chmod 600 "$REMOTE_CREDENTIAL" >/dev/null 2>&1 || blocked "ephemeral-credential-permissions-failed"
provider_sha=$(adb_run shell sha256sum "$REMOTE_PROVIDER" | awk '{print $1}')
adb_run shell "$REMOTE_PROVIDER" --cpu-only --phase before-reboot --credential-file "$REMOTE_CREDENTIAL" --receipt "$REMOTE_RECEIPT" >"$run_dir/provider-before.stdout" 2>"$run_dir/provider-before.stderr" || blocked "cpu-server-before-reboot-provider-failed"
server_pid=$(adb_run shell sed -n 's/^server_pid=//p' "$REMOTE_RECEIPT" | tr -d '\r\n')
case "$server_pid" in ''|*[!0-9]*) failed "server-pid-invalid" ;; esac
server_exe=$(adb_run shell readlink "/proc/$server_pid/exe" | tr -d '\r\n')
[ "$server_exe" = "$REMOTE_SERVER" ] || failed "server-pid-executable-mismatch"
adb_run exec-out cat "/proc/$server_pid/exe" >"$run_dir/server-before.exe" || blocked "server-pid-executable-unreadable"
[ "$(sha256sum "$run_dir/server-before.exe" | awk '{print $1}')" = "$server_sha" ] || failed "server-pid-executable-hash-mismatch"
adb_run exec-out cat "/proc/$server_pid/cmdline" | tr '\000' ' ' >"$run_dir/server-before.cmdline" || blocked "server-cmdline-unavailable"
grep -Fq -- '--cpu-only' "$run_dir/server-before.cmdline" || failed "server-cmdline-not-forced-cpu"
adb_run exec-out cat "/proc/$server_pid/maps" >"$run_dir/server-before.maps" || blocked "server-maps-unavailable"
if grep -Eqi 'vulkan|cuda|adreno|libOpenCL|libGL' "$run_dir/server-before.maps"; then failed "accelerator-library-observed-in-cpu-server"; fi
adb_run shell ls -l "/proc/$server_pid/fd" >"$run_dir/server-before.fds" || blocked "server-fds-unavailable"
if grep -Eqi '/dev/dri|kgsl|adreno|renderD' "$run_dir/server-before.fds"; then failed "accelerator-device-fd-observed-in-cpu-server"; fi

# Host-owned HTTP and authenticated database observations; provider booleans
# cannot substitute for these raw transcripts and hashes.
before_boot_id=$boot_id
adb -s "$DEVICE" forward tcp:18080 tcp:8080 >/dev/null || blocked "http-forward-failed"
adb -s "$DEVICE" exec-out cat /SYS/README.TXT >"$run_dir/http.expected" || blocked "http-expected-file-read-failed"
printf 'GET /files/README.TXT HTTP/1.1\r\nHost: uno-q\r\nConnection: close\r\n\r\n' | nc -w 10 127.0.0.1 18080 >"$run_dir/http.response" || failed "host-http-request-failed"
sed '1,/^\r$/d' "$run_dir/http.response" >"$run_dir/http.body"
[ "$(sha256sum "$run_dir/http.expected" | awk '{print $1}')" = "$(sha256sum "$run_dir/http.body" | awk '{print $1}')" ] || failed "host-http-filesystem-bytes-mismatch"
adb -s "$DEVICE" forward tcp:15433 tcp:5433 >/dev/null || blocked "db-forward-failed"
db_value="unoq-$before_boot_id"
printf 'OPEN operator %s\nWRITE records unoq-accept %s\nREAD records unoq-accept\n' "$credential" "$db_value" | nc -w 10 127.0.0.1 15433 >"$run_dir/db-before.response" || failed "host-db-before-reboot-failed"
grep -Fq "$db_value" "$run_dir/db-before.response" || failed "host-db-before-value-missing"
adb_run shell sync >/dev/null 2>&1 || blocked "pre-reboot-sync-failed"
adb_run shell reboot >/dev/null 2>&1 || blocked "fresh-reboot-request-failed"
timeout 120 adb -s "$DEVICE" wait-for-device >/dev/null 2>&1 || blocked "fresh-reboot-device-timeout"
after_boot_id=$(adb_run shell cat /proc/sys/kernel/random/boot_id 2>/dev/null | tr -d '\r\n')
[ "$after_boot_id" != "$before_boot_id" ] || failed "fresh-reboot-not-observed"
adb -s "$DEVICE" push "$run_dir/credential" "$REMOTE_CREDENTIAL" >"$run_dir/credential-repush.stdout" 2>"$run_dir/credential-repush.stderr" || blocked "post-reboot-credential-transfer-failed"
adb_run shell chmod 600 "$REMOTE_CREDENTIAL" >/dev/null 2>&1 || blocked "post-reboot-credential-permissions-failed"
adb_run shell "$REMOTE_PROVIDER" --cpu-only --phase after-reboot --before-boot-id "$before_boot_id" --credential-file "$REMOTE_CREDENTIAL" --receipt "$REMOTE_RECEIPT" >"$run_dir/provider-after.stdout" 2>"$run_dir/provider-after.stderr" || blocked "cpu-server-after-reboot-provider-failed"
adb_run shell cat "$REMOTE_RECEIPT" | tr -d '\r' >"$run_dir/receipt.env" || blocked "cpu-server-receipt-acquisition-failed"
[ "$(receipt_value "$run_dir/receipt.env" boot_id_after_reboot)" = "$after_boot_id" ] || failed "post-reboot-receipt-boot-mismatch"
post_server_pid=$(receipt_value "$run_dir/receipt.env" server_pid) || failed "post-reboot-server-pid-missing"
case "$post_server_pid" in ''|*[!0-9]*) failed "post-reboot-server-pid-invalid" ;; esac
[ "$(adb_run shell readlink "/proc/$post_server_pid/exe" | tr -d '\r\n')" = "$REMOTE_SERVER" ] || failed "post-reboot-server-executable-mismatch"
adb_run exec-out cat "/proc/$post_server_pid/exe" >"$run_dir/server-after.exe" || blocked "post-reboot-server-executable-unreadable"
[ "$(sha256sum "$run_dir/server-after.exe" | awk '{print $1}')" = "$server_sha" ] || failed "post-reboot-server-executable-hash-mismatch"
adb_run exec-out cat "/proc/$post_server_pid/cmdline" | tr '\000' ' ' >"$run_dir/server-after.cmdline" || blocked "post-reboot-server-cmdline-unavailable"
grep -Fq -- '--cpu-only' "$run_dir/server-after.cmdline" || failed "post-reboot-server-not-forced-cpu"
adb_run exec-out cat "/proc/$post_server_pid/maps" >"$run_dir/server-after.maps" || blocked "post-reboot-server-maps-unavailable"
adb_run shell ls -l "/proc/$post_server_pid/fd" >"$run_dir/server-after.fds" || blocked "post-reboot-server-fds-unavailable"
if grep -Eqi 'vulkan|cuda|adreno|libOpenCL|libGL|/dev/dri|kgsl|renderD' "$run_dir/server-after.maps" "$run_dir/server-after.fds"; then failed "post-reboot-accelerator-observed"; fi
adb -s "$DEVICE" forward tcp:15433 tcp:5433 >/dev/null || blocked "post-reboot-db-forward-failed"
printf 'OPEN operator %s\nREAD records unoq-accept\n' "$credential" | nc -w 10 127.0.0.1 15433 >"$run_dir/db-after.response" || failed "host-db-after-reboot-failed"
grep -Fq "$db_value" "$run_dir/db-after.response" || failed "host-db-after-value-missing"
[ "$(wc -c <"$run_dir/receipt.env")" -le "$MAX_RECEIPT_BYTES" ] || failed "cpu-server-receipt-too-large"
validate_receipt "$run_dir/receipt.env" "$DEVICE" "$after_boot_id" "$server_sha" "$provenance_sha" || failed "cpu-server-receipt-rejected"
[ "$(receipt_value "$run_dir/receipt.env" source_revision)" = "$source_revision" ] || failed "receipt-source-revision-mismatch"
[ "$(receipt_value "$run_dir/receipt.env" source_manifest_sha256)" = "$local_manifest_sha" ] || failed "receipt-source-manifest-mismatch"
[ "$(receipt_value "$run_dir/receipt.env" compiler_admission_sha256)" = "$compiler_admission_sha" ] || failed "receipt-compiler-admission-mismatch"
[ "$(receipt_value "$run_dir/receipt.env" provider_sha256)" = "$provider_sha" ] || failed "receipt-provider-hash-mismatch"
[ "$(receipt_value "$run_dir/receipt.env" bundle_sha256)" = "$bundle_sha" ] || failed "receipt-bundle-hash-mismatch"
maps_sha=$(sha256sum "$run_dir/server-before.maps" | awk '{print $1}')
[ "$(receipt_value "$run_dir/receipt.env" maps_sha256)" = "$maps_sha" ] || failed "maps-receipt-hash-mismatch"
post_server_sha=$(adb_run shell sha256sum "$REMOTE_SERVER" | awk '{print $1}')
[ "$post_server_sha" = "$server_sha" ] || failed "server-changed-during-reboot-campaign"
post_provider_sha=$(adb_run shell sha256sum "$REMOTE_PROVIDER" | awk '{print $1}')
[ "$post_provider_sha" = "$provider_sha" ] || failed "provider-changed-during-reboot-campaign"
adb_run exec-out cat "$REMOTE_CREDENTIAL_SCAN" >"$run_dir/credential-scan.bin" || blocked "credential-scan-acquisition-failed"
if grep -Fq "$credential" "$run_dir/credential-scan.bin"; then failed "credential-bytes-retained"; fi
adb_run shell rm -f "$REMOTE_RECEIPT" "$REMOTE_CREDENTIAL" "$REMOTE_CREDENTIAL_SCAN" >/dev/null 2>&1 || failed "remote-cleanup-failed"
for remote_file in "$REMOTE_RECEIPT" "$REMOTE_CREDENTIAL" "$REMOTE_CREDENTIAL_SCAN"; do
    if adb_run shell test -e "$remote_file" >/dev/null 2>&1; then failed "remote-cleanup-unverified"; fi
done
credential=
rm -f "$run_dir/credential"
[ ! -e "$run_dir/credential" ] || failed "local-credential-cleanup-unverified"
receipt_sha=$(sha256sum "$run_dir/receipt.env" | awk '{print $1}')
final_dir=$OUT_DIR/unoq-cpu-live-$(date -u +%Y%m%dT%H%M%SZ)
mv "$run_dir" "$final_dir"
trap - EXIT HUP INT TERM
printf '%s\n' \
    "unoq_cpu_server_status=pass" \
    "unoq_cpu_server_reason=physical-simpleos-cpu-server-receipt-admitted" \
    "unoq_cpu_server_evidence_class=live-runner-owned" \
    "unoq_cpu_server_receipt=$final_dir/receipt.env" \
    "unoq_cpu_server_receipt_sha256=$receipt_sha" \
    "unoq_cpu_server_provider_sha256=$provider_sha"
