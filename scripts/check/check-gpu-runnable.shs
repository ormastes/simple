#!/bin/sh
# check-gpu-runnable.shs - repo gate for the GPU-runnable transitive scanner.
#
# Runs src/app/gpu_lint/gpu_runnable_scan.spl in --summary WARNING mode:
# it reports blocked names / blocked roots but ALWAYS exits 0, so it never
# fails a commit yet. To make it a hard CI gate later, add --strict to the
# scanner invocation below (the scanner then exits 1 when any ROOT is
# BLOCKED) and propagate scan_rc instead of forcing exit 0.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
SIMPLE_BINARY=${SIMPLE_BINARY:-"$repo_root/bin/simple"}
case "$SIMPLE_BINARY" in
    /*) ;;
    *) SIMPLE_BINARY="$repo_root/$SIMPLE_BINARY" ;;
esac

if [ ! -x "$SIMPLE_BINARY" ]; then
    echo "gpu_runnable_gate=skip"
    echo "warning=missing_simple_binary:$SIMPLE_BINARY"
    exit 0
fi

report_path=${GPU_RUNNABLE_REPORT:-"$repo_root/build/gpu_runnable_report.txt"}
mkdir -p "$(dirname "$report_path")"

run_with_timeout() {
    if command -v timeout >/dev/null 2>&1; then
        timeout -k 10s 900s "$@"
    elif command -v gtimeout >/dev/null 2>&1; then
        gtimeout -k 10s 900s "$@"
    else
        "$@"
    fi
}

set +e
scan_output=$(cd "$repo_root" && run_with_timeout env SIMPLE_TIMEOUT_SECONDS=3600 \
    "$SIMPLE_BINARY" run src/app/gpu_lint/gpu_runnable_scan.spl \
    --summary "--report=$report_path" 2>&1)
scan_rc=$?
set -e

# Show only the scanner's summary lines (skip seed/deprecation warnings).
printf '%s\n' "$scan_output" | grep -E \
    '^(gpu_runnable_scan:|blocked |roots:|  BLOCKED |full report:)' || true
echo "gpu_runnable_scan_rc=$scan_rc"

if [ "$scan_rc" -ne 0 ]; then
    echo "warning=gpu_runnable_scan_failed_rc_$scan_rc"
fi
# WARNING MODE: never fail the commit (see header for --strict upgrade path).
echo "gpu_runnable_gate=warn_only_pass"
exit 0
