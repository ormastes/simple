#!/bin/sh
set -eu

# FreeBSD QEMU Bootstrap Check
#
# Usage:
#   sh scripts/check-freebsd-bootstrap-qemu.shs --smoke   # VM start + SSH + uname
#   sh scripts/check-freebsd-bootstrap-qemu.shs --full    # Full bootstrap verification
#   sh scripts/check-freebsd-bootstrap-qemu.shs --phase2-only  # Both Stage 2 backends
#
# Env knobs:
#   QEMU_VM_PATH         Admitted base qcow2 image (default: shared media)
#   QEMU_BASE_VM_PATH    Alias for QEMU_VM_PATH
#   QEMU_CLOUDINIT_ISO   Cloud-init seed ISO (default: build/freebsd/vm/freebsd-cloudinit-seed.iso)
#   QEMU_VM_DIR          Working directory for disposable overlays and retained logs
#   SIMPLE_BIG_STORAGE_ROOT Shared media root (default: $HOME/.simple)
#   SIMPLE_FREEBSD_MEDIA_SHA256 Trusted SHA-256 (or use <image>.sha256 sidecar)
#   QEMU_SSH_PUBLIC_KEY   SSH public key to inject (default: ~/.ssh/id_ed25519.pub or ~/.ssh/id_rsa.pub)
#   QEMU_SSH_PRIVATE_KEY  Matching SSH private key (default: public-key path without .pub)
#   QEMU_PORT            SSH forwarding port (default: 2222)
#   QEMU_USER            VM user (default: freebsd)
#   QEMU_ARCH            Guest arch: amd64|arm64 (default: host arch — aarch64
#                        hosts boot aarch64 guests under KVM; x86 guests only
#                        when explicitly configured)
#                        KVM also requires this process to access /dev/kvm.
#                        If group membership changed since login, launch the
#                        next VM through `sg kvm -c 'sh ... --phase2-only'`.
#   QEMU_EFI_FD          aarch64 UEFI firmware path (arm64 only; auto-resolves
#                        to system qemu-efi-aarch64/AAVMF, else rootless
#                        'apt download qemu-efi-aarch64' + dpkg -x into
#                        ~/.simple/qemu/firmware)
#   QEMU_MEM             RAM (default: 32G)
#   QEMU_DISK_SIZE       Sparse overlay virtual capacity in GiB (default: 48G;
#                        accepted range: 40G..2048G)
#   QEMU_HOST_FREE_FLOOR_GIB Minimum physical free space on the overlay
#                        filesystem in GiB (default: 4; accepted: 1..1024)
#   QEMU_CPUS            CPUs (default: 10)
#   Per-host config (untracked, gitignored): .simple/qemu-host.conf at the
#   repo root or ~/.simple/qemu-host.conf is sourced at startup; use
#   ': "${QEMU_MEM:=16G}"' there so explicit env exports still win.
#   QEMU_SSH_TIMEOUT     Initial SSH wait seconds (default: 1800; pristine images
#                        may run freebsd-update before nuageinit/sshd)
#   QEMU_ROOT_SSH_TIMEOUT Root SSH wait seconds after user SSH (default: 120)
#   QEMU_PHASE2_BACKEND   both|llvm|cranelift (default: both)
#   QEMU_PHASE2_JOBS      Stage 2 requested jobs (default: QEMU_CPUS)
#   QEMU_PHASE2_BUILD_THREADS Explicit verifier native-build threads (optional)
#   QEMU_PHASE2_TEST_WORKERS Explicit verifier test workers (optional)

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

. "$ROOT_DIR/scripts/check/lib/bootstrap-stage3/sanity.shs"
EXPECTED_BOOTSTRAP_VERSION=$(bootstrap_stage3_canonical_version "$ROOT_DIR") || {
    printf '%s\n' 'FreeBSD bootstrap check: release/version.sdn or its VERSION projection is invalid' >&2
    exit 2
}

# Per-host, untracked config (gitignored): repo-local wins over ~/.simple.
# Use ': "${VAR:=value}"' inside the file to keep explicit env exports
# taking precedence. Knobs: QEMU_ARCH, QEMU_MEM, QEMU_DISK_SIZE, QEMU_CPUS, QEMU_EFI_FD.
[ -f "${HOME}/.simple/qemu-host.conf" ] && . "${HOME}/.simple/qemu-host.conf"
[ -f "${ROOT_DIR}/.simple/qemu-host.conf" ] && . "${ROOT_DIR}/.simple/qemu-host.conf"

# Guest arch defaults to the HOST arch — never emulate x86 on aarch64 hosts
# unless explicitly configured (QEMU_ARCH=amd64).
_host_arch="$(uname -m 2>/dev/null || echo unknown)"
case "$_host_arch" in
    aarch64|arm64) _host_arch=arm64 ;;
    x86_64|amd64) _host_arch=amd64 ;;
    *) _host_arch=amd64 ;;
esac
QEMU_ARCH="${QEMU_ARCH:-$_host_arch}"
case "$QEMU_ARCH" in
    amd64|x86_64) QEMU_ARCH=amd64 ;;
    arm64|aarch64) QEMU_ARCH=arm64 ;;
    *) printf 'Invalid QEMU_ARCH: %s (expected amd64|arm64)\n' "$QEMU_ARCH" >&2; exit 2 ;;
esac

VM_DIR="${QEMU_VM_DIR:-${ROOT_DIR}/build/freebsd/vm}"
QEMU_PORT="${QEMU_PORT:-2222}"
QEMU_USER="${QEMU_USER:-freebsd}"
QEMU_MEM="${QEMU_MEM:-32G}"
QEMU_DISK_SIZE="${QEMU_DISK_SIZE:-48G}"
QEMU_HOST_FREE_FLOOR_GIB="${QEMU_HOST_FREE_FLOOR_GIB:-4}"
QEMU_CPUS="${QEMU_CPUS:-10}"
QEMU_PHASE2_BACKEND="${QEMU_PHASE2_BACKEND:-both}"
QEMU_PHASE2_JOBS="${QEMU_PHASE2_JOBS:-${QEMU_CPUS}}"
QEMU_PHASE2_BUILD_THREADS="${QEMU_PHASE2_BUILD_THREADS:-}"
QEMU_PHASE2_TEST_WORKERS="${QEMU_PHASE2_TEST_WORKERS:-}"
QEMU_SSH_TIMEOUT="${QEMU_SSH_TIMEOUT:-1800}"
QEMU_ROOT_SSH_TIMEOUT="${QEMU_ROOT_SSH_TIMEOUT:-120}"
QEMU_REMOTE_TIMEOUT="${QEMU_REMOTE_TIMEOUT:-300}"
QEMU_PACKAGE_TIMEOUT="${QEMU_PACKAGE_TIMEOUT:-1800}"
QEMU_TRANSFER_TIMEOUT="${QEMU_TRANSFER_TIMEOUT:-1800}"
QEMU_BOOTSTRAP_TIMEOUT="${QEMU_BOOTSTRAP_TIMEOUT:-7200}"
QEMU_SMOKE_TIMEOUT="${QEMU_SMOKE_TIMEOUT:-600}"
QEMU_FULL_TIMEOUT="${QEMU_FULL_TIMEOUT:-7200}"
FREEBSD_VERSION="14.4"
case "$QEMU_ARCH" in
    arm64)
        FREEBSD_IMAGE_NAME="FreeBSD-${FREEBSD_VERSION}-RELEASE-arm64-aarch64-BASIC-CLOUDINIT-ufs.qcow2"
        FREEBSD_IMAGE_FETCH_URL="https://download.freebsd.org/releases/VM-IMAGES/${FREEBSD_VERSION}-RELEASE/aarch64/Latest/${FREEBSD_IMAGE_NAME}.xz"
        ;;
    amd64)
        FREEBSD_IMAGE_NAME="FreeBSD-${FREEBSD_VERSION}-RELEASE-amd64-BASIC-CLOUDINIT-ufs.qcow2"
        FREEBSD_IMAGE_FETCH_URL="https://download.freebsd.org/releases/VM-IMAGES/${FREEBSD_VERSION}-RELEASE/amd64/Latest/${FREEBSD_IMAGE_NAME}.xz"
        ;;
esac
MEDIA_CHECKER="${ROOT_DIR}/scripts/qemu/simple-freebsd-media.shs"
SHARED_MEDIA_ROOT="${SIMPLE_BIG_STORAGE_ROOT:-${HOME}/.simple}/qemu/images/freebsd"
QEMU_VM_PATH="${QEMU_VM_PATH:-${QEMU_BASE_VM_PATH:-${SIMPLE_FREEBSD_MEDIA_PATH:-${SHARED_MEDIA_ROOT}/${FREEBSD_IMAGE_NAME}}}}"
QEMU_CLOUDINIT_ISO="${QEMU_CLOUDINIT_ISO:-${VM_DIR}/freebsd-cloudinit-seed.iso}"
PID_FILE="${VM_DIR}/qemu.pid"
SERIAL_LOG="${VM_DIR}/qemu-serial.log"
QEMU_START_LOG="${VM_DIR}/qemu-start.log"
OVERLAY_IMAGE="${VM_DIR}/freebsd-run.overlay.qcow2"
PROVENANCE_DIR="${ROOT_DIR}/build/freebsd/bootstrap-logs"
PROVENANCE_RECEIPT="${PROVENANCE_DIR}/freebsd_qemu_bootstrap_provenance.env"

MODE=""
MODE_SET=0
MODE_VALID=1
PREFLIGHT=0
ARG_REASON="none"
usage_error() {
    printf 'Usage: %s [--smoke|--full|--phase2-only] [--preflight]\n' "$0" >&2
    exit 1
}

for arg in "$@"; do
    case "$arg" in
        --smoke)
            if [ "$MODE_SET" -eq 1 ]; then
                MODE_VALID=0
                ARG_REASON="mode_multiple"
            else
                MODE="smoke"
                MODE_SET=1
            fi
            ;;
        --full)
            if [ "$MODE_SET" -eq 1 ]; then
                MODE_VALID=0
                ARG_REASON="mode_multiple"
            else
                MODE="full"
                MODE_SET=1
            fi
            ;;
        --phase2-only)
            if [ "$MODE_SET" -eq 1 ]; then
                MODE_VALID=0
                ARG_REASON="mode_multiple"
            else
                MODE="phase2-only"
                MODE_SET=1
            fi
            ;;
        --preflight) PREFLIGHT=1 ;;
        --help|-h)
            printf 'Usage: %s [--smoke|--full|--phase2-only] [--preflight]\n' "$0"
            exit 0
            ;;
        *)
            MODE_VALID=0
            ARG_REASON="argument_invalid"
            ;;
    esac
done

if [ "$MODE_SET" -eq 0 ]; then
    MODE="smoke"
fi

is_positive_integer() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -gt 0 ] 2>/dev/null
}

is_valid_memory() {
    case "$1" in
        [1-9][MGT]|[1-9][0-9]*[MGT]) return 0 ;;
        *) return 1 ;;
    esac
}

is_valid_disk_size() {
    case "$1" in
        *G) _disk_gib=${1%G} ;;
        *) return 1 ;;
    esac
    case "$_disk_gib" in
        ''|0*|*[!0-9]*) return 1 ;;
    esac
    [ "$_disk_gib" -ge 40 ] 2>/dev/null &&
        [ "$_disk_gib" -le 2048 ] 2>/dev/null
}

is_valid_host_free_floor() {
    case "$1" in 0*) return 1 ;; esac
    is_positive_integer "$1" && [ "$1" -le 1024 ] 2>/dev/null
}

# df must inspect the filesystem that will hold the overlay. Before VM_DIR
# exists, its nearest existing parent is on that same filesystem.
overlay_df_path() {
    _disk_path=$VM_DIR
    while [ ! -e "$_disk_path" ]; do
        _disk_parent=${_disk_path%/*}
        [ "$_disk_parent" != "$_disk_path" ] || _disk_parent=.
        [ -n "$_disk_parent" ] || _disk_parent=/
        _disk_path=$_disk_parent
    done
    [ -d "$_disk_path" ] || return 1
    printf '%s\n' "$_disk_path"
}

overlay_free_kib() {
    _disk_probe_path=$(overlay_df_path) || return 1
    _disk_df=$(df -Pk "$_disk_probe_path" 2>/dev/null) || return 1
    _disk_rows=$(printf '%s\n' "$_disk_df" | awk 'END { print NR }')
    [ "$_disk_rows" -eq 2 ] || return 1
    _disk_available=$(printf '%s\n' "$_disk_df" | awk 'NR == 2 { print $4 }')
    case "$_disk_available" in ''|0[0-9]*|*[!0-9]*) return 1 ;; esac
    printf '%s\n' "$_disk_available"
}

host_free_space_receipt() {
    _disk_available_kib=$(overlay_free_kib) || return 1
    _disk_required_kib=$((QEMU_HOST_FREE_FLOOR_GIB * 1048576))
    _disk_actual_path=$(overlay_df_path) || return 1
    printf 'overlay_filesystem_path=%s\n' "$_disk_actual_path"
    printf 'overlay_available_bytes=%s\n' "$((_disk_available_kib * 1024))"
    printf 'overlay_required_bytes=%s\n' "$((_disk_required_kib * 1024))"
    [ "$_disk_available_kib" -ge "$_disk_required_kib" ]
}

is_valid_port() {
    is_positive_integer "$1" || return 1
    [ "$1" -le 65535 ] 2>/dev/null
}

is_valid_user() {
    case "$1" in
        ''|-[A-Za-z0-9_]*|*[!A-Za-z0-9_-]*) return 1 ;;
        *) return 0 ;;
    esac
}

TIMEOUT_BIN="${QEMU_TIMEOUT_BIN:-}"
if [ -z "$TIMEOUT_BIN" ]; then
    TIMEOUT_BIN="$(command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true)"
fi

PREFLIGHT_ORDER="mode,port,user,memory,disk_size,host_free_floor,host_free_space,cpus,phase2_backend,phase2_jobs,phase2_build_threads,phase2_test_workers,phase2_isolation,ssh_timeout,root_ssh_timeout,timeout,architecture,qemu_system,qemu_img,ssh,rsync,iso_tool,admitted_media,ssh_public_key,ssh_private_key,workspace"
PREFLIGHT_REASON="none"

preflight_try() {
    check_name="$1"
    shift
    if ! "$@"; then
        if [ "$PREFLIGHT_REASON" = "none" ]; then
            PREFLIGHT_REASON="$check_name"
        fi
    fi
}

preflight_mode() {
    [ "$MODE_VALID" -eq 1 ] && [ "$ARG_REASON" = "none" ]
}

preflight_port() { is_valid_port "$QEMU_PORT"; }
preflight_user() { is_valid_user "$QEMU_USER"; }
preflight_memory() { is_valid_memory "$QEMU_MEM"; }
preflight_disk_size() { is_valid_disk_size "$QEMU_DISK_SIZE"; }
preflight_host_free_floor() { is_valid_host_free_floor "$QEMU_HOST_FREE_FLOOR_GIB"; }
preflight_host_free_space() {
    is_valid_host_free_floor "$QEMU_HOST_FREE_FLOOR_GIB" || return 1
    host_free_space_receipt >/dev/null
}
preflight_cpus() { is_positive_integer "$QEMU_CPUS"; }
preflight_phase2_backend() {
    case "$QEMU_PHASE2_BACKEND" in both|llvm|cranelift) return 0 ;; *) return 1 ;; esac
}
preflight_phase2_jobs() {
    is_positive_integer "$QEMU_PHASE2_JOBS" &&
        [ "$QEMU_PHASE2_JOBS" -le "$QEMU_CPUS" ]
}
preflight_phase2_build_threads() {
    [ -z "$QEMU_PHASE2_BUILD_THREADS" ] ||
        { is_positive_integer "$QEMU_PHASE2_BUILD_THREADS" &&
          [ "$QEMU_PHASE2_BUILD_THREADS" -le "$QEMU_CPUS" ]; }
}
preflight_phase2_test_workers() {
    [ -z "$QEMU_PHASE2_TEST_WORKERS" ] ||
        { is_positive_integer "$QEMU_PHASE2_TEST_WORKERS" &&
          [ "$QEMU_PHASE2_TEST_WORKERS" -le "$QEMU_CPUS" ] &&
          [ "$QEMU_PHASE2_TEST_WORKERS" -le 80 ]; }
}
preflight_phase2_isolation() {
    [ "$MODE" != phase2-only ] ||
        { [ -n "${QEMU_VM_DIR:-}" ] && [ ! -e "$PID_FILE" ] &&
          [ ! -e "$OVERLAY_IMAGE" ] && [ ! -e "$VM_DIR/.phase2-run.lock" ]; }
}
preflight_ssh_timeout() { is_positive_integer "$QEMU_SSH_TIMEOUT"; }
preflight_root_ssh_timeout() { is_positive_integer "$QEMU_ROOT_SSH_TIMEOUT"; }

preflight_timeout() {
    [ -n "$TIMEOUT_BIN" ] || return 1
    is_positive_integer "$QEMU_REMOTE_TIMEOUT" || return 1
    is_positive_integer "$QEMU_PACKAGE_TIMEOUT" || return 1
    is_positive_integer "$QEMU_TRANSFER_TIMEOUT" || return 1
    is_positive_integer "$QEMU_BOOTSTRAP_TIMEOUT" || return 1
    is_positive_integer "$QEMU_SMOKE_TIMEOUT" || return 1
    is_positive_integer "$QEMU_FULL_TIMEOUT"
}

preflight_architecture() {
    host_arch="$(uname -m 2>/dev/null || true)"
    case "$host_arch" in
        x86_64|amd64) return 0 ;;
        aarch64|arm64)
            # An x86_64 guest can run on ARM only through QEMU's TCG backend.
            qemu-system-x86_64 -accel help 2>/dev/null |
                grep -Eq '^[[:space:]]*tcg([[:space:]]|$)'
            ;;
        *) return 1 ;;
    esac
}

preflight_qemu_system() {
    case "$QEMU_ARCH" in
        arm64) command -v qemu-system-aarch64 >/dev/null 2>&1 ;;
        *) command -v qemu-system-x86_64 >/dev/null 2>&1 ;;
    esac
}
preflight_qemu_img() { command -v qemu-img >/dev/null 2>&1; }
preflight_ssh() { command -v ssh >/dev/null 2>&1; }
preflight_rsync() { command -v rsync >/dev/null 2>&1; }
preflight_iso_tool() {
    command -v genisoimage >/dev/null 2>&1 ||
        command -v mkisofs >/dev/null 2>&1 ||
        command -v xorriso >/dev/null 2>&1
}
preflight_admitted_media() { sh "$MEDIA_CHECKER" --check --path "$QEMU_VM_PATH" >/dev/null; }
preflight_public_key() {
    if [ -n "${QEMU_SSH_PUBLIC_KEY:-}" ]; then
        SSH_PUB_KEY="$QEMU_SSH_PUBLIC_KEY"
    elif [ -f "$HOME/.ssh/id_ed25519.pub" ]; then
        SSH_PUB_KEY="$HOME/.ssh/id_ed25519.pub"
    elif [ -f "$HOME/.ssh/id_rsa.pub" ]; then
        SSH_PUB_KEY="$HOME/.ssh/id_rsa.pub"
    else
        return 1
    fi
    [ -r "$SSH_PUB_KEY" ]
}
preflight_private_key() {
    if [ -n "${SSH_PUB_KEY:-}" ]; then
        SSH_PRIVATE_KEY="${QEMU_SSH_PRIVATE_KEY:-${SSH_PUB_KEY%.pub}}"
    elif [ -n "${QEMU_SSH_PRIVATE_KEY:-}" ]; then
        SSH_PRIVATE_KEY="$QEMU_SSH_PRIVATE_KEY"
    else
        return 1
    fi
    [ -r "$SSH_PRIVATE_KEY" ]
}
preflight_workspace() {
    if [ -d "$VM_DIR" ]; then
        [ -w "$VM_DIR" ]
    else
        workspace_parent="$VM_DIR"
        while [ ! -d "$workspace_parent" ]; do
            next_parent="${workspace_parent%/*}"
            [ "$next_parent" = "$workspace_parent" ] && next_parent="."
            workspace_parent="$next_parent"
        done
        [ -w "$workspace_parent" ]
    fi
}

run_preflight() {
    preflight_try mode preflight_mode
    preflight_try port preflight_port
    preflight_try user preflight_user
    preflight_try memory preflight_memory
    preflight_try disk_size preflight_disk_size
    preflight_try host_free_floor preflight_host_free_floor
    preflight_try host_free_space preflight_host_free_space
    preflight_try cpus preflight_cpus
    preflight_try phase2_backend preflight_phase2_backend
    preflight_try phase2_jobs preflight_phase2_jobs
    preflight_try phase2_build_threads preflight_phase2_build_threads
    preflight_try phase2_test_workers preflight_phase2_test_workers
    preflight_try phase2_isolation preflight_phase2_isolation
    preflight_try ssh_timeout preflight_ssh_timeout
    preflight_try root_ssh_timeout preflight_root_ssh_timeout
    preflight_try timeout preflight_timeout
    preflight_try architecture preflight_architecture
    preflight_try qemu_system preflight_qemu_system
    preflight_try qemu_img preflight_qemu_img
    preflight_try ssh preflight_ssh
    preflight_try rsync preflight_rsync
    preflight_try iso_tool preflight_iso_tool
    preflight_try admitted_media preflight_admitted_media
    preflight_try ssh_public_key preflight_public_key
    preflight_try ssh_private_key preflight_private_key
    preflight_try workspace preflight_workspace

    if [ "$PREFLIGHT_REASON" = "none" ]; then
        PREFLIGHT_STATUS="pass"
    else
        PREFLIGHT_STATUS="fail"
    fi
    printf 'freebsd_qemu_preflight_status=%s\n' "$PREFLIGHT_STATUS"
    printf 'freebsd_qemu_preflight_checks=27\n'
    printf 'freebsd_qemu_preflight_order=%s\n' "$PREFLIGHT_ORDER"
    printf 'freebsd_qemu_preflight_reason=%s\n' "$PREFLIGHT_REASON"
    [ "$PREFLIGHT_STATUS" = "pass" ]
}

if [ "$PREFLIGHT" -eq 1 ]; then
    run_preflight
    exit $?
fi

if [ "$MODE_VALID" -ne 1 ] || [ "$ARG_REASON" != "none" ]; then
    printf 'Invalid command-line arguments: %s\n' "$ARG_REASON" >&2
    usage_error
fi
if ! is_valid_port "$QEMU_PORT"; then
    printf 'Invalid QEMU_PORT: %s\n' "$QEMU_PORT" >&2
    exit 1
fi
if ! is_valid_user "$QEMU_USER"; then
    printf 'Invalid QEMU_USER: %s\n' "$QEMU_USER" >&2
    exit 1
fi
if ! is_valid_memory "$QEMU_MEM"; then
    printf 'Invalid QEMU_MEM: %s\n' "$QEMU_MEM" >&2
    exit 1
fi
if ! is_valid_disk_size "$QEMU_DISK_SIZE"; then
    printf 'Invalid QEMU_DISK_SIZE: %s (expected 40G..2048G)\n' "$QEMU_DISK_SIZE" >&2
    exit 1
fi
if ! is_valid_host_free_floor "$QEMU_HOST_FREE_FLOOR_GIB"; then
    printf 'Invalid QEMU_HOST_FREE_FLOOR_GIB: %s (expected 1..1024)\n' "$QEMU_HOST_FREE_FLOOR_GIB" >&2
    exit 1
fi
if ! is_positive_integer "$QEMU_CPUS"; then
    printf 'Invalid QEMU_CPUS: %s\n' "$QEMU_CPUS" >&2
    exit 1
fi
for phase2_check in preflight_phase2_backend preflight_phase2_jobs \
    preflight_phase2_build_threads preflight_phase2_test_workers; do
    if ! "$phase2_check"; then
        printf 'Invalid FreeBSD Phase 2 resource or backend setting: %s\n' "$phase2_check" >&2
        exit 1
    fi
done
if ! preflight_phase2_isolation; then
    printf 'FreeBSD Phase 2 requires an explicit, unused QEMU_VM_DIR\n' >&2
    exit 1
fi
if ! preflight_timeout; then
    printf 'A usable timeout command and positive command timeouts are required\n' >&2
    exit 1
fi

pass()  { printf '  ✓ %s\n' "$1"; }
fail()  { printf '  ✗ %s\n' "$1"; return 1; }
info()  { printf '  → %s\n' "$1"; }

shell_quote() {
    # rsync -e receives a shell command string; quote each path before it is
    # inserted so spaces and apostrophes cannot become argument separators.
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

EXACT_COMMAND="sh $(shell_quote "$0")"
for invocation_arg in "$@"; do
    EXACT_COMMAND="$EXACT_COMMAND $(shell_quote "$invocation_arg")"
done

run_bounded() {
    duration="$1"
    shift
    "$TIMEOUT_BIN" "$duration" "$@"
}

hash_stdin() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | awk '{print $1}'
    elif command -v sha256 >/dev/null 2>&1; then
        sha256 -q
    else
        return 1
    fi
}

hash_file() {
    hash_path="$1"
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$hash_path" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$hash_path" | awk '{print $1}'
    elif command -v sha256 >/dev/null 2>&1; then
        sha256 -q "$hash_path"
    else
        return 1
    fi
}

hash_tree() {
    hash_root="$1"
    find "$hash_root" -type f -print | sort |
        while IFS= read -r hash_path; do
            printf '%s  %s\n' "$(hash_file "$hash_path")" "${hash_path#"$ROOT_DIR"/}"
        done | hash_stdin
}

ssh_user() {
    run_bounded "$QEMU_REMOTE_TIMEOUT" ssh \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o BatchMode=yes \
        -o ConnectTimeout=5 \
        -i "$SSH_PRIVATE_KEY" -p "$QEMU_PORT" \
        "${QEMU_USER}@localhost" "$@"
}

ssh_root() {
    run_bounded "$QEMU_REMOTE_TIMEOUT" ssh \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o BatchMode=yes \
        -o ConnectTimeout=5 \
        -i "$SSH_PRIVATE_KEY" -p "$QEMU_PORT" \
        root@localhost "$@"
}

ssh_user_long() {
    run_bounded "$QEMU_FULL_TIMEOUT" ssh \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o BatchMode=yes \
        -o ConnectTimeout=5 \
        -i "$SSH_PRIVATE_KEY" -p "$QEMU_PORT" \
        "${QEMU_USER}@localhost" "$@"
}

ssh_root_long() {
    run_bounded "$QEMU_FULL_TIMEOUT" ssh \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o BatchMode=yes \
        -o ConnectTimeout=5 \
        -i "$SSH_PRIVATE_KEY" -p "$QEMU_PORT" \
        root@localhost "$@"
}

pkg_user() {
    run_bounded "$QEMU_PACKAGE_TIMEOUT" ssh \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o BatchMode=yes \
        -o ConnectTimeout=5 \
        -i "$SSH_PRIVATE_KEY" -p "$QEMU_PORT" \
        "${QEMU_USER}@localhost" "${PKG_ESCALATOR:-sudo}" "$@"
}

pkg_root() {
    run_bounded "$QEMU_PACKAGE_TIMEOUT" ssh \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o BatchMode=yes \
        -o ConnectTimeout=5 \
        -i "$SSH_PRIVATE_KEY" -p "$QEMU_PORT" \
        root@localhost "$@"
}

GIT_AUTHORITY_DIR=
PHASE2_VM_LOCK=
if [ "$MODE" = phase2-only ]; then
    mkdir -p "$VM_DIR" || fail "Cannot create isolated Phase 2 VM directory"
    PHASE2_VM_LOCK="$VM_DIR/.phase2-run.lock"
    mkdir "$PHASE2_VM_LOCK" 2>/dev/null || fail "Phase 2 VM directory is already owned"
    printf '%s\n' "$$" >"$PHASE2_VM_LOCK/owner"
fi
SCRIPT_OK=0
SUCCESS_MESSAGE=
PHASE2_SUMMARY_SUCCESS_PENDING=0
PROC_ROOT=/proc
QEMU_PID=
QEMU_START_TOKEN=
QEMU_PID_FILE_ID=
QEMU_DRIVE_ARG="file=${OVERLAY_IMAGE},format=qcow2,if=virtio,werror=report,rerror=report"
DISK_MONITOR_PID=
DISK_MONITOR_STOP="${VM_DIR}/.disk-monitor-stop.$$"
DISK_FLOOR_MARKER="${VM_DIR}/disk-floor-breach.$$.env"

process_start_token() {
    _identity_pid=$1
    is_positive_integer "$_identity_pid" || return 1
    [ -r "$PROC_ROOT/$_identity_pid/stat" ] || return 1
    _identity_token=$(awk '{ sub(/^.*\) /, ""); print $20 }' "$PROC_ROOT/$_identity_pid/stat") || return 1
    is_positive_integer "$_identity_token" || return 1
    printf '%s\n' "$_identity_token"
}

qemu_owned_alive() {
    [ -n "$QEMU_PID" ] && [ -n "$QEMU_START_TOKEN" ] || return 1
    [ "$(process_start_token "$QEMU_PID" 2>/dev/null || true)" = "$QEMU_START_TOKEN" ] || return 1
    [ -r "$PROC_ROOT/$QEMU_PID/cmdline" ] || return 1
    tr '\000' '\n' <"$PROC_ROOT/$QEMU_PID/cmdline" |
        grep -Fqx -- "$QEMU_DRIVE_ARG"
}

watch_host_free_space() {
    _monitor_parent_pid=$1
    _monitor_parent_token=$2
    while [ ! -e "$DISK_MONITOR_STOP" ]; do
        sleep 5
        [ ! -e "$DISK_MONITOR_STOP" ] || break
        [ "$(process_start_token "$_monitor_parent_pid" 2>/dev/null || true)" = "$_monitor_parent_token" ] || break
        qemu_owned_alive || break
        if _monitor_receipt=$(host_free_space_receipt); then
            continue
        fi
        {
            printf 'host_disk_guard_status=fail\n'
            printf '%s\n' "$_monitor_receipt"
        } >"$DISK_FLOOR_MARKER"
        # The start token and exact overlay argument bind both signals to the
        # QEMU this invocation launched, even if a PID has been recycled.
        if qemu_owned_alive; then
            kill -TERM "$QEMU_PID" 2>/dev/null || true
            sleep 1
            qemu_owned_alive && kill -KILL "$QEMU_PID" 2>/dev/null || true
        fi
        [ "$(process_start_token "$_monitor_parent_pid" 2>/dev/null || true)" = "$_monitor_parent_token" ] &&
            kill -TERM "$_monitor_parent_pid" 2>/dev/null || true
        break
    done
}

cleanup() {
    cleanup_exit_status=${1:-0}
    trap - HUP INT TERM
    if [ -n "$GIT_AUTHORITY_DIR" ]; then
        rm -rf "$GIT_AUTHORITY_DIR"
    fi
    if [ -n "$DISK_MONITOR_PID" ]; then
        : >"$DISK_MONITOR_STOP"
        wait "$DISK_MONITOR_PID" 2>/dev/null || true
        rm -f "$DISK_MONITOR_STOP"
    fi
    if [ -f "$DISK_FLOOR_MARKER" ]; then
        SCRIPT_OK=0
        cleanup_exit_status=88
        cat "$DISK_FLOOR_MARKER" >&2
        info "Host disk floor breached; overlay and logs preserved: $DISK_FLOOR_MARKER"
    fi
    if qemu_owned_alive; then
        if [ -n "${VM_SSH:-}" ]; then
            info "Requesting guest shutdown"
            $VM_SSH "shutdown -p now" >/dev/null 2>&1 || true
            sleep 5
        fi
        if qemu_owned_alive; then
            info "Stopping QEMU (pid=$QEMU_PID)"
            kill "$QEMU_PID" 2>/dev/null || true
            sleep 1
            if qemu_owned_alive; then
                kill -9 "$QEMU_PID" 2>/dev/null || true
                sleep 1
            fi
        fi
    fi
    if [ -n "$QEMU_PID" ] && [ -n "$QEMU_START_TOKEN" ] &&
       [ "$(process_start_token "$QEMU_PID" 2>/dev/null || true)" = "$QEMU_START_TOKEN" ]; then
        # A still-live process with changed command line cannot be safely
        # signaled; keep its backing image even on an otherwise green run.
        SCRIPT_OK=0
        cleanup_exit_status=88
        info "QEMU exit could not be confirmed; overlay preserved: $OVERLAY_IMAGE"
    fi
    if [ "$SCRIPT_OK" -eq 1 ] && ! host_free_space_receipt >"$DISK_FLOOR_MARKER"; then
        SCRIPT_OK=0
        cleanup_exit_status=88
        info "Host disk floor breached during cleanup; overlay and logs preserved: $DISK_FLOOR_MARKER"
    else
        [ "$SCRIPT_OK" -ne 1 ] || rm -f "$DISK_FLOOR_MARKER"
    fi
    if [ "$PHASE2_SUMMARY_SUCCESS_PENDING" -eq 1 ]; then
        if [ "$cleanup_exit_status" -eq 0 ] && [ "$SCRIPT_OK" -eq 1 ]; then
            if ! printf 'overall=PASS\n' >>"$PHASE2_HOST_SUMMARY"; then
                SCRIPT_OK=0
                cleanup_exit_status=88
            fi
        else
            printf 'overall=FAIL\n' >>"$PHASE2_HOST_SUMMARY" || true
        fi
    fi
    if [ -n "$QEMU_PID_FILE_ID" ] && [ -f "$PID_FILE" ] &&
       [ "$(stat -c '%d:%i' "$PID_FILE" 2>/dev/null || true)" = "$QEMU_PID_FILE_ID" ] &&
       [ "$(cat "$PID_FILE" 2>/dev/null || true)" = "$QEMU_PID" ]; then
        rm -f "$PID_FILE"
    fi
    if [ "$cleanup_exit_status" -eq 0 ] && [ "$SCRIPT_OK" -eq 1 ]; then
        rm -f "$OVERLAY_IMAGE" "$SERIAL_LOG"
    else
        [ -f "$SERIAL_LOG" ] && info "Serial log preserved: $SERIAL_LOG"
    fi
    if [ -n "$PHASE2_VM_LOCK" ] &&
       [ "$(cat "$PHASE2_VM_LOCK/owner" 2>/dev/null || true)" = "$$" ]; then
        rm -f "$PHASE2_VM_LOCK/owner"
        rmdir "$PHASE2_VM_LOCK" 2>/dev/null || true
    fi
    if [ "$cleanup_exit_status" -eq 0 ] && [ "$SCRIPT_OK" -eq 1 ] && [ -n "$SUCCESS_MESSAGE" ]; then
        printf '\n%s\n' "$SUCCESS_MESSAGE"
    fi
    return "$cleanup_exit_status"
}
on_exit() {
    exit_status=$?
    trap - EXIT HUP INT TERM
    if cleanup "$exit_status"; then
        exit 0
    else
        exit $?
    fi
}
trap on_exit EXIT
trap 'exit 88' HUP INT TERM

# ── Prerequisites ──────────────────────────────────────────────────────
printf 'FreeBSD QEMU Bootstrap Check (%s mode)\n\n' "$MODE"
printf '[1/7] Prerequisites\n'

case "$QEMU_ARCH" in
    arm64) QEMU_SYSTEM="qemu-system-aarch64" ;;
    *) QEMU_SYSTEM="qemu-system-x86_64" ;;
esac
command -v "$QEMU_SYSTEM" >/dev/null 2>&1 || fail "$QEMU_SYSTEM not found"
pass "$QEMU_SYSTEM found"

# aarch64 cloud images boot via UEFI. Resolve firmware: explicit env, system
# packages, or a rootless apt download + dpkg -x into ~/.simple/qemu/firmware.
resolve_efi_fd() {
    _candidates="${QEMU_EFI_FD:-}
/usr/share/qemu-efi-aarch64/QEMU_EFI.fd
/usr/share/AAVMF/AAVMF_CODE.fd
${HOME}/.simple/qemu/firmware/QEMU_EFI.fd"
    _old_ifs=$IFS; IFS='
'
    for _c in $_candidates; do
        IFS=$_old_ifs
        [ -n "$_c" ] && [ -r "$_c" ] && { printf '%s' "$_c"; return 0; }
    done
    IFS=$_old_ifs
    _fwdir="${HOME}/.simple/qemu/firmware"
    mkdir -p "$_fwdir"
    if (cd "$_fwdir" && apt download qemu-efi-aarch64 >/dev/null 2>&1 && rm -rf extracted && dpkg -x qemu-efi-aarch64_*.deb extracted >/dev/null 2>&1); then
        _f=$(find "$_fwdir/extracted" -name 'QEMU_EFI.fd' 2>/dev/null | head -1)
        if [ -n "$_f" ]; then
            cp "$_f" "$_fwdir/QEMU_EFI.fd"
            printf '%s' "$_fwdir/QEMU_EFI.fd"
            return 0
        fi
    fi
    return 1
}
if [ "$QEMU_ARCH" = "arm64" ]; then
    if ! QEMU_EFI_FD_RESOLVED="$(resolve_efi_fd)"; then
        fail "no aarch64 EFI firmware found (install qemu-efi-aarch64, set QEMU_EFI_FD, or allow the rootless apt download into ~/.simple/qemu/firmware)"
    fi
    pass "aarch64 EFI firmware: $QEMU_EFI_FD_RESOLVED"
fi

command -v qemu-img >/dev/null 2>&1 || fail "qemu-img not found"
pass "qemu-img found"

if command -v ssh >/dev/null 2>&1; then
    pass "ssh found"
else
    fail "ssh not found"
fi

# ── SSH Key ────────────────────────────────────────────────────────────
printf '[2/7] SSH key\n'

if [ -n "${QEMU_SSH_PUBLIC_KEY:-}" ]; then
    SSH_PUB_KEY="$QEMU_SSH_PUBLIC_KEY"
elif [ -f "$HOME/.ssh/id_ed25519.pub" ]; then
    SSH_PUB_KEY="$HOME/.ssh/id_ed25519.pub"
elif [ -f "$HOME/.ssh/id_rsa.pub" ]; then
    SSH_PUB_KEY="$HOME/.ssh/id_rsa.pub"
else
    fail "No SSH public key found (set QEMU_SSH_PUBLIC_KEY)"
fi
pass "SSH public key: $SSH_PUB_KEY"

SSH_PRIVATE_KEY="${QEMU_SSH_PRIVATE_KEY:-${SSH_PUB_KEY%.pub}}"
if [ ! -f "$SSH_PRIVATE_KEY" ]; then
    fail "Matching SSH private key not found: $SSH_PRIVATE_KEY (set QEMU_SSH_PRIVATE_KEY)"
fi
pass "SSH private key: $SSH_PRIVATE_KEY"

# Keep the key path as one argument for ssh/scp.  The command strings are
# retained for the existing remote shell call sites, but every interpolated
# path is shell-quoted and every remote command has a deadline.
SSH_CMD=ssh_user
ROOT_SSH_CMD=ssh_root
USER_LONG_SSH_CMD=ssh_user_long
ROOT_LONG_SSH_CMD=ssh_root_long
USER_PKG_CMD=pkg_user
ROOT_PKG_CMD=pkg_root
RSYNC_SSH="ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o ConnectTimeout=5 -i $(shell_quote "$SSH_PRIVATE_KEY") -p $QEMU_PORT"

# ── Base Image ─────────────────────────────────────────────────────────
printf '[3/7] Base image\n'

mkdir -p "$VM_DIR"
HOST_DISK_RECEIPT=$(host_free_space_receipt) || {
    printf '%s\n' "$HOST_DISK_RECEIPT" >&2
    fail "Overlay filesystem has insufficient or unreadable physical free space: $VM_DIR"
}
printf '%s\n' "$HOST_DISK_RECEIPT"

MEDIA_RECEIPT="$(sh "$MEDIA_CHECKER" --check --path "$QEMU_VM_PATH")" || {
    printf '%s\n' "$MEDIA_RECEIPT" >&2
    fail "Admitted FreeBSD base image required; provision shared media and its trusted SHA-256 offline"
}
MEDIA_EXPECTED_SHA256=$(printf '%s\n' "$MEDIA_RECEIPT" | sed -n 's/^freebsd_media_expected_sha256=//p')
MEDIA_ACTUAL_SHA256=$(printf '%s\n' "$MEDIA_RECEIPT" | sed -n 's/^freebsd_media_actual_sha256=//p')
[ -n "$MEDIA_EXPECTED_SHA256" ] && [ "$MEDIA_EXPECTED_SHA256" = "$MEDIA_ACTUAL_SHA256" ] || fail "Admitted FreeBSD base image receipt incomplete"
pass "Admitted base image: $QEMU_VM_PATH"

# ── Cloud-Init ISO ─────────────────────────────────────────────────────
printf '[4/7] Cloud-init ISO\n'

SSH_PUB_KEY_CONTENT=$(cat "$SSH_PUB_KEY")
CLOUDINIT_DIR="${VM_DIR}/cloudinit.tmp"
rm -rf "$CLOUDINIT_DIR"
mkdir -p "$CLOUDINIT_DIR"

cat > "$CLOUDINIT_DIR/meta-data" <<EOF
instance-id: freebsd-bootstrap-$(date +%s)
local-hostname: freebsd-bootstrap
EOF

cat > "$CLOUDINIT_DIR/user-data" <<USERDATA
#cloud-config
write_files:
  - path: /etc/rc.conf.d/firstboot_freebsd_update
    permissions: "0644"
    content: |
      firstboot_freebsd_update_enable="NO"
  - path: /etc/rc.conf.d/firstboot_pkgs
    permissions: "0644"
    content: |
      firstboot_pkgs_enable="NO"
runcmd:
  - |
    pw useradd -n ${QEMU_USER} -s /bin/sh -m -G wheel 2>/dev/null || true
    mkdir -p /root/.ssh /home/${QEMU_USER}/.ssh
    echo '${SSH_PUB_KEY_CONTENT}' >> /root/.ssh/authorized_keys
    echo '${SSH_PUB_KEY_CONTENT}' >> /home/${QEMU_USER}/.ssh/authorized_keys
    chmod 700 /root/.ssh /home/${QEMU_USER}/.ssh
    chmod 600 /root/.ssh/authorized_keys /home/${QEMU_USER}/.ssh/authorized_keys
    chown -R ${QEMU_USER}:${QEMU_USER} /home/${QEMU_USER}/.ssh
    sed -i '' 's/^#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
    sed -i '' 's/^PermitRootLogin no/PermitRootLogin yes/' /etc/ssh/sshd_config
    hostname freebsd-bootstrap
USERDATA
chmod +x "$CLOUDINIT_DIR/user-data"

if command -v genisoimage >/dev/null 2>&1; then
    run_bounded "$QEMU_TRANSFER_TIMEOUT" genisoimage -output "$QEMU_CLOUDINIT_ISO" -volid cidata -joliet -rock \
        "$CLOUDINIT_DIR/meta-data" "$CLOUDINIT_DIR/user-data" 2>/dev/null
elif command -v mkisofs >/dev/null 2>&1; then
    run_bounded "$QEMU_TRANSFER_TIMEOUT" mkisofs -output "$QEMU_CLOUDINIT_ISO" -volid cidata -joliet -rock \
        "$CLOUDINIT_DIR/meta-data" "$CLOUDINIT_DIR/user-data" 2>/dev/null
elif command -v xorriso >/dev/null 2>&1; then
    run_bounded "$QEMU_TRANSFER_TIMEOUT" xorriso -as mkisofs -o "$QEMU_CLOUDINIT_ISO" -volid cidata -joliet -rock \
        "$CLOUDINIT_DIR/meta-data" "$CLOUDINIT_DIR/user-data" 2>/dev/null
else
    fail "No ISO tool found (need genisoimage, mkisofs, or xorriso)"
fi
rm -rf "$CLOUDINIT_DIR"
pass "Cloud-init ISO: $QEMU_CLOUDINIT_ISO"

# ── Create Overlay ─────────────────────────────────────────────────────
printf '[5/7] QEMU overlay + start\n'

HOST_DISK_RECEIPT=$(host_free_space_receipt) || {
    printf '%s\n' "$HOST_DISK_RECEIPT" >&2
    fail "Overlay filesystem fell below host free-space floor before overlay creation: $VM_DIR"
}
rm -f "$OVERLAY_IMAGE"
run_bounded "$QEMU_TRANSFER_TIMEOUT" qemu-img create -f qcow2 -b "$QEMU_VM_PATH" -F qcow2 "$OVERLAY_IMAGE" >/dev/null 2>&1
run_bounded "$QEMU_TRANSFER_TIMEOUT" qemu-img resize "$OVERLAY_IMAGE" "$QEMU_DISK_SIZE" >/dev/null 2>&1
pass "Overlay created (${QEMU_DISK_SIZE} virtual): $OVERLAY_IMAGE"

# Probe the selected system emulator only for a native-architecture guest.
# Arm's host CPU model is usable with KVM; TCG keeps the existing max model.
select_qemu_boot_machine_args() {
    _boot_guest_arch=$1
    _boot_host_arch=$2
    _boot_qemu_system=$3
    _boot_kvm_device=$4
    _boot_efi_fd=$5
    ACCEL="tcg"
    CPU_MODEL="qemu64"
    [ "$_boot_guest_arch" = arm64 ] && CPU_MODEL="max"

    _boot_native_arch=false
    case "$_boot_guest_arch:$_boot_host_arch" in
        arm64:aarch64|arm64:arm64|amd64:x86_64|amd64:amd64)
            _boot_native_arch=true ;;
    esac
    if [ "$_boot_native_arch" = true ] && [ -w "$_boot_kvm_device" ] &&
        "$_boot_qemu_system" -accel help 2>/dev/null |
            grep -Eq '^[[:space:]]*kvm([[:space:]]|$)'; then
        if [ "$_boot_guest_arch" != arm64 ] ||
            "$_boot_qemu_system" -cpu help 2>/dev/null |
                grep -Eq '^[[:space:]]*host([[:space:]]|$)'; then
            ACCEL="kvm"
            CPU_MODEL="host"
        fi
    fi

    case "$_boot_guest_arch" in
        arm64) MACHINE_ARGS="-machine virt,accel=${ACCEL} -cpu ${CPU_MODEL} -bios ${_boot_efi_fd}" ;;
        *) MACHINE_ARGS="-machine accel=${ACCEL} -cpu ${CPU_MODEL}" ;;
    esac
}

HOST_ARCH="$(uname -m 2>/dev/null || true)"
select_qemu_boot_machine_args "$QEMU_ARCH" "$HOST_ARCH" "$QEMU_SYSTEM" /dev/kvm "${QEMU_EFI_FD_RESOLVED:-}"

rm -f "$PID_FILE" "$QEMU_START_LOG"
if ! run_bounded "$QEMU_BOOTSTRAP_TIMEOUT" "$QEMU_SYSTEM" \
    $MACHINE_ARGS \
    -m "$QEMU_MEM" \
    -smp "$QEMU_CPUS" \
    -drive "$QEMU_DRIVE_ARG" \
    -drive "file=${QEMU_CLOUDINIT_ISO},format=raw,if=virtio,media=cdrom" \
    -net nic,model=virtio \
    -net "user,hostfwd=tcp::${QEMU_PORT}-:22" \
    -display none \
    -serial "file:${SERIAL_LOG}" \
    -daemonize \
    -pidfile "$PID_FILE" 2>"$QEMU_START_LOG"; then
    [ -s "$QEMU_START_LOG" ] && tail -10 "$QEMU_START_LOG" >&2
    fail "QEMU failed to start"
fi

QEMU_PID="$(cat "$PID_FILE" 2>/dev/null || true)"
QEMU_START_TOKEN=$(process_start_token "$QEMU_PID" 2>/dev/null || true)
if qemu_owned_alive; then
    QEMU_PID_FILE_ID=$(stat -c '%d:%i' "$PID_FILE" 2>/dev/null || true)
    [ -n "$QEMU_PID_FILE_ID" ] || fail "Cannot establish QEMU pidfile ownership"
    pass "QEMU started (pid=${QEMU_PID}, accel=${ACCEL})"
else
    [ -s "$QEMU_START_LOG" ] && tail -10 "$QEMU_START_LOG" >&2
    fail "QEMU failed to start"
fi
MONITOR_PARENT_TOKEN=$(process_start_token "$$" 2>/dev/null || true)
[ -n "$MONITOR_PARENT_TOKEN" ] || fail "Cannot establish host disk monitor process ownership"
watch_host_free_space "$$" "$MONITOR_PARENT_TOKEN" &
DISK_MONITOR_PID=$!

require_qemu_alive() {
    if ! qemu_owned_alive; then
        [ -s "$QEMU_START_LOG" ] && tail -10 "$QEMU_START_LOG" >&2
        [ -s "$SERIAL_LOG" ] && tail -20 "$SERIAL_LOG" >&2
        fail "QEMU exited while waiting for SSH"
    fi
}

# ── SSH Connectivity ───────────────────────────────────────────────────
printf '[6/7] SSH connectivity\n'

SSH_TIMEOUT="$QEMU_SSH_TIMEOUT"
ELAPSED=0
CONNECTED=0

info "Waiting for SSH (up to ${SSH_TIMEOUT}s)..."
while [ "$ELAPSED" -lt "$SSH_TIMEOUT" ]; do
    require_qemu_alive
    if $SSH_CMD true 2>/dev/null; then
        CONNECTED=1
        break
    fi
    sleep 5
    ELAPSED=$((ELAPSED + 5))
done

if [ "$CONNECTED" -eq 0 ]; then
    if [ -f "$SERIAL_LOG" ]; then
        info "Last 20 lines of serial log:"
        tail -20 "$SERIAL_LOG" | while IFS= read -r line; do printf '    %s\n' "$line"; done
    fi
    fail "SSH connection timed out after ${SSH_TIMEOUT}s"
fi
pass "SSH connected as ${QEMU_USER} in ${ELAPSED}s"

UNAME=$($SSH_CMD "uname -sr" 2>/dev/null) || UNAME="(unknown)"
[ "${UNAME%% *}" = "FreeBSD" ] || fail "Expected FreeBSD guest, got: $UNAME"
pass "Remote: $UNAME"

# Poll for root SSH (bootcmd enables PermitRootLogin before cloud-init finishes)
info "Waiting for root SSH (up to ${QEMU_ROOT_SSH_TIMEOUT}s after initial connect)..."
ROOT_ELAPSED=0
ROOT_OK=0
while [ "$ROOT_ELAPSED" -lt "$QEMU_ROOT_SSH_TIMEOUT" ]; do
    require_qemu_alive
    if $ROOT_SSH_CMD true 2>/dev/null; then
        ROOT_OK=1
        break
    fi
    sleep 5
    ROOT_ELAPSED=$((ROOT_ELAPSED + 5))
done

if [ "$ROOT_OK" -eq 1 ]; then
    VM_USER="root"
    VM_SSH="$ROOT_LONG_SSH_CMD"
    PKG_CMD="$ROOT_PKG_CMD"
    pass "Root SSH available (after ${ROOT_ELAPSED}s)"
elif $SSH_CMD "command -v sudo" >/dev/null 2>&1; then
    VM_USER="$QEMU_USER"
    PKG_ESCALATOR=sudo
    VM_SSH="$USER_LONG_SSH_CMD"
    PKG_CMD="$USER_PKG_CMD"
    pass "sudo available"
elif $SSH_CMD "command -v doas" >/dev/null 2>&1; then
    VM_USER="$QEMU_USER"
    PKG_ESCALATOR=doas
    VM_SSH="$USER_LONG_SSH_CMD"
    PKG_CMD="$USER_PKG_CMD"
    pass "doas available"
else
    fail "No root/sudo/doas available (root SSH timed out, no sudo/doas)"
fi

copy_guest_bootstrap_logs() {
    host_log_dir="$PROVENANCE_DIR"
    rm -rf "$host_log_dir"
    mkdir -p "$host_log_dir"
    if run_bounded "$QEMU_TRANSFER_TIMEOUT" rsync -az -e "$RSYNC_SSH" \
        "${VM_USER}@localhost:${VM_HOME}/simple/build/bootstrap/logs/" \
        "${host_log_dir}/"; then
        guest_log_count=$(find "$host_log_dir" -type f -name '*.log' -size +0c | wc -l | tr -d ' ')
        [ "$guest_log_count" -gt 0 ] ||
            fail "FreeBSD x86_64 QEMU full bootstrap guest logs missing or empty"
        info "Bootstrap logs preserved: ${host_log_dir}"
        find "$host_log_dir" -type f -name '*.log' | sort | tail -4 |
            while IFS= read -r log; do
                info "Last 40 lines of ${log}:"
                tail -40 "$log" >&2
            done
    else
        fail "FreeBSD x86_64 QEMU full bootstrap guest log retrieval failed"
    fi
}

# ── Smoke / Full ───────────────────────────────────────────────────────
printf '[7/7] Bootstrap (%s)\n' "$MODE"

initialize_guest_host_config() {
    # VM_SSH is the same selected user used for source sync and bootstrap.
    # Resolve HOME in the guest; never initialize root's config on behalf of
    # a non-root build user. Smoke guests need not have a checkout yet.
    $VM_SSH "if test -f \"\$HOME/simple/scripts/setup/setup-freebsd-host.shs\"; then sh \"\$HOME/simple/scripts/setup/setup-freebsd-host.shs\"; else test '$1' = optional; fi" ||
        fail "FreeBSD build-user host configuration initialization failed"
}

if [ "$MODE" = "smoke" ]; then
    # Smoke: verify clang exists and can compile a trivial C program
    CLANG_CHECK=$($VM_SSH "command -v clang >/dev/null 2>&1 && echo ok || echo missing" 2>/dev/null)
    if [ "$CLANG_CHECK" = "ok" ]; then
        pass "clang available in VM"
    else
        info "Installing clang..."
        $PKG_CMD "env ASSUME_ALWAYS_YES=yes pkg bootstrap" 2>/dev/null || true
        $PKG_CMD "env ASSUME_ALWAYS_YES=yes pkg install -y llvm23" 2>&1 | tail -3
        CLANG_CHECK=$($VM_SSH "command -v clang >/dev/null 2>&1 && echo ok || echo missing" 2>/dev/null)
        if [ "$CLANG_CHECK" = "ok" ]; then
            pass "clang installed"
        else
            fail "clang not available"
        fi
    fi

    # Test trivial C compilation
    $VM_SSH "echo 'int main(){return 0;}' > /tmp/test.c && clang -o /tmp/test /tmp/test.c && /tmp/test && echo ok" 2>/dev/null | grep -q ok
    pass "Trivial C compilation works"
    initialize_guest_host_config optional

    SCRIPT_OK=1
    SUCCESS_MESSAGE="FreeBSD $QEMU_ARCH QEMU smoke PASS"
else
    # Full: install deps, rsync project, build seed, run bootstrap
    rm -f "$PROVENANCE_RECEIPT"
    VM_HOME=$($VM_SSH "echo \$HOME" 2>/dev/null)
    VM_HOME="${VM_HOME:-/root}"

    info "Growing and checking the guest root filesystem..."
    $PKG_CMD "service growfs onestart >/tmp/simple-growfs.log 2>&1 || true"
    ROOT_AVAILABLE_KB=$($VM_SSH "df -k / | awk 'NR == 2 { print \$4 }'" 2>/dev/null)
    case "$ROOT_AVAILABLE_KB" in
        ''|*[!0-9]*) fail "Could not determine guest root free space" ;;
    esac
    [ "$ROOT_AVAILABLE_KB" -ge 10485760 ] || fail "Guest root has less than 10 GiB free after growfs"
    pass "Guest root has at least 10 GiB free"

    info "Installing build dependencies in VM (this may take a few minutes)..."
    if ! $PKG_CMD "env ASSUME_ALWAYS_YES=yes pkg bootstrap > /tmp/simple-pkg-bootstrap.log 2>&1"; then
        $VM_SSH "tail -20 /tmp/simple-pkg-bootstrap.log" >&2 || true
        fail "pkg bootstrap failed"
    fi
    if ! $PKG_CMD "env ASSUME_ALWAYS_YES=yes pkg update -f > /tmp/simple-pkg-update.log 2>&1"; then
        $VM_SSH "tail -20 /tmp/simple-pkg-update.log" >&2 || true
        fail "pkg update failed"
    fi
    # llvm23 is in FreeBSD's latest package repository; its tools live in a
    # versioned bin directory rather than the default PATH.
    if ! $PKG_CMD "mkdir -p /usr/local/etc/pkg/repos && sed 's|/quarterly|/latest|' /etc/pkg/FreeBSD.conf > /usr/local/etc/pkg/repos/FreeBSD.conf && grep -q '/latest' /usr/local/etc/pkg/repos/FreeBSD.conf && env ASSUME_ALWAYS_YES=yes pkg update -f > /tmp/simple-pkg-latest.log 2>&1"; then
        $VM_SSH "tail -20 /tmp/simple-pkg-latest.log" >&2 || true
        fail "pkg latest repository setup failed"
    fi
    if ! $PKG_CMD "env ASSUME_ALWAYS_YES=yes pkg install -y rsync curl rust llvm23 git gmake pkgconf libffi zstd perl5 coreutils python3 > /tmp/simple-pkg-install.log 2>&1"; then
        $VM_SSH "tail -20 /tmp/simple-pkg-install.log" >&2 || true
        fail "dependency installation failed"
    fi
    $VM_SSH "command -v rsync" 2>/dev/null || fail "rsync install failed"
    $VM_SSH "command -v perl" 2>/dev/null || fail "perl install failed"
    LLVM23_VERSION=$($VM_SSH "/usr/local/llvm23/bin/llvm-config --version" 2>/dev/null) ||
        fail "FreeBSD llvm23 package has no llvm-config"
    case "$LLVM23_VERSION" in
        23.1.1|23.1.2) ;;
        *) fail "FreeBSD LLVM version is not admitted: $LLVM23_VERSION" ;;
    esac
    $VM_SSH "test -x /usr/local/llvm23/bin/clang && test -x /usr/local/llvm23/bin/llvm-ar" 2>/dev/null ||
        fail "FreeBSD llvm23 package lacks clang or llvm-ar"
    pass "Dependencies installed"

    # Bind the original host authority before projecting files into the VM.
    SOURCE_AUTHORITY_HELPER="$ROOT_DIR/scripts/bootstrap/lib/freebsd-source-authority.shs"
    SOURCE_AUTHORITY_HEAD=$(git -C "$ROOT_DIR" rev-parse --verify HEAD) || fail "Cannot bind source HEAD"
    mkdir -p "$PROVENANCE_DIR"
    GIT_AUTHORITY_DIR=$(mktemp -d "$VM_DIR/git-authority.XXXXXX") || fail "Cannot isolate Git authority"
    run_bounded "$QEMU_TRANSFER_TIMEOUT" sh "$SOURCE_AUTHORITY_HELPER" prepare \
        "$ROOT_DIR" "$GIT_AUTHORITY_DIR" "$SOURCE_AUTHORITY_HEAD" \
        >"$PROVENANCE_DIR/source-git-authority.env" || fail "Cannot prepare bounded Git authority"
    SOURCE_AUTHORITY_SHA=$(run_bounded "$QEMU_TRANSFER_TIMEOUT" sh "$SOURCE_AUTHORITY_HELPER" snapshot \
        "$ROOT_DIR" "$PROVENANCE_DIR/source-inputs-host.txt") || fail "Cannot bind host source content"
    cp "$PROVENANCE_DIR/source-inputs-host.txt" "$GIT_AUTHORITY_DIR/repo/.git/simple-source-host.snapshot"
    info "Syncing project to VM..."
    run_bounded "$QEMU_TRANSFER_TIMEOUT" rsync -az --delete --no-owner --no-group \
        --exclude='.git' \
        --exclude='.jj/' \
        --exclude='/.claude/worktrees/' \
        --exclude='/.codex/worktrees/' \
        --exclude='/.agents/worktrees/' \
        --exclude='/build/' \
        --exclude='.simple/' \
        --exclude='/bootstrap/' \
        --exclude='node_modules/' \
        --exclude='/src/runtime/*.o' \
        --exclude='/src/runtime/*.a' \
        --include='/examples/' \
        --include='/examples/10_tooling/***' \
        --exclude='/examples/***' \
        --include='/doc/' \
        --include='/doc/04_architecture/' \
        --include='/doc/04_architecture/compiler/' \
        --include='/doc/04_architecture/compiler/plugin_arch/' \
        --include='/doc/04_architecture/compiler/plugin_arch/kernel_closure.sdn' \
        --exclude='/doc/**' \
        --exclude='*.qcow2' \
        --exclude='/src/compiler_rust/target/' \
        --include='/src/compiler_rust/target_wt/' \
        --include='/src/compiler_rust/target_wt/release/' \
        --include='/src/compiler_rust/target_wt/CACHEDIR.TAG' \
        --include='/src/compiler_rust/target_wt/.rustc_info.json' \
        --include='/src/compiler_rust/target_wt/release/.cargo-lock' \
        --exclude='/src/compiler_rust/target_wt/***' \
        --exclude='/src/compiler_rust/target_*/' \
        --include='/tools/' \
        --include='/tools/counterpart/' \
        --include='/tools/counterpart/sdk/' \
        --include='/tools/counterpart/sdk/c/' \
        --include='/tools/counterpart/sdk/c/simple_counterpart_abi.h' \
        --exclude='/tools/**' \
        --exclude='/bin/' \
        --exclude='**/target/debug/' \
        --exclude='**/target/release/' \
        --exclude='**/target/bootstrap/' \
        -e "$RSYNC_SSH" \
        "${ROOT_DIR}/" "${VM_USER}@localhost:${VM_HOME}/simple/"
    pass "Project synced"

    # Transfer a real depth-one object store, never a worktree .git pointer.
    run_bounded "$QEMU_TRANSFER_TIMEOUT" rsync -az --delete --no-owner --no-group \
        -e "$RSYNC_SSH" "$GIT_AUTHORITY_DIR/repo/.git/" \
        "${VM_USER}@localhost:${VM_HOME}/simple/.git/" || fail "Cannot transfer bounded Git authority"
    $VM_SSH "cd '${VM_HOME}/simple' && sh scripts/bootstrap/lib/freebsd-source-authority.shs activate '${VM_HOME}/simple' '$SOURCE_AUTHORITY_HEAD' && sh scripts/bootstrap/lib/freebsd-source-authority.shs compare '${VM_HOME}/simple' '${VM_HOME}/simple/.git/simple-source-host.snapshot' '${VM_HOME}/simple/.git/simple-source-guest.snapshot'" \
        >"$PROVENANCE_DIR/source-guest-snapshot.sha256" || fail "Guest source authority differs from original host source"
    run_bounded "$QEMU_TRANSFER_TIMEOUT" sh "$SOURCE_AUTHORITY_HELPER" compare \
        "$ROOT_DIR" "$PROVENANCE_DIR/source-inputs-host.txt" "$PROVENANCE_DIR/source-inputs-host-after.txt" \
        >/dev/null || fail "Host source changed during transfer"
    [ "$(git -C "$ROOT_DIR" rev-parse --verify HEAD)" = "$SOURCE_AUTHORITY_HEAD" ] || fail "Host HEAD changed during transfer"
    run_bounded "$QEMU_TRANSFER_TIMEOUT" rsync -az -e "$RSYNC_SSH" \
        "${VM_USER}@localhost:${VM_HOME}/simple/.git/simple-source-guest.snapshot" \
        "$PROVENANCE_DIR/source-inputs-guest.txt" || fail "Cannot retain guest source authority"
    cmp -s "$PROVENANCE_DIR/source-inputs-host.txt" "$PROVENANCE_DIR/source-inputs-guest.txt" || fail "Copied source authority mismatch"
    printf 'source_commit=%s\nsource_snapshot_sha256=%s\nsource_transfer_status=verified\n' \
        "$SOURCE_AUTHORITY_HEAD" "$SOURCE_AUTHORITY_SHA" >>"$PROVENANCE_DIR/source-git-authority.env"
    rm -rf "$GIT_AUTHORITY_DIR"
    GIT_AUTHORITY_DIR=
    pass "Original source and bounded Git authority verified in guest"

    # The bootstrap policy (bootstrap-from-scratch.sh) rejects a full
    # bootstrap without a planner receipt: reason-receipt-required, exit 64
    # (observed on this check's --full lane, 2026-09-28). Mirror the admitted
    # candidate.yml lane: receipt-free Stage 2 trust root, then a typed Stage 3
    # receipt + Stage 3 resume (Stage 4 resume requires admitted Stage 3
    # provenance), then a typed Stage 4 receipt + Stage 4 resume. Reasons must
    # be in bootstrap_planner_v2_reason_allowed
    # (scripts/check/lib/bootstrap-planner-admission-bound.shs).
    GUEST_ENV="env PATH=/usr/local/llvm23/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin LLVM_SYS_231_PREFIX=/usr/local/llvm23 LIBRARY_PATH=/usr/local/lib PKG_CONFIG_PATH=/usr/local/libdata/pkgconfig"
    initialize_guest_host_config required
    if [ "$MODE" = phase2-only ]; then
        PHASE2_GUEST_CPUS=$($VM_SSH "sysctl -n hw.ncpu" 2>/dev/null) ||
            fail "Cannot read FreeBSD guest CPU count"
        PHASE2_GUEST_MEMORY=$($VM_SSH "sysctl -n hw.physmem" 2>/dev/null) ||
            fail "Cannot read FreeBSD guest memory"
        is_positive_integer "$PHASE2_GUEST_CPUS" &&
            is_positive_integer "$PHASE2_GUEST_MEMORY" ||
            fail "FreeBSD guest resource probe is invalid"
        [ "$PHASE2_GUEST_CPUS" -ge "$QEMU_PHASE2_JOBS" ] ||
            fail "FreeBSD guest exposes fewer CPUs than requested Stage 2 jobs"
        if [ -n "$QEMU_PHASE2_BUILD_THREADS" ]; then
            phase2_required_memory=$((QEMU_PHASE2_BUILD_THREADS * 3221225472 + 4294967296))
            [ "$PHASE2_GUEST_MEMORY" -ge "$phase2_required_memory" ] ||
                fail "FreeBSD guest memory cannot support requested verifier build threads plus 4 GiB reserve"
        fi
        case "$QEMU_ARCH" in
            arm64) PHASE2_TRIPLE=aarch64-unknown-freebsd-elf ;;
            amd64) PHASE2_TRIPLE=x86_64-unknown-freebsd-elf ;;
        esac
        PHASE2_HOST_SUMMARY="${PROVENANCE_DIR}/phase2-summary.env"
        mkdir -p "$PROVENANCE_DIR"
        {
            printf 'schema=freebsd-qemu-phase2-v1\n'
            printf 'guest_arch=%s\n' "$QEMU_ARCH"
            printf 'guest_triple=%s\n' "$PHASE2_TRIPLE"
            printf 'guest_cpus=%s\n' "$PHASE2_GUEST_CPUS"
            printf 'guest_memory_bytes=%s\n' "$PHASE2_GUEST_MEMORY"
            printf 'source_commit=%s\n' "$(git -C "$ROOT_DIR" rev-parse HEAD)"
            printf 'llvm_version=%s\n' "$LLVM23_VERSION"
            printf 'requested_jobs=%s\n' "$QEMU_PHASE2_JOBS"
            printf 'requested_build_threads=%s\n' "${QEMU_PHASE2_BUILD_THREADS:-auto}"
        } >"$PHASE2_HOST_SUMMARY"
        phase2_backends=$QEMU_PHASE2_BACKEND
        [ "$phase2_backends" != both ] || phase2_backends='llvm cranelift'
        phase2_failed=0
        for phase2_backend in $phase2_backends; do
            phase2_output="${VM_HOME}/simple/build/bootstrap-freebsd-phase2-${phase2_backend}"
            phase2_work="${phase2_output}/stage2-compiler-tests/${PHASE2_TRIPLE}/verification"
            phase2_compiler="${phase2_output}/stage3/${PHASE2_TRIPLE}/stage2-admitted/simple"
            phase2_sha=
            phase2_host_dir="${PROVENANCE_DIR}/${phase2_backend}"
            mkdir -p "$phase2_host_dir"
            phase2_started=$(date +%s)
            phase2_env=$GUEST_ENV
            [ -z "$QEMU_PHASE2_BUILD_THREADS" ] ||
                phase2_env="$phase2_env BOOTSTRAP_VERIFY_BUILD_THREADS=$QEMU_PHASE2_BUILD_THREADS"
            [ -z "$QEMU_PHASE2_TEST_WORKERS" ] ||
                phase2_env="$phase2_env BOOTSTRAP_VERIFY_TEST_WORKERS=$QEMU_PHASE2_TEST_WORKERS"
            info "Building and verifying FreeBSD ${PHASE2_TRIPLE} Stage 2 with ${phase2_backend} (jobs=${QEMU_PHASE2_JOBS})..."
            phase2_build_status=0
            if ! $VM_SSH "cd ${VM_HOME}/simple && ${phase2_env} sh scripts/bootstrap/bootstrap-from-scratch.sh --output=${phase2_output} --backend=${phase2_backend} --mode=dynload --full-bootstrap --stop-after-stage2 --no-mcp --strategy=normal --keep-going --jobs=${QEMU_PHASE2_JOBS}" \
                >"$phase2_host_dir/manager-run.log" 2>&1; then
                phase2_build_status=1
            fi
            tail -n 12 "$phase2_host_dir/manager-run.log"
            phase2_supplement_status=95
            if [ "$phase2_build_status" -eq 0 ]; then
                phase2_sha=$($VM_SSH "test -x ${phase2_compiler} && sha256 -q ${phase2_compiler}" 2>/dev/null) || phase2_sha=
                if [ -n "$phase2_sha" ]; then
                    info "Running FreeBSD ${phase2_backend} linked-module and interpreter/loader supplement..."
                    phase2_supplement_status=0
                    if ! $VM_SSH "cd ${VM_HOME}/simple && ${phase2_env} sh scripts/bootstrap/run-freebsd-phase2-tests.shs --reuse-base --phase=stage2 --backend=${phase2_backend} --compiler=${phase2_compiler} --compiler-sha256=${phase2_sha} --hash-policy=canonical --work-root=${phase2_work} --source-root=${VM_HOME}/simple"; then
                        phase2_supplement_status=1
                    fi
                else
                    phase2_build_status=1
                fi
            fi
            phase2_copy_status=0
            if ! run_bounded "$QEMU_TRANSFER_TIMEOUT" rsync -az -e "$RSYNC_SSH" \
                "${VM_USER}@localhost:${phase2_output}/logs/" "$phase2_host_dir/bootstrap-logs/"; then
                phase2_copy_status=1
            fi
            for phase2_receipt in \
                "${phase2_output}/selected-build-jobs.env" \
                "${phase2_output}/stage3/${PHASE2_TRIPLE}/stage2-admitted/admission.env" \
                "${phase2_output}/stage2-compiler-tests/${PHASE2_TRIPLE}/stage2-compiler-tests.env"; do
                if $VM_SSH "test -f ${phase2_receipt}" 2>/dev/null; then
                    if ! run_bounded "$QEMU_TRANSFER_TIMEOUT" rsync -az -e "$RSYNC_SSH" \
                        "${VM_USER}@localhost:${phase2_receipt}" "$phase2_host_dir/"; then
                        phase2_copy_status=1
                    fi
                elif [ "$phase2_build_status" -eq 0 ]; then
                    phase2_copy_status=1
                fi
            done
            if $VM_SSH "test -f ${phase2_work}/summary.env" 2>/dev/null; then
                if ! run_bounded "$QEMU_TRANSFER_TIMEOUT" rsync -az -e "$RSYNC_SSH" \
                    "${VM_USER}@localhost:${phase2_work}/summary.env" "$phase2_host_dir/summary.env"; then
                    phase2_copy_status=1
                fi
                if ! run_bounded "$QEMU_TRANSFER_TIMEOUT" rsync -az -e "$RSYNC_SSH" \
                    "${VM_USER}@localhost:${phase2_work}/logs/" "$phase2_host_dir/verification-logs/"; then
                    phase2_copy_status=1
                fi
            elif [ "$phase2_build_status" -eq 0 ]; then
                phase2_copy_status=1
            fi
            if $VM_SSH "test -f ${phase2_work}/post-phase2-summary.env" 2>/dev/null; then
                if ! run_bounded "$QEMU_TRANSFER_TIMEOUT" rsync -az -e "$RSYNC_SSH" \
                    "${VM_USER}@localhost:${phase2_work}/post-phase2-summary.env" \
                    "$phase2_host_dir/post-phase2-summary.env"; then
                    phase2_copy_status=1
                fi
                if ! run_bounded "$QEMU_TRANSFER_TIMEOUT" rsync -az -e "$RSYNC_SSH" \
                    "${VM_USER}@localhost:${phase2_work}/post-phase2-logs/" \
                    "$phase2_host_dir/post-phase2-logs/"; then
                    phase2_copy_status=1
                fi
            elif [ "$phase2_supplement_status" -eq 0 ]; then
                phase2_copy_status=1
            fi
            phase2_elapsed=$(($(date +%s) - phase2_started))
            printf 'backend=%s|stage2_status=%s|supplement_status=%s|evidence_status=%s|elapsed_seconds=%s|compiler_path=%s|compiler_sha256=%s|output=%s\n' \
                "$phase2_backend" "$phase2_build_status" "$phase2_supplement_status" \
                "$phase2_copy_status" "$phase2_elapsed" "$phase2_compiler" "$phase2_sha" \
                "$phase2_host_dir" >>"$PHASE2_HOST_SUMMARY"
            if [ "$phase2_build_status" -ne 0 ] || [ "$phase2_supplement_status" -ne 0 ] ||
               [ "$phase2_copy_status" -ne 0 ]; then
                phase2_failed=1
            fi
        done
        if [ "$phase2_failed" -ne 0 ]; then
            printf 'overall=FAIL\n' >>"$PHASE2_HOST_SUMMARY"
            fail "FreeBSD Phase 2 failed; terminal rows: $PHASE2_HOST_SUMMARY"
        fi
        PHASE2_SUMMARY_SUCCESS_PENDING=1
        SCRIPT_OK=1
        SUCCESS_MESSAGE="FreeBSD $QEMU_ARCH QEMU Phase 2 PASS"
        exit 0
    fi
    GUEST_STAGE2='stage2=$(find build/bootstrap/stage2 -type f -name simple -print -quit) && test -n "$stage2"'
    info "Building receipt-free admitted Stage 2 trust root in VM..."
    if ! $VM_SSH "cd ${VM_HOME}/simple && ${GUEST_ENV} sh scripts/bootstrap/bootstrap-from-scratch.sh --backend=llvm --mode=dynload --full-bootstrap --stop-after-stage2 --no-mcp --jobs=2"; then
        copy_guest_bootstrap_logs
        fail "Canonical FreeBSD stage2 trust-root bootstrap failed"
    fi
    info "Producing Stage 3 planner admission receipt in VM..."
    if ! $VM_SSH "cd ${VM_HOME}/simple && ${GUEST_STAGE2} && sh scripts/bootstrap/produce-bootstrap-planner-admission-v2.shs --target=//bootstrap:stage3 --reason=verify-landed-compiler-fix --parent-compiler=\"\$stage2\" --out=\"\$PWD/build/bootstrap/freebsd-stage3-planner-admission-v2.env\""; then
        copy_guest_bootstrap_logs
        fail "Canonical FreeBSD Stage 3 planner receipt production failed"
    fi
    info "Resuming admitted Stage 3 in VM..."
    if ! $VM_SSH "cd ${VM_HOME}/simple && ${GUEST_ENV} sh scripts/bootstrap/bootstrap-from-scratch.sh --bootstrap-receipt=\"\$PWD/build/bootstrap/freebsd-stage3-planner-admission-v2.env\" --resume-stage3-from-admitted=build/bootstrap --mode=dynload --no-mcp --jobs=1"; then
        copy_guest_bootstrap_logs
        fail "Canonical FreeBSD Stage 3 resume failed"
    fi
    info "Producing Stage 4 planner admission receipt in VM..."
    if ! $VM_SSH "cd ${VM_HOME}/simple && ${GUEST_STAGE2} && sh scripts/bootstrap/produce-bootstrap-planner-admission-v2.shs --target=//bootstrap:stage4 --reason=self-host-convergence-check --parent-compiler=\"\$stage2\" --out=\"\$PWD/build/bootstrap/freebsd-stage4-planner-admission-v2.env\""; then
        copy_guest_bootstrap_logs
        fail "Canonical FreeBSD Stage 4 planner receipt production failed"
    fi
    info "Running canonical full bootstrap (Stage 4 resume) in VM..."
    if ! $VM_SSH "cd ${VM_HOME}/simple && ${GUEST_ENV} sh scripts/bootstrap/bootstrap-from-scratch.sh --bootstrap-receipt=\"\$PWD/build/bootstrap/freebsd-stage4-planner-admission-v2.env\" --resume-stage4-from-admitted=build/bootstrap --release --strategy=full --mode=dynload --no-mcp --jobs=1"; then
        copy_guest_bootstrap_logs
        fail "Canonical FreeBSD bootstrap failed"
    fi
    STAGE_BIN="${VM_HOME}/simple/build/bootstrap/stage3/x86_64-unknown-freebsd/simple"
    STAGE_EXISTS=$($VM_SSH "test -x ${STAGE_BIN} && echo yes || echo no" 2>/dev/null)
    if [ "$STAGE_EXISTS" != "yes" ]; then
        fail "Canonical bootstrap produced no stage3 dynload binary"
    fi
    GUEST_STAGE_SHA256=$($VM_SSH "sha256 -q '$STAGE_BIN'" 2>/dev/null) ||
        fail "Could not hash guest stage3 binary"
    [ -n "$GUEST_STAGE_SHA256" ] || fail "Guest stage3 binary hash was empty"

    info "Running FreeBSD typed-enum bytecode execution..."
    BYTECODE_ENUM_OUT=$($VM_SSH "cd ${VM_HOME}/simple/src/compiler_rust && cargo test -p simple-compiler --lib test_compile_enum_ -- --nocapture 2>&1; echo EXIT:\$?" 2>/dev/null)
    BYTECODE_ENUM_EXIT=$(printf '%s' "$BYTECODE_ENUM_OUT" | grep '^EXIT:' | tail -1 | cut -d: -f2)
    printf '%s\n' "$BYTECODE_ENUM_OUT" | grep -v '^EXIT:' | tail -10
    [ "$BYTECODE_ENUM_EXIT" = "0" ] || fail "FreeBSD typed-enum bytecode execution failed (exit $BYTECODE_ENUM_EXIT)"
    printf '%s\n' "$BYTECODE_ENUM_OUT" | grep -Fq 'test result: ok. 2 passed; 0 failed;' || fail "FreeBSD typed-enum bytecode execution did not run both regressions"
    pass "FreeBSD typed-enum bytecode execution completed"

    RUST_SEED_BIN="${VM_HOME}/simple/src/compiler_rust/target/bootstrap/simple"
    $VM_SSH "test -x ${RUST_SEED_BIN}" 2>/dev/null || fail "FreeBSD Rust seed binary missing"
    info "Running FreeBSD Rust-seed custom enum identity self-consistency..."
    SEED_ENUM_OUT=$($VM_SSH "cd ${VM_HOME}/simple && SIMPLE_BINARY=${RUST_SEED_BIN} NATIVE_PARITY_CASES=crossmodule_result_u8 NATIVE_PARITY_FAIL_ON_XFAIL=1 PARITY_WORK_DIR=/tmp/simple-freebsd-rust-seed-enum sh scripts/check/check-native-seed-parity.shs 2>&1; echo EXIT:\$?" 2>/dev/null)
    SEED_ENUM_EXIT=$(printf '%s' "$SEED_ENUM_OUT" | grep '^EXIT:' | tail -1 | cut -d: -f2)
    printf '%s\n' "$SEED_ENUM_OUT" | grep -v '^EXIT:' | tail -10
    [ "$SEED_ENUM_EXIT" = "0" ] || fail "FreeBSD Rust-seed enum identity failed (exit $SEED_ENUM_EXIT)"
    printf '%s\n' "$SEED_ENUM_OUT" | grep -qx 'total=2 pass=2 fail=0 xfail=0' || fail "FreeBSD Rust-seed enum identity summary was not strict 2/2"
    pass "FreeBSD Rust-seed custom enum identity self-consistency completed"

    info "Running FreeBSD stage3 bootstrap compiler smoke..."
    STAGE_VERSION=$($VM_SSH "${STAGE_BIN} --version" 2>/dev/null) || fail "FreeBSD stage3 --version failed"
    [ "$STAGE_VERSION" = "simple-bootstrap $EXPECTED_BOOTSTRAP_VERSION" ] || fail "Unexpected FreeBSD stage3 version: $STAGE_VERSION"

    SMOKE_DIR="/tmp/simple-freebsd-stage3-smoke"
    $VM_SSH "rm -rf ${SMOKE_DIR} && mkdir -p ${SMOKE_DIR} && printf 'fn main():\n    print 6 * 7\n' > ${SMOKE_DIR}/main.spl" \
        2>/dev/null || fail "Failed to create FreeBSD stage3 smoke source"
    SMOKE_OUT=$($VM_SSH "cd ${VM_HOME}/simple && ${STAGE_BIN} native-build ${SMOKE_DIR}/main.spl --backend cranelift --output ${SMOKE_DIR}/probe 2>&1; echo EXIT:\$?" 2>/dev/null)
    SMOKE_EXIT=$(printf '%s' "$SMOKE_OUT" | grep '^EXIT:' | tail -1 | cut -d: -f2)
    printf '%s\n' "$SMOKE_OUT" | grep -v '^EXIT:' | tail -10
    [ "$SMOKE_EXIT" = "0" ] || fail "FreeBSD stage3 native-build smoke failed (exit $SMOKE_EXIT)"
    SMOKE_RESULT=$($VM_SSH "test -x ${SMOKE_DIR}/probe && ${SMOKE_DIR}/probe" 2>/dev/null) || fail "FreeBSD stage3 smoke executable failed"
    [ "$SMOKE_RESULT" = "42" ] || fail "Unexpected FreeBSD stage3 smoke output: $SMOKE_RESULT"
    $VM_SSH "rm -rf ${SMOKE_DIR}" 2>/dev/null || true
    pass "Canonical Rust + pure-Simple dynload bootstrap and stage3 compiler smoke completed"

    info "Running FreeBSD Stage4 dynload provider archive proof..."
    DYNLOAD_ARCHIVE_OUT=$($VM_SSH "cd ${VM_HOME}/simple && AR=llvm-ar SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_BINARY=${STAGE_BIN} sh scripts/check/check-stage4-hosted-dynload-provider-archive.shs 2>&1; echo EXIT:\$?" 2>/dev/null)
    DYNLOAD_ARCHIVE_EXIT=$(printf '%s' "$DYNLOAD_ARCHIVE_OUT" | grep '^EXIT:' | tail -1 | cut -d: -f2)
    printf '%s\n' "$DYNLOAD_ARCHIVE_OUT" | grep -v '^EXIT:' | tail -10
    [ "$DYNLOAD_ARCHIVE_EXIT" = "0" ] || fail "FreeBSD Stage4 dynload provider archive proof failed (exit $DYNLOAD_ARCHIVE_EXIT)"
    printf '%s\n' "$DYNLOAD_ARCHIVE_OUT" | grep -qx 'stage4_dynload_provider_archive=true' || fail "FreeBSD Stage4 dynload provider archive receipt missing"
    pass "FreeBSD Stage4 dynload provider archive proof completed"

    info "Running FreeBSD default-LLVM native smoke matrix..."
    MATRIX_OUT=$($VM_SSH "cd ${VM_HOME}/simple && SIMPLE_BINARY=${STAGE_BIN} SIMPLE_RUNTIME_PATH=${VM_HOME}/simple/src/compiler_rust/target/bootstrap NATIVE_SMOKE_BACKEND=llvm NATIVE_SMOKE_WORK_DIR=/tmp/simple-freebsd-native-smoke sh scripts/check/native-smoke-matrix.shs 2>&1; echo EXIT:\$?" 2>/dev/null)
    MATRIX_EXIT=$(printf '%s' "$MATRIX_OUT" | grep '^EXIT:' | tail -1 | cut -d: -f2)
    printf '%s\n' "$MATRIX_OUT" | grep -v '^EXIT:' | tail -20
    [ "$MATRIX_EXIT" = "0" ] || fail "FreeBSD native smoke matrix failed (exit $MATRIX_EXIT)"
    printf '%s\n' "$MATRIX_OUT" | grep -qx 'native_smoke_matrix=true' || fail "FreeBSD native smoke matrix success receipt missing"
    pass "FreeBSD default-LLVM native smoke matrix completed"

    info "Running FreeBSD scoped Cranelift smoke..."
    CRANELIFT_MODULE_INIT_OUT=$($VM_SSH "cd ${VM_HOME}/simple && SIMPLE_BINARY=${STAGE_BIN} SIMPLE_RUNTIME_PATH=${VM_HOME}/simple/src/compiler_rust/target/bootstrap NATIVE_SMOKE_BACKEND=cranelift NATIVE_SMOKE_CASES='dict_struct_value enum_f64_payload_precision tuple_return_across_call hyphenated_module_init parse_f64 scalar_spill_across_loop_calls' NATIVE_SMOKE_WORK_DIR=/tmp/simple-freebsd-native-smoke-cranelift-module-init sh scripts/check/native-smoke-matrix.shs 2>&1; echo EXIT:\$?" 2>/dev/null)
    CRANELIFT_MODULE_INIT_EXIT=$(printf '%s' "$CRANELIFT_MODULE_INIT_OUT" | grep '^EXIT:' | tail -1 | cut -d: -f2)
    printf '%s\n' "$CRANELIFT_MODULE_INIT_OUT" | grep -v '^EXIT:' | tail -10
    [ "$CRANELIFT_MODULE_INIT_EXIT" = "0" ] || fail "FreeBSD scoped Cranelift smoke failed (exit $CRANELIFT_MODULE_INIT_EXIT)"
    printf '%s\n' "$CRANELIFT_MODULE_INIT_OUT" | grep -Fqx '[dict_struct_value] (19) struct-valued Dict m[k].field + keys() text (#189) -> PASS (rc got=73 want=73, fallback_hits=0)' || fail "FreeBSD scoped Cranelift Dict receipt missing"
    printf '%s\n' "$CRANELIFT_MODULE_INIT_OUT" | grep -qx 'native_smoke_matrix=true' || fail "FreeBSD scoped Cranelift success receipt missing"
    pass "FreeBSD scoped Cranelift smoke completed"

    info "Running FreeBSD cross-module Result<u8> compiler smoke..."
    CROSSMODULE_OUT=$($VM_SSH "cd ${VM_HOME}/simple && SIMPLE_BINARY=${STAGE_BIN} SIMPLE_RUNTIME_PATH=${VM_HOME}/simple/src/compiler_rust/target/bootstrap WORK_DIR=/tmp/simple-freebsd-result-u8 sh scripts/check/check-native-crossmodule-result-u8.shs 2>&1; echo EXIT:\$?" 2>/dev/null)
    CROSSMODULE_EXIT=$(printf '%s' "$CROSSMODULE_OUT" | grep '^EXIT:' | tail -1 | cut -d: -f2)
    printf '%s\n' "$CROSSMODULE_OUT" | grep -v '^EXIT:' | tail -10
    [ "$CROSSMODULE_EXIT" = "0" ] || fail "FreeBSD cross-module Result<u8> smoke failed (exit $CROSSMODULE_EXIT)"
    pass "FreeBSD default-LLVM and explicit-Cranelift cross-module Result<u8> smoke completed"

    for PARITY_BACKEND in llvm cranelift; do
        info "Running FreeBSD ${PARITY_BACKEND} Option native-authoritative parity..."
        PARITY_OUT=$($VM_SSH "cd ${VM_HOME}/simple && SIMPLE_BINARY=${STAGE_BIN} NATIVE_PARITY_BACKEND=${PARITY_BACKEND} NATIVE_PARITY_CASES='option_try_annotated_loud option_try_direct_loud option_try_unresolved_method_loud' NATIVE_PARITY_FAIL_ON_XFAIL=1 PARITY_WORK_DIR=/tmp/simple-freebsd-option-${PARITY_BACKEND} sh scripts/check/check-native-seed-parity.shs 2>&1; echo EXIT:\$?" 2>/dev/null)
        PARITY_EXIT=$(printf '%s' "$PARITY_OUT" | grep '^EXIT:' | tail -1 | cut -d: -f2)
        printf '%s\n' "$PARITY_OUT" | grep -v '^EXIT:' | tail -10
        [ "$PARITY_EXIT" = "0" ] || fail "FreeBSD ${PARITY_BACKEND} Option native-authoritative parity failed (exit $PARITY_EXIT)"
        printf '%s\n' "$PARITY_OUT" | grep -qx 'total=3 pass=3 fail=0 xfail=0' || fail "FreeBSD ${PARITY_BACKEND} Option native-authoritative parity summary was not strict 3/3"
    done
    pass "FreeBSD default-LLVM and explicit-Cranelift Option native-authoritative parity completed"

    info "Running FreeBSD strict selected native parity..."
    SELECTED_OUT=$($VM_SSH "cd ${VM_HOME}/simple && SIMPLE_BINARY=${STAGE_BIN} NATIVE_PARITY_CASES='bare_main class_array_field_mutation class_array_param_field_mutation nested_struct_value_copy exists_struct_payload_field result_unwrap text_ordering text_bracket_index text_for_iteration raw_string_interpolation_contract new_keyword_identifier bool_array_element_interp method_owner_dispatch dynload_tagged_text option_is_none_map array_map_text' NATIVE_PARITY_FAIL_ON_XFAIL=1 PARITY_WORK_DIR=/tmp/simple-freebsd-selected-parity sh scripts/check/check-native-seed-parity.shs 2>&1; echo EXIT:\$?" 2>/dev/null)
    SELECTED_EXIT=$(printf '%s' "$SELECTED_OUT" | grep '^EXIT:' | tail -1 | cut -d: -f2)
    printf '%s\n' "$SELECTED_OUT" | grep -v '^EXIT:' | tail -12
    [ "$SELECTED_EXIT" = "0" ] || fail "FreeBSD selected native parity failed (exit $SELECTED_EXIT)"
    printf '%s\n' "$SELECTED_OUT" | grep -qx 'total=32 pass=32 fail=0 xfail=0' || fail "FreeBSD selected native parity summary was not strict 32/32"
    pass "FreeBSD bare-main/class-copy/text-Option/bool/method/dynload/Option-map selected parity completed under LLVM and Cranelift"

    # Retrieve binary
    FREEBSD_BIN_DIR="${ROOT_DIR}/bin/release/freebsd-x86_64"
    mkdir -p "$FREEBSD_BIN_DIR"
    run_bounded "$QEMU_TRANSFER_TIMEOUT" scp \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o BatchMode=yes \
        -o ConnectTimeout=5 \
        -i "$SSH_PRIVATE_KEY" -P "$QEMU_PORT" \
        "${VM_USER}@localhost:${STAGE_BIN}" \
        "${FREEBSD_BIN_DIR}/simple" 2>/dev/null || fail "Failed to retrieve binary"
    pass "Binary retrieved: ${FREEBSD_BIN_DIR}/simple"

    HOST_STAGE_SHA256=$(hash_file "${FREEBSD_BIN_DIR}/simple") ||
        fail "Could not hash retrieved stage3 binary"
    [ "$HOST_STAGE_SHA256" = "$GUEST_STAGE_SHA256" ] ||
        fail "Retrieved stage3 hash differs from guest hash"

    info "Retaining guest bootstrap logs for provenance..."
    copy_guest_bootstrap_logs
    BASE_IMAGE_SHA256="$MEDIA_ACTUAL_SHA256"
    SOURCE_SHA256=$(hash_tree "$ROOT_DIR/src") ||
        fail "Could not hash Simple source tree"
    LOGS_SHA256=$(hash_tree "$PROVENANCE_DIR") ||
        fail "Could not hash retained bootstrap logs"
    PROVENANCE_TMP="${PROVENANCE_RECEIPT}.tmp.$$"
    {
        printf 'freebsd_qemu_bootstrap_provenance_status=pass\n'
        printf 'freebsd_qemu_bootstrap_provenance_scope=FreeBSD x86_64 QEMU\n'
        printf 'freebsd_qemu_bootstrap_freebsd_version=%s\n' "$FREEBSD_VERSION"
        printf 'freebsd_qemu_bootstrap_architecture=x86_64\n'
        printf 'freebsd_qemu_bootstrap_base_image_path=%s\n' "$QEMU_VM_PATH"
        printf 'freebsd_qemu_bootstrap_base_image_sha256=%s\n' "$BASE_IMAGE_SHA256"
        printf 'freebsd_qemu_bootstrap_base_image_expected_sha256=%s\n' "$MEDIA_EXPECTED_SHA256"
        printf 'freebsd_qemu_bootstrap_media_admission=pass\n'
        printf 'freebsd_qemu_bootstrap_source_identity=%s\n' "simple-source:$ROOT_DIR"
        printf 'freebsd_qemu_bootstrap_source_sha256=%s\n' "$SOURCE_SHA256"
        printf 'freebsd_qemu_bootstrap_command=%s\n' "$EXACT_COMMAND"
        printf 'freebsd_qemu_bootstrap_guest_stage_binary_path=%s\n' "$STAGE_BIN"
        printf 'freebsd_qemu_bootstrap_guest_stage_binary_sha256=%s\n' "$GUEST_STAGE_SHA256"
        printf 'freebsd_qemu_bootstrap_host_stage_binary_sha256=%s\n' "$HOST_STAGE_SHA256"
        printf 'freebsd_qemu_bootstrap_retained_logs_path=%s\n' "$PROVENANCE_DIR"
        printf 'freebsd_qemu_bootstrap_retained_logs_sha256=%s\n' "$LOGS_SHA256"
    } > "$PROVENANCE_TMP"
    mv -f "$PROVENANCE_TMP" "$PROVENANCE_RECEIPT"
    pass "Scoped FreeBSD x86_64 QEMU provenance receipt: $PROVENANCE_RECEIPT"

    SCRIPT_OK=1
    SUCCESS_MESSAGE='FreeBSD x86_64 QEMU full bootstrap PASS'
fi
