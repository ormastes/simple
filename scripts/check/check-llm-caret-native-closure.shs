#!/bin/sh
# Release gate for the native LLM Caret entry closure.  It deliberately accepts
# neither a bootstrap/seed compiler nor a fallback runtime: a missing qualified
# runtime or simple-core archive is evidence of a release failure, not a skip.
set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "${SCRIPT_DIR}/../.." && pwd)
ARTIFACT_ROOT="${REPO_ROOT}/build/test-artifacts/03_system/app/llm_caret/feature/llm_caret_native_closure"
OUTPUT="${ARTIFACT_ROOT}/caret-native-closure"
STATUS_FILE="${ARTIFACT_ROOT}/status.txt"
RUNTIME_PATH=""
CORE_ARCHIVE=""

usage() {
    printf '%s\n' 'usage: sh scripts/check/check-llm-caret-native-closure.shs --check'
}

write_status() {
    printf '%s\n' "$1" >"${STATUS_FILE}" 2>/dev/null || true
    printf '%s\n' "$2" >>"${STATUS_FILE}" 2>/dev/null || true
    printf '%s\n' "$3" >>"${STATUS_FILE}" 2>/dev/null || true
}

fail() {
    write_status 'closure_status=FAIL' 'failure_class=release_gate' "failure_reason=$1"
    printf '%s\n' 'closure_status=FAIL'
    printf '%s\n' 'failure_class=release_gate'
    printf '%s\n' "failure_reason=$1"
    exit 1
}

detect_host_target() {
    case "$(uname -m 2>/dev/null || printf unknown)" in
        arm64|aarch64) closure_arch=aarch64 ;;
        x86_64|amd64) closure_arch=x86_64 ;;
        *) return 1 ;;
    esac
    case "$(uname -s 2>/dev/null || printf unknown)" in
        Darwin) printf '%s\n' "${closure_arch}-apple-darwin" ;;
        Linux) printf '%s\n' "${closure_arch}-unknown-linux-gnu" ;;
        FreeBSD) printf '%s\n' "${closure_arch}-unknown-freebsd" ;;
        *) return 1 ;;
    esac
}

select_sha256_tool() {
    if command -v shasum >/dev/null 2>&1; then
        printf '%s\n' shasum
    elif command -v sha256sum >/dev/null 2>&1; then
        printf '%s\n' sha256sum
    else
        return 1
    fi
}

sha256_file() {
    case "$1" in
        shasum) shasum -a 256 "$2" | awk '{print $1}' ;;
        sha256sum) sha256sum "$2" | awk '{print $1}' ;;
        *) return 1 ;;
    esac
}

source_commit() {
    if command -v jj >/dev/null 2>&1 && [ -e "${REPO_ROOT}/.jj" ]; then
        (cd "${REPO_ROOT}" && jj log -r @- --no-graph -T 'commit_id') 2>/dev/null
    elif command -v git >/dev/null 2>&1; then
        git -C "${REPO_ROOT}" rev-parse --verify HEAD 2>/dev/null
    else
        return 1
    fi
}

case "${1:-}" in
    --check) [ "$#" -eq 1 ] || { usage; exit 2; } ;;
    *) usage; exit 2 ;;
esac

mkdir -p "${ARTIFACT_ROOT}" 2>/dev/null || fail artifact_directory_unavailable
: >"${ARTIFACT_ROOT}/build.stdout.txt"
: >"${ARTIFACT_ROOT}/build.stderr.txt"
printf '%s\n' not_started >"${ARTIFACT_ROOT}/build.exit.txt"

HOST_TARGET=$(detect_host_target) || fail host_target_undetermined
if [ -n "${SIMPLE_SIMPLE_CORE_PATH:-}" ] && [ -n "${SIMPLE_CORE_RUNTIME_PATH:-}" ] && \
   [ "${SIMPLE_SIMPLE_CORE_PATH}" != "${SIMPLE_CORE_RUNTIME_PATH}" ]; then
    fail simple_core_archive_ambiguous
fi
CORE_ARCHIVE=${SIMPLE_SIMPLE_CORE_PATH:-${SIMPLE_CORE_RUNTIME_PATH:-}}
[ -n "${CORE_ARCHIVE}" ] || fail simple_core_archive_not_supplied
[ -f "${CORE_ARCHIVE}" ] || fail simple_core_archive_missing

RUNTIME_PATH=${SIMPLE_CARET_RUNTIME_PATH:-"${REPO_ROOT}/bin/release/${HOST_TARGET}/simple"}
[ -x "${RUNTIME_PATH}" ] || fail self_hosted_runtime_missing_or_not_executable
"${RUNTIME_PATH}" --version >"${ARTIFACT_ROOT}/runtime.version.txt" 2>"${ARTIFACT_ROOT}/runtime.version.stderr.txt"
runtime_version_exit=$?
printf '%s\n' "${runtime_version_exit}" >"${ARTIFACT_ROOT}/runtime.version.exit.txt"
[ "${runtime_version_exit}" -eq 0 ] || fail self_hosted_runtime_version_probe_failed
if LC_ALL=C grep -Eqi 'bootstrap|seed' "${ARTIFACT_ROOT}/runtime.version.txt" "${ARTIFACT_ROOT}/runtime.version.stderr.txt"; then
    fail bootstrap_or_seed_runtime_rejected
fi

SHA256_TOOL=$(select_sha256_tool) || fail sha256_utility_missing
RUNTIME_SHA256=$(sha256_file "${SHA256_TOOL}" "${RUNTIME_PATH}") || fail runtime_sha256_unavailable
CORE_ARCHIVE_SHA256=$(sha256_file "${SHA256_TOOL}" "${CORE_ARCHIVE}") || fail simple_core_archive_sha256_unavailable
SOURCE_COMMIT=$(source_commit) || fail source_commit_unavailable

printf '%s\n' \
    "${RUNTIME_PATH}" native-build \
    --source src/compiler --source src/app --source src/lib \
    --entry-closure --entry src/app/llm_caret/main.spl \
    --runtime-bundle simple-core --cache-dir "${ARTIFACT_ROOT}/native-cache" \
    --strip --output "${OUTPUT}" \
    >"${ARTIFACT_ROOT}/build.args.txt"
printf '%s\n' \
    "source_commit=${SOURCE_COMMIT}" \
    "target=${HOST_TARGET}" \
    "runtime_path=${RUNTIME_PATH}" \
    "runtime_sha256=${RUNTIME_SHA256}" \
    "runtime_version_file=runtime.version.txt" \
    "simple_core_archive=${CORE_ARCHIVE}" \
    "simple_core_archive_sha256=${CORE_ARCHIVE_SHA256}" \
    'runtime_bundle=simple-core' \
    'entry=src/app/llm_caret/main.spl' \
    'entry_closure=true' \
    'source_roots=src/compiler,src/app,src/lib' \
    'cache_dir=build/test-artifacts/03_system/app/llm_caret/feature/llm_caret_native_closure/native-cache' \
    'simple_no_stub_fallback=1' \
    >"${ARTIFACT_ROOT}/provenance.txt"

SIMPLE_SIMPLE_CORE_PATH="${CORE_ARCHIVE}" \
SIMPLE_CORE_RUNTIME_PATH="${CORE_ARCHIVE}" \
SIMPLE_NO_STUB_FALLBACK=1 \
"${RUNTIME_PATH}" native-build \
    --source src/compiler --source src/app --source src/lib \
    --entry-closure --entry src/app/llm_caret/main.spl \
    --runtime-bundle simple-core --cache-dir "${ARTIFACT_ROOT}/native-cache" \
    --strip --output "${OUTPUT}" \
    >"${ARTIFACT_ROOT}/build.stdout.txt" 2>"${ARTIFACT_ROOT}/build.stderr.txt"
build_exit=$?
printf '%s\n' "${build_exit}" >"${ARTIFACT_ROOT}/build.exit.txt"
[ "${build_exit}" -eq 0 ] || fail native_entry_closure_build_failed
[ -x "${OUTPUT}" ] || fail native_entry_closure_artifact_missing_or_not_executable

command -v nm >/dev/null 2>&1 || fail nm_utility_missing
nm -u "${OUTPUT}" >"${ARTIFACT_ROOT}/undefined-symbols.txt" 2>"${ARTIFACT_ROOT}/nm.stderr.txt"
nm_exit=$?
printf '%s\n' "${nm_exit}" >"${ARTIFACT_ROOT}/nm.exit.txt"
[ "${nm_exit}" -eq 0 ] || fail nm_undefined_symbol_scan_failed
if LC_ALL=C grep -E \
    '(_)?(rt_(dir_list|file_stat|stdin_read_byte|terminal_(enable_raw_mode|disable_raw_mode|get_size|is_tty|stdout_is_tty)|process_run_inherit|thread_(spawn_isolated_with_args|free))|process_run_inherit)' \
    "${ARTIFACT_ROOT}/undefined-symbols.txt" >"${ARTIFACT_ROOT}/caret-abi-undefined.txt"; then
    fail caret_abi_undefined_symbol_present
fi
: >"${ARTIFACT_ROOT}/caret-abi-undefined.txt"
OUTPUT_SHA256=$(sha256_file "${SHA256_TOOL}" "${OUTPUT}") || fail artifact_sha256_unavailable
printf '%s\n' "artifact_path=${OUTPUT}" "artifact_sha256=${OUTPUT_SHA256}" >>"${ARTIFACT_ROOT}/provenance.txt"
write_status 'closure_status=PASS' 'failure_class=none' 'failure_reason=none'
printf '%s\n' 'closure_status=PASS'
