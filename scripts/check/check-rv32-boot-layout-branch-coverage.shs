#!/bin/sh
# Fail-closed producer for scoped RV32 boot-layout decision evidence.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
checker=$root/scripts/check/check-rv32-boot-layout-branch-coverage.shs
evidence_helper=$root/scripts/check/lib/riscv-hal-migration-evidence.shs
[ -f "$evidence_helper" ] || {
    echo "STATUS: FAIL RV32 boot-layout evidence helper missing" >&2
    exit 1
}
. "$evidence_helper"
HAL_MIGRATION_LANE=rv32_boot_layout
hal_migration_parse_admission "$@"
hal_migration_require_stage4 "$root"
simple=$HAL_MIGRATION_SIMPLE_BIN
hal_migration_bind_target_runtime stage4-embedded-runtime "$simple"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM

source_rel=src/os/kernel/arch/riscv32/boot_layout.spl
source=$root/$source_rel
coverage_driver=$root/test/fixtures/os/rv32_boot_layout_coverage_driver.spl
hal_migration_begin_input_freeze "$work/evidence-inputs.tsv"
hal_migration_capture_input evidence_helper "$evidence_helper"
hal_migration_capture_input checker "$checker"
hal_migration_capture_input owner_source "$source"
hal_migration_capture_input coverage_driver "$coverage_driver"
hal_migration_seal_input_freeze
expected_source_sha256=461a1c9bd5294dceb577a25934111ac53ef1f90e81c2c255a00be403575af97c
hal_migration_is_sha256 "$expected_source_sha256" || {
    echo "STATUS: FAIL RV32 boot-layout expected source hash is malformed" >&2
    exit 1
}

command -v sha256sum >/dev/null 2>&1 || {
    echo "STATUS: FAIL RV32 boot-layout coverage requires sha256sum" >&2
    exit 1
}
actual_source_sha256=$(hal_migration_frozen_hash owner_source "$source") || {
    echo "STATUS: FAIL RV32 boot-layout source hash unavailable" >&2
    exit 1
}
[ "$actual_source_sha256" = "$expected_source_sha256" ] || {
    echo "STATUS: FAIL RV32 boot-layout source hash mismatch expected=$expected_source_sha256 actual=$actual_source_sha256" >&2
    exit 1
}

coverage=$work/rv32_boot_layout_coverage.sdn
SIMPLE_COVERAGE=1 SIMPLE_COVERAGE_OUTPUT=$coverage \
    "$simple" run "$coverage_driver"

result=$(awk -F', *' '
    BEGIN {
        expected["12:4"] = 1
        expected["14:4"] = 1
        expected["16:4"] = 1
        expected["18:4"] = 1
        expected["20:4"] = 1
        expected["22:4"] = 1
        expected["27:4"] = 1
        expected["34:4"] = 1
    }
    $2 ~ /src\/os\/kernel\/arch\/riscv32\/boot_layout\.spl$/ {
        total++
        location = ($3 + 0) ":" ($4 + 0)
        if (!(location in expected)) unexpected++
        seen[location]++
        if (seen[location] > 1) duplicate++
        if (($5 + 0) > 0 && ($6 + 0) > 0) covered++
    }
    END {
        for (location in expected) {
            if (!(location in seen)) missing++
        }
        basis_points = total == 0 ? 0 : int((covered * 10000) / total)
        print covered + 0, total + 0, basis_points, missing + 0, unexpected + 0, duplicate + 0
    }
' "$coverage")
set -- $result
covered=$1
total=$2
basis_points=$3
missing=$4
unexpected=$5
duplicate=$6

[ "$total" -eq 8 ] && [ "$missing" -eq 0 ] && [ "$unexpected" -eq 0 ] && [ "$duplicate" -eq 0 ] || {
    echo "STATUS: FAIL RV32 boot-layout decision inventory total=$total expected=8 missing=$missing unexpected=$unexpected duplicate=$duplicate" >&2
    exit 1
}
[ "$basis_points" -eq 10000 ] || {
    echo "STATUS: FAIL RV32 boot-layout branch coverage=$covered/$total basis_points=$basis_points" >&2
    exit 1
}

receipt=$(hal_migration_receipt_path "$root" rv32-boot-layout)
payload=$work/receipt.payload.env
{
    hal_migration_write_common_fields rv32-boot-layout "$checker"
    printf 'evidence_scope=rv32-boot-layout-decisions\n'
    printf 'owner_source=%s\n' "$source_rel"
    printf 'owner_source_sha256=%s\n' "$actual_source_sha256"
    printf 'coverage_driver=test/fixtures/os/rv32_boot_layout_coverage_driver.spl\n'
    printf 'coverage_driver_sha256=%s\n' "$(hal_migration_frozen_hash coverage_driver "$coverage_driver")"
    printf 'coverage_artifact_sha256=%s\n' "$(hal_migration_hash_file "$coverage")"
    printf 'branch_outcomes_covered=%s\n' "$covered"
    printf 'branch_outcomes_total=%s\n' "$total"
    printf 'branch_coverage_basis_points=%s\n' "$basis_points"
} >"$payload"
hal_migration_revalidate_before_receipt "$root"
hal_migration_revalidate_inputs_before_receipt
hal_migration_publish_receipt "$receipt" "$payload"

echo "STATUS: PASS RV32 boot-layout branch coverage=$covered/$total basis_points=$basis_points source_sha256=$actual_source_sha256 receipt=$HAL_MIGRATION_RECEIPT_PATH receipt_sha256=$HAL_MIGRATION_RECEIPT_SHA256"
