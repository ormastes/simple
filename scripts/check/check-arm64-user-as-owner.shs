#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
adapter="$root/src/os/kernel/memory/user_address_space.spl"
runtime="$root/examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c"
! grep -qF 'fn rt_arm64_user_as_create()' "$adapter"
grep -qF 'fn rt_arm64_user_as_create_host_stub()' "$adapter"
! grep -qF 'fn rt_arm64_user_as_map_page(' "$adapter"
grep -qF 'fn rt_arm64_user_as_map_page_host_stub(' "$adapter"
grep -qF '@export("rt_arm64_user_as_create_host_stub")' "$adapter"
grep -qF '@export("rt_arm64_user_as_map_page_host_stub")' "$adapter"
[ "$(grep -c 'extern fn rt_arm64_user_as_create()' "$adapter")" -eq 1 ]
[ "$(grep -c 'extern fn rt_arm64_user_as_map_page(' "$adapter")" -eq 1 ]
grep -qF '[ARM64_HANDOFF_PREFLIGHT] stage=' "$runtime"
grep -qF ' arena=' "$runtime"
printf '%s\n' 'ARM64 user-AS production owner and preflight receipt PASS'
