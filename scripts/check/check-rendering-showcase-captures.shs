#!/bin/sh
# check-rendering-showcase-captures.shs — NFR-002 headless evidence for the
# rendering showcases (doc/02_requirements/nfr/rendering_showcases.md).
#
# Bounded, per-step-timeout runtime gate over the showcase entries in
# examples/06_io/ui/rendering/. Runs under the Rust seed bin/simple with
# SIMPLE_LIB=src SIMPLE_TIMEOUT_SECONDS=0 (the tree-wide `check` gate is
# broken — doc/08_tracking/bug/check_worker_broken_seed_semantic_2026-09-24.md
# — and graphics compiles exceed the example watchdog; see
# doc/03_plan/sys_test/rendering_showcases.md "Runtime gates").
#
# Steps (each bounded by STEP_TIMEOUT_SECONDS, default 280):
#   a. rendering_2d_{core,extended}.spl — headless PPM capture at 320x240;
#      assert exit 0, `showcase status=pass`, P6 header, nonzero payload.
#   b. rendering_wm_core.spl — headless WM capture at 640x480 (entry minimum);
#      assert exit 0, `showcase status=pass`, nonzero checksum line, P6 PPM at
#      build/tmp/rendering_wm/wm_core.ppm with nonzero payload.
#   c. rendering_tui_core.spl — headless char-grid run with capture; assert
#      `showcase status=pass` and a `painted=<n>` line with n > 0.
#   d. rendering_web_extended.spl — HTML artifact capture; assert pass line
#      and all 5 tab ids in the artifact. The known `_level_rank` gpu_web
#      compile defect (doc/05_design/rendering_showcases.md REQ-009 note) is
#      BLOCKED, never FAIL.
#   e. `bin/simple ui headless rendering_items.ui.sdn` — parse/load gate.
#   f. Webserver GUI — SKIP: known-bug ui_web_seed_exits_before_bind_2026-09-24.
#
# Verdict is ALWAYS the LAST stdout line:
#   STATUS: PASS    — a,b,c,e green (d,f green too)                  exit 0
#   STATUS: FAIL    — a required step ran and its assertions failed  exit 1
#   STATUS: BLOCKED — a required step could not produce evidence
#                     (timeout / known defect / seed tool defect), or
#                     a,f,d non-required steps are blocked while the
#                     required ones are green                     exit 2
#
# Usage:
#   sh scripts/check/check-rendering-showcase-captures.shs

set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
cd "$ROOT" || { echo "STATUS: BLOCKED — cannot cd to repo root"; exit 2; }

SEED="${SIMPLE_SEED:-bin/simple}"
STEP_TIMEOUT="${STEP_TIMEOUT_SECONDS:-280}"
# The seed's JIT codegen of the ~200-module graphics closure takes 5-8 min
# per entry on current hardware; interpreter mode compiles+runs each entry
# well under the step bound and is the accepted seed fallback (NFR-002 note:
# seed JIT interpreter fallbacks are acceptable evidence). Override with
# SHOWCASE_EXEC_MODE=jit to exercise the JIT path (steps will likely BLOCK).
EXEC_MODE="${SHOWCASE_EXEC_MODE:-interpret}"
DIR="examples/06_io/ui/rendering"

if [ ! -x "$SEED" ]; then
    echo "STATUS: BLOCKED — no executable seed at '$SEED'"
    exit 2
fi

# Portable bounded-runner: GNU timeout, else gtimeout, else unbounded with a
# loud note (the gate must never hang, but without a timeout tool we can only
# document it).
if command -v timeout >/dev/null 2>&1; then
    TIMEOUT="timeout"
elif command -v gtimeout >/dev/null 2>&1; then
    TIMEOUT="gtimeout"
else
    TIMEOUT=""
    echo "# warning: no timeout/gtimeout found; steps run unbounded"
fi

TMP=$(mktemp -d "${TMPDIR:-/tmp}/rendering-captures.XXXXXX") || {
    echo "STATUS: BLOCKED — mktemp failed"
    exit 2
}
trap 'rm -rf "$TMP"' EXIT

PASS_N=0
BLOCK_N=0
FAIL_N=0

step_ok()   { PASS_N=$((PASS_N + 1));  echo "PASS    $1"; }
step_fail() { FAIL_N=$((FAIL_N + 1));  echo "FAIL    $1"; }
step_blocked() { BLOCK_N=$((BLOCK_N + 1)); echo "BLOCKED $1"; }

# run_step NAME OUTLOG -- CMD... — run CMD bounded; rc is echoed to OUTLOG.
run_step() {
    rs_name="$1"; rs_log="$2"; shift 2
    [ "$1" = "--" ] && shift
    echo "# step $rs_name: $*" >> "$rs_log"
    if [ -n "$TIMEOUT" ]; then
        env SIMPLE_LIB=src SIMPLE_TIMEOUT_SECONDS=0 SIMPLE_EXECUTION_MODE="$EXEC_MODE" \
            "$TIMEOUT" "$STEP_TIMEOUT" "$@" >> "$rs_log" 2>&1
    else
        env SIMPLE_LIB=src SIMPLE_TIMEOUT_SECONDS=0 SIMPLE_EXECUTION_MODE="$EXEC_MODE" \
            "$@" >> "$rs_log" 2>&1
    fi
    rs_rc=$?
    echo "# step $rs_name rc=$rs_rc" >> "$rs_log"
    return "$rs_rc"
}

# ppm_valid FILE EXPECTED_PAYLOAD — P6 magic + size >= payload + nonzero bytes
# in the trailing EXPECTED_PAYLOAD bytes (all-zero pixels = blank capture).
ppm_valid() {
    pv_file="$1"; pv_payload="$2"
    [ -f "$pv_file" ] || return 1
    [ "$(head -c 2 "$pv_file")" = "P6" ] || return 1
    pv_size=$(wc -c < "$pv_file" | tr -d ' ')
    [ "$pv_size" -ge "$pv_payload" ] || return 1
    tail -c "$pv_payload" "$pv_file" | od -A n -v -t u1 2>/dev/null | \
        awk '{ for (i = 1; i <= NF; i++) if ($i != 0) f = 1 } END { exit f ? 0 : 1 }'
}

# ---------------- step a: 2d PPM captures ----------------
W=320; H=240; PAYLOAD=$((W * H * 3))
A_OK=0
for tier in core extended; do
    log="$TMP/2d_$tier.log"
    ppm="$TMP/l4_$tier.ppm"
    rm -f "$ppm"
    if ! run_step "2d_$tier" "$log" -- \
            env SIMPLE_SHOWCASE_CAPTURE="$ppm" \
                SIMPLE_SHOWCASE_W=$W SIMPLE_SHOWCASE_H=$H \
                "$SEED" run "$DIR/rendering_2d_$tier.spl"; then
        rc=$(tail -1 "$log" | sed 's/.*rc=//')
        if [ "$rc" = "124" ]; then
            step_blocked "a[$tier] timeout after ${STEP_TIMEOUT}s (see $log)"
        else
            step_fail "a[$tier] exit $rc, no pass line (see $log)"
        fi
        continue
    fi
    if ! grep -q "showcase status=pass" "$log"; then
        step_fail "a[$tier] ran but lacks 'showcase status=pass' (see $log)"
        continue
    fi
    if ! ppm_valid "$ppm" "$PAYLOAD"; then
        step_fail "a[$tier] PPM $ppm missing/invalid-P6/blank (see $log)"
        continue
    fi
    step_ok "a[$tier] rendering_2d_$tier.spl PPM $(( $(wc -c < "$ppm" | tr -d ' ') )) bytes, P6, nonzero payload"
    A_OK=$((A_OK + 1))
done

# ---------------- step b: WM headless capture ----------------
log="$TMP/wm_core.log"
WM_W=640; WM_H=480
if ! run_step "wm_core" "$log" -- \
        env SIMPLE_SHOWCASE_W=$WM_W SIMPLE_SHOWCASE_H=$WM_H \
            "$SEED" run "$DIR/rendering_wm_core.spl"; then
    rc=$(tail -1 "$log" | sed 's/.*rc=//')
    if [ "$rc" = "124" ]; then
        step_blocked "b timeout after ${STEP_TIMEOUT}s (see $log)"
    else
        step_fail "b wm_core exit $rc (see $log)"
    fi
elif ! grep -q "showcase status=pass" "$log"; then
    step_fail "b wm_core lacks 'showcase status=pass' (see $log)"
else
    cs=$(sed -n 's/.*checksum=\(-\{0,1\}[0-9]\{1,\}\).*/\1/p' "$log" | head -1)
    ppm="build/tmp/rendering_wm/wm_core.ppm"
    if [ -z "$cs" ] || [ "$cs" = "0" ]; then
        step_fail "b wm_core checksum missing or zero (see $log)"
    elif ! ppm_valid "$ppm" 4096; then
        step_fail "b $ppm missing/invalid-P6/blank"
    else
        step_ok "b wm_core checksum=$cs PPM P6 nonzero"
    fi
fi

# ---------------- step c: TUI headless ----------------
log="$TMP/tui_core.log"
cap="$TMP/tui_core.txt"
if ! run_step "tui_core" "$log" -- \
        env SIMPLE_SHOWCASE_CAPTURE="$cap" \
            "$SEED" run "$DIR/rendering_tui_core.spl"; then
    rc=$(tail -1 "$log" | sed 's/.*rc=//')
    if [ "$rc" = "124" ]; then
        step_blocked "c timeout after ${STEP_TIMEOUT}s (see $log)"
    else
        step_fail "c tui_core exit $rc (see $log)"
    fi
elif ! grep -q "showcase status=pass" "$log"; then
    step_fail "c tui_core lacks 'showcase status=pass' (see $log)"
else
    painted=$(sed -n 's/.*painted=\([0-9]\{1,\}\).*/\1/p' "$log" | head -1)
    if ! awk -v p="${painted:-0}" 'BEGIN { exit (p > 0 ? 0 : 1) }'; then
        step_fail "c tui_core painted=${painted:-missing}, want > 0 (see $log)"
    elif [ ! -s "$cap" ]; then
        step_fail "c tui_core capture $cap missing/empty"
    else
        step_ok "c tui_core painted=$painted capture written"
    fi
fi

# ---------------- step d: web extended HTML artifact ----------------
log="$TMP/web_extended.log"
html="$TMP/web_extended.html"
rm -f "$html"
if ! run_step "web_extended" "$log" -- \
        env SIMPLE_SHOWCASE_CAPTURE="$html" \
            SIMPLE_SHOWCASE_W=$W SIMPLE_SHOWCASE_H=$H \
            "$SEED" run "$DIR/rendering_web_extended.spl"; then
    rc=$(tail -1 "$log" | sed 's/.*rc=//')
    if [ "$rc" = "124" ]; then
        step_blocked "d timeout after ${STEP_TIMEOUT}s (see $log)"
    elif grep -qi "_level_rank\|gpu_web" "$log"; then
        step_blocked "d known-bug gpu_web compile defect (_level_rank, REQ-009 note)"
    else
        step_fail "d web_extended exit $rc (see $log)"
    fi
elif ! grep -q "showcase status=pass" "$log"; then
    if grep -qi "_level_rank\|gpu_web" "$log"; then
        step_blocked "d known-bug gpu_web compile defect (_level_rank, REQ-009 note)"
    else
        step_fail "d web_extended lacks 'showcase status=pass' (see $log)"
    fi
else
    missing=""
    for tab in core forms-media animation themes widgets; do
        grep -q "panel-$tab\"\|panel-$tab'" "$html" 2>/dev/null || missing="$missing $tab"
    done
    if [ -n "$missing" ]; then
        step_fail "d HTML artifact missing tab id(s):$missing"
    else
        step_ok "d web_extended HTML artifact has all 5 tab ids"
    fi
fi

# ---------------- step e: item-list sdn parse/load ----------------
log="$TMP/items.log"
if ! run_step "items" "$log" -- \
        "$SEED" ui headless "$DIR/rendering_items.ui.sdn"; then
    rc=$(tail -1 "$log" | sed 's/.*rc=//')
    if [ "$rc" = "124" ]; then
        step_blocked "e timeout after ${STEP_TIMEOUT}s (see $log)"
    elif [ "$rc" -eq 255 ] && ! grep -qi "error\|panic\|blocked\|invalid" "$log"; then
        # Silent seed exit 255 (SIGSEGV class — see doc/08_tracking/bug/
        # bootstrap_exit_255_misreported_as_signal_127_2026-09-02.md) also
        # reproduces on pristine src/app/simple.sdn, i.e. it is a seed tool
        # defect in `ui headless`, not a defect in the showcase sdn.
        step_blocked "e known seed defect: 'ui headless' silent exit 255 (SIGSEGV class), reproduces on pristine sdn"
    else
        step_fail "e ui headless exit $rc (see $log)"
    fi
else
    step_ok "e rendering_items.ui.sdn parse/load via 'ui headless'"
fi

# ---------------- step f: webserver GUI (recorded skip) ----------------
step_blocked "f known-bug ui_web_seed_exits_before_bind_2026-09-24 (skipped by policy)"

# ---------------- verdict ----------------
# Required: a (both tiers), b, c, e. d, f may be BLOCKED.
echo "# counts: pass=$PASS_N fail=$FAIL_N blocked=$BLOCK_N"
if [ "$FAIL_N" -gt 0 ]; then
    echo "STATUS: FAIL — $FAIL_N step(s) failed, $PASS_N passed, $BLOCK_N blocked"
    exit 1
fi
if [ "$A_OK" -lt 2 ] || [ "$BLOCK_N" -gt 2 ]; then
    echo "STATUS: BLOCKED — a=$A_OK/2 b/c/e required-steps incomplete; pass=$PASS_N blocked=$BLOCK_N"
    exit 2
fi
if [ "$BLOCK_N" -gt 0 ]; then
    echo "STATUS: BLOCKED — required steps green but $BLOCK_N step(s) blocked (d/f/known-defect); pass=$PASS_N"
    exit 2
fi
echo "STATUS: PASS — $PASS_N steps green"
exit 0
