#!/bin/sh
set -eu

# FreeBSD WM Seam Refusal — in-VM verification (Task #60, Lane B)
#
# Wraps the same QEMU VM lifecycle as check-freebsd-bootstrap-qemu.shs (same
# base image, same cloud-init user-data mechanism, same qemu-system-x86_64
# launch recipe — real disk boot, NEVER `-kernel`, NEVER `isa-debug-exit`, per
# .claude/rules/board-runnable.md) to boot a real FreeBSD guest, then:
#
#   1. Proves guest identity: `uname -srm` (board-evidence bar).
#   2. Builds the minimal interpreted-mode `simple` driver binary in-guest
#      (default cargo features only — no `llvm`/`wasm`/`gui`, so no inkwell/
#      LLVM18 dependency; cranelift is a hard dependency of simple-compiler
#      and is always compiled, but that alone is far lighter than the full
#      `bootstrap-from-scratch.sh --full-bootstrap` chain that
#      check-freebsd-bootstrap-qemu.shs --full runs, which this script does
#      NOT duplicate — a real FreeBSD 2D backend and full self-hosting are
#      explicit non-goals of this lane).
#   3. Runs a tiny probe .spl file THROUGH that in-guest interpreter, which
#      imports the real `nogc_async_mut.wm.host` module and calls the real
#      `wm_host_2d_for("freebsd")` — i.e. this executes the actual seam
#      source, not a hand-written mirror of its logic.
#   4. Prints exactly one line to its own transcript:
#        FREEBSD WM SEAM VERDICT: platform=<detected> refusal=<yes|no> reason=<...>
#
# If step 2 cannot complete within the bounded time budget (BUILD_TIMEOUT_SEC,
# default 2400s = 40 min), this script does NOT fabricate a verdict line. It
# prints a `FREEBSD WM SEAM VERDICT: platform=freebsd refusal=blocked
# reason=in-guest build did not complete within budget` line instead, and
# exits non-zero. That is the plan's sanctioned outcome for "the probe binary
# cannot be built for FreeBSD yet ... the interpreted path [is] unavailable"
# (doc/03_plan/ui/wm_platform_honesty_agent_lanes.md, Lane B) — it does not
# silently downgrade to a Linux-only green.
#
# Usage:
#   sh scripts/check/check-freebsd-wm-seam-refusal.shs
#
# Env knobs (same names/defaults as check-freebsd-bootstrap-qemu.shs where
# they overlap, so both scripts share one admitted offline image):
#   QEMU_VM_PATH, QEMU_BASE_VM_PATH, QEMU_CLOUDINIT_ISO, QEMU_SSH_PUBLIC_KEY,
#   QEMU_SSH_PRIVATE_KEY, QEMU_PORT, QEMU_USER, QEMU_MEM, QEMU_CPUS,
#   QEMU_SSH_TIMEOUT, QEMU_ROOT_SSH_TIMEOUT, BUILD_TIMEOUT_SEC,
#   SIMPLE_BIG_STORAGE_ROOT, SIMPLE_FREEBSD_MEDIA_SHA256

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

VM_DIR="${QEMU_VM_DIR:-${ROOT_DIR}/build/freebsd/vm}"
QEMU_PORT="${QEMU_PORT:-2222}"
QEMU_USER="${QEMU_USER:-freebsd}"
QEMU_MEM="${QEMU_MEM:-8G}"
QEMU_CPUS="${QEMU_CPUS:-4}"
QEMU_SSH_TIMEOUT="${QEMU_SSH_TIMEOUT:-1800}"
QEMU_ROOT_SSH_TIMEOUT="${QEMU_ROOT_SSH_TIMEOUT:-120}"
BUILD_TIMEOUT_SEC="${BUILD_TIMEOUT_SEC:-2400}"
FREEBSD_VERSION="14.4"
FREEBSD_IMAGE_NAME="FreeBSD-${FREEBSD_VERSION}-RELEASE-amd64-BASIC-CLOUDINIT-ufs.qcow2"
MEDIA_CHECKER="${ROOT_DIR}/scripts/qemu/simple-freebsd-media.shs"
SHARED_MEDIA_ROOT="${SIMPLE_BIG_STORAGE_ROOT:-${HOME}/.simple}/qemu/images/freebsd"
QEMU_VM_PATH="${QEMU_VM_PATH:-${QEMU_BASE_VM_PATH:-${SIMPLE_FREEBSD_MEDIA_PATH:-${SHARED_MEDIA_ROOT}/${FREEBSD_IMAGE_NAME}}}}"
QEMU_CLOUDINIT_ISO="${QEMU_CLOUDINIT_ISO:-${VM_DIR}/freebsd-cloudinit-seed.iso}"
PID_FILE="${VM_DIR}/wm-seam-qemu.pid"
SERIAL_LOG="${VM_DIR}/wm-seam-qemu-serial.log"
QEMU_START_LOG="${VM_DIR}/wm-seam-qemu-start.log"
OVERLAY_IMAGE="${VM_DIR}/freebsd-wm-seam.overlay.qcow2"

pass()  { printf '  ✓ %s\n' "$1"; }
fail()  { printf '  ✗ %s\n' "$1"; VERDICT_PLATFORM="freebsd"; VERDICT_REFUSAL="blocked"; VERDICT_REASON="$1"; print_verdict; exit 1; }
info()  { printf '  → %s\n' "$1"; }

VERDICT_PLATFORM="unknown"
VERDICT_REFUSAL="blocked"
VERDICT_REASON="probe did not run"
print_verdict() {
    printf 'FREEBSD WM SEAM VERDICT: platform=%s refusal=%s reason=%s\n' \
        "$VERDICT_PLATFORM" "$VERDICT_REFUSAL" "$VERDICT_REASON"
}

SCRIPT_OK=0
cleanup() {
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            if [ -n "${VM_SSH:-}" ]; then
                info "Requesting guest shutdown"
                $VM_SSH "shutdown -p now" >/dev/null 2>&1 || true
                sleep 5
            fi
            info "Stopping QEMU (pid=$pid)"
            kill "$pid" 2>/dev/null || true
            sleep 1
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
        fi
        rm -f "$PID_FILE"
    fi
    rm -f "$OVERLAY_IMAGE"
    if [ "$SCRIPT_OK" -eq 1 ]; then
        rm -f "$SERIAL_LOG"
    else
        [ -f "$SERIAL_LOG" ] && info "Serial log preserved: $SERIAL_LOG"
    fi
}
trap cleanup EXIT

printf 'FreeBSD WM Seam Refusal Check\n\n'
printf '[1/6] Prerequisites\n'
command -v qemu-system-x86_64 >/dev/null 2>&1 || fail "qemu-system-x86_64 not found"
command -v qemu-img >/dev/null 2>&1 || fail "qemu-img not found"
command -v ssh >/dev/null 2>&1 || fail "ssh not found"
command -v rsync >/dev/null 2>&1 || fail "rsync not found"
MEDIA_RECEIPT="$(sh "$MEDIA_CHECKER" --check --path "$QEMU_VM_PATH")" || {
    printf '%s\n' "$MEDIA_RECEIPT" >&2
    fail "Admitted FreeBSD base image required; provision shared media and trusted SHA-256 offline"
}
MEDIA_EXPECTED_SHA256=$(printf '%s\n' "$MEDIA_RECEIPT" | sed -n 's/^freebsd_media_expected_sha256=//p')
MEDIA_ACTUAL_SHA256=$(printf '%s\n' "$MEDIA_RECEIPT" | sed -n 's/^freebsd_media_actual_sha256=//p')
[ -n "$MEDIA_EXPECTED_SHA256" ] && [ "$MEDIA_EXPECTED_SHA256" = "$MEDIA_ACTUAL_SHA256" ] || fail "Admitted FreeBSD base image receipt incomplete"
[ -f "$QEMU_CLOUDINIT_ISO" ] || fail "Cloud-init ISO not found: $QEMU_CLOUDINIT_ISO (run check-freebsd-bootstrap-qemu.shs --smoke once first to generate it)"
pass "qemu, ssh, rsync found; admitted base image and cloud-init ISO already present"

printf '[2/6] SSH key\n'
if [ -n "${QEMU_SSH_PUBLIC_KEY:-}" ]; then
    SSH_PUB_KEY="$QEMU_SSH_PUBLIC_KEY"
elif [ -f "$HOME/.ssh/id_ed25519.pub" ]; then
    SSH_PUB_KEY="$HOME/.ssh/id_ed25519.pub"
elif [ -f "$HOME/.ssh/id_rsa.pub" ]; then
    SSH_PUB_KEY="$HOME/.ssh/id_rsa.pub"
else
    fail "No SSH public key found (set QEMU_SSH_PUBLIC_KEY)"
fi
SSH_PRIVATE_KEY="${QEMU_SSH_PRIVATE_KEY:-${SSH_PUB_KEY%.pub}}"
[ -f "$SSH_PRIVATE_KEY" ] || fail "Matching SSH private key not found: $SSH_PRIVATE_KEY"
pass "SSH key: $SSH_PRIVATE_KEY"

# ── Boot: identical recipe to check-freebsd-bootstrap-qemu.shs's [5/7] ─────
printf '[3/6] QEMU boot (real disk image; no -kernel; no isa-debug-exit)\n'
mkdir -p "$VM_DIR"
rm -f "$OVERLAY_IMAGE"
qemu-img create -f qcow2 -b "$QEMU_VM_PATH" -F qcow2 "$OVERLAY_IMAGE" >/dev/null 2>&1
qemu-img resize "$OVERLAY_IMAGE" 30G >/dev/null 2>&1

ACCEL="tcg"
CPU_MODEL="qemu64"
if [ -w /dev/kvm ] 2>/dev/null; then
    ACCEL="kvm"
    CPU_MODEL="host"
fi

rm -f "$PID_FILE" "$QEMU_START_LOG"
if ! qemu-system-x86_64 \
    -machine "accel=${ACCEL}" \
    -cpu "$CPU_MODEL" \
    -m "$QEMU_MEM" \
    -smp "$QEMU_CPUS" \
    -drive "file=${OVERLAY_IMAGE},format=qcow2,if=virtio" \
    -drive "file=${QEMU_CLOUDINIT_ISO},format=raw,if=virtio,media=cdrom" \
    -net nic,model=virtio \
    -net "user,hostfwd=tcp::${QEMU_PORT}-:22" \
    -display none \
    -serial "file:${SERIAL_LOG}" \
    -daemonize \
    -pidfile "$PID_FILE" 2>"$QEMU_START_LOG"; then
    [ -s "$QEMU_START_LOG" ] && tail -10 "$QEMU_START_LOG" >&2
    fail "QEMU failed to start"
fi
QEMU_PID="$(cat "$PID_FILE" 2>/dev/null || true)"
[ -n "$QEMU_PID" ] && kill -0 "$QEMU_PID" 2>/dev/null || fail "QEMU failed to start"
pass "QEMU started (pid=${QEMU_PID}, accel=${ACCEL}, real BASIC-CLOUDINIT disk boot)"

require_qemu_alive() {
    if ! kill -0 "$QEMU_PID" 2>/dev/null; then
        [ -s "$SERIAL_LOG" ] && tail -20 "$SERIAL_LOG" >&2
        fail "QEMU exited while waiting for SSH"
    fi
}

printf '[4/6] SSH connectivity + guest identity\n'
SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o ConnectTimeout=5 -i ${SSH_PRIVATE_KEY} -p ${QEMU_PORT}"
SCP_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o ConnectTimeout=5 -i ${SSH_PRIVATE_KEY} -P ${QEMU_PORT}"
SSH_CMD="ssh ${SSH_OPTS} ${QEMU_USER}@localhost"

ELAPSED=0
CONNECTED=0
info "Waiting for SSH (up to ${QEMU_SSH_TIMEOUT}s)..."
while [ "$ELAPSED" -lt "$QEMU_SSH_TIMEOUT" ]; do
    require_qemu_alive
    if $SSH_CMD true 2>/dev/null; then
        CONNECTED=1
        break
    fi
    sleep 5
    ELAPSED=$((ELAPSED + 5))
done
[ "$CONNECTED" -eq 1 ] || fail "SSH connection timed out after ${QEMU_SSH_TIMEOUT}s"
pass "SSH connected as ${QEMU_USER} in ${ELAPSED}s"

# Board-evidence bar: identity + boot path + transcript (this stdout IS the
# transcript; the caller captures it to a file).
UNAME_LINE=$($SSH_CMD "uname -srm" 2>/dev/null) || UNAME_LINE="(unknown)"
printf 'GUEST UNAME: %s\n' "$UNAME_LINE"
case "$UNAME_LINE" in
    FreeBSD*) pass "Guest identity confirmed: $UNAME_LINE" ;;
    *) fail "Expected FreeBSD guest, got: $UNAME_LINE" ;;
esac

ROOT_ELAPSED=0
ROOT_OK=0
ROOT_SSH_CMD="ssh ${SSH_OPTS} root@localhost"
while [ "$ROOT_ELAPSED" -lt "$QEMU_ROOT_SSH_TIMEOUT" ]; do
    require_qemu_alive
    if $ROOT_SSH_CMD true 2>/dev/null; then
        ROOT_OK=1
        break
    fi
    sleep 5
    ROOT_ELAPSED=$((ROOT_ELAPSED + 5))
done
if [ "$ROOT_OK" -eq 1 ]; then
    VM_USER="root"
    VM_SSH="$ROOT_SSH_CMD"
    PKG_CMD="$ROOT_SSH_CMD"
    pass "Root SSH available (after ${ROOT_ELAPSED}s)"
else
    fail "No root SSH available (needed for pkg install)"
fi

# ── In-guest interpreter build (minimal: no llvm/wasm/gui features) ───────
printf '[5/6] In-guest interpreted-mode build (bounded to %ss)\n' "$BUILD_TIMEOUT_SEC"
VM_HOME=$($VM_SSH "echo \$HOME" 2>/dev/null)
VM_HOME="${VM_HOME:-/root}"

info "Growing guest root filesystem..."
$PKG_CMD "service growfs onestart >/tmp/wm-seam-growfs.log 2>&1 || true"

info "Installing rust + rsync (this counts against the build budget)..."
BUILD_STARTED_AT=$(date +%s)
if ! $PKG_CMD "env ASSUME_ALWAYS_YES=yes pkg bootstrap >/tmp/wm-seam-pkg-bootstrap.log 2>&1"; then
    fail "pkg bootstrap failed"
fi
if ! $PKG_CMD "env ASSUME_ALWAYS_YES=yes pkg install -y rsync rust >/tmp/wm-seam-pkg-install.log 2>&1"; then
    $VM_SSH "tail -20 /tmp/wm-seam-pkg-install.log" >&2 || true
    fail "dependency installation failed"
fi
pass "rust + rsync installed"

info "Syncing repo to guest (compiler + WM/host seam sources only)..."
rsync -az --delete \
    --exclude='.git' --exclude='.jj/' \
    --exclude='/.claude/worktrees/' --exclude='/.codex/worktrees/' --exclude='/.agents/worktrees/' \
    --exclude='/build/' --exclude='.simple/' --exclude='/bootstrap/' \
    --exclude='node_modules/' --exclude='/examples/' --exclude='/doc/' \
    --exclude='*.qcow2' \
    --exclude='/src/compiler_rust/target/' --exclude='/src/compiler_rust/target_*/' \
    --exclude='/tools/' --exclude='/bin/' \
    -e "ssh ${SSH_OPTS}" \
    "${ROOT_DIR}/" "${VM_USER}@localhost:${VM_HOME}/simple/" \
    || fail "rsync to guest failed"
pass "Repo synced"

info "Writing WM seam refusal probe..."
$VM_SSH "cat > ${VM_HOME}/simple/wm_freebsd_seam_probe.spl" <<'PROBE_EOF'
# Lane B (Task #60) FreeBSD in-VM probe. Executes the REAL seam source
# (nogc_async_mut.wm.host) on a real FreeBSD guest, not a mirror of its
# logic. See doc/03_plan/ui/wm_platform_honesty_agent_lanes.md, Lane B.
use nogc_async_mut.wm.host.{wm_host_2d_for}

fn main():
    val host = wm_host_2d_for("freebsd")
    val surface = host.surface_acquire(800u32, 600u32)
    val refusal = if surface.ok: "no" else "yes"
    print "FREEBSD WM SEAM VERDICT: platform=" + host.platform + " refusal=" + refusal + " reason=" + host.reason
PROBE_EOF
pass "Probe written: ${VM_HOME}/simple/wm_freebsd_seam_probe.spl"

info "Building minimal interpreted-mode 'simple' binary (default features: no llvm/wasm/gui)..."
NOW=$(date +%s)
REMAINING=$((BUILD_TIMEOUT_SEC - (NOW - BUILD_STARTED_AT)))
if [ "$REMAINING" -le 60 ]; then
    fail "in-guest build did not complete within budget (pkg install alone exceeded ${BUILD_TIMEOUT_SEC}s)"
fi
BUILD_OUT=$($VM_SSH "cd ${VM_HOME}/simple/src/compiler_rust && timeout ${REMAINING} cargo build -p simple-driver --bin simple 2>&1; echo WM_SEAM_BUILD_EXIT:\$?" 2>/dev/null) || true
BUILD_EXIT=$(printf '%s' "$BUILD_OUT" | grep '^WM_SEAM_BUILD_EXIT:' | tail -1 | cut -d: -f2)
printf '%s\n' "$BUILD_OUT" | grep -v '^WM_SEAM_BUILD_EXIT:' | tail -30
if [ "$BUILD_EXIT" != "0" ]; then
    fail "in-guest build did not complete within budget or failed (cargo exit=${BUILD_EXIT:-timeout/none})"
fi
pass "In-guest 'simple' binary built"

# ── Run the probe through the real in-guest interpreter ────────────────────
printf '[6/6] Running probe through the in-guest interpreter\n'
PROBE_OUT=$($VM_SSH "cd ${VM_HOME}/simple && SIMPLE_LIB=${VM_HOME}/simple/src/lib ./src/compiler_rust/target/debug/simple run wm_freebsd_seam_probe.spl 2>&1; echo WM_SEAM_RUN_EXIT:\$?" 2>/dev/null) || true
PROBE_EXIT=$(printf '%s' "$PROBE_OUT" | grep '^WM_SEAM_RUN_EXIT:' | tail -1 | cut -d: -f2)
printf '%s\n' "$PROBE_OUT" | grep -v '^WM_SEAM_RUN_EXIT:'
VERDICT_LINE=$(printf '%s\n' "$PROBE_OUT" | grep '^FREEBSD WM SEAM VERDICT:' | tail -1)
if [ "$PROBE_EXIT" != "0" ] || [ -z "$VERDICT_LINE" ]; then
    fail "probe did not run to completion in-guest (exit=${PROBE_EXIT:-none})"
fi

# Re-print the guest-produced verdict line verbatim as this script's own
# stdout line (the gate greps THIS script's stdout, not the ssh transcript).
printf '%s\n' "$VERDICT_LINE"

case "$VERDICT_LINE" in
    "FREEBSD WM SEAM VERDICT: platform=freebsd refusal=yes"*) pass "Refusal confirmed by the real in-guest seam" ;;
    *) fail "Unexpected verdict shape: $VERDICT_LINE" ;;
esac

SCRIPT_OK=1
printf '\nFreeBSD WM seam refusal check PASSED\n'
