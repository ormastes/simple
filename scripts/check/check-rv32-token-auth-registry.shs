#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
registry="$root/src/os/kernel/arch/riscv32/token_auth_registry.spl"
storage="$root/src/os/kernel/arch/common/packed_auth_storage.spl"
catalog="$root/src/os/port/_SimpleosMultiplatformBuild/platform_target_catalog.spl"

require() {
    rg -F "$2" "$1" >/dev/null || { echo "missing contract: $2" >&2; exit 1; }
}

require "$registry" 'packed_auth_claim(PACKED_AUTH_SECRET)'
require "$registry" 'packed_auth_claim(PACKED_AUTH_MESSAGE)'
require "$registry" 'packed_auth_release(message_lease)'
require "$registry" 'RV32_TOKEN_MAC_INPUT_BYTES'
require "$registry" 'rt_rv32_token_siphash24('
require "$registry" 'key_address <= 0xffffffffu64'
require "$storage" 'rt_packed_auth_write_byte(lease, i, bytes[i].to_u32())'
require "$catalog" '"src/os/kernel/arch/common/freestanding_packed_auth_storage.c"'

if rg -n 'rt_array_data_ptr|rt_dma_|return[[:space:]]+1u64' "$registry" >/dev/null; then
    echo "unsafe raw-array, DMA, or fabricated tag path detected" >&2
    exit 1
fi

count=$(rg -F '"src/os/kernel/arch/common/freestanding_packed_auth_storage.c"' "$catalog" | wc -l)
[ "$count" -eq 2 ] || { echo "packed storage must be selected once for each RV32/x86_32 target" >&2; exit 1; }

echo "rv32 token auth registry: PASS"
