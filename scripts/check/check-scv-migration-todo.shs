#!/bin/sh
# check-scv-migration-todo.shs — hourly, signature-gated checker for the SCV
# migration ledger (.spipe/scv-migration/todo.sdn).
#
# Verdict is ALWAYS the last stdout line:
#   PASS — <n> step(s) checked, <d> done, <a> active, 0 blocked      exit 0
#   PASS — 0 step(s) due, nothing to do (<d> done, <p> pending)      exit 0   (quiet hour)
#   FAIL — <n> step(s) checked, <d> done, <a> active, <b> blocked: … exit 1
#   ERROR — nothing was checked (<reason>)                           exit 2
#
# For every ledger step with due <= now and status != done:
#   (a) the step script named in check_cmd (scripts/scv-migration/steps/SCV-MIG-NN.shs)
#       MUST verify via scripts/trust/verify-script.shs --no-selftest. Unsigned, invalid,
#       missing script, or missing verifier => status blocked, reason unsigned, overall
#       FAIL. The script is NEVER executed in that case (fail-closed).
#   (b) otherwise the script runs under `timeout`; ONLY its last stdout line is read and
#       recorded as last_verdict (comma-sanitized); PASS flips the status to done, anything
#       else leaves it active. The exit status is read directly, never through a pipe.
# The ledger is rewritten atomically (tmp in the same dir + mv) and one line per run is
# appended to .spipe/scv-migration/runs.log. --dry-run mutates nothing.
#
# --selftest runs first and is fatal (7 fixtures). Inside selftest ONLY, --verify-cmd
# substitutes a fixture verifier; outside selftest the option is refused so the real
# path always calls the real trust script.
#
# Usage: sh scripts/check/check-scv-migration-todo.shs [--selftest-only] [--no-selftest]
#          [--dry-run] [--now <utc-iso>] [--ledger PATH] [--public PATH] [--root DIR]
#          [--timeout SECONDS]

set -u

SCRIPT_PATH="$0"
case "$SCRIPT_PATH" in /*) ;; *) SCRIPT_PATH="$(pwd)/$SCRIPT_PATH" ;; esac
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../.." && pwd)"
LEDGER=""
PUBLIC="config/trust/scv_migration_root.pub"
NOW=""
DRY_RUN=0
SELFTEST=1
SELFTEST_ONLY=0
STEP_TIMEOUT=900
VERIFY_CMD=""

while [ $# -gt 0 ]; do
  case "$1" in
    --root) shift; ROOT="${1:-}" ;;
    --ledger) shift; LEDGER="${1:-}" ;;
    --public) shift; PUBLIC="${1:-}" ;;
    --now) shift; NOW="${1:-}" ;;
    --timeout) shift; STEP_TIMEOUT="${1:-900}" ;;
    --dry-run) DRY_RUN=1 ;;
    --selftest|--selftest-only) SELFTEST_ONLY=1 ;;
    --no-selftest) SELFTEST=0 ;;
    --verify-cmd) shift; VERIFY_CMD="${1:-}" ;;
    *) echo "ERROR — nothing was checked (unknown argument: $1)"; exit 2 ;;
  esac
  shift
done

if [ -n "$VERIFY_CMD" ] && [ "${SCV_MIG_SELFTEST:-0}" != "1" ]; then
  echo "ERROR — nothing was checked (--verify-cmd is only honoured inside --selftest)"
  exit 2
fi
[ -n "$NOW" ] || NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
[ -n "$LEDGER" ] || LEDGER="$ROOT/.spipe/scv-migration/todo.sdn"
case "$LEDGER" in /*) ;; *) LEDGER="$(pwd)/$LEDGER" ;; esac
case "$PUBLIC" in /*) ;; *) PUBLIC="$ROOT/$PUBLIC" ;; esac
RUNS_LOG="$(dirname "$LEDGER")/runs.log"
NOW_DAY="$(printf '%s' "$NOW" | cut -c1-10)"

# ---------------------------------------------------------------- helpers
sanitize() { printf '%s' "$1" | tr ',' ';' | tr -d '"' | tr -d '\r'; }

# verify_step FILE -> 0 if signature valid, 1 otherwise. Never fails open.
verify_step() {
  f="$1"
  [ -f "$f" ] || return 1
  if [ -n "$VERIFY_CMD" ]; then
    out="$($VERIFY_CMD "$f" 2>/dev/null)"
    rc=$?
  else
    vs="$ROOT/scripts/trust/verify-script.shs"
    [ -f "$vs" ] || return 1
    [ -f "$PUBLIC" ] || return 1
    out="$(sh "$vs" --no-selftest --public "$PUBLIC" "$f" 2>/dev/null)"
    rc=$?
  fi
  [ "$rc" -eq 0 ] || return 1
  case "$(printf '%s\n' "$out" | tail -n 1)" in PASS*) return 0 ;; esac
  return 1
}

# run_ledger -> processes $LEDGER, prints verdict, returns exit code.
run_ledger() {
  if [ ! -f "$LEDGER" ]; then
    echo "ERROR — nothing was checked (ledger not found: $LEDGER)"
    return 2
  fi
  tmp="$(dirname "$LEDGER")/.todo.sdn.tmp.$$"
  : > "$tmp"
  n=0; d=0; a=0; b=0; executed=0; blocked_names=""
  total=0; done_all=0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "    SCV-MIG-"*|"    SCV-IMPL-"*) ;;
      *) printf '%s\n' "$line" >> "$tmp"; continue ;;
    esac
    body="${line#    }"
    id="$(printf '%s' "$body" | awk -F', ' '{print $1}')"
    week="$(printf '%s' "$body" | awk -F', ' '{print $2}')"
    due="$(printf '%s' "$body" | awk -F', ' '{print $3}')"
    status="$(printf '%s' "$body" | awk -F', ' '{print $4}')"
    cmd="$(printf '%s' "$body" | awk -F', ' '{print $5}' | tr -d '"')"
    last_run="$(printf '%s' "$body" | awk -F', ' '{print $6}')"
    last_verdict="$(printf '%s' "$body" | awk -F', ' '{print $7}' | tr -d '"')"
    reason="$(printf '%s' "$body" | awk -F', ' '{print $8}')"
    total=$((total+1))
    [ "$status" = "done" ] && done_all=$((done_all+1))
    if [ "$due" \> "$NOW_DAY" ]; then
      printf '%s\n' "$line" >> "$tmp"; continue
    fi
    n=$((n+1))
    if [ "$status" = "done" ]; then
      d=$((d+1)); printf '%s\n' "$line" >> "$tmp"; continue
    fi
    step="$(printf '%s' "$cmd" | grep -o 'scripts/scv-migration/steps/SCV-\(MIG-[0-9][0-9]*\|IMPL-[A-Z]-[0-9][0-9]*\)\.shs' | head -n 1)"
    if [ -z "$step" ]; then
      status="blocked"; reason="bad_check_cmd"; b=$((b+1)); blocked_names="$blocked_names $id($reason)"
    elif ! verify_step "$ROOT/$step"; then
      status="blocked"; reason="unsigned"; b=$((b+1)); blocked_names="$blocked_names $id(unsigned)"
      echo "$id: blocked — $step has no valid signature (never executed)"
    elif [ "$DRY_RUN" -eq 1 ]; then
      echo "$id: signature OK, dry-run (not executed)"
      [ "$status" = "blocked" ] && status="pending"
      reason=""
      a=$((a+1))
    else
      executed=$((executed+1))
      out="$(dirname "$LEDGER")/.step.$id.out.$$"
      ( cd "$ROOT" && timeout "$STEP_TIMEOUT" sh "$step" > "$out" 2>&1 )
      rc=$?
      verdict="$(tail -n 1 "$out" 2>/dev/null)"
      rm -f "$out"
      [ -n "$verdict" ] || verdict="(no output; rc=$rc)"
      last_verdict="$(sanitize "$verdict")"
      last_run="$NOW"
      reason=""
      if [ "$rc" -eq 0 ] && [ "${verdict#PASS}" != "$verdict" ]; then
        status="done"; d=$((d+1))
      else
        status="active"; a=$((a+1))
      fi
      echo "$id: rc=$rc verdict=$verdict"
    fi
    printf '    %s, %s, %s, %s, "%s", %s, "%s", %s\n' \
      "$id" "$week" "$due" "$status" "$cmd" "$last_run" "$last_verdict" "$reason" >> "$tmp"
  done < "$LEDGER"

  if [ "$total" -eq 0 ]; then
    rm -f "$tmp"
    echo "ERROR — nothing was checked (0 steps in $LEDGER)"
    return 2
  fi
  if [ $((n - d)) -eq 0 ] && [ "$b" -eq 0 ] && [ "$executed" -eq 0 ]; then
    # Quiet hour: no actionable step (none due, or every due step already done).
    rm -f "$tmp"
    verdict="PASS — 0 step(s) due, nothing to do ($done_all done, $((total - done_all)) pending)"
    [ "$DRY_RUN" -eq 1 ] || printf '%s %s\n' "$NOW" "$verdict" >> "$RUNS_LOG"
    echo "$verdict"
    return 0
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    rm -f "$tmp"
  else
    mv "$tmp" "$LEDGER"
  fi
  if [ "$b" -gt 0 ]; then
    verdict="FAIL — $n step(s) checked, $d done, $a active, $b blocked:$blocked_names"
    rc=1
  else
    verdict="PASS — $n step(s) checked, $d done, $a active, 0 blocked"
    rc=0
  fi
  [ "$DRY_RUN" -eq 1 ] || printf '%s %s\n' "$NOW" "$verdict" >> "$RUNS_LOG"
  echo "$verdict"
  return $rc
}

# ---------------------------------------------------------------- selftest
selftest() {
  fx="${TMPDIR:-/tmp}/scv-mig-selftest.$$"
  rm -rf "$fx"; mkdir -p "$fx/scripts/scv-migration/steps" "$fx/.spipe/scv-migration"
  # Fixture verifier: PASS iff FILE.sig holds sha256(FILE).
  cat > "$fx/fixture-verify.sh" <<'EOF'
#!/bin/sh
f="$1"
[ -f "$f.sig" ] || { echo "FAIL — no signature"; exit 1; }
want="$(cat "$f.sig")"; have="$(sha256sum "$f" | cut -d' ' -f1)"
[ "$want" = "$have" ] && { echo "PASS — 1 file(s) verified"; exit 0; }
echo "FAIL — signature mismatch"; exit 1
EOF
  chmod +x "$fx/fixture-verify.sh"
  mk_step() { # id body
    p="$fx/scripts/scv-migration/steps/$1.shs"
    printf '#!/bin/sh\n%s\n' "$2" > "$p"
  }
  sign() { sha256sum "$fx/scripts/scv-migration/steps/$1.shs" | cut -d' ' -f1 > "$fx/scripts/scv-migration/steps/$1.shs.sig"; }
  mk_step SCV-MIG-01 'echo "detail, with comma"; echo "PASS — 1 spec(s) green, 0 failed"; exit 0'
  mk_step SCV-MIG-02 'echo "FAIL — 1 spec(s) red"; exit 1'
  mk_step SCV-MIG-03 'echo "PASS — should never run"; touch "$0.EXECUTED"; exit 0'
  sign SCV-MIG-01; sign SCV-MIG-02
  L="$fx/.spipe/scv-migration/todo.sdn"
  {
    echo 'steps |id, week, due, status, check_cmd, last_run_utc, last_verdict, blocked_reason|'
    echo '    SCV-MIG-01, 1, 2026-01-01, pending, "sh scripts/scv-migration/steps/SCV-MIG-01.shs", , , '
    echo '    SCV-MIG-02, 1, 2026-01-01, pending, "sh scripts/scv-migration/steps/SCV-MIG-02.shs", , , '
    echo '    SCV-MIG-04, 1, 2099-01-01, pending, "sh scripts/scv-migration/steps/SCV-MIG-04.shs", , , '
  } > "$L"
  common="--no-selftest --root $fx --ledger $L --now 2026-06-01T00:00:00Z --verify-cmd $fx/fixture-verify.sh"
  fails=0
  # F1+F2: signed PASS -> done, signed FAIL -> active with verdict; overall PASS
  v="$(SCV_MIG_SELFTEST=1 sh "$SCRIPT_PATH" $common 2>&1 | tail -n 1)"
  case "$v" in "PASS — 2 step(s) checked, 1 done, 1 active, 0 blocked") ;; *) echo "selftest F1/F2 FAIL: $v"; fails=$((fails+1)) ;; esac
  grep -q '^    SCV-MIG-01, 1, 2026-01-01, done, .*"PASS — 1 spec(s) green; 0 failed", $' "$L" || { echo "selftest F1 ledger FAIL"; sed -n 2p "$L"; fails=$((fails+1)); }
  grep -q '^    SCV-MIG-02, 1, 2026-01-01, active, .*"FAIL — 1 spec(s) red", $' "$L" || { echo "selftest F2 ledger FAIL"; sed -n 3p "$L"; fails=$((fails+1)); }
  grep -q '^    SCV-MIG-04, 1, 2099-01-01, pending, ' "$L" || { echo "selftest future-step FAIL"; fails=$((fails+1)); }
  [ -f "$fx/.spipe/scv-migration/runs.log" ] || { echo "selftest runs.log FAIL"; fails=$((fails+1)); }
  # F3: unsigned step -> blocked/unsigned, never executed, overall FAIL exit 1
  echo '    SCV-MIG-03, 1, 2026-01-01, pending, "sh scripts/scv-migration/steps/SCV-MIG-03.shs", , , ' >> "$L"
  out="$(SCV_MIG_SELFTEST=1 sh "$SCRIPT_PATH" $common 2>&1)"; rc=$?
  v="$(printf '%s\n' "$out" | tail -n 1)"
  case "$v" in "FAIL — 3 step(s) checked, 1 done, 1 active, 1 blocked: SCV-MIG-03(unsigned)") ;; *) echo "selftest F3 FAIL: $v"; fails=$((fails+1)) ;; esac
  [ "$rc" -eq 1 ] || { echo "selftest F3 exit FAIL: $rc"; fails=$((fails+1)); }
  [ ! -f "$fx/scripts/scv-migration/steps/SCV-MIG-03.shs.EXECUTED" ] || { echo "selftest F3 EXECUTED unsigned script"; fails=$((fails+1)); }
  grep -q '^    SCV-MIG-03, 1, 2026-01-01, blocked, .*, unsigned$' "$L" || { echo "selftest F3 ledger FAIL"; fails=$((fails+1)); }
  # F3b: dry-run mutates nothing
  cp "$L" "$L.before"
  SCV_MIG_SELFTEST=1 sh "$SCRIPT_PATH" $common --dry-run >/dev/null 2>&1
  cmp -s "$L" "$L.before" || { echo "selftest dry-run mutated ledger"; fails=$((fails+1)); }
  # F4: 0 steps -> ERROR exit 2
  echo 'steps |id, week, due, status, check_cmd, last_run_utc, last_verdict, blocked_reason|' > "$L"
  v="$(SCV_MIG_SELFTEST=1 sh "$SCRIPT_PATH" $common 2>&1 | tail -n 1)"
  case "$v" in "ERROR — nothing was checked"*) ;; *) echo "selftest F4 FAIL: $v"; fails=$((fails+1)) ;; esac
  # F5: --verify-cmd refused outside selftest
  v="$(sh "$SCRIPT_PATH" $common 2>&1 | tail -n 1)"
  case "$v" in "ERROR — nothing was checked (--verify-cmd"*) ;; *) echo "selftest F5 FAIL: $v"; fails=$((fails+1)) ;; esac
  # F6: quiet hour — only future-due pending steps -> quiet PASS exit 0, ledger untouched
  {
    echo 'steps |id, week, due, status, check_cmd, last_run_utc, last_verdict, blocked_reason|'
    echo '    SCV-MIG-04, 2, 2099-01-01, pending, "sh scripts/scv-migration/steps/SCV-MIG-04.shs", , , '
    echo '    SCV-MIG-05, 2, 2099-01-01, pending, "sh scripts/scv-migration/steps/SCV-MIG-05.shs", , , '
  } > "$L"
  cp "$L" "$L.f6before"
  out="$(SCV_MIG_SELFTEST=1 sh "$SCRIPT_PATH" $common 2>&1)"
  rc=$?
  v="$(printf '%s\n' "$out" | tail -n 1)"
  case "$v" in "PASS — 0 step(s) due, nothing to do (0 done, 2 pending)") ;; *) echo "selftest F6 FAIL: $v"; fails=$((fails+1)) ;; esac
  [ "$rc" -eq 0 ] || { echo "selftest F6 exit FAIL: $rc"; fails=$((fails+1)); }
  cmp -s "$L" "$L.f6before" || { echo "selftest F6 mutated ledger"; fails=$((fails+1)); }
  # F7: SCV-IMPL rows are processed exactly like SCV-MIG rows (signed PASS -> done)
  mk_step SCV-IMPL-X-01 'echo "PASS — impl fixture green"; exit 0'
  sign SCV-IMPL-X-01
  {
    echo 'steps |id, week, due, status, check_cmd, last_run_utc, last_verdict, blocked_reason|'
    echo '    SCV-IMPL-X-01, 5, 2026-01-01, pending, "sh scripts/scv-migration/steps/SCV-IMPL-X-01.shs", , , '
  } > "$L"
  v="$(SCV_MIG_SELFTEST=1 sh "$SCRIPT_PATH" $common 2>&1 | tail -n 1)"
  case "$v" in "PASS — 1 step(s) checked, 1 done, 0 active, 0 blocked") ;; *) echo "selftest F7 FAIL: $v"; fails=$((fails+1)) ;; esac
  grep -q '^    SCV-IMPL-X-01, 5, 2026-01-01, done, ' "$L" || { echo "selftest F7 ledger FAIL"; sed -n 2p "$L"; fails=$((fails+1)); }
  rm -rf "$fx"
  if [ "$fails" -gt 0 ]; then
    echo "ERROR — nothing was checked (selftest failed: $fails fixture(s))"
    exit 2
  fi
  echo "selftest: 7 fixture(s) OK"
}

if [ "$SELFTEST" -eq 1 ]; then selftest; fi
if [ "$SELFTEST_ONLY" -eq 1 ]; then
  echo "PASS — 7 selftest fixture(s) checked, 0 failed"
  exit 0
fi
run_ledger
exit $?
