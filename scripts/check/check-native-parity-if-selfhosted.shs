#!/bin/sh
# check-native-parity-if-selfhosted.shs — auto-activating seed-vs-native parity gate.
#
# WHY THIS EXISTS (2026-07-28)
#   check-native-seed-parity.shs is the REAL cross-compiler oracle: an
#   independent Rust seed on the left, the self-hosted native backend on the
#   right. It is fail-closed — with no self-hosted binary deployed it exits 2
#   (UNTESTABLE), which is correct for the script and wrong for a CI job: a job
#   that is red every single run for a known, expected, temporary condition gets
#   muted, and a signal nobody reads is no signal. That is the same fail-open
#   outcome the identity audit was opened to remove (cf. the 17 dead CI path
#   filters that sat dormant for a month).
#
#   This wrapper absorbs EXACTLY ONE expected condition — "no self-hosted binary
#   has been deployed yet" — and nothing else:
#
#     a verifiably self-hosted binary is found   -> run the real parity check,
#                                                   propagate its exit code
#                                                   verbatim (0 pass / 1 fail).
#     every candidate is verifiably a Rust SEED,
#     or no candidate exists at all              -> LOUD, ANNOTATED SKIP, exit 0.
#     a candidate exists but its identity cannot
#     be established (--version fails/empty)     -> exit 2. That is an anomaly,
#                                                   not the expected condition,
#                                                   and it must be visible.
#
#   AUTO-ACTIVATION IS THE POINT. Detection is by IDENTITY, never by a flag,
#   an opt-in, or a hand-maintained "enabled: true". Nobody has to remember to
#   turn this on. The moment the in-flight bootstrap campaign deposits a real
#   self-hosted binary at any candidate path, the very next run of this script
#   asks it `--version`, sees no seed banner, and starts gating. Re-enabling is
#   not a task on anyone's list, which is the only way it does not get forgotten.
#
# Candidate search order (first VERIFIABLY self-hosted binary wins). Override
# the whole list with SELF_HOSTED_CANDIDATES, or force one with SIMPLE_BINARY.
#
# DELIBERATELY NOT IN THE DEFAULT LIST: build/bootstrap/stage3/**/simple.
# stage3 is genuinely self-hosted (it reports `simple-bootstrap 1.0.0-RC`,
# no seed banner) and it IS already gated as a real seed-vs-native oracle by
# the rust-bootstrap-multiplatform steps "Run full native seed parity gate",
# "Run strict Option and Cranelift Result parity", and the two macOS strict
# steps — all of which pass SIMPLE_BINARY="$stage3" and therefore satisfy the
# fail-closed guard on their own. Adding stage3 here would duplicate those,
# not add coverage. This wrapper deliberately targets the DEPLOYED compiler
# (bin/simple and the hosted full CLI) — the artifact the bootstrap campaign
# is working toward and the one nothing else gates. Point it at stage3 with
# SELF_HOSTED_CANDIDATES if you want that comparison locally.
#
# EXIT CONTRACT
#   0  parity was measured on two verified compilers and passed,
#      OR the expected "not bootstrapped yet" skip (loudly reported).
#   1  parity was measured and the two compilers disagree.
#   2  untestable for an UNEXPECTED reason (no seed oracle, unverifiable
#      candidate, missing tool). Not a pass.
#
# Usage: sh scripts/check/check-native-parity-if-selfhosted.shs
# Env:   SELF_HOSTED_CANDIDATES, SIMPLE_BINARY, SEED_BINARY, and every variable
#        check-native-seed-parity.shs reads (NATIVE_PARITY_CASES,
#        NATIVE_PARITY_FAIL_ON_XFAIL, PARITY_WORK_DIR, NATIVE_PARITY_BACKEND...)
#        are passed straight through.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

. "$ROOT_DIR/scripts/check/lib/require-self-hosted.shs"

PARITY_SCRIPT="scripts/check/check-native-seed-parity.shs"
[ -f "$PARITY_SCRIPT" ] ||
    check_untestable "$PARITY_SCRIPT is missing; the parity gate cannot run"

# --- assemble candidates ---------------------------------------------------
if [ -n "${SIMPLE_BINARY:-}" ]; then
    CANDIDATES="$SIMPLE_BINARY"
elif [ -n "${SELF_HOSTED_CANDIDATES:-}" ]; then
    CANDIDATES="$SELF_HOSTED_CANDIDATES"
else
    CANDIDATES="bin/simple bin/release/simple"
    # Bootstrap deposits the hosted full CLI under a target-triple directory.
    for extra in $(find build/bootstrap/full build/release bin/release \
                        -type f -name simple -print 2>/dev/null); do
        CANDIDATES="$CANDIDATES $extra"
    done
fi

SELF_HOSTED_FOUND=""
SEED_SEEN=""
UNVERIFIABLE=""
EXAMINED=""

# classify_candidate PATH -> echoes one of:
#   selfhosted     no seed banner, identified itself             -> eligible
#   seed           Rust bootstrap seed banner                    -> expected skip
#   nonproduction  the bin/release/simple production guard refused to launch
#                  because its target is not a production runtime. That is a
#                  DEFINITE negative identity assertion ("this is not the
#                  self-hosted compiler"), same skip class as `seed` — not an
#                  unknown. Matched narrowly on the guard's own wording so this
#                  never becomes a catch-all excuse for a broken binary.
#   unknown        anything else: no output, or a failure that asserts nothing
#                  about identity                                -> anomaly
classify_candidate() {
    _cc_out="$("$1" --version 2>&1)" && _cc_rc=0 || _cc_rc=$?
    case "$_cc_out" in
        *"bootstrap seed only"*|*"Rust-built Simple binary"*|*"Rust-built"*)
            echo seed; return 0 ;;
        *"refusing non-production Simple runtime"*)
            echo nonproduction; return 0 ;;
    esac
    if [ "$_cc_rc" -ne 0 ] || [ -z "$_cc_out" ]; then
        echo unknown; return 0
    fi
    echo selfhosted
}

for cand in $CANDIDATES; do
    cand_path="$(resolve_binary "$cand" 2>/dev/null)" || continue
    cand_real="$(real_path "$cand_path")"
    case " $EXAMINED " in *" $cand_real "*) continue ;; esac
    EXAMINED="$EXAMINED $cand_real"

    case "$(classify_candidate "$cand_path")" in
        selfhosted)
            SELF_HOSTED_FOUND="$cand_path"
            echo "candidate: $cand -> $cand_real  [SELF-HOSTED]"
            break ;;
        seed)
            SEED_SEEN="$SEED_SEEN $cand_real"
            echo "candidate: $cand -> $cand_real  [rust seed, not eligible]" ;;
        nonproduction)
            SEED_SEEN="$SEED_SEEN $cand_real"
            echo "candidate: $cand -> $cand_real  [production guard refused: target is not a production runtime, not eligible]" ;;
        *)
            UNVERIFIABLE="$UNVERIFIABLE $cand_real"
            echo "candidate: $cand -> $cand_real  [IDENTITY UNVERIFIABLE]" >&2 ;;
    esac
done

# --- anomaly: something is there but will not identify itself --------------
if [ -z "$SELF_HOSTED_FOUND" ] && [ -n "$UNVERIFIABLE" ]; then
    check_untestable "candidate binary present but its identity could not be established:$UNVERIFIABLE
  '--version' failed or produced no output. This is NOT the expected
  'not bootstrapped yet' condition, so it is not skipped: a compiler that
  cannot say what it is cannot be the trusted right-hand side of a parity
  check, and a silently skipped anomaly is how this class of defect hides."
fi

# --- expected condition: no self-hosted binary deployed yet ----------------
if [ -z "$SELF_HOSTED_FOUND" ]; then
    SKIP_MSG="seed-vs-native parity SKIPPED: no self-hosted binary is deployed yet"
    echo ""
    echo "################################################################"
    echo "##                                                            ##"
    echo "##   SKIPPED  —  THIS IS NOT A PASS                           ##"
    echo "##                                                            ##"
    echo "##   seed-vs-native parity did NOT run.                       ##"
    echo "##   No verifiably self-hosted compiler was found, so there   ##"
    echo "##   is no second compiler to compare the Rust seed against.  ##"
    echo "##   Nothing about seed/native parity was proven by this run. ##"
    echo "##                                                            ##"
    echo "################################################################"
    echo ""
    echo "  candidates examined:"
    for c in $EXAMINED; do echo "    $c"; done
    [ -n "$SEED_SEEN" ] && echo "  none of them is a self-hosted compiler (seed / non-production guard)."
    echo ""
    echo "  This is the EXPECTED state while the bootstrap campaign is in"
    echo "  flight, so it does not fail the job. It re-arms itself: this gate"
    echo "  detects the self-hosted compiler by asking it '--version', not by"
    echo "  any flag or opt-in, so the first run after a self-hosted binary"
    echo "  lands at one of the paths above will START GATING AUTOMATICALLY."
    echo "  Nobody needs to remember to re-enable it."
    echo ""
    echo "  To run it now:  SIMPLE_BINARY=/path/to/self-hosted/simple \\"
    echo "                    sh $PARITY_SCRIPT"
    echo ""
    echo "native_seed_parity=SKIPPED (not measured; not a pass)"

    # Make the skip impossible to miss in the GitHub UI, not just the raw log.
    if [ -n "${GITHUB_ACTIONS:-}" ]; then
        echo "::warning title=Seed-vs-native parity SKIPPED::$SKIP_MSG. The check did not run; this is not a pass. It auto-activates once a self-hosted binary is deployed."
    fi
    if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
        {
            echo "### :warning: seed-vs-native parity — SKIPPED (not a pass)"
            echo ""
            echo "The real two-compiler parity check **did not run**. No verifiably"
            echo "self-hosted binary was found, so the Rust seed had nothing to be"
            echo "compared against. **Nothing about seed/native parity was proven.**"
            echo ""
            echo "Candidates examined:"
            echo ""
            for c in $EXAMINED; do echo "- \`$c\`"; done
            echo ""
            echo "This is expected while the bootstrap campaign is in flight and does"
            echo "not fail the job. Detection is by binary identity, so this gate"
            echo "**activates automatically** on the first run after a self-hosted"
            echo "binary is deployed — no manual re-enable step exists or is needed."
        } >>"$GITHUB_STEP_SUMMARY"
    fi
    exit 0
fi

# --- a real self-hosted compiler exists: run the real check, gate on it -----
echo ""
echo "=============================================================="
echo "seed-vs-native parity ACTIVATED"
echo "  a verifiably self-hosted compiler is deployed, so the real"
echo "  two-compiler parity check runs and GATES this job."
echo "  self-hosted: $(real_path "$SELF_HOSTED_FOUND")"
echo "=============================================================="
echo ""

if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
    {
        echo "### seed-vs-native parity — ACTIVE"
        echo ""
        echo "Self-hosted compiler detected at \`$(real_path "$SELF_HOSTED_FOUND")\`;"
        echo "the real two-compiler parity check ran and gates this job."
    } >>"$GITHUB_STEP_SUMMARY"
fi

set +e
PARITY_MODE=seed-vs-native SIMPLE_BINARY="$SELF_HOSTED_FOUND" sh "$PARITY_SCRIPT"
rc=$?
set -e

if [ "$rc" -eq 0 ]; then
    echo "parity gate: PASS (measured on two verified compilers)"
elif [ "$rc" -eq 1 ]; then
    echo "parity gate: FAIL — the seed and the self-hosted native backend disagree." >&2
else
    echo "parity gate: UNTESTABLE (rc=$rc) — a self-hosted binary WAS found, so this" >&2
    echo "  is not the expected 'not bootstrapped yet' skip. Not a pass." >&2
fi
exit "$rc"
