#!/bin/sh
# check-no-dangling-reexports.shs — fail when a facade re-exports a `*_partN`
# module that does not exist anywhere in the tree.
#
# Why (2026-08-31): merge e274cd33719 rewrote ~21 facade files to
# `export use <name>_part1/2/3.*` where those modules were never created — the
# real split files live in sibling `_ClassName/` folders. A dangling re-export
# erases the facade's ENTIRE exported API downstream, which surfaced far away as
# `hir: cannot infer field type ... struct 'ANY'` and
# `codegen: GlobalLoad: unresolved identifier`, and was the single largest cause
# of the SimpleOS kernel being unbuildable (B1). Nothing in the tree detected it:
# the failures name the victim modules, never the broken facade.
#
# SCOPE — deliberately narrow, and this matters. A general "does this module path
# resolve?" check needs the compiler's real multi-root resolver (`std.*` maps to
# src/lib, paths resolve against several roots); a naive version of this script
# reported 1371 "dangling" re-exports out of 4117, nearly all false positives.
# A guard that cries wolf gets ignored, so this one checks ONLY the `_partN`
# shape — the exact fingerprint of the clobber — by basename, across the whole
# tree. It will not catch every broken facade; it will not fire spuriously.
#
# Verdict is the last line of stdout:
#   PASS  — <n> _partN re-export(s) checked, 0 dangling
#   FAIL  — <n> checked, <k> dangling: <facade -> module ...>
#   ERROR — nothing was checked (<reason>)
# A scan that examined 0 _partN re-exports is ERROR, never a pass: if this class
# is ever fully repaired, the guard must be retired deliberately, not pass
# vacuously.
set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)

if [ "${1:-}" = "--selftest" ]; then
    T=$(mktemp -d) || { echo "ERROR — nothing was checked: mktemp failed"; exit 2; }
    mkdir -p "$T/src/pkg"
    printf 'fn a(): 1\n' > "$T/src/pkg/real_part1.spl"
    printf 'export use pkg.real_part1.*\n' > "$T/src/pkg/good.spl"
    printf 'export use pkg.ghost_part1.*\n' > "$T/src/pkg/bad.spl"
    g=$(SCAN_ROOT="$T" sh "$0" 2>&1 | tail -1)
    rm -rf "$T"
    case "$g" in
        FAIL*ghost_part1*)
            case "$g" in
                *real_part1*) echo "ERROR — nothing was checked: selftest flagged the EXISTING sibling"; exit 2 ;;
                *) echo "selftest ok (2 fixtures: existing _partN ignored, missing _partN named)" ;;
            esac ;;
        *) echo "ERROR — nothing was checked: selftest expected FAIL naming ghost_part1, got: $g"; exit 2 ;;
    esac
fi

SCAN_ROOT="${SCAN_ROOT:-$ROOT}"
cd "$SCAN_ROOT" || { echo "ERROR — nothing was checked: cannot enter $SCAN_ROOT"; exit 2; }
[ -d src ] || { echo "ERROR — nothing was checked: no src/ under $SCAN_ROOT"; exit 2; }

# Every .spl basename in the tree, once — the existence oracle.
find src -name '*.spl' -exec basename {} .spl \; 2>/dev/null | sort -u > "$SCAN_ROOT/.reexport_names.$$"
trap 'rm -f "$SCAN_ROOT/.reexport_names.$$"' EXIT

CHECKED=0
DANGLING=0
NAMES=""
for f in $(/usr/bin/grep -rlE '^[[:space:]]*(pub )?export use [A-Za-z_0-9.]*_part[0-9]+' src --include='*.spl' 2>/dev/null); do
    for m in $(/usr/bin/grep -oE '^[[:space:]]*(pub )?export use [A-Za-z_0-9.]*_part[0-9]+' "$f" \
               | sed -E 's/.*export use //'); do
        CHECKED=$((CHECKED + 1))
        leaf=${m##*.}
        if ! grep -qx "$leaf" "$SCAN_ROOT/.reexport_names.$$"; then
            DANGLING=$((DANGLING + 1))
            [ "$DANGLING" -le 60 ] && NAMES="$NAMES $f->$m"
        fi
    done
done

if [ "$CHECKED" -eq 0 ]; then
    # Zero `_partN` re-exports is the REPAIRED state, not a broken scan — but only
    # if the scan actually looked at something. Prove the oracle ran by requiring
    # a non-empty .spl population; that distinguishes "class eliminated" from
    # "find/grep silently returned nothing".
    POP=$(wc -l < "$SCAN_ROOT/.reexport_names.$$")
    if [ "$POP" -eq 0 ]; then
        echo "ERROR — nothing was checked: no .spl files found under $SCAN_ROOT/src"
        exit 2
    fi
    echo "PASS — 0 _partN re-export(s) present across $POP module(s); the clobber class is fully repaired"
    exit 0
fi
if [ "$DANGLING" -gt 0 ]; then
    echo "FAIL — $CHECKED _partN re-export(s) checked, $DANGLING dangling:$NAMES"
    exit 1
fi
echo "PASS — $CHECKED _partN re-export(s) checked, 0 dangling"
