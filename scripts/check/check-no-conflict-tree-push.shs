#!/bin/sh
# Refuse to push a jj conflict commit.
#
# jj encodes a conflicted commit in git as a tree whose ONLY entries are
# .jjconflict-base-0/, .jjconflict-side-0/, .jjconflict-side-1/ — the real
# source tree is absent. Pushing one leaves `main` with no files: a clone gets
# an empty repo, and every commit stacked on top inherits the empty tree.
#
# This happened on 2026-07-25: commit 857e26b0cbc was pushed while
# scripts/os/make_os_disk.c was still 2-sided-conflicted, an FPGA commit landed
# on top, and main carried no source files until 37cda4b restored it.
# `jj git push` did NOT block it — jj considers pushing a conflict legal.
#
# Diagnosing this after the fact is unobvious: `git cat-file -p <sha>:<path>`
# reports "exists on disk, but not in <sha>", which reads as one missing file
# rather than a broken tree. `git ls-tree` on the commit is what shows the cause.
#
# ---------------------------------------------------------------------------
# FAIL-CLOSED CONTRACT (added 2026-08-01 after a proved cwd fail-open)
# ---------------------------------------------------------------------------
# Until 2026-08-01 this guard FAILED OPEN on the working directory. Run from a
# directory that is not a git repository — which is exactly what the standard
# landing workflow produces, because agents build in a `git archive` worktree
# under /dev/shm or /run/user/1000 that has no .git — it printed
#
#     check-no-conflict-tree-push: nothing to push in <range>
#
# and exited 0, having checked nothing at all. PROVED 2026-08-01: with the
# conflict-tree fixture commit ee6ac5c6683 in range, this guard exited 1 from
# the repo root and 0 from an archived worktree. `main` had by then been wiped
# to near-zero files twice in 24 hours, each time with "every other guard
# passed" in the record. This guard is the backstop; a backstop that reports
# success without running is worse than no backstop.
#
# The rules now are:
#   * Every `git` invocation's exit status is checked. A git failure is an
#     ERROR (exit 2), never a clean result.
#   * cwd must be inside a git repository, and both range endpoints must
#     actually exist as commits in it. Otherwise: ERROR (exit 2).
#   * An EXPLICITLY SUPPLIED range that resolves to zero commits is a
#     contradiction — the caller asked for a range and there is nothing in it.
#     That is an ERROR (exit 2), not a pass.
#   * The verdict line names how many commits were actually examined, so a
#     vacuous run cannot be mistaken for a real one.
#
# NOTE ON PIPES: a piped exit status is the LAST command's, so `guard | tail`
# discards this script's status entirely. Redirect to a FILE and read the file.
# To limit the damage when that rule is forgotten, the final verdict line always
# goes to stdout and always begins with PASS:, FAIL: or ERROR:.
#
# Usage: check-no-conflict-tree-push.shs [rev-range | --<rev-list args>...]
#   --selftest: run the fail-closed core.worktree-poison fixture and exit
#   default range: main@origin..@-   (what a `jj git push --bookmark main` sends)
#   An explicit range MUST contain ".." — a bare rev means "all history
#   reachable from it" to git and is rejected rather than silently
#   reinterpreted.
#   RAW REV-LIST MODE: `--rev-list-args <args>...` passes <args> to
#   `git rev-list` verbatim and skips endpoint verification (there are no
#   endpoints to verify). This exists for the pre-push hook, which must express
#   "everything on this new ref that origin does not already have" as
#   `<sha> --not --remotes=origin`. Every other fail-closed rule still applies,
#   including "resolved to 0 commits is an ERROR, not a pass".
#
#   ARGUMENT ORDER IS LOAD-BEARING. `git rev-list --not --remotes=origin <sha>`
#   puts <sha> AFTER --not, so <sha> is EXCLUDED and the walk yields ZERO
#   commits. The pre-push hook shipped exactly that string until 2026-08-01;
#   combined with the old "0 commits => nothing to push => exit 0" behaviour it
#   meant every new-ref push was waved through completely unchecked. PROVED
#   2026-08-01: the old guard exited 0 on
#   "--not --remotes=origin ee6ac5c6683f5f8b0a158da5a1dd54d5f5fd65d6", a range
#   whose only commit is a conflict tree. The positive rev must come FIRST:
#   `<sha> --not --remotes=origin`.
# Exit 0 = safe to push, 1 = conflict commit found, 2 = could not determine.

set -u

SELF=check-no-conflict-tree-push
MAX_PUSH_COMMITS=64
FALLBACK_TIPS=""

# --- the no-silent-exit invariant -------------------------------------------
# See the same block in check-tree-size-push.shs. Before 2026-08-10 this guard
# had NO trap at all, so a SIGTERM (a caller's 600s cap, earlyoom, an explicit
# kill) ended it with an EMPTY stdout and no verdict — which a caller grepping
# the output file for a verdict cannot distinguish from a run still in
# progress, and which on 2026-08-10 produced a real false-green push. Every
# stop now ends in one of the three verdicts.
VERDICT_EMITTED=0
cleanup() {
    cl_status=$?
    trap - EXIT HUP INT TERM QUIT PIPE
    if [ "$VERDICT_EMITTED" -eq 0 ]; then
        case "$cl_status" in
            129) cl_why="killed by SIGHUP (129)" ;;
            130) cl_why="interrupted by SIGINT (130)" ;;
            131) cl_why="killed by SIGQUIT (131)" ;;
            141) cl_why="killed by SIGPIPE (141)" ;;
            143) cl_why="killed by SIGTERM (143) — a harness timeout, earlyoom, or an explicit kill" ;;
            0)   cl_why="the script stopped without reaching a verdict (exit 0)" ;;
            *)   cl_why="the script aborted before reaching a verdict (exit $cl_status)" ;;
        esac
        echo "$SELF: ERROR — $cl_why" >&2
        echo "$SELF: ERROR — nothing was checked (exit 2)"
        cl_status=2
    fi
    exit "$cl_status"
}
trap cleanup EXIT HUP INT TERM QUIT PIPE

# Pin grep: the interactive default on this machine is ugrep, not GNU grep.
GREP=grep
[ -x /usr/bin/grep ] && GREP=/usr/bin/grep

die() {
    # $1 = exit code, rest = message
    code=$1
    shift
    VERDICT_EMITTED=1
    echo "$SELF: ERROR — $*" >&2
    echo "$SELF: ERROR — nothing was checked (exit $code)"
    exit "$code"
}

if [ "${1:-}" = --test-max-commits ]; then
    case "${2:-}" in ''|*[!0-9]*) die 2 "--test-max-commits requires an integer" ;; esac
    [ "$2" -ge 1 ] && [ "$2" -le 64 ] || die 2 "--test-max-commits may only lower the production limit of 64"
    MAX_PUSH_COMMITS=$2
    shift 2
fi

# --selftest: fail-closed fixture for the core.worktree poison (2026-11-11).
# The 2026-08-08 incident: core.worktree in the shared .git/config redirected
# every git command to another tree and all three pre-push guards answered the
# GENERIC repository-mismatch error — protection that looks like a tooling
# hiccup gets ignored. This fixture poisons a throwaway repo and requires the
# guard to exit 2 naming core.worktree and the repair.
# doc/08_tracking/bug/core_worktree_config_disables_all_pre_push_guards_2026-08-08.md
if [ "${1:-}" = --selftest ]; then
    st_self=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P)/$(basename -- "$0")
    st_tmp=$(mktemp -d 2>/dev/null) || die 2 "mktemp -d failed"
    trap 'rm -rf "$st_tmp" 2>/dev/null' EXIT HUP INT TERM
    st_repo="$st_tmp/core-worktree-repo"
    mkdir -p "$st_repo/scripts/check"
    cp "$st_self" "$st_repo/scripts/check/check-no-conflict-tree-push.shs"
    (
        cd "$st_repo" || exit 2
        git init -q
        git config user.email test@example.com
        git config user.name test
        printf 'hello\n' > f.txt
        git add f.txt
        git commit -q -m "initial"
        st_base=$(git rev-parse HEAD)
        printf 'hello\nworld\n' > f.txt
        git add f.txt
        git commit -q -m "second"
        st_tip=$(git rev-parse HEAD)
        git config core.worktree "$st_tmp/not-this-tree"
        sh scripts/check/check-no-conflict-tree-push.shs "$st_base..$st_tip" > out.txt 2>&1
        echo $? > rc.txt
    )
    st_rc=$(cat "$st_repo/rc.txt" 2>/dev/null)
    st_out=$(cat "$st_repo/out.txt" 2>/dev/null)
    if [ "$st_rc" = "2" ] && printf '%s' "$st_out" | "$GREP" -q "core.worktree"; then
        echo "$SELF: selftest fixture 1 (core.worktree poison named, fail closed) -> PASS: ok"
        echo "$SELF: selftest: 1 fixture(s) passed"
        exit 0
    fi
    echo "$SELF: selftest FIXTURE 1 FAILED (core.worktree must fail closed naming core.worktree): rc=$st_rc out=$st_out" >&2
    echo "$SELF: ERROR — nothing was checked (selftest failed)"
    exit 2
fi

range="${1:-}"
explicit=0
rawmode=0
[ -n "$range" ] && explicit=1
case "$range" in
    --rev-list-args)
        rawmode=1
        shift
        [ "$#" -gt 0 ] || { VERDICT_EMITTED=1; echo "$SELF: ERROR — --rev-list-args needs arguments" >&2
                            echo "$SELF: ERROR — nothing was checked (exit 2)"; exit 2; }
        ;;
    --rev-list-args-or-tips)
        rawmode=1
        shift
        while [ "$#" -gt 0 ] && [ "$1" != -- ]; do
            FALLBACK_TIPS="$FALLBACK_TIPS $1"
            shift
        done
        [ "${1:-}" = -- ] || die 2 "--rev-list-args-or-tips requires a -- separator"
        shift
        [ -n "$FALLBACK_TIPS" ] && [ "$#" -gt 0 ] || die 2 "--rev-list-args-or-tips requires tips and rev-list arguments"
        ;;
    --*)
        VERDICT_EMITTED=1
        echo "$SELF: ERROR — unknown option '$range'; raw mode is '--rev-list-args <args>...'" >&2
        echo "$SELF: ERROR — nothing was checked (exit 2)"
        exit 2
        ;;
esac

# --- 0. core.worktree poison: name it, don't fail generically later ---------
# core.worktree in the shared .git/config redirects EVERY git command in this
# repo — including this guard's own toplevel resolution below — to a different
# working tree. The guards then die with the generic 'repository mismatch'
# error, which reads like a tooling hiccup, so the only protection against a
# main tree wipe looks broken and invites being pushed past. Name the cause
# and the repair instead.
# doc/08_tracking/bug/core_worktree_config_disables_all_pre_push_guards_2026-08-08.md
_cw_git_common=$(git rev-parse --git-common-dir 2>/dev/null) || _cw_git_common=""
if [ -n "$_cw_git_common" ] && [ -f "$_cw_git_common/config" ]; then
    _cw_value=$(git config --file "$_cw_git_common/config" --get core.worktree 2>/dev/null) || _cw_value=""
    if [ -n "$_cw_value" ]; then
        die 2 "core.worktree = '$_cw_value' is set in $_cw_git_common/config.
  That key redirects every git command in this repository — this guard
  included — to a DIFFERENT working tree, so the pre-push guards cannot
  check the tree about to be pushed and fail closed here.
  Repair:  git config --file \"$_cw_git_common/config\" --unset core.worktree
  One-run workaround: export GIT_DIR=<repo>/.git GIT_WORK_TREE=<repo>"
    fi
fi

# --- 1. cwd must be inside a git repository ---------------------------------
toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || toplevel=""
if [ -z "$toplevel" ]; then
    die 2 "cwd '$(pwd)' is not inside a git repository.
  This guard must run from the repo root of the clone you are about to push.
  A 'git archive' worktree under /dev/shm or /run/user/1000 has no .git and
  CANNOT be checked from — cd to the real clone and re-run."
fi
toplevel=$(CDPATH= cd -- "$toplevel" && pwd -P) || die 2 "cannot canonicalise toplevel"

# --- 2. cross-check: are we checking the repo this script ships in? ---------
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P) || script_dir=""
if [ -n "$script_dir" ]; then
    script_root=$(CDPATH= cd -- "$script_dir/../.." 2>/dev/null && pwd -P) || script_root=""
fi
if [ -n "${script_root:-}" ] && [ "$script_root" != "$toplevel" ]; then
    if [ -e "$script_root/.git" ]; then
        die 2 "repository mismatch.
  This script lives in the git repo at: $script_root
  but cwd resolves to the git repo at:  $toplevel
  Refusing to report on a different repository than the one being guarded."
    fi
    echo "$SELF: WARNING — script at $script_dir is outside the repo being checked ($toplevel)" >&2
fi

# --- 3. resolve the range, fail closed -------------------------------------
if [ "$explicit" -eq 0 ]; then
    base=$(jj --ignore-working-copy log -r 'main@origin' --no-graph -T 'commit_id' 2>/dev/null) || base=""
    tip=$(jj --ignore-working-copy log -r '@-' --no-graph -T 'commit_id' 2>/dev/null) || tip=""
    if [ -z "$base" ] || [ -z "$tip" ]; then
        die 2 "cannot resolve main@origin..@- via jj (is jj available and is this a jj workspace?).
  Pass an explicit range instead, e.g. $SELF '<base-sha>..<tip-sha>'."
    fi
    range="$base..$tip"
elif [ "$rawmode" -eq 0 ]; then
    case "$range" in
        *..*) : ;;
        *) die 2 "explicit range '$range' does not contain '..'.
  A bare revision means 'all history reachable from it' to git, which is not
  what this guard is for. Pass '<base>..<tip>'." ;;
    esac
fi

# --- 4. both endpoints must exist as commits in THIS repo ------------------
# Skipped in raw rev-list mode: there is no "<a>..<b>" to split, and git itself
# errors out on an unknown revision there, which step 5 turns into an ERROR.
if [ "$rawmode" -eq 0 ]; then
    left=${range%%..*}
    right=${range#*..}
    right=${right#.}          # tolerate the A...B form
    [ -n "$left" ]  || die 2 "range '$range' has an empty left endpoint"
    [ -n "$right" ] || die 2 "range '$range' has an empty right endpoint"
    for ep in "$left" "$right"; do
        git rev-parse --verify --quiet "$ep^{commit}" >/dev/null 2>&1 \
            || die 2 "revision '$ep' (from range '$range') does not exist in the repository at $toplevel.
  Either you are in the wrong clone, or the commit was never fetched here."
    done
fi

# --- 5. enumerate the range, checking git's exit status --------------------
if [ "$rawmode" -eq 1 ]; then
    range="rev-list-args: $*"
    revs=$(git rev-list --max-count=$((MAX_PUSH_COMMITS + 1)) "$@" 2>/dev/null)
else
    revs=$(git rev-list --max-count=$((MAX_PUSH_COMMITS + 1)) "$range" 2>/dev/null)
fi
rl=$?
[ "$rl" -eq 0 ] || die 2 "git rev-list '$range' failed with status $rl"

if [ -z "$revs" ] && [ -n "$FALLBACK_TIPS" ]; then
    peeled_fallback_tips=""
    for fallback_tip in $FALLBACK_TIPS; do
        peeled_fallback=$(git rev-parse --verify --quiet "$fallback_tip^{commit}" 2>/dev/null) ||
            die 2 "fallback destination tip '$fallback_tip' is not a commit"
        peeled_fallback_tips="$peeled_fallback_tips $peeled_fallback"
    done
    revs=$(printf '%s\n' $peeled_fallback_tips | awk 'NF && !seen[$0]++')
fi

n=0
for rev in $revs; do n=$((n + 1)); done

[ "$n" -le "$MAX_PUSH_COMMITS" ] || die 2 "range exceeds the bounded limit of $MAX_PUSH_COMMITS commits.
  Split the push into smaller ranges; no over-limit history is accepted unchecked."

if [ "$n" -eq 0 ]; then
    if [ "$explicit" -eq 1 ]; then
        die 2 "explicit range '$range' resolved to 0 commits.
  You asked this guard to check a range and there is nothing in it. That is a
  caller error (wrong base, wrong tip, or endpoints already equal) — it is NOT
  a clean result, so it is reported as a failure rather than a pass."
    fi
    die 2 "the default range '$range' is empty; NO COMMITS WERE CHECKED.
  There is nothing to push, so there is also nothing this guard can vouch for.
  A run that checked nothing is ERROR by this convention, never a pass."
fi

# --- 6. the actual check ---------------------------------------------------
# Resolve commit trees in one Git process, deduplicate identical trees, then
# inspect each unique tree once. Rebases and metadata-only histories commonly
# contain repeated trees; per-commit `git ls-tree` made their cost needlessly
# linear in commit count even inside the hard safety bound.
tree_pairs=$(git show -s --format='%H %T' $revs 2>/dev/null)
tp_rc=$?
[ "$tp_rc" -eq 0 ] || die 2 "cannot resolve tree identities for outgoing commits"
trees=$(printf '%s\n' "$tree_pairs" | awk 'NF == 2 && !seen[$2]++ {print $2}')
[ -n "$trees" ] || die 2 "outgoing commits yielded no tree identities"
found=0
checked_trees=0
for tree in $trees; do
    checked_trees=$((checked_trees + 1))
    entries=$(git ls-tree --name-only "$tree" 2>/dev/null)
    lt=$?
    [ "$lt" -eq 0 ] || die 2 "git ls-tree failed (status $lt) on tree $tree — cannot verify this commit tree"
    if printf '%s\n' "$entries" | "$GREP" -q '^\.jjconflict'; then
        conflict_revs=$(printf '%s\n' "$tree_pairs" | awk -v tree="$tree" '$2 == tree {print $1}')
        for rev in $conflict_revs; do
            echo "CONFLICT COMMIT: $rev $(git log -1 --format=%s "$rev" 2>/dev/null)" >&2
        done
        found=1
    fi
done

if [ "$found" -ne 0 ]; then
    cat >&2 <<'EOF'

DO NOT PUSH. The commits above are jj conflict commits with no real source tree.

Resolve first, then re-check:
  jj resolve --list                 # what is conflicted
  jj log -r 'roots(conflicts())'    # resolve the ROOT, descendants auto-rebase
EOF
    VERDICT_EMITTED=1
    echo "$SELF: FAIL — conflict tree(s) found in $range ($n commit(s) checked)"
    exit 1
fi

VERDICT_EMITTED=1
echo "$SELF: PASS — $n commit(s), $checked_trees unique tree(s) checked in $range, 0 conflict trees (repo $toplevel)"
exit 0
