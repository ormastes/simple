#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

TARGET="${1:?usage: check-native-option-try-target-fail.shs TARGET [llvm|cranelift]}"
BACKEND="${2:-llvm}"
SIMPLE_BIN="${SIMPLE_BIN:-bin/simple}"
BUILD_DIR="${BUILD_DIR:-build/check/native-option-try-target-fail/$TARGET/$BACKEND}"
DIAGNOSTIC="native Option try operator requires the tagged Option ABI"

case "$BACKEND" in
    llvm|cranelift) ;;
    *) echo "unsupported backend: $BACKEND" >&2; exit 2 ;;
esac

mkdir -p "$BUILD_DIR"
checked=0
for fixture in \
    test/fixtures/compiler/native_option_try_annotated_loud.spl \
    test/fixtures/compiler/native_option_try_direct_loud.spl \
    test/fixtures/compiler/native_option_try_unresolved_method_loud.spl \
    test/fixtures/native_exists_struct_payload_field/native_exists_struct_payload_field.spl \
    test/fixtures/native_crossmodule_result_u8/main.spl; do
    case_id="$(basename "$fixture" .spl)"
    out="$BUILD_DIR/$case_id.o"
    log="$BUILD_DIR/$case_id.log"
    cache="$BUILD_DIR/$case_id-cache"
    rm -rf "$cache" "$out" "$log"

    status=0
    set +e
    if [ "$BACKEND" = cranelift ]; then
        env -u SIMPLE_BOOTSTRAP -u SIMPLE_RUNTIME_PATH SIMPLE_NO_STUB_FALLBACK=1 \
            "$SIMPLE_BIN" native-build --backend cranelift --emit-object \
            --target "$TARGET" --source test/fixtures --source src/lib --entry-closure \
            --entry "$fixture" --cache-dir "$cache" \
            --output "$out" >"$log" 2>&1
        status=$?
    else
        env -u SIMPLE_BOOTSTRAP -u SIMPLE_RUNTIME_PATH SIMPLE_NO_STUB_FALLBACK=1 \
            "$SIMPLE_BIN" native-build --emit-object --target "$TARGET" \
            --source test/fixtures --source src/lib --entry-closure --entry "$fixture" \
            --cache-dir "$cache" --output "$out" \
            >"$log" 2>&1
        status=$?
    fi
    set -e

    # Keep the filename for workflow wiring. The set now pins Option `?` plus
    # the shared cross-module Result/native target contract.
    [ "$status" -eq 0 ] || {
        echo "$fixture failed to compile for $TARGET" >&2
        tail -5 "$log" >&2
        exit 1
    }
    [ -s "$out" ] || { echo "$case_id produced no object: $out" >&2; exit 1; }
    if grep -qF "$DIAGNOSTIC" "$log"; then
        echo "$case_id regressed to the retired diagnostic: $DIAGNOSTIC" >&2
        exit 1
    fi

    # rc=0 + a non-empty .o is not proof the tagged Option `?` ABI actually
    # lowered any code for this fixture -- native-build can report success
    # for a structurally empty (zero defined-FUNC) artifact, see
    # doc/08_tracking/bug/native_build_reports_success_for_functionless_artifact_2026-08-10.md.
    # Reuse the existing FUNC-symbol helper to read the object itself rather
    # than trusting the exit code.
    if ! sh "$ROOT_DIR/scripts/check/check-native-build-artifact-has-functions.shs" "$out" >"$BUILD_DIR/$case_id.func-check.log" 2>&1; then
        echo "$case_id: object has no defined FUNC symbols (structurally empty despite rc=0)" >&2
        cat "$BUILD_DIR/$case_id.func-check.log" >&2
        exit 1
    fi
    checked=$((checked + 1))
done

if [ "$checked" -eq 0 ]; then
    echo "ERROR — nothing was checked (0 fixtures processed)" >&2
    exit 2
fi
echo "PASS — $checked fixture(s) checked for target=$TARGET backend=$BACKEND: compile clean, no retired ABI diagnostic, every object carries defined FUNC symbols"
