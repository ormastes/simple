#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
contract=${RV32_ABI_CONTRACT:-"$repo_root/src/os/kernel/arch/riscv32/privilege_transition_abi.spl"}
architecture=${RV32_ABI_ARCHITECTURE:-"$repo_root/doc/04_architecture/rv32_privilege_transition_abi.md"}
entropy=${RV32_ENTROPY_CONTRACT:-"$repo_root/src/os/kernel/arch/riscv32/secure_entropy.spl"}
rng=${RV32_RNG_OWNER:-"$repo_root/src/os/drivers/virtio/virtio_rng_mmio.spl"}
qemu_contract=${RV32_QEMU_CONTRACT:-"$repo_root/src/os/qemu_systest_contract.spl"}

require_literal() {
    file=$1
    literal=$2
    if ! grep -Fq -- "$literal" "$file"; then
        echo "FAIL rv32 privilege ABI: missing '$literal' in $file" >&2
        return 1
    fi
}

check_contract() {
    require_literal "$contract" 'val RV32_PRIVILEGE_ABI_VERSION: u32 = 0x00010002'
    require_literal "$contract" 'val RV32_TRAP_FRAME_ALIGNMENT: u32 = 16'
    require_literal "$contract" 'val RV32_TRAP_FRAME_SIZE: u32 = 160'
    require_literal "$contract" 'val RV32_TRAP_SEPC_OFFSET: u32 = 124'
    require_literal "$contract" 'val RV32_TRAP_SUPERVISOR_SP_OFFSET: u32 = 140'
    require_literal "$contract" 'val RV32_TRAP_INTERRUPTED_SATP_OFFSET: u32 = 144'
    require_literal "$contract" 'val RV32_IMAFD_PRIVILEGE_ABI_VERSION: u32 = 2'
    require_literal "$contract" 'val RV32_IMAFD_TRAP_FRAME_SIZE: u32 = 416'
    require_literal "$contract" 'val RV32_IMAFD_CALL_ABI: text = "ilp32d"'
    require_literal "$contract" 'val RV32_SCAUSE_USER_ECALL: u32 = 8'
    require_literal "$contract" 'val RV32_SATP_ASID_MASK: u32 = 0x1ff'
    require_literal "$contract" 'task_generation: u64'
    require_literal "$contract" 'address_space_generation: u64'
    require_literal "$contract" 'nonce_token: u64'
    require_literal "$contract" 'val RV32_TRAP_ANCHOR_SIZE: u32 = 16'
    require_literal "$contract" 'val RV32_TRAP_ANCHOR_TOKEN_OFFSET: u32 = 4'
    require_literal "$contract" 'val RV32_TRAP_ANCHOR_HART_ID_OFFSET: u32 = 8'
    require_literal "$contract" 'val RV32_TRAP_ANCHOR_NESTING_OFFSET: u32 = 12'
    require_literal "$contract" 'struct Rv32TrapAnchorV1:'
    require_literal "$contract" 'hart_id: u32'
    require_literal "$contract" 'auth_tag: u64'
    require_literal "$contract" 'val RV32_TOKEN_MAC_DOMAIN_BYTES: u32 = 16'
    require_literal "$contract" 'val RV32_TOKEN_MAC_KEY_BYTES: u32 = 16'
    require_literal "$contract" 'val RV32_TOKEN_MAC_INPUT_BYTES: u32 = 80'
    require_literal "$contract" 'val RV32_TOKEN_MAC_ALGORITHM: text = "SipHash-2-4"'
    require_literal "$contract" 'val RV32_TOKEN_MAC_KAT_EMPTY: u64 = 0x726fdb47dd0e0e31'
    require_literal "$contract" 'extern fn rt_rv32_token_siphash24('
    require_literal "$contract" 'val RV32_TRAP_DISPOSITION_RETURN_USER: i32 = 0'
    require_literal "$contract" 'val RV32_TRAP_DISPOSITION_RESUME_SUPERVISOR: i32 = 1'
    require_literal "$contract" 'val RV32_TRAP_DISPOSITION_REJECT: i32 = -1'
    require_literal "$contract" 'rv32_dispatch_user_trap_scalar_v12'
    if sed -n '/struct Rv32PrivilegeTrapFrameV1:/,/enum Rv32ExecutionTokenStateV1:/p' \
            "$contract" | grep -Eiq 'fp_|fcsr|float'; then
        echo 'FAIL rv32 privilege ABI: v1 frame contains FP state' >&2
        return 1
    fi
    require_literal "$architecture" 'Prepared -> Entered -> Exited -> Reaped'
    require_literal "$architecture" 'RV32IMAC'
    require_literal "$architecture" 'Admission requires `sstatus.FS=Off`'
    require_literal "$architecture" 'Publishing an anchor is a release operation'
    require_literal "$architecture" 'Trap lookup acquires it'
    require_literal "$architecture" 'All integers are unsigned little-endian.'
    require_literal "$architecture" 'accumulated'
    require_literal "$architecture" 'XOR with no tag-dependent branch.'
    require_literal "$architecture" 'An Entered token cannot migrate.'
    require_literal "$architecture" 'No enum or aggregate crosses the assembly boundary.'
    require_literal "$entropy" 'val RV32_SECURE_ENTROPY_BYTES: u64 = 16'
    require_literal "$entropy" 'VirtioRngMmio'
    require_literal "$entropy" 'AuthenticatedBootInjection'
    require_literal "$entropy" 'capability_present: false'
    require_literal "$entropy" 'provider_ready: false'
    require_literal "$entropy" 'provenance: Rv32SecureEntropyProvenance.Unavailable'
    if grep -Fq 'entropy_seed_u64' "$entropy"; then
        echo 'FAIL rv32 privilege ABI: insecure early mixer referenced' >&2
        return 1
    fi
    require_literal "$rng" 'val VIRTIO_RNG_DEVICE_ID: u32 = 4u32'
    require_literal "$rng" 'val VIRTIO_RNG_VERSION_1: u32 = 1u32'
    require_literal "$rng" 'val VIRTIO_RNG_REQUIRED_BYTES: u32 = 16u32'
    require_literal "$rng" 'val VIRTIO_RNG_MAX_COMPLETIONS: u32 = 16u32'
    require_literal "$rng" 'val VIRTIO_RNG_MAX_POLLS_PER_COMPLETION: u32 = 100000u32'
    require_literal "$rng" 'rt_memory_barrier()'
    require_literal "$rng" 'if used_len == 0u32 or used_len > VIRTIO_RNG_REQUIRED_BYTES - received:'
    require_literal "$rng" 'self.shutdown()'
    require_literal "$rng" 'val RV32_QEMU_VIRTIO_MMIO_START: u64 = 0x10001000u64'
    require_literal "$rng" 'val RV32_QEMU_VIRTIO_MMIO_SLOTS: u32 = 8u32'
    require_literal "$rng" 'if owner.ready: return owner'
    require_literal "$rng" 'fn rv32_virtio_rng_boot_key16(hart_id: u32)'
    require_literal "$rng" 'val result = owner.read_key16()'
    require_literal "$rng" 'owner.shutdown()'
    require_literal "$qemu_contract" 'rng-random,id=rv32rng,filename=/dev/urandom'
    require_literal "$qemu_contract" 'virtio-rng-device,rng=rv32rng'
    require_literal "$architecture" 'address_space_generation'
    require_literal "$architecture" 'Assembly and dispatcher code do not yet exist.'
}

if [ "${1:-}" = "--self-test" ]; then
    fixture=$(mktemp -d)
    trap 'rm -rf "$fixture"' EXIT HUP INT TERM
    cp "$contract" "$fixture/contract.spl"
    cp "$architecture" "$fixture/architecture.md"
    cp "$rng" "$fixture/rng.spl"
    cp "$qemu_contract" "$fixture/qemu.spl"
    RV32_ABI_CONTRACT="$fixture/contract.spl" \
        RV32_ABI_ARCHITECTURE="$fixture/architecture.md" \
        RV32_RNG_OWNER="$fixture/rng.spl" RV32_QEMU_CONTRACT="$fixture/qemu.spl" "$0"
    sed 's/RV32_TRAP_FRAME_SIZE: u32 = 160/RV32_TRAP_FRAME_SIZE: u32 = 156/' \
        "$contract" > "$fixture/contract.spl"
    if RV32_ABI_CONTRACT="$fixture/contract.spl" \
            RV32_ABI_ARCHITECTURE="$fixture/architecture.md" "$0" >/dev/null 2>&1; then
        echo 'FAIL rv32 privilege ABI: frame-size sabotage passed' >&2
        exit 1
    fi
    cp "$contract" "$fixture/contract.spl"
    cp "$rng" "$fixture/rng.spl"
    sed 's/if owner.ready: return owner/return owner/' "$rng" > "$fixture/rng.spl"
    if RV32_ABI_CONTRACT="$fixture/contract.spl" RV32_RNG_OWNER="$fixture/rng.spl" \
            RV32_QEMU_CONTRACT="$fixture/qemu.spl" \
            RV32_ABI_ARCHITECTURE="$fixture/architecture.md" "$0" >/dev/null 2>&1; then
        echo 'FAIL rv32 privilege ABI: pre-negotiation capability sabotage passed' >&2
        exit 1
    fi
    cp "$contract" "$fixture/contract.spl"
    sed 's/VIRTIO_RNG_MAX_COMPLETIONS: u32 = 16u32/VIRTIO_RNG_MAX_COMPLETIONS: u32 = 0u32/' \
        "$rng" > "$fixture/rng.spl"
    if RV32_ABI_CONTRACT="$fixture/contract.spl" \
            RV32_ABI_ARCHITECTURE="$fixture/architecture.md" \
            RV32_RNG_OWNER="$fixture/rng.spl" "$0" >/dev/null 2>&1; then
        echo 'FAIL rv32 privilege ABI: unbounded-owner sabotage passed' >&2
        exit 1
    fi
    cp "$contract" "$fixture/contract.spl"
    sed 's/RV32_TOKEN_MAC_INPUT_BYTES: u32 = 80/RV32_TOKEN_MAC_INPUT_BYTES: u32 = 76/' \
        "$contract" > "$fixture/contract.spl"
    if RV32_ABI_CONTRACT="$fixture/contract.spl" \
            RV32_ABI_ARCHITECTURE="$fixture/architecture.md" "$0" >/dev/null 2>&1; then
        echo 'FAIL rv32 privilege ABI: MAC-length sabotage passed' >&2
        exit 1
    fi
    cp "$contract" "$fixture/contract.spl"
    sed 's/hart_id: u32/owner_cpu: u32/g' "$contract" > "$fixture/contract.spl"
    if RV32_ABI_CONTRACT="$fixture/contract.spl" \
            RV32_ABI_ARCHITECTURE="$fixture/architecture.md" "$0" >/dev/null 2>&1; then
        echo 'FAIL rv32 privilege ABI: hart-binding sabotage passed' >&2
        exit 1
    fi
    cp "$contract" "$fixture/contract.spl"
    sed '/struct Rv32PrivilegeTrapFrameV1:/a\    forbidden_fp_state: [u64; 32]' \
        "$contract" > "$fixture/contract.spl"
    if RV32_ABI_CONTRACT="$fixture/contract.spl" \
            RV32_ABI_ARCHITECTURE="$fixture/architecture.md" "$0" >/dev/null 2>&1; then
        echo 'FAIL rv32 privilege ABI: v1 FP-field sabotage passed' >&2
        exit 1
    fi
    cp "$contract" "$fixture/contract.spl"
    sed 's/address_space_generation/space_generation/g' "$architecture" > "$fixture/architecture.md"
    if RV32_ABI_CONTRACT="$fixture/contract.spl" \
            RV32_ABI_ARCHITECTURE="$fixture/architecture.md" "$0" >/dev/null 2>&1; then
        echo 'FAIL rv32 privilege ABI: binding sabotage passed' >&2
        exit 1
    fi
    echo 'PASS rv32 privilege ABI sabotage self-test'
    exit 0
fi

check_contract
echo 'PASS rv32 privilege ABI static contract'
