#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

BACKEND="$(printf '%s' "${GPU_2D_LIVE_BACKEND:-}" | tr '[:upper:]' '[:lower:]')"
case "$BACKEND" in
    vulkan|metal) ;;
    *) echo "macOS GPU 2D live evidence: FAIL (invalid-backend)" >&2; exit 1 ;;
esac
PREFIX="macos_${BACKEND}_2d_live"
BACKEND_TITLE="$(printf '%s' "$BACKEND" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
BUILD_DIR="${BUILD_DIR:-build/tmp/macos_${BACKEND}_2d_live_evidence}"
REPORT_PATH="${REPORT_PATH:-doc/09_report/macos_${BACKEND}_2d_live_evidence_$(date -u +%F).md}"
HARNESS="$ROOT_DIR/test/02_integration/rendering/macos_${BACKEND}_2d_live_harness.spl"
SHARED_HARNESS="$ROOT_DIR/test/02_integration/rendering/macos_gpu_2d_live_harness.spl"
FIXTURE_SOURCE="$ROOT_DIR/test/02_integration/rendering/macos_gpu_2d_draw_ir_event_fixture.spl"
BACKEND_SOURCE="$ROOT_DIR/src/lib/gc_async_mut/gpu/engine2d/backend_${BACKEND}.spl"
CAPTURE_PPM="$BUILD_DIR/${BACKEND}_3840x2160_300dpi.ppm"
CAPTURE_PNG="$BUILD_DIR/${BACKEND}_3840x2160_300dpi.png"
WINDOW_BEFORE_PNG="$BUILD_DIR/window_before.png"
WINDOW_AFTER_PNG="$BUILD_DIR/window_after.png"
RECEIPT="$BUILD_DIR/runtime_receipt.env"
READY="$BUILD_DIR/ready.env"
EVIDENCE="$BUILD_DIR/evidence.env"
LAUNCH_OUT="$BUILD_DIR/launch.out"
LAUNCH_ERR="$BUILD_DIR/launch.err"
WINDOW_RECORD="$BUILD_DIR/window.env"
TIMEOUT_SECS="${GPU_2D_LIVE_TIMEOUT_SECS:-420}"
BUILD_HELPER="$ROOT_DIR/scripts/check/build-macos-gpu-2d-live-native.shs"
TRUSTED_BUILD_MANIFEST="$ROOT_DIR/build/macos_gpu_2d_live_native/$BACKEND/trusted-build.env"
SELECTED_DRIVER_PATH=""
SELECTED_DRIVER_KIND="trusted-self-hosted-native-output"
SPL_WINIT_LIB="$ROOT_DIR/build/sffi/libspl_winit.dylib"
SIMPLE_RUNTIME_DYLIB="$ROOT_DIR/build/sffi/libsimple_runtime_wm.dylib"
SIMPLE_RUNTIME_C_DYLIB="$ROOT_DIR/build/sffi/libsimple_runtime_c_wm.dylib"
MOLTENVK_ICD_PATH=""
MOLTENVK_ICD_SHA256=""
MOLTENVK_LIBRARY_PATH=""
MOLTENVK_LIBRARY_SHA256=""
MOLTENVK_PREFLIGHT_STATUS="not-applicable"
MOLTENVK_VULKANINFO_PATH=""
MOLTENVK_VULKANINFO_SHA256=""
MOLTENVK_VULKANINFO_OUTPUT_SHA256=""
MOLTENVK_DEVICE_NAME=""
MOLTENVK_DRIVER_NAME=""
VULKAN_PLIST_ENV=""
LAUNCH_DYLD_LIBRARY_PATH="$ROOT_DIR/build/sffi:${DYLD_LIBRARY_PATH:-/opt/homebrew/lib}"

mkdir -p "$BUILD_DIR" "$(dirname -- "$REPORT_PATH")"
BUILD_DIR_ABS="$(CDPATH= cd -- "$BUILD_DIR" && pwd)"
CAPTURE_PPM="$BUILD_DIR_ABS/$(basename -- "$CAPTURE_PPM")"
CAPTURE_PNG="$BUILD_DIR_ABS/$(basename -- "$CAPTURE_PNG")"
WINDOW_BEFORE_PNG="$BUILD_DIR_ABS/$(basename -- "$WINDOW_BEFORE_PNG")"
WINDOW_AFTER_PNG="$BUILD_DIR_ABS/$(basename -- "$WINDOW_AFTER_PNG")"
RECEIPT="$BUILD_DIR_ABS/$(basename -- "$RECEIPT")"
READY="$BUILD_DIR_ABS/$(basename -- "$READY")"
EVIDENCE="$BUILD_DIR_ABS/$(basename -- "$EVIDENCE")"
LAUNCH_OUT="$BUILD_DIR_ABS/$(basename -- "$LAUNCH_OUT")"
LAUNCH_ERR="$BUILD_DIR_ABS/$(basename -- "$LAUNCH_ERR")"
WINDOW_RECORD="$BUILD_DIR_ABS/$(basename -- "$WINDOW_RECORD")"
rm -f "$CAPTURE_PPM" "$CAPTURE_PNG" "$WINDOW_BEFORE_PNG" \
    "$WINDOW_AFTER_PNG" "$RECEIPT" "$READY" "$EVIDENCE" \
    "$LAUNCH_OUT" "$LAUNCH_ERR" "$WINDOW_RECORD"

app_pid=""
app_dir=""
app_executable=""

value_of() {
    sed -n "s/^${1}=//p" "$2" | tail -n 1
}

positive_integer() {
    case "${1:-}" in
        ""|0|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

sha256_valid() {
    case "${1:-}" in
        *[!0-9a-f]*|"") return 1 ;;
        *) [ "${#1}" -eq 64 ] ;;
    esac
}

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        return 1
    fi
}

sha256_stream() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | awk '{print $1}'
    else
        return 1
    fi
}

canonical_directory() {
    [ -d "$1" ] || return 1
    (CDPATH= cd -- "$1" && pwd -P)
}

driver_has_runtime_provider_rpath() {
    expected_runtime_dir="$(
        canonical_directory "$(dirname -- "$SIMPLE_RUNTIME_DYLIB")"
    )" || return 1
    runtime_rpaths="$(
        otool -l "$SELECTED_DRIVER_PATH" |
        awk '
            $1 == "cmd" && $2 == "LC_RPATH" { in_rpath = 1; next }
            in_rpath && $1 == "path" { print $2; in_rpath = 0 }
        ' |
        sed '/^$/d'
    )" || return 1
    [ -n "$runtime_rpaths" ] || return 1
    while IFS= read -r runtime_rpath; do
        canonical_runtime_dir="$(
            canonical_directory "$runtime_rpath" 2>/dev/null
        )" || continue
        [ "$canonical_runtime_dir" = "$expected_runtime_dir" ] && return 0
    done <<EOF
$runtime_rpaths
EOF
    return 1
}

pid_matches_executable() {
    target_pid="$1"
    target_executable="$2"
    command_line="$(ps -p "$target_pid" -o command= 2>/dev/null || true)"
    [ "$command_line" = "$target_executable" ] ||
        [ "${command_line#"$target_executable "}" != "$command_line" ]
}

cleanup() {
    if [ -n "$app_pid" ] && [ -n "$app_executable" ] &&
            pid_matches_executable "$app_pid" "$app_executable"; then
        osascript - "$app_pid" >/dev/null 2>&1 <<'OSA' || true
on run argv
  set targetPid to (item 1 of argv) as integer
  tell application "System Events"
    repeat with proc in (processes whose unix id is targetPid)
      tell proc
        set frontmost to true
        keystroke "q"
      end tell
    end repeat
  end tell
end run
OSA
        if kill -0 "$app_pid" 2>/dev/null; then
            kill -TERM "$app_pid" 2>/dev/null || true
        fi
    fi
    app_pid=""
    if [ -n "$app_dir" ] && [ -d "$app_dir" ]; then
        rm -rf "$app_dir"
    fi
}
trap cleanup EXIT HUP INT TERM

write_report() {
    status="$1"
    reason="$2"
    {
        echo "# macOS $BACKEND_TITLE 2D Live Evidence"
        echo
        echo "- status: $status"
        echo "- reason: $reason"
        echo "- selected driver: \`$SELECTED_DRIVER_PATH\`"
        echo "- selected driver kind: $SELECTED_DRIVER_KIND"
        echo "- trusted build manifest: \`$TRUSTED_BUILD_MANIFEST\`"
        if [ "$BACKEND" = vulkan ]; then
            echo "- MoltenVK ICD: \`$MOLTENVK_ICD_PATH\`"
            echo "- MoltenVK ICD SHA-256: \`$MOLTENVK_ICD_SHA256\`"
            echo "- MoltenVK library: \`$MOLTENVK_LIBRARY_PATH\`"
            echo "- MoltenVK library SHA-256: \`$MOLTENVK_LIBRARY_SHA256\`"
            echo "- MoltenVK preflight: $MOLTENVK_PREFLIGHT_STATUS"
            if [ "$MOLTENVK_PREFLIGHT_STATUS" = device-driver-verified ]; then
                echo "- Vulkan device: $MOLTENVK_DEVICE_NAME"
                echo "- Vulkan driver: $MOLTENVK_DRIVER_NAME"
            fi
        fi
        echo "- runtime receipt: \`$RECEIPT\`"
        echo "- 4K/300-DPI framebuffer: \`$CAPTURE_PNG\`"
        echo "- exact window before input: \`$WINDOW_BEFORE_PNG\`"
        echo "- exact window after input: \`$WINDOW_AFTER_PNG\`"
        echo "- launcher stdout: \`$LAUNCH_OUT\`"
        echo "- launcher stderr: \`$LAUNCH_ERR\`"
        if [ -f "$EVIDENCE" ]; then
            echo
            echo "## Validated evidence"
            echo
            echo '```text'
            cat "$EVIDENCE"
            echo '```'
        fi
        if [ -f "$RECEIPT" ]; then
            echo
            echo "## Runtime receipt"
            echo
            echo '```text'
            cat "$RECEIPT"
            echo '```'
        fi
    } >"$REPORT_PATH"
}

fail() {
    reason="$1"
    {
        echo "${PREFIX}_status=fail"
        echo "${PREFIX}_reason=$reason"
        echo "${PREFIX}_driver_kind=$SELECTED_DRIVER_KIND"
        echo "${PREFIX}_driver_path=$SELECTED_DRIVER_PATH"
        echo "${PREFIX}_trusted_build_manifest=$TRUSTED_BUILD_MANIFEST"
        if [ "$BACKEND" = vulkan ]; then
            echo "${PREFIX}_moltenvk_icd_path=$MOLTENVK_ICD_PATH"
            echo "${PREFIX}_moltenvk_icd_sha256=$MOLTENVK_ICD_SHA256"
            echo "${PREFIX}_moltenvk_library_path=$MOLTENVK_LIBRARY_PATH"
            echo "${PREFIX}_moltenvk_library_sha256=$MOLTENVK_LIBRARY_SHA256"
            echo "${PREFIX}_moltenvk_preflight_status=$MOLTENVK_PREFLIGHT_STATUS"
        fi
    } >"$EVIDENCE"
    write_report fail "$reason"
    echo "macOS $BACKEND_TITLE 2D live evidence: FAIL ($reason)" >&2
    exit 1
}

require_launched_process() {
    if ! kill -0 "$app_pid" 2>/dev/null; then
        # The harness writes a stage-specific failure receipt immediately
        # before returning.  LaunchServices can reap the process before that
        # small file becomes visible to this polling shell, so allow only a
        # short, bounded publication grace period.  A missing receipt after
        # the grace period remains a hard launched-process failure.
        receipt_grace=0
        while [ "$receipt_grace" -lt 10 ] && [ ! -s "$RECEIPT" ]; do
            sleep 0.1
            receipt_grace=$((receipt_grace + 1))
        done
        if [ -s "$RECEIPT" ] &&
                [ "$(value_of gpu_2d_live_status "$RECEIPT")" = "fail" ]; then
            receipt_reason="$(value_of gpu_2d_live_reason "$RECEIPT")"
            [ -n "$receipt_reason" ] ||
                receipt_reason="runtime-failure-receipt-without-reason"
            fail "runtime-$receipt_reason"
        fi
        fail "launched-process-missing"
    fi
    pid_matches_executable "$app_pid" "$app_executable" ||
        fail "launched-process-identity-mismatch"
}

find_exact_app_pid() {
    ps -axo pid=,command= | awk -v executable="$app_executable" '
        {
            pid = $1
            $1 = ""
            sub(/^[[:space:]]+/, "")
            if ($0 == executable || index($0, executable " ") == 1) {
                print pid
                exit
            }
        }
    '
}

file_bytes() {
    if [ -f "$1" ]; then wc -c <"$1" | tr -d ' '; else echo 0; fi
}

file_cksum() {
    if [ -f "$1" ]; then cksum "$1" | awk '{print $1}'; else echo 0; fi
}

run_bounded_vulkaninfo() {
    vulkaninfo_out="$1"
    vulkaninfo_err="$2"
    vulkaninfo_timeout="$3"
    vulkaninfo_grace="$4"
    vulkaninfo_tool="$5"
    vulkaninfo_icd="$6"

    # Job control makes the probe leader a process-group leader on macOS. Both
    # timeout signals target the whole group so helper/driver descendants
    # cannot outlive the evidence command.
    set -m
    /usr/bin/env \
        -u VK_ICD_FILENAMES -u VK_DRIVER_FILES -u VK_ADD_DRIVER_FILES \
        -u VK_LAYER_PATH -u VK_ADD_LAYER_PATH -u VK_INSTANCE_LAYERS \
        -u VK_LOADER_DRIVERS_SELECT -u VK_LOADER_DRIVERS_DISABLE \
        -u VK_LOADER_LAYERS_ENABLE -u VK_LOADER_LAYERS_DISABLE \
        -u VK_LOADER_LAYERS_ALLOW \
        LC_ALL=C VK_ICD_FILENAMES="$vulkaninfo_icd" \
        "$vulkaninfo_tool" --summary \
        >"$vulkaninfo_out" 2>"$vulkaninfo_err" &
    vulkaninfo_pid=$!
    set +m
    vulkaninfo_deadline=$(($(date +%s) + vulkaninfo_timeout))
    vulkaninfo_timed_out=0

    while kill -0 "-$vulkaninfo_pid" 2>/dev/null; do
        [ "$(date +%s)" -lt "$vulkaninfo_deadline" ] || {
            vulkaninfo_timed_out=1
            break
        }
        sleep 0.1
    done
    if [ "$vulkaninfo_timed_out" = 1 ]; then
        kill -TERM "-$vulkaninfo_pid" 2>/dev/null || true
        vulkaninfo_grace_deadline=$(($(date +%s) + vulkaninfo_grace))
        while kill -0 "-$vulkaninfo_pid" 2>/dev/null &&
                [ "$(date +%s)" -lt "$vulkaninfo_grace_deadline" ]; do
            sleep 0.1
        done
        if kill -0 "-$vulkaninfo_pid" 2>/dev/null; then
            kill -KILL "-$vulkaninfo_pid" 2>/dev/null || true
        fi
    fi

    set +e
    wait "$vulkaninfo_pid" 2>>"$vulkaninfo_err"
    vulkaninfo_wait_status=$?
    set -e
    vulkaninfo_cleanup_deadline=$(($(date +%s) + 2))
    while kill -0 "-$vulkaninfo_pid" 2>/dev/null &&
            [ "$(date +%s)" -lt "$vulkaninfo_cleanup_deadline" ]; do
        kill -KILL "-$vulkaninfo_pid" 2>/dev/null || true
        sleep 0.1
    done
    kill -0 "-$vulkaninfo_pid" 2>/dev/null &&
        fail "canonical-moltenvk-vulkaninfo-descendant-survived"
    [ "$vulkaninfo_timed_out" = 0 ] || return 124
    return "$vulkaninfo_wait_status"
}

[ "$(uname -s)" = "Darwin" ] || fail "requires-macos"
[ -f "$HARNESS" ] || fail "harness-missing"
[ -f "$SHARED_HARNESS" ] || fail "shared-harness-missing"
[ -f "$FIXTURE_SOURCE" ] || fail "shared-scene-fixture-missing"
[ -f "$BACKEND_SOURCE" ] || fail "backend-source-missing"
[ -x "$BUILD_HELPER" ] || fail "trusted-native-build-helper-missing"
[ -z "${GPU_2D_LIVE_NATIVE_BIN:-}" ] || fail "arbitrary-native-driver-supplied"
[ -z "${GPU_2D_LIVE_WINIT_LIB:-}" ] ||
    fail "arbitrary-winit-provider-supplied"
[ -z "${GPU_2D_LIVE_RUNTIME_DYLIB:-}" ] ||
    fail "arbitrary-runtime-provider-supplied"
[ -z "${GPU_2D_LIVE_RUNTIME_C_DYLIB:-}" ] ||
    fail "arbitrary-runtime-c-provider-supplied"
command -v osascript >/dev/null 2>&1 || fail "osascript-missing"
command -v screencapture >/dev/null 2>&1 || fail "screencapture-missing"
command -v cliclick >/dev/null 2>&1 || fail "cliclick-missing"
command -v xcrun >/dev/null 2>&1 || fail "xcrun-missing"
command -v sips >/dev/null 2>&1 || fail "sips-missing"

# The live scene's 24pt/300-DPI vector-text proof deliberately uses the
# registry-pinned Bungee face. Fail before allocating a trusted driver or
# opening a window when a sparse/source checkout omitted that licensed asset.
PINNED_FONT_PATH="$ROOT_DIR/assets/fonts/google-fonts/ofl/bungee/Bungee-Regular.ttf"
PINNED_FONT_BYTES=118996
PINNED_FONT_SHA256="c4f5361ce120af3e6b9156d0bf379fa19cda2ea0cd18ac01fd99596c6bf66e3f"
[ -f "$PINNED_FONT_PATH" ] || fail "pinned-vector-font-missing"
[ "$(file_bytes "$PINNED_FONT_PATH")" = "$PINNED_FONT_BYTES" ] ||
    fail "pinned-vector-font-size-mismatch"
[ "$(shasum -a 256 "$PINNED_FONT_PATH" | awk '{print $1}')" = "$PINNED_FONT_SHA256" ] ||
    fail "pinned-vector-font-sha256-mismatch"

if [ "$BACKEND" = vulkan ]; then
    [ -z "${VK_ICD_FILENAMES+x}" ] || fail "arbitrary-vulkan-icd-supplied"
    [ -z "${VK_DRIVER_FILES+x}" ] || fail "arbitrary-vulkan-driver-files-supplied"
    [ -z "${VK_ADD_DRIVER_FILES+x}" ] ||
        fail "arbitrary-vulkan-add-driver-files-supplied"
    [ -z "${VK_LAYER_PATH+x}" ] || fail "arbitrary-vulkan-layer-path-supplied"
    [ -z "${VK_ADD_LAYER_PATH+x}" ] ||
        fail "arbitrary-vulkan-add-layer-path-supplied"
    [ -z "${VK_INSTANCE_LAYERS+x}" ] ||
        fail "arbitrary-vulkan-instance-layers-supplied"
    [ -z "${VK_LOADER_DRIVERS_SELECT+x}" ] ||
        fail "arbitrary-vulkan-loader-driver-select-supplied"
    [ -z "${VK_LOADER_DRIVERS_DISABLE+x}" ] ||
        fail "arbitrary-vulkan-loader-driver-disable-supplied"
    [ -z "${VK_LOADER_LAYERS_ENABLE+x}" ] ||
        fail "arbitrary-vulkan-loader-layer-enable-supplied"
    [ -z "${VK_LOADER_LAYERS_DISABLE+x}" ] ||
        fail "arbitrary-vulkan-loader-layer-disable-supplied"
    [ -z "${VK_LOADER_LAYERS_ALLOW+x}" ] ||
        fail "arbitrary-vulkan-loader-layer-allow-supplied"
    [ -z "${DYLD_INSERT_LIBRARIES+x}" ] ||
        fail "arbitrary-dyld-insert-libraries-supplied"
    [ -z "${DYLD_FRAMEWORK_PATH+x}" ] ||
        fail "arbitrary-dyld-framework-path-supplied"
    [ -z "${DYLD_FALLBACK_LIBRARY_PATH+x}" ] ||
        fail "arbitrary-dyld-fallback-library-path-supplied"
    MOLTENVK_ICD_PATH="/opt/homebrew/etc/vulkan/icd.d/MoltenVK_icd.json"
    [ -f "$MOLTENVK_ICD_PATH" ] || fail "canonical-moltenvk-icd-missing"
    MOLTENVK_ICD_PATH="$(
        MOLTENVK_ICD_DIR="$(dirname -- "$MOLTENVK_ICD_PATH")"
        CDPATH= cd -- "$MOLTENVK_ICD_DIR" &&
            printf '%s/%s\n' "$(pwd -P)" "$(basename -- "$MOLTENVK_ICD_PATH")"
    )" || fail "canonical-moltenvk-icd-unresolvable"
    [ "$MOLTENVK_ICD_PATH" = \
        "/opt/homebrew/etc/vulkan/icd.d/MoltenVK_icd.json" ] ||
        fail "canonical-moltenvk-icd-path-mismatch"
    MOLTENVK_ICD_SHA256="$(sha256_file "$MOLTENVK_ICD_PATH")"
    sha256_valid "$MOLTENVK_ICD_SHA256" ||
        fail "canonical-moltenvk-icd-sha256-invalid"
    moltenvk_library_reference="$(
        /usr/bin/plutil -extract ICD.library_path raw -o - \
            "$MOLTENVK_ICD_PATH" 2>/dev/null
    )" || fail "canonical-moltenvk-icd-library-reference-invalid"
    [ -n "$moltenvk_library_reference" ] ||
        fail "canonical-moltenvk-icd-library-reference-missing"
    case "$moltenvk_library_reference" in
        /*)
            moltenvk_library_dir="$(dirname -- "$moltenvk_library_reference")"
            ;;
        *)
            moltenvk_library_dir="$(dirname -- "$MOLTENVK_ICD_PATH")/$(dirname -- "$moltenvk_library_reference")"
            ;;
    esac
    MOLTENVK_LIBRARY_PATH="$(
        CDPATH= cd -- "$moltenvk_library_dir" &&
            printf '%s/%s\n' "$(pwd -P)" \
                "$(basename -- "$moltenvk_library_reference")"
    )" || fail "canonical-moltenvk-library-unresolvable"
    [ "$(basename -- "$MOLTENVK_LIBRARY_PATH")" = "libMoltenVK.dylib" ] ||
        fail "canonical-moltenvk-library-name-mismatch"
    [ -f "$MOLTENVK_LIBRARY_PATH" ] ||
        fail "canonical-moltenvk-library-missing"
    MOLTENVK_LIBRARY_SHA256="$(sha256_file "$MOLTENVK_LIBRARY_PATH")"
    sha256_valid "$MOLTENVK_LIBRARY_SHA256" ||
        fail "canonical-moltenvk-library-sha256-invalid"
    LAUNCH_DYLD_LIBRARY_PATH="$ROOT_DIR/build/sffi:/opt/homebrew/lib"
    # Do not serialize cleared aliases as empty variables.  The Vulkan loader
    # treats VK_DRIVER_FILES as authoritative even when its value is empty,
    # which would override and disable the pinned canonical ICD below.
    VULKAN_PLIST_ENV="    <key>VK_ICD_FILENAMES</key><string>$MOLTENVK_ICD_PATH</string>"

    # Probe only the canonical Homebrew tool and pin it to the exact ICD above.
    # The loader/library hashes remain the authoritative identity when the
    # optional bounded summary cannot publish both device and driver names.
    MOLTENVK_PREFLIGHT_STATUS="loader-only"
    MOLTENVK_VULKANINFO_PATH="/opt/homebrew/bin/vulkaninfo"
    if [ -x "$MOLTENVK_VULKANINFO_PATH" ]; then
        MOLTENVK_VULKANINFO_SHA256="$(
            sha256_file "$MOLTENVK_VULKANINFO_PATH"
        )"
        vulkaninfo_out="$BUILD_DIR_ABS/moltenvk-vulkaninfo-summary.out"
        vulkaninfo_err="$BUILD_DIR_ABS/moltenvk-vulkaninfo-summary.err"
        rm -f "$vulkaninfo_out" "$vulkaninfo_err"
        if run_bounded_vulkaninfo "$vulkaninfo_out" "$vulkaninfo_err" \
                15 2 "$MOLTENVK_VULKANINFO_PATH" "$MOLTENVK_ICD_PATH" &&
                [ -s "$vulkaninfo_out" ]; then
            MOLTENVK_VULKANINFO_OUTPUT_SHA256="$(
                sha256_file "$vulkaninfo_out"
            )"
            MOLTENVK_DEVICE_NAME="$(awk -F= '
                /^[[:space:]]*deviceName[[:space:]]*=/ {
                    sub(/^[^=]*=[[:space:]]*/, "")
                    print
                    exit
                }
            ' "$vulkaninfo_out")"
            MOLTENVK_DRIVER_NAME="$(awk -F= '
                /^[[:space:]]*driverName[[:space:]]*=/ {
                    sub(/^[^=]*=[[:space:]]*/, "")
                    print
                    exit
                }
            ' "$vulkaninfo_out")"
            if [ -n "$MOLTENVK_DEVICE_NAME" ] &&
                    [ -n "$MOLTENVK_DRIVER_NAME" ]; then
                case "$MOLTENVK_DRIVER_NAME" in
                    *MoltenVK*) ;;
                    *) fail "canonical-moltenvk-vulkaninfo-driver-mismatch" ;;
                esac
                MOLTENVK_PREFLIGHT_STATUS="device-driver-verified"
            fi
        fi
    fi
fi

# Do not admit an executable from the caller.  The verifier re-derives every
# source/provider/compiler/output binding from the canonical self-hosted build
# manifest and prints the sole output path that may be launched.
trusted_manifest_result="$(
    sh "$BUILD_HELPER" --verify "$BACKEND" "$TRUSTED_BUILD_MANIFEST"
)" || fail "trusted-build-manifest-invalid"
[ "$(printf '%s\n' "$trusted_manifest_result" | sed -n 's/^trusted_build_manifest_status=//p')" = pass ] ||
    fail "trusted-build-manifest-status-invalid"
SELECTED_DRIVER_PATH="$(printf '%s\n' "$trusted_manifest_result" |
    sed -n 's/^trusted_build_manifest_output_path=//p')"
[ -n "$SELECTED_DRIVER_PATH" ] || fail "trusted-build-output-missing"
[ "$(printf '%s\n' "$trusted_manifest_result" |
    sed -n '/^trusted_build_manifest_output_path=/p' | wc -l | tr -d ' ')" = 1 ] ||
    fail "trusted-build-output-not-singular"
[ -x "$SELECTED_DRIVER_PATH" ] || fail "trusted-build-output-not-executable"
driver_manifest_sha256="$(sha256_file "$TRUSTED_BUILD_MANIFEST")"
for provider in "$SPL_WINIT_LIB" "$SIMPLE_RUNTIME_DYLIB" "$SIMPLE_RUNTIME_C_DYLIB"; do
    [ -s "$provider" ] || fail "runtime-provider-missing"
    otool -L "$SELECTED_DRIVER_PATH" |
        grep -Fq "@rpath/$(basename -- "$provider")" ||
        fail "runtime-provider-not-linked"
done
winit_provider_sha256="$(sha256_file "$SPL_WINIT_LIB")"
simple_runtime_provider_sha256="$(sha256_file "$SIMPLE_RUNTIME_DYLIB")"
simple_runtime_c_provider_sha256="$(sha256_file "$SIMPLE_RUNTIME_C_DYLIB")"
driver_has_runtime_provider_rpath ||
    fail "runtime-provider-rpath-missing"
for input_symbol in \
    rt_winit_event_key_keycode rt_winit_event_mouse_button \
    rt_winit_event_mouse_x_milli rt_winit_event_mouse_y_milli \
    rt_winit_event_wheel_x_milli rt_winit_event_wheel_y_milli; do
    nm -u "$SELECTED_DRIVER_PATH" | grep -Fq "_$input_symbol" ||
        fail "native-driver-input-import-missing:$input_symbol"
    nm -gU "$SPL_WINIT_LIB" | grep -Fq "_$input_symbol" ||
        fail "winit-input-provider-symbol-missing:$input_symbol"
done
for audio_symbol in \
    rt_audio_init rt_audio_shutdown rt_audio_play_pcm_f64_raw \
    rt_audio_is_playing rt_audio_live_device_count rt_audio_backend_name \
    rt_audio_backend_is_real; do
    nm -u "$SELECTED_DRIVER_PATH" | grep -Fq "_$audio_symbol" ||
        fail "native-driver-audio-import-missing:$audio_symbol"
    nm -gU "$SIMPLE_RUNTIME_C_DYLIB" | grep -Fq "_$audio_symbol" ||
        fail "audio-provider-symbol-missing:$audio_symbol"
done
if [ "$BACKEND" = vulkan ]; then
    nm -u "$SELECTED_DRIVER_PATH" |
        grep -Fq "_rt_vulkan_init" ||
        fail "native-driver-without-vulkan"
    nm -u "$SELECTED_DRIVER_PATH" |
        grep -Fq "_rt_vulkan_compile_spirv" ||
        fail "native-driver-without-vulkan"
    LC_ALL=C grep -aFq "Vulkan device not initialised" "$SIMPLE_RUNTIME_DYLIB" ||
        fail "vulkan-runtime-provider-stub"
    nm -gU "$SIMPLE_RUNTIME_DYLIB" |
        grep -Fq "_rt_vulkan_provider_is_available" ||
        fail "vulkan-runtime-provider-availability-alias-missing"
    nm -gU "$SIMPLE_RUNTIME_DYLIB" |
        grep -Fq "_rt_vulkan_provider_device_count" ||
        fail "vulkan-runtime-provider-device-count-alias-missing"
fi

driver_sha256="$(sha256_file "$SELECTED_DRIVER_PATH")"
repo_revision="$(git rev-parse HEAD)"
shared_scene_fingerprint="$(cat "$SHARED_HARNESS" "$FIXTURE_SOURCE" |
    sha256_stream)"
source_revision="$(printf '%s\n' "$repo_revision" \
    "$(git hash-object "$HARNESS")" "$(git hash-object "$SHARED_HARNESS")" \
    "$(git hash-object "$FIXTURE_SOURCE")" \
    "$(git hash-object "$BACKEND_SOURCE")" "$driver_sha256" \
    "$winit_provider_sha256" "$simple_runtime_provider_sha256" \
    "$simple_runtime_c_provider_sha256" |
    sha256_stream)"

# LaunchServices reports canonical /private/var paths while mktemp may return
# the /var symlink spelling.  Canonicalize before deriving the exact executable
# identity used by both PID discovery and subsequent ownership checks.
app_dir="$(CDPATH= cd -- "$(mktemp -d)" && pwd -P)"
app="$app_dir/SimpleGpu2d.app"
app_executable="$app/Contents/MacOS/SimpleGpu2d"
mkdir -p "$app/Contents/MacOS"
cp "$SELECTED_DRIVER_PATH" "$app_executable"
cat >"$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>SimpleGpu2d</string>
  <key>CFBundleIdentifier</key><string>com.simple.$BACKEND.evidence.$$</string>
  <key>CFBundleName</key><string>Simple${BACKEND_TITLE}Evidence</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSEnvironment</key>
  <dict>
    <key>SIMPLE_GUI</key><string>1</string>
    <key>SIMPLE_ASSET_ROOT</key><string>$ROOT_DIR</string>
    <key>SIMPLE_ONE_CALL_UPLOAD</key><string>1</string>
    <key>SIMPLE_ONE_CALL_READBACK</key><string>1</string>
    <key>SIMPLE_NO_DEPRECATED_WARNINGS</key><string>1</string>
$VULKAN_PLIST_ENV
    <key>DYLD_LIBRARY_PATH</key><string>$LAUNCH_DYLD_LIBRARY_PATH</string>
    <key>GPU_2D_LIVE_CAPTURE_PATH</key><string>$CAPTURE_PPM</string>
    <key>GPU_2D_LIVE_RECEIPT_PATH</key><string>$RECEIPT</string>
    <key>GPU_2D_LIVE_READY_PATH</key><string>$READY</string>
    <key>GPU_2D_LIVE_REPO_REVISION</key><string>$repo_revision</string>
    <key>GPU_2D_LIVE_SHARED_SCENE_FINGERPRINT</key><string>$shared_scene_fingerprint</string>
    <key>GPU_2D_LIVE_SOURCE_REVISION</key><string>$source_revision</string>
    <key>GPU_2D_LIVE_HOLD</key><string>1</string>
  </dict>
</dict>
</plist>
PLIST

open -n --stdout "$LAUNCH_OUT" --stderr "$LAUNCH_ERR" "$app" ||
    fail "launch-failed"

pid_deadline=$(($(date +%s) + 15))
while [ "$(date +%s)" -lt "$pid_deadline" ]; do
    app_pid="$(find_exact_app_pid)"
    [ -z "$app_pid" ] || break
    sleep 0.1
done
positive_integer "$app_pid" || fail "exact-launched-pid-missing"
require_launched_process

deadline=$(($(date +%s) + TIMEOUT_SECS))
while [ "$(date +%s)" -lt "$deadline" ]; do
    require_launched_process
    if [ -s "$READY" ] &&
            osascript - "$app_pid" >"$WINDOW_RECORD" 2>/dev/null <<'OSA'; then
on run argv
  set targetPid to (item 1 of argv) as integer
  tell application "System Events"
    repeat with proc in (processes whose unix id is targetPid)
      tell proc
        if (count of windows) > 0 then
          set targetWindow to window 1
          set position of targetWindow to {120, 100}
          set frontmost to true
          set p to position of targetWindow
          set s to size of targetWindow
          set windowNumber to value of attribute "AXWindowNumber" of targetWindow
          if windowNumber is missing value then error "GPU window id missing"
          set AppleScript's text item delimiters to ","
          return (targetPid as text) & "," & (item 1 of p as text) & "," & ¬
            (item 2 of p as text) & "," & (item 1 of s as text) & "," & ¬
            (item 2 of s as text) & "," & (windowNumber as text)
        end if
      end tell
    end repeat
  end tell
  error "GPU evidence window not ready"
end run
OSA
        break
    fi
    sleep 1
done
[ -s "$READY" ] || fail "render-ready-timeout"
[ -s "$WINDOW_RECORD" ] || fail "window-not-found"

window_record="$(tr -d '\r\n ' <"$WINDOW_RECORD")"
case "$window_record" in *,*,*,*,*,*) ;; *) fail "invalid-window-record" ;; esac
old_ifs=$IFS
IFS=,
set -- $window_record
IFS=$old_ifs
window_pid="${1:-}"
window_x="${2:-0}"
window_y="${3:-0}"
window_w="${4:-0}"
window_h="${5:-0}"
window_id="${6:-}"
[ "$window_pid" = "$app_pid" ] || fail "window-pid-mismatch"
positive_integer "$window_w" || fail "invalid-window-width"
positive_integer "$window_h" || fail "invalid-window-height"
positive_integer "$window_id" || fail "invalid-window-id"

require_launched_process
screencapture -x -o -l"$window_id" "$WINDOW_BEFORE_PNG" ||
    fail "before-window-capture-failed"
[ "$(file_bytes "$WINDOW_BEFORE_PNG")" -gt 1000 ] ||
    fail "before-window-capture-empty"

# The exact PID-owned window is frontmost before the ordered pointer/key input.
osascript - "$app_pid" "$window_id" >/dev/null <<'OSA' ||
    fail "window-focus-failed"
on run argv
  set targetPid to (item 1 of argv) as integer
  set targetWindowId to (item 2 of argv) as integer
  tell application "System Events"
    repeat with proc in (processes whose unix id is targetPid)
      tell proc
        repeat with targetWindow in windows
          set candidateWindowId to value of attribute "AXWindowNumber" of targetWindow
          if candidateWindowId = targetWindowId then
            set frontmost to true
            return true
          end if
        end repeat
      end tell
    end repeat
  end tell
  error "GPU evidence window identity missing"
end run
OSA

pointer_x=$((window_x + (window_w / 2)))
pointer_y=$((window_y + (window_h / 2)))
drag_x=$((pointer_x + 80))
drag_y=$((pointer_y + 60))
cliclick "m:${pointer_x},${pointer_y}" "dd:." "m:${drag_x},${drag_y}" "du:." ||
    fail "pointer-injection-failed"
# CoreGraphics preserves side-specific modifier scan codes and emits a real
# scroll-wheel record; AppleScript's `using control down` collapses left/right.
xcrun swift - >/dev/null <<'SWIFT' || fail "wheel-key-injection-failed"
import CoreGraphics
import Foundation

func postKey(_ code: CGKeyCode) {
    CGEvent(keyboardEventSource: nil, virtualKey: code, keyDown: true)!.post(tap: .cghidEventTap)
    usleep(30000)
    CGEvent(keyboardEventSource: nil, virtualKey: code, keyDown: false)!.post(tap: .cghidEventTap)
    usleep(30000)
}

CGEvent(scrollWheelEvent2Source: nil, units: .line, wheelCount: 2,
        wheel1: 3, wheel2: -1, wheel3: 0)!.post(tap: .cghidEventTap)
usleep(30000)
postKey(4)   // H
postKey(59)  // left Control
postKey(62)  // right Control
postKey(58)  // left Option/Alt
postKey(61)  // right Option/Alt
SWIFT

max_rss_kb=0
max_rss_budget_kb=262144
receipt_deadline=$(($(date +%s) + 180))
while [ "$(date +%s)" -lt "$receipt_deadline" ] && [ ! -s "$RECEIPT" ]; do
    require_launched_process
    sampled_rss_kb="$(ps -o rss= -p "$app_pid" | tr -d '[:space:]')"
    case "$sampled_rss_kb" in ''|*[!0-9]*) sampled_rss_kb=0 ;; esac
    [ "$sampled_rss_kb" -le "$max_rss_kb" ] || max_rss_kb="$sampled_rss_kb"
    sleep 1
done
[ -s "$RECEIPT" ] || fail "runtime-receipt-timeout"
[ -s "$CAPTURE_PPM" ] || fail "framebuffer-capture-missing"

require_launched_process
screencapture -x -o -l"$window_id" "$WINDOW_AFTER_PNG" ||
    fail "after-window-capture-failed"
before_window_bytes="$(file_bytes "$WINDOW_BEFORE_PNG")"
after_window_bytes="$(file_bytes "$WINDOW_AFTER_PNG")"
before_window_cksum="$(file_cksum "$WINDOW_BEFORE_PNG")"
after_window_cksum="$(file_cksum "$WINDOW_AFTER_PNG")"
[ "$after_window_bytes" -gt 1000 ] || fail "after-window-capture-empty"
[ "$before_window_cksum" != "$after_window_cksum" ] ||
    fail "window-capture-unchanged"

[ "$(value_of gpu_2d_live_status "$RECEIPT")" = "pass" ] ||
    fail "runtime-status-failed"
[ "$(value_of gpu_2d_live_backend "$RECEIPT")" = "$BACKEND" ] ||
    fail "backend-mismatch"
[ "$(value_of gpu_2d_live_source "$RECEIPT")" = "device_readback" ] ||
    fail "device-readback-missing"
[ "$(value_of gpu_2d_live_width "$RECEIPT")" = "3840" ] ||
    fail "width-mismatch"
[ "$(value_of gpu_2d_live_height "$RECEIPT")" = "2160" ] ||
    fail "height-mismatch"
[ "$(value_of gpu_2d_live_dpi "$RECEIPT")" = "300" ] ||
    fail "dpi-mismatch"
[ "$(value_of gpu_2d_live_repo_revision "$RECEIPT")" = "$repo_revision" ] ||
    fail "repo-revision-mismatch"
[ "$(value_of gpu_2d_live_shared_scene_fingerprint "$RECEIPT")" = \
    "$shared_scene_fingerprint" ] || fail "shared-scene-fingerprint-mismatch"
[ "$(value_of gpu_2d_live_source_revision "$RECEIPT")" = "$source_revision" ] ||
    fail "source-revision-mismatch"
[ "$(value_of gpu_2d_live_event_sequence "$RECEIPT")" = \
    "focus,pointer_move,pointer_down,pointer_drag,pointer_up,pointer_wheel,key_down,key_up,left_ctrl_down,left_ctrl_up,right_ctrl_down,right_ctrl_up,left_alt_down,left_alt_up,right_alt_down,right_alt_up" ] ||
    fail "event-sequence-mismatch"
[ "$(value_of gpu_2d_live_event_count "$RECEIPT")" = "16" ] ||
    fail "event-count-mismatch"
[ "$(value_of gpu_2d_live_event_backend "$RECEIPT")" = "$BACKEND" ] ||
    fail "event-backend-mismatch"
for coordinate_field in \
    gpu_2d_live_pointer_move_x_milli gpu_2d_live_pointer_move_y_milli \
    gpu_2d_live_pointer_drag_x_milli gpu_2d_live_pointer_drag_y_milli; do
    positive_integer "$(value_of "$coordinate_field" "$RECEIPT")" ||
        fail "decoded-pointer-coordinate-missing:$coordinate_field"
done
[ "$(value_of gpu_2d_live_pointer_button "$RECEIPT")" = 0 ] ||
    fail "decoded-pointer-button-mismatch"
wheel_x_milli="$(value_of gpu_2d_live_pointer_wheel_x_milli "$RECEIPT")"
wheel_y_milli="$(value_of gpu_2d_live_pointer_wheel_y_milli "$RECEIPT")"
case "$wheel_x_milli" in ''|*[!0-9-]*) fail "decoded-wheel-x-invalid" ;; esac
case "$wheel_y_milli" in ''|*[!0-9-]*) fail "decoded-wheel-y-invalid" ;; esac
[ "$wheel_x_milli:$wheel_y_milli" != 0:0 ] || fail "decoded-wheel-delta-missing"
[ "$(value_of gpu_2d_live_ordinary_keycode "$RECEIPT")" = 72 ] ||
    fail "decoded-ordinary-key-mismatch"
[ "$(value_of gpu_2d_live_left_ctrl_keycode "$RECEIPT")" = 1001 ] &&
    [ "$(value_of gpu_2d_live_right_ctrl_keycode "$RECEIPT")" = 1002 ] &&
    [ "$(value_of gpu_2d_live_left_alt_keycode "$RECEIPT")" = 1003 ] &&
    [ "$(value_of gpu_2d_live_right_alt_keycode "$RECEIPT")" = 1004 ] ||
    fail "decoded-sided-modifier-mismatch"
[ "$(value_of gpu_2d_live_animation_frame_count "$RECEIPT")" = 20 ] &&
    [ "$(value_of gpu_2d_live_animation_submit_count "$RECEIPT")" = 20 ] &&
    [ "$(value_of gpu_2d_live_animation_fence_count "$RECEIPT")" = 20 ] &&
    [ "$(value_of gpu_2d_live_animation_correlated_frame_count "$RECEIPT")" = 20 ] ||
    fail "animation-submit-fence-count-mismatch"
animation_frame_p95_ns="$(value_of gpu_2d_live_animation_frame_p95_ns "$RECEIPT")"
animation_frame_p95_budget_ns="$(value_of gpu_2d_live_animation_frame_p95_budget_ns "$RECEIPT")"
positive_integer "$animation_frame_p95_ns" || fail "animation-p95-missing"
[ "$animation_frame_p95_ns" -le "$animation_frame_p95_budget_ns" ] ||
    fail "animation-p95-budget-exceeded"
[ "$(value_of gpu_2d_live_animation_readback_source "$RECEIPT")" = device_readback ] ||
    fail "animation-device-readback-missing"
positive_integer "$(value_of gpu_2d_live_animation_final_checksum "$RECEIPT")" ||
    fail "animation-final-checksum-missing"
[ "$(value_of gpu_2d_live_audio_backend_real "$RECEIPT")" = true ] &&
    [ "$(value_of gpu_2d_live_audio_fallback "$RECEIPT")" = false ] &&
    [ "$(value_of gpu_2d_live_audio_submit_count "$RECEIPT")" = 1 ] &&
    [ "$(value_of gpu_2d_live_audio_completion_count "$RECEIPT")" = 1 ] &&
    [ "$(value_of gpu_2d_live_audio_completion_observed "$RECEIPT")" = true ] ||
    fail "audio-submit-completion-contract-failed"
positive_integer "$(value_of gpu_2d_live_audio_playback_handle "$RECEIPT")" ||
    fail "audio-playback-handle-missing"
positive_integer "$max_rss_kb" || fail "max-rss-sample-missing"
[ "$max_rss_kb" -le "$max_rss_budget_kb" ] || fail "max-rss-budget-exceeded"
[ "$(value_of gpu_2d_live_draw_ir_composition_id "$RECEIPT")" = \
    "macos-gpu-2d-frozen-composition-v1" ] ||
    fail "shared-draw-ir-composition-mismatch"
[ "$(value_of gpu_2d_live_draw_ir_scene_key "$RECEIPT")" = \
    "macos-gpu-2d-frozen-scene-v1" ] ||
    fail "shared-draw-ir-scene-mismatch"
[ "$(value_of gpu_2d_live_draw_ir_rendered_commands "$RECEIPT")" = "5" ] ||
    fail "shared-draw-ir-render-count-mismatch"
[ "$(value_of gpu_2d_live_draw_ir_skipped_commands "$RECEIPT")" = "0" ] ||
    fail "shared-draw-ir-command-skipped"
[ "$(value_of gpu_2d_live_draw_ir_fallback_required "$RECEIPT")" = "false" ] ||
    fail "shared-draw-ir-fallback-required"
[ -z "$(value_of gpu_2d_live_draw_ir_fallback_reason "$RECEIPT")" ] ||
    fail "shared-draw-ir-unsupported-command"
[ "$(value_of gpu_2d_live_draw_ir_readback_source "$RECEIPT")" = \
    "device_readback" ] || fail "shared-draw-ir-device-readback-missing"
draw_ir_checksum="$(value_of gpu_2d_live_draw_ir_readback_checksum "$RECEIPT")"
positive_integer "$draw_ir_checksum" || fail "shared-draw-ir-checksum-missing"
[ "$(value_of gpu_2d_live_semantic_event "$RECEIPT")" = \
    "focus" ] || fail "semantic-event-mismatch"
[ "$(value_of gpu_2d_live_semantic_before_focus "$RECEIPT")" = \
    "macos-gpu-2d-root" ] || fail "semantic-before-focus-mismatch"
[ "$(value_of gpu_2d_live_semantic_after_focus "$RECEIPT")" = \
    "macos-gpu-2d-action" ] || fail "semantic-after-focus-mismatch"
[ "$(value_of gpu_2d_live_semantic_changed "$RECEIPT")" = "true" ] ||
    fail "semantic-mutation-missing"
[ "$(value_of gpu_2d_live_semantic_native_focus_reduced "$RECEIPT")" = "true" ] ||
    fail "native-focus-not-reduced"
[ "$(value_of gpu_2d_live_semantic_raw_winit_reduced "$RECEIPT")" = "true" ] ||
    fail "raw-winit-focus-not-reduced"
[ "$(value_of gpu_2d_live_semantic_pointer_key_delivery "$RECEIPT")" = \
    "decoded-and-correlated" ] || fail "pointer-key-delivery-not-correlated"
[ "$(value_of gpu_2d_live_semantic_correlation "$RECEIPT")" = \
    "native-focus-reduced;pointer-drag-wheel-correlated;ordinary-left-right-modifiers-correlated" ] ||
    fail "semantic-correlation-mismatch"
semantic_before_accent="$(value_of gpu_2d_live_semantic_before_accent "$RECEIPT")"
semantic_after_accent="$(value_of gpu_2d_live_semantic_after_accent "$RECEIPT")"
positive_integer "$semantic_before_accent" || fail "semantic-before-accent-missing"
positive_integer "$semantic_after_accent" || fail "semantic-after-accent-missing"
[ "$semantic_before_accent" != "$semantic_after_accent" ] ||
    fail "semantic-accent-unchanged"
[ "$(value_of gpu_2d_live_font_loaded "$RECEIPT")" = "true" ] ||
    fail "vector-font-not-loaded"
font_expected_identity="$(value_of gpu_2d_live_font_expected_identity "$RECEIPT")"
font_identity="$(value_of gpu_2d_live_font_identity "$RECEIPT")"
[ -n "$font_expected_identity" ] || fail "vector-font-expected-identity-missing"
[ "$font_identity" = "$font_expected_identity" ] ||
    fail "vector-font-identity-mismatch"
[ "$(value_of gpu_2d_live_font_warm_rasterizations "$RECEIPT")" = "0" ] ||
    fail "vector-font-warm-rerasterized"
font_point_size="$(value_of gpu_2d_live_font_point_size "$RECEIPT")"
font_dpi="$(value_of gpu_2d_live_font_dpi "$RECEIPT")"
font_pixel_size="$(value_of gpu_2d_live_font_pixel_size "$RECEIPT")"
positive_integer "$font_point_size" || fail "vector-font-point-size-missing"
positive_integer "$font_dpi" || fail "vector-font-dpi-missing"
positive_integer "$font_pixel_size" || fail "vector-font-pixel-size-missing"
[ "$font_point_size" = "24" ] && [ "$font_dpi" = "300" ] ||
    fail "vector-font-dpi-input-mismatch"
expected_font_pixel_size=$(((font_point_size * font_dpi + 36) / 72))
[ "$font_pixel_size" = "$expected_font_pixel_size" ] ||
    fail "vector-font-dpi-formula-mismatch"
[ "$(value_of gpu_2d_live_font_execution_target "$RECEIPT")" = "$BACKEND" ] ||
    fail "vector-font-not-executed-on-backend"
font_attempts="$(value_of gpu_2d_live_font_execution_attempts "$RECEIPT")"
printf '%s' "$font_attempts" | grep -Fq "$BACKEND" ||
    fail "vector-font-backend-attempt-missing"
font_cold="$(value_of gpu_2d_live_font_cold_rasterizations "$RECEIPT")"
font_hits="$(value_of gpu_2d_live_font_warm_hits "$RECEIPT")"
font_batch_identity=""
font_readback_source=""
font_device_checksum=""
font_oracle_checksum=""
font_nonblank_pixels=""
font_atlas_upload_count=""
font_atlas_upload_bytes=""
font_atlas_payload_sha256=""
font_warm_batch_identity=""
font_warm_atlas_upload_count=""
font_warm_atlas_upload_bytes=""
font_warm_atlas_payload_sha256=""
font_warm_atlas_upload_delta=""
if [ "$BACKEND" = vulkan ]; then
    [ "$(value_of gpu_2d_live_processing_ir_status "$RECEIPT")" = pass ] ||
        fail "processing-ir-receipt-status"
    [ "$(value_of gpu_2d_live_processing_ir_backend "$RECEIPT")" = vulkan ] ||
        fail "processing-ir-receipt-backend"
    [ "$(value_of gpu_2d_live_processing_ir_count "$RECEIPT")" = 64 ] ||
        fail "processing-ir-receipt-count"
    processing_ir_expected_checksum="$(
        value_of gpu_2d_live_processing_ir_expected_checksum "$RECEIPT")"
    processing_ir_actual_checksum="$(
        value_of gpu_2d_live_processing_ir_actual_checksum "$RECEIPT")"
    [ "$processing_ir_expected_checksum" = 1082179840 ] ||
        fail "processing-ir-receipt-expected-checksum"
    [ "$processing_ir_actual_checksum" = "$processing_ir_expected_checksum" ] ||
        fail "processing-ir-receipt-checksum-mismatch"
    [ "$(value_of gpu_2d_live_processing_ir_values_exact "$RECEIPT")" = true ] ||
        fail "processing-ir-receipt-values-inexact"
    [ "$(value_of gpu_2d_live_processing_ir_readback_source "$RECEIPT")" = \
        device_readback ] || fail "processing-ir-receipt-not-device-readback"
    processing_ir_handle="$(
        value_of gpu_2d_live_processing_ir_handle "$RECEIPT")"
    processing_ir_identity="$(
        value_of gpu_2d_live_processing_ir_identity "$RECEIPT")"
    positive_integer "$processing_ir_handle" ||
        fail "processing-ir-receipt-handle-missing"
    positive_integer "$processing_ir_identity" ||
        fail "processing-ir-receipt-identity-missing"
    [ "$(value_of gpu_2d_live_processing_ir_mismatch_count "$RECEIPT")" = 0 ] ||
        fail "processing-ir-receipt-mismatch"
    [ "$(value_of gpu_2d_live_processing_ir_cpu_fallback "$RECEIPT")" = false ] ||
        fail "processing-ir-receipt-cpu-fallback"
    font_batch_identity="$(value_of gpu_2d_live_font_batch_identity "$RECEIPT")"
    font_readback_source="$(value_of gpu_2d_live_font_readback_source "$RECEIPT")"
    font_device_checksum="$(value_of gpu_2d_live_font_device_checksum "$RECEIPT")"
    font_oracle_checksum="$(value_of gpu_2d_live_font_oracle_checksum "$RECEIPT")"
    font_nonblank_pixels="$(value_of gpu_2d_live_font_readback_nonblank_pixels "$RECEIPT")"
    font_atlas_upload_count="$(value_of gpu_2d_live_font_atlas_upload_count "$RECEIPT")"
    font_atlas_upload_bytes="$(value_of gpu_2d_live_font_atlas_upload_bytes "$RECEIPT")"
    font_atlas_payload_sha256="$(value_of gpu_2d_live_font_atlas_payload_sha256 "$RECEIPT")"
    font_warm_batch_identity="$(value_of gpu_2d_live_font_warm_batch_identity "$RECEIPT")"
    font_warm_atlas_upload_count="$(value_of gpu_2d_live_font_warm_atlas_upload_count "$RECEIPT")"
    font_warm_atlas_upload_bytes="$(value_of gpu_2d_live_font_warm_atlas_upload_bytes "$RECEIPT")"
    font_warm_atlas_payload_sha256="$(value_of gpu_2d_live_font_warm_atlas_payload_sha256 "$RECEIPT")"
    font_warm_atlas_upload_delta="$(value_of gpu_2d_live_font_warm_atlas_upload_delta "$RECEIPT")"
    [ "$(value_of gpu_2d_live_font_execution_target "$RECEIPT")" = vulkan ] ||
        fail "vulkan-font-target-mismatch"
    [ -n "$font_batch_identity" ] || fail "vulkan-font-batch-identity-missing"
    [ "$font_readback_source" = device_readback ] ||
        fail "vulkan-font-device-readback-missing"
    positive_integer "$font_device_checksum" ||
        fail "vulkan-font-device-checksum-missing"
    [ "$font_device_checksum" = "$font_oracle_checksum" ] ||
        fail "vulkan-font-oracle-parity-mismatch"
    positive_integer "$font_nonblank_pixels" ||
        fail "vulkan-font-nonblank-pixels-missing"
    [ "$(value_of gpu_2d_live_font_parity "$RECEIPT")" = true ] ||
        fail "vulkan-font-parity-missing"
    [ "$(value_of gpu_2d_live_font_device_executed "$RECEIPT")" = true ] ||
        fail "vulkan-font-device-execution-missing"
    [ "$(value_of gpu_2d_live_font_promotion_ready "$RECEIPT")" = true ] ||
        fail "vulkan-font-promotion-missing"
    positive_integer "$font_atlas_upload_count" ||
        fail "vulkan-font-atlas-upload-count-missing"
    positive_integer "$font_atlas_upload_bytes" ||
        fail "vulkan-font-atlas-upload-bytes-missing"
    sha256_valid "$font_atlas_payload_sha256" ||
        fail "vulkan-font-atlas-payload-sha256-invalid"
    [ "$font_warm_batch_identity" = "$font_batch_identity" ] ||
        fail "vulkan-font-warm-batch-identity-mismatch"
    [ "$font_warm_atlas_upload_count" = "$font_atlas_upload_count" ] &&
        [ "$font_warm_atlas_upload_delta" = 0 ] ||
        fail "vulkan-font-warm-atlas-reuploaded"
    [ "$font_warm_atlas_upload_bytes" = "$font_atlas_upload_bytes" ] ||
        fail "vulkan-font-warm-atlas-bytes-changed"
    [ "$font_warm_atlas_payload_sha256" = "$font_atlas_payload_sha256" ] ||
        fail "vulkan-font-warm-atlas-payload-changed"
fi
backend_handle="$(value_of gpu_2d_live_backend_handle "$RECEIPT")"
device_identity="$(value_of gpu_2d_live_device_identity "$RECEIPT")"
draw_ir_device_identity="$(value_of gpu_2d_live_draw_ir_device_identity "$RECEIPT")"
interaction_device_identity="$(value_of gpu_2d_live_interaction_device_identity "$RECEIPT")"
initial_checksum="$(value_of gpu_2d_live_initial_checksum "$RECEIPT")"
interaction_checksum="$(value_of gpu_2d_live_interaction_checksum "$RECEIPT")"
positive_integer "$font_cold" ||
    fail "vector-font-cold-rasterization-missing"
positive_integer "$font_hits" || fail "vector-font-warm-hit-missing"
positive_integer "$backend_handle" || fail "backend-handle-missing"
positive_integer "$device_identity" || fail "device-identity-missing"
positive_integer "$draw_ir_device_identity" ||
    fail "draw-ir-device-identity-missing"
positive_integer "$interaction_device_identity" ||
    fail "interaction-device-identity-missing"
[ "$draw_ir_device_identity" = "$device_identity" ] ||
    fail "draw-ir-device-identity-changed"
[ "$interaction_device_identity" = "$device_identity" ] ||
    fail "interaction-device-identity-changed"
positive_integer "$initial_checksum" || fail "initial-checksum-missing"
positive_integer "$interaction_checksum" || fail "interaction-checksum-missing"
[ "$initial_checksum" != "$interaction_checksum" ] ||
    fail "interaction-checksum-unchanged"
[ "$(value_of gpu_2d_live_animation_final_checksum "$RECEIPT")" = "$interaction_checksum" ] ||
    fail "animation-capture-checksum-mismatch"

ppm_bytes="$(wc -c <"$CAPTURE_PPM" | tr -d ' ')"
[ "$ppm_bytes" -gt 24883200 ] || fail "capture-truncated"
ppm_header="$(head -n 3 "$CAPTURE_PPM" | tr '\n' '|')"
[ "$ppm_header" = "P6|3840 2160|255|" ] || fail "capture-header-mismatch"
pixel_sha256="$(dd if="$CAPTURE_PPM" bs=1 skip=17 2>/dev/null |
    sha256_stream)"
case "$pixel_sha256" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*)
        [ "${#pixel_sha256}" -eq 64 ] || fail "pixel-sha256-invalid" ;;
    *) fail "pixel-sha256-invalid" ;;
esac
non_background_bounds="$(value_of gpu_2d_live_non_background_bounds "$RECEIPT")"
case "$non_background_bounds" in
    *,*,*,*) ;;
    *) fail "non-background-bounds-missing" ;;
esac

sips -s format png "$CAPTURE_PPM" --out "$CAPTURE_PNG" >/dev/null ||
    fail "png-conversion-failed"
[ -s "$CAPTURE_PNG" ] || fail "png-conversion-empty"
sips -s dpiWidth 300 -s dpiHeight 300 "$CAPTURE_PNG" >/dev/null ||
    fail "png-dpi-write-failed"
png_width="$(sips -g pixelWidth "$CAPTURE_PNG" |
    awk '/pixelWidth:/{print $2}')"
png_height="$(sips -g pixelHeight "$CAPTURE_PNG" |
    awk '/pixelHeight:/{print $2}')"
[ "$png_width" = "3840" ] && [ "$png_height" = "2160" ] ||
    fail "png-dimensions-mismatch"
png_dpi_width="$(sips -g dpiWidth "$CAPTURE_PNG" |
    awk '/dpiWidth:/{printf "%.0f\n", $2; found=1} END {if (!found) exit 1}')" ||
    fail "png-dpi-mismatch"
png_dpi_height="$(sips -g dpiHeight "$CAPTURE_PNG" |
    awk '/dpiHeight:/{printf "%.0f\n", $2; found=1} END {if (!found) exit 1}')" ||
    fail "png-dpi-mismatch"
[ "$png_dpi_width" = "300" ] && [ "$png_dpi_height" = "300" ] ||
    fail "png-dpi-mismatch"

{
    echo "${PREFIX}_status=pass"
    echo "${PREFIX}_reason=pass"
    echo "${PREFIX}_driver_kind=$SELECTED_DRIVER_KIND"
    echo "${PREFIX}_driver_path=$SELECTED_DRIVER_PATH"
    echo "${PREFIX}_driver_sha256=$driver_sha256"
    echo "${PREFIX}_trusted_build_manifest=$TRUSTED_BUILD_MANIFEST"
    echo "${PREFIX}_trusted_build_manifest_sha256=$driver_manifest_sha256"
    echo "${PREFIX}_winit_provider_sha256=$winit_provider_sha256"
    echo "${PREFIX}_simple_runtime_provider_sha256=$simple_runtime_provider_sha256"
    echo "${PREFIX}_simple_runtime_c_provider_sha256=$simple_runtime_c_provider_sha256"
    if [ "$BACKEND" = vulkan ]; then
        echo "${PREFIX}_moltenvk_icd_path=$MOLTENVK_ICD_PATH"
        echo "${PREFIX}_moltenvk_icd_sha256=$MOLTENVK_ICD_SHA256"
        echo "${PREFIX}_moltenvk_library_path=$MOLTENVK_LIBRARY_PATH"
        echo "${PREFIX}_moltenvk_library_sha256=$MOLTENVK_LIBRARY_SHA256"
        echo "${PREFIX}_moltenvk_preflight_status=$MOLTENVK_PREFLIGHT_STATUS"
        echo "${PREFIX}_moltenvk_vulkaninfo_path=$MOLTENVK_VULKANINFO_PATH"
        echo "${PREFIX}_moltenvk_vulkaninfo_sha256=$MOLTENVK_VULKANINFO_SHA256"
        echo "${PREFIX}_moltenvk_vulkaninfo_output_sha256=$MOLTENVK_VULKANINFO_OUTPUT_SHA256"
        echo "${PREFIX}_moltenvk_device_name=$MOLTENVK_DEVICE_NAME"
        echo "${PREFIX}_moltenvk_driver_name=$MOLTENVK_DRIVER_NAME"
    fi
    echo "${PREFIX}_backend=$BACKEND"
    echo "${PREFIX}_repo_revision=$repo_revision"
    echo "${PREFIX}_shared_scene_fingerprint=$shared_scene_fingerprint"
    echo "${PREFIX}_source=device_readback"
    echo "${PREFIX}_backend_handle=$backend_handle"
    echo "${PREFIX}_device_identity=$device_identity"
    echo "${PREFIX}_draw_ir_device_identity=$draw_ir_device_identity"
    echo "${PREFIX}_interaction_device_identity=$interaction_device_identity"
    echo "${PREFIX}_initial_checksum=$initial_checksum"
    echo "${PREFIX}_interaction_checksum=$interaction_checksum"
    echo "${PREFIX}_width=3840"
    echo "${PREFIX}_height=2160"
    echo "${PREFIX}_dpi=300"
    echo "${PREFIX}_png_dpi_width=$png_dpi_width"
    echo "${PREFIX}_png_dpi_height=$png_dpi_height"
    echo "${PREFIX}_pixel_sha256=$pixel_sha256"
    echo "${PREFIX}_non_background_bounds=$non_background_bounds"
    echo "${PREFIX}_event_sequence=$(value_of gpu_2d_live_event_sequence "$RECEIPT")"
    echo "${PREFIX}_event_count=16"
    echo "${PREFIX}_event_backend=$BACKEND"
    for evidence_field in pointer_move_x_milli pointer_move_y_milli pointer_drag_x_milli pointer_drag_y_milli pointer_button pointer_wheel_x_milli pointer_wheel_y_milli ordinary_keycode left_ctrl_keycode right_ctrl_keycode left_alt_keycode right_alt_keycode animation_frame_count animation_frame_p95_ns animation_frame_p95_budget_ns animation_submit_count animation_fence_count animation_readback_source animation_final_checksum audio_backend audio_pcm_checksum audio_playback_handle audio_submit_count audio_completion_count audio_completion_observed audio_backend_real audio_fallback; do
        echo "${PREFIX}_${evidence_field}=$(value_of "gpu_2d_live_${evidence_field}" "$RECEIPT")"
    done
    echo "${PREFIX}_max_rss_kb=$max_rss_kb"
    echo "${PREFIX}_max_rss_budget_kb=$max_rss_budget_kb"
    echo "${PREFIX}_draw_ir_composition_id=macos-gpu-2d-frozen-composition-v1"
    echo "${PREFIX}_draw_ir_scene_key=macos-gpu-2d-frozen-scene-v1"
    echo "${PREFIX}_draw_ir_rendered_commands=5"
    echo "${PREFIX}_draw_ir_skipped_commands=0"
    echo "${PREFIX}_draw_ir_readback_checksum=$draw_ir_checksum"
    echo "${PREFIX}_semantic_event=focus"
    echo "${PREFIX}_semantic_before_focus=macos-gpu-2d-root"
    echo "${PREFIX}_semantic_after_focus=macos-gpu-2d-action"
    echo "${PREFIX}_semantic_before_accent=$semantic_before_accent"
    echo "${PREFIX}_semantic_after_accent=$semantic_after_accent"
    echo "${PREFIX}_semantic_changed=true"
    echo "${PREFIX}_semantic_native_focus_reduced=true"
    echo "${PREFIX}_semantic_raw_winit_reduced=true"
    echo "${PREFIX}_semantic_pointer_key_delivery=decoded-and-correlated"
    echo "${PREFIX}_semantic_correlation=native-focus-reduced;pointer-drag-wheel-correlated;ordinary-left-right-modifiers-correlated"
    echo "${PREFIX}_font_loaded=true"
    echo "${PREFIX}_font_expected_identity=$font_expected_identity"
    echo "${PREFIX}_font_identity=$font_identity"
    echo "${PREFIX}_font_cold_rasterizations=$font_cold"
    echo "${PREFIX}_font_warm_rasterizations=0"
    echo "${PREFIX}_font_warm_hits=$font_hits"
    echo "${PREFIX}_font_point_size=$font_point_size"
    echo "${PREFIX}_font_dpi=$font_dpi"
    echo "${PREFIX}_font_pixel_size=$font_pixel_size"
    echo "${PREFIX}_font_execution_target=$BACKEND"
    if [ "$BACKEND" = vulkan ]; then
        echo "${PREFIX}_font_batch_identity=$font_batch_identity"
        echo "${PREFIX}_font_readback_source=$font_readback_source"
        echo "${PREFIX}_font_device_checksum=$font_device_checksum"
        echo "${PREFIX}_font_oracle_checksum=$font_oracle_checksum"
        echo "${PREFIX}_font_readback_nonblank_pixels=$font_nonblank_pixels"
        echo "${PREFIX}_font_parity=true"
        echo "${PREFIX}_font_device_executed=true"
        echo "${PREFIX}_font_promotion_ready=true"
        echo "${PREFIX}_font_atlas_upload_count=$font_atlas_upload_count"
        echo "${PREFIX}_font_atlas_upload_bytes=$font_atlas_upload_bytes"
        echo "${PREFIX}_font_atlas_payload_sha256=$font_atlas_payload_sha256"
        echo "${PREFIX}_font_warm_batch_identity=$font_warm_batch_identity"
        echo "${PREFIX}_font_warm_atlas_upload_count=$font_warm_atlas_upload_count"
        echo "${PREFIX}_font_warm_atlas_upload_bytes=$font_warm_atlas_upload_bytes"
        echo "${PREFIX}_font_warm_atlas_payload_sha256=$font_warm_atlas_payload_sha256"
        echo "${PREFIX}_font_warm_atlas_upload_delta=$font_warm_atlas_upload_delta"
    fi
    echo "${PREFIX}_source_revision=$source_revision"
    echo "${PREFIX}_pid=$app_pid"
    echo "${PREFIX}_executable=$app_executable"
    echo "${PREFIX}_window_id=$window_id"
    echo "${PREFIX}_window_rect=$window_x,$window_y,$window_w,$window_h"
    echo "${PREFIX}_window_before_png=$WINDOW_BEFORE_PNG"
    echo "${PREFIX}_window_after_png=$WINDOW_AFTER_PNG"
    echo "${PREFIX}_window_before_bytes=$before_window_bytes"
    echo "${PREFIX}_window_after_bytes=$after_window_bytes"
    echo "${PREFIX}_window_before_cksum=$before_window_cksum"
    echo "${PREFIX}_window_after_cksum=$after_window_cksum"
    echo "${PREFIX}_capture_path=$CAPTURE_PPM"
    echo "backend=$BACKEND"
    echo "target=macos-host"
    echo "width=3840"
    echo "height=2160"
    echo "dpi=300"
    echo "font_point_size=$font_point_size"
    echo "font_dpi=$font_dpi"
    echo "font_pixel_size=$font_pixel_size"
    echo "winit_provider_sha256=$winit_provider_sha256"
    echo "simple_runtime_provider_sha256=$simple_runtime_provider_sha256"
    echo "simple_runtime_c_provider_sha256=$simple_runtime_c_provider_sha256"
    if [ "$BACKEND" = vulkan ]; then
        echo "moltenvk_icd_path=$MOLTENVK_ICD_PATH"
        echo "moltenvk_icd_sha256=$MOLTENVK_ICD_SHA256"
        echo "moltenvk_library_path=$MOLTENVK_LIBRARY_PATH"
        echo "moltenvk_library_sha256=$MOLTENVK_LIBRARY_SHA256"
        echo "moltenvk_preflight_status=$MOLTENVK_PREFLIGHT_STATUS"
        echo "moltenvk_vulkaninfo_path=$MOLTENVK_VULKANINFO_PATH"
        echo "moltenvk_vulkaninfo_sha256=$MOLTENVK_VULKANINFO_SHA256"
        echo "moltenvk_vulkaninfo_output_sha256=$MOLTENVK_VULKANINFO_OUTPUT_SHA256"
        echo "moltenvk_device_name=$MOLTENVK_DEVICE_NAME"
        echo "moltenvk_driver_name=$MOLTENVK_DRIVER_NAME"
    fi
    echo "trusted_build_manifest=$TRUSTED_BUILD_MANIFEST"
    echo "trusted_build_manifest_sha256=$driver_manifest_sha256"
    echo "pixel_sha256=$pixel_sha256"
    echo "non_background_bounds=$non_background_bounds"
    echo "event_sequence=$(value_of gpu_2d_live_event_sequence "$RECEIPT")"
    echo "event_count=16"
    echo "event_backend=$BACKEND"
    for evidence_field in pointer_move_x_milli pointer_move_y_milli pointer_drag_x_milli pointer_drag_y_milli pointer_button pointer_wheel_x_milli pointer_wheel_y_milli ordinary_keycode left_ctrl_keycode right_ctrl_keycode left_alt_keycode right_alt_keycode animation_frame_count animation_frame_p95_ns animation_frame_p95_budget_ns animation_submit_count animation_fence_count animation_readback_source animation_final_checksum audio_backend audio_pcm_checksum audio_playback_handle audio_submit_count audio_completion_count audio_completion_observed audio_backend_real audio_fallback; do
        echo "${evidence_field}=$(value_of "gpu_2d_live_${evidence_field}" "$RECEIPT")"
    done
    echo "max_rss_kb=$max_rss_kb"
    echo "max_rss_budget_kb=$max_rss_budget_kb"
    echo "repo_revision=$repo_revision"
    echo "shared_scene_fingerprint=$shared_scene_fingerprint"
    echo "draw_ir_composition_id=macos-gpu-2d-frozen-composition-v1"
    echo "draw_ir_scene_key=macos-gpu-2d-frozen-scene-v1"
    echo "draw_ir_rendered_commands=5"
    echo "draw_ir_skipped_commands=0"
    echo "draw_ir_readback_checksum=$draw_ir_checksum"
    echo "semantic_event=focus"
    echo "semantic_before_focus=macos-gpu-2d-root"
    echo "semantic_after_focus=macos-gpu-2d-action"
    echo "semantic_before_accent=$semantic_before_accent"
    echo "semantic_after_accent=$semantic_after_accent"
    echo "semantic_changed=true"
    echo "semantic_native_focus_reduced=true"
    echo "semantic_raw_winit_reduced=true"
    echo "semantic_pointer_key_delivery=decoded-and-correlated"
    echo "semantic_correlation=native-focus-reduced;pointer-drag-wheel-correlated;ordinary-left-right-modifiers-correlated"
    echo "capture_path=$CAPTURE_PPM"
    echo "source_revision=$source_revision"
} >"$EVIDENCE"

write_report pass "live-$BACKEND-device-readback-vector-font-decoded-events-audio-20-frame-animation"
cleanup
trap - EXIT HUP INT TERM
echo "macOS $BACKEND_TITLE 2D live evidence: PASS"
echo "report=$REPORT_PATH"
echo "capture=$CAPTURE_PNG"
