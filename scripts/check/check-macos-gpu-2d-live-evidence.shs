#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

BACKEND="$(printf '%s' "${GPU_2D_LIVE_BACKEND:-}" | tr '[:upper:]' '[:lower:]')"
case "$BACKEND" in
    vulkan|metal) ;;
    *) echo "macOS GPU 2D live evidence: FAIL (invalid-backend)" >&2; exit 1 ;;
esac
PREFIX="macos_${BACKEND}_2d_live"
BACKEND_TITLE="$(printf '%s' "$BACKEND" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
BUILD_DIR="${BUILD_DIR:-build/tmp/macos_${BACKEND}_2d_live_evidence}"
REPORT_PATH="${REPORT_PATH:-doc/09_report/macos_${BACKEND}_2d_live_evidence_$(date -u +%F).md}"
HARNESS="$ROOT_DIR/test/02_integration/rendering/macos_${BACKEND}_2d_live_harness.spl"
SHARED_HARNESS="$ROOT_DIR/test/02_integration/rendering/macos_gpu_2d_live_harness.spl"
FIXTURE_SOURCE="$ROOT_DIR/test/02_integration/rendering/macos_gpu_2d_draw_ir_event_fixture.spl"
BACKEND_SOURCE="$ROOT_DIR/src/lib/gc_async_mut/gpu/engine2d/backend_${BACKEND}.spl"
CAPTURE_PPM="$BUILD_DIR/${BACKEND}_3840x2160_300dpi.ppm"
CAPTURE_PNG="$BUILD_DIR/${BACKEND}_3840x2160_300dpi.png"
WINDOW_BEFORE_PNG="$BUILD_DIR/window_before.png"
WINDOW_AFTER_PNG="$BUILD_DIR/window_after.png"
RECEIPT="$BUILD_DIR/runtime_receipt.env"
READY="$BUILD_DIR/ready.env"
EVIDENCE="$BUILD_DIR/evidence.env"
LAUNCH_OUT="$BUILD_DIR/launch.out"
LAUNCH_ERR="$BUILD_DIR/launch.err"
WINDOW_RECORD="$BUILD_DIR/window.env"
TIMEOUT_SECS="${GPU_2D_LIVE_TIMEOUT_SECS:-420}"
BUILD_HELPER="$ROOT_DIR/scripts/check/build-macos-gpu-2d-live-native.shs"
TRUSTED_BUILD_MANIFEST="$ROOT_DIR/build/macos_gpu_2d_live_native/$BACKEND/trusted-build.env"
SELECTED_DRIVER_PATH=""
SELECTED_DRIVER_KIND="trusted-self-hosted-native-output"
SPL_WINIT_LIB="${GPU_2D_LIVE_WINIT_LIB:-$ROOT_DIR/build/sffi/libspl_winit.dylib}"
SIMPLE_RUNTIME_DYLIB="${GPU_2D_LIVE_RUNTIME_DYLIB:-$ROOT_DIR/build/sffi/libsimple_runtime_wm.dylib}"
SIMPLE_RUNTIME_C_DYLIB="${GPU_2D_LIVE_RUNTIME_C_DYLIB:-$ROOT_DIR/build/sffi/libsimple_runtime_c_wm.dylib}"

mkdir -p "$BUILD_DIR" "$(dirname -- "$REPORT_PATH")"
BUILD_DIR_ABS="$(CDPATH= cd -- "$BUILD_DIR" && pwd)"
CAPTURE_PPM="$BUILD_DIR_ABS/$(basename -- "$CAPTURE_PPM")"
CAPTURE_PNG="$BUILD_DIR_ABS/$(basename -- "$CAPTURE_PNG")"
WINDOW_BEFORE_PNG="$BUILD_DIR_ABS/$(basename -- "$WINDOW_BEFORE_PNG")"
WINDOW_AFTER_PNG="$BUILD_DIR_ABS/$(basename -- "$WINDOW_AFTER_PNG")"
RECEIPT="$BUILD_DIR_ABS/$(basename -- "$RECEIPT")"
READY="$BUILD_DIR_ABS/$(basename -- "$READY")"
EVIDENCE="$BUILD_DIR_ABS/$(basename -- "$EVIDENCE")"
LAUNCH_OUT="$BUILD_DIR_ABS/$(basename -- "$LAUNCH_OUT")"
LAUNCH_ERR="$BUILD_DIR_ABS/$(basename -- "$LAUNCH_ERR")"
WINDOW_RECORD="$BUILD_DIR_ABS/$(basename -- "$WINDOW_RECORD")"
rm -f "$CAPTURE_PPM" "$CAPTURE_PNG" "$WINDOW_BEFORE_PNG" \
    "$WINDOW_AFTER_PNG" "$RECEIPT" "$READY" "$EVIDENCE" \
    "$LAUNCH_OUT" "$LAUNCH_ERR" "$WINDOW_RECORD"

app_pid=""
app_dir=""
app_executable=""

value_of() {
    sed -n "s/^${1}=//p" "$2" | tail -n 1
}

positive_integer() {
    case "${1:-}" in
        ""|0|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

pid_matches_executable() {
    target_pid="$1"
    target_executable="$2"
    command_line="$(ps -p "$target_pid" -o command= 2>/dev/null || true)"
    [ "$command_line" = "$target_executable" ] ||
        [ "${command_line#"$target_executable "}" != "$command_line" ]
}

cleanup() {
    if [ -n "$app_pid" ] && [ -n "$app_executable" ] &&
            pid_matches_executable "$app_pid" "$app_executable"; then
        osascript - "$app_pid" >/dev/null 2>&1 <<'OSA' || true
on run argv
  set targetPid to (item 1 of argv) as integer
  tell application "System Events"
    repeat with proc in (processes whose unix id is targetPid)
      tell proc
        set frontmost to true
        keystroke "q"
      end tell
    end repeat
  end tell
end run
OSA
        if kill -0 "$app_pid" 2>/dev/null; then
            kill -TERM "$app_pid" 2>/dev/null || true
        fi
    fi
    app_pid=""
    if [ -n "$app_dir" ] && [ -d "$app_dir" ]; then
        rm -rf "$app_dir"
    fi
}
trap cleanup EXIT HUP INT TERM

write_report() {
    status="$1"
    reason="$2"
    {
        echo "# macOS $BACKEND_TITLE 2D Live Evidence"
        echo
        echo "- status: $status"
        echo "- reason: $reason"
        echo "- selected driver: \`$SELECTED_DRIVER_PATH\`"
        echo "- selected driver kind: $SELECTED_DRIVER_KIND"
        echo "- trusted build manifest: \`$TRUSTED_BUILD_MANIFEST\`"
        echo "- runtime receipt: \`$RECEIPT\`"
        echo "- 4K/300-DPI framebuffer: \`$CAPTURE_PNG\`"
        echo "- exact window before input: \`$WINDOW_BEFORE_PNG\`"
        echo "- exact window after input: \`$WINDOW_AFTER_PNG\`"
        echo "- launcher stdout: \`$LAUNCH_OUT\`"
        echo "- launcher stderr: \`$LAUNCH_ERR\`"
        if [ -f "$EVIDENCE" ]; then
            echo
            echo "## Validated evidence"
            echo
            echo '```text'
            cat "$EVIDENCE"
            echo '```'
        fi
        if [ -f "$RECEIPT" ]; then
            echo
            echo "## Runtime receipt"
            echo
            echo '```text'
            cat "$RECEIPT"
            echo '```'
        fi
    } >"$REPORT_PATH"
}

fail() {
    reason="$1"
    {
        echo "${PREFIX}_status=fail"
        echo "${PREFIX}_reason=$reason"
        echo "${PREFIX}_driver_kind=$SELECTED_DRIVER_KIND"
        echo "${PREFIX}_driver_path=$SELECTED_DRIVER_PATH"
        echo "${PREFIX}_trusted_build_manifest=$TRUSTED_BUILD_MANIFEST"
    } >"$EVIDENCE"
    write_report fail "$reason"
    echo "macOS $BACKEND_TITLE 2D live evidence: FAIL ($reason)" >&2
    exit 1
}

require_launched_process() {
    if ! kill -0 "$app_pid" 2>/dev/null; then
        # The harness writes a stage-specific failure receipt immediately
        # before returning.  LaunchServices can reap the process before that
        # small file becomes visible to this polling shell, so allow only a
        # short, bounded publication grace period.  A missing receipt after
        # the grace period remains a hard launched-process failure.
        receipt_grace=0
        while [ "$receipt_grace" -lt 10 ] && [ ! -s "$RECEIPT" ]; do
            sleep 0.1
            receipt_grace=$((receipt_grace + 1))
        done
        if [ -s "$RECEIPT" ] &&
                [ "$(value_of gpu_2d_live_status "$RECEIPT")" = "fail" ]; then
            receipt_reason="$(value_of gpu_2d_live_reason "$RECEIPT")"
            [ -n "$receipt_reason" ] ||
                receipt_reason="runtime-failure-receipt-without-reason"
            fail "runtime-$receipt_reason"
        fi
        fail "launched-process-missing"
    fi
    pid_matches_executable "$app_pid" "$app_executable" ||
        fail "launched-process-identity-mismatch"
}

find_exact_app_pid() {
    ps -axo pid=,command= | awk -v executable="$app_executable" '
        {
            pid = $1
            $1 = ""
            sub(/^[[:space:]]+/, "")
            if ($0 == executable || index($0, executable " ") == 1) {
                print pid
                exit
            }
        }
    '
}

file_bytes() {
    if [ -f "$1" ]; then wc -c <"$1" | tr -d ' '; else echo 0; fi
}

file_cksum() {
    if [ -f "$1" ]; then cksum "$1" | awk '{print $1}'; else echo 0; fi
}

[ "$(uname -s)" = "Darwin" ] || fail "requires-macos"
[ -f "$HARNESS" ] || fail "harness-missing"
[ -f "$SHARED_HARNESS" ] || fail "shared-harness-missing"
[ -f "$FIXTURE_SOURCE" ] || fail "shared-scene-fixture-missing"
[ -f "$BACKEND_SOURCE" ] || fail "backend-source-missing"
[ -x "$BUILD_HELPER" ] || fail "trusted-native-build-helper-missing"
[ -z "${GPU_2D_LIVE_NATIVE_BIN:-}" ] || fail "arbitrary-native-driver-supplied"
command -v osascript >/dev/null 2>&1 || fail "osascript-missing"
command -v screencapture >/dev/null 2>&1 || fail "screencapture-missing"
command -v cliclick >/dev/null 2>&1 || fail "cliclick-missing"
command -v sips >/dev/null 2>&1 || fail "sips-missing"

# Do not admit an executable from the caller.  The verifier re-derives every
# source/provider/compiler/output binding from the canonical self-hosted build
# manifest and prints the sole output path that may be launched.
trusted_manifest_result="$(
    GPU_2D_LIVE_WINIT_LIB="$SPL_WINIT_LIB" \
    GPU_2D_LIVE_RUNTIME_DYLIB="$SIMPLE_RUNTIME_DYLIB" \
    GPU_2D_LIVE_RUNTIME_C_DYLIB="$SIMPLE_RUNTIME_C_DYLIB" \
    sh "$BUILD_HELPER" --verify "$BACKEND" "$TRUSTED_BUILD_MANIFEST"
)" || fail "trusted-build-manifest-invalid"
[ "$(printf '%s\n' "$trusted_manifest_result" | sed -n 's/^trusted_build_manifest_status=//p')" = pass ] ||
    fail "trusted-build-manifest-status-invalid"
SELECTED_DRIVER_PATH="$(printf '%s\n' "$trusted_manifest_result" |
    sed -n 's/^trusted_build_manifest_output_path=//p')"
[ -n "$SELECTED_DRIVER_PATH" ] || fail "trusted-build-output-missing"
[ "$(printf '%s\n' "$trusted_manifest_result" |
    sed -n '/^trusted_build_manifest_output_path=/p' | wc -l | tr -d ' ')" = 1 ] ||
    fail "trusted-build-output-not-singular"
[ -x "$SELECTED_DRIVER_PATH" ] || fail "trusted-build-output-not-executable"
driver_manifest_sha256="$(shasum -a 256 "$TRUSTED_BUILD_MANIFEST" | awk '{print $1}')"
for provider in "$SPL_WINIT_LIB" "$SIMPLE_RUNTIME_DYLIB" "$SIMPLE_RUNTIME_C_DYLIB"; do
    [ -s "$provider" ] || fail "runtime-provider-missing"
    otool -L "$SELECTED_DRIVER_PATH" |
        grep -Fq "@rpath/$(basename -- "$provider")" ||
        fail "runtime-provider-not-linked"
done
winit_provider_sha256="$(shasum -a 256 "$SPL_WINIT_LIB" | awk '{print $1}')"
simple_runtime_provider_sha256="$(shasum -a 256 "$SIMPLE_RUNTIME_DYLIB" | awk '{print $1}')"
simple_runtime_c_provider_sha256="$(shasum -a 256 "$SIMPLE_RUNTIME_C_DYLIB" | awk '{print $1}')"
otool -l "$SELECTED_DRIVER_PATH" |
    grep -Fq "$(dirname -- "$SIMPLE_RUNTIME_DYLIB")" ||
    fail "runtime-provider-rpath-missing"
if [ "$BACKEND" = vulkan ]; then
    nm -u "$SELECTED_DRIVER_PATH" |
        grep -Fq "_rt_vulkan_init" ||
        fail "native-driver-without-vulkan"
    nm -u "$SELECTED_DRIVER_PATH" |
        grep -Fq "_rt_vulkan_compile_spirv" ||
        fail "native-driver-without-vulkan"
    LC_ALL=C grep -aFq "Vulkan device not initialised" "$SIMPLE_RUNTIME_DYLIB" ||
        fail "vulkan-runtime-provider-stub"
    nm -gU "$SIMPLE_RUNTIME_DYLIB" |
        grep -Fq "_rt_vulkan_provider_is_available" ||
        fail "vulkan-runtime-provider-availability-alias-missing"
    nm -gU "$SIMPLE_RUNTIME_DYLIB" |
        grep -Fq "_rt_vulkan_provider_device_count" ||
        fail "vulkan-runtime-provider-device-count-alias-missing"
fi

driver_sha256="$(shasum -a 256 "$SELECTED_DRIVER_PATH" | awk '{print $1}')"
repo_revision="$(git rev-parse HEAD)"
shared_scene_fingerprint="$(cat "$SHARED_HARNESS" "$FIXTURE_SOURCE" |
    shasum -a 256 | awk '{print $1}')"
source_revision="$(printf '%s\n' "$repo_revision" \
    "$(git hash-object "$HARNESS")" "$(git hash-object "$SHARED_HARNESS")" \
    "$(git hash-object "$FIXTURE_SOURCE")" \
    "$(git hash-object "$BACKEND_SOURCE")" "$driver_sha256" \
    "$winit_provider_sha256" "$simple_runtime_provider_sha256" \
    "$simple_runtime_c_provider_sha256" |
    shasum -a 256 | awk '{print $1}')"

# LaunchServices reports canonical /private/var paths while mktemp may return
# the /var symlink spelling.  Canonicalize before deriving the exact executable
# identity used by both PID discovery and subsequent ownership checks.
app_dir="$(CDPATH= cd -- "$(mktemp -d)" && pwd -P)"
app="$app_dir/SimpleGpu2d.app"
app_executable="$app/Contents/MacOS/SimpleGpu2d"
mkdir -p "$app/Contents/MacOS"
cp "$SELECTED_DRIVER_PATH" "$app_executable"
cat >"$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>SimpleGpu2d</string>
  <key>CFBundleIdentifier</key><string>com.simple.$BACKEND.evidence.$$</string>
  <key>CFBundleName</key><string>Simple${BACKEND_TITLE}Evidence</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSEnvironment</key>
  <dict>
    <key>SIMPLE_GUI</key><string>1</string>
    <key>SIMPLE_ASSET_ROOT</key><string>$ROOT_DIR</string>
    <key>SIMPLE_ONE_CALL_UPLOAD</key><string>1</string>
    <key>SIMPLE_ONE_CALL_READBACK</key><string>1</string>
    <key>SIMPLE_NO_DEPRECATED_WARNINGS</key><string>1</string>
    <key>VK_ICD_FILENAMES</key><string>${VK_ICD_FILENAMES:-/opt/homebrew/etc/vulkan/icd.d/MoltenVK_icd.json}</string>
    <key>DYLD_LIBRARY_PATH</key><string>$ROOT_DIR/build/sffi:${DYLD_LIBRARY_PATH:-/opt/homebrew/lib}</string>
    <key>GPU_2D_LIVE_CAPTURE_PATH</key><string>$CAPTURE_PPM</string>
    <key>GPU_2D_LIVE_RECEIPT_PATH</key><string>$RECEIPT</string>
    <key>GPU_2D_LIVE_READY_PATH</key><string>$READY</string>
    <key>GPU_2D_LIVE_REPO_REVISION</key><string>$repo_revision</string>
    <key>GPU_2D_LIVE_SHARED_SCENE_FINGERPRINT</key><string>$shared_scene_fingerprint</string>
    <key>GPU_2D_LIVE_SOURCE_REVISION</key><string>$source_revision</string>
    <key>GPU_2D_LIVE_HOLD</key><string>1</string>
  </dict>
</dict>
</plist>
PLIST

open -n --stdout "$LAUNCH_OUT" --stderr "$LAUNCH_ERR" "$app" ||
    fail "launch-failed"

pid_deadline=$(($(date +%s) + 15))
while [ "$(date +%s)" -lt "$pid_deadline" ]; do
    app_pid="$(find_exact_app_pid)"
    [ -z "$app_pid" ] || break
    sleep 0.1
done
positive_integer "$app_pid" || fail "exact-launched-pid-missing"
require_launched_process

deadline=$(($(date +%s) + TIMEOUT_SECS))
while [ "$(date +%s)" -lt "$deadline" ]; do
    require_launched_process
    if [ -s "$READY" ] &&
            osascript - "$app_pid" >"$WINDOW_RECORD" 2>/dev/null <<'OSA'; then
on run argv
  set targetPid to (item 1 of argv) as integer
  tell application "System Events"
    repeat with proc in (processes whose unix id is targetPid)
      tell proc
        if (count of windows) > 0 then
          set targetWindow to window 1
          set position of targetWindow to {120, 100}
          set frontmost to true
          set p to position of targetWindow
          set s to size of targetWindow
          set windowNumber to value of attribute "AXWindowNumber" of targetWindow
          if windowNumber is missing value then error "GPU window id missing"
          set AppleScript's text item delimiters to ","
          return (targetPid as text) & "," & (item 1 of p as text) & "," & ¬
            (item 2 of p as text) & "," & (item 1 of s as text) & "," & ¬
            (item 2 of s as text) & "," & (windowNumber as text)
        end if
      end tell
    end repeat
  end tell
  error "GPU evidence window not ready"
end run
OSA
        break
    fi
    sleep 1
done
[ -s "$READY" ] || fail "render-ready-timeout"
[ -s "$WINDOW_RECORD" ] || fail "window-not-found"

window_record="$(tr -d '\r\n ' <"$WINDOW_RECORD")"
case "$window_record" in *,*,*,*,*,*) ;; *) fail "invalid-window-record" ;; esac
old_ifs=$IFS
IFS=,
set -- $window_record
IFS=$old_ifs
window_pid="${1:-}"
window_x="${2:-0}"
window_y="${3:-0}"
window_w="${4:-0}"
window_h="${5:-0}"
window_id="${6:-}"
[ "$window_pid" = "$app_pid" ] || fail "window-pid-mismatch"
positive_integer "$window_w" || fail "invalid-window-width"
positive_integer "$window_h" || fail "invalid-window-height"
positive_integer "$window_id" || fail "invalid-window-id"

require_launched_process
screencapture -x -o -l"$window_id" "$WINDOW_BEFORE_PNG" ||
    fail "before-window-capture-failed"
[ "$(file_bytes "$WINDOW_BEFORE_PNG")" -gt 1000 ] ||
    fail "before-window-capture-empty"

# The exact PID-owned window is frontmost before the ordered pointer/key input.
osascript - "$app_pid" "$window_id" >/dev/null <<'OSA' ||
    fail "window-focus-failed"
on run argv
  set targetPid to (item 1 of argv) as integer
  set targetWindowId to (item 2 of argv) as integer
  tell application "System Events"
    repeat with proc in (processes whose unix id is targetPid)
      tell proc
        repeat with targetWindow in windows
          set candidateWindowId to value of attribute "AXWindowNumber" of targetWindow
          if candidateWindowId = targetWindowId then
            set frontmost to true
            return true
          end if
        end repeat
      end tell
    end repeat
  end tell
  error "GPU evidence window identity missing"
end run
OSA

pointer_x=$((window_x + (window_w / 2)))
pointer_y=$((window_y + (window_h / 2)))
cliclick "m:${pointer_x},${pointer_y}" "dd:." "w:200" "du:." ||
    fail "pointer-injection-failed"
osascript - "$app_pid" >/dev/null <<'OSA' || fail "key-injection-failed"
on run argv
  set targetPid to (item 1 of argv) as integer
  tell application "System Events"
    repeat with proc in (processes whose unix id is targetPid)
      tell proc
        set frontmost to true
        key code 5
        return true
      end tell
    end repeat
  end tell
  error "GPU evidence process missing"
end run
OSA

receipt_deadline=$(($(date +%s) + 180))
while [ "$(date +%s)" -lt "$receipt_deadline" ] && [ ! -s "$RECEIPT" ]; do
    require_launched_process
    sleep 1
done
[ -s "$RECEIPT" ] || fail "runtime-receipt-timeout"
[ -s "$CAPTURE_PPM" ] || fail "framebuffer-capture-missing"

require_launched_process
screencapture -x -o -l"$window_id" "$WINDOW_AFTER_PNG" ||
    fail "after-window-capture-failed"
before_window_bytes="$(file_bytes "$WINDOW_BEFORE_PNG")"
after_window_bytes="$(file_bytes "$WINDOW_AFTER_PNG")"
before_window_cksum="$(file_cksum "$WINDOW_BEFORE_PNG")"
after_window_cksum="$(file_cksum "$WINDOW_AFTER_PNG")"
[ "$after_window_bytes" -gt 1000 ] || fail "after-window-capture-empty"
[ "$before_window_cksum" != "$after_window_cksum" ] ||
    fail "window-capture-unchanged"

[ "$(value_of gpu_2d_live_status "$RECEIPT")" = "pass" ] ||
    fail "runtime-status-failed"
[ "$(value_of gpu_2d_live_backend "$RECEIPT")" = "$BACKEND" ] ||
    fail "backend-mismatch"
[ "$(value_of gpu_2d_live_source "$RECEIPT")" = "device_readback" ] ||
    fail "device-readback-missing"
[ "$(value_of gpu_2d_live_width "$RECEIPT")" = "3840" ] ||
    fail "width-mismatch"
[ "$(value_of gpu_2d_live_height "$RECEIPT")" = "2160" ] ||
    fail "height-mismatch"
[ "$(value_of gpu_2d_live_dpi "$RECEIPT")" = "300" ] ||
    fail "dpi-mismatch"
[ "$(value_of gpu_2d_live_repo_revision "$RECEIPT")" = "$repo_revision" ] ||
    fail "repo-revision-mismatch"
[ "$(value_of gpu_2d_live_shared_scene_fingerprint "$RECEIPT")" = \
    "$shared_scene_fingerprint" ] || fail "shared-scene-fingerprint-mismatch"
[ "$(value_of gpu_2d_live_source_revision "$RECEIPT")" = "$source_revision" ] ||
    fail "source-revision-mismatch"
[ "$(value_of gpu_2d_live_event_sequence "$RECEIPT")" = \
    "focus,pointer_move,pointer_down,pointer_up,key_down,key_up" ] ||
    fail "event-sequence-mismatch"
[ "$(value_of gpu_2d_live_event_count "$RECEIPT")" = "6" ] ||
    fail "event-count-mismatch"
[ "$(value_of gpu_2d_live_event_backend "$RECEIPT")" = "$BACKEND" ] ||
    fail "event-backend-mismatch"
[ "$(value_of gpu_2d_live_draw_ir_composition_id "$RECEIPT")" = \
    "macos-gpu-2d-frozen-composition-v1" ] ||
    fail "shared-draw-ir-composition-mismatch"
[ "$(value_of gpu_2d_live_draw_ir_scene_key "$RECEIPT")" = \
    "macos-gpu-2d-frozen-scene-v1" ] ||
    fail "shared-draw-ir-scene-mismatch"
[ "$(value_of gpu_2d_live_draw_ir_rendered_commands "$RECEIPT")" = "5" ] ||
    fail "shared-draw-ir-render-count-mismatch"
[ "$(value_of gpu_2d_live_draw_ir_skipped_commands "$RECEIPT")" = "0" ] ||
    fail "shared-draw-ir-command-skipped"
[ "$(value_of gpu_2d_live_draw_ir_fallback_required "$RECEIPT")" = "false" ] ||
    fail "shared-draw-ir-fallback-required"
[ -z "$(value_of gpu_2d_live_draw_ir_fallback_reason "$RECEIPT")" ] ||
    fail "shared-draw-ir-unsupported-command"
[ "$(value_of gpu_2d_live_draw_ir_readback_source "$RECEIPT")" = \
    "device_readback" ] || fail "shared-draw-ir-device-readback-missing"
draw_ir_checksum="$(value_of gpu_2d_live_draw_ir_readback_checksum "$RECEIPT")"
positive_integer "$draw_ir_checksum" || fail "shared-draw-ir-checksum-missing"
[ "$(value_of gpu_2d_live_semantic_event "$RECEIPT")" = \
    "focus" ] || fail "semantic-event-mismatch"
[ "$(value_of gpu_2d_live_semantic_before_focus "$RECEIPT")" = \
    "macos-gpu-2d-root" ] || fail "semantic-before-focus-mismatch"
[ "$(value_of gpu_2d_live_semantic_after_focus "$RECEIPT")" = \
    "macos-gpu-2d-action" ] || fail "semantic-after-focus-mismatch"
[ "$(value_of gpu_2d_live_semantic_changed "$RECEIPT")" = "true" ] ||
    fail "semantic-mutation-missing"
[ "$(value_of gpu_2d_live_semantic_native_focus_reduced "$RECEIPT")" = "true" ] ||
    fail "native-focus-not-reduced"
[ "$(value_of gpu_2d_live_semantic_raw_winit_reduced "$RECEIPT")" = "true" ] ||
    fail "raw-winit-focus-not-reduced"
[ "$(value_of gpu_2d_live_semantic_pointer_key_delivery "$RECEIPT")" = \
    "observed" ] || fail "pointer-key-delivery-not-observed"
[ "$(value_of gpu_2d_live_semantic_correlation "$RECEIPT")" = \
    "native-focus-reduced;pointer-key-delivery-observed" ] ||
    fail "semantic-correlation-mismatch"
semantic_before_accent="$(value_of gpu_2d_live_semantic_before_accent "$RECEIPT")"
semantic_after_accent="$(value_of gpu_2d_live_semantic_after_accent "$RECEIPT")"
positive_integer "$semantic_before_accent" || fail "semantic-before-accent-missing"
positive_integer "$semantic_after_accent" || fail "semantic-after-accent-missing"
[ "$semantic_before_accent" != "$semantic_after_accent" ] ||
    fail "semantic-accent-unchanged"
[ "$(value_of gpu_2d_live_font_loaded "$RECEIPT")" = "true" ] ||
    fail "vector-font-not-loaded"
font_expected_identity="$(value_of gpu_2d_live_font_expected_identity "$RECEIPT")"
font_identity="$(value_of gpu_2d_live_font_identity "$RECEIPT")"
[ -n "$font_expected_identity" ] || fail "vector-font-expected-identity-missing"
[ "$font_identity" = "$font_expected_identity" ] ||
    fail "vector-font-identity-mismatch"
[ "$(value_of gpu_2d_live_font_warm_rasterizations "$RECEIPT")" = "0" ] ||
    fail "vector-font-warm-rerasterized"
font_point_size="$(value_of gpu_2d_live_font_point_size "$RECEIPT")"
font_dpi="$(value_of gpu_2d_live_font_dpi "$RECEIPT")"
font_pixel_size="$(value_of gpu_2d_live_font_pixel_size "$RECEIPT")"
positive_integer "$font_point_size" || fail "vector-font-point-size-missing"
positive_integer "$font_dpi" || fail "vector-font-dpi-missing"
positive_integer "$font_pixel_size" || fail "vector-font-pixel-size-missing"
[ "$font_point_size" = "24" ] && [ "$font_dpi" = "300" ] ||
    fail "vector-font-dpi-input-mismatch"
expected_font_pixel_size=$(((font_point_size * font_dpi + 36) / 72))
[ "$font_pixel_size" = "$expected_font_pixel_size" ] ||
    fail "vector-font-dpi-formula-mismatch"
[ "$(value_of gpu_2d_live_font_execution_target "$RECEIPT")" = "$BACKEND" ] ||
    fail "vector-font-not-executed-on-backend"
font_attempts="$(value_of gpu_2d_live_font_execution_attempts "$RECEIPT")"
printf '%s' "$font_attempts" | grep -Fq "$BACKEND" ||
    fail "vector-font-backend-attempt-missing"
font_cold="$(value_of gpu_2d_live_font_cold_rasterizations "$RECEIPT")"
font_hits="$(value_of gpu_2d_live_font_warm_hits "$RECEIPT")"
backend_handle="$(value_of gpu_2d_live_backend_handle "$RECEIPT")"
initial_checksum="$(value_of gpu_2d_live_initial_checksum "$RECEIPT")"
interaction_checksum="$(value_of gpu_2d_live_interaction_checksum "$RECEIPT")"
positive_integer "$font_cold" ||
    fail "vector-font-cold-rasterization-missing"
positive_integer "$font_hits" || fail "vector-font-warm-hit-missing"
positive_integer "$backend_handle" || fail "backend-handle-missing"
positive_integer "$initial_checksum" || fail "initial-checksum-missing"
positive_integer "$interaction_checksum" || fail "interaction-checksum-missing"
[ "$initial_checksum" != "$interaction_checksum" ] ||
    fail "interaction-checksum-unchanged"

ppm_bytes="$(wc -c <"$CAPTURE_PPM" | tr -d ' ')"
[ "$ppm_bytes" -gt 24883200 ] || fail "capture-truncated"
ppm_header="$(head -n 3 "$CAPTURE_PPM" | tr '\n' '|')"
[ "$ppm_header" = "P6|3840 2160|255|" ] || fail "capture-header-mismatch"
pixel_sha256="$(dd if="$CAPTURE_PPM" bs=1 skip=17 2>/dev/null |
    shasum -a 256 | awk '{print $1}')"
case "$pixel_sha256" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*)
        [ "${#pixel_sha256}" -eq 64 ] || fail "pixel-sha256-invalid" ;;
    *) fail "pixel-sha256-invalid" ;;
esac
non_background_bounds="$(value_of gpu_2d_live_non_background_bounds "$RECEIPT")"
case "$non_background_bounds" in
    *,*,*,*) ;;
    *) fail "non-background-bounds-missing" ;;
esac

sips -s format png "$CAPTURE_PPM" --out "$CAPTURE_PNG" >/dev/null ||
    fail "png-conversion-failed"
[ -s "$CAPTURE_PNG" ] || fail "png-conversion-empty"
sips -s dpiWidth 300 -s dpiHeight 300 "$CAPTURE_PNG" >/dev/null ||
    fail "png-dpi-write-failed"
png_width="$(sips -g pixelWidth "$CAPTURE_PNG" |
    awk '/pixelWidth:/{print $2}')"
png_height="$(sips -g pixelHeight "$CAPTURE_PNG" |
    awk '/pixelHeight:/{print $2}')"
[ "$png_width" = "3840" ] && [ "$png_height" = "2160" ] ||
    fail "png-dimensions-mismatch"
png_dpi_width="$(sips -g dpiWidth "$CAPTURE_PNG" |
    awk '/dpiWidth:/{printf "%.0f\n", $2; found=1} END {if (!found) exit 1}')" ||
    fail "png-dpi-mismatch"
png_dpi_height="$(sips -g dpiHeight "$CAPTURE_PNG" |
    awk '/dpiHeight:/{printf "%.0f\n", $2; found=1} END {if (!found) exit 1}')" ||
    fail "png-dpi-mismatch"
[ "$png_dpi_width" = "300" ] && [ "$png_dpi_height" = "300" ] ||
    fail "png-dpi-mismatch"

{
    echo "${PREFIX}_status=pass"
    echo "${PREFIX}_reason=pass"
    echo "${PREFIX}_driver_kind=$SELECTED_DRIVER_KIND"
    echo "${PREFIX}_driver_path=$SELECTED_DRIVER_PATH"
    echo "${PREFIX}_driver_sha256=$driver_sha256"
    echo "${PREFIX}_trusted_build_manifest=$TRUSTED_BUILD_MANIFEST"
    echo "${PREFIX}_trusted_build_manifest_sha256=$driver_manifest_sha256"
    echo "${PREFIX}_winit_provider_sha256=$winit_provider_sha256"
    echo "${PREFIX}_simple_runtime_provider_sha256=$simple_runtime_provider_sha256"
    echo "${PREFIX}_simple_runtime_c_provider_sha256=$simple_runtime_c_provider_sha256"
    echo "${PREFIX}_backend=$BACKEND"
    echo "${PREFIX}_repo_revision=$repo_revision"
    echo "${PREFIX}_shared_scene_fingerprint=$shared_scene_fingerprint"
    echo "${PREFIX}_source=device_readback"
    echo "${PREFIX}_backend_handle=$backend_handle"
    echo "${PREFIX}_initial_checksum=$initial_checksum"
    echo "${PREFIX}_interaction_checksum=$interaction_checksum"
    echo "${PREFIX}_width=3840"
    echo "${PREFIX}_height=2160"
    echo "${PREFIX}_dpi=300"
    echo "${PREFIX}_png_dpi_width=$png_dpi_width"
    echo "${PREFIX}_png_dpi_height=$png_dpi_height"
    echo "${PREFIX}_pixel_sha256=$pixel_sha256"
    echo "${PREFIX}_non_background_bounds=$non_background_bounds"
    echo "${PREFIX}_event_sequence=focus,pointer_move,pointer_down,pointer_up,key_down,key_up"
    echo "${PREFIX}_event_count=6"
    echo "${PREFIX}_event_backend=$BACKEND"
    echo "${PREFIX}_draw_ir_composition_id=macos-gpu-2d-frozen-composition-v1"
    echo "${PREFIX}_draw_ir_scene_key=macos-gpu-2d-frozen-scene-v1"
    echo "${PREFIX}_draw_ir_rendered_commands=5"
    echo "${PREFIX}_draw_ir_skipped_commands=0"
    echo "${PREFIX}_draw_ir_readback_checksum=$draw_ir_checksum"
    echo "${PREFIX}_semantic_event=focus"
    echo "${PREFIX}_semantic_before_focus=macos-gpu-2d-root"
    echo "${PREFIX}_semantic_after_focus=macos-gpu-2d-action"
    echo "${PREFIX}_semantic_before_accent=$semantic_before_accent"
    echo "${PREFIX}_semantic_after_accent=$semantic_after_accent"
    echo "${PREFIX}_semantic_changed=true"
    echo "${PREFIX}_semantic_native_focus_reduced=true"
    echo "${PREFIX}_semantic_raw_winit_reduced=true"
    echo "${PREFIX}_semantic_pointer_key_delivery=observed"
    echo "${PREFIX}_font_loaded=true"
    echo "${PREFIX}_font_expected_identity=$font_expected_identity"
    echo "${PREFIX}_font_identity=$font_identity"
    echo "${PREFIX}_font_cold_rasterizations=$font_cold"
    echo "${PREFIX}_font_warm_rasterizations=0"
    echo "${PREFIX}_font_warm_hits=$font_hits"
    echo "${PREFIX}_font_point_size=$font_point_size"
    echo "${PREFIX}_font_dpi=$font_dpi"
    echo "${PREFIX}_font_pixel_size=$font_pixel_size"
    echo "${PREFIX}_font_execution_target=$BACKEND"
    echo "${PREFIX}_source_revision=$source_revision"
    echo "${PREFIX}_pid=$app_pid"
    echo "${PREFIX}_executable=$app_executable"
    echo "${PREFIX}_window_id=$window_id"
    echo "${PREFIX}_window_rect=$window_x,$window_y,$window_w,$window_h"
    echo "${PREFIX}_window_before_png=$WINDOW_BEFORE_PNG"
    echo "${PREFIX}_window_after_png=$WINDOW_AFTER_PNG"
    echo "${PREFIX}_window_before_bytes=$before_window_bytes"
    echo "${PREFIX}_window_after_bytes=$after_window_bytes"
    echo "${PREFIX}_window_before_cksum=$before_window_cksum"
    echo "${PREFIX}_window_after_cksum=$after_window_cksum"
    echo "${PREFIX}_capture_path=$CAPTURE_PPM"
    echo "backend=$BACKEND"
    echo "target=macos-host"
    echo "width=3840"
    echo "height=2160"
    echo "dpi=300"
    echo "font_point_size=$font_point_size"
    echo "font_dpi=$font_dpi"
    echo "font_pixel_size=$font_pixel_size"
    echo "winit_provider_sha256=$winit_provider_sha256"
    echo "simple_runtime_provider_sha256=$simple_runtime_provider_sha256"
    echo "simple_runtime_c_provider_sha256=$simple_runtime_c_provider_sha256"
    echo "trusted_build_manifest=$TRUSTED_BUILD_MANIFEST"
    echo "trusted_build_manifest_sha256=$driver_manifest_sha256"
    echo "pixel_sha256=$pixel_sha256"
    echo "non_background_bounds=$non_background_bounds"
    echo "event_sequence=focus,pointer_move,pointer_down,pointer_up,key_down,key_up"
    echo "event_count=6"
    echo "event_backend=$BACKEND"
    echo "repo_revision=$repo_revision"
    echo "shared_scene_fingerprint=$shared_scene_fingerprint"
    echo "draw_ir_composition_id=macos-gpu-2d-frozen-composition-v1"
    echo "draw_ir_scene_key=macos-gpu-2d-frozen-scene-v1"
    echo "draw_ir_rendered_commands=5"
    echo "draw_ir_skipped_commands=0"
    echo "draw_ir_readback_checksum=$draw_ir_checksum"
    echo "semantic_event=focus"
    echo "semantic_before_focus=macos-gpu-2d-root"
    echo "semantic_after_focus=macos-gpu-2d-action"
    echo "semantic_before_accent=$semantic_before_accent"
    echo "semantic_after_accent=$semantic_after_accent"
    echo "semantic_changed=true"
    echo "semantic_native_focus_reduced=true"
    echo "semantic_raw_winit_reduced=true"
    echo "semantic_pointer_key_delivery=observed"
    echo "semantic_correlation=native-focus-reduced;pointer-key-delivery-observed"
    echo "capture_path=$CAPTURE_PPM"
    echo "source_revision=$source_revision"
} >"$EVIDENCE"

write_report pass "live-$BACKEND-device-readback-vector-font-ordered-events-exact-window"
cleanup
trap - EXIT HUP INT TERM
echo "macOS $BACKEND_TITLE 2D live evidence: PASS"
echo "report=$REPORT_PATH"
echo "capture=$CAPTURE_PNG"
