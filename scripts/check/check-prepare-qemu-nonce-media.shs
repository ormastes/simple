#!/bin/sh
set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
helper="$root/scripts/os/prepare_qemu_nonce_media.shs"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/simple-qemu-nonce-check.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

placeholder='SIMPLEOS_QEMU_NONCE=__SIMPLEOS_QEMU_NONCE_SLOT_V1__'
payload_placeholder='__SIMPLEOS_FS_EXEC_NONCE_SLOT_V1__'
printf '%s' "$placeholder" > "$tmp/base.img"
dd if=/dev/zero bs=1 count=$((118 - ${#placeholder})) >> "$tmp/base.img" 2>/dev/null
sh "$root/scripts/os/build_simpleos_fs_exec_probe.shs" arm64 \
    "$tmp/probe.elf" "$tmp/probe.manifest" >/dev/null
cat "$tmp/probe.elf" >> "$tmp/base.img"
base_hash="$(sha256sum "$tmp/base.img" | awk '{print $1}')"

result="$(sh "$helper" "$tmp/base.img" "$tmp/run.img" 'linux-arm64:abc_123')"
[ "$result" = "$tmp/run.img" ]
[ "$(sha256sum "$tmp/base.img" | awk '{print $1}')" = "$base_hash" ]
grep -aFq 'SIMPLEOS_QEMU_NONCE=linux-arm64:abc_123' "$tmp/run.img"
grep -aFq 'linux-arm64:abc_123' "$tmp/run.img"
grep -Fqx 'readback=pass' "$tmp/run.img.fs-exec-receipt"
grep -Eq '^elf_sha256=[0-9a-f]{64}$' "$tmp/run.img.fs-exec-receipt"
[ "$(sed -n 's/^image_sha256=//p' "$tmp/run.img.fs-exec-receipt")" = \
  "$(sha256sum "$tmp/run.img" | awk '{print $1}')" ]
expected_elf="$tmp/expected-patched.elf"
cp "$tmp/probe.elf" "$expected_elf"
expected_slot="$(LC_ALL=C grep -aob "$payload_placeholder" "$expected_elf" | cut -d: -f1)"
dd if=/dev/zero of="$tmp/expected-nonce" bs=96 count=1 2>/dev/null
printf '%s' 'linux-arm64:abc_123' | dd of="$tmp/expected-nonce" conv=notrunc 2>/dev/null
dd if="$tmp/expected-nonce" of="$expected_elf" bs=1 seek="$expected_slot" count=96 conv=notrunc 2>/dev/null
expected_extent="$(sed -n 's/^elf_size=//p' "$tmp/run.img.fs-exec-receipt")"
head -c "$expected_extent" "$expected_elf" > "$tmp/expected-patched-extent.elf"
[ "$(sed -n 's/^elf_sha256=//p' "$tmp/run.img.fs-exec-receipt")" = \
  "$(sha256sum "$tmp/expected-patched-extent.elf" | awk '{print $1}')" ]
if grep -aFq "$payload_placeholder" "$tmp/run.img"; then
    echo "nonce helper left filesystem child placeholder" >&2
    exit 1
fi

printf 'no-slot\n' > "$tmp/malformed.img"
if sh "$helper" "$tmp/malformed.img" "$tmp/rejected.img" nonce >/dev/null 2>&1; then
    echo "nonce helper accepted missing slot" >&2
    exit 1
fi
[ ! -e "$tmp/rejected.img" ]

# Each required slot is independently fail-closed.
printf '%s' "$placeholder" > "$tmp/no-payload-slot.img"
if sh "$helper" "$tmp/no-payload-slot.img" "$tmp/no-payload-run.img" nonce >/dev/null 2>&1; then
    echo "nonce helper accepted missing filesystem child slot" >&2
    exit 1
fi
printf '%s' "$payload_placeholder" > "$tmp/no-qemu-slot.img"
if sh "$helper" "$tmp/no-qemu-slot.img" "$tmp/no-qemu-run.img" nonce >/dev/null 2>&1; then
    echo "nonce helper accepted missing QEMU media slot" >&2
    exit 1
fi

printf '%s%s' "$placeholder" "$payload_placeholder" > "$tmp/no-elf.img"
if sh "$helper" "$tmp/no-elf.img" "$tmp/no-elf-run.img" nonce >/dev/null 2>&1; then
    echo "nonce helper accepted slots outside a valid ELF" >&2
    exit 1
fi
[ ! -e "$tmp/no-elf-run.img" ]

printf '%s%s' "$placeholder" "$placeholder" > "$tmp/duplicate.img"
printf '%s' "$payload_placeholder" >> "$tmp/duplicate.img"
if sh "$helper" "$tmp/duplicate.img" "$tmp/duplicate-run.img" nonce >/dev/null 2>&1; then
    echo "nonce helper accepted duplicate slots" >&2
    exit 1
fi
[ ! -e "$tmp/duplicate-run.img" ]

printf '%s%s%s' "$placeholder" "$payload_placeholder" "$payload_placeholder" \
    > "$tmp/duplicate-payload.img"
if sh "$helper" "$tmp/duplicate-payload.img" "$tmp/duplicate-payload-run.img" nonce >/dev/null 2>&1; then
    echo "nonce helper accepted duplicate filesystem child slots" >&2
    exit 1
fi
[ ! -e "$tmp/duplicate-payload-run.img" ]

if sh "$helper" "$tmp/base.img" "$tmp/base.img" nonce >/dev/null 2>&1; then
    echo "nonce helper accepted in-place mutation" >&2
    exit 1
fi
[ "$(sha256sum "$tmp/base.img" | awk '{print $1}')" = "$base_hash" ]

# Reproduce the production image scale that exposed the old byte-at-a-time
# whole-tail copy. The payload deliberately remains near the front so a broken
# implementation would copy almost the entire sparse 128 MiB image.
cp "$tmp/base.img" "$tmp/perf-base.img"
dd if=/dev/zero of="$tmp/perf-base.img" bs=1048576 count=0 seek=128 2>/dev/null
perf_base_hash="$(sha256sum "$tmp/perf-base.img" | awk '{print $1}')"
perf_limit="${SIMPLEOS_QEMU_NONCE_PERF_MAX_SECONDS:-20}"
case "$perf_limit" in ''|*[!0-9]*) echo "invalid perf limit: $perf_limit" >&2; exit 1 ;; esac
perf_start="$(date +%s)"
perf_result="$(sh "$helper" "$tmp/perf-base.img" "$tmp/perf-run.img" 'linux-arm64:perf_128m')"
perf_end="$(date +%s)"
perf_elapsed=$((perf_end - perf_start))
[ "$perf_result" = "$tmp/perf-run.img" ]
[ "$(wc -c < "$tmp/perf-run.img" | tr -d ' ')" -eq 134217728 ]
[ "$(sha256sum "$tmp/perf-base.img" | awk '{print $1}')" = "$perf_base_hash" ]
grep -Fqx 'readback=pass' "$tmp/perf-run.img.fs-exec-receipt"
if [ "$perf_elapsed" -gt "$perf_limit" ]; then
    echo "nonce helper 128MiB perf gate exceeded: ${perf_elapsed}s > ${perf_limit}s" >&2
    exit 1
fi
printf 'prepare-qemu-nonce-media 128MiB perf: PASS elapsed_seconds=%s limit_seconds=%s\n' \
    "$perf_elapsed" "$perf_limit"

echo "prepare-qemu-nonce-media contract: PASS"
