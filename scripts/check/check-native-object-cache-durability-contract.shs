#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
driver="$root/src/compiler/80.driver/driver_aot_native_output.spl"
index="$root/src/compiler/80.driver/driver_build/incremental.spl"

grep -q 'driver_native_object_has_host_magic' "$driver"
grep -q 'driver_native_object_is_publishable' "$driver"
grep -q 'output_sha256' "$index"
grep -q 'rt_file_sync(tmp)' "$driver"
! grep -q 'rt_file_sync(obj_path)' "$driver"
grep -q 'rt_file_sync(tmp)' "$index"
grep -q 'rt_file_move(tmp, self.cache_path)' "$index"
grep -q 'rt_file_sync(dir)' "$index"
grep -q 'driver_native_publish_object' "$driver"
grep -q 'rt_file_sync(publish_dir)' "$driver"
grep -q 'object_format' "$index"
grep -q 'target_scope' "$index"
grep -q 'rt_path_absolute(obj)' "$driver"
! grep -q 'entries.len() % 5' "$driver"
! grep -q '_compile_one_module_and_cache' "$driver"

# Execute the actual Simple BuildCache owner. A compiler-tree blocker is HOLD,
# never replaced by a shell reimplementation of the cache/index protocol.
if ! "$root/bin/simple" test "$root/test/01_unit/compiler/driver/native_build_cache_plumbing_spec.spl" --mode=interpreter; then
    echo 'HOLD native_object_cache_durability_contract: executable Simple owner test did not complete' >&2
    exit 2
fi
printf '%s\n' 'PASS native_object_cache_durability_contract'
