#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)"
BUILD_DIR="${STREAMING_SOURCE_OWNER_MODEL_BUILD_DIR:-$ROOT_DIR/build/streaming_source_owner_reclaim_model}"
CC_BIN="${CC:-cc}"
mkdir -p "$BUILD_DIR"

"$CC_BIN" -std=c11 -O2 -Wall -Wextra -Werror \
    "$ROOT_DIR/src/runtime/test/rt_streaming_source_owner_reclaim_model.c" \
    -o "$BUILD_DIR/model"

/usr/bin/time -f 'elapsed_seconds=%e\npeak_rss_kib=%M' \
    -o "$BUILD_DIR/time.env" "$BUILD_DIR/model" > "$BUILD_DIR/model.env"
cat "$BUILD_DIR/model.env"
cat "$BUILD_DIR/time.env"

grep -qx 'retained_before_bytes=67108864' "$BUILD_DIR/model.env"
grep -qx 'retained_after_bytes=33554432' "$BUILD_DIR/model.env"
grep -qx 'reclaimed_owner_bytes=33554432' "$BUILD_DIR/model.env"
grep -qx 'owner_allocations_after=0' "$BUILD_DIR/model.env"
printf '%s\n' 'streaming_source_owner_reclaim_model_status=pass'
