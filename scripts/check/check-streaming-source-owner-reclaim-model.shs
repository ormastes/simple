#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)"
BUILD_DIR="${STREAMING_SOURCE_OWNER_MODEL_BUILD_DIR:-$ROOT_DIR/build/streaming_source_owner_reclaim_model}"
CC_BIN="${CC:-cc}"
mkdir -p "$BUILD_DIR"

TYPES="$ROOT_DIR/src/compiler/80.driver/driver_types.spl"
LOWERING="$ROOT_DIR/src/compiler/80.driver/driver_hir_pipeline_lowering.spl"
types_owner=$(sed -n '/me reclaim_streaming_source_contents_owner()/,/me source_contents_reclaimable()/p' "$TYPES")
printf '%s\n' "$types_owner" | grep -F 'rt_string_free(content)' >/dev/null
printf '%s\n' "$types_owner" | grep -F 'self.source_contents_owner = []' >/dev/null
lowering_owner=$(sed -n '/me lower_and_check_streaming_surfaces_impl()/,/me lower_and_check_impl()/p' "$LOWERING")
release_line=$(printf '%s\n' "$lowering_owner" | grep -n -m1 'reclaim_streaming_source_contents_owner()' | cut -d: -f1)
evict_line=$(printf '%s\n' "$lowering_owner" | grep -n -m1 'self.ctx.evict_sources()' | cut -d: -f1)
[ -n "$release_line" ] && [ -n "$evict_line" ] && [ "$release_line" -lt "$evict_line" ]
test "$(printf '%s\n' "$lowering_owner" | grep -c 'reclaim_streaming_source_contents_owner()')" -eq 1
printf '%s\n' "$lowering_owner" | grep -F 'self.streaming_module_surfaces_owner = nil' >/dev/null
printf '%s\n' "$lowering_owner" | grep -F 'self.streaming_surface_owner_ready = false' >/dev/null

"$CC_BIN" -std=c11 -O2 -Wall -Wextra -Werror \
    "$ROOT_DIR/src/runtime/test/rt_streaming_source_owner_reclaim_model.c" \
    -o "$BUILD_DIR/model"

/usr/bin/time -f 'elapsed_seconds=%e\npeak_rss_kib=%M' \
    -o "$BUILD_DIR/time.env" "$BUILD_DIR/model" > "$BUILD_DIR/model.env"
cat "$BUILD_DIR/model.env"
cat "$BUILD_DIR/time.env"

grep -qx 'retained_before_bytes=67108864' "$BUILD_DIR/model.env"
grep -qx 'retained_after_bytes=33554432' "$BUILD_DIR/model.env"
grep -qx 'reclaimed_owner_bytes=33554432' "$BUILD_DIR/model.env"
grep -qx 'owner_allocations_after=0' "$BUILD_DIR/model.env"
printf '%s\n' 'streaming_source_owner_reclaim_model_status=pass'
