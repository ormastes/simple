#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/simpleos-bare-spans.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM

cc_bin="${CC:-clang}"
stubs="$repo_root/examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c"
test_src="$repo_root/test/09_baselines/engine2d_simd/baremetal_engine2d_span_test.c"

"$cc_bin" -c -O3 -ffunction-sections -fdata-sections \
    -D_start=simpleos_bare_start -Wno-error=implicit-function-declaration \
    -o "$work_dir/stubs.o" "$stubs"
"$cc_bin" -c -O3 -ffunction-sections -fdata-sections \
    -o "$work_dir/test.o" "$test_src"
"$cc_bin" -Wl,--gc-sections -o "$work_dir/test" \
    "$work_dir/test.o" "$work_dir/stubs.o"
"$work_dir/test"

echo "simpleos-baremetal-engine2d-spans: pass"
