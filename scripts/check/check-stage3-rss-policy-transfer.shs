#!/bin/sh
# Shell transport unit controls only: no compiler, cgroup, service or VM starts.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
python3 - "$root" <<'PY'
import os
import pathlib
import re
import shlex
import subprocess
import sys
import tempfile

root = pathlib.Path(sys.argv[1])
launcher = (root / 'scripts/bootstrap/resume-stage3-from-admitted.sh').read_text()
worker = root / 'scripts/bootstrap/lib/stage3-native-build-worker.sh'
policy = launcher.split('stage3_rss_cap_mode=${', 1)[1].split('\nBOOTSTRAP_STAGE3_FACADE_PATH=', 1)[0]
policy = 'stage3_rss_cap_mode=${' + policy
launch = launcher.split('worker="$root/scripts/bootstrap/lib/stage3-native-build-worker.sh"', 1)[1]
launch = 'worker="$root/scripts/bootstrap/lib/stage3-native-build-worker.sh"' + launch.split('\nstage3_guard_pid=$!', 1)[0] + '\nwait $!\n'

def run(code, env, expected=0):
    result = subprocess.run(['/bin/sh', '-eu', '-c', code], env=env, text=True, capture_output=True)
    assert result.returncode == expected, (result.returncode, expected, result.stdout, result.stderr)
    return result

with tempfile.TemporaryDirectory(prefix='stage3-policy-') as tmp:
    base = pathlib.Path(tmp)
    fixture = base / 'repo'
    bindir = base / 'bin'
    bindir.mkdir()
    fixture_worker = fixture / 'scripts/bootstrap/lib/stage3-native-build-worker.sh'
    fixture_worker.parent.mkdir(parents=True)
    policy_helper = fixture / 'scripts/bootstrap/lib/stage3-source-policy.shs'
    policy_helper.parent.mkdir(parents=True, exist_ok=True)
    policy_helper.write_text((root / 'scripts/bootstrap/lib/stage3-source-policy.shs').read_text())
    tree_policy = fixture / 'scripts/bootstrap/lib/tree-rss-policy.shs'
    tree_policy.write_text((root / 'scripts/bootstrap/lib/tree-rss-policy.shs').read_text())
    facade = fixture / 'scripts/check/lib/bootstrap-stage3-provenance.shs'
    facade.parent.mkdir(parents=True)
    capture = base / 'capture'

    def script(path, content):
        path.write_text('#!/bin/sh\nset -eu\n' + content)
        path.chmod(0o755)

    # A service deliberately drops all caller environment and supplies a stale
    # manager policy; only worker argv may carry the requested policy across it.
    script(bindir / 'systemd-run', '''
while [ "$#" -gt 0 ]; do case "$1" in --*) shift ;; *) break ;; esac; done
exec env -i PATH=/usr/bin:/bin SIMPLE_BOOTSTRAP_RSS_CAP_MODE=enforce "$@"
''')
    for name in ('perl', 'join'):
        script(bindir / name, '''
while [ "$1" != -- ]; do shift; done
shift
exec "$@"
''')
    script(fixture_worker, 'printf "%s\\n" "$@" > ' + shlex.quote(str(capture)) + '\n')
    env = {'PATH': str(bindir) + ':/usr/bin:/bin'}
    defaults = {name: 'fixture' for name in re.findall(r'\$\{?([A-Za-z_][A-Za-z_0-9]*)', launch)}
    defaults.update(root=str(fixture), stage3_cgroupfs_python='/bin/sh',
                    stage3_cgroupfs_helper=str(bindir / 'join'),
                    SIMPLE_BOOTSTRAP_STAGE3_HEADROOM_MIB='49152',
                    SIMPLE_BOOTSTRAP_STAGE3_PROCESS_MAX_MIB='51200',
                    SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB='5859375')
    helpers = '''
bootstrap_stage3_error() { exit 2; }
bootstrap_stage3_cgroupfs_call() { :; }
bootstrap_stage3_memory_darwin_rss_cap_kib() { echo 5859375; }
bootstrap_stage3_memory_darwin_session_mode() { echo new; }
'''
    for route, platform in [('systemd', 'aarch64-unknown-linux-gnu'),
                            ('systemd', 'riscv64-unknown-linux-gnu'),
                            ('cgroupfs', 'aarch64-unknown-linux-gnu'),
                            ('darwin', 'aarch64-apple-darwin'),
                            ('portable', 'x86_64-unknown-freebsd')]:
        values = dict(defaults, platform=platform, stage3_containment_backend=route,
                      stage3_guard_watch='linux-proc-memavailable' if route in ('systemd', 'cgroupfs') else 'portable')
        setup = ''.join(f'{k}={shlex.quote(v)}\n' for k, v in values.items())
        for mode in (None, 'enforce', 'monitor'):
            case_env = dict(env)
            if mode is not None:
                case_env['SIMPLE_BOOTSTRAP_RSS_CAP_MODE'] = mode
            run(setup + helpers + 'set -- --source src/app --entry-closure\n' + policy + launch, case_env)
            args = capture.read_text().splitlines()
            assert len(args) == 37 and args[32:] == [
                mode or 'enforce', '--stage3-source-policy-v1',
                '--source', 'src/app', '--entry-closure'], (route, args)
            assert args[7] == platform, (route, args[7])
        print(f'PASS: {route} {platform}: explicit monitor, enforce and default transport')
    for invalid in ('', 'disabled', 'MONITOR', 'monitor enforce'):
        run(helpers + policy + 'exit 99', dict(env, SIMPLE_BOOTSTRAP_RSS_CAP_MODE=invalid), 2)

    # Source the production command-snapshot owner and replace only its final
    # watchdog executable with a recording Perl spy. No compiler is invoked.
    facade.write_text(
        '. ' + shlex.quote(str(root / 'scripts/check/lib/bootstrap-stage3/authority.shs')) + '\n' +
        '. ' + shlex.quote(str(root / 'scripts/check/lib/bootstrap-stage3/command-snapshot.shs')) + '\n')
    watchdog_spy = fixture / 'scripts/resource/process-tree-rss-watchdog.pl'
    watchdog_spy.parent.mkdir(parents=True)
    watchdog_spy.write_text('use strict; use warnings; print "observed-session=", ($ENV{SIMPLE_BOOTSTRAP_SESSION_ID} // "unset"), "|", ($ENV{SIMPLE_BOOTSTRAP_SESSION_EXEC} // "unset"), "\\n"; print join("\\n", @ARGV), "\\n"; exit 73;\n')
    admitted = base / 'admitted'
    admitted.write_text('NONEXECUTABLE TEST DATA\n')
    import hashlib
    digest = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()
    receipt = base / 'admission.env'
    receipt.write_text('schema=simple-bootstrap-stage2-admission-v2\nstatus=admitted\nsimple_abi_policy=v1\ncandidate_sha256=' + digest(admitted) + '\n')
    args = ['fixture'] * 32
    args[0], args[1], args[2] = str(base / 'worker.transcript'), str(fixture), str(base / 'worker.log')
    args[3], args[4], args[5] = str(base / 'home'), str(base / 'tmp'), '/usr/bin:/bin'
    args[6], args[7] = str(admitted), 'aarch64-apple-darwin'
    args[8], args[9], args[10] = 'cranelift', '1', ''
    args[11], args[12], args[13] = str(base / 'cache'), str(base / 'runtime'), str(base / 'candidate')
    args[14], args[15], args[16], args[17] = str(base / 'progress'), str(base / 'profile'), str(base / 'memory'), 'fixture-id'
    args[18:25] = ['direct', 'none', '4194304', '', '', '', '1']
    args[25:28] = ['v1', str(receipt), digest(receipt)]
    args[28:32] = ['', '', '1000', 'per-file']
    args += ['enforce', '--stage3-source-policy-v1', '--source', 'src/app', '--entry-closure']
    (base / 'home').mkdir()
    (base / 'tmp').mkdir()
    cap_args = None
    for invalid in ('', 'disabled', 'MONITOR', 'monitor enforce'):
        invalid_args = list(args)
        invalid_args[32] = invalid
        invalid_command = ' '.join(map(shlex.quote, ['/bin/sh', str(worker)] + invalid_args))
        invalid_result = run(invalid_command, dict(env, PATH='/usr/bin:/bin'), 64)
        assert 'invalid typed RSS cap mode' in invalid_result.stderr
    for requested, ambient in [('monitor', 'enforce'), ('enforce', 'monitor'), ('enforce', None)]:
        worker_args = list(args)
        worker_args[32] = requested
        command = ' '.join(map(shlex.quote, ['/bin/sh', str(worker)] + worker_args))
        case_env = dict(env, PATH='/usr/bin:/bin')
        if ambient is not None:
            case_env['SIMPLE_BOOTSTRAP_RSS_CAP_MODE'] = ambient
        result = run(command, case_env, 73)
        watchdog_args = pathlib.Path(worker_args[2]).read_text().splitlines()
        assert f'--rss-cap-mode={requested}' in watchdog_args, (watchdog_args, result.stderr)
        assert 'observed-session=unset|unset' in watchdog_args, watchdog_args
        assert not ambient or f'--rss-cap-mode={ambient}' not in watchdog_args, watchdog_args
        assert '--session-mode=new' in watchdog_args, watchdog_args
        current_caps = [arg for arg in watchdog_args if arg.startswith((
            '--max-rss-kib=', '--compiler-jobs=', '--cap-source=', '--cap-bound='))]
        assert current_caps and (cap_args is None or current_caps == cap_args), (current_caps, cap_args)
        cap_args = current_caps
        separator = watchdog_args.index('--')
        assert not any(arg.startswith('SIMPLE_BOOTSTRAP_RSS_CAP_MODE=') for arg in watchdog_args[separator + 1:])
        transcript_rows = pathlib.Path(worker_args[0]).read_text().splitlines()
        shard_rows = [row.split(':', 2)[2] for row in transcript_rows if row.startswith('explicit-env:')
                      and 'SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB=' in row]
        assert len(shard_rows) == 1, shard_rows
        shard_budget = shard_rows[0].split('=', 1)[1]
        assert (shard_budget == '0') == (requested == 'monitor'), (requested, shard_budget)
        session_env = dict(case_env, SIMPLE_BOOTSTRAP_RSS_CAP_MODE=ambient or requested,
                           SIMPLE_BOOTSTRAP_SESSION_ID='123', SIMPLE_BOOTSTRAP_SESSION_EXEC='/fixture/session-helper')
        result = run(command, session_env, 73)
        session_args = pathlib.Path(worker_args[2]).read_text().splitlines()
        assert f'--rss-cap-mode={requested}' in session_args, session_args
        assert '--session-mode=inherit' in session_args, session_args
        assert 'observed-session=123|/fixture/session-helper' in session_args, session_args
    args[27] = '0' * 64
    result = run(' '.join(map(shlex.quote, ['/bin/sh', str(worker)] + args)), env, 64)
    assert 'verified ABI admission transfer is absent or changed' in result.stderr
    args[27] = digest(receipt)
    run(' '.join(map(shlex.quote, ['/bin/sh', str(worker)] + args[:-3])), env, 64)
    print('PASS: worker policy validation, stale environment override, session preservation, ABI refusal and arity')
print('PASS: shell transport controls only; native and real systemd/cgroup execution remain unrun')
PY
