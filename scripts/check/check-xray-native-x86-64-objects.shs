#!/bin/sh
# check-xray-native-x86-64-objects.shs — XRay PR6: the pure-Simple native
# x86-64 backend emits SysV sleds + `.simple_xray_map`, the pure-Simple
# patcher's decisions are recorded, and the resident x86-64 trampoline matches
# its Simple twin byte for byte.
#
# Design: doc/04_architecture/compiler/xray/xray_compiler_structural_change_2026-11-06.md
# A.5, C.2 and the section F PR6 row.
#
# What it does (any host; cross-emits x86-64)
#   1. Runs test/fixtures/xray/xray_native_x86_64_e2e_driver.spl under the
#      given Simple binary: real frontend -> MIR -> --xray policy -> native
#      x86-64 object, the same module OFF, leaf admission through
#      trace_native_map_validate_v1 + XrayNativeSledLeafV1, and two PR4
#      control-plane sessions over a recording port (ops.txt).
#   2. Object inspection with llvm-readelf / llvm-objdump: `.simple_xray_map`
#      is SHF_ALLOC|SHF_LINK_ORDER linked to .text; one R_X86_64_PLT32 to
#      __simple_xray_trampoline_v1 per sled at sled+3; one R_X86_64_PC64
#      text_base at map+0x24; every sled disassembles as jmp +0xb / callq /
#      jmp +4 on an even address; the OFF object has no xray section/symbol.
#   3. Cross-compiles src/runtime/xray/xray_native_runtime_x86_64.c with
#      clang (never GCC) and compares its trampoline bytes with the Simple
#      twin xray_native_trampoline_x86_64_v1; the trampoline must be
#      PROTECTED and the registry entry points exported.
#   4. ops.txt must switch only 2-byte activation words (EB 0B <-> 66 90).
#
# NOT done here: executing the patched code. That is
# scripts/check/check-xray-native-x86-64-inprocess-e2e.shs (x86-64 Linux host;
# .github/workflows/xray-x86-64-e2e.yml runs it on a GitHub x86-64 runner).
#
# Verdict (last stdout line):
#   PASS — <n> check(s) (...)              exit 0
#   FAIL — <reason>                        exit 1
#   ERROR — nothing was checked (<reason>) exit 2
# --selftest runs before every scan and is fatal.
#
# Usage
#   sh scripts/check/check-xray-native-x86-64-objects.shs --simple <bin> [--keep]
#   sh scripts/check/check-xray-native-x86-64-objects.shs --selftest
# Env: CLANG, LLVM_OBJDUMP, LLVM_READELF, LLVM_OBJCOPY, XRAY_E2E_TIMEOUT (s, 1500).

set -u

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
SIMPLE_BIN=${SIMPLE_BIN:-}
KEEP=0
SELFTEST_ONLY=0
CC=${CLANG:-clang}
OBJDUMP=${LLVM_OBJDUMP:-llvm-objdump}
READELF=${LLVM_READELF:-llvm-readelf}
OBJCOPY=${LLVM_OBJCOPY:-llvm-objcopy}
STEP_TIMEOUT=${XRAY_E2E_TIMEOUT:-1500}

while [ $# -gt 0 ]; do
    case "$1" in
        --simple) SIMPLE_BIN=${2:-}; shift 2 ;;
        --keep) KEEP=1; shift ;;
        --selftest) SELFTEST_ONLY=1; shift ;;
        -h|--help) sed -n '2,40p' "$0"; exit 0 ;;
        *) echo "ERROR — nothing was checked (unknown argument: $1)"; exit 2 ;;
    esac
done

# Classify a count check: 0 equal, 1 differ, 2 not a number.
count_verdict() {
    case "$1" in ''|*[!0-9]*) return 2 ;; esac
    [ "$1" -eq "$2" ] && return 0
    return 1
}

# ops.txt may store only the two x86-64 activation words, and only as u16.
ops_words_ok() {
    bad=$(printf '%s\n' "$1" | awk '($1=="store16" && $3!=3051 && $3!=36966) || ($1 ~ /^store/ && $1!="store16")' | wc -l)
    stores=$(printf '%s\n' "$1" | grep -c '^store16 ')
    [ "$bad" -eq 0 ] && [ "$stores" -gt 0 ]
}

selftest() {
    count_verdict 2 2; [ $? -eq 0 ] || return 1
    count_verdict 1 2; [ $? -eq 1 ] || return 1
    count_verdict "" 2; [ $? -eq 2 ] || return 1
    ops_words_ok "store16 0 36966
store16 78 3051" || return 1
    ops_words_ok "store16 0 37008" && return 1
    ops_words_ok "begin 0 4096" && return 1
    ops_words_ok "store16 0 36966
store 4 1" && return 1
    return 0
}

if ! selftest; then
    echo "ERROR — nothing was checked (selftest failed: a fixture was misjudged)"
    exit 2
fi
if [ "$SELFTEST_ONLY" -eq 1 ]; then
    echo "PASS — 7 check(s) (selftest: count and ops-word fixtures)"
    exit 0
fi

[ -n "$SIMPLE_BIN" ] || { echo "ERROR — nothing was checked (no --simple binary)"; exit 2; }
case "$SIMPLE_BIN" in /*) ;; */*) SIMPLE_BIN=$(cd "$(dirname "$SIMPLE_BIN")" && pwd)/$(basename "$SIMPLE_BIN") ;; esac
for tool in "$SIMPLE_BIN" "$CC" "$OBJDUMP" "$READELF" "$OBJCOPY" xxd; do
    command -v "$tool" >/dev/null 2>&1 || { echo "ERROR — nothing was checked (missing tool: $tool)"; exit 2; }
done
case "$("$CC" --version 2>&1 | head -1)" in
    *clang*) ;;
    *) echo "ERROR — nothing was checked ($CC is not clang)"; exit 2 ;;
esac

WORK=$(mktemp -d "${TMPDIR:-/tmp}/xray-x86-objects.XXXXXX") || {
    echo "ERROR — nothing was checked (cannot create temp dir)"; exit 2; }
cleanup() { [ "$KEEP" -eq 1 ] && echo "kept: $WORK" >&2 || rm -rf "$WORK"; }
trap cleanup EXIT
cd "$ROOT" || { echo "ERROR — nothing was checked (cannot cd to $ROOT)"; exit 2; }

checks=0
expect_count() { # label actual expected
    count_verdict "$2" "$3"
    case $? in
        0) checks=$((checks + 1)) ;;
        1) echo "FAIL — $1: $2 (want $3)"; exit 1 ;;
        *) echo "ERROR — nothing was checked ($1: no count)"; exit 2 ;;
    esac
}

# Resident runtime first: the twin needs its handler CALL displacement.
# Flags mirror xray_native_runtime_cflags_v1 (driver_xray_link.spl) for
# x86_64; keep them in lockstep or the twin verifies another object.
"$CC" --target=x86_64-unknown-linux-gnu -O2 -fPIC -ffreestanding -mgeneral-regs-only \
    -c src/runtime/xray/xray_native_runtime_x86_64.c -o "$WORK/rt.o" > "$WORK/cc.log" 2>&1 || {
    echo "FAIL — x86-64 resident runtime does not compile: $(head -1 "$WORK/cc.log")"; exit 1; }
"$READELF" -s -W "$WORK/rt.o" > "$WORK/rt.syms" 2>&1
expect_count "PROTECTED __simple_xray_trampoline_v1" "$(grep -cE 'FUNC +GLOBAL +PROTECTED .* __simple_xray_trampoline_v1$' "$WORK/rt.syms")" 1
expect_count "exported register/install entry points" "$(grep -cE 'FUNC +GLOBAL +PROTECTED .* simple_xray_native_(register_module|install)_v1$' "$WORK/rt.syms")" 2
"$OBJCOPY" -O binary --only-section=.text "$WORK/rt.o" "$WORK/rt_text.bin"
# The trampoline is the first function of .text; its handler CALL rel32 is at 173.
rel_hex=$(dd if="$WORK/rt_text.bin" bs=1 skip=173 count=4 2>/dev/null | xxd -p)
[ ${#rel_hex} -eq 8 ] || { echo "ERROR — nothing was checked (cannot read trampoline CALL)"; exit 2; }
rel=$(printf '%s' "$rel_hex" | sed 's/\(..\)\(..\)\(..\)\(..\)/\4\3\2\1/')
rel=$(printf '%d' "0x$rel")
[ "$rel" -ge 2147483648 ] && rel=$((rel - 4294967296))

XRAY_E2E_OUT=$WORK XRAY_TWIN_REL32=$rel timeout "$STEP_TIMEOUT" "$SIMPLE_BIN" run \
    test/fixtures/xray/xray_native_x86_64_e2e_driver.spl > "$WORK/driver.log" 2>&1
driver_rc=$?
if ! grep -q '^E2E-DRIVER-OK' "$WORK/driver.log"; then
    reason=$(grep -E 'E2E-DRIVER-ERROR|error' "$WORK/driver.log" | head -1)
    echo "FAIL — Simple driver did not complete (rc=$driver_rc): $reason"
    exit 1
fi
sites=$(sed -n 's/^E2E-DRIVER-OK sites=\([0-9][0-9]*\).*/\1/p' "$WORK/driver.log")
[ -n "$sites" ] && [ "$sites" -gt 0 ] || { echo "ERROR — nothing was checked (driver reported no sites)"; exit 2; }
xxd -r -p "$WORK/on.hex" "$WORK/on.o" && xxd -r -p "$WORK/off.hex" "$WORK/off.o" || {
    echo "ERROR — nothing was checked (cannot decode objects)"; exit 2; }

twin=$(cat "$WORK/twin.hex" 2>/dev/null)
built=$(head -c $((${#twin} / 2)) "$WORK/rt_text.bin" | xxd -p | tr -d '\n')
[ ${#twin} -eq 664 ] || { echo "FAIL — Simple twin trampoline is ${#twin} hex digits (want 664)"; exit 1; }
[ "$twin" = "$built" ] || { echo "FAIL — Simple twin differs from the assembled x86-64 trampoline"; exit 1; }
checks=$((checks + 1))

"$READELF" -S -W "$WORK/on.o" > "$WORK/on.sections" 2>&1
map_line=$(grep -E '\] \.simple_xray_map ' "$WORK/on.sections")
[ -n "$map_line" ] || { echo "FAIL — no .simple_xray_map section in the --xray object"; exit 1; }
text_idx=$(sed -n 's/^ *\[ *\([0-9][0-9]*\)\] \.text .*/\1/p' "$WORK/on.sections" | head -1)
flags_link=$(printf '%s\n' "$map_line" | awk '{print $(NF-3), $(NF-2)}')
[ "$flags_link" = "AL $text_idx" ] || { echo "FAIL — .simple_xray_map flags/link '$flags_link' (want 'AL $text_idx')"; exit 1; }
checks=$((checks + 1))

"$READELF" -r -W "$WORK/on.o" > "$WORK/on.relocs" 2>&1
expect_count "PLT32 relocations to __simple_xray_trampoline_v1" \
    "$(grep -c 'R_X86_64_PLT32 .*__simple_xray_trampoline_v1 - 4' "$WORK/on.relocs")" "$sites"
# Every trampoline relocation sits at an `eb 0b` sled + 3 (independent of the
# linear disassembly below, which a site id byte can desynchronise).
"$OBJCOPY" -O binary --only-section=.text "$WORK/on.o" "$WORK/on_text.bin" || {
    echo "ERROR — nothing was checked (cannot dump .text)"; exit 2; }
for roff in $(awk '/R_X86_64_PLT32/ && /__simple_xray_trampoline_v1/ {print $1}' "$WORK/on.relocs"); do
    word=$(dd if="$WORK/on_text.bin" bs=1 skip="$(( 0x$roff - 3 ))" count=2 2>/dev/null | xxd -p)
    [ "$word" = "eb0b" ] || { echo "FAIL — trampoline relocation at .text+0x$roff is not sled+3 (found $word)"; exit 1; }
done
checks=$((checks + 1))
expect_count "PC64 text_base relocation" \
    "$(grep -A3 "Relocation section '.rela.simple_xray_map'" "$WORK/on.relocs" | grep -cE '^0+24 .*R_X86_64_PC64 .* \.text \+ 0$')" 1

"$OBJDUMP" -d "$WORK/on.o" > "$WORK/on.dis" 2>&1
expect_count "sled off word (eb 0b jmp)" "$(grep -cE '^ *[0-9a-f]*[02468ace]: eb 0b[[:space:]]+jmp' "$WORK/on.dis")" "$sites"
expect_count "odd-address sled starts" "$(grep -cE '^ *[0-9a-f]*[13579bdf]: eb 0b[[:space:]]+jmp' "$WORK/on.dis")" 0
expect_count "sled CALL (e8 rel32)" "$(grep -A1 -E ': eb 0b[[:space:]]+jmp' "$WORK/on.dis" | grep -cE ': e8 00 00 00 00[[:space:]]+callq')" "$sites"
expect_count "sled jump over the id (eb 04)" "$(grep -A2 -E ': eb 0b[[:space:]]+jmp' "$WORK/on.dis" | grep -cE ': eb 04[[:space:]]+jmp')" "$sites"

"$READELF" -S -s -W "$WORK/off.o" > "$WORK/off.inspect" 2>&1
expect_count "xray section/symbol in the OFF object" "$(grep -cE 'simple_xray|__xray_|xray_instr_map' "$WORK/off.inspect")" 0
"$OBJDUMP" -d "$WORK/off.o" > "$WORK/off.dis" 2>&1
expect_count "sled words in the OFF object" "$(grep -cE ': eb 0b[[:space:]]+jmp' "$WORK/off.dis")" 0

ops=$(cat "$WORK/ops.txt" 2>/dev/null)
ops_words_ok "$ops" || { echo "FAIL — ops.txt stores something other than the 2-byte activation words"; exit 1; }
checks=$((checks + 1))
echo "PASS — $checks check(s) (x86-64 objects, twin, patcher ops; sites=$sites; execution not run)"
exit 0
