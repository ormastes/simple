#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

BUILD_DIR="${BUILD_DIR:-build/tmp/macos_vulkan_web_live_evidence}"
REPORT_PATH="${REPORT_PATH:-doc/09_report/macos_vulkan_web_live_evidence_$(date -u +%F).md}"
SAMPLE="${MACOS_VULKAN_WEB_SAMPLE:-examples/06_io/ui/web_standards_showcase_gui.spl}"
HTML_SAMPLE="${MACOS_VULKAN_WEB_HTML_SAMPLE:-examples/06_io/ui/browser_common_elements_showcase.html}"
TIMEOUT_SECS="${MACOS_VULKAN_WEB_TIMEOUT_SECS:-180}"
MAX_RSS_KB="${MACOS_VULKAN_WEB_MAX_RSS_KB:-1048576}"
REQUESTED_DPI="${SHOWCASE_DPI:-300}"
ICD_PATH="${VK_ICD_FILENAMES:-/opt/homebrew/etc/vulkan/icd.d/MoltenVK_icd.json}"
EVENTS="$BUILD_DIR/events.env"
LAUNCHER_LOG="$BUILD_DIR/launcher.log"
WINDOW_ENV="$BUILD_DIR/window.env"
BEFORE_PNG="$BUILD_DIR/before.png"
AFTER_PNG="$BUILD_DIR/after.png"
BEFORE_DECODED_BMP="$BUILD_DIR/before.bmp"
AFTER_DECODED_BMP="$BUILD_DIR/after.bmp"
EVIDENCE_ENV="$BUILD_DIR/evidence.env"
CHILD_STDOUT="$BUILD_DIR/child.stdout"
CHILD_STDERR="$BUILD_DIR/child.stderr"
LAUNCHED_PID_ENV="$BUILD_DIR/launched-pid.env"
case "$LAUNCHED_PID_ENV" in
    /*) LAUNCHED_PID_ENV_PATH="$LAUNCHED_PID_ENV" ;;
    *) LAUNCHED_PID_ENV_PATH="$ROOT_DIR/$LAUNCHED_PID_ENV" ;;
esac
launch_stdout=""
launch_stderr=""
launch_app_bundle=""
launch_app_executable=""
child_exit_cause=""

case "$HTML_SAMPLE" in
    /*) HTML_SAMPLE_PATH="$HTML_SAMPLE" ;;
    *) HTML_SAMPLE_PATH="$ROOT_DIR/$HTML_SAMPLE" ;;
esac

mkdir -p "$BUILD_DIR" "$(dirname -- "$REPORT_PATH")"
rm -f "$EVENTS" "$LAUNCHER_LOG" "$WINDOW_ENV" "$BEFORE_PNG" "$AFTER_PNG" \
    "$BEFORE_DECODED_BMP" "$AFTER_DECODED_BMP" "$EVIDENCE_ENV" \
    "$CHILD_STDOUT" "$CHILD_STDERR" "$LAUNCHED_PID_ENV"

app_pid=""
peak_rss_kb=0
cleanup_status="not-needed"

process_matches_launched_executable() {
    [ -n "$app_pid" ] || return 1
    actual_executable="$(
        ps -p "$app_pid" -o command= 2>/dev/null |
            awk 'NR == 1 { print $1 }'
    )"
    [ "$actual_executable" = "$launch_app_executable" ]
}

wait_for_process_exit() {
    wait_pid="$1"
    wait_secs="$2"
    wait_deadline=$(($(date +%s) + wait_secs))
    while kill -0 "$wait_pid" 2>/dev/null &&
            [ "$(date +%s)" -lt "$wait_deadline" ]; do
        sleep 0.1
    done
    ! kill -0 "$wait_pid" 2>/dev/null
}

request_quit_bounded() {
    osascript - "$app_pid" >/dev/null 2>&1 <<'OSA' &
on run argv
  set targetPid to (item 1 of argv) as integer
  tell application "System Events"
    repeat with proc in (processes whose unix id is targetPid)
      tell proc
        set frontmost to true
        keystroke "q"
      end tell
    end repeat
  end tell
end run
OSA
    osascript_pid=$!
    if wait_for_process_exit "$osascript_pid" 2; then
        wait "$osascript_pid" || true
        return 0
    fi
    kill -TERM "$osascript_pid" 2>/dev/null || true
    wait_for_process_exit "$osascript_pid" 1 ||
        kill -KILL "$osascript_pid" 2>/dev/null || true
    wait_for_process_exit "$osascript_pid" 1 || return 1
    wait "$osascript_pid" 2>/dev/null || true
    return 1
}

cleanup() {
    [ -n "$app_pid" ] || return 0
    # A PID record is trusted only while its executable remains the exact
    # launch path; PID reuse must never target another application.
    if ! process_matches_launched_executable; then
        app_pid=""
        cleanup_status="identity-lost"
        return 0
    fi
    request_quit_bounded || true
    if ! process_matches_launched_executable; then
        app_pid=""
        cleanup_status="complete"
        return 0
    fi
    if kill -0 "$app_pid" 2>/dev/null; then
        kill -TERM "$app_pid" 2>/dev/null || true
        if wait_for_process_exit "$app_pid" 5; then
            app_pid=""
            cleanup_status="complete"
            return 0
        fi
        if ! process_matches_launched_executable; then
            app_pid=""
            cleanup_status="identity-lost"
            return 0
        fi
        if kill -0 "$app_pid" 2>/dev/null; then
            kill -KILL "$app_pid" 2>/dev/null || true
        fi
        if wait_for_process_exit "$app_pid" 2; then
            app_pid=""
            cleanup_status="complete"
            return 0
        fi
    fi
    cleanup_status="incomplete"
    return 1
}
trap cleanup EXIT HUP INT TERM

write_report() {
    {
        echo "# macOS Vulkan Web Live Evidence"
        echo
        echo '```text'
        if [ -f "$EVIDENCE_ENV" ]; then
            cat "$EVIDENCE_ENV"
        fi
        echo '```'
        echo
        echo "- Before interaction: \`$BEFORE_PNG\`"
        echo "- After interaction: \`$AFTER_PNG\`"
        echo "- Decoded before pixels: \`$BEFORE_DECODED_BMP\`"
        echo "- Decoded after pixels: \`$AFTER_DECODED_BMP\`"
        echo "- Event receipt: \`$EVENTS\`"
        echo "- Launcher log: \`$LAUNCHER_LOG\`"
        if [ -f "$CHILD_STDOUT" ]; then
            echo "- Preserved child stdout: \`$CHILD_STDOUT\`"
        else
            echo "- Preserved child stdout: unavailable"
        fi
        if [ -f "$CHILD_STDERR" ]; then
            echo "- Preserved child stderr: \`$CHILD_STDERR\`"
        else
            echo "- Preserved child stderr: unavailable"
        fi
    } >"$REPORT_PATH"
}

fail() {
    reason="$1"
    preserve_child_logs || true
    # Finish PID-scoped termination before publishing a durable failure report.
    if ! cleanup; then
        reason="cleanup-incomplete-$reason"
    fi
    app_pid=""
    {
        echo "macos_vulkan_web_live_status=fail"
        echo "macos_vulkan_web_live_reason=$reason"
        echo "macos_vulkan_web_live_peak_rss_kb=$peak_rss_kb"
        echo "macos_vulkan_web_live_max_rss_kb=$MAX_RSS_KB"
        echo "macos_vulkan_web_live_cleanup_status=$cleanup_status"
        if [ -n "$child_exit_cause" ]; then
            echo "macos_vulkan_web_live_child_exit_cause=$child_exit_cause"
        fi
        echo "macos_vulkan_web_live_child_stdout=$CHILD_STDOUT"
        echo "macos_vulkan_web_live_child_stdout_present=$(file_present "$CHILD_STDOUT")"
        echo "macos_vulkan_web_live_child_stdout_bytes=$(file_bytes "$CHILD_STDOUT")"
        echo "macos_vulkan_web_live_child_stdout_cksum=$(file_cksum "$CHILD_STDOUT")"
        echo "macos_vulkan_web_live_child_stderr=$CHILD_STDERR"
        echo "macos_vulkan_web_live_child_stderr_present=$(file_present "$CHILD_STDERR")"
        echo "macos_vulkan_web_live_child_stderr_bytes=$(file_bytes "$CHILD_STDERR")"
        echo "macos_vulkan_web_live_child_stderr_cksum=$(file_cksum "$CHILD_STDERR")"
    } >"$EVIDENCE_ENV"
    write_report
    echo "macOS Vulkan web live evidence: FAIL ($reason)" >&2
    if [ -n "$child_exit_cause" ]; then
        echo "SimpleGui log cause: $child_exit_cause" >&2
    fi
    exit 1
}

value_of() {
    key="$1"
    file="$2"
    sed -n "s/^${key}=//p" "$file" | tail -n 1
}

line_field() {
    key="$1"
    line="$2"
    printf '%s\n' "$line" |
        sed -n "s/.* ${key}=\\([^ ]*\\).*/\\1/p" |
        tail -n 1
}

file_bytes() {
    if [ -f "$1" ]; then
        wc -c <"$1" | tr -d ' '
    else
        echo 0
    fi
}

file_cksum() {
    if [ -f "$1" ]; then
        cksum "$1" | awk '{print $1}'
    else
        echo 0
    fi
}

# `sips` decodes the screen PNG to BMP. Hash only bytes beginning at BMP's
# little-endian pixel-data offset, never the BMP container header.
bmp_pixel_offset() {
    [ -f "$1" ] || { echo 0; return 0; }
    offset="$(od -An -tu1 -j 10 -N 4 "$1" 2>/dev/null |
        awk 'NF >= 4 { print $1 + $2 * 256 + $3 * 65536 + $4 * 16777216; exit }')"
    case "$offset" in ""|*[!0-9]*) echo 0 ;; *) echo "$offset" ;; esac
}

bmp_pixel_bytes() {
    offset="$(bmp_pixel_offset "$1")"
    total="$(file_bytes "$1")"
    case "$offset:$total" in *[!0-9:]*|:|*:) echo 0; return 0 ;; esac
    [ "$offset" -lt "$total" ] || { echo 0; return 0; }
    echo $((total - offset))
}

bmp_pixel_cksum() {
    offset="$(bmp_pixel_offset "$1")"
    case "$offset" in ""|*[!0-9]*) echo 0; return 0 ;; esac
    [ "$offset" -gt 0 ] || { echo 0; return 0; }
    tail -c +$((offset + 1)) "$1" 2>/dev/null | cksum | awk '{print $1}'
}

file_present() {
    if [ -f "$1" ]; then
        echo 1
    else
        echo 0
    fi
}

parse_launcher_paths() {
    launch_stdout="$(sed -n 's/^app stdout: \(.*\)  stderr:.*/\1/p' \
        "$LAUNCHER_LOG" | tail -n 1)"
    launch_stderr="$(sed -n 's/^app stdout: .*  stderr: \(.*\)$/\1/p' \
        "$LAUNCHER_LOG" | tail -n 1)"
    launch_app_bundle="$(sed -n 's/^launching .* as \(.*\) \.\.\.$/\1/p' \
        "$LAUNCHER_LOG" | tail -n 1)"
}

preserve_child_logs() {
    preserve_failed=0
    if [ -n "$launch_stdout" ] && [ -f "$launch_stdout" ]; then
        cp "$launch_stdout" "$CHILD_STDOUT" || preserve_failed=1
    fi
    if [ -n "$launch_stderr" ] && [ -f "$launch_stderr" ]; then
        cp "$launch_stderr" "$CHILD_STDERR" || preserve_failed=1
    fi
    return "$preserve_failed"
}

capture_child_exit_cause() {
    child_exit_cause=""
    for child_log in "$CHILD_STDERR" "$CHILD_STDOUT" \
            "$launch_stderr" "$launch_stdout"; do
        [ -n "$child_log" ] && [ -f "$child_log" ] || continue
        child_exit_cause="$(
            grep -E '^(error:|fatal:|panic:)' "$child_log" 2>/dev/null |
                tail -n 1 || true
        )"
        if [ -z "$child_exit_cause" ]; then
            child_exit_cause="$(awk 'NF { line = $0 } END { print line }' "$child_log")"
        fi
        [ -z "$child_exit_cause" ] || break
    done
    child_exit_cause="$(
        printf '%s' "${child_exit_cause:-SimpleGui exited without captured output}" |
            tr '\r\n' '  ' | cut -c 1-500
    )"
}

process_rss_kb() {
    ps -p "$1" -o rss= 2>/dev/null | tr -d ' '
}

normalize_positive_integer() {
    value="$1"
    case "$value" in
        ""|*[!0-9]*) return 1 ;;
    esac
    normalized="$(expr "$value" + 0)" || return 1
    [ "$normalized" -gt 0 ] || return 1
    printf '%s\n' "$normalized"
}

strict_receipt_order() {
    focus_revision="$1"
    keyboard_revision="$2"
    pointer_revision="$3"
    click_revision="$4"
    interaction_receipt_revision="$5"
    for receipt_value in "$focus_revision" "$keyboard_revision" \
            "$pointer_revision" "$click_revision" \
            "$interaction_receipt_revision"; do
        case "$receipt_value" in
            ""|*[!0-9]*) return 1 ;;
        esac
        [ "$receipt_value" -gt 0 ] || return 1
    done
    [ "$focus_revision" -lt "$keyboard_revision" ] &&
        [ "$focus_revision" -lt "$pointer_revision" ] &&
        [ "$focus_revision" -lt "$click_revision" ] &&
        [ "$keyboard_revision" -le "$interaction_receipt_revision" ] &&
        [ "$pointer_revision" -le "$interaction_receipt_revision" ] &&
        [ "$click_revision" -le "$interaction_receipt_revision" ]
}

sample_peak_rss() {
    [ -n "$app_pid" ] || return 0
    current_rss_kb="$(process_rss_kb "$app_pid")"
    [ -n "$current_rss_kb" ] || return 0
    case "$current_rss_kb" in
        *[!0-9]*) fail "invalid-rss-sample" ;;
    esac
    if [ "$current_rss_kb" -gt "$peak_rss_kb" ]; then
        peak_rss_kb="$current_rss_kb"
    fi
    if [ "$peak_rss_kb" -gt "$MAX_RSS_KB" ]; then
        fail "resource-limit-exceeded"
    fi
}

assert_launched_process() {
    if ! process_matches_launched_executable; then
        app_pid=""
        fail "launched-pid-executable-mismatch"
    fi
}

if ! TIMEOUT_SECS="$(normalize_positive_integer "$TIMEOUT_SECS")"; then
    fail "invalid-timeout-secs"
fi
if ! MAX_RSS_KB="$(normalize_positive_integer "$MAX_RSS_KB")"; then
    fail "invalid-max-rss-kb"
fi
if [ "$REQUESTED_DPI" != "300" ]; then
    fail "requires-300-dpi"
fi

if [ "$(uname -s)" != "Darwin" ]; then
    fail "requires-macos"
fi
if [ ! -f "$SAMPLE" ]; then
    fail "sample-missing"
fi
if [ ! -f "$HTML_SAMPLE_PATH" ]; then
    fail "html-sample-missing"
fi
if [ ! -f "$ICD_PATH" ]; then
    fail "moltenvk-icd-missing"
fi
if ! command -v osascript >/dev/null 2>&1; then
    fail "osascript-missing"
fi
if ! command -v screencapture >/dev/null 2>&1; then
    fail "screencapture-missing"
fi
if ! command -v sips >/dev/null 2>&1; then
    fail "sips-missing"
fi
if ! command -v cliclick >/dev/null 2>&1; then
    fail "cliclick-missing"
fi

if ! SIMPLE_GUI_RUN_SKIP_NUDGE=1 \
SIMPLE_GUI_BACKEND=vulkan \
SIMPLE_GUI_EXIT_AFTER_INTERACTION=0 \
SIMPLE_GUI_EVENT_EVIDENCE_PATH="$ROOT_DIR/$EVENTS" \
SIMPLE_GUI_LAUNCHED_PID_PATH="$LAUNCHED_PID_ENV_PATH" \
SIMPLE_ASSET_ROOT="$ROOT_DIR" \
SHOWCASE_RESOLUTION="${SHOWCASE_RESOLUTION:-320x240}" \
SHOWCASE_DPI="$REQUESTED_DPI" \
VK_ICD_FILENAMES="$ICD_PATH" \
DYLD_LIBRARY_PATH="${DYLD_LIBRARY_PATH:-/opt/homebrew/lib}" \
    scripts/gui/macos-gui-run.shs "$SAMPLE" >"$LAUNCHER_LOG" 2>&1; then
    parse_launcher_paths
    preserve_child_logs || true
    capture_child_exit_cause
    fail "launcher-failed"
fi

parse_launcher_paths
[ -n "$launch_stdout" ] || fail "launch-stdout-path-missing"
[ -n "$launch_stderr" ] || fail "launch-stderr-path-missing"
[ -n "$launch_app_bundle" ] || fail "launch-app-bundle-path-missing"
[ -d "$launch_app_bundle/Contents/MacOS" ] ||
    fail "launch-app-bundle-missing"
launch_app_executable="$(
    CDPATH= cd -- "$launch_app_bundle/Contents/MacOS" && pwd -P
)/SimpleGui"
[ -x "$launch_app_executable" ] || fail "launch-app-executable-missing"
[ -s "$LAUNCHED_PID_ENV_PATH" ] || fail "launched-pid-record-missing"
published_pid="$(value_of launched_pid "$LAUNCHED_PID_ENV_PATH")"
published_executable="$(value_of launched_executable "$LAUNCHED_PID_ENV_PATH")"
published_bundle="$(value_of launched_bundle "$LAUNCHED_PID_ENV_PATH")"
case "$published_pid" in ""|*[!0-9]*) fail "invalid-launched-pid" ;; esac
[ "$published_executable" = "$launch_app_executable" ] ||
    fail "launched-pid-record-executable-mismatch"
[ "$published_bundle" = "$launch_app_bundle" ] ||
    fail "launched-pid-record-bundle-mismatch"
app_pid="$published_pid"

deadline=$(($(date +%s) + TIMEOUT_SECS))
while [ "$(date +%s)" -lt "$deadline" ]; do
    if ! kill -0 "$app_pid" 2>/dev/null; then
        capture_child_exit_cause
        fail "app-exited-before-window"
    fi
    assert_launched_process
    sample_peak_rss
    if osascript - "$app_pid" >"$WINDOW_ENV" 2>/dev/null <<'OSA'
on run argv
  set targetPid to (item 1 of argv) as integer
tell application "System Events"
  repeat with proc in (processes whose unix id is targetPid)
    tell proc
      repeat with win in windows
        if (name of win as text) starts with "Pure-Simple web renderer" then
          set position of win to {200, 120}
          set frontmost to true
          delay 0.3
          set p to position of win
          set s to size of win
          set AppleScript's text item delimiters to ","
          return (targetPid as text) & "," & (item 1 of p as text) & "," & \
            (item 2 of p as text) & "," & (item 1 of s as text) & "," & \
            (item 2 of s as text)
        end if
      end repeat
    end tell
  end repeat
end tell
error "SimpleGui web window not ready"
end run
OSA
    then
        break
    fi
    sleep 0.25
done

if [ ! -s "$WINDOW_ENV" ]; then
    fail "window-not-found"
fi
window_record="$(tr -d '\r\n ' <"$WINDOW_ENV")"
case "$window_record" in
    *,*,*,*,*) ;;
    *) fail "invalid-window-rect" ;;
esac
old_ifs=$IFS
IFS=,
set -- $window_record
IFS=$old_ifs
app_pid="${1:-}"
window_x="${2:-0}"
window_y="${3:-0}"
window_w="${4:-0}"
window_h="${5:-0}"
case "$app_pid" in ""|*[!0-9]*) fail "invalid-window-pid" ;; esac
assert_launched_process
window_rect="$window_x,$window_y,$window_w,$window_h"

sample_peak_rss
if ! screencapture -x -R"$window_rect" "$BEFORE_PNG"; then
    fail "before-capture-failed"
fi
if ! sips -s format bmp "$BEFORE_PNG" --out "$BEFORE_DECODED_BMP" >/dev/null; then
    fail "before-capture-decode-failed"
fi

old_ifs=$IFS
IFS=,
set -- $window_rect
IFS=$old_ifs
click_x=$((window_x + 150))
click_y=$((window_y + 140))

# Reassert ownership and focus immediately before coordinate-based pointer
# injection so a different SimpleGui instance cannot receive the click.
assert_launched_process
osascript - "$app_pid" >/dev/null <<'OSA'
on run argv
  set targetPid to (item 1 of argv) as integer
tell application "System Events"
  repeat with proc in (processes whose unix id is targetPid)
    tell proc
      repeat with win in windows
        if (name of win as text) starts with "Pure-Simple web renderer" then
          set position of win to {200, 120}
          set frontmost to true
          return true
        end if
      end repeat
    end tell
  end repeat
end tell
error "SimpleGui web pointer target missing"
end run
OSA
cliclick "m:${click_x},${click_y}" "c:."
assert_launched_process
osascript - "$app_pid" >/dev/null <<'OSA'
on run argv
  set targetPid to (item 1 of argv) as integer
tell application "System Events"
  repeat with proc in (processes whose unix id is targetPid)
    tell proc
      repeat with win in windows
        if (name of win as text) starts with "Pure-Simple web renderer" then
          set frontmost to true
          keystroke "g"
          return true
        end if
      end repeat
    end tell
  end repeat
end tell
error "SimpleGui web input target missing"
end run
OSA
sample_peak_rss

event_deadline=$(($(date +%s) + 15))
while [ "$(date +%s)" -lt "$event_deadline" ]; do
    sample_peak_rss
    keyboard="$(value_of web_standards_event_keyboard_events "$EVENTS")"
    pointer="$(value_of web_standards_event_pointer_events "$EVENTS")"
    clicks="$(value_of web_standards_event_click_events "$EVENTS")"
    focus_events="$(value_of web_standards_event_focus_events "$EVENTS")"
    native_focus_kind="$(value_of web_standards_event_native_focus_kind "$EVENTS")"
    native_focus_observed="$(value_of web_standards_event_native_focus_observed "$EVENTS")"
    native_focus_reduced="$(value_of web_standards_event_native_focus_reduced "$EVENTS")"
    focus_admitted="$(value_of web_standards_event_focus_admitted "$EVENTS")"
    focus_receipt_revision="$(value_of web_standards_event_focus_receipt_revision "$EVENTS")"
    keyboard_receipt_revision="$(value_of web_standards_event_keyboard_receipt_revision "$EVENTS")"
    pointer_receipt_revision="$(value_of web_standards_event_pointer_receipt_revision "$EVENTS")"
    click_receipt_revision="$(value_of web_standards_event_click_receipt_revision "$EVENTS")"
    revision="$(value_of web_standards_event_interaction_revision "$EVENTS")"
    keyboard="${keyboard:-0}"
    pointer="${pointer:-0}"
    clicks="${clicks:-0}"
    focus_events="${focus_events:-0}"
    revision="${revision:-0}"
    if [ "$focus_events" -gt 0 ] &&
            [ "$native_focus_kind" = "5" ] &&
            [ "$native_focus_observed" = "true" ] &&
            [ "$native_focus_reduced" = "true" ] &&
            [ "$focus_admitted" = "true" ] &&
            [ "$keyboard" -gt 0 ] && [ "$pointer" -gt 0 ] &&
            [ "$clicks" -gt 0 ] &&
            strict_receipt_order "$focus_receipt_revision" \
                "$keyboard_receipt_revision" "$pointer_receipt_revision" \
                "$click_receipt_revision" "$revision"; then
        break
    fi
    sleep 1
done

[ "${keyboard:-0}" -gt 0 ] || fail "keyboard-event-missing"
[ "${pointer:-0}" -gt 0 ] || fail "pointer-event-missing"
[ "${clicks:-0}" -gt 0 ] || fail "click-event-missing"
[ "${focus_events:-0}" -gt 0 ] || fail "focus-event-missing"
[ "${native_focus_kind:-0}" = "5" ] || fail "native-focus-kind-mismatch"
[ "${native_focus_observed:-false}" = "true" ] ||
    fail "native-focus-not-observed"
[ "${native_focus_reduced:-false}" = "true" ] ||
    fail "native-focus-not-reduced"
[ "${focus_admitted:-false}" = "true" ] ||
    fail "focus-not-admitted"
before_focus="$(value_of web_standards_event_before_focus "$EVENTS")"
after_focus="$(value_of web_standards_event_after_focus "$EVENTS")"
[ "$before_focus" != "$after_focus" ] && [ -n "$after_focus" ] ||
    fail "focus-state-transition-missing"
before_focus_state_revision="$(
    value_of web_standards_event_before_focus_state_revision "$EVENTS")"
after_focus_state_revision="$(
    value_of web_standards_event_after_focus_state_revision "$EVENTS")"
case "$before_focus_state_revision:$after_focus_state_revision" in
    *[!0-9:]*|:|*:) fail "focus-state-revision-invalid" ;;
esac
[ "$after_focus_state_revision" -eq $((before_focus_state_revision + 1)) ] ||
    fail "focus-state-revision-mismatch"
[ "$(value_of web_standards_event_focus_changed "$EVENTS")" = "true" ] ||
    fail "focus-state-unchanged"
[ "${revision:-0}" -gt 0 ] || fail "interaction-revision-missing"
strict_receipt_order "$focus_receipt_revision" \
    "$keyboard_receipt_revision" "$pointer_receipt_revision" \
    "$click_receipt_revision" "$revision" ||
    fail "focus-not-before-interaction"

event_backend="$(value_of web_standards_event_backend "$EVENTS")"
source="$(value_of web_standards_event_source "$EVENTS")"
handle="$(value_of web_standards_event_backend_handle "$EVENTS")"
initial_checksum="$(value_of web_standards_event_initial_checksum "$EVENTS")"
interaction_checksum="$(value_of web_standards_event_interaction_checksum "$EVENTS")"
[ "$event_backend" = "vulkan" ] || fail "event-backend-not-vulkan"
[ "$source" = "device_readback" ] || fail "device-readback-missing"
[ "${handle:-0}" -gt 0 ] || fail "backend-handle-missing"
[ "${initial_checksum:-0}" -gt 0 ] || fail "initial-checksum-missing"
[ "${interaction_checksum:-0}" -gt 0 ] || fail "interaction-checksum-missing"
[ "$initial_checksum" != "$interaction_checksum" ] || fail "interaction-frame-unchanged"

# Pin again immediately before the post-input capture so another activation
# cannot relocate or cover the evidence window.
assert_launched_process
osascript - "$app_pid" >/dev/null <<'OSA'
on run argv
  set targetPid to (item 1 of argv) as integer
tell application "System Events"
  repeat with proc in (processes whose unix id is targetPid)
    tell proc
      repeat with win in windows
        if (name of win as text) starts with "Pure-Simple web renderer" then
          set position of win to {200, 120}
          set frontmost to true
          return true
        end if
      end repeat
    end tell
  end repeat
end tell
error "SimpleGui web post-input window missing"
end run
OSA
sleep 1
sample_peak_rss
assert_launched_process
if ! screencapture -x -R"$window_rect" "$AFTER_PNG"; then
    fail "after-capture-failed"
fi
if ! sips -s format bmp "$AFTER_PNG" --out "$AFTER_DECODED_BMP" >/dev/null; then
    fail "after-capture-decode-failed"
fi

before_bytes="$(file_bytes "$BEFORE_PNG")"
after_bytes="$(file_bytes "$AFTER_PNG")"
before_cksum="$(file_cksum "$BEFORE_PNG")"
after_cksum="$(file_cksum "$AFTER_PNG")"
before_pixel_bytes="$(bmp_pixel_bytes "$BEFORE_DECODED_BMP")"
after_pixel_bytes="$(bmp_pixel_bytes "$AFTER_DECODED_BMP")"
before_pixel_cksum="$(bmp_pixel_cksum "$BEFORE_DECODED_BMP")"
after_pixel_cksum="$(bmp_pixel_cksum "$AFTER_DECODED_BMP")"
[ "$before_bytes" -gt 1000 ] || fail "before-capture-empty"
[ "$after_bytes" -gt 1000 ] || fail "after-capture-empty"
[ "$before_cksum" != "$after_cksum" ] || fail "capture-unchanged"
[ "$before_pixel_bytes" -gt 1000 ] || fail "before-decoded-pixels-empty"
[ "$after_pixel_bytes" -gt 1000 ] || fail "after-decoded-pixels-empty"
[ "$before_pixel_cksum" != "$after_pixel_cksum" ] ||
    fail "decoded-pixels-unchanged"

[ -f "$launch_stdout" ] || fail "launch-stdout-missing"
renderer_line="$(grep '^web_standards_showcase status=pass ' "$launch_stdout" | tail -n 1 || true)"
[ -n "$renderer_line" ] || fail "renderer-status-missing"
renderer_requested="$(line_field requested "$renderer_line")"
renderer_resolved="$(line_field resolved "$renderer_line")"
renderer_source="$(line_field source "$renderer_line")"
renderer_handle="$(line_field backend_handle "$renderer_line")"
renderer_checksum="$(line_field readback_checksum "$renderer_line")"
renderer_dpi="$(line_field dpi "$renderer_line")"
renderer_dpi_applied="$(line_field dpi_scale_applied "$renderer_line")"
renderer_font_dpi_applied="$(line_field font_dpi_applied "$renderer_line")"
renderer_font_expected_identity="$(line_field font_expected_identity "$renderer_line")"
renderer_font_identity="$(line_field font_identity "$renderer_line")"
renderer_font_loaded="$(line_field font_loaded "$renderer_line")"
renderer_font_point_size="$(line_field font_point_size "$renderer_line")"
renderer_font_dpi="$(line_field font_dpi "$renderer_line")"
renderer_font_pixel_size="$(line_field font_pixel_size "$renderer_line")"
renderer_font_execution_target="$(line_field font_execution_target "$renderer_line")"
renderer_font_batch_identity="$(line_field font_batch_identity "$renderer_line")"
renderer_font_readback_source="$(line_field font_readback_source "$renderer_line")"
renderer_font_device_checksum="$(line_field font_device_checksum "$renderer_line")"
renderer_font_oracle_checksum="$(line_field font_oracle_checksum "$renderer_line")"
renderer_font_readback_nonblank_pixels="$(
    line_field font_readback_nonblank_pixels "$renderer_line")"
renderer_font_device_executed="$(line_field font_device_executed "$renderer_line")"
renderer_font_promotion_ready="$(line_field font_promotion_ready "$renderer_line")"
[ "$renderer_requested" = "vulkan" ] || fail "renderer-requested-not-vulkan"
[ "$renderer_resolved" = "vulkan" ] || fail "renderer-resolved-not-vulkan"
[ "$renderer_source" = "device_readback" ] || fail "renderer-device-readback-missing"
[ "${renderer_handle:-0}" -gt 0 ] || fail "renderer-handle-missing"
[ "${renderer_checksum:-0}" -gt 0 ] || fail "renderer-checksum-missing"
[ "$renderer_checksum" = "$initial_checksum" ] ||
    fail "renderer-event-checksum-mismatch"
[ "$renderer_dpi" = "$REQUESTED_DPI" ] || fail "renderer-dpi-mismatch"
[ "$renderer_font_dpi_applied" = "true" ] || fail "vector-font-dpi-not-applied"
[ "$renderer_font_loaded" = "true" ] || fail "vector-font-not-loaded"
[ -n "$renderer_font_expected_identity" ] ||
    fail "vector-font-expected-identity-missing"
[ "$renderer_font_identity" = "$renderer_font_expected_identity" ] ||
    fail "vector-font-identity-mismatch"
[ "$renderer_font_point_size" = "24" ] ||
    fail "vector-font-point-size-mismatch"
[ "$renderer_font_dpi" = "300" ] || fail "vector-font-dpi-mismatch"
expected_font_pixel_size=$(((renderer_font_point_size * renderer_font_dpi + 36) / 72))
[ "$renderer_font_pixel_size" = "$expected_font_pixel_size" ] ||
    fail "vector-font-dpi-formula-mismatch"
[ "$renderer_font_execution_target" = "vulkan" ] ||
    fail "vector-font-execution-target-mismatch"
[ -n "$renderer_font_batch_identity" ] ||
    fail "vector-font-batch-identity-missing"
[ "$renderer_font_readback_source" = "device_readback" ] ||
    fail "vector-font-device-readback-missing"
[ "${renderer_font_device_checksum:-0}" -gt 0 ] ||
    fail "vector-font-device-checksum-missing"
[ "$renderer_font_device_checksum" = "$renderer_font_oracle_checksum" ] ||
    fail "vector-font-device-oracle-mismatch"
[ "${renderer_font_readback_nonblank_pixels:-0}" -gt 0 ] ||
    fail "vector-font-readback-blank"
[ "$renderer_font_device_executed" = "true" ] ||
    fail "vector-font-device-not-executed"
[ "$renderer_font_promotion_ready" = "true" ] ||
    fail "vector-font-promotion-not-ready"
event_font_expected_identity="$(value_of web_standards_event_font_expected_identity "$EVENTS")"
event_font_identity="$(value_of web_standards_event_font_identity "$EVENTS")"
[ "$(value_of web_standards_event_font_loaded "$EVENTS")" = "true" ] ||
    fail "event-vector-font-not-loaded"
[ "$event_font_expected_identity" = "$renderer_font_expected_identity" ] ||
    fail "event-vector-font-expected-identity-mismatch"
[ "$event_font_identity" = "$renderer_font_identity" ] ||
    fail "event-vector-font-identity-mismatch"
[ "$(value_of web_standards_event_font_point_size "$EVENTS")" = "$renderer_font_point_size" ] ||
    fail "event-vector-font-point-size-mismatch"
[ "$(value_of web_standards_event_font_dpi "$EVENTS")" = "$renderer_font_dpi" ] ||
    fail "event-vector-font-dpi-mismatch"
[ "$(value_of web_standards_event_font_pixel_size "$EVENTS")" = "$renderer_font_pixel_size" ] ||
    fail "event-vector-font-pixel-size-mismatch"
event_font_execution_target="$(
    value_of web_standards_event_font_execution_target "$EVENTS")"
event_font_batch_identity="$(
    value_of web_standards_event_font_batch_identity "$EVENTS")"
event_font_readback_source="$(
    value_of web_standards_event_font_readback_source "$EVENTS")"
event_font_device_checksum="$(
    value_of web_standards_event_font_device_checksum "$EVENTS")"
event_font_oracle_checksum="$(
    value_of web_standards_event_font_oracle_checksum "$EVENTS")"
event_font_nonblank="$(
    value_of web_standards_event_font_readback_nonblank_pixels "$EVENTS")"
[ "$event_font_execution_target" = "vulkan" ] ||
    fail "event-vector-font-execution-target-mismatch"
[ -n "$event_font_batch_identity" ] ||
    fail "event-vector-font-batch-identity-missing"
[ "$event_font_readback_source" = "device_readback" ] ||
    fail "event-vector-font-readback-source-mismatch"
[ "${event_font_device_checksum:-0}" -gt 0 ] ||
    fail "event-vector-font-device-checksum-missing"
[ "$event_font_device_checksum" = "$event_font_oracle_checksum" ] ||
    fail "event-vector-font-device-oracle-mismatch"
[ "${event_font_nonblank:-0}" -gt 0 ] ||
    fail "event-vector-font-nonblank-mismatch"
[ "$(value_of web_standards_event_font_device_executed "$EVENTS")" = "true" ] ||
    fail "event-vector-font-device-not-executed"
[ "$(value_of web_standards_event_font_promotion_ready "$EVENTS")" = "true" ] ||
    fail "event-vector-font-promotion-not-ready"
[ "$(value_of web_standards_event_font_frame_revision "$EVENTS")" = "$revision" ] ||
    fail "event-vector-font-frame-revision-mismatch"
[ "$(value_of web_standards_event_font_focus_receipt_revision "$EVENTS")" = "$focus_receipt_revision" ] ||
    fail "event-vector-font-focus-revision-mismatch"

preserve_child_logs || fail "child-log-preservation-failed"
completed_app_pid="$app_pid"
if ! cleanup || [ "$cleanup_status" != "complete" ]; then
    app_pid=""
    fail "cleanup-not-complete"
fi
{
    echo "macos_vulkan_web_live_status=pass"
    echo "macos_vulkan_web_live_reason=pass"
    echo "macos_vulkan_web_live_requested_backend=$renderer_requested"
    echo "macos_vulkan_web_live_backend=$renderer_resolved"
    echo "macos_vulkan_web_live_source=$source"
    echo "macos_vulkan_web_live_backend_handle=$handle"
    echo "macos_vulkan_web_live_renderer_backend_handle=$renderer_handle"
    echo "macos_vulkan_web_live_renderer_checksum=$renderer_checksum"
    echo "macos_vulkan_web_live_initial_checksum=$initial_checksum"
    echo "macos_vulkan_web_live_interaction_checksum=$interaction_checksum"
    echo "macos_vulkan_web_live_keyboard_events=$keyboard"
    echo "macos_vulkan_web_live_pointer_events=$pointer"
    echo "macos_vulkan_web_live_click_events=$clicks"
    echo "macos_vulkan_web_live_focus_events=$focus_events"
    echo "macos_vulkan_web_live_native_focus_kind=$native_focus_kind"
    echo "macos_vulkan_web_live_native_focus_observed=$native_focus_observed"
    echo "macos_vulkan_web_live_native_focus_reduced=$native_focus_reduced"
    echo "macos_vulkan_web_live_focus_admitted=$focus_admitted"
    echo "macos_vulkan_web_live_before_focus=$before_focus"
    echo "macos_vulkan_web_live_after_focus=$after_focus"
    echo "macos_vulkan_web_live_before_focus_state_revision=$before_focus_state_revision"
    echo "macos_vulkan_web_live_after_focus_state_revision=$after_focus_state_revision"
    echo "macos_vulkan_web_live_focus_receipt_revision=$focus_receipt_revision"
    echo "macos_vulkan_web_live_keyboard_receipt_revision=$keyboard_receipt_revision"
    echo "macos_vulkan_web_live_pointer_receipt_revision=$pointer_receipt_revision"
    echo "macos_vulkan_web_live_click_receipt_revision=$click_receipt_revision"
    echo "macos_vulkan_web_live_focus_changed=true"
    echo "macos_vulkan_web_live_interaction_revision=$revision"
    echo "macos_vulkan_web_live_dpi=$renderer_dpi"
    echo "macos_vulkan_web_live_dpi_scale_applied=$renderer_dpi_applied"
    echo "macos_vulkan_web_live_font_dpi_applied=$renderer_font_dpi_applied"
    echo "macos_vulkan_web_live_font_expected_identity=$renderer_font_expected_identity"
    echo "macos_vulkan_web_live_font_identity=$renderer_font_identity"
    echo "macos_vulkan_web_live_font_loaded=$renderer_font_loaded"
    echo "macos_vulkan_web_live_font_point_size=$renderer_font_point_size"
    echo "macos_vulkan_web_live_font_dpi=$renderer_font_dpi"
    echo "macos_vulkan_web_live_font_pixel_size=$renderer_font_pixel_size"
    echo "macos_vulkan_web_live_font_execution_target=$event_font_execution_target"
    echo "macos_vulkan_web_live_font_batch_identity=$event_font_batch_identity"
    echo "macos_vulkan_web_live_font_readback_source=$event_font_readback_source"
    echo "macos_vulkan_web_live_font_device_checksum=$event_font_device_checksum"
    echo "macos_vulkan_web_live_font_oracle_checksum=$event_font_oracle_checksum"
    echo "macos_vulkan_web_live_font_readback_nonblank_pixels=$event_font_nonblank"
    echo "macos_vulkan_web_live_font_device_executed=true"
    echo "macos_vulkan_web_live_font_promotion_ready=true"
    echo "macos_vulkan_web_live_font_frame_revision=$revision"
    echo "macos_vulkan_web_live_font_focus_receipt_revision=$focus_receipt_revision"
    echo "macos_vulkan_web_live_initial_font_batch_identity=$renderer_font_batch_identity"
    echo "macos_vulkan_web_live_initial_font_device_checksum=$renderer_font_device_checksum"
    echo "macos_vulkan_web_live_initial_font_oracle_checksum=$renderer_font_oracle_checksum"
    echo "macos_vulkan_web_live_peak_rss_kb=$peak_rss_kb"
    echo "macos_vulkan_web_live_max_rss_kb=$MAX_RSS_KB"
    echo "macos_vulkan_web_live_app_bundle=$launch_app_bundle"
    echo "macos_vulkan_web_live_app_executable=$launch_app_executable"
    echo "macos_vulkan_web_live_app_pid=$completed_app_pid"
    echo "macos_vulkan_web_live_cleanup_status=$cleanup_status"
    echo "macos_vulkan_web_live_window_rect=$window_rect"
    echo "macos_vulkan_web_live_before_png=$BEFORE_PNG"
    echo "macos_vulkan_web_live_after_png=$AFTER_PNG"
    echo "macos_vulkan_web_live_before_bytes=$before_bytes"
    echo "macos_vulkan_web_live_after_bytes=$after_bytes"
    echo "macos_vulkan_web_live_before_cksum=$before_cksum"
    echo "macos_vulkan_web_live_after_cksum=$after_cksum"
    echo "macos_vulkan_web_live_before_decoded_bmp=$BEFORE_DECODED_BMP"
    echo "macos_vulkan_web_live_after_decoded_bmp=$AFTER_DECODED_BMP"
    echo "macos_vulkan_web_live_before_decoded_bytes=$before_pixel_bytes"
    echo "macos_vulkan_web_live_after_decoded_bytes=$after_pixel_bytes"
    echo "macos_vulkan_web_live_before_decoded_cksum=$before_pixel_cksum"
    echo "macos_vulkan_web_live_after_decoded_cksum=$after_pixel_cksum"
    echo "macos_vulkan_web_live_child_stdout=$CHILD_STDOUT"
    echo "macos_vulkan_web_live_child_stdout_present=$(file_present "$CHILD_STDOUT")"
    echo "macos_vulkan_web_live_child_stdout_bytes=$(file_bytes "$CHILD_STDOUT")"
    echo "macos_vulkan_web_live_child_stdout_cksum=$(file_cksum "$CHILD_STDOUT")"
    echo "macos_vulkan_web_live_child_stderr=$CHILD_STDERR"
    echo "macos_vulkan_web_live_child_stderr_present=$(file_present "$CHILD_STDERR")"
    echo "macos_vulkan_web_live_child_stderr_bytes=$(file_bytes "$CHILD_STDERR")"
    echo "macos_vulkan_web_live_child_stderr_cksum=$(file_cksum "$CHILD_STDERR")"
} >"$EVIDENCE_ENV"
write_report

echo "macOS Vulkan web live evidence: PASS"
echo "report=$REPORT_PATH"
