#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
sysroot="$root/scripts/os/simpleos-sysroot-aarch64.shs"
fixture=$(mktemp -d "${TMPDIR:-/tmp}/simpleos-aarch64-tools.XXXXXX")
trap 'rm -rf "$fixture"' EXIT HUP INT TERM
mkdir -p "$fixture/bin"
for tool in clang ld.lld llvm-ar llvm-as opt llc llvm-config llvm-objcopy; do
    printf '#!/bin/sh\necho "LLVM version 23.1.0"\n' >"$fixture/bin/$tool"
    chmod +x "$fixture/bin/$tool"
done

default=$(LLVM_23_1_PREFIX="$fixture" sh "$sysroot" --print-toolchain)
printf '%s\n' "$default" | grep -qx "CLANG=$fixture/bin/clang"
printf '%s\n' "$default" | grep -qx "AR=$fixture/bin/llvm-ar"

overridden=$(LLVM_23_1_PREFIX="$fixture" CLANG=/custom/clang AR=/custom/ar \
    sh "$sysroot" --print-toolchain)
printf '%s\n' "$overridden" | grep -qx 'CLANG=/custom/clang'
printf '%s\n' "$overridden" | grep -qx 'AR=/custom/ar'

validated=$(LLVM_23_1_PREFIX="$fixture" sh "$sysroot" --check-toolchain)
printf '%s\n' "$validated" | grep -qx "CLANG=$fixture/bin/clang"
printf '%s\n' "$validated" | grep -qx "AR=$fixture/bin/llvm-ar"

printf '#!/bin/sh\necho "LLVM version 18.1.0"\n' >"$fixture/bin/llvm-ar"
if LLVM_23_1_PREFIX="$fixture" sh "$sysroot" --check-toolchain >/dev/null 2>&1; then
    echo 'FAIL: mixed default provider was accepted' >&2
    exit 1
fi

mkdir -p "$fixture/override"
printf '#!/bin/sh\nexit 0\n' >"$fixture/override/clang"
printf '#!/bin/sh\nexit 0\n' >"$fixture/override/ar"
chmod +x "$fixture/override/clang" "$fixture/override/ar"
bare=$(PATH="$fixture/override:$PATH" LLVM_23_1_PREFIX="$fixture" CLANG=clang AR=ar \
    sh "$sysroot" --check-toolchain)
printf '%s\n' "$bare" | grep -qx "CLANG=$fixture/override/clang"
printf '%s\n' "$bare" | grep -qx "AR=$fixture/override/ar"

grep -Fq 'exec "$CC_PATH" -target aarch64-unknown-none-elf' "$sysroot"
printf 'PASS: AArch64 sysroot defaults to one LLVM 23.1 provider and preserves tool overrides\n'
