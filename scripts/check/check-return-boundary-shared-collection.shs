#!/bin/sh
# Guard: a collection mutated inside a callee and handed back through the
# RETURN value must be the same collection the caller still holds.
#
# Regression guard for
# doc/08_tracking/bug/interpreter_return_boundary_never_merges_shared_collections_2026-08-17.md
#
# That record's mechanism: the interpreter merged shared containers on the
# ARGUMENT boundary only (`merge_shared_collection_fields`, called from
# function_exec.rs:1203) and had no return-side equivalent, so the caller kept
# a pre-call snapshot. Its own evidence pair is the tell — the
# argument-boundary example passed while the returning-free-function example
# failed in the same spec file.
#
# WHY A PROBE AND NOT A SPEC: on hosts whose deployed CLI cannot load
# `std.spec` the spec runner is unavailable, while a plain `run` of a 12-line
# probe works. The record's own evidence came from a spec, so this file is the
# portable second instrument, not a replacement for it.
#
# Compiler under test: ${SIMPLE_BIN:-$ROOT/bin/simple} — never hardcoded, per
# doc/08_tracking/bug/guards_hardcode_stale_seed_binary_census_2026-08-17.md
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> case(s) checked, 0 lost      exit 0
#   FAIL  — <n> case(s) checked, <k> lost    exit 1
#   ERROR — nothing was checked              exit 2   (never a pass)

set -u

ROOT=$(cd "$(dirname "$0")/.." && cd .. && pwd)
SIMPLE="${SIMPLE_BIN:-$ROOT/bin/simple}"

if [ ! -x "$SIMPLE" ]; then
    echo "ERROR — nothing was checked (no $SIMPLE)"
    exit 2
fi

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

cat > "$TMP/probe.spl" <<'PROBE'
struct Box:
    d: {text: i64}

fn mutate_and_return(b: Box) -> Box:
    b.d["k"] = 11
    b

fn main():
    var b = Box(d: {"k": 1})
    val out = mutate_and_return(b)
    print("returned=" + out.d["k"].to_text())
    print("caller=" + b.d["k"].to_text())
main()
PROBE

"$SIMPLE" run "$TMP/probe.spl" > "$TMP/out" 2>&1
_rc=$?
if [ "$_rc" -ne 0 ]; then
    sed -n '1,20p' "$TMP/out"
    echo "ERROR — nothing was checked (probe did not run, rc=$_rc)"
    exit 2
fi

CHECKED=0
FAILED=""

# The returned handle must carry the mutation (this half already worked).
CHECKED=$((CHECKED + 1))
grep -qx 'returned=11' "$TMP/out" || FAILED="$FAILED returned($(grep '^returned=' "$TMP/out" | head -1))"

# The caller's own binding must see it too. Measured on the deployed
# 2026-07-25 seed: caller=1 — the mutation was lost across the boundary.
CHECKED=$((CHECKED + 1))
grep -qx 'caller=11' "$TMP/out" || FAILED="$FAILED caller($(grep '^caller=' "$TMP/out" | head -1))"

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi

if [ -n "$FAILED" ]; then
    echo "FAIL — $CHECKED case(s) checked, lost:$FAILED"
    exit 1
fi

echo "PASS — $CHECKED case(s) checked, 0 lost"
exit 0
