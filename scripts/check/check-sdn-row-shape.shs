#!/bin/sh
# check-sdn-row-shape.shs — every row of a table-style SDN file (bug_db.sdn) must
# have the header's column count and exactly ONE row terminator.
#
# WHY: PR #6633 landed bug_db.sdn rows FUSED (two versions of one row spliced into
# one line, the id repeated 8 times). The CRC seal cannot see that: the seal is
# computed over whatever bytes are there. Checks per row line (4-space indent):
#   1. (column counts are NOT checked: unquoted commas in titles pre-exist; fusion is caught by 2 and 3)
#   2. the dated tables (`bugs`, `bugs_active`) contain at most one
#      `, <date>, <date>, true|false` terminator and the line ENDS with it;
#   3. the row's leading id does not reappear as `, <id>, ` glued later in the line.
#      Only for TEXT ids: a purely numeric id (test_db.sdn `tests`/`suites`) is a
#      surrogate key and legitimately recurs as a foreign key in the same row
#      (`    7, 7, 7, 859, ...`) — flagging it made every test_db.sdn touch FAIL.
# --range <base>..<head> FAILs only on malformed rows NEW at <head> versus the same
# file at <base>; a pre-existing malformed row on the base line (e.g. a release
# line whose own data diverges from main) is reported but is not this push's.
# Verdict is the last stdout line: PASS — <n> row(s) checked / FAIL — ... / ERROR — ...
# Usage: sh scripts/check/check-sdn-row-shape.shs [--selftest] [file.sdn]
#        (default doc/08_tracking/bug/bug_db.sdn)
set -u

scan() {
    awk '
    function fail(msg) { bad++; if (lim == 0 || bad <= lim) print "  line " NR ": " msg }
    /^[a-z_]+ \|.*\|$/ {
        t = $1; hdr = $0; sub(/^[^|]*\|/, "", hdr); sub(/\|$/, "", hdr)
        ncol[t] = gsub(/,/, ",", hdr) + 1; cur = t; next
    }
    /^    / && cur != "" {
        n++
        s = $0; q = 0; c = 1
        for (i = 1; i <= length(s); i++) {
            ch = substr(s, i, 1)
            if (ch == "\"") q = !q
            else if (ch == "," && !q) c++
        }
        id = $0; sub(/^    /, "", id); sub(/,.*/, "", id)
        if (cur == "bugs" || cur == "bugs_active") {
            t2 = $0; k = gsub(/, [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9], [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9], (true|false)/, "&", t2)
            if (k > 1) fail(cur " row " id ": " k " row terminators (fused row)")
            else if (k == 1 && $0 !~ /, (true|false)$/) fail(cur " row " id ": text after row terminator (fused row)")
        }
        rest = substr($0, length(id) + 6)
        if (id !~ /^[0-9]+$/ && (index(rest, ", " id ", ") > 0 || index(rest, "    " id ", ") > 0)) fail(cur " row " id ": id repeated inside the row (fused row)")
    }
    END {
        if (n == 0) { print "ERROR — nothing was checked (no table rows)"; exit 2 }
        if (bad > 0) { print "FAIL — " n " row(s) checked, " bad " malformed"; exit 1 }
        print "PASS — " n " row(s) checked, 0 malformed"; exit 0
    }' lim="${2:-10}" "$1"
}

# Malformed-row signatures (line numbers stripped) for <rev>:<path>; empty when absent.
sigs_at() {
    git show "$1:$2" > "$3" 2>/dev/null || { : > "$3.sig"; return 0; }
    scan "$3" 0 | sed -n 's/^  line [0-9]*: //p' | sort > "$3.sig"
}

# Range-mode fixture: a release line whose own table .sdn already carries a
# malformed row (diverged from main) must PASS for a branch that does not add
# one; a branch that introduces a fused row must FAIL.
# Push ranges arrive based on origin/main even for release-line pushes, which drags
# every unrelated release commit into the range. Narrow <base> to the NEWEST
# merge-base of <head> with any remote-tracking main/release/* ref that is a
# descendant of merge-base(<base>,<head>) — i.e. the remote branch the push is actually based on.
narrow_base() {
    _nb=$(git merge-base "$1" "$2" 2>/dev/null) || _nb=$1
    for _r in $(git for-each-ref --format='%(refname)' 'refs/remotes/*/main' 'refs/remotes/*/release/*' 2>/dev/null); do
        _mb=$(git merge-base "$_r" "$2" 2>/dev/null) || continue
        git merge-base --is-ancestor "$_nb" "$_mb" 2>/dev/null && _nb=$_mb
    done
    printf '%s\n' "$_nb"
}

# Default target set: only files with a validated row grammar. test_db.sdn and
# other table .sdn files stay out until they have one (see bug
# sdn_row_shape_gate_test_db_scope_2026-11-04).
ROW_SHAPE_TARGETS=${ROW_SHAPE_TARGETS:-doc/08_tracking/bug/bug_db.sdn}

range_selftest() {
    g="$1/repo"; hdr='bugs |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|'
    p=doc/08_tracking/bug/bug_db.sdn; tp=doc/08_tracking/test/test_db.sdn
    row='    b_1, P2, open, "t", src/x.spl, 3, doc/a.md, 2026-10-18, 2026-10-18, true'
    old='    a_1, P2, open, "t", src    a_1, P2, open, "t", src/x.spl, 3, doc/a.md, 2026-10-18, 2026-10-18, true'
    new='    c_1, P2, open, "t", src    c_1, P2, open, "t", src/x.spl, 3, doc/a.md, 2026-10-18, 2026-10-18, true'
    git init -q "$g" && cd "$g" || return 1
    mkdir -p doc/08_tracking/bug doc/08_tracking/test
    gc() { git -c user.name=t -c user.email=t@t -c commit.gpgsign=false commit -qm "$1"; }
    printf '%s\n%s\n' "$hdr" "$row" > $p; git add $p; gc main; main=$(git rev-parse HEAD)
    printf '%s\n%s\n%s\n' "$hdr" "$row" "$old" > $p; git add $p; gc release; rel=$(git rev-parse HEAD)
    printf '%s\n%s\n%s\n    d_1, P3, open, "u", src/y.spl, 4, doc/b.md, 2026-10-19, 2026-10-19, true\n' "$hdr" "$row" "$old" > $p; git add $p; gc clean; clean=$(git rev-parse HEAD)
    printf '%s\n%s\n%s\n%s\n' "$hdr" "$row" "$old" "$new" > $p; git add $p; git reset -q --soft "$rel"; gc bad; bad=$(git rev-parse HEAD)
    range_check "$rel..$clean" >/dev/null; a=$?
    range_check "$rel..$bad" >/dev/null; b=$?
    range_check "$main..$rel" >/dev/null; c=$?
    # Release-line push measured against main: unrelated release commits touch
    # test_db.sdn with text-id rows the heuristics would flag; must PASS.
    git checkout -q "$rel"
    printf 'tests |test_id, name|\n    x_1, "a", x_1, 2026-10-18, 2026-10-18, true, 2026-10-18, 2026-10-18, true\n' > $tp; git add $tp; gc rel_testdb; rel2=$(git rev-parse HEAD)
    # Sanity: the same test_db row IS flagged when test_db is opted in, so the
    # PASS below comes from scoping, not from a blind scanner.
    ROW_SHAPE_TARGETS="$p $tp" range_check "$rel..$rel2" >/dev/null; f=$?
    git update-ref refs/remotes/origin/release/1.0.0 "$rel2"
    printf '%s\n%s\n%s\n    e_1, P3, open, "u", src/y.spl, 4, doc/b.md, 2026-10-19, 2026-10-19, true\n' "$hdr" "$row" "$old" > $p; git add $p; gc topic; topic=$(git rev-parse HEAD)
    range_check "$main..$topic" >/dev/null; e=$?
    cd / || return 1
    [ "$a" = 0 ] && [ "$b" = 1 ] && [ "$c" = 1 ] && [ "$e" = 0 ] && [ "$f" = 1 ]
}

range_check() {
    _rr=$1
    base=${_rr%%..*}; head=${_rr#*..}
    base=$(narrow_base "$base" "$head")
    files=$(git diff --name-only --diff-filter=AM "$base..$head" -- $ROW_SHAPE_TARGETS) || { echo "ERROR — nothing was checked (git diff failed)"; return 2; }
    tmp=$(mktemp) || return 2; checked=0; failed=""; preexist=0
    for p in $files; do
        git show "$head:$p" > "$tmp" 2>/dev/null || continue
        scan "$tmp" 0 > "$tmp.out"; rc=$?
        [ "$rc" = 2 ] && continue
        checked=$((checked + 1))
        [ "$rc" = 0 ] && continue
        sed -n 's/^  line [0-9]*: //p' "$tmp.out" | sort > "$tmp.head"
        sigs_at "$base" "$p" "$tmp.base"
        newsig=$(comm -23 "$tmp.head" "$tmp.base.sig")
        n_pre=$(comm -12 "$tmp.head" "$tmp.base.sig" | wc -l | tr -d ' ')
        preexist=$((preexist + n_pre))
        if [ -n "$newsig" ]; then failed="$failed $p"; printf '%s\n' "$newsig" | head -10 | sed 's/^/    /'; fi
    done
    rm -f "$tmp" "$tmp.out" "$tmp.head" "$tmp.base" "$tmp.base.sig"
    if [ -n "$failed" ]; then echo "FAIL — $checked touched table .sdn file(s) checked, new malformed rows in:$failed"; return 1; fi
    echo "PASS — $checked touched table .sdn file(s) checked at $head, 0 new malformed ($preexist pre-existing at $base)"; return 0
}

selftest() {
    d=$(mktemp -d) || return 1
    good='    a_1, P2, open, "t", src/x.spl, 3, doc/a.md, 2026-10-18, 2026-10-18, true'
    printf 'bugs |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\n%s\n' "$good" > "$d/ok.sdn"
    fused="    a_1, P2, fix, \"t\", src    a_1, P2, open, \"t\", src/x.spl, 3, doc/a.md, 2026-10-18, 2026-10-18, truecompiler    a_1, P2, open, \"t\", src/x.spl, 3, doc/a.md, 2026-10-18, 2026-10-18, true"
    printf 'bugs |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\n%s\n' "$fused" > "$d/fused.sdn"
    printf 'bugs |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\n    a_1, P2, open, "t", src/x.spl, 3, doc/a.md, 2026-10-18, 2026-10-18, true, extra\n' > "$d/wide.sdn"
    printf 'tests |test_id, suite_id, name_str, valid|\n    7, 7, 7, true\n' > "$d/numid.sdn"
    : > "$d/empty.sdn"
    scan "$d/ok.sdn" >/dev/null; r1=$?
    scan "$d/fused.sdn" >/dev/null; r2=$?
    scan "$d/wide.sdn" >/dev/null; r3=$?
    scan "$d/empty.sdn" >/dev/null; r4=$?
    scan "$d/numid.sdn" >/dev/null; r5=$?
    ( range_selftest "$d" ); r6=$?
    rm -rf "$d"
    if [ "$r1" = 0 ] && [ "$r2" = 1 ] && [ "$r3" = 1 ] && [ "$r4" = 2 ] && [ "$r5" = 0 ] && [ "$r6" = 0 ]; then return 0; fi
    echo "selftest FAILED: ok=$r1 fused=$r2 wide=$r3 empty=$r4 numid=$r5 range=$r6" >&2; return 1
}

FILE=doc/08_tracking/bug/bug_db.sdn
RUN_SELFTEST_ONLY=0
RANGE=
while [ $# -gt 0 ]; do
    case "$1" in
        --selftest) RUN_SELFTEST_ONLY=1 ;;
        --range) RANGE=${2:-}; shift ;;
        *) FILE=$1 ;;
    esac
    shift
done
if [ "$RANGE" != "" ]; then
    selftest || { echo "ERROR — nothing was checked (selftest failed)"; exit 2; }
    case "$RANGE" in *..*) ;; *) echo "ERROR — nothing was checked (--range needs <base>..<head>)"; exit 2 ;; esac
    range_check "$RANGE"; exit $?
fi
selftest || { echo "ERROR — nothing was checked (selftest failed)"; exit 2; }
if [ "$RUN_SELFTEST_ONLY" = 1 ]; then echo "PASS — selftest 7 fixtures"; exit 0; fi
[ -f "$FILE" ] || { echo "ERROR — nothing was checked ($FILE missing)"; exit 2; }
scan "$FILE"
