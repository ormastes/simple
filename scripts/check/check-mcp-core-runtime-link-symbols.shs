#!/bin/sh
# Focused reproducer for the MCP core-runtime link contract.
set -eu

archive=${1:-}
[ -f "$archive" ] || {
  echo "usage: $0 <libsimple_runtime.a>" >&2
  exit 2
}
command -v nm >/dev/null 2>&1 || {
  echo "BLOCKED: nm is required" >&2
  exit 2
}

symbols=$(nm -g --defined-only "$archive")
missing=0
for symbol in rt_array_enumerate rt_collection_remove text_dot_from_char_code; do
  if ! printf '%s\n' "$symbols" | awk -v symbol="$symbol" '$NF == symbol { found = 1 } END { exit !found }'; then
    echo "FAIL: MCP core runtime archive lacks $symbol" >&2
    missing=$((missing + 1))
  fi
done
[ "$missing" -eq 0 ] || exit 1
echo "PASS: MCP core runtime archive exports all required collection/text symbols"
