#!/bin/sh
# Answer "what is this compiler binary, and which fixes does it contain?"
#
# Why this exists (2026-07-28): multiple lanes spent hours measuring compiler
# binaries that predated the fixes they were testing, then reported the null
# result as evidence the fix did not work. Three separate traps caused it:
#
#   1. `--version` lies by omission. build/bootstrap/stage3/.../simple prints
#      "simple-bootstrap 1.0.0-beta" and nothing else -- no commit, no date.
#      Two binaries eleven hours and one critical fix apart print the SAME
#      string.
#
#   2. mtime lies. `bin/simple` is a SYMLINK whose own mtime (2026-07-25
#      07:45) is unrelated to its target's mtime (2026-07-28 12:13). Agents
#      quoted the symlink's date all day and concluded the deployed compiler
#      was three days stale when it was twenty minutes old. ALWAYS resolve the
#      link before trusting a timestamp.
#
#   3. `strings` lies about lineage. A pure-Simple self-hosted binary links
#      the Rust runtime archives, so Rust panic paths, /rustc/<sha>/ and
#      cargo/registry strings appear in BOTH lineages. Likewise `llvm` strings
#      appear even when only LLD is linked. Grepping strings for "rust" or
#      "llvm" and concluding anything about lineage or backends is unsound --
#      this produced a direct contradiction between two agents on the same
#      binary on the same day.
#
# What is actually sound, and is what this script uses:
#
#   * LINEAGE -> nm symbol NAMESPACE, not strings. A pure-Simple self-hosted
#     binary contains unmangled Simple-compiled functions (cli__bootstrap_main__*).
#     A Rust seed contains that name only Rust-mangled (_ZN...17h<hash>), or
#     not at all. This discriminates cleanly; strings does not.
#
#   * BACKEND PRESENCE -> nm for `_ZN4llvm` (LLVM codegen C++ symbols) and
#     distinguishing them from `_ZN3lld` (the linker). ~50k llvm:: symbols and
#     0 lld:: symbols means real LLVM codegen is linked.
#
#   * BACKEND REACHABILITY -> presence of a symbol is NOT proof a backend is
#     selectable. Only `--probe` settles it, by compiling a fixture under each
#     backend and requiring observably different behaviour.
#
#   * COMMIT CONTENT -> marker strings that a specific commit introduced. See
#     the MARKERS table below; add a row when you land a fix whose presence a
#     later lane will need to verify. A marker must be a real string LITERAL
#     that survives into the binary -- comments and match arms do NOT.
#
# Usage:
#   check-compiler-provenance.shs [binary ...]     # default: the usual suspects
#   check-compiler-provenance.shs --probe [binary ...]  # + backend reachability
#                                                       # (compiles; ~10s each)
#
# Exit 0 = report produced, 2 = a named binary was missing/unreadable.

set -u

PROBE=0
case "${1:-}" in --probe) PROBE=1; shift ;; esac

REPO=$(cd "$(dirname "$0")/../.." && pwd)

if [ $# -gt 0 ]; then
  BINS="$*"
else
  BINS="$REPO/bin/simple
$REPO/bin/release/x86_64-unknown-linux-gnu/simple
$REPO/build/bootstrap/stage3/x86_64-unknown-linux-gnu/simple
$REPO/build/redeploy_out/simple_stage2"
fi

# MARKERS: <string literal>|<commit>|<what it proves>
# Only literals that reach the binary. Verify a new row with:
#   strings -a <binary built after> | grep -c '<literal>'   -> nonzero
#   strings -a <binary built before> | grep -c '<literal>'  -> zero
MARKERS='[jit-fallback]|5c75a1bbce0|JIT symbol manifest + fallback marker
SIMPLE_JIT_STRICT|5c75a1bbce0|JIT strict-mode env knob
rt_index_of|ab773bb5d5e|.? operator fix
ambiguous LLVM method resolution|(pre-existing)|LLVM codegen linked (Rust-side diagnostic)'

rc=0

for b in $BINS; do
  [ -n "$b" ] || continue
  echo "============================================================"
  if [ ! -e "$b" ]; then
    echo "MISSING: $b"
    rc=2
    continue
  fi

  real=$(readlink -f "$b")
  echo "path    : $b"
  if [ "$real" != "$b" ]; then
    echo "SYMLINK -> $real"
    # stat does NOT dereference; date -r DOES. Using date -r here would print
    # the target's mtime and defeat the whole point of this line.
    echo "          (link's own mtime $(stat -c '%y' "$b" 2>/dev/null | cut -c1-19) is NOT the binary's date)"
  fi
  echo "mtime   : $(date -r "$real" '+%F %T %z' 2>/dev/null)"
  echo "size    : $(wc -c < "$real" | tr -d ' ')"
  echo "sha256  : $(sha256sum "$real" 2>/dev/null | cut -c1-16)..."

  # --- lineage: symbol namespace, NOT strings ---
  # Count ANY module-qualified Simple symbol (lowercase name containing `__`),
  # not one hard-coded entry point. Keying on `cli__bootstrap_main__` alone gave
  # a FALSE "RUST SEED" verdict on 2026-07-29 for a genuinely pure-Simple build
  # carrying 20,192 unmangled symbols (cli__*, backend__*) that simply used a
  # different entry name. Rust-mangled symbols start `_ZN`, so they cannot match.
  simple_syms=$(nm "$real" 2>/dev/null | grep -cE ' T [a-z][A-Za-z0-9_]*__[A-Za-z0-9_]' || true)
  rust_syms=$(nm "$real" 2>/dev/null | grep -c ' T _ZN' || true)
  cargo_paths=$(strings -a "$real" 2>/dev/null | grep -c 'cargo/registry' || true)
  if [ "${simple_syms:-0}" -gt 0 ] && [ "${rust_syms:-0}" -gt 0 ]; then
    lineage="HYBRID: $simple_syms Simple symbols + $rust_syms Rust-mangled"
  elif [ "${simple_syms:-0}" -gt 0 ]; then
    lineage="pure-Simple / self-hosted: $simple_syms unmangled Simple symbols, $cargo_paths cargo/registry paths"
  elif [ "${cargo_paths:-0}" -gt 0 ] || [ "${rust_syms:-0}" -gt 0 ]; then
    lineage="RUST SEED: 0 Simple symbols, $rust_syms Rust-mangled, $cargo_paths cargo/registry paths"
  else
    lineage="UNKNOWN: 0 Simple symbols, 0 Rust-mangled, 0 cargo paths (stripped binary?)"
  fi
  echo "lineage : $lineage"

  # The seed says so itself, if it is one. Do not suppress this warning.
  banner=$("$real" --version 2>&1 | head -3 | tr '\n' ' ')
  echo "version : $banner"

  # --- backends linked (llvm:: codegen vs lld:: linker) ---
  llvm_syms=$(nm "$real" 2>/dev/null | grep -c '_ZN4llvm' || true)
  lld_syms=$(nm "$real" 2>/dev/null | grep -c '_ZN3lld' || true)
  echo "backends: llvm::=$llvm_syms lld::=$lld_syms  (llvm:: >> 0 with lld::=0 means LLVM CODEGEN is linked, not just the linker)"

  # --- commit markers ---
  echo "markers :"
  echo "$MARKERS" | while IFS='|' read -r lit commit what; do
    [ -n "$lit" ] || continue
    n=$(strings -a "$real" 2>/dev/null | grep -cF "$lit" || true)
    if [ "${n:-0}" -gt 0 ]; then st="PRESENT"; else st="absent "; fi
    printf '          %s  %-14s %-3s  %s\n' "$st" "$commit" "$n" "$what"
  done

  # --- reachability (only with --probe) ---
  if [ "$PROBE" = 1 ]; then
    tmp=$(mktemp -d)
    printf 'fn main():\n    print("ABC".upper())\n' > "$tmp/p.spl"
    echo "probe   :"
    for bk in cranelift llvm; do
      out=$("$real" native-build --entry "$tmp/p.spl" --entry-closure --emit-archive \
              --target x86_64-unknown-none --backend "$bk" \
              --cache-dir "$tmp/c_$bk" -o "$tmp/$bk.a" 2>&1)
      prc=$?
      # Reachable = the backend ran and produced ITS OWN outcome. A backend
      # that is merely linked but not selectable falls through silently and
      # yields output identical to the default backend.
      printf '          --backend %-10s rc=%s %s\n' "$bk" "$prc" \
        "$(printf '%s' "$out" | tail -1 | cut -c1-70)"
    done
    rm -rf "$tmp"
  fi
done

echo "============================================================"
if [ "$PROBE" = 0 ]; then
  echo "note: run with --probe to test whether a linked backend is actually"
  echo "      SELECTABLE. Symbol presence alone does not prove reachability."
fi
exit $rc
