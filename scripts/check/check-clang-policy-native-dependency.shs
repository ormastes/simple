#!/bin/sh
# Prove a policy-only stamp change schedules C and explicitly tagged C++ objects.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
fixture_root=$(mktemp -d "${TMPDIR:-/tmp}/simple-clang-policy-native.XXXXXX")
trap 'rm -rf "$fixture_root"' EXIT HUP INT TERM

mkdir "$fixture_root/source"
cat > "$fixture_root/source/CMakeLists.txt" <<EOF
cmake_minimum_required(VERSION 3.18)
project(simple_clang_policy_fixture C CXX)
include("$repo_root/cmake/SimpleClangPolicy.cmake")
set_source_files_properties(custom.src PROPERTIES LANGUAGE CXX COMPILE_FLAGS "-x c++")
add_executable(policy_fixture main.c custom.src)
simple_clang_policy_attach(policy_fixture "\${CMAKE_CURRENT_SOURCE_DIR}/policy.stamp")
EOF
printf 'int main(void) { return 0; }\n' > "$fixture_root/source/main.c"
printf 'int policy_fixture_cpp(void) { return 1; }\n' > "$fixture_root/source/custom.src"
printf '%064d\n' 1 > "$fixture_root/source/policy.stamp"

if ! cmake -S "$fixture_root/source" -B "$fixture_root/build" -G Ninja \
    > "$fixture_root/configure.log" 2>&1; then
    cat "$fixture_root/configure.log" >&2
    exit 1
fi
if ! cmake --build "$fixture_root/build" > "$fixture_root/initial.log" 2>&1; then
    cat "$fixture_root/initial.log" >&2
    exit 1
fi
if ! ninja -C "$fixture_root/build" -n | grep -q 'no work to do'; then
    echo 'FAIL: unchanged policy did not produce a native no-op' >&2
    exit 1
fi

# Atomic replacement mirrors the controller stamp writer and changes no source.
printf '%064d\n' 2 > "$fixture_root/source/policy.next"
mv "$fixture_root/source/policy.next" "$fixture_root/source/policy.stamp"
ninja -C "$fixture_root/build" -n > "$fixture_root/changed.log"
if ! grep -q 'Building C object' "$fixture_root/changed.log"; then
    echo 'FAIL: policy-only change did not schedule C compilation' >&2
    exit 1
fi
if ! grep -q 'Building CXX object' "$fixture_root/changed.log"; then
    echo 'FAIL: policy-only change did not schedule explicitly tagged C++ compilation' >&2
    exit 1
fi
cmake --build "$fixture_root/build" > "$fixture_root/rebuild.log" 2>&1
if ! ninja -C "$fixture_root/build" -n | grep -q 'no work to do'; then
    echo 'FAIL: rebuilt policy did not converge to a native no-op' >&2
    exit 1
fi

echo 'PASS: unchanged policy is a no-op; policy-only change rebuilds C and explicit C++ objects'
