#!/bin/sh
# Focused no-browser contract test for scripts/check/lib/pinned-electron-resolver.shs.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
HELPER="$ROOT_DIR/scripts/check/lib/pinned-electron-resolver.shs"
PRODUCER="$ROOT_DIR/scripts/check/produce-aetheric-host-web-gui-evidence.shs"
EVENT_WRAPPER="$ROOT_DIR/scripts/check/check-wm-browser-event-routing-evidence.shs"

fail() {
    echo "pinned-electron-resolver-self-test: $1" >&2
    exit 1
}

write_metadata() {
    package_version="$1"
    lock_root_version="$2"
    lock_nested_version="$3"
    installed_version="$4"
    cat >"$TMP_DIR/tools/electron-shell/package.json" <<EOF
{"dependencies":{"electron":"$package_version"}}
EOF
    cat >"$TMP_DIR/tools/electron-shell/package-lock.json" <<EOF
{
  "packages": {
    "": { "dependencies": { "electron": "$lock_root_version" } },
    "node_modules/electron": {
      "version": "$lock_nested_version"
    }
  }
}
EOF
    cat >"$TMP_DIR/tools/electron-shell/node_modules/electron/package.json" <<EOF
{"name":"electron","version":"$installed_version"}
EOF
}

write_cli() {
    version="$1"
    cat >"$TMP_DIR/tools/electron-shell/node_modules/electron/cli.js" <<EOF
#!/bin/sh
printf '%s\\n' "$version"
EOF
    chmod +x "$TMP_DIR/tools/electron-shell/node_modules/electron/cli.js"
}

assert_reason() {
    expected="$1"
    if resolve_electron_bin; then fail "unexpected-success:$expected"; fi
    [ "$ELECTRON_RESOLVER_REASON" = "$expected" ] || fail "reason:$expected:$ELECTRON_RESOLVER_REASON"
}

[ "${1:-}" = "--self-test" ] || fail "expected --self-test"
[ -f "$HELPER" ] || fail "missing-helper"
for metadata in "$ROOT_DIR/tools/electron-shell/package.json" "$ROOT_DIR/tools/electron-shell/package-lock.json"; do
    grep -Fq '"electron": "42.5.0"' "$metadata" || fail "root-version-not-pinned:$metadata"
done
grep -A2 -F '"node_modules/electron"' "$ROOT_DIR/tools/electron-shell/package-lock.json" | grep -Fq '"version": "42.5.0"' || fail "nested-version-not-pinned"
for wrapper in "$PRODUCER" "$EVENT_WRAPPER"; do
    grep -Fq 'ELECTRON_RESOLVER_ROOT="$ROOT_DIR"' "$wrapper" || fail "resolver-root-not-pinned:$wrapper"
    grep -Fq 'pinned-electron-resolver.shs' "$wrapper" || fail "resolver-not-sourced:$wrapper"
    grep -Fq 'resolve_electron_bin || fail "$ELECTRON_RESOLVER_REASON"' "$wrapper" || fail "resolver-not-called:$wrapper"
    ! grep -Fq 'npx electron' "$wrapper" || fail "npx-electron-forbidden:$wrapper"
done
! grep -Fq 'sh -c "$RUNNER' "$EVENT_WRAPPER" || fail "string-launch-forbidden"
! grep -Fq '"$ELECTRON_RESOLVED_BIN" --no-sandbox' "$EVENT_WRAPPER" || fail "event-no-sandbox-forbidden"
! grep -Fq '"$ELECTRON_RESOLVED_BIN" --disable-gpu' "$EVENT_WRAPPER" || fail "event-disable-gpu-forbidden"
! grep -Fq 'ELECTRON_DISABLE_SANDBOX=1 xvfb-run' "$EVENT_WRAPPER" || fail "event-sandbox-env-forbidden"
grep -Fq 'diagnostic-launch-flags-not-production' "$EVENT_WRAPPER" || fail "diagnostic-flags-not-blocked"
grep -Fq 'wm_browser_event_routing_renderer_sandboxed=$renderer_sandboxed' "$EVENT_WRAPPER" || fail "sandbox-runtime-not-recorded"
grep -Fq 'wm_browser_event_routing_gpu_compositing_status=$gpu_compositing_status' "$EVENT_WRAPPER" || fail "gpu-runtime-not-recorded"
grep -Fq 'wm_browser_event_routing_webgl_status=$webgl_status' "$EVENT_WRAPPER" || fail "webgl-runtime-not-recorded"
grep -Fq 'SIMPLE_BIN="$SIMPLE_BIN"' "$EVENT_WRAPPER" || fail "aetheric-simple-bin-not-explicit"
grep -Fq 'BUILD_DIR="$AETHERIC_PROOF_DIR"' "$EVENT_WRAPPER" || fail "aetheric-proof-root-not-preserved"
grep -Fq 'sandbox: true' "$ROOT_DIR/tools/web-render-backend/wm_event_check.js" || fail "event-renderer-sandbox-not-enabled"
grep -Fq 'contextIsolation: true' "$ROOT_DIR/tools/web-render-backend/wm_event_check.js" || fail "event-context-isolation-not-enabled"
grep -Fq 'nodeIntegration: false' "$ROOT_DIR/tools/web-render-backend/wm_event_check.js" || fail "event-node-integration-not-disabled"
! grep -Fq 'disableHardwareAcceleration' "$ROOT_DIR/tools/web-render-backend/wm_event_check.js" || fail "event-gpu-disabled"
! grep -Fq 'sandbox: false' "$ROOT_DIR/tools/web-render-backend/wm_event_check.js" || fail "event-renderer-sandbox-disabled"
grep -Fq 'process.sandboxed === true' "$ROOT_DIR/tools/web-render-backend/wm_event_check.js" || fail "event-sandbox-runtime-signal-missing"
grep -Fq 'app.getGPUFeatureStatus()' "$ROOT_DIR/tools/web-render-backend/wm_event_check.js" || fail "event-gpu-runtime-signal-missing"

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/simple-electron-resolver.XXXXXX")"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT INT TERM
mkdir -p "$TMP_DIR/tools/electron-shell/node_modules/.bin" "$TMP_DIR/tools/electron-shell/node_modules/electron"
write_metadata 42.5.0 42.5.0 42.5.0 42.5.0
write_cli v42.5.0
ln -s ../electron/cli.js "$TMP_DIR/tools/electron-shell/node_modules/.bin/electron"

ELECTRON_RESOLVER_ROOT="$TMP_DIR"
. "$HELPER"
unset ELECTRON_BIN
resolve_electron_bin || fail "worktree-resolution:$ELECTRON_RESOLVER_REASON"
[ "$ELECTRON_RESOLVED_BIN" = "$TMP_DIR/tools/electron-shell/node_modules/.bin/electron" ] || fail "worktree-path"

cat >"$TMP_DIR/fake-electron" <<'EOF'
#!/bin/sh
printf '%s\n' v42.5.0
EOF
chmod +x "$TMP_DIR/fake-electron"
ELECTRON_BIN="$TMP_DIR/fake-electron"
assert_reason invalid-electron-command
unset ELECTRON_BIN

write_metadata 41.0.0 42.5.0 42.5.0 42.5.0
assert_reason electron-version-mismatch
write_metadata 42.5.0 41.0.0 42.5.0 42.5.0
assert_reason electron-version-mismatch
write_metadata 42.5.0 42.5.0 41.0.0 42.5.0
assert_reason electron-version-mismatch
write_metadata 42.5.0 42.5.0 42.5.0 41.0.0
assert_reason electron-version-mismatch
write_metadata 42.5.0 42.5.0 42.5.0 42.5.0

rm "$TMP_DIR/tools/electron-shell/node_modules/.bin/electron"
ln -s ../../../../fake-electron "$TMP_DIR/tools/electron-shell/node_modules/.bin/electron"
assert_reason invalid-electron-command
rm "$TMP_DIR/tools/electron-shell/node_modules/.bin/electron"
assert_reason missing-pinned-electron
ln -s ../electron/cli.js "$TMP_DIR/tools/electron-shell/node_modules/.bin/electron"

write_cli v41.0.0
assert_reason electron-version-mismatch
write_cli v42.5.0

mv "$TMP_DIR/tools/electron-shell/node_modules" "$TMP_DIR/node_modules-real"
ln -s "$TMP_DIR/node_modules-real" "$TMP_DIR/tools/electron-shell/node_modules"
assert_reason invalid-electron-command
rm "$TMP_DIR/tools/electron-shell/node_modules"
mv "$TMP_DIR/node_modules-real" "$TMP_DIR/tools/electron-shell/node_modules"

mv "$TMP_DIR/tools/electron-shell/node_modules/.bin" "$TMP_DIR/bin-real"
ln -s "$TMP_DIR/bin-real" "$TMP_DIR/tools/electron-shell/node_modules/.bin"
assert_reason invalid-electron-command
rm "$TMP_DIR/tools/electron-shell/node_modules/.bin"
mv "$TMP_DIR/bin-real" "$TMP_DIR/tools/electron-shell/node_modules/.bin"

echo "pinned_electron_resolver_self_test=pass"
