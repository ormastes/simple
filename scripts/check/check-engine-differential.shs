#!/bin/sh
# Thin CI wrapper for scripts/check/check_engine_differential.spl.
#
# The harness itself is pure Simple; this wrapper exists only so CI can invoke
# it the same way as the other scripts/check/check-*.shs gates, and so the
# repo-root requirement is enforced rather than assumed.
#
# `native-build` resolves its source root from the tree it is invoked in, so a
# run from anywhere but the repo root makes every native build fail and the
# whole native lane reads as a false LANE_ERROR. Fail closed on that instead
# of reporting a vacuous pass.
#
# Exit code is the number of UNBASELINED divergences (0 = no new divergence).
# Known, already-filed divergences are listed in the harness's baselines() and
# do not fail the gate.
#
# Usage:
#   sh scripts/check/check-engine-differential.shs
#   DIFF_LANES=interpret,jit sh scripts/check/check-engine-differential.shs
#
# The native lane runs a full native-build per fixture and takes several
# minutes; DIFF_LANES=interpret,jit is the fast pre-push configuration.

set -e

if [ ! -e .git ] && [ ! -e .jj ]; then
    echo "ERROR — must run from the repo root (native-build resolves its source root from cwd); nothing was checked"
    exit 2
fi

if [ ! -d test/fixtures/engine_differential ]; then
    echo "ERROR — fixture corpus test/fixtures/engine_differential is missing; nothing was checked"
    exit 2
fi

SIMPLE="${SIMPLE_BIN:-bin/simple}"
if [ ! -x "$SIMPLE" ]; then
    echo "ERROR — compiler binary '$SIMPLE' not found or not executable; nothing was checked"
    exit 2
fi

"$SIMPLE" run scripts/check/check_engine_differential.spl
