#!/bin/sh
# Thin CI wrapper for scripts/check/check_engine_differential.spl.
#
# The harness itself is pure Simple; this wrapper exists only so CI can invoke
# it the same way as the other scripts/check/check-*.shs gates, and so the
# repo-root requirement is enforced rather than assumed.
#
# `native-build` resolves its source root from the tree it is invoked in, so a
# run from anywhere but the repo root makes every native build fail and the
# whole native lane reads as a false LANE_ERROR. Fail closed on that instead
# of reporting a vacuous pass.
#
# Exit code is a STATUS, not a count: 0 = no new divergence, 1 = at least one
# unbaselined divergence, 2 = nothing was checked. The NUMBER of unbaselined
# divergences is parsed out of the harness's own summary line
# (`divergences: N (M NEW, unbaselined)`) and reported in the verdict.
#
# It used to say "exit code is the number of unbaselined divergences", and the
# verdict printed that exit code as the count. It never was one: the harness
# does `print(FAIL ...)` then `return 1` (check_engine_differential.spl:383-385),
# a status. So EVERY run with >=1 new divergence reported exactly `=1` — a real
# 6-divergence run was published as `=1` on 2026-08-24. The contract as written
# was also unimplementable: 2 already means ERROR, and exit codes cap at 255.
#
# Known, already-filed divergences are listed in the harness's baselines() and
# do not fail the gate.
#
# Usage:
#   sh scripts/check/check-engine-differential.shs
#   DIFF_LANES=interpret,jit sh scripts/check/check-engine-differential.shs
#
# The native lane runs a full native-build per fixture and takes several
# minutes; DIFF_LANES=interpret,jit is the fast pre-push configuration.

# --selftest (fatal, runs before any scan) proves the wrapper's own
# classification: that a non-zero harness status becomes FAIL and a zero status
# becomes PASS, and that a vacuous run (0 fixtures) is ERROR rather than a pass.
#
# Verdict line (house convention, last line of stdout):
#   PASS — <n> fixture(s) checked, unbaselined divergence(s)=0   exit 0
#   FAIL — <n> fixture(s) checked, unbaselined divergence(s)=<k> exit 1
#   ERROR — nothing was checked (<reason>)                       exit 2
#
# A Phase 9 evidence receipt is minted for the verdict (ADDITIVE: emit_receipt
# never changes this gate's verdict or exit status).

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
. "$ROOT_DIR/scripts/check/lib/emit_receipt.shs"

# die_error <verdict-line> — print an ERROR verdict, REVOKE this gate's
# evidence receipt, and exit 2. Every ERROR path goes through here for the same
# reason check-aspect-seal.shs does: a gate that exits 2 has checked nothing,
# and leaving its previous PASS receipt on disk lets a dead gate keep testifying
# to check-critical-release-seal.shs. See receipt_error() in
# lib/emit_receipt.shs.
die_error() {
    echo "$1"
    receipt_error "check-engine-differential" "$1" || true
    exit 2
}

FIXTURE_DIR="test/fixtures/engine_differential"

# parse_new_divergences <harness-stdout-file> -> echoes the TRUE count of
# unbaselined divergences, or nothing if the line is absent/malformed.
#
# The harness prints exactly one summary line of the form
#   divergences:       13 (6 NEW, unbaselined)
# and that parenthesised number is the only place the real count exists. The
# harness's exit status is a status, never a count -- reading it as one is the
# bug this function exists to prevent. Emitting NOTHING on a failed parse is
# deliberate: the caller turns that into ERROR rather than inventing a number.
parse_new_divergences() {
    sed -n 's/^divergences:[[:space:]]*[0-9][0-9]*[[:space:]]*(\([0-9][0-9]*\) NEW, unbaselined).*/\1/p' "$1" \
        | tail -1
}

# classify <harness-rc> <fixture-count> <new-divergence-count> -> echoes the
# verdict, returns the exit code the gate should use. Pure function, so
# --selftest can exercise it. The count is PARSED from the harness's summary,
# never inferred from its exit status.
classify() {
    _cd_rc="$1"
    _cd_n="$2"
    _cd_new="$3"
    if [ "${_cd_n:-0}" -eq 0 ]; then
        echo "ERROR — nothing was checked (0 fixture(s) in $FIXTURE_DIR; a vacuous run is not a pass)"
        return 2
    fi
    if [ "$_cd_rc" -eq 2 ]; then
        echo "ERROR — nothing was checked (harness compared no fixtures; see its own ERROR line above)"
        return 2
    fi
    # A non-zero harness status with no parsable count means the gate cannot
    # state how bad the divergence is. Report that, never a fabricated number.
    if [ "$_cd_rc" -ne 0 ] && [ -z "$_cd_new" ]; then
        echo "ERROR — nothing was checked (harness failed but printed no parsable 'divergences: N (M NEW, unbaselined)' summary; the count is unknown)"
        return 2
    fi
    if [ "$_cd_rc" -ne 0 ]; then
        echo "FAIL — $_cd_n fixture(s) checked, unbaselined divergence(s)=$_cd_new"
        return 1
    fi
    echo "PASS — $_cd_n fixture(s) checked, unbaselined divergence(s)=0"
    return 0
}

# The selftest runs FIRST and is FATAL on every invocation, not only on an
# explicit --selftest: house convention, and this one is pure shell (a few
# milliseconds), so there is no reason to make proving the classifier optional.
selftest() {
    _sfail=0
    _sfdir=$(mktemp -d) || { echo "selftest FAIL: mktemp" >&2; exit 2; }
    trap 'rm -rf "$_sfdir"' EXIT

    _v=$(classify 0 11 0); _rc=$?
    [ "$_rc" -eq 0 ] || { echo "selftest FAIL: rc=0 did not classify as PASS" >&2; _sfail=1; }
    case "$_v" in "PASS — 11 fixture(s) checked, unbaselined divergence(s)=0") ;;
        *) echo "selftest FAIL: unexpected PASS verdict: $_v" >&2; _sfail=1 ;; esac
    _v=$(classify 1 11 3); _rc=$?
    [ "$_rc" -eq 1 ] || { echo "selftest FAIL: rc=1 did not classify as FAIL" >&2; _sfail=1; }
    case "$_v" in *"unbaselined divergence(s)=3") ;;
        *) echo "selftest FAIL: FAIL verdict did not name the count: $_v" >&2; _sfail=1 ;; esac
    _v=$(classify 0 0 0); _rc=$?
    [ "$_rc" -eq 2 ] || { echo "selftest FAIL: 0 fixtures did not classify as ERROR" >&2; _sfail=1; }
    case "$_v" in "ERROR — nothing was checked"*) ;;
        *) echo "selftest FAIL: unexpected ERROR verdict: $_v" >&2; _sfail=1 ;; esac

    # INCIDENT FIXTURE (2026-08-24). The harness reported 6 NEW divergences and
    # the wrapper published `unbaselined divergence(s)=1`, because it printed
    # the harness's exit STATUS as if it were a count. This pins the parse: fed
    # the harness's real 6-NEW summary, the verdict must say =6 and must NOT
    # say =1. `classify 6 13` alone would not catch it -- the defect was in
    # where the number came from, so the parser is what has to be exercised.
    cat > "$_sfdir/six.txt" <<'EOF'
---
agreements:        7
divergences:       13 (6 NEW, unbaselined)
lane errors:       0 (failed closed -- not counted as divergence)
FAIL — 6 unbaselined divergence(s) among 13 fixture(s) compared
EOF
    _n=$(parse_new_divergences "$_sfdir/six.txt")
    [ "$_n" = "6" ] || { echo "selftest FAIL: parser read '$_n' from a 6-NEW summary, expected 6" >&2; _sfail=1; }
    _v=$(classify 1 13 "$_n"); _rc=$?
    [ "$_rc" -eq 1 ] || { echo "selftest FAIL: 6-NEW run did not classify as FAIL" >&2; _sfail=1; }
    case "$_v" in
        *"unbaselined divergence(s)=1") echo "selftest FAIL: 6 NEW divergences reported as =1 (the exit-status-as-count bug): $_v" >&2; _sfail=1 ;;
        *"unbaselined divergence(s)=6") ;;
        *) echo "selftest FAIL: 6-NEW verdict did not name 6: $_v" >&2; _sfail=1 ;;
    esac

    # A zero-NEW summary must parse as 0, so the parser cannot be a constant.
    printf 'divergences:       2 (0 NEW, unbaselined)\n' > "$_sfdir/zero.txt"
    _n=$(parse_new_divergences "$_sfdir/zero.txt")
    [ "$_n" = "0" ] || { echo "selftest FAIL: parser read '$_n' from a 0-NEW summary, expected 0" >&2; _sfail=1; }

    # No summary line at all + a failing harness = ERROR, never a fabricated count.
    printf 'the harness died before printing a summary\n' > "$_sfdir/none.txt"
    _n=$(parse_new_divergences "$_sfdir/none.txt")
    [ -z "$_n" ] || { echo "selftest FAIL: parser invented '$_n' from a summary-less log" >&2; _sfail=1; }
    _v=$(classify 1 13 "$_n"); _rc=$?
    [ "$_rc" -eq 2 ] || { echo "selftest FAIL: unparsable count did not classify as ERROR" >&2; _sfail=1; }

    # A harness ERROR (rc=2) is ERROR for the gate too, never FAIL-with-a-count.
    _v=$(classify 2 13 ""); _rc=$?
    [ "$_rc" -eq 2 ] || { echo "selftest FAIL: harness rc=2 did not classify as ERROR" >&2; _sfail=1; }

    rm -rf "$_sfdir"; trap - EXIT
    [ "$_sfail" -eq 0 ] || { echo "selftest FAILED"; exit 2; }
    return 0
}

selftest
if [ "${1:-}" = "--selftest" ]; then
    echo "PASS — 9 fixture(s) checked, selftest only (no scan requested)"
    exit 0
fi

# `-e`, not `-d`: in a linked `git worktree` `.git` is a FILE, and the `-d`
# form refused to run in every worktree while reporting it as "not the repo
# root". See doc/08_tracking/bug/single_module_native_build_dies_in_any_escape_and_mir_for_2026-08-22.md
if [ ! -e .git ] && [ ! -e .jj ]; then
    die_error "ERROR — must run from the repo root (native-build resolves its source root from cwd); nothing was checked"
fi

if [ ! -d "$FIXTURE_DIR" ]; then
    die_error "ERROR — nothing was checked (fixture corpus $FIXTURE_DIR is missing)"
fi

SIMPLE="${SIMPLE_BIN:-bin/simple}"
if [ ! -x "$SIMPLE" ]; then
    die_error "ERROR — compiler binary '$SIMPLE' not found or not executable; nothing was checked"
fi

N=$(find "$FIXTURE_DIR" -type f -name '*.spl' | wc -l | tr -d ' ')

# The harness's exit status is read DIRECTLY into a variable on the line after
# the invocation, never through a pipe: a pipeline's $? is the last command's
# status and has produced false greens in this repo before.
HARNESS_OUT=$(mktemp) || die_error "ERROR — nothing was checked (mktemp failed)"
trap 'rm -f "$HARNESS_OUT"' EXIT

set +e
"$SIMPLE" run scripts/check/check_engine_differential.spl >"$HARNESS_OUT" 2>&1
HARNESS_RC=$?
cat "$HARNESS_OUT"

# The true count comes from the harness's own summary line, NOT from
# $HARNESS_RC -- that is a status, and printing it as a count is the exact
# false-green this wrapper was fixed for.
NEW_DIVERGENCES=$(parse_new_divergences "$HARNESS_OUT")

VERDICT=$(classify "$HARNESS_RC" "$N" "$NEW_DIVERGENCES")
GATE_RC=$?
printf '%s\n' "$VERDICT"
emit_receipt "check-engine-differential" "$VERDICT" || true
exit "$GATE_RC"
