#!/bin/sh
# check-simpleos-riscv64-image-header-contract.shs
#
# Kernel-side boot-contract gate for riscv64 — the riscv64 analogue of
# check-simpleos-arm64-unified-boot-contract's header half, per
# .claude/rules/board-runnable.md.
#
# Proves that a kernel image built from the REAL riscv64 early-boot sources
# (`examples/09_embedded/simple_os/arch/riscv64/boot/crt0.S` +
#  `.../arch/riscv64/linker.ld`) carries a structurally valid RISC-V Linux
# boot-image header (Linux Documentation/arch/riscv/boot-image-header.rst,
# version 0.2) in its FLAT Image, so that any Image-protocol loader
# (U-Boot `booti`, Limine `protocol: linux`, an EFI chain) can load it —
# while code0 remains a real jump, so a direct OpenSBI S-mode handover to
# 0x80200000 executes the same bytes unmodified.
#
# HONESTY NOTE — what "the kernel's contract" means today: existing riscv64
# kernels get their `_start` from naked-C stubs inside boot/*.c runtime files
# (e.g. baremetal_runtime_network_tail.inc.c:167), which carry NO Image
# header. crt0.S is the contract ARTIFACT those entry stubs must migrate
# onto; this gate pins the artifact. Wiring every riscv64 kernel build onto
# crt0.S is filed follow-up work, not silently claimed here.
#
# Payload: scripts/check/fixtures/riscv64_boot_contract_probe.c (mirror of
# the arm64 probe fixture) — the header is a property of crt0.S+linker.ld,
# not of any particular kernel body, same reasoning as the arm64 gate.
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> header field(s) checked, ...      exit 0
#   FAIL  — ...                                   exit 1
#   ERROR — nothing was checked: ...              exit 2
# A run that checks 0 fields is an ERROR, never a PASS.
# `--selftest` (also run, fatally, before every real scan) proves the header
# checker on fixture images: a well-formed fixture must PASS, a corrupt-magic2
# fixture must FAIL, a truncated fixture must FAIL, an empty file must yield
# 0 checked so the caller is forced to ERROR.
set -eu

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$REPO_ROOT"

ARCH_DIR=examples/09_embedded/simple_os/arch/riscv64
CRT0=$ARCH_DIR/boot/crt0.S
LD_SCRIPT=$ARCH_DIR/linker.ld
PROBE=scripts/check/fixtures/riscv64_boot_contract_probe.c
OUT=${OUT_DIR:-build/verify/simpleos-riscv64-image-header-contract}

verdict_error() { printf 'ERROR — nothing was checked: %s\n' "$1"; exit 2; }
verdict_fail()  { printf 'FAIL — %s\n' "$1"; exit 1; }

# --- header checker ---------------------------------------------------------
# check_image <flat-image> ; prints "CHECKED=<n>" on success (all fields ok),
# "BAD:<reason>" on a field failure, "CHECKED=0" when nothing was checkable.
check_image() {
    img=$1
    [ -s "$img" ] || { echo "CHECKED=0"; return 0; }
    sz=$(wc -c < "$img" | tr -d ' ')
    if [ "$sz" -lt 64 ]; then
        echo "BAD:flat Image is ${sz} bytes — shorter than the 64-byte header"
        return 0
    fi
    n=0
    # 1. code0 must be executable code, not data: RISC-V JAL opcode 0x6f.
    b0=$(od -An -tx1 -j0 -N1 "$img" | tr -d ' \n')
    op=$(( 0x$b0 & 0x7f ))
    [ "$op" -eq 111 ] || { echo "BAD:code0 is not a JAL jump (first byte $b0)"; return 0; }
    n=$((n + 1))
    # 2. text_offset (le64 at 8) == 0x200000 (2MB, the RV64 convention, and
    #    exactly linker.ld's 0x80200000 - RAM base 0x80000000).
    toff=$(od -An -tu8 -j8 -N8 "$img" | tr -d ' \n')
    [ "$toff" = "2097152" ] || { echo "BAD:text_offset=$toff, expected 2097152 (0x200000)"; return 0; }
    n=$((n + 1))
    # 3. image_size (le64 at 16) nonzero — mandatory, boot fails otherwise.
    imgsz=$(od -An -tu8 -j16 -N8 "$img" | tr -d ' \n')
    [ "$imgsz" -gt 0 ] 2>/dev/null || { echo "BAD:image_size=$imgsz"; return 0; }
    n=$((n + 1))
    # 4. flags (le64 at 24): bit0 = endianness, must be 0 (little-endian).
    flags=$(od -An -tu8 -j24 -N8 "$img" | tr -d ' \n')
    [ $((flags & 1)) -eq 0 ] || { echo "BAD:flags=$flags declares big-endian"; return 0; }
    n=$((n + 1))
    # 5. version (le32 at 32) == 0x00000002 (header version 0.2).
    ver=$(od -An -tx1 -j32 -N4 "$img" | tr -d ' \n')
    [ "$ver" = "02000000" ] || { echo "BAD:version bytes $ver, expected 02000000 (0.2)"; return 0; }
    n=$((n + 1))
    # 6. magic (le64 at 48) == "RISCV\0\0\0" (deprecated but still emitted).
    m1=$(od -An -tx1 -j48 -N8 "$img" | tr -d ' \n')
    [ "$m1" = "5249534356000000" ] || { echo "BAD:magic bytes $m1, expected 5249534356000000 (RISCV)"; return 0; }
    n=$((n + 1))
    # 7. magic2 (le32 at 56) == 0x05435352 "RSC\x05" — the field loaders test.
    m2=$(od -An -tx1 -j56 -N4 "$img" | tr -d ' \n')
    [ "$m2" = "52534305" ] || { echo "BAD:magic2 bytes $m2, expected 52534305 (RSC\\x05)"; return 0; }
    n=$((n + 1))
    echo "CHECKED=$n"
}

# --- fatal selftest, before every real scan ---------------------------------
selftest() {
    st=$OUT/selftest
    rm -rf "$st"; mkdir -p "$st"
    # Well-formed 64-byte header fixture, built field by field.
    good=$st/good.Image
    # code0: jal x0, +64  -> imm=64: opcode 0x6f, encoding 0x0400006f
    printf '\157\000\100\004' > "$good"                       # code0
    printf '\000\000\000\000' >> "$good"                      # code1
    printf '\000\000\040\000\000\000\000\000' >> "$good"      # text_offset 0x200000
    printf '\100\000\000\000\000\000\000\000' >> "$good"      # image_size 64
    printf '\000\000\000\000\000\000\000\000' >> "$good"      # flags LE
    printf '\002\000\000\000' >> "$good"                      # version 0.2
    printf '\000\000\000\000' >> "$good"                      # res1
    printf '\000\000\000\000\000\000\000\000' >> "$good"      # res2
    printf 'RISCV\000\000\000' >> "$good"                     # magic
    printf 'RSC\005' >> "$good"                               # magic2
    printf '\000\000\000\000' >> "$good"                      # res3
    r=$(check_image "$good")
    [ "$r" = "CHECKED=7" ] || { echo "selftest: well-formed fixture gave '$r', want CHECKED=7" >&2; return 1; }
    # Corrupt magic2 must FAIL naming magic2.
    bad=$st/bad-magic2.Image
    cp "$good" "$bad"
    printf 'XXXX' | dd of="$bad" bs=1 seek=56 conv=notrunc 2>/dev/null
    r=$(check_image "$bad")
    case "$r" in BAD:magic2*) : ;; *) echo "selftest: corrupt-magic2 fixture gave '$r', want BAD:magic2" >&2; return 1 ;; esac
    # Truncated image must FAIL.
    trunc=$st/trunc.Image
    dd if="$good" of="$trunc" bs=1 count=32 2>/dev/null
    r=$(check_image "$trunc")
    case "$r" in BAD:*) : ;; *) echo "selftest: truncated fixture gave '$r', want BAD" >&2; return 1 ;; esac
    # Empty file must yield CHECKED=0 (caller is forced to ERROR).
    : > "$st/empty.Image"
    r=$(check_image "$st/empty.Image")
    [ "$r" = "CHECKED=0" ] || { echo "selftest: empty fixture gave '$r', want CHECKED=0" >&2; return 1; }
    echo "[header-contract] selftest OK (4 fixtures)"
}

mkdir -p "$OUT"
if ! selftest; then
    verdict_error "selftest failed — the header checker cannot be trusted"
fi
if [ "${1:-}" = "--selftest" ]; then
    printf 'PASS — 4 selftest fixture(s) checked, header checker discriminates\n'
    exit 0
fi

# --- inputs & toolchain -----------------------------------------------------
for f in "$CRT0" "$LD_SCRIPT" "$PROBE"; do
    [ -s "$f" ] || verdict_error "missing input $f"
done
CROSS=
for c in riscv64-unknown-elf riscv64-linux-gnu; do
    if command -v "$c-gcc" >/dev/null 2>&1; then CROSS=$c-; break; fi
done
[ -n "$CROSS" ] || verdict_error "no riscv64 cross-gcc (riscv64-unknown-elf-gcc / riscv64-linux-gnu-gcc)"
OBJCOPY=${CROSS}objcopy
command -v "$OBJCOPY" >/dev/null 2>&1 || verdict_error "missing tool $OBJCOPY"

# --- build the probe kernel against the REAL early-boot sources -------------
CFLAGS="-march=rv64gc -mabi=lp64d -mcmodel=medany -ffreestanding -nostdlib -O1"
"${CROSS}gcc" $CFLAGS -c "$CRT0" -o "$OUT/crt0.o" >"$OUT/build.log" 2>&1 \
    || { cat "$OUT/build.log" >&2; verdict_error "crt0.S did not assemble"; }
"${CROSS}gcc" $CFLAGS -c "$PROBE" -o "$OUT/probe.o" >>"$OUT/build.log" 2>&1 \
    || { cat "$OUT/build.log" >&2; verdict_error "probe payload did not compile"; }
"${CROSS}ld" -T "$LD_SCRIPT" "$OUT/crt0.o" "$OUT/probe.o" -o "$OUT/probe.elf" \
    >>"$OUT/build.log" 2>&1 \
    || { cat "$OUT/build.log" >&2; verdict_error "probe kernel did not link"; }
"$OBJCOPY" -O binary "$OUT/probe.elf" "$OUT/probe.Image" \
    || verdict_error "flat Image extraction failed"

# Source-level invariants (cheap, catch edits that gut the header).
grep -q '0x05435352' "$CRT0" || verdict_error "crt0.S carries no RISC-V magic2"
grep -q 'ENTRY(_start)' "$LD_SCRIPT" || verdict_error "linker.ld does not enter at _start"

# --- check the flat Image ---------------------------------------------------
res=$(check_image "$OUT/probe.Image")
case "$res" in
    CHECKED=0)  verdict_error "flat Image was empty — nothing was checkable" ;;
    BAD:*)      verdict_fail "${res#BAD:} (image $OUT/probe.Image)" ;;
    CHECKED=*)  : ;;
    *)          verdict_error "internal: unexpected checker result '$res'" ;;
esac
n=${res#CHECKED=}

# ELF entry must equal the link base 0x80200000 (RAM base + text_offset).
entry=$("${CROSS}readelf" -h "$OUT/probe.elf" | sed -n 's/.*Entry point address:[[:space:]]*//p')
[ "$entry" = "0x80200000" ] || verdict_fail "ELF entry is $entry, expected 0x80200000"
n=$((n + 1))

# --- the REAL kernel entry stubs, not only the probe ------------------------
# Every naked-C `_start` under arch/riscv64/boot/ that real kernels link
# (baremetal_stubs.c for the smoke/net kernels, ghdl_boot_info_runtime.c for
# the GHDL lane, and the network-tail include compiled via a driver) must
# also place the header at flat-image offset 0. Each is compiled for real and
# linked through the REAL linker.ld; runtime symbols that only a full kernel
# provides are irrelevant to the header bytes, so unresolved externals are
# ignored for this structural link (never for a boot).
kernels_checked=0
check_stub_image() {
    src=$1; name=$2; extra=$3
    # shellcheck disable=SC2086
    "${CROSS}gcc" $CFLAGS $extra -c "$src" -o "$OUT/$name.o" \
        >>"$OUT/build.log" 2>&1 \
        || { tail -5 "$OUT/build.log" >&2; verdict_error "real kernel stub $src did not compile"; }
    "${CROSS}ld" -T "$LD_SCRIPT" --unresolved-symbols=ignore-all -e _start \
        --defsym=spl_start=0x80200000 --defsym=boot_main=0x80200000 \
        "$OUT/$name.o" -o "$OUT/$name.elf" >>"$OUT/build.log" 2>&1 \
        || { tail -5 "$OUT/build.log" >&2; verdict_error "real kernel stub $src did not link"; }
    "$OBJCOPY" -O binary "$OUT/$name.elf" "$OUT/$name.Image" \
        || verdict_error "flat Image extraction failed for $name"
    sres=$(check_image "$OUT/$name.Image")
    case "$sres" in
        CHECKED=0) verdict_error "flat Image for real kernel stub $name was empty" ;;
        BAD:*)     verdict_fail "REAL kernel entry $src: ${sres#BAD:} (image $OUT/$name.Image)" ;;
        CHECKED=*) kernels_checked=$((kernels_checked + 1)) ;;
        *)         verdict_error "internal: unexpected checker result '$sres' for $name" ;;
    esac
}
check_stub_image "$ARCH_DIR/boot/baremetal_stubs.c" baremetal_stubs \
    "-DSIMPLE_BOOT_MINIMAL=1 -DSIMPLE_RUNTIME_NO_ENTRY_UNUSED=0 -I$ARCH_DIR/boot"
check_stub_image "$ARCH_DIR/boot/ghdl_boot_info_runtime.c" ghdl_boot_info \
    "-I$ARCH_DIR/boot"
# The network-tail is an .inc.c (compiled only inside a full kernel TU), so
# its check is a SOURCE invariant, not a linked-image check: its _start must
# name the shared header fragment.
grep -q 'RV64_IMAGE_HEADER_ASM' "$ARCH_DIR/boot/baremetal_runtime_network_tail.inc.c" \
    || verdict_fail "baremetal_runtime_network_tail.inc.c _start carries no RV64_IMAGE_HEADER_ASM"
kernels_checked=$((kernels_checked + 1))
# The pure-Simple linker's generated __simple_riscv_entry stub must emit the
# same header (source invariant on the generator).
GEN=src/compiler/70.backend/backend/simpleos_native_linkers.spl
grep -q '0x05435352' "$GEN" \
    || verdict_fail "pure-Simple riscv64 link stub generator $GEN emits no RISC-V magic2 header"
kernels_checked=$((kernels_checked + 1))

printf 'PASS — %s header field(s) checked on the probe and %s real kernel entr(y/ies) verified, riscv64 images built from the real early-boot sources carry a valid RISC-V Linux boot-image header v0.2 (jump code0, text_offset 0x200000, magic2 RSC\\x05) with ELF entry 0x80200000\n' "$n" "$kernels_checked"
