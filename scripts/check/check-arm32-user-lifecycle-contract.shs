#!/bin/sh
# ARM32 EL0 filesystem-exec admission gate.
#
# The current ARM32 image is an NVFS/SMF capability probe.  It may print
# TEST PASSED, but it neither executes the mounted FSEXEC.ELF at EL0 nor
# returns through SVC for a reaped exit.  Keep that probe out of matrix
# evidence until the concrete lifecycle owners below are linked.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
mode=${1:---contract}

fail() { printf '%s\n' "arm32-user-lifecycle: $*" >&2; exit 1; }
require() { grep -Fq "$1" "$2" || fail "missing '$1' in $2"; }

matrix=$root/src/os/qemu_systest_contract.spl
unit=$root/test/01_unit/os/qemu_systest_contract_spec.spl
entry=$root/examples/09_embedded/simple_os/arch/arm32/boot/enter_user_first.s
vectors=$root/examples/09_embedded/simple_os/arch/arm32/boot/exception_vectors.s
stub=$root/examples/09_embedded/simple_os/arch/arm32/boot/baremetal_stubs.c
bridge=$root/src/os/kernel/arch/arm32/user_entry.spl
fs_entry=$root/examples/09_embedded/simple_os/arch/arm32/fs_exec_entry.spl

contract() {
    require 'FS_MOUNT_OK' "$matrix"
    require 'FS_LS_BEGIN path=/SYS/APPS' "$matrix"
    require 'FS_PROGRAM_BEGIN path=/FSEXEC.ELF arch=arm32' "$matrix"
    require 'SIMPLEOS_FS_EXEC_OK arch=arm32 nonce=' "$matrix"
    require 'FS_PROGRAM_END rc=37 reaped=true' "$matrix"
    require 'rejects the ARM32 NVFS/SMF probe as filesystem-exec evidence' "$unit"
    require 'boot-fail:FS_LS_BEGIN path=/SYS/APPS' "$unit"
}

admit() {
    contract
    [ -f "$entry" ] || fail 'not admitted: missing enter_user_first.s'
    [ -f "$vectors" ] || fail 'not admitted: missing exception_vectors.s'
    require 'rt_arm32_enter_user_first:' "$entry"
    require 'spsr' "$entry"
    require 'movs' "$entry"
    require 'rt_arm32_svc_vector:' "$vectors"
    require 'rt_arm32_svc_vector_init' "$stub"
    require 'rt_arm32_svc_resume_kernel' "$stub"
    [ -f "$bridge" ] || fail 'not admitted: missing user_entry.spl'
    require 'rt_arm32_exec_token_install' "$bridge"
    require 'rt_arm32_exec_token_take_result' "$bridge"
    require 'rt_arm32_fs_read_program' "$fs_entry"
    require 'rt_arm32_enter_user_first' "$fs_entry"
    if grep -Fq '(void)ctx;' "$stub"; then
        fail 'not admitted: context restore discards its destination context'
    fi
    printf '%s\n' 'PASS arm32 EL0 filesystem-exec lifecycle admitted'
}

case "$mode" in
    --contract)
        contract
        printf '%s\n' 'PASS arm32 contract rejects the NVFS/SMF probe'
        ;;
    --admit) admit ;;
    --self-test)
        contract
        if "$0" --admit >/dev/null 2>&1; then
            fail 'self-test expected the unimplemented EL0 lifecycle to be rejected'
        fi
        printf '%s\n' 'PASS arm32 EL0 lifecycle gate self-test'
        ;;
    *) fail 'usage: check-arm32-user-lifecycle-contract.shs [--contract|--admit|--self-test]' ;;
esac
