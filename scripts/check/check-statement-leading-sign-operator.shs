#!/bin/sh
# Guard: a statement that BEGINS with `-` at the same indent must be its own
# statement, not a continuation of the physical line above it.
#
# Regression guard for
# doc/08_tracking/bug/if_chain_last_arm_returns_previous_value_2026-07-28.md
#
# WHY THIS IS A PROBE AND NOT ONLY A SPEC: the spec runner cannot be run on
# every host in this tree (a seed without a working JIT drops every module to
# the interpreter and blows the runner's outer time budget), while a plain
# `run` of a 20-line probe finishes in seconds. The sibling spec is
# test/01_unit/statement_leading_sign_operator_spec.spl; this file is the
# instrument that can actually be executed in a gate.
#
# The defect: `15` on one line and `-1` on the next parsed as `15 - 1`, so a
# function whose last statement was `-1` returned 14. Measured 2026-09-02 on
# the deployed 2026-07-25 seed: minus_last=14, nested_if=7 (both wrong).
#
# Compiler under test: ${SIMPLE_BIN:-$ROOT/bin/simple} — never hardcoded, per
# doc/08_tracking/bug/guards_hardcode_stale_seed_binary_census_2026-08-17.md
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> case(s) checked, 0 mis-parsed   exit 0
#   FAIL  — <n> case(s) checked, <k> mis-parsed exit 1
#   ERROR — nothing was checked                 exit 2   (never a pass)

set -u

ROOT=$(cd "$(dirname "$0")/.." && cd .. && pwd)
SIMPLE="${SIMPLE_BIN:-$ROOT/bin/simple}"

if [ ! -x "$SIMPLE" ]; then
    echo "ERROR — nothing was checked (no $SIMPLE)"
    exit 2
fi

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

cat > "$TMP/probe.spl" <<'PROBE'
fn minus_last() -> i64:
    15
    -1

fn minus_middle() -> i64:
    val a = 15
    -1
    99

fn nested_if(x: i64) -> i64:
    if x > 0:
        10
        -3
    else:
        0

fn main():
    print("minus_last=" + minus_last().to_text())
    print("minus_middle=" + minus_middle().to_text())
    print("nested_if=" + nested_if(1).to_text())
main()
PROBE

"$SIMPLE" run "$TMP/probe.spl" > "$TMP/out" 2>&1
_rc=$?
if [ "$_rc" -ne 0 ]; then
    # A compile/parse failure is not a pass, and not a silent skip either.
    sed -n '1,20p' "$TMP/out"
    echo "ERROR — nothing was checked (probe did not run, rc=$_rc)"
    exit 2
fi

CHECKED=0
FAILED=""
# Expected values are the LANGUAGE's answer, not the current binary's.
for _case in 'minus_last=-1' 'minus_middle=99' 'nested_if=-3'; do
    CHECKED=$((CHECKED + 1))
    _name=${_case%%=*}
    if ! grep -qx "$_case" "$TMP/out"; then
        _got=$(grep "^$_name=" "$TMP/out" | head -1)
        FAILED="$FAILED $_name(expected ${_case#*=}, got ${_got#*=})"
    fi
done

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi

if [ -n "$FAILED" ]; then
    echo "FAIL — $CHECKED case(s) checked, mis-parsed:$FAILED"
    exit 1
fi

echo "PASS — $CHECKED case(s) checked, 0 mis-parsed"
exit 0
