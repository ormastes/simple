#!/bin/sh
# Refuse to let a new SILENTLY-INERT `impl <Class>:` block into src/lib.
#
# ---------------------------------------------------------------------------
# WHAT IS ACTUALLY BROKEN
# ---------------------------------------------------------------------------
# Extension modules work. An `impl <Class>:` block in a module OTHER than the
# one declaring <Class> DOES contribute its methods at the call site -- proved
# 2026-08-05 five independent ways (standalone 3-file case; through a
# re-export facade; with a second impl block after a trailing `export use`;
# with the importer NOT naming the class in its selection list; and on the
# real tree by moving JsInterpreter.cancel_pending_async_fetches out of
# src/lib/nogc_sync_mut/js/engine/interpreter.spl into the extension module
# src/lib/nogc_sync_mut/js/engine/interpreter_async.spl -- the spec verdict was
# byte-identical, `24 examples, 2 failures`, same two pre-existing failures).
# The repo depends on this working: 41 same-tier out-of-module impl blocks in
# src/lib (1,043 methods) plus 122 in src/compiler, src/os and src/app (1,500
# methods). The self-hosted compiler's own MirLowering / HirLowering / MirToLlvm
# are built out of exactly this pattern.
#
# What IS broken is narrower and has nothing to do with method collection:
#
#   An `impl <Class>:` block placed in stdlib tier T, where <Class> is declared
#   in NO module of tier T, can never contribute anything to anybody.
#
# The stdlib tier layout is the reason. `src/lib/gc_async_mut/js/engine/
# interpreter.spl` is a 7-line facade that re-exports `std.nogc_async_mut.js.
# engine.interpreter.*`, which is itself an 18-line facade re-exporting a
# hand-written symbol list from `std.nogc_sync_mut.js.engine.interpreter`,
# where `class JsInterpreter` actually lives. The facades re-export the CLASS.
# Nothing anywhere imports gc_async_mut's or nogc_async_mut's SIBLING extension
# modules, so every `impl JsInterpreter:` block in those two tiers is an orphan:
# it parses, it lints clean, it emits no diagnostic of any kind, and not one of
# its methods is reachable from any call site.
#
# This burned a lane on 2026-08-04. It needed `cancel_pending_async_fetches` on
# JsInterpreter, added it to src/lib/gc_async_mut/js/engine/interpreter_async.spl
# -- the natural place, right next to the call site in the same tier -- and got
# "not found" with no explanation. Six more placements later it landed the
# method in the class body of nogc_sync_mut/js/engine/interpreter.spl
# (e24a7e251b3) and filed the compiler defect that this script now closes: the
# defect was never method collection, it was that placing a method somewhere
# unreachable is COMPLETELY SILENT.
#
# ---------------------------------------------------------------------------
# THE RULE
# ---------------------------------------------------------------------------
# For every `impl <Class>:` at column 0 in src/lib/<tier>/**.spl, `<Class>`
# must be declared (`class`/`struct`/`enum`, with or without `pub`) somewhere
# under src/lib/<tier>/. If it is not, the block is inert and this guard fails.
#
# Scope is deliberately src/lib only -- the tier facades are what create the
# trap, and outside src/lib there are no tiers, so the predicate would not mean
# anything there. Within src/lib the predicate has zero false positives: all 41
# legitimate same-tier out-of-module blocks pass it.
#
# ---------------------------------------------------------------------------
# BASELINE RATCHET
# ---------------------------------------------------------------------------
# 16 blocks / 278 methods already violate this, all of them `impl JsInterpreter`
# in the gc_async_mut and nogc_async_mut copies of the JS engine. They are dead
# code and should be deleted, but deleting 278 methods is its own lane with its
# own blast radius, so they are recorded below by exact path and must not grow.
# A violation in a file that is NOT on the baseline list is a hard failure. The
# baseline is a list of PATHS, not a count: moving the problem to a new file is
# a failure, and the guard also fails if a baseline path stops existing, so the
# list cannot rot into a permanent excuse.
#
# Verdict line is always the LAST line of stdout:
#   PASS  -- exit 0, states how many impl blocks were actually examined (> 0)
#   FAIL  -- exit 1, a new inert block, or a stale baseline entry
#   ERROR -- exit 2, nothing was checked (wrong cwd, no src/lib, no matches)
#
# Fail-closed on cwd, exactly like check-tree-size-push.shs: run from a real
# repo root. `--selftest` runs first and is fatal.

set -u

SELFTEST=0
[ "${1:-}" = "--selftest" ] && SELFTEST=1

# Files allowed to contain an inert cross-tier impl block, as of 2026-08-05.
# Recorded so the family cannot grow while it waits to be deleted.
BASELINE='src/lib/gc_async_mut/js/engine/interpreter_array_methods.spl
src/lib/gc_async_mut/js/engine/interpreter_async.spl
src/lib/gc_async_mut/js/engine/interpreter_eval.spl
src/lib/gc_async_mut/js/engine/interpreter_eval_member.spl
src/lib/gc_async_mut/js/engine/interpreter_exec.spl
src/lib/gc_async_mut/js/engine/interpreter_native.spl
src/lib/gc_async_mut/js/engine/interpreter_object.spl
src/lib/gc_async_mut/js/engine/interpreter_string_methods.spl
src/lib/nogc_async_mut/js/engine/interpreter_array_methods.spl
src/lib/nogc_async_mut/js/engine/interpreter_async.spl
src/lib/nogc_async_mut/js/engine/interpreter_eval.spl
src/lib/nogc_async_mut/js/engine/interpreter_eval_member.spl
src/lib/nogc_async_mut/js/engine/interpreter_exec.spl
src/lib/nogc_async_mut/js/engine/interpreter_native.spl
src/lib/nogc_async_mut/js/engine/interpreter_object.spl
src/lib/nogc_async_mut/js/engine/interpreter_string_methods.spl'

# ugrep is the default `grep` on dev machines and does not honour these flags
# the same way; pin the real one.
GREP=/usr/bin/grep
[ -x "$GREP" ] || GREP=grep

# scan_tree <root> -> emits "<file>|<class>" for every inert impl block found
# under <root>/src/lib. Sets SCANNED to the number of impl blocks examined.
scan_tree() {
    _root=$1
    _lib=$_root/src/lib
    SCANNED=0
    INERT=''
    [ -d "$_lib" ] || return 0

    for _tierdir in "$_lib"/*/; do
        [ -d "$_tierdir" ] || continue
        _tier=$(basename "$_tierdir")

        # Every class/struct/enum name declared anywhere in this tier.
        _decls=$($GREP -rhoE '^(pub )?(class|struct|enum) [A-Za-z_][A-Za-z0-9_]*' \
                     --include='*.spl' "$_tierdir" 2>/dev/null \
                 | awk '{print $NF}' | sort -u)

        # Every top-level impl block in this tier, as file:Class.
        _impls=$($GREP -rnoE '^impl [A-Za-z_][A-Za-z0-9_]*[[:space:]]*:' \
                     --include='*.spl' "$_tierdir" 2>/dev/null)
        [ -n "$_impls" ] || continue

        while IFS= read -r _line; do
            [ -n "$_line" ] || continue
            SCANNED=$((SCANNED + 1))
            _file=${_line%%:*}
            _cls=$(printf '%s\n' "$_line" | sed 's/.*^*impl \([A-Za-z_][A-Za-z0-9_]*\).*/\1/')
            printf '%s\n' "$_decls" | $GREP -qxF "$_cls" && continue
            _rel=${_file#"$_root"/}
            INERT="$INERT$_rel|$_cls
"
        done <<EOF
$_impls
EOF
    done
    return 0
}

# ---------------------------------------------------------------------------
# selftest: a synthetic tier where the predicate must fire, and one where it
# must not. Without this the guard could silently match nothing and "pass".
# ---------------------------------------------------------------------------
run_selftest() {
    _t=$(mktemp -d) || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
    mkdir -p "$_t/src/lib/good" "$_t/src/lib/bad"

    # good tier: class declared in one module, impl in another -> legitimate.
    printf 'pub class Widget:\n    n: i64\n' > "$_t/src/lib/good/a.spl"
    printf 'use x.a.{Widget}\n\nimpl Widget:\n    me ext() -> i64:\n        return 1\n' \
        > "$_t/src/lib/good/b.spl"

    # bad tier: impl for a class this tier never declares -> inert.
    printf 'use x.a.{Widget}\n\nimpl Widget:\n    me ext() -> i64:\n        return 1\n' \
        > "$_t/src/lib/bad/b.spl"

    scan_tree "$_t"
    _got=$INERT
    rm -rf "$_t"

    if [ "$SCANNED" -ne 2 ]; then
        echo "selftest: expected to examine 2 impl blocks, examined $SCANNED"
        return 1
    fi
    if ! printf '%s' "$_got" | $GREP -q '^src/lib/bad/b.spl|Widget$'; then
        echo "selftest: FALSE NEGATIVE — inert block in src/lib/bad was not flagged"
        return 1
    fi
    if printf '%s' "$_got" | $GREP -q '^src/lib/good/'; then
        echo "selftest: FALSE POSITIVE — legitimate same-tier block in src/lib/good was flagged"
        return 1
    fi
    return 0
}

if ! run_selftest; then
    echo "ERROR — nothing was checked (selftest failed)"
    exit 2
fi
if [ "$SELFTEST" = "1" ]; then
    echo "PASS — selftest only: 2 fixtures checked, both correct"
    exit 0
fi

# ---------------------------------------------------------------------------
# real scan
# ---------------------------------------------------------------------------
ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$ROOT" ] || [ ! -d "$ROOT/src/lib" ]; then
    echo "ERROR — nothing was checked (run from the root of a real clone; src/lib not found)"
    exit 2
fi

scan_tree "$ROOT"
if [ "$SCANNED" -eq 0 ]; then
    echo "ERROR — nothing was checked (no top-level impl blocks found under src/lib)"
    exit 2
fi

FAILED=0

# (1) any inert block in a file that is not on the baseline is a new defect.
NEW=''
printf '%s' "$INERT" | while IFS='|' read -r f c; do
    [ -n "$f" ] || continue
    printf '%s\n' "$BASELINE" | $GREP -qxF "$f" && continue
    echo "  NEW inert impl: impl $c in $f"
    echo "      '$c' is declared in no module of that tier, so none of this"
    echo "      block's methods can reach any call site. Declare the method in"
    echo "      the tier that owns the class, or move the class into this tier."
done > "${TMPDIR:-/tmp}/.inert_new.$$"
NEW=$(cat "${TMPDIR:-/tmp}/.inert_new.$$"); rm -f "${TMPDIR:-/tmp}/.inert_new.$$"
if [ -n "$NEW" ]; then
    echo "$NEW"
    FAILED=1
fi

# (2) a baseline entry that no longer exists means the list is stale and must
#     be trimmed, so it cannot become a permanent blanket excuse.
STALE=''
for b in $BASELINE; do
    [ -f "$ROOT/$b" ] || STALE="$STALE  STALE baseline entry (file is gone): $b
"
done
if [ -n "$STALE" ]; then
    printf '%s' "$STALE"
    echo "      Delete these lines from BASELINE in $0."
    FAILED=1
fi

INERT_COUNT=$(printf '%s' "$INERT" | $GREP -c . 2>/dev/null || echo 0)

if [ "$FAILED" = "1" ]; then
    echo "FAIL — $SCANNED impl block(s) checked; new or stale inert cross-tier impl blocks (see above)"
    exit 1
fi

echo "PASS — $SCANNED impl block(s) checked under src/lib; $INERT_COUNT inert, all on the recorded baseline"
exit 0
