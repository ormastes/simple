#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
. "$ROOT_DIR/scripts/check/lib/demand-driven-smf-evidence.shs"
RECEIPT_DIR=${DDSM_EVIDENCE_DIR:-$ROOT_DIR/build/test-artifacts/demand-driven-smf}

usage() { echo "usage: $0 --scenario NAME" >&2; exit 2; }
[ "${1:-}" = --scenario ] && [ -n "${2:-}" ] && [ "$#" -eq 2 ] || usage
scenario=$2

case "$scenario" in
  sectioned-archive) authority=DDSM-REQ-001; marker=independent_section_checks=true ;;
  package-command-resolution) authority=DDSM-REQ-002; marker=all_command_forms_compatible=true ;;
  warm-index-only) authority=DDSM-REQ-003; marker=recursive_scan_count=0 ;;
  bounded-import-head) authority=DDSM-REQ-004; marker=body_parse_count=0 ;;
  lazy-import-materialization) authority=DDSM-REQ-005; marker=unrequested_section_reads=0 ;;
  mir-proxy-rejection) authority=DDSM-REQ-006; marker=mir_started=false ;;
  hir-demand-closure) authority=DDSM-REQ-007; marker=unrequested_body_count=0 ;;
  shared-artifact-service) authority=DDSM-REQ-008; marker=profiles_served=compiler,test,mcp,lsp,optimizer ;;
  persisted-action-graph) authority=DDSM-REQ-009; marker=repeat_schedule_digest_match=true ;;
  host-shared-cas-authority) authority=DDSM-REQ-010; marker=daemon_memory_authoritative=false ;;
  development-backend) authority=DDSM-REQ-011; marker=foreground_llvm_count=0 ;;
  precompiled-runtime-stdlib) authority=DDSM-REQ-012; marker=unnecessary_rebuild_count=0 ;;
  generic-shape-sharing) authority=DDSM-REQ-013; marker=duplicate_baseline_bodies=0 ;;
  async-io-sync-semantics) authority=DDSM-REQ-014; marker=semantic_output_match=true ;;
  parser-acceleration-admission) authority=DDSM-REQ-015; marker=gpu_default=false ;;
  background-isolation) authority=DDSM-REQ-016; marker=foreground_digest_unchanged=true ;;
  single-file-compatibility) authority=DDSM-REQ-017; marker=ambiguous_scan_started=false ;;
  portable-file-view) authority=DDSM-REQ-018; marker=range_semantics_match=true ;;
  mapping-unavailable) authority=DDSM-REQ-019; marker=compile_result_match=true ;;
  file-read-policy-matrix) authority=DDSM-REQ-020; marker=policy_matrix_pass=true ;;
  phase-0-interface-freeze) authority=DDSM-PLAN-P0; marker=phase_gate=pass ;;
  phase-1-smf-archives) authority=DDSM-PLAN-P1; marker=phase_gate=pass ;;
  phase-2-package-commands) authority=DDSM-PLAN-P2; marker=phase_gate=pass ;;
  phase-3-artifact-service) authority=DDSM-PLAN-P3; marker=phase_gate=pass ;;
  phase-4-action-graph) authority=DDSM-PLAN-P4; marker=phase_gate=pass ;;
  phase-5-lazy-hir) authority=DDSM-PLAN-P5; marker=phase_gate=pass ;;
  phase-6-backends) authority=DDSM-PLAN-P6; marker=phase_gate=pass ;;
  phase-7-generic-shapes) authority=DDSM-PLAN-P7; marker=phase_gate=pass ;;
  phase-8-io-parser) authority=DDSM-PLAN-P8; marker=phase_gate=pass ;;
  phase-9-cutover) authority=DDSM-PLAN-P9; marker=phase_gate=pass ;;
  stop-unresolved-proxy) authority=DDSM-STOP-001; marker=cutover_allowed=false ;;
  stop-daemon-correctness) authority=DDSM-STOP-002; marker=cutover_allowed=false ;;
  stop-warm-recursive-scan) authority=DDSM-STOP-003; marker=cutover_allowed=false ;;
  stop-background-identity) authority=DDSM-STOP-004; marker=cutover_allowed=false ;;
  stop-gpu-default) authority=DDSM-STOP-005; marker=cutover_allowed=false ;;
  *) echo "FAIL: unknown demand-driven SMF scenario: $scenario" >&2; exit 1 ;;
esac

receipt="$RECEIPT_DIR/functional/$scenario.receipt.env"
if ! ddsm_validate_receipt "$receipt" demand-driven-smf-functional-receipt-v1 "$scenario" "$authority" runtime; then
    echo "BLOCKED: admitted runtime receipt missing or invalid: $receipt" >&2
    exit 1
fi
grep -Fxq "$marker" "$receipt" || { echo "FAIL: required marker missing: $marker" >&2; exit 1; }
printf 'scenario=%s\nauthority_id=%s\n%s\n' "$scenario" "$authority" "$marker"
