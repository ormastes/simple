#!/bin/sh
# Requires a rebuilt pure-Simple compiler with its admitted runtime capsule.
set -eu
[ "$#" -eq 2 ] || { echo 'usage: check-cranelift-result-match-try-witness.shs COMPILER OUTPUT_DIR' >&2; exit 2; }
compiler=$1
output_dir=$2
[ -x "$compiler" ] || { echo 'compiler must be executable' >&2; exit 2; }
mkdir -p "$output_dir"
"$compiler" native-build test/fixtures/compiler/cranelift_result_match_try_witness.spl \
    --backend=cranelift --threads 1 -o "$output_dir/result-match-try" \
    > "$output_dir/compile.log" 2>&1
"$output_dir/result-match-try" > "$output_dir/actual.txt" 2> "$output_dir/stderr.txt"
printf 'result-match-try-ok\n' > "$output_dir/expected.txt"
cmp "$output_dir/expected.txt" "$output_dir/actual.txt"
test ! -s "$output_dir/stderr.txt"
echo 'cranelift_result_match_try_witness=PASS'
