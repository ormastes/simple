#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
cd "$root"
provider=examples/09_embedded/simple_os/arch/x86_64/boot/freestanding_value_registry.c
impl=examples/09_embedded/simple_os/arch/common/boot/freestanding_value_registry_impl.h
linker=src/compiler/70.backend/backend/llvm_native_link.spl
test -f "$provider" && test -f "$impl"
grep -Fq '#include "../../common/boot/freestanding_value_registry_impl.h"' "$provider"
grep -Fq 'int8_t rt_struct_receiver_valid' "$impl"
grep -Fq 'freestanding_value_registry.c", registry_o' "$linker"
grep -Fq 'crt_o, stubs_o, registry_o, type_o, auto_o, init_o' "$linker"
count=$(grep -c 'freestanding_value_registry.c", registry_o' "$linker")
test "$count" -eq 1
echo 'PASS x86_64 freestanding value registry provider closure'
