#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
"${CC:-cc}" -std=c11 -D_POSIX_C_SOURCE=200809L -O2 -Wall -Wextra -Werror \
    -pedantic -pthread "$root/src/runtime/runtime_hal_buffer_dispatch.c" \
    "$root/src/runtime/test/runtime_hal_process_socket_lifecycle_v4_selfcheck.c" \
    -o "$work/selfcheck"
"${NM:-nm}" "$work/selfcheck" | grep -q ' rt_hal_process_wait_dispatch_direct_v4$'
"${NM:-nm}" "$work/selfcheck" | grep -q ' rt_hal_socket_connect_dispatch_compare_v4$'
"$work/selfcheck"
printf '%s\n' 'STATUS: PASS runtime HAL process/socket V4 lifecycle/concurrency/perf/RSS'
