#!/bin/sh
# Produce unsigned reviewer input from a real loopback server. Bootstrap only.
# The server must write the bytes it received to WEB_SERVER_RECEIVED_REQUEST_FILE.
set -u

die() { echo "web-server-request-port producer: FAIL — $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing-tool-$1"; }
need nc; need ss; need sha256sum

out=${WEB_SERVER_EVIDENCE_DIR:-}
server=${WEB_SERVER_EXECUTABLE:-}
source=${WEB_SERVER_SOURCE:-}
toolchain_id=${WEB_SERVER_TOOLCHAIN_ID:-}
fingerprint=${MUST_CHECK_FINGERPRINT:-}
port=${WEB_SERVER_PORT:-}
request_input=${WEB_SERVER_REQUEST_FILE:-}
expected_response=${WEB_SERVER_EXPECTED_RESPONSE_FILE:-}
timeout_ms=${WEB_SERVER_STOP_TIMEOUT_MS:-5000}
run_id=${WEB_SERVER_RUN_ID:-web-$(date -u +%Y%m%dT%H%M%SZ)-$$}
[ -n "$out" ] && [ -n "$server" ] && [ -x "$server" ] && [ -f "$source" ] || die missing-required-input
[ -n "$fingerprint" ] && [ -n "$toolchain_id" ] && [ -f "$request_input" ] && [ -f "$expected_response" ] || die missing-required-input
case "$port" in ''|*[!0-9]*) die invalid-port;; esac
[ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || die invalid-port
case "$timeout_ms" in ''|*[!0-9]*) die invalid-timeout;; esac
[ "$timeout_ms" -gt 0 ] && [ "$timeout_ms" -le 30000 ] || die invalid-timeout

mkdir -p "$out" || die create-output
received=$out/server-received-request.bin
response=$out/response.bin
request=$out/request.bin
cp "$request_input" "$request" || die copy-request
cp "$server" "$out/server-executable" || die copy-executable
chmod 700 "$out/server-executable" || die executable-mode
cp "$source" "$out/server-source.spl" || die copy-source
started=$(date +%s000)
WEB_SERVER_RECEIVED_REQUEST_FILE="$received" "$server" --bind 127.0.0.1 --port "$port" >"$out/server.stdout" 2>"$out/server.stderr" &
pid=$!
cleanup() { kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; }
trap cleanup EXIT INT TERM

i=0
while [ "$i" -lt 100 ]; do
    owner=$(ss -ltnp "sport = :$port" 2>/dev/null | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' | head -1)
    [ "$owner" = "$pid" ] && break
    kill -0 "$pid" 2>/dev/null || die server-exited-before-ready
    i=$((i + 1)); sleep 0.05
done
[ "${owner:-}" = "$pid" ] || die listener-not-owned-by-server
ready=$(date +%s000)
requested=$(date +%s000)
nc -w 5 127.0.0.1 "$port" <"$request" >"$response" || die request-failed
responded=$(date +%s000)
[ -f "$received" ] && cmp "$request" "$received" >/dev/null || die server-did-not-record-exact-request
cmp "$expected_response" "$response" >/dev/null || die unexpected-response-bytes
status=$(sed -n '1s/^HTTP\/1\.1 \([0-9][0-9][0-9]\) .*/\1/p' "$response" | tr -d '\r')
[ -n "$status" ] || die missing-response-status

kill "$pid" 2>/dev/null || true
limit=$((timeout_ms / 50)); [ "$limit" -gt 0 ] || limit=1; i=0
while kill -0 "$pid" 2>/dev/null && [ "$i" -lt "$limit" ]; do i=$((i + 1)); sleep 0.05; done
kill -0 "$pid" 2>/dev/null && die bounded-stop-timeout
wait "$pid" 2>/dev/null || true
trap - EXIT INT TERM
stopped=$(date +%s000)
listener_count=$(ss -ltnp "sport = :$port" 2>/dev/null | sed 1d | wc -l | tr -d ' ')
process_count=$(ps -p "$pid" -o pid= 2>/dev/null | wc -l | tr -d ' ')
[ "$listener_count" -eq 0 ] && [ "$process_count" -eq 0 ] || die post-stop-leak

host=$(hostname)
printf '%s\n' 'evidence_schema=simple.web-server-toolchain-identity/v1' "run_id=$run_id" "toolchain_id=$toolchain_id" >"$out/toolchain.env"
printf '%s\n' 'evidence_schema=simple.web-server-target-identity/v1' "run_id=$run_id" "host=$host" "os=$(uname -s)" "arch=$(uname -m)" >"$out/target.env"
req_hex=$(od -An -v -tx1 "$request" | tr -d ' \n')
resp_hex=$(od -An -v -tx1 "$response" | tr -d ' \n')
sha() { sha256sum "$1" | awk '{print $1}'; }
cat >"$out/lifecycle.env" <<EOF
evidence_schema=simple.web-server-request-port/v1
source_fingerprint=$fingerprint
run_id=$run_id
bind_address=127.0.0.1
configured_port=$port
observed_listener_address=127.0.0.1:$port
server_pid=$pid
listener_pid=$pid
readiness_status=ready
request_sha256=$(sha "$request")
response_sha256=$(sha "$response")
executable_sha256=$(sha "$out/server-executable")
source_sha256=$(sha "$out/server-source.spl")
toolchain_sha256=$(sha "$out/toolchain.env")
target_sha256=$(sha "$out/target.env")
started_at_unix_ms=$started
ready_at_unix_ms=$ready
request_at_unix_ms=$requested
response_at_unix_ms=$responded
stopped_at_unix_ms=$stopped
stop_timeout_ms=$timeout_ms
stop_status=exited
post_stop_listener_count=$listener_count
post_stop_process_count=$process_count
expected_request_hex=$req_hex
expected_response_hex=$resp_hex
response_status=$status
target_host=$host
final_verdict=PASS
EOF
echo "web-server-request-port producer: PASS — unsigned evidence at $out; independent review/signing still required"
