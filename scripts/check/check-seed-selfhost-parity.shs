#!/bin/sh
# check-seed-selfhost-parity.shs — Phase 7 exit gate of the hardening plan
# (doc/03_plan/compiler/hardening/critical_hardening_plan_2026-08-21.md
# §"Phase 7"; research plan §19.4 bootstrap matrix, §22.5 release).
#
# The differential this gate runs: the SAME generator source
# (src/app/compiler_schema/main.spl — the enum/grammar registry plus the
# completeness-seal coverage table) is executed by TWO identity-verified
# compilers — the Rust bootstrap SEED and the pure-Simple SELF-HOSTED binary —
# and the manifests they emit are compared row for row. The generator source
# is identical on both sides, so any difference in its output is a divergence
# between the two compilers, which is exactly what Phase 7 must rule out.
#
# What it compares (both sides, generated fresh into private temp dirs):
#   registry/*.sdn   `generate <out>`  — enum variants + grammar productions,
#                                       the same files check-compiler-schema-
#                                       fresh.shs keeps under
#                                       spec/compiler_schema/registry/
#   coverage.txt     `coverage` stdout — the completeness-seal coverage table
# A "row" is an entry-start line (`variant:`, `production:`, `enum:`) in an
# .sdn manifest or an indented table line in coverage.txt. stderr (seed banner,
# gc-warnings, lint notes) is captured per side and NEVER enters the compared
# value.
#
# Identity is fail-closed (scripts/check/lib/require-self-hosted.shs):
#   - the SELF side must NOT print the seed banner. If it does, the deployed
#     "self-hosted" binary is the Rust seed and the comparison would be seed vs
#     seed — the exact false green this gate exists to prevent -> ERROR.
#   - the SEED side MUST print the seed banner, or it is not the independent
#     Rust oracle this gate claims to compare against -> ERROR.
#   - the two sides must be different real files -> ERROR otherwise.
# There is deliberately NO self-consistency fallback: one compiler on both
# sides is a comparison that structurally cannot fail.
#
# Verdict is always the LAST line of stdout:
#   PASS  — <n> manifest row(s) compared, diff=0                           exit 0
#   FAIL  — <n> manifest row(s) compared, diff=<k>: <manifest names>       exit 1
#   ERROR — nothing was checked (<reason>)                                 exit 2
# Non-vacuity is absolute: 0 rows on either side, a missing or unverifiable
# binary, or a generator that fails on either side is ERROR, never PASS —
# absence of a compiler is absence of evidence. The ERROR reason names which
# SIDE and which COMMAND failed, so a red run tells you what to fix.
#
# Usage:
#   sh scripts/check/check-seed-selfhost-parity.shs [--seed <bin>] [--self <bin>]
#   sh scripts/check/check-seed-selfhost-parity.shs --selftest
# Env: SEED_BINARY / SELF_BINARY (same as the flags), PARITY_TIMEOUT_S (per
# generator run, default 300 — the seed has genuinely hung before, see
# check-native-seed-parity.shs), EVIDENCE_DIR (receipts).
# Defaults: SELF = first executable bin/release/*/simple, else bin/simple;
# SEED = src/compiler_rust/target/bootstrap/simple, else
# src/compiler_rust/target/release/simple.
#
# --selftest runs before every scan and is FATAL. Its fixtures are fake
# compilers (tiny executables that answer --version and `run ... generate`)
# driven through the SAME scan function as the real run, so the selftest
# proves the scanner can see a PASS, a one-row diff, an empty manifest, a
# missing binary, a seed masquerading as self-hosted, and an oracle that is
# not a seed (6 fixtures).

set -u

# Phase 9: mint an evidence receipt for this gate's verdict (additive; never
# changes the verdict or the exit status). See scripts/check/lib/emit_receipt.shs.
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/lib/emit_receipt.shs"
# Identity helpers (binary_is_seed, resolve_binary, real_path). Its
# check_untestable() prints to stderr with no verdict line and no receipt, so
# it is redefined below — later sh definition wins — to route through die_error.
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/lib/require-self-hosted.shs"

CHECK_ID="check-seed-selfhost-parity"
REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd) || REPO_ROOT=""
GEN_MAIN="src/app/compiler_schema/main.spl"
PARITY_TIMEOUT_S="${PARITY_TIMEOUT_S:-300}"

# RECEIPTS=1 on every real terminal path; the selftest flips it to 0 while it
# drives fixture scans, so a fixture's deliberate ERROR never touches
# build/evidence (a receipt about a fake compiler is worse than none).
RECEIPTS=1
die_error() {
    echo "ERROR — nothing was checked ($1)"
    [ "$RECEIPTS" = 1 ] && { receipt_error "$CHECK_ID" "ERROR — nothing was checked ($1)" || true; }
    exit 2
}
check_untestable() { die_error "$*"; }

[ -n "$REPO_ROOT" ] || die_error "cannot resolve repo root"
cd "$REPO_ROOT" || die_error "cannot cd to repo root"

MODE="scan"
SEED_ARG="${SEED_BINARY:-}"
SELF_ARG="${SELF_BINARY:-}"
while [ $# -gt 0 ]; do
    case "$1" in
        --selftest) MODE="selftest"; shift ;;
        --seed) SEED_ARG="${2:-}"; shift 2 ;;
        --self) SELF_ARG="${2:-}"; shift 2 ;;
        *) die_error "unknown argument: $1" ;;
    esac
done

command -v timeout >/dev/null 2>&1 || die_error "required tool 'timeout' is not available"

TMP_ROOT=$(mktemp -d) || die_error "mktemp failed"
trap 'rm -rf "$TMP_ROOT"' EXIT

# ---------------------------------------------------------------------------
# resolve_self <path-or-empty>  -> sets RESOLVED_BIN; ERRORs otherwise.
# resolve_seed <path-or-empty>  -> same, but requires the seed banner.
# They set a variable rather than echo so die_error's verdict line reaches
# stdout instead of being swallowed by a command substitution. Both are
# exercised by the selftest through scan(), so their ERROR reasons are part of
# the tested contract.
# ---------------------------------------------------------------------------
RESOLVED_BIN=""
resolve_self() {
    _rs_t="$1"
    if [ -z "$_rs_t" ]; then
        for _c in bin/release/*/simple bin/simple; do
            [ -f "$_c" ] && [ -x "$_c" ] && { _rs_t="$_c"; break; }
        done
        [ -n "$_rs_t" ] || die_error "no self-hosted binary: none of bin/release/*/simple or bin/simple is executable; absence of a compiler is absence of evidence — deploy one (bin/simple build bootstrap) or pass --self <bin>"
    fi
    _rs_bin=$(resolve_binary "$_rs_t") || die_error "self-hosted binary '$_rs_t' is not an executable file; absence of a compiler is absence of evidence"
    _rs_v=$("$_rs_bin" --version 2>&1)
    _rs_rc=$?
    [ "$_rs_rc" -eq 0 ] || die_error "self-hosted binary '$_rs_bin --version' exited $_rs_rc; cannot establish identity"
    [ -n "$_rs_v" ] || die_error "self-hosted binary '$_rs_bin --version' produced no output; cannot establish identity"
    case "$_rs_v" in
        *"bootstrap seed only"*|*"Rust-built Simple binary"*|*"Rust-built"*)
            die_error "self-hosted binary is the Rust seed: $(real_path "$_rs_bin") prints the seed banner; comparing seed to seed is a same-path tautology and proves nothing — deploy a pure-Simple self-hosted binary or pass --self <bin>"
            ;;
    esac
    RESOLVED_BIN="$_rs_bin"
}

resolve_seed() {
    _rd_t="$1"
    if [ -z "$_rd_t" ]; then
        for _c in src/compiler_rust/target/bootstrap/simple src/compiler_rust/target/release/simple; do
            [ -f "$_c" ] && [ -x "$_c" ] && { _rd_t="$_c"; break; }
        done
        [ -n "$_rd_t" ] || die_error "no Rust seed oracle: neither src/compiler_rust/target/bootstrap/simple nor src/compiler_rust/target/release/simple is executable — build the seed or pass --seed <bin>"
    fi
    _rd_bin=$(resolve_binary "$_rd_t") || die_error "seed binary '$_rd_t' is not an executable file; without a second, distinct compiler there is nothing to compare"
    _rd_v=$("$_rd_bin" --version 2>&1)
    _rd_rc=$?
    [ "$_rd_rc" -eq 0 ] || die_error "seed binary '$_rd_bin --version' exited $_rd_rc; cannot establish identity"
    [ -n "$_rd_v" ] || die_error "seed binary '$_rd_bin --version' produced no output; cannot establish identity"
    case "$_rd_v" in
        *"bootstrap seed only"*|*"Rust-built Simple binary"*|*"Rust-built"*) : ;;
        *) die_error "seed binary is not the Rust seed: $(real_path "$_rd_bin") prints no seed banner, so it is not the independent oracle this comparison requires" ;;
    esac
    RESOLVED_BIN="$_rd_bin"
}

# first_error <files...> — the first compiler diagnostic (`error[...]`), else the
# first panic/traceback, else the last non-empty line; JIT fallback notices
# that merely contain "Error" are not the cause and are skipped.
first_error() {
    _fe=$(cat "$@" 2>/dev/null | grep -m1 -E '^error(\[|:)')
    [ -n "$_fe" ] || _fe=$(cat "$@" 2>/dev/null | grep -m1 -E 'panic|Traceback')
    [ -n "$_fe" ] || _fe=$(cat "$@" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -1)
    printf '%s\n' "$_fe"
}

# generate_side <label> <bin> <out_dir>
# Runs the registry generator and the coverage report with <bin>, under
# timeout. stdout of `coverage` becomes <out_dir>/coverage.txt; stderr of both
# is kept in <out_dir>.<cmd>.err and never compared. Exit codes are read
# DIRECTLY into a variable on the line after each invocation.
generate_side() {
    _gs_label=$1
    _gs_bin=$2
    _gs_out=$3
    mkdir -p "$_gs_out" || die_error "cannot create $_gs_out"
    env -u SIMPLE_BOOTSTRAP timeout "$PARITY_TIMEOUT_S" "$_gs_bin" run "$GEN_MAIN" generate "$_gs_out/registry" \
        > "$_gs_out.generate.out" 2> "$_gs_out.generate.err"
    _gs_rc=$?
    if [ "$_gs_rc" -ne 0 ]; then
        _gs_first=$(first_error "$_gs_out.generate.err" "$_gs_out.generate.out")
        [ "$_gs_rc" -eq 124 ] && _gs_first="timed out after ${PARITY_TIMEOUT_S}s"
        die_error "$_gs_label side generator failed (rc=$_gs_rc): '$_gs_bin run $GEN_MAIN generate <out>'${_gs_first:+ — $_gs_first}"
    fi
    env -u SIMPLE_BOOTSTRAP timeout "$PARITY_TIMEOUT_S" "$_gs_bin" run "$GEN_MAIN" coverage \
        > "$_gs_out/coverage.txt" 2> "$_gs_out.coverage.err"
    _gs_rc=$?
    if [ "$_gs_rc" -ne 0 ]; then
        _gs_first=$(first_error "$_gs_out.coverage.err" "$_gs_out/coverage.txt")
        [ "$_gs_rc" -eq 124 ] && _gs_first="timed out after ${PARITY_TIMEOUT_S}s"
        die_error "$_gs_label side coverage report failed (rc=$_gs_rc): '$_gs_bin run $GEN_MAIN coverage'${_gs_first:+ — $_gs_first}"
    fi
}

# rows_in <dir> — count manifest rows across registry/*.sdn and coverage.txt.
rows_in() {
    _ri_n=0
    for _f in "$1"/registry/*.sdn; do
        [ -f "$_f" ] || continue
        _c=$(grep -c '^[a-z_][a-z_]*:$' "$_f")
        _ri_n=$((_ri_n + _c))
    done
    if [ -f "$1/coverage.txt" ]; then
        _c=$(grep -c '^  [^ ]' "$1/coverage.txt")
        _ri_n=$((_ri_n + _c))
    fi
    echo "$_ri_n"
}

# manifest_names <dir> — relative names of every manifest file on one side.
manifest_names() {
    ( cd "$1" && { ls registry/*.sdn 2>/dev/null; [ -f coverage.txt ] && echo coverage.txt; } ) | sort
}

# scan <self_bin_or_empty> <seed_bin_or_empty> <mint_receipt:0|1>
# Prints the verdict as its last stdout line and exits with the contract code.
scan() {
    _sc_self_arg=$1
    _sc_seed_arg=$2
    _sc_mint=$3
    resolve_self "$_sc_self_arg"
    _sc_self="$RESOLVED_BIN"
    resolve_seed "$_sc_seed_arg"
    _sc_seed="$RESOLVED_BIN"
    echo "self side:  $_sc_self  ->  $(real_path "$_sc_self")  (no seed banner) OK"
    echo "seed side:  $_sc_seed  ->  $(real_path "$_sc_seed")  (seed banner present) OK"
    # Unreachable while the banner checks above hold (one file cannot both
    # print and not print the banner), kept as an independent guard so a
    # future change to identity detection cannot reopen the tautology.
    if [ "$(real_path "$_sc_self")" = "$(real_path "$_sc_seed")" ]; then
        die_error "both sides resolve to the same file $(real_path "$_sc_self"); a comparison of a binary against itself cannot fail"
    fi

    _sc_work=$(mktemp -d "$TMP_ROOT/scan.XXXXXX") || die_error "mktemp failed"
    generate_side seed "$_sc_seed" "$_sc_work/seed"
    generate_side self "$_sc_self" "$_sc_work/self"

    _sc_seed_rows=$(rows_in "$_sc_work/seed")
    _sc_self_rows=$(rows_in "$_sc_work/self")
    [ "$_sc_seed_rows" -gt 0 ] || die_error "seed side emitted 0 manifest rows ('$_sc_seed run $GEN_MAIN generate' produced nothing to compare)"
    [ "$_sc_self_rows" -gt 0 ] || die_error "self side emitted 0 manifest rows ('$_sc_self run $GEN_MAIN generate' produced nothing to compare)"

    manifest_names "$_sc_work/seed" > "$_sc_work/seed.names"
    manifest_names "$_sc_work/self" > "$_sc_work/self.names"
    _sc_diff=""
    _sc_k=0
    for _n in $(sort -u "$_sc_work/seed.names" "$_sc_work/self.names"); do
        if [ ! -f "$_sc_work/seed/$_n" ]; then
            _sc_diff="$_sc_diff $_n(self-only)"; _sc_k=$((_sc_k + 1)); continue
        fi
        if [ ! -f "$_sc_work/self/$_n" ]; then
            _sc_diff="$_sc_diff $_n(seed-only)"; _sc_k=$((_sc_k + 1)); continue
        fi
        # Comment lines are stripped before comparing: they carry the
        # regenerate hint, never data. Everything else must be byte-identical.
        grep -v '^#' "$_sc_work/seed/$_n" > "$_sc_work/a.cmp"
        grep -v '^#' "$_sc_work/self/$_n" > "$_sc_work/b.cmp"
        if ! cmp -s "$_sc_work/a.cmp" "$_sc_work/b.cmp"; then
            _sc_line=$(cmp "$_sc_work/a.cmp" "$_sc_work/b.cmp" 2>/dev/null | sed 's/.*line //')
            _sc_diff="$_sc_diff $_n(first diff at line ${_sc_line:-?})"; _sc_k=$((_sc_k + 1))
            echo "diff $_n:"
            diff "$_sc_work/a.cmp" "$_sc_work/b.cmp" | head -20
        fi
    done
    [ "$_sc_seed_rows" -eq "$_sc_self_rows" ] || echo "row counts: seed=$_sc_seed_rows self=$_sc_self_rows"

    if [ "$_sc_k" -gt 0 ]; then
        _sc_verdict="FAIL — $_sc_seed_rows manifest row(s) compared, diff=$_sc_k:$_sc_diff"
        echo "$_sc_verdict"
        [ "$_sc_mint" = 1 ] && { emit_receipt "$CHECK_ID" "$_sc_verdict" "$(real_path "$_sc_self")" || true; }
        exit 1
    fi
    _sc_verdict="PASS — $_sc_seed_rows manifest row(s) compared, diff=0"
    echo "$_sc_verdict"
    [ "$_sc_mint" = 1 ] && { emit_receipt "$CHECK_ID" "$_sc_verdict" "$(real_path "$_sc_self")" || true; }
    exit 0
}

# ---------------------------------------------------------------------------
# Selftest. Fake compilers are real executables: `--version` prints either the
# seed banner or a plain version; `run <main> generate <out>` copies a fixture
# manifest dir into <out>; `run <main> coverage` prints a fixture table. Each
# fixture is driven through scan() in a subshell and judged on the LAST stdout
# line (the verdict text), not just the exit code.
# ---------------------------------------------------------------------------
make_fake() { # make_fake <path> <banner:seed|self> <manifest_src_dir> <coverage_text>
    cat > "$1" <<EOF
#!/bin/sh
if [ "\${1:-}" = "--version" ]; then
    if [ "$2" = seed ]; then echo "WARNING: this Rust-built Simple binary is a bootstrap seed only; do not use it as the normal tool." >&2; fi
    echo "Simple Language v0-fake"; exit 0
fi
if [ "\${1:-}" = run ] && [ "\${3:-}" = generate ]; then
    mkdir -p "\$4" && cp "$3"/*.sdn "\$4"/ 2>/dev/null; echo "generated fake"; exit 0
fi
if [ "\${1:-}" = run ] && [ "\${3:-}" = coverage ]; then
    printf '%s\n' "Fake coverage" "$4"; exit 0
fi
echo "fake: unsupported \$*" >&2; exit 3
EOF
    chmod +x "$1"
}

write_manifest() { # write_manifest <dir> <variant_name>
    mkdir -p "$1"
    printf '# GENERATED fixture\nowner: fx.Kind\nvariant_count: 2\n\nvariant:\n  id: spl:variant@fx.Kind.Alpha\n\nvariant:\n  id: spl:variant@fx.Kind.%s\n' "$2" > "$1/fx.Kind.sdn"
    printf '# GENERATED fixture\nenum_count: 1\n\nenum:\n  owner: fx.Kind\n' > "$1/index.sdn"
}

selftest() {
    _st=$(mktemp -d "$TMP_ROOT/selftest.XXXXXX") || die_error "mktemp failed"
    FAILURES=""
    RECEIPTS=0
    write_manifest "$_st/m_ok" Beta
    write_manifest "$_st/m_diff" Gamma
    mkdir -p "$_st/m_empty"
    make_fake "$_st/seed_ok"   seed "$_st/m_ok"    "  fx.Kind  2/2"
    make_fake "$_st/self_ok"   self "$_st/m_ok"    "  fx.Kind  2/2"
    make_fake "$_st/self_diff" self "$_st/m_diff"  "  fx.Kind  2/2"
    make_fake "$_st/self_seed" seed "$_st/m_ok"    "  fx.Kind  2/2"
    make_fake "$_st/seed_noban" self "$_st/m_ok"   "  fx.Kind  2/2"
    make_fake "$_st/seed_empty" seed "$_st/m_empty" ""
    make_fake "$_st/self_empty" self "$_st/m_empty" ""

    # 1. must-PASS: distinct fakes, correct identities, identical manifests.
    _v=$( scan "$_st/self_ok" "$_st/seed_ok" 0 2>/dev/null | tail -1 ); _rc=$?
    case "$_v" in "PASS — 4 manifest row(s) compared, diff=0") : ;; *) FAILURES="$FAILURES identical-manifests-not-PASS($_v)" ;; esac
    # 2. must-FAIL: one variant row differs; the manifest name must be in the verdict.
    _v=$( scan "$_st/self_diff" "$_st/seed_ok" 0 2>/dev/null | tail -1 )
    case "$_v" in "FAIL — 4 manifest row(s) compared, diff=1:"*"registry/fx.Kind.sdn"*) : ;; *) FAILURES="$FAILURES one-row-diff-not-FAIL($_v)" ;; esac
    # 3. must-ERROR: both sides emit 0 rows — never a PASS.
    _v=$( scan "$_st/self_empty" "$_st/seed_empty" 0 2>/dev/null | tail -1 )
    case "$_v" in "ERROR — nothing was checked (seed side emitted 0 manifest rows"*) : ;; *) FAILURES="$FAILURES zero-rows-not-ERROR($_v)" ;; esac
    # 4. must-ERROR: the self-hosted binary is missing.
    _v=$( scan "$_st/does_not_exist" "$_st/seed_ok" 0 2>/dev/null | tail -1 )
    case "$_v" in "ERROR — nothing was checked (self-hosted binary '"*"' is not an executable file"*) : ;; *) FAILURES="$FAILURES missing-self-not-ERROR($_v)" ;; esac
    # 5. must-ERROR: the "self-hosted" binary prints the seed banner (seed vs seed).
    _v=$( scan "$_st/self_seed" "$_st/seed_ok" 0 2>/dev/null | tail -1 )
    case "$_v" in "ERROR — nothing was checked (self-hosted binary is the Rust seed:"*) : ;; *) FAILURES="$FAILURES seed-as-self-not-ERROR($_v)" ;; esac
    # 6. must-ERROR: the seed oracle prints no banner (not an independent seed).
    _v=$( scan "$_st/self_ok" "$_st/seed_noban" 0 2>/dev/null | tail -1 )
    case "$_v" in "ERROR — nothing was checked (seed binary is not the Rust seed:"*) : ;; *) FAILURES="$FAILURES seed-without-banner-not-ERROR($_v)" ;; esac

    RECEIPTS=1
    if [ -n "$FAILURES" ]; then
        die_error "selftest failed:$FAILURES"
    fi
}

selftest
if [ "$MODE" = "selftest" ]; then
    echo "PASS — 6 selftest fixture(s) checked, scanner detects identical/diverged/empty manifests and rejects missing, seed-as-self and bannerless-seed binaries"
    exit 0
fi

scan "$SELF_ARG" "$SEED_ARG" 1
