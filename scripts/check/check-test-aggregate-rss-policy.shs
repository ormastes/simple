#!/bin/sh
# Policy admission and real enforcement for the parallel-test RSS allocation.
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
guard=$root/scripts/resource/process-tree-rss-watchdog.pl
tmp=$(mktemp -d "${TMPDIR:-/tmp}/simple-aggregate-rss.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
fail() { echo "FAIL: $*" >&2; exit 1; }
reject() {
    status=0
    perl "$guard" "$@" -- /bin/sh -c 'touch "$1"' sh "$tmp/started" >"$tmp/reject.log" 2>&1 || status=$?
    [ "$status" -ne 0 ] && [ ! -e "$tmp/started" ] || fail "invalid admission: $*"
}
reject --max-rss-kib=6835938
reject --aggregate-workers=20
reject --budget-scope=unknown
reject --budget-scope=aggregate-tests --aggregate-workers=20
reject --budget-scope=aggregate-tests --max-rss-kib=26367177
reject --budget-scope=aggregate-tests --aggregate-workers=0 --max-rss-kib=1
reject --budget-scope=aggregate-tests --aggregate-workers=129 --max-rss-kib=1
reject --budget-scope=aggregate-tests --aggregate-workers=abc --max-rss-kib=1
reject --budget-scope=aggregate-tests --aggregate-workers=20 --max-rss-kib=26367178
reject --budget-scope=aggregate-tests --aggregate-workers=20 --max-rss-kib=0
reject --budget-scope=aggregate-tests --aggregate-workers=20 --max-rss-kib=26367177 --rss-cap-mode=monitor
reject --budget-scope=aggregate-tests --budget-scope=compiler --aggregate-workers=20 --max-rss-kib=1
reject --budget-scope=aggregate-tests --aggregate-workers=20 --aggregate-workers=1 --max-rss-kib=1
reject --budget-scope=aggregate-tests --aggregate-workers=1 --max-rss-kib=7812500
# Environment cannot turn the explicit aggregate admission into monitoring.
(export SIMPLE_BOOTSTRAP_RSS_CAP_MODE=monitor; reject --budget-scope=aggregate-tests --aggregate-workers=20 --max-rss-kib=26367177)
# The maximal allowed allocation can supervise a tiny command without reserving
# its entire allowance. Nested guards retain the default compiler policy.
perl "$guard" --budget-scope=aggregate-tests --aggregate-workers=20 --max-rss-kib=26367177 \
    --rss-cap-mode=enforce --receipt="$tmp/aggregate.env" -- \
    perl "$guard" --session-mode=inherit --receipt="$tmp/compiler.env" -- /bin/sleep .25
for row in status=complete exit_status=0 quiescent=1 rss_cap_enforced=1 budget_scope=aggregate-tests aggregate_workers=20 budget_ceiling_kib=26367177; do
    grep -Fxq "$row" "$tmp/aggregate.env" || fail "aggregate receipt $row"
done
for row in budget_scope=compiler max_rss_kib=5859375 budget_ceiling_kib=6835937 aggregate_workers=0; do
    grep -Fxq "$row" "$tmp/compiler.env" || fail "nested compiler receipt $row"
done
# A deliberately small aggregate cap must still terminate a real allocation.
status=0
perl "$guard" --budget-scope=aggregate-tests --aggregate-workers=20 --max-rss-kib=16384 \
    --rss-cap-mode=enforce --receipt="$tmp/over.env" -- \
    perl -e 'my $resident="x" x (32*1024*1024); sleep 10; print length($resident)' >"$tmp/over.log" 2>&1 || status=$?
[ "$status" -eq 88 ] || { cat "$tmp/over.log"; fail "aggregate enforcement returned $status"; }
for row in status=rss-cap-exceeded quiescent=1 rss_cap_enforced=1; do
    grep -Fxq "$row" "$tmp/over.env" || fail "enforcement receipt $row"
done
echo 'PASS: aggregate RSS admission, bounded worker policy, nested compiler default and enforced cleanup'
