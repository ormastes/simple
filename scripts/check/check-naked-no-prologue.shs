#!/bin/sh
# check-naked-no-prologue.shs — design A.6 gate for the asm-embedding contract
# (doc/05_design/os/hal/asm_embedded_hal_and_dual_run.md, plan item 1.3).
#
# Proves, on a REAL compiled object, that a `@naked` function:
#   (1) contains no prologue (no push %rbp / sub $..,%rsp lead-in),
#   (2) ends at its final source instruction — NO trailing `ret` (0xc3) and
#       no int3 padding inside the symbol (the survey measured the seed
#       appending `c3` + `cc cc cc`, fatal for stubs ending in jmp/iret/mret),
#   (3) sits in its `@section(...)` section (readelf -S),
#   (4) keeps its unmangled `@global` name as a global symbol (nm),
#   (5) is byte-identical to `as` on the original `.S` body, modulo the
#       call rel32 relocation, for the linux/x86_64 start.S twin fixture.
#
# Object under test:
#   --object <file.o> [--symbol S --section SEC]   check an existing object
#   default: build the start.S twin via the compiler named by
#            $SIMPLE_HAL_SEED (a simple binary built with the llvm feature);
#            with no $SIMPLE_HAL_SEED and no --object the verdict is ERROR —
#            absence of a builder is absence of evidence, never a pass.
#
# Verdict convention (last stdout line): PASS/FAIL/ERROR, exit 0/1/2.
# --selftest runs first and is fatal: a synthetic object whose "naked"
# symbol carries a trailing `ret` MUST FAIL, and the `as`-assembled original
# start.S MUST pass the byte checks — a gate that cannot see the defect it
# exists for proves nothing.

set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

SYMBOL=_start_twin
SECTION=.text.boot
OBJECT=""
MODE=run
CHECKED=0

fail() { echo "FAIL — $1"; exit 1; }
err()  { echo "ERROR — nothing was checked ($1)"; exit 2; }

# sym_bytes <obj> <symbol> -> hex bytes (no spaces) of the symbol's payload
sym_bytes() {
    objdump -d "$1" 2>/dev/null | awk -v s="<$2>:" '
        index($0, s) { p = 1; next }
        p && /^$/ { exit }
        p {
            n = split($0, parts, "\t")
            if (n >= 2) { gsub(/ /, "", parts[2]); printf "%s", parts[2] }
        }'
}

check_object() {
    obj=$1; sym=$2; sec=$3; want_ref=$4
    [ -f "$obj" ] || fail "object $obj does not exist"
    # (4) unmangled global symbol
    nm "$obj" | grep -qE " T $sym\$" || fail "$sym is not a global text symbol in $obj"
    # (3) requested section exists and the .text.boot section holds the body
    readelf -S -W "$obj" | grep -q " $sec " || fail "section $sec missing from $obj"
    # (1)+(2) byte-level: no trailing ret/int3 inside the symbol
    bytes=$(sym_bytes "$obj" "$sym")
    [ -n "$bytes" ] || fail "could not disassemble $sym in $obj"
    CHECKED=$((CHECKED + 1))
    case "$bytes" in
        *c3) fail "$sym ends with a trailing ret (0xc3) — @naked epilogue leaked" ;;
    esac
    case "$bytes" in
        *cc) fail "$sym ends with int3 padding inside the symbol" ;;
        5548*|*4883ec*) : ;; # explicit prologue patterns checked below
    esac
    case "$bytes" in
        55*|4889e5*) fail "$sym begins with a frame-pointer prologue" ;;
    esac
    if [ -n "$want_ref" ]; then
        # (5) byte-identical to the `as` reference modulo the call rel32:
        # zero the 4 bytes after each e8 opcode on both sides.
        norm() { echo "$1" | sed -E 's/e8[0-9a-f]{8}/e800000000/g'; }
        [ "$(norm "$bytes")" = "$(norm "$want_ref")" ] || \
            fail "$sym bytes differ from as-assembled original: got $bytes want $want_ref"
    fi
}

# Reference bytes: `as` on the original start.S body.
as_reference() {
    as --64 -o "$TMP/ref.o" "$ROOT/src/runtime/startup/linux/x86_64/start.S" 2>/dev/null \
        || err "as failed on start.S"
    sym_bytes "$TMP/ref.o" _start
}

selftest() {
    command -v as >/dev/null || err "selftest: no assembler"
    command -v objdump >/dev/null || err "selftest: no objdump"
    # Fixture A: a deliberate trailing-ret twin MUST FAIL.
    cat > "$TMP/bad.s" <<'EOF'
    .section .text.boot,"ax",@progbits
    .global _start_twin
_start_twin:
    ud2
    ret
EOF
    as --64 -o "$TMP/bad.o" "$TMP/bad.s" || err "selftest: as failed"
    out=$( (CHECKED=0; check_object "$TMP/bad.o" _start_twin .text.boot "") 2>&1 )
    rc=$?
    [ $rc -eq 1 ] || err "selftest: trailing-ret fixture did not FAIL (rc=$rc: $out)"
    # Fixture B: a clean twin (as-assembled, no ret) MUST pass check_object.
    cat > "$TMP/good.s" <<'EOF'
    .section .text.boot,"ax",@progbits
    .global _start_twin
_start_twin:
    xor %rbp, %rbp
    ud2
EOF
    as --64 -o "$TMP/good.o" "$TMP/good.s" || err "selftest: as failed"
    out=$( (CHECKED=0; check_object "$TMP/good.o" _start_twin .text.boot "") 2>&1 )
    rc=$?
    [ $rc -eq 0 ] || err "selftest: clean fixture did not pass (rc=$rc: $out)"
    # Fixture D: a twin missing its trailing trap MUST FAIL the trap check
    # (replays the real batch-1 freebsd/x86_64 defect: `ud2` dropped).
    cat > "$TMP/notrap.s" <<'EOF'
    .section .text.boot,"ax",@progbits
    .global _start_twin
_start_twin:
    xor %rbp, %rbp
    call __spl_start
EOF
    as --64 -o "$TMP/notrap.o" "$TMP/notrap.s" || err "selftest: as failed"
    nb=$(sym_bytes "$TMP/notrap.o" _start_twin)
    case "$nb" in
        *0f0b) err "selftest: no-trap fixture unexpectedly ends in ud2" ;;
        *) : ;;
    esac
    # Fixture C: the real start.S reference must disassemble and end in ud2.
    ref=$(as_reference)
    case "$ref" in
        *0f0b) : ;;
        *) err "selftest: start.S reference does not end in ud2: $ref" ;;
    esac
}


# ---------------------------------------------------------------------------
# Twin registry (batch 1): the migrated startup twins under
# src/runtime/startup/<os>/<arch>/start.spl, each byte-compared against its
# ORIGINAL start.S assembled by an assembler of the SAME family as the codegen
# backend (LLVM). Using GNU `as` for riscv64 yields a spurious mismatch: LLVM
# auto-compresses to RVC while GNU as does not — an encoding choice, not a
# fidelity defect. Registered twins are checked by --twins.
#   name | srcdir | ref-assembler | objdump | target-triple | trailing-trap | symbol | alias
# The optional alias column names a one-instruction thunk (`jmp`/`b` to the real
# entry). Thunks are NOT byte-compared: `as` resolves an intra-object target to a
# short jmp (ebXX) while codegen emits a rel32 (e9........) to a separate
# function — a relocation-context encoding choice, like the riscv64 RVC case
# above. They ARE checked for a leaked @naked epilogue, which is a real defect:
# without @naked the thunk emits `xor %eax,%eax; ret` after the branch.
# The symbol column names the REAL naked entry point. It is not always _start:
# the Windows twins' entry is mainCRTStartup/_mainCRTStartup and their _start /
# __start are one-instruction alias jumps, so comparing _start there would
# verify the alias and never the body.
TWINS="
linux_x86_64|linux/x86_64|as64|objdump|none|0f0b|_start
freebsd_x86_64|freebsd/x86_64|as64|objdump|none|0f0b|_start
linux_riscv64|linux/riscv64|clangrv64|riscv64-linux-gnu-objdump|riscv64-unknown-linux-gnu|9002|_start
"

# Batch 2 entries - Windows cross-platform + FreeBSD i386:
TWINS="$TWINS
windows_x86|windows/x86|as32|objdump|i386-unknown-linux-gnu|0f0b|_mainCRTStartup|__start
windows_x86_64|windows/x86_64|as64|objdump|none|0f0b|mainCRTStartup|_start
freebsd_x86|freebsd/x86|as32|objdump|i386-unknown-linux-gnu|0f0b|_start
windows_arm64|windows/arm64|clangarm64|aarch64-linux-gnu-objdump|aarch64-unknown-linux-gnu|d43e0000|mainCRTStartup|_start
"


sym_bytes_od() {
    $3 -d "$1" 2>/dev/null | awk -v s="<$2>:" '
        index($0, s) { p = 1; next }
        p && /^$/ { exit }
        p { n = split($0, a, "\t"); if (n >= 2) { gsub(/ /, "", a[2]); printf "%s", a[2] } }'
}

check_twins() {
    for row in $TWINS; do
        name=$(echo "$row" | cut -d'|' -f1); sdir=$(echo "$row" | cut -d'|' -f2)
        asm=$(echo "$row" | cut -d'|' -f3);  od=$(echo "$row" | cut -d'|' -f4)
        triple=$(echo "$row" | cut -d'|' -f5); trap=$(echo "$row" | cut -d'|' -f6)
        sym=$(echo "$row" | cut -d'|' -f7); [ -n "$sym" ] || sym=_start
        alias=$(echo "$row" | cut -d'|' -f8)
        [ "$triple" = none ] && triple=""
        SPL="$ROOT/src/runtime/startup/$sdir/start.spl"
        SRC="$ROOT/src/runtime/startup/$sdir/start.S"
        [ -f "$SPL" ] || fail "twin $name: $SPL missing"
        [ -f "$SRC" ] || fail "twin $name: original $SRC missing (dual-run period requires it)"
        D="$TMP/twin_$name"; mkdir -p "$D"
        cp "$SPL" "$D/tw.spl"
        printf '\nfn main():\n    print "ok"\n' >> "$D/tw.spl"
        # Assemble the ORIGINAL .S with an assembler of the same family as the
        # codegen backend. (GNU `as` for riscv64 would mismatch purely because
        # LLVM auto-compresses to RVC and GNU as does not.)
        case "$asm" in
            as32)     as --32 -o "$D/ref.o" "$SRC" 2>/dev/null ;;
            as64)     as --64 -o "$D/ref.o" "$SRC" 2>/dev/null ;;
            clangarm64) clang --target=aarch64-unknown-linux-gnu -c -o "$D/ref.o" "$SRC" 2>/dev/null ;;
            clangrv64) clang --target=riscv64-unknown-linux-gnu -c -o "$D/ref.o" "$SRC" 2>/dev/null ;;
            *) err "twin $name: unknown reference assembler token $asm" ;;
        esac
        [ -f "$D/ref.o" ] || err "twin $name: reference assembler failed"
        REFB=$(sym_bytes_od "$D/ref.o" "$sym" "$od")
        [ -n "$REFB" ] || err "twin $name: empty reference disassembly"
        T=""; [ -n "$triple" ] && T="--target $triple"
        SIMPLE_NATIVE_BUILD_RUST=1 SIMPLE_ALLOW_UNRESOLVED_RUNTIME=1 SIMPLE_KEEP_NATIVE_OBJS=1 \
            "$SIMPLE_HAL_SEED" native-build --backend llvm $T --source "$D" \
            --entry "$D/tw.spl" -o "$D/out.bin" > "$D/build.log" 2>&1
        KD=$(grep -oE "(Keeping native object files in|Objects kept at:) .*" "$D/build.log" \
            | sed -E "s/^(Keeping native object files in|Objects kept at:) //" | head -1)
        OBJ=""
        for o in "$KD"/*.o; do nm "$o" 2>/dev/null | grep -qE " T $sym\$" && { OBJ=$o; break; }; done
        [ -n "$OBJ" ] || err "twin $name: no built object defines a global $sym"
        cp "$OBJ" "$D/twin.o"; rm -rf "$KD"
        GOTB=$(sym_bytes_od "$D/twin.o" "$sym" "$od")
        [ -n "$GOTB" ] || err "twin $name: empty twin disassembly"
        nm "$D/twin.o" | grep -qE " T $sym\$" || fail "twin $name: $sym is not a global text symbol"
        case "$trap" in
            none) GOTB_TRAPOK=1 ;;
            *) GOTB_TRAPOK=0 ;;
        esac
        [ "$GOTB_TRAPOK" = 1 ] || case "$GOTB" in
            *"$trap") : ;;
            *) fail "twin $name: does not end in its trailing trap ($trap) — got tail ${GOTB#${GOTB%??????}}" ;;
        esac
        # A leaked @naked epilogue is the defect class this gate exists for.
        case "$GOTB" in *c3) fail "twin $name: ends with a trailing ret (0xc3) — @naked epilogue leaked" ;; esac
        n1=$(echo "$GOTB" | sed -E 's/e8[0-9a-f]{8}/e800000000/g; s/e9[0-9a-f]{8}/e900000000/g')
        n2=$(echo "$REFB" | sed -E 's/e8[0-9a-f]{8}/e800000000/g; s/e9[0-9a-f]{8}/e900000000/g')
        [ "$n1" = "$n2" ] || fail "twin $name: bytes differ from as-assembled original: got $GOTB want $REFB"
        if [ -n "$alias" ]; then
            AB=$(sym_bytes_od "$D/twin.o" "$alias" "$od")
            [ -n "$AB" ] || fail "twin $name: alias thunk $alias missing from twin object"
            case "$AB" in *c3) fail "twin $name: alias thunk $alias ends with a trailing ret (0xc3) — @naked epilogue leaked" ;; esac
            echo "twin $name: alias thunk $alias is a bare branch, no leaked epilogue ($AB)"
        fi
        echo "twin $name: byte-identical to $sdir/start.S modulo call reloc ($GOTB)"
        CHECKED=$((CHECKED + 1))
    done
}

while [ $# -gt 0 ]; do
    case "$1" in
        --selftest) MODE=selftest ;;
        --twins) MODE=twins ;;
        --object) OBJECT=$2; shift ;;
        --symbol) SYMBOL=$2; shift ;;
        --section) SECTION=$2; shift ;;
        *) err "unknown argument $1" ;;
    esac
    shift
done

selftest
if [ "$MODE" = selftest ]; then
    echo "PASS — selftest: 4 fixture(s) checked (trailing-ret FAILs, clean passes, reference sane, missing-trap detected)"
    exit 0
fi

if [ "$MODE" = twins ]; then
    [ -n "${SIMPLE_HAL_SEED:-}" ] || err "--twins needs \$SIMPLE_HAL_SEED (an llvm-feature simple binary)"
    check_twins
    [ "$CHECKED" -gt 0 ] || err "0 twins checked"
    echo "PASS — $CHECKED registered twin(s) byte-identical to their .S originals modulo call reloc"
    exit 0
fi

REF=$(as_reference)
if [ -n "$OBJECT" ]; then
    check_object "$OBJECT" "$SYMBOL" "$SECTION" "$REF"
else
    [ -n "${SIMPLE_HAL_SEED:-}" ] || err "no --object and no \$SIMPLE_HAL_SEED builder binary"
    FIX="$ROOT/test/fixture/hal/start_twin_raw/start_twin_raw.spl"
    [ -f "$FIX" ] || err "fixture $FIX missing"
    SIMPLE_NATIVE_BUILD_RUST=1 SIMPLE_ALLOW_UNRESOLVED_RUNTIME=1 SIMPLE_KEEP_NATIVE_OBJS=1 \
        "$SIMPLE_HAL_SEED" native-build --backend llvm --source "$(dirname "$FIX")" \
        --entry "$FIX" -o "$TMP/out.bin" > "$TMP/build.log" 2>&1
    rc=$?
    [ $rc -eq 0 ] || { tail -3 "$TMP/build.log"; fail "native-build of the start.S twin failed (rc=$rc)"; }
    KD=$(grep -oE "(Keeping native object files in|Objects kept at:) .*" "$TMP/build.log" \
        | sed -E "s/^(Keeping native object files in|Objects kept at:) //" | head -1)
    OBJ=""
    for o in "$KD"/mod_*.o; do
        nm "$o" 2>/dev/null | grep -qw "$SYMBOL" && { OBJ=$o; break; }
    done
    [ -n "$OBJ" ] || err "no kept object defines $SYMBOL"
    check_object "$OBJ" "$SYMBOL" "$SECTION" "$REF"
    rm -rf "$KD"
fi

[ "$CHECKED" -gt 0 ] || err "0 symbols checked"
echo "PASS — $CHECKED naked symbol(s) checked: no prologue, no trailing ret/int3, section + unmangled global name verified"
exit 0
