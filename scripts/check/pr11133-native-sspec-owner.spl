# Calls the existing native SSpec execution owner on the unchanged tracked spec.
use std.test_runner.test_runner_args.{parse_test_args}
use std.test_runner.test_runner_execute.{run_test_file_native}
use std.test_runner.test_runner_types.{test_file_result_outcome_class}

fn main() -> i64:
    val path = "test/01_unit/compiler/hir/generic_method_semantic_return_spec.spl"
    val options = parse_test_args([path, "--mode=native", "--native-backend=llvm", "--native-source=src", "--timeout=900", "--max-mem=2", "--max-procs=8", "--keep-artifacts", "--no-cache", "--verbose"])
    val result = run_test_file_native(path, options)
    val outcome = test_file_result_outcome_class(result)
    print "SSPEC_OWNER path={result.path} passed={result.passed} failed={result.failed} skipped={result.skipped} pending={result.pending} blocked={result.blocked} unsupported={result.unsupported} outcome={outcome}"
    print "SSPEC_OWNER error={result.error}"
    print "SSPEC_OWNER trace-begin"
    print result.trace_case_events_sdn
    print "SSPEC_OWNER trace-end"
    var completed = false
    match result.process_completion:
        case Some(completion):
            print "SSPEC_OWNER completion pid={completion.pid} exit={completion.exit_code} tree_reaped={completion.tree_reaped} timed_out={completion.timed_out} cancelled={completion.cancelled}"
            completed = completion.exit_code == 0 and completion.tree_reaped and not completion.timed_out and not completion.cancelled
        case None:
            print "SSPEC_OWNER completion unavailable"
    if outcome != "OK" or not completed:
        return 1
    if result.passed != 1 or result.failed != 0 or result.skipped != 0 or result.pending != 0:
        return 1
    if result.blocked != 0 or result.unsupported != 0 or result.cached or result.timed_out:
        return 1
    if result.degraded_reason != "" or result.feature_gated != "" or result.in_development != 0:
        return 1
    return 0
