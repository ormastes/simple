#!/bin/sh
# Fail when a production or focused Cosmos link includes cosmos_nfc.c without
# the pure-Simple ECC object and its volatile acquisition bridge.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

check_link() {
    path=$1
    grep -Fq 'cosmos_nfc_ecc_bridge' "$ROOT/$path" || {
        echo "FAIL ECC wiring guard: missing acquisition bridge in $path" >&2
        exit 1
    }
    grep -Fq 'cosmos_nfc_ecc_simple.o' "$ROOT/$path" || {
        echo "FAIL ECC wiring guard: missing pure-Simple object in $path" >&2
        exit 1
    }
}

check_link src/os/kernel/arch/arm32/cosmos/build.shs
runner_list=$(cd "$ROOT" && rg -l '"\$source_dir/cosmos_nfc[.]c"' \
    test/02_integration/os/cosmos -g 'run_*.shs' | LC_ALL=C sort)
[ -n "$runner_list" ] || {
    echo "FAIL ECC wiring guard: no focused NFC links found" >&2
    exit 1
}
for runner in $runner_list
do
    check_link "$runner"
done

echo "STATUS: PASS Cosmos NFC links include pure-Simple ECC policy"
