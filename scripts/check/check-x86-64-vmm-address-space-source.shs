#!/bin/sh
set -eu
vmm=src/os/kernel/memory/vmm_address_space.spl
user=src/os/kernel/memory/user_address_space.spl
for symbol in create_user_address_space destroy_user_address_space vmm_map_page_in; do
    grep -Eq "^pub fn ${symbol}\\(" "$vmm"
done
grep -Fq 'use os.kernel.memory.vmm_address_space.{' "$user"
! grep -Fq 'use os.kernel.memory.vmm.{' "$user"
grep -Fq '@export("rt_arm64_user_as_create_host_stub")' "$user"
grep -Fq '@export("rt_arm64_user_as_map_page_host_stub")' "$user"
! grep -Fq '@export("C")' "$user"
echo 'PASS x86_64 VMM direct source ownership'
