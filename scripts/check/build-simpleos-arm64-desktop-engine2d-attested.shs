#!/bin/sh
set -eu

# Canonical producer for the artifacts consumed by the live ARM64 QMP input
# gate. It builds once through the documented scenario and publishes a manifest
# only when source, HEAD, compiler frontend, and output identities are stable.

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

. scripts/check/lib/simpleos-arm64-guest-source-fingerprint.shs
. scripts/check/lib/qemu-frozen-source-admission.shs

COMPILER=""
COMPILER_REJECTION_REASON=""
KERNEL="build/os/simpleos_arm64_desktop_engine2d.elf"
DISK="build/os/fat32-arm64-desktop.img"
DISK_PRODUCER="build/os/make_os_disk"
BUILD_MANIFEST="build/os/simpleos_arm64_desktop_engine2d.build-manifest.env"
FROZEN_BUILD_MANIFEST="${BUILD_MANIFEST}.frozen-source-admission.env"
BUILD_STAMP="${KERNEL}.build_stamp"
BUILD_LOG="build/os/simpleos_arm64_desktop_engine2d.build.log"
NATIVE_CACHE="build/native_cache"
NATIVE_THREADS="8"
NATIVE_BACKEND="${SIMPLEOS_ATTESTED_NATIVE_BACKEND:-llvm}"
BUILD_TIMEOUT_SECONDS="900"
TIMEOUT_BIN=""
GENERATED_LOG_CONFIG="build/os/generated/generated/simpleos_log_config.spl"
BUILD_COMMAND=""
BUILD_ENVIRONMENT="-u SIMPLE_BINARY -u SIMPLE_BIN -u SIMPLE_FRONTEND_DELEGATE -u SIMPLE_BOOTSTRAP_DRIVER SIMPLE_BOOTSTRAP=1 SIMPLE_LIB=$ROOT_DIR/src SIMPLE_ALLOW_FREESTANDING_STUBS=1 SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_STRICT_FABRICATED_STUB_RATCHET=1 SIMPLE_OS_LOG_MODE=off"
ENTRY="examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl"
MANIFEST_TMP="${BUILD_MANIFEST}.tmp.$$"
SELF_TEST_DIR=""

cleanup() {
    rm -f "$MANIFEST_TMP" "$GENERATED_LOG_CONFIG"
    if [ -n "$SELF_TEST_DIR" ]; then
        rm -f "$SELF_TEST_DIR/clean-simple" \
            "$SELF_TEST_DIR/seed-simple" \
            "$SELF_TEST_DIR/debug-simple" \
            "$SELF_TEST_DIR/fabrication-receipt.log"
        rmdir "$SELF_TEST_DIR" >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT INT TERM

fail_build() {
    echo "arm64_desktop_engine2d_attested_build_status=fail"
    echo "arm64_desktop_engine2d_attested_build_reason=$1"
    exit 1
}

sha256_file() {
    sha256_line="$(qemu_admission_sha256 "$1")" || return 1
    sha256_value="${sha256_line%% *}"
    case "$sha256_value" in
        *[!0-9a-f]*|"") return 1 ;;
    esac
    [ "${#sha256_value}" -eq 64 ] || return 1
    printf '%s\n' "$sha256_value"
}

arm64_fabrication_receipt_clean() {
    ! grep -Eq 'FABRICATED-NEW|fabricated unmeasured|baseline has NO rows' "$1"
}

write_self_test_native_header() {
    case "$(uname -s):$(uname -m)" in
        Darwin:arm64)
            printf '\317\372\355\376\014\000\000\001' >"$1"
            ;;
        Darwin:x86_64)
            printf '\317\372\355\376\007\000\000\001' >"$1"
            ;;
        Linux:aarch64|Linux:arm64)
            printf '\177ELF\002\001\000\000\000\000\000\000\000\000\000\000\000\000\267\000' >"$1"
            ;;
        Linux:x86_64)
            printf '\177ELF\002\001\000\000\000\000\000\000\000\000\000\000\000\000\076\000' >"$1"
            ;;
        *)
            return 1
            ;;
    esac
    chmod +x "$1"
}

run_compiler_admission_self_test() {
    SELF_TEST_DIR="$(mktemp -d "${TMPDIR:-/tmp}/simple-arm64-compiler-admission.XXXXXX")" ||
        fail_build "compiler-admission-self-test-tempdir-failed"
    clean_fixture="$SELF_TEST_DIR/clean-simple"
    seed_fixture="$SELF_TEST_DIR/seed-simple"
    debug_fixture="$SELF_TEST_DIR/debug-simple"
    write_self_test_native_header "$clean_fixture" ||
        fail_build "compiler-admission-self-test-host-unsupported"
    cp "$clean_fixture" "$seed_fixture"
    cp "$clean_fixture" "$debug_fixture"
    printf '%s\n' \
        'WARNING: this Rust-built Simple binary is a bootstrap seed only' \
        >>"$seed_fixture"
    printf '%s\n' 'debug build' >>"$debug_fixture"

    arm64_guest_validate_native_compiler "$clean_fixture" fixture ||
        fail_build "compiler-admission-self-test-clean-rejected"
    [ "$ARM64_GUEST_COMPILER_ADMISSION_REASON" = pass ] ||
        fail_build "compiler-admission-self-test-clean-reason-invalid"
    if arm64_guest_validate_native_compiler "$seed_fixture" fixture; then
        fail_build "compiler-admission-self-test-seed-accepted"
    fi
    [ "$ARM64_GUEST_COMPILER_ADMISSION_REASON" = \
        rust-seed-or-debug-forbidden ] ||
        fail_build "compiler-admission-self-test-seed-reason-invalid"
    if arm64_guest_validate_native_compiler "$debug_fixture" fixture; then
        fail_build "compiler-admission-self-test-debug-accepted"
    fi
    [ "$ARM64_GUEST_COMPILER_ADMISSION_REASON" = \
        rust-seed-or-debug-forbidden ] ||
        fail_build "compiler-admission-self-test-debug-reason-invalid"

    echo "arm64_compiler_admission_clean_status=pass"
    echo "arm64_compiler_admission_seed_rejection_status=pass"
    echo "arm64_compiler_admission_debug_rejection_status=pass"
    echo "arm64_compiler_admission_self_test_status=pass"

    receipt_fixture="$SELF_TEST_DIR/fabrication-receipt.log"
    printf '%s\n' 'Fabricated freestanding stubs: 0 symbol(s)' >"$receipt_fixture"
    arm64_fabrication_receipt_clean "$receipt_fixture" ||
        fail_build "fabrication-receipt-self-test-clean-rejected"
    printf '%s\n' '  FABRICATED-NEW arm64.elf missing_body' >"$receipt_fixture"
    if arm64_fabrication_receipt_clean "$receipt_fixture"; then
        fail_build "fabrication-receipt-self-test-new-accepted"
    fi
    printf '%s\n' "fabricated-stub baseline has NO rows for entry 'arm64.elf'; 2 symbol(s) fabricated unmeasured." >"$receipt_fixture"
    if arm64_fabrication_receipt_clean "$receipt_fixture"; then
        fail_build "fabrication-receipt-self-test-unmeasured-accepted"
    fi
    echo "arm64_fabrication_receipt_self_test_status=pass"
}

if [ "${1:-}" = "--self-test" ]; then
    run_compiler_admission_self_test
    exit 0
fi

resolve_compiler() {
    compiler_os="$(uname -s)" || return 1
    compiler_arch="$(uname -m)" || return 1
    case "$compiler_os:$compiler_arch" in
        Darwin:arm64)
            compiler_candidate="bin/release/aarch64-apple-darwin-macho/simple"
            ;;
        Darwin:x86_64)
            compiler_candidate="bin/release/x86_64-apple-darwin-macho/simple"
            ;;
        Linux:x86_64)
            compiler_candidate="bin/release/x86_64-unknown-linux-gnu/simple"
            ;;
        Linux:aarch64|Linux:arm64)
            compiler_candidate="bin/release/aarch64-unknown-linux-gnu/simple"
            ;;
        *)
            return 1
            ;;
    esac
    [ -x "$compiler_candidate" ] && [ -f "$compiler_candidate" ] ||
        return 1
    [ ! -L "$compiler_candidate" ] || return 1
    if ! arm64_guest_validate_native_compiler "$compiler_candidate"; then
        COMPILER_REJECTION_REASON="$ARM64_GUEST_COMPILER_ADMISSION_REASON"
        return 1
    fi
    COMPILER="$compiler_candidate"
    COMPILER_FORMAT="$ARM64_GUEST_COMPILER_FORMAT"
    COMPILER_ARCH="$ARM64_GUEST_COMPILER_ARCH"
    BUILD_COMMAND="sh scripts/os/make_os_disk.shs 128 $DISK '' arm64 desktop-fonts && $TIMEOUT_BIN -k 5 $BUILD_TIMEOUT_SECONDS env $BUILD_ENVIRONMENT $COMPILER native-build --verbose --source build/os/generated --source src/os --source src/lib --source examples/09_embedded/simple_os --backend $NATIVE_BACKEND --opt-level=aggressive --log off --timeout 870 --threads $NATIVE_THREADS --cache-dir $NATIVE_CACHE --entry-closure --entry $ENTRY --target aarch64-unknown-none -o $KERNEL --linker-script examples/09_embedded/simple_os/arch/arm64/linker.ld"
}

resolve_timeout() {
    if command -v timeout >/dev/null 2>&1; then
        TIMEOUT_BIN="$(command -v timeout)"
    elif command -v gtimeout >/dev/null 2>&1; then
        TIMEOUT_BIN="$(command -v gtimeout)"
    else
        fail_build "timeout-tool-unavailable"
    fi
}

resolve_timeout
case "$NATIVE_BACKEND" in
    llvm|cranelift) ;;
    *) fail_build "native-backend-invalid" ;;
esac
resolve_compiler ||
    fail_build "${COMPILER_REJECTION_REASON:-canonical-pure-simple-compiler-unavailable}"
[ -x "$COMPILER" ] || fail_build "canonical-compiler-missing"
[ ! -L "$COMPILER" ] || fail_build "canonical-compiler-symlink-rejected"
# The runner owns this transient source and recreates/removes it around every
# build. Normalize stale crash residue before taking the pre-build snapshot.
mkdir -p build/os/generated/generated
rm -f "$GENERATED_LOG_CONFIG" ||
    fail_build "stale-generated-log-config-remove-failed"
if arm64_guest_source_dirty; then
    fail_build "guest-source-worktree-dirty"
else
    SOURCE_DIRTY_CODE=$?
    [ "$SOURCE_DIRTY_CODE" -eq 1 ] ||
        fail_build "guest-source-git-status-failed"
fi

PRE_HEAD="$(git rev-parse --verify HEAD 2>/dev/null)" ||
    fail_build "source-revision-unavailable"
arm64_guest_source_snapshot ||
    fail_build "pre-build-source-fingerprint-failed"
PRE_SOURCE_FINGERPRINT="$ARM64_GUEST_SOURCE_FINGERPRINT"
PRE_SOURCE_FILE_COUNT="$ARM64_GUEST_SOURCE_FILE_COUNT"
SOURCE_ROOTS="$ARM64_GUEST_SOURCE_ROOTS"
PRE_COMPILER_SHA256="$(sha256_file "$COMPILER")" ||
    fail_build "canonical-compiler-sha256-failed"
PRE_ENTRY_SHA256="$(sha256_file "$ENTRY")" ||
    fail_build "canonical-entry-sha256-failed"
PRE_COMPILER_VERSION_OUTPUT="$("$COMPILER" --version 2>/dev/null)" ||
    fail_build "canonical-compiler-version-command-failed"
PRE_COMPILER_VERSION="$(printf '%s\n' "$PRE_COMPILER_VERSION_OUTPUT" |
    sed -n '1p')"
[ -n "$PRE_COMPILER_VERSION" ] ||
    fail_build "canonical-compiler-version-missing"
QEMU_ADMISSION_COMMAND="$BUILD_COMMAND"
qemu_admission_begin arm64 \
    "$ENTRY" \
    "$COMPILER" "$QEMU_ADMISSION_COMMAND" \
    build/os/generated src/os src/lib examples/09_embedded/simple_os \
    scripts/os/make_os_disk.shs scripts/os/make_os_disk.c \
    scripts/os/simpleos_font_bundle_companion.sha256 assets/fonts \
    scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs \
    scripts/check/lib/simpleos-arm64-guest-source-fingerprint.shs \
    scripts/check/lib/qemu-frozen-source-admission.shs ||
    fail_build "frozen-source-admission-rejected"

# Remove a previously valid receipt before starting: a failed or interrupted
# rebuild must never leave stale provenance beside new/partial artifacts.
rm -f "$BUILD_MANIFEST" ||
    fail_build "stale-build-manifest-remove-failed"
# A provenance-producing invocation must execute both native-build and the disk
# producer. Existing kernel/disk/writer artifacts cannot serve as fresh proof.
rm -f "$KERNEL" "$BUILD_STAMP" "$DISK" "$DISK_PRODUCER" "$BUILD_LOG" ||
    fail_build "persistent-artifact-cache-invalidation-failed"

set +e
sh scripts/os/make_os_disk.shs 128 "$DISK" "" arm64 desktop-fonts \
    >"$BUILD_LOG" 2>&1
MEDIA_CODE=$?
set -e
[ "$MEDIA_CODE" -eq 0 ] ||
    fail_build "canonical-desktop-media-build-failed"
for MEDIA_FONT in \
    NSANSSC NSANSDEV NSANSARB NSANSBEN NSERIFSC NSERFDEV NNASKHAR NSERFBEN \
    NOTOSANS BUNGEE NUNITO CAVEAT ROBOSLAB UNIFRAKT PIXELIFY NOTOEMOJ NOTICES.MD
do
    mtype -i "$DISK" "::/SYS/FONTS/$MEDIA_FONT" 2>/dev/null |
        grep -qa . || fail_build "canonical-desktop-media-font-verification-failed"
done
if mdir -i "$DISK" ::/SYS/APPS >/dev/null 2>&1 ||
        mtype -i "$DISK" ::/SIMPLE.ELF >/dev/null 2>&1; then
    fail_build "canonical-desktop-media-payload-isolation-failed"
fi

mkdir -p "$(dirname "$GENERATED_LOG_CONFIG")" ||
    fail_build "generated-log-config-directory-failed"
printf '%s\n' \
    'val SIMPLEOS_LOG_COMPILED: bool = false' \
    '' \
    'fn simpleos_log_compile_enabled() -> bool:' \
    '    SIMPLEOS_LOG_COMPILED' \
    '' \
    'fn simpleos_log_compile_mode_name() -> text:' \
    '    if SIMPLEOS_LOG_COMPILED:' \
    '        return "on"' \
    '    "off"' \
    >"$GENERATED_LOG_CONFIG" ||
    fail_build "generated-log-config-write-failed"

set +e
"$TIMEOUT_BIN" -k 5 "$BUILD_TIMEOUT_SECONDS" \
env -u SIMPLE_BINARY -u SIMPLE_BIN -u SIMPLE_FRONTEND_DELEGATE \
    -u SIMPLE_BOOTSTRAP_DRIVER SIMPLE_BOOTSTRAP=1 SIMPLE_LIB="$ROOT_DIR/src" \
    SIMPLE_ALLOW_FREESTANDING_STUBS=1 SIMPLE_NO_STUB_FALLBACK=1 \
    SIMPLE_STRICT_FABRICATED_STUB_RATCHET=1 SIMPLE_OS_LOG_MODE=off \
    "$COMPILER" native-build --verbose \
    --source build/os/generated --source src/os --source src/lib \
    --source examples/09_embedded/simple_os --backend "$NATIVE_BACKEND" \
    --opt-level=aggressive --log off --timeout 870 \
    --threads "$NATIVE_THREADS" --cache-dir "$NATIVE_CACHE" --entry-closure \
    --entry "$ENTRY" --target aarch64-unknown-none -o "$KERNEL" \
    --linker-script examples/09_embedded/simple_os/arch/arm64/linker.ld \
    >>"$BUILD_LOG" 2>&1
BUILD_CODE=$?
set -e
sed -n '1,240p' "$BUILD_LOG"
if [ "$BUILD_CODE" -eq 124 ] || [ "$BUILD_CODE" -eq 137 ]; then
    fail_build "canonical-native-build-timeout"
fi
[ "$BUILD_CODE" -eq 0 ] ||
    fail_build "canonical-scenario-build-failed"
if ! arm64_fabrication_receipt_clean "$BUILD_LOG"; then
    fail_build "fabricated-stub-attestation-rejected"
fi
# The runner creates this source before native-build but does not remove it on
# its success path. Restore the same normalized state used by the pre-snapshot.
rm -f "$GENERATED_LOG_CONFIG" ||
    fail_build "generated-log-config-cleanup-failed"
[ -f "$KERNEL" ] && [ -s "$KERNEL" ] ||
    fail_build "canonical-kernel-missing-after-build"
[ -f "$DISK" ] && [ -s "$DISK" ] ||
    fail_build "canonical-desktop-disk-missing-after-build"
[ -x "$DISK_PRODUCER" ] && [ -f "$DISK_PRODUCER" ] ||
    fail_build "canonical-disk-producer-missing-after-build"

POST_HEAD="$(git rev-parse --verify HEAD 2>/dev/null)" ||
    fail_build "post-build-source-revision-unavailable"
if arm64_guest_source_dirty; then
    fail_build "guest-source-worktree-dirty-after-build"
else
    SOURCE_DIRTY_CODE=$?
    [ "$SOURCE_DIRTY_CODE" -eq 1 ] ||
        fail_build "guest-source-git-status-failed-after-build"
fi
arm64_guest_source_snapshot ||
    fail_build "post-build-source-fingerprint-failed"
POST_SOURCE_FINGERPRINT="$ARM64_GUEST_SOURCE_FINGERPRINT"
POST_SOURCE_FILE_COUNT="$ARM64_GUEST_SOURCE_FILE_COUNT"
POST_COMPILER_SHA256="$(sha256_file "$COMPILER")" ||
    fail_build "post-build-compiler-sha256-failed"
POST_ENTRY_SHA256="$(sha256_file "$ENTRY")" ||
    fail_build "entry-changed-during-build"
POST_COMPILER_VERSION_OUTPUT="$("$COMPILER" --version 2>/dev/null)" ||
    fail_build "post-build-compiler-version-command-failed"
POST_COMPILER_VERSION="$(printf '%s\n' "$POST_COMPILER_VERSION_OUTPUT" |
    sed -n '1p')"

[ "$POST_HEAD" = "$PRE_HEAD" ] ||
    fail_build "source-revision-changed-during-build"
[ "$POST_SOURCE_FINGERPRINT" = "$PRE_SOURCE_FINGERPRINT" ] ||
    fail_build "guest-source-changed-during-build"
[ "$POST_SOURCE_FILE_COUNT" = "$PRE_SOURCE_FILE_COUNT" ] ||
    fail_build "guest-source-file-count-changed-during-build"
[ "$POST_COMPILER_SHA256" = "$PRE_COMPILER_SHA256" ] ||
    fail_build "compiler-changed-during-build"
[ "$POST_ENTRY_SHA256" = "$PRE_ENTRY_SHA256" ] ||
    fail_build "entry-changed-during-build"
[ "$POST_COMPILER_VERSION" = "$PRE_COMPILER_VERSION" ] ||
    fail_build "compiler-version-changed-during-build"

KERNEL_SHA256="$(sha256_file "$KERNEL")" ||
    fail_build "canonical-kernel-sha256-failed"
DISK_SHA256="$(sha256_file "$DISK")" ||
    fail_build "canonical-disk-sha256-failed"
DISK_PRODUCER_SHA256="$(sha256_file "$DISK_PRODUCER")" ||
    fail_build "canonical-disk-producer-sha256-failed"
BUILD_LOG_SHA256="$(sha256_file "$BUILD_LOG")" ||
    fail_build "canonical-build-log-sha256-failed"
printf '%s\n' "$PRE_COMPILER_VERSION" | grep -q '[[:cntrl:]]' &&
    fail_build "compiler-version-not-manifest-safe"

umask 077
{
    echo "artifact_kind=simpleos-arm64-desktop-engine2d"
    echo "source_revision=$PRE_HEAD"
    echo "source_roots=$SOURCE_ROOTS"
    echo "source_fingerprint=$PRE_SOURCE_FINGERPRINT"
    echo "source_file_count=$PRE_SOURCE_FILE_COUNT"
    echo "entry_path=$ENTRY"
    echo "entry_sha256=$PRE_ENTRY_SHA256"
    echo "kernel_path=$KERNEL"
    echo "kernel_sha256=$KERNEL_SHA256"
    echo "disk_path=$DISK"
    echo "disk_sha256=$DISK_SHA256"
    echo "disk_producer_path=$DISK_PRODUCER"
    echo "disk_producer_sha256=$DISK_PRODUCER_SHA256"
    echo "build_log_path=$BUILD_LOG"
    echo "build_log_sha256=$BUILD_LOG_SHA256"
    echo "compiler_path=$COMPILER"
    echo "compiler_sha256=$PRE_COMPILER_SHA256"
    echo "compiler_version=$PRE_COMPILER_VERSION"
    echo "compiler_format=$COMPILER_FORMAT"
    echo "compiler_arch=$COMPILER_ARCH"
    echo "build_command=$BUILD_COMMAND"
    echo "build_environment=$BUILD_ENVIRONMENT"
} >"$MANIFEST_TMP"
mv "$MANIFEST_TMP" "$BUILD_MANIFEST"
qemu_admission_publish "$KERNEL" "$FROZEN_BUILD_MANIFEST" \
    build/os/generated src/os src/lib examples/09_embedded/simple_os \
    scripts/os/make_os_disk.shs scripts/os/make_os_disk.c \
    scripts/os/simpleos_font_bundle_companion.sha256 assets/fonts \
    scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs \
    scripts/check/lib/simpleos-arm64-guest-source-fingerprint.shs \
    scripts/check/lib/qemu-frozen-source-admission.shs || {
    rm -f "$BUILD_MANIFEST" "$FROZEN_BUILD_MANIFEST"
    fail_build "frozen-source-admission-rejected"
}

echo "arm64_desktop_engine2d_attested_build_status=pass"
echo "arm64_desktop_engine2d_attested_build_manifest=$BUILD_MANIFEST"
echo "arm64_desktop_engine2d_attested_frozen_source_admission=$FROZEN_BUILD_MANIFEST"
echo "arm64_desktop_engine2d_attested_source_revision=$PRE_HEAD"
echo "arm64_desktop_engine2d_attested_source_fingerprint=$PRE_SOURCE_FINGERPRINT"
echo "arm64_desktop_engine2d_attested_source_file_count=$PRE_SOURCE_FILE_COUNT"
