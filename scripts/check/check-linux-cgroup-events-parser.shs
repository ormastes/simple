#!/bin/sh
# Portable decoder evidence only; this does not execute Linux cgroup effects.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/cgroup-events-parser.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
"${CC:-cc}" -std=c11 -O1 -Wall -Wextra -Werror \
    "$root/src/runtime/test/rt_linux_cgroup_events_parse_selfcheck.c" \
    -o "$scratch/parser-selfcheck"
"$scratch/parser-selfcheck"
