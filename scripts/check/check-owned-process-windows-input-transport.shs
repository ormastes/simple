#!/bin/sh
# Deterministic Win32 API fakes exercise the real stdin transport on any host.
# This is transport logic evidence only, never native Windows qualification.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/windows-input-transport.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
"${CC:-cc}" -std=c11 -Wall -Wextra -Werror -I"$root/src/runtime" \
    "$root/src/runtime/test/runtime_process_owned_windows_input_transport_selfcheck.c" \
    -o "$work/selfcheck"
"$work/selfcheck"
