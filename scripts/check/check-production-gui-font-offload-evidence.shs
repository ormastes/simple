#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

BUILD_DIR="${BUILD_DIR:-build/production_gui_font_offload_evidence}"
REPORT_PATH="${REPORT_PATH:-doc/09_report/production_gui_font_offload_evidence_$(date -u +%F).md}"
SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE:-explicit-env}"
SIMPLE_BIN_STATUS=pass
ENV_PATH="$BUILD_DIR/evidence.env"
BLOCKER_DOC="doc/08_tracking/bug/production_gui_font_offload_runtime_readback_2026-06-23.md"
RUNTIME_EVIDENCE_ENV="${PRODUCTION_GUI_FONT_RUNTIME_EVIDENCE_ENV:-}"
RUNTIME_EVIDENCE_STATUS=missing
RUNTIME_EVIDENCE_SOURCE=none
RUNTIME_EVIDENCE_PRODUCER_EXIT=""
RUNTIME_EVIDENCE_GENERATOR_FAILED=0
RUNTIME_EVIDENCE_SCRIPT="${PRODUCTION_GUI_FONT_RUNTIME_EVIDENCE_SCRIPT:-scripts/check/check-production-gui-font-runtime-evidence.shs}"

find_posix_timeout() {
    if command -v timeout >/dev/null 2>&1; then
        _fpt_p="$(command -v timeout)"
        case "$_fpt_p" in
            */System32/*|*/system32/*) ;;
            *) printf '%s\n' "$_fpt_p"; return 0 ;;
        esac
    fi
    if [ -x /usr/bin/timeout ]; then
        printf '%s\n' /usr/bin/timeout
        return 0
    fi
    return 1
}

POSIX_TIMEOUT="$(find_posix_timeout || true)"

is_rust_seed_simple() {
    case "$1" in
        src/compiler_rust/*|./src/compiler_rust/*|*/src/compiler_rust/*) return 0 ;;
    esac
    [ -n "${1:-}" ] && [ -x "$1" ] || return 1
    if [ -n "${POSIX_TIMEOUT:-}" ]; then
        _irss_v="$("$POSIX_TIMEOUT" 10 "$1" --version 2>&1)" || return 0
    else
        _irss_v="$("$1" --version 2>&1)" || return 0
    fi
    [ -n "$_irss_v" ] || return 0
    case "$_irss_v" in
        *"bootstrap seed only"*|*"Rust-built"*|*"debug build"*) return 0 ;;
        *Simple*) return 1 ;;
        *) return 0 ;;
    esac
}

is_host_compatible_simple() {
    path="$1"
    [ -x "$path" ] || return 1
    if ! command -v file >/dev/null 2>&1; then
        return 0
    fi
    description="$(file "$path" 2>/dev/null || true)"
    case "$(uname -s 2>/dev/null || echo unknown)" in
        Darwin)
            case "$description" in
                *ELF*|*PE32*) return 1 ;;
            esac
            ;;
        Linux|FreeBSD)
            case "$description" in
                *Mach-O*|*PE32*) return 1 ;;
            esac
            ;;
        CYGWIN*|MINGW*|MSYS*|Windows_NT)
            case "$description" in
                *ELF*|*Mach-O*) return 1 ;;
            esac
            ;;
    esac
    return 0
}

if [ -z "${SIMPLE_BIN+x}" ]; then
    SIMPLE_BIN_SOURCE="default-missing"
    for candidate in \
        "bin/release"/*/simple \
        "build/bootstrap/stage3/simple" \
        "bin/simple" \
        "./bin/simple" \
        "release"/*/simple
    do
        if is_host_compatible_simple "$candidate"; then
            SIMPLE_BIN="$candidate"
            SIMPLE_BIN_SOURCE="repo-self-hosted-fallback"
            break
        fi
    done
    if [ -z "${SIMPLE_BIN+x}" ] && command -v simple >/dev/null 2>&1; then
        SIMPLE_BIN="$(command -v simple)"
        SIMPLE_BIN_SOURCE="path-fallback"
    fi
fi
if [ -z "${SIMPLE_BIN+x}" ] || [ "$SIMPLE_BIN" = "" ]; then
    SIMPLE_BIN=""
    SIMPLE_BIN_STATUS=missing
    SIMPLE_BIN_SOURCE="missing-self-hosted"
elif is_rust_seed_simple "$SIMPLE_BIN"; then
    SIMPLE_BIN_STATUS=forbidden
    SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE}-rust-seed-forbidden"
elif [ ! -x "$SIMPLE_BIN" ]; then
    SIMPLE_BIN_STATUS=missing
    SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE}-missing"
elif ! is_host_compatible_simple "$SIMPLE_BIN"; then
    SIMPLE_BIN_STATUS=incompatible
    SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE}-host-incompatible"
fi
export SIMPLE_BIN SIMPLE_BIN_SOURCE SIMPLE_BIN_STATUS

field_of() {
    key="$1"
    file="$2"
    if [ -s "$file" ]; then
        sed -n "s/^${key}=//p" "$file" | tail -n 1
    fi
}

positive_int() {
    case "${1:-}" in
        '' | *[!0-9]* | 0) return 1 ;;
        *) return 0 ;;
    esac
}

is_gpu_font_backend() {
    case "${1:-}" in
        "" | cpu | software | cpu_simd | unknown) return 1 ;;
        *) return 0 ;;
    esac
}

mkdir -p "$BUILD_DIR" "$(dirname -- "$REPORT_PATH")"
rm -f "$ENV_PATH" "$REPORT_PATH"

if [ -n "$RUNTIME_EVIDENCE_ENV" ]; then
    RUNTIME_EVIDENCE_SOURCE=explicit
elif [ "${PRODUCTION_GUI_FONT_RUNTIME_EVIDENCE_AUTO:-1}" = "1" ] && [ -r "$RUNTIME_EVIDENCE_SCRIPT" ]; then
    RUNTIME_EVIDENCE_SOURCE=auto
    runtime_dir="$BUILD_DIR/runtime"
    # Always invalidate any prior cached runtime evidence before running auto collection.
    rm -f "$runtime_dir/evidence.env" "$runtime_dir/stdout.env" "$runtime_dir/report.md"
    mkdir -p "$runtime_dir"
    set +e
    BUILD_DIR="$runtime_dir" REPORT_PATH="$runtime_dir/report.md" SIMPLE_BIN="${SIMPLE_BIN:-}" SIMPLE_LIB="${SIMPLE_LIB:-src}" sh "$RUNTIME_EVIDENCE_SCRIPT" >"$runtime_dir/stdout.env" 2>"$runtime_dir/stderr.log"
    runtime_code=$?
    set -e
    RUNTIME_EVIDENCE_PRODUCER_EXIT="$runtime_code"
    if [ "$runtime_code" -ne 0 ]; then
        rm -f "$runtime_dir/evidence.env"
        RUNTIME_EVIDENCE_STATUS=failed
        RUNTIME_EVIDENCE_GENERATOR_FAILED=1
    elif [ -s "$runtime_dir/evidence.env" ]; then
        RUNTIME_EVIDENCE_ENV="$runtime_dir/evidence.env"
    elif [ -s "$runtime_dir/stdout.env" ]; then
        RUNTIME_EVIDENCE_ENV="$runtime_dir/stdout.env"
    fi
fi

emit_unavailable() {
    reason="$1"
    {
        echo "production_gui_font_offload_status=unavailable"
        echo "production_gui_font_offload_reason=$reason"
        echo "production_gui_font_offload_simple_bin=$SIMPLE_BIN"
        echo "production_gui_font_offload_simple_bin_source=$SIMPLE_BIN_SOURCE"
        echo "production_gui_font_offload_simple_bin_status=$SIMPLE_BIN_STATUS"
        echo "production_gui_font_offload_runtime_evidence_env=$RUNTIME_EVIDENCE_ENV"
        echo "production_gui_font_offload_runtime_evidence_status=$RUNTIME_EVIDENCE_STATUS"
        echo "production_gui_font_offload_runtime_evidence_source=$RUNTIME_EVIDENCE_SOURCE"
        if [ -n "$RUNTIME_EVIDENCE_PRODUCER_EXIT" ]; then
            echo "production_gui_font_offload_runtime_evidence_producer_exit=$RUNTIME_EVIDENCE_PRODUCER_EXIT"
        fi
        echo "production_gui_font_offload_vector_status=unavailable"
        echo "production_gui_font_offload_vector_reason=$reason"
        echo "production_gui_font_offload_vector_readback_status=unavailable"
        echo "production_gui_font_offload_vector_readback_reason=$reason"
        echo "production_gui_font_offload_vector_production_ready=false"
        echo "production_gui_font_offload_vector_expected_checksum=0"
        echo "production_gui_font_offload_vector_actual_checksum=0"
        echo "production_gui_font_offload_bitmap_status=unavailable"
        echo "production_gui_font_offload_bitmap_reason=$reason"
        echo "production_gui_font_offload_bitmap_readback_status=unavailable"
        echo "production_gui_font_offload_bitmap_readback_reason=$reason"
        echo "production_gui_font_offload_bitmap_production_ready=false"
        echo "production_gui_font_offload_bitmap_expected_checksum=0"
        echo "production_gui_font_offload_bitmap_actual_checksum=0"
        echo "production_gui_font_offload_report=$REPORT_PATH"
        echo "production_gui_font_offload_blocker_doc=$BLOCKER_DOC"
    } >"$ENV_PATH"
    {
        echo "# Production GUI Font Offload Evidence"
        echo
        echo "- status: unavailable"
        echo "- reason: $reason"
        echo "- runtime evidence source: $RUNTIME_EVIDENCE_SOURCE"
        echo "- blocker: $BLOCKER_DOC"
    } >"$REPORT_PATH"
    cat "$ENV_PATH"
}

if [ "$SIMPLE_BIN_STATUS" != "pass" ]; then
    emit_unavailable "simple-bin-$SIMPLE_BIN_STATUS"
    exit 1
fi

if [ "$RUNTIME_EVIDENCE_GENERATOR_FAILED" -eq 1 ]; then
    emit_unavailable "runtime-evidence-generator-failed"
    exit 1
fi

if [ -z "$RUNTIME_EVIDENCE_ENV" ] || [ ! -s "$RUNTIME_EVIDENCE_ENV" ]; then
    emit_unavailable "runtime-font-provenance-missing"
    exit 1
fi

RUNTIME_EVIDENCE_STATUS=""
SELECTED_BACKEND=""
FONT_BACKEND=""
FONT_DRIVER=""
FONT_DEVICE_HANDLE=""
FONT_MODULE_HANDLE=""
FONT_KERNEL_HANDLE=""
FONT_FENCE_HANDLE=""
FONT_READBACK_CHECKSUM=""
VECTOR_EXPECTED_CHECKSUM=""
VECTOR_ACTUAL_CHECKSUM=""
BITMAP_EXPECTED_CHECKSUM=""
BITMAP_ACTUAL_CHECKSUM=""
FONT_PARITY_STATUS=""
while IFS='=' read -r _k _v || [ -n "$_k" ]; do
    case "$_k" in
        production_gui_font_runtime_status) RUNTIME_EVIDENCE_STATUS="$_v" ;;
        production_gui_font_runtime_selected_backend) SELECTED_BACKEND="$_v" ;;
        production_gui_font_runtime_font_backend) FONT_BACKEND="$_v" ;;
        production_gui_font_runtime_font_driver) FONT_DRIVER="$_v" ;;
        production_gui_font_runtime_font_device_handle) FONT_DEVICE_HANDLE="$_v" ;;
        production_gui_font_runtime_font_module_or_queue_handle) FONT_MODULE_HANDLE="$_v" ;;
        production_gui_font_runtime_font_kernel_or_pipeline_handle) FONT_KERNEL_HANDLE="$_v" ;;
        production_gui_font_runtime_font_fence_handle) FONT_FENCE_HANDLE="$_v" ;;
        production_gui_font_runtime_font_readback_checksum) FONT_READBACK_CHECKSUM="$_v" ;;
        production_gui_font_runtime_vector_expected_checksum) VECTOR_EXPECTED_CHECKSUM="$_v" ;;
        production_gui_font_runtime_vector_actual_checksum) VECTOR_ACTUAL_CHECKSUM="$_v" ;;
        production_gui_font_runtime_bitmap_expected_checksum) BITMAP_EXPECTED_CHECKSUM="$_v" ;;
        production_gui_font_runtime_bitmap_actual_checksum) BITMAP_ACTUAL_CHECKSUM="$_v" ;;
        production_gui_font_runtime_font_parity_status) FONT_PARITY_STATUS="$_v" ;;
    esac
done <"$RUNTIME_EVIDENCE_ENV"
if [ -z "$RUNTIME_EVIDENCE_STATUS" ]; then
    RUNTIME_EVIDENCE_STATUS=missing-status
fi

if [ "$RUNTIME_EVIDENCE_STATUS" != "pass" ] \
    || ! is_gpu_font_backend "$SELECTED_BACKEND" \
    || ! is_gpu_font_backend "$FONT_BACKEND" \
    || [ "$FONT_BACKEND" != "$SELECTED_BACKEND" ] \
    || [ -z "$FONT_DRIVER" ] \
    || ! positive_int "$FONT_DEVICE_HANDLE" \
    || ! positive_int "$FONT_MODULE_HANDLE" \
    || ! positive_int "$FONT_KERNEL_HANDLE" \
    || ! positive_int "$FONT_FENCE_HANDLE" \
    || ! positive_int "$FONT_READBACK_CHECKSUM" \
    || ! positive_int "$VECTOR_EXPECTED_CHECKSUM" \
    || ! positive_int "$VECTOR_ACTUAL_CHECKSUM" \
    || [ "$VECTOR_ACTUAL_CHECKSUM" != "$VECTOR_EXPECTED_CHECKSUM" ] \
    || ! positive_int "$BITMAP_EXPECTED_CHECKSUM" \
    || ! positive_int "$BITMAP_ACTUAL_CHECKSUM" \
    || [ "$BITMAP_ACTUAL_CHECKSUM" != "$BITMAP_EXPECTED_CHECKSUM" ] \
    || [ "$BITMAP_ACTUAL_CHECKSUM" != "$FONT_READBACK_CHECKSUM" ] \
    || [ "$FONT_PARITY_STATUS" != "pass" ]; then
    emit_unavailable "runtime-font-provenance-missing"
    exit 1
fi

{
    echo "production_gui_font_offload_status=pass"
    echo "production_gui_font_offload_reason=vector-and-bitmap-font-readback-matched"
    echo "production_gui_font_offload_simple_bin=$SIMPLE_BIN"
    echo "production_gui_font_offload_simple_bin_source=$SIMPLE_BIN_SOURCE"
    echo "production_gui_font_offload_simple_bin_status=$SIMPLE_BIN_STATUS"
    echo "production_gui_font_offload_runtime_evidence_env=$RUNTIME_EVIDENCE_ENV"
    echo "production_gui_font_offload_runtime_evidence_status=$RUNTIME_EVIDENCE_STATUS"
    echo "production_gui_font_offload_runtime_evidence_source=$RUNTIME_EVIDENCE_SOURCE"
    echo "production_gui_font_offload_backend=$FONT_BACKEND"
    echo "production_gui_font_offload_driver=$FONT_DRIVER"
    echo "production_gui_font_offload_device_handle=$FONT_DEVICE_HANDLE"
    echo "production_gui_font_offload_module_or_queue_handle=$FONT_MODULE_HANDLE"
    echo "production_gui_font_offload_kernel_or_pipeline_handle=$FONT_KERNEL_HANDLE"
    echo "production_gui_font_offload_fence_handle=$FONT_FENCE_HANDLE"
    echo "production_gui_font_offload_font_readback_checksum=$FONT_READBACK_CHECKSUM"
    echo "production_gui_font_offload_parity_status=$FONT_PARITY_STATUS"
    echo "production_gui_font_offload_vector_backend=$FONT_BACKEND"
    echo "production_gui_font_offload_vector_status=pass"
    echo "production_gui_font_offload_vector_reason=runtime-font-readback-matched"
    echo "production_gui_font_offload_vector_readback_status=pass"
    echo "production_gui_font_offload_vector_readback_reason=runtime-font-readback-matched"
    echo "production_gui_font_offload_vector_production_ready=true"
    echo "production_gui_font_offload_vector_expected_checksum=$VECTOR_EXPECTED_CHECKSUM"
    echo "production_gui_font_offload_vector_actual_checksum=$VECTOR_ACTUAL_CHECKSUM"
    echo "production_gui_font_offload_bitmap_backend=$FONT_BACKEND"
    echo "production_gui_font_offload_bitmap_status=pass"
    echo "production_gui_font_offload_bitmap_reason=runtime-font-readback-matched"
    echo "production_gui_font_offload_bitmap_readback_status=pass"
    echo "production_gui_font_offload_bitmap_readback_reason=runtime-font-readback-matched"
    echo "production_gui_font_offload_bitmap_production_ready=true"
    echo "production_gui_font_offload_bitmap_expected_checksum=$BITMAP_EXPECTED_CHECKSUM"
    echo "production_gui_font_offload_bitmap_actual_checksum=$BITMAP_ACTUAL_CHECKSUM"
    echo "production_gui_font_offload_report=$REPORT_PATH"
    echo "production_gui_font_offload_blocker_doc=$BLOCKER_DOC"
} >"$ENV_PATH"

{
    echo "# Production GUI Font Offload Evidence"
    echo
    echo "- status: pass"
    echo "- reason: vector-and-bitmap-font-readback-matched"
    echo "- simple_bin: $SIMPLE_BIN"
    echo "- simple_bin_source: $SIMPLE_BIN_SOURCE"
    echo "- simple_bin_status: $SIMPLE_BIN_STATUS"
    echo "- runtime evidence: $RUNTIME_EVIDENCE_STATUS"
    echo "- font backend: $FONT_BACKEND"
    echo "- font driver: $FONT_DRIVER"
    echo "- font device handle: $FONT_DEVICE_HANDLE"
    echo "- font module/queue handle: $FONT_MODULE_HANDLE"
    echo "- font kernel/pipeline handle: $FONT_KERNEL_HANDLE"
    echo "- font fence handle: $FONT_FENCE_HANDLE"
    echo "- vector expected checksum: $VECTOR_EXPECTED_CHECKSUM"
    echo "- vector actual checksum: $VECTOR_ACTUAL_CHECKSUM"
    echo "- bitmap expected checksum: $BITMAP_EXPECTED_CHECKSUM"
    echo "- bitmap actual checksum: $BITMAP_ACTUAL_CHECKSUM"
    echo "- font readback checksum: $FONT_READBACK_CHECKSUM"
    echo "- font parity status: $FONT_PARITY_STATUS"
} >"$REPORT_PATH"

cat "$ENV_PATH"
