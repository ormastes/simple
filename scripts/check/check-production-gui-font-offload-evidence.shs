#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

BUILD_DIR="${BUILD_DIR:-build/production_gui_font_offload_evidence}"
REPORT_PATH="${REPORT_PATH:-doc/09_report/production_gui_font_offload_evidence_$(date -u +%F).md}"
SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE:-explicit-env}"
SIMPLE_BIN_STATUS=pass
ENV_PATH="$BUILD_DIR/evidence.env"
BLOCKER_DOC="doc/08_tracking/bug/production_gui_font_offload_runtime_readback_2026-06-23.md"
RUNTIME_EVIDENCE_ENV="${PRODUCTION_GUI_FONT_RUNTIME_EVIDENCE_ENV:-}"
RUNTIME_EVIDENCE_STATUS=missing
RUNTIME_EVIDENCE_SCRIPT="${PRODUCTION_GUI_FONT_RUNTIME_EVIDENCE_SCRIPT:-scripts/check/check-production-gui-font-runtime-evidence.shs}"
RUNTIME_EVIDENCE_SOURCE=missing
RUNTIME_EVIDENCE_PRODUCER_EXIT=not-run
TIMEOUT_BIN=""
if command -v timeout >/dev/null 2>&1; then
    TIMEOUT_BIN="$(command -v timeout)"
elif command -v gtimeout >/dev/null 2>&1; then
    TIMEOUT_BIN="$(command -v gtimeout)"
fi

is_rust_seed_simple() {
    # Identity probe, not just a path pattern (2026-07-28).
    # This used to test ONLY for a src/compiler_rust/ path. The deployed Rust
    # seed lives at bin/release/<triple>/simple, which matches none of those
    # patterns, so the seed was classified "not a seed" and every self-hosted
    # claim in this script was asserted against it. Ask the binary instead.
    # Audit: doc/08_tracking/todo/check_scripts_seed_identity_fail_open_2026-07-28.md
    case "$1" in
        src/compiler_rust/*|./src/compiler_rust/*|*/src/compiler_rust/*) return 0 ;;
    esac
    # Not runnable: leave it to the caller's own missing-binary branch, which
    # already fails. Do not report "seed" for something we never ran.
    [ -n "${1:-}" ] && [ -x "$1" ] || return 1
    # Executable but unverifiable => treat as forbidden (fail closed). The seed
    # self-identifies on stderr, so 2>&1 is required.
    [ -n "$TIMEOUT_BIN" ] || return 0
    _irss_v="$("$TIMEOUT_BIN" 10 "$1" --version 2>&1)" || return 0
    [ -n "$_irss_v" ] || return 0
    case "$_irss_v" in
        *"bootstrap seed only"*|*"Rust-built"*|*"debug build"*) return 0 ;;
    esac
    return 1
}

is_host_compatible_simple() {
    path="$1"
    [ -x "$path" ] || return 1
    if ! command -v file >/dev/null 2>&1; then
        return 0
    fi
    description="$(file "$path" 2>/dev/null || true)"
    case "$(uname -s 2>/dev/null || echo unknown)" in
        Darwin)
            case "$description" in
                *ELF*|*PE32*) return 1 ;;
            esac
            ;;
        Linux|FreeBSD)
            case "$description" in
                *Mach-O*|*PE32*) return 1 ;;
            esac
            ;;
        CYGWIN*|MINGW*|MSYS*|Windows_NT)
            case "$description" in
                *ELF*|*Mach-O*) return 1 ;;
            esac
            ;;
    esac
    return 0
}

if [ -z "${SIMPLE_BIN+x}" ]; then
    SIMPLE_BIN_SOURCE="default-missing"
    for candidate in \
        "bin/release"/*/simple \
        "build/bootstrap/stage3/simple" \
        "bin/simple" \
        "./bin/simple" \
        "release"/*/simple
    do
        if is_host_compatible_simple "$candidate"; then
            SIMPLE_BIN="$candidate"
            SIMPLE_BIN_SOURCE="repo-self-hosted-fallback"
            break
        fi
    done
    if [ -z "${SIMPLE_BIN+x}" ] && command -v simple >/dev/null 2>&1; then
        SIMPLE_BIN="$(command -v simple)"
        SIMPLE_BIN_SOURCE="path-fallback"
    fi
fi
if [ -z "${SIMPLE_BIN+x}" ] || [ "$SIMPLE_BIN" = "" ]; then
    SIMPLE_BIN=""
    SIMPLE_BIN_STATUS=missing
    SIMPLE_BIN_SOURCE="missing-self-hosted"
elif is_rust_seed_simple "$SIMPLE_BIN"; then
    SIMPLE_BIN_STATUS=forbidden
    SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE}-rust-seed-forbidden"
elif [ ! -x "$SIMPLE_BIN" ]; then
    SIMPLE_BIN_STATUS=missing
    SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE}-missing"
elif ! is_host_compatible_simple "$SIMPLE_BIN"; then
    SIMPLE_BIN_STATUS=incompatible
    SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE}-host-incompatible"
fi
export SIMPLE_BIN SIMPLE_BIN_SOURCE SIMPLE_BIN_STATUS

field_of() {
    key="$1"
    file="$2"
    sed -n "s/^${key}=//p" "$file" | tail -n 1
}

if [ -n "$RUNTIME_EVIDENCE_ENV" ]; then
    RUNTIME_EVIDENCE_SOURCE=explicit
elif [ -z "$RUNTIME_EVIDENCE_ENV" ] \
    && [ "${PRODUCTION_GUI_FONT_RUNTIME_EVIDENCE_AUTO:-1}" = "1" ] \
    && [ -x "$RUNTIME_EVIDENCE_SCRIPT" ]; then
    RUNTIME_EVIDENCE_SOURCE=auto
    runtime_dir="$BUILD_DIR/runtime"
    mkdir -p "$runtime_dir"
    rm -f "$runtime_dir/evidence.env" "$runtime_dir/stdout.env" "$runtime_dir/stderr.log"
    set +e
    BUILD_DIR="$runtime_dir" REPORT_PATH="$runtime_dir/report.md" SIMPLE_BIN="${SIMPLE_BIN:-}" SIMPLE_LIB="${SIMPLE_LIB:-src}" sh "$RUNTIME_EVIDENCE_SCRIPT" >"$runtime_dir/stdout.env" 2>"$runtime_dir/stderr.log"
    runtime_code=$?
    set -e
    RUNTIME_EVIDENCE_PRODUCER_EXIT="$runtime_code"
    if [ -s "$runtime_dir/evidence.env" ]; then
        RUNTIME_EVIDENCE_ENV="$runtime_dir/evidence.env"
    elif [ -s "$runtime_dir/stdout.env" ]; then
        RUNTIME_EVIDENCE_ENV="$runtime_dir/stdout.env"
    fi
fi

RUNTIME_FONT_BACKEND=""
RUNTIME_FONT_DRIVER=""
RUNTIME_FONT_DEVICE_HANDLE=""
RUNTIME_FONT_MODULE_OR_QUEUE_HANDLE=""
RUNTIME_FONT_KERNEL_OR_PIPELINE_HANDLE=""
RUNTIME_FONT_FENCE_HANDLE=""
RUNTIME_FONT_READBACK_CHECKSUM=""
RUNTIME_FONT_PARITY_STATUS=""
RUNTIME_FONT_SELECTED_BACKEND=""

if [ -n "$RUNTIME_EVIDENCE_ENV" ] && [ -s "$RUNTIME_EVIDENCE_ENV" ]; then
    RUNTIME_EVIDENCE_STATUS="$(field_of production_gui_font_runtime_status "$RUNTIME_EVIDENCE_ENV")"
    if [ -z "$RUNTIME_EVIDENCE_STATUS" ]; then
        RUNTIME_EVIDENCE_STATUS=missing-status
    fi
    RUNTIME_FONT_BACKEND="$(field_of production_gui_font_runtime_font_backend "$RUNTIME_EVIDENCE_ENV")"
    RUNTIME_FONT_DRIVER="$(field_of production_gui_font_runtime_font_driver "$RUNTIME_EVIDENCE_ENV")"
    RUNTIME_FONT_DEVICE_HANDLE="$(field_of production_gui_font_runtime_font_device_handle "$RUNTIME_EVIDENCE_ENV")"
    RUNTIME_FONT_MODULE_OR_QUEUE_HANDLE="$(field_of production_gui_font_runtime_font_module_or_queue_handle "$RUNTIME_EVIDENCE_ENV")"
    RUNTIME_FONT_KERNEL_OR_PIPELINE_HANDLE="$(field_of production_gui_font_runtime_font_kernel_or_pipeline_handle "$RUNTIME_EVIDENCE_ENV")"
    RUNTIME_FONT_FENCE_HANDLE="$(field_of production_gui_font_runtime_font_fence_handle "$RUNTIME_EVIDENCE_ENV")"
    RUNTIME_FONT_READBACK_CHECKSUM="$(field_of production_gui_font_runtime_font_readback_checksum "$RUNTIME_EVIDENCE_ENV")"
    RUNTIME_FONT_PARITY_STATUS="$(field_of production_gui_font_runtime_font_parity_status "$RUNTIME_EVIDENCE_ENV")"
    RUNTIME_FONT_SELECTED_BACKEND="$(field_of production_gui_font_runtime_selected_backend "$RUNTIME_EVIDENCE_ENV")"
fi

mkdir -p "$BUILD_DIR" "$(dirname -- "$REPORT_PATH")"
rm -f "$ENV_PATH" "$REPORT_PATH"

emit_unavailable() {
    reason="$1"
    {
        echo "production_gui_font_offload_status=unavailable"
        echo "production_gui_font_offload_reason=$reason"
        echo "production_gui_font_offload_simple_bin=$SIMPLE_BIN"
        echo "production_gui_font_offload_simple_bin_source=$SIMPLE_BIN_SOURCE"
        echo "production_gui_font_offload_simple_bin_status=$SIMPLE_BIN_STATUS"
        echo "production_gui_font_offload_runtime_evidence_env=$RUNTIME_EVIDENCE_ENV"
        echo "production_gui_font_offload_runtime_evidence_status=$RUNTIME_EVIDENCE_STATUS"
        echo "production_gui_font_offload_runtime_evidence_source=$RUNTIME_EVIDENCE_SOURCE"
        echo "production_gui_font_offload_runtime_evidence_producer_exit=$RUNTIME_EVIDENCE_PRODUCER_EXIT"
        echo "production_gui_font_offload_backend=$RUNTIME_FONT_BACKEND"
        echo "production_gui_font_offload_driver=$RUNTIME_FONT_DRIVER"
        echo "production_gui_font_offload_device_handle=$RUNTIME_FONT_DEVICE_HANDLE"
        echo "production_gui_font_offload_module_or_queue_handle=$RUNTIME_FONT_MODULE_OR_QUEUE_HANDLE"
        echo "production_gui_font_offload_kernel_or_pipeline_handle=$RUNTIME_FONT_KERNEL_OR_PIPELINE_HANDLE"
        echo "production_gui_font_offload_fence_handle=$RUNTIME_FONT_FENCE_HANDLE"
        echo "production_gui_font_offload_readback_checksum=$RUNTIME_FONT_READBACK_CHECKSUM"
        echo "production_gui_font_offload_parity_status=$RUNTIME_FONT_PARITY_STATUS"
        echo "production_gui_font_offload_vector_backend=$RUNTIME_FONT_BACKEND"
        echo "production_gui_font_offload_vector_status=unavailable"
        echo "production_gui_font_offload_vector_reason=$reason"
        echo "production_gui_font_offload_vector_readback_status=unavailable"
        echo "production_gui_font_offload_vector_readback_reason=$reason"
        echo "production_gui_font_offload_vector_production_ready=false"
        echo "production_gui_font_offload_vector_expected_checksum="
        echo "production_gui_font_offload_vector_actual_checksum="
        echo "production_gui_font_offload_bitmap_backend=$RUNTIME_FONT_BACKEND"
        echo "production_gui_font_offload_bitmap_status=unavailable"
        echo "production_gui_font_offload_bitmap_reason=$reason"
        echo "production_gui_font_offload_bitmap_readback_status=unavailable"
        echo "production_gui_font_offload_bitmap_readback_reason=$reason"
        echo "production_gui_font_offload_bitmap_production_ready=false"
        echo "production_gui_font_offload_bitmap_expected_checksum="
        echo "production_gui_font_offload_bitmap_actual_checksum="
        echo "production_gui_font_offload_report=$REPORT_PATH"
        echo "production_gui_font_offload_blocker_doc=$BLOCKER_DOC"
    } >"$ENV_PATH"
    {
        echo "# Production GUI Font Offload Evidence"
        echo
        echo "- status: unavailable"
        echo "- reason: $reason"
        echo "- blocker: $BLOCKER_DOC"
    } >"$REPORT_PATH"
    cat "$ENV_PATH"
}

if [ "$SIMPLE_BIN_STATUS" != "pass" ]; then
    emit_unavailable "simple-bin-$SIMPLE_BIN_STATUS"
    exit 1
fi

if [ "$RUNTIME_EVIDENCE_SOURCE" = "auto" ] \
    && [ "$RUNTIME_EVIDENCE_PRODUCER_EXIT" -ne 0 ]; then
    emit_unavailable "runtime-evidence-generator-failed"
    exit 1
fi

positive_int() {
    case "${1:-}" in
        ''|*[!0-9]*|0) return 1 ;;
        *) return 0 ;;
    esac
}

promoted_gpu_backend() {
    case "$1" in
        metal|cuda|opencl) return 0 ;;
        *) return 1 ;;
    esac
}

if [ "$RUNTIME_EVIDENCE_STATUS" != "pass" ] \
    || ! promoted_gpu_backend "$RUNTIME_FONT_BACKEND" \
    || [ "$RUNTIME_FONT_SELECTED_BACKEND" != "$RUNTIME_FONT_BACKEND" ] \
    || [ -z "$RUNTIME_FONT_BACKEND" ] \
    || [ -z "$RUNTIME_FONT_DRIVER" ] \
    || ! positive_int "$RUNTIME_FONT_DEVICE_HANDLE" \
    || ! positive_int "$RUNTIME_FONT_MODULE_OR_QUEUE_HANDLE" \
    || ! positive_int "$RUNTIME_FONT_KERNEL_OR_PIPELINE_HANDLE" \
    || ! positive_int "$RUNTIME_FONT_FENCE_HANDLE" \
    || ! positive_int "$RUNTIME_FONT_READBACK_CHECKSUM" \
    || [ "$RUNTIME_FONT_PARITY_STATUS" != "pass" ]; then
    emit_unavailable "runtime-font-provenance-missing"
    exit 1
fi

{
    echo "production_gui_font_offload_status=pass"
    echo "production_gui_font_offload_reason=runtime-font-readback-parity-proven"
    echo "production_gui_font_offload_simple_bin=$SIMPLE_BIN"
    echo "production_gui_font_offload_simple_bin_source=$SIMPLE_BIN_SOURCE"
    echo "production_gui_font_offload_simple_bin_status=$SIMPLE_BIN_STATUS"
    echo "production_gui_font_offload_runtime_evidence_env=$RUNTIME_EVIDENCE_ENV"
    echo "production_gui_font_offload_runtime_evidence_status=$RUNTIME_EVIDENCE_STATUS"
    echo "production_gui_font_offload_runtime_evidence_source=$RUNTIME_EVIDENCE_SOURCE"
    echo "production_gui_font_offload_runtime_evidence_producer_exit=$RUNTIME_EVIDENCE_PRODUCER_EXIT"
    echo "production_gui_font_offload_backend=$RUNTIME_FONT_BACKEND"
    echo "production_gui_font_offload_driver=$RUNTIME_FONT_DRIVER"
    echo "production_gui_font_offload_device_handle=$RUNTIME_FONT_DEVICE_HANDLE"
    echo "production_gui_font_offload_module_or_queue_handle=$RUNTIME_FONT_MODULE_OR_QUEUE_HANDLE"
    echo "production_gui_font_offload_kernel_or_pipeline_handle=$RUNTIME_FONT_KERNEL_OR_PIPELINE_HANDLE"
    echo "production_gui_font_offload_fence_handle=$RUNTIME_FONT_FENCE_HANDLE"
    echo "production_gui_font_offload_readback_checksum=$RUNTIME_FONT_READBACK_CHECKSUM"
    echo "production_gui_font_offload_parity_status=$RUNTIME_FONT_PARITY_STATUS"
    # Compatibility aliases: both consumers read this same authenticated font tuple.
    echo "production_gui_font_offload_vector_backend=$RUNTIME_FONT_BACKEND"
    echo "production_gui_font_offload_vector_status=runtime-provenance"
    echo "production_gui_font_offload_vector_reason=runtime-font-readback-parity-proven"
    echo "production_gui_font_offload_vector_readback_status=$RUNTIME_FONT_PARITY_STATUS"
    echo "production_gui_font_offload_vector_readback_reason=runtime-font-readback-parity-proven"
    echo "production_gui_font_offload_vector_production_ready=true"
    echo "production_gui_font_offload_vector_expected_checksum=$RUNTIME_FONT_READBACK_CHECKSUM"
    echo "production_gui_font_offload_vector_actual_checksum=$RUNTIME_FONT_READBACK_CHECKSUM"
    echo "production_gui_font_offload_bitmap_backend=$RUNTIME_FONT_BACKEND"
    echo "production_gui_font_offload_bitmap_status=runtime-provenance"
    echo "production_gui_font_offload_bitmap_reason=runtime-font-readback-parity-proven"
    echo "production_gui_font_offload_bitmap_readback_status=$RUNTIME_FONT_PARITY_STATUS"
    echo "production_gui_font_offload_bitmap_readback_reason=runtime-font-readback-parity-proven"
    echo "production_gui_font_offload_bitmap_production_ready=true"
    echo "production_gui_font_offload_bitmap_expected_checksum=$RUNTIME_FONT_READBACK_CHECKSUM"
    echo "production_gui_font_offload_bitmap_actual_checksum=$RUNTIME_FONT_READBACK_CHECKSUM"
    echo "production_gui_font_offload_report=$REPORT_PATH"
    echo "production_gui_font_offload_blocker_doc=$BLOCKER_DOC"
} >"$ENV_PATH"

{
    echo "# Production GUI Font Offload Evidence"
    echo
    echo "- status: pass"
    echo "- reason: runtime-font-readback-parity-proven"
    echo "- backend: $RUNTIME_FONT_BACKEND"
    echo "- driver: $RUNTIME_FONT_DRIVER"
    echo "- device handle: $RUNTIME_FONT_DEVICE_HANDLE"
    echo "- module or queue handle: $RUNTIME_FONT_MODULE_OR_QUEUE_HANDLE"
    echo "- kernel or pipeline handle: $RUNTIME_FONT_KERNEL_OR_PIPELINE_HANDLE"
    echo "- fence handle: $RUNTIME_FONT_FENCE_HANDLE"
    echo "- readback checksum: $RUNTIME_FONT_READBACK_CHECKSUM"
    echo "- parity status: $RUNTIME_FONT_PARITY_STATUS"
} >"$REPORT_PATH"

cat "$ENV_PATH"
