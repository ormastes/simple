#!/bin/sh
# Static contract gate for the scoped self-review authority and provider projection.
set -eu

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 2
cd "$root"
fail() { echo "check-self-review-policy: FAIL — $*" >&2; exit 1; }

bash -n scripts/release/self-review-changed-manifest.shs || fail "changed-path manifest producer does not parse"
test -f src/app/release/self_review_policy.spl || fail "pure-Simple evaluator is missing"
test -f scripts/release/self-review-policy-evaluator.mjs || fail "tracked hosted-runner evaluator adapter is missing"
test -f test/01_unit/app/release/self_review_policy_spec.spl || fail "focused evaluator spec is missing"
test -f test/01_unit/app/release/self_review_policy_evaluator_test.mjs || fail "focused adapter parity spec is missing"
test -f test/01_unit/app/release/self_review_changed_manifest_test.mjs || fail "focused manifest producer regression is missing"
test -f .spipe/policy/self-review-policy.sdn || fail "checked-in policy projection is missing"

if find .spipe -type f -name '*self-review*.jsonl' -print | grep . >/dev/null; then
  fail "operator-owned JSONL policy database must not be committed in the PR worktree"
fi

for token in \
  'schema: spipe-self-review-policy-projection/1' \
  'authority: operator_owned_external' \
  'source: SPIPE_SELF_REVIEW_POLICY_DB' \
  'checked_in_grants: forbidden' \
  'default_allow: true' \
  'deny_precedence: true' \
  'constrain_intersection: true' \
  'actual_credential_or_secret_blob: deny' \
  'policy_workflow_and_source_text: reviewable'; do
  rg -Fq "$token" .spipe/policy/self-review-policy.sdn || fail "missing policy projection token: $token"
done

for token in \
  'spipe-self-review-request/1' \
  'spipe-self-review-decision/1' \
  'operator policy explicitly denies' \
  'operator constraint deny scope matched' \
  'operator constraint does not allow every changed path' \
  'provider_approval_claimed: false'; do
  rg -Fq "$token" scripts/release/self-review-policy-evaluator.mjs ||
    fail "tracked adapter contract is missing: $token"
done
node --test test/01_unit/app/release/self_review_policy_evaluator_test.mjs >/dev/null ||
  fail "tracked adapter parity/adversarial tests failed"
node --test test/01_unit/app/release/self_review_changed_manifest_test.mjs >/dev/null ||
  fail "changed-path manifest producer regression failed"

for scope in code text file directory_files directory_recursive; do
  rg -q "^[[:space:]]+- $scope$" .spipe/policy/self-review-policy.sdn ||
    fail "missing exact self-review scope: $scope"
done

for token in \
  'spipe-self-review-policy-db/1' \
  'spipe-self-review-policy-db/grant/1' \
  'spipe-changed-path-manifest/1' \
  'spipe-self-review-decision/1' \
  'operator_owned_external' \
  'submit_through_separate_eligible_broker_identity' \
  'review_evidence_mode == "self_attested"' \
  'self_review_decision_current' \
  'provider_approval_claimed: false'; do
  rg -Fq "$token" src/app/release/self_review_policy.spl || fail "Simple evaluator contract is missing: $token"
done

for token in \
  'change.status == "renamed"' \
  'change.status == "deleted"' \
  'change.status == "copied"' \
  'file_type != "regular"' \
  'encoding != "utf8"' \
  '_restricted_name(path)' \
  'record.effect == "deny"' \
  '_constraint_covers_manifest'; do
  rg -Fq "$token" src/app/release/self_review_policy.spl || fail "fail-closed evaluator branch is missing: $token"
done

required='[{"context":"Code Idiom & Structural Ratchet Gates","integration_id":15368},{"context":"SPipe Self Review Admission","integration_id":15368}]'
for profile in main release-lines; do
  jq -e --argjson required "$required" '
    ([.rules[] | select(.type == "pull_request")][0].parameters |
      .required_approving_review_count == 0 and
      .require_code_owner_review == false and
      .require_last_push_approval == false) and
    ([.rules[] | select(.type == "required_status_checks")][0].parameters.required_status_checks == $required)
  ' ".github/rulesets/spipe-vcs-v3-$profile.json" >/dev/null ||
    fail "$profile does not replace provider approval with the exact self-review check"
done

workflow=.github/workflows/review-admission.yml
for token in \
  'checks: write' \
  'name: SPipe Self Review Admission' \
  'self_attestation:' \
  'expected_head_sha:' \
  'test "$head_sha" = "$EXPECTED_HEAD_SHA"' \
  'review_evidence_mode:"self_attested"' \
  'self_attestation_authorized:true' \
  'SPIPE_SELF_REVIEW_POLICY_DB' \
  'node scripts/release/self-review-policy-evaluator.mjs' \
  'spipe-self-review-request/1' \
  'refs/pull/$PR_NUMBER/head' \
  'git fetch --no-tags --no-recurse-submodules' \
  'sync the PR branch, review its new exact head, and dispatch again' \
  'merge_base_sha=$(git merge-base' \
  'target_ruleset_id=$(resolve_ruleset)' \
  'target_ruleset_sha256=$(jq -Sc' \
  'target_ruleset_version "$expected_ruleset"' \
  'target_ruleset_sha256 "$request_ruleset_sha256"' \
  'strict_required_status_checks_policy == true' \
  'external_id="spipe-self-review/1|' \
  'pull_request_target:' \
  'types: [synchronize, edited, closed, reopened]' \
  'repository_dispatch:' \
  'types: [self_review_policy_changed, self_review_ruleset_changed]' \
  'conclusion:"action_required"' \
  'current-decision.json' \
  '.allowed == false and (.reason | type == "string" and length > 0)' \
  'WORKFLOW_REF' \
  'environment: self-review-admission' \
  'permissions:' \
  'contents: read' \
  'repos/$GITHUB_REPOSITORY/check-runs' \
  'provider_approval_claimed == false'; do
  rg -Fq "$token" "$workflow" || fail "exact-head workflow contract is missing: $token"
done
rg -Fq 'admission.admission_receipt_schema != "spipe-review-admission/1"' src/app/release/policy.spl ||
  fail "candidate admission does not reject self-review decisions"
if rg -q '^[[:space:]]{6}(head_sha|candidate_commit_sha):' "$workflow"; then
  fail "workflow dispatch accepts an authoritative caller-controlled head instead of an expected review binding"
fi

for token in \
  'git diff --name-status -z --find-renames --find-copies' \
  'git diff --raw -z --find-renames --find-copies "$merge_base_sha"' \
  'git cat-file blob "$revision:$path"' \
  "120000) printf 'symlink'" \
  "160000) printf 'submodule'" \
  'encoding=non_utf8' \
  'semantic=credential_secret' \
  'status=renamed' \
  'status=deleted' \
  'status=copied'; do
  rg -Fq "$token" scripts/release/self-review-changed-manifest.shs ||
    fail "provider manifest producer is missing: $token"
done
if rg -q 'git show[[:space:]]+"\$revision:\$path"' scripts/release/self-review-changed-manifest.shs; then
  fail "provider manifest producer uses porcelain blob reads that parse historical submodule configuration"
fi

sh scripts/check/check-self-review-guidance.shs

echo "check-self-review-policy: PASS — explicit self-attestation, exact protected target/head/base/diff, alias denial, expiry reset, and non-approval projection"
