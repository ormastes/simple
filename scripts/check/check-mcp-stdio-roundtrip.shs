#!/bin/sh
# check-mcp-stdio-roundtrip.shs — Simple MCP server stdio regression gate.
#
# Guards the 2026-09-12 defect: 8 of 19 tools segfaulted (rc=139) inside
# `handle_cli_passthrough_direct` -> `tooling_child_environment`, so the
# client saw the stdio pipe close instead of a response. See
# doc/08_tracking/bug/seed_result_err_shorthand_closure_segv_2026-09-12.md
#
# Three assertions, all over a HELD-OPEN stdin pipe. This shape matters: a
# file-with-EOF driver passes even with the bug present, because the server
# only has to answer before it exits. A real client keeps stdin open.
#   1. the first response line arrives within FIRST_LINE_BUDGET_S
#      (a hang fails instead of wedging the caller)
#   2. tools/list returns exactly EXPECTED_DEFAULT_TOOLS tools
#   3. a representative passthrough request (simple_tree, the exact call that
#      crashed) gets a reply carrying its id, and the server does not die
#
# Exit codes are read DIRECTLY into a variable on the line after the command,
# never through a pipe — a pipeline's $? is the last stage's status and has
# produced false greens in this repo.
#
# Verdict convention (last stdout line):
#   PASS — <n> assertion(s) checked      exit 0
#   FAIL — <reason>                      exit 1
#   ERROR — nothing was checked          exit 2
#
# Usage:
#   sh scripts/check/check-mcp-stdio-roundtrip.shs            # run the gate
#   sh scripts/check/check-mcp-stdio-roundtrip.shs --selftest # fixtures, fatal

set -u

EXPECTED_DEFAULT_TOOLS=19
FIRST_LINE_BUDGET_S=30
SERVER_BUDGET_S=90

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT" || { echo "ERROR — nothing was checked (cannot cd to repo root)"; exit 2; }

ENTRY="src/app/mcp/main.spl"
WORK=""
cleanup() { [ -n "$WORK" ] && rm -rf "$WORK"; }
trap cleanup EXIT

fail() { echo "FAIL — $1"; exit 1; }
oops() { echo "ERROR — nothing was checked ($1)"; exit 2; }

# ---------------------------------------------------------------- selftest --
# Proves the driver discriminates: a fake server that answers is accepted, a
# fake that exits without answering (the incident's shape) is rejected, and a
# fake that never answers is caught by the time budget rather than hanging.
selftest() {
    st_work=$(mktemp -d) || return 1
    st_fail=0

    # fixture 1: answers both requests, then stays alive -> must be accepted
    cat > "$st_work/good.sh" <<'GOOD'
#!/bin/sh
while IFS= read -r line; do
  case "$line" in
    *'"initialize"'*) printf '{"jsonrpc":"2.0","id":1,"result":{"serverInfo":{}}}\n' ;;
    *'"tools/list"'*) printf '{"jsonrpc":"2.0","id":2,"result":{"tools":[]}}\n' ;;
  esac
done
GOOD
    chmod +x "$st_work/good.sh"
    st_out="$st_work/good.out"
    ( printf '{"method":"initialize"}\n{"method":"tools/list"}\n'; sleep 3 ) \
        | timeout 20 sh "$st_work/good.sh" > "$st_out" 2>/dev/null
    st_rc=$?
    if [ "$st_rc" -eq 139 ] || [ ! -s "$st_out" ]; then
        echo "selftest: good fixture was not accepted (rc=$st_rc)" >&2
        st_fail=1
    fi

    # fixture 2: dies on the second request without answering -> must be rejected
    cat > "$st_work/crash.sh" <<'CRASH'
#!/bin/sh
IFS= read -r line
printf '{"jsonrpc":"2.0","id":1,"result":{"serverInfo":{}}}\n'
exit 139
CRASH
    chmod +x "$st_work/crash.sh"
    st_out2="$st_work/crash.out"
    ( printf '{"method":"initialize"}\n{"method":"tools/list"}\n'; sleep 3 ) \
        | timeout 20 sh "$st_work/crash.sh" > "$st_out2" 2>/dev/null
    if grep -q '"id":2' "$st_out2" 2>/dev/null; then
        echo "selftest: crash fixture wrongly produced a second reply" >&2
        st_fail=1
    fi

    # fixture 3: never answers -> the time budget must cut it off, not hang
    cat > "$st_work/hang.sh" <<'HANG'
#!/bin/sh
sleep 600
HANG
    chmod +x "$st_work/hang.sh"
    st_start=$(date +%s)
    ( printf '{"method":"initialize"}\n'; sleep 3 ) \
        | timeout 8 sh "$st_work/hang.sh" > "$st_work/hang.out" 2>/dev/null
    st_elapsed=$(( $(date +%s) - st_start ))
    if [ "$st_elapsed" -ge 30 ]; then
        echo "selftest: hang fixture was not bounded (${st_elapsed}s)" >&2
        st_fail=1
    fi

    rm -rf "$st_work"
    return $st_fail
}

if ! selftest; then
    echo "ERROR — nothing was checked (selftest failed)"
    exit 2
fi
if [ "${1:-}" = "--selftest" ]; then
    echo "PASS — 3 selftest fixture(s) checked"
    exit 0
fi

# ------------------------------------------------------------------- setup --
BIN="${SIMPLE_BINARY:-}"
if [ -z "$BIN" ]; then
    for cand in bin/simple bin/simple.exe; do
        [ -x "$cand" ] && { BIN="$cand"; break; }
    done
fi
[ -n "$BIN" ] || oops "no simple binary found (set SIMPLE_BINARY)"
[ -f "$ENTRY" ] || oops "MCP entry missing: $ENTRY"
command -v node >/dev/null 2>&1 || oops "node is required to parse the tools/list response"

WORK=$(mktemp -d) || oops "cannot create work dir"
REQ="$WORK/req.jsonl"
OUT="$WORK/out.jsonl"

{
  printf '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"stdio-gate","version":"1"}}}\n'
  printf '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}\n'
  printf '{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"simple_tree","arguments":{}}}\n'
} > "$REQ"

checked=0

# -------------------------------------------- 1: first line under the budget --
# stdin is held open past the requests, so the server must flush per message.
# The writer polls OUT and closes stdin as soon as the last reply lands, so
# ELAPSED measures when the server actually answered. A server that buffers
# every response until stdin EOF (the "stdout never flushed" failure mode)
# cannot beat the budget this way, whereas a fixed `sleep` would let it pass.
# The server stays LAST in the pipeline so SERVER_RC is its own status.
export SIMPLE_MCP_TOOL_SET=core   # the shipped .cmd exports `all` (195 tools);
                                  # an inherited value would flip the count.
START=$(date +%s)
(
  cat "$REQ"
  i=0
  while [ "$i" -lt "$FIRST_LINE_BUDGET_S" ] && ! grep -q '"id":3' "$OUT" 2>/dev/null; do
      sleep 1
      i=$((i+1))
  done
) | timeout "$SERVER_BUDGET_S" "$BIN" run "$ENTRY" > "$OUT" 2>"$WORK/err.txt"
SERVER_RC=$?
ELAPSED=$(( $(date +%s) - START ))

if [ "$SERVER_RC" -eq 139 ]; then
    fail "server segfaulted (rc=139) — the passthrough crash has regressed; see doc/08_tracking/bug/seed_result_err_shorthand_closure_segv_2026-09-12.md"
fi
if [ "$SERVER_RC" -eq 124 ]; then
    fail "server did not finish within ${SERVER_BUDGET_S}s (rc=124)"
fi
[ -s "$OUT" ] || fail "server produced no output at all (rc=$SERVER_RC)"
if [ "$ELAPSED" -ge "$FIRST_LINE_BUDGET_S" ]; then
    fail "responses did not arrive within ${FIRST_LINE_BUDGET_S}s (took ${ELAPSED}s) — the server is buffering until stdin EOF or blocking per request"
fi
checked=$((checked+1))

# ------------------------------------------------ 2: tools/list count is exact --
COUNT=$(node -e '
const fs=require("fs");
let n=-1;
for(const l of fs.readFileSync(process.argv[1],"utf8").split("\n")){
  if(!l.startsWith("{"))continue;
  let m; try{m=JSON.parse(l)}catch(e){continue}
  if(m.id===2&&m.result&&Array.isArray(m.result.tools))n=m.result.tools.length;
}
console.log(n);
' "$OUT" 2>/dev/null)
NODE_RC=$?
[ "$NODE_RC" -eq 0 ] || fail "could not parse the tools/list response"
[ "$COUNT" = "-1" ] && fail "no tools/list result (id=2) in the response stream"
if [ "$COUNT" != "$EXPECTED_DEFAULT_TOOLS" ]; then
    fail "tools/list returned $COUNT tools, expected $EXPECTED_DEFAULT_TOOLS (update EXPECTED_DEFAULT_TOOLS only with a deliberate, reviewed inventory change)"
fi
checked=$((checked+1))

# ------------------------------- 3: representative passthrough call replies --
grep -q '"id":3' "$OUT" \
    || fail "simple_tree (id=3) never replied — a passthrough tool is crashing or hanging again"
checked=$((checked+1))

[ "$checked" -eq 0 ] && oops "no assertion ran"
echo "PASS — $checked assertion(s) checked, ${COUNT} tools listed, simple_tree replied, server rc=$SERVER_RC in ${ELAPSED}s"
exit 0
