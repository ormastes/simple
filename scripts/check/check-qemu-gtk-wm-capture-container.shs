#!/bin/sh
# Canonical container/QEMU entrypoint for live Vulkan-backed WM evidence.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
build_dir=${BUILD_DIR:-$root/build/qemu-gtk-wm-capture-container}
report=${REPORT_PATH:-$root/doc/09_report/qemu_gtk_wm_capture_container_$(date -u +%F).md}
qmp_socket=${SIMPLEOS_DESKTOP_QMP_SOCKET:-$build_dir/simpleos-wm-qmp.sock}
serial_log=${SIMPLEOS_DESKTOP_QMP_SERIAL_LOG:-$build_dir/simpleos-wm-serial.log}

[ -n "${SIMPLE_BIN:-}" ] || { echo 'qemu_gtk_wm_capture_container_status=blocked'; echo 'qemu_gtk_wm_capture_container_reason=missing-admitted-simple-bin'; exit 1; }
mkdir -p "$build_dir"

HEADLESS_QEMU_VIRGL_IMAGE="${HEADLESS_QEMU_VIRGL_IMAGE:-simple-qemu-virgl-headless:8.2.2-ubuntu24.04}" \
HEADLESS_QEMU_RENDER_NODE="${HEADLESS_QEMU_RENDER_NODE:-/dev/dri/renderD128}" \
    sh "$root/scripts/check/check-headless-qemu-virgl-container.shs" >"$build_dir/container-capability.env"

exec env \
    BUILD_DIR="$build_dir" REPORT_PATH="$report" \
    QEMU_AUTO_LAUNCH_SIMPLEOS_DESKTOP=1 \
    SIMPLEOS_DESKTOP_QMP_TARGET=wm-simple-web \
    SIMPLEOS_DESKTOP_QMP_KEEPALIVE=1 \
    SIMPLEOS_DESKTOP_QMP_VIRGL=1 \
    SIMPLEOS_DESKTOP_QMP_QEMU_SYSTEM="$root/scripts/tool/qemu-system-x86_64-virgl-container.shs" \
    SIMPLEOS_DESKTOP_QMP_SOCKET="$qmp_socket" \
    SIMPLEOS_DESKTOP_QMP_SERIAL_LOG="$serial_log" \
    sh "$root/scripts/check/check-qemu-gtk-wm-capture-evidence.shs"
