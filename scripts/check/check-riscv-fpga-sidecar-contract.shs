#!/usr/bin/env sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
. "$ROOT_DIR/scripts/lib/simple-compiler-select.shs"
BUILD_ROOT="${BUILD_ROOT:-$ROOT_DIR/build/riscv_fpga_sidecar_contract}"
RVFI_REQUIRED="${REQUIRE_RVFI:-0}"

is_rust_seed_simple() {
    # Identity probe, not just a path pattern (2026-07-28).
    # This used to test ONLY for a src/compiler_rust/ path. The deployed Rust
    # seed lives at bin/release/<triple>/simple, which matches none of those
    # patterns, so the seed was classified "not a seed" and every self-hosted
    # claim in this script was asserted against it. Ask the binary instead.
    # Audit: doc/08_tracking/todo/check_scripts_seed_identity_fail_open_2026-07-28.md
    case "$1" in
        src/compiler_rust/*|./src/compiler_rust/*|*/src/compiler_rust/*) return 0 ;;
    esac
    # Not runnable: leave it to the caller's own missing-binary branch, which
    # already fails. Do not report "seed" for something we never ran.
    [ -n "${1:-}" ] && [ -x "$1" ] || return 1
    # Executable but unverifiable => treat as forbidden (fail closed). The seed
    # self-identifies on stderr, so 2>&1 is required.
    if command -v timeout >/dev/null 2>&1; then
        _irss_v="$(timeout 10 "$1" --version 2>&1)" || return 0
    else
        _irss_v="$("$1" --version 2>&1)" || return 0
    fi
    [ -n "$_irss_v" ] || return 0
    case "$_irss_v" in
        *"bootstrap seed only"*|*"Rust-built"*|*"debug build"*) return 0 ;;
    esac
    return 1
}

if [ "${1:-}" = "--self-test" ]; then
    # HERMETIC. Every fixture is synthesised in a temp dir.
    #
    # The previous self-test used the REAL `bin/release/simple` as its
    # known-not-a-seed fixture. That made the verdict depend on build state, not
    # on the classifier: on 2026-08-06 this working copy's `bin/release/simple`
    # was a wrapper that exits nonzero with "refusing non-production Simple
    # runtime", so is_rust_seed_simple took its fail-closed branch (line 25:
    # `|| return 0`), classified it as a seed, and the self-test went RED.
    #
    # It reported `STATUS: FAIL riscv-fpga-sidecar-contract self-test`, which
    # reads as "the classifier is broken". The classifier was correct; the
    # fixture was not hermetic. Three gates
    # (check-riscv-formal-dual-track.shs, check-simpleos-byl-sby-artifacts.shs,
    # check-riscv-rtl-sby-proof.shs) call this self-test and all three inherited
    # the misleading verdict.
    #
    # A self-test proves the CLASSIFIER. Whether a usable self-hosted binary is
    # deployed is a separate precondition, and the main path below still checks
    # it and still fails loudly when it is absent.
    st_dir="$(mktemp -d)" || exit 2
    trap 'rm -rf "$st_dir"' EXIT
    st_fail=0
    st_checked=0

    st_bin() { # <name> <exit-code> <version-text>
        mkdir -p "$st_dir/bin"
        {
            echo '#!/bin/sh'
            printf 'printf %s%s%s\n' "'" "$3" "'"
            echo "exit $2"
        } > "$st_dir/bin/$1"
        chmod +x "$st_dir/bin/$1"
        printf '%s\n' "$st_dir/bin/$1"
    }

    st_assert() { # <desc> <seed|notseed> <path>
        st_checked=$((st_checked + 1))
        if is_rust_seed_simple "$3"; then _got=seed; else _got=notseed; fi
        if [ "$_got" != "$2" ]; then
            echo "SELFTEST FAILED: $1 (expected $2, got $_got)" >&2
            st_fail=1
        fi
    }

    # Path-shape rule: a compiler_rust path is a seed regardless of existence.
    st_assert "compiler_rust path is a seed" seed \
        "$st_dir/src/compiler_rust/fake/simple"
    # Not runnable and not a compiler_rust path: NOT reported as a seed, because
    # we never ran it. The caller's own missing-binary branch handles it.
    st_assert "absent non-seed path is not reported as a seed" notseed \
        "$st_dir/does/not/exist/simple"
    # Identity probe, both polarities.
    st_assert "production version string is not a seed" notseed \
        "$(st_bin production 0 'Simple 0.1.0 (self-hosted, production)')"
    st_assert "bootstrap-seed banner is a seed" seed \
        "$(st_bin seedbanner 0 'simple 0.1.0 bootstrap seed only')"
    st_assert "Rust-built banner is a seed" seed \
        "$(st_bin rustbuilt 0 'simple (Rust-built)')"
    st_assert "debug-build banner is a seed" seed \
        "$(st_bin debugbuild 0 'simple 0.1.0 debug build')"
    # Fail-closed branches: unverifiable means forbidden, never "trusted".
    st_assert "nonzero --version is fail-closed to seed" seed \
        "$(st_bin refuses 1 'error: refusing non-production Simple runtime')"
    st_assert "empty --version is fail-closed to seed" seed \
        "$(st_bin silent 0 '')"

    if [ "$st_checked" -lt 8 ]; then
        echo "STATUS: ERROR riscv-fpga-sidecar-contract self-test — nothing was checked:" \
             "only $st_checked fixture(s) ran (expected >= 8)" >&2
        exit 2
    fi
    if [ "$st_fail" -ne 0 ]; then
        echo "STATUS: FAIL riscv-fpga-sidecar-contract self-test — $st_checked fixture(s) checked" >&2
        exit 1
    fi
    echo "STATUS: PASS riscv-fpga-sidecar-contract self-test — $st_checked fixture(s) checked"
    exit 0
fi

if [ "${SIMPLE_BIN:-}" = "" ]; then
    # Was a first-match-wins loop that accepted on bare `-x` (fail-open: takes
    # the first executable, including a seed or a cross-target payload). Now
    # delegates to the shared positive-capability probe.
    SIMPLE_BIN="$(simple_compiler_select --root "$ROOT_DIR" --quiet 2>/dev/null || true)"
fi
SIMPLE_BIN="${SIMPLE_BIN:-$ROOT_DIR/bin/simple}"
if [ ! -x "$SIMPLE_BIN" ]; then
    echo "FAIL: missing Simple runner: $SIMPLE_BIN" >&2
    exit 1
fi
if is_rust_seed_simple "$SIMPLE_BIN"; then
    echo "FAIL: RISC-V formal sidecar gate must use self-hosted Simple, not Rust seed: $SIMPLE_BIN" >&2
    exit 1
fi

check_contains() {
    file="$1"
    needle="$2"
    if ! grep -Fq "$needle" "$file"; then
        echo "FAIL: $file missing $needle" >&2
        return 1
    fi
}

check_absent() {
    file="$1"
    needle="$2"
    if grep -Fq "$needle" "$file"; then
        echo "FAIL: $file unexpectedly contains $needle" >&2
        return 1
    fi
}

check_bundle() {
    dir="$1"
    board="$2"
    rv32="$dir/rv32/rtl/simple_rv32gc_core.debug.json"
    rv64="$dir/rv64/rtl/simple_rv64gc_core.debug.json"
    rv32_vhdl="$dir/rv32/rtl/simple_rv32gc_core.vhd"
    rv64_vhdl="$dir/rv64/rtl/simple_rv64gc_core.vhd"
    rv32_formal="$dir/rv32/rtl/simple_rv32gc_core_formal.vhd"
    rv64_formal="$dir/rv64/rtl/simple_rv64gc_core_formal.vhd"
    rv32_sby="$dir/rv32/rtl/simple_rv32gc_core.sby"
    rv64_sby="$dir/rv64/rtl/simple_rv64gc_core.sby"
    rv32_formal_manifest="$dir/rv32/rtl/simple_rv32gc_core_formal.sdn"
    rv64_formal_manifest="$dir/rv64/rtl/simple_rv64gc_core_formal.sdn"
    manifest="$dir/manifest.sdn"
    if [ ! -f "$manifest" ]; then
        manifest="$dir/riscv_fpga_rtl_manifest.sdn"
    fi
    product_byl="$dir/riscv_product.byl"

    test -f "$rv32" || { echo "FAIL: missing $rv32" >&2; return 1; }
    test -f "$rv64" || { echo "FAIL: missing $rv64" >&2; return 1; }
    test -f "$rv32_vhdl" || { echo "FAIL: missing $rv32_vhdl" >&2; return 1; }
    test -f "$rv64_vhdl" || { echo "FAIL: missing $rv64_vhdl" >&2; return 1; }
    test -f "$rv32_formal" || { echo "FAIL: missing $rv32_formal" >&2; return 1; }
    test -f "$rv64_formal" || { echo "FAIL: missing $rv64_formal" >&2; return 1; }
    test -f "$rv32_sby" || { echo "FAIL: missing $rv32_sby" >&2; return 1; }
    test -f "$rv64_sby" || { echo "FAIL: missing $rv64_sby" >&2; return 1; }
    test -f "$rv32_formal_manifest" || { echo "FAIL: missing $rv32_formal_manifest" >&2; return 1; }
    test -f "$rv64_formal_manifest" || { echo "FAIL: missing $rv64_formal_manifest" >&2; return 1; }
    test -f "$manifest" || { echo "FAIL: missing $manifest" >&2; return 1; }
    test -f "$product_byl" || { echo "FAIL: missing $product_byl" >&2; return 1; }

    check_contains "$manifest" "board = \"$board\""
    check_contains "$manifest" "product_level = \"linux-rtl\""
    check_contains "$manifest" "configuration_profile = \"qemu-virt+fpga-board\""
    # Honest post-truth-campaign values (2026-07-28): the generated VHDL is a
    # placeholder (GENERATED_RTL_NOT_IMPLEMENTED), so the generator reports
    # formal_gate = "placeholder-rejected" / readiness = "contract-not-ready".
    # The designated formal track is named separately as flow = "rvfi+sby".
    # Fail closed: any artifact claiming "rvfi-ready" or a passing formal gate
    # while the RTL is a placeholder is fabricated evidence and must FAIL.
    check_contains "$manifest" "formal_gate = \"placeholder-rejected\""
    check_absent "$manifest" "formal_gate = \"rvfi_port_manifest\""
    check_contains "$product_byl" "schema = \"simple.riscv_product\""
    check_contains "$product_byl" "lane rv32"
    check_contains "$product_byl" "lane rv64"
    check_contains "$product_byl" "formal_flow = \"rvfi+sby\""
    check_contains "$product_byl" "formal_gate = \"placeholder-rejected\""

    check_contains "$rv32" "\"productLevel\": \"linux-rtl\""
    check_contains "$rv32" "\"configurationProfile\": \"qemu-virt+fpga-board\""
    check_contains "$rv32" "\"rtlBudget\": {\"maxLuts\": 25000, \"targetMhz\": 50}"
    check_contains "$rv32" "\"readiness\": \"contract-not-ready\""
    check_contains "$rv32" "\"formal\": {\"flow\": \"rvfi+sby\", \"gate\": \"placeholder-rejected\", \"status\": \"contract-not-ready\""
    check_absent "$rv32" "rvfi-ready"
    check_contains "$rv32" "\"observedRvfiPortCount\": 0"
    check_contains "$rv32" "\"harness\": \"$dir/rv32/rtl/simple_rv32gc_core_formal.vhd\""
    check_contains "$rv32" "\"sby\": \"$dir/rv32/rtl/simple_rv32gc_core.sby\""
    check_contains "$rv32" "\"manifest\": \"$dir/rv32/rtl/simple_rv32gc_core_formal.sdn\""
    check_contains "$rv32" "\"sourceMap\": []"
    check_contains "$rv32" "tb_generated_rv32_linux_handoff.vhd"
    check_contains "$rv32" "\"reportMarkers\": [\"GENERATED_RTL_NOT_IMPLEMENTED\"]"
    CORE_VHDL="$rv32_vhdl" FORMAL_HARNESS="$rv32_formal" FORMAL_SBY="$rv32_sby" FORMAL_MANIFEST="$rv32_formal_manifest" REQUIRE_RVFI="$RVFI_REQUIRED" sh "$ROOT_DIR/scripts/rtl/check-rvfi-formal-readiness.shs" >/dev/null

    check_contains "$rv64" "\"productLevel\": \"linux-rtl\""
    check_contains "$rv64" "\"configurationProfile\": \"qemu-virt+fpga-board\""
    check_contains "$rv64" "\"rtlBudget\": {\"maxLuts\": 45000, \"targetMhz\": 50}"
    check_contains "$rv64" "\"readiness\": \"contract-not-ready\""
    check_contains "$rv64" "\"formal\": {\"flow\": \"rvfi+sby\", \"gate\": \"placeholder-rejected\", \"status\": \"contract-not-ready\""
    check_absent "$rv64" "rvfi-ready"
    check_contains "$rv64" "\"observedRvfiPortCount\": 0"
    check_contains "$rv64" "\"harness\": \"$dir/rv64/rtl/simple_rv64gc_core_formal.vhd\""
    check_contains "$rv64" "\"sby\": \"$dir/rv64/rtl/simple_rv64gc_core.sby\""
    check_contains "$rv64" "\"manifest\": \"$dir/rv64/rtl/simple_rv64gc_core_formal.sdn\""
    check_contains "$rv64" "\"sourceMap\": []"
    check_contains "$rv64" "\"reportMarkers\": [\"GENERATED_RTL_NOT_IMPLEMENTED\"]"
    CORE_VHDL="$rv64_vhdl" FORMAL_HARNESS="$rv64_formal" FORMAL_SBY="$rv64_sby" FORMAL_MANIFEST="$rv64_formal_manifest" REQUIRE_RVFI="$RVFI_REQUIRED" sh "$ROOT_DIR/scripts/rtl/check-rvfi-formal-readiness.shs" >/dev/null
}

rm -rf "$BUILD_ROOT"
mkdir -p "$BUILD_ROOT"

# The two generator invocations used to be bare commands with stdout sent to
# /dev/null under `set -e`. When the generator failed, this script died at that
# line having printed NOTHING AT ALL and exit 1 -- no verdict, no reason, not
# even the failing command. Observed 2026-08-06: `simple run
# generate_riscv_fpga_bundle.spl` exits nonzero with empty stderr, and the gate
# was indistinguishable from a crash. Report which step failed and with what.
generate_bundle() { # <out-dir> <extra-arg...>
    _gb_out="$1"
    shift
    # `if ! cmd` would make $? the negation's status (always 0), not the
    # command's; the else-branch form preserves the real exit code.
    if "$SIMPLE_BIN" run \
        "$ROOT_DIR/src/hardware/fpga_linux/generate_riscv_fpga_bundle.spl" \
        "$_gb_out" "$@" >"$BUILD_ROOT/generate.out" 2>"$BUILD_ROOT/generate.err"; then
        :
    else
        _gb_rc=$?
        echo "STATUS: FAIL riscv-fpga-sidecar-contract reason=bundle-generation-failed" \
             "out=$_gb_out exit=$_gb_rc compiler=$SIMPLE_BIN" >&2
        echo "-- generator stderr --" >&2
        tail -20 "$BUILD_ROOT/generate.err" >&2 || :
        echo "-- generator stdout --" >&2
        tail -20 "$BUILD_ROOT/generate.out" >&2 || :
        exit 1
    fi
}

generate_bundle "$BUILD_ROOT/default"
generate_bundle "$BUILD_ROOT/mlk" --board=mlk_s02_100t

BUNDLES_CHECKED=0
check_bundle "$BUILD_ROOT/default" "xilinx_generic"
BUNDLES_CHECKED=$((BUNDLES_CHECKED + 1))
check_bundle "$BUILD_ROOT/mlk" "mlk_s02_100t"
BUNDLES_CHECKED=$((BUNDLES_CHECKED + 1))

# Vacuity floor: both board bundles must have been walked. Two is the whole
# population here, so this is an exact count, not a heuristic.
if [ "$BUNDLES_CHECKED" -lt 2 ]; then
    echo "STATUS: ERROR riscv-fpga-sidecar-contract — nothing was checked: only" \
         "$BUNDLES_CHECKED of 2 board bundle(s) walked" >&2
    exit 2
fi
echo "STATUS: PASS riscv-fpga-sidecar-contract — $BUNDLES_CHECKED board bundle(s) checked" \
     "(xilinx_generic, mlk_s02_100t), compiler=$SIMPLE_BIN"
