#!/bin/sh
# Bootstrap-tier mandatory checks and deterministic textual SDN evidence writer.
set -u

ROOT=${MUST_CHECK_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}
MANIFEST=${MUST_CHECK_MANIFEST:-$ROOT/config/check/must_check_gates.sdn}
LEDGER=${MUST_CHECK_LEDGER:-$ROOT/doc/08_tracking/check/must_check_db.sdn}
MODE=run
[ "${1:-}" = --record-bootstrap-success ] && MODE=record-bootstrap
[ "${1:-}" = --self-test ] && MODE=selftest
RECORD_GATE_ID=""
RECORD_GATE_EVIDENCE=""
OUTPUT_DIR=build/bootstrap
STAGE4_BINARY=""
STAGE4_PROVENANCE=""
AUTOMATED_SIMPLE_BINARY=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --record-bootstrap-success|--self-test) shift ;;
        --record-gate-pass) MODE=record-gate; RECORD_GATE_ID=$2; shift 2 ;;
        --evidence) RECORD_GATE_EVIDENCE=$2; shift 2 ;;
        --output-dir) OUTPUT_DIR=$2; shift 2 ;;
        --stage4-binary) STAGE4_BINARY=$2; shift 2 ;;
        --stage4-provenance) STAGE4_PROVENANCE=$2; shift 2 ;;
        *) echo "bootstrap-must-check: ERROR — unknown argument $1" >&2; exit 2 ;;
    esac
done

fingerprint_head() {
    _tree=$(mktemp) || return 1
    git -C "$ROOT" ls-tree -r HEAD -- src scripts config test rules.sdl doc/07_guide doc/00_llm_process doc/glossary.md >"$_tree" 2>/dev/null || { rm -f "$_tree"; return 1; }
    sed '\|[[:space:]]doc/08_tracking/check/must_check_db.sdn$|d' "$_tree" | sha256sum | awk '{print $1}'
    _rc=$?
    rm -f "$_tree"
    return "$_rc"
}

hash_file() {
    sha256sum -- "$1" 2>/dev/null | awk '{print $1}'
}

head_blob_metadata() {
    _path=$1
    case "$_path" in ''|/*|..|../*|*/../*|*/..) return 1 ;; esac
    _entry=$(git -C "$ROOT" ls-tree HEAD -- "$_path" 2>/dev/null) || return 1
    [ "$(printf '%s\n' "$_entry" | wc -l | tr -d ' ')" -eq 1 ] || return 1
    _mode=$(printf '%s\n' "$_entry" | awk '{print $1}')
    case "$_mode" in 100644|100755) ;; *) return 1 ;; esac
    HEAD_BLOB_SIZE=$(git -C "$ROOT" cat-file -s "HEAD:$_path" 2>/dev/null) || return 1
    HEAD_BLOB_SHA=$(git -C "$ROOT" show "HEAD:$_path" 2>/dev/null | sha256sum | awk '{print $1}') || return 1
}

fingerprinted_inputs_clean() {
    _paths='src scripts config test rules.sdl doc/07_guide doc/00_llm_process doc/glossary.md'
    git -C "$ROOT" diff --quiet HEAD -- $_paths || return 1
    git -C "$ROOT" diff --cached --quiet HEAD -- $_paths || return 1
    [ -z "$(git -C "$ROOT" status --porcelain --untracked-files=all -- $_paths)" ]
}

evidence_hash() {
    case "$1" in /*) hash_file "$1" ;; *) hash_file "$ROOT/$1" ;; esac
}

write_ledger() {
    _rows=$1
    _fp=$2
    _at=$3
    _tmp="$LEDGER.tmp.$$"
    mkdir -p "$(dirname "$LEDGER")"
    {
        echo '# Updated by scripts/check/check-bootstrap-must-pass.shs. TODO is visible debt, never PASS.'
        echo 'must_check_ledger:'
        echo '  schema: "simple.must-check-ledger/v3"'
        echo "  source_fingerprint: \"$_fp\""
        echo "  completed_at_utc: \"$_at\""
        echo 'must_check_results |id, status, passed_at_utc, command, evidence, evidence_sha256, owner, unblock_condition|'
        printf '%s\n' "$_rows"
    } > "$_tmp"
    mv "$_tmp" "$LEDGER"
}

manifest_rows() {
    awk '/^[[:space:]]+[a-z0-9][a-z0-9-]*,[[:space:]]*bootstrap,/ {print}' "$MANIFEST"
}

row_value() {
    _id=$1; _column=$2
    awk -F, -v id="$_id" -v col="$_column" '{x=$1; gsub(/^[[:space:]]+/, "", x); if (x==id) {v=$col; gsub(/^[[:space:]]+|[[:space:]]+$/, "", v); if (substr(v,1,1)=="\"") v=substr(v,2); if (substr(v,length(v),1)=="\"") v=substr(v,1,length(v)-1); print v; exit}}' "$LEDGER" 2>/dev/null
}

receipt_field() {
    _receipt=$1
    _field=$2
    [ "$(grep -c "^${_field}=" "$_receipt" 2>/dev/null || true)" -eq 1 ] || return 1
    sed -n "s/^${_field}=//p" "$_receipt"
}

validate_gate_receipt() {
    _receipt=$1
    _expected_gate=$2
    _expected_fingerprint=$3

    head_blob_metadata "$_receipt" || return 1
    _receipt_sha=$HEAD_BLOB_SHA
    _receipt_blob=$(mktemp) || return 1
    git -C "$ROOT" show "HEAD:$_receipt" >"$_receipt_blob" 2>/dev/null || { rm -f "$_receipt_blob"; return 1; }
    [ "$(receipt_field "$_receipt_blob" receipt_schema)" = simple.must-check-gate-receipt/v1 ] &&
        [ "$(receipt_field "$_receipt_blob" gate_id)" = "$_expected_gate" ] &&
        [ "$(receipt_field "$_receipt_blob" final_verdict)" = PASS ] &&
        [ "$(receipt_field "$_receipt_blob" source_fingerprint)" = "$_expected_fingerprint" ] || {
            rm -f "$_receipt_blob"
            return 1
        }
    _artifact=$(receipt_field "$_receipt_blob" artifact_path) || { rm -f "$_receipt_blob"; return 1; }
    _artifact_sha=$(receipt_field "$_receipt_blob" artifact_sha256) || { rm -f "$_receipt_blob"; return 1; }
    rm -f "$_receipt_blob"
    [ "$_artifact" != "$_receipt" ] && head_blob_metadata "$_artifact" && [ "$HEAD_BLOB_SHA" = "$_artifact_sha" ] || return 1
    HEAD_BLOB_SHA=$_receipt_sha
}

gate_owner() {
    case "$1" in
        compiler-stage*) echo compiler-team ;;
        caret-*) echo llm-caret-team ;;
        web-server-*|db-server-*) echo server-performance-team ;;
        simpleos-*|riscv32-*|simple-generated-*) echo simpleos-platform-team ;;
        binary-size-*|interpreter-startup-*|rust-go-*) echo performance-team ;;
        *) echo tooling-team ;;
    esac
}

validate_compiler_phases() {
    if [ -n "${MUST_CHECK_PHASE_VALIDATOR:-}" ]; then
        [ "${MUST_CHECK_SELFTEST:-0}" = 1 ] || {
            echo "bootstrap-must-check: ERROR — phase validator override is self-test-only" >&2
            return 2
        }
        sh "$MUST_CHECK_PHASE_VALIDATOR" "$OUTPUT_DIR" "$STAGE4_BINARY" "$STAGE4_PROVENANCE"
        return $?
    fi
    [ -n "$STAGE4_BINARY" ] && [ -n "$STAGE4_PROVENANCE" ] || return 2
    _stage123_out=$(mktemp) || return 2
    _stage4_out=$(mktemp) || { rm -f "$_stage123_out"; return 2; }
    sh "$ROOT/scripts/check/check-bootstrap-stage3-selfverify.shs" \
        --output-dir "$OUTPUT_DIR" --full-provenance >"$_stage123_out" 2>&1
    _stage123_rc=$?
    sh "$ROOT/scripts/check/check-post-bootstrap-stage4-sspec.shs" \
        "$STAGE4_BINARY" "$STAGE4_PROVENANCE" >"$_stage4_out" 2>&1
    _stage4_rc=$?
    if [ "$_stage123_rc" -eq 0 ] && \
       tail -n 1 "$_stage123_out" | grep -Eq '^PASS — [1-9][0-9]* assertion\(s\) checked, stage3 self-verified at .+' && \
       [ "$_stage4_rc" -eq 0 ] && grep -qx 'post_bootstrap_stage4_acceptance=true' "$_stage4_out"; then
        _stage3_provenance=$(tail -n 1 "$_stage123_out" | sed 's/^PASS — [1-9][0-9]* assertion(s) checked, stage3 self-verified at //')
        _manifest_field() {
            [ "$(grep -c "^$1=" "$_stage3_provenance" 2>/dev/null || true)" -eq 1 ] || return 1
            sed -n "s/^$1=//p" "$_stage3_provenance"
        }
        _stage1_evidence=$(_manifest_field seed_inputs_stamp_path) || return 1
        _stage2_evidence=$(_manifest_field stage2_admission_receipt_path) || return 1
        for _phase_evidence in "$_stage1_evidence" "$_stage2_evidence" "$_stage3_provenance" "$STAGE4_PROVENANCE"; do
            [ -f "$_phase_evidence" ] && [ ! -L "$_phase_evidence" ] || return 1
        done
        printf '%s\n' compiler-stage1=pass compiler-stage2=pass compiler-stage3=pass compiler-stage4=pass
        printf '%s\n' \
            "compiler-stage1-evidence=$_stage1_evidence" \
            "compiler-stage2-evidence=$_stage2_evidence" \
            "compiler-stage3-evidence=$_stage3_provenance" \
            "compiler-stage4-evidence=$STAGE4_PROVENANCE"
        rm -f "$_stage123_out" "$_stage4_out"
        return 0
    fi
    tail -n 12 "$_stage123_out" >&2
    tail -n 12 "$_stage4_out" >&2
    rm -f "$_stage123_out" "$_stage4_out"
    return 1
}

run_automated_gate() {
    _gate_command=$1
    if [ -n "${MUST_CHECK_GATE_RUNNER:-}" ]; then
        [ "${MUST_CHECK_SELFTEST:-0}" = 1 ] || {
            echo "bootstrap-must-check: ERROR — gate runner override is self-test-only" >&2
            return 2
        }
        if [ -n "$AUTOMATED_SIMPLE_BINARY" ]; then
            SIMPLE_BINARY="$AUTOMATED_SIMPLE_BINARY" SIMPLE_BIN="$AUTOMATED_SIMPLE_BINARY" sh "$MUST_CHECK_GATE_RUNNER" "$_gate_command"
        else
            sh "$MUST_CHECK_GATE_RUNNER" "$_gate_command"
        fi
        return $?
    fi
    if [ -n "$AUTOMATED_SIMPLE_BINARY" ]; then
        (cd "$ROOT" && SIMPLE_BINARY="$AUTOMATED_SIMPLE_BINARY" SIMPLE_BIN="$AUTOMATED_SIMPLE_BINARY" sh -c "$_gate_command")
    else
        (cd "$ROOT" && sh -c "$_gate_command")
    fi
}

accepted_gate_verdict() {
    _log=$1
    _last=$(awk 'NF { line=$0 } END { print line }' "$_log")
    printf '%s\n' "$_last" | grep -Eq '(^|: )PASS([[:space:]]|$)'
}

if [ "$MODE" = selftest ]; then
    _tmp=$(mktemp -d) || exit 2
    trap 'rm -rf "$_tmp"' EXIT INT TERM
    printf '%s\n' 'setup PASS marker' 'STATUS: FAIL final-verdict' > "$_tmp/incidental-pass.log"
    printf '%s\n' 'setup output' 'STATUS: PASS exact-verdict' > "$_tmp/exact-pass.log"
    ! accepted_gate_verdict "$_tmp/incidental-pass.log" || exit 1
    accepted_gate_verdict "$_tmp/exact-pass.log" || exit 1
    for _phase in 1 2 3 4; do printf 'phase%s evidence\n' "$_phase" > "$_tmp/phase$_phase.receipt"; done
    printf '%s\n' '#!/bin/sh' 'printf "%s\n" compiler-stage1=pass compiler-stage2=pass compiler-stage3=pass compiler-stage4=pass' > "$_tmp/phase-validator"
    printf '%s\n' "printf '%s\\n' compiler-stage1-evidence=$_tmp/phase1.receipt compiler-stage2-evidence=$_tmp/phase2.receipt compiler-stage3-evidence=$_tmp/phase3.receipt compiler-stage4-evidence=$_tmp/phase4.receipt" >> "$_tmp/phase-validator"
    printf '%s\n' '#!/bin/sh' "[ \"\${SIMPLE_BINARY:-}\" = \"$_tmp/stage4\" ] || { echo 'STATUS: FAIL wrong-stage4-binary'; exit 1; }" "[ \"\${SIMPLE_BIN:-}\" = \"$_tmp/stage4\" ] || { echo 'STATUS: FAIL wrong-stage4-bin'; exit 1; }" 'echo "STATUS: PASS self-test automated gate"' > "$_tmp/gate-runner"
    printf '%s\n' '#!/bin/sh' 'exit 0' > "$_tmp/stage4"
    chmod +x "$_tmp/phase-validator" "$_tmp/stage4"
    chmod +x "$_tmp/gate-runner"
    SIMPLE_BINARY="$_tmp/wrong-ambient-simple" SIMPLE_BIN="$_tmp/wrong-ambient-simple-bin" MUST_CHECK_ROOT="$ROOT" MUST_CHECK_LEDGER="$_tmp/ledger.sdn" MUST_CHECK_EVIDENCE_DIR="$_tmp/evidence" MUST_CHECK_PHASE_VALIDATOR="$_tmp/phase-validator" MUST_CHECK_GATE_RUNNER="$_tmp/gate-runner" MUST_CHECK_SELFTEST=1 sh "$0" --record-bootstrap-success --stage4-binary "$_tmp/stage4" --stage4-provenance "$_tmp/phase4.receipt" >/dev/null || exit 1
    grep -q 'compiler-stage1, pass' "$_tmp/ledger.sdn" || exit 1
    grep -q 'compiler-stage2, pass' "$_tmp/ledger.sdn" || exit 1
    grep -q 'compiler-stage3, pass' "$_tmp/ledger.sdn" || exit 1
    grep -q 'compiler-stage4, pass' "$_tmp/ledger.sdn" || exit 1
    ! grep -q 'push-conflict-tree,' "$_tmp/ledger.sdn" || exit 1
    grep -q 'rules-full, pass' "$_tmp/ledger.sdn" || exit 1
    grep -q 'caret-multi-manager-launch, pass' "$_tmp/ledger.sdn" || exit 1
    grep -q 'caret-smux-multi-launch, todo' "$_tmp/ledger.sdn" || exit 1
    grep -q 'web-server-gpu-nginx, todo' "$_tmp/ledger.sdn" || exit 1
    _first=$(sha256sum "$_tmp/ledger.sdn" | awk '{print $1}')
    MUST_CHECK_ROOT="$ROOT" MUST_CHECK_LEDGER="$_tmp/ledger.sdn" MUST_CHECK_EVIDENCE_DIR="$_tmp/evidence" MUST_CHECK_PHASE_VALIDATOR="$_tmp/phase-validator" MUST_CHECK_GATE_RUNNER="$_tmp/gate-runner" MUST_CHECK_SELFTEST=1 MUST_CHECK_NOW=2000-01-01T00:00:00Z sh "$0" --record-bootstrap-success --stage4-binary "$_tmp/stage4" --stage4-provenance "$_tmp/phase4.receipt" >/dev/null || exit 1
    MUST_CHECK_ROOT="$ROOT" MUST_CHECK_LEDGER="$_tmp/ledger2.sdn" MUST_CHECK_EVIDENCE_DIR="$_tmp/evidence" MUST_CHECK_PHASE_VALIDATOR="$_tmp/phase-validator" MUST_CHECK_GATE_RUNNER="$_tmp/gate-runner" MUST_CHECK_SELFTEST=1 MUST_CHECK_NOW=2000-01-01T00:00:00Z sh "$0" --record-bootstrap-success --stage4-binary "$_tmp/stage4" --stage4-provenance "$_tmp/phase4.receipt" >/dev/null || exit 1
    cmp "$_tmp/ledger.sdn" "$_tmp/ledger2.sdn" >/dev/null || exit 1
    [ -n "$_first" ] || exit 1
    sed 's/source_fingerprint: "[^"]*"/source_fingerprint: "old"/; s/caret-smux-multi-launch, todo, never/caret-smux-multi-launch, pass, 1999-01-01T00:00:00Z/' "$_tmp/ledger.sdn" > "$_tmp/stale-ledger.sdn"
    MUST_CHECK_ROOT="$ROOT" MUST_CHECK_LEDGER="$_tmp/stale-ledger.sdn" MUST_CHECK_EVIDENCE_DIR="$_tmp/evidence-stale" MUST_CHECK_PHASE_VALIDATOR="$_tmp/phase-validator" MUST_CHECK_GATE_RUNNER="$_tmp/gate-runner" MUST_CHECK_SELFTEST=1 MUST_CHECK_FINGERPRINT=new MUST_CHECK_NOW=2000-01-01T00:00:00Z sh "$0" --record-bootstrap-success --stage4-binary "$_tmp/stage4" --stage4-provenance "$_tmp/phase4.receipt" >/dev/null || exit 1
    grep -q 'caret-smux-multi-launch, todo, never' "$_tmp/stale-ledger.sdn" || exit 1
    if MUST_CHECK_ROOT="$ROOT" MUST_CHECK_LEDGER="$_tmp/rejected.sdn" MUST_CHECK_PHASE_VALIDATOR="$_tmp/phase-validator" MUST_CHECK_GATE_RUNNER="$_tmp/gate-runner" sh "$0" --record-bootstrap-success >/dev/null 2>&1; then
        echo "bootstrap-must-check selftest: production validator override was accepted" >&2
        exit 1
    fi
    if MUST_CHECK_ROOT="$ROOT" MUST_CHECK_LEDGER="$_tmp/bare-run.sdn" MUST_CHECK_GATE_RUNNER="$_tmp/gate-runner" MUST_CHECK_SELFTEST=1 sh "$0" >/dev/null 2>&1; then
        echo "bootstrap-must-check selftest: bare run recorded unbound automated PASS" >&2
        exit 1
    fi
    [ ! -e "$_tmp/bare-run.sdn" ] || {
        echo "bootstrap-must-check selftest: rejected bare run mutated the ledger" >&2
        exit 1
    }
    echo "bootstrap-must-check: PASS — phase promotion TODO preservation exact Stage4 binding stale reset override rejection and deterministic output checked"
    exit 0
fi

[ -f "$MANIFEST" ] || { echo "bootstrap-must-check: ERROR — missing manifest" >&2; exit 2; }
if [ "$MODE" = run ]; then
    echo "bootstrap-must-check: ERROR — automated PASS recording requires --record-bootstrap-success with exact --stage4-binary and --stage4-provenance" >&2
    exit 2
fi
if [ -n "${MUST_CHECK_FINGERPRINT:-}" ]; then
    [ "${MUST_CHECK_SELFTEST:-0}" = 1 ] || {
        echo "bootstrap-must-check: ERROR — fingerprint override is self-test-only" >&2
        exit 2
    }
    _fp=$MUST_CHECK_FINGERPRINT
else
    _fp=$(fingerprint_head) || exit 2
fi
_at=${MUST_CHECK_NOW:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}
if [ -n "${MUST_CHECK_EVIDENCE_DIR:-}" ]; then
    [ "${MUST_CHECK_SELFTEST:-0}" = 1 ] || {
        echo "bootstrap-must-check: ERROR — evidence directory override is self-test-only" >&2
        exit 2
    }
    _evidence_dir=$MUST_CHECK_EVIDENCE_DIR
else
    _evidence_dir="$ROOT/doc/08_tracking/check/evidence/$_fp"
fi
mkdir -p "$_evidence_dir"
_old_fp=""
[ -f "$LEDGER" ] && _old_fp=$(awk '$1 == "source_fingerprint:" {v=$2; if (substr(v,1,1)=="\"") v=substr(v,2); if (substr(v,length(v),1)=="\"") v=substr(v,1,length(v)-1); print v; exit}' "$LEDGER")
_carry_pass=0
[ "$_old_fp" = "$_fp" ] && _carry_pass=1
_rows=""
_failed=0
_phase_results=""
if [ "$MODE" != selftest ] && [ "${MUST_CHECK_SELFTEST:-0}" != 1 ] && ! fingerprinted_inputs_clean; then
    echo "bootstrap-must-check: ERROR — fingerprinted inputs differ from HEAD" >&2
    exit 2
fi
if [ "$MODE" = record-gate ]; then
    [ -n "$RECORD_GATE_ID" ] && [ -n "$RECORD_GATE_EVIDENCE" ] || {
        echo "bootstrap-must-check: ERROR — --record-gate-pass requires --evidence" >&2
        exit 2
    }
    _record_mode=$(awk -F, -v id="$RECORD_GATE_ID" '{x=$1; gsub(/^[[:space:]]+/, "", x); if (x==id) {v=$4; gsub(/[[:space:]]/, "", v); print v; exit}}' "$MANIFEST")
    [ "$_record_mode" = todo ] || {
        echo "bootstrap-must-check: ERROR — $RECORD_GATE_ID is not a TODO receipt gate" >&2
        exit 2
    }
    validate_gate_receipt "$RECORD_GATE_EVIDENCE" "$RECORD_GATE_ID" "$_fp" || {
        echo "bootstrap-must-check: ERROR — evidence must be a committed simple.must-check-gate-receipt/v1 bound to this gate, source fingerprint, final PASS, and committed artifact hash" >&2
        exit 2
    }
fi
if [ "$MODE" = record-bootstrap ]; then
    _phase_results=$(validate_compiler_phases) || {
        echo "bootstrap-must-check: FAIL — compiler Stage 1/2/3/4 evidence did not all pass" >&2
        exit 1
    }
    for _phase in compiler-stage1 compiler-stage2 compiler-stage3 compiler-stage4; do
        printf '%s\n' "$_phase_results" | grep -qx "$_phase=pass" || {
            echo "bootstrap-must-check: FAIL — missing $_phase PASS evidence" >&2
            exit 1
        }
    done
    case "$STAGE4_BINARY" in
        /*) AUTOMATED_SIMPLE_BINARY=$STAGE4_BINARY ;;
        *) AUTOMATED_SIMPLE_BINARY="$ROOT/$STAGE4_BINARY" ;;
    esac
    _stage4_dir=$(CDPATH= cd -- "$(dirname -- "$AUTOMATED_SIMPLE_BINARY")" && pwd -P) || exit 2
    AUTOMATED_SIMPLE_BINARY="$_stage4_dir/$(basename -- "$AUTOMATED_SIMPLE_BINARY")"
fi

manifest_rows | while IFS=, read -r _id _tier _blocking _gate_mode _command _description; do
    : # parsed below outside the pipeline so status survives POSIX-shell subshells
done

_manifest_tmp=$(mktemp) || exit 2
_rows_tmp=$(mktemp) || exit 2
trap 'rm -f "$_manifest_tmp" "$_rows_tmp"' EXIT INT TERM
manifest_rows > "$_manifest_tmp"
while IFS=, read -r _id _tier _blocking _gate_mode _command _description; do
    _id=$(printf '%s' "$_id" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    _gate_mode=$(printf '%s' "$_gate_mode" | tr -d ' ')
    _command=$(printf '%s' "$_command" | sed 's/^[[:space:]]*"//;s/"[[:space:]]*$//')
    _status=todo
    _passed_at=never
    _evidence='not run'
    _evidence_sha=never
    _owner=$(gate_owner "$_id")
    _unblock=$_description
    _unblock=$(printf '%s' "$_unblock" | sed 's/^[[:space:]]*"//;s/"[[:space:]]*$//')
    if [ "$MODE" = record-gate ] && [ "$_id" = "$RECORD_GATE_ID" ]; then
        validate_gate_receipt "$RECORD_GATE_EVIDENCE" "$RECORD_GATE_ID" "$_fp" || exit 1
        _old=$(row_value "$_id" 2)
        _old_evidence=$(row_value "$_id" 5)
        _old_sha=$(row_value "$_id" 6)
        _status=pass; _evidence=$RECORD_GATE_EVIDENCE; _evidence_sha=$HEAD_BLOB_SHA; _unblock=none
        if [ "$_old" = pass ] && [ "$_old_evidence" = "$RECORD_GATE_EVIDENCE" ] && [ "$_old_sha" = "$HEAD_BLOB_SHA" ]; then
            _passed_at=$(row_value "$_id" 3)
        else
            _passed_at=$_at
        fi
    elif [ "$MODE" = record-bootstrap ] && { [ "$_id" = compiler-stage1 ] || [ "$_id" = compiler-stage2 ] || [ "$_id" = compiler-stage3 ] || [ "$_id" = compiler-stage4 ]; }; then
        _status=pass; _passed_at=$_at
        _source_evidence=$(printf '%s\n' "$_phase_results" | sed -n "s/^$_id-evidence=//p")
        [ -n "$_source_evidence" ] || { echo "bootstrap-must-check: FAIL — missing $_id evidence reference" >&2; exit 1; }
        _retained_evidence="$_evidence_dir/${_id}.receipt"
        cp -- "$_source_evidence" "$_retained_evidence" || exit 1
        _evidence=${_retained_evidence#"$ROOT/"}
        _evidence_sha=$(evidence_hash "$_evidence") || exit 1
        _unblock=none
    elif { [ "$MODE" = run ] || [ "$MODE" = record-bootstrap ]; } && [ "$_gate_mode" = automated ]; then
        _out="$_evidence_dir/${_id}.log.tmp.$$"
        _final_out="$_evidence_dir/${_id}.log"
        run_automated_gate "$_command" >"$_out" 2>&1
        _rc=$?
        if [ "$_rc" -eq 0 ] && accepted_gate_verdict "$_out"; then
            mv "$_out" "$_final_out"
            _status=pass; _passed_at=$_at; _evidence="$_final_out"
            case "$_evidence" in "$ROOT/"*) _evidence=${_evidence#"$ROOT/"} ;; esac
            _evidence_sha=$(evidence_hash "$_evidence") || exit 1
            _unblock=none
        else
            mv "$_out" "$_final_out"
            _status=fail; _evidence="exit $_rc without accepted PASS at $_at"; _failed=1
        fi
    else
        _old=$(row_value "$_id" 2)
        _old_evidence=$(row_value "$_id" 5)
        _old_sha=$(row_value "$_id" 6)
        _durable_pass=0
        if [ "$_gate_mode" = todo ] && [ "$_old" = pass ] && head_blob_metadata "$_old_evidence" && [ "$HEAD_BLOB_SHA" = "$_old_sha" ]; then
            _durable_pass=1
        fi
        if [ "$_old" = pass ] && { [ "$_carry_pass" -eq 1 ] || [ "$_durable_pass" -eq 1 ]; }; then
            _status=pass
            _passed_at=$(row_value "$_id" 3)
            _evidence_sha=$_old_sha
            _unblock=none
        fi
        _evidence=$_old_evidence
        [ -n "$_evidence" ] || _evidence='pending required evidence'
    fi
    printf '    %s, %s, %s, "%s", "%s", "%s", "%s", "%s"\n' "$_id" "$_status" "$_passed_at" "$_command" "$_evidence" "$_evidence_sha" "$_owner" "$_unblock" >> "$_rows_tmp"
done < "$_manifest_tmp"

_completed_at=never
_completion_candidate=$(awk -F, '
    /^[[:space:]]+[a-z0-9][a-z0-9-]*,/ {
        status=$2; at=$3
        gsub(/[[:space:]]/, "", status); gsub(/^[[:space:]]+|[[:space:]]+$/, "", at)
        if (status != "pass" || at == "never" || at == "") incomplete=1
        if (at > latest && at != "never") latest=at
    }
    END { if (!incomplete && latest != "") print latest }
' "$_rows_tmp")
[ -z "$_completion_candidate" ] || _completed_at=$_completion_candidate
write_ledger "$(cat "$_rows_tmp")" "$_fp" "$_completed_at"
[ "$_failed" -eq 0 ] || { echo "bootstrap-must-check: FAIL — one or more automated gates failed"; exit 1; }
echo "bootstrap-must-check: PASS — ledger updated; TODO rows remain visible and are not counted as pass"
