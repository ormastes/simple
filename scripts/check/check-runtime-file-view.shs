#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
WORK=${TMPDIR:-/tmp}/simple-runtime-file-view-$$
trap 'rm -rf "$WORK"' EXIT HUP INT TERM
mkdir -p "$WORK"

${CC:-cc} -std=gnu11 -Wall -Wextra -Werror -pthread \
    -I "$ROOT/src/runtime" \
    "$ROOT/src/runtime/runtime_file_view.c" \
    "$ROOT/src/runtime/test/rt_file_view_selfcheck.c" \
    -o "$WORK/selfcheck"
"$WORK/selfcheck"
