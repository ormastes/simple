#!/bin/sh
# check-cuda-dlopen-fallback.shs
#
# Proves BOTH branches of the CUDA driver dlopen path in libsimple_runtime.so:
#
#   NATIVE      libcuda.so.1 present  -> rt_cuda_available()==1, a real device
#                                        allocation + cuMemsetD32 + D2H readback
#                                        returns the exact pattern.
#   UNAVAILABLE SIMPLE_CUDA_LIB points at a bogus path -> every entry point
#                                        returns an HONEST CUDA error code
#                                        (303 SharedObjectInitFailed / negated),
#                                        never 0-as-success and never a
#                                        fabricated readback.
#
# The UNAVAILABLE branch is not optional: a fallback that has never taken its
# own fallback branch is unverified. This script fails if either branch is not
# actually exercised.
#
# Usage: sh scripts/check/check-cuda-dlopen-fallback.shs [path/to/libsimple_runtime.so]
set -e

root=$(cd "$(dirname "$0")/../.." && pwd)
lib=${1:-$root/src/compiler_rust/target/debug/libsimple_runtime.so}
work=${TMPDIR:-/tmp}/cuda_dlopen_fallback.$$
mkdir -p "$work"
trap 'rm -rf "$work"' EXIT

if [ ! -f "$lib" ]; then
  echo "FAIL — runtime library not found: $lib"
  exit 1
fi

cat > "$work/probe.c" <<'EOF'
#include <dlfcn.h>
#include <stdio.h>
#include <stdint.h>

/*
 * libsimple_runtime's CLI bridge imports these process-owned symbols. Export
 * inert definitions so RTLD_NOW reaches the CUDA symbols this probe owns.
 */
int64_t spl_arg_count(void) { return 0; }
const char *spl_get_arg(int64_t index) { (void)index; return NULL; }

int main(int argc, char **argv) {
    void *h = dlopen(argv[1], RTLD_NOW);
    if (!h) { printf("dlopen_failed %s\n", dlerror()); return 2; }

    int64_t (*avail)(void)        = dlsym(h, "rt_cuda_available");
    int64_t (*init)(void)         = dlsym(h, "rt_cuda_init");
    int64_t (*count)(void)        = dlsym(h, "rt_cuda_device_count");
    int64_t (*ctx_create)(int64_t)= dlsym(h, "rt_cuda_ctx_create");
    int64_t (*dev_get)(int64_t)   = dlsym(h, "rt_cuda_device_get");
    int64_t (*alloc)(int64_t)     = dlsym(h, "rt_cuda_mem_alloc");
    int64_t (*freep)(int64_t)     = dlsym(h, "rt_cuda_mem_free");
    int64_t (*d32)(int64_t,int64_t,int64_t)  = dlsym(h, "rt_cuda_memset_d32");
    int64_t (*dtoh)(int64_t,int64_t,int64_t) = dlsym(h, "rt_cuda_memcpy_dtoh");
    int64_t (*sync)(void)         = dlsym(h, "rt_cuda_ctx_synchronize");

    if (!avail || !init || !count || !ctx_create || !dev_get || !alloc ||
        !freep || !d32 || !dtoh || !sync) {
        printf("missing_symbol\n");
        return 3;
    }

    printf("available %lld\n", (long long)avail());
    printf("init %lld\n", (long long)init());
    printf("device_count %lld\n", (long long)count());

    int64_t dev = dev_get(0);
    printf("device_get %lld\n", (long long)dev);
    int64_t ctx = ctx_create(dev < 0 ? 0 : dev);
    printf("ctx_create %lld\n", (long long)ctx);

    int64_t p = alloc(16);
    printf("mem_alloc %lld\n", (long long)p);

    int64_t rc = d32(p, 0x5A5A5A5A, 4);
    printf("memset_d32 %lld\n", (long long)rc);
    printf("sync %lld\n", (long long)sync());

    uint32_t host[4] = {0, 0, 0, 0};
    int64_t rc2 = dtoh((int64_t)(intptr_t)host, p, 16);
    printf("memcpy_dtoh %lld\n", (long long)rc2);
    printf("readback %08x %08x %08x %08x\n", host[0], host[1], host[2], host[3]);

    if (p > 0) freep(p);
    return 0;
}
EOF

case "$(uname -s)" in
  Darwin) cc -O0 -Wl,-export_dynamic -o "$work/probe" "$work/probe.c" -ldl ;;
  *) cc -O0 -Wl,--export-dynamic -o "$work/probe" "$work/probe.c" -ldl ;;
esac

fail=0

echo "== NATIVE branch (real libcuda.so.1) =="
unset SIMPLE_CUDA_LIB
"$work/probe" "$lib" > "$work/native.txt" 2>&1 || true
cat "$work/native.txt"

native_avail=$(awk '/^available /{print $2}' "$work/native.txt")
native_read=$(awk '/^readback /{print $2}' "$work/native.txt")
native_d32=$(awk '/^memset_d32 /{print $2}' "$work/native.txt")

if [ "$native_avail" != "1" ]; then
  echo "FAIL — native branch: rt_cuda_available()=$native_avail, expected 1 on a CUDA host"
  fail=1
elif [ "$native_d32" != "0" ]; then
  echo "FAIL — native branch: rt_cuda_memset_d32 returned $native_d32, expected 0"
  fail=1
elif [ "$native_read" != "5a5a5a5a" ]; then
  echo "FAIL — native branch: readback was $native_read, expected 5a5a5a5a"
  fail=1
else
  echo "  native OK: real device fill + D2H readback == 5a5a5a5a"
fi

echo "== UNAVAILABLE branch (SIMPLE_CUDA_LIB=/nonexistent/libcuda.so.1) =="
SIMPLE_CUDA_LIB=/nonexistent/libcuda.so.1 "$work/probe" "$lib" > "$work/absent.txt" 2>&1 || true
cat "$work/absent.txt"

abs_avail=$(awk '/^available /{print $2}' "$work/absent.txt")
abs_init=$(awk '/^init /{print $2}' "$work/absent.txt")
abs_d32=$(awk '/^memset_d32 /{print $2}' "$work/absent.txt")
abs_alloc=$(awk '/^mem_alloc /{print $2}' "$work/absent.txt")
abs_read=$(awk '/^readback /{print $2}' "$work/absent.txt")

if [ "$abs_avail" != "0" ]; then
  echo "FAIL — unavailable branch: rt_cuda_available()=$abs_avail, expected 0"
  fail=1
elif [ "$abs_init" = "0" ]; then
  echo "FAIL — unavailable branch: rt_cuda_init() reported success (0) with no driver"
  fail=1
elif [ "$abs_d32" = "0" ]; then
  echo "FAIL — unavailable branch: rt_cuda_memset_d32 reported success (0) with no driver"
  fail=1
elif [ "$abs_alloc" -gt 0 ] 2>/dev/null; then
  echo "FAIL — unavailable branch: rt_cuda_mem_alloc handed out pointer $abs_alloc with no driver"
  fail=1
elif [ "$abs_read" = "5a5a5a5a" ]; then
  echo "FAIL — unavailable branch: fabricated a readback of 5a5a5a5a with no driver"
  fail=1
else
  echo "  unavailable OK: honest error codes (init=$abs_init memset_d32=$abs_d32 alloc=$abs_alloc), no fabricated data"
fi

if [ "$fail" -ne 0 ]; then
  echo "FAIL — CUDA dlopen fallback did not prove both branches"
  exit 1
fi
echo "PASS — 2 branches checked (native real-GPU fill+readback, absent-driver honest error)"
