#!/bin/sh
# Stage-4-only object admission plus independent pre-migration C-oracle parity.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
SOURCE_DIR="$ROOT/src/os/kernel/arch/arm32/cosmos"
TEST_DIR="$ROOT/test/02_integration/os/cosmos"
SIMPLE_SOURCE="$SOURCE_DIR/cosmos_storage_policy.spl"
C_BRIDGE="$SOURCE_DIR/cosmos_storage.c"
ORACLE_SOURCE="$TEST_DIR/cosmos_storage_policy_oracle.c"
PARITY_SOURCE="$TEST_DIR/cosmos_storage_policy_parity_test.c"
SCRATCH=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-storage-policy.XXXXXX")
trap 'case ${SCRATCH:-} in /tmp/cosmos-storage-policy.*|${TMPDIR:-/tmp}/cosmos-storage-policy.*) [ ! -d "$SCRATCH" ] || rm -r -- "$SCRATCH" ;; esac' EXIT HUP INT TERM

fail() {
    echo "FAIL cosmos-storage-policy: $*" >&2
    exit 1
}

blocked() {
    echo "BLOCKED cosmos-storage-policy: $*" >&2
    exit 2
}

for source in "$SIMPLE_SOURCE" "$C_BRIDGE" "$ORACLE_SOURCE" \
    "$PARITY_SOURCE" "$SOURCE_DIR/cosmos_storage_policy.h" \
    "$TEST_DIR/cosmos_storage_policy_oracle.h"
do
    [ -f "$source" ] || fail "missing owned source: $source"
done

for symbol in cosmos_storage_init \
    cosmos_storage_factory_initialize_erased cosmos_storage_poll
do
    grep -Fq "@export(\"C\", name: \"$symbol\")" "$SIMPLE_SOURCE" ||
        fail "pure owner lacks production export $symbol"
    if grep -Eq "^[[:space:]]*int[[:space:]]+$symbol[[:space:]]*[(]" \
        "$C_BRIDGE"; then
        fail "C bridge still defines policy owner $symbol"
    fi
done
if grep -Eq 'storage_(prepared|ready|gc_polls)' "$C_BRIDGE"; then
    fail "C bridge still owns lifecycle state"
fi

SIMPLE_BIN=${SIMPLE_BIN:-$ROOT/bin/simple}
[ -x "$SIMPLE_BIN" ] || blocked "missing executable pure-Simple compiler"
BOOTSTRAP_STAGE3_FACADE_PATH="$ROOT/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="$ROOT/scripts/check/lib/stage4-candidate-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"
SIMPLE_CANONICAL=$(bootstrap_stage3_canonical_file "$SIMPLE_BIN") ||
    blocked "cannot resolve pure-Simple compiler canonically"
SIMPLE_PROVENANCE=${SIMPLE_PROVENANCE:-${SIMPLE_CANONICAL}.provenance.env}
stage4_verify_candidate_provenance \
    "$SIMPLE_PROVENANCE" "$SIMPLE_CANONICAL" "$ROOT" ||
    blocked "admitted source-matched Stage-4 provenance is required"
case $($SIMPLE_CANONICAL --version 2>&1 || true) in
    *"Rust-built Simple binary is a bootstrap seed"*)
        blocked "a bootstrap seed cannot prove the storage policy" ;;
esac

command -v readelf >/dev/null 2>&1 || blocked "readelf is required"
command -v cc >/dev/null 2>&1 || blocked "host C compiler is required"
command -v clang >/dev/null 2>&1 || blocked "clang is required"
command -v ld.lld >/dev/null 2>&1 || blocked "ld.lld is required"

EXPECTED_EXPORTS='cosmos_storage_factory_initialize_erased
cosmos_storage_init
cosmos_storage_poll'
EXPECTED_BRIDGES='cosmos_storage_bridge_admin_init
cosmos_storage_bridge_backend_format
cosmos_storage_bridge_backend_init
cosmos_storage_bridge_backend_mount
cosmos_storage_bridge_dispatch_init
cosmos_storage_bridge_dispatch_poll
cosmos_storage_bridge_factory_initialize_erased
cosmos_storage_bridge_ftl_init
cosmos_storage_bridge_ftl_recover
cosmos_storage_bridge_gc_step
cosmos_storage_bridge_io_init
cosmos_storage_bridge_is_qemu
cosmos_storage_bridge_media_init'
EXPECTED_LOWER_ABI='cosmos_ftl_factory_initialize_erased
cosmos_ftl_gc_step
cosmos_ftl_init
cosmos_ftl_nfc_backend_format
cosmos_ftl_nfc_backend_init
cosmos_ftl_nfc_backend_mount
cosmos_ftl_recover
cosmos_nvme_dispatch_init
cosmos_nvme_dispatch_poll
cosmos_nvme_ftl_media_init
cosmos_nvme_pcie_admin_service_init
cosmos_nvme_pcie_service_init'

check_policy_symbols() {
    object=$1
    symbols=$(readelf -sW "$object")
    exports=$(printf '%s\n' "$symbols" |
        awk '$4 == "FUNC" && $5 == "GLOBAL" && $6 == "DEFAULT" &&
             $7 != "UND" && $8 ~ /^cosmos_storage_/ { print $8 }' |
        LC_ALL=C sort -u)
    [ "$exports" = "$EXPECTED_EXPORTS" ] || {
        printf '%s\n' "$exports" >&2
        fail "pure object export set is not exact"
    }
    undefined=$(printf '%s\n' "$symbols" |
        awk '$7 == "UND" && $8 != "" { print $8 }' | LC_ALL=C sort -u)
    [ "$undefined" = "$EXPECTED_BRIDGES" ] || {
        printf '%s\n' "$undefined" >&2
        fail "pure object undefined-symbol closure is not exact"
    }
    printf '%s\n' "$symbols" |
        awk '$7 != "UND" && ($8 == "main" || $8 == "_start" ||
             $8 == "__simple_main" || $8 ~ /^rt_/) { bad = 1 }
             END { exit bad }' ||
        fail "pure object defines a forbidden entry/runtime symbol"
}

for target in x86_64-unknown-linux-gnu armv7-unknown-none-eabi
do
    name=${target%%-*}
    SIMPLE_LIB="$ROOT/src" "$SIMPLE_CANONICAL" native-build \
        --backend llvm \
        --source "$SOURCE_DIR" \
        --entry-closure \
        --entry "$SIMPLE_SOURCE" \
        --target "$target" \
        --emit-object \
        --no-mangle \
        --cache-dir "$SCRATCH/$name-cache" \
        -o "$SCRATCH/storage-policy-$name.o"
    stage4_verify_candidate_provenance \
        "$SIMPLE_PROVENANCE" "$SIMPLE_CANONICAL" "$ROOT" ||
        fail "Stage-4 provenance changed during $target emission"
    check_policy_symbols "$SCRATCH/storage-policy-$name.o"
done

host_header=$(readelf -hW "$SCRATCH/storage-policy-x86_64.o")
printf '%s\n' "$host_header" | grep -Eq 'Class:[[:space:]]+ELF64' &&
    printf '%s\n' "$host_header" |
        grep -Eq 'Machine:[[:space:]]+Advanced Micro Devices X86-64' ||
    fail "host policy object is not ELF64 x86-64"
arm_header=$(readelf -hW "$SCRATCH/storage-policy-armv7.o")
printf '%s\n' "$arm_header" | grep -Eq 'Class:[[:space:]]+ELF32' &&
    printf '%s\n' "$arm_header" | grep -Eq 'Type:[[:space:]]+REL' &&
    printf '%s\n' "$arm_header" | grep -Eq 'Machine:[[:space:]]+ARM' ||
    fail "production policy object is not ELF32 ARM relocatable"
arm_attributes=$(readelf -AW "$SCRATCH/storage-policy-armv7.o")
printf '%s\n' "$arm_attributes" | grep -Fq 'Tag_CPU_arch: v7' &&
    printf '%s\n' "$arm_attributes" |
        grep -Fq 'Tag_CPU_name: "cortex-a9"' &&
    printf '%s\n' "$arm_attributes" |
        grep -Fq 'Tag_CPU_arch_profile: Application' ||
    fail "production policy object lacks Cortex-A9 attributes"

common_flags='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2'
cc $common_flags -DCOSMOS_SILICON=1 -DCOSMOS_MMIO_TEST=1 \
    -DCOSMOS_STORAGE_POLICY_TEST=1 \
    -include "$SOURCE_DIR/cosmos_profile_openssd2_8ch8way_v300.h" \
    -I"$SOURCE_DIR" -I"$TEST_DIR" \
    "$C_BRIDGE" "$ORACLE_SOURCE" "$PARITY_SOURCE" \
    "$SCRATCH/storage-policy-x86_64.o" \
    -o "$SCRATCH/storage-policy-parity"
"$SCRATCH/storage-policy-parity" > "$SCRATCH/parity.out"
grep -qx 'COSMOS_STORAGE_ORACLE_CASES 33' "$SCRATCH/parity.out" ||
    fail "independent C oracle case pin missing"
grep -qx 'COSMOS_STORAGE_ACTUAL_DECISIONS 20/20' "$SCRATCH/parity.out" ||
    fail "actual production decision pin missing"
grep -qx 'COSMOS_STORAGE_GC_BOUNDARY_POLLS 4194304' \
    "$SCRATCH/parity.out" || fail "GC boundary pin missing"
grep -qx 'cosmos storage pure-policy/oracle parity: PASS' \
    "$SCRATCH/parity.out" || fail "parity success receipt missing"

arm_flags='--target=armv7-none-eabi -mcpu=cortex-a9 -marm -ffreestanding -nostdlib -fno-builtin'
clang $arm_flags $common_flags -DCOSMOS_SILICON=1 \
    -include "$SOURCE_DIR/cosmos_profile_openssd2_8ch8way_v300.h" \
    -I"$SOURCE_DIR" -c "$C_BRIDGE" -o "$SCRATCH/storage-bridge-arm.o"
bridge_symbols=$(readelf -sW "$SCRATCH/storage-bridge-arm.o")
bridge_defs=$(printf '%s\n' "$bridge_symbols" |
    awk '$4 == "FUNC" && $5 == "GLOBAL" && $7 != "UND" &&
         $8 ~ /^cosmos_storage_bridge_/ { print $8 }' | LC_ALL=C sort -u)
[ "$bridge_defs" = "$EXPECTED_BRIDGES" ] ||
    fail "C acquisition bridge definition set is not exact"
if printf '%s\n' "$bridge_symbols" |
    awk '$7 != "UND" && ($8 == "cosmos_storage_init" ||
         $8 == "cosmos_storage_factory_initialize_erased" ||
         $8 == "cosmos_storage_poll") { found = 1 } END { exit !found }'
then
    fail "C acquisition object defines a policy export"
fi

ld.lld -r "$SCRATCH/storage-bridge-arm.o" \
    "$SCRATCH/storage-policy-armv7.o" -o "$SCRATCH/storage-owner-arm.o"
combined_symbols=$(readelf -sW "$SCRATCH/storage-owner-arm.o")
combined_undefined=$(printf '%s\n' "$combined_symbols" |
    awk '$7 == "UND" && $8 != "" { print $8 }' | LC_ALL=C sort -u)
[ "$combined_undefined" = "$EXPECTED_LOWER_ABI" ] || {
    printf '%s\n' "$combined_undefined" >&2
    fail "combined storage owner has an unexpected ABI dependency closure"
}
for symbol in cosmos_storage_init \
    cosmos_storage_factory_initialize_erased cosmos_storage_poll
do
    printf '%s\n' "$combined_symbols" |
        awk -v symbol="$symbol" '$4 == "FUNC" && $5 == "GLOBAL" &&
             $7 != "UND" && $8 == symbol { count++ }
             END { exit count != 1 }' ||
        fail "combined storage owner does not define $symbol exactly once"
done

echo "cosmos_storage_policy_exports=3"
echo "cosmos_storage_policy_bridge_imports=13"
echo "cosmos_storage_actual_decisions=20/20"
echo "cosmos_storage_oracle_cases=33"
echo "cosmos_storage_gc_boundary_polls=4194304"
echo "cosmos_storage_board_evidence=separate-not-included"
echo "STATUS: PASS cosmos-storage pure-policy migration"
