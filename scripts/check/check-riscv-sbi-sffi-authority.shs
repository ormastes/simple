#!/bin/sh
set -eu

rv32=src/os/kernel/arch/riscv32/sbi.spl
rv64=src/os/kernel/arch/riscv64/sbi.spl
ipi=src/lib/nogc_async_mut_noalloc/baremetal/riscv/sbi.spl
topology=src/os/kernel/arch/arm32/topology.spl

require() {
    file=$1
    text=$2
    if ! grep -Fq "$text" "$file"; then
        echo "FAIL: $file missing: $text" >&2
        exit 1
    fi
}

reject() {
    file=$1
    text=$2
    if grep -Fq "$text" "$file"; then
        echo "FAIL: $file retains: $text" >&2
        exit 1
    fi
}

require "$rv32" '@unsafe(reason: "providerless privileged SBI tuple ABI is not artifact-admitted", capabilities: [ffi])'
require "$rv64" '@unsafe(reason: "executes a privileged SBI ecall through an unsigned target C provider", capabilities: [ffi])'
require "$ipi" 'ret.error == SBI_IPI_SUCCESS and ret.value != 0'
require "$rv64" 'ret.error == SBI_SUCCESS and ret.value != 0'
require "$ipi" '(&legacy_mask) as u64'
require "$ipi" 'hart_mask_base + bit as u64'
require "$ipi" 'while mask != 0u64:'
reject "$ipi" 'sbi_send_ipi_legacy(hart_mask)'
require "$topology" '@unsafe(reason: "reconstructs an unadmitted physical DTB address from two foreign reads", capabilities: [ffi])'

if grep -Eiq '(malloc|calloc|realloc|hash\(|signature|dlsym|dlopen|mutex|sleep|retry)' \
        "$rv32" "$rv64" "$ipi" "$topology"; then
    echo "FAIL: bounded SBI/topology path gained allocation, admission, lookup, lock, or retry work" >&2
    exit 1
fi

echo "PASS: SBI/topology raw authority, status booleans, legacy pointer, and hot-path shape"
