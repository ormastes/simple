#!/bin/sh
# Host-side allocation model for the entry-closure source-line scanner.
# It deliberately does not invoke Simple: bootstrap recovery must not spend a
# full build merely to establish the memory effect of removing split("\n").
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
SOURCE="$ROOT/src/compiler/80.driver/driver_source_loading.spl"
TMP=$(mktemp -d "${TMPDIR:-/tmp}/simple-closure-lines.XXXXXX")
trap 'rm -rf "$TMP"' EXIT HUP INT TERM

grep -F 'fn _driver_line_end(content: text, start: i64) -> i64:' "$SOURCE" >/dev/null
grep -F 'val line_end = _driver_line_end(content, line_start)' "$SOURCE" >/dev/null
if sed -n '/fn _driver_entry_import_module_paths_text_fallback/,/^pub fn _driver_entry_import_module_paths/p' "$SOURCE" | grep -F 'content.split("\n")' >/dev/null; then
    echo 'FAIL: import scanner still retains a whole-file line split' >&2
    exit 1
fi
if sed -n '/pub fn _driver_entry_sibling_module_paths/,/^fn _driver_try_entry_import_rel/p' "$SOURCE" | grep -F 'content.split("\n")' >/dev/null; then
    echo 'FAIL: sibling scanner still retains a whole-file line split' >&2
    exit 1
fi
grep -F 'extern fn rt_dir_walk(path: text) -> [text]' "$SOURCE" >/dev/null
if grep -F 'extern fn rt_process_run' "$SOURCE" >/dev/null ||
   grep -F 'val cmd = "find ' "$SOURCE" >/dev/null ||
   sed -n '/fn _driver_collect_sources(path:/,/^pub fn _driver_collect_sources_via_find/p' "$SOURCE" | grep -F 'stdout.split("\n")' >/dev/null; then
    echo 'FAIL: source discovery still shells out or retains a captured full manifest' >&2
    exit 1
fi
release_body=$(sed -n '/^pub fn driver_entry_scan_cache_release()/,/^pub fn driver_entry_scan_cache_reset()/p' "$SOURCE")
for cache_owner in _g_entry_scan_content_by_path _g_entry_scan_imports_by_path _g_entry_scan_siblings_by_path; do
    printf '%s\n' "$release_body" | grep -F "$cache_owner = {}" >/dev/null || {
        echo "FAIL: build-local entry scan cache does not release $cache_owner" >&2
        exit 1
    }
done

cat >"$TMP/fixture.c" <<'EOF'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

enum { SOURCE_BYTES = 8 * 1024 * 1024, LINE_BYTES = 32 };

int main(void) {
    const size_t lines = SOURCE_BYTES / LINE_BYTES;
    /* Old split: pointer table plus one allocation header and payload copy per
       line. New cursor: one current-line payload; source storage is common. */
    const size_t allocation_header = 16;
    const size_t old_scratch = lines * (sizeof(char *) + allocation_header + LINE_BYTES);
    const size_t new_scratch = LINE_BYTES + allocation_header;
    const size_t ratio = old_scratch / new_scratch;
    printf("source_bytes=%d lines=%zu old_scratch_bytes=%zu new_scratch_bytes=%zu reduction_x=%zu\n",
           SOURCE_BYTES, lines, old_scratch, new_scratch, ratio);
    return ratio >= 1024 ? 0 : 1;
}
EOF

${CC:-cc} -O2 -Wall -Wextra -Werror "$TMP/fixture.c" -o "$TMP/fixture"
"$TMP/fixture"
echo 'PASS: closure scanners retain one bounded line instead of a whole-file split'
