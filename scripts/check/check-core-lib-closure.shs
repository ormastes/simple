#!/bin/sh
# WP-09 (kernel/plugin audit plan): define the "core lib" — the subset of
# src/lib/** that the compiler KERNEL (K0, optionally K0+K1) actually reaches
# at compile time — by MEASUREMENT, and ratchet it so it cannot silently grow.
#
# Mechanism: seed a BFS from every K0 (and, with --kernel-binary, K1) file
# under src/compiler, follow `use std.<path>` imports transitively through
# src/lib/**, and classify every REACHED lib file against the CORE glob rows
# in doc/04_architecture/compiler/plugin_arch/core_lib_closure.sdn. A reached
# file outside every CORE row is a ratchet violation (a NEW non-core file
# reached grows the kernel's real dependency footprint). A baselined file
# that is no longer reached is a STALE baseline (same convention as the
# test-tree-divergence guard) — but per the kernel/plugin audit plan §8,
# until OD-4 formally accepts the core-lib set, stale-baseline is a WARN
# line, not a FAIL, so the ratchet only ever blocks GROWTH while the
# accepted set is still provisional.
#
# `core_lib_closure_baseline.txt` is evidence of today's measured closure,
# NOT an allowlist to keep pushing edges into — see kernel_closure_phase0
# baseline for the same posture. Per the audit plan §8, this baseline file
# is regenerated ONLY by the merge owner at the end of each wave; a package
# that shrinks the closure states its expected removals in the PR body
# instead of editing it directly.
set -eu

usage() {
    echo "usage: $0 [--root DIR] [--manifest FILE] [--kernel-manifest FILE] [--kernel-binary] [--baseline FILE] [--generate-baseline] [--selftest]" >&2
    exit 2
}

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
root=$repo_root
manifest=doc/04_architecture/compiler/plugin_arch/core_lib_closure.sdn
kernel_manifest=doc/04_architecture/compiler/plugin_arch/kernel_closure.sdn
baseline=$repo_root/scripts/check/core_lib_closure_baseline.txt
classify_lib="$repo_root/scripts/lib/kernel-closure-classify.awk"
include_k1=0
generate_baseline=0
selftest=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --root) [ "$#" -ge 2 ] || usage; root=$2; shift 2 ;;
        --manifest) [ "$#" -ge 2 ] || usage; manifest=$2; shift 2 ;;
        --kernel-manifest) [ "$#" -ge 2 ] || usage; kernel_manifest=$2; shift 2 ;;
        --kernel-binary) include_k1=1; shift ;;
        --baseline) [ "$#" -ge 2 ] || usage; baseline=$2; shift 2 ;;
        --generate-baseline) generate_baseline=1; shift ;;
        --selftest|--self-test) selftest=1; shift ;;
        *) usage ;;
    esac
done
[ -f "$classify_lib" ] || { echo "ERROR — missing shared classifier: $classify_lib"; exit 2; }

core_rows() { sed -E -n 's/^[[:space:]]*-[[:space:]]*CORE\|(.*)$/\1/p' "$1"; }
kernel_rows() { sed -E -n 's/^[[:space:]]*-[[:space:]]*(K0|K1|P_STATIC|P_DYN)\|/\1|/p' "$1"; }

run_check() {
    check_root=$1; check_manifest=$2; check_kernel_manifest=$3
    case "$check_manifest" in /*) ;; *) check_manifest=$check_root/$check_manifest ;; esac
    case "$check_kernel_manifest" in /*) ;; *) check_kernel_manifest=$check_root/$check_kernel_manifest ;; esac
    [ -f "$check_manifest" ] || { echo "ERROR — core-lib manifest missing: $check_manifest"; return 2; }
    [ -f "$check_kernel_manifest" ] || { echo "ERROR — kernel manifest missing: $check_kernel_manifest"; return 2; }
    grep -q '^schema: simple/compiler/core-lib-closure/v1$' "$check_manifest" || { echo "ERROR — unsupported or missing core-lib closure schema"; return 2; }
    grep -q '^schema: simple/compiler/kernel-closure/v1$' "$check_kernel_manifest" || { echo "ERROR — unsupported or missing kernel closure schema"; return 2; }

    temp_dir=$(mktemp -d); trap 'rm -rf "$temp_dir"' EXIT HUP INT TERM
    krows=$temp_dir/krows; cfiles=$temp_dir/cfiles; kindex=$temp_dir/kindex
    seeds=$temp_dir/seeds; libfiles=$temp_dir/libfiles; crows=$temp_dir/crows
    reached=$temp_dir/reached

    kernel_rows "$check_kernel_manifest" > "$krows"
    [ -s "$krows" ] || { echo "ERROR — no kernel classification rows"; return 2; }
    (cd "$check_root" && find src/compiler -type f -name '*.spl' -print | LC_ALL=C sort) > "$cfiles"
    [ -s "$cfiles" ] || { echo "ERROR — nothing was checked (no compiler files)"; return 2; }

    classify_main=$temp_dir/classify_main.awk
    cat > "$classify_main" <<'AWKEOF'
        NR == FNR { classes[++rules] = $1; regex[rules] = pattern_regex($2); next }
        {
            class = ""
            for (i = 1; i <= rules; i++) if ($0 ~ regex[i]) { class = classes[i]; break }
            if (class != "") print class "|" $0
        }
AWKEOF
    awk -f "$classify_lib" -f "$classify_main" -F '|' "$krows" "$cfiles" > "$kindex"
    [ -s "$kindex" ] || { echo "ERROR — no compiler file classified as K0/K1"; return 2; }
    if [ "$include_k1" -eq 1 ]; then
        awk -F '|' '$1 == "K0" || $1 == "K1" { print $2 }' "$kindex" > "$seeds"
    else
        awk -F '|' '$1 == "K0" { print $2 }' "$kindex" > "$seeds"
    fi
    [ -s "$seeds" ] || { echo "ERROR — no K0 seed files"; return 2; }

    (cd "$check_root" && find src/lib -type f -name '*.spl' -print | LC_ALL=C sort) > "$libfiles"
    [ -s "$libfiles" ] || { echo "ERROR — nothing was checked (no src/lib files)"; return 2; }
    core_rows "$check_manifest" > "$crows"
    [ -s "$crows" ] || { echo "ERROR — no CORE rows in core-lib manifest"; return 2; }

    bfs_main=$temp_dir/bfs_main.awk
    cat > "$bfs_main" <<'AWKEOF'
        BEGIN { root_dir = ROOT_DIR }
        FNR == 1 { filearg++ }
        filearg == 1 { lib_by_path[$0] = 1
            dotted = $0
            sub(/^src\/lib\//, "", dotted)
            sub(/[.]spl$/, "", dotted)
            gsub(/\//, ".", dotted)
            if (dotted in dotted_owner) dotted_owner[dotted] = dotted_owner[dotted] ";" $0
            else dotted_owner[dotted] = $0
            all_dotted[dotted] = 1
            next
        }
        filearg == 2 { core_patterns[++n_core] = pattern_regex($0); next }
        filearg == 3 { seed_files[$0] = 1; next }

        function resolve(imp,    cand, i, tail, n, parts, shortened) {
            if (imp in dotted_owner) return dotted_owner[imp]
            # Trailing component may be a bare symbol name rather than a
            # submodule (`use std.a.b.Symbol`); retry one level shorter.
            shortened = imp
            sub(/[.][^.]*$/, "", shortened)
            if (shortened != imp && (shortened in dotted_owner)) return dotted_owner[shortened]
            # Suffix match: some real files live at a shorter or differently
            # rooted dotted path than the literal import (mirrors the
            # kernel-closure checker's parent/basename fallback — a shell
            # classifier cannot re-implement the real module resolver).
            for (cand in all_dotted) {
                if (cand == imp || cand ~ ("(^|[.])" imp "$")) return dotted_owner[cand]
            }
            if (shortened != imp) {
                for (cand in all_dotted) {
                    if (cand == shortened || cand ~ ("(^|[.])" shortened "$")) return dotted_owner[cand]
                }
            }
            return ""
        }

        function scan_file(path,    line, m, imp, targets, n, i, t) {
            if (path in scanned) return
            scanned[path] = 1
            full = root_dir "/" path
            while ((getline line < full) > 0) {
                if (line ~ /^[[:space:]]*(pub[[:space:]]+|export[[:space:]]+)?use[[:space:]]+std\.[A-Za-z0-9_.]+/) {
                    imp = line
                    sub(/^[[:space:]]*(pub[[:space:]]+|export[[:space:]]+)?use[[:space:]]+std\./, "", imp)
                    sub(/[^A-Za-z0-9_.].*$/, "", imp)
                    sub(/[.]$/, "", imp)
                    if (imp == "") continue
                    targets = resolve(imp)
                    if (targets == "") { unresolved[path "|" imp] = 1; continue }
                    n = split(targets, parts, ";")
                    for (i = 1; i <= n; i++) {
                        t = parts[i]
                        if (!(t in reached)) {
                            reached[t] = 1
                            frontier[++fn] = t
                        }
                    }
                }
            }
            close(full)
        }

        END {
            for (s in seed_files) scan_file(s)
            round = 0
            while (fn > 0 && round < 200) {
                round++
                cur = fn; fn = 0
                for (i = 1; i <= cur; i++) scan_file(frontier[i])
                delete frontier
            }
            for (t in reached) {
                class = ""
                for (i = 1; i <= n_core; i++) if (t ~ core_patterns[i]) { class = "CORE"; break }
                print (class == "CORE" ? "CORE" : "HOST") "|" t
            }
        }
AWKEOF
    awk -v ROOT_DIR="$check_root" -f "$classify_lib" -f "$bfs_main" "$libfiles" "$crows" "$seeds" > "$reached"
    reached_count=$(wc -l < "$reached" | tr -d ' ')
    [ "$reached_count" -gt 0 ] || { echo "ERROR — nothing was checked (BFS reached 0 files)"; return 2; }
    host_count=$(awk -F '|' '$1 == "HOST"' "$reached" | wc -l | tr -d ' ')

    awk -F '|' '$1 == "HOST" { print $2 }' "$reached" | LC_ALL=C sort > "$temp_dir/host_now"

    if [ "$generate_baseline" -eq 1 ]; then
        LC_ALL=C sort "$reached" | awk -F '|' '{ print $2 }' > "$baseline"
        echo "PASS — baseline regenerated: $reached_count file(s) reached, $host_count outside CORE, written to $baseline"
        return 0
    fi

    if [ ! -f "$baseline" ]; then
        echo "FAIL — $reached_count reached, $host_count package(s) outside CORE, no baseline file at $baseline (run --generate-baseline)"
        return 1
    fi
    LC_ALL=C sort "$baseline" > "$temp_dir/baseline_sorted"
    awk -F '|' '$1 == "HOST" { print $2 }' "$reached" | LC_ALL=C sort > "$temp_dir/host_sorted"
    # NEW non-core file reached = growth = FAIL, always.
    new_files=$temp_dir/new_files
    comm -23 "$temp_dir/host_sorted" "$temp_dir/baseline_sorted" > "$new_files" 2>/dev/null || \
        grep -Fxvf "$temp_dir/baseline_sorted" "$temp_dir/host_sorted" > "$new_files" 2>/dev/null || : > "$new_files"
    new_count=$(wc -l < "$new_files" | tr -d ' ')
    # Baselined-but-no-longer-reached-as-HOST = stale. Until OD-4 accepts the
    # core-lib set this is a WARN, not a FAIL (see file header).
    stale_files=$temp_dir/stale_files
    comm -13 "$temp_dir/host_sorted" "$temp_dir/baseline_sorted" > "$stale_files" 2>/dev/null || \
        grep -Fxvf "$temp_dir/host_sorted" "$temp_dir/baseline_sorted" > "$stale_files" 2>/dev/null || : > "$stale_files"
    stale_count=$(wc -l < "$stale_files" | tr -d ' ')

    if [ "$stale_count" -gt 0 ]; then
        echo "WARN — $stale_count baselined file(s) no longer reached (stale baseline, not failing pre-OD-4):"
        sed 's/^/  /' "$stale_files"
    fi
    if [ "$new_count" -gt 0 ]; then
        echo "FAIL KERNEL-CORE-LIB-001 new non-core file(s) reached:"
        sed 's/^/  /' "$new_files"
        echo "FAIL — $reached_count reached, $host_count outside CORE, $new_count NEW (baseline had $(wc -l < "$temp_dir/baseline_sorted" | tr -d ' '))"
        return 1
    fi
    echo "PASS — $reached_count reached, $host_count outside CORE, 0 new (baseline $(wc -l < "$temp_dir/baseline_sorted" | tr -d ' '))"
}

run_selftest() {
    fixture=$(mktemp -d); trap 'rm -rf "$fixture"' EXIT HUP INT TERM
    mkdir -p "$fixture/src/compiler/10.frontend" "$fixture/src/lib/common" "$fixture/src/lib/database"
    printf '%s\n' 'schema: simple/compiler/kernel-closure/v1' 'entries:' '  - K0|src/compiler/10.frontend/**' > "$fixture/kernel.sdn"
    printf '%s\n' 'schema: simple/compiler/core-lib-closure/v1' 'entries:' '  - CORE|src/lib/common/**' > "$fixture/core.sdn"

    reset_fixture() {
        printf 'fn go() -> i64:\n    1\n' > "$fixture/src/compiler/10.frontend/entry.spl"
        printf 'fn util() -> i64:\n    2\n' > "$fixture/src/lib/common/util.spl"
        printf 'fn q() -> i64:\n    3\n' > "$fixture/src/lib/database/query.spl"
    }
    reset_fixture
    baseline=$fixture/baseline.txt

    # --- clean: reaches only common/util (CORE), never database/query ---
    printf 'use std.common.util.{util}\n' >> "$fixture/src/compiler/10.frontend/entry.spl"
    generate_baseline=1
    out=$(run_check "$fixture" "$fixture/core.sdn" "$fixture/kernel.sdn" 2>&1)
    generate_baseline=0
    printf '%s\n' "$out" | grep -q 'baseline regenerated' || { echo "self-test: generate-baseline failed: $out"; return 1; }
    out=$(run_check "$fixture" "$fixture/core.sdn" "$fixture/kernel.sdn" 2>&1)
    st=$?
    printf '%s\n' "$out" | grep -q '^PASS' || { echo "self-test: clean fixture did not PASS: $out"; return 1; }

    # --- growth: K0 now also reaches database/query (HOST, not CORE) -> FAIL ---
    printf 'use std.database.query.{q}\n' >> "$fixture/src/compiler/10.frontend/entry.spl"
    out=$(run_check "$fixture" "$fixture/core.sdn" "$fixture/kernel.sdn" 2>&1) && { echo "self-test: growth into non-core lib went undetected"; return 1; }
    printf '%s\n' "$out" | grep -q 'KERNEL-CORE-LIB-001' || { echo "self-test: growth violation not reported: $out"; return 1; }

    # --- stale baseline: revert edit, baseline still expects nothing extra -> back to PASS ---
    reset_fixture
    printf 'use std.common.util.{util}\n' >> "$fixture/src/compiler/10.frontend/entry.spl"
    out=$(run_check "$fixture" "$fixture/core.sdn" "$fixture/kernel.sdn" 2>&1)
    printf '%s\n' "$out" | grep -q '^PASS' || { echo "self-test: reverted fixture did not return to PASS: $out"; return 1; }

    # --- empty tree must not vacuously pass ---
    rm -f "$fixture/src/compiler/10.frontend/entry.spl"
    if run_check "$fixture" "$fixture/core.sdn" "$fixture/kernel.sdn" >/dev/null 2>&1; then echo "self-test: empty fixture unexpectedly passed"; return 1; fi

    echo "core-lib closure self-test OK (5 fixtures)"
}

if [ "$selftest" -eq 1 ]; then run_selftest; else run_check "$root" "$manifest" "$kernel_manifest"; fi
