#!/bin/sh
# Fail-closed provenance admission for the PostgreSQL-mimic native runtime.
# Prints a normalized receipt only after the archive and every retained core-C
# object match the hashes in the capsule producer's immutable manifest.
set -eu

CAPSULE_DIR=${1:-}
[ -n "$CAPSULE_DIR" ] || { echo "FAIL: DB runtime capsule path is required" >&2; exit 2; }
[ -d "$CAPSULE_DIR" ] || { echo "FAIL: DB runtime capsule directory is missing: $CAPSULE_DIR" >&2; exit 2; }

CAPSULE_DIR=$(CDPATH= cd -- "$CAPSULE_DIR" && pwd -P)
ARCHIVE="$CAPSULE_DIR/libsimple_runtime.a"
MANIFEST="$CAPSULE_DIR/capsule.manifest"
OBJECT_DIR="$CAPSULE_DIR/objects"

hash_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        shasum -a 256 "$1" | awk '{print $1}'
    fi
}

manifest_value() {
    key=$1
    awk -F= -v key="$key" '$1 == key { value=substr($0, index($0, "=") + 1); count++ } END { if (count == 1) print value; else exit 1 }' "$MANIFEST"
}

fail() { echo "FAIL: DB runtime capsule provenance: $*" >&2; exit 3; }

[ -s "$ARCHIVE" ] || fail "selected archive is missing or empty: $ARCHIVE"
[ -s "$MANIFEST" ] || fail "capsule manifest is missing or empty: $MANIFEST"
[ -d "$OBJECT_DIR" ] || fail "core-C object directory is missing: $OBJECT_DIR"
[ "$(manifest_value schema || true)" = core-c-bootstrap-runtime-capsule-v1 ] || fail "unsupported or ambiguous manifest schema"
[ "$(manifest_value status || true)" = pass ] || fail "manifest status is not pass"
[ "$(manifest_value repeated_build_equal || true)" = true ] || fail "reproducible archive proof is absent"

ARCHIVE_SHA256=$(hash_file "$ARCHIVE")
[ "$(manifest_value archive_sha256 || true)" = "$ARCHIVE_SHA256" ] || fail "selected archive hash does not match manifest"
[ "$(manifest_value repeat_archive_sha256 || true)" = "$ARCHIVE_SHA256" ] || fail "selected archive does not match repeated-build hash"

OBJECT_COUNT=0
for object in "$OBJECT_DIR"/*.o; do
    [ -f "$object" ] || continue
    OBJECT_COUNT=$((OBJECT_COUNT + 1))
    member=$(basename -- "$object")
    key=$(printf '%s' "$member" | tr '/.' '__')
    actual=$(hash_file "$object")
    expected=$(manifest_value "object_${key}_sha256" || true)
    [ -n "$expected" ] || fail "manifest omits core-C object: $member"
    [ "$actual" = "$expected" ] || fail "core-C object hash mismatch: $member"
done
[ "$OBJECT_COUNT" -gt 0 ] || fail "capsule contains no core-C objects"

# Reject a manifest that names an object no longer retained by the capsule.
MANIFEST_OBJECT_COUNT=$(awk -F= '$1 ~ /^object_.*_sha256$/ { count++ } END { print count + 0 }' "$MANIFEST")
[ "$MANIFEST_OBJECT_COUNT" -eq "$OBJECT_COUNT" ] || fail "manifest/object count mismatch: manifest=$MANIFEST_OBJECT_COUNT retained=$OBJECT_COUNT"

printf '%s\n' \
    "db_runtime_provenance_schema=db-runtime-capsule-provenance-v1" \
    "db_runtime_provenance_status=pass" \
    "db_runtime_capsule_dir=$CAPSULE_DIR" \
    "db_runtime_archive=$ARCHIVE" \
    "db_runtime_archive_sha256=$ARCHIVE_SHA256" \
    "db_runtime_manifest=$MANIFEST" \
    "db_runtime_manifest_sha256=$(hash_file "$MANIFEST")" \
    "db_runtime_core_c_object_count=$OBJECT_COUNT"
