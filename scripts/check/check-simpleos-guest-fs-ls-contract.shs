#!/bin/sh
set -eu

fail() { echo "simpleos-guest-fs-ls-contract: $*" >&2; exit 1; }
[ "${1:-}" = "--self-test" ] || fail "usage: $0 --self-test"

extract_function() {
    file=$1
    function_name=$2
    awk -v needle="${function_name}(void)" '
        index($0, needle) { active=1 }
        active && seen && /^(RuntimeValue|int64_t) / { exit }
        active { print; seen=1 }
    ' "$file"
}

rv_body=$(extract_function examples/09_embedded/simple_os/arch/common/riscv_common.h rt_riscv_fs_ls_sys_apps)
arm_body=$(extract_function examples/09_embedded/simple_os/arch/arm32/boot/baremetal_stubs.c rt_arm32_fs_ls_sys_apps)
x86_64_body=$(extract_function examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c rt_x86_64_fs_ls_sys_apps)

for body in "$rv_body" "$arm_body" "$x86_64_body"; do
    [ -n "$body" ] || fail "listing function missing"
    printf '%s\n' "$body" | grep -Eq 'data \+ off|dir_buf \+ i \* 32U' || fail "dirent walk missing"
    printf '%s\n' "$body" | grep -q 'FS_LS_ENTRY name=' || fail "entry marker missing"
    printf '%s\n' "$body" | grep -q 'FS_LS_END status=pass' || fail "end marker missing"
    if printf '%s\n' "$body" | grep -Eq 'HELLOSMF|BROWSMF|SIMPLSTC|SCOMPSMF'; then
        fail "fixed application name embedded in listing function"
    fi
done

echo "PASS SimpleOS guest FAT listing source contract"
