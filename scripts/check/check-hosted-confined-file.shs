#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
work=${TMPDIR:-/tmp}/simple-hosted-confined-file-$$
trap 'rm -f "$work"' EXIT HUP INT TERM

cc -std=c11 -O2 -Wall -Wextra -Werror \
    -Wl,--wrap=malloc -Wl,--wrap=calloc -Wl,--wrap=realloc \
    "$root/src/runtime/test/runtime_hosted_confined_file_selfcheck.c" \
    -o "$work"
"$work"

grep -q 'O_NOFOLLOW.*O_CLOEXEC' \
    "$root/src/runtime/platform/hosted_confined_file_impl.h"
grep -q 'openat(parent, part' \
    "$root/src/runtime/platform/hosted_confined_file_impl.h"
grep -q 'allocation_count_after_seal).to_equal(0)' \
    "$root/test/02_integration/app/hal_environment_file_executor_spec.spl"

echo 'hosted-confined-file gate: PASS'
