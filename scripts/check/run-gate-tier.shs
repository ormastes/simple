#!/bin/sh
# One runner for one manifest tier, used by both the local pre-push/land path
# and the remote `fast-gates` job (goal item 5, WP3 of
# doc/.../push_hook_plan.md section B/D). It reads
# config/check/must_check_gates.sdn (or a fixture manifest under --selftest),
# selects a tier's rows, substitutes {range}/{rev}/{base} placeholders, runs
# the rows with a job-slot limit under a wall budget, and writes `<id>
# <status>` lines in the exact format scripts/check/sign-local-ci-receipt.shs
# consumes via --results (status is the literal word "pass"; anything else,
# e.g. "fail" or "error", is treated by the signer as not-pass).
#
# Usage:
#   sh run-gate-tier.shs --tier <t> (--range B..H | --ref H | --rev H) [--base B]
#                         [--jobs N] [--budget S] [--results FILE]
#                         [--manifest-rev REV] [--manifest-file PATH]
#   sh run-gate-tier.shs --selftest
#
#   --tier <t>        select rows whose `tier` column equals <t>. For
#                      tier=local this ADDITIONALLY unions every row (any
#                      tier) with push_blocking=true — the local tier is
#                      defined as "exactly the rows of the required remote
#                      check" (plan section A.5): the 6 local rows plus the 4
#                      push-blocking rows. Rows are deduplicated by id.
#   --range B..H       value substituted for a `{range}` placeholder.
#   --ref H            value substituted for a `{rev}` placeholder (--rev is
#                       an accepted alias — land.shs calls exactly `--tier
#                       local --rev "$TIP"`). When
#                       --range is omitted but --ref is given, the range is
#                       DERIVED as `${base}..${ref}`, where --base defaults to
#                       `origin/main` (land.shs's own invocation is exactly
#                       `--tier local --rev "$TIP"`, no --range/--base). If
#                       origin/main does not resolve locally (a shallow clone
#                       that never fetched it, or a fresh worktree that never
#                       fetched origin) this is a fail-closed ERROR naming the
#                       missing ref, never a silent range guess.
#   --base B           value substituted for a `{base}` placeholder, and the
#                       base of a range derived from --ref per above.
#   --jobs N           max concurrent rows (default 16, comfortably above the
#                       local tier's own row count so nothing queues).
#   --budget S         wall-clock budget in seconds for the whole tier
#                       (default 90). The plan's local-tier target is ~60s on
#                       Windows (~35s ideal); measured wall on this host
#                       varied 51-61s across otherwise-identical runs under
#                       load, so 90 is a conservative default that avoids a
#                       spurious budget-kill from pure scheduling jitter.
#                       Pass --budget 55-60 explicitly to enforce the tighter
#                       Windows local-tier target. Rows still running when the
#                       budget elapses are killed and recorded `error`; the
#                       overall verdict becomes ERROR, never a pass.
#   --results FILE     write `<id> <status>` lines here (default: stdout).
#   --manifest-rev REV read config/check/must_check_gates.sdn from this
#                       committed revision via `git show` (default: the
#                       working tree file). This is how the fast-gates job
#                       reads the PR's own manifest rather than trusting a
#                       stale checkout.
#   --manifest-file P  read the manifest from this literal path instead of
#                       git or the default location (selftest fixtures).
#
# Verdict (last line of stdout): `PASS — <n> row(s), 0 failed` exit 0 /
# `FAIL — <n> row(s), <k> failed: <ids>` exit 1 / `ERROR — nothing was
# checked (<reason>)` exit 2. A budget kill or a 0-row selection is always
# ERROR, never a pass.
set -u
# Job control ON: every `&` background job below gets its OWN process group
# (pgid == its own pid), so a budget kill can signal `-$pid` (the group, i.e.
# the row's sh -c AND every child it forked -- git, awk, grep, ...) rather
# than only the wrapper subshell, which would otherwise leave the real work
# running past the budget. `set -m` is a no-op, not an error, on a shell that
# ignores it (harmless if this ever runs under a non-interactive dash build
# that lacks monitor mode); the -TERM/-KILL calls below are best-effort either
# way (`2>/dev/null`).
set -m 2>/dev/null || true

ROOT=${RUN_GATE_TIER_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null)}
[ -n "$ROOT" ] || { echo "run-gate-tier: ERROR — nothing was checked (cannot locate repository root)" >&2; exit 2; }
ROOT=$(CDPATH= cd -- "$ROOT" 2>/dev/null && pwd -P) || {
    echo "run-gate-tier: ERROR — nothing was checked (cannot canonicalize repository root)" >&2
    exit 2
}
MANIFEST_REL=${MUST_CHECK_MANIFEST_REL:-config/check/must_check_gates.sdn}

TIER=""
RANGE=""
REF=""
BASE=""
JOBS=16
BUDGET_S=90
RESULTS=""
MANIFEST_REV=""
MANIFEST_FILE=""
DO_SELFTEST=0

while [ $# -gt 0 ]; do
    case "$1" in
        --tier) TIER=$2; shift 2 ;;
        --range) RANGE=$2; shift 2 ;;
        --ref|--rev) REF=$2; shift 2 ;;
        --base) BASE=$2; shift 2 ;;
        --jobs) JOBS=$2; shift 2 ;;
        --budget) BUDGET_S=$2; shift 2 ;;
        --results) RESULTS=$2; shift 2 ;;
        --manifest-rev) MANIFEST_REV=$2; shift 2 ;;
        --manifest-file) MANIFEST_FILE=$2; shift 2 ;;
        --selftest) DO_SELFTEST=1; shift ;;
        *) echo "run-gate-tier: ERROR — nothing was checked (unknown argument $1)" >&2; exit 2 ;;
    esac
done

case "$JOBS" in ''|*[!0-9]*) echo "run-gate-tier: ERROR — nothing was checked (--jobs must be a positive integer)" >&2; exit 2 ;; esac
case "$BUDGET_S" in ''|*[!0-9]*) echo "run-gate-tier: ERROR — nothing was checked (--budget must be a positive integer)" >&2; exit 2 ;; esac
[ "$JOBS" -ge 1 ] || { echo "run-gate-tier: ERROR — nothing was checked (--jobs must be >= 1)" >&2; exit 2; }
[ "$BUDGET_S" -ge 1 ] || { echo "run-gate-tier: ERROR — nothing was checked (--budget must be >= 1)" >&2; exit 2; }

now_ms() {
    _ms=$(date +%s%N 2>/dev/null)
    case "$_ms" in
        *[!0-9]*|'') echo $(( $(date +%s) * 1000 )) ;;
        *) echo $(( _ms / 1000000 )) ;;
    esac
}

# sed-escape a substitution value: backslash, ampersand, then the delimiter.
sed_escape() { printf '%s' "$1" | sed -e 's/[\&/]/\\&/g'; }

read_manifest_text() {
    if [ -n "$MANIFEST_FILE" ]; then
        cat "$MANIFEST_FILE" 2>/dev/null
        return $?
    fi
    if [ -n "$MANIFEST_REV" ]; then
        git -C "$ROOT" show "$MANIFEST_REV:$MANIFEST_REL" 2>/dev/null
        return $?
    fi
    cat "$ROOT/$MANIFEST_REL" 2>/dev/null
}

# select_rows MANIFEST_TEXT TIER -> tab-separated id\tpush_blocking\tcommand
# on stdout, one row per line. Applies the local-tier union rule.
select_rows() {
    _text=$1
    _tier=$2
    printf '%s\n' "$_text" | awk -F, -v want_tier="$_tier" '
        function trim(v) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", v); return v }
        function nosp(v) { gsub(/ /, "", v); return v }
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*$/ { next }
        /^must_check_gates[[:space:]]*\|/ { next }
        {
            id = trim($1)
            if (id == "" || id ~ /^must_check_gates$/) next
            tier = nosp($2); blocking = nosp($3)
            cmd = $5; sub(/^[[:space:]]*"/, "", cmd); sub(/"[[:space:]]*$/, "", cmd)
            if (id == "" || tier == "" || cmd == "") next
            keep = 0
            if (tier == want_tier) keep = 1
            # local-tier union rule (plan A.5): the local tier is exactly the
            # rows of the required remote check, i.e. the local rows PLUS the
            # push tiers own blocking rows -- not every blocking row in every
            # tier (bootstrap and ci rows use the same column for a different,
            # tier-local meaning of required).
            if (want_tier == "local" && tier == "push" && blocking == "true") keep = 1
            if (keep && !seen[id]++) printf "%s\t%s\t%s\n", id, blocking, cmd
        }'
}

# substitute_placeholders CMD -> expands {range}/{rev}/{base}; prints nothing
# and returns 1 if a placeholder is present but its value is unset (fail
# closed rather than silently running a truncated command).
substitute_placeholders() {
    _cmd=$1
    case "$_cmd" in
        *'{range}'*)
            [ -n "$RANGE" ] || return 1
            _cmd=$(printf '%s' "$_cmd" | sed "s/{range}/$(sed_escape "$RANGE")/g") ;;
    esac
    case "$_cmd" in
        *'{rev}'*)
            [ -n "$REF" ] || return 1
            _cmd=$(printf '%s' "$_cmd" | sed "s/{rev}/$(sed_escape "$REF")/g") ;;
    esac
    case "$_cmd" in
        *'{base}'*)
            [ -n "$BASE" ] || return 1
            _cmd=$(printf '%s' "$_cmd" | sed "s/{base}/$(sed_escape "$BASE")/g") ;;
    esac
    printf '%s' "$_cmd"
}

# run_tier TIER RANGE REF BASE JOBS BUDGET_S RESULTS_FILE MANIFEST_TEXT
# Writes verdict to stdout, `<id> <status>` lines to RESULTS_FILE (or stdout
# if RESULTS_FILE is empty), returns 0/1/2.
run_tier() {
    _tier=$1; _jobs=$2; _budget_s=$3; _results=$4; _mtext=$5
    _rows=$(mktemp) || { echo "run-gate-tier: ERROR — nothing was checked (mktemp failed)" >&2; return 2; }
    select_rows "$_mtext" "$_tier" > "$_rows"
    if [ ! -s "$_rows" ]; then
        rm -f "$_rows"
        echo "run-gate-tier: ERROR — nothing was checked (tier '$_tier' selected 0 rows)" >&2
        return 2
    fi

    _work=$(mktemp -d) || { rm -f "$_rows"; echo "run-gate-tier: ERROR — nothing was checked (mktemp -d failed)" >&2; return 2; }
    # Every row's command is a bare `sh scripts/check/...` relative to the
    # repo root; cd there once so a caller running from an arbitrary cwd (or
    # none of the rows themselves re-deriving root) still resolves correctly.
    cd "$ROOT" || { rm -rf "$_work" "$_rows"; echo "run-gate-tier: ERROR — nothing was checked (cannot cd to repo root $ROOT)" >&2; return 2; }
    _active="$_work/active"; : > "$_active"
    _lines=$(wc -l < "$_rows" | tr -d ' ')
    _t0=$(now_ms)
    _budget_ms=$(( _budget_s * 1000 ))
    _killed=0
    _tab=$(printf '\t')

    _n=0
    while IFS="$_tab" read -r _id _blocking _cmd; do
        _n=$((_n + 1))
        _expanded=$(substitute_placeholders "$_cmd") || {
            printf '%s error\n' "$_id" >> "$_work/verdicts"
            echo "run-gate-tier: row $_id: ERROR — placeholder in '$_cmd' has no value supplied" >&2
            continue
        }
        # Throttle to $_jobs concurrent rows; reap finished ones by polling
        # kill -0 (still-a-zombie test) then `wait` (retrieves the exit
        # status POSIX-portably; no bash-only `wait -n` is used).
        while :; do
            _running=0
            : > "$_active.next"
            while IFS=" " read -r _pid _rid; do
                [ -n "$_pid" ] || continue
                if kill -0 "$_pid" 2>/dev/null; then
                    echo "$_pid $_rid" >> "$_active.next"
                    _running=$((_running + 1))
                else
                    wait "$_pid" 2>/dev/null
                    _rc=$(cat "$_work/$_rid.rc" 2>/dev/null || echo 999)
                    if [ "$_rc" = 0 ]; then
                        printf '%s pass\n' "$_rid" >> "$_work/verdicts"
                    else
                        printf '%s fail\n' "$_rid" >> "$_work/verdicts"
                    fi
                fi
            done < "$_active"
            mv -f "$_active.next" "$_active"
            _elapsed=$(( $(now_ms) - _t0 ))
            if [ "$_elapsed" -ge "$_budget_ms" ]; then
                break
            fi
            [ "$_running" -lt "$_jobs" ] && break
            sleep 1
        done
        _elapsed=$(( $(now_ms) - _t0 ))
        if [ "$_elapsed" -ge "$_budget_ms" ]; then
            printf '%s error\n' "$_id" >> "$_work/verdicts"
            _killed=1
            continue
        fi
        # </dev/null: a row must never block on or steal stdin from the
        # runner (or, worse, from whatever launched the runner -- a pre-push
        # hook's stdin is the pushed ref rows, and an inherited-stdin row can
        # silently swallow lines job N+1 needed to read).
        ( sh -c "$_expanded" </dev/null >"$_work/$_id.log" 2>&1; echo $? > "$_work/$_id.rc" ) &
        echo "$! $_id" >> "$_active"
    done < "$_rows"

    # Drain remaining rows against whatever budget is left; anything still
    # running when the budget elapses is killed and recorded `error`.
    while [ -s "$_active" ]; do
        _elapsed=$(( $(now_ms) - _t0 ))
        if [ "$_elapsed" -ge "$_budget_ms" ]; then
            # Signal the whole GROUP (`-$pid`, negative pid under `set -m`
            # above), not just the wrapper subshell: the wrapper's own exit
            # does not touch children it forked (git, awk, grep, a nested
            # sh -c), which would otherwise keep running past the budget and
            # keep burning the host's CPU/IO for a verdict nobody reads.
            # Fall back to the bare pid too, in case job control did not
            # actually grant this job its own process group on this shell.
            while IFS=" " read -r _pid _rid; do
                [ -n "$_pid" ] || continue
                kill -TERM -- "-$_pid" 2>/dev/null
                kill -TERM "$_pid" 2>/dev/null
            done < "$_active"
            sleep 1
            while IFS=" " read -r _pid _rid; do
                [ -n "$_pid" ] || continue
                kill -KILL -- "-$_pid" 2>/dev/null
                kill -KILL "$_pid" 2>/dev/null
                wait "$_pid" 2>/dev/null
                printf '%s error\n' "$_rid" >> "$_work/verdicts"
            done < "$_active"
            : > "$_active"
            _killed=1
            break
        fi
        : > "$_active.next"
        while IFS=" " read -r _pid _rid; do
            [ -n "$_pid" ] || continue
            if kill -0 "$_pid" 2>/dev/null; then
                echo "$_pid $_rid" >> "$_active.next"
            else
                wait "$_pid" 2>/dev/null
                _rc=$(cat "$_work/$_rid.rc" 2>/dev/null || echo 999)
                if [ "$_rc" = 0 ]; then
                    printf '%s pass\n' "$_rid" >> "$_work/verdicts"
                else
                    printf '%s fail\n' "$_rid" >> "$_work/verdicts"
                fi
            fi
        done < "$_active"
        mv -f "$_active.next" "$_active"
        [ -s "$_active" ] && sleep 1
    done

    [ -f "$_work/verdicts" ] || : > "$_work/verdicts"
    if [ -n "$_results" ]; then
        cp "$_work/verdicts" "$_results" || { rm -rf "$_work" "$_rows"; echo "run-gate-tier: ERROR — nothing was checked (cannot write --results $_results)" >&2; return 2; }
    else
        cat "$_work/verdicts"
    fi

    _checked=$(wc -l < "$_work/verdicts" | tr -d ' ')
    _failed_ids=$(awk '$2 != "pass" {printf "%s ", $1}' "$_work/verdicts" | sed 's/ *$//')
    _failed_n=$(awk '$2 != "pass"' "$_work/verdicts" | wc -l | tr -d ' ')
    _error_ids=$(awk '$2 == "error" {printf "%s ", $1}' "$_work/verdicts" | sed 's/ *$//')
    rm -rf "$_work" "$_rows"

    if [ "$_killed" = 1 ]; then
        echo "run-gate-tier: ERROR — nothing was checked (tier '$_tier' exceeded its ${_budget_s}s budget; killed row(s): $_error_ids)" >&2
        return 2
    fi
    if [ "$_failed_n" -gt 0 ]; then
        echo "FAIL — $_checked row(s) checked, $_failed_n failed: $_failed_ids"
        return 1
    fi
    echo "PASS — $_checked row(s) checked, 0 failed"
    return 0
}

if [ "$DO_SELFTEST" = 1 ]; then
    ST_FAILURES=0
    ST_T=$(mktemp -d) || exit 2
    trap 'rm -rf "$ST_T"' EXIT INT TERM

    st_report() {
        if [ "$1" = ok ]; then
            printf 'selftest: PASS %s\n' "$2"
        else
            printf 'selftest: FAIL %s — %s\n' "$2" "$3"
            ST_FAILURES=$((ST_FAILURES + 1))
        fi
    }

    HDR='must_check_gates |id, tier, push_blocking, mode, command, ci_job, inputs, description|'

    # (1) basic tier selection + parallel execution, all-pass.
    cat > "$ST_T/m1.sdn" <<EOF
$HDR
    g-one, local, false, tree, "sh -c 'exit 0'", -, -, "one"
    g-two, local, false, tree, "sh -c 'exit 0'", -, -, "two"
    g-three, push, false, tree, "sh -c 'exit 0'", -, -, "not local, not blocking, excluded"
EOF
    out=$(sh "$0" --tier local --manifest-file "$ST_T/m1.sdn" --budget 20 --jobs 4 --results "$ST_T/r1.out" 2>"$ST_T/r1.err")
    rc=$?
    if [ "$rc" -eq 0 ] && [ "$(wc -l < "$ST_T/r1.out" | tr -d ' ')" = 2 ] && ! grep -q g-three "$ST_T/r1.out"; then
        st_report ok "(S1) two-row local tier, both pass, push row excluded"
    else
        st_report bad "(S1) two-row local tier, both pass, push row excluded" "rc=$rc out=$(cat "$ST_T/r1.out" 2>/dev/null)"
    fi

    # (2) local tier unions push_blocking=true rows from another tier.
    cat > "$ST_T/m2.sdn" <<EOF
$HDR
    g-local, local, false, tree, "sh -c 'exit 0'", -, -, "local row"
    g-block, push, true, tree, "sh -c 'exit 0'", -, -, "push-blocking row, must union into local"
    g-adv, push, false, tree, "sh -c 'exit 0'", -, -, "advisory push row, must NOT union"
EOF
    out=$(sh "$0" --tier local --manifest-file "$ST_T/m2.sdn" --budget 20 --jobs 4 --results "$ST_T/r2.out" 2>"$ST_T/r2.err")
    rc=$?
    if [ "$rc" -eq 0 ] && grep -q '^g-block pass$' "$ST_T/r2.out" && grep -q '^g-local pass$' "$ST_T/r2.out" && ! grep -q g-adv "$ST_T/r2.out"; then
        st_report ok "(S2) local tier unions push_blocking=true rows"
    else
        st_report bad "(S2) local tier unions push_blocking=true rows" "rc=$rc out=$(cat "$ST_T/r2.out" 2>/dev/null)"
    fi

    # (3) a failing row is recorded `fail`, overall FAIL exit 1.
    cat > "$ST_T/m3.sdn" <<EOF
$HDR
    g-ok, local, false, tree, "sh -c 'exit 0'", -, -, "ok"
    g-bad, local, false, tree, "sh -c 'exit 1'", -, -, "fails"
EOF
    out=$(sh "$0" --tier local --manifest-file "$ST_T/m3.sdn" --budget 20 --jobs 4 --results "$ST_T/r3.out" 2>"$ST_T/r3.err")
    rc=$?
    if [ "$rc" -eq 1 ] && grep -q '^g-bad fail$' "$ST_T/r3.out" && grep -q '^g-ok pass$' "$ST_T/r3.out"; then
        st_report ok "(S3) a failing row FAILs the tier and is recorded 'fail'"
    else
        st_report bad "(S3) a failing row FAILs the tier and is recorded 'fail'" "rc=$rc out=$(cat "$ST_T/r3.out" 2>/dev/null)"
    fi

    # (4) 0 selected rows is ERROR, never a pass.
    cat > "$ST_T/m4.sdn" <<EOF
$HDR
    g-other, ci, false, tree, "sh -c 'exit 0'", -, -, "wrong tier"
EOF
    sh "$0" --tier local --manifest-file "$ST_T/m4.sdn" --budget 20 --jobs 4 --results "$ST_T/r4.out" >/dev/null 2>"$ST_T/r4.err"
    rc=$?
    if [ "$rc" -eq 2 ] && grep -q '0 rows' "$ST_T/r4.err"; then
        st_report ok "(S4) 0 rows selected is ERROR"
    else
        st_report bad "(S4) 0 rows selected is ERROR" "rc=$rc err=$(cat "$ST_T/r4.err" 2>/dev/null)"
    fi

    # (5) a wall-budget kill yields ERROR, not a pass, for a row that outlives it.
    cat > "$ST_T/m5.sdn" <<EOF
$HDR
    g-slow, local, false, tree, "sh -c 'sleep 30'", -, -, "outlives the budget"
EOF
    t0=$(date +%s)
    sh "$0" --tier local --manifest-file "$ST_T/m5.sdn" --budget 2 --jobs 4 --results "$ST_T/r5.out" >/dev/null 2>"$ST_T/r5.err"
    rc=$?
    t1=$(date +%s)
    dt=$((t1 - t0))
    if [ "$rc" -eq 2 ] && [ "$dt" -lt 25 ] && grep -q 'budget' "$ST_T/r5.err"; then
        st_report ok "(S5) budget kill yields ERROR and returns promptly (${dt}s)"
    else
        st_report bad "(S5) budget kill yields ERROR and returns promptly" "rc=$rc dt=${dt}s err=$(cat "$ST_T/r5.err" 2>/dev/null)"
    fi

    # (6) placeholder substitution: {range}/{rev}/{base} all expand.
    cat > "$ST_T/m6.sdn" <<EOF
$HDR
    g-ph, local, false, range, "sh -c 'echo {range}/{rev}/{base} > $ST_T/ph.out'", -, -, "placeholders"
EOF
    sh "$0" --tier local --manifest-file "$ST_T/m6.sdn" --range 'B..H' --ref 'DEADBEEF' --base 'B' --budget 20 --jobs 2 --results "$ST_T/r6.out" >/dev/null 2>"$ST_T/r6.err"
    rc=$?
    if [ "$rc" -eq 0 ] && [ "$(cat "$ST_T/ph.out" 2>/dev/null)" = "B..H/DEADBEEF/B" ]; then
        st_report ok "(S6) {range}/{rev}/{base} placeholders substitute"
    else
        st_report bad "(S6) {range}/{rev}/{base} placeholders substitute" "rc=$rc got=$(cat "$ST_T/ph.out" 2>/dev/null)"
    fi

    # (7) a placeholder with no value supplied is a fail-closed per-row ERROR,
    # not a silently truncated command.
    cat > "$ST_T/m7.sdn" <<EOF
$HDR
    g-noph, local, false, range, "sh -c 'echo {range}'", -, -, "no --range given"
EOF
    sh "$0" --tier local --manifest-file "$ST_T/m7.sdn" --budget 20 --jobs 2 --results "$ST_T/r7.out" >/dev/null 2>"$ST_T/r7.err"
    rc=$?
    if [ "$rc" -eq 1 ] && grep -q '^g-noph error$' "$ST_T/r7.out"; then
        st_report ok "(S7) missing placeholder value is a fail-closed per-row error"
    else
        st_report bad "(S7) missing placeholder value is a fail-closed per-row error" "rc=$rc out=$(cat "$ST_T/r7.out" 2>/dev/null)"
    fi

    # (8) `--rev H` with no --range/--base derives `origin/main..H` (this is
    # land.shs's exact invocation: `run-gate-tier.shs --tier local --rev
    # "$TIP"`). Built in a scratch repo via RUN_GATE_TIER_ROOT so this does
    # not touch the real repo's origin/main.
    R8="$ST_T/repo8"
    mkdir -p "$R8"
    git -C "$R8" init -q
    git -C "$R8" config user.email t@t.example
    git -C "$R8" config user.name t
    printf 'a\n' > "$R8/a.txt"; git -C "$R8" add a.txt; git -C "$R8" commit -q -m c0
    C0=$(git -C "$R8" rev-parse HEAD)
    git -C "$R8" update-ref refs/remotes/origin/main "$C0"
    printf 'b\n' > "$R8/b.txt"; git -C "$R8" add b.txt; git -C "$R8" commit -q -m c1
    C1=$(git -C "$R8" rev-parse HEAD)
    cat > "$ST_T/m8.sdn" <<EOF
$HDR
    g-derive, local, false, range, "sh -c 'echo {range} > $ST_T/derive.out'", -, -, "derived range"
EOF
    RUN_GATE_TIER_ROOT="$R8" sh "$0" --tier local --rev "$C1" --manifest-file "$ST_T/m8.sdn" \
        --budget 20 --jobs 2 --results "$ST_T/r8.out" >/dev/null 2>"$ST_T/r8.err"
    rc=$?
    if [ "$rc" -eq 0 ] && [ "$(cat "$ST_T/derive.out" 2>/dev/null)" = "origin/main..$C1" ]; then
        st_report ok "(S8) --rev with no --range/--base derives origin/main..\$rev"
    else
        st_report bad "(S8) --rev with no --range/--base derives origin/main..\$rev" "rc=$rc got=$(cat "$ST_T/derive.out" 2>/dev/null) err=$(cat "$ST_T/r8.err" 2>/dev/null)"
    fi

    # (9) same, but origin/main does not resolve locally: fail closed (ERROR,
    # never a silent guess), and — crucially — no row ever runs.
    R9="$ST_T/repo9"
    mkdir -p "$R9"
    git -C "$R9" init -q
    git -C "$R9" config user.email t@t.example
    git -C "$R9" config user.name t
    printf 'a\n' > "$R9/a.txt"; git -C "$R9" add a.txt; git -C "$R9" commit -q -m c0
    C9=$(git -C "$R9" rev-parse HEAD)
    rm -f "$ST_T/derive9.out"
    cat > "$ST_T/m9.sdn" <<EOF
$HDR
    g-derive9, local, false, range, "sh -c 'echo {range} > $ST_T/derive9.out'", -, -, "derived range, should never run"
EOF
    RUN_GATE_TIER_ROOT="$R9" sh "$0" --tier local --rev "$C9" --manifest-file "$ST_T/m9.sdn" \
        --budget 20 --jobs 2 --results "$ST_T/r9.out" >/dev/null 2>"$ST_T/r9.err"
    rc=$?
    if [ "$rc" -eq 2 ] && [ ! -f "$ST_T/derive9.out" ] && grep -q 'origin/main does not resolve' "$ST_T/r9.err"; then
        st_report ok "(S9) missing origin/main fails closed, never guesses a range, never runs a row"
    else
        st_report bad "(S9) missing origin/main fails closed, never guesses a range, never runs a row" "rc=$rc ran=$([ -f "$ST_T/derive9.out" ] && echo yes || echo no) err=$(cat "$ST_T/r9.err" 2>/dev/null)"
    fi

    if [ "$ST_FAILURES" -eq 0 ]; then
        echo "run-gate-tier: selftest PASS — 9 fixture(s), 0 failed"
        exit 0
    fi
    echo "run-gate-tier: selftest FAIL — $ST_FAILURES fixture(s) failed"
    exit 1
fi

[ -n "$TIER" ] || { echo "run-gate-tier: ERROR — nothing was checked (--tier is required)" >&2; exit 2; }

# land.shs's own invocation is exactly `--tier local --rev "$TIP"`, no
# --range and no --base: derive one rather than leaving every {range}
# placeholder unsatisfiable. --base defaults to origin/main; fail closed
# (ERROR, never a silent guess) if it does not resolve in THIS checkout.
if [ -z "$RANGE" ] && [ -n "$REF" ]; then
    if [ -z "$BASE" ]; then
        if ! git -C "$ROOT" rev-parse -q --verify origin/main >/dev/null 2>&1; then
            echo "run-gate-tier: ERROR — nothing was checked (--rev given with no --range/--base, and origin/main does not resolve locally in $ROOT; fetch it — git fetch origin main -- or pass --range/--base explicitly)" >&2
            exit 2
        fi
        BASE=origin/main
    fi
    RANGE="$BASE..$REF"
fi

MTEXT=$(read_manifest_text) || { echo "run-gate-tier: ERROR — nothing was checked (cannot read manifest)" >&2; exit 2; }
[ -n "$MTEXT" ] || { echo "run-gate-tier: ERROR — nothing was checked (empty manifest)" >&2; exit 2; }

run_tier "$TIER" "$JOBS" "$BUDGET_S" "$RESULTS" "$MTEXT"
exit $?
