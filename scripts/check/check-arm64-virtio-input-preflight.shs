#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
build_dir="$repo_root/build/check-arm64-virtio-input-preflight"
contract_test="$repo_root/test/01_unit/os/arm64_virtio_input_mmio_contract_test.c"
runtime_source="$repo_root/examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c"

mkdir -p "$build_dir"
cc -std=c11 -Wall -Wextra -Werror "$contract_test" -o "$build_dir/contract_test"
"$build_dir/contract_test"
clang --target=aarch64-none-elf -ffreestanding -fsyntax-only "$runtime_source"

echo "arm64_virtio_input_preflight_status=pass"
echo "arm64_virtio_input_qemu_launched=false"
