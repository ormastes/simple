#!/bin/sh
# Check: p3-host-caps.shs derives caps from a fixture host.sdn (128 GB RAM),
# and the targeted stage2 driver sets the parse-shard workarounds.
d=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
export P3_HOST_SDN="$d/test/fixtures/p3/host_caps_fixture.sdn" P3_HOST_RAM_GB=128
out=$(sh "$d/scripts/bootstrap/p3-host-caps.shs") || { echo "FAIL: helper exited non-zero"; exit 1; }
rc=0
for want in probe_cap_gb=20 heavy_cap_gb=96 reserve_gb=24 max_threads=80 ram_gb=128; do
    printf '%s\n' "$out" | grep -qx "$want" || { echo "FAIL: missing $want"; rc=1; }
done
dry=$(P3_DRY_RUN=1 sh "$d/scripts/bootstrap/p3-targeted-stage2-build.shs" t entry.spl --heavy) || { echo "FAIL: driver dry-run"; rc=1; }
for want in SIMPLE_PARSE_SHARDING=0 SIMPLE_FILE_FIBERS=0 SIMPLE_PARSE_SHARD_MAX=1 SIMPLE_MIR_SHARD_COUNT=8 SIMPLE_FILE_WORKERS=0 budget_kib=90177536 cap_gb=96; do
    printf '%s\n' "$dry" | grep -q "$want" || { echo "FAIL: dry-run missing $want"; rc=1; }
done
if [ "$rc" = 0 ]; then echo "PASS: p3 host caps"; fi
exit $rc
