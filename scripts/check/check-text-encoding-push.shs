#!/bin/sh
# check-text-encoding-push.shs — Simple text files added/modified in a push
# range must be valid UTF-8 and contain no CR bytes (CRLF).
#
# WHY: .gitattributes pins *.spl/*.shs/*.sdn to `text eol=lf` and the toolchain
# reads them as UTF-8, but a blob committed from a Windows editor with CRLF or a
# legacy codepage is well-formed to every other push guard (tree, markers, size,
# symbols) and only breaks later, in the lexer or a `sh` shebang line.
#
# MECHANISM: committed blob content only (git diff --raw -z + git cat-file
# --batch, never the working tree). Scope: *.spl *.sdn *.shs *.sdl (the
# .gitattributes `text eol=lf` rows plus .sdl); added, modified and
# type-changed (symlink -> file) paths. Exempt: src/compiler_rust/vendor/**,
# src/runtime/vendor/** (`-text -eol` in .gitattributes); .bat/.cmd/.sh are not
# in scope (CRLF is intended for .bat/.cmd). All blobs are validated as one
# stream with `iconv -f UTF-8 -t UTF-8` (rejects overlongs, surrogates,
# truncated sequences) and a CR byte scan; only on failure is each file
# re-checked to name the offenders.
#
# SELFTEST: fatal; runs (6 in-process fixtures asserting verdict AND exit code)
# on the first scan after any change to this script, then its PASS is cached
# (see the bottom of the file); `--selftest` always runs it.
#
# Verdict, last line of stdout:
#   PASS  — <n> file(s) checked ...      exit 0  (n=0 only when the range
#           changed no in-scope file; the verdict says so explicitly)
#   FAIL  — ...                          exit 1
#   ERROR — nothing was checked (...)    exit 2
# Usage: check-text-encoding-push.shs [<BASE>..<NEW>]   (default origin/main..HEAD)
#        check-text-encoding-push.shs --selftest
set -u

in_scope() {
    case "$1" in
        src/compiler_rust/vendor/*|src/runtime/vendor/*) return 1 ;;
        *.spl|*.sdn|*.shs|*.sdl) return 0 ;;
    esac
    return 1
}

# bad_reason <file>: prints reason(s) for a file, empty when clean.
bad_reason() {
    _r=""
    iconv -f UTF-8 -t UTF-8 < "$1" > /dev/null 2>&1 || _r="invalid-utf8"
    if ! tr -d '\015' < "$1" | cmp -s - "$1"; then _r="${_r:+$_r+}CR"; fi
    printf '%s' "$_r"
}

run_scan() {
    _range=$1
    case "$_range" in *..*) ;; *) echo "ERROR — nothing was checked (range '$_range' must contain '..')"; return 2 ;; esac
    _ncommits=$(git rev-list --count "$_range" 2>/dev/null) || { echo "ERROR — nothing was checked (cannot resolve range $_range)"; return 2; }
    [ "${_ncommits:-0}" -gt 0 ] || { echo "ERROR — nothing was checked (range $_range resolves to 0 commits)"; return 2; }
    _base=${_range%%..*}; _new=${_range##*..}
    _tmp=$(mktemp -d 2>/dev/null) || { echo "ERROR — nothing was checked (mktemp failed)"; return 2; }
    _list="$_tmp/list"; _all="$_tmp/all"
    # -z: NUL-separated records, so odd path bytes cannot be quoted/mis-split.
    # Fields: ":<m1> <m2> <o1> <o2> <status>" NUL "<path>" NUL
    git diff --raw -z --no-renames --no-abbrev --diff-filter=AMT "$_base" "$_new" > "$_tmp/rawz" 2>/dev/null \
        || { rm -rf "$_tmp"; echo "ERROR — nothing was checked (git diff failed for $_range)"; return 2; }
    tr '\000' '\n' < "$_tmp/rawz" > "$_tmp/raw"
    _n=0; : > "$_list"
    while IFS= read -r _meta && IFS= read -r _path; do
        # _meta is ":100644 100644 <old> <new> M"
        set -- $_meta
        [ "$2" = 120000 ] && continue
        in_scope "$_path" || continue
        printf '%s\t%s\n' "$4" "$_path" >> "$_list"
        _n=$((_n + 1))
    done < "$_tmp/raw"
    if [ "$_n" -eq 0 ]; then
        rm -rf "$_tmp"
        echo "PASS — 0 file(s) checked in $_range ($_ncommits commit(s)): no in-scope (*.spl *.sdn *.shs *.sdl) file added or modified, nothing to validate"
        return 0
    fi
    # One git process for all blobs; the `<oid> blob <size>` header lines are
    # ASCII, so they cannot turn a clean stream into a failing one.
    cut -f1 "$_list" | git cat-file --batch > "$_all" 2>/dev/null \
        || { rm -rf "$_tmp"; echo "ERROR — nothing was checked (git cat-file --batch failed)"; return 2; }
    if [ -z "$(bad_reason "$_all")" ]; then
        rm -rf "$_tmp"
        echo "PASS — $_n file(s) checked in $_range ($_ncommits commit(s)), all valid UTF-8 with LF line endings"
        return 0
    fi
    _off=""; _k=0
    while IFS='	' read -r _oid _path; do
        git cat-file blob "$_oid" > "$_tmp/blob"
        _why=$(bad_reason "$_tmp/blob")
        if [ -n "$_why" ]; then _off="$_off $_path($_why)"; _k=$((_k + 1)); fi
    done < "$_list"
    rm -rf "$_tmp"
    echo "FAIL — $_n file(s) checked in $_range, $_k offender(s):$_off"
    return 1
}

selftest() {
    command -v iconv >/dev/null 2>&1 || { echo "ERROR — nothing was checked (iconv not found)"; return 2; }
    _st=$(mktemp -d) || { echo "ERROR — nothing was checked (selftest mktemp failed)"; return 2; }
    _stfail=0
    _stcheck() { # name range want-rc want-substr  (runs in the fixture repo)
        _out=$(run_scan "$2"); _rc=$?
        _last=$(printf '%s\n' "$_out" | tail -n 1)
        case "$_last" in *"$4"*) _ok=1 ;; *) _ok=0 ;; esac
        if [ "$_ok" = 1 ] && [ "$_rc" = "$3" ]; then echo "selftest ok: $1 -> rc=$_rc"
        else echo "selftest BAD: $1 -> rc=$_rc want=$3: $_last"; _stfail=1; fi
    }
    _here=$(pwd)
    cd "$_st" || return 2
    git init -q . || return 2
    # One git process builds all fixture commits (spawning git per commit costs
    # ~1s each on Windows). Linear history on refs/heads/main: B0 .. B4.
    _fi_file() { printf 'M 100644 inline %s\ndata %s\n' "$1" "$(printf "$2" | wc -c | tr -d ' ')"; printf "$2"; printf '\n'; }
    _fi_commit() { printf 'commit refs/heads/main\ncommitter t <t@t> 0 +0000\ndata 2\n%s\n' "$1"; }
    {
        _fi_commit c0
        _fi_file README.md 'base\n'
        _fi_commit c1
        _fi_file ok.spl 'fn caf\303\251() -> text: "\342\202\254 \360\237\230\200"\n'
        _fi_file crlf.bat 'a\r\n'
        _fi_file src/runtime/vendor/x.spl 'v\r\n'
        _fi_commit c2
        _fi_file crlf.spl 'x\r\ny\n'
        _fi_commit c3
        _fi_file bad.sdn 'bad \303\n'
        _fi_file sur.shs 'sur \355\240\200\n'
        _fi_commit c4
        _fi_file d.md 'doc\n'
    } | git fast-import --quiet || { cd "$_here"; echo "ERROR — nothing was checked (selftest fast-import failed)"; return 2; }
    B4=$(git rev-parse main); B3=$(git rev-parse main~1); B2=$(git rev-parse main~2); B1=$(git rev-parse main~3); B0=$(git rev-parse main~4)
    _stcheck "clean multibyte utf8 + exempt bat/vendor" "$B0..$B1" 0 "PASS — 1 file(s) checked"
    _stcheck "CRLF in .spl" "$B1..$B2" 1 "crlf.spl(CR)"
    _stcheck "truncated utf8 + surrogate" "$B2..$B3" 1 "bad.sdn(invalid-utf8) sur.shs(invalid-utf8)"
    _stcheck "no in-scope file changed" "$B3..$B4" 0 "PASS — 0 file(s) checked"
    _stcheck "empty range" "$B4..$B4" 2 "0 commits"
    _stcheck "bare rev rejected" "$B4" 2 "must contain"
    cd "$_here" || return 2
    rm -rf "$_st"
    [ "$_stfail" -eq 0 ] || { echo "ERROR — nothing was checked (selftest failed)"; return 2; }
    echo "selftest: all 6 fixtures passed"
    return 0
}

# Cold selftest costs ~7s on Windows (process spawn), over the 10s push budget
# once the other gates run, so a PASS is cached per (script blob id, iconv
# identity). No usable key (hash-object or iconv failed) => no cache: the
# selftest simply runs. `--selftest` always runs it.
_marker=""
_hash=$(git hash-object --stdin < "$0" 2>/dev/null) || _hash=""
_iv=$(iconv --version 2>&1 | head -n 1 | tr -c 'A-Za-z0-9\n' '_')
if [ -n "$_hash" ] && [ -n "$_iv" ]; then
    _marker="${TMPDIR:-/tmp}/text-encoding-selftest-green-$_hash-$_iv"
fi
if [ "${1:-}" = --selftest ] || [ -z "$_marker" ] || [ ! -f "$_marker" ]; then
    selftest || exit 2
    [ -z "$_marker" ] || : > "$_marker" 2>/dev/null || :
fi
[ "${1:-}" = --selftest ] && { echo "PASS — selftest only, 6 fixtures"; exit 0; }
run_scan "${1:-origin/main..HEAD}"
exit $?
