#!/bin/sh
# Superseded VM inventory, retained only for the historical QEMU experiment.
# Native Simple Container does not use this script or a guest VM.
set -eu

arch=aarch64
image=
expected_sha=
sdn=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --arch)
            [ "$#" -ge 2 ] || { echo 'missing --arch value' >&2; exit 2; }
            arch=$2
            shift 2
            ;;
        --image)
            [ "$#" -ge 2 ] || { echo 'missing --image value' >&2; exit 2; }
            image=$2
            shift 2
            ;;
        --image-sha256)
            [ "$#" -ge 2 ] || { echo 'missing --image-sha256 value' >&2; exit 2; }
            expected_sha=$2
            shift 2
            ;;
        --sdn)
            sdn=1
            shift
            ;;
        *)
            echo 'usage: sh check-macos-simpleos-container-host.shs [--arch aarch64|x86_64] [--image ABSOLUTE_PATH --image-sha256 LOWERCASE_SHA256] [--sdn]' >&2
            exit 2
            ;;
    esac
done

case "$arch" in
    aarch64) qemu_name=qemu-system-aarch64 ;;
    x86_64) qemu_name=qemu-system-x86_64 ;;
    *) echo 'unsupported --arch' >&2; exit 2 ;;
esac

if [ "$sdn" -eq 1 ]; then
    printf 'simpleos_macos_container_host |field, value|\n'
fi
report() {
    value=$2
    # Only bounded printable ASCII enters the diagnostic SDN receipt.
    bad=$(printf '%s' "$value" | LC_ALL=C tr -d ' -~' | wc -c | tr -d ' ')
    if [ "${#value}" -gt 256 ] || [ "$bad" -ne 0 ]; then
        echo 'invalid receipt value' >&2
        exit 2
    fi
    if [ "$sdn" -eq 0 ]; then
        printf 'macos-container-host: %s=%s\n' "$1" "$value"
    else
        escaped=$(printf '%s' "$value" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
        printf '    "%s", "%s"\n' "$1" "$escaped"
    fi
}

report schema simpleos-macos-container-host-v1
report host "$(uname -s)-$(uname -m)"
report guest_arch "$arch"
blocked=0
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
if source_commit=$(git -C "$repo_root" rev-parse --verify HEAD 2>/dev/null); then
    report source_commit "$source_commit"
else
    report source_commit unavailable
    blocked=1
fi
if [ "$(uname -s)" != Darwin ]; then
    report macos_host required
    blocked=1
else
    report macos_host present
fi

if qemu_path=$(command -v "$qemu_name" 2>/dev/null); then
    report qemu "$qemu_name"
    if qemu_sha=$(shasum -a 256 "$qemu_path" 2>/dev/null | awk '{print $1}') &&
       [ -n "$qemu_sha" ]; then
        report qemu_sha256 "$qemu_sha"
    else
        report qemu_sha256 unavailable
        blocked=1
    fi
    if "$qemu_path" -accel help 2>/dev/null | LC_ALL=C grep -Eq '(^|[[:space:]])hvf([[:space:]]|$)'; then
        report hvf available
    else
        report hvf unavailable
        blocked=1
    fi
else
    report qemu missing
    blocked=1
fi

if [ -z "$image" ] && [ -z "$expected_sha" ]; then
    report image pinned-image-required
    blocked=1
elif [ -z "$image" ] || [ -z "$expected_sha" ]; then
    report image image-and-digest-required-together
    blocked=1
else
    path_ok=1
    case "$image" in
        /*) ;;
        *) report image absolute-path-required; blocked=1; path_ok=0 ;;
    esac
    if [ "$path_ok" -eq 1 ]; then
        if [ -L "$image" ] || [ ! -f "$image" ] || [ ! -r "$image" ]; then
            report image regular-readable-file-required
            blocked=1
        elif ! printf '%s' "$expected_sha" | LC_ALL=C grep -Eq '^[0-9a-f]{64}$'; then
            report image_digest lowercase-sha256-required
            blocked=1
        else
            actual_sha=$(shasum -a 256 "$image" 2>/dev/null | awk '{print $1}') || actual_sha=
            if [ -z "$actual_sha" ]; then
                report image_hash unavailable
                blocked=1
            elif [ "$actual_sha" != "$expected_sha" ]; then
                report image_sha256 "$actual_sha"
                report image digest-mismatch
                blocked=1
            else
                report image_sha256 "$actual_sha"
                report image pinned
            fi
        fi
    fi
fi

if [ "$blocked" -ne 0 ]; then
    report status BLOCKED
    exit 2
fi
report status PREFLIGHT_ONLY
report next 'Boot the pinned guest, run a managed task, observe kernel exit, then destroy the VM.'
