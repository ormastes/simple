extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_exists(path: text) -> bool
extern fn rt_env_get(name: text) -> text

fn main():
    print "[driver] engine = pure-Simple frontend tree-walk interpreter"
    print "[driver] entry  = core_jit_interpret(src, path, 999999)"
    val dir = "test/fixtures/repro/compiler/class_identity/cases/"
    val names = [
        "a_class_trait_field.spl",
        "b_class_optional_field.spl",
        "c_class_array_element.spl",
        "d_class_param_to_field.spl",
        "e_class_returned.spl",
        "f_struct_literal_field_init.spl",
        "g_struct_local_binding.spl",
        "h_struct_field_store.spl",
        "i_struct_returned.spl",
        "j_struct_param_binding.spl",
        "k_struct_method_returned.spl",
    ]
    # ONE CASE PER PROCESS when CLASS_IDENTITY_CASE is set.
    #
    # `core_jit_interpret` is NOT re-entrant: a second call in the same process
    # sees the first call's leftover interpreter globals, and the damage is not
    # limited to a missing answer -- it silently produces a WRONG one. Measured
    # 2026-08-20 on this driver: case G alone prints VAL (correct), but running
    # case C first makes the very same case G print ALIAS(n=10) -- i.e. `got ==
    # 10` evaluated FALSE while got was 10. Running A first makes G die with
    # rc=-1, and running B first kills the process outright with
    # "array index out of bounds: index is 25 but length is 20".
    #
    # So the whole-corpus loop below cannot be trusted: it is how the matrix
    # lost 4 of 11 readings, and the 7 it kept were of unknown validity. The
    # guard now invokes this driver once per case; each verdict is then produced
    # by a fresh process, which is the only configuration measured to be
    # correct. The loop is retained for manual whole-corpus runs.
    # Re-entrancy is filed as a real interpreter defect, not fixed here.
    val only = rt_env_get("CLASS_IDENTITY_CASE") ?? ""
    var i = 0
    while i < names.len():
        if only == "" or only == names[i]:
            val path = dir + names[i]
            val src = rt_file_read_text(path)
            val rc = core_jit_interpret(src, path, 999999)
            print "[case] {names[i]} rc={rc}"
        i = i + 1
    print "[driver] done"
