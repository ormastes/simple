#!/bin/sh
# Host-only C-oracle parity and scoped bridge/policy coverage.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
SOURCE_DIR="$ROOT/src/os/kernel/arch/arm32/cosmos"
TEST_DIR="$ROOT/test/02_integration/os/cosmos"
SIMPLE_SOURCE="$SOURCE_DIR/cosmos_nvme_pcie_policy.spl"
C_BRIDGE="$SOURCE_DIR/cosmos_nvme_pcie_policy_bridge.c"
UNIT_SPEC="$ROOT/test/01_unit/os/arch/arm32/cosmos_nvme_pcie_policy_spec.spl"
EVIDENCE_DIR="$ROOT/build/coverage/cosmos-nvme-pcie-policy"
TMP=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-nvme-pcie-policy.XXXXXX")
RECEIPT="$EVIDENCE_DIR/receipt.sdn"
RECEIPT_TMP="$EVIDENCE_DIR/.receipt.sdn.tmp.$$"
trap 'rm -rf "$TMP"; rm -f "$RECEIPT_TMP"' EXIT HUP INT TERM

fail() {
    echo "FAIL cosmos-nvme-pcie-policy: $*" >&2
    exit 1
}

blocked() {
    echo "BLOCKED cosmos-nvme-pcie-policy: $*" >&2
    exit 2
}

hash_file() {
    sha256sum "$1" | awk '{print $1}'
}

verify_hash() {
    [ "$(hash_file "$1")" = "$2" ] || fail "$3 changed during evidence run"
}

pick_llvm_toolchain() {
    for version in 20 19 18; do
        if command -v "clang-$version" >/dev/null 2>&1 &&
           command -v "llvm-profdata-$version" >/dev/null 2>&1 &&
           command -v "llvm-cov-$version" >/dev/null 2>&1; then
            CLANG="clang-$version"
            LLVM_PROFDATA="llvm-profdata-$version"
            LLVM_COV="llvm-cov-$version"
            return
        fi
    done
    fail "matching clang/llvm-profdata/llvm-cov toolchain unavailable"
}

# Runtime evidence is admitted only through an explicitly selected Stage-4
# compiler and its canonical adjacent provenance.  Never guess a default path.
[ "${SIMPLE_STAGE4_BIN+x}" = x ] && [ -n "$SIMPLE_STAGE4_BIN" ] ||
    blocked "set SIMPLE_STAGE4_BIN to an admitted Stage-4 compiler"
[ -x "$SIMPLE_STAGE4_BIN" ] || blocked "Stage-4 compiler is not executable"
BOOTSTRAP_STAGE3_FACADE_PATH="$ROOT/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="$ROOT/scripts/check/lib/stage4-candidate-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"
SIMPLE_CANONICAL=$(bootstrap_stage3_canonical_file "$SIMPLE_STAGE4_BIN") ||
    blocked "cannot resolve the explicit Stage-4 compiler canonically"
SIMPLE_PROVENANCE="${SIMPLE_CANONICAL}.provenance.env"
[ -f "$SIMPLE_PROVENANCE" ] ||
    blocked "adjacent Stage-4 provenance is missing"
stage4_verify_candidate_provenance \
    "$SIMPLE_PROVENANCE" "$SIMPLE_CANONICAL" "$ROOT" ||
    blocked "explicit compiler lacks admitted current-tree Stage-4 provenance"
case "$("$SIMPLE_CANONICAL" --version 2>&1 || true)" in
    *"Rust-built Simple binary is a bootstrap seed"*|*"bootstrap seed only"*)
        blocked "a bootstrap seed cannot prove NVMe PCIe policy" ;;
esac

SIMPLE_SHA256=$(hash_file "$SIMPLE_CANONICAL")
PROVENANCE_SHA256=$(hash_file "$SIMPLE_PROVENANCE")
SIMPLE_SOURCE_SHA256=$(hash_file "$SIMPLE_SOURCE")
C_BRIDGE_SHA256=$(hash_file "$C_BRIDGE")
C_ORACLE="$TEST_DIR/cosmos_nvme_pcie_policy_oracle.c"
C_ORACLE_DUMP="$TEST_DIR/cosmos_nvme_pcie_policy_oracle_dump.c"
C_ORACLE_SHA256=$(hash_file "$C_ORACLE")
C_ORACLE_DUMP_SHA256=$(hash_file "$C_ORACLE_DUMP")

mkdir -p "$EVIDENCE_DIR"
rm -f "$RECEIPT" "$RECEIPT_TMP"

cc -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow \
    -Wstrict-prototypes -Wformat=2 -I"$SOURCE_DIR" \
    "$C_ORACLE" \
    "$C_ORACLE_DUMP" \
    -o "$TMP/oracle-dump"
"$TMP/oracle-dump" > "$EVIDENCE_DIR/c-oracle.out"

(cd "$ROOT" && SIMPLE_LIB=src "$SIMPLE_CANONICAL" run \
    test/02_integration/os/cosmos/cosmos_nvme_pcie_policy_parity_dump.spl \
    --no-session-daemon) > "$TMP/simple-run.out" 2>&1 ||
    fail "pure-Simple parity dump failed"
grep '^P|' "$TMP/simple-run.out" > "$EVIDENCE_DIR/simple-policy.out"
cmp -s "$EVIDENCE_DIR/c-oracle.out" "$EVIDENCE_DIR/simple-policy.out" ||
    fail "pure-Simple output diverges from the independent C oracle"

pick_llvm_toolchain
"$CLANG" -O0 -g -fprofile-instr-generate -fcoverage-mapping \
    -I"$SOURCE_DIR" "$C_BRIDGE" \
    "$C_ORACLE" \
    "$TEST_DIR/cosmos_nvme_pcie_policy_bridge_coverage_test.c" \
    -o "$TMP/bridge-coverage"
LLVM_PROFILE_FILE="$TMP/bridge.profraw" "$TMP/bridge-coverage"
"$LLVM_PROFDATA" merge -sparse "$TMP/bridge.profraw" -o "$TMP/bridge.profdata"
"$LLVM_COV" report "$TMP/bridge-coverage" \
    -instr-profile="$TMP/bridge.profdata" "$C_BRIDGE" \
    > "$EVIDENCE_DIR/c-bridge-llvm-cov.txt"

C_PAIR=$(awk '$1 ~ /cosmos_nvme_pcie_policy_bridge[.]c$/ { print $(NF-2), $(NF-1) }' \
    "$EVIDENCE_DIR/c-bridge-llvm-cov.txt")
set -- $C_PAIR
[ "$#" -eq 2 ] || fail "cannot parse C bridge branch counters"
C_TOTAL=$1
C_MISSED=$2
C_HIT=$((C_TOTAL - C_MISSED))
[ "$C_TOTAL" -gt 0 ] || fail "C bridge branch denominator is zero"
[ "$C_HIT" -eq "$C_TOTAL" ] || fail "C bridge branch outcomes are incomplete"

(cd "$ROOT" && SIMPLE_LIB=src "$SIMPLE_CANONICAL" test \
    test/01_unit/os/arch/arm32/cosmos_nvme_pcie_policy_spec.spl \
    --quick --no-limits --no-session-daemon) \
    > "$EVIDENCE_DIR/simple-decisions.out" 2>&1 ||
    fail "pure-Simple policy spec failed"
SIMPLE_PAIR=$(awk '$1 == "COSMOS_NVME_PCIE_SIMPLE_DECISIONS" { print $2 }' \
    "$EVIDENCE_DIR/simple-decisions.out" | tail -n 1)
SIMPLE_HIT=${SIMPLE_PAIR%/*}
SIMPLE_TOTAL=${SIMPLE_PAIR#*/}
[ -n "$SIMPLE_HIT" ] && [ "$SIMPLE_TOTAL" -gt 0 ] ||
    fail "Simple policy decision denominator is missing"
[ "$SIMPLE_HIT" -eq "$SIMPLE_TOTAL" ] ||
    fail "Simple policy decision outcomes are incomplete"

stage4_verify_candidate_provenance \
    "$SIMPLE_PROVENANCE" "$SIMPLE_CANONICAL" "$ROOT" ||
    fail "Stage-4 provenance changed during evidence run"
verify_hash "$SIMPLE_CANONICAL" "$SIMPLE_SHA256" compiler
verify_hash "$SIMPLE_PROVENANCE" "$PROVENANCE_SHA256" provenance
verify_hash "$SIMPLE_SOURCE" "$SIMPLE_SOURCE_SHA256" simple-source
verify_hash "$C_BRIDGE" "$C_BRIDGE_SHA256" c-bridge
verify_hash "$C_ORACLE" "$C_ORACLE_SHA256" c-oracle
verify_hash "$C_ORACLE_DUMP" "$C_ORACLE_DUMP_SHA256" c-oracle-dump

umask 077
{
    echo "schema=cosmos-nvme-pcie-policy-coverage-v1"
    echo "claim_scope=nvme-status-and-io-queue-policy-plus-c-abi-bridge-only"
    echo "board_evidence=separate-unavailable"
    echo "whole_hal_claim=false"
    echo "parity_oracle=independent-pre-migration-c-policy"
    echo "parity_vectors=$(wc -l < "$EVIDENCE_DIR/c-oracle.out" | tr -d ' ')"
    echo "simple_source=src/os/kernel/arch/arm32/cosmos/cosmos_nvme_pcie_policy.spl"
    echo "stage4_compiler_path=$SIMPLE_CANONICAL"
    echo "stage4_compiler_sha256=$SIMPLE_SHA256"
    echo "stage4_provenance_path=$SIMPLE_PROVENANCE"
    echo "stage4_provenance_sha256=$PROVENANCE_SHA256"
    echo "simple_source_sha256=$SIMPLE_SOURCE_SHA256"
    echo "c_bridge_source=src/os/kernel/arch/arm32/cosmos/cosmos_nvme_pcie_policy_bridge.c"
    echo "c_bridge_source_sha256=$C_BRIDGE_SHA256"
    echo "c_oracle_source=test/02_integration/os/cosmos/cosmos_nvme_pcie_policy_oracle.c"
    echo "c_oracle_sha256=$C_ORACLE_SHA256"
    echo "c_oracle_dump_source=test/02_integration/os/cosmos/cosmos_nvme_pcie_policy_oracle_dump.c"
    echo "c_oracle_dump_sha256=$C_ORACLE_DUMP_SHA256"
    echo "c_oracle_output_sha256=$(hash_file "$EVIDENCE_DIR/c-oracle.out")"
    echo "simple_policy_output_sha256=$(hash_file "$EVIDENCE_DIR/simple-policy.out")"
    echo "c_measurement=llvm-profile-instr-generate-coverage-mapping"
    echo "c_branches_hit=$C_HIT"
    echo "c_branches_total=$C_TOTAL"
    echo "simple_measurement=owner-explicit-production-predicate-outcomes"
    echo "simple_manifest_id=cosmos-nvme-pcie-queue-policy-v1"
    echo "simple_decisions_hit=$SIMPLE_HIT"
    echo "simple_decisions_total=$SIMPLE_TOTAL"
} > "$RECEIPT_TMP"
mv -f -- "$RECEIPT_TMP" "$RECEIPT"

grep -q '^whole_hal_claim=false$' "$RECEIPT" || fail "whole-HAL claim escaped"
grep -q '^board_evidence=separate-unavailable$' "$RECEIPT" || fail "board claim escaped"
echo "cosmos_nvme_pcie_oracle_parity_vectors=$(wc -l < "$EVIDENCE_DIR/c-oracle.out" | tr -d ' ')"
echo "cosmos_nvme_pcie_c_bridge_branches=$C_HIT/$C_TOTAL"
echo "cosmos_nvme_pcie_simple_policy_decisions=$SIMPLE_HIT/$SIMPLE_TOTAL"
echo "cosmos_nvme_pcie_board_evidence=separate-unavailable"
echo "cosmos_nvme_pcie_receipt=$RECEIPT"
echo "cosmos_nvme_pcie_receipt_sha256=$(hash_file "$RECEIPT")"
echo "STATUS: PASS cosmos-nvme-pcie policy parity and scoped coverage"
