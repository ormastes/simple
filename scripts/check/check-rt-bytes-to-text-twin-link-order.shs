#!/bin/sh
# check-rt-bytes-to-text-twin-link-order.shs — rt_bytes_to_text must narrow a
# tagged-slot `[u8]` in the link composition native binaries really use.
#
# On ELF the native link passes runtime.o BEFORE runtime_native.o with
# --allow-multiple-definition, so runtime.c's rt_bytes_to_text is the body that
# runs. It copied the array data verbatim, so a slot-layout `[u8]`
# (`[0u8; 64]`, a literal, push) became the low bytes of `value << 3` and any
# byte >= 0x80 returned NIL: sha256_text gave nil for every input in a Stage 2
# native binary ("TEMPLATE ERROR: invalid stream digest", 2026-11-28).
# src/runtime/test/rt_bytes_to_text_layouts_selfcheck.c linked runtime_native.o
# alone and stayed green. This runs it in both compositions.
#
# Verdict (last stdout line):
#   PASS  — 2 link composition(s) checked ...        exit 0
#   FAIL  — <composition> ...                         exit 1
#   ERROR — nothing was checked (<reason>)            exit 2
set -u

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cc=${CC:-}
[ -n "$cc" ] || cc=$(command -v clang 2>/dev/null || true)
[ -n "$cc" ] || cc=$(command -v cc 2>/dev/null || true)
[ -n "$cc" ] || { echo "ERROR — nothing was checked (no clang or cc; set CC)"; exit 2; }
[ -f "$root/src/runtime/runtime.c" ] && [ -f "$root/src/runtime/runtime_native.c" ] ||
    { echo "ERROR — nothing was checked ($root holds no src/runtime sources)"; exit 2; }

work=$(mktemp -d "${TMPDIR:-/tmp}/rt-b2t-twin.XXXXXX") || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
trap 'rm -rf "$work"' EXIT INT TERM

for unit in runtime runtime_native; do
    "$cc" -std=gnu11 -O1 -ffunction-sections -fdata-sections \
        -DSIMPLE_CORE_C_STANDALONE=1 -DSIMPLE_RUNTIME_MEMORY_OWNER=1 \
        -DSIMPLE_RUNTIME_PROCESS_OWNED_STRING_FREE=1 \
        -I"$root/src/runtime" -I"$root/src/runtime/platform" \
        -c "$root/src/runtime/$unit.c" -o "$work/$unit.o" 2> "$work/$unit.err"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        head -5 "$work/$unit.err"
        echo "ERROR — nothing was checked ($unit.c did not compile, rc=$rc)"
        exit 2
    fi
done
"$cc" -std=gnu11 -c "$root/src/runtime/test/rt_bytes_to_text_layouts_selfcheck.c" -o "$work/t.o" 2> "$work/t.err"
rc=$?
[ "$rc" -eq 0 ] || { head -5 "$work/t.err"; echo "ERROR — nothing was checked (selfcheck did not compile, rc=$rc)"; exit 2; }

run_composition() {
    # $1 = label, rest = objects in link order
    _label=$1; shift
    "$cc" "$work/t.o" "$@" -Wl,--gc-sections -Wl,--allow-multiple-definition \
        -lpthread -lm -ldl -o "$work/$_label" 2> "$work/$_label.err"
    _rc=$?
    if [ "$_rc" -ne 0 ]; then
        head -5 "$work/$_label.err"
        echo "ERROR — nothing was checked ($_label did not link, rc=$_rc)"
        exit 2
    fi
    "$work/$_label" > "$work/$_label.out" 2>&1
    _rc=$?
    if [ "$_rc" -ne 0 ]; then
        grep '^FAIL' "$work/$_label.out" | head -10
        echo "FAIL — $_label: rt_bytes_to_text layouts selfcheck exit $_rc"
        exit 1
    fi
}

run_composition owner_only "$work/runtime_native.o"
run_composition twin_first "$work/runtime.o" "$work/runtime_native.o"
echo "PASS — 2 link composition(s) checked (runtime_native.o alone; runtime.o first), rt_bytes_to_text narrows slot and packed [u8] in both"
