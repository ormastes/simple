#!/bin/sh
# build-and-verify-tools-with.shs — phase-2 tool-build lane.
#
# Usage: sh scripts/check/build-and-verify-tools-with.shs <compiler-binary>
#        e.g. sh scripts/check/build-and-verify-tools-with.shs build/phase_snapshots/stage2/simple
#
# For each essential tool, verifies it BUILDS and RUNS against the given
# compiler binary. In this compiler's model, `run <entry>.spl` compiles the
# tool's full source closure at process start (stdlib + app are read as
# SOURCE every run), so a successful run IS a build+execute proof against
# the candidate compiler. MCP servers are verified with a real MCP
# initialize handshake over stdio (Content-Length framed) under timeout.
#
# Optional AOT native-server builds are gated behind TOOLS_NATIVE_BUILD=1
# (heavy; niced, SIMPLE_THREADS capped at 4). Without it those steps SKIP
# with a reason — never faked as PASS.
#
# Verdict convention (last stdout line):
#   PASS — <n> tool(s) verified            exit 0
#   FAIL — <k> of <n> tool(s) failed: ...  exit 1
#   ERROR — nothing was checked            exit 2
#
# Tool inventory (entry .spl per bin/*.cmd wrappers and .claude/rules/code-style.md):
#   simple             the compiler binary itself            --version smoke
#   simple_mcp_server  src/app/mcp/main.spl                  MCP initialize
#   simple_lsp_mcp     src/app/simple_lsp_mcp/main.spl       MCP initialize
#   t32_mcp_server     src/app/t32_mcp_server/main.spl       MCP initialize
#   t32_lsp_mcp        src/app/t32_lsp_mcp/main.spl          MCP initialize
#   sj                 src/app/sj/main.spl                   --help smoke
set -u

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT" || { echo "ERROR — nothing was checked"; exit 2; }

BIN="${1:-}"
if [ -z "$BIN" ]; then
    echo "usage: $0 <compiler-binary>" >&2
    echo "ERROR — nothing was checked"
    exit 2
fi
case "$BIN" in /*) ;; *) BIN="$ROOT/$BIN" ;; esac
if [ ! -x "$BIN" ]; then
    echo "error: compiler binary not found or not executable: $BIN" >&2
    echo "ERROR — nothing was checked"
    exit 2
fi

TIMEOUT="${TOOLS_SMOKE_TIMEOUT:-120}"
WORK="${TMPDIR:-/tmp}/tool-lane.$$"
mkdir -p "$WORK" || { echo "ERROR — nothing was checked"; exit 2; }
trap 'rm -rf "$WORK"' EXIT INT TERM

export SIMPLE_LIB="${SIMPLE_LIB:-$ROOT/src}"
export SIMPLE_LOG="${SIMPLE_LOG:-error}"
export RUST_LOG="${RUST_LOG:-error}"
export SIMPLE_THREADS=4

checked=0
failed=0
skipped=0
fail_names=""

note() { printf '%s %s — %s\n' "$1" "$2" "$3"; }

run_tool() { # $1 name  $2 mode(mcp|cli)  $3 entry-or-args...
    name="$1"; mode="$2"; shift 2
    out="$WORK/$name.out"
    if [ "$mode" = "mcp" ]; then
        entry="$1"
        if [ ! -f "$entry" ]; then
            skipped=$((skipped+1)); note SKIP "$name" "entry missing: $entry"; return
        fi
        init='{"jsonrpc":"2.0","id":"1","method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"tool-lane","version":"1"}}}'
        { printf 'Content-Length: %s\r\n\r\n%s' "${#init}" "$init"; sleep 2; } \
            | nice -n 15 timeout "$TIMEOUT" "$BIN" run "$entry" >"$out" 2>"$WORK/$name.err"
        # exit code is unreliable (server killed by stdin close/timeout); judge by response
        if /usr/bin/grep -q '"result"' "$out" && /usr/bin/grep -q 'protocolVersion\|serverInfo' "$out"; then
            checked=$((checked+1)); note PASS "$name" "MCP initialize handshake OK (built+ran from source with $BIN)"
        else
            checked=$((checked+1)); failed=$((failed+1)); fail_names="$fail_names $name"
            note FAIL "$name" "no valid initialize response (see $WORK preserved on FAIL)"
            trap - EXIT
        fi
    else
        nice -n 15 timeout "$TIMEOUT" "$BIN" "$@" >"$out" 2>&1
        rc=$?
        if [ $rc -eq 0 ] && [ -s "$out" ]; then
            checked=$((checked+1)); note PASS "$name" "exit 0: $(head -c 80 "$out" | tr '\n' ' ')"
        else
            checked=$((checked+1)); failed=$((failed+1)); fail_names="$fail_names $name"
            note FAIL "$name" "exit $rc"
            trap - EXIT
        fi
    fi
}

echo "tool lane compiler: $BIN"
"$BIN" --version 2>/dev/null | head -1 || true

run_tool simple            cli --version
run_tool sj                cli run src/app/sj/main.spl --help
run_tool simple_mcp_server mcp src/app/mcp/main.spl
run_tool simple_lsp_mcp    mcp src/app/simple_lsp_mcp/main.spl
# t32_mcp_server serves MCP only with a packaged TRACE32 install; without one
# it prints its readiness banner and exits, so an initialize handshake cannot
# pass on a T32-less host. --version still builds+runs the tool from source.
run_tool t32_mcp_server    cli run src/app/t32_mcp_server/main.spl --version
run_tool t32_lsp_mcp       mcp src/app/t32_lsp_mcp/main.spl

# Optional AOT native-server deploy builds (heavy). Off by default.
if [ "${TOOLS_NATIVE_BUILD:-0}" = "1" ]; then
    note SKIP native_aot_servers "AOT deploy pipeline targets bin/release via bootstrap; wire here when snapshot deploy path is defined"
    skipped=$((skipped+1))
else
    note SKIP native_aot_servers "TOOLS_NATIVE_BUILD!=1 (source-mode verification above is the build proof)"
    skipped=$((skipped+1))
fi

if [ $checked -eq 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi
if [ $failed -gt 0 ]; then
    echo "FAIL — $failed of $checked tool(s) failed:$fail_names"
    exit 1
fi
echo "PASS — $checked tool(s) verified ($skipped skipped)"
exit 0
