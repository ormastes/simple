#!/bin/sh
# check-numeric-builtin-result-type.shs
#
# Fences doc/08_tracking/bug/numeric_builtins_hardcode_i64_result_type_2026-08-10.md.
#
# DEFECT A: hir/lower/expr/calls.rs pinned the result type of all seven numeric
# builtins (abs min max sqrt floor ceil pow) to TypeId::I64 unconditionally, so
#     print min(1.5, 2.5)
# printed 4609434218613702656 -- 0x3FF8000000000000, the verbatim IEEE-754 bit
# pattern of the CORRECT answer 1.5, rendered as an integer because of the i64
# stamp. The computation was right; only the label was wrong. Binding the same
# call to `val x: f64` always printed 1.5, which is what isolated it to the type.
#
# WHY THIS ASSERTS VALUES, NOT EXISTENCE. An existence-only oracle ("the builtin
# is reachable", "the name resolves", "the output is non-empty") passes on every
# single broken form above: the broken build DOES print something, DOES resolve
# the name, and DOES compute the right bits. Only comparing the printed text to
# the expected decimal separates them. Every assertion here is an exact string
# equality against a hand-computed expected value.
#
# LANES. Interpreter and JIT. SIMPLE_JIT_STRICT=1 is mandatory on the JIT lane:
# without it a JIT failure silently falls back to the interpreter and the lane
# reads as a pass while never having exercised the JIT at all.
#
# NEGATIVE ARGUMENTS are tested deliberately. min/max/abs lower to a compare +
# typed select, and if codegen were emitting an INTEGER compare on float bits,
# positive values would still come out right by accident (IEEE positive floats
# order-correspond to their bit patterns) while negatives would invert. The
# negative rows are the ones that prove a real float compare.
#
# DEFECT B (FIXED 2026-08-10, previously the XFAIL rows below). sqrt/floor/ceil/
# pow were a SECOND, independent defect: they fell through to a generic external
# Call to the libm symbols literally named sqrt/floor/ceil/pow, emitted with the
# INTEGER ABI. libm takes and returns a double in xmm0, so the arguments went to
# integer registers and the result was read from rax, which libm never wrote.
# The values were stale register/stack contents, which is why the same expression
# printed DIFFERENT garbage on consecutive runs and looked like uninitialised
# memory. The tell that separated it from Defect A was that INTEGER arguments
# were broken too -- `sqrt(16)` returned 0, i.e. libm had put 4.0 in xmm0 and rax
# happened to be zero -- which a mere type mislabel cannot explain.
#
# mir/lower/lowering_expr_builtin.rs `lower_libm_math` now lowers these four onto
# the rt_math_sqrt/floor/ceil/pow runtime symbols, whose F64 signatures are
# declared in codegen/runtime_sffi.rs, with explicit Casts into and out of f64.
# The integer-argument rows below are load-bearing: they are what proves the
# call really moved to the float ABI rather than the result merely being
# relabelled, and they pin the i64-in/i64-out contract against the
# interpreter-fallback lane.
#
# Verdict line is the last line of stdout:
#   PASS  -- <n> assertions checked, n > 0    exit 0
#   FAIL  -- ...                              exit 1
#   ERROR -- nothing was checked              exit 2

set -u

BIN="${SIMPLE_BIN:-bin/release/x86_64-unknown-linux-gnu/simple}"
if [ ! -x "$BIN" ]; then
    echo "ERROR — nothing was checked (no runnable binary at $BIN)"
    exit 2
fi

WORK="${TMPDIR:-/tmp}/numbuiltin.$$"
mkdir -p "$WORK" || { echo "ERROR — nothing was checked (cannot create $WORK)"; exit 2; }
trap 'rm -rf "$WORK"' EXIT INT TERM

CHECKED=0
FAILED=0

# emit_case <file> <decl-type> <expr>
# Prints the expression through a TYPED LOCAL. The typed local is load-bearing:
# it is the form that was always correct even on the broken build, so it isolates
# "does the builtin compute the right number" from "is the result type right".
# The direct `print <expr>` form is tested separately below.
run_case() {
    _label="$1"; _lane="$2"; _src="$3"; _expect="$4"
    printf '%s\n' "$_src" > "$WORK/case.spl"
    case "$_lane" in
        interp) _got=$(SIMPLE_RUST_SEED_WARNING=0 "$BIN" run "$WORK/case.spl" 2>/dev/null) ;;
        jit)    _got=$(SIMPLE_JIT_STRICT=1 SIMPLE_RUST_SEED_WARNING=0 "$BIN" "$WORK/case.spl" 2>/dev/null) ;;
        *)      echo "ERROR — nothing was checked (bad lane $_lane)"; exit 2 ;;
    esac
    CHECKED=$((CHECKED + 1))
    if [ "$_got" = "$_expect" ]; then
        echo "  ok   [$_lane] $_label -> $_got"
        return 0
    fi
    echo "  FAIL [$_lane] $_label: expected '$_expect', got '$_got'"
    FAILED=$((FAILED + 1))
    return 1
}

echo "check-numeric-builtin-result-type — binary: $BIN"
ls -l "$BIN" 2>/dev/null | awk '{print "  size/mtime: " $5 " " $6 " " $7 " " $8}'
echo

for LANE in interp jit; do
    echo "--- lane: $LANE ---"

    # ---- POSITIVE: the exact reported symptom. Direct print, float args. ----
    # On the broken build these printed raw IEEE bit patterns as integers.
    run_case "print min(1.5, 2.5)"   "$LANE" 'fn main():
    print min(1.5, 2.5)' '1.5'
    run_case "print max(1.5, 2.5)"   "$LANE" 'fn main():
    print max(1.5, 2.5)' '2.5'
    run_case "print abs(-1.5)"       "$LANE" 'fn main():
    print abs(-1.5)' '1.5'

    # ---- NEGATIVE ARGS: proves a real float compare, not an integer compare
    # on float bits that only happens to order correctly for positives. ----
    run_case "print min(-1.5, 2.5)"  "$LANE" 'fn main():
    print min(-1.5, 2.5)' '-1.5'
    run_case "print min(-1.5, -2.5)" "$LANE" 'fn main():
    print min(-1.5, -2.5)' '-2.5'
    run_case "print max(-1.5, -2.5)" "$LANE" 'fn main():
    print max(-1.5, -2.5)' '-1.5'
    run_case "print abs(2.5)"        "$LANE" 'fn main():
    print abs(2.5)' '2.5'

    # ---- REGRESSION CONTROL: integer callers were CORRECT before this fix
    # (measured 3 / 9 / 5) and must stay correct. If the arg-derived result
    # type ever defaulted to float, these rows catch it immediately. ----
    run_case "print min(3, 9)"       "$LANE" 'fn main():
    print min(3, 9)' '3'
    run_case "print max(3, 9)"       "$LANE" 'fn main():
    print max(3, 9)' '9'
    run_case "print abs(-5)"         "$LANE" 'fn main():
    print abs(-5)' '5'

    # ---- TYPED-LOCAL CONTROL: this form was ALREADY correct on the broken
    # build. It must stay correct -- and its passing while the direct form
    # failed is exactly the evidence that the defect was the type stamp and
    # not the computation. ----
    run_case "val f64 = min(1.5,2.5)" "$LANE" 'fn main():
    val x: f64 = min(1.5, 2.5)
    print x' '1.5'

    # ---- DEFECT B (was XFAIL): float sqrt/floor/ceil/pow. These read a return
    # register libm never wrote and printed run-varying garbage; they now go
    # through the rt_math_* float-ABI symbols. ----
    run_case "print sqrt(16.0)"      "$LANE" 'fn main():
    print sqrt(16.0)' '4.0'
    run_case "print floor(1.7)"      "$LANE" 'fn main():
    print floor(1.7)' '1.0'
    run_case "print ceil(1.2)"       "$LANE" 'fn main():
    print ceil(1.2)' '2.0'
    run_case "print pow(2.0, 3.0)"   "$LANE" 'fn main():
    print pow(2.0, 3.0)' '8.0'

    # Negative float arguments: floor/ceil must round toward -inf / +inf, which
    # an integer-truncating or bit-reinterpreting path gets wrong in a way that
    # positive-only rows cannot see.
    run_case "print floor(-1.2)"     "$LANE" 'fn main():
    print floor(-1.2)' '-2.0'
    run_case "print ceil(-1.7)"      "$LANE" 'fn main():
    print ceil(-1.7)' '-1.0'

    # ---- DEFECT B, INTEGER ARGUMENTS. This is the group that separated
    # Defect B from Defect A: a pure type mislabel cannot make sqrt(16) return
    # 0. These assert the i64-in / i64-out contract, identical to the
    # interpreter-fallback lane asserted further below. ----
    run_case "print sqrt(16)"        "$LANE" 'fn main():
    print sqrt(16)' '4'
    run_case "print floor(17)"       "$LANE" 'fn main():
    print floor(17)' '17'
    run_case "print ceil(12)"        "$LANE" 'fn main():
    print ceil(12)' '12'
    run_case "print pow(2, 3)"       "$LANE" 'fn main():
    print pow(2, 3)' '8'

    # Typed-local form of the same four floats -- the direct-print form above
    # and this one exercise different result-type plumbing, and Defect B broke
    # BOTH (unlike Defect A, which the typed local always survived).
    run_case "val f64 = sqrt(16.0)"  "$LANE" 'fn main():
    val x: f64 = sqrt(16.0)
    print x' '4.0'
    run_case "val f64 = pow(2.0,3.0)" "$LANE" 'fn main():
    val x: f64 = pow(2.0, 3.0)
    print x' '8.0'

    echo
done

# ---- INTERPRETER-FALLBACK LANE ----------------------------------------------
# A THIRD lane, distinct from both above, and the one that nearly shipped a
# regression. When a module drops to the whole-module interpreter fallback, the
# numeric builtins are served by interpreter_extern/math.rs, NOT by the MIR
# lowering the two lanes above exercise. That code used `as_int()` on every
# argument, which TRUNCATES floats: min(1.5, 2.5) returned 1, not 1.5.
#
# This was invisible for a long time because
# src/lib/nogc_sync_mut/runtime_wrappers.spl accidentally SHADOWED min/max/abs
# with pure-Simple reimplementations that happened to be float-tolerant, so
# callers never reached math.rs. Deleting those shadows reroutes callers into
# it -- deleting a reimplementation REROUTES, it does not dedupe -- which is
# exactly how removing "dead" duplicate code can introduce a regression.
#
# `use std.nogc_sync_mut.runtime_wrappers` is what forces the fallback here
# (its unresolved `text_hash` extern drops the module to the interpreter), so
# this case genuinely exercises the third lane rather than re-testing lane 1.
echo "--- lane: interpreter-fallback (via runtime_wrappers import) ---"
FALLBACK_SRC='use std.nogc_sync_mut.runtime_wrappers.{hash}
fn main():
    print min(3, 9)
    print max(3, 9)
    print abs(-5)
    print min(1.5, 2.5)
    print max(1.5, 2.5)
    print abs(-1.5)'
printf '%s\n' "$FALLBACK_SRC" > "$WORK/fallback.spl"
FB=$(SIMPLE_RUST_SEED_WARNING=0 "$BIN" run "$WORK/fallback.spl" 2>/dev/null | tr '\n' ' ' | sed 's/ *$//')
CHECKED=$((CHECKED + 1))
FB_EXPECT="3 9 5 1.5 2.5 1.5"
if [ "$FB" = "$FB_EXPECT" ]; then
    echo "  ok   [fallback] min/max/abs i64+f64 -> $FB"
else
    echo "  FAIL [fallback] expected '$FB_EXPECT', got '$FB'"
    echo "        (a truncated float such as '1' instead of '1.5' means"
    echo "         interpreter_extern/math.rs is back to as_int() coercion)"
    FAILED=$((FAILED + 1))
fi

# sqrt/floor/ceil/pow in this lane are served by the math.rs float path (Defect
# C). Since Defect B was fixed the MIR/JIT lanes above must agree with it
# EXACTLY -- same values, same int-in/int-out contract -- so these rows are now
# a cross-lane agreement check rather than a record of divergence. A future
# change that moves either lane off that contract breaks this row.
FALLBACK2_SRC='use std.nogc_sync_mut.runtime_wrappers.{hash}
fn main():
    print sqrt(16.0)
    print floor(1.7)
    print ceil(1.2)
    print pow(2.0, 3.0)
    print sqrt(16)
    print pow(2, 3)'
printf '%s\n' "$FALLBACK2_SRC" > "$WORK/fallback2.spl"
FB2=$(SIMPLE_RUST_SEED_WARNING=0 "$BIN" run "$WORK/fallback2.spl" 2>/dev/null | tr '\n' ' ' | sed 's/ *$//')
CHECKED=$((CHECKED + 1))
FB2_EXPECT="4.0 1.0 2.0 8.0 4 8"
if [ "$FB2" = "$FB2_EXPECT" ]; then
    echo "  ok   [fallback] sqrt/floor/ceil/pow i64+f64 -> $FB2"
else
    echo "  FAIL [fallback] expected '$FB2_EXPECT', got '$FB2'"
    FAILED=$((FAILED + 1))
fi
echo

# ---- SELF-CHECK / NEGATIVE CONTROL ------------------------------------------
# Prove the harness can actually FAIL. If this assertion (deliberately wrong)
# does not fail, every green above is vacuous and the run is an ERROR.
printf 'fn main():\n    print min(1.5, 2.5)\n' > "$WORK/case.spl"
SENTINEL=$(SIMPLE_RUST_SEED_WARNING=0 "$BIN" run "$WORK/case.spl" 2>/dev/null)
if [ "$SENTINEL" = "THIS_CAN_NEVER_MATCH" ]; then
    echo "ERROR — nothing was checked (negative control matched; oracle is broken)"
    exit 2
fi
if [ -z "$SENTINEL" ]; then
    echo "ERROR — nothing was checked (binary produced no output at all)"
    exit 2
fi
echo "negative control: harness distinguishes values (sentinel mismatch observed)"

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi

if [ "$FAILED" -gt 0 ]; then
    echo "FAIL — $CHECKED assertions checked, $FAILED wrong value(s)"
    exit 1
fi

echo "PASS — $CHECKED assertions checked across 2 lanes, 0 failures"
exit 0
