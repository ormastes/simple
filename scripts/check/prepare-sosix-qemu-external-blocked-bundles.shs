#!/bin/sh
# Retain honest non-PASS collector inputs when Windows/FreeBSD execution is unavailable.
set -eu

usage() {
    echo "usage: prepare-sosix-qemu-external-blocked-bundles.shs --host windows|macos|freebsd --output SOURCE [--owner NAME] [--reviewer NAME]" >&2
    exit 64
}

host=
output=
owner=external-host-operator
reviewer=sosix-qemu-matrix-reviewer
while [ "$#" -gt 0 ]; do
    case "$1" in
        --host) [ "$#" -ge 2 ] || usage; host=$2; shift 2 ;;
        --output) [ "$#" -ge 2 ] || usage; output=$2; shift 2 ;;
        --owner) [ "$#" -ge 2 ] || usage; owner=$2; shift 2 ;;
        --reviewer) [ "$#" -ge 2 ] || usage; reviewer=$2; shift 2 ;;
        *) usage ;;
    esac
done
case "$host" in windows|macos|freebsd) ;; *) usage ;; esac
[ -n "$output" ] && [ -n "$owner" ] && [ -n "$reviewer" ] || usage

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
compiler_policy=$repo_root/scripts/check/lib/sosix-qemu-compiler-designation-v1.tsv
case "$output" in /*) ;; *) output=$PWD/$output ;; esac
mkdir -p "$output"

hash_file() { sha256sum "$1" | awk '{print $1}'; }
identity() {
    label=$1 path=$2
    if [ -f "$path" ]; then
        printf 'sha256:%s' "$(hash_file "$path")"
    else
        printf 'missing:%s:%s' "$label" "$path"
    fi
}

actual_uname=$(uname -s 2>/dev/null || printf unknown)
case "$actual_uname" in
    FreeBSD) actual_host=freebsd ;;
    MINGW*|MSYS*|CYGWIN*) actual_host=windows ;;
    Darwin) actual_host=macos ;;
    Linux) actual_host=linux ;;
    *) actual_host=unsupported ;;
esac
source_hash=$(git -C "$repo_root" rev-parse HEAD 2>/dev/null || hash_file "$repo_root/scripts/check/collect-sosix-qemu-evidence.shs")
compiler_path=$repo_root/bin/simple
compiler_identity=$(identity compiler "$compiler_path")
prepared_at=$(date -u +%Y%m%dT%H%M%SZ)

if [ "$host" = windows ]; then
    if [ "$actual_host" = windows ]; then
        echo 'prepare-sosix-qemu-external-blocked-bundles: Windows host is available; run the native matrix instead' >&2
        exit 64
    fi
    reason="missing-actual-windows-host:actual=$actual_host"
    resume='powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check/check-sosix-qemu-matrix.ps1 -AllGuests -Run'
    accelerator=not-executed:windows-host-required
elif [ "$host" = macos ]; then
    if [ "$actual_host" = macos ]; then
        echo 'prepare-sosix-qemu-external-blocked-bundles: macOS host is available; run the native matrix instead' >&2
        exit 64
    fi
    reason="postponed-missing-actual-macos-host:actual=$actual_host"
    resume='SIMPLE_QEMU_ACCELERATOR=tcg sh scripts/check/check-sosix-qemu-matrix.shs --host macos --all-guests --run'
    accelerator=not-executed:macos-host-required
else
    media_output=$($repo_root/scripts/qemu/simple-freebsd-media.shs --check 2>&1 || true)
    media_reason=$(printf '%s\n' "$media_output" | sed -n 's/^freebsd_media_reason=//p' | head -n 1)
    [ -n "$media_reason" ] || media_reason=media-check-not-passed
    if [ "$actual_host" = freebsd ] && printf '%s\n' "$media_output" | grep -qx 'freebsd_media_status=pass'; then
        echo 'prepare-sosix-qemu-external-blocked-bundles: FreeBSD host and media are available; run the native matrix instead' >&2
        exit 64
    fi
    if [ "$actual_host" = freebsd ]; then
        reason="missing-or-invalid-freebsd-media:$media_reason"
    else
        reason="missing-actual-freebsd-host:actual=$actual_host;media=$media_reason"
    fi
    resume='sh scripts/check/check-sosix-qemu-matrix.shs --host freebsd --all-guests --run'
    accelerator=not-executed:freebsd-host-or-media-required
fi

for guest in x86_32 x86_64 arm32 arm64 riscv32 riscv64; do
    case "$guest" in
        x86_32) kernel=build/os/simpleos_x86_32_initrd_fs_exec_probe.elf; image=build/os/fat32-x86_32.img ;;
        x86_64) kernel=build/os/simpleos_x86_64_fs_exec.elf; image=build/os/fat32-x86_64.img ;;
        arm32) kernel=build/os/simpleos_arm32_fs_exec.elf; image=build/os/fat32-arm32.img ;;
        arm64) kernel=build/os/simpleos_arm64_fs_exec.elf; image=build/os/fat32-arm64.img ;;
        riscv32) kernel=build/os/simpleos_riscv32_smf_fs.elf; image=build/os/fat32-riscv32.img ;;
        riscv64) kernel=build/os/simpleos_riscv64_smf_fs.elf; image=build/os/fat32-riscv64.img ;;
    esac
    bundle=$output/$host/$guest/blocked-$prepared_at
    mkdir -p "$bundle"
    receipt=$bundle/blocker.txt
    {
        echo "status=blocked"
        echo "requested_host=$host"
        echo "actual_host=$actual_host"
        echo "guest=$guest"
        echo "reason=$reason"
        echo "resume_command=$resume"
        echo "owner=$owner"
        echo "reviewer=$reviewer"
        echo "source_git_identity=$source_hash"
        echo "compiler_identity=$compiler_identity"
        echo 'compiler_identity_scope=source-toolchain'
        echo "compiler_policy_sha256=$(hash_file "$compiler_policy")"
        echo 'compiler_policy_value=false'
        echo "kernel_identity=$(identity kernel "$repo_root/$kernel")"
        echo "image_identity=$(identity image "$repo_root/$image")"
        echo "execution=not-executed"
    } > "$receipt"
    receipt_hash=$(hash_file "$receipt")
    kernel_identity=$(identity kernel "$repo_root/$kernel")
    image_identity=$(identity image "$repo_root/$image")
    {
        echo 'schema_version=1'
        echo "host=$host"
        echo "guest=$guest"
        echo 'status=blocked'
        echo "reason=$reason"
        echo "owner=$owner"
        echo "reviewer=$reviewer"
        echo "resume_command=$resume"
        echo "source_identity=git:$source_hash"
        echo "compiler_identity=$compiler_identity"
        echo 'compiler_identity_scope=source-toolchain'
        echo "compiler_policy_sha256=$(hash_file "$compiler_policy")"
        echo 'compiler_policy_value=false'
        echo "kernel_identity=$kernel_identity"
        echo "image_identity=$image_identity"
        echo 'qemu_identity=not-executed:actual-host-required'
        echo 'qemu_argv=not-executed'
        echo "accelerator_identity=$accelerator"
        echo 'firmware_identity=not-executed:actual-host-required'
        echo 'firmware_mode=not-executed'
        echo 'firmware_path=not-executed'
        echo 'firmware_version=not-executed'
        echo 'firmware_sha256=not-executed'
        echo 'firmware_stage_markers=not-executed'
        echo 'boot_correlation_marker=not-executed'
        echo "run_nonce=blocked-$host-$guest-$prepared_at-$receipt_hash"
        echo "transcript_identity=sha256:$receipt_hash"
        echo 'program_identity=not-executed:guest-program-not-run'
        echo 'compiler_in_filesystem=false'
        echo 'compiler_payload_identity='
        echo 'compiler_image_identity='
        echo 'compiler_alias_identity='
        echo 'compiler_manifest_identity='
        echo 'compiler_designation_scope=live-policy'
        echo 'compiler_version_evidence_path='
        echo 'compiler_hello_evidence_path='
        echo 'compiler_alias_evidence_path='
        echo 'compiler_manifest_evidence_path='
        echo 'artifact_count=1'
        echo 'artifact_1_path=blocker.txt'
        echo "artifact_1_sha256=$receipt_hash"
    } > "$bundle/evidence.env"
done

echo 'sosix_qemu_external_blocked_bundle_status=blocked'
echo "sosix_qemu_external_blocked_bundle_host=$host"
echo 'sosix_qemu_external_blocked_bundle_count=6'
echo "sosix_qemu_external_blocked_bundle_reason=$reason"
echo "sosix_qemu_external_blocked_bundle_output=$output/$host"
exit 2
