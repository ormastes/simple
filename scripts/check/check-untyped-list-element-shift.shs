#!/bin/sh
# Regression canary for the untyped `list`-parameter element-read `<<3`
# corruption (Rust seed JIT lane).
#
# STATUS 2026-08-17: FIXED and now PINNED. This guard used to exit 0 on the
# corrupted `40,56` output (the bug was open) and fail with `promote-me` when
# the output became correct. That has been inverted: correct `5,7` output is
# now the PASS, and the `40,56` signature is a hard FAIL. The promotion was
# done when the guard fired on a real push, exactly as its message instructed.
#
# WHY THIS EXISTS: `bin/simple test` hard-defaults to the tree-walk
# interpreter and never reaches the Cranelift JIT lane, which is where this
# defect lives -- only a script driving `bin/simple run` under both engines
# can fence it.
# Bug: doc/08_tracking/bug/untyped_list_element_read_seed_rootcause_2026-07-30.md
#
# Root cause (Rust seed, out of `.spl`-fix scope): `lower_index_expr` in
# src/compiler_rust/compiler/src/mir/lower/lowering_expr_struct.rs computes
# `needs_int_unbox` from the STATIC element type; a bare `: list` parameter
# resolves to `HirType::Array { element: TypeId::ANY }`, so the compiler
# correctly declines to prove it's numeric and skips the `UnboxInt` MIR
# instruction -- the tagged/boxed word (value*8 + tag bits) is used raw,
# producing `value << 3`. A `[i64]`-typed parameter is unaffected (the
# element type is statically known and IS unboxed).
#
# Discriminator: the fixture reads several distinct values (5, 7) through
# BOTH a `: list`-typed param and a `[i64]`-typed control param from the
# SAME underlying array, so the corrupted/uncorrupted comparison isolates
# the parameter's static type, not the data. The corruption signature is
# checked to be EXACTLY value*8 (5->40, 7->56), not arbitrary garbage.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

SIMPLE_BINARY="${SIMPLE_BINARY:-bin/simple}"
FIXTURE="test/fixtures/untyped_list_element_shift/main.spl"

test -x "$SIMPLE_BINARY"
test -f "$FIXTURE"

WORK_DIR="${WORK_DIR:-/tmp/check-untyped-list-element-shift.$$}"
mkdir -p "$WORK_DIR"
trap 'rm -rf "$WORK_DIR"' EXIT HUP INT TERM

interp_log="$WORK_DIR/interpret.log"
jit_log="$WORK_DIR/jit.log"

timeout 30 env SIMPLE_EXECUTION_MODE=interpret "$SIMPLE_BINARY" run "$FIXTURE" >"$interp_log" 2>&1
interp_rc=$?
timeout 30 "$SIMPLE_BINARY" run "$FIXTURE" >"$jit_log" 2>&1
jit_rc=$?

if [ "$interp_rc" -ne 0 ]; then
    echo "FAIL — interpreter lane did not exit 0 (rc=$interp_rc)"
    tail -20 "$interp_log"
    exit 1
fi
if [ "$jit_rc" -ne 0 ]; then
    echo "FAIL — JIT lane did not exit 0 (rc=$jit_rc)"
    tail -20 "$jit_log"
    exit 1
fi

get() { sed -n "s/^$2=//p" "$1" | head -1; }

interp_typed0="$(get "$interp_log" typed0)"
interp_typed1="$(get "$interp_log" typed1)"
interp_list0="$(get "$interp_log" list0)"
interp_list1="$(get "$interp_log" list1)"

# --- Interpreter reference lane: must be fully correct on BOTH the typed
# control and the untyped `list` param. ---
if [ "$interp_typed0" != "5" ] || [ "$interp_typed1" != "7" ] || \
   [ "$interp_list0" != "5" ] || [ "$interp_list1" != "7" ]; then
    echo "FAIL — interpreter reference lane regressed; cannot trust the JIT comparison below."
    echo "       typed0=$interp_typed0 typed1=$interp_typed1 list0=$interp_list0 list1=$interp_list1"
    echo "       (expected 5,7,5,7)"
    exit 1
fi
echo "PASS — interpreter reference lane correct: typed=[5,7], list-param=[5,7]"

jit_typed0="$(get "$jit_log" typed0)"
jit_typed1="$(get "$jit_log" typed1)"
jit_list0="$(get "$jit_log" list0)"
jit_list1="$(get "$jit_log" list1)"

# The typed `[i64]` control MUST be correct on the JIT lane regardless of
# this bug's status -- if this regresses, something ELSE broke.
if [ "$jit_typed0" != "5" ] || [ "$jit_typed1" != "7" ]; then
    echo "FAIL — JIT typed-param control regressed (unrelated to this bug): expected 5,7, got $jit_typed0,$jit_typed1"
    exit 1
fi

if [ "$jit_list0" = "5" ] && [ "$jit_list1" = "7" ]; then
    echo "PASS — 4 value(s) checked, untyped ': list' param element read correct on the JIT lane:"
    echo "       list=[$jit_list0,$jit_list1], typed [i64] control=[$jit_typed0,$jit_typed1] (both expected 5,7)"
    exit 0
fi

# PROMOTED 2026-08-17: this used to be the KNOWN-OPEN exit-0 branch. The <<3
# corruption is fixed, the correct-behaviour branch above is now the pass, and
# reappearance of the exact value*8 signature is a REGRESSION, not the status
# quo. Do not demote this back to exit 0 to get a green push -- if it fires,
# the seed's UnboxInt elision for `TypeId::ANY` element types is back.
if [ "$jit_list0" = "40" ] && [ "$jit_list1" = "56" ]; then
    echo "FAIL — REGRESSION: the untyped ': list' param element read is corrupted again with the"
    echo "       EXACT <<3 signature: list0=$jit_list0 (expected 5, got value*8), list1=$jit_list1 (expected 7, got value*8)."
    echo "       Typed [i64] control unaffected on the same lane: typed0=$jit_typed0 typed1=$jit_typed1"
    echo "       This bug was fixed and is now pinned; see"
    echo "       doc/08_tracking/bug/untyped_list_element_read_seed_rootcause_2026-07-30.md"
    exit 1
fi

echo "FAIL — untyped ': list' param JIT output changed but is neither the correct value NOR the"
echo "       documented <<3 signature (list0=$jit_list0 list1=$jit_list1, expected 5,7 fixed or 40,56 known-open)."
echo "       This is a NEW divergence, not the tracked bug -- investigate before trusting this gate."
exit 1
