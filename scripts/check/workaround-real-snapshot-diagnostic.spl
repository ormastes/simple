use app.bug.workaround_store.{workaround_bug_snapshot}
use std.nogc_sync_mut.database.bug.{load_bug_database_checked}
use std.nogc_async_mut.sosix.workaround_host.{workaround_host_cwd}

fn main() -> i64:
    match workaround_bug_snapshot(workaround_host_cwd()):
        case Err(reason):
            print "snapshot error: {reason}"
            match load_bug_database_checked("doc/08_tracking/bug/bug_db.sdn"):
                case Err(canonical_reason): print "canonical loader error: {canonical_reason}"
                case Ok(_): print "canonical loader accepted"
            return 1
        case Ok(db):
            val present = db.get_bug("stage3_scv_inventory_noncanonical_2026_09_20").?
            print "snapshot loaded; target present: {present}"
            if not present: return 2
    return 0
