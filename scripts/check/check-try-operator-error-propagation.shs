#!/bin/sh
# Guard: the `?` (try) operator must EARLY-RETURN on the error variant.
#
# Bug: doc/08_tracking/bug/try_operator_early_return_matches_neither_ok_nor_err_2026-08-07.md
# Fix: a59575dfde3 (seed `lower_try`, src/compiler_rust/compiler/src/hir/lower/expr/control.rs)
#
# WHY THIS IS A SHELL SCRIPT AND NOT A `*_spec.spl`
# -------------------------------------------------
# The landed regression spec test/01_unit/try_operator_error_propagation_spec.spl
# does NOT discriminate this defect: it reports `6 examples, 0 failures` against
# both a pre-fix (RED) and a post-fix (GREEN) seed, under every
# SIMPLE_EXECUTION_MODE tried. The `describe`/`it`/`expect` DSL executes example
# bodies through a path that never reaches the buggy JIT `lower_try` lowering, so
# no assertion written inside that DSL can go red on the broken compiler. Only a
# plain, non-DSL `.spl` script run directly through `bin/simple run` reaches it.
# That is a structural property of the spec runner, not a fixable assertion bug —
# hence a check script that shells out to the compiler under test.
#
# WHAT IS ASSERTED
# ----------------
# The witness is CONTROL FLOW, not just the returned value. A `print` sits AFTER
# the `?` in the propagating function. On the broken lowering `?` emitted a bare
# `rt_enum_payload(expr)` — no discriminant test, no branch, no return — so
# execution FELL THROUGH and that print fired while the caller observed
# `Ok(<error payload>)`. So:
#
#   * the post-`?` marker must NOT appear on the error path (early return taken)
#   * the caller must observe ERR with the ORIGINAL payload (re-wrapped whole,
#     not the unwrapped payload and not a differently-typed value)
#   * the success path must still fall through and unwrap the Ok payload
#
# Checked under the default engine and with SIMPLE_EXECUTION_MODE forced to
# `interpret` and `jit`, because the defect was engine-specific: the interpreter
# was always correct and only the JIT path was broken. Checking the default
# engine alone would fail open if the default ever moved to the interpreter.
#
# SCOPE — Result ONLY. `?` on an Option is a SEPARATE, STILL-OPEN defect:
# `lower_try` tests the hashed "Err" discriminant unconditionally, with no
# Optional branch, so `None?` neither early-returns nor produces a value that
# matches `Some` or `None`. See
# doc/08_tracking/bug/try_operator_on_option_no_early_return_2026-08-08.md.
# Deliberately NOT asserted here: this guard must be green on landing so it does
# not get disabled. Promote the Option case into this script when that bug is
# fixed; a ready-to-use probe is embedded in that bug doc.
#
# FAIL-CLOSED CONTRACT
# --------------------
# Every step's exit status is checked. An unusable compiler, a probe that fails
# to run, or empty output is an ERROR (exit 2), never a pass. The verdict line is
# always the LAST line of stdout and always states how many engines were actually
# exercised, so a vacuous run cannot be mistaken for a real one:
#
#   PASS — <n> engine(s) checked: ...     exit 0   (n is always > 0)
#   FAIL — ...                            exit 1
#   ERROR — nothing was checked           exit 2

set -u

SIMPLE_BIN="${SIMPLE_BIN:-bin/simple}"

fail()  { printf 'FAIL — %s\n'  "$1"; exit 1; }
oops()  { printf 'ERROR — nothing was checked: %s\n' "$1"; exit 2; }

command -v "$SIMPLE_BIN" >/dev/null 2>&1 || [ -x "$SIMPLE_BIN" ] \
  || oops "compiler not executable at '$SIMPLE_BIN' (set SIMPLE_BIN to override)"

work="$(mktemp -d)" || oops "mktemp failed"
trap 'rm -rf "$work"' EXIT INT TERM

probe="$work/try_result_probe.spl"
cat > "$probe" <<'PROBE_EOF'
fn inner(bad: bool) -> Result<text, text>:
    if bad:
        return Err("boom")
    return Ok("payload")

# The print AFTER the `?` is the control-flow witness: on the broken lowering
# there is no early return, so it fires even on the Err path.
fn propagate(bad: bool) -> Result<text, text>:
    val p = inner(bad)?
    print("FELL_THROUGH")
    return Ok("bound:" + p)

fn tag(r: Result<text, text>) -> text:
    match r:
        case Ok(v): return "OK:" + v
        case Err(e): return "ERR:" + e
    return "NEITHER"

fn main():
    print("err=" + tag(propagate(true)))
    print("ok=" + tag(propagate(false)))
PROBE_EOF
[ -s "$probe" ] || oops "probe file was not written"

checked=0
engines=""

for mode in default interpret jit; do
  out="$work/out.$mode"
  if [ "$mode" = default ]; then
    unset SIMPLE_EXECUTION_MODE
    "$SIMPLE_BIN" run "$probe" > "$out" 2>&1
  else
    SIMPLE_EXECUTION_MODE="$mode" "$SIMPLE_BIN" run "$probe" > "$out" 2>&1
  fi
  rc=$?
  [ "$rc" -eq 0 ] || oops "probe exited $rc under engine '$mode' (see output: $(tr '\n' '|' < "$out"))"
  [ -s "$out" ]   || oops "probe produced no output under engine '$mode'"

  # Sanity: the probe must have actually run to completion. Without this an
  # early crash that printed neither line would satisfy the negative assertion
  # below vacuously.
  /usr/bin/grep -aq '^ok=' "$out" \
    || oops "probe did not reach the success case under engine '$mode' — assertions would be vacuous"

  # 1. Err must propagate with the ORIGINAL payload, re-wrapped whole.
  #    Broken lowering yields `OK:boom` (error payload unwrapped as success).
  /usr/bin/grep -aq '^err=ERR:boom$' "$out" \
    || fail "engine '$mode': try-operator did not propagate Err with the original payload; expected 'err=ERR:boom', got: $(/usr/bin/grep -a '^err=' "$out")"

  # 2. Control flow: the post-`?` marker must not run on the error path.
  #    The success path legitimately prints it exactly once.
  n_fell=$(/usr/bin/grep -ac '^FELL_THROUGH$' "$out")
  [ "$n_fell" -eq 1 ] \
    || fail "engine '$mode': expected the post-try marker exactly once (success path only), saw $n_fell — the try operator did not early-return on Err"

  # 3. Success path still unwraps the Ok payload.
  /usr/bin/grep -aq '^ok=OK:bound:payload$' "$out" \
    || fail "engine '$mode': Ok path did not unwrap correctly; got: $(/usr/bin/grep -a '^ok=' "$out")"

  checked=$((checked + 1))
  engines="${engines:+$engines,}$mode"
done

[ "$checked" -gt 0 ] || oops "no engine was exercised"
printf 'PASS — %d engine(s) checked: %s — `?` early-returns Err with the original payload\n' "$checked" "$engines"
exit 0
