#!/bin/sh
# Guard: OS identity must come from std.io_runtime.platform_name(), never the
# SIMPLE_OS_TYPE env var (nothing sets it; bug gpu_ffi_loader_probes_linux_sonames_on_macos_2026_09_19).
root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "ERROR — nothing was checked"; exit 2; }
n=$(git -C "$root" ls-files 'src/*.spl' | wc -l)
[ "$n" -gt 0 ] || { echo "ERROR — nothing was checked"; exit 2; }
hits=$(git -C "$root" grep -n 'env_get("SIMPLE_OS_TYPE")' -- 'src/*.spl')
if [ -n "$hits" ]; then echo "$hits"; echo "FAIL — SIMPLE_OS_TYPE read in src; use platform_name()"; exit 1; fi
echo "PASS — $n file(s) checked, 0 SIMPLE_OS_TYPE reads"
