#!/bin/sh
set -eu

REPO_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
BUILD_DIR="$REPO_ROOT/build/runtime-https-openssl-selfcheck"
FIXTURES="$REPO_ROOT/src/compiler_rust/runtime/tests/fixtures/browser_tls_identity"
BIN="$BUILD_DIR/rt_tls_client_openssl_selfcheck"

command -v pkg-config >/dev/null 2>&1 && pkg-config --exists openssl || {
  echo "STATUS: FAIL OpenSSL development package unavailable" >&2
  exit 1
}
mkdir -p "$BUILD_DIR"
mkdir -p "$BUILD_DIR/empty-trust"

CA="$FIXTURES/ca.pem"
LOCAL_CERT="$FIXTURES/localhost.pem"
LOCAL_KEY="$FIXTURES/localhost-key.pem"
WRONG_CERT="$FIXTURES/wrong-host.pem"
WRONG_KEY="$FIXTURES/wrong-host-key.pem"

for FIXTURE in "$CA" "$LOCAL_CERT" "$LOCAL_KEY" "$WRONG_CERT" "$WRONG_KEY"; do
  if [ ! -s "$FIXTURE" ]; then
    echo "STATUS: FAIL HTTPS fixture missing: $FIXTURE" >&2
    exit 1
  fi
done

# shellcheck disable=SC2046
"${CC:-cc}" -std=gnu11 -Wall -Wextra -Werror \
  -I"$REPO_ROOT/src/runtime" \
  $(pkg-config --cflags openssl) \
  "$REPO_ROOT/src/runtime/runtime_https_openssl_core.c" \
  "$REPO_ROOT/src/runtime/test/rt_tls_client_openssl_selfcheck.c" \
  -o "$BIN.new" $(pkg-config --libs openssl) -lpthread
mv "$BIN.new" "$BIN"

SSL_CERT_FILE="$CA" timeout 12s "$BIN" trusted "$LOCAL_CERT" "$LOCAL_KEY" localhost
SSL_CERT_FILE="$CA" timeout 12s "$BIN" mismatch "$WRONG_CERT" "$WRONG_KEY" localhost
SSL_CERT_FILE="$WRONG_CERT" SSL_CERT_DIR="$BUILD_DIR/empty-trust" timeout 12s \
  "$BIN" untrusted "$LOCAL_CERT" "$LOCAL_KEY" localhost
SSL_CERT_FILE="$CA" timeout 12s "$BIN" stall "$LOCAL_CERT" "$LOCAL_KEY" localhost
SSL_CERT_FILE="$CA" timeout 12s "$BIN" reset "$LOCAL_CERT" "$LOCAL_KEY" localhost
SSL_CERT_FILE="$CA" timeout 12s "$BIN" trickle "$LOCAL_CERT" "$LOCAL_KEY" localhost
echo "STATUS: PASS runtime HTTPS OpenSSL"
