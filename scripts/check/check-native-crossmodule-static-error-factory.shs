#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
cd "$root"

simple_bin=${SIMPLE_BIN:-bin/simple}
fixture=test/fixtures/native_crossmodule_static_error_factory/main.spl
artifact_dir=build/test-artifacts/native_crossmodule_static_error_factory
candidate=$artifact_dir/probe
build_log=$artifact_dir/native-build.log
run_log=$artifact_dir/native-run.log

[ -x "$simple_bin" ] || {
  echo "STATUS: FAIL native-crossmodule-static-factory reason=compiler-missing path=$simple_bin"
  exit 1
}
version=$($simple_bin --version 2>&1) || exit 1
case "$version" in
  *Rust-built*|*"bootstrap seed only"*)
    echo "STATUS: FAIL native-crossmodule-static-factory reason=rust-seed-forbidden"
    exit 1
    ;;
esac

mkdir -p "$artifact_dir"
case "$version" in
  simple-bootstrap*)
    build_ok=0
    env -u SIMPLE_RUNTIME_PATH SIMPLE_BOOTSTRAP=1 SIMPLE_NO_STUB_FALLBACK=1 \
      "$simple_bin" native-build --target x86_64-unknown-linux-gnu \
      --backend llvm --runtime-bundle core-c-bootstrap \
      --source test/fixtures/native_crossmodule_static_error_factory \
      --entry-closure --threads 1 --cache-dir "$artifact_dir/cache" \
      --entry "$fixture" -o "$candidate" >"$build_log" 2>&1 || build_ok=$?
    ;;
  *)
    build_ok=0
    env -u SIMPLE_BOOTSTRAP -u SIMPLE_RUNTIME_PATH SIMPLE_NO_STUB_FALLBACK=1 \
      "$simple_bin" compile "$fixture" --native -o "$candidate" \
      >"$build_log" 2>&1 || build_ok=$?
    ;;
esac
if [ "$build_ok" -ne 0 ]; then
  echo "STATUS: FAIL native-crossmodule-static-factory reason=native-compile-failed log=$build_log"
  exit 1
fi
if ! timeout 30 "$candidate" >"$run_log" 2>&1; then
  echo "STATUS: FAIL native-crossmodule-static-factory reason=native-execution-failed log=$run_log"
  exit 1
fi
grep -Fq 'STATIC FACTORY VERDICT: PASS runtime:17|typed:23' "$run_log" || {
  echo "STATUS: FAIL native-crossmodule-static-factory reason=verdict-missing log=$run_log"
  exit 1
}
echo "STATUS: PASS native-crossmodule-static-factory factories=2"
