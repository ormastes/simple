#!/bin/sh
# Reproducible source/frozen-C/host+ARM ABI evidence producer.
# This diagnostic never invokes Simple and never claims Stage-4 evidence.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
OUT=${COSMOS_FTL_NFC_BACKEND_POLICY_OUT:-$ROOT/build/verify/cosmos-ftl-nfc-backend-policy-source-c}
MODE=${1:---produce}
SOURCE_DIR=$ROOT/src/os/kernel/arch/arm32/cosmos
POLICY=$SOURCE_DIR/cosmos_ftl_nfc_backend_policy.spl
HEADER=$SOURCE_DIR/cosmos_ftl_nfc_backend_policy.h
BRIDGE=$SOURCE_DIR/cosmos_ftl_nfc_backend.c
ORACLE_DIR=$ROOT/test/02_integration/os/cosmos
ORACLE=$ORACLE_DIR/cosmos_ftl_nfc_backend_policy_frozen_oracle.c
ORACLE_HEADER=$ORACLE_DIR/cosmos_ftl_nfc_backend_policy_oracle.h
PARITY=$ORACLE_DIR/cosmos_ftl_nfc_backend_policy_parity_test.c
FIXTURE_DIR=$ROOT/test/fixtures/os
PROBE=$FIXTURE_DIR/cosmos_ftl_nfc_backend_policy_probe.spl
PIN=$FIXTURE_DIR/cosmos_ftl_nfc_backend_policy_coverage_pin.env
RECEIPT=$FIXTURE_DIR/cosmos_ftl_nfc_backend_policy_source_receipt.env
CHECKER=$ROOT/scripts/check/check-cosmos-ftl-nfc-backend-policy-source-c.shs
CC_BIN=${CC:-clang-20}
CC_MAJOR=$($CC_BIN -dumpversion | sed 's/\..*//')
LLVM_PROFDATA_BIN=${LLVM_PROFDATA:-llvm-profdata-$CC_MAJOR}
LLVM_COV_BIN=${LLVM_COV:-llvm-cov-$CC_MAJOR}
LLVM_NM_BIN=${LLVM_NM:-llvm-nm-$CC_MAJOR}
READELF_BIN=${READELF:-readelf}

fail() {
    echo "FAIL cosmos-ftl-nfc-backend-policy-source-c: $*" >&2
    exit 1
}

hash_file() {
    sha256sum "$1" | awk '{print $1}'
}

pin_value() {
    sed -n "s/^$1=//p" "$PIN"
}

receipt_value() {
    sed -n "s/^$1=//p" "$RECEIPT"
}

for tool in "$CC_BIN" "$LLVM_PROFDATA_BIN" "$LLVM_COV_BIN" \
    "$LLVM_NM_BIN" "$READELF_BIN" awk cmp grep sed sha256sum; do
    command -v "$tool" >/dev/null 2>&1 || fail "missing tool: $tool"
done

mkdir -p "$OUT"
grep -n -o 'COSMOS-FTL-NFC-D[0-9][0-9][0-9]' "$POLICY" \
    > "$OUT/decision-locations.txt"
awk -F: '{print $2}' "$OUT/decision-locations.txt" | LC_ALL=C sort \
    > "$OUT/decision-ids.txt"
awk 'BEGIN {for (i = 1; i <= 71; i++)
         printf "COSMOS-FTL-NFC-D%03d\n", i}' > "$OUT/required-decision-ids.txt"
cmp "$OUT/required-decision-ids.txt" "$OUT/decision-ids.txt" ||
    fail decision-id-set
[ "$(wc -l < "$OUT/decision-locations.txt" | tr -d ' ')" = 71 ] ||
    fail decision-location-count

if [ "$MODE" = --produce ]; then
    "$CC_BIN" -std=c11 -O0 -g -Wall -Wextra -Werror -Wpedantic -Wshadow \
        -fprofile-instr-generate -fcoverage-mapping \
        -DCOSMOS_FTL_NFC_BACKEND_ORACLE_ONLY=1 -I"$ORACLE_DIR" \
        "$PARITY" "$ORACLE" -o "$OUT/oracle"
    ORACLE_OUTPUT=$(LLVM_PROFILE_FILE="$OUT/oracle.profraw" "$OUT/oracle")
    [ "$ORACLE_OUTPUT" = "COSMOS_FTL_NFC_BACKEND_PARITY_ROWS 125" ] ||
        fail "unexpected oracle output: $ORACLE_OUTPUT"
    "$LLVM_PROFDATA_BIN" merge -sparse "$OUT/oracle.profraw" \
        -o "$OUT/oracle.profdata"
    "$LLVM_COV_BIN" report "$OUT/oracle" \
        -instr-profile="$OUT/oracle.profdata" "$ORACLE" \
        > "$OUT/oracle-coverage.txt"
    awk '$1 == "TOTAL" {printf "regions_total=%s\nregions_missed=%s\nfunctions_total=%s\nfunctions_missed=%s\nlines_total=%s\nlines_missed=%s\nbranch_edges_total=%s\nbranch_edges_missed=%s\n", $2, $3, $5, $6, $8, $9, $11, $12}' \
        "$OUT/oracle-coverage.txt" > "$OUT/coverage-metrics.env"
    [ "$(sed -n 's/^regions_missed=//p' "$OUT/coverage-metrics.env")" = 0 ] ||
        fail oracle-region-coverage
    [ "$(sed -n 's/^functions_missed=//p' "$OUT/coverage-metrics.env")" = 0 ] ||
        fail oracle-function-coverage
    [ "$(sed -n 's/^lines_missed=//p' "$OUT/coverage-metrics.env")" = 0 ] ||
        fail oracle-line-coverage
    [ "$(sed -n 's/^branch_edges_missed=//p' "$OUT/coverage-metrics.env")" = 0 ] ||
        fail oracle-branch-coverage

    HOST_FLAGS='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -DCOSMOS_MMIO_TEST=1'
    ARM_FLAGS='--target=armv7-none-eabi -mcpu=cortex-a9 -marm -ffreestanding -nostdlib -fno-builtin -O2 -Wall -Wextra -Werror'
    "$CC_BIN" $HOST_FLAGS -c "$BRIDGE" -o "$OUT/bridge-host-fallback.o"
    "$CC_BIN" $ARM_FLAGS -c "$BRIDGE" -o "$OUT/bridge-arm-fallback.o"
    "$CC_BIN" $HOST_FLAGS -DCOSMOS_FTL_NFC_BACKEND_PURE_POLICY=1 \
        -DCOSMOS_FTL_NFC_METADATA_PAGE_LIMIT=1024U -c "$BRIDGE" \
        -o "$OUT/bridge-host-external.o"
    "$CC_BIN" $ARM_FLAGS -DCOSMOS_FTL_NFC_BACKEND_PURE_POLICY=1 \
        -c "$BRIDGE" -o "$OUT/bridge-arm-external.o"

    "$LLVM_NM_BIN" --undefined-only "$OUT/bridge-host-external.o" |
        awk '$2 ~ /^cosmos_ftl_nfc_backend_policy_/ {print $2}' |
        LC_ALL=C sort -u > "$OUT/host-policy-symbols.txt"
    "$LLVM_NM_BIN" --undefined-only "$OUT/bridge-arm-external.o" |
        awk '$2 ~ /^cosmos_ftl_nfc_backend_policy_/ {print $2}' |
        LC_ALL=C sort -u > "$OUT/arm-policy-symbols.txt"
    sed -n 's/^[a-z][a-z ]* \(cosmos_ftl_nfc_backend_policy_[a-z_]*\)(.*/\1/p' \
        "$HEADER" | LC_ALL=C sort -u > "$OUT/header-policy-symbols.txt"
    [ "$(wc -l < "$OUT/header-policy-symbols.txt" | tr -d ' ')" = 27 ] ||
        fail header-export-count
    cmp "$OUT/header-policy-symbols.txt" "$OUT/host-policy-symbols.txt" ||
        fail host-policy-symbol-closure
    cmp "$OUT/header-policy-symbols.txt" "$OUT/arm-policy-symbols.txt" ||
        fail arm-policy-symbol-closure
    "$READELF_BIN" -hW "$OUT/bridge-arm-external.o" \
        > "$OUT/arm-header.txt"
    "$READELF_BIN" -AW "$OUT/bridge-arm-external.o" \
        > "$OUT/arm-attributes.txt"
    grep -Eq 'Class:[[:space:]]+ELF32' "$OUT/arm-header.txt" ||
        fail arm-class
    grep -Eq 'Type:[[:space:]]+REL' "$OUT/arm-header.txt" || fail arm-type
    grep -Eq 'Machine:[[:space:]]+ARM' "$OUT/arm-header.txt" || fail arm-machine
    grep -Fq 'Tag_CPU_name: "cortex-a9"' "$OUT/arm-attributes.txt" ||
        fail arm-cpu
    grep -Fq 'Tag_CPU_arch: v7' "$OUT/arm-attributes.txt" || fail arm-arch
    if grep -Eq 'Tag_FP_arch:|Tag_ABI_VFP_args:.*VFP registers' \
            "$OUT/arm-attributes.txt"; then
        fail arm-soft-float
    fi

    sha256sum "$OUT/oracle" "$OUT/oracle.profdata" \
        "$OUT/bridge-host-fallback.o" "$OUT/bridge-arm-fallback.o" \
        "$OUT/bridge-host-external.o" "$OUT/bridge-arm-external.o" \
        "$OUT/decision-locations.txt" "$OUT/header-policy-symbols.txt" \
        > "$OUT/artifact.sha256"
    {
        printf 'schema=cosmos-ftl-nfc-backend-policy-produced-evidence/v1\n'
        printf 'stage4.claimed=false\n'
        printf 'rust_seed.used=false\n'
        printf 'parity_rows=125\n'
        cat "$OUT/coverage-metrics.env"
        printf 'decision_locations.sha256=%s\n' \
            "$(hash_file "$OUT/decision-locations.txt")"
        printf 'policy_symbols.sha256=%s\n' \
            "$(hash_file "$OUT/header-policy-symbols.txt")"
        sed 's#  .*oracle$#  oracle#;
             s#  .*oracle.profdata$#  oracle.profdata#;
             s#  .*bridge-host-fallback.o$#  bridge-host-fallback.o#;
             s#  .*bridge-arm-fallback.o$#  bridge-arm-fallback.o#;
             s#  .*bridge-host-external.o$#  bridge-host-external.o#;
             s#  .*bridge-arm-external.o$#  bridge-arm-external.o#' \
            "$OUT/artifact.sha256"
    } > "$OUT/evidence.env"
    echo "PASS cosmos-ftl-nfc-backend-policy-source-c producer out=$OUT"
    exit 0
fi

[ "$MODE" = --verify ] || fail "usage: $0 [--produce|--verify]"
sha256sum -c "$OUT/artifact.sha256" >/dev/null || fail artifact-hash
[ "$(pin_value schema)" = cosmos-ftl-nfc-backend-policy-coverage/v1 ] ||
    fail pin-schema
[ "$(pin_value owner_source_sha256)" = "$(hash_file "$POLICY")" ] ||
    fail pin-policy
[ "$(pin_value decision_ids_sha256)" = \
  "$(hash_file "$OUT/decision-locations.txt")" ] || fail pin-decisions
[ "$(pin_value c_oracle_source_sha256)" = "$(hash_file "$ORACLE")" ] ||
    fail pin-oracle
[ "$(pin_value c_parity_driver_sha256)" = "$(hash_file "$PARITY")" ] ||
    fail pin-parity
[ "$(pin_value simple_probe_source_sha256)" = "$(hash_file "$PROBE")" ] ||
    fail pin-probe
[ "$(pin_value source_checker_sha256)" = "$(hash_file "$CHECKER")" ] ||
    fail pin-checker
[ "$(pin_value clang_oracle_functions_total)" = \
  "$(sed -n 's/^functions_total=//p' "$OUT/coverage-metrics.env")" ] ||
    fail pin-functions
[ "$(pin_value clang_oracle_lines_total)" = \
  "$(sed -n 's/^lines_total=//p' "$OUT/coverage-metrics.env")" ] ||
    fail pin-lines
[ "$(pin_value clang_oracle_branch_edges_total)" = \
  "$(sed -n 's/^branch_edges_total=//p' "$OUT/coverage-metrics.env")" ] ||
    fail pin-branches
[ "$(receipt_value source.policy.sha256)" = "$(hash_file "$POLICY")" ] ||
    fail receipt-policy
[ "$(receipt_value source.abi_header.sha256)" = "$(hash_file "$HEADER")" ] ||
    fail receipt-header
[ "$(receipt_value source.c_bridge.sha256)" = "$(hash_file "$BRIDGE")" ] ||
    fail receipt-bridge
[ "$(receipt_value source.oracle_header.sha256)" = \
  "$(hash_file "$ORACLE_HEADER")" ] || fail receipt-oracle-header
[ "$(receipt_value source.frozen_oracle.sha256)" = "$(hash_file "$ORACLE")" ] ||
    fail receipt-oracle
[ "$(receipt_value source.parity_matrix.sha256)" = "$(hash_file "$PARITY")" ] ||
    fail receipt-parity
[ "$(receipt_value source.simple_probe.sha256)" = "$(hash_file "$PROBE")" ] ||
    fail receipt-probe
[ "$(receipt_value source.checker.sha256)" = "$(hash_file "$CHECKER")" ] ||
    fail receipt-checker
[ "$(receipt_value source.coverage_pin.sha256)" = "$(hash_file "$PIN")" ] ||
    fail receipt-pin
[ "$(receipt_value frozen_oracle.parity_matrix_rows)" = 125 ] ||
    fail receipt-parity-rows
[ "$(receipt_value frozen_oracle.binary.sha256)" = \
  "$(hash_file "$OUT/oracle")" ] || fail receipt-oracle-binary
[ "$(receipt_value frozen_oracle.profdata.sha256)" = \
  "$(hash_file "$OUT/oracle.profdata")" ] || fail receipt-oracle-profdata
[ "$(receipt_value frozen_oracle.produced_evidence.sha256)" = \
  "$(hash_file "$OUT/evidence.env")" ] || fail receipt-produced-evidence
[ "$(receipt_value c_bridge.host_fallback_object.sha256)" = \
  "$(hash_file "$OUT/bridge-host-fallback.o")" ] || fail receipt-host-fallback
[ "$(receipt_value c_bridge.arm_fallback_object.sha256)" = \
  "$(hash_file "$OUT/bridge-arm-fallback.o")" ] || fail receipt-arm-fallback
[ "$(receipt_value c_bridge.host_external_object.sha256)" = \
  "$(hash_file "$OUT/bridge-host-external.o")" ] || fail receipt-host-external
[ "$(receipt_value c_bridge.arm_external_object.sha256)" = \
  "$(hash_file "$OUT/bridge-arm-external.o")" ] || fail receipt-arm-external
[ "$(receipt_value c_bridge.external_policy_undefined_symbols.sha256)" = \
  "$(hash_file "$OUT/header-policy-symbols.txt")" ] || fail receipt-symbol-set
[ "$(receipt_value stage4.claimed)" = false ] || fail receipt-stage4
[ "$(receipt_value rust_seed.used)" = false ] || fail receipt-rust-seed
echo "PASS cosmos-ftl-nfc-backend-policy-source-c verified out=$OUT"
