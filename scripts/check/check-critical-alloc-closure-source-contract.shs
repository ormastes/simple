#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
PASS="$ROOT_DIR/src/compiler/35.semantics/critical_alloc_closure.spl"
CALL_GRAPH="$ROOT_DIR/src/compiler/35.semantics/effect_validation.spl"
DRIVER="$ROOT_DIR/src/compiler/80.driver/driver_hir_pipeline_lowering.spl"
SPEC="$ROOT_DIR/test/01_unit/compiler/semantics/critical_alloc_closure_spec.spl"

require() {
    pattern=$1
    file=$2
    /bin/grep -Fq "$pattern" "$file" || {
        echo "STATUS: FAIL critical-alloc-closure missing=$pattern file=$file" >&2
        exit 1
    }
}

require 'effect_block_callees(function_.body, fn_names)' "$PASS"
require 'function_.func_attr.is_no_alloc or function_.func_attr.has_rt_hal' "$PASS"
require 'function_.func_attr.is_boot' "$PASS"
require 'callee allocation effect is unknown' "$PASS"
require 'analysis limit exceeded: call edges' "$PASS"
require 'case HirExprKind.MethodCall(receiver, _, args, resolution):' "$CALL_GRAPH"
require 'case HirExprKind.StaticCall(_, _, args, resolution):' "$CALL_GRAPH"
require 'resolution.get_symbol_id()' "$CALL_GRAPH"
require 'run_critical_alloc_closure_pass' "$DRIVER"
require 'failure or shutdown helper' "$SPEC"
require 'terminates once per node on cycles' "$SPEC"

echo "STATUS: PASS critical-alloc-closure-source-contract"
