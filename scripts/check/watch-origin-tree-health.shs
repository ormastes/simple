#!/bin/sh
# watch-origin-tree-health.shs — standalone WATCHDOG (not a pre-push guard).
#
# Detects a wiped or structurally-corrupt origin/main and makes it LOUD, on a
# timer, independent of any push happening. Motivation: this repo suffered
# FOUR whole-tree wipes (2026-08-01 x2, 2313821fd77, and 6f86ff32a7d which cut
# origin/main from 113,030 files to 3 under a "docs(todo)" title on
# 2026-08-11). Every one was found by luck, minutes-to-hours later, by
# whoever happened to look. The existing pre-push guards
# (check-tree-size-push.shs and siblings) are ADVISORY for the plumbing
# `git push <sha>:refs/heads/main` landing pattern this repo mandates — a
# plumbing push never fires a git pre-push hook, so a guard that only runs as
# a hook never ran for any of the four incidents. This script does not fix
# that; it is an independent, pull-based safety net that does not depend on
# the pusher running anything at all.
#
# THIS IS NOT AN EIGHTH PRE-PUSH GUARD. It never runs on push, never blocks a
# push, and never mutates refs. It is a periodic FETCH + READ-ONLY INSPECTION
# of whatever is at origin/main right now (or an explicit --rev), so
# detection does not depend on the pusher's local guards having run, and does
# not depend on anyone remembering to look.
#
# SOURCE OF TRUTH FOR THRESHOLDS: scripts/check/check-tree-size-push.shs
# (CFG_ABS_MIN / CFG_ABS_MAX / CFG_SRC_MIN / CFG_SRC_MAX, and the
# src/runtime >= 150 canary in its CFG_PATHS). This file mirrors those
# constants rather than sourcing the other script, because the other script
# is a `set -e` push-time gate with its own selftest/trap/argv handling not
# meant to be imported; --check-thresholds-agree (also run inside --selftest)
# greps the sibling file's literal values and fails loudly the moment the two
# drift apart, which is the failure mode a silent duplicate risks.
#
# USAGE:
#   sh scripts/check/watch-origin-tree-health.shs --once [--rev <sha-or-ref>]
#   sh scripts/check/watch-origin-tree-health.shs --watch [interval_seconds]
#   sh scripts/check/watch-origin-tree-health.shs --selftest
#
# VERDICT (last line of stdout on every exit path):
#   PASS  — "PASS — <n> invariant(s) checked, origin/main healthy (<files> files)"   exit 0
#   FAIL  — "FAIL — ..."                                                             exit 1
#   ERROR — "ERROR — nothing was checked"                                            exit 2
#
# STATE FILE (--watch only): $STATE_FILE (default
# build/watch-origin-tree-health.state) holds the last verdict word so repeat
# alerts are suppressed and only STATE CHANGES are reported loudly; the log
# file it writes to ($LOG_FILE, default build/watch-origin-tree-health.log)
# is truncated to the last $LOG_MAX_LINES (default 5000) lines each cycle so
# it cannot grow unbounded.
set -u

SELF=watch-origin-tree-health
REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd) || REPO_ROOT=.

GREP=grep
[ -x /usr/bin/grep ] && GREP=/usr/bin/grep

SIBLING="$REPO_ROOT/scripts/check/check-tree-size-push.shs"

# --- mirrored thresholds — see header comment; kept honest by
#     check_thresholds_agree() below, run at the top of --selftest. --------
CFG_ABS_MIN=90000
CFG_ABS_MAX=150000
CFG_SRC_MIN=13
CFG_SRC_MAX=25
CFG_RUNTIME_MIN=150

STATE_FILE=${STATE_FILE:-"$REPO_ROOT/build/watch-origin-tree-health.state"}
LOG_FILE=${LOG_FILE:-"$REPO_ROOT/build/watch-origin-tree-health.log"}
LOG_MAX_LINES=${LOG_MAX_LINES:-5000}
LAST_GOOD_FILE=${LAST_GOOD_FILE:-"$REPO_ROOT/build/watch-origin-tree-health.last_good"}

TMPROOT=""
cleanup() { [ -n "$TMPROOT" ] && rm -rf "$TMPROOT"; }
trap cleanup EXIT INT TERM

die_error() {
    echo "$SELF: ERROR — $*" >&2
    echo "$SELF: ERROR — nothing was checked"
    exit 2
}

# ---------------------------------------------------------------------------
# check_thresholds_agree — greps the sibling guard's literal CFG_* values and
# fails loudly if they no longer match what we mirror above.
# ---------------------------------------------------------------------------
check_thresholds_agree() {
    [ -f "$SIBLING" ] || { echo "$SELF: WARN — sibling guard $SIBLING not found, cannot cross-check thresholds" >&2; return 0; }
    ct_ok=1
    for ct_pair in "CFG_ABS_MIN=$CFG_ABS_MIN" "CFG_ABS_MAX=$CFG_ABS_MAX" \
                   "CFG_SRC_MIN=$CFG_SRC_MIN" "CFG_SRC_MAX=$CFG_SRC_MAX"; do
        ct_name=${ct_pair%%=*}
        if ! "$GREP" -q "^${ct_name}=${ct_pair#*=}" "$SIBLING"; then
            echo "$SELF: THRESHOLD DRIFT: $ct_pair does not match $SIBLING" >&2
            ct_ok=0
        fi
    done
    if ! "$GREP" -q "src/runtime:${CFG_RUNTIME_MIN}" "$SIBLING"; then
        echo "$SELF: THRESHOLD DRIFT: src/runtime canary $CFG_RUNTIME_MIN does not match $SIBLING CFG_PATHS" >&2
        ct_ok=0
    fi
    [ "$ct_ok" -eq 1 ]
}

# ---------------------------------------------------------------------------
# inspect_tip <repo> <rev> — sets TIP_SHA, TIP_FILES, TIP_SRCN, TIP_DUPS.
# Returns 0 on success, 1 if git failed (never a clean result).
# ---------------------------------------------------------------------------
inspect_tip() {
    it_repo=$1
    it_rev=$2
    TIP_SHA=$(git -C "$it_repo" rev-parse "$it_rev" 2>"$TMPROOT/rp.err")
    it_st=$?
    if [ "$it_st" -ne 0 ] || [ -z "$TIP_SHA" ]; then
        cat "$TMPROOT/rp.err" >&2 2>/dev/null
        return 1
    fi

    git -C "$it_repo" ls-tree -r --name-only "$TIP_SHA" >"$TMPROOT/ls.out" 2>"$TMPROOT/ls.err"
    it_st=$?
    if [ "$it_st" -ne 0 ]; then
        cat "$TMPROOT/ls.err" >&2 2>/dev/null
        return 1
    fi
    TIP_FILES=$(wc -l <"$TMPROOT/ls.out" | tr -d ' ')

    git -C "$it_repo" ls-tree -r -t --name-only "$TIP_SHA" >"$TMPROOT/lst.out" 2>/dev/null || return 1
    sort "$TMPROOT/lst.out" >"$TMPROOT/sorted.out" || return 1
    uniq -d "$TMPROOT/sorted.out" >"$TMPROOT/dup.out" || return 1
    TIP_DUPS=$(wc -l <"$TMPROOT/dup.out" | tr -d ' ')
    TIP_DUPLIST=$(head -n 5 "$TMPROOT/dup.out")

    git -C "$it_repo" ls-tree --name-only "$TIP_SHA" -- src >"$TMPROOT/se.out" 2>/dev/null || return 1
    if [ ! -s "$TMPROOT/se.out" ]; then
        TIP_SRCN=-1
    else
        git -C "$it_repo" ls-tree --name-only "$TIP_SHA:src" >"$TMPROOT/se.out" 2>/dev/null || return 1
        TIP_SRCN=$(wc -l <"$TMPROOT/se.out" | tr -d ' ')
    fi

    git -C "$it_repo" ls-tree -r --name-only "$TIP_SHA" -- src/runtime >"$TMPROOT/rt.out" 2>/dev/null || return 1
    TIP_RUNTIME=$(wc -l <"$TMPROOT/rt.out" | tr -d ' ')
    return 0
}

# ---------------------------------------------------------------------------
# evaluate_tip <repo> <rev> — prints reasons on stderr, returns 0/1/2 like the
# sibling guard's evaluate_commit. Sets EV_N (invariants checked).
# ---------------------------------------------------------------------------
evaluate_tip() {
    inspect_tip "$1" "$2" || return 2
    ev_bad=0
    EV_N=4

    if [ "$TIP_FILES" -lt "$CFG_ABS_MIN" ] || [ "$TIP_FILES" -gt "$CFG_ABS_MAX" ]; then
        echo "  - TREE SIZE OUT OF BAND: $TIP_FILES file(s); expected ${CFG_ABS_MIN}..${CFG_ABS_MAX}" >&2
        ev_bad=1
    fi
    if [ "$TIP_DUPS" -ne 0 ]; then
        echo "  - DUPLICATE TREE ENTRIES: $TIP_DUPS duplicated path(s)" >&2
        ev_bad=1
    fi
    if [ "$TIP_SRCN" -lt 0 ]; then
        echo "  - src/ IS ABSENT from the tree entirely" >&2
        ev_bad=1
    elif [ "$TIP_SRCN" -lt "$CFG_SRC_MIN" ] || [ "$TIP_SRCN" -gt "$CFG_SRC_MAX" ]; then
        echo "  - src/ ENTRY COUNT OUT OF BAND: $TIP_SRCN entries, band is ${CFG_SRC_MIN}..${CFG_SRC_MAX}" >&2
        ev_bad=1
    fi
    if [ "$TIP_RUNTIME" -lt "$CFG_RUNTIME_MIN" ]; then
        echo "  - LOAD-BEARING CANARY EMPTY/SHORT: src/runtime has $TIP_RUNTIME file(s), needs >= $CFG_RUNTIME_MIN" >&2
        ev_bad=1
    fi
    return "$ev_bad"
}

print_restore_recipe() {
    pr_repo=$1
    pr_bad_sha=$2
    pr_good_sha=$3
    cat >&2 <<EOF

  RESTORE RECIPE (review before running — this watchdog never auto-restores):
    BAD=$pr_bad_sha
    GOOD=$pr_good_sha
    PARENT=\$(git -C "$pr_repo" rev-parse "\$BAD^")   # verify this equals \$GOOD
    IDX=\$(mktemp)
    GIT_INDEX_FILE="\$IDX" git -C "$pr_repo" read-tree "\$GOOD"
    # re-apply any files \$BAD legitimately changed on top of \$GOOD here, e.g.:
    #   GIT_INDEX_FILE="\$IDX" git -C "$pr_repo" update-index --add <path>...
    TREE=\$(GIT_INDEX_FILE="\$IDX" git -C "$pr_repo" write-tree)
    FIX=\$(git -C "$pr_repo" commit-tree "\$TREE" -p "\$BAD" -m "fix: restore tree wiped by \$BAD")
    GIT_SSH_COMMAND="ssh -o BatchMode=yes -i ~/.ssh/id_ed25519_this_mac" \\
      git -C "$pr_repo" push git@github.com:ormastes/simple.git "\$FIX":refs/heads/main
EOF
}

# ===========================================================================
# --once / --watch driver
# ===========================================================================
run_once() {
    ro_repo=$1
    ro_rev=$2
    ro_fetch=$3   # 1 = fetch first, 0 = inspect ro_rev as-is (used for --rev on an explicit sha)

    if [ "$ro_fetch" -eq 1 ]; then
        git -C "$ro_repo" fetch --quiet origin main 2>"$TMPROOT/fetch.err"
        if [ $? -ne 0 ]; then
            echo "$SELF: fetch of origin main failed:" >&2
            cat "$TMPROOT/fetch.err" >&2 2>/dev/null
            echo "ERROR — nothing was checked"
            return 2
        fi
    fi

    # NOTE: must NOT be `x=$(evaluate_tip ...)` — command substitution runs in
    # a subshell, so TIP_SHA/TIP_FILES/etc set inside evaluate_tip would never
    # propagate back here. Redirect stderr to a file instead and run inline.
    evaluate_tip "$ro_repo" "$ro_rev" >/dev/null 2>"$TMPROOT/reasons.out"
    ro_rc=$?
    ro_reasons=$(cat "$TMPROOT/reasons.out")

    if [ "$ro_rc" -eq 2 ]; then
        echo "$SELF: could not inspect $ro_rev:" >&2
        printf '%s\n' "$ro_reasons" >&2
        echo "ERROR — nothing was checked"
        return 2
    fi

    if [ "$ro_rc" -eq 0 ]; then
        echo "PASS — $EV_N invariant(s) checked, origin/main healthy ($TIP_FILES files)"
        return 0
    fi

    echo "$SELF: origin/main tip $TIP_SHA FAILED health checks:" >&2
    printf '%s\n' "$ro_reasons" >&2
    if [ -f "$LAST_GOOD_FILE" ]; then
        ro_good=$(cat "$LAST_GOOD_FILE")
    else
        ro_good="<unknown — no prior PASS recorded by this watcher>"
    fi
    echo "" >&2
    echo "  ====================================================================" >&2
    echo "  == ORIGIN/MAIN TREE WIPE OR CORRUPTION DETECTED                    ==" >&2
    echo "  ====================================================================" >&2
    echo "  bad tip:        $TIP_SHA ($TIP_FILES files)" >&2
    echo "  last-known-good: $ro_good" >&2
    print_restore_recipe "$ro_repo" "$TIP_SHA" "$ro_good"
    echo "FAIL — $EV_N invariant(s) checked, tip $TIP_SHA ($TIP_FILES files)"
    return 1
}

do_watch() {
    dw_repo=$1
    dw_interval=$2
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null
    dw_prev=""
    [ -f "$STATE_FILE" ] && dw_prev=$(cat "$STATE_FILE")
    dw_stop=0
    trap 'dw_stop=1' INT TERM

    while [ "$dw_stop" -eq 0 ]; do
        dw_out=$(run_once "$dw_repo" origin/main 1 2>&1)
        dw_rc=$?
        dw_word=PASS
        [ "$dw_rc" -eq 1 ] && dw_word=FAIL
        [ "$dw_rc" -eq 2 ] && dw_word=ERROR

        {
            echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $dw_word"
            printf '%s\n' "$dw_out"
        } >>"$LOG_FILE"
        tail -n "$LOG_MAX_LINES" "$LOG_FILE" >"$LOG_FILE.trim" 2>/dev/null && mv "$LOG_FILE.trim" "$LOG_FILE"

        if [ "$dw_word" != "$dw_prev" ]; then
            echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] STATE CHANGE: $dw_prev -> $dw_word"
            printf '%s\n' "$dw_out"
        fi
        if [ "$dw_word" = PASS ]; then
            git -C "$dw_repo" rev-parse origin/main >"$LAST_GOOD_FILE" 2>/dev/null
        fi
        echo "$dw_word" >"$STATE_FILE"
        dw_prev=$dw_word

        [ "$dw_stop" -eq 1 ] && break
        dw_slept=0
        while [ "$dw_slept" -lt "$dw_interval" ] && [ "$dw_stop" -eq 0 ]; do
            sleep 1
            dw_slept=$(( dw_slept + 1 ))
        done
    done

    echo "$SELF: received stop signal, final verdict:"
    printf '%s\n' "$dw_out"
    [ "$dw_word" = PASS ] && exit 0
    [ "$dw_word" = FAIL ] && exit 1
    exit 2
}

# ===========================================================================
# SELFTEST — 4 fixtures, fatal.
# ===========================================================================
st_env() {
    env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_OBJECT_DIRECTORY \
        -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_COMMON_DIR \
        GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
        GIT_AUTHOR_NAME=selftest GIT_AUTHOR_EMAIL=selftest@local \
        GIT_COMMITTER_NAME=selftest GIT_COMMITTER_EMAIL=selftest@local \
        GIT_AUTHOR_DATE='@0 +0000' GIT_COMMITTER_DATE='@0 +0000' \
        ${ST_INDEX:+GIT_INDEX_FILE="$ST_INDEX"} git "$@"
}
st_git() { st_g_repo=$1; shift; st_env -C "$st_g_repo" "$@"; }

st_mktree() {
    # st_mktree <repo> <files-per-dir> <dir>... -> echoes commit sha
    # Batched via `update-index --index-info` (one process for all entries)
    # instead of one `update-index` call per file — the per-file form takes
    # minutes at fixture sizes needed to clear a 90,000-file absolute floor.
    st_repo=$1; st_n=$2; shift 2
    st_idx="$TMPROOT/st.index.$$"
    rm -f "$st_idx"
    st_blob=$(printf 'x\n' | st_git "$st_repo" hash-object -w --stdin) || return 1
    st_info="$TMPROOT/st.info.$$"
    : >"$st_info"
    for st_d in "$@"; do
        st_i=0
        while [ "$st_i" -lt "$st_n" ]; do
            printf '100644 %s\t%s/f%s.txt\n' "$st_blob" "$st_d" "$st_i" >>"$st_info"
            st_i=$(( st_i + 1 ))
        done
    done
    ST_INDEX="$st_idx" st_git "$st_repo" update-index --index-info <"$st_info" || return 1
    st_tree=$(ST_INDEX="$st_idx" st_git "$st_repo" write-tree) || return 1
    st_git "$st_repo" commit-tree "$st_tree" -m fixture </dev/null
}

selftest() {
    TMPROOT=$(mktemp -d) || die_error "mktemp failed"
    st_dir="$TMPROOT/repo"
    mkdir -p "$st_dir"
    st_git "$st_dir" init -q . || die_error "selftest: git init failed"

    st_fail=0

    # threshold-agreement check runs first, fatal on its own
    if ! check_thresholds_agree; then
        echo "$SELF: SELFTEST FAILED — mirrored thresholds drifted from $SIBLING" >&2
        st_fail=1
    fi

    # fixture 1: healthy — 100k files across src/runtime(200)+src/os(200)+src/lib(200)... and 15 src/ entries
    st_srcdirs="runtime os lib std app compiler i18n a b c d e f g"  # 15 entries
    # shellcheck disable=SC2086
    st_healthy=$(st_mktree "$st_dir" 6500 $(printf 'src/%s ' $st_srcdirs)) || { echo "fixture build failed" >&2; st_fail=1; }
    evaluate_tip "$st_dir" "$st_healthy" >/tmp/.wo_h_out 2>&1
    st_rc=$?
    echo "--- fixture: healthy-tip (expect PASS/rc0) ---"
    cat /tmp/.wo_h_out; echo "rc=$st_rc files=$TIP_FILES"
    [ "$st_rc" -eq 0 ] || { echo "FAIL: expected rc0" >&2; st_fail=1; }

    # fixture 2: wiped — 3 files (mirrors the real incident)
    st_wiped=$(st_mktree "$st_dir" 1 a b c) || { echo "fixture build failed" >&2; st_fail=1; }
    evaluate_tip "$st_dir" "$st_wiped" >/tmp/.wo_w_out 2>&1
    st_rc=$?
    echo "--- fixture: wiped-tip 3 files (expect FAIL naming file count, rc1) ---"
    cat /tmp/.wo_w_out; echo "rc=$st_rc files=$TIP_FILES"
    [ "$st_rc" -eq 1 ] && "$GREP" -q "$TIP_FILES file(s)" /tmp/.wo_w_out || { echo "FAIL: expected rc1 naming file count" >&2; st_fail=1; }

    # fixture 3: src/ missing entirely (no src/ at all) — large enough to clear
    # the absolute floor via non-src top-level dirs, so ONLY src/-absence fires
    st_srcless=$(st_mktree "$st_dir" 95000 topdirA) || { echo "fixture build failed" >&2; st_fail=1; }
    evaluate_tip "$st_dir" "$st_srcless" >/tmp/.wo_s_out 2>&1
    st_rc=$?
    echo "--- fixture: src-absent-tip (expect FAIL on src/ absence, rc1) ---"
    cat /tmp/.wo_s_out; echo "rc=$st_rc files=$TIP_FILES srcn=$TIP_SRCN"
    [ "$st_rc" -eq 1 ] && "$GREP" -q "src/ IS ABSENT" /tmp/.wo_s_out || { echo "FAIL: expected src/ absence" >&2; st_fail=1; }

    # fixture 4: unreachable/empty remote -> ERROR, never PASS
    st_bogus="$TMPROOT/does-not-exist"
    evaluate_tip "$st_bogus" "HEAD" >/tmp/.wo_e_out 2>&1
    st_rc=$?
    echo "--- fixture: unreachable-repo (expect rc2, ERROR) ---"
    cat /tmp/.wo_e_out; echo "rc=$st_rc"
    [ "$st_rc" -eq 2 ] || { echo "FAIL: expected rc2 (could-not-determine)" >&2; st_fail=1; }

    cleanup
    TMPROOT=""
    if [ "$st_fail" -ne 0 ]; then
        echo "$SELF: SELFTEST FAILED"
        echo "ERROR — nothing was checked"
        exit 2
    fi
    echo "$SELF: SELFTEST PASSED (4 fixtures + threshold-agreement)"
}

# ===========================================================================
# argv
# ===========================================================================
MODE=""
REV="origin/main"
INTERVAL=300
DO_FETCH=1
i_selftest_only=0

while [ $# -gt 0 ]; do
    case "$1" in
        --once) MODE=once ;;
        --watch) MODE=watch ;;
        --selftest) i_selftest_only=1 ;;
        --rev) shift; REV=$1; DO_FETCH=0 ;;
        [0-9]*) INTERVAL=$1 ;;
        *) die_error "unknown argument: $1" ;;
    esac
    shift
done

selftest

if [ "$i_selftest_only" -eq 1 ]; then
    exit 0
fi

case "$MODE" in
    once)
        TMPROOT=$(mktemp -d) || die_error "mktemp failed"
        run_once "$REPO_ROOT" "$REV" "$DO_FETCH"
        rc=$?
        exit "$rc"
        ;;
    watch)
        TMPROOT=$(mktemp -d) || die_error "mktemp failed"
        do_watch "$REPO_ROOT" "$INTERVAL"
        ;;
    *)
        die_error "usage: $SELF (--once [--rev <sha>] | --watch [interval_seconds] | --selftest)"
        ;;
esac
