#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
sync_lib="$root/src/lib/nogc_sync_mut/config_parser.spl"
async_lib="$root/src/lib/nogc_async_mut/config_parser.spl"
sync_std="$root/src/std/nogc_sync_mut/config_parser.spl"
async_std="$root/src/std/nogc_async_mut/config_parser.spl"

cmp -s "$sync_lib" "$async_lib" || {
    echo "FAIL: sync and async config parsers diverged" >&2
    exit 1
}
cmp -s "$sync_lib" "$sync_std" || {
    echo "FAIL: lib/std sync config parsers diverged" >&2
    exit 1
}
cmp -s "$async_lib" "$async_std" || {
    echo "FAIL: lib/std async config parsers diverged" >&2
    exit 1
}

count=$(grep -c 'str_val\.parse_f64()\.unwrap_or(default_val)' "$sync_lib")
test "$count" -eq 1 || {
    echo "FAIL: expected one Option-based config float parser" >&2
    exit 1
}
if grep -q 'float(str_val)' "$sync_lib"; then
    echo "FAIL: unsafe text-to-float cast remains" >&2
    exit 1
fi

echo "PASS: config float parser profiles and lib/std mirrors are identical"
