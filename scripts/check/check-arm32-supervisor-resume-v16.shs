#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
boot="$root/examples/09_embedded/simple_os/arch/arm32/boot/baremetal_stubs.c"
owner="$root/examples/09_embedded/simple_os/arch/arm32/boot/arm32_user_transition_v13.c"
assembly="$root/examples/09_embedded/simple_os/arch/arm32/boot/arm32_user_transition_v14.S"

for pair in \
    "$owner|return read_ttbr0();" \
    "$owner|arm32_user_frames_free_v15(asid)" \
    "$boot|arm32_fsexec_resume_prepare_v16(" \
    "$boot|arm32_scheduler_stdout_copy_v14(" \
    "$boot|arm32_kernel_guard_page_restore_v15(" \
    "$boot|arm32_scheduler_reap_v14(" \
    "$boot|FS_PROGRAM_END rc=37 reaped=true" \
    "$boot|arm32_fsexec_supervisor_resume_pc_v16(" \
    "$assembly|ldr r3,[r0,#36]" \
    "$assembly|bx r3"; do
    file=${pair%%|*}; literal=${pair#*|}
    rg -F "$literal" "$file" >/dev/null || { echo "missing ARM32 resume rule: $literal" >&2; exit 1; }
done

if rg -n 'arm32_(fsexec_supervisor_resume|kernel_ttbr0_root)_v16.*weak|return[[:space:]]+1;[[:space:]]*/\*[[:space:]]*fake' "$boot" "$owner" >/dev/null; then
    echo "weak or fabricated ARM32 resume owner detected" >&2
    exit 1
fi

echo "arm32 supervisor resume v16: PASS"
