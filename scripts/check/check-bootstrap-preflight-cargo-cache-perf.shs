#!/bin/sh
# Linux-only real-Cargo cache-routing fixture. No compiler admission or Phase 2/3 speed claim.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
cargo_bin=${CARGO_BIN:-$(command -v cargo)}
rustc_bin=${RUSTC_BIN:-$(dirname -- "$cargo_bin")/rustc}
[ -x "$rustc_bin" ] || rustc_bin=$(command -v rustc)
[ -x /usr/bin/time ] || { echo 'ERROR: GNU time required' >&2; exit 2; }
output=${1:-$repo/build/native_probe/preflight-cargo-cache-$(date +%Y%m%dT%H%M%S)-$$}
[ ! -e "$output" ] || { echo 'ERROR: use a fresh fixture output directory' >&2; exit 2; }
mkdir -p "$output/src"
cat >"$output/Cargo.toml" <<'FIXTURE'
[package]
name = "preflight-cache-probe"
version = "0.1.0"
edition = "2021"
build = "build.rs"
[profile.bootstrap]
inherits = "release"
[workspace]
FIXTURE
cat >"$output/build.rs" <<'FIXTURE'
use std::{env, fs, path::PathBuf};
fn main() {
    println!("cargo:rerun-if-changed=build.rs");
    let output = PathBuf::from(env::var_os("OUT_DIR").unwrap());
    fs::write(output.join("value.rs"), "42").unwrap();
    if let Some(path) = env::var_os("PROBE_INVOCATIONS") {
        use std::io::Write;
        writeln!(fs::OpenOptions::new().create(true).append(true).open(path).unwrap(), "generated").unwrap();
    }
}
FIXTURE
cat >"$output/src/main.rs" <<'FIXTURE'
fn main() { println!("{}", include!(concat!(env!("OUT_DIR"), "/value.rs"))); }
FIXTURE
python3 - "$output" "$cargo_bin" "$rustc_bin" <<'MEASURE'
from pathlib import Path
import subprocess, os, json, statistics, hashlib
import sys
root=Path(sys.argv[1]).resolve()
cargo=Path(sys.argv[2]).resolve()
base=os.environ.copy();base['RUSTC']=sys.argv[3];base['CARGO_HOME']=str(root/'cargo-home')
rows=[]
for trial in range(5):
    authority=root/f'trial-{trial}'/'authority';legacy=root/f'trial-{trial}'/'legacy';invocations=root/f'trial-{trial}'/'generated.log'
    authority.mkdir(parents=True);env=base.copy();env['CARGO_TARGET_DIR']=str(authority);env['PROBE_INVOCATIONS']=str(invocations)
    subprocess.run([str(cargo),'build','--offline','--profile','bootstrap'],cwd=root,env=env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=True)
    assert len(invocations.read_text().splitlines())==1
    for label,profile,target in [('baseline','release',legacy),('candidate','bootstrap',authority)]:
        env['CARGO_TARGET_DIR']=str(target);before=len(invocations.read_text().splitlines());prefix=root/f'trial-{trial}'/label
        with prefix.with_suffix('.jsonl').open('w') as log, prefix.with_suffix('.stderr').open('w') as err:
            subprocess.run(['/usr/bin/time','-f','%e %M','-o',str(prefix.with_suffix('.time')),str(cargo),'check','--offline','--profile',profile,'--message-format=json'],cwd=root,env=env,stdout=log,stderr=err,check=True)
        elapsed,rss=prefix.with_suffix('.time').read_text().split();new=len(invocations.read_text().splitlines())-before
        assert new == (1 if label=='baseline' else 0),(label,new)
        rows.append({'trial':trial,'label':label,'seconds':float(elapsed),'rss_kib':int(rss),'build_script_runs':new})
summary={}
for label in ['baseline','candidate']:
    samples=[r for r in rows if r['label']==label]; times=sorted(r['seconds'] for r in samples)
    summary[label]={'p50_s':statistics.median(times),'p95_s':times[-1],'peak_rss_kib':max(r['rss_kib'] for r in samples),'build_script_runs':sum(r['build_script_runs'] for r in samples)}
report={'scope':'Cargo preflight cache-routing fixture only; not Phase 2/3 compiler throughput','cargo_sha256':hashlib.sha256(cargo.read_bytes()).hexdigest(),'source_sha256':{p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in [root/'Cargo.toml',root/'build.rs',root/'src/main.rs']},'samples':rows,'summary':summary}
(root/'results.json').write_text(json.dumps(report,indent=2)+'\n');print(json.dumps(summary))
MEASURE
