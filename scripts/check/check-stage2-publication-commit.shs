#!/bin/sh
# Admission guard only; a successful result does not replace full provenance replay.
set -eu
[ "$#" = 1 ] || exit 64
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
BOOTSTRAP_STAGE3_FACADE_PATH=$root/scripts/check/lib/bootstrap-stage3-provenance.shs
export BOOTSTRAP_STAGE3_FACADE_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
bootstrap_stage3_verify_requalification_commit "$1" || {
    echo 'stage2-publication-commit: refused uncommitted or invalid admission' >&2
    exit 1
}
