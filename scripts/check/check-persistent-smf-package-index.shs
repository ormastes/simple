#!/bin/sh
set -eu
ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
HARNESS=${SIMPLE_PACKAGE_INDEX_ACCEPTANCE_BINARY:-$ROOT_DIR/build/test-tools/package_index_acceptance}
if [ ! -x "$HARNESS" ]; then
    echo "BLOCKED: compiled package-index acceptance owner unavailable: $HARNESS" >&2
    exit 2
fi
cd "$ROOT_DIR"
exec "$HARNESS" "$@"
