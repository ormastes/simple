#!/bin/sh
# The bootstrap's native-build worker count must respect available memory.
#
# Why this exists: the worker count was derived from CPU count alone, and each
# native-build worker is a whole interpreted compiler graph plateauing around
# 3.2 GiB. On 2026-09-06 that authorized ~32 GB on a 20-CPU host (sampled
# 31.6 GB across 153 processes) and ~65 GB under clean-release; with sibling
# lanes on the same box it produced a global OOM that killed the user systemd
# manager and every session with it.
#
# It also pins the WIRING. scripts/bootstrap/bootstrap-build-jobs-policy.shs
# calls itself "the canonical policy" and had ZERO callers anywhere in the
# tree -- a policy nothing consults is not a policy. Case 7 fails if the
# bootstrap stops calling it.
#
# Verdict is the last line of stdout:
#   PASS — <n> case(s) checked, 0 failed     exit 0
#   FAIL — <n> case(s) checked, <k> failed   exit 1
#   ERROR — nothing was checked (<reason>)   exit 2
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
policy="$root/scripts/bootstrap/bootstrap-build-jobs-policy.shs"
wrapper="$root/scripts/bootstrap/bootstrap-from-scratch.sh"
[ -r "$policy" ] || { echo "ERROR — nothing was checked (missing $policy)"; exit 2; }
[ -r "$wrapper" ] || { echo "ERROR — nothing was checked (missing $wrapper)"; exit 2; }

# shellcheck source=/dev/null
. "$policy"
command -v bootstrap_build_jobs_memory_clamp >/dev/null 2>&1 || {
    echo "ERROR — nothing was checked (policy defines no bootstrap_build_jobs_memory_clamp)"
    exit 2
}

work=$(mktemp -d "${TMPDIR:-/tmp}/jobs-mem-clamp.XXXXXX") || {
    echo "ERROR — nothing was checked (cannot create work dir)"; exit 2
}
trap 'rm -rf "$work"' EXIT INT TERM

meminfo() {
    printf 'MemTotal:       126000000 kB\nMemAvailable:    %s kB\n' "$1" >"$work/meminfo"
    printf '%s\n' "$work/meminfo"
}

CHECKED=0
FAILED=0
expect() {
    ex_label=$1 ex_want=$2 ex_got=$3
    CHECKED=$((CHECKED + 1))
    [ "$ex_got" = "$ex_want" ] || {
        echo "  case '$ex_label': want $ex_want, got $ex_got" >&2
        FAILED=$((FAILED + 1))
    }
}

# 1. Tight memory clamps a CPU-derived count down. 10 GiB / 3300 MiB = 3.
expect 'clamps under memory pressure' 3 \
    "$(BOOTSTRAP_MEMINFO_PATH=$(meminfo 10485760) bootstrap_build_jobs_memory_clamp 20)"

# 2. Ample memory leaves the CPU-derived count untouched -- the clamp bounds an
#    overshoot, it never inflates and never becomes the binding constraint on a
#    big host.
expect 'ample memory does not clamp' 20 \
    "$(BOOTSTRAP_MEMINFO_PATH=$(meminfo 419430400) bootstrap_build_jobs_memory_clamp 20)"

# 3. A count already below what fits is returned unchanged.
expect 'already-small count unchanged' 2 \
    "$(BOOTSTRAP_MEMINFO_PATH=$(meminfo 10485760) bootstrap_build_jobs_memory_clamp 2)"

# 4. Less memory than one worker needs still yields 1: a bootstrap that cannot
#    start is worse than one that thrashes, and the caller has no fallback.
expect 'floors at one worker' 1 \
    "$(BOOTSTRAP_MEMINFO_PATH=$(meminfo 524288) bootstrap_build_jobs_memory_clamp 8)"

# 5/6. Unreadable or unparsable meminfo, AND no OS-specific fallback probe
#      recognises the host (BOOTSTRAP_BUILD_JOBS_OS_OVERRIDE forces the
#      "none of the above" case branch), leaves the count untouched.
#      Deliberately fail-open in that case: this bounds a known overshoot,
#      it is not an admission gate, and it must never make a bootstrap
#      unrunnable on a host neither /proc/meminfo nor a fallback covers.
expect 'missing meminfo, no fallback, does not clamp' 20 \
    "$(BOOTSTRAP_MEMINFO_PATH=$work/absent BOOTSTRAP_BUILD_JOBS_OS_OVERRIDE=UnknownOS \
       bootstrap_build_jobs_memory_clamp 20)"
printf 'MemTotal: 126000000 kB\nMemAvailable: not-a-number\n' >"$work/bad"
expect 'unparsable meminfo, no fallback, does not clamp' 20 \
    "$(BOOTSTRAP_MEMINFO_PATH=$work/bad BOOTSTRAP_BUILD_JOBS_OS_OVERRIDE=UnknownOS \
       bootstrap_build_jobs_memory_clamp 20)"

# 5a/5b/5c. PKG-G: missing/unreadable meminfo (macOS and FreeBSD have none,
# and a non-MSYS Windows POSIX layer may lack it) now tries an OS-specific
# available-memory probe before giving up -- stubbed here via a throwaway
# PATH dir so no real sysctl/vm_stat/powershell.exe is required.
fixbin=$work/fixbin
mkdir -p "$fixbin"
fake() {
    fk_name=$1; fk_body=$2
    printf '#!/bin/sh\n%s\n' "$fk_body" >"$fixbin/$fk_name"
    chmod +x "$fixbin/$fk_name"
}

# Darwin: hw.pagesize=4096, free+inactive+purgeable+speculative pages sum to
# 2,621,440 -> 10 GiB available -> 10485760 KiB / 3300 MiB = 3 workers.
fake sysctl 'case "$2" in hw.pagesize) echo 4096 ;; esac'
fake vm_stat 'printf "Pages free: 1000000.\nPages inactive: 1000000.\nPages purgeable: 500000.\nPages speculative: 121440.\n"'
expect 'macOS fallback (no meminfo) clamps' 3 \
    "$(PATH=$fixbin:$PATH BOOTSTRAP_MEMINFO_PATH=$work/absent \
       BOOTSTRAP_BUILD_JOBS_OS_OVERRIDE=Darwin bootstrap_build_jobs_memory_clamp 20)"
rm -f "$fixbin/sysctl" "$fixbin/vm_stat"

# FreeBSD: hw.pagesize=4096, v_free_count+v_inactive_count = 2,621,440 pages
# -> same 10 GiB -> 3 workers.
fake sysctl 'case "$2" in
  hw.pagesize) echo 4096 ;;
  vm.stats.vm.v_free_count) echo 2000000 ;;
  vm.stats.vm.v_inactive_count) echo 621440 ;;
esac'
expect 'FreeBSD fallback (no meminfo) clamps' 3 \
    "$(PATH=$fixbin:$PATH BOOTSTRAP_MEMINFO_PATH=$work/absent \
       BOOTSTRAP_BUILD_JOBS_OS_OVERRIDE=FreeBSD bootstrap_build_jobs_memory_clamp 20)"
rm -f "$fixbin/sysctl"

# Windows (non-MSYS POSIX layer, no /proc/meminfo): PowerShell
# FreePhysicalMemory reports 10485760 KiB -> 3 workers.
fake powershell.exe 'echo 10485760'
expect 'Windows PowerShell fallback (no meminfo) clamps' 3 \
    "$(PATH=$fixbin:$PATH BOOTSTRAP_MEMINFO_PATH=$work/absent \
       BOOTSTRAP_BUILD_JOBS_OS_OVERRIDE=MINGW64_NT bootstrap_build_jobs_memory_clamp 20)"
rm -f "$fixbin/powershell.exe"

# 7. A per-worker budget override is honoured: 10 GiB / 1024 MiB = 10.
expect 'per-worker budget override honoured' 10 \
    "$(SIMPLE_BOOTSTRAP_WORKER_MEM_MIB=1024 BOOTSTRAP_MEMINFO_PATH=$(meminfo 10485760) \
       bootstrap_build_jobs_memory_clamp 20)"

# 8. Wiring: the bootstrap must actually call the clamp. Without this the fix
#    silently reverts to CPU-only the next time someone edits the wrapper.
CHECKED=$((CHECKED + 1))
if ! grep -Fq 'bootstrap_build_jobs_memory_clamp' "$wrapper"; then
    echo "  case 'wrapper calls the clamp': bootstrap-from-scratch.sh never calls it" >&2
    FAILED=$((FAILED + 1))
fi

[ "$CHECKED" -gt 0 ] || { echo "ERROR — nothing was checked (no cases ran)"; exit 2; }
if [ "$FAILED" -gt 0 ]; then
    echo "FAIL — $CHECKED case(s) checked, $FAILED failed"
    exit 1
fi
echo "PASS — $CHECKED case(s) checked, 0 failed"
