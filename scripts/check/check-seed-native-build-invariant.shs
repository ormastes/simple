#!/bin/sh
# !!! DO NOT WIRE — VALIDATED BROKEN 2026-07-25, re-validated 2026-07-26 !!!
# This gate FAILS against a known-good seed. It is always-red, which is worse
# than always-green: wiring it would block every commit while proving nothing.
# The harness (timeouts, cd-to-repo-root, fail-closed seed check) is sound.
# TWO INDEPENDENT FIXTURE-SHAPE BLOCKERS, both confirmed by A/B experiment:
#
#   1. Module-level `val` in owner.spl (hit first). Exact failure is
#      seed-dependent, same root bug either way:
#        seed target/debug/simple     -> rc=1 "AOT compile error in
#          <...>.seed_cross_module.owner: MIR module has no functions"
#        seed target/bootstrap/simple -> rc=1 "MIR lowering error: undefined variable: ITEMS"
#        control: val BASE: i64 = 5   -> rc=0 runs, prints 5
#      Owned by doc/08_tracking/bug/native_build_mir_module_has_no_functions_2026-07-25.md
#      (a module-level item alone is enough to empty a module's MIR).
#
#   2. The two-module `use` shape itself, INDEPENDENT of blocker 1. A fixture
#      with NO module-level globals at all (owner.spl = `fn owner_value() -> i64: 5`,
#      main.spl = `use owner.{owner_value}` + `print(owner_value())`) still fails:
#        --source <dir> --entry <dir>/main.spl -> ld.lld: undefined symbol: __simple_main
#        positional <dir>/main.spl             -> "native-build produced no code-bearing MIR modules"
#      i.e. the entry module lowers to nothing. Fixing blocker 1 alone will NOT
#      make this gate pass.
#
# NOT A DEFECT — fixture LOCATION under scripts/ is fine. It was proposed that
# _skip_dirs (src/compiler/80.driver/driver_source_loading.spl:24, which lists
# "scripts") prevents anything under scripts/ from being compiled. That is FALSE
# on two counts, verified 2026-07-26:
#   (a) STATIC: `_skip_dirs` there feeds only `_driver_should_skip_dir`, which has
#       ZERO call sites — driver.spl imports it (line 71) but never calls it, and
#       the live collector `_driver_collect_sources` uses `find` + substring tests
#       for /test/ /tests/ /testdata/ /doc/ /verification/ ONLY. "scripts" is not
#       among them. (A second live copy in driver_helpers.spl is in an orphan file
#       that nothing imports, and in any case only name-checks CHILD dirs during
#       descent, never the --source root itself.)
#   (b) EMPIRICAL: a single-file fixture under this very directory
#       (fixtures/locprobe_single/main.spl, --source that dir) native-builds
#       rc=0 and prints 5. And the identical two-module fixture placed under
#       probes/ (a known-good tree) fails IDENTICALLY to the one under scripts/.
#       Location is not the variable.
#   (c) The failing diagnostic itself names the module it compiled from here:
#       "AOT compile error in .home.ormastes.…scripts.check.cert.redeploy_gate
#        .fixtures.seed_cross_module.owner" — owner.spl under scripts/ was read,
#       parsed and reached AOT. A skipped file cannot produce that message.
# Do NOT relocate the fixture; it would change nothing.
#
# Before wiring: fix blockers 1 AND 2 (or redesign the fixture to a shape that
# still exercises cross-module module-global aliasing), then prove BOTH
# (a) it passes on a good seed and (b) it FAILS on a seed carrying the bug.
# (b) has never been demonstrated. See doc/09_report/seed_gate_validation_2026-07-25.md
set -u

# check-seed-native-build-invariant.shs — routine gate for the invariant that
# regressed silently in d312b8e4253: "a Rust seed built from the current tree
# must be able to native-build a trivial .spl program." See
# doc/08_tracking/bug/seed_interp_defer_lazy_imports_module_globals_2026-07-24.md
#
# Why a NEW gate instead of reusing what exists:
#   - candidate_frontend_smoke() in
#     scripts/check/cert/redeploy_gate/candidate_frontend_admission.shs already
#     native-builds a fixture with a *candidate* binary, but (a) it only runs
#     on stage2/stage3 candidates deep inside the expensive full bootstrap
#     (bootstrap-from-scratch.sh bootstrap_stage_sanity, T3 tier) — never on
#     the raw seed before its first real use — and (b) its fixture (p2_add.spl)
#     is a single file with NO imports, so it cannot exercise cross-module
#     module-global aliasing, which is exactly the mechanism d312b8e4253 broke
#     ("deferred lazy imports leave the importing module with a fresh/empty
#     instance of the owner module's globals instead of the shared one").
#   - scripts/check/check-nvme-rv32-minimal-live.shs *does* native-build a
#     real multi-module project with the seed (that's how this regression was
#     eventually found), but it is a full firmware build + QEMU boot — far too
#     expensive to run routinely, and scoped to the NVMe/rv32 feature, not a
#     general seed-health invariant.
# This gate fills the gap: cheap, general, targets the raw seed directly, and
# its fixture spans two modules with a `use` import reading a module-level
# global — small enough to run on every push that touches src/compiler_rust.
#
# Usage:
#   sh check-seed-native-build-invariant.shs [SEED_BIN]
#   sh check-seed-native-build-invariant.shs --help
#
# SEED_BIN defaults to src/compiler_rust/target/bootstrap/simple(.exe),
# resolved relative to the repo root when not absolute. This script does NOT
# build the seed itself — wire a seed build (e.g. `cargo build --manifest-path
# src/compiler_rust/Cargo.toml --profile bootstrap -p simple-driver --features
# llvm`) immediately before invoking it. See "Where to wire this in" in
# doc/09_report (or the accompanying phase3_gate_design.md) for the intended
# call sites.
#
# Output: one PASS/FAIL line. Exit 0 on PASS, non-zero on FAIL/FATAL.
# Fails CLOSED: a missing/non-executable seed binary is a FAIL, not a skip —
# an unrunnable gate must never look like a passing one.

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
FIX="$SCRIPT_DIR/cert/redeploy_gate/fixtures/seed_cross_module"
ADMISSION_HELPERS="$SCRIPT_DIR/cert/redeploy_gate/candidate_frontend_admission.shs"

CHECK_NAME="seed-native-build-invariant"
# 300, not 60: every run mktemps a fresh --cache-dir, so every build is cold. A
# measured PASSING fixture took 74s, i.e. the old default timed out on success.
BUILD_TIMEOUT_SECS="${SEED_GATE_BUILD_TIMEOUT_SECS:-300}"
EXEC_TIMEOUT_SECS="${SEED_GATE_EXEC_TIMEOUT_SECS:-5}"
KILL_GRACE_SECS="${SEED_GATE_KILL_GRACE_SECS:-1}"
BACKEND="${SEED_GATE_BACKEND:-cranelift}"

case "${1:-}" in
    --help|-h)
        # Print the whole header (DO-NOT-WIRE banner + rationale + usage).
        # Line-range-free so header edits cannot silently truncate --help,
        # which is exactly what the old `sed -n '3,34p'` did.
        awk 'NR>1 && /^SCRIPT_DIR=/{exit} NR>1' "$0"
        exit 0
        ;;
esac

fail() {
    printf 'FAIL  %-28s %s\n' "$CHECK_NAME" "$1" >&2
    exit 1
}

# native-build emits hundreds of lines of lint/"common mistake" advice AFTER the
# real diagnostic, so a bare `tail -n 40` reliably shows only noise (that is why
# every previous investigation had to re-run the build by hand to see the actual
# error). Surface the error lines explicitly first, then the tail as context.
dump_build_log() {
    echo "-- build.log: error lines --" >&2
    grep -nE '^\[(ERROR|STDERR)\]|MIR lowering error|MIR module has no functions|no code-bearing MIR modules|undefined symbol|^error: ' "$1" >&2 \
        || echo "(no recognized error lines matched; see tail below)" >&2
    echo "-- build.log (tail) --" >&2
    tail -n 40 "$1" >&2
}

# Reuse the timeout-binary lookup from the existing admission helpers instead
# of re-inventing one; fall back to a local copy if that file is ever moved.
if [ -f "$ADMISSION_HELPERS" ]; then
    # shellcheck disable=SC1090
    . "$ADMISSION_HELPERS"
    TB=$(candidate_frontend_timeout_bin) || fail "no timeout/gtimeout binary on PATH — cannot bound seed execution"
else
    if command -v timeout >/dev/null 2>&1; then
        TB=$(command -v timeout)
    elif command -v gtimeout >/dev/null 2>&1; then
        TB=$(command -v gtimeout)
    else
        fail "no timeout/gtimeout binary on PATH — cannot bound seed execution"
    fi
fi

SEED_ARG="${1:-src/compiler_rust/target/bootstrap/simple}"
case "$SEED_ARG" in
    /*) SEED="$SEED_ARG" ;;
    *)  SEED="$REPO_ROOT/$SEED_ARG" ;;
esac

if [ ! -x "$SEED" ] && [ -x "${SEED}.exe" ]; then
    SEED="${SEED}.exe"
fi

if [ ! -x "$SEED" ]; then
    fail "seed binary not found/executable: $SEED -- build it first, e.g.: cargo build --manifest-path src/compiler_rust/Cargo.toml --profile bootstrap -p simple-driver --features llvm"
fi

if [ ! -f "$FIX/owner.spl" ] || [ ! -f "$FIX/main.spl" ]; then
    fail "fixture missing: $FIX/{owner.spl,main.spl}"
fi

probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/seed-native-build-invariant.XXXXXX") || fail "mktemp failed"
trap 'rm -rf "$probe_dir"' 0
trap 'exit 1' HUP INT TERM

probe_out="$probe_dir/probe_bin"
build_log="$probe_dir/build.log"

# native-build resolves the runtime sources relative to CWD, so it must run from
# the repo root; from anywhere else it dies with "Runtime source directory not
# found. Expected src/runtime/runtime.c" regardless of seed health.
cd "$REPO_ROOT" || fail "cannot cd to REPO_ROOT $REPO_ROOT"

SIMPLE_BINARY="$SEED" \
SIMPLE_BIN="$SEED" \
SIMPLE_NO_STUB_FALLBACK=1 \
SIMPLE_EXECUTION_MODE= \
    "$TB" -k "${KILL_GRACE_SECS}s" "${BUILD_TIMEOUT_SECS}s" \
    "$SEED" native-build \
    --backend "$BACKEND" \
    --runtime-bundle core-c-bootstrap \
    --source "$FIX" \
    --entry "$FIX/main.spl" \
    --cache-dir "$probe_dir/cache" \
    --mode one-binary --entry-closure \
    --output "$probe_out" >"$build_log" 2>&1
build_rc=$?

if [ "$build_rc" -eq 124 ]; then
    # A timeout is NOT evidence of a bad seed. Reported distinctly so it can
    # never be read as "the gate caught a regression".
    dump_build_log "$build_log"
    fail "seed native-build TIMED OUT after ${BUILD_TIMEOUT_SECS}s (rc=124) -- INCONCLUSIVE, not a detected regression; raise SEED_GATE_BUILD_TIMEOUT_SECS and re-run"
fi

if [ "$build_rc" -ne 0 ]; then
    dump_build_log "$build_log"
    fail "seed native-build FAILED (rc=$build_rc) on the cross-module fixture -- a seed built from this tree cannot native-build a .spl file; see build.log above"
fi

if [ ! -x "$probe_out" ]; then
    fail "seed native-build reported success but produced no executable at $probe_out"
fi

out=$("$TB" -k "${KILL_GRACE_SECS}s" "${EXEC_TIMEOUT_SECS}s" "$probe_out" 2>"$probe_dir/exec.log")
exec_rc=$?
if [ "$exec_rc" -ne 0 ]; then
    cat "$probe_dir/exec.log" >&2
    fail "probe binary exited rc=$exec_rc (expected a clean run printing 5)"
fi

if [ "$out" != "5" ]; then
    fail "probe binary printed [$out], expected [5] -- cross-module global read is wrong (not merely a build failure)"
fi

printf 'PASS  %-28s seed=%s native-built + ran the cross-module fixture, printed 5\n' "$CHECK_NAME" "$SEED"
exit 0
