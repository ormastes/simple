#!/bin/sh
# check-cache-formal-source-binding.shs — text-only binding between the cache
# formal model (src/verification/cache_protocol, F1/F2) and the Simple code that
# composes the LIVE cache key.
#
# Plan: doc/05_design/compiler/incremental_build/cache_invalidation_formal_verification_2026-10-24.md
# §4.3.2 / §4.4. Each line of the binding file pins sha256 of one top-level
# declaration (fn / struct / class / enum / val) of a Simple source file. When
# the code moves without the binding (i.e. the model review) being updated, this
# gate FAILs. It needs no Lean and no compiler: only git, awk and sha256sum.
#
# Binding file: src/verification/cache_protocol/source_bindings.txt
#   <sha256>  <path>#<symbol>  <model reference>
# A declaration body is its header line plus every following line up to (not
# including) the next line that starts in column 0 with a non-blank,
# non-comment character. Trailing blank lines are dropped.
#
# Usage:
#   sh scripts/check/check-cache-formal-source-binding.shs            # working tree
#   sh scripts/check/check-cache-formal-source-binding.shs --rev <sha> # committed content
#   sh scripts/check/check-cache-formal-source-binding.shs --update   # reviewed re-pin only
#   sh scripts/check/check-cache-formal-source-binding.shs --selftest
#
# Verdict is the LAST line of stdout:
#   PASS — <n> binding(s) checked ...       exit 0
#   FAIL — ...                              exit 1
#   ERROR — nothing was checked (<reason>)  exit 2
# --selftest runs before every scan and is fatal.

set -u

BINDINGS=src/verification/cache_protocol/source_bindings.txt

err() { echo "ERROR — nothing was checked ($1)"; exit 2; }

command -v sha256sum >/dev/null 2>&1 || err "sha256sum not found"

# extract_decl FILE SYMBOL -> declaration text on stdout; rc 1 when absent.
extract_decl() {
    awk -v sym="$2" '
        function is_top(l) { return l ~ /^[^ \t#\r]/ }
        !inb {
            l = $0; sub(/\r$/, "", l)
            if (l ~ /^(pub |export )?(fn|struct|class|enum|val|var) /) {
                h = l; sub(/^(pub |export )?(fn|struct|class|enum|val|var) /, "", h)
                n = h; sub(/[^A-Za-z0-9_].*$/, "", n)
                if (n == sym) { inb = 1; found = 1; buf = l; nb = 0; next }
            }
            next
        }
        inb {
            l = $0; sub(/\r$/, "", l)
            if (is_top(l)) { inb = 0; exit }
            if (l ~ /^[ \t]*$/) { nb++; next }
            while (nb > 0) { buf = buf "\n"; nb-- }
            buf = buf "\n" l
        }
        END { if (!found) exit 1; print buf }
    ' "$1"
}

# read_src PATH REV OUT -> materialise PATH (worktree or REV) into OUT.
read_src() {
    if [ -n "$2" ]; then
        git show "$2:$1" > "$3" 2>/dev/null
    else
        [ -f "$1" ] && cat "$1" > "$3"
    fi
}

# scan BINDINGS_FILE REV -> sets CHECKED / BAD / MISSING
scan() {
    CHECKED=0; BAD=""; MISSING=""
    _tmp=$(mktemp) || err "mktemp failed"
    while IFS= read -r _line || [ -n "$_line" ]; do
        case "$_line" in ''|'#'*) continue ;; esac
        _want=$(printf '%s\n' "$_line" | awk '{print $1}')
        _ref=$(printf '%s\n' "$_line" | awk '{print $2}')
        _path=${_ref%%#*}; _sym=${_ref#*#}
        CHECKED=$((CHECKED + 1))
        if ! read_src "$_path" "$2" "$_tmp"; then MISSING="$MISSING $_ref"; continue; fi
        _decl=$(extract_decl "$_tmp" "$_sym") || { MISSING="$MISSING $_ref"; continue; }
        _got=$(printf '%s\n' "$_decl" | sha256sum | awk '{print $1}')
        [ "$_got" = "$_want" ] || BAD="$BAD $_ref"
    done < "$1"
    rm -f "$_tmp"
}

selftest() {
    _d=$(mktemp -d) || err "mktemp failed"
    mkdir -p "$_d/src"
    printf 'fn keep() -> i64:\n    1\n\nfn bound(a: i64) -> i64:\n    # body\n    a + 1\n\nval OTHER = 2\n' > "$_d/src/a.spl"
    _h=$( (cd "$_d" && extract_decl src/a.spl bound) | sha256sum | awk '{print $1}')
    printf '%s  src/a.spl#bound  fixture\n' "$_h" > "$_d/b.txt"
    ( cd "$_d" && scan b.txt "" && [ "$CHECKED" = 1 ] && [ -z "$BAD$MISSING" ] ) \
        || { echo "FAIL — selftest: clean fixture did not pass"; exit 1; }
    # editing an UNBOUND declaration must not trip the binding
    sed 's/^    1$/    7/' "$_d/src/a.spl" > "$_d/x" && mv "$_d/x" "$_d/src/a.spl"
    ( cd "$_d" && scan b.txt "" && [ -z "$BAD$MISSING" ] ) \
        || { echo "FAIL — selftest: unbound edit tripped the binding"; exit 1; }
    # editing the BOUND body must FAIL
    sed 's/a + 1/a + 2/' "$_d/src/a.spl" > "$_d/x" && mv "$_d/x" "$_d/src/a.spl"
    ( cd "$_d" && scan b.txt "" && [ -n "$BAD" ] ) \
        || { echo "FAIL — selftest: bound body edit was not detected"; exit 1; }
    # removing the bound symbol must FAIL (missing), never pass
    printf 'fn keep() -> i64:\n    1\n' > "$_d/src/a.spl"
    ( cd "$_d" && scan b.txt "" && [ -n "$MISSING" ] ) \
        || { echo "FAIL — selftest: removed bound symbol was not detected"; exit 1; }
    rm -rf "$_d"
}

REV=""; MODE=check
case "${1:-}" in
    --selftest) selftest; echo "PASS — selftest: 4 fixture(s)"; exit 0 ;;
    --rev) [ -n "${2:-}" ] || err "--rev needs a revision"; REV=$2 ;;
    --update) MODE=update ;;
    '') ;;
    *) err "unknown argument $1" ;;
esac

selftest

if [ -n "$REV" ]; then
    git rev-parse --verify --quiet "$REV^{commit}" >/dev/null || err "unknown revision $REV"
    _bf=$(mktemp) || err "mktemp failed"
    git show "$REV:$BINDINGS" > "$_bf" 2>/dev/null || { rm -f "$_bf"; err "no $BINDINGS at $REV"; }
else
    [ -f "$BINDINGS" ] || err "no $BINDINGS under cwd $(pwd)"
    _bf=$BINDINGS
fi

if [ "$MODE" = update ]; then
    _out=$(mktemp) || err "mktemp failed"
    _n=0
    while IFS= read -r _line || [ -n "$_line" ]; do
        case "$_line" in ''|'#'*) printf '%s\n' "$_line" >> "$_out"; continue ;; esac
        _ref=$(printf '%s\n' "$_line" | awk '{print $2}')
        _rest=$(printf '%s\n' "$_line" | awk '{$1="";$2="";sub(/^  */,"");print}')
        _decl=$(extract_decl "${_ref%%#*}" "${_ref#*#}") || { rm -f "$_out"; echo "FAIL — cannot re-pin missing $_ref"; exit 1; }
        _h=$(printf '%s\n' "$_decl" | sha256sum | awk '{print $1}')
        printf '%s  %s  %s\n' "$_h" "$_ref" "$_rest" >> "$_out"
        _n=$((_n + 1))
    done < "$BINDINGS"
    mv "$_out" "$BINDINGS"
    echo "PASS — $_n binding(s) re-pinned; review the model before committing"
    exit 0
fi

scan "$_bf" "$REV"
[ -n "$REV" ] && rm -f "$_bf"
[ "$CHECKED" -gt 0 ] || err "0 bindings in $BINDINGS"
if [ -n "$MISSING$BAD" ]; then
    echo "FAIL — $CHECKED binding(s) checked; bound cache-key code changed without a model review:${BAD:+ changed:$BAD}${MISSING:+ missing:$MISSING} (update src/verification/cache_protocol and re-pin with --update)"
    exit 1
fi
echo "PASS — $CHECKED binding(s) checked, cache-key source matches the reviewed formal model binding${REV:+ at $REV}"
exit 0
