#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
: "${SIMPLE_TCP_CHECK_OUT:?set an isolated fresh output directory}"
cc_bin=${CC:-clang}
mkdir "$SIMPLE_TCP_CHECK_OUT"
for variant in socket thread-fallback; do
    define=
    if [ "$variant" = thread-fallback ]; then define=-DSIMPLE_TCP_CHECK_THREAD_FALLBACK; fi
    "$cc_bin" -std=c11 -O1 -g -pthread -D_GNU_SOURCE $define \
        -ffunction-sections -fdata-sections -I"$repo_root/src/runtime" \
        "$repo_root/src/runtime/test/rt_tcp_write_nosigpipe_selfcheck.c" \
        -Wl,--gc-sections -ldl -lm -o "$SIMPLE_TCP_CHECK_OUT/$variant"
    "$SIMPLE_TCP_CHECK_OUT/$variant" >"$SIMPLE_TCP_CHECK_OUT/$variant.stdout" 2>"$SIMPLE_TCP_CHECK_OUT/$variant.stderr"
    cat "$SIMPLE_TCP_CHECK_OUT/$variant.stdout"
done
