#!/bin/sh
# Compile and run both TCP-write EPIPE/SIGPIPE variants of the runtime probe.
#
# Verdict convention (repo guard standard):
#   PASS — 2 tcp-write probe(s) checked ...      (exit 0)
#   FAIL — <what broke>                          (exit 1)
#   ERROR — nothing was checked (<reason>)       (exit 2)
set -u
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
[ -n "${SIMPLE_TCP_CHECK_OUT:-}" ] || { echo "ERROR — nothing was checked (set SIMPLE_TCP_CHECK_OUT to an isolated fresh output directory)"; exit 2; }
cc_bin=${CC:-clang}
probe_src="$repo_root/src/runtime/test/rt_tcp_write_nosigpipe_selfcheck.c"
runtime_src="$repo_root/src/runtime/runtime_native.c"
[ -f "$probe_src" ] || { echo "ERROR — nothing was checked (probe source $probe_src missing)"; exit 2; }
[ -f "$runtime_src" ] || { echo "ERROR — nothing was checked (runtime source $runtime_src missing)"; exit 2; }
command -v "$cc_bin" >/dev/null 2>&1 || { echo "ERROR — nothing was checked (C compiler '$cc_bin' not found)"; exit 2; }
mkdir "$SIMPLE_TCP_CHECK_OUT" || { echo "ERROR — nothing was checked ($SIMPLE_TCP_CHECK_OUT must be a fresh directory)"; exit 2; }

checked=0
for variant in socket thread-fallback; do
    define=
    if [ "$variant" = thread-fallback ]; then define=-DSIMPLE_TCP_CHECK_THREAD_FALLBACK; fi
    if ! "$cc_bin" -std=c11 -O1 -g -pthread -D_GNU_SOURCE $define \
        -ffunction-sections -fdata-sections -I"$repo_root/src/runtime" \
        "$probe_src" \
        -Wl,--gc-sections -ldl -lm -o "$SIMPLE_TCP_CHECK_OUT/$variant" \
        >"$SIMPLE_TCP_CHECK_OUT/$variant.compile.log" 2>&1; then
        echo "FAIL — tcp-write probe variant '$variant' did not compile (cc=$cc_bin; log $SIMPLE_TCP_CHECK_OUT/$variant.compile.log)" >&2
        exit 1
    fi
    if ! "$SIMPLE_TCP_CHECK_OUT/$variant" >"$SIMPLE_TCP_CHECK_OUT/$variant.stdout" 2>"$SIMPLE_TCP_CHECK_OUT/$variant.stderr"; then
        cat "$SIMPLE_TCP_CHECK_OUT/$variant.stdout" "$SIMPLE_TCP_CHECK_OUT/$variant.stderr" >&2
        echo "FAIL — tcp-write probe variant '$variant' failed (EPIPE/SIGPIPE contract broken; see probe output above)" >&2
        exit 1
    fi
    cat "$SIMPLE_TCP_CHECK_OUT/$variant.stdout"
    checked=$((checked + 1))
done
echo "PASS — $checked tcp-write probe(s) checked (socket + thread-fallback variants; EPIPE preserved without SIGPIPE death)"
exit 0
