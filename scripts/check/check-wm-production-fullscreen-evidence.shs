#!/bin/sh
set -eu

# Retained Web 2D WM perf receipt admission (opt-in; no synthetic live run).

# Validate one externally captured WM receipt's schema and artifact linkage.
# Schema admission is not a live performance verdict.
usage() {
    echo "usage: $0 --validate-retained-perf-receipt RECEIPT.env" >&2
    exit 2
}

fail() {
    echo "wm_retained_web2d_perf_schema_status=fail reason=$1"
    exit 1
}

field() {
    sed -n "s/^$1=//p" "$receipt" | tail -n 1
}

positive() {
    case "$1" in ''|*[!0-9]*|0*) return 1 ;; esac
    [ "${#1}" -le 12 ]
}

receipt_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        fail sha256-tool-unavailable
    fi
}

linked_artifact() {
    path=$(field "$1")
    digest=$(field "$2")
    [ -s "$path" ] || fail "missing-$1"
    case "$digest" in *[!0-9a-f]*|'') fail "invalid-$2" ;; esac
    [ "${#digest}" -eq 64 ] || fail "invalid-$2"
    [ "$(receipt_sha256 "$path")" = "$digest" ] || fail "mismatched-$2"
}

validate() {
    receipt=$1
    [ -f "$receipt" ] || fail missing-receipt
    platform=$(field platform)
    backend=$(field backend)
    actual_backend=$(field actual_backend)
    case "$platform:$backend" in
        hosted:software|hosted:cpu_simd|hosted:metal|simpleos:software|simpleos:cpu_simd) ;;
        *) fail unsupported-platform-backend ;;
    esac
    [ "$(field status)" = pass ] || fail unavailable-or-failed-backend
    [ "$actual_backend" = "$backend" ] || fail backend-fallback
    [ "$(field fallback)" = none ] || fail backend-fallback
    [ "$(field workload)" = filesystem-wm-client-live-retained-frame ] || fail non-live-workload
    case "$backend:$(field readback_source)" in
        software:presented-pixel-buffer|cpu_simd:presented-pixel-buffer|metal:device-readback) ;;
        *) fail non-live-readback ;;
    esac
    [ "$(field readback_mode)" = pixels ] || fail missing-pixel-readback
    [ "$(field source_revision)" != '' ] || fail missing-source-revision
    linked_artifact executable_path executable_sha256
    linked_artifact before_capture_path checksum_before
    linked_artifact capture_path checksum_after
    linked_artifact launch_log_path launch_log_sha256
    [ "$(field checksum_before)" != "$(field checksum_after)" ] || fail unchanged-framebuffer
    grep -Fqx "wm_retained_web2d_perf_capture backend=$backend viewport=$(field viewport_width)x$(field viewport_height) samples=$(field sample_frames)" "$(field launch_log_path)" || fail missing-live-log-marker
    [ "$(field baseline_platform)" = "$platform" ] || fail incomparable-baseline
    [ "$(field baseline_backend)" = "$backend" ] || fail incomparable-baseline
    [ "$(field baseline_viewport_width)" = "$(field viewport_width)" ] || fail incomparable-baseline
    [ "$(field baseline_viewport_height)" = "$(field viewport_height)" ] || fail incomparable-baseline
    [ "$(field baseline_source_revision)" != '' ] || fail missing-baseline-revision

    for name in viewport_width viewport_height warmup_frames sample_frames \
        frame_p50_ns frame_p95_ns frame_budget_ns max_rss_kib rss_budget_kib \
        baseline_p95_ns baseline_max_rss_kib; do
        value=$(field "$name")
        positive "$value" || fail "invalid-$name"
    done
    [ "$(field frame_p95_ns)" -ge "$(field frame_p50_ns)" ] || fail invalid-distribution
    [ "$(field sample_frames)" -ge 20 ] || fail insufficient-samples
    [ "$(field frame_p95_ns)" -le "$(field frame_budget_ns)" ] || fail frame-budget-exceeded
    [ "$(field max_rss_kib)" -le "$(field rss_budget_kib)" ] || fail rss-budget-exceeded
    # Keep memory bounded when a speed improvement is proposed, and keep
    # latency bounded when a memory improvement is proposed.
    [ "$(field frame_p95_ns)" -le "$(( $(field baseline_p95_ns) * 110 / 100 ))" ] || fail p95-regression
    [ "$(field max_rss_kib)" -le "$(( $(field baseline_max_rss_kib) * 105 / 100 ))" ] || fail rss-regression
    echo "wm_retained_web2d_perf_schema_status=pass platform=$platform backend=$backend viewport=$(field viewport_width)x$(field viewport_height) p50_ns=$(field frame_p50_ns) p95_ns=$(field frame_p95_ns) max_rss_kib=$(field max_rss_kib) checksum_after=$(field checksum_after)"
}

if [ "${1:-}" = --self-test-retained-perf-receipt ]; then
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT HUP INT TERM
    printf 'before' > "$tmp/before.ppm"
    printf 'after' > "$tmp/after.ppm"
    printf 'binary' > "$tmp/executable"
    printf 'wm_retained_web2d_perf_capture backend=cpu_simd viewport=3840x2160 samples=40\n' > "$tmp/launch.log"
    before_digest=$(receipt_sha256 "$tmp/before.ppm")
    after_digest=$(receipt_sha256 "$tmp/after.ppm")
    executable_digest=$(receipt_sha256 "$tmp/executable")
    log_digest=$(receipt_sha256 "$tmp/launch.log")
    cat > "$tmp/receipt.env" <<EOF
platform=hosted
backend=cpu_simd
actual_backend=cpu_simd
status=pass
fallback=none
workload=filesystem-wm-client-live-retained-frame
readback_source=presented-pixel-buffer
readback_mode=pixels
source_revision=test-source
executable_path=$tmp/executable
executable_sha256=$executable_digest
before_capture_path=$tmp/before.ppm
checksum_before=$before_digest
capture_path=$tmp/after.ppm
checksum_after=$after_digest
launch_log_path=$tmp/launch.log
launch_log_sha256=$log_digest
viewport_width=3840
viewport_height=2160
warmup_frames=12
sample_frames=40
frame_p50_ns=4000000
frame_p95_ns=5000000
frame_budget_ns=12500000
max_rss_kib=100000
rss_budget_kib=262144
baseline_p95_ns=5000000
baseline_max_rss_kib=100000
baseline_platform=hosted
baseline_backend=cpu_simd
baseline_viewport_width=3840
baseline_viewport_height=2160
baseline_source_revision=test-baseline
EOF
    "$0" --validate-retained-perf-receipt "$tmp/receipt.env" >/dev/null || exit 1
    for change in 'actual_backend=software:backend-fallback' \
        'readback_source=cache:non-live-readback' \
        'checksum_after=1:invalid-checksum_after' \
        'launch_log_sha256=1:invalid-launch_log_sha256' \
        'baseline_backend=software:incomparable-baseline' \
        'frame_p95_ns=08:invalid-frame_p95_ns' \
        'frame_p95_ns=6000000:p95-regression' \
        'max_rss_kib=110000:rss-regression'; do
        key=${change%%=*}
        rest=${change#*=}
        value=${rest%%:*}
        reason=${rest#*:}
        sed "s/^$key=.*/$key=$value/" "$tmp/receipt.env" > "$tmp/next.env"
        output=$(/bin/sh "$0" --validate-retained-perf-receipt "$tmp/next.env" 2>&1) && exit 1
        [ "$output" = "wm_retained_web2d_perf_schema_status=fail reason=$reason" ] || exit 1
    done
    echo wm_retained_web2d_perf_self_test_status=pass
    exit 0
fi

if [ "${1:-}" = --validate-retained-perf-receipt ]; then
    [ "$#" -eq 2 ] || usage
    validate "$2"
    exit 0
fi


ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

BUILD_DIR="${BUILD_DIR:-build/wm-production-fullscreen-evidence}"
ARTIFACT_DIR="${ARTIFACT_DIR:-$BUILD_DIR/artifacts}"
REPORT_PATH="${REPORT_PATH:-$BUILD_DIR/report.md}"
ENTRY="src/os/hosted/hosted_entry.spl"
EVIDENCE_ENV="$BUILD_DIR/evidence.env"
LAUNCH_LOG="$BUILD_DIR/launch.log"
WINDOWED_CAPTURE="$BUILD_DIR/windowed.ppm"
FULLSCREEN_CAPTURE="$BUILD_DIR/fullscreen.ppm"
RESTORED_CAPTURE="$BUILD_DIR/restored.ppm"
WINDOWED_SNAPSHOT="$BUILD_DIR/windowed.scene.json"
FULLSCREEN_SNAPSHOT="$BUILD_DIR/fullscreen.scene.json"
RESTORED_SNAPSHOT="$BUILD_DIR/restored.scene.json"
COMMAND_PATH="$BUILD_DIR/evidence.commands"
NATIVE_BIN="${HOSTED_WM_ARTIFACT:-$BUILD_DIR/hosted_entry}"
BUILD_LOG="$BUILD_DIR/native-build.log"
THEME_SNAPSHOT_SOURCE="$ROOT_DIR/src/lib/common/ui/generated/aetheric_dark_theme_snapshot.spl"
EXPECTED_THEME_ID="aetheric_dark"
EXPECTED_THEME_SOURCE_MANIFEST_SHA256="$(sed -n 's/.*source_manifest_sha256: "\([0-9a-f][0-9a-f]*\)".*/\1/p' "$THEME_SNAPSHOT_SOURCE" | head -n 1)"
case "$(uname -s)" in
    Darwin) RUNTIME_DYLIB_EXT=dylib ;;
    Linux|FreeBSD) RUNTIME_DYLIB_EXT=so ;;
    *) RUNTIME_DYLIB_EXT=dll ;;
esac
SPL_WINIT_LIB="${SIMPLE_WM_WINIT_LIB:-$ROOT_DIR/build/sffi/libspl_winit.$RUNTIME_DYLIB_EXT}"
SIMPLE_RUNTIME_DYLIB="${SIMPLE_WM_RUNTIME_DYLIB:-$ROOT_DIR/build/sffi/libsimple_runtime_wm.$RUNTIME_DYLIB_EXT}"
SIMPLE_RUNTIME_C_DYLIB="${SIMPLE_WM_RUNTIME_C_DYLIB:-$ROOT_DIR/build/sffi/libsimple_runtime_c_wm.$RUNTIME_DYLIB_EXT}"
# The hosted entry's closure reaches std.io.sqlite_sffi through the browser
# session's database layer. rt_sqlite_* lives in src/runtime/runtime_sqlite.c,
# which the core-c runtime lane deliberately excludes (it needs -lsqlite3), so
# it has to arrive as an explicit provider or the link dies on 24 undefined
# rt_sqlite_* symbols.
SIMPLE_RUNTIME_SQLITE_DYLIB="${SIMPLE_WM_RUNTIME_SQLITE_DYLIB:-$ROOT_DIR/build/sffi/libsimple_runtime_sqlite_wm.$RUNTIME_DYLIB_EXT}"
SIMPLE_RUNTIME_HTTPS_DYLIB="${SIMPLE_WM_RUNTIME_HTTPS_DYLIB:-$ROOT_DIR/build/sffi/libsimple_runtime_https_openssl_wm.so}"
HTTPS_PROVIDER_REQUIRED=false
case "$(uname -s)" in
    Linux|FreeBSD) HTTPS_PROVIDER_REQUIRED=true ;;
esac
DRIVER_TIMEOUT_SECS="${WM_EVIDENCE_TIMEOUT_SECS:-20}"
REQUESTED_GUI_BACKEND="$(printf '%s' "${SIMPLE_GUI_BACKEND:-}" | tr '[:upper:]' '[:lower:]')"
VULKAN_EVIDENCE_REQUIRED=false
if [ "$REQUESTED_GUI_BACKEND" = vulkan ]; then
    VULKAN_EVIDENCE_REQUIRED=true
fi
SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE:-explicit-env}"
SIMPLE_BIN_STATUS=unchecked
SIMPLE_BIN_RESOLVED=""
SIMPLE_BIN_VERSION=""
SIMPLE_BIN_SHA256=""

mkdir -p "$BUILD_DIR" "$ARTIFACT_DIR" "$(dirname -- "$REPORT_PATH")"
rm -f "$EVIDENCE_ENV" "$REPORT_PATH" "$LAUNCH_LOG" \
    "$WINDOWED_CAPTURE" "$FULLSCREEN_CAPTURE" "$RESTORED_CAPTURE" \
    "$WINDOWED_SNAPSHOT" "$FULLSCREEN_SNAPSHOT" "$RESTORED_SNAPSHOT" \
    "$COMMAND_PATH"

resolve_path() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1" 2>/dev/null || true
    elif command -v readlink >/dev/null 2>&1; then
        readlink -f "$1" 2>/dev/null || true
    else
        (CDPATH= cd -- "$(dirname -- "$1")" 2>/dev/null && printf '%s/%s\n' "$PWD" "$(basename -- "$1")") || true
    fi
}

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        printf 'unavailable\n'
    fi
}

is_rust_seed_path() {
    case "$1" in
        *"/src/compiler_rust/"*|*"/compiler_rust/target/"*) return 0 ;;
        *) return 1 ;;
    esac
}

artifact_status() {
    if [ -s "$1" ]; then printf 'present\n'; else printf 'missing\n'; fi
}

emit_failure() {
    reason="$1"
    snapshot_hook="${2:-not-checked}"
    capture_hook="${3:-not-checked}"
    input_hook="${4:-not-checked}"
    {
        echo "wm_production_fullscreen_status=fail"
        echo "wm_production_fullscreen_reason=$reason"
        echo "wm_production_fullscreen_entry=$ENTRY"
        echo "wm_production_fullscreen_simple_bin=$SIMPLE_BIN"
        echo "wm_production_fullscreen_simple_bin_resolved=$SIMPLE_BIN_RESOLVED"
        echo "wm_production_fullscreen_simple_bin_source=$SIMPLE_BIN_SOURCE"
        echo "wm_production_fullscreen_simple_bin_status=$SIMPLE_BIN_STATUS"
        echo "wm_production_fullscreen_simple_bin_version=$SIMPLE_BIN_VERSION"
        echo "wm_production_fullscreen_simple_bin_sha256=$SIMPLE_BIN_SHA256"
        echo "wm_production_fullscreen_snapshot_hook=$snapshot_hook"
        echo "wm_production_fullscreen_capture_hook=$capture_hook"
        echo "wm_production_fullscreen_input_hook=$input_hook"
        echo "wm_production_fullscreen_windowed_capture=$(artifact_status "$WINDOWED_CAPTURE")"
        echo "wm_production_fullscreen_fullscreen_capture=$(artifact_status "$FULLSCREEN_CAPTURE")"
        echo "wm_production_fullscreen_restored_capture=$(artifact_status "$RESTORED_CAPTURE")"
        echo "wm_production_fullscreen_windowed_snapshot=$(artifact_status "$WINDOWED_SNAPSHOT")"
        echo "wm_production_fullscreen_fullscreen_snapshot=$(artifact_status "$FULLSCREEN_SNAPSHOT")"
        echo "wm_production_fullscreen_restored_snapshot=$(artifact_status "$RESTORED_SNAPSHOT")"
        echo "wm_production_fullscreen_launch_log=$(artifact_status "$LAUNCH_LOG")"
        echo "wm_production_fullscreen_native_artifact=$(artifact_status "$NATIVE_BIN")"
        echo "wm_production_fullscreen_requested_gui_backend=$REQUESTED_GUI_BACKEND"
        echo "wm_production_fullscreen_vulkan_evidence_required=$VULKAN_EVIDENCE_REQUIRED"
    } >"$EVIDENCE_ENV"
    {
        echo "# Production Host WM Fullscreen Evidence"
        echo
        echo "- status: fail"
        echo "- reason: $reason"
        echo "- entry: $ENTRY"
        echo "- Simple binary: $SIMPLE_BIN"
        echo "- resolved binary: $SIMPLE_BIN_RESOLVED"
        echo "- binary status: $SIMPLE_BIN_STATUS"
        echo "- snapshot hook: $snapshot_hook"
        echo "- capture hook: $capture_hook"
        echo "- input hook: $input_hook"
        echo
        echo "No screenshot, source inspection, or demo marker is accepted as production evidence."
    } >"$REPORT_PATH"
    cat "$EVIDENCE_ENV"
}

if [ -z "${SIMPLE_BIN:-}" ]; then
    SIMPLE_BIN=""
    SIMPLE_BIN_SOURCE=auto-cached-pure-simple
    for candidate in \
        "$ROOT_DIR"/build/bootstrap/stage3/*/simple \
        "$ROOT_DIR"/build/bootstrap/stage2/*/simple \
        "$ROOT_DIR"/bin/release/*/simple \
        "$ROOT_DIR"/release/*/simple \
        "$ROOT_DIR"/bin/simple
    do
        if [ -x "$candidate" ]; then
            resolved="$(resolve_path "$candidate")"
            if [ -n "$resolved" ] && ! is_rust_seed_path "$resolved"; then
                SIMPLE_BIN="$candidate"
                break
            fi
        fi
    done
fi

SIMPLE_BIN_RESOLVED="$(resolve_path "${SIMPLE_BIN:-missing}")"
if is_rust_seed_path "${SIMPLE_BIN:-}" || is_rust_seed_path "$SIMPLE_BIN_RESOLVED"; then
    SIMPLE_BIN_STATUS=forbidden
    SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE}-rust-seed-forbidden"
    emit_failure simple-bin-forbidden
    exit 1
fi
if [ -z "${SIMPLE_BIN:-}" ] || [ ! -x "$SIMPLE_BIN" ] || [ -z "$SIMPLE_BIN_RESOLVED" ]; then
    SIMPLE_BIN_STATUS=missing
    emit_failure simple-bin-missing
    exit 1
fi

SIMPLE_BIN_VERSION="$($SIMPLE_BIN --version 2>&1 | tr '\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g; s/ $//' || true)"
SIMPLE_BIN_SHA256="$(sha256_file "$SIMPLE_BIN_RESOLVED")"
case "$(printf '%s' "$SIMPLE_BIN_VERSION" | tr '[:upper:]' '[:lower:]')" in
    *rust-built*|*rust*seed*|*bootstrap*seed*)
        SIMPLE_BIN_STATUS=forbidden
        SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE}-provenance-forbidden"
        emit_failure simple-bin-forbidden
        exit 1
        ;;
esac
if [ -z "$SIMPLE_BIN_VERSION" ] || [ "$SIMPLE_BIN_SHA256" = unavailable ]; then
    SIMPLE_BIN_STATUS=unverified
    emit_failure simple-bin-provenance-unverified
    exit 1
fi
SIMPLE_BIN_STATUS=pass

# `bootstrap_main` delegates native-build to its embedded native-all bridge.
# A pure-Simple bootstrap binary can otherwise look valid while carrying an
# older bridge that silently ignores SIMPLE_LINK_OBJECTS, yielding a late
# unresolved-symbol failure. Require the compiled bridge's current fail-closed
# provider diagnostic before spending a live-evidence attempt.
if ! LC_ALL=C grep -aFq 'SIMPLE_LINK_OBJECTS provider is missing or not a file:' "$SIMPLE_BIN"; then
    SIMPLE_BIN_STATUS=provider-link-support-missing
    emit_failure simple-bin-external-provider-link-support-missing
    exit 1
fi

# Production execution is permitted only after the entry advertises all three
# machine-readable hooks. These names are protocol contracts, not evidence
# markers: the live run must still produce and correlate every artifact.
snapshot_hook=missing
capture_hook=missing
input_hook=missing
grep -Fq 'SIMPLE_WM_EVIDENCE_SNAPSHOT_PATH' "$ENTRY" && snapshot_hook=ready
grep -Fq 'SIMPLE_WM_EVIDENCE_CAPTURE_PATH' "$ENTRY" && capture_hook=ready
grep -Fq 'SIMPLE_WM_EVIDENCE_INPUT_FIFO' "$ENTRY" && input_hook=ready
if [ "$snapshot_hook" != ready ] || [ "$capture_hook" != ready ] || [ "$input_hook" != ready ]; then
    emit_failure production-evidence-hooks-missing "$snapshot_hook" "$capture_hook" "$input_hook"
    exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
    emit_failure structural-json-parser-missing "$snapshot_hook" "$capture_hook" "$input_hook"
    exit 1
fi

if [ ! -s "$SPL_WINIT_LIB" ] || [ "$ROOT_DIR/src/runtime/spl_winit/src/lib.rs" -nt "$SPL_WINIT_LIB" ]; then
    if ! sh scripts/build/build_spl_winit.shs >"$BUILD_DIR/build-spl-winit.log" 2>&1; then
        emit_failure spl-winit-bridge-build-failed "$snapshot_hook" "$capture_hook" "$input_hook"
        exit 1
    fi
fi
if [ ! -s "$SIMPLE_RUNTIME_DYLIB" ] || [ ! -s "$SIMPLE_RUNTIME_C_DYLIB" ] || \
    find src/runtime src/compiler_rust/runtime src/compiler_rust/common/src/runtime_symbols.rs \
        -type f -newer "$SIMPLE_RUNTIME_DYLIB" -print -quit | grep -q .; then
    if ! sh scripts/build/build_simple_runtime_sffi.shs >"$BUILD_DIR/build-simple-runtime-sffi.log" 2>&1; then
        emit_failure host-runtime-provider-build-failed "$snapshot_hook" "$capture_hook" "$input_hook"
        exit 1
    fi
fi
if [ ! -s "$SIMPLE_RUNTIME_SQLITE_DYLIB" ] || \
    [ "$ROOT_DIR/src/runtime/runtime_sqlite.c" -nt "$SIMPLE_RUNTIME_SQLITE_DYLIB" ]; then
    if ! sh scripts/build/build_simple_runtime_sqlite_sffi.shs >"$BUILD_DIR/build-simple-runtime-sqlite-sffi.log" 2>&1; then
        emit_failure host-sqlite-provider-build-failed "$snapshot_hook" "$capture_hook" "$input_hook"
        exit 1
    fi
fi
if [ "$HTTPS_PROVIDER_REQUIRED" = true ] && \
    { [ ! -s "$SIMPLE_RUNTIME_HTTPS_DYLIB" ] || \
      find "$ROOT_DIR/src/runtime/runtime_https_openssl_core.c" \
          "$ROOT_DIR/src/runtime/runtime.h" \
          "$ROOT_DIR/scripts/build/build_simple_runtime_https_openssl_sffi.shs" \
          -newer "$SIMPLE_RUNTIME_HTTPS_DYLIB" -print -quit | grep -q .; }; then
    if ! sh scripts/build/build_simple_runtime_https_openssl_sffi.shs >"$BUILD_DIR/build-simple-runtime-https-sffi.log" 2>&1; then
        emit_failure host-https-provider-build-failed "$snapshot_hook" "$capture_hook" "$input_hook"
        exit 1
    fi
fi
if [ ! -s "$SPL_WINIT_LIB" ] || [ ! -s "$SIMPLE_RUNTIME_DYLIB" ] || [ ! -s "$SIMPLE_RUNTIME_C_DYLIB" ] || \
    [ ! -s "$SIMPLE_RUNTIME_SQLITE_DYLIB" ]; then
    emit_failure host-runtime-bridge-missing "$snapshot_hook" "$capture_hook" "$input_hook"
    exit 1
fi
if [ "$HTTPS_PROVIDER_REQUIRED" = true ] && \
    [ ! -s "$SIMPLE_RUNTIME_HTTPS_DYLIB" ]; then
    emit_failure host-https-provider-missing "$snapshot_hook" "$capture_hook" "$input_hook"
    exit 1
fi
if ! nm -g "$SIMPLE_RUNTIME_SQLITE_DYLIB" 2>/dev/null | grep -Eq '(_| )rt_sqlite_open$'; then
    emit_failure host-sqlite-provider-incomplete "$snapshot_hook" "$capture_hook" "$input_hook"
    exit 1
fi
if ! nm -g "$SIMPLE_RUNTIME_C_DYLIB" 2>/dev/null | grep -Eq '(_| )rt_engine2d_rocm_download_pixels$'; then
    emit_failure host-runtime-provider-incomplete "$snapshot_hook" "$capture_hook" "$input_hook"
    exit 1
fi
if [ "$HTTPS_PROVIDER_REQUIRED" = true ] && \
    ! nm -g "$SIMPLE_RUNTIME_HTTPS_DYLIB" 2>/dev/null | grep -Eq '[[:space:]][Tt][[:space:]]_?rt_tls_client_connect_with_sni$'; then
    emit_failure host-https-provider-incomplete "$snapshot_hook" "$capture_hook" "$input_hook"
    exit 1
fi

EXTERNAL_PROVIDERS="$SPL_WINIT_LIB:$SIMPLE_RUNTIME_DYLIB:$SIMPLE_RUNTIME_C_DYLIB:$SIMPLE_RUNTIME_SQLITE_DYLIB"
if [ "$HTTPS_PROVIDER_REQUIRED" = true ]; then
    EXTERNAL_PROVIDERS="$SIMPLE_RUNTIME_HTTPS_DYLIB:$EXTERNAL_PROVIDERS"
fi

if [ -n "${HOSTED_WM_ARTIFACT:-}" ]; then
    if [ ! -x "$NATIVE_BIN" ]; then
        emit_failure cached-production-artifact-missing "$snapshot_hook" "$capture_hook" "$input_hook"
        exit 1
    fi
elif [ ! -x "$NATIVE_BIN" ] || find src/os/hosted src/os/compositor src/lib/common/ui src/lib/gc_async_mut \
    -type f -name '*.spl' -newer "$NATIVE_BIN" -print -quit | grep -q .; then
    if ! SIMPLE_NO_STUB_FALLBACK=1 \
        SIMPLE_LINK_OBJECTS="$EXTERNAL_PROVIDERS" \
        SIMPLE_LIB="$ROOT_DIR/src" "$SIMPLE_BIN" native-build \
        --source "$ENTRY" --entry "$ENTRY" --entry-closure --strip \
        --backend cranelift \
        --cache-dir "$BUILD_DIR/native-cache" --mode dynload --output "$NATIVE_BIN" \
        >"$BUILD_LOG" 2>&1; then
        emit_failure production-native-build-failed "$snapshot_hook" "$capture_hook" "$input_hook"
        exit 1
    fi
    if grep -Eq 'FAILED FILES|non-critical file\(s\) failed|Generating [1-9][0-9]* stub functions|Warning: [1-9][0-9]* files failed' "$BUILD_LOG"; then
        rm -f "$NATIVE_BIN"
        emit_failure production-native-build-incomplete "$snapshot_hook" "$capture_hook" "$input_hook"
        exit 1
    fi
fi
if [ ! -x "$NATIVE_BIN" ]; then
    emit_failure cached-production-artifact-unavailable "$snapshot_hook" "$capture_hook" "$input_hook"
    exit 1
fi

provider_linked() {
    binary="$1"
    provider="$2"
    provider_name="$(basename -- "$provider")"
    case "$(uname -s)" in
        Darwin) otool -L "$binary" 2>/dev/null | grep -Fq "@rpath/$provider_name" ;;
        Linux|FreeBSD) readelf -d "$binary" 2>/dev/null | grep -Fq "$provider_name" ;;
        *) return 1 ;;
    esac
}
for provider in "$SPL_WINIT_LIB" "$SIMPLE_RUNTIME_DYLIB" "$SIMPLE_RUNTIME_C_DYLIB" "$SIMPLE_RUNTIME_SQLITE_DYLIB"; do
    if ! provider_linked "$NATIVE_BIN" "$provider"; then
        emit_failure host-runtime-provider-not-linked "$snapshot_hook" "$capture_hook" "$input_hook"
        exit 1
    fi
done
if [ "$HTTPS_PROVIDER_REQUIRED" = true ] && \
    ! provider_linked "$NATIVE_BIN" "$SIMPLE_RUNTIME_HTTPS_DYLIB"; then
    emit_failure host-https-provider-not-linked "$snapshot_hook" "$capture_hook" "$input_hook"
    exit 1
fi
if [ "$HTTPS_PROVIDER_REQUIRED" = true ]; then
    tls_needed_line="$(readelf -d "$NATIVE_BIN" 2>/dev/null | grep -n "$(basename -- "$SIMPLE_RUNTIME_HTTPS_DYLIB")" | head -n 1 | cut -d: -f1)"
    runtime_needed_line="$(readelf -d "$NATIVE_BIN" 2>/dev/null | grep -n "$(basename -- "$SIMPLE_RUNTIME_DYLIB")" | head -n 1 | cut -d: -f1)"
    if [ -z "$tls_needed_line" ] || [ -z "$runtime_needed_line" ] || \
        [ "$tls_needed_line" -ge "$runtime_needed_line" ]; then
        emit_failure host-https-provider-precedence-invalid "$snapshot_hook" "$capture_hook" "$input_hook"
        exit 1
    fi
fi

case "$(uname -s)" in
    Darwin) [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] || : ;; # winit uses the native session.
    Linux)
        if [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
            emit_failure platform-window-capture-unavailable "$snapshot_hook" "$capture_hook" "$input_hook"
            exit 1
        fi
        ;;
    *)
        emit_failure platform-window-capture-unavailable "$snapshot_hook" "$capture_hook" "$input_hook"
        exit 1
        ;;
esac

printf '0 idle\n' >"$COMMAND_PATH"
SIMPLE_WM_EVIDENCE_SNAPSHOT_PATH="$ROOT_DIR/$FULLSCREEN_SNAPSHOT.live" \
SIMPLE_WM_EVIDENCE_CAPTURE_PATH="$ROOT_DIR/$FULLSCREEN_CAPTURE.live" \
SIMPLE_WM_EVIDENCE_INPUT_FIFO="$ROOT_DIR/$COMMAND_PATH" \
SIMPLE_WM_RASTER="${SIMPLE_WM_RASTER:-simple-2d-winit-buffer}" \
    "$NATIVE_BIN" >"$LAUNCH_LOG" 2>&1 &
wm_pid=$!
cleanup() {
    kill "$wm_pid" 2>/dev/null || true
    wait "$wm_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

now_ms() { perl -MTime::HiRes=time -e 'printf "%.0f\n", time()*1000'; }
fail_live() {
    cleanup
    trap - EXIT INT TERM
    emit_failure "$1" "$snapshot_hook" "$capture_hook" "$input_hook"
    exit 1
}
wait_for() {
    predicate=$1
    started=$(now_ms)
    while :; do
        if [ -s "$FULLSCREEN_SNAPSHOT.live" ] && jq -e "$predicate" "$FULLSCREEN_SNAPSHOT.live" >/dev/null 2>&1; then
            return 0
        fi
        # Distinguish an application crash from a slow but still-live window.
        # This preserves a fail-closed report with an actionable reason.
        kill -0 "$wm_pid" 2>/dev/null || return 2
        [ $(( $(now_ms) - started )) -lt $((DRIVER_TIMEOUT_SECS * 1000)) ] || return 1
        sleep 0.05
    done
}
issue() {
    nonce=$1 action=$2
    printf '%s %s\n' "$nonce" "$action" >"$COMMAND_PATH"
    wait_for ".input.nonce == $nonce" || fail_live "command-ack-timeout-$nonce"
}
save_phase() {
    cp "$FULLSCREEN_SNAPSHOT.live" "$1"
    cp "$FULLSCREEN_CAPTURE.live" "$2"
}
vulkan_frame_marker() {
    marker_pattern=$1
    grep -E "$marker_pattern" "$LAUNCH_LOG" |
        grep -E '(^|[ ;])backend=vulkan([; ]|$)' |
        grep -E '(^|[ ;])source=device_readback([; ]|$)' |
        grep -E '(^|[ ;])handle=[1-9][0-9]*([; ]|$)' |
        grep -E '(^|[ ;])checksum=[1-9][0-9]*([; ]|$)' |
        tail -n 1 || true
}
marker_field() {
    marker=$1
    field=$2
    printf '%s\n' "$marker" | tr ';' ' ' | awk -v key="$field" '
        {
            for (i = 1; i <= NF; i++) {
                split($i, pair, "=")
                if (pair[1] == key) {
                    print pair[2]
                    exit
                }
            }
        }
    '
}
ppm_engine2d_checksum() {
    perl -e '
        use strict;
        my ($path) = @ARGV;
        open my $file, "<:raw", $path or exit 1;
        local $/;
        my $data = <$file>;
        $data =~ /\AP6\r?\n(\d+) (\d+)\r?\n255\r?\n/s or exit 2;
        my ($width, $height) = ($1, $2);
        my $pixels = substr($data, $+[0]);
        length($pixels) == $width * $height * 3 or exit 3;
        my $checksum = 0;
        for (my $offset = 0; $offset < length($pixels); $offset += 3) {
            my ($red, $green, $blue) = unpack("C3", substr($pixels, $offset, 3));
            my $argb = 0xFF000000 | ($red << 16) | ($green << 8) | $blue;
            $checksum = ($checksum + $argb) % 2147483647;
        }
        print "$checksum\n";
    ' "$1"
}

if wait_for '.schema == "simple-wm-production-evidence-v1" and .input.nonce == 0 and .input.phase == "presented"'; then
    :
else
    readiness_status=$?
    if [ "$readiness_status" -eq 2 ]; then
        fail_live hosted-process-exited-before-evidence
    fi
    fail_live evidence-readiness-timeout
fi

# Exercise the internal-window hooks before fixing the reference semantic scene.
# Maximize must affect only the focused internal window and restore its exact
# pre-maximize state; native F11 fullscreen is tested separately below.
issue 1 'tab'
issue 2 'pointer 160 90'
issue 3 'left down'
issue 4 'pointer 190 115'
issue 5 'left up'
issue 6 'minimize'
issue 7 'restore'
cp "$FULLSCREEN_SNAPSHOT.live" "$ARTIFACT_DIR/internal-pre-maximize.scene.json"
pre_max_scene=$(jq -cS '{windows:.compositor.windows,taskbar:.compositor.taskbar}' "$ARTIFACT_DIR/internal-pre-maximize.scene.json")
focused_id=$(jq -er '.compositor.windows[] | select(.focused == true) | .id' "$ARTIFACT_DIR/internal-pre-maximize.scene.json")
issue 8 'maximize'
jq -e --argjson id "$focused_id" --argjson sw "$(jq -r '.compositor.width' "$FULLSCREEN_SNAPSHOT.live")" --argjson sh "$(jq -r '.compositor.height' "$FULLSCREEN_SNAPSHOT.live")" '.compositor.windows[] | select(.id==$id) | .maximized==true and .x==0 and .y==48 and .width==$sw and .height==($sh-96)' "$FULLSCREEN_SNAPSHOT.live" >/dev/null || fail_live internal-maximize-geometry-mismatch
issue 9 'restore'
[ "$(jq -cS '{windows:.compositor.windows,taskbar:.compositor.taskbar}' "$FULLSCREEN_SNAPSHOT.live")" = "$pre_max_scene" ] || fail_live internal-maximize-restore-mismatch
issue 10 'snapshot'
save_phase "$WINDOWED_SNAPSHOT" "$WINDOWED_CAPTURE"

windowed_x=$(jq -er '.surface.geometry.x' "$WINDOWED_SNAPSHOT")
windowed_y=$(jq -er '.surface.geometry.y' "$WINDOWED_SNAPSHOT")
windowed_w=$(jq -er '.surface.geometry.width' "$WINDOWED_SNAPSHOT")
windowed_h=$(jq -er '.surface.geometry.height' "$WINDOWED_SNAPSHOT")
windowed_scene=$(jq -cS '{windows:.compositor.windows,taskbar:.compositor.taskbar}' "$WINDOWED_SNAPSHOT")

fullscreen_started=$(now_ms)
issue 11 'f11'
wait_for '.input.nonce == 11 and .surface.mode == "borderless_fullscreen" and .surface.phase == "applied" and .surface.resize_acknowledged == true' || fail_live fullscreen-transition-timeout
fullscreen_elapsed=$(( $(now_ms) - fullscreen_started ))
save_phase "$FULLSCREEN_SNAPSHOT" "$FULLSCREEN_CAPTURE"

restored_started=$(now_ms)
issue 12 'f11'
wait_for '.input.nonce == 12 and .surface.mode == "windowed" and .surface.phase == "applied" and .surface.resize_acknowledged == true' || fail_live restore-transition-timeout
restored_elapsed=$(( $(now_ms) - restored_started ))
save_phase "$RESTORED_SNAPSHOT" "$RESTORED_CAPTURE"

for snapshot in "$WINDOWED_SNAPSHOT" "$FULLSCREEN_SNAPSHOT" "$RESTORED_SNAPSHOT"; do
    jq -e '.render.backend == "simple-2d-winit-buffer" and .render.fallback_used == false and .render.readback == "presented-pixel-buffer" and (.compositor.windows|length) > 0 and (.compositor.taskbar.running|length) > 0' "$snapshot" >/dev/null || fail_live snapshot-provenance-invalid
    [ "$(jq -cS '{windows:.compositor.windows,taskbar:.compositor.taskbar}' "$snapshot")" = "$windowed_scene" ] || fail_live internal-scene-changed-across-physical-mode
done
jq -e --argjson x "$windowed_x" --argjson y "$windowed_y" --argjson w "$windowed_w" --argjson h "$windowed_h" '.surface.geometry.x==$x and .surface.geometry.y==$y and .surface.geometry.width==$w and .surface.geometry.height==$h and .surface.saved_windowed_geometry.x==$x and .surface.saved_windowed_geometry.y==$y and .surface.saved_windowed_geometry.width==$w and .surface.saved_windowed_geometry.height==$h and .input.nonce==12' "$RESTORED_SNAPSHOT" >/dev/null || fail_live restored-native-geometry-mismatch

ppm_check() {
    snapshot=$2
    wx=$(jq -r '.compositor.windows[0].x' "$snapshot")
    wy=$(jq -r '.compositor.windows[0].y' "$snapshot")
    ww=$(jq -r '.compositor.windows[0].width' "$snapshot")
    wh=$(jq -r '.compositor.windows[0].height' "$snapshot")
    perl -e 'use strict; my($p,$wx,$wy,$ww,$wh)=@ARGV; open my $f,"<:raw",$p or exit 1; local $/; my $d=<$f>; $d =~ /\AP6\r?\n(\d+) (\d+)\r?\n255\r?\n/s or exit 2; my($w,$h)=($1,$2); my $off=$+[0]; my $pix=substr($d,$off); length($pix)==$w*$h*3 or exit 3; my %c; my $ink=0; for(my $i=0;$i<length($pix);$i+=3){my $v=substr($pix,$i,3);$c{$v}=1;$ink++ if $v ne "\0\0\0"} scalar(keys %c)>=8 && $ink>$w*$h/10 or exit 4; my @pts=([$wx+int($ww/3),$wy+10],[$wx+int($ww/2),$wy+int($wh/2)],[int($w/2),$h-12]); my @v; for(@pts){my($x,$y)=@$_; $x>=0&&$x<$w&&$y>=0&&$y<$h or exit 5; push @v,substr($pix,($y*$w+$x)*3,3)} ($v[0] ne $v[1] || $v[1] ne $v[2]) or exit 6; print "$w $h\n"' "$1" "$wx" "$wy" "$ww" "$wh"
}
for capture in "$WINDOWED_CAPTURE" "$FULLSCREEN_CAPTURE" "$RESTORED_CAPTURE"; do
    snapshot="${capture%.ppm}.scene.json"
    dims=$(ppm_check "$capture" "$snapshot") || fail_live ppm-invalid-or-semantic-pixels-missing
    sw=$(jq -r '.compositor.width' "$snapshot")
    sh=$(jq -r '.compositor.height' "$snapshot")
    [ "$dims" = "$sw $sh" ] || fail_live ppm-dimensions-mismatch
done
windowed_hash=$(sha256_file "$WINDOWED_CAPTURE")
fullscreen_hash=$(sha256_file "$FULLSCREEN_CAPTURE")
restored_hash=$(sha256_file "$RESTORED_CAPTURE")
[ "$windowed_hash" != "$fullscreen_hash" ] || fail_live fullscreen-capture-not-distinct
[ "$windowed_hash" = "$restored_hash" ] || fail_live restored-capture-semantic-state-mismatch
content_provenance_marker="$(grep -E "^\\[hosted-wm\\] content-presented scene_revision=[1-9][0-9]* window_id=.* status=engine2d_rendered backend=[^ ]+ fallback=solid-material material=[0-9a-f]{64} theme=$EXPECTED_THEME_ID source=$EXPECTED_THEME_SOURCE_MANIFEST_SHA256$" "$LAUNCH_LOG" | tail -n 1 || true)"
[ -n "$content_provenance_marker" ] || fail_live content-provenance-missing
if grep -Eq '^\[hosted-wm\] content-provenance-rejected|backend=native-safe-fallback|^\[hosted-wm\] draw-ir-rejected retry=compatibility' "$LAUNCH_LOG"; then
    fail_live content-provenance-rejected
fi

verified_backend=simple-2d-winit-buffer
verified_source=presented-pixel-buffer
verified_backend_handle=0
verified_same_frame_readback=false
verified_readback_checksum=0
verified_presented_checksum=0
if [ "$VULKAN_EVIDENCE_REQUIRED" = true ]; then
    initial_vulkan_marker="$(vulkan_frame_marker '^\[hosted-wm\] frame-presented ')"
    windowed_vulkan_marker="$(vulkan_frame_marker '^\[hosted-wm\] evidence-ack nonce=10 ')"
    fullscreen_vulkan_marker="$(vulkan_frame_marker '^\[hosted-wm\] evidence-ack nonce=11 ')"
    restored_vulkan_marker="$(vulkan_frame_marker '^\[hosted-wm\] evidence-ack nonce=12 ')"
    [ -n "$initial_vulkan_marker" ] || fail_live vulkan-initial-device-readback-marker-missing
    [ -n "$windowed_vulkan_marker" ] || fail_live vulkan-windowed-device-readback-marker-missing
    [ -n "$fullscreen_vulkan_marker" ] || fail_live vulkan-fullscreen-device-readback-marker-missing
    [ -n "$restored_vulkan_marker" ] || fail_live vulkan-restored-device-readback-marker-missing
    windowed_readback_checksum="$(marker_field "$windowed_vulkan_marker" checksum)"
    fullscreen_readback_checksum="$(marker_field "$fullscreen_vulkan_marker" checksum)"
    restored_readback_checksum="$(marker_field "$restored_vulkan_marker" checksum)"
    windowed_presented_checksum="$(ppm_engine2d_checksum "$WINDOWED_CAPTURE")" || fail_live vulkan-windowed-presented-checksum-unavailable
    fullscreen_presented_checksum="$(ppm_engine2d_checksum "$FULLSCREEN_CAPTURE")" || fail_live vulkan-fullscreen-presented-checksum-unavailable
    restored_presented_checksum="$(ppm_engine2d_checksum "$RESTORED_CAPTURE")" || fail_live vulkan-restored-presented-checksum-unavailable
    [ "$windowed_readback_checksum" = "$windowed_presented_checksum" ] || fail_live vulkan-windowed-same-frame-checksum-mismatch
    [ "$fullscreen_readback_checksum" = "$fullscreen_presented_checksum" ] || fail_live vulkan-fullscreen-same-frame-checksum-mismatch
    [ "$restored_readback_checksum" = "$restored_presented_checksum" ] || fail_live vulkan-restored-same-frame-checksum-mismatch
    verified_backend=vulkan
    verified_source=device_readback
    verified_backend_handle="$(marker_field "$fullscreen_vulkan_marker" handle)"
    verified_same_frame_readback=true
    verified_readback_checksum="$fullscreen_readback_checksum"
    verified_presented_checksum="$fullscreen_presented_checksum"
fi

cleanup
trap - EXIT INT TERM
{
    echo "wm_production_fullscreen_status=pass"
    echo "wm_production_fullscreen_reason=live-production-evidence-verified"
    echo "wm_production_fullscreen_native_artifact=$NATIVE_BIN"
    echo "wm_production_fullscreen_requested_gui_backend=$REQUESTED_GUI_BACKEND"
    echo "wm_production_fullscreen_vulkan_evidence_required=$VULKAN_EVIDENCE_REQUIRED"
    echo "wm_production_fullscreen_backend=$verified_backend"
    echo "wm_production_fullscreen_fallback_used=false"
    echo "wm_production_fullscreen_readback=$verified_source"
    echo "wm_production_fullscreen_backend_handle=$verified_backend_handle"
    echo "wm_production_fullscreen_same_frame_readback=$verified_same_frame_readback"
    echo "wm_production_fullscreen_readback_checksum=$verified_readback_checksum"
    echo "wm_production_fullscreen_presented_checksum=$verified_presented_checksum"
    echo "wm_production_fullscreen_content_provenance=$content_provenance_marker"
    echo "wm_production_fullscreen_theme_source_manifest_sha256=$EXPECTED_THEME_SOURCE_MANIFEST_SHA256"
    echo "wm_production_fullscreen_internal_maximize_hook=verified"
    echo "wm_production_fullscreen_fullscreen_transition_ms=$fullscreen_elapsed"
    echo "wm_production_fullscreen_restore_transition_ms=$restored_elapsed"
    echo "wm_production_fullscreen_windowed_hash=$windowed_hash"
    echo "wm_production_fullscreen_fullscreen_hash=$fullscreen_hash"
    echo "wm_production_fullscreen_restored_hash=$restored_hash"
} >"$EVIDENCE_ENV"
{
    echo "# Production Host WM Fullscreen Evidence"
    echo
    echo "- status: pass"
    echo "- artifact: $NATIVE_BIN"
    echo "- backend/readback: $verified_backend / $verified_source (no fallback)"
    echo "- backend handle: $verified_backend_handle"
    echo "- same-frame checksum: $verified_same_frame_readback ($verified_readback_checksum / $verified_presented_checksum)"
    echo "- content provenance: $content_provenance_marker"
    echo "- fullscreen/restore: ${fullscreen_elapsed}ms / ${restored_elapsed}ms"
    echo "- internal interactions: focus, drag, minimize, taskbar restore"
    echo "- internal maximize/restore: verified exact"
    echo "- exact internal scene equality: pass"
    echo "- restored native geometry: $windowed_x,$windowed_y ${windowed_w}x${windowed_h}"
} >"$REPORT_PATH"
cat "$EVIDENCE_ENV"
