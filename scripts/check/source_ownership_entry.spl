# Entry for scripts/check/check-source-ownership.shs: runs the robust
# SPL-BUILD-SRC-001 source-ownership doctor over the given library dirs.
# Usage: bin/simple run scripts/check/source_ownership_entry.spl -- [<lib dir>...]
# No dir = the real library units: src/compiler and its closure (src/lib, src/compiler_rust).
# Last stdout line is the verdict; exit 0 PASS / 1 FAIL / 2 ERROR.

use app.build.doctor_cli.{run_build_doctor}
use std.io_runtime.{get_args}

fn _user_args() -> [text]:
    var out: [text] = []
    var seen = false
    for a in get_args():
        if seen:
            if not (out.len() == 0 and a == "--"):
                out.push(a)
        elif a.ends_with("source_ownership_entry.spl"):
            seen = true
    out

fn main() -> i64:
    var args = ["--source-ownership", "--robust"]
    var user = _user_args()
    if user.len() == 0:
        user = ["src/compiler"]
    for a in user:
        args.push(a)
    run_build_doctor(args)
