#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

CC_BIN="${CC:-clang}"
BUILD_DIR="${BUILD_DIR:-build/check/engine2d-simd-8k-ops}"
RUNNER="${ENGINE2D_SIMD_8K_RUNNER:-}"
MODE="${ENGINE2D_SIMD_8K_MODE:-native}"
WIDTH="${ENGINE2D_SIMD_8K_WIDTH:-7680}"
HEIGHT="${ENGINE2D_SIMD_8K_HEIGHT:-4320}"
SAMPLES="${ENGINE2D_SIMD_8K_SAMPLES:-7}"
ACTIVE_BASIS_POINTS="${ENGINE2D_SIMD_8K_ACTIVE_BASIS_POINTS:-10000}"
EXTRA_CFLAGS="${ENGINE2D_SIMD_8K_CFLAGS:-}"

mkdir -p "$BUILD_DIR"
RUNTIME_OBJ="$BUILD_DIR/runtime_simd_dispatch.o"
BENCH_OBJ="$BUILD_DIR/engine2d_simd_8k_ops_bench.o"
BENCH_BIN="$BUILD_DIR/engine2d_simd_8k_ops_bench"
REPORT="$BUILD_DIR/receipt.env"
TMP_REPORT="$(mktemp "$BUILD_DIR/receipt.XXXXXX")"
CFLAGS="-O3 -std=gnu11 -ffunction-sections -fdata-sections -Isrc/runtime $EXTRA_CFLAGS"
# A failed replacement must not leave an older PASS-looking receipt at the
# caller-selected evidence path.
rm -f "$REPORT"

cleanup_report() {
    rm -f "$TMP_REPORT"
}
trap cleanup_report EXIT HUP INT TERM

$CC_BIN $CFLAGS -c src/runtime/runtime_simd_dispatch.c -o "$RUNTIME_OBJ"
$CC_BIN $CFLAGS -c test/09_baselines/engine2d_simd/engine2d_simd_8k_ops_bench.c -o "$BENCH_OBJ"
$CC_BIN $CFLAGS -Wl,--gc-sections "$RUNTIME_OBJ" "$BENCH_OBJ" -o "$BENCH_BIN"

# `$RUNNER` deliberately permits a configured QEMU command with arguments.
# Capture the benchmark's actual exit status before publishing its receipt:
# a pipeline ending in `tee` would otherwise turn a compiler/emulator failure
# into a plausible-looking evidence pass.
# shellcheck disable=SC2086
if ! $RUNNER "$BENCH_BIN" "$WIDTH" "$HEIGHT" "$SAMPLES" "$MODE" \
    "$ACTIVE_BASIS_POINTS" > "$TMP_REPORT"; then
    cat "$TMP_REPORT"
    exit 1
fi
mv "$TMP_REPORT" "$REPORT"
trap - EXIT HUP INT TERM
cat "$REPORT"
grep -q '^engine2d_8k_checksum=[0-9][0-9]*$' "$REPORT"
grep -q '^engine2d_8k_native_simd_hits=[1-9][0-9]*$' "$REPORT"
grep -q '^engine2d_8k_six_call_frame_p95_ns=[0-9][0-9]*$' "$REPORT"
grep -q '^engine2d_8k_active_damage_primitive_budget_met=\(true\|false\)$' "$REPORT"
grep -q '^engine2d_8k_full_dynamic_frame_80fps_proven=false$' "$REPORT"
echo "engine2d-simd-8k-ops: pass"
