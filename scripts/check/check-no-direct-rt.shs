#!/bin/sh
# check-no-direct-rt.shs — fail-closed gate on direct rt_* call sites in Simple product code.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Counts are measured, never assumed. See:
#   doc/03_plan/infra/binary_runtime_hardening/plan.md
#   doc/01_research/infra/sspec_binary/binary_sspec_rt_hardening_frozen_design_2026-08-18.md
# Usage: sh scripts/check/check-no-direct-rt.shs [--selftest-only] [--root DIR]

set -u

ROOT="$(pwd)"
SELFTEST_ONLY=0
# --critical (or SIMPLE_RT_CRITICAL=1): phase-A error mode — ANY forbidden
# direct rt_* call site fails, the baseline ratchet does not apply. This is
# the "warning becomes error" lane for critical/mission-critical builds; the
# default mode stays a ratchet until the product count reaches zero (phase C
# then promotes critical behavior everywhere).
CRITICAL=0
[ "${SIMPLE_RT_CRITICAL:-0}" != "0" ] && CRITICAL=1
while [ $# -gt 0 ]; do
  case "$1" in
    --selftest-only) SELFTEST_ONLY=1 ;;
    --critical) CRITICAL=1 ;;
    --root) shift; ROOT="$1" ;;
    *) echo "ERROR — unknown argument: $1"; exit 2 ;;
  esac
  shift
done

ALLOWLIST="$ROOT/scripts/check/no_direct_rt_allowlist.txt"
BASELINE_FILE="$ROOT/scripts/check/no_direct_rt_baseline.txt"
# Call-position matches only; a line whose first non-space char is '#' is a
# comment and never a call site (measured false positive: js/builtins/date.spl).
RT_RE='^[^#]*\brt_[a-z0-9_]*\('

# scan_dir <dir> <allowlist-file> [offender-output]
# stdout: "scanned direct allowed forbidden" counts.
scan_dir() {
  sd_root="$1"; sd_allow="$2"; sd_off="${3:-}"
  sd_scanned=0; sd_allowed=0; sd_forbidden=0
  if ! command -v rg >/dev/null 2>&1; then
    echo "ERR"
    return
  fi
  sd_scan_root="$sd_root"
  if [ -d "$sd_root/src" ]; then sd_scan_root="$sd_root/src"; fi
  # Build and compare NUL-delimited manifests before scanning. This proves the
  # fast rg traversal sees the exact find-defined file set; hidden/ignored files
  # cannot disappear, and either traversal fails closed instead of looking empty.
  tmp_scan=$(mktemp -d) || { echo "ERR"; return; }
  tmp_find_raw="$tmp_scan/find.raw"
  tmp_rg_raw="$tmp_scan/rg.raw"
  tmp_find="$tmp_scan/find.sorted"
  tmp_rg="$tmp_scan/rg.sorted"
  tmp_matches="$tmp_scan/matches"
  if ! find "$sd_scan_root" -name '*.spl' -type f ! -path '*/vendor/*' -print0 > "$tmp_find_raw"; then
    rm -f "$tmp_find_raw" "$tmp_rg_raw" "$tmp_find" "$tmp_rg" "$tmp_matches"; rmdir "$tmp_scan"
    echo "ERR"
    return
  fi
  rg --files --null --no-ignore --hidden --glob '*.spl' --glob '!**/vendor/**' "$sd_scan_root" > "$tmp_rg_raw"
  st=$?
  # `rg --files` uses 1 for an empty but successful traversal.
  if [ $st -gt 1 ]; then
    rm -f "$tmp_find_raw" "$tmp_rg_raw" "$tmp_find" "$tmp_rg" "$tmp_matches"; rmdir "$tmp_scan"
    echo "ERR"
    return
  fi
  if ! LC_ALL=C sort -z "$tmp_find_raw" > "$tmp_find" || ! LC_ALL=C sort -z "$tmp_rg_raw" > "$tmp_rg" || ! cmp -s "$tmp_find" "$tmp_rg"; then
    rm -f "$tmp_find_raw" "$tmp_rg_raw" "$tmp_find" "$tmp_rg" "$tmp_matches"; rmdir "$tmp_scan"
    echo "ERR"
    return
  fi
  if ! sd_scanned=$(awk 'BEGIN { RS = "\0" } END { print NR + 0 }' "$tmp_find"); then
    rm -f "$tmp_find_raw" "$tmp_rg_raw" "$tmp_find" "$tmp_rg" "$tmp_matches"; rmdir "$tmp_scan"
    echo "ERR"
    return
  fi
  rg --count --no-ignore --hidden --glob '*.spl' --glob '!**/vendor/**' "$RT_RE" "$sd_scan_root" > "$tmp_matches"
  st=$?
  # rg exit 1 means no matches; >1 is a scanner error.
  if [ $st -gt 1 ]; then
    rm -f "$tmp_find_raw" "$tmp_rg_raw" "$tmp_find" "$tmp_rg" "$tmp_matches"; rmdir "$tmp_scan"
    echo "ERR"
    return
  fi
  while IFS=: read -r f n; do
    [ -n "$f" ] || continue
    case "$f" in
      "$sd_root"/*) rel=${f#"$sd_root"/} ;;
      ./*) rel=${f#./} ;;
      *) rel=$f ;;
    esac
    allowed=0
    if [ -f "$sd_allow" ]; then
      while IFS= read -r pre; do
        case "$pre" in ''|'#'*) continue ;; esac
        case "$pre" in suffix:*) sfx=${pre#suffix:}; case "$rel" in *"$sfx") allowed=1; break ;; esac ;; *) case "$rel" in "$pre"*) allowed=1; break ;; esac ;; esac
      done < "$sd_allow"
    fi
    if [ $allowed -eq 1 ]; then
      sd_allowed=$((sd_allowed + n))
    else
      sd_forbidden=$((sd_forbidden + n))
      if [ -n "$sd_off" ]; then echo "$n $rel" >> "$sd_off"; fi
    fi
  done < "$tmp_matches"
  rm -f "$tmp_find_raw" "$tmp_rg_raw" "$tmp_find" "$tmp_rg" "$tmp_matches"
  rmdir "$tmp_scan"
  echo "$sd_scanned $((sd_allowed + sd_forbidden)) $sd_allowed $sd_forbidden"
}

# ---- selftest (runs first, always, fatal) ----
selftest() {
  st_dir=$(mktemp -d)
  # fixture 1: forbidden direct call
  mkdir -p "$st_dir/a/src/lib/x"
  printf 'fn f():\n    y = rt_memcpy(a, b, n)\n' > "$st_dir/a/src/lib/x/bad.spl"
  r=$(scan_dir "$st_dir/a" /dev/null)
  set -- $r
  if [ "${4:-x}" != "1" ]; then echo "ERROR — selftest failed: forbidden call not counted (got '$r')"; rm -rf "$st_dir"; exit 2; fi
  # fixture 2: allowlisted provider call
  mkdir -p "$st_dir/b/src/lib/allowed"
  printf 'fn f():\n    y = rt_memcpy(a, b, n)\n' > "$st_dir/b/src/lib/allowed/prov.spl"
  printf 'src/lib/allowed/\n' > "$st_dir/allow.txt"
  r=$(scan_dir "$st_dir/b" "$st_dir/allow.txt")
  set -- $r
  if [ "${3:-x}" != "1" ] || [ "${4:-x}" != "0" ]; then echo "ERROR — selftest failed: provider call not classified allowed (got '$r')"; rm -rf "$st_dir"; exit 2; fi
  # fixture 2b: suffix-match provider (file named *_sffi.spl anywhere)
  mkdir -p "$st_dir/b2/src/lib/deep/gpu"
  printf 'fn f():\n    y = rt_memcpy(a, b, n)\n' > "$st_dir/b2/src/lib/deep/gpu/window_sffi.spl"
  printf 'suffix:_sffi.spl\n' > "$st_dir/allow2.txt"
  r=$(scan_dir "$st_dir/b2" "$st_dir/allow2.txt")
  set -- $r
  if [ "${3:-x}" != "1" ] || [ "${4:-x}" != "0" ]; then echo "ERROR — selftest failed: suffix provider not classified allowed (got '$r')"; rm -rf "$st_dir"; exit 2; fi
  # fixture 3: empty tree must yield 0 scanned (caller turns that into ERROR)
  mkdir -p "$st_dir/c"
  r=$(scan_dir "$st_dir/c" /dev/null)
  set -- $r
  if [ "${1:-x}" != "0" ]; then echo "ERROR — selftest failed: empty tree scanned nonzero (got '$r')"; rm -rf "$st_dir"; exit 2; fi
  # fixture 4: explicit manifest includes hidden and gitignored source files
  mkdir -p "$st_dir/d/src/lib/.hidden" "$st_dir/d/src/lib/ignored"
  printf 'src/lib/ignored/\n' > "$st_dir/d/.gitignore"
  printf 'fn f(): rt_hidden_call()\n' > "$st_dir/d/src/lib/.hidden/hidden.spl"
  printf 'fn f(): rt_ignored_call()\n' > "$st_dir/d/src/lib/ignored/ignored.spl"
  r=$(scan_dir "$st_dir/d" /dev/null)
  set -- $r
  if [ "${1:-x}" != "2" ] || [ "${2:-x}" != "2" ] || [ "${4:-x}" != "2" ]; then echo "ERROR — selftest failed: hidden/ignored files not scanned equivalently (got '$r')"; rm -rf "$st_dir"; exit 2; fi
  # fixture 5: traversal failure is an error, never an empty successful scan
  r=$(scan_dir "$st_dir/missing" /dev/null 2>/dev/null)
  if [ "$r" != "ERR" ]; then echo "ERROR — selftest failed: find error did not fail closed (got '$r')"; rm -rf "$st_dir"; exit 2; fi
  rm -rf "$st_dir"
}

selftest
if [ $SELFTEST_ONLY -eq 1 ]; then
  echo "PASS — 6 selftest fixture(s) checked"
  exit 0
fi

# ---- real scan ----
if [ ! -d "$ROOT/src" ]; then echo "ERROR — nothing was checked: no src/ under $ROOT"; exit 2; fi
OFF_FILE="$(mktemp).off"
: > "$OFF_FILE"
counts=$(scan_dir "$ROOT" "$ALLOWLIST" "$OFF_FILE")
set -- $counts
if [ "${1:-ERR}" = "ERR" ] || [ $# -ne 4 ]; then
  rm -f "$OFF_FILE"
  echo "ERROR — nothing was checked: direct runtime scan failed"
  exit 2
fi
scanned=$1
direct_total=$2
allowed=$3
forbidden=$4

if [ $((allowed + forbidden)) -ne "$direct_total" ]; then
  rm -f "$OFF_FILE"
  echo "ERROR — count arithmetic does not balance"
  exit 2
fi

echo "rt_boundary:"
echo "  scanner_ran: true"
echo "  scanned_files: $scanned"
echo "  direct_total: $direct_total"
echo "  allowed_provider: $allowed"
echo "  forbidden_product: $forbidden"

if [ "$scanned" -eq 0 ]; then rm -f "$OFF_FILE"; echo "ERROR — nothing was checked"; exit 2; fi

# ---- critical mode: phase-A error, no ratchet grace ----
if [ $CRITICAL -eq 1 ] && [ "$forbidden" -gt 0 ]; then
  top=$(sort -rn "$OFF_FILE" | head -5 | awk '{printf "%s:%s ", $2, $1}')
  rm -f "$OFF_FILE"
  echo "fix: route through the std.* semantic API, or a sanctioned provider alias (see scripts/check/no_direct_rt_allowlist.txt)."
  echo "FAIL — critical mode: $forbidden forbidden direct rt_* call site(s), 0 allowed; top offenders: $top"
  exit 1
fi

# ---- baseline ratchet ----
if [ ! -f "$BASELINE_FILE" ]; then
  echo "$forbidden" > "$BASELINE_FILE"
  rm -f "$OFF_FILE"
  echo "PASS — $scanned file(s) scanned, forbidden=$forbidden (baseline recorded)"
  exit 0
fi
baseline=$(head -1 "$BASELINE_FILE" | tr -cd '0-9')
if [ -z "$baseline" ]; then rm -f "$OFF_FILE"; echo "ERROR — baseline file unreadable: $BASELINE_FILE"; exit 2; fi

if [ "$forbidden" -gt "$baseline" ]; then
  top=$(sort -rn "$OFF_FILE" | head -5 | awk '{printf "%s:%s ", $2, $1}')
  rm -f "$OFF_FILE"
  # Fix-it guidance printed BEFORE the verdict — the verdict must stay the
  # last stdout line per the check-script contract.
  echo "fix: route through the std.* semantic API (e.g. std.io.file.read_text, std.nogc_sync_mut.compression.gzip.crc32_text),"
  echo "     or — for a genuine runtime primitive — import a sanctioned provider alias:"
  echo "         use runtime.primitive.{rt_memcpy as _memory_copy_primitive}   # provider dirs only, see scripts/check/no_direct_rt_allowlist.txt"
  echo "     Never add a new 'extern fn rt_*' to product code. Process: doc/03_plan/infra/binary_runtime_hardening/plan.md"
  echo "FAIL — forbidden direct rt_* count $forbidden exceeds baseline $baseline; top offenders: $top"
  exit 1
fi
if [ "$forbidden" -lt "$baseline" ]; then
  echo "$forbidden" > "$BASELINE_FILE"
fi
rm -f "$OFF_FILE"
echo "PASS — $scanned file(s) scanned, forbidden=$forbidden (baseline $baseline)"
exit 0
