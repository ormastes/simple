#!/bin/sh
# check-main-test-runnable-push.shs — the committed tree must still be able to run a test.
#
# WHY THIS EXISTS
# ---------------
# Incident 2026-08-25
# (doc/08_tracking/bug/origin_main_not_test_runnable_env_access_host_parse_2026-08-25.md):
# a fresh worktree of origin/main could not run `bin/simple test` AT ALL. Any spec, and
# even the trivial test/fixtures/doctest/green.md, aborted with
#
#     error: compile failed: parse: in ".../src/app/io/env_access_host.spl":
#            function arguments: expected Comma, found Pub
#
# because the closing paren of a multi-line call had been moved past the next `pub fn` to
# EOF. Every pre-push guard passed. They all check TREE STRUCTURE or RUST:
# conflict-tree entries, conflict-marker text, file counts, test-tree diffs, rt_* symbol
# sets, C that parses under -fsyntax-only, and `cargo check` on src/compiler_rust. Not one
# of them loads a `.spl` with the Simple compiler, so a `.spl` syntax regression anywhere on
# the compiler's startup path lands green and only surfaces when a human runs `test` against
# committed content -- which, because everyone works in a tree that differs from main,
# happened days later.
#
# WHAT THIS GUARD PROVES, AND WHAT IT DOES NOT
# --------------------------------------------
# Known limit, stated rather than papered over: this is NOT a whole-tree `.spl` parse guard.
# A trivial doctest run opens ~82 stdlib sources (measured by strace, see
# .claude/rules/commands.md), not the ~14k `.spl` in the tree. So the invariant is
# "the committed tree is test-runnable", not "every committed `.spl` parses". That is
# strictly weaker -- a syntax error in a module nothing loads at startup still gets through.
# It is also exactly the invariant the incident broke, and the one whose failure invalidates
# every other session's test evidence, so it is worth its own guard. The script is named for
# what it checks. A full parse sweep would need a parse-only entry point over every
# committed `.spl`; that is a separate, much more expensive guard and is not this one.
#
# WHY A TEST RUN AND NOT `simple lint`
# ------------------------------------
# lint costs ~12s of fixed startup plus a superlinear per-declaration cost that makes large
# compiler files exceed any practical budget (.claude/rules/commands.md has the measured
# table). Running it over the tree is not affordable on every push. One trivial doctest pays
# the compiler's startup path once -- which is the code path the incident broke -- and
# measured 69s on this (loaded) host.
#
# THE FAIL-OPEN THIS GUARD HAS TO AVOID
# ------------------------------------
# A `simple` binary can silently resolve `src/lib` from a DIFFERENT worktree: a nested `.git`
# under the tree made the seed read the stdlib from an unrelated deploy tree (5009 opens),
# so a run "against" tree A was really exercising tree B. Under that failure every run here
# would be vacuously green forever. Two things defend against it: the guard runs the binary
# with the isolated worktree as cwd and asserts the fixture it feeds is the one in that
# worktree, and -- load-bearing -- selftest fixture C2 re-injects the incident's exact paren
# bug into the worktree's own env_access_host.spl and REQUIRES a FAIL whose detail NAMES the
# parse error. If stdlib resolution ever escapes the tree under test, C2 goes green and the
# selftest, which is fatal, stops the run. Matching the DETAIL rather than merely a non-zero
# status is what makes C2 real: on the first cut it "passed" for the wrong reason -- the
# worktree had no bin/simple, so it would have failed with or without the injected bug. C1
# now requires the same clean worktree to run green first, so C2 cannot be vacuous.
#
# MECHANISM
#   * materialise the NEW tip with `git worktree add --detach` -- never the shared, contested
#     working copy, whose content disagrees with committed content under concurrent load
#   * provision `<tree>/bin/simple` -- the doctest runner spawns a CHILD compiler and looks
#     there; that symlink is gitignored, so a fresh worktree lacks it
#   * run `$SIMPLE_BIN test test/fixtures/doctest/green.md` inside it, under `timeout`
#   * the exit status is read DIRECTLY into a variable on the line after the invocation,
#     never through a pipe: a pipeline's $? is the last command's status and has produced
#     false greens in this repo before
#   * fast path: a content-keyed green marker (git tree ids of src/app + src/lib + the
#     fixture), same positive-proof pattern as check-seed-builds-push.shs -- skip only when
#     THIS EXACT CONTENT has already been recorded green by a real run of this guard. Keyed
#     on content, not commit, because shas churn constantly under rebase. Deleting the marker
#     dir is always safe and merely forces a re-run.
#
# VERDICT (last line of stdout), same convention as the other pre-push guards:
#   PASS  — <n> ...                 exit 0
#   FAIL  — ...                     exit 1
#   ERROR — nothing was checked ... exit 2
# Non-vacuity is absolute: a missing or non-executable `simple`, a missing fixture, or a
# worktree that cannot be materialised is ERROR, never a pass. Absence of a binary to run is
# absence of evidence.
#
# USAGE
#   sh scripts/check/check-main-test-runnable-push.shs            # default range main@origin..@-
#   sh scripts/check/check-main-test-runnable-push.shs --rev SHA  # check one explicit commit
#   sh scripts/check/check-main-test-runnable-push.shs --selftest # fixtures only
#   SIMPLE_BIN=... MAIN_RUNNABLE_MARKER_DIR=... TEST_TIMEOUT=...  # overrides

set -u

SELF=$(basename "$0")
# /mnt/data exists only on the Linux CI hosts; on macOS this path is
# uncreatable, exactly the failure that made the seed-build push guard FAIL
# from a mac. Same resolution order as that guard.
_main_runnable_scratch_base() {
    if [ -d /mnt/data ] && [ -w /mnt/data ]; then echo /mnt/data; return; fi
    if [ -n "${SIMPLE_USER_STORAGE_ROOT:-}" ]; then echo "$SIMPLE_USER_STORAGE_ROOT"; return; fi
    echo "${TMPDIR:-/tmp}"
}
MARKER_DIR=${MAIN_RUNNABLE_MARKER_DIR:-$(_main_runnable_scratch_base)/.main-test-runnable-green}
TEST_TIMEOUT=${TEST_TIMEOUT:-900}
FIXTURE=test/fixtures/doctest/green.md
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)

err() { echo "$SELF: ERROR — nothing was checked ($1)"; exit 2; }

marker_path() { echo "$MARKER_DIR/$1"; }

record_green() {
    mkdir -p "$MARKER_DIR" 2>/dev/null || return 1
    date -u '+%Y-%m-%dT%H:%M:%SZ' >"$(marker_path "$1")" 2>/dev/null
}

# Digest of exactly what a startup-path test run reads: the two source trees the compiler
# loads plus the fixture it executes. A change anywhere in them invalidates the marker.
content_digest() {
    _rev=$1 _root=$2
    _a=$(git -C "$_root" rev-parse "$_rev:src/app" 2>/dev/null) || return 1
    _l=$(git -C "$_root" rev-parse "$_rev:src/lib" 2>/dev/null) || return 1
    _f=$(git -C "$_root" rev-parse "$_rev:$FIXTURE" 2>/dev/null) || return 1
    printf 'app=%s;lib=%s;fixture=%s;v1' "$_a" "$_l" "$_f" | sha256sum | cut -c1-32
}

# Run the fixture inside DIR with BIN. Echoes "ok" / "fail:<detail>".
# The status is captured on its own line, never through a pipe.
run_fixture_in() {
    _dir=$1 _bin=$2
    [ -f "$_dir/$FIXTURE" ] || { echo "fail:fixture missing in tree under test"; return; }
    # The doctest runner SPAWNS a child compiler and finds it at <tree>/bin/simple. That path
    # is a gitignored symlink, so a freshly materialised worktree does not have it and every
    # block dies with "Process failed to start or returned an internal error" -- a guard
    # artifact that looks exactly like a tree defect. (It misread origin/main as broken once
    # already.) Provision it, pointing at the same binary this guard is driving.
    mkdir -p "$_dir/bin" 2>/dev/null
    # Never relink when the tree under test IS the tree the driving binary lives in:
    # `readlink -f` of a regular-file wrapper is that same path, so the ln would point
    # bin/simple at itself and every later exec dies with ELOOP ("Too many levels of
    # symbolic links"). That destroys the deployed CLI of whoever ran the push, and the
    # selftest then reports the damage as a tree defect. Compare resolved paths first.
    _want=$(readlink -f "$_bin" 2>/dev/null)
    _have=$(readlink -f "$_dir/bin/simple" 2>/dev/null)
    [ -n "$_want" ] && [ "$_have" = "$_want" ] || ln -sf "$_want" "$_dir/bin/simple" 2>/dev/null
    _out=$(cd "$_dir" && timeout "$TEST_TIMEOUT" "$_bin" test "$FIXTURE" 2>&1)
    _rc=$?
    if [ "$_rc" -eq 0 ]; then
        echo "ok"
    elif [ "$_rc" -eq 124 ]; then
        echo "fail:timed out after ${TEST_TIMEOUT}s"
    else
        # Prefer a real top-level `error:` line. The looser pattern alone picked up
        # `[jit-fallback] ... error:` noise, which names a demotion rather than the cause.
        _first=$(echo "$_out" | grep -m1 -E '^error' | cut -c1-200)
        [ -n "$_first" ] || _first=$(echo "$_out" | grep -m1 -E '^(error|.*error:)' | cut -c1-200)
        [ -n "$_first" ] || _first=$(echo "$_out" | tail -1 | cut -c1-200)
        echo "fail:rc=$_rc: $_first"
    fi
}

# ---------------------------------------------------------------- selftest
# Fatal. Six fixtures, all real worktrees exercised by the real runner above -- no mocked
# verdicts. It runs before any real scan, but is itself content-keyed on (this script + the
# binary it drives): two ~70s fixture invocations on every push would swamp the marker fast
# path and make this the slowest guard in the set. Editing either input re-runs it in full,
# and --selftest always does.
selftest() {
    _st_root=$(mktemp -d) || { echo "SELFTEST FAIL: mktemp"; return 1; }
    _st_fail=0

    # A -- report whether the working tree can run the fixture. NOT fatal: this used to require
    # a green, which meant a genuinely broken tree disabled the guard instead of letting it
    # report the breakage. Anti-vacuity now rests on B (a missing fixture must fail) and on C1/C2
    # being a DIFFERENTIAL, neither of which needs the tree to be healthy.
    if [ "$(run_fixture_in "$REPO_ROOT" "$SIMPLE_BIN")" != "ok" ]; then
        echo "$SELF: note — the working tree does not currently run the fixture; selftest continues (verdicts come from materialised worktrees, not this tree)" >&2
    fi

    # B -- missing fixture must FAIL, not silently succeed
    _b="$_st_root/b"; mkdir -p "$_b"
    case "$(run_fixture_in "$_b" "$SIMPLE_BIN")" in
        fail:*) : ;;
        *) echo "SELFTEST FAIL: B — a tree with no fixture did not fail" >&2; _st_fail=1 ;;
    esac

    # C -- LOAD-BEARING. Replay the incident: copy the tree, re-inject the exact paren bug
    #      into src/app/io/env_access_host.spl, and require a FAIL. This proves both that the
    #      guard detects the incident's shape AND that the binary reads the stdlib/app sources
    #      from the tree under test rather than from some other worktree.
# Materialised the same way the real scan materialises its tree -- `git worktree add`, not
    # `cp -a`. Copying src/ drags in src/compiler_rust/target (gigabytes of build output, some
    # of it read-only) and took ~7 minutes; the worktree carries tracked content only.
    # The revision is resolved rather than assumed: this repo is jj-colocated, so git HEAD is
    # routinely behind the tree everyone works in, and HEAD did not carry the incident file at
    # all. Pick the first revision that actually has it; if none does, that is a SELFTEST FAIL,
    # never a skip -- a guard whose incident replay cannot run is a guard with no evidence.
    _c="$_st_root/c"
    _c_rev=""
    for _r in HEAD origin/main main@origin; do
        if git -C "$REPO_ROOT" cat-file -e "$_r:src/app/io/env_access_host.spl" 2>/dev/null; then
            _c_rev=$_r; break
        fi
    done
    if [ -z "$_c_rev" ]; then
        echo "SELFTEST FAIL: C — src/app/io/env_access_host.spl exists in no known revision; the incident cannot be replayed" >&2
        _st_fail=1
    elif git -C "$REPO_ROOT" worktree add --detach "$_c" "$_c_rev" >/dev/null 2>&1; then
        _victim="$_c/src/app/io/env_access_host.spl"
        if [ -f "$_victim" ]; then
            # C1 -- record how the SAME freshly materialised worktree behaves BEFORE injection.
            # C2 below is a DIFFERENTIAL against this, not an absolute "must be green" check.
            # An absolute check was tried first and was wrong: when main is genuinely red for an
            # unrelated reason (measured 2026-08-26, `unknown decorator @always_inline` on the
            # startup path), it turned this guard into "selftest failed" and suppressed the real
            # FAIL it was built to report -- a guard that stops working exactly when the tree is
            # broken is worse than no guard. The differential still refuses to be vacuous: if the
            # clean run ALREADY fails with a parse diagnostic, injection proves nothing and that
            # is an honest SELFTEST FAIL.
            _c_clean=$(run_fixture_in "$_c" "$SIMPLE_BIN")
            case "$_c_clean" in
                *parse*|*Comma*|*env_access_host*)
                    echo "SELFTEST FAIL: C1 — the clean worktree already fails with a parse diagnostic ($_c_clean), so injecting one proves nothing" >&2
                    _st_fail=1 ;;
            esac
            # C2 -- now inject the incident's exact shape (a call whose closing paren never
            # arrives, so the parser meets the next `pub fn`) and require a FAIL that NAMES the
            # parse error. Matching the detail, not merely the non-zero status, is what keeps
            # this fixture honest.
            printf '\npub fn _selftest_unclosed_call_marker():\n    return some_call(\n        1, 2\n' >>"$_victim"
            _c_verdict=$(run_fixture_in "$_c" "$SIMPLE_BIN")
            case "$_c_verdict" in
                *parse*|*Comma*|*env_access_host*) : ;;
                fail:*) echo "SELFTEST FAIL: C2 — failed, but not with a parse diagnostic (clean was: $_c_clean; injected: $_c_verdict)" >&2
                        _st_fail=1 ;;
                *) echo "SELFTEST FAIL: C2 — an unparseable env_access_host.spl still ran green; the binary is not reading the tree under test" >&2
                   _st_fail=1 ;;
            esac
        else
            echo "SELFTEST FAIL: C — env_access_host.spl not found; fixture cannot replay the incident" >&2
            _st_fail=1
        fi
        git -C "$REPO_ROOT" worktree remove --force "$_c" >/dev/null 2>&1
    else
        echo "SELFTEST FAIL: C — could not materialise a worktree to stage the incident" >&2
        _st_fail=1
    fi

    # D -- a fresh marker store must excuse nothing
    _d_markers="$_st_root/markers"; rm -rf "$_d_markers"; mkdir -p "$_d_markers"
    _d_dig=$(content_digest HEAD "$REPO_ROOT") || _d_dig=""
    if [ -z "$_d_dig" ]; then
        echo "SELFTEST FAIL: D — could not compute a content digest for HEAD" >&2
        _st_fail=1
    elif [ -f "$_d_markers/$_d_dig" ]; then
        echo "SELFTEST FAIL: D — a fresh marker store already claims this content is green" >&2
        _st_fail=1
    else
        # E -- and marker recording must be live, not dead code
        _saved=$MARKER_DIR; MARKER_DIR=$_d_markers
        record_green "$_d_dig"
        [ -f "$(marker_path "$_d_dig")" ] || {
            echo "SELFTEST FAIL: E — marker was not recorded; the fast path could never be taken" >&2
            _st_fail=1; }
        MARKER_DIR=$_saved
    fi

    # F -- binary resolution must survive a linked worktree with no bin/ of its own. This is
    # the landing path (plumbing commit in a throwaway worktree), and the first version of this
    # guard ERRORed on it, blocking its own push. Asserts the fallback chain finds a binary
    # there; it does NOT assert a particular binary, only that resolution does not come up empty.
    _f=$_st_root/f
    if git -C "$REPO_ROOT" worktree add --detach "$_f" HEAD >/dev/null 2>&1; then
        rm -rf "$_f/bin"
        # Resolution is checked IN PROCESS. Re-invoking this script would recurse (its selftest
        # runs this fixture, which would invoke it again); a recursive pre-push probe has hung
        # this host before, so the fallback chain is exercised directly instead.
        _f_common=$(git -C "$_f" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
        _f_main=${_f_common%/.git}
        if [ ! -x "$_f/bin/simple" ] \
           && { [ -z "$_f_common" ] || [ "$_f_main" = "$_f_common" ] || [ ! -x "$_f_main/bin/simple" ]; } \
           && ! command -v simple >/dev/null 2>&1; then
            echo "SELFTEST FAIL: F — a linked worktree with no bin/simple resolves no binary; this guard would block every worktree landing" >&2
            _st_fail=1
        fi
        git -C "$REPO_ROOT" worktree remove --force "$_f" >/dev/null 2>&1
    fi

    rm -rf "$_st_root"
    return $_st_fail
}

# ---------------------------------------------------------------- main
[ -n "$REPO_ROOT" ] || err "not inside a git repository"

# Resolving the binary must survive a LINKED WORKTREE, because that is the normal landing
# path here: commits are built in a throwaway `git worktree add` off a fresh origin tip, and
# such a tree has no bin/simple -- that symlink is gitignored and exists only in the main
# checkout. Defaulting to $REPO_ROOT/bin/simple made this guard ERROR on every worktree push,
# i.e. it blocked exactly the workflow it ships in (caught by its own first landing). Try, in
# order: an explicit override, this tree, the MAIN worktree of the same repo, then PATH.
# Finding none is still ERROR -- absence of a binary is absence of evidence, never a pass.
if [ -n "${SIMPLE_BIN:-}" ]; then
    :
else
    SIMPLE_BIN=$REPO_ROOT/bin/simple
    if [ ! -x "$SIMPLE_BIN" ]; then
        _common=$(git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
        _main_root=${_common%/.git}
        if [ -n "$_common" ] && [ "$_main_root" != "$_common" ] && [ -x "$_main_root/bin/simple" ]; then
            SIMPLE_BIN=$_main_root/bin/simple
        elif command -v simple >/dev/null 2>&1; then
            SIMPLE_BIN=$(command -v simple)
        fi
    fi
fi
[ -x "$SIMPLE_BIN" ] || err "no executable simple binary (tried \$SIMPLE_BIN, $REPO_ROOT/bin/simple, the main worktree, and PATH)"
[ -f "$REPO_ROOT/$FIXTURE" ] || err "fixture $FIXTURE not present in this checkout"

REV=""
SELFTEST_ONLY=0
while [ $# -gt 0 ]; do
    case "$1" in
        --rev) REV=${2:-}; shift 2 || err "--rev needs a revision" ;;
        --selftest) SELFTEST_ONLY=1; shift ;;
        *) err "unknown argument: $1" ;;
    esac
done

# The selftest runs two real fixture invocations (~70s each), which would swamp the marker
# fast path and make this guard the slowest thing on every push. Its outcome depends on
# exactly two inputs -- this script and the binary it drives -- so it gets the same
# content-keyed positive proof: skip only when THIS script and THIS binary have already
# passed it. Any edit to either re-runs it. --selftest always runs it for real.
selftest_digest() {
    { sha256sum "$0"; sha256sum "$SIMPLE_BIN"; } 2>/dev/null | sha256sum | cut -c1-32
}
ST_DIGEST=$(selftest_digest)
ST_MARKER="$MARKER_DIR/selftest-$ST_DIGEST"
if [ "$SELFTEST_ONLY" -eq 1 ] || [ -z "$ST_DIGEST" ] || [ ! -f "$ST_MARKER" ]; then
    selftest || { echo "$SELF: FAIL — selftest failed; no scan was run"; exit 1; }
    [ -n "$ST_DIGEST" ] && { mkdir -p "$MARKER_DIR" 2>/dev/null; date -u '+%Y-%m-%dT%H:%M:%SZ' >"$ST_MARKER" 2>/dev/null; }
fi
if [ "$SELFTEST_ONLY" -eq 1 ]; then
    echo "$SELF: PASS — 7 selftest fixture(s) checked, scan not requested"
    exit 0
fi

if [ -z "$REV" ]; then
    REV=$(git -C "$REPO_ROOT" rev-parse '@-' 2>/dev/null) \
        || REV=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null) \
        || err "could not resolve a revision to check"
fi
TIP=$(git -C "$REPO_ROOT" rev-parse "$REV" 2>/dev/null) || err "cannot resolve revision $REV"

DIGEST=$(content_digest "$TIP" "$REPO_ROOT") || err "cannot read src/app, src/lib or $FIXTURE at $TIP"

if [ -f "$(marker_path "$DIGEST")" ]; then
    echo "$SELF: PASS — 1 fixture invocation skipped, startup-path content $DIGEST at $TIP byte-identical to a tree this guard already ran green ($(cat "$(marker_path "$DIGEST")" 2>/dev/null))"
    exit 0
fi

WT=$(mktemp -d) || err "cannot create a temp dir for the isolated worktree"
cleanup() { git -C "$REPO_ROOT" worktree remove --force "$WT/tree" >/dev/null 2>&1; rm -rf "$WT"; }
trap cleanup EXIT
git -C "$REPO_ROOT" worktree add --detach "$WT/tree" "$TIP" >/dev/null 2>&1 \
    || err "could not materialise $TIP into an isolated worktree"

RESULT=$(run_fixture_in "$WT/tree" "$SIMPLE_BIN")
case "$RESULT" in
    ok)
        record_green "$DIGEST"
        echo "$SELF: PASS — 1 fixture invocation executed at $TIP, tree is test-runnable (startup-path content $DIGEST recorded green)"
        exit 0 ;;
    fail:*)
        echo "$SELF: FAIL — 1 fixture invocation executed at $TIP, tree is NOT test-runnable: ${RESULT#fail:}"
        exit 1 ;;
    *)
        err "the fixture runner produced no verdict" ;;
esac
