#!/bin/sh
# check-total-enum-match-traps.shs
#
# Pins the 2026-08-24 fix: a TOTAL enum match (every variant named, no
# default/wildcard arm) must TRAP at runtime when the scrutinee's discriminant
# matches no arm, instead of falling through to the `const 0` placeholder.
#
# Before the fix the fall-through yielded 0, and the zero flowed onward as a
# valid-looking pointer -- the `Poll<T>.unwrap` mis-bind cost a full lane-day
# in exactly that shape. See
# doc/08_tracking/bug/total_enum_match_fallthrough_zeroes_2026-08-24.md
#
# Two halves, both required:
#   SOURCE half  -- the lowering site still carries the trap, with all four
#                   narrowing gates intact. A source half alone cannot prove
#                   the emitted binary traps, but it is fast and catches a
#                   silent revert.
#   BUILD half   -- optional (SIMPLE_MATCH_TRAP_BUILD=1): actually native-build
#                   a fixture that reaches the fall-through via rt_enum_new
#                   with an out-of-range discriminant, run it, and require a
#                   non-zero exit whose output names the enum. Run under
#                   `timeout`; rc=124 is a distinct HANG failure, never a pass.
#
# Verdict is the LAST line of stdout:
#   PASS — <n> check(s) performed, ...       exit 0   (n is always > 0)
#   FAIL — ...                               exit 1
#   ERROR — nothing was checked (<reason>)   exit 2
# A run that performed 0 checks is ERROR, never a pass.
#
# --selftest runs FIRST and is FATAL.

set -u

SITE="src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl"
CHECKED=0
FAILED=""
BUILD_TIMEOUT="${SIMPLE_MATCH_TRAP_BUILD_TIMEOUT:-2400}"
RUN_TIMEOUT="${SIMPLE_MATCH_TRAP_RUN_TIMEOUT:-120}"

find_root() {
    d="$(pwd)"
    while [ "$d" != "/" ]; do
        if [ -f "$d/$SITE" ]; then printf '%s\n' "$d"; return 0; fi
        d="$(dirname "$d")"
    done
    return 1
}

# The four gate tokens that make the trap sound. Losing ANY of them either
# disarms the trap or makes it fire on valid values -- both are regressions.
GATE_TOKENS="total_match_trap_ok
all_discs_resolved
any_guarded
enum_bare_name_collisions
terminate_abort
rt_panic"

scan_source() {
    _f="$1"
    _miss=""
    for tok in $GATE_TOKENS; do
        if ! grep -q "$tok" "$_f" 2>/dev/null; then
            _miss="$_miss $tok"
        fi
    done
    # The trap must sit inside the no-default branch and must terminate with
    # Abort, not merely warn.
    if ! grep -q 'b_ft.terminate_abort(tmsg)' "$_f" 2>/dev/null; then
        _miss="$_miss terminate_abort-call"
    fi
    printf '%s' "$_miss"
}

selftest() {
    st_tmp="$(mktemp -d)" || { echo "selftest: mktemp failed"; return 1; }
    st_rc=0

    # Fixture 1: a file carrying every gate token must scan clean.
    {
        for t in $GATE_TOKENS; do echo "token $t"; done
        echo "                    b_ft.terminate_abort(tmsg)"
    } > "$st_tmp/good.spl"
    r="$(scan_source "$st_tmp/good.spl")"
    if [ -n "$r" ]; then echo "selftest FAIL: clean fixture reported missing:$r"; st_rc=1; fi

    # Fixture 2: the pre-fix shape (no trap at all) must be detected.
    echo "self.error(fmsg, Some(scrutinee.span))" > "$st_tmp/prefix.spl"
    r="$(scan_source "$st_tmp/prefix.spl")"
    if [ -z "$r" ]; then echo "selftest FAIL: pre-fix fixture scanned clean"; st_rc=1; fi

    # Fixture 3: trap present but a GATE removed (the soundness regression:
    # would fire on valid values) must be detected.
    {
        for t in $GATE_TOKENS; do
            [ "$t" = "any_guarded" ] && continue
            echo "token $t"
        done
        echo "                    b_ft.terminate_abort(tmsg)"
    } > "$st_tmp/ungated.spl"
    r="$(scan_source "$st_tmp/ungated.spl")"
    case "$r" in
        *any_guarded*) : ;;
        *) echo "selftest FAIL: missing guard gate not detected (got '$r')"; st_rc=1 ;;
    esac

    # Fixture 4: warn text kept but terminate_abort call deleted (a silent
    # disarm that leaves the tokens behind) must be detected.
    {
        for t in $GATE_TOKENS; do echo "token $t"; done
    } > "$st_tmp/disarmed.spl"
    r="$(scan_source "$st_tmp/disarmed.spl")"
    case "$r" in
        *terminate_abort-call*) : ;;
        *) echo "selftest FAIL: disarmed fixture not detected (got '$r')"; st_rc=1 ;;
    esac

    # Fixture 5: a missing file must not scan clean.
    r="$(scan_source "$st_tmp/does-not-exist.spl")"
    if [ -z "$r" ]; then echo "selftest FAIL: missing file scanned clean"; st_rc=1; fi

    rm -rf "$st_tmp"
    return $st_rc
}

if ! selftest; then
    echo "ERROR — nothing was checked (selftest failed)"
    exit 2
fi

if [ "${1:-}" = "--selftest" ]; then
    echo "PASS — 5 check(s) performed, selftest fixtures all behaved as specified"
    exit 0
fi

ROOT="$(find_root)"
if [ -z "${ROOT:-}" ]; then
    echo "ERROR — nothing was checked (repo root not found: $SITE missing)"
    exit 2
fi

# ---- SOURCE half ----
MISS="$(scan_source "$ROOT/$SITE")"
CHECKED=$((CHECKED + 1))
if [ -n "$MISS" ]; then
    FAILED="$FAILED source-half(missing:$MISS)"
fi

# ---- BUILD half (opt-in) ----
BUILD_NOTE="build half skipped (set SIMPLE_MATCH_TRAP_BUILD=1 to enable)"
if [ "${SIMPLE_MATCH_TRAP_BUILD:-0}" = "1" ]; then
    SIMPLE_BIN="${SIMPLE_MATCH_TRAP_BIN:-$ROOT/bin/simple}"
    if [ ! -x "$SIMPLE_BIN" ]; then
        echo "ERROR — nothing was checked (build half requested but compiler not executable: $SIMPLE_BIN)"
        exit 2
    fi
    bt_tmp="$(mktemp -d)" || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
    mkdir -p "$ROOT/.match-trap-fixture"
    cat > "$ROOT/.match-trap-fixture/fixture.spl" <<'FEOF'
enum TrapProbe:
    Alpha
    Beta

extern fn rt_enum_new(enum_id: i64, discriminant: i64, payload: i64) -> TrapProbe

fn classify(s: TrapProbe) -> i64:
    match s:
        case TrapProbe.Alpha:
            return 10
        case TrapProbe.Beta:
            return 20

fn main():
    print("good=" + classify(TrapProbe.Alpha).to_text())
    print("bogus=" + classify(rt_enum_new(4242, 99, 0)).to_text())
    print("SURVIVED-FALLTHROUGH")
FEOF
    ( cd "$ROOT" && timeout "$BUILD_TIMEOUT" "$SIMPLE_BIN" native-build \
        .match-trap-fixture/fixture.spl -o "$bt_tmp/fixture" ) > "$bt_tmp/build.log" 2>&1
    BRC=$?
    CHECKED=$((CHECKED + 1))
    if [ "$BRC" = "124" ]; then
        FAILED="$FAILED build-half(HANG: native-build exceeded ${BUILD_TIMEOUT}s)"
    elif [ "$BRC" != "0" ]; then
        FAILED="$FAILED build-half(native-build rc=$BRC)"
    elif [ ! -x "$bt_tmp/fixture" ]; then
        FAILED="$FAILED build-half(no executable produced)"
    else
        timeout "$RUN_TIMEOUT" "$bt_tmp/fixture" > "$bt_tmp/run.log" 2>&1
        RRC=$?
        CHECKED=$((CHECKED + 1))
        if [ "$RRC" = "124" ]; then
            FAILED="$FAILED run-half(HANG: fixture exceeded ${RUN_TIMEOUT}s)"
        elif [ "$RRC" = "0" ]; then
            FAILED="$FAILED run-half(fixture exited 0 -- fall-through did NOT trap)"
        elif grep -q 'SURVIVED-FALLTHROUGH' "$bt_tmp/run.log" 2>/dev/null; then
            FAILED="$FAILED run-half(execution continued past the fall-through)"
        elif ! grep -q 'TrapProbe' "$bt_tmp/run.log" 2>/dev/null; then
            FAILED="$FAILED run-half(trap fired but did not name the enum)"
        else
            BUILD_NOTE="build half: fixture trapped rc=$RRC naming 'TrapProbe'"
        fi
    fi
    rm -rf "$bt_tmp" "$ROOT/.match-trap-fixture"
fi

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked (no checks performed)"
    exit 2
fi

if [ -n "$FAILED" ]; then
    echo "FAIL — $CHECKED check(s) performed, offender(s):$FAILED"
    exit 1
fi

echo "PASS — $CHECKED check(s) performed, total-enum-match trap intact at $SITE; $BUILD_NOTE"
exit 0
