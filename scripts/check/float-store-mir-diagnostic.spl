use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_serialization.{serialize_mir_module}
use compiler.mir._MirLowering.module_lowering.*

fn main():
    val source = """
struct ScoreBoard:
    scores: [f64]
    matched: [i64]

fn contribution(x: f64) -> f64:
    x * 0.5 + 0.25

fn empty_board(n: i64) -> ScoreBoard:
    var scores: [f64] = []
    var matched: [i64] = []
    var i = 0
    while i < n:
        scores.push(0.0)
        matched.push(0)
        i = i + 1
    ScoreBoard(scores: scores, matched: matched)

fn main() -> i64:
    var board = empty_board(2)
    var scores = board.scores
    var matched = board.matched
    for i in [0, 1]:
        scores[i] = scores[i] + contribution(1.0)
        matched[i] = matched[i] + 1
    if scores[0] != 0.75 or scores[1] != 0.75:
        return 1
    if matched[0] != 1 or matched[1] != 1:
        return 2
    print "float indexed store readback PASS"
    return 0
"""
    val filename = "factory.spl"
    val module = parse_full_frontend(source, filename, filename, Logger(level: 0))
    var hl = HirLowering.with_filename(filename)
    val hir = hl.lower_module(module)
    var ml = MirLowering.new(hir.symbols)
    print serialize_mir_module(ml.lower_module(hir))