#!/bin/sh
# Fail-closed native-board GPU evidence gate for SimpleOS.
# Not a proof of GPU acceleration; use this as a bounded dispatcher until
# board-specific runner scripts and physical media are implemented.
set -eu

BOARD=""
STRICT=0
SELF_TEST=0

print_help() {
  echo "Usage: sh scripts/check/check-simpleos-native-board-gpu-2d.shs --board <uno-q|visionfive2|up-squared-n4200> [--strict] [--self-test]"
}

emit_common_fields() {
  local board=$1
  local strict=$2

  if [ -n "$board" ]; then
    echo "simpleos_native_board_gpu_board=$board"
  else
    echo "simpleos_native_board_gpu_board=<missing>"
  fi
  echo "simpleos_native_board_gpu_strict=$strict"
}

emit_row() {
  local status=$1
  local reason=$2
  local board=$3
  local strict=$4
  local exit_code=$5

  echo "simpleos_native_board_gpu_status=$status"
  emit_common_fields "$board" "$strict"
  echo "simpleos_native_board_gpu_reason=$reason"
  echo "simpleos_native_board_gpu_exit_code=$exit_code"
}

board_status() {
  board=$1
  strict=$2

  if [ -z "$board" ]; then
    emit_row "fail" "missing-board" "$board" "$strict" "2"
    return 2
  fi

  case "$board" in
    uno-q|visionfive2|up-squared-n4200)
      if [ "$board" = "uno-q" ] && [ "${SIMPLEOS_UNOQ_BOARD_ATTACHED:-0}" != "1" ]; then
        emit_row "blocked" "board-not-connected" "$board" "$strict" "1"
      else
        emit_row "blocked" "runner-not-yet-implemented" "$board" "$strict" "1"
      fi
      return 1
      ;;
    *)
      emit_row "fail" "unsupported-board" "$board" "$strict" "2"
      return 2
      ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --board)
      shift
      if [ "$#" -eq 0 ]; then
        echo "Missing --board value" >&2
        exit 2
      fi
      BOARD="$1"
      ;;
    --strict)
      STRICT=1
      ;;
    --self-test)
      SELF_TEST=1
      ;;
    --help|-h)
      print_help
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
  shift
  [ "$#" -gt 0 ] || break
done

if [ "$SELF_TEST" = 1 ]; then
  echo "simpleos_native_board_gpu_self_test=pass"
  echo "simpleos_native_board_gpu_supported_boards=uno-q,visionfive2,up-squared-n4200"
  echo "simpleos_native_board_gpu_case=1"
  board_status "" "$STRICT"
  echo "simpleos_native_board_gpu_case=2"
  board_status "not-a-board" "$STRICT"
  echo "simpleos_native_board_gpu_case=3"
  board_status "uno-q" "0"
  echo "simpleos_native_board_gpu_case=4"
  board_status "visionfive2" "$STRICT"
  echo "simpleos_native_board_gpu_case=5"
  board_status "up-squared-n4200" "$STRICT"
  exit 0
fi

board_status "$BOARD" "$STRICT"
