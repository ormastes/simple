# codex-impl
# Validate one retained QEMU serial transcript and retain two compiler receipts.

use std.cli.cli_util (get_cli_args)
use std.nogc_sync_mut.io.file_ops.{file_read, file_write}
use os.sosix.qemu_evidence.guest_filesystem_receipt.{
    SOSIX_QEMU_GUEST_PASS,
    sosix_qemu_compiler_serial_status
}

fn main() -> i64:
    val args = get_cli_args()
    if args.len() != 11:
        print "usage: validate-sosix-qemu-compiler-serial <serial> <host> <guest> <nonce> <compiler> <version> <source> <executable> <stdout> <version-artifact> <hello-artifact>"
        return 2
    if args[9] == "" or args[10] == "" or args[9] == args[10]:
        print "blocked:compiler-artifact-path-invalid"
        return 1

    val serial = file_read(args[0])
    val status = sosix_qemu_compiler_serial_status(
        serial, args[1], args[2], args[3], args[4], args[5], args[6],
        args[7], args[8])
    if status != SOSIX_QEMU_GUEST_PASS:
        print status
        return 1

    val identity = "host=" + args[1] + " guest=" + args[2] + " nonce=" + args[3]
    val version_receipt = "SOSIX_QEMU_COMPILER_VERSION " + identity +
        " path=" + args[4] + " version=" + args[5] +
        " exit=0 target_native=true\n"
    val hello_lines = [
        "SOSIX_QEMU_HELLO_SOURCE " + identity + " path=" + args[6] +
        " source_nonce=" + args[3],
        "SOSIX_QEMU_HELLO_COMPILE BEGIN " + identity + " compiler=" + args[4] +
        " source=" + args[6] + " output=" + args[7],
        "SOSIX_QEMU_HELLO_COMPILE END " + identity + " output=" + args[7] +
        " exit=0 target_native=true",
        "SOSIX_QEMU_PROGRAM BEGIN " + identity + " path=" + args[7],
        "SOSIX_QEMU_PROGRAM_STDOUT " + identity + " text=" + args[8],
        "SOSIX_QEMU_PROGRAM END " + identity + " exit=0 target_native=true"
    ]
    var hello_receipt = ""
    for line in hello_lines:
        if not serial.contains(line):
            print "blocked:compiler-artifact-transcript-mismatch"
            return 1
        hello_receipt = hello_receipt + line + "\n"
    if not serial.contains(version_receipt.trim()):
        print "blocked:compiler-artifact-transcript-mismatch"
        return 1
    if not file_write(args[9], version_receipt) or not file_write(args[10], hello_receipt):
        print "blocked:compiler-artifact-write-failed"
        return 1
    print SOSIX_QEMU_GUEST_PASS
    0
