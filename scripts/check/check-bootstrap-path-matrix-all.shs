#!/bin/sh
# check-bootstrap-path-matrix-all.shs
#
# Runs all three extensible superset `--path-check` bootstrap suites:
#   1. check-bootstrap-path-matrix-unix.shs
#   2. check-bootstrap-path-matrix-windows.shs
#   3. check-bootstrap-path-matrix-simpleos.shs
#
# Verdict (last stdout line):
#   PASS — bootstrap path-alive matrix verified (<N> suites)  exit 0
#   FAIL — bootstrap path-alive matrix failed (<F>/<N>)       exit 1
#   ERROR — nothing was checked (<reason>)                    exit 2

set -u

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P) || {
  echo "ERROR — nothing was checked (cannot locate script directory)"
  exit 2
}

FAST_ARG=""
ROOT_DIR=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --fast) FAST_ARG="--fast"; shift ;;
    --root)
      [ "$#" -ge 2 ] || { echo "ERROR — nothing was checked (--root requires a directory)"; exit 2; }
      ROOT_DIR=$2; shift 2 ;;
    --root=*) ROOT_DIR=${1#*=}; shift ;;
    --help|-h)
      echo "usage: sh scripts/check/check-bootstrap-path-matrix-all.shs [--fast] [--root DIR]"
      exit 0 ;;
    *)
      echo "ERROR — nothing was checked (unknown option '$1')"
      exit 2 ;;
  esac
done

SUITES=0
FAILS=0

for _suite in \
  "$HERE/check-bootstrap-path-matrix-unix.shs" \
  "$HERE/check-bootstrap-path-matrix-windows.shs" \
  "$HERE/check-bootstrap-path-matrix-simpleos.shs"; do
  if [ ! -f "$_suite" ]; then
    echo "ERROR — nothing was checked (missing suite $_suite)"
    exit 2
  fi
  SUITES=$((SUITES + 1))
  set --
  [ -n "$FAST_ARG" ] && set -- "$@" "$FAST_ARG"
  [ -n "$ROOT_DIR" ] && set -- "$@" "--root" "$ROOT_DIR"
  if ! sh "$_suite" "$@"; then
    FAILS=$((FAILS + 1))
  fi
done

if [ "$SUITES" -eq 0 ]; then
  echo "ERROR — nothing was checked (0 suites executed)"
  exit 2
fi

if [ "$FAILS" -gt 0 ]; then
  echo "FAIL — bootstrap path-alive matrix failed ($FAILS/$SUITES suites failed)"
  exit 1
fi

echo "PASS — bootstrap path-alive matrix verified ($SUITES suites)"
exit 0
