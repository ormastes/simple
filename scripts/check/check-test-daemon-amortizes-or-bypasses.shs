#!/bin/sh
# check-test-daemon-amortizes-or-bypasses.shs
#
# DETECTION GUARD for a defect CLASS, not one bug:
#
#   "a long-lived request server that spawns a FRESH child per request
#    amortizes nothing, so a client must never join its queue unconditionally."
#
# Background (measured 2026-08-17, structural — module counts, not wall clock):
# `src/app/test_daemon/light_daemon.spl` handles each request by spawning
# `<binary> run src/app/test_runner_new/test_runner_single.spl <spec> ...`.
# strace -f -e trace=openat over the same spec counted 78 distinct src/**.spl
# modules opened by that worker child versus 77 for the direct
# `simple test <spec> --no-session-daemon` lane. Amortization factor 1.0: the
# daemon saves nothing. Meanwhile its main loop drains the request FIFO with a
# SINGLE worker that blocks for the served spec's entire budget (600s cap), and
# the lane directory is process-global and shared across concurrent sessions.
# Net effect: pure added head-of-line latency, and a WARM daemon measuring
# slower than a cold one because "warm" means "queue is not empty".
#
# A wall-clock assertion would be worthless on a contended host, so this guard
# is STRUCTURAL. It reads source only; it starts no daemon and runs no spec.
#
# Invariant enforced:
#   IF the daemon serves a request by spawning a child process
#   THEN the client must (a) compute the queue depth and (b) feed a bypass
#        derived from it into the daemon/direct decision.
#
# If someone later makes the daemon genuinely warm (serving in-process, no
# per-request child spawn), the antecedent stops holding and the guard reports
# PASS on the amortizing branch — it does not force the bypass to exist forever.
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> invariant(s) checked, ...            exit 0
#   FAIL  — ...                                      exit 1
#   ERROR — nothing was checked                      exit 2
#
# Fail-closed: a missing file, an unreadable file, or zero checks is ERROR,
# never a pass. `--selftest` runs before every scan and is fatal.

set -u

DAEMON_REL="src/app/test_daemon/light_daemon.spl"
CLIENT_REL="src/app/test_runner_new/test_runner_client.spl"
POLICY_REL="src/app/test_runner_new/daemon_backlog.spl"

# ---------------------------------------------------------------------------
# Predicates. Each takes a ROOT and answers about the files under it.
# ---------------------------------------------------------------------------

# True when the daemon spawns a child process to serve a request.
daemon_spawns_child_per_request() {
    _f="$1/$DAEMON_REL"
    [ -r "$_f" ] || return 2
    grep -q 'process_run_bounded' "$_f"
}

# True when the client reads the daemon's pending-request queue depth.
client_measures_queue_depth() {
    _f="$1/$CLIENT_REL"
    [ -r "$_f" ] || return 2
    grep -q 'daemon_queue_depth' "$_f"
}

# True when a queue-depth-derived bypass actually reaches the daemon/direct
# decision. Checking only that the helper EXISTS would pass a dead function,
# which is exactly how `interface_digest_of` sat uncalled in this repo; so the
# decision line itself must name the bypass.
client_wires_backlog_bypass() {
    _f="$1/$CLIENT_REL"
    [ -r "$_f" ] || return 2
    grep -q 'val daemon_ok' "$_f" || return 1
    grep 'val daemon_ok' "$_f" | grep -q 'backlog_bypass'
}

# True when the bypass decision lives in an importable module, so a unit spec
# can pin it. test_runner_client.spl has a bare `fn main` and cannot be
# imported by a spec, so a policy buried in it is untestable by construction.
policy_is_importable() {
    _f="$1/$POLICY_REL"
    [ -r "$_f" ] || return 1
    grep -q 'fn daemon_backlog_bypass' "$_f"
}

# ---------------------------------------------------------------------------
# Scan one root. Prints findings; sets EV_CHECKED / EV_FAILED.
# ---------------------------------------------------------------------------
scan_root() {
    _root="$1"
    EV_CHECKED=0
    EV_FAILED=0
    EV_DETAIL=""

    if [ ! -r "$_root/$DAEMON_REL" ]; then
        EV_MISSING="$DAEMON_REL"
        return 0
    fi
    if [ ! -r "$_root/$CLIENT_REL" ]; then
        EV_MISSING="$CLIENT_REL"
        return 0
    fi
    EV_MISSING=""

    daemon_spawns_child_per_request "$_root"
    _spawns=$?
    EV_CHECKED=$((EV_CHECKED + 1))

    if [ "$_spawns" -ne 0 ]; then
        # Antecedent does not hold: the daemon does not fork per request, so it
        # may genuinely be amortizing. Nothing further is required.
        EV_DETAIL="daemon does not spawn a child per request (amortizing lane)"
        return 0
    fi

    client_measures_queue_depth "$_root"
    _depth=$?
    EV_CHECKED=$((EV_CHECKED + 1))
    if [ "$_depth" -ne 0 ]; then
        EV_FAILED=$((EV_FAILED + 1))
        EV_DETAIL="$EV_DETAIL client never measures the daemon queue depth;"
    fi

    client_wires_backlog_bypass "$_root"
    _wired=$?
    EV_CHECKED=$((EV_CHECKED + 1))
    if [ "$_wired" -ne 0 ]; then
        EV_FAILED=$((EV_FAILED + 1))
        EV_DETAIL="$EV_DETAIL backlog bypass not wired into the daemon/direct decision;"
    fi

    policy_is_importable "$_root"
    _import=$?
    EV_CHECKED=$((EV_CHECKED + 1))
    if [ "$_import" -ne 0 ]; then
        EV_FAILED=$((EV_FAILED + 1))
        EV_DETAIL="$EV_DETAIL bypass policy is not in an importable module (no unit spec can pin it);"
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Selftest. Fatal, runs before every scan.
# ---------------------------------------------------------------------------
selftest() {
    _tmp="${TMPDIR:-/tmp}/daemon-amortize-selftest.$$"
    rm -rf "$_tmp"
    _fail=0

    _mk() { # root, daemon-body, client-body, policy?
        mkdir -p "$1/src/app/test_daemon" "$1/src/app/test_runner_new"
        printf '%s\n' "$2" > "$1/$DAEMON_REL"
        printf '%s\n' "$3" > "$1/$CLIENT_REL"
        if [ -n "${4:-}" ]; then printf '%s\n' "$4" > "$1/$POLICY_REL"; fi
    }

    _expect() { # label, expected_failed_nonzero(0|1), root
        scan_root "$3"
        if [ "$EV_CHECKED" -eq 0 ] && [ -z "$EV_MISSING" ]; then
            echo "selftest: $1: fixture checked 0 invariants"; _fail=1; return
        fi
        if [ "$2" -eq 1 ] && [ "$EV_FAILED" -eq 0 ]; then
            echo "selftest: $1: expected FAIL, got clean"; _fail=1
        fi
        if [ "$2" -eq 0 ] && [ "$EV_FAILED" -ne 0 ]; then
            echo "selftest: $1: expected clean, got $EV_FAILED failure(s):$EV_DETAIL"; _fail=1
        fi
    }

    _GOOD_CLIENT='fn daemon_queue_depth() -> i64: 0
    val daemon_ok = if cov_bypass or backlog_bypass: false else: ensure_daemon()'
    _POLICY='fn daemon_backlog_bypass(pending: i64) -> bool: pending >= 1'
    _FORK_DAEMON='val r = process_run_bounded(binary, args, ms, cap)'

    # 1. fully fixed tree must be clean
    _mk "$_tmp/f1" "$_FORK_DAEMON" "$_GOOD_CLIENT" "$_POLICY"
    _expect "fixed-tree-clean" 0 "$_tmp/f1"

    # 2. incident replay: forking daemon, client with no bypass at all
    _mk "$_tmp/f2" "$_FORK_DAEMON" 'val daemon_ok = if cov_bypass: false else: ensure_daemon()'
    _expect "incident-replay" 1 "$_tmp/f2"

    # 3. dead helper: depth measured + policy present but NOT wired into the decision
    _mk "$_tmp/f3" "$_FORK_DAEMON" 'fn daemon_queue_depth() -> i64: 0
    val daemon_ok = if cov_bypass: false else: ensure_daemon()' "$_POLICY"
    _expect "dead-helper-not-wired" 1 "$_tmp/f3"

    # 4. policy inlined in the un-importable client: wired, but no unit spec can pin it
    _mk "$_tmp/f4" "$_FORK_DAEMON" "$_GOOD_CLIENT"
    _expect "policy-not-importable" 1 "$_tmp/f4"

    # 5. amortizing daemon (no per-request child): bypass not required
    _mk "$_tmp/f5" 'serve_in_process(request)' 'val daemon_ok = ensure_daemon()'
    _expect "amortizing-daemon-exempt" 0 "$_tmp/f5"

    # 6. missing daemon file must yield 0 checks so the caller is forced to ERROR
    mkdir -p "$_tmp/f6"
    scan_root "$_tmp/f6"
    if [ "$EV_CHECKED" -ne 0 ]; then
        echo "selftest: missing-file: expected 0 checks, got $EV_CHECKED"; _fail=1
    fi

    rm -rf "$_tmp"
    if [ "$_fail" -ne 0 ]; then
        echo "ERROR — nothing was checked (selftest failed)"
        exit 2
    fi
}

# ---------------------------------------------------------------------------
ROOT="."
DO_SCAN=1
while [ $# -gt 0 ]; do
    case "$1" in
        --selftest) selftest; echo "selftest: 6 fixture(s) passed"; DO_SCAN=0; shift ;;
        --root) ROOT="$2"; shift 2 ;;
        *) echo "usage: $0 [--root DIR] [--selftest]" >&2; exit 2 ;;
    esac
done

if [ "$DO_SCAN" -eq 0 ]; then
    echo "PASS — 6 selftest fixture(s) checked, 0 failures"
    exit 0
fi

selftest

scan_root "$ROOT"

if [ -n "$EV_MISSING" ]; then
    echo "ERROR — nothing was checked (missing/unreadable $EV_MISSING under $ROOT)"
    exit 2
fi
if [ "$EV_CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi
if [ "$EV_FAILED" -ne 0 ]; then
    echo "FAIL — $EV_CHECKED invariant(s) checked, $EV_FAILED violated:$EV_DETAIL"
    exit 1
fi
echo "PASS — $EV_CHECKED invariant(s) checked, non-amortizing test daemon is bypassed under backlog"
exit 0
