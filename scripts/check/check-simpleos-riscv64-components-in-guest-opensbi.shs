#!/bin/sh
# check-simpleos-riscv64-components-in-guest-opensbi.shs
#
# Proves that four TOOLCHAIN COMPONENTS — the MCP server's tool dispatcher, a
# dev tool (the real linter), caret, and the test runner — actually RUN INSIDE
# SimpleOS on riscv64 and complete a real functional ROUND-TRIP each, printing
# their own results to the serial console.
#
# A PROCESS THAT STARTS AND PRINTS A BANNER IS NOT SANITY. Every row below is
# rung on the CONTENT of a response that real product code produced from an
# input this gate chose — never on a startup line, never on a bare "OK". The
# must-FAIL selftest fixtures are built by stripping exactly those content
# lines, so a banner-only serial log fails this gate.
#
# Boot is real OpenSBI v1.4 built as `fw_payload` with the guest Image embedded,
# handed to QEMU as `-bios` ONLY. NEVER QEMU `-kernel`, NEVER isa-debug-exit:
# fw_dynamic's next-stage address is populated by QEMU's `-kernel` machinery,
# which is exactly the banned pass semantics, whereas fw_payload is a real
# board-shipping configuration (how OpenSBI ships on flash on JH7110-class
# boards) — the FIRMWARE performs the S-mode handover to 0x80200000. The full
# rationale lives in check-simpleos-riscv64-opensbi-guest-boot.shs, whose
# firmware construction this gate reuses. The assembled QEMU argv is
# self-checked for both forbidden flags before the VM is started.
#
# COMPILER: the RUST SEED. The pure-Simple self-hosted compiler cannot compile
# anything in this tree yet, so this lane's artifact is seed-built and the
# verdict says so rather than implying self-hosting.
#
# HONEST SCOPE, stated rather than papered over:
#   * The component code runs in S-mode (kernel mode), linked into the guest
#     image — not as U-mode processes loaded off the guest's own filesystem.
#     Reaching that needs the full scheduler + ELF-loader closure, which is a
#     separate and much larger artifact.
#   * MCP is exercised at the tool-dispatch layer, not as a stdio JSON-RPC
#     server loop: the freestanding riscv64 runtime has no stdin. What is proven
#     is request -> real privilege + output-gate code -> real response envelope.
#   * The test-runner row runs the runner's result-evaluation core over a real
#     spec transcript; the guest does not fork a child `simple test` process,
#     because a freestanding S-mode image has no process model.
#   These are limits of scope, not of evidence: within that scope every row is
#   a real round-trip through unmodified product source.
#
# ROWS (serial log). Boot rungs B1-B3 are preconditions; each component row
# needs BOTH its evidence line and its OK marker.
#   B1  "OpenSBI v"                                            real firmware ran
#   B2  "[components] SimpleOS riscv64 in-guest toolchain"     firmware handed off
#   B3  "[components] serial up, exercising real product"      16550 console up
#
#   mcp       "[mcp] response {\"status\":\"ok\"" carrying MCP_RTT_PAYLOAD
#             AND "[mcp] response" carrying "unregistered_tool"
#             AND COMPONENT_MCP_SIMPLEOS_RISCV64_OK
#   devtool   "[devtool] finding:" (the real lint rule produced a real finding)
#             AND COMPONENT_DEVTOOL_SIMPLEOS_RISCV64_OK
#   caret     "[caret] extracted content=CARET_RTT_CONTENT"
#             AND "[caret] redacted:" NOT carrying AKIAIOSFODNN7EXAMPLE
#             AND "[caret] redacted:" carrying CARET_KEEPME
#             AND COMPONENT_CARET_SIMPLEOS_RISCV64_OK
#   testrun   "[testrun] parser reported passed=2"
#             AND "[testrun] parser reported failed=1"
#             AND COMPONENT_TESTRUN_SIMPLEOS_RISCV64_OK
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> component(s) checked, ...   exit 0
#   FAIL  — ...                             exit 1
#   ERROR — nothing was checked: ...        exit 2
# 0 components evaluated is an ERROR, never a PASS. Offline with no cached
# OpenSBI checkout is an ERROR, never a PASS. A boot rung that did not appear is
# an ERROR (nothing was checked), not a per-component FAIL — a guest that never
# reached the entry evaluated no component.
#
# `--selftest` (also run, fatally, before every real scan) proves the serial
# evaluator and the argv guard on fixtures.
#
# Env: SIMPLE_BIN (fresh seed), SKIP_KERNEL=1, BOOT_WAIT (120), OPENSBI_SRC.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT"

WORK=${WORK:-$ROOT/build/os/riscv64_components}
SERIAL=$WORK/serial.log
BOOT_WAIT=${BOOT_WAIT:-120}
OPENSBI_SRC=${OPENSBI_SRC:-$ROOT/build/os/rv64_opensbi_guest/opensbi-src}
OPENSBI_TAG=v1.4
OPENSBI_SHA=a2b255b88918715173942f2c5e1f97ac9e90c877  # v1.4 peeled commit, same pin as the sibling gates
SIMPLE_BIN=${SIMPLE_BIN:-$ROOT/src/compiler_rust/target/release/simple}

COMPONENTS='mcp devtool caret testrun'

# ---------------------------------------------------------------------------
# Serial-log evaluator. Pure function of a file: no VM, no network, no state.
# Used identically by the real scan and by every selftest fixture, so a fixture
# result is evidence about the code that judges the real run.
#
# Sets EV_CHECKED (components evaluated) and EV_BAD (space-separated offenders).
# EV_BOOT=0 means the guest never reached the entry -> caller must ERROR.
# ---------------------------------------------------------------------------
eval_serial() {
    _log=$1
    EV_CHECKED=0
    EV_BAD=
    EV_BOOT=0
    EV_REASON=

    if [ ! -f "$_log" ]; then
        EV_REASON="serial log $_log does not exist"
        return 0
    fi

    grep -q 'OpenSBI v' "$_log" || { EV_REASON="no OpenSBI banner — real firmware did not run"; return 0; }
    grep -q '\[components\] SimpleOS riscv64 in-guest toolchain' "$_log" \
        || { EV_REASON="firmware never handed off to the guest entry"; return 0; }
    grep -q '\[components\] serial up, exercising real product' "$_log" \
        || { EV_REASON="guest entry reached but the console never came up"; return 0; }
    EV_BOOT=1

    # --- mcp: a registered dispatch echoed the payload, an unregistered one was
    # refused. Both halves required so the row cannot pass by always agreeing.
    EV_CHECKED=$((EV_CHECKED + 1))
    _ok=1
    grep -q '\[mcp\] response .*"status":"ok"' "$_log" || _ok=0
    grep -q '\[mcp\] response .*MCP_RTT_PAYLOAD' "$_log" || _ok=0
    grep -q '\[mcp\] response .*unregistered_tool' "$_log" || _ok=0
    grep -q 'COMPONENT_MCP_SIMPLEOS_RISCV64_OK' "$_log" || _ok=0
    [ "$_ok" -eq 1 ] || EV_BAD="$EV_BAD mcp"

    # --- devtool: the real lint rule emitted a real finding.
    EV_CHECKED=$((EV_CHECKED + 1))
    _ok=1
    grep -q '\[devtool\] finding:' "$_log" || _ok=0
    grep -q 'COMPONENT_DEVTOOL_SIMPLEOS_RISCV64_OK' "$_log" || _ok=0
    [ "$_ok" -eq 1 ] || EV_BAD="$EV_BAD devtool"

    # --- caret: JSON round-trip survived AND the secret did not.
    EV_CHECKED=$((EV_CHECKED + 1))
    _ok=1
    grep -q '\[caret\] extracted content=CARET_RTT_CONTENT' "$_log" || _ok=0
    grep -q '\[caret\] redacted:.*CARET_KEEPME' "$_log" || _ok=0
    # The redaction line must NOT still carry the secret. A grep that FINDS it
    # is the failure, so the sense is inverted here on purpose.
    if grep '\[caret\] redacted:' "$_log" | grep -q 'AKIAIOSFODNN7EXAMPLE'; then
        _ok=0
    fi
    grep -q 'COMPONENT_CARET_SIMPLEOS_RISCV64_OK' "$_log" || _ok=0
    [ "$_ok" -eq 1 ] || EV_BAD="$EV_BAD caret"

    # --- testrun: the real parser produced the right counts.
    EV_CHECKED=$((EV_CHECKED + 1))
    _ok=1
    grep -q '\[testrun\] parser reported passed=2' "$_log" || _ok=0
    grep -q '\[testrun\] parser reported failed=1' "$_log" || _ok=0
    grep -q 'COMPONENT_TESTRUN_SIMPLEOS_RISCV64_OK' "$_log" || _ok=0
    [ "$_ok" -eq 1 ] || EV_BAD="$EV_BAD testrun"

    return 0
}

# ---------------------------------------------------------------------------
# Forbidden-flag guard, applied to the ACTUAL argv this gate will execute.
# Returns 1 when the argv is unacceptable.
# ---------------------------------------------------------------------------
argv_is_clean() {
    for _a in "$@"; do
        case "$_a" in
            -kernel|*isa-debug-exit*) return 1 ;;
        esac
    done
    return 0
}

# ---------------------------------------------------------------------------
# Selftest — fatal, runs before every real scan.
# ---------------------------------------------------------------------------
selftest() {
    _d=$(mktemp -d)
    _fail=0
    _n=0

    _good=$_d/good.log
    cat >"$_good" <<'EOF'
OpenSBI v1.4
[components] SimpleOS riscv64 in-guest toolchain components (OpenSBI fw_payload)
[components] serial up, exercising real product modules
[mcp] request  tool=echo args=[MCP_RTT_PAYLOAD]
[mcp] response {"status":"ok","body":"MCP_RTT_PAYLOAD"}
[mcp] response {"status":"error","code":"unregistered_tool","reason":"no handler for: no_such_tool_xyz"}
COMPONENT_MCP_SIMPLEOS_RISCV64_OK dispatch round-trip
[devtool] finding: module-level global initialised by a call
COMPONENT_DEVTOOL_SIMPLEOS_RISCV64_OK real lint rule ran in-guest
[caret] extracted content=CARET_RTT_CONTENT
[caret] redacted: key AKIA****MPLE trails CARET_KEEPME
COMPONENT_CARET_SIMPLEOS_RISCV64_OK message round-tripped
[testrun] parser reported passed=2
[testrun] parser reported failed=1
COMPONENT_TESTRUN_SIMPLEOS_RISCV64_OK real runner parser summarised
[components] all component rows exited rc=0
EOF

    # F1 must-PASS: a complete, honest log.
    _n=$((_n + 1))
    eval_serial "$_good"
    if [ "$EV_BOOT" -ne 1 ] || [ "$EV_CHECKED" -ne 4 ] || [ -n "$EV_BAD" ]; then
        printf 'selftest F1 (complete log must PASS) FAILED: boot=%s checked=%s bad=[%s] reason=%s\n' \
            "$EV_BOOT" "$EV_CHECKED" "$EV_BAD" "$EV_REASON" >&2
        _fail=1
    fi

    # F2 must-FAIL: BANNER ONLY. Every component evidence line stripped, boot
    # rungs and startup chatter kept. This is the exact vacuous-green shape the
    # gate exists to reject, so it is the most load-bearing fixture here.
    _n=$((_n + 1))
    grep -vE '^\[(mcp|devtool|caret|testrun)\]|^COMPONENT_' "$_good" >"$_d/banner.log"
    eval_serial "$_d/banner.log"
    _want='mcp devtool caret testrun'
    if [ "$EV_BOOT" -ne 1 ] || [ "$EV_CHECKED" -ne 4 ] || [ "$(echo $EV_BAD)" != "$_want" ]; then
        printf 'selftest F2 (banner-only must FAIL all 4) FAILED: boot=%s checked=%s bad=[%s]\n' \
            "$EV_BOOT" "$EV_CHECKED" "$EV_BAD" >&2
        _fail=1
    fi

    # F3 must-FAIL: the OK markers are all present but the mcp response no
    # longer carries the payload — a dispatcher that answers without doing the
    # work. Proves the row rings on CONTENT, not on the marker.
    _n=$((_n + 1))
    sed 's/"body":"MCP_RTT_PAYLOAD"/"body":""/' "$_good" | sed 's/args=\[MCP_RTT_PAYLOAD\]/args=[]/' >"$_d/hollow.log"
    eval_serial "$_d/hollow.log"
    if [ "$EV_CHECKED" -ne 4 ] || [ "$(echo $EV_BAD)" != "mcp" ]; then
        printf 'selftest F3 (marker present, payload lost -> mcp must FAIL) FAILED: checked=%s bad=[%s]\n' \
            "$EV_CHECKED" "$EV_BAD" >&2
        _fail=1
    fi

    # F4 must-FAIL: redaction did not happen — the secret survived on the
    # redaction line while every marker still says OK.
    _n=$((_n + 1))
    sed 's/key AKIA\*\*\*\*MPLE/key AKIAIOSFODNN7EXAMPLE/' "$_good" >"$_d/leak.log"
    eval_serial "$_d/leak.log"
    if [ "$EV_CHECKED" -ne 4 ] || [ "$(echo $EV_BAD)" != "caret" ]; then
        printf 'selftest F4 (secret survived -> caret must FAIL) FAILED: checked=%s bad=[%s]\n' \
            "$EV_CHECKED" "$EV_BAD" >&2
        _fail=1
    fi

    # F5 must-FAIL: wrong counts from the test-runner parser.
    _n=$((_n + 1))
    sed 's/passed=2/passed=0/' "$_good" >"$_d/counts.log"
    eval_serial "$_d/counts.log"
    if [ "$EV_CHECKED" -ne 4 ] || [ "$(echo $EV_BAD)" != "testrun" ]; then
        printf 'selftest F5 (wrong pass count -> testrun must FAIL) FAILED: checked=%s bad=[%s]\n' \
            "$EV_CHECKED" "$EV_BAD" >&2
        _fail=1
    fi

    # F6 must-ERROR: guest never reached the entry. 0 checked forces the caller
    # to ERROR rather than reporting four clean components.
    _n=$((_n + 1))
    printf 'OpenSBI v1.4\n' >"$_d/noboot.log"
    eval_serial "$_d/noboot.log"
    if [ "$EV_BOOT" -ne 0 ] || [ "$EV_CHECKED" -ne 0 ]; then
        printf 'selftest F6 (no guest handoff must yield 0 checked) FAILED: boot=%s checked=%s\n' \
            "$EV_BOOT" "$EV_CHECKED" >&2
        _fail=1
    fi

    # F7 must-ERROR: no firmware banner at all.
    _n=$((_n + 1))
    printf 'nothing here\n' >"$_d/nofw.log"
    eval_serial "$_d/nofw.log"
    if [ "$EV_BOOT" -ne 0 ] || [ "$EV_CHECKED" -ne 0 ]; then
        printf 'selftest F7 (no firmware banner must yield 0 checked) FAILED: boot=%s checked=%s\n' \
            "$EV_BOOT" "$EV_CHECKED" >&2
        _fail=1
    fi

    # F8/F9: the argv guard must reject both forbidden flags and accept a clean
    # fw_payload argv.
    _n=$((_n + 1))
    if argv_is_clean qemu-system-riscv64 -M virt -kernel /tmp/k.Image -nographic; then
        printf 'selftest F8 (argv guard must reject -kernel) FAILED\n' >&2
        _fail=1
    fi
    _n=$((_n + 1))
    if argv_is_clean qemu-system-riscv64 -M virt -device isa-debug-exit,iobase=0xf4 -nographic; then
        printf 'selftest F9 (argv guard must reject isa-debug-exit) FAILED\n' >&2
        _fail=1
    fi
    _n=$((_n + 1))
    if ! argv_is_clean qemu-system-riscv64 -M virt -bios /tmp/fw_payload.bin -nographic; then
        printf 'selftest F10 (clean fw_payload argv must be accepted) FAILED\n' >&2
        _fail=1
    fi

    rm -rf "$_d"
    if [ "$_fail" -ne 0 ]; then
        printf 'ERROR — nothing was checked: selftest failed (%s fixtures)\n' "$_n"
        exit 2
    fi
    printf 'selftest: %s fixture(s) passed\n' "$_n"
}

if [ "${1:-}" = "--selftest" ]; then
    selftest
    printf 'PASS — %s selftest fixture(s) checked, evaluator and argv guard behave\n' 10
    exit 0
fi

# Fatal selftest before any real work.
selftest

# ---------------------------------------------------------------------------
# Real scan.
# ---------------------------------------------------------------------------
err() { printf 'ERROR — nothing was checked: %s\n' "$*"; exit 2; }

mkdir -p "$WORK"

if [ "${SKIP_KERNEL:-0}" != "1" ]; then
    SIMPLE_BIN="$SIMPLE_BIN" OUT_DIR="$WORK" sh "$ROOT/scripts/os/build-simpleos-riscv64-components-kernel.shs" \
        || err "component kernel build failed (see $WORK/kernel-build.log)"
fi
[ -s "$WORK/kernel.Image" ] || err "no guest Image at $WORK/kernel.Image"

# --- OpenSBI v1.4 fw_payload, built exactly as the hello-world sibling does,
# including the same PINNED commit. Unpinned firmware is refused rather than
# built: "it booted under some OpenSBI" is not the claim being made.
command -v qemu-system-riscv64 >/dev/null 2>&1 \
    || err "qemu-system-riscv64 is not installed (absence of an emulator is absence of evidence, never a pass)"

CROSS=
for p in riscv64-linux-gnu- riscv64-unknown-elf-; do
    command -v "${p}gcc" >/dev/null 2>&1 && { CROSS=$p; break; }
done
[ -n "$CROSS" ] || err "no riscv64 cross-gcc on PATH to build OpenSBI"

if [ -d "$OPENSBI_SRC/.git" ]; then
    have=$(git -C "$OPENSBI_SRC" rev-parse HEAD 2>/dev/null || echo none)
    [ "$have" = "$OPENSBI_SHA" ] \
        || err "OpenSBI checkout $OPENSBI_SRC is at $have, not pinned $OPENSBI_SHA — refusing to build unpinned firmware"
else
    git clone --depth 1 --branch "$OPENSBI_TAG" \
        https://github.com/riscv-software-src/opensbi.git "$OPENSBI_SRC" >"$WORK/clone.log" 2>&1 \
        || err "no cached OpenSBI checkout and clone failed (offline?) — see $WORK/clone.log"
    have=$(git -C "$OPENSBI_SRC" rev-parse HEAD)
    [ "$have" = "$OPENSBI_SHA" ] || err "cloned OpenSBI $OPENSBI_TAG is $have, not pinned $OPENSBI_SHA"
fi

make -C "$OPENSBI_SRC" PLATFORM=generic CROSS_COMPILE="$CROSS" \
    FW_PAYLOAD=y FW_PAYLOAD_PATH="$WORK/kernel.Image" FW_PAYLOAD_OFFSET=0x200000 -j4 \
    >"$WORK/opensbi-build.log" 2>&1 \
    || { tail -20 "$WORK/opensbi-build.log" >&2; err "OpenSBI fw_payload build failed"; }
FW=$OPENSBI_SRC/build/platform/generic/firmware/fw_payload.bin
[ -s "$FW" ] || err "fw_payload.bin missing after build"

rm -f "$SERIAL"

# Assemble the argv FIRST, self-check it, and only then start the VM.
set -- qemu-system-riscv64 -no-user-config -machine virt -cpu rv64 -smp 1 -m 512M \
    -bios "$FW" -serial "file:$SERIAL" -display none -monitor none -net none -no-reboot
argv_is_clean "$@" || err "assembled QEMU argv contains a forbidden flag (-kernel / isa-debug-exit) — script bug, not an environment gap"

timeout "$BOOT_WAIT" "$@" >"$WORK/qemu.log" 2>&1 || true

eval_serial "$SERIAL"
if [ "$EV_BOOT" -ne 1 ] || [ "$EV_CHECKED" -eq 0 ]; then
    err "${EV_REASON:-guest produced no component evidence}; serial log: $SERIAL"
fi

LINES=$(wc -l <"$SERIAL" | tr -d ' ')
if [ -n "$EV_BAD" ]; then
    printf 'FAIL — %s component(s) checked in-guest on SimpleOS riscv64 under real OpenSBI firmware via -bios fw_payload, %s failed:%s; serial log: %s (%s lines)\n' \
        "$EV_CHECKED" "$(echo $EV_BAD | wc -w | tr -d ' ')" "$EV_BAD" "$SERIAL" "$LINES"
    exit 1
fi

printf 'PASS — %s component(s) checked (%s), each completed a real round-trip in-guest on SimpleOS riscv64 under real OpenSBI firmware via -bios fw_payload (no -kernel, no isa-debug-exit), compiled by the RUST SEED %s; %s serial line(s)\n' \
    "$EV_CHECKED" "$(echo $COMPONENTS | tr ' ' ',')" "$SIMPLE_BIN" "$LINES"
exit 0
