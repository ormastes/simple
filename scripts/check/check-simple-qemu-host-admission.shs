#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
admission=${repo_root}/scripts/qemu/simple-qemu-host-admission.shs
scratch=$(mktemp -d "${TMPDIR:-/tmp}/simple-qemu-host-admission-test.XXXXXX")
trap 'rm -rf -- "${scratch}"' EXIT HUP INT TERM

fail() {
    printf '%s\n' "simple_qemu_host_admission_contract=failed:$1" >&2
    exit 1
}

actual_host=$("${admission}" --qemu-binary /definitely/missing/qemu 2>/dev/null |
    sed -n 's/^detected_host=//p') || :
[ -n "${actual_host}" ] || fail actual-host

printf '%s\n' \
    '#!/bin/sh' \
    'if [ "${1:-}" = -accel ] && [ "${2:-}" = help ]; then' \
    "    printf '%s\\n' 'Accelerators supported in QEMU binary:' 'tcg' 'kvm'" \
    '    exit 0' \
    'fi' \
    'sed -n "1,2p" >/dev/null' \
    "printf '%s\\n' '{\"QMP\":{}}' '{\"return\":{}}' '{\"return\":{}}'" \
    >"${scratch}/fake-qemu"
chmod +x "${scratch}/fake-qemu"

out=$("${admission}" --host "${actual_host}" --accelerator tcg \
    --qemu-binary "${scratch}/fake-qemu" --probe-seconds 2) || fail admitted-run
printf '%s\n' "${out}" | grep -qx 'host_identity_status=pass' || fail host-pass
printf '%s\n' "${out}" | grep -qx 'accelerator_advertised_status=pass' || fail advertised-pass
printf '%s\n' "${out}" | grep -qx 'accelerator_probe_status=pass' || fail probe-pass
printf '%s\n' "${out}" | grep -qx 'accelerator_probe_reason=accelerator-executed' || fail probe-reason
printf '%s\n' "${out}" | grep -qx 'native_timing_applicable=false' || fail tcg-timing
printf '%s\n' "${out}" | grep -q '^simple_qemu_storage_root=' || fail storage-root

case "${actual_host}" in
    linux) false_host=macos ;;
    *) false_host=linux ;;
esac
set +e
mismatch=$("${admission}" --host "${false_host}" --accelerator tcg \
    --qemu-binary "${scratch}/fake-qemu" 2>/dev/null)
mismatch_rc=$?
set -e
[ "${mismatch_rc}" -eq 2 ] || fail mismatch-exit
printf '%s\n' "${mismatch}" | grep -qx 'host_identity_status=fail' || fail mismatch-status
printf '%s\n' "${mismatch}" | grep -qx 'accelerator_probe_status=skipped' || fail mismatch-no-probe

set +e
missing=$("${admission}" --host "${actual_host}" --accelerator hvf \
    --qemu-binary "${scratch}/fake-qemu" 2>/dev/null)
missing_rc=$?
set -e
[ "${missing_rc}" -eq 3 ] || fail unadvertised-exit
printf '%s\n' "${missing}" | grep -qx 'accelerator_advertised_status=fail' || fail unadvertised-status
printf '%s\n' "${missing}" | grep -qx 'accelerator_probe_status=skipped' || fail unadvertised-no-probe

printf '%s\n' 'simple_qemu_host_admission_contract=pass'
