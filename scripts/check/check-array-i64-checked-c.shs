#!/bin/sh
# Focused C counterpart for the Rust value::array_i64::tests contract.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
out=${ARRAY_I64_CHECK_OUT:-$(mktemp -d "${TMPDIR:-/tmp}/simple-array-i64.XXXXXX")}
mkdir -p "$out"
case $(uname -s) in
    Darwin) strip_flag=-Wl,-dead_strip; libs= ;;
    *) strip_flag=-Wl,--gc-sections; libs=-ldl ;;
esac
"${CC:-cc}" -std=gnu11 -O1 -ffunction-sections -fdata-sections \
    ${CFLAGS:-} -UNDEBUG -I"$root/src/runtime" -I"$root/src/runtime/platform" \
    "$root/src/runtime/test/rt_array_i64_checked_selfcheck.c" \
    "$root/src/runtime/runtime_native.c" "$strip_flag" $libs -lm -lpthread \
    -o "$out/check"
"$out/check"
