#!/bin/sh
# check-vacuous-specs.shs — fail-closed detector for non-discriminating specs.
#
# A "non-discriminating" (vacuous) spec is one that passes identically on broken
# and fixed code, so its green verdict certifies nothing. Four were found in a
# single day (try-operator, named-ctor, chunked-HTTP, LaTeX range); this script
# enumerates the family mechanically so the sweep is repeatable.
#
# SCOPE — Tier A only (syntactic, decidable without semantics):
#   V0 NO_ASSERT_FILE  file contains zero assertion calls
#   V1 ZERO_ASSERT     an `it` block whose body asserts nothing
#   V2 CONST_ASSERT    assertion whose subject is a literal, not a computed value
#   V3 TAUTOLOGY       expect(X).to_equal(X) — same expression both sides
#   V4 WEAK_CONTAIN    to_contain("<=3 chars") as a block's only assertion
#   V5 SHAPE_ONLY      block asserts only .len()/is_empty/truthiness, never content
#   V6 STUB_HELPER     block's only assertion routes to a fail("TODO") helper stub
#
# Tier B (inputs that never exercise the claimed failure mode: all-happy-path
# parser inputs, args supplied in declaration order when the bug is about order,
# exactly-divisible dimensions when the bug is about remainders) is NOT detected
# here and is manual by design — it requires knowing what the bug was. Three of
# the four seed cases were Tier B. See the bug doc for the manual checklist.
#
# FAIL-CLOSED: the run ERRORs (exit 2) rather than reporting a clean sweep when
# it cannot prove it actually examined the corpus. "0 candidates" with 0 files
# scanned is an ERROR, never a PASS. This repo has a documented history of sweep
# oracles failing open three ways (anchored regex without a multiline flag
# matching only line 1; a path filter missing the tree prefix reporting "0
# candidates"; a def-keyword collision) — --selftest guards all three.
#
# Usage:
#   sh scripts/check/check-vacuous-specs.shs [--selftest] [--root DIR]
#                                            [--expect-files N] [--tsv]
# Verdict is always the LAST line of stdout:
#   PASS  — <n> files scanned, <m> flagged   (exit 0)
#   FAIL  — ...                              (exit 1)
#   ERROR — nothing was checked              (exit 2)

set -u

ROOT=""
EXPECT_FILES=""
SELFTEST=0
TSV=0

while [ $# -gt 0 ]; do
    case "$1" in
        --selftest) SELFTEST=1 ;;
        --root) ROOT="${2:-}"; shift ;;
        --expect-files) EXPECT_FILES="${2:-}"; shift ;;
        --tsv) TSV=1 ;;
        *) echo "unknown argument: $1" >&2; echo "ERROR — nothing was checked"; exit 2 ;;
    esac
    shift
done

AWK_PROG='
# ---------------------------------------------------------------------------
# Lexical helpers
# ---------------------------------------------------------------------------

# Strip a trailing # comment that lies outside any string literal.
# Fast paths first: the char-by-char scan is only needed when a line has BOTH a
# "#" and a quote. Over a 150MB corpus the naive scan is the whole runtime.
function strip_comment(s,   i, c, q, out) {
    if (index(s, "#") == 0) return s
    if (index(s, "\"") == 0 && index(s, "'"'"'") == 0) { sub(/#.*$/, "", s); return s }
    q = ""
    out = ""
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (q != "") {
            out = out c
            if (c == "\\") { i++; out = out substr(s, i, 1); continue }
            if (c == q) q = ""
            continue
        }
        if (c == "\"" || c == "'"'"'") { q = c; out = out c; continue }
        if (c == "#") break
        out = out c
    }
    return out
}

function trim(s) { gsub(/^[ \t\r]+|[ \t\r]+$/, "", s); return s }
function indent_of(s,   m) { match(s, /^[ \t]*/); return RLENGTH }

function is_literal(s) {
    s = trim(s)
    if (s == "true" || s == "false" || s == "nil" || s == "none") return 1
    if (s ~ /^-?[0-9]+$/) return 1
    if (s ~ /^-?[0-9]*\.[0-9]+$/) return 1
    if (s ~ /^"[^"]*"$/) return 1
    if (s ~ /^\[[ \t]*\]$/) return 1
    return 0
}

# Extract the balanced argument starting just after an open paren at position p.
# Sets G_end to the index of the matching close paren. Quote- and escape-aware.
function balanced_arg(s, p,   depth, i, c, q, out) {
    depth = 1; q = ""; out = ""
    for (i = p; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (q != "") {
            out = out c
            if (c == "\\") { i++; out = out substr(s, i, 1); continue }
            if (c == q) q = ""
            continue
        }
        if (c == "\"" || c == "'"'"'") { q = c; out = out c; continue }
        if (c == "(") depth++
        if (c == ")") { depth--; if (depth == 0) { G_end = i; return out } }
        out = out c
    }
    G_end = 0
    return ""
}

function builtin_assert(s) {
    if (s ~ /(^|[^a-zA-Z0-9_])expect[ \t]*\(/) return 1
    if (s ~ /(^|[^a-zA-Z0-9_])assert[a-zA-Z0-9_]*[ \t]*\(/) return 1
    if (s ~ /(^|[^a-zA-Z0-9_])fail[ \t]*\(/) return 1
    if (s ~ /(^|[^a-zA-Z0-9_])should_[a-zA-Z0-9_]+[ \t]*\(/) return 1
    if (s ~ /(^|[^a-zA-Z0-9_])capture[ \t]*\(/) return 1
    if (s ~ /^[ \t]*assert[ \t]+[^ \t(]/) return 1
    # Paren-less statement form: `expect diagram_args.len() == 3`, and after a
    # match arm: `case nil: expect false`. `expect` is a registered builtin of
    # arity 1 (src/compiler/30.types/type_system/builtin_registry.spl:155) and
    # this form DOES assert — empirically confirmed: a spec containing only
    # `expect false` reports executed=2 passed=0 failed=2, exit 1. 33,564 uses
    # across 1,322 corpus files, so missing it made V1_ZERO_ASSERT fire falsely
    # on real assertions.
    if (s ~ /(^|[^a-zA-Z0-9_])expect[ \t]+[^ \t(=]/) return 1
    return 0
}

# Does this line call a local helper that was resolved to "ultimately asserts"?
function calls_assertfn(s,   nm) {
    for (nm in ASSERTFN) {
        if (s ~ ("(^|[^a-zA-Z0-9_])" nm "[ \t]*\\(")) return 1
    }
    return 0
}

function has_assert(s) {
    if (builtin_assert(s)) return 1
    if (calls_assertfn(s)) return 1
    return 0
}

# The expression whose truth the assertion observes: the argument of a local
# asserting helper (`check(<expr>)`) or of assert_true/assert_false. Returns ""
# when the line is not that shape.
function assert_subject(s,   nm, p, q, a) {
    for (nm in ASSERTFN) {
        p = match(s, ("(^|[^a-zA-Z0-9_])" nm "[ \t]*\\("))
        if (p == 0) continue
        q = index(substr(s, p), "(") + p - 1
        a = balanced_arg(s, q + 1)
        if (G_end == 0) continue
        return a
    }
    if (match(s, /(^|[^a-zA-Z0-9_])assert_(true|false)[ \t]*\(/)) {
        q = index(substr(s, RSTART), "(") + RSTART - 1
        a = balanced_arg(s, q + 1)
        if (G_end != 0) return a
    }
    # paren-less `expect <expr>` — the rest of the line is the subject
    if (match(s, /(^|[^a-zA-Z0-9_])expect[ \t]+[^ \t(=]/)) {
        a = substr(s, RSTART)
        sub(/^[^a-zA-Z]*expect[ \t]+/, "", a)
        return a
    }
    return ""
}

# Is the whole expression built ONLY from literals and operators — no variable,
# no call, nothing that could come from the code under test? e.g. `1 == 1`,
# `"a" == "a"`, `1 + 1 == 2`, `true`. Such an assertion cannot observe the
# system, so it passes identically on broken and fixed code.
function is_const_expr(s,   t) {
    t = s
    gsub(/"[^"]*"/, "", t)
    gsub(/[0-9]+(\.[0-9]+)?/, "", t)
    gsub(/(^|[^a-zA-Z0-9_])(true|false|nil|none|and|or|not)([^a-zA-Z0-9_]|$)/, " ", t)
    gsub(/(^|[^a-zA-Z0-9_])(true|false|nil|none|and|or|not)([^a-zA-Z0-9_]|$)/, " ", t)
    gsub(/[][ \t(){}+*\/%<>=!&|^~,.?:;-]/, "", t)
    return (t == "")
}

function flag(code, path, ln, detail) {
    key = code "\t" path "\t" ln "\t" detail
    FINDINGS[++NF_COUNT] = key
    BYCODE[code]++
}

# ---------------------------------------------------------------------------
# Per-file analysis
# ---------------------------------------------------------------------------
function process_file(   i, s, raw, ind, in_doc, n, itstart, itindent, itname,
                         body_assert, body_lines, j, code_lines,
                         a, b, p, q, rest, matcher, arg, weak, strong,
                         helper_only, hname, only_call, nassert_file,
                         cconst, nconst, cfirst, cline, has_ctrl, csub) {
    if (CUR == "") return
    FILES_SCANNED++

    # ---- pass 0: strip docstrings and comments into code_lines[] ----
    in_doc = 0
    for (i = 1; i <= NLINES; i++) {
        raw = LINES[i]
        s = raw
        # fast path: no docstring delimiter and not inside one
        if (!in_doc && index(s, "\"\"\"") == 0) { CODE[i] = strip_comment(s); continue }
        # triple-quoted docstring toggling (handles open+close on one line)
        while (match(s, /"""/)) {
            if (in_doc) { s = substr(s, RSTART + 3); in_doc = 0 }
            else {
                rest = substr(s, RSTART + 3)
                s = substr(s, 1, RSTART - 1)
                if (match(rest, /"""/)) { s = s substr(rest, RSTART + 3); continue }
                in_doc = 1
                break
            }
        }
        if (in_doc && !match(raw, /"""/)) s = ""
        CODE[i] = strip_comment(s)
    }

    # ---- collect local helper fns and classify them ----
    # Specs in this repo very commonly wrap the assertion in a local helper, e.g.
    #     fn check(condition: bool):
    #         expect(condition).to_equal(true)
    # 3,560 corpus files use a `check(`-style wrapper. Treating such a call as
    # "no assertion" produced ~12 false V1 hits per file. So: resolve local
    # helpers to whether they ultimately assert, and carry that through.
    delete STUBFN
    delete ASSERTFN
    delete FN_START
    delete FN_END
    for (i = 1; i <= NLINES; i++) {
        if (CODE[i] ~ /^[ \t]*fn[ \t]+[a-zA-Z_][a-zA-Z0-9_]*[ \t]*\(/) {
            hname = CODE[i]
            sub(/^[ \t]*fn[ \t]+/, "", hname)
            sub(/[ \t]*\(.*$/, "", hname)
            ind = indent_of(CODE[i])
            only_call = 1; n = 0
            for (j = i + 1; j <= NLINES; j++) {
                if (trim(CODE[j]) == "") continue
                if (indent_of(CODE[j]) <= ind) break
                n++
                if (CODE[j] !~ /(^|[^a-zA-Z0-9_])fail[ \t]*\(/) only_call = 0
            }
            FN_START[hname] = i + 1
            FN_END[hname] = j - 1
            if (n > 0 && only_call) STUBFN[hname] = 1
        }
    }
    # Two rounds so a helper that delegates to another helper still resolves.
    for (n = 0; n < 2; n++) {
        for (hname in FN_START) {
            if (hname in ASSERTFN) continue
            for (j = FN_START[hname]; j <= FN_END[hname]; j++) {
                if (builtin_assert(CODE[j]) || calls_assertfn(CODE[j])) {
                    ASSERTFN[hname] = 1
                    break
                }
            }
        }
    }
    # A pure fail("TODO") stub asserts, but only unconditionally-fails; it must
    # NOT count as a discriminating assertion for its callers.
    for (hname in STUBFN) delete ASSERTFN[hname]

    # ---- file-level: zero assertions anywhere ----
    nassert_file = 0
    for (i = 1; i <= NLINES; i++) if (has_assert(CODE[i])) nassert_file++
    if (nassert_file == 0) {
        flag("V0_NO_ASSERT_FILE", CUR, 1, "file contains zero assertion calls")
    }

    # ---- per-`it` block analysis ----
    for (i = 1; i <= NLINES; i++) {
        if (CODE[i] !~ /^[ \t]*it[ \t]+["]/) continue
        itindent = indent_of(CODE[i])
        itname = CODE[i]
        sub(/^[ \t]*it[ \t]+"/, "", itname)
        sub(/".*$/, "", itname)

        body_assert = 0; weak = 0; strong = 0; helper_only = 1
        cconst = 0; nconst = 0; cfirst = ""; cline = 0; has_ctrl = 0
        for (j = i + 1; j <= NLINES; j++) {
            if (trim(CODE[j]) == "") continue
            if (indent_of(CODE[j]) <= itindent) break
            s = CODE[j]
            if (s ~ /^[ \t]*(if|elif|else|while|for|match|loop|when|try)([ \t(:]|$)/) has_ctrl = 1
            if (!has_assert(s)) {
                # a bare call to a stub helper still counts as the block body
                continue
            }
            body_assert++

            # --- tautology / const-subject on expect(...) ---
            p = match(s, /(^|[^a-zA-Z0-9_])expect[ \t]*\(/)
            if (p > 0) {
                q = index(substr(s, p), "(") + p - 1
                a = balanced_arg(s, q + 1)
                if (G_end > 0) {
                    rest = substr(s, G_end + 1)
                    if (match(rest, /^\.[a-z_]+\(/)) {
                        matcher = substr(rest, 2, RLENGTH - 2)
                        b = balanced_arg(rest, RSTART + RLENGTH)
                        if (matcher == "to_equal" || matcher == "to_be") {
                            if (trim(a) == trim(b) && trim(a) != "") {
                                flag("V3_TAUTOLOGY", CUR, j, "it=" itname " | expect(" trim(a) ")." matcher "(<same>)")
                                strong = 0
                            } else if (is_literal(a) && is_literal(b)) {
                                # Literal-vs-DIFFERENT-literal, e.g.
                                # expect(false).to_equal(true), is a deliberate
                                # "must not reach here" guard. It always FAILS
                                # when executed, so it is not vacuous — it is
                                # either unreached or a genuine red. Not flagged.
                                nconst++
                            } else strong++
                        } else if (matcher == "to_be_true" || matcher == "to_be_false") {
                            if (is_literal(a))
                                flag("V2_CONST_ASSERT", CUR, j, "it=" itname " | expect(" trim(a) ")." matcher "()")
                            else if (trim(a) ~ /\.(len|length|size|count)\(\)|\.is_empty\(\)/) weak++
                            else strong++
                        } else if (matcher == "to_contain") {
                            arg = trim(b); gsub(/^"|"$/, "", arg)
                            if (length(arg) <= 3 && length(arg) > 0) {
                                flag("V4_WEAK_CONTAIN", CUR, j, "it=" itname " | to_contain(\"" arg "\") len=" length(arg))
                                weak++
                            } else strong++
                        } else if (matcher == "to_be_greater_than" || matcher == "to_be_less_than") {
                            if (trim(a) ~ /\.(len|length|size|count)\(\)/ && trim(b) == "0") weak++
                            else strong++
                        } else strong++
                    }
                }
            }
            # --- assert_true(true) / assert_false(false) family ---
            if (s ~ /assert_true[ \t]*\([ \t]*true[ \t]*\)/ || s ~ /assert_false[ \t]*\([ \t]*false[ \t]*\)/) {
                flag("V2_CONST_ASSERT", CUR, j, "it=" itname " | constant assert_true/false")
            }
            if (s ~ /^[ \t]*assert[ \t]+true[ \t]*$/) {
                flag("V2_CONST_ASSERT", CUR, j, "it=" itname " | bare `assert true`")
            }
            # --- constant-expression assertion subject ---
            # Counted here, reported once per block below, because a constant
            # assertion is only proof of vacuity when the block has no control
            # flow. `check(true)` inside `if x > 5: check(true) else: check(false)`
            # DOES discriminate (the else arm fails), so branch-coverage specs
            # must not be flagged. `check(1 == 1)` in a straight-line block
            # cannot discriminate anything.
            csub = assert_subject(s)
            if (csub != "" && is_const_expr(csub)) {
                cconst++
                if (cfirst == "") { cfirst = trim(csub); cline = j }
            } else if (csub != "") nconst++
        }

        if (body_assert == 0) {
            # does the body call a known stub helper? then it is a stub block
            hname = ""
            for (j = i + 1; j <= NLINES; j++) {
                if (trim(CODE[j]) == "") continue
                if (indent_of(CODE[j]) <= itindent) break
                s = trim(CODE[j])
                sub(/[ \t]*\(.*$/, "", s)
                if (s in STUBFN) { hname = s; break }
            }
            if (hname != "")
                flag("V6_STUB_HELPER", CUR, i, "it=" itname " | only assertion is stub helper " hname "()")
            else
                flag("V1_ZERO_ASSERT", CUR, i, "it=" itname " | block asserts nothing")
        } else if (cconst > 0 && nconst == 0 && strong == 0 && !has_ctrl) {
            flag("V2_CONST_ASSERT", CUR, cline, "it=" itname " | straight-line block, every assertion is a constant expression e.g. `" cfirst "`")
        } else if (weak > 0 && strong == 0) {
            flag("V5_SHAPE_ONLY", CUR, i, "it=" itname " | only shape/weak assertions (" weak "), no content assertion")
        }
    }
}

# ---------------------------------------------------------------------------
FNR == 1 {
    if (NR > 1) process_file()
    CUR = FILENAME
    NLINES = 0
    delete LINES
    delete CODE
}
{ LINES[++NLINES] = $0 }
END {
    process_file()
    for (i = 1; i <= NF_COUNT; i++) print FINDINGS[i]
    printf("#SCANNED\t%d\n", FILES_SCANNED)
}
'

# ---------------------------------------------------------------------------
# Selftest: four fixtures covering this repo'"'"'s three documented fail-open modes.
# ---------------------------------------------------------------------------
run_selftest() {
    st_dir=$(mktemp -d 2>/dev/null) || { echo "ERROR — nothing was checked"; exit 2; }
    trap 'rm -rf "$st_dir"' EXIT

    # F1 known-vacuous: constant assertion. MUST flag.
    mkdir -p "$st_dir/f1"
    cat > "$st_dir/f1/vacuous_spec.spl" <<'EOF'
use std.spec.*
describe "vac":
    it "passes on anything":
        expect(true).to_be_true()
EOF

    # F2 known-good: exact assertion on a computed value. MUST NOT flag.
    mkdir -p "$st_dir/f2"
    cat > "$st_dir/f2/good_spec.spl" <<'EOF'
use std.spec.*
describe "good":
    it "computes the documented value":
        val actual = compute_checksum("payload")
        expect(actual).to_equal("9f2c41ab")
EOF

    # F3 fail-open mode A: vacuous assertion NOT on line 1, valid content above.
    # An anchored regex without a multiline flag matches only line 1 and misses this.
    mkdir -p "$st_dir/f3"
    cat > "$st_dir/f3/late_vacuous_spec.spl" <<'EOF'
use std.spec.*
describe "late":
    it "real check":
        val actual = parse("x=1")
        expect(actual).to_equal("x=1")
    it "vacuous check":
        expect(1).to_equal(1)
EOF

    # F4 fail-open mode B: deep nested path. A path filter missing the tree
    # prefix reports "0 candidates" and calls it a clean sweep.
    mkdir -p "$st_dir/f4/test/01_unit/compiler/deep/nest"
    cat > "$st_dir/f4/test/01_unit/compiler/deep/nest/deep_spec.spl" <<'EOF'
use std.spec.*
describe "deep":
    it "asserts nothing at all":
        val result = do_the_thing()
EOF

    # F5 helper delegation, REAL: `check(v)` where check() asserts, on a computed
    # value. MUST NOT flag. 3,560 corpus files use this wrapper shape; treating
    # it as "asserts nothing" produced ~12 false hits per file.
    mkdir -p "$st_dir/f5"
    cat > "$st_dir/f5/helper_real_spec.spl" <<'EOF'
use std.spec.*
fn check(condition: bool):
    expect(condition).to_equal(true)

describe "helper real":
    it "checks a computed value":
        val opt = Some(42)
        check(opt? == 42)
EOF

    # F6 helper delegation, VACUOUS: straight-line block whose every assertion is
    # a constant expression. `check(1 == 1)` cannot observe the system at all.
    # MUST flag.
    mkdir -p "$st_dir/f6"
    cat > "$st_dir/f6/helper_const_spec.spl" <<'EOF'
use std.spec.*
fn check(condition: bool):
    expect(condition).to_equal(true)

describe "helper const":
    it "claims to cover dict but asserts arithmetic":
        check(true)
        check(1 == 1)
        check("a" == "a")
EOF

    # F7 branch-coverage shape: `check(true)` DOES discriminate here, because the
    # sibling `check(false)` arm fails if the wrong branch is taken. Constant
    # assertions are only proof of vacuity in a straight-line block.
    # MUST NOT flag.
    mkdir -p "$st_dir/f7"
    cat > "$st_dir/f7/branch_cov_spec.spl" <<'EOF'
use std.spec.*
fn check(condition: bool):
    expect(condition).to_equal(true)

describe "branch coverage":
    it "if-elif-else taken":
        val x = 3
        if x > 10:
            check(false)
        elif x > 5:
            check(false)
        else:
            check(true)
EOF

    # F8 paren-less `expect <expr>` statement form on a computed value. This form
    # DOES assert (probe: a spec of only `expect false` reports failed=2, exit 1),
    # so it MUST NOT be flagged as zero-assertion. 1,322 corpus files use it.
    mkdir -p "$st_dir/f8"
    cat > "$st_dir/f8/parenless_spec.spl" <<'EOF'
use std.spec.*
describe "parenless":
    it "empty slice when start equals end":
        val args = ["simple"]
        val diagram_args = args.slice(1, args.len())
        expect diagram_args.len() == 0
    it "parses minutes":
        match parse_duration("5m"):
            case Some(duration): expect duration.total_minutes() == 5
            case nil: expect false
EOF

    st_fail=0
    st_out=$(find "$st_dir" -name '*_spec.spl' | sort | xargs awk "$AWK_PROG" 2>/dev/null)
    st_scanned=$(echo "$st_out" | sed -n 's/^#SCANNED\t//p' | awk '{t+=$1} END{print t+0}')

    [ "$st_scanned" = "8" ] || { echo "selftest: expected 8 files scanned, got '$st_scanned'"; st_fail=1; }
    if echo "$st_out" | /usr/bin/grep -aq "f8/parenless_spec.spl"; then
        echo "selftest: F8 paren-less expect WAS flagged (the form does assert)"; st_fail=1
    fi
    if echo "$st_out" | /usr/bin/grep -aq "f5/helper_real_spec.spl"; then
        echo "selftest: F5 helper-delegated real assertion WAS flagged (false positive)"; st_fail=1
    fi
    echo "$st_out" | /usr/bin/grep -aq "V2_CONST_ASSERT.*f6/helper_const_spec.spl" || { echo "selftest: F6 straight-line const-expr block NOT flagged"; st_fail=1; }

    if echo "$st_out" | /usr/bin/grep -aq "f7/branch_cov_spec.spl"; then

        echo "selftest: F7 branch-coverage shape WAS flagged (constant assertion in a branching block still discriminates)"; st_fail=1

    fi
    echo "$st_out" | /usr/bin/grep -aq "V2_CONST_ASSERT.*f1/vacuous_spec.spl" || { echo "selftest: F1 known-vacuous NOT flagged (detector fails open)"; st_fail=1; }
    if echo "$st_out" | /usr/bin/grep -aq "f2/good_spec.spl"; then
        echo "selftest: F2 known-good WAS flagged (detector false-positives)"; st_fail=1
    fi
    echo "$st_out" | /usr/bin/grep -aq "f3/late_vacuous_spec.spl" || { echo "selftest: F3 late-line vacuity NOT flagged (line-1-only regex bug)"; st_fail=1; }
    echo "$st_out" | /usr/bin/grep -aq "f4/test/01_unit/compiler/deep/nest/deep_spec.spl" || { echo "selftest: F4 deep-path spec NOT flagged (path-prefix filter bug)"; st_fail=1; }

    if [ "$st_fail" -ne 0 ]; then
        echo "SELFTEST FAILED — detector is not trustworthy, refusing to scan"
        return 1
    fi
    echo "selftest: 8/8 fixtures behaved correctly (F1,F3,F4,F6 flagged; F2,F5,F7,F8 clean)"
    return 0
}

# --selftest is ALWAYS run before any scan, and is fatal.
if ! run_selftest; then
    echo "ERROR — nothing was checked"
    exit 2
fi

if [ "$SELFTEST" -eq 1 ]; then
    echo "PASS — selftest only, 8 fixtures checked, 0 flagged in corpus"
    exit 0
fi

[ -n "$ROOT" ] || ROOT="."
if [ ! -d "$ROOT" ]; then
    echo "root directory not found: $ROOT" >&2
    echo "ERROR — nothing was checked"
    exit 2
fi

list=$(find "$ROOT" -name '*_spec.spl' -type f | sort)
nfiles=$(printf '%s\n' "$list" | /usr/bin/grep -ac . || true)
if [ "${nfiles:-0}" -eq 0 ]; then
    echo "no *_spec.spl files found under $ROOT — a zero-candidate sweep is not a pass"
    echo "ERROR — nothing was checked"
    exit 2
fi

# NOTE: xargs may split the list across SEVERAL awk invocations, each emitting
# its own #SCANNED line. Summing them (rather than reading one) is what keeps
# the scanned-vs-listed reconciliation below honest; reading a single line would
# under-count and turn a partial sweep into a silent pass.
rawout=$(printf '%s\n' "$list" | xargs awk "$AWK_PROG")
scanned=$(printf '%s\n' "$rawout" | sed -n 's/^#SCANNED\t//p' | awk '{t+=$1} END{print t+0}')
findings=$(printf '%s\n' "$rawout" | /usr/bin/grep -av '^#SCANNED')

if [ "${scanned:-0}" -ne "$nfiles" ]; then
    echo "scanned=$scanned but $nfiles files were listed — refusing to report a partial sweep"
    echo "ERROR — nothing was checked"
    exit 2
fi
if [ -n "$EXPECT_FILES" ] && [ "$scanned" -ne "$EXPECT_FILES" ]; then
    echo "scanned=$scanned but --expect-files $EXPECT_FILES was declared"
    echo "ERROR — nothing was checked"
    exit 2
fi

nflag=$(printf '%s\n' "$findings" | /usr/bin/grep -ac . || true)

if [ "$TSV" -eq 1 ]; then
    printf '%s\n' "$findings"
else
    echo "== findings by code =="
    printf '%s\n' "$findings" | cut -f1 | sort | uniq -c | sort -rn
fi

echo "PASS — $scanned files scanned, ${nflag:-0} flagged"
exit 0
