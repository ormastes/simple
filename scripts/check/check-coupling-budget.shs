#!/bin/sh
# check-coupling-budget.shs — coupling re-measure gate (Phase E, 2026-08-18).
#
# Measures the static import graph (`use <module>` lines) over the closure of
# all .spl files under src/compiler + src/app (std/lib files reached by the
# closure are included as nodes), computes strongly-connected components
# (iterative Tarjan), and compares four metrics against the committed baseline
# scripts/check/coupling_budget_baseline.txt:
#   cycles            — number of SCCs with >1 member
#   files_in_cycles   — total files inside those SCCs
#   largest_scc       — size of the largest SCC
#   backend_largest_scc — largest member-count any single SCC has inside
#                         src/compiler/70.backend/ or src/compiler/backend/
# FAIL if ANY measured metric exceeds its baseline (regression). PASS prints
# the measured numbers. ERROR (exit 2) if 0 files were resolved (non-vacuity).
#
# Recorded escape: there is NO flag to accept a regression. A deliberate
# coupling increase is accepted by editing coupling_budget_baseline.txt with a
# dated comment explaining why, in the same commit as the change that needs it.
# Ratchet downward freely when metrics improve.
#
# Resolver semantics mirror the 2026-08-17 baseline measurement
# (doc/10_metrics/startup/coupling_cohesion_baseline_2026-08-17.md): a module
# path a.b.c resolves to <base>/a/b/c.spl or <base>/a/b/c/__init__.spl where
# base is src/lib for std.*, src/app for app.*, src/compiler (with NN.layer
# prefix mapping and layer-dir search) for compiler.*, else src/<...> or
# src/lib/<...>; unresolved imports also try ancestor directories of the
# importing file. Unresolvable imports are ignored (external/virtual modules).
#
# Verdict is the LAST line of stdout: PASS/FAIL/ERROR, exit 0/1/2.
# --selftest runs fatal fixtures (must-FAIL 3-cycle, must-PASS acyclic,
# must-ERROR empty) and is also executed before every real scan.
set -u

SCRIPT="$0"
case "$SCRIPT" in /*) ;; *) SCRIPT="$(pwd)/$SCRIPT";; esac
ROOT_DEFAULT="$(cd "$(dirname "$SCRIPT")/../.." && pwd)"
BASELINE_DEFAULT="$ROOT_DEFAULT/scripts/check/coupling_budget_baseline.txt"

MODE=scan
SRCROOT=""
BASELINE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --selftest) MODE=selftest ;;
    --metrics) MODE=metrics ;;
    --root) shift; SRCROOT="${1:-}" ;;
    --baseline) shift; BASELINE="${1:-}" ;;
    *) echo "unknown argument: $1" >&2; echo "ERROR — nothing was checked (bad argument: $1)"; exit 2 ;;
  esac
  shift
done

# measure <srcroot> <scope_regex> — prints "M cycles n" style lines then metrics.
# scope_regex selects the root files (relative to srcroot) whose closure is taken.
measure() {
  m_src="$1"; m_scope="$2"
  # File list is passed as awk ARGV (plus /dev/null so an empty list still runs END).
  awk -v SRC="$m_src" -v SCOPE="$m_scope" '
  BEGIN { nfiles = 0 }
  FNR == 1 { fileset[FILENAME] = 1; order[nfiles++] = FILENAME }
  {
    line = $0
    if (match(line, /^[ \t]*(export[ \t]+)?use[ \t]+[A-Za-z_][A-Za-z0-9_.]*/)) {
      s = substr(line, RSTART, RLENGTH)
      sub(/^[ \t]*(export[ \t]+)?use[ \t]+/, "", s)
      sub(/\.+$/, "", s)
      uses[FILENAME, ++nuse[FILENAME]] = s
    }
  }
  function try(base,   p) {
    p = base ".spl";           if (p in fileset) return p
    p = base "/__init__.spl";  if (p in fileset) return p
    return ""
  }
  function resolve(mod, frm,   n, parts, i, rest, r, d, base, lay) {
    n = split(mod, parts, ".")
    if (parts[1] == "std") {
      base = SRC "/lib"; for (i = 2; i <= n; i++) base = base "/" parts[i]
      r = try(base); if (r != "") return r
    } else if (parts[1] == "app") {
      base = SRC "/app"; for (i = 2; i <= n; i++) base = base "/" parts[i]
      r = try(base); if (r != "") return r
    } else if (parts[1] == "compiler") {
      if (n >= 2 && (parts[2] in layermap)) {
        base = SRC "/compiler/" layermap[parts[2]]
        for (i = 3; i <= n; i++) base = base "/" parts[i]
        r = try(base); if (r != "") return r
      }
      base = SRC "/compiler"; for (i = 2; i <= n; i++) base = base "/" parts[i]
      r = try(base); if (r != "") return r
      # any layer dir containing the remaining path
      for (lay in layerset) {
        base = SRC "/compiler/" lay
        for (i = 2; i <= n; i++) base = base "/" parts[i]
        r = try(base); if (r != "") return r
      }
    } else {
      base = SRC; for (i = 1; i <= n; i++) base = base "/" parts[i]
      r = try(base); if (r != "") return r
      base = SRC "/lib"; for (i = 1; i <= n; i++) base = base "/" parts[i]
      r = try(base); if (r != "") return r
    }
    # ancestor-dir resolution relative to the importing file
    d = frm; sub(/\/[^\/]*$/, "", d)
    while (length(d) >= length(SRC)) {
      base = d; for (i = 1; i <= n; i++) base = base "/" parts[i]
      r = try(base); if (r != "") return r
      if (d == SRC) break
      sub(/\/[^\/]*$/, "", d)
    }
    return ""
  }
  END {
    # layer map: NN.name dirs under SRC/compiler (derived from fileset paths)
    for (f in fileset) {
      if (index(f, SRC "/compiler/") == 1) {
        rest = substr(f, length(SRC "/compiler/") + 1)
        split(rest, seg, "/")
        if (match(seg[1], /^[0-9]+\./)) {
          nm = substr(seg[1], RSTART + RLENGTH)
          layermap[nm] = seg[1]; layerset[seg[1]] = 1
        } else if (index(rest, "/") > 0) {
          layerset[seg[1]] = 1
        }
      }
    }
    # edges
    for (i = 0; i < nfiles; i++) {
      f = order[i]
      for (j = 1; j <= nuse[f]; j++) {
        r = resolve(uses[f, j], f)
        if (r != "" && r != f && !((f, r) in edge)) {
          edge[f, r] = 1
          adj[f] = adj[f] SUBSEP r
        }
      }
    }
    # closure from scope roots
    top = 0
    for (i = 0; i < nfiles; i++) {
      f = order[i]
      rel = substr(f, length(SRC) + 2)
      if (rel ~ SCOPE && !(f in seen)) { seen[f] = 1; work[top++] = f }
    }
    while (top > 0) {
      f = work[--top]
      cnt = split(substr(adj[f], 2), tg, SUBSEP)
      if (adj[f] == "") cnt = 0
      for (k = 1; k <= cnt; k++)
        if (!(tg[k] in seen)) { seen[tg[k]] = 1; work[top++] = tg[k] }
    }
    nnodes = 0
    for (f in seen) nnodes++
    nedges = 0
    for (e in edge) { split(e, ab, SUBSEP); if ((ab[1] in seen) && (ab[2] in seen)) nedges++ }
    # iterative Tarjan over `seen` nodes
    cidx = 0; sp = 0; nscc = 0
    for (i = 0; i < nfiles; i++) {
      v0 = order[i]
      if (!(v0 in seen) || (v0 in idx)) continue
      csp = 0
      cs_v[csp] = v0; cs_i[csp] = 1
      while (csp >= 0) {
        v = cs_v[csp]
        if (cs_i[csp] == 1) {
          idx[v] = low[v] = ++cidx
          stk[++sp] = v; onstk[v] = 1
          na = split(substr(adj[v], 2), dummy, SUBSEP)
          if (adj[v] == "") na = 0
          cs_n[csp] = na
        }
        na = cs_n[csp]
        advanced = 0
        while (cs_i[csp] <= na) {
          split(substr(adj[v], 2), tg2, SUBSEP)
          w = tg2[cs_i[csp]]
          cs_i[csp]++
          if (!(w in seen)) continue
          if (!(w in idx)) { csp++; cs_v[csp] = w; cs_i[csp] = 1; advanced = 1; break }
          if (w in onstk && idx[w] < low[v]) low[v] = idx[w]
        }
        if (advanced) continue
        # done with v
        if (low[v] == idx[v]) {
          sz = 0; bk = 0
          while (1) {
            w = stk[sp--]; delete onstk[w]; sz++
            comp_of[w] = nscc
            if (index(w, SRC "/compiler/70.backend/") == 1 || index(w, SRC "/compiler/backend/") == 1) bk++
            if (w == v) break
          }
          scc_size[nscc] = sz; scc_bk[nscc] = bk; nscc++
        }
        csp--
        if (csp >= 0) {
          u = cs_v[csp]
          if (low[v] < low[u]) low[u] = low[v]
        }
      }
    }
    cycles = 0; fic = 0; largest = 0; bklargest = 0
    for (c = 0; c < nscc; c++) {
      if (scc_size[c] > 1) {
        cycles++; fic += scc_size[c]
        if (scc_size[c] > largest) largest = scc_size[c]
        if (scc_bk[c] > 1 && scc_bk[c] > bklargest) bklargest = scc_bk[c]
      }
    }
    print "nodes " nnodes
    print "edges " nedges
    print "cycles " cycles
    print "files_in_cycles " fic
    print "largest_scc " largest
    print "backend_largest_scc " bklargest
  }' $(find "$m_src" -name '*.spl' -type f 2>/dev/null | LC_ALL=C sort) /dev/null
}

read_metric() { # file key
  awk -v k="$2" '$1 == k { print $2; found = 1 } END { if (!found) print "MISSING" }' "$1"
}

# scan <srcroot> <baseline> — prints verdict, returns 0/1/2
scan() {
  s_src="$1"; s_base="$2"
  if [ ! -f "$s_base" ]; then
    echo "ERROR — nothing was checked (baseline not found: $s_base)"; return 2
  fi
  out="$(measure "$s_src" '^(compiler|app)/')"
  nodes=$(printf '%s\n' "$out" | awk '$1=="nodes"{print $2}')
  [ -n "$nodes" ] || nodes=0
  if [ "$nodes" -eq 0 ]; then
    echo "ERROR — nothing was checked (0 files resolved under $s_src)"; return 2
  fi
  fail=""
  vals=""
  for k in cycles files_in_cycles largest_scc backend_largest_scc; do
    m=$(printf '%s\n' "$out" | awk -v k="$k" '$1==k{print $2}')
    b=$(read_metric "$s_base" "$k")
    if [ "$b" = "MISSING" ]; then
      echo "ERROR — nothing was checked (baseline missing key: $k)"; return 2
    fi
    vals="$vals $k=$m(budget $b)"
    if [ "$m" -gt "$b" ]; then fail="$fail $k=$m>$b"; fi
  done
  if [ -n "$fail" ]; then
    echo "FAIL — $nodes file(s) checked, coupling regression:$fail (edit $s_base with a dated comment only for a deliberate, reviewed increase)"
    return 1
  fi
  echo "PASS — $nodes file(s) checked,$vals"
  return 0
}

selftest() {
  st_dir="${TMPDIR:-/tmp}/coupling-budget-selftest.$$"
  rm -rf "$st_dir"
  # Fixture 1: must-FAIL — synthetic 3-cycle under app/, baseline all-zero
  mkdir -p "$st_dir/f1/app/x" "$st_dir/f1/compiler"
  printf 'use app.x.b\n' > "$st_dir/f1/app/x/a.spl"
  printf 'use app.x.c\n' > "$st_dir/f1/app/x/b.spl"
  printf 'use app.x.a\n' > "$st_dir/f1/app/x/c.spl"
  printf 'fn main() {}\n' > "$st_dir/f1/compiler/root.spl"
  cat > "$st_dir/f1/base.txt" <<'EOF'
cycles 0
files_in_cycles 0
largest_scc 0
backend_largest_scc 0
EOF
  v=$(scan "$st_dir/f1" "$st_dir/f1/base.txt"); rc=$?
  case "$rc:$v" in
    1:FAIL*cycles=1\>0*files_in_cycles=3\>0*largest_scc=3\>0*) : ;;
    *) echo "selftest fixture 1 (must-FAIL 3-cycle) got rc=$rc verdict: $v" >&2; rm -rf "$st_dir"; return 1 ;;
  esac
  # Fixture 2: must-PASS — acyclic chain within budget
  mkdir -p "$st_dir/f2/app/x"
  printf 'use app.x.b\n' > "$st_dir/f2/app/x/a.spl"
  printf 'use app.x.c\n' > "$st_dir/f2/app/x/b.spl"
  printf 'fn leaf() {}\n' > "$st_dir/f2/app/x/c.spl"
  cp "$st_dir/f1/base.txt" "$st_dir/f2/base.txt"
  v=$(scan "$st_dir/f2" "$st_dir/f2/base.txt"); rc=$?
  case "$rc:$v" in
    0:PASS*3\ file*cycles=0*) : ;;
    *) echo "selftest fixture 2 (must-PASS acyclic) got rc=$rc verdict: $v" >&2; rm -rf "$st_dir"; return 1 ;;
  esac
  # Fixture 3: must-ERROR — empty tree resolves 0 files
  mkdir -p "$st_dir/f3/app"
  v=$(scan "$st_dir/f3" "$st_dir/f1/base.txt"); rc=$?
  case "$rc:$v" in
    2:ERROR*) : ;;
    *) echo "selftest fixture 3 (must-ERROR empty) got rc=$rc verdict: $v" >&2; rm -rf "$st_dir"; return 1 ;;
  esac
  # Fixture 4: must-ERROR — missing baseline file
  v=$(scan "$st_dir/f2" "$st_dir/nonexistent-baseline.txt"); rc=$?
  case "$rc:$v" in
    2:ERROR*) : ;;
    *) echo "selftest fixture 4 (must-ERROR no baseline) got rc=$rc verdict: $v" >&2; rm -rf "$st_dir"; return 1 ;;
  esac
  rm -rf "$st_dir"
  return 0
}

if [ "$MODE" = selftest ]; then
  if selftest; then
    echo "PASS — 4 selftest fixture(s) checked (must-FAIL 3-cycle, must-PASS acyclic, must-ERROR empty, must-ERROR missing baseline)"
    exit 0
  fi
  echo "ERROR — nothing was checked (selftest failed)"
  exit 2
fi

# --metrics: print raw metric lines (nodes/edges/cycles/...) for snapshot tooling.
# Selftest is fatal here too; 0 resolved files is ERROR, never a pass.
if [ "$MODE" = metrics ]; then
  if ! selftest > /dev/null; then
    echo "ERROR — nothing was checked (fatal: --selftest failed; fix the detector before trusting it)"
    exit 2
  fi
  [ -n "$SRCROOT" ] || SRCROOT="$ROOT_DEFAULT/src"
  out="$(measure "$SRCROOT" '^(compiler|app)/')"
  nodes=$(printf '%s\n' "$out" | awk '$1=="nodes"{print $2}')
  [ -n "$nodes" ] || nodes=0
  if [ "$nodes" -eq 0 ]; then
    echo "ERROR — nothing was checked (0 files resolved under $SRCROOT)"
    exit 2
  fi
  printf '%s\n' "$out"
  exit 0
fi

# real scan: selftest is fatal and runs first
if ! selftest > /dev/null; then
  echo "ERROR — nothing was checked (fatal: --selftest failed; fix the detector before trusting it)"
  exit 2
fi
[ -n "$SRCROOT" ] || SRCROOT="$ROOT_DEFAULT/src"
[ -n "$BASELINE" ] || BASELINE="$BASELINE_DEFAULT"
scan "$SRCROOT" "$BASELINE"
exit $?
