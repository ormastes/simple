#!/bin/sh
# F1 / S2 — class-identity engine matrix.
#
# Prints the class/struct identity contract corpus under THREE engines side by
# side and asserts that the pure-Simple lane is genuinely a different engine
# from both seed lanes.
#
#   seedJIT    : bin/simple run <case>                        (cranelift JIT)
#   seedINTERP : SIMPLE_EXECUTION_MODE=interpret bin/simple run <case>
#   pureSIMPLE : bin/simple run scripts/check/class_identity_pure_simple_driver.spl
#                -> core_jit_interpret(), i.e. the pure-Simple frontend
#                   tree-walk evaluator in src/compiler/10.frontend/core/interpreter/**
#
# WHY THE THIRD LANE NEEDS PROVING: the first two lanes both execute on the Rust
# seed, so a driver that silently fell back to the seed would still print a
# plausible table. The discriminator below is a POSITIVE one -- case A is REF on
# the pure-Simple engine and COPY on the seed interpreter, and case B answers on
# the pure-Simple engine while it kills the seed JIT process. If the pure lane
# ever reproduces the seed interpreter's column exactly, this script fails.
#
# This script MEASURES; it does not gate correctness. Both seed engines are
# known-wrong in opposite directions (see
# doc/03_plan/ui/perf/f1_class_identity_kind_propagation_plan_2026-08-09.md),
# so a "wrong" reading here is the documented status quo, not a regression.
#
# COMPLETENESS IS PART OF THE VERDICT. A truncated run is NOT a pass. The case
# count is DISCOVERED from the case directory (never hardcoded), and every engine
# must produce a reading for every discovered case. Until 2026-08-09 the verdict
# only required `pure_readings > 0`, so a driver killed after 2 of 10 cases still
# printed PASS -- the exact "green over a partial sample" fail-open this repo has
# hit repeatedly. The reading counts are now printed on EVERY run, pass or fail,
# so a verdict is auditable rather than merely reassuring.
#
# Usage: sh scripts/check/check-class-identity-engine-matrix.shs
# Exit:  0 = matrix COMPLETE (every engine answered every discovered case) AND
#            the pure-Simple lane proved distinct. The verdict states the counts.
#        1 = FAIL — either an engine came up short (truncated/killed run) or the
#            pure-Simple lane did not diverge from the seed (suspect fallback)
#        2 = BLOCKED — nothing was measured at all (no case files discovered, or
#            the pure-Simple driver produced zero readings)
#
# The pure-Simple lane runs the whole pure-Simple frontend under the seed's own
# interpreter, so it is SLOW (tens of minutes on a loaded box). That cost is the
# price of reaching the engine at all without rebuilding bin/simple.

set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT" || exit 2

BIN="${SIMPLE_BIN:-bin/simple}"
CASE_DIR=test/fixtures/repro/compiler/class_identity/cases
DRIVER=scripts/check/class_identity_pure_simple_driver.spl
LIMIT="${SIMPLE_MODULE_LIMIT:-4000}"
PURE_TIMEOUT="${PURE_TIMEOUT:-5400}"
SEED_TIMEOUT="${SEED_TIMEOUT:-120}"
TMP="${TMPDIR:-/tmp}/class-identity-matrix.$$"
mkdir -p "$TMP" || exit 2

reading() {
    # $1 = raw engine output; extract the single verdict line, or the failure.
    # [A-Z], NOT [A-J]: the corpus grows (case K landed 2026-08-09) and an
    # alphabet-capped filter silently drops the new case's seed readings, which
    # the completeness check would then -- correctly -- report as a shortfall.
    printf '%s\n' "$1" \
        | grep -E '^[A-Z] |^runtime error|^error' \
        | head -1 \
        | sed 's/  */ /g'
}

printf '%s\n' "== pure-Simple frontend interpreter lane (this takes a while) =="
# The driver MUST be executed from OUTSIDE the repo tree. Measured 2026-08-09:
# byte-identical driver, same env, same binary --
#   bin/simple run scripts/check/class_identity_pure_simple_driver.spl
#     -> "error: semantic: variable `cache_initialized` not found" (that is a
#        module-level `var` in 10.frontend/core/interpreter/value.spl, i.e. the
#        interpreter package's own globals were never initialised)
#   bin/simple run /tmp/<copy>.spl
#     -> runs to completion, all ten cases answered
# So the entry file's location changes whether the imported modules' globals get
# initialised. Copying out is a WORKAROUND for that defect, not a preference.
# Filed in the S2 section of
# doc/03_plan/ui/perf/f1_class_identity_kind_propagation_plan_2026-08-09.md.
#
# ONE DRIVER PROCESS PER CASE (changed 2026-08-20). The driver used to answer
# the whole corpus in a single process, and that was measured to be not merely
# incomplete but UNSOUND: `core_jit_interpret` is not re-entrant, so a second
# eval in the same process inherits the first's interpreter globals. Case G
# alone prints VAL; run case C first and the same case G prints ALIAS(n=10)
# -- `got == 10` evaluating FALSE with got=10. Case B first killed the process
# with "array index out of bounds". That cost 4 of 11 readings AND left the
# surviving 7 unverifiable. Each case now gets a fresh process, the only
# configuration measured to reproduce the single-case answers. The per-case
# timeout is PURE_TIMEOUT; the re-entrancy defect itself is filed, not papered
# over here.
cp "$DRIVER" "$TMP/driver.spl" || exit 2
: > "$TMP/pure.out"
driver_exit=0
for f in "$CASE_DIR"/*.spl; do
    [ -e "$f" ] || continue
    CLASS_IDENTITY_CASE="$(basename "$f")" SIMPLE_MODULE_LIMIT="$LIMIT" SIMPLE_NO_JIT=1 \
        timeout "$PURE_TIMEOUT" "$BIN" run "$TMP/driver.spl" >> "$TMP/pure.out" 2>&1
    rc=$?
    [ "$rc" -ne 0 ] && driver_exit=$rc
    printf '%s\n' "   $(basename "$f" .spl): exit $rc"
done
printf '%s\n' "   worst driver exit: $driver_exit"
case "$driver_exit" in
    124) printf '%s\n' "   NOTE: a driver hit the ${PURE_TIMEOUT}s timeout — the pure lane is truncated" ;;
    143) printf '%s\n' "   NOTE: a driver took SIGTERM — the pure lane is truncated" ;;
esac

printf '\n%-28s | %-24s | %-24s | %s\n' "case" "seedJIT" "seedINTERP" "pureSIMPLE"
printf -- '-----------------------------+--------------------------+--------------------------+--------------------------\n'

diverged=0
pure_readings=0
jit_readings=0
int_readings=0
total_cases=0
short_engines=""

for f in "$CASE_DIR"/*.spl; do
    [ -e "$f" ] || continue
    total_cases=$((total_cases + 1))
    name=$(basename "$f" .spl)
    letter=$(printf '%s' "$name" | cut -c1 | tr 'a-z' 'A-Z')

    jit_raw=$(SIMPLE_MODULE_LIMIT="$LIMIT" timeout "$SEED_TIMEOUT" "$BIN" run "$f" 2>&1)
    int_raw=$(SIMPLE_MODULE_LIMIT="$LIMIT" SIMPLE_EXECUTION_MODE=interpret \
              timeout "$SEED_TIMEOUT" "$BIN" run "$f" 2>&1)

    jit=$(reading "$jit_raw")
    int=$(reading "$int_raw")
    pure=$(grep -E "^$letter " "$TMP/pure.out" | head -1 | sed 's/  */ /g')
    [ -z "$pure" ] && pure=$(grep -E "^$name(\.spl)?: " "$TMP/pure.out" | head -1)

    if [ -z "$jit" ]; then jit="<no verdict>"; else jit_readings=$((jit_readings + 1)); fi
    if [ -z "$int" ]; then int="<no verdict>"; else int_readings=$((int_readings + 1)); fi
    if [ -z "$pure" ]; then pure="<no verdict>"; else pure_readings=$((pure_readings + 1)); fi

    # Strip the leading case letter+label so the three columns compare cleanly.
    jit_v=$(printf '%s' "$jit"  | sed 's/^.*= //')
    int_v=$(printf '%s' "$int"  | sed 's/^.*= //')
    pure_v=$(printf '%s' "$pure" | sed 's/^.*= //')

    [ "$pure_v" != "$int_v" ] && diverged=$((diverged + 1))

    printf '%-28s | %-24s | %-24s | %s\n' "$name" "$jit_v" "$int_v" "$pure_v"
done

printf '\n'
# Completeness line — printed on EVERY run, pass or fail, so the verdict states
# what was actually examined instead of asserting success over an unknown sample.
printf 'readings: cases_discovered=%s seedJIT=%s/%s seedINTERP=%s/%s pureSIMPLE=%s/%s (driver exit %s)\n' \
    "$total_cases" \
    "$jit_readings" "$total_cases" \
    "$int_readings" "$total_cases" \
    "$pure_readings" "$total_cases" \
    "$driver_exit"

# --- BLOCKED (exit 2): nothing was measured at all ---------------------------
if [ "$total_cases" -eq 0 ]; then
    printf '%s\n' "BLOCKED — no case files discovered under $CASE_DIR; nothing was measured"
    rm -rf "$TMP"
    exit 2
fi
if [ "$pure_readings" -eq 0 ]; then
    printf '%s\n' "BLOCKED — the pure-Simple driver produced 0 of $total_cases readings; nothing was measured"
    rm -rf "$TMP"
    exit 2
fi

# --- FAIL (exit 1): completeness ---------------------------------------------
# Checked BEFORE the discrimination check: divergence computed over a partial
# sample is not evidence of anything, so a short run must never be reported as
# a discrimination result.
[ "$jit_readings"  -lt "$total_cases" ] && short_engines="$short_engines seedJIT=$jit_readings/$total_cases"
[ "$int_readings"  -lt "$total_cases" ] && short_engines="$short_engines seedINTERP=$int_readings/$total_cases"
[ "$pure_readings" -lt "$total_cases" ] && short_engines="$short_engines pureSIMPLE=$pure_readings/$total_cases"
if [ -n "$short_engines" ]; then
    printf 'FAIL — incomplete matrix over %s discovered case(s); short engine(s):%s. A truncated run is not a pass; re-run (driver exit was %s).\n' \
        "$total_cases" "$short_engines" "$driver_exit"
    rm -rf "$TMP"
    exit 1
fi

# --- FAIL (exit 1): engine discrimination (unchanged semantics) --------------
if [ "$diverged" -eq 0 ]; then
    printf 'FAIL — pureSIMPLE matched seedINTERP on all %s case(s): suspect a silent fallback to the seed, not a real second engine\n' \
        "$total_cases"
    rm -rf "$TMP"
    exit 1
fi
printf 'PASS — complete matrix over %s case(s): seedJIT=%s/%s seedINTERP=%s/%s pureSIMPLE=%s/%s, pureSIMPLE diverges from seedINTERP on %s case(s): the driver reaches a DIFFERENT engine\n' \
    "$total_cases" "$jit_readings" "$total_cases" "$int_readings" "$total_cases" \
    "$pure_readings" "$total_cases" "$diverged"
rm -rf "$TMP"
exit 0
