#!/bin/sh
# F1 / S2 — class-identity engine matrix.
#
# Prints the class/struct identity contract corpus under THREE engines side by
# side and asserts that the pure-Simple lane is genuinely a different engine
# from both seed lanes.
#
#   seedJIT    : bin/simple run <case>                        (cranelift JIT)
#   seedINTERP : SIMPLE_EXECUTION_MODE=interpret bin/simple run <case>
#   pureSIMPLE : bin/simple run scripts/check/class_identity_pure_simple_driver.spl
#                -> core_jit_interpret(), i.e. the pure-Simple frontend
#                   tree-walk evaluator in src/compiler/10.frontend/core/interpreter/**
#
# WHY THE THIRD LANE NEEDS PROVING: the first two lanes both execute on the Rust
# seed, so a driver that silently fell back to the seed would still print a
# plausible table. The discriminator below is a POSITIVE one -- case A is REF on
# the pure-Simple engine and COPY on the seed interpreter, and case B answers on
# the pure-Simple engine while it kills the seed JIT process. If the pure lane
# ever reproduces the seed interpreter's column exactly, this script fails.
#
# This script MEASURES; it does not gate correctness. Both seed engines are
# known-wrong in opposite directions (see
# doc/03_plan/ui/perf/f1_class_identity_kind_propagation_plan_2026-08-09.md),
# so a "wrong" reading here is the documented status quo, not a regression.
#
# Usage: sh scripts/check/check-class-identity-engine-matrix.shs
# Exit:  0 = matrix printed AND the pure-Simple lane proved distinct
#        1 = the pure-Simple lane did not diverge from the seed (suspect fallback)
#        2 = the pure-Simple driver produced no readings at all
#
# The pure-Simple lane runs the whole pure-Simple frontend under the seed's own
# interpreter, so it is SLOW (tens of minutes on a loaded box). That cost is the
# price of reaching the engine at all without rebuilding bin/simple.

set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT" || exit 2

BIN="${SIMPLE_BIN:-bin/simple}"
CASE_DIR=test/fixtures/repro/compiler/class_identity/cases
DRIVER=scripts/check/class_identity_pure_simple_driver.spl
LIMIT="${SIMPLE_MODULE_LIMIT:-4000}"
PURE_TIMEOUT="${PURE_TIMEOUT:-5400}"
SEED_TIMEOUT="${SEED_TIMEOUT:-120}"
TMP="${TMPDIR:-/tmp}/class-identity-matrix.$$"
mkdir -p "$TMP" || exit 2

reading() {
    # $1 = raw engine output; extract the single verdict line, or the failure.
    printf '%s\n' "$1" \
        | grep -E '^[A-J] |^runtime error|^error' \
        | head -1 \
        | sed 's/  */ /g'
}

printf '%s\n' "== pure-Simple frontend interpreter lane (this takes a while) =="
# The driver MUST be executed from OUTSIDE the repo tree. Measured 2026-08-09:
# byte-identical driver, same env, same binary --
#   bin/simple run scripts/check/class_identity_pure_simple_driver.spl
#     -> "error: semantic: variable `cache_initialized` not found" (that is a
#        module-level `var` in 10.frontend/core/interpreter/value.spl, i.e. the
#        interpreter package's own globals were never initialised)
#   bin/simple run /tmp/<copy>.spl
#     -> runs to completion, all ten cases answered
# So the entry file's location changes whether the imported modules' globals get
# initialised. Copying out is a WORKAROUND for that defect, not a preference.
# Filed in the S2 section of
# doc/03_plan/ui/perf/f1_class_identity_kind_propagation_plan_2026-08-09.md.
cp "$DRIVER" "$TMP/driver.spl" || exit 2
SIMPLE_MODULE_LIMIT="$LIMIT" SIMPLE_NO_JIT=1 \
    timeout "$PURE_TIMEOUT" "$BIN" run "$TMP/driver.spl" > "$TMP/pure.out" 2>&1
printf '%s\n' "   driver exit: $?"

printf '\n%-28s | %-24s | %-24s | %s\n' "case" "seedJIT" "seedINTERP" "pureSIMPLE"
printf -- '-----------------------------+--------------------------+--------------------------+--------------------------\n'

diverged=0
pure_readings=0

for f in "$CASE_DIR"/*.spl; do
    name=$(basename "$f" .spl)
    letter=$(printf '%s' "$name" | cut -c1 | tr 'a-j' 'A-J')

    jit_raw=$(SIMPLE_MODULE_LIMIT="$LIMIT" timeout "$SEED_TIMEOUT" "$BIN" run "$f" 2>&1)
    int_raw=$(SIMPLE_MODULE_LIMIT="$LIMIT" SIMPLE_EXECUTION_MODE=interpret \
              timeout "$SEED_TIMEOUT" "$BIN" run "$f" 2>&1)

    jit=$(reading "$jit_raw")
    int=$(reading "$int_raw")
    pure=$(grep -E "^$letter " "$TMP/pure.out" | head -1 | sed 's/  */ /g')
    [ -z "$pure" ] && pure=$(grep -E "^$name(\.spl)?: " "$TMP/pure.out" | head -1)

    [ -z "$jit" ] && jit="<no verdict>"
    [ -z "$int" ] && int="<no verdict>"
    if [ -z "$pure" ]; then
        pure="<no verdict>"
    else
        pure_readings=$((pure_readings + 1))
    fi

    # Strip the leading case letter+label so the three columns compare cleanly.
    jit_v=$(printf '%s' "$jit"  | sed 's/^.*= //')
    int_v=$(printf '%s' "$int"  | sed 's/^.*= //')
    pure_v=$(printf '%s' "$pure" | sed 's/^.*= //')

    [ "$pure_v" != "$int_v" ] && diverged=$((diverged + 1))

    printf '%-28s | %-24s | %-24s | %s\n' "$name" "$jit_v" "$int_v" "$pure_v"
done

printf '\n'
if [ "$pure_readings" -eq 0 ]; then
    printf '%s\n' "ERROR — the pure-Simple driver produced no readings; nothing was measured"
    rm -rf "$TMP"
    exit 2
fi
if [ "$diverged" -eq 0 ]; then
    printf '%s\n' "FAIL — pureSIMPLE matched seedINTERP on every case: suspect a silent fallback to the seed, not a real second engine"
    rm -rf "$TMP"
    exit 1
fi
printf 'PASS — %s pure-Simple reading(s) captured, diverging from seedINTERP on %s case(s): the driver reaches a DIFFERENT engine\n' \
    "$pure_readings" "$diverged"
rm -rf "$TMP"
exit 0
