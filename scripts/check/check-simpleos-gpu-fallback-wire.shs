#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT_DIR"

HOST_BIN=${SIMPLEOS_GPU_HOST_BIN:-build/simpleos_gpu_host/fallback_wire/simpleos_gpu_host}
PROBE_BIN=${SIMPLEOS_GPU_FALLBACK_WIRE_PROBE_BIN:-build/simpleos_gpu_host/fallback_wire/fallback_wire_probe}
TEST_TIMEOUT_SECONDS=${SIMPLEOS_GPU_FALLBACK_WIRE_TIMEOUT_SECONDS:-60}
MIN_OFFLOAD_ELEMENTS=${SIMPLEOS_GPU_FALLBACK_WIRE_MIN_OFFLOAD_ELEMENTS:-0}
EXPECTED_REASON=${SIMPLEOS_GPU_FALLBACK_WIRE_EXPECT_REASON:-16}
MODE=${SIMPLEOS_GPU_FALLBACK_WIRE_MODE:-fallback}

case "$TEST_TIMEOUT_SECONDS" in ''|0|*[!0-9]*) exit 2 ;; esac
case "$MIN_OFFLOAD_ELEMENTS" in ''|*[!0-9]*) exit 2 ;; esac
case "$MIN_OFFLOAD_ELEMENTS" in 0|[1-9]*) ;; *) exit 2 ;; esac
case "$EXPECTED_REASON" in 16|18) ;; *) exit 2 ;; esac
case "$MODE" in fallback|device-warm|device-warm-production) ;; *) exit 2 ;; esac
DAEMON_TIMEOUT_SECONDS=$((TEST_TIMEOUT_SECONDS + 10))

if [ ! -x "$HOST_BIN" ] || [ ! -x "$PROBE_BIN" ]; then
    echo "simpleos_gpu_fallback_wire_status=blocked"
    echo "simpleos_gpu_fallback_wire_reason=native-binary-missing"
    exit 1
fi

SHM=${TMPDIR:-/tmp}/simpleos_gpu_fallback_wire_$$.shm
DAEMON_LOG=${SIMPLEOS_GPU_FALLBACK_WIRE_DAEMON_LOG:-build/simpleos_gpu_host/fallback_wire/daemon-live.log}
mkdir -p "$(dirname "$DAEMON_LOG")"
truncate -s 8388608 "$SHM"

daemon_pid=
cleanup() {
    if [ -n "$daemon_pid" ]; then
        kill "$daemon_pid" 2>/dev/null || true
        wait "$daemon_pid" 2>/dev/null || true
    fi
    rm -f "$SHM"
}
trap cleanup EXIT INT TERM

if [ "$MODE" = fallback ]; then
    timeout -k 2 "$DAEMON_TIMEOUT_SECONDS" env \
        SIMPLE_GPU_TEST=1 \
        SIMPLE_GPU_FAULT_INJECT=cuda:submit \
        SIMPLE_GPU_FAULT_INJECT_SKIP_MATCHES=1 \
        "$HOST_BIN" \
        "--shm=$SHM" \
        --processing-backend=cuda \
        --processing-fallback=cpu \
        "--processing-min-offload-elements=$MIN_OFFLOAD_ELEMENTS" >"$DAEMON_LOG" 2>&1 &
elif [ "$MODE" = device-warm ]; then
    timeout -k 2 "$DAEMON_TIMEOUT_SECONDS" env \
        SIMPLE_GPU_TEST=1 \
        "$HOST_BIN" \
        "--shm=$SHM" \
        --processing-backend=cuda \
        --processing-fallback=none \
        --processing-min-offload-elements=0 \
        --processing-verify-cpu >"$DAEMON_LOG" 2>&1 &
else
    timeout -k 2 "$DAEMON_TIMEOUT_SECONDS" env \
        SIMPLE_GPU_TEST=1 \
        "$HOST_BIN" \
        "--shm=$SHM" \
        --processing-backend=cuda \
        --processing-fallback=none \
        --processing-min-offload-elements=0 >"$DAEMON_LOG" 2>&1 &
fi
daemon_pid=$!

ready=0
ready_attempts=0
while [ "$ready_attempts" -lt 50 ]; do
    if grep -Fq "HOST_GPU_DAEMON_TRANSPORT shm_offset=" "$DAEMON_LOG" 2>/dev/null; then
        ready=1
        break
    fi
    kill -0 "$daemon_pid" 2>/dev/null || break
    ready_attempts=$((ready_attempts + 1))
    sleep 0.1
done
if [ "$ready" -ne 1 ]; then
    echo "simpleos_gpu_fallback_wire_status=fail"
    echo "simpleos_gpu_fallback_wire_reason=daemon-not-ready"
    exit 1
fi

expected_verify=false
[ "$MODE" != device-warm ] || expected_verify=true
verify_total=$(grep -Ec '^HOST_GPU_DAEMON_VERIFY ' "$DAEMON_LOG" || true)
verify_valid=$(grep -Ec "^HOST_GPU_DAEMON_VERIFY processing_verify_cpu=$expected_verify$" "$DAEMON_LOG" || true)
if [ "$verify_total" -ne 1 ] || [ "$verify_valid" -ne 1 ]; then
    echo "simpleos_gpu_fallback_wire_status=fail"
    echo "simpleos_gpu_fallback_wire_reason=daemon-verifier-mode-mismatch"
    exit 1
fi

set +e
if [ "$MODE" = fallback ]; then
    output=$(timeout -k 5 "$TEST_TIMEOUT_SECONDS" "$PROBE_BIN" --shm "$SHM" "--expected-reason=$EXPECTED_REASON" 2>&1)
else
    output=$(timeout -k 5 "$TEST_TIMEOUT_SECONDS" "$PROBE_BIN" --shm "$SHM" --device-warm 2>&1)
fi
probe_rc=$?
set -e
printf '%s\n' "$output"
if [ "$probe_rc" -ne 0 ]; then
    echo "simpleos_gpu_fallback_wire_status=fail"
    echo "simpleos_gpu_fallback_wire_reason=probe-failed"
    exit "$probe_rc"
fi
if [ "$MODE" = fallback ]; then
    printf '%s\n' "$output" | grep -q 'GPU_FALLBACK_WIRE status=pass'
    printf '%s\n' "$output" | grep -q 'hello_completed=true hello_status=1 hello_mask=8'
    printf '%s\n' "$output" | grep -q "receipt_completed=true receipt_status=4 reason=$EXPECTED_REASON source=2"
    printf '%s\n' "$output" | grep -q 'handle=0 identity=0 bytes=32 checksum=135272480'
    printf '%s\n' "$output" | grep -q 'backend=4'
else
    printf '%s\n' "$output" | grep -Eq 'GPU_DEVICE_WARM_WIRE status=pass warmups=3 samples=5 requests=8 count=1048576 checksum=809508928'
    printf '%s\n' "$output" | grep -Eq 'median_device_us=[1-9][0-9]* median_roundtrip_us=[1-9][0-9]* median_non_device_us=[0-9]+'
    printf '%s\n' "$output" | grep -Eq 'handle=[1-9][0-9]* identity=[1-9][0-9]* exact=true stable_provenance=true'
    if [ "$MODE" = device-warm ]; then
        awk '
        /^HOST_GPU_PROCESS_PERF / {
            cpu = device = generation = run = frame = -1
            backend = preference = ""
            for (i = 1; i <= NF; i++) {
                split($i, field, "=")
                if (field[1] == "cpu_us") cpu = field[2] + 0
                else if (field[1] == "device_us") device = field[2] + 0
                else if (field[1] == "generation") generation = field[2] + 0
                else if (field[1] == "run") run = field[2] + 0
                else if (field[1] == "frame") frame = field[2] + 0
                else if (field[1] == "backend") backend = field[2]
                else if (field[1] == "preference") preference = field[2]
            }
            expected = (cpu > 0 && device > 0 && cpu >= device &&
                        cpu - device >= int(device / 2) + (device % 2)) \
                ? "preferred" : "available-not-preferred"
            if (cpu <= 0 || device <= 0 || backend != "cuda" ||
                generation != seen + 2 || run != 7001 ||
                frame != seen + 91 || preference != expected) exit 1
            seen++
        }
        END { if (seen != 8) exit 1 }
        ' "$DAEMON_LOG"
    elif grep -q '^HOST_GPU_PROCESS_PERF ' "$DAEMON_LOG"; then
        echo "simpleos_gpu_fallback_wire_status=fail"
        echo "simpleos_gpu_fallback_wire_reason=unexpected-cpu-verification"
        exit 1
    fi
fi
if [ "$MODE" = fallback ]; then
    echo "simpleos_gpu_fallback_wire_status=pass"
elif [ "$MODE" = device-warm-production ]; then
    echo "simpleos_gpu_device_warm_production_wire_status=pass"
else
    echo "simpleos_gpu_device_warm_wire_status=pass"
fi
