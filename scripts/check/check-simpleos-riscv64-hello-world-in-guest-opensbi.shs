#!/bin/sh
# check-simpleos-riscv64-hello-world-in-guest-opensbi.shs
#
# Proves that a HELLO WORLD program actually RUNS INSIDE SimpleOS on riscv64 and
# prints ITS OWN output to the serial console — not merely that the kernel booted.
#
# Boot is real OpenSBI v1.4 built as `fw_payload` with the guest Image embedded,
# handed to QEMU as `-bios` ONLY. NEVER QEMU `-kernel`, NEVER isa-debug-exit:
# fw_dynamic's next-stage address is populated by QEMU's `-kernel` machinery,
# which is exactly the banned pass semantics, whereas fw_payload is a real
# board-shipping configuration (how OpenSBI ships on flash on JH7110-class
# boards) — the FIRMWARE performs the S-mode handover to 0x80200000. The full
# rationale lives in check-simpleos-riscv64-opensbi-guest-boot.shs, whose
# firmware construction this gate reuses. The assembled QEMU argv is
# self-checked for both forbidden flags before the VM is started.
#
# TWO PROGRAM ROWS ARE IN SCOPE:
#   native      A hello world WRITTEN IN SIMPLE
#               (examples/09_embedded/simple_os/arch/riscv64/hello_world_sbi_entry.spl),
#               compiled to a freestanding riscv64 Image by the RUST SEED — the
#               pure-Simple self-hosted compiler cannot compile anything in this
#               tree yet. Its own output marker must appear on serial.
#   interpreter Hello world evaluated by the Simple INTERPRETER running in-guest.
#               There is NO in-guest Simple interpreter payload in this tree for
#               riscv64 (the same gap the x86_64 and aarch64 siblings report).
#               This row is ADVISORY and reported RED unless
#               SIMPLEOS_HELLO_INTERP_ELF names an interpreter payload; it never
#               contributes to the PASS count and never turns a RED lane green.
#
# HONEST SCOPE: the native program runs in S-mode (kernel mode), not as a U-mode
# task loaded off the guest's own filesystem. riscv64 does have a
# `_rv64_enter_user` path (arch/riscv64/entry.spl), but reaching it requires the
# full scheduler + ELF-loader closure. What is proven is: real firmware ->
# firmware-performed S-mode handover -> Simple-compiled guest code executing and
# emitting its own marker.
#
# RUNGS (serial log), all required:
#   L1  "OpenSBI v"                                     real firmware ran
#   L2  "[hello] SimpleOS riscv64 hello-world in-guest" firmware handed off to the guest
#   L3  "[hello] serial up, invoking"                   16550 console up
#   L4  "HELLO_NATIVE_SIMPLEOS_RISCV64_OK"              *** THE PROGRAM'S OWN OUTPUT ***
#   L5  "[hello] native program exited rc=0"            program returned cleanly
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> program(s) checked, ...   exit 0
#   FAIL  — ...                           exit 1
#   ERROR — nothing was checked: ...      exit 2
# 0 programs executed is an ERROR, never a PASS. Offline with no cached OpenSBI
# checkout is an ERROR, never a PASS.
#
# `--selftest` (also run, fatally, before every real scan) proves the serial
# evaluator and the argv guard on fixtures.
#
# Env: SIMPLE_BIN (fresh seed), SKIP_KERNEL=1, BOOT_WAIT (90), OPENSBI_SRC,
#      SIMPLEOS_HELLO_INTERP_ELF (opt-in).
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT"

OUT=$ROOT/build/os/riscv64_hello
IMAGE=$OUT/kernel.Image
WORK=$OUT/run
LOG=$WORK/serial.log
BOOT_WAIT=${BOOT_WAIT:-90}
SIMPLE_BIN=${SIMPLE_BIN:-$ROOT/src/compiler_rust/target/release/simple}
OPENSBI_SRC=${OPENSBI_SRC:-$ROOT/build/os/rv64_opensbi_guest/opensbi-src}
OPENSBI_TAG=v1.4
OPENSBI_SHA=a2b255b88918715173942f2c5e1f97ac9e90c877  # v1.4 peeled commit, same pin as the sibling gates

NATIVE_MARKER='HELLO_NATIVE_SIMPLEOS_RISCV64_OK'
INTERP_MARKER='HELLO_INTERP_SIMPLEOS_RISCV64_OK'

fail()    { printf 'FAIL — %s\n' "$1"; exit 1; }
nothing() { printf 'ERROR — nothing was checked: %s\n' "$1"; exit 2; }

# ---------------------------------------------------------------------------
# scan_rungs <log> — 0 when every required rung is present, 1 otherwise.
# Anchored on the PROGRAM's own marker, deliberately not on line counts or the
# firmware banner: a complete boot transcript with the program silent must FAIL.
# ---------------------------------------------------------------------------
scan_rungs() {
    sl=$1
    [ -s "$sl" ] || return 1
    for rung in \
        'OpenSBI v' \
        '[hello] SimpleOS riscv64 hello-world in-guest' \
        '[hello] serial up, invoking' \
        "$NATIVE_MARKER" \
        '[hello] native program exited rc=0'
    do
        grep -aqF "$rung" "$sl" || return 1
    done
    return 0
}

# argv self-check. Needles are assembled from fragments so this check can
# neither be defeated by, nor accidentally fire on, the surrounding prose.
assert_real_firmware_argv() {
    k_flag="-kern""el"
    d_dev="isa-debug""-exit"
    case " $1 " in
        *" $k_flag "*) echo "argv uses QEMU $k_flag pass semantics"; return 1 ;;
    esac
    case "$1" in
        *"$d_dev"*) echo "argv uses $d_dev"; return 1 ;;
    esac
    case "$1" in
        *"-bios "*) ;;
        *) echo "argv has no -bios firmware"; return 1 ;;
    esac
    return 0
}

selftest() {
    st=$(mktemp -d "${TMPDIR:-/tmp}/hello-riscv64-selftest.XXXXXX")
    st_fail=0
    n=0

    # (1) must-PASS: every rung present.
    {
        echo 'OpenSBI v1.4'
        echo '[hello] SimpleOS riscv64 hello-world in-guest (OpenSBI fw_payload)'
        echo '[hello] serial up, invoking the Simple hello-world program'
        echo "$NATIVE_MARKER hello world from Simple"
        echo '[hello] native program exited rc=0'
    } > "$st/good.log"
    n=$((n+1))
    scan_rungs "$st/good.log" || { echo "selftest: must-PASS fixture did not pass" >&2; st_fail=1; }

    # (2) must-FAIL: BOOT-LOG-ONLY. Firmware and kernel came up, program silent.
    #     This is the exact vacuous-green this gate exists to prevent.
    grep -av "$NATIVE_MARKER" "$st/good.log" | grep -av 'exited rc=0' > "$st/bootonly.log"
    n=$((n+1))
    if scan_rungs "$st/bootonly.log"; then
        echo "selftest: boot-log-only fixture wrongly passed" >&2; st_fail=1
    fi

    # (3) must-FAIL: firmware banner ONLY — no guest at all.
    printf 'OpenSBI v1.4\nPlatform Name: riscv-virtio,qemu\n' > "$st/fw.log"
    n=$((n+1))
    if scan_rungs "$st/fw.log"; then
        echo "selftest: firmware-only fixture wrongly passed" >&2; st_fail=1
    fi

    # (4) must-FAIL: program ran but exited non-zero.
    sed 's/exited rc=0/exited rc=nonzero/' "$st/good.log" > "$st/rc.log"
    n=$((n+1))
    if scan_rungs "$st/rc.log"; then
        echo "selftest: non-zero-exit fixture wrongly passed" >&2; st_fail=1
    fi

    # (5) must-FAIL: empty log — nothing executed.
    : > "$st/empty.log"
    n=$((n+1))
    if scan_rungs "$st/empty.log"; then
        echo "selftest: empty fixture wrongly passed" >&2; st_fail=1
    fi

    # (6) must-FAIL: guest output present but NO firmware banner — i.e. the
    #     artifact was started some way other than through real firmware.
    grep -av 'OpenSBI v' "$st/good.log" > "$st/nofw.log"
    n=$((n+1))
    if scan_rungs "$st/nofw.log"; then
        echo "selftest: firmware-less transcript wrongly passed" >&2; st_fail=1
    fi

    # (7) must-PASS argv.
    n=$((n+1))
    assert_real_firmware_argv "-machine virt -bios fw_payload.bin -serial file:x" >/dev/null \
        || { echo "selftest: clean argv wrongly rejected" >&2; st_fail=1; }

    # (8) must-FAIL argv: -kernel pass semantics.
    n=$((n+1))
    if assert_real_firmware_argv "-machine virt -bios fw.bin -kern""el k.Image" >/dev/null 2>&1; then
        echo "selftest: -kernel argv wrongly accepted" >&2; st_fail=1
    fi

    # (9) must-FAIL argv: isa-debug-exit.
    n=$((n+1))
    if assert_real_firmware_argv "-machine virt -bios fw.bin -device isa-debug""-exit" >/dev/null 2>&1; then
        echo "selftest: isa-debug-exit argv wrongly accepted" >&2; st_fail=1
    fi

    # (10) must-FAIL argv: no firmware at all.
    n=$((n+1))
    if assert_real_firmware_argv "-machine virt -serial file:x" >/dev/null 2>&1; then
        echo "selftest: firmware-less argv wrongly accepted" >&2; st_fail=1
    fi

    rm -rf "$st"
    [ "$st_fail" -eq 0 ] || return 1
    printf '[hello-riscv64] selftest OK (%s fixtures)\n' "$n"
    return 0
}

selftest || nothing "selftest failed — the serial evaluator cannot be trusted"
if [ "${1:-}" = "--selftest" ]; then
    printf 'PASS — 10 selftest fixture(s) checked, serial evaluator and argv guard discriminate\n'
    exit 0
fi

# The gate writes build logs under $OUT before $WORK is created below; on a
# clean checkout (CI) that directory does not exist yet, and the redirect fails
# with "Directory nonexistent" before the build ever runs.
mkdir -p "$OUT"

# --- build the guest Image (Simple source -> flat Image, by the Rust seed) ---
if [ "${SKIP_KERNEL:-0}" != "1" ]; then
    SIMPLE_BIN="$SIMPLE_BIN" sh "$ROOT/scripts/os/build-simpleos-riscv64-hello-kernel.shs" >"$OUT/gate-kernel.log" 2>&1 \
        || nothing "hello kernel build failed: $(tail -1 "$OUT/gate-kernel.log" 2>/dev/null)"
fi
[ -s "$IMAGE" ] || nothing "missing flat Image $IMAGE"

command -v qemu-system-riscv64 >/dev/null 2>&1 || nothing "missing qemu-system-riscv64"
OPENSBI_CROSS=
for c in riscv64-linux-gnu- riscv64-unknown-elf-; do
    command -v "${c}gcc" >/dev/null 2>&1 && { OPENSBI_CROSS=$c; break; }
done
[ -n "$OPENSBI_CROSS" ] || nothing "no riscv64 cross-gcc to build OpenSBI"

mkdir -p "$WORK"

# --- OpenSBI v1.4 checkout: reuse the pinned one, else clone -----------------
if [ -d "$OPENSBI_SRC/.git" ]; then
    have=$(git -C "$OPENSBI_SRC" rev-parse HEAD 2>/dev/null || echo none)
    [ "$have" = "$OPENSBI_SHA" ] \
        || nothing "OpenSBI checkout $OPENSBI_SRC is at $have, not pinned $OPENSBI_SHA — refusing to build unpinned firmware"
else
    git clone --depth 1 --branch "$OPENSBI_TAG" \
        https://github.com/riscv-software-src/opensbi.git "$OPENSBI_SRC" >"$WORK/clone.log" 2>&1 \
        || nothing "no cached OpenSBI checkout and clone failed (offline?) — see $WORK/clone.log"
    have=$(git -C "$OPENSBI_SRC" rev-parse HEAD)
    [ "$have" = "$OPENSBI_SHA" ] || nothing "cloned OpenSBI $OPENSBI_TAG is $have, not pinned $OPENSBI_SHA"
fi

# --- build fw_payload: REAL FIRMWARE with the hello guest embedded ----------
make -C "$OPENSBI_SRC" PLATFORM=generic CROSS_COMPILE="$OPENSBI_CROSS" \
    FW_PAYLOAD=y FW_PAYLOAD_PATH="$IMAGE" FW_PAYLOAD_OFFSET=0x200000 -j4 \
    >"$WORK/opensbi-build.log" 2>&1 \
    || { tail -20 "$WORK/opensbi-build.log" >&2; nothing "OpenSBI fw_payload build failed"; }
FW=$OPENSBI_SRC/build/platform/generic/firmware/fw_payload.bin
[ -s "$FW" ] || nothing "fw_payload.bin missing after build"

rm -f "$LOG"

# --- assemble the argv FIRST, self-check it, then boot ----------------------
QEMU_ARGS="-no-user-config -machine virt -cpu rv64 -smp 1 -m 512M"
QEMU_ARGS="$QEMU_ARGS -bios $FW"
QEMU_ARGS="$QEMU_ARGS -serial file:$LOG"
QEMU_ARGS="$QEMU_ARGS -display none -monitor none -net none -no-reboot"

why=$(assert_real_firmware_argv "$QEMU_ARGS") \
    || fail "$why (script bug, not an environment gap)"

# The guest parks in crt0.S's wfi loop, so QEMU never exits on its own and
# `timeout` killing it is the NORMAL path. The transcript is the artifact.
# shellcheck disable=SC2086
timeout "$BOOT_WAIT" qemu-system-riscv64 $QEMU_ARGS >/dev/null 2>&1 || true

[ -s "$LOG" ] || fail "serial log is empty — the guest produced no output at all (log: $LOG)"

n_programs=0
scan_rungs "$LOG" \
    || fail "the hello-world program did not run to completion in-guest; required rungs are missing (log: $LOG)"
n_programs=$((n_programs + 1))

interp_note='interpreter row RED: no in-guest Simple interpreter payload exists for riscv64'
if grep -aqF "$INTERP_MARKER" "$LOG"; then
    interp_note='interpreter row GREEN'
    n_programs=$((n_programs + 1))
fi

[ "$n_programs" -gt 0 ] || nothing "no programs were executed (log: $LOG)"
n_lines=$(wc -l <"$LOG" | tr -d ' ')

printf 'PASS — %s program(s) checked, a Simple hello world compiled by the RUST SEED ran in-guest on SimpleOS riscv64 under real OpenSBI %s firmware via -bios fw_payload (no -kernel, no isa-debug-exit) and printed its own output; %s; %s serial line(s); log %s\n' \
    "$n_programs" "$OPENSBI_TAG" "$interp_note" "$n_lines" "$LOG"
