#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

BUILD_DIR="${BUILD_DIR:-build/simpleos_wm_fullscreen_evidence}"
REPORT_PATH="${REPORT_PATH:-doc/09_report/simpleos_wm_fullscreen_evidence_$(date -u +%F).md}"
WRAPPER="scripts/check/check-simpleos-wm-fullscreen-evidence.shs"
WRAPPER_SHA256=""
SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE:-explicit-env}"
SIMPLE_BIN_STATUS=unchecked
SIMPLE_BIN_RESOLVED=""
SIMPLE_BIN_VERSION=""
SIMPLE_BIN_SHA256=""
KERNEL_OUTPUT=""
KERNEL_SHA256=""
KERNEL_ADMISSION=""
KERNEL_BUILD_STATUS=unchecked
KERNEL_SOURCE_REVISION=""
NATIVE_BUILD_TIMEOUT_SECONDS="${SIMPLEOS_WM_NATIVE_BUILD_TIMEOUT_SECONDS:-900}"
NATIVE_BUILD_WORKER_TIMEOUT_SECONDS="${SIMPLEOS_WM_NATIVE_BUILD_WORKER_TIMEOUT_SECONDS:-870}"
LAUNCH_OUT="$BUILD_DIR/qemu.out"
SERIAL_LOG="$BUILD_DIR/serial.log"
QMP_SOCKET="$BUILD_DIR/qmp.sock"
CAPTURE_OUT="$BUILD_DIR/capture.out"
FULLSCREEN_PPM="$BUILD_DIR/fullscreen.ppm"
RESTORED_PPM="$BUILD_DIR/restored.ppm"
BROWSER_EVENT_PPM="$BUILD_DIR/browser-event.ppm"
FULLSCREEN_RAW="$FULLSCREEN_PPM.raw"
RESTORED_RAW="$RESTORED_PPM.raw"
BROWSER_EVENT_RAW="$BROWSER_EVENT_PPM.raw"
BASELINE_PPM="$BUILD_DIR/baseline.ppm"
BASELINE_RAW="$BASELINE_PPM.raw"
FONT_REGION_RGB="$BUILD_DIR/font-region.rgb"
FONT_REGION_CORRUPT_COPY="$BUILD_DIR/font-region-corrupt-calibration.rgb"
FONT_ASSET="${SIMPLEOS_WM_FONT_ASSET:-assets/fonts/google-fonts/ofl/notosansmono/NotoSansMono[wdth,wght].ttf}"
FONT_GUEST_PATH=/SYS/FONTS/NOTOSANS
THEME_SNAPSHOT_SOURCE="$ROOT_DIR/src/lib/common/ui/generated/aetheric_dark_theme_snapshot.spl"
EXPECTED_THEME_ID="aetheric_dark"
EXPECTED_THEME_SOURCE_MANIFEST_SHA256="$(sed -n 's/.*source_manifest_sha256: "\([0-9a-f][0-9a-f]*\)".*/\1/p' "$THEME_SNAPSHOT_SOURCE" | head -n 1)"
FONT_ASSET_EXPECTED_BYTES=1708408
FONT_ASSET_EXPECTED_SHA256=2cb2adb378a8f574213e23df697050b83c54c27df465a2015552740b2769a081
FONT_REGION_EXPECTED_BYTES=8064
# Filled only after a retained QEMU pmemsave proves the canonical taskbar clock.
# Pinned 2026-07-19 after the Aetheric taskbar replaced the Aqua fill. The
# checker still requires an independent host pmemsave extraction to match the
# guest-computed region before accepting the oracle.
FONT_REGION_EXPECTED_SHA256=addf76edf6d23ca9bea6d698ca1d30bc4bd8dd684bb50ff3158ef755bd2854fc
FONT_ASSET_BYTES=0
FONT_ASSET_SHA256=""
DISK_IMAGE=""
DISK_IMAGE_SHA256=""
disk_image_status=not-staged
disk_image_provenance=not-staged
BROWSER_DEMO_BINARY="build/os/apps/browser_demo/browser_demo.elf"
BROWSER_DEMO_BINARY_SHA256=""
browser_demo_build_status=not-built
browser_demo_disk_status=not-checked
QEMU_PID=""

mkdir -p "$BUILD_DIR" "$(dirname -- "$REPORT_PATH")"

# ---- per-run evidence retention (additive; canonical paths unchanged) -----
# The unconditional clear below used to DESTROY the previous run's artifacts,
# so a PASSING run's serial log (the whole point of this lane) vanished the
# moment anyone re-ran the script. Archive the previous run first.
#
# Retention policy (bounded, never unbounded growth):
#   * every invocation archives the PREVIOUS run's artifacts into
#     $BUILD_DIR/runs/<UTC-timestamp>-<verdict>/ (verdict read from that run's
#     own evidence.env), together with a RUN_INFO.env provenance stamp;
#   * at most SIMPLEOS_WM_EVIDENCE_RETAIN (default 8) archived runs are kept,
#     oldest pruned first;
#   * the newest archived PASSING run is never pruned, so the last green boot
#     evidence always survives, however many red runs follow it.
# Canonical output paths ($BUILD_DIR/serial.log, evidence.env, ...) are NOT
# moved or aliased: they always hold THIS run only, and are cleared below, so
# a retained log can never be misread as the current run's.
EVIDENCE_RUNS_DIR="$BUILD_DIR/runs"
EVIDENCE_RETAIN="${SIMPLEOS_WM_EVIDENCE_RETAIN:-8}"

archive_previous_run() {
    [ -f "$BUILD_DIR/evidence.env" ] || return 0
    prev_status="$(sed -n 's/^simpleos_wm_fullscreen_status=//p' "$BUILD_DIR/evidence.env" | head -n 1)"
    [ -n "$prev_status" ] || prev_status=unknown
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    dest="$EVIDENCE_RUNS_DIR/$stamp-$prev_status"
    dup=0
    while [ -e "$dest" ]; do
        dup=$((dup + 1))
        dest="$EVIDENCE_RUNS_DIR/$stamp-$prev_status.$dup"
    done
    mkdir -p "$dest" || return 0
    for retained in "$BUILD_DIR/evidence.env" "$LAUNCH_OUT" "$SERIAL_LOG" \
        "$CAPTURE_OUT" "$BASELINE_PPM" "$FULLSCREEN_PPM" "$RESTORED_PPM" \
        "$BROWSER_EVENT_PPM" "$FONT_REGION_RGB"
    do
        if [ -f "$retained" ]; then
            cp -p "$retained" "$dest/" 2>/dev/null || true
        fi
    done
    {
        echo "archived_at_utc=$stamp"
        echo "archived_from=$BUILD_DIR"
        echo "archived_run_status=$prev_status"
        echo "archived_by_wrapper=$WRAPPER"
        echo "note=retained copy of a PREVIOUS run; the current run writes only the canonical \$BUILD_DIR paths"
    } >"$dest/RUN_INFO.env"
    echo "simpleos_wm_fullscreen_retained_previous_run=$dest status=$prev_status"
}

prune_archived_runs() {
    [ -d "$EVIDENCE_RUNS_DIR" ] || return 0
    keep_pass="$(ls -1 "$EVIDENCE_RUNS_DIR" 2>/dev/null | grep -E -- '-pass(\.[0-9]+)?$' | sort | tail -n 1)"
    total="$(ls -1 "$EVIDENCE_RUNS_DIR" 2>/dev/null | wc -l | tr -d ' ')"
    [ "$total" -gt "$EVIDENCE_RETAIN" ] || return 0
    excess=$((total - EVIDENCE_RETAIN))
    for stale in $(ls -1 "$EVIDENCE_RUNS_DIR" 2>/dev/null | sort); do
        [ "$excess" -gt 0 ] || break
        [ "$stale" = "$keep_pass" ] && continue
        rm -rf "$EVIDENCE_RUNS_DIR/$stale"
        excess=$((excess - 1))
    done
}

archive_previous_run
prune_archived_runs

rm -f "$LAUNCH_OUT" "$SERIAL_LOG" "$QMP_SOCKET" "$CAPTURE_OUT" \
    "$BASELINE_PPM" "$FULLSCREEN_PPM" "$RESTORED_PPM" \
    "$BROWSER_EVENT_PPM" "$BASELINE_RAW" "$FULLSCREEN_RAW" "$RESTORED_RAW" \
    "$BROWSER_EVENT_RAW" \
    "$FONT_REGION_RGB" "$FONT_REGION_CORRUPT_COPY" "$BUILD_DIR/evidence.env"

resolve_path() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1" 2>/dev/null || true
    elif command -v readlink >/dev/null 2>&1; then
        readlink -f "$1" 2>/dev/null || true
    else
        return 0
    fi
}

is_rust_seed_path() {
    case "$1" in
        *"/src/compiler_rust/"*|*"/compiler_rust/target/"*) return 0 ;;
        *) return 1 ;;
    esac
}

if [ -z "${SIMPLE_BIN:-}" ]; then
    SIMPLE_BIN=""
    SIMPLE_BIN_SOURCE=auto-cached-pure-simple
    for candidate in \
        "$ROOT_DIR"/build/bootstrap/stage3/*/simple \
        "$ROOT_DIR"/build/bootstrap/stage2/*/simple \
        "$ROOT_DIR"/bin/release/*/simple \
        "$ROOT_DIR"/release/*/simple \
        "$ROOT_DIR"/bin/simple
    do
        if [ -x "$candidate" ]; then
            resolved="$(resolve_path "$candidate")"
            if [ -n "$resolved" ] && ! is_rust_seed_path "$resolved"; then
                SIMPLE_BIN="$candidate"
                break
            fi
        fi
    done
fi
export SIMPLE_BIN SIMPLE_BIN_SOURCE SIMPLE_BIN_STATUS SIMPLE_BIN_RESOLVED SIMPLE_BIN_VERSION SIMPLE_BIN_SHA256

cleanup() {
    if [ -n "$QEMU_PID" ]; then
        kill "$QEMU_PID" >/dev/null 2>&1 || true
        wait "$QEMU_PID" >/dev/null 2>&1 || true
    fi
    pkill -f "qemu-system.*$QMP_SOCKET" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

file_byte_count() {
    if [ -f "$1" ]; then
        wc -c <"$1" | tr -d ' '
    else
        echo 0
    fi
}

file_sha256() {
    if [ ! -f "$1" ]; then
        echo ""
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        echo ""
    fi
}

font_region_oracle_status() {
    if [ "$(file_byte_count "$1")" = "$FONT_REGION_EXPECTED_BYTES" ] && \
       [ "$(file_sha256 "$1")" = "$FONT_REGION_EXPECTED_SHA256" ]; then
        echo pass
    else
        echo fail
    fi
}

is_sha256() {
    [ "${#1}" -eq 64 ] && case "$1" in
        *[!0-9a-f]*) false ;;
        *) true ;;
    esac
}

# ---- kernel input set (the files the built kernel actually depends on) -----
#
# WHY THIS IS NOT A WHOLE-TREE HASH ANY MORE.
#
# The previous implementation content-hashed EVERY .spl/.c/.h/.s/.S/.ld file
# under src/os + src/lib + build/os/generated + the x86_64 example dir --
# 9,608 files -- once before the ~151s kernel build and once after, and aborted
# the whole run with `wm-simple-web-build-source-changed` on any difference.
# The refusal window was therefore `2 x full-tree scan + build`, over a set
# roughly 7x larger than what the kernel links. On this shared machine a
# neighbouring session writing ANY file under src/lib -- e.g. the
# src/lib/gc_async_mut/gpu/engine2d/backend_vulkan_* files another lane rewrites
# continuously -- aborted a run its edit could not possibly affect. Six lane
# attempts across two agents died this way; see
# doc/08_tracking/bug/wm_lane_source_hash_gate_trips_on_foreign_session_bulk_write_2026-08-09.md
#
# WHAT IS HASHED NOW: the kernel's real input set, defined two independent ways
# and UNIONED (a union can only ever be a superset, so it cannot fail open):
#
#   (1) IMPORT CLOSURE -- the transitive `use` closure of the actual compiler
#       inputs: the `--entry` file plus every file under the `--source`
#       directory build/os/generated. This is the compiler's own definition of
#       what it compiles. Cross-check: the build reports "5 compiled, 750
#       cached" = 755 modules; the closure resolves 1,313 files, a superset.
#       Module resolution mirrors the compiler's rules (`std.` -> src/lib,
#       tier-relative and tier-fallback lookups, dir/mod.spl, sibling-relative).
#       Where a module path cannot be resolved exactly, EVERY file whose
#       basename matches is admitted -- ambiguity always widens the set.
#
#   (2) LINKED-SYMBOL REPAIR -- `nm` on the kernel ELF yields the symbols the
#       artifact genuinely links. Any file OUTSIDE the closure that defines a
#       linked symbol which NO closure file defines is added. This is the
#       backstop for a resolver gap: it repairs the closure using the built
#       artifact itself rather than trusting the resolver. Before this repair
#       existed the measured gap was 7 symbols; the repair closes it.
#
#   (3) All non-.spl inputs (.c/.h/.s/.S/.ld, 193 files) under the same roots,
#       minus foreign-architecture sources, are hashed unconditionally. They are
#       few, they are link inputs, and they do not churn.
#
# FAIL-CLOSED PROPERTIES (do not weaken any of these):
#   * An empty or too-small input set is an ERROR, never a pass
#     (KERNEL_INPUT_MIN_FILES floor + the entry file must be present).
#   * Any file that hashes to something that is not a sha256 is an ERROR.
#   * A missing source root is an ERROR.
#   * The FILE LIST is computed once per run and reused for the before/after
#     hashes, so a mid-build edit to a listed file always changes the revision.
#     An edit that adds a new import to a listed file also changes that listed
#     file's own content, so it is caught too.
#   * The set is only ever widened by ambiguity, never narrowed.
KERNEL_SOURCE_ROOTS="src/os src/lib build/os/generated examples/09_embedded/simple_os/arch/x86_64"
KERNEL_INPUT_LIST="$BUILD_DIR/kernel-input-files.txt"
KERNEL_INPUT_STATUS_FILE="$BUILD_DIR/kernel-input-status"
KERNEL_INPUT_COUNT=0
KERNEL_INPUT_SET_STATUS=unresolved
KERNEL_INPUT_MIN_FILES="${SIMPLEOS_WM_KERNEL_INPUT_MIN_FILES:-200}"
# A build that loses the mid-build source race against a concurrent session is
# retried, not failed. Admission itself is unchanged (see the retry loop).
KERNEL_BUILD_MAX_ATTEMPTS="${SIMPLEOS_WM_KERNEL_BUILD_MAX_ATTEMPTS:-3}"
KERNEL_BUILD_ATTEMPTS=0
# Each invocation resolves the input set from scratch; a stale list from a
# previous run must never be reused.
rm -f "$KERNEL_INPUT_LIST" "$KERNEL_INPUT_STATUS_FILE"

set_kernel_input_status() {
    KERNEL_INPUT_SET_STATUS="$1"
    printf '%s\n' "$1" >"$KERNEL_INPUT_STATUS_FILE"
}

kernel_input_closure_awk='
function addf(p) {
    if ((p in idx) && !(p in seen)) { seen[p] = 1; q[++qn] = p }
}
function try_path(cand,    c) {
    c = cand
    sub(/^src\/std\//, "src/lib/", c)
    if (c in idx) { addf(c); return 1 }
    return 0
}
function resolve(m, dir,    mm, rest, tail, k, nn, parts2, base, cnt, arr, i, t, found) {
    found = 0
    if (index(m, ".") == 0) {
        k = dir "\t" m
        if (k in sib) { addf(sib[k]); found = 1 }
    }
    mm = m; gsub(/\./, "/", mm)
    if (try_path("src/" mm ".spl")) found = 1
    if (try_path("src/lib/" mm ".spl")) found = 1
    if (try_path("src/" mm "/mod.spl")) found = 1
    if (try_path("src/lib/" mm "/mod.spl")) found = 1
    rest = mm
    if (sub(/^std\//, "", rest)) {
        if (try_path("src/lib/" rest ".spl")) found = 1
        if (try_path("src/lib/" rest "/mod.spl")) found = 1
    }
    tail = rest
    sub(/^[^\/]+\//, "", tail)
    for (t in tiers) {
        if (try_path("src/lib/" t "/" rest ".spl")) found = 1
        if (try_path("src/lib/" t "/" rest "/mod.spl")) found = 1
        if (tail != rest) {
            if (try_path("src/lib/" t "/" tail ".spl")) found = 1
            if (try_path("src/lib/" t "/" tail "/mod.spl")) found = 1
        }
    }
    if (found) return
    nn = split(m, parts2, ".")
    base = parts2[nn]
    if (base == "mod" && nn > 1) base = parts2[nn - 1]
    if (base in byBase) {
        cnt = split(byBase[base], arr, "\t")
        for (i = 1; i <= cnt; i++) addf(arr[i])
        return
    }
}
{
    path = $0
    idx[path] = 1
    n = split(path, parts, "/")
    base = parts[n]
    sub(/\.spl$/, "", base)
    dir = substr(path, 1, length(path) - length(parts[n]) - 1)
    sib[dir "\t" base] = path
    if (base in byBase) byBase[base] = byBase[base] "\t" path
    else byBase[base] = path
    if (path ~ /^build\/os\/generated\//) seeds[path] = 1
    if (path ~ /^src\/lib\/[^\/]+\//) tiers[parts[3]] = 1
}
END {
    seeds[entry] = 1
    qn = 0
    for (p in seeds) addf(p)
    head = 1
    while (head <= qn) {
        f = q[head++]
        n = split(f, parts, "/")
        dir = substr(f, 1, length(f) - length(parts[n]) - 1)
        while ((getline line < f) > 0) {
            if (line !~ /^[ \t]*use[ \t]/) continue
            sub(/^[ \t]*use[ \t]+/, "", line)
            if (match(line, /^[A-Za-z_][A-Za-z0-9_.]*/) == 0) continue
            m = substr(line, 1, RLENGTH)
            sub(/\.$/, "", m)
            resolve(m, dir)
        }
        close(f)
    }
    for (p in seen) print p
}
'

# Files outside the closure that define a linked symbol no closure file defines.
kernel_input_repair_awk='
function scan(f,    line, s) {
    while ((getline line < f) > 0) {
        if (match(line, /^[ \t]*(pub[ \t]+)?fn[ \t]+[A-Za-z_][A-Za-z0-9_]*/) == 0) continue
        s = substr(line, RSTART, RLENGTH)
        sub(/^.*[ \t]/, "", s)
        if (mode == "inc") incsym[s] = 1
        else if ((s in linked) && !(s in incsym)) { print f; close(f); return }
    }
    close(f)
}
BEGIN {
    while ((getline line < symfile) > 0) linked[line] = 1
    close(symfile)
    mode = "inc"
    while ((getline line < incfile) > 0) scan(line)
    close(incfile)
    mode = "out"
    while ((getline line < outfile) > 0) scan(line)
    close(outfile)
}
'

kernel_input_set_resolve() {
    # Computes $KERNEL_INPUT_LIST exactly once per run. Echoes the file count
    # (0 means the input set could not be determined -> caller must ERROR).
    if [ -s "$KERNEL_INPUT_LIST" ]; then
        wc -l <"$KERNEL_INPUT_LIST" | tr -d ' '
        return
    fi
    for source_root in $KERNEL_SOURCE_ROOTS; do
        if [ ! -d "$source_root" ]; then
            set_kernel_input_status "missing-root:$source_root"
            echo 0
            return
        fi
    done
    work="$(mktemp -d "$BUILD_DIR/kernel-input.XXXXXX")" || { echo 0; return; }
    find $KERNEL_SOURCE_ROOTS -type f -name '*.spl' -print \
        | LC_ALL=C sort -u >"$work/index"
    awk -v entry="$ENTRY" "$kernel_input_closure_awk" "$work/index" \
        | LC_ALL=C sort -u >"$work/closure"
    if [ ! -s "$work/closure" ]; then
        set_kernel_input_status closure-empty
        rm -rf "$work"
        echo 0
        return
    fi
    LC_ALL=C comm -23 "$work/index" "$work/closure" >"$work/outside"
    : >"$work/repair"
    repair_elf=""
    for elf_candidate in "$KERNEL_OUTPUT" "$KERNEL_CANDIDATE"; do
        [ -n "$elf_candidate" ] && [ -s "$elf_candidate" ] && { repair_elf="$elf_candidate"; break; }
    done
    if [ -n "$repair_elf" ] && command -v nm >/dev/null 2>&1 && \
       nm --defined-only "$repair_elf" 2>/dev/null | awk '{print $NF}' \
           | LC_ALL=C sort -u >"$work/syms" && [ -s "$work/syms" ]; then
        awk -v symfile="$work/syms" -v incfile="$work/closure" \
            -v outfile="$work/outside" "$kernel_input_repair_awk" \
            </dev/null >"$work/repair" 2>/dev/null || : >"$work/repair"
        set_kernel_input_status "closure+linked-symbol-repair"
    else
        set_kernel_input_status "closure-only-no-kernel-elf"
    fi
    find $KERNEL_SOURCE_ROOTS -type f \
        \( -name '*.c' -o -name '*.h' -o -name '*.s' -o -name '*.S' -o -name '*.ld' \) \
        ! -path '*/arch/aarch64/*' ! -path '*/arch/arm64/*' ! -path '*/arch/arm/*' \
        ! -path '*/arch/riscv/*' ! -path '*/arch/riscv32/*' ! -path '*/arch/riscv64/*' \
        ! -path '*/arch/wasm/*' ! -path '*/arch/wasm32/*' ! -path '*/arch/wasm64/*' \
        ! -name '*_aarch64.*' ! -name '*_arm64.*' ! -name '*_riscv.*' \
        ! -name '*_riscv32.*' ! -name '*_riscv64.*' ! -name '*_wasm.*' \
        -print >"$work/nonspl"
    {
        cat "$work/closure" "$work/repair" "$work/nonspl"
        printf '%s\n' "$ENTRY" "$LINKER_SCRIPT"
    } | LC_ALL=C sort -u >"$work/list"
    # Fail closed: the entry must be in its own input set, and a plausible
    # input set is never a handful of files.
    if ! grep -Fxq "$ENTRY" "$work/list"; then
        set_kernel_input_status entry-not-in-input-set
        rm -rf "$work"
        echo 0
        return
    fi
    resolved_count="$(wc -l <"$work/list" | tr -d ' ')"
    if [ "$resolved_count" -lt "$KERNEL_INPUT_MIN_FILES" ]; then
        set_kernel_input_status "below-min-files:$resolved_count"
        rm -rf "$work"
        echo 0
        return
    fi
    mv "$work/list" "$KERNEL_INPUT_LIST"
    rm -rf "$work"
    echo "$resolved_count"
}

kernel_source_revision() {
    # Echoes "<file-count> <sha256>". An empty sha256 (or a zero count) means
    # the input set could not be determined -> the caller must ERROR/BLOCK.
    input_count="$(kernel_input_set_resolve)"
    if [ -z "$input_count" ] || [ "$input_count" -le 0 ] || [ ! -s "$KERNEL_INPUT_LIST" ]; then
        printf '0 \n'
        return
    fi
    manifest="$(mktemp "$BUILD_DIR/kernel-source-manifest.XXXXXX")" || {
        printf '0 \n'
        return
    }
    while IFS= read -r source_path; do
        source_sha256="$(file_sha256 "$source_path")"
        if is_sha256 "$source_sha256"; then
            printf '%s  %s\n' "$source_sha256" "$source_path"
        else
            printf 'invalid  %s\n' "$source_path"
        fi
    done <"$KERNEL_INPUT_LIST" >"$manifest"
    manifest_lines="$(wc -l <"$manifest" | tr -d ' ')"
    if grep -q '^invalid  ' "$manifest" || [ "$manifest_lines" -ne "$input_count" ]; then
        revision=""
        input_count=0
    else
        revision="$(file_sha256 "$manifest")"
    fi
    rm -f "$manifest"
    printf '%s %s\n' "$input_count" "$revision"
}

sample_kernel_source_revision() {
    # Sets KERNEL_SOURCE_REVISION + KERNEL_INPUT_COUNT from one sampling.
    revision_pair="$(kernel_source_revision)"
    KERNEL_INPUT_COUNT="${revision_pair%% *}"
    KERNEL_SOURCE_REVISION="${revision_pair#* }"
    case "$KERNEL_INPUT_COUNT" in
        ''|*[!0-9]*) KERNEL_INPUT_COUNT=0 ;;
    esac
    if [ -s "$KERNEL_INPUT_STATUS_FILE" ]; then
        KERNEL_INPUT_SET_STATUS="$(head -n 1 "$KERNEL_INPUT_STATUS_FILE")"
    fi
}

kernel_input_verdict() {
    # The pre-push-guard convention: a passing verdict always states how many
    # files it actually hashed, so a vacuous run cannot look like a real one.
    case "$1" in
        pass)
            echo "simpleos_wm_kernel_input_verdict=PASS — $KERNEL_INPUT_COUNT file(s) hashed (set=$KERNEL_INPUT_SET_STATUS, revision=$KERNEL_SOURCE_REVISION)"
            ;;
        changed)
            echo "simpleos_wm_kernel_input_verdict=FAIL — kernel input source changed during build ($KERNEL_INPUT_COUNT file(s) hashed, set=$KERNEL_INPUT_SET_STATUS)"
            ;;
        *)
            echo "simpleos_wm_kernel_input_verdict=ERROR — nothing was checked (kernel input set unresolved: $KERNEL_INPUT_SET_STATUS)"
            ;;
    esac
}

regular_file_status() {
    path="$1"
    if [ -z "$path" ]; then
        echo "missing-path"
    elif [ -L "$path" ]; then
        echo "symlink"
    elif [ ! -f "$path" ]; then
        echo "missing"
    elif [ ! -s "$path" ]; then
        echo "empty"
    else
        echo "pass"
    fi
}

# The admitted artifact is the post-link Multiboot1 wrapper, not a compiler
# object or the pre-wrap x86_64 image.
# See doc/08_tracking/bug/simpleos_x86_64_kernel_links_as_elf32_em386_2026-07-25.md
#
# The multiboot kernel image is deliberately ELF32/EM_386:
#   - the kernel's own .o files ARE ELF64/EM_X86_64 (codegen is correct), but
#   - the final image is deliberately objcopy-wrapped to ELF32/EM_386 (grep this
#     file for "ELF32 wrap step") because GRUB loads it via multiboot1 (grep
#     `insmod multiboot` and `multiboot /boot/kernel.elf`), and multiboot1
#     mandates a 32-bit ELF. Long mode is entered afterwards, at the
#     `[BOOT64] call _start` marker this same script greps for as success.
#     (Referenced by marker text, not line number: adding this comment already
#     shifted every line below it by ~20.)
# Admission therefore verifies the wrapped ELF32/EM_386 contract here. Native
# cache objects remain independently inspectable as ELF64/EM_X86_64.
elf_file_status() {
    elf_path="$1"
    file_status="$(regular_file_status "$elf_path")"
    if [ "$file_status" != pass ]; then
        echo "$file_status"
        return
    fi
    if [ "$(od -An -tx1 -N4 "$elf_path" 2>/dev/null | tr -d ' \n')" != "7f454c46" ]; then
        echo "invalid-elf-magic"
        return
    fi
    set -- $(od -An -tu1 -j4 -N2 "$elf_path" 2>/dev/null)
    if [ "$#" -ne 2 ] || [ "$1" -ne 1 ] || [ "$2" -ne 1 ]; then
        echo "invalid-multiboot-elf32-little-endian"
        return
    fi
    set -- $(od -An -tu1 -j18 -N2 "$elf_path" 2>/dev/null)
    if [ "$#" -ne 2 ] || [ "$(( $1 + 256 * $2 ))" -ne 3 ]; then
        echo "invalid-multiboot-elf-machine"
        return
    fi
    echo pass
}

fat32_image_status() {
    file_status="$(regular_file_status "$1")"
    if [ "$file_status" != pass ]; then
        echo "$file_status"
    elif [ "$(file_byte_count "$1")" -lt 1048576 ]; then
        echo "too-small"
    elif [ "$(od -An -tx1 -N3 "$1" 2>/dev/null | tr -d ' \n')" != "eb5890" ]; then
        echo "invalid-fat32-jump"
    elif [ "$(dd if="$1" bs=1 skip=3 count=8 2>/dev/null)" != "SIMPLEOS" ]; then
        echo "invalid-simpleos-oem"
    elif [ "$(od -An -tx1 -j11 -N2 "$1" 2>/dev/null | tr -d ' \n')" != "0002" ]; then
        echo "invalid-sector-size"
    elif [ "$(od -An -tx1 -j510 -N2 "$1" 2>/dev/null | tr -d ' \n')" != "55aa" ]; then
        echo "invalid-boot-signature"
    elif command -v fsck.fat >/dev/null 2>&1; then
        if fsck.fat -n "$1" >/dev/null 2>&1; then
            echo pass
        else
            echo "invalid-fat32-structure"
        fi
    elif command -v dosfsck >/dev/null 2>&1; then
        if dosfsck -n "$1" >/dev/null 2>&1; then
            echo pass
        else
            echo "invalid-fat32-structure"
        fi
    elif command -v fsck_msdos >/dev/null 2>&1; then
        if fsck_msdos -n "$1" >/dev/null 2>&1; then
            echo pass
        else
            echo "invalid-fat32-structure"
        fi
    else
        echo "fat32-checker-unavailable"
    fi
}

browser_demo_disk_payload_status() {
    disk_path="$1"
    binary_path="$2"
    extracted="$(mktemp "$BUILD_DIR/browser-demo-smf.XXXXXX")" || {
        echo "extract-temp-failed"
        return
    }
    prefix="$(mktemp "$BUILD_DIR/browser-demo-prefix.XXXXXX")" || {
        rm -f "$extracted"
        echo "prefix-temp-failed"
        return
    }
    # Read the staged payload back OUT of the FAT32 image. mtools `mcopy` is
    # used when present; when it is absent we fall back to the in-repo FAT32
    # reader rather than reporting "mcopy-unavailable". That old status was
    # indistinguishable between "payload not staged" and "host lacks mtools",
    # and on an mtools-less host it hard-blocked the gate before QEMU ever
    # started. The fallback performs the SAME real read (walk the directory
    # chain, follow the cluster chain, write the bytes out); the byte-count and
    # ELF-prefix-sha256 checks below are unchanged and still apply.
    if command -v mcopy >/dev/null 2>&1; then
        if ! mcopy -o -i "$disk_path" ::/SYS/APPS/BROWSMF.SMF "$extracted" >/dev/null 2>&1; then
            rm -f "$extracted" "$prefix"
            echo "browser-smf-missing"
            return
        fi
    else
        # $SIMPLE_BIN is the kernel-BUILD binary and may be a stage2 bootstrap
        # that only accepts native-build subcommands ("unknown command
        # '<script>.spl'"), so fall through to the deployed interpreter. Which
        # interpreter reads the image does not affect the strength of this
        # check: the extracted bytes are still length-checked and
        # sha256-prefix-compared against the on-host ELF below, so a bad reader
        # fails closed.
        fat32_extract_ok=false
        for extract_bin in "$SIMPLE_BIN" "$ROOT_DIR/bin/simple"; do
            [ -x "$extract_bin" ] || continue
            if SIMPLE_MODULE_LIMIT="${SIMPLE_MODULE_LIMIT:-4000}" "$extract_bin" \
                    scripts/os/simpleos_fat32_extract.spl \
                    "$disk_path" /SYS/APPS/BROWSMF.SMF "$extracted" \
                    >"$BUILD_DIR/browser-demo-fat32-extract.out" 2>&1 &&
               grep -Fxq 'extract_status=pass' "$BUILD_DIR/browser-demo-fat32-extract.out"; then
                fat32_extract_ok=true
                break
            fi
        done
        if [ "$fat32_extract_ok" != true ]; then
            rm -f "$extracted" "$prefix"
            echo "browser-smf-missing"
            return
        fi
    fi
    binary_bytes="$(file_byte_count "$binary_path")"
    extracted_bytes="$(file_byte_count "$extracted")"
    if [ "$binary_bytes" -le 0 ] || [ "$extracted_bytes" -lt "$((binary_bytes + 128))" ]; then
        rm -f "$extracted" "$prefix"
        echo "browser-smf-truncated"
        return
    fi
    dd if="$extracted" of="$prefix" bs=1 count="$binary_bytes" 2>/dev/null
    if [ "$(file_sha256 "$prefix")" != "$(file_sha256 "$binary_path")" ]; then
        rm -f "$extracted" "$prefix"
        echo "browser-elf-prefix-mismatch"
        return
    fi
    rm -f "$extracted" "$prefix"
    echo pass
}

serial_has_production_fault() {
    grep -Eq '^\[fault\] \*\*\* EXCEPTION FRAME|page[- ]fault|nil receiver|invalid Simple Web frame|\[simple2d-frame-failed\]|^\[wm-frame\] (content-provenance-rejected|engine2d-draw-ir-rejected|frame-degraded)' "$SERIAL_LOG" 2>/dev/null
}

ppm_magic_status() {
    path="$1"
    if [ "$(regular_file_status "$path")" != "pass" ]; then
        regular_file_status "$path"
    elif head -c 2 "$path" 2>/dev/null | grep -q '^P6$'; then
        echo "pass"
    else
        echo "invalid-magic"
    fi
}

marker_line() {
    # First line in $1 containing literal marker text $2. Guest serial output
    # is CRLF (and sometimes CRCRLF) terminated; strip \r so trailing-anchor
    # (`$`) sed/field extraction on the result works.
    grep -a -m 1 -F "$2" "$1" 2>/dev/null | tr -d '\r' || true
}

marker_field() {
    # Extract key=value field named $2 from line $1.
    printf '%s\n' "$1" | sed -n "s/.*$2=\\([^ ]*\\).*/\\1/p"
}

emit_failure() {
    reason="$1"
    {
        echo "simpleos_wm_fullscreen_status=fail"
        echo "simpleos_wm_fullscreen_reason=$reason"
        echo "simpleos_wm_fullscreen_wrapper=$WRAPPER"
        echo "simpleos_wm_fullscreen_wrapper_sha256=$WRAPPER_SHA256"
        echo "simpleos_wm_fullscreen_simple_bin=$SIMPLE_BIN"
        echo "simpleos_wm_fullscreen_simple_bin_resolved=$SIMPLE_BIN_RESOLVED"
        echo "simpleos_wm_fullscreen_simple_bin_source=$SIMPLE_BIN_SOURCE"
        echo "simpleos_wm_fullscreen_simple_bin_status=$SIMPLE_BIN_STATUS"
        echo "simpleos_wm_fullscreen_simple_bin_version=$SIMPLE_BIN_VERSION"
        echo "simpleos_wm_fullscreen_simple_bin_sha256=$SIMPLE_BIN_SHA256"
        echo "simpleos_wm_fullscreen_qemu_out=$LAUNCH_OUT"
        echo "simpleos_wm_fullscreen_serial_log=$SERIAL_LOG"
        echo "simpleos_wm_fullscreen_serial_log_bytes=$(file_byte_count "$SERIAL_LOG")"
        echo "simpleos_wm_fullscreen_kernel=$KERNEL_OUTPUT"
        echo "simpleos_wm_fullscreen_kernel_sha256=$KERNEL_SHA256"
        echo "simpleos_wm_fullscreen_kernel_admission=$KERNEL_ADMISSION"
        echo "simpleos_wm_fullscreen_kernel_admission_sha256=$(file_sha256 "$KERNEL_ADMISSION")"
        echo "simpleos_wm_fullscreen_kernel_source_input_files=$KERNEL_INPUT_COUNT"
        echo "simpleos_wm_fullscreen_kernel_source_input_set=$KERNEL_INPUT_SET_STATUS"
        echo "simpleos_wm_fullscreen_kernel_source_revision_sha256=$KERNEL_SOURCE_REVISION"
        echo "simpleos_wm_fullscreen_kernel_build_status=$KERNEL_BUILD_STATUS"
        echo "simpleos_wm_fullscreen_kernel_build_attempts=$KERNEL_BUILD_ATTEMPTS"
        echo "simpleos_wm_fullscreen_native_build_timeout_seconds=$NATIVE_BUILD_TIMEOUT_SECONDS"
        echo "simpleos_wm_fullscreen_disk_image=$DISK_IMAGE"
        echo "simpleos_wm_fullscreen_disk_image_status=$disk_image_status"
        echo "simpleos_wm_fullscreen_disk_image_provenance=$disk_image_provenance"
        echo "simpleos_wm_fullscreen_disk_image_sha256=$DISK_IMAGE_SHA256"
        echo "simpleos_wm_fullscreen_browser_demo_binary=$BROWSER_DEMO_BINARY"
        echo "simpleos_wm_fullscreen_browser_demo_binary_sha256=$BROWSER_DEMO_BINARY_SHA256"
        echo "simpleos_wm_fullscreen_browser_demo_build_status=$browser_demo_build_status"
        echo "simpleos_wm_fullscreen_browser_demo_disk_status=$browser_demo_disk_status"
        echo "simpleos_wm_fullscreen_font_asset=$FONT_ASSET"
        echo "simpleos_wm_fullscreen_font_asset_bytes=$FONT_ASSET_BYTES"
        echo "simpleos_wm_fullscreen_font_asset_sha256=$FONT_ASSET_SHA256"
        echo "simpleos_wm_fullscreen_font_region_rgb=$FONT_REGION_RGB"
        echo "simpleos_wm_fullscreen_font_region_rgb_bytes=$(file_byte_count "$FONT_REGION_RGB")"
        echo "simpleos_wm_fullscreen_font_region_rgb_sha256=$(file_sha256 "$FONT_REGION_RGB")"
    } >"$BUILD_DIR/evidence.env"
    {
        echo "# SimpleOS WM Fullscreen Evidence"
        echo
        echo "- status: fail"
        echo "- reason: $reason"
        echo "- wrapper: $WRAPPER (sha256=$WRAPPER_SHA256)"
        echo "- simple bin: $SIMPLE_BIN"
        echo "- resolved binary: $SIMPLE_BIN_RESOLVED"
        echo "- simple bin source: $SIMPLE_BIN_SOURCE"
        echo "- simple bin status: $SIMPLE_BIN_STATUS"
        echo "- simple bin version: $SIMPLE_BIN_VERSION"
        echo "- simple bin sha256: $SIMPLE_BIN_SHA256"
        echo "- kernel: $KERNEL_OUTPUT (sha256=$KERNEL_SHA256)"
        echo "- kernel build: $KERNEL_BUILD_STATUS (wall timeout=${NATIVE_BUILD_TIMEOUT_SECONDS}s)"
        echo "- disk image: $DISK_IMAGE ($disk_image_status, provenance=$disk_image_provenance, sha256=$DISK_IMAGE_SHA256)"
    } >"$REPORT_PATH"
    cat "$BUILD_DIR/evidence.env"
}

WRAPPER_SHA256="$(file_sha256 "$WRAPPER")"
if ! is_sha256 "$WRAPPER_SHA256"; then
    emit_failure "artifact-sha256-invalid"
    exit 1
fi

SIMPLE_BIN_RESOLVED="$(resolve_path "${SIMPLE_BIN:-missing}")"
if is_rust_seed_path "${SIMPLE_BIN:-}" || is_rust_seed_path "$SIMPLE_BIN_RESOLVED"; then
    SIMPLE_BIN_STATUS=forbidden
    SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE}-rust-seed-forbidden"
    emit_failure "simple-bin-forbidden"
    exit 1
fi

if [ -z "${SIMPLE_BIN:-}" ] || [ ! -x "$SIMPLE_BIN" ] || [ -z "$SIMPLE_BIN_RESOLVED" ]; then
    SIMPLE_BIN_STATUS=missing
    emit_failure "simple-bin-missing"
    exit 1
fi

if ! SIMPLE_BIN_VERSION_RAW="$("$SIMPLE_BIN" --version 2>&1)"; then
    SIMPLE_BIN_STATUS=unverified
    emit_failure "simple-bin-provenance-unverified"
    exit 1
fi
SIMPLE_BIN_VERSION="$(printf '%s' "$SIMPLE_BIN_VERSION_RAW" | tr '\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g; s/ $//')"
SIMPLE_BIN_SHA256="$(file_sha256 "$SIMPLE_BIN_RESOLVED")"
case "$(printf '%s' "$SIMPLE_BIN_VERSION" | tr '[:upper:]' '[:lower:]')" in
    *rust-built*|*rust*seed*|*bootstrap*seed*)
        SIMPLE_BIN_STATUS=forbidden
        SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE}-provenance-forbidden"
        emit_failure "simple-bin-forbidden"
        exit 1
        ;;
esac
if [ -z "$SIMPLE_BIN_VERSION" ] || ! is_sha256 "$SIMPLE_BIN_SHA256"; then
    SIMPLE_BIN_STATUS=unverified
    emit_failure "simple-bin-provenance-unverified"
    exit 1
fi
SIMPLE_BIN_STATUS=pass

FONT_ASSET_BYTES="$(file_byte_count "$FONT_ASSET")"
FONT_ASSET_SHA256="$(file_sha256 "$FONT_ASSET")"
if [ "$FONT_ASSET_BYTES" != "$FONT_ASSET_EXPECTED_BYTES" ] || \
   [ "$FONT_ASSET_SHA256" != "$FONT_ASSET_EXPECTED_SHA256" ]; then
    emit_failure "pinned-font-asset-invalid"
    exit 1
fi

if ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
    emit_failure "qemu-system-x86_64-not-found"
    exit 1
fi

# grub-mkstandalone: bare name on Linux; homebrew's x86_64-elf-grub formula
# prefixes it on macOS. Same tool, same x86_64-efi output.
GRUB_MKSTANDALONE="${GRUB_MKSTANDALONE:-}"
if [ -z "$GRUB_MKSTANDALONE" ]; then
    if command -v grub-mkstandalone >/dev/null 2>&1; then
        GRUB_MKSTANDALONE=grub-mkstandalone
    elif command -v x86_64-elf-grub-mkstandalone >/dev/null 2>&1; then
        GRUB_MKSTANDALONE=x86_64-elf-grub-mkstandalone
    else
        # Homebrew keeps the cross-GRUB formula keg-only, so its executable is
        # installed but not normally present on PATH.
        for grub_candidate in \
            /opt/homebrew/opt/x86_64-elf-grub/bin/x86_64-elf-grub-mkstandalone \
            /usr/local/opt/x86_64-elf-grub/bin/x86_64-elf-grub-mkstandalone; do
            if [ -x "$grub_candidate" ]; then
                GRUB_MKSTANDALONE=$grub_candidate
                break
            fi
        done
    fi
fi
if [ -z "$GRUB_MKSTANDALONE" ]; then
    emit_failure "grub-mkstandalone-not-found"
    exit 1
fi
OVMF_CODE="${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}"
OVMF_VARS_SRC="${OVMF_VARS_SRC:-/usr/share/OVMF/OVMF_VARS_4M.fd}"
# macOS/homebrew fallback: qemu ships edk2 firmware images instead of the
# Linux OVMF package paths (vars image is the shared edk2-i386-vars.fd).
if [ ! -f "$OVMF_CODE" ] && [ -f /opt/homebrew/share/qemu/edk2-x86_64-code.fd ]; then
    OVMF_CODE=/opt/homebrew/share/qemu/edk2-x86_64-code.fd
fi
if [ ! -f "$OVMF_VARS_SRC" ] && [ -f /opt/homebrew/share/qemu/edk2-i386-vars.fd ]; then
    OVMF_VARS_SRC=/opt/homebrew/share/qemu/edk2-i386-vars.fd
fi
if [ ! -f "$OVMF_CODE" ]; then
    emit_failure "ovmf-code-not-found:$OVMF_CODE"
    exit 1
fi
if [ ! -f "$OVMF_VARS_SRC" ]; then
    emit_failure "ovmf-vars-not-found:$OVMF_VARS_SRC"
    exit 1
fi

case "$NATIVE_BUILD_TIMEOUT_SECONDS:$NATIVE_BUILD_WORKER_TIMEOUT_SECONDS" in
    *[!0-9:]*|0:*|*:0)
        emit_failure "native-build-timeout-invalid"
        exit 1
        ;;
esac
if [ "${#NATIVE_BUILD_TIMEOUT_SECONDS}" -gt 9 ] || \
   [ "${#NATIVE_BUILD_WORKER_TIMEOUT_SECONDS}" -gt 9 ] || \
   [ "$NATIVE_BUILD_WORKER_TIMEOUT_SECONDS" -ge "$NATIVE_BUILD_TIMEOUT_SECONDS" ]; then
    emit_failure "native-build-timeout-invalid"
    exit 1
fi

ENTRY="examples/09_embedded/simple_os/arch/x86_64/gui_entry_desktop.spl"
LINKER_SCRIPT="examples/09_embedded/simple_os/arch/x86_64/linker.ld"
KERNEL_OUTPUT="${SIMPLEOS_WM_KERNEL_ARTIFACT:-$BUILD_DIR/simpleos_wm_production_desktop.elf}"
KERNEL_CANDIDATE="$KERNEL_OUTPUT.candidate"
KERNEL_ADMISSION="$KERNEL_OUTPUT.admission"
if [ -z "${SIMPLEOS_WM_KERNEL_ARTIFACT:-}" ] && [ -f "$KERNEL_OUTPUT" ]; then
    sample_kernel_source_revision
fi

if [ ! -f "$ENTRY" ]; then
    emit_failure "wm-simple-web-source-missing"
    exit 1
fi

# Build the kernel (same flow as os.qemu_runner.build_os for the
# wm-simple-web check target) unless a fresh artifact already exists.
kernel_stale=false
if [ -n "${SIMPLEOS_WM_KERNEL_ARTIFACT:-}" ]; then
    explicit_kernel_status="$(elf_file_status "$KERNEL_OUTPUT")"
    if [ "$explicit_kernel_status" != pass ]; then
        KERNEL_BUILD_STATUS="external-elf-$explicit_kernel_status"
        emit_failure "explicit-wm-kernel-artifact-invalid"
        exit 1
    fi
    KERNEL_ADMISSION=""
    KERNEL_BUILD_STATUS=external-elf-validated
elif [ ! -f "$KERNEL_OUTPUT" ]; then
    kernel_stale=true
elif ! is_sha256 "$KERNEL_SOURCE_REVISION" || \
     [ ! -f "$KERNEL_ADMISSION" ] || \
     ! grep -Fxq "wrapper_sha256=$WRAPPER_SHA256" "$KERNEL_ADMISSION" || \
     ! grep -Fxq "simple_bin_sha256=$SIMPLE_BIN_SHA256" "$KERNEL_ADMISSION" || \
     ! grep -Fxq "profile=cranelift|x86-64-v1|none|dynload" "$KERNEL_ADMISSION" || \
     ! grep -Fxq "schema=simpleos-wm-kernel-admission-v2" "$KERNEL_ADMISSION" || \
     ! grep -Fxq "source_input_files=$KERNEL_INPUT_COUNT" "$KERNEL_ADMISSION" || \
     ! grep -Fxq "source_revision_sha256=$KERNEL_SOURCE_REVISION" "$KERNEL_ADMISSION" || \
     ! grep -Fxq "kernel_sha256=$(file_sha256 "$KERNEL_OUTPUT")" "$KERNEL_ADMISSION"; then
    kernel_stale=true
fi
if [ "$kernel_stale" = true ]; then
    TIMEOUT_BIN=""
    if command -v timeout >/dev/null 2>&1; then
        TIMEOUT_BIN=timeout
    elif command -v gtimeout >/dev/null 2>&1; then
        TIMEOUT_BIN=gtimeout
    else
        emit_failure "native-build-watchdog-not-found"
        exit 1
    fi
    mkdir -p build/os/generated/generated
    cat >build/os/generated/generated/simpleos_log_config.spl <<'SPL'
val SIMPLEOS_LOG_COMPILED: bool = false

fn simpleos_log_compile_enabled() -> bool:
    SIMPLEOS_LOG_COMPILED

fn simpleos_log_compile_mode_name() -> text:
    if SIMPLEOS_LOG_COMPILED:
        return "on"
    "off"
SPL
    sample_kernel_source_revision
    if ! is_sha256 "$KERNEL_SOURCE_REVISION" || [ "$KERNEL_INPUT_COUNT" -lt "$KERNEL_INPUT_MIN_FILES" ]; then
        KERNEL_BUILD_STATUS=source-revision-unavailable
        kernel_input_verdict error
        emit_failure "wm-simple-web-source-revision-unavailable"
        exit 1
    fi
    # gui_entry_desktop.spl is the production baremetal desktop target
    # (os.qemu_runner._needs_freestanding_stub_env /
    # _uses_baremetal_wrapper_profile): it needs freestanding stub linking
    # plus an llvm-objcopy on PATH for the ELF32 wrap step.
    OBJCOPY_PREFIX=""
    for candidate_dir in /opt/homebrew/opt/llvm/bin /usr/local/opt/llvm/bin /usr/lib/llvm-20/bin /usr/lib/llvm-19/bin /usr/lib/llvm-18/bin /usr/lib/llvm-17/bin; do
        if [ -f "$candidate_dir/llvm-objcopy" ]; then
            OBJCOPY_PREFIX="$candidate_dir"
            break
        fi
    done
    # This tree is shared with concurrent sessions (and, at times, an in-flight
    # `git am`) that rewrite thousands of files under the hashed source roots.
    # Losing that race mid-build is expected and benign; it is not evidence of
    # anything about the kernel. Retry the whole build against the re-sampled
    # tree state instead of aborting the lane. The admission invariant is
    # NOT relaxed: the attempt that actually admits must still observe
    # before == after over the same input set, so a kernel is never admitted
    # against source it was not compiled from.
    while :; do
    KERNEL_BUILD_ATTEMPTS=$((KERNEL_BUILD_ATTEMPTS + 1))
    rm -f "$KERNEL_CANDIDATE"
    set +e
    SIMPLE_BOOTSTRAP=1 SIMPLE_LIB="$ROOT_DIR/src" SIMPLE_OS_LOG_MODE=off \
    SIMPLE_ALLOW_FREESTANDING_STUBS=1 \
    SIMPLE_FREESTANDING_ELF32_MULTIBOOT_WRAP=1 \
    PATH="${OBJCOPY_PREFIX:+$OBJCOPY_PREFIX:}$PATH" \
        "$TIMEOUT_BIN" --kill-after=10s "${NATIVE_BUILD_TIMEOUT_SECONDS}s" \
        "$SIMPLE_BIN" native-build \
        --source build/os/generated --source "$ENTRY" \
        --timeout "$NATIVE_BUILD_WORKER_TIMEOUT_SECONDS" \
        --backend cranelift --cpu x86-64-v1 --opt-level=none --log off \
        --cache-dir "$BUILD_DIR/native-cache" --mode dynload \
        --entry-closure --entry "$ENTRY" \
        --target x86_64-unknown-none -o "$KERNEL_CANDIDATE" \
        --linker-script "$LINKER_SCRIPT" \
        >"$BUILD_DIR/native-build.out" 2>&1
    build_code=$?
    set -e
    if [ "$build_code" -eq 124 ] || [ "$build_code" -eq 137 ]; then
        rm -f "$KERNEL_CANDIDATE"
        KERNEL_BUILD_STATUS=timeout-cache-preserved
        emit_failure "wm-simple-web-build-timeout"
        exit 1
    elif [ "$build_code" -eq 139 ]; then
        rm -f "$KERNEL_CANDIDATE"
        KERNEL_BUILD_STATUS=compiler-crash-signal-11-cache-preserved
        emit_failure "wm-simple-web-build-failed"
        exit 1
    elif [ "$build_code" -ne 0 ] || [ ! -s "$KERNEL_CANDIDATE" ]; then
        rm -f "$KERNEL_CANDIDATE"
        KERNEL_BUILD_STATUS=failed-cache-preserved
        emit_failure "wm-simple-web-build-failed"
        exit 1
    elif [ "$(elf_file_status "$KERNEL_CANDIDATE")" != pass ]; then
        rm -f "$KERNEL_CANDIDATE"
        KERNEL_BUILD_STATUS=invalid-elf-cache-preserved
        emit_failure "wm-simple-web-build-invalid-elf"
        exit 1
    fi
    candidate_sha256="$(file_sha256 "$KERNEL_CANDIDATE")"
    if ! is_sha256 "$candidate_sha256"; then
        rm -f "$KERNEL_CANDIDATE"
        KERNEL_BUILD_STATUS=invalid-hash-cache-preserved
        emit_failure "artifact-sha256-invalid"
        exit 1
    fi
    # Re-resolve and re-hash the input set so a mid-build edit to any linked
    # input still refuses admission of this candidate. The set must resolve to
    # the same file count as the pre-build sampling (checked below); a revision
    # mismatch means a concurrent session edited a linked input during the
    # build, which is retried above rather than admitted.
    revision_pair_after="$(kernel_source_revision)"
    input_count_after="${revision_pair_after%% *}"
    source_revision_after="${revision_pair_after#* }"
    if ! is_sha256 "$source_revision_after" || [ "$input_count_after" != "$KERNEL_INPUT_COUNT" ]; then
        rm -f "$KERNEL_CANDIDATE"
        KERNEL_BUILD_STATUS=source-input-set-unresolved-cache-preserved
        kernel_input_verdict error
        emit_failure "wm-simple-web-source-revision-unavailable"
        exit 1
    fi
    if [ "$source_revision_after" != "$KERNEL_SOURCE_REVISION" ]; then
        rm -f "$KERNEL_CANDIDATE"
        if [ "$KERNEL_BUILD_ATTEMPTS" -lt "$KERNEL_BUILD_MAX_ATTEMPTS" ]; then
            # Re-sample to the tree state observed at the end of the lost race
            # and rebuild against exactly that.
            KERNEL_SOURCE_REVISION="$source_revision_after"
            KERNEL_INPUT_COUNT="$input_count_after"
            continue
        fi
        KERNEL_BUILD_STATUS=source-changed-cache-preserved
        kernel_input_verdict changed
        emit_failure "wm-simple-web-build-source-changed"
        exit 1
    fi
    break
    done
    kernel_input_verdict pass
    mv "$KERNEL_CANDIDATE" "$KERNEL_OUTPUT"
    KERNEL_SHA256="$candidate_sha256"
    {
        echo "schema=simpleos-wm-kernel-admission-v2"
        echo "wrapper_sha256=$WRAPPER_SHA256"
        echo "simple_bin_sha256=$SIMPLE_BIN_SHA256"
        echo "profile=cranelift|x86-64-v1|none|dynload"
        echo "source_input_files=$KERNEL_INPUT_COUNT"
        echo "source_revision_sha256=$KERNEL_SOURCE_REVISION"
        echo "kernel_sha256=$KERNEL_SHA256"
    } >"$KERNEL_ADMISSION.candidate"
    mv "$KERNEL_ADMISSION.candidate" "$KERNEL_ADMISSION"
    KERNEL_BUILD_STATUS=current-source-built
elif [ -z "${SIMPLEOS_WM_KERNEL_ARTIFACT:-}" ]; then
    KERNEL_BUILD_STATUS=current-source-cache
    kernel_input_verdict pass
fi

KERNEL_SHA256="$(file_sha256 "$KERNEL_OUTPUT")"
if ! is_sha256 "$KERNEL_SHA256"; then
    emit_failure "artifact-sha256-invalid"
    exit 1
fi

set +e
scripts/os/build_browser_demo_client.shs >"$BUILD_DIR/build-browser-demo.out" 2>&1
browser_demo_build_code=$?
set -e
if [ "$browser_demo_build_code" -ne 0 ] || [ ! -s "$BROWSER_DEMO_BINARY" ]; then
    browser_demo_build_status=failed
    emit_failure "browser-demo-client-build-failed"
    exit 1
fi
BROWSER_DEMO_BINARY_SHA256="$(file_sha256 "$BROWSER_DEMO_BINARY")"
if ! is_sha256 "$BROWSER_DEMO_BINARY_SHA256"; then
    browser_demo_build_status=invalid-hash
    emit_failure "browser-demo-client-hash-invalid"
    exit 1
fi
browser_demo_build_status=pass

rm -f "$QMP_SOCKET" "$SERIAL_LOG"

DISK_IMAGE="${SIMPLEOS_WM_DISK_IMAGE:-$BUILD_DIR/fat32-x86_64-font.img}"
if [ -n "${SIMPLEOS_WM_DISK_IMAGE:-}" ]; then
    disk_image_provenance=external-unvalidated
fi
if [ -z "${SIMPLEOS_WM_DISK_IMAGE:-}" ]; then
    set +e
    SIMPLEOS_FONT_ASSET="$FONT_ASSET" \
    SIMPLEOS_BROWSER_DEMO_BINARY="$BROWSER_DEMO_BINARY" \
    scripts/os/make_os_disk.shs \
        256 "$DISK_IMAGE" "$KERNEL_OUTPUT" x86_64 \
        >"$BUILD_DIR/make-os-disk.out" 2>&1
    disk_build_code=$?
    set -e
    if [ "$disk_build_code" -ne 0 ]; then
        disk_image_status=build-failed
        emit_failure "pinned-font-disk-staging-failed"
        exit 1
    fi
    case "$KERNEL_BUILD_STATUS" in
        current-source-built|current-source-cache)
            disk_image_provenance=built-from-admitted-kernel
            ;;
        external-elf-validated)
            disk_image_provenance=built-from-external-elf-validated
            ;;
        *)
            disk_image_provenance=kernel-not-admitted
            emit_failure "default-disk-kernel-not-admitted"
            exit 1
            ;;
    esac
fi
disk_file_status="$(fat32_image_status "$DISK_IMAGE")"
if [ "$disk_file_status" != pass ]; then
    disk_image_status="$disk_file_status"
    emit_failure "production-fat32-disk-invalid"
    exit 1
fi
disk_image_status=pass
if [ -n "${SIMPLEOS_WM_DISK_IMAGE:-}" ]; then
    disk_image_provenance=external-fat32-validated
fi
DISK_IMAGE_SHA256="$(file_sha256 "$DISK_IMAGE")"
if ! is_sha256 "$DISK_IMAGE_SHA256"; then
    emit_failure "artifact-sha256-invalid"
    exit 1
fi
browser_demo_disk_status="$(browser_demo_disk_payload_status "$DISK_IMAGE" "$BROWSER_DEMO_BINARY")"
if [ "$browser_demo_disk_status" != pass ]; then
    emit_failure "browser-demo-real-elf-not-staged"
    exit 1
fi

# --- Package the kernel as a self-contained UEFI boot app (OVMF pflash) -----
# Board-runnable rule (.claude/rules/board-runnable.md) forbids QEMU `-kernel`
# fast-path semantics. Adapted from the proven pattern in
# scripts/os/ssh_ring3_uefi_boot.shs (lines 57-84).
UEFI_BUILD="$BUILD_DIR/uefi"
ESP="$UEFI_BUILD/esp"
EFIAPP="$ESP/EFI/BOOT/BOOTX64.EFI"
OVMF_VARS="$UEFI_BUILD/OVMF_VARS_4M.fd"
rm -rf "$UEFI_BUILD"
mkdir -p "$ESP/EFI/BOOT"
cp "$OVMF_VARS_SRC" "$OVMF_VARS"
cat > "$UEFI_BUILD/grub.cfg" <<'CFG'
set timeout=0
set default=0
insmod multiboot
insmod normal
# Load the UEFI GOP + generic video drivers before GRUB negotiates std-vga.
# Without these modules, screendump boots can fail with "no suitable video
# mode found" and fault in firmware/GRUB before the kernel entry point.
insmod efi_gop
insmod all_video
set gfxpayload=text
menuentry "SimpleOS WM fullscreen (UEFI/multiboot)" {
    echo "[grub-uefi] multiboot loading /boot/kernel.elf ..."
    multiboot /boot/kernel.elf
    boot
}
CFG
set +e
"$GRUB_MKSTANDALONE" \
    --format=x86_64-efi \
    --output="$EFIAPP" \
    --modules="multiboot normal echo part_gpt fat efi_gop efi_uga all_video gfxterm video_bochs video_fb" \
    "boot/grub/grub.cfg=$UEFI_BUILD/grub.cfg" \
    "boot/kernel.elf=$KERNEL_OUTPUT"
grub_mkstandalone_code=$?
set -e
if [ "$grub_mkstandalone_code" -ne 0 ] || [ ! -f "$EFIAPP" ]; then
    emit_failure "grub-mkstandalone-did-not-produce-BOOTX64.EFI"
    exit 1
fi

# Launch QEMU directly with the exact wm-simple-web QMP-capture flags used by
# os.qemu_runner._wm_simple_web_qmp_capture_target(): q35/max/2G, serial
# routed to a file, no display, BGA std VGA, QMP over a unix socket.
# vgamem_mb=64 raises the BGA/std-vga linear-framebuffer VRAM aperture past
# QEMU's 16MB default (only 16MB won't fit a 3840x2160x32bpp = ~33.2MB
# framebuffer -- BGA would silently reject/clamp the mode).
qemu-system-x86_64 \
    -no-user-config -monitor none -net none \
    -machine q35 -cpu max -m 2G \
    -serial "file:$SERIAL_LOG" \
    -display none \
    -no-reboot \
    -drive "if=pflash,format=raw,readonly=on,file=$OVMF_CODE" \
    -drive "if=pflash,format=raw,file=$OVMF_VARS" \
    -drive "file=fat:rw:$ESP,format=raw,id=esp,if=none" \
    -device virtio-blk-pci,drive=esp,bootindex=0 \
    -vga std -global VGA.vgamem_mb=64 \
    -drive "file=$DISK_IMAGE,if=none,id=nvm,format=raw,snapshot=on" \
    -device "nvme,serial=deadbeef,drive=nvm" \
    -audiodev driver=none,id=simpleos-audio \
    -device intel-hda \
    -device hda-output,audiodev=simpleos-audio \
    -qmp "unix:$QMP_SOCKET,server,nowait" \
    >"$LAUNCH_OUT" 2>&1 &
QEMU_PID=$!

status=fail
reason=not-run
scanout_marker=""
scanout_address=""
scanout_width=0
scanout_height=0
scanout_stride=0
scanout_pixel_format=""
scanout_generation=0
scanout_size=0
font_marker=""
font_unavailable_marker=""
font_marker_valid=false
font_oracle_pending=false
font_region_line=""
font_region_bytes=0
font_region_sha256=""
font_region_corrupt_copy_bytes=0
font_region_corrupt_copy_sha256=""
font_region_corrupt_rejection_status=not-run
content_provenance_marker=""
hda_init_marker=""
hda_irq_marker=""
input_nonce="simpleos-wm-$(date +%s)-$$"
input_submit_marker=""
input_irq_marker=""
input_state_marker=""
input_frame_marker=""
input_release_irq_marker=""
restore_irq_marker=""
restore_state_marker=""
restore_frame_marker=""
restore_release_irq_marker=""
pointer_irq_marker=""
pointer_state_marker=""
pointer_frame_marker=""
pointer_release_irq_marker=""
pointer_release_state_marker=""
pointer_release_frame_marker=""
remote_browser_ready_marker=""
remote_browser_window=""
remote_browser_window_valid=false
browser_event_marker=""
browser_content_applied_marker=""
browser_content_presented_generation=0
browser_content_presented_generation_status=fail
browser_content_delta_generation=0
browser_content_delta_generation_status=fail
baseline_seq=0
maximize_seq=0
maximize_release_seq=0
restore_seq=0
restore_release_seq=0
pointer_seq=0
pointer_release_seq=0
changed_bytes=0
before_sha256=
after_sha256=
restored_sha256=
browser_content_before_sha256=
browser_content_after_sha256=
browser_content_changed_bytes=0

# Wait for the QMP socket.
waited=0
while [ "$waited" -le 60000 ]; do
    if [ -S "$QMP_SOCKET" ]; then
        break
    fi
    sleep 0.1
    waited=$((waited + 100))
done

if [ ! -S "$QMP_SOCKET" ]; then
    reason="qmp-socket-missing"
elif ! kill -0 "$QEMU_PID" 2>/dev/null; then
    reason="qemu-exited-early"
else
    # --- Migration-correctness ladder (isolates OVMF boot-path success from
    # kernel render correctness, which is tracked separately) ---
    rung() { grep -qa "$1" "$SERIAL_LOG" 2>/dev/null && echo "  [ok]   $2" || echo "  [MISS] $2"; }
    echo "===== UEFI boot ladder ====="
    rung "\[grub-uefi\] multiboot loading" "GRUB EFI app ran (OVMF -> bootloader OK)"
    rung "\[BOOT64\] call _start"           "multiboot handoff -> kernel _start (shared crt0.s)"

    # The guest marker is the only source of scanout metadata. No BGA address,
    # dimensions, pitch, format, or generation defaults are accepted here.
    # Readiness wait: 60s default; TCG hosts (x86_64 guest on arm64 mac) run
    # the 4K CPU-fallback desktop layout much slower than KVM/HVF and may need
    # an explicitly longer window. The knob only extends waiting for the SAME
    # markers — no gate semantics change.
    #
    # Default raised 60s -> 300s (2026-08-09). 60s produced FALSE REDs on a
    # loaded host: a source-built run under load average 13-19 (concurrent
    # agent sessions) was truncated mid-boot and reported as failure, while the
    # SAME kernel reached full scanout + compositor-ready when given a 300s
    # window. Waiting longer cannot let a bad kernel pass — every marker,
    # fault check, and PPM assertion below is unchanged; it only stops a good
    # kernel from being failed for host contention. A fast host still exits as
    # soon as the markers appear, so the raised ceiling costs nothing there.
    READINESS_TIMEOUT_MS="${SIMPLEOS_WM_READINESS_TIMEOUT_MS:-300000}"
    waited=0
    while [ "$waited" -le "$READINESS_TIMEOUT_MS" ]; do
        serial_bytes="$(wc -c <"$SERIAL_LOG" 2>/dev/null || echo 0)"
        if serial_has_production_fault; then
            reason="guest-render-fault"
            break
        elif [ "$serial_bytes" -gt 1048576 ]; then
            reason="guest-serial-fault-storm"
            break
        fi
        scanout_marker="$(marker_line "$SERIAL_LOG" "[scanout-evidence]")"
        ready_marker="$(marker_line "$SERIAL_LOG" "[production-readiness]")"
        font_marker="$(marker_line "$SERIAL_LOG" "[font-evidence]")"
        font_unavailable_marker="$(marker_line "$SERIAL_LOG" "[font-evidence-unavailable]")"
        if [ -n "$scanout_marker" ] && [ -n "$ready_marker" ] && \
           { [ -n "$font_marker" ] || [ -n "$font_unavailable_marker" ]; }; then
            break
        fi
        if ! kill -0 "$QEMU_PID" 2>/dev/null; then
            break
        fi
        sleep 0.1
        waited=$((waited + 100))
    done

    scanout_address="$(marker_field "$scanout_marker" address)"
    scanout_width="$(marker_field "$scanout_marker" width)"
    scanout_height="$(marker_field "$scanout_marker" height)"
    scanout_stride="$(marker_field "$scanout_marker" stride)"
    scanout_pixel_format="$(marker_field "$scanout_marker" pixel_format)"
    scanout_generation="$(marker_field "$scanout_marker" generation)"
    case "$font_marker" in
        *"[font-evidence] guest_path=$FONT_GUEST_PATH asset_bytes=$FONT_ASSET_EXPECTED_BYTES family=Noto Sans Mono asset_sha256=$FONT_ASSET_EXPECTED_SHA256 raster=pure-sfnt-glyf route=shared-wm-draw-ir component_id=taskbar-clock font_size=12 text=00:00 region=right56,bottom48 region_rgb_sha256=$FONT_REGION_EXPECTED_SHA256"*)
            font_marker_valid=true
            ;;
    esac
    case "$font_unavailable_marker" in
        *"[font-evidence-unavailable] reason=canonical-taskbar-clock-oracle-pending route=shared-wm-draw-ir component_id=taskbar-clock region=right56,bottom48 region_rgb_sha256="*)
            font_oracle_pending=true
            ;;
    esac

    case "$scanout_address:$scanout_width:$scanout_height:$scanout_stride:$scanout_generation" in
        *[!0-9:]*|:*|*::*|*:) metadata_valid=false ;;
        *) metadata_valid=true ;;
    esac
    if [ "$reason" = "guest-serial-fault-storm" ] || [ "$reason" = "guest-render-fault" ]; then
        :
    elif [ -z "$scanout_marker" ] || [ -z "${ready_marker:-}" ]; then
        reason="dynamic-scanout-or-desktop-readiness-missing"
    elif [ -n "$font_unavailable_marker" ] && \
         { [ "$font_oracle_pending" != true ] || [ -n "$FONT_REGION_EXPECTED_SHA256" ]; }; then
        reason="guest-pinned-font-evidence-unavailable"
    elif [ "$font_marker_valid" != true ] && \
         { [ "$font_oracle_pending" != true ] || [ -n "$FONT_REGION_EXPECTED_SHA256" ]; }; then
        reason="guest-pinned-font-evidence-invalid"
    elif [ "$metadata_valid" != true ] || [ "$scanout_address" -le 0 ] || \
         [ "$scanout_width" -le 0 ] || [ "$scanout_height" -le 0 ] || \
         [ "$scanout_stride" -le 0 ] || [ "$scanout_generation" -le 0 ] || \
         [ -z "$scanout_pixel_format" ]; then
        reason="dynamic-scanout-metadata-invalid"
    elif [ "$scanout_width" -gt 16384 ] || [ "$scanout_height" -gt 16384 ] || \
         [ "$scanout_stride" -lt $((scanout_width * 4)) ] || \
         [ $((scanout_stride % 4)) -ne 0 ]; then
        reason="dynamic-scanout-bounds-or-byte-pitch-invalid"
    else
        scanout_size=$((scanout_stride * scanout_height))
        scanout_end=$((scanout_address + scanout_size))
        if [ "$scanout_size" -le 0 ] || [ "$scanout_end" -le "$scanout_address" ] || \
           [ "$scanout_end" -gt 68719476736 ]; then
            reason="dynamic-scanout-address-range-invalid"
        else
        # Capture baseline, inject two F11 make/break pairs, and map the host
        # nonce to the guest's newly observed monotonic input sequences.
        set +e
        python3 - "$QMP_SOCKET" "$SERIAL_LOG" "$BASELINE_PPM" "$FULLSCREEN_PPM" "$RESTORED_PPM" "$BROWSER_EVENT_PPM" "$FONT_REGION_RGB" "$FONT_REGION_CORRUPT_COPY" "$scanout_address" "$scanout_width" "$scanout_height" "$scanout_stride" "$scanout_pixel_format" "$scanout_size" "$input_nonce" >"$CAPTURE_OUT" 2>&1 <<'PY'
import hashlib
import json
import os
import re
import socket
import sys
import time

sock_path, serial_path = sys.argv[1], sys.argv[2]
baseline_ppm, fullscreen_ppm, restored_ppm, browser_event_ppm = sys.argv[3:7]
font_region_path, corrupt_region_path = sys.argv[7], sys.argv[8]
address, width, height, pitch = map(int, sys.argv[9:13])
pixel_format, size, nonce = sys.argv[13], int(sys.argv[14]), sys.argv[15]

qmp_id = [0]

def write_qmp(f, obj):
    qmp_id[0] += 1
    request_id = qmp_id[0]
    obj["id"] = request_id
    f.write(json.dumps(obj).encode() + b"\n")
    f.flush()
    while True:
        line = f.readline()
        if not line:
            raise RuntimeError("qmp-connection-closed")
        reply = json.loads(line)
        if reply.get("id") != request_id:
            continue
        if "error" in reply:
            raise RuntimeError(str(reply["error"]))
        if "return" not in reply:
            raise RuntimeError("qmp-command-unacknowledged")
        return reply

def hmp(f, cmd):
    return write_qmp(f, {"execute": "human-monitor-command", "arguments": {"command-line": cmd}})

def wait_raw(path):
    for _ in range(100):
        if os.path.exists(path) and os.path.getsize(path) == size:
            return True
        time.sleep(0.1)
    return False

def pmem(f, ppm_path):
    raw_path = ppm_path + ".raw"
    try:
        os.unlink(raw_path)
    except FileNotFoundError:
        pass
    reply = hmp(f, 'pmemsave %d %d "%s"' % (address, size, raw_path))
    if reply.get("return", "") != "":
        raise RuntimeError("pmemsave rejected: %r" % reply)
    ok = wait_raw(raw_path)
    data = open(raw_path, "rb").read() if ok else b""
    if len(data) == size:
        pix = bytearray()
        if pixel_format != "argb8888":
            raise RuntimeError("unsupported pixel format: " + pixel_format)
        for y in range(height):
            row = y * pitch
            for x in range(width):
                i = row + x * 4
                pix.extend([data[i + 2], data[i + 1], data[i]])
        with open(ppm_path, "wb") as out:
            out.write(("P6\n%d %d\n255\n" % (width, height)).encode() + bytes(pix))
    return data

def serial_text():
    try:
        return open(serial_path, "r", errors="replace").read()
    except OSError:
        return ""

def serial_size():
    try:
        return os.path.getsize(serial_path)
    except OSError:
        return 0

def serial_text_from(offset):
    try:
        with open(serial_path, "rb") as serial:
            serial.seek(offset)
            return serial.read().decode("utf-8", errors="replace")
    except OSError:
        return ""

def max_input_seq():
    values = [int(v) for v in re.findall(r"\[wm-frame\] input_seq=(\d+) generation=\d+", serial_text())]
    return max(values) if values else 0

def wait_remote_browser_ready():
    deadline = time.monotonic() + 120.0
    pattern = re.compile(
        r"^\[remote-browser-ready\] window=([1-9]\d*) x=(-?\d+) y=(-?\d+) "
        r"width=(\d+) height=(\d+) owner_port=([1-9]\d*)\r?$", re.M)
    while time.monotonic() < deadline:
        match = pattern.search(serial_text())
        if match:
            rect = tuple(int(match.group(i)) for i in range(2, 6))
            if rect[2] > 0 and rect[3] > 24:
                return match.group(0), int(match.group(1)), rect
        time.sleep(0.05)
    raise RuntimeError("remote-browser-ready-missing")

def wait_browser_content_presented(window_id, input_seq, serial_offset):
    deadline = time.monotonic() + 120.0
    event_marker = "[browser-demo-event] window=%d input_received=true content_mutated=true" % window_id
    presented_pattern = re.compile(
        r"^\[remote-browser-content-presented\] window=%d input_seq=%d generation=([1-9]\d*)\r?$" %
        (window_id, input_seq), re.M)
    while time.monotonic() < deadline:
        text = serial_text_from(serial_offset)
        event_pos = text.find(event_marker)
        presented_match = presented_pattern.search(text)
        if event_pos >= 0 and presented_match and presented_match.start() > event_pos:
            return event_marker, presented_match.group(0), int(presented_match.group(1))
        time.sleep(0.05)
    raise RuntimeError("remote-browser-content-mutation-missing")

def wait_press_correlation(after_seq, action, expected_window=None):
    # 300s (was 90s): the maximize re-render now includes pure-Simple sfnt
    # glyf rasterization of the maximized window's text at 4K under TCG
    # x86_64-on-arm64 (fonts were bitmap-fallback when 90s last sufficed;
    # per-pixel coverage sampling dominates — perf gap recorded in
    # doc/08_tracking/bug/native_chr_builtin_no_lowering_2026-07-18.md).
    # Correlation strictness is unchanged: only sequences NEWER than
    # after_seq with a complete irq -> state -> frame chain are accepted.
    deadline = time.monotonic() + 300.0
    while time.monotonic() < deadline:
        text = serial_text()
        seqs = sorted({int(v) for v in re.findall(r"\[wm-input-irq\] input_seq=(\d+) scancode=87 kind=press(?:\r?$)", text, re.M) if int(v) > after_seq})
        for seq in seqs:
            irq = re.search(r"^\[wm-input-irq\] input_seq=%d scancode=87 kind=press\r?$" % seq, text, re.M)
            state = re.search(r"^\[wm-state\] input_seq=%d action=%s window=(\d+) maximized=(?:true|false) x=(-?\d+) y=(-?\d+) width=(\d+) height=(\d+)\r?$" % (seq, action), text, re.M)
            frame = re.search(r"^\[wm-frame\] input_seq=%d generation=(\d+)\r?$" % seq, text, re.M)
            if irq and state and frame and int(frame.group(1)) > 0:
                window_id = int(state.group(1))
                if window_id <= 0 or (expected_window is not None and window_id != expected_window):
                    continue
                rect = tuple(int(state.group(i)) for i in range(2, 6))
                if rect[2] <= 0 or rect[3] <= 0:
                    continue
                return seq, window_id, irq.group(0), state.group(0), frame.group(0), rect
        time.sleep(0.05)
    raise RuntimeError("guest-input-press-state-frame-correlation-missing action=" + action)

def wait_release_receipt(after_seq):
    deadline = time.monotonic() + 30.0
    while time.monotonic() < deadline:
        text = serial_text()
        seqs = sorted({int(v) for v in re.findall(r"\[wm-input-irq\] input_seq=(\d+) scancode=215 kind=release(?:\r?$)", text, re.M) if int(v) > after_seq})
        for seq in seqs:
            irq = re.search(r"^\[wm-input-irq\] input_seq=%d scancode=215 kind=release\r?$" % seq, text, re.M)
            if irq:
                return seq, irq.group(0)
        time.sleep(0.05)
    raise RuntimeError("guest-input-release-receipt-missing")

def wait_pointer_correlation(after_seq, kind_code, expected_window="", serial_offset=0):
    # 300s (was 30s), matching wait_press_correlation: every pointer step sets
    # need_render in the shell loop, so correlating one requires a FULL 4K
    # re-render with pure-Simple glyf rasterization under TCG — the exact work
    # that already forced the keyboard press budget from 90s to 300s. Parity
    # with the press path is the ONLY justification for this number.
    # CORRECTION (2026-07-26): raising this did NOT fix the pointer release,
    # and my original claim here — that the release render was "still in
    # progress at the cutoff" — was WRONG. At 300s the guest's serial log had
    # its last write 300s before the harness gave up, with no panic, no fault,
    # no reset, empty qemu.out and not even a heap allocation after the state
    # receipt. The release is a state-dependent HANG in the shell loop between
    # the pointer state and frame receipts, not slow rendering. Do not raise
    # this number again expecting it to help; see the [wm-loop-step] receipts
    # in src/os/desktop/shell.spl.
    # The keyboard RELEASE keeps 30s because it is a device receipt only and
    # never renders.
    # Correlation strictness is UNCHANGED: still a complete
    # irq -> state -> frame chain, on a sequence newer than after_seq, with
    # generation > 0.
    deadline = time.monotonic() + 300.0
    while time.monotonic() < deadline:
        text = serial_text_from(serial_offset)
        seqs = sorted({int(v) for v in re.findall(r"^\[wm-pointer-irq\] input_seq=(\d+) x=\d+ y=\d+ button_code=1 kind_code=%d\r?$" % kind_code, text, re.M) if int(v) > after_seq})
        for seq in seqs:
            irq = re.search(r"^\[wm-pointer-irq\] input_seq=%d x=\d+ y=\d+ button_code=1 kind_code=%d\r?$" % (seq, kind_code), text, re.M)
            if kind_code == 1:
                state = re.search(r"^\[wm-pointer-state\] input_seq=%d window=([1-9]\d*) marker=\[simpleos-wm\] loop-step command=(?:window_focus|window_drag_begin).* window=\1 handled=true\r?$" % seq, text, re.M)
            else:
                state = re.search(r"^\[wm-pointer-state\] input_seq=%d window=%s marker=\[simpleos-wm\] loop-step command=ignored target= app= window= handled=false\r?$" % (seq, re.escape(expected_window)), text, re.M)
            frame = re.search(r"^\[wm-pointer-frame\] input_seq=%d generation=(\d+)\r?$" % seq, text, re.M)
            if irq and state and frame and int(frame.group(1)) > 0:
                window = state.group(1) if kind_code == 1 else expected_window
                return seq, irq.group(0), state.group(0), frame.group(0), window
        time.sleep(0.05)
    raise RuntimeError("guest-pointer-irq-state-frame-correlation-missing kind_code=%d" % kind_code)

def send_f11(f):
    events = [{"type":"key","data":{"down":down,"key":{"type":"qcode","data":"f11"}}} for down in (True, False)]
    write_qmp(f, {"execute":"input-send-event", "arguments":{"events":events}})

def send_pointer_click(f, window_rect):
    window_x, window_y, window_width, window_height = window_rect
    target_x = window_x + window_width // 2
    target_y = window_y + max(36, window_height // 2)
    delta_x = target_x - width // 2
    delta_y = target_y - height // 2
    write_qmp(f, {"execute":"input-send-event", "arguments":{"events":[
        {"type":"rel","data":{"axis":"x","value":delta_x}},
        {"type":"rel","data":{"axis":"y","value":delta_y}}
    ]}})
    write_qmp(f, {"execute":"input-send-event", "arguments":{"events":[
        {"type":"btn","data":{"down":True,"button":"left"}}
    ]}})

s = socket.socket(socket.AF_UNIX)
s.settimeout(5)
s.connect(sock_path)
f = s.makefile("rwb", buffering=0)
f.readline()
write_qmp(f, {"execute": "qmp_capabilities"})
remote_ready_marker, remote_browser_window, remote_browser_rect = wait_remote_browser_ready()
baseline_seq = max_input_seq()
baseline = pmem(f, baseline_ppm)
if width < 56 or height < 48 or len(baseline) != size:
    raise RuntimeError("font-region-out-of-bounds")
font_region = bytearray()
for y in range(height - 48, height):
    for x in range(width - 56, width):
        i = y * pitch + x * 4
        font_region.extend([baseline[i + 2], baseline[i + 1], baseline[i]])
with open(font_region_path, "wb") as out:
    out.write(font_region)
corrupt_region = bytearray(font_region)
corrupt_region[0] ^= 1
with open(corrupt_region_path, "wb") as out:
    out.write(corrupt_region)
font_region_hash = hashlib.sha256(font_region).hexdigest()
send_f11(f)
max_seq, target_window, max_irq, max_state, max_frame, _ = wait_press_correlation(baseline_seq, "maximize")
if target_window != remote_browser_window:
    raise RuntimeError("fullscreen-target-is-not-remote-browser")
max_release_seq, max_release_irq = wait_release_receipt(max_seq)
fullscreen = pmem(f, fullscreen_ppm)
send_f11(f)
restore_seq, restored_window, restore_irq, restore_state, restore_frame, restored_rect = wait_press_correlation(max_release_seq, "restore", target_window)
restore_release_seq, restore_release_irq = wait_release_receipt(restore_seq)
restored = pmem(f, restored_ppm)

base_hash = hashlib.sha256(baseline).hexdigest()
full_hash = hashlib.sha256(fullscreen).hexdigest()
restored_hash = hashlib.sha256(restored).hexdigest()
changed = sum(1 for a, b in zip(baseline, fullscreen) if a != b)
if not (len(baseline) == len(fullscreen) == len(restored) == size):
    raise RuntimeError("capture-size-mismatch")
if full_hash == base_hash or changed <= 4096:
    raise RuntimeError("maximize-semantic-hash-not-distinct")
if restored_hash != base_hash:
    raise RuntimeError("restore-semantic-hash-mismatch")
browser_serial_offset = serial_size()
send_pointer_click(f, restored_rect)
pointer_seq, pointer_irq, pointer_state, pointer_frame, pointer_window = wait_pointer_correlation(restore_release_seq, 1)
if int(pointer_window) != remote_browser_window:
    raise RuntimeError("pointer-target-is-not-remote-browser")
browser_event_marker, browser_applied_marker, browser_presented_generation = wait_browser_content_presented(
    remote_browser_window, pointer_seq, browser_serial_offset)
browser_event_frame = pmem(f, browser_event_ppm)
pointer_release_serial_offset = serial_size()
write_qmp(f, {"execute":"input-send-event", "arguments":{"events":[
    {"type":"btn","data":{"down":False,"button":"left"}}
]}})
pointer_release_seq, pointer_release_irq, pointer_release_state, pointer_release_frame, _ = wait_pointer_correlation(pointer_seq, 2, pointer_window, pointer_release_serial_offset)

def content_crop(frame, rect):
    x, y, w, h = rect
    x0 = max(0, x)
    y0 = max(0, y + 24)
    x1 = min(width, x + w)
    y1 = min(height, y + h)
    crop = bytearray()
    for row_y in range(y0, y1):
        start = row_y * pitch + x0 * 4
        crop.extend(frame[start:row_y * pitch + x1 * 4])
    return bytes(crop)

browser_before = content_crop(restored, restored_rect)
browser_after = content_crop(browser_event_frame, restored_rect)
browser_changed = sum(1 for before, after in zip(browser_before, browser_after) if before != after)
if len(browser_before) == 0 or len(browser_before) != len(browser_after):
    raise RuntimeError("browser-content-crop-invalid")
if browser_changed <= 512:
    raise RuntimeError("browser-content-buffer-did-not-mutate")
browser_before_hash = hashlib.sha256(browser_before).hexdigest()
browser_after_hash = hashlib.sha256(browser_after).hexdigest()
print("simpleos_wm_input_submitted host_nonce=%s baseline_seq=%d maximize_seq=%d maximize_release_seq=%d restore_seq=%d restore_release_seq=%d qcode=f11" % (nonce, baseline_seq, max_seq, max_release_seq, restore_seq, restore_release_seq))
print("simpleos_wm_remote_browser_ready_marker=" + remote_ready_marker)
print("simpleos_wm_browser_event_marker=" + browser_event_marker)
print("simpleos_wm_browser_content_applied_marker=" + browser_applied_marker)
print("simpleos_wm_browser_content_presented_generation=%d" % browser_presented_generation)
print("simpleos_wm_maximize_irq_marker=" + max_irq)
print("simpleos_wm_maximize_state_marker=" + max_state)
print("simpleos_wm_maximize_frame_marker=" + max_frame)
print("simpleos_wm_maximize_release_irq_marker=" + max_release_irq)
print("simpleos_wm_restore_irq_marker=" + restore_irq)
print("simpleos_wm_restore_state_marker=" + restore_state)
print("simpleos_wm_restore_frame_marker=" + restore_frame)
print("simpleos_wm_restore_release_irq_marker=" + restore_release_irq)
print("simpleos_wm_pointer_irq_marker=" + pointer_irq)
print("simpleos_wm_pointer_state_marker=" + pointer_state)
print("simpleos_wm_pointer_frame_marker=" + pointer_frame)
print("simpleos_wm_pointer_input_seq=%d" % pointer_seq)
print("simpleos_wm_pointer_release_irq_marker=" + pointer_release_irq)
print("simpleos_wm_pointer_release_state_marker=" + pointer_release_state)
print("simpleos_wm_pointer_release_frame_marker=" + pointer_release_frame)
print("simpleos_wm_pointer_release_input_seq=%d" % pointer_release_seq)
print("simpleos_wm_browser_content_delta generation=%d changed_bytes=%d before_sha256=%s after_sha256=%s" % (browser_presented_generation, browser_changed, browser_before_hash, browser_after_hash))
print("font_region=right56,bottom48 font_region_rgb_bytes=%d font_region_rgb_sha256=%s" % (len(font_region), font_region_hash))
print("simpleos_wm_fullscreen_delta changed_bytes=%d before_sha256=%s after_sha256=%s restored_sha256=%s" % (changed, base_hash, full_hash, restored_hash))
PY
        capture1_code=$?
        set -e

        if [ "$capture1_code" -ne 0 ]; then
            reason="capture-input-or-guest-correlation-failed"
        else
            input_submit_marker="$(sed -n '/^simpleos_wm_input_submitted /p' "$CAPTURE_OUT" | tail -n 1)"
            baseline_seq="$(marker_field "$input_submit_marker" baseline_seq)"
            maximize_seq="$(marker_field "$input_submit_marker" maximize_seq)"
            maximize_release_seq="$(marker_field "$input_submit_marker" maximize_release_seq)"
            restore_seq="$(marker_field "$input_submit_marker" restore_seq)"
            restore_release_seq="$(marker_field "$input_submit_marker" restore_release_seq)"
            input_irq_marker="$(sed -n 's/^simpleos_wm_maximize_irq_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            input_state_marker="$(sed -n 's/^simpleos_wm_maximize_state_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            input_frame_marker="$(sed -n 's/^simpleos_wm_maximize_frame_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            input_release_irq_marker="$(sed -n 's/^simpleos_wm_maximize_release_irq_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            restore_irq_marker="$(sed -n 's/^simpleos_wm_restore_irq_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            restore_state_marker="$(sed -n 's/^simpleos_wm_restore_state_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            restore_frame_marker="$(sed -n 's/^simpleos_wm_restore_frame_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            restore_release_irq_marker="$(sed -n 's/^simpleos_wm_restore_release_irq_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            pointer_irq_marker="$(sed -n 's/^simpleos_wm_pointer_irq_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            pointer_state_marker="$(sed -n 's/^simpleos_wm_pointer_state_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            pointer_frame_marker="$(sed -n 's/^simpleos_wm_pointer_frame_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            pointer_seq="$(sed -n 's/^simpleos_wm_pointer_input_seq=//p' "$CAPTURE_OUT" | tail -n 1)"
            pointer_release_irq_marker="$(sed -n 's/^simpleos_wm_pointer_release_irq_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            pointer_release_state_marker="$(sed -n 's/^simpleos_wm_pointer_release_state_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            pointer_release_frame_marker="$(sed -n 's/^simpleos_wm_pointer_release_frame_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            pointer_release_seq="$(sed -n 's/^simpleos_wm_pointer_release_input_seq=//p' "$CAPTURE_OUT" | tail -n 1)"
            remote_browser_ready_marker="$(sed -n 's/^simpleos_wm_remote_browser_ready_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            remote_browser_window="$(marker_field "$remote_browser_ready_marker" window)"
            case "$remote_browser_window" in
                ''|*[!0-9]*|0) remote_browser_window_valid=false ;;
                *) remote_browser_window_valid=true ;;
            esac
            browser_event_marker="$(sed -n 's/^simpleos_wm_browser_event_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            browser_content_applied_marker="$(sed -n 's/^simpleos_wm_browser_content_applied_marker=//p' "$CAPTURE_OUT" | tail -n 1)"
            browser_content_presented_generation="$(sed -n 's/^simpleos_wm_browser_content_presented_generation=//p' "$CAPTURE_OUT" | tail -n 1)"
            case "$browser_content_presented_generation" in
                ''|*[!0-9]*|0) browser_content_presented_generation_status=fail ;;
                *) browser_content_presented_generation_status=pass ;;
            esac
            browser_delta_line="$(sed -n '/^simpleos_wm_browser_content_delta /p' "$CAPTURE_OUT" | tail -n 1)"
            browser_content_delta_generation="$(marker_field "$browser_delta_line" generation)"
            browser_content_changed_bytes="$(marker_field "$browser_delta_line" changed_bytes)"
            browser_content_before_sha256="$(marker_field "$browser_delta_line" before_sha256)"
            browser_content_after_sha256="$(marker_field "$browser_delta_line" after_sha256)"
            if [ "$browser_content_presented_generation_status" = pass ] && [ "$browser_content_delta_generation" = "$browser_content_presented_generation" ]; then
                browser_content_delta_generation_status=pass
            fi
            delta_line="$(sed -n '/^simpleos_wm_fullscreen_delta /p' "$CAPTURE_OUT" | tail -n 1)"
            changed_bytes="$(marker_field "$delta_line" changed_bytes)"
            before_sha256="$(marker_field "$delta_line" before_sha256)"
            after_sha256="$(marker_field "$delta_line" after_sha256)"
            restored_sha256="$(marker_field "$delta_line" restored_sha256)"
            font_region_line="$(sed -n '/^font_region=right56,bottom48 /p' "$CAPTURE_OUT" | tail -n 1)"
            font_region_bytes="$(marker_field "$font_region_line" font_region_rgb_bytes)"
            font_region_sha256="$(marker_field "$font_region_line" font_region_rgb_sha256)"
            font_region_corrupt_copy_bytes="$(file_byte_count "$FONT_REGION_CORRUPT_COPY")"
            font_region_corrupt_copy_sha256="$(file_sha256 "$FONT_REGION_CORRUPT_COPY")"
            if [ "$remote_browser_window_valid" = true ] && [ "$browser_content_presented_generation_status" = pass ]; then
            content_provenance_marker="$(tr -d '\r' <"$SERIAL_LOG" | grep -E "^\\[wm-frame\\] content-presented scene_revision=$browser_content_presented_generation path=(host-gpu|software) window_id=$remote_browser_window status=engine2d_rendered backend=[^ ]+ fallback=solid-material material=[0-9a-f]{64} theme=$EXPECTED_THEME_ID source=$EXPECTED_THEME_SOURCE_MANIFEST_SHA256$" | tail -n 1 || true)"
            fi
            hda_init_marker="$(marker_line "$SERIAL_LOG" "[hda-init] ok")"
            hda_irq_marker="$(marker_line "$SERIAL_LOG" "[hda-irq] active")"
            if serial_has_production_fault; then
                status=fail
                reason=guest-render-fault
            elif [ "$remote_browser_window_valid" != true ]; then
                status=fail
                reason=guest-browser-window-identity-invalid
            elif [ "$browser_content_presented_generation_status" != pass ]; then
                status=fail
                reason=guest-browser-presented-generation-invalid
            elif [ "$browser_content_delta_generation_status" != pass ]; then
                status=fail
                reason=guest-browser-content-generation-mismatch
            elif [ -z "$content_provenance_marker" ] || grep -Eq '^\[wm-frame\] content-provenance-rejected|backend=native-safe-fallback' "$SERIAL_LOG"; then
                status=fail
                reason=guest-content-provenance-invalid
            elif [ -z "$hda_init_marker" ]; then
                status=fail
                reason=guest-hda-initialization-missing
            elif [ -z "$hda_irq_marker" ]; then
                status=fail
                reason=guest-hda-repeated-irq-missing
            elif [ -z "$FONT_REGION_EXPECTED_SHA256" ]; then
                status=fail
                reason=canonical-taskbar-clock-oracle-pending
            elif [ "$font_region_bytes" != "$FONT_REGION_EXPECTED_BYTES" ] || \
                 [ "$font_region_sha256" != "$FONT_REGION_EXPECTED_SHA256" ] || \
                 [ "$(font_region_oracle_status "$FONT_REGION_RGB")" != pass ]; then
                status=fail
                reason=pinned-font-region-oracle-mismatch
            elif [ "$font_region_corrupt_copy_bytes" != "$FONT_REGION_EXPECTED_BYTES" ] || \
                 ! is_sha256 "$font_region_corrupt_copy_sha256" || \
                 [ "$font_region_corrupt_copy_sha256" = "$font_region_sha256" ] || \
                 [ "$(font_region_oracle_status "$FONT_REGION_CORRUPT_COPY")" != fail ]; then
                status=fail
                reason=font-region-corrupt-copy-calibration-failed
            else
                font_region_corrupt_rejection_status=pass
                status=pass
                reason=pass
            fi
        fi
        fi
    fi
fi

if [ "$status" = pass ]; then
    wrapper_sha256_now="$(file_sha256 "$WRAPPER")"
    kernel_sha256_now="$(file_sha256 "$KERNEL_OUTPUT")"
    disk_image_sha256_now="$(file_sha256 "$DISK_IMAGE")"
    if ! is_sha256 "$wrapper_sha256_now" || \
       ! is_sha256 "$kernel_sha256_now" || \
       ! is_sha256 "$disk_image_sha256_now"; then
        status=fail
        reason=artifact-sha256-invalid
    elif [ "$wrapper_sha256_now" != "$WRAPPER_SHA256" ] || \
         [ "$kernel_sha256_now" != "$KERNEL_SHA256" ] || \
         [ "$disk_image_sha256_now" != "$DISK_IMAGE_SHA256" ]; then
        status=fail
        reason=artifact-sha256-mismatch
    fi
fi

{
    echo "simpleos_wm_fullscreen_status=$status"
    echo "simpleos_wm_fullscreen_reason=$reason"
    echo "simpleos_wm_fullscreen_wrapper=$WRAPPER"
    echo "simpleos_wm_fullscreen_wrapper_sha256=$WRAPPER_SHA256"
    echo "simpleos_wm_fullscreen_simple_bin=$SIMPLE_BIN"
    echo "simpleos_wm_fullscreen_simple_bin_resolved=$SIMPLE_BIN_RESOLVED"
