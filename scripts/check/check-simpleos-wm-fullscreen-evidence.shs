#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"
. "$ROOT_DIR/scripts/check/lib/simpleos-admitted-runtime.shs"
SIMPLEOS_ADMITTED_RUNTIME_ROOT=$ROOT_DIR
export SIMPLEOS_ADMITTED_RUNTIME_ROOT

BUILD_DIR="${BUILD_DIR:-build/simpleos_wm_fullscreen_evidence}"
REPORT_PATH="${REPORT_PATH:-doc/09_report/simpleos_wm_fullscreen_evidence_$(date -u +%F).md}"
WRAPPER="scripts/check/check-simpleos-wm-fullscreen-evidence.shs"
WRAPPER_SHA256=""
WRAPPER_BUNDLE_SHA256=""
SIMPLE_BIN_SOURCE="${SIMPLE_BIN_SOURCE:-explicit-env}"
SIMPLE_BIN_STATUS=unchecked
SIMPLE_BIN_RESOLVED=""
SIMPLE_BIN_VERSION=""
SIMPLE_BIN_SHA256=""
SIMPLE_BIN_RUNTIME_ADMITTED=0
KERNEL_OUTPUT=""
KERNEL_SHA256=""
KERNEL_ADMISSION=""
KERNEL_BUILD_STATUS=unchecked
KERNEL_SOURCE_REVISION=""
NATIVE_BUILD_TIMEOUT_SECONDS="${SIMPLEOS_WM_NATIVE_BUILD_TIMEOUT_SECONDS:-900}"
NATIVE_BUILD_WORKER_TIMEOUT_SECONDS="${SIMPLEOS_WM_NATIVE_BUILD_WORKER_TIMEOUT_SECONDS:-870}"
LAUNCH_OUT="$BUILD_DIR/qemu.out"
SERIAL_LOG="$BUILD_DIR/serial.log"
QMP_SOCKET="$BUILD_DIR/qmp.sock"
CAPTURE_OUT="$BUILD_DIR/capture.out"
FULLSCREEN_PPM="$BUILD_DIR/fullscreen.ppm"
RESTORED_PPM="$BUILD_DIR/restored.ppm"
BROWSER_EVENT_PPM="$BUILD_DIR/browser-event.ppm"
FULLSCREEN_RAW="$FULLSCREEN_PPM.raw"
RESTORED_RAW="$RESTORED_PPM.raw"
BROWSER_EVENT_RAW="$BROWSER_EVENT_PPM.raw"
BASELINE_PPM="$BUILD_DIR/baseline.ppm"
BASELINE_RAW="$BASELINE_PPM.raw"
FONT_REGION_RGB="$BUILD_DIR/font-region.rgb"
FONT_REGION_CORRUPT_COPY="$BUILD_DIR/font-region-corrupt-calibration.rgb"
FONT_ASSET="${SIMPLEOS_WM_FONT_ASSET:-assets/fonts/google-fonts/ofl/notosansmono/NotoSansMono[wdth,wght].ttf}"
FONT_GUEST_PATH=/SYS/FONTS/NOTOSANS
THEME_SNAPSHOT_SOURCE="$ROOT_DIR/src/lib/common/ui/generated/aetheric_dark_theme_snapshot.spl"
EXPECTED_THEME_ID="aetheric_dark"
EXPECTED_THEME_SOURCE_MANIFEST_SHA256="$(sed -n 's/.*source_manifest_sha256: "\([0-9a-f][0-9a-f]*\)".*/\1/p' "$THEME_SNAPSHOT_SOURCE" | head -n 1)"
FONT_ASSET_EXPECTED_BYTES=1708408
FONT_ASSET_EXPECTED_SHA256=2cb2adb378a8f574213e23df697050b83c54c27df465a2015552740b2769a081
FONT_REGION_EXPECTED_BYTES=8064
# Filled only after a retained QEMU pmemsave proves the canonical taskbar clock.
# Pinned 2026-07-19 after the Aetheric taskbar replaced the Aqua fill. The
# checker still requires an independent host pmemsave extraction to match the
# guest-computed region before accepting the oracle.
FONT_REGION_EXPECTED_SHA256=addf76edf6d23ca9bea6d698ca1d30bc4bd8dd684bb50ff3158ef755bd2854fc
FONT_ASSET_BYTES=0
FONT_ASSET_SHA256=""
DISK_IMAGE=""
DISK_IMAGE_SHA256=""
disk_image_status=not-staged
disk_image_provenance=not-staged
BROWSER_DEMO_BINARY="build/os/apps/browser_demo/browser_demo.elf"
BROWSER_DEMO_BINARY_SHA256=""
browser_demo_build_status=not-built
browser_demo_disk_status=not-checked
QEMU_PID=""

mkdir -p "$BUILD_DIR" "$(dirname -- "$REPORT_PATH")"

# ---- per-run evidence retention (additive; canonical paths unchanged) -----
# The unconditional clear below used to DESTROY the previous run's artifacts,
# so a PASSING run's serial log (the whole point of this lane) vanished the
# moment anyone re-ran the script. Archive the previous run first.
#
# Retention policy (bounded, never unbounded growth):
#   * every invocation archives the PREVIOUS run's artifacts into
#     $BUILD_DIR/runs/<UTC-timestamp>-<verdict>/ (verdict read from that run's
#     own evidence.env), together with a RUN_INFO.env provenance stamp;
#   * at most SIMPLEOS_WM_EVIDENCE_RETAIN (default 8) archived runs are kept,
#     oldest pruned first;
#   * the newest archived PASSING run is never pruned, so the last green boot
#     evidence always survives, however many red runs follow it.
# Canonical output paths ($BUILD_DIR/serial.log, evidence.env, ...) are NOT
# moved or aliased: they always hold THIS run only, and are cleared below, so
# a retained log can never be misread as the current run's.
EVIDENCE_RUNS_DIR="$BUILD_DIR/runs"
EVIDENCE_RETAIN="${SIMPLEOS_WM_EVIDENCE_RETAIN:-8}"

WM_FULLSCREEN_LIB="$ROOT_DIR/scripts/check/lib/simpleos-wm-fullscreen"
WM_FULLSCREEN_RETENTION="$WM_FULLSCREEN_LIB/retention.shs"
WM_FULLSCREEN_ADMISSION="$WM_FULLSCREEN_LIB/admission.shs"
WM_FULLSCREEN_BUILD="$WM_FULLSCREEN_LIB/build.shs"
WM_FULLSCREEN_RUNTIME="$WM_FULLSCREEN_LIB/runtime.shs"
WM_FULLSCREEN_REPORT="$WM_FULLSCREEN_LIB/report.shs"
WM_FULLSCREEN_COMPONENTS="$WRAPPER $WM_FULLSCREEN_RETENTION $WM_FULLSCREEN_ADMISSION $WM_FULLSCREEN_BUILD $WM_FULLSCREEN_RUNTIME $WM_FULLSCREEN_REPORT"

for wm_fullscreen_component in $WM_FULLSCREEN_COMPONENTS; do
    if [ ! -r "$wm_fullscreen_component" ]; then
        echo "simpleos_wm_fullscreen_status=fail"
        echo "simpleos_wm_fullscreen_reason=wrapper-component-missing:$wm_fullscreen_component"
        exit 1
    fi
done

. "$WM_FULLSCREEN_RETENTION"
. "$WM_FULLSCREEN_ADMISSION"
. "$WM_FULLSCREEN_BUILD"
. "$WM_FULLSCREEN_RUNTIME"
. "$WM_FULLSCREEN_REPORT"
