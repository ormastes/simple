#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
output_path=${1:?usage: build-process-observation-v4-static-fixture.shs OUTPUT_PATH}
mkdir -p "$(dirname "$output_path")"
"${CC:-cc}" -std=c11 -O2 -static -no-pie -Wl,--build-id=none \
    -o "$output_path" "$repo_root/test/fixtures/process_observation_v4/static_child.c"

header=$(readelf -h "$output_path")
printf '%s\n' "$header" | grep -q 'Type:.*EXEC'
if readelf -lW "$output_path" | grep -q 'INTERP'; then
    echo "fixture unexpectedly contains a dynamic interpreter" >&2
    exit 1
fi
printf 'fixture=%s\n' "$output_path"
readelf -h "$output_path" | grep -E 'Class:|Data:|Type:|Machine:'
sha256sum "$output_path"
