#!/bin/sh
set -eu

simple_bin=${SIMPLE_BIN:-bin/release/x86_64-unknown-linux-gnu/simple}
out_dir=${WEB_DRAW_IR_SWITCH_WORK_DIR:-build/web_draw_ir_8k_frame_switch}
log_path="$out_dir/run.log"
row_path="$out_dir/evidence.txt"
timeout_seconds=${SIMPLE_TIMEOUT_SECONDS:-180}

mkdir -p "$out_dir"
if ! SIMPLE_TIMEOUT_SECONDS="$timeout_seconds" \
    timeout "${timeout_seconds}s" "$simple_bin" run \
    test/05_perf/graphics_2d/bench_web_draw_ir_8k_frame_switch.spl \
    --mode=jit >"$log_path" 2>&1; then
    tail -40 "$log_path"
    exit 1
fi

row_count=$(grep -c '^WEB_DRAW_IR_8K_SWITCH ' "$log_path" || true)
if [ "$row_count" -ne 1 ]; then
    echo "expected exactly one WEB_DRAW_IR_8K_SWITCH row, found $row_count"
    exit 1
fi
grep '^WEB_DRAW_IR_8K_SWITCH ' "$log_path" >"$row_path"
if ! grep -q '^WEB_DRAW_IR_8K_SWITCH status=pass ' "$row_path"; then
    sed -n '1p' "$row_path"
    exit 1
fi
sed -n '1p' "$row_path"
