#!/bin/sh
# Native Linux-only locator qualification; not a Simple pipeline admission.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
case "$(uname -s):$(uname -m)" in Linux:x86_64|Linux:aarch64) ;; *) echo 'UNAVAILABLE Linux64 locator target'; exit 2 ;; esac
cc=${CLANG:-clang-23}
work=${XRAY_IMAGE_TEST_DIR:-"$repo/build/xray-image-locator"}
mkdir -p "$work"
"$cc" --version > "$work/toolchain.txt"
"$cc" -print-resource-dir >> "$work/toolchain.txt"
"$cc" -O1 -fxray-instrument -c "$repo/test/fixtures/xray/xray_image_locator_target.c" -o "$work/target.o"
for mode in present absent; do
  define=
  if [ "$mode" = absent ]; then define=-DLOCATOR_ABSENT_SECTION; fi
  "$cc" -std=c11 -Wall -Wextra -Werror -O1 $define -c "$repo/test/fixtures/xray/xray_image_locator_main.c" -o "$work/$mode.o"
  "$cc" -fxray-instrument -fuse-ld=lld -Wl,--build-id=sha1 "$work/$mode.o" "$work/target.o" -ldl -o "$work/$mode"
  XRAY_OPTIONS=patch_premain=false "$work/$mode"
done
