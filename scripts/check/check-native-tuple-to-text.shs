#!/bin/sh
# Regression gate for AOT (`native-build`) tuple stringification.
#
# WHY THIS EXISTS: `bin/simple test` hard-defaults to the tree-walk interpreter
# and has no AOT mode, so a spec can only ever prove the interpreter lane. The
# tuple-to-text defect was "fixed" twice (JIT printer 81c58562fac, then the AOT
# MIR path) and re-reported both times because no harness reached the AOT lane.
# Only a script that actually drives `native-build` can fence this.
# Bug: doc/08_tracking/bug/native_pushed_tuple_into_empty_literal_list_unboxed_2026-08-02.md
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

SIMPLE_BINARY="${SIMPLE_BINARY:-bin/simple}"
WORK_DIR="${WORK_DIR:-/tmp/check-native-tuple-to-text.$$}"
FIXTURE="test/fixtures/native_tuple_to_text/main.spl"

test -x "$SIMPLE_BINARY"
mkdir -p "$WORK_DIR"
trap 'rm -rf "$WORK_DIR"' EXIT HUP INT TERM

binary="$WORK_DIR/tuple-to-text"
log="$WORK_DIR/tuple-to-text.log"

env -u SIMPLE_BOOTSTRAP SIMPLE_NO_STUB_FALLBACK=1 \
    "$SIMPLE_BINARY" native-build \
    --source test/fixtures --entry-closure --entry "$FIXTURE" \
    --cache-dir "$WORK_DIR/cache" --output "$binary" >"$log" 2>&1

out="$(timeout 30 "$binary" 2>>"$log")"

flat="$(printf '%s\n' "$out" | sed -n 's/^tuple: //p')"
t0="$(printf '%s\n' "$out" | sed -n 's/^t0: //p')"
tsum="$(printf '%s\n' "$out" | sed -n 's/^tsum: //p')"
mixed="$(printf '%s\n' "$out" | sed -n 's/^mixed: //p')"
m1="$(printf '%s\n' "$out" | sed -n 's/^m1: //p')"
m2="$(printf '%s\n' "$out" | sed -n 's/^m2: //p')"
f1="$(printf '%s\n' "$out" | sed -n 's/^f1: //p')"

if [ "$flat" != "(1, 2, 3)" ]; then
    echo "FAIL — all-i64 tuple interpolation regressed under native-build"
    echo "  expected: (1, 2, 3)"
    echo "  actual:   $flat"
    exit 1
fi

# All-i64 tuple field READS (t.0, t.0+t.1) -- fixed 459dd21c5f6, then
# REROUTED (still through the GEP+load fallback for i64, but the literal-
# index dispatch itself changed) by the mixed-type field-read fix below.
# Guard the already-landed i64 path explicitly so a future edit to that
# dispatch can't silently regress it while only the mixed-type gate is
# watched.
if [ "$t0" != "1" ]; then
    echo "FAIL — all-i64 tuple field read (t.0) regressed under native-build"
    echo "  expected: 1"
    echo "  actual:   $t0"
    exit 1
fi
if [ "$tsum" != "3" ]; then
    echo "FAIL — all-i64 tuple field read used as an arithmetic operand (t.0 + t.1) regressed under native-build"
    echo "  expected: 3"
    echo "  actual:   $tsum"
    exit 1
fi

# Mixed-type tuple rendering was fixed 2026-08-07 (lower_tuple_lit now reads
# each element's MIR-registered type via local_mir_type_of instead of the
# unreliable elem.type_ HIR annotation). Hard-gated now -- see bug doc above.
if [ "$mixed" != "(1, abc, true)" ]; then
    echo "FAIL — mixed-type tuple rendering regressed under native-build"
    echo "  expected: (1, abc, true)"
    echo "  actual:   $mixed"
    exit 1
fi
echo "PASS — native-build tuple-to-text: mixed-type tuple renders correctly"

# Mixed-type tuple FIELD READS (t.0/t.1), the last gap in this family --
# fixed by routing the tuple-index-desugared read through emit_get_field
# (dest_ty-reconciled) instead of a raw GEP+load pair. See bug doc above,
# "gap (c)".
if [ "$m1" != "abc" ]; then
    echo "FAIL — mixed-type tuple field read (m.1, str) regressed under native-build"
    echo "  expected: abc"
    echo "  actual:   $m1"
    exit 1
fi

if [ "$m2" != "true" ]; then
    echo "FAIL — mixed-type tuple field read (m.2, bool) regressed under native-build"
    echo "  expected: true"
    echo "  actual:   $m2"
    exit 1
fi
echo "PASS — native-build tuple-to-text: mixed-type tuple field reads render correctly"

# f64 tuple field read (f.1): the discriminating case between the two
# candidate fixes for gap (c). The GEP+load fallback path has no `bitcast`
# step, so a raw i64-word load reinterpreted as `double` is precisely the
# defect `translate_get_field`'s `is_float_type` arm exists to prevent --
# this assertion is what proves the emit_get_field reroute (not just the
# result_type fallback) is load-bearing, not merely additive.
if [ "$f1" != "2.5" ]; then
    echo "FAIL — mixed-type tuple field read (f.1, f64) regressed under native-build"
    echo "  expected: 2.5"
    echo "  actual:   $f1"
    exit 1
fi
echo "PASS — native-build tuple-to-text: f64 tuple field read renders correctly"

echo "PASS — native-build tuple-to-text: all-i64 tuple renders correctly"
