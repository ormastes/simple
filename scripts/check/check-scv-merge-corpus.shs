#!/bin/sh
# SCV-IMPL-D-08 — merge corpus gate.
#
# Measures MISSED REAL CONFLICTS (the dangerous class) as well as spurious ones.
# For every committed case under test/fixtures/scv_merge_corpus/ it drives the
# LANDED merge pipeline end to end through the scv CLI
# (merge.spl -> identity pre-pass -> structural/region -> D-06 validation ladder
# -> conflict_v2) and compares the outcome against the case's truth.sdn.
#
# Truth kinds:
#   expect: conflict        merge MUST report conflicts>=1
#   expect: clean-exact     merge MUST report conflicts=0 AND the exported tree
#                           must be byte-identical to expected/
#   expect: clean-contains  merge MUST report conflicts=0 AND each
#                           `contains: <relpath>|<substring>` row must hold
#                           (used only for order-independent/commutative cases)
#
# Error classes, counted separately:
#   MISSED real conflict  truth says conflict, merge claimed clean          -> must be 0
#   silent mis-merge      truth says clean, merge clean but content wrong   -> folded into MISSED
#   SPURIOUS conflict     truth says clean, merge conflicted                -> reported, bounded
#
# Spurious bound: 6 (SPURIOUS_BOUND below). A bound nobody wrote down is not a bound.
#
# Verdict is the LAST line of stdout:
#   PASS — <n> case(s) checked, 0 missed real conflicts (...)         exit 0
#   FAIL — ...                                                        exit 1
#   ERROR — nothing was checked (<reason>)                            exit 2
# 0 cases scanned is always ERROR, never a pass.
#
# Cost: ~7 scv CLI invocations per case; budget several minutes for the full corpus.
# --selftest runs first, is fatal, and generates its poisoned-truth fixtures in a
# temp dir (never inside the committed corpus).

set -u

REPO=$(cd "$(dirname "$0")/../.." && pwd)
CORPUS="$REPO/test/fixtures/scv_merge_corpus"
SIMPLE="$REPO/bin/simple"
SCV_MAIN="$REPO/src/app/scv/main.spl"
SPURIOUS_BOUND=6
DO_SELFTEST=1
MIN_CASES=20
MAX_CASES=200

while [ $# -gt 0 ]; do
    case "$1" in
        --corpus-root) CORPUS="$2"; shift 2 ;;
        --selftest) DO_SELFTEST=2; shift ;;
        --no-selftest) DO_SELFTEST=0; shift ;;
        --no-bounds) MIN_CASES=0; shift ;;
        *) printf 'ERROR — nothing was checked (unknown argument: %s)\n' "$1"; exit 2 ;;
    esac
done

scv() {
    SIMPLE_LIB="$REPO/src" "$SIMPLE" run "$SCV_MAIN" "$@"
}

clear_worktree() {
    find . -mindepth 1 -maxdepth 1 ! -name '.scv' -exec rm -rf {} + 2>/dev/null
}

# Runs one case directory. Echoes one classification token:
#   OK | MISSED | SILENT | SPURIOUS | CASEERROR:<reason>
run_case() {
    _case="$1"
    _truth="$_case/truth.sdn"
    [ -f "$_truth" ] || { echo "CASEERROR:no truth.sdn"; return; }
    _expect=$(sed -n 's/^expect:[[:space:]]*//p' "$_truth" | head -1)
    [ -n "$_expect" ] || { echo "CASEERROR:no expect row"; return; }
    for _d in base left right; do
        [ -d "$_case/$_d" ] || { echo "CASEERROR:missing $_d/"; return; }
    done

    _tmp=$(mktemp -d /tmp/scv-merge-corpus.XXXXXX) || { echo "CASEERROR:mktemp failed"; return; }
    _out=""
    (
        set -e
        cp -R "$_case/base/." "$_tmp/"
        cd "$_tmp"
        scv init >/dev/null
        BASE=$(scv snapshot | head -1 | awk '{print $2}')
        BASE_OP=$(cat .scv/HEAD_OP)
        clear_worktree
        cp -R "$_case/left/." .
        LEFT=$(scv snapshot | head -1 | awk '{print $2}')
        scv restore-op "$BASE_OP" >/dev/null
        clear_worktree
        cp -R "$_case/right/." .
        RIGHT=$(scv snapshot | head -1 | awk '{print $2}')
        scv merge-commits "$BASE" "$LEFT" "$RIGHT" > merge.out 2>merge.err
        scv export-tree exported >/dev/null 2>&1 || true
    ) >"$_tmp.log" 2>&1
    _rc=$?
    if [ $_rc -ne 0 ]; then
        echo "CASEERROR:drive failed rc=$_rc ($(tail -3 "$_tmp.log" 2>/dev/null | tr '\n' ' '))"
        rm -rf "$_tmp" "$_tmp.log"
        return
    fi
    if [ ! -s "$_tmp/merge.out" ]; then
        echo "CASEERROR:merge produced no output"
        rm -rf "$_tmp" "$_tmp.log"
        return
    fi
    if grep -q 'refusing non-production Simple runtime' "$_tmp/merge.out" "$_tmp/merge.err" 2>/dev/null; then
        echo "CASEERROR:production-guard wrapper refused to exec"
        rm -rf "$_tmp" "$_tmp.log"
        return
    fi
    _nconf=$(sed -n 's/.*conflicts=\([0-9][0-9]*\).*/\1/p' "$_tmp/merge.out" | head -1)
    if [ -z "$_nconf" ]; then
        echo "CASEERROR:no conflicts= count in merge output"
        rm -rf "$_tmp" "$_tmp.log"
        return
    fi

    _verdict=""
    case "$_expect" in
        conflict)
            if [ "$_nconf" -ge 1 ]; then _verdict=OK; else _verdict=MISSED; fi
            ;;
        clean-exact)
            if [ "$_nconf" -ge 1 ]; then
                _verdict=SPURIOUS
            elif [ ! -d "$_tmp/exported" ]; then
                _verdict="CASEERROR:export-tree produced nothing"
            elif diff -r "$_case/expected" "$_tmp/exported" >/dev/null 2>&1; then
                _verdict=OK
            else
                _verdict=SILENT
            fi
            ;;
        clean-contains)
            if [ "$_nconf" -ge 1 ]; then
                _verdict=SPURIOUS
            elif [ ! -d "$_tmp/exported" ]; then
                _verdict="CASEERROR:export-tree produced nothing"
            else
                _verdict=OK
                while IFS= read -r _row; do
                    [ -n "$_row" ] || continue
                    _rel=${_row%%|*}
                    _sub=${_row#*|}
                    if [ ! -f "$_tmp/exported/$_rel" ] || ! grep -qF "$_sub" "$_tmp/exported/$_rel"; then
                        _verdict=SILENT
                    fi
                done <<CONTAINS_EOF
$(sed -n 's/^contains:[[:space:]]*//p' "$_truth")
CONTAINS_EOF
            fi
            ;;
        *)
            _verdict="CASEERROR:unknown expect kind: $_expect"
            ;;
    esac
    rm -rf "$_tmp" "$_tmp.log"
    echo "$_verdict"
}

scan_corpus() {
    _root="$1"
    EV_CHECKED=0
    EV_MISSED=0
    EV_SILENT=0
    EV_SPURIOUS=0
    EV_ERRORS=0
    MISSED_NAMES=""
    SILENT_NAMES=""
    SPURIOUS_NAMES=""
    ERROR_NAMES=""
    [ -d "$_root" ] || return 0
    for _c in "$_root"/*/; do
        [ -d "$_c" ] || continue
        _name=$(basename "$_c")
        _r=$(run_case "${_c%/}")
        EV_CHECKED=$((EV_CHECKED + 1))
        case "$_r" in
            OK) printf '  ok        %s\n' "$_name" ;;
            MISSED)
                EV_MISSED=$((EV_MISSED + 1)); MISSED_NAMES="$MISSED_NAMES $_name"
                printf '  MISSED    %s (truth: conflict, merge claimed clean)\n' "$_name" ;;
            SILENT)
                EV_SILENT=$((EV_SILENT + 1)); SILENT_NAMES="$SILENT_NAMES $_name"
                printf '  MIS-MERGE %s (truth: clean, merge clean but content wrong)\n' "$_name" ;;
            SPURIOUS)
                EV_SPURIOUS=$((EV_SPURIOUS + 1)); SPURIOUS_NAMES="$SPURIOUS_NAMES $_name"
                printf '  spurious  %s (truth: clean, merge conflicted)\n' "$_name" ;;
            CASEERROR:*)
                EV_ERRORS=$((EV_ERRORS + 1)); ERROR_NAMES="$ERROR_NAMES $_name"
                printf '  ERROR     %s (%s)\n' "$_name" "${_r#CASEERROR:}" ;;
        esac
    done
}

# --------------------------------------------------------------------------
# selftest — fatal, runs before any real scan
# --------------------------------------------------------------------------
selftest() {
    _st=$(mktemp -d /tmp/scv-merge-corpus-selftest.XXXXXX)
    _fail=0

    # fixture 1: a genuinely clean case with correct truth -> must PASS
    mkdir -p "$_st/good/c1/base" "$_st/good/c1/left" "$_st/good/c1/right" "$_st/good/c1/expected"
    printf 'base\n' > "$_st/good/c1/base/a.txt"
    printf 'left\n' > "$_st/good/c1/left/a.txt"
    printf 'base\n' > "$_st/good/c1/right/a.txt"
    printf 'right\n' > "$_st/good/c1/right/b.txt"
    printf 'left\n' > "$_st/good/c1/expected/a.txt"
    printf 'right\n' > "$_st/good/c1/expected/b.txt"
    printf 'expect: clean-exact\n' > "$_st/good/c1/truth.sdn"

    # fixture 2: poisoned truth — same clean case, truth lies that it conflicts.
    # Proves the MISSED detector can actually fire.
    mkdir -p "$_st/poison_missed"
    cp -R "$_st/good/c1" "$_st/poison_missed/c1"
    printf 'expect: conflict\n' > "$_st/poison_missed/c1/truth.sdn"

    # fixture 3: poisoned truth — clean case whose expected content is wrong.
    # Proves the silent-mis-merge detector can actually fire.
    mkdir -p "$_st/poison_silent"
    cp -R "$_st/good/c1" "$_st/poison_silent/c1"
    printf 'NOT WHAT THE MERGER PRODUCES\n' > "$_st/poison_silent/c1/expected/a.txt"

    scan_corpus "$_st/good"
    if [ "$EV_CHECKED" -ne 1 ] || [ "$EV_MISSED" -ne 0 ] || [ "$EV_SILENT" -ne 0 ] || [ "$EV_ERRORS" -ne 0 ]; then
        printf 'selftest FAIL: clean fixture did not pass (checked=%s missed=%s silent=%s errors=%s)\n' \
            "$EV_CHECKED" "$EV_MISSED" "$EV_SILENT" "$EV_ERRORS"
        _fail=1
    fi

    scan_corpus "$_st/poison_missed"
    if [ "$EV_MISSED" -ne 1 ]; then
        printf 'selftest FAIL: poisoned-truth (expect conflict) fixture did not register a MISSED (missed=%s)\n' "$EV_MISSED"
        _fail=1
    fi

    scan_corpus "$_st/poison_silent"
    if [ "$EV_SILENT" -ne 1 ]; then
        printf 'selftest FAIL: poisoned-expected-content fixture did not register a silent mis-merge (silent=%s)\n' "$EV_SILENT"
        _fail=1
    fi

    scan_corpus "$_st/empty_missing"
    if [ "$EV_CHECKED" -ne 0 ]; then
        printf 'selftest FAIL: empty corpus scanned %s case(s), expected 0 so the caller is forced to ERROR\n' "$EV_CHECKED"
        _fail=1
    fi

    rm -rf "$_st"
    return $_fail
}

if [ "$DO_SELFTEST" -ne 0 ]; then
    printf 'selftest:\n'
    if ! selftest; then
        printf 'ERROR — nothing was checked (selftest failed)\n'
        exit 2
    fi
    printf 'selftest: 4 fixture(s) OK\n'
    if [ "$DO_SELFTEST" -eq 2 ]; then
        printf 'PASS — selftest only, 4 fixture(s) OK\n'
        exit 0
    fi
fi

if [ ! -d "$CORPUS" ]; then
    printf 'ERROR — nothing was checked (corpus directory not found: %s)\n' "$CORPUS"
    exit 2
fi

# Record binary identity with the run: bin/simple is a symlink other sessions
# replace mid-session, and a swap during this multi-minute scan shows up as
# transient per-case drive failures (which are ERROR, never a pass).
printf 'binary: %s (%s)\n' "$(readlink -f "$SIMPLE")" "$(stat -c '%s bytes %y' "$(readlink -f "$SIMPLE")" 2>/dev/null)"
printf 'corpus: %s\n' "$CORPUS"
scan_corpus "$CORPUS"

if [ "$EV_CHECKED" -eq 0 ]; then
    printf 'ERROR — nothing was checked (0 cases in %s)\n' "$CORPUS"
    exit 2
fi
if [ "$MIN_CASES" -gt 0 ] && [ "$EV_CHECKED" -lt "$MIN_CASES" ]; then
    printf 'ERROR — nothing was checked (corpus has %s cases, minimum is %s)\n' "$EV_CHECKED" "$MIN_CASES"
    exit 2
fi
if [ "$EV_CHECKED" -gt "$MAX_CASES" ]; then
    printf 'ERROR — nothing was checked (corpus has %s cases, maximum is %s)\n' "$EV_CHECKED" "$MAX_CASES"
    exit 2
fi
if [ "$EV_ERRORS" -gt 0 ]; then
    printf 'ERROR — nothing was checked (%s case(s) could not be driven:%s)\n' "$EV_ERRORS" "$ERROR_NAMES"
    exit 2
fi

TOTAL_MISSED=$((EV_MISSED + EV_SILENT))
SUMMARY="$EV_CHECKED case(s) checked, $TOTAL_MISSED missed real conflicts ($EV_MISSED undetected conflict, $EV_SILENT silent mis-merge), $EV_SPURIOUS spurious (bound <=$SPURIOUS_BOUND)"

if [ "$TOTAL_MISSED" -gt 0 ]; then
    printf 'FAIL — %s; missed:%s%s\n' "$SUMMARY" "$MISSED_NAMES" "$SILENT_NAMES"
    exit 1
fi
if [ "$EV_SPURIOUS" -gt "$SPURIOUS_BOUND" ]; then
    printf 'FAIL — %s; spurious over bound:%s\n' "$SUMMARY" "$SPURIOUS_NAMES"
    exit 1
fi
printf 'PASS — %s\n' "$SUMMARY"
exit 0
