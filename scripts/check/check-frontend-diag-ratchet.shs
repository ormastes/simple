#!/bin/sh
# check-frontend-diag-ratchet.shs — ratchet on warn-first FRONTEND diagnostics
# over the compiler's own source (src/compiler/**.spl).
#
# Rules (all default `warn`, registry: 90.tools/lint/_LintMain/config_and_model.spl):
#   E-TYPE-NIL-COMPARE   nil_compare_non_optional    (30.types/type_infer)
#   MEXH007              variant_shadow_binding      (35.semantics/lint/hir_frontend_diagnostics.spl)
#   MEXH004/008/009      non_exhaustive_match        (same module, HIR arm reachability)
#   W-HIR-INFER-001/002  inferred_type_fallback_use  (same module)
#
# WHY A RATCHET: the plans (UP §4 / BP §15) make every new restriction
# warn-first. The measured population per rule is frozen in
# scripts/check/frontend_diag_baseline.txt; GROWTH of any rule's count FAILS,
# a count that FELL is a stale baseline and also FAILS (same contract as
# check-any-inventory-ratchet.shs). Regenerate only with --generate-baseline
# after reading the diff.
#
# MEASUREMENT: `bin/simple check` (semantic) per file, warnings grepped by
# rule id. Single-file lowering cannot resolve imports, so W-HIR-INFER-001
# UNDERCOUNTS here; the driver typecheck pass is the full-closure measurement.
#
# VERDICT (always the last line of stdout)
#   PASS  — <n> file(s) checked, <k> finding(s) (baseline <b>)   exit 0
#   FAIL  — ...                                                 exit 1
#   ERROR — nothing was checked (<reason>)                      exit 2
set -u

ROOT="$(pwd)"
GENERATE=0
LIMIT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --root) ROOT="${2:-}"; shift 2 ;;
    --generate-baseline) GENERATE=1; shift ;;
    --limit) LIMIT="${2:-}"; shift 2 ;;
    --all) ALL_FILES=1; shift ;;
    *) echo "ERROR — unknown argument: $1"; exit 2 ;;
  esac
done

BASELINE="$ROOT/scripts/check/frontend_diag_baseline.txt"
SIMPLE="${SIMPLE_BIN:-$ROOT/bin/simple}"
[ -x "$SIMPLE" ] || { echo "ERROR — nothing was checked (no runnable simple at $SIMPLE; set SIMPLE_BIN)"; exit 2; }

TMP="$(mktemp -d 2>/dev/null || echo "${TMPDIR:-/tmp}/fdr.$$")"
mkdir -p "$TMP"
trap 'rm -rf "$TMP"' EXIT INT TERM

# Scope: the pinned module list in frontend_diag_scope.txt (the 28 modules the
# 2026-10-10 baseline was measured on; one `simple check` per module costs
# ~10 s on the seed, so the whole tree is not a pre-push budget). `--all`
# widens to every src/compiler/**.spl — regenerate the baseline when you do.
SCOPE="$ROOT/scripts/check/frontend_diag_scope.txt"
if [ "${ALL_FILES:-0}" -eq 1 ] || [ ! -f "$SCOPE" ]; then
  find "$ROOT/src/compiler" -name '*.spl' -type f 2>/dev/null \
    | grep -v '/archive/\|/generated/' | sort > "$TMP/files"
else
  sed "s|^|$ROOT/|" "$SCOPE" | grep . > "$TMP/files"
fi
[ -n "$LIMIT" ] && { head -n "$LIMIT" "$TMP/files" > "$TMP/files.l"; mv "$TMP/files.l" "$TMP/files"; }
N=$(grep -c . "$TMP/files")
[ "$N" -gt 0 ] || { echo "ERROR — nothing was checked (no src/compiler/**.spl under $ROOT)"; exit 2; }

: > "$TMP/findings"
while IFS= read -r f; do
  [ -n "$f" ] || continue
  "$SIMPLE" check "$f" 2>/dev/null \
    | grep -o '\[\(E-TYPE-NIL-COMPARE\|MEXH007\|MEXH008\|MEXH009\|MEXH004\|W-HIR-INFER-001\|W-HIR-INFER-002\)\]' \
    | tr -d '[]' >> "$TMP/findings" || :
done < "$TMP/files"

sort "$TMP/findings" | uniq -c | awk '{print $2" "$1}' | sort > "$TMP/counts"
TOTAL=$(grep -c . "$TMP/findings" | tr -d ' ')

if [ "$GENERATE" -eq 1 ]; then
  cp "$TMP/counts" "$BASELINE"
  echo "PASS — $N file(s) checked, $TOTAL finding(s) (baseline regenerated)"
  exit 0
fi
[ -f "$BASELINE" ] || { echo "ERROR — nothing was checked (missing $BASELINE; run --generate-baseline)"; exit 2; }

FAIL=""
for rule in E-TYPE-NIL-COMPARE MEXH007 MEXH008 MEXH009 MEXH004 W-HIR-INFER-001 W-HIR-INFER-002; do
  now=$(awk -v r="$rule" '$1==r{print $2}' "$TMP/counts"); now=${now:-0}
  base=$(awk -v r="$rule" '$1==r{print $2}' "$BASELINE"); base=${base:-0}
  if [ "$now" -gt "$base" ]; then FAIL="$FAIL $rule:+$((now-base))"; fi
  if [ "$now" -lt "$base" ]; then FAIL="$FAIL $rule:stale($now<$base)"; fi
done
BASE_TOTAL=$(awk '{s+=$2} END{print s+0}' "$BASELINE")
if [ -n "$FAIL" ]; then
  echo "FAIL — $N file(s) checked, $TOTAL finding(s) (baseline $BASE_TOTAL):$FAIL"
  exit 1
fi
echo "PASS — $N file(s) checked, $TOTAL finding(s) (baseline $BASE_TOTAL)"
exit 0
