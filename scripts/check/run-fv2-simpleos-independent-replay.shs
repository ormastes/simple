#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
adapter="$root/build/fv2-tools/independent_replay_adapter"
tool_manifest="$root/build/fv2-tools/manifest.txt"
output="$root/build/verification/simpleos-independent-replay"

is_sha256() {
    case "$1" in ""|*[!0-9a-f]*) return 1 ;; esac
    [ "${#1}" -eq 64 ]
}

if [ "${1:-}" = "--self-test" ]; then
    is_sha256 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
    if is_sha256 xyz; then exit 1; fi
    grep -Fq 'KernelCapabilities.rights_allow9_sound' "$0"
    grep -Fq 'KernelScheduler.complete_refinement_bundle' "$0"
    grep -Fq 'ActorChannel.GreenCloseExact.close_drain_refinement_bundle' "$0"
    grep -Fq 'MemoryCapabilities.SharedUnmapExact.shared_unmap_refinement_bundle' "$0"
    grep -Fq 'ProcessLifecycle.ProcessWaitExact.process_wait_refinement_bundle' "$0"
    grep -Fq 'ActorChannel.ProcessQueueExact.process_queue_refinement_bundle' "$0"
    grep -Fq 'DbStorage.TxnCommitExact.commit_refinement_bundle' "$0"
    grep -Fq 'module_olean_sha256=' "$0"
    echo "STATUS: PASS FV2 SimpleOS independent replay self-test"
    exit 0
fi

[ -x "$adapter" ] || { echo "FAIL: provision FV2 independent replay tools first" >&2; exit 1; }
[ -s "$tool_manifest" ] || { echo "FAIL: FV2 independent replay tool manifest is missing" >&2; exit 1; }
adapter_sha=$(sha256sum "$adapter" | awk '{print $1}')
manifest_adapter_sha=$(sed -n 's/^adapter_sha256=//p' "$tool_manifest")
[ "$adapter_sha" = "$manifest_adapter_sha" ] || { echo "FAIL: FV2 adapter differs from its tool manifest" >&2; exit 1; }

mkdir -p "$output"
# Never leave an older accepted aggregate beside a rejected rerun.
rm -f "$output/receipt.sdn" "$output/rejected-partial.sdn"
receipt_tmp="$output/.receipt.tmp.$$"
trap 'rm -f "$receipt_tmp"' EXIT HUP INT TERM
{
    echo "schema=FV2SimpleOsIndependentReplay-v1"
    echo "adapter_sha256=$adapter_sha"
    echo "tool_manifest_sha256=$(sha256sum "$tool_manifest" | awk '{print $1}')"
} >"$receipt_tmp"
failures=0

run_root() {
    label=$1 project=$2 module=$3 source=$4 theorem=$5
    [ -f "$root/$project/lakefile.toml" ] || { echo "FAIL: missing Lake project: $project" >&2; exit 1; }
    [ -f "$root/$source" ] || { echo "FAIL: missing theorem source: $source" >&2; exit 1; }
    source_sha=$(sha256sum "$root/$source" | awk '{print $1}')
    is_sha256 "$source_sha" || exit 1
    # Build the exact module, not merely the project's default aggregate: some
    # model projects intentionally omit vertical-slice files from that target.
    if ! lake -d "$root/$project" build "$module" >"$output/$label.lake.log" 2>&1; then
        echo "FAIL: Lake build failed: $label" >&2
        failures=$((failures + 1))
        return
    fi
    module_rel=$(printf '%s' "$module" | tr '.' '/')
    module_olean="$root/$project/.lake/build/lib/lean/$module_rel.olean"
    if [ ! -f "$module_olean" ]; then
        echo "FAIL: built module artifact is missing: $label" >&2
        failures=$((failures + 1))
        return
    fi
    module_olean_sha=$(sha256sum "$module_olean" | awk '{print $1}')
    is_sha256 "$module_olean_sha" || { failures=$((failures + 1)); return; }
    if ! "$adapter" "$root/$project" "$module" "$module_olean" "$module_olean_sha" "$theorem" \
        >"$output/$label.replay.log" 2>&1; then
        echo "FAIL: independent replay rejected: $label" >&2
        failures=$((failures + 1))
        return
    fi
    if ! grep -Fq "FV2-INDEPENDENT-ACCEPTED module=$module declaration_root=$theorem artifact=$module_olean_sha" \
        "$output/$label.replay.log" || ! grep -Eq '^Checked [1-9][0-9]* declarations with no errors$' \
        "$output/$label.replay.log"; then
        echo "FAIL: independent replay output contract mismatch: $label" >&2
        failures=$((failures + 1))
        return
    fi
    {
        echo "root=$theorem"
        echo "project=$project"
        echo "module=$module"
        echo "source_sha256=$source_sha"
        echo "module_olean_sha256=$module_olean_sha"
        echo "lake_output_sha256=$(sha256sum "$output/$label.lake.log" | awk '{print $1}')"
        echo "replay_output_sha256=$(sha256sum "$output/$label.replay.log" | awk '{print $1}')"
    } >>"$receipt_tmp"
}

run_root capability src/verification/kernel_capabilities KernelCapabilities.Theorems \
    src/verification/kernel_capabilities/KernelCapabilities/Theorems.lean \
    KernelCapabilities.rights_allow9_sound
run_root scheduler src/verification/kernel_scheduler KernelScheduler.Theorems \
    src/verification/kernel_scheduler/KernelScheduler/Theorems.lean \
    KernelScheduler.complete_refinement_bundle
run_root channel_close src/verification/actor_channel ActorChannel.GreenCloseExact \
    src/verification/actor_channel/ActorChannel/GreenCloseExact.lean \
    ActorChannel.GreenCloseExact.close_drain_refinement_bundle
run_root shared_unmap src/verification/memory_capabilities SharedUnmapExact \
    src/verification/memory_capabilities/src/SharedUnmapExact.lean \
    MemoryCapabilities.SharedUnmapExact.shared_unmap_refinement_bundle
run_root process_wait src/verification/process_lifecycle ProcessWaitExact \
    src/verification/process_lifecycle/src/ProcessWaitExact.lean \
    ProcessLifecycle.ProcessWaitExact.process_wait_refinement_bundle
run_root process_queue src/verification/actor_channel ActorChannel.ProcessQueueExact \
    src/verification/actor_channel/ActorChannel/ProcessQueueExact.lean \
    ActorChannel.ProcessQueueExact.process_queue_refinement_bundle
run_root dbfs_commit src/verification/db_storage DbStorage.TxnCommitExact \
    src/verification/db_storage/DbStorage/TxnCommitExact.lean \
    DbStorage.TxnCommitExact.commit_refinement_bundle

if [ "$failures" -ne 0 ]; then
    mv "$receipt_tmp" "$output/rejected-partial.sdn"
    trap - EXIT HUP INT TERM
    echo "STATUS: FAIL FV2 SimpleOS independent replay rejected_roots=$failures" >&2
    exit 1
fi

mv "$receipt_tmp" "$output/receipt.sdn"
trap - EXIT HUP INT TERM
echo "STATUS: PASS FV2 SimpleOS independent replay receipt=$output/receipt.sdn"
