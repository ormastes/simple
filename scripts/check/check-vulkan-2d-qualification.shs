#!/bin/sh
# Physical Linux 2D qualification. The compiled Simple
# application owns worker isolation, evidence checks, and the verdict.
set -eu

if [ "$(uname -s)" != Linux ]; then
    printf '%s\n' 'SKIP: physical Linux Vulkan device required' >&2
    exit 77
fi

if [ "$#" -ne 3 ] && [ "$#" -ne 4 ]; then
    printf '%s\n' 'usage: check-vulkan-2d-qualification.shs <absolute-compiled-worker> <absolute-skia-provider-so> <fresh-build/test-artifacts/vulkan_2d/name> [clip|gui-button|web-box|corpus-case01|corpus-case06]' >&2
    exit 2
fi

worker=$1
provider=$2
output=$3
mode=run
if [ "$#" -eq 4 ]; then
    case "$4" in
        clip) mode=run-clip ;;
        gui-button) mode=run-gui-button ;;
        web-box) mode=run-web-box ;;
        corpus-case01) mode=run-corpus-case01 ;;
        corpus-case06) mode=run-corpus-case06 ;;
        *) printf '%s\n' 'fourth argument must be clip, gui-button, web-box, corpus-case01, or corpus-case06' >&2; exit 2 ;;
    esac
fi
case "$worker" in /*) ;; *) printf '%s\n' 'worker path must be absolute' >&2; exit 2 ;; esac
case "$provider" in /*) ;; *) printf '%s\n' 'provider path must be absolute' >&2; exit 2 ;; esac
[ -f "$worker" ] && [ ! -L "$worker" ] || { printf '%s\n' 'compiled worker missing or symlinked' >&2; exit 2; }
[ -f "$provider" ] && [ ! -L "$provider" ] || { printf '%s\n' 'Skia provider missing or symlinked' >&2; exit 2; }

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo_root"
exec "$worker" "$mode" "$worker" "$provider" "$output"
