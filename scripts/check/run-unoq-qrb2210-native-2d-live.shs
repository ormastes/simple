#!/bin/sh
# Live UNO Q QRB2210 SimpleOS evidence runner.  Evidence inputs are deliberately
# not accepted: this process owns device selection, execution and acquisition.
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
OUT_DIR=${UNOQ_LIVE_OUT_DIR:-$ROOT_DIR/build/unoq-qrb2210-native-2d-live}
DEVICE=""
TIMEOUT_SECS=${UNOQ_LIVE_TIMEOUT_SECS:-120}
REMOTE_RUNNER=/usr/bin/simpleos-unoq-2d-evidence
REMOTE_RECEIPT=/run/simpleos/evidence/unoq-native-2d.env
REMOTE_CAPTURE=/run/simpleos/evidence/unoq-native-2d.rgba

usage() {
    echo "usage: $0 [--device ADB_SERIAL] [--output-dir DIR] [--timeout SECONDS]"
    echo "The runner accepts no transcript, receipt, capture, or replay input."
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --device) shift; DEVICE=${1:-} ;;
        --output-dir) shift; OUT_DIR=${1:-} ;;
        --timeout) shift; TIMEOUT_SECS=${1:-} ;;
        --transcript|--receipt|--capture|--replay|--offline)
            echo "unoq_native_2d_live_status=fail"
            echo "unoq_native_2d_live_reason=caller-supplied-evidence-forbidden"
            exit 1 ;;
        --help|-h) usage; exit 0 ;;
        *) echo "unoq_native_2d_live_status=fail"; echo "unoq_native_2d_live_reason=unknown-argument:$1"; exit 1 ;;
    esac
    shift
done

blocked() {
    echo "unoq_native_2d_live_status=blocked"
    echo "unoq_native_2d_live_reason=$1"
    echo "unoq_native_2d_live_evidence_class=live-runner-owned"
    exit 2
}
failed() {
    echo "unoq_native_2d_live_status=fail"
    echo "unoq_native_2d_live_reason=$1"
    echo "unoq_native_2d_live_evidence_class=live-runner-owned"
    exit 1
}

case "$TIMEOUT_SECS" in ''|*[!0-9]*) failed "invalid-timeout" ;; esac
[ "$TIMEOUT_SECS" -gt 0 ] || failed "invalid-timeout"
command -v adb >/dev/null 2>&1 || blocked "adb-missing"
command -v timeout >/dev/null 2>&1 || blocked "timeout-missing"
command -v sha256sum >/dev/null 2>&1 || blocked "sha256sum-missing"
command -v od >/dev/null 2>&1 || blocked "od-missing"

devices=$(adb devices 2>/dev/null | awk 'NR > 1 && $2 == "device" { print $1 }')
if [ -z "$DEVICE" ]; then
    count=$(printf '%s\n' "$devices" | sed '/^$/d' | wc -l | tr -d ' ')
    [ "$count" -gt 0 ] || blocked "qrb2210-board-not-connected"
    [ "$count" -eq 1 ] || blocked "multiple-adb-devices-select-device"
    DEVICE=$devices
else
    printf '%s\n' "$devices" | grep -Fqx -- "$DEVICE" || blocked "selected-adb-device-not-authorized"
fi
case "$DEVICE" in *[!A-Za-z0-9._:-]*) failed "unsafe-adb-device-id" ;; esac

adb_run() { timeout "$TIMEOUT_SECS" adb -s "$DEVICE" "$@"; }
hardware=$(adb_run shell getprop ro.boot.hardware 2>/dev/null | tr -d '\r\n')
product=$(adb_run shell getprop ro.product.board 2>/dev/null | tr -d '\r\n')
case "$(printf '%s %s' "$hardware" "$product" | tr '[:upper:]' '[:lower:]')" in
    *qrb2210*|*uno*q*) ;;
    *) blocked "connected-device-is-not-qrb2210-uno-q" ;;
esac

mkdir -p "$OUT_DIR"
run_id="unoq-live-$(date -u +%Y%m%dT%H%M%SZ)-$$"
receipt="$OUT_DIR/$run_id.serial.env"
capture="$OUT_DIR/$run_id.rgba"
report="$OUT_DIR/$run_id.evidence.env"

# The production board provider owns event injection, drawing, GPU synchronization,
# audio completion, and its serial receipt. The host owns invocation and all reads.
if ! adb_run shell test -x "$REMOTE_RUNNER" >/dev/null 2>&1; then
    blocked "production-board-evidence-provider-missing"
fi
if ! adb_run shell "$REMOTE_RUNNER" --run-id "$run_id" --frames 20 \
    --receipt "$REMOTE_RECEIPT" --capture "$REMOTE_CAPTURE" >/dev/null 2>&1; then
    blocked "production-board-evidence-provider-failed"
fi
adb_run shell cat "$REMOTE_RECEIPT" | tr -d '\r' >"$receipt" || blocked "serial-receipt-acquisition-failed"
adb_run exec-out cat "$REMOTE_CAPTURE" >"$capture" || blocked "frame-capture-acquisition-failed"
[ -s "$receipt" ] || blocked "serial-receipt-empty"
[ -s "$capture" ] || blocked "frame-capture-empty"

value() {
    key=$1
    count=$(sed -n "s/^$key=//p" "$receipt" | wc -l | tr -d ' ')
    [ "$count" = 1 ] || failed "$key-missing-or-duplicate"
    result=$(sed -n "s/^$key=//p" "$receipt")
    case "$result" in *[!A-Za-z0-9._:+-]*) failed "$key-unsafe-value" ;; esac
    printf '%s\n' "$result"
}
positive() { case "$1" in ''|*[!0-9]*|0) return 1 ;; *) return 0 ;; esac; }
unsigned_value() {
    unsigned_result=$(value "$1")
    case "$unsigned_result" in ''|*[!0-9]*) failed "$1-not-unsigned-integer" ;; esac
    printf '%s\n' "$unsigned_result"
}

for numeric_key in draw_ir_op_count animation_frame_count font_glyph_count \
    submit_count fence_count readback_bytes expected_checksum actual_checksum \
    audio_submitted audio_completed capture_width capture_height \
    warm_frame_count warm_p95_frame_time_us warm_p95_budget_us peak_rss_bytes \
    peak_rss_budget_bytes; do
    unsigned_value "$numeric_key" >/dev/null
done

[ "$(value run_id)" = "$run_id" ] || failed "run-id-correlation-mismatch"
[ "$(value adb_serial)" = "$DEVICE" ] || failed "adb-serial-correlation-mismatch"
[ "$(value board_id)" = qrb2210-uno-q ] || failed "board-identity-mismatch"
[ "$(value boot_id)" != "" ] || failed "boot-identity-missing"
[ "$(value frame_id)" = "$(value capture_frame_id)" ] || failed "frame-capture-correlation-mismatch"
[ "$(value capture_format)" = rgba8888 ] || failed "capture-format-not-rgba8888"
width=$(unsigned_value capture_width); height=$(unsigned_value capture_height)
positive "$width" && positive "$height" || failed "capture-dimensions-invalid"
expected_bytes=$((width * height * 4))
actual_bytes=$(wc -c <"$capture" | tr -d ' ')
[ "$actual_bytes" -eq "$expected_bytes" ] || failed "capture-byte-count-mismatch"
capture_sha=$(sha256sum "$capture" | awk '{print $1}')
[ "$(value capture_sha256)" = "$capture_sha" ] || failed "capture-sha256-mismatch"

[ "$(unsigned_value animation_frame_count)" -ge 20 ] || failed "twenty-animation-frames-not-proven"
warm_frames=$(unsigned_value warm_frame_count); p95=$(unsigned_value warm_p95_frame_time_us)
p95_budget=$(unsigned_value warm_p95_budget_us); rss=$(unsigned_value peak_rss_bytes); rss_budget=$(unsigned_value peak_rss_budget_bytes)
positive "$warm_frames" && [ "$warm_frames" -ge 20 ] || failed "warm-frame-sample-incomplete"
positive "$p95" && positive "$p95_budget" && [ "$p95" -le "$p95_budget" ] || failed "warm-p95-budget-failed"
positive "$rss" && positive "$rss_budget" && [ "$rss" -le "$rss_budget" ] || failed "peak-rss-budget-failed"
[ "$(unsigned_value submit_count)" -ge 1 ] && [ "$(unsigned_value fence_count)" -ge 1 ] || failed "submit-fence-incomplete"
[ "$(value readback_source)" = device_readback ] || failed "device-readback-not-proven"
[ "$(unsigned_value font_glyph_count)" -ge 1 ] || failed "font-rendering-not-proven"

simple=${SIMPLE_BIN:-$ROOT_DIR/bin/release/x86_64-unknown-linux-gnu/simple}
[ -x "$simple" ] || blocked "pure-simple-runtime-missing"
version=$($simple --version 2>&1 || true)
case "$version" in *'Rust-built'*|*'bootstrap seed only'*) blocked "runtime-is-rust-seed" ;; esac

set +e
admission=$(SIMPLE_LIB="$ROOT_DIR/src" "$simple" run \
    "$ROOT_DIR/scripts/check/validate-unoq-qrb2210-native-2d-receipt.spl" \
    "$(value board_id)" "$(value platform)" "$(value arch)" \
    "$(value gpu_vendor_id)" "$(value gpu_name)" "$(value backend)" \
    "$(value draw_ir)" "$(value draw_ir_op_count)" "$(value animation_frame_count)" \
    "$(value font_glyph_count)" "$(value device_executed)" "$(value physical_device)" \
    "$(value fallback_used)" "$(value submit_count)" "$(value fence_count)" \
    "$(value readback_bytes)" "$(value expected_checksum)" "$(value actual_checksum)" \
    "$(value boot_id)" "$(value frame_id)" "$(value capture_frame_id)" \
    "$(value ctrl_left)" "$(value ctrl_right)" "$(value alt_left)" "$(value alt_right)" \
    "$(value key_down)" "$(value key_up)" "$(value pointer_move)" "$(value pointer_down)" \
    "$(value pointer_drag)" "$(value pointer_up)" "$(value pointer_wheel)" \
    "$(value audio_submitted)" "$(value audio_completed)" "$(value audio_non_silent)" 2>&1)
admission_rc=$?
set -e
printf '%s\n' "$admission"
{
    echo "unoq_native_2d_live_run_id=$run_id"
    echo "unoq_native_2d_live_adb_serial=$DEVICE"
    echo "unoq_native_2d_live_receipt=$receipt"
    echo "unoq_native_2d_live_capture=$capture"
    echo "unoq_native_2d_live_capture_sha256=$capture_sha"
    echo "unoq_native_2d_live_warm_p95_frame_time_us=$p95"
    echo "unoq_native_2d_live_peak_rss_bytes=$rss"
} >"$report"
if [ "$admission_rc" -eq 2 ]; then blocked "canonical-simpleos-qrb2210-port-unavailable"; fi
[ "$admission_rc" -eq 0 ] || failed "pure-simple-admission-rejected"
echo "unoq_native_2d_live_status=pass"
echo "unoq_native_2d_live_reason=all-live-physical-receipts-admitted"
echo "unoq_native_2d_live_evidence_class=live-runner-owned"
echo "unoq_native_2d_live_report=$report"
