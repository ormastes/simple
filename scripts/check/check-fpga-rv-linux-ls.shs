#!/bin/sh
# check-fpga-rv-linux-ls.shs — FPGA Simple-RISC-V load -> Linux boot -> `ls` works.
#
# Drives the existing KV260 rv64 lane (scripts/fpga/check_kv260_simple_rv64_linux.shs);
# this wrapper adds the acceptance bar rules.sdl needs: a PASS may ONLY be reported
# when a real transcript shows Linux booted on the Simple RISC-V core AND an `ls`
# command produced directory output.
#
# Board absent => exit 0 with a LOUD notice, per the owner's decision:
#   SKIPPED — FPGA BOARD ABSENT, LANE NOT VERIFIED
# Exit 0 keeps an unrelated push from being blocked by hardware nobody has plugged in,
# but the lane makes NO claim. A skipped lane is never a passing one, and the caller
# (check-rules-sdl.shs) counts skips separately in its summary. There is deliberately
# no flag that converts a skip into a pass.
#
# Verdict is the LAST LINE of stdout; exit status is corroboration only:
#   PASS — Linux booted on Simple RISC-V, `ls` returned <n> entries   exit 0
#   SKIPPED — FPGA BOARD ABSENT, LANE NOT VERIFIED                    exit 0
#   FAIL — ...                                                        exit 1
#   ERROR — nothing was checked                                       exit 2
set -u

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
LANE="$REPO_ROOT/scripts/fpga/check_kv260_simple_rv64_linux.shs"
OUT_DIR="${OUT_DIR:-$REPO_ROOT/build/fpga/rv_linux_ls}"
TIMEOUT_SECS="${FPGA_LANE_TIMEOUT:-1800}"
SELFTEST_ONLY=0

while [ $# -gt 0 ]; do
    case "$1" in
        --selftest) SELFTEST_ONLY=1; shift ;;
        --out-dir) OUT_DIR=$2; shift 2 ;;
        -h|--help) echo "usage: $0 [--out-dir DIR] [--selftest]" >&2; exit 2 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

# Board presence: a JTAG/serial cable and the Xilinx tooling. Any missing piece means
# the board is not reachable -- report absent rather than inventing a failure.
board_present() {
    have_tool=0
    command -v xsdb >/dev/null 2>&1 && have_tool=1
    command -v hw_server >/dev/null 2>&1 && have_tool=1
    [ "$have_tool" -eq 1 ] || return 1
    # A KV260 exposes an FTDI serial console; no tty, no board.
    ls /dev/ttyUSB* /dev/ttyACM* >/dev/null 2>&1 || return 1
    return 0
}

# The acceptance bar. Applied to a transcript, never to a claim.
# `ls` evidence = the marker the lane prints around the guest command plus at least one
# real directory entry; a bare exit code proves the command ran, not that Linux served it.
transcript_proves_linux_ls() {
    log=$1
    [ -s "$log" ] || return 1
    grep -qiE 'Linux version|Booting Linux|Freeing unused kernel' "$log" || return 1
    grep -qiE 'RV-LINUX-LS(-BEGIN)?' "$log" || return 1
    grep -qE '^(bin|dev|etc|proc|root|sbin|sys|tmp|usr|var)$' "$log" || return 1
    return 0
}

selftest() {
    st=$(mktemp -d) || return 1
    rc=0

    # arm 1: an empty transcript must NOT prove anything
    : > "$st/empty.log"
    if transcript_proves_linux_ls "$st/empty.log"; then
        echo "selftest arm1: empty transcript wrongly accepted" >&2; rc=1
    fi

    # arm 2: a boot with no `ls` evidence must NOT pass (the exact fraud: boot, claim ls)
    printf 'Linux version 6.1.0\nFreeing unused kernel memory\n' > "$st/boot_only.log"
    if transcript_proves_linux_ls "$st/boot_only.log"; then
        echo "selftest arm2: boot-without-ls wrongly accepted" >&2; rc=1
    fi

    # arm 3: `ls` output with no Linux boot must NOT pass
    printf 'RV-LINUX-LS-BEGIN\nbin\nusr\n' > "$st/ls_only.log"
    if transcript_proves_linux_ls "$st/ls_only.log"; then
        echo "selftest arm3: ls-without-boot wrongly accepted" >&2; rc=1
    fi

    # arm 4: the genuine article must pass
    printf 'Linux version 6.1.0 (simple-rv64)\nFreeing unused kernel memory\nRV-LINUX-LS-BEGIN\nbin\ndev\netc\nusr\n' > "$st/good.log"
    if ! transcript_proves_linux_ls "$st/good.log"; then
        echo "selftest arm4: genuine transcript wrongly rejected" >&2; rc=1
    fi

    rm -rf "$st"
    return $rc
}

if ! selftest; then
    echo "ERROR — nothing was checked (selftest failed; the guard itself is broken)"
    exit 2
fi
[ "$SELFTEST_ONLY" -eq 1 ] && { echo "PASS — 4 selftest arms checked, guard calibrated"; exit 0; }

if [ ! -f "$LANE" ]; then
    echo "ERROR — nothing was checked (missing lane script: $LANE)"
    exit 2
fi

if ! board_present; then
    echo "SKIPPED — FPGA BOARD ABSENT, LANE NOT VERIFIED"
    exit 0
fi

mkdir -p "$OUT_DIR" || { echo "ERROR — nothing was checked (cannot create $OUT_DIR)"; exit 2; }
log="$OUT_DIR/rv_linux_ls.log"

timeout "$TIMEOUT_SECS" sh "$LANE" >"$log" 2>&1
lane_rc=$?
if [ $lane_rc -eq 124 ]; then
    echo "FAIL — lane timed out after ${TIMEOUT_SECS}s (transcript: $log)"
    exit 1
fi

if transcript_proves_linux_ls "$log"; then
    entries=$(grep -cE '^(bin|dev|etc|proc|root|sbin|sys|tmp|usr|var)$' "$log")
    echo "PASS — Linux booted on Simple RISC-V, \`ls\` returned $entries entries (transcript: $log)"
    exit 0
fi

echo "FAIL — board present but transcript does not prove Linux boot + \`ls\` (lane rc=$lane_rc, transcript: $log)"
exit 1
