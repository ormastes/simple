#!/bin/sh
# sspec-score-seed-lane.shs — measure the modern-sspec documentization score
# on a host that has NO full-CLI pure-Simple binary (only the bootstrap CLI +
# the Rust seed), which is where `simple sspec-maintain scan` cannot run.
#
# What it does (2026-09-05, macOS aarch64):
#   1. Copies src/app/sspec_maintain/{model,rules,score,source_facts,analyzer}.spl
#      through a WHITESPACE/COMMENT-ONLY reshaping so the Rust seed's older
#      parser accepts them (joins trailing `or`/`and`/`+` continuations, expands
#      inline `if c: x = y [else: x = z]` into blocks). Nothing under src/ is
#      touched — the seed's grammar lag is the seed's bug, not the scorer's
#      (doc/08_tracking/bug/rust_seed_parser_behind_main_grammar_blocks_simple_test_2026-09-05.md).
#   2. PROVES each copy equals its original after stripping full-line comments
#      and all whitespace (sha1 of the residue). A DIFF aborts with exit 2 —
#      a score from an unproven copy is not a score of the real scorer.
#   3. Concatenates the copies with three NAMED deltas the seed forces:
#        a. zero-arg text.split()  -> _ws_split (whitespace split)
#        b. std.crypto.sha256      -> rt_file_hash_sha256 over a temp file
#        c. lifecycle.spl          -> same 8 lines over rt_file_exists
#      (std.crypto.sha256, std.cli.cli_util and file_ops do not load under the
#      seed: `@unsafe` / `always_inline` / execution_metrics grammar.)
#   4. Runs `simple_seed run` on the assembled file and prints, per spec, BOTH
#      scoring surfaces:
#        GATE = analyze_sspec_text       (what bin/simple test enforces,
#                                         src/app/test_runner_new/sspec_score_gate.spl,
#                                         default min 80, SIMPLE_SSPEC_MIN_SCORE)
#        SCAN = analyze_sspec_pair_text + lifecycle links
#                                        (what `simple sspec-maintain scan` reports:
#                                         adds MNT-002 for a missing doc/06_spec
#                                         mirror and MNT-009 for stale links)
#
# Usage:
#   sh scripts/check/sspec-score-seed-lane.shs <spec.spl|dir> [...]
#   SIMPLE_SEED=<path> overrides the seed binary.
# Verdict is the LAST line: `PASS — <n> spec(s) scored` exit 0, or
# `ERROR — nothing was checked (<why>)` exit 2. This script never judges a
# threshold; read the numbers. Exit status is read directly, never via a pipe.
set -u
repo_root=$(cd "$(dirname "$0")/../.." && pwd)
cd "$repo_root" || exit 2
SEED=${SIMPLE_SEED:-bin/release/aarch64-apple-darwin/simple_seed}
if [ ! -x "$SEED" ]; then
  echo "ERROR — nothing was checked (seed binary not executable: $SEED)"; exit 2
fi
# Per-run private work dir. The generated scorer below bakes these paths into
# its source, so two concurrent runs sharing one dir clobber each other's spec
# list -- measured 2026-09-05: a lane scored three OTHER lanes' specs and never
# touched its target. SSPEC_SEED_LANE_WORK pins a dir when a caller needs one.
work=${SSPEC_SEED_LANE_WORK:-build/nb/seed_lane.$$}
mkdir -p "$work/scorer" "$work/tmp"

# ---- collect spec paths -----------------------------------------------------
: > "$work/paths.txt"
for arg in "$@"; do
  if [ -d "$arg" ]; then
    find "$arg" -name '*_spec.spl' | sort >> "$work/paths.txt"
  elif [ -f "$arg" ]; then
    echo "$arg" >> "$work/paths.txt"
  else
    echo "ERROR — nothing was checked (no such path: $arg)"; exit 2
  fi
done
count=$(grep -c . "$work/paths.txt")
if [ "$count" -eq 0 ]; then
  echo "ERROR — nothing was checked (no *_spec.spl under the given paths)"; exit 2
fi

# ---- 1. reshape copies -------------------------------------------------------
cat > "$work/seedify.awk" <<'AWK'
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
function is_comment(s) { return trim(s) ~ /^#/ }
function ends_cont(s) { s = trim(s); return (s ~ / or$/ || s ~ / and$/ || s ~ / \+$/) }
function split_colon(s,    i, c, inq, esc, n) {
    inq = 0; esc = 0; n = length(s)
    for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (inq) { if (esc) esc = 0; else if (c == "\\") esc = 1; else if (c == "\"") inq = 0 }
        else if (c == "\"") inq = 1
        else if (c == ":" && substr(s, i + 1, 1) == " ") return i
    }
    return 0
}
function is_assign_body(b,    i, c, n, inq, esc, p, q) {
    inq = 0; esc = 0; n = length(b)
    for (i = 1; i <= n; i++) {
        c = substr(b, i, 1)
        if (inq) { if (esc) esc = 0; else if (c == "\\") esc = 1; else if (c == "\"") inq = 0; continue }
        if (c == "\"") { inq = 1; continue }
        if (c == "=") {
            p = substr(b, i - 1, 1); q = substr(b, i + 1, 1)
            if (p != "=" && p != "!" && p != "<" && p != ">" && q != "=") return 1
            if (q == "=") i++
        }
    }
    return 0
}
function emit(s,    ind, head, body, pos, t, ep) {
    t = trim(s)
    if (t ~ /^(if|elif|while|else|for|match|case) / || t == "else:") {
        pos = split_colon(s)
        if (pos > 0) {
            head = substr(s, 1, pos); body = trim(substr(s, pos + 1))
            if (body != "" && is_assign_body(body) && body !~ /^#/) {
                match(s, /^[ \t]*/); ind = substr(s, 1, RLENGTH)
                ep = index(body, " else: ")
                if (ep > 0) { print head; print ind "    " substr(body, 1, ep - 1); print ind "else:"; print ind "    " substr(body, ep + 7); return }
                print head; print ind "    " body; return
            }
        }
    }
    print s
}
{ lines[NR] = $0 }
END {
    i = 1
    while (i <= NR) {
        cur = lines[i]
        if (!is_comment(cur) && ends_cont(cur)) {
            pending = ""; j = i + 1
            while (j <= NR && ends_cont(cur) && !is_comment(cur)) {
                nxt = lines[j]
                if (trim(nxt) == "") { j++; continue }
                if (is_comment(nxt)) { pending = pending nxt "\n"; j++; continue }
                cur = cur " " trim(nxt); j++
            }
            if (pending != "") printf "%s", pending
            emit(cur); i = j
        } else { emit(cur); i++ }
    }
}
AWK

# ---- 2. prove the copies -----------------------------------------------------
proof_ok=1
for m in model rules score source_facts analyzer; do
  src=src/app/sspec_maintain/$m.spl
  awk -f "$work/seedify.awk" "$src" | grep -vE '^use app\.sspec_maintain' | grep -vE '^use std\.(crypto|tooling)' > "$work/scorer/$m.spl"
  a=$(grep -vE '^[[:space:]]*#' "$src" | grep -vE '^use ' | tr -d '[:space:]' | shasum | cut -c1-12)
  b=$(grep -vE '^[[:space:]]*#' "$work/scorer/$m.spl" | grep -vE '^use ' | tr -d '[:space:]' | shasum | cut -c1-12)
  if [ "$a" = "$b" ]; then v=SAME; else v=DIFF; proof_ok=0; fi
  echo "proof $m $v sha256(src)=$(shasum -a 256 "$src" | cut -c1-16)"
done
if [ "$proof_ok" != 1 ]; then
  echo "ERROR — nothing was checked (a reshaped copy differs from its source beyond whitespace/comments)"; exit 2
fi

# ---- 3. assemble -------------------------------------------------------------
OUT=$work/sspec_score_seed.spl
{
  cat <<'EOF'
# Generated by scripts/check/sspec-score-seed-lane.shs — do not edit.
use std.tooling.easy_fix.types.{EasyFix, Replacement, FixConfidence}
extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_hash_sha256(path: text) -> text

fn sha256_text(s: text) -> text:
    rt_file_write_text("@@WORK@@/tmp/.sha_tmp", s)
    rt_file_hash_sha256("@@WORK@@/tmp/.sha_tmp")

fn _ws_split(s: text) -> [text]:
    var out: [text] = []
    var cur = ""
    for ch in s:
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r":
            if cur != "":
                out.push(cur)
            cur = ""
        else:
            cur = cur + ch
    if cur != "":
        out.push(cur)
    out
EOF
  for m in model rules score source_facts analyzer; do
    echo; echo "# ===== copy of src/app/sspec_maintain/$m.spl ====="; cat "$work/scorer/$m.spl"
  done
  cat <<'EOF'

# ===== lifecycle.spl twin (same logic; file_exists -> rt_file_exists) =====
fn inspect_sspec_lifecycle_links(report: SspecDocumentizationReport,
        source: text) -> SspecDocumentizationReport:
    val facts = extract_sspec_source_facts(report.source_path, source)
    var additions: [SspecDocumentizationFinding] = []
    for path in facts.lifecycle_paths:
        if not rt_file_exists(path):
            additions.push(make_sspec_finding(report.source_path,
                "SSDOC-MNT-009", 1, "lifecycle path does not exist: {path}",
                "Update the metadata to a current repository path.", 10))
    append_sspec_findings(report, additions)

fn _print_report(label: text, report: SspecDocumentizationReport):
    val s = report.score
    print "{label} SCORE {s.effective_aggregate} raw={s.raw_aggregate} blockers={s.blocker_count} nar={s.narrative} str={s.structure} ora={s.oracle} trc={s.traceability} evd={s.evidence} cov={s.coverage} mnt={s.maintainability} scenarios={report.scenario_count} steps={report.step_count} real_asserts={report.real_assertion_count} captures={report.capture_count} reqs={report.requirement_count} mirror={report.mirror_state}"
    for f in report.findings:
        print "  {f.rule_id} -{f.score_deduction} L{f.line}: {f.evidence}"

fn main() -> i64:
    val list = rt_file_read_text("@@WORK@@/paths.txt")
    var scored = 0
    for raw in list.split("\n"):
        val path = raw.trim()
        if path == "" or path.starts_with("#"):
            continue
        val source = rt_file_read_text(path)
        if source == "":
            print "UNREADABLE {path}"
            continue
        print "== {path}"
        _print_report("GATE", analyze_sspec_text(path, source))
        val mirror_path = derive_manual_path(path)
        val mirror_text = rt_file_read_text(mirror_path)
        var mirror: Option<text> = None
        if rt_file_exists(mirror_path):
            mirror = Some(mirror_text)
        var scan = analyze_sspec_pair_text(path, source, mirror)
        scan = inspect_sspec_lifecycle_links(scan, source)
        _print_report("SCAN", scan)
        scored = scored + 1
    print "SCORED {scored}"
    0
EOF
} > "$OUT"
# The heredocs above are quoted, so the work dir is baked in as @@WORK@@ and
# substituted here. It must be per-run: two concurrent runs sharing one dir
# clobber each other's paths.txt (measured 2026-09-05 — a lane scored three
# other lanes' specs and never touched its target).
sed "s|@@WORK@@|$work|g" "$OUT" > "$OUT.w" && mv "$OUT.w" "$OUT"
if grep -q "@@WORK@@" "$OUT"; then
  echo "ERROR — nothing was checked (work-dir placeholder survived substitution)"; exit 2
fi
# Named delta (a): every zero-arg `.split()` (whitespace split) in a `for x in
# <expr>.split():` or `val x = <expr>.split()` position becomes `_ws_split(<expr>)`.
sed -e 's|^\([[:space:]]*for [a-z_]* in \)\(.*\)\.split():[[:space:]]*$|\1_ws_split(\2):|' \
    -e 's|^\([[:space:]]*val [a-z_]* = \)\(.*\)\.split()[[:space:]]*$|\1_ws_split(\2)|' "$OUT" > "$OUT.tmp" \
  && mv "$OUT.tmp" "$OUT"
left=$(grep -c '\.split()' "$OUT")
if [ "$left" != 0 ]; then
  echo "ERROR — nothing was checked ($left zero-arg .split() call(s) survived the named-delta rewrite; extend the sed list)"; exit 2
fi

# ---- 4. run ------------------------------------------------------------------
log=$work/run.log
"$SEED" run "$OUT" > "$log" 2>&1
rc=$?
grep -E '^==|^GATE SCORE|^SCAN SCORE|^  SSDOC|^UNREADABLE|^error|^Runtime error' "$log"
scored=$(grep -E '^SCORED ' "$log" | tail -1 | awk '{print $2}')
if [ "$rc" != 0 ] || [ -z "$scored" ] || [ "$scored" = 0 ]; then
  echo "ERROR — nothing was checked (seed run rc=$rc, scored=${scored:-0}; see $log)"; exit 2
fi
echo "PASS — $scored spec(s) scored (GATE = test-runner gate surface, SCAN = sspec-maintain scan surface); log $log"
exit 0
