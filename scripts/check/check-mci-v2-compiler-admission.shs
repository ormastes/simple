#!/bin/sh
set -eu
LC_ALL=C; export LC_ALL
usage() { echo "usage: $0 --mode live|fixture --evidence DIR --run-id ID --compiler FILE --provenance FILE --provenance-signature FILE --trust-key FILE --parent-receipt FILE --parent-signature FILE --parent-trust-key FILE --captured-at-utc-ns NS --valid-until-utc-ns NS [--now-utc-ns NS]" >&2; exit 2; }
mode= evidence= run_id= compiler= provenance= signature= trust_key= parent= parent_signature= parent_key= captured= valid= now=
while [ "$#" -gt 0 ]; do
  [ "$#" -ge 2 ] || usage
  case "$1" in
    --mode) mode=$2;;
    --evidence) evidence=$2;;
    --run-id) run_id=$2;;
    --compiler) compiler=$2;;
    --provenance) provenance=$2;;
    --provenance-signature) signature=$2;;
    --trust-key) trust_key=$2;;
    --parent-receipt) parent=$2;;
    --parent-signature) parent_signature=$2;;
    --parent-trust-key) parent_key=$2;;
    --captured-at-utc-ns) captured=$2;;
    --valid-until-utc-ns) valid=$2;;
    --now-utc-ns) now=$2;;
    *) usage;;
  esac
  shift 2
done
case "$mode" in live|fixture) :;; *) usage;; esac
[ -n "$evidence" ] && [ -n "$run_id" ] && [ -n "$compiler" ] && [ -n "$provenance" ] && [ -n "$signature" ] && [ -n "$trust_key" ] && [ -n "$parent" ] && [ -n "$parent_signature" ] && [ -n "$parent_key" ] && [ -n "$captured" ] && [ -n "$valid" ] || usage
root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P); cd "$root"; policy=$root/scripts/check/policy/mci-v2-compiler-live-policy.env
fail() { echo "BLOCKED: $1" >&2; exit 2; }
hash_file() { sha256sum "$1" | awk '{print $1}'; }; hash_text() { sha256sum | awk '{print $1}'; }
hash_manifest_paths() {
  list=$1; manifest=$2; prefix=${3:-}
  raw=$manifest.raw
  xargs -r -n 128 sha256sum < "$list" > "$raw" || return 1
  awk -v prefix="$prefix" '{hash=$1; sub(/^[^ ]+  /, ""); path=$0; if (prefix != "" && index(path, prefix) == 1) path=substr(path, length(prefix)+1); print path "=" hash}' "$raw" > "$manifest" || return 1
  rm -f "$raw"
}
field() { k=$1 f=$2; [ "$(awk -F= -v k="$k" '$1==k{n++}END{print n+0}' "$f")" -eq 1 ] || return 1; sed -n "s/^$k=//p" "$f"; }
regular() { [ -f "$1" ] && [ ! -L "$1" ]; }
resolve() { case "$1" in /*) printf '%s\n' "$1";; *) printf '%s/%s\n' "$root" "$1";; esac; }
canonical_below_root() { p=$(resolve "$1"); [ ! -L "$p" ] && [ "$(readlink -f "$p")" = "$p" ] && case "$p" in "$root"/*) :;; *) return 1;; esac; }
snapshot() { src=$1 dst=$2; regular "$src" || return 1; before=$(stat -Lc '%d:%i:%s:%Y:%Z' "$src")/$(hash_file "$src"); run_child cp "$src" "$dst" || return 1; [ "$before" = "$(stat -Lc '%d:%i:%s:%Y:%Z' "$src")/$(hash_file "$src")" ] && [ "$(hash_file "$src")" = "$(hash_file "$dst")" ]; }
derive_live_source_manifest() {
  list=$1 manifest=$2
  git ls-files $(printf '%s' "$source_roots" | tr ':' ' ') | LC_ALL=C sort > "$list" || return 1
  [ -s "$list" ] || return 1
  hash_list=$list.files
  : > "$hash_list"
  while IFS= read -r f; do
    if [ -L "$root/$f" ]; then
      resolved=$(readlink -f "$root/$f") || return 1
      case "$resolved" in "$root"/*) :;; *) return 1;; esac
    else
      regular "$root/$f" || return 1
    fi
    if [ -f "$root/$f" ]; then printf '%s\n' "$root/$f" >> "$hash_list" || return 1; fi
  done < "$list"
  hash_manifest_paths "$hash_list" "$manifest" "$root/" || return 1
}
snapshot_source_entry() {
  src=$1 dst=$2
  if [ -L "$src" ]; then
    link=$(readlink "$src") || return 1
    resolved=$(readlink -f "$src") || return 1
    case "$resolved" in "$root"/*) :;; *) return 1;; esac
    run_child cp -P "$src" "$dst" || return 1
    [ -L "$src" ] && [ "$(readlink "$src")" = "$link" ] && [ -L "$dst" ] && [ "$(readlink "$dst")" = "$link" ]
  else
    snapshot "$src" "$dst"
  fi
}
snapshot_source_tree() {
  list=$1; dst=$2
  # The source manifest is already a hash-bound, validated list.  Copying each
  # file through snapshot_source_entry starts several processes and hashes the
  # whole tree repeatedly (12k+ files on the current source roots), which can
  # exceed the admission timeout before the compiler is even reached.  Rsync
  # performs one bounded process-group copy while preserving internal symlinks;
  # the manifest comparison immediately below retains the ABA/mutation gate.
  command -v rsync >/dev/null 2>&1 || return 1
  run_child rsync -a --files-from="$list" "$root/" "$dst/"
}
case "$run_id" in ''|*[!A-Za-z0-9._-]*) usage;; esac; case "$captured$valid${now:-0}" in *[!0-9]*) usage;; esac
[ -n "$now" ] || now=$(date -u +%s)000000000
awk -v a="$captured" -v n="$now" -v z="$valid" 'BEGIN{exit !(a<=n&&n<=z&&z-a<=86400000000000)}' || fail stale-or-invalid-lifetime
regular "$policy" || fail missing-live-policy
if [ "$mode" = live ] && [ "$(field provisioning_status "$policy")" != provisioned ]; then fail live-trust-policy-unprovisioned; fi
if [ "$mode" = live ] && [ -n "$(git status --porcelain --untracked-files=all -- src/compiler src/app src/lib)" ]; then fail dirty-or-untracked-build-inputs; fi
compiler=$(resolve "$compiler"); provenance=$(resolve "$provenance"); signature=$(resolve "$signature"); trust_key=$(resolve "$trust_key"); parent=$(resolve "$parent"); parent_signature=$(resolve "$parent_signature"); parent_key=$(resolve "$parent_key")
for f in "$compiler" "$provenance" "$signature" "$trust_key" "$parent" "$parent_signature" "$parent_key"; do canonical_below_root "$f" && regular "$f" || fail unsafe-input-path; done
[ -x "$compiler" ] || fail compiler-not-executable
case "$evidence" in /*) evidence_abs=$evidence;; *) evidence_abs=$root/$evidence;; esac; case "$evidence_abs" in "$root"/*) :;; *) fail evidence-outside-root;; esac
walk=$root; rel=${evidence_abs#"$root"/}; oldifs=$IFS; IFS=/; for c in $rel; do [ -n "$c" ] && [ "$c" != . ] && [ "$c" != .. ] || fail unsafe-evidence-component; walk=$walk/$c; [ ! -L "$walk" ] || fail symlink-evidence-ancestor; done; IFS=$oldifs
mkdir -p "$evidence_abs/artifacts" "$evidence_abs/receipts" "$root/build"; [ ! -e "$evidence_abs/artifacts/compiler.evidence" ] && [ ! -e "$evidence_abs/receipts/compiler.cross-host-comparison.unsigned.template" ] || fail evidence-collision
work=$(mktemp -d "$root/build/mci-compiler.XXXXXX")
active_child_pid=; active_child_group=
cleanup_work() {
  status=$?
  trap - EXIT HUP INT TERM
  child=$active_child_pid
  case "$child" in ''|*[!0-9]*|0) child=;; esac
  if [ -n "$child" ]; then
    if [ "$active_child_group" = yes ]; then
      kill -TERM -- "-$child" 2>/dev/null || true
    else
      kill -TERM "$child" 2>/dev/null || true
    fi
    ticks=0
    while [ "$ticks" -lt 20 ] && kill -0 "$child" 2>/dev/null; do
      sleep 0.1
      ticks=$((ticks + 1))
    done
    if kill -0 "$child" 2>/dev/null; then
      if [ "$active_child_group" = yes ]; then
        kill -KILL -- "-$child" 2>/dev/null || true
      else
        kill -KILL "$child" 2>/dev/null || true
      fi
    fi
    wait "$child" 2>/dev/null || true
  fi
  rm -rf "$work"
  exit "$status"
}
trap cleanup_work EXIT HUP INT TERM
run_child() {
  active_child_group=
  if command -v setsid >/dev/null 2>&1; then
    setsid "$@" &
    active_child_group=yes
  else
    "$@" &
  fi
  active_child_pid=$!
  wait "$active_child_pid"
  status=$?
  active_child_pid=; active_child_group=
  return "$status"
}
snapshot "$compiler" "$work/compiler" && snapshot "$provenance" "$work/provenance" && snapshot "$signature" "$work/signature" && snapshot "$trust_key" "$work/key" && snapshot "$parent" "$work/parent" && snapshot "$parent_signature" "$work/parent.sig" && snapshot "$parent_key" "$work/parent.key" || fail aba-or-input-mutation
chmod 500 "$work/compiler"; compiler_hash=$(hash_file "$work/compiler"); key_hash=$(hash_file "$work/key")
source_roots=$(field source_roots "$policy"); source_manifest=$work/source.manifest
fixture=$(field fixture_path "$policy"); expected=$(field fixture_stdout "$policy"); minimum=$(field minimum_emitted_function_count "$policy"); required_symbol=$(field required_symbol "$policy"); canonical_below_root "$fixture" && regular "$root/$fixture" || fail unsafe-fixed-fixture
snapshot "$root/$fixture" "$work/fixture.spl" || fail fixture-aba-or-mutation; fixture_hash=$(hash_file "$work/fixture.spl")
config_manifest=$work/config.manifest
{ echo policy_sha256=$(hash_file "$policy"); echo producer_sha256=$(hash_file "$root/scripts/check/check-mci-v2-compiler-admission.shs"); echo mode="$mode"; echo source_roots="$source_roots"; echo fixture_sha256="$fixture_hash"; echo fixture_stdout="$expected"; echo required_symbol="$required_symbol"; echo toolchain_identity="$(cc --version 2>/dev/null | head -1 | hash_text)"; echo dependency_manifest_sha256="$(hash_file "$work/parent")"; echo environment_identity_sha256="$(printf 'LC_ALL=C\nPATH=%s\n' "$PATH" | hash_text)"; } > "$config_manifest"; config_hash=$(hash_file "$config_manifest")
authority=$(field authority "$policy"); expected_key_id=$(field trusted_key_id "$policy"); expected_key_hash=$(field trusted_key_sha256 "$policy")
if [ "$mode" = fixture ]; then expected_key_id=contract-fixture-ephemeral; expected_key_hash=$key_hash; fi
# Reject malformed, replayed, or wrong-lineage inputs before the expensive
# source-tree snapshot.  Negative contract cases should exercise the policy,
# not pay the full 12k-file copy/hash cost.
[ "$(field provenance_schema "$work/provenance" 2>/dev/null || true)" = mci-compiler-provenance-v2 ] || fail invalid-provenance-schema
[ "$(field authority "$work/provenance" 2>/dev/null || true)" = "$authority" ] && [ "$(field lineage "$work/provenance" 2>/dev/null || true)" = pure-simple ] || fail non-pure-simple-lineage
[ "$(field trust_key_id "$work/provenance" 2>/dev/null || true)" = "$expected_key_id" ] && [ "$key_hash" = "$expected_key_hash" ] || fail unpinned-trust-key
[ "$(field compiler_sha256 "$work/provenance" 2>/dev/null || true)" = "$compiler_hash" ] && [ "$(field configuration_manifest_sha256 "$work/provenance" 2>/dev/null || true)" = "$config_hash" ] || fail stale-current-identity
[ "$(field fixture_sha256 "$work/provenance" 2>/dev/null || true)" = "$fixture_hash" ] || fail stale-fixture-identity
parent_hash=$(hash_file "$work/parent"); [ "$(field parent_receipt_sha256 "$work/provenance" 2>/dev/null || true)" = "$parent_hash" ] || fail invalid-parent-chain
[ "$(field receipt_schema "$work/parent" 2>/dev/null || true)" = mci-compiler-parent-receipt-v1 ] && [ "$(field lineage "$work/parent" 2>/dev/null || true)" = pure-simple ] && [ "$(field child_compiler_sha256 "$work/parent" 2>/dev/null || true)" = "$compiler_hash" ] || fail unauthenticated-parent-chain
parent_key_hash=$(hash_file "$work/parent.key"); [ "$(field signing_algorithm "$work/parent" 2>/dev/null || true)" = ed25519 ] && [ "$(field trust_key_sha256 "$work/parent" 2>/dev/null || true)" = "$parent_key_hash" ] || fail invalid-parent-trust
openssl pkeyutl -verify -rawin -pubin -inkey "$work/parent.key" -sigfile "$work/parent.sig" -in "$work/parent" >/dev/null 2>&1 || fail invalid-parent-signature
openssl pkeyutl -verify -rawin -pubin -inkey "$work/key" -sigfile "$work/signature" -in "$work/provenance" >/dev/null 2>&1 || fail invalid-signature
derive_live_source_manifest "$work/source.files.before" "$work/source.live.before" || fail source-manifest-derivation-failed
mkdir -p "$work/source"
: > "$source_manifest"
snapshot_source_tree "$work/source.files.before" "$work/source" || fail source-aba-or-input-mutation
copied_hash_list=$work/source.files.copied
: > "$copied_hash_list"
while IFS= read -r f; do
  if [ -f "$work/source/$f" ]; then printf '%s\n' "$work/source/$f" >> "$copied_hash_list"; fi
done < "$work/source.files.before"
hash_manifest_paths "$copied_hash_list" "$source_manifest" "$work/source/" || fail source-copy-hash-failed
cmp -s "$work/source.live.before" "$source_manifest" || fail source-snapshot-mismatch
derive_live_source_manifest "$work/source.files.after" "$work/source.live.after" || fail source-manifest-revalidation-failed
cmp -s "$work/source.files.before" "$work/source.files.after" && cmp -s "$source_manifest" "$work/source.live.after" || fail source-mutated-during-snapshot
source_hash=$(hash_file "$source_manifest")
[ "$(field compiler_source_manifest_sha256 "$work/provenance" 2>/dev/null || true)" = "$source_hash" ] && [ "$(field source_manifest_sha256 "$work/parent" 2>/dev/null || true)" = "$source_hash" ] || fail stale-current-identity
run_isolated_build() {
  label=$1; build_root=$work/build-$label; mkdir -p "$build_root"
  cp -a "$work/source" "$build_root/source"
  cp "$config_manifest" "$build_root/config.manifest"
  cmp -s "$source_manifest" "$build_root/source.manifest" 2>/dev/null || cp "$source_manifest" "$build_root/source.manifest"
  [ "$(hash_file "$build_root/source.manifest")" = "$source_hash" ] && [ "$(hash_file "$build_root/config.manifest")" = "$config_hash" ] || fail isolated-input-identity-mismatch
  emitted=$build_root/emitted
  run_child timeout 180 env SIMPLE_LIB="$build_root/source/src" "$work/compiler" native-build --source "$build_root/source/src/compiler" --source "$build_root/source/src/app" --source "$build_root/source/src/lib" --entry-closure --entry "$work/fixture.spl" --strip --output "$emitted" >"$build_root/compile.log" 2>&1 || fail compile-failed-$label
  regular "$emitted" && [ -x "$emitted" ] || fail non-executable-artifact-$label
  readelf -h "$emitted" | grep -q 'Type:.*EXEC\|Type:.*DYN' || fail emitted-format-not-elf-$label
  functions=$(nm "$emitted" 2>/dev/null | awk '$2 ~ /^[Tt]$/ {n++} END{print n+0}'); [ "$functions" -ge "$minimum" ] || fail missing-function-evidence-$label
  nm "$emitted" 2>/dev/null | awk -v wanted="$required_symbol" '$2 ~ /^[Tt]$/ && index($3,wanted){found=1} END{exit !found}' || fail required-symbol-missing-$label
  run_child timeout 30 "$emitted" >"$build_root/run.log" 2>&1 || fail emitted-execution-failed-$label
  [ "$(tr -d '\r\n' <"$build_root/run.log")" = "$expected" ] || fail fixed-oracle-mismatch-$label
}
run_isolated_build a; run_isolated_build b
emitted_a=$work/build-a/emitted; emitted_b=$work/build-b/emitted
artifact_hash_a=$(hash_file "$emitted_a"); artifact_hash_b=$(hash_file "$emitted_b")
[ "$artifact_hash_a" = "$artifact_hash_b" ] || fail nondeterministic-isolated-artifacts
[ "$(hash_file "$work/build-a/run.log")" = "$(hash_file "$work/build-b/run.log")" ] || fail nondeterministic-fixture-captures
cp "$emitted_a" "$work/corrupt.emitted"; printf '\001' >> "$work/corrupt.emitted"
corrupt_hash=$(hash_file "$work/corrupt.emitted"); [ "$corrupt_hash" != "$artifact_hash_a" ] || fail corruption-negative-not-detected

comparison=$evidence_abs/receipts/compiler.cross-host-comparison.unsigned.template
{ echo receipt_schema=mci-compiler-cross-host-comparison-v1; echo run_id="$run_id"; echo source_hash="$source_hash"; echo config_hash="$config_hash"; echo fixture_sha256="$fixture_hash"; echo local_build_a_artifact_hash="$artifact_hash_a"; echo local_build_b_artifact_hash="$artifact_hash_b"; echo local_fixture_capture_hash=$(hash_file "$work/build-a/run.log"); echo corruption_candidate_hash="$corrupt_hash"; echo corruption_rejected=true; echo peer_host_identity_sha256=REQUIRED; echo peer_environment_manifest_sha256=REQUIRED; echo peer_artifact_hash=REQUIRED; echo peer_fixture_capture_hash=REQUIRED; echo peer_receipt_sha256=REQUIRED; echo peer_signature_sha256=REQUIRED; echo cross_host_status=BLOCKED_PENDING_INDEPENDENT_SIGNED_PEER; echo release_candidate=false; } > "$comparison"
artifact=$evidence_abs/artifacts/compiler.evidence; { echo schema_version=mci-compiler-collector-receipt-v2; echo run_id="$run_id"; echo source_hash="$source_hash"; echo config_hash="$config_hash"; echo fixture_sha256="$fixture_hash"; echo compiler_executable_hash="$compiler_hash"; echo parent_receipt_hash="$parent_hash"; echo parent_signature_sha256=$(hash_file "$work/parent.sig"); echo emitted_artifact_hash="$artifact_hash_a"; echo isolated_build_a_artifact_hash="$artifact_hash_a"; echo isolated_build_b_artifact_hash="$artifact_hash_b"; echo corruption_candidate_hash="$corrupt_hash"; echo corruption_rejected=true; echo emitted_function_count="$functions"; echo required_symbol="$required_symbol"; echo fixture_capture_hash=$(hash_file "$work/build-a/run.log"); echo contract_scenarios=MCI-COMP-001,MCI-COMP-002,MCI-COMP-003,MCI-NFR-003,MCI-NFR-004; echo blocked_scenarios=MCI-COMP-002,MCI-COMP-003,MCI-NFR-003,MCI-NFR-004; echo cross_host_comparison_status=BLOCKED_PENDING_INDEPENDENT_SIGNED_PEER; echo aggregate_lane_status=blocked-no-cross-host-evidence; echo result=$(if [ "$mode" = fixture ]; then echo CONTRACT_ONLY; else echo BLOCKED; fi); echo release_candidate=false; } > "$artifact"
if [ "$mode" = fixture ]; then echo 'CONTRACT_ONLY: isolated reproducibility and corruption controls passed; cross-host comparison remains BLOCKED'; exit 0; fi
echo 'BLOCKED: local compiler controls passed, but independent signed cross-host evidence is absent' >&2; exit 2
