#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

BUILD_DIR="${BUILD_DIR:-build/tmp/macos_metal_2d_live_evidence}"
REPORT_PATH="${REPORT_PATH:-doc/09_report/macos_metal_2d_live_evidence_$(date -u +%F).md}"
SAMPLE="${MACOS_METAL_2D_SAMPLE:-examples/06_io/ui/graphics_2d_showcase_gui.spl}"
TIMEOUT_SECS="${MACOS_METAL_2D_TIMEOUT_SECS:-90}"
REQUESTED_RESOLUTION="${SHOWCASE_RESOLUTION:-320x240}"
REQUESTED_DPI="${SHOWCASE_DPI:-96}"
case "$REQUESTED_RESOLUTION" in
    4k|4K) EXPECTED_DIMENSIONS="3840x2160" ;;
    8k|8K) EXPECTED_DIMENSIONS="7680x4320" ;;
    *) EXPECTED_DIMENSIONS="$REQUESTED_RESOLUTION" ;;
esac
EVENTS="$BUILD_DIR/events.env"
VALIDATED_EVENTS="$BUILD_DIR/events.validated.env"
LAUNCHER_LOG="$BUILD_DIR/launcher.log"
WINDOW_ENV="$BUILD_DIR/window.env"
BEFORE_PNG="$BUILD_DIR/before.png"
AFTER_PNG="$BUILD_DIR/after.png"
EVIDENCE_ENV="$BUILD_DIR/evidence.env"

mkdir -p "$BUILD_DIR" "$(dirname -- "$REPORT_PATH")"
rm -f "$EVENTS" "$VALIDATED_EVENTS" "$LAUNCHER_LOG" "$WINDOW_ENV" "$BEFORE_PNG" "$AFTER_PNG" "$EVIDENCE_ENV"

app_pid=""
cleanup() {
    [ -n "$app_pid" ] || return 0
    osascript - "$app_pid" >/dev/null 2>&1 <<'OSA' || true
on run argv
  set targetPid to (item 1 of argv) as integer
  tell application "System Events"
    set matches to (processes whose unix id is targetPid)
    if (count of matches) > 0 then
      tell item 1 of matches
        set frontmost to true
        keystroke "q"
      end tell
    end if
  end tell
end run
OSA
}
trap cleanup EXIT HUP INT TERM

absolute_path() {
    case "$1" in
        /*) printf '%s\n' "$1" ;;
        *) printf '%s/%s\n' "$ROOT_DIR" "$1" ;;
    esac
}

value_of() {
    if [ -f "$2" ]; then
        sed -n "s/^${1}=//p" "$2" | tail -n 1
    fi
}

file_bytes() {
    if [ -f "$1" ]; then wc -c <"$1" | tr -d ' '; else echo 0; fi
}

file_cksum() {
    if [ -f "$1" ]; then cksum "$1" | awk '{print $1}'; else echo 0; fi
}

write_report() {
    {
        echo "# macOS Metal 2D Live Evidence"
        echo
        echo '```text'
        [ ! -f "$EVIDENCE_ENV" ] || cat "$EVIDENCE_ENV"
        echo '```'
        echo
        echo "- Before interaction: \`$BEFORE_PNG\`"
        echo "- After interaction: \`$AFTER_PNG\`"
        echo "- Event receipt: \`$VALIDATED_EVENTS\`"
        echo "- Launcher log: \`$LAUNCHER_LOG\`"
    } >"$REPORT_PATH"
}

fail() {
    reason="$1"
    {
        echo "macos_metal_2d_live_status=fail"
        echo "macos_metal_2d_live_reason=$reason"
    } >"$EVIDENCE_ENV"
    write_report
    echo "macOS Metal 2D live evidence: FAIL ($reason)" >&2
    exit 1
}

[ "$(uname -s)" = "Darwin" ] || fail "requires-macos"
[ -f "$SAMPLE" ] || fail "sample-missing"
command -v osascript >/dev/null 2>&1 || fail "osascript-missing"
command -v screencapture >/dev/null 2>&1 || fail "screencapture-missing"
command -v cliclick >/dev/null 2>&1 || fail "cliclick-missing"

SIMPLE_GUI_RUN_SKIP_NUDGE=1 \
SIMPLE_GUI_BACKEND=metal \
SIMPLE_GUI_EXIT_AFTER_INTERACTION=0 \
SIMPLE_GUI_EVENT_EVIDENCE_PATH="$(absolute_path "$EVENTS")" \
SHOWCASE_RESOLUTION="$REQUESTED_RESOLUTION" \
SHOWCASE_DPI="$REQUESTED_DPI" \
    scripts/gui/macos-gui-run.shs "$SAMPLE" >"$LAUNCHER_LOG" 2>&1 ||
    fail "launcher-failed"

deadline=$(($(date +%s) + TIMEOUT_SECS))
while [ "$(date +%s)" -lt "$deadline" ]; do
    if osascript >"$WINDOW_ENV" 2>/dev/null <<'OSA'; then
tell application "SimpleGui" to activate
tell application "System Events"
  set selectedProc to missing value
  set selectedPid to 0
  repeat with proc in (processes whose name is "SimpleGui")
    if (count of windows of proc) > 0 and (unix id of proc) > selectedPid then
      set selectedProc to proc
      set selectedPid to unix id of proc
    end if
  end repeat
  if selectedProc is missing value then error "SimpleGui window not ready"
  tell selectedProc
    set position of window 1 to {200, 120}
    set frontmost to true
    delay 0.3
    set p to position of window 1
    set s to size of window 1
    set AppleScript's text item delimiters to ","
    return (selectedPid as text) & "," & (item 1 of p as text) & "," & (item 2 of p as text) & "," & (item 1 of s as text) & "," & (item 2 of s as text)
  end tell
end tell
OSA
        break
    fi
    sleep 1
done
[ -s "$WINDOW_ENV" ] || fail "window-not-found"

window_record="$(tr -d '\r\n ' <"$WINDOW_ENV")"
case "$window_record" in *,*,*,*,*) ;; *) fail "invalid-window-rect" ;; esac
old_ifs=$IFS
IFS=,
set -- $window_record
IFS=$old_ifs
app_pid="${1:-}"
window_x="${2:-0}"
window_y="${3:-0}"
window_w="${4:-0}"
window_h="${5:-0}"
case "$app_pid" in ""|*[!0-9]*) fail "invalid-window-pid" ;; esac
window_rect="$window_x,$window_y,$window_w,$window_h"
screencapture -x -R"$window_rect" "$BEFORE_PNG" || fail "before-capture-failed"

click_x=$((window_x + 150))
click_y=$((window_y + 140))
cliclick "m:${click_x},${click_y}" "c:."
osascript - "$app_pid" >/dev/null <<'OSA' || fail "keyboard-injection-failed"
on run argv
set targetPid to (item 1 of argv) as integer
tell application "System Events"
  repeat with proc in (processes whose unix id is targetPid)
    tell proc
      set frontmost to true
      keystroke "g"
      return true
    end tell
  end repeat
end tell
error "SimpleGui input target missing"
end run
OSA

event_deadline=$(($(date +%s) + 15))
keyboard=0
pointer=0
clicks=0
revision=0
while [ "$(date +%s)" -lt "$event_deadline" ]; do
    keyboard="$(value_of graphics_2d_event_keyboard_events "$EVENTS")"
    pointer="$(value_of graphics_2d_event_pointer_events "$EVENTS")"
    clicks="$(value_of graphics_2d_event_click_events "$EVENTS")"
    revision="$(value_of graphics_2d_event_interaction_revision "$EVENTS")"
    keyboard="${keyboard:-0}"
    pointer="${pointer:-0}"
    clicks="${clicks:-0}"
    revision="${revision:-0}"
    if [ "$keyboard" -gt 0 ] && [ "$pointer" -gt 0 ] &&
            [ "$clicks" -gt 0 ] && [ "$revision" -gt 0 ]; then
        break
    fi
    sleep 1
done

[ "$keyboard" -gt 0 ] || fail "keyboard-event-missing"
[ "$pointer" -gt 0 ] || fail "pointer-event-missing"
[ "$clicks" -gt 0 ] || fail "click-event-missing"

event_backend="$(value_of graphics_2d_event_backend "$EVENTS")"
source="$(value_of graphics_2d_event_source "$EVENTS")"
handle="$(value_of graphics_2d_event_backend_handle "$EVENTS")"
initial_checksum="$(value_of graphics_2d_event_initial_checksum "$EVENTS")"
interaction_checksum="$(value_of graphics_2d_event_interaction_checksum "$EVENTS")"
[ "$event_backend" = "metal" ] || fail "event-backend-mismatch"
[ "$source" = "device_readback" ] || fail "device-readback-missing"
[ "${handle:-0}" -gt 0 ] || fail "backend-handle-missing"
[ "${initial_checksum:-0}" -gt 0 ] || fail "initial-checksum-missing"
[ "${interaction_checksum:-0}" -gt 0 ] || fail "interaction-checksum-missing"
[ "$initial_checksum" != "$interaction_checksum" ] || fail "interaction-frame-unchanged"

osascript - "$app_pid" >/dev/null <<'OSA' || fail "post-input-window-missing"
on run argv
set targetPid to (item 1 of argv) as integer
tell application "System Events"
  repeat with proc in (processes whose unix id is targetPid)
    tell proc
      set position of window 1 to {200, 120}
      set frontmost to true
      return true
    end tell
  end repeat
end tell
error "SimpleGui post-input window missing"
end run
OSA
sleep 1
