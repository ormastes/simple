#!/bin/sh
# Explicit bootstrap regression: caller supplies an admitted rebuilt producer
# and its runtime capsule; never select a seed or a fallback compiler here.
set -eu
[ "$#" -eq 2 ] || { echo 'usage: check-native-captured-record-callback.shs COMPILER OUTPUT_DIR' >&2; exit 2; }
compiler=$1
output_dir=$2
[ -x "$compiler" ] || { echo 'compiler must be executable' >&2; exit 2; }
mkdir -p "$output_dir"
source=test/02_integration/compiler/backend/probe_struct_field_fn_call.spl
sha256sum "$compiler" "$source" > "$output_dir/inputs.sha256"
"$compiler" native-build "$source" --backend=cranelift --mode=one-binary \
    --threads 1 --cache-dir "$output_dir/cache" -o "$output_dir/probe" \
    > "$output_dir/compile.log" 2>&1
"$output_dir/probe" > "$output_dir/actual.txt" 2> "$output_dir/stderr.txt"
cat > "$output_dir/expected.txt" <<'EXPECTED'
opfn_a 11
opfn_b 12
tagfn port
loop_callback 20
EXPECTED
cmp "$output_dir/expected.txt" "$output_dir/actual.txt"
test ! -s "$output_dir/stderr.txt"
sha256sum "$output_dir/probe" > "$output_dir/artifact.sha256"
echo 'native_captured_record_callback=PASS'
