#!/bin/sh
# Exact + adjacent regression for the Stage-4 generated-facade hint scanner.
#
# Verdict convention (repo guard standard):
#   PASS — 5 hint-scanner check(s) checked ...   (exit 0)
#   FAIL — <what broke>                          (exit 1)
#   ERROR — nothing was checked (<reason>)       (exit 2)
set -u

root=${MODULE_SURFACE_HINT_ROOT:-.}
source_file="$root/src/compiler/20.hir/hir_lowering/module_surface_declarations.spl"
[ -f "$source_file" ] || { echo "ERROR — nothing was checked (missing $source_file)"; exit 2; }

body=$(awk '
  /^fn module_surface_export_origin_hints\(/ { inside=1 }
  inside && /^fn / && !/^fn module_surface_export_origin_hints\(/ { exit }
  inside { print }
' "$source_file")

guard_line=$(printf '%s\n' "$body" | grep -nF 'if not source.content.contains("# Re-exported from "):' | cut -d: -f1)
return_line=$(printf '%s\n' "$body" | grep -nF 'return Ok(true)' | head -1 | cut -d: -f1)
split_line=$(printf '%s\n' "$body" | grep -nF 'source.content.split("\n")' | cut -d: -f1)

checked=0

[ -n "$guard_line" ] || { echo "FAIL — hint scanner lost its exact marker guard (# Re-exported from )"; exit 1; }
[ -n "$return_line" ] || { echo "FAIL — hint scanner lost its empty fast-path return Ok(true)"; exit 1; }
[ -n "$split_line" ] || { echo "FAIL — hint scanner lost its facade line split scan"; exit 1; }
checked=$((checked + 1))
[ "$guard_line" -lt "$return_line" ] && [ "$return_line" -lt "$split_line" ] || {
  echo "FAIL — source split precedes the exact-marker fast path (guard=$guard_line return=$return_line split=$split_line)"
  exit 1
}
checked=$((checked + 1))

# Adjacent marker-like comments must not widen admission. The implementation
# must test the generator's complete prefix, including "from" and its space.
if printf '%s\n' "$body" | grep -F 'source.content.contains("# Re-exported")' >/dev/null; then
  echo "FAIL — hint scanner marker guard widened to the overbroad '# Re-exported' prefix"
  exit 1
fi
checked=$((checked + 1))

all_files=$(find "$root/src/compiler" "$root/src/app" "$root/src/lib" "$root/examples/10_tooling" \
  -type f -name '*.spl' | wc -l)
marked_files=$(grep -rl --include='*.spl' '# Re-exported from ' \
  "$root/src/compiler" "$root/src/app" "$root/src/lib" "$root/examples/10_tooling" | wc -l)
[ "$marked_files" -gt 0 ] || { echo "ERROR — nothing was checked (no generated facade fixture marked in corpus)"; exit 2; }
[ "$all_files" -gt "$marked_files" ] || { echo "ERROR — nothing was checked (no unmarked fast-path corpus to compare against)"; exit 2; }
checked=$((checked + 2))

echo "PASS — $checked hint-scanner check(s) checked, all_files=$all_files marked_files=$marked_files avoided_files=$((all_files - marked_files))"
exit 0
