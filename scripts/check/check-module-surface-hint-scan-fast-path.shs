#!/bin/sh
# Exact + adjacent regression for the Stage-4 generated-facade hint scanner.
set -eu

root=${MODULE_SURFACE_HINT_ROOT:-.}
source_file="$root/src/compiler/20.hir/hir_lowering/module_surface.spl"
[ -f "$source_file" ] || { echo "error=missing_module_surface_source"; exit 1; }

body=$(awk '
  /^fn module_surface_export_origin_hints\(/ { inside=1 }
  inside && /^fn / && !/^fn module_surface_export_origin_hints\(/ { exit }
  inside { print }
' "$source_file")

guard_line=$(printf '%s\n' "$body" | grep -nF 'if not source.content.contains("# Re-exported from "):' | cut -d: -f1)
return_line=$(printf '%s\n' "$body" | grep -nF 'return origins' | head -1 | cut -d: -f1)
split_line=$(printf '%s\n' "$body" | grep -nF 'source.content.split("\n")' | cut -d: -f1)

[ -n "$guard_line" ] || { echo "error=missing_exact_marker_guard"; exit 1; }
[ -n "$return_line" ] || { echo "error=missing_empty_fast_return"; exit 1; }
[ -n "$split_line" ] || { echo "error=missing_facade_line_scan"; exit 1; }
[ "$guard_line" -lt "$return_line" ] && [ "$return_line" -lt "$split_line" ] || {
  echo "error=source_split_precedes_fast_path"
  exit 1
}

# Adjacent marker-like comments must not widen admission. The implementation
# must test the generator's complete prefix, including "from" and its space.
if printf '%s\n' "$body" | grep -F 'source.content.contains("# Re-exported")' >/dev/null; then
  echo "error=overbroad_marker_guard"
  exit 1
fi

all_files=$(find "$root/src/compiler" "$root/src/app" "$root/src/lib" "$root/examples/10_tooling" \
  -type f -name '*.spl' | wc -l)
marked_files=$(grep -rl --include='*.spl' '# Re-exported from ' \
  "$root/src/compiler" "$root/src/app" "$root/src/lib" "$root/examples/10_tooling" | wc -l)
[ "$marked_files" -gt 0 ] || { echo "error=no_generated_facade_fixture"; exit 1; }
[ "$all_files" -gt "$marked_files" ] || { echo "error=no_unmarked_fast_path_corpus"; exit 1; }

echo "STATUS: PASS module-surface-hint-scan-fast-path all_files=$all_files marked_files=$marked_files avoided_files=$((all_files - marked_files))"
