#!/bin/sh
# Fail-closed validator for an emitted X25519MLKEM768 coverage receipt.
# It consumes instrumented artifacts only; it never creates counters or turns
# a symbolic inventory into a measurement result.

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
receipt=${1:-build/evidence/x25519mlkem768/coverage/branch_coverage.receipt.env}

fail() {
    echo "STATUS: FAIL X25519MLKEM768 branch coverage receipt: $1"
    exit 1
}

case "$receipt" in
    ''|/*|../*|*'/../'*|*'//'*) fail "unsafe receipt path" ;;
esac
receipt_path="$root/$receipt"
[ -f "$receipt_path" ] || fail "receipt absent: $receipt"

sha256_file() {
    sha256sum "$1" | awk '{print $1}'
}

value() {
    key=$1
    count=$(grep -c "^$key=" "$receipt_path" || true)
    [ "$count" = 1 ] || fail "missing or duplicate field: $key"
    sed -n "s/^$key=//p" "$receipt_path"
}

require_value() {
    key=$1
    expected=$2
    actual=$(value "$key")
    [ "$actual" = "$expected" ] || fail "$key=$actual (expected $expected)"
}

require_hex64() {
    actual=$(value "$1")
    printf '%s\n' "$actual" | grep -Eq '^[0-9a-f]{64}$' ||
        fail "invalid SHA-256 field: $1"
}

require_artifact_hash() {
    path_key=$1
    hash_key=$2
    rel=$(value "$path_key")
    case "$rel" in
        ''|/*|../*|*'/../'*|*'//'*) fail "unsafe artifact path: $path_key" ;;
    esac
    path="$root/$rel"
    [ -f "$path" ] || fail "artifact absent: $rel"
    expected=$(value "$hash_key")
    actual=$(sha256_file "$path")
    [ "$actual" = "$expected" ] || fail "artifact digest mismatch: $rel"
}

require_value schema_version x25519mlkem768-branch-coverage-v2
require_value feature x25519mlkem768
require_value measurement_status measured
require_value measurement_kind instrumented-decision-counters
require_value decision_counter_unit condition-outcome
require_value instrumentation_active true
require_value static_analysis false
require_value fallback_used false
require_value promotion_basis measured-decision-coverage
require_value promotion_status eligible
require_value status pass
require_value critical_branch_gate measured-condition-outcomes
require_value critical_branch_status pass
require_value owner_count 30
require_value critical_branch_outcome_total 346
require_value critical_branch_outcome_covered 346
require_value critical_branch_missing_outcomes 0

coverage_bp=$(value branch_coverage_basis_points)
case "$coverage_bp" in ''|*[!0-9]*) fail "invalid coverage basis points" ;; esac
[ "$coverage_bp" -ge 9800 ] || fail "coverage below 9800 basis points"

for key in raw_coverage_sha256 zero_count_inventory_sha256 \
        critical_branch_inventory_sha256 critical_symbolic_sha256 \
        source_manifest_sha256 spec_manifest_sha256 compiler_artifact_sha256 \
        compiler_provenance_sha256 compiler_source_revision \
        compiler_version_sha256 runtime_artifact_sha256 runner_sha256; do
    require_hex64 "$key"
done

for pair in \
        'raw_coverage_path raw_coverage_sha256' \
        'zero_count_inventory_path zero_count_inventory_sha256' \
        'critical_branch_inventory_path critical_branch_inventory_sha256' \
        'critical_symbolic_path critical_symbolic_sha256' \
        'source_manifest_path source_manifest_sha256' \
        'spec_manifest_path spec_manifest_sha256' \
        'compiler_artifact_path compiler_artifact_sha256' \
        'compiler_provenance_path compiler_provenance_sha256' \
        'compiler_version_path compiler_version_sha256' \
        'runtime_artifact_path runtime_artifact_sha256'; do
    set -- $pair
    require_artifact_hash "$1" "$2"
done

raw="$root/$(value raw_coverage_path)"
grep -qx 'version: 1.0' "$raw" || fail "raw coverage version missing"
grep -qx 'coverage_extension: decision-condition-v1' "$raw" || fail "raw coverage extension missing"
grep -qx 'conditions |decision_id, condition_id, file, line, column, true_count, false_count|' "$raw" || fail "raw coverage condition counters missing"

echo "branch_coverage_basis_points=$coverage_bp"
echo "STATUS: PASS X25519MLKEM768 measured branch coverage receipt"
