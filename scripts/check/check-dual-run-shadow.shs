#!/bin/sh
# check-dual-run-shadow.shs — fail-closed gate for the C/Simple dual-run
# contract (design doc/05_design/os/hal/asm_embedded_hal_and_dual_run.md §B.7;
# plan doc/03_plan/os/hal/asm_to_simple_migration_plan.md item 1.9).
#
# Pairs are ENUMERATED FROM ANNOTATIONS, never hard-coded: every spec under
# test/ carrying one or more lines of the form
#     # @dual_pair: <name> mode=<mode> ref=<C symbol> cand=<Simple fn> [id=<C-MIG id>]
# is a pair spec. The gate runs each pair spec with a private run id and
# ledger (DUAL_RUN_ID / DUAL_RUN_LEDGER), then reads the ledger rows for THAT
# run: any row with mismatches > 0 is a FAIL naming the pair and its
# first_mismatch_repr. Pairs still on the legacy return-compare helper
# (mode=value-legacy) contribute cases through the spec's Results line only.
# The registry (doc/08_tracking/c_migration/c_migration_inventory.sdn
# `dual_run_mode:` rows) is cross-reported so a registered pair with no
# annotation is visible.
#
# CONVENTION (matches sibling scripts/check/*.shs gates):
#   verdict is the LAST line of stdout:
#     PASS  — <n> pair(s) checked, <m> case(s), 0 divergent   exit 0
#     FAIL  — ...                                              exit 1
#     ERROR — nothing was checked                              exit 2
#   0 annotated pairs is ERROR, never a pass. `--selftest` runs before every
#   scan and is fatal.
#
# The `simple test` exit status is read into a variable on the line right
# after the invocation, never through a pipe — a pipeline's $? is the last
# stage's status, which has produced false greens in this repo before.

set -u

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
SIMPLE_BIN_DEFAULT="bin/simple"
TEST_ROOT_DEFAULT="test"
REGISTRY_DEFAULT="doc/08_tracking/c_migration/c_migration_inventory.sdn"
LEDGER_DEFAULT="build/dual_run/dual_run_ledger.sdn"

usage() {
    echo "usage: $0 [--test-root DIR] [--registry PATH] [--ledger PATH] [--simple-bin PATH] [--selftest-only]"
}

# ---------------------------------------------------------------------------
# enumerate_pairs <test_root>
#   Prints one "<spec>\t<pair>\t<mode>" per annotation. Uses /usr/bin/grep
#   (exhaustive; the wrapped ugrep honours .gitignore).
# ---------------------------------------------------------------------------
enumerate_pairs() {
    ep_root=$1
    [ -d "$ep_root" ] || return 0
    /usr/bin/grep -rn --include='*_spec.spl' -E '^# @dual_pair: ' "$ep_root" 2>/dev/null \
        | sed -n 's/^\([^:]*\):[0-9]*:# @dual_pair: \([^ ]*\) *mode=\([^ ]*\).*/\1\t\2\t\3/p'
}

# ---------------------------------------------------------------------------
# registry_modes <registry>
#   Prints one "<id>\t<mode>" per `dual_run_mode:` row.
# ---------------------------------------------------------------------------
registry_modes() {
    rm_path=$1
    [ -f "$rm_path" ] || return 0
    awk '/^  - id: /{id=$3} /^    dual_run_mode: /{print id "\t" $2}' "$rm_path"
}

# ---------------------------------------------------------------------------
# run_spec_stub <stub_bin> <spec>
#   Echoes: "<rc> <total> <passed> <failed>" (numbers 0 when unparsed).
# ---------------------------------------------------------------------------
run_spec_stub() {
    rs_bin=$1
    rs_spec=$2
    rs_out=$(mktemp)

    "$rs_bin" test "$rs_spec" >"$rs_out" 2>&1
    rs_rc=$?

    rs_line=$(grep -a '^Results:' "$rs_out" | tail -1)
    rs_total=$(echo "$rs_line" | sed -n 's/^Results: \([0-9]*\) total.*/\1/p')
    rs_passed=$(echo "$rs_line" | sed -n 's/.*, \([0-9]*\) passed.*/\1/p')
    rs_failed=$(echo "$rs_line" | sed -n 's/.*, \([0-9]*\) failed.*/\1/p')
    [ -z "$rs_total" ] && rs_total=0
    [ -z "$rs_passed" ] && rs_passed=0
    [ -z "$rs_failed" ] && rs_failed=0

    rm -f "$rs_out"
    echo "$rs_rc $rs_total $rs_passed $rs_failed"
}

# ---------------------------------------------------------------------------
# ledger_rows <ledger> <run_id>
#   Prints one "<pair>\t<mode>\t<cases>\t<mismatches>\t<first_mismatch_repr>"
#   per row whose run_id matches. Line-based on purpose (see
#   src/lib/nogc_sync_mut/rt_hal/dual_run_ledger.spl).
# ---------------------------------------------------------------------------
ledger_rows() {
    lr_path=$1
    lr_run=$2
    [ -f "$lr_path" ] || return 0
    awk -v run="$lr_run" '
        function flush() { if (pair != "" && rid == run) printf "%s\t%s\t%s\t%s\t%s\n", pair, mode, cases, mism, repr }
        /^  - pair: /            { flush(); pair=$3; mode=""; rid=""; cases=0; mism=0; repr="" }
        /^    mode: /            { mode=$2 }
        /^    run_id: /          { rid=$2 }
        /^    cases: /           { cases=$2 }
        /^    mismatches: /      { mism=$2 }
        /^    first_mismatch_repr: / { sub(/^    first_mismatch_repr: /, ""); repr=$0 }
        END { flush() }
    ' "$lr_path"
}

# ---------------------------------------------------------------------------
# Self-test. Fatal — a gate that cannot prove it bites is not evidence.
# Stub `simple` binaries + fixture trees so the self-test costs milliseconds.
# ---------------------------------------------------------------------------
selftest() {
    st_dir=$(mktemp -d)
    st_fail=0
    st_n=0

    # (a) healthy agreeing run -> PASS-shaped
    cat >"$st_dir/healthy" <<'STUB'
#!/bin/sh
echo "Results: 8 total, 8 passed, 0 failed"
exit 0
STUB
    chmod +x "$st_dir/healthy"
    echo 'describe "x":' >"$st_dir/spec.spl"
    st_r=$(run_spec_stub "$st_dir/healthy" "$st_dir/spec.spl")
    st_failed=$(echo "$st_r" | cut -d' ' -f4)
    st_total=$(echo "$st_r" | cut -d' ' -f2)
    st_n=$((st_n + 1))
    if [ "$st_failed" != "0" ] || [ "$st_total" -le 0 ]; then
        echo "selftest: FAILED — healthy fixture not read as clean-pass-shaped"
        st_fail=1
    fi

    # (b) divergent spec (a real failure) -> failed>0
    cat >"$st_dir/divergent" <<'STUB'
#!/bin/sh
echo "Results: 8 total, 7 passed, 1 failed"
exit 1
STUB
    chmod +x "$st_dir/divergent"
    st_r=$(run_spec_stub "$st_dir/divergent" "$st_dir/spec.spl")
    st_failed=$(echo "$st_r" | cut -d' ' -f4)
    st_n=$((st_n + 1))
    if [ "$st_failed" -le 0 ]; then
        echo "selftest: FAILED — divergent fixture was not caught as a failure"
        st_fail=1
    fi

    # (c) vacuous run (no Results line) -> total==0 so the caller must ERROR
    cat >"$st_dir/vacuous" <<'STUB'
#!/bin/sh
echo "no test summary printed"
exit 0
STUB
    chmod +x "$st_dir/vacuous"
    st_r=$(run_spec_stub "$st_dir/vacuous" "$st_dir/spec.spl")
    st_total=$(echo "$st_r" | cut -d' ' -f2)
    st_n=$((st_n + 1))
    if [ "$st_total" -ne 0 ]; then
        echo "selftest: FAILED — vacuous fixture was not read as 0 total"
        st_fail=1
    fi

    # (d) annotation enumeration: 2 annotated specs, 3 pairs, 1 unannotated
    mkdir -p "$st_dir/t/a" "$st_dir/t/b"
    printf '# @dual_pair: p1 mode=value ref=rt_x cand=x id=C-MIG-9001\n# @dual_pair: p2 mode=shadow-buffer ref=rt_y cand=y\ndescribe "x":\n' >"$st_dir/t/a/one_spec.spl"
    printf '# @dual_pair: p3 mode=record-compare ref=rt_z cand=z\n' >"$st_dir/t/b/two_spec.spl"
    printf 'describe "no pairs":\n' >"$st_dir/t/b/three_spec.spl"
    st_pairs=$(enumerate_pairs "$st_dir/t" | wc -l | tr -d ' ')
    st_specs=$(enumerate_pairs "$st_dir/t" | cut -f1 | sort -u | wc -l | tr -d ' ')
    st_n=$((st_n + 1))
    if [ "$st_pairs" -ne 3 ] || [ "$st_specs" -ne 2 ]; then
        echo "selftest: FAILED — annotation enumeration found $st_pairs pair(s) in $st_specs spec(s), expected 3 in 2"
        st_fail=1
    fi

    # (e) a tree with 0 annotated pairs -> 0 pairs so the caller must ERROR
    mkdir -p "$st_dir/empty"
    printf 'describe "no pairs":\n' >"$st_dir/empty/x_spec.spl"
    st_pairs=$(enumerate_pairs "$st_dir/empty" | wc -l | tr -d ' ')
    st_n=$((st_n + 1))
    if [ "$st_pairs" -ne 0 ]; then
        echo "selftest: FAILED — empty registry read as $st_pairs pair(s)"
        st_fail=1
    fi

    # (f) ledger mismatch for THIS run -> must surface; other runs ignored
    cat >"$st_dir/ledger.sdn" <<'LEDGER'
dual_run_ledger:
  - pair: p_ok
    mode: value
    run_id: gate-run-1
    cases: 12
    mismatches: 0
    first_mismatch_repr: ""
    binary_identity: seed
  - pair: p_bad
    mode: shadow-buffer
    run_id: gate-run-1
    cases: 3
    mismatches: 1
    first_mismatch_repr: "ref=aa cand=ee (byte 7: ref=0xaa cand=0xee)"
    binary_identity: seed
  - pair: p_other_run
    mode: value
    run_id: gate-run-0
    cases: 1
    mismatches: 5
    first_mismatch_repr: "ref=1 cand=2"
    binary_identity: seed
LEDGER
    st_rows=$(ledger_rows "$st_dir/ledger.sdn" "gate-run-1")
    st_row_n=$(printf '%s\n' "$st_rows" | grep -c .)
    st_bad=$(printf '%s\n' "$st_rows" | awk -F'\t' '$4 > 0 {print $1 ":" $5}')
    st_n=$((st_n + 1))
    if [ "$st_row_n" -ne 2 ] || [ "$st_bad" != 'p_bad:"ref=aa cand=ee (byte 7: ref=0xaa cand=0xee)"' ]; then
        echo "selftest: FAILED — ledger mismatch fixture not read (rows=$st_row_n bad=$st_bad)"
        st_fail=1
    fi

    # (g) registry dual_run_mode rows are enumerated
    cat >"$st_dir/reg.sdn" <<'REG'
c_migrations:
  - id: C-MIG-0001
    path: a.c
  - id: C-MIG-0002
    path: b.c
    dual_run_mode: shadow-buffer
REG
    st_reg=$(registry_modes "$st_dir/reg.sdn")
    st_n=$((st_n + 1))
    if [ "$st_reg" != "$(printf 'C-MIG-0002\tshadow-buffer')" ]; then
        echo "selftest: FAILED — registry mode rows not read ($st_reg)"
        st_fail=1
    fi

    rm -rf "$st_dir"

    if [ "$st_fail" -ne 0 ]; then
        echo "ERROR — nothing was checked (selftest failed)"
        exit 2
    fi
    echo "selftest: $st_n fixture(s) passed"
}

# ---------------------------------------------------------------------------

TEST_ROOT=$TEST_ROOT_DEFAULT
REGISTRY=$REGISTRY_DEFAULT
LEDGER=$LEDGER_DEFAULT
SIMPLE_BIN=$SIMPLE_BIN_DEFAULT
SELFTEST_ONLY=0

while [ $# -gt 0 ]; do
    case "$1" in
        --test-root)     TEST_ROOT=$2; shift 2 ;;
        --registry)      REGISTRY=$2; shift 2 ;;
        --ledger)        LEDGER=$2; shift 2 ;;
        --simple-bin)    SIMPLE_BIN=$2; shift 2 ;;
        --selftest-only) SELFTEST_ONLY=1; shift ;;
        -h|--help)       usage; exit 0 ;;
        *) echo "unknown argument: $1"; usage; echo "ERROR — nothing was checked"; exit 2 ;;
    esac
done

selftest

if [ "$SELFTEST_ONLY" -eq 1 ]; then
    echo "PASS — 7 fixture(s) checked, selftest only, no real spec run"
    exit 0
fi

cd "$REPO_ROOT" || { echo "ERROR — nothing was checked"; exit 2; }

if [ ! -x "$SIMPLE_BIN" ]; then
    echo "no runnable simple binary at: $SIMPLE_BIN"
    echo "ERROR — nothing was checked"
    exit 2
fi

PAIRS_TSV=$(mktemp)
enumerate_pairs "$TEST_ROOT" >"$PAIRS_TSV"
PAIRS=$(grep -c . "$PAIRS_TSV")
if [ "$PAIRS" -eq 0 ]; then
    rm -f "$PAIRS_TSV"
    echo "no '# @dual_pair:' annotation found under $TEST_ROOT"
    echo "ERROR — nothing was checked"
    exit 2
fi

REG_N=$(registry_modes "$REGISTRY" | grep -c .)
echo "registry: $REG_N pair(s) carry dual_run_mode: in $REGISTRY"
awk -F'\t' '{print "pair: " $2 " mode=" $3 " spec=" $1}' "$PAIRS_TSV"

RUN_ID="gate-$$-$(date +%s)"
export DUAL_RUN_ID="$RUN_ID"
export DUAL_RUN_LEDGER="$LEDGER"
if [ -z "${SIMPLE_BINARY_IDENTITY:-}" ]; then
    SIMPLE_BINARY_IDENTITY="$(readlink -f "$SIMPLE_BIN")@$(stat -c %s "$(readlink -f "$SIMPLE_BIN")" 2>/dev/null || echo 0)"
    export SIMPLE_BINARY_IDENTITY
fi

TOTAL=0
FAILED=0
BAD_SPECS=""
for spec in $(cut -f1 "$PAIRS_TSV" | sort -u); do
    RESULT=$(run_spec_stub "$SIMPLE_BIN" "$spec")
    RC=$(echo "$RESULT" | cut -d' ' -f1)
    S_TOTAL=$(echo "$RESULT" | cut -d' ' -f2)
    S_FAILED=$(echo "$RESULT" | cut -d' ' -f4)
    echo "spec: $spec rc=$RC total=$S_TOTAL failed=$S_FAILED"
    if [ "$S_TOTAL" -eq 0 ]; then
        rm -f "$PAIRS_TSV"
        echo "no Results: line found in '$SIMPLE_BIN test $spec' output (rc=$RC)"
        echo "ERROR — nothing was checked"
        exit 2
    fi
    TOTAL=$((TOTAL + S_TOTAL))
    if [ "$S_FAILED" -gt 0 ] || [ "$RC" -ne 0 ]; then
        FAILED=$((FAILED + S_FAILED))
        [ "$S_FAILED" -eq 0 ] && FAILED=$((FAILED + 1))
        BAD_SPECS="$BAD_SPECS $spec"
    fi
done
rm -f "$PAIRS_TSV"

# Ledger rows written by THIS run: cases feed the count, mismatches fail.
LEDGER_ROWS=$(ledger_rows "$LEDGER" "$RUN_ID")
LEDGER_CASES=$(printf '%s\n' "$LEDGER_ROWS" | awk -F'\t' '{c += $3} END {print c + 0}')
LEDGER_BAD=$(printf '%s\n' "$LEDGER_ROWS" | awk -F'\t' '$4 > 0 {printf "%s(%s mismatch(es): %s) ", $1, $4, $5}')
LEDGER_ROW_N=$(printf '%s\n' "$LEDGER_ROWS" | grep -c .)
echo "ledger: $LEDGER_ROW_N row(s) for run $RUN_ID, $LEDGER_CASES comparison case(s), in $LEDGER"

if [ -n "$LEDGER_BAD" ]; then
    echo "FAIL — $PAIRS pair(s) checked, $TOTAL case(s), ledger mismatch: $LEDGER_BAD"
    exit 1
fi
if [ "$FAILED" -gt 0 ]; then
    echo "FAIL — $PAIRS pair(s) checked, $TOTAL case(s), $FAILED divergent in:$BAD_SPECS"
    exit 1
fi

echo "PASS — $PAIRS pair(s) checked, $TOTAL case(s) (+$LEDGER_CASES ledger comparison(s)), 0 divergent"
exit 0
