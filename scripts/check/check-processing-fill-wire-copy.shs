#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

SIMPLE_BINARY="${SIMPLE_BINARY:-bin/simple}"
WORK_DIR="${WORK_DIR:-build/check-processing-fill-wire-copy}"
TARGET_DIR="${CARGO_TARGET_DIR:-$WORK_DIR/cargo-target}"
RUNTIME_ARCHIVE="$TARGET_DIR/bootstrap/libsimple_runtime.a"
PROBE="$WORK_DIR/processing_fill_wire_copy_probe"
EXPECTED="PROCESSING_FILL_WIRE_COPY status=pass exact_checksum=50727180 exact_readback=true mismatch=-1 extra=0"

test -x "$SIMPLE_BINARY"
mkdir -p "$WORK_DIR"

(cd src/compiler_rust && CARGO_TARGET_DIR="$ROOT_DIR/$TARGET_DIR" \
    cargo build --locked -p simple-runtime --profile bootstrap --features runtime-symbol-table)

SIMPLE_LIB=src SIMPLE_LINK_OBJECTS="$RUNTIME_ARCHIVE" \
    timeout 300 "$SIMPLE_BINARY" native-build \
    --entry test/fixtures/processing_fill_wire_copy/main.spl \
    --cache-dir "$WORK_DIR/native-cache" --output "$PROBE"

actual="$(timeout 20 "$PROBE" | tr -d '\r')"
test "$actual" = "$EXPECTED"
echo "processing-fill-wire-copy: pass"
