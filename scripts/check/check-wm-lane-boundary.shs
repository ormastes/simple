#!/bin/sh
# WM/GUI/web/2D portable-lane dependency boundary gate.
#
# Contract: if Simple 2D (rendering + event delivery) runs on SimpleOS, the WM
# runs on SimpleOS. Nothing else may be a precondition. Any other route to the
# host/OS — fs, net, process, env, timers, raw platform `extern`, kernel/driver
# tiers — is a hidden precondition and a violation.
#
# This is a RATCHET against doc/08_tracking/wm_lane_boundary_baseline.txt: it
# fails on violations NOT already in the baseline. The lane starts with a large
# known set (doc/04_architecture/ui/wm_gui_web_dependency_audit.md); a gate that
# failed on all of them would be switched off within a day and enforce nothing.
#
#   sh scripts/check/check-wm-lane-boundary.shs                  # gate
#   sh scripts/check/check-wm-lane-boundary.shs --write-baseline # re-record
#
# The verdict is the LAST line of stdout:
#   PASS  (exit 0)  — states how many files were actually scanned
#   FAIL  (exit 1)  — new violations, each listed as `NEW VIOLATION path:line:code`
#   ERROR (exit 2)  — nothing was checked; never mistake this for a pass
#
# Fail-closed on cwd: run from the repo root. Exit status alone is NOT the
# oracle here (an unresolved `use` in this repo is only a WARN, exit 0) — this
# script reads the verdict line, and so should you.
set -u

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$REPO_ROOT" || { echo "ERROR — nothing was checked: cannot cd to repo root"; exit 2; }

CHECKER="src/app/check/wm_lane_boundary_check.spl"
BASELINE="doc/08_tracking/wm_lane_boundary_baseline.txt"
SIMPLE="${SIMPLE_BIN:-bin/simple}"

[ -x "$SIMPLE" ] || { echo "ERROR — nothing was checked: $SIMPLE is not executable"; exit 2; }
[ -f "$CHECKER" ] || { echo "ERROR — nothing was checked: $CHECKER is missing"; exit 2; }

WORK=$(mktemp -d) || { echo "ERROR — nothing was checked: mktemp failed"; exit 2; }
trap 'rm -rf "$WORK"' EXIT

# Scope roots come from the rule itself (wm_lane_scope_dirs), so this wrapper
# cannot drift from what the lint rule considers in-lane.
"$SIMPLE" run "$CHECKER" --scope-dirs > "$WORK/dirs.txt" 2>"$WORK/dirs.err"
# The runner prints diagnostics on both streams; keep only real directories.
: > "$WORK/roots.txt"
while IFS= read -r d; do
    case "$d" in
        src/*) [ -d "$d" ] && printf '%s\n' "$d" >> "$WORK/roots.txt" ;;
    esac
done < "$WORK/dirs.txt"

if [ ! -s "$WORK/roots.txt" ]; then
    echo "ERROR — nothing was checked: could not read scope roots from $CHECKER"
    exit 2
fi

# `ugrep` is the default grep here; every scan below pins /usr/bin/grep when present.
GREP=grep
[ -x /usr/bin/grep ] && GREP=/usr/bin/grep

: > "$WORK/files.txt"
while IFS= read -r root; do
    find "$root" -name '*.spl' -type f 2>/dev/null >> "$WORK/files.txt"
done < "$WORK/roots.txt"
# Vendored trees are never in scope.
"$GREP" -v -E '/vendor/' "$WORK/files.txt" | LC_ALL=C sort -u > "$WORK/scan.txt"

FILE_COUNT=$("$GREP" -c '\.spl$' "$WORK/scan.txt")
if [ "$FILE_COUNT" -lt 100 ]; then
    echo "ERROR — nothing was checked: only $FILE_COUNT lane file(s) found (expected >=100)"
    exit 2
fi

WRITE_BASELINE=0
if [ "${1:-}" = "--write-baseline" ]; then
    WRITE_BASELINE=1
else
    [ -f "$BASELINE" ] || { echo "ERROR — nothing was checked: $BASELINE is missing"; exit 2; }
fi

# Split the file list into <=20 KiB batches so Windows/MSYS CreateProcessW
# (32,767-char argv limit) never fails with E2BIG ("Argument list too long").
# Run each batch against an empty baseline to collect all active violations,
# then compare once against $BASELINE so fixed-entry counts and PASS/FAIL
# verdicts reflect the whole scan rather than a single shard.
EMPTY_BASELINE="$WORK/empty_baseline.txt"
: > "$EMPTY_BASELINE"
: > "$WORK/out.log"
: > "$WORK/found.txt"

awk -v dir="$WORK" -v limit=20000 '
    BEGIN { idx = 0; cur = 0; fn = sprintf("%s/batch.%03d", dir, idx) }
    {
        gsub(/\r$/, "")
        if ($0 == "") next
        len = length($0) + 1
        if (cur > 0 && cur + len > limit) {
            close(fn)
            idx++
            cur = 0
            fn = sprintf("%s/batch.%03d", dir, idx)
        }
        print $0 > fn
        cur += len
    }
    END { if (cur > 0) close(fn) }
' "$WORK/scan.txt"

# Capture to a FILE. `simple` emits hundreds of lines of unrelated deprecation
# and symbol-collision warnings; a verdict read off the tail of a live pipe is
# how a real failure gets reported as "no output".
BATCH_COUNT=0
for BATCH_FILE in "$WORK"/batch.*; do
    [ -f "$BATCH_FILE" ] || continue
    BATCH_COUNT=$((BATCH_COUNT + 1))
    # shellcheck disable=SC2046
    "$SIMPLE" run "$CHECKER" --baseline="$EMPTY_BASELINE" $(cat "$BATCH_FILE") > "$WORK/batch.log" 2>&1
    RC=$?
    cat "$WORK/batch.log" >> "$WORK/out.log"
    _b_verdict=$("$GREP" -E '^(PASS|FAIL|ERROR) ' "$WORK/batch.log" | tr -d '\r' | tail -1)
    case "$RC:$_b_verdict" in
        0:PASS*|1:FAIL*)
            "$GREP" -E '^NEW VIOLATION ' "$WORK/batch.log" | tr -d '\r' | sed 's/^NEW VIOLATION //' >> "$WORK/found.txt"
            ;;
        *)
            echo "ERROR — nothing was checked: checker produced no valid verdict on batch $BATCH_COUNT (rc=$RC), see $WORK/out.log"
            cp "$WORK/out.log" "$REPO_ROOT/wm_lane_boundary_check_failure.log" 2>/dev/null
            exit 2
            ;;
    esac
done

if [ "$BATCH_COUNT" -eq 0 ]; then
    echo "ERROR — nothing was checked: no scan batches generated"
    exit 2
fi

FOUND_COUNT=$(wc -l < "$WORK/found.txt" | tr -d ' ')

if [ "$WRITE_BASELINE" -eq 1 ]; then
    {
        echo "# WM/GUI/web/2D portable-lane violation baseline (path:line:code)."
        echo "# Regenerate: scripts/check/check-wm-lane-boundary.shs --write-baseline"
        echo "# This list may only SHRINK. See wm_lane_boundary_lints.spl."
        cat "$WORK/found.txt"
    } > "$BASELINE" || {
        echo "ERROR — nothing was checked: could not write $BASELINE"
        exit 2
    }
    echo "PASS — baseline written: $FOUND_COUNT violation(s) over $FILE_COUNT file(s)"
    exit 0
fi

awk -v counts_out="$WORK/counts.txt" '
    { gsub(/\r$/, ""); gsub(/^[ \t]+|[ \t]+$/, "") }
    FNR == NR {
        if ($0 != "" && substr($0, 1, 1) != "#") {
            base[$0] = 1
        }
        next
    }
    {
        if ($0 == "") next
        found_n++
        found[$0] = 1
        if (!($0 in base)) {
            added_n++
            print "NEW VIOLATION " $0
        }
    }
    END {
        for (b in base) {
            if (!(b in found)) removed_n++
        }
        printf "%d %d %d\n", found_n + 0, added_n + 0, removed_n + 0 > counts_out
    }
' "$BASELINE" "$WORK/found.txt"

read -r FOUND_COUNT ADDED_COUNT REMOVED_COUNT < "$WORK/counts.txt"
if [ "$ADDED_COUNT" -gt 0 ]; then
    echo "FAIL — $ADDED_COUNT NEW portable-lane violation(s); $FOUND_COUNT total over $FILE_COUNT file(s) scanned"
    exit 1
fi

echo "PASS — $FILE_COUNT file(s) scanned, $FOUND_COUNT violation(s), all in baseline ($REMOVED_COUNT baseline entr(y/ies) now fixed)"
exit 0
