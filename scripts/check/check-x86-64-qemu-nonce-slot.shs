#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
fixture="$root/test/01_unit/os/kernel/arch/x86_64/x86_64_nonce_slot_contract_fixture.c"
runtime="$root/examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c"
tmp=$(mktemp "${TMPDIR:-/tmp}/x86-64-nonce-slot.XXXXXX")
trap 'rm -f "$tmp"' EXIT HUP INT TERM
cc -std=c11 -Wall -Wextra -Werror "$fixture" -o "$tmp"
"$tmp"
grep -qF 'x86_64_nonce_slot_line_length(nonce_file, bytes_read)' "$runtime"
! grep -qF "nonce_file[bytes_read - 1U] != '\\n'" "$runtime"
echo 'PASS x86_64 canonical fixed-slot nonce parsing and sabotage rejection'
