#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cc=${CC:-clang}
tmp=$(mktemp -d "${TMPDIR:-/tmp}/simple-contract-provider.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

"$cc" -std=gnu11 -I"$root/src/runtime" \
    "$root/test/fixtures/runtime/contract_provider_probe.c" \
    "$root/src/runtime/runtime_contracts.c" -o "$tmp/provider-probe"

"$tmp/provider-probe"
set +e
"$tmp/provider-probe" fail >"$tmp/fail.stdout" 2>"$tmp/fail.stderr"
status=$?
set -e
[ "$status" -ne 0 ]
grep -F "Assertion violation in function 'provider_probe': contract condition failed" \
    "$tmp/fail.stderr" >/dev/null

echo "runtime-contract-provider-native: pass"
