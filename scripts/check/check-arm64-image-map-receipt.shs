#!/bin/sh
set -eu

src=examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c

require() {
    if ! grep -F "$1" "$src" >/dev/null; then
        echo "FAIL: missing ARM64 image-map receipt contract: $1" >&2
        exit 1
    fi
}

require 'static void arm64_image_map_receipt('
require '"[ARM64_IMAGE_MAP] stage="'
require 'serial_puts(" root=")'
require 'serial_puts(" va=")'
require 'serial_puts(" phys=")'
require 'serial_puts(" flags=")'
require 'serial_puts(" map=")'
require 'arm64_image_map_receipt(5U, root, ARM64_USER_STDOUT_VA, stdout_phys,'
require 'arm64_image_map_receipt(7U, root, va, dst_phys + (va - min_vaddr),'
require 'arm64_image_map_receipt(8U, root, va, phys, vm_flags, map_result)'
require 'arm64_image_map_receipt(9U, root, min_vaddr, dst_phys, 0, (int64_t)mapped)'

echo 'PASS: ARM64 ELF image mapping has closed numeric segment/page/map receipts'
