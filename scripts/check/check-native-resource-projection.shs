#!/bin/sh
# Verify the producer-bound native ScopedChildRun projection regression.
set -eu
if [ "$#" -ne 2 ] || [ "$1" != --binary ] || [ ! -x "$2" ]; then
    echo "usage: $0 --binary <native-resource-projection-regression>" >&2
    exit 2
fi
binary=$2
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
work=$(mktemp -d "${TMPDIR:-/tmp}/native-resource-projection.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
export SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB=1048576
export SIMPLE_PROCESS_TREE_RSS_RECEIPT=$work/process.rss.env
set +e
sh "$repo/scripts/bootstrap/run-process-group-timeout.shs" 30 2 "$binary" > "$work/stdout" 2> "$work/stderr"
projection_rc=$?
set -e
cat "$work/stdout"
if [ "$projection_rc" -ne 0 ]; then
    cat "$work/stderr" >&2
    echo "FAIL native resource projection: executable exit=$projection_rc" >&2
    exit 1
fi
if grep '^FAIL ' "$work/stdout" >/dev/null || ! grep -Fx 'RESOURCE_PROJECTION_REGRESSION PASS present absent limit' "$work/stdout" >/dev/null; then
    echo "FAIL native resource projection: missing complete regression summary" >&2
    exit 1
fi
echo "PASS native resource projection: present, absent and limit result evidence"
