#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
OUT=${TMPDIR:-/tmp}/simple-kpf-performance-mutation-$$.env
trap 'rm -f "$OUT"' EXIT HUP INT TERM
if KPF_BENCHMARK_OUTPUT="$OUT" KPF_BENCHMARK_SLOW_STATIC=1 "$ROOT/scripts/check/kernel-plugin-fabric/benchmark-performance-capacity.shs" >/dev/null 2>&1; then
  echo 'KPF_PERFORMANCE_MUTATION: FAIL real slower implementation admitted' >&2; exit 1
fi
if KPF_BENCHMARK_OUTPUT="$OUT" KPF_SLOT_SCALING_PPM_LIMIT=0 "$ROOT/scripts/check/kernel-plugin-fabric/benchmark-performance-capacity.shs" >/dev/null 2>&1; then
  echo 'KPF_PERFORMANCE_MUTATION: FAIL complexity bypass admitted' >&2; exit 1
fi
echo 'KPF_PERFORMANCE_MUTATION: PASS real slowdown and complexity mutations rejected'
