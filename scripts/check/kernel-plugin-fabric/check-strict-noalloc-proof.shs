#!/bin/sh
set -eu

root=${1:-.}
probe="$root/src/lib/nogc_async_mut_noalloc/kernel_plugin/allocation_probe.spl"
runtime="$root/src/lib/nogc_async_mut_noalloc/kernel_plugin/fixed_runtime.spl"
spec="$root/test/01_unit/lib/nogc_async_mut_noalloc/kernel_plugin/fixed_runtime_spec.spl"

fail() {
    echo "KPF_STRICT_NOALLOC_PROOF: FAIL $1" >&2
    exit 1
}

test -f "$probe" || fail missing-probe
test -f "$runtime" || fail missing-runtime
test -f "$spec" || fail missing-spec

grep -Fq 'extern fn rt_heap_registry_count() -> i64' "$probe" || fail missing-runtime-counter
grep -Fq 'self.baseline_count = rt_heap_registry_count()' "$probe" || fail missing-activation-snapshot
grep -Fq 'if current_count != self.baseline_count:' "$probe" || fail missing-delta-check
grep -Fq 'KpfRuntimeAllocationStatus.AllocationDetected' "$probe" || fail missing-fail-closed-status
grep -Fq 'self.allocation_probe.activate()' "$runtime" || fail runtime-not-instrumented
grep -Fq 'self.allocation_probe.allocation_count()' "$runtime" || fail count-not-observable
grep -Fq 'pub me drain_session(handle: KpfSessionHandle, maximum: i32) -> i32:' "$runtime" || fail missing-drain-entrypoint
grep -Fq 'pub me run_representative_workload(iterations: i32, requests_per_session: i32) -> KpfFixedRuntimeWorkloadReceipt:' "$runtime" || fail missing-workload-receipt
grep -Fq 'self.session_capacity_exhaustion_count_value = self.session_capacity_exhaustion_count_value + 1' "$runtime" || fail missing-session-capacity-counter
grep -Fq 'self.request_capacity_exhaustion_count_value = self.request_capacity_exhaustion_count_value + 1' "$runtime" || fail missing-request-capacity-counter
grep -Fq 'self.cancellation_count_value = self.cancellation_count_value + 1' "$runtime" || fail missing-cancellation-counter
grep -Fq 'self.drain_count_value = self.drain_count_value + drained' "$runtime" || fail missing-drain-counter
grep -Fq 'allocated_after_activation.push(42)' "$spec" || fail missing-real-allocation-fixture
grep -Fq 'to_be_greater_than(0u64)' "$spec" || fail nonvacuity-count-not-asserted
grep -Fq 'KpfRuntimeAllocationStatus.AllocationDetected' "$spec" || fail nonvacuity-status-not-asserted
grep -Fq 'run_representative_workload(32, 2)' "$spec" || fail missing-long-run-workload
grep -Fq 'expect(receipt.session_capacity_exhaustions).to_equal(32)' "$spec" || fail missing-capacity-evidence
grep -Fq 'expect(receipt.drain_requests' "$spec" && fail typo-detected-in-spec || true
grep -Fq 'expect(receipt.drained_requests).to_equal(64)' "$spec" || fail missing-drain-evidence
grep -Fq 'expect(receipt.leak_bytes_after_drain).to_equal(0u64)' "$spec" || fail missing-leak-evidence
grep -Fq 'expect(receipt.fragmentation_bytes).to_equal(0u64)' "$spec" || fail missing-fragmentation-evidence
grep -Fq 'expect(receipt.post_activation_allocations).to_equal(0u64)' "$spec" || fail missing-strict-zero-allocation-assertion

echo "KPF_STRICT_NOALLOC_PROOF: PASS runtime_counter=rt_heap_registry_count negative_fixture=real_array_growth"
