#!/bin/sh
# Prevention gate for deployed_binary_reads_stdlib_from_its_build_worktree_2026-08-25
# and deployed_seed_resolves_stdlib_from_foreign_worktree_2026-08-20.
#
# A binary built in worktree A and run in worktree B must resolve `std.*` from
# B's src/lib. Fixture: a temp project whose src/lib shadows a real stdlib
# module (std.async_core) and adds a sentinel fn returning 888. The binary's
# build tree has no such fn, so seeing 888 proves the invoking tree won.
#
# usage: check-stdlib-invoking-tree-wins.shs [--selftest] [simple-binary]
# Verdict line is last on stdout: PASS (0) / FAIL (1) / ERROR (2).

repo_root=$(cd "$(dirname "$0")/../.." && pwd)

probe() {
    bin=$1
    [ -x "$bin" ] || { echo "ERROR -- nothing was checked (binary not executable: $bin)"; return 2; }
    tmp=$(mktemp -d) || { echo "ERROR -- nothing was checked (mktemp)"; return 2; }
    mkdir -p "$tmp/src/lib/nogc_async_mut"
    src="$repo_root/src/lib/nogc_async_mut/async_core.spl"
    [ -f "$src" ] || { rm -rf "$tmp"; echo "ERROR -- nothing was checked (no $src)"; return 2; }
    cp "$src" "$tmp/src/lib/nogc_async_mut/async_core.spl"
    printf '\nfn zz_which() -> i64:\n    888\n' >> "$tmp/src/lib/nogc_async_mut/async_core.spl"
    printf 'use std.async_core.{zz_which}\nfn main():\n    print "{zz_which()}"\n' > "$tmp/q.spl"
    out=$(cd "$tmp" && "$bin" run q.spl 2>/dev/null)
    rc=$?
    rm -rf "$tmp"
    case "$out" in
        *888*) echo "PASS -- 1 probe, invoking tree's src/lib won (rc=$rc)"; return 0 ;;
        *) echo "FAIL -- 1 probe, sentinel 888 not seen; binary read a foreign stdlib tree (rc=$rc)"; return 1 ;;
    esac
}

if [ "$1" = "--selftest" ]; then
    d=$(mktemp -d)
    printf '#!/bin/sh\necho 0\n' > "$d/fake_foreign"; chmod +x "$d/fake_foreign"
    v=$(probe "$d/fake_foreign"); rc=$?
    rm -rf "$d"
    [ "$rc" -eq 1 ] || { echo "$v"; echo "ERROR -- selftest: foreign-reading fake must FAIL"; exit 2; }
    shift
    [ -z "$1" ] && { echo "PASS -- selftest only"; exit 0; }
fi

bin=${1:-${SIMPLE_BINARY:-$repo_root/bin/simple}}
probe "$bin"
exit $?
