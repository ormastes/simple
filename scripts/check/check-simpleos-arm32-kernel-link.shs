#!/bin/sh
# arm32 (ARMv7-A) SimpleOS kernel gate (link stage).
#
# Builds examples/09_embedded/simple_os/arch/arm32/os_entry.spl as a
# freestanding arm32 kernel (seed native-build, LLVM backend,
# SIMPLE_BOOT_MINIMAL=1, no stub fallback) and reports every undefined
# symbol at link. Modelled on check-simpleos-riscv32-kernel-link.shs and
# check-simpleos-riscv64-user-elf-opensbi.shs (--link-only).
#
#   sh scripts/check/check-simpleos-arm32-kernel-link.shs --link-only
#
# Env: SIMPLE_BIN (seed with --features llvm, required;
#      SIMPLE_NATIVE_BUILD_RUST defaults to 1 for the seed Rust native-build path),
#      OUT (default build/verify/simpleos-arm32-kernel).
# Needs llvm-nm and ld.lld on PATH (clang/LLVM only; never GNU binutils).
#
# Last stdout line is the verdict:
#   PASS - kernel linked (<bytes> bytes), 0 undefined symbols      (exit 0)
#   FAIL - <n> undefined symbol(s): <names>                        (exit 1)
#   ERROR - nothing was checked (<reason>)                         (exit 2)
set -eu
verdict_error() { echo "ERROR - nothing was checked ($*)"; exit 2; }

MODE=${1:-}
[ "$MODE" = "--link-only" ] || verdict_error "only --link-only is implemented; real-firmware boot stage lands separately"

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"
SIMPLE_BIN=${SIMPLE_BIN:-}
[ -n "$SIMPLE_BIN" ] && [ -x "$SIMPLE_BIN" ] || verdict_error "SIMPLE_BIN not set to an executable seed"
for tool in llvm-nm ld.lld od; do
    command -v "$tool" >/dev/null 2>&1 || verdict_error "missing tool: $tool"
done

ENTRY=examples/09_embedded/simple_os/arch/arm32/os_entry.spl
LDS=examples/09_embedded/simple_os/arch/arm32/linker.ld
OUT=${OUT:-$ROOT/build/verify/simpleos-arm32-kernel}
mkdir -p "$OUT"

KERNEL=$OUT/kernel.elf
LOG=$OUT/kernel-build.log
rm -f "$KERNEL"
set +e
SIMPLE_NATIVE_BUILD_RUST=${SIMPLE_NATIVE_BUILD_RUST:-1} SIMPLE_BOOT_MINIMAL=1 SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LIB="$ROOT/src" \
"$SIMPLE_BIN" native-build --cache-dir "$OUT/native-cache" --source src/os \
    --source src/lib --source examples/09_embedded/simple_os --backend llvm \
    --opt-level=aggressive --log off --timeout 1200 --entry-closure --entry "$ENTRY" \
    --target armv7-unknown-none-eabi --linker-script "$LDS" --output "$KERNEL" \
    >"$LOG" 2>&1
rc=$?
set -e

undef=$(grep -o 'undefined symbol: [A-Za-z0-9_.$]*' "$LOG" | sed 's/undefined symbol: //' | sort -u)
n=$(printf '%s\n' "$undef" | grep -c . || true)
if [ "$n" -gt 0 ]; then
    printf '%s\n' "$undef" > "$OUT/undefined.txt"
    echo "FAIL - $n undefined symbol(s): $(printf '%s' "$undef" | tr '\n' ' ')"
    exit 1
fi
[ "$rc" -eq 0 ] && [ -s "$KERNEL" ] || { tail -20 "$LOG" >&2; verdict_error "kernel native-build failed (rc=$rc), log $LOG"; }
[ "$(od -An -tx1 -N4 "$KERNEL" | tr -d ' \n')" = 7f454c46 ] || verdict_error "$KERNEL is not ELF"
# ELFCLASS32 (byte 4 = 01) and e_machine EM_ARM (0x28 at offset 18, LE).
[ "$(od -An -tx1 -j4 -N1 "$KERNEL" | tr -d ' \n')" = 01 ] || verdict_error "$KERNEL is not ELF32"
[ "$(od -An -tx1 -j18 -N2 "$KERNEL" | tr -d ' \n')" = 2800 ] || verdict_error "$KERNEL is not EM_ARM"
echo "PASS - kernel linked ($(wc -c < "$KERNEL") bytes), 0 undefined symbols"
