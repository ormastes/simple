#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

SIMPLE_BINARY="${SIMPLE_BINARY:-bin/simple}"
BUILD_DIR="${BUILD_DIR:-build/simple-core-smoke}"
CORE_DIR="${SIMPLE_CORE_BUILD_DIR:-build/simple-core}"
CORE_ARCHIVE="$CORE_DIR/libsimple_runtime.a"
CORE_SOURCE_DIR="${SIMPLE_CORE_SOURCE_DIR:-src/runtime/simple_core}"
CORE_ARCHIVE_PART_DIR="$BUILD_DIR/simple_core_archive_parts"
ARCHIVE_ONLY="${ARCHIVE_ONLY:-0}"
TARGET="${TARGET:-}"
BACKEND="${SIMPLE_CORE_BACKEND:-llvm}"
HELLO_BIN="$BUILD_DIR/hello_simple_core"
CHR_BIN="$BUILD_DIR/char_from_code_simple_core"
TUI_ENTRY="$BUILD_DIR/minimal_tui_smoke_entry.spl"
TUI_BIN="$BUILD_DIR/minimal_tui_smoke_simple_core"
TUI_APP_ENTRY="$BUILD_DIR/minimal_tui_app_entry.spl"
TUI_APP_BIN="$BUILD_DIR/minimal_tui_app_simple_core"

# The closure-cleanliness scan used to be four inline lines ending in
# `|| true` plus `${VAR:-0}` defaults. That laundered *tool failure* into a
# clean verdict: with `strings`/`nm` unavailable both counts defaulted to 0 and
# the gate reported `simple_core_closure_clean=true`, exit 0, on a file that
# visibly contained BOTH forbidden markers (measured 2026-08-17 --- see
# `doc/08_tracking/bug/simple_core_pure_simple_archive_builder.md`). `nm`
# failing for any other reason (not a valid object file) laundered identically.
# Absence of evidence is not evidence of absence: a missing or failing tool is
# now ERROR exit 2, never a pass, and every exit status is read on the line
# AFTER the command that produced it, never through a pipe.
HOSTED_MARKER_RE='libsimple_native_all|rust-hosted'
UNWIND_MARKER_RE='_Unwind|unwind'

closure_marker_scan() {
    cms_hosted=0
    cms_unwind=0
    cms_checked=0
    for cms_tool in strings nm rg; do
        if ! command -v "$cms_tool" >/dev/null 2>&1; then
            echo "simple_core_closure_clean=unknown"
            echo "error=closure_scan_tool_unavailable:$cms_tool"
            echo "ERROR — nothing was checked"
            return 2
        fi
    done
    for cms_bin in "$@"; do
        if [ ! -r "$cms_bin" ]; then
            echo "simple_core_closure_clean=unknown"
            echo "error=closure_scan_binary_unreadable:$cms_bin"
            echo "ERROR — nothing was checked"
            return 2
        fi

        # `set -e` would abort on a failing command substitution before the
        # status could be inspected, so disable it around the capture and read
        # the status on the line AFTER the command -- never through a pipe.
        set +e
        cms_strings="$(strings "$cms_bin" 2>/dev/null)"
        cms_rc=$?
        set -e
        if [ "$cms_rc" -ne 0 ]; then
            echo "simple_core_closure_clean=unknown"
            echo "error=closure_scan_strings_failed:$cms_bin rc=$cms_rc"
            echo "ERROR — nothing was checked"
            return 2
        fi
        cms_n="$(printf '%s\n' "$cms_strings" | rg -c "$HOSTED_MARKER_RE" || true)"
        cms_hosted=$((cms_hosted + ${cms_n:-0}))

        set +e
        cms_syms="$(nm -a "$cms_bin" 2>/dev/null)"
        cms_rc=$?
        set -e
        if [ "$cms_rc" -ne 0 ]; then
            echo "simple_core_closure_clean=unknown"
            echo "error=closure_scan_nm_failed:$cms_bin rc=$cms_rc"
            echo "ERROR — nothing was checked"
            return 2
        fi
        cms_n="$(printf '%s\n' "$cms_syms" | rg -c "$UNWIND_MARKER_RE" || true)"
        cms_unwind=$((cms_unwind + ${cms_n:-0}))

        cms_checked=$((cms_checked + 1))
    done
    if [ "$cms_checked" -eq 0 ]; then
        echo "ERROR — nothing was checked"
        return 2
    fi
    if [ "$cms_hosted" -ne 0 ] || [ "$cms_unwind" -ne 0 ]; then
        echo "simple_core_closure_clean=false"
        echo "hosted_markers=$cms_hosted"
        echo "unwind_markers=$cms_unwind"
        echo "FAIL — $cms_checked binary(ies) scanned, hosted=$cms_hosted unwind=$cms_unwind"
        return 1
    fi
    echo "simple_core_closure_scanned=$cms_checked"
    return 0
}

scrs_selftest() {
    st_dir="$(mktemp -d)"
    st_fail=0
    st_checked=0
    st_case() { # name expected_rc; runs closure_marker_scan on remaining args
        st_name="$1"; st_want="$2"; shift 2
        st_checked=$((st_checked + 1))
        st_out="$(closure_marker_scan "$@" 2>&1)" && st_got=0 || st_got=$?
        if [ "$st_got" = "$st_want" ]; then
            echo "selftest ok: $st_name (rc=$st_got)"
        else
            echo "selftest FAIL: $st_name want_rc=$st_want got_rc=$st_got"
            printf '%s\n' "$st_out" | sed 's/^/    /'
            st_fail=$((st_fail + 1))
        fi
    }

    # A real, clean ELF object with no forbidden markers -- must PASS.
    printf 'int spl_selftest_clean(void){return 0;}\n' >"$st_dir/clean.c"
    st_cc=""
    for st_c in cc clang gcc; do
        if command -v "$st_c" >/dev/null 2>&1; then st_cc="$st_c"; break; fi
    done
    if [ -z "$st_cc" ]; then
        # No compiler => we cannot build the must-PASS fixture. That is
        # ERROR, not a pass: the same rule the scan itself now obeys.
        echo "ERROR — nothing was checked (no C compiler for selftest fixtures)"
        rm -rf "$st_dir"
        exit 2
    fi
    "$st_cc" -c -o "$st_dir/clean.o" "$st_dir/clean.c" >/dev/null 2>&1
    st_case "clean-object-passes" 0 "$st_dir/clean.o"

    # (1) Reproducing fixture for the defect class: tools unavailable. The old
    #     code returned a CLEAN verdict here on marker-bearing input.
    mkdir -p "$st_dir/stub"
    for st_t in strings nm; do
        printf '#!/bin/sh\nexit 127\n' >"$st_dir/stub/$st_t"
        chmod +x "$st_dir/stub/$st_t"
    done
    printf 'libsimple_native_all\n_Unwind_Resume\n' >"$st_dir/dirty"
    # Subshell, not an assignment prefix: a var prefix on a shell FUNCTION is
    # not portably scoped to it, and the stubbed PATH must be in effect for
    # every command the function runs.
    st_out="$( (PATH="$st_dir/stub:$PATH"; closure_marker_scan "$st_dir/dirty") 2>&1 )" \
        && st_got=0 || st_got=$?
    st_checked=$((st_checked + 1))
    if [ "$st_got" = 2 ]; then
        echo "selftest ok: missing-tool-is-ERROR-not-pass (rc=2)"
    else
        echo "selftest FAIL: missing-tool-is-ERROR-not-pass want_rc=2 got_rc=$st_got"
        st_fail=$((st_fail + 1))
    fi

    # (2) Generalizing fixtures.
    # A forbidden marker present in a real object must FAIL, not pass.
    printf 'const char *spl_selftest_marker = "libsimple_native_all";\n' >"$st_dir/dirty.c"
    "$st_cc" -c -o "$st_dir/dirty.o" "$st_dir/dirty.c" >/dev/null 2>&1
    st_case "hosted-marker-in-object-fails" 1 "$st_dir/dirty.o"

    # A non-object file makes `nm` fail; that must be ERROR, not a clean pass.
    # Deliberately marker-FREE, so the only thing that can produce a non-zero
    # verdict is the tool failure itself -- a marker-bearing file would FAIL
    # for the other reason and the fixture would prove nothing.
    printf 'just plain text, no forbidden markers here\n' >"$st_dir/notanobject"
    st_case "nm-failure-is-ERROR-not-pass" 2 "$st_dir/notanobject"

    # An unreadable / absent binary must be ERROR, never a vacuous pass.
    st_case "absent-binary-is-ERROR" 2 "$st_dir/does-not-exist"

    # Zero binaries scanned must be ERROR, never a pass -- the core
    # non-vacuity rule.
    st_case "empty-input-is-ERROR" 2

    rm -rf "$st_dir"
    if [ "$st_checked" -eq 0 ]; then
        echo "ERROR — nothing was checked"
        exit 2
    fi
    if [ "$st_fail" -ne 0 ]; then
        echo "FAIL — $st_checked selftest fixture(s) checked, $st_fail failed"
        exit 1
    fi
    echo "PASS — $st_checked selftest fixture(s) checked, 0 failed"
}

if [ "${1:-}" = "--selftest" ]; then
    scrs_selftest
    exit 0
fi

mkdir -p "$BUILD_DIR" "$CORE_DIR"

build_archive_part() {
    entry="$1"
    output="$2"
    set -- "$SIMPLE_BINARY" native-build \
        --backend "$BACKEND" \
        --source "$CORE_SOURCE_DIR" \
        --entry-closure \
        --entry "$entry" \
        --no-mangle \
        --emit-archive \
        --output "$output" \
        --clean
    if [ -n "$TARGET" ]; then
        set -- "$@" --target "$TARGET"
    fi
    "$@"
}

if "$SIMPLE_BINARY" native-build --help 2>/dev/null | rg -q -- '--emit-archive'; then
    rm -rf "$CORE_ARCHIVE_PART_DIR"
    mkdir -p "$CORE_ARCHIVE_PART_DIR/objects"
    for core_entry in "$CORE_SOURCE_DIR"/*.spl; do
        part_name="$(basename "$core_entry" .spl)"
        part_archive="$CORE_ARCHIVE_PART_DIR/$part_name.a"
        part_log="$CORE_ARCHIVE_PART_DIR/$part_name.log"
        if ! build_archive_part "$core_entry" "$part_archive" >"$part_log" 2>&1 ||
           grep -q 'FAILED FILES' "$part_log" ||
           [ ! -f "$part_archive" ]; then
            echo "simple_core_archive_complete=false"
            echo "error=archive_part_failed:$part_name log=$part_log"
            exit 1
        fi
        mkdir -p "$CORE_ARCHIVE_PART_DIR/objects/$part_name"
        (cd "$CORE_ARCHIVE_PART_DIR/objects/$part_name" && ar x "../../$part_name.a")
        # Each standalone archive contains an entry-specific module-init
        # aggregator. The final user executable generates its own aggregator;
        # retaining one copy per runtime source creates duplicate
        # __simple_call_module_inits owners at link time.
        rm -f "$CORE_ARCHIVE_PART_DIR/objects/$part_name/_init_all.o"
    done
    rm -f "$CORE_ARCHIVE"
    ar rcs "$CORE_ARCHIVE" "$CORE_ARCHIVE_PART_DIR"/objects/*/*.o
else
    echo "simple_core_archive_capable=false"
    echo "error=selected_simple_binary_lacks_emit_archive:$SIMPLE_BINARY"
    exit 1
fi

archive_has_symbol() {
    # Apple nm has no GNU --defined-only flag and prefixes external symbols
    # with an underscore.  Compare the final field after normalizing that
    # platform prefix so this gate proves every required ABI owner on both
    # macOS and GNU hosts.
    nm -g "$CORE_ARCHIVE" 2>/dev/null |
        awk '{print $NF}' |
        sed 's/^_//' |
        rg -q -x "$1"
}

for required_symbol in \
    rt_string_replace rt_to_string rt_array_new rt_array_extend_i64 rt_math_sqrt stdin_read_char \
    rt_atexit_check rt_signal_check rt_thread_sleep \
    rt_atomic_int_new rt_atomic_int_load rt_atomic_int_compare_exchange \
    rt_process_spawn_async rt_process_spawn_guarded rt_process_wait rt_process_is_running rt_process_kill \
    spl_thread_cpu_count text_dot_from_char_code rt_char_from_code rt_u32s_from_raw; do
    if ! archive_has_symbol "$required_symbol"; then
        echo "simple_core_archive_complete=false"
        echo "error=missing_required_symbol:$required_symbol"
        exit 1
    fi
done

if archive_has_symbol "__simple_call_module_inits"; then
    echo "simple_core_archive_complete=false"
    echo "error=unexpected_entry_init_aggregator"
    exit 1
fi

case "$CORE_ARCHIVE" in
    /*) SIMPLE_CORE_RUNTIME_PATH="$CORE_ARCHIVE" ;;
    *) SIMPLE_CORE_RUNTIME_PATH="$ROOT_DIR/$CORE_ARCHIVE" ;;
esac
export SIMPLE_CORE_RUNTIME_PATH

if [ "$ARCHIVE_ONLY" = "1" ]; then
    echo "simple_core_archive=$CORE_ARCHIVE"
    echo "simple_core_archive_complete=true"
    exit 0
fi

cat >"$TUI_ENTRY" <<'EOF'
use app.ui.tui.standalone.{run_standalone_tui}

fn main() -> i64:
    return run_standalone_tui("examples/06_io/ui/minimal.ui.sdn")
EOF

cat >"$TUI_APP_ENTRY" <<'EOF'
use app.ui.tui.app.{run_tui}

fn main() -> i64:
    return run_tui("examples/06_io/ui/minimal.ui.sdn")
EOF

"$SIMPLE_BINARY" native-build \
    --backend "$BACKEND" \
    --runtime-bundle simple-core \
    --source examples \
    --entry-closure \
    --entry examples/01_getting_started/hello_native.spl \
    --strip \
    --output "$HELLO_BIN" \
    --clean >/tmp/simple_core_hello_build.$$ 2>&1

HELLO_OUTPUT="$("$HELLO_BIN")"
if [ "$HELLO_OUTPUT" != "Hello World" ]; then
    echo "simple_core_hello=false"
    echo "hello_output=$HELLO_OUTPUT"
    exit 1
fi

"$SIMPLE_BINARY" native-build \
    --backend "$BACKEND" \
    --runtime-bundle simple-core \
    --source test/03_system/native \
    --entry-closure \
    --entry test/03_system/native/c5_char_from_code.spl \
    --strip \
    --output "$CHR_BIN" \
    --clean >/tmp/simple_core_chr_build.$$ 2>&1

CHR_STATUS=0
"$CHR_BIN" || CHR_STATUS=$?
if [ "$CHR_STATUS" -ne 42 ]; then
    echo "simple_core_char_from_code=false"
    echo "char_from_code_status=$CHR_STATUS"
    exit 1
fi

"$SIMPLE_BINARY" native-build \
    --backend "$BACKEND" \
    --runtime-bundle simple-core \
    --source src \
    --entry-closure \
    --entry "$TUI_ENTRY" \
    --strip \
    --output "$TUI_BIN" \
    --clean >/tmp/simple_core_tui_build.$$ 2>&1

TUI_OUTPUT="$("$TUI_BIN")"
if ! printf '%s\n' "$TUI_OUTPUT" | rg -q "UI closed."; then
    echo "simple_core_tui=false"
    exit 1
fi

"$SIMPLE_BINARY" native-build \
    --backend "$BACKEND" \
    --runtime-bundle simple-core \
    --source src \
    --entry-closure \
    --entry "$TUI_APP_ENTRY" \
    --strip \
    --output "$TUI_APP_BIN" \
    --clean >/tmp/simple_core_tui_app_build.$$ 2>&1

TUI_APP_OUTPUT="$(printf 'quit\n' | "$TUI_APP_BIN")"
if ! printf '%s\n' "$TUI_APP_OUTPUT" | rg -q "UI closed."; then
    echo "simple_core_tui_app=false"
    exit 1
fi

closure_marker_scan "$HELLO_BIN" "$CHR_BIN" "$TUI_BIN" "$TUI_APP_BIN" || exit $?

echo "simple_core_archive=$CORE_ARCHIVE"
echo "simple_core_hello=true"
echo "simple_core_char_from_code=true"
echo "simple_core_standalone_tui=true"
echo "simple_core_tui_app=true"
echo "simple_core_closure_clean=true"
