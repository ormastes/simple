#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
POLICY_REL=src/os/kernel/arch/cortex_m33/access_policy.spl
POLICY=$ROOT/$POLICY_REL
HEADER=$ROOT/src/os/kernel/arch/cortex_m33/access_policy.h
SHIM=$ROOT/src/os/kernel/arch/cortex_m33/cm33_shim.c
PIN=$ROOT/test/fixture/os/cortex_m_access_policy_coverage_pin.env
SCRATCH=$(mktemp -d "${TMPDIR:-/tmp}/cortex-m-access-source.XXXXXX")
trap 'rm -r -- "$SCRATCH"' EXIT HUP INT TERM

fail() {
    echo "FAIL cortex-m-access-policy-source-contract: $*" >&2
    exit 1
}

pin_value() {
    sed -n "s/^$1=//p" "$PIN"
}

hash_file() {
    sha256sum "$1" | awk '{print $1}'
}

[ "$(pin_value schema)" = cortex-m-access-policy-coverage/v1 ] || fail pin-schema
[ "$(pin_value owner_source)" = "$POLICY_REL" ] || fail pin-owner
POLICY_SHA=$(hash_file "$POLICY")
[ "$(pin_value owner_source_sha256)" = "$POLICY_SHA" ] || fail pin-source-hash-stale

grep -n -o 'CORTEX-M-ACCESS-D[0-9][0-9]' "$POLICY" >"$SCRATCH/decision-ids.txt"
awk -F: '{print $2}' "$SCRATCH/decision-ids.txt" >"$SCRATCH/observed-ids.txt"
awk 'BEGIN { for (i = 1; i <= 8; i++) printf "CORTEX-M-ACCESS-D%02d\n", i }' \
    >"$SCRATCH/required-ids.txt"
diff -u "$SCRATCH/required-ids.txt" "$SCRATCH/observed-ids.txt" || fail decision-id-set
DECISION_SITES=$(wc -l <"$SCRATCH/decision-ids.txt" | tr -d ' ')
[ "$DECISION_SITES" = "$(pin_value decision_sites)" ] || fail decision-site-count
DECISION_IDS_SHA=$(hash_file "$SCRATCH/decision-ids.txt")
[ "$(pin_value decision_ids_sha256)" = "$DECISION_IDS_SHA" ] || fail pin-decision-ids-stale
BRANCH_OUTCOMES=$((DECISION_SITES * 2))
[ "$BRANCH_OUTCOMES" = "$(pin_value branch_outcomes_total)" ] || fail branch-outcome-denominator

[ "$(grep -c '^@export("C")$' "$POLICY")" -eq 2 ] || fail pure-owner-c-export-count
grep -F 'fn cortex_m_policy_read_receipt(' "$POLICY" >/dev/null || fail read-owner-missing
grep -F 'fn cortex_m_policy_write_receipt(' "$POLICY" >/dev/null || fail write-owner-missing
if grep -Ev '^[[:space:]]*#' "$POLICY" | grep -Eq 'volatile|__asm|uart_|board_uart|MPU_'; then
    fail pure-owner-contains-c-hardware-responsibility
fi

sed -n 's/^uint32_t \(cortex_m_policy_[^(]*\)(.*/\1/p' "$HEADER" \
    >"$SCRATCH/header-abi.txt"
printf '%s\n' cortex_m_policy_read_receipt cortex_m_policy_write_receipt \
    >"$SCRATCH/required-abi.txt"
diff -u "$SCRATCH/required-abi.txt" "$SCRATCH/header-abi.txt" || fail c-header-abi-set
grep -F '#include "access_policy.h"' "$SHIM" >/dev/null || fail shim-header-missing
if grep -F 'extern uint32_t cortex_m_policy_' "$SHIM" >/dev/null; then
    fail shim-duplicates-header-abi
fi
grep -F 'cortex_m_policy_read_receipt(' "$SHIM" >/dev/null || fail shim-read-call-missing
grep -F 'cortex_m_policy_write_receipt(' "$SHIM" >/dev/null || fail shim-write-call-missing
grep -F 'volatile uint32_t *p' "$SHIM" >/dev/null || fail c-volatile-access-owner-missing

OBJECT_GATE=$ROOT/scripts/check/check-cortex-m-policy-object.shs
grep -F 'c_abi_exports=2 object_globals=6 undefined=0' "$OBJECT_GATE" >/dev/null || \
    fail object-gate-abi-accounting
for binding in \
    'run_simpleos_cortex_m33_qemu.shs:an505:thumbv8m.main-none-eabi' \
    'run_simpleos_stm32u585.shs:stm32u585:thumbv8m.main-none-eabi' \
    'run_simpleos_ra4m1.shs:ra4m1:thumbv7em-none-eabi'; do
    script=${binding%%:*}
    rest=${binding#*:}
    board=${rest%%:*}
    target=${rest#*:}
    path=$ROOT/scripts/os/$script
    grep -F -- "--target $target --emit-object" "$path" >/dev/null || fail "$board-target"
    grep -F "$board \"\$POLICY_OBJ\"" "$path" >/dev/null || fail "$board-object-admission"
done

echo "PASS cortex-m-access-policy-source-contract owner_sha256=$POLICY_SHA decision_ids_sha256=$DECISION_IDS_SHA decision_sites=$DECISION_SITES branch_outcomes_total=$BRANCH_OUTCOMES c_abi_exports=2 object_globals=6"
