#!/bin/sh
# Native runtime API qualification; does not rebuild or qualify deployed P2.
set -eu
bound_flag=
case "${1-}" in
    '') ;;
    --bound-image) bound_flag=-DSOSIX_TEST_BOUND_IMAGE_API ;;
    *) echo 'usage: check-sosix-darwin-snapshot-api.shs [--bound-image]' >&2; exit 64 ;;
esac
if [ "$#" -gt 1 ]; then echo 'too many arguments' >&2; exit 64; fi
if [ "$(uname -s)" != Darwin ]; then
    echo 'UNAVAILABLE: Darwin snapshot API requires macOS'
    exit 77
fi
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/sosix-snapshot-api.XXXXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
"${CC:-cc}" -std=c11 -O0 -pthread -D_DARWIN_C_SOURCE -Wno-deprecated-declarations \
    -c "$root/src/runtime/runtime_process_owned.c" -o "$scratch/owner.o"
"${CC:-cc}" -std=c11 -O0 -pthread -Wl,-dead_strip \
    ${bound_flag:+$bound_flag} "$root/src/runtime/test/rt_sosix_darwin_snapshot_v1_selfcheck.c" "$scratch/owner.o" -o "$scratch/selfcheck"
"$scratch/selfcheck"
