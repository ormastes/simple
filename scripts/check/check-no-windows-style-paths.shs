#!/bin/sh
# Detect Windows-style (drive-letter / backslash) path literals in source.
#
# POLICY (user, 2026-09-02):
#   "code should not have c:\ style path. only mingw / linux style, and
#    lib path/file convert it for system."
#
# So product code carries only MinGW/POSIX form (/c/Users/..., forward
# slashes). Conversion to native `c:\Users\...` happens ONLY in the library
# boundary layer, never baked into call sites, config, or scripts.
#
# Applies to .spl, .shs, .sdn, .rs, .c, .h and friends. NOT to .cmd/.bat --
# those are cmd.exe scripts where native paths are correct and required.
#
# Verdict convention (doc/07_guide/infra/detector/detector_standard.md):
#   PASS  -- exit 0, always states how many files were examined
#   FAIL  -- exit 1, names offenders
#   ERROR -- exit 2, "nothing was checked"; a vacuous run is never a pass.
#
# --selftest runs first and is fatal. A ratchet baseline freezes the existing
# population so new violations fail while known debt is worked down.

set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
BASELINE="${ROOT}/scripts/check/windows_style_path_baseline.txt"

# Extensions to scan. .cmd/.bat deliberately excluded: native paths are
# correct there. .md excluded by default (prose legitimately shows examples);
# pass --include-docs to scan it too.
EXTS="spl shs sdn rs c h toml json yml yaml"

# Vendored / third-party trees are out of scope per CLAUDE.md Owned-Code Scope.
is_excluded() {
    case "$1" in
        */vendor/*|*/node_modules/*|*/target/*|*/build/*) return 0 ;;
        */miniaudio.h|*/stb_image.h|*/stb_truetype.h)     return 0 ;;
        *) return 1 ;;
    esac
}

# A Windows-style path literal is a drive letter followed by a colon and a
# backslash. Written as a bracket class so no shell escaping can collapse it,
# and so a lone drive-letter mention (C:) or a POSIX backslash does not match.
# In ERE a literal backslash must itself be escaped, so the pattern text needs
# TWO characters. `printf '\\'` yields ONE, which left a trailing incomplete
# escape and matched nothing -- the selftest caught exactly that.
BS=$(printf '\\')
# STRICT: require two path characters after the backslash. Without this the
# pattern matches ordinary shell and regex escape sequences -- a measured
# over-match of about 14 to 1 on .shs (165 escapes versus 12 real
# path-shaped hits). Known limit, stated rather than hidden: a
# single-character directory name is not flagged; widening it re-admits
# the ordinary escapes again.
PATTERN="[A-Za-z]:${BS}${BS}[A-Za-z0-9_]{2}"

# Windows line endings (CR at end of line). .cmd/.bat legitimately require
# CRLF and are excluded from the whole scan; everything else must be LF.
CR=$(printf '\r')
CRLF_PATTERN="${CR}$"

scan_file() {
    LC_ALL=C grep -nE "$PATTERN" "$1" 2>/dev/null
}

scan_file_crlf() {
    LC_ALL=C grep -nU "$CRLF_PATTERN" "$1" 2>/dev/null | head -1
}

selftest() {
    _d="$(mktemp -d 2>/dev/null || echo "${TMPDIR:-/tmp}/winpath.$$")"
    mkdir -p "$_d" || { echo "selftest: cannot create temp dir"; return 1; }
    _rc=0

    # (a) a drive-letter backslash path MUST be detected
    printf 'val p = "C:%sUsers%sormas"\n' "$BS" "$BS" > "$_d/a.spl"
    if [ -z "$(scan_file "$_d/a.spl")" ]; then
        echo "selftest FAIL: did not detect C:${BS} literal"; _rc=1
    fi

    # (b) lowercase drive letter MUST be detected
    printf 'val p = "d:%sfoo"\n' "$BS" > "$_d/b.spl"
    if [ -z "$(scan_file "$_d/b.spl")" ]; then
        echo "selftest FAIL: did not detect lowercase d:${BS}"; _rc=1
    fi

    # (c) NEGATIVE CONTROL: MinGW form must NOT be flagged. Without this the
    #     detector could match everything and still look green.
    printf 'val p = "/c/Users/ormas"\n' > "$_d/c.spl"
    if [ -n "$(scan_file "$_d/c.spl")" ]; then
        echo "selftest FAIL: flagged MinGW form /c/..."; _rc=1
    fi

    # (d) NEGATIVE CONTROL: a bare drive mention without a separator is not a
    #     path literal.
    printf 'val drive = "C:"\n' > "$_d/d.spl"
    if [ -n "$(scan_file "$_d/d.spl")" ]; then
        echo "selftest FAIL: flagged a bare drive letter"; _rc=1
    fi

    # (e) NEGATIVE CONTROL: a POSIX filename containing a backslash is legal
    #     and must not be flagged.
    printf 'val weird = "dir/we%sird"\n' "$BS" > "$_d/e.spl"
    if [ -n "$(scan_file "$_d/e.spl")" ]; then
        echo "selftest FAIL: flagged a legal POSIX backslash filename"; _rc=1
    fi

    # (g) CRLF line ending MUST be detected. The CR is injected via "$CR"
    #     rather than a \r escape: an earlier edit passed this text through a
    #     heredoc, which ate the CR and produced a fixture that could never
    #     fail. The selftest caught it.
    printf 'val a = 1%s\n' "$CR" > "$_d/g.spl"
    if [ -z "$(scan_file_crlf "$_d/g.spl")" ]; then
        echo "selftest FAIL: did not detect CRLF line ending"; _rc=1
    fi

    # (h) NEGATIVE CONTROL: an LF file must NOT be flagged as CRLF
    printf 'val a = 1\n' > "$_d/h.spl"
    if [ -n "$(scan_file_crlf "$_d/h.spl")" ]; then
        echo "selftest FAIL: flagged an LF file as CRLF"; _rc=1
    fi

    # (f) exclusion of vendored paths must actually work
    if ! is_excluded "src/runtime/vendor/x.c"; then
        echo "selftest FAIL: vendor path not excluded"; _rc=1
    fi
    if is_excluded "src/lib/common/path_pure.spl"; then
        echo "selftest FAIL: product path wrongly excluded"; _rc=1
    fi

    rm -rf "$_d" 2>/dev/null
    return $_rc
}

if ! selftest; then
    echo "FAIL - selftest failed; refusing to run"
    exit 1
fi

if [ "${1:-}" = "--selftest" ]; then
    echo "PASS - selftest only, 9 fixtures"
    exit 0
fi

GENERATE=0
[ "${1:-}" = "--generate-baseline" ] && GENERATE=1

# Build the candidate file list.
#
# PERFORMANCE: a per-file `grep` over ~46,000 files is far too slow -- the
# first version of this script was killed mid-scan and exited 0 with NO
# verdict line, which is exactly the vacuous pass this convention exists to
# prevent. Batch the paths through xargs so grep is invoked a handful of
# times instead of tens of thousands.
LISTFILE="${TMPDIR:-/tmp}/winpath_list.$$"
HITFILE="${TMPDIR:-/tmp}/winpath_hits.$$"
CRLFFILE="${TMPDIR:-/tmp}/winpath_crlf.$$"
: > "$LISTFILE"; : > "$HITFILE"; : > "$CRLFFILE"

for e in $EXTS; do
    git -C "$ROOT" ls-files "*.$e" 2>/dev/null
done | while IFS= read -r f; do
    is_excluded "$f" && continue
    [ -f "$ROOT/$f" ] || continue
    printf '%s\n' "$f"
done > "$LISTFILE"

examined=$(grep -c . "$LISTFILE" 2>/dev/null); examined=${examined:-0}

if [ "$examined" -gt 0 ]; then
    # Drive-letter backslash literals.
    ( cd "$ROOT" && tr '\n' '\0' < "$LISTFILE" \
        | xargs -0 -r env LC_ALL=C grep -nE "$PATTERN" 2>/dev/null ) > "$HITFILE" 2>/dev/null || true
    # Windows line endings.
    ( cd "$ROOT" && tr '\n' '\0' < "$LISTFILE" \
        | xargs -0 -r env LC_ALL=C grep -lU "$CRLF_PATTERN" 2>/dev/null ) > "$CRLFFILE" 2>/dev/null || true
fi

CRLF_N=$(grep -c . "$CRLFFILE" 2>/dev/null); CRLF_N=${CRLF_N:-0}
rm -f "$LISTFILE"

# Non-vacuity: a run that examined nothing is an ERROR, never a pass.
if [ "$examined" -eq 0 ]; then
    rm -f "$HITFILE" "$CRLFFILE"
    echo "ERROR - nothing was checked (no candidate files found)"
    exit 2
fi

# Offender identity is file:line-content, reduced to file for the baseline so
# line drift does not churn it.
CUR=$(cut -d: -f1 "$HITFILE" 2>/dev/null | sort -u)
CUR_COUNT=$(printf '%s\n' "$CUR" | grep -c . 2>/dev/null || echo 0)
TOTAL_HITS=$(grep -c . "$HITFILE" 2>/dev/null); TOTAL_HITS=${TOTAL_HITS:-0}

if [ "$GENERATE" -eq 1 ]; then
    printf '%s\n' "$CUR" | grep . > "$BASELINE"
    rm -f "$HITFILE" "$CRLFFILE"
    echo "PASS - baseline regenerated: $CUR_COUNT file(s), $examined examined"
    exit 0
fi

if [ ! -f "$BASELINE" ]; then
    rm -f "$HITFILE" "$CRLFFILE"
    echo "FAIL - $examined file(s) examined, $CUR_COUNT offender file(s), $TOTAL_HITS hit(s); no baseline exists (run --generate-baseline once, reviewed)"
    exit 1
fi

NEW=$(printf '%s\n' "$CUR" | grep . | comm -23 - "$BASELINE" 2>/dev/null)
STALE=$(printf '%s\n' "$CUR" | grep . | comm -13 - "$BASELINE" 2>/dev/null)
NEW_N=$(printf '%s\n' "$NEW" | grep -c . 2>/dev/null || echo 0)
STALE_N=$(printf '%s\n' "$STALE" | grep -c . 2>/dev/null || echo 0)

rm -f "$HITFILE" "$CRLFFILE"

if [ "$NEW_N" -gt 0 ] || [ "$STALE_N" -gt 0 ]; then
    echo "FAIL - $examined file(s) examined, $CUR_COUNT offender file(s), $TOTAL_HITS hit(s), $CRLF_N CRLF file(s); $NEW_N new, $STALE_N stale"
    [ "$NEW_N" -gt 0 ] && { echo "  NEW (must be fixed):"; printf '%s\n' "$NEW" | grep . | sed 's/^/    /'; }
    [ "$STALE_N" -gt 0 ] && { echo "  STALE (fixed; remove from baseline):"; printf '%s\n' "$STALE" | grep . | sed 's/^/    /'; }
    exit 1
fi

echo "PASS - $examined file(s) examined, $CUR_COUNT baselined offender file(s), 0 new, 0 stale, $CRLF_N CRLF file(s)"
exit 0
