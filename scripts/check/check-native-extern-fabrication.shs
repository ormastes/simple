#!/bin/sh
# Regression gate for AOT (`native-build`) host-target `@extern fn` fabrication.
#
# WHY THIS EXISTS: `bin/simple test` hard-defaults to the tree-walk interpreter
# and has no AOT mode (TestExecutionMode has Native/Process/Safe/Container
# variants but "Native" there means unsandboxed *process execution*, not the
# LLVM AOT backend) -- so no `*_spec.spl` can ever observe this lane. Only a
# script that actually drives `simple native-build` / `simple compile --native`
# can fence it.
#
# Bug: doc/08_tracking/bug/native_link_fabricates_weak_empty_extern_definitions_2026-08-01.md
#
# Background: an `@extern fn` with NO implementation anywhere should fail the
# link (or at minimum crash loudly at the call site). Instead, native codegen
# emits a small DEFINED stub body for the missing symbol, so the link succeeds
# silently and the program runs to completion returning a fabricated value
# (observed: a zero/garbage return) instead of failing. A prior fix landed a
# link-time guard, `check_no_fabricated_extern_definitions`
# (`src/compiler_rust/compiler/src/linker/native_binary/stubs.rs`), but the
# deployed `bin/simple` in this checkout IS the Rust seed (confirmed via its
# `--version` seed banner), and that guard is NOT reliably in its own request
# path: `native-build` routes via `driver/src/cli/native_build.rs:34,610` to
# `NativeProjectBuilder` (`pipeline/native_project`), which has its own
# `linker.rs` that never calls the guard. `check_no_fabricated_extern_definitions`
# is called only from `linker/native_binary/builder.rs:95`, reachable only via
# `pipeline/execution.rs:801,925` (the single-module path) -- a different
# pipeline than the one `native-build` actually drives. Even if that pipeline
# were reached, the guard's predicate (`*ty == 'W' && !*has_size`,
# `stubs.rs:551-553`) could NOT match a strong (`T`), size-3 symbol -- so
# there are two independent reasons this guard never fires here, not one. The
# pure-Simple self-hosted compiler's own HOST-target link path
# (`link_llvm_native` in src/compiler/70.backend/backend/llvm_native_link.spl:1045)
# is a SEPARATE, untested-by-this-fence code path: `simpleos_check_no_fabricated_rt_stubs`
# is wired ONLY into the SimpleOS freestanding branches
# (`link_simpleos_x86_64/arm64/riscv64/riscv32`) a few lines above, never into
# the generic hosted-C-runtime branch that `link_llvm_native` itself takes --
# but this script exercises the deployed seed binary, not that path, so it
# says nothing about whether `link_llvm_native` has the same gap.
#
# Verified 2026-08-08: `SIMPLE_NO_STUB_FALLBACK=1` makes NO difference on this
# path (it is read only inside the SimpleOS-only guard). The fabricated symbol
# links as a STRONG (`T`, not even weak) 3-byte defined text-section symbol,
# so `nm -u` never sees it and no undefined-symbol check can catch it. This
# script therefore asserts the CURRENT (defective) behaviour as KNOWN-OPEN --
# see rationale in check-native-enum-match-payload.shs for the pattern -- so a
# future fix (the symbol becomes correctly unresolved, or the build fails)
# flips this gate to a hard PASS/FAIL and is reported loudly, not silently
# absorbed.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

# --- Build-failure reporting.
#
# WHY A DEDICATED REPORTER: every native-build log this script produces --
# control AND both absent-case ([default], [strict]) logs -- is ~1200 lines of
# seed banner, lint warnings and gc-warnings, and the ACTUAL error is the LAST
# few lines. Printing `sed -n '1,20p'` surfaces nothing but the "this is a
# bootstrap seed" banner and an `export use *` lint warning, so an operator
# reads a fabrication-shaped verdict for what is really e.g. `native-build
# worker timed out after 7200s`. Measured 2026-08-17: 1181-line log, real error
# on lines 1178-1181. This reporter prints the TAIL.
#
# 2026-08-18: originally `report_ctrl_failure`, wired only into the control
# branch. The two absent-case branches kept their head-print and were therefore
# still undiagnosable; they are now routed through here too. `$3` names which
# build the log belongs to so the operator is not told "control" about a
# [strict] failure.
report_build_failure() {
    _log="$1"
    _rc="$2"
    _what="${3:-control}"
    _lines="$(wc -l <"$_log" 2>/dev/null || echo 0)"
    echo "  build exit=$_rc, log=$_log ($_lines lines)"
    echo "  --- last 25 lines of the $_what build log (the real error lives HERE,"
    echo "      not at the head: the head is seed banner + lint warnings) ---"
    tail -n 25 "$_log" 2>/dev/null | sed 's/^/  | /'
    echo "  --- end of $_what build log ---"
    if grep -q "worker timed out after" "$_log" 2>/dev/null; then
        echo "  DIAGNOSIS: this is a native-build WORKER TIMEOUT, not extern fabrication."
        echo "             This gate cannot pass until native-build itself completes."
    fi
}

# --- Symbol classification (2026-08-18 fail-open fix).
#
# The previous matcher was `nm -S "$bin" | grep " $SYM\$"`, which is fail-open
# in TWO independent ways, both reproduced on this host:
#
#   1. NAME MANGLING. The in-process Rust native lane
#      (`SIMPLE_NATIVE_BUILD_RUST=1`) emits the fabricated definition under a
#      module-qualified name:
#        0000000000401364 0000000000000006 T
#          native_extern_fabrication_probe__main__lane_definitely_absent_probe
#      `" lane_definitely_absent_probe$"` requires a SPACE immediately before
#      the probe name, so a mangled definition never matched -- the guard fell
#      into its "UNEXPECTED third outcome" FAIL. That FAIL was ACCIDENTAL, not
#      a detection: it fired because the guard could not see the very thing it
#      exists to catch.
#   2. WEAK DEFINITIONS. The header text above records the symbol as STRONG
#      (`T`), but the fabricated stub is emitted `W` (weak defined) on other
#      lanes. A weak DEFINITION satisfies the link and runs a fabricated body
#      exactly like a strong one, so `W`/`V` must count as fabrication.
#
# Classification rule, by nm's own semantics (`man nm`): a symbol is
# FABRICATED iff it is DEFINED in the binary. Uppercase classes (T W V D B R
# S ...) are definitions; lowercase `u`/`w`/`v` and `U` are UNDEFINED and must
# NOT count -- an undefined symbol is the CORRECT, non-fabricated state. We
# therefore ask nm directly with `--defined-only` rather than maintaining a
# hand-written letter allowlist that can silently drop a class again.
#
# Matching is suffix-based (`name == SYM` or `name` ends in `<sep>SYM` for the
# `_`/`.`/`$` separators real manglers use), never a bare substring, so an
# unrelated symbol that merely CONTAINS the probe name is not miscounted.
find_defined_symbol_line() {
    _bin="$1"
    _sym="$2"
    nm -S --defined-only "$_bin" 2>/dev/null | awk -v s="$_sym" '
        {
            n = $NF
            if (n == s) { print; exit }
            L = length(n); M = length(s)
            if (L > M && substr(n, L - M + 1) == s) {
                c = substr(n, L - M, 1)
                if (c == "_" || c == "." || c == "$") { print; exit }
            }
        }'
}

# The class letter is the field immediately before the name -- reported in the
# verdict so an operator sees WHICH kind of definition was fabricated (a weak
# `W` stub and a strong `T` stub are the same defect but different evidence).
symbol_class_of_line() {
    printf '%s\n' "$1" | awk '{ print $(NF - 1) }'
}

find_undefined_symbol_line() {
    _bin="$1"
    _sym="$2"
    nm -u "$_bin" 2>/dev/null | awk -v s="$_sym" '
        {
            n = $NF
            if (n == s) { print; exit }
            L = length(n); M = length(s)
            if (L > M && substr(n, L - M + 1) == s) {
                c = substr(n, L - M, 1)
                if (c == "_" || c == "." || c == "$") { print; exit }
            }
        }'
}

# --- Selftest (FATAL, runs before any scan).
#     Fixtures prove the control-failure path actually surfaces the real error.
if [ "${1:-}" = "--selftest" ]; then
    st_dir="$(mktemp -d)"
    trap 'rm -rf "$st_dir"' EXIT HUP INT TERM
    st_fail=0
    st_checked=0

    # Fixture 1: a long log whose real error is only at the TAIL (the measured
    # 2026-08-17 shape). The head-only reporter this replaced printed none of it.
    f1="$st_dir/long.log"
    i=0
    while [ "$i" -lt 1200 ]; do
        echo "warning: irrelevant seed/lint noise line $i" >>"$f1"
        i=$((i + 1))
    done
    echo "error: native-build worker timed out after 7200s before producing a binary." >>"$f1"
    out1="$(report_build_failure "$f1" 255)"
    st_checked=$((st_checked + 1))
    case "$out1" in
        *"worker timed out after 7200s"*) ;;
        *) echo "SELFTEST FAIL — tail-of-log fixture: real error never reached stdout"; st_fail=1 ;;
    esac
    st_checked=$((st_checked + 1))
    case "$out1" in
        *"this is a native-build WORKER TIMEOUT"*) ;;
        *) echo "SELFTEST FAIL — tail-of-log fixture: timeout was not diagnosed"; st_fail=1 ;;
    esac

    # Fixture 2: a short log must be surfaced in full (no regression for the
    # small-log case the old head-print handled correctly).
    f2="$st_dir/short.log"
    printf 'line-one\nerror: something small and real\n' >"$f2"
    out2="$(report_build_failure "$f2" 1)"
    st_checked=$((st_checked + 1))
    case "$out2" in
        *"error: something small and real"*) ;;
        *) echo "SELFTEST FAIL — short-log fixture: error not surfaced"; st_fail=1 ;;
    esac
    st_checked=$((st_checked + 1))
    case "$out2" in
        *"this is a native-build WORKER TIMEOUT"*)
            echo "SELFTEST FAIL — short-log fixture: timeout falsely diagnosed"; st_fail=1 ;;
        *) ;;
    esac

    # Fixture 3: the [default] absent-case branch. Same ~1200-line shape as the
    # control log, because it is produced by the same native-build invocation.
    # Two assertions: the tail-borne error reaches stdout, AND the report names
    # the branch (an operator must not be told "control" about an absent-case
    # failure). A third assertion proves the fixture is genuinely head-hostile,
    # i.e. that the `sed -n '1,20p'` this replaced really would have surfaced
    # nothing -- otherwise the other two could pass vacuously.
    f3="$st_dir/absent-default.log"
    i=0
    while [ "$i" -lt 1200 ]; do
        echo "warning: [bootstrap seed] export use * lint noise line $i" >>"$f3"
        i=$((i + 1))
    done
    echo "error: native-build worker timed out after 7200s (absent-default)" >>"$f3"
    out3="$(report_build_failure "$f3" 255 "[default] absent-case")"
    st_checked=$((st_checked + 1))
    case "$out3" in
        *"worker timed out after 7200s (absent-default)"*) ;;
        *) echo "SELFTEST FAIL — [default] fixture: real error never reached stdout"; st_fail=1 ;;
    esac
    st_checked=$((st_checked + 1))
    case "$out3" in
        *"[default] absent-case build log"*) ;;
        *) echo "SELFTEST FAIL — [default] fixture: report did not name the branch"; st_fail=1 ;;
    esac
    st_checked=$((st_checked + 1))
    head3="$(sed -n '1,20p' "$f3")"
    case "$head3" in
        *"absent-default"*)
            echo "SELFTEST FAIL — [default] fixture is not head-hostile; the assertions above are vacuous"
            st_fail=1 ;;
        *) ;;
    esac

    # Fixture 4: the [strict] absent-case branch, with a NON-timeout error. It
    # must be surfaced, and it must NOT be falsely diagnosed as a worker timeout.
    f4="$st_dir/absent-strict.log"
    i=0
    while [ "$i" -lt 1200 ]; do
        echo "warning: [bootstrap seed] export use * lint noise line $i" >>"$f4"
        i=$((i + 1))
    done
    echo "error: linker invocation failed: cannot find -lfoo (absent-strict)" >>"$f4"
    out4="$(report_build_failure "$f4" 1 "[strict] absent-case")"
    st_checked=$((st_checked + 1))
    case "$out4" in
        *"cannot find -lfoo (absent-strict)"*) ;;
        *) echo "SELFTEST FAIL — [strict] fixture: real error never reached stdout"; st_fail=1 ;;
    esac
    st_checked=$((st_checked + 1))
    case "$out4" in
        *"this is a native-build WORKER TIMEOUT"*)
            echo "SELFTEST FAIL — [strict] fixture: non-timeout error falsely diagnosed as a timeout"
            st_fail=1 ;;
        *) ;;
    esac
    st_checked=$((st_checked + 1))
    case "$out4" in
        *"[strict] absent-case build log"*) ;;
        *) echo "SELFTEST FAIL — [strict] fixture: report did not name the branch"; st_fail=1 ;;
    esac

    # --- Fixtures 5..11: symbol classification (2026-08-18).
    #     These synthesize real ELF objects with a C compiler -- no working
    #     Simple compiler and no native-build lane is required, deliberately:
    #     a guard's selftest must not depend on the toolchain it is fencing.
    #     They exist so the two reproduced fail-open holes (weak class dropped,
    #     mangled name unmatched) cannot silently return.
    st_cc=""
    for _c in cc clang gcc; do
        if command -v "$_c" >/dev/null 2>&1; then st_cc="$_c"; break; fi
    done
    if [ -z "$st_cc" ]; then
        # Absence of a compiler is absence of evidence, never a pass.
        echo "ERROR — nothing was checked: no C compiler (cc/clang/gcc) to build the"
        echo "        symbol-classification fixtures; their assertions would be vacuous."
        exit 2
    fi

    st_sym="lane_definitely_absent_probe"

    # Fixture 5: WEAK (`W`) defined stub, unmangled. This is the exact shape
    # the old `nm -S | grep " sym$"` matcher... did match, but which a
    # letter-allowlist refactor could drop; asserting the class letter keeps
    # `W` pinned as fabrication.
    cat >"$st_dir/weak.c" <<EOF
__attribute__((weak)) int $st_sym(void) { return 3; }
int main(void) { return $st_sym(); }
EOF
    "$st_cc" -o "$st_dir/weak.bin" "$st_dir/weak.c" >/dev/null 2>&1
    w_line="$(find_defined_symbol_line "$st_dir/weak.bin" "$st_sym")"
    st_checked=$((st_checked + 1))
    if [ -z "$w_line" ]; then
        echo "SELFTEST FAIL — weak fixture: a WEAK ('W') DEFINITION of '$st_sym' was not"
        echo "                classified as fabrication. A weak definition satisfies the link"
        echo "                and runs a fabricated body exactly like a strong one."
        st_fail=1
    else
        st_checked=$((st_checked + 1))
        case "$(symbol_class_of_line "$w_line")" in
            W|w) ;;
            *) echo "SELFTEST FAIL — weak fixture: class letter not reported as W (got '$(symbol_class_of_line "$w_line")')"; st_fail=1 ;;
        esac
    fi

    # Fixture 6: WEAK definition under a MODULE-MANGLED name -- the reproduced
    # in-process-Rust-lane shape (`<module>__<entry>__<sym>`). The old
    # space-anchored grep could never match this.
    cat >"$st_dir/mangled_weak.c" <<EOF
__attribute__((weak)) int probe_module__main__$st_sym(void) { return 3; }
int main(void) { return probe_module__main__$st_sym(); }
EOF
    "$st_cc" -o "$st_dir/mangled_weak.bin" "$st_dir/mangled_weak.c" >/dev/null 2>&1
    st_checked=$((st_checked + 1))
    if [ -z "$(find_defined_symbol_line "$st_dir/mangled_weak.bin" "$st_sym")" ]; then
        echo "SELFTEST FAIL — mangled-weak fixture: a module-mangled WEAK definition of"
        echo "                '$st_sym' was not classified as fabrication (the exact"
        echo "                fail-open reproduced 2026-08-18 on SIMPLE_NATIVE_BUILD_RUST=1)."
        st_fail=1
    fi

    # Fixture 7: STRONG (`T`) definition under a mangled name.
    cat >"$st_dir/mangled_strong.c" <<EOF
int probe_module__main__$st_sym(void) { return 3; }
int main(void) { return probe_module__main__$st_sym(); }
EOF
    "$st_cc" -o "$st_dir/mangled_strong.bin" "$st_dir/mangled_strong.c" >/dev/null 2>&1
    ms_line="$(find_defined_symbol_line "$st_dir/mangled_strong.bin" "$st_sym")"
    st_checked=$((st_checked + 1))
    case "${ms_line:+$(symbol_class_of_line "$ms_line")}" in
        T|t) ;;
        *) echo "SELFTEST FAIL — mangled-strong fixture: 'T' definition not classified (got '${ms_line:-<none>}')"; st_fail=1 ;;
    esac

    # Fixture 8: WEAK OBJECT (`V`) definition -- a fabricated data symbol.
    cat >"$st_dir/weakobj.c" <<EOF
__attribute__((weak)) int $st_sym = 3;
int main(void) { return $st_sym; }
EOF
    "$st_cc" -o "$st_dir/weakobj.bin" "$st_dir/weakobj.c" >/dev/null 2>&1
    st_checked=$((st_checked + 1))
    if [ -z "$(find_defined_symbol_line "$st_dir/weakobj.bin" "$st_sym")" ]; then
        echo "SELFTEST FAIL — weak-object fixture: a 'V' (weak object) DEFINITION of"
        echo "                '$st_sym' was not classified as fabrication."
        st_fail=1
    fi

    # Fixture 9 (must NOT match): an UNDEFINED reference is the CORRECT,
    # non-fabricated state. If this ever classifies as fabrication the gate
    # would report a fix as the bug.
    cat >"$st_dir/undef.c" <<EOF
extern int $st_sym(void);
int main(void) { return $st_sym(); }
EOF
    "$st_cc" -c -o "$st_dir/undef.o" "$st_dir/undef.c" >/dev/null 2>&1
    st_checked=$((st_checked + 1))
    if [ -n "$(find_defined_symbol_line "$st_dir/undef.o" "$st_sym")" ]; then
        echo "SELFTEST FAIL — undefined fixture: a 'U' (undefined) reference to '$st_sym'"
        echo "                was miscounted as a fabricated DEFINITION."
        st_fail=1
    fi
    st_checked=$((st_checked + 1))
    if [ -z "$(find_undefined_symbol_line "$st_dir/undef.o" "$st_sym")" ]; then
        echo "SELFTEST FAIL — undefined fixture: 'nm -u' lookup failed to see the undefined '$st_sym'"
        st_fail=1
    fi

    # Fixture 10 (must NOT match): a different symbol that merely CONTAINS the
    # probe name -- proves the suffix match is not a bare substring match.
    cat >"$st_dir/similar.c" <<EOF
int ${st_sym}_helper(void) { return 3; }
int main(void) { return ${st_sym}_helper(); }
EOF
    "$st_cc" -o "$st_dir/similar.bin" "$st_dir/similar.c" >/dev/null 2>&1
    st_checked=$((st_checked + 1))
    if [ -n "$(find_defined_symbol_line "$st_dir/similar.bin" "$st_sym")" ]; then
        echo "SELFTEST FAIL — similar-name fixture: '${st_sym}_helper' was miscounted as '$st_sym'"
        st_fail=1
    fi

    # Fixture 11 (non-vacuity): a binary with NO such symbol at all must yield
    # nothing, so the must-match fixtures above cannot be passing by accident.
    cat >"$st_dir/clean.c" <<EOF
int main(void) { return 0; }
EOF
    "$st_cc" -o "$st_dir/clean.bin" "$st_dir/clean.c" >/dev/null 2>&1
    st_checked=$((st_checked + 1))
    if [ -n "$(find_defined_symbol_line "$st_dir/clean.bin" "$st_sym")" ]; then
        echo "SELFTEST FAIL — clean fixture: matcher reports a symbol in a binary that has none"
        st_fail=1
    fi

    if [ "$st_checked" -eq 0 ]; then
        echo "ERROR — nothing was checked"
        exit 2
    fi
    if [ "$st_fail" -ne 0 ]; then
        echo "FAIL — selftest: $st_checked fixture assertion(s) run, at least one failed"
        exit 1
    fi
    echo "PASS — selftest: $st_checked fixture assertion(s) checked, 0 failed"
    exit 0
fi

SIMPLE_BINARY="${SIMPLE_BINARY:-bin/simple}"
WORK_DIR="${WORK_DIR:-/tmp/check-native-extern-fabrication.$$}"
ABSENT_FIXTURE="test/fixtures/native_extern_fabrication_probe/main.spl"
CONTROL_FIXTURE="test/fixtures/native_extern_fabrication_probe/control.spl"
ABSENT_SYMBOL="lane_definitely_absent_probe"

test -x "$SIMPLE_BINARY"
mkdir -p "$WORK_DIR"
trap 'rm -rf "$WORK_DIR"' EXIT HUP INT TERM

fail=0

# --- Control: an entry with NO extern reference must still build & run
#     correctly under native-build, so this gate cannot be vacuously green
#     because native-build itself is broken.
ctrl_bin="$WORK_DIR/control"
ctrl_log="$WORK_DIR/control.log"
# rc is captured on its own line, never read through a pipe (a pipeline's $? is
# the LAST element's status and has produced false greens in this repo before).
ctrl_build_rc=0
env -u SIMPLE_BOOTSTRAP "$SIMPLE_BINARY" native-build \
    --source test/fixtures --entry-closure --entry "$CONTROL_FIXTURE" \
    --cache-dir "$WORK_DIR/cache-ctrl" --output "$ctrl_bin" >"$ctrl_log" 2>&1 || ctrl_build_rc=$?
if [ "$ctrl_build_rc" -ne 0 ]; then
    echo "FAIL — control fixture (no extern) no longer builds under native-build"
    report_build_failure "$ctrl_log" "$ctrl_build_rc" "control"
    fail=1
else
    ctrl_out="$(timeout 20 "$ctrl_bin" 2>>"$ctrl_log" || true)"
    ctrl_rc=0
    timeout 20 "$ctrl_bin" >/dev/null 2>>"$ctrl_log" || ctrl_rc=$?
    if [ "$ctrl_out" != "ctrl-ok" ] || [ "$ctrl_rc" -ne 7 ]; then
        echo "FAIL — control fixture output/exit regressed (native-build itself broken)"
        echo "  expected: stdout=ctrl-ok exit=7"
        echo "  actual:   stdout=$ctrl_out exit=$ctrl_rc"
        fail=1
    fi
fi

# --- Known-open gap: a genuinely-absent (never implemented anywhere) @extern
#     fn should fail the link or crash at the call site. Test BOTH with and
#     without SIMPLE_NO_STUB_FALLBACK=1 -- a defect that only manifests with
#     the guard off would be a materially different (more defensible) finding
#     than one that manifests even with the strict guard on.
check_absent_case() {
    label="$1"
    extra_env="$2"
    bin_path="$WORK_DIR/absent-$label"
    log_path="$WORK_DIR/absent-$label.log"
    build_rc=0
    env -u SIMPLE_BOOTSTRAP $extra_env "$SIMPLE_BINARY" native-build \
        --source test/fixtures --entry-closure --entry "$ABSENT_FIXTURE" \
        --cache-dir "$WORK_DIR/cache-$label" --output "$bin_path" >"$log_path" 2>&1 || build_rc=$?

    if [ "$build_rc" -ne 0 ]; then
        # A nonzero exit alone does not prove the expected refusal happened --
        # any unrelated build breakage (toolchain missing, fixture path wrong,
        # unrelated codegen crash) also exits nonzero and must not be read as
        # "the fabrication gap closed". Require the log to actually name the
        # absent symbol before treating this as the expected refusal.
        if ! grep -q "$ABSENT_SYMBOL" "$log_path"; then
            echo "FAIL — [$label] native-build exited $build_rc, but the log never"
            echo "       mentions '$ABSENT_SYMBOL' -- this looks like an UNRELATED build"
            echo "       failure, not the expected extern-fabrication refusal. Investigate"
            echo "       rather than treating this as the gap having closed."
            report_build_failure "$log_path" "$build_rc" "[$label] absent-case"
            fail=1
            return 0
        fi
        echo "NOTE — [$label] native-build now REFUSES the genuinely-absent extern"
        echo "       (build exit $build_rc) and the log names '$ABSENT_SYMBOL'. The"
        echo "       codegen-side fabrication gap in"
        echo "       doc/08_tracking/bug/native_link_fabricates_weak_empty_extern_definitions_2026-08-01.md"
        echo "       may have closed for this env combination. Promote this branch"
        echo "       to a hard PASS assertion (require nonzero exit + a diagnostic"
        echo "       naming '$ABSENT_SYMBOL')."
        return 0
    fi

    # Build succeeded (exit 0) despite the extern never being implemented
    # anywhere. Confirm the fabrication with hard nm evidence rather than
    # trusting the absence of a build error.
    if ! [ -x "$bin_path" ]; then
        echo "FAIL — [$label] native-build exited 0 but produced no runnable binary (unexpected)"
        fail=1
        return 0
    fi

    defined_line="$(find_defined_symbol_line "$bin_path" "$ABSENT_SYMBOL")"
    undefined_line="$(find_undefined_symbol_line "$bin_path" "$ABSENT_SYMBOL")"

    if [ -z "$defined_line" ]; then
        echo "FAIL — [$label] native-build exited 0, no fabricated symbol found by nm, and no"
        echo "       diagnostic was printed. This is an UNEXPECTED third outcome — investigate"
        echo "       manually rather than trusting either known state."
        report_build_failure "$log_path" "$build_rc" "[$label] absent-case"
        fail=1
        return 0
    fi

    defined_class="$(symbol_class_of_line "$defined_line")"
    run_out="$(timeout 20 "$bin_path" 2>>"$log_path" || true)"
    echo "KNOWN-OPEN — [$label] native-build fabricates a DEFINED symbol (nm class"
    echo "             '$defined_class') for the never-implemented extern"
    echo "             '$ABSENT_SYMBOL' instead of failing:"
    echo "             nm -S: $defined_line"
    echo "             nm -u: ${undefined_line:-<none -- symbol is NOT undefined, confirming fabrication>}"
    echo "             program ran to completion: $run_out"
}

check_absent_case "default" ""
check_absent_case "strict" "SIMPLE_NO_STUB_FALLBACK=1"

