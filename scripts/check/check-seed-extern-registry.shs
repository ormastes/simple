#!/bin/sh
# Guard against unregistered extern functions the seed interpreter must resolve.
#
# The deployed bin/simple is a Rust seed that INTERPRETS pure-Simple source.
# When interpreted code calls `extern fn rt_something(...)` that the seed's Rust
# registry does not know, native-build fails with "semantic: unknown extern
# function: rt_something" (repo-wide outage, as with rt_array_len_safe: 51 call
# sites, zero seed registration).
#
# SCOPE (widened 2026-08-23 — see the audit note below).
#   section (a) src/compiler  — GATED, ratcheted against seed_extern_registry_baseline.txt
#   section (b) src/lib       — GATED, ratcheted against seed_extern_lib_baseline.txt
#   section (c) src/app       — informational (the worker interprets few app modules)
#
# WHY src/lib WAS ADDED (guard-vacuity audit, doc/09_report/guard_vacuity_audit_2026-08-23.md).
# The original header asserted "only src/compiler is load-bearing". That is
# false as stated: per .claude/rules/commands.md the stdlib is read as SOURCE on
# every process start (measured: 82 opens of src/lib/**.spl, zero .smf), so the
# seed interprets stdlib externs on exactly the same path. Measured at
# 74f2b254081 the unscanned population was 2,097 distinct `extern fn rt_*` names
# in src/lib, of which 632 are unregistered in the seed — 7.3x the src/compiler
# population the guard did look at, and entirely invisible to it. This is the
# same defect class as check-cow-alias-hotpath.shs hardcoding $ROOT/src/compiler
# (fixed 50a379f83b7) and check-untyped-return-value.shs skipping every
# callback-taking function (fixed da90106fcd6).
# The 632 are FROZEN in a reviewed baseline, exactly like section (a)'s 177.
# This does not weaken anything: the src/compiler bar is unchanged, and a new
# unregistered stdlib extern now fails where it previously could not be seen.
#
# OVER-APPROXIMATION: a plain declaration scan over-counts. Some declared externs
# sit OFF the worker's narrow interpreted graph (e.g. inputs to the
# src/compiler/90.tools/sffi_gen code GENERATOR). Both gated sections therefore
# RATCHET rather than bar: they fail only on NEW unregistered externs, and
# — two-directionally, like check-test-tree-divergence.shs — on a STALE baseline
# entry that is no longer unregistered, because a baseline that no longer
# describes the tree is how a ratchet silently stops ratcheting.
#
# NON-VACUITY IS ABSOLUTE (hardened 2026-08-23).
# Before this change the guard could report success having examined nothing:
# run against an empty tree it printed
#   "seed_extern_registry_mode=informational (no baseline; exit 0)"  exit 0
# — a PASS with zero declarations collected and zero registry tokens read. A
# missing baseline, a moved source tree, or a broken extractor all laundered
# into green. Now every one of those is ERROR (exit 2): absence of evidence is
# not evidence of absence.
#
# Verdict is always the LAST line of stdout:
#   PASS  — <n> extern(s) checked, 0 new, 0 stale        exit 0
#   FAIL  — <n> extern(s) checked, ...                   exit 1
#   ERROR — nothing was checked (<reason>)               exit 2
#
# --selftest runs fixture checks (fatal, includes MUST-FAIL fixtures) and is run
# automatically before every real scan.
# --generate-baseline rewrites both baselines from the current tree. For
# REVIEWED updates only — read the diff; regenerating to clear a FAIL hides
# real new debt.
set -u
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

MODE=real
while [ $# -gt 0 ]; do
  case "$1" in
    --selftest) MODE=selftest; shift ;;
    --generate-baseline) MODE=generate; shift ;;
    --selftest-only) MODE=selftest; shift ;;
    *) echo "unknown argument: $1" >&2
       echo "ERROR — nothing was checked (bad argument)"; exit 2 ;;
  esac
done

BASELINE_COMP="scripts/check/seed_extern_registry_baseline.txt"
BASELINE_LIB="scripts/check/seed_extern_lib_baseline.txt"

# --- extractors -------------------------------------------------------------
# collect <tree-root> <dir>  -> sorted unique rt_* extern names
collect() {
  grep -rhoE "(pub )?extern fn (rt_[a-z0-9_]+)" "$1/$2" --include='*.spl' 2>/dev/null \
    | awk '{print $NF}' | sort -u
}
# registry <tree-root> -> every rt_* token appearing in the non-vendor Rust seed
registry() {
  grep -rhoE "rt_[a-z0-9_]+" "$1/src/compiler_rust" \
    --exclude-dir=vendor --exclude-dir=target 2>/dev/null | sort -u
}

# scan_tree <tree-root> <workdir> [<comp-baseline>] [<lib-baseline>]
# Prints the full report and the verdict line. Returns 0/1/2.
scan_tree() {
  _t=$1; _w=$2
  _bc=${3:-$_t/$BASELINE_COMP}
  _bl=${4:-$_t/$BASELINE_LIB}

  collect "$_t" src/compiler >"$_w/comp"
  collect "$_t" src/lib      >"$_w/lib"
  collect "$_t" src/app      >"$_w/app"
  registry "$_t"             >"$_w/reg"

  _n_comp=$(wc -l <"$_w/comp" | tr -d ' ')
  _n_lib=$(wc -l <"$_w/lib" | tr -d ' ')
  _n_app=$(wc -l <"$_w/app" | tr -d ' ')
  _n_reg=$(wc -l <"$_w/reg" | tr -d ' ')

  # --- non-vacuity gates ---------------------------------------------------
  # A zero here never means "clean". It means the extractor, the source tree or
  # the seed crate is not where this guard thinks it is.
  if [ "$_n_reg" -eq 0 ]; then
    echo "ERROR — nothing was checked (no rt_* tokens found in $_t/src/compiler_rust: seed crate missing or extractor broken)"
    return 2
  fi
  if [ "$_n_comp" -eq 0 ]; then
    echo "ERROR — nothing was checked (no 'extern fn rt_*' declarations under $_t/src/compiler)"
    return 2
  fi
  if [ "$_n_lib" -eq 0 ]; then
    echo "ERROR — nothing was checked (no 'extern fn rt_*' declarations under $_t/src/lib)"
    return 2
  fi

  # unregistered = declared but absent from the registry token set
  comm -23 "$_w/comp" "$_w/reg" >"$_w/comp_unreg"
  comm -23 "$_w/lib"  "$_w/reg" >"$_w/lib_unreg"
  comm -23 "$_w/app"  "$_w/reg" >"$_w/app_unreg"

  if [ "$MODE" = generate ]; then
    cp "$_w/comp_unreg" "$_bc"
    cp "$_w/lib_unreg"  "$_bl"
    echo "wrote $_bc ($(wc -l <"$_bc" | tr -d ' ') entries)"
    echo "wrote $_bl ($(wc -l <"$_bl" | tr -d ' ') entries)"
  fi

  [ -f "$_bc" ] || { echo "ERROR — nothing was checked (missing baseline: $_bc)"; return 2; }
  [ -f "$_bl" ] || { echo "ERROR — nothing was checked (missing baseline: $_bl)"; return 2; }

  sort -u "$_bc" >"$_w/bc"; sort -u "$_bl" >"$_w/bl"

  comm -13 "$_w/bc" "$_w/comp_unreg" >"$_w/comp_new"
  comm -23 "$_w/bc" "$_w/comp_unreg" >"$_w/comp_stale"
  comm -13 "$_w/bl" "$_w/lib_unreg"  >"$_w/lib_new"
  comm -23 "$_w/bl" "$_w/lib_unreg"  >"$_w/lib_stale"

  echo "== section (a) src/compiler — GATED =="
  echo "compiler_extern_total=$_n_comp"
  echo "compiler_extern_unregistered=$(wc -l <"$_w/comp_unreg" | tr -d ' ')"
  sed 's/^/unregistered_compiler_NEW=/'   "$_w/comp_new"
  sed 's/^/baseline_compiler_STALE=/'     "$_w/comp_stale"
  echo "== section (b) src/lib — GATED =="
  echo "lib_extern_total=$_n_lib"
  echo "lib_extern_unregistered=$(wc -l <"$_w/lib_unreg" | tr -d ' ')"
  sed 's/^/unregistered_lib_NEW=/'        "$_w/lib_new"
  sed 's/^/baseline_lib_STALE=/'          "$_w/lib_stale"
  echo "== section (c) src/app — informational only =="
  echo "app_extern_total=$_n_app"
  echo "app_extern_unregistered=$(wc -l <"$_w/app_unreg" | tr -d ' ')"
  echo "seed_registry_tokens=$_n_reg"

  _new=$(( $(wc -l <"$_w/comp_new") + $(wc -l <"$_w/lib_new") ))
  _stale=$(( $(wc -l <"$_w/comp_stale") + $(wc -l <"$_w/lib_stale") ))
  _checked=$(( _n_comp + _n_lib ))

  if [ "$_new" -gt 0 ] || [ "$_stale" -gt 0 ]; then
    echo "FAIL — $_checked extern(s) checked, $_new new unregistered, $_stale stale baseline entry(ies): $(cat "$_w/comp_new" "$_w/lib_new" "$_w/comp_stale" "$_w/lib_stale" | tr '\n' ' ')"
    return 1
  fi
  echo "PASS — $_checked extern(s) checked ($_n_comp compiler + $_n_lib lib), 0 new, 0 stale (baselined: $(wc -l <"$_w/bc" | tr -d ' ') compiler + $(wc -l <"$_w/bl" | tr -d ' ') lib)"
  return 0
}

# --- selftest ---------------------------------------------------------------
# Fatal, and includes MUST-FAIL fixtures: a selftest built only from must-pass
# fixtures proves the guard runs, not that it discriminates.
mkfixture() {
  _d=$1
  mkdir -p "$_d/src/compiler" "$_d/src/lib" "$_d/src/app" "$_d/src/compiler_rust"
  printf 'extern fn rt_known_a(x: i64) -> i64\n'  >"$_d/src/compiler/a.spl"
  printf 'extern fn rt_known_b(x: i64) -> i64\n'  >"$_d/src/lib/b.spl"
  printf 'extern fn rt_known_c(x: i64) -> i64\n'  >"$_d/src/app/c.spl"
  printf 'fn r(){ rt_known_a(); rt_known_b(); rt_known_c(); }\n' >"$_d/src/compiler_rust/r.rs"
  : >"$_d/base_comp.txt"; : >"$_d/base_lib.txt"
}

run_selftest() {
  _st=$(mktemp -d) || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
  _fail=0
  _n=0

  # 1. clean fixture MUST PASS
  mkfixture "$_st/f1"; _w=$_st/w1; mkdir -p "$_w"
  scan_tree "$_st/f1" "$_w" "$_st/f1/base_comp.txt" "$_st/f1/base_lib.txt" >"$_st/o1" 2>&1
  [ $? -eq 0 ] || { echo "selftest FAIL(1): clean fixture did not PASS: $(tail -1 "$_st/o1")"; _fail=1; }
  _n=$((_n+1))

  # 2. MUST-FAIL: new unregistered extern in src/compiler
  mkfixture "$_st/f2"; printf 'extern fn rt_ghost_comp()\n' >>"$_st/f2/src/compiler/a.spl"
  _w=$_st/w2; mkdir -p "$_w"
  scan_tree "$_st/f2" "$_w" "$_st/f2/base_comp.txt" "$_st/f2/base_lib.txt" >"$_st/o2" 2>&1
  [ $? -eq 1 ] && grep -q 'rt_ghost_comp' "$_st/o2" \
    || { echo "selftest FAIL(2): new src/compiler extern did not FAIL naming it: $(tail -1 "$_st/o2")"; _fail=1; }
  _n=$((_n+1))

  # 3. MUST-FAIL: new unregistered extern in src/lib — the scope hole this fix closes
  mkfixture "$_st/f3"; printf 'extern fn rt_ghost_lib()\n' >>"$_st/f3/src/lib/b.spl"
  _w=$_st/w3; mkdir -p "$_w"
  scan_tree "$_st/f3" "$_w" "$_st/f3/base_comp.txt" "$_st/f3/base_lib.txt" >"$_st/o3" 2>&1
  [ $? -eq 1 ] && grep -q 'rt_ghost_lib' "$_st/o3" \
    || { echo "selftest FAIL(3): new src/lib extern did not FAIL naming it (SCOPE HOLE STILL OPEN): $(tail -1 "$_st/o3")"; _fail=1; }
  _n=$((_n+1))

  # 4. MUST-FAIL: stale baseline entry (baselined name is no longer unregistered)
  mkfixture "$_st/f4"; printf 'rt_departed\n' >"$_st/f4/base_lib.txt"
  _w=$_st/w4; mkdir -p "$_w"
  scan_tree "$_st/f4" "$_w" "$_st/f4/base_comp.txt" "$_st/f4/base_lib.txt" >"$_st/o4" 2>&1
  [ $? -eq 1 ] && grep -q 'rt_departed' "$_st/o4" \
    || { echo "selftest FAIL(4): stale baseline entry did not FAIL: $(tail -1 "$_st/o4")"; _fail=1; }
  _n=$((_n+1))

  # 5. MUST-ERROR: empty tree must be ERROR(2), never a pass — the incident shape
  mkdir -p "$_st/f5/src" ; _w=$_st/w5; mkdir -p "$_w"
  scan_tree "$_st/f5" "$_w" "$_st/f5/bc.txt" "$_st/f5/bl.txt" >"$_st/o5" 2>&1
  [ $? -eq 2 ] && grep -q 'nothing was checked' "$_st/o5" \
    || { echo "selftest FAIL(5): empty tree did not ERROR: rc/verdict $(tail -1 "$_st/o5")"; _fail=1; }
  _n=$((_n+1))

  # 6. MUST-ERROR: missing baseline must not be 'informational, exit 0'
  mkfixture "$_st/f6"; rm -f "$_st/f6/base_lib.txt"; _w=$_st/w6; mkdir -p "$_w"
  scan_tree "$_st/f6" "$_w" "$_st/f6/base_comp.txt" "$_st/f6/base_lib.txt" >"$_st/o6" 2>&1
  [ $? -eq 2 ] \
    || { echo "selftest FAIL(6): missing baseline did not ERROR: $(tail -1 "$_st/o6")"; _fail=1; }
  _n=$((_n+1))

  # 7. MUST-ERROR: seed crate present but empty (broken registry extractor)
  mkfixture "$_st/f7"; : >"$_st/f7/src/compiler_rust/r.rs"; _w=$_st/w7; mkdir -p "$_w"
  scan_tree "$_st/f7" "$_w" "$_st/f7/base_comp.txt" "$_st/f7/base_lib.txt" >"$_st/o7" 2>&1
  [ $? -eq 2 ] \
    || { echo "selftest FAIL(7): empty seed registry did not ERROR: $(tail -1 "$_st/o7")"; _fail=1; }
  _n=$((_n+1))

  rm -rf "$_st"
  [ "$_fail" -eq 0 ] || return 1
  echo "selftest: $_n fixture(s) OK (4 must-fail, 3 must-error)"
  return 0
}

_saved_mode=$MODE
MODE=real
run_selftest || { echo "ERROR — nothing was checked (selftest failed)"; exit 2; }
MODE=$_saved_mode

if [ "$MODE" = selftest ]; then
  echo "PASS — selftest only, 7 fixture(s) checked, no tree scanned"
  exit 0
fi

WORK=$(mktemp -d) || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
trap 'rm -rf "$WORK"' EXIT INT TERM
scan_tree "$root" "$WORK"
exit $?
