#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
cd "$root"

simple_bin=${SIMPLE_BIN:-bin/simple}
fixture=test/fixtures/native_method_resolution_payload_enum/main.spl
artifact_dir=build/test-artifacts/native_method_resolution_payload_enum
candidate=$artifact_dir/probe
build_log=$artifact_dir/native-build.log
run_log=$artifact_dir/native-run.log

[ -x "$simple_bin" ] || {
  echo "STATUS: FAIL native-method-resolution reason=compiler-missing path=$simple_bin"
  exit 1
}
version=$($simple_bin --version 2>&1) || {
  echo "STATUS: FAIL native-method-resolution reason=compiler-version-failed"
  exit 1
}
case "$version" in
  *Rust-built*|*"bootstrap seed only"*)
    echo "STATUS: FAIL native-method-resolution reason=rust-seed-forbidden"
    exit 1
    ;;
esac

mkdir -p "$artifact_dir"
if ! env -u SIMPLE_BOOTSTRAP -u SIMPLE_RUNTIME_PATH \
  SIMPLE_NO_STUB_FALLBACK=1 "$simple_bin" compile "$fixture" --native \
  -o "$candidate" >"$build_log" 2>&1; then
  echo "STATUS: FAIL native-method-resolution reason=native-compile-failed log=$build_log"
  exit 1
fi
[ -x "$candidate" ] || {
  echo "STATUS: FAIL native-method-resolution reason=candidate-missing"
  exit 1
}
if ! timeout 30 "$candidate" >"$run_log" 2>&1; then
  echo "STATUS: FAIL native-method-resolution reason=native-execution-failed log=$run_log"
  exit 1
fi
grep -Fq 'PROBE VERDICT: PASS' "$run_log" || {
  echo "STATUS: FAIL native-method-resolution reason=verdict-missing log=$run_log"
  exit 1
}
grep -Fq 'unresolved|free:7|instance:11:13|static:17:19|trait:23:29' "$run_log" || {
  echo "STATUS: FAIL native-method-resolution reason=payload-dispatch-corrupt log=$run_log"
  exit 1
}
grep -Fq 'factory:typed|push:31' "$run_log" || {
  echo "STATUS: FAIL native-method-resolution reason=receiver-path-corrupt log=$run_log"
  exit 1
}
grep -Fq 'const:41:2.5:true:folded:42' "$run_log" || {
  echo "STATUS: FAIL native-method-resolution reason=inferred-module-constant-corrupt log=$run_log"
  exit 1
}
echo "STATUS: PASS native-method-resolution payload-variants=5 static-factory=pass inferred-push=pass constant-inference=pass"
