#!/bin/sh
# F1 / S3-S5 — class-identity SEED matrix (fast lane).
#
# Prints the class/struct identity contract corpus under the TWO SEED engines:
#
#   seedJIT    : $SIMPLE_BIN run <case>                        (cranelift JIT)
#   seedINTERP : SIMPLE_EXECUTION_MODE=interpret $SIMPLE_BIN run <case>
#
# WHY THIS EXISTS ALONGSIDE check-class-identity-engine-matrix.shs. That script
# is the three-engine matrix and its third column runs the whole pure-Simple
# frontend under the seed's own interpreter, which costs tens of minutes. Lane
# F1 stages S3/S4/S5 change the SEED and nothing else, so they need a gate that
# can be run once per seed rebuild rather than once per hour. This script is
# that gate. It is NOT a substitute for the three-engine matrix: it cannot say
# anything about the pure-Simple engine, and it deliberately makes no
# cross-engine claim.
#
# BINARY PROVENANCE IS PART OF THE OUTPUT. Both columns here are produced by
# whatever `$SIMPLE_BIN` is, so a reader must be able to tell WHICH seed was
# measured — a lane that rebuilds the seed and then measures the deployed
# `bin/simple` by accident will see its own change do nothing and conclude the
# change was a no-op. The banner/version of the binary is printed before the
# table, every run.
#
# COMPLETENESS IS PART OF THE VERDICT. A truncated run is NOT a pass. The case
# count is DISCOVERED from the case directory, never hardcoded, and both engines
# must produce a reading for every discovered case. The verdict line states the
# counts so a green result is auditable rather than merely reassuring.
#
# THIS SCRIPT MEASURES; IT DOES NOT ASSERT THE CONTRACT. Both seed engines are
# known-wrong in opposite directions as of 2026-08-09 (JIT aliases structs,
# interpreter copies classes), so a "wrong" reading is the documented status
# quo. See doc/03_plan/ui/perf/f1_class_identity_kind_propagation_plan_2026-08-09.md.
#
# Usage: sh scripts/check/check-class-identity-seed-matrix.shs
#        SIMPLE_BIN=path/to/simple sh scripts/check/check-class-identity-seed-matrix.shs
# Exit:  0 = COMPLETE (both engines answered every discovered case)
#        1 = FAIL — an engine came up short (truncated / killed run)
#        2 = BLOCKED — nothing was measured (no case files, or no binary)

set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT" || exit 2

BIN="${SIMPLE_BIN:-bin/simple}"
CASE_DIR=test/fixtures/repro/compiler/class_identity/cases
SEED_TIMEOUT="${SEED_TIMEOUT:-120}"
LIMIT="${SIMPLE_MODULE_LIMIT:-4000}"

if [ ! -x "$BIN" ] && ! command -v "$BIN" >/dev/null 2>&1; then
    printf 'BLOCKED — SIMPLE_BIN=%s is not executable; nothing was measured\n' "$BIN"
    exit 2
fi

# Provenance first, so the table below can never be read without knowing which
# binary produced it.
printf 'binary:   %s\n' "$BIN"
printf 'resolved: %s\n' "$(readlink -f "$BIN" 2>/dev/null || printf '%s' "$BIN")"
printf 'version:  %s\n' "$(SIMPLE_BOOTSTRAP=1 "$BIN" --version 2>&1 | head -2 | tr '\n' ' ')"
printf '\n'

reading() {
    # Extract the single verdict line, or the failure. [A-Z], NOT [A-J]: the
    # corpus grows (case K landed 2026-08-09) and an alphabet-capped filter
    # silently drops the new case.
    printf '%s\n' "$1" | grep -E '^[A-Z] |^runtime error|^error' | head -1 | sed 's/  */ /g'
}

printf '%-28s | %-30s | %s\n' "case" "seedJIT" "seedINTERP"
printf -- '-----------------------------+--------------------------------+--------------------------------\n'

total_cases=0
jit_readings=0
int_readings=0

for f in "$CASE_DIR"/*.spl; do
    [ -e "$f" ] || continue
    total_cases=$((total_cases + 1))
    name=$(basename "$f" .spl)

    jit_raw=$(SIMPLE_BOOTSTRAP=1 SIMPLE_MODULE_LIMIT="$LIMIT" \
              timeout "$SEED_TIMEOUT" "$BIN" run "$f" 2>&1)
    int_raw=$(SIMPLE_BOOTSTRAP=1 SIMPLE_MODULE_LIMIT="$LIMIT" SIMPLE_EXECUTION_MODE=interpret \
              timeout "$SEED_TIMEOUT" "$BIN" run "$f" 2>&1)

    jit=$(reading "$jit_raw")
    int=$(reading "$int_raw")

    if [ -z "$jit" ]; then jit="<no verdict>"; else jit_readings=$((jit_readings + 1)); fi
    if [ -z "$int" ]; then int="<no verdict>"; else int_readings=$((int_readings + 1)); fi

    printf '%-28s | %-30s | %s\n' "$name" \
        "$(printf '%s' "$jit" | sed 's/^.*= //')" \
        "$(printf '%s' "$int" | sed 's/^.*= //')"
done

printf '\n'
printf 'readings: cases_discovered=%s seedJIT=%s/%s seedINTERP=%s/%s\n' \
    "$total_cases" "$jit_readings" "$total_cases" "$int_readings" "$total_cases"

if [ "$total_cases" -eq 0 ]; then
    printf 'BLOCKED — no case files discovered under %s; nothing was measured\n' "$CASE_DIR"
    exit 2
fi
if [ "$jit_readings" -lt "$total_cases" ] || [ "$int_readings" -lt "$total_cases" ]; then
    printf 'FAIL — incomplete matrix over %s discovered case(s). A truncated run is not a pass.\n' "$total_cases"
    exit 1
fi
printf 'PASS — complete SEED matrix over %s case(s) (seed-only: NO cross-engine claim is made here)\n' "$total_cases"
exit 0
