#!/bin/sh
# Host-independent contract check for RenderDoc/Vulkan discovery and resume docs.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

guide="doc/07_guide/app/ui/gui_web_2d_vulkan_setup.md"
infra="doc/07_guide/tooling/renderdoc_capture_infra.md"
setup="scripts/setup/setup-gui-web-2d-vulkan-env.shs"
runbook_block="$(mktemp "${TMPDIR:-/tmp}/renderdoc-vulkan-runbook.XXXXXX")"
trap 'rm -f "$runbook_block"' EXIT HUP INT TERM

fail() {
    printf 'renderdoc_vulkan_runbook_static_status=fail\n'
    printf 'renderdoc_vulkan_runbook_static_reason=%s\n' "$1"
    exit 1
}

require_file() {
    [ -f "$1" ] || fail "missing-path:$1"
}

require_text() {
    file="$1"
    needle="$2"
    grep -F -- "$needle" "$file" >/dev/null || fail "missing-contract:$needle"
}

for path in \
    src/lib/common/renderdoc/backend_render_record.spl \
    src/app/test/renderdoc_replay_inspect.spl \
    scripts/tool/renderdoc-evidence.shs \
    scripts/check/check-renderdoc-simple-gate.shs \
    "$guide" "$infra" "$setup"
do
    require_file "$path"
done

require_text "$infra" "scripts/tool/renderdoc-evidence.shs capture-simple"
require_text "$infra" "sh scripts/check/check-renderdoc-simple-gate.shs"
require_text "$guide" 'The three direct ARGB producers must use the same `RDOC_HTML_PATH`'
require_text "$setup" 'powershell -NoProfile -ExecutionPolicy Bypass -File scripts\setup\setup-gui-web-2d-vulkan-env.ps1 --check'
require_text "$setup" 'Never embed, echo, pipe, or persist a password'

if grep -E '(12ab34|sudo[[:space:]]+-S|password[[:space:]]*=|PASSWORD[[:space:]]*=)' \
    "$guide" "$infra" "$setup" >/dev/null; then
    fail "embedded-credential-pattern"
fi

for producer_contract in \
    'ELECTRON_CAPTURE_HTML="$HTML_PATH"' \
    'CHROME_CAPTURE_HTML="$HTML_PATH"' \
    'PIXEL_HTML="$HTML_PATH"' \
    'ELECTRON_CAPTURE_WIDTH="$WIDTH"' \
    'CHROME_CAPTURE_WIDTH="$WIDTH"' \
    'PIXEL_W="$WIDTH"' \
    'ELECTRON_CAPTURE_HEIGHT="$HEIGHT"' \
    'CHROME_CAPTURE_HEIGHT="$HEIGHT"' \
    'PIXEL_H="$HEIGHT"'
do
    require_text "$setup" "$producer_contract"
done

awk '
    /^## Full Evidence$/ { in_section = 1; next }
    in_section && /^```sh$/ { in_block = 1; next }
    in_block && /^```$/ { exit }
    in_block { print }
' "$guide" >"$runbook_block"
[ -s "$runbook_block" ] || fail "missing-full-evidence-command-block"

line_number() {
    needle="$1"
    line="$(grep -nF -- "$needle" "$runbook_block" | head -n 1 | cut -d: -f1)"
    [ -n "$line" ] || fail "missing-runbook-command:$needle"
    printf '%s\n' "$line"
}

require_range_text() {
    first="$1"
    last="$2"
    needle="$3"
    sed -n "${first},${last}p" "$runbook_block" | grep -F -- "$needle" >/dev/null ||
        fail "missing-command-env:$needle"
}

producer_line="$(line_number 'scripts/setup/setup-gui-web-2d-vulkan-env.shs --renderdoc-simple')"
gate_start="$(line_number 'RDOC_SIMPLE_EVIDENCE_ENV=build/gui-web-2d-vulkan-env-renderdoc-simple/renderdoc/simple/evidence.env')"
gate_line="$(line_number 'sh scripts/check/check-renderdoc-simple-gate.shs')"
compare_start="$(line_number 'GUI_WEB_2D_VULKAN_ENV=build/gui-web-2d-vulkan-env-run-current/evidence.env')"
compare_line="$(line_number 'sh scripts/check/check-linux-vulkan-render-log-compare.shs')"
aggregate_start="$(line_number 'GUI_RENDERDOC_AGGREGATE_DISABLE_DEFAULT_STATIC_CACHE=1')"
aggregate_line="$(line_number 'sh scripts/check/check-gui-renderdoc-feature-coverage-status.shs')"

if ! [ "$producer_line" -lt "$gate_start" ] \
    || ! [ "$gate_start" -le "$gate_line" ] \
    || ! [ "$gate_line" -lt "$compare_start" ] \
    || ! [ "$compare_start" -le "$compare_line" ] \
    || ! [ "$compare_line" -lt "$aggregate_start" ] \
    || ! [ "$aggregate_start" -le "$aggregate_line" ]; then
    fail "command-chronology-not-producer-gate-compare-aggregate"
fi

require_range_text "$gate_start" "$gate_line" \
    'BUILD_DIR=build/renderdoc/simple-gate'

for compare_env in \
    'GUI_WEB_2D_VULKAN_ENV=build/gui-web-2d-vulkan-env-run-current/evidence.env' \
    'GUI_WEB_2D_VULKAN_BROWSER_BACKING_EVIDENCE_ENV=build/gui-web-2d-vulkan-env-browser-backing/evidence.env' \
    'RDOC_SIMPLE_EVIDENCE_ENV=build/renderdoc/simple-gate/evidence.env' \
    'RDOC_HTML_EVIDENCE_ENV=build/renderdoc/chrome-implicit-layer-default-autocapture/html/evidence.env' \
    'RDOC_ELECTRON_HTML_EVIDENCE_ENV=build/renderdoc/electron-implicit-layer-default-autocapture/electron-html/evidence.env'
do
    require_range_text "$compare_start" "$compare_line" "$compare_env"
done

for aggregate_env in \
    'GUI_WEB_2D_VULKAN_ENV=build/gui-web-2d-vulkan-env-check-current/evidence.env' \
    'GUI_WEB_2D_VULKAN_RUN_EVIDENCE_ENV=build/gui-web-2d-vulkan-env-run-current/evidence.env' \
    'GUI_WEB_2D_VULKAN_BROWSER_BACKING_EVIDENCE_ENV=build/gui-web-2d-vulkan-env-browser-backing/evidence.env' \
    'RDOC_SIMPLE_EVIDENCE_ENV=build/renderdoc/simple-gate/evidence.env' \
    'RDOC_HTML_EVIDENCE_ENV=build/renderdoc/chrome-implicit-layer-default-autocapture/html/evidence.env' \
    'RDOC_ELECTRON_HTML_EVIDENCE_ENV=build/renderdoc/electron-implicit-layer-default-autocapture/electron-html/evidence.env' \
    'LINUX_VULKAN_RENDER_LOG_COMPARE_ENV=build/linux-vulkan-render-log-compare/evidence.env'
do
    require_range_text "$aggregate_start" "$aggregate_line" "$aggregate_env"
done

raw_simple_source='RDOC_SIMPLE_EVIDENCE_ENV=build/gui-web-2d-vulkan-env-renderdoc-simple/renderdoc/simple/evidence.env'
if sed -n "${compare_start},${compare_line}p;${aggregate_start},${aggregate_line}p" "$runbook_block" |
    grep -F -- "$raw_simple_source" >/dev/null; then
    fail "raw-simple-capture-source-used-by-consumer"
fi

printf 'renderdoc_vulkan_runbook_static_status=pass\n'
printf 'renderdoc_vulkan_runbook_static_reason=pass\n'
