use compiler.driver.driver_worker_surface_graph_v1.{worker_surface_gap_v1, worker_surface_gap_message_v1}

fn main() -> i64:
    val gap = worker_surface_gap_v1(0, [false], [[]])
    var prefix = ""
    for i in 0..511: prefix = prefix + "x"
    for scalar in ["é", "한", "😀"]:
        print worker_surface_gap_message_v1(gap, prefix + scalar, "", "")
    print worker_surface_gap_message_v1(gap, prefix + "x", "", "")
    var aligned = ""
    for i in 0..508: aligned = aligned + "x"
    print worker_surface_gap_message_v1(gap, aligned + "😀", "", "")
    print worker_surface_gap_message_v1(gap, aligned + "😀x", "", "")
    return 0
