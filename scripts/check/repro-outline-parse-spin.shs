#!/bin/sh
# Reproduce the treesitter OUTLINE parse spin in ~2.5s of parse time.
#
# The spin that blocked phase 1 (stage1 runs 21/23, "parse 144/688" on
# treesitter_types.spl) needs NO stage1 build and no 688-module closure. It
# reproduces on a ONE-FILE source set, because the trigger is not the module
# count -- it is a substring.
#
#   frontend.spl: frontend_has_outline_authority(source) is
#       source.contains("friend ") or source.contains("internal_export")
#
# Any file containing either substring ANYWHERE -- including in a struct field
# name or a comment -- takes the treesitter outline-authority path
# (treesitter_new(...).parse_outline()) before the real parser runs. That path
# spins. Files without the substring never enter it, which is why only
# treesitter_types.spl (field `internal_exports:`) and outline.spl (9
# occurrences) stall while the other four outline-family files parse fine.
#
# Usage: sh scripts/check/repro-outline-parse-spin.shs [seed_binary] [timeout_s]
set -u
SEED="${1:-bin/simple}"
LIMIT="${2:-240}"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/src"
cp src/compiler/10.frontend/treesitter_types.spl "$WORK/src/" || exit 2

LOG="$WORK/out.log"
SIMPLE_COMPILER_TRACE=1 SIMPLE_NATIVE_BUILD_WORKER=1 \
  timeout "$LIMIT" "$SEED" run src/app/cli/parse_shard_main.spl \
  --source "$WORK/src" --entry "$WORK/src/treesitter_types.spl" \
  --parse-shard=0/1 > "$LOG" 2>&1
RC=$?

# The discriminator is positional, not just "did it finish". frontend.spl emits
# `[frontend] parse_and_build:start` immediately AFTER the outline-authority
# block and immediately BEFORE the real parser. Reaching parse:file:start
# without ever reaching parse_and_build:start pins the hang inside
# parse_outline() and nowhere else.
REACHED=$(grep -ac "phase2:parse:file:start" "$LOG" 2>/dev/null || echo 0)
PASSED=$(grep -ac "parse_and_build:start" "$LOG" 2>/dev/null || echo 0)

if [ "$REACHED" -eq 0 ]; then
    echo "ERROR — nothing was checked (parse never started; rc=$RC)"
    exit 2
fi
if [ "$PASSED" -gt 0 ]; then
    echo "PASS — 1 file parsed, outline-authority block completed (rc=$RC)"
    exit 0
fi
echo "FAIL — entered parse of treesitter_types.spl but never left the"
echo "       outline-authority block (parse_outline spin); rc=$RC"
echo "       timeout=${LIMIT}s, no parse_and_build:start receipt"
exit 1
