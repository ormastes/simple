#!/bin/sh
# check-dup-struct-name-jit-soundness.shs
#
# Same-named structs across modules must JIT, and must JIT CORRECTLY.
#
# Two structs (or a struct and a class) that share a bare NAME in different
# modules are flattened into one item list by the run/JIT lane's import
# flattening (`load_module_with_imports`). Until 2026-10-19 HIR lowering keyed
# struct types by bare name, so one layout won and the whole program either
# de-JIT'd to the interpreter (`Cannot infer field type`, the default) or,
# with `SIMPLE_JIT_DUP_STRUCT_FEED=1`, read a WRONG slot through the
# duplicate-variant "consensus" fallback. Measured 2026-08-18 with the feed
# forced on:
#
#   case_two_variants     interp `length=5`      jit+feed `length=130257`  MISCOMPILE
#   case_three_variants   interp `b=2 d=5 e=6`   jit+feed `b=0 d=0 e=6`    MISCOMPILE
#   case_param_field_read interp `g=11 o=42`     jit+feed `g=10 o=42`      MISCOMPILE
#
# Fixed by module-qualified struct identity: the flattener tags every
# struct/class with its owner, and HIR lowering gives colliding declarations
# owner-exact types resolved per function owner and import binding
# (`src/compiler_rust/compiler/src/hir/lower/module_lowering/flatten_struct_owner.rs`).
# The feed stays default-OFF (the consensus fallback is still unsound), but
# these fixtures no longer reach it.
#
# This guard therefore requires, per fixture: the JIT arm emitted code
# (`[jit-addr]` lines), did NOT de-JIT (`[jit-fallback]`), and printed exactly
# the interpreter's result. Both the default arm and the forced-feed arm are
# checked.
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> case(s) checked, ...                                      exit 0
#   FAIL  — ...                                                           exit 1
#   ERROR — nothing was checked                                           exit 2
#
# --selftest is the negative control: it runs the "JIT" arm in interpreter
# mode, which emits no code, and REQUIRES every case to be flagged. A
# selftest in which any case passes is an ERROR (the engine witness is
# vacuous).

set -u

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
SIMPLE="${SIMPLE_BIN:-$ROOT/bin/simple}"
BASE="$ROOT/test/01_unit/compiler/dup_struct_name"
CASES="case_two_variants case_three_variants case_identical_layout case_class_vs_struct case_param_field_read"
TMP="${TMPDIR:-/tmp}/dupstruct.$$"
mkdir -p "$TMP"
trap 'rm -rf "$TMP"' EXIT

if [ ! -x "$SIMPLE" ]; then
    echo "ERROR — nothing was checked: no runnable binary at $SIMPLE"
    exit 2
fi

# Extract the fixture's single result line (all fixtures print one `k=v ...`).
result_line() {
    grep -E '^[a-z_]+=' "$1" | head -1
}

run_arm() {
    # $1 = case dir, $2 = out file, rest = env assignments
    _dir="$1"; _out="$2"; shift 2
    env "$@" "$SIMPLE" run "$BASE/$_dir/main.spl" >"$_out" 2>&1
    return $?
}

SELFTEST=0
[ "${1:-}" = "--selftest" ] && SELFTEST=1

CHECKED=0
BAD=""

for c in $CASES; do
    [ -f "$BASE/$c/main.spl" ] || continue

    run_arm "$c" "$TMP/$c.interp" SIMPLE_EXECUTION_MODE=interpreter
    RC_I=$?
    if [ "$RC_I" -ne 0 ]; then
        echo "FAIL — interpreter arm rc=$RC_I on $c (baseline unusable)"
        exit 1
    fi
    EXPECT=$(result_line "$TMP/$c.interp")
    if [ -z "$EXPECT" ]; then
        echo "FAIL — interpreter arm produced no result line for $c"
        exit 1
    fi

    for arm in default feed; do
        if [ "$SELFTEST" -eq 1 ]; then
            MODE=interpreter
        else
            MODE=jit
        fi
        if [ "$arm" = feed ]; then
            run_arm "$c" "$TMP/$c.$arm" SIMPLE_EXECUTION_MODE=$MODE SIMPLE_JIT_DUP_STRUCT_FEED=1 SIMPLE_JIT_TRACE_ADDR=1
        else
            run_arm "$c" "$TMP/$c.$arm" SIMPLE_EXECUTION_MODE=$MODE SIMPLE_JIT_TRACE_ADDR=1
        fi
        RC_J=$?
        GOT=$(result_line "$TMP/$c.$arm")
        # Engine witness: `[jit-addr] <fn> 0x...` lines prove Cranelift
        # actually emitted code; a `[jit-fallback]` line means a de-JIT.
        ADDRS=$(grep -c '\[jit-addr\]' "$TMP/$c.$arm")
        FALLBACK=0
        grep -q '\[jit-fallback\]' "$TMP/$c.$arm" && FALLBACK=1
        echo "case $c/$arm: interp='$EXPECT' jit='$GOT' rc=$RC_J jit-addr=$ADDRS fallback=$FALLBACK"
        CHECKED=$((CHECKED + 1))
        if [ "$RC_J" -ne 0 ] || [ "$GOT" != "$EXPECT" ] || [ "$ADDRS" -eq 0 ] || [ "$FALLBACK" -ne 0 ]; then
            BAD="$BAD $c/$arm"
        fi
    done
done

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked: no fixtures found under $BASE"
    exit 2
fi

if [ "$SELFTEST" -eq 1 ]; then
    if [ "$BAD" = "$(for c in $CASES; do printf ' %s/default %s/feed' "$c" "$c"; done)" ]; then
        echo "PASS — $CHECKED arm(s) checked, selftest: every interpreter-only arm was flagged"
        exit 0
    fi
    echo "ERROR — nothing was checked: selftest expected every arm flagged, got:$BAD (engine witness is vacuous)"
    exit 2
fi

if [ -n "$BAD" ]; then
    echo "FAIL — $CHECKED arm(s) checked, de-JIT or JIT/interpreter disagreement:$BAD"
    exit 1
fi

echo "PASS — $CHECKED arm(s) checked, every same-named-struct fixture JITs and matches the interpreter"
exit 0
