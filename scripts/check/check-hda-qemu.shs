#!/bin/sh
# HDA is one required lane of the canonical live WM scenario. Reuse that
# fail-closed build/QMP/evidence owner instead of maintaining a second boot.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
exec sh "$ROOT_DIR/scripts/check/check-simpleos-wm-fullscreen-evidence.shs"
