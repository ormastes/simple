#!/bin/sh
# Fail-closed admission for WM, GUI, Web, and Engine2D showcase captures.
set -eu

WM_CAPTURE=${WM_CAPTURE:-}
GUI_CAPTURE=${GUI_CAPTURE:-}
WEB_CAPTURE=${WEB_CAPTURE:-}
ENGINE2D_CAPTURE=${ENGINE2D_CAPTURE:-}
GUEST_SERIAL_LOG=${GUEST_SERIAL_LOG:-}
VULKAN_RECEIPT=${VULKAN_RECEIPT:-}
QEMU_PRODUCER_RECEIPT=${QEMU_PRODUCER_RECEIPT:-}
CONTAINER_PRODUCER_RECEIPT=${CONTAINER_PRODUCER_RECEIPT:-}
ADMITTED_SIMPLE_BIN=${ADMITTED_SIMPLE_BIN:-}
GUEST_IMAGE=${GUEST_IMAGE:-}
ALLOCATION_CAP_BYTES=${ALLOCATION_CAP_BYTES:-}
REPORT_PATH=${REPORT_PATH:-build/render-lane-mission-showcase/evidence.env}

mkdir -p "$(dirname "$REPORT_PATH")"

fail() {
    reason=$1
    {
        echo 'render_lane_mission_showcase_status=fail'
        echo "render_lane_mission_showcase_reason=$reason"
    } >"$REPORT_PATH"
    echo "render lane mission showcase: FAIL ($reason)" >&2
    exit 1
}

is_sha256() {
    case "$1" in
        *[!0-9a-f]*|'') return 1 ;;
    esac
    [ "${#1}" -eq 64 ]
}

capture_hash() {
    path=$1
    [ -f "$path" ] && [ ! -L "$path" ] || fail "capture-missing-or-symlink:$path"
    size=$(wc -c <"$path" | tr -d ' ')
    [ "$size" -ge 4096 ] || fail "capture-too-small:$path"
    mime=$(file -b --mime-type "$path" 2>/dev/null || true)
    case "$mime" in image/*) ;; *) fail "capture-not-image:$path" ;; esac
    hash=$(sha256sum "$path" | awk '{print $1}')
    is_sha256 "$hash" || fail "capture-hash-invalid:$path"
    printf '%s' "$hash"
}

required_file_hash() {
    path=$1
    name=$2
    [ -f "$path" ] && [ ! -L "$path" ] || fail "$name-missing-or-symlink"
    sha256sum "$path" | awk '{print $1}'
}

receipt_value() {
    key=$1
    count=$(grep -Ec "^$key=" "$VULKAN_RECEIPT" || true)
    [ "$count" -eq 1 ] || fail "vulkan-receipt-$key-not-unique"
    value=$(sed -n "s/^$key=//p" "$VULKAN_RECEIPT")
    [ -n "$value" ] || fail "vulkan-receipt-$key-empty"
    printf '%s' "$value"
}

receipt_sha256_matches() {
    key=$1
    expected=$2
    actual=$(receipt_value "$key")
    [ "$actual" = "$expected" ] || fail "vulkan-$key-unbound"
}

receipt_positive_decimal() {
    key=$1
    value=$(receipt_value "$key")
    case "$value" in *[!0-9]*|'') fail "vulkan-receipt-$key-invalid" ;; esac
    [ "$value" -gt 0 ] || fail "vulkan-receipt-$key-not-positive"
    printf '%s' "$value"
}

[ -f "$GUEST_SERIAL_LOG" ] && [ ! -L "$GUEST_SERIAL_LOG" ] || fail guest-serial-missing
[ -f "$VULKAN_RECEIPT" ] && [ ! -L "$VULKAN_RECEIPT" ] || fail vulkan-receipt-missing
[ -n "$ALLOCATION_CAP_BYTES" ] || fail allocation-cap-missing
case "$ALLOCATION_CAP_BYTES" in *[!0-9]*|'') fail allocation-cap-invalid ;; esac
[ "$ALLOCATION_CAP_BYTES" -gt 0 ] || fail allocation-cap-invalid
qemu_receipt_hash=$(required_file_hash "$QEMU_PRODUCER_RECEIPT" qemu-producer-receipt)
container_receipt_hash=$(required_file_hash "$CONTAINER_PRODUCER_RECEIPT" container-producer-receipt)
simple_bin_hash=$(required_file_hash "$ADMITTED_SIMPLE_BIN" admitted-simple-bin)
guest_image_hash=$(required_file_hash "$GUEST_IMAGE" guest-image)
serial_hash=$(required_file_hash "$GUEST_SERIAL_LOG" guest-serial)

wm_hash=$(capture_hash "$WM_CAPTURE")
gui_hash=$(capture_hash "$GUI_CAPTURE")
web_hash=$(capture_hash "$WEB_CAPTURE")
engine2d_hash=$(capture_hash "$ENGINE2D_CAPTURE")

unique_hashes=$(printf '%s\n' "$wm_hash" "$gui_hash" "$web_hash" "$engine2d_hash" | sort -u | wc -l | tr -d ' ')
[ "$unique_hashes" -eq 4 ] || fail captures-not-distinct

grep -Fq '[desktop-gui] first-frame-rendered ' "$GUEST_SERIAL_LOG" || fail first-frame-marker-missing
grep -Fq '[desktop-gui] engine2d-ready backend=vulkan' "$GUEST_SERIAL_LOG" || fail engine2d-vulkan-marker-missing
grep -Eq '\[desktop-gui\] spawn return app=Browser Demo pid=[1-9][0-9]*' "$GUEST_SERIAL_LOG" || fail browser-process-not-live
grep -Eq '\[production-readiness\].*wm=live.*simple_gui=object-tree.*simple_web=content-frame.*renderer=engine2d.*process_owned_surfaces=[1-9][0-9]*' "$GUEST_SERIAL_LOG" || fail production-lanes-not-live
if grep -Eq 'frame-degraded|window-degraded|FATAL:|EXCEPTION FRAME|Triple fault|scanout-invalid' "$GUEST_SERIAL_LOG"; then
    fail degraded-or-faulted-guest
fi

[ "$(receipt_value schema_version)" = 1 ] || fail vulkan-receipt-schema-unsupported
[ "$(receipt_value status)" = pass ] || fail vulkan-receipt-not-pass
[ "$(receipt_value backend)" = vulkan ] || fail vulkan-backend-not-bound
[ "$(receipt_value vulkan_submit)" = pass ] || fail vulkan-submit-not-proven
[ "$(receipt_value vulkan_fence)" = pass ] || fail vulkan-fence-not-proven
[ "$(receipt_value vulkan_readback)" = pass ] || fail vulkan-readback-not-proven
receipt_sha256_matches wm_sha256 "$wm_hash"
receipt_sha256_matches gui_sha256 "$gui_hash"
receipt_sha256_matches web_sha256 "$web_hash"
receipt_sha256_matches engine2d_sha256 "$engine2d_hash"
receipt_sha256_matches guest_serial_sha256 "$serial_hash"
receipt_sha256_matches qemu_producer_receipt_sha256 "$qemu_receipt_hash"
receipt_sha256_matches container_producer_receipt_sha256 "$container_receipt_hash"
receipt_sha256_matches admitted_simple_bin_sha256 "$simple_bin_hash"
receipt_sha256_matches guest_image_sha256 "$guest_image_hash"
[ "$(receipt_value allocation_cap_bytes)" = "$ALLOCATION_CAP_BYTES" ] || fail allocation-cap-unbound
allocation_peak=$(receipt_positive_decimal allocation_peak_bytes)
[ "$allocation_peak" -le "$ALLOCATION_CAP_BYTES" ] || fail allocation-cap-exceeded

{
    echo 'render_lane_mission_showcase_status=pass'
    echo 'render_lane_mission_showcase_reason=pass'
    echo 'render_lane_mission_showcase_distinct_capture_count=4'
    echo 'render_lane_mission_showcase_vulkan_backend_count=1'
    echo "render_lane_mission_showcase_allocation_cap_bytes=$ALLOCATION_CAP_BYTES"
    echo "render_lane_mission_showcase_allocation_peak_bytes=$allocation_peak"
    echo "render_lane_mission_showcase_wm_sha256=$wm_hash"
    echo "render_lane_mission_showcase_gui_sha256=$gui_hash"
    echo "render_lane_mission_showcase_web_sha256=$web_hash"
    echo "render_lane_mission_showcase_engine2d_sha256=$engine2d_hash"
} >"$REPORT_PATH"

cat "$REPORT_PATH"
