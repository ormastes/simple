#!/bin/sh
# land.shs — gate committed content, then optionally submit one owned work branch.
#
# Why this exists (doc/08_tracking/bug/jj_push_bypasses_rules_sdl_gates_2026-08-11.md):
# `.git/hooks/pre-push` fans out to ~57 guards, including the rules.sdl shrink
# gates (check-rules-sdl.shs, check-rules-sdl-integrity.shs). That hook only
# fires on a REAL `git push`. This repo's documented VCS is jj
# (.claude/rules/vcs.md), and jj's push path — `jj git push`, and the `sj`
# wrapper around it (bin/sj -> src/app/sj/main.spl) — is a thin passthrough to
# jj/git subcommands with NO push-specific hook point. jj does not support
# pre-push hooks at all. Confirmed by adversarial review 2026-08-11: on the
# former direct-protected-ref landing flow, the quick-group rules.sdl gates
# never ran. The only real enforcement
# left was `bin/simple build bootstrap` (full group), which nobody runs on
# every landing.
#
# This script closes the gap at the WRAPPER SEAM: it runs the same two guards
# the git pre-push hook would have run, in --ref mode against COMMITTED
# content (never the shared working copy — see reference_measurement_requires
# _a_pinned_worktree.md), and refuses to push if either verdict is not PASS.
# Only on a clean gate does it perform the actual push.
#
# Usage: sh scripts/check/land.shs [--dry-run|--submit]
#   --dry-run   run the gates and print the verdicts; this is the default.
#   --submit    push only the current work/* branch for protected integration.
#
# Verdict discipline mirrors the other pre-push guards: read the LAST line of
# each guard's stdout, not just its exit code (a piped exit status lies).
# Recursion guard: refuse to run at SIMPLE_SHS_DEPTH >= SIMPLE_SHS_MAX_DEPTH (exit 3).
case "$0" in */*) . "${0%/*}/../lib/recursion_guard.shs" ;; *) . ./scripts/lib/recursion_guard.shs ;; esac
set -u

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$REPO_ROOT" || { echo "land.shs: cannot cd to repo root $REPO_ROOT" >&2; exit 2; }

SUBMIT=0
case "${1:-}" in
    --dry-run|"") ;;
    --submit) SUBMIT=1 ;;
    *) echo "usage: $0 [--dry-run|--submit]" >&2; exit 2 ;;
esac

WORK_BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
case "$WORK_BRANCH" in
    work/*) ;;
    *) echo "land.shs: current branch must be an owned work/* branch" >&2; exit 2 ;;
esac
TARGET_REF=${LAND_TARGET_REF:-main}
case "$TARGET_REF" in
    main|release/*) ;;
    *) echo "land.shs: LAND_TARGET_REF must be main or release/X.Y" >&2; exit 2 ;;
esac

# Resolve the exact commit owned by the current work branch. Never infer a
# protected target or an unbookmarked JJ working-copy parent.
TIP=$(git rev-parse "refs/heads/$WORK_BRANCH" 2>/dev/null || true)
if [ -z "$TIP" ]; then
    echo "land.shs: could not resolve TIP commit via jj or git — refusing to push blind" >&2
    exit 2
fi

# Resolve the exact protected target snapshot used by the admission gates.
BASE=$(git rev-parse "origin/$TARGET_REF" 2>/dev/null) \
    || BASE=""
if [ -z "$BASE" ]; then
    echo "land.shs: could not resolve BASE (origin/$TARGET_REF) — refusing to submit blind" >&2
    exit 2
fi

echo "land.shs: gating BASE=$BASE TIP=$TIP" >&2

RULES_OUT=$(sh scripts/check/check-rules-sdl.shs --group quick --ref "$TIP" 2>&1)
RULES_CODE=$?
RULES_VERDICT=$(printf '%s\n' "$RULES_OUT" | tail -1)
printf '%s\n' "$RULES_OUT" >&2

INTEGRITY_OUT=$(sh scripts/check/check-rules-sdl-integrity.shs "$BASE" "$TIP" 2>&1)
INTEGRITY_CODE=$?
INTEGRITY_VERDICT=$(printf '%s\n' "$INTEGRITY_OUT" | tail -1)
printf '%s\n' "$INTEGRITY_OUT" >&2

case "$RULES_VERDICT" in
    PASS*) ;;
    *) echo "land.shs: REFUSING TO PUSH — check-rules-sdl.shs verdict: $RULES_VERDICT" >&2; exit 1 ;;
esac
case "$INTEGRITY_VERDICT" in
    PASS*) ;;
    *) echo "land.shs: REFUSING TO PUSH — check-rules-sdl-integrity.shs verdict: $INTEGRITY_VERDICT" >&2; exit 1 ;;
esac
[ "$RULES_CODE" -eq 0 ] || { echo "land.shs: REFUSING TO PUSH — check-rules-sdl.shs exited $RULES_CODE despite PASS text" >&2; exit 1; }
[ "$INTEGRITY_CODE" -eq 0 ] || { echo "land.shs: REFUSING TO PUSH — check-rules-sdl-integrity.shs exited $INTEGRITY_CODE despite PASS text" >&2; exit 1; }

echo "land.shs: both gates PASS for owned branch $WORK_BRANCH" >&2

# --- WP2 (push_hook_plan.md A.5/D, owner decision O3=a) ---------------------
# The ~1-min "1-min remote must-check" local tier runs and gets SIGNED here,
# before a PR is opened — NOT in the pre-push hook, which stays a <10s
# report-only check of receipt presence (pre-push-conflict-tree-guard.shs).
# A failing signing step here is a real refusal, never a silent skip: the
# whole point of this WP is that an unsigned push is always visible as a rush,
# never mistaken for "checked".
if [ "${SIMPLE_PUSH_RUSH:-0}" = 1 ]; then
    echo "land.shs: SIMPLE_PUSH_RUSH=1 — skipping the local must-check tier and signing; the remote will run full checks" >&2
else
    CI_KEY=${SIMPLE_CI_RECEIPT_KEY:-}
    if [ -z "$CI_KEY" ]; then
        CI_KEY=$(git config --get simple.ciReceiptKey 2>/dev/null) || CI_KEY=""
    fi
    CI_IDENTITY=${SIMPLE_CI_RECEIPT_IDENTITY:-}
    if [ -z "$CI_IDENTITY" ]; then
        CI_IDENTITY=$(git config --get simple.ciReceiptIdentity 2>/dev/null) || CI_IDENTITY=""
    fi
    if [ -z "$CI_KEY" ] || [ ! -f "$CI_KEY" ] || [ -z "$CI_IDENTITY" ]; then
        echo "land.shs: REFUSING — no local-ci signing key/identity configured (set SIMPLE_CI_RECEIPT_KEY/SIMPLE_CI_RECEIPT_IDENTITY, or git config simple.ciReceiptKey/simple.ciReceiptIdentity); set SIMPLE_PUSH_RUSH=1 to explicitly acknowledge an unsigned rush landing instead" >&2
        exit 1
    fi

    # HOOK POINT (WP3, being reworked to own the manifest placeholders + tier
    # runner): scripts/check/run-gate-tier.shs is the intended tier runner once
    # it lands on origin/main — it reads the manifest and substitutes
    # {range}/{rev}/{base} placeholders per row, and writes `<id> <status>`
    # lines in the exact format sign-local-ci-receipt.shs's --results expects.
    # We call it WHEN PRESENT so this hook point stays compatible with WP3
    # landing under us without another edit here. Until it lands,
    # `sign-local-ci-receipt.shs --run` does the equivalent for a single host:
    # it reads config/check/must_check_gates.sdn's `local` tier rows AS OF
    # $TIP and runs each row's own command directly, the same way
    # check-push-must-pass.shs's dispatch runs the push tier's rows.
    NOTE_REMOTE=${LAND_CI_RECEIPT_NOTE_REMOTE:-origin}
    # Only a real --submit may publish the note remotely: a --dry-run signs
    # and attaches the receipt LOCALLY (so it can be inspected) but must never
    # mutate any remote ref. Reviewer fix (coordinator batch review): the note
    # push used to run unconditionally, before the dry-run/submit branch below
    # even existed, so a plain `land.shs` (default = --dry-run) was pushing to
    # refs/notes/ci-receipts on $NOTE_REMOTE.
    if [ "$SUBMIT" -eq 1 ]; then
        PUSH_NOTE_FLAG="--push-note"
    else
        PUSH_NOTE_FLAG=""
    fi

    if [ -f scripts/check/run-gate-tier.shs ]; then
        echo "land.shs: scripts/check/run-gate-tier.shs found — using it for the local tier (WP3)" >&2
        echo "land.shs: running the local must-check tier and signing a receipt for $TIP (up to ~60s)..." >&2
        TIER_RESULTS=$(mktemp 2>/dev/null) || TIER_RESULTS="${TMPDIR:-/tmp}/land-tier-results.$$"
        TIER_OUT=$(sh scripts/check/run-gate-tier.shs --tier local --rev "$TIP" 2>&1)
        TIER_CODE=$?
        printf '%s\n' "$TIER_OUT" >&2
        TIER_VERDICT=$(printf '%s\n' "$TIER_OUT" | tail -1)
        case "$TIER_VERDICT" in
            PASS*) ;;
            *)
                rm -f "$TIER_RESULTS"
                echo "land.shs: REFUSING — run-gate-tier.shs verdict: $TIER_VERDICT" >&2
                exit 1
                ;;
        esac
        if [ "$TIER_CODE" -ne 0 ]; then
            rm -f "$TIER_RESULTS"
            echo "land.shs: REFUSING — run-gate-tier.shs exited $TIER_CODE despite PASS text" >&2
            exit 1
        fi
        # Every line but the trailing verdict line is a "<id> <status>" row —
        # exactly the --results format (see run-gate-tier.shs's own contract).
        printf '%s\n' "$TIER_OUT" | sed '$d' > "$TIER_RESULTS"
        SIGN_OUT=$(sh scripts/check/sign-local-ci-receipt.shs --results "$TIER_RESULTS" --tier local \
            --key "$CI_KEY" --identity "$CI_IDENTITY" --rev "$TIP" \
            --note $PUSH_NOTE_FLAG --note-remote "$NOTE_REMOTE" 2>&1)
        SIGN_CODE=$?
        rm -f "$TIER_RESULTS"
    else
        echo "land.shs: running the local must-check tier and signing a receipt for $TIP (up to ~60s)..." >&2
        SIGN_OUT=$(sh scripts/check/sign-local-ci-receipt.shs --run --tier local \
            --key "$CI_KEY" --identity "$CI_IDENTITY" --rev "$TIP" \
            --note $PUSH_NOTE_FLAG --note-remote "$NOTE_REMOTE" 2>&1)
        SIGN_CODE=$?
    fi
    printf '%s\n' "$SIGN_OUT" >&2
    SIGN_VERDICT=$(printf '%s\n' "$SIGN_OUT" | tail -1)
    case "$SIGN_VERDICT" in
        PASS*) ;;
        *) echo "land.shs: REFUSING TO PUSH — local-ci receipt signing verdict: $SIGN_VERDICT" >&2; exit 1 ;;
    esac
    [ "$SIGN_CODE" -eq 0 ] ||
        { echo "land.shs: REFUSING TO PUSH — sign-local-ci-receipt.shs exited $SIGN_CODE despite PASS text" >&2; exit 1; }
    if [ "$SUBMIT" -eq 1 ]; then
        echo "land.shs: local-ci receipt signed and published for $TIP" >&2
    else
        echo "land.shs: DRY-RUN — local-ci receipt signed and attached LOCALLY for $TIP; nothing was pushed. Rerun with --submit to also push refs/notes/ci-receipts to $NOTE_REMOTE" >&2
    fi
fi

if [ "$SUBMIT" -ne 1 ]; then
    echo "land.shs: dry-run complete; use --submit to push only $WORK_BRANCH" >&2
    exit 0
fi

git push origin "refs/heads/$WORK_BRANCH:refs/heads/$WORK_BRANCH"
echo "land.shs: submitted $WORK_BRANCH; protected integration remains a separate reviewed CAS operation" >&2
