#!/bin/sh
# Read-only registration audit. Lifecycle values are never rewritten.
# Exit 0: complete scan with no findings; 1: findings; 2: incomplete scan.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
root=$repo
case "${1:-}" in
    --selftest) exec sh "$repo/test/01_unit/scripts/tracking_doc_registration_test.shs" ;;
    --root) [ "$#" -eq 2 ] || exit 2; root=$2 ;;
    '') ;;
    *) echo 'usage: check-tracking-doc-registration.shs [--root DIR|--selftest]' >&2; exit 2 ;;
esac
root=$(CDPATH= cd -- "$root" && pwd) || exit 2
bug="$root/doc/08_tracking/bug"
todo="$root/doc/08_tracking/todo"
for needed in "$bug/bug_db.sdn" "$todo/todo_db.sdn"; do
    [ -f "$needed" ] || { echo "ERROR missing-db $needed"; exit 2; }
done
files=$(mktemp)
trap 'rm -f "$files"' EXIT HUP INT TERM
find "$bug" "$todo" -type f -name '*.md' -print > "$files" || exit 2
LC_ALL=C sort -o "$files" "$files"
LC_ALL=C awk -v root="$root" -v bugdb="$bug/bug_db.sdn" -v tododb="$todo/todo_db.sdn" '
BEGIN {
    # Explicit document aliases only. Date punctuation is not a general alias:
    # these three documents were reviewed against the older authoritative row.
    bug_alias["check_stage3_recovery_authority_arity_drift_2026-09-17"]="check_stage3_recovery_authority_arity_drift_2026_09_17"
    bug_alias["gpu_ffi_loader_probes_linux_sonames_on_macos_2026-09-19"]="gpu_ffi_loader_probes_linux_sonames_on_macos_2026_09_19"
    bug_alias["windows_bootstrap_cmp_authority_missing_2026-09-09"]="windows_bootstrap_cmp_authority_missing"
}
function trim(s) { sub(/^[ \t\r]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
function finding(kind, path, detail) {
    gsub(/[\t\r\n]/, " ", detail)
    print kind "\t" path "\t" detail
    findings++
}
# Match database/core.spl split_sdn_row: every quote toggles quoting.
# This owner does not implement CSV-style quote escapes.
function cells(s, out,    i,n,c,q,v) {
    split("", out); n=1; q=0; v=""
    for (i=1; i<=length(s); i++) {
        c=substr(s,i,1)
        if (c=="\"") { q=!q; v=v c; continue }
        if (!q && c==",") { out[n++]=trim(v); v=""; continue }
        v=v c
    }
    out[n]=trim(v)
    for (i=1; i<=n; i++) {
        if (out[i] ~ /^".*"$/) { sub(/^"/, "", out[i]); sub(/"$/, "", out[i]) }
    }
    if (q) return -1
    return n
}
function unresolved(s) {
    s=tolower(trim(s))
    return s ~ /^(open|blocked|pending|unresolved|deferred|in[- ]progress|partial|partially)([^a-z]|$)/
}
function lifecycle(s) {
    s=tolower(trim(s))
    if (s ~ /^blocked([^a-z]|$)/) return "blocked"
    if (s ~ /^open([^a-z]|$)/) return "open"
    return ""
}
function date_key(s) {
    # Candidate diagnostic only: a near-match never grants registration.
    gsub(/_/, "-", s)
    return s
}
FILENAME==bugdb || FILENAME==tododb {
    if (FNR==1) table=""
    if ($0 ~ /^[A-Za-z_][A-Za-z0-9_]*[ \t]+\|/) {
        table=$1; next
    }
    if ($0 ~ /^[ \t]*(#|$)/) next
    isbug=(FILENAME==bugdb && (table=="bugs" || table=="bugs_active"))
    istodo=(FILENAME==tododb && table=="todos")
    if (!isbug && !istodo) next
    n=cells($0, f); expected=isbug ? 10 : 11
    rows++
    if (n!=expected) {
        finding("malformed-row", substr(FILENAME,length(root)+2) ":" FNR, "cells=" n ";expected=" expected ";id=" f[1])
    }
    id=f[1]
    if (isbug) {
        if (id in bugs) finding("duplicate-bug-id", id, "across bugs/bugs_active")
        bugs[id]=1; candidates[date_key(id)]=id
    } else {
        if (id in todos) finding("duplicate-todo-id", id, "todos")
        todos[id]=1
        if (n==expected) {
            todo_files[f[6]]=1
            todo_file_rows[f[6]]++
            todo_status[f[6]]=tolower(trim(f[10]))
            todo_blocker[f[6]]=trim(f[9])
        }
    }
    next
}
{
    path=$0; rel=substr(path,length(root)+2)
    isbug=(index(rel,"doc/08_tracking/bug/")==1)
    base=path; sub(/^.*\//,"",base)
    id=base; sub(/\.md$/,"",id)
    canonical=id
    if (isbug && (id in bug_alias)) canonical=bug_alias[id]
    if (isbug) {
        documents[canonical]=1
        if (id!=canonical && (id in bugs) && (canonical in bugs))
            finding("duplicate-bug-semantic-id",rel,"alias-id=" id ";canonical-id=" canonical)
    }
    if (base=="README.md" || base=="recent_bugs.md" || base ~ /^triage_|^bug_report/) next
    found=0; value=""; fence=0; generated=0; lineno=0; markers=0
    while ((rc=(getline line < path))>0) {
        lineno++
        if (line ~ /^[ \t]*```|^[ \t]*~~~/) { fence=!fence; continue }
        if (fence) continue
        if (lineno<=6 && line ~ /\*\*Generated:\*\*|^Generated:/) generated=1
        plain=line; gsub(/[*_`]/,"",plain); plain=trim(plain); sub(/^-[ \t]*/,"",plain)
        if (!found && tolower(plain) ~ /^status[ \t]*:/) {
            value=plain; sub(/^[^:]*:[ \t]*/,"",value); found=lineno
        }
        if (line ~ /^[ \t]*#[ \t]*(TODO|FIXME):/) markers++
    }
    close(path)
    if (rc<0) { finding("unreadable-document",rel,""); incomplete=1; next }
    if (generated) next
    docs++
    # Marker-only TODO notes require owner triage; do not invent a status.
    if (!found && markers && !isbug && !(rel in todo_files))
        finding("todo-marker-without-row",rel,"no explicit Status; owner triage required")
    if (!found || !unresolved(value)) next
    explicit++
    if (isbug && !(canonical in bugs)) {
        near=candidates[date_key(id)]
        detail="Status: " value
        if (near!="") detail=detail ";candidate-id=" near
        finding("unregistered-bug-document",rel,detail)
    }
    if (!isbug) {
        if (!(rel in todo_files)) {
            finding("unregistered-todo-document",rel,"Status: " value)
        } else if (todo_file_rows[rel]==1 && lifecycle(value)=="blocked") {
            if (todo_status[rel]!="blocked")
                finding("todo-status-mismatch",rel,"document=blocked;database=" todo_status[rel])
            else if (todo_blocker[rel]=="")
                finding("todo-blocker-missing",rel,"blocked TODO requires a nonempty blocker")
        }
    }
}
END {
    for (id in bugs) if (!(id in documents))
        finding("bug-row-without-exact-document",id,"review source-only record or author an explicit document mapping; do not infer closure")
    if (!rows || !docs || incomplete) {
        print "ERROR incomplete-scan rows=" rows+0 " documents=" docs+0
        exit 2
    }
    print (findings ? "FAIL" : "PASS") " rows=" rows " documents=" docs " explicit-unresolved=" explicit+0 " findings=" findings+0
    exit findings ? 1 : 0
}' "$bug/bug_db.sdn" "$todo/todo_db.sdn" "$files"
