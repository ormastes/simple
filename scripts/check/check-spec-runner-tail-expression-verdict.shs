#!/bin/sh
# Positive control for the two spec-harness false-verdict mechanisms that the
# spec corpus itself cannot police, because BOTH of them corrupt the very
# surface a spec would be judged by.
#
# 1. spec_runner_describe_tail_expression_exit_code (fixed f9c0447dc25)
#    `describe(...)` as the TAIL EXPRESSION of `fn main()` evaluates to a
#    constant 1. Simple returns a function's tail expression and for `main`
#    that becomes the process exit status, so a wholly PASSING spec of that
#    shape hands the runner code=1 and the `code != 0` clamp manufactured
#    "Results: 1 total, 0 passed, 1 failed". The constant is outcome-blind, so
#    exit-status gating on these files was vacuous in BOTH directions.
#
# 2. spec_runner_verdict_dropped_gate_reverted (this fence's second half)
#    `dropped = declared - executed` counts examples a file DECLARED but never
#    ran. Both verdict-trusting bypasses in the runner must require dropped==0
#    or they greenwash a file that silently ran a fraction of itself. That gate
#    was landed by 24cfc32db98 and then SILENTLY REVERTED by db31e93217d, a
#    commit whose subject line is about an unrelated OOB sentinel doc. A source
#    invariant is the only cheap way to notice the next such revert, since the
#    runtime precondition (a real dropped>0 verdict) cannot be synthesised from
#    a fixture.
#
# MUST be invoked with --no-session-daemon: test_should_use_single_runner()
# (src/compiler_rust/driver/src/main.rs) requires that literal flag, so a plain
# `bin/simple test <spec>` never reaches test_runner_single.spl at all and a
# control lacking the flag would pass identically with the fix reverted.
set -eu

SIMPLE_BIN=${SIMPLE_BIN:-bin/simple}
RUNNER=src/app/test_runner_new/test_runner_single.spl
# NOT under build/: parallel sessions sweep that directory, and this guard's
# scratch dir was measured VANISHING mid-run (2026-08-17) -- the first two cases
# wrote their logs fine, then `cannot create .../cured_pass.log: Directory
# nonexistent`, reported as `FAIL: cured_pass expected GREEN, got exit 2`. That
# reads as a real spec-runner regression when it is only a swept directory, and
# it blocked a push on evidence that was never produced. mktemp -d is private to
# this process and outside the swept tree.
ROOT="${TMPDIR:-/tmp}/spec-runner-tail-expression.$$"
FAILURES=0
ERRORS=0

cleanup() { rm -rf "$ROOT"; }
trap cleanup EXIT HUP INT TERM
mkdir -p "$ROOT"

# --- Part 1: runtime control on the tail-expression shape -------------------

# A: `describe` IS the tail expression of `fn main()`, example passes.
#    Pre-fix this exited 1. Must be GREEN.
cat >"$ROOT/tail_pass_spec.spl" <<'EOF'
use std.spec.*

fn main():
    describe "tail-expression control":
        it "passes":
            expect(1).to_equal(1)
EOF

# B: same shape, example FAILS. Must stay RED -- proves the fix did not swap a
#    false RED for a false GREEN.
cat >"$ROOT/tail_fail_spec.spl" <<'EOF'
use std.spec.*

fn main():
    describe "tail-expression negative control":
        it "fails on purpose":
            expect(1).to_equal(2)
EOF

# C: cured twin -- ANY statement after the block restores a meaningful exit
#    status. Must be GREEN both before and after the fix (invariance check).
cat >"$ROOT/cured_pass_spec.spl" <<'EOF'
use std.spec.*

fn main():
    describe "cured twin control":
        it "passes":
            expect(1).to_equal(1)
    print "done"
EOF

run_case() {
    expected=$1
    label=$2
    spec=$3
    if timeout -k 5s 180s "$SIMPLE_BIN" test "$spec" --no-session-daemon \
        >"$ROOT/$label.log" 2>&1; then
        actual=0
    else
        actual=$?
    fi
    # 124/137 = the timeout(1) budget, 139 = SIGSEGV, 143 = external kill
    # (earlyoom). NONE of these is a verdict, and a fence policing false REDs
    # must not manufacture one: a loaded machine would otherwise turn a spec
    # that never got to report into a RED. Route them to ERROR/exit 2 --
    # "could not determine", per the PASS/FAIL/ERROR -> 0/1/2 contract in
    # .claude/rules/vcs.md -- never to FAIL.
    case "$actual" in
        124|137|139|143)
            echo "ERROR — nothing was checked: $label produced no verdict (exit $actual)" >&2
            tail -n 10 "$ROOT/$label.log" >&2
            ERRORS=$((ERRORS + 1))
            return
            ;;
    esac
    if [ "$expected" = "green" ] && [ "$actual" -ne 0 ]; then
        echo "FAIL: $label expected GREEN, got exit $actual" >&2
        tail -n 20 "$ROOT/$label.log" >&2
        FAILURES=$((FAILURES + 1))
    elif [ "$expected" = "red" ] && [ "$actual" -eq 0 ]; then
        echo "FAIL: $label expected RED, got exit 0" >&2
        tail -n 20 "$ROOT/$label.log" >&2
        FAILURES=$((FAILURES + 1))
    else
        echo "ok: $label -> exit $actual (expected $expected)"
    fi
}

run_case green tail_pass "$ROOT/tail_pass_spec.spl"
run_case red   tail_fail "$ROOT/tail_fail_spec.spl"
run_case green cured_pass "$ROOT/cured_pass_spec.spl"

# --- Part 2: source invariant on the dropped= gate --------------------------

if [ ! -f "$RUNNER" ]; then
    echo "ERROR — nothing was checked: $RUNNER not found (run from the repo root)" >&2
    exit 2
fi

# /usr/bin/grep, never bare `grep`: the repo's bare `grep` is a wrapped ugrep
# that honours .gitignore, and every verdict below rests on -c/-v semantics.
GREP=/usr/bin/grep

# The runner must PARSE dropped= at all.
if ! "$GREP" -q ' dropped=' "$RUNNER"; then
    echo "FAIL: $RUNNER no longer parses the verdict's dropped= field" >&2
    FAILURES=$((FAILURES + 1))
fi

# POSITIVE FLOOR FIRST. `matches | grep -vc pattern` yields 0 when the OUTER
# pattern matches nothing, so renaming `verdict_executed` would silently disarm
# the invariant below. Assert the sites still exist before judging them.
sites=$("$GREP" -c 'verdict_executed > 0' "$RUNNER" || true)
if [ "$sites" -lt 2 ]; then
    echo "FAIL: expected >=2 'verdict_executed > 0' bypass sites in $RUNNER, found $sites" >&2
    echo "      (the invariant below cannot judge sites it cannot see -- if these were" >&2
    echo "       renamed, update this fence deliberately rather than letting it pass)" >&2
    FAILURES=$((FAILURES + 1))
fi

# Every line that treats a SPEC FILE VERDICT as positive evidence -- i.e. that
# tests `verdict_executed > 0` -- must also require verdict_dropped == 0.
ungated=$("$GREP" -n 'verdict_executed > 0' "$RUNNER" \
    | "$GREP" -vc 'verdict_dropped == 0' || true)
if [ "$ungated" -ne 0 ]; then
    echo "FAIL: $ungated verdict-trusting bypass(es) in $RUNNER are not gated on verdict_dropped == 0" >&2
    "$GREP" -n 'verdict_executed > 0' "$RUNNER" | "$GREP" -v 'verdict_dropped == 0' >&2
    FAILURES=$((FAILURES + 1))
fi

gated=$("$GREP" -c 'verdict_dropped == 0' "$RUNNER" || true)
if [ "$gated" -lt 2 ]; then
    echo "FAIL: expected at least 2 verdict_dropped == 0 gates in $RUNNER, found $gated" >&2
    FAILURES=$((FAILURES + 1))
fi

if [ "$FAILURES" -ne 0 ]; then
    echo "FAIL — $FAILURES check(s) failed"
    exit 1
fi
if [ "$ERRORS" -ne 0 ]; then
    # A real FAIL outranks an ERROR (checked above); an ERROR alone means the
    # run could not be judged. Exit 2, never 0 -- an inconclusive run must not
    # read as a pass.
    echo "ERROR — nothing was checked: $ERRORS runtime case(s) produced no verdict"
    exit 2
fi
echo "PASS — 3 runtime case(s) and 4 source invariant(s) checked"
