#!/bin/sh
# Compile and run the real hosted C runtime's tagged-text concat contract.
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
out_dir=${SIMPLE_CONCAT_CHECK_OUT:-"$repo_root/build/native_probe/runtime-concat-nul"}
cc_bin=${CC:-cc}
mkdir -p "$out_dir"
"$cc_bin" -std=c11 -O1 -g -pthread -D_GNU_SOURCE \
    -ffunction-sections -fdata-sections -I"$repo_root/src/runtime" \
    "$repo_root/test/01_unit/runtime/runtime_concat_nul_test.c" \
    "$repo_root/src/runtime/runtime_native.c" \
    -Wl,--gc-sections -ldl -lm -o "$out_dir/runtime_concat_nul_test" \
    >"$out_dir/compile.log" 2>&1
"$out_dir/runtime_concat_nul_test" >"$out_dir/run.log" 2>&1
cat "$out_dir/run.log"
