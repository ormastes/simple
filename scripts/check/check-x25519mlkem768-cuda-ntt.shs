#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
kernel="$repo_root/src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_forward.ptx"
probe_source="$repo_root/test/fixtures/crypto/x25519mlkem768/cuda_ntt_probe.c"
ptxas_bin=${PTXAS:-/usr/local/cuda-13.0/bin/ptxas}
cc_bin=${CC:-cc}
cuda_include=${CUDA_INCLUDE:-/usr/local/cuda-13.0/include}
cuda_lib=${CUDA_LIB:-/usr/lib/x86_64-linux-gnu}
nvidia_smi_bin=${NVIDIA_SMI:-nvidia-smi}
tmp_dir=$(mktemp -d /tmp/x25519mlkem768-cuda-ntt.XXXXXX)
artifact_dir=${X25519MLKEM768_CUDA_ARTIFACT_DIR:-$repo_root/build/evidence/x25519mlkem768/cuda}
perf_samples=${CUDA_NTT_PERF_SAMPLES:-0}
canonical_minimum_speedup_milli=1250
minimum_speedup_milli=${CUDA_NTT_PERF_MIN_SPEEDUP_MILLI:-$canonical_minimum_speedup_milli}

cleanup() {
    case "$tmp_dir" in
        /tmp/x25519mlkem768-cuda-ntt.*) rm -rf -- "$tmp_dir" ;;
        *) echo "refusing unsafe cleanup target: $tmp_dir" >&2 ;;
    esac
}
trap cleanup EXIT HUP INT TERM

if [ ! -x "$ptxas_bin" ]; then
    echo "STATUS: BLOCKED ptxas unavailable: $ptxas_bin"
    exit 2
fi
if ! command -v "$nvidia_smi_bin" >/dev/null 2>&1; then
    echo "STATUS: BLOCKED nvidia-smi unavailable: $nvidia_smi_bin"
    exit 2
fi
case "$perf_samples" in
    ''|*[!0-9]*) echo "STATUS: FAIL CUDA_NTT_PERF_SAMPLES must be numeric"; exit 1 ;;
esac
case "$minimum_speedup_milli" in
    ''|*[!0-9]*) echo "STATUS: FAIL CUDA_NTT_PERF_MIN_SPEEDUP_MILLI must be numeric"; exit 1 ;;
esac
if [ "$minimum_speedup_milli" -lt "$canonical_minimum_speedup_milli" ]; then
    echo "STATUS: FAIL CUDA_NTT_PERF_MIN_SPEEDUP_MILLI cannot be lower than canonical minimum $canonical_minimum_speedup_milli"
    exit 1
fi
if [ "$perf_samples" -ne 0 ] && [ "$perf_samples" -lt 30 ]; then
    echo "STATUS: FAIL CUDA_NTT_PERF_SAMPLES must be zero or at least 30"
    exit 1
fi

mkdir -p "$tmp_dir/modules"
mkdir -p "$artifact_dir"
checker_sha256=$(sha256sum "$0" | awk '{print $1}')
probe_sha256=$(sha256sum "$probe_source" | awk '{print $1}')
ptx_sha256=$(sha256sum "$kernel" | awk '{print $1}')
capabilities=$($nvidia_smi_bin --query-gpu=compute_cap \
    --format=csv,noheader,nounits | tr -d ' ' | sort -u)
if [ -z "$capabilities" ]; then
    echo "STATUS: BLOCKED no CUDA device capabilities reported"
    exit 2
fi
for capability in $capabilities; do
    case "$capability" in
        [0-9]*.[0-9]*) ;;
        *) echo "STATUS: FAIL invalid CUDA capability: $capability"; exit 1 ;;
    esac
    architecture=$(printf '%s' "$capability" | tr -d '.')
    artifact="$tmp_dir/modules/sm_$architecture.cubin"
    rebuild_artifact="$tmp_dir/rebuild-sm_$architecture.cubin"
    "$ptxas_bin" -arch="sm_$architecture" "$kernel" -o "$artifact"
    "$ptxas_bin" -arch="sm_$architecture" "$kernel" -o "$rebuild_artifact"
    if ! cmp -s "$artifact" "$rebuild_artifact"; then
        echo "STATUS: FAIL nondeterministic cubin rebuild for sm_$architecture"
        exit 1
    fi
    artifact_sha256=$(sha256sum "$artifact" | awk '{print $1}')
    echo "cuda_binary_sha256_sm_$architecture=$artifact_sha256"
    echo "cuda_binary_deterministic_rebuild_sm_$architecture=pass"
done
"$cc_bin" -std=c11 -O2 -Wall -Wextra -Werror \
    -I"$cuda_include" "$probe_source" -L"$cuda_lib" -lcuda \
    -o "$tmp_dir/cuda_ntt_probe"
if [ "$perf_samples" -gt 0 ]; then
    perf_output="$tmp_dir/cuda_ntt_perf_receipt.txt"
    perf_status=0
    {
        echo "CUDA_NTT_PERF_RECEIPT scope=narrow-c-scalar-forward-ntt-cuda-comparison production_promotion=false"
        echo "CUDA_NTT_PERF_POLICY canonical_minimum_speedup_milli=$canonical_minimum_speedup_milli requested_minimum_speedup_milli=$minimum_speedup_milli tested_batches=1,3,8,16,32,64,128,256,512,1024 supported_range_rule=earliest-sustained-through-1024"
        echo "CUDA_NTT_PERF_HASH kind=checker sha256=$checker_sha256 path=scripts/check/check-x25519mlkem768-cuda-ntt.shs"
        echo "CUDA_NTT_PERF_HASH kind=probe sha256=$probe_sha256 path=test/fixtures/crypto/x25519mlkem768/cuda_ntt_probe.c"
        echo "CUDA_NTT_PERF_HASH kind=ptx sha256=$ptx_sha256 path=src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_forward.ptx"
        for capability in $capabilities; do
            architecture=$(printf '%s' "$capability" | tr -d '.')
            artifact="$tmp_dir/modules/sm_$architecture.cubin"
            artifact_sha256=$(sha256sum "$artifact" | awk '{print $1}')
            echo "CUDA_NTT_PERF_HASH kind=cubin capability=sm_$architecture sha256=$artifact_sha256"
        done
        echo "CUDA_NTT_PERF_GAPS pure_simple=false inverse_perf=false full_mlkem=false rss=false"
    } >"$perf_output"
    "$tmp_dir/cuda_ntt_probe" "$tmp_dir/modules" "$perf_samples" \
        "$minimum_speedup_milli" >>"$perf_output" 2>&1 || perf_status=$?
    cat "$perf_output"
    cp "$perf_output" "$artifact_dir/cuda_ntt_perf_receipt.txt"
    echo "cuda_perf_receipt=$artifact_dir/cuda_ntt_perf_receipt.txt"
    if [ "$perf_status" -ne 0 ]; then
        echo "STATUS: FAIL X25519MLKEM768 CUDA NTT performance gate"
        exit "$perf_status"
    fi
else
    "$tmp_dir/cuda_ntt_probe" "$tmp_dir/modules"
fi
for capability in $capabilities; do
    architecture=$(printf '%s' "$capability" | tr -d '.')
    cp "$tmp_dir/modules/sm_$architecture.cubin" \
        "$artifact_dir/sm_$architecture.cubin"
done
echo "cuda_artifact_dir=$artifact_dir"
echo "STATUS: PASS X25519MLKEM768 CUDA NTT physical evidence"
