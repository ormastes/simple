#!/bin/sh
# Guard: two engine-level correctness rows that both used to fail SILENTLY.
#
# Regression guard for
#   doc/08_tracking/bug/interp_static_fn_new_hijacks_named_ctor_2026-07-02.md
#   doc/08_tracking/bug/jit_does_not_enforce_val_block_scope_2026-08-17.md
#
# WHY A PROBE AND NOT A SPEC: both rows are about what an ENGINE does with a
# whole program — one of them is a construction that must be REJECTED, the
# other a binding that must go out of scope. A spec body cannot assert "this
# file must not compile", and on hosts whose deployed CLI cannot load
# `std.spec` at all the spec runner is unavailable. A plain `run` of a 12-line
# probe works everywhere.
#
# Case 1 — named-argument construction must bind against class FIELDS.
#   `Widget(id: 3, size: 4)` must construct with id=3, size=4 even though the
#   class also declares `static fn new(path, size)`. A name taken from `new`'s
#   PARAMETER list but absent from the fields (`Font(path: …)`) must be a LOUD
#   error. Measured on the deployed 2026-07-25 seed: it exited 0 and built a
#   corrupt instance instead.
#
# Case 2 — a `val` declared in one `if` body must not be visible in a SIBLING
#   `if` body. Measured on the deployed 2026-07-25 seed: exit 0, printing 7 —
#   the binding leaked, which is exactly how a real PASETO defect stayed alive.
#
# Compiler under test: ${SIMPLE_BIN:-$ROOT/bin/simple} — never hardcoded, per
# doc/08_tracking/bug/guards_hardcode_stale_seed_binary_census_2026-08-17.md
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> case(s) checked, 0 wrong     exit 0
#   FAIL  — <n> case(s) checked, <k> wrong   exit 1
#   ERROR — nothing was checked              exit 2   (never a pass)

set -u

ROOT=$(cd "$(dirname "$0")/.." && cd .. && pwd)
SIMPLE="${SIMPLE_BIN:-$ROOT/bin/simple}"

if [ ! -x "$SIMPLE" ]; then
    echo "ERROR — nothing was checked (no $SIMPLE)"
    exit 2
fi

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

cat > "$TMP/fields.spl" <<'PROBE'
class Widget:
    id: i64
    size: i64
    static fn new(path: text, size: i64) -> Widget:
        Widget(id: 0, size: size)

fn main():
    val w = Widget(id: 3, size: 4)
    print("id=" + w.id.to_text() + " size=" + w.size.to_text())
main()
PROBE

cat > "$TMP/nonfield.spl" <<'PROBE'
class Font:
    id: i64
    size: i64
    static fn new(path: text, size: i64) -> Font:
        Font(id: 99, size: size)

fn main():
    val f = Font(path: "x", size: 8)
    print("id=" + f.id.to_text() + " size=" + f.size.to_text())
main()
PROBE

cat > "$TMP/valscope.spl" <<'PROBE'
fn f(n: i64) -> i64:
    var acc = 0
    if n > 1:
        val idx3 = 7
    if n > 2:
        acc = idx3
    acc

fn main():
    print(f(5).to_text())
main()
PROBE

CHECKED=0
FAILED=""

# Case 1a: field-named construction must succeed with the given field values.
CHECKED=$((CHECKED + 1))
"$SIMPLE" run "$TMP/fields.spl" > "$TMP/o1" 2>&1
_rc1=$?
if [ "$_rc1" -ne 0 ] || ! grep -q 'id=3 size=4' "$TMP/o1"; then
    FAILED="$FAILED field_named_ctor(rc=$_rc1)"
fi

# Case 1b: a name that is a `new` parameter but NOT a field must be rejected.
# Silent success here is the defect; any non-zero exit is the correct outcome.
CHECKED=$((CHECKED + 1))
"$SIMPLE" run "$TMP/nonfield.spl" > "$TMP/o2" 2>&1
_rc2=$?
if [ "$_rc2" -eq 0 ]; then
    FAILED="$FAILED nonfield_ctor_accepted(built $(grep -o 'id=[0-9]* size=[0-9]*' "$TMP/o2" | head -1))"
fi

# Case 2: a `val` from one if-body must not resolve in a sibling if-body.
CHECKED=$((CHECKED + 1))
"$SIMPLE" run "$TMP/valscope.spl" > "$TMP/o3" 2>&1
_rc3=$?
if [ "$_rc3" -eq 0 ]; then
    FAILED="$FAILED val_leaked_across_sibling_if(printed $(tail -1 "$TMP/o3"))"
fi

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi

if [ -n "$FAILED" ]; then
    echo "FAIL — $CHECKED case(s) checked, wrong:$FAILED"
    exit 1
fi

echo "PASS — $CHECKED case(s) checked, 0 wrong"
exit 0
