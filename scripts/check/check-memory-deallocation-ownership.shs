#!/bin/sh
set -eu

fail() {
    echo "memory deallocation ownership: FAIL: $*" >&2
    exit 1
}

root=${SIMPLE_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)}

# RuntimeValue is a copyable tagged handle. The listed hosted generic catch-all
# authorities deliberately expose neither tracing-GC nor generic value-free
# entry points. Selected string owners and the C deep-array owner are audited
# separately below; this guard makes no whole-runtime ownership claim.
retired_runtime_value_apis='rt_gc_init rt_gc_malloc rt_gc_collect gc_init gc_malloc gc_collect rt_value_free value_free'

scan_retired_runtime_value_api() {
    # 0 = producer found, 1 = clean, 2 = unreadable/incomplete scan.
    _tree=$1
    [ -e "$_tree" ] && [ -r "$_tree" ] || return 2
    _list=$(mktemp) || return 2
    if [ -d "$_tree" ]; then
        find "$_tree" -type f \( -name '*.spl' -o -name '*.rs' -o -name '*.c' -o -name '*.h' \) \
            ! -path '*/vendor/*' ! -path '*/test/*' ! -path '*/tests/*' > "$_list" || {
                rm -f "$_list"
                return 2
            }
    else
        printf '%s\n' "$_tree" > "$_list"
    fi
    while IFS= read -r _source; do
        [ -r "$_source" ] || { rm -f "$_list"; return 2; }
        for _symbol in $retired_runtime_value_apis; do
            # Producers only: Simple/Rust/C declarations or definitions, and
            # the two compiler provider registries. Prose mentioning a retired
            # spelling is not itself authority and must not trip this guard.
            _producer_re="^[[:space:]]*(extern[[:space:]]+)?fn[[:space:]]+${_symbol}[[:space:]]*\(|^[[:space:]]*(pub[[:space:]]+)?(unsafe[[:space:]]+)?(extern([[:space:]]+\"[^\"]+\")?[[:space:]]+)?fn[[:space:]]+${_symbol}[[:space:]]*\(|^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]]*[[:space:]\*]+${_symbol}[[:space:]]*\(|RuntimeFuncSpec::new\(\"${_symbol}\"|insert_simple!\(\"${_symbol}\""
            if grep -E -q "$_producer_re" "$_source"; then
                rm -f "$_list"
                return 0
            else
                _grep_status=$?
                if [ "$_grep_status" -ne 1 ]; then
                    rm -f "$_list"
                    return 2
                fi
            fi
        done
    done < "$_list"
    rm -f "$_list"
    return 1
}

require_ordered_arena_release() {
    _allocator=$1
    _body=$(awk '
        /^    me release\(\):/ { in_release = 1 }
        in_release && seen && /^    (me|fn) [A-Za-z_]/ { exit }
        in_release { print; seen = 1 }
    ' "$_allocator") || return 1
    [ "$(printf '%s\n' "$_body" | grep -c 'sys_free(self.buffer, self.capacity, 8)')" -eq 1 ] || return 1
    _free=$(printf '%s\n' "$_body" | grep -n -m1 'sys_free(self.buffer, self.capacity, 8)' | cut -d: -f1)
    _buffer=$(printf '%s\n' "$_body" | grep -n -m1 'self.buffer = \[\]' | cut -d: -f1)
    _capacity=$(printf '%s\n' "$_body" | grep -n -m1 'self.capacity = 0' | cut -d: -f1)
    _offset=$(printf '%s\n' "$_body" | grep -n -m1 'self.offset = 0' | cut -d: -f1)
    _allocated=$(printf '%s\n' "$_body" | grep -n -m1 'self.allocated = 0' | cut -d: -f1)
    [ -n "$_free" ] && [ -n "$_buffer" ] && [ -n "$_capacity" ] && \
        [ -n "$_offset" ] && [ -n "$_allocated" ] || return 1
    [ "$_free" -lt "$_buffer" ] && [ "$_buffer" -lt "$_capacity" ] && \
        [ "$_capacity" -lt "$_offset" ] && [ "$_offset" -lt "$_allocated" ]
}

selftest() {
    _tmp=$(mktemp -d) || return 1
    trap 'rm -rf "$_tmp"' EXIT INT TERM
    mkdir -p "$_tmp/authority"
    printf '%s\n' 'extern fn rt_value_int(value: i64) -> i64' > "$_tmp/authority/runtime.spl"
    if scan_retired_runtime_value_api "$_tmp/authority"; then
        echo 'memory deallocation ownership: selftest FAIL: clean authority rejected' >&2
        return 1
    else
        _status=$?
        [ "$_status" -eq 1 ] || {
            echo "memory deallocation ownership: selftest FAIL: clean authority returned $_status, expected 1" >&2
            return 1
        }
    fi
    for _symbol in $retired_runtime_value_apis; do
        printf 'extern fn %s()\n' "$_symbol" > "$_tmp/authority/runtime.spl"
        if scan_retired_runtime_value_api "$_tmp/authority"; then
            :
        else
            _status=$?
            echo "memory deallocation ownership: selftest FAIL: retired $_symbol resurrection accepted" >&2
            echo "memory deallocation ownership: selftest detail: scanner returned $_status, expected 0" >&2
            return 1
        fi
    done
    printf '%s\n' 'extern fn rt_value_int(value: i64) -> i64' > "$_tmp/authority/runtime.spl"
    printf '%s\n' 'pub extern "C" fn rt_gc_init() {}' > "$_tmp/authority/runtime.rs"
    scan_retired_runtime_value_api "$_tmp/authority" || {
        echo 'memory deallocation ownership: selftest FAIL: Rust ABI producer accepted' >&2
        return 1
    }
    rm -f "$_tmp/authority/runtime.rs"
    printf '%s\n' 'void *rt_gc_malloc(long size) { return 0; }' > "$_tmp/authority/runtime.c"
    scan_retired_runtime_value_api "$_tmp/authority" || {
        echo 'memory deallocation ownership: selftest FAIL: C pointer-return producer accepted' >&2
        return 1
    }
    rm -f "$_tmp/authority/runtime.c"
    if scan_retired_runtime_value_api "$_tmp/missing"; then
        echo 'memory deallocation ownership: selftest FAIL: missing authority accepted' >&2
        return 1
    else
        _status=$?
        [ "$_status" -eq 2 ] || {
            echo "memory deallocation ownership: selftest FAIL: missing authority returned $_status, expected 2" >&2
            return 1
        }
    fi
    echo 'memory deallocation ownership: selftest PASS'
}

if [ "${1:-}" = '--selftest' ]; then
    selftest
    exit $?
fi

for mode in gc_async_mut nogc_async_mut nogc_sync_mut; do
    allocator="$root/src/lib/$mode/allocator.spl"
    gc="$root/src/lib/$mode/gc.spl"

    require_ordered_arena_release "$allocator" || \
        fail "$mode arena release must free once, then clear buffer/capacity/cursor/accounting in order"

    grep -q 'if not self.objects.?:' "$gc" || fail "$mode GC does not detect an empty heap"
    grep -q 'self.young_alloc.release()' "$gc" || fail "$mode empty-heap sweep does not release its arena"
    grep -q 'if self.young_alloc.capacity == 0:' "$gc" || fail "$mode GC does not lazily restore a released arena"
done

# Adjacent explicit allocation families must retain their shared native owner.
grep -q 'void rt_free(uint8_t\* ptr)' "$root/src/runtime/runtime_memory.c" || fail 'hosted runtime lacks rt_free'
grep -q 'free(ptr);' "$root/src/runtime/runtime_memory.c" || fail 'hosted rt_free does not reach libc free'
grep -q 'void spl_free(void\* ptr)' "$root/src/runtime/runtime.c" || fail 'runtime allocator owner is missing'

# Fail closed if a declaration, wrapper, registry entry, interpreter provider,
# or native provider resurrects the retired generic GC/value-free authority.
# A new ownership model needs an explicit replacement contract, not a symbolic
# alias back to these providerless APIs.
for authority in \
    "$root/src/compiler/70.backend" \
    "$root/src/lib/nogc_sync_mut/sffi" \
    "$root/src/lib/nogc_async_mut/sffi" \
    "$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs" \
    "$root/src/compiler_rust/compiler/src/interpreter_extern" \
    "$root/src/runtime" \
    "$root/src/compiler_rust/runtime/src"
do
    if scan_retired_runtime_value_api "$authority"; then
        fail "retired generic GC/value-free producer resurrected under ${authority#"$root"/}"
    else
        status=$?
        [ "$status" -eq 1 ] || fail "could not completely read retired-API authority ${authority#"$root"/}"
    fi
done

# Selected string owners in the two native providers must preserve the same
# conservative no-refcount rule: registry removal admits at most one freeing
# caller and shared strings are refused. This is only a lexical preflight for
# the single-threaded owner contract, not proof of all deep-free parity.
c_owner="$root/src/runtime/runtime_native.c"
c_tests="$root/src/runtime/test"
rust_owner="$root/src/compiler_rust/runtime/src/value/collections.rs"

grep -q 'This runtime has no refcounting and RuntimeValue is Copy' "$c_owner" || fail 'C string owner no longer states the no-refcount invariant'
grep -q 'if (!rt_core_unregister_string(s)) return 0;' "$c_owner" || fail 'C string free no longer refuses foreign or already-freed values'
grep -q 'RT_CORE_STRING_FLAG_SHARED) return 0;' "$c_owner" || fail 'C string free no longer refuses shared values'
grep -q 'rt_string_free(int64_t value)' "$c_owner" || fail 'C string owner is missing'
grep -q 'rt_array_free_deep(int64_t value)' "$c_owner" || fail 'C deep-array owner is missing'
grep -E -q 'rt_string_free\([^)]*\)[[:space:]]*==[[:space:]]*0' "$c_tests/rt_string_free_selfcheck.c" || fail 'C string refusal assertion is missing'

grep -q 'no refcounting' "$rust_owner" || fail 'Rust owner no longer states the no-refcount invariant'
grep -q 'if !unregister_heap_ptr_checked(ptr as \*mut HeapHeader)' "$rust_owner" || fail 'Rust string free no longer refuses foreign or already-freed values'
grep -q 'RT_STRING_FLAG_SHARED) != 0' "$rust_owner" || fail 'Rust string free no longer refuses shared values'
grep -F -q 'assert_eq!(rt_string_free(s), 0, "double free refused")' "$rust_owner" || fail 'Rust string double-free refusal assertion is missing'

echo 'memory deallocation ownership: PASS'
