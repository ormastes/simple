#!/bin/sh
# check-type-walk-constructor-parity.shs
#
# Fails when the MATERIALIZATION walk over a parser `Type` handles a TypeKind
# constructor that the PROJECTION walk neither handles nor explicitly
# allowlists.
#
#   MATERIALIZATION  parser_type_named_dependencies
#                    src/compiler/10.frontend/parser_types_expr.spl
#   PROJECTION       imported_surface_type
#                    src/compiler/20.hir/hir_lowering/_Items/module_callable_types.spl
#
# The two walk the SAME parser type with DIFFERENT recursion sets. Every
# constructor in the first and not the second is a cross-module signature shape
# whose dependency is bound by materialization and then never consulted by
# projection -- it dies as a hard `unresolved type: X` blamed on an innocent
# importer, with no diagnostic naming the owner. Array-of-tuple, pointer and
# union all shipped that way and were each found the expensive way.
#
# Verdict is the LAST line of stdout:
#   PASS  — <n> constructor(s) checked, 0 unprojected and unallowlisted   (exit 0)
#   FAIL  — ...                                                          (exit 1)
#   ERROR — nothing was checked (<reason>)                               (exit 2)
# A run that compared 0 constructors is ERROR, never a pass.
#
# See doc/08_tracking/bug/hir_unresolved_type_owner_missing_import_2026-08-22.md

set -u

ROOT=${ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}
MAT_FILE="$ROOT/src/compiler/10.frontend/parser_types_expr.spl"
PROJ_FILE="$ROOT/src/compiler/20.hir/hir_lowering/_Items/module_callable_types.spl"
ALLOWLIST="$ROOT/scripts/check/type_walk_projection_allowlist.txt"

# Marker -> constructor map for the PROJECTION walk. It dispatches through
# accessor helpers rather than naming TypeKind constructors, so the mapping is
# explicit here. A new projection arm MUST add its marker to this list.
proj_markers() {
    printf '%s\n' \
        "parser_type_kind_named_name|Named" \
        "parser_type_kind_tuple_elements|Tuple" \
        "parser_type_kind_is_array|Array" \
        "parser_type_kind_array_element_name|Array" \
        "parser_type_kind_is_pointer|Pointer" \
        "parser_type_kind_union_members|Union" \
        "parser_type_kind_optional_inner|Optional" \
        "parser_type_kind_atomic_inner|Atomic" \
        "parser_type_kind_isolated_inner|Isolated" \
        "parser_type_kind_reference_inner|Reference" \
        "parser_type_kind_projection_base|Projection" \
        "parser_type_kind_function_params|Function" \
        "parser_type_kind_weak_inner|Weak"
}

# Body of the accumulator helper that owns the constructor dispatch, from its
# `fn` line to the next top-level `fn `/`# ===` boundary.
mat_body() {
    awk '/^fn parser_type_named_dependencies_into\(/{on=1; print; next} on && (/^fn /||/^# =/) {exit} on{print}' "$1"
}

# Keep the extractor coupled to the public entrypoint. If the helper is renamed
# or the wrapper stops delegating to it, constructor counts from dead code must
# not be accepted as coverage.
mat_wiring_ok() {
    awk '
        /^fn parser_type_named_dependencies\(/ {on=1; found_fn=1; stage=0; next}
        on && (/^fn /||/^# =/) {exit}
        on && (/^[[:space:]]*$/||/^[[:space:]]*#/||/^[[:space:]]*""".*"""[[:space:]]*$/) {next}
        on && stage == 0 && /^    var names: \[text\] = \[\]$/ {stage=1; next}
        on && stage == 1 && /^    parser_type_named_dependencies_into\(type_, names\)$/ {stage=2; next}
        on && stage == 2 && /^    names$/ {stage=3; next}
        on {bad=1}
        END {exit !(found_fn && stage == 3 && !bad)}
    ' "$1"
}

# Body of `me imported_surface_type(` up to the next `me ` at the same indent.
proj_body() {
    awk '/^    me imported_surface_type\(/{on=1; print; next} on && /^    me /{exit} on{print}' "$1"
}

mat_kinds() {
    mat_body "$MAT_FILE" \
        | grep -o 'TypeKind\.[A-Za-z_][A-Za-z0-9_]*' \
        | sed 's/TypeKind\.//' \
        | grep -v '^Infer$' \
        | sort -u
}

proj_kinds() {
    body=$(proj_body "$PROJ_FILE")
    proj_markers | while IFS='|' read -r marker kind; do
        case "$body" in
            *"$marker"*) printf '%s\n' "$kind" ;;
        esac
    done | sort -u
}

allow_kinds() {
    grep -v '^#' "$ALLOWLIST" 2>/dev/null | grep -v '^[[:space:]]*$' | awk '{print $1}' | sort -u
}

run_scan() {
    if [ ! -f "$MAT_FILE" ] || [ ! -f "$PROJ_FILE" ] || [ ! -f "$ALLOWLIST" ]; then
        echo "ERROR — nothing was checked (a required file is missing)"
        return 2
    fi
    if ! mat_wiring_ok "$MAT_FILE"; then
        echo "ERROR — nothing was checked (materialization wrapper no longer delegates to the extracted helper)"
        return 2
    fi
    MAT=$(mat_kinds)
    PROJ=$(proj_kinds)
    ALLOW=$(allow_kinds)
    N=$(printf '%s\n' "$MAT" | grep -c '[A-Za-z]')
    if [ "$N" -lt 5 ]; then
        echo "ERROR — nothing was checked (materialization walk yielded $N constructor(s); the extractor no longer matches the source)"
        return 2
    fi
    MISSING=""
    for k in $MAT; do
        printf '%s\n' "$PROJ" | grep -qx "$k" && continue
        printf '%s\n' "$ALLOW" | grep -qx "$k" && continue
        MISSING="$MISSING $k"
    done
    STALE=""
    for k in $ALLOW; do
        printf '%s\n' "$PROJ" | grep -qx "$k" && STALE="$STALE $k"
    done
    if [ -n "$MISSING" ] || [ -n "$STALE" ]; then
        MSG="FAIL — $N constructor(s) checked"
        [ -n "$MISSING" ] && MSG="$MSG; unprojected and unallowlisted:$MISSING"
        [ -n "$STALE" ] && MSG="$MSG; stale allowlist (now projected):$STALE"
        echo "$MSG"
        return 1
    fi
    echo "PASS — $N constructor(s) checked, 0 unprojected and unallowlisted"
    return 0
}

selftest() {
    TD=$(mktemp -d) || return 1
    fails=0
    # Fixture 1: a constructor materialized, not projected, not allowlisted -> FAIL
    mkdir -p "$TD/f1/src/compiler/10.frontend" "$TD/f1/src/compiler/20.hir/hir_lowering/_Items" "$TD/f1/scripts/check"
    cat > "$TD/f1/src/compiler/10.frontend/parser_types_expr.spl" <<'EOT'
fn parser_type_named_dependencies_into(type_: Type, mut names: [text]):
    if disc == rt_enum_discriminant(TypeKind.Named("", [])): return []
    if disc == rt_enum_discriminant(TypeKind.Tuple([])): return []
    if disc == rt_enum_discriminant(TypeKind.Array(p, nil)): return []
    if disc == rt_enum_discriminant(TypeKind.Union([])): return []
    if disc == rt_enum_discriminant(TypeKind.Pointer(p, false)): return []
    if disc == rt_enum_discriminant(TypeKind.Brandnew(p)): return []
fn parser_type_named_dependencies(type_: Type) -> [text]:
    var names: [text] = []
    parser_type_named_dependencies_into(type_, names)
    names
EOT
    cat > "$TD/f1/src/compiler/20.hir/hir_lowering/_Items/module_callable_types.spl" <<'EOT'
    me imported_surface_type(type_: Type, m: text) -> HirType:
        val n = parser_type_kind_named_name(type_.kind)
        val t = parser_type_kind_tuple_elements(type_.kind)
        val a = parser_type_kind_is_array(type_.kind)
        val u = parser_type_kind_union_members(type_.kind)
        val p = parser_type_kind_is_pointer(type_.kind)
    me next_thing():
        ()
EOT
    : > "$TD/f1/scripts/check/type_walk_projection_allowlist.txt"
    out=$(ROOT="$TD/f1" MAT_FILE="" sh "$0" --scan-only 2>&1); rc=$?
    case "$out" in
        *"FAIL"*Brandnew*) : ;;
        *) echo "selftest: fixture 1 (new unprojected constructor) did not FAIL naming it: $out"; fails=$((fails+1)) ;;
    esac
    # Fixture 2: same, but allowlisted -> PASS
    cp -r "$TD/f1" "$TD/f2"
    echo "Brandnew  fixture reason" > "$TD/f2/scripts/check/type_walk_projection_allowlist.txt"
    out=$(ROOT="$TD/f2" sh "$0" --scan-only 2>&1); rc=$?
    case "$out" in
        PASS*) : ;;
        *) echo "selftest: fixture 2 (allowlisted) did not PASS: $out"; fails=$((fails+1)) ;;
    esac
    # Fixture 3: stale allowlist (allowlisted AND projected) -> FAIL
    cp -r "$TD/f1" "$TD/f3"
    echo "Union  fixture reason" > "$TD/f3/scripts/check/type_walk_projection_allowlist.txt"
    out=$(ROOT="$TD/f3" sh "$0" --scan-only 2>&1); rc=$?
    case "$out" in
        *"stale allowlist"*Union*) : ;;
        *) echo "selftest: fixture 3 (stale allowlist) did not FAIL: $out"; fails=$((fails+1)) ;;
    esac
    # Fixture 4: extractor matches nothing -> ERROR, never a pass
    cp -r "$TD/f1" "$TD/f4"
    cat > "$TD/f4/src/compiler/10.frontend/parser_types_expr.spl" <<'EOT'
fn parser_type_named_dependencies_into(type_: Type, mut names: [text]):
    return
fn parser_type_named_dependencies(type_: Type) -> [text]:
    var names: [text] = []
    parser_type_named_dependencies_into(type_, names)
    names
EOT
    out=$(ROOT="$TD/f4" sh "$0" --scan-only 2>&1); rc=$?
    case "$out" in
        ERROR*) [ "$rc" = 2 ] || { echo "selftest: fixture 4 exit $rc, want 2"; fails=$((fails+1)); } ;;
        *) echo "selftest: fixture 4 (empty walk) did not ERROR: $out"; fails=$((fails+1)) ;;
    esac
    # Fixture 5: dispatch helper remains, but wrapper wiring drifts -> ERROR.
    cp -r "$TD/f1" "$TD/f5"
    cat > "$TD/f5/src/compiler/10.frontend/parser_types_expr.spl" <<'EOT'
fn parser_type_named_dependencies_into(type_: Type, mut names: [text]):
    if disc == rt_enum_discriminant(TypeKind.Named("", [])): return []
    if disc == rt_enum_discriminant(TypeKind.Tuple([])): return []
    if disc == rt_enum_discriminant(TypeKind.Array(p, nil)): return []
    if disc == rt_enum_discriminant(TypeKind.Union([])): return []
    if disc == rt_enum_discriminant(TypeKind.Pointer(p, false)): return []
fn parser_type_named_dependencies(type_: Type) -> [text]:
    var names: [text] = []
    # parser_type_named_dependencies_into(type_, names)
    parser_type_named_dependencies_elsewhere(type_, names)
    names
EOT
    out=$(ROOT="$TD/f5" sh "$0" --scan-only 2>&1); rc=$?
    case "$out" in
        *"wrapper no longer delegates"*) [ "$rc" = 2 ] || { echo "selftest: fixture 5 exit $rc, want 2"; fails=$((fails+1)); } ;;
        *) echo "selftest: fixture 5 (wrapper drift) did not ERROR: $out"; fails=$((fails+1)) ;;
    esac
    # Fixture 6: canonical call text after an early return is unreachable -> ERROR.
    cp -r "$TD/f1" "$TD/f6"
    awk '{print} /^fn parser_type_named_dependencies\(/{print "    return []"}' \
        "$TD/f6/src/compiler/10.frontend/parser_types_expr.spl" > "$TD/f6/parser_types_expr.tmp"
    mv "$TD/f6/parser_types_expr.tmp" "$TD/f6/src/compiler/10.frontend/parser_types_expr.spl"
    out=$(ROOT="$TD/f6" sh "$0" --scan-only 2>&1); rc=$?
    case "$out" in
        *"wrapper no longer delegates"*) [ "$rc" = 2 ] || { echo "selftest: fixture 6 exit $rc, want 2"; fails=$((fails+1)); } ;;
        *) echo "selftest: fixture 6 (early return) did not ERROR: $out"; fails=$((fails+1)) ;;
    esac
    # Fixture 7: --rev must read the COMMITTED tree — sources AND allowlist —
    # never the working checkout, and the two paths must genuinely DISAGREE.
    # This is what keeps the 2026-09-06 wrong-tree fix from rotting: if --rev
    # ever silently falls back to the working copy, this fixture fails.
    if ! command -v git >/dev/null 2>&1; then
        echo "selftest: fixture 7 skipped-as-failure — git unavailable, cannot verify --rev"
        fails=$((fails+1))
    else
        cp -r "$TD/f1" "$TD/f7"
        echo "Brandnew  fixture reason" > "$TD/f7/scripts/check/type_walk_projection_allowlist.txt"
        ( cd "$TD/f7" \
          && git init -q . \
          && git config user.email selftest@example.com \
          && git config user.name selftest \
          && git add -A && git commit -q -m committed ) >/dev/null 2>&1
        # Working copy ONLY: drop the allowlist entry that makes the committed
        # tree pass. A working-tree scan now FAILs naming Brandnew; a
        # committed-content scan must still PASS.
        : > "$TD/f7/scripts/check/type_walk_projection_allowlist.txt"
        out=$(ROOT="$TD/f7" sh "$0" --scan-only --rev HEAD 2>&1); rc=$?
        case "$out" in
            PASS*) : ;;
            *) echo "selftest: fixture 7 --rev did not read committed content: $out"; fails=$((fails+1)) ;;
        esac
        out=$(ROOT="$TD/f7" sh "$0" --scan-only 2>&1); rc=$?
        case "$out" in
            *"FAIL"*Brandnew*) : ;;
            *) echo "selftest: fixture 7 working-tree scan did not see the dirty allowlist: $out"; fails=$((fails+1)) ;;
        esac
    fi
    rm -rf "$TD"
    [ "$fails" = 0 ] && return 0
    echo "ERROR — nothing was checked (selftest failed: $fails fixture(s))"
    return 2
}

# --rev <REV> scans the COMMITTED tree at REV instead of the working checkout.
#
# Why it exists (2026-09-06): as a `tree`-mode push row this gate read the shared
# WORKING CHECKOUT, not the commit being pushed. `_ref` in
# run_manifest_push_gates is the sha off pre-push stdin, so under concurrent
# agent load a tree-mode row reports on content that is not being pushed. See
# doc/08_tracking/bug/push_gates_evaluate_working_checkout_not_pushed_commit_2026-09-06.md
#
# Only three files matter here, so the materialisation is exactly those three —
# INCLUDING the allowlist, because comparing committed sources against the
# working copy's allowlist is still a wrong-tree verdict.
MAT_REL=src/compiler/10.frontend/parser_types_expr.spl
PROJ_REL=src/compiler/20.hir/hir_lowering/_Items/module_callable_types.spl
ALLOW_REL=scripts/check/type_walk_projection_allowlist.txt

materialise_rev() {
    # $1 = rev. Echoes the scan root on success; returns non-zero on failure.
    _rev=$1
    _work=$(mktemp -d) || return 1
    MATERIALISED_WORK=$_work
    ( cd "$ROOT" && git archive "$_rev" -- "$MAT_REL" "$PROJ_REL" "$ALLOW_REL" ) 2>/dev/null \
        | tar -x -C "$_work" 2>/dev/null
    [ -f "$_work/$MAT_REL" ] || return 1
    printf '%s\n' "$_work"
}

MODE=full
REV=""
while [ $# -gt 0 ]; do
    case "$1" in
        --scan-only) MODE=scan; shift ;;
        --selftest) MODE=selftest; shift ;;
        --rev) [ $# -ge 2 ] || { echo "ERROR — nothing was checked (--rev needs a value)"; exit 2; }
               REV="$2"; shift 2 ;;
        --root) [ $# -ge 2 ] || { echo "ERROR — nothing was checked (--root needs a value)"; exit 2; }
               ROOT="$2"; shift 2 ;;
        *) echo "ERROR — nothing was checked (unknown argument $1)"; exit 2 ;;
    esac
done

if [ "$MODE" = selftest ]; then
    selftest
    exit $?
fi

SCAN_ROOT="$ROOT"
MATERIALISED_WORK=""
if [ -n "$REV" ]; then
    SCAN_ROOT=$(materialise_rev "$REV") || {
        [ -n "$MATERIALISED_WORK" ] && rm -rf "$MATERIALISED_WORK"
        echo "ERROR — nothing was checked (could not materialise $REV)"
        exit 2
    }
    trap 'rm -rf "$MATERIALISED_WORK"' EXIT INT TERM
fi

MAT_FILE="$SCAN_ROOT/$MAT_REL"
PROJ_FILE="$SCAN_ROOT/$PROJ_REL"
ALLOWLIST="$SCAN_ROOT/$ALLOW_REL"

if [ "$MODE" = scan ]; then
    run_scan
    exit $?
fi

selftest || exit 2
run_scan
exit $?
