#!/bin/sh
# Ratchet: a module name must not exist as both `X.spl` and a package dir
# `X/__init__.spl` (or `X/mod.spl`).
#
# Rule (doc/04_architecture/language/modules.md § "File vs package with the
# same name"): the pair is AMBIGUOUS — `ResolutionResult.Ambiguous` and
# `is_well_formed == false` in src/compiler/00.common/dependency/resolution.spl
# (Lean-mirrored model). Grandfathered pairs resolve FILE-FIRST in every
# loader. New pairs FAIL; a baselined pair that no longer exists is STALE and
# also FAILs, so the baseline only shrinks.
#
# Usage: sh scripts/check/check-module-file-dir-ambiguity.shs [--root DIR]
#        sh scripts/check/check-module-file-dir-ambiguity.shs --selftest
#        sh scripts/check/check-module-file-dir-ambiguity.shs --generate-baseline   (reviewed updates only)
# Verdict (last stdout line): PASS exit 0 / FAIL exit 1 / ERROR exit 2.
set -u

script_dir=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$script_dir/../.." && pwd)
baseline_name="scripts/check/module_file_dir_ambiguity_baseline.txt"
mode=scan

while [ $# -gt 0 ]; do
    case "$1" in
        --root) root=$2; shift 2 ;;
        --selftest) mode=selftest; shift ;;
        --generate-baseline) mode=generate; shift ;;
        *) echo "ERROR — nothing was checked (unknown argument: $1)"; exit 2 ;;
    esac
done

# Prints "<X.spl> <X/entry>" for each ambiguous pair under <root>/src.
list_pairs() {
    (cd "$1" && find src -name '*.spl' ! -name '__init__.spl' ! -name 'mod.spl' 2>/dev/null) | sort | while read -r f; do
        d="${f%.spl}"
        for e in __init__.spl mod.spl; do
            if [ -f "$1/$d/$e" ]; then
                echo "$f $d/$e"
                break
            fi
        done
    done
}

# scan <root> <baseline-file> -> verdict line, returns 0/1/2
scan() {
    s_root=$1
    s_base=$2
    if [ ! -d "$s_root/src" ]; then
        echo "ERROR — nothing was checked (no src/ under $s_root)"
        return 2
    fi
    s_files=$( (cd "$s_root" && find src -name '*.spl') | wc -l | tr -d ' ')
    if [ "$s_files" -eq 0 ]; then
        echo "ERROR — nothing was checked (0 .spl files under $s_root/src)"
        return 2
    fi
    s_tmp=$(mktemp)
    list_pairs "$s_root" | cut -d' ' -f1 > "$s_tmp"
    if [ -f "$s_base" ]; then
        s_known=$(grep -v '^#' "$s_base" | grep -v '^$' | sort)
    else
        s_known=""
    fi
    s_new=$(printf '%s\n' "$s_known" | comm -13 - "$s_tmp" | grep -v '^$')
    s_stale=$(printf '%s\n' "$s_known" | comm -23 - "$s_tmp" | grep -v '^$')
    s_pairs=$(wc -l < "$s_tmp" | tr -d ' ')
    rm -f "$s_tmp"
    if [ -n "$s_new" ] || [ -n "$s_stale" ]; then
        [ -n "$s_new" ] && printf 'new ambiguous file/package pair: %s\n' $s_new
        [ -n "$s_stale" ] && printf 'stale baseline entry (pair gone, remove it): %s\n' $s_stale
        echo "FAIL — $s_files file(s) checked, $s_pairs pair(s); new: $(echo $s_new); stale: $(echo $s_stale)"
        return 1
    fi
    echo "PASS — $s_files file(s) checked, $s_pairs grandfathered pair(s), 0 new, 0 stale"
    return 0
}

selftest() {
    t=$(mktemp -d)
    mkdir -p "$t/clean/src/lib/a" "$t/pair/src/lib/x" "$t/modpair/src/lib/y" "$t/empty/src"
    echo 'fn a(): 1' > "$t/clean/src/lib/a/__init__.spl"
    echo 'fn b(): 2' > "$t/clean/src/lib/b.spl"
    echo 'val V = 1' > "$t/pair/src/lib/x.spl"
    echo 'val V = 2' > "$t/pair/src/lib/x/__init__.spl"
    echo 'val V = 1' > "$t/modpair/src/lib/y.spl"
    echo 'val V = 2' > "$t/modpair/src/lib/y/mod.spl"
    : > "$t/nobase"
    echo "src/lib/x.spl" > "$t/xbase"
    ok=1
    scan "$t/clean" "$t/nobase" >/dev/null; [ $? -eq 0 ] || { echo "selftest: clean tree must PASS"; ok=0; }
    scan "$t/pair" "$t/nobase" >/dev/null; [ $? -eq 1 ] || { echo "selftest: new X.spl + X/__init__.spl must FAIL"; ok=0; }
    scan "$t/modpair" "$t/nobase" >/dev/null; [ $? -eq 1 ] || { echo "selftest: new X.spl + X/mod.spl must FAIL"; ok=0; }
    scan "$t/pair" "$t/xbase" >/dev/null; [ $? -eq 0 ] || { echo "selftest: baselined pair must PASS"; ok=0; }
    scan "$t/clean" "$t/xbase" >/dev/null; [ $? -eq 1 ] || { echo "selftest: stale baseline entry must FAIL"; ok=0; }
    scan "$t/empty" "$t/nobase" >/dev/null; [ $? -eq 2 ] || { echo "selftest: empty tree must ERROR"; ok=0; }
    rm -rf "$t"
    [ $ok -eq 1 ]
}

if ! selftest; then
    echo "ERROR — nothing was checked (selftest failed)"
    exit 2
fi
if [ "$mode" = selftest ]; then
    echo "PASS — selftest 6 fixture(s)"
    exit 0
fi
if [ "$mode" = generate ]; then
    {
        echo "# Grandfathered X.spl + X/__init__.spl|X/mod.spl pairs (file-first). Only shrink this list."
        list_pairs "$root" | cut -d' ' -f1
    } > "$root/$baseline_name"
    echo "PASS — baseline written: $baseline_name"
    exit 0
fi
scan "$root" "$root/$baseline_name"
exit $?
