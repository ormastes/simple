#!/bin/sh
set -eu
# Unit B3 (doc/03_plan/ui/testing/render_2d_vulkan_functional_coverage_plan_2026-08-07.md):
# container-run verification of the existing engine2d/render_opt/compositor/
# virtio-gpu 2D suite. Wraps the exact spec list the plan enumerates.
#
# Known finding (2026-08-08): every spec is green EXCEPT
# test/01_unit/os/compositor/engine2d_render_evidence_spec.spl, which fails
# to load (missing module os.kernel.arch.x86.render_capture_ack) BOTH
# in-container and on the bare host -- a pre-existing PRODUCT defect, not a
# container-environment artifact. Filed as
# doc/08_tracking/bug/engine2d_render_evidence_spec_missing_module_2026-08-08.md.
# This script reports that spec's failure honestly rather than hiding it.

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$REPO_ROOT"
IMG=simple-test-isolation:local

docker image inspect "$IMG" >/dev/null 2>&1 || \
  docker build -f "$REPO_ROOT/tools/docker/Dockerfile.test-isolation" -t "$IMG" "$REPO_ROOT/tools/docker"

SPECS="test/01_unit/lib/common/gpu/engine2d/scalar_oracle_spec.spl
test/01_unit/lib/common/ui/render_opt/draw_ir_delta_spec.spl
test/01_unit/lib/common/ui/render_opt/paint_chunk_rasterizer_spec.spl
test/01_unit/lib/common/ui/render_opt/render_opt_invalidation_spec.spl
test/01_unit/lib/nogc_sync_mut/gpu/engine2d/simd_isa_provider_spec.spl
test/01_unit/lib/nogc_sync_mut/gpu/engine2d/simd_span_batch_execute_spec.spl
test/01_unit/lib/gc_async_mut/gpu/engine2d/backend_software_kernel_table_bucket_spec.spl
test/01_unit/lib/gc_async_mut/gpu/engine2d/backend_software_rounded_rect_spec.spl
test/01_unit/os/compositor/engine2d_damage_report_spec.spl
test/01_unit/os/compositor/engine2d_compositor_revision_cache_spec.spl
test/01_unit/os/compositor/engine2d_render_evidence_spec.spl
test/01_unit/os/compositor/engine2d_baremetal_core_parity_spec.spl
test/01_unit/os/compositor/vulkan_compositor_backend_spec.spl
test/01_unit/os/drivers/virtio/virtio_gpu_capset_spec.spl"

# Pre-approved known-red spec (filed, not this unit's to fix).
KNOWN_RED="test/01_unit/os/compositor/engine2d_render_evidence_spec.spl"

TOTAL=0
FAILED=0
UNEXPECTED_FAIL=0
for s in $SPECS; do
  echo "=== $s ==="
  OUT=$(docker run --rm -v "$REPO_ROOT:/opt/simple" --tmpfs /tmp:rw,size=512m \
    --memory=2g --cpus=2.0 --cap-drop=ALL -w /opt/simple "$IMG" \
    -c "bin/release/x86_64-unknown-linux-gnu/simple test '$s' --no-session-daemon --sequential" 2>&1) || true
  LINE=$(echo "$OUT" | grep -E '^Results: [0-9]+ total' || true)
  TOTAL=$((TOTAL + 1))
  if [ -z "$LINE" ]; then
    echo "ERROR — no results line for $s"
    echo "$OUT" | tail -20
    FAILED=$((FAILED + 1))
    [ "$s" = "$KNOWN_RED" ] || UNEXPECTED_FAIL=$((UNEXPECTED_FAIL + 1))
    continue
  fi
  echo "$LINE"
  if echo "$LINE" | grep -qE ', 0 failed$'; then
    :
  else
    FAILED=$((FAILED + 1))
    if [ "$s" = "$KNOWN_RED" ]; then
      echo "(known-red, filed: doc/08_tracking/bug/engine2d_render_evidence_spec_missing_module_2026-08-08.md)"
    else
      UNEXPECTED_FAIL=$((UNEXPECTED_FAIL + 1))
    fi
  fi
done

echo "=== summary ==="
echo "specs=$TOTAL failed_specs=$FAILED unexpected_failures=$UNEXPECTED_FAIL"
if [ "$UNEXPECTED_FAIL" -gt 0 ]; then
  echo "FAIL — $UNEXPECTED_FAIL unexpected spec failure(s)"
  exit 1
fi
echo "PASS — $TOTAL spec(s) checked, only the known-filed red present"
exit 0
