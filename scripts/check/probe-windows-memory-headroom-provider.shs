#!/bin/sh
# Link and run a native Windows OS-oracle probe against the retained Rust058
# archive plus the new owner TU, then against the canonical core-C capsule.
set -eu

if [ "$#" -ne 2 ]; then
    echo "usage: sh scripts/check/probe-windows-memory-headroom-provider.shs <rust058-runtime.a> <core-c-runtime.a>" >&2
    exit 2
fi

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
RUST058_ARCHIVE=$1
CORE_C_ARCHIVE=$2
CC=${CC:-cc}
PROBE="$ROOT/test/fixtures/bootstrap/memory_headroom_provider/native_probe.c"
PROVIDER="$ROOT/src/runtime/runtime_memory_headroom.c"
TMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/simple-memory-headroom-probe.XXXXXX")
trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM

if [ ! -f "$RUST058_ARCHIVE" ] || [ ! -f "$CORE_C_ARCHIVE" ]; then
    echo "memory-headroom probe requires both runtime archives" >&2
    exit 2
fi

"$CC" -std=c11 -O2 -Wall -Wextra -I "$ROOT/src/runtime" \
    "$PROBE" "$PROVIDER" "$RUST058_ARCHIVE" \
    -o "$TMP_DIR/rust058-memory-headroom-probe.exe"
"$TMP_DIR/rust058-memory-headroom-probe.exe"

"$CC" -std=c11 -O2 -Wall -Wextra -I "$ROOT/src/runtime" \
    "$PROBE" "$CORE_C_ARCHIVE" \
    -o "$TMP_DIR/core-c-memory-headroom-probe.exe"
"$TMP_DIR/core-c-memory-headroom-probe.exe"
