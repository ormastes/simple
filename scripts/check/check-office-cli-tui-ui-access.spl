# Fail-closed deployed Office/Calc evidence gate.
#
# This gate deliberately has no controller-level fallback.  It starts the
# configured deployed runtime, drives its public `simple ui` commands, and
# stores proof only below the caller-provided unique run directory.

use std.nogc_sync_mut.io_runtime.{
    dir_create_all,
    dir_exists,
    env_get,
    file_exists,
    file_hash_sha256,
    file_read,
    file_write,
    get_args,
    getpid,
    process_run,
    process_spawn_async,
    thread_sleep,
    time_now_unix_micros
}
use nogc_sync_mut.process_monitor.{sample_process}
use std.nogc_sync_mut.io.file_ops.{file_modified_time}
use std.nogc_sync_mut.io.process_ops.{process_is_running, process_kill, process_wait}

val EVIDENCE_BASE: text = "build/test-artifacts/03_system/app/office/feature/office_cli_tui_ui_access"
val WARM_SAMPLE_COUNT: i32 = 20
val SNAPSHOT_P95_MAX_US: i64 = 100000
val FIND_P95_MAX_US: i64 = 25000
val ACTION_POST_P95_MAX_US: i64 = 250000
val ACCESS_RSS_DELTA_MAX_KIB: i64 = 20480
val STARTUP_MAX_US: i64 = 2000000

fn _arg(args: [text], name: text) -> text:
    var i = 0
    while i + 1 < args.len():
        if args[i] == name:
            return args[i + 1]
        i = i + 1
    ""

fn _fail(message: text) -> i32:
    print "suite=office-cli-tui-ui-access"
    print "suite_status=fail"
    print "failure=" + message
    1

fn _simple_binary() -> text:
    val client = env_get("SIMPLE_UI_CLIENT")
    if client != nil and client != "": return client
    val configured = env_get("SIMPLE_BINARY")
    if configured == nil: return ""
    configured

fn _office_binary(simple_binary: text) -> text:
    val configured = env_get("OFFICE_BINARY")
    if configured == nil or configured == "": return simple_binary
    configured

fn _ide_binary(simple_binary: text) -> text:
    val configured = env_get("SIMPLE_IDE_CLIENT")
    if configured == nil or configured == "": return simple_binary
    configured

fn _uses_standalone_ide() -> bool:
    val configured = env_get("SIMPLE_IDE_CLIENT")
    configured != nil and configured != ""

fn _uses_standalone_office() -> bool:
    val configured = env_get("OFFICE_BINARY")
    configured != nil and configured != ""

fn _run_root(run_id: text) -> text:
    EVIDENCE_BASE + "/runs/" + run_id

fn _run(runtime: text, args: [text]) -> (text, text, i64):
    process_run(runtime, args)

fn _revision(json: text) -> i64:
    val marker = "\"snapshot_revision\":"
    val at = json.last_index_of(marker)
    if at < 0: return -1
    # `ui act` retains both the caller's observed revision and the action's
    # post-state revision. The final occurrence is authoritative for chaining.
    val rest = json.slice(at + marker.len(), json.len()).trim()
    val comma = rest.index_of(",")
    val token = if comma < 0: rest else: rest.slice(0, comma)
    token.trim().to_i64()

fn _action_revision(json: text, previous: i64) -> i64:
    val expected = previous + 2
    if json.contains("\"snapshot_revision\":" + expected.to_text()): return expected
    -1

fn _ui(runtime: text, port: i32, args: [text]) -> (text, text, i64):
    _run(runtime, ["ui"] + args + ["--port", port.to_text(), "--timeout", "10000", "--json"])

fn _act(runtime: text, port: i32, canonical: text, action: text, value: text, revision: i64) -> (text, text, i64):
    val result = _ui(runtime, port, [
        "act", "--surface", "main", "--canonical", canonical,
        "--action", action, "--value", value,
        "--revision", revision.to_text()
    ])
    # Calc owns transport and terminal rendering on one event loop. Leave one
    # bounded accept/redraw quantum before the next external action process.
    thread_sleep(100)
    result

fn _await_snapshot(runtime: text, port: i32) -> (text, bool):
    var attempt = 0
    while attempt < 100:
        val (out, _err, code) = _ui(runtime, port, ["snapshot"])
        if code == 0 and out.contains("main#cell_A1") and _revision(out) >= 0:
            return (out, true)
        thread_sleep(100)
        attempt = attempt + 1
    ("", false)

fn _await_child_pid(root: text) -> i64:
    var attempt = 0
    while attempt < 20:
        val path = root + "/tui/calc-pid.txt"
        if file_exists(path):
            val pid = file_read(path).trim().to_i64()
            if pid > 1: return pid
        thread_sleep(100)
        attempt = attempt + 1
    -1

fn _rss_kib(pid: i64) -> i64:
    # process_monitor is the canonical platform seam: /proc on Linux and ps
    # on macOS.  A zero result means the host has no valid measurement, which
    # is a gate failure rather than an optimistic "not measured" result.
    val metric = sample_process(pid, time_now_unix_micros() / 1000)
    metric.memory_mb * 1024

fn _p95_us(samples: [i64]) -> i64:
    if samples.len() == 0: return -1
    val sorted = samples.sort()
    val index = ((sorted.len() * 95 + 99) / 100) - 1
    sorted[index]

fn _receipt_i64(body: text, key: text) -> i64:
    val marker = key + "="
    for line in body.split("\n"):
        if line.starts_with(marker):
            val parsed = line.slice(marker.len(), line.len()).to_int()
            return if parsed == nil: -1 else: parsed
    -1

fn _json_text(body: text, key: text) -> text:
    val marker = "\"" + key + "\":\""
    val at = body.index_of(marker)
    if at < 0: return ""
    val rest = body.slice(at + marker.len(), body.len())
    val end = rest.index_of("\"")
    if end < 0: return ""
    rest.slice(0, end)

fn _protocol_json_ok(body: text) -> bool:
    body.contains("\"schema\":\"simple.access/v1\"")

fn _root(runtime: text, port: i32) -> (text, text, i64):
    # Keep HTTP ownership in the cached standalone UI client.  `root` emits
    # only the response body on success, so root.html is the exact body seen
    # over the same scalar TCP transport used by the protocol operations.
    _run(runtime, ["ui", "root", "--port", port.to_text(), "--timeout", "1000"])

fn _artifact_provenance(binary: text, root: text, name: text) -> (bool, text, i64):
    """Bind this run to the configured executable's observed file identity.

    `file_hash_sha256` and `file_modified_time` are the canonical runtime/file
    facades.  They follow the configured executable path without a shell
    command, so a stale or swapped deployed tool cannot borrow another run's
    receipt.
    """
    val digest = file_hash_sha256(binary)
    val mtime = file_modified_time(binary)
    val valid = digest.len() == 64 and mtime > 0
    val receipt = name + "_path=" + binary +
        "\n" + name + "_sha256=" + digest +
        "\n" + name + "_mtime_epoch=" + mtime.to_text() + "\n"
    if not file_write(root + "/exec/" + name + "-artifact.txt", receipt):
        return (false, digest, mtime)
    (valid, digest, mtime)

fn _count_text(body: text, needle: text) -> i32:
    if needle == "": return 0
    var count = 0
    var from = 0
    while from < body.len():
        val relative = body.slice(from, body.len()).index_of(needle)
        if relative < 0: return count
        count = count + 1
        from = from + relative + needle.len()
    count

fn _start_real_tui(office_binary: text, standalone: bool, root: text, port: i32) -> i64:
    """Start the *one* deployed Calc process under a real 124x37 PTY.

    The Python parent is PTY capture plumbing only.  It contains no product,
    formula, protocol, or assertion logic. Its child is the configured
    deployed runtime, launched once with both `--tui` and `--ui-access-port`.
    The child must accept public UI actions while continuing to render its
    terminal surface, and must exit cleanly after the stop sentinel is made.
    """
    val fixture = root + "/exec/calc-fixture.csv"
    if not file_write(fixture, ""):
        return -1
    val code = "import fcntl,os,pty,re,select,signal,struct,sys,termios,time;" +
        "raw_path,text_path,status_path,stop_path,pid_path,exe,fixture,port,mode=sys.argv[1:10];" +
        "pid,fd=pty.fork();" +
        "argv=[exe,'calc',fixture,'--tui','--ui-access-port',port] if mode=='standalone' else [exe,'office','calc',fixture,'--tui','--ui-access-port',port];" +
        "(time.sleep(0.05),fcntl.ioctl(0,termios.TIOCSWINSZ,struct.pack('HHHH',37,124,0,0)),os.execvp(exe,argv)) if pid==0 else None;" +
        "open(pid_path,'w').write(str(pid)+'\\n');before=termios.tcgetattr(fd);" +
        "fcntl.ioctl(fd,termios.TIOCSWINSZ,struct.pack('HHHH',37,124,0,0));" +
        "raw=b'';sent=False;exit_code=-999;deadline=time.time()+20;" +
        "\nwhile time.time()<deadline:\n r,_,_=select.select([fd],[],[],0.1);\n if r:\n  try: chunk=os.read(fd,65536)\n  except OSError: chunk=b''\n  raw+=chunk\n if os.path.exists(stop_path) and not sent:\n  try: os.write(fd,b'q')\n  except OSError: pass\n  sent=True\n if sent:\n  done,status=os.waitpid(pid,os.WNOHANG)\n  if done: exit_code=os.waitstatus_to_exitcode(status);break\n" +
        "\nif exit_code == -999:\n os.kill(pid,signal.SIGTERM);_,status=os.waitpid(pid,0);exit_code=os.waitstatus_to_exitcode(status)\nafter=termios.tcgetattr(fd);restored=after==before;open(raw_path,'wb').write(raw);open(status_path,'w').write('exit='+str(exit_code)+'\\nterminal_restored='+str(restored).lower()+'\\n');" +
        "plain=re.sub(rb'\\x1b\\[[0-?]*[ -/]*[@-~]',b'',raw).replace(b'\\r',b'');" +
        "lines=[x.decode('utf-8','replace') for x in plain.split(b'\\n') if x!=b''];frames=[lines[i:i+37] for i in range(max(0,len(lines)-72),max(0,len(lines)-36)) if all(len(x)==124 for x in lines[i:i+37]) and any('Simple Calc' in x for x in lines[i:i+37])];frame=frames[-1] if frames else [];" +
        "ok=exit_code==0 and b'\\x1b[' in raw and len(frame)==37;" +
        "open(text_path,'w').write('\\n'.join(frame)+'\\n') if ok else None;" +
        "sys.exit(0 if ok else 4)"
    val office_mode = if standalone: "standalone" else: "unified"
    process_spawn_async("python3", [
        "-c", code,
        root + "/tui/calc-after.ansi", root + "/tui/calc-after.txt",
        root + "/tui/calc-exit.txt", root + "/tui/stop", root + "/tui/calc-pid.txt", office_binary, fixture,
        port.to_text(), office_mode
    ])

fn _finish_real_tui(root: text) -> bool:
    if not file_write(root + "/tui/stop", "stop\n"):
        return false
    var attempt = 0
    while attempt < 80:
        if file_exists(root + "/tui/calc-exit.txt"):
            val status = file_read(root + "/tui/calc-exit.txt")
            return status.contains("exit=0") and
                status.contains("terminal_restored=true") and
                file_exists(root + "/tui/calc-after.ansi") and
                file_exists(root + "/tui/calc-after.txt")
        thread_sleep(100)
        attempt = attempt + 1
    false

fn _measure_warm_protocol(runtime: text, port: i32, root: text, revision0: i64, pid: i64, rss_baseline_kib: i64) -> (bool, i64, text):
    """Measure warm public protocol requests in one deployed UI-client process.

    Keeping the client alive excludes process startup from request latency and
    prevents subprocess launch from becoming part of the hot path. Every
    action still performs an independent protocol snapshot observation.
    """
    val (bench, bench_err, bench_code) = _ui(runtime, port,
        ["benchmark", "--samples", WARM_SAMPLE_COUNT.to_text(), "--revision", revision0.to_text()])
    if bench_code != 0:
        file_write(root + "/perf/benchmark-failure.txt", "code=" + bench_code.to_text() + "\nstdout=" + bench + "\nstderr=" + bench_err + "\n")
        return (false, revision0, "warm protocol benchmark failed")
    val revision = revision0 + WARM_SAMPLE_COUNT * 2
    val max_rss_kib = _rss_kib(pid)
    if max_rss_kib <= 0:
        return (false, revision0, "rss_measurement_unavailable_after_warm_request")
    val rss_delta_kib = max_rss_kib - rss_baseline_kib
    val receipt = bench +
        "\nrss_baseline_kib=" + rss_baseline_kib.to_text() +
        "\nrss_max_kib=" + max_rss_kib.to_text() +
        "\nrss_delta_kib=" + rss_delta_kib.to_text() +
        "\nrss_status=measured\n"
    if not file_write(root + "/perf/warm-protocol.txt", receipt):
        return (false, revision, "could not write warm protocol receipt")
    if not bench.contains("latency_status=pass"):
        return (false, revision, "warm_protocol_latency_exceeds_limit")
    if rss_delta_kib > ACCESS_RSS_DELTA_MAX_KIB:
        return (false, revision, "rss_delta_exceeds_20MiB")
    (true, revision, "ui-bench")

fn _office_args(standalone: bool, args: [text]) -> [text]:
    if standalone: args else: ["office"] + args

fn _ide_args(standalone: bool, args: [text]) -> [text]:
    if standalone: args else: ["ide"] + args

fn _deployed_cli_checks(simple_binary: text, ide_binary: text, office_binary: text, standalone_ide: bool, standalone_office: bool, root: text) -> bool:
    val (ide_tui, ide_tui_err, ide_tui_code) = _run(ide_binary, _ide_args(standalone_ide, ["--feature-check", "--tui"]))
    val (ide_gui, ide_gui_err, ide_gui_code) = _run(ide_binary, _ide_args(standalone_ide, ["--feature-check", "--gui"]))
    val (_bad_office, bad_office_err, bad_office_code) = _run(office_binary, _office_args(standalone_office, ["calc", "--not-a-calc-option"]))
    val (_bad_ide, bad_ide_err, bad_ide_code) = _run(ide_binary, _ide_args(standalone_ide, ["--not-an-ide-option"]))
    val log = "ide_tui:\n" + ide_tui + ide_tui_err + "\nide_gui:\n" + ide_gui + ide_gui_err +
        "\ninvalid_office:\n" + bad_office_err + "\ninvalid_ide:\n" + bad_ide_err + "\n"
    if not file_write(root + "/exec/commands.txt", log): return false
    ide_tui_code == 0 and ide_gui_code == 0 and bad_office_code != 0 and bad_ide_code != 0

fn _binary_provenance(simple_binary: text, ide_binary: text, office_binary: text, standalone_ide: bool, standalone_office: bool, root: text) -> bool:
    """Reject seed binaries by observed behavior, not their misleading path.

    A release-looking pathname and `--version` are insufficient: stale macOS
    launchers have identified themselves as a Rust bootstrap seed only after
    receiving an actual Office command.  Preserve that transcript with the
    fresh evidence and fail before any product assertion could look green.
    """
    val (simple_out, simple_err, simple_code) = _run(ide_binary, _ide_args(standalone_ide, ["--not-an-ide-option"]))
    val simple_transcript = simple_out + simple_err
    val simple_lowered = simple_transcript.lower()
    val (office_out, office_err, office_code) = _run(
        office_binary, _office_args(standalone_office, ["calc", "--not-a-calc-option"])
    )
    val office_transcript = office_out + office_err
    val office_lowered = office_transcript.lower()
    val office_usage = if standalone_office: "Usage: office calc" else: "Usage: simple office calc"
    if not file_write(root + "/exec/runtime-provenance.txt", simple_transcript): return false
    if not file_write(root + "/exec/office-product-provenance.txt", office_transcript): return false
    simple_code != 0 and office_code != 0 and office_transcript.contains(office_usage) and
        not simple_lowered.contains("rust-built simple binary") and
        not simple_lowered.contains("bootstrap seed only") and
        not simple_lowered.contains("seed sibling") and
        not simple_lowered.contains("debug build") and
        not office_lowered.contains("rust-built simple binary") and
        not office_lowered.contains("bootstrap seed only") and
        not office_lowered.contains("seed sibling") and
        not office_lowered.contains("debug build")

fn _live_workflow(simple_binary: text, office_binary: text, standalone: bool, root: text) -> (bool, text):
    val port = 38000 + (getpid() % 2000).to_i32()
    val startup_started_us = time_now_unix_micros()
    val capture_pid = _start_real_tui(office_binary, standalone, root, port)
    if capture_pid <= 1: return (false, "could_not_start_deployed_calc_pty")
    val (before, ready) = _await_snapshot(simple_binary, port)
    if not ready:
        # Ask the PTY owner to close its child before returning failure.  Do
        # not kill only the capture parent: that would orphan the deployed
        # Calc process and make a later run's port/evidence ambiguous.
        _finish_real_tui(root)
        return (false, "deployed_calc_surface_not_ready")
    val startup_us = time_now_unix_micros() - startup_started_us
    if not file_write(root + "/perf/startup.txt", "startup_us=" + startup_us.to_text() + "\nstartup_limit_us=" + STARTUP_MAX_US.to_text() + "\n"):
        _finish_real_tui(root)
        return (false, "could_not_write_startup_receipt")
    if startup_us > STARTUP_MAX_US:
        _finish_real_tui(root)
        return (false, "startup_exceeds_2s")
    val child_pid = _await_child_pid(root)
    val rss_ready_kib = if child_pid > 1: _rss_kib(child_pid) else: 0
    if rss_ready_kib <= 0:
        file_write(root + "/perf/rss-measurement.txt", "rss_status=missing\nreason=rss_measurement_unavailable_at_ready\npid=" + child_pid.to_text() + "\n")
        _finish_real_tui(root)
        return (false, "rss_measurement_unavailable_at_ready")
    val (windows, windows_err, windows_code) = _ui(simple_binary, port, ["windows"])
    val (surface, surface_err, surface_code) = _ui(simple_binary, port, ["surface", "main"])
    val revision0 = _revision(before)
    val (select_a1, select_a1_err, select_a1_code) = _act(simple_binary, port, "main#cell_A1", "select", "", revision0)
    val revision1 = _action_revision(select_a1, revision0)
    val (type_a1, type_a1_err, type_a1_code) = _act(simple_binary, port, "main#formula_input", "type_text", "6", revision1)
    val revision2 = _action_revision(type_a1, revision1)
    val (commit_a1, commit_a1_err, commit_a1_code) = _act(simple_binary, port, "main#confirm_edit", "invoke", "", revision2)
    val revision3 = _action_revision(commit_a1, revision2)
    val (select_a2, select_a2_err, select_a2_code) = _act(simple_binary, port, "main#cell_A2", "select", "", revision3)
    val revision4 = _action_revision(select_a2, revision3)
    val (type_a2, type_a2_err, type_a2_code) = _act(simple_binary, port, "main#formula_input", "type_text", "8", revision4)
    val revision5 = _action_revision(type_a2, revision4)
    val (commit_a2, commit_a2_err, commit_a2_code) = _act(simple_binary, port, "main#confirm_edit", "invoke", "", revision5)
    val revision6 = _action_revision(commit_a2, revision5)
    val (select_b1, select_b1_err, select_b1_code) = _act(simple_binary, port, "main#cell_B1", "select", "", revision6)
    val revision7 = _action_revision(select_b1, revision6)
    val (type_b1, type_b1_err, type_b1_code) = _act(simple_binary, port, "main#formula_input", "type_text", "=A1*A2", revision7)
    val revision8 = _action_revision(type_b1, revision7)
    val (commit_b1, commit_b1_err, commit_b1_code) = _act(simple_binary, port, "main#confirm_edit", "invoke", "", revision8)
    val revision9 = _action_revision(commit_b1, revision8)
    val (select_c1, select_c1_err, select_c1_code) = _act(simple_binary, port, "main#cell_C1", "select", "", revision9)
    val revision10 = _action_revision(select_c1, revision9)
    val (type_c1, type_c1_err, type_c1_code) = _act(simple_binary, port, "main#formula_input", "type_text", "=AVG(A1:A2)", revision10)
    val revision11 = _action_revision(type_c1, revision10)
    val (commit_c1, commit_c1_err, commit_c1_code) = _act(simple_binary, port, "main#confirm_edit", "invoke", "", revision11)
    val revision12 = _action_revision(commit_c1, revision11)
    val formula_actions_ok = select_a1_code == 0 and type_a1_code == 0 and commit_a1_code == 0 and
        select_a2_code == 0 and type_a2_code == 0 and commit_a2_code == 0 and
        select_b1_code == 0 and type_b1_code == 0 and commit_b1_code == 0 and
        select_c1_code == 0 and type_c1_code == 0 and commit_c1_code == 0 and revision12 >= 0
    if not formula_actions_ok:
        file_write(root + "/protocol/formula-action-failure.txt",
            "revisions=" + revision0.to_text() + "," + revision1.to_text() + "," + revision2.to_text() + "," + revision3.to_text() + "," + revision4.to_text() + "," + revision5.to_text() + "," + revision6.to_text() + "," + revision7.to_text() + "," + revision8.to_text() + "," + revision9.to_text() + "," + revision10.to_text() + "," + revision11.to_text() + "," + revision12.to_text() +
            "\ntype_a1=" + type_a1 + type_a1_err + "\ncommit_a1=" + commit_a1 + commit_a1_err + "\n")
        _finish_real_tui(root)
        return (false, "formula_action_sequence_failed")
    # NFR measurements are explicitly warm: fixture construction and the
    # first complete semantic projection precede the resource baseline.
    val (warmup_protocol, warmup_protocol_err, warmup_protocol_code) = _ui(simple_binary, port,
        ["benchmark", "--samples", "1", "--revision", revision12.to_text()])
    if not file_write(root + "/perf/warmup-protocol.txt", warmup_protocol + warmup_protocol_err):
        _finish_real_tui(root)
        return (false, "could_not_write_warmup_receipt")
    val rss_baseline_kib = _rss_kib(child_pid)
    if warmup_protocol_code != 0 or rss_baseline_kib <= 0:
        _finish_real_tui(root)
        return (false, "warm_rss_baseline_unavailable")
    val measurement_revision = revision12 + 2
    val (nfr_ok, warm_revision, nfr_detail) = _measure_warm_protocol(simple_binary, port, root, measurement_revision, child_pid, rss_baseline_kib)
    if not nfr_ok:
        file_write(root + "/perf/nfr-failure.txt", "nfr_status=fail\nreason=" + nfr_detail + "\n")
        _finish_real_tui(root)
        return (false, nfr_detail)
    # The initial action's request/result pair must be evicted once the public
    # protocol has recorded more than the 64-event session ceiling.
    val early_request_id = _json_text(select_a1, "request_id")
    val (evict_action, evict_err, evict_code) = _act(simple_binary, port, "main#cell_A1", "select", "", warm_revision)
    val revision13 = _action_revision(evict_action, warm_revision)
    val (select_d1, select_d1_err, select_d1_code) = _act(simple_binary, port, "main#cell_D1", "select", "", revision13)
    val revision14 = _action_revision(select_d1, revision13)
    val (invalid_before, invalid_before_err, invalid_before_code) = _ui(simple_binary, port, ["find", "--canonical", "main#cell_D1"])
    val invalid_before_value = _json_text(invalid_before, "text")
    val (type_invalid, type_invalid_err, type_invalid_code) = _act(
        simple_binary, port, "main#formula_input", "type_text", "=NOT_A_REAL_CALC_FUNCTION(1)", revision14
    )
    val revision15 = _action_revision(type_invalid, revision14)
    val (commit_invalid, commit_invalid_err, commit_invalid_code) = _act(
        simple_binary, port, "main#confirm_edit", "invoke", "", revision15
    )
    val commit_invalid_response = commit_invalid + commit_invalid_err
    val (invalid_after, invalid_after_err, invalid_after_code) = _ui(simple_binary, port, ["find", "--canonical", "main#cell_D1"])
    val invalid_after_value = _json_text(invalid_after, "text")
    val (after, after_err, after_code) = _ui(simple_binary, port, ["snapshot"])
    val (b1, b1_err, b1_code) = _ui(simple_binary, port, ["find", "--canonical", "main#cell_B1"])
    val (c1, c1_err, c1_code) = _ui(simple_binary, port, ["find", "--canonical", "main#cell_C1"])
    val (history, history_err, history_code) = _ui(simple_binary, port, ["history", "--surface", "main", "--count", "64"])
    val (stale_out, stale_err, stale_code) = _act(simple_binary, port, "main#cell_A1", "select", "", revision0)
    val (missing_out, missing_err, missing_code) = _act(simple_binary, port, "main#cell_Z999", "select", "", _revision(after))
    val (unsupported_out, unsupported_err, unsupported_code) = _act(simple_binary, port, "main#cell_A1", "delete_everything", "", _revision(after))
    val stale_response = stale_out + stale_err
    val missing_response = missing_out + missing_err
    val unsupported_response = unsupported_out + unsupported_err
    val evidence_ok = file_write(root + "/protocol/snapshot-before.json", before) and
        file_write(root + "/protocol/snapshot-after.json", after) and
        file_write(root + "/protocol/find-b1.json", b1) and
        file_write(root + "/protocol/find-c1.json", c1) and
        file_write(root + "/protocol/malformed-before.json", invalid_before) and
        file_write(root + "/protocol/malformed-after.json", invalid_after) and
        file_write(root + "/protocol/malformed-rejection.txt", commit_invalid_response) and
        file_write(root + "/protocol/history.json", history) and
        file_write(root + "/protocol/windows.json", windows) and
        file_write(root + "/protocol/surface-main.json", surface) and
        file_write(root + "/protocol/rejections.txt", stale_response + "\n" + missing_response + "\n" + unsupported_response)
    val tui_ok = _finish_real_tui(root)
    val (closed_out, closed_err, closed_code) = _ui(simple_binary, port, ["snapshot"])
    val closed_response = closed_out + closed_err
    val port_closed = (closed_code != 0 and
        _protocol_json_ok(closed_response) and
        closed_response.contains("source_unavailable"))
    file_write(
        root + "/protocol/service-closed.txt",
        "port=" + port.to_text() + "\nclosed=" + port_closed.to_text() +
        "\nstdout=" + closed_out + "\nstderr=" + closed_err + "\n"
    )
    val screen = if tui_ok: file_read(root + "/tui/calc-after.txt") else: ""
    val live_ok = evidence_ok and select_a1_code == 0 and type_a1_code == 0 and commit_a1_code == 0 and
        select_a2_code == 0 and type_a2_code == 0 and commit_a2_code == 0 and
        select_b1_code == 0 and type_b1_code == 0 and commit_b1_code == 0 and
        select_c1_code == 0 and type_c1_code == 0 and commit_c1_code == 0 and
        windows_code == 0 and surface_code == 0 and evict_code == 0 and revision13 >= 0 and
        select_d1_code == 0 and invalid_before_code == 0 and type_invalid_code == 0 and
        commit_invalid_code != 0 and commit_invalid_response.contains("malformed_formula") and
        invalid_after_code == 0 and invalid_before_value == invalid_after_value and
        after_code == 0 and b1_code == 0 and c1_code == 0 and history_code == 0 and
        _protocol_json_ok(windows) and _protocol_json_ok(before) and
        _protocol_json_ok(surface) and _protocol_json_ok(select_a1) and
        _protocol_json_ok(type_a1) and _protocol_json_ok(commit_a1) and
        _protocol_json_ok(select_a2) and _protocol_json_ok(type_a2) and
        _protocol_json_ok(commit_a2) and _protocol_json_ok(select_b1) and
        _protocol_json_ok(type_b1) and _protocol_json_ok(commit_b1) and
        _protocol_json_ok(select_c1) and _protocol_json_ok(type_c1) and
        _protocol_json_ok(commit_c1) and _protocol_json_ok(evict_action) and
        _protocol_json_ok(select_d1) and _protocol_json_ok(invalid_before) and
        _protocol_json_ok(type_invalid) and _protocol_json_ok(commit_invalid_response) and
        _protocol_json_ok(invalid_after) and _protocol_json_ok(after) and
        _protocol_json_ok(b1) and _protocol_json_ok(c1) and _protocol_json_ok(history) and
        windows.contains("main") and
        surface.contains("main#cell_A1") and surface.contains("main#formula_input") and
        b1.contains("main#cell_B1") and b1.contains("48") and
        c1.contains("main#cell_C1") and c1.contains("7") and
        history.contains("access_request") and history.contains("access_result") and
        _count_text(history, "\"event_kind\"") == 64 and early_request_id != "" and not history.contains(early_request_id) and
        stale_code != 0 and stale_response.contains("stale_target") and
        missing_code != 0 and missing_response.contains("target_not_found") and
        unsupported_code != 0 and unsupported_response.contains("unsupported_action") and tui_ok and port_closed
        and screen.contains("48") and screen.contains("7") and
        screen.contains("T") and screen.contains("30") and
        screen.split("\n").len() == 38
    (live_ok, if live_ok: "" else: "deployed_ui_protocol_or_cleanup_assertion_failed")

fn _gui_workflow(office_product: text, ui_client: text, root: text) -> bool:
    val port = 41000 + (getpid() % 2000).to_i32()
    val fixture = root + "/exec/calc-fixture.csv"
    val standalone = _uses_standalone_office()
    val args = _office_args(standalone, [
        "calc", fixture, "--gui", "--ui-access-port", port.to_text()
    ])
    val pid = process_spawn_async(office_product, args)
    if pid <= 1: return false

    var html = ""
    var snapshot = ""
    var ready = false
    var attempt = 0
    while attempt < 30 and not ready:
        val (page, _page_err, page_code) = _root(ui_client, port)
        val (observed, _snapshot_err, snapshot_code) = _ui(ui_client, port, ["snapshot"])
        if page_code == 0 and snapshot_code == 0:
            html = page
            snapshot = observed
            ready = true
        else:
            thread_sleep(100)
        attempt = attempt + 1

    val html_ok = ready and html.contains("Simple Calc") and
        html.contains("formula_input") and html.contains("sheet_grid") and
        html.contains("cell_A1") and html.contains("cell_T30")
    val snapshot_ok = ready and _protocol_json_ok(snapshot) and
        snapshot.contains("main") and snapshot.contains("main#formula_input") and
        snapshot.contains("main#sheet_grid") and snapshot.contains("main#cell_A1") and
        snapshot.contains("main#cell_T30")

    val revision0 = _revision(snapshot)
    val (select_a1, _select_a1_err, select_a1_code) = _act(
        ui_client, port, "main#cell_A1", "select", "", revision0
    )
    val revision1 = _action_revision(select_a1, revision0)
    val (type_a1, _type_a1_err, type_a1_code) = _act(
        ui_client, port, "main#formula_input", "type_text", "6", revision1
    )
    val revision2 = _action_revision(type_a1, revision1)
    val (commit_a1, _commit_a1_err, commit_a1_code) = _act(
        ui_client, port, "main#confirm_edit", "invoke", "", revision2
    )
    val revision3 = _action_revision(commit_a1, revision2)
    val (select_a2, _select_a2_err, select_a2_code) = _act(
        ui_client, port, "main#cell_A2", "select", "", revision3
    )
    val revision4 = _action_revision(select_a2, revision3)
    val (type_a2, _type_a2_err, type_a2_code) = _act(
        ui_client, port, "main#formula_input", "type_text", "8", revision4
    )
    val revision5 = _action_revision(type_a2, revision4)
    val (commit_a2, _commit_a2_err, commit_a2_code) = _act(
        ui_client, port, "main#confirm_edit", "invoke", "", revision5
    )
    val revision6 = _action_revision(commit_a2, revision5)
    val (select_b1, _select_b1_err, select_b1_code) = _act(
        ui_client, port, "main#cell_B1", "select", "", revision6
    )
    val revision7 = _action_revision(select_b1, revision6)
    val (type_b1, _type_b1_err, type_b1_code) = _act(
        ui_client, port, "main#formula_input", "type_text", "=A1*A2", revision7
    )
    val revision8 = _action_revision(type_b1, revision7)
    val (commit_b1, commit_b1_err, commit_b1_code) = _act(
        ui_client, port, "main#confirm_edit", "invoke", "", revision8
    )
    val commit_b1_response = commit_b1 + commit_b1_err
    val (post_snapshot, _post_snapshot_err, post_snapshot_code) = _ui(ui_client, port, ["snapshot"])
    val (found_b1, _found_b1_err, found_b1_code) = _ui(
        ui_client, port, ["find", "--canonical", "main#cell_B1"]
    )
    val action_ok = select_a1_code == 0 and type_a1_code == 0 and commit_a1_code == 0 and
        select_a2_code == 0 and type_a2_code == 0 and commit_a2_code == 0 and
        select_b1_code == 0 and type_b1_code == 0 and commit_b1_code == 0 and
        post_snapshot_code == 0 and found_b1_code == 0 and
        _protocol_json_ok(commit_b1_response) and _protocol_json_ok(post_snapshot) and
        _protocol_json_ok(found_b1) and found_b1.contains("48")
    val parity_result = if action_ok: "48" else: "unavailable"
    val parity = "same_session=" + action_ok.to_text() + "\nresult=" + parity_result + "\n"
    val evidence_ok = file_write(root + "/gui/root.html", html) and
        file_write(root + "/gui/snapshot.json", snapshot) and
        file_write(root + "/gui/action-result.json", commit_b1_response) and
        file_write(root + "/gui/post-snapshot.json", post_snapshot) and
        file_write(root + "/gui/session-parity.txt", parity)

    val killed = process_kill(pid)
    val exit_code = process_wait(pid, 3000)
    val reaped = exit_code != -2 and not process_is_running(pid)
    val (closed_page, closed_page_err, closed_page_code) = _root(ui_client, port)
    val (closed_out, closed_err, closed_code) = _ui(ui_client, port, ["snapshot"])
    val closed_response = closed_out + closed_err
    val closed_page_response = closed_page + closed_page_err
    val port_closed = closed_page_code != 0 and _protocol_json_ok(closed_page_response) and
        closed_page_response.contains("source_unavailable") and closed_code != 0 and
        _protocol_json_ok(closed_response) and closed_response.contains("source_unavailable")
    val exit_receipt = "pid=" + pid.to_text() + "\nkilled=" + killed.to_text() +
        "\nexit_code=" + exit_code.to_text() + "\nreaped=" + reaped.to_text() +
        "\nport_closed=" + port_closed.to_text() + "\n"
    val exit_ok = file_write(root + "/exec/gui-exit.txt", exit_receipt)
    html_ok and snapshot_ok and action_ok and evidence_ok and killed and reaped and port_closed and exit_ok

fn _all(run_id: text) -> i32:
    val simple_binary = _simple_binary()
    val ide_binary = _ide_binary(simple_binary)
    val office_binary = _office_binary(simple_binary)
    val standalone = _uses_standalone_office()
    val standalone_ide = _uses_standalone_ide()
    if simple_binary == "" or not file_exists(simple_binary): return _fail("SIMPLE_UI_CLIENT or SIMPLE_BINARY must name the deployed UI/IDE client")
    if office_binary == "" or not file_exists(office_binary): return _fail("OFFICE_BINARY must name the deployed Office product")
    if ide_binary == "" or not file_exists(ide_binary): return _fail("SIMPLE_IDE_CLIENT must name the deployed IDE product")
    if simple_binary.contains("compiler_rust") or ide_binary.contains("compiler_rust") or office_binary.contains("compiler_rust"):
        return _fail("Rust seed binaries are forbidden")
    val root = _run_root(run_id)
    if run_id == "" or run_id.contains("/") or dir_exists(root): return _fail("--run-id must be unique and path-safe")
    if not (dir_create_all(root + "/tui") and dir_create_all(root + "/gui") and dir_create_all(root + "/protocol") and dir_create_all(root + "/exec") and dir_create_all(root + "/perf")):
        return _fail("could not create unique evidence directory")
    val (simple_artifact_ok, simple_sha256, simple_mtime) = _artifact_provenance(simple_binary, root, "runtime")
    val (office_artifact_ok, office_sha256, office_mtime) = _artifact_provenance(office_binary, root, "office")
    val (ide_artifact_ok, ide_sha256, ide_mtime) = _artifact_provenance(ide_binary, root, "ide")
    if not simple_artifact_ok or not office_artifact_ok or not ide_artifact_ok: return _fail("binary artifact provenance failed")
    if not _binary_provenance(simple_binary, ide_binary, office_binary, standalone_ide, standalone, root):
        return _fail("binary provenance failed; self-hosted UI/IDE and Office commands are required")
    if not _deployed_cli_checks(simple_binary, ide_binary, office_binary, standalone_ide, standalone, root): return _fail("deployed IDE/Office CLI checks failed")
    val (live_ok, live_detail) = _live_workflow(simple_binary, office_binary, standalone, root)
    if not live_ok: return _fail(live_detail)
    if not _gui_workflow(office_binary, simple_binary, root): return _fail("deployed_gui_html_or_cleanup_assertion_failed")
    val office_mode = if standalone: "standalone" else: "unified"
    if not file_write(root + "/suite.txt", "suite=office-cli-tui-ui-access\nsuite_status=pass\nrun_id=" + run_id + "\nruntime=pure-simple-self-hosted\nruntime_path=" + simple_binary + "\nruntime_sha256=" + simple_sha256 + "\nruntime_mtime_epoch=" + simple_mtime.to_text() + "\nide_path=" + ide_binary + "\nide_sha256=" + ide_sha256 + "\nide_mtime_epoch=" + ide_mtime.to_text() + "\noffice_mode=" + office_mode + "\noffice_path=" + office_binary + "\noffice_sha256=" + office_sha256 + "\noffice_mtime_epoch=" + office_mtime.to_text() + "\ncapture_size=124x37\nB1_display=48\nC1_display=7\ngui_html=true\ngui_semantic_surface=true\ngui_process_reaped=true\ngui_service_port_closed=true\nterminal_restored=true\nservice_port_closed=true\nmalformed_formula_no_mutation=true\n"):
        return _fail("could not retain suite receipt")
    print "suite=office-cli-tui-ui-access"
    print "suite_status=pass"
    print "run_id=" + run_id
    0

fn main() -> i64:
    val args = get_args()
    val scenario = _arg(args, "--scenario")
    if scenario != "all": return _fail("only --scenario all is supported by the deployed gate").to_i64()
    _all(_arg(args, "--run-id")).to_i64()
