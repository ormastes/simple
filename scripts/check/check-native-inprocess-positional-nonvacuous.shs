#!/bin/sh
# Fence for the pure-Simple IN-PROCESS native-build lane.
#
# `native-build <one.spl> --output X` with NO `--source` and NO `--entry` is the
# only invocation shape that goes through the pure-Simple in-process pipeline
# (src/app/cli/bootstrap_main.spl:run_native_build_bootstrap ->
# native_build_single_spl_positional). Every OTHER shape -- anything carrying
# `--source` or `--entry` -- delegates to the Rust seed FFI `run_rt_native_build`
# instead. Every pre-existing scripts/check native fence uses the `--source` /
# `--entry` shape, so until this file existed the in-process lane had NO coverage
# at all.
#
# That gap is exactly what let two defects live undetected and then get
# misdiagnosed for days (2026-08-08/09):
#   * `unsupported MIR type kind [wildcard-arm] disc=-1: <value:0x1800000007>`
#     from src/compiler/50.mir/_MirLowering/function_lowering.spl, and
#   * a vacuous (~23 KB, stub-shaped) output binary that still exited 0.
# Both were repeatedly mis-attributed to "project scale" because the passing
# control run was silently a DIFFERENT COMPILER (the seed lane), not a smaller
# module closure. See
# doc/08_tracking/bug/stage3_vacuous_binary_is_enum_discriminant_garbage_not_a_link_failure_2026-08-08.md
#
# This check asserts three things the old symptoms each violated:
#   1. the in-process lane exits 0,
#   2. it emits a binary that is not stub-shaped, and
#   3. that binary actually RUNS and produces the right answer
#      -- (3) is the load-bearing one: a vacuous binary passes (1) and (2).
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

SIMPLE_BINARY="${SIMPLE_BINARY:-bin/simple}"
WORK_DIR="${WORK_DIR:-/tmp/check-native-inprocess-positional.$$}"
FIXTURE="test/fixtures/native_inprocess_positional/main.spl"
EXPECTED="RESULT=42"
# A vacuous stub binary measured 22,896 B; a real one measured 28,976 B. Assert
# a floor safely between them so the stub shape cannot pass.
MIN_BYTES=26000

test -x "$SIMPLE_BINARY"
test -f "$FIXTURE"
mkdir -p "$WORK_DIR"
trap 'rm -rf "$WORK_DIR"' EXIT HUP INT TERM

binary="$WORK_DIR/inprocess-positional"
log="$WORK_DIR/inprocess-positional.log"

# NOTE: deliberately NO --source and NO --entry. Adding either one silently
# reroutes this check to the Rust seed lane and makes it vacuous as a fence.
if ! env -u SIMPLE_BOOTSTRAP \
        "$SIMPLE_BINARY" native-build --backend llvm --mode dynload \
        "$FIXTURE" --output "$binary" >"$log" 2>&1; then
    echo "FAIL — in-process native-build exited non-zero; log: $log"
    tail -20 "$log" || true
    exit 1
fi

if grep -q 'wildcard-arm' "$log"; then
    echo "FAIL — MIR lowering hit the [wildcard-arm] fallback; log: $log"
    grep -n 'wildcard-arm' "$log" | head -5
    exit 1
fi

if [ ! -f "$binary" ]; then
    echo "FAIL — no output binary was produced; log: $log"
    exit 1
fi

size="$(wc -c <"$binary")"
if [ "$size" -lt "$MIN_BYTES" ]; then
    echo "FAIL — output binary is stub-shaped ($size B < $MIN_BYTES B); log: $log"
    exit 1
fi

actual="$(timeout 60 "$binary" 2>>"$log")" || {
    echo "FAIL — output binary did not run cleanly; log: $log"
    exit 1
}
if [ "$actual" != "$EXPECTED" ]; then
    echo "FAIL — output binary printed '$actual', expected '$EXPECTED'"
    exit 1
fi

echo "PASS — in-process positional native-build: exit 0, ${size} B binary, ran and printed '$actual'"
