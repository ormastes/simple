#!/bin/sh
# Regression gate for AOT (`native-build`) inlined `Option<text>` return
# equality.
#
# WHY THIS EXISTS: `bin/simple test` hard-defaults to the tree-walk
# interpreter and has no AOT mode (TestExecutionMode has Native/Process/Safe/
# Container/ContainerSequential variants but "Native" there means unsandboxed
# *process execution*, not the LLVM AOT backend) -- so no `*_spec.spl` can
# ever observe this lane. Only a script that actually drives `native-build`
# can fence it.
#
# Bug: doc/08_tracking/bug/native_inlined_option_return_representation_mismatch_2026-08-02.md
# ("row.get(\"run_id\") == Some(run_id)" disassembled to a bare text handle
# on the inlined-return side vs an rt_enum_new-boxed value on the Some(...)
# side, so rt_native_eq compared mismatched physical representations and the
# equality spuriously returned false).
#
# The original repro used a struct method (SdnRow.get). From 2026-08-06 to
# 2026-08-08 that shape could not be re-verified because ANY struct/
# impl-method call crashed native-build with "semantic: undefined field
# 'kind': cannot access field on value of type 'nil'" (a receiver-type-
# inference bug, method_calls_literals.spl:940, unrelated to this
# Option-representation defect). That crash was fixed same-day by
# `100a9aadcc4`, so this gate now checks BOTH shapes: the original
# free-function fixture (main.spl) and a struct-method fixture
# (struct_method_main.spl) added once the crash stopped blocking it.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

SIMPLE_BINARY="${SIMPLE_BINARY:-bin/simple}"
WORK_DIR="${WORK_DIR:-/tmp/check-native-option-eq-representation.$$}"
FIXTURE="test/fixtures/native_option_eq_representation/main.spl"
STRUCT_FIXTURE="test/fixtures/native_option_eq_representation/struct_method_main.spl"
EXPECTED="hit=match miss=no-match none=match"
EXPECTED_STRUCT="hit=match miss=no-match none=match"

test -x "$SIMPLE_BINARY"
mkdir -p "$WORK_DIR"
trap 'rm -rf "$WORK_DIR"' EXIT HUP INT TERM

binary="$WORK_DIR/option-eq-representation"
log="$WORK_DIR/option-eq-representation.log"

env -u SIMPLE_BOOTSTRAP SIMPLE_NO_STUB_FALLBACK=1 \
    "$SIMPLE_BINARY" native-build \
    --source test/fixtures --entry-closure --entry "$FIXTURE" \
    --cache-dir "$WORK_DIR/cache" --output "$binary" >"$log" 2>&1

out="$(timeout 60 "$binary" 2>>"$log")"

if [ "$out" != "$EXPECTED" ]; then
    echo "FAIL — native-build inlined Option<text> equality regressed (free-function shape)"
    echo "  expected: $EXPECTED"
    echo "  actual:   $out"
    exit 1
fi

struct_binary="$WORK_DIR/option-eq-representation-struct"
struct_log="$WORK_DIR/option-eq-representation-struct.log"

env -u SIMPLE_BOOTSTRAP SIMPLE_NO_STUB_FALLBACK=1 \
    "$SIMPLE_BINARY" native-build \
    --source test/fixtures --entry-closure --entry "$STRUCT_FIXTURE" \
    --cache-dir "$WORK_DIR/cache-struct" --output "$struct_binary" >"$struct_log" 2>&1

struct_out="$(timeout 60 "$struct_binary" 2>>"$struct_log")"

if [ "$struct_out" != "$EXPECTED_STRUCT" ]; then
    echo "FAIL — native-build inlined Option<text> equality regressed (struct-method shape)"
    echo "  expected: $EXPECTED_STRUCT"
    echo "  actual:   $struct_out"
    exit 1
fi

echo "PASS — native-build inlined Option<text> equality: hit/miss/none all correct (free-function and struct-method shapes)"
