#!/bin/sh
# Regression gate for AOT (`native-build`) inlined `Option<text>` return
# equality.
#
# WHY THIS EXISTS: `bin/simple test` hard-defaults to the tree-walk
# interpreter and has no AOT mode (TestExecutionMode has Native/Process/Safe/
# Container/ContainerSequential variants but "Native" there means unsandboxed
# *process execution*, not the LLVM AOT backend) -- so no `*_spec.spl` can
# ever observe this lane. Only a script that actually drives `native-build`
# can fence it.
#
# Bug: doc/08_tracking/bug/native_inlined_option_return_representation_mismatch_2026-08-02.md
# ("row.get(\"run_id\") == Some(run_id)" disassembled to a bare text handle
# on the inlined-return side vs an rt_enum_new-boxed value on the Some(...)
# side, so rt_native_eq compared mismatched physical representations and the
# equality spuriously returned false).
#
# The original repro used a struct method (SdnRow.get). This fixture keeps
# the same Option<text>-equality shape but uses a free function instead: as
# of 2026-08-08 ANY struct/impl-method (even a trivial zero-arg one with no
# Option involved at all) crashes native-build with
# "semantic: undefined field 'kind': cannot access field on value of type
# 'nil'" -- reproduced both on this fixture AND on the pre-existing reference
# fixture `test/fixtures/compiler/native_immutable_fn_receiver.spl` (driven
# via `scripts/check/check-native-immutable-fn-receiver.shs`), so it is not
# specific to this defect or this fixture. That crash is a separate, more
# severe, currently-unfenced blocker -- see the bug doc for details -- and it
# means the struct-method variant of THIS defect could not be re-verified
# today. Only the free-function shape below is gated.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

SIMPLE_BINARY="${SIMPLE_BINARY:-bin/simple}"
WORK_DIR="${WORK_DIR:-/tmp/check-native-option-eq-representation.$$}"
FIXTURE="test/fixtures/native_option_eq_representation/main.spl"
EXPECTED="hit=match miss=no-match none=match"

test -x "$SIMPLE_BINARY"
mkdir -p "$WORK_DIR"
trap 'rm -rf "$WORK_DIR"' EXIT HUP INT TERM

binary="$WORK_DIR/option-eq-representation"
log="$WORK_DIR/option-eq-representation.log"

env -u SIMPLE_BOOTSTRAP SIMPLE_NO_STUB_FALLBACK=1 \
    "$SIMPLE_BINARY" native-build \
    --source test/fixtures --entry-closure --entry "$FIXTURE" \
    --cache-dir "$WORK_DIR/cache" --output "$binary" >"$log" 2>&1

out="$(timeout 60 "$binary" 2>>"$log")"

if [ "$out" != "$EXPECTED" ]; then
    echo "FAIL — native-build inlined Option<text> equality regressed"
    echo "  expected: $EXPECTED"
    echo "  actual:   $out"
    exit 1
fi

echo "PASS — native-build inlined Option<text> equality: hit/miss/none all correct (free-function shape)"
