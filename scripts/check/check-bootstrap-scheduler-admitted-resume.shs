#!/bin/sh
# Contract fixtures only: synthetic bytes never execute or qualify a compiler.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
BOOTSTRAP_STAGE3_VERSION_ROOT=$root
BOOTSTRAP_STAGE3_FACADE_PATH="$root/scripts/check/lib/bootstrap-stage3-provenance.shs"
export BOOTSTRAP_STAGE3_VERSION_ROOT BOOTSTRAP_STAGE3_FACADE_PATH
SIMPLE_ABI_POLICY=v1; export SIMPLE_ABI_POLICY
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$root/scripts/check/lib/bootstrap-planner-admission-bound.shs"
. "$root/scripts/bootstrap/bootstrap-scheduler-contract.shs"
. "$root/scripts/check/lib/stage4-candidate-provenance.shs"
scratch=$(mktemp -d "${TMPDIR:-/tmp}/scheduler-resume-fixture.XXXXXX")
scratch=$(CDPATH= cd -- "$scratch" && pwd -P)
trap 'chmod -R u+w "$scratch" 2>/dev/null || true; rm -rf "$scratch"' EXIT HUP INT TERM
checks=0
fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
check() { checks=$((checks + 1)); "$@" || fail "$*"; }
reject() { checks=$((checks + 1)); if "$@"; then fail "unexpected acceptance: $*"; fi; }
replace_in_file() { sed "$1" "$2" >"$2.next"; mv "$2.next" "$2"; }
# Reuse only the existing fixture constructor, not its executed test matrix.
# Its canonical admission writer and verifiers stay real. Place the fixture in
# the production host discovery layout (retaining a .exe filename fixture) before the writer seals paths.
awk '/^make_fixture\(\)/ {copy=1} /^run_producer\(\)/ {copy=0} copy {print}' \
 "$root/scripts/check/check-bootstrap-planner-admission-producer.shs" | \
 sed 's@mf_evidence_dir="$mf_dst/build/bootstrap/provenance/fixture"@mf_evidence_dir="$mf_dst/build/bootstrap/stage3/$fixture_platform"@' >"$scratch/fixture.sh"
. "$scratch/fixture.sh"
host_platform=$(bootstrap_stage3_host_platform) || fail "canonical host selector unavailable"
fixture_platform=$host_platform
fixture="$scratch/source"
make_fixture "$fixture" 'stage2-provenance: pure-simple' strict .exe
output="$fixture/build/bootstrap"
admission="$output/stage3/$fixture_platform/stage2-admitted/admission.env"
candidate="$output/stage3/$fixture_platform/stage2-admitted/simple.exe"
check test -f "$candidate"
check bootstrap_scheduler_verify_admitted_parent "$admission" "$output" "$root"
lease="$scratch/lease.env"
printf 'schema=simple-bootstrap-generation-lease-v1\ngeneration=fixture-new\nstatus=current\n' >"$lease"
# Explicit timestamp ordering; no sleep and no production timestamp mutation.
touch -t 202001010000 "$admission"
touch -t 202001020000 "$lease"
lease_sha=$(bootstrap_scheduler_hash_file "$lease")
record="$scratch/resume.env"
# A second correctly sealed foreign-target fixture must not make host discovery
# ambiguous, nor substitute for the host when its admission is absent.
fixture_platform=foreign-target-fixture
make_fixture "$fixture" 'stage2-provenance: pure-simple' strict .exe
foreign_admission="$output/stage3/$fixture_platform/stage2-admitted/admission.env"
check test -f "$foreign_admission"
reject bootstrap_scheduler_verify_admitted_parent "$foreign_admission" "$output" "$root"
fixture_platform=$host_platform
mv "$output/stage3/$host_platform" "$scratch/held-host"
reject bootstrap_scheduler_write_resume_input "$scratch/foreign-only.env" "$output" "$root" "$lease" "$lease_sha"
check test ! -e "$scratch/foreign-only.env"
mv "$scratch/held-host" "$output/stage3/$host_platform"
reject bootstrap_scheduler_admission_after_lease "$admission" "$lease"
check bootstrap_scheduler_write_resume_input "$record" "$output" "$root" "$lease" "$lease_sha"
check bootstrap_scheduler_verify_resume_input "$record" "$output" "$root" "$lease" "$lease_sha"
check test "$(bootstrap_scheduler_manifest_value candidate_path "$record")" = "$candidate"
# The sealed record must not be overwritten or silently rebound.
reject bootstrap_scheduler_write_resume_input "$record" "$output" "$root" "$lease" "$lease_sha"
for mutated in "$candidate" "$admission" \
 "$output/stage3/$fixture_platform/source-inputs-before.txt" \
 "$output/stage3/$fixture_platform/runtime-admitted.txt" \
 "$output/stage3/$fixture_platform/tool-authority-before.txt" "$lease"; do
 rm -f "$scratch/original"
 cp -p "$mutated" "$scratch/original"
 chmod u+w "$mutated"
 printf '\nchanged-fixture-byte\n' >>"$mutated"
 reject bootstrap_scheduler_verify_resume_input "$record" "$output" "$root" "$lease" "$lease_sha"
 cp -p "$scratch/original" "$mutated"
done
check bootstrap_scheduler_verify_resume_input "$record" "$output" "$root" "$lease" "$lease_sha"
cp "$record" "$scratch/record.original"
replace_in_file 's@^candidate_path=.*@candidate_path=/outside/swapped/simple.exe@' "$record"
reject bootstrap_scheduler_verify_resume_input "$record" "$output" "$root" "$lease" "$lease_sha"
cp "$scratch/record.original" "$record"
# A lease from another generation never gains authority by copying the record.
printf 'schema=simple-bootstrap-generation-lease-v1\ngeneration=other\nstatus=current\n' >"$scratch/other-lease"
other_sha=$(bootstrap_scheduler_hash_file "$scratch/other-lease")
reject bootstrap_scheduler_verify_resume_input "$record" "$output" "$root" "$scratch/other-lease" "$other_sha"
touch -t 202001030000 "$admission"
check bootstrap_scheduler_admission_after_lease "$admission" "$lease"
# Stage4 binding remains independently mandatory; matching a resume input
# cannot supply it. Exercise the real binding checker with fixture metadata.
continuation="$scratch/stage4-continuation.env"
provenance="$scratch/stage4-provenance.env"
printf 'schema=simple-bootstrap-stage4-continuation-admission-v1\nstatus=prepared\nplanner_stage4_binding_sha256=fixture-binding\n' >"$continuation"
printf 'stage4_continuation_path=%s\nstage4_continuation_sha256=%s\nplanner_stage4_binding_sha256=fixture-binding\n' \
 "$continuation" "$(bootstrap_stage3_hash_file "$continuation")" >"$provenance"
check stage4_verify_continuation_binding "$provenance"
replace_in_file 's/fixture-binding/wrong-binding/' "$provenance"
reject stage4_verify_continuation_binding "$provenance"
rm "$continuation"
reject stage4_verify_continuation_binding "$provenance"
printf 'PASS: %s checks, 0 failed (fixture contracts only; no compiler execution)\n' "$checks"
