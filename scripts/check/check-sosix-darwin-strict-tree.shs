#!/bin/sh
# This is evidence of unavailable strict authority, not a V4 qualification.
set -eu
case "${1:-}" in
    ''|--require-strict) ;;
    *) echo 'usage: check-sosix-darwin-strict-tree.shs [--require-strict]' >&2; exit 64 ;;
esac
if [ "$(uname -s)" != Darwin ]; then
    echo 'SKIP: Darwin strict-tree evidence requires macOS'
    exit 77
fi
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/sosix-darwin-strict-tree.XXXXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
"${CC:-cc}" -std=c11 -O0 -Wall -Wextra -Werror -Wno-deprecated-declarations \
    "$root/src/runtime/test/rt_sosix_darwin_strict_tree_selfcheck.c" -o "$scratch/selfcheck"
"$scratch/selfcheck"
if [ "${1:-}" = --require-strict ]; then
    echo 'FAIL: no OS-enforced all-descendant owner is installed' >&2
    exit 78
fi
