#!/bin/sh
# Drives bootstrap_stage_sanity() from scripts/bootstrap/bootstrap-from-scratch.sh
# in isolation against synthetic candidate binaries.
#
# Why this exists: the gate's version comparison was a hardcoded literal
# ("simple-bootstrap 1.0.0-beta"). Release commit 9a3f6051996 bumped the
# compiler's version to 1.0.0-RC without updating it, so NO correctly-built
# Stage-2 binary could pass. Nothing detected it, because (a) the imported
# Stage-2's stage2-sanity.receipt was COPIED not re-measured, and (b) the
# version comparison had no *_status field in the evidence -- every recorded
# field read as passing while the gate returned failure with no diagnostic.
#
# The function under test is EXTRACTED FROM THE SHIPPED FILE at run time, so
# this test cannot silently drift from the code it certifies.
#
# Verdict is the last stdout line: PASS/FAIL/ERROR. A run that executed 0
# cases is ERROR, never a pass.

set -u
case "${1:-}" in
  '') lifecycle_only=0 ;;
  --driver-log-lifecycle-only) lifecycle_only=1 ;;
  *) echo "ERROR — usage: $0 [--driver-log-lifecycle-only]"; exit 2 ;;
esac
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
src="${repo_root}/scripts/bootstrap/bootstrap-from-scratch.sh"
work=$(mktemp -d) || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
trap 'rm -rf "${work}"' EXIT

CASES_RUN=0
FAILURES=

note() { printf '  %s\n' "$*"; }

# ---- extract the function under test, verbatim -----------------------------
fn="${work}/fn.sh"
awk '/^bootstrap_stage_sanity\(\) \(/{f=1} f{print} f&&/^\)$/{exit}' "${src}" >"${fn}"
if ! grep -q '^bootstrap_stage_sanity() (' "${fn}"; then
  echo "ERROR — nothing was checked (could not extract bootstrap_stage_sanity from ${src})"
  exit 2
fi
if ! grep -q '^)$' "${fn}"; then
  echo "ERROR — nothing was checked (extracted function is truncated)"
  exit 2
fi
# Regression assertion: the expected version must NOT be a hardcoded literal.
if grep -q 'version.*=.*"simple-bootstrap 1\.0\.0-[A-Za-z]' "${fn}"; then
  echo "ERROR — nothing was checked (gate still hardcodes an expected version literal)"
  exit 2
fi

# bootstrap_stage_sanity calls this collaborator, which lives in the SAME
# shipped file and was never extracted. Without it the driven function died at
# `bootstrap_stage2_sanity_output_preflight: not found` and returned 1 before
# writing any evidence -- so every "must reject" case below was passing because
# the harness was broken, not because the gate rejected anything, and every
# "must accept" case was failing for the same reason. Extracted verbatim from
# the shipped file for the same no-drift reason as the function under test.
preflight_fn="${work}/preflight.sh"
awk '/^bootstrap_stage2_sanity_output_preflight\(\) \(/{f=1} f{print} f&&/^\)$/{exit}' \
  "${src}" >"${preflight_fn}"
if ! grep -q '^bootstrap_stage2_sanity_output_preflight() (' "${preflight_fn}"; then
  echo "ERROR — nothing was checked (could not extract bootstrap_stage2_sanity_output_preflight from ${src})"
  exit 2
fi
if ! grep -q '^)$' "${preflight_fn}"; then
  echo "ERROR — nothing was checked (extracted preflight is truncated)"
  exit 2
fi

# ---- harness: stubs for the gate's collaborators ---------------------------
harness="${work}/harness.sh"
cat >"${harness}" <<'EOF'
run_timeout() { shift; "$@"; }
bootstrap_stage3_hash_file() { sha256sum "$1" 2>/dev/null | cut -d' ' -f1; }
bootstrap_stage3_hash_stream() { sha256sum | cut -d' ' -f1; }
# candidate_frontend_capture_setup / candidate_frontend_pinned_smoke: the
# function under test was moved onto the PINNED capture path (it now calls
# these two, not candidate_frontend_smoke directly) without the harness being
# taught about them, so every case died at `candidate_frontend_capture_setup:
# not found`. The real capture_setup pins the output directory through an open
# descriptor (/proc/<pid>/fd/6 on Linux) so a symlink swap cannot redirect the
# probe's writes; for a synthetic candidate in a private mktemp -d that
# hardening has nothing to defend against, so the stub hands back the plain
# directory and the pinned smoke delegates to the existing candidate_frontend_
# smoke stub. What must stay real is the variable the receipt records.
candidate_frontend_capture_setup() {
  CANDIDATE_FRONTEND_CAPTURE_KIND=harness-plain-dir
  CANDIDATE_FRONTEND_CAPTURE_PARENT=$(CDPATH= cd -- "$1" && pwd -P) || return 126
  export CANDIDATE_FRONTEND_CAPTURE_KIND CANDIDATE_FRONTEND_CAPTURE_PARENT
}
candidate_frontend_pinned_smoke() {
  if [ "${driver_fixture:-nonempty}" = empty ]; then
    : >"$2" || return 126
  else
    printf 'probe=synthetic driver=begin\n' >"$2" || return 126
  fi
  candidate_frontend_smoke "$1"
}
# candidate_frontend_smoke: real one compiles a fixture. Stub delegates to the
# candidate so a broken candidate genuinely fails the smoke, as in production.
candidate_frontend_smoke() {
  [ -z "${CANDIDATE_FRONTEND_LOG_PATH:-}" ] ||
    printf 'probe=synthetic build=begin\n' >"$CANDIDATE_FRONTEND_LOG_PATH"
  smoke_status=0
  "$1" __frontend_smoke__ 2>&1 || smoke_status=$?
  if [ -n "${CANDIDATE_FRONTEND_STATUS_PATH:-}" ]; then
    for smoke_probe in p2_add stage2_mir_retention stage2_module_path_naming hello_world_positional; do
      case "$smoke_probe" in p2_add) smoke_log=$CANDIDATE_FRONTEND_LOG_PATH ;; *) smoke_log=$CANDIDATE_FRONTEND_LOG_PATH.$(printf '%s' "$smoke_probe" | tr _ -) ;; esac
      printf 'probe=%s\n' "$smoke_probe" >"$smoke_log"
      smoke_sha=$(bootstrap_stage3_hash_file "$smoke_log")
      {
        echo schema=simple-bounded-process-log-v1; echo status=complete
        echo reason=child-exit; echo raw_status="$smoke_status"; echo max_bytes=4194304
        echo bytes_captured="$(wc -c <"$smoke_log")"; echo timeout_seconds="${COMPILER_BUILD_TIMEOUT_SECONDS:-180}"
        echo term_grace_seconds=1; echo combined_stream=stdout-stderr
        echo process_group=setsid; echo artifact_limit=none
        echo log_leaf="${smoke_log##*/}"; echo log_sha256="$smoke_sha"
      } >"$smoke_log.bounded.env"
    done
    {
      echo schema=simple-candidate-frontend-status-v2
      [ "$smoke_status" -eq 0 ] && echo result=pass || echo result=fail
      echo probe=complete
      echo raw_status="$smoke_status"
      echo bootstrap_mode="${CANDIDATE_FRONTEND_BOOTSTRAP:-0}"
      echo backend="${CANDIDATE_FRONTEND_BACKEND:-cranelift}"
      echo log_path="$CANDIDATE_FRONTEND_LOG_PATH"
      for smoke_probe in p2_add stage2_mir_retention stage2_module_path_naming hello_world_positional; do
        case "$smoke_probe" in p2_add) smoke_log=$CANDIDATE_FRONTEND_LOG_PATH ;; *) smoke_log=$CANDIDATE_FRONTEND_LOG_PATH.$(printf '%s' "$smoke_probe" | tr _ -) ;; esac
        echo "${smoke_probe}_log_path=$smoke_log"
        echo "${smoke_probe}_log_sha256=$(bootstrap_stage3_hash_file "$smoke_log")"
        echo "${smoke_probe}_collector_receipt_path=$smoke_log.bounded.env"
        echo "${smoke_probe}_collector_receipt_sha256=$(bootstrap_stage3_hash_file "$smoke_log.bounded.env")"
        echo "${smoke_probe}_raw_status=$smoke_status"
      done
    } >"$CANDIDATE_FRONTEND_STATUS_PATH"
  fi
  return "$smoke_status"
}
# Production globals normally initialized by bootstrap-from-scratch.sh.
backend=llvm
os=$(uname -s | tr "[:upper:]" "[:lower:]")
llvm_features=llvm
EOF

drive() { # drive <candidate> <evidence>  -> echoes rc on its own line
  ( driver_fixture=${3:-nonempty}
    . "${harness}"
    . "${repo_root}/scripts/check/lib/bootstrap-stage3/sanity.shs"
    repo_root="${REPO_ROOT_OVERRIDE}"; . "${preflight_fn}"; . "${fn}"
    bootstrap_stage_sanity "$1" "$2" "${work}/h" "${work}/t" "$PATH" >"$2.producer.log" 2>&1
    echo "RC=$?" )
}

mkdir -p "${work}/h" "${work}/t"

mk_candidate() { # mk_candidate <path> <version-string> <smoke-rc> <run-behaviour>
  cat >"$1" <<EOF
#!/bin/sh
case "\$1" in
  --version) echo "simple-bootstrap $2"; exit 0 ;;
  __frontend_smoke__) exit $3 ;;
  run) $4 ;;
esac
echo "error: unknown command '\$1'"; exit 1
EOF
  chmod +x "$1"
}
REJECT_RUN="echo \"error: unknown command 'run'\"; exit 1"

check() { # check <name> <expect pass|fail> <candidate> [expect_status_field]
  name=$1; expect=$2; cand=$3
  ev="${work}/${name}.env"
  out=$(drive "${cand}" "${ev}")
  rc=$(printf '%s' "${out}" | sed -n 's/^RC=//p')
  CASES_RUN=$((CASES_RUN + 1))
  if [ "${rc}" = 143 ] || [ "${rc}" = 137 ] || [ "${rc}" = 144 ]; then
    FAILURES="${FAILURES} ${name}(UNVERIFIED-signal-${rc})"
    note "${name}: UNVERIFIED (rc ${rc})"; return
  fi
  st=$(sed -n 's/^status=//p' "${ev}" 2>/dev/null)
  if [ "${expect}" = pass ]; then
    if [ "${rc}" = 0 ] && [ "${st}" = pass ]; then note "${name}: PASS (accepted, as required)"
    else FAILURES="${FAILURES} ${name}(expected-accept,got-rc=${rc},status=${st})"
         note "${name}: FAIL (expected accept; rc=${rc} status=${st})"; fi
  else
    if [ "${rc}" != 0 ] && [ "${st}" != pass ]; then note "${name}: PASS (rejected, as required; status=${st})"
    else FAILURES="${FAILURES} ${name}(expected-reject,got-rc=${rc},status=${st})"
         note "${name}: FAIL (expected reject; rc=${rc} status=${st})"; fi
  fi
}

REPO_ROOT_OVERRIDE="${repo_root}"

# Drive the shipped producer, then its real receipt reader. Candidates and
# frontend rows are explicit synthetic fixtures, not compiler qualification.
driver_lifecycle_consume() (
  BOOTSTRAP_STAGE3_FACADE_PATH="$repo_root/scripts/check/lib/bootstrap-stage3-provenance.shs"
  export BOOTSTRAP_STAGE3_FACADE_PATH
  . "$BOOTSTRAP_STAGE3_FACADE_PATH"
  bootstrap_stage3_verify_sanity_evidence_receipt "$1" "$1" "$work" "$2" "$repo_root"
)
driver_lifecycle_case() {
  lifecycle_name=$1 lifecycle_candidate=$2 lifecycle_expect=$3 lifecycle_kind=$4
  lifecycle_evidence="$work/$lifecycle_name.env"
  lifecycle_out=$(drive "$lifecycle_candidate" "$lifecycle_evidence" "$lifecycle_kind")
  lifecycle_rc=$(printf '%s' "$lifecycle_out" | sed -n 's/^RC=//p')
  lifecycle_status=$(sed -n 's/^status=//p' "$lifecycle_evidence")
  lifecycle_log=$(sed -n 's/^frontend_smoke_driver_log_path=//p' "$lifecycle_evidence")
  lifecycle_sha=$(sed -n 's/^frontend_smoke_driver_log_sha256=//p' "$lifecycle_evidence")
  CASES_RUN=$((CASES_RUN + 1))
  if [ "$lifecycle_rc" = "$lifecycle_expect" ] &&
     [ -f "$lifecycle_log" ] && [ ! -L "$lifecycle_log" ] &&
     [ "$(sha256sum "$lifecycle_log" | cut -d' ' -f1)" = "$lifecycle_sha" ]; then
    if [ "$lifecycle_expect" = 0 ]; then
      if [ "$lifecycle_status" = pass ] && driver_lifecycle_consume "$lifecycle_evidence" "$lifecycle_candidate" >"$work/$lifecycle_name.reader.log" 2>&1; then
        note "$lifecycle_name: PASS (producer log retained; real receipt reader accepted)"
      else
        FAILURES="$FAILURES $lifecycle_name(reader-rejected)"
        note "$lifecycle_name: FAIL (real receipt reader rejected)"
        tail -n 20 "$work/$lifecycle_name.reader.log" >&2
      fi
    elif [ "$lifecycle_status" = fail ]; then
      note "$lifecycle_name: PASS (failed producer retained original receipt-bound log)"
    else
      FAILURES="$FAILURES $lifecycle_name(unexpected-status)"
    fi
  else
    FAILURES="$FAILURES $lifecycle_name(log-lifecycle-or-status)"
    note "$lifecycle_name: FAIL (receipt log missing/mutated or wrong producer status)"
    tail -n 20 "$lifecycle_evidence.producer.log" >&2
  fi
}
REPO_VERSION=$(sed -n '1s/[[:space:]]*$//p' "$repo_root/VERSION")
mk_candidate "$work/lifecycle-good" "$REPO_VERSION" 0 "$REJECT_RUN"
mk_candidate "$work/lifecycle-broken" "$REPO_VERSION" 1 "$REJECT_RUN"
driver_lifecycle_case driver_log_pass_nonempty "$work/lifecycle-good" 0 nonempty
driver_lifecycle_case driver_log_pass_empty "$work/lifecycle-good" 0 empty
driver_lifecycle_case driver_log_fail_retained "$work/lifecycle-broken" 1 nonempty
# Recreate the observed deletion only in synthetic test evidence; the reader
# must still fail closed rather than accepting a receipt-bound missing log.
lifecycle_good="$work/driver_log_pass_empty.env"
mv "$lifecycle_good.frontend-driver.log" "$work/driver.saved"
CASES_RUN=$((CASES_RUN + 1))
if driver_lifecycle_consume "$lifecycle_good" "$work/lifecycle-good" >"$work/deleted-driver.reader.log" 2>&1; then
  FAILURES="$FAILURES deleted_driver_log(accepted)"
  note "deleted_driver_log: FAIL (reader accepted missing log)"
elif grep -q 'sanity-receipt role=driver failure=authority' "$work/deleted-driver.reader.log"; then
  note "deleted_driver_log: PASS (real reader rejected authority loss)"
else
  FAILURES="$FAILURES deleted_driver_log(wrong-rejection)"
  note "deleted_driver_log: FAIL (unexpected reader rejection)"
fi
if [ "$lifecycle_only" = 1 ]; then
  if [ -n "$FAILURES" ]; then echo "FAIL — $CASES_RUN lifecycle fixture cases:$FAILURES"; exit 1; fi
  echo "PASS — $CASES_RUN lifecycle fixture cases; no compiler qualification claim"
  exit 0
fi

echo "bootstrap_stage_sanity gate cases:"

# --- REPRODUCER: current repo version. Fails against the pre-fix gate (which
#     demanded the stale literal 1.0.0-beta), passes after the fix. -----------
REPO_VERSION=$(sed -n '1s/[[:space:]]*$//p' "${repo_root}/VERSION")
mk_candidate "${work}/good" "${REPO_VERSION}" 0 "${REJECT_RUN}" 
check reproducer_current_version pass "${work}/good"

# --- MUST STILL REJECT ------------------------------------------------------
# 1. Wrong version entirely (an unrelated/stale binary).
mk_candidate "${work}/badver" "0.0.0-bogus" 0 "${REJECT_RUN}"
check reject_wrong_version fail "${work}/badver"

# 2. The 2026-08-09 incident shape: frontend smoke cannot process a file.
mk_candidate "${work}/nolex" "${REPO_VERSION}" 1 "${REJECT_RUN}"
check reject_frontend_smoke_broken fail "${work}/nolex"

# 3. Stub that exits non-zero for everything.
printf '#!/bin/sh\nexit 3\n' >"${work}/stub"; chmod +x "${work}/stub"
check reject_dead_stub fail "${work}/stub"

# 4. Negative control integrity: a candidate that ACCEPTS `run` is not the
#    bootstrap entry we asked to build, and must be rejected.
mk_candidate "${work}/hasrun" "${REPO_VERSION}" 0 "exit 0"
check reject_candidate_that_accepts_run fail "${work}/hasrun"

# 5. Fail-closed on a missing VERSION file: must be ERROR-not-pass.
mkdir -p "${work}/norepo/src/app/cli"
REPO_ROOT_OVERRIDE="${work}/norepo"
check reject_missing_VERSION fail "${work}/good"
REPO_ROOT_OVERRIDE="${repo_root}"

# 6. Fail-closed on VERSION vs bootstrap_identity.spl DRIFT -- the exact defect.
mkdir -p "${work}/drift/src/app/cli" "${work}/drift/release"
echo "9.9.9-drift" >"${work}/drift/VERSION"
printf 'version:\n  schema: simple-release-version/1\n  semver: 9.9.9-drift\n' \
  >"${work}/drift/release/version.sdn"
cp "${repo_root}/src/app/cli/bootstrap_identity.spl" "${work}/drift/src/app/cli/"
REPO_ROOT_OVERRIDE="${work}/drift"
mk_candidate "${work}/driftbin" "9.9.9-drift" 0 "${REJECT_RUN}"
check reject_version_drift fail "${work}/driftbin"
REPO_ROOT_OVERRIDE="${repo_root}"

# 7. Reject an authority with a second, conflicting schema declaration.
mkdir -p "${work}/bad-schema/release" "${work}/bad-schema/src/app/cli"
cp "${repo_root}/VERSION" "${work}/bad-schema/VERSION"
cp "${repo_root}/release/version.sdn" "${work}/bad-schema/release/version.sdn"
printf 'schema: attacker-schema/99\n' >>"${work}/bad-schema/release/version.sdn"
cp "${repo_root}/src/app/cli/bootstrap_identity.spl" \
  "${work}/bad-schema/src/app/cli/bootstrap_identity.spl"
REPO_ROOT_OVERRIDE="${work}/bad-schema"
check reject_ambiguous_version_schema fail "${work}/good"
REPO_ROOT_OVERRIDE="${repo_root}"

# 8. Reject a bootstrap_version body whose tail expression changes the result.
mkdir -p "${work}/tail-identity/release" "${work}/tail-identity/src/app/cli"
cp "${repo_root}/VERSION" "${work}/tail-identity/VERSION"
cp "${repo_root}/release/version.sdn" "${work}/tail-identity/release/version.sdn"
cat >"${work}/tail-identity/src/app/cli/bootstrap_identity.spl" <<EOF
pub fn bootstrap_version() -> text:
    "${REPO_VERSION}"
    "9.9.9-stale"
EOF
REPO_ROOT_OVERRIDE="${work}/tail-identity"
check reject_bootstrap_identity_tail fail "${work}/good"
REPO_ROOT_OVERRIDE="${repo_root}"

# --- REPRODUCER (2026-09-12): an EXPORTED operator override of the probe
#     budget must survive bootstrap_stage_sanity's environment scrub.
#
#     The scrub `unset`s every name `env` reports, and `unset` removes the
#     VALUE, not merely the export attribute. COMPILER_BUILD_TIMEOUT_SECONDS is
#     read AFTER the scrub (candidate_frontend_admission.shs:238, the
#     --timeout-seconds of the bounded collector), so exporting it did not
#     raise the budget -- it destroyed it. Leaving it UNexported was the only
#     way the 180s default reached the probe, which is precisely why the knob
#     was unreachable from outside the script. Measured that day: a Stage-2
#     candidate_frontend_smoke reported `hello-world-positional-build failed
#     (raw rc=124)` against the 180s whole-probe budget while the LINK phase
#     alone took 273.8s at host load 47 (`phase=link state=succeeded
#     elapsed_ms=299399 dt_ms=273785`), so the rc=124 was the host, not a
#     verdict on the candidate.
#
#     Fail-closed: the assertion is on the bounded receipt the probe actually
#     wrote. Zero receipts is a FAILURE, not a pass -- a case that asserted
#     only "no abort" would go green on a run that never probed anything.
CASES_RUN=$((CASES_RUN + 1))
mkdir -p "${work}/tov"
(
  COMPILER_BUILD_TIMEOUT_SECONDS=1234
  export COMPILER_BUILD_TIMEOUT_SECONDS
  drive "${work}/good" "${work}/tov/timeout_override.env"
) >"${work}/tov/drive.out" 2>&1
override_seen=
override_receipts=0
override_wrong=
for override_receipt in "${work}/tov/"*.bounded.env; do
  [ -f "${override_receipt}" ] || continue
  override_receipts=$((override_receipts + 1))
  override_seen=$(sed -n 's/^timeout_seconds=//p' "${override_receipt}")
  [ "${override_seen}" = 1234 ] ||
    override_wrong="${override_wrong} ${override_receipt##*/}=${override_seen:-<absent>}"
done
if [ "${override_receipts}" -eq 0 ]; then
  FAILURES="${FAILURES} operator_timeout_override_survives_scrub(no-bounded-receipt-written)"
  note "operator_timeout_override_survives_scrub: FAIL (0 bounded receipts --"
  note "  nothing was probed, so nothing was checked)"
elif [ -n "${override_wrong}" ]; then
  FAILURES="${FAILURES} operator_timeout_override_survives_scrub(scrubbed:${override_wrong})"
  note "operator_timeout_override_survives_scrub: FAIL (exported override lost"
  note "  to the scrub;${override_wrong}, expected 1234)"
else
  note "operator_timeout_override_survives_scrub: PASS (${override_receipts} bounded"
  note "  receipt(s), every one records timeout_seconds=1234)"
fi

# --- non-vacuity + evidence completeness -----------------------------------
for f in version_expect_status version_match_status unsupported_match_status \
         frontend_smoke_backend \
         frontend_smoke_bootstrap0_raw_status \
         frontend_smoke_bootstrap0_log_path \
         frontend_smoke_bootstrap0_log_sha256 \
         frontend_smoke_bootstrap0_status_path \
         frontend_smoke_bootstrap0_status_sha256 \
         frontend_smoke_bootstrap1_ran \
         frontend_smoke_bootstrap1_raw_status \
         frontend_smoke_bootstrap1_log_path \
         frontend_smoke_bootstrap1_log_sha256 \
         frontend_smoke_bootstrap1_status_path \
         frontend_smoke_bootstrap1_status_sha256 \
         frontend_smoke_driver_log_path frontend_smoke_driver_log_sha256 \
         sha_stable_status checks_run; do
  CASES_RUN=$((CASES_RUN + 1))
  if grep -q "^${f}=" "${work}/reproducer_current_version.env" 2>/dev/null; then
    note "evidence_field_${f}: PASS"
  else
    FAILURES="${FAILURES} evidence_field_${f}(absent)"
    note "evidence_field_${f}: FAIL (absent from evidence -- this is how the"
    note "  version mismatch stayed invisible)"
  fi
done

CASES_RUN=$((CASES_RUN + 1))
if [ -s "${work}/reject_frontend_smoke_broken.env.frontend-bootstrap-0.log" ] &&
   [ -s "${work}/reject_frontend_smoke_broken.env.frontend-bootstrap-0.status.env" ] &&
   [ -f "${work}/reject_frontend_smoke_broken.env.frontend-driver.log" ]; then
  note "failed_frontend_logs_retained: PASS"
else
  FAILURES="${FAILURES} failed_frontend_logs_retained(absent)"
  note "failed_frontend_logs_retained: FAIL"
fi

if [ "${CASES_RUN}" -eq 0 ]; then
  echo "ERROR — nothing was checked"
  exit 2
fi
if [ -n "${FAILURES}" ]; then
  echo "FAIL — ${CASES_RUN} case(s) checked, failures:${FAILURES}"
  exit 1
fi
echo "PASS — ${CASES_RUN} case(s) checked, gate accepts a legitimate candidate and rejects every broken one"
exit 0
