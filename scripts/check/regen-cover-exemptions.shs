#!/bin/sh
# Regenerate config/test/cover_exemptions.txt: legacy system specs that lack a
# header `# @cover`. Entries only shrink -- never add a new spec to the list;
# annotate it instead. Run from the repo root.
out=config/test/cover_exemptions.txt
tmp="$out.tmp"
{
  echo "# @cover legacy exemption list (generated; entries only shrink)."
  echo "# Regenerate: sh scripts/check/regen-cover-exemptions.shs"
  echo "# Meaning: these system specs predate the # @cover requirement; the cover"
  echo "# admission gate lets them run. New specs must carry # @cover. Remove a"
  echo "# line once the spec gains a measured # @cover annotation."
  find test -type f \( -name '*_spec.spl' -o -name '*_test.spl' \) \
    \( -path '*/system/*' -o -path '*/03_system/*' \) \
    ! -path '*/helpers/*' ! -path '*/fixtures/*' | LC_ALL=C sort | while read -r f; do
    awk '{ t=$0; sub(/^[ \t]+/,"",t); sub(/[ \t\r]+$/,"",t) }
         t ~ /^use / || t=="describe" || t ~ /^describe / { exit 1 }
         t ~ /^# @cover / { s=substr(t,10); gsub(/^[ \t]+|[ \t]+$/,"",s); if (s!="") found=1 }
         END { exit (found?0:1) }' "$f" && continue
    echo "$f"
  done
} > "$tmp" && mv "$tmp" "$out"
