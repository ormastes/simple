#!/bin/sh
# Focused temp-repository contract for converge-reviewed-fix.shs.
set -eu

ROOT=$(git rev-parse --show-toplevel)
SCRIPT="$ROOT/scripts/release/converge-reviewed-fix.shs"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT INT TERM

git init --bare "$TMP/remote.git" >/dev/null
git init "$TMP/seed" >/dev/null
git -C "$TMP/seed" config user.name test
git -C "$TMP/seed" config user.email test@example.invalid
printf 'base\n' >"$TMP/seed/value.txt"
git -C "$TMP/seed" add value.txt
git -C "$TMP/seed" commit -m base >/dev/null
git -C "$TMP/seed" branch -M main
git -C "$TMP/seed" remote add origin "$TMP/remote.git"
git -C "$TMP/seed" push origin main >/dev/null
git -C "$TMP/seed" switch -c release/1.2 >/dev/null
git -C "$TMP/seed" push origin release/1.2 >/dev/null
git -C "$TMP/seed" switch main >/dev/null
printf 'base\nfix\n' >"$TMP/seed/value.txt"
git -C "$TMP/seed" commit -am 'fix: reviewed' >/dev/null
FIX=$(git -C "$TMP/seed" rev-parse HEAD)
git -C "$TMP/seed" push origin main >/dev/null

git clone "$TMP/remote.git" "$TMP/coordinator" >/dev/null 2>&1
mkdir "$TMP/worktrees"
git -C "$TMP/coordinator" config user.name test
git -C "$TMP/coordinator" config user.email test@example.invalid
cat >"$TMP/review.sdn" <<EOF
review:
  schema: spipe-review-receipt/1
  source_commit_sha: $FIX
  change_id: change-1
  kind: fix
  verdict: approved
EOF

OUT=$(cd "$TMP/coordinator" && "$SCRIPT" \
    --direction main-to-release --release-line 1.2 --commit "$FIX" \
    --review-receipt "$TMP/review.sdn" --change-id change-1 \
    --work-id gh-1 --session-id s-test \
    --worktree-root "$TMP/worktrees")
BRANCH=$(printf '%s\n' "$OUT" | sed -n 's/^branch=//p')
WORKTREE=$(printf '%s\n' "$OUT" | sed -n 's/^worktree=//p')
RECEIPT=$(printf '%s\n' "$OUT" | sed -n 's/^receipt=//p')
[ -n "$BRANCH" ] && [ -d "$WORKTREE" ] && [ -f "$RECEIPT" ]
[ "$(git -C "$WORKTREE" rev-parse HEAD^)" = "$(git --git-dir="$TMP/remote.git" rev-parse refs/heads/release/1.2)" ]
[ "$(git --git-dir="$TMP/remote.git" rev-parse refs/heads/main)" = "$FIX" ]
[ "$(git --git-dir="$TMP/remote.git" rev-parse refs/heads/release/1.2)" != "$(git -C "$WORKTREE" rev-parse HEAD)" ]
grep -q '^  protected_ref_updated: false$' "$RECEIPT"
grep -q '^  pushed: false$' "$RECEIPT"
grep -q "^  source_commit_sha: $FIX$" "$RECEIPT"

# The reverse flow also starts from freshly fetched release/main heads and
# leaves main untouched for protected integration.
git -C "$TMP/seed" switch release/1.2 >/dev/null
printf 'release fix\n' >"$TMP/seed/release-fix.txt"
git -C "$TMP/seed" add release-fix.txt
git -C "$TMP/seed" commit -m 'fix: release-first' >/dev/null
RELEASE_FIX=$(git -C "$TMP/seed" rev-parse HEAD)
git -C "$TMP/seed" push origin release/1.2 >/dev/null
cat >"$TMP/release-review.sdn" <<EOF
review:
  schema: spipe-review-receipt/1
  source_commit_sha: $RELEASE_FIX
  change_id: change-2
  kind: fix
  verdict: approved
EOF
REVERSE=$(cd "$TMP/coordinator" && "$SCRIPT" \
    --direction release-to-main --release-line 1.2 --commit "$RELEASE_FIX" \
    --review-receipt "$TMP/release-review.sdn" --change-id change-2 \
    --work-id gh-2 --session-id s-reverse --worktree-root "$TMP/worktrees")
REVERSE_RECEIPT=$(printf '%s\n' "$REVERSE" | sed -n 's/^receipt=//p')
grep -q '^  direction: release-to-main$' "$REVERSE_RECEIPT"
grep -q '^  target_ref: refs/heads/main$' "$REVERSE_RECEIPT"

# Duplicate typed fields are ambiguous and must not be accepted.
cp "$TMP/review.sdn" "$TMP/duplicate.sdn"
printf '  verdict: approved\n' >>"$TMP/duplicate.sdn"
if (cd "$TMP/coordinator" && "$SCRIPT" \
    --direction main-to-release --release-line 1.2 --commit "$FIX" \
    --review-receipt "$TMP/duplicate.sdn" --change-id change-1 \
    --work-id gh-dup --session-id s-dup --worktree-root "$TMP/worktrees") \
    >/dev/null 2>&1; then
    echo 'check-converge-reviewed-fix: duplicate review key unexpectedly accepted' >&2
    exit 1
fi

# A post-cherry-pick receipt-path rejection must clean the newly created
# branch/worktree rather than leaving private mutation behind.
if (cd "$TMP/coordinator" && "$SCRIPT" \
    --direction main-to-release --release-line 1.2 --commit "$FIX" \
    --review-receipt "$TMP/review.sdn" --change-id change-1 \
    --work-id gh-clean --session-id s-clean --worktree-root "$TMP/worktrees" \
    --receipt ../escape.sdn) >/dev/null 2>&1; then
    echo 'check-converge-reviewed-fix: escaping receipt path unexpectedly accepted' >&2
    exit 1
fi
if git -C "$TMP/coordinator" show-ref --verify --quiet \
    "refs/heads/work/backport/1.2-gh-clean-s-clean-$(printf '%s' "$FIX" | cut -c1-12)"; then
    echo 'check-converge-reviewed-fix: failed preparation leaked its branch' >&2
    exit 1
fi
[ ! -e "$TMP/worktrees/s-clean-backport-$(printf '%s' "$FIX" | cut -c1-12)" ] || {
    echo 'check-converge-reviewed-fix: failed preparation leaked its worktree' >&2
    exit 1
}

printf 'dirty\n' >"$TMP/coordinator/dirty.txt"
if (cd "$TMP/coordinator" && "$SCRIPT" \
    --direction main-to-release --release-line 1.2 --commit "$FIX" \
    --review-receipt "$TMP/review.sdn" --change-id change-1 \
    --work-id gh-2 --session-id s-dirty \
    --worktree-root "$TMP/worktrees") >/dev/null 2>&1; then
    echo 'check-converge-reviewed-fix: dirty coordinator unexpectedly accepted' >&2
    exit 1
fi
rm "$TMP/coordinator/dirty.txt"

sed 's/verdict: approved/verdict: rejected/' "$TMP/review.sdn" >"$TMP/rejected.sdn"
if (cd "$TMP/coordinator" && "$SCRIPT" \
    --direction main-to-release --release-line 1.2 --commit "$FIX" \
    --review-receipt "$TMP/rejected.sdn" --change-id change-1 \
    --work-id gh-3 --session-id s-rejected \
    --worktree-root "$TMP/worktrees") >/dev/null 2>&1; then
    echo 'check-converge-reviewed-fix: rejected review unexpectedly accepted' >&2
    exit 1
fi

echo 'check-converge-reviewed-fix: PASS'
