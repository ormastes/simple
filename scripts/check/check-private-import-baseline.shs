#!/bin/sh
# Ratchet gate for scripts/check/private_import_baseline.txt.
#
# The baseline freezes legacy `file|name` pairs: a private (bare `fn`, not
# exported) top-level fn that other directories import via a braced `use`.
# The interpreter warns on those and ERRORS on any pair not listed. This gate:
#   1. fails on a STALE entry -- the file is gone, or `name` is no longer a
#      private top-level fn there (became `pub`, exported, renamed, removed);
#   2. fails if the baseline GAINED any line relative to a base revision, so
#      it can only shrink (removals only).
#
#   sh scripts/check/check-private-import-baseline.shs [--root DIR] [--base REV] [--selftest]
#
# --base overrides PRIVATE_IMPORT_BASE (the trusted CI event base), then defaults to the merge-base of HEAD with origin/release/1.0.0; when the
# base revision has no baseline file (the introducing change) the ratchet check
# is skipped and says so.
#
# Last stdout line is the verdict:
#   PASS - <n> baseline entries checked, 0 stale, 0 added vs <base>   (exit 0)
#   FAIL - ...                                                        (exit 1)
#   ERROR - nothing was checked (<reason>)                            (exit 2)
set -u

BASELINE_REL="scripts/check/private_import_baseline.txt"

stale_scan() (
    scan_root=$(cd "$1" && pwd -P) || return 2
    scan_tmp_parent=$(cd "${TMPDIR:-/tmp}" && pwd -P) || return 2
    scan_tmp=$(mktemp -d "$scan_tmp_parent/private-import-sources.XXXXXX") || return 2
    case $scan_tmp in "$scan_tmp_parent"/private-import-sources.*) ;; *) return 2 ;; esac
    trap 'rm -rf "$scan_tmp"' EXIT INT TERM HUP
    git -C "$scan_root" ls-files -t --stage -z > "$scan_tmp/index.raw" || return 2
    # -z has no record newlines: any LF here belongs to a filename. The
    # line-based baseline cannot represent it; reject before NUL conversion
    # can turn that filename into forged index metadata for another path.
    index_newlines=$(LC_ALL=C wc -l < "$scan_tmp/index.raw") || return 2
    [ "$index_newlines" -eq 0 ] || { echo 'private-import index filename contains newline' >&2; return 2; }
    tr '\000' '\n' < "$scan_tmp/index.raw" > "$scan_tmp/index.lines" || return 2
    awk -F'|' '!seen[$1]++ { print $1 }' "$scan_root/$BASELINE_REL" > "$scan_tmp/paths" || return 2
    # Join baseline paths to index metadata once, not once per sparse file.
    awk 'FILENAME==ARGV[1] { order[++n]=$0; wanted[$0]=1; next }
        { t=index($0,"\t"); path=substr($0,t+1); if (t && path in wanted) meta[path]=substr($0,1,t-1) }
        END { if (n<1) exit 2; for (j=1;j<=n;j++) { path=order[j]; split(meta[path],a," "); printf "%s|%s|%s|%s|%s\n",path,a[1],a[2],a[3],a[4] } }
    ' "$scan_tmp/paths" "$scan_tmp/index.lines" > "$scan_tmp/plan" || return 2
    expected_paths=$(awk 'END { print NR }' "$scan_tmp/paths") || return 2
    [ "$expected_paths" -gt 0 ] || return 2
    printf '' > "$scan_tmp/sources" || return 2
    printf '' > "$scan_tmp/requests" || return 2
    printf '' > "$scan_tmp/expected" || return 2
    printf '' > "$scan_tmp/materialized-paths" || return 2
    mkdir "$scan_tmp/tree" || return 2
    while IFS='|' read -r source_path source_tag source_mode source_oid source_stage || [ -n "$source_path" ]; do
        case $source_path in ''|/*|*\\*|?:*|..|../*|*/../*|*/..) echo 'private-import source path escapes root' >&2; return 2 ;; esac
        if [ -e "$scan_root/$source_path" ] || [ -L "$scan_root/$source_path" ]; then
            [ -f "$scan_root/$source_path" ] && [ -r "$scan_root/$source_path" ] || return 2
            source_real=$(realpath "$scan_root/$source_path") || return 2
            case $source_real in "$scan_root"/*) ;; *) echo 'private-import source symlink escapes root' >&2; return 2 ;; esac
            printf '%s|%s\n' "$source_path" "$scan_root/$source_path" >> "$scan_tmp/sources" || return 2
            continue
        fi
        case $source_tag in
            S)
                # Only stage0 regular blobs can be extracted into the private
                # prefix. Never materialize a symlink or an unmerged entry.
                [ -n "$source_oid" ] && [ "$source_stage" = 0 ] || return 2
                case $source_mode in 100644|100755) ;; *) echo 'private-import sparse source is not a regular blob' >&2; return 2 ;; esac
                printf '%s\000' "$source_path" >> "$scan_tmp/requests" || return 2
                printf '%s|%s\n' "$source_path" "$source_oid" >> "$scan_tmp/expected" || return 2
                printf '%s\n' "$source_path" >> "$scan_tmp/materialized-paths" || return 2
                printf '%s|%s\n' "$source_path" "$scan_tmp/tree/$source_path" >> "$scan_tmp/sources" || return 2
                ;;
            *) printf '%s|\n' "$source_path" >> "$scan_tmp/sources" || return 2 ;;
        esac
    done < "$scan_tmp/plan" || return 2
    if [ -s "$scan_tmp/requests" ]; then
        # No -u: checkout-index must not update the live index/stat cache.
        # Filters/attributes may transform extracted bytes, so verify raw blob
        # identity afterward rather than trusting core.autocrlf=false alone.
        git -C "$scan_root" -c core.autocrlf=false checkout-index --ignore-skip-worktree-bits --prefix="$scan_tmp/tree/" -z --stdin < "$scan_tmp/requests" || return 2
        while IFS= read -r source_path || [ -n "$source_path" ]; do
            [ -f "$scan_tmp/tree/$source_path" ] && [ ! -L "$scan_tmp/tree/$source_path" ] || return 2
        done < "$scan_tmp/materialized-paths" || return 2
        source_gitdir=$(git -C "$scan_root" rev-parse --absolute-git-dir) || return 2
        git -C "$scan_tmp/tree" --git-dir="$source_gitdir" hash-object --no-filters --stdin-paths < "$scan_tmp/materialized-paths" > "$scan_tmp/actual-hashes" || return 2
        awk -F'|' 'FILENAME==ARGV[1] { expected[++n]=$2; next } { ++i; if ($0!=expected[i]) bad=1 } END { if (n<1 || bad || i!=n) exit 1 }' "$scan_tmp/expected" "$scan_tmp/actual-hashes" || {
            echo 'private-import extracted bytes differ from indexed blob (checkout filter/attribute transformation)' >&2; return 2;
        }
    fi
    scan_source_declarations "$scan_tmp/sources" "$scan_root/$BASELINE_REL" "$expected_paths"
)

scan_source_declarations() {
    [ -s "$1" ] && [ "$3" -gt 0 ] || return 2
    awk -F'|' -v expected_paths="$3" '
        FILENAME==ARGV[1] { if (NF!=2 || ($1 in source)) map_error=1; source[$1]=$2; mapped++; next }
        function load(f,   line,n,rest,status) {
            delete priv; delete expo; missing=0
            if (source[f]=="") { missing=1; return }
            status=(getline line < source[f])
            if (status<0) { read_error=1; close(source[f]); return }
            while (status>0) {
                if (match(line,/^fn[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) {
                    n=substr(line,RSTART,RLENGTH); sub(/^fn[ \t]+/,"",n); priv[n]=1
                } else if (match(line,/^export[ \t]+/) && line !~ /^export[ \t]+use[ \t]/) {
                    rest=substr(line,RLENGTH+1); gsub(/[,]/," ",rest); split(rest,parts,/[ \t]+/)
                    for (i in parts) if (parts[i]!="") expo[parts[i]]=1
                }
                status=(getline line < source[f])
            }
            if (status<0) read_error=1
            close(source[f])
        }
        { f=$1; name=$2; if (f!=cur) { cur=f; load(f) }; if (missing || !(name in priv) || (name in expo)) print $0 }
        END { if (read_error || map_error || mapped!=expected_paths) exit 2 }
    ' "$1" "$2"
}

# prints added lines (current minus base); returns 3 when base has no baseline.
added_scan() (
    ascan_root=$1; abase=$2
    tmp_base=$(mktemp -d) || return 4
    trap 'rm -rf "$tmp_base"' EXIT INT TERM HUP
    commit=$(git -C "$ascan_root" rev-parse --verify "$abase^{commit}" 2>/dev/null) || return 4
    entry=$(git -C "$ascan_root" ls-tree "$commit" -- "$BASELINE_REL" 2>/dev/null) || return 4
    # Only a confirmed absent path is an introducing change. An unreadable
    # object at an existing path must not waive the no-growth comparison.
    [ -n "$entry" ] || return 3
    kind=$(printf '%s\n' "$entry" | awk '{ print $2 }')
    [ "$kind" = blob ] || return 4
    git -C "$ascan_root" show "$commit:$BASELINE_REL" > "$tmp_base/base" 2>/dev/null || return 4
    LC_ALL=C sort -u "$tmp_base/base" > "$tmp_base/sorted" || return 4
    LC_ALL=C sort -u "$ascan_root/$BASELINE_REL" > "$tmp_base/current" || return 4
    LC_ALL=C comm -13 "$tmp_base/sorted" "$tmp_base/current" || return 4
    return 0
)

# first5 TEXT -> first 5 lines joined by spaces. awk drains all input, so the
# producer never hits EPIPE (`printf | head -5` printed "printf: I/O error").
first5() { printf '%s\n' "$1" | awk 'NR <= 5 { printf "%s ", $0 }'; }

scan() {
    sroot=$1; sbase=$2
    file="$sroot/$BASELINE_REL"
    [ -f "$file" ] || { echo "ERROR - nothing was checked (missing $file)"; return 2; }
    total=$(wc -l < "$file" | tr -d ' ')
    [ "$total" -gt 0 ] || { echo "ERROR - nothing was checked (empty baseline)"; return 2; }
    stale=$(stale_scan "$sroot") || {
        echo "ERROR - nothing was checked (source/index scan failed)"; return 2;
    }
    if [ -n "$stale" ]; then
        k=$(printf '%s\n' "$stale" | wc -l | tr -d ' ')
        first=$(first5 "$stale")
        echo "FAIL - $total checked, $k stale: $first"
        return 1
    fi
    if [ -z "$sbase" ]; then
        sbase=$(git -C "$sroot" merge-base HEAD origin/release/1.0.0 2>/dev/null || true)
    fi
    if [ -z "$sbase" ]; then
        echo "ERROR - nothing was checked (no --base given and no merge-base with origin/release/1.0.0)"
        return 2
    fi
    git -C "$sroot" cat-file -e "$sbase^{commit}" 2>/dev/null || {
        echo "ERROR - nothing was checked (base is not a readable commit: $sbase)"; return 2;
    }
    added=$(added_scan "$sroot" "$sbase"); arc=$?
    case $arc in
        3) echo "PASS - $total baseline entries checked, 0 stale; ratchet skipped (base $sbase has no baseline: introducing change)"; return 0 ;;
        0) ;;
        *) echo "ERROR - nothing was checked (ratchet scan failed)"; return 2 ;;
    esac
    if [ -n "$added" ]; then
        k=$(printf '%s\n' "$added" | wc -l | tr -d ' ')
        first=$(first5 "$added")
        echo "FAIL - baseline gained $k line(s) vs $sbase (removals only): $first"
        return 1
    fi
    echo "PASS - $total baseline entries checked, 0 stale, 0 added vs $sbase"
    return 0
}

selftest() {
    # Keep the fixture in its own temporary repository when callers provide
    # Git directory overrides in their environment.
    unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
    d=$(mktemp -d) || { echo "ERROR - nothing was checked (mktemp)"; return 2; }
    trap 'rm -rf "$d"' EXIT INT TERM HUP
    mkdir -p "$d/scripts/check" "$d/lib"
    printf 'fn live() -> i64:\n    1\npub fn promoted() -> i64:\n    2\nfn exported() -> i64:\n    3\nexport exported\nfn other() -> i64:\n    4\n' > "$d/lib/m.spl"
    (cd "$d" && git init -q && git config core.autocrlf false && git config user.email t@t && git config user.name t \
        && printf 'lib/m.spl|live\nlib/m.spl|other\n' > "$BASELINE_REL" && git add -A && git commit -qm base) \
        || { echo "ERROR - selftest: git fixture failed"; return 2; }
    b=$(git -C "$d" rev-parse HEAD)
    out=$(scan "$d" "$b" | tail -1); case $out in PASS*) ;; *) echo "ERROR - selftest: live entries must PASS ($out)"; return 2 ;; esac
    printf 'lib/m.spl|live\n' > "$d/$BASELINE_REL"
    out=$(scan "$d" "$b" | tail -1); case $out in PASS*) ;; *) echo "ERROR - selftest: a removal must PASS ($out)"; return 2 ;; esac
    printf 'lib/m.spl|live\nlib/m.spl|other\nlib/m.spl|promoted\n' > "$d/$BASELINE_REL"
    out=$(scan "$d" "$b" | tail -1); case $out in FAIL*promoted*) ;; *) echo "ERROR - selftest: pub entry must be stale ($out)"; return 2 ;; esac
    printf 'lib/m.spl|live\nlib/m.spl|other\nlib/m.spl|exported\n' > "$d/$BASELINE_REL"
    out=$(scan "$d" "$b" | tail -1); case $out in FAIL*) ;; *) echo "ERROR - selftest: exported entry must be stale ($out)"; return 2 ;; esac
    printf 'fn extra() -> i64:\n    5\n' >> "$d/lib/m.spl"
    printf 'lib/m.spl|live\nlib/m.spl|other\nlib/m.spl|extra\n' > "$d/$BASELINE_REL"
    out=$(scan "$d" "$b" | tail -1); case $out in FAIL*gained*extra*) ;; *) echo "ERROR - selftest: an added line must FAIL the ratchet ($out)"; return 2 ;; esac
    printf 'lib/gone.spl|live\n' > "$d/$BASELINE_REL"
    out=$(scan "$d" "$b" | tail -1); case $out in FAIL*) ;; *) echo "ERROR - selftest: missing file must be stale ($out)"; return 2 ;; esac
    printf 'lib/m.spl|live\n' > "$d/$BASELINE_REL"
    out=$(scan "$d" missing-base); rc=$?
    [ "$rc" -eq 2 ] || { echo "ERROR - selftest: invalid base passed ($out)"; return 2; }
    # Full-checkout deletion: no sparse list must not hide a real removal.
    git -C "$d" checkout -q "$b" -- lib/m.spl
    printf 'lib/m.spl|live\n' > "$d/$BASELINE_REL"
    rm "$d/lib/m.spl"
    out=$(scan "$d" "$b"); rc=$?
    [ "$rc" -eq 1 ] || { echo "ERROR - selftest: full tracked deletion passed ($out)"; return 2; }
    git -C "$d" checkout -q "$b" -- lib/m.spl
    # Sparse private file is omitted, but its indexed declaration is checked.
    git -C "$d" update-index --skip-worktree lib/m.spl
    rm "$d/lib/m.spl"
    out=$(scan "$d" "$b"); rc=$?
    [ "$rc" -eq 0 ] || { echo "ERROR - selftest: sparse private declaration failed ($out)"; return 2; }
    [ ! -e "$d/lib/m.spl" ] || { echo "ERROR - selftest: scanner changed checkout"; return 2; }
    mkdir "$d/lib/m.spl"
    out=$(scan "$d" "$b"); rc=$?
    [ "$rc" -ne 0 ] || { echo "ERROR - selftest: sparse directory passed ($out)"; return 2; }
    rmdir "$d/lib/m.spl"
    if ln -s missing-target "$d/lib/m.spl" 2>/dev/null && [ -L "$d/lib/m.spl" ]; then
        out=$(scan "$d" "$b"); rc=$?
        [ "$rc" -ne 0 ] || { echo "ERROR - selftest: dangling sparse symlink passed ($out)"; return 2; }
    else
        # Windows hosts may lack native symlink permission. Directory/read
        # failure controls still run; do not fail a healthy gate on that host.
        echo "selftest NOTE: dangling-symlink fixture unavailable on this host"
    fi
    rm -f "$d/lib/m.spl"
    printf 'invalid index\n' > "$d/corrupt-index"
    out=$(GIT_INDEX_FILE="$d/corrupt-index" scan "$d" "$b" 2>/dev/null); rc=$?
    [ "$rc" -eq 2 ] || { echo "ERROR - selftest: corrupt index did not ERROR ($out)"; return 2; }
    big=$(awk 'BEGIN { for (i = 0; i < 20000; i++) print "lib/x.spl|n" i }')
    err=$(first5 "$big" 2>&1 >/dev/null)
    [ -z "$err" ] || { echo "ERROR - selftest: first5 wrote to stderr ($err)"; return 2; }
    [ "$(first5 "$big")" = "lib/x.spl|n0 lib/x.spl|n1 lib/x.spl|n2 lib/x.spl|n3 lib/x.spl|n4 " ] || { echo "ERROR - selftest: first5 output wrong"; return 2; }
    git -C "$d" update-index --info-only --cacheinfo "100644,1111111111111111111111111111111111111111,lib/m.spl" || return 2
    git -C "$d" update-index --skip-worktree lib/m.spl
    out=$(scan "$d" "$b" 2>/dev/null); rc=$?
    [ "$rc" -eq 2 ] || { echo "ERROR - selftest: missing indexed blob did not ERROR ($out)"; return 2; }
    # A staged promotion in a sparse file must be stale, not silently skipped.
    blob=$(printf 'pub fn live() -> i64:\n    1\n' | git -C "$d" hash-object -w --stdin)
    git -C "$d" update-index --cacheinfo "100644,$blob,lib/m.spl"
    git -C "$d" update-index --skip-worktree lib/m.spl
    out=$(scan "$d" "$b"); rc=$?
    [ "$rc" -eq 1 ] || { echo "ERROR - selftest: sparse public promotion passed ($out)"; return 2; }
    # An empty indexed file must not recycle a preceding file's declarations.
    blob=$(printf '' | git -C "$d" hash-object -w --stdin)
    git -C "$d" update-index --cacheinfo "100644,$blob,lib/m.spl"
    git -C "$d" update-index --skip-worktree lib/m.spl
    out=$(scan "$d" "$b"); rc=$?
    [ "$rc" -eq 1 ] || { echo "ERROR - selftest: sparse empty file passed ($out)"; return 2; }
    # A real base commit with an unreadable baseline object is not an
    # introducing change, even if the current baseline has gained a row.
    git -C "$d" show "$b:lib/m.spl" > "$d/lib/m.spl" || return 2
    printf 'fn extra() -> i64:\n    5\n' >> "$d/lib/m.spl"
    printf 'lib/m.spl|live\nlib/m.spl|other\nlib/m.spl|extra\n' > "$d/$BASELINE_REL"
    baseline_blob=$(git -C "$d" rev-parse "$b:$BASELINE_REL") || return 2
    object="$d/.git/objects/$(printf '%.2s' "$baseline_blob")/${baseline_blob#??}"
    mv "$object" "$d/base-blob-backup" || return 2
    out=$(scan "$d" "$b" 2>/dev/null); rc=$?
    mv "$d/base-blob-backup" "$object" || return 2
    [ "$rc" -eq 2 ] || { echo "ERROR - selftest: missing base blob skipped ratchet ($out)"; return 2; }
    # A genuinely absent baseline path still permits the introducing change.
    empty_tree=$(git -C "$d" mktree </dev/null) || return 2
    intro=$(printf 'intro fixture\n' | git -C "$d" commit-tree "$empty_tree") || return 2
    out=$(scan "$d" "$intro"); rc=$?
    [ "$rc" -eq 0 ] || { echo "ERROR - selftest: confirmed introducing change failed ($out)"; return 2; }
    : > "$d/$BASELINE_REL"
    scan "$d" "$b" >/dev/null; [ $? -eq 2 ] || { echo "ERROR - selftest: empty baseline must ERROR"; return 2; }
    sparse_extra_controls || return 2
    shell_index_controls || return 2
    shell_failure_controls || return 2
    return 0
}

sparse_extra_controls() (
    extra_tmp=$(cd "${TMPDIR:-/tmp}" && pwd -P) || return 2
    extra_dir=$(mktemp -d "$extra_tmp/private-import-new.XXXXXX") || return 2
    case $extra_dir in "$extra_tmp"/private-import-new.*) ;; *) return 2 ;; esac
    trap 'rm -rf "$extra_dir"' EXIT INT TERM HUP
    mkdir -p "$extra_dir/scripts/check" "$extra_dir/lib"
    printf 'fn live() -> i64:\n    1\n' > "$extra_dir/lib/m.spl"
    printf 'lib/m.spl|live\n' > "$extra_dir/$BASELINE_REL"
    (cd "$extra_dir" && git init -q && git config core.autocrlf false && git config user.email t@t && git config user.name t && git add -A && git commit -qm base) || return 2
    extra_base=$(git -C "$extra_dir" rev-parse HEAD) || return 2
    extra_expect_scan() {
        extra_expected_status=$1; extra_marker=$2
        extra_output=$(scan "$extra_dir" "$extra_base" 2>&1); extra_status=$?
        [ "$extra_status" -eq "$extra_expected_status" ] || { echo "ERROR - new control: expected $extra_expected_status, got $extra_status ($extra_output)"; return 2; }
        case $extra_output in *"$extra_marker"*) ;; *) echo "ERROR - new control: missing marker $extra_marker ($extra_output)"; return 2 ;; esac
    }
    git -C "$extra_dir" sparse-checkout init --cone && git -C "$extra_dir" sparse-checkout set scripts/check || return 2
    # Indexed-but-uncommitted public promotion must beat HEAD's private fn.
    extra_blob=$(printf 'pub fn live() -> i64:\n    1\n' | git -C "$extra_dir" hash-object -w --stdin) || return 2
    git -C "$extra_dir" update-index --cacheinfo "100644,$extra_blob,lib/m.spl" || return 2
    git -C "$extra_dir" update-index --skip-worktree lib/m.spl || return 2
    extra_expect_scan 1 'lib/m.spl|live' || return 2
    # Real Git index read failure, not a success-shaped mocked subprocess.
    cp "$extra_dir/.git/index" "$extra_dir/index.good" || return 2
    printf 'not an index\n' > "$extra_dir/.git/index"
    extra_expect_scan 2 'source/index scan failed' || return 2
    cp "$extra_dir/index.good" "$extra_dir/.git/index" || return 2
    git -C "$extra_dir" sparse-checkout disable || return 2
    git -C "$extra_dir" checkout HEAD -- lib/m.spl || return 2
    # A real tracked deletion in a full checkout cannot use indexed fallback.
    rm "$extra_dir/lib/m.spl" || return 2
    extra_expect_scan 1 'lib/m.spl|live' || return 2
    # A directory in place of source causes a source-read failure, exit2.
    mkdir "$extra_dir/lib/m.spl" || return 2
    extra_expect_scan 2 'source/index scan failed' || return 2
    rmdir "$extra_dir/lib/m.spl" || return 2
    # U+2028 is data inside a physical source record, not a second fn line.
    printf '# comment\342\200\250fn live() -> i64:\n    1\n' > "$extra_dir/lib/m.spl"
    extra_expect_scan 1 'lib/m.spl|live' || return 2
    printf 'fn live() -> i64:\n    1\n' > "$extra_dir/lib/m.spl"
    printf 'lib/m.spl|live\342\200\250other\n' > "$extra_dir/$BASELINE_REL"
    extra_unicode_expected=$(printf 'lib/m.spl|live\342\200\250other')
    extra_unicode_actual=$(stale_scan "$extra_dir"); extra_status=$?
    [ "$extra_status" -eq 0 ] && [ "$extra_unicode_actual" = "$extra_unicode_expected" ] || { echo 'ERROR - new control: U+2028 split a baseline record'; return 2; }
    echo 'PASS - six sparse/index/read/newline controls'
)


shell_index_controls() (
    shell_tmp=$(cd "${TMPDIR:-/tmp}" && pwd -P) || return 2
    shell_dir=$(mktemp -d "$shell_tmp/private-import-shell.XXXXXX") || return 2
    case $shell_dir in "$shell_tmp"/private-import-shell.*) ;; *) return 2 ;; esac
    trap 'rm -rf "$shell_dir"' EXIT INT TERM HUP
    mkdir -p "$shell_dir/scripts/check" "$shell_dir/lib"
    printf 'fn live() -> i64:\n    1\n' > "$shell_dir/lib/m.spl"
    printf 'lib/m.spl|live\n' > "$shell_dir/$BASELINE_REL"
    (cd "$shell_dir" && git init -q && git config core.autocrlf false && git config user.email t@t && git config user.name t && git add -A && git commit -qm base) || return 2
    git -C "$shell_dir" sparse-checkout init --cone && git -C "$shell_dir" sparse-checkout set scripts/check || return 2
    [ ! -e "$shell_dir/lib/m.spl" ] || return 2
    shell_before=$(git hash-object --no-filters "$shell_dir/.git/index") || return 2
    shell_output=$(stale_scan "$shell_dir"); shell_status=$?
    [ "$shell_status" -eq 0 ] && [ -z "$shell_output" ] || return 2
    [ "$(git hash-object --no-filters "$shell_dir/.git/index")" = "$shell_before" ] && [ ! -e "$shell_dir/lib/m.spl" ] || return 2
    # Explicit attributes override autocrlf=false: transformed extraction must
    # fail raw identity verification rather than hiding source declarations.
    printf 'lib/m.spl text eol=crlf\n' > "$shell_dir/.gitattributes"
    git -C "$shell_dir" add .gitattributes || return 2
    shell_output=$(stale_scan "$shell_dir" 2>&1); shell_status=$?
    [ "$shell_status" -eq 2 ] || return 2
    case $shell_output in *'differ from indexed blob'*) ;; *) return 2 ;; esac
    git -C "$shell_dir" reset -q HEAD -- .gitattributes && rm "$shell_dir/.gitattributes" || return 2
    # A sparse index symlink cannot escape the extraction prefix.
    shell_link=$(printf '../outside.spl' | git -C "$shell_dir" hash-object -w --stdin) || return 2
    git -C "$shell_dir" update-index --cacheinfo "120000,$shell_link,lib/m.spl" && git -C "$shell_dir" update-index --skip-worktree lib/m.spl || return 2
    shell_output=$(stale_scan "$shell_dir" 2>&1); shell_status=$?
    [ "$shell_status" -eq 2 ] || return 2
    case $shell_output in *'not a regular blob'*) ;; *) return 2 ;; esac
    echo 'PASS - shell raw-index/attribute/symlink/no-mutation controls'
)


shell_failure_controls() (
    failure_tmp=$(cd "${TMPDIR:-/tmp}" && pwd -P) || return 2
    failure_dir=$(mktemp -d "$failure_tmp/private-import-failure.XXXXXX") || return 2
    case $failure_dir in "$failure_tmp"/private-import-failure.*) ;; *) return 2 ;; esac
    trap 'rm -rf "$failure_dir"' EXIT INT TERM HUP
    mkdir -p "$failure_dir/scripts/check" "$failure_dir/lib" || return 2
    printf 'fn live() -> i64:\n    1\n' > "$failure_dir/lib/m.spl" || return 2
    printf 'lib/m.spl|live\n' > "$failure_dir/$BASELINE_REL" || return 2
    (cd "$failure_dir" && git init -q && git config core.autocrlf false && git config user.email t@t && git config user.name t && git add -A && git commit -qm base) || return 2
    failure_output=$(stale_scan "$failure_dir"); failure_status=$?
    [ "$failure_status" -eq 0 ] && [ -z "$failure_output" ] || return 2
    # Force a real redirection failure at the production sources initializer.
    # The wrapper still creates a real private mktemp directory; no Git or
    # scanner output is mocked into a success result.
    (
        mktemp() {
            failure_created=$(command mktemp "$@") || return 2
            mkdir "$failure_created/sources" || return 2
            printf '%s\n' "$failure_created"
        }
        failure_output=$(stale_scan "$failure_dir" 2>&1); failure_status=$?
        [ "$failure_status" -eq 2 ] || { echo 'ERROR - source-map write failure did not return ERROR2'; return 2; }
    ) || return 2
    : > "$failure_dir/empty-map" || return 2
    failure_output=$(scan_source_declarations "$failure_dir/empty-map" "$failure_dir/$BASELINE_REL" 1); failure_status=$?
    [ "$failure_status" -eq 2 ] || { echo 'ERROR - empty first mapping became PASS'; return 2; }
    # A newline-bearing index path must not forge another S metadata record.
    # Insert the actual Git index entry without needing OS filename support.
    failure_blob=$(printf 'unrelated\n' | git -C "$failure_dir" hash-object -w --stdin) || return 2
    failure_name=$(printf 'lib/newline\nS 100644 forged 0\tlib/m.spl')
    git -C "$failure_dir" -c core.protectNTFS=false update-index --add --cacheinfo "100644,$failure_blob,$failure_name" || return 2
    failure_output=$(stale_scan "$failure_dir" 2>&1); failure_status=$?
    [ "$failure_status" -eq 2 ] || { echo 'ERROR - newline index path was accepted'; return 2; }
    case $failure_output in *'filename contains newline'*) ;; *) return 2 ;; esac
    echo 'PASS - real write-failure/empty-map/newline-index controls'
)


main_root=.
main_base=${PRIVATE_IMPORT_BASE:-}
mode=scan
while [ $# -gt 0 ]; do
    case $1 in
        --root) main_root=$2; shift ;;
        --base) main_base=$2; shift ;;
        --selftest) mode=selftest ;;
        *) echo "ERROR - nothing was checked (unknown arg $1)"; exit 2 ;;
    esac
    shift
done
( selftest ) || exit 2
[ "$mode" = selftest ] && { echo "PASS - selftest fixtures ok"; exit 0; }
scan "$main_root" "$main_base"
