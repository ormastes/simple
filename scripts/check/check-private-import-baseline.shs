#!/bin/sh
# Ratchet gate for scripts/check/private_import_baseline.txt.
# Requires Python3 and Git for sparse-index-aware source reads.
#
# The baseline freezes legacy `file|name` pairs: a private (bare `fn`, not
# exported) top-level fn that other directories import via a braced `use`.
# The interpreter warns on those and ERRORS on any pair not listed. This gate:
#   1. fails on a STALE entry -- the file is gone, or `name` is no longer a
#      private top-level fn there (became `pub`, exported, renamed, removed);
#   2. fails if the baseline GAINED any line relative to a base revision, so
#      it can only shrink (removals only).
#
#   sh scripts/check/check-private-import-baseline.shs [--root DIR] [--base REV] [--selftest]
#
# Explicit --base wins, then the fetched CI BASE_SHA commit, then the merge-base
# of HEAD with origin/release/1.0.0. When the
# base revision has no baseline file (the introducing change) the ratchet check
# is skipped and says so.
#
# Last stdout line is the verdict:
#   PASS - <n> baseline entries checked, 0 stale, 0 added vs <base>   (exit 0)
#   FAIL - ...                                                        (exit 1)
#   ERROR - nothing was checked (<reason>)                            (exit 2)
set -u

BASELINE_REL="scripts/check/private_import_baseline.txt"

stale_scan() {
    command -v python3 >/dev/null 2>&1 || { echo "private-import scan needs python3" >&2; return 2; }
    python3 - "$1" "$BASELINE_REL" <<'PY'
import pathlib, re, subprocess, sys, tempfile

root = pathlib.Path(sys.argv[1]).resolve()
try:
    rows = (root / sys.argv[2]).read_bytes().decode("utf8", "surrogateescape").split("\n")
    if rows and rows[-1] == "":
        rows.pop()
    paths = list(dict.fromkeys(row.split("|", 1)[0] for row in rows))
    sources, absent = {}, []
    for path in paths:
        if pathlib.PurePosixPath(path).is_absolute() or ".." in pathlib.PurePosixPath(path).parts:
            raise ValueError("baseline source escapes root: " + path)
        try:
            sources[path] = (root / path).read_bytes()
        except FileNotFoundError:
            absent.append(path)
    if absent:
        # Only a legitimately sparse/pruned index entry may use indexed bytes.
        # A deleted file in a full checkout must remain stale, never be revived
        # from HEAD. Read-only index queries preserve local staged contents too.
        indexed = subprocess.run(["git", "-C", str(root), "ls-files", "-t", "-z"], capture_output=True)
        if indexed.returncode:
            raise ValueError("cannot inspect sparse index")
        sparse = {item[2:].decode("utf8", "surrogateescape") for item in indexed.stdout.split(b"\0") if item.startswith(b"S ")}
        requests = [path for path in absent if path in sparse]
        if requests:
            # One Git process; source bodies remain cached below for classification.
            # Promisor repositories may lazily fetch missing blobs. No checkout,
            # index mutation, untracked fallback, baseline exclusion or scan of
            # unrelated file bodies is needed for the required sparse CI lane.
            with tempfile.TemporaryFile() as queries, tempfile.TemporaryFile() as errors:
                queries.write("".join(":" + path + "\n" for path in requests).encode("utf8", "surrogateescape"))
                queries.seek(0)
                process = subprocess.Popen(["git", "-C", str(root), "cat-file", "--batch"], stdin=queries, stdout=subprocess.PIPE, stderr=errors)
                try:
                    for path in requests:
                        header = process.stdout.readline().rstrip(b"\n").split()
                        if len(header) != 3 or header[1] != b"blob":
                            raise ValueError("cannot read sparse source: " + path)
                        size = int(header[2])
                        content = process.stdout.read(size)
                        if len(content) != size or process.stdout.read(1) != b"\n":
                            raise ValueError("truncated sparse source: " + path)
                        sources[path] = content
                    if process.wait():
                        raise ValueError("sparse source read failed")
                finally:
                    if process.poll() is None:
                        process.kill()
                        process.wait()
    declarations = {}
    for path, content in sources.items():
        private, exported = set(), set()
        for line in content.decode("utf8", "surrogateescape").split("\n"):
            match = re.match(r"^fn[ \t]+([A-Za-z_][A-Za-z0-9_]*)", line)
            if match:
                private.add(match[1])
            elif re.match(r"^export[ \t]+", line) and not re.match(r"^export[ \t]+use[ \t]", line):
                rest = re.sub(r"^export[ \t]+", "", line).replace(",", " ")
                exported.update(name for name in re.split(r"[ \t]+", rest) if name)
        declarations[path] = (private, exported)
    for row in rows:
        path, name = row.split("|", 1)
        private, exported = declarations.get(path, (set(), set()))
        if name not in private or name in exported:
            print(row)
except (OSError, ValueError) as error:
    print("private-import source scan failed: " + str(error), file=sys.stderr)
    sys.exit(2)
PY
}

# An explicit CLI base wins over the workflow's actual event base. Do not
# substitute HEAD when a sparse SHA-only CI checkout lacks a remote branch ref.
resolve_scan_base() {
    resolve_root=$1; resolve_explicit=$2
    if [ -n "$resolve_explicit" ]; then
        printf '%s' "$resolve_explicit"; return 0
    fi
    [ -n "${BASE_SHA:-}" ] || return 0
    case $BASE_SHA in *[!0-9a-fA-F]*) echo 'invalid CI BASE_SHA' >&2; return 2 ;; esac
    [ "${#BASE_SHA}" -eq 40 ] || { echo 'invalid CI BASE_SHA length' >&2; return 2; }
    git -C "$resolve_root" rev-parse --verify "$BASE_SHA^{commit}" >/dev/null 2>&1 || {
        echo 'CI BASE_SHA commit is unavailable' >&2; return 2;
    }
    printf '%s' "$BASE_SHA"
}

# Prints added lines; returns3 only for confirmed absence at a valid commit.
# Unknown commits, unavailable objects and read/sort errors return4.
added_scan() {
    ascan_root=$1; abase=$2
    abase_commit=$(git -C "$ascan_root" rev-parse --verify "$abase^{commit}" 2>/dev/null) || return 4
    abase_entry=$(git -C "$ascan_root" ls-tree "$abase_commit" -- "$BASELINE_REL" 2>/dev/null) || return 4
    [ -n "$abase_entry" ] || return 3
    case $abase_entry in *' blob '*) ;; *) return 4 ;; esac
    tmp_base=$(mktemp) || return 4
    if ! git -C "$ascan_root" show "$abase_commit:$BASELINE_REL" > "$tmp_base" 2>/dev/null; then
        rm -f "$tmp_base"; return 4
    fi
    if ! LC_ALL=C sort -u "$tmp_base" > "$tmp_base.s" ||
       ! LC_ALL=C sort -u "$ascan_root/$BASELINE_REL" > "$tmp_base.c"; then
        rm -f "$tmp_base" "$tmp_base.s" "$tmp_base.c"; return 4
    fi
    LC_ALL=C comm -13 "$tmp_base.s" "$tmp_base.c"; added_status=$?
    rm -f "$tmp_base" "$tmp_base.s" "$tmp_base.c"
    [ "$added_status" -eq 0 ] || return 4
    return 0
}

scan() {
    sroot=$1; sbase=$2
    file="$sroot/$BASELINE_REL"
    [ -f "$file" ] || { echo "ERROR - nothing was checked (missing $file)"; return 2; }
    total=$(wc -l < "$file" | tr -d ' ')
    [ "$total" -gt 0 ] || { echo "ERROR - nothing was checked (empty baseline)"; return 2; }
    stale=$(stale_scan "$sroot")
    stale_status=$?
    [ "$stale_status" -eq 0 ] || { echo "ERROR - nothing was checked (source scan failed)"; return 2; }
    if [ -n "$stale" ]; then
        k=$(printf '%s\n' "$stale" | wc -l | tr -d ' ')
        first=$(printf '%s\n' "$stale" | head -5 | tr '\n' ' ')
        echo "FAIL - $total checked, $k stale: $first"
        return 1
    fi
    if [ -z "$sbase" ]; then
        sbase=$(git -C "$sroot" merge-base HEAD origin/release/1.0.0 2>/dev/null || true)
    fi
    if [ -z "$sbase" ]; then
        echo "ERROR - nothing was checked (no --base given and no merge-base with origin/release/1.0.0)"
        return 2
    fi
    added=$(added_scan "$sroot" "$sbase"); arc=$?
    case $arc in
        3) echo "PASS - $total baseline entries checked, 0 stale; ratchet skipped (base $sbase has no baseline: introducing change)"; return 0 ;;
        0) ;;
        *) echo "ERROR - nothing was checked (ratchet scan failed)"; return 2 ;;
    esac
    if [ -n "$added" ]; then
        k=$(printf '%s\n' "$added" | wc -l | tr -d ' ')
        first=$(printf '%s\n' "$added" | head -5 | tr '\n' ' ')
        echo "FAIL - baseline gained $k line(s) vs $sbase (removals only): $first"
        return 1
    fi
    echo "PASS - $total baseline entries checked, 0 stale, 0 added vs $sbase"
    return 0
}

selftest() {
    d=$(mktemp -d) || { echo "ERROR - nothing was checked (mktemp)"; return 2; }
    trap 'rm -rf "$d"' EXIT INT TERM HUP
    mkdir -p "$d/scripts/check" "$d/lib"
    printf 'fn live() -> i64:\n    1\npub fn promoted() -> i64:\n    2\nfn exported() -> i64:\n    3\nexport exported\nfn other() -> i64:\n    4\n' > "$d/lib/m.spl"
    (cd "$d" && git init -q && git config core.autocrlf false && git config user.email t@t && git config user.name t \
        && printf 'lib/m.spl|live\nlib/m.spl|other\n' > "$BASELINE_REL" && git add -A && git commit -qm base) \
        || { echo "ERROR - selftest: git fixture failed"; return 2; }
    b=$(git -C "$d" rev-parse HEAD)
    out=$(scan "$d" "$b" | tail -1); case $out in PASS*) ;; *) echo "ERROR - selftest: live entries must PASS ($out)"; return 2 ;; esac
    printf 'lib/m.spl|live\n' > "$d/$BASELINE_REL"
    out=$(scan "$d" "$b" | tail -1); case $out in PASS*) ;; *) echo "ERROR - selftest: a removal must PASS ($out)"; return 2 ;; esac
    printf 'lib/m.spl|live\nlib/m.spl|other\nlib/m.spl|promoted\n' > "$d/$BASELINE_REL"
    out=$(scan "$d" "$b" | tail -1); case $out in FAIL*promoted*) ;; *) echo "ERROR - selftest: pub entry must be stale ($out)"; return 2 ;; esac
    printf 'lib/m.spl|live\nlib/m.spl|other\nlib/m.spl|exported\n' > "$d/$BASELINE_REL"
    out=$(scan "$d" "$b" | tail -1); case $out in FAIL*) ;; *) echo "ERROR - selftest: exported entry must be stale ($out)"; return 2 ;; esac
    printf 'fn extra() -> i64:\n    5\n' >> "$d/lib/m.spl"
    printf 'lib/m.spl|live\nlib/m.spl|other\nlib/m.spl|extra\n' > "$d/$BASELINE_REL"
    out=$(scan "$d" "$b" | tail -1); case $out in FAIL*gained*extra*) ;; *) echo "ERROR - selftest: an added line must FAIL the ratchet ($out)"; return 2 ;; esac
    printf 'lib/gone.spl|live\n' > "$d/$BASELINE_REL"
    out=$(scan "$d" "$b" | tail -1); case $out in FAIL*) ;; *) echo "ERROR - selftest: missing file must be stale ($out)"; return 2 ;; esac
    # Real cone-mode sparse checkout must not manufacture stale rows, while
    # a committed public promotion still fails even when its file is pruned.
    printf 'lib/m.spl|live\nlib/m.spl|other\n' > "$d/$BASELINE_REL"
    git -C "$d" checkout -- lib/m.spl || return 2
    git -C "$d" sparse-checkout init --cone || return 2
    git -C "$d" sparse-checkout set scripts/check || return 2
    [ ! -e "$d/lib/m.spl" ] || { echo "ERROR - selftest: source was not pruned"; return 2; }
    out=$(scan "$d" "$b" | tail -1); case $out in PASS*) ;; *) echo "ERROR - selftest: indexed sparse source must PASS ($out)"; return 2 ;; esac
    git -C "$d" sparse-checkout set scripts/check lib || return 2
    printf 'pub fn live() -> i64:\n    1\nfn other() -> i64:\n    4\n' > "$d/lib/m.spl"
    git -C "$d" add lib/m.spl && git -C "$d" commit -qm promote || return 2
    git -C "$d" sparse-checkout set scripts/check || return 2
    out=$(scan "$d" "$b" | tail -1); case $out in FAIL*live*) ;; *) echo "ERROR - selftest: sparse promoted source must be stale ($out)"; return 2 ;; esac
    : > "$d/$BASELINE_REL"
    scan "$d" "$b" >/dev/null; [ $? -eq 2 ] || { echo "ERROR - selftest: empty baseline must ERROR"; return 2; }
    sparse_extra_controls || return 2
    base_provenance_controls || return 2
    return 0
}


# Additional first-run controls may be sourced and run independently; the
# original unchanged green controls need not be replayed during diagnosis.
sparse_extra_controls() (
    extra_tmp=$(cd "${TMPDIR:-/tmp}" && pwd -P) || return 2
    extra_dir=$(mktemp -d "$extra_tmp/private-import-new.XXXXXX") || return 2
    case $extra_dir in "$extra_tmp"/private-import-new.*) ;; *) return 2 ;; esac
    trap 'rm -rf "$extra_dir"' EXIT INT TERM HUP
    mkdir -p "$extra_dir/scripts/check" "$extra_dir/lib"
    printf 'fn live() -> i64:\n    1\n' > "$extra_dir/lib/m.spl"
    printf 'lib/m.spl|live\n' > "$extra_dir/$BASELINE_REL"
    (cd "$extra_dir" && git init -q && git config core.autocrlf false && git config user.email t@t && git config user.name t && git add -A && git commit -qm base) || return 2
    extra_base=$(git -C "$extra_dir" rev-parse HEAD) || return 2
    extra_expect_scan() {
        extra_expected_status=$1; extra_marker=$2
        extra_output=$(scan "$extra_dir" "$extra_base" 2>&1); extra_status=$?
        [ "$extra_status" -eq "$extra_expected_status" ] || { echo "ERROR - new control: expected $extra_expected_status, got $extra_status ($extra_output)"; return 2; }
        case $extra_output in *"$extra_marker"*) ;; *) echo "ERROR - new control: missing marker $extra_marker ($extra_output)"; return 2 ;; esac
    }
    git -C "$extra_dir" sparse-checkout init --cone && git -C "$extra_dir" sparse-checkout set scripts/check || return 2
    # Indexed-but-uncommitted public promotion must beat HEAD's private fn.
    extra_blob=$(printf 'pub fn live() -> i64:\n    1\n' | git -C "$extra_dir" hash-object -w --stdin) || return 2
    git -C "$extra_dir" update-index --cacheinfo "100644,$extra_blob,lib/m.spl" || return 2
    git -C "$extra_dir" update-index --skip-worktree lib/m.spl || return 2
    extra_expect_scan 1 'lib/m.spl|live' || return 2
    # Real Git index read failure, not a success-shaped mocked subprocess.
    cp "$extra_dir/.git/index" "$extra_dir/index.good" || return 2
    printf 'not an index\n' > "$extra_dir/.git/index"
    extra_expect_scan 2 'source scan failed' || return 2
    cp "$extra_dir/index.good" "$extra_dir/.git/index" || return 2
    git -C "$extra_dir" sparse-checkout disable || return 2
    git -C "$extra_dir" checkout HEAD -- lib/m.spl || return 2
    # A real tracked deletion in a full checkout cannot use indexed fallback.
    rm "$extra_dir/lib/m.spl" || return 2
    extra_expect_scan 1 'lib/m.spl|live' || return 2
    # A directory in place of source causes Python read failure, exit2.
    mkdir "$extra_dir/lib/m.spl" || return 2
    extra_expect_scan 2 'source scan failed' || return 2
    rmdir "$extra_dir/lib/m.spl" || return 2
    # U+2028 is data inside a physical source record, not a second fn line.
    printf '# comment\342\200\250fn live() -> i64:\n    1\n' > "$extra_dir/lib/m.spl"
    extra_expect_scan 1 'lib/m.spl|live' || return 2
    printf 'fn live() -> i64:\n    1\n' > "$extra_dir/lib/m.spl"
    printf 'lib/m.spl|live\342\200\250other\n' > "$extra_dir/$BASELINE_REL"
    extra_unicode_expected=$(printf 'lib/m.spl|live\342\200\250other')
    extra_unicode_actual=$(stale_scan "$extra_dir"); extra_status=$?
    [ "$extra_status" -eq 0 ] && [ "$extra_unicode_actual" = "$extra_unicode_expected" ] || { echo 'ERROR - new control: U+2028 split a baseline record'; return 2; }
    echo 'PASS - six new sparse/index/read/newline controls'
)


# First-run changed-base criteria, independently callable without replaying
# the original private/export and sparse-source controls.
shallow_base_control() {
    shallow_fixture=$1; shallow_event_base=$2
    git -c core.autocrlf=false clone -q --no-local --depth=2 "$shallow_fixture" "$shallow_fixture/shallow" || return 2
    [ "$(git -C "$shallow_fixture/shallow" rev-parse --is-shallow-repository)" = true ] || return 2
    git -C "$shallow_fixture/shallow" rev-parse --verify refs/remotes/origin/release/1.0.0 >/dev/null 2>&1 && return 2
    shallow_selected=$(BASE_SHA=$shallow_event_base resolve_scan_base "$shallow_fixture/shallow" '') || return 2
    [ "$shallow_selected" = "$shallow_event_base" ] || return 2
    shallow_output=$(scan "$shallow_fixture/shallow" "$shallow_selected" 2>&1); shallow_status=$?
    [ "$shallow_status" -eq 1 ] || return 2
    case $shallow_output in *gained*extra*) ;; *) return 2 ;; esac
}

base_provenance_controls() (
    base_tmp=$(cd "${TMPDIR:-/tmp}" && pwd -P) || return 2
    base_dir=$(mktemp -d "$base_tmp/private-import-base.XXXXXX") || return 2
    case $base_dir in "$base_tmp"/private-import-base.*) ;; *) return 2 ;; esac
    trap 'rm -rf "$base_dir"' EXIT INT TERM HUP
    mkdir -p "$base_dir/scripts/check" "$base_dir/lib"
    (cd "$base_dir" && git init -q && git config core.autocrlf false && git config user.email t@t && git config user.name t && printf 'fixture\n' > README && git add README && git commit -qm before-baseline) || return 2
    before_baseline=$(git -C "$base_dir" rev-parse HEAD) || return 2
    printf 'fn live() -> i64:\n    1\n' > "$base_dir/lib/m.spl"
    printf 'lib/m.spl|live\n' > "$base_dir/$BASELINE_REL"
    git -C "$base_dir" add -A && git -C "$base_dir" commit -qm base || return 2
    event_base=$(git -C "$base_dir" rev-parse HEAD) || return 2
    printf 'fn extra() -> i64:\n    2\n' >> "$base_dir/lib/m.spl"
    printf 'lib/m.spl|extra\n' >> "$base_dir/$BASELINE_REL"
    git -C "$base_dir" add -A && git -C "$base_dir" commit -qm head || return 2
    event_head=$(git -C "$base_dir" rev-parse HEAD) || return 2
    shallow_base_control "$base_dir" "$event_base" || return 2
    git -C "$base_dir" rev-parse --verify refs/remotes/origin/release/1.0.0 >/dev/null 2>&1 && return 2
    BASE_SHA=$event_base; export BASE_SHA
    selected=$(resolve_scan_base "$base_dir" '') || return 2
    [ "$selected" = "$event_base" ] || return 2
    output=$(scan "$base_dir" "$selected" 2>&1); status=$?
    [ "$status" -eq 1 ] || { echo "ERROR - event base must detect gained entry ($output)"; return 2; }
    case $output in *gained*extra*) ;; *) return 2 ;; esac
    # Explicit CLI precedence is intentional; no implicit HEAD fallback exists.
    BASE_SHA=HEAD
    selected=$(resolve_scan_base "$base_dir" "$event_head") || return 2
    [ "$selected" = "$event_head" ] || return 2
    selected=$(resolve_scan_base "$base_dir" '' 2>/dev/null); status=$?
    [ "$status" -eq 2 ] || return 2
    BASE_SHA=ffffffffffffffffffffffffffffffffffffffff
    selected=$(resolve_scan_base "$base_dir" '' 2>/dev/null); status=$?
    [ "$status" -eq 2 ] || return 2
    added_scan "$base_dir" "$BASE_SHA" >/dev/null; status=$?
    [ "$status" -eq 4 ] || return 2
    # Only a real old commit with no baseline may use introducing-change skip.
    added_scan "$base_dir" "$before_baseline" >/dev/null; status=$?
    [ "$status" -eq 3 ] || return 2
    # Valid commit + baseline entry + unreadable blob is ERROR, never absence.
    GIT_INDEX_FILE="$base_dir/broken.index" git -C "$base_dir" read-tree "$event_base" || return 2
    GIT_INDEX_FILE="$base_dir/broken.index" git -C "$base_dir" update-index --cacheinfo "100644,1111111111111111111111111111111111111111,$BASELINE_REL" || return 2
    broken_tree=$(GIT_INDEX_FILE="$base_dir/broken.index" git -C "$base_dir" write-tree --missing-ok) || return 2
    broken_commit=$(printf 'missing baseline blob\n' | git -C "$base_dir" commit-tree "$broken_tree" -p "$event_base") || return 2
    added_scan "$base_dir" "$broken_commit" >/dev/null; status=$?
    [ "$status" -eq 4 ] || return 2
    unset BASE_SHA
    selected=$(resolve_scan_base "$base_dir" '') || return 2
    [ -z "$selected" ] || return 2
    output=$(scan "$base_dir" "$selected" 2>&1); status=$?
    [ "$status" -eq 2 ] || return 2
    echo 'PASS - changed base provenance controls (real no-origin Git fixture)'
)

main_root=.
main_base=
mode=scan
while [ $# -gt 0 ]; do
    case $1 in
        --root) main_root=$2; shift ;;
        --base) main_base=$2; shift ;;
        --selftest) mode=selftest ;;
        *) echo "ERROR - nothing was checked (unknown arg $1)"; exit 2 ;;
    esac
    shift
done
if [ "$mode" = scan ]; then
    selected_base=$(resolve_scan_base "$main_root" "$main_base"); resolve_status=$?
    [ "$resolve_status" -eq 0 ] || { echo "ERROR - nothing was checked (base provenance failed)"; exit 2; }
    main_base=$selected_base
fi
( selftest ) || exit 2
[ "$mode" = selftest ] && { echo "PASS - selftest fixtures ok"; exit 0; }
scan "$main_root" "$main_base"
