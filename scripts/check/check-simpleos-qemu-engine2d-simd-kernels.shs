#!/bin/sh
# Static prerequisite gate only. Guest hit/chunk receipts and QMP captures are
# still mandatory before a SimpleOS backend can be marked verified.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
common_owner="$repo_root/src/lib/nogc_async_mut_noalloc/baremetal/common/engine2d_simd_evidence.spl"
adapter_owner="$repo_root/src/os/compositor/engine2d_simd_evidence.spl"
x86_owner="$repo_root/src/lib/nogc_async_mut_noalloc/baremetal/x86_64/engine2d_simd.spl"
arm_owner="$repo_root/src/lib/nogc_async_mut_noalloc/baremetal/arm64/engine2d_simd.spl"
rvv_owner="$repo_root/src/lib/nogc_async_mut_noalloc/baremetal/riscv64/engine2d_simd.spl"
receipt_owner="$repo_root/src/os/compositor/engine2d_render_evidence.spl"
catalog_owner="$repo_root/src/os/port/_SimpleosMultiplatformBuild/platform_target_catalog.spl"
build_contract_owner="$repo_root/src/os/port/_SimpleosMultiplatformBuild/build_target_contracts.spl"
x86_intrinsics="$repo_root/src/os/kernel/arch/x86_64/engine2d_simd_intrinsics.c"
arm_intrinsics="$repo_root/src/os/kernel/arch/arm64/engine2d_simd_intrinsics.c"
rvv_intrinsics="$repo_root/src/os/kernel/arch/riscv64/engine2d_simd_intrinsics.c"

for owner in "$common_owner" "$adapter_owner" "$x86_owner" "$arm_owner" "$rvv_owner"; do
    test -f "$owner"
done
for owner in "$receipt_owner" "$catalog_owner" "$build_contract_owner" "$x86_intrinsics" "$arm_intrinsics" "$rvv_intrinsics"; do
    test -f "$owner"
done
for operation in fill copy alpha alpha_edge scroll diagram; do
    grep -Fq "ENGINE2D_SIMD_OP_$(printf '%s' "$operation" | tr '[:lower:]' '[:upper:]')" "$common_owner"
    grep -Fq "rt_simpleos_x86_engine2d_simd_${operation}" "$x86_owner"
    grep -Fq "rt_simpleos_neon_engine2d_simd_${operation}" "$arm_owner"
    grep -Fq "rt_simpleos_rvv_engine2d_simd_${operation}" "$rvv_owner"
done
grep -Fq 'engine2d_simd_producer_passes' "$common_owner"
grep -Fq 'ENGINE2D_SIMD_BLOCK_UNSUPPORTED_FEATURE' "$common_owner"
grep -Fq 'riscv64_engine2d_simd_produce' "$adapter_owner"
grep -Fq 'simpleos_engine2d_simd_produce(' "$receipt_owner"
grep -Fq 'engine2d_simd_producer_passes(evidence)' "$receipt_owner"
for source in "$x86_intrinsics" "$arm_intrinsics" "$rvv_intrinsics"; do
    grep -Fq 'engine2d_simd_intrinsic_owner.inc' "$source"
done
grep -Fq 'src/os/kernel/arch/x86_64/engine2d_simd_intrinsics.c' "$catalog_owner"
grep -Fq 'src/os/kernel/arch/arm64/engine2d_simd_intrinsics.c' "$catalog_owner"
grep -Fq 'src/os/kernel/arch/riscv64/engine2d_simd_intrinsics.c' "$catalog_owner"
grep -Fq 'qemu_cpu: "rv64,v=true,vlen=128,elen=64"' "$catalog_owner"
grep -Fq 'flags.push("-march=rv64gc")' "$build_contract_owner"
if grep -Eq 'rvv.*(disabled|placeholder)|scalar.*PASS' "$rvv_owner"; then
    echo "FAIL: RVV owner contains a disabled/placeholder or scalar-PASS path" >&2
    exit 1
fi

if [ "${1:-}" = "--source-contract" ]; then
    echo "simpleos_engine2d_simd_owner_status=local-complete"
    echo "simpleos_engine2d_simd_owner_blocked_reason=external-qemu-execution-framebuffer-parity-and-guest-elf-disassembly-required"
    echo "simpleos_engine2d_simd_owner_sources=common,x86_64,avx2-sse42,aarch64-neon,riscv64-rvv,compositor-adapter"
    exit 0
fi

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/simpleos-qemu-simd.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM

clang --target=x86_64-unknown-none-elf -c -ffreestanding -fno-builtin -fno-pie \
    -mno-red-zone -msse4.2 -O2 -o "$work_dir/x86_64.o" "$x86_intrinsics"
clang --target=aarch64-unknown-none-elf -c -ffreestanding -fno-builtin -fno-pie \
    -O2 -o "$work_dir/arm64.o" "$arm_intrinsics"
clang --target=riscv64-unknown-none-elf -c -ffreestanding -fno-builtin -fno-pie \
    -march=rv64gc -mabi=lp64d -O2 -o "$work_dir/riscv64.o" "$rvv_intrinsics"

OBJDUMP="${LLVM_OBJDUMP:-$(command -v llvm-objdump || command -v objdump)}"
NM="${LLVM_NM:-$(command -v llvm-nm || command -v nm)}"
for arch in x86_64 arm64 riscv64; do
    if [ "$arch" = riscv64 ]; then
        # The object keeps its deployable rv64gc attributes; V is enabled only
        # inside feature-gated assembly, so opt in solely for decoding evidence.
        "$OBJDUMP" --mattr=+v -d "$work_dir/$arch.o" >"$work_dir/$arch.dis"
    else
        "$OBJDUMP" -d "$work_dir/$arch.o" >"$work_dir/$arch.dis"
    fi
    "$NM" "$work_dir/$arch.o" >"$work_dir/$arch.symbols"
    if "$NM" -u "$work_dir/$arch.o" | grep -q .; then
        echo "FAIL: unresolved symbol in $arch intrinsic owner" >&2
        exit 1
    fi
done
for operation in fill copy alpha alpha_edge scroll diagram; do
    grep -Eq " [Tt] rt_simpleos_x86_engine2d_simd_${operation}$" "$work_dir/x86_64.symbols"
    grep -Eq " [Tt] rt_simpleos_neon_engine2d_simd_${operation}$" "$work_dir/arm64.symbols"
    grep -Eq " [Tt] rt_simpleos_rvv_engine2d_simd_${operation}$" "$work_dir/riscv64.symbols"
done
for suffix in owner_linked feature vector_width metric; do
    grep -Eq " [Tt] rt_simpleos_x86_engine2d_simd_${suffix}$" "$work_dir/x86_64.symbols"
    grep -Eq " [Tt] rt_simpleos_neon_engine2d_simd_${suffix}$" "$work_dir/arm64.symbols"
    grep -Eq " [Tt] rt_simpleos_rvv_engine2d_simd_${suffix}$" "$work_dir/riscv64.symbols"
done
grep -Eq 'vmovdqu|movdqu|xmm|ymm' "$work_dir/x86_64.dis"
grep -Eq '[[:space:]](ld1|st1|dup)[[:space:]]' "$work_dir/arm64.dis"
grep -Eq '[[:space:]]v(setvli|le32|se32)' "$work_dir/riscv64.dis"

echo "PASS: local x86_64 AVX2/SSE4.2, AArch64 NEON, and RV64 RVV owners compile with all six operation ABIs"
