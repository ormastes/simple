#!/bin/sh
# check-user-link-no-llvm-members.shs
# A USER-program link line must not carry an archive member with undefined LLVM*
# symbols. Incident 2026-10-11 (Windows-MSVC, stage 2): `native-build hello_world.spl`
# dropped --runtime-bundle on the bootstrap CLI's positional route, the link added
# simple_native_all.lib (the Rust seed aggregate), and lld-link failed with 20
# undefined LLVM* symbols referenced by the seed's own LLVM backend members.
#
#   sh scripts/check/check-user-link-no-llvm-members.shs --link-log <linker output> ...
#   sh scripts/check/check-user-link-no-llvm-members.shs --link-command <file> ...
#   sh scripts/check/check-user-link-no-llvm-members.shs --selftest
#
# --link-log      scans linker output for `undefined symbol: LLVM*` (lld / lld-link wording).
# --link-command  reads a recorded link line (the driver's *.link-command.txt) and runs
#                 `$NM -u` (default llvm-nm) over every .lib/.a/.o/.obj on it that exists.
# Needs real link artifacts, so it is not a push/CI gate (guard_wiring_optout.txt).
# Known limits: a log proves only what the linker reported; link inputs deleted after
# the link cannot be examined, and a run that examined nothing is an ERROR, not a pass.
#
# Verdict, always the last stdout line:
#   PASS — <n> input(s) checked, 0 undefined LLVM* symbol(s)                  exit 0
#   FAIL — <n> input(s) checked, <k> undefined LLVM* symbol(s): <where>       exit 1
#   ERROR — nothing was checked (<reason>)                                    exit 2
set -u
NM=${NM:-llvm-nm}

# scan_log <file> <findings file> ; appends "<symbol> <referencing member or ->"
scan_log() {
  awk '
    /undefined symbol: LLVM[A-Z]/ { if (want) print sym, "-"; sym = $NF; want = 1; next }
    want && /referenced by/ { sub(/.*referenced by /, ""); sub(/:\(.*/, ""); print sym, $0; want = 0; next }
    want && !/^>>>/ { print sym, "-"; want = 0 }
    END { if (want) print sym, "-" }
  ' "$1" >> "$2"
}

# link_inputs <link-command file> ; prints one archive/object path per line
link_inputs() {
  tr ' \t\r' '\n\n\n' < "$1" | sed -e 's/^"//' -e 's/"$//' -e 's#^/WHOLEARCHIVE:##' | grep -E '\.(lib|a|o|obj)$'
}

# run_scan <mode> <files...> ; prints the verdict line ; returns 0/1/2
run_scan() {
  mode=$1; shift
  work=$(mktemp -d "${TMPDIR:-/tmp}/ullvm-scan.XXXXXX") || { echo "ERROR — nothing was checked (mktemp failed)"; return 2; }
  : > "$work/findings"
  checked=0
  for f in "$@"; do
    if [ ! -f "$f" ]; then
      rm -rf "$work"; echo "ERROR — nothing was checked (missing input $f)"; return 2
    fi
    if [ "$mode" = log ]; then
      scan_log "$f" "$work/findings"
      checked=$((checked + 1))
      continue
    fi
    link_inputs "$f" > "$work/inputs"
    while IFS= read -r input; do
      [ -f "$input" ] || continue
      "$NM" -u "$input" > "$work/nm.out" 2>/dev/null
      nm_rc=$?
      if [ $nm_rc -ne 0 ]; then
        rm -rf "$work"; echo "ERROR — nothing was checked ($NM failed on $input)"; return 2
      fi
      checked=$((checked + 1))
      awk -v input="$input" '$NF ~ /^LLVM[A-Z]/ { print $NF, input }' "$work/nm.out" >> "$work/findings"
    done < "$work/inputs"
  done
  if [ "$checked" -eq 0 ]; then
    rm -rf "$work"; echo "ERROR — nothing was checked (no readable link input)"; return 2
  fi
  if [ ! -s "$work/findings" ]; then
    rm -rf "$work"; echo "PASS — $checked input(s) checked, 0 undefined LLVM* symbol(s)"; return 0
  fi
  k=$(awk '{ print $1 }' "$work/findings" | sort -u | wc -l | tr -d ' ')
  where=$(awk '{ $1 = ""; sub(/^ /, ""); print }' "$work/findings" | sort -u | head -5 | tr '\n' ' ')
  rm -rf "$work"
  echo "FAIL — $checked input(s) checked, $k undefined LLVM* symbol(s): $where"
  return 1
}

selftest() {
  t=$(mktemp -d "${TMPDIR:-/tmp}/ullvm-selftest.XXXXXX") || { echo "selftest: mktemp failed"; return 1; }
  bad=0
  {
    echo "lld-link: error: undefined symbol: LLVMBuildAdd"
    echo ">>> referenced by simple_native_all.lib(simple_compiler.cgu.06.rcgu.o):(build_int_add)"
    echo "lld-link: error: undefined symbol: LLVMBuildStore"
    echo ">>> referenced by simple_native_all.lib(simple_compiler.cgu.06.rcgu.o):(build_store)"
  } > "$t/bad.log"
  {
    echo "lld-link: warning: duplicate symbol: rt_alloc"
    echo "lld-link: error: undefined symbol: rt_print_err"
  } > "$t/clean.log"
  v=$(run_scan log "$t/bad.log"); rc=$?
  case "$rc:$v" in
    "1:FAIL — 1 input(s) checked, 2 undefined LLVM* symbol(s): simple_native_all.lib("*) ;;
    *) echo "selftest: incident log must FAIL naming the member: $v"; bad=1 ;;
  esac
  v=$(run_scan log "$t/clean.log"); rc=$?
  [ $rc -eq 0 ] || { echo "selftest: log without LLVM* must PASS: $v"; bad=1; }
  v=$(run_scan log "$t/absent.log"); rc=$?
  [ $rc -eq 2 ] || { echo "selftest: missing log must ERROR: $v"; bad=1; }
  # Fake nm: *native_all* has an undefined LLVM symbol, *broken* fails, others are clean.
  {
    echo "#!/bin/sh"
    echo "case \"\$2\" in"
    echo "  *native_all*) echo '                 U LLVMAddGlobal'; echo '                 U malloc' ;;"
    echo "  *broken*) exit 1 ;;"
    echo "  *) echo '                 U malloc' ;;"
    echo "esac"
  } > "$t/nm"
  chmod +x "$t/nm"
  : > "$t/user.o"; : > "$t/simple_native_all.lib"; : > "$t/broken.a"
  echo "lld-link.exe /OUT:x.exe $t/user.o $t/simple_native_all.lib kernel32.lib" > "$t/bad.cmd"
  echo "lld-link.exe /OUT:x.exe $t/user.o kernel32.lib" > "$t/clean.cmd"
  echo "lld-link.exe /OUT:x.exe kernel32.lib $t/gone.obj" > "$t/empty.cmd"
  echo "ld.lld -o x $t/broken.a" > "$t/broken.cmd"
  v=$(NM="$t/nm" run_scan command "$t/bad.cmd"); rc=$?
  case "$rc:$v" in
    "1:FAIL — 2 input(s) checked, 1 undefined LLVM* symbol(s): "*simple_native_all.lib*) ;;
    *) echo "selftest: link line with an LLVM-needing archive must FAIL: $v"; bad=1 ;;
  esac
  v=$(NM="$t/nm" run_scan command "$t/clean.cmd"); rc=$?
  case "$rc:$v" in
    "0:PASS — 1 input(s) checked, 0 undefined LLVM* symbol(s)") ;;
    *) echo "selftest: clean link line must PASS over 1 input: $v"; bad=1 ;;
  esac
  v=$(NM="$t/nm" run_scan command "$t/empty.cmd"); rc=$?
  [ $rc -eq 2 ] || { echo "selftest: link line with no existing input must ERROR: $v"; bad=1; }
  v=$(NM="$t/nm" run_scan command "$t/broken.cmd"); rc=$?
  [ $rc -eq 2 ] || { echo "selftest: failing nm must ERROR, never pass: $v"; bad=1; }
  rm -rf "$t"
  return $bad
}

mode=""
case "${1:-}" in
  --selftest)
    selftest
    rc=$?
    if [ $rc -eq 0 ]; then echo "PASS — 7 selftest fixture(s) behaved"; else echo "FAIL — selftest"; fi
    exit $rc ;;
  --link-log) mode=log; shift ;;
  --link-command) mode=command; shift ;;
esac
selftest
st_rc=$?
if [ $st_rc -ne 0 ]; then
  echo "ERROR — nothing was checked (selftest failed)"; exit 2
fi
if [ -z "$mode" ] || [ $# -eq 0 ]; then
  echo "ERROR — nothing was checked (usage: --link-log <file>... | --link-command <file>... | --selftest)"; exit 2
fi
run_scan "$mode" "$@"
rc=$?
exit $rc
