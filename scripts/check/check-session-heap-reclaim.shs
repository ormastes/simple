#!/bin/sh
# Link the real C owner or an explicit Rust runtime archive; no mocked owner.
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
out_dir=${SIMPLE_SESSION_RECLAIM_CHECK_OUT:-"$repo_root/build/native_probe/session-heap-reclaim"}
cc_bin=${CC:-cc}
runtime_input="$repo_root/src/runtime/runtime_native.c"
fixture="$repo_root/test/01_unit/runtime/session_heap_reclaim_test.c"
if [ "${1:-}" = --module-runtime-archive ]; then
    [ "$#" -eq 2 ] && [ -f "$2" ] || { echo "error: --module-runtime-archive requires an existing Rust archive" >&2; exit 2; }
    runtime_input=$2
    fixture="$repo_root/test/01_unit/runtime/module_scope_reclaim_test.c"
elif [ "${1:-}" = --runtime-archive ]; then
    [ "$#" -eq 2 ] && [ -f "$2" ] || { echo "error: --runtime-archive requires an existing archive" >&2; exit 2; }
    runtime_input=$2
elif [ "$#" -ne 0 ]; then
    echo "usage: $0 [--runtime-archive PATH | --module-runtime-archive PATH]" >&2
    exit 2
fi
mkdir -p "$out_dir"
case $(uname -s) in
    Darwin) link_flags='-Wl,-dead_strip' ;;
    *) link_flags='-Wl,--gc-sections' ;;
esac
# Wrapping checks the selected fixture's successful reclamation boundaries.
if printf '#include <stdlib.h>\n#ifdef __GLIBC__\nglibc\n#endif\n' | "$cc_bin" -E - | grep -q '^glibc$'; then
    link_flags="$link_flags -Wl,--wrap=malloc_trim"
fi
"$cc_bin" -std=c11 -O1 -g -pthread -D_GNU_SOURCE \
    -ffunction-sections -fdata-sections -I"$repo_root/src/runtime" \
    "$fixture" \
    "$runtime_input" \
    $link_flags -ldl -lm -o "$out_dir/session_heap_reclaim_test" \
    >"$out_dir/compile.log" 2>&1
"$out_dir/session_heap_reclaim_test" >"$out_dir/run.log" 2>&1
cat "$out_dir/run.log"
