#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
source_file=${1:-"$root/src/compiler/00.common/dynamic_identity/kpf_closure.spl"}
spec="$root/test/01_unit/compiler/dynamic_identity/kpf_closure_spec.spl"

require_line() {
    grep -Fq "$1" "$source_file" || {
        echo "missing KPF sealer contract: $1" >&2
        exit 1
    }
}

require_line 'if not provides(claim.provided_operations, claim.required_operations[i]):'
require_line 'return Err(KpfClosureError.RequiredOperationMissing(canonical, claim.required_operations[i]))'
require_line 'case Closure.Dyn:'
require_line 'if critical:'
require_line 'return Err(KpfClosureError.DynRejectedInCritical(claim.identity.canonical_text()))'

grep -Fq 'to_equal("KPF-OPERATION-MISSING")' "$spec"
grep -Fq 'to_equal("KPF-DYN-CRITICAL")' "$spec"

echo "PASS KPF extended-enum sealer source contract"
