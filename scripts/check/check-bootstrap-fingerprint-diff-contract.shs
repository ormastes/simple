#!/bin/sh
# Focused contract for bounded fingerprint sidecars and aggregate diagnosis.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
. "$root/scripts/check/lib/bootstrap-stage3/authority.shs"
cd "$root"
fixture=$(mktemp -d "${TMPDIR:-/tmp}/simple-fingerprint-diff-test.XXXXXX")
trap 'chmod -R u+w "$fixture" 2>/dev/null || true; rm -rf "$fixture"' EXIT HUP INT TERM
records="$fixture/baseline.records"
current_records="$fixture/current.records"
details="$fixture/stamp.details.env"
current_details="$fixture/current.details.env"
stamp="$fixture/simple.exe.inputs.sha256"
scratch="$fixture/scratch"
mkdir -p "$scratch"
printf '%s\n' \
  'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa  src/compiler_rust/a.rs' \
  'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  src/runtime/a.c' \
  'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc  src/lib/path_dep.rs' \
  'dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd  src/compiler_rust/Cargo.lock' \
  'profile=bootstrap backend=cranelift features=none target=x86_64-pc-windows-gnu' \
  'rust-sysroot=/fixture/rust' \
  'cc-path=/fixture/gcc' \
  'recipe.1=fixture' >"$records"
cp "$records" "$current_records"
bootstrap_stage3_write_seed_fingerprint_details "$details" "$records" "$scratch"
aggregate=$(sed -n 's/^aggregate_sha256=//p' "$details")
[ "$(wc -l <"$details" | tr -d ' ')" = 19 ]
[ "$(wc -c <"$details" | tr -d ' ')" -lt 4096 ]
if grep -Eq 'src/|/fixture/|recipe\.1=fixture' "$details"; then
  echo 'FAIL: bounded sidecar retained raw fingerprint inputs' >&2
  exit 1
fi
details_sha=$(sha256sum "$details" | awk '{print $1}')
printf 'schema=simple-bootstrap-seed-artifact-stamp-v2\ninputs_fingerprint=%s\nfingerprint_details_file=%s\nfingerprint_details_sha256=%s\n' \
  "$aggregate" "$(basename "$details")" "$details_sha" >"$stamp"
[ "$(sed -n 's/^category_count=//p' "$details")" = 8 ]
[ "$(sed -n 's/^category_compiler_sources_count=//p' "$details")" = 1 ]
[ "$(sed -n 's/^category_runtime_sources_count=//p' "$details")" = 1 ]
[ "$(sed -n 's/^category_cargo_path_dependencies_count=//p' "$details")" = 1 ]
[ "$(sed -n 's/^category_policy_count=//p' "$details")" = 2 ]
[ "$(sed -n 's/^category_toolchain_count=//p' "$details")" = 1 ]
[ "$(sed -n 's/^category_native_tools_count=//p' "$details")" = 1 ]
[ "$(sed -n 's/^category_recipes_count=//p' "$details")" = 1 ]
[ "$(sed -n 's/^category_unclassified_count=//p' "$details")" = 0 ]
sed 's/^aaaaaaaa/eeeeeeee/' "$current_records" >"$current_records.tmp"
mv "$current_records.tmp" "$current_records"
bootstrap_stage3_write_seed_fingerprint_details "$current_details" "$current_records" "$scratch"
receipt="$fixture/diff.receipt.env"
if sh scripts/check/bootstrap-fingerprint-diff.shs \
  --published-stamp="$stamp" --published-details="$details" \
  --current-details="$current_details" --output="$receipt"; then
  echo 'FAIL: changed compiler category was admitted as equal' >&2
  exit 1
else
  [ "$?" -eq 1 ]
fi
grep -Fx 'changed_category=compiler_sources' "$receipt"
grep -Fx 'changed_category_count=1' "$receipt"
grep -Fx 'aggregate_status=different' "$receipt"

# A legacy stamp has no cryptographic binding to any adjacent or
# caller-supplied category sidecar.  Even a plausible file must remain BLOCKED.
legacy_stamp="$fixture/legacy.inputs.sha256"
printf 'schema=simple-bootstrap-seed-artifact-stamp-v2\ninputs_fingerprint=%s\n' \
  "$aggregate" >"$legacy_stamp"
legacy_receipt="$fixture/legacy.receipt.env"
status=0
sh scripts/check/bootstrap-fingerprint-diff.shs \
  --published-stamp="$legacy_stamp" --published-details="$details" \
  --current-details="$current_details" --output="$legacy_receipt" || status=$?
[ "$status" -eq 2 ]
grep -Fx 'published_details_status=missing-or-invalid' "$legacy_receipt"
grep -Fx 'aggregate_status=unavailable' "$legacy_receipt"
grep -Fx 'status=BLOCKED' "$legacy_receipt"
echo 'bootstrap fingerprint diff: PASS'
