#!/bin/sh
set -eu
repo=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
. "$repo/scripts/bootstrap/bootstrap-phase-toolchain.shs"
for version in 'clang version 23.1.1' 'clang version 23.1.2 (installed)' 'clang version 23.1.10'; do
    bootstrap_phase_windows_llvm_version_valid "$version" || {
        echo "FAIL: rejected supported Windows LLVM patch: $version" >&2
        exit 1
    }
done
for version in 'clang version 23.2.0' 'clang version 22.1.2' 'clang version 23.1.' 'clang version 23.1.2garbage' 'Microsoft C/C++ 19.44' 'prefix clang version 23.1.2'; do
    if bootstrap_phase_windows_llvm_version_valid "$version"; then
        echo "FAIL: accepted unsupported compiler identity: $version" >&2
        exit 1
    fi
done
echo 'PASS: Windows LLVM patch-family predicate (3 accepted, 6 rejected)'
