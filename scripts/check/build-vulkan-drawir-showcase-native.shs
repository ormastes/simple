#!/bin/sh
# Bounded production-native build gate for the Vulkan DrawIR showcase.
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
SIMPLE_BIN=${1:-"$ROOT_DIR/bin/simple"}
OUTPUT=${2:-"$ROOT_DIR/build/vulkan_drawir_no_readback/simple_showcase_vulkan"}
CACHE_DIR=${3:-"$ROOT_DIR/build/vulkan_drawir_no_readback/cache"}
BUDGET_SECONDS=${SIMPLE_VULKAN_DRAWIR_BUILD_BUDGET_SECONDS:-180}
OUTPUT_DIR=$(dirname -- "$OUTPUT")
LOG="$OUTPUT_DIR/native-build.log"
PHASE_LOG="$OUTPUT_DIR/native-build.phase.log"
PROGRESS_LOG="$OUTPUT_DIR/native-build.progress.events"

mkdir -p "$OUTPUT_DIR" "$CACHE_DIR"

case "$BUDGET_SECONDS" in
    ''|*[!0-9]*) echo "FAIL: SIMPLE_VULKAN_DRAWIR_BUILD_BUDGET_SECONDS must be a positive integer" >&2; exit 2 ;;
esac
if [ "$BUDGET_SECONDS" -le 0 ]; then
    echo "FAIL: SIMPLE_VULKAN_DRAWIR_BUILD_BUDGET_SECONDS must be positive" >&2
    exit 2
fi
if [ ! -x "$SIMPLE_BIN" ]; then
    echo "FAIL: Simple compiler is not executable: $SIMPLE_BIN" >&2
    exit 2
fi

. "$ROOT_DIR/scripts/lib/simple-compiler-select.shs"

# Prove real environment-writing compiler work and reject a bootstrap seed
# before creating the expensive build worker.
if ! simple_compiler_usable "$SIMPLE_BIN"; then
    echo "BLOCKED: Vulkan DrawIR native deployment requires a usable pure-Simple self-hosted compiler: $SIMPLE_BIN" >&2
    echo "See doc/08_tracking/bug/vulkan_drawir_showcase_native_build_exceeds_10m_2026-08-11.md" >&2
    exit 6
fi

# --timeout is owned by the native-build worker. Phase/progress files survive
# a bounded failure and identify the active stage on a usable deployment.
set +e
env -u SIMPLE_BOOTSTRAP -u SIMPLE_RUNTIME_PATH \
    SIMPLE_LIB="$ROOT_DIR/src" SIMPLE_NO_STUB_FALLBACK=1 \
    SIMPLE_COMPILER_PHASE_PROFILE=1 SIMPLE_COMPILER_PHASE_PROFILE_FILE="$PHASE_LOG" \
    SIMPLE_BUILD_PROGRESS_EVENTS="$PROGRESS_LOG" \
    SIMPLE_NATIVE_BUILD_TRACE_CLOSURE=1 SIMPLE_NATIVE_BUILD_TRACE_CLOSURE_TIMING=1 \
    "$SIMPLE_BIN" native-build --backend llvm \
    --source "$ROOT_DIR/src/compiler" --source "$ROOT_DIR/src/app" --source "$ROOT_DIR/src/lib" \
    --entry-closure --cache-dir "$CACHE_DIR" \
    --entry "$ROOT_DIR/src/app/ui_showcase/hosts/main_2d_vulkan.spl" \
    --strip --timeout "$BUDGET_SECONDS" --output "$OUTPUT" >"$LOG" 2>&1
BUILD_STATUS=$?
set -e

sed -n '1,200p' "$LOG"
if [ -f "$PHASE_LOG" ]; then
    echo "--- compiler phase receipt ---"
    tail -n 80 "$PHASE_LOG"
fi
if [ -f "$PROGRESS_LOG" ]; then
    echo "--- compiler progress receipt ---"
    tail -n 80 "$PROGRESS_LOG"
fi
if [ "$BUILD_STATUS" -ne 0 ]; then
    echo "FAIL: bounded Vulkan DrawIR native-build exited $BUILD_STATUS (budget=${BUDGET_SECONDS}s)" >&2
    exit "$BUILD_STATUS"
fi
if [ ! -x "$OUTPUT" ]; then
    echo "FAIL: native-build reported success without an executable: $OUTPUT" >&2
    exit 3
fi
if grep -q 'stub functions for unresolved symbols' "$LOG"; then
    echo "FAIL: Vulkan DrawIR deployment fabricated unresolved-symbol stubs" >&2
    exit 4
fi

echo "PASS: bounded Vulkan DrawIR native artifact: $OUTPUT"
