#!/bin/sh
# check-import-alias-aot.shs
#
# AOT-lane sibling of `check-import-alias-codegen.shs`.
#
# DEFECT (measured 2026-08-10): `use m.{f as g}` did not resolve in the AOT
# `compile --native` lane for ANY placement of the alias -- not just the
# `main`-collision case fixed in dcdd50a772c. Two independent causes, one per
# placement:
#
#   entry_alias -- the alias is used in the ENTRY module. The entry's own `use`
#     survives flattening, so HIR lowering registered a PHANTOM callable+global
#     under the ALIAS name, and those branches outranked the alias map in
#     `lower_identifier`. Result: `error: codegen: undefined symbol: g`.
#     (This shape is broken under the JIT lane too -- see the sibling script.)
#
#   mid_alias -- the alias is used in an IMPORTED module. That module's `use`
#     does NOT survive flattening; only a marker const does, and the TYPE
#     CHECKER bound nothing for it. Result: `error: semantic: Undefined
#     ("undefined identifier: g")`, raised before HIR lowering ever ran. The
#     JIT lane does not gate on that check, which is why the sibling script --
#     whose alias lives in a mid module -- stayed green throughout.
#
# This check is deliberately RESOLUTION-based, not compilation-based: each probe
# RUNS the linked binary and requires the exact value only the correct function
# can produce. "It compiled" has twice been mistaken for "it is correct" in this
# campaign; a probe that stops at exit 0 would have passed against a binary that
# silently called the wrong function.
#
# Verdict line is the LAST line of stdout:
#   PASS -- <n> form(s) checked, all resolve in the AOT lane
#   FAIL -- <form> does not resolve in the AOT lane
#   ERROR -- nothing was checked
#
# Negative control (proves the check is live): pass --expect-fail. Both alias
# forms MUST fail. Run it against a pre-fix binary; if it reports a pass there,
# the check is not measuring the AOT lane.

set -u

SIMPLE_BIN="${SIMPLE_BIN:-bin/simple}"
[ -x "$SIMPLE_BIN" ] || SIMPLE_BIN="$(command -v simple 2>/dev/null || echo bin/simple)"
case "$SIMPLE_BIN" in
    /*) ;;
    *)  SIMPLE_BIN="$(pwd)/$SIMPLE_BIN" ;;
esac
if [ ! -x "$SIMPLE_BIN" ]; then
    echo "ERROR -- nothing was checked (SIMPLE_BIN not executable: $SIMPLE_BIN)"
    exit 2
fi

EXPECT_FAIL=0
[ "${1:-}" = "--expect-fail" ] && EXPECT_FAIL=1

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

CHECKED=0
BAD=""

# $1 = form name, $2 = entry.spl body, $3 = optional mid.spl body
probe() {
    name="$1"; entry="$2"; mid="${3:-}"
    d="$WORK/$name"
    mkdir -p "$d"
    printf 'pub fn base_get(k: text) -> text:\n    return "V:" + k\n' > "$d/target.spl"
    [ -n "$mid" ] && printf '%s' "$mid" > "$d/mid.spl"
    printf '%s' "$entry" > "$d/entry.spl"

    build="$( cd "$d" && timeout 600 "$SIMPLE_BIN" compile entry.spl --native -o prog 2>&1 )"
    CHECKED=$((CHECKED + 1))

    if [ ! -x "$d/prog" ]; then
        reason="$(printf '%s' "$build" | grep -iE 'undefined symbol|undefined identifier|error' | head -1)"
        echo "  BROKEN $name -- ${reason:-<no diagnostic>}"
        BAD="$BAD $name"
        return 1
    fi
    # Resolution, not compilation: the binary must RUN and print the value that
    # only `base_get` produces.
    out="$( cd "$d" && timeout 120 ./prog 2>&1 )"
    if printf '%s' "$out" | grep -q '^V:x'; then
        echo "  ok    $name"
        return 0
    fi
    echo "  BROKEN $name -- linked but produced '$(printf '%s' "$out" | head -1)' instead of V:x"
    BAD="$BAD $name"
    return 1
}

echo "selective-import alias x AOT lane resolution check (compile --native)"
echo "binary: $SIMPLE_BIN"

# CONTROL: a plain selective import. Resolves both before and after the fix.
probe plain_entry \
'use target.{base_get}

fn main():
    print(base_get("x"))
'

# CONTROL: plain selective import used from an imported module.
probe plain_mid \
'use mid.{mid_call}

fn main():
    print(mid_call())
' \
'use target.{base_get}

pub fn mid_call() -> text:
    return base_get("x")
'

# DEFECT 1: alias used in the ENTRY module (phantom callable/global outranked
# the alias map in lower_identifier).
probe entry_alias \
'use target.{base_get as g}

fn main():
    print(g("x"))
'

# DEFECT 2: alias used in an IMPORTED module (type checker bound nothing for
# the flattened import-binding marker).
probe mid_alias \
'use mid.{mid_call}

fn main():
    print(mid_call())
' \
'use target.{base_get as g}

pub fn mid_call() -> text:
    return g("x")
'

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR -- nothing was checked"
    exit 2
fi

# Harness sanity, fail-closed and in BOTH modes. The two plain forms resolve
# before and after the fix; if either is broken the harness is not measuring the
# AOT lane (dead binary, missing linker, bad path) -- and without this gate a
# wholly dead binary would satisfy --expect-fail and read as "control live".
sick=""
for ctl in plain_entry plain_mid; do
    case " $BAD " in *" $ctl "*) sick="$sick $ctl" ;; esac
done
if [ -n "$sick" ]; then
    echo "ERROR -- nothing was checked: control form(s)$sick are broken, so the harness is not measuring the AOT lane"
    exit 2
fi

if [ "$EXPECT_FAIL" -eq 1 ]; then
    miss=""
    for want in entry_alias mid_alias; do
        case " $BAD " in *" $want "*) ;; *) miss="$miss $want" ;; esac
    done
    if [ -n "$miss" ]; then
        echo "FAIL -- negative control: expected these to be broken but they resolved:$miss"
        exit 1
    fi
    echo "PASS -- $CHECKED form(s) checked, negative control live (entry_alias, mid_alias still broken)"
    exit 0
fi

if [ -n "$BAD" ]; then
    echo "FAIL --$BAD do not resolve in the AOT lane"
    exit 1
fi

echo "PASS -- $CHECKED form(s) checked, all resolve in the AOT lane"
exit 0
