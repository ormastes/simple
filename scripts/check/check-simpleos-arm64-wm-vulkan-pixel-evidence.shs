#!/bin/sh
# check-simpleos-arm64-wm-vulkan-pixel-evidence.shs
#
# WM-with-Vulkan-backend smoke gate for SimpleOS/**aarch64**.  Boots the real
# desktop/WM kernel under REAL UEFI firmware, captures REAL framebuffer pixels
# out of the running guest, and states HONESTLY which renderer produced them.
#
# This is the aarch64 twin of
# scripts/check/check-simpleos-x86-64-wm-host-vulkan-pixel-evidence.shs
# (owned by the x86_64 lane; not modified here).  It reuses, rather than
# re-implements, the two aarch64 real-firmware building blocks that already
# exist:
#     scripts/os/build-simpleos-aarch64-efi-esp.shs        (ESP builder)
#     scripts/check/check-simpleos-arm64-efi-real-firmware-boot.shs (chain proof)
#
# ===========================================================================
# ARCHITECTURE — READ THIS BEFORE QUOTING THE VERDICT
# ===========================================================================
# There is NO in-guest Vulkan in SimpleOS, on any architecture.
# `VulkanCompositorBackend` (src/os/compositor/vulkan_compositor_backend.spl)
# rejects every draw by its own written contract, and the `rt_vulkan_*` entry
# points are compiled out in the freestanding guest.  See
# doc/08_tracking/bug/simpleos_in_guest_vulkan_absent_wm_smoke_is_cpu_2026-08-31.md.
#
# What DOES exist is a guest -> host OFFLOAD.  The guest WM encodes a draw IR,
# publishes it through an ivshmem BAR, and the host daemon
# (src/app/simpleos_gpu_host/) executes it on a real host GPU via Vulkan.
# The aarch64 desktop entry already wires this:
#   examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl:208
#     Engine2dWmFrameExecutor.create_host_gpu(..., SIMPLEOS_HOST_GPU_ISA_AARCH64, ...)
#   examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop_linux_qemu.spl
#     gui_entry_desktop_start(0u64, SIMPLEOS_HOST_GPU_BACKEND_VULKAN, true)
#
# So `renderer=host-vulkan` here means, EXACTLY:
#     GPU work happened ON THE HOST, in the daemon, on a real Vulkan device.
#     The aarch64 guest has no GPU and never did.
# `renderer=cpu` means the guest's baremetal software rasteriser drew the
# frame.  This gate prints the classification on its own `..._renderer=` line
# and in the verdict, so it can never claim Vulkan while running a stub.
#
# The gate additionally reports which Vulkan implementation the HOST daemon
# bound (`..._host_vulkan_driver=`), so a lavapipe/llvmpipe software ICD is
# distinguishable from a hardware device rather than both reading as "Vulkan".
#
# ===========================================================================
# BOOT CHAIN — no QEMU boot-protocol cheats anywhere
# ===========================================================================
#   AAVMF_CODE.fd (pflash0, ro) + AAVMF_VARS.fd (pflash1, rw)
#     -> UEFI Shell / BootOrder -> FS0:\EFI\BOOT\BOOTAA64.EFI (Limine, a real
#        EFI application on a FAT ESP on a virtio-blk device)
#     -> /boot/kernel.elf   (the arm64 desktop/WM kernel, `protocol: linux`,
#        which its crt0.S Linux `Image` header supports — the same MMU-off
#        physical handover QEMU `-kernel` gave it, but from real firmware)
#
# NEVER `-kernel`.  NEVER `isa-debug-exit`.  The argv this gate is about to run
# is self-scanned for both before QEMU is started, so a later edit cannot
# quietly reintroduce a cheat.  (.claude/rules/board-runnable.md)
#
# ===========================================================================
# NONCE / FRESH-VOLUME ANCHORING
# ===========================================================================
# Two independent anti-stale mechanisms, both verified host-side on BYTES:
#
#  (1) FRESH VOLUME.  The ESP image and the ivshmem backing file are rebuilt
#      from scratch every run.  BEFORE boot, the gate greps the raw bytes of
#      both for this run's nonce AND for the evidence output path.  If either
#      is already present pre-boot, the volume is contaminated and the gate
#      ERRORs.  Receipt BANNERS are deliberately not checked here: they are
#      format literals in the WM kernel's rodata, and the ESP carries
#      kernel.elf, so banning them would make the gate un-passable on any real
#      image.  Their staleness is fenced by (2) instead, which a rodata string
#      cannot satisfy.
#
#  (2) CROSS-SIDE TUPLE ANCHORING.  A pass requires the guest serial receipt
#      and the host daemon receipt to name the SAME (frame, submit_id,
#      fence_id) triple, minted per boot by the guest.  A stale daemon log, a
#      receipt for a different frame, or a receipt from a different submission
#      cannot cross-satisfy a fresh boot.  This is why the classifier PARSES
#      the fields instead of grepping two independent banners.
#
# A log banner alone is never sufficient, and the fatal `--selftest` contains
# an explicit banner-only must-FAIL fixture proving it.
#
# ===========================================================================
# VERDICT — last line of stdout, always
# ===========================================================================
#   PASS  — <n> item(s) checked ... renderer=<host-vulkan|cpu>   exit 0
#   FAIL  — ...                                                  exit 1
#   ERROR — nothing was checked: <reason>                        exit 2
#
# Zero captured frames, a missing tool, a missing firmware blob, a failed
# build, or an empty serial log is ERROR — NEVER a pass.  Absence of evidence
# is never evidence.
#
# STATUS: ADVISORY (honestly RED on main).  See
# doc/08_tracking/bug/arm64_wm_vulkan_real_firmware_lane_blocked_2026-09-01.md.
#
# Usage:
#   sh scripts/check/check-simpleos-arm64-wm-vulkan-pixel-evidence.shs
#   sh scripts/check/check-simpleos-arm64-wm-vulkan-pixel-evidence.shs --selftest

set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT_DIR"

BUILD_DIR=${ARM64_WM_VULKAN_BUILD_DIR:-build/simpleos_arm64_wm_vulkan}
EVIDENCE_DIR=$BUILD_DIR/evidence
ESP_DIR=$BUILD_DIR/esp
KERNEL_ELF=${ARM64_WM_VULKAN_KERNEL_ELF:-build/os/simpleos_arm64_desktop_engine2d.elf}
DAEMON_BIN=${ARM64_WM_VULKAN_DAEMON_BIN:-$BUILD_DIR/simpleos_gpu_host}
DAEMON_SRC=src/app/simpleos_gpu_host/main.spl
PPM_VALIDATOR=scripts/check/screen_ppm_distinct_colors.spl
QMP_SCREENDUMP=scripts/check/qmp_screendump.spl
SIMPLE_BIN=${SIMPLE_BIN:-}
QEMU_BIN=${QEMU_SYSTEM_AARCH64:-qemu-system-aarch64}
READY_TIMEOUT_MS=${ARM64_WM_VULKAN_READY_TIMEOUT_MS:-120000}
DAEMON_READY_TIMEOUT_MS=${ARM64_WM_VULKAN_DAEMON_READY_TIMEOUT_MS:-30000}
# native-build of the host daemon; the repo contract for this is 1200s.
NATIVE_BUILD_TIMEOUT=${ARM64_WM_VULKAN_NATIVE_BUILD_TIMEOUT:-1200}

# The aarch64 desktop entry prints its own arch-tagged ready line
# (gui_entry_desktop.spl:306) — it is NOT the x86 `[desktop-gui] desktop-ready`.
READY_MARKER='\[desktop-gui-arm64\] desktop-ready'
GUEST_VULKAN_MARKER='^\[wm-frame\] host-gpu-ready backend=vulkan generation=[1-9][0-9]*'
GUEST_PRESENT_MARKER='^\[wm-frame\] host-gpu-presented'
# Emitted by the HOST DAEMON's SIMPLEOS_HOST_GPU_KIND_DRAW_IR branch
# (src/app/simpleos_gpu_host/daemon_runner.spl) ONLY when `device_backed`
# holds: GPU backend selected, no fallback, zero skipped commands,
# readback_source=device_readback, real backend handle, nonzero checksum, real
# device identity.  A CPU fallback or a partial render cannot print it.
HOST_VULKAN_RECEIPT='^HOST_GPU_DAEMON_DRAWIR backend=vulkan frame=[1-9][0-9]* submit_id=[1-9][0-9]* fence_id=[1-9][0-9]* fence_completed=true '

EV_CHECKED=0
QEMU_PID=
DAEMON_PID=
PPM_DISTINCT_COLORS=0

# ---------------------------------------------------------------- verdicts --
pass_verdict() { printf 'PASS — %s\n' "$1"; exit 0; }
fail_verdict() { printf 'FAIL — %s\n' "$1"; exit 1; }
error_verdict() { printf 'ERROR — nothing was checked: %s\n' "$1"; exit 2; }

cleanup() {
    [ -z "$QEMU_PID" ] || kill "$QEMU_PID" 2>/dev/null || true
    [ -z "$DAEMON_PID" ] || kill "$DAEMON_PID" 2>/dev/null || true
}
trap cleanup 0 HUP INT TERM

# --------------------------------------------------------- argv rule guard --
# Enforced on the argv we are ABOUT to run, not the argv we intended to run.
argv_is_board_runnable() {
    for _a in "$@"; do
        case "$_a" in
            -kernel|isa-debug-exit|*isa-debug-exit*) return 1 ;;
        esac
    done
    return 0
}

# ------------------------------------------------------ fresh-volume check --
# A "volume" here is any host-side byte container handed to the guest: the ESP
# image and the ivshmem backing file.  Pre-boot it must contain NEITHER this
# run's nonce NOR the evidence target path.  Grepping raw bytes (grep -a) is
# deliberate: the ESP is a FAT image, not text, and the point is that the bytes
# are absent however they might be encoded.
#
# DELIBERATELY NOT CHECKED HERE: the receipt banners (`desktop-ready`,
# `host-gpu-presented`, `HOST_GPU_DAEMON_DRAWIR`).  Those strings are format
# literals compiled into the WM kernel's rodata, and the ESP carries kernel.elf
# — measured: `grep -ac desktop-ready` on a real desktop kernel ELF returns 1.
# Checking them here would make the gate permanently un-passable on any
# legitimately built image.  Staleness of the receipts is fenced by the
# per-boot frame/submit/fence triple in classify_renderer(), which a banner
# baked into rodata cannot satisfy — see the banner-only selftest fixture.
volume_is_clean() {
    _vol=$1; _nonce=$2; _target=$3
    [ -s "$_vol" ] || return 1
    for _tok in "$_nonce" "$_target"; do
        [ -n "$_tok" ] || continue
        if grep -aqF "$_tok" "$_vol" 2>/dev/null; then
            VOLUME_DIRTY_TOKEN=$_tok
            return 1
        fi
    done
    return 0
}

# ------------------------------------------------------------- classifiers --
# Real pixel content, delegated to the shared PPM validator, which exits 0 only
# when the dump parses AND carries more than one distinct colour.  A blank or
# single-colour frame therefore cannot pass.
ppm_has_real_content() {
    _ppm=$1
    [ -s "$_ppm" ] || return 1
    _out=$("$SIMPLE_RUNNER" run "$PPM_VALIDATOR" "$_ppm" 2>/dev/null) || return 1
    _colors=$(printf '%s\n' "$_out" | sed -n 's/^ppm_distinct_colors=//p' | head -n 1)
    case "$_colors" in ''|*[!0-9]*) return 1 ;; esac
    PPM_DISTINCT_COLORS=$_colors
    [ "$_colors" -gt 1 ]
}

guest_presented_field() {
    sed -n 's/^\[wm-frame\] host-gpu-presented .*[[:space:]]'"$2"'=\([0-9][0-9]*\).*$/\1/p' "$1" | head -n 1
}

# renderer=host-vulkan requires BOTH sides to agree, independently, on the same
# per-boot (frame, submit_id, fence_id) triple.  Either side alone, a daemon
# that merely STARTED, a banner without fields, a cpu-backend receipt, a
# different frame, or a different submission all classify as cpu.
classify_renderer() {
    _serial=$1
    _daemonlog=$2
    [ -f "$_serial" ] && [ -f "$_daemonlog" ] || { printf 'cpu\n'; return 0; }
    grep -qaE "$GUEST_VULKAN_MARKER" "$_serial" || { printf 'cpu\n'; return 0; }
    grep -qaE "$GUEST_PRESENT_MARKER" "$_serial" || { printf 'cpu\n'; return 0; }
    grep -qaE "$HOST_VULKAN_RECEIPT" "$_daemonlog" || { printf 'cpu\n'; return 0; }
    _frame=$(guest_presented_field "$_serial" frame)
    _submit=$(guest_presented_field "$_serial" submit_id)
    _fence=$(guest_presented_field "$_serial" fence_id)
    case "$_frame" in ''|*[!0-9]*|0) printf 'cpu\n'; return 0 ;; esac
    case "$_submit" in ''|*[!0-9]*|0) printf 'cpu\n'; return 0 ;; esac
    case "$_fence" in ''|*[!0-9]*|0) printf 'cpu\n'; return 0 ;; esac
    if grep -qaE "^HOST_GPU_DAEMON_DRAWIR backend=vulkan frame=$_frame submit_id=$_submit fence_id=$_fence fence_completed=true " "$_daemonlog"; then
        printf 'host-vulkan\n'
    else
        printf 'cpu\n'
    fi
}

# Name the host Vulkan implementation, so a software ICD (lavapipe/llvmpipe/
# swiftshader) is never silently reported as if it were a hardware GPU.
classify_host_vulkan_driver() {
    _daemonlog=$1
    _dev=$(sed -n 's/^HOST_GPU_DAEMON_SELECTOR .*device_name=\([^ ]*\).*$/\1/p' "$_daemonlog" 2>/dev/null | head -n 1)
    if [ -z "$_dev" ]; then
        _dev=$(vulkaninfo --summary 2>/dev/null | sed -n 's/^[[:space:]]*deviceName[[:space:]]*=[[:space:]]*//p' | head -n 1)
    fi
    [ -n "$_dev" ] || { printf 'unknown\n'; return 0; }
    case "$_dev" in
        *lavapipe*|*Lavapipe*|*llvmpipe*|*LLVMpipe*|*SwiftShader*|*swiftshader*)
            printf 'software:%s\n' "$_dev" ;;
        *) printf 'hardware:%s\n' "$_dev" ;;
    esac
}

wait_for_marker() {
    _file=$1; _pattern=$2; _budget=$3
    _w=0
    while [ "$_w" -le "$_budget" ]; do
        if [ -f "$_file" ] && grep -qaE "$_pattern" "$_file" 2>/dev/null; then
            return 0
        fi
        sleep 0.2
        _w=$((_w + 200))
    done
    return 1
}

# ----------------------------------------------------------------- selftest --
# Fatal, runs before any scan.  Every fixture is fed to the REAL functions
# above, never to a copy of them.
run_selftest() {
    _t=$(mktemp -d "${TMPDIR:-/tmp}/arm64-wm-vulkan-selftest.XXXXXX") || return 1
    _fails=0
    _n=0
    _bad() { echo "selftest: FAIL — $1"; _fails=$((_fails + 1)); }

    # --- argv board-runnable guard -----------------------------------------
    _n=$((_n + 1))
    argv_is_board_runnable -M virt -kernel /x/kernel.elf -display none &&
        _bad "argv guard accepted -kernel"
    _n=$((_n + 1))
    argv_is_board_runnable -M virt -device isa-debug-exit,iobase=0xf4 &&
        _bad "argv guard accepted isa-debug-exit"
    _n=$((_n + 1))
    argv_is_board_runnable -M virt -drive if=pflash,file=AAVMF_CODE.fd -display none ||
        _bad "argv guard rejected a legitimate AAVMF real-firmware argv"

    # --- pixel bar ----------------------------------------------------------
    _n=$((_n + 1))
    printf 'P6\n2 2\n255\n' > "$_t/blank.ppm"
    printf '\000\000\000\000\000\000\000\000\000\000\000\000' >> "$_t/blank.ppm"
    ppm_has_real_content "$_t/blank.ppm" && _bad "blank frame accepted as real content"
    _n=$((_n + 1))
    printf 'P6\n2 2\n255\n' > "$_t/single.ppm"
    printf '\377\000\000\377\000\000\377\000\000\377\000\000' >> "$_t/single.ppm"
    ppm_has_real_content "$_t/single.ppm" && _bad "single-colour frame accepted as real content"
    _n=$((_n + 1))
    printf 'P6\n2 2\n255\n' > "$_t/multi.ppm"
    printf '\377\000\000\000\377\000\000\000\377\377\377\377' >> "$_t/multi.ppm"
    ppm_has_real_content "$_t/multi.ppm" || _bad "multi-colour frame rejected"
    _n=$((_n + 1))
    : > "$_t/empty.ppm"
    ppm_has_real_content "$_t/empty.ppm" && _bad "zero-byte capture accepted"

    # --- fresh-volume anchoring --------------------------------------------
    _vtarget=build/x/evidence/wm-frame.ppm
    _n=$((_n + 1))
    printf 'this is a fresh esp image with no nonce and no target path in it\n' > "$_t/clean.img"
    volume_is_clean "$_t/clean.img" "NONCE-abc123" "$_vtarget" ||
        _bad "a genuinely clean volume was rejected"
    _n=$((_n + 1))
    printf 'junk NONCE-abc123 junk\n' > "$_t/noncepre.img"
    volume_is_clean "$_t/noncepre.img" "NONCE-abc123" "$_vtarget" &&
        _bad "a volume already containing this run's nonce was accepted"
    _n=$((_n + 1))
    printf 'junk build/x/evidence/wm-frame.ppm junk\n' > "$_t/pathpre.img"
    volume_is_clean "$_t/pathpre.img" "NONCE-abc123" "$_vtarget" &&
        _bad "a volume already naming the evidence target path was accepted"
    # A kernel ELF legitimately carries the receipt banners in rodata; that must
    # NOT read as contamination, or the gate could never pass on a real image.
    _n=$((_n + 1))
    printf 'ELF junk [desktop-gui-arm64] desktop-ready ... [wm-frame] host-gpu-presented junk\n' > "$_t/rodata.img"
    volume_is_clean "$_t/rodata.img" "NONCE-abc123" "$_vtarget" ||
        _bad "a volume carrying only compiled-in receipt format literals was rejected as contaminated"
    _n=$((_n + 1))
    : > "$_t/zero.img"
    volume_is_clean "$_t/zero.img" "NONCE-abc123" "$_vtarget" &&
        _bad "a zero-byte volume was accepted as a clean fresh volume"

    # --- renderer classification -------------------------------------------
    cat > "$_t/serial-nogpu.log" <<'EOF'
[desktop-gui-arm64] framebuffer ready width=1920 height=1080 pitch=7680
[desktop-gui-arm64] desktop-ready revision=1
EOF
    cat > "$_t/daemon-devpresent.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan device_name=NVIDIA_TITAN_RTX
HOST_GPU_DEVICE_PRESENT vendor=nvidia readback_bytes=0
EOF
    cat > "$_t/serial-guest.log" <<'EOF'
[wm-frame] host-gpu-ready backend=vulkan generation=48
[wm-frame] host-gpu-presented backend=vulkan generation=48 run=770425 frame=49 submit_id=7 fence_id=7 fence_completed=true device_frame_id=49 checksum=1417723768
[desktop-gui-arm64] desktop-ready revision=1
EOF
    cat > "$_t/daemon-ok.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan device_name=NVIDIA_TITAN_RTX
HOST_GPU_DAEMON_DRAWIR backend=vulkan frame=49 submit_id=7 fence_id=7 fence_completed=true device_frame_id=49 rendered=214 skipped=0 readback=device_readback
EOF

    _n=$((_n + 1))
    [ "$(classify_renderer "$_t/serial-nogpu.log" "$_t/daemon-devpresent.log")" = cpu ] ||
        _bad "device-present-with-no-GPU-work classified as host-vulkan"
    _n=$((_n + 1))
    [ "$(classify_renderer "$_t/serial-guest.log" "$_t/daemon-devpresent.log")" = cpu ] ||
        _bad "guest-only receipt classified as host-vulkan"
    _n=$((_n + 1))
    [ "$(classify_renderer "$_t/serial-nogpu.log" "$_t/daemon-ok.log")" = cpu ] ||
        _bad "host-only receipt classified as host-vulkan"
    _n=$((_n + 1))
    [ "$(classify_renderer "$_t/serial-guest.log" "$_t/daemon-ok.log")" = host-vulkan ] ||
        _bad "both matching receipts did not classify as host-vulkan"
    _n=$((_n + 1))
    [ "$(classify_renderer "$_t/serial-guest.log" "$_t/absent.log")" = cpu ] ||
        _bad "missing daemon log did not classify as cpu"

    # BANNER-ONLY must-FAIL.  This is the exact failure mode this repo keeps
    # hitting: a gate that greens off log banners.  Here BOTH sides carry
    # plausible, well-formed banners naming Vulkan — and NEITHER carries the
    # anchored per-boot field triple.  It must classify as cpu.
    _n=$((_n + 1))
    cat > "$_t/serial-banner.log" <<'EOF'
SimpleOS aarch64 desktop starting
[wm-frame] host-gpu-ready backend=vulkan generation=48
[wm-frame] host-gpu-presented backend=vulkan generation=48
[desktop-gui-arm64] desktop-ready revision=1
Vulkan backend active
EOF
    cat > "$_t/daemon-banner.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan device_name=NVIDIA_TITAN_RTX
HOST_GPU_DAEMON_READY backend=vulkan
Vulkan device initialised, ready to render
HOST_GPU_DAEMON_DRAWIR backend=vulkan
EOF
    [ "$(classify_renderer "$_t/serial-banner.log" "$_t/daemon-banner.log")" = cpu ] ||
        _bad "BANNER-ONLY logs (no anchored frame/submit/fence triple) classified as host-vulkan"

    _n=$((_n + 1))
    cat > "$_t/daemon-othersubmit.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan device_name=NVIDIA_TITAN_RTX
HOST_GPU_DAEMON_DRAWIR backend=vulkan frame=49 submit_id=99 fence_id=99 fence_completed=true device_frame_id=49 rendered=214 skipped=0 readback=device_readback
EOF
    [ "$(classify_renderer "$_t/serial-guest.log" "$_t/daemon-othersubmit.log")" = cpu ] ||
        _bad "stale daemon receipt from a different submission classified as host-vulkan"
    _n=$((_n + 1))
    cat > "$_t/daemon-otherframe.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan device_name=NVIDIA_TITAN_RTX
HOST_GPU_DAEMON_DRAWIR backend=vulkan frame=7 submit_id=7 fence_id=7 fence_completed=true device_frame_id=7 rendered=214 skipped=0 readback=device_readback
EOF
    [ "$(classify_renderer "$_t/serial-guest.log" "$_t/daemon-otherframe.log")" = cpu ] ||
        _bad "daemon receipt for a different frame classified as host-vulkan"
    _n=$((_n + 1))
    cat > "$_t/daemon-cpu.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan device_name=NVIDIA_TITAN_RTX
HOST_GPU_DAEMON_DRAWIR backend=cpu frame=49 submit_id=7 fence_id=7 fence_completed=true device_frame_id=49 rendered=214 skipped=0 readback=cpu_readback
EOF
    [ "$(classify_renderer "$_t/serial-guest.log" "$_t/daemon-cpu.log")" = cpu ] ||
        _bad "cpu-backend daemon receipt classified as host-vulkan"
    _n=$((_n + 1))
    cat > "$_t/daemon-guestline.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan device_name=NVIDIA_TITAN_RTX
HOST_GPU_PROCESS_OK isa=aarch64 backend=vulkan generation=48 run=770425 frame=49
EOF
    [ "$(classify_renderer "$_t/serial-guest.log" "$_t/daemon-guestline.log")" = cpu ] ||
        _bad "guest-emitted PROCESS_OK accepted as a daemon receipt"
    _n=$((_n + 1))
    cat > "$_t/daemon-processing.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan device_name=NVIDIA_TITAN_RTX
HOST_GPU_PROCESS_PERF isa=aarch64 backend=vulkan generation=48 run=770425 frame=49 cpu_us=8100 device_us=1900
EOF
    [ "$(classify_renderer "$_t/serial-guest.log" "$_t/daemon-processing.log")" = cpu ] ||
        _bad "compute-path PROCESS_PERF receipt accepted as a WM draw-IR receipt"

    # --- Vulkan honesty: software ICD must be named as software -------------
    _n=$((_n + 1))
    cat > "$_t/daemon-lavapipe.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan device_name=llvmpipe
EOF
    case "$(classify_host_vulkan_driver "$_t/daemon-lavapipe.log")" in
        software:*) : ;;
        *) _bad "a lavapipe/llvmpipe software ICD was not reported as software" ;;
    esac
    _n=$((_n + 1))
    case "$(classify_host_vulkan_driver "$_t/daemon-ok.log")" in
        hardware:*) : ;;
        *) _bad "a hardware device_name was not reported as hardware" ;;
    esac

    rm -rf "$_t"
    SELFTEST_FIXTURES=$_n
    [ "$_fails" -eq 0 ] || return 1
    echo "[arm64-wm-vulkan] selftest OK ($_n fixtures)"
    return 0
}

# ------------------------------------------------------------ runner lookup --
resolve_simple_runner() {
    for _c in "$SIMPLE_BIN" "$ROOT_DIR/bin/simple" \
              "$ROOT_DIR/src/compiler_rust/target/release/simple"; do
        [ -n "$_c" ] || continue
        [ -x "$_c" ] || continue
        SIMPLE_RUNNER=$_c
        return 0
    done
    return 1
}

resolve_simple_runner || error_verdict "no runnable simple binary for the PPM validator (set SIMPLE_BIN)"
[ -f "$PPM_VALIDATOR" ] || error_verdict "PPM validator missing: $PPM_VALIDATOR"

SELFTEST_FIXTURES=0
run_selftest || error_verdict "selftest failed (fatal)"

case "${1:-}" in
    --selftest)
        pass_verdict "$SELFTEST_FIXTURES selftest fixture(s) checked, classifier, fresh-volume anchor, pixel bar and argv guard behave (no boot attempted), renderer=n/a" ;;
esac

# --------------------------------------------------------- preconditions ----
command -v "$QEMU_BIN" >/dev/null 2>&1 || error_verdict "$QEMU_BIN not installed"
command -v mkfs.vfat >/dev/null 2>&1 || [ -x /usr/sbin/mkfs.vfat ] ||
    error_verdict "mkfs.vfat not available (install dosfstools) — needed to build the FAT ESP"

find_fw() { for _c in "$@"; do [ -f "$_c" ] && { printf '%s\n' "$_c"; return 0; }; done; return 1; }
if [ -z "${AAVMF_CODE:-}" ]; then
    AAVMF_CODE=$(find_fw /usr/share/AAVMF/AAVMF_CODE.fd \
                         /usr/share/AAVMF/AAVMF_CODE.no-secboot.fd \
                         /usr/share/qemu-efi-aarch64/QEMU_EFI.fd \
                         /opt/homebrew/share/qemu/edk2-aarch64-code.fd \
                         /usr/local/share/qemu/edk2-aarch64-code.fd) || AAVMF_CODE=
fi
[ -n "${AAVMF_CODE:-}" ] ||
    error_verdict "no EDK2/AAVMF aarch64 firmware found (install qemu-efi-aarch64, or set AAVMF_CODE). Falling back to QEMU -kernel is forbidden by .claude/rules/board-runnable.md"

[ -f "$ROOT_DIR/vendor/limine/BOOTAA64.EFI" ] ||
    error_verdict "missing vendor/limine/BOOTAA64.EFI (run: sh scripts/os/provision_limine_efi.shs)"

# The WM kernel is built by a SEPARATE, heavy lane, deliberately not invoked
# from inside this gate:
#   sh scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs
[ -s "$KERNEL_ELF" ] ||
    error_verdict "arm64 desktop/WM kernel missing: $KERNEL_ELF — build it first with scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs"

mkdir -p "$EVIDENCE_DIR" "$ESP_DIR"

# The env overrides may legitimately carry absolute paths, so paths handed to
# other programs are normalised rather than blindly prefixed with $ROOT_DIR.
abspath() { case "$1" in /*) printf '%s\n' "$1" ;; *) printf '%s/%s\n' "$ROOT_DIR" "$1" ;; esac; }
KERNEL_ELF_ABS=$(abspath "$KERNEL_ELF")
ESP_DIR_ABS=$(abspath "$ESP_DIR")

# ---------------------------------------- build the host GPU Vulkan daemon --
# Never with SIMPLE_ALLOW_STUB_FALLBACK / SIMPLE_ALLOW_UNRESOLVED_RUNTIME: a
# stubbed daemon would be exactly the thing this gate exists to refuse.
if [ ! -x "$DAEMON_BIN" ]; then
    [ -f "$DAEMON_SRC" ] || error_verdict "host GPU daemon source missing: $DAEMON_SRC"
    # `set -e` would kill the script on the invocation line itself and the
    # gate would exit with no verdict, so -e is lifted across the call and the
    # status is read DIRECTLY into a variable on the next line — never through
    # a pipe, whose $? is the last stage's status.
    set +e
    env -u SIMPLE_ALLOW_STUB_FALLBACK -u SIMPLE_ALLOW_UNRESOLVED_RUNTIME \
        SIMPLE_NO_STUB_FALLBACK=1 \
        "$SIMPLE_RUNNER" native-build "$DAEMON_SRC" --timeout 1200 -o "$DAEMON_BIN" \
        >"$EVIDENCE_DIR/daemon-build.log" 2>&1
    DAEMON_BUILD_RC=$?
    set -e
    [ "$DAEMON_BUILD_RC" -eq 0 ] ||
        error_verdict "host GPU daemon native-build failed (rc=$DAEMON_BUILD_RC, see $EVIDENCE_DIR/daemon-build.log): $(tail -n 1 "$EVIDENCE_DIR/daemon-build.log" 2>/dev/null)"
fi
[ -x "$DAEMON_BIN" ] || error_verdict "host GPU daemon not executable: $DAEMON_BIN"

SERIAL_LOG=$EVIDENCE_DIR/serial.log
DAEMON_LOG=$EVIDENCE_DIR/daemon.log
QEMU_STDERR=$EVIDENCE_DIR/qemu.stderr
QMP_SOCKET=$EVIDENCE_DIR/qmp.sock
SHM_FILE=$EVIDENCE_DIR/hostgpu.shm
PPM_FRAME=$EVIDENCE_DIR/wm-frame.ppm
ESP_IMG=$ESP_DIR/esp.img
# Every artifact is destroyed, so nothing from a previous run can be read as
# evidence for this one.
rm -f "$SERIAL_LOG" "$DAEMON_LOG" "$QEMU_STDERR" "$QMP_SOCKET" "$SHM_FILE" \
      "$PPM_FRAME" "$ESP_IMG"

RUN_NONCE="ARM64WMVK-$(date +%s)-$$-$(od -An -N4 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
printf 'simpleos_arm64_wm_vulkan_run_nonce=%s\n' "$RUN_NONCE"

# ------------------------------------- 1. build a FRESH real-firmware ESP ----
# BOOT_PROTOCOL=linux: the unified arm64 desktop kernel's crt0.S carries an
# arm64 Linux `Image` header, so BOOTAA64.EFI hands it over MMU-off in physical
# space — the same contract `-kernel` gave it, but from real firmware.
# Same -e lifting as the daemon build above: a failed ESP build must produce
# ERROR (exit 2), not a bare non-zero exit with no verdict line.
set +e
env KERNEL_ELF="$KERNEL_ELF_ABS" OUT_DIR="$ESP_DIR_ABS" \
    BOOT_PROTOCOL=linux AAVMF_CODE="$AAVMF_CODE" \
    sh "$ROOT_DIR/scripts/os/build-simpleos-aarch64-efi-esp.shs" \
    >"$EVIDENCE_DIR/esp-build.log" 2>&1
ESP_BUILD_RC=$?
set -e
[ "$ESP_BUILD_RC" -eq 0 ] ||
    error_verdict "ESP build failed (rc=$ESP_BUILD_RC, see $EVIDENCE_DIR/esp-build.log): $(tail -n 1 "$EVIDENCE_DIR/esp-build.log" 2>/dev/null)"
[ -s "$ESP_IMG" ] || error_verdict "ESP builder produced no $ESP_IMG"

AAVMF_VARS_RUN=$ESP_DIR/AAVMF_VARS.fd
[ -f "$AAVMF_VARS_RUN" ] || error_verdict "ESP builder staged no AAVMF_VARS.fd next to $ESP_IMG"
chmod u+w "$AAVMF_VARS_RUN"

# ----------------------------------- 2. size the FRESH ivshmem backing file --
dd if=/dev/zero of="$SHM_FILE" bs=1M count=8 status=none 2>/dev/null ||
    error_verdict "could not size the ivshmem backing file $SHM_FILE"

# ---------------------------- 3. PRE-BOOT fresh-volume nonce/receipt check ---
# Verified on the BYTES of the images, host-side, not on a serial line.
VOLUME_DIRTY_TOKEN=
volume_is_clean "$ESP_IMG" "$RUN_NONCE" "$PPM_FRAME" ||
    error_verdict "pre-boot ESP image is contaminated (contains '${VOLUME_DIRTY_TOKEN:-<empty image>}') — a nonce or evidence path already in the volume cannot serve as evidence of a running guest"
EV_CHECKED=$((EV_CHECKED + 1))
volume_is_clean "$SHM_FILE" "$RUN_NONCE" "$PPM_FRAME" ||
    error_verdict "pre-boot ivshmem backing file is contaminated (contains '${VOLUME_DIRTY_TOKEN:-<empty file>}')"
EV_CHECKED=$((EV_CHECKED + 1))

# --------------------------------------------- 4. host GPU daemon (Vulkan) --
env -u SIMPLE_ALLOW_STUB_FALLBACK -u SIMPLE_ALLOW_UNRESOLVED_RUNTIME \
    "$DAEMON_BIN" "--shm=$SHM_FILE" --processing-backend=vulkan --processing-verify-cpu \
    >"$DAEMON_LOG" 2>&1 &
DAEMON_PID=$!

if ! wait_for_marker "$DAEMON_LOG" '^HOST_GPU_DAEMON_SELECTOR .*processing_backend=vulkan' \
                     "$DAEMON_READY_TIMEOUT_MS"; then
    echo "--- daemon log tail ---"; tail -n 10 "$DAEMON_LOG" 2>/dev/null
    error_verdict "host GPU daemon never selected a Vulkan backend; no GPU work is possible, and this gate refuses to boot and then mislabel a CPU frame as Vulkan"
fi
EV_CHECKED=$((EV_CHECKED + 1))

HOST_VULKAN_DRIVER=$(classify_host_vulkan_driver "$DAEMON_LOG")

# ------------------------------- 5. boot under REAL firmware (EDK2/AAVMF) ----
set -- -no-user-config -monitor none -net none \
    -M virt -cpu cortex-a72 -m 2G \
    -drive "if=pflash,format=raw,readonly=on,file=$AAVMF_CODE" \
    -drive "if=pflash,format=raw,file=$AAVMF_VARS_RUN" \
    -drive "if=none,file=$ESP_IMG,format=raw,id=esp" \
    -device virtio-blk-pci,drive=esp,bootindex=0 \
    -device ramfb \
    -object "memory-backend-file,id=hostgpu,share=on,mem-path=$SHM_FILE,size=8M" \
    -device ivshmem-plain,memdev=hostgpu \
    -serial "file:$SERIAL_LOG" \
    -display none -no-reboot \
    -qmp "unix:$QMP_SOCKET,server,nowait"

argv_is_board_runnable "$@" ||
    error_verdict "refusing to run: argv contains -kernel or isa-debug-exit (board-runnable rule; this is a script bug, not an environment gap)"

"$QEMU_BIN" "$@" 2>"$QEMU_STDERR" &
QEMU_PID=$!

waited=0
while [ "$waited" -le 20000 ]; do
    [ -S "$QMP_SOCKET" ] && break
    kill -0 "$QEMU_PID" 2>/dev/null || break
    sleep 0.1
    waited=$((waited + 100))
done
[ -S "$QMP_SOCKET" ] || { tail -n 5 "$QEMU_STDERR" 2>/dev/null; error_verdict "QMP socket never appeared (qemu stderr: $QEMU_STDERR)"; }

# ------------------------------------------------------- 6. wait for the WM --
if ! wait_for_marker "$SERIAL_LOG" "$READY_MARKER" "$READY_TIMEOUT_MS"; then
    echo "--- serial tail ---"; tail -n 25 "$SERIAL_LOG" 2>/dev/null
    fail_verdict "$EV_CHECKED item(s) checked, SimpleOS aarch64 WM never reached '[desktop-gui-arm64] desktop-ready' under EDK2/AAVMF pflash -> BOOTAA64.EFI -> kernel.elf (serial: $SERIAL_LOG), renderer=unknown, host_vulkan_driver=$HOST_VULKAN_DRIVER"
fi
EV_CHECKED=$((EV_CHECKED + 1))

# Give the frame executor time to negotiate the offload and present a frame.
sleep 3

# ------------------------------------------------ 7. capture a REAL frame ----
"$SIMPLE_RUNNER" run "$QMP_SCREENDUMP" "$QMP_SOCKET" "$(abspath "$PPM_FRAME")" \
    >/dev/null 2>&1 || true
[ -s "$PPM_FRAME" ] ||
    error_verdict "zero frames captured (QMP screendump produced no file); a device being present is not evidence"
EV_CHECKED=$((EV_CHECKED + 1))

if ! ppm_has_real_content "$PPM_FRAME"; then
    fail_verdict "$EV_CHECKED item(s) checked, captured aarch64 frame is blank or single-colour (distinct_colors=$PPM_DISTINCT_COLORS, $PPM_FRAME), renderer=unknown, host_vulkan_driver=$HOST_VULKAN_DRIVER"
fi
EV_CHECKED=$((EV_CHECKED + 1))

# --------------------------------------------------- 8. name the renderer ----
RENDERER=$(classify_renderer "$SERIAL_LOG" "$DAEMON_LOG")
EV_CHECKED=$((EV_CHECKED + 1))

cleanup

printf 'simpleos_arm64_wm_vulkan_serial_log=%s\n' "$SERIAL_LOG"
printf 'simpleos_arm64_wm_vulkan_daemon_log=%s\n' "$DAEMON_LOG"
printf 'simpleos_arm64_wm_vulkan_esp_image=%s\n' "$ESP_IMG"
printf 'simpleos_arm64_wm_vulkan_frame_ppm=%s\n' "$PPM_FRAME"
printf 'simpleos_arm64_wm_vulkan_distinct_colors=%s\n' "$PPM_DISTINCT_COLORS"
printf 'simpleos_arm64_wm_vulkan_host_vulkan_driver=%s\n' "$HOST_VULKAN_DRIVER"
printf 'simpleos_arm64_wm_vulkan_renderer=%s\n' "$RENDERER"

if [ "$RENDERER" = host-vulkan ]; then
    pass_verdict "$EV_CHECKED item(s) checked, SimpleOS aarch64 WM booted under REAL EDK2/AAVMF pflash firmware (AAVMF -> BOOTAA64.EFI on a FAT ESP -> kernel.elf; no -kernel, no isa-debug-exit) and presented a frame with $PPM_DISTINCT_COLORS distinct colours; guest wm-frame receipt AND host daemon draw-IR receipt name the SAME per-boot frame/submit/fence triple, renderer=host-vulkan on host_vulkan_driver=$HOST_VULKAN_DRIVER (GPU work ran ON THE HOST daemon — the aarch64 guest has no in-guest Vulkan)"
fi

pass_verdict "$EV_CHECKED item(s) checked, SimpleOS aarch64 WM booted under REAL EDK2/AAVMF pflash firmware (AAVMF -> BOOTAA64.EFI on a FAT ESP -> kernel.elf; no -kernel, no isa-debug-exit) and presented a frame with $PPM_DISTINCT_COLORS distinct colours; the host-GPU offload did not negotiate, so the guest baremetal software rasteriser drew it, renderer=cpu (host_vulkan_driver=$HOST_VULKAN_DRIVER was available but unused)"
