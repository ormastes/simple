#!/bin/sh
set -eu
r=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
f="$r/src/lib/nogc_async_mut/database/postgres_mimic/scalar_dispatch_adapter.spl"
server="$r/src/lib/nogc_async_mut/database/postgres_mimic/parallel_linux_server.spl"
grep -q 'class PgScalarFrontendAdapter' "$f"
grep -q 'class PgScalarDispatchOwner' "$f"
grep -q 'rt_pg_dispatch_result_poll(self.port_token, request)' "$f"
grep -q 'rt_pg_dispatch_owner_claim(self.port_token)' "$f"
grep -q 'rt_pg_dispatch_complete_by_claim(request, 0, blob)' "$f"
grep -q 'rt_pg_completion_blob_release(blob)' "$f"
grep -q 'rt_pg_dispatch_result_release(receipt)' "$f"
if grep -q 'PgDispatchGate\|PgWireServerConfig\|Any' "$f"; then exit 1; fi
if grep -q 'rt_pg_dispatch_owner_complete(self.port_token' "$f"; then exit 1; fi
grep -q 'class PgScalarParallelWorkerV1' "$server"
grep -q 'class PgScalarParallelOwnerV1' "$server"
grep -q 'self.scalar.claim_next()' "$server"
grep -q 'self.gate.submit_startup' "$server"
grep -q 'self.gate.submit(connection, session, PgDispatchOperation.Query' "$server"
grep -q 'self.gate.complete(job_id, completion)' "$server"
grep -q 'self.scalar.publish_encoded(claim, operation' "$server"
sh "$r/scripts/check/check-pg-dispatch-port-prototype.shs" /mnt/data/pg-scalar-adapter-runtime
printf '%s\n' 'PASS pg_scalar_adapter_source_contract'
