# Runtime link-completeness allowlist (read by check-runtime-link-completeness.shs).
#
# Symbols declared `extern fn` in the default decl roots (src/compiler,
# host.spl, native_build_worker.spl) that the core-C runtime does NOT define
# and that the real stage3 link does NOT reference: the 2026-11-02 phase-3
# manual stage3 link resolved with only the rt_heap_aux_live_bytes shim plus
# the runtime_cranelift_bridge_stub / async_driver / async_windows /
# runtime_process_tree owners, so none of these reach the linker (dead MIR
# interpreter / baremetal / demand-loaded provider externs).
#
# Rules: never add a symbol the stage3 link references; shrink this list when
# a provider gains a C owner. New undefined symbols must fail the gate.
runtime_link_completeness_allow:
  bug: stage2_runtime_missing_rt_heap_aux_live_bytes_2026-11-02
  symbols:
    - rt_actor_try_send
    - rt_arm_elf64_direct_entry
    - rt_baked_fs_byte
    - rt_browser_http_job_cancel
    - rt_browser_http_job_free
    - rt_build_symbol_table
    - rt_byte_char
    - rt_bytes_concat
    - rt_bytes_slice
    - rt_cli
    - rt_copy_user_byte
    - rt_current_time_ms
    - rt_db_delete
