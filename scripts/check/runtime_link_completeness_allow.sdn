# Runtime link-completeness allowlist (read by check-runtime-link-completeness.shs).
#
# Symbols declared `extern fn` in the default decl roots (src/compiler,
# host.spl, native_build_worker.spl) that the core-C runtime does NOT define
# and that the real stage3 link does NOT reference: the 2026-11-02 phase-3
# manual stage3 link resolved with only the rt_heap_aux_live_bytes shim plus
# the runtime_cranelift_bridge_stub / async_driver / async_windows /
# runtime_process_tree owners, so none of these reach the linker (dead MIR
# interpreter / baremetal / demand-loaded provider externs).
#
# Rules: never add a symbol the stage3 link references; shrink this list when
# a provider gains a C owner. New undefined symbols must fail the gate.
runtime_link_completeness_allow:
  bug: stage2_runtime_missing_rt_heap_aux_live_bytes_2026-11-02
  symbols:
    - rt_actor_try_send
    - rt_browser_http_job_cancel
    - rt_browser_http_job_free
    - rt_build_symbol_table
    - rt_current_time_ms
    - rt_db_delete
    - rt_db_get
    - rt_db_get_int
    - rt_db_get_int_by_pk
    - rt_db_iget_int
    - rt_db_iput3
    - rt_db_iupdate_int
    - rt_db_put
    - rt_db_put_row3
    - rt_db_put_value_int
    - rt_db_row_count
    - rt_db_scan_range
    - rt_db_table_create
    - rt_db_table_destroy
    - rt_db_update_int
    - rt_extract_all_symbols
    - rt_extract_all_symbols_v2
    - rt_find_symbol_at_position
    - rt_find_symbol_at_position_v2
    - rt_find_symbol_references
    - rt_free_ast
    - rt_free_symbol_table
    - rt_gc_collect
    - rt_get_concurrent_backend
    - rt_get_context_keywords
    - rt_get_file_mtime
    - rt_get_page_size
    - rt_get_scope_at_position
    - rt_get_scope_at_position_v2
    - rt_heap_live_bytes_by_kind
    - rt_heap_live_count_by_kind
    - rt_hook_add_breakpoint
    - rt_hook_continue
    - rt_hook_disable_debugging
    - rt_hook_enable_debugging
    - rt_hook_evaluate_condition
    - rt_hook_evaluate_expression
    - rt_hook_get_call_depth
    - rt_hook_get_stack_frames
    - rt_hook_get_variables
    - rt_hook_pause
    - rt_hook_remove_breakpoint
    - rt_hook_set_breakpoint_enabled
    - rt_hook_step
    - rt_hook_terminate
    - rt_is_macro_trace_enabled
    - rt_jit_call_i64
    - rt_jit_call_void
    - rt_jit_cleanup
    - rt_jit_compile_source
    - rt_jit_create
    - rt_jit_has_function
    - rt_madvise_raw
    - rt_malloc
    - rt_mlock
    - rt_mmap_file
    - rt_mmap_read_bytes
    - rt_mmap_read_string
    - rt_msync_flags
    - rt_munlock
    - rt_page_size
    - rt_parse_source
    - rt_profiler_is_active
    - rt_profiler_record_call
    - rt_profiler_record_return
    - rt_rank_query
    - rt_read_u8
    - rt_select_query
    - rt_set_debug_mode
    - rt_set_macro_trace
    - rt_time_now_millis
    - rt_timestamp_iso8601
    - rt_tls13_aes128_gcm_decrypt
    - rt_type_check_ast
    - rt_type_registry_has
    - rt_type_registry_lookup
