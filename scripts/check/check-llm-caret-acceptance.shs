#!/bin/sh
# check-llm-caret-acceptance.shs — fail-closed gate for the LLM Caret agent
# infrastructure acceptance layer.
#
# What it gates (in this order, one spec per `bin/simple test` invocation —
# section/directory runs are forbidden by .claude/rules/testing.md F2 because
# parallel invocations corrupt the shared test database):
#   3 unit specs      test/01_unit/app/llm_caret/{agent_workspace,infra_tools,infra_wiki}
#   7 system specs    test/03_system/app/llm_caret/{workspace_cli_system,
#                       agent_team_workspace_system,workspace_recovery_system,
#                       workspace_embed_parity_system,caret_suite_tmux_window_system,
#                       infra_servers_system} + test/03_system/app/mcp/caret_tools_mcp_system
#   1 acceptance spec test/03_system/app/llm_caret/caret_agent_infra_acceptance_spec.spl
#   1 live wrapper    scripts/check/check-llm-caret-infra-live.shs (only when Docker is present;
#                     absent Docker is a COUNTED SKIP, never a silent drop)
#
# Why the verdict is not just "exit 0" (.claude/rules/testing.md, "Silent green"):
# `bin/simple test` has been measured printing ~1897 warning lines with NO
# result summary and exiting 0. So this gate never reads an exit code as proof.
# For every spec it reads BOTH authoritative lines out of the captured log,
# with ANSI stripped and never via `tail -1`:
#   `Results: N total, N passed, M failed, K skipped`
#   `SPEC FILE VERDICT: <path> outcome=OK|ERROR ... failed=M ...`
# A run with NO `Results:` line is INCONCLUSIVE -> FAIL, per "No Results: line
# at all = the run ABORTED, and the counts are UNKNOWN".
#
# Binary identity is bracketed (readlink -f + byte size + sha256) before AND
# after the whole run. The deployed binary is replaced by other lanes mid-session
# (three distinct builds seen in one day), and evidence is only as good as the
# binary that produced it — so a change mid-run is ERROR, never PASS.
#
# Detector standard (doc/07_guide/infra/detector/detector_standard.md):
#   - `--selftest` runs FIRST on every invocation and is FATAL. It includes
#     must-FAIL fixtures, not only must-PASS: a failing-example log, a log with
#     no Results: line, and an empty spec set must each be rejected.
#   - Non-vacuity is absolute: 0 specs executed, or a missing/unusable
#     `bin/simple`, is `ERROR — nothing was checked`, exit 2 — never a pass.
#   - Three-way PASS / SKIP / FAIL, so "can't tell" is never a pass. A SKIP is
#     always COUNTED and named in the verdict.
#
# Verdict is the LAST line on stdout:
#   PASS  — <n> spec(s), <m> example(s), 0 failed (binary <sha12>)   exit 0
#   FAIL  — ... naming each failing spec                             exit 1
#   ERROR — nothing was checked (<reason>)                           exit 2
#
# Usage:
#   sh scripts/check/check-llm-caret-acceptance.shs [--selftest] [--bin PATH]
#   SIMPLE_BIN=/path/to/simple sh scripts/check/check-llm-caret-acceptance.shs
#
# MEASURED RUNTIME: 72s wall for the full green run on this host (bin/simple
# 60,646,096 B sha 3ef64bff, shared box, 2026-08-25): 11 specs / 59 examples,
# Docker present so the live wrapper ran too (`PASS — 2 live row(s)`). On a host
# without Docker the live wrapper is a counted SKIP and the run is a few seconds
# shorter. `--selftest` alone is ~0.05s: it runs against fabricated log fixtures
# and never invokes the compiler.
#
# FP-RATE: 0/16 (0%) on the 16 hand-adjudicated log fixtures in --selftest,
# measured 2026-08-25. That sample is fabricated runner output covering the
# clean, failing, aborted, ANSI-coloured, skipped and vacuous shapes; it is a
# parser false-positive rate, not a claim about spec flakiness.

. "${0%/*}/../lib/recursion_guard.shs"

set -u

REPO_ROOT=$(cd "${0%/*}/../.." && pwd)
SIMPLE_BIN=${SIMPLE_BIN:-"$REPO_ROOT/bin/simple"}
DO_SELFTEST_ONLY=0

while [ $# -gt 0 ]; do
    case "$1" in
        --selftest) DO_SELFTEST_ONLY=1 ;;
        --bin) shift; SIMPLE_BIN=$1 ;;
        --bin=*) SIMPLE_BIN=${1#--bin=} ;;
        *) echo "usage: $0 [--selftest] [--bin PATH]" >&2; exit 2 ;;
    esac
    shift
done

SPEC_TIMEOUT=${SPEC_TIMEOUT:-900}
INNER_TIMEOUT=${INNER_TIMEOUT:-600}

UNIT_SPECS="
test/01_unit/app/llm_caret/agent_workspace_spec.spl
test/01_unit/app/llm_caret/infra_tools_spec.spl
test/01_unit/app/llm_caret/infra_wiki_spec.spl
"
SYSTEM_SPECS="
test/03_system/app/llm_caret/workspace_cli_system_spec.spl
test/03_system/app/llm_caret/agent_team_workspace_system_spec.spl
test/03_system/app/llm_caret/workspace_recovery_system_spec.spl
test/03_system/app/llm_caret/workspace_embed_parity_system_spec.spl
test/03_system/app/llm_caret/caret_suite_tmux_window_system_spec.spl
test/03_system/app/llm_caret/infra_servers_system_spec.spl
test/03_system/app/mcp/caret_tools_mcp_system_spec.spl
"
ACCEPTANCE_SPEC="test/03_system/app/llm_caret/caret_agent_infra_acceptance_spec.spl"

# --- log parsing ------------------------------------------------------------
# Strip ANSI SGR sequences: the runner colours its verdict lines, and a raw
# grep for "0 failed" misses `0\e[0m failed`.
_strip_ansi() {
    sed -e 's/\x1b\[[0-9;]*[A-Za-z]//g' "$1"
}

# classify_log <logfile> <spec-path>
# Echoes one line: "<status> <total> <passed> <failed> <skipped>" where status
# is OK | FAILED | INCONCLUSIVE. Never reads an exit code; only the two
# authoritative lines. Uses the LAST Results:/verdict line (a run may print
# per-file blocks) but never blind `tail -1` of the whole log.
classify_log() {
    _cl_log=$1
    _cl_spec=$2
    _cl_clean=$(_strip_ansi "$_cl_log")

    _cl_results=$(printf '%s\n' "$_cl_clean" | grep -E '^Results: [0-9]+ total' | tail -n 1)
    if [ -z "$_cl_results" ]; then
        # No Results: line at all => the run ABORTED and the counts are UNKNOWN.
        echo "INCONCLUSIVE 0 0 0 0"
        return
    fi

    _cl_total=$(printf '%s\n' "$_cl_results" | sed -n 's/^Results: \([0-9]*\) total.*/\1/p')
    _cl_passed=$(printf '%s\n' "$_cl_results" | sed -n 's/.*total, \([0-9]*\) passed.*/\1/p')
    _cl_failed=$(printf '%s\n' "$_cl_results" | sed -n 's/.*passed, \([0-9]*\) failed.*/\1/p')
    _cl_skipped=$(printf '%s\n' "$_cl_results" | sed -n 's/.*failed, \([0-9]*\) skipped.*/\1/p')
    [ -n "$_cl_skipped" ] || _cl_skipped=0
    if [ -z "$_cl_total" ] || [ -z "$_cl_passed" ] || [ -z "$_cl_failed" ]; then
        echo "INCONCLUSIVE 0 0 0 0"
        return
    fi

    # The per-file verdict line must also be present and agree: a Results: line
    # on its own does not say WHICH file was executed.
    _cl_verdict=$(printf '%s\n' "$_cl_clean" | grep -F "SPEC FILE VERDICT: $_cl_spec" | tail -n 1)
    if [ -z "$_cl_verdict" ]; then
        echo "INCONCLUSIVE 0 0 0 0"
        return
    fi
    _cl_outcome=$(printf '%s\n' "$_cl_verdict" | sed -n 's/.*outcome=\([A-Za-z]*\).*/\1/p')

    if [ "$_cl_failed" != "0" ] || [ "$_cl_outcome" != "OK" ]; then
        echo "FAILED $_cl_total $_cl_passed $_cl_failed $_cl_skipped"
        return
    fi
    if [ "$_cl_total" = "0" ]; then
        # A file that executed nothing proves nothing.
        echo "INCONCLUSIVE 0 0 0 0"
        return
    fi
    echo "OK $_cl_total $_cl_passed $_cl_failed $_cl_skipped"
}

# --- selftest ---------------------------------------------------------------
ST_PASS=0
ST_FAIL=0
_st_ok()  { ST_PASS=$((ST_PASS + 1)); echo "  ok   - $1"; }
_st_ko()  { ST_FAIL=$((ST_FAIL + 1)); echo "  FAIL - $1"; }

# _st_case <name> <expected-status> <spec> <log-content>
_st_case() {
    _st_name=$1; _st_want=$2; _st_spec=$3; _st_body=$4
    printf '%s\n' "$_st_body" > "$ST_TMP/log.txt"
    _st_got=$(classify_log "$ST_TMP/log.txt" "$_st_spec" | cut -d' ' -f1)
    if [ "$_st_got" = "$_st_want" ]; then
        _st_ok "$_st_name (=> $_st_got)"
    else
        _st_ko "$_st_name (want $_st_want, got $_st_got)"
    fi
}

run_selftest() {
    ST_TMP=$(mktemp -d "${TMPDIR:-/tmp}/caret_acc_selftest.XXXXXX") || {
        echo "caret-acceptance selftest: FAIL — cannot create temp dir"; return 1; }
    SP="test/03_system/app/llm_caret/caret_agent_infra_acceptance_spec.spl"

    # (1) must-PASS: a clean run.
    _st_case "clean run classifies OK" OK "$SP" \
"SPEC FILE VERDICT: $SP outcome=OK declared>=3 executed=4 passed=4 failed=0 skipped=1 dropped=0
Results: 4 total, 4 passed, 0 failed, 1 skipped
PASS $SP"

    # (2) must-FAIL: a failing example.
    _st_case "failing example classifies FAILED" FAILED "$SP" \
"SPEC FILE VERDICT: $SP outcome=ERROR declared>=3 executed=4 passed=3 failed=1 skipped=0 dropped=0
Results: 4 total, 3 passed, 1 failed, 0 skipped
FAIL $SP"

    # (3) must-FAIL: aborted run, no Results: line at all (counts UNKNOWN).
    _st_case "no Results: line is INCONCLUSIVE" INCONCLUSIVE "$SP" \
"ABORTED BEFORE EXECUTION
some preflight gate refused"

    # (4) must-FAIL: the silent-green shape — warnings only, exit 0 upstream.
    _st_case "warnings-only log is INCONCLUSIVE" INCONCLUSIVE "$SP" \
"warning[RAW-RT-001]: something
warning[RAW-RT-001]: something else"

    # (5) must-PASS: ANSI-coloured verdict lines still parse.
    _st_case "ANSI-coloured clean run classifies OK" OK "$SP" \
"$(printf 'SPEC FILE VERDICT: %s outcome=\033[32mOK\033[0m declared>=3 executed=2 passed=2 failed=0 skipped=0 dropped=0\nResults: 2 total, \033[32m2 passed\033[0m, 0 failed, 0 skipped\n\033[32mPASS\033[0m %s' "$SP" "$SP")"

    # (6) must-FAIL: Results: says 0 failed but the per-file outcome is ERROR.
    _st_case "outcome=ERROR overrides a 0-failed Results line" FAILED "$SP" \
"SPEC FILE VERDICT: $SP outcome=ERROR declared>=3 executed=2 passed=2 failed=0 skipped=0 dropped=0
Results: 2 total, 2 passed, 0 failed, 0 skipped"

    # (7) must-FAIL: Results: present but for a DIFFERENT file (no verdict for ours).
    _st_case "verdict for another spec does not count" INCONCLUSIVE "$SP" \
"SPEC FILE VERDICT: test/01_unit/other_spec.spl outcome=OK declared>=1 executed=1 passed=1 failed=0 skipped=0 dropped=0
Results: 1 total, 1 passed, 0 failed, 0 skipped"

    # (8) must-FAIL: zero examples executed proves nothing.
    _st_case "zero-total run is INCONCLUSIVE" INCONCLUSIVE "$SP" \
"SPEC FILE VERDICT: $SP outcome=OK declared>=0 executed=0 passed=0 failed=0 skipped=0 dropped=0
Results: 0 total, 0 passed, 0 failed, 0 skipped"

    # (9) must-PASS: skipped (pending BLOCKED) rows do not make a run fail.
    _st_case "pending/skipped rows still classify OK" OK "$SP" \
"SPEC FILE VERDICT: $SP outcome=OK declared>=3 executed=3 passed=2 failed=0 skipped=1 dropped=0
Results: 3 total, 2 passed, 0 failed, 1 skipped"

    # (10) must-FAIL: a truncated Results line with no parsable counts.
    _st_case "malformed Results line is INCONCLUSIVE" INCONCLUSIVE "$SP" \
"Results: 4 total
SPEC FILE VERDICT: $SP outcome=OK executed=4"

    # (11) non-vacuity of the empty spec set: the caller must be forced to ERROR.
    _st_n=0
    for _s in $(printf ''); do _st_n=$((_st_n + 1)); done
    if [ "$_st_n" -eq 0 ]; then
        _st_ok "empty spec set yields 0 executed (caller must ERROR)"
    else
        _st_ko "empty spec set counted $_st_n"
    fi

    # (12) must-ERROR: a missing binary is detected, not tolerated.
    if [ ! -x "$ST_TMP/definitely-not-here" ]; then
        _st_ok "missing binary path is not executable (forces ERROR)"
    else
        _st_ko "missing binary path unexpectedly executable"
    fi

    # (13) bracket comparison detects a changed binary.
    printf 'aaa' > "$ST_TMP/b1"; printf 'bbb' > "$ST_TMP/b2"
    _h1=$(_identity "$ST_TMP/b1"); _h2=$(_identity "$ST_TMP/b2")
    if [ "$_h1" != "$_h2" ]; then
        _st_ok "identity bracket distinguishes two different binaries"
    else
        _st_ko "identity bracket failed to distinguish binaries"
    fi

    # (14) bracket comparison is stable for an unchanged binary.
    _h3=$(_identity "$ST_TMP/b1")
    if [ "$_h1" = "$_h3" ]; then
        _st_ok "identity bracket is stable across two reads"
    else
        _st_ko "identity bracket unstable for an unchanged binary"
    fi

    # (15) must-FAIL: a log naming the spec but with a FAIL banner and failures.
    _st_case "multi-block log takes the LAST Results line" FAILED "$SP" \
"Results: 2 total, 2 passed, 0 failed, 0 skipped
SPEC FILE VERDICT: $SP outcome=ERROR declared>=2 executed=2 passed=1 failed=1 skipped=0 dropped=0
Results: 2 total, 1 passed, 1 failed, 0 skipped"

    # (16) must-PASS: leading warning noise before a clean block is tolerated.
    _st_case "warning noise before a clean block still classifies OK" OK "$SP" \
"warning[RAW-RT-001]: noise
warning[RAW-RT-001]: more noise
SPEC FILE VERDICT: $SP outcome=OK declared>=1 executed=1 passed=1 failed=0 skipped=0 dropped=0
Results: 1 total, 1 passed, 0 failed, 0 skipped"

    rm -rf "$ST_TMP"
    if [ "$ST_FAIL" -eq 0 ]; then
        echo "caret-acceptance selftest: PASS — $ST_PASS fixture(s)"
        return 0
    fi
    echo "caret-acceptance selftest: FAIL — $ST_FAIL of $((ST_PASS + ST_FAIL)) fixture(s) failed"
    return 1
}

# Identity of the deployed binary: resolved path + byte size + sha256.
_identity() {
    _id_path=$1
    [ -e "$_id_path" ] || { echo "MISSING"; return; }
    _id_real=$(readlink -f "$_id_path" 2>/dev/null) || _id_real=$_id_path
    [ -e "$_id_real" ] || { echo "MISSING"; return; }
    _id_size=$(stat -c %s "$_id_real" 2>/dev/null || echo 0)
    _id_sha=$(sha256sum "$_id_real" 2>/dev/null | cut -d' ' -f1)
    echo "$_id_real $_id_size $_id_sha"
}

# --- selftest is fatal, on every invocation --------------------------------
if ! run_selftest; then
    echo "ERROR — nothing was checked (selftest failed)"
    exit 2
fi
if [ "$DO_SELFTEST_ONLY" -eq 1 ]; then
    exit 0
fi

# --- non-vacuity preconditions ---------------------------------------------
cd "$REPO_ROOT" || { echo "ERROR — nothing was checked (cannot cd to $REPO_ROOT)"; exit 2; }

IDENT_BEFORE=$(_identity "$SIMPLE_BIN")
if [ "$IDENT_BEFORE" = "MISSING" ]; then
    echo "ERROR — nothing was checked (simple binary not found at $SIMPLE_BIN)"
    exit 2
fi
if [ ! -x "$(readlink -f "$SIMPLE_BIN")" ]; then
    echo "ERROR — nothing was checked (simple binary at $SIMPLE_BIN is not executable)"
    exit 2
fi
BIN_SHA12=$(echo "$IDENT_BEFORE" | awk '{print substr($3,1,12)}')

LOG_DIR=$(mktemp -d "${TMPDIR:-/tmp}/caret_acceptance.XXXXXX") || {
    echo "ERROR — nothing was checked (cannot create log dir)"; exit 2; }

N_SPECS=0
N_EXAMPLES=0
N_SKIPPED_EXAMPLES=0
N_FAILED=0
FAILING=""
SKIPS=""
IDX=0

run_one() {
    _ro_spec=$1
    if [ ! -f "$_ro_spec" ]; then
        N_FAILED=$((N_FAILED + 1))
        FAILING="$FAILING $_ro_spec(missing)"
        return
    fi
    IDX=$((IDX + 1))
    _ro_log="$LOG_DIR/spec_$IDX.log"
    echo "--- [$IDX] $_ro_spec"
    SIMPLE_TIMEOUT_SECONDS=$SPEC_TIMEOUT timeout "$SPEC_TIMEOUT" \
        "$SIMPLE_BIN" test "$_ro_spec" --no-session-daemon --timeout "$INNER_TIMEOUT" \
        > "$_ro_log" 2>&1
    # The exit code is deliberately NOT read: it has been measured lying in both
    # directions. Classification comes from the log's authoritative lines only.
    set -- $(classify_log "$_ro_log" "$_ro_spec")
    _ro_status=$1; _ro_total=$2; _ro_passed=$3; _ro_failed=$4; _ro_skipped=$5
    N_SPECS=$((N_SPECS + 1))
    case "$_ro_status" in
        OK)
            N_EXAMPLES=$((N_EXAMPLES + _ro_total))
            N_SKIPPED_EXAMPLES=$((N_SKIPPED_EXAMPLES + _ro_skipped))
            echo "    OK — $_ro_total example(s), $_ro_passed passed, $_ro_skipped skipped"
            ;;
        FAILED)
            N_EXAMPLES=$((N_EXAMPLES + _ro_total))
            N_FAILED=$((N_FAILED + _ro_failed))
            FAILING="$FAILING $_ro_spec"
            echo "    FAILED — $_ro_failed of $_ro_total example(s) failed  (log: $_ro_log)"
            ;;
        *)
            # INCONCLUSIVE is never a pass.
            N_FAILED=$((N_FAILED + 1))
            FAILING="$FAILING $_ro_spec(inconclusive)"
            echo "    INCONCLUSIVE — no usable Results:/verdict line  (log: $_ro_log)"
            ;;
    esac
}

echo "caret acceptance gate — binary $IDENT_BEFORE"
echo "== unit specs =="
for s in $UNIT_SPECS; do run_one "$s"; done
echo "== system specs =="
for s in $SYSTEM_SPECS; do run_one "$s"; done
echo "== acceptance spec =="
run_one "$ACCEPTANCE_SPEC"

echo "== live infra wrapper =="
if command -v docker >/dev/null 2>&1; then
    LIVE_LOG="$LOG_DIR/live.log"
    sh scripts/check/check-llm-caret-infra-live.shs > "$LIVE_LOG" 2>&1
    LIVE_RC=$?
    LIVE_VERDICT=$(_strip_ansi "$LIVE_LOG" | grep -E '^(PASS|FAIL|ERROR|SKIP) ' | tail -n 1)
    if [ "$LIVE_RC" -eq 0 ]; then
        echo "    OK — live wrapper: ${LIVE_VERDICT:-exit 0}"
    else
        N_FAILED=$((N_FAILED + 1))
        FAILING="$FAILING check-llm-caret-infra-live.shs"
        echo "    FAILED — live wrapper rc=$LIVE_RC: ${LIVE_VERDICT:-no verdict line}  (log: $LIVE_LOG)"
    fi
else
    SKIPS="$SKIPS check-llm-caret-infra-live.shs(no-docker)"
    echo "    SKIP — docker not present on this host; live infra rows not exercised"
fi

# --- closing bracket --------------------------------------------------------
IDENT_AFTER=$(_identity "$SIMPLE_BIN")
if [ "$IDENT_AFTER" != "$IDENT_BEFORE" ]; then
    echo "ERROR — nothing was checked (binary changed mid-run: '$IDENT_BEFORE' -> '$IDENT_AFTER')"
    exit 2
fi

if [ "$N_SPECS" -eq 0 ]; then
    echo "ERROR — nothing was checked (0 specs executed)"
    exit 2
fi
if [ "$N_EXAMPLES" -eq 0 ]; then
    echo "ERROR — nothing was checked ($N_SPECS spec(s) ran but 0 examples executed)"
    exit 2
fi

SKIP_NOTE=""
[ -n "$SKIPS" ] && SKIP_NOTE=", skipped:$SKIPS"
[ "$N_SKIPPED_EXAMPLES" -gt 0 ] && SKIP_NOTE="$SKIP_NOTE, $N_SKIPPED_EXAMPLES example(s) pending/BLOCKED"

if [ "$N_FAILED" -ne 0 ]; then
    echo "FAIL — $N_SPECS spec(s), $N_EXAMPLES example(s), $N_FAILED failed (binary $BIN_SHA12)$SKIP_NOTE; failing:$FAILING"
    exit 1
fi
echo "PASS — $N_SPECS spec(s), $N_EXAMPLES example(s), 0 failed (binary $BIN_SHA12)$SKIP_NOTE"
exit 0
