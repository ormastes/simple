#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
"${CC:-cc}" -std=c11 -D_POSIX_C_SOURCE=200809L -O2 -Wall -Wextra -Werror \
    -pedantic -pthread "$root/src/runtime/runtime_hal_buffer_dispatch.c" \
    "$root/src/runtime/test/runtime_hal_buffer_dispatch_selfcheck.c" \
    -o "$work/selfcheck"
bin=$(ls "$work" | grep '^selfcheck' | head -n 1)
if [ -z "$bin" ]; then echo 'FAIL: selfcheck binary was not produced' >&2; exit 1; fi
bin="$work/$bin"
"${NM:-nm}" "$bin" | grep -q ' rt_hal_buffer_dispatch_compare_v3$'
"${NM:-nm}" "$bin" | grep -q ' rt_hal_buffer_dispatch_direct_v3$'
"${NM:-nm}" "$bin" | grep -q ' rt_hal_buffer_dispatch_configured_v3$'
"${NM:-nm}" "$bin" | grep -q ' rt_hal_buffer_access_consume_v3$'
"$bin"
printf '%s\n' 'STATUS: PASS runtime HAL buffer V3 link/owner/perf/RSS'
