#!/bin/sh
# Fail-closed UNO Q SimpleOS WM gate. Only the QRB2210 MPU may satisfy it.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
QRB_ENTRY="$ROOT_DIR/examples/09_embedded/simple_os/arch/qrb2210/gui_entry_desktop.spl"

if [ ! -f "$QRB_ENTRY" ]; then
    echo "unoq_wm_full_stack_status=fail"
    echo "unoq_wm_full_stack_target=qrb2210-uno-q"
    echo "unoq_wm_full_stack_reason=qrb2210-simpleos-port-unavailable"
    echo "unoq_wm_full_stack_stm32_desktop_accepted=false"
    exit 1
fi

if ! adb devices 2>/dev/null | awk 'NR > 1 && $2 == "device" { found=1 } END { exit !found }'; then
    echo "unoq_wm_full_stack_status=fail"
    echo "unoq_wm_full_stack_target=qrb2210-uno-q"
    echo "unoq_wm_full_stack_reason=qrb2210-board-not-connected"
    exit 1
fi

echo "unoq_wm_full_stack_status=fail"
echo "unoq_wm_full_stack_target=qrb2210-uno-q"
echo "unoq_wm_full_stack_reason=qrb2210-runtime-evidence-runner-unavailable"
exit 1
