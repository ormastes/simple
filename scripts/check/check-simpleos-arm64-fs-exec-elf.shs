#!/bin/sh
# Fail closed before the ARM64 filesystem-exec kernel reaches QEMU.
set -eu

fail() {
    echo "[arm64-fs-exec-elf] ERROR: $*" >&2
    exit 1
}

validate_header() {
    header=$1
    printf '%s\n' "$header" | grep -Eq 'Class:[[:space:]]+ELF64([[:space:]]|$)' \
        || fail "kernel is not ELF64"
    printf '%s\n' "$header" | grep -Eq 'Data:.*little endian' \
        || fail "kernel is not little-endian"
    printf '%s\n' "$header" | grep -Eq 'Type:[[:space:]]+EXEC([[:space:]]|$)' \
        || fail "kernel is not an executable ELF"
    printf '%s\n' "$header" | grep -Eq 'Machine:[[:space:]]+AArch64([[:space:]]|$)' \
        || fail "kernel is not AArch64"
    printf '%s\n' "$header" | awk '/Entry point address:/ { if ($4 != "0x0" && $4 != "0") ok = 1 } END { exit ok ? 0 : 1 }' \
        || fail "kernel entry point is missing or zero"
}

validate_program_headers() {
    program_headers=$1
    printf '%s\n' "$program_headers" | grep -Eq '^[[:space:]]*LOAD[[:space:]]' \
        || fail "kernel has no PT_LOAD segment"
    if printf '%s\n' "$program_headers" | grep -Eq '^[[:space:]]*INTERP[[:space:]]'; then
        fail "kernel has a PT_INTERP segment"
    fi
}

validate_symbols() {
    symbols=$1
    for required in rt_array_copy rt_enum_id; do
        printf '%s\n' "$symbols" | awk -v wanted="$required" '
$5 == "GLOBAL" && $7 != "UND" && $8 == wanted { found = 1 }
END { exit found ? 0 : 1 }
' || fail "kernel lacks strong definition: $required"
        if printf '%s\n' "$symbols" | awk -v wanted="$required" '
$5 == "WEAK" && $7 != "UND" && $8 == wanted { found = 1 }
END { exit found ? 0 : 1 }
'; then
            fail "kernel uses weak definition: $required"
        fi
    done
    printf '%s\n' "$symbols" | awk '
$5 == "GLOBAL" && $7 == "UND" { bad = 1 }
END { exit bad ? 1 : 0 }
' || fail "kernel contains a strong undefined symbol"
}

run_self_test() {
    linker=examples/09_embedded/simple_os/arch/arm64/fs_exec_linker.ld
    runner=src/os/_QemuRunner/os_build_run.spl
    grep -Eq '^[[:space:]]*_kernel_load_end[[:space:]]*=' "$linker" \
        || fail "fs-exec linker lacks the crt0 load boundary"
    grep -Eq '^[[:space:]]*_image_size[[:space:]]*=[[:space:]]*_kernel_end[[:space:]]*-[[:space:]]*_start' "$linker" \
        || fail "fs-exec linker lacks the Linux Image footprint"
    sed -n '/if _is_arm_fs_exec_target(target):/,+1p' "$runner" \
        | grep -Fq '"src/lib"' \
        || fail "canonical ARM fs-exec build omits src/lib"

    good_header='  Class:                             ELF64
  Data:                              2s complement, little endian
  Type:                              EXEC (Executable file)
  Machine:                           AArch64
  Entry point address:               0x40200000'
    good_programs='  LOAD 0x0 0x40200000 0x40200000 0x1000 0x2000 R E 0x1000'
    good_symbols='     1: 0000000040200100 16 FUNC GLOBAL DEFAULT 1 rt_array_copy
     2: 0000000040200120 16 FUNC GLOBAL DEFAULT 1 rt_enum_id'
    validate_header "$good_header"
    validate_program_headers "$good_programs"
    validate_symbols "$good_symbols"

    if (validate_header "$(printf '%s\n' "$good_header" | sed 's/AArch64/Advanced Micro Devices X86-64/')") >/dev/null 2>&1; then
        fail "self-test accepted a non-AArch64 header"
    fi
    if (validate_program_headers '  INTERP 0x0 0x0 0x0 0x1 0x1 R 0x1') >/dev/null 2>&1; then
        fail "self-test accepted PT_INTERP without PT_LOAD"
    fi
    if (validate_symbols '     1: 0000000040200100 16 FUNC WEAK DEFAULT 1 rt_array_copy
     2: 0000000040200120 16 FUNC GLOBAL DEFAULT 1 rt_enum_id') >/dev/null 2>&1; then
        fail "self-test accepted weak rt_array_copy"
    fi
    if (validate_symbols '     1: 0000000040200120 16 FUNC GLOBAL DEFAULT 1 rt_enum_id') >/dev/null 2>&1; then
        fail "self-test accepted missing rt_array_copy"
    fi
    echo "simpleos_arm64_fs_exec_elf_self_test=pass"
}

if [ "$#" -eq 1 ] && [ "$1" = "--self-test" ]; then
    run_self_test
    exit 0
fi
[ "$#" -eq 1 ] || fail "usage: $0 ELF | --self-test"
elf=$1
[ -s "$elf" ] || fail "kernel ELF is missing or empty: $elf"

READELF=${READELF:-}
if [ -z "$READELF" ]; then
    READELF=$(command -v llvm-readelf || command -v readelf || true)
fi
[ -n "$READELF" ] || fail "llvm-readelf or readelf is required"

header=$("$READELF" -W -h "$elf") || fail "cannot read kernel ELF header: $elf"
program_headers=$("$READELF" -W -l "$elf") || fail "cannot read kernel program headers: $elf"
symbols=$("$READELF" -W -s "$elf") || fail "cannot read kernel symbols: $elf"

validate_header "$header"
validate_program_headers "$program_headers"
validate_symbols "$symbols"
echo "[arm64-fs-exec-elf] PASS: $elf"
