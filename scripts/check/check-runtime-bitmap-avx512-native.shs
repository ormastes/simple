#!/bin/sh
# Historical filename retained for callers. Qualifies default C APIs/absence,
# not optional provider AVX512 execution or the Rust native-all authority.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cc=${CC:-clang}
if [ "${1:-}" != --worker ]; then
    [ "$#" -eq 0 ] || { echo "usage: $0" >&2; exit 2; }
    case "$(uname -s):$(uname -m)" in Linux:x86_64|Linux:amd64) ;; *) exit 77 ;; esac
    for tool in "$cc" nm objdump readelf perl mktemp; do
        command -v "$tool" >/dev/null 2>&1 || { echo "missing $tool" >&2; exit 2; }
    done
    build=$(mktemp -d "${TMPDIR:-/tmp}/simple-default-simd.XXXXXX")
    echo "artifacts=$build"
    exec perl "$root/scripts/resource/process-tree-rss-watchdog.pl" \
        --timeout-seconds=180 --max-rss-kib=1000000 --rss-cap-mode=enforce \
        --receipt="$build/watchdog.env" -- sh "$0" --worker "$build"
fi
[ "$#" -eq 2 ] && [ -d "$2" ] || exit 2
build=$2
"$cc" --version > "$build/compiler.txt"
# All changed public APIs are used by the harness. Object-level absence is
# checked independently of the executable's garbage-collected unused sections.
for owner in runtime_native runtime_simd_dispatch; do
    "$cc" -std=gnu11 -O2 -g1 -march=x86-64 -ffunction-sections -fdata-sections \
        -DSIMPLE_CORE_C_STANDALONE=1 -I"$root/src/runtime" \
        -c "$root/src/runtime/$owner.c" -o "$build/$owner.o"
done
"$cc" -std=gnu11 -O2 -march=x86-64 -I"$root/src/runtime" \
    "$root/src/runtime/test/rt_db_bitmap_avx512_selfcheck.c" \
    "$build/runtime_native.o" "$build/runtime_simd_dispatch.o" \
    -Wl,--gc-sections -lpthread -ldl -lm -o "$build/public"
nm -S "$build/runtime_simd_dispatch.o" > "$build/dispatch.symbols"
objdump -d "$build/runtime_simd_dispatch.o" > "$build/dispatch.disasm"
if grep -E 'db_bitmap_and_avx512|blend_mask_span_avx512|blend_cov_span_avx512' "$build/dispatch.symbols" ||
   grep -E '(%zmm|%k[0-7])' "$build/dispatch.disasm"; then
    echo 'FAIL: embedded optional AVX512 in default C owner' >&2; exit 1
fi
grep -q db_bitmap_and_avx2 "$build/dispatch.symbols"
readelf -lW "$build/public" > "$build/public.segments"
readelf -SW "$build/public" > "$build/public.sections"
"$build/public" > "$build/public.log"
cat "$build/public.log"
sha256sum "$root/src/runtime/runtime_simd_dispatch.c" \
    "$root/src/runtime/runtime_native.c" \
    "$root/src/runtime/test/rt_db_bitmap_avx512_selfcheck.c" > "$build/sources.sha256"
sha256sum "$build/public" "$build/runtime_simd_dispatch.o" > "$build/artifacts.sha256"
echo 'PASS default_c_avx512_absent=1 avx2_retained=1'