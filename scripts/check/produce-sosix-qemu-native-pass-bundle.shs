#!/bin/sh
# Produce one immutable, collector-ready native SOSIX QEMU PASS bundle.
set -eu

usage() {
    echo 'usage: produce-sosix-qemu-native-pass-bundle.shs --host HOST --guest GUEST --output ROOT --admission FILE --qemu-binary PATH --qemu-argv-file FILE --qemu-version-file FILE --accelerator NAME --firmware FILE --firmware-id ID --firmware-mode MODE --firmware-version VERSION --firmware-stages STAGES --boot-correlation-marker MARKER --kernel FILE --image FILE --program FILE --transcript FILE --required-markers-file FILE --nonce NONCE --owner NAME --reviewer NAME --compiler-identity ID --compiler-in-filesystem true|false [--compiler-version-evidence FILE --compiler-hello-evidence FILE --compiler-alias-evidence FILE --compiler-manifest-evidence FILE] [--compiler-designation-fixture HOST:GUEST] [--source DIR]' >&2
    exit 64
}

host= guest= output= admission= qemu_binary= qemu_argv_file= qemu_version_file=
accelerator= firmware= firmware_id= firmware_mode= firmware_version= firmware_stages= boot_correlation_marker=
kernel= image= program= transcript= required_markers_file= nonce= owner= reviewer= compiler_identity= source=
compiler_in_filesystem= compiler_version_evidence= compiler_hello_evidence= compiler_alias_evidence= compiler_manifest_evidence= compiler_designation_fixture=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --host) host=$2; shift 2;; --guest) guest=$2; shift 2;; --output) output=$2; shift 2;;
        --admission) admission=$2; shift 2;; --qemu-binary) qemu_binary=$2; shift 2;;
        --qemu-argv-file) qemu_argv_file=$2; shift 2;; --qemu-version-file) qemu_version_file=$2; shift 2;;
        --accelerator) accelerator=$2; shift 2;; --firmware) firmware=$2; shift 2;;
        --firmware-id) firmware_id=$2; shift 2;; --firmware-mode) firmware_mode=$2; shift 2;;
        --firmware-version) firmware_version=$2; shift 2;; --firmware-stages) firmware_stages=$2; shift 2;;
        --boot-correlation-marker) boot_correlation_marker=$2; shift 2;;
        --kernel) kernel=$2; shift 2;; --image) image=$2; shift 2;; --program) program=$2; shift 2;;
        --transcript) transcript=$2; shift 2;; --required-markers-file) required_markers_file=$2; shift 2;; --nonce) nonce=$2; shift 2;;
        --owner) owner=$2; shift 2;; --reviewer) reviewer=$2; shift 2;;
        --compiler-identity) compiler_identity=$2; shift 2;; --source) source=$2; shift 2;;
        --compiler-in-filesystem) compiler_in_filesystem=$2; shift 2;;
        --compiler-version-evidence) compiler_version_evidence=$2; shift 2;;
        --compiler-hello-evidence) compiler_hello_evidence=$2; shift 2;;
        --compiler-alias-evidence) compiler_alias_evidence=$2; shift 2;;
        --compiler-manifest-evidence) compiler_manifest_evidence=$2; shift 2;;
        --compiler-designation-fixture) compiler_designation_fixture=$2; shift 2;;
        *) usage;;
    esac
done
for required in host guest output admission qemu_binary qemu_argv_file qemu_version_file accelerator firmware firmware_id firmware_mode firmware_version firmware_stages boot_correlation_marker kernel image program transcript required_markers_file nonce owner reviewer compiler_identity compiler_in_filesystem; do
    eval "value=\${$required}"
    [ -n "$value" ] || usage
done
case "$host" in linux|windows|macos|freebsd) ;; *) usage;; esac
case "$guest" in x86_32|x86_64|arm32|arm64|riscv32|riscv64) ;; *) usage;; esac
case "$compiler_in_filesystem" in
    true)
        [ -n "$compiler_version_evidence" ] && [ -n "$compiler_hello_evidence" ] &&
        [ -n "$compiler_alias_evidence" ] && [ -n "$compiler_manifest_evidence" ] || {
            echo 'sosix-native-pass: designated compiler row requires version, hello, alias, and manifest evidence files' >&2; exit 2;
        }
        ;;
    false)
        [ -z "$compiler_version_evidence" ] && [ -z "$compiler_hello_evidence" ] &&
        [ -z "$compiler_alias_evidence" ] && [ -z "$compiler_manifest_evidence" ] || {
            echo 'sosix-native-pass: non-designated row carries compiler evidence' >&2; exit 2;
        }
        ;;
    *) usage;;
esac
case "$firmware_mode:$firmware_stages" in
    'uefi-pflash:firmware-entry>firmware-handoff>guest-entry'|\
    'opensbi-bios:opensbi-entry>opensbi-handoff>guest-entry'|\
    'board-rom:rom-entry>rom-handoff>guest-entry') ;;
    *) echo 'sosix-native-pass: firmware stages do not match mode' >&2; exit 2;;
esac
printf '%s\n' "$nonce" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{15,127}$' || { echo 'sosix-native-pass: unsafe nonce' >&2; exit 2; }
printf '%s\n' "$boot_correlation_marker" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$' || {
    echo 'sosix-native-pass: unsafe boot-correlation marker' >&2; exit 2;
}
[ "$boot_correlation_marker" != "$nonce" ] || {
    echo 'sosix-native-pass: boot-correlation marker must be distinct from execution nonce' >&2; exit 2;
}
printf '%s\n' "$firmware_id" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._+-]*$' || { echo 'sosix-native-pass: invalid firmware id' >&2; exit 2; }
printf '%s\n' "$firmware_version" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._+-]*$' || { echo 'sosix-native-pass: invalid firmware version' >&2; exit 2; }

script_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
repo_root=$(CDPATH= cd -- "${source:-$script_root}" && pwd)
. "$script_root/scripts/check/lib/sosix-qemu-firmware-transcript.shs"
. "$script_root/scripts/check/lib/sosix-qemu-compiler-placement.shs"
SOSIX_QEMU_COMPILER_DESIGNATION_POLICY=$script_root/scripts/check/lib/sosix-qemu-compiler-designation-v1.tsv
export SOSIX_QEMU_COMPILER_DESIGNATION_POLICY
. "$script_root/scripts/check/lib/sosix-qemu-compiler-designation.shs"
if ! sosix_qemu_compiler_designation_accepts "$host" "$guest" \
    "$compiler_in_filesystem" "$compiler_designation_fixture"; then
    echo "sosix-native-pass: compiler designation is not canonical for $host/$guest" >&2
    exit 2
fi
case "$output" in /*) ;; *) output=$PWD/$output;; esac
hash_file() { sha256sum "$1" | awk '{print $1}'; }
reject_symlink() {
    [ ! -L "$1" ] || { echo "sosix-native-pass: symlink evidence is not allowed: $1" >&2; exit 2; }
}
inode_key() { stat -Lc '%d:%i' "$1"; }
field() {
    key=$1 file=$2
    count=$(awk -F= -v k="$key" '$1 == k { n++ } END { print n+0 }' "$file")
    [ "$count" -eq 1 ] || { echo "sosix-native-pass: $file: field $key occurs $count times" >&2; exit 2; }
    awk -F= -v k="$key" '$1 == k { print substr($0,index($0,"=")+1) }' "$file"
}
for file in "$admission" "$qemu_argv_file" "$qemu_version_file" "$firmware" "$kernel" "$image" "$program" "$transcript" "$required_markers_file"; do
    [ -f "$file" ] || { echo "sosix-native-pass: missing input: $file" >&2; exit 2; }
done
if [ "$compiler_in_filesystem" = true ]; then
    [ -f "$compiler_version_evidence" ] || { echo "sosix-native-pass: missing input: $compiler_version_evidence" >&2; exit 2; }
    [ -f "$compiler_hello_evidence" ] || { echo "sosix-native-pass: missing input: $compiler_hello_evidence" >&2; exit 2; }
    [ -f "$compiler_alias_evidence" ] || { echo "sosix-native-pass: missing input: $compiler_alias_evidence" >&2; exit 2; }
    [ -f "$compiler_manifest_evidence" ] || { echo "sosix-native-pass: missing input: $compiler_manifest_evidence" >&2; exit 2; }
    [ -s "$compiler_version_evidence" ] && [ -s "$compiler_hello_evidence" ] || { echo 'sosix-native-pass: compiler evidence must be non-empty' >&2; exit 2; }
    reject_symlink "$compiler_version_evidence"
    reject_symlink "$compiler_hello_evidence"
    version_source=$(CDPATH= cd -- "$(dirname -- "$compiler_version_evidence")" && pwd)/$(basename -- "$compiler_version_evidence")
    hello_source=$(CDPATH= cd -- "$(dirname -- "$compiler_hello_evidence")" && pwd)/$(basename -- "$compiler_hello_evidence")
    [ "$version_source" != "$hello_source" ] || { echo 'sosix-native-pass: compiler evidence inputs must be distinct' >&2; exit 2; }
    [ "$(inode_key "$compiler_version_evidence")" != "$(inode_key "$compiler_hello_evidence")" ] || {
        echo 'sosix-native-pass: compiler evidence inputs must not be hard-link aliases' >&2; exit 2;
    }
    compiler_version_source_hash=$(hash_file "$compiler_version_evidence")
    compiler_hello_source_hash=$(hash_file "$compiler_hello_evidence")
    [ -s "$compiler_alias_evidence" ] && [ -s "$compiler_manifest_evidence" ] || {
        echo 'sosix-native-pass: compiler alias/manifest evidence must be non-empty' >&2; exit 2;
    }
    reject_symlink "$compiler_alias_evidence"
    reject_symlink "$compiler_manifest_evidence"
    compiler_alias_source_hash=$(hash_file "$compiler_alias_evidence")
    compiler_manifest_source_hash=$(hash_file "$compiler_manifest_evidence")
fi

# Admission is a closed record produced before the guest run.
awk -F= '
    /^[A-Za-z0-9_]+=/ {
      if ($1=="detected_host" || $1=="requested_host" || $1=="host_identity_status" ||
          $1=="host_identity_reason" || $1=="qemu_binary" || $1=="qemu_binary_resolved" ||
          $1=="qemu_sha256" || $1=="qemu_version" || $1=="requested_accelerator" ||
          $1=="accelerator_advertised_status" || $1=="accelerator_advertised_reason" ||
          $1=="accelerator_probe_status" || $1=="accelerator_probe_reason" ||
          $1=="native_timing_applicable" || $1=="simple_qemu_storage_root") next
    } { bad=1 } END { exit bad }
' "$admission" || { echo 'sosix-native-pass: malformed or open admission record' >&2; exit 2; }
[ "$(field detected_host "$admission")" = "$host" ]
[ "$(field requested_host "$admission")" = "$host" ]
[ "$(field host_identity_status "$admission")" = pass ]
[ "$(field accelerator_advertised_status "$admission")" = pass ]
[ "$(field accelerator_probe_status "$admission")" = pass ]
[ "$(field qemu_binary "$admission")" = "$qemu_binary" ]
[ "$(field requested_accelerator "$admission")" = "$accelerator" ]
if [ -x "$qemu_binary" ]; then
    qemu_resolved=$(CDPATH= cd -- "$(dirname -- "$qemu_binary")" && pwd)/$(basename -- "$qemu_binary")
else
    qemu_resolved=$(command -v "$qemu_binary")
fi
[ "$(field qemu_binary_resolved "$admission")" = "$qemu_resolved" ]
[ "$(field qemu_sha256 "$admission")" = "$(hash_file "$qemu_resolved")" ]
[ "$(field qemu_version "$admission")" = "$(sed -n '1p' "$qemu_version_file")" ]

git -C "$repo_root" diff --quiet --ignore-submodules -- &&
git -C "$repo_root" diff --cached --quiet --ignore-submodules -- &&
[ -z "$(git -C "$repo_root" ls-files --others --exclude-standard)" ] || {
    echo 'sosix-native-pass: source worktree is not clean' >&2; exit 2;
}
commit=$(git -C "$repo_root" rev-parse HEAD)
tree=$(git -C "$repo_root" rev-parse 'HEAD^{tree}')
printf '%s\n' "$commit" | grep -Eq '^[0-9a-f]{40,64}$'
printf '%s\n' "$tree" | grep -Eq '^[0-9a-f]{40,64}$'

[ "$(wc -l < "$qemu_argv_file" | tr -d ' ')" -eq 1 ] || { echo 'sosix-native-pass: qemu argv must be exactly one line' >&2; exit 2; }
[ "$(wc -l < "$qemu_version_file" | tr -d ' ')" -eq 1 ] || { echo 'sosix-native-pass: qemu version must be exactly one line' >&2; exit 2; }
qemu_argv=$(sed -n '1p' "$qemu_argv_file")
qemu_version=$(sed -n '1p' "$qemu_version_file")
[ -n "$qemu_argv" ] && [ -n "$qemu_version" ]
sosix_qemu_validate_firmware_transcript "$firmware_mode" "$firmware_stages" "$boot_correlation_marker" "$nonce" "$transcript" || exit 2
[ -s "$required_markers_file" ] || { echo 'sosix-native-pass: empty required marker contract' >&2; exit 2; }
previous=0
while IFS= read -r marker || [ -n "$marker" ]; do
    [ -n "$marker" ] || { echo 'sosix-native-pass: empty required marker' >&2; exit 2; }
    line=$(grep -Fn -m1 -- "$marker" "$transcript" | cut -d: -f1 || true)
    [ -n "$line" ] && [ "$line" -gt "$previous" ] || { echo "sosix-native-pass: missing or out-of-order required marker: $marker" >&2; exit 2; }
    previous=$line
done < "$required_markers_file"

run_dir=$output/$host/$guest/run-$nonce
[ ! -e "$run_dir" ] || { echo "sosix-native-pass: destination exists: $run_dir" >&2; exit 2; }
stage=$(mktemp -d "${TMPDIR:-/tmp}/sosix-native-pass.XXXXXX")
trap 'rm -rf "$stage"' EXIT HUP INT TERM
cp "$admission" "$stage/host-admission.env"
cp "$qemu_argv_file" "$stage/qemu.argv"
cp "$qemu_version_file" "$stage/qemu.version"
cp "$transcript" "$stage/transcript.log"
cp "$kernel" "$stage/kernel.elf"
cp "$image" "$stage/guest.img"
cp "$program" "$stage/program.elf"
cp "$firmware" "$stage/firmware.bin"
cp "$required_markers_file" "$stage/required-markers.txt"
if [ "$compiler_in_filesystem" = true ]; then
    if [ "${SOSIX_QEMU_TEST_MODE:-}" = 1 ] && [ "${SOSIX_QEMU_TEST_MUTATE_COMPILER_BEFORE_COPY:-}" = true ]; then
        printf '%s\n' 'deterministic-mid-copy-mutation' >> "$compiler_version_evidence"
    fi
    cp "$compiler_version_evidence" "$stage/compiler-version.txt"
    cp "$compiler_hello_evidence" "$stage/compiler-hello.txt"
    cp "$compiler_alias_evidence" "$stage/compiler-aliases.txt"
    cp "$compiler_manifest_evidence" "$stage/compiler-manifest.env"
    [ "$(hash_file "$compiler_version_evidence")" = "$compiler_version_source_hash" ] &&
    [ "$(hash_file "$compiler_hello_evidence")" = "$compiler_hello_source_hash" ] &&
    [ "$(hash_file "$stage/compiler-version.txt")" = "$compiler_version_source_hash" ] &&
    [ "$(hash_file "$stage/compiler-hello.txt")" = "$compiler_hello_source_hash" ] &&
    [ "$(hash_file "$compiler_alias_evidence")" = "$compiler_alias_source_hash" ] &&
    [ "$(hash_file "$compiler_manifest_evidence")" = "$compiler_manifest_source_hash" ] &&
    [ "$(hash_file "$stage/compiler-aliases.txt")" = "$compiler_alias_source_hash" ] &&
    [ "$(hash_file "$stage/compiler-manifest.env")" = "$compiler_manifest_source_hash" ] || {
        echo 'sosix-native-pass: compiler evidence changed during snapshot' >&2; exit 2;
    }
fi
transcript_hash=$(hash_file "$stage/transcript.log")
kernel_hash=$(hash_file "$stage/kernel.elf")
image_hash=$(hash_file "$stage/guest.img")
program_hash=$(hash_file "$stage/program.elf")
firmware_hash=$(hash_file "$stage/firmware.bin")
qemu_hash=$(hash_file "$qemu_resolved")
if [ "$compiler_in_filesystem" = true ]; then
    sosix_qemu_validate_compiler_placement "$host" "$guest" "$nonce" \
        "sha256:$image_hash" "git:$commit:tree:$tree:clean" \
        "$stage/compiler-aliases.txt" "$stage/compiler-manifest.env" "$stage/transcript.log" || exit 2
    expected_compiler_identity="target-native-simple:payload=$SOSIX_QEMU_COMPILER_PAYLOAD_IDENTITY:image=sha256:$image_hash:alias=$SOSIX_QEMU_COMPILER_PLACEMENT_IDENTITY:manifest=$SOSIX_QEMU_COMPILER_MANIFEST_IDENTITY"
    [ "$compiler_identity" = "$expected_compiler_identity" ] || {
        echo 'sosix-native-pass: compiler identity is not bound to target-native payload/image/alias/manifest lineage' >&2; exit 2;
    }
fi
{
    echo schema_version=1; echo "host=$host"; echo "guest=$guest"; echo status=pass; echo reason=
    echo "owner=$owner"; echo "reviewer=$reviewer"; echo resume_command=
    echo "source_identity=git:$commit:tree:$tree:clean"; echo "compiler_identity=$compiler_identity"
    if [ "$compiler_in_filesystem" = true ]; then echo 'compiler_identity_scope=target-filesystem'; else echo 'compiler_identity_scope=source-toolchain'; fi
    echo "compiler_policy_sha256=$(hash_file "$SOSIX_QEMU_COMPILER_DESIGNATION_POLICY")"
    echo "compiler_policy_value=$(sosix_qemu_compiler_designation_live "$host" "$guest")"
    echo "kernel_identity=sha256:$kernel_hash"; echo "image_identity=sha256:$image_hash"
    echo "qemu_identity=sha256:$qemu_hash:version:$qemu_version"; echo "qemu_argv=$qemu_argv"
    echo "accelerator_identity=$accelerator"; echo "firmware_identity=firmware:$firmware_id"
    echo "firmware_mode=$firmware_mode"; echo "firmware_path=$(CDPATH= cd -- "$(dirname -- "$firmware")" && pwd)/$(basename -- "$firmware")"
    echo "firmware_version=version:$firmware_version"; echo "firmware_sha256=sha256:$firmware_hash"
    echo "firmware_stage_markers=$firmware_stages"; echo "boot_correlation_marker=$boot_correlation_marker"; echo "run_nonce=$nonce"
    echo "transcript_identity=sha256:$transcript_hash"; echo "program_identity=sha256:$program_hash"
    if [ "$compiler_in_filesystem" = true ]; then
        echo "compiler_payload_identity=$SOSIX_QEMU_COMPILER_PAYLOAD_IDENTITY"
        echo "compiler_image_identity=sha256:$image_hash"
        echo "compiler_alias_identity=$SOSIX_QEMU_COMPILER_PLACEMENT_IDENTITY"
        echo "compiler_manifest_identity=$SOSIX_QEMU_COMPILER_MANIFEST_IDENTITY"
    else
        echo 'compiler_payload_identity='; echo 'compiler_image_identity='; echo 'compiler_alias_identity='; echo 'compiler_manifest_identity='
    fi
    echo "compiler_in_filesystem=$compiler_in_filesystem"
    if [ -n "$compiler_designation_fixture" ]; then
        echo 'compiler_designation_scope=contract-fixture'
    else
        echo 'compiler_designation_scope=live-policy'
    fi
    if [ "$compiler_in_filesystem" = true ]; then
        echo compiler_version_evidence_path=compiler-version.txt; echo compiler_hello_evidence_path=compiler-hello.txt
        echo compiler_alias_evidence_path=compiler-aliases.txt; echo compiler_manifest_evidence_path=compiler-manifest.env
        echo artifact_count=13
    else
        echo compiler_version_evidence_path=; echo compiler_hello_evidence_path=; echo compiler_alias_evidence_path=; echo compiler_manifest_evidence_path=
        echo artifact_count=9
    fi
    i=1
    for name in host-admission.env qemu.argv qemu.version transcript.log kernel.elf guest.img program.elf firmware.bin required-markers.txt; do
        echo "artifact_${i}_path=$name"; echo "artifact_${i}_sha256=$(hash_file "$stage/$name")"; i=$((i + 1))
    done
    if [ "$compiler_in_filesystem" = true ]; then
        for name in compiler-version.txt compiler-hello.txt compiler-aliases.txt compiler-manifest.env; do
            echo "artifact_${i}_path=$name"; echo "artifact_${i}_sha256=$(hash_file "$stage/$name")"; i=$((i + 1))
        done
    fi
} > "$stage/evidence.env"
mkdir -p "$(dirname -- "$run_dir")"
mv "$stage" "$run_dir"
trap - EXIT HUP INT TERM
echo sosix_qemu_native_pass_bundle_status=pass
echo "sosix_qemu_native_pass_bundle=$run_dir/evidence.env"
