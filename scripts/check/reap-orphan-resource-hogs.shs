#!/bin/sh
# Reap orphaned resource hogs — CPU, RAM, storage.
#
# Standalone watchdog, NOT a pre-push guard. It never blocks a push, never
# mutates refs, and never touches another session's live work.
#
# Why it exists: on 2026-08-24 an orphaned `net.bin` fleet reached 61,838
# processes and load 19,272 on 32 cores. Every process had ppid=1 — its parent
# had already timed out and gone — so nothing owned them and nothing was ever
# going to clean them up. The box was found by a human noticing it was slow.
# See doc/08_tracking/bug/engine_probe_self_exe_fork_bomb_2026-08-24.md
#
#   sh scripts/check/reap-orphan-resource-hogs.shs            # report only
#   sh scripts/check/reap-orphan-resource-hogs.shs --kill     # report and reap
#   sh scripts/check/reap-orphan-resource-hogs.shs --watch 300 [--kill]
#   sh scripts/check/reap-orphan-resource-hogs.shs --selftest
#
# WHAT IT WILL NEVER TOUCH, per .claude/memory never-kill-others-work:
#   - anything not owned by the current user
#   - claude, codex, node, and their descendants (agent sessions)
#   - any process with a LIVE parent (ppid != 1) — that has an owner, and an
#     owner may be mid-bootstrap; only genuinely abandoned work is reapable
#   - the MCP/LSP servers and nginx the environment depends on
#   - anything under a deploy lock (see DEPLOY_LOCKS below)
#
# Verdict is the last line of stdout:
#   PASS — <n> process(es) examined, 0 orphaned hog(s)     exit 0
#   FAIL — <n> examined, <k> orphaned hog(s) [reaped]      exit 1
#   ERROR — nothing was checked (<reason>)                 exit 2
set -u

MODE=report
INTERVAL=0
SELFTEST=0
while [ $# -gt 0 ]; do
    case "$1" in
        --kill)     MODE=kill ;;
        --watch)    INTERVAL=${2:-300}; shift ;;
        --selftest) SELFTEST=1 ;;
        *) echo "ERROR — nothing was checked (unknown argument: $1)"; exit 2 ;;
    esac
    shift
done

# --- thresholds ---------------------------------------------------------------
# Deliberately generous. A false reap costs someone their work; a missed reap
# costs one more watchdog cycle. Asymmetric, so err high.
CPU_SECONDS_MIN=600         # >10 min of accumulated CPU while orphaned
RSS_KB_MIN=$((4 * 1024 * 1024))   # >4 GB resident while orphaned
CLONE_COUNT_MIN=50          # >50 orphaned siblings sharing one comm = a fleet
DISK_FREE_PCT_MIN=5         # storage: alert under 5% free

# Never-touch list. Substring match on comm.
PROTECTED='claude node codex nginx sshd systemd simple_mcp_serv simple_lsp_mcp_ ssh-agent dbus tmux screen bash sh zsh adb docker containerd gpg agent pipewire pulse dconf xdg gvfs at-spi'
# A process holding one of these open is mid-deploy. Leave it alone.
DEPLOY_LOCKS='/mnt/data/.seed-build-guard-green .simple/bootstrap.lock'

EXAMINED=0
HOGS=""
REAPED=0

# PREFIX match, not exact. A kernel comm is truncated to 15 chars and may be
# decorated: tmux's is "tmux: server" (spaces collapsed to "tmux:_server" by
# read_proc), which an exact match on "tmux" misses. The selftest caught this
# by flagging the user's own tmux server, 3.5 days of CPU, as reapable.
is_protected() {
    c=$1
    for p in $PROTECTED; do
        case "$c" in "$p"*) return 0 ;; esac
    done
    return 1
}

# A deploy in flight makes every reap unsafe: bootstrap stages legitimately
# reparent and legitimately burn CPU for a long time.
deploy_in_flight() {
    for l in $DEPLOY_LOCKS; do
        [ -e "$l" ] && [ -n "$(find "$l" -mmin -30 2>/dev/null)" ] && return 0
    done
    return 1
}

# Read one process's facts from /proc. Sets: P_COMM P_PPID P_CPU P_RSS P_UID
# Returns 1 if the process vanished mid-read, which is normal and not an error.
read_proc() {
    d=$1
    [ -r "$d/stat" ] || return 1
    read -r P_COMM < "$d/comm" 2>/dev/null || return 1
    # A comm may contain spaces ("adb server"), which would split every
    # whitespace-delimited record below. Collapse it once, here.
    P_COMM=$(printf %s "$P_COMM" | tr " \t" "__")
    # /proc/PID/stat field 2 is comm and may contain spaces, so parse after ')'.
    line=$(cat "$d/stat" 2>/dev/null) || return 1
    rest=${line#*) }
    # rest starts at field 3 (state). ppid=4, utime=14, stime=15, rss=24.
    P_PPID=$(echo "$rest" | awk '{print $2}')
    ut=$(echo "$rest" | awk '{print $12}')
    st=$(echo "$rest" | awk '{print $13}')
    [ -n "${P_PPID:-}" ] && [ -n "${ut:-}" ] || return 1
    hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
    P_CPU=$(( (ut + st) / hz ))
    P_RSS=$(awk '/^VmRSS:/{print $2}' "$d/status" 2>/dev/null)
    [ -n "${P_RSS:-}" ] || P_RSS=0
    P_UID=$(awk '/^Uid:/{print $2}' "$d/status" 2>/dev/null)
    return 0
}

scan() {
    EXAMINED=0
    HOGS=""
    REAPED=0
    NOTED=0
    me=$(id -u)

    if deploy_in_flight; then
        echo "  skip  a deploy is in flight (lock touched <30min ago) — not reaping"
        MODE=report
    fi

    # Pass 1: census. Orphan clone-fleets are the signal that mattered most in
    # the incident — no single member looked expensive, there were just 61,838.
    fleet_file=$(mktemp) || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
    cand_file=$(mktemp) || { rm -f "$fleet_file"; echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }

    for d in /proc/[0-9]*; do
        read_proc "$d" || continue
        EXAMINED=$((EXAMINED + 1))
        [ "${P_UID:-}" = "$me" ] || continue          # only our own processes
        [ "$P_PPID" = "1" ] || continue               # only genuine orphans
        is_protected "$P_COMM" && continue
        echo "$P_COMM" >> "$fleet_file"
        echo "${d#/proc/} $P_COMM $P_CPU $P_RSS" >> "$cand_file"
    done

    if [ "$EXAMINED" -eq 0 ]; then
        rm -f "$fleet_file" "$cand_file"
        echo "ERROR — nothing was checked (no readable processes in /proc)"
        return 2
    fi

    # Pass 2: classify.
    while read -r pid comm cpu rss; do
        [ -n "${pid:-}" ] || continue
        n=$(grep -c "^$comm$" "$fleet_file" 2>/dev/null); [ -n "$n" ] || n=0
        why=""
        reapable=0
        # Only a FLEET is reapable. High CPU or RSS on a single ppid=1 process
        # is what a DAEMON looks like -- adb, tmux, a language server -- and the
        # selftest proved that: it flagged the user's own tmux server at 3.5
        # days of CPU. Those are reported so a human can look, never killed.
        # The incident's real signature was multiplicity: 61,838 clones of one
        # comm, none individually expensive.
        if [ "$n" -ge "$CLONE_COUNT_MIN" ]; then
            why="orphan fleet of $n"; reapable=1
        fi
        [ "$cpu" -ge "$CPU_SECONDS_MIN" ]    && why="${why:+$why, }${cpu}s CPU"
        [ "$rss" -ge "$RSS_KB_MIN" ]         && why="${why:+$why, }$((rss / 1024))MB RSS"
        [ -n "$why" ] || continue

        if [ "$reapable" -eq 1 ]; then
            HOGS="$HOGS $comm/$pid"
            echo "  hog   pid=$pid comm=$comm ($why)"
            if [ "$MODE" = kill ]; then
                kill -9 "$pid" 2>/dev/null && REAPED=$((REAPED + 1))
            fi
        else
            NOTED=$((NOTED + 1))
            echo "  note  pid=$pid comm=$comm ($why) — single orphan, reported only"
        fi
    done < "$cand_file"

    rm -f "$fleet_file" "$cand_file"

    # Storage: report only. Deleting files is never safe to automate here —
    # a build cache mid-write looks exactly like garbage.
    df -P /mnt/data / 2>/dev/null | awk 'NR>1 {
        used = $5; gsub("%","",used); free = 100 - used
        if (free < '"$DISK_FREE_PCT_MIN"') printf "  disk  %s only %d%% free (%s)\n", $6, free, $1
        else printf "  ok    %s %d%% free\n", $6, free
    }'

    if [ -z "$HOGS" ]; then
        echo "PASS — $EXAMINED process(es) examined, 0 orphaned hog(s)${NOTED:+ ($NOTED single orphan(s) noted, not reapable)}"
        return 0
    fi
    if [ "$MODE" = kill ]; then
        echo "FAIL — $EXAMINED examined, orphaned hog(s):$HOGS ($REAPED reaped)"
    else
        echo "FAIL — $EXAMINED examined, orphaned hog(s):$HOGS (report only, pass --kill to reap)"
    fi
    return 1
}

# --- selftest -----------------------------------------------------------------
# Fatal and runs first when asked. Proves the classifier discriminates, and —
# the part that actually matters — that the protections hold.
if [ "$SELFTEST" -eq 1 ]; then
    echo "selftest"
    f=0

    is_protected claude   && echo "  ok    claude is protected"          || { echo "  FAIL  claude not protected"; f=1; }
    is_protected codex    && echo "  ok    codex is protected"           || { echo "  FAIL  codex not protected"; f=1; }
    is_protected net.bin  && { echo "  FAIL  net.bin wrongly protected"; f=1; } || echo "  ok    net.bin is reapable"
    # Regression pins for two defects this selftest found in its own scanner:
    is_protected tmux:_server && echo "  ok    a decorated comm (tmux:_server) is protected by prefix" \
        || { echo "  FAIL  prefix protection lost — would reap the user's tmux"; f=1; }
    is_protected adb          && echo "  ok    adb (a ppid=1 daemon by design) is protected" \
        || { echo "  FAIL  adb not protected"; f=1; }
    printf 'x y\tz' | tr " \t" "__" | grep -q '^x_y_z$' && echo "  ok    a comm with spaces/tabs collapses to one field" \
        || { echo "  FAIL  comm-with-spaces would split the record"; f=1; }

    # A parented process must never be a candidate, however expensive.
    sleep 300 &
    child=$!
    read_proc "/proc/$child" && [ "$P_PPID" != "1" ] \
        && echo "  ok    a parented process reads ppid!=1 and is skipped" \
        || { echo "  FAIL  parented process misread as orphan"; f=1; }
    kill -9 "$child" 2>/dev/null

    # read_proc must survive a comm containing spaces and parens.
    read_proc /proc/1 && [ -n "${P_PPID:-}" ] \
        && echo "  ok    read_proc parses a real /proc entry" \
        || { echo "  FAIL  read_proc could not parse /proc/1"; f=1; }

    # A deploy lock must disarm killing.
    if deploy_in_flight; then echo "  ok    deploy lock detected (reaping disarmed)"
    else echo "  ok    no deploy lock present"; fi

    [ "$f" -eq 0 ] || { echo "ERROR — nothing was checked (selftest failed)"; exit 2; }
    echo
fi

if [ "$INTERVAL" -gt 0 ]; then
    last=""
    while :; do
        now=$(scan); rc=$?
        state=$(echo "$now" | tail -1 | cut -d, -f2-)
        # Alert on state CHANGE only, so a watch loop is not a log firehose.
        [ "$state" != "$last" ] && { date '+%Y-%m-%d %H:%M:%S'; echo "$now"; last=$state; }
        sleep "$INTERVAL"
    done
fi

scan
exit $?
