# codex-impl
# Pure admission adapter for evidence extracted from one live QEMU process.

use std.cli.cli_util (get_cli_args)
use common.spec.environment_profile.{
    UiEnvironmentAdmissionStatus,
    UiEnvironmentEvidenceClass,
    arm64_simpleos_qemu_primitive_config,
    arm64_simpleos_qemu_primitive_evidence,
    simpleos_qemu_2d_environment_profiles,
    ui_environment_evidence,
    ui_environment_admission_status_name,
    validate_arm64_simpleos_qemu_primitives,
    validate_ui_environment_evidence
}

fn evidence_flag(value: text) -> bool:
    value == "1"

fn main() -> i64:
    val args = get_cli_args()
    if args.len() != 12:
        print "usage: validate-simpleos-arm64-unified-live-receipt <guest-booted> <driver-ready> <drawir> <vulkan-device> <device-readback> <fallback> <keyboard> <pointer> <audio-queue> <audio-completed> <device-id> <frame-id>"
        return 2
    val profile = simpleos_qemu_2d_environment_profiles()[1]
    val primitive = validate_arm64_simpleos_qemu_primitives(
        profile,
        arm64_simpleos_qemu_primitive_config(),
        arm64_simpleos_qemu_primitive_evidence(
            profile.id,
            UiEnvironmentEvidenceClass.LiveGuest,
            guest_booted: evidence_flag(args[0]),
            guest_driver_ready: evidence_flag(args[1]),
            draw_ir_executed: evidence_flag(args[2]),
            vulkan_physical_device: args[10],
            vulkan_device_executed: evidence_flag(args[3]),
            device_readback: evidence_flag(args[4]),
            fallback_used: evidence_flag(args[5]),
            keyboard_queue_ready: evidence_flag(args[6]),
            pointer_queue_ready: evidence_flag(args[7]),
            audio_queue_ready: evidence_flag(args[8]),
            audio_completed: evidence_flag(args[9])
        )
    )
    val combined = validate_ui_environment_evidence(
        profile,
        ui_environment_evidence(
            profile.id,
            UiEnvironmentEvidenceClass.LiveGuest,
            configured: true,
            runtime_available: true,
            qemu_arguments_bound: true,
            guest_booted: evidence_flag(args[0]),
            draw_ir_executed: evidence_flag(args[2]),
            vulkan_device_executed: evidence_flag(args[3]),
            device_readback: evidence_flag(args[4]),
            input_delivered: evidence_flag(args[6]) and evidence_flag(args[7]),
            audio_completed: evidence_flag(args[9]),
            fallback_used: evidence_flag(args[5]),
            device_identity: args[10],
            frame_identity: args[11]
        )
    )
    print "simpleos_arm64_unified_primitive_admission={ui_environment_admission_status_name(primitive.status)} reason={primitive.reason}"
    print "simpleos_arm64_unified_environment_admission={ui_environment_admission_status_name(combined.status)} reason={combined.reason}"
    if primitive.status == UiEnvironmentAdmissionStatus.Pass and combined.status == UiEnvironmentAdmissionStatus.Pass: 0 else: 1
