#!/bin/sh
# Repo Hygiene Regression Gate
# Scans for policy violations that indicate clutter or drift.
# Exit 0 = clean, exit 1 = violations found.
set -eu

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        echo "ERROR: SHA-256 tool unavailable (need sha256sum or shasum)" >&2
        return 1
    fi
}

sha256_symlink_target() {
    symlink_target=$(readlink "$1") || {
        echo "ERROR: cannot read symlink target: $1" >&2
        return 1
    }
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$symlink_target" | sha256sum | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        printf '%s' "$symlink_target" | shasum -a 256 | awk '{print $1}'
    else
        echo "ERROR: SHA-256 tool unavailable (need sha256sum or shasum)" >&2
        return 1
    fi
}

scan_forbidden_extension_files() {
    {
        find . \( -type f -o -type l \) -name '*.py' \
            -not -path './.git/*' \
            -not -path './.jj/*' \
            -not -path '*/vendor/*' \
            -not -path '*/node_modules/*' \
            -not -path '*/__pycache__/*' \
            -not -path '*/build/*'
        find . \( -type f -o -type l \) \( -name '*.bash' -o -name '*.sh' \) \
            -not -path './.git/*' \
            -not -path './.jj/*' \
            -not -path '*/vendor/*' \
            -not -path '*/node_modules/*' \
            -not -path '*/build/*' \
            -not -path './scripts/bootstrap/bootstrap-from-scratch.sh' \
            -not -path './scripts/bootstrap/bootstrap-seed.sh' \
            -not -path './scripts/bootstrap/bootstrap-verify.sh'
    } 2>/dev/null | LC_ALL=C sort -u
}

fingerprint_forbidden_extension_files() {
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        if [ -L "$file" ]; then
            fingerprint=$(sha256_symlink_target "$file") || return 1
            printf 'symlink:%s  %s\n' "$fingerprint" "$file"
        elif [ -f "$file" ]; then
            fingerprint=$(sha256_file "$file") || return 1
            printf 'file:%s  %s\n' "$fingerprint" "$file"
        else
            echo "ERROR: forbidden-extension path changed type during scan: $file" >&2
            return 1
        fi
    done
}

classify_forbidden_extension_debt() {
    current_file="$1"
    baseline_file="$2"
    new_file="$3"
    stale_file="$4"
    known_file="$5"
    comm -23 "$current_file" "$baseline_file" > "$new_file"
    comm -13 "$current_file" "$baseline_file" > "$stale_file"
    comm -12 "$current_file" "$baseline_file" > "$known_file"
}

selftest_assert_equal() {
    description="$1"
    expected="$2"
    actual="$3"
    if [ "$expected" != "$actual" ]; then
        echo "SELFTEST FAILED: $description (expected '$expected', got '$actual')"
        SELFTEST_FAILURES=$((SELFTEST_FAILURES + 1))
    fi
}

selftest() {
    fixture_dir=$(mktemp -d) || return 1
    mkdir -p "$fixture_dir/scripts/bootstrap" "$fixture_dir/vendor/pkg" "$fixture_dir/build/out"
    printf 'print("known")\n' > "$fixture_dir/known.py"
    ln -s known.py "$fixture_dir/linked.py"
    printf '#!/bin/sh\n' > "$fixture_dir/new.sh"
    printf '#!/bin/sh\n' > "$fixture_dir/allowed.shs"
    printf '#!/bin/sh\n' > "$fixture_dir/scripts/bootstrap/bootstrap-seed.sh"
    printf 'ignored\n' > "$fixture_dir/vendor/pkg/ignored.py"
    printf 'ignored\n' > "$fixture_dir/build/out/ignored.py"

    (cd "$fixture_dir" && scan_forbidden_extension_files) > "$fixture_dir/files"
    SELFTEST_FAILURES=0
    selftest_assert_equal "scanner finds exactly forbidden fixture paths" \
        "./known.py ./linked.py ./new.sh" \
        "$(tr '\n' ' ' < "$fixture_dir/files" | sed 's/ $//')"

    printf './known.py\n./linked.py\n' | (cd "$fixture_dir" && fingerprint_forbidden_extension_files) \
        | LC_ALL=C sort > "$fixture_dir/baseline"
    (cd "$fixture_dir" && fingerprint_forbidden_extension_files < "$fixture_dir/files") \
        | LC_ALL=C sort > "$fixture_dir/current"
    classify_forbidden_extension_debt "$fixture_dir/current" "$fixture_dir/baseline" \
        "$fixture_dir/new" "$fixture_dir/stale" "$fixture_dir/known"
    selftest_assert_equal "exact type/path/hash is known debt" 2 "$(wc -l < "$fixture_dir/known" | tr -d ' ')"
    selftest_assert_equal "symlink target has an explicit fingerprint type" symlink \
        "$(sed -n '/linked\.py$/s/:.*//p' "$fixture_dir/known")"
    selftest_assert_equal "new forbidden path is rejected" "./new.sh" \
        "$(sed -n 's/^[^ ]*  //p' "$fixture_dir/new")"
    selftest_assert_equal "unchanged baseline has no stale rows" 0 \
        "$(wc -l < "$fixture_dir/stale" | tr -d ' ')"

    printf 'print("modified")\n' > "$fixture_dir/known.py"
    printf './known.py\n./linked.py\n' | (cd "$fixture_dir" && fingerprint_forbidden_extension_files) \
        | LC_ALL=C sort > "$fixture_dir/modified"
    classify_forbidden_extension_debt "$fixture_dir/modified" "$fixture_dir/baseline" \
        "$fixture_dir/modified_new" "$fixture_dir/modified_stale" "$fixture_dir/modified_known"
    selftest_assert_equal "modified forbidden content is new debt" 1 \
        "$(wc -l < "$fixture_dir/modified_new" | tr -d ' ')"
    selftest_assert_equal "old content hash becomes stale" 1 \
        "$(wc -l < "$fixture_dir/modified_stale" | tr -d ' ')"

    grep '  \./linked\.py$' "$fixture_dir/baseline" > "$fixture_dir/symlink_baseline"
    ln -snf new.sh "$fixture_dir/linked.py"
    printf './linked.py\n' | (cd "$fixture_dir" && fingerprint_forbidden_extension_files) \
        | LC_ALL=C sort > "$fixture_dir/retargeted"
    classify_forbidden_extension_debt "$fixture_dir/retargeted" "$fixture_dir/symlink_baseline" \
        "$fixture_dir/retargeted_new" "$fixture_dir/retargeted_stale" "$fixture_dir/retargeted_known"
    selftest_assert_equal "retargeted forbidden symlink is new debt" 1 \
        "$(wc -l < "$fixture_dir/retargeted_new" | tr -d ' ')"
    selftest_assert_equal "old symlink-target fingerprint becomes stale" 1 \
        "$(wc -l < "$fixture_dir/retargeted_stale" | tr -d ' ')"

    grep '  \./known\.py$' "$fixture_dir/baseline" > "$fixture_dir/regular_baseline"
    printf 'print("known")\n' > "$fixture_dir/renamed.py"
    printf './renamed.py\n' | (cd "$fixture_dir" && fingerprint_forbidden_extension_files) \
        | LC_ALL=C sort > "$fixture_dir/substitution"
    classify_forbidden_extension_debt "$fixture_dir/substitution" "$fixture_dir/regular_baseline" \
        "$fixture_dir/substitution_new" "$fixture_dir/substitution_stale" "$fixture_dir/substitution_known"
    selftest_assert_equal "same-hash path substitution is new debt" "./renamed.py" \
        "$(sed -n 's/^[^ ]*  //p' "$fixture_dir/substitution_new")"
    selftest_assert_equal "same-hash path substitution leaves stale debt" "./known.py" \
        "$(sed -n 's/^[^ ]*  //p' "$fixture_dir/substitution_stale")"

    printf 'print("known")\n' > "$fixture_dir/source"
    rm "$fixture_dir/known.py"
    ln -s source "$fixture_dir/known.py"
    printf './known.py\n' | (cd "$fixture_dir" && fingerprint_forbidden_extension_files) \
        | LC_ALL=C sort > "$fixture_dir/type_changed"
    classify_forbidden_extension_debt "$fixture_dir/type_changed" "$fixture_dir/regular_baseline" \
        "$fixture_dir/type_new" "$fixture_dir/type_stale" "$fixture_dir/type_known"
    selftest_assert_equal "regular-file to symlink substitution is new debt" 1 \
        "$(wc -l < "$fixture_dir/type_new" | tr -d ' ')"
    selftest_assert_equal "regular-file fingerprint becomes stale after symlink substitution" 1 \
        "$(wc -l < "$fixture_dir/type_stale" | tr -d ' ')"

    rm -rf "$fixture_dir"
    if [ "$SELFTEST_FAILURES" -ne 0 ]; then
        echo "check-repo-hygiene: SELFTEST FAILED ($SELFTEST_FAILURES assertion(s))"
        return 1
    fi
    echo "check-repo-hygiene: selftest 13/13 fixtures correct"
    return 0
}

if [ "${1:-}" = "--selftest-only" ]; then
    selftest || exit 2
    exit 0
fi
if [ "$#" -ne 0 ]; then
    echo "ERROR: unknown argument: $1" >&2
    exit 2
fi

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

VIOLATIONS=0
WARNINGS=0

log_violation() {
    VIOLATIONS=$((VIOLATIONS + 1))
    echo "VIOLATION: $1"
}

log_warning() {
    WARNINGS=$((WARNINGS + 1))
    echo "WARNING: $1"
}

# --- Check 1: Forbidden file types across entire repo ---
# The tree has historical .py/.sh debt. Freeze it by exact object type, path,
# and content/link-target hash: count-only baselines allow an old offender to be
# replaced by a new one while the total stays flat. New paths, renamed copies,
# retargeted symlinks, type changes, and modified bytes must all fail.
FORBIDDEN_BASELINE="scripts/check/repo_hygiene_forbidden_extensions_baseline.txt"
FORBIDDEN_TMP=$(mktemp -d)
trap 'rm -rf "$FORBIDDEN_TMP"' 0 1 2 3 15

scan_forbidden_extension_files > "$FORBIDDEN_TMP/files"
fingerprint_forbidden_extension_files < "$FORBIDDEN_TMP/files" \
    | LC_ALL=C sort > "$FORBIDDEN_TMP/current"

if [ ! -f "$FORBIDDEN_BASELINE" ]; then
    log_violation "missing exact path/hash baseline: $FORBIDDEN_BASELINE"
    : > "$FORBIDDEN_TMP/baseline"
else
    sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$FORBIDDEN_BASELINE" \
        > "$FORBIDDEN_TMP/baseline_raw"
    INVALID_BASELINE=$(grep -Ev '^(file|symlink):[0-9a-f]{64}  \./[^[:cntrl:]]+$' \
        "$FORBIDDEN_TMP/baseline_raw" || true)
    if [ -n "$INVALID_BASELINE" ]; then
        while IFS= read -r entry; do
            [ -n "$entry" ] || continue
            log_violation "invalid forbidden-extension baseline row: $entry"
        done <<EOF
$INVALID_BASELINE
EOF
    fi
    LC_ALL=C sort "$FORBIDDEN_TMP/baseline_raw" > "$FORBIDDEN_TMP/baseline"
    DUPLICATE_BASELINE=$(uniq -d "$FORBIDDEN_TMP/baseline" || true)
    if [ -n "$DUPLICATE_BASELINE" ]; then
        while IFS= read -r entry; do
            [ -n "$entry" ] || continue
            log_violation "duplicate forbidden-extension baseline row: $entry"
        done <<EOF
$DUPLICATE_BASELINE
EOF
    fi
fi

classify_forbidden_extension_debt \
    "$FORBIDDEN_TMP/current" "$FORBIDDEN_TMP/baseline" \
    "$FORBIDDEN_TMP/new" "$FORBIDDEN_TMP/stale" "$FORBIDDEN_TMP/known"

KNOWN_FORBIDDEN_COUNT=$(wc -l < "$FORBIDDEN_TMP/known" | tr -d ' ')
if [ "$KNOWN_FORBIDDEN_COUNT" -gt 0 ]; then
    log_warning "$KNOWN_FORBIDDEN_COUNT pre-existing forbidden-extension file(s) match the exact type/path/hash baseline"
    while IFS= read -r entry; do
        [ -n "$entry" ] || continue
        echo "BASELINED DEBT: ${entry#*  } (fingerprint ${entry%%  *})"
    done < "$FORBIDDEN_TMP/known"
fi

while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    log_violation "new or modified forbidden-extension file: ${entry#*  } (fingerprint ${entry%%  *})"
done < "$FORBIDDEN_TMP/new"

while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    log_violation "stale forbidden-extension baseline row: ${entry#*  } (remove it after debt cleanup; fingerprint ${entry%%  *})"
done < "$FORBIDDEN_TMP/stale"

# --- Check 2: Stale .smf placeholders (179 bytes = empty stub) ---
STALE_SMF=$(find src/ -name '*.smf' -size 179c 2>/dev/null | head -50 || true)
STALE_SMF_COUNT=0
if [ -n "$STALE_SMF" ]; then
    STALE_SMF_COUNT=$(echo "$STALE_SMF" | wc -l)
    # This is a warning, not a violation — stale stubs are expected during migration
    log_warning "$STALE_SMF_COUNT stale 179-byte .smf placeholder(s) found"
fi

# --- Check 3: Uncommitted report/doc clutter in tracked dirs ---
# Reports should not be auto-committed; check for untracked .md in doc/09_report
REPORT_CLUTTER=$(find doc/09_report/ -name '*.md' -newer doc/09_report/.gitkeep 2>/dev/null \
    | head -20 || true)
# Note: .gitkeep may not exist; this check is best-effort

# --- Check 4: Naming convention in src/lib — dirs should be snake_case ---
BAD_LIB_DIRS=$(find src/lib/ -mindepth 2 -maxdepth 2 -type d 2>/dev/null \
    | while read -r d; do
        base=$(basename "$d")
        if echo "$base" | grep -qE '[A-Z]|-'; then
            echo "$d"
        fi
    done || true)
if [ -n "$BAD_LIB_DIRS" ]; then
    for d in $BAD_LIB_DIRS; do
        log_violation "non-snake_case dir in src/lib/: $d"
    done
fi

# --- Check 5: Credentials / secrets leak guard ---
SECRET_FILES=$(find . -maxdepth 3 \
    \( -name '.env' -o -name 'credentials.json' -o -name '*.pem' -o -name '*.key' \) \
    -not -path './.git/*' \
    -not -path './vendor/*' \
    2>/dev/null || true)
if [ -n "$SECRET_FILES" ]; then
    for f in $SECRET_FILES; do
        log_violation "potential secret/credential file: $f"
    done
fi

# --- Check 6: TODO/FIXME items in .spl files that should be tracked ---
# Just count — not a violation, but surface for awareness
TODO_COUNT=$(grep -r 'TODO\|FIXME' src/ --include='*.spl' 2>/dev/null | wc -l || echo 0)

# --- Check 7: Live KMS workflow must remain manual and credential-gated ---
if ! sh scripts/check/check-live-kms-security-workflow.shs; then
    log_violation "live KMS workflow invariant check failed"
fi

# --- Check 8: Workspace root write guard for newly added files ---
if ! sh scripts/check-workspace-root-guard.shs audit --staged; then
    log_violation "workspace root write guard staged audit failed"
fi

# --- Check 9: LLM-style numbered artifact guard for newly added/renamed files ---
if ! sh scripts/audit/numbered-artifact-guard.shs --working; then
    log_violation "numbered artifact working-copy audit failed"
fi
if ! sh scripts/audit/numbered-artifact-guard.shs --staged; then
    log_violation "numbered artifact staged audit failed"
fi

NUMBERED_BASE_REF="${NUMBERED_ARTIFACT_BASE_REF:-}"
if [ -z "$NUMBERED_BASE_REF" ] && git rev-parse --verify origin/main >/dev/null 2>&1; then
    NUMBERED_BASE_REF="$(git merge-base HEAD origin/main 2>/dev/null || true)"
fi
if [ -n "$NUMBERED_BASE_REF" ]; then
    if ! sh scripts/audit/numbered-artifact-guard.shs --changed-from "$NUMBERED_BASE_REF"; then
        log_violation "numbered artifact changed-path audit failed"
    fi
fi

# --- Summary ---
echo ""
echo "=== Repo Hygiene Gate ==="
echo "Violations: $VIOLATIONS"
echo "Warnings:   $WARNINGS"
echo "TODOs/FIXMEs in src/: $TODO_COUNT"

if [ "$VIOLATIONS" -gt 0 ]; then
    echo "FAILED: $VIOLATIONS violation(s) found"
    exit 1
fi

echo "PASSED: repository is clean"
exit 0
