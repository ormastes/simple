#!/bin/sh
# Build the SDL2 satellite runtime library used by the interpreter/JIT path.
#
# The rt_sdl2_* family is implemented once, in C, at src/runtime/runtime_sdl2.c.
# Native builds link that translation unit directly. The interpreter cannot —
# it is a separate process image — so it resolves the same symbols out of this
# satellite shared library via
# src/compiler_rust/compiler/src/interpreter_extern/sdl2.rs.
#
# Without this library the interpreter reports that SDL2 is unavailable. Before
# the satellite existed it instead reported "unknown extern function:
# rt_sdl2_init", which was indistinguishable from SDL2 not being installed and
# so masked the real host-WM answer.
#
# runtime_sdl2.c references spl_array_get_i64 (defined in runtime.c) from
# rt_sdl2_present_rgba only. That symbol is deliberately left undefined here:
# the loader binds lazily, so the other 65 entry points resolve and run, and
# present_rgba stays a natively-linked-only entry point.
set -eu

REPO_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
OUT_DIR="${SDL2_OUT_DIR:-$REPO_ROOT/build/sffi}"
SRC="$REPO_ROOT/src/runtime/runtime_sdl2.c"

case "$(uname -s)" in
  Darwin) EXT="dylib"; LIB="libspl_sdl2.dylib" ;;
  Linux|FreeBSD) EXT="so"; LIB="libspl_sdl2.so" ;;
  *) EXT="dll"; LIB="spl_sdl2.dll" ;;
esac

if ! command -v sdl2-config >/dev/null 2>&1; then
  echo "[build_simple_runtime_sdl2] sdl2-config not found; SDL2 development files are required" >&2
  echo "[build_simple_runtime_sdl2] install libsdl2-dev (Debian/Ubuntu) or sdl2 (Homebrew)" >&2
  exit 1
fi

if [ ! -s "$SRC" ]; then
  echo "[build_simple_runtime_sdl2] missing $SRC" >&2
  exit 1
fi

mkdir -p "$OUT_DIR"
OBJ="$(mktemp -t spl_sdl2_XXXXXX.o)"
trap 'rm -f "$OBJ"' EXIT

cc -c -fPIC -O2 -std=gnu11 -I"$REPO_ROOT/src/runtime" \
  $(sdl2-config --cflags) "$SRC" -o "$OBJ"

DST="$OUT_DIR/$LIB"
case "$(uname -s)" in
  Darwin)
    cc -dynamiclib -Wl,-undefined,dynamic_lookup \
      -Wl,-install_name,@rpath/libspl_sdl2.dylib \
      "$OBJ" $(sdl2-config --libs) -o "$DST.new"
    ;;
  *)
    cc -shared "$OBJ" $(sdl2-config --libs) -o "$DST.new"
    ;;
esac
mv "$DST.new" "$DST"

# Fail loudly if the satellite did not actually export the family: a silently
# empty library would reintroduce the "capability looks missing" failure mode
# this script exists to remove.
EXPORTED=0
if command -v nm >/dev/null 2>&1; then
  case "$EXT" in
    so) EXPORTED="$(nm -D --defined-only "$DST" 2>/dev/null | grep -c ' T rt_sdl2_' || true)" ;;
    dylib) EXPORTED="$(nm -gU "$DST" 2>/dev/null | grep -c ' T _rt_sdl2_' || true)" ;;
    *) EXPORTED=-1 ;;
  esac
fi
if [ "$EXPORTED" = 0 ]; then
  echo "[build_simple_runtime_sdl2] $DST exports no rt_sdl2_* symbols" >&2
  exit 1
fi

echo "[build_simple_runtime_sdl2] staged: $DST (${EXPORTED} rt_sdl2_* symbols)"
