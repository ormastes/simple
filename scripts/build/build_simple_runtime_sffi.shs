#!/bin/sh
# Build backend-specific hosted GPU dynamic providers.
#
# Native hosted executables load these artifacts as data through the core GPU
# registry. They are never linker inputs. Core-C is built by its owning native
# runtime path; whole-linking that archive here would incorrectly pull process
# preinit state into a provider DSO.
set -eu

REPO_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
CRATE_ROOT="$REPO_ROOT/src/compiler_rust"
OUT_DIR="$REPO_ROOT/build/sffi"

case "$(uname -s)" in
  Darwin) EXT="dylib" ;;
  Linux|FreeBSD) EXT="so" ;;
  *) EXT="dll" ;;
esac

mkdir -p "$OUT_DIR"
SRC="$CRATE_ROOT/target/release/libsimple_runtime.$EXT"

build_rust_dylib() {
  _name=$1
  _features=$2
  _dst="$OUT_DIR/$_name.$EXT"
  (cd "$CRATE_ROOT" && cargo build -p simple-runtime --release \
    --no-default-features --features "$_features")
  cp "$SRC" "$_dst.new"
  if [ "$(uname -s)" = Darwin ]; then
    install_name_tool -id "@rpath/$_name.dylib" "$_dst.new"
  fi
  nm -g "$_dst.new" | grep -q 'rt_simple_gpu_provider_abi_version' || {
    echo "[build_simple_runtime_sffi] $_name missing GPU provider ABI export" >&2
    exit 1
  }
  mv "$_dst.new" "$_dst"
  echo "[build_simple_runtime_sffi] staged: $_dst"
}

# Each backend is data loaded by core, never a native linker input. Building
# with no defaults prevents CUDA and Vulkan from leaking into one another.
build_rust_dylib libsimple_gpu_cuda runtime-symbol-table,cuda
build_rust_dylib libsimple_gpu_vulkan runtime-symbol-table,vulkan
if [ "$(uname -s)" = Darwin ]; then
  build_rust_dylib libsimple_gpu_metal runtime-symbol-table,metal
fi
