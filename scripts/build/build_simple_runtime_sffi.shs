#!/bin/sh
# Build the hosted runtime dylib with the complete runtime symbol table.
#
# Native hosted executables intentionally resolve runtime-owned externs from
# this dynamic provider. The runtime-symbol-table feature retains canonical C
# providers that Cargo would otherwise dead-strip from the cdylib.
set -eu

REPO_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
CRATE_ROOT="$REPO_ROOT/src/compiler_rust"
OUT_DIR="$REPO_ROOT/build/sffi"

case "$(uname -s)" in
  Darwin) EXT="dylib" ;;
  Linux|FreeBSD) EXT="so" ;;
  *) EXT="dll" ;;
esac

(cd "$CRATE_ROOT" && cargo build -p simple-runtime --release --features runtime-symbol-table,vulkan,runtime-tls)

mkdir -p "$OUT_DIR"
SRC="$CRATE_ROOT/target/release/libsimple_runtime.$EXT"
DST="$OUT_DIR/libsimple_runtime_wm.$EXT"
cp "$SRC" "$DST.new"
if [ "$(uname -s)" = Darwin ]; then
  install_name_tool -id "@rpath/libsimple_runtime_wm.dylib" "$DST.new"
fi
mv "$DST.new" "$DST"
echo "[build_simple_runtime_sffi] staged: $DST"

C_ARCHIVE="$(find "$CRATE_ROOT/target/release/build" -path '*/simple-runtime-*/out/libruntime_sffi_c.a' -type f -print0 | xargs -0 ls -t | head -1)"
if [ ! -s "$C_ARCHIVE" ]; then
  echo "[build_simple_runtime_sffi] missing Cargo C-runtime archive" >&2
  exit 1
fi
C_DST="$OUT_DIR/libsimple_runtime_c_wm.$EXT"
case "$(uname -s)" in
  Darwin)
    cc -dynamiclib -Wl,-undefined,dynamic_lookup \
      -Wl,-install_name,@rpath/libsimple_runtime_c_wm.dylib \
      -Wl,-force_load,"$C_ARCHIVE" -o "$C_DST.new" -lm
    ;;
  Linux|FreeBSD)
    cc -shared -Wl,--whole-archive "$C_ARCHIVE" -Wl,--no-whole-archive -o "$C_DST.new" -lm
    ;;
  *)
    echo "[build_simple_runtime_sffi] unsupported host for C provider" >&2
    exit 1
    ;;
esac
mv "$C_DST.new" "$C_DST"
echo "[build_simple_runtime_sffi] staged: $C_DST"
