#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
output=${1:-"$repo_root/build/lib/libsimple_hal_provider_sealed_v1.a"}
output_dir=$(dirname -- "$output")
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
mkdir -p "$output_dir"
"${CC:-cc}" -std=c11 -O2 -Wall -Wextra -Werror -pedantic -c \
    "$repo_root/src/app/hal_provider/hal_provider_sealed_session_v1.c" \
    -o "$work/session.o"
"${CC:-cc}" -std=c11 -O2 -Wall -Wextra -Werror -pedantic -c \
    "$repo_root/src/app/hal_provider/hal_provider_sealed_facade_v1.c" \
    -o "$work/facade.o"
"${CC:-cc}" -std=c11 -O2 -Wall -Wextra -Werror -pedantic -c \
    "$repo_root/src/runtime/runtime_hal_buffer_dispatch.c" \
    -o "$work/buffer_dispatch.o"
"${AR:-ar}" rcs "$work/provider.a" "$work/session.o" "$work/facade.o" \
    "$work/buffer_dispatch.o"
mv "$work/provider.a" "$output"
printf '%s\n' "$output"
