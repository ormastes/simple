#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
output=${1:-"$repo_root/build/bootstrap/hal-provider-launcher-v1"}
output_dir=$(dirname -- "$output")
temp="$output.tmp.$$"
trap 'rm -f "$temp"' EXIT HUP INT TERM
mkdir -p "$output_dir"
"${CC:-cc}" -std=c11 -O2 -Wall -Wextra -Werror -pedantic \
    "$repo_root/src/app/hal_provider/hal_provider_launcher_v1.c" \
    -o "$temp"
chmod 0755 "$temp"
mv "$temp" "$output"
trap - EXIT HUP INT TERM
printf '%s\n' "$output"
if [ "$output" != /usr/libexec/simple/hal-provider-launcher-v1 ]; then
    echo 'NOTE: coordinator admission remains fail-closed until a privileged install writes /usr/libexec/simple/hal-provider-launcher-v1' >&2
fi
