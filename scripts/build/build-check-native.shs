#!/bin/sh
# Build and deploy the cached native worker used by `simple check`.
set -eu

repo_root="$(CDPATH= cd "$(dirname "$0")/../.." && pwd)"
cd "${repo_root}"

triple="x86_64-unknown-linux-gnu"
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) triple="x86_64-unknown-linux-gnu" ;;
  Linux-aarch64) triple="aarch64-unknown-linux-gnu" ;;
  Darwin-arm64) triple="aarch64-apple-darwin" ;;
  Darwin-x86_64) triple="x86_64-apple-darwin" ;;
esac

out_dir="build/check_native"
out="${out_dir}/simple_check"
deploy_dir="bin/release/${triple}"
mkdir -p "${out_dir}"

bin/simple native-build \
  --runtime-bundle core-c-bootstrap \
  --source src/compiler \
  --source src/app \
  --source src/lib \
  --entry-closure \
  --entry src/app/check/main.spl \
  --strip \
  --output "${out}"

[ -x "${out}" ] || { echo "FAIL — native-build produced no executable at ${out}"; exit 1; }

smoke_target="src/app/check/check_options.spl"
if "${out}" "${smoke_target}" --quiet >"${out_dir}/smoke.log" 2>&1; then
  :
else
  status=$?
  echo "FAIL — artifact smoke check exited ${status}; see ${out_dir}/smoke.log"
  exit 1
fi

if [ "${1:-}" = "--no-deploy" ]; then
  echo "PASS — built ${out} (not deployed)"
  exit 0
fi

mkdir -p "${deploy_dir}"
cp "${out}" "${deploy_dir}/simple_check.new"
mv "${deploy_dir}/simple_check.new" "${deploy_dir}/simple_check"
if command -v sha256sum >/dev/null 2>&1; then
  (cd "${deploy_dir}" && sha256sum simple_check > simple_check.sha256)
fi
echo "PASS — deployed ${deploy_dir}/simple_check"
