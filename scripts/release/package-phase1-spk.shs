#!/bin/sh
# Package a bootstrap compiler built outside the release matrix (FreeBSD VM,
# Linux riscv64 cross) the same way the matrix rows do, minus MCP/test-runner.
#
#   sh scripts/release/package-phase1-spk.shs <version> <platform> <binary> [phase]
set -eu
version=$1 platform=$2 binary=$3 phase=${4:-1}
pkg="simple-bootstrap-${version}-${platform}"
rm -rf "$pkg" && mkdir -p "$pkg/bin"
cp "$binary" "$pkg/bin/simple-runtime"
chmod +x "$pkg/bin/simple-runtime"
printf '%s\n' '#!/bin/sh' 'SCRIPT_DIR=$(dirname -- "$0")' \
  'export SIMPLE_ASSET_ROOT="$SCRIPT_DIR/.."' 'exec "$SCRIPT_DIR/simple-runtime" "$@"' > "$pkg/bin/simple"
chmod +x "$pkg/bin/simple"
echo "$phase" > "$pkg/PHASE"
rm -rf src/compiler_rust/target   # build output; never packaged
for entry in lib src examples assets README.md LICENSE THIRD_PARTY_NOTICES.md; do
  [ -e "$entry" ] && cp -r "$entry" "$pkg/"
done
# Same development-only pruning as the matrix packaging step.
rm -rf "$pkg/src/app/vscode_extension/node_modules" "$pkg/src/app/vscode_extension/.vscode-test" "$pkg/build"
bash scripts/check_release_payload.shs --dir "$pkg"
tar czf "$pkg.spk" "$pkg"
bash scripts/check_release_payload.shs --tar "$pkg.spk"
sha256sum "$pkg.spk" > "$pkg.spk.sha256"
echo "packaged $pkg.spk (phase $phase)"
