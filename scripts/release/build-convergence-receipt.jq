{schema:"simple-release-convergence/3",producer:"protected_integration",
  inventory_origin:"protected_integration",candidate_commit_sha:$candidate_commit_sha,
  authority_class:$authority_class,verification_performed:$verification_performed,
  github_pr_approval_claimed:$github_pr_approval_claimed,
  verifier_unavailability_proof_sha256:$verifier_unavailability_proof_sha256,
  release_ref:$release_ref,main_head_sha:$main_head_sha,release_head_sha:$release_head_sha,
  review_summary_sha256:$review_summary_sha256,
  evidence_receipt_sha256:$evidence_receipt_sha256,
  integration_receipt_sha256:$integration_receipt_sha256,
  provider:{integration_pr_number:($integration_pr_number | tonumber),
    integration_base_sha:$integration_base_sha,
    integration_head_sha:$integration_head_sha,
    integration_merge_sha:$candidate_commit_sha,
    release_inventory_head_sha:$release_inventory_head_sha,
    reviewed_manifest_blob_sha:$manifest_blob_sha,
    reviewed_manifest_sha256:$manifest_sha256},
  main_to_release:{inventory_shas:$main_inventory[0],shared_fix_shas:$main_selected,
    selected_shas:$main_selected,backported_shas:$backport_sources,
    backport_receipt_sha256s:[$backports[].receipt_sha256],backports:$backports},
  release_to_main:{inventory_shas:$release_inventory[0],shared_fix_shas:$fix_sources,
    forward_ported_shas:$forward_sources,
    forward_port_receipt_sha256s:[$forward_ports[].receipt_sha256],
    classifications:$classifications,forward_ports:$forward_ports},
  mutation:"none",main_remains_independent:true}
