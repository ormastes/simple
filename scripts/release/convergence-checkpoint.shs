#!/bin/sh
# Bounded read-only main/release convergence checkpoint for operators and CI.
set -eu

root=.
release_ref=
output_root=build/release-convergence-checkpoint
require_release_line=0

for arg in "$@"; do
    case "$arg" in
        --root=*) root=${arg#--root=} ;;
        --release-ref=*) release_ref=${arg#--release-ref=} ;;
        --output=*) output_root=${arg#--output=} ;;
        --require-release-line) require_release_line=1 ;;
        *) echo "release-convergence-checkpoint: unknown option: $arg" >&2; exit 2 ;;
    esac
done

root=$(cd "$root" && pwd -P)
main_workspace=$(git -C "$root" worktree list --porcelain |
    awk 'index($0, "worktree ") == 1 { print substr($0, 10); exit }')
main_workspace=$(cd "$main_workspace" && pwd -P)
if test -z "$release_ref"; then
    version=$(awk '$1 == "semver:" { print $2; exit }' "$root/release/version.sdn")
    base_version=${version%%-*}
    major=${base_version%%.*}
    remainder=${base_version#*.}
    minor=${remainder%%.*}
    release_ref="release/$major.$minor"
fi
printf '%s\n' "$release_ref" | grep -Eq '^release/[0-9]+\.[0-9]+$' || {
    echo "release-convergence-checkpoint: invalid release ref: $release_ref" >&2
    exit 2
}

if ! git -C "$root" ls-remote --exit-code --heads origin "refs/heads/$release_ref" >/dev/null 2>&1; then
    if test "$require_release_line" -eq 1; then
        echo "release-convergence-checkpoint: required remote release line is absent: $release_ref" >&2
        exit 1
    fi
    echo "release-convergence-checkpoint: SKIP (no active $release_ref)"
    if test -n "${GITHUB_STEP_SUMMARY:-}"; then
        printf '## Release/main convergence checkpoint\n\n- status: not applicable\n- reason: no active `%s` remote ref\n' \
            "$release_ref" >> "$GITHUB_STEP_SUMMARY"
    fi
    exit 0
fi

git -C "$root" fetch --no-tags --prune origin \
    "+refs/heads/main:refs/remotes/origin/main" \
    "+refs/heads/$release_ref:refs/remotes/origin/$release_ref"
main_sha=$(git -C "$root" rev-parse refs/remotes/origin/main)
release_sha=$(git -C "$root" rev-parse "refs/remotes/origin/$release_ref")
runtime=${SIMPLE_RELEASE_RUNTIME:-$root/bin/release/simple}
test -x "$runtime" || {
    echo "release-convergence-checkpoint: admitted Simple runtime is missing: $runtime" >&2
    exit 1
}

case "$output_root" in
    /*) ;;
    *) output_root="$root/$output_root" ;;
esac
mkdir -p "$output_root"
temporary_root=$(mktemp -d)
checkpoint_worktree=
checkpoint_branch=

cleanup_current_worktree() {
    if test -n "$checkpoint_worktree" && test -d "$checkpoint_worktree"; then
        git -C "$root" worktree remove --force "$checkpoint_worktree" >/dev/null 2>&1 || true
    fi
    if test -n "$checkpoint_branch" &&
       git -C "$root" show-ref --verify --quiet "refs/heads/$checkpoint_branch"; then
        git -C "$root" branch -D "$checkpoint_branch" >/dev/null 2>&1 || true
    fi
    checkpoint_worktree=
    checkpoint_branch=
}

cleanup() {
    cleanup_current_worktree
    rmdir "$temporary_root" >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

observe_direction() {
    direction=$1
    if test "$direction" = main_to_release; then
        target_ref=$release_ref
        target_sha=$release_sha
    else
        target_ref=main
        target_sha=$main_sha
    fi

    identity=${GITHUB_RUN_ID:-local}-${GITHUB_RUN_ATTEMPT:-1}-${direction}-$$
    checkpoint_branch="work/release/checkpoint-$identity"
    checkpoint_worktree="$temporary_root/$direction"
    git -C "$root" worktree add --quiet -b "$checkpoint_branch" \
        "$checkpoint_worktree" "$target_sha"
    workspace=$(cd "$checkpoint_worktree" && pwd -P)
    policy_sha256=$(sha256sum "$checkpoint_worktree/.spipe/policy/vcs.sdn" | awk '{ print $1 }')
    current_epoch=$(date +%s)
    result="$output_root/$direction.json"

    if test "$direction" = release_to_main; then
        set -- --forward-port-required --forward-port-target=main
    else
        set --
    fi
    SIMPLE_LIB="$root/src" "$runtime" run "$root/src/app/release/main.spl" \
        convergence-discover --json \
        --root="$checkpoint_worktree" --session="checkpoint-$identity" \
        --workspace="$workspace" --main-workspace="$main_workspace" \
        --branch="$checkpoint_branch" --target="$target_ref" \
        --base-sha="$target_sha" --target-sha="$target_sha" \
        --policy-sha256="$policy_sha256" --direction="$direction" \
        --release-ref="$release_ref" --last-main-sha="$main_sha" \
        --current-main-sha="$main_sha" --release-head-sha="$release_sha" \
        --last-scan-epoch=0 --current-epoch="$current_epoch" --scan-interval=1 \
        "$@" > "$result"
    jq -e '.status == "ok" and .mutation == "fetch-only" and
        .main_remains_independent == true' "$result" >/dev/null
    source_only_count=$(jq '.source_only_commit_shas | length' "$result")
    echo "release-convergence-checkpoint: PASS ($direction, $source_only_count source-only commits)"
    cleanup_current_worktree
}

observe_direction main_to_release
observe_direction release_to_main

if test -n "${GITHUB_STEP_SUMMARY:-}"; then
    {
        echo '## Release/main convergence checkpoint'
        echo
        echo "- main: \`$main_sha\`"
        echo "- release: \`$release_ref\` at \`$release_sha\`"
        echo "- main-to-release source-only: $(jq '.source_only_commit_shas | length' "$output_root/main_to_release.json")"
        echo "- release-to-main source-only: $(jq '.source_only_commit_shas | length' "$output_root/release_to_main.json")"
        echo '- mutation: fetch-only'
    } >> "$GITHUB_STEP_SUMMARY"
fi
