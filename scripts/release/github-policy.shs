#!/bin/sh
# Render, verify, or explicitly apply the GitHub projection of spipe-vcs/3.
set -eu

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 2
RULESET_DIR="$ROOT/.github/rulesets"
ENVIRONMENT_FILE="$ROOT/.github/release-environment.json"
REVIEW_BROKER_FILE="$ROOT/.github/review-admission-broker.json"
WORKFLOW_PERMISSIONS_FILE="$ROOT/.github/actions-workflow-permissions.json"
DEFAULT_REPO=ormastes/simple
CANONICAL_DEFAULT_BRANCH=main
CANONICAL_ACTIONS_APP_ID=15368
CANONICAL_AUTHORIZED_DISPATCHER_ID=2378857
CANONICAL_STRUCTURAL_CONTEXT='Code Idiom & Structural Ratchet Gates'
CANONICAL_SELF_REVIEW_CONTEXT='SPipe Self Review Admission'
CANONICAL_MAIN_RULESET_SHA256=7ab586fde2738ae1ba03601b79cbcfd5f36ddcb847299e091edc7d24be7e8985
CANONICAL_RELEASE_RULESET_SHA256=101a5cd96736cc79ef8273435fa8542c7d5707141f1299abac540d868c4d6a99

usage() {
    echo "usage: $0 render | review-plan | verify-review RECEIPT SESSION [owner/repo] | verify-live [owner/repo] | apply-live --yes [owner/repo]" >&2
    exit 2
}

review_plan() {
    require_tools
    jq -S '{schema,configured,implementation_status,signed_receipt_protocol,status_context,github_app_integration_id,
      environment_protection_rule_app_id,planned_ruleset_required_check,
      planned_environment_custom_protection,authorized_dispatcher,ruleset_profiles,
      environments,normal_mode,fallback_mode,fallback_reason,apply_live,
      blocking_reason,owner_convergence_fallback,privileged_self_review}' "$REVIEW_BROKER_FILE"
}

review_ruleset_for_base() {
    case $1 in
        main|integration/main) printf '%s\n' "$RULESET_DIR/spipe-vcs-v3-main.json" ;;
        release/*) printf '%s\n' "$RULESET_DIR/spipe-vcs-v3-release-lines.json" ;;
        *) echo "github-policy: unsupported protected PR base: $1" >&2; return 1 ;;
    esac
}

validate_review_receipt() {
    _receipt=$1
    _session=$2
    _repo=$3
    require_tools
    [ -f "$_receipt" ] || { echo "github-policy: review receipt is missing" >&2; return 1; }
    jq -e '
      def sha256: type == "string" and test("^[0-9a-f]{64}$");
      def sha: type == "string" and test("^[0-9a-f]{40}$");
      def timestamp: type == "string" and
        test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$");
      def common_keys: ["audit_receipt_sha256","expires_at","head_sha","issued_at",
        "mode","pull_request_number","repository","required_checks","schema","session_id"];
      .schema == "spipe-review-admission/1" and
      (.mode == "independent_verifier" or .mode == "owner_attested_fallback") and
      (.repository | type == "string") and
      (.pull_request_number | type == "number" and . > 0) and
      (.session_id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$")) and
      (.head_sha | sha) and (.required_checks | type == "array" and length > 0) and
      all(.required_checks[];
        (keys | sort) == (["context","integration_id"] | sort) and
        (.context | type == "string" and length > 0) and
        (.integration_id | type == "number" and . > 0)) and
      (.issued_at | timestamp) and (.expires_at | timestamp) and
      (.audit_receipt_sha256 | sha256) and
      ((.issued_at | fromdateiso8601) <= now) and
      ((.expires_at | fromdateiso8601) > now) and
      (if .mode == "owner_attested_fallback" then
         ((.expires_at | fromdateiso8601) - (.issued_at | fromdateiso8601)) <= 28800
       else ((.expires_at | fromdateiso8601) - (.issued_at | fromdateiso8601)) <= 86400 end) and
      if .mode == "independent_verifier" then
        (keys | sort) == ((common_keys + ["review_receipt_sha256","verifier"]) | sort) and
        (.review_receipt_sha256 | sha256) and
        (.verifier | keys | sort) == (["effort","identity","kind","verdict"] | sort) and
        .verifier.kind == "high_capability_model" and
        (.verifier.identity | type == "string" and length > 0) and
        (.verifier.effort as $effort |
          (["high","xhigh","max","ultra"] | index($effort) != null)) and
        .verifier.verdict == "pass"
      else
        (keys | sort) == ((common_keys + ["attestor","reason","unavailable_verifier_receipt_sha256"]) | sort) and
        .reason == "no eligible independent reviewer" and
        .attestor == {type:"User",id:2378857} and
        (.unavailable_verifier_receipt_sha256 | sha256)
      end' "$_receipt" >/dev/null || {
        echo "github-policy: invalid closed spipe-review-admission/1 receipt" >&2
        return 1
    }

    _pr=$(jq -r '.pull_request_number' "$_receipt")
    _provider_pr=$(gh api "repos/$_repo/pulls/$_pr") || return 1
    _head=$(printf '%s' "$_provider_pr" | jq -er '.head.sha') || return 1
    _base=$(printf '%s' "$_provider_pr" | jq -er '.base.ref') || return 1
    jq -e --arg repo "$_repo" --arg session "$_session" --arg head "$_head" \
      --argjson pr "$_pr" '
        .repository == $repo and .session_id == $session and
        .pull_request_number == $pr and .head_sha == $head' \
      "$_receipt" >/dev/null || {
        echo "github-policy: receipt does not match the server-resolved current PR head/session" >&2
        return 1
    }

    _ruleset=$(review_ruleset_for_base "$_base") || return 1
    _required=$(jq -cS '[.rules[] | select(.type == "required_status_checks") |
      .parameters.required_status_checks[] |
      select(.context != "SPipe Review Admission") | {context,integration_id}]' "$_ruleset")
    jq -e --argjson required "$_required" '.required_checks == $required' \
      "$_receipt" >/dev/null || {
        echo "github-policy: receipt required checks do not match the protected base projection" >&2
        return 1
    }
    _checks=$(gh api --paginate --slurp \
      "repos/$_repo/commits/$_head/check-runs?per_page=100") || return 1
    printf '%s' "$_checks" | jq -e --arg head "$_head" --argjson required "$_required" '
      [ .[].check_runs[] |
        {name,status,conclusion,head_sha,app:{id:.app.id}} ] as $runs |
      all($required[]; . as $check |
        ([ $runs[] | select(.name == $check.context and
          .app.id == $check.integration_id and .head_sha == $head and
          .status == "completed" and .conclusion == "success") ] | length) == 1)' \
      >/dev/null || {
        echo "github-policy: server-resolved PR head lacks an exact configured successful check" >&2
        return 1
    }
    printf '%s\n' "$_head"
}

require_tools() {
    command -v jq >/dev/null 2>&1 || { echo "github-policy: jq is required" >&2; exit 2; }
    command -v gh >/dev/null 2>&1 || { echo "github-policy: gh is required" >&2; exit 2; }
    command -v sha256sum >/dev/null 2>&1 || { echo "github-policy: sha256sum is required" >&2; exit 2; }
}

manifest_files() {
    find "$RULESET_DIR" -maxdepth 1 -type f -name 'spipe-vcs-v3-*.json' -print | LC_ALL=C sort
}

self_review_ruleset_files() {
    printf '%s\n' \
        "$RULESET_DIR/spipe-vcs-v3-main.json" \
        "$RULESET_DIR/spipe-vcs-v3-release-lines.json"
}

environment_files() {
    printf '%s\n' \
        "$ROOT/.github/protected-integration-environment.json" \
        "$ROOT/.github/owner-convergence-admission-environment.json" \
        "$ROOT/.github/release-environment.json" \
        "$ROOT/.github/npm-release-environment.json" \
        "$ROOT/.github/self-review-admission-environment.json"
}

normalize_ruleset() {
    jq -S '
      {name,target,enforcement,conditions,rules,bypass_actors:(.bypass_actors // [])}
      | .rules |= map(
          if .type == "pull_request" then
            .parameters.dismissal_restriction //= {allowed_actors:[],enabled:false}
            | .parameters.ignore_approvals_from_contributors //= false
            | .parameters.require_extra_approval_for_unattributed_changes //= true
            | .parameters.required_reviewers //= []
          else . end)' "$1"
}

normalize_environment() {
    jq -S '{
        wait_timer:(([.protection_rules[]? | select(.type == "wait_timer") | .wait_timer] | first) // 0),
        prevent_self_review:(([.protection_rules[]? | select(.type == "required_reviewers") | .prevent_self_review] | first) // false),
        reviewers:([.protection_rules[]? | select(.type == "required_reviewers") | .reviewers[]? | {type,id:.reviewer.id}] | sort_by(.type,.id)),
        deployment_branch_policy
    }' "$1"
}

normalize_workflow_permissions() {
    jq -S '{default_workflow_permissions,can_approve_pull_request_reviews}' "$1"
}

canonical_ruleset() {
    _profile=$1
    case $_profile in
        main)
            _name=spipe-vcs-v3-main
            _includes='["refs/heads/main","refs/heads/integration/main"]'
            _merge_methods='["merge","squash","rebase"]'
            ;;
        release-lines)
            _name=spipe-vcs-v3-release-lines
            _includes='["refs/heads/release/*","refs/heads/release/**/*"]'
            _merge_methods='["merge"]'
            ;;
        *) echo "github-policy: unsupported canonical ruleset profile: $_profile" >&2; return 1 ;;
    esac
    jq -nS --arg name "$_name" --argjson includes "$_includes" \
      --argjson merge_methods "$_merge_methods" \
      --arg structural "$CANONICAL_STRUCTURAL_CONTEXT" \
      --arg self_review "$CANONICAL_SELF_REVIEW_CONTEXT" \
      --argjson app_id "$CANONICAL_ACTIONS_APP_ID" '
      {
        name:$name,
        target:"branch",
        enforcement:"active",
        conditions:{ref_name:{include:$includes,exclude:[]}},
        rules:[
          {type:"deletion"},
          {type:"non_fast_forward"},
          {type:"pull_request",parameters:{
            allowed_merge_methods:$merge_methods,
            dismissal_restriction:{allowed_actors:[],enabled:false},
            dismiss_stale_reviews_on_push:true,
            ignore_approvals_from_contributors:false,
            require_code_owner_review:false,
            require_extra_approval_for_unattributed_changes:true,
            require_last_push_approval:false,
            required_approving_review_count:0,
            required_review_thread_resolution:true,
            required_reviewers:[]
          }},
          {type:"required_status_checks",parameters:{
            do_not_enforce_on_create:false,
            required_status_checks:[
              {context:$structural,integration_id:$app_id},
              {context:$self_review,integration_id:$app_id}
            ],
            strict_required_status_checks_policy:true
          }}
        ],
        bypass_actors:[]
      }'
}

ruleset_sha256() {
    sha256sum "$1" | awk '{print $1}'
}

canonical_workflow_permissions() {
    jq -nS '{default_workflow_permissions:"read",can_approve_pull_request_reviews:false}'
}

canonical_self_review_environment() {
    jq -nS '{
      wait_timer:0,
      prevent_self_review:false,
      reviewers:[],
      deployment_branch_policy:{protected_branches:true,custom_branch_policies:false}
    }'
}

prepare_expected_projection() {
    _expected_root=$1
    mkdir -p "$_expected_root/rulesets" "$_expected_root/environments"
    for _file in $(manifest_files); do
        _name=$(jq -r '.name' "$_file")
        _expected="$_expected_root/rulesets/$_name.json"
        case $_name in
            spipe-vcs-v3-main)
                canonical_ruleset main >"$_expected"
                _pinned=$CANONICAL_MAIN_RULESET_SHA256
                ;;
            spipe-vcs-v3-release-lines)
                canonical_ruleset release-lines >"$_expected"
                _pinned=$CANONICAL_RELEASE_RULESET_SHA256
                ;;
            *)
                normalize_ruleset "$_file" >"$_expected"
                continue
                ;;
        esac
        _generated=$(ruleset_sha256 "$_expected")
        [ "$_generated" = "$_pinned" ] || {
            echo "github-policy: generated canonical digest disagrees with pinned $_name digest" >&2
            return 1
        }
        _local=$(mktemp) || exit 2
        normalize_ruleset "$_file" >"$_local"
        if ! cmp -s "$_expected" "$_local"; then
            echo "github-policy: canonical normalized ruleset mismatch: $_name" >&2
            echo "github-policy: expected sha256 $_pinned; local sha256 $(ruleset_sha256 "$_local")" >&2
            rm -f "$_local"
            return 1
        fi
        rm -f "$_local"
    done
    for _file in $(environment_files); do
        _environment=$(basename "$_file" -environment.json)
        _expected="$_expected_root/environments/$_environment.json"
        if [ "$_environment" = self-review-admission ]; then
            canonical_self_review_environment >"$_expected"
            _local=$(mktemp) || exit 2
            jq -S '{wait_timer,prevent_self_review,reviewers,deployment_branch_policy}' \
                "$_file" >"$_local"
            cmp -s "$_expected" "$_local" || {
                echo "github-policy: canonical self-review-admission environment mismatch" >&2
                rm -f "$_local"
                return 1
            }
            rm -f "$_local"
        else
            jq -S '{wait_timer,prevent_self_review,reviewers,deployment_branch_policy}' \
                "$_file" >"$_expected"
        fi
    done
    _expected="$_expected_root/actions-workflow-permissions.json"
    canonical_workflow_permissions >"$_expected"
    _local=$(mktemp) || exit 2
    normalize_workflow_permissions "$WORKFLOW_PERMISSIONS_FILE" >"$_local"
    cmp -s "$_expected" "$_local" || {
        echo "github-policy: canonical Actions workflow permissions mismatch" >&2
        rm -f "$_local"
        return 1
    }
    rm -f "$_local"
}

projection_digest() {
    _expected_root=$1
    _digest_input=$(mktemp) || exit 2
    for _file in "$_expected_root"/rulesets/*.json; do
        printf 'ruleset:%s\n' "$(jq -r '.name' "$_file")" >>"$_digest_input"
        cat "$_file" >>"$_digest_input"
    done
    for _file in "$_expected_root"/environments/*.json; do
        printf 'environment:%s\n' "$(basename "$_file" .json)" >>"$_digest_input"
        cat "$_file" >>"$_digest_input"
    done
    printf 'actions-workflow-permissions\n' >>"$_digest_input"
    cat "$_expected_root/actions-workflow-permissions.json" >>"$_digest_input"
    printf 'immutable-releases:true\n' >>"$_digest_input"
    sha256sum "$_digest_input" | awk '{print $1}'
    rm -f "$_digest_input"
}

render() {
    _tmp=$(mktemp -d) || exit 2
    trap 'rm -rf "$_tmp"' EXIT INT TERM
    prepare_expected_projection "$_tmp"
    jq -s -S '.' "$_tmp"/rulesets/*.json
}

live_ruleset_by_name() {
    _repo=$1
    _name=$2
    gh api --paginate "repos/$_repo/rulesets" |
        jq -r --arg name "$_name" '.[] | select(.name == $name) | .id' |
        head -1
}

verify_live() {
    _repo=$1
    _expected_root=${2:-}
    require_tools
    _own_expected=false
    if [ -z "$_expected_root" ]; then
        _expected_root=$(mktemp -d) || exit 2
        _own_expected=true
        prepare_expected_projection "$_expected_root" || {
            rm -rf "$_expected_root"
            return 1
        }
    fi
    _fail=0
    for _file in "$_expected_root"/rulesets/*.json; do
        _name=$(jq -r '.name' "$_file")
        _id=$(live_ruleset_by_name "$_repo" "$_name")
        if [ -z "$_id" ]; then
            echo "github-policy: MISSING ruleset $_name" >&2
            _fail=1
            continue
        fi
        _expected=$(mktemp) || exit 2
        _actual=$(mktemp) || exit 2
        _actual_raw=$(mktemp) || exit 2
        cp "$_file" "$_expected"
        gh api "repos/$_repo/rulesets/$_id" >"$_actual_raw"
        normalize_ruleset "$_actual_raw" >"$_actual"
        if ! cmp -s "$_expected" "$_actual"; then
            echo "github-policy: DRIFT ruleset $_name" >&2
            diff -u "$_expected" "$_actual" >&2 || true
            _fail=1
        else
            echo "github-policy: PASS ruleset $_name"
        fi
        rm -f "$_expected" "$_actual" "$_actual_raw"
    done
    _expected_names=$(mktemp) || exit 2
    _live_names=$(mktemp) || exit 2
    for _file in "$_expected_root"/rulesets/*.json; do jq -r '.name' "$_file"; done | LC_ALL=C sort >"$_expected_names"
    gh api --paginate "repos/$_repo/rulesets" |
        jq -r '.[] | .name | select(startswith("spipe-vcs-v3-"))' |
        LC_ALL=C sort >"$_live_names"
    if ! cmp -s "$_expected_names" "$_live_names"; then
        echo "github-policy: DRIFT duplicate or extra managed ruleset" >&2
        _fail=1
    fi
    rm -f "$_expected_names" "$_live_names"
    for _environment_file in "$_expected_root"/environments/*.json; do
        _environment=$(basename "$_environment_file" .json)
        _expected_env=$(mktemp) || exit 2
        _actual_env=$(mktemp) || exit 2
        cp "$_environment_file" "$_expected_env"
        if ! gh api "repos/$_repo/environments/$_environment" >"$_actual_env" 2>/dev/null; then
            echo "github-policy: MISSING environment $_environment" >&2
            _fail=1
        elif ! normalize_environment "$_actual_env" | cmp -s "$_expected_env" -; then
            echo "github-policy: DRIFT environment $_environment" >&2
            _fail=1
        else
            echo "github-policy: PASS environment $_environment"
        fi
        rm -f "$_expected_env" "$_actual_env"
    done
    _expected_workflow=$(mktemp) || exit 2
    _actual_workflow=$(mktemp) || exit 2
    cp "$_expected_root/actions-workflow-permissions.json" "$_expected_workflow"
    if ! gh api "repos/$_repo/actions/permissions/workflow" >"$_actual_workflow" 2>/dev/null; then
        echo "github-policy: MISSING Actions workflow permissions" >&2
        _fail=1
    elif ! normalize_workflow_permissions "$_actual_workflow" | cmp -s "$_expected_workflow" -; then
        echo "github-policy: DRIFT Actions workflow permissions" >&2
        _fail=1
    else
        echo "github-policy: PASS Actions workflow permissions"
    fi
    rm -f "$_expected_workflow" "$_actual_workflow"
    _immutable=$(gh api "repos/$_repo/immutable-releases" --jq '.enabled')
    if [ "$_immutable" != true ]; then
        echo "github-policy: DRIFT immutable releases disabled" >&2
        _fail=1
    else
        echo "github-policy: PASS immutable releases"
    fi
    if [ "$_fail" -ne 0 ]; then
        [ "$_own_expected" = false ] || rm -rf "$_expected_root"
        return 1
    fi
    _digest=$(projection_digest "$_expected_root")
    echo "github-policy: PASS live projection sha256 $_digest"
    [ "$_own_expected" = false ] || rm -rf "$_expected_root"
}

validate_self_attested_apply_contract() {
    _mode=$(jq -er '.privileged_self_review.review_evidence_mode' "$REVIEW_BROKER_FILE") || {
        echo "github-policy: privileged self-review evidence mode is missing" >&2
        return 1
    }
    if [ "$_mode" = broker_signed ]; then
        if [ "$(jq -r '.configured' "$REVIEW_BROKER_FILE")" != true ] ||
            [ "$(jq -r '.signed_receipt_protocol' "$REVIEW_BROKER_FILE")" = unimplemented ]; then
            echo "github-policy: broker_signed live apply requires a configured external signed broker" >&2
        else
            echo "github-policy: broker_signed live apply is not implemented by this tool" >&2
        fi
        return 1
    fi
    [ "$_mode" = self_attested ] || {
        echo "github-policy: unsupported privileged self-review evidence mode: $_mode" >&2
        return 1
    }
    jq -e '
      .privileged_self_review.configured == true and
      .privileged_self_review.apply_live == true and
      .privileged_self_review.apply_live_mode == "self_attested_generic_actions" and
      .privileged_self_review.generic_actions_app_trust_accepted == true and
      .privileged_self_review.generic_actions_app_is_independent_security_identity == false and
      .privileged_self_review.repository_actions_default_permissions == "read" and
      .privileged_self_review.provider_approval_claimed == false and
      .authorized_dispatcher == {type:"User",id:2378857} and
      .privileged_self_review.required_check ==
        {context:"SPipe Self Review Admission",integration_id:15368}' \
      "$REVIEW_BROKER_FILE" >/dev/null || {
        echo "github-policy: self_attested generic Actions trust is not fully configured" >&2
        return 1
    }
    jq -e '.default_workflow_permissions == "read" and
      .can_approve_pull_request_reviews == false' "$WORKFLOW_PERMISSIONS_FILE" >/dev/null || {
        echo "github-policy: Actions workflow permissions projection is not read-only" >&2
        return 1
    }
    jq -e '.wait_timer == 0 and .prevent_self_review == false and
      .reviewers == [] and .deployment_branch_policy ==
        {protected_branches:true,custom_branch_policies:false}' \
      "$ROOT/.github/self-review-admission-environment.json" >/dev/null || {
        echo "github-policy: self-review-admission environment projection is invalid" >&2
      return 1
    }
    jq -e '.wait_timer == 0 and .prevent_self_review == false and
      .reviewers == [{type:"User",id:2378857}] and .deployment_branch_policy ==
        {protected_branches:true,custom_branch_policies:false}' \
      "$ROOT/.github/owner-convergence-admission-environment.json" >/dev/null || {
        echo "github-policy: owner-convergence-admission environment projection is invalid" >&2
        return 1
    }
}

require_trusted_default_branch_source() {
    _repo=$1
    [ -z "$(git status --porcelain --untracked-files=all)" ] || {
        echo "github-policy: live apply requires a clean trusted default-branch worktree" >&2
        return 1
    }
    _provider_default=$(gh api "repos/$_repo" --jq '.default_branch') || return 1
    [ "$_provider_default" = "$CANONICAL_DEFAULT_BRANCH" ] || {
        echo "github-policy: repository default branch is not canonical main" >&2
        return 1
    }
    _provider_head=$(gh api "repos/$_repo/git/ref/heads/$CANONICAL_DEFAULT_BRANCH" --jq '.object.sha') || return 1
    _local_head=$(git rev-parse HEAD) || return 1
    [ "$_local_head" = "$_provider_head" ] || {
        echo "github-policy: live apply source is not the exact provider main head" >&2
        return 1
    }
}

apply_ruleset() {
    _repo=$1
    _file=$2
    _live_rulesets=$3
    _name=$(jq -r '.name' "$_file")
    _ids=$(jq -r --arg name "$_name" '.[] | select(.name == $name) | .id' "$_live_rulesets")
    _count=$(printf '%s\n' "$_ids" | awk 'NF { count += 1 } END { print count + 0 }')
    case $_count in
        0)
            gh api --method POST "repos/$_repo/rulesets" --input "$_file" >/dev/null
            echo "github-policy: APPLIED create ruleset $_name"
            ;;
        1)
            gh api --method PUT "repos/$_repo/rulesets/$_ids" --input "$_file" >/dev/null
            echo "github-policy: APPLIED update ruleset $_name"
            ;;
        *)
            echo "github-policy: duplicate live rulesets named $_name; refusing apply" >&2
            return 1
            ;;
    esac
}

apply_live() {
    _repo=$1
    require_tools
    validate_self_attested_apply_contract
    _actual_actor=$(gh api user --jq '.id')
    [ "$_actual_actor" = "$CANONICAL_AUTHORIZED_DISPATCHER_ID" ] || {
        echo "github-policy: authenticated GitHub actor is not the authorized policy dispatcher" >&2
        return 1
    }
    require_trusted_default_branch_source "$_repo"
    _expected_root=$(mktemp -d) || exit 2
    prepare_expected_projection "$_expected_root" || {
        rm -rf "$_expected_root"
        return 1
    }
    _live_rulesets=$(mktemp) || exit 2
    trap 'rm -f "$_live_rulesets"; rm -rf "$_expected_root"' EXIT INT TERM
    gh api --paginate "repos/$_repo/rulesets" >"$_live_rulesets"

    gh api --method PUT "repos/$_repo/actions/permissions/workflow" \
        --input "$_expected_root/actions-workflow-permissions.json" >/dev/null
    echo "github-policy: APPLIED read-only Actions workflow permissions"
    gh api --method PUT "repos/$_repo/environments/self-review-admission" \
        --input "$_expected_root/environments/self-review-admission.json" >/dev/null
    echo "github-policy: APPLIED self-review-admission environment"
    gh api --method PUT "repos/$_repo/environments/owner-convergence-admission" \
        --input "$_expected_root/environments/owner-convergence-admission.json" >/dev/null
    echo "github-policy: APPLIED owner-convergence-admission environment"
    for _file in \
        "$_expected_root/rulesets/spipe-vcs-v3-main.json" \
        "$_expected_root/rulesets/spipe-vcs-v3-release-lines.json"; do
        apply_ruleset "$_repo" "$_file" "$_live_rulesets"
    done

    verify_live "$_repo" "$_expected_root"
}

case ${1:-} in
    render)
        render
        ;;
    review-plan)
        review_plan
        ;;
    verify-review)
        [ "$#" -ge 3 ] || usage
        validate_review_receipt "$2" "$3" "${4:-$DEFAULT_REPO}" >/dev/null
        echo "github-policy: PASS review receipt"
        ;;
    verify-live)
        verify_live "${2:-$DEFAULT_REPO}"
        ;;
    apply-live)
        [ "${2:-}" = --yes ] || usage
        apply_live "${3:-$DEFAULT_REPO}"
        ;;
    *) usage ;;
esac
