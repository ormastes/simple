#!/bin/sh
# Validate authority-specific forward-port review evidence without allowing an
# owner fallback to depend on, or impersonate, the external broker identity.
set -eu

fail() { echo "verify-forward-port-authority: FAIL — $*" >&2; exit 1; }

[ "$#" -eq 4 ] || {
    echo "usage: $0 <authority-class> <broker-config.json> <required-checks-json> <forward-port-evidence.json>" >&2
    exit 2
}

authority_class=$1
broker_config=$2
required_checks=$3
evidence_file=$4

jq -e 'type == "array" and length > 0 and all(.[];
  (keys | sort) == (["context","integration_id"] | sort) and
  (.context | type == "string" and length > 0) and
  (.integration_id | type == "number" and . > 0))' \
  <<EOF >/dev/null || fail "required check identities are invalid"
$required_checks
EOF
jq -e 'type == "array"' "$evidence_file" >/dev/null ||
    fail "forward-port evidence must be an array"

case "$authority_class" in
  external_broker)
    broker_app=$(jq -er '
      select(.configured == true and .apply_live == true and
        .implementation_status == "implemented_external_signed_broker" and
        .signed_receipt_protocol == "implemented") |
      .github_app_integration_id | select(type == "number" and . > 0)' \
      "$broker_config") || fail "external broker authority is not configured"
    jq -e --argjson required "$required_checks" --argjson broker_app "$broker_app" '
      all(.[]; . as $evidence |
        $evidence.required_checks == $required and
        $evidence.review_admission.name == "SPipe Review Admission" and
        $evidence.review_admission.app.id == $broker_app and
        $evidence.review_admission.head_sha == $evidence.pr.head_sha and
        $evidence.review_admission.status == "completed" and
        $evidence.review_admission.conclusion == "success" and
        $evidence.review_admission.authority_class == "external_broker" and
        $evidence.review_admission.verification_performed == true and
        $evidence.review_admission.github_pr_approval_claimed == false and
        ($evidence.successful_check_runs | length) == ($required | length) and
        all($required[]; . as $check |
          any($evidence.successful_check_runs[];
            .name == $check.context and .app.id == $check.integration_id and
            .head_sha == $evidence.pr.head_sha and .status == "completed" and
            .conclusion == "success")))' "$evidence_file" >/dev/null ||
        fail "external-broker forward-port evidence is invalid"
    ;;
  owner_attested_actions)
    jq -e '
      .owner_convergence_fallback.configured == true and
      .owner_convergence_fallback.authority_class == "owner_attested_actions" and
      .owner_convergence_fallback.verification_performed == false and
      .owner_convergence_fallback.github_pr_approval_claimed == false' \
      "$broker_config" >/dev/null || fail "owner fallback authority is not configured"
    jq -e --argjson required "$required_checks" '
      all(.[]; . as $evidence |
        $evidence.required_checks == $required and
        $evidence.review_admission.id == null and $evidence.review_admission.name == null and
        $evidence.review_admission.status == null and $evidence.review_admission.conclusion == null and
        $evidence.review_admission.details_url == null and
        $evidence.review_admission.app == {id:null,slug:null} and
        $evidence.review_admission.head_sha == $evidence.pr.head_sha and
        $evidence.review_admission.authority_class == "owner_attested_actions" and
        $evidence.review_admission.verification_performed == false and
        $evidence.review_admission.github_pr_approval_claimed == false and
        ($evidence.successful_check_runs | length) == ($required | length) and
        all($required[]; . as $check |
          any($evidence.successful_check_runs[];
            .name == $check.context and .app.id == $check.integration_id and
            .head_sha == $evidence.pr.head_sha and .status == "completed" and
            .conclusion == "success")))' "$evidence_file" >/dev/null ||
        fail "owner-attested forward-port evidence is invalid"
    ;;
  *) fail "unsupported authority class: $authority_class" ;;
esac

echo "verify-forward-port-authority: PASS — $authority_class"
