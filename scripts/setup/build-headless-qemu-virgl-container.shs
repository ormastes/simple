#!/bin/sh
# Build the pinned, minimal QEMU/virgl image used by headless WM evidence.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
image=${HEADLESS_QEMU_VIRGL_IMAGE:-simple-qemu-virgl-headless:8.2.2-ubuntu24.04}

exec docker build \
    --file "$root/tools/docker/Dockerfile.qemu-virgl-headless" \
    --tag "$image" \
    "$root/tools/docker"
