#!/bin/sh
# Windows MSVC bootstrap lane environment.  SOURCE this (`. scripts/setup/windows-msvc-bootstrap-env.shs`)
# before `scripts/bootstrap/bootstrap-windows.sh --msvc`.
#
# Why this file exists (measured 2026-09-01):
#   The Sep-1 MSVC lane run (build/cx1, pid 22183) exited 1 in
#   `bootstrap_stage3_tool_authority_snapshot`
#   (scripts/check/lib/bootstrap-stage3/authority.shs:736), leaving a truncated
#   `tool-authority-before.txt.tmp.22183` that stops at `tool=file` — the entry
#   immediately before `shasum` in that function's tool loop.  The run's PATH
#   (recorded on line 1 of that tmp) was `/mingw64/bin:/usr/bin:<Windows dirs>`:
#   it omitted `/usr/bin/core_perl`, where MSYS2 keeps `shasum`, so
#   `bootstrap_stage3_tool_requested_path shasum` could not resolve and the
#   function returned 1 -> "error: could not bind bootstrap tool authority".
#   The same PATH also lacked every MSVC tool directory (headers/libs).
#
#   Second failure mode, also measured: the snapshot fails closed on ANY PATH
#   component that is not an existing, already-canonical directory
#   (`[ -d "$dir" ] || return 1` and a `pwd -P` equality test).  An inherited
#   Windows PATH routinely carries both.  Filtering the PATH here is what makes
#   the snapshot reach RC=0 instead of aborting during path enumeration.
#
# Cross-platform impact: NONE.  This file is new, Windows-only, and is sourced
# by nothing on Unix.  No existing script was modified.
#
# --------------------------------------------------------------------------
# Portability (2026-09-24): this file used to hardcode ONE machine's VS
# version (2022 Community, MSVC 14.44.35207), SDK version (10.0.26100.0) and
# a `/c/dev/tool/...` MSYS2 layout, and failed closed with "missing PATH
# component" on any other Windows box. It now DISCOVERS the VS/SDK
# installation via `vswhere.exe` (Microsoft's own fixed, always-installed
# locator: any Visual Studio 2017+ installer places it at
# `%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe`) or the
# newest matching directory on disk, honoring pre-set `VCToolsInstallDir` /
# `WindowsSdkDir` + `WindowsSDKVersion` (e.g. from a prior `vcvars64.bat`) so
# a caller that already resolved these is never overridden. `/c/dev/tool`
# MSYS2 and `/usr/bin/core_perl` are now optional (a warning, not a fatal
# missing-PATH-component error) — see below.
# --------------------------------------------------------------------------

# ---- Visual Studio: VC tools bin/include/lib -----------------------------
if [ -n "${VCToolsInstallDir:-}" ]; then
  simple_msvc_vc_root=$(cygpath -u "${VCToolsInstallDir%\\}" 2>/dev/null) || \
    simple_msvc_vc_root=$(printf '%s' "${VCToolsInstallDir%\\}" | sed -e 's#\\#/#g' -e 's#^\([A-Za-z]\):#/\1#')
  [ -d "$simple_msvc_vc_root" ] || {
    echo "windows-msvc-bootstrap-env: VCToolsInstallDir is set but not a directory: ${VCToolsInstallDir}" >&2
    return 1 2>/dev/null || exit 1
  }
else
  simple_msvc_vswhere="/c/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe"
  [ -x "$simple_msvc_vswhere" ] || \
    simple_msvc_vswhere="$(command -v vswhere.exe 2>/dev/null || command -v vswhere 2>/dev/null || true)"
  if [ -z "$simple_msvc_vswhere" ] || [ ! -x "$simple_msvc_vswhere" ]; then
    echo "windows-msvc-bootstrap-env: vswhere.exe not found (expected at" >&2
    echo "  '%ProgramFiles(x86)%/Microsoft Visual Studio/Installer/vswhere.exe' or on PATH)" >&2
    echo "  and VCToolsInstallDir is not set. Install Visual Studio 2022 with the" >&2
    echo "  'Desktop development with C++' workload, or export VCToolsInstallDir" >&2
    echo "  yourself (e.g. from a vcvars64.bat call) before sourcing this file." >&2
    return 1 2>/dev/null || exit 1
  fi
  simple_msvc_vs_install=$("$simple_msvc_vswhere" -latest -products '*' \
    -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 \
    -property installationPath 2>/dev/null | tr -d '\r')
  if [ -z "$simple_msvc_vs_install" ]; then
    echo "windows-msvc-bootstrap-env: vswhere.exe found no Visual Studio install with" >&2
    echo "  the 'Desktop development with C++' (VC.Tools.x86.x64) workload. Install it" >&2
    echo "  via the Visual Studio Installer, or export VCToolsInstallDir yourself." >&2
    return 1 2>/dev/null || exit 1
  fi
  simple_msvc_vs_install_posix=$(cygpath -u "$simple_msvc_vs_install" 2>/dev/null) || \
    simple_msvc_vs_install_posix=$(printf '%s' "$simple_msvc_vs_install" | sed -e 's#\\#/#g' -e 's#^\([A-Za-z]\):#/\1#')
  simple_msvc_msvc_versions_dir="$simple_msvc_vs_install_posix/VC/Tools/MSVC"
  if [ ! -d "$simple_msvc_msvc_versions_dir" ]; then
    echo "windows-msvc-bootstrap-env: $simple_msvc_msvc_versions_dir not found under the" >&2
    echo "  vswhere-reported install ($simple_msvc_vs_install). The VC.Tools.x86.x64" >&2
    echo "  workload may be only partially installed." >&2
    return 1 2>/dev/null || exit 1
  fi
  # Newest MSVC toolset version wins (dotted-decimal, e.g. 14.44.35207 >
  # 14.39.33519). Sort on the VERSION COMPONENT (the basename) only, not the
  # full path -- `sort -V` on a full `/c/.../VC/Tools/MSVC/14.44.35207` path
  # sorts lexically on the common prefix first and never reaches the version
  # digits in a meaningful way, so a naive full-path version sort silently
  # picks the wrong (e.g. filesystem-order) entry when multiple toolset
  # versions are installed side by side, which is the normal case here (this
  # host has 14.34.31933, 14.38.33130, 14.39.33519 and 14.44.35207
  # side by side). Emit "<version>\t<full path>" pairs, sort by the version
  # field only, then take the path from the winning row.
  simple_msvc_vc_root=$(
    for simple_msvc_v_dir in "$simple_msvc_msvc_versions_dir"/*/; do
      [ -d "$simple_msvc_v_dir" ] || continue
      simple_msvc_v_dir="${simple_msvc_v_dir%/}"
      printf '%s\t%s\n' "$(basename "$simple_msvc_v_dir")" "$simple_msvc_v_dir"
    done | sort -t "$(printf '\t')" -k1,1 -V | tail -n1 | cut -f2-
  )
  if [ -z "$simple_msvc_vc_root" ]; then
    echo "windows-msvc-bootstrap-env: no MSVC toolset version directory found under" >&2
    echo "  $simple_msvc_msvc_versions_dir" >&2
    return 1 2>/dev/null || exit 1
  fi
  unset simple_msvc_vswhere simple_msvc_vs_install simple_msvc_vs_install_posix \
    simple_msvc_msvc_versions_dir simple_msvc_v_dir
fi
simple_msvc_vc_bin="$simple_msvc_vc_root/bin/Hostx64/x64"
simple_msvc_vc_include="$simple_msvc_vc_root/include"
simple_msvc_vc_lib="$simple_msvc_vc_root/lib/x64"

# ---- Windows SDK: include/lib ---------------------------------------------
if [ -n "${WindowsSdkDir:-}" ] && [ -n "${WindowsSDKVersion:-}" ]; then
  simple_msvc_sdk_root=$(cygpath -u "${WindowsSdkDir%\\}" 2>/dev/null) || \
    simple_msvc_sdk_root=$(printf '%s' "${WindowsSdkDir%\\}" | sed -e 's#\\#/#g' -e 's#^\([A-Za-z]\):#/\1#')
  simple_msvc_sdk_ver="${WindowsSDKVersion%\\}"
else
  simple_msvc_sdk_root="/c/Program Files (x86)/Windows Kits/10"
  if [ ! -d "$simple_msvc_sdk_root/Include" ]; then
    echo "windows-msvc-bootstrap-env: Windows 10/11 SDK not found at" >&2
    echo "  '$simple_msvc_sdk_root' and WindowsSdkDir/WindowsSDKVersion are not set." >&2
    echo "  Install the Windows SDK (via the VS Installer), or export both" >&2
    echo "  WindowsSdkDir and WindowsSDKVersion yourself." >&2
    return 1 2>/dev/null || exit 1
  fi
  # Newest SDK version whose Include dir actually has the ucrt headers wins.
  simple_msvc_sdk_ver=$(
    for simple_msvc_s_dir in "$simple_msvc_sdk_root/Include"/*/; do
      simple_msvc_s_dir="${simple_msvc_s_dir%/}"
      [ -d "$simple_msvc_s_dir/ucrt" ] && printf '%s\n' "$(basename "$simple_msvc_s_dir")"
    done | sort -V | tail -n1
  )
  if [ -z "$simple_msvc_sdk_ver" ]; then
    echo "windows-msvc-bootstrap-env: no versioned Windows SDK (with a ucrt include" >&2
    echo "  dir) found under $simple_msvc_sdk_root/Include" >&2
    return 1 2>/dev/null || exit 1
  fi
  unset simple_msvc_s_dir
fi
simple_msvc_sdk_bin="$simple_msvc_sdk_root/bin/$simple_msvc_sdk_ver/x64"

# LLVM 23.1.1 is the Windows C authority. The MSVC/SDK directories above
# supply Windows headers/libraries only; they are not permission to compile
# with cl.exe or link with link.exe (clang-only policy, 2026-09-24 — never
# `cl`, never MSVC `link.exe`; Windows uses clang-cl + lld-link).
# The prefix MUST precede the MinGW bin dir: llvm-sys 231's build script runs the
# first llvm-config on PATH and feeds its --cflags to the native C driver.  With
# MinGW first that is -IC:/dev/tool/msys2/mingw64/include, which fails compiling
# MinGW's stdlib.h (error C2085/C2143 on _exit, _Exit, ecvt, ...).
# SIMPLE_LLVM_WIN_ROOT_23 is the knob llvm-toolchain-env.shs reads; seed it from
# a caller-supplied LLVM_SYS_231_PREFIX so this file's PATH entry and the prefix
# that script prepends can never name two different LLVM installations.
simple_msvc_llvm_prefix="${LLVM_SYS_231_PREFIX:-${SIMPLE_LLVM_WIN_ROOT_23:-/c/dev/tool/clang+llvm-23.1.1-x86_64-pc-windows-msvc}}"
simple_msvc_llvm_bin="$simple_msvc_llvm_prefix/bin"
SIMPLE_LLVM_WIN_ROOT_23="$simple_msvc_llvm_prefix"

# ---- Optional components: MSYS2 mingw64 bin, perl's core_perl ------------
# These used to be hard PATH-membership requirements (fatal "missing PATH
# component" on any host laid out differently). Neither is load-bearing for
# the Windows MSVC lane itself: MSYS2's mingw64/bin supplies GNU userland
# tool variants this lane does not require (the C authority is LLVM/clang-cl,
# never MinGW-GCC), and core_perl is one of several places `perl` can live
# under Git for Windows (rank 2 of the portability audit tracks removing the
# perl dependency itself). Downgraded to a warning: the lane keeps running
# without them, and anything that genuinely needs a tool from one of these
# dirs fails with its own clear diagnostic at the point of use instead of
# here, unconditionally, on every host that happens to lay MSYS2 out
# differently (or not install it at all).
simple_msvc_msys_bin="${SIMPLE_MSYS2_MINGW64_BIN:-/c/dev/tool/msys2/mingw64/bin}"
[ -d "$simple_msvc_msys_bin" ] || {
  echo "windows-msvc-bootstrap-env: note: MSYS2 mingw64 bin not found at '$simple_msvc_msys_bin' (optional; set SIMPLE_MSYS2_MINGW64_BIN to override)" >&2
  simple_msvc_msys_bin=""
}
simple_msvc_core_perl="/usr/bin/core_perl"
[ -d "$simple_msvc_core_perl" ] || {
  echo "windows-msvc-bootstrap-env: note: $simple_msvc_core_perl not found (optional; only needed if perl/shasum live there on this Git-for-Windows install)" >&2
  simple_msvc_core_perl=""
}

for simple_msvc_d in "$simple_msvc_vc_bin" "$simple_msvc_sdk_bin" /usr/bin /bin; do
  [ -d "$simple_msvc_d" ] || {
    echo "windows-msvc-bootstrap-env: missing PATH component: $simple_msvc_d" >&2
    return 1 2>/dev/null || exit 1
  }
done

# clang-only policy (2026-09-24): the MSVC VC tools bin dir
# (bin/Hostx64/x64) is DELIBERATELY NOT added to PATH — it is exactly where
# cl.exe and link.exe live, and putting it on PATH is how they used to shadow
# clang-cl/lld-link. INCLUDE/LIB below still point at the VC/SDK headers and
# import libraries, which clang-cl needs regardless of who resolves it on
# PATH; only the toolchain BINARY directory is withheld.
PATH="$simple_msvc_llvm_bin${simple_msvc_msys_bin:+:$simple_msvc_msys_bin}:$simple_msvc_sdk_bin:/mingw64/bin:/usr/local/bin:/usr/bin:/bin:/usr/bin/vendor_perl${simple_msvc_core_perl:+:$simple_msvc_core_perl}:$PATH"

# Drop non-absolute, missing, non-canonical and duplicate components so the
# Stage 3 tool-authority snapshot's fail-closed path check can succeed.
simple_msvc_filtered=""
simple_msvc_oifs=$IFS
IFS=:
for simple_msvc_d in $PATH; do
  IFS=$simple_msvc_oifs
  case "$simple_msvc_d" in /*) ;; *) IFS=:; continue ;; esac
  [ -d "$simple_msvc_d" ] || { IFS=:; continue; }
  simple_msvc_c=$(CDPATH= cd -- "$simple_msvc_d" 2>/dev/null && pwd -P) || {
    IFS=:; continue
  }
  [ "$simple_msvc_c" = "$simple_msvc_d" ] || { IFS=:; continue; }
  case ":$simple_msvc_filtered:" in *":$simple_msvc_d:"*) IFS=:; continue ;; esac
  simple_msvc_filtered="${simple_msvc_filtered:+$simple_msvc_filtered:}$simple_msvc_d"
  IFS=:
done
IFS=$simple_msvc_oifs
PATH=$simple_msvc_filtered
export PATH

# LIB is not optional decoration here: unlike MSVC `link.exe` (which, run
# from inside a vcvars-initialized shell, can also resolve its import
# libraries via VS-registered environment state), `lld-link` is a standalone
# LLD driver with no such registration path -- it locates .lib files ONLY
# from an explicit `/LIBPATH:` flag or the `LIB` environment variable. Without
# LIB set, a plain `cargo build --release --bin simple` in src/compiler_rust
# (no extra flags) fails at the final link step with unresolved externals for
# every MSVC/UCRT import library (kernel32.lib, msvcrt.lib, ...), even though
# `cargo check` can appear to succeed (check does not always reach the link
# step). This is why LIB is computed and exported unconditionally by this
# script rather than left to an inherited vcvars environment.
INCLUDE="$(cygpath -w "$simple_msvc_vc_include" 2>/dev/null || printf '%s' "$simple_msvc_vc_include");$(cygpath -w "$simple_msvc_sdk_root/Include/$simple_msvc_sdk_ver/ucrt" 2>/dev/null);$(cygpath -w "$simple_msvc_sdk_root/Include/$simple_msvc_sdk_ver/shared" 2>/dev/null);$(cygpath -w "$simple_msvc_sdk_root/Include/$simple_msvc_sdk_ver/um" 2>/dev/null);$(cygpath -w "$simple_msvc_sdk_root/Include/$simple_msvc_sdk_ver/winrt" 2>/dev/null)"
LIB="$(cygpath -w "$simple_msvc_vc_lib" 2>/dev/null);$(cygpath -w "$simple_msvc_sdk_root/Lib/$simple_msvc_sdk_ver/ucrt/x64" 2>/dev/null);$(cygpath -w "$simple_msvc_sdk_root/Lib/$simple_msvc_sdk_ver/um/x64" 2>/dev/null)"
export INCLUDE LIB

# VCToolsInstallDir is exported for anything downstream that still reads it
# (e.g. as a discovery hint), but it is NO LONGER used to resolve a linker:
# scripts/check/check-bootstrap-preflight.shs now requires lld-link, not
# VCToolsInstallDir/bin/Hostx64/x64/link.exe (clang-only policy). Value is
# Windows-style to match what a real vcvars64.bat / MSBuild would export.
VCToolsInstallDir="$(cygpath -w "$simple_msvc_vc_root" 2>/dev/null || printf '%s' "$simple_msvc_vc_root")\\"
export VCToolsInstallDir
export SIMPLE_WINDOWS_ABI=msvc

# Cargo's MSVC-target linker: lld-link, resolved to an absolute path so Cargo
# never depends on PATH ordering to avoid MSVC link.exe (which is not even on
# PATH here, see above, but this is belt-and-suspenders and lets a caller
# still override CC/PATH without silently losing the pinned linker).
simple_msvc_lld_link="$simple_msvc_llvm_bin/lld-link.exe"
if [ -x "$simple_msvc_lld_link" ]; then
  export CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER="$simple_msvc_lld_link"
else
  echo "windows-msvc-bootstrap-env: note: lld-link.exe not found at '$simple_msvc_lld_link';" >&2
  echo "  leaving CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER unset, so Cargo falls back to" >&2
  echo "  resolving 'lld-link' on PATH (src/compiler_rust/.cargo/config.toml)." >&2
fi

# SIMPLE_LINKER_FLAVOR is the repo-wide ABI selector; SIMPLE_WINDOWS_ABI is only
# read by src/compiler/70.backend/backend/runtime_compiler.spl (C-compiler
# choice).  The LINKER path (70.backend/linker/_LinkerWrapper/native_linking.spl:800,
# 90.tools/header_gen/shared_lib_flags.spl:65, and the Rust seed's
# common/src/{platform/cc_detect,target}.rs) reads ONLY SIMPLE_LINKER_FLAVOR,
# falling back to MSYSTEM -- which is MINGW64 in Git Bash.  bootstrap-from-scratch.sh
# derives and exports BOTH (lines 887-889), so a run that enters through it is
# fine; a tool invoked STANDALONE with only this env file was not.
#
# Measured 2026-09-03: scripts/bootstrap/produce-bootstrap-planner-admission-v2.shs
# runs outside bootstrap-from-scratch.sh.  With SIMPLE_WINDOWS_ABI=msvc alone the
# admitted Stage 2 compiler built the planner with MinGW gcc; the resulting
# planner.exe imported libwinpthread-1.dll and msvcrt.dll, and the producer
# executes it under `env -i ... PATH=/usr/bin:/bin`, where that DLL is absent:
#   planner.exe: error while loading shared libraries: libwinpthread-1.dll
# -> `bootstrap-admission-error: planner-execution-nonzero-exit`, exit 64.
# Same probe with SIMPLE_LINKER_FLAVOR=msvc added links clang-cl/MSVC
# (VCRUNTIME140.dll, api-ms-win-crt-*), which resolve from System32 regardless
# of PATH.  Value matches what bootstrap-from-scratch.sh:878-888 derives for
# SIMPLE_WINDOWS_ABI=msvc, so entering through that script stays a no-op and
# its conflict check (line 883) cannot fire.
#
# CROSS-PLATFORM IMPACT: NONE.  This file is Windows-only and is sourced by
# nothing on Linux/macOS/FreeBSD.  No shared script was modified.
export SIMPLE_LINKER_FLAVOR=msvc

# CL contains MSVC options, not a POSIX path. Preserve /TC verbatim when MSYS
# launches native compilers; otherwise it becomes <Git installation>/TC.
# Keep the caller's other exclusions and leave ordinary path conversion on.
case ";${MSYS2_ENV_CONV_EXCL:-};" in
  *';CL;'*) ;;
  *) MSYS2_ENV_CONV_EXCL="${MSYS2_ENV_CONV_EXCL:+${MSYS2_ENV_CONV_EXCL};}CL" ;;
esac
export MSYS2_ENV_CONV_EXCL

# Measured 2026-09-03, same lane.  With SIMPLE_LINKER_FLAVOR=msvc the admitted
# Stage 2 compiler linked a three-line hello world through clang-cl with
#   /WHOLEARCHIVE /FORCE:MULTIPLE,UNRESOLVED
# (link command captured via `native-build --verbose`).  /FORCE:UNRESOLVED makes
# link.exe emit an image for UNRESOLVED externals instead of LNK2019, binding
# each one to RVA 0.  The result linked "clean" (0 failed, no LNK diagnostic) and
# SEGV'd instantly: under cdb the fault was
#   rip = <imagebase>+0   (disassembles as `4d5a  pop r10` -- the "MZ" DOS magic)
#   call stack: <base> <- <base>+0xa00a0 <- KERNEL32!BaseThreadInitThunk
# and the caller disassembles to the MSVC CRT's main-thunk:
#   1400a0099: mov (%rax),%ecx      ; argc
#   1400a009b: call 0x140000000     ; main  -> RVA 0
# i.e. the CRT called a `main` that /FORCE:UNRESOLVED had bound to zero.
#
# SIMPLE_NO_STUB_FALLBACK=1 selects the strict link path, which does not pass
# /FORCE:MULTIPLE,UNRESOLVED (see the guard around
# src/compiler_rust/compiler/src/pipeline/native_project/linker.rs:1855 and the
# `strict_no_stub_fallback` branch at :1856).  Same source, same compiler, same
# lane: 162 KB binary that prints and exits 0, vs a 2.4 MB binary that SEGVs.
# A missing symbol now fails the LINK loudly instead of becoming a call to 0 --
# which is the only safe setting for a bootstrap that must produce a compiler.
#
# CROSS-PLATFORM IMPACT: NONE.  Windows-only file, sourced by nothing on
# Linux/macOS/FreeBSD, and it only sets an env var that already has in-tree
# consumers and an established meaning.
export SIMPLE_NO_STUB_FALLBACK=1

# Scratch dir off C:. Previously unconditional whenever /d existed, which
# silently redirected TMPDIR on any host that happens to have a D: drive for
# an unrelated reason. Opt-in via SIMPLE_WINDOWS_SCRATCH_DRIVE (POSIX-style
# path, e.g. "/d") so a host is never surprised into writing bootstrap scratch
# to a drive nobody asked it to use.
if [ -n "${SIMPLE_WINDOWS_SCRATCH_DRIVE:-}" ] && [ -d "${SIMPLE_WINDOWS_SCRATCH_DRIVE}" ]; then
  simple_msvc_scratch_posix="${SIMPLE_WINDOWS_SCRATCH_DRIVE%/}/simple-tmp"
  mkdir -p "$simple_msvc_scratch_posix" 2>/dev/null || true
  TMPDIR="$simple_msvc_scratch_posix"
  TMP="$(cygpath -w "$simple_msvc_scratch_posix" 2>/dev/null || printf '%s' "$simple_msvc_scratch_posix")"
  TEMP="$TMP"
  export TMPDIR TMP TEMP
  unset simple_msvc_scratch_posix
fi

unset simple_msvc_vc_bin simple_msvc_sdk_bin simple_msvc_msys_bin simple_msvc_core_perl \
  simple_msvc_d simple_msvc_c simple_msvc_filtered simple_msvc_oifs \
  simple_msvc_vc_root simple_msvc_vc_include simple_msvc_vc_lib \
  simple_msvc_sdk_root simple_msvc_sdk_ver simple_msvc_lld_link

# Reuse the canonical executable/version validation and target CC binding.
# Source this bootstrap environment from the repo root, or provide
# SIMPLE_PROJECT_ROOT. Rust llvm-sys feature pins are a separate backend
# migration; a historical LLVM18 backend is never Windows C authority.
unset LLVM_SYS_180_PREFIX
LLVM_VERSIONS=23
export LLVM_VERSIONS
export SIMPLE_LLVM_WIN_ROOT_23
simple_msvc_repo_root="${SIMPLE_PROJECT_ROOT:-$(pwd -P)}"
if ! . "$simple_msvc_repo_root/scripts/setup/llvm-toolchain-env.shs"; then
  echo "windows-msvc-bootstrap-env: LLVM 23.1 C authority could not be established" >&2
  return 1 2>/dev/null || exit 1
fi
# Fallback only: llvm-toolchain-env.shs derives LLVM_SYS_231_PREFIX from
# `llvm-config --prefix` and that value wins.  This covers a distribution whose
# llvm-config.exe is absent, where the platform detector and the Rust binding
# still need the exact LLVM 23.1 prefix.
if [ -z "${LLVM_SYS_231_PREFIX:-}" ] &&
   [ -f "$simple_msvc_llvm_prefix/lib/LLVM-C.lib" ]; then
  LLVM_SYS_231_PREFIX="$simple_msvc_llvm_prefix"
  export LLVM_SYS_231_PREFIX
fi
unset simple_msvc_repo_root simple_msvc_llvm_prefix simple_msvc_llvm_bin
