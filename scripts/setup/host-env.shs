#!/bin/sh
# host-env.shs — hostname-keyed environment loader. SOURCE this file:
#
#   . scripts/setup/host-env.shs
#
# Resolves this host's name and looks up config/host/<hostname>.sdn (schema
# simple-host-env-v1, see config/host/DESKTOP-5A4V03J.sdn for an example).
# When a config file exists for this host, exports SIMPLE_HOST_* variables
# built from it. When none exists, this is a silent NO-OP — nothing is
# exported, nothing fails, and the caller keeps its own generic defaults.
# That is correct behaviour for an unconfigured host, not a degraded one.
#
# Safety: a config file is applied ONLY when its own `hostname:` field matches
# the host this process actually resolved to (via `hostname`, falling back to
# `uname -n`). A mismatch REFUSES — prints to stderr and returns/exits
# non-zero — rather than silently applying another machine's paths.
#
# Exports on a match:
#   SIMPLE_HOST_ENV_FILE               path to the config file that was applied
#   SIMPLE_HOST_PATH_PREPEND           colon-joined PATH entries, in order
#   SIMPLE_HOST_RUSTUP_HOME
#   SIMPLE_HOST_RUSTUP_FALLBACK_HOME
#   SIMPLE_HOST_RUSTUP_HOST_TRIPLE
#   SIMPLE_HOST_TEMP_DEPLOY_ROOT
#   SIMPLE_HOST_LLVM_WIN_ROOT_23      LLVM 23.1 prefix (Windows hosts; may be empty)
#
# Independently of the legacy per-host file, every sourcing also resolves the
# layered HOST CONFIG (schema simple-host-config-v1; keys in
# config/host/host_config.sdn) and exports SIMPLE_HOST_<KEY> for each key that
# resolves non-empty. Executed directly: --get KEY | --print |
# --init [--all-cores] | --cache-env (export lines for the cache keys'
# consumer vars, see host_config_apply_cache_env; cache keys are never
# exported by sourcing).
#
# host_env_apply_path() prepends SIMPLE_HOST_PATH_PREPEND onto PATH,
# idempotently — sourcing this file (or calling the function) more than once
# does not duplicate entries.
#
# Executed directly (not sourced) with --selftest, runs the fixtures below
# against isolated temp fixtures (never this repo's own config/host/):
#
#   sh scripts/setup/host-env.shs --selftest
#
# Direct-execution detection relies on bash's ${BASH_SOURCE[0]} differing from
# $0 only when sourced. This repo's `sh` is bash (see scripts/check/
# check-native-shader-backend-readback-matrix.shs for the same precedent), so
# this is safe here; on a strict POSIX /bin/sh (dash) BASH_SOURCE is unset and
# --selftest detection falls back to $0 alone, which is only reliable for
# direct execution, not for sourcing — not a concern for this repo's shells.

set -u

if [ -n "${BASH_SOURCE:-}" ]; then
    _host_env_self="${BASH_SOURCE[0]}"
else
    _host_env_self="$0"
fi

_host_env_dir=$(CDPATH= cd -- "$(dirname -- "${_host_env_self}")" && pwd) || _host_env_dir=""
if [ -n "${_host_env_dir}" ]; then
    _host_env_repo_root=$(CDPATH= cd -- "${_host_env_dir}/../.." && pwd) || _host_env_repo_root=""
else
    _host_env_repo_root=""
fi

host_env_resolve_hostname() {
    _hen_h=$(hostname 2>/dev/null) || _hen_h=""
    if [ -z "${_hen_h}" ]; then
        _hen_h=$(uname -n 2>/dev/null) || _hen_h=""
    fi
    printf '%s' "${_hen_h}"
}

# host_env_config_path NAME ROOT -> prints the resolved config path, exit 0.
# Tries NAME.sdn, then lowercased NAME.sdn. Neither exists -> exit 1, prints
# nothing (that is the NO-OP case, not an error).
host_env_config_path() {
    _hen_name="$1"
    _hen_root="$2"
    if [ -f "${_hen_root}/config/host/${_hen_name}.sdn" ]; then
        printf '%s' "${_hen_root}/config/host/${_hen_name}.sdn"
        return 0
    fi
    _hen_lower=$(printf '%s' "${_hen_name}" | tr '[:upper:]' '[:lower:]')
    if [ "${_hen_lower}" != "${_hen_name}" ] && [ -f "${_hen_root}/config/host/${_hen_lower}.sdn" ]; then
        printf '%s' "${_hen_root}/config/host/${_hen_lower}.sdn"
        return 0
    fi
    return 1
}

# host_env_sdn_get FILE KEY -> prints the scalar value of a "  key: value"
# line (exactly two-space indent, under the host_env: block). Intentionally
# not a general SDN parser — this file's shape is fixed and small.
host_env_sdn_get() {
    sed -n -E "s/^  ${2}:[[:space:]]*(.*)\$/\1/p" "$1" | head -n1
}

# host_env_sdn_get_list FILE KEY -> prints one item per line for a
#   key:
#     - item
# block (two-space key indent, four-space "- item" indent).
host_env_sdn_get_list() {
    awk -v key="$2" '
        BEGIN { on = 0 }
        $0 ~ "^  " key ":[ \t]*$" { on = 1; next }
        on && /^    - / { line = $0; sub(/^    - /, "", line); print line; next }
        on && !/^    - / { on = 0 }
    ' "$1"
}

# host_env_apply_path -> prepend SIMPLE_HOST_PATH_PREPEND onto PATH in the
# declared order. Idempotent: an entry already present in PATH is not re-added.
host_env_apply_path() {
    [ -n "${SIMPLE_HOST_PATH_PREPEND:-}" ] || return 0
    _hen_old_ifs="${IFS}"
    _hen_ambient_path="${PATH}"
    _hen_configured_path="${SIMPLE_HOST_PATH_PREPEND}"
    IFS=:
    set -- ${_hen_configured_path}
    _hen_prefix=""
    for _hen_entry in "$@"; do
        [ -n "${_hen_entry}" ] || continue
        case ":${_hen_prefix}:" in
            *":${_hen_entry}:"*) ;;
            *) _hen_prefix="${_hen_prefix:+${_hen_prefix}:}${_hen_entry}" ;;
        esac
    done
    _hen_ambient_filtered=""
    set -- ${_hen_ambient_path}
    for _hen_entry in "$@"; do
        [ -n "${_hen_entry}" ] || continue
        case ":${_hen_configured_path}:" in
            *":${_hen_entry}:"*) ;;
            *) _hen_ambient_filtered="${_hen_ambient_filtered:+${_hen_ambient_filtered}:}${_hen_entry}" ;;
        esac
    done
    IFS="${_hen_old_ifs}"
    PATH="${_hen_prefix}${_hen_prefix:+:}${_hen_ambient_filtered}"
    export PATH
}

# host_env_load NAME ROOT -> resolve+export SIMPLE_HOST_* for NAME using
# ROOT/config/host/. Returns 0 with nothing exported when no config exists
# for NAME (no-op), 0 with everything exported on a match, 1 (refused, stderr
# message) on a hostname mismatch inside the file.
host_env_load() {
    _hen_name="$1"
    _hen_root="$2"
    [ -n "${_hen_name}" ] || return 0
    _hen_cfg=$(host_env_config_path "${_hen_name}" "${_hen_root}") || return 0
    _hen_cfg_hostname=$(host_env_sdn_get "${_hen_cfg}" hostname)
    if [ "${_hen_cfg_hostname}" != "${_hen_name}" ]; then
        printf 'host-env: refusing %s -- its hostname field "%s" does not match the resolved host "%s"\n' \
            "${_hen_cfg}" "${_hen_cfg_hostname}" "${_hen_name}" >&2
        return 1
    fi
    SIMPLE_HOST_ENV_FILE="${_hen_cfg}"
    SIMPLE_HOST_PATH_PREPEND=$(host_env_sdn_get_list "${_hen_cfg}" path_prepend | tr '\n' ':' | sed 's/:$//')
    SIMPLE_HOST_RUSTUP_HOME=$(host_env_sdn_get "${_hen_cfg}" rustup_home)
    SIMPLE_HOST_RUSTUP_FALLBACK_HOME=$(host_env_sdn_get "${_hen_cfg}" rustup_fallback_home)
    SIMPLE_HOST_RUSTUP_HOST_TRIPLE=$(host_env_sdn_get "${_hen_cfg}" rustup_host_triple)
    SIMPLE_HOST_TEMP_DEPLOY_ROOT=$(host_env_sdn_get "${_hen_cfg}" temp_deploy_root)
    SIMPLE_HOST_LLVM_WIN_ROOT_23=$(host_env_sdn_get "${_hen_cfg}" llvm_win_root_23)
    export SIMPLE_HOST_ENV_FILE SIMPLE_HOST_PATH_PREPEND SIMPLE_HOST_RUSTUP_HOME \
        SIMPLE_HOST_RUSTUP_FALLBACK_HOME SIMPLE_HOST_RUSTUP_HOST_TRIPLE SIMPLE_HOST_TEMP_DEPLOY_ROOT \
        SIMPLE_HOST_LLVM_WIN_ROOT_23
    return 0
}

# ---------------------------------------------------------------------------
# Host config (schema simple-host-config-v1) — layered host facts.
#
# Precedence, highest first (same order as the Simple-side reader
# std.common.config_core.host_config and the environment-variant policy's
# env > user):
#   1. SIMPLE_HOST_<KEY> environment variable
#   2. user/host file ${SIMPLE_HOST_CONFIG:-$HOME/.config/simple/host.sdn}
#      (untracked; `--init` / scripts/setup/setup.shs generates it once)
#   3. the validated legacy per-host file (SIMPLE_HOST_ENV_FILE, above)
#   4. versioned defaults config/host/host_config.sdn (values commented out)
# Every layer uses the same "  key: value" two-space shape as host_env:.
# ---------------------------------------------------------------------------
HOST_CONFIG_KEYS="max_build_jobs max_threads worker_mem_mib tree_rss_base_mib tree_rss_per_job_mib tree_rss_host_pct cpu_family cpu_features os llvm_root llvm_version gpu cache_root cache_scope frontend_cache hir_cache hir_cache_selfcheck native_build_cache_dir cache_max_bytes cache_max_gb hwir assurance arm_baremetal"
HOST_CONFIG_CACHE_KEYS="cache_root cache_scope frontend_cache hir_cache hir_cache_selfcheck native_build_cache_dir cache_max_bytes cache_max_gb"

# host_config_cache_var KEY -> the EXISTING consumer variable a cache key is a
# default for. Same table as host_config_cache_var() on the Simple side.
host_config_cache_var() {
    case "$1" in
        cache_root) printf 'SIMPLE_HOST_CACHE_ROOT' ;;
        cache_scope) printf 'SIMPLE_CACHE_SCOPE' ;;
        frontend_cache) printf 'SIMPLE_FRONTEND_CACHE' ;;
        hir_cache) printf 'SIMPLE_HIR_CACHE' ;;
        hir_cache_selfcheck) printf 'SIMPLE_HIR_CACHE_SELFCHECK' ;;
        native_build_cache_dir) printf 'SIMPLE_NATIVE_BUILD_CACHE_DIR' ;;
        cache_max_bytes) printf 'SIMPLE_CACHE_MAX_BYTES' ;;
        cache_max_gb) printf 'SIMPLE_CACHE_MAX_GB' ;;
        *) return 1 ;;
    esac
}

host_config_env_name() {
    printf 'SIMPLE_HOST_%s' "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
}

host_config_user_path() {
    if [ -n "${SIMPLE_HOST_CONFIG:-}" ]; then
        printf '%s' "${SIMPLE_HOST_CONFIG}"
        return 0
    fi
    _hc_home="${HOME:-${USERPROFILE:-}}"
    [ -n "${_hc_home}" ] || return 1
    printf '%s/.config/simple/host.sdn' "${_hc_home}"
}

HOST_CONFIG_SCHEMA="simple-host-config-v1"

# host_config_valid KEY VALUE -> 0 when VALUE is acceptable for KEY. Mirrors
# host_config_schema() in std.common.config_core.host_config exactly: integer
# keys are decimal digits >= 1, enum keys take only the listed options,
# cache_scope is a lane-name segment [A-Za-z0-9._-] not starting with '.',
# other text keys take any non-empty value.
host_config_valid() {
    [ -n "$2" ] || return 1
    case "$1" in
        # A share of host RAM for one process tree: 1..75, same bound as the
        # Simple schema and scripts/bootstrap/lib/tree-rss-policy.shs.
        tree_rss_host_pct)
            case "$2" in
                *[!0-9]*|0*|???*) return 1 ;;
            esac
            [ "$2" -le 75 ] ;;
        max_build_jobs|max_threads|worker_mem_mib|tree_rss_base_mib|tree_rss_per_job_mib|llvm_version|cache_max_bytes|cache_max_gb)
            case "$2" in
                *[!0-9]*) return 1 ;;
                *[1-9]*) return 0 ;;
                *) return 1 ;;
            esac ;;
        cpu_family) case "$2" in x86_64|aarch64|riscv64) return 0 ;; *) return 1 ;; esac ;;
        os) case "$2" in windows|linux|macos|freebsd|simpleos) return 0 ;; *) return 1 ;; esac ;;
        gpu|frontend_cache|hir_cache|hir_cache_selfcheck|hwir|assurance|arm_baremetal) case "$2" in on|off) return 0 ;; *) return 1 ;; esac ;;
        # A lane name is a cache DIRECTORY segment: a separator or a leading
        # dot ("..") would let a config value step out of its lane partition.
        cache_scope) case "$2" in .*|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac ;;
        *) return 0 ;;
    esac
}

# host_config_file_schema_ok FILE -> 0 unless FILE declares a `schema:` other
# than simple-host-config-v1 (a file with no schema line is accepted). Same
# rule as host_config_schema_accepts() on the Simple side.
host_config_file_schema_ok() {
    _hcs_schema=$(host_env_sdn_get "$1" schema | sed -E 's/[[:space:]]+#.*$//; s/[[:space:]]+$//')
    [ -z "${_hcs_schema}" ] || [ "${_hcs_schema}" = "${HOST_CONFIG_SCHEMA}" ]
}

# host_config_get KEY ROOT -> prints the effective value (may be empty) and
# sets host_config_source to env|user|host|default|unset. An invalid value is
# rejected with a warning on stderr and resolution falls through to the next
# lower layer; a host_config file with a foreign schema is skipped whole.
host_config_get() {
    _hc_key="$1"
    _hc_root="$2"
    _hc_env=$(host_config_env_name "${_hc_key}")
    eval "_hc_val=\${${_hc_env}:-}"
    if [ -n "${_hc_val}" ]; then
        if host_config_valid "${_hc_key}" "${_hc_val}"; then
            host_config_source=env
            printf '%s' "${_hc_val}"
            return 0
        fi
        printf 'host-config: warning: ignoring invalid %s=%s from env\n' "${_hc_key}" "${_hc_val}" >&2
    fi
    _hc_user=$(host_config_user_path) || _hc_user=""
    for _hc_layer in "user|${_hc_user}" "host|${SIMPLE_HOST_ENV_FILE:-}" \
        "default|${_hc_root}/config/host/host_config.sdn"; do
        _hc_file="${_hc_layer#*|}"
        _hc_name="${_hc_layer%%|*}"
        [ -n "${_hc_file}" ] && [ -f "${_hc_file}" ] || continue
        # The legacy per-host file carries host_env's own schema, already
        # validated by host_env_load; only host_config files are checked here.
        if [ "${_hc_name}" != host ] && ! host_config_file_schema_ok "${_hc_file}"; then
            printf 'host-config: warning: ignoring %s layer %s: schema is not %s\n' "${_hc_name}" "${_hc_file}" "${HOST_CONFIG_SCHEMA}" >&2
            continue
        fi
        _hc_val=$(host_env_sdn_get "${_hc_file}" "${_hc_key}" | sed -E 's/[[:space:]]+#.*$//; s/[[:space:]]+$//')
        [ -n "${_hc_val}" ] || continue
        if host_config_valid "${_hc_key}" "${_hc_val}"; then
            host_config_source="${_hc_name}"
            printf '%s' "${_hc_val}"
            return 0
        fi
        printf 'host-config: warning: ignoring invalid %s=%s from %s layer\n' "${_hc_key}" "${_hc_val}" "${_hc_name}" >&2
    done
    host_config_source=unset
    return 0
}

# host_config_load ROOT -> exports SIMPLE_HOST_<KEY> for every key that
# resolves to a non-empty value. Keys that resolve empty are left unset, so a
# host with no user file exports nothing (the shipped defaults are comments).
# Cache keys are skipped: SIMPLE_HOST_CACHE_ROOT is a live consumer
# (cache_root.spl), so exporting it on every sourcing would relocate
# machine_cache_root() for run-phase1-local.shs and friends. Cache keys are
# applied only by --cache-env / host_config_apply_cache_env (or read by --get).
host_config_load() {
    for _hc_k in ${HOST_CONFIG_KEYS}; do
        case " ${HOST_CONFIG_CACHE_KEYS} " in *" ${_hc_k} "*) continue ;; esac
        _hc_v=$(host_config_get "${_hc_k}" "$1")
        [ -n "${_hc_v}" ] || continue
        _hc_n=$(host_config_env_name "${_hc_k}")
        eval "${_hc_n}=\${_hc_v}"
        export "${_hc_n}"
    done
    return 0
}

# host_config_cache_env ROOT -> prints one VAR=value line per cache key whose
# consumer variable is UNSET and whose host config value resolves non-empty
# (on/off become 1/0). A consumer variable that is set always wins and is
# never printed. Nothing is exported. Only dirs, the lane name, on/off and
# size caps are configurable: producer keying and lane partitioning live in
# the consumers and are untouched.
host_config_cache_env() {
    for _hcc_k in ${HOST_CONFIG_CACHE_KEYS}; do
        _hcc_var=$(host_config_cache_var "${_hcc_k}")
        eval "_hcc_cur=\${${_hcc_var}:-}"
        [ -z "${_hcc_cur}" ] || continue
        _hcc_v=$(host_config_get "${_hcc_k}" "$1")
        [ -n "${_hcc_v}" ] || continue
        case "${_hcc_k}:${_hcc_v}" in
            frontend_cache:on|hir_cache:on|hir_cache_selfcheck:on) _hcc_v=1 ;;
            frontend_cache:off|hir_cache:off|hir_cache_selfcheck:off) _hcc_v=0 ;;
        esac
        printf '%s=%s\n' "${_hcc_var}" "${_hcc_v}"
    done
}

# host_config_apply_cache_env [ROOT] -> exports host_config_cache_env's
# defaults into the current shell. Explicit, like host_env_apply_path: merely
# sourcing this file does NOT apply them, so bootstrap entrypoints that source
# it (run-phase1-local.shs) keep their pinned, lane-private cache env and an
# unchanged machine_cache_root() — host_config_load skips every cache key,
# including cache_root (whose consumer var is SIMPLE_HOST_CACHE_ROOT itself).
host_config_apply_cache_env() {
    _hca_lines=$(host_config_cache_env "${1:-${_host_env_repo_root}}")
    [ -n "${_hca_lines}" ] || return 0
    _hca_old_ifs="${IFS}"
    IFS='
'
    for _hca_line in ${_hca_lines}; do
        eval "${_hca_line%%=*}=\${_hca_line#*=}"
        export "${_hca_line%%=*}"
    done
    IFS="${_hca_old_ifs}"
    return 0
}

# --- detection (used by --init to write the user file once) ----------------
host_config_detect_features() {
    _hcd_family="$1"
    _hcd_raw=""
    case "$(uname -s 2>/dev/null)" in
        Darwin) _hcd_raw=$(sysctl -n machdep.cpu.features machdep.cpu.leaf7_features 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr '\n' ' ') ;;
        FreeBSD) _hcd_raw=$(grep -h 'Features' /var/run/dmesg.boot 2>/dev/null | tr '[:upper:]<>,' '[:lower:]   ' | tr '\n' ' ') ;;
        *) if [ -r /proc/cpuinfo ]; then
               _hcd_raw=$(sed -n -E 's/^(flags|Features|isa)[[:space:]]*:[[:space:]]*//p' /proc/cpuinfo | head -n1)
           fi ;;
    esac
    _hcd_out=""
    _hcd_add() { case ",${_hcd_out}," in *",$1,"*) ;; *) _hcd_out="${_hcd_out:+${_hcd_out},}$1" ;; esac; }
    case "${_hcd_family}" in
        x86_64)
            _hcd_add sse2
            for _hcd_f in ${_hcd_raw}; do
                case "${_hcd_f}" in
                    sse4_2|sse4.2) _hcd_add sse4.2 ;;
                    avx|avx1.0) _hcd_add avx ;;
                    avx2) _hcd_add avx2 ;;
                    fma) _hcd_add fma ;;
                    bmi2) _hcd_add bmi2 ;;
                    avx512f) _hcd_add avx512f ;;
                esac
            done ;;
        aarch64)
            _hcd_add neon
            for _hcd_f in ${_hcd_raw}; do
                case "${_hcd_f}" in sve) _hcd_add sve ;; sve2) _hcd_add sve2 ;; esac
            done ;;
        riscv64)
            # /proc/cpuinfo isa: rv64imafdcv_zba... -> base letters before '_'.
            case "${_hcd_raw%%_*}" in rv64*v*) _hcd_add rvv ;; esac ;;
    esac
    printf '%s' "${_hcd_out}"
}

# Prefers platform-detect.shs's own LLVM discovery (LLVM_PREFIX/LLVM_VERSION,
# already resolved when --init sources it); falls back to llvm-config probes
# that also cover the per-user Windows toolchain store. Only configured roots
# (SIMPLE_LLVM_WIN_ROOT_23, the per-host SIMPLE_HOST_LLVM_WIN_ROOT_23) and
# discovery are used -- no machine-specific absolute path is hard-coded here.
host_config_detect_llvm() {
    if [ "${LLVM_FOUND:-0}" = 1 ] && [ -n "${LLVM_PREFIX:-}" ]; then
        _hcl_prefix="${LLVM_PREFIX}"
        command -v cygpath >/dev/null 2>&1 && _hcl_prefix=$(cygpath -m "${_hcl_prefix}")
        printf '%s|%s' "${_hcl_prefix}" "${LLVM_VERSION}"
        return 0
    fi
    for _hcl_cfg in "${SIMPLE_LLVM_WIN_ROOT_23:-/nonexistent}/bin/llvm-config.exe" \
        "${SIMPLE_HOST_LLVM_WIN_ROOT_23:-/nonexistent}/bin/llvm-config.exe" \
        "${HOME:-/nonexistent}"/.simple/toolchains/llvm-msvc-*/*/bin/llvm-config.exe \
        "$(command -v llvm-config-23 2>/dev/null)" "$(command -v llvm-config 2>/dev/null)"; do
        [ -n "${_hcl_cfg}" ] && [ -x "${_hcl_cfg}" ] || continue
        _hcl_ver=$("${_hcl_cfg}" --version 2>/dev/null) || continue
        _hcl_prefix=$("${_hcl_cfg}" --prefix 2>/dev/null) || continue
        command -v cygpath >/dev/null 2>&1 && _hcl_prefix=$(cygpath -m "${_hcl_prefix}")
        printf '%s|%s' "${_hcl_prefix}" "${_hcl_ver%%.*}"
        return 0
    done
    return 1
}

host_config_detect_gpu() {
    if command -v nvidia-smi >/dev/null 2>&1 || [ -d /dev/dri ]; then
        printf 'on'
    else
        printf 'off'
    fi
}

# host_config_init ROOT [--all-cores] -> writes detected values. Never
# overwrites: an existing file is left untouched (exit 0, reported).
host_config_init() {
    case "${2:-}" in ''|--all-cores) ;; *) return 2 ;; esac
    _hci_all_cores=${2:-}
    _hci_path=$(host_config_user_path) || { printf 'host-config: no HOME/USERPROFILE; cannot place user config\n' >&2; return 1; }
    if [ -e "${_hci_path}" ]; then
        printf 'host-config: keeping existing %s\n' "${_hci_path}"
        return 0
    fi
    . "$1/scripts/setup/platform-detect.shs" || return 1
    _hci_cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1)
    host_config_valid max_threads "${_hci_cpus}" || {
        printf 'host-config: detected CPU count must be a positive integer\n' >&2
        return 1
    }
    _hci_llvm=$(host_config_detect_llvm) || _hci_llvm=""
    _hci_cache_base="${XDG_CACHE_HOME:-${HOME:-${USERPROFILE:-}}/.cache}/simple"
    command -v cygpath >/dev/null 2>&1 && _hci_cache_base=$(cygpath -m "${_hci_cache_base}")
    mkdir -p "$(dirname -- "${_hci_path}")" || return 1
    _hci_tmp="${_hci_path}.tmp.$$"
    {
        printf '# User/host config for %s — generated by scripts/setup/host-env.shs --init.\n' "$(host_env_resolve_hostname)"
        printf '# Yours to edit; setup never overwrites it. Keys and precedence:\n'
        printf '# config/host/host_config.sdn in the Simple repo. Env SIMPLE_HOST_<KEY> wins.\n\n'
        printf 'host_config:\n'
        printf '  schema: simple-host-config-v1\n'
        printf '  max_threads: %s\n' "${_hci_cpus}"
        if [ "${_hci_all_cores}" = --all-cores ]; then
            printf '  max_build_jobs: %s\n' "${_hci_cpus}"
        else
            printf '  # max_build_jobs: 16\n'
        fi
        printf '  # worker_mem_mib: 3300\n'
        printf '  cpu_family: %s\n' "${PLATFORM_ARCH}"
        printf '  cpu_features: %s\n' "$(host_config_detect_features "${PLATFORM_ARCH}")"
        printf '  os: %s\n' "${PLATFORM_OS}"
        if [ -n "${_hci_llvm}" ]; then
            printf '  llvm_root: %s\n' "${_hci_llvm%%|*}"
            printf '  llvm_version: %s\n' "${_hci_llvm#*|}"
        else
            printf '  # llvm_root: (no llvm-config found at setup time)\n'
            printf '  # llvm_version: 23\n'
        fi
        printf '  gpu: %s\n' "$(host_config_detect_gpu)"
        # Cache keys are written COMMENTED: each shows the consumer's built-in
        # default for this host, so uncommenting one is a deliberate choice and
        # a fresh setup changes no cache env (or env-identity fingerprint).
        printf '  # cache (defaults for the consumer env vars; apply with\n'
        printf '  #   eval "$(sh scripts/setup/host-env.shs --cache-env)"):\n'
        printf '  # cache_root: %s\n' "${_hci_cache_base}"
        printf '  # cache_scope: default\n'
        printf '  # frontend_cache: on\n'
        printf '  # hir_cache: on\n'
        printf '  # hir_cache_selfcheck: off   (unset = on in bootstrap lanes)\n'
        printf '  # native_build_cache_dir: %s/native-build/v1   (example; unset = per-consumer default)\n' "${_hci_cache_base}"
        printf '  # cache_max_bytes: 10737418240\n'
        printf '  # cache_max_gb: 20\n'
    } >"${_hci_tmp}" || { rm -f "${_hci_tmp}"; return 1; }
    # mv onto a path that appeared meanwhile would clobber it; re-check.
    if [ -e "${_hci_path}" ]; then
        rm -f "${_hci_tmp}"
        printf 'host-config: keeping existing %s\n' "${_hci_path}"
        return 0
    fi
    mv "${_hci_tmp}" "${_hci_path}" || return 1
    printf 'host-config: wrote %s\n' "${_hci_path}"
}

_host_env_main() {
    [ -n "${_host_env_repo_root}" ] || return 0
    _hem_rc=0
    host_env_load "$(host_env_resolve_hostname)" "${_host_env_repo_root}" || _hem_rc=$?
    host_config_load "${_host_env_repo_root}"
    return "${_hem_rc}"
}

# ---------------------------------------------------------------------------
# --selftest (direct execution only)
# ---------------------------------------------------------------------------
host_env__selftest() {
    _st_dir=$(mktemp -d 2>/dev/null) || { printf 'selftest: mktemp -d failed\n' >&2; return 2; }
    _st_pass=0
    _st_fail=0

    mkdir -p "${_st_dir}/config/host"

    # (a) matching hostname applies cleanly.
    cat >"${_st_dir}/config/host/matchhost.sdn" <<'EOF'
host_env:
  schema: simple-host-env-v1
  hostname: matchhost
  platform: test

  path_prepend:
    - /st/one
    - /st/two

  rustup_home: /st/rustup-home
  rustup_fallback_home: /st/rustup-fallback
  rustup_host_triple: x86_64-test-triple

  temp_deploy_root: /st/deploy-root
EOF
    unset SIMPLE_HOST_ENV_FILE SIMPLE_HOST_PATH_PREPEND SIMPLE_HOST_RUSTUP_HOME \
        SIMPLE_HOST_RUSTUP_FALLBACK_HOME SIMPLE_HOST_RUSTUP_HOST_TRIPLE SIMPLE_HOST_TEMP_DEPLOY_ROOT
    if host_env_load matchhost "${_st_dir}" \
        && [ "${SIMPLE_HOST_PATH_PREPEND:-}" = "/st/one:/st/two" ] \
        && [ "${SIMPLE_HOST_RUSTUP_HOME:-}" = "/st/rustup-home" ] \
        && [ "${SIMPLE_HOST_RUSTUP_HOST_TRIPLE:-}" = "x86_64-test-triple" ] \
        && [ "${SIMPLE_HOST_TEMP_DEPLOY_ROOT:-}" = "/st/deploy-root" ]; then
        printf 'ok - (a) matching hostname applies cleanly\n'
        _st_pass=$((_st_pass + 1))
    else
        printf 'not ok - (a) matching hostname applies cleanly (PATH_PREPEND=%s RUSTUP_HOME=%s TRIPLE=%s DEPLOY=%s)\n' \
            "${SIMPLE_HOST_PATH_PREPEND:-}" "${SIMPLE_HOST_RUSTUP_HOME:-}" "${SIMPLE_HOST_RUSTUP_HOST_TRIPLE:-}" "${SIMPLE_HOST_TEMP_DEPLOY_ROOT:-}"
        _st_fail=$((_st_fail + 1))
    fi

    # (b) mismatched hostname field is refused (non-zero, no export).
    cat >"${_st_dir}/config/host/mismatchhost.sdn" <<'EOF'
host_env:
  schema: simple-host-env-v1
  hostname: some-other-machine
  platform: test

  path_prepend:
    - /st/three

  rustup_home: /st/wrong-home
  rustup_fallback_home: /st/wrong-fallback
  rustup_host_triple: x86_64-wrong-triple

  temp_deploy_root: /st/wrong-deploy
EOF
    unset SIMPLE_HOST_ENV_FILE SIMPLE_HOST_PATH_PREPEND SIMPLE_HOST_RUSTUP_HOME \
        SIMPLE_HOST_RUSTUP_FALLBACK_HOME SIMPLE_HOST_RUSTUP_HOST_TRIPLE SIMPLE_HOST_TEMP_DEPLOY_ROOT
    if host_env_load mismatchhost "${_st_dir}" 2>/tmp/host-env-selftest-b.err; then
        printf 'not ok - (b) mismatched hostname is refused (returned 0)\n'
        _st_fail=$((_st_fail + 1))
    else
        if [ -n "${SIMPLE_HOST_PATH_PREPEND:-}" ]; then
            printf 'not ok - (b) mismatched hostname is refused (exported anyway)\n'
            _st_fail=$((_st_fail + 1))
        elif ! grep -q 'refusing' /tmp/host-env-selftest-b.err 2>/dev/null; then
            printf 'not ok - (b) mismatched hostname is refused (no stderr message)\n'
            _st_fail=$((_st_fail + 1))
        else
            printf 'ok - (b) mismatched hostname is refused\n'
            _st_pass=$((_st_pass + 1))
        fi
    fi
    rm -f /tmp/host-env-selftest-b.err

    # (c) missing config is a silent no-op returning 0.
    unset SIMPLE_HOST_ENV_FILE SIMPLE_HOST_PATH_PREPEND SIMPLE_HOST_RUSTUP_HOME \
        SIMPLE_HOST_RUSTUP_FALLBACK_HOME SIMPLE_HOST_RUSTUP_HOST_TRIPLE SIMPLE_HOST_TEMP_DEPLOY_ROOT
    if host_env_load nosuchhost-xyz "${_st_dir}" \
        && [ -z "${SIMPLE_HOST_PATH_PREPEND:-}" ] && [ -z "${SIMPLE_HOST_ENV_FILE:-}" ]; then
        printf 'ok - (c) missing config is a silent no-op returning 0\n'
        _st_pass=$((_st_pass + 1))
    else
        printf 'not ok - (c) missing config is a silent no-op returning 0\n'
        _st_fail=$((_st_fail + 1))
    fi

    # (d) applying PATH twice does not duplicate entries.
    SIMPLE_HOST_PATH_PREPEND="/st/dup-one:/st/dup-two"
    export SIMPLE_HOST_PATH_PREPEND
    _st_saved_path="${PATH}"
    PATH="/st/dup-two:/st/ambient:/st/dup-one:/st/other"
    host_env_apply_path
    host_env_apply_path
    _st_result_path="${PATH}"
    PATH="${_st_saved_path}"
    export PATH
    _st_count=$(printf '%s' "${_st_result_path}" | tr ':' '\n' | grep -c '^/st/dup-one$')
    if [ "${_st_count}" = "1" ] && [ "${_st_result_path}" = "/st/dup-one:/st/dup-two:/st/ambient:/st/other" ]; then
        printf 'ok - (d) applying PATH twice preserves declared order without duplicates\n'
        _st_pass=$((_st_pass + 1))
    else
        printf 'not ok - (d) applying PATH twice preserves declared order (count=%s path=%s)\n' "${_st_count}" "${_st_result_path}"
        _st_fail=$((_st_fail + 1))
    fi
    unset SIMPLE_HOST_PATH_PREPEND

    # (e) host_config precedence: env > user > host > default, and the
    # commented default pins nothing.
    cat >"${_st_dir}/config/host/host_config.sdn" <<'EOF'
host_config:
  schema: simple-host-config-v1
  # max_build_jobs: 99
  max_threads: 2
  os: linux
  gpu: off
EOF
    cat >"${_st_dir}/hostfile.sdn" <<'EOF'
host_env:
  hostname: sthost
  os: freebsd
  gpu: on
EOF
    cat >"${_st_dir}/user.sdn" <<'EOF'
host_config:
  max_build_jobs: 12   # trailing comment is stripped
  os: windows
EOF
    _st_saved_hc="${SIMPLE_HOST_CONFIG-}"
    _st_saved_env_file="${SIMPLE_HOST_ENV_FILE-}"
    SIMPLE_HOST_CONFIG="${_st_dir}/user.sdn"
    SIMPLE_HOST_ENV_FILE="${_st_dir}/hostfile.sdn"
    unset SIMPLE_HOST_MAX_BUILD_JOBS SIMPLE_HOST_MAX_THREADS SIMPLE_HOST_OS SIMPLE_HOST_GPU SIMPLE_HOST_CPU_FAMILY
    _st_e_ok=1
    _st_v=$(host_config_get max_build_jobs "${_st_dir}"); [ "${_st_v}" = 12 ] || _st_e_ok=0
    host_config_get os "${_st_dir}" >/dev/null; [ "${host_config_source}" = user ] || _st_e_ok=0
    _st_v=$(host_config_get gpu "${_st_dir}"); [ "${_st_v}" = on ] || _st_e_ok=0
    _st_v=$(host_config_get max_threads "${_st_dir}"); [ "${_st_v}" = 2 ] || _st_e_ok=0
    _st_v=$(host_config_get cpu_family "${_st_dir}"); [ -z "${_st_v}" ] || _st_e_ok=0
    host_config_get cpu_family "${_st_dir}" >/dev/null; [ "${host_config_source}" = unset ] || _st_e_ok=0
    _st_v=$(SIMPLE_HOST_OS=macos host_config_get os "${_st_dir}"); [ "${_st_v}" = macos ] || _st_e_ok=0
    SIMPLE_HOST_CONFIG="${_st_dir}/absent.sdn"
    _st_v=$(host_config_get max_build_jobs "${_st_dir}"); [ -z "${_st_v}" ] || _st_e_ok=0
    if [ "${_st_e_ok}" -eq 1 ]; then
        printf 'ok - (e) host_config precedence env > user > host > default; comments pin nothing\n'
        _st_pass=$((_st_pass + 1))
    else
        printf 'not ok - (e) host_config precedence env > user > host > default\n'
        _st_fail=$((_st_fail + 1))
    fi

    # (e2) invalid values and foreign schemas are rejected with a warning and
    # fall through to the next layer -- identical to the Simple reader
    # (test/01_unit/lib/common/config_core/host_config_spec.spl).
    SIMPLE_HOST_CONFIG="${_st_dir}/user.sdn"
    _st_g_ok=1
    _st_v=$(SIMPLE_HOST_MAX_BUILD_JOBS=lots host_config_get max_build_jobs "${_st_dir}" 2>"${_st_dir}/warn.err"); [ "${_st_v}" = 12 ] || _st_g_ok=0
    grep -q 'ignoring invalid max_build_jobs=lots from env' "${_st_dir}/warn.err" || _st_g_ok=0
    _st_v=$(SIMPLE_HOST_OS=plan9 host_config_get os "${_st_dir}" 2>/dev/null); [ "${_st_v}" = windows ] || _st_g_ok=0
    # tree_rss_host_pct is a bounded share of host RAM: 1..75 only.
    _st_v=$(SIMPLE_HOST_TREE_RSS_HOST_PCT=90 host_config_get tree_rss_host_pct "${_st_dir}" 2>"${_st_dir}/warn.err"); [ -z "${_st_v}" ] || _st_g_ok=0
    grep -q 'ignoring invalid tree_rss_host_pct=90 from env' "${_st_dir}/warn.err" || _st_g_ok=0
    _st_v=$(SIMPLE_HOST_TREE_RSS_HOST_PCT=75 host_config_get tree_rss_host_pct "${_st_dir}" 2>/dev/null); [ "${_st_v}" = 75 ] || _st_g_ok=0
    _st_v=$(SIMPLE_HOST_TREE_RSS_HOST_PCT=0 host_config_get tree_rss_host_pct "${_st_dir}" 2>/dev/null); [ -z "${_st_v}" ] || _st_g_ok=0
    _st_v=$(SIMPLE_HOST_MAX_THREADS=0 host_config_get max_threads "${_st_dir}" 2>/dev/null); [ "${_st_v}" = 2 ] || _st_g_ok=0
    printf 'host_config:\n  max_threads: 0\n  gpu: maybe\n' >"${_st_dir}/baduser.sdn"
    SIMPLE_HOST_CONFIG="${_st_dir}/baduser.sdn"
    _st_v=$(host_config_get max_threads "${_st_dir}" 2>/dev/null); [ "${_st_v}" = 2 ] || _st_g_ok=0
    _st_v=$(host_config_get gpu "${_st_dir}" 2>/dev/null); [ "${_st_v}" = on ] || _st_g_ok=0
    printf 'host_config:\n  schema: simple-host-config-v9\n  os: linux\n' >"${_st_dir}/v9user.sdn"
    SIMPLE_HOST_CONFIG="${_st_dir}/v9user.sdn"
    _st_v=$(host_config_get os "${_st_dir}" 2>"${_st_dir}/warn.err"); [ "${_st_v}" = freebsd ] || _st_g_ok=0
    grep -q 'schema is not simple-host-config-v1' "${_st_dir}/warn.err" || _st_g_ok=0
    if [ "${_st_g_ok}" -eq 1 ]; then
        printf 'ok - (e2) invalid values / foreign schema are rejected and fall through with a warning\n'
        _st_pass=$((_st_pass + 1))
    else
        printf 'not ok - (e2) invalid values / foreign schema are rejected and fall through with a warning\n'
        _st_fail=$((_st_fail + 1))
    fi

    # (g) cache keys: validation, consumer-var mapping (on/off -> 1/0), and a
    # SET consumer var always wins (it is never printed / never overridden).
    cat >"${_st_dir}/cacheuser.sdn" <<'EOF'
host_config:
  schema: simple-host-config-v1
  cache_root: /st/cache-base
  cache_scope: devlane
  frontend_cache: off
  hir_cache: on
  native_build_cache_dir: /st/native
  cache_max_bytes: 4096
  cache_max_gb: 7
EOF
    SIMPLE_HOST_CONFIG="${_st_dir}/cacheuser.sdn"
    _st_h_ok=1
    _st_v=$(unset SIMPLE_HOST_CACHE_ROOT SIMPLE_CACHE_SCOPE SIMPLE_FRONTEND_CACHE SIMPLE_HIR_CACHE \
        SIMPLE_NATIVE_BUILD_CACHE_DIR SIMPLE_CACHE_MAX_BYTES SIMPLE_CACHE_MAX_GB
        host_config_cache_env "${_st_dir}" | tr '\n' ' ')
    [ "${_st_v}" = "SIMPLE_HOST_CACHE_ROOT=/st/cache-base SIMPLE_CACHE_SCOPE=devlane SIMPLE_FRONTEND_CACHE=0 SIMPLE_HIR_CACHE=1 SIMPLE_NATIVE_BUILD_CACHE_DIR=/st/native SIMPLE_CACHE_MAX_BYTES=4096 SIMPLE_CACHE_MAX_GB=7 " ] || _st_h_ok=0
    _st_v=$(unset SIMPLE_HOST_CACHE_ROOT SIMPLE_FRONTEND_CACHE SIMPLE_HIR_CACHE SIMPLE_NATIVE_BUILD_CACHE_DIR \
        SIMPLE_CACHE_MAX_BYTES SIMPLE_CACHE_MAX_GB
        SIMPLE_CACHE_SCOPE=phase3 host_config_cache_env "${_st_dir}")
    case "${_st_v}" in *SIMPLE_CACHE_SCOPE*) _st_h_ok=0 ;; esac
    _st_v=$(unset SIMPLE_HOST_CACHE_ROOT SIMPLE_CACHE_SCOPE SIMPLE_FRONTEND_CACHE SIMPLE_HIR_CACHE \
        SIMPLE_NATIVE_BUILD_CACHE_DIR SIMPLE_CACHE_MAX_BYTES SIMPLE_CACHE_MAX_GB
        host_config_apply_cache_env "${_st_dir}"; printf '%s|%s' "${SIMPLE_FRONTEND_CACHE:-}" "${SIMPLE_CACHE_SCOPE:-}")
    [ "${_st_v}" = "0|devlane" ] || _st_h_ok=0
    printf 'host_config:\n  frontend_cache: maybe\n  cache_max_bytes: 0\n  cache_max_gb: big\n  cache_scope: ../phase3\n' >"${_st_dir}/badcache.sdn"
    SIMPLE_HOST_CONFIG="${_st_dir}/badcache.sdn"
    _st_v=$(host_config_get frontend_cache "${_st_dir}" 2>"${_st_dir}/warn.err"); [ -z "${_st_v}" ] || _st_h_ok=0
    grep -q 'ignoring invalid frontend_cache=maybe' "${_st_dir}/warn.err" || _st_h_ok=0
    _st_v=$(host_config_get cache_max_bytes "${_st_dir}" 2>/dev/null); [ -z "${_st_v}" ] || _st_h_ok=0
    _st_v=$(host_config_get cache_max_gb "${_st_dir}" 2>/dev/null); [ -z "${_st_v}" ] || _st_h_ok=0
    _st_v=$(host_config_get cache_scope "${_st_dir}" 2>/dev/null); [ -z "${_st_v}" ] || _st_h_ok=0
    _st_v=$(SIMPLE_HOST_CACHE_SCOPE='a/b' host_config_get cache_scope "${_st_dir}" 2>/dev/null); [ -z "${_st_v}" ] || _st_h_ok=0
    # Sourcing must export NO cache key (machine_cache_root() and the bootstrap
    # lane env stay untouched) while still exporting ordinary keys.
    printf 'host_config:\n  max_threads: 3\n  cache_root: /st/cache-base\n  cache_scope: devlane\n  frontend_cache: off\n' >"${_st_dir}/srcuser.sdn"
    _st_v=$(unset SIMPLE_HOST_CACHE_ROOT SIMPLE_CACHE_SCOPE SIMPLE_FRONTEND_CACHE SIMPLE_HOST_CACHE_SCOPE \
        SIMPLE_HOST_FRONTEND_CACHE SIMPLE_HOST_MAX_THREADS
        SIMPLE_HOST_CONFIG="${_st_dir}/srcuser.sdn"
        . "${_host_env_self}" >/dev/null 2>&1
        printf '%s|%s|%s|%s|%s' "${SIMPLE_HOST_CACHE_ROOT:-}" "${SIMPLE_CACHE_SCOPE:-}" \
            "${SIMPLE_FRONTEND_CACHE:-}" "${SIMPLE_HOST_CACHE_SCOPE:-}" "${SIMPLE_HOST_MAX_THREADS:-}")
    [ "${_st_v}" = "||||3" ] || { printf '# sourcing leaked cache env: %s\n' "${_st_v}"; _st_h_ok=0; }
    # --cache-env round-trips through eval with a quote and a backslash.
    printf 'host_config:\n  cache_root: /st/it'"'"'s\\dir\n' >"${_st_dir}/quoteuser.sdn"
    _st_v=$(unset SIMPLE_HOST_CACHE_ROOT
        _st_out=$(SIMPLE_HOST_CONFIG="${_st_dir}/quoteuser.sdn" sh "${_host_env_self}" --cache-env)
        eval "${_st_out}"
        printf '%s' "${SIMPLE_HOST_CACHE_ROOT:-}")
    [ "${_st_v}" = "/st/it's\\dir" ] || { printf '# --cache-env round trip got: %s\n' "${_st_v}"; _st_h_ok=0; }
    if [ "${_st_h_ok}" -eq 1 ]; then
        printf 'ok - (g) cache keys map to their consumer vars, validate, and a set consumer var wins\n'
        _st_pass=$((_st_pass + 1))
    else
        printf 'not ok - (g) cache keys map to their consumer vars, validate, and a set consumer var wins\n'
        _st_fail=$((_st_fail + 1))
    fi

    # (f) --init writes once and never overwrites an existing user file.
    mkdir -p "${_st_dir}/scripts/setup"
    cp "${_host_env_dir}/platform-detect.shs" "${_st_dir}/scripts/setup/" 2>/dev/null
    SIMPLE_HOST_CONFIG="${_st_dir}/home/.config/simple/host.sdn"
    _st_f_ok=1
    host_config_init "${_st_dir}" >/dev/null || _st_f_ok=0
    grep -q '^  cpu_family: ' "${SIMPLE_HOST_CONFIG}" 2>/dev/null || _st_f_ok=0
    grep -q '^  max_threads: [0-9]' "${SIMPLE_HOST_CONFIG}" 2>/dev/null || _st_f_ok=0
    # Cache examples are written commented, so a fresh setup pins no cache env.
    grep -q '^  # cache_scope: default' "${SIMPLE_HOST_CONFIG}" 2>/dev/null || _st_f_ok=0
    if grep -q '^  cache_\|^  frontend_cache\|^  hir_cache\|^  native_build_cache_dir' "${SIMPLE_HOST_CONFIG}" 2>/dev/null; then _st_f_ok=0; fi
    printf 'host_config:\n  os: mine\n' >"${SIMPLE_HOST_CONFIG}"
    host_config_init "${_st_dir}" >/dev/null || _st_f_ok=0
    [ "$(host_env_sdn_get "${SIMPLE_HOST_CONFIG}" os)" = mine ] || _st_f_ok=0
    if [ "${_st_f_ok}" -eq 1 ]; then
        printf 'ok - (f) --init generates the user file once and never overwrites it\n'
        _st_pass=$((_st_pass + 1))
    else
        printf 'not ok - (f) --init generates the user file once and never overwrites it\n'
        _st_fail=$((_st_fail + 1))
    fi
    # All-core initialization is explicit, preserves memory defaults, and
    # still refuses to overwrite the user's chosen values on a second run.
    SIMPLE_HOST_CONFIG="${_st_dir}/home/.config/simple/all-cores.sdn"
    _st_all_ok=1
    host_config_init "${_st_dir}" --all-cores >/dev/null || _st_all_ok=0
    _st_jobs=$(host_env_sdn_get "${SIMPLE_HOST_CONFIG}" max_build_jobs)
    host_config_valid max_build_jobs "${_st_jobs}" || _st_all_ok=0
    [ "${_st_jobs}" = "$(host_env_sdn_get "${SIMPLE_HOST_CONFIG}" max_threads)" ] || _st_all_ok=0
    [ -z "$(host_env_sdn_get "${SIMPLE_HOST_CONFIG}" worker_mem_mib)" ] || _st_all_ok=0
    printf 'host_config:\n  max_build_jobs: 3\n' >"${SIMPLE_HOST_CONFIG}"
    host_config_init "${_st_dir}" --all-cores >/dev/null || _st_all_ok=0
    [ "$(host_env_sdn_get "${SIMPLE_HOST_CONFIG}" max_build_jobs)" = 3 ] || _st_all_ok=0
    if [ "${_st_all_ok}" -eq 1 ]; then
        printf 'ok - all-cores opt-in uses detected CPUs and preserves existing config\n'
        _st_pass=$((_st_pass + 1))
    else
        printf 'not ok - all-cores opt-in uses detected CPUs and preserves existing config\n'
        _st_fail=$((_st_fail + 1))
    fi
    _st_cli_ok=1
    for _st_bad_args in '--init --unknown' '--all-cores' '--print --all-cores' '--get max_threads extra'; do
        # Intentional word splitting of these fixed, whitespace-only fixtures.
        if SIMPLE_HOST_CONFIG="${_st_dir}/invalid-cli.sdn" sh "${_host_env_self}" ${_st_bad_args} >/dev/null 2>&1; then
            _st_cli_ok=0
        fi
    done
    [ ! -e "${_st_dir}/invalid-cli.sdn" ] || _st_cli_ok=0
    if [ "${_st_cli_ok}" -eq 1 ]; then
        printf 'ok - invalid CLI flags are rejected before configuration writes\n'
        _st_pass=$((_st_pass + 1))
    else
        printf 'not ok - invalid CLI flags are rejected before configuration writes\n'
        _st_fail=$((_st_fail + 1))
    fi
    if [ -n "${_st_saved_hc}" ]; then SIMPLE_HOST_CONFIG="${_st_saved_hc}"; else unset SIMPLE_HOST_CONFIG; fi
    if [ -n "${_st_saved_env_file}" ]; then SIMPLE_HOST_ENV_FILE="${_st_saved_env_file}"; else unset SIMPLE_HOST_ENV_FILE; fi

    rm -rf "${_st_dir}"

    printf 'selftest: %d passed, %d failed\n' "${_st_pass}" "${_st_fail}"
    [ "${_st_fail}" -eq 0 ]
}

host_env_usage() {
    printf 'usage: host-env.shs --init [--all-cores] | --get KEY | --print | --cache-env | --selftest\n' >&2
}

# POSIX sh has no BASH_SOURCE: a sourcing caller's arguments are not ours.
if [ "${_host_env_self}" = "$0" ] && [ "$(basename -- "$0")" = host-env.shs ]; then
    case "${1:-}" in
        --selftest)
            [ "$#" -eq 1 ] || { host_env_usage; exit 2; }
            host_env__selftest
            exit $? ;;
        --get)
            # Prints one effective value without exporting anything into the
            # caller (bootstrap uses this so its SIMPLE_* env fingerprint is
            # unchanged). Legacy per-host refusal is reported, not fatal.
            [ "$#" -eq 2 ] && [ -n "${2:-}" ] || { host_env_usage; exit 2; }
            host_env_load "$(host_env_resolve_hostname)" "${_host_env_repo_root}" || :
            host_config_get "$2" "${_host_env_repo_root}"
            exit 0 ;;
        --print)
            [ "$#" -eq 1 ] || { host_env_usage; exit 2; }
            host_env_load "$(host_env_resolve_hostname)" "${_host_env_repo_root}" || :
            for _hp_k in ${HOST_CONFIG_KEYS}; do
                _hp_v=$(host_config_get "${_hp_k}" "${_host_env_repo_root}")
                host_config_get "${_hp_k}" "${_host_env_repo_root}" >/dev/null
                printf '%s=%s (%s)\n' "${_hp_k}" "${_hp_v}" "${host_config_source}"
            done
            printf 'user_file=%s\n' "$(host_config_user_path || :)"
            exit 0 ;;
        --init)
            [ "$#" -le 2 ] || { host_env_usage; exit 2; }
            case "${2:-}" in ''|--all-cores) ;; *) host_env_usage; exit 2 ;; esac
            host_config_init "${_host_env_repo_root}" "${2:-}"
            exit $? ;;
        --cache-env)
            # `eval "$(sh scripts/setup/host-env.shs --cache-env)"` applies the
            # cache defaults to an interactive shell; consumer vars already set
            # in the caller's env are never overridden (they are not printed).
            host_env_load "$(host_env_resolve_hostname)" "${_host_env_repo_root}" || :
            host_config_cache_env "${_host_env_repo_root}" | while IFS= read -r _hce_line; do
                printf "export %s='%s'\n" "${_hce_line%%=*}" "$(printf '%s' "${_hce_line#*=}" | sed "s/'/'\\\\''/g")"
            done
            exit 0 ;;
        '') ;;
        *) host_env_usage; exit 2 ;;
    esac
fi

_host_env_main
