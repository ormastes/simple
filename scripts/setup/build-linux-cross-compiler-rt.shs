#!/bin/sh
# build-linux-cross-compiler-rt.shs — fetch + build LLVM compiler-rt builtins,
# clang_rt.crtbegin/crtend and a static LLVM libunwind for the Linux
# riscv64 / i686 / armv7 cross targets, so those links never touch GCC's
# libgcc / crtbegin / libgcc_s (CLAUDE.md "Never use GCC").
#
# Nothing is committed: sources are downloaded from the LLVM GitHub release
# matching the host clang (default 18.1.3, Ubuntu 24.04) and the result is
# installed under $SIMPLE_CROSS_RT_PREFIX (default
# ~/.simple/toolchains/llvm-cross-rt-18):
#   resource/include -> host clang resource include dir (symlink)
#   resource/lib/linux/libclang_rt.builtins-<arch>.a, clang_rt.crt{begin,end}-<arch>.o
#   <gnu-triple>/lib/libunwind.a          (LLVM libunwind, static)
#   <gnu-triple>/lib/libgcc_s.a           (linker script INPUT(libunwind.a): Rust's
#                                          *-linux-gnu std asks for -lgcc_s; this
#                                          serves it from LLVM libunwind, no GCC)
# Consumed by scripts/setup/linux-cross-cc.shs; verified by
# scripts/check/check-linux-cross-no-libgcc.shs --run.
#
# Light by design (shared hosts): -j${JOBS:-4}, builtins + crt only.
# Needs: clang, ld.lld, llvm-ar, cmake, ninja, llvm-<ver>-dev, the Debian
# libc6-dev-<arch>-cross sysroots under /usr/<gnu-triple>.
#
# usage: sh scripts/setup/build-linux-cross-compiler-rt.shs [rv64 i686 armv7]
set -eu

ver=${LLVM_RT_VERSION:-18.1.3}
major=${ver%%.*}
prefix=${SIMPLE_CROSS_RT_PREFIX:-$HOME/.simple/toolchains/llvm-cross-rt-$major}
jobs=${JOBS:-4}
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
targets=${*:-rv64 i686 armv7}
src=$prefix/src/$ver
bld=$prefix/build
cc=${SIMPLE_CROSS_CLANG:-clang}
host_res=$($cc -print-resource-dir)
llvm_cmake=${LLVM_CMAKE_DIR:-/usr/lib/llvm-$major/lib/cmake/llvm}

mkdir -p "$src" "$bld" "$prefix/resource/lib/linux"
[ -e "$prefix/resource/include" ] || ln -s "$host_res/include" "$prefix/resource/include"

fetch() { # fetch <component> -> $src/<component>
    [ -d "$src/$1" ] && return 0
    _f=$1-$ver.src.tar.xz
    _u=https://github.com/llvm/llvm-project/releases/download/llvmorg-$ver/$_f
    [ -f "$src/$_f" ] || curl -fsSL -o "$src/$_f.part" "$_u"
    [ -f "$src/$_f" ] || mv "$src/$_f.part" "$src/$_f"
    echo "fetched $_f sha256=$(sha256sum "$src/$_f" | cut -d' ' -f1)"
    tar -C "$src" -xf "$src/$_f"
    mv "$src/$1-$ver.src" "$src/$1"
}
fetch cmake
fetch compiler-rt
fetch libunwind

for t in $targets; do
    gt=$(sh "$here/linux-cross-cc.shs" --gnu-triple "$t")
    case $t in rv64) ct=riscv64-linux-gnu ;; i686) ct=i686-linux-gnu ;; armv7) ct=armv7-linux-gnueabihf ;; esac
    echo "== $t ($ct)"

    # compiler-rt builtins + crt (standalone, default target only)
    b=$bld/compiler-rt-$t
    cmake -S "$src/compiler-rt" -B "$b" -G Ninja -Wno-dev \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER="$cc" -DCMAKE_CXX_COMPILER="${cc}++" -DCMAKE_ASM_COMPILER="$cc" \
        -DCMAKE_C_COMPILER_TARGET="$ct" -DCMAKE_CXX_COMPILER_TARGET="$ct" -DCMAKE_ASM_COMPILER_TARGET="$ct" \
        -DCMAKE_SYSROOT="/usr/$gt" -DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY \
        -DCMAKE_AR="$(command -v llvm-ar)" -DCMAKE_RANLIB="$(command -v llvm-ranlib)" \
        -DLLVM_CMAKE_DIR="$llvm_cmake" \
        -DCOMPILER_RT_DEFAULT_TARGET_ONLY=ON \
        -DCOMPILER_RT_BUILD_BUILTINS=ON -DCOMPILER_RT_BUILD_CRT=ON \
        -DCOMPILER_RT_BUILD_SANITIZERS=OFF -DCOMPILER_RT_BUILD_XRAY=OFF \
        -DCOMPILER_RT_BUILD_LIBFUZZER=OFF -DCOMPILER_RT_BUILD_PROFILE=OFF \
        -DCOMPILER_RT_BUILD_MEMPROF=OFF -DCOMPILER_RT_BUILD_ORC=OFF \
        -DCOMPILER_RT_BUILD_GWP_ASAN=OFF -DCOMPILER_RT_INCLUDE_TESTS=OFF \
        -DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=OFF >"$b.cmake.log" 2>&1 ||
        { tail -20 "$b.cmake.log"; exit 1; }
    ninja -C "$b" -j "$jobs" builtins crt >"$b.ninja.log" 2>&1 || { tail -20 "$b.ninja.log"; exit 1; }
    find "$b" \( -name 'libclang_rt.builtins-*.a' -o -name 'clang_rt.crt*.o' \) \
        -exec cp {} "$prefix/resource/lib/linux/" \;

    # LLVM libunwind, static, compiled directly (no C++ runtime needed)
    u=$bld/libunwind-$t; rm -rf "$u"; mkdir -p "$u"
    us=$src/libunwind/src
    for f in libunwind.cpp Unwind-EHABI.cpp UnwindLevel1.c UnwindLevel1-gcc-ext.c \
             Unwind-sjlj.c UnwindRegistersRestore.S UnwindRegistersSave.S; do
        case $f in *.cpp) x="-nostdinc++ -fno-exceptions -fno-rtti -std=c++17" ;; *.c) x="-std=c99" ;; *) x="" ;; esac
        # shellcheck disable=SC2086
        $cc --target="$ct" --sysroot="/usr/$gt" -O2 -fPIC -funwind-tables -fstrict-aliasing \
            -D_LIBUNWIND_IS_NATIVE_ONLY -DNDEBUG -I"$src/libunwind/include" $x \
            -c "$us/$f" -o "$u/${f%.*}.o"
    done
    mkdir -p "$prefix/$gt/lib"
    rm -f "$prefix/$gt/lib/libunwind.a"
    llvm-ar rcs "$prefix/$gt/lib/libunwind.a" "$u"/*.o
    echo 'INPUT(libunwind.a)' > "$prefix/$gt/lib/libgcc_s.a"
    ls "$prefix/resource/lib/linux" | tr '\n' ' '; echo
done
echo "BUILD_DONE prefix=$prefix"
