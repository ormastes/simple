#!/bin/sh
# Narrow privileged dispatcher for the headless GUI/Web/2D Vulkan setup lane.
# The called setup scripts remain the canonical implementation owners.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)

usage() {
    echo "usage: $0 --install-deps|--renderdoc-all|--vulkan-check" >&2
    exit 2
}

case "${1:-}" in
    --install-deps)
        shift
        [ "$#" -eq 0 ] || usage
        exec sudo -- apt-get install -y \
            git cmake ninja-build build-essential python3 python3-dev pkg-config \
            libvulkan-dev vulkan-tools libx11-dev libx11-xcb-dev libxcb1-dev \
            libxcb-keysyms1-dev libxcb-randr0-dev libxcb-xfixes0-dev \
            libxcb-sync-dev libxcb-icccm4-dev libxcb-image0-dev \
            libxcb-render-util0-dev libxkbcommon-dev libxkbcommon-x11-dev
        ;;
    --renderdoc-all)
        shift
        [ "$#" -eq 0 ] || usage
        exec sudo -- sh "$root/scripts/setup/build-renderdoc-linux-vulkan-only.shs" --all
        ;;
    --vulkan-check)
        shift
        [ "$#" -eq 0 ] || usage
        exec sudo -- sh "$root/scripts/setup/setup-gui-web-2d-vulkan-env.shs" --check
        ;;
    *) usage ;;
esac
