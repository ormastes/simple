#!/bin/sh
# Immutable official Linux X64 release; archive cache is rehashed before use.
set -eu
asset=LLVM-23.1.1-Linux-X64.tar.xz
required_sha=832aeb58d105de1cabc7b982dd2c65de0610f7377df48ae8fc2dd8e97420a15c
required_size=2014958380
fail() { echo "LLVM provisioning: $*" >&2; exit 1; }
[ "$(uname -s):$(uname -m)" = Linux:x86_64 ] || fail 'Linux x86_64 required'
prefix=${SIMPLE_LINUX_PHASE23_LLVM_PREFIX:?explicit installation prefix required}
case $prefix in /*) ;; *) fail 'absolute installation prefix required' ;; esac
[ ! -e "$prefix" ] || fail 'installation prefix already exists'
cache=${SIMPLE_LLVM23_ARCHIVE_CACHE:?explicit archive cache required}
case $cache in /*) ;; *) fail 'absolute archive cache required' ;; esac
mkdir -p "$cache" "$(dirname "$prefix")"
tmp=$(mktemp -d "$cache/.llvm-download.XXXXXX")
staging=""
trap 'rm -rf "$tmp"; [ -z "$staging" ] || rm -rf "$staging"' EXIT HUP INT TERM
archive=$cache/$asset
if [ ! -f "$archive" ]; then
    available=$(df -Pk "$cache" | awk 'END {print $4}')
    [ "$available" -ge 2097152 ] || fail 'insufficient disk for bounded release download'
    # Limit only the downloader's output file, not extracted tool/library sizes.
    (ulimit -f $(((required_size + 511) / 512));
     gh release download llvmorg-23.1.1 --repo llvm/llvm-project --pattern "$asset" --dir "$tmp")
    archive=$tmp/$asset
fi
[ "$(wc -c <"$archive" | tr -d ' ')" = "$required_size" ] || fail 'archive byte count differs from official asset'
actual_sha=$(sha256sum "$archive" | awk '{print $1}')
[ "$actual_sha" = "$required_sha" ] || fail 'archive digest differs from admitted release'
# Inspect only the authenticated archive. Account for expanded files before use.
tar -tvJf "$archive" >"$tmp/archive-list"
expanded_kib=$(awk '{if ($3 ~ /^[0-9]+$/) n += $3} END {printf "%.0f\n", (n + 1023) / 1024}' "$tmp/archive-list")
[ "$expanded_kib" -gt 0 ] || fail 'archive has no file-size manifest'
available=$(df -Pk "$(dirname "$prefix")" | awk 'END {print $4}')
[ "$available" -ge $((expanded_kib + 1048576)) ] || fail "insufficient disk for expanded release: ${expanded_kib} KiB plus reserve"
staging=$(mktemp -d "$(dirname "$prefix")/.llvm-install.XXXXXX")
tar -xJf "$archive" --strip-components=1 -C "$staging"
[ -x "$staging/bin/llvm-config" ] || fail 'authenticated archive lacks llvm-config'
[ -f "$staging/lib/libPolly.a" ] || fail 'authenticated archive lacks static Polly'
[ -f "$staging/lib/libPollyISL.a" ] || fail 'authenticated archive lacks static PollyISL'
set -- "$staging"/lib/libLLVM*.a
[ -f "$1" ] || fail 'authenticated archive lacks static LLVM libraries'
printf '%s\n' "$required_sha" >"$staging/.simple-llvm-release-sha256"
if [ "$archive" != "$cache/$asset" ]; then mv "$archive" "$cache/$asset"; fi
mv "$staging" "$prefix"
staging=""
printf 'installed_official_llvm=23.1.1 sha256=%s prefix=%s\n' "$required_sha" "$prefix"
