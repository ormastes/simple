#!/bin/sh
# Windows Git Bash default-lane bootstrap environment.
#
# Source this BEFORE scripts/bootstrap/bootstrap-from-scratch.sh (or
# scripts/check/check-bootstrap-preflight.shs) when driving a Windows Git Bash
# / MSYS2 lane:
#
#     . scripts/setup/windows-gitbash-bootstrap-env.shs
#
# Why this file exists (measured 2026-10-22, D:\dev\simple host):
#   1. src/compiler_rust/.cargo/config.toml pins the MSVC linker to the bare
#      name `lld-link`. PATH resolution then decides which lld-link runs, and
#      an MSYS2 mingw64 lld-link that fails with 0xc0000135 (missing runtime
#      DLLs when spawned by rustc) shadows the working LLVM one. The preflight
#      cargo probe fails with "linking with .../msys2/.../lld-link.exe failed:
#      exit code: 0xc0000135".
#   2. Workspace build scripts (e.g. simple-term-io) probe VCINSTALLDIR /
#      WindowsSdkDir / LIB and die (exit 101) when the MSVC + SDK environment
#      is absent -- the default Git Bash PATH carries none of it.
#
# This script fixes both: it prepends the newest discovered LLVM bin/ (the one
# that ships a working lld-link.exe) ahead of any MSYS2 directory, verifies the
# resolution, then chains scripts/setup/windows-msvc-bootstrap-env.shs for the
# MSVC/SDK environment. It is a no-op-safe re-source: repeated sourcing keeps
# the same ordering (single prepend, deduplicated).
#
# Cross-platform impact: NONE. Windows-only helper; sourced by nothing on Unix.

# Resolve this script's directory (works when sourced: BASH_SOURCE, else $0).
_wgbse_self=${BASH_SOURCE:-$0}
_wgbse_dir=$(CDPATH= cd -- "$(dirname -- "$_wgbse_self")" 2>/dev/null && pwd -P) || {
    echo "windows-gitbash-bootstrap-env: cannot resolve script directory" >&2
    return 1 2>/dev/null || exit 1
}

# ---- 1. LLVM bin/ with a working lld-link -------------------------------
# Pick the newest /c/dev/install/clang+llvm-*/bin that contains lld-link.exe.
# Honor a pre-set SIMPLE_LLVM_BIN (must contain lld-link.exe) so a caller with
# its own LLVM layout is never overridden.
if [ -n "${SIMPLE_LLVM_BIN:-}" ]; then
    _wgbse_llvm_bin=$SIMPLE_LLVM_BIN
else
    _wgbse_llvm_bin=
    for _wgbse_cand in $(ls -d /c/dev/install/clang+llvm-*/bin 2>/dev/null | sort -Vr); do
        if [ -x "$_wgbse_cand/lld-link.exe" ]; then
            _wgbse_llvm_bin=$_wgbse_cand
            break
        fi
    done
fi
[ -n "$_wgbse_llvm_bin" ] && [ -x "$_wgbse_llvm_bin/lld-link.exe" ] || {
    echo "windows-gitbash-bootstrap-env: no LLVM bin/ with lld-link.exe found" >&2
    echo "  (looked under /c/dev/install/clang+llvm-*/bin; set SIMPLE_LLVM_BIN)" >&2
    return 1 2>/dev/null || exit 1
}

# Prepend once: drop any prior copy of the same directory, then put it first.
# The chained MSVC setup below may prepend its own preferred LLVM bin (e.g. the
# LLVM 23 directory) ahead of ours; that is fine -- the invariant checked after
# chaining is that lld-link resolves to a WORKING one and not to MSYS2.
_wgbse_new_path=
_wgbse_old_ifs=$IFS
IFS=:
for _wgbse_dir_entry in $PATH; do
    [ "$_wgbse_dir_entry" = "$_wgbse_llvm_bin" ] && continue
    case ":$_wgbse_new_path:" in
        *:"$_wgbse_dir_entry":*) ;;
        ::) [ -z "$_wgbse_dir_entry" ] && continue ;;
    esac
    if [ -z "$_wgbse_new_path" ]; then
        _wgbse_new_path=$_wgbse_dir_entry
    else
        _wgbse_new_path=$_wgbse_new_path:$_wgbse_dir_entry
    fi
done
IFS=$_wgbse_old_ifs
PATH="$_wgbse_llvm_bin:$_wgbse_new_path"
export PATH

# ---- 2. MSVC + SDK environment ------------------------------------------
# Chains the existing MSVC lane setup (vswhere discovery of VC tools and
# Windows SDK; sets INCLUDE/LIB/PATH; may prepend its own LLVM bin).
# Fails closed if no VS install found.
. "$_wgbse_dir/windows-msvc-bootstrap-env.shs" || return 1

# ---- 3. Verify lld-link resolves to a working, non-MSYS2 binary ---------
_wgbse_resolved=$(command -v lld-link 2>/dev/null) || _wgbse_resolved=
case "$_wgbse_resolved" in
    */msys2/*)
        echo "windows-gitbash-bootstrap-env: lld-link resolves to MSYS2: '$_wgbse_resolved'" >&2
        echo "  (rustc cannot execute it: 0xc0000135). Fix PATH so an LLVM" >&2
        echo "  clang+llvm-*/bin precedes every MSYS2/mingw64 directory." >&2
        return 1 2>/dev/null || exit 1
        ;;
esac
[ -n "$_wgbse_resolved" ] || {
    echo "windows-gitbash-bootstrap-env: lld-link not on PATH" >&2
    return 1 2>/dev/null || exit 1
}
_wgbse_lld_version=$("$_wgbse_resolved" --version 2>/dev/null) || _wgbse_lld_version=
case "$_wgbse_lld_version" in
    LLD\ *.*.*) ;;
    *)
        echo "windows-gitbash-bootstrap-env: lld-link at '$_wgbse_resolved' does not run" >&2
        echo "  ('--version' did not print 'LLD x.y.z'). Point SIMPLE_LLVM_BIN at a" >&2
        echo "  working clang+llvm-*/bin directory." >&2
        return 1 2>/dev/null || exit 1
        ;;
esac

unset _wgbse_self _wgbse_dir _wgbse_llvm_bin _wgbse_cand _wgbse_new_path
unset _wgbse_old_ifs _wgbse_dir_entry _wgbse_resolved _wgbse_lld_version
