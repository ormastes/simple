#!/bin/sh
set -eu

# Provision the exact external checker pair used by FV2. Network resolution is
# pinned to reviewed commits; no floating branch output enters a receipt.
LEAN4EXPORT_COMMIT=4dc170805dc7abee5c8bcad72d879e2c37701cf1
NANODA_COMMIT=e5438ac0a85a036b6dfe093aa457bc3448498014
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
tool_dir="$repo_root/build/fv2-tools"
source_dir="$tool_dir/source"
toolchain_file="$repo_root/src/verification/mir_region_frame/lean-toolchain"
manifest="$tool_dir/manifest.txt"
adapter="$tool_dir/independent_replay_adapter"
adapter_tmp="$tool_dir/.independent_replay_adapter.tmp"
adapter_log="$tool_dir/independent_replay_adapter.build.log"

adapter_build_log_is_clean() {
    ! grep -Eiq 'runtime archive is STALE|Generating [0-9]+ stub functions|unresolved symbol preview|stub fallback' "$1"
}

if [ "${1:-}" = "--self-test" ]; then
    self_dir="$(mktemp -d)"
    trap 'rm -rf "$self_dir"' EXIT
    printf '%s\n' 'Build complete: 71 compiled, 0 cached, 0 failed' >"$self_dir/clean.log"
    printf '%s\n' 'error: runtime archive is STALE' >"$self_dir/stale.log"
    printf '%s\n' 'Generating 14 stub functions for unresolved symbols...' >"$self_dir/stub.log"
    adapter_build_log_is_clean "$self_dir/clean.log"
    if adapter_build_log_is_clean "$self_dir/stale.log"; then
        echo "FV2 setup self-test accepted stale runtime evidence" >&2
        exit 1
    fi
    if adapter_build_log_is_clean "$self_dir/stub.log"; then
        echo "FV2 setup self-test accepted unresolved-symbol stubs" >&2
        exit 1
    fi
    echo "STATUS: PASS FV2 independent replay setup fail-closed self-test"
    exit 0
fi

. "$repo_root/scripts/check/lib/require-self-hosted.shs"
require_self_hosted "${SIMPLE_BIN:-$repo_root/bin/simple}" "FV2 adapter compiler"

case "$source_dir" in
    "$repo_root"/build/fv2-tools/source) ;;
    *) echo "unsafe FV2 tool source path" >&2; exit 2 ;;
esac

rm -rf "$source_dir"
mkdir -p "$source_dir" "$tool_dir"
# A previous receipt must never survive a failed reprovisioning attempt.
rm -f "$manifest" "$adapter" "$adapter_tmp"
git clone --filter=blob:none --no-checkout https://github.com/ammkrn/lean4export.git "$source_dir/lean4export"
git -C "$source_dir/lean4export" checkout --detach "$LEAN4EXPORT_COMMIT"
if [ "$(sed -n '1p' "$toolchain_file")" != "leanprover/lean4:v4.33.0" ]; then
    echo "FV2 canonical Lean toolchain is not pinned to v4.33.0" >&2
    exit 3
fi
cp "$toolchain_file" "$source_dir/lean4export/lean-toolchain"
(cd "$source_dir/lean4export" && lake build)

git clone --filter=blob:none --no-checkout https://github.com/ammkrn/nanoda_lib.git "$source_dir/nanoda_lib"
git -C "$source_dir/nanoda_lib" checkout --detach "$NANODA_COMMIT"
(cd "$source_dir/nanoda_lib" && cargo build --release)

cp "$source_dir/lean4export/.lake/build/bin/lean4export" "$tool_dir/lean4export"
cp "$source_dir/nanoda_lib/target/release/nanoda_bin" "$tool_dir/nanoda_bin"

# Prove that the pinned exporter and checker speak the same format without
# enabling nanoda's Nat/String kernel extensions. Exporting only `id` keeps the
# smoke independent of project axioms and primitive literals.
compat_export="$tool_dir/compat-id.export"
compat_config="$tool_dir/compat-id.json"
reject_project="$repo_root/test/fixtures/formal_verification_2_0/independent_replay_reject"
reject_export="$tool_dir/compat-sorryAx.export"
reject_config="$tool_dir/compat-sorryAx.json"
(cd "$source_dir/lean4export" && lake env "$tool_dir/lean4export" Init -- id >"$compat_export")
{
    printf '{\n'
    printf '  "export_file_path": "%s",\n' "$compat_export"
    printf '  "use_stdin": false,\n'
    printf '  "permitted_axioms": ["propext", "Classical.choice", "Quot.sound"],\n'
    printf '  "unpermitted_axiom_hard_error": false,\n'
    printf '  "nat_extension": false,\n'
    printf '  "string_extension": false,\n'
    printf '  "print_success_message": true\n'
    printf '}\n'
} >"$compat_config"
compat_output="$($tool_dir/nanoda_bin "$compat_config")"
printf '%s\n' "$compat_output" | grep -Fq 'Checked 1 declarations with no errors' || {
    echo "FV2 exporter/checker compatibility smoke did not close" >&2
    exit 3
}

# Negative compatibility proof: an exact theorem root whose proof uses a
# project axiom must be rejected even though unreferenced forbidden declarations
# elsewhere in the imported environment are ignored.
lake -d "$reject_project" build >/dev/null
lake -d "$reject_project" env "$tool_dir/lean4export" \
    Fv2IndependentReplayReject -- Fv2IndependentReplayReject.admitted_root \
    >"$reject_export"
sed "s#${compat_export}#${reject_export}#" "$compat_config" >"$reject_config"
set +e
reject_output="$($tool_dir/nanoda_bin "$reject_config" 2>&1)"
reject_status=$?
set -e
[ "$reject_status" -ne 0 ] || {
    echo "FV2 exporter/checker compatibility smoke accepted a project axiom" >&2
    exit 3
}
printf '%s\n' "$reject_output" | grep -Eq 'ProjectAssumption|unknown constant|not found' || {
    echo "FV2 negative compatibility smoke failed for an unrelated reason" >&2
    exit 3
}

# The adapter must be compiled by the policy-required pure-Simple compiler.
# Capture the transcript because older admitted compilers have returned zero
# after reporting a stale runtime archive and synthesizing unresolved-symbol
# stubs. Either condition invalidates the adapter regardless of process status.
if ! SIMPLE_NO_STUB_FALLBACK=1 "$SELF_HOSTED_BIN" native-build \
    --source "$repo_root/src/compiler" \
    --source "$repo_root/src/app" \
    --source "$repo_root/src/lib" \
    --entry-closure \
    --entry "$repo_root/src/app/verify/independent_replay_adapter.spl" \
    --strip \
    --output "$adapter_tmp" >"$adapter_log" 2>&1; then
    tail -80 "$adapter_log" >&2
    echo "FV2 independent replay adapter build failed" >&2
    exit 4
fi
if ! adapter_build_log_is_clean "$adapter_log"; then
    tail -80 "$adapter_log" >&2
    echo "FV2 independent replay adapter build used stale or stubbed material" >&2
    exit 5
fi
[ -x "$adapter_tmp" ] || { echo "FV2 independent replay adapter output is missing" >&2; exit 6; }

# A no-argument invocation is a deterministic linkage smoke: the real adapter
# must execute its own argument gate and return exactly the documented class.
set +e
adapter_probe="$($adapter_tmp 2>&1)"
adapter_probe_status=$?
set -e
[ "$adapter_probe_status" -eq 2 ] || { echo "FV2 adapter linkage smoke returned $adapter_probe_status" >&2; exit 7; }
printf '%s\n' "$adapter_probe" | grep -Fq 'FV2-E-INDEPENDENT-ARGS' || {
    echo "FV2 adapter linkage smoke did not reach the argument gate" >&2
    exit 8
}
mv "$adapter_tmp" "$adapter"

{
    printf 'schema=FV2IndependentReplayTools-v1\n'
    printf 'lean4export_commit=%s\n' "$LEAN4EXPORT_COMMIT"
    printf 'nanoda_commit=%s\n' "$NANODA_COMMIT"
    printf 'lean_toolchain=leanprover/lean4:v4.33.0\n'
    printf 'lean4export_sha256=%s\n' "$(sha256sum "$tool_dir/lean4export" | awk '{print $1}')"
    printf 'nanoda_sha256=%s\n' "$(sha256sum "$tool_dir/nanoda_bin" | awk '{print $1}')"
    printf 'compat_export_sha256=%s\n' "$(sha256sum "$compat_export" | awk '{print $1}')"
    printf 'compat_output_sha256=%s\n' "$(printf '%s' "$compat_output" | sha256sum | awk '{print $1}')"
    printf 'reject_export_sha256=%s\n' "$(sha256sum "$reject_export" | awk '{print $1}')"
    printf 'reject_output_sha256=%s\n' "$(printf '%s' "$reject_output" | sha256sum | awk '{print $1}')"
    printf 'adapter_sha256=%s\n' "$(sha256sum "$tool_dir/independent_replay_adapter" | awk '{print $1}')"
    printf 'adapter_build_log_sha256=%s\n' "$(sha256sum "$adapter_log" | awk '{print $1}')"
    printf 'adapter_compiler_sha256=%s\n' "$(sha256sum "$SELF_HOSTED_BIN" | awk '{print $1}')"
} > "$manifest"

echo "FV2 independent replay tools provisioned at $tool_dir"
