#!/bin/sh
# LLVM/clang toolchain selection for this repo. SOURCE this file, do not run it:
#
#   . scripts/setup/llvm-toolchain-env.shs
#
# Pins the repo's C compiler and linker to LLVM 23 when it is
# available, falling back to the previously-pinned LLVM 20 and then to whatever
# bare `clang`/`cc` the host provides. Everything downstream keys off `CC`:
#
#   * scripts/check/check-c-runtime-compiles-push.shs   -- detect_cc() reads $CC first
#   * the Rust seed's native-build link driver           -- src/compiler_rust/common/src/
#                                                           platform/cc_detect.rs reads $CC
#                                                           before any probing
#   * any CMake/Make under src/runtime/                  -- standard CC/CXX
#
# LLVM 23 is deployed here WITHOUT root as an extracted apt.llvm.org tree (the
# host has no passwordless sudo). SIMPLE_LLVM_ROOT points at that tree; a normal
# root install of the clang-23 packages puts the same binaries on PATH and this
# script finds them there too. Override the whole decision with
# SIMPLE_LLVM_VERSION=20 (or any installed major) before sourcing.
#
# On WINDOWS the release layout differs (no version-suffixed binaries at all);
# see the Windows branch immediately below, which short-circuits the Unix logic.
#
# See doc/07_guide/infra/toolchain/llvm_23_deploy_2026-08-21.md.

# ---------------------------------------------------------------------------
# Windows C compilation uses LLVM 23.1.x. The default installation is the
# admitted 23.1.1 distribution; there is no Windows fallback to another major,
# MSVC cl.exe, MinGW GCC, or a C++ driver. Unix selection below is unchanged.
# A host that records llvm_win_root_23 in config/host/<hostname>.sdn supplies
# SIMPLE_HOST_LLVM_WIN_ROOT_23 (see scripts/setup/host-env.shs); it wins over the
# built-in default, and an explicit SIMPLE_LLVM_WIN_ROOT_23 still wins over both.
: "${SIMPLE_LLVM_WIN_ROOT_23:=${SIMPLE_HOST_LLVM_WIN_ROOT_23:-/c/dev/tool/clang+llvm-23.1.1-x86_64-pc-windows-msvc}}"
_simple_windows_host=0
case "$(uname -s 2>/dev/null || :)" in MINGW*|MSYS*|CYGWIN*) _simple_windows_host=1 ;; esac
[ "${OS:-}" != Windows_NT ] || _simple_windows_host=1
# An explicit Windows prefix also supports the platform-independent contract.
[ ! -f "${SIMPLE_LLVM_WIN_ROOT_23}/bin/clang-cl.exe" ] || _simple_windows_host=1
if [ "$_simple_windows_host" -eq 1 ]; then
  case "${SIMPLE_LLVM_VERSION:-23}" in
    23|23.1|23.1.[0-9]*) ;;
    *) echo "llvm-toolchain-env: Windows C requires LLVM 23.1.x" >&2; return 1 2>/dev/null || exit 1 ;;
  esac
  _simple_win_root="$SIMPLE_LLVM_WIN_ROOT_23"
  _simple_win_bin="${_simple_win_root}/bin"
  if command -v cygpath >/dev/null 2>&1; then
    _simple_win_bin="$(cygpath -m "$_simple_win_bin")" || { return 1 2>/dev/null || exit 1; }
    _simple_win_root="$(cygpath -u "$_simple_win_root")" || { return 1 2>/dev/null || exit 1; }
  fi
  _simple_win_cc="${_simple_win_bin}/clang-cl.exe"
  if [ ! -f "$_simple_win_cc" ] || ! _simple_win_version="$("$_simple_win_cc" --version 2>/dev/null)"; then
    echo "llvm-toolchain-env: required Windows C compiler is unavailable: $_simple_win_cc" >&2
    return 1 2>/dev/null || exit 1
  fi
  _simple_win_version="$(printf '%s\n' "$_simple_win_version" | sed -n '1s/^clang version \(23\.1\.[0-9][0-9]*\)\([[:space:]].*\)\{0,1\}$/\1/p')"
  if [ -z "$_simple_win_version" ]; then
    echo "llvm-toolchain-env: Windows C compiler must report LLVM 23.1.x" >&2
    return 1 2>/dev/null || exit 1
  fi
  case ":${PATH}:" in
    *":${_simple_win_root}/bin:"*) : ;;
    *) PATH="${_simple_win_root}/bin:${PATH}"; export PATH ;;
  esac
  # Emit MIXED-style paths (D:/... ) for the tool variables, not MSYS-style
  # (/d/... ).  $CC is consumed by NATIVE processes -- the Rust seed's
  # src/compiler_rust/common/src/platform/cc_detect.rs returns std::env::var("CC")
  # verbatim and spawns it -- and MSYS2 does not path-convert arbitrary env vars
  # when spawning a native binary, so CreateProcess would be handed a literal
  # "/d/..." it cannot resolve.  Mixed style is understood by BOTH CreateProcess
  # and an MSYS shell.  ($PATH is converted by MSYS automatically, which is why
  # the PATH entry above is left in MSYS style.) $_simple_win_bin is already
  # mixed-style from the cygpath -m conversion above.
  CC="$_simple_win_cc"
  # Cargo keys a target-specific C compiler override off CC_<target-with-underscores>;
  # the MSVC target build reads this directly rather than relying on Cargo's
  # generic CC fallback, so it must track CC exactly.
  CC_x86_64_pc_windows_msvc="$CC"
  unset CXX
  export CC CC_x86_64_pc_windows_msvc
  # LD is the MSVC-ABI linker (lld-link), NOT ld.lld -- ld.lld is the ELF
  # linker and would be wrong for a windows-msvc target.  The bare `ld.lld`
  # the seed probes for is still reachable via the PATH entry above.
  if [ -f "${_simple_win_bin}/lld-link.exe" ]; then
    LD="${_simple_win_bin}/lld-link.exe"
    SIMPLE_LLD="$LD"
    export LD SIMPLE_LLD
  fi
  if [ -f "${_simple_win_bin}/llvm-config.exe" ]; then
    LLVM_CONFIG="${_simple_win_bin}/llvm-config.exe"
    export LLVM_CONFIG
    _simple_win_prefix="$("$LLVM_CONFIG" --prefix 2>/dev/null || :)"
    if [ -n "$_simple_win_prefix" ]; then
      LLVM_SYS_231_PREFIX="$_simple_win_prefix"
      export LLVM_SYS_231_PREFIX
    fi
    unset _simple_win_prefix
  fi
  SIMPLE_LLVM_MAJOR=23
  SIMPLE_LLVM_ROOT="$_simple_win_root"
  SIMPLE_WINDOWS_C_COMPILER_VERSION="$_simple_win_version"
  export SIMPLE_LLVM_MAJOR SIMPLE_LLVM_ROOT SIMPLE_WINDOWS_C_COMPILER_VERSION
  unset _simple_windows_host _simple_win_root _simple_win_bin _simple_win_cc _simple_win_version
  return 0 2>/dev/null || exit 0
fi
unset _simple_windows_host
# ---------------------------------------------------------------------------

# Local (non-root) LLVM 23 prefix, if it was deployed that way. The
# /mnt/data default is a host-specific path (this dev box's no-root LLVM-23
# extraction); guard it with -d so an unrelated host does not export a
# nonexistent default (the -x check below already no-ops there, but this
# keeps SIMPLE_LLVM_ROOT itself from being set to a path that cannot exist,
# e.g. on macOS/FreeBSD where /mnt/data is not a convention at all).
if [ -z "${SIMPLE_LLVM_ROOT:-}" ] && [ -d /mnt/data/toolchains/llvm-23-root ]; then
  SIMPLE_LLVM_ROOT=/mnt/data/toolchains/llvm-23-root
fi
: "${SIMPLE_LLVM_ROOT:=}"
if [ -n "${SIMPLE_LLVM_ROOT}" ] && [ -x "${SIMPLE_LLVM_ROOT}/usr/bin/clang-23" ]; then
  # Two directories, both needed:
  #   usr/bin              -- version-suffixed names (clang-23, ld.lld-23, ...)
  #   usr/lib/llvm-23/bin  -- UNSUFFIXED names (clang, ld.lld, llvm-config)
  # The unsuffixed dir is load-bearing, not cosmetic. The seed's native link
  # step picks its linker by probing PATH for a bare `ld.lld`
  # (src/compiler_rust/compiler/src/pipeline/native_project/linker.rs:1972,
  # `use_direct_lld`) and never consults $CC/$LD for that decision. Without
  # this dir on PATH the C compiler is 23 while the actual link still runs the
  # host's bare ld.lld (18 here), which is exactly the split this pin exists to
  # remove. Ordering it ahead of /usr/bin is the no-root equivalent of
  # update-alternatives, and is scoped to shells that source this file rather
  # than changing the whole machine.
  for _d in "${SIMPLE_LLVM_ROOT}/usr/lib/llvm-23/bin" "${SIMPLE_LLVM_ROOT}/usr/bin"; do
    case ":${PATH}:" in
      *":${_d}:"*) : ;;
      *) PATH="${_d}:${PATH}"; export PATH ;;
    esac
  done
  unset _d
fi

# OS classification used only to pick a linker/archiver below (independent of
# the Windows short-circuit above, which already returned by this point).
_simple_llvm_uname="$(uname -s 2>/dev/null || :)"
case "${_simple_llvm_uname}" in
  Darwin)  _simple_llvm_os=macos ;;
  FreeBSD) _simple_llvm_os=freebsd ;;
  Linux)   _simple_llvm_os=linux ;;
  *)       _simple_llvm_os=other ;;
esac

# Pick a linker (LD/SIMPLE_LLD) and archiver (AR) for suffix $1 (e.g. "-23",
# "23", or "" for an unsuffixed layout), per the clang-only linker policy:
# mold on Linux where present, else ld.lld; ld64.lld on macOS; ld.lld on
# FreeBSD (mold has no Mach-O or PE/COFF backend). Tries the suffixed name
# first, then the bare name, so a version-suffixed clang paired with an
# unsuffixed lld/mold (common outside Debian-style packaging) still resolves.
_simple_llvm_select_linker() {
  _sfx="$1"
  LD=""
  case "${_simple_llvm_os}" in
    linux)
      if command -v mold >/dev/null 2>&1; then
        LD="mold"
      elif command -v "ld.lld${_sfx}" >/dev/null 2>&1; then
        LD="ld.lld${_sfx}"
      elif command -v ld.lld >/dev/null 2>&1; then
        LD="ld.lld"
      fi
      ;;
    macos)
      if command -v "ld64.lld${_sfx}" >/dev/null 2>&1; then
        LD="ld64.lld${_sfx}"
      elif command -v ld64.lld >/dev/null 2>&1; then
        LD="ld64.lld"
      fi
      ;;
    *)
      if command -v "ld.lld${_sfx}" >/dev/null 2>&1; then
        LD="ld.lld${_sfx}"
      elif command -v ld.lld >/dev/null 2>&1; then
        LD="ld.lld"
      fi
      ;;
  esac
  if [ -n "${LD}" ]; then
    SIMPLE_LLD="${LD}"
    export LD SIMPLE_LLD
  else
    unset LD
  fi
  if command -v "llvm-ar${_sfx}" >/dev/null 2>&1; then
    AR="llvm-ar${_sfx}"
  elif command -v llvm-ar >/dev/null 2>&1; then
    AR="llvm-ar"
  fi
  [ -z "${AR:-}" ] || export AR
  unset _sfx
}

# Preference order: explicit request, then 23, then the old 20 pin, then bare.
# Tries both the Debian-style "clang-NN" name and the separator-less "clangNN"
# name FreeBSD's pkg/ports clang uses (e.g. clang23), which the dash-only probe
# missed entirely.
_simple_llvm_pick=""
_simple_llvm_sep="-"
for _v in ${SIMPLE_LLVM_VERSION:-} 23 20; do
  [ -n "${_v}" ] || continue
  if command -v "clang-${_v}" >/dev/null 2>&1; then
    _simple_llvm_pick="${_v}"; _simple_llvm_sep="-"
    break
  elif command -v "clang${_v}" >/dev/null 2>&1; then
    _simple_llvm_pick="${_v}"; _simple_llvm_sep=""
    break
  fi
done

if [ -n "${_simple_llvm_pick}" ]; then
  CC="clang${_simple_llvm_sep}${_simple_llvm_pick}"
  CXX="clang++${_simple_llvm_sep}${_simple_llvm_pick}"
  export CC CXX
  _simple_llvm_select_linker "${_simple_llvm_sep}${_simple_llvm_pick}"
  if command -v "llvm-config${_simple_llvm_sep}${_simple_llvm_pick}" >/dev/null 2>&1; then
    LLVM_CONFIG="llvm-config${_simple_llvm_sep}${_simple_llvm_pick}"
    export LLVM_CONFIG
    # llvm-sys reads LLVM_SYS_<major><minor>_PREFIX. Export the one matching the
    # picked major so an llvm-sys bump does not also need an env change.
    _simple_llvm_prefix="$("${LLVM_CONFIG}" --prefix 2>/dev/null || true)"
    if [ -n "${_simple_llvm_prefix}" ]; then
      case "${_simple_llvm_pick}" in
        23) LLVM_SYS_231_PREFIX="${_simple_llvm_prefix}"; export LLVM_SYS_231_PREFIX ;;
        22) LLVM_SYS_221_PREFIX="${_simple_llvm_prefix}"; export LLVM_SYS_221_PREFIX ;;
        20) LLVM_SYS_201_PREFIX="${_simple_llvm_prefix}"; export LLVM_SYS_201_PREFIX ;;
        18) LLVM_SYS_180_PREFIX="${_simple_llvm_prefix}"; export LLVM_SYS_180_PREFIX ;;
      esac
    fi
    unset _simple_llvm_prefix
  fi
  SIMPLE_LLVM_MAJOR="${_simple_llvm_pick}"
  export SIMPLE_LLVM_MAJOR
else
  # No clang-NN / clangNN found on PATH. Fall back to well-known unsuffixed
  # install layouts that version-suffixed naming misses entirely: Homebrew on
  # macOS (bin/clang, no version in the name) and the FreeBSD llvmNN port's
  # own prefix (/usr/local/llvmNN/bin/clang, also unsuffixed inside that
  # prefix). These mirror the prefix candidates
  # scripts/setup/platform-detect.shs already searches (_llvm_prefixes),
  # without editing that file, which a different package owns.
  _simple_llvm_fallback_bin=""
  case "${_simple_llvm_os}" in
    macos)
      _simple_brew_prefix=""
      if command -v brew >/dev/null 2>&1; then
        _simple_brew_prefix="$(brew --prefix llvm 2>/dev/null || :)"
      fi
      for _p in "${_simple_brew_prefix}" /opt/homebrew/opt/llvm /usr/local/opt/llvm; do
        [ -n "${_p}" ] && [ -x "${_p}/bin/clang" ] || continue
        _simple_llvm_fallback_bin="${_p}/bin"
        break
      done
      unset _simple_brew_prefix
      ;;
    freebsd)
      for _v in ${SIMPLE_LLVM_VERSION:-} 23 20 18; do
        [ -n "${_v}" ] || continue
        for _p in "/usr/local/llvm${_v}" "/usr/local/llvm-${_v}"; do
          [ -x "${_p}/bin/clang" ] || continue
          _simple_llvm_fallback_bin="${_p}/bin"
          break
        done
        [ -z "${_simple_llvm_fallback_bin}" ] || break
      done
      ;;
  esac
  if [ -n "${_simple_llvm_fallback_bin}" ]; then
    case ":${PATH}:" in
      *":${_simple_llvm_fallback_bin}:"*) : ;;
      *) PATH="${_simple_llvm_fallback_bin}:${PATH}"; export PATH ;;
    esac
    CC="${_simple_llvm_fallback_bin}/clang"
    CXX="${_simple_llvm_fallback_bin}/clang++"
    export CC CXX
    _simple_llvm_select_linker ""
    if [ -x "${_simple_llvm_fallback_bin}/llvm-config" ]; then
      LLVM_CONFIG="${_simple_llvm_fallback_bin}/llvm-config"
      export LLVM_CONFIG
      _simple_llvm_prefix="$("${LLVM_CONFIG}" --prefix 2>/dev/null || :)"
      _simple_llvm_ver="$("${LLVM_CONFIG}" --version 2>/dev/null | cut -d. -f1)"
      if [ -n "${_simple_llvm_prefix}" ] && [ -n "${_simple_llvm_ver}" ]; then
        case "${_simple_llvm_ver}" in
          23) LLVM_SYS_231_PREFIX="${_simple_llvm_prefix}"; export LLVM_SYS_231_PREFIX ;;
          22) LLVM_SYS_221_PREFIX="${_simple_llvm_prefix}"; export LLVM_SYS_221_PREFIX ;;
          20) LLVM_SYS_201_PREFIX="${_simple_llvm_prefix}"; export LLVM_SYS_201_PREFIX ;;
          18) LLVM_SYS_180_PREFIX="${_simple_llvm_prefix}"; export LLVM_SYS_180_PREFIX ;;
        esac
        SIMPLE_LLVM_MAJOR="${_simple_llvm_ver}"
        export SIMPLE_LLVM_MAJOR
      fi
      unset _simple_llvm_prefix _simple_llvm_ver
    fi
    echo "llvm-toolchain-env: using unsuffixed clang at ${_simple_llvm_fallback_bin}/clang" >&2
  else
    echo "llvm-toolchain-env: no versioned clang found; leaving CC/CXX unset" >&2
  fi
  unset _simple_llvm_fallback_bin
fi
unset _simple_llvm_os _simple_llvm_uname _simple_llvm_sep
unset _simple_llvm_pick _v
