#!/bin/sh
# Initialize this FreeBSD user's canonical host config with all detected CPUs.
set -eu
[ "$#" -eq 0 ] || { echo 'usage: setup-freebsd-host.shs' >&2; exit 2; }
[ "$(uname -s)" = FreeBSD ] || { echo 'setup-freebsd-host: requires FreeBSD' >&2; exit 1; }
setup_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec sh "$setup_dir/host-env.shs" --init --all-cores
