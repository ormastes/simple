#!/bin/sh
set -eu

# Operator-only LLVM provider bootstrap. This script is never sourced or
# invoked by compiler/browser hot paths. Network access occurs only with the
# explicit --clone option.

TAG="llvmorg-23.1.0-rc2"
REPOSITORY="https://github.com/llvm/llvm-project.git"
SOURCE_DIR=""
BUILD_DIR="build/toolchains/llvm-23.1.0-rc2-build"
PREFIX="build/toolchains/llvm-23.1.0-rc2"
TARGETS="X86;AArch64;RISCV;WebAssembly"
JOBS=""
CLONE=0
VERIFY_ONLY=0

usage() {
    cat <<'EOF'
usage: build-llvm-23-1-provider.shs [options]

Build and install the signed llvmorg-23.1.0-rc2 provider used while stable
LLVM 23.1 is not yet available.

  --source-dir PATH   existing llvm-project checkout (required unless --clone)
  --clone             explicitly clone the pinned tag into --source-dir
  --build-dir PATH    CMake/Ninja build directory
  --prefix PATH       installation prefix
  --targets LIST      semicolon-separated LLVM targets
  --jobs N            parallel build jobs
  --verify-only       validate source tag and an existing installed provider
  --help              show this help

The default target set is X86;AArch64;RISCV;WebAssembly. No download occurs
unless --clone is passed. Tag signature verification is mandatory.
EOF
}

die() {
    printf 'llvm-23.1-provider: ERROR: %s\n' "$*" >&2
    exit 1
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --source-dir) [ "$#" -ge 2 ] || die "--source-dir requires a path"; SOURCE_DIR=$2; shift 2 ;;
        --clone) CLONE=1; shift ;;
        --build-dir) [ "$#" -ge 2 ] || die "--build-dir requires a path"; BUILD_DIR=$2; shift 2 ;;
        --prefix) [ "$#" -ge 2 ] || die "--prefix requires a path"; PREFIX=$2; shift 2 ;;
        --targets) [ "$#" -ge 2 ] || die "--targets requires a list"; TARGETS=$2; shift 2 ;;
        --jobs) [ "$#" -ge 2 ] || die "--jobs requires a count"; JOBS=$2; shift 2 ;;
        --verify-only) VERIFY_ONLY=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *) die "unknown argument: $1" ;;
    esac
done

[ -n "$SOURCE_DIR" ] || die "pass --source-dir (and --clone for an explicit network checkout)"
case "$TARGETS" in
    *[!A-Za-z0-9\;]*) die "--targets contains an invalid character" ;;
esac
case ";$TARGETS;" in
    *';X86;'*) : ;;
    *) die "--targets must include X86 for the SimpleOS/browser provider" ;;
esac
if [ -n "$JOBS" ]; then
    case "$JOBS" in *[!0-9]*|'') die "--jobs must be a positive integer" ;; esac
    [ "$JOBS" -gt 0 ] || die "--jobs must be a positive integer"
fi

command -v git >/dev/null 2>&1 || die "git is required"

if [ "$CLONE" -eq 1 ]; then
    [ "$VERIFY_ONLY" -eq 0 ] || die "--clone and --verify-only are mutually exclusive"
    [ ! -e "$SOURCE_DIR" ] || die "clone destination already exists: $SOURCE_DIR"
    git clone --filter=blob:none --single-branch --branch "$TAG" "$REPOSITORY" "$SOURCE_DIR"
fi

[ -d "$SOURCE_DIR/.git" ] || die "not an llvm-project Git checkout: $SOURCE_DIR"

# Verify both identity and the upstream cryptographic tag signature. Do not
# accept an unsigned branch or a commit merely named like the release tag.
git -C "$SOURCE_DIR" rev-parse -q --verify "refs/tags/$TAG" >/dev/null \
    || die "checkout does not contain pinned tag $TAG"
git -C "$SOURCE_DIR" verify-tag "$TAG" >/dev/null 2>&1 \
    || die "signature verification failed for $TAG; configure Git's trusted LLVM release signing key"
tag_commit=$(git -C "$SOURCE_DIR" rev-list -n 1 "$TAG")
head_commit=$(git -C "$SOURCE_DIR" rev-parse HEAD)
[ "$head_commit" = "$tag_commit" ] \
    || die "HEAD $head_commit is not pinned tag commit $tag_commit"

validate_provider() {
    clang_bin="$PREFIX/bin/clang"
    lld_bin="$PREFIX/bin/ld.lld"
    llvm_config_bin="$PREFIX/bin/llvm-config"
    llvm_ar_bin="$PREFIX/bin/llvm-ar"
    llvm_objcopy_bin="$PREFIX/bin/llvm-objcopy"
    [ -x "$clang_bin" ] || die "missing installed clang: $clang_bin"
    [ -x "$lld_bin" ] || die "missing installed ld.lld: $lld_bin"
    [ -x "$llvm_config_bin" ] || die "missing installed llvm-config: $llvm_config_bin"
    [ -x "$llvm_ar_bin" ] || die "missing installed llvm-ar: $llvm_ar_bin"
    [ -x "$llvm_objcopy_bin" ] || die "missing installed llvm-objcopy: $llvm_objcopy_bin"
    clang_version=$($clang_bin --version | sed -n '1p')
    lld_version=$($lld_bin --version | sed -n '1p')
    llvm_version=$($llvm_config_bin --version)
    llvm_ar_version=$($llvm_ar_bin --version)
    printf '%s\n' "$clang_version" | grep -Eq 'clang version 23\.1\.0([^0-9]|$)' \
        || die "clang is not LLVM 23.1.0: $clang_version"
    printf '%s\n' "$lld_version" | grep -Eq 'LLD 23\.1\.0([^0-9]|$)' \
        || die "ld.lld is not LLVM 23.1.0: $lld_version"
    printf '%s\n' "$llvm_version" | grep -Eq '^23\.1\.0([^0-9]|$)' \
        || die "llvm-config is not LLVM 23.1.0: $llvm_version"
    printf '%s\n' "$llvm_ar_version" | grep -Eq 'LLVM version 23\.1\.0([^0-9]|$)' \
        || die "llvm-ar is not LLVM 23.1.0: $llvm_ar_version"
    printf 'LLVM_23_1_PREFIX=%s\nCLANG=%s\nLINKER=%s\nLLVM_AR=%s\nLLVM_OBJCOPY=%s\nLLVM_CONFIG=%s\nLLVM_TAG=%s\nLLVM_TAG_COMMIT=%s\n' \
        "$PREFIX" "$clang_bin" "$lld_bin" "$llvm_ar_bin" "$llvm_objcopy_bin" "$llvm_config_bin" "$TAG" "$tag_commit"
}

if [ "$VERIFY_ONLY" -eq 1 ]; then
    validate_provider
    exit 0
fi

command -v cmake >/dev/null 2>&1 || die "cmake is required"
command -v ninja >/dev/null 2>&1 || die "ninja is required"

cmake -S "$SOURCE_DIR/llvm" -B "$BUILD_DIR" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$PREFIX" \
    -DLLVM_ENABLE_PROJECTS='clang;lld' \
    -DLLVM_DISTRIBUTION_COMPONENTS='clang;lld;llvm-ar;llvm-objcopy;llvm-config' \
    -DLLVM_TARGETS_TO_BUILD="$TARGETS" \
    -DLLVM_INCLUDE_TESTS=OFF \
    -DLLVM_INCLUDE_EXAMPLES=OFF \
    -DLLVM_INCLUDE_BENCHMARKS=OFF \
    -DLLVM_ENABLE_TERMINFO=OFF \
    -DLLVM_ENABLE_ZSTD=OFF

if [ -n "$JOBS" ]; then
    cmake --build "$BUILD_DIR" --target install-distribution --parallel "$JOBS"
else
    cmake --build "$BUILD_DIR" --target install-distribution --parallel
fi

validate_provider
