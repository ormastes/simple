#!/bin/sh
set -eu

# Operator-only LLVM provider bootstrap. This script is never sourced or
# invoked by compiler/browser hot paths. Network access occurs only with the
# explicit --clone option.

TAG="llvmorg-23.1.0-rc2"
TAG_COMMIT="561093d94eb7156dea780c1c71a779824ef90e5b"
REPOSITORY="https://github.com/llvm/llvm-project.git"
SOURCE_DIR=""
BUILD_DIR="build/toolchains/llvm-23.1.0-rc2-build"
PREFIX="build/toolchains/llvm-23.1.0-rc2"
TARGETS="X86;AArch64;RISCV;WebAssembly"
JOBS=""
CLONE=0
VERIFY_ONLY=0
PRINT_HOST_COMPILERS=0

usage() {
    cat <<'EOF'
usage: build-llvm-23-1-provider.shs [options]

Build and install the signed llvmorg-23.1.0-rc2 provider used while stable
LLVM 23.1 is not yet available.

  --source-dir PATH   existing llvm-project checkout (required unless --clone)
  --clone             explicitly clone the pinned tag into --source-dir
  --build-dir PATH    CMake/Ninja build directory
  --prefix PATH       installation prefix
  --targets LIST      semicolon-separated LLVM targets
  --jobs N            parallel build jobs
  --verify-only       validate source tag and an existing installed provider
  --print-host-compilers  resolve Clang C/C++ host compilers without building
  --toolchain-self-test   check host Clang selection without building
  --help              show this help

The default target set is X86;AArch64;RISCV;WebAssembly. No download occurs
unless --clone is passed. Tag signature verification is mandatory.
Builds use Clang and clang++ as host compilers; CC/CXX/CLANG overrides must
resolve to Clang binaries. GCC and G++ are rejected.
EOF
}

die() {
    printf 'llvm-23.1-provider: ERROR: %s\n' "$*" >&2
    exit 1
}

canonical_path() {
    command -v realpath >/dev/null 2>&1 || die "realpath is required to attest provider paths"
    realpath "$1" || die "could not resolve path: $1"
}

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v sha256 >/dev/null 2>&1; then
        sha256 -q "$1"
    else
        die "a SHA-256 utility is required to attest provider tools"
    fi
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --source-dir) [ "$#" -ge 2 ] || die "--source-dir requires a path"; SOURCE_DIR=$2; shift 2 ;;
        --clone) CLONE=1; shift ;;
        --build-dir) [ "$#" -ge 2 ] || die "--build-dir requires a path"; BUILD_DIR=$2; shift 2 ;;
        --prefix) [ "$#" -ge 2 ] || die "--prefix requires a path"; PREFIX=$2; shift 2 ;;
        --targets) [ "$#" -ge 2 ] || die "--targets requires a list"; TARGETS=$2; shift 2 ;;
        --jobs) [ "$#" -ge 2 ] || die "--jobs requires a count"; JOBS=$2; shift 2 ;;
        --verify-only) VERIFY_ONLY=1; shift ;;
        --print-host-compilers) PRINT_HOST_COMPILERS=1; shift ;;
        --toolchain-self-test) TOOLCHAIN_SELF_TEST=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *) die "unknown argument: $1" ;;
    esac
done

resolve_clang_host_compiler() {
    compiler_name=$1
    compiler_role=$2
    compiler_path=$(command -v "$compiler_name" 2>/dev/null) || die "missing Clang $compiler_role: $compiler_name"
    case "$("$compiler_path" --version 2>/dev/null | sed -n '1p')" in
        *clang\ version*) printf '%s\n' "$compiler_path" ;;
        *) die "$compiler_role must be Clang: $compiler_name" ;;
    esac
}

clangxx_companion() {
    clang_c=$1
    clang_base=$(basename "$clang_c")
    case "$clang_base" in
        clang*) clang_cpp="clang++${clang_base#clang}" ;;
        *) clang_cpp=clang++ ;;
    esac
    case "$clang_c" in
        */*) printf '%s/%s\n' "$(dirname "$clang_c")" "$clang_cpp" ;;
        *) printf '%s\n' "$clang_cpp" ;;
    esac
}

toolchain_self_test() (
    fixture=$(mktemp -d "${TMPDIR:-/tmp}/simpleos-llvm-host-clang.XXXXXX") || exit 1
    trap 'rm -rf "$fixture"' EXIT HUP INT TERM
    for tool in clang clang++ clang-18 clang++-18 other-clang gcc g++; do
        case "$tool" in clang*|other-clang) name=clang ;; *) name=gcc ;; esac
        printf '#!/bin/sh\necho "%s version 18.1.0"\n' "$name" >"$fixture/$tool"
        chmod +x "$fixture/$tool"
    done
    selected=$(CC="$fixture/clang" CXX="$fixture/clang++" CLANG="$fixture/clang" sh "$0" --print-host-compilers)
    printf '%s\n' "$selected" | grep -qx "CC=$fixture/clang"
    printf '%s\n' "$selected" | grep -qx "CXX=$fixture/clang++"
    printf '%s\n' "$selected" | grep -qx "CLANG=$fixture/clang"
    versioned=$(CC="$fixture/clang-18" sh "$0" --print-host-compilers)
    printf '%s\n' "$versioned" | grep -qx "CXX=$fixture/clang++-18"
    if CC="$fixture/gcc" CXX="$fixture/g++" sh "$0" --print-host-compilers >/dev/null 2>&1; then
        echo 'FAIL: GCC host compilers were accepted' >&2
        exit 1
    fi
    if CC="$fixture/clang" CLANG="$fixture/other-clang" CXX="$fixture/clang++" \
        sh "$0" --print-host-compilers >/dev/null 2>&1; then
        echo 'FAIL: distinct Clang CC and CLANG were accepted' >&2
        exit 1
    fi
    printf 'PASS: LLVM provider builder selects Clang and rejects GCC host compilers\n'
)

if [ "${TOOLCHAIN_SELF_TEST:-0}" -eq 1 ]; then
    toolchain_self_test
    exit 0
fi

if [ "$VERIFY_ONLY" -eq 0 ] || [ "$PRINT_HOST_COMPILERS" -eq 1 ]; then
    HOST_CC=$(resolve_clang_host_compiler "${CC:-${CLANG:-clang}}" C)
    HOST_CXX=$(resolve_clang_host_compiler "${CXX:-${CLANGXX:-$(clangxx_companion "$HOST_CC")}}" C++)
    if [ -n "${CC:-}" ] && [ -n "${CLANG:-}" ]; then
        [ "$(resolve_clang_host_compiler "$CC" C)" = "$(resolve_clang_host_compiler "$CLANG" C)" ] ||
            die "CC and CLANG select different compilers"
    fi
fi
if [ "$PRINT_HOST_COMPILERS" -eq 1 ]; then
    printf 'CC=%s\nCXX=%s\nCLANG=%s\n' "$HOST_CC" "$HOST_CXX" "$HOST_CC"
    exit 0
fi

[ -n "$SOURCE_DIR" ] || die "pass --source-dir (and --clone for an explicit network checkout)"
case "$TARGETS" in
    *[!A-Za-z0-9\;]*) die "--targets contains an invalid character" ;;
esac
case ";$TARGETS;" in
    *';X86;'*) : ;;
    *) die "--targets must include X86 for the SimpleOS/browser provider" ;;
esac
if [ -n "$JOBS" ]; then
    case "$JOBS" in *[!0-9]*|'') die "--jobs must be a positive integer" ;; esac
    [ "$JOBS" -gt 0 ] || die "--jobs must be a positive integer"
fi

command -v git >/dev/null 2>&1 || die "git is required"

if [ "$CLONE" -eq 1 ]; then
    [ "$VERIFY_ONLY" -eq 0 ] || die "--clone and --verify-only are mutually exclusive"
    [ ! -e "$SOURCE_DIR" ] || die "clone destination already exists: $SOURCE_DIR"
    git clone --filter=blob:none --single-branch --branch "$TAG" "$REPOSITORY" "$SOURCE_DIR"
fi

[ -d "$SOURCE_DIR/.git" ] || die "not an llvm-project Git checkout: $SOURCE_DIR"

# Verify both identity and the upstream cryptographic tag signature. Do not
# accept an unsigned branch or a commit merely named like the release tag.
git -C "$SOURCE_DIR" rev-parse -q --verify "refs/tags/$TAG" >/dev/null \
    || die "checkout does not contain pinned tag $TAG"
git -C "$SOURCE_DIR" verify-tag "$TAG" >/dev/null 2>&1 \
    || die "signature verification failed for $TAG; configure Git's trusted LLVM release signing key"
tag_commit=$(git -C "$SOURCE_DIR" rev-list -n 1 "$TAG")
[ "$tag_commit" = "$TAG_COMMIT" ] \
    || die "pinned tag $TAG resolved to $tag_commit, expected $TAG_COMMIT"
head_commit=$(git -C "$SOURCE_DIR" rev-parse HEAD)
[ "$head_commit" = "$tag_commit" ] \
    || die "HEAD $head_commit is not pinned tag commit $tag_commit"

validate_provider() {
    clang_bin="$PREFIX/bin/clang"
    clangxx_bin="$PREFIX/bin/clang++"
    lld_bin="$PREFIX/bin/ld.lld"
    llvm_config_bin="$PREFIX/bin/llvm-config"
    llvm_ar_bin="$PREFIX/bin/llvm-ar"
    llvm_as_bin="$PREFIX/bin/llvm-as"
    opt_bin="$PREFIX/bin/opt"
    llc_bin="$PREFIX/bin/llc"
    llvm_objcopy_bin="$PREFIX/bin/llvm-objcopy"
    [ -x "$clang_bin" ] || die "missing installed clang: $clang_bin"
    [ -x "$clangxx_bin" ] || die "missing installed clang++: $clangxx_bin"
    [ -x "$lld_bin" ] || die "missing installed ld.lld: $lld_bin"
    [ -x "$llvm_config_bin" ] || die "missing installed llvm-config: $llvm_config_bin"
    [ -x "$llvm_ar_bin" ] || die "missing installed llvm-ar: $llvm_ar_bin"
    [ -x "$llvm_as_bin" ] || die "missing installed llvm-as: $llvm_as_bin"
    [ -x "$opt_bin" ] || die "missing installed opt: $opt_bin"
    [ -x "$llc_bin" ] || die "missing installed llc: $llc_bin"
    [ -x "$llvm_objcopy_bin" ] || die "missing installed llvm-objcopy: $llvm_objcopy_bin"
    prefix_real=$(canonical_path "$PREFIX")
    clangxx_invocation="$prefix_real/bin/clang++"
    source_real=$(canonical_path "$SOURCE_DIR")
    clang_bin=$(canonical_path "$clang_bin")
    clangxx_bin=$(canonical_path "$clangxx_bin")
    lld_bin=$(canonical_path "$lld_bin")
    llvm_config_bin=$(canonical_path "$llvm_config_bin")
    llvm_ar_bin=$(canonical_path "$llvm_ar_bin")
    llvm_as_bin=$(canonical_path "$llvm_as_bin")
    opt_bin=$(canonical_path "$opt_bin")
    llc_bin=$(canonical_path "$llc_bin")
    llvm_objcopy_bin=$(canonical_path "$llvm_objcopy_bin")
    for provider_bin in "$clang_bin" "$clangxx_bin" "$lld_bin" "$llvm_config_bin" "$llvm_ar_bin" \
        "$llvm_as_bin" "$opt_bin" "$llc_bin" "$llvm_objcopy_bin"; do
        case "$provider_bin" in
            "$prefix_real"/bin/*) ;;
            *) die "provider tool escapes installed prefix: $provider_bin" ;;
        esac
    done
    clang_version=$($clang_bin --version | sed -n '1p')
    clangxx_version=$($clangxx_bin --version | sed -n '1p')
    lld_version=$($lld_bin --version | sed -n '1p')
    llvm_version=$($llvm_config_bin --version)
    llvm_ar_version=$($llvm_ar_bin --version)
    llvm_as_version=$($llvm_as_bin --version)
    opt_version=$($opt_bin --version)
    llc_version=$($llc_bin --version)
    printf '%s\n' "$clang_version" | grep -Eq 'clang version 23\.1\.0([^0-9]|$)' \
        || die "clang is not LLVM 23.1.0: $clang_version"
    printf '%s\n' "$clangxx_version" | grep -Eq 'clang version 23\.1\.0([^0-9]|$)' \
        || die "clang++ is not LLVM 23.1.0: $clangxx_version"
    printf '%s\n' "$lld_version" | grep -Eq 'LLD 23\.1\.0([^0-9]|$)' \
        || die "ld.lld is not LLVM 23.1.0: $lld_version"
    printf '%s\n' "$llvm_version" | grep -Eq '^23\.1\.0([^0-9]|$)' \
        || die "llvm-config is not LLVM 23.1.0: $llvm_version"
    printf '%s\n' "$llvm_ar_version" | grep -Eq 'LLVM version 23\.1\.0([^0-9]|$)' \
        || die "llvm-ar is not LLVM 23.1.0: $llvm_ar_version"
    printf '%s\n' "$llvm_as_version" | grep -Eq 'LLVM version 23\.1\.0([^0-9]|$)' \
        || die "llvm-as is not LLVM 23.1.0: $llvm_as_version"
    printf '%s\n' "$opt_version" | grep -Eq 'LLVM version 23\.1\.0([^0-9]|$)' \
        || die "opt is not LLVM 23.1.0: $opt_version"
    printf '%s\n' "$llc_version" | grep -Eq 'LLVM version 23\.1\.0([^0-9]|$)' \
        || die "llc is not LLVM 23.1.0: $llc_version"
    printf 'LLVM_23_1_PROVIDER_SCHEMA=llvm-23.1-provider-v2\nLLVM_23_1_PREFIX=%s\nLLVM_SOURCE_DIR=%s\nLLVM_TARGETS=%s\nCLANG=%s\nCLANG_SHA256=%s\nCLANGXX=%s\nCLANGXX_SHA256=%s\nLINKER=%s\nLINKER_SHA256=%s\nLLVM_AR=%s\nLLVM_AR_SHA256=%s\nLLVM_AS=%s\nLLVM_AS_SHA256=%s\nLLVM_OPT=%s\nLLVM_OPT_SHA256=%s\nLLVM_LLC=%s\nLLVM_LLC_SHA256=%s\nLLVM_OBJCOPY=%s\nLLVM_OBJCOPY_SHA256=%s\nLLVM_CONFIG=%s\nLLVM_CONFIG_SHA256=%s\nLLVM_TAG=%s\nLLVM_TAG_COMMIT=%s\n' \
        "$prefix_real" "$source_real" "$TARGETS" "$clang_bin" "$(sha256_file "$clang_bin")" \
        "$clangxx_invocation" "$(sha256_file "$clangxx_bin")" \
        "$lld_bin" "$(sha256_file "$lld_bin")" \
        "$llvm_ar_bin" "$(sha256_file "$llvm_ar_bin")" \
        "$llvm_as_bin" "$(sha256_file "$llvm_as_bin")" \
        "$opt_bin" "$(sha256_file "$opt_bin")" \
        "$llc_bin" "$(sha256_file "$llc_bin")" \
        "$llvm_objcopy_bin" "$(sha256_file "$llvm_objcopy_bin")" \
        "$llvm_config_bin" "$(sha256_file "$llvm_config_bin")" \
        "$TAG" "$tag_commit"
}

if [ "$VERIFY_ONLY" -eq 1 ]; then
    validate_provider
    exit 0
fi

command -v cmake >/dev/null 2>&1 || die "cmake is required"
command -v ninja >/dev/null 2>&1 || die "ninja is required"

cmake -S "$SOURCE_DIR/llvm" -B "$BUILD_DIR" -G Ninja \
    -DCMAKE_C_COMPILER="$HOST_CC" -DCMAKE_CXX_COMPILER="$HOST_CXX" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$PREFIX" \
    -DLLVM_ENABLE_PROJECTS='clang;lld' \
    -DLLVM_DISTRIBUTION_COMPONENTS='clang;lld;llvm-ar;llvm-as;opt;llc;llvm-objcopy;llvm-config' \
    -DLLVM_TARGETS_TO_BUILD="$TARGETS" \
    -DLLVM_INCLUDE_TESTS=OFF \
    -DLLVM_INCLUDE_EXAMPLES=OFF \
    -DLLVM_INCLUDE_BENCHMARKS=OFF \
    -DLLVM_ENABLE_TERMINFO=OFF \
    -DLLVM_ENABLE_ZSTD=OFF

if [ -n "$JOBS" ]; then
    cmake --build "$BUILD_DIR" --target install-distribution --parallel "$JOBS"
else
    cmake --build "$BUILD_DIR" --target install-distribution --parallel
fi

validate_provider
