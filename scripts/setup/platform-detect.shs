#!/bin/sh
# Platform detection — sourced by bootstrap scripts.
# Sets: PLATFORM_TRIPLE, PLATFORM_ARCH, PLATFORM_OS

PLATFORM_ARCH="$(uname -m)"
PLATFORM_UNAME="$(uname -s)"
case "${PLATFORM_UNAME}" in
  Linux)   PLATFORM_OS="linux"   ;;
  Darwin)  PLATFORM_OS="macos"   ;;
  FreeBSD) PLATFORM_OS="freebsd" ;;
  MINGW*|MSYS*|CYGWIN*|Windows*) PLATFORM_OS="windows" ;;
  SimpleOS|simpleos) PLATFORM_OS="simpleos" ;;
  *)       PLATFORM_OS="unknown" ;;
esac

# Allow an explicit override (e.g. cross-targeting SimpleOS from another host).
[ -n "${SIMPLE_TARGET_OS:-}" ] && PLATFORM_OS="${SIMPLE_TARGET_OS}"

case "${PLATFORM_ARCH}" in
  x86_64|amd64) PLATFORM_ARCH="x86_64" ;;
  aarch64|arm64) PLATFORM_ARCH="aarch64" ;;
  riscv64) PLATFORM_ARCH="riscv64" ;;
  riscv)
    if [ "${PLATFORM_UNAME}" = FreeBSD ]; then
      case "$(uname -p 2>/dev/null)" in
        riscv64) PLATFORM_ARCH="riscv64" ;;
        *) echo 'error: unsupported FreeBSD RISC-V processor' >&2; return 1 2>/dev/null || exit 1 ;;
      esac
    fi
    ;;
esac

PLATFORM_ABI=""
case "${PLATFORM_OS}" in
  linux)    PLATFORM_TRIPLE="${PLATFORM_ARCH}-unknown-linux-gnu" ;;
  macos)    PLATFORM_TRIPLE="${PLATFORM_ARCH}-apple-darwin" ;;
  freebsd)  PLATFORM_TRIPLE="${PLATFORM_ARCH}-unknown-freebsd" ;;
  windows)
    # Single source of truth for the Windows ABI default: gnu (MinGW UCRT, the
    # repo-managed llvm-mingw toolchain). MSVC is opt-in via
    # SIMPLE_WINDOWS_ABI=msvc (bootstrap-windows.sh --msvc). Git Bash always
    # sets MSYSTEM=MINGW64 regardless of ABI, so the default is this explicit
    # value, never keyed off MSYSTEM.
    PLATFORM_ABI="${SIMPLE_WINDOWS_ABI:-gnu}"
    case "${PLATFORM_ABI}" in
      gnu|msvc) ;;
      *) echo "error: SIMPLE_WINDOWS_ABI must be gnu or msvc" >&2; return 1 2>/dev/null || exit 1 ;;
    esac
    PLATFORM_TRIPLE="${PLATFORM_ARCH}-pc-windows-${PLATFORM_ABI}"
    ;;
  simpleos) PLATFORM_TRIPLE="${PLATFORM_ARCH}-unknown-simpleos" ;;
  *)        PLATFORM_TRIPLE="${PLATFORM_ARCH}-unknown-${PLATFORM_OS}" ;;
esac

# Cargo uses riscv64gc for Linux and FreeBSD; Simple artifact paths use riscv64.
# Windows GNU builds Rust as LLVM-native gnullvm (compiler-rt + libunwind, no libgcc).
case "${PLATFORM_TRIPLE}" in
  riscv64-unknown-linux-gnu) PLATFORM_RUST_TRIPLE="riscv64gc-unknown-linux-gnu" ;;
  riscv64-unknown-freebsd) PLATFORM_RUST_TRIPLE="riscv64gc-unknown-freebsd" ;;
  x86_64-pc-windows-gnu) PLATFORM_RUST_TRIPLE="x86_64-pc-windows-gnullvm" ;;
  *) PLATFORM_RUST_TRIPLE="${PLATFORM_TRIPLE}" ;;
esac

export PLATFORM_TRIPLE PLATFORM_RUST_TRIPLE PLATFORM_ARCH PLATFORM_OS PLATFORM_ABI

# ---------------------------------------------------------------------------
# Toolchain detection (shared interface): LLVM prefix/lib — version- and
# platform-parameterized, no hardcoded single version or path.
#
# LLVM_VERSIONS is the preference order of major versions to accept (first one
# found wins). The default is LLVM 23, matching the Rust compiler binding.
# LLVM 23 is admitted by MAJOR version only (owner decision 2026-10-22): any
# 23.x.y passes; anything other than the reference 23.1.1 prints a warning.
#
# Resolves ONCE and feeds the env both downstream worlds consult, so the shell
# build and the Simple runtime share a single resolution:
#   LLVM_SYS_231_PREFIX      -> Rust LLVM 23.1 binding
#   LLVM_SYS_<major>0_PREFIX -> other llvm-sys versions
#   SIMPLE_LLVM_PATH         -> Simple runtime loader (src/lib/.../sffi/llvm_loader.spl)
# Sets: LLVM_FOUND (0/1), LLVM_VERSION, LLVM_PREFIX, LLVM_LIBDIR, LLVM_LIB.
: "${LLVM_VERSIONS:=23}"

LLVM_FOUND=0
LLVM_VERSION=""
LLVM_PREFIX=""
LLVM_LIBDIR=""
LLVM_LIB=""
LLVM_PROVIDER_KIND=""
_llvm_gnu_missing_import=""

# Shared-library basenames to look for, by OS, for major version $1.
_llvm_lib_names() {
  case "${PLATFORM_OS}" in
    macos)   echo "libLLVM.dylib libLLVM-$1.dylib" ;;
    windows) if [ "${PLATFORM_ABI}" = gnu ]; then echo "libLLVM-$1.dll"; else echo "LLVM-C.dll libLLVM.dll"; fi ;;
    *)       echo "libLLVM-$1.so libLLVM.so.$1 libLLVM.so.1 libLLVM.so" ;;  # linux/freebsd/simpleos
  esac
}

# Subdirs under a prefix that hold the shared library (DLLs live in bin on Windows).
_llvm_libdirs() {
  case "${PLATFORM_OS}" in
    windows) printf '%s\n' bin lib ;;
    *)       printf '%s\n' lib lib64 ;;
  esac
}

# Repo-managed per-user toolchain store (scripts/setup/host-env.shs also reads it).
: "${SIMPLE_TOOLCHAINS_ROOT:=${HOME:-/nonexistent}/.simple/toolchains}"

# Print existing dirs matching "$SIMPLE_TOOLCHAINS_ROOT/$1[/$2]", newest first.
_simple_toolchain_prefixes() {
  for _stp in "${SIMPLE_TOOLCHAINS_ROOT}"/$1${2:+/$2}; do
    [ -d "${_stp}" ] && printf '%s\n' "${_stp}"
  done | sort -r
}

# Well-known install prefixes (newline-separated, so paths may contain spaces),
# by OS, for major version $1.
_llvm_prefixes() {
  case "${PLATFORM_OS}" in
    linux|simpleos)
      printf '%s\n' "/usr/lib/llvm-$1" "/usr/lib/llvm$1" "/usr/local/llvm-$1" "/usr/local/opt/llvm@$1" ;;
    macos)
      printf '%s\n' "$(brew --prefix "llvm@$1" 2>/dev/null || true)" \
        "/opt/homebrew/opt/llvm@$1" "/usr/local/opt/llvm@$1" \
        "/opt/homebrew/opt/llvm" "/usr/local/opt/llvm" ;;
    freebsd)
      printf '%s\n' "/usr/local/llvm$1" "/usr/local" ;;
    windows)
      # gnu lane: MSYS2 CLANG64 LLVM (MinGW ABI, all targets) before LLVM_HOME.
      if [ "${PLATFORM_ABI}" = gnu ]; then printf '%s\n' "${MSYS2_ROOT:-/c/msys64}/clang64"; fi
      printf '%s\n' "${LLVM_HOME:-}"
      _simple_toolchain_prefixes "llvm-msvc-$1.*" "clang+llvm-$1.*-x86_64-pc-windows-msvc"
      printf '%s\n' "${ProgramFiles:-}/LLVM" "${ProgramW6432:-}/LLVM" "/c/Program Files/LLVM" ;;
    *)
      : ;;
  esac
}

_llvm23_version_admitted() {
  case "$1" in
    23.1.1) return 0 ;;
    23.*) echo "warning: LLVM $1 admitted by major 23 (reference version 23.1.1)" >&2; return 0 ;;
    *) return 1 ;;
  esac
}

# Explicit native CLI bootstrap can use the same static archives as Cargo.
# The default remains shared: llvm-lib/SFFI callers must never receive a static
# archive as SIMPLE_LLVM_PATH. Check the full llvm-config archive set and tools.
_llvm_try_static_cli_prefix() {
  [ "${LLVM_PROVIDER_REQUIREMENT:-shared}" = static-cli ] || return 1
  case "${PLATFORM_UNAME}:${PLATFORM_OS}" in Linux:linux|FreeBSD:freebsd) ;; *) return 1 ;; esac
  [ "$2" = 23 ] || return 1
  [ "$("${_prefix_cfg}" --prefix 2>/dev/null)" = "$1" ] || return 1
  _static_version=$("${_prefix_cfg}" --version 2>/dev/null) || return 1
  _static_libdir=$("${_prefix_cfg}" --libdir 2>/dev/null) || return 1
  case "${_static_libdir}" in "$1/lib"|"$1/lib64") ;; *) return 1 ;; esac
  _static_libnames=$("${_prefix_cfg}" --link-static --libnames 2>/dev/null) || return 1
  [ -n "${_static_libnames}" ] || return 1
  for _tool in llc llvm-as opt clang clang++ llvm-ar; do
    [ -x "$1/bin/${_tool}" ] || return 1
    _tool_version=$("$1/bin/${_tool}" --version 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+\.[0-9]+\.[0-9]+$/){print $i; exit}}')
    [ "${_tool_version}" = "${_static_version}" ] || return 1
  done
  for _archive in ${_static_libnames} libPolly.a libPollyISL.a; do
    case "${_archive}" in */*|*[!A-Za-z0-9_.+-]*) return 1 ;; lib*.a) ;; *) return 1 ;; esac
    [ -s "${_static_libdir}/${_archive}" ] || return 1
    _archive_members=$("$1/bin/llvm-ar" t "${_static_libdir}/${_archive}" 2>/dev/null) || return 1
    [ -n "${_archive_members}" ] || return 1
  done
  LLVM_FOUND=1; LLVM_VERSION="$2"; LLVM_PREFIX="$1"
  LLVM_LIBDIR="${_static_libdir}"; LLVM_LIB=""; LLVM_PROVIDER_KIND=static-cli
  return 0
}

# Try prefix $1 for version $2; on success set LLVM_* and return 0.
_llvm_try_prefix() {
  [ -n "$1" ] && [ -d "$1" ] || return 1
  _prefix_cfg=""
  if [ -x "$1/bin/llvm-config" ]; then
    _prefix_cfg="$1/bin/llvm-config"
  elif [ -x "$1/bin/llvm-config.exe" ]; then
    _prefix_cfg="$1/bin/llvm-config.exe"
  fi
  if [ "$2" = 23 ]; then
    [ -n "${_prefix_cfg}" ] || return 1
    _llvm23_version_admitted "$("${_prefix_cfg}" --version 2>/dev/null)" || return 1
  elif [ -n "${_prefix_cfg}" ]; then
    case "$("${_prefix_cfg}" --version 2>/dev/null)" in
      $2.*) ;;
      *) return 1 ;;
    esac
  fi
  # gnu lane links the MinGW import lib; llvm-mingw ships only the DLL (and
  # lacks BPF/RISCV/WebAssembly), MSVC prefixes have neither.
  if [ "${PLATFORM_OS}:${PLATFORM_ABI}" = windows:gnu ]; then
    if [ ! -f "$1/lib/libLLVM-$2.dll.a" ]; then
      _llvm_gnu_missing_import="$1/lib/libLLVM-$2.dll.a"
      return 1
    fi
  fi
  for _ld in $(_llvm_libdirs); do
    for _name in $(_llvm_lib_names "$2"); do
      if [ -f "$1/${_ld}/${_name}" ]; then
        LLVM_FOUND=1; LLVM_VERSION="$2"; LLVM_PREFIX="$1"
        LLVM_LIBDIR="$1/${_ld}"; LLVM_LIB="$1/${_ld}/${_name}"; LLVM_PROVIDER_KIND=shared
        return 0
      fi
    done
  done
  _llvm_try_static_cli_prefix "$1" "$2"
}

for _v in ${LLVM_VERSIONS}; do
  case "$_v" in *[!0-9]*|'') continue ;; esac
  # LLVM 23.1 uses 231 in the llvm-sys environment key.
  case "$_v" in
    23) _prefix_env=LLVM_SYS_231_PREFIX ;;
    *) _prefix_env=LLVM_SYS_${_v}0_PREFIX ;;
  esac
  eval "_ov=\${${_prefix_env}:-}"
  if [ -n "${_ov}" ] && _llvm_try_prefix "${_ov}" "${_v}"; then break; fi
  # Host config llvm_root (SIMPLE_HOST_LLVM_ROOT, exported by sourcing
  # scripts/setup/host-env.shs; see config/host/host_config.sdn) is tried
  # before any probing, so a user's recorded prefix wins over guesses.
  # Callers that never source host-env.shs (bootstrap-from-scratch.sh) get the
  # layered value through `host-env.shs --get` in a child shell, the same
  # non-exporting pattern bootstrap-build-jobs-policy.shs uses.
  _pd_llvm_root=${SIMPLE_HOST_LLVM_ROOT:-}
  if [ -z "${_pd_llvm_root}" ] && [ -f "${repo_root:-.}/scripts/setup/host-env.shs" ]; then
    _pd_llvm_root=$(sh "${repo_root:-.}/scripts/setup/host-env.shs" --get llvm_root 2>/dev/null) || _pd_llvm_root=""
  fi
  if [ -n "${_pd_llvm_root}" ] && _llvm_try_prefix "${_pd_llvm_root}" "${_v}"; then break; fi

  # 1) llvm-config (portable): versioned, then bare if it reports this major
  for _cfg in "llvm-config-${_v}" "llvm-config"; do
    command -v "${_cfg}" >/dev/null 2>&1 || continue
    case "$(${_cfg} --version 2>/dev/null)" in
      ${_v}.*)
        if _llvm_try_prefix "$(${_cfg} --prefix 2>/dev/null)" "${_v}"; then break; fi ;;
    esac
  done
  if [ "${LLVM_FOUND}" = "1" ]; then break; fi

  # 2) well-known prefixes (newline-split so spaces in paths survive)
  _oifs="${IFS}"; IFS='
'
  for _p in $(_llvm_prefixes "${_v}"); do
    IFS="${_oifs}"
    if _llvm_try_prefix "${_p}" "${_v}"; then break; fi
    IFS='
'
  done
  IFS="${_oifs}"
  if [ "${LLVM_FOUND}" = "1" ]; then break; fi
done

if [ "${LLVM_FOUND}" != 1 ] && [ -n "${_llvm_gnu_missing_import}" ]; then
  printf 'warning: Windows GNU LLVM version matched, but required MinGW import library is missing: %s\n' "${_llvm_gnu_missing_import}" >&2
  printf '%s\n' 'Use an LLVM prefix with the GNU DLL and import library; an MSVC LLVM prefix cannot satisfy this lane.' >&2
fi

if [ "${LLVM_FOUND}" = "1" ]; then
  # Export the version-named prefix the Rust build expects, plus the resolved
  # library for the Simple runtime loader (honors a pre-set SIMPLE_LLVM_PATH).
  case "$LLVM_VERSION" in
    23) export "LLVM_SYS_231_PREFIX=${LLVM_PREFIX}" ;;
    *) export "LLVM_SYS_${LLVM_VERSION}0_PREFIX=${LLVM_PREFIX}" ;;
  esac
  [ -n "${SIMPLE_LLVM_PATH:-}" ] || [ -z "${LLVM_LIB}" ] || export SIMPLE_LLVM_PATH="${LLVM_LIB}"
fi
export LLVM_FOUND LLVM_VERSION LLVM_PREFIX LLVM_LIBDIR LLVM_LIB LLVM_PROVIDER_KIND

# Windows gnu lane (the default): locate the repo-managed llvm-mingw UCRT
# toolchain ($SIMPLE_TOOLCHAINS_ROOT/llvm-mingw-*-ucrt-x86_64, newest first) and
# put its bin/ first on PATH so clang/llvm-ar resolve there rather than to MSYS2.
# Honors a pre-set SIMPLE_MINGW_ROOT. Sets: SIMPLE_MINGW_ROOT ("" if not found).
if [ "${PLATFORM_OS}" = windows ] && [ "${PLATFORM_ABI}" = gnu ]; then
  if [ -z "${SIMPLE_MINGW_ROOT:-}" ]; then
    for _mw in $(_simple_toolchain_prefixes "llvm-mingw-*-ucrt-x86_64" ""); do
      if [ -x "${_mw}/bin/x86_64-w64-mingw32-gcc.exe" ] && [ -x "${_mw}/bin/clang.exe" ]; then
        SIMPLE_MINGW_ROOT="${_mw}"; break
      fi
    done
  fi
  if [ -n "${SIMPLE_MINGW_ROOT:-}" ]; then
    case ":${PATH}:" in
      *":${SIMPLE_MINGW_ROOT}/bin:"*) ;;
      *) PATH="${SIMPLE_MINGW_ROOT}/bin:${PATH}" ;;
    esac
    export PATH
  fi
  export SIMPLE_MINGW_ROOT="${SIMPLE_MINGW_ROOT:-}"
  # llvm-mingw's bin also ships a partial libLLVM-23.dll (no BPF/RISCV/Wasm);
  # put the selected CLANG64 LLVM bin ahead of it so the full DLL wins.
  if [ "${LLVM_FOUND}" = 1 ] && [ -f "${LLVM_PREFIX}/lib/libLLVM-${LLVM_VERSION}.dll.a" ]; then
    export PATH="${LLVM_PREFIX}/bin:${PATH}"
  fi
fi
