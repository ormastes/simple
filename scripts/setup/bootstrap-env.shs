#!/bin/sh
# bootstrap-env.shs — side-by-side bootstrap toolchain env (LLVM 23.1.1 + Rust).
#
# Installs the official LLVM 23.1.1 release into a private prefix BESIDE the
# host's default toolchain (/usr/bin/clang etc. are never touched), and writes
# an env file that only shells which source it pick up.
#
#   sh scripts/setup/bootstrap-env.shs install   # download + verify + extract + write env
#   sh scripts/setup/bootstrap-env.shs check     # verify rust + exact LLVM 23.1.1 in the env
#   . "$HOME/.simple/bootstrap-env/env.shs"      # use it (or: eval "$(sh ... print-env)")
#
# Why not apt.llvm.org (bootstrap-prereqs.shs install-llvm23): that channel is
# rolling (23.1.2+ replaces 23.1.1) and needs root; inkwell's llvm23-1 feature
# binds exactly 23.1.1 via LLVM_SYS_231_PREFIX.
#
# Env knobs: SIMPLE_BOOTSTRAP_ENV_ROOT (default $HOME/.simple/bootstrap-env).
# Linux x86_64 only. # ponytail: other hosts use bootstrap-prereqs.shs; add a
# per-platform tarball + sha row here when one is needed.
set -eu

LLVM_VERSION=23.1.1
LLVM_TARBALL="LLVM-${LLVM_VERSION}-Linux-X64.tar.xz"
LLVM_URL="https://github.com/llvm/llvm-project/releases/download/llvmorg-${LLVM_VERSION}/${LLVM_TARBALL}"
LLVM_SHA256="832aeb58d105de1cabc7b982dd2c65de0610f7377df48ae8fc2dd8e97420a15c"
# The upstream tarball is built on Ubuntu 22.04: lld/lldb/wasm-ld NEED
# libicu*.so.70. Their RUNPATH is $ORIGIN/../lib, so jammy's libicu70 is
# dropped into the prefix -- nothing is installed system-wide.
ICU_DEB="libicu70_70.1-2_amd64.deb"
ICU_URL="http://archive.ubuntu.com/ubuntu/pool/main/i/icu/${ICU_DEB}"
ICU_SHA256="58a154f6307289813da2276f900498ef536ae7c0522d2cf31a3c3c5cf62dfd9a"
RUST_MIN=1.89.0

ROOT="${SIMPLE_BOOTSTRAP_ENV_ROOT:-$HOME/.simple/bootstrap-env}"
PREFIX="$ROOT/llvm-$LLVM_VERSION"
ENV_FILE="$ROOT/env.shs"
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

die() { echo "bootstrap-env: ERROR: $*" >&2; exit 1; }

version_ge() { [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1)" = "$2" ]; }

print_env() {
    cat <<EOF
# generated by scripts/setup/bootstrap-env.shs — source me
SIMPLE_BOOTSTRAP_ENV_ROOT="$ROOT"
SIMPLE_LLVM_ROOT="$PREFIX"
SIMPLE_LLVM_MAJOR=23
PATH="$PREFIX/bin:\$PATH"
CC="$PREFIX/bin/clang"
CXX="$PREFIX/bin/clang++"
LD="$PREFIX/bin/ld.lld"
SIMPLE_LLD="$PREFIX/bin/ld.lld"
AR="$PREFIX/bin/llvm-ar"
LLVM_CONFIG="$PREFIX/bin/llvm-config"
LLVM_SYS_231_PREFIX="$PREFIX"
export SIMPLE_BOOTSTRAP_ENV_ROOT SIMPLE_LLVM_ROOT SIMPLE_LLVM_MAJOR PATH CC CXX LD SIMPLE_LLD AR LLVM_CONFIG LLVM_SYS_231_PREFIX
EOF
}

do_install() {
    [ "$(uname -s)-$(uname -m)" = "Linux-x86_64" ] || die "only Linux x86_64 is supported; use scripts/setup/bootstrap-prereqs.shs elsewhere"
    if [ -x "$PREFIX/bin/llvm-config" ] && [ "$("$PREFIX/bin/llvm-config" --version)" = "$LLVM_VERSION" ]; then
        echo "LLVM $LLVM_VERSION already at $PREFIX"
    else
        mkdir -p "$ROOT"
        dl="$ROOT/$LLVM_TARBALL"
        if [ ! -f "$dl" ]; then
            echo "downloading $LLVM_URL"
            curl -fL --retry 4 -o "$dl.part" "$LLVM_URL" || die "download failed"
            mv "$dl.part" "$dl"
        fi
        got="$(sha256sum "$dl" | awk '{print $1}')"
        [ "$got" = "$LLVM_SHA256" ] || { rm -f "$dl"; die "sha256 mismatch for $LLVM_TARBALL: got $got, want $LLVM_SHA256"; }
        echo "sha256 verified: $got"
        rm -rf "$PREFIX.part" && mkdir -p "$PREFIX.part"
        tar -xJf "$dl" -C "$PREFIX.part" --strip-components=1 || die "extract failed"
        rm -rf "$PREFIX" && mv "$PREFIX.part" "$PREFIX"
        rm -f "$dl"
    fi
    if [ ! -e "$PREFIX/lib/libicuuc.so.70" ]; then
        deb="$ROOT/$ICU_DEB"
        echo "downloading $ICU_URL"
        curl -fL --retry 4 -o "$deb" "$ICU_URL" || die "download failed"
        got="$(sha256sum "$deb" | awk '{print $1}')"
        [ "$got" = "$ICU_SHA256" ] || { rm -f "$deb"; die "sha256 mismatch for $ICU_DEB: got $got, want $ICU_SHA256"; }
        x="$ROOT/icu70.part" && rm -rf "$x" && mkdir -p "$x"
        dpkg-deb -x "$deb" "$x" || die "extract $ICU_DEB failed"
        cp -a "$x"/usr/lib/x86_64-linux-gnu/libicu*.so.70* "$PREFIX/lib/"
        rm -rf "$x" "$deb"
    fi
    print_env > "$ENV_FILE"
    echo "wrote $ENV_FILE"
    do_check
}

do_check() {
    fail=0
    [ -f "$ENV_FILE" ] || die "no env at $ENV_FILE — run: sh scripts/setup/bootstrap-env.shs install"
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    for t in clang clang++ ld.lld llvm-ar llvm-config; do
        line="$("$PREFIX/bin/$t" --version 2>/dev/null | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || true)"
        st=OK; [ "$line" = "$LLVM_VERSION" ] || { st=FAIL; fail=1; }
        printf '%-12s %-5s %s\n' "$t" "$st" "${line:-missing}"
    done
    for t in rustc cargo; do
        line="$(cd "$REPO_ROOT/src/compiler_rust" && "$t" --version 2>/dev/null | awk '{print $2}' || true)"
        st=OK; { [ -n "$line" ] && version_ge "${line%%-*}" "$RUST_MIN"; } || { st=FAIL; fail=1; }
        printf '%-12s %-5s %s (min %s, toolchain from src/compiler_rust/rust-toolchain.toml)\n' "$t" "$st" "${line:-missing}" "$RUST_MIN"
    done
    if [ "$fail" -eq 0 ]; then
        echo "PASS — bootstrap env at $ROOT: LLVM $LLVM_VERSION + rust ok; default host toolchain untouched ($(command -v -p clang 2>/dev/null || echo none))"
    else
        echo "FAIL — bootstrap env at $ROOT incomplete"
        exit 1
    fi
}

case "${1:-check}" in
    install) do_install ;;
    check) do_check ;;
    print-env) print_env ;;
    *) echo "usage: sh scripts/setup/bootstrap-env.shs [install|check|print-env]" >&2; exit 2 ;;
esac
