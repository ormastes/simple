#!/bin/sh
# QEMU media oracle for the generated RISC-V Linux terminal images.
#
# REAL-FIRMWARE chain (migrated off `-kernel` 2026-08-31, board-runnable
# rule): OpenSBI is rebuilt from the pinned, provenance-verified checkout as
# fw_payload embedding the pinned Linux Image and the pinned DTB
# (FW_FDT_PATH), booted via `-bios` ONLY — the firmware, not QEMU, performs
# the S-mode handover, matching what board flash ships. The initrd is
# RAM-preloaded by the generic loader device at the address the DTB's
# linux,initrd-start already declares (QEMU's -initrd is unusable without
# -kernel, and was the last pass-semantics remnant). The argv is self-checked
# against -kernel/-initrd/-append/isa-debug-exit before launch.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
SIMPLE=${SIMPLE:-"$ROOT/bin/release/simple"}
PROBE="$ROOT/scripts/fpga/riscv_linux_terminal_probe.spl"

usage() {
    echo "usage: sh scripts/os/check_riscv_linux_qemu.shs rv32|rv64" >&2
    exit 2
}

ordered_terminal_pass() {
    awk '
        /^login:$/ && stage == 0 { stage = 1; next }
        /^UART_TX_INPUT=root$/ && stage == 1 { stage = 2; next }
        /^simple-riscv# $/ && stage == 2 { stage = 3; next }
        /^UART_TX_INPUT=ls \/$/ && stage == 3 { stage = 4; next }
        /SIMPLE_RISCV_LINUX_LOGIN_LS_PASS/ && stage == 4 { stage = 5; next }
        /^RISCV_LINUX_TERMINAL_PROBE_STATUS=PASS$/ && stage == 5 { ok = 1 }
        END { exit !ok }
    ' "$1"
}

[ "$#" = 1 ] || usage
if [ "$1" = "--self-test" ]; then
    test_dir=$(mktemp -d)
    trap 'rm -rf "$test_dir"' EXIT INT TERM
    printf '%s\n' \
        'login:' 'UART_TX_INPUT=root' 'simple-riscv# ' \
        'UART_TX_INPUT=ls /' 'SIMPLE_RISCV_LINUX_LOGIN_LS_PASS' \
        'RISCV_LINUX_TERMINAL_PROBE_STATUS=PASS' >"$test_dir/ordered"
    printf '%s\n' \
        'login:' 'UART_TX_INPUT=ls /' 'UART_TX_INPUT=root' 'simple-riscv# ' \
        'SIMPLE_RISCV_LINUX_LOGIN_LS_PASS' \
        'RISCV_LINUX_TERMINAL_PROBE_STATUS=PASS' >"$test_dir/reordered"
    [ -x "$SIMPLE" ] &&
        ordered_terminal_pass "$test_dir/ordered" &&
        ! ordered_terminal_pass "$test_dir/reordered" &&
        env SIMPLE_BOOTSTRAP= SIMPLE_RUNTIME_PATH= SIMPLE_LIB="$ROOT/src" \
            SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_FRONTEND_DELEGATED=1 \
            "$SIMPLE" run "$PROBE" --self-test || {
        echo "RISCV_QEMU_MEDIA_ORACLE_SELF_TEST=FAIL" >&2
        exit 1
    }
    echo "RISCV_QEMU_MEDIA_ORACLE_SELF_TEST=PASS"
    exit 0
fi

case "$1" in
    rv32)
        QEMU=qemu-system-riscv32; CPU=rv32; DEFAULT_PORT=2326
        DTS_ARCH_DIR=riscv32
        OPENSBI_COMMIT=a2b255b88918715173942f2c5e1f97ac9e90c877
        LINUX_COMMIT=ffc253263a1375a65fa6c9f62a893e9767fbebfa ;;
    rv64)
        QEMU=qemu-system-riscv64; CPU=rv64; DEFAULT_PORT=2327
        DTS_ARCH_DIR=riscv64
        OPENSBI_COMMIT=a2b255b88918715173942f2c5e1f97ac9e90c877
        LINUX_COMMIT=ffc253263a1375a65fa6c9f62a893e9767fbebfa ;;
    *) usage ;;
esac

ARCH=$1
ASSETS="$ROOT/build/os/${ARCH}_soc"
MANIFEST="$ASSETS/manifest.txt"
BUILDROOT="$ROOT/build/os/buildroot/$ARCH"
BUILDROOT_MANIFEST="$BUILDROOT/buildroot-manifest.txt"
DTS="$ROOT/examples/09_embedded/simple_os/arch/$DTS_ARCH_DIR/soc_virt.dts"
LOG="$ASSETS/qemu-media-oracle.log"
PORT=${RISCV_QEMU_SERIAL_PORT:-$DEFAULT_PORT}
TIMEOUT_MS=${RISCV_QEMU_TIMEOUT_MS:-120000}

case "$PORT" in ''|*[!0-9]*) echo "ERROR: invalid serial port: $PORT" >&2; exit 2 ;; esac
[ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ] || { echo "ERROR: invalid serial port: $PORT" >&2; exit 2; }
case "$TIMEOUT_MS" in ''|*[!0-9]*|0) echo "ERROR: invalid timeout: $TIMEOUT_MS" >&2; exit 2 ;; esac

for tool in "$QEMU" cmp dtc flock git sha256sum ss "$SIMPLE"; do
    command -v "$tool" >/dev/null 2>&1 || { echo "ERROR: missing tool: $tool" >&2; exit 1; }
done
[ -f "$PROBE" ] || { echo "ERROR: missing terminal probe: $PROBE" >&2; exit 1; }
[ -f "$MANIFEST" ] || { echo "ERROR: missing media manifest: $MANIFEST" >&2; exit 1; }
[ -f "$BUILDROOT_MANIFEST" ] || { echo "ERROR: missing Buildroot manifest: $BUILDROOT_MANIFEST" >&2; exit 1; }
for media in fw_jump.bin Image soc_virt.dtb initramfs.cpio.gz; do
    [ -s "$ASSETS/$media" ] || { echo "ERROR: missing media: $ASSETS/$media" >&2; exit 1; }
done

# The manifest is the pinned-media contract; refuse stale or substituted files.
for media in fw_jump.bin Image soc_virt.dtb initramfs.cpio.gz; do
    expected=$(sed -n "/[[:space:]]$media[[:space:]]/s/.*sha256=\([0-9a-f]*\)).*/\1/p" "$MANIFEST" | head -n 1)
    actual=$(sha256sum "$ASSETS/$media" | awk '{print $1}')
    [ -n "$expected" ] && [ "$actual" = "$expected" ] || {
        echo "ERROR: pinned media hash mismatch: $ASSETS/$media" >&2
        exit 1
    }
done

# Independently bind those bytes to their pinned source/build outputs.
[ "$(git -C "$ASSETS/opensbi-src" rev-parse HEAD)" = "$OPENSBI_COMMIT" ] &&
    git -C "$ASSETS/opensbi-src" diff --quiet &&
    git -C "$ASSETS/opensbi-src" diff --cached --quiet &&
    cmp -s "$ASSETS/fw_jump.bin" \
        "$ASSETS/opensbi-src/build/platform/generic/firmware/fw_jump.bin" || {
    echo "ERROR: OpenSBI build provenance mismatch" >&2
    exit 1
}
[ "$(git -C "$ASSETS/linux-src" rev-parse HEAD)" = "$LINUX_COMMIT" ] &&
    git -C "$ASSETS/linux-src" diff --quiet &&
    git -C "$ASSETS/linux-src" diff --cached --quiet &&
    cmp -s "$ASSETS/Image" "$ASSETS/linux-src/arch/riscv/boot/Image" || {
    echo "ERROR: Linux build provenance mismatch" >&2
    exit 1
}
grep -q '^buildroot_commit=e4a5ab3b319753f41e2b5cf22e90b6b0304ca225$' "$BUILDROOT_MANIFEST" &&
    grep -q "^arch=$ARCH$" "$BUILDROOT_MANIFEST" || {
    echo "ERROR: Buildroot provenance mismatch" >&2
    exit 1
}
rootfs_sha=$(sed -n 's/^rootfs_sha256=//p' "$BUILDROOT_MANIFEST")
[ "$(sha256sum "$ASSETS/initramfs.cpio.gz" | awk '{print $1}')" = "$rootfs_sha" ] || {
    echo "ERROR: Buildroot rootfs hash mismatch" >&2
    exit 1
}
verify_dir=$(mktemp -d)
trap 'rm -rf "$verify_dir"' EXIT INT TERM
initrd_end=$(printf '0x%x' "$((0x88200000 + $(wc -c < "$ASSETS/initramfs.cpio.gz")))")
sed \
    -e 's/linux,initrd-start[[:space:]]*=[[:space:]]*<[^>]*>;/linux,initrd-start = <0x0 0x88200000>;/' \
    -e "s/linux,initrd-end[[:space:]]*=[[:space:]]*<[^>]*>;/linux,initrd-end = <0x0 $initrd_end>;/" \
    "$DTS" >"$verify_dir/soc_virt.dts"
dtc -I dts -O dtb -o "$verify_dir/soc_virt.dtb" "$verify_dir/soc_virt.dts"
cmp -s "$ASSETS/soc_virt.dtb" "$verify_dir/soc_virt.dtb" || {
    echo "ERROR: DTB source provenance mismatch" >&2
    exit 1
}

exec 9>"$ASSETS/.qemu-media-oracle.lock"
flock -n 9 || { echo "ERROR: QEMU media oracle already running for $ARCH" >&2; exit 1; }
if ss -H -ltn "sport = :$PORT" | grep -q .; then
    echo "ERROR: serial port already in use: $PORT" >&2
    exit 1
fi
: > "$LOG"
QEMU_PID=
cleanup() {
    rm -rf "$verify_dir"
    case "$QEMU_PID" in ''|0|1|-) return ;; esac
    kill "$QEMU_PID" 2>/dev/null || true
    wait "$QEMU_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

qemu_alive() {
    kill -0 "$QEMU_PID" 2>/dev/null &&
        [ -r "/proc/$QEMU_PID/stat" ] &&
        [ "$(awk '{print $3}' "/proc/$QEMU_PID/stat")" != Z ]
}

echo "RISCV_QEMU_MEDIA_ORACLE arch=$ARCH port=$PORT" | tee -a "$LOG"

# Real-firmware chain (board-runnable rule): NO `-kernel` pass semantics.
# OpenSBI is rebuilt from the SAME pinned checkout the provenance block above
# already verified, as fw_payload with the pinned Linux Image as its payload
# and the pinned DTB embedded via FW_FDT_PATH — so the FIRMWARE, not QEMU,
# performs the S-mode handover, exactly the flash-image configuration a board
# ships. The initrd cannot use `-initrd` (QEMU rejects it without `-kernel`);
# it is placed at the exact address the patched DTB's linux,initrd-start
# declares, via the generic loader device — the RAM-preload role board flash
# tooling performs. Kernel command line comes from the DTS `chosen/bootargs`
# (same console/earlycon; rdinit=/init appended below via a bootargs patch).
FW_PAYLOAD_BUILD="$ASSETS/opensbi-src/build/platform/generic/firmware/fw_payload.bin"
sed -i.oracle_bak \
    -e 's|bootargs = "[^"]*";|bootargs = "console=ttyS0,115200 earlycon=ns16550a,mmio,0x10000000 rdinit=/init";|' \
    "$verify_dir/soc_virt.dts"
dtc -I dts -O dtb -o "$verify_dir/soc_virt.boot.dtb" "$verify_dir/soc_virt.dts"
# rv64 kernels load at RAM+0x200000; rv32 at RAM+0x400000 (Linux convention).
case "$ARCH" in
    rv64) FW_XLEN=64; FW_OFFSET=0x200000 ;;
    rv32) FW_XLEN=32; FW_OFFSET=0x400000 ;;
esac
make -C "$ASSETS/opensbi-src" PLATFORM=generic \
    CROSS_COMPILE="${RISCV_CROSS_COMPILE:-riscv64-linux-gnu-}" \
    PLATFORM_RISCV_XLEN="$FW_XLEN" \
    FW_PAYLOAD=y FW_PAYLOAD_PATH="$ASSETS/Image" FW_PAYLOAD_OFFSET="$FW_OFFSET" \
    FW_FDT_PATH="$verify_dir/soc_virt.boot.dtb" -j4 >>"$LOG" 2>&1 || {
    echo "RISCV_QEMU_MEDIA_ORACLE_STATUS=FAIL fw_payload_build" | tee -a "$LOG" >&2
    exit 1
}
[ -s "$FW_PAYLOAD_BUILD" ] || {
    echo "RISCV_QEMU_MEDIA_ORACLE_STATUS=FAIL fw_payload_missing" | tee -a "$LOG" >&2
    exit 1
}

set -- -machine virt -cpu "$CPU" -m 256M -display none -monitor none -no-reboot \
    -bios "$FW_PAYLOAD_BUILD" \
    -device "loader,file=$ASSETS/initramfs.cpio.gz,addr=0x88200000,force-raw=on" \
    -chardev "socket,id=serial0,host=127.0.0.1,port=$PORT,server=on,wait=on,nodelay=on" \
    -serial chardev:serial0
# Forbidden-flag self-check against the ASSEMBLED argv (board-runnable rule).
for _arg in "$@"; do
    case "$_arg" in
        -kernel|-initrd|-append|*isa-debug-exit*)
            echo "RISCV_QEMU_MEDIA_ORACLE_STATUS=FAIL forbidden_flag:$_arg" | tee -a "$LOG" >&2
            exit 1 ;;
    esac
done
"$QEMU" "$@" >>"$LOG" 2>&1 &
QEMU_PID=$!

ready=0
i=0
while [ "$i" -lt 100 ]; do
    qemu_alive || break
    if ss -H -ltnp "sport = :$PORT" | grep -q "pid=$QEMU_PID,"; then
        ready=1
        break
    fi
    sleep 0.1
    i=$((i + 1))
done
[ "$ready" = 1 ] || {
    echo "RISCV_QEMU_MEDIA_ORACLE_STATUS=FAIL serial_socket" | tee -a "$LOG" >&2
    exit 1
}

if ! "$SIMPLE" run "$PROBE" 127.0.0.1 "$PORT" "$TIMEOUT_MS" >>"$LOG" 2>&1; then
    echo "RISCV_QEMU_MEDIA_ORACLE_STATUS=FAIL probe" | tee -a "$LOG" >&2
    exit 1
fi
qemu_alive || {
    echo "RISCV_QEMU_MEDIA_ORACLE_STATUS=FAIL qemu_exited" | tee -a "$LOG" >&2
    exit 1
}

if ordered_terminal_pass "$LOG"; then
    echo "RISCV_QEMU_MEDIA_ORACLE_STATUS=PASS" | tee -a "$LOG"
else
    echo "RISCV_QEMU_MEDIA_ORACLE_STATUS=FAIL ordered_terminal_evidence" | tee -a "$LOG" >&2
    exit 1
fi
