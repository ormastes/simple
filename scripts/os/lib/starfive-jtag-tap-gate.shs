#!/usr/bin/env sh
# Shared non-mutating TAP identity gate. Callers must already own/unbind the
# exact Tigard channel-B interface before invoking the live preflight.

starfive_jtag_tap_log_valid() {
    sf_gate_log="$1"
    sf_gate_found="$(grep -Eic 'tap/device found: 0x07110cfd([^0-9a-fA-F]|$)' "$sf_gate_log" || true)"
    test "$sf_gate_found" -eq 2 \
        && test "$(grep -Eic 'tap/device found:' "$sf_gate_log" || true)" -eq 2 \
        && ! grep -qE 'UNEXPECTED:|IR capture error|Trying to use configured scan chain anyway|all ones' "$sf_gate_log"
}

starfive_jtag_tap_preflight() {
    sf_gate_root="$1"
    sf_gate_output="$2"
    sf_gate_khz="$3"
    set +e
    timeout 15 openocd \
        -f interface/ftdi/tigard.cfg \
        -c 'ftdi device_desc {port A:Serial  port B:JTAG}' \
        -f "$sf_gate_root/scripts/os/openocd-starfive-jh7110.cfg" \
        -c "adapter speed $sf_gate_khz" \
        -c init -c scan_chain -c shutdown > "$sf_gate_output" 2>&1
    sf_gate_rc=$?
    set -e
    test "$sf_gate_rc" -eq 0 && starfive_jtag_tap_log_valid "$sf_gate_output"
}
