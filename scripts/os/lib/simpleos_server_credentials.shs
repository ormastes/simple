# Sourced credential snapshot/provenance owner for make_os_disk.shs.

simpleos_server_credentials_hash() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        echo "missing SHA-256 tool (sha256sum or shasum)" >&2
        return 1
    fi
}

simpleos_server_credentials_regular_input() {
    input=$1
    label=$2
    [ -f "$input" ] && [ ! -L "$input" ] || {
        echo "$label must be a regular non-symlink file: $input" >&2
        return 1
    }
}

simpleos_server_credentials_private_mode() {
    input=$1
    label=$2
    if mode=$(stat -c %a "$input" 2>/dev/null); then :
    elif mode=$(stat -f %Lp "$input" 2>/dev/null); then :
    else echo "cannot inspect $label permissions: $input" >&2; return 1
    fi
    case "$mode" in
        400|600) ;;
        *) echo "$label permissions must be 0400 or 0600: $input (mode $mode)" >&2; return 1 ;;
    esac
}

simpleos_server_credentials_bound() {
    input=$1
    label=$2
    maximum=$3
    size=$(wc -c < "$input" | tr -d ' ')
    [ "$size" -ge 1 ] && [ "$size" -le "$maximum" ] || {
        echo "$label must contain 1..$maximum bytes" >&2
        return 1
    }
}

simpleos_server_credentials_snapshot_one() {
    source_path=$1
    snapshot_path=$2
    expected_hash=$3
    cp "$source_path" "$snapshot_path.tmp" || return 1
    chmod 600 "$snapshot_path.tmp"
    mv "$snapshot_path.tmp" "$snapshot_path"
    [ -f "$snapshot_path" ] && [ ! -L "$snapshot_path" ] || return 1
    [ "$(simpleos_server_credentials_hash "$snapshot_path")" = "$expected_hash" ] || {
        echo "SimpleOS server credential changed while snapshotting: $source_path" >&2
        return 1
    }
    [ "$(simpleos_server_credentials_hash "$source_path")" = "$expected_hash" ] || {
        echo "SimpleOS server credential changed while snapshotting: $source_path" >&2
        return 1
    }
}

simpleos_server_credentials_snapshot() {
    source_credential=$1
    source_certificate=$2
    source_private_key=$3
    snapshot_dir=$4
    simpleos_server_credentials_regular_input "$source_credential" SIMPLEOS_SERVER_DB_CREDENTIAL_FILE || return 1
    simpleos_server_credentials_regular_input "$source_certificate" SIMPLEOS_SERVER_DB_CERTIFICATE_FILE || return 1
    simpleos_server_credentials_regular_input "$source_private_key" SIMPLEOS_SERVER_DB_PRIVATE_KEY_FILE || return 1
    simpleos_server_credentials_private_mode "$source_credential" SIMPLEOS_SERVER_DB_CREDENTIAL_FILE || return 1
    simpleos_server_credentials_private_mode "$source_private_key" SIMPLEOS_SERVER_DB_PRIVATE_KEY_FILE || return 1
    simpleos_server_credentials_bound "$source_credential" SIMPLEOS_SERVER_DB_CREDENTIAL_FILE 128 || return 1
    simpleos_server_credentials_bound "$source_certificate" SIMPLEOS_SERVER_DB_CERTIFICATE_FILE 65536 || return 1
    simpleos_server_credentials_bound "$source_private_key" SIMPLEOS_SERVER_DB_PRIVATE_KEY_FILE 16384 || return 1

    SERVER_CREDENTIAL_SHA256=$(simpleos_server_credentials_hash "$source_credential") || return 1
    SERVER_CERTIFICATE_SHA256=$(simpleos_server_credentials_hash "$source_certificate") || return 1
    SERVER_PRIVATE_KEY_SHA256=$(simpleos_server_credentials_hash "$source_private_key") || return 1
    SIMPLEOS_SERVER_DB_CREDENTIAL_FILE="$snapshot_dir/SRVDB.KEY"
    SIMPLEOS_SERVER_DB_CERTIFICATE_FILE="$snapshot_dir/SRVDB.CRT"
    SIMPLEOS_SERVER_DB_PRIVATE_KEY_FILE="$snapshot_dir/SRVDB.PK8"
    SIMPLEOS_SERVER_DB_CREDENTIAL_MANIFEST_FILE="$snapshot_dir/SRVDB.MAN"
    simpleos_server_credentials_snapshot_one "$source_credential" "$SIMPLEOS_SERVER_DB_CREDENTIAL_FILE" "$SERVER_CREDENTIAL_SHA256" || return 1
    simpleos_server_credentials_snapshot_one "$source_certificate" "$SIMPLEOS_SERVER_DB_CERTIFICATE_FILE" "$SERVER_CERTIFICATE_SHA256" || return 1
    simpleos_server_credentials_snapshot_one "$source_private_key" "$SIMPLEOS_SERVER_DB_PRIVATE_KEY_FILE" "$SERVER_PRIVATE_KEY_SHA256" || return 1

    command -v openssl >/dev/null 2>&1 || { echo "openssl is required to validate SimpleOS server TLS material" >&2; return 1; }
    openssl x509 -inform DER -in "$SIMPLEOS_SERVER_DB_CERTIFICATE_FILE" -noout >/dev/null 2>&1 || {
        echo "SimpleOS server certificate must be a valid DER X.509 certificate" >&2; return 1; }
    key_type=$(openssl pkey -inform DER -in "$SIMPLEOS_SERVER_DB_PRIVATE_KEY_FILE" -text_pub -noout 2>/dev/null |
        awk -F: '/^ED25519 Public-Key:/{print "ED25519"; exit}')
    [ "$key_type" = ED25519 ] || {
        echo "SimpleOS server private key must be an Ed25519 PKCS#8 DER key" >&2; return 1; }
    openssl x509 -inform DER -in "$SIMPLEOS_SERVER_DB_CERTIFICATE_FILE" -pubkey -noout 2>/dev/null |
        openssl pkey -pubin -outform DER > "$snapshot_dir/certificate-public.der" 2>/dev/null || return 1
    openssl pkey -inform DER -in "$SIMPLEOS_SERVER_DB_PRIVATE_KEY_FILE" -pubout -outform DER \
        > "$snapshot_dir/private-public.der" 2>/dev/null || return 1
    cmp -s "$snapshot_dir/certificate-public.der" "$snapshot_dir/private-public.der" || {
        echo "SimpleOS server certificate/private key mismatch" >&2; return 1; }
    umask 077
    {
        printf 'schema=simpleos-server-credentials-manifest-v1\n'
        printf 'credential_path=/SYS/SRVDB.KEY\ncredential_sha256=%s\n' "$SERVER_CREDENTIAL_SHA256"
        printf 'certificate_path=/SYS/SRVDB.CRT\ncertificate_sha256=%s\n' "$SERVER_CERTIFICATE_SHA256"
        printf 'private_key_path=/SYS/SRVDB.PK8\nprivate_key_sha256=%s\n' "$SERVER_PRIVATE_KEY_SHA256"
        printf 'signature_scheme=ed25519\nsignature_scheme_id=0x0807\n'
    } > "$SIMPLEOS_SERVER_DB_CREDENTIAL_MANIFEST_FILE"
}
