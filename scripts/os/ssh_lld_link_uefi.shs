#!/bin/sh
# ssh_lld_link_uefi.shs — Lane P6 (toolchain) board gate: rungs 3-6 of the
# in-guest LLVM ladder (master plan
# doc/01_research/domain/simpleos_production_host_master_plan.md §13):
#   rung 3  /usr/bin/ld.lld starts via ordinary FS-exec and prints its version
#   rung 4  ld.lld links the guest-generated object into an ELF
#   rung 5  the resulting ELF starts from the filesystem
#   rung 6  it returns an expected status and output
#
# STATUS: AUTHORED, NOT YET EXECUTED. This is a PREPARED-POSTPONED gate — see
# .spipe/simpleos_harden_p6_toolchain/state.md for the full blocker list and
# resume command. Parallel lanes are running QEMU concurrently; this lane
# does not launch QEMU during authoring. The prerequisite gate in step 0
# below makes that true mechanically: every path below it is unreachable
# until the listed build products exist, so simply invoking this script
# right now exits 1 before any qemu-system-x86_64 process starts.
#
# Modeled closely on the two proven OVMF board-proxy gates in this directory:
#   ssh_simple_hello_uefi.shs      — FS-exec launches /usr/bin/simple directly
#   scp_retrieve_over_ssh_uefi.shs — FS-exec launches clang -cc1, byte-exact getfile
# Same OVMF pflash boot (NEVER `-kernel` pass semantics — board-runnable rule,
# .claude/rules/board-runnable.md), same grub-mkstandalone self-contained
# BOOTX64.EFI (kernel embedded via memdisk), same SSH dispatch idiom (absolute
# path to bypass the sshd canned-fixture branch — see ssh_simple_hello_uefi.shs
# header note 3), same fail-closed serial-ladder ("rung") reporting style.
# NOTE: the two proven gates above register `-device isa-debug-exit` on the
# QEMU command line for machine-config parity but never use it to produce the
# pass/fail verdict (they grep the serial log and `kill $QEMU_PID` instead) —
# this script keeps the same convention: present in the machine config,
# never the source of truth for PASS/FAIL.
#
# WHY THIS IS BLOCKED TODAY (verified statically 2026-07-27; see prerequisite
# guards below and doc/03_plan/os/in_guest_lld_link_ladder.md for detail):
#   1. No lld_static build product exists on this host. src/os/port/llvm/
#      clang_static.shs already supports `SIMPLEOS_LLVM_TOOL=lld` to relink
#      the cross-built LLD into a static SimpleOS-native ELF (exactly the
#      clang_static path the proven cc1 gate depends on) but it has never
#      been invoked here: build/os/clang_static/ does not exist, and the
#      upstream cross build tree (build/os/llvm/cross-x86_64-unknown-simpleos/)
#      has no build.ninja on this host, so `bin/lld` has not even been
#      cross-compiled yet. Full rebuild is a multi-hour LLVM build, not a
#      bounded static-first task.
#   2. No multi-file guest image stager exists. scripts/os/fsexec_mkimg_big.spl
#      and scripts/os/fsexec_mkimg_simple.spl each stage exactly ONE big ELF
#      payload + one small companion file. Linking needs lld_static PLUS at
#      least a guest object, crt0.o, and a linker script (src/os/port/llvm/
#      sysroot.shs simpleos.ld) staged simultaneously. A new stager (working
#      name scripts/os/fsexec_mkimg_lld.spl, referenced as $STAGER below) is
#      required and is explicitly out of this lane's exclusive-path scope.
#   3. doc/03_plan/os/in_guest_clang_selfhost_board_plan.md already recorded
#      this exact gap: "No in-guest linking in Phase 1. ld/lld needs fork
#      too. .o is the deliverable; link+run happens on host for verification,
#      or is a later phase." Rung 3 here (direct FS-exec of ld.lld, same
#      no-fork dispatch idiom already proven for `clang -cc1` and
#      `/usr/bin/simple`) sidesteps the fork constraint that blocked the
#      clang *driver* path; rungs 4-6 still need the staged inputs in #2.
#
# Env: SEED, LLD_BIN, GUEST_OBJ, CRT0_OBJ, LINKER_SCRIPT, SKIP_STAGE,
#      SKIP_KERNEL=1 (default: reuse existing kernel), QEMU_MEM (2G),
#      BOOT_WAIT, SSH_PORT.
set -eu
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"

SEED="${SEED:-src/compiler_rust/target/release/simple}"
LLD_BIN="${LLD_BIN:-build/os/clang_static/bin/lld_static}"
GUEST_OBJ="${GUEST_OBJ:-build/os/elfexec_lld/hello.o}"
CRT0_OBJ="${CRT0_OBJ:-build/os/sysroot/lib/crt0.o}"
LINKER_SCRIPT="${LINKER_SCRIPT:-build/os/sysroot/share/simpleos/simpleos.ld}"
STAGER="scripts/os/fsexec_mkimg_lld.spl"
ENTRY="examples/09_embedded/simple_os/arch/x86_64/ssh_ring3_clang_entry.spl"
KLINKER="examples/09_embedded/simple_os/arch/x86_64/linker_128mb.ld"
KERNEL="build/os/simpleos_ssh_ring3_uefi128_lld.elf"
IMG="build/os/elfexec_lld/fat32-lld.img"
SERIAL="build/os/ssh_lld_link_uefi.serial.log"
CACHE="build/os/ssh_lld_cache_uefi128"
BUILD="build/os/uefi_lld"
ESP="$BUILD/esp"
EFIAPP="$ESP/EFI/BOOT/BOOTX64.EFI"
OVMF_CODE="${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}"
OVMF_VARS_SRC="${OVMF_VARS_SRC:-/usr/share/OVMF/OVMF_VARS_4M.fd}"
OVMF_VARS="$BUILD/OVMF_VARS_4M.fd"
QEMU_MEM="${QEMU_MEM:-2G}"
BOOT_WAIT="${BOOT_WAIT:-60}"
SCRATCH="${SCRATCH:-build/os/scratch_lld_link_uefi}"

# ---- 0. Prerequisite gate (STATIC — no QEMU below this point unless ALL pass) ----
echo "[lld-link] ===== prerequisite gate ====="
FAIL=0
req_file() {
    [ -f "$1" ] || { echo "[lld-link] MISSING: $1 -- $2"; FAIL=1; }
}
req_cmd() {
    command -v "$1" >/dev/null 2>&1 || { echo "[lld-link] MISSING: $1 (command not found)"; FAIL=1; }
}
req_file "$LLD_BIN" "build: SIMPLEOS_LLVM_TOOL=lld sh src/os/port/llvm/clang_static.shs (requires a completed 'cross' stage first: sh src/os/port/llvm/build.shs cross)"
req_file "$STAGER" "multi-payload guest image stager not yet authored (out of lane P6 exclusive-path scope; see doc/03_plan/os/in_guest_lld_link_ladder.md prerequisite #2)"
req_file "$GUEST_OBJ" "a guest-target (x86_64-unknown-simpleos) object to link -- e.g. retrieve one via scripts/os/scp_retrieve_over_ssh_uefi.shs, or cross-compile on host with the toolchain from src/os/port/llvm/build.shs"
req_file "$CRT0_OBJ" "run src/os/port/llvm/sysroot.shs to produce the SimpleOS sysroot (crt0.o + libsimpleos_c.a + simpleos.ld)"
req_file "$LINKER_SCRIPT" "produced by src/os/port/llvm/sysroot.shs alongside crt0.o"
req_cmd grub-mkstandalone
req_cmd qemu-system-x86_64
req_cmd sshpass
req_file "$OVMF_CODE" "install OVMF (edk2-ovmf) or set OVMF_CODE"
req_file "$OVMF_VARS_SRC" "install OVMF (edk2-ovmf) or set OVMF_VARS_SRC"
if [ "$FAIL" != "0" ]; then
    echo "[lld-link] ===== RESULT: PREPARED-POSTPONED -- prerequisites not met, QEMU NOT launched ====="
    echo "[lld-link] resume command once prerequisites above are satisfied:"
    echo "[lld-link]   sh scripts/os/ssh_lld_link_uefi.shs"
    exit 1
fi
mkdir -p build/os/elfexec_lld build/os/generated/generated "$SCRATCH"

# ---- 1. Payload image: /usr/bin/ld.lld + crt0.o + guest object + linker script ----
if [ "${SKIP_STAGE:-0}" != "1" ] || [ ! -f "$IMG" ]; then
    echo "[lld-link] staging image via $STAGER"
    SIMPLE_LIB="${SIMPLE_LIB:-src}" "$SEED" run "$STAGER" \
        --lld "$LLD_BIN" --crt0 "$CRT0_OBJ" --obj "$GUEST_OBJ" \
        --ld-script "$LINKER_SCRIPT" --out "$IMG" 2>&1 | tail -20
fi
[ -f "$IMG" ] || { echo "[lld-link] missing image $IMG"; exit 1; }

# ---- 2. Kernel: reuse the 128 MiB-base merged SSH kernel (same base as the
# proven clang/simple OVMF gates -- see linker_128mb.ld comment for why the
# 1 GiB payload VA + 128 MiB kernel base combination clears the kernel .bss
# band; doc/03_plan/os/in_guest_clang_selfhost_board_plan.md "2f RESOLVED"). --
if [ "${SKIP_KERNEL:-0}" != "1" ] || [ ! -f "$KERNEL" ]; then
    printf 'pub fn ssh_live_build_marker() -> text:\n    "ssh-ring3-build:uefi-lld-128"\n' \
        > build/os/generated/ssh_live_build_marker.spl
    OBJCOPY_PREFIX=""
    for d in "${LLVM_23_1_PREFIX:-}/bin"; do
        [ -f "$d/llvm-objcopy" ] && OBJCOPY_PREFIX="$d" && break
    done
    rm -rf "$CACHE"; mkdir -p "$CACHE"; rm -f "$KERNEL"
    echo "[lld-link] building 128MB-base kernel -> $KERNEL"
    SIMPLE_BOOTSTRAP=1 SIMPLE_LIB="$ROOT/src" SIMPLE_OS_LOG_MODE=off SIMPLE_ALLOW_FREESTANDING_STUBS=1 \
    PATH="${OBJCOPY_PREFIX:+$OBJCOPY_PREFIX:}$PATH" \
        "$SEED" native-build --source build/os/generated --source src/os --source src/lib \
        --source examples/09_embedded/simple_os --backend cranelift --cpu x86-64-v1 \
        --opt-level=aggressive --log off --entry-closure --cache-dir "$CACHE" \
        --entry "$ENTRY" --target x86_64-unknown-none -o "$KERNEL" \
        --linker-script "$KLINKER" 2>&1 | tail -20
    [ -f "$KERNEL" ] || { echo "[lld-link] KERNEL BUILD FAILED"; exit 1; }
fi
sh scripts/check/check-simpleos-x86-kernel-elf.shs "$KERNEL"
echo "[lld-link] kernel=$KERNEL ($(stat -c%s "$KERNEL") bytes)"

# ---- 3. ESP: self-contained BOOTX64.EFI (kernel in memdisk) ----------------
rm -rf "$BUILD"; mkdir -p "$ESP/EFI/BOOT"
cp "$OVMF_VARS_SRC" "$OVMF_VARS"
cat > "$BUILD/grub.cfg" <<'CFG'
set timeout=0
set default=0
insmod multiboot
insmod normal
menuentry "SimpleOS SSH ring-3 lld-link (UEFI/multiboot, 128MB)" {
    echo "[grub-uefi] multiboot loading /boot/kernel.elf ..."
    multiboot /boot/kernel.elf
    boot
}
CFG
grub-mkstandalone --format=x86_64-efi --output="$EFIAPP" \
    --modules="multiboot normal echo part_gpt fat" \
    "boot/grub/grub.cfg=$BUILD/grub.cfg" "boot/kernel.elf=$KERNEL"
[ -f "$EFIAPP" ] || { echo "FAIL: grub-mkstandalone did not produce $EFIAPP"; exit 1; }

# ---- 4. Free host port ------------------------------------------------------
SSH_PORT="${SSH_PORT:-42422}"
if ss -ltn 2>/dev/null | grep -q ":$SSH_PORT "; then
    for p in 43422 44422 45422 46422; do
        ss -ltn 2>/dev/null | grep -q ":$p " || { SSH_PORT=$p; break; }
    done
fi
echo "[lld-link] host ssh port = $SSH_PORT -> guest 22"

# ---- 5. Boot under OVMF pflash (NOT -kernel). ESP via vvfat, payload on NVMe.
rm -f "$SERIAL"
qemu-system-x86_64 -no-user-config -monitor none -nographic -no-reboot \
    -machine q35 -cpu qemu64 -m "$QEMU_MEM" \
    -drive "if=pflash,format=raw,readonly=on,file=$OVMF_CODE" \
    -drive "if=pflash,format=raw,file=$OVMF_VARS" \
    -drive "file=fat:rw:$ESP,format=raw,id=esp,if=none" \
    -device virtio-blk-pci,drive=esp,bootindex=0 \
    -serial "file:$SERIAL" \
    -device isa-debug-exit,iobase=0xf4,iosize=0x04 \
    -drive "file=$IMG,if=none,id=nvm,format=raw" -device nvme,serial=deadbeef,drive=nvm \
    -netdev "user,id=n0,hostfwd=tcp::$SSH_PORT-:22" -device virtio-net-pci,netdev=n0 &
QEMU_PID=$!
trap 'kill "$QEMU_PID" 2>/dev/null || true' EXIT

# ---- 6. Wait for the ring-3 accept loop under OVMF -------------------------
i=0
while [ $i -lt "$BOOT_WAIT" ]; do
    grep -qa "accept loop start" "$SERIAL" 2>/dev/null && break
    kill -0 "$QEMU_PID" 2>/dev/null || break
    sleep 1; i=$((i+1))
done
rung() { grep -qa "$1" "$SERIAL" 2>/dev/null && echo "  [ok]   $2" || echo "  [MISS] $2"; }
echo "===== UEFI boot ladder ====="
rung "\[grub-uefi\] multiboot loading" "L1 OVMF -> GRUB-EFI app ran"
rung "call _start\|SimpleOS Boot"       "L2 multiboot handoff -> kernel _start"
rung "accept loop start"                "L3 sshd ring-3 accept loop"
if ! grep -qa "accept loop start" "$SERIAL" 2>/dev/null; then
    echo "===== RESULT: accept loop NOT reached under OVMF ====="
    sed 's/\x1b\[[0-9;]*[A-Za-z]//g' "$SERIAL" 2>/dev/null | grep -a . | tail -30
    exit 1
fi

# ---- 7. Ladder rungs 3-6 over SSH -------------------------------------------
# Rung 3: FS-exec launches ld.lld directly (no fork -- same dispatch idiom
# already proven for `clang -cc1` and `/usr/bin/simple`; absolute path
# bypasses the sshd canned-fixture branch, see ssh_simple_hello_uefi.shs
# header note 3).
echo "[lld-link] rung3: ssh -p $SSH_PORT root@127.0.0.1 /usr/bin/ld.lld --version"
sshpass -p simpleos ssh -p "$SSH_PORT" -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 \
    root@127.0.0.1 /usr/bin/ld.lld --version || true
j=0
while [ $j -lt 60 ]; do
    grep -qaE "LLD [0-9]|ring3 deferred .*returned rc|command not found" "$SERIAL" 2>/dev/null && break
    kill -0 "$QEMU_PID" 2>/dev/null || break
    sleep 2; j=$((j+2))
done
rung "LLD [0-9]" "rung3 /usr/bin/ld.lld started via FS-exec, printed version"

# Rung 4: ld.lld links the staged guest object (+crt0.o) into /hello.elf,
# using the staged linker script -- persisted to NVMe (same "persist ... -> OK"
# marker convention as the proven cc1 gate's /hello.o write).
LLD_CMD="/usr/bin/ld.lld -T /simpleos.ld -o /hello.elf /crt0.o /hello.o"
echo "[lld-link] rung4: ssh -p $SSH_PORT root@127.0.0.1 $LLD_CMD"
sshpass -p simpleos ssh -p "$SSH_PORT" -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 \
    root@127.0.0.1 $LLD_CMD || true
k=0
while [ $k -lt 60 ]; do
    grep -qaE "persist /hello.elf -> OK|ring3 deferred .*returned rc|command not found" "$SERIAL" 2>/dev/null && break
    kill -0 "$QEMU_PID" 2>/dev/null || break
    sleep 2; k=$((k+2))
done
rung "persist /hello.elf -> OK" "rung4 ld.lld linked /hello.o + /crt0.o -> /hello.elf on NVMe"

# Rungs 5+6: run the just-linked ELF directly from the filesystem and check
# its exit status + output.
echo "[lld-link] rung5/6: ssh -p $SSH_PORT root@127.0.0.1 /hello.elf"
SSH_OUT="$(sshpass -p simpleos ssh -p "$SSH_PORT" -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 \
    root@127.0.0.1 /hello.elf 2>&1 || true)"
echo "[lld-link] ssh channel output: <<$SSH_OUT>>"
m=0
while [ $m -lt 60 ]; do
    grep -qaE "ring3 deferred .*returned rc|command not found" "$SERIAL" 2>/dev/null && break
    kill -0 "$QEMU_PID" 2>/dev/null || break
    sleep 2; m=$((m+2))
done
kill "$QEMU_PID" 2>/dev/null || true; sleep 1

echo "===== exec ladder (serial) ====="
rung "ring3 deferred"        "rung5 /hello.elf started via FS-exec"
rung "returned rc=0\|exit 0" "rung6 /hello.elf returned the expected status"
echo "===== serial tail ====="
sed 's/\x1b\[[0-9;]*[A-Za-z]//g' "$SERIAL" | grep -a . | tail -40

if grep -qaE "LLD [0-9]" "$SERIAL" 2>/dev/null \
   && grep -qa "persist /hello.elf -> OK" "$SERIAL" 2>/dev/null \
   && grep -qaE "returned rc=0|exit 0" "$SERIAL" 2>/dev/null; then
    echo "PASS: in-guest ld.lld linked and ran /hello.elf under OVMF (board proxy)"
else
    echo "FAIL: one or more ladder rungs 3-6 not observed (see serial tail above)"
    exit 1
fi
