#!/usr/bin/env sh
set -eu

SERIAL="${TIGARD_SERIAL:-tiBMLHE7}"
BASE="/dev/serial/by-id"
test -d "$BASE" || { echo "starfive_status=blocked"; echo "starfive_reason=tigard-not-enumerated"; exit 2; }

UART_MATCHES="$(find "$BASE" -maxdepth 1 -type l -name "usb-Tigard_*_${SERIAL}-if00-port0" -print)"
JTAG_MATCHES="$(find "$BASE" -maxdepth 1 -type l -name "usb-Tigard_*_${SERIAL}-if01-port0" -print)"
test "$(printf '%s\n' "$UART_MATCHES" | sed '/^$/d' | wc -l)" -eq 1 || {
    echo "starfive_status=blocked"; echo "starfive_reason=tigard-uart-missing-or-ambiguous"; exit 2;
}
test "$(printf '%s\n' "$JTAG_MATCHES" | sed '/^$/d' | wc -l)" -eq 1 || {
    echo "starfive_status=blocked"; echo "starfive_reason=tigard-jtag-missing-or-ambiguous"; exit 2;
}

UART_PATH="$(readlink -f "$UART_MATCHES")"
JTAG_PATH="$(readlink -f "$JTAG_MATCHES")"
echo "tigard_status=pass"
echo "tigard_vid_pid=0403:6010"
echo "tigard_serial=$SERIAL"
echo "tigard_uart_channel=A"
echo "tigard_uart_path=$UART_PATH"
echo "tigard_jtag_channel=B"
echo "tigard_jtag_path=$JTAG_PATH"
