# fsexec_mkimg_lld.spl — FAT32 *structural prefix* writer for the in-guest
# ld.lld LINK ladder (rungs 3-6, doc/03_plan/os/in_guest_lld_link_ladder.md;
# lane C4 of doc/03_plan/os/simpleos/toolchain_selfhost_bootstrap_plan.md).
#
# Why a NEW stager: scripts/os/fsexec_mkimg_big.spl and fsexec_mkimg_simple.spl
# each stage exactly ONE big ELF payload plus ONE small companion file. The link
# ladder needs lld_static PLUS crt0.o PLUS a linker script PLUS one or more
# guest objects PLUS (for the C5 C++ row) libc++.a, all resident at once.
#
# FAT32 CONSTRAINT (load-bearing, lane C4 plan line 152): the SimpleOS kernel
# FAT32 driver is ROOT-DIRECTORY-ONLY with 8.3 names on the WRITE path (mkdir /
# LFN create do not exist; subdirectory READ traversal was only just added).
# Therefore this stager deliberately creates NO subdirectories at all — unlike
# fsexec_mkimg_big.spl, which builds a /usr/bin FHS skeleton. Every staged file
# is an uppercase 8.3 name in the ROOT directory, and the in-guest link output
# (/HELLO.ELF) is likewise created in the root by the in-guest write path.
#
# Layout (bytes_per_sector=512, sectors_per_cluster=64 => 32 KiB clusters,
# reserved=32, num_fats=1 — identical geometry to fsexec_mkimg_big.spl so the
# boot-side C reader `_fat32_next_cluster` (FAT1 only) keeps working):
#
#   cluster 2                      root directory (one cluster)
#   cluster 3 .. S-1               SMALL files, each a contiguous chain,
#                                  materialised INSIDE the prefix buffer
#   cluster S  .. S+P1-1           BIG payload 1: LLD.ELF (lld_static)
#   cluster S+P1 .. S+P1+P2-1      BIG payload 2 (optional): LIBCXX.A
#   +SPARE_CLUSTERS                free clusters so the in-guest FAT32 write
#                                  path can persist the LINKED ELF back to disk
#
# The two BIG payloads are never loaded into a Simple array (a 100 MB-class
# `lld_static` would be infeasible in the seed interpreter). This program emits
# only the structural prefix; the caller (scripts/os/ssh_lld_link_uefi.shs)
# concatenates:  prefix | LLD.ELF (padded to payload1_padded_bytes) | LIBCXX.A
# and then truncates the result to total_bytes. All figures needed for that are
# printed on the single `fsexec_mkimg_lld_status=` line below.
#
# Small files are read with rt_file_read_bytes and copied with O(1) index
# assignment into a PRE-ALLOCATED zero buffer (never [u8].push in a hot loop —
# push is O(n) per element in the seed interpreter). The small-file cap below
# keeps that copy bounded; anything larger must become a BIG payload instead.
#
# Inputs (all staged under STAGE_DIR by the caller, already renamed to 8.3):
#   build/os/elfexec_lld/stage/CRT0.O        crt0 from the SimpleOS sysroot
#   build/os/elfexec_lld/stage/SIMPLEOS.LD   sysroot linker script
#   build/os/elfexec_lld/stage/HELLO.O       guest object to link       (C4)
#   build/os/elfexec_lld/stage/HELLO2.O      second TU                  (C5 b)
#   build/os/elfexec_lld/stage/LIBC.A        libsimpleos_c.a            (C5)
#   build/os/elfexec_lld/stage/HELLO.C       C source for in-guest cc1  (C4/C5)
#   build/os/elfexec_lld/stage/HELLO2.C      second TU source           (C5 b)
#   build/os/elfexec_lld/stage/HELLOCXX.CC   C++ source                 (C5 c)
#   build/os/elfexec_lld/stage/TU1.I         preprocessed TU            (B1)
#   (each optional — a missing/empty file is simply not staged)
#   build/os/elfexec_lld/payload_size.txt    decimal byte size of lld_static
#   build/os/elfexec_lld/libcxx_size.txt     decimal byte size of libc++.a
#                                            (absent or 0 => not staged)
# Output:
#   build/os/elfexec_lld/fat32-lld-prefix.bin

extern fn rt_file_read_bytes(path: text) -> [u8]
extern fn rt_file_write_bytes(path: text, data: [u8]) -> bool
extern fn rt_byte_array_new_len(len: u64) -> [u8]

fn _parse_u64(data: [u8]) -> u64:
    var v: u64 = 0u64
    var i: i64 = 0
    while i < data.len():
        val c = data[i] as u64
        if c >= 0x30u64 and c <= 0x39u64:
            v = (v * 10u64) + (c - 0x30u64)
        i = i + 1
    v

fn _dot_pos(s: text) -> u64:
    """Index of the LAST '.' in s, or s.length when there is none."""
    var i: u64 = 0u64
    var p: u64 = s.length
    while i < s.length:
        if (s[i] as u8) == 0x2Eu8:
            p = i
        i = i + 1u64
    p

fn _name83_of(name: text) -> [u8]:
    """11 raw FAT32 8.3 name bytes from an already-uppercase FILE.EXT text.

    Splits on the last '.' and space-pads both halves. No text slicing is used
    (byte indexing only), so this stays safe under the seed interpreter.
    """
    val dp = _dot_pos(name)
    var out: [u8] = []
    var i: u64 = 0u64
    while i < 8u64:
        if i < dp:
            out.push(name[i] as u8)
        else:
            out.push(0x20u8)
        i = i + 1u64
    var e: u64 = 0u64
    while e < 3u64:
        val src = dp + 1u64 + e
        if src < name.length:
            out.push(name[src] as u8)
        else:
            out.push(0x20u8)
        e = e + 1u64
    out

fn _dir_entry(name83: [u8], cluster: u64, size: u64, attr: u8) -> [u8]:
    """Build one 32-byte FAT32 directory entry."""
    var e: [u8] = []
    var i: u64 = 0u64
    while i < 11u64:
        e.push(name83[i])
        i = i + 1u64
    e.push(attr)                                       # attr
    e.push(0u8)                                        # NTRes
    e.push(0u8)                                        # CrtTimeTenth
    e.push(0u8)
    e.push(0u8)                                        # CrtTime
    e.push(0u8)
    e.push(0u8)                                        # CrtDate
    e.push(0u8)
    e.push(0u8)                                        # LstAccDate
    e.push(((cluster >> 16) & 0xFFu64) as u8)          # FstClusHI lo
    e.push(((cluster >> 24) & 0xFFu64) as u8)          # FstClusHI hi
    e.push(0u8)
    e.push(0u8)                                        # WrtTime
    e.push(0u8)
    e.push(0u8)                                        # WrtDate
    e.push((cluster & 0xFFu64) as u8)                  # FstClusLO lo
    e.push(((cluster >> 8) & 0xFFu64) as u8)           # FstClusLO hi
    e.push((size & 0xFFu64) as u8)                     # FileSize
    e.push(((size >> 8) & 0xFFu64) as u8)
    e.push(((size >> 16) & 0xFFu64) as u8)
    e.push(((size >> 24) & 0xFFu64) as u8)
    e

fn _write_bytes_at(buf: [u8], base: i64, data: [u8]) -> [u8]:
    var i: i64 = 0
    while i < data.len():
        buf[base + i] = data[i]
        i = i + 1
    buf

fn _cluster_base(data_start_sector: u64, cluster_bytes: u64, n: u64) -> i64:
    ((data_start_sector * 512u64) + ((n - 2u64) * cluster_bytes)) as i64

fn _clusters_for(n: u64, cluster_bytes: u64) -> u64:
    var c: u64 = n / cluster_bytes
    if n % cluster_bytes != 0u64:
        c = c + 1u64
    c

fn _small_names() -> [text]:
    """Fixed 8.3 candidate table — every entry is optional.

    A fixed table (rather than a directory scan) keeps this stager free of any
    host filesystem-enumeration dependency and makes the set of names that can
    ever appear in the guest root auditable from this file alone.
    """
    [
        "CRT0.O",
        "SIMPLEOS.LD",
        "HELLO.O",
        "HELLO2.O",
        "LIBC.A",
        "HELLO.C",
        "HELLO2.C",
        "HELLOCXX.CC",
        "TU1.I"
    ]

fn main() -> i64:
    val STAGE = "build/os/elfexec_lld/stage/"
    val prefix_path = "build/os/elfexec_lld/fat32-lld-prefix.bin"

    val SPC: u64 = 64u64
    val CLUSTER_BYTES: u64 = SPC * 512u64          # 32768
    val RESERVED: u64 = 32u64
    val NUM_FATS: u64 = 1u64
    # Anything above this must become a shell-appended BIG payload instead of
    # an in-prefix small file: the copy below is an interpreted byte loop.
    val SMALL_MAX: u64 = 262144u64                 # 256 KiB
    # Free clusters past the last payload so the in-guest FAT32 write path can
    # persist the LINKED ELF (rung 4 output /HELLO.ELF). A statically linked
    # hello against libsimpleos_c.a is a few hundred KiB to a few MiB, so the
    # 16-cluster (512 KiB) reserve used by fsexec_mkimg_big.spl for a bare .o
    # is NOT enough here.
    val SPARE_CLUSTERS: u64 = 256u64               # 8 MiB

    val payload1: u64 = _parse_u64(rt_file_read_bytes("build/os/elfexec_lld/payload_size.txt") ?? [])
    if payload1 == 0u64:
        print "fsexec_mkimg_lld_error=missing or zero build/os/elfexec_lld/payload_size.txt (lld_static size)"
        return 1
    val payload2: u64 = _parse_u64(rt_file_read_bytes("build/os/elfexec_lld/libcxx_size.txt") ?? [])

    # ---- Pass 1: which small files exist, how big, which cluster ----------
    val names: [text] = _small_names()
    var sizes: [u64] = []
    var starts: [u64] = []
    var next_cluster: u64 = 3u64                   # cluster 2 is the root dir
    var i: i64 = 0
    while i < names.len():
        val b: [u8] = rt_file_read_bytes(STAGE + names[i]) ?? []
        val n: u64 = b.len() as u64
        if n > SMALL_MAX:
            print "fsexec_mkimg_lld_error=too large for the prefix (make it a big payload): " + names[i]
            return 1
        sizes.push(n)
        starts.push(next_cluster)
        if n > 0u64:
            next_cluster = next_cluster + _clusters_for(n, CLUSTER_BYTES)
        i = i + 1

    val P1_START: u64 = next_cluster
    val p1_clusters: u64 = _clusters_for(payload1, CLUSTER_BYTES)
    val P2_START: u64 = P1_START + p1_clusters
    var p2_clusters: u64 = 0u64
    if payload2 > 0u64:
        p2_clusters = _clusters_for(payload2, CLUSTER_BYTES)

    val highest_cluster: u64 = (P2_START + p2_clusters) - 1u64
    val fat_entries: u64 = highest_cluster + 1u64 + SPARE_CLUSTERS
    var fat_sectors: u64 = (fat_entries * 4u64) / 512u64
    if (fat_entries * 4u64) % 512u64 != 0u64:
        fat_sectors = fat_sectors + 1u64
    fat_sectors = fat_sectors + 8u64                       # slack

    val data_start_sector: u64 = RESERVED + (NUM_FATS * fat_sectors)
    # The prefix covers the root dir + every small-file cluster, i.e. clusters
    # 2 .. P1_START-1, and stops exactly on the P1_START cluster boundary so
    # the caller's `cat prefix LLD.ELF` lands lld contiguously at P1_START.
    val prefix_clusters: u64 = P1_START - 2u64
    val prefix_bytes_u: u64 = (data_start_sector * 512u64) + (prefix_clusters * CLUSTER_BYTES)
    val used_clusters: u64 = (highest_cluster - 1u64)      # clusters 2..highest
    val total_sectors: u64 = data_start_sector + ((used_clusters + SPARE_CLUSTERS) * SPC)
    val total_bytes: u64 = total_sectors * 512u64
    val payload1_padded: u64 = p1_clusters * CLUSTER_BYTES

    var img: [u8] = rt_byte_array_new_len(prefix_bytes_u)

    # ---- Sector 0: BPB ----
    img[0] = 0xEBu8
    img[1] = 0x58u8
    img[2] = 0x90u8
    img[3] = 0x53u8   # OEM "SIMPLEOS"
    img[4] = 0x49u8
    img[5] = 0x4Du8
    img[6] = 0x50u8
    img[7] = 0x4Cu8
    img[8] = 0x45u8
    img[9] = 0x4Fu8
    img[10] = 0x53u8
    img[11] = 0x00u8  # bytes_per_sector = 512
    img[12] = 0x02u8
    img[13] = SPC as u8                        # sectors_per_cluster
    img[14] = (RESERVED & 0xFFu64) as u8       # reserved_sectors
    img[15] = ((RESERVED >> 8) & 0xFFu64) as u8
    img[16] = NUM_FATS as u8                    # num_fats
    # 17..20 root_entry_count / total_sectors_16 = 0
    img[21] = 0xF8u8  # media
    # 22..23 fat_size_16 = 0
    img[24] = 0x3Fu8  # sectors_per_track = 63
    img[26] = 0xFFu8  # num_heads = 255
    # 28..31 hidden = 0
    img[32] = (total_sectors & 0xFFu64) as u8          # total_sectors_32 LE
    img[33] = ((total_sectors >> 8) & 0xFFu64) as u8
    img[34] = ((total_sectors >> 16) & 0xFFu64) as u8
    img[35] = ((total_sectors >> 24) & 0xFFu64) as u8
    img[36] = (fat_sectors & 0xFFu64) as u8            # fat_size_32 LE
    img[37] = ((fat_sectors >> 8) & 0xFFu64) as u8
    img[38] = ((fat_sectors >> 16) & 0xFFu64) as u8
    img[39] = ((fat_sectors >> 24) & 0xFFu64) as u8
    # 40..43 ext_flags / fs_version = 0
    img[44] = 0x02u8  # root_cluster = 2
    img[48] = 0x01u8  # fs_info sector = 1
    img[50] = 0x06u8  # backup_boot_sector = 6
    img[64] = 0x80u8  # drive_number
    img[66] = 0x29u8  # boot_sig
    img[67] = 0x78u8  # vol_id 0x12345678 LE
    img[68] = 0x56u8
    img[69] = 0x34u8
    img[70] = 0x12u8
    img[71] = 0x53u8  # vol_label "SIMPLEOS   "
    img[72] = 0x49u8
    img[73] = 0x4Du8
    img[74] = 0x50u8
    img[75] = 0x4Cu8
    img[76] = 0x45u8
    img[77] = 0x4Fu8
    img[78] = 0x53u8
    img[79] = 0x20u8
    img[80] = 0x20u8
    img[81] = 0x20u8
    img[82] = 0x46u8  # "FAT32   "
    img[83] = 0x41u8
    img[84] = 0x54u8
    img[85] = 0x33u8
    img[86] = 0x32u8
    img[87] = 0x20u8
    img[88] = 0x20u8
    img[89] = 0x20u8
    img[510] = 0x55u8
    img[511] = 0xAAu8

    # ---- Sector 1: FSInfo ----
    img[512] = 0x52u8  # lead_sig 0x41615252 LE
    img[513] = 0x52u8
    img[514] = 0x61u8
    img[515] = 0x41u8
    img[512 + 484] = 0x72u8  # struct_sig 0x61417272 LE
    img[512 + 485] = 0x72u8
    img[512 + 486] = 0x41u8
    img[512 + 487] = 0x61u8
    img[512 + 488] = 0xFFu8  # free_count = unknown
    img[512 + 489] = 0xFFu8
    img[512 + 490] = 0xFFu8
    img[512 + 491] = 0xFFu8
    img[512 + 492] = 0xFFu8  # next_free = unknown
    img[512 + 493] = 0xFFu8
    img[512 + 494] = 0xFFu8
    img[512 + 495] = 0xFFu8
    img[512 + 510] = 0x55u8
    img[512 + 511] = 0xAAu8

    # ---- FAT1 (starts at RESERVED*512) ----
    val fat_base: i64 = (RESERVED * 512u64) as i64
    img[fat_base + 0] = 0xF8u8   # entry 0 (media)
    img[fat_base + 1] = 0xFFu8
    img[fat_base + 2] = 0xFFu8
    img[fat_base + 3] = 0x0Fu8
    img[fat_base + 4] = 0xFFu8   # entry 1 (EOC)
    img[fat_base + 5] = 0xFFu8
    img[fat_base + 6] = 0xFFu8
    img[fat_base + 7] = 0x0Fu8
    img[fat_base + 8] = 0xFFu8   # entry 2 (root dir, single cluster, EOC)
    img[fat_base + 9] = 0xFFu8
    img[fat_base + 10] = 0xFFu8
    img[fat_base + 11] = 0x0Fu8

    # One contiguous chain per staged file (small files, then the two big
    # payloads). Written directly, not via a helper, to keep it O(1) per entry.
    var ci: i64 = 0
    while ci < names.len():
        if sizes[ci] > 0u64:
            val first: u64 = starts[ci]
            val last: u64 = (first + _clusters_for(sizes[ci], CLUSTER_BYTES)) - 1u64
            var c: u64 = first
            while c <= last:
                var next: u64 = 0x0FFFFFFFu64
                if c < last:
                    next = c + 1u64
                val eo: i64 = fat_base + ((c * 4u64) as i64)
                img[eo + 0] = (next & 0xFFu64) as u8
                img[eo + 1] = ((next >> 8) & 0xFFu64) as u8
                img[eo + 2] = ((next >> 16) & 0xFFu64) as u8
                img[eo + 3] = ((next >> 24) & 0xFFu64) as u8
                c = c + 1u64
        ci = ci + 1

    var pc: u64 = P1_START
    val p1_last: u64 = (P1_START + p1_clusters) - 1u64
    while pc <= p1_last:
        var pn: u64 = 0x0FFFFFFFu64
        if pc < p1_last:
            pn = pc + 1u64
        val peo: i64 = fat_base + ((pc * 4u64) as i64)
        img[peo + 0] = (pn & 0xFFu64) as u8
        img[peo + 1] = ((pn >> 8) & 0xFFu64) as u8
        img[peo + 2] = ((pn >> 16) & 0xFFu64) as u8
        img[peo + 3] = ((pn >> 24) & 0xFFu64) as u8
        pc = pc + 1u64

    if p2_clusters > 0u64:
        var qc: u64 = P2_START
        val p2_last: u64 = (P2_START + p2_clusters) - 1u64
        while qc <= p2_last:
            var qn: u64 = 0x0FFFFFFFu64
            if qc < p2_last:
                qn = qc + 1u64
            val qeo: i64 = fat_base + ((qc * 4u64) as i64)
            img[qeo + 0] = (qn & 0xFFu64) as u8
            img[qeo + 1] = ((qn >> 8) & 0xFFu64) as u8
            img[qeo + 2] = ((qn >> 16) & 0xFFu64) as u8
            img[qeo + 3] = ((qn >> 24) & 0xFFu64) as u8
            qc = qc + 1u64

    # ---- Root directory (cluster 2) — ROOT-ONLY, no subdirectories -------
    val rd: i64 = (data_start_sector * 512u64) as i64
    var slot: i64 = 0
    var staged: text = ""
    var di: i64 = 0
    while di < names.len():
        if sizes[di] > 0u64:
            img = _write_bytes_at(img, rd + (slot * 32),
                _dir_entry(_name83_of(names[di]), starts[di], sizes[di], 0x20u8))
            staged = staged + names[di] + ","
            slot = slot + 1
        di = di + 1
    img = _write_bytes_at(img, rd + (slot * 32),
        _dir_entry(_name83_of("LLD.ELF"), P1_START, payload1, 0x20u8))
    staged = staged + "LLD.ELF,"
    slot = slot + 1
    if p2_clusters > 0u64:
        img = _write_bytes_at(img, rd + (slot * 32),
            _dir_entry(_name83_of("LIBCXX.A"), P2_START, payload2, 0x20u8))
        staged = staged + "LIBCXX.A,"
        slot = slot + 1

    # ---- Small-file DATA into their clusters (inside the prefix) ---------
    var wi: i64 = 0
    while wi < names.len():
        if sizes[wi] > 0u64:
            val data: [u8] = rt_file_read_bytes(STAGE + names[wi]) ?? []
            val base: i64 = _cluster_base(data_start_sector, CLUSTER_BYTES, starts[wi])
            var bi: i64 = 0
            while bi < data.len():
                img[base + bi] = data[bi]
                bi = bi + 1
        wi = wi + 1

    if not rt_file_write_bytes(prefix_path, img):
        print "fsexec_mkimg_lld_error=write prefix failed: " + prefix_path
        return 1

    print "fsexec_mkimg_lld_status=ok staged=" + staged + " root_entries=" + slot.to_text() + " spc=" + SPC.to_text() + " fat_sectors=" + fat_sectors.to_text() + " prefix_bytes=" + prefix_bytes_u.to_text() + " payload1_start=" + P1_START.to_text() + " payload1_bytes=" + payload1.to_text() + " payload1_padded_bytes=" + payload1_padded.to_text() + " payload2_start=" + P2_START.to_text() + " payload2_bytes=" + payload2.to_text() + " spare_clusters=" + SPARE_CLUSTERS.to_text() + " total_bytes=" + total_bytes.to_text()
    return 0
