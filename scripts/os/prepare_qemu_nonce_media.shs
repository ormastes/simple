#!/bin/sh
set -eu

# Create a per-run FAT image and inject the target-observed QEMU nonce.
# The source image is never mutated: parallel matrix rows may safely share it.

fail() {
    echo "prepare-qemu-nonce-media: $*" >&2
    exit 1
}

[ "$#" -eq 3 ] || [ "$#" -eq 4 ] || fail "usage: SOURCE_IMAGE RUN_IMAGE WORKLOAD_NONCE [COLLECTOR_NONCE]"
source_image="$1"
run_image="$2"
nonce="$3"
collector_nonce=${4:-}

[ -f "$source_image" ] || fail "missing source image: $source_image"
[ -n "$nonce" ] || fail "nonce is empty"
[ "${#nonce}" -le 96 ] || fail "nonce exceeds 96 bytes"
case "$nonce" in
    *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._:-]*)
        fail "nonce contains unsupported characters"
        ;;
esac
mkdir -p "$(dirname -- "$run_image")"
physical_path() {
    path=$1
    if [ -e "$path" ] || [ -L "$path" ]; then
        perl -MCwd=abs_path -e '
            my $path = abs_path($ARGV[0]);
            defined($path) or exit 1;
            print $path;
        ' "$path" || fail "cannot resolve path: $path"
    else
        parent=$(CDPATH= cd -P -- "$(dirname -- "$path")" && pwd)
        printf '%s/%s' "$parent" "$(basename -- "$path")"
    fi
}
source_resolved=$(physical_path "$source_image")
run_resolved=$(physical_path "$run_image")
[ "$source_resolved" != "$run_resolved" ] || fail "source and run image resolve to the same path"
tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/simpleos-qemu-nonce.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
nonce_file="$tmp_dir/QEMUNONC.TXT"
payload_nonce_file="$tmp_dir/FSEXEC.NONCE"
collector_nonce_file="$tmp_dir/SOSIXNON.TXT"
run_tmp="$tmp_dir/run.img"
dd if=/dev/zero of="$nonce_file" bs=118 count=1 2>/dev/null
printf 'SIMPLEOS_QEMU_NONCE=%s\n' "$nonce" \
    | dd of="$nonce_file" conv=notrunc 2>/dev/null
dd if=/dev/zero of="$payload_nonce_file" bs=96 count=1 2>/dev/null
printf '%s' "$nonce" | dd of="$payload_nonce_file" conv=notrunc 2>/dev/null
if [ -n "$collector_nonce" ]; then
    [ "${#collector_nonce}" -le 96 ] || fail "collector nonce exceeds 96 bytes"
    case "$collector_nonce" in
        *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._:-]*)
            fail "collector nonce contains unsupported characters" ;;
    esac
    dd if=/dev/zero of="$collector_nonce_file" bs=118 count=1 2>/dev/null
    printf 'SOSIX_COLLECTOR_RUN_NONCE=%s\n' "$collector_nonce" \
        | dd of="$collector_nonce_file" conv=notrunc 2>/dev/null
fi

placeholder='SIMPLEOS_QEMU_NONCE=__SIMPLEOS_QEMU_NONCE_SLOT_V1__'
offsets="$(LC_ALL=C grep -aob "$placeholder" "$source_image" | cut -d: -f1)"
[ "$(printf '%s\n' "$offsets" | sed '/^$/d' | wc -l | tr -d ' ')" -eq 1 ] \
    || fail "source image does not contain exactly one nonce slot"
offset="$(printf '%s\n' "$offsets" | sed -n '1p')"
cp "$source_image" "$run_tmp"
payload_placeholder='__SIMPLEOS_FS_EXEC_NONCE_SLOT_V1__'
payload_offsets="$(LC_ALL=C grep -aob "$payload_placeholder" "$source_image" | cut -d: -f1)"
[ "$(printf '%s\n' "$payload_offsets" | sed '/^$/d' | wc -l | tr -d ' ')" -eq 1 ] \
    || fail "source image does not contain exactly one fs-exec nonce slot"
payload_offset="$(printf '%s\n' "$payload_offsets" | sed -n '1p')"
collector_offset=
if [ -n "$collector_nonce" ]; then
    collector_placeholder='SOSIX_COLLECTOR_RUN_NONCE=__SOSIX_COLLECTOR_RUN_NONCE_SLOT_V1__'
    collector_offsets="$(LC_ALL=C grep -aob "$collector_placeholder" "$source_image" | cut -d: -f1)"
    [ "$(printf '%s\n' "$collector_offsets" | sed '/^$/d' | wc -l | tr -d ' ')" -eq 1 ] \
        || fail "source image does not contain exactly one collector nonce slot"
    collector_offset="$(printf '%s\n' "$collector_offsets" | sed -n '1p')"
fi

# Patch both fixed slots by seek, verify exact readback, locate the nearest
# preceding ELF in 64 KiB blocks, parse its PT_LOAD extent directly, and copy
# only those bytes for hashing. This avoids the old `dd bs=1` whole-image-tail
# copy while remaining independent of GNU dd byte-seek extensions.
elf_facts=$(perl - "$run_tmp" "$offset" "$nonce_file" "$payload_offset" \
    "$payload_nonce_file" "$collector_offset" "$collector_nonce_file" \
    "$tmp_dir/fs-exec-patched.elf" <<'PERL'
use strict;
use warnings;

my ($path, $guest_at, $guest_file, $payload_at, $payload_file, $collector_at,
    $collector_file, $out_path) = @ARGV;
sub read_exact {
    my ($fh, $at, $len) = @_;
    sysseek($fh, $at, 0) == $at or die "seek failed\n";
    my $data = "";
    while (length($data) < $len) {
        my $n = sysread($fh, $data, $len - length($data), length($data));
        defined($n) && $n > 0 or die "short read\n";
    }
    return $data;
}
sub file_bytes {
    my ($name, $expected) = @_;
    open my $fh, "<", $name or die "open slot failed\n";
    binmode $fh;
    my $data = read_exact($fh, 0, $expected);
    sysread($fh, my $extra, 1) == 0 or die "oversized slot\n";
    close $fh or die "close slot failed\n";
    return $data;
}
sub write_exact {
    my ($fh, $at, $data) = @_;
    sysseek($fh, $at, 0) == $at or die "patch seek failed\n";
    my $done = 0;
    while ($done < length($data)) {
        my $n = syswrite($fh, $data, length($data) - $done, $done);
        defined($n) && $n > 0 or die "short write\n";
        $done += $n;
    }
}
sub u16 { return unpack("v", $_[0]); }
sub u32 { return unpack("V", $_[0]); }
sub u64 { return unpack("Q<", $_[0]); }

open my $img, "+<", $path or die "open image failed\n";
binmode $img;
my $guest = file_bytes($guest_file, 118);
my $payload = file_bytes($payload_file, 96);
write_exact($img, $guest_at, $guest);
write_exact($img, $payload_at, $payload);
read_exact($img, $guest_at, 118) eq $guest or die "guest nonce readback mismatch\n";
read_exact($img, $payload_at, 96) eq $payload or die "payload nonce readback mismatch\n";
if (length($collector_at)) {
    my $collector = file_bytes($collector_file, 118);
    write_exact($img, $collector_at, $collector);
    read_exact($img, $collector_at, 118) eq $collector
        or die "collector nonce readback mismatch\n";
}

my ($pos, $elf_at) = ($payload_at, -1);
my $block = 65536;
while ($pos > 0) {
    my $start = $pos > $block ? $pos - $block : 0;
    my $chunk = read_exact($img, $start, $pos - $start);
    my $found = rindex($chunk, "\x7fELF");
    if ($found >= 0) { $elf_at = $start + $found; last; }
    last if $start == 0;
    $pos = $start + 3; # overlap the four-byte magic across block boundaries
}
$elf_at >= 0 or die "ELF header not found\n";
my $eh = read_exact($img, $elf_at, 64);
substr($eh, 0, 4) eq "\x7fELF" or die "bad ELF magic\n";
ord(substr($eh, 5, 1)) == 1 or die "ELF is not little-endian\n";
my $class = ord(substr($eh, 4, 1));
my ($phoff, $phentsize, $phnum);
if ($class == 1) {
    $phoff = u32(substr($eh, 28, 4));
    $phentsize = u16(substr($eh, 42, 2));
    $phnum = u16(substr($eh, 44, 2));
} elsif ($class == 2) {
    $phoff = u64(substr($eh, 32, 8));
    $phentsize = u16(substr($eh, 54, 2));
    $phnum = u16(substr($eh, 56, 2));
} else { die "unsupported ELF class\n"; }
$phentsize > 0 && $phnum > 0 && $phnum <= 1024 or die "invalid program-header table\n";
my $extent = 0;
for my $i (0 .. $phnum - 1) {
    my $ph = read_exact($img, $elf_at + $phoff + $i * $phentsize, $phentsize);
    next unless u32(substr($ph, 0, 4)) == 1;
    my ($off, $filesz) = $class == 1
        ? (u32(substr($ph, 4, 4)), u32(substr($ph, 16, 4)))
        : (u64(substr($ph, 8, 8)), u64(substr($ph, 32, 8)));
    my $end = $off + $filesz;
    $extent = $end if $end > $extent;
}
$extent > 0 or die "ELF has no file-backed PT_LOAD\n";
$payload_at >= $elf_at && $payload_at + 96 <= $elf_at + $extent
    or die "payload slot is outside ELF PT_LOAD extent\n";
open my $out, ">", $out_path or die "open ELF output failed\n";
binmode $out;
my ($copied, $chunk_size) = (0, 65536);
while ($copied < $extent) {
    my $want = $extent - $copied < $chunk_size ? $extent - $copied : $chunk_size;
    my $chunk = read_exact($img, $elf_at + $copied, $want);
    print {$out} $chunk or die "ELF output write failed\n";
    $copied += $want;
}
close $out or die "close ELF output failed\n";
close $img or die "close image failed\n";
print "$elf_at $extent\n";
PERL
) || fail "cannot patch/read back nonce slots or extract fs-exec ELF"
set -- $elf_facts
[ "$#" -eq 2 ] || fail "invalid fs-exec ELF facts"
elf_offset=$1
elf_size=$2
[ "$(LC_ALL=C grep -aFo "$payload_placeholder" "$run_tmp" | wc -l | tr -d ' ')" -eq 0 ] \
    || fail "fs-exec nonce placeholder remains after patch"
if [ -n "$collector_nonce" ]; then
    [ "$(LC_ALL=C grep -aFo "$collector_placeholder" "$run_tmp" | wc -l | tr -d ' ')" -eq 0 ] \
        || fail "collector nonce placeholder remains after patch"
fi
payload_sha256=$(sha256sum "$tmp_dir/fs-exec-patched.elf" | awk '{print $1}')
image_sha256=$(sha256sum "$run_tmp" | awk '{print $1}')
mv "$run_tmp" "$run_image"
cat > "$run_image.fs-exec-receipt.tmp" <<EOF
contract=simpleos-fs-exec-run-v1
nonce=$nonce
collector_nonce=${collector_nonce:-none}
nonce_slot_bytes=96
elf_offset=$elf_offset
elf_size=$elf_size
elf_sha256=$payload_sha256
image_sha256=$image_sha256
readback=pass
EOF
mv "$run_image.fs-exec-receipt.tmp" "$run_image.fs-exec-receipt"

# stdout is a machine-readable single path consumed by the Simple runner.
printf '%s\n' "$run_image"
