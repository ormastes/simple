#!/usr/bin/env sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"
KERNEL="${UP2_KERNEL_ELF:-build/os/up-squared-apollo-lake/simpleos.elf}"
KERNEL_RECEIPT="$KERNEL.receipt"
OUT_DIR="${UP2_USB_OUT_DIR:-build/os/up-squared-apollo-lake/usb}"
IMAGE="$OUT_DIR/board-usb.img"
RECEIPT="$IMAGE.receipt"

case "$KERNEL" in /*) KERNEL_ABS="$KERNEL" ;; *) KERNEL_ABS="$ROOT_DIR/$KERNEL" ;; esac
case "$OUT_DIR" in /*) OUT_DIR_ABS="$OUT_DIR" ;; *) OUT_DIR_ABS="$ROOT_DIR/$OUT_DIR" ;; esac

test -s "$KERNEL" -a -s "$KERNEL_RECEIPT" || { echo "error: admitted UP2 kernel/receipt missing" >&2; exit 1; }
EXPECTED="$(awk -F= '$1=="artifact_sha256" {print $2; exit}' "$KERNEL_RECEIPT")"
ACTUAL="$(sha256sum "$KERNEL" | awk '{print $1}')"
test -n "$EXPECTED" -a "$EXPECTED" = "$ACTUAL" || { echo "error: UP2 kernel receipt mismatch" >&2; exit 1; }
test "$(awk -F= '$1=="target" {print $2; exit}' "$KERNEL_RECEIPT")" = x86_64-up-squared-apollo-lake || {
    echo "error: kernel receipt is not the UP2 board target" >&2
    exit 1
}

KERNEL_ELF="$KERNEL_ABS" OUT_DIR="$OUT_DIR_ABS" \
    sh scripts/os/build-simpleos-x86_64-board-usb.shs
DISK="$ROOT_DIR/$IMAGE" sh scripts/check/check-simpleos-x86_64-board-usb-image.shs

EFI="$OUT_DIR/esp-stage/EFI/BOOT/BOOTX64.EFI"
test -s "$IMAGE" -a -s "$EFI" || { echo "error: UP2 image payload missing" >&2; exit 1; }
TMP="$RECEIPT.tmp.$$"
trap 'rm -f "$TMP"' EXIT HUP INT TERM
{
    echo schema=up2-uefi-usb-image-v1
    echo status=pass
    echo target=x86_64-up-squared-apollo-lake
    echo firmware=uefi
    echo loader=EFI/BOOT/BOOTX64.EFI
    echo kernel="$KERNEL"
    echo kernel_sha256="$ACTUAL"
    echo kernel_receipt="$KERNEL_RECEIPT"
    echo bootx64="$EFI"
    echo bootx64_sha256="$(sha256sum "$EFI" | awk '{print $1}')"
    echo image="$IMAGE"
    echo image_bytes="$(wc -c < "$IMAGE" | tr -d ' ')"
    echo image_sha256="$(sha256sum "$IMAGE" | awk '{print $1}')"
    echo persistent_writes=none
    echo built_utc="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$TMP"
mv "$TMP" "$RECEIPT"
chmod 0444 "$RECEIPT"
trap - EXIT HUP INT TERM

echo up2_image_status=pass
echo image="$IMAGE"
echo image_receipt="$RECEIPT"
