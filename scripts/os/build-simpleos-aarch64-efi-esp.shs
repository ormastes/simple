#!/bin/sh
# build-simpleos-aarch64-efi-esp.shs
#
# Build a REPRODUCIBLE EFI System Partition image for the SimpleOS aarch64
# real-firmware (EDK2/AAVMF pflash) boot lane, plus stage the AAVMF firmware
# blobs next to it.
#
# ---------------------------------------------------------------------------
# WHY THIS EXISTS
# ---------------------------------------------------------------------------
# The aarch64 EFI boot lane itself already worked (see
# doc/08_tracking/bug/aarch64_real_firmware_boot_gap_and_seed_defects_2026-07-14.md):
# EDK2/AAVMF pflash -> Limine BOOTAA64.EFI -> kernel.elf, no QEMU `-kernel`
# pass semantics and no isa-debug-exit. What did NOT exist was any way to
# REBUILD its inputs: `build/os/aarch64_limine/esp.img` was a hand-made
# artifact produced once, by hand, through a throwaway `/tmp/pyfatvenv`
# virtualenv that no longer exists, in a gitignored directory. A clean clone
# therefore could not produce a bootable aarch64 EFI artifact at all, which
# made the lane un-reproducible and, in the board-runnable sense, not really
# landed. This script closes exactly that hole.
#
# ---------------------------------------------------------------------------
# DESIGN CHOICE: GRUB-style EFI-application chain, NOT a PE/COFF kernel stub
# ---------------------------------------------------------------------------
# Two ways to make an aarch64 kernel EFI-bootable:
#   (a) put a PE/COFF EFI-stub header on kernel.elf so firmware loads the
#       kernel directly, or
#   (b) ship a real EFI application on the ESP that firmware loads, which then
#       loads the ELF kernel.
# We take (b), mirroring what x86_64 already does with a GRUB/Limine EFI app on
# a FAT ESP. It is the smaller diff by a wide margin: the repo already vendors
# a signed-shape, prebuilt `vendor/limine/BOOTAA64.EFI`, the kernel already
# speaks the Limine boot protocol (`src/os/kernel/boot/limine_boot_aarch64.spl`),
# and no compiler/linker work is needed. Option (a) would require PE/COFF
# emission from the Simple backend, which does not exist and is not worth
# inventing for boot parity.
#
# ESP layout produced (byte-for-byte the layout of the artifact that is
# already known to boot):
#     /EFI/BOOT/BOOTAA64.EFI   vendor/limine/BOOTAA64.EFI (removable-media path)
#     /boot/kernel.elf         the SimpleOS aarch64 kernel
#     /limine.conf             Limine config, serial on, graphics off
#     /startup.nsh             UEFI Shell fallback: a FRESH AAVMF NVRAM has no
#                              BootOrder entry and drops to the Shell instead of
#                              auto-booting removable media, so the Shell is
#                              told explicitly where to go.
#
# ---------------------------------------------------------------------------
# USAGE
# ---------------------------------------------------------------------------
#     sh scripts/os/build-simpleos-aarch64-efi-esp.shs
#
# Inputs (env overridable):
#     KERNEL_ELF   path to the aarch64 kernel ELF. Default: the one already in
#                  build/os/aarch64_limine/kernel.elf. Building the kernel from
#                  source is a SEPARATE, much heavier lane (seed
#                  `native-build --backend cranelift --target
#                  aarch64-unknown-none-elf --linker-script
#                  examples/09_embedded/simple_os/arch/aarch64/boot/linker_limine.ld`)
#                  and is deliberately NOT invoked here; this script is about
#                  making the BOOT ARTIFACT reproducible, and it fails loudly
#                  rather than inventing a kernel if none is present.
#     AAVMF_CODE / AAVMF_VARS   firmware blobs; auto-detected under /usr/share.
#     OUT_DIR      default build/os/aarch64_limine
#
# Exit status: 0 = image built and structurally verified; non-zero = nothing
# usable was produced. There is no partial success.

set -eu

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
OUT_DIR=${OUT_DIR:-$REPO_ROOT/build/os/aarch64_limine}
KERNEL_ELF=${KERNEL_ELF:-$OUT_DIR/kernel.elf}
ESP_MB=${ESP_MB:-64}
VENV=${VENV:-$REPO_ROOT/build/tmp/pyfatvenv}

die() { printf 'build-aarch64-efi-esp: ERROR — %s\n' "$1" >&2; exit 1; }

# --- locate firmware --------------------------------------------------------
if [ -z "${AAVMF_CODE:-}" ]; then
    for c in /usr/share/AAVMF/AAVMF_CODE.fd \
             /usr/share/AAVMF/AAVMF_CODE.no-secboot.fd \
             /usr/share/qemu-efi-aarch64/QEMU_EFI.fd; do
        [ -f "$c" ] && { AAVMF_CODE=$c; break; }
    done
fi
if [ -z "${AAVMF_VARS:-}" ]; then
    for c in /usr/share/AAVMF/AAVMF_VARS.fd; do
        [ -f "$c" ] && { AAVMF_VARS=$c; break; }
    done
fi
[ -n "${AAVMF_CODE:-}" ] || die "no EDK2/AAVMF aarch64 firmware found (set AAVMF_CODE). Install qemu-efi-aarch64. Faking this with QEMU -kernel is forbidden by .claude/rules/board-runnable.md."
[ -n "${AAVMF_VARS:-}" ] || die "no AAVMF_VARS.fd found (set AAVMF_VARS)"

# --- inputs -----------------------------------------------------------------
BOOTAA64=$REPO_ROOT/vendor/limine/BOOTAA64.EFI
[ -f "$BOOTAA64" ] || die "missing $BOOTAA64 — run: sh scripts/os/provision_limine_efi.shs"
[ -s "$KERNEL_ELF" ] || die "missing kernel ELF $KERNEL_ELF (set KERNEL_ELF=... or build the aarch64 Limine kernel lane first)"

command -v mkfs.vfat >/dev/null 2>&1 || command -v /usr/sbin/mkfs.vfat >/dev/null 2>&1 \
    || die "mkfs.vfat not available (install dosfstools)"
MKFS=$(command -v mkfs.vfat 2>/dev/null || echo /usr/sbin/mkfs.vfat)

# --- FAT writer -------------------------------------------------------------
# No mtools and no root-mount available in this environment, so files are
# written into the FAT image with pyfatfs from a repo-local venv. The venv is
# created on demand and is a BUILD TOOL, exactly like mkfs.vfat -- it is not
# product code, and nothing at runtime depends on it.
if [ ! -x "$VENV/bin/python" ]; then
    echo "[esp] creating FAT-writer venv at $VENV"
    python3 -m venv "$VENV" >/dev/null 2>&1 || die "could not create venv at $VENV"
    "$VENV/bin/pip" install --quiet pyfatfs 'setuptools<81' >/dev/null 2>&1 \
        || die "could not install pyfatfs into $VENV (network required once)"
fi
"$VENV/bin/python" -c 'import pyfatfs' >/dev/null 2>&1 || die "pyfatfs unusable in $VENV"

mkdir -p "$OUT_DIR"
ESP=$OUT_DIR/esp.img

echo "[esp] firmware  CODE=$AAVMF_CODE"
echo "[esp] firmware  VARS=$AAVMF_VARS"
echo "[esp] bootloader $BOOTAA64"
echo "[esp] kernel     $KERNEL_ELF ($(wc -c <"$KERNEL_ELF") bytes)"

# --- fresh FAT image --------------------------------------------------------
rm -f "$ESP"
dd if=/dev/zero of="$ESP" bs=1M count="$ESP_MB" status=none 2>/dev/null \
    || die "could not allocate ${ESP_MB}M image"
"$MKFS" -F 32 -n SIMPLEESP "$ESP" >/dev/null 2>&1 || die "mkfs.vfat failed on $ESP"

# --- populate ---------------------------------------------------------------
LIMINE_CONF=$(mktemp)
printf 'timeout: 0\nserial: yes\ngraphics: no\n\n/SimpleOS aarch64 Limine milestone\n    protocol: limine\n    path: boot():/boot/kernel.elf\n' > "$LIMINE_CONF"
STARTUP_NSH=$(mktemp)
printf 'FS0:\\EFI\\BOOT\\BOOTAA64.EFI\r\n' > "$STARTUP_NSH"

ESP="$ESP" BOOTAA64="$BOOTAA64" KERNEL_ELF="$KERNEL_ELF" \
LIMINE_CONF="$LIMINE_CONF" STARTUP_NSH="$STARTUP_NSH" \
"$VENV/bin/python" - <<'PY' || die "populating the FAT image failed"
import os, sys, warnings
warnings.filterwarnings("ignore")
from pyfatfs.PyFatFS import PyFatFS

esp = os.environ["ESP"]
fs = PyFatFS(esp)
fs.makedirs("/EFI/BOOT", recreate=True)
fs.makedirs("/boot", recreate=True)

def put(src, dst):
    with open(src, "rb") as f:
        fs.writebytes(dst, f.read())

put(os.environ["BOOTAA64"],    "/EFI/BOOT/BOOTAA64.EFI")
put(os.environ["KERNEL_ELF"],  "/boot/kernel.elf")
put(os.environ["LIMINE_CONF"], "/limine.conf")
put(os.environ["STARTUP_NSH"], "/startup.nsh")
fs.close()

# Re-open and verify every file is present and non-empty. A FAT write that
# silently produced a zero-length entry must not read as a successful build.
fs = PyFatFS(esp)
required = {
    "/EFI/BOOT/BOOTAA64.EFI": 1024,
    "/boot/kernel.elf":       1024,
    "/limine.conf":           16,
    "/startup.nsh":           8,
}
bad = []
for path, floor in required.items():
    try:
        n = fs.getsize(path)
    except Exception:
        bad.append(f"{path}: ABSENT")
        continue
    if n < floor:
        bad.append(f"{path}: {n} bytes (< {floor})")
    else:
        print(f"[esp]   {path}  {n} bytes")
fs.close()
if bad:
    print("[esp] VERIFY FAILED: " + "; ".join(bad), file=sys.stderr)
    sys.exit(1)
PY

rm -f "$LIMINE_CONF" "$STARTUP_NSH"

# --- stage firmware next to the image --------------------------------------
# VARS is copied writable: EDK2 writes NVRAM back into it during boot.
cp -f "$AAVMF_CODE" "$OUT_DIR/AAVMF_CODE.fd"
cp -f "$AAVMF_VARS" "$OUT_DIR/AAVMF_VARS.fd"
chmod u+w "$OUT_DIR/AAVMF_VARS.fd"

echo "[esp] built $ESP ($(wc -c <"$ESP") bytes)"
echo "[esp] sha256 $(sha256sum "$ESP" | cut -d' ' -f1)"
echo "[esp] OK — boot it with: sh scripts/check/check-simpleos-arm64-efi-real-firmware-boot.shs"
