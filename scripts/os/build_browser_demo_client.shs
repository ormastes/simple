#!/bin/sh
# Build the SimpleOS x86_64 browser-demo remote-window client.
#
# Consumed by scripts/check/check-simpleos-wm-fullscreen-evidence.shs, which
# stages the resulting ELF onto the production FAT32 disk as
# ::/SYS/APPS/BROWSMF.SMF and runs it inside the guest. This is therefore a
# GUEST binary targeting x86_64-unknown-simpleos -- never a host binary.
#
# Link contract (verified against the sysroot, not assumed):
#   - examples/09_embedded/simpleos_remote_gui/browser_demo_gui.c includes
#     remote_window_runtime.c, which defines main() and calls getpid() to stamp
#     the client PID into the window-registration message.
#   - The client object needs exactly two external symbols: getpid and
#     simpleos_syscall.
#   - build/os/sysroot/lib/crt0.o provides _start and requires main, exit and
#     __libc_init_array.
#   - libsimpleos_c.a provides exit, __libc_init_array and a real
#     syscall-backed getpid (simpleos_process/simpleos_libc, syscall 4).
# So the link is crt0.o + client object + libsimpleos_c.a, entry _start. Do not
# replace libsimpleos_c.a with a hand-written getpid stub: the PID identifies
# this client to the window manager, and a constant would make every client
# claim the same window owner.
#
# The sysroot keeps headers at $SYSROOT/include (NOT $SYSROOT/usr/include), so
# -isystem is passed explicitly; --sysroot alone makes clang look under usr/.
#
# Dead-code elimination (same rationale as scripts/os/socket_echo_loopback_gate.shs):
# linking straight against the canonical libsimpleos_c.a fails on a
# PRE-EXISTING, unrelated gap -- simpleos_libc.c's simpleos_runtime_cli_get_args()
# and rt_array_len_safe() reference rt_array_new/rt_array_push/rt_array_len/
# rt_string_new, the Simple-language runtime ABI, which only exists when a
# program is built through the real simple native-build pipeline, not a bare
# clang + ld.lld link. Those two functions are provably unreachable from this
# client (its only undefined symbols are getpid and simpleos_syscall), so we
# rebuild a --gc-sections-eligible copy of the archive (same sources, plus
# -ffunction-sections -fdata-sections) and let the linker drop them. That is
# dead-code elimination, not a behavior change, and specifically NOT a stub:
# no rt_* symbol is given a fake definition that could bind silently at runtime.
# The copy is built out-of-tree so a shared working copy's src/os/libc is never
# mutated (the Makefile's clean/build cycle would race other sessions).
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
CLANG="${CLANG:-clang-20}"
SYSROOT="${SIMPLEOS_SYSROOT:-$ROOT/build/os/sysroot}"
LINKER_SCRIPT="$SYSROOT/share/simpleos/simpleos.ld"
CRT0="$SYSROOT/lib/crt0.o"
LIBC="$SYSROOT/lib/libsimpleos_c.a"
SRC="$ROOT/examples/09_embedded/simpleos_remote_gui/browser_demo_gui.c"
OUT_DIR="$ROOT/build/os/apps/browser_demo"
OUT="$OUT_DIR/browser_demo.elf"

command -v "$CLANG" >/dev/null 2>&1 || {
    echo "missing browser-demo compiler: $CLANG" >&2
    exit 1
}

LINKER="${LINKER:-$ROOT/build/os/llvm/cross-x86_64-unknown-simpleos/bin/ld.lld}"
if [ ! -x "$LINKER" ]; then
    LINKER="$(command -v ld.lld-20 || command -v ld.lld || true)"
fi
[ -n "$LINKER" ] && [ -x "$LINKER" ] || {
    echo "missing browser-demo linker (ld.lld-20 or ld.lld)" >&2
    exit 1
}

# The sysroot (crt0.o, libsimpleos_c.a, headers, simpleos.ld) is a BUILD PRODUCT,
# not a tracked file, so a freshly created worktree has none and the link below
# died with "missing browser-demo build input: .../simpleos.ld" -- which reads
# like a toolchain fault but is only an unprovisioned prerequisite.
# src/os/port/llvm/sysroot.shs is the canonical producer and rebuilds every one
# of those inputs from tracked source, so provision on demand instead of making
# each caller remember a manual step. This adds no stub and skips no check: the
# required-inputs loop below still runs unchanged afterwards.
# Only when the caller did NOT pin an external sysroot -- an explicit
# SIMPLEOS_SYSROOT is the caller's contract and must never be written to here.
if [ -z "${SIMPLEOS_SYSROOT:-}" ]; then
    sysroot_missing=""
    for required in "$LINKER_SCRIPT" "$CRT0" "$LIBC"; do
        [ -f "$required" ] || sysroot_missing="$required"
    done
    if [ -n "$sysroot_missing" ]; then
        echo "browser-demo: provisioning SimpleOS sysroot (missing $sysroot_missing)" >&2
        sh "$ROOT/src/os/port/llvm/sysroot.shs" >&2 || {
            echo "browser-demo sysroot provisioning failed: $SYSROOT" >&2
            exit 1
        }
    fi
fi

for required in "$LINKER_SCRIPT" "$CRT0" "$LIBC" "$SRC"; do
    [ -f "$required" ] || {
        echo "missing browser-demo build input: $required" >&2
        exit 1
    }
done

mkdir -p "$OUT_DIR"

"$CLANG" --target=x86_64-unknown-simpleos --sysroot="$SYSROOT" \
    -isystem "$SYSROOT/include" \
    -ffreestanding -nostdlib -fno-builtin -fno-stack-protector \
    -mno-red-zone -fno-pic -fno-pie -O2 \
    -ffunction-sections -fdata-sections \
    -c "$SRC" -o "$OUT_DIR/browser_demo.o"

# Out-of-tree --gc-sections-eligible rebuild of the libc (see header note).
LIBC_GC_DIR="$OUT_DIR/libc-gc"
LIBC_SRC_DIR="$ROOT/src/os/libc"
rm -rf "$LIBC_GC_DIR"
mkdir -p "$LIBC_GC_DIR"
cp -R "$LIBC_SRC_DIR/." "$LIBC_GC_DIR/"
(
    cd "$LIBC_GC_DIR" &&
    make clean >/dev/null 2>&1 &&
    make CFLAGS="-target x86_64-unknown-none-elf -ffreestanding -nostdlib \
-fno-builtin -mno-red-zone -fno-stack-protector -fno-exceptions \
-fno-unwind-tables -fno-asynchronous-unwind-tables -O2 -Wall -Wextra \
-Wno-unused-parameter -ffunction-sections -fdata-sections -I include" >/dev/null
) || {
    echo "browser-demo libc --gc-sections rebuild failed: $LIBC_GC_DIR" >&2
    exit 1
}
[ -f "$LIBC_GC_DIR/libsimpleos_c.a" ] || {
    echo "browser-demo libc rebuild produced no archive: $LIBC_GC_DIR" >&2
    exit 1
}

"$LINKER" -T "$LINKER_SCRIPT" -e _start --gc-sections \
    "$CRT0" "$OUT_DIR/browser_demo.o" \
    -L"$LIBC_GC_DIR" -lsimpleos_c \
    -o "$OUT"

# Fail loudly if the toolchain produced something the guest loader cannot run.
elf_magic="$(od -An -tx1 -N 4 "$OUT" | tr -d ' \n')"
machine="$(od -An -tu1 -j 18 -N 2 "$OUT" | awk '{print $1 + 256 * $2}')"
[ "$elf_magic" = "7f454c46" ] && [ "$machine" = "62" ] || {
    echo "invalid browser-demo ELF: $OUT" >&2
    exit 1
}

# getpid must be a real resolved definition, not an unresolved import that a
# weak stub could later bind to nil. Guard the property this script exists for.
if nm "$OUT" 2>/dev/null | grep -qE '^ +U getpid$'; then
    echo "browser-demo ELF has unresolved getpid: $OUT" >&2
    exit 1
fi

echo "$OUT"
