font_companion_manifest="scripts/os/simpleos_font_bundle_companion.sha256"
if command -v sha256sum >/dev/null 2>&1; then
    sha256sum --check "$font_companion_manifest"
else
    shasum -a 256 --check "$font_companion_manifest"
fi

# The C writer derives the 34 adjacent Google companion files plus CORPUS,
# CLDR/root licenses, and THIRD_PARTY_NOTICES from these validated 16 paths.
# The closed SimpleOS font/legal projection is 53 files / 51,932,523 bytes.
if [ "$size_bits" -lt 128 ]; then
    size_bits=128
fi
export SIMPLEOS_SIMPLE_BINARY SIMPLEOS_CLANG_BINARY SIMPLEOS_LLC_BINARY SIMPLEOS_LLD_BINARY SIMPLEOS_LLVM_AR_BINARY
export SIMPLEOS_CRT0_OBJECT SIMPLEOS_RUNTIME_ARCHIVE SIMPLEOS_LIBC_ARCHIVE SIMPLEOS_LINKER_SCRIPT
export SIMPLEOS_SIMPLE_ENTRY_OBJECT SIMPLEOS_HELLO_OBJECT SIMPLEOS_HELLO_IR SIMPLEOS_FSEXEC_BINARY SIMPLEOS_SERVERS_BINARY
export SIMPLEOS_SERVERS_MANIFEST SIMPLEOS_SERVERS_ADMISSION SIMPLEOS_SERVERS_PROOF SIMPLEOS_SERVERS_TRUST_ROOT
export SIMPLEOS_SERVER_DB_CREDENTIAL_FILE SIMPLEOS_SERVER_DB_CERTIFICATE_FILE SIMPLEOS_SERVER_DB_PRIVATE_KEY_FILE
export SIMPLEOS_SERVER_DB_CREDENTIAL_MANIFEST_FILE
export SIMPLEOS_SERVER_CREDENTIAL_STAGING_RECEIPT
export SIMPLEOS_BROWSER_DEMO_BINARY
export SIMPLEOS_FONT_ASSET_NSANSSC SIMPLEOS_FONT_ASSET_NSANSDEV SIMPLEOS_FONT_ASSET_NSANSARB
export SIMPLEOS_FONT_ASSET_NSANSBEN SIMPLEOS_FONT_ASSET_NSERIFSC SIMPLEOS_FONT_ASSET_NSERFDEV
export SIMPLEOS_FONT_ASSET_NNASKHAR SIMPLEOS_FONT_ASSET_NSERFBEN SIMPLEOS_FONT_ASSET_NOTOSANS
export SIMPLEOS_FONT_ASSET_BUNGEE SIMPLEOS_FONT_ASSET_NUNITO SIMPLEOS_FONT_ASSET_CAVEAT
export SIMPLEOS_FONT_ASSET_ROBOSLAB SIMPLEOS_FONT_ASSET_UNIFRAKT SIMPLEOS_FONT_ASSET_PIXELIFY
export SIMPLEOS_FONT_ASSET_NOTOEMOJ

"$BIN" "$image_path" "$platform" "$size_bits" "$kernel_path" "$profile"
if [ -n "$SIMPLEOS_SERVERS_BINARY" ]; then
    if [ "${SIMPLEOS_SERVER_CREDENTIAL_STAGING_TESTING:-0}:${SIMPLEOS_SERVER_CREDENTIAL_STAGING_TEST_FAIL:-}" = "1:receipt" ]; then
        echo "forced SimpleOS server credential staging receipt failure" >&2
        exit 1
    fi
    [ "$(sha256_file "$SIMPLEOS_SERVER_DB_CREDENTIAL_FILE")" = "$SERVER_CREDENTIAL_SHA256" ] &&
    [ "$(sha256_file "$SIMPLEOS_SERVER_DB_CERTIFICATE_FILE")" = "$SERVER_CERTIFICATE_SHA256" ] &&
    [ "$(sha256_file "$SIMPLEOS_SERVER_DB_PRIVATE_KEY_FILE")" = "$SERVER_PRIVATE_KEY_SHA256" ] || {
        rm -f "$image_path"
        echo "SimpleOS server credential snapshot changed during image construction" >&2
        exit 1
    }
    [ "$(stamp_value schema "$SIMPLEOS_SERVER_CREDENTIAL_STAGING_RECEIPT")" = \
        simpleos-server-credential-staging-v1 ] || {
        rm -f "$image_path"; echo "invalid SimpleOS server credential staging receipt" >&2; exit 1; }
    for binding in \
        "credential:$SIMPLEOS_SERVER_DB_CREDENTIAL_FILE" \
        "certificate:$SIMPLEOS_SERVER_DB_CERTIFICATE_FILE" \
        "private_key:$SIMPLEOS_SERVER_DB_PRIVATE_KEY_FILE" \
        "manifest:$SIMPLEOS_SERVER_DB_CREDENTIAL_MANIFEST_FILE"
    do
        label=${binding%%:*}
        expected=${binding#*:}
        offset=$(stamp_value "${label}_offset" "$SIMPLEOS_SERVER_CREDENTIAL_STAGING_RECEIPT") || exit 1
        length=$(stamp_value "${label}_length" "$SIMPLEOS_SERVER_CREDENTIAL_STAGING_RECEIPT") || exit 1
        extracted="$SERVER_CREDENTIAL_MANIFEST_DIR/extracted-$label"
        dd if="$image_path" of="$extracted" bs=1 skip="$offset" count="$length" 2>/dev/null
        if [ "${SIMPLEOS_SERVER_CREDENTIAL_STAGING_TESTING:-0}:${SIMPLEOS_SERVER_CREDENTIAL_STAGING_TEST_FAIL:-}" = "1:extract" ]; then
            echo "forced SimpleOS server credential extraction failure" >&2
            exit 1
        fi
        cmp -s "$expected" "$extracted" || {
            rm -f "$image_path"; echo "SimpleOS server $label image-byte verification failed" >&2; exit 1; }
    done
    ln "$SERVER_CREDENTIAL_PENDING_IMAGE" "$SERVER_CREDENTIAL_FINAL_IMAGE" || {
        echo "SimpleOS server image atomic publication failed" >&2; exit 1; }
    SERVER_CREDENTIAL_FINAL_PUBLISHED=true
    if [ -e "$SERVER_CREDENTIAL_PENDING_IMAGE.esp" ]; then
        ln "$SERVER_CREDENTIAL_PENDING_IMAGE.esp" "$SERVER_CREDENTIAL_FINAL_IMAGE.esp" || {
            rm -f "$SERVER_CREDENTIAL_FINAL_IMAGE"
            echo "SimpleOS server ESP atomic publication failed" >&2
            exit 1
        }
    fi
    SERVER_CREDENTIAL_IMAGE_VERIFIED=true
    rm -f "$SERVER_CREDENTIAL_PENDING_IMAGE" "$SERVER_CREDENTIAL_PENDING_IMAGE.esp"
    SERVER_CREDENTIAL_PENDING_IMAGE=""
fi
