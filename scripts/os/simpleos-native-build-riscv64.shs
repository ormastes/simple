#!/bin/sh
# Cross-build the Simple toolchain binary for riscv64-unknown-simpleos with the
# pure-Simple self-hosted compiler by default.
#
# Prereqs (run once):
#   sh scripts/os/simpleos-core-archive.shs --target riscv64-unknown-simpleos --backend cranelift
#   sh scripts/os/simpleos-sysroot-riscv64.shs
#
# The riscv64 sysroot is separate (build/os/sysroot-riscv64) so the x86_64
# sysroot is never clobbered. crt0 is injected via INPUT() in the linker
# script; libc + the pure-Simple core runtime ride the compiler-builtins link
# slot through the CC wrapper (cc-riscv64-simpleos -print-libgcc-file-name),
# because the seed's simpleos_user_runtime_paths() is x86_64-gated.
set -eu

REPO_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$REPO_ROOT"

TARGET="riscv64-unknown-simpleos"
ENTRY="src/app/simpleos_tool/main.spl"
OUTPUT="bin/release/$TARGET/simple"
SYSROOT="$REPO_ROOT/build/os/sysroot-riscv64"
BACKEND="${SIMPLE_NATIVE_BACKEND:-cranelift}"

# ---- find compiler ----------------------------------------------------------
# Mirrors the hardened x86_64 lane in scripts/os/simpleos-native-build.shs
# (commit ea995e86810). The previous default here was a bare
# `${SIMPLE_BUILD_COMPILER:-bin/release/simple}` with no seed check and no
# capability check, which was fail-open three ways:
#
#   1. bin/release/simple currently resolves to a Rust bootstrap SEED copy, so
#      the default silently produced a seed-built payload — and BOTH install
#      image provenance guards (_validate_simple_binary in
#      src/os/installer/image_builder.spl, validate_simple_payload_provenance in
#      scripts/os/make_os_disk.shs) REJECT a compiler value matching
#      *compiler_rust* / *simple_seed*, so the artifact could never ship.
#   2. A discovery glob over bin/release/*/simple can match the SimpleOS PAYLOAD
#      being built here — a cross-target ELF that fails to exec with rc=126 and
#      no output — letting the thing under construction be picked as its own
#      builder.
#   3. `--help` alone is not a capability probe: the stale SEGV-ing compiler at
#      release/x86_64-unknown-linux-gnu/simple exits 0 on `--help` because it
#      returns before any environment write, then dies rc=139 on real work
#      (defect D1, deployed_selfhost_env_set_miscompile_segv_2026-07-14.md).
#
# So selection is a POSITIVE capability search: iterate candidates, skip the
# seed and skip anything that cannot demonstrate `native-build --target
# riscv64-unknown-simpleos` support AND survive a command that actually writes
# the environment. An explicit SIMPLE_BUILD_COMPILER is still honoured (the D1
# route-around is deliberate and documented) but is labelled loudly.
# Capability probe, rewritten 2026-08-31.  The previous body matched the FULL
# CLI's `native-build --help` banner ("Simple Native Build") and its flag list
# ("--runtime-bundle"), then ran `check`.  That is a category error for the
# artifact this lane is actually supposed to use: the only compiler on this
# host carrying a canonical Stage-2 admission receipt (bootstrap-from-scratch's
# stage2-admitted/simple) is the BOOTSTRAP CLI (src/app/cli/bootstrap_main.spl),
# which by design exposes only `compile` and `native-build`.  It prints a
# different banner, has no `check` command, and omits several supported flags
# from its help text — yet native_build_flag_needs_value() accepts every flag
# this lane passes (--runtime-bundle, --target, --linker-script,
# --entry-closure), and it does in fact produce a correct riscv64 SimpleOS ELF.
# So the old probe rejected the one admitted compiler for cosmetic reasons and
# left the lane with no candidate at all.
#
# Worse, the `check` half was VACUOUS for exactly that binary: `check` exits 1
# with "unknown command" long before any rt_env_set, so it passed the >=128
# test without ever exercising the D1 environment-write path.
#
# The replacement is a strictly stronger, positive demonstration: actually
# cross-build a hello world to $TARGET and require a RISC-V ELF64 out the far
# end.  That exercises parse, HIR, codegen, the environment writes, the
# runtime-bundle slot, the linker script and the CC wrapper in one shot, and it
# cannot be satisfied by help text.  Seed rejection (is_bootstrap_seed) and
# admission-receipt verification (provision_simpleos_guest_simple_fs.shs
# --validate-builder) are unchanged and still run separately.
compiler_can_build_target() {
  probe_bin="$1"
  probe_dir="$(mktemp -d "${TMPDIR:-/tmp}/simpleos-rv64-capability.XXXXXX")" || return 1
  printf 'fn main():\n    print("ok")\n' > "$probe_dir/probe.spl"
  env_rc=0
  CC="$SYSROOT/lib/cc-riscv64-simpleos" \
  SIMPLEOS_SYSROOT="$SYSROOT" \
  SIMPLE_SIMPLE_CORE_PATH="build/os/simple-core-simpleos-riscv64" \
  SIMPLE_BOOTSTRAP=1 SIMPLE_NO_STUB_FALLBACK=1 \
  timeout 600 "$probe_bin" native-build \
    --source "$probe_dir" \
    --backend "$BACKEND" \
    --runtime-bundle simple-core \
    --entry-closure \
    --entry "$probe_dir/probe.spl" \
    --target "$TARGET" \
    --linker-script "$SYSROOT/share/simpleos/simpleos.ld" \
    -o "$probe_dir/probe.elf" >"$probe_dir/probe.log" 2>&1 || env_rc=$?
  if [ "$env_rc" -ge 128 ]; then
    echo "  (candidate died with signal rc=$env_rc on the $TARGET capability build)" >&2
    rm -rf "$probe_dir"
    return 1
  fi
  if [ "$env_rc" -ne 0 ] || [ ! -f "$probe_dir/probe.elf" ]; then
    echo "  (candidate could not cross-build $TARGET: rc=$env_rc)" >&2
    rm -rf "$probe_dir"
    return 1
  fi
  # Machine 243 == EM_RISCV, read the same way the provision script reads it.
  probe_machine="$(od -An -tu1 -j 18 -N 2 "$probe_dir/probe.elf" 2>/dev/null | awk '{print $1 + 256 * $2}')"
  rm -rf "$probe_dir"
  [ "$probe_machine" = "243" ] || {
    echo "  (candidate produced a non-RISC-V payload: e_machine=$probe_machine)" >&2
    return 1
  }
  return 0
}

is_bootstrap_seed() {
  case "$(timeout 60 "$1" --version 2>&1 || true)" in
    *"bootstrap seed only"*) return 0 ;;
    *) return 1 ;;
  esac
}

# The capability probe below performs a REAL cross-build, so the two documented
# prerequisites must exist before compiler selection, not only after it.
[ -f "$SYSROOT/share/simpleos/simpleos.ld" ] || { echo "error: run simpleos-sysroot-riscv64.shs first" >&2; exit 1; }
[ -f "build/os/simple-core-simpleos-riscv64/libsimple_runtime.a" ] || { echo "error: run simpleos-core-archive.shs first" >&2; exit 1; }

COMPILER="${SIMPLE_BUILD_COMPILER:-}"
COMPILER_IS_SEED=0
if [ -z "$COMPILER" ]; then
  for candidate in \
    build/bootstrap/stage3/*/simple \
    build/bootstrap/stage2/*/simple \
    release/*/simple \
    bin/release/*/simple
  do
    [ -x "$candidate" ] || continue
    if is_bootstrap_seed "$candidate"; then
      echo "skipping Rust bootstrap seed: $candidate" >&2
      continue
    fi
    if ! compiler_can_build_target "$candidate"; then
      echo "skipping compiler that failed the native-build capability probe: $candidate" >&2
      continue
    fi
    COMPILER="$candidate"
    break
  done
  if [ -z "$COMPILER" ]; then
    echo "error: no self-hosted Simple compiler passed the native-build capability probe" >&2
    echo "hint: run the bootstrap, or set SIMPLE_BUILD_COMPILER explicitly" >&2
    exit 1
  fi
else
  [ -x "$COMPILER" ] || { echo "error: SIMPLE_BUILD_COMPILER is not executable: $COMPILER" >&2; exit 1; }
  if is_bootstrap_seed "$COMPILER"; then
    COMPILER_IS_SEED=1
    echo "warning: building with the Rust bootstrap seed (explicitly selected): $COMPILER" >&2
    echo "warning: the resulting payload is STAGING evidence only and will FAIL both install-image provenance guards" >&2
  fi
  if ! compiler_can_build_target "$COMPILER"; then
    echo "error: SIMPLE_BUILD_COMPILER failed the native-build --target capability probe: $COMPILER" >&2
    exit 1
  fi
fi
echo "Compiler: $COMPILER"
COMPILER="$(realpath "$COMPILER")"
BUILDER_ADMISSION_RECEIPT="${SIMPLE_BUILD_COMPILER_ADMISSION_RECEIPT:-$(dirname -- "$COMPILER")/admission.env}"
sh scripts/os/provision_simpleos_guest_simple_fs.shs --validate-builder \
  "$COMPILER" "$BUILDER_ADMISSION_RECEIPT" >/dev/null || {
  echo "error: selected compiler lacks canonical Stage2 admission authority" >&2
  exit 1
}
receipt_value() { awk -F= -v key="$1" '$1 == key { n++; v=substr($0,length(key)+2) } END { if (n == 1) print v; else exit 1 }' "$BUILDER_ADMISSION_RECEIPT"; }

[ -f "$SYSROOT/share/simpleos/simpleos.ld" ] || { echo "error: run simpleos-sysroot-riscv64.shs first" >&2; exit 1; }
[ -f "build/os/simple-core-simpleos-riscv64/libsimple_runtime.a" ] || { echo "error: run simpleos-core-archive.shs first" >&2; exit 1; }

mkdir -p "$(dirname "$OUTPUT")"

CC="$SYSROOT/lib/cc-riscv64-simpleos" \
SIMPLEOS_SYSROOT="$SYSROOT" \
SIMPLE_SIMPLE_CORE_PATH="build/os/simple-core-simpleos-riscv64" \
SIMPLE_BOOTSTRAP=1 SIMPLE_NO_STUB_FALLBACK=1 \
"$COMPILER" native-build \
  --source src/compiler --source src/lib --source src/app \
  --backend "$BACKEND" \
  --runtime-bundle simple-core \
  --entry-closure \
  --entry "$ENTRY" \
  --target "$TARGET" \
  --linker-script "$SYSROOT/share/simpleos/simpleos.ld" \
  -o "$OUTPUT"

[ -f "$OUTPUT" ] || { echo "FAILED: no output $OUTPUT" >&2; exit 1; }
FILE_INFO="$(file "$OUTPUT")"
case "$FILE_INFO" in
  *"ELF 64-bit"*RISC-V*"statically linked"*) ;;
  *) echo "FAILED: expected a static RISC-V ELF: $FILE_INFO" >&2; exit 1 ;;
esac
command -v readelf >/dev/null 2>&1 || { echo "FAILED: readelf is required" >&2; exit 1; }
readelf -h "$OUTPUT" | grep -Eq 'Class:[[:space:]]+ELF64' || {
  echo "FAILED: ELF header is not 64-bit" >&2
  exit 1
}
readelf -h "$OUTPUT" | grep -Eq 'Machine:[[:space:]]+RISC-V' || {
  echo "FAILED: ELF header is not RISC-V" >&2
  exit 1
}
printf '%s\n' "$FILE_INFO"

cat > "$OUTPUT.build_stamp" <<EOF
target=$TARGET
entry=$ENTRY
entry_closure=true
backend=$BACKEND
runtime_bundle=simple-core
runtime_archive=build/os/simple-core-simpleos-riscv64/libsimple_runtime.a (14 parts, cranelift --emit-archive --no-mangle)
linker_script=$SYSROOT/share/simpleos/simpleos.ld (base 0x100000000)
compiler=$COMPILER
compiler_is_bootstrap_seed=$COMPILER_IS_SEED
compiler_sha256=$(sha256sum "$COMPILER" | awk '{print $1}')
builder_sha256=$(sha256sum "$COMPILER" | awk '{print $1}')
builder_admission_receipt=$BUILDER_ADMISSION_RECEIPT
builder_admission_receipt_sha256=$(sha256sum "$BUILDER_ADMISSION_RECEIPT" | awk '{print $1}')
builder_admission_identity=$(receipt_value admission_identity)
source_revision_sha256=$(receipt_value source_snapshot_sha256)
artifact_sha256=$(sha256sum "$OUTPUT" | awk '{print $1}')
built=$(date -u +%Y-%m-%dT%H:%M:%SZ)
size=$(wc -c < "$OUTPUT")
EOF
echo "SUCCESS: $OUTPUT"
