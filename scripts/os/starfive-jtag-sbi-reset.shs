#!/usr/bin/env sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
. "$ROOT_DIR/scripts/os/lib/starfive-jtag-tap-gate.shs"
OUTPUT="${STARFIVE_OPENOCD_RESET_LOG:-$ROOT_DIR/build/test-artifacts/starfive-jh7110/openocd-sbi-reset.log}"
SCRATCH=0x48000000
JTAG_KHZ="${STARFIVE_JTAG_KHZ:-100}"
case "$JTAG_KHZ" in ''|*[!0-9]*) echo "error: invalid JTAG clock" >&2; exit 1;; esac
test "$JTAG_KHZ" -ge 1 -a "$JTAG_KHZ" -le 1000 || { echo "error: JTAG clock out of range" >&2; exit 1; }

DETECT="$($ROOT_DIR/scripts/os/starfive-tigard-detect.shs)" || { printf '%s\n' "$DETECT"; exit 2; }
JTAG_PATH="$(printf '%s\n' "$DETECT" | awk -F= '/^tigard_jtag_path=/ {print $2}')"
JTAG_TTY="$(basename "$JTAG_PATH")"
JTAG_SYS_DEVICE="$(readlink -f "/sys/class/tty/$JTAG_TTY/device")"
USB_IFACE="$(basename "$(dirname "$JTAG_SYS_DEVICE")")"
test "$(id -u)" -eq 0 || { echo "starfive_status=blocked"; echo "starfive_reason=jtag-driver-release-needs-root"; exit 2; }

mkdir -p "$(dirname "$OUTPUT")"
WAS_BOUND=0
test -L "/sys/bus/usb/devices/$USB_IFACE/driver" && WAS_BOUND=1
restore_driver() {
    if test "$WAS_BOUND" -eq 1 && ! test -L "/sys/bus/usb/devices/$USB_IFACE/driver"; then
        printf '%s' "$USB_IFACE" | tee /sys/bus/usb/drivers/ftdi_sio/bind >/dev/null 2>&1 || true
    fi
}
trap restore_driver EXIT HUP INT TERM
if test "$WAS_BOUND" -eq 1; then
    printf '%s' "$USB_IFACE" | tee /sys/bus/usb/drivers/ftdi_sio/unbind >/dev/null
fi

PREFLIGHT="$OUTPUT.tap-preflight"
if ! starfive_jtag_tap_preflight "$ROOT_DIR" "$PREFLIGHT" "$JTAG_KHZ"; then
    echo "starfive_status=blocked"
    echo "starfive_reason=jtag-tap-identity-not-admitted"
    echo "jtag_expected_tap=0x07110cfd"
    echo "jtag_mutating_commands=0"
    echo "openocd_log=$PREFLIGHT"
    exit 2
fi
echo "jtag_preflight_status=pass" > "$OUTPUT"
echo "jtag_preflight_tap=0x07110cfd" >> "$OUTPUT"

# SBI SRST: EID 0x53525354, FID 0, reset_type 1 (cold reboot), reason 0.
# The reviewed scratch contains only: ecall; wfi; jump-to-wfi.  Hart 2 is a
# parked OpenSBI secondary hart and remains examinable when boot hart 1 rejects
# halt requests.  Resume it in supervisor mode so the ecall uses the SBI ABI.
set +e
timeout 20 openocd \
    -f interface/ftdi/tigard.cfg \
    -c 'ftdi device_desc {port A:Serial  port B:JTAG}' \
    -f "$ROOT_DIR/scripts/os/openocd-starfive-jh7110-target.cfg" \
    -c "adapter speed $JTAG_KHZ" \
    -c init -c 'targets jh7110.u74_hart2' -c halt \
    -c "mww $SCRATCH 0x00000073" \
    -c "mww 0x48000004 0x10500073" \
    -c "mww 0x48000008 0xffdff06f" \
    -c 'reg a7 0x53525354' -c 'reg a6 0' -c 'reg a0 1' -c 'reg a1 0' \
    -c "reg pc $SCRATCH" -c 'reg priv 1' -c resume -c shutdown >> "$OUTPUT" 2>&1
RC=$?
set -e
test "$RC" -eq 0 || {
    echo "starfive_status=blocked"
    echo "starfive_reason=jtag-sbi-reset-hart2-unavailable"
    echo "jtag_software_reset_method=sbi-srst-hart2-unverified"
    echo "jtag_flash_writes=0"
    echo "openocd_log=$OUTPUT"
    exit 2
}

# Reattach through an independent session.  A PC back in the JH7110 OpenSBI
# firmware window and machine privilege proves that execution left the scratch
# trampoline and the firmware reset path restarted.  UART remains the stronger
# end-to-end boot oracle and is collected by the live checker.
sleep 1
set +e
timeout 20 openocd \
    -f interface/ftdi/tigard.cfg \
    -c 'ftdi device_desc {port A:Serial  port B:JTAG}' \
    -f "$ROOT_DIR/scripts/os/openocd-starfive-jh7110-target.cfg" \
    -c "adapter speed $JTAG_KHZ" \
    -c init -c 'targets jh7110.u74_hart2' -c halt \
    -c 'reg pc' -c 'reg priv' -c resume -c shutdown >> "$OUTPUT" 2>&1
VERIFY_RC=$?
set -e
test "$VERIFY_RC" -eq 0 \
    && grep -Eq 'pc \(/64\): 0x0000000040[0-9a-fA-F]{6}' "$OUTPUT" \
    && grep -Eq 'priv \(/8\): 0x03' "$OUTPUT" || {
        echo "starfive_status=blocked"
        echo "starfive_reason=jtag-sbi-reset-firmware-reentry-unverified"
        echo "jtag_software_reset_method=sbi-srst-hart2-unverified"
        echo "jtag_flash_writes=0"
        echo "openocd_log=$OUTPUT"
        exit 2
    }

echo "jtag_sbi_reset_status=verified"
echo "jtag_sbi_reset_type=cold-reboot"
echo "jtag_software_reset_method=sbi-srst-hart2"
echo "jtag_reset_hart=2"
echo "jtag_clock_khz=$JTAG_KHZ"
echo "jtag_reset_oracle=opensbi-machine-mode-reentry"
echo "jtag_flash_writes=0"
echo "openocd_log=$OUTPUT"
