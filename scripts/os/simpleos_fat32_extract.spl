# FAT32 file extractor for SimpleOS disk images.
#
# Companion to simpleos_fat32_image_list.spl. That script only LISTS entries
# (and only to depth 1), so evidence gates that must prove a payload is really
# staged had to shell out to mtools `mcopy`. mtools is not present on every
# host, and when it is missing the gate can only report "mcopy-unavailable" --
# it cannot tell an unstaged payload from an untestable one. This reader
# removes that host dependency by walking the FAT32 structures directly.
#
# Usage:
#   simple run scripts/os/simpleos_fat32_extract.spl <image> <path> <out>
#     <path> is an absolute short-name path, e.g. /SYS/APPS/BROWSMF.SMF
#
# Prints `extract_status=<status>` as its LAST line. `pass` also prints
# `extract_bytes=<n>`. Exit code is 0 only on `pass`.

extern fn rt_file_read_bytes(path: text) -> [u8]?
extern fn rt_file_write_bytes(path: text, data: [u8]) -> bool
extern fn sys_get_args() -> [text]

fn byte_at(data: [u8], idx: i64) -> i64:
    if idx < 0 or idx >= data.len():
        return 0
    return data[idx] as i64

fn le16(data: [u8], off: i64) -> i64:
    return byte_at(data, off) | (byte_at(data, off + 1) << 8)

fn le32(data: [u8], off: i64) -> i64:
    return byte_at(data, off) |
        (byte_at(data, off + 1) << 8) |
        (byte_at(data, off + 2) << 16) |
        (byte_at(data, off + 3) << 24)

fn ascii_char(code: i64) -> text:
    val chars = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    val idx = code - 32
    if idx >= 0 and idx < chars.len():
        return chars[idx:idx + 1]
    return "?"

fn short_name(data: [u8], off: i64) -> text:
    var name = ""
    var i = 0
    while i < 8:
        val c = byte_at(data, off + i)
        if c != 32:
            name = name + ascii_char(c)
        i = i + 1

    var ext = ""
    i = 8
    while i < 11:
        val c = byte_at(data, off + i)
        if c != 32:
            ext = ext + ascii_char(c)
        i = i + 1

    if ext.len() > 0:
        return name + "." + ext
    return name

# Next cluster in the chain, or 0 when the chain ends / is corrupt.
fn next_cluster(data: [u8], fat_start: i64, cluster: i64) -> i64:
    val entry = le32(data, fat_start + (cluster * 4)) & 0x0FFFFFFF
    if entry < 2 or entry >= 0x0FFFFFF8:
        return 0
    return entry

# Look up one component inside a directory chain.
# Returns cluster * 8 + flags, where flags bit0 = found, bit1 = is_dir.
# Size is returned via a second call to dir_lookup_size to keep the return
# type a plain integer (no tuple lowering needed in a freestanding-adjacent
# script).
fn dir_lookup(data: [u8], fat_start: i64, data_start: i64, cluster_size: i64,
              dir_cluster: i64, want: text, want_size: bool) -> i64:
    var cluster = dir_cluster
    var guard = 0
    while cluster >= 2 and guard < 65536:
        guard = guard + 1
        val dir_off = data_start + ((cluster - 2) * cluster_size)
        var pos = 0
        while pos < cluster_size:
            val entry = dir_off + pos
            val first = byte_at(data, entry)
            if first == 0:
                return -1
            val attr = byte_at(data, entry + 11)
            if first != 229 and attr != 15:
                if short_name(data, entry) == want:
                    if want_size:
                        return le32(data, entry + 28)
                    val high = le16(data, entry + 20)
                    val low = le16(data, entry + 26)
                    val child = (high << 16) | low
                    val is_dir = if (attr & 16) != 0: 2 else: 0
                    return (child * 8) + 1 + is_dir
            pos = pos + 32
        cluster = next_cluster(data, fat_start, cluster)
    return -1

fn split_path(path: text) -> [text]:
    var parts: [text] = []
    var current = ""
    var i = 0
    while i < path.len():
        val ch = path[i:i + 1]
        if ch == "/":
            if current.len() > 0:
                parts.push(current)
                current = ""
        else:
            current = current + ch
        i = i + 1
    if current.len() > 0:
        parts.push(current)
    return parts

fn extract(image: text, want_path: text, out_path: text) -> i32:
    val data = rt_file_read_bytes(image) ?? []
    if data.len() < 512:
        print "extract_status=image-unreadable"
        return 1

    val bytes_per_sector = le16(data, 11)
    val sectors_per_cluster = byte_at(data, 13)
    val reserved_sectors = le16(data, 14)
    val fat_count = byte_at(data, 16)
    val sectors_per_fat = le32(data, 36)
    val root_cluster = le32(data, 44)
    if bytes_per_sector <= 0 or sectors_per_cluster <= 0 or fat_count <= 0:
        print "extract_status=image-not-fat32"
        return 1
    val cluster_size = bytes_per_sector * sectors_per_cluster
    val fat_start = reserved_sectors * bytes_per_sector
    val data_start = (reserved_sectors + (fat_count * sectors_per_fat)) * bytes_per_sector

    val parts = split_path(want_path)
    if parts.len() == 0:
        print "extract_status=path-empty"
        return 1

    var cluster = root_cluster
    var idx = 0
    var file_size = 0
    while idx < parts.len():
        val want = parts[idx]
        val last = idx == parts.len() - 1
        val found = dir_lookup(data, fat_start, data_start, cluster_size, cluster, want, false)
        if found < 0:
            print "extract_status=entry-missing:{want}"
            return 1
        val is_dir = (found & 2) != 0
        if last:
            if is_dir:
                print "extract_status=entry-is-directory:{want}"
                return 1
            file_size = dir_lookup(data, fat_start, data_start, cluster_size, cluster, want, true)
        else:
            if not is_dir:
                print "extract_status=entry-not-directory:{want}"
                return 1
        cluster = found / 8
        idx = idx + 1

    if file_size <= 0:
        print "extract_status=entry-empty"
        return 1

    var out: [u8] = []
    var remaining = file_size
    var guard = 0
    while cluster >= 2 and remaining > 0 and guard < 1048576:
        guard = guard + 1
        val off = data_start + ((cluster - 2) * cluster_size)
        var take = cluster_size
        if take > remaining:
            take = remaining
        if off + take > data.len():
            print "extract_status=cluster-out-of-range"
            return 1
        var i = 0
        while i < take:
            out.push(data[off + i])
            i = i + 1
        remaining = remaining - take
        cluster = next_cluster(data, fat_start, cluster)

    if remaining > 0:
        print "extract_status=chain-truncated"
        return 1
    if not rt_file_write_bytes(out_path, out):
        print "extract_status=write-failed"
        return 1
    val n = out.len()
    print "extract_bytes={n}"
    print "extract_status=pass"
    return 0

fn main() -> i32:
    val args = sys_get_args()
    var positional: [text] = []
    for arg in args:
        if arg != "--":
            positional.push(arg)
    # sys_get_args() also yields the interpreter's own script path, so take the
    # LAST three positionals (same last-wins convention as
    # simpleos_fat32_image_list.spl).
    val n = positional.len()
    if n < 3:
        print "extract_status=usage:<image> <path> <out>"
        return 2
    return extract(positional[n - 3], positional[n - 2], positional[n - 1])
