#!/bin/sh
# Build the RV64 S-mode kernel used by the filesystem-backed PID1 QEMU lane.
#
# This is intentionally distinct from simpleos-native-build-riscv64.shs:
# that wrapper produces ring-3 SimpleOS payload ELFs for riscv64-unknown-
# simpleos, while this wrapper produces the OpenSBI-loaded kernel for
# riscv64-unknown-none.  Its entry is the real boot.spl path that calls
# os_main_prepare_pid1.
set -eu

REPO_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$REPO_ROOT"

TARGET="riscv64-unknown-none"
ENTRY="src/os/kernel/arch/riscv64/boot.spl"
OUTPUT="build/os/simpleos_riscv64.elf"
BACKEND="${SIMPLE_KERNEL_NATIVE_BACKEND:-cranelift}"
KERNEL_BOOT_START='src__os__kernel__arch__riscv64__boot__spl_start'

usage() {
    echo "Usage: SIMPLE_BUILD_COMPILER=<fresh-stage2> sh scripts/os/build_pid1_kernel_riscv64.shs [--output <path>] [--backend <llvm|cranelift>]" >&2
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --output) shift; [ "$#" -gt 0 ] || { usage; exit 2; }; OUTPUT="$1" ;;
        --output=*) OUTPUT="${1#*=}" ;;
        --backend) shift; [ "$#" -gt 0 ] || { usage; exit 2; }; BACKEND="$1" ;;
        --backend=*) BACKEND="${1#*=}" ;;
        --help|-h) usage; exit 0 ;;
        *) echo "error: unknown argument: $1" >&2; usage; exit 2 ;;
    esac
    shift
done

case "$BACKEND" in llvm|cranelift) ;; *) echo "error: unsupported RV64 kernel backend: $BACKEND" >&2; exit 2 ;; esac

COMPILER="${SIMPLE_BUILD_COMPILER:-}"
[ -n "$COMPILER" ] || {
    echo "error: SIMPLE_BUILD_COMPILER must name the admitted fresh Stage2 compiler" >&2
    exit 1
}
[ -x "$COMPILER" ] || { echo "error: SIMPLE_BUILD_COMPILER is not executable: $COMPILER" >&2; exit 1; }

probe_out="$(timeout 120 "$COMPILER" native-build --target "$TARGET" --help 2>&1)" \
    && probe_rc=0 || probe_rc=$?
[ "$probe_rc" -eq 0 ] &&
    printf '%s' "$probe_out" | grep -Fq 'Simple Native Build' &&
    printf '%s' "$probe_out" | grep -Fq -- '--target' &&
    printf '%s' "$probe_out" | grep -Fq -- '--linker-script' || {
    echo "error: SIMPLE_BUILD_COMPILER failed the native-build --target capability probe: $COMPILER" >&2
    exit 1
}
[ -d build/os/generated ] || { echo "error: generated kernel sources missing: build/os/generated" >&2; exit 1; }
[ -f src/os/kernel/arch/riscv64/linker.ld ] || { echo "error: RV64 kernel linker script missing" >&2; exit 1; }

mkdir -p "$(dirname "$OUTPUT")"

# The generated source root keeps the boot module's `_start` call aligned with
# the native compiler's full-kernel module path (`src.os...`).  SIMPLE_BOOT_MINIMAL
# causes the architecture linker to compile only the real baremetal runtime
# providers required by this kernel, rather than a smoke-entry surrogate.
SIMPLE_BOOTSTRAP=1 SIMPLE_BOOT_MINIMAL=1 SIMPLE_NO_STUB_FALLBACK=1 \
"$COMPILER" native-build \
    --source build/os/generated --source src/os --source src/lib \
    --backend "$BACKEND" \
    --entry-closure \
    --entry "$ENTRY" \
    --target "$TARGET" \
    --linker-script src/os/kernel/arch/riscv64/linker.ld \
    -o "$OUTPUT"

[ -s "$OUTPUT" ] || { echo "error: RV64 PID1 kernel output missing: $OUTPUT" >&2; exit 1; }
command -v readelf >/dev/null 2>&1 || { echo "error: readelf is required" >&2; exit 1; }
readelf -h "$OUTPUT" | grep -Eq 'Class:[[:space:]]+ELF64' || { echo "error: RV64 kernel is not ELF64: $OUTPUT" >&2; exit 1; }
readelf -h "$OUTPUT" | grep -Eq 'Machine:[[:space:]]+RISC-V' || { echo "error: RV64 kernel has wrong ELF machine: $OUTPUT" >&2; exit 1; }
command -v nm >/dev/null 2>&1 || { echo "error: nm is required" >&2; exit 1; }
nm -g "$OUTPUT" | grep -Fq 'os_main_prepare_pid1' || { echo "error: RV64 kernel lacks PID1 boot path: $OUTPUT" >&2; exit 1; }

# `ENTRY(_start)` in the linker script alone is insufficient: an entry-closure
# can also contain the generic no-allocation RISC-V startup module.  The native
# linker must alias `_start` to the entry module selected above, never merely to
# the first reachable symbol ending in `___start`.  Validate the emitted ELF
# rather than accepting a marker or symbol-presence surrogate.
ELF_ENTRY_HEX="$(readelf -h "$OUTPUT" | awk '/Entry point address:/ { print $4; exit }')"
BOOT_START_HEX="$(nm -n "$OUTPUT" | awk -v symbol="$KERNEL_BOOT_START" '$NF == symbol { print "0x" $1; exit }')"
[ -n "$ELF_ENTRY_HEX" ] || { echo "error: cannot read RV64 ELF entry address: $OUTPUT" >&2; exit 1; }
[ -n "$BOOT_START_HEX" ] || { echo "error: RV64 kernel lacks canonical boot entry $KERNEL_BOOT_START: $OUTPUT" >&2; exit 1; }
[ "$((ELF_ENTRY_HEX))" -eq "$((BOOT_START_HEX))" ] || {
    echo "error: RV64 ELF entry $ELF_ENTRY_HEX is not canonical kernel boot $KERNEL_BOOT_START at $BOOT_START_HEX" >&2
    exit 1
}

cat > "$OUTPUT.build_stamp" <<EOF
target=$TARGET
entry=$ENTRY
entry_closure=true
backend=$BACKEND
source_roots=build/os/generated,src/os,src/lib
linker_script=src/os/kernel/arch/riscv64/linker.ld
elf_entry=$ELF_ENTRY_HEX
kernel_boot_entry=$KERNEL_BOOT_START
compiler=$COMPILER
compiler_sha256=$(sha256sum "$COMPILER" | awk '{print $1}')
artifact_sha256=$(sha256sum "$OUTPUT" | awk '{print $1}')
built=$(date -u +%Y-%m-%dT%H:%M:%SZ)
size=$(wc -c < "$OUTPUT")
EOF

echo "SUCCESS: RV64 PID1 kernel ready: $OUTPUT"
