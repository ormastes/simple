#!/bin/sh
# Build the current-source Pure-Simple HTTP/database process for ARM64 SimpleOS.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

TARGET="aarch64-unknown-simpleos"
ENTRY="src/os/apps/servers_user/main.spl"
OUT_DIR="build/os/arm64_servers"
OUT="$OUT_DIR/servers.elf"
SYSROOT="${SIMPLEOS_SYSROOT_AARCH64:-build/os/sysroot-aarch64}"
TARGET_RUNTIME="build/os/simple-core-simpleos-aarch64/libsimple_runtime.a"
BACKEND="${SIMPLE_NATIVE_BACKEND:-cranelift}"

. "$ROOT_DIR/scripts/lib/simple-compiler-select.shs"
if [ -n "${SIMPLE_BUILD_COMPILER:-}" ]; then
    COMPILER="$SIMPLE_BUILD_COMPILER"
else
    COMPILER="$(simple_compiler_select --root "$ROOT_DIR" --builder-target "$TARGET")" || {
        echo "error: no current Simple compiler passed the native-build probe" >&2
        exit 1
    }
fi
[ -x "$COMPILER" ] || { echo "error: compiler is not executable: $COMPILER" >&2; exit 1; }

for piece in "$SYSROOT/lib/crt0.o" "$SYSROOT/lib/libsimpleos_all.a" \
             "$SYSROOT/lib/cc-aarch64-simpleos" "$SYSROOT/share/simpleos/simpleos.ld" \
             "$TARGET_RUNTIME"; do
    [ -s "$piece" ] || {
        echo "error: missing ARM64 SimpleOS build prerequisite: $piece" >&2
        echo "hint: build simple-core archive, then run scripts/os/simpleos-sysroot-aarch64.shs" >&2
        exit 1
    }
done

# The generic array owner comes from simple-core/core_array.spl. The ARM kernel
# stubs intentionally expose only their legacy `_text` aliases and are not part
# of this user payload. Refuse a stale runtime archive before the expensive
# native build.
for runtime_symbol in rt_array_data_ptr rt_array_set_len_known; do
    owner_count=$(nm -g --defined-only "$TARGET_RUNTIME" 2>/dev/null |
        awk -v wanted="$runtime_symbol" '$3 == wanted { count++ } END { print count + 0 }')
    [ "$owner_count" -eq 1 ] || {
        echo "error: ARM64 simple-core runtime owner count for $runtime_symbol is $owner_count, expected 1" >&2
        exit 1
    }
done

mkdir -p "$OUT_DIR"
rm -f "$OUT"
CC="$SYSROOT/lib/cc-aarch64-simpleos" \
SIMPLEOS_SYSROOT="$SYSROOT" \
SIMPLE_SIMPLE_CORE_PATH="$TARGET_RUNTIME" \
SIMPLE_BOOTSTRAP=1 SIMPLE_NO_STUB_FALLBACK=1 "$COMPILER" native-build \
    --source src/os --source src/lib \
    --backend "$BACKEND" --runtime-bundle simple-core \
    --entry-closure --entry "$ENTRY" --target "$TARGET" \
    --linker-script "$SYSROOT/share/simpleos/simpleos.ld" \
    -o "$OUT"

header="$(readelf -h "$OUT")"
printf '%s\n' "$header" | grep -Eq 'Class:[[:space:]]+ELF64' || {
    echo "error: server payload is not ELF64" >&2; exit 1; }
printf '%s\n' "$header" | grep -Eq 'Type:[[:space:]]+EXEC' || {
    echo "error: server payload is not ET_EXEC" >&2; exit 1; }
printf '%s\n' "$header" | grep -Eq 'Machine:[[:space:]]+AArch64' || {
    echo "error: server payload is not AArch64" >&2; exit 1; }

undefined_symbols="$(nm -u "$OUT" 2>/dev/null || true)"
printf '%s\n' "$undefined_symbols" | grep -Eq '(bytes_to_string|rt_arm64_syscall|simpleos_syscall|Array[._](enumerate|data_ptr))' && {
    echo "error: server payload retained an unresolved byte-conversion or syscall ABI symbol" >&2
    exit 1
}

# Array.data_ptr()/set_len_known() are compiler intrinsics on this target.  The
# archive preflight above proves their fallback ABI owners are available, but a
# correctly lowered final image has no reference to (and therefore does not
# extract) those owners.  Gate the final image on the credential-zeroization
# facade and its volatile primitives instead.
for runtime_symbol in \
    lib__common__crypto__secure_memory__secure_zero_u8_slots \
    lib__common__crypto__secure_memory__secure_zero_i64_slots \
    lib__common__crypto__sha256__sha256_u8_hex_zeroizing \
    rt_volatile_read_u8 rt_volatile_write_u8 \
    rt_volatile_read_u64 rt_volatile_write_u64 rt_memory_barrier; do
    linked_count=$(nm -g --defined-only "$OUT" 2>/dev/null |
        awk -v wanted="$runtime_symbol" '$3 == wanted { count++ } END { print count + 0 }')
    [ "$linked_count" -eq 1 ] || {
        echo "error: server payload strong owner count for $runtime_symbol is $linked_count, expected 1" >&2
        exit 1
    }
done

printf 'built=%s\nentry=%s\ntarget=%s\ncompiler=%s\n' "$OUT" "$ENTRY" "$TARGET" "$COMPILER"
