#!/usr/bin/env sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"
. "$ROOT_DIR/scripts/lib/simple-compiler-select.shs"

TARGET=x86_64-unknown-none
BOARD_TARGET=x86_64-up-squared-apollo-lake
ENTRY=src/os/kernel/arch/x86_64/up_squared/entry.spl
LINKER=src/os/kernel/arch/x86_64/up_squared/linker.ld
OUTPUT=${UP2_ELF:-build/os/up-squared-apollo-lake/simpleos.elf}
RECEIPT="$OUTPUT.receipt"
BACKEND=${SIMPLE_NATIVE_BACKEND:-cranelift}
CORE_DIR=build/os/up-squared-apollo-lake/simple-core
CORE_RUNTIME="$CORE_DIR/libsimple_runtime.a"
SYSROOT=build/os/sysroot

COMPILER="$(simple_compiler_select --root "$ROOT_DIR" --builder-target "$TARGET")" || {
    echo "error: no admitted self-hosted compiler for $TARGET" >&2
    exit 1
}
simple_compiler_is_seed "$COMPILER" && {
    echo "error: implicit Rust bootstrap seed is forbidden" >&2
    exit 1
}
PROVENANCE="$(dirname "$COMPILER")/provenance.env"
test -f "$PROVENANCE" || { echo "error: missing compiler provenance" >&2; exit 1; }
test "$(awk -F= '/^status=/ {print $2}' "$PROVENANCE")" = pass || {
    echo "error: compiler provenance is not admitted PASS" >&2
    exit 1
}
test "$(awk -F= '/^stage3_sha256=/ {print $2}' "$PROVENANCE")" = "$(sha256sum "$COMPILER" | awk '{print $1}')" || {
    echo "error: compiler hash does not match provenance" >&2
    exit 1
}

mkdir -p "$(dirname "$OUTPUT")" build/os/generated

# Reuse the admitted x86 freestanding runtime capsule.  The board entry is small,
# but text, arrays, Result values, and serial input still require their real
# runtime owners; changing the target triple cannot supply those symbols.
if test ! -s "$SYSROOT/lib/libsimple_runtime_native.a"; then
    SIMPLEOS_TARGET_TRIPLE="$TARGET" sh src/os/port/llvm/sysroot.shs
fi
# Refresh the x86 libc archive through its dependency-aware Makefile on every
# board build. This is cheap when unchanged and ensures CFLAGS/section-policy
# changes cannot leave a stale monolithic libc in the sysroot.
make -C src/os/libc >/dev/null
cp src/os/libc/libsimpleos_c.a "$SYSROOT/lib/libsimpleos_c.a"
cp src/os/libc/libsimpleos_c.a "$SYSROOT/lib/libm.a"
SIMPLE_BINARY="$COMPILER" \
SIMPLE_CORE_BUILD_DIR="$CORE_DIR" \
SIMPLE_CORE_BACKEND="$BACKEND" \
BUILD_DIR="$CORE_DIR/work" \
ARCHIVE_ONLY=1 TARGET="$TARGET" \
    sh scripts/check/check-simple-core-runtime-smoke.shs
test -s "$CORE_RUNTIME" || { echo "error: missing UP2 simple-core archive" >&2; exit 1; }

mkdir -p "$CORE_DIR/runtime-members"
rm -f "$CORE_DIR/runtime-members"/*.o
# The native archive also contains hosted compatibility surfaces. Import only the
# privileged port-I/O primitive needed by this board's early console; pulling
# runtime_native.o or the syscall adapters drags userspace libc/syscalls into
# the ring-0 image.
(cd "$CORE_DIR/runtime-members" && \
    "${AR:-llvm-ar}" x "../../../sysroot/lib/libsimple_runtime_native.a" runtime_port_io.o)
test -s "$CORE_DIR/runtime-members/runtime_port_io.o" || {
    echo "error: missing admitted runtime_port_io.o" >&2
    exit 1
}
"${AR:-llvm-ar}" r "$CORE_RUNTIME" "$CORE_DIR/runtime-members/runtime_port_io.o"
clang --target=x86_64-unknown-none-elf -ffreestanding -nostdlib -fno-builtin \
    -mno-red-zone -fno-stack-protector -ffunction-sections -fdata-sections -O2 \
    -c src/os/kernel/arch/x86_64/up_squared/serial_runtime.c \
    -o "$CORE_DIR/up2_serial_runtime.o"
"${AR:-llvm-ar}" r "$CORE_RUNTIME" "$CORE_DIR/up2_serial_runtime.o"
clang --target=x86_64-unknown-none-elf -ffreestanding -nostdlib -fno-builtin \
    -mno-red-zone -fno-stack-protector -ffunction-sections -fdata-sections -O2 \
    -Wall -Wextra -Werror \
    -c src/os/kernel/arch/x86_64/up_squared/freestanding_runtime.c \
    -o "$CORE_DIR/up2_freestanding_runtime.o"
"${AR:-llvm-ar}" r "$CORE_RUNTIME" "$CORE_DIR/up2_freestanding_runtime.o"
clang --target=x86_64-unknown-none-elf -ffreestanding -nostdlib -fno-builtin \
    -mno-red-zone -fno-stack-protector -ffunction-sections -fdata-sections -O2 \
    -c src/runtime/startup/baremetal/dma.c \
    -o "$CORE_DIR/up2_dma.o"
clang --target=x86_64-unknown-none-elf -ffreestanding -nostdlib -fno-builtin \
    -mno-red-zone -fno-stack-protector -ffunction-sections -fdata-sections -O2 \
    -c src/runtime/startup/baremetal/dma_x86_64.c \
    -o "$CORE_DIR/up2_dma_x86_64.o"
"${AR:-llvm-ar}" r "$CORE_RUNTIME" "$CORE_DIR/up2_dma.o" "$CORE_DIR/up2_dma_x86_64.o"
clang --target=x86_64-unknown-none-elf -ffreestanding -nostdlib \
    -c examples/09_embedded/simple_os/arch/x86_64/boot/crt0.s \
    -o "$CORE_DIR/up2_multiboot_crt0.o"
"${AR:-llvm-ar}" r "$CORE_RUNTIME" "$CORE_DIR/up2_multiboot_crt0.o"
cp "$CORE_RUNTIME" "$SYSROOT/lib/libsimple_runtime.a"

SIMPLE_ARCHIVE="$CORE_DIR/up2_simple_modules.a"
SIMPLE_SIMPLE_CORE_PATH="$CORE_RUNTIME" \
SIMPLE_BOOTSTRAP=1 SIMPLE_NO_STUB_FALLBACK=1 timeout 300 "$COMPILER" native-build \
    --source build/os/generated --source src/os --source src/lib \
    --source examples/09_embedded/simple_os/arch/x86_64 \
    --backend "$BACKEND" --cpu x86-64-v1 --opt-level=aggressive --log off \
    --runtime-bundle simple-core \
    --entry-closure --entry "$ENTRY" --target "$TARGET" --emit-archive \
    -o "$SIMPLE_ARCHIVE"

# `--emit-archive` deliberately stops before either native link personality.
# Link the board-owned Multiboot CRT, compiled Simple closure, and admitted
# freestanding runtime capsule directly. This excludes the generated
# filesystem-process `_start` used by `x86_64-unknown-simpleos` and also avoids
# silently adopting the legacy all-purpose baremetal stub object.
SPL_START="$(nm -g "$SIMPLE_ARCHIVE" | awk '$3 ~ /__up_squared__entry___start$/ {print $3; exit}')"
case "$SPL_START" in
    kernel__arch__x86_64__up_squared__entry___start) ;;
    *) echo "error: missing or unexpected UP2 Simple entry symbol: $SPL_START" >&2; exit 1 ;;
esac
ld.lld -T "$LINKER" -nostdlib -static --gc-sections \
    -z max-page-size=0x1000 -o "$OUTPUT" \
    --undefined="$SPL_START" --defsym="spl_start=$SPL_START" \
    "$CORE_DIR/up2_multiboot_crt0.o" \
    --start-group "$SIMPLE_ARCHIVE" "$CORE_RUNTIME" --end-group

test -s "$OUTPUT"
file "$OUTPUT" | grep -Eq 'ELF 64-bit.*x86-64'
if nm "$OUTPUT" | awk '$3=="simpleos_syscall" {found=1} END {exit !found}'; then
    echo "error: hosted simpleos_syscall trampoline leaked into the ring-0 image" >&2
    exit 1
fi
command -v llvm-objcopy >/dev/null 2>&1 || { echo "error: llvm-objcopy missing" >&2; exit 1; }
command -v nm >/dev/null 2>&1 || { echo "error: nm missing" >&2; exit 1; }
ENTRY_HEX="$(nm -n "$OUTPUT" | awk '$3=="_entry32" {print $1; exit}')"
case "$ENTRY_HEX" in ''|*[!0-9A-Fa-f]*) echo "error: missing or invalid _entry32 symbol" >&2; exit 1 ;; esac
# Normalize the ELF header to the board's real 32-bit Multiboot entry and bind
# the receipt to the exact symbol/address.
llvm-objcopy --set-start="0x$ENTRY_HEX" "$OUTPUT"
ELF_ENTRY="$(readelf -h "$OUTPUT" | awk -F: '/Entry point address/ {gsub(/^[[:space:]]+/, "", $2); print $2; exit}')"
test "$((ELF_ENTRY))" -eq "$((0x$ENTRY_HEX))" || { echo "error: ELF entry normalization failed" >&2; exit 1; }

TMP="$RECEIPT.tmp.$$"
trap 'rm -f "$TMP"' EXIT HUP INT TERM
{
    echo schema=up2-simpleos-receipt-v1
    echo target="$BOARD_TARGET"
    echo firmware=uefi
    echo loader=EFI/BOOT/BOOTX64.EFI
    echo artifact="$OUTPUT"
    echo artifact_size="$(wc -c < "$OUTPUT")"
    echo artifact_sha256="$(sha256sum "$OUTPUT" | awk '{print $1}')"
    echo compiler="$COMPILER"
    echo compiler_sha256="$(sha256sum "$COMPILER" | awk '{print $1}')"
    echo compiler_provenance="$PROVENANCE"
    echo runtime_bundle=simple-core
    echo runtime_execution=freestanding-ring0
    echo hosted_syscall_symbols=0
    echo runtime_archive="$CORE_RUNTIME"
    echo runtime_archive_sha256="$(sha256sum "$CORE_RUNTIME" | awk '{print $1}')"
    echo simple_archive="$SIMPLE_ARCHIVE"
    echo simple_archive_sha256="$(sha256sum "$SIMPLE_ARCHIVE" | awk '{print $1}')"
    echo entry_source="$ENTRY"
    echo entry_source_sha256="$(sha256sum "$ENTRY" | awk '{print $1}')"
    echo simple_entry_symbol="$SPL_START"
    echo entry_symbol=_entry32
    echo elf_entry="$ELF_ENTRY"
    echo elf_entry_normalized=1
    echo linker="$LINKER"
    echo linker_sha256="$(sha256sum "$LINKER" | awk '{print $1}')"
    echo root_entries=bin,etc,README.txt
    echo console_contract=cn16-3v3-ttl-115200-8n1-provider-live-unproven
    echo persistent_writes=none
    echo built_utc="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$TMP"
mv "$TMP" "$RECEIPT"
trap - EXIT HUP INT TERM

echo up2_build_status=pass
echo target="$BOARD_TARGET"
echo artifact="$OUTPUT"
echo receipt="$RECEIPT"
