#!/bin/sh
# build_vfsrt_system_volume.shs — mint the SimpleOS system FAT32 volume that the
# VFS server round-trip gate boots against.
#
# WHY THIS EXISTS. `check-simpleos-vfs-server-roundtrip-ovmf.shs` used to mint a
# bare `mkfs.vfat` volume with nothing on it. That volume can never satisfy
# `vfs_boot_init_production()` (src/os/services/vfs/vfs_boot_state.spl:655+),
# which fails closed unless the volume carries the SYSTEM payloads a production
# SimpleOS boot requires:
#     /SYS/NVFSVER.TXT      version probe (or /VERSION.TXT at the root)
#     /SYS/APPS/BROWSMF.SMF   must exist AND carry ELF magic
#     /SYS/APPS/HELLOSMF.SMF  must exist
#     /SYS/APPS/CLANGSMF.SMF  must exist
# That refusal is CORRECT and must not be relaxed: a production storage stack
# that accepts a blank disk as a booted system is the defect, not the check.
# So the ARTIFACT gives, not the contract — this script stages the payloads.
#
# The gate's honesty never rested on the volume being empty. It rests on the
# PER-RUN NONCE: the gate asserts the freshly minted volume does NOT already
# contain the nonce, and does NOT already contain /VFSRT.TXT, before boot.
#
# HOW. It uses the repo's own FAT32 authoring primitive, `scripts/os/make_os_disk.c`
# — the same writer every SimpleOS disk lane uses, with the same synthesized
# app-slot ELFs. No mtools and no loop mount is needed (neither is available
# unprivileged on the CI host).
#
# DELIBERATE SCOPE NOTE — read before "simplifying" this into a call to
# scripts/os/make_os_disk.shs. That wrapper additionally verifies the Google
# font companion license manifest, and on this branch that verification is RED
# for reasons unrelated to storage: `assets/fonts/google-fonts/ofl/bungee/OFL.txt`
# and `.../pixelifysans/OFL.txt` no longer match their recorded SHA-256. That is
# a real, separately filed defect about SHIPPING media provenance. This gate
# boots a throwaway test volume and makes no shipping claim, so it invokes the
# C writer directly rather than blocking a storage lane on a font-license
# manifest. It does NOT skip any check that bears on the storage round-trip.
#
# Usage: sh scripts/os/build_vfsrt_system_volume.shs <image-path> [size-mib]
set -eu
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"

IMG=${1:?usage: build_vfsrt_system_volume.shs <image-path> [size-mib]}
SIZE_MIB=${2:-512}
SRC=scripts/os/make_os_disk.c
SUPPORT_SRC=scripts/os/make_os_disk_support.inc.c
BIN=build/os/make_os_disk

command -v cc >/dev/null 2>&1 || { echo "ERROR — nothing was checked: cc missing" >&2; exit 2; }
mkdir -p "$(dirname -- "$BIN")" "$(dirname -- "$IMG")"
if [ ! -x "$BIN" ] || [ "$SRC" -nt "$BIN" ] || [ "$SUPPORT_SRC" -nt "$BIN" ]; then
    cc -O2 -std=c99 -w "$SRC" -o "$BIN" || { echo "ERROR — nothing was checked: make_os_disk did not build" >&2; exit 2; }
fi

G=assets/fonts/google-fonts
SIMPLEOS_FONT_ASSET_NSANSSC="$G/ofl/notosanssc/NotoSansSC[wght].ttf"
SIMPLEOS_FONT_ASSET_NSANSDEV="$G/ofl/notosansdevanagari/NotoSansDevanagari[wdth,wght].ttf"
SIMPLEOS_FONT_ASSET_NSANSARB="$G/ofl/notosansarabic/NotoSansArabic[wdth,wght].ttf"
SIMPLEOS_FONT_ASSET_NSANSBEN="$G/ofl/notosansbengali/NotoSansBengali[wdth,wght].ttf"
SIMPLEOS_FONT_ASSET_NSERIFSC="$G/ofl/notoserifsc/NotoSerifSC[wght].ttf"
SIMPLEOS_FONT_ASSET_NSERFDEV="$G/ofl/notoserifdevanagari/NotoSerifDevanagari[wdth,wght].ttf"
SIMPLEOS_FONT_ASSET_NNASKHAR="$G/ofl/notonaskharabic/NotoNaskhArabic[wght].ttf"
SIMPLEOS_FONT_ASSET_NSERFBEN="$G/ofl/notoserifbengali/NotoSerifBengali[wdth,wght].ttf"
SIMPLEOS_FONT_ASSET_NOTOSANS="$G/ofl/notosansmono/NotoSansMono[wdth,wght].ttf"
SIMPLEOS_FONT_ASSET_BUNGEE="$G/ofl/bungee/Bungee-Regular.ttf"
SIMPLEOS_FONT_ASSET_NUNITO="$G/ofl/nunito/Nunito[wght].ttf"
SIMPLEOS_FONT_ASSET_CAVEAT="$G/ofl/caveat/Caveat[wght].ttf"
SIMPLEOS_FONT_ASSET_ROBOSLAB="$G/apache/robotoslab/RobotoSlab[wght].ttf"
SIMPLEOS_FONT_ASSET_UNIFRAKT="$G/ofl/unifrakturcook/UnifrakturCook-Bold.ttf"
SIMPLEOS_FONT_ASSET_PIXELIFY="$G/ofl/pixelifysans/PixelifySans[wght].ttf"
SIMPLEOS_FONT_ASSET_NOTOEMOJ="$G/ofl/notoemoji/NotoEmoji[wght].ttf"
export SIMPLEOS_FONT_ASSET_NSANSSC SIMPLEOS_FONT_ASSET_NSANSDEV SIMPLEOS_FONT_ASSET_NSANSARB
export SIMPLEOS_FONT_ASSET_NSANSBEN SIMPLEOS_FONT_ASSET_NSERIFSC SIMPLEOS_FONT_ASSET_NSERFDEV
export SIMPLEOS_FONT_ASSET_NNASKHAR SIMPLEOS_FONT_ASSET_NSERFBEN SIMPLEOS_FONT_ASSET_NOTOSANS
export SIMPLEOS_FONT_ASSET_BUNGEE SIMPLEOS_FONT_ASSET_NUNITO SIMPLEOS_FONT_ASSET_CAVEAT
export SIMPLEOS_FONT_ASSET_ROBOSLAB SIMPLEOS_FONT_ASSET_UNIFRAKT SIMPLEOS_FONT_ASSET_PIXELIFY
export SIMPLEOS_FONT_ASSET_NOTOEMOJ

rm -f "$IMG"
"$BIN" "$IMG" x86_64 "$SIZE_MIB" "" fs-exec || { echo "ERROR — nothing was checked: make_os_disk failed" >&2; exit 2; }
[ -s "$IMG" ] || { echo "ERROR — nothing was checked: no image at $IMG" >&2; exit 2; }
echo "[vfsrt-volume] $IMG ($(stat -c%s "$IMG") bytes, ${SIZE_MIB}MiB SimpleOS system FAT32)"
