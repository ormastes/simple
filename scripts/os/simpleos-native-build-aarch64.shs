#!/usr/bin/env sh
# Cross-build the static Simple compiler/interpreter/loader for SimpleOS aarch64.
#
# Mirrors the x86_64 route from the multiarch plan
# (doc/03_plan/os/simpleos/in_guest_simple_toolchain_multiarch_plan.md):
# build with the pure-Simple self-hosted compiler (`bin/release/simple`) by default.
#
# Prereqs:
#   sh scripts/os/simpleos-sysroot-aarch64.shs   # crt0 + libsimpleos_c + simpleos.ld
#   aarch64 simple-core runtime archive at
#   build/os/simple-core-simpleos-aarch64/libsimple_runtime.a (14 parts,
#   cranelift --emit-archive --no-mangle --target aarch64-unknown-simpleos),
#   copied to build/os/sysroot-aarch64/lib/libsimple_runtime.a.
#
# Output: bin/release/aarch64-unknown-simpleos/simple (static EM_AARCH64 ELF,
# link base 0x50000000 — clear of the arm64 kernel band, see the sysroot
# script header).
set -eu

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO_ROOT"

TARGET="aarch64-unknown-simpleos"
SYSROOT="${SIMPLEOS_SYSROOT_AARCH64:-build/os/sysroot-aarch64}"
OUTPUT="bin/release/${TARGET}/simple"
ENTRY="src/app/simpleos_tool/main.spl"
BACKEND="${SIMPLE_NATIVE_BACKEND:-cranelift}"
TARGET_RUNTIME="build/os/simple-core-simpleos-aarch64/libsimple_runtime.a"

# Was: COMPILER="${SIMPLE_BUILD_COMPILER:-bin/release/simple}" followed by a bare
# `[ -x "$COMPILER" ]`. That is the weakest form of this family's defect: no seed
# check and no capability probe at all, so it would silently build the aarch64
# payload with whatever happened to sit at that path -- including the Rust
# bootstrap seed, whose payload then fails both install-image provenance guards.
# Now shares the capability-probing selection with every other builder.
. "$REPO_ROOT/scripts/lib/simple-compiler-select.shs"

COMPILER="$(simple_compiler_select --root "$REPO_ROOT" --builder-target "$TARGET")" || {
  echo "error: no Simple compiler passed the native-build capability probe for $TARGET" >&2
  exit 1
}
COMPILER="$(realpath "$COMPILER")"
BUILDER_ADMISSION_RECEIPT="${SIMPLE_BUILD_COMPILER_ADMISSION_RECEIPT:-$(dirname -- "$COMPILER")/admission.env}"
sh scripts/os/provision_simpleos_guest_simple_fs.shs --validate-builder \
  "$COMPILER" "$BUILDER_ADMISSION_RECEIPT" >/dev/null || {
  echo "error: selected compiler lacks canonical Stage2 admission authority" >&2
  exit 1
}
receipt_value() { awk -F= -v key="$1" '$1 == key { n++; v=substr($0,length(key)+2) } END { if (n == 1) print v; else exit 1 }' "$BUILDER_ADMISSION_RECEIPT"; }

# CC wrapper carries the merged libc + real Simple C runtime + simple-core
# runtime archive (libsimpleos_all.a) through the -print-libgcc-file-name
# slot, mirroring scripts/os/simpleos-native-build-riscv64.shs — because
# simpleos_user_runtime_paths() in the seed linker is x86_64-gated, so
# aarch64 (like riscv64) cannot rely on the linker's hardcoded 3-input path.
for f in "$SYSROOT/lib/crt0.o" "$SYSROOT/lib/libsimpleos_c.a" \
         "$SYSROOT/lib/libsimpleos_all.a" \
         "$SYSROOT/lib/cc-aarch64-simpleos" \
         "$SYSROOT/share/simpleos/simpleos.ld"; do
  [ -s "$f" ] || { echo "error: missing sysroot piece: $f (run scripts/os/simpleos-sysroot-aarch64.shs)" >&2; exit 1; }
done

echo "Compiler:  ${COMPILER}"
echo "Target:    ${TARGET}"
echo "Sysroot:   ${SYSROOT}"
echo "Output:    ${OUTPUT}"
mkdir -p "$(dirname "$OUTPUT")"

CC="$SYSROOT/lib/cc-aarch64-simpleos" \
SIMPLEOS_SYSROOT="$SYSROOT" \
SIMPLE_SIMPLE_CORE_PATH="$TARGET_RUNTIME" \
SIMPLE_BOOTSTRAP=1 SIMPLE_NO_STUB_FALLBACK=1 "$COMPILER" native-build \
  --source src/compiler --source src/lib --source src/app \
  --backend "$BACKEND" \
  --runtime-bundle simple-core \
  --entry-closure \
  --entry "$ENTRY" \
  --target "$TARGET" \
  --linker-script "$SYSROOT/share/simpleos/simpleos.ld" \
  -o "$OUTPUT"

echo ""
echo "[verify] readelf..."
readelf -h "$OUTPUT" | grep -E "Class|Type|Machine|Entry"
readelf -l "$OUTPUT" | grep -E "LOAD" | head -5
FILE_INFO=$(file "$OUTPUT")
case "$FILE_INFO" in
  *ELF*aarch64*"statically linked"*) ;;
  *) echo "FAILED: expected a static aarch64 ELF, got: $FILE_INFO" >&2; exit 1 ;;
esac

cat > "${OUTPUT}.build_stamp" <<EOF
target=${TARGET}
entry=${ENTRY}
entry_closure=true
backend=${BACKEND}
runtime_bundle=simple-core
runtime_archive=${TARGET_RUNTIME} (14 parts, cranelift --emit-archive --no-mangle)
linker_script=${SYSROOT}/share/simpleos/simpleos.ld (base 0x50000000)
compiler=${COMPILER}
compiler_is_bootstrap_seed=false
compiler_sha256=$(sha256sum "$COMPILER" | awk '{print $1}')
builder_sha256=$(sha256sum "$COMPILER" | awk '{print $1}')
builder_admission_receipt=$BUILDER_ADMISSION_RECEIPT
builder_admission_receipt_sha256=$(sha256sum "$BUILDER_ADMISSION_RECEIPT" | awk '{print $1}')
builder_admission_identity=$(receipt_value admission_identity)
source_revision_sha256=$(receipt_value source_snapshot_sha256)
artifact_sha256=$(sha256sum "$OUTPUT" | awk '{print $1}')
built=$(date -u +%Y-%m-%dT%H:%M:%SZ)
size=$(wc -c < "$OUTPUT")
EOF

echo "SUCCESS: ${OUTPUT} ($(($(wc -c < "$OUTPUT") / 1024)) KiB)"
