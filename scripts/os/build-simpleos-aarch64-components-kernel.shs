#!/bin/sh
# build-simpleos-aarch64-components-kernel.shs <component>
#
# Build build/os/aarch64_components/<component>/kernel.elf — one aarch64
# in-guest TOOLCHAIN COMPONENT kernel — from tracked Simple source.
#
# <component> is one of: devtool | caret | testrun | mcp
#
# ONE KERNEL PER COMPONENT, on purpose. The riscv64 sibling lane first tried a
# single combined 4-component entry and its --entry-closure union left ~500
# rt_* symbols undefined, while the per-component bills were far smaller
# (caret 8, testrun 4, devtool 5). Building them separately means one
# component's missing closure cannot hold the other three hostage — which is
# exactly how that lane got a real dev-tool green while MCP stayed blocked.
#
# COMPILER: the Rust bootstrap SEED, on purpose and stated loudly. The
# pure-Simple self-hosted compiler cannot compile anything in this tree yet, so
# every artifact this lane produces is seed-built and the gate says so in its
# verdict rather than implying self-hosting.
#
# The checked-in seed at bin/simple is STALE and manufactures ~34 phantom PARSE
# failures that vanish with zero source changes, so SIMPLE_BIN must point at a
# freshly built seed (`cargo build --release --bin simple` in src/compiler_rust).
#
# --timeout 1200 is passed to native-build deliberately: the 300s default makes
# modules that compile fine "fail". A timeout is not a compile error.
#
# Exit status: 0 = a non-empty AArch64 ELF with .text was produced AND the
# component's own row symbol is present; non-zero = nothing usable, with the
# literal linker/compiler tail on stderr. There is no partial success and no
# stub fallback (SIMPLE_ALLOW_STUB_FALLBACK is never set here).
set -eu

REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$REPO_ROOT"

COMPONENT=${1:-}
[ -n "$COMPONENT" ] || { printf 'usage: %s <devtool|caret|testrun|mcp>\n' "$0" >&2; exit 2; }

case "$COMPONENT" in
    devtool) SRC=devtool_component_entry.spl;    SYM=devtool_component_row ;;
    caret)   SRC=caret_component_entry.spl;      SYM=caret_component_row ;;
    testrun) SRC=testrunner_component_entry.spl; SYM=testrunner_component_row ;;
    mcp)     SRC=mcp_component_entry.spl;        SYM=mcp_component_row ;;
    *) printf 'build-aarch64-components: ERROR — unknown component %s\n' "$COMPONENT" >&2; exit 2 ;;
esac

ARCH_DIR=$REPO_ROOT/examples/09_embedded/simple_os/arch/aarch64
OUT_DIR=${OUT_DIR:-$REPO_ROOT/build/os/aarch64_components/$COMPONENT}
SIMPLE_BIN=${SIMPLE_BIN:-$REPO_ROOT/src/compiler_rust/target/release/simple}
ENTRY=$ARCH_DIR/$SRC
LDS=$ARCH_DIR/boot/linker_limine.ld
KERNEL=$OUT_DIR/kernel.elf
LOG=$OUT_DIR/kernel-build.log
NB_TIMEOUT=${NATIVE_BUILD_TIMEOUT:-1200}

fail() { printf 'build-aarch64-components[%s]: ERROR — %s\n' "$COMPONENT" "$*" >&2; exit 1; }

[ -x "$SIMPLE_BIN" ] || fail "no compiler at $SIMPLE_BIN (build the seed: cargo build --release --bin simple in src/compiler_rust)"
[ -f "$ENTRY" ] || fail "missing entry $ENTRY"
[ -f "$LDS" ] || fail "missing linker script $LDS"

mkdir -p "$OUT_DIR"
rm -f "$KERNEL"

# Exit status read DIRECTLY into a variable on the next line — never through a
# pipe, whose $? is the last pipeline element's status.
"$SIMPLE_BIN" native-build --backend cranelift --entry-closure \
    --timeout "$NB_TIMEOUT" \
    --entry "$ENTRY" \
    --target aarch64-unknown-none-elf \
    --linker-script "$LDS" \
    -o "$KERNEL" >"$LOG" 2>&1
rc=$?
[ "$rc" -eq 0 ] || { tail -60 "$LOG" >&2; fail "native-build failed (rc=$rc), log: $LOG"; }

[ -s "$KERNEL" ] || fail "native-build reported success but $KERNEL is missing or empty"

# Structural read-back: a link that silently emitted a host-arch or empty image
# must not report success.
hdr=$(readelf -h "$KERNEL" 2>/dev/null) || fail "readelf could not parse $KERNEL"
case "$hdr" in
    *AArch64*) ;;
    *) fail "$KERNEL is not an AArch64 ELF" ;;
esac
readelf -SW "$KERNEL" 2>/dev/null | grep -q ' \.text ' \
    || fail "$KERNEL has no .text section (empty-link false success)"

# Real-not-stub check: --gc-sections has previously discarded an unrooted
# reachable graph and still reported a successful link.
readelf -sW "$KERNEL" 2>/dev/null | grep -q "$SYM" \
    || fail "$KERNEL contains no $SYM symbol (the component was garbage-collected out)"

size=$(wc -c <"$KERNEL")
printf 'PASS — aarch64 %s component kernel built by the RUST SEED (%s): %s (%s bytes, AArch64 ELF with .text and %s)\n' \
    "$COMPONENT" "$SIMPLE_BIN" "$KERNEL" "$size" "$SYM"
