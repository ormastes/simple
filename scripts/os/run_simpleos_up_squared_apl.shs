#!/usr/bin/env sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
MODE=""
for arg in "$@"; do
    case "$arg" in
        --build-only) MODE=build ;;
        --live) MODE=live ;;
        --protection=*) ;; # Catalog compatibility; policy is recorded separately.
        *) echo "error: unsupported UP2 runner argument: $arg" >&2; exit 1 ;;
    esac
done
test -n "$MODE" || { echo "usage: $0 --build-only|--live [--protection=MODE]" >&2; exit 1; }

case "$MODE" in
    build)
        sh "$ROOT_DIR/scripts/os/build-simpleos-up-squared-apollo-lake.shs"
        sh "$ROOT_DIR/scripts/os/build-simpleos-up-squared-usb-image.shs"
        ;;
    live)
        exec sh "$ROOT_DIR/scripts/check/check-simpleos-up-squared-apollo-lake.shs" --live
        ;;
esac
