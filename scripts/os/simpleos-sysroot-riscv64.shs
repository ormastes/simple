#!/bin/sh
# Build the riscv64-unknown-simpleos userspace sysroot.
#
# Mirrors the aarch64 lane of src/os/port/llvm/sysroot.shs (which errors out
# for riscv64: "libc runtime build is not wired for $TRIPLE") into a separate
# sysroot dir so the x86_64 sysroot at build/os/sysroot is never clobbered.
#
# Produces build/os/sysroot-riscv64/
#   lib/crt0.o                 riscv64 user _start (bss clear, gp init, main, exit)
#   lib/libsimpleos_c.a        SimpleOS libc cross-built rv64gc/lp64d
#   lib/libsimpleos_all.a      libc + pure-Simple core runtime + crt0 merged —
#                              served through the seed linker's builtins slot
#                              (via cc-riscv64-simpleos -print-libgcc-file-name)
#   lib/cc-riscv64-simpleos    CC wrapper: passthrough clang, but answers
#                              -print-libgcc-file-name with libsimpleos_all.a
#   share/simpleos/simpleos.ld userspace linker script, base 0x100000000
#                              (clears the rv64 kernel band 0x80200000+126M
#                              declared in src/os/kernel/arch/riscv64/linker.ld)
set -eu

REPO_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$REPO_ROOT"

SYSROOT="$REPO_ROOT/build/os/sysroot-riscv64"
LIBC_DIR="$REPO_ROOT/src/os/libc"
LIBC_BUILD="$REPO_ROOT/build/os/libc-riscv64-unknown-simpleos"
CORE_OBJ_DIR="${SIMPLE_CORE_OBJ_DIR:-$REPO_ROOT/build/os/simple-core-simpleos-riscv64/parts/objects}"
TRIPLE_CC="riscv64-unknown-none-elf"
CC="${CC:-clang}"
AR="${AR:-llvm-ar}"
command -v "$AR" >/dev/null 2>&1 || AR=ar
CFLAGS="--target=$TRIPLE_CC -march=rv64gc -mabi=lp64d -mcmodel=medany -ffreestanding -nostdlib -fno-builtin -fno-stack-protector -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -O2 -Wall -Wextra -Wno-unused-parameter -D__simpleos__=1 -I$LIBC_DIR/include"

mkdir -p "$SYSROOT/lib" "$SYSROOT/share/simpleos" "$LIBC_BUILD"
printf '%s\n' "riscv64-unknown-simpleos" > "$SYSROOT/share/simpleos/target-triple.txt"

echo "[sysroot-rv64] Building SimpleOS libc for riscv64..."
for src in \
    simpleos_libc.c simpleos_cli_args.c simpleos_math.c simpleos_math_ext.c simpleos_fs.c \
    simpleos_pthread.c simpleos_alloc.c simpleos_process.c \
    simpleos_string_ext.c simpleos_stdlib_ext.c \
    simpleos_time.c simpleos_printf_float.c simpleos_cxxabi.c \
    simpleos_dlmalloc.c simpleos_signal.c simpleos_libc_ext.c \
    simpleos_poll.c simpleos_process_wait.c \
    simpleos_pthread_rwlock.c simpleos_pthread_cond.c \
    simpleos_sched.c simpleos_epoll.c simpleos_eventfd.c \
    simpleos_timerfd.c simpleos_signalfd.c simpleos_inotify.c \
    simpleos_fs_walk.c simpleos_glob_stub.c simpleos_pwd_stub.c \
    simpleos_strfmon.c simpleos_fork.c simpleos_ipc.c \
    simpleos_socket.c simpleos_filelock.c simpleos_statvfs.c \
    simpleos_utsname.c simpleos_posix_ext.c \
    simpleos_softfloat_builtins.c
do
    "$CC" $CFLAGS -c "$LIBC_DIR/$src" -o "$LIBC_BUILD/${src%.c}.o"
done

cat > "$LIBC_BUILD/simpleos_crt0_riscv64.S" << 'ASMEOF'
.section .text
.global _start
.type _start, %function
_start:
    /* Preserve the process-entry stack before any call or stack alignment. */
    mv s0, sp
.option push
.option norelax
    la gp, __global_pointer$
.option pop

    /*
     * Decode the ELF64 initial stack built by stack_builder.spl:
     *   sp[0] = argc
     *   sp[1 .. argc] = non-null argv pointers
     *   sp[argc + 1] = NULL
     *   sp[argc + 2 ..] = envp
     *
     * The kernel admission contract permits at most 64 argv and 128 envp
     * entries.  The kernel-owned stack builder already enforces those limits,
     * but crt0 checks both vectors defensively before trusting or publishing
     * them.  Do not reinterpret an invalid count or unterminated vector as a
     * different, privileged invocation: malformed entry metadata exits closed.
     * An inaccessible stack/pointer slot faults the process, which is also
     * fail-closed; crt0 never dereferences the argument strings themselves.
     */
    andi t0, s0, 15
    bnez t0, .Lmalformed_stack
    ld s1, 0(s0)                       /* argc */
    li t0, 64
    bgtu s1, t0, .Lmalformed_stack
    addi s2, s0, 8                    /* argv */
    mv t1, s2
    mv t2, s1
.Lvalidate_argv:
    beqz t2, .Lvalidate_argv_end
    ld t3, 0(t1)
    beqz t3, .Lmalformed_stack
    addi t1, t1, 8
    addi t2, t2, -1
    j .Lvalidate_argv
.Lvalidate_argv_end:
    ld t3, 0(t1)
    bnez t3, .Lmalformed_stack
    addi s3, t1, 8                    /* envp */

    /* envp has no count word: accept at most 128 non-null entries plus NULL. */
    mv t1, s3
    li t2, 128
.Lvalidate_envp:
    ld t3, 0(t1)
    beqz t3, .Linitial_stack_valid
    addi t1, t1, 8
    addi t2, t2, -1
    bnez t2, .Lvalidate_envp
    /* Exactly 128 entries are valid only when the following slot terminates. */
    ld t3, 0(t1)
    bnez t3, .Lmalformed_stack
.Linitial_stack_valid:

    la a0, __bss_start
    la a1, __bss_end
    bgeu a0, a1, 1f
0:
    sb zero, 0(a0)
    addi a0, a0, 1
    bltu a0, a1, 0b
1:
    /* Publish POSIX environ before constructors. */
    la t0, environ
    sd s3, 0(t0)

    /* Publish argv for SimpleCore when its weak runtime hook is linked. */
    la t0, rt_set_args
    beqz t0, .Largs_published
    mv a0, s1
    mv a1, s2
    jalr t0
.Largs_published:

    /* Admit manifest-aware native artifacts before constructors or user code. */
    la t0, __simple_startup_before_main
    beqz t0, .Lstartup_before_main_done
    mv a0, s1
    mv a1, s2
    jalr t0
    bnez a0, .Lstartup_rejected
.Lstartup_before_main_done:

    call __libc_init_array

    /* Native Simple artifacts may expose module-global initializers. */
    la t0, __simple_call_module_inits
    beqz t0, .Lmodule_inits_done
    jalr t0
.Lmodule_inits_done:

    mv a0, s1
    mv a1, s2
    mv a2, s3
    call main
    call exit
2:
    j 2b

.Lmalformed_stack:
    /* Avoid constructors, user code, and libc state on an untrusted frame. */
    li a0, 127
    li a7, 0                           /* SIMPLEOS_SYS_EXIT */
    ecall
.Lmalformed_hang:
    j .Lmalformed_hang

.Lstartup_rejected:
    li a0, 125
    li a7, 0                           /* SIMPLEOS_SYS_EXIT */
    ecall
.Lstartup_rejected_hang:
    j .Lstartup_rejected_hang
.size _start, . - _start
.weak __bss_start
.weak __bss_end
.weak rt_set_args
.weak __simple_call_module_inits
.weak __simple_startup_before_main

.section .bss
.balign 8
.weak environ
environ:
    .quad 0
ASMEOF

cat > "$LIBC_BUILD/simpleos_setjmp_riscv64.S" << 'ASMEOF'
.section .text
.global setjmp
.type setjmp, %function
setjmp:
    sd s0,   0(a0)
    sd s1,   8(a0)
    sd s2,  16(a0)
    sd s3,  24(a0)
    sd s4,  32(a0)
    sd s5,  40(a0)
    sd s6,  48(a0)
    sd s7,  56(a0)
    sd s8,  64(a0)
    sd s9,  72(a0)
    sd s10, 80(a0)
    sd s11, 88(a0)
    sd sp,  96(a0)
    sd ra, 104(a0)
    li a0, 0
    ret
.size setjmp, . - setjmp

.global _setjmp
.type _setjmp, %function
_setjmp:
    j setjmp
.size _setjmp, . - _setjmp

.global longjmp
.type longjmp, %function
longjmp:
    ld s0,   0(a0)
    ld s1,   8(a0)
    ld s2,  16(a0)
    ld s3,  24(a0)
    ld s4,  32(a0)
    ld s5,  40(a0)
    ld s6,  48(a0)
    ld s7,  56(a0)
    ld s8,  64(a0)
    ld s9,  72(a0)
    ld s10, 80(a0)
    ld s11, 88(a0)
    ld sp,  96(a0)
    ld ra, 104(a0)
    mv a0, a1
    bnez a0, 1f
    li a0, 1
1:
    ret
.size longjmp, . - longjmp

.global _longjmp
.type _longjmp, %function
_longjmp:
    j longjmp
.size _longjmp, . - _longjmp
ASMEOF

"$CC" --target="$TRIPLE_CC" -march=rv64gc -mabi=lp64d -ffreestanding -nostdlib -c "$LIBC_BUILD/simpleos_crt0_riscv64.S" -o "$LIBC_BUILD/simpleos_crt0.o"
"$CC" --target="$TRIPLE_CC" -march=rv64gc -mabi=lp64d -ffreestanding -nostdlib -c "$LIBC_DIR/simpleos_syscall_riscv64.S" -o "$LIBC_BUILD/simpleos_syscall.o"
"$CC" --target="$TRIPLE_CC" -march=rv64gc -mabi=lp64d -ffreestanding -nostdlib -c "$LIBC_BUILD/simpleos_setjmp_riscv64.S" -o "$LIBC_BUILD/simpleos_setjmp.o"

rm -f "$SYSROOT/lib/libsimpleos_c.a"
"$AR" rcs "$SYSROOT/lib/libsimpleos_c.a" "$LIBC_BUILD"/*.o
cp "$LIBC_BUILD/simpleos_crt0.o" "$SYSROOT/lib/crt0.o"
echo "[sysroot-rv64] Installed libsimpleos_c.a + crt0.o"

# -- Real Simple C runtime, cross-compiled for riscv64 ------------------------
#
# Mirrors the x86_64 lane in src/os/port/llvm/sysroot.shs (which builds
# lib/libsimple_runtime_native.a). Without it the riscv64 payload link fails on
# exactly the same 20 undefined symbols the x86_64 lane hit — 17 `rt_*` plus
# `simple_contract_check` and `spl_wffi_call_i64`; see
# doc/08_tracking/bug/simpleos_payload_link_missing_20_rt_symbols_2026-08-06.md.
# The pure-Simple simple-core archive supplies a DIFFERENT ~291-symbol `rt_*`
# set and does not overlap these, so it is not a substitute.
#
# One object per source file, deliberately: archive members are the linker's
# granularity, so a reference to one runtime entry point does not drag the rest
# in. Do NOT partial-link (ld -r) these, and do NOT put them in
# libsimpleos_c.a — a plain C/C++ link must never pull the Simple runtime in
# (doc/08_tracking/bug/simpleos_libc_leaks_simple_runtime_syms_2026-08-06.md).
# They go into libsimpleos_all.a instead, which is served to the Simple linker
# through the `-print-libgcc-file-name` slot by cc-riscv64-simpleos, because
# simpleos_user_runtime_paths() in the seed linker is x86_64-gated.
echo "[sysroot-rv64] Cross-compiling real Simple runtime for riscv64..."
RT_BUILD="$LIBC_BUILD/simple_runtime_native"
mkdir -p "$RT_BUILD"
RT_CFLAGS="--target=$TRIPLE_CC -march=rv64gc -mabi=lp64d -mcmodel=medany \
    -ffreestanding -nostdlib -nostdlibinc -fno-builtin -fno-stack-protector \
    -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables \
    -ffunction-sections -fdata-sections -O2 -D__simpleos__=1 \
    -isystem $LIBC_DIR/include"
# `runtime_legacy_core` is a NINTH source beyond the x86_64 list. It is required
# here and not there: `runtime_native.o`'s `rt_panic` / `rt_process_run` pull in
# `spl_panic`, `spl_strdup`, `spl_str_concat`, `spl_file_read` and `rt_is_dir`,
# which live in no other archive on either arch. `--gc-sections` IS already on
# the rv64 link line (direct-lld path, linker.rs:2034) so section GC is not the
# difference — these references genuinely survive GC in the rv64 link.
# Verified: zero defined-symbol overlap with runtime_native.o, so adding it
# cannot introduce a duplicate definition.
for rt_src in runtime_native runtime_simd_utf8 runtime_contracts \
              runtime_memory runtime_time runtime_timestamp \
              runtime_pool runtime_memtrack runtime_legacy_core \
              runtime_simpleos_syscall_adapters \
              startup/baremetal/runtime_log
do
    rt_obj="$RT_BUILD/$(basename "$rt_src").o"
    "$CC" $RT_CFLAGS -c "$REPO_ROOT/src/runtime/$rt_src.c" \
        -o "$rt_obj" || {
            echo "[sysroot-rv64] ERROR: failed to cross-compile $rt_src.c" >&2
            exit 1
        }
done
echo "[sysroot-rv64] Built riscv64 C runtime objects ($(ls "$RT_BUILD"/*.o | wc -l))"

# -- Merged link archive (served via the -print-libgcc-file-name slot) -------
rm -f "$SYSROOT/lib/libsimpleos_all.a"
if [ -d "$CORE_OBJ_DIR" ]; then
    "$AR" rcs "$SYSROOT/lib/libsimpleos_all.a" \
        "$LIBC_BUILD"/*.o \
        "$RT_BUILD"/*.o \
        "$CORE_OBJ_DIR"/*/*.o
    echo "[sysroot-rv64] Installed libsimpleos_all.a (libc + C runtime + simple-core runtime + crt0)"
else
    "$AR" rcs "$SYSROOT/lib/libsimpleos_all.a" "$LIBC_BUILD"/*.o "$RT_BUILD"/*.o
    echo "[sysroot-rv64] WARNING: core runtime objects missing ($CORE_OBJ_DIR); libsimpleos_all.a is libc + C runtime only"
fi

# -- CC wrapper ---------------------------------------------------------------
cat > "$SYSROOT/lib/cc-riscv64-simpleos" << CCEOF
#!/bin/sh
# clang passthrough that serves libsimpleos_all.a as the compiler builtins
# archive, so the Simple seed linker places it AFTER the Simple objects.
for a in "\$@"; do
    if [ "\$a" = "-print-libgcc-file-name" ]; then
        echo "$SYSROOT/lib/libsimpleos_all.a"
        exit 0
    fi
done
exec clang "\$@"
CCEOF
chmod +x "$SYSROOT/lib/cc-riscv64-simpleos"

# -- Linker script ------------------------------------------------------------
cat > "$SYSROOT/share/simpleos/simpleos.ld" << LDEOF
/* SimpleOS riscv64 userspace linker script
 *
 * Text starts at 0x100000000 (Sv39 VPN[2] slot 4), separate from the kernel
 * identity mapping at 0x80200000 (slot 2). Physical user pages still come
 * from QEMU virt RAM; this address is their supervisor-managed virtual map.
 * Static linking only.
 */
ENTRY(_start)
INPUT($SYSROOT/lib/crt0.o)

SECTIONS {
    . = 0x100000000;

    .text : {
        *(.text.entry)
        *(.text .text.*)
    }

    . = ALIGN(4096);
    .rodata : {
        *(.rodata .rodata.*)
        *(.srodata .srodata.*)
    }

    . = ALIGN(8);
    .eh_frame_hdr : {
        __eh_frame_hdr_start = .;
        KEEP(*(.eh_frame_hdr))
        __eh_frame_hdr_end = .;
    }

    . = ALIGN(8);
    .eh_frame : {
        __eh_frame_start = .;
        KEEP(*(.eh_frame))
        __eh_frame_end = .;
    }

    . = ALIGN(4096);
    .data : {
        *(.data .data.*)
    }

    . = ALIGN(8);
    .sdata : {
        PROVIDE(__global_pointer\$ = . + 0x800);
        *(.sdata .sdata.*)
    }

    . = ALIGN(8);
    .got : {
        *(.got) *(.got.*)
    }

    . = ALIGN(16);
    .init_array : {
        __init_array_start = .;
        KEEP(*(.init_array .init_array.*))
        __init_array_end = .;
    }

    . = ALIGN(16);
    .fini_array : {
        __fini_array_start = .;
        KEEP(*(.fini_array .fini_array.*))
        __fini_array_end = .;
    }

    . = ALIGN(16);
    .tdata : {
        _tls_start = .;
        *(.tdata .tdata.*)
    }

    . = ALIGN(16);
    .tbss : {
        *(.tbss .tbss.*)
        _tls_end = .;
    }

    . = ALIGN(4096);
    .bss : {
        __bss_start = .;
        *(.sbss .sbss.*)
        *(.bss .bss.*)
        *(COMMON)
        __bss_end = .;
    }

    _end = .;

    /DISCARD/ : {
        *(.comment)
        *(.note .note.*)
        *(.plt)
        *(.rela.plt)
    }
}
LDEOF

echo "[sysroot-rv64] Sysroot ready: $SYSROOT"
ls -la "$SYSROOT/lib/" "$SYSROOT/share/simpleos/"
