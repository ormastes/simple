#!/bin/sh
# Local pre-push dispatcher installed by install-must-check-hooks.{shs,ps1}.
# The canonical driver delegates expensive requirements through textual-ledger
# validation while retaining the bounded committed-tree guards.
set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "pre-push dispatcher: cannot locate repository root" >&2
    exit 1
}
HOOKS_DIR=$(git rev-parse --git-path hooks 2>/dev/null) || exit 1
case "$HOOKS_DIR" in /*) : ;; *) HOOKS_DIR="$ROOT/$HOOKS_DIR" ;; esac
REFS=$(mktemp) || exit 1
trap 'rm -f "$REFS"' EXIT INT TERM
cat > "$REFS"

LOCAL_HOOK="$HOOKS_DIR/pre-push.local"
CANONICAL_GUARD="$ROOT/scripts/check/pre-push-conflict-tree-guard.shs"
if [ -x "$LOCAL_HOOK" ] && ! cmp -s "$LOCAL_HOOK" "$CANONICAL_GUARD"; then
    "$LOCAL_HOOK" "$@" < "$REFS" || {
        rc=$?
        echo "pre-push dispatcher: preserved local hook failed (status $rc)" >&2
        exit "$rc"
    }
fi

sh "$CANONICAL_GUARD" "$@" < "$REFS"
rc=$?
rm -f "$REFS"
trap - EXIT INT TERM
exit "$rc"
