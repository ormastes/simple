#!/bin/sh
# Local pre-push dispatcher installed by install-must-check-hooks.{shs,ps1}.
# The canonical driver delegates expensive requirements through textual-ledger
# validation while retaining the bounded committed-tree guards.
set -u

# --- re-entry guard (OLDGUARD_DEPTH) ---
# 2026-08-26: a recursive pre-push probe (nicknamed "oldguard" in session
# memory) was observed spawning thousands of timeout/sh processes and hanging
# the host. The exact recursing artifact could not be located by static
# search of the current tree (see
# doc/08_tracking/bug/oldguard_prepush_probe_recursion_2026-08-26.md), but any
# chain where this dispatcher (or a guard it calls) ends up invoking a real
# `git push`/`jj git push` that re-triggers this same hook is exactly the
# recursion shape described. This sentinel bounds that shape unconditionally,
# as defense-in-depth, regardless of which script turns out to be the
# original offender: each invocation increments OLDGUARD_DEPTH and refuses to
# continue past a small hard cap, so a self-reentrant chain dies in a handful
# of hops instead of forking until the box falls over.
: "${OLDGUARD_DEPTH:=0}"
OLDGUARD_DEPTH=$((OLDGUARD_DEPTH + 1))
export OLDGUARD_DEPTH
OLDGUARD_MAX_DEPTH=3
if [ "$OLDGUARD_DEPTH" -gt "$OLDGUARD_MAX_DEPTH" ]; then
    echo "pre-push dispatcher: OLDGUARD_DEPTH=$OLDGUARD_DEPTH exceeds cap ($OLDGUARD_MAX_DEPTH) — refusing, this hook (or something it calls) is re-entering itself" >&2
    exit 1
fi

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "pre-push dispatcher: cannot locate repository root" >&2
    exit 1
}
HOOKS_DIR=$(git rev-parse --git-path hooks 2>/dev/null) || exit 1
case "$HOOKS_DIR" in /*) : ;; *) HOOKS_DIR="$ROOT/$HOOKS_DIR" ;; esac
REFS=$(mktemp) || exit 1
trap 'rm -f "$REFS"' EXIT INT TERM
cat > "$REFS"

LOCAL_HOOK="$HOOKS_DIR/pre-push.local"
CANONICAL_GUARD="$ROOT/scripts/check/pre-push-conflict-tree-guard.shs"
if [ -x "$LOCAL_HOOK" ] && ! cmp -s "$LOCAL_HOOK" "$CANONICAL_GUARD"; then
    "$LOCAL_HOOK" "$@" < "$REFS" || {
        rc=$?
        echo "pre-push dispatcher: preserved local hook failed (status $rc)" >&2
        exit "$rc"
    }
fi

sh "$CANONICAL_GUARD" "$@" < "$REFS"
rc=$?
rm -f "$REFS"
trap - EXIT INT TERM
exit "$rc"
