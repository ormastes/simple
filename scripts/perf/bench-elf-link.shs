#!/bin/sh
# Internal ELF linker vs ld.lld-23 vs mold — repeatable benchmark (lane C4).
#
#   sh scripts/perf/bench-elf-link.shs [--runs N] [--only static|pie|dynamic|synth]
#
# Inputs (all aarch64):
#   static  test/fixtures/linker/elf/{start,lib}_a64.o            -> static ET_EXEC
#   pie     test/fixtures/linker/elf/pie_{start,lib}_a64.o        -> static PIE
#   dynamic host crt1/crti/crtn + hello_libc_a64.o + libc.so.6    -> dynamic ET_EXEC
#   synth   SYNTH_N (default 200) generated clang objects, ~1 MB .text -> static ET_EXEC
#
# For every (input, linker) it prints the median wall time and max RSS over N
# runs (/usr/bin/time), the sha256 of the output, and whether the output runs
# (exit 42). For the internal engine it also prints the in-process elf_link
# time reported by scripts/perf/elf_link_bench.spl, which excludes the fixed
# interpreter startup. Binary identity and host load are printed first — any
# timing without them is not comparable.
#
# Env: SIMPLE_BIN (default bin/simple, else the main clone's), LLD (ld.lld-23),
#      MOLD (mold), CC_A64 (clang), SYNTH_N, OUT_DIR (build/perf/elf_link_bench).
set -u

RUNS=5
ONLY=""
while [ $# -gt 0 ]; do
    case "$1" in
        --runs) RUNS="$2"; shift 2 ;;
        --only) ONLY="$2"; shift 2 ;;
        *) echo "usage: $0 [--runs N] [--only static|pie|dynamic|synth]" >&2; exit 2 ;;
    esac
done

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT" || exit 2
SIMPLE_BIN="${SIMPLE_BIN:-}"
if [ -z "$SIMPLE_BIN" ]; then
    if [ -x bin/simple ]; then SIMPLE_BIN=bin/simple
    else SIMPLE_BIN=/home/yoon/dev/simple/bin/simple; fi
fi
LLD="${LLD:-ld.lld-23}"
MOLD="${MOLD:-mold}"
CC_A64="${CC_A64:-clang}"
SYNTH_N="${SYNTH_N:-200}"
OUT_DIR="${OUT_DIR:-$ROOT/build/perf/elf_link_bench}"
FIX=test/fixtures/linker/elf
GLIBC=/usr/lib/aarch64-linux-gnu
INTERP=/lib/ld-linux-aarch64.so.1
mkdir -p "$OUT_DIR" || exit 2

for t in /usr/bin/time sha256sum "$LLD" "$MOLD"; do
    command -v "$t" >/dev/null 2>&1 || { echo "ERROR — nothing was checked (missing tool: $t)"; exit 2; }
done

BIN_REAL=$(readlink -f "$SIMPLE_BIN")
echo "== binary: $BIN_REAL"
echo "   stat: $(stat -c '%s bytes, mtime %y' "$BIN_REAL")"
echo "   sha256: $(sha256sum "$BIN_REAL" | cut -c1-16)"
echo "   version: $("$SIMPLE_BIN" --version 2>&1 | grep -v WARNING | grep -v pure-Simple | head -1)"
echo "== host: $(uname -m), $(nproc) cpus, load $(cut -d' ' -f1-3 /proc/loadavg)"
echo "== tools: $("$LLD" --version | head -1); $("$MOLD" --version | head -1)"
echo "== source tree: $(git rev-parse --short HEAD 2>/dev/null) (+ working-copy edits: $(git status --porcelain -- src/compiler/70.backend/linker | wc -l) linker paths)"

# --- synthetic input: SYNTH_N objects, a call chain through all of them ---
gen_synth() {
    d="$OUT_DIR/synth_src"
    stamp="$d/.n$SYNTH_N"
    [ -f "$stamp" ] && return 0
    rm -rf "$d"; mkdir -p "$d" || return 1
    i=0
    while [ "$i" -lt "$SYNTH_N" ]; do
        n=$((i + 1))
        f="$d/s$i.c"
        {
            echo "long g_$i[64] = {"
            k=0; while [ $k -lt 64 ]; do printf '%d,' $((i * 64 + k)); k=$((k + 1)); done
            echo "};"
            echo "const char str_$i[] = \"synthetic object $i\";"
            [ "$n" -lt "$SYNTH_N" ] && echo "long f_$n(long);"
            k=0
            while [ $k -lt 12 ]; do
                echo "__attribute__((noinline)) static long h_${i}_$k(long x) {"
                echo "  long s = x;"
                j=0; while [ $j -lt 8 ]; do echo "  s = s * $((j + 3)) + g_$i[(s + $j) & 63] - str_$i[$j];"; j=$((j + 1)); done
                echo "  return s;"
                echo "}"
                k=$((k + 1))
            done
            echo "long f_$i(long x) {"
            echo "  long s = x;"
            k=0; while [ $k -lt 12 ]; do echo "  s ^= h_${i}_$k(s);"; k=$((k + 1)); done
            if [ "$n" -lt "$SYNTH_N" ]; then echo "  return f_$n(s & 0xff);"; else echo "  return s;"; fi
            echo "}"
        } > "$f"
        i=$n
    done
    cat > "$d/start.c" <<'EOF'
long f_0(long);
volatile long sink;
void _start(void) {
    sink = f_0(1);
    register long x0 __asm__("x0") = 42;
    register long x8 __asm__("x8") = 93;
    __asm__ volatile("svc 0" :: "r"(x0), "r"(x8));
    for (;;) {}
}
EOF
    CF="--target=aarch64-linux-gnu -c -O1 -ffreestanding -fno-pic -fno-asynchronous-unwind-tables -fno-unwind-tables -nostdlib"
    "$CC_A64" $CF "$d/start.c" -o "$d/start.o" || return 1
    i=0
    while [ "$i" -lt "$SYNTH_N" ]; do
        "$CC_A64" $CF "$d/s$i.c" -o "$d/s$i.o" || return 1
        i=$((i + 1))
    done
    : > "$stamp"
}

synth_objs() {
    s="$OUT_DIR/synth_src/start.o"
    i=0
    while [ "$i" -lt "$SYNTH_N" ]; do s="$s $OUT_DIR/synth_src/s$i.o"; i=$((i + 1)); done
    echo "$s"
}

median() { sort -n | awk '{a[NR]=$1} END {if (NR==0) print "-"; else print a[int((NR+1)/2)]}'; }

# run_timed LABEL OUT CMD... : RUNS timed runs; prints median wall/RSS
run_timed() {
    label="$1"; out="$2"; shift 2
    tf="$OUT_DIR/.time"; wl="$OUT_DIR/.wall"; rl="$OUT_DIR/.rss"; il="$OUT_DIR/.inproc"
    : > "$wl"; : > "$rl"; : > "$il"
    r=0
    while [ "$r" -lt "$RUNS" ]; do
        rm -f "$out"
        /usr/bin/time -f "%e %M" -o "$tf" "$@" > "$OUT_DIR/.stdout" 2> "$OUT_DIR/.stderr"
        rc=$?
        if [ "$rc" -ne 0 ] || [ ! -s "$out" ]; then
            echo "  $label: FAILED rc=$rc"; tail -3 "$OUT_DIR/.stdout" "$OUT_DIR/.stderr"; return 1
        fi
        tail -1 "$tf" | awk '{print $1}' >> "$wl"
        tail -1 "$tf" | awk '{print $2}' >> "$rl"
        sed -n 's/.*elf_link_us=\([0-9]*\).*/\1/p' "$OUT_DIR/.stdout" >> "$il"
        r=$((r + 1))
    done
    chmod +x "$out"
    "$out" > /dev/null 2>&1
    ran=$?
    inproc=$(median < "$il")
    [ "$inproc" = "-" ] && inproc="" || inproc=" elf_link=$((inproc / 1000))ms"
    printf '  %-9s wall=%ss rss=%sKB%s run_rc=%s sha256=%s\n' "$label" "$(median < "$wl")" "$(median < "$rl")" \
        "$inproc" "$ran" "$(sha256sum "$out" | cut -c1-16)"
}

bench_input() {
    name="$1"; mode="$2"; objs="$3"; shared="$4"
    [ -n "$ONLY" ] && [ "$ONLY" != "$name" ] && return 0
    echo "== $name ($RUNS runs, median)"
    o="$OUT_DIR/$name"
    run_timed internal "$o.internal" \
        env ELF_BENCH_MODE="$mode" ELF_BENCH_OBJS="$objs" ELF_BENCH_SHARED="$shared" ELF_BENCH_INTERP="$INTERP" \
        ELF_BENCH_OUT="$o.internal" "$SIMPLE_BIN" run scripts/perf/elf_link_bench.spl
    case "$mode" in
        static)  flags="-static -e _start" ;;
        pie)     flags="-pie --no-dynamic-linker -e _start" ;;
        dynamic) flags="--dynamic-linker $INTERP -e _start" ;;
    esac
    # shellcheck disable=SC2086
    run_timed ld.lld "$o.lld" "$LLD" $flags -o "$o.lld" $objs $shared
    # shellcheck disable=SC2086
    run_timed mold "$o.mold" "$MOLD" $flags -o "$o.mold" $objs $shared
}

bench_input static static "$FIX/start_a64.o $FIX/lib_a64.o" ""
bench_input pie pie "$FIX/pie_start_a64.o $FIX/pie_lib_a64.o" ""
bench_input dynamic dynamic "$GLIBC/crt1.o $GLIBC/crti.o $FIX/hello_libc_a64.o $GLIBC/crtn.o" "$GLIBC/libc.so.6"
if [ -z "$ONLY" ] || [ "$ONLY" = synth ]; then
    gen_synth || { echo "ERROR — synthetic input generation failed"; exit 2; }
    bench_input synth static "$(synth_objs)" ""
fi
