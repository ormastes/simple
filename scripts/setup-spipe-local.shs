#!/bin/sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if ROOT="$(git -C "$SCRIPT_DIR/.." rev-parse --show-toplevel 2>/dev/null)"; then
  :
else
  ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
fi
if git -C "$ROOT" ls-files --stage -- .spipe | grep -q '^160000 '; then
  git -C "$ROOT" submodule update --init -- .spipe
  exec sh "$ROOT/.spipe/scripts/setup-local-knowledge.sh" --mode project --destination "$ROOT" "$@"
fi
if git -C "$ROOT" ls-files --stage -- .spipe/spipe | grep -q '^160000 '; then
  git -C "$ROOT" submodule update --init -- .spipe/spipe
  exec sh "$ROOT/.spipe/spipe/scripts/setup-local-knowledge.sh" --mode project --destination "$ROOT" "$@"
fi
echo "setup-spipe-local: no .spipe submodule is recorded" >&2
exit 3
