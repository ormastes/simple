#!/bin/sh
# jupyter-docker-test.shs — Jupyter kernel E2E matrix, containerized (Stream P, P3).
#
# Design:  doc/05_design/app/tools/notebook_lanes_architecture.md
# Plan:    doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md (Stream P, P3)
#
# Runs the local-lane fixture against a REAL kernel subprocess
# (tools/jupyter/kernel_wrapper.py -> src/app/jupyter_kernel/main.spl) inside a
# throwaway python3 container via `jupyter nbconvert --execute`, using the
# repo's existing tools/jupyter/install.shs kernelspec installer unmodified.
#
# Lanes:
#   local       (fixtures/mode_local.ipynb)    — executed for real; must PASS.
#   qemu_rv32   (fixtures/mode_qemu_rv32.ipynb) — gated the same way
#     remote_exec_qemu_rv32_spec.spl gates K4: if the container has no live
#     QEMU+GDB toolchain, this lane is SKIP-clean (K4 convention). NOTE: even
#     with a toolchain present, this script cannot force the fixture through
#     K4's RemoteExec today — the kernel does not yet wire the %%mode magic
#     that would route a cell to it (see
#     doc/08_tracking/bug/jupyter_kernel_magics_never_wired_into_execute_path_2026-08-07.md).
#     When the toolchain IS present the fixture still executes (on the
#     default local lane) and that is reported honestly as
#     "executed, lane routing NOT verified" rather than a false lane pass.
#   cuda / vulkan (fixtures/mode_cuda.ipynb, mode_vulkan.ipynb) — NOT executed
#     here. K5/K6 executors have not landed; only JSON/nbformat structural
#     validity is checked. Real execution belongs on cuda-live/vulkan-live
#     labeled runners once K5/K6 land.
#
# Usage:
#   sh scripts/test/jupyter-docker-test.shs
#
# Env knobs:
#   JUPYTER_DOCKER_IMAGE     base image (default: python:3.11-slim)
#   JUPYTER_DOCKER_WORK_DIR  work dir (default: build/jupyter_docker_test)
#   JUPYTER_DOCKER_TIMEOUT   per-notebook nbconvert timeout seconds (default: 180)
#   JUPYTER_DOCKER_MEMORY    container memory cap (default: 2g)
#
# Exit codes:
#   0 = local lane PASS; qemu_rv32 lane PASS-or-SKIP-clean; GPU fixtures structurally valid
#   1 = a lane FAILed for a reason other than missing tooling
#   3 = environment unavailable (no docker daemon / no image) — host-unavailable, not failed

set -u

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

IMAGE="${JUPYTER_DOCKER_IMAGE:-python:3.11-slim}"
WORK_DIR="${JUPYTER_DOCKER_WORK_DIR:-$ROOT_DIR/build/jupyter_docker_test}"
NB_TIMEOUT="${JUPYTER_DOCKER_TIMEOUT:-180}"
DOCKER_MEMORY="${JUPYTER_DOCKER_MEMORY:-2g}"

say() { printf '%s\n' "$*"; }

# --- environment gate -------------------------------------------------------
if ! command -v docker >/dev/null 2>&1; then
    say "jupyter-docker-test: SKIP — docker not installed on this host."
    say "verdict: HOST-UNAVAILABLE"
    exit 3
fi
if ! docker info >/dev/null 2>&1; then
    say "jupyter-docker-test: SKIP — docker daemon not reachable."
    say "verdict: HOST-UNAVAILABLE"
    exit 3
fi
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    say "Pulling $IMAGE ..."
    if ! docker pull "$IMAGE" >/dev/null 2>&1; then
        say "jupyter-docker-test: SKIP — cannot pull $IMAGE (registry/network)."
        say "verdict: HOST-UNAVAILABLE"
        exit 3
    fi
fi

if [ ! -e "$ROOT_DIR/bin/simple" ]; then
    say "jupyter-docker-test: FAIL — bin/simple not found; run scripts/setup/setup.shs"
    exit 1
fi
[ -f "$ROOT_DIR/src/app/jupyter_kernel/main.spl" ] || {
    say "jupyter-docker-test: FAIL — src/app/jupyter_kernel/main.spl missing (P1 not landed?)"
    exit 1
}
[ -f "$ROOT_DIR/tools/jupyter/kernel_wrapper.py" ] || {
    say "jupyter-docker-test: FAIL — tools/jupyter/kernel_wrapper.py missing (P0/P2 not landed?)"
    exit 1
}

FIXTURE_DIR="$ROOT_DIR/test/03_system/tools/jupyter/fixtures"
for f in mode_local mode_qemu_rv32 mode_cuda mode_vulkan; do
    [ -f "$FIXTURE_DIR/$f.ipynb" ] || {
        say "jupyter-docker-test: FAIL — missing fixture $FIXTURE_DIR/$f.ipynb"
        exit 1
    }
done

mkdir -p "$WORK_DIR"
rm -f "$WORK_DIR"/*.out.ipynb "$WORK_DIR"/*.log 2>/dev/null || true

# --- structural-only check for GPU fixtures (no executor exists to run them) -
GPU_STATUS="PASS"
for f in mode_cuda mode_vulkan; do
    if ! python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$FIXTURE_DIR/$f.ipynb" >/dev/null 2>&1; then
        GPU_STATUS="FAIL ($f is not valid JSON)"
    fi
done

# --- in-container driver -----------------------------------------------------
cat > "$WORK_DIR/run_matrix.sh" <<'DRIVER'
set -eu
export HOME=/tmp/jhome
mkdir -p "$HOME"
export SIMPLE_REPO_ROOT=/repo

pip install --quiet --no-input jupyter_client pyzmq nbconvert nbformat notebook >/tmp/pip.log 2>&1 || {
    echo "PIP_INSTALL_FAILED"
    cat /tmp/pip.log
    exit 2
}

sh /repo/tools/jupyter/install.shs >/tmp/install.log 2>&1 || {
    echo "KERNELSPEC_INSTALL_FAILED"
    cat /tmp/install.log
    exit 2
}

if command -v qemu-system-riscv32 >/dev/null 2>&1; then
    echo "QEMU_RV32_TOOLCHAIN=present"
else
    echo "QEMU_RV32_TOOLCHAIN=absent"
fi

run_fixture() {
    name="$1"
    fixture="/repo/test/03_system/tools/jupyter/fixtures/$1.ipynb"
    out="/work/$1.out.ipynb"
    jupyter nbconvert --to notebook --execute \
        --ExecutePreprocessor.kernel_name=simple \
        --ExecutePreprocessor.timeout="$NB_TIMEOUT_INNER" \
        --ExecutePreprocessor.allow_errors=True \
        --output "$out" "$fixture" > "/work/$1.log" 2>&1
    rc=$?
    echo "NBCONVERT_EXIT($name)=$rc"
}

NB_TIMEOUT_INNER="${NB_TIMEOUT_INNER:-180}"
run_fixture mode_local
run_fixture mode_qemu_rv32
DRIVER
chmod +x "$WORK_DIR/run_matrix.sh"

docker run --rm \
    --memory="$DOCKER_MEMORY" \
    -e NB_TIMEOUT_INNER="$NB_TIMEOUT" \
    -v "$ROOT_DIR:/repo:ro" \
    -v "$WORK_DIR:/work" \
    -w /repo \
    "$IMAGE" \
    sh /work/run_matrix.sh > "$WORK_DIR/matrix.log" 2>&1
DOCKER_RC=$?

cat "$WORK_DIR/matrix.log"

if [ "$DOCKER_RC" -eq 2 ]; then
    say "jupyter-docker-test: SKIP — container setup failed (pip install / kernelspec install); see $WORK_DIR/matrix.log"
    say "verdict: HOST-UNAVAILABLE"
    exit 3
fi

# --- classify local lane: must be a clean PASS -------------------------------
LOCAL_RC=$(grep -o 'NBCONVERT_EXIT(mode_local)=[0-9]*' "$WORK_DIR/matrix.log" | tail -1 | cut -d= -f2)
LOCAL_STATUS="FAIL"
if [ "${LOCAL_RC:-1}" = "0" ] && [ -f "$WORK_DIR/mode_local.out.ipynb" ] \
   && ! grep -q '"ename"' "$WORK_DIR/mode_local.out.ipynb"; then
    LOCAL_STATUS="PASS"
fi

# --- classify qemu_rv32 gate: SKIP-clean without toolchain; else executed
#     (on the local lane — K4 lane routing is not exercised, see bug doc) ----
QEMU_TOOLCHAIN=$(grep -o 'QEMU_RV32_TOOLCHAIN=.*' "$WORK_DIR/matrix.log" | tail -1 | cut -d= -f2)
QEMU_RC=$(grep -o 'NBCONVERT_EXIT(mode_qemu_rv32)=[0-9]*' "$WORK_DIR/matrix.log" | tail -1 | cut -d= -f2)
if [ "$QEMU_TOOLCHAIN" != "present" ]; then
    QEMU_STATUS="SKIP-clean (no live QEMU RV32 toolchain in container, K4 convention)"
elif [ "${QEMU_RC:-1}" = "0" ] && [ -f "$WORK_DIR/mode_qemu_rv32.out.ipynb" ] \
   && ! grep -q '"ename"' "$WORK_DIR/mode_qemu_rv32.out.ipynb"; then
    QEMU_STATUS="EXECUTED (lane routing NOT verified — see doc/08_tracking/bug/jupyter_kernel_magics_never_wired_into_execute_path_2026-08-07.md)"
else
    QEMU_STATUS="FAIL"
fi

say ""
say "=== jupyter-docker-test matrix ==="
say "local      : $LOCAL_STATUS"
say "qemu_rv32  : $QEMU_STATUS"
say "cuda       : $GPU_STATUS (structural-only; K5 executor not landed; runs on cuda-live runner)"
say "vulkan     : $GPU_STATUS (structural-only; K6 executor not landed; runs on vulkan-live runner)"

if [ "$LOCAL_STATUS" != "PASS" ]; then
    say "verdict: FAIL — local lane did not pass cleanly"
    exit 1
fi
case "$GPU_STATUS" in
    PASS) : ;;
    *) say "verdict: FAIL — GPU fixture structural check failed"; exit 1 ;;
esac
case "$QEMU_STATUS" in
    SKIP-clean*|EXECUTED*)
        say "verdict: PASS — local PASS, qemu_rv32: $QEMU_STATUS"
        exit 0
        ;;
    *)
        say "verdict: FAIL — qemu_rv32 lane failed for a reason other than missing tooling"
        exit 1
        ;;
esac
