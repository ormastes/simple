#!/bin/sh
# Fail-closed RV64 boot gate for filesystem-backed PID1.
#
# This is deliberately separate from the historical SMF fixture lane: it
# requires the real kernel boot entry that calls os_main_prepare_pid1 and the
# dedicated media whose short aliases are mapped to canonical catalog paths by
# the early VFS reader.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

ELF="${ELF:-build/os/simpleos_riscv64.elf}"
IMAGE="${IMAGE:-build/os/fat32-riscv64-pid1.img}"
SERIAL_LOG="${SERIAL_LOG:-build/os/qemu-rv64-pid1-catalog.serial.log}"
BOOT_TIMEOUT="${BOOT_TIMEOUT:-60}"
ALLOW_PREBUILT_ARTIFACT=false
TEST_NET_FAULT_AFTER_READY=false

# These are evidence markers, not implementation claims.  A live service
# lifecycle gate is enabled only after trusted runtime owners emit every one
# of them.  Keep the values in sync with the instrumentation contract: PID1
# owns launch/readiness/crash/restart and the kernel owns job revocation.
MARKER_VFS_LAUNCH='[pid1] catalog-launch id=1 service=vfs pid='
MARKER_VFS_READY='[pid1] endpoint-ready service=vfs'
MARKER_NET_LAUNCH='[pid1] catalog-launch id=2 service=net pid='
MARKER_NET_READY='[pid1] endpoint-ready service=net'
MARKER_HTTP_LAUNCH='[pid1] catalog-launch id=3 service=http pid='
MARKER_HTTP_READY='[pid1] endpoint-ready service=http'
MARKER_NET_CRASH='[pid1] service-crash service=net'
MARKER_NET_RESTART='[pid1] service-restart service=net'
MARKER_NET_REVOKED='[kernel] job-teardown service=net revoked-cspaces='

usage() {
    echo "Usage: sh scripts/qemu/qemu_rv64_pid1_catalog_test.shs [--elf <kernel>] [--image <fat32>] [--serial-log <path>] [--boot-timeout <seconds>] [--test-net-fault-after-ready] [--allow-prebuilt-artifact]" >&2
}

runtime_marker_is_emitted() {
    marker="$1"
    # Do not accept a documentation/test mention as evidence instrumentation.
    # The only valid owners are the live PID1 service manager and the kernel
    # catalog/teardown path that publishes revocation state.
    for source in \
        src/os/services/init/service_manager_main.spl \
        src/os/kernel/loader/root_service_catalog.spl \
        src/os/kernel/arch/riscv64/syscall.spl; do
        if [ -f "$source" ] && grep -Fq "$marker" "$source"; then
            return 0
        fi
    done
    return 1
}

runtime_lifecycle_instrumentation_present() {
    runtime_marker_is_emitted "$MARKER_VFS_LAUNCH" &&
        runtime_marker_is_emitted "$MARKER_VFS_READY" &&
        runtime_marker_is_emitted "$MARKER_NET_LAUNCH" &&
        runtime_marker_is_emitted "$MARKER_NET_READY" &&
        runtime_marker_is_emitted "$MARKER_HTTP_LAUNCH" &&
        runtime_marker_is_emitted "$MARKER_HTTP_READY" &&
        runtime_marker_is_emitted "$MARKER_NET_CRASH" &&
        runtime_marker_is_emitted "$MARKER_NET_RESTART" &&
        runtime_marker_is_emitted "$MARKER_NET_REVOKED"
}

serial_has_required_lifecycle_evidence() {
    [ -f "$SERIAL_LOG" ] &&
        grep -Fq "$MARKER_VFS_LAUNCH" "$SERIAL_LOG" &&
        grep -Fq "$MARKER_VFS_READY" "$SERIAL_LOG" &&
        grep -Fq "$MARKER_NET_LAUNCH" "$SERIAL_LOG" &&
        grep -Fq "$MARKER_NET_READY" "$SERIAL_LOG" &&
        grep -Fq "$MARKER_HTTP_LAUNCH" "$SERIAL_LOG" &&
        grep -Fq "$MARKER_HTTP_READY" "$SERIAL_LOG" &&
        grep -Fq "$MARKER_NET_CRASH" "$SERIAL_LOG" &&
        grep -Fq "$MARKER_NET_RESTART" "$SERIAL_LOG" &&
        grep -Fq "$MARKER_NET_REVOKED" "$SERIAL_LOG"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --elf) shift; [ "$#" -gt 0 ] || { usage; exit 2; }; ELF="$1" ;;
        --elf=*) ELF="${1#*=}" ;;
        --image) shift; [ "$#" -gt 0 ] || { usage; exit 2; }; IMAGE="$1" ;;
        --image=*) IMAGE="${1#*=}" ;;
        --serial-log) shift; [ "$#" -gt 0 ] || { usage; exit 2; }; SERIAL_LOG="$1" ;;
        --serial-log=*) SERIAL_LOG="${1#*=}" ;;
        --boot-timeout) shift; [ "$#" -gt 0 ] || { usage; exit 2; }; BOOT_TIMEOUT="$1" ;;
        --boot-timeout=*) BOOT_TIMEOUT="${1#*=}" ;;
        --test-net-fault-after-ready) TEST_NET_FAULT_AFTER_READY=true ;;
        --allow-prebuilt-artifact) ALLOW_PREBUILT_ARTIFACT=true ;;
        --help|-h) usage; exit 0 ;;
        *) echo "error: unknown option: $1" >&2; usage; exit 2 ;;
    esac
    shift
done

# A handoff proves only that kernel control reached PID1.  It cannot stand in
# for real userspace launch/readiness/crash/restart/revocation evidence.  Do
# not boot a marker-only QEMU lane while the runtime has no instrumentation.
# This preflight intentionally precedes artifact checks so an uninstrumented
# tree has exactly one actionable terminal status.
if ! runtime_lifecycle_instrumentation_present; then
    echo "EVIDENCE INSTRUMENTATION MISSING" >&2
    exit 1
fi

if [ "$TEST_NET_FAULT_AFTER_READY" != true ]; then
    echo "error: strict PID1 lifecycle evidence requires --test-net-fault-after-ready media" >&2
    exit 2
fi

[ -f "$ELF" ] || { echo "error: PID1 kernel missing: $ELF" >&2; exit 1; }
[ -s "$IMAGE" ] || { echo "error: PID1 catalogue media missing: $IMAGE" >&2; exit 1; }
command -v qemu-system-riscv64 >/dev/null 2>&1 || { echo "error: qemu-system-riscv64 is required" >&2; exit 1; }

if [ "$ALLOW_PREBUILT_ARTIFACT" = false ]; then
    STAMP="${ELF}.build_stamp"
    [ -f "$STAMP" ] || { echo "error: current-source RV64 build stamp missing: $STAMP" >&2; exit 1; }
    grep -qx 'entry=src/os/kernel/arch/riscv64/boot.spl' "$STAMP" || {
        echo "error: kernel stamp is not the os_main/PID1 RV64 boot entry: $STAMP" >&2
        exit 1
    }
    grep -qx 'target=riscv64-unknown-none' "$STAMP" || {
        echo "error: kernel stamp is not a freestanding RV64 target: $STAMP" >&2
        exit 1
    }
    [ "$STAMP" -nt "$ELF" ] || { echo "error: stale kernel build stamp: $STAMP" >&2; exit 1; }
fi

# The aliases are physical FAT names, intentionally independent of VFAT LFN.
for alias in 'INIT    SMF' 'VFS     SMF' 'NET     SMF' 'HTTP    SMF'; do
    grep -aFq "$alias" "$IMAGE" || {
        echo "error: PID1 catalogue FAT alias missing: $alias" >&2
        exit 1
    }
done
grep -aFq 'net-fault-after-ready' "$IMAGE" || {
    echo "error: test net-fault media sentinel missing: net-fault-after-ready" >&2
    exit 1
}

mkdir -p "$(dirname "$SERIAL_LOG")"
rm -f "$SERIAL_LOG"
QEMU_PID=""
cleanup() {
    if [ -n "$QEMU_PID" ]; then
        kill "$QEMU_PID" 2>/dev/null || true
        wait "$QEMU_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT HUP INT TERM

qemu-system-riscv64 \
    -machine virt \
    -cpu rv64 \
    -m 512M \
    -display none \
    -bios default \
    -monitor none \
    -chardev "file,id=pid1_uart,path=$SERIAL_LOG,append=off" \
    -serial chardev:pid1_uart \
    -drive "file=$IMAGE,if=none,id=pid1root,format=raw" \
    -device "nvme,drive=pid1root,serial=simpleos-pid1-root" \
    -netdev user,id=pid1net \
    -device virtio-net-pci,netdev=pid1net,disable-legacy=on \
    -kernel "$ELF" \
    </dev/null &
QEMU_PID=$!

waited=0
while [ "$waited" -lt "$BOOT_TIMEOUT" ]; do
    if [ -f "$SERIAL_LOG" ] && \
       grep -Fq '[os_main] Root filesystem mounted' "$SERIAL_LOG" && \
       grep -Fq '[os_main] PID1 prepared pid=' "$SERIAL_LOG" && \
       grep -Fq '[pid1] userspace handoff pid=' "$SERIAL_LOG" && \
       serial_has_required_lifecycle_evidence; then
        echo "PID1 SERVICE LIFECYCLE PASSED"
        exit 0
    fi
    sleep 1
    waited=$((waited + 1))
done

echo "error: required PID1 service lifecycle evidence not observed within ${BOOT_TIMEOUT}s" >&2
if [ -f "$SERIAL_LOG" ]; then
    tail -n "${SERIAL_TAIL_LINES:-200}" "$SERIAL_LOG" >&2
fi
exit 1
