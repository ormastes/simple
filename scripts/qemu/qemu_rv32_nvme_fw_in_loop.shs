#!/bin/sh
# External-host command parity for the resident RV32 firmware under QEMU.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
WORK="$ROOT/build/qemu/rv32_nvme_fw_in_loop"
FW_ELF="${FW_ELF:-}"
if [ -z "${SIMPLE_BINARY:-}" ]; then
  STAGE3="$ROOT/build/bootstrap/stage3/x86_64-unknown-linux-gnu"
  if [ -x "$STAGE3/simple" ] &&
     grep -qx 'status=pass' "$STAGE3/provenance.env" 2>/dev/null &&
     grep -qx 'artifact_kind=pure-simple-bootstrap-compiler' "$STAGE3/provenance.env" 2>/dev/null; then
    SIMPLE_BINARY="$STAGE3/simple"
  else
    SIMPLE_BINARY="$ROOT/bin/release/simple"
  fi
fi
GDB="${GDB:-gdb-multiarch}"
NM="${NM:-riscv64-unknown-elf-nm}"
PORT="${QEMU_GDB_PORT:-12346}"
MAILBOX=0x80100000
DATA=0x80200000
IDENTIFY=0x80240000
PAYLOAD=0xA5C35A7E

fail() { echo "STATUS: FAIL rv32-nvme-qemu-host-parity: $1" >&2; exit 1; }
for tool in qemu-system-riscv32 "$GDB" "$NM" sha256sum; do command -v "$tool" >/dev/null 2>&1 || fail "missing $tool"; done
cd "$ROOT"
if [ -z "$FW_ELF" ]; then
  [ -x "$SIMPLE_BINARY" ] || fail "missing pure-Simple runtime: $SIMPLE_BINARY"
  NVME_RV32_QEMU_HOST=1 NVME_RV32_SIMPLE_BIN="$SIMPLE_BINARY" \
    sh examples/09_embedded/simpleos_nvme_fw/fw_rv32/build.shs
  FW_ELF="$ROOT/build/nvme_fw_rv32_qemu_host.elf"
fi
[ -f "$FW_ELF" ] || fail "missing firmware: $FW_ELF"

nand_start_hex="$($NM -n "$FW_ELF" | awk '$3 == "_nandram_start" { print $1; exit }')"
nand_end_hex="$($NM -n "$FW_ELF" | awk '$3 == "_nandram_end" { print $1; exit }')"
entry="$($NM -n "$FW_ELF" | awk '$3 == "_rv32_direct_entry" { print $1; exit }')"
[ -n "$nand_start_hex" ] || fail "missing _nandram_start"
[ -n "$nand_end_hex" ] || fail "missing _nandram_end"
[ "$((0x$nand_end_hex - 0x$nand_start_hex))" -eq 256 ] ||
  fail "invalid .nandram size"
nand_start="0x$nand_start_hex"
[ "$entry" = "80000000" ] || fail "invalid entry: $entry"

mkdir -p "$WORK"
sha256sum "$FW_ELF" >"$WORK/firmware.sha256"
QEMU_LOG="$WORK/qemu.log"
rm -f "$QEMU_LOG"
qemu-system-riscv32 -machine virt -cpu rv32 -m 128M -nographic -bios none \
  -kernel "$FW_ELF" -gdb "tcp:127.0.0.1:$PORT" -serial none -monitor none \
  >"$QEMU_LOG" 2>&1 &
qemu_pid=$!
trap 'kill "$qemu_pid" 2>/dev/null || true; wait "$qemu_pid" 2>/dev/null || true' EXIT INT TERM

gdb_run() {
  body=$1
  kill -0 "$qemu_pid" 2>/dev/null || fail "QEMU exited before GDB operation"
  cmd="$WORK/gdb.cmd"
  {
    echo "set pagination off"
    echo "set confirm off"
    echo "target remote 127.0.0.1:$PORT"
    cat "$body"
    echo "detach"
    echo "quit"
  } >"$cmd"
  "$GDB" -q -nx -batch "$FW_ELF" -x "$cmd" 2>/dev/null
}

gdb_write_file() {
  body=$1
  tries=0
  while ! gdb_run "$body" >/dev/null 2>&1; do
    kill -0 "$qemu_pid" 2>/dev/null || fail "QEMU exited before GDB attach"
    tries=$((tries + 1)); [ "$tries" -lt 30 ] || fail "GDB attach timeout"
    sleep 0.05
  done
}

read_word() {
  addr=$(printf '0x%x' "$(($1))")
  body="$WORK/read.gdb"
  echo "x/wx $addr" >"$body"
  gdb_run "$body" | awk -v a="$addr:" '$1 == a { print $2; exit }'
}

write_words() {
  body="$WORK/write.gdb"
  : >"$body"
  while [ "$#" -gt 0 ]; do
    echo "set {unsigned int}$1 = $2" >>"$body"
    shift 2
  done
  gdb_write_file "$body"
}

submit() {
  label=$1 qid=$2 dw0=$3 dw1=$4 dw6=$5 dw10=$6 dw11=$7
  body="$WORK/submit.gdb"
  : >"$body"
  off=0
  while [ "$off" -le 100 ]; do
    printf 'set {unsigned int}0x%X = 0\n' "$((MAILBOX + off))" >>"$body"
    off=$((off + 4))
  done
  cat >>"$body" <<EOF
set {unsigned int}$((MAILBOX + 4)) = $qid
set {unsigned int}$((MAILBOX + 8)) = $dw0
set {unsigned int}$((MAILBOX + 12)) = $dw1
set {unsigned int}$((MAILBOX + 32)) = $dw6
set {unsigned int}$((MAILBOX + 48)) = $dw10
set {unsigned int}$((MAILBOX + 52)) = $dw11
set {unsigned int}$MAILBOX = 1
EOF
  gdb_write_file "$body"

  tries=0
  while [ "$(read_word 0x80100050)" != "0x00000001" ]; do
    kill -0 "$qemu_pid" 2>/dev/null || fail "$label: QEMU exited"
    tries=$((tries + 1)); [ "$tries" -lt 100 ] || fail "$label: completion timeout"
    sleep 0.01
  done
  status=$(read_word 0x8010004c)
  [ "$status" = "0x00000000" ] || fail "$label: status=$status"
  echo "QEMU_NVME_CMD_PASS label=$label cid=$(printf '0x%04X' $(((dw0 >> 16) & 65535)))"
}

# Wait for the GDB stub and initialize host buffers.
echo "set {unsigned int}$DATA = $PAYLOAD" >"$WORK/init.gdb"
gdb_write_file "$WORK/init.gdb"

submit create-cq 0 0x00010005 0 0x80210000 0x000F0001 0
submit create-sq 0 0x00020001 0 0x80220000 0x000F0001 0x00010000
submit identify 0 0x00030006 0 0x80240000 1 0
[ "$(read_word 0x80240000)" = "0x00010001" ] || fail "Identify word 0 mismatch"
[ "$(read_word 0x8024004c)" = "0x00000400" ] || fail "Identify word 19 mismatch"
submit write 1 0x00100001 1 "$DATA" 0 0
[ "$(read_word "$((nand_start + 8))")" = "0x00000001" ] || fail "Write did not leave NAND programmed"
[ "$(read_word "$((nand_start + 12))")" = "0xa5c35a7e" ] || fail "programmed NAND payload mismatch"
submit flush 1 0x00110000 1 0 0 0

write_words "$((nand_start + 16))" 116 "$((nand_start + 100))" 1
submit recovery-read 1 0x00120002 1 "$((DATA + 4))" 0 0
[ "$(read_word 0x80200004)" = "0xa5c35a7e" ] || fail "recovery payload mismatch"

submit prevent-read-1 1 0x00130002 1 "$((DATA + 8))" 0 0
submit prevent-read-2 1 0x00140002 1 "$((DATA + 12))" 0 0
submit prevent-read-3 1 0x00150002 1 "$((DATA + 16))" 0 0
submit prevent-read-4 1 0x00160002 1 "$((DATA + 20))" 0 0
for address in 0x80200008 0x8020000c 0x80200010 0x80200014; do
  [ "$(read_word "$address")" = "0xa5c35a7e" ] || fail "prevention payload mismatch at $address"
done

recovery=$(read_word "$((nand_start + 32))")
refresh=$(read_word "$((nand_start + 28))")
remap=$(read_word "$((nand_start + 96))")
reads=$(read_word "$((nand_start + 84))")
[ "$recovery" = "0x00000001" ] || fail "recovery count=$recovery"
[ "$refresh" = "0x00000002" ] || fail "refresh count=$refresh"
[ "$remap" = "0x00000001" ] || fail "remap count=$remap"
[ "$reads" = "0x00000004" ] || fail "read count=$reads"

echo "RV32_NVME_QEMU_HOST_PASS write=erase+program recovery=1 refresh=2 remap=1 reads=4"
echo "STATUS: PASS rv32-nvme-qemu-host-parity firmware=real transport=qemu-gdb-mailbox"
