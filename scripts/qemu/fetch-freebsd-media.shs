#!/bin/sh
# fetch-freebsd-media.shs — operator-only online supply for the FreeBSD QEMU
# base image. Downloads one VM-IMAGES qcow2 plus the release CHECKSUM.SHA256,
# verifies the digest, then hands the image to simple-freebsd-media.shs
# --supply (which stays offline-only).
#
#   sh scripts/qemu/fetch-freebsd-media.shs --list  ARCH   # names in CHECKSUM.SHA256
#   sh scripts/qemu/fetch-freebsd-media.shs --fetch ARCH   # download + verify + supply
#
# ARCH: amd64 | arm64 | riscv64. FREEBSD_VERSION defaults to the media checker's.
set -eu

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
FREEBSD_VERSION="${FREEBSD_VERSION:-14.4}"
MODE="${1:-}"; ARCH="${2:-}"
case "$ARCH" in
    amd64) DIR=amd64; NAME_ARCH=amd64 ;;
    arm64) DIR=aarch64; NAME_ARCH=arm64-aarch64 ;;
    riscv64) DIR=riscv64; NAME_ARCH=riscv-riscv64 ;;
    *) echo "usage: $0 --list|--fetch amd64|arm64|riscv64" >&2; exit 2 ;;
esac
BASE="https://download.freebsd.org/releases/VM-IMAGES/${FREEBSD_VERSION}-RELEASE/${DIR}/Latest"
# riscv64 has no BASIC-CLOUDINIT image (14.4); its guest is provisioned over
# the serial console instead (check-freebsd-bootstrap-qemu.shs).
VARIANT=BASIC-CLOUDINIT-ufs; [ "$ARCH" != riscv64 ] || VARIANT=ufs
NAME="FreeBSD-${FREEBSD_VERSION}-RELEASE-${NAME_ARCH}-${VARIANT}.qcow2"
WORK="${SIMPLE_BIG_STORAGE_ROOT:-${HOME}/.simple}/qemu/download/freebsd-${FREEBSD_VERSION}-${ARCH}"
mkdir -p "$WORK"

curl -fsSL --retry 3 -o "$WORK/CHECKSUM.SHA256" "$BASE/CHECKSUM.SHA256"
case "$MODE" in
    --list) sed -n 's/^SHA256 (\(.*\)) = .*/\1/p' "$WORK/CHECKSUM.SHA256"; exit 0 ;;
    --fetch) ;;
    *) echo "usage: $0 --list|--fetch amd64|arm64|riscv64" >&2; exit 2 ;;
esac

want_xz="$(sed -n "s/^SHA256 (${NAME}.xz) = //p" "$WORK/CHECKSUM.SHA256")"
[ -n "$want_xz" ] || { echo "error: ${NAME}.xz not listed in $BASE/CHECKSUM.SHA256" >&2; exit 1; }
curl -fL --retry 3 -o "$WORK/${NAME}.xz" "$BASE/${NAME}.xz"
got="$(sha256sum "$WORK/${NAME}.xz" | awk '{print $1}')"
[ "$got" = "$want_xz" ] || { rm -f "$WORK/${NAME}.xz"; echo "error: sha256 mismatch for ${NAME}.xz: got $got want $want_xz" >&2; exit 1; }
xz -dkf "$WORK/${NAME}.xz"
SIMPLE_FREEBSD_MEDIA_PATH="${SIMPLE_FREEBSD_MEDIA_PATH:-${SIMPLE_BIG_STORAGE_ROOT:-${HOME}/.simple}/qemu/images/freebsd/${NAME}}" \
    sh "$ROOT_DIR/scripts/qemu/simple-freebsd-media.shs" --supply "$WORK/$NAME" "$(sha256sum "$WORK/$NAME" | awk '{print $1}')"
rm -f "$WORK/${NAME}.xz" "$WORK/$NAME"
