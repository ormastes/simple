#!/bin/sh
# sweep-os-parse-errors.shs — parse every .spl under the given roots (default
# src/os) with the seed and report only PARSE-class failures, one line per file.
# Discovery in `native-build` aborts on the first bad file, so this sweep is how
# the whole population is enumerated in one pass instead of N build iterations.
# Output: build/os/entstore/parse_errors.txt (also summarised on stdout).
set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"
SEED="${SEED:-src/compiler_rust/target/release/simple}"
if [ ! -x "$SEED" ]; then
    for c in /mnt/data/worktrees/simple-main/src/compiler_rust/target/release/simple; do
        [ -x "$c" ] && SEED="$c" && break
    done
fi
[ -x "$SEED" ] || { echo "ERROR — nothing was checked: seed missing at $SEED"; exit 2; }
ROOTS="${*:-src/os}"
OUT=build/os/entstore/parse_errors.txt
TMP=build/os/entstore/parse_sweep
rm -rf "$TMP"; mkdir -p "$TMP" build/os/entstore
export SEED TMP
find $ROOTS -name '*.spl' -print0 \
  | xargs -0 -P 12 -n 1 sh -c '
      f="$1"
      msg=$(timeout 60 "$SEED" compile "$f" -o /dev/null 2>&1 \
            | grep -m1 -iE "failed to parse|Unexpected token|Lex error")
      [ -n "$msg" ] && printf "%s\t%s\n" "$f" "$msg" >> "$TMP/hits.txt"
      exit 0
    ' _
sort -u "$TMP/hits.txt" 2>/dev/null > "$OUT" || : > "$OUT"
N=$(find $ROOTS -name '*.spl' | wc -l)
K=$(wc -l < "$OUT")
echo "--- swept $N file(s) under: $ROOTS"
echo "--- parse-class failures: $K  (full list: $OUT)"
cut -f1 "$OUT"
echo "--- classes:"
cut -f2 "$OUT" | sed 's/[0-9][0-9]*/N/g' | sed 's#/[^ ]*\.spl#FILE#' | sort | uniq -c | sort -rn
