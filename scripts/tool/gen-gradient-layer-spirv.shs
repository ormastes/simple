#!/bin/sh
# gen-gradient-layer-spirv.shs -- regenerate backend_vulkan_gradient_layer_spirv.spl.
#
#   sh scripts/tool/gen-gradient-layer-spirv.shs
#
# Compiles shaders/gradient_layer.comp with glslangValidator and rewrites the
# generated Simple module in place. The .spv is a build intermediate and is NOT
# checked in; the word array plus its pinned sha256 are the artifact.
# `scripts/check/check-gradient-layer-spirv-pinned.shs` verifies the two agree.
set -eu

repo_root=$(cd "$(dirname "$0")/../.." && pwd)
comp="$repo_root/src/lib/gc_async_mut/gpu/engine2d/shaders/gradient_layer.comp"
out="$repo_root/src/lib/gc_async_mut/gpu/engine2d/backend_vulkan_gradient_layer_spirv.spl"
tmp="${TMPDIR:-/tmp}/gradient_layer_gen.$$"
mkdir -p "$tmp"
trap 'rm -rf "$tmp"' EXIT

glslang="${GLSLANG:-}"
if [ -z "$glslang" ]; then
    for cand in /opt/homebrew/bin/glslangValidator /usr/local/bin/glslangValidator \
                /usr/bin/glslangValidator; do
        [ -x "$cand" ] && glslang="$cand" && break
    done
fi
if [ -z "$glslang" ]; then
    glslang=$(command -v glslangValidator 2>/dev/null || true)
fi
if [ -z "$glslang" ]; then
    echo "ERROR: glslangValidator not found (set GLSLANG=/path/to/glslangValidator)" >&2
    exit 2
fi

"$glslang" -V --target-env vulkan1.1 -o "$tmp/gradient_layer.spv" "$comp" >"$tmp/log" 2>&1 || {
    echo "ERROR: glslangValidator failed:" >&2
    cat "$tmp/log" >&2
    exit 2
}

sh "$repo_root/scripts/tool/spirv-to-spl-words.shs" "$tmp/gradient_layer.spv" 8 > "$tmp/words"
sha_line=$(head -1 "$tmp/words")

{
cat <<'HDR'
# 2D Engine — Vulkan CSS gradient layer SPIR-V blob
#
# GENERATED — do not hand-edit. Regenerate with:
#   sh scripts/tool/gen-gradient-layer-spirv.shs
# which runs
#   glslangValidator -V --target-env vulkan1.1 \
#       -o gradient_layer.spv src/lib/gc_async_mut/gpu/engine2d/shaders/gradient_layer.comp
#   sh scripts/tool/spirv-to-spl-words.shs gradient_layer.spv 8
#
# The .spv is a build intermediate and is NOT checked in; the words below plus
# the pinned sha256 ARE the artifact.
# `sh scripts/check/check-gradient-layer-spirv-pinned.shs` recompiles the .comp and
# fails closed if these bytes no longer match it, so a shader edit that is not
# regenerated here cannot pass unnoticed.
#
# Source of truth for the layout:
#   src/lib/gc_async_mut/gpu/engine2d/shaders/gradient_layer.comp
# Frozen contract, restated so a reader of this file need not open the GLSL:
#   binding 0 = framebuffer uint[], index = y * fb_w + x (read only)
#   binding 1 = output uint[], w * h words at offset 0 (py * w + px), then the
#               host tables at tab_off: t_max, past-end colour, linear divisor,
#               linear shift, the 1025-word stop ramp, then the per-column
#               (col_off) and per-row (row_off) geometry terms. Disjoint from
#               the written region, so no barrier is required.
#   push constants (40 bytes): x0, y0, w, h, fb_w, fb_h, mode (0 radial,
#                              1 linear), tab_off, col_off, row_off
#   dispatch: 2D, ceil(w/16) x ceil(h/16) workgroups of 16x16
#   parity: t is the exact integer twin of radial_gradient_pixels() /
#           linear_gradient_pixels() in backend_emu.spl (32-bit only, no
#           shaderInt64); the composite is Chrome 159's layer rule.
HDR
echo "$sha_line"
cat <<'FN'

fn spirv_gradient_layer() -> [u8]:
    """Validated SPIR-V bytecode for the CSS gradient layer kernel.

    One dispatch evaluates and composites the whole layer into the binding-1 output
    buffer, which `_finish_image_composite` then copies into the framebuffer --
    no readback and no host pixel loop. See the module header for the frozen
    buffer and push-constant layout.
    """
    [
FN
tail -n +2 "$tmp/words"
echo "    ]"
} > "$out"

echo "wrote $out"
echo "$sha_line"
