#!/bin/sh
# clobber-census-e274cd33719.shs — for each missing symbol/field named by a B1
# lowering failure, report whether it EXISTED at the merge's mainline parent
# (`e274cd33719^1`) and is gone at HEAD. Present-then-gone == clobber, and the
# correct repair is restoration from that parent, not invention.
# Usage: clobber-census-e274cd33719.shs [name...]   (default: the B1 name set)
set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"
BASE="${CLOBBER_BASE:-e274cd33719^1}"
NAMES="${*:-recv_buf rekey_in_progress arm64_request_contexts cq_dma_handle session_id owned_payload_bytes filesystem_name has_entry_identity created_l2_phys mount_index executable_adoption_state NetSocketCreate _pin sockets}"
printf 'name\tHEAD_defs\tBASE_defs\tverdict\n'
for n in $NAMES; do
    h=$(git grep -c -w "$n" HEAD -- 'src/os/**/*.spl' 2>/dev/null | wc -l)
    b=$(git grep -c -w "$n" "$BASE" -- 'src/os/**/*.spl' 2>/dev/null | wc -l)
    if [ "$b" -gt "$h" ]; then v="CLOBBERED (base has $((b-h)) more file(s))"
    elif [ "$b" -eq "$h" ]; then v="unchanged file-count"
    else v="grew since base"; fi
    printf '%s\t%s\t%s\t%s\n' "$n" "$h" "$b" "$v"
done
