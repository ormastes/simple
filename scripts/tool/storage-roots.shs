#!/bin/sh

simple_tool_storage_init() {
    simple_tool_root=$1
    simple_tool_id=$2
    : "${SIMPLE_WORKTREE_STORAGE_ROOT:=$simple_tool_root/.simple/storage}"
    if [ -z "${SIMPLE_USER_STORAGE_ROOT:-}" ]; then
        case $(uname -s 2>/dev/null || printf unknown) in
            Darwin) SIMPLE_USER_STORAGE_ROOT=${HOME:?HOME is required}/Library/Caches/simple/storage ;;
            MINGW*|MSYS*|CYGWIN*) SIMPLE_USER_STORAGE_ROOT=${LOCALAPPDATA:?LOCALAPPDATA is required}/Simple/storage ;;
            *) SIMPLE_USER_STORAGE_ROOT=${XDG_CACHE_HOME:-${HOME:?HOME is required}/.cache}/simple/storage ;;
        esac
    fi
    export SIMPLE_USER_STORAGE_ROOT SIMPLE_WORKTREE_STORAGE_ROOT
    SIMPLE_TOOL_CACHE_ROOT=$SIMPLE_USER_STORAGE_ROOT/cache/tools/$simple_tool_id
    SIMPLE_TOOL_TMP_ROOT=$SIMPLE_WORKTREE_STORAGE_ROOT/tmp/tools/$simple_tool_id
    SIMPLE_TOOL_BUILD_ROOT=$SIMPLE_WORKTREE_STORAGE_ROOT/build/tools/$simple_tool_id
    export SIMPLE_TOOL_CACHE_ROOT SIMPLE_TOOL_TMP_ROOT SIMPLE_TOOL_BUILD_ROOT
}

simple_tool_mktemp_dir() {
    operation=$1
    mkdir -p "$SIMPLE_TOOL_TMP_ROOT/$operation"
    mktemp -d "$SIMPLE_TOOL_TMP_ROOT/$operation/session.XXXXXX"
}
