# Pure policy for riscv64-unknown-elf-tool-wrapper.spl: which MSYS2 tool to run
# and which clang-style flags to drop before handing the line to GNU gcc/g++.
# Split from the launcher so the argument rewriting is unit-testable without a
# toolchain. Ported from riscv64-unknown-elf-tool-wrapper.py.

val DEFAULT_TOOL_DIR = "C:/dev/tool/msys2/mingw64/bin"

pub fn tool_exe_name(kind: text) -> text:
    if kind == "gcc":
        return "riscv64-unknown-elf-gcc.exe"
    "riscv64-unknown-elf-g++.exe"

pub fn tool_override_env(kind: text) -> text:
    if kind == "gcc":
        return "SIMPLE_RISCV64_GCC"
    "SIMPLE_RISCV64_GXX"

# override (env value, "" when unset) wins; else the MSYS2 default when it
# exists; else the bare exe name for PATH lookup.
pub fn resolve_tool_path(kind: text, override: text, default_exists: bool) -> text:
    if override.len() > 0:
        return override
    if default_exists:
        return DEFAULT_TOOL_DIR + "/" + tool_exe_name(kind)
    tool_exe_name(kind)

pub fn default_tool_path(kind: text) -> text:
    DEFAULT_TOOL_DIR + "/" + tool_exe_name(kind)

# Drops `--target=riscv64-unknown-elf` and `-fuse-ld=lld` (case-insensitive) and
# a bare `--target` together with its value, as the Python original did. A
# trailing bare `--target` simply ends the list.
pub fn filtered_args(args: [text]) -> [text]:
    var out: [text] = []
    var i = 0
    while i < args.len():
        val lower = args[i].lower()
        if lower == "--target=riscv64-unknown-elf":
            i = i + 1
        elif lower == "--target":
            i = i + 2
        elif lower == "-fuse-ld=lld":
            i = i + 1
        else:
            out.push(args[i])
            i = i + 1
    out

pub fn is_tool_kind(kind: text) -> bool:
    kind == "gcc" or kind == "gxx"
