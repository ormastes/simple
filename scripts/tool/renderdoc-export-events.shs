#!/bin/sh
# Export a RenderDoc capture's event list to `<capture>.events.json`.
#
# The RenderDoc replay API is Python-only, so per CLAUDE.md's "ALL code in .spl/.shs"
# rule the ONLY Python here is the thin exporter
# scripts/tool/renderdoc-qrenderdoc-python-smoke.py (extended, not duplicated: that
# file keeps its original smoke behaviour when RDOC_EXPORT_RDC is unset). Every piece
# of logic that consumes the output - alignment, classification, verdicts - is pure
# Simple in src/app/ui/renderdoc_diff/.
#
# Schema: `renderdoc-events/v1`. Per event: eventId, name, type
# (draw/dispatch/copy/clear/present), pipeline (graphics/compute), shader hashes,
# viewport, scissor, bound render targets (id + dims + format), draw params (vertex /
# instance counts, or dispatch groups), and outputSha256 - the sha256 of the bound
# colour target saved as 8-bit RGBA PNG immediately after the event. With --thumbs each
# event additionally carries a 64x64 downsample as base64 RAW RGBA8 (thumbFormat
# "rgba8-64x64", 16384 bytes) - raw, not PNG, so the pure-Simple consumer needs no PNG
# decoder to compare pixels.
#
# Fail-closed: no renderdoccmd/qrenderdoc -> exit 2 with
# `renderdoc_status=blocked:renderdoccmd-missing`; a file whose first four bytes are
# not `RDOC` -> exit 1. Magic is checked FIRST so a malformed input is rejected even on
# a host that has no RenderDoc.
#
# UNVERIFIED ON THIS HOST (macOS, no RenderDoc): the replay-API half of the Python
# exporter has never executed here. The magic check, the missing-binary path, and the
# JSON schema are exercised by scripts/check/check-renderdoc-web-diff.shs --selftest.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
. "$ROOT_DIR/scripts/lib/renderdoc-evidence-common.shs"
cd "$ROOT_DIR"

CAPTURE=""
THUMBS=0
OUT=""

while [ $# -gt 0 ]; do
    case "$1" in
        --thumbs) THUMBS=1; shift ;;
        --out) OUT="$2"; shift 2 ;;
        -h|--help)
            echo "usage: renderdoc-export-events.shs <capture.rdc> [--thumbs] [--out <events.json>]" >&2
            exit 2
            ;;
        *) CAPTURE="$1"; shift ;;
    esac
done

if [ -z "$CAPTURE" ]; then
    echo "renderdoc_status=blocked:no-capture-argument" >&2
    echo "usage: renderdoc-export-events.shs <capture.rdc> [--thumbs] [--out <events.json>]" >&2
    exit 2
fi
if [ ! -f "$CAPTURE" ]; then
    echo "renderdoc_status=blocked:no-such-capture" >&2
    exit 2
fi

# --- magic first: a malformed capture is rejected even with no RenderDoc installed ---
MAGIC="$(dd if="$CAPTURE" bs=1 count=4 2>/dev/null || true)"
if [ "$MAGIC" != "RDOC" ]; then
    echo "renderdoc_status=bad-magic" >&2
    echo "FAIL — $CAPTURE does not start with the RDOC capture magic (saw '$MAGIC')" >&2
    exit 1
fi

if [ -z "$OUT" ]; then
    OUT="${CAPTURE}.events.json"
fi

# --- locate a RenderDoc replay host --------------------------------------------
RENDERDOC_HOME="$(rdoc_find_renderdoc_home "$ROOT_DIR" || true)"
RENDERDOCCMD=""
if [ "${RDOC_FORCE_NO_RENDERDOCCMD:-0}" != "1" ]; then
    for candidate in \
        "${RENDERDOCCMD_BIN:-}" \
        "$RENDERDOC_HOME/bin/renderdoccmd" \
        "$RENDERDOC_HOME/renderdoccmd"
    do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            RENDERDOCCMD="$candidate"
            break
        fi
    done
    if [ -z "$RENDERDOCCMD" ]; then
        RENDERDOCCMD="$(command -v renderdoccmd 2>/dev/null || true)"
    fi
    if [ -z "$RENDERDOCCMD" ]; then
        RENDERDOCCMD="$(command -v qrenderdoc 2>/dev/null || true)"
    fi
fi

if [ -z "$RENDERDOCCMD" ]; then
    echo "renderdoc_status=blocked:renderdoccmd-missing"
    echo "ERROR — no renderdoccmd/qrenderdoc on PATH or under RENDERDOC_HOME; build one with scripts/setup/build-renderdoc-linux-vulkan-only.shs" >&2
    exit 2
fi

EXPORTER="$ROOT_DIR/scripts/tool/renderdoc-qrenderdoc-python-smoke.py"
if [ ! -f "$EXPORTER" ]; then
    echo "renderdoc_status=blocked:exporter-missing"
    exit 2
fi

RDOC_EXPORT_THUMBS="$THUMBS"
export RDOC_EXPORT_RDC="$CAPTURE"
export RDOC_EXPORT_OUT="$OUT"
export RDOC_EXPORT_THUMBS

case "$RENDERDOCCMD" in
    *qrenderdoc*) set -- "$RENDERDOCCMD" --python "$EXPORTER" ;;
    *)            set -- "$RENDERDOCCMD" python "$EXPORTER" ;;
esac

set +e
"$@" >"${OUT}.export.log" 2>&1
EXPORT_RC=$?
set -e

if [ "$EXPORT_RC" != "0" ]; then
    echo "renderdoc_status=blocked:export-failed"
    echo "ERROR — replay export exited $EXPORT_RC; see ${OUT}.export.log" >&2
    exit 2
fi
if [ ! -s "$OUT" ]; then
    echo "renderdoc_status=blocked:empty-export"
    echo "ERROR — nothing was checked (exporter wrote no events to $OUT)" >&2
    exit 2
fi

echo "renderdoc_status=exported"
echo "renderdoc_events_json=$OUT"
exit 0
