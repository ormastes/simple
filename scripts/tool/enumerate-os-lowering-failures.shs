#!/bin/sh
# enumerate-os-lowering-failures.shs — build the SimpleOS entstore kernel and
# report every src/os module that fails HIR lowering, grouped by error class.
# The full build log is written to build/os/entstore/lowering.log, never stdout.
set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"
SEED="${SEED:-src/compiler_rust/target/release/simple}"
# In an agent worktree the Rust seed lives in the shared checkout; fall back to it.
if [ ! -x "$SEED" ]; then
    for c in /mnt/data/worktrees/simple-main/src/compiler_rust/target/release/simple; do
        [ -x "$c" ] && SEED="$c" && break
    done
fi
[ -x "$SEED" ] || { echo "ERROR — nothing was checked: seed missing at $SEED"; exit 2; }
echo "--- seed=$SEED"
ENTRY="examples/09_embedded/simple_os/arch/x86_64/ssh_ring3_clang_entry.spl"
LINKER="examples/09_embedded/simple_os/arch/x86_64/linker_128mb.ld"
KERNEL="build/os/simpleos_entstore_uefi128.elf"
CACHE="build/os/entstore/cache"
LOG="build/os/entstore/lowering.log"
mkdir -p build/os/generated build/os/entstore
printf 'pub fn ssh_live_build_marker() -> text:\n    "ssh-ring3-build:entstore-uefi-128"\n' \
    > build/os/generated/ssh_live_build_marker.spl
OBJCOPY_PREFIX=""
for d in /usr/lib/llvm-20/bin /usr/lib/llvm-19/bin /usr/lib/llvm-18/bin; do
    [ -f "$d/llvm-objcopy" ] && OBJCOPY_PREFIX="$d" && break
done
rm -rf "$CACHE"; mkdir -p "$CACHE"; rm -f "$KERNEL"
SIMPLE_BOOTSTRAP=1 SIMPLE_LIB="$ROOT/src" SIMPLE_OS_LOG_MODE=off SIMPLE_ALLOW_FREESTANDING_STUBS=1 \
PATH="${OBJCOPY_PREFIX:+$OBJCOPY_PREFIX:}$PATH" \
    "$SEED" native-build --source build/os/generated --source src/os --source src/lib \
    --source examples/09_embedded/simple_os --backend cranelift --cpu x86-64-v1 \
    --opt-level=aggressive --log off --entry-closure --cache-dir "$CACHE" \
    --entry "$ENTRY" --target x86_64-unknown-none -o "$KERNEL" \
    --linker-script "$LINKER" --timeout "${MODULE_TIMEOUT:-1200}" > "$LOG" 2>&1
RC=$?
echo "--- build rc=$RC log=$LOG lines=$(wc -l < "$LOG")"
# The "FAILED FILES (n)" block is the authoritative per-module verdict list.
sed -n '/^FAILED FILES/,$p' "$LOG" | sed -n 's#^  - .*/src/\(.*\.spl\) => .*: \(hir\|mir\|codegen\|timeout\)\(.*\)$#src/\1\t\2\3#p' \
    | sed 's/([0-9]*s)/(Ns)/' | sort -u > build/os/entstore/failed_modules.txt
echo "--- failing modules: $(cut -f1 build/os/entstore/failed_modules.txt | sort -u | wc -l)"
echo "--- by class:"
cut -f2- build/os/entstore/failed_modules.txt \
  | sed "s/while lowering [^:]*:/while lowering F:/" \
  | sed "s/\[[^]]*\]/[F]/" | sed "s/'[^']*'/'X'/g" \
  | sort | uniq -c | sort -rn
echo "--- detail: build/os/entstore/failed_modules.txt"
cat build/os/entstore/failed_modules.txt
if [ -f "$KERNEL" ]; then
  echo "PASS — kernel built ($(stat -c%s "$KERNEL") bytes)"
else
  echo "FAIL — no kernel produced"
fi
