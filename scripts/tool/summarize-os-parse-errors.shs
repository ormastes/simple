#!/bin/sh
# summarize-os-parse-errors.shs — reduce scripts/tool/sweep-os-parse-errors.shs output to the
# set of DISTINCT OFFENDING files (the path named inside the parse message, not
# the file that happened to import it) grouped by error class.
set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT"
IN="${1:-build/os/entstore/parse_errors.txt}"
[ -s "$IN" ] || { echo "ERROR — nothing was checked: $IN empty/missing"; exit 2; }
OUT=build/os/entstore/parse_offenders.txt
# message form:  parse: in "<abs path>": <reason>
sed -n 's#.*parse: in "\([^"]*\)": \(.*\)$#\1\t\2#p' "$IN" \
  | sed "s#^$ROOT/##" | sort -u > "$OUT"
echo "--- distinct offending files: $(cut -f1 "$OUT" | sort -u | wc -l)  (detail: $OUT)"
echo "--- by class:"
cut -f2 "$OUT" | sed 's/{ name: "[^"]*"/{ name: X/' | sort | uniq -c | sort -rn
echo "--- offenders:"
cut -f1 "$OUT" | sort -u
