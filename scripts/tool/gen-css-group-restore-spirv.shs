#!/bin/sh
# gen-css-group-restore-spirv.shs -- regenerate backend_vulkan_css_group_restore_spirv.spl.
#
#   sh scripts/tool/gen-css-group-restore-spirv.shs
#
# Compiles shaders/css_group_restore.comp with glslangValidator and rewrites the
# generated Simple module in place. The .spv is a build intermediate and is NOT
# checked in; the word array plus its pinned sha256 are the artifact.
# `scripts/check/check-css-group-restore-spirv-pinned.shs` verifies the two agree.
set -eu

repo_root=$(cd "$(dirname "$0")/../.." && pwd)
comp="$repo_root/src/lib/gc_async_mut/gpu/engine2d/shaders/css_group_restore.comp"
out="$repo_root/src/lib/gc_async_mut/gpu/engine2d/backend_vulkan_css_group_restore_spirv.spl"
tmp="${TMPDIR:-/tmp}/css_group_restore_gen.$$"
mkdir -p "$tmp"
trap 'rm -rf "$tmp"' EXIT

glslang="${GLSLANG:-}"
if [ -z "$glslang" ]; then
    for cand in /opt/homebrew/bin/glslangValidator /usr/local/bin/glslangValidator \
                /usr/bin/glslangValidator; do
        [ -x "$cand" ] && glslang="$cand" && break
    done
fi
if [ -z "$glslang" ]; then
    glslang=$(command -v glslangValidator 2>/dev/null || true)
fi
if [ -z "$glslang" ]; then
    echo "ERROR: glslangValidator not found (set GLSLANG=/path/to/glslangValidator)" >&2
    exit 2
fi

"$glslang" -V --target-env vulkan1.1 -o "$tmp/css_group_restore.spv" "$comp" >"$tmp/log" 2>&1 || {
    echo "ERROR: glslangValidator failed:" >&2
    cat "$tmp/log" >&2
    exit 2
}

sh "$repo_root/scripts/tool/spirv-to-spl-words.shs" "$tmp/css_group_restore.spv" 8 > "$tmp/words"
sha_line=$(head -1 "$tmp/words")

{
cat <<'HDR'
# 2D Engine — Vulkan CSS opacity group restore SPIR-V blob
#
# GENERATED — do not hand-edit. Regenerate with:
#   sh scripts/tool/gen-css-group-restore-spirv.shs
# which runs
#   glslangValidator -V --target-env vulkan1.1 \
#       -o css_group_restore.spv src/lib/gc_async_mut/gpu/engine2d/shaders/css_group_restore.comp
#   sh scripts/tool/spirv-to-spl-words.shs css_group_restore.spv 8
#
# The .spv is a build intermediate and is NOT checked in; the words below plus
# the pinned sha256 ARE the artifact.
# `sh scripts/check/check-css-group-restore-spirv-pinned.shs` recompiles the .comp and
# fails closed if these bytes no longer match it, so a shader edit that is not
# regenerated here cannot pass unnoticed.
#
# Source of truth for the layout:
#   src/lib/gc_async_mut/gpu/engine2d/shaders/css_group_restore.comp
# Frozen contract, restated so a reader of this file need not open the GLSL:
#   binding 0 = framebuffer uint[], index = y * fb_w + x (read + written in
#               place; one framebuffer word per thread)
#   binding 1 = group layer uint[], w * h straight-alpha words (ly * w + lx),
#               the offscreen surface the group subtree was rendered into
#   push constants (28 bytes): x0, y0, w, h, fb_w, fb_h, alpha8
#   dispatch: 2D, ceil(w/16) x ceil(h/16) workgroups of 16x16
#   parity: exact integer twin of css_opacity_group_composite_pixel() in
#           css_opacity_group.spl (Chrome 159 SkBlendARGB32 restore)
HDR
echo "$sha_line"
cat <<'FN'

fn spirv_css_group_restore() -> [u8]:
    """Validated SPIR-V bytecode for the CSS opacity group restore kernel.

    One dispatch restores the whole group layer (binding 1) onto the
    framebuffer (binding 0) in place -- no readback, no upload and no host
    pixel loop. See the module header for the frozen
    buffer and push-constant layout.
    """
    [
FN
tail -n +2 "$tmp/words"
echo "    ]"
} > "$out"

echo "wrote $out"
echo "$sha_line"
