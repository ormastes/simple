#!/bin/sh
# Serialize primitive Engine2D observations into mci-rendering-raw-v1.
set -eu
usage() { echo "usage: $0 SOURCE_DIR OUTPUT_DIR" >&2; exit 2; }
[ "$#" -eq 2 ] || usage; source_dir=$1; out=$2
fail() { echo "BLOCKED: $1" >&2; exit 1; }; regular() { [ -f "$1" ] && [ ! -L "$1" ]; }
names='packed.events packed.identity composition.bin gui.drawir web.drawir cpu.rgba device.rgba backend.env queue.env frame.rdc replay.log allocation.events queue.events inflight.events overflow.before overflow.after fallback.events drawir.entries transient-owner.env interaction.events perf.samples rss.bytes'
for name in $names; do regular "$source_dir/$name" || fail "probe primitive missing: $name"; done
# Reject semantic verdicts. This boundary accepts observations/counters only;
# the signed adapter owns every comparison and pass/fail decision.
if grep -E -n '(^|[._])(pass|fail|valid|matches|accepted|rejected|ready|eligible)=' "$source_dir"/*.env "$source_dir"/*.events 2>/dev/null; then
 fail 'probe attempted to self-attest a semantic verdict'
fi
mkdir -p "$out"; chmod 0700 "$out"
for name in $names; do cp -- "$source_dir/$name" "$out/$name"; done
printf 'raw_vocabulary_schema=mci-rendering-raw-v1\n' > "$out/schema.env"
