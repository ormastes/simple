#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/80.driver/driver_source_pipeline_parsing.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

raws="exit stdout_flush env_get env_set transient_array_scope_begin transient_array_scope_pause transient_array_scope_end"
for suffix in $raws; do
    raw="rt_$suffix"
    owner="_sffi_$suffix"
    [ "$(grep -Ec "^extern fn ${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^fn ${owner}\\(" "$module")" -eq 1 ]
    grep -q "insert_simple!(\"$raw\"" "$interpreter"
done

for raw in rt_exit rt_env_get rt_env_set rt_transient_array_scope_begin \
    rt_transient_array_scope_pause rt_transient_array_scope_end; do
    grep -q "RuntimeFuncSpec::new(\"$raw\"" "$registry"
done
# stdout flush currently lacks typed-native registry coverage; do not promote
# this boundary to verified merely because the interpreter registers it.
! grep -q 'RuntimeFuncSpec::new("rt_stdout_flush"' "$registry"

grep -q '^extern fn rt_env_get(key: text) -> text?$' "$module"
grep -q '^extern fn rt_env_set(key: text, value: text) -> bool$' "$module"
grep -q '^fn _driver_publish_frontend_cache_scope() -> bool:$' "$module"
[ "$(grep -c '^@unsafe(' "$module")" -eq 7 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 7 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 7 ]

for expected in exit:3 stdout_flush:3 env_get:16 env_set:2 \
    transient_array_scope_begin:3 transient_array_scope_pause:6 \
    transient_array_scope_end:7; do
    suffix=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "_sffi_${suffix}(" "$module" | wc -l)" -eq "$count" ]
done

# Parsing loops retain their existing operations. Authority wrappers must be
# eliminated at codegen rather than adding per-source dispatch or allocation.
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "driver source-parsing SFFI authority audit: PASS (7 raw ABIs confined; env mutation status preserved; transient status remains checked; stdout native coverage remains unverified)"
