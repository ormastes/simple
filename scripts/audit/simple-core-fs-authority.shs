#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/runtime/simple_core/core_fs.spl"
cranelift="$root/src/compiler_rust/compiler/src/codegen/instr/calls.rs"
llvm="$root/src/compiler_rust/compiler/src/codegen/llvm/functions/calls.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in free fclose close rt_string_new spl_load_u8 spl_store_u8 \
    malloc fopen open rt_string_data rt_string_len lseek strlen fread fwrite \
    ferror fseek ftell read write fsync mmap munmap mkdir opendir readdir \
    closedir rename remove rt_array_new rt_array_push rt_byte_array_new_len \
    spl_load_i64 spl_store_i64; do
    if [ "$(grep -Ec "(^|[^A-Za-z0-9_])${raw}\\(" "$module")" -ne 2 ]; then
        echo "simple-core filesystem call escaped its mandatory-inline owner: $raw" >&2
        exit 1
    fi
done

[ "$(grep -c '^@always_inline$' "$module")" -eq 34 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi, raw_ptr\]):' "$module")" -eq 27 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 7 ]

for expected in _sffi_free:52 _sffi_fclose:12 _sffi_close:12 \
    _sffi_rt_string_new:17 _sffi_load_u8:15 _sffi_store_u8:20; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done
for expected in _sffi_strlen:2 _sffi_fread:3 _sffi_fwrite:4 \
    _sffi_ferror:2 _sffi_fseek:3 _sffi_ftell:2 _sffi_read:3 _sffi_write:2 \
    _sffi_fsync:2 _sffi_mmap:2 _sffi_munmap:2 _sffi_mkdir:4 \
    _sffi_opendir:3 _sffi_readdir:3 _sffi_closedir:4 _sffi_rename:2 \
    _sffi_remove:3 _sffi_rt_array_new:2 _sffi_rt_array_push:2 \
    _sffi_rt_byte_array_new_len:2 _sffi_load_i64:2 _sffi_store_i64:2; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done
for expected in _sffi_malloc:10 _sffi_fopen:8 _sffi_open:6 \
    _sffi_rt_string_data:8 _sffi_rt_string_len:7 _sffi_lseek:7; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done

for intrinsic in spl_load_u8 spl_store_u8 spl_load_i64 spl_store_i64; do
    grep -q "\"$intrinsic\"" "$cranelift"
    grep -q "\"$intrinsic\"" "$llvm"
done
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "simple-core filesystem authority audit: PASS (all 34 raw operations have mandatory-inline minimal owners)"
