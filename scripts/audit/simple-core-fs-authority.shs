#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/runtime/simple_core/core_fs.spl"
cranelift="$root/src/compiler_rust/compiler/src/codegen/instr/calls.rs"
llvm="$root/src/compiler_rust/compiler/src/codegen/llvm/functions/calls.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in free fclose close rt_string_new spl_load_u8 spl_store_u8 \
    malloc fopen open rt_string_data rt_string_len lseek strlen fread fwrite \
    ferror fseek ftell read write fsync mmap munmap mkdir opendir readdir \
    closedir rename remove rmdir stat lstat rt_array_new rt_array_push rt_byte_array_new_len \
    spl_load_i64 spl_store_i64; do
    if [ "$(grep -Ec "(^|[^A-Za-z0-9_])${raw}\\(" "$module")" -ne 2 ]; then
        echo "simple-core filesystem call escaped its mandatory-inline owner: $raw" >&2
        exit 1
    fi
done

[ "$(grep -c '^@always_inline$' "$module")" -eq 37 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi, raw_ptr\]):' "$module")" -eq 30 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 7 ]

# Keep the boundary audit focused on its invariant: every raw operation has
# one mandatory-inline owner and is actually used by the Pure-Simple provider.
# Exact total call counts were brittle bookkeeping, not an ownership proof.
for owner in _sffi_free _sffi_fclose _sffi_close _sffi_rt_string_new \
    _sffi_load_u8 _sffi_store_u8 _sffi_malloc _sffi_fopen _sffi_open \
    _sffi_rt_string_data _sffi_rt_string_len _sffi_lseek _sffi_strlen \
    _sffi_fread _sffi_fwrite _sffi_ferror _sffi_fseek _sffi_ftell \
    _sffi_read _sffi_write _sffi_fsync _sffi_mmap _sffi_munmap _sffi_mkdir \
    _sffi_opendir _sffi_readdir _sffi_closedir _sffi_rename _sffi_remove \
    _sffi_rmdir _sffi_stat _sffi_lstat _sffi_rt_array_new _sffi_rt_array_push \
    _sffi_rt_byte_array_new_len _sffi_load_i64 _sffi_store_i64; do
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -ge 2 ]
done

for intrinsic in spl_load_u8 spl_store_u8 spl_load_i64 spl_store_i64; do
    grep -q "\"$intrinsic\"" "$cranelift"
    grep -q "\"$intrinsic\"" "$llvm"
done
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "simple-core filesystem authority audit: PASS (all 37 raw operations have mandatory-inline minimal owners)"
