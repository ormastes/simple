#!/bin/sh
# Static raw-file-read elimination guard for the quick C-codegen sample.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/app/compile/test_codegen_quick.spl"

test "$(grep -c '^extern fn rt_file_read_text' "$module")" -eq 0
test "$(grep -c '^use std.io_runtime.{read_file_text_result}$' "$module")" -eq 1
test "$(grep -c 'read_file_text_result("examples/native_v2_test.spl")' "$module")" -eq 1
test "$(grep -c 'case Err(error):' "$module")" -eq 1
test "$(grep -c 'generate_c_code(source)' "$module")" -eq 1

echo 'Quick codegen file-read authority: PASS local_raw_declarations=0 result_lifts=1 codegen_calls=1 fabricated_empty_source=absent artifact_admission=absent'
