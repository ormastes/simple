#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/lib/nogc_sync_mut/ui/gui_renderer.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^@unsafe(reason:' "$module")" -eq 4 ]
[ "$(grep -c '^    @unsafe(reason:' "$module")" -eq 9 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 1 ]
[ "$(grep -c '_gui_frame_extent_valid(' "$module")" -eq 4 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi, raw_ptr\]):' "$module")" -eq 1 ]

call_count=$(perl -0ne '
    s/#.*//mg;
    s/^extern fn .*\n//mg;
    while (/\b(?:spl_wffi_call_i64|spl_str_ptr|spl_dlclose|rt_ptr_write_i(?:32|64))\s*\(/g) { $count++ }
    END { print $count + 0 }
' "$module")
[ "$call_count" -eq 36 ]

for symbol in rt_ptr_write_i32 rt_ptr_write_i64 spl_dlclose spl_wffi_call_i64; do
    grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry"
    grep -q "insert_simple!(\"$symbol\"" "$interpreter"
done
providers=0
grep -q 'RuntimeFuncSpec::new("spl_str_ptr"' "$registry" && providers=$((providers + 1))
grep -q 'insert_simple!("spl_str_ptr"' "$interpreter" && providers=$((providers + 1))
[ "$providers" -eq 1 ]

grep -q 'pixel_count % w == 0 and pixel_count / w == h' "$module"
grep -q 'val packed = pixels\[i\] + pixels\[i + 1\] \* 4294967296' "$module"
grep -q 'pressed: kp == 1' "$module"
grep -q 'pressed: mp == 1' "$module"

echo "GUI renderer SFFI authority audit: PASS (36 calls/5 symbols; 4 unsafe declarations + 9 raw provider/object owners; 4 both/1 one/0 no-provider; O(1) exact frame extent validation added before staging; packed two-pixel writes and semantic bool retained)"
