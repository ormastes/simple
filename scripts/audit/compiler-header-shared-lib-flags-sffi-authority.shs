#!/bin/sh
set -eu

module=src/compiler/90.tools/header_gen/shared_lib_flags.spl
facade=src/lib/nogc_sync_mut/io_runtime.spl

if rg -q '^extern fn rt_env_get|rt_env_get\(' "$module"; then
    echo "shared-library flags must use the canonical environment facade" >&2
    exit 1
fi

test "$(rg -c '^use std\.io_runtime\.\{env_get_opt, process_run\}' "$module")" -eq 1
test "$(rg -c 'env_get_opt\(key\)' "$module")" -eq 1
test "$(rg -c 'env_get\("(MSYSTEM|SIMPLE_LINKER_FLAVOR)"\)' "$module")" -eq 2
rg -Uq '@always_inline\npub fn env_get_opt\(key: text\) -> text\?:' "$facade"
