#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/99.loader/loader/object_mapper.spl"

[ "$(grep -c 'unsafe(capabilities: \[raw_ptr\]):' "$module")" -eq 12 ]

# Mapping lifecycle stays linear: one allocation, one bulk write, one RX
# transition, and one function-address lift on the successful map path.
[ "$(grep -o 'native_write_exec_memory(' "$module" | wc -l)" -eq 1 ]
[ "$(grep -o 'native_make_executable(' "$module" | wc -l)" -eq 1 ]
[ "$(grep -o 'native_get_function_pointer(' "$module" | wc -l)" -eq 1 ]

# Relocations validate the entire 4/8-byte write and address addition before
# entering raw-pointer authority. A first-byte-only check is insufficient.
grep -q 'val write_width = if reloc.reloc_type == 1: 8 else: 4' "$module"
grep -q 'reloc.offset > code_size - write_width' "$module"
grep -q 'code_addr > 0x7FFFFFFFFFFFFFFF - reloc.offset' "$module"
[ "$(grep -o 'native_reloc_write_i32(' "$module" | wc -l)" -eq 4 ]
[ "$(grep -o 'native_reloc_write_i64(' "$module" | wc -l)" -eq 1 ]

echo "Shared executable mapper raw-pointer audit: PASS (12 minimal authority blocks; full-width relocation bounds; linear mapping hot path retained)"
