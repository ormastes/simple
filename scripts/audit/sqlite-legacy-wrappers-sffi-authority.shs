#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"
files="
$root/src/lib/nogc_sync_mut/io/sqlite_sffi.spl
$root/src/app/io/sqlite_sffi.spl
$root/src/app/io/sqlite_ffi.spl
"

for module in $files; do
    [ "$(grep -c '^extern fn ' "$module")" -eq 27 ]
    [ "$(grep -c '^@unsafe(reason:' "$module")" -eq 51 ]
    [ "$(grep -c 'legacy SQLite wrapper exposes unverified raw handles' "$module")" -eq 24 ]
    [ "$(grep -c '^@always_inline$' "$module" || true)" -eq 0 ]

    call_count=$(perl -0ne '
        s/""".*?"""//sg; s/#.*//mg; s/^\s*extern fn .*\n//mg;
        while (/\brt_sqlite_[a-z_]+\s*\(/g) { $n++ }
        END { print $n + 0 }
    ' "$module")
    [ "$call_count" -eq 26 ]

    grep -q '^fn sqlite_open(path: text) -> SqliteConnection:' "$module"
    grep -q '^fn sqlite_close(conn: SqliteConnection) -> bool:' "$module"
    grep -q '^fn sqlite_query_all(conn: SqliteConnection, sql: text) -> \[SqliteRow\]:' "$module"
    grep -q '^fn sqlite_error_message(conn: SqliteConnection) -> text:' "$module"
    grep -q '^fn sqlite_row_get(row: SqliteRow, column: text) -> text:' "$module"
done

symbols=$(awk '/^extern fn /{name=$3; sub(/\(.*/, "", name); used[name]=1}
    END {for (name in used) print name}' \
    "$root/src/lib/nogc_sync_mut/io/sqlite_sffi.spl")
for symbol in $symbols; do
    ! grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry"
    grep -q "insert_simple!(\"$symbol\"" "$interpreter"
done

echo "Legacy SQLite wrapper SFFI authority audit: PASS (3 mirrors; 78 calls/24 used symbols; 27 unsafe declarations + 24 unsafe wrapper owners each; 0 typed-native/27 interpreter registrations; API/semantic bools unchanged; no forced inlining)"
