#!/bin/sh
# Keep raw interpreter error handles in the canonical SFFI owner.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/sffi/error.spl"
compat="$root/src/lib/nogc_sync_mut/ffi/error.spl"
provider="$root/src/compiler_rust/compiler/src/interpreter_extern/error_sffi.rs"

declarations=$(grep -c '^extern fn rt_error_' "$owner")
if [ "$declarations" -ne 9 ]; then
    echo 'canonical error SFFI declaration inventory changed without contract review' >&2
    exit 1
fi

tagged=$(awk '
    /^@unsafe\(.*capabilities: \[ffi\]\)$/ { previous_is_ffi = 1; next }
    /^extern fn rt_error_/ { if (previous_is_ffi) tagged += 1 }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$owner")
if [ "$tagged" -ne "$declarations" ]; then
    echo 'canonical error SFFI declaration lacks unsafe(ffi)' >&2
    exit 1
fi

calls=$(awk '
    !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / {
        line = $0
        while (match(line, /rt_error_[A-Za-z0-9_]+[(]/)) {
            calls += 1
            line = substr(line, RSTART + RLENGTH)
        }
    }
    END { print calls + 0 }
' "$owner")
if [ "$calls" -ne 9 ]; then
    echo 'canonical error raw-call inventory changed without contract review' >&2
    exit 1
fi

awk '
    function indent(line, copy) {
        copy = line
        sub(/[^ ].*$/, "", copy)
        return length(copy)
    }
    NF && unsafe_indent >= 0 &&
    $0 !~ /unsafe\(capabilities: \[ffi\]\):$/ && indent($0) <= unsafe_indent {
        unsafe_indent = -1
    }
    /unsafe\(capabilities: \[ffi\]\):$/ {
        unsafe_indent = indent($0)
        next
    }
    !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / && /rt_error_[A-Za-z0-9_]+[(]/ {
        if (unsafe_indent < 0 || indent($0) <= unsafe_indent) {
            print "error SFFI raw call lacks lexical FFI authority: " NR ":" $0 > "/dev/stderr"
            failed = 1
        }
    }
    BEGIN { unsafe_indent = -1 }
    END { if (failed) exit 1 }
' "$owner"

if grep -q '^extern fn rt_error_' "$compat"; then
    echo 'error compatibility facade duplicates raw declarations' >&2
    exit 1
fi
grep -q '^export use std\.nogc_sync_mut\.sffi\.error\.{' "$compat"

for symbol in semantic type_mismatch undefined_var arg_count division_by_zero index_oob throw message free; do
    grep -q "fn rt_error_${symbol}" "$provider"
done

echo 'error SFFI owner authority: PASS (9 canonical unsafe raw calls; compatibility facade has no raw declarations)'
