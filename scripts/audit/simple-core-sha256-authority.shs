#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/runtime/simple_core/core_sha256.spl"
fs="$root/src/runtime/simple_core/core_fs.spl"
array_ops="$root/src/runtime/simple_core/core_array_ops.spl"
cranelift="$root/src/compiler_rust/compiler/src/codegen/instr/calls.rs"
llvm="$root/src/compiler_rust/compiler/src/codegen/llvm/functions/calls.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in malloc free open read close lseek spl_load_u8 spl_store_u8 \
    rt_string_new fs_copy_cstr rt_array_free; do
    if [ "$(grep -Ec "(^|[^A-Za-z0-9_])${raw}\\(" "$module")" -ne 2 ]; then
        echo "simple-core SHA-256 call escaped its mandatory-inline owner: $raw" >&2
        exit 1
    fi
done

[ "$(grep -c '^@unsafe(' "$module")" -eq 11 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 11 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi, raw_ptr\]):' "$module")" -eq 8 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 3 ]
for expected in _sffi_malloc:3 _sffi_free:6 _sffi_open:2 _sffi_read:2 \
    _sffi_close:6 _sffi_lseek:3 _sffi_load_u8:2 _sffi_store_u8:2 \
    _sffi_rt_string_new:2 _sffi_fs_copy_cstr:2 _sffi_rt_array_free:4; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done

grep -q 'if _sffi_lseek(fd, 0, 0) < 0:' "$module"
grep -q 'if _sffi_close(fd) < 0:' "$module"
grep -Eq '^fn fs_copy_cstr\(' "$fs"
grep -Eq '^pub fn rt_array_free\(' "$array_ops"
for intrinsic in spl_load_u8 spl_store_u8; do
    grep -q "\"$intrinsic\"" "$cranelift"
    grep -q "\"$intrinsic\"" "$llvm"
done
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "simple-core SHA-256 authority audit: PASS (all calls confined; rewind/close failures reject the digest)"
