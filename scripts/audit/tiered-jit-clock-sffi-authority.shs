#!/bin/sh
# Static clock-contract and hot-path-shape guard for tiered JIT diagnostics.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
source="$root/src/compiler/95.interp/execution/tiered_jit_manager.spl"
runtime="$root/src/runtime/runtime_time.c"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/time.rs"

grep -Fq 'extern fn rt_time_now_micros() -> i64' "$source"
! grep -Fq 'rt_time_now_seconds' "$source"
grep -Fq 'fn _tiered_jit_time_now_micros_raw() -> i64:' "$source"
test "$(grep -Fc '_tiered_jit_time_now_micros_raw()' "$source")" -eq 3
grep -Fq 't0 < 0 or t1 < 0 or t1 < t0' "$source"
grep -Fq 'self.total_compile_time_ms = self.total_compile_time_ms + ms' "$source"
grep -Fq 'int64_t rt_time_now_micros(void)' "$runtime"
grep -Fq 'pub fn rt_time_now_micros' "$interpreter"

echo 'Tiered JIT clock SFFI authority: PASS monotonic_integer_abi=shared reads_per_compile=2 failure_sentinel=negative total_excludes_failed_timing=1'
