#!/bin/sh
set -eu

module=src/compiler/00.common/module_path_naming.spl

if rg -q '^extern fn rt_' "$module"; then
    echo "module-path naming must not own raw runtime authority" >&2
    exit 1
fi

test "$(rg -c 'if needle == ""' "$module")" -eq 1
test "$(rg -c '_module_path_naming_text_index_of\(' "$module")" -eq 3
if rg -q 'value\.index_of\(needle\)|value\.contains\(needle\)|value\.split\(needle\)' "$module"; then
    echo "module-path naming must use its allocation-free plain-i64 scan" >&2
    exit 1
fi
if rg -q 'mod_path = mod_path\.replace\("\.(spl|sdn)", ""\)' "$module"; then
    echo "module-path naming must strip suffixes without deletion replacement" >&2
    exit 1
fi
test "$(rg -c 'value\.byte_at\(start \+ offset\)' "$module")" -eq 1
test "$(rg -c 'needle\.byte_at\(offset\)' "$module")" -eq 1
