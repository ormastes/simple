#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

mkdir -p "$work/scripts/audit/baselines" "$work/src" "$work/test"
cp "$root/scripts/audit/sffi-call-authority-census.shs" "$work/scripts/audit/"
cp "$root/scripts/audit/baselines/sffi-call-authority-v1.tsv" "$work/scripts/audit/baselines/"

cat >"$work/src/docstring_probe.spl" <<'EOF'
extern fn rt_probe() -> bool

fn checked() -> bool:
    """The text rt_probe() is documentation, not a call."""
    val quoted = "rt_probe() is also not code"
    # rt_probe() in a comment is not code either.
    rt_probe()

fn checked_multiline(
    value: i64,
    label: text
) -> bool:
    unsafe(capabilities: [ffi]):
        rt_probe()

trait ProbeOwner:
    me checked_method(
        value: i64
    ) -> bool:
        unsafe(capabilities: [ffi]):
            rt_probe()

extern fn rt_other(
    value: i64
) -> bool

fn after_multiline_extern() -> bool:
    rt_other(1)

use std.sffi.example.*

fn wildcard_import() -> bool:
    val quoted = "rt_globbed() is not code"
    unsafe(capabilities: [ffi]):
        rt_globbed()
EOF

cat >"$work/src/ambient_probe.spl" <<'EOF'
# Ambient raw call: no local extern declaration, no sffi import. Must be
# reported exactly once as an ambient row.
fn ambient_caller() -> text:
    return rt_env_get("SIMPLE_PROBE")

# A local pure-Simple rt_* function is not a foreign symbol; its call site
# must not appear in the census at all.
fn rt_local_pure(value: i64) -> i64:
    return value + 1

fn local_pure_caller() -> i64:
    return rt_local_pure(1)

# A body-local extern re-declaration shadows the pure-Simple top-level
# definition above it in the same file; this call site must stay visible.
fn rt_mixed_probe(value: i64) -> i64:
    return value

fn mixed_caller() -> i64:
    extern fn rt_mixed_probe(value: i64) -> i64
    return rt_mixed_probe(1)
EOF

SFFI_MAX_MISSING=100 sh "$work/scripts/audit/sffi-call-authority-census.shs" \
    "$work/calls.tsv" "$work/summary.tsv" "$work/symbols.tsv" \
    "$work/families.tsv" "$work/scopes.tsv" >/dev/null

rows=$(awk -F '\t' 'NR > 1 { count++ } END { print count + 0 }' "$work/calls.tsv")
line=$(awk -F '\t' '$3 == "rt_probe" && $4 == "missing" { print $2 }' "$work/calls.tsv")
symbol=$(awk -F '\t' '$3 == "rt_probe" && $4 == "missing" { print $3 }' "$work/calls.tsv")
lexical=$(awk -F '\t' 'NR > 1 && $4 == "lexical_unsafe" { count++ } END { print count + 0 }' "$work/calls.tsv")
missing=$(awk -F '\t' 'NR > 1 && $4 == "missing" { count++ } END { print count + 0 }' "$work/calls.tsv")
probe_rows=$(awk -F '\t' 'NR > 1 && $3 == "rt_probe" { count++ } END { print count + 0 }' "$work/calls.tsv")
other_rows=$(awk -F '\t' 'NR > 1 && $3 == "rt_other" { count++ } END { print count + 0 }' "$work/calls.tsv")
glob_rows=$(awk -F '\t' 'NR > 1 && $3 == "rt_globbed" { count++ } END { print count + 0 }' "$work/calls.tsv")
ambient=$(awk -F '\t' 'NR > 1 && $4 == "ambient" { count++ } END { print count + 0 }' "$work/calls.tsv")
ambient_line=$(awk -F '\t' '$3 == "rt_env_get" && $4 == "ambient" { print $2 }' "$work/calls.tsv")
pure_rows=$(awk -F '\t' 'NR > 1 && $3 == "rt_local_pure" { count++ } END { print count + 0 }' "$work/calls.tsv")
# The body-local extern re-declaration keeps rt_mixed_probe visible: the real
# call below it is a row, and the declaration line itself also matches the
# lexical call pattern (pre-existing scanner behavior, see segment_mapper).
mixed_call_line=$(awk -F '\t' '$3 == "rt_mixed_probe" && $4 == "missing" && $2 == 21 { count++ } END { print count + 0 }' "$work/calls.tsv")
if [ "$rows" -ne 8 ] || [ "$line" -ne 7 ] || [ "$symbol" != rt_probe ] ||
   [ "$lexical" -ne 3 ] || [ "$missing" -ne 4 ] ||
   [ "$probe_rows" -ne 3 ] || [ "$other_rows" -ne 1 ] ||
   [ "$glob_rows" -ne 1 ] || [ "$ambient" -ne 1 ] ||
   [ "$ambient_line" -ne 4 ] || [ "$pure_rows" -ne 0 ] ||
   [ "$mixed_call_line" -ne 1 ]; then
    cat "$work/calls.tsv" >&2
    exit 1
fi

echo 'sffi call authority census selftest: PASS'
