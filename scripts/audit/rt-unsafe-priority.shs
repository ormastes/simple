#!/bin/sh
# Rank direct, owned rt_* migration debt by exact declaring module and symbol.
#
# This is a source-only lexical estimate.  It neither resolves calls nor proves
# an ABI, nullability, ownership, provider artifact, signature, or admission.
# Its purpose is to make the next *reviewed* narrow migration visible without
# applying a broad source rewrite.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
scan_root=${SFFI_SCAN_ROOT:-$root}
out=${1:-/dev/stdout}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

SFFI_SOURCE_ONLY=1 sh "$root/scripts/audit/sffi-contract-inventory.shs" \
    "$work/contracts.tsv" "$work/symbols.tsv" >/dev/null 2>&1

expected_header='symbol	backing	provider_language	provider_id	source_signature_sha256	file	line	unsafe_tag	contract	cryptographic_admission	evidence	state	scoped_callsite_estimate	backing_first_declaring_file'
actual_header=$(head -n 1 "$work/contracts.tsv")
test "$actual_header" = "$(printf '%b' "$expected_header")" || {
    echo 'rt unsafe priority: unsupported contract-inventory schema' >&2
    exit 2
}

# Fixture users can pass the same exact file list as the inventory.  Normal
# operation scans production Simple modules only, keeping test call volume from
# distorting runtime migration order.
if [ -n "${SFFI_SOURCE_FILE_LIST:-}" ]; then
    while IFS= read -r source_file; do
        case "$source_file" in
            *.spl) printf '%s\0' "$source_file" ;;
        esac
    done <"$SFFI_SOURCE_FILE_LIST" >"$work/files.bin"
else
    find "$scan_root/src" -type f -name '*.spl' ! -path '*/vendor/*' -print0 >"$work/files.bin"
fi

# Count only lexical call expressions, never declarations.  The output key is
# deliberately module+symbol rather than symbol alone: duplicate declarations
# must be migrated and reviewed independently.
export RT_UNSAFE_PRIORITY_ROOT=$scan_root
xargs -0 -r -n 200 perl -0ne '
    my $file = $ARGV;
    my $root = $ENV{RT_UNSAFE_PRIORITY_ROOT};
    $file =~ s/^\Q$root\E\///;
    $file =~ s/\.spl$//;
    next if $file =~ m{(?:^|/)vendor(?:/|$)};
    for my $line (split /\n/, $_, -1) {
        $line =~ s/#.*$//;
        next if $line =~ /^\s*(?:pub\s+)?(?:unsafe\s+)?extern\s+fn\s+/;
        while ($line =~ /\b(rt_[A-Za-z0-9_]+)\s*\(/g) {
            print "$file\t$1\n";
        }
    }
' <"$work/files.bin" | LC_ALL=C sort | uniq -c |
awk 'BEGIN { OFS="\t" } { print $2, $3, $1 }' >"$work/direct-calls.tsv"

{
    printf 'module\tsymbol\tdeclaration_file\tdeclaration_line\tdirect_raw_call_estimate\tunsafe_tag\tcontract\tprovider_language\tstate\tpriority\n'
    awk -F '\t' 'BEGIN { OFS="\t" }
        NR == FNR { calls[$1 SUBSEP $2]=$3; next }
        FNR == 1 { next }
        $1 ~ /^rt_/ && ($8 == "missing" || $9 == "missing") {
            module=$6
            sub(/\.spl$/, "", module)
            n=calls[module SUBSEP $1] + 0
            if (n > 0 && $8 == "missing" && $9 == "missing") priority="P0_direct_tag_and_contract"
            else if (n > 0) priority="P1_direct_exact_contract"
            else if ($8 == "missing" && $9 == "missing") priority="P2_declaration_tag_and_contract"
            else priority="P3_declaration_exact_contract"
            print module, $1, $6, $7, n, $8, $9, $3, $12, priority
        }
    ' "$work/direct-calls.tsv" "$work/contracts.tsv" |
        LC_ALL=C sort -t "$(printf '\t')" -k5,5nr -k1,1 -k2,2 -k4,4n
} >"$work/priority.tsv"

if [ "$out" = /dev/stdout ]; then
    cat "$work/priority.tsv"
else
    test ! -e "$out" || test -f "$out" || {
        echo 'rt unsafe priority: output must be a regular file path' >&2
        exit 2
    }
    cp "$work/priority.tsv" "$out"
fi

count=$(awk 'END { print (NR > 0 ? NR - 1 : 0) }' "$work/priority.tsv")
echo "rt unsafe priority: rows=$count source_only=true admission=absent" >&2
