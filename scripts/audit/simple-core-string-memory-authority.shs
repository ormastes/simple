#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/runtime/simple_core/core_string.spl"
cranelift="$root/src/compiler_rust/compiler/src/codegen/instr/calls.rs"
llvm="$root/src/compiler_rust/compiler/src/codegen/llvm/functions/calls.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in spl_load_i64 spl_store_i64 spl_load_u8 spl_store_u8; do
    if [ "$(grep -c "${raw}(" "$module")" -ne 2 ]; then
        echo "simple-core string raw memory call escaped its capability owner: $raw" >&2
        exit 1
    fi
    grep -q "\"$raw\"" "$cranelift"
    grep -q "\"$raw\"" "$llvm"
done

for raw in malloc calloc realloc free memcpy memcmp strtoll strtod strlen write read; do
    if [ "$(grep -Ec "(^|[^A-Za-z0-9_])${raw}\\(" "$module")" -ne 2 ]; then
        echo "simple-core string libc call escaped its capability owner: $raw" >&2
        exit 1
    fi
done

for raw in rt_array_len rt_array_len_safe rt_array_new rt_array_new_with_cap_u64 \
    rt_byte_array_new rt_array_push rt_array_get array_is_valid array_items \
    array_flags rt_dict_len rt_dict_contains rt_value_int rt_value_as_int \
    rt_value_float rt_enum_new rt_enum_discriminant rt_enum_id rt_enum_payload; do
    if [ "$(grep -Ec "(^|[^A-Za-z0-9_])${raw}\\(" "$module")" -ne 2 ]; then
        echo "simple-core string tagged-handle call escaped its capability owner: $raw" >&2
        exit 1
    fi
done

grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

[ "$(grep -c 'unsafe(capabilities: \[ffi, raw_ptr\]):' "$module")" -eq 16 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 18 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 34 ]
[ "$(grep -o '_sffi_load_i64(' "$module" | wc -l)" -eq 48 ]
[ "$(grep -o '_sffi_store_i64(' "$module" | wc -l)" -eq 13 ]
[ "$(grep -o '_sffi_load_u8(' "$module" | wc -l)" -eq 47 ]
[ "$(grep -o '_sffi_store_u8(' "$module" | wc -l)" -eq 88 ]
[ "$(grep -o '_sffi_malloc(' "$module" | wc -l)" -eq 17 ]
[ "$(grep -o '_sffi_calloc(' "$module" | wc -l)" -eq 2 ]
[ "$(grep -o '_sffi_realloc(' "$module" | wc -l)" -eq 3 ]
[ "$(grep -o '_sffi_free(' "$module" | wc -l)" -eq 11 ]
[ "$(grep -o '_sffi_memcpy(' "$module" | wc -l)" -eq 9 ]
[ "$(grep -o '_sffi_memcmp(' "$module" | wc -l)" -eq 13 ]
[ "$(grep -o '_sffi_strtoll(' "$module" | wc -l)" -eq 4 ]
[ "$(grep -o '_sffi_strtod(' "$module" | wc -l)" -eq 2 ]
[ "$(grep -o '_sffi_strlen(' "$module" | wc -l)" -eq 2 ]
[ "$(grep -o '_sffi_write(' "$module" | wc -l)" -eq 9 ]
[ "$(grep -o '_sffi_read(' "$module" | wc -l)" -eq 2 ]
for expected in \
    _sffi_rt_array_len:6 _sffi_rt_array_len_safe:3 \
    _sffi_rt_array_new:10 _sffi_rt_array_new_with_cap_u64:2 \
    _sffi_rt_byte_array_new:2 _sffi_rt_array_push:12 \
    _sffi_rt_array_get:4 _sffi_array_is_valid:4 _sffi_array_items:3 \
    _sffi_array_flags:3 _sffi_rt_dict_len:2 _sffi_rt_dict_contains:2 \
    _sffi_rt_value_int:4 _sffi_rt_value_as_int:3 _sffi_rt_value_float:2 \
    _sffi_rt_enum_new:3 _sffi_rt_enum_discriminant:3 \
    _sffi_rt_enum_id:3 _sffi_rt_enum_payload:3; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done

echo "simple-core string memory authority audit: PASS (pointer, libc, and tagged-handle calls have mandatory-inline minimal owners)"
