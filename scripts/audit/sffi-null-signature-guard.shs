for symbol in \
    rt_tls13_aes128_gcm_decrypt \
    rt_tls13_aes256_gcm_encrypt \
    rt_tls13_aes256_gcm_decrypt
do
    require_fixed "RuntimeFuncSpec::new(\"$symbol\"" \
        src/compiler_rust/compiler/src/codegen/runtime_sffi.rs
    require_fixed "pub unsafe extern \"C\" fn $symbol" \
        src/compiler_rust/runtime/src/value/aes.rs
done
require_fixed 'tls_aes_gcm_bridges_reject_invalid_shapes_instead_of_empty_payloads' \
    src/compiler_rust/compiler/src/interpreter_extern/simd.rs

# UDP option boundaries use semantic bools and a scalar timeout sentinel in
# every compiled lane. These checks prevent integer truthiness or Option object
# transport from reappearing on the hot path.
for signature in \
    'bool rt_io_udp_connect(int64_t fd, int64_t addr_val)' \
    'bool rt_io_udp_set_broadcast(int64_t fd, bool e)' \
    'bool rt_io_udp_set_read_timeout(int64_t fd, int64_t ms)' \
    'bool rt_io_udp_set_nonblocking(int64_t fd, bool e)'
do
    require_fixed "$signature" src/runtime/runtime_native.c
done
for symbol in \
    rt_io_udp_connect \
    rt_io_udp_set_broadcast \
    rt_io_udp_set_read_timeout \
    rt_io_udp_set_nonblocking
do
    require_fixed "RuntimeFuncSpec::new(\"$symbol\"" \
        src/compiler_rust/compiler/src/codegen/runtime_sffi.rs
    require_fixed "pub extern \"C\" fn $symbol" \
        src/compiler_rust/runtime/src/value/net_udp.rs
    require_fixed "\"$symbol\"" \
        src/compiler_rust/compiler/src/interpreter_extern/mod.rs
    require_fixed "interpreter_native_net::${symbol}_interp" \
        src/compiler_rust/compiler/src/interpreter_extern/mod.rs
    require_raw_symbol_scoped "$symbol"
done
require_fixed 'extern fn rt_io_udp_set_broadcast(fd: i64, enabled: bool) -> bool' \
    src/lib/nogc_sync_mut/io/udp.spl
require_fixed 'extern fn rt_io_udp_set_read_timeout(fd: i64, ms: i64) -> bool' \
    src/lib/nogc_sync_mut/io/udp.spl
require_fixed 'extern fn rt_io_udp_set_nonblocking(fd: i64, enabled: bool) -> bool' \
    test/05_perf/bench/http_server/bench_udp_echo.spl

for symbol in \
    rt_io_udp_local_addr \
    rt_io_udp_recv \
    rt_io_udp_recv_from \
    rt_io_udp_send \
    rt_io_udp_send_to
do
    require_fixed "RuntimeFuncSpec::new(\"$symbol\"" \
        src/compiler_rust/compiler/src/codegen/runtime_sffi.rs
    require_fixed "pub extern \"C\" fn $symbol" \
        src/compiler_rust/runtime/src/value/net_udp.rs
    require_fixed "\"$symbol\"" \
        src/compiler_rust/compiler/src/interpreter_extern/mod.rs
    require_fixed "interpreter_native_net::${symbol}_interp" \
        src/compiler_rust/compiler/src/interpreter_extern/mod.rs
    require_raw_symbol_scoped "$symbol"
done
require_fixed 'if (size < 0 || size > 65535) return rt_core_nil();' \
    src/runtime/runtime_native.c
require_fixed 'rt_array_free(arr);' src/runtime/runtime_native.c
require_fixed 'extern fn rt_io_udp_recv(fd: i64, size: i64) -> [u8]?' \
    src/lib/nogc_sync_mut/io/udp.spl
require_fixed 'extern fn rt_io_udp_recv_from(fd: i64, size: i64) -> ([u8], text)?' \
    src/lib/nogc_sync_mut/io/udp.spl
reject_text 'extern fn rt_io_udp_recv_from\(fd: i64, size: i64\) -> \[u8\]' test
reject_text 'rt_io_udp_recv_from\(efd, 65536\)' test

udp_data_region=$(sed -n \
    '/const UDP_MAX_PAYLOAD:/,/\/\/\/ Simple-facing UDP bind contract:/p' \
    "$root/src/compiler_rust/runtime/src/value/net_udp.rs")
if printf '%s\n' "$udp_data_region" | rg -q \
    'Vec<|to_vec\(|collect\(|to_string\(|HashMap|RwLock|sha|dlsym|dlopen'; then
    echo 'SFFI lint: UDP runtime data path gained copy/allocation/lookup work' >&2
    failed=1
fi
require_fixed 'bytes: [u8; 64]' src/compiler_rust/runtime/src/value/net_udp.rs
require_fixed 'rt_array_free(array);' src/compiler_rust/runtime/src/value/net_udp.rs

# The common ECDSA P-256 API must consume the checked provider contracts.
# Malformed keys/descriptors are typed errors, not empty signatures or false.
for symbol in rt_ecdsa_p256_sign_checked rt_ecdsa_p256_verify_checked
do
    require_fixed "extern fn $symbol" src/lib/nogc_sync_mut/io/signature_sffi.spl
    require_fixed "RuntimeFuncSpec::new(\"$symbol\"" \
        src/compiler_rust/compiler/src/codegen/runtime_sffi.rs
    require_fixed "\"$symbol\"" \
        src/compiler_rust/compiler/src/interpreter_extern/mod.rs
    require_raw_symbol_scoped "$symbol"
done
require_fixed 'use std.nogc_sync_mut.io.signature_sffi.{ecdsa_p256_sign_checked, ecdsa_p256_verify_checked}' \
    src/lib/common/crypto/ecdsa_p256.spl
require_fixed 'fn ecdsa_p256_sign(pkcs8: [u8], message: [u8]) -> Result<[u8], text>' \
    src/lib/common/crypto/ecdsa_p256.spl
require_fixed 'fn ecdsa_p256_verify(pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>' \
    src/lib/common/crypto/ecdsa_p256.spl
require_fixed 'if signature.len() != 64:' src/lib/common/crypto/ecdsa_p256.spl
reject_text 'extern fn rt_ecdsa_p256_sign\(' src/lib/common/crypto/ecdsa_p256.spl
reject_text 'extern fn rt_ecdsa_p256_verify\(' src/lib/common/crypto/ecdsa_p256.spl
reject_text 'extern fn rt_ecdsa_p256_(sign|verify)_checked\(' \
    src/lib/common/crypto/ecdsa_p256.spl
reject_text 'Returns an empty array on any error' src/lib/common/crypto/ecdsa_p256.spl

# P-384/P-521 are canonical pure-Simple providers.  No unresolved raw foreign
# declaration may reappear and provider absence must not be lifted as false/[].
for symbol in \
    rt_ecdsa_p384_sign rt_ecdsa_p384_verify \
    rt_ecdsa_p521_sign rt_ecdsa_p521_verify
do
    if rg -q --glob '*.spl' --glob '!**/vendor/**' \
        "^[[:space:]]*extern fn $symbol\\(" "$root/src" "$root/test"; then
        echo "SFFI lint: unresolved $symbol declaration bypasses the pure-Simple provider" >&2
        failed=1
    fi
done
require_fixed 'fn p384_ecdsa_sign(privkey: [u8], msg_hash: [u8]) -> [u8]' \
    src/os/crypto/p384.spl
require_fixed 'fn p384_ecdsa_verify(pubkey: [u8], msg_hash: [u8], sig: [u8]) -> bool' \
    src/os/crypto/p384.spl
require_fixed 'fn p521_ecdsa_sign(privkey: [u8], msg_hash: [u8]) -> [u8]' \
    src/os/crypto/ecdsa_p521.spl
require_fixed 'fn p521_ecdsa_verify(pubkey: [u8], msg_hash: [u8], sig: [u8]) -> bool' \
    src/os/crypto/ecdsa_p521.spl
require_fixed 'fn verify_host_key(key_type: text, pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>' \
    src/lib/nogc_sync_mut/io/signature_sffi.spl
require_fixed 'use the canonical pure-Simple provider for {key_type}' \
    src/lib/nogc_sync_mut/io/signature_sffi.spl
for symbol in \
    rt_rsa_sha256_verify rt_rsa_sha512_verify rt_ed25519_verify \
    rt_ecdsa_p256_verify rt_rsa_sha256_sign rt_rsa_sha512_sign \
    rt_ed25519_sign rt_ecdsa_p256_sign
do
    reject_text "extern fn $symbol\\(" src/lib/nogc_sync_mut/io/signature_sffi.spl
done
for signature in \
    'fn rsa_sha256_verify(pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>' \
    'fn rsa_sha512_verify(pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>' \
    'fn ed25519_verify_native(pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>' \
    'fn ecdsa_p256_verify(pubkey: [u8], message: [u8], signature_fixed64: [u8]) -> Result<bool, text>' \
    'fn rsa_sha256_sign(pkcs8: [u8], message: [u8]) -> Result<[u8], text>' \
    'fn rsa_sha512_sign(pkcs8: [u8], message: [u8]) -> Result<[u8], text>' \
    'fn ed25519_sign_pkcs8(pkcs8: [u8], message: [u8]) -> Result<[u8], text>' \
    'fn ecdsa_p256_sign(pkcs8: [u8], message: [u8]) -> Result<[u8], text>'
do
    require_fixed "$signature" src/lib/nogc_sync_mut/io/signature_sffi.spl
done
reject_text 'extern fn rt_(rsa_sha256|ed25519)_verify\(' \
    src/os/apps/sshd/ssh_session_helpers.spl
reject_text 'extern fn rt_(rsa_sha256|ed25519)_verify\(' \
    src/os/apps/sshd/ssh_session.spl
reject_text 'extern fn rt_ecdsa_p256_(sign|verify)\(' src/os/crypto/ecdsa_p256.spl
require_fixed 'fn ecdsa_p256_sign_fixed(pkcs8: [u8], message: [u8]) -> Result<[u8], text>' \
    src/os/crypto/ecdsa_p256.spl
require_fixed ') -> Result<bool, text>:' src/os/crypto/ecdsa_p256.spl
require_fixed 'fn cose_sign1_create(payload: [u8], alg_id: i64, key: [u8]) -> Result<[u8], CoseError>' \
    src/os/crypto/cose.spl
require_fixed 'val sig_fixed = ecdsa_p256_sign_fixed(host_keys.ecdsa_p256_pkcs8, exchange_hash)?' \
    src/os/apps/sshd/ssh_kex_crypto.spl
require_fixed 'val sig = ecdsa_p256_sign_fixed(pkcs8, signing_input)?' \
    src/lib/common/jwt/sign.spl

if [ "$failed" -ne 0 ]; then
    exit 1
fi

echo "SFFI null/signature contract guard: PASS"
