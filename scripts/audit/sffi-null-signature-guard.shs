#!/bin/sh
set -eu

# Focused fail-closed guard for the canonical dynamic-call and Ed25519 SFFI
# owners. This complements semantic SFFI layout linting with cross-lane symbol
# and contract checks that are visible only across Rust/Simple source files.

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
failed=0

require_text() {
    pattern=$1
    file=$2
    if ! rg -q -- "$pattern" "$root/$file"; then
        echo "SFFI lint: missing '$pattern' in $file" >&2
        failed=1
    fi
}

for owner in \
    src/compiler_rust/runtime/src/value/wsffi_native.rs \
    src/compiler_rust/compiler/src/interpreter_extern/wsffi.rs \
    src/compiler_rust/compiler/src/interpreter_extern/mod.rs \
    src/compiler_rust/compiler/src/codegen/runtime_sffi.rs \
    src/compiler_rust/common/src/runtime_symbols.rs \
    src/lib/nogc_sync_mut/sffi/dynamic.spl
do
    require_text 'spl_wffi_call_i64_checked' "$owner"
done

require_text 'n > available' src/compiler_rust/runtime/src/value/wsffi_native.rs
require_text 'nargs > call_args.len' src/compiler_rust/compiler/src/interpreter_extern/wsffi.rs
require_text 'pub extern "C" fn rt_ed25519_verify\(message: RuntimeValue, pubkey: RuntimeValue' \
    src/compiler_rust/runtime/src/value/sffi/signature.rs
require_text 'rt_ed25519_verify_checked' src/compiler_rust/runtime/src/value/sffi/signature.rs
require_text 'ed25519_verify_native_checked' src/lib/nogc_sync_mut/io/signature_sffi.spl
for symbol in \
    rt_rsa_sha256_verify_checked \
    rt_rsa_sha512_verify_checked \
    rt_rsa_pss_sha256_verify_checked \
    rt_rsa_pss_sha384_verify_checked \
    rt_rsa_pss_sha512_verify_checked \
    rt_ecdsa_p256_verify_checked
do
    require_text "$symbol" src/compiler_rust/runtime/src/value/sffi/signature.rs
    require_text "$symbol" src/compiler_rust/compiler/src/interpreter_extern/signatures.rs
    require_text "$symbol" src/compiler_rust/compiler/src/interpreter_extern/mod.rs
    require_text "$symbol" src/compiler_rust/common/src/runtime_symbols.rs
    require_text "$symbol" src/lib/nogc_sync_mut/io/signature_sffi.spl
done
for symbol in \
    rt_rsa_sha256_sign_checked \
    rt_rsa_sha512_sign_checked \
    rt_ed25519_sign_checked \
    rt_ecdsa_p256_sign_checked
do
    require_text "$symbol" src/compiler_rust/runtime/src/value/sffi/signature.rs
    require_text "$symbol" src/compiler_rust/compiler/src/interpreter_extern/signatures.rs
    require_text "$symbol" src/compiler_rust/compiler/src/interpreter_extern/mod.rs
    require_text "$symbol" src/compiler_rust/common/src/runtime_symbols.rs
    require_text "$symbol" src/lib/nogc_sync_mut/io/signature_sffi.spl
done
require_text 'verify_host_key_checked' src/os/tools/net/_SshTool/run.spl
require_text 'spl_wffi_try_call_i64_c' src/runtime/runtime.c
require_text '!out || !fptr || nargs < 0 || nargs > 8' src/runtime/runtime.c
require_text 'if \(!handle\) return -1;' src/runtime/runtime_dynload.c
require_text 'if \(!handle\) return -1;' src/runtime/runtime_native.c

# SDL text providers use explicit non-null fallback strings. The Rust
# interpreter lift must treat NULL as a provider-contract failure, never as a
# successful empty string.
require_text 'foreign text contract returned null' \
    src/compiler_rust/compiler/src/interpreter_extern/sdl2.rs
require_text 'text_from_ptr(f(), name)?' \
    src/compiler_rust/compiler/src/interpreter_extern/sdl2.rs
require_text 'text_from_ptr(f(raw\[0\]), name)?' \
    src/compiler_rust/compiler/src/interpreter_extern/sdl2.rs

sdl_text_lift=$(sed -n \
    '/unsafe fn text_from_ptr(/,/^}/p' \
    "$root/src/compiler_rust/compiler/src/interpreter_extern/sdl2.rs")
if printf '%s\n' "$sdl_text_lift" | rg -q \
    'ptr\.is_null\(\).*Value::Str|String::new\(\)'; then
    echo "SFFI lint: SDL NULL text return is fabricated as successful empty text" >&2
    failed=1
fi

legacy_i64_body=$(sed -n \
    '/pub extern "C" fn spl_wffi_call_i64(/,/^}/p' \
    "$root/src/compiler_rust/runtime/src/value/wsffi_native.rs")
if printf '%s\n' "$legacy_i64_body" | rg -q 'rt_array_new|Vec::|HashMap|Mutex|dlsym'; then
    echo "SFFI lint: legacy integer hot path allocates or performs dynamic lookup" >&2
    failed=1
fi

legacy_f64_body=$(sed -n \
    '/pub extern "C" fn spl_wffi_call_f64(/,/^}/p' \
    "$root/src/compiler_rust/runtime/src/value/wsffi_native.rs")
if printf '%s\n' "$legacy_f64_body" | rg -q 'rt_array_new|Vec::|HashMap|Mutex|dlsym'; then
    echo "SFFI lint: legacy float hot path allocates or performs dynamic lookup" >&2
    failed=1
fi

for helper in ed25519_sign_value ecdsa_p256_sign_value
do
    helper_body=$(sed -n "/fn $helper(/,/^}/p" \
        "$root/src/compiler_rust/runtime/src/value/sffi/signature.rs")
    if printf '%s\n' "$helper_body" | rg -q '\.to_vec\(|rt_array_new|checked_sign_result'; then
        echo "SFFI lint: legacy $helper path gained a temporary copy or descriptor allocation" >&2
        failed=1
    fi
done

if [ "$failed" -ne 0 ]; then
    exit 1
fi

echo "SFFI null/signature contract guard: PASS"
