#!/bin/sh
# Verify that the HDA probe keeps its target-specific PCI ABI confined to
# inlined lexical unsafe owners. This is a source authority check, not provider
# admission or hardware validation.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
source="$root/src/os/drivers/audio/hda_pci_binding.spl"

for symbol in \
    rt_pci_device_count \
    rt_pci_get_field \
    rt_pci_read_bar0 \
    rt_pci_enable_memory_bus_master; do
    grep -B1 -q "^extern fn $symbol" "$source"
done

test "$(grep -c '^@unsafe(reason: "raw target PCI ' "$source")" -eq 4
test "$(grep -c '^@always_inline$' "$source")" -eq 4
test "$(grep -c '^        rt_pci_' "$source")" -eq 4
test "$(grep -c '^    unsafe(capabilities: \[ffi\]):$' "$source")" -eq 4

echo 'HDA PCI SFFI authority: PASS (four tagged raw declarations, four inlined lexical owners)'
