#!/bin/sh
set -eu

# Source-only, zero-runtime-cost ABI gate for the original pointer-write family
# and its paired pointer reads. Writes are exact void functions; reads return
# their exact width. False result types change native calling semantics, while
# missing unsafe metadata hides the raw-pointer proof obligation.

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
temp_dir=$(mktemp -d)
trap 'rm -rf "$temp_dir"' EXIT HUP INT TERM

declarations="$temp_dir/declarations"
violations="$temp_dir/violations"
unsafe_violations="$temp_dir/unsafe-violations"

git -C "$root" grep -n -E \
    '^[[:space:]]*extern fn (rt_ptr_(read|write)_(u8|i16|i32|i64)|rt_ptr_write_bytes_raw)\b' \
    -- 'src/**/*.spl' > "$declarations" || true

awk '
function compact(value) {
    gsub(/[[:space:]]+/, "", value)
    return value
}
{
    source = $0
    line = $0
    sub(/^[^:]+:[0-9]+:/, "", line)
    line = compact(line)

    valid = 0
    if (line == "externfnrt_ptr_write_u8(addr:i64,offset:i64,value:i64)") valid = 1
    if (line == "externfnrt_ptr_write_i32(addr:i64,offset:i64,value:i32)") valid = 1
    if (line == "externfnrt_ptr_write_i64(addr:i64,offset:i64,value:i64)") valid = 1

    # Parameter names are documentation rather than ABI, so accept the exact
    # types even when a module calls the first parameter `ptr`.
    if (line ~ /^externfnrt_ptr_write_u8\([^:(),]+:i64,[^:(),]+:i64,[^:(),]+:i64\)$/) valid = 1
    if (line ~ /^externfnrt_ptr_write_i16\([^:(),]+:i64,[^:(),]+:i64,[^:(),]+:i32\)$/) valid = 1
    if (line ~ /^externfnrt_ptr_write_i32\([^:(),]+:i64,[^:(),]+:i64,[^:(),]+:i32\)$/) valid = 1
    if (line ~ /^externfnrt_ptr_write_i64\([^:(),]+:i64,[^:(),]+:i64,[^:(),]+:i64\)$/) valid = 1
    if (line ~ /^externfnrt_ptr_read_u8\([^:(),]+:i64,[^:(),]+:i64\)->i64$/) valid = 1
    if (line ~ /^externfnrt_ptr_read_i32\([^:(),]+:i64,[^:(),]+:i64\)->i32$/) valid = 1
    if (line ~ /^externfnrt_ptr_read_i64\([^:(),]+:i64,[^:(),]+:i64\)->i64$/) valid = 1
    if (line ~ /^externfnrt_ptr_write_bytes_raw\([^:(),]+:i64,[^:(),]+:i64,[^:(),]+:i64,[^:(),]+:i64\)->i64$/) valid = 1

    if (!valid) print source
}
' "$declarations" > "$violations"

find "$root/src" -type f -name '*.spl' \
    ! -path '*/compiler_rust/vendor/*' \
    ! -path '*/runtime/vendor/*' \
    -exec awk '
        FNR == 1 { previous = "" }
        /^[[:space:]]*extern fn (rt_ptr_(read|write)_(u8|i16|i32|i64)|rt_ptr_write_bytes_raw)[[:space:]]*\(/ {
            if (previous !~ /@unsafe\(/ ||
                previous !~ /capabilities:[[:space:]]*\[[^]]*ffi/ ||
                previous !~ /raw_ptr/) {
                printf "%s:%d:%s\n", FILENAME, FNR, $0
            }
        }
        { previous = $0 }
    ' {} + > "$unsafe_violations"

count=$(wc -l < "$declarations" | tr -d ' ')
if [ -s "$violations" ]; then
    echo "SFFI pointer-memory declarations disagree with the canonical ABI:" >&2
    cat "$violations" >&2
    exit 1
fi
if [ -s "$unsafe_violations" ]; then
    echo "SFFI pointer-memory declarations lack explicit ffi/raw_ptr unsafe metadata:" >&2
    cat "$unsafe_violations" >&2
    exit 1
fi

echo "SFFI exact pointer-memory ABI: PASS ($count declarations)"
