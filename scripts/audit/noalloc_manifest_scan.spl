# Repo-facing noalloc capability-manifest scan.
#
# Populates a real NoallocCapabilityManifest from source under
# src/lib/nogc_async_mut_noalloc and runs it through
# noalloc_checker.check_all_noalloc_fns.

use compiler.tools.verify.noalloc_manifest_scan.{scan_noalloc_functions, run_noalloc_manifest_scan}

extern fn rt_exit(code: i64)

val scanned = scan_noalloc_functions()
var noalloc_count = 0
for entry in scanned:
    if entry.is_noalloc:
        noalloc_count = noalloc_count + 1
val messages = run_noalloc_manifest_scan()
if noalloc_count == 0:
    print "noalloc manifest scan: found 0 @noalloc-annotated functions under src/lib/nogc_async_mut_noalloc"
else if messages.len() == 0:
    print "noalloc manifest scan: {noalloc_count} @noalloc fn(s) checked, 0 violations"
else:
    for message in messages:
        print message
    rt_exit(1)
