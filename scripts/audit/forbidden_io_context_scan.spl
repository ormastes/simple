# Repo-facing forbidden-I/O context scan.
#
# Populates a real ForbiddenIoContextManifest from source under
# src/lib/nogc_async_mut_noalloc and src/compiler/99.loader and runs it
# through forbidden_io_checker.check_all_forbidden_io_fns.

use compiler.tools.verify.forbidden_io_context_scan.{
    scan_forbidden_io_functions, run_forbidden_io_context_scan, SCAN_ROOTS
}

extern fn rt_exit(code: i64)

val scanned = scan_forbidden_io_functions()
var tagged_count = 0
for entry in scanned:
    if entry.is_realtime or entry.is_interrupt or entry.is_noalloc:
        tagged_count = tagged_count + 1
val messages = run_forbidden_io_context_scan()
if tagged_count == 0:
    print "forbidden-io context scan: found 0 real-time/interrupt/noalloc-tagged functions under {SCAN_ROOTS}"
else if messages.len() == 0:
    print "forbidden-io context scan: {tagged_count} tagged fn(s) checked, 0 violations"
else:
    for message in messages:
        print message
    rt_exit(1)
