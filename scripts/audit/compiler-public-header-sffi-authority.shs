#!/bin/sh
set -eu

module=src/compiler/80.driver/driver_public_headers.spl

test "$(rg -c '^extern fn rt_(process_run|file_write_text|file_exists|file_read_text|dir_create|path_join)' "$module")" -eq 6
test "$(rg -c '^fn _header_(process_run|write|exists|read|dir_create|path_join)_raw' "$module")" -eq 6
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 6

for symbol in rt_process_run rt_file_write_text rt_file_exists rt_file_read_text rt_dir_create rt_path_join; do
    test "$(rg -c "${symbol}\\(" "$module")" -eq 2
done

rg -q '^extern fn rt_file_read_text\(path: text\) -> text\?$' "$module"
test "$(rg -c 'failed to construct generated .* header path' "$module")" -eq 2
