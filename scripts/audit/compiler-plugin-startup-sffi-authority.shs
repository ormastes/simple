#!/bin/sh
set -eu

module=src/compiler/15.blocks/plugin_startup.spl

test "$(rg -c '^extern fn rt_(file_read_text|env_home)' "$module")" -eq 2
test "$(rg -c '^fn _plugin_(manifest_read|home)_raw' "$module")" -eq 2
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 5
rg -q '^extern fn rt_file_read_text\(path: text\) -> text\?$' "$module"
rg -q '^extern fn rt_env_home\(\) -> text\?$' "$module"

for symbol in rt_file_read_text rt_env_home; do
    test "$(rg -c "${symbol}\\(" "$module")" -eq 2
done

test "$(rg -c '_plugin_manifest_read_raw\(full_path\)' "$module")" -eq 1
test "$(rg -c '_plugin_home_raw\(\)' "$module")" -eq 1
rg -q 'if content_raw != nil:' "$module"
