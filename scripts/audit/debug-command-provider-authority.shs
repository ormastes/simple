#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
helper="$root/src/lib/nogc_sync_mut/debug/remote/protocol/process_command.spl"

for source in \
    "$root/src/lib/nogc_sync_mut/baremetal/transport/dedicated_hw.spl" \
    "$root/src/lib/nogc_sync_mut/baremetal/transport/stlink.spl" \
    "$root/src/lib/nogc_sync_mut/debug/remote/protocol/openocd.spl" \
    "$root/src/lib/nogc_sync_mut/debug/remote/protocol/stlink_tools.spl"; do
    ! grep -q 'rt_command_output' "$source"
    grep -Eq 'debug_(process|shell)_output' "$source"
done

grep -q 'process_run_bounded' "$helper"
grep -q 'pub fn debug_process_output' "$helper"
grep -q 'pub fn debug_shell_output' "$helper"
grep -q 'DEBUG_COMMAND_TIMEOUT_MS' "$helper"
grep -q 'DEBUG_COMMAND_MAX_OUTPUT_BYTES' "$helper"
grep -q 'if code != 0:' "$helper"

echo 'debug command provider authority: PASS (providerless text extern absent; bounded status-aware process owner retained)'
