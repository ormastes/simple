#!/bin/sh
set -eu

module=src/compiler/60.mir_opt/bulk_ops_flag_spec.spl
facade=src/lib/nogc_sync_mut/io_runtime.spl

if rg -q '^extern fn rt_env_set|rt_env_set\(' "$module"; then
    echo "bulk-op flag spec must use the canonical environment facade" >&2
    exit 1
fi

test "$(rg -c '^use std\.io_runtime\.\{env_set\}' "$module")" -eq 1
test "$(rg -c 'expect\(env_set\("SIMPLE_MIR_BULK_OPS", "[01]"\)\)\.to_equal\(true\)' "$module")" -eq 3
rg -q '^pub fn env_set\(key: text, value: text\) -> bool:' "$facade"
