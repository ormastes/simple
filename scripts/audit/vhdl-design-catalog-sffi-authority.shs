#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/70.backend/backend/vhdl/vhdl_design_catalog.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for suffix in dict_contains enum_discriminant enum_payload env_get; do
    raw="rt_$suffix"
    owner="_sffi_$suffix"
    [ "$(grep -Ec "^extern fn ${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^fn ${owner}\\(" "$module")" -eq 1 ]
    grep -q "RuntimeFuncSpec::new(\"$raw\"" "$registry"
    grep -q "insert_simple!(\"$raw\"" "$interpreter"
done

grep -q '^extern fn rt_env_get(key: text) -> text?$' "$module"
[ "$(grep -c '^@unsafe(' "$module")" -eq 4 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 4 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 4 ]

for expected in dict_contains:33 enum_discriminant:7 enum_payload:7 env_get:2; do
    suffix=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "_sffi_${suffix}(" "$module" | wc -l)" -eq "$count" ]
done

# Catalog construction already performs dictionary probes in nested scans.
# Mandatory inlining ensures authority ownership adds no further dispatch,
# allocation, copy, hash, lookup structure, or asymptotic work.
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "VHDL design-catalog SFFI authority audit: PASS (4 raw ABIs confined; nullable env truthful; nested catalog scans retain direct-inline primitives)"
