#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/runtime/simple_core/core_net.spl"
cranelift="$root/src/compiler_rust/compiler/src/codegen/instr/calls.rs"
llvm="$root/src/compiler_rust/compiler/src/codegen/llvm/functions/calls.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in malloc free socket connect sendto write close spl_store_u8; do
    if [ "$(grep -Ec "(^|[^A-Za-z0-9_])${raw}\\(" "$module")" -ne 2 ]; then
        echo "simple-core network call escaped its mandatory-inline owner: $raw" >&2
        exit 1
    fi
done

[ "$(grep -c '^@unsafe(' "$module")" -eq 8 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 8 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi, raw_ptr\]):' "$module")" -eq 6 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 2 ]
for expected in _sffi_malloc:4 _sffi_free:7 _sffi_socket:4 \
    _sffi_connect:3 _sffi_sendto:2 _sffi_write:2 _sffi_close:10 \
    _sffi_store_u8:29; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done

grep -q 'if connected < 0:' "$module"
grep -q 'if sent != 1:' "$module"
grep -q 'if written != 18:' "$module"
grep -q 'if closed < 0:' "$module"
grep -q '"spl_store_u8"' "$cranelift"
grep -q '"spl_store_u8"' "$llvm"
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "simple-core network authority audit: PASS (all raw calls confined; connect/send/write/close failures remain signed)"
