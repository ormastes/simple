#!/bin/sh
set -eu

ssa=src/compiler/60.mir_opt/mir_opt/var_reassign_ssa.spl
aop=src/compiler/80.driver/driver_pipeline_aop.spl
facade=src/lib/nogc_sync_mut/io_runtime.spl

for module in "$ssa" "$aop"; do
    if rg -q '^extern fn rt_env_get|rt_env_get\(' "$module"; then
        echo "$module must use the canonical environment facade" >&2
        exit 1
    fi
done

test "$(rg -c 'env_get_opt\("SIMPLE_BOOTSTRAP_DEBUG"\)' "$ssa")" -eq 1
test "$(rg -c 'ssa_debug_enabled\(' "$ssa")" -eq 3
test "$(rg -c 'env_get_opt\(' "$aop")" -eq 3
test "$(rg -c 'driver_aop_env_bool\(' "$aop")" -eq 3
rg -Uq '@always_inline\npub fn env_get_opt\(key: text\) -> text\?:' "$facade"
