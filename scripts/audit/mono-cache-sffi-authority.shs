#!/bin/sh
# Static lexical-boundary guard for optional monomorphization-cache persistence.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/40.mono/monomorphize/cache.spl"

test "$(grep -c '^@unsafe(reason: "raw optional persistent-cache text ABI; unreadable cache is a cache miss", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^@unsafe(reason: "raw persistent-cache existence ABI", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^@unsafe(reason: "raw persistent-cache write status ABI", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^extern fn rt_file_' "$module")" -eq 3
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_file_' "$module")" -eq 3

echo 'Mono cache SFFI authority: PASS declarations=3 lexical_disk_calls=3 O1_memory_hot_path=preserved artifact_admission=absent'
