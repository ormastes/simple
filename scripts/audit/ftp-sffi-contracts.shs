#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/io/ftp_sffi.spl"

declarations=$(grep -c '^[[:space:]]*extern fn rt_ftp_' "$owner")
if [ "$declarations" -ne 25 ]; then
    echo "FTP SFFI inventory changed without contract review" >&2
    exit 1
fi
tagged=$(awk '
    /^@unsafe\(.*capabilities: \[ffi\]\)$/ { previous_is_ffi = 1; next }
    /^[[:space:]]*extern fn rt_ftp_/ {
        if (previous_is_ffi) tagged++
    }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$owner")
if [ "$tagged" -ne "$declarations" ]; then
    echo "every FTP declaration must be explicitly unsafe(ffi)" >&2
    exit 1
fi

# FTP is intentionally fail-closed on current builds. A provider or registry
# entry must arrive with ABI review rather than silently changing this state.
if grep -R -E 'insert_simple!\("rt_ftp_|^[[:space:]]*(pub[[:space:]]+)?fn[[:space:]]+rt_ftp_|^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]\*]+rt_ftp_[A-Za-z0-9_]+\(' \
    "$root/src/compiler_rust/compiler/src/interpreter_extern" \
    "$root/src/runtime" --include='*.rs' --include='*.c' --include='*.cpp' --include='*.h' \
    >/dev/null 2>&1; then
    echo "FTP provider appeared without ABI/admission review" >&2
    exit 1
fi

grep -q 'STORAGE_FTP_UNBACKED' "$root/src/app/llm_caret/infra_storage.spl" || {
    echo "storage selection must keep unbacked FTP fail-closed" >&2
    exit 1
}

echo "FTP SFFI contract audit: PASS"
