#!/bin/sh
# Static lexical-boundary guard for Portal template reads.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/app/portal/template.spl"

test "$(grep -c '^@unsafe(reason: "raw template-text ABI; render API intentionally has no I/O error channel", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^extern fn rt_file_read_text(path: text) -> text$' "$module")" -eq 1
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_file_read_text(path)' "$module")" -eq 1

echo 'Portal template SFFI authority: PASS declarations=1 lexical_calls=1 direct_call_shape=preserved artifact_admission=absent'
