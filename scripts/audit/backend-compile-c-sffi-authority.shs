#!/bin/sh
# Static boundary guard for the backend C-compile entrypoint.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/70.backend/backend/compile_c_entry.spl"

test "$(grep -c '^extern fn rt_file_read_text' "$module")" -eq 0
test "$(grep -c '^@unsafe(reason: "raw backend compile argument-vector ABI", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^@unsafe(reason: "raw backend generated-output write status ABI", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c 'read_file_text_result(source_file)' "$module")" -eq 1
test "$(grep -c 'unsafe(capabilities: \[ffi\]): sys_get_args()' "$module")" -eq 1
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_file_write_text(output_file, cpp_source)' "$module")" -eq 1

echo 'Backend C compile SFFI authority: PASS local_raw_read_declarations=0 result_lifts=1 lexical_raw_calls=2 artifact_admission=absent'
