#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/io/simple_sdl3.spl"
provider="$root/src/runtime/runtime_sdl3.c"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/sdl3.rs"

declarations=$(grep -c '^[[:space:]]*extern fn rt_sdl3_' "$owner")
if [ "$declarations" -ne 22 ]; then
    echo "SDL3 I/O extern inventory changed without contract review" >&2
    exit 1
fi

tagged=$(awk '
    /@unsafe\(.*capabilities: \[.*ffi.*\]\)$/ { previous_is_ffi = 1; next }
    /^[[:space:]]*extern fn rt_sdl3_/ { if (previous_is_ffi) tagged++ }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$owner")
if [ "$tagged" -ne "$declarations" ]; then
    echo "every SDL3 I/O declaration must be explicitly unsafe(ffi)" >&2
    exit 1
fi

awk '
    function indent(line, copy) {
        copy = line
        sub(/[^ ].*$/, "", copy)
        return length(copy)
    }
    /unsafe\(capabilities: \[.*ffi.*\]\):[[:space:]]*$/ {
        unsafe_indent = indent($0)
        inside_unsafe = 1
        next
    }
    inside_unsafe && NF && indent($0) <= unsafe_indent { inside_unsafe = 0 }
    /rt_sdl3_[A-Za-z0-9_]+\(/ && !/^[[:space:]]*extern fn / && !inside_unsafe {
        print "unscoped SDL3 I/O call at line " FNR ": " $0 > "/dev/stderr"
        failed = 1
    }
    END { if (failed) exit 1 }
' "$owner"

for symbol in $(sed -n 's/^extern fn \(rt_sdl3_[A-Za-z0-9_]*\).*/\1/p' "$owner"); do
    if ! grep -Eq "^(int64_t|void|const char\*) $symbol\\(" "$provider"; then
        echo "SDL3 I/O declaration $symbol has no C provider" >&2
        exit 1
    fi
    if ! grep -q "(\"$symbol\"" "$interpreter"; then
        echo "SDL3 I/O declaration $symbol has no typed interpreter registration" >&2
        exit 1
    fi
done

grep -q '^extern fn rt_sdl3_event_text() -> text?$' "$owner"
grep -q '^extern fn rt_sdl3_last_error() -> text?$' "$owner"
grep -q 'foreign text contract returned null' "$interpreter"
grep -q 'static HANDLE: AtomicUsize' "$interpreter"
grep -q 'static SYMBOLS: \[AtomicUsize; SDL3_FNS.len()\]' "$interpreter"
grep -q 'SYMBOLS\[index\].load' "$interpreter"
if grep -q 'dynamic_sffi' "$owner"; then
    echo "SDL3 owner must not use the generic dynamic dispatcher" >&2
    exit 1
fi

echo "SDL3 I/O SFFI contract audit: PASS (22 unsafe declarations; C provider and typed cached interpreter registrations present)"
