#!/bin/sh
# Keep raw WebGPU ownership in the canonical engine2d provider. The retired
# duplicate and providerless session facades must not reappear.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/gpu/engine2d/webgpu_sffi.spl"
session="$root/src/lib/nogc_sync_mut/gpu/engine2d/webgpu_session.spl"

test "$(grep -c '^extern fn rt_webgpu_' "$owner")" -eq 11
test "$(grep -c '^@unsafe(reason: "raw WebGPU' "$owner")" -eq 11
test ! -e "$root/src/lib/nogc_sync_mut/gpu/engine2d/webgpu_ffi.spl"
test "$(grep -c '^extern fn ' "$session")" -eq 0
! grep -Eq '^[[:space:]]*.*rt_wgpu_[A-Za-z0-9_]*\(' "$session"
grep -q 'contains no SFFI boundary' "$session"

echo 'WebGPU SFFI owner authority: PASS (one raw owner; duplicate/providerless facades absent; provider remains unsafe/unsigned/unverified)'
