#!/bin/sh
set -eu

provider=src/compiler_rust/compiler/src/interpreter_extern/memory.rs
registration=src/compiler_rust/compiler/src/interpreter_extern/mod.rs
registry=src/compiler_rust/compiler/src/codegen/runtime_sffi.rs
native=src/compiler_rust/runtime/src/value/heap.rs

enabled="$(sed -n '/^pub fn rt_mem_attr_enabled/,/^}/p' "$provider")"
printf '%s\n' "$enabled" | rg -q 'if !args.is_empty\(\)'

owner="$(sed -n '/^pub fn rt_mem_attr_set_owner/,/^}/p' "$provider")"
printf '%s\n' "$owner" | rg -q 'if args.len\(\) != 1'
printf '%s\n' "$owner" | rg -q 'let Value::Str\(name\) = &args\[0\] else'
! printf '%s\n' "$owner" | rg -q 'if let Some'

for name in rt_mem_attr_report rt_mem_attr_report_print; do
    body="$(sed -n "/^pub fn ${name}/,/^}/p" "$provider")"
    printf '%s\n' "$body" | rg -q 'if args.len\(\) != 1'
    printf '%s\n' "$body" | rg -q 'args\[0\]\.as_int\(\)\?\.max\(0\)'
    ! printf '%s\n' "$body" | rg -q '_ => 16'
done

for name in rt_mem_attr_enabled rt_mem_attr_set_owner \
    rt_mem_attr_report rt_mem_attr_report_print; do
    rg -q "insert_simple!\(\"${name}\"" "$registration"
done

# Native set-owner intentionally uses the compiler text ABI (ptr,len), while
# the interpreter receives one already-lifted text Value. Report functions are
# not promoted to cross-lane verified without typed native registry entries.
rg -q 'RuntimeFuncSpec::new\("rt_mem_attr_set_owner", &\[I64, I64\], &\[\]\)' "$registry"
rg -q '^pub unsafe extern "C" fn rt_mem_attr_set_owner\(name_ptr: \*const u8, name_len: u64\)' "$native"
! rg -q 'RuntimeFuncSpec::new\("rt_mem_attr_report"' "$registry"
! rg -q 'RuntimeFuncSpec::new\("rt_mem_attr_report_print"' "$registry"

echo "interpreter memory-attribution SFFI contract audit: PASS (no fabricated defaults; lane split remains explicitly unverified)"
