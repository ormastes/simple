#!/bin/sh
# Static raw-file-read elimination guard for Portal static assets.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/app/portal/server.spl"

test "$(grep -c '^extern fn rt_file_read_text' "$module")" -eq 0
test "$(grep -c '^use std.io_runtime.{read_file_text_result}$' "$module")" -eq 1
test "$(grep -c 'read_file_text_result(full_path)' "$module")" -eq 1
test "$(grep -c 'Could not read asset: {clean_path}' "$module")" -eq 1
test "$(grep -c '_html_ok(content, mime)' "$module")" -eq 1

echo 'Portal server SFFI authority: PASS local_raw_declarations=0 result_lifts=1 http_error_lifts=1 artifact_admission=absent'
