#!/bin/sh
set -eu

module=src/compiler/20.hir/hir_lowering/types.spl
facade=src/lib/nogc_sync_mut/io_runtime.spl

if rg -q '^extern fn rt_env_get|rt_env_get\(' "$module"; then
    echo "HIR types must use the canonical environment facade" >&2
    exit 1
fi

test "$(rg -c '^extern fn rt_(enum_discriminant|transient_heap_promote|heap_ref_wellformed)' "$module")" -eq 3
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 3
test "$(rg -c 'rt_enum_discriminant\(' "$module")" -eq 2
test "$(rg -c 'rt_transient_heap_promote\(' "$module")" -eq 2
test "$(rg -c 'rt_heap_ref_wellformed\(' "$module")" -eq 4
test "$(rg -c '_hir_diagnostic_promote_raw\(' "$module")" -eq 4
test "$(rg -c 'env_get_opt\(key\)' "$module")" -eq 1
rg -Uq '@always_inline\npub fn env_get_opt\(key: text\) -> text\?:' "$facade"
