#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
modules="
$root/src/os/apps/sshd/ssh_transport.spl
$root/src/os/apps/sshd/ssh_packet.spl
$root/src/os/apps/sshd/ssh_kex_primitives.spl
$root/src/os/apps/sshd/ssh_identification.spl
"

for module in $modules; do
    if grep -E '(^extern fn |rt_bytes_u8_at|rt_push_byte)' "$module" >/dev/null; then
        echo "Pure Simple SSH byte utility regained an SFFI boundary: $module" >&2
        exit 1
    fi
done

for module in \
    "$root/src/os/apps/sshd/ssh_transport.spl" \
    "$root/src/os/apps/sshd/ssh_packet.spl" \
    "$root/src/os/apps/sshd/ssh_kex_primitives.spl"; do
    grep -q 'idx >= .*\.len()' "$module"
    grep -q '\[idx\]' "$module"
done

grep -q 'out.push((line.char_at(i).to_i64() & 0xFF).to_u8())' \
    "$root/src/os/apps/sshd/ssh_identification.spl"

echo "Pure Simple SSH byte boundary audit: PASS (four utility modules have no byte-access/push SFFI)"
