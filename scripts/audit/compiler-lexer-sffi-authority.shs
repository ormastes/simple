#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/10.frontend/core/lexer.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in rt_file_read_text rt_env_get rt_env_set rt_array_free; do
    [ "$(grep -Ec "^extern fn ${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$module")" -eq 1 ]
    grep -q "RuntimeFuncSpec::new(\"$raw\"" "$registry"
done
grep -q '^extern fn rt_file_read_text(path: text) -> text?$' "$module"
grep -q '^extern fn rt_env_get(key: text) -> text?$' "$module"

[ "$(grep -c '^@unsafe(' "$module")" -eq 4 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 4 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 4 ]
for expected in _sffi_file_read_text:3 _sffi_env_get:14 \
    _sffi_env_set:29 _sffi_array_free:5; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done

# The character-validation loop must remain pure Simple; environment I/O in
# that loop would turn source length into foreign-dispatch count.
if sed -n '/^fn env_value_nul_free/,/^fn lex_state_get/p' "$module" | grep -q '_sffi_'; then
    echo "compiler lexer introduced foreign dispatch in the per-character NUL scan" >&2
    exit 1
fi
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "compiler lexer SFFI authority audit: PASS (all raw calls confined; nullable reads truthful; character loop remains foreign-call-free)"
