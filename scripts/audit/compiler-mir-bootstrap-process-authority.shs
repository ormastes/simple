#!/bin/sh
set -eu

globals=src/compiler/50.mir/_MirLowering/bootstrap_globals.spl
types=src/compiler/50.mir/_MirLowering/bootstrap_type_registration.spl

if rg -q 'rt_(exit|string_len)\(' "$globals" "$types"; then
    echo "MIR bootstrap modules must use canonical process authority and no dead raw length helper" >&2
    exit 1
fi
test "$(rg -c '^[[:space:]]+exit\(1\)' "$globals")" -eq 11
test "$(rg -c '^[[:space:]]+exit\(1\)' "$types")" -eq 1
rg -q '^use std\.io_runtime\.\{exit\}$' "$globals"
rg -q '^use std\.io_runtime\.\{exit\}$' "$types"
if rg -q '_mir_text_index_of' "$globals"; then
    echo "unused bootstrap text-index helper must not return" >&2
    exit 1
fi
