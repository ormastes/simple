#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
stdio="$root/src/runtime/simple_core/core_stdio.spl"
math="$root/src/runtime/simple_core/core_math.spl"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

[ "$(grep -Ec '^extern fn fflush\(' "$stdio")" -eq 1 ]
[ "$(grep -Ec '^[[:space:]]+fflush\(' "$stdio")" -eq 1 ]
[ "$(grep -c '^@unsafe(' "$stdio")" -eq 1 ]
[ "$(grep -c '^@always_inline$' "$stdio")" -eq 1 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$stdio")" -eq 1 ]
[ "$(grep -o '_sffi_fflush(' "$stdio" | wc -l)" -eq 3 ]
[ "$(grep -c 'return _sffi_fflush(0)' "$stdio")" -eq 2 ]
if grep -q 'return 0' "$stdio"; then
    echo "simple-core stdio regained fabricated flush success" >&2
    exit 1
fi

[ "$(grep -Ec '^extern fn sqrt\(' "$math")" -eq 1 ]
[ "$(grep -Ec '^[[:space:]]+sqrt\(' "$math")" -eq 1 ]
[ "$(grep -c '^@unsafe(' "$math")" -eq 1 ]
[ "$(grep -c '^@always_inline$' "$math")" -eq 1 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$math")" -eq 1 ]
[ "$(grep -o '_sffi_sqrt(' "$math" | wc -l)" -eq 2 ]

grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "simple-core stdio/math authority audit: PASS (raw calls confined; flush status preserved; one-call hot paths retained)"
