#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
canonical="$root/src/lib/nogc_sync_mut/io/metal_sffi.spl"
engine2d="$root/src/lib/nogc_sync_mut/gpu/engine2d/metal_session.spl"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/gpu.rs"

if [ "$(grep -c '^[[:space:]]*extern fn rt_metal_' "$canonical")" -ne 38 ]; then
    echo "canonical Metal declaration inventory changed without ABI review" >&2
    exit 1
fi
canonical_declarations=$(grep -c '^[[:space:]]*extern fn ' "$canonical")
if [ "$canonical_declarations" -ne 40 ]; then
    echo "canonical Metal helper declaration inventory changed without ABI review" >&2
    exit 1
fi
if grep -n -E 'rt_metal_(create_sampler|create_swapchain|present)|Metal(Sampler|Swapchain)' "$canonical"; then
    echo "unimplemented Metal graphics stubs must not be exposed as values" >&2
    exit 1
fi
canonical_tagged=$(awk '
    /^@unsafe\(.*capabilities: \[ffi\]\)$/ { previous_is_ffi = 1; next }
    /^[[:space:]]*extern fn / {
        if (previous_is_ffi) tagged++
    }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$canonical")
if [ "$canonical_tagged" -ne "$canonical_declarations" ]; then
    echo "every canonical Metal declaration must be explicitly unsafe(ffi)" >&2
    exit 1
fi
# The GPU-session Metal provider checks were removed with the orphan
# src/lib/gc_async_mut/gpu/session/ layer (see
# doc/08_tracking/bug/gpu_session_layer_orphan_deleted_2026-09-06.md).
# The canonical and Engine2D inventories below are unchanged.
if grep -n -E 'extern fn rt_metal_(create_device|create_compute_pipeline)\(' "$engine2d"; then
    echo "Engine2D pseudo providers collide with canonical Metal symbols" >&2
    exit 1
fi
if [ "$(grep -c '^[[:space:]]*extern fn rt_engine2d_metal_session_' "$engine2d")" -ne 10 ]; then
    echo "Engine2D Metal pseudo-provider inventory changed without admission review" >&2
    exit 1
fi
if ! grep -q 'foreign text contract returned null' "$interpreter" ||
   sed -n '/^fn c_ptr_to_string/,/^}/p' "$interpreter" | grep -q 'String::new()'; then
    echo "Metal/CUDA foreign text must reject null rather than fabricate empty text" >&2
    exit 1
fi
grep -q 'fn null_foreign_text_is_a_contract_error()' "$interpreter"

if ! awk '
    function indent(line, copy) {
        copy = line
        sub(/[^ ].*$/, "", copy)
        return length(copy)
    }
    /^@unsafe\(.*capabilities: \[.*ffi.*\]\)$/ {
        next_function_unsafe = 1
        next
    }
    /^fn / {
        function_indent = indent($0)
        function_unsafe = next_function_unsafe
        next_function_unsafe = 0
        inside_function = 1
        next
    }
    inside_function && NF && indent($0) <= function_indent { function_unsafe = 0; inside_function = 0 }
    /unsafe\(capabilities: \[.*ffi.*\]\):[[:space:]]*$/ {
        unsafe_indent = indent($0)
        inside_unsafe = 1
        next
    }
    inside_unsafe && NF && indent($0) <= unsafe_indent { inside_unsafe = 0 }
    /rt_(metal_[A-Za-z0-9_]+|is_interpreter_runtime|cstring_to_text)\(/ &&
        !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / &&
        !inside_unsafe && !function_unsafe {
        print "unscoped Metal call at line " FNR ": " $0 > "/dev/stderr"
        failed = 1
    }
    END { if (failed) exit 1 }
' "$canonical"; then
    exit 1
fi
if awk '/^[[:space:]]*else:/ { after_else = 1; next }
        after_else && NF { if ($0 ~ /^[[:space:]]*true[[:space:]]*$/) found = 1; after_else = 0 }
        END { exit !found }' "$canonical"; then
    echo "Metal cleanup/wait wrappers must not fabricate success for invalid handles" >&2
    exit 1
fi
grep -q 'data.len() > buf.size' "$canonical"
grep -q 'size <= 0' "$canonical"

echo "Metal SFFI symbol identity audit: PASS"
