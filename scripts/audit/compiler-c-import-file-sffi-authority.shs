#!/bin/sh
set -eu

module=src/compiler/10.frontend/c_import/__init__.spl

if rg -q '^extern fn rt_file_read_text\(' "$module"; then
    echo "C import must not own raw file-read authority" >&2
    exit 1
fi
rg -q '^use std\.io_runtime\.\{file_read_result\}$' "$module"
rg -q '^fn read_c_header\(path: text\) -> Result<text, text>:$' "$module"
test "$(rg -c 'file_read_result\(' "$module")" -eq 1
test "$(rg -c 'read_c_header\(' "$module")" -eq 2
rg -q 'case Err\(_\):' "$module"
rg -q 'errors: \["failed to read header: " \+ resolved\]' "$module"
