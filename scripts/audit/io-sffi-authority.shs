#!/bin/sh
# Source-authority ratchet for the owned filesystem/path SFFI facade.
# Verdict harness (.claude/rules/vcs.md): verdict LAST on stdout, exit 0/1/2,
# non-vacuity absolute. NOTE: deliberately `set -u` WITHOUT `set -e` — `grep -c`
# exits 1 on zero matches, and under `-e` that killed this guard silently
# (exit 1, no output) for the whole time it sat RED.
set -u
A_CHECKED=0; A_FAILED=0; A_MSGS=''
_fail() { A_FAILED=$((A_FAILED+1)); A_MSGS="${A_MSGS}${A_MSGS:+; }$1"; }
ck() { # ck <desc> <cmd...>  -- status read into a var on the NEXT line, never via a pipe
    _d=$1; shift
    "$@" >/dev/null 2>&1
    _rc=$?
    A_CHECKED=$((A_CHECKED+1)); [ "$_rc" -eq 0 ] || _fail "$_d"
}
cknot() { # cknot <desc> <cmd...>  -- must FAIL
    _d=$1; shift
    "$@" >/dev/null 2>&1
    _rc=$?
    A_CHECKED=$((A_CHECKED+1)); [ "$_rc" -ne 0 ] || _fail "$_d"
}
# Trim surrounding whitespace before comparing. BSD `wc` (macOS) right-aligns its
# count in an 8-column field, so `$(... | wc -w)` is "       0" there and "0" on
# GNU coreutils. This is a STRING comparison, so on macOS the assertion below
# failed with the self-refuting message
#   "externs missing an @unsafe(...) annotation (expected 0, actual        0)"
# and, because io-sffi-authority is reached from the blocking push-tier gate
# push-sffi-v2-authority, it blocked every push from a mac. The sibling audits
# escape this only because they use `-eq`, which ignores leading blanks.
_trim() { printf '%s' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }
ckeq() { # ckeq <desc> <actual> <expected>
    A_CHECKED=$((A_CHECKED+1))
    [ "$(_trim "$2")" = "$(_trim "$3")" ] || _fail "$1 (expected $3, actual $2)"
}
# grep -c prints 0 and exits 1 on no match; the count is what we want, not the status.
cnt() { grep -c "$1" "$2" 2>/dev/null; }
cnte() { grep -Ec "$1" "$2" 2>/dev/null; }
need_file() { [ -f "$1" ] || { echo "$2: ERROR — nothing was checked (missing $1)"; exit 2; } }
verdict() {
    [ "$A_CHECKED" -gt 0 ] || { echo "$1: ERROR — nothing was checked"; exit 2; }
    [ "$A_FAILED" -eq 0 ] || { echo "$1: FAIL — $A_FAILED of $A_CHECKED assertion(s) failed: $A_MSGS"; exit 1; }
    echo "$1: PASS — $A_CHECKED assertion(s) checked${VERDICT_EXTRA:-}"
    exit 0
}

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/lib/nogc_sync_mut/sffi/io.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"
L='I/O SFFI authority audit'
need_file "$module" "$L"
need_file "$registry" "$L"
need_file "$interpreter" "$L"

# Counts grew 34->36 / 36->38 / 28->29 / 18->19 when `rt_file_read_text` and
# `rt_path_basename` landed; both arrived with a full `@unsafe(reason: ...,
# capabilities: [ffi])` extern annotation and an @always_inline wrapper, so
# this is legitimate drift, not an unannotated breach.
ckeq 'extern declarations' "$(cnt '^extern fn ' "$module")" 36
ckeq 'mandatory-inline wrappers' "$(cnt '^@always_inline$' "$module")" 38
ckeq 'lexically scoped unsafe blocks' "$(cnt 'unsafe(capabilities: \[ffi\]):' "$module")" 29
ckeq 'unsafe facades (@unsafe minus externs)' "$(( $(cnt '^@unsafe(' "$module") - 36 ))" 19

# Every extern must carry its own capability annotation — a count alone would
# let an unannotated declaration hide inside the total.
unannotated=$(awk '/^extern fn /{ if (prev !~ /^@unsafe\(reason: .*capabilities: \[ffi\]\)$/ && prev !~ /^@always_inline$/) print $3 } { prev=$0 }' "$module" | sed 's/(.*//' | tr '\n' ' ')
ckeq 'externs missing an @unsafe(capabilities: [ffi]) annotation' "$(printf '%s' "$unannotated" | wc -w)" 0
ck 'rt_file_read_text annotated' grep -Fq '@unsafe(reason: "raw nullable text-read ABI; nil means read failure, distinct from an empty file", capabilities: [ffi])' "$module"
ck 'rt_path_basename annotated' grep -Fq '@unsafe(reason: "raw path text and runtime-owned basename ABI", capabilities: [ffi])' "$module"

symbols=$(sed -n 's/^extern fn \([A-Za-z0-9_]*\)(.*/\1/p' "$module")
both=0; one=0; none=0
for symbol in $symbols; do
    providers=0
    grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry" && providers=$((providers + 1))
    grep -q "insert_simple!(\"$symbol\"" "$interpreter" && providers=$((providers + 1))
    case "$providers" in
        2) both=$((both + 1)) ;;
        1) one=$((one + 1)) ;;
        0) none=$((none + 1)) ;;
    esac
done
ckeq 'symbols with native+interpreter providers' "$both" 28
ckeq 'symbols with exactly one provider' "$one" 2
ckeq 'symbols with no provider' "$none" 6

# Semantic statuses stay boolean and nullable reads lift into Result.
ck 'file_exists stays boolean' grep -q '^fn file_exists(path: text) -> bool:' "$module"
ck 'file_write_text stays boolean' grep -q '^fn file_write_text(path: text, content: text) -> bool:' "$module"
ck 'file_read_lines lifts to Result' grep -q '^fn file_read_lines(path: text) -> Result<\[text\], text>:' "$module"
ck 'file_mmap_read_bytes lifts to Result' grep -q '^fn file_mmap_read_bytes(path: text) -> Result<\[i64\], text>:' "$module"

# Ambiguous raw text/hash results remain unsafe, but their raw calls must be
# visibly scoped rather than relying on a function-wide unsafe annotation.
ck 'ambiguous text/hash reads keep lexically scoped raw calls' awk '
    /^fn (file_read_text|file_read|file_hash|file_hash_sha256)\(path: text\) -> text:$/ { wanted=1; next }
    wanted && /^    unsafe\(capabilities: \[ffi\]\):$/ { scoped=1; next }
    wanted && scoped && /^        rt_(file_read_text_rv|file_hash|file_hash_sha256)\(path\)$/ { count++; wanted=0; scoped=0 }
    wanted && /^fn / { exit 1 }
    END { exit count == 4 ? 0 : 1 }
' "$module"
ck 'file_read_text_nilable scopes its raw call' awk '
    /^fn file_read_text_nilable\(path: text\) -> text:$/ { wanted=1; next }
    wanted && /^    unsafe\(capabilities: \[ffi\]\):$/ { scoped=1; next }
    wanted && scoped && /^        rt_file_read_text\(path\)$/ { ok=1; exit 0 }
    wanted && /^fn / { exit 1 }
    END { exit ok ? 0 : 1 }
' "$module"

VERDICT_EXTRA=' (36 declarations; 29 lexical owners; 19 unsafe ambiguous/raw-handle facades; 28 both/2 one/6 no-provider; direct paths mandatory-inline)'
verdict "$L"
