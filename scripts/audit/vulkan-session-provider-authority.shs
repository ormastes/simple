#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
session="$root/src/lib/nogc_sync_mut/gpu/engine2d/vulkan_session.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"

# The retired session family had 19 declarations and no provider. It must not
# return as an unsafe-looking facade or collide with maintained rt_vk_* ABIs.
! grep -q '^extern fn rt_vk_' "$session"
! grep -q '^fn vulkan_session_.*(' "$session"
grep -q '^    static fn provider_available() -> bool:$' "$session"
grep -A1 '^    static fn provider_available() -> bool:$' "$session" | grep -q 'false'
grep -q 'VULKAN_SESSION_PROVIDER_ERROR' "$session"

# Keep the real Vulkan family visible so removal of the providerless parallel
# design cannot be mistaken for removal of maintained Vulkan support.
grep -q 'RuntimeFuncSpec::new("rt_vk_device_create"' "$registry"
grep -q 'RuntimeFuncSpec::new("rt_vk_command_buffer_begin"' "$registry"
grep -q 'RuntimeFuncSpec::new("rt_vk_command_buffer_submit"' "$registry"

echo 'Vulkan session provider authority: PASS (19 providerless declarations absent; compatibility facade fails closed; maintained typed Vulkan ABI retained)'
