#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/80.driver/driver_aot_native_output.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

raws="file_write_text file_read_text file_exists file_copy dir_create dir_remove_all env_set path_join env_get process_run hash_text stdout_flush simd_has_avx2"
for suffix in $raws; do
    raw="rt_$suffix"
    owner="_sffi_$suffix"
    [ "$(grep -Ec "^extern fn ${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^fn ${owner}\\(" "$module")" -eq 1 ]
done

grep -q '^extern fn rt_file_read_text(path: text) -> text?$' "$module"
grep -q '^extern fn rt_env_get(key: text) -> text?$' "$module"
[ "$(grep -c '^@unsafe(' "$module")" -eq 13 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 13 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 13 ]

for expected in file_write_text:5 file_read_text:3 file_exists:5 file_copy:3 \
    dir_create:3 dir_remove_all:2 env_set:2 path_join:7 env_get:16 \
    process_run:4 hash_text:3 stdout_flush:5 simd_has_avx2:2; do
    suffix=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "_sffi_${suffix}(" "$module" | wc -l)" -eq "$count" ]
done

for raw in rt_file_write_text rt_file_read_text rt_file_exists rt_file_copy \
    rt_dir_create rt_dir_remove_all rt_env_set rt_path_join rt_env_get \
    rt_process_run rt_hash_text; do
    grep -q "RuntimeFuncSpec::new(\"$raw\"" "$registry"
done
grep -q 'insert_simple!("rt_stdout_flush"' "$interpreter"
grep -q 'insert_simple!("rt_simd_has_avx2"' "$interpreter"

# Owners must disappear at codegen; otherwise they add one call per existing
# boundary invocation. The source fingerprint loop must retain exactly one
# hash dispatch per source plus one final manifest hash.
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"
[ "$(sed -n '/^pub fn driver_native_sources_fingerprint/,/^pub fn driver_native_module_is_export_facade/p' "$module" | grep -c '_sffi_hash_text(')" -eq 2 ]

# Cache-directory and ownership-marker failures must not be accepted as a
# successful native build.
grep -q 'native-build failed to create cache directory' "$module"
grep -q 'native-build failed to write cache ownership marker' "$module"

echo "AOT native-output SFFI authority audit: PASS (13 raw ABIs confined; nullable reads truthful; cache setup fails closed; no added hot-loop dispatch)"
