#!/bin/sh
# Static lexical-boundary guard for dashboard remote-session collection.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/app/llm_dashboard/collectors/remote_collector.spl"

test "$(grep -c '^@unsafe(reason: "raw session-file text ABI; this collector has no error-result channel", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^extern fn rt_file_read_text(path: text) -> text$' "$module")" -eq 1
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_file_read_text(path)' "$module")" -eq 1

echo 'Dashboard remote collector SFFI authority: PASS declarations=1 lexical_calls=1 direct_call_shape=preserved no_false_safe_absence=preserved artifact_admission=absent'
