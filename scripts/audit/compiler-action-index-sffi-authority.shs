#!/bin/sh
set -eu

module=src/compiler/80.driver/cache/action_index/action_index.spl

if rg -q '^extern fn rt_' "$module"; then
    echo "action index must not own raw SFFI declarations" >&2
    exit 1
fi
test "$(rg -c 'file_exists\(' "$module")" -eq 1
test "$(rg -c 'file_read_result\(' "$module")" -eq 1
test "$(rg -c 'dir_create_all\(' "$module")" -eq 2
test "$(rg -c 'getpid\(' "$module")" -eq 1
test "$(rg -c 'time_now_unix_micros\(' "$module")" -eq 1
test "$(rg -c 'file_write_exact\(' "$module")" -eq 1
test "$(rg -c 'file_move_cross_device\(' "$module")" -eq 1
test "$(rg -c 'file_delete\(' "$module")" -eq 1
rg -q 'case Err\(_\): return nil' "$module"
rg -q 'match action_index_read_raw(root, ns, action_digest):' "$module"
