#!/bin/sh
# Static lexical-boundary guard for the hot SIMD text/index owners.
# It checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
binding="$root/src/lib/common/encoding/simd_text_ffi.spl"
compat="$root/src/lib/encoding/simd_text_sffi.spl"
width="$root/src/lib/common/encoding/width_index.spl"
utf8="$root/src/lib/common/encoding/utf8.spl"
header="$root/src/runtime/runtime.h"

test "$(grep -c '^@unsafe(' "$binding")" -eq 14
test "$(grep -c '^extern fn rt_' "$binding")" -eq 14
test "$(grep -c '^@unsafe(' "$compat")" -eq 6
test "$(grep -c '^extern fn rt_' "$compat")" -eq 6
grep -q 'int64_t  rt_swi_build(int64_t value)' "$header"
grep -q 'int64_t  rt_rank_select_build(int64_t value)' "$header"

width_calls=$(grep -Ec 'unsafe\(capabilities: \[ffi\]\):.*rt_(swi_|rank_|select_|text_count_codepoints_cached)' "$width")
test "$width_calls" -eq 12
utf8_calls=$(grep -Ec 'unsafe\(capabilities: \[ffi\]\):.*rt_text_(count_codepoints_cached|is_ascii|validate_utf8)' "$utf8")
test "$utf8_calls" -eq 3

echo 'SIMD text SFFI authority: PASS declarations=20 lexical_hot_calls=15 direct_call_shape=preserved artifact_admission=absent'
