#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/io/volatile_ops.spl"
facade="$root/src/app/io/volatile_ops.spl"
registry="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^extern fn rt_\(volatile_\|memory_barrier\|load_barrier\|store_barrier\)' "$owner")" -eq 11 ]
[ "$(grep -c '^@unsafe(reason: .*capabilities: \[ffi' "$owner")" -eq 11 ]
[ "$(grep -c '^fn \(volatile_read_u64_required\|volatile_write_u64_required\|memory_barrier_required\)' "$owner")" -eq 3 ]
[ "$(grep -c '^    unsafe(capabilities: \[ffi' "$owner")" -eq 14 ]

grep -q '^export use std.nogc_sync_mut.io.volatile_ops.{' "$facade"
! grep -q '^extern fn ' "$facade"
! grep -q '\brt_\(volatile_\|memory_barrier\|load_barrier\|store_barrier\)' "$facade"
! grep -q '^fn ' "$facade"

# All lanes expose the complete family; no read, write, or fence can fall back
# to a fabricated zero/no-op result.
! grep -q '__fallback' "$owner"
grep -q '^fn has_runtime_volatiles() -> bool:$' "$owner"
grep -A4 '^fn has_runtime_volatiles() -> bool:$' "$owner" | grep -q '^    true$'
for barrier in rt_memory_barrier rt_load_barrier rt_store_barrier; do
    [ "$(grep -c "insert_simple!(\"$barrier\"" "$registry")" -eq 1 ]
done

echo 'Volatile SFFI authority audit: PASS (one canonical owner; app facade has no raw boundary; 11 annotated operations/14 confined call regions; complete interpreter barrier registry; zero fabricated fallbacks)'
