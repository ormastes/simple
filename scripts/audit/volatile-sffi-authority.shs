#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/io/volatile_ops.spl"
facade="$root/src/app/io/volatile_ops.spl"

[ "$(grep -c '^extern fn rt_\(volatile_\|memory_barrier\|load_barrier\|store_barrier\)' "$owner")" -eq 11 ]
[ "$(grep -c '^@unsafe(reason: .*capabilities: \[ffi' "$owner")" -eq 3 ]
[ "$(grep -c '^fn \(volatile_read_u64_required\|volatile_write_u64_required\|memory_barrier_required\)' "$owner")" -eq 3 ]
[ "$(grep -c '^    unsafe(capabilities: \[ffi' "$owner")" -eq 6 ]

grep -q '^export use std.nogc_sync_mut.io.volatile_ops.{' "$facade"
! grep -q '^extern fn ' "$facade"
! grep -q '\brt_\(volatile_\|memory_barrier\|load_barrier\|store_barrier\)' "$facade"
! grep -q '^fn ' "$facade"

# Do not conceal the remaining fail-open fallback debt while the other eight
# declarations and generic wrappers await a capability-correct migration.
[ "$(grep -c '__fallback' "$owner")" -eq 22 ]
grep -q '^fn has_runtime_volatiles() -> bool:$' "$owner"
grep -A4 '^fn has_runtime_volatiles() -> bool:$' "$owner" | grep -q '^    false$'

echo 'Volatile SFFI authority audit: PASS (one canonical owner; app facade has no raw boundary; 3 native-required operations confined; 8 raw declarations plus fail-open generic fallback remain migration debt)'
