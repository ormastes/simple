#!/bin/sh
set -eu

module=src/compiler/10.frontend/core/interpreter/eval_decls.spl

if rg -q '^extern fn rt_env_get\(' "$module"; then
    echo "declaration evaluation must not own raw environment authority" >&2
    exit 1
fi
rg -q '^use std\.io_runtime\.\{env_get_opt\}$' "$module"
test "$(rg -c 'env_get_opt\("SIMPLE_SAFETY_PROFILE"\)' "$module")" -eq 1
rg -q 'eval_apply_assurance_profile\(env_get_opt\("SIMPLE_SAFETY_PROFILE"\) \?\? ""\)' "$module"
