#!/bin/sh
set -eu

module=src/compiler/80.driver/driver_pass_receipt.spl
facade=src/lib/nogc_sync_mut/io_runtime.spl

if rg -q '^extern fn rt_' "$module"; then
    echo "pass receipts must use canonical runtime facades" >&2
    exit 1
fi

rg -q '^use std\.io_runtime\.\{env_get_opt, file_append_text\}$' "$module"
test "$(rg -c 'env_get_opt\("SIMPLE_PASS_RECEIPT"\)' "$module")" -eq 1
test "$(rg -c 'file_append_text\(sink, line \+ "\\n"\)' "$module")" -eq 1
rg -q 'if not file_append_text' "$module"
rg -q 'E-SFFI-014: pass receipt append failed' "$module"
rg -Uq '@always_inline\npub fn file_append_text\(path: text, content: text\) -> bool:' "$facade"
