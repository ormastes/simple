#!/bin/sh
# Static lexical-boundary guard for GPU Engine3D scalar-math hooks.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
hooks="$root/src/lib/nogc_sync_mut/gpu/engine3d/math_hooks.spl"
color="$root/src/lib/nogc_sync_mut/gpu/engine3d/color3d.spl"

test "$(grep -c '^@unsafe(reason: "raw scalar math ABI", capabilities: \[ffi\])$' "$hooks")" -eq 3
test "$(grep -c '^extern fn rt_math_' "$hooks")" -eq 3
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_math_' "$hooks")" -eq 3
test "$(grep -c '^@unsafe(reason: "raw scalar math ABI", capabilities: \[ffi\])$' "$color")" -eq 2
test "$(grep -c '^extern fn rt_math_' "$color")" -eq 2
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_math_' "$color")" -eq 2

echo 'GPU Engine3D math SFFI authority: PASS declarations=5 lexical_hot_calls=5 direct_call_shape=preserved artifact_admission=absent'
