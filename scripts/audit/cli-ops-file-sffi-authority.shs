#!/bin/sh
set -eu

module=src/app/io/cli_ops.spl

test "$(rg '^extern fn rt_(path_absolute|file_read_text|file_write_text_at)' "$module" | wc -l)" -eq 0
test "$(rg 'rt_(path_absolute|file_read_text|file_write_text_at)\(' "$module" | wc -l)" -eq 0
rg -q 'file_read_result' "$module"
rg -q 'file_write_text_at' "$module"
rg -q 'path_absolute' "$module"

# Copy remains one source read and one destination write, with no read-back.
body="$(sed -n '/^fn _cli_file_copy_impl/,/^fn _cli_dir_create_impl/p' "$module")"
test "$(printf '%s\n' "$body" | rg '_cli_file_read_impl\(' | wc -l)" -eq 1
test "$(printf '%s\n' "$body" | rg 'file_write_text_at\(' | wc -l)" -eq 1
