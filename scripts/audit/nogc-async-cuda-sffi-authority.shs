#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_async_mut/cuda/mod.spl"

if [ "$(grep -c '^[[:space:]]*unsafe(capabilities: \[ffi' "$owner")" -ne 38 ]; then
    echo "no-GC async CUDA lexical authority inventory changed without review" >&2
    exit 1
fi

awk '
    function indent(line, copy) {
        copy = line
        sub(/[^ ].*$/, "", copy)
        return length(copy)
    }
    /^[[:space:]]*(static fn|fn|me) / {
        if (has_raw && !leading_scope) {
            print "raw call without leading lexical authority: " signature > "/dev/stderr"
            failed = 1
        }
        signature = $0
        method_indent = indent($0)
        has_raw = 0
        leading_scope = 0
        first_body = 1
        next
    }
    signature != "" && NF && indent($0) > method_indent {
        if (first_body) {
            leading_scope = $0 ~ /^[[:space:]]*unsafe\(capabilities: \[ffi([^]]*raw_ptr)?\]\):/
            first_body = 0
        }
        if ($0 !~ /^[[:space:]]*#/ && $0 ~ /(rt|spl)_[A-Za-z0-9_]+\(/) has_raw = 1
    }
    END {
        if (has_raw && !leading_scope) {
            print "raw call without leading lexical authority: " signature > "/dev/stderr"
            failed = 1
        }
        if (failed) exit 1
    }
' "$owner"

calls=$(awk '
    !/^[[:space:]]*#/ {
        line = $0
        while (match(line, /(rt|spl)_[A-Za-z0-9_]+\(/)) {
            calls += 1
            line = substr(line, RSTART + RLENGTH)
        }
    }
    END { print calls + 0 }
' "$owner")
if [ "$calls" -ne 51 ]; then
    echo "no-GC async CUDA raw-call inventory changed without review" >&2
    exit 1
fi

grep -q 'val CUDA_MAX_BUFFER_BYTES: i64 = 268435456' "$owner"
grep -q 'right > CUDA_MAX_F64_ELEMENTS / left' "$owner"
if [ "$(grep -c '^@inline$' "$owner")" -lt 2 ]; then
    echo "CUDA checked extent helpers must remain inline on allocation hot paths" >&2
    exit 1
fi
if grep -E 'CudaBuffer[.]allocate\([^)]*[*][[:space:]]*8' "$owner" >/dev/null; then
    echo "CUDA allocation extent bypasses checked byte geometry" >&2
    exit 1
fi

echo "no-GC async CUDA SFFI authority audit: PASS (51 raw calls in 38 leading lexical scopes; 256 MiB checked byte/product geometry; APIs preserved)"
