#!/bin/sh
# Static lexical-boundary guard for SMF hot-reload disk operations.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/40.mono/monomorphize/hot_reload.spl"

test "$(grep -c '^@unsafe(reason: "raw SMF hot-reload' "$module")" -eq 4
test "$(grep -c '^extern fn rt_file_' "$module")" -eq 4
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_file_' "$module")" -eq 4
test "$(grep -c 'HotReloadResult.IoError' "$module")" -ge 1

echo 'Mono hot-reload SFFI authority: PASS declarations=4 lexical_disk_calls=4 result_error_lifts=present artifact_admission=absent'
