#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/kernel/net/rt_net_socket_facade.spl"

if grep -E '(serial_println|extern fn rt_bytes_u8_at)' "$module" >/dev/null; then
    echo "network facade regained diagnostic or byte-access FFI" >&2
    exit 1
fi

grep -q '^extern fn rt_thread_sleep(ms: i64)$' "$module"
if grep -q '^extern fn rt_thread_sleep(ms: i64) ->' "$module"; then
    echo "network facade sleep ABI regained a fabricated result" >&2
    exit 1
fi

grep -q 'if idx >= data.len():' "$module"
grep -q 'data\[idx\].to_u32()' "$module"
grep -q '_rt_net_exact_write_result(rc, data.len())' "$module"
grep -q '_rt_net_exact_write_result(raw_rc, 22u64)' "$module"
grep -q 'bytes.len() > max_len.to_u64()' "$module"
grep -q 'rt_boot_tcp_read_bytes_for_fd(current.os_fd.to_i64(), max_len)' "$module"
grep -q 'rt_boot_tcp_read_bytes_for_fd(current.os_fd.to_i64(), 1)' "$module"
grep -q 'payload.len() > RT_NET_SSH_ENCRYPTED_BODY_MAX.to_u64()' "$module"
grep -q 'raw_os_fd > 2147483647i64' "$module"
grep -q 'client_os_fd > 2147483647i64' "$module"

scopes=$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")
if [ "$scopes" -ne 21 ]; then
    echo "network facade lexical FFI scope inventory changed" >&2
    exit 1
fi

echo "network facade contract audit: PASS (raw diagnostics/accessor removed; owner, extent, write, fd, and void-sleep contracts enforced)"
