#!/bin/sh
# Static raw-file-read elimination guard for dashboard scheduling.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/app/llm_dashboard/scheduler/scheduler.spl"

test "$(grep -c '^extern fn rt_file_read_text' "$module")" -eq 0
test "$(grep -c '^use std.io_runtime.{read_file_text_result}$' "$module")" -eq 1
test "$(grep -c '^fn scheduler_list_tasks() -> Result<\[ManagedTask\], text>:$' "$module")" -eq 1
test "$(grep -c 'read_file_text_result(path)' "$module")" -eq 1
test "$(grep -c 'case Err(_): return' "$module")" -eq 2

echo 'Dashboard scheduler SFFI authority: PASS local_raw_declarations=0 result_lifts=1 fail_closed_callers=2 artifact_admission=absent'
