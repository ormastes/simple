#!/bin/sh
set -eu

module=src/compiler/80.driver/driver_public_compile_vhdl.spl

rg -q '^@unsafe\(reason: "raw nullable VHDL source-map read", capabilities: \[ffi\]\)$' "$module"
rg -q '^extern fn rt_file_read_text\(path: text\) -> text\?$' "$module"
test "$(rg -c '^fn _public_vhdl_read_raw\(' "$module")" -eq 1
test "$(rg -c 'rt_file_read_text\(' "$module")" -eq 2
test "$(rg -c '_public_vhdl_read_raw\(' "$module")" -eq 3
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 1
rg -q 'failed to read VHDL source-map input' "$module"
rg -q 'failed to read generated VHDL source-map output' "$module"
