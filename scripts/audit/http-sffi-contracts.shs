#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
files="
$root/src/lib/nogc_sync_mut/io/http_sffi.spl
"
facades="
$root/src/app/io/http_sffi.spl
$root/src/app/io/http_ffi.spl
"

for file in $files; do
    declarations=$(grep -Ec '^[[:space:]]*extern fn (rt_http_|rt_ws_)' "$file")
    if [ "$declarations" -ne 27 ]; then
        echo "HTTP/WebSocket SFFI inventory changed without contract review: $file" >&2
        exit 1
    fi
    tagged=$(awk '
        /^@unsafe\(.*capabilities: \[ffi\]\)$/ { previous_is_ffi = 1; next }
        /^[[:space:]]*extern fn (rt_http_|rt_ws_)/ {
            if (previous_is_ffi) tagged++
        }
        { previous_is_ffi = 0 }
        END { print tagged + 0 }
    ' "$file")
    if [ "$tagged" -ne "$declarations" ]; then
        echo "every HTTP/WebSocket declaration must be explicitly unsafe(ffi): $file" >&2
        exit 1
    fi
done

for facade in $facades; do
    grep -q '^export use std.nogc_sync_mut.io.http_sffi.{' "$facade"
    ! grep -q '^extern fn ' "$facade"
    ! grep -Eq '(rt_http_|rt_ws_)[A-Za-z0-9_]*[(]' "$facade"
done

grep -q 'empty text is ambiguous' "$root/src/lib/nogc_sync_mut/io/http_sffi.spl" || {
    echo "WebSocket receive ambiguity must remain explicit" >&2
    exit 1
}

v2=rt_http_request_v2
grep -q "extern fn $v2(" "$root/src/lib/nogc_sync_mut/io/http_sffi.spl"
grep -q "int64_t $v2(" "$root/src/runtime/runtime_native.c"
grep -q "int64_t  $v2(" "$root/src/runtime/runtime.h"
grep -q "pub fn $v2(" "$root/src/compiler_rust/compiler/src/interpreter_extern/network/mod.rs"
grep -q "\"$v2\"" "$root/src/compiler_rust/common/src/runtime_symbols.rs"
grep -q "RuntimeFuncSpec::new(\"$v2\"" "$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
grep -q "insert_simple!(\"$v2\"" "$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"
grep -q 'body: \[u8\]' "$root/src/lib/nogc_sync_mut/io/http_sffi.spl"
grep -q -- '-> (i64, text, text, \[u8\], text)' "$root/src/lib/nogc_sync_mut/io/http_sffi.spl"

echo "HTTP/WebSocket SFFI contract audit: PASS (lossless v2 binary body/header contract present; unsigned/unverified)"
