#!/bin/sh
# X25519 errors must never be represented as a usable empty byte array.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/io/dh_sffi.spl"
provider="$root/src/compiler_rust/runtime/src/value/sffi/dh.rs"

test "$(grep -c '^extern fn rt_dh_curve25519_' "$owner")" -eq 4
test "$(grep -c '^@unsafe(.*capabilities: \[ffi\])$' "$owner")" -eq 4
test "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$owner")" -eq 4
grep -q 'fn dh_curve25519_keypair() -> Result<i64, text>:' "$owner"
grep -q 'fn dh_curve25519_public_key(handle: i64) -> Result<\[i64\], text>:' "$owner"
grep -q 'fn dh_curve25519_shared_secret(handle: i64, their_pub: \[i64\]) -> Result<\[i64\], text>:' "$owner"
test "$(grep -c 'if .*\.len() != 32:' "$owner")" -eq 3
if grep -q 'or empty array on error' "$owner"; then
    echo 'Curve25519 wrapper still documents fabricated empty-array errors' >&2
    exit 1
fi
for symbol in keypair public_key shared_secret free; do
    grep -q "fn rt_dh_curve25519_${symbol}" "$provider"
done
echo 'Curve25519 DH SFFI authority: PASS (4 scoped raw calls; Result rejects empty-array failure sentinels)'
