#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
provider="$root/src/runtime/spl_winit/src/lib.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/winit_sffi/winit_sffi_window.rs"
wrapper="$root/src/lib/nogc_sync_mut/io/window_winit.spl"

for symbol in rt_winit_window_set_fullscreen rt_winit_window_is_fullscreen \
    rt_winit_window_set_position; do
    if ! grep -B1 -F "extern fn $symbol" "$wrapper" | grep -Fq 'sentinel'; then
        echo "FAIL: $symbol lacks exact status/sentinel metadata" >&2
        exit 1
    fi
done

if ! grep -Fq 'fn winit_window_is_fullscreen(win: WinitWindow) -> bool?' "$wrapper"; then
    echo 'FAIL: invalid fullscreen state must lift to typed absence' >&2
    exit 1
fi

for name in winit_window_set_fullscreen winit_window_is_fullscreen winit_window_set_position; do
    body=$(sed -n "/^fn $name(/,/^$/p" "$wrapper")
    if ! printf '%s\n' "$body" | grep -Fq 'unsafe(capabilities: [ffi]):'; then
        echo "FAIL: $name lacks lexical FFI scope" >&2
        exit 1
    fi
    if [ "$(printf '%s\n' "$body" | grep -c 'rt_winit_' || true)" -ne 1 ]; then
        echo "FAIL: $name changed its single provider-call shape" >&2
        exit 1
    fi
    if printf '%s\n' "$body" | grep -Eq 'alloc|mutex|hash|dlsym|last_error|retry'; then
        echo "FAIL: $name gained allocation, lookup, lock, hash, error-query, or retry work" >&2
        exit 1
    fi
done

if ! grep -A10 'fn rt_winit_window_is_fullscreen' "$provider" | grep -Fq '.unwrap_or(-1)' ||
   ! grep -A12 '"rt_winit_window_is_fullscreen"' "$interpreter" | grep -Fq '.unwrap_or(-1)'; then
    echo 'FAIL: fullscreen reads still fabricate false for stale handles' >&2
    exit 1
fi
if ! grep -A5 'fn rt_winit_window_set_position' "$provider" | grep -Fq 'i32::try_from'; then
    echo 'FAIL: native position mutation truncates out-of-range coordinates' >&2
    exit 1
fi

echo 'PASS: Winit window state uses one-call integer status ABI and typed absence without new memory work'
