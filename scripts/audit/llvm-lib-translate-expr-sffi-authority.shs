#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/70.backend/backend/llvm_lib_translate_expr.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
native_provider="$root/src/runtime/runtime_native.c"
rust_provider="$root/src/compiler_rust/runtime/src/value/collections.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in rt_array_push_i64_raw rt_enum_payload rt_enum_discriminant rt_tuple_get; do
    [ "$(grep -Ec "^extern fn ${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^[[:space:]]+.*${raw}\\(" "$module")" -eq 1 ]
done
for removed in rt_text_eq_any rt_ptr_read_i64; do
    if grep -q "^extern fn $removed" "$module"; then
        echo "LLVM expression translation regained unused boundary: $removed" >&2
        exit 1
    fi
done

[ "$(grep -c '^@unsafe(' "$module")" -eq 4 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 4 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 5 ]
for expected in _sffi_array_push_i64_raw:6 _sffi_enum_payload:16 \
    _sffi_enum_discriminant:6 _sffi_tuple_get:35; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done

grep -Eq '^int8_t rt_array_push_i64_raw\(' "$native_provider"
grep -q 'pub extern "C" fn rt_array_push_i64_raw' "$rust_provider"
for raw in rt_enum_payload rt_enum_discriminant rt_tuple_get; do
    grep -q "RuntimeFuncSpec::new(\"$raw\"" "$registry"
done
grep -A4 '^fn _sffi_array_push_i64_raw' "$module" | \
    grep -q 'panic("compile error: LLVM translation argument-vector append failed")'
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "LLVM-lib expression SFFI authority audit: PASS (raw calls confined; argument append fails closed; probe count unchanged)"
