#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/70.backend/backend/cuda/cuda_sffi.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^extern fn ' "$module")" -eq 21 ]
[ "$(grep -c '^fn cuda_' "$module")" -eq 21 ]
[ "$(grep -c '^@unsafe(' "$module")" -eq 42 ]
[ "$(grep -c 'unsafe(capabilities:' "$module")" -eq 0 ]

for raw in $(sed -n 's/^extern fn \([A-Za-z0-9_]*\).*/\1/p' "$module"); do
    # The smallest unsafe wrapper calls the raw ABI directly. No additional
    # thunk, validation allocation, synchronization, or dispatch is added.
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$module")" -eq 1 ]
done

both=0
native_only=0
interpreter_only=0
neither=0
for raw in $(sed -n 's/^extern fn \([A-Za-z0-9_]*\).*/\1/p' "$module"); do
    state=0
    grep -q "RuntimeFuncSpec::new(\"$raw\"" "$registry" && state=$((state + 1))
    grep -q "insert_simple!(\"$raw\"" "$interpreter" && state=$((state + 2))
    case "$state" in
        0) neither=$((neither + 1)) ;;
        1) native_only=$((native_only + 1)) ;;
        2) interpreter_only=$((interpreter_only + 1)) ;;
        3) both=$((both + 1)) ;;
    esac
done
[ "$both" -eq 13 ]
[ "$native_only" -eq 1 ]
[ "$interpreter_only" -eq 7 ]
[ "$neither" -eq 0 ]

echo "CUDA SFFI unsafe-surface audit: PASS (21/21 wrappers explicitly unsafe; direct call shape preserved; provider coverage both=13 native-only=1 interpreter-only=7 neither=0)"
