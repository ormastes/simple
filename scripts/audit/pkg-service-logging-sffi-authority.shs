#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
service="$root/src/os/services/pkg/pkg_service.spl"
logging="$root/src/os/kernel/log/klog_api.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

# The package service must use the canonical logging owner rather than declare
# or call a private copy of the foreign serial boundary.
! grep -q '^extern fn serial_println' "$service"
! grep -q '[^_]serial_println(' "$service"
grep -q '^use os.kernel.log.klog_api.{log_raw_println}' "$service"
[ "$(grep -c 'log_raw_println(' "$service")" -eq 25 ]

# The owner keeps the foreign authority lexical and mandatory-inline. This
# preserves the existing O(1), allocation-free dispatch shape for raw lines.
[ "$(grep -c '^extern fn serial_println' "$logging")" -eq 1 ]
[ "$(grep -c '^@unsafe(reason: "raw serial diagnostic output ABI", capabilities: \[ffi\])' "$logging")" -eq 1 ]
grep -q '^@always_inline$' "$logging"
grep -q '^fn _klog_serial_println(msg: text):' "$logging"
[ "$(grep -c '_klog_serial_println(' "$logging")" -eq 3 ]
[ "$(grep -c '^[[:space:]]*serial_println(msg)' "$logging")" -eq 1 ]

! grep -q 'RuntimeFuncSpec::new("serial_println"' "$registry"
grep -q 'insert_simple!("serial_println"' "$interpreter"

echo "Package-service logging SFFI authority audit: PASS (25 private calls removed; 2 canonical owner calls isolated by one mandatory-inline unsafe boundary; semantic bool/list APIs unchanged; 0 typed-native/1 interpreter provider)"
