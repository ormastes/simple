#!/bin/sh
# Static lexical-boundary guard for Engine 2D scalar math wrappers.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/lib/common/engine/math2d.spl"

test "$(grep -c '^@unsafe(reason: "raw scalar math ABI", capabilities: \[ffi\])$' "$module")" -eq 3
test "$(grep -c '^extern fn rt_math_' "$module")" -eq 3
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_math_' "$module")" -eq 3

echo 'Engine Math2D SFFI authority: PASS declarations=3 lexical_hot_calls=3 direct_call_shape=preserved artifact_admission=absent'
