#!/bin/sh
# Static lexical-boundary guard for Engine 2D scalar math wrappers.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/lib/common/engine/math2d.spl"
math3d="$root/src/lib/common/engine/math3d.spl"

test "$(grep -c '^@unsafe(reason: "raw scalar math ABI", capabilities: \[ffi\])$' "$module")" -eq 3
test "$(grep -c '^extern fn rt_math_' "$module")" -eq 3
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_math_' "$module")" -eq 3
test "$(grep -c '^@unsafe(reason: "raw scalar math ABI", capabilities: \[ffi\])$' "$math3d")" -eq 1
test "$(grep -c '^extern fn rt_math_sqrt' "$math3d")" -eq 1
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_math_sqrt' "$math3d")" -eq 1

echo 'Engine math SFFI authority: PASS declarations=4 lexical_hot_calls=4 direct_call_shape=preserved artifact_admission=absent'
