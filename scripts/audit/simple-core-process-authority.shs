#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/runtime/simple_core/core_process.spl"
cranelift="$root/src/compiler_rust/compiler/src/codegen/instr/calls.rs"
llvm="$root/src/compiler_rust/compiler/src/codegen/llvm/functions/calls.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in exit usleep free spl_load_i64 rt_string_new kill; do
    if [ "$(grep -Ec "(^|[^A-Za-z0-9_])${raw}\\(" "$module")" -ne 2 ]; then
        echo "simple-core process call escaped its mandatory-inline owner: $raw" >&2
        exit 1
    fi
done

[ "$(grep -c '^@always_inline$' "$module")" -eq 6 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi, raw_ptr\]):' "$module")" -eq 3 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 3 ]
for expected in _sffi_exit:10 _sffi_usleep:8 _sffi_free:27 \
    _sffi_load_i64:14 _sffi_rt_string_new:8 _sffi_kill:10; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done

grep -q '"spl_load_i64"' "$cranelift"
grep -q '"spl_load_i64"' "$llvm"
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "simple-core process authority audit: PASS (75 release/load/signal/exit/sleep/string operations have six mandatory-inline owners)"
