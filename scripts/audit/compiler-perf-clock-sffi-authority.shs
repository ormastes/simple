#!/bin/sh
set -eu

profiler=src/compiler/90.tools/perf/profiler.spl
trace=src/compiler/90.tools/perf/trace.spl
benchmark=src/compiler/90.tools/perf/benchmark.spl

check_clock_owner() {
    module=$1
    owner=$2
    calls=$3
    test "$(rg -c '^extern fn rt_time_monotonic_ns' "$module")" -eq 1
    test "$(rg -c 'rt_time_monotonic_ns\(' "$module")" -eq 2
    test "$(rg -c "${owner}\\(" "$module")" -eq "$calls"
}

check_clock_owner "$profiler" _profiler_monotonic_ns_raw 8
check_clock_owner "$trace" _trace_monotonic_ns_raw 4
check_clock_owner "$benchmark" _benchmark_monotonic_ns_raw 3
test "$(rg -c '^extern fn rt_timestamp_iso8601' "$benchmark")" -eq 1
test "$(rg -c 'rt_timestamp_iso8601\(' "$benchmark")" -eq 2
test "$(rg -c '_benchmark_timestamp_iso8601_raw\(' "$benchmark")" -eq 2
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$profiler")" -eq 1
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$trace")" -eq 1
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$benchmark")" -eq 2
