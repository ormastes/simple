#!/bin/sh
set -eu

decl=src/compiler_rust/lib/std/src/infra/hash.spl
interpreter=src/compiler_rust/compiler/src/interpreter_extern/crypto.rs
native=src/compiler_rust/runtime/src/value/sffi/hash/sha1.rs

test "$(rg -c '^@unsafe\(reason: "legacy raw-pointer SHA-1' "$decl")" -eq 6
rg -q '^extern fn rt_sha1_finish\(hasher: i64\) -> text\?$' "$decl"
rg -q '^extern fn rt_sha1_finish_bytes\(hasher: i64\) -> \[u8\]\?$' "$decl"
wrapper="$(sed -n '/^struct Sha1Hasher:/,/^struct /p' "$decl")"
test "$(printf '%s\n' "$wrapper" | rg -c 'unsafe\(capabilities: \[ffi\]\):')" -eq 5
printf '%s\n' "$wrapper" | rg -q 'rt_sha1_finish_bytes\(self\._handle\)'
! printf '%s\n' "$wrapper" | rg -q 'rt_sha1_finish_bytes\([^)]*,'
! printf '%s\n' "$wrapper" | rg -q '\?\? 0'
printf '%s\n' "$wrapper" | rg -q 'E-SFFI-SHA1-INVALID-HANDLE'

for spec in new:0 write:3 finish:1 finish_bytes:1 reset:1 free:1 finish_base64:1; do
    suffix=${spec%%:*}
    arity=${spec##*:}
    name="rt_sha1_${suffix}"
    body="$(sed -n "/^pub fn ${name}/,/^}/p" "$interpreter")"
    printf '%s\n' "$body" | rg -q "require_arity\(args, ${arity}, \"${name}\"\)\?;"
done

write="$(sed -n '/^pub fn rt_sha1_write/,/^}/p' "$interpreter")"
printf '%s\n' "$write" | rg -q 'usize::try_from\(int_arg\(args, 2'
printf '%s\n' "$write" | rg -q 'extend_from_slice\(&data\[\.\.limit\]\)'

native_write="$(sed -n '/^pub unsafe extern "C" fn rt_sha1_write/,/^}/p' "$native")"
printf '%s\n' "$native_write" | rg -q 'usize::try_from\(data_len\)'
! printf '%s\n' "$native_write" | rg -q 'data_len as usize'

finish_bytes="$(sed -n '/^pub extern "C" fn rt_sha1_finish_bytes/,/^}/p' "$native")"
printf '%s\n' "$finish_bytes" | rg -q 'digest_to_runtime_byte_array'
! printf '%s\n' "$finish_bytes" | rg -q 'rt_string_new'
helper="$(sed -n '/^fn digest_to_runtime_byte_array/,/^}/p' "$native")"
printf '%s\n' "$helper" | rg -q 'byte_array_write\(array, bytes\)'
! printf '%s\n' "$helper" | rg -q 'rt_bytes_u8_set'

echo "SHA-1 SFFI audit: PASS (ABI-aligned byte result; no fabricated scalar zero; strict interpreter contracts)"
