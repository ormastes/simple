#!/bin/sh
# File operations remain a legacy provider boundary. Keep every raw declaration
# explicit so callers use the checked wrapper API rather than inheriting a safe
# claim from a direct runtime hook. This does not prove provider admission.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/io/file_ops.spl"

raw_count=$(grep -c '^extern fn rt_' "$owner")
unsafe_count=$(grep -B1 '^extern fn rt_' "$owner" | grep -c '@unsafe')
test "$raw_count" -eq 19
test "$unsafe_count" -eq "$raw_count"

echo 'File-ops SFFI unsafe boundary: PASS (19 tagged raw declarations)'
