#!/bin/sh
# Channel send has a status ABI. Keep every lane from laundering rejection into
# a successful unit result or a fabricated true value.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/concurrent/channel.spl"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/concurrency.rs"
trait="$root/src/compiler_rust/compiler/src/concurrent_providers/mod.rs"
native="$root/src/compiler_rust/compiler/src/concurrent_providers/native_impl.rs"
standard="$root/src/compiler_rust/compiler/src/concurrent_providers/std_impl.rs"
runtime="$root/src/compiler_rust/runtime/src/value/channels.rs"

declarations=$(grep -Ec '^extern fn rt_channel_(new|send|try_recv|recv|close|is_closed)' "$owner")
test "$declarations" -eq 6 || {
    echo 'channel SFFI declaration inventory changed without ABI review' >&2
    exit 1
}
grep -q '^extern fn rt_channel_send(channel_id: i64, value: Any) -> i64$' "$owner"

tagged=$(awk '
    /^@unsafe\(.*capabilities: \[ffi\]\)$/ { previous_is_ffi = 1; next }
    /^extern fn rt_channel_(new|send|try_recv|recv|close|is_closed)/ {
        if (previous_is_ffi) tagged += 1
    }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$owner")
test "$tagged" -eq "$declarations" || {
    echo 'channel raw declaration lacks unsafe(ffi)' >&2
    exit 1
}

calls=$(awk '
    !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / {
        line = $0
        while (match(line, /rt_channel_(new|send|try_recv|recv|close|is_closed)[(]/)) {
            calls += 1
            line = substr(line, RSTART + RLENGTH)
        }
    }
    END { print calls + 0 }
' "$owner")
test "$calls" -eq 13 || {
    echo 'channel raw-call inventory changed without boundary review' >&2
    exit 1
}

awk '
    function indent(line, copy) {
        copy = line
        sub(/[^ ].*$/, "", copy)
        return length(copy)
    }
    NF && unsafe_indent >= 0 &&
    $0 !~ /unsafe\(capabilities: \[ffi\]\):$/ && indent($0) <= unsafe_indent {
        unsafe_indent = -1
    }
    /unsafe\(capabilities: \[ffi\]\):$/ {
        unsafe_indent = indent($0)
        next
    }
    !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / &&
    /rt_channel_(new|send|try_recv|recv|close|is_closed)[(]/ {
        if (unsafe_indent < 0 || indent($0) <= unsafe_indent) {
            print "channel raw call lacks lexical FFI authority: " NR ":" $0 > "/dev/stderr"
            failed = 1
        }
    }
    BEGIN { unsafe_indent = -1 }
    END { if (failed) exit 1 }
' "$owner"

grep -q 'fn channel_send(&self, handle: Handle, value: Value) -> Result<bool, CompileError>;' "$trait"
grep -q 'fn channel_send(&self, handle: Handle, value: Value) -> Result<bool, CompileError>' "$native"
grep -q 'fn channel_send(&self, handle: Handle, value: Value) -> Result<bool, CompileError>' "$standard"
grep -q 'Value::Int(i64::from(admitted))' "$interpreter"
grep -q 'Value::Int(i64::from(sender.send(value).is_ok()))' "$interpreter"
grep -q 'pub extern "C" fn rt_channel_send(channel: RuntimeValue, value: RuntimeValue) -> i64' "$runtime"

if grep -E '^[[:space:]]*(sha256|verify_signature|dlsym|registry_lookup|ffi_call)\(' "$owner" >/dev/null; then
    echo 'channel operation gained per-call admission or generic dispatch' >&2
    exit 1
fi

echo 'channel SFFI authority: PASS (6 declarations, 13 lexical raw calls, send status is preserved across provider lanes)'
