#!/bin/sh
# Static regression gate for the optional libtorch facade.  This checks source
# authority and direct-call shape only; it is not provider verification.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
source="$root/src/lib/common/torch/dyn_sffi_ops.spl"

grep -Fq '@always_inline' "$source"
grep -Fq 'fn dyn_torch_available() -> bool:' "$source"
test "$(grep -Fc 'rt_torch_available()' "$source")" -eq 2
! grep -Fq 'if not rt_torch_available()' "$source"

raw_calls=$(awk '
    /unsafe\(capabilities: \[ffi\]\):/ { pending=1; next }
    pending && /^[[:space:]]+rt_torch_/ { count++; pending=0; next }
    pending { pending=0 }
    END { print count + 0 }
' "$source")
test "$raw_calls" -eq 61

if grep -Eq 'rt_alloc|dlsym|CString|HashMap|mutex' "$source" \
    || grep -Eq '^[[:space:]]*(while|for)[[:space:]]' "$source"; then
    echo 'dynamic Torch facade gained an explicit allocation, lookup, lock, or loop' >&2
    exit 1
fi

echo 'Torch dynamic SFFI authority: PASS lexical_raw_calls=61 direct_call_shape=retained explicit_alloc_lookup_lock_loop=none'
