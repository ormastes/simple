#!/bin/sh
# Static regression gate for the optional libtorch facade.  This checks source
# authority and direct-call shape only; it is not provider verification.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
source="$root/src/lib/common/torch/dyn_sffi_ops.spl"

grep -Fq '@always_inline' "$source"
grep -Fq 'fn dyn_torch_available() -> bool:' "$source"
test "$(grep -Fc 'rt_torch_available()' "$source")" -eq 2
! grep -Fq 'if not rt_torch_available()' "$source"

# Raw declarations are owned only by std.nogc_sync_mut.torch.sffi; the
# facade imports them and declares no extern of its own.
! grep -Fq 'extern fn' "$source"

# Every raw provider call must sit in a private always-inline lexical owner
# (`_dyn_torch_*_raw`, plus the availability owner); typed wrappers hold no
# unsafe blocks and make no raw calls.
raw_calls=$(awk '
    /^@always_inline/ { inline_pending=1; next }
    /^fn (_dyn_torch_[A-Za-z0-9_]*_raw|dyn_torch_available)\(/ {
        if (!inline_pending) bad=1
        in_raw=1; unsafe_seen=0; inline_pending=0; next
    }
    /^fn / {
        if (in_raw && !unsafe_seen) bad=1
        in_raw=0; inline_pending=0
    }
    /unsafe\(capabilities: \[ffi\]\):/ {
        if (!in_raw) bad=1
        unsafe_seen++
        pending=1; next
    }
    pending && /^[[:space:]]+rt_torch_/ { count++; pending=0; next }
    pending { pending=0 }
    END { if (bad) print "BAD"; else print count + 0 }
' "$source")
case "$raw_calls" in
    ''|*[!0-9]*)
        echo 'Torch dynamic SFFI authority: FAIL raw call or unsafe block outside an always-inline owner' >&2
        exit 1
        ;;
esac
test "$raw_calls" -eq 37

# The unowned legacy fixed-dimension constructor ABI (symbol names owned by
# the provider array-form ABI, registered by no engine) must stay uncallable
# and fail closed with a typed error.
! grep -Eq 'rt_torch_tensor_(zeros|ones|rand|randn|full|empty)\(' "$source"
grep -Fq 'unbacked_provider_abi' "$source"

if grep -Eq 'rt_alloc|dlsym|CString|HashMap|mutex' "$source" \
    || grep -Eq '^[[:space:]]*(while|for)[[:space:]]' "$source"; then
    echo 'dynamic Torch facade gained an explicit allocation, lookup, lock, or loop' >&2
    exit 1
fi

echo "Torch dynamic SFFI authority: PASS owner_raw_calls=$raw_calls local_extern_decls=0 wrapper_unsafe_blocks=0 legacy_abi=fail_closed explicit_alloc_lookup_lock_loop=none"
