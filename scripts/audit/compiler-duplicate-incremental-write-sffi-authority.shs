#!/bin/sh
set -eu

module=src/compiler/90.tools/duplicate_check/incremental.spl
facade=src/lib/nogc_sync_mut/io_runtime.spl

if rg -q '^extern fn rt_file_write_text|rt_file_write_text\(' "$module"; then
    echo "duplicate-check incremental cache must use the exact write owner" >&2
    exit 1
fi

test "$(rg -c '^use std\.io_runtime\.\{file_write_exact\}' "$module")" -eq 1
test "$(rg -c 'file_write_exact\(cache\.cache_path, lines\.join\("\\n"\)\)' "$module")" -eq 1
rg -q '^pub fn file_write_exact\(path: text, content: text\) -> bool:' "$facade"
test "$(rg -c 'if not save_incremental_cache\(cache\):' "$module")" -eq 1
