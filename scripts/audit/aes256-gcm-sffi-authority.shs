#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/crypto/aes256_gcm.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^extern fn rt_' "$module")" -eq 3 ]
[ "$(grep -c '^@unsafe(reason:' "$module")" -eq 8 ]
[ "$(grep -c '^@always_inline$' "$module" || true)" -eq 0 ]

call_count=$(perl -0ne '
    s/""".*?"""//sg;
    s/#.*//mg;
    s/^extern fn .*\n//mg;
    while (/\b(?:rt_bytes_u8_at|rt_tls13_aes256_gcm_(?:encrypt|decrypt))\b/g) { $count++ }
    END { print $count + 0 }
' "$module")
[ "$call_count" -eq 35 ]

for symbol in rt_bytes_u8_at rt_tls13_aes256_gcm_encrypt rt_tls13_aes256_gcm_decrypt; do
    grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry"
    grep -q "insert_simple!(\"$symbol\"" "$interpreter"
done

# Preserve the constant-time tag accumulator and once-per-message key schedule.
grep -q 'diff = diff | (_u8_at(expected_tag, i) \^ _u8_at(tag, i))' "$module"
[ "$(grep -c 'val schedule = aes256_key_expansion(key)' "$module")" -eq 2 ]
grep -q 'if fast.len() != 0:' "$module"

echo "AES-256-GCM SFFI authority audit: PASS (35 calls/3 symbols; explicit fast-path declarations; 3 both/0 one/0 no-provider; constant-time tag accumulator and once-per-message schedule retained; ambiguous fallback remains unsafe; no forced inlining)"
