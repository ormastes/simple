#!/bin/sh
# Keep raw CAS filesystem/process/time contracts in one inlined lexical owner.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/80.driver/cache/cas_store.spl"

test "$(grep -c '^extern fn rt_' "$module")" -eq 6
tagged=$(awk '/^@unsafe\(.*capabilities: \[ffi\]\)$/ { tagged=1; next }
    /^extern fn rt_/ { if (tagged) count++ }
    { tagged=0 }
    END { print count + 0 }' "$module")
test "$tagged" -eq 6
test "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 6
test "$(grep -Ec '^        rt_(file_write_text|file_exists|file_delete|file_move|getpid|time_now_unix_micros)\(' "$module")" -eq 6

for helper in cas_file_write_text_raw cas_file_exists_raw cas_file_delete_raw \
    cas_file_move_raw cas_process_id_raw cas_time_now_unix_micros_raw; do
    grep -q "^fn $helper" "$module"
done

echo 'CAS store SFFI authority: PASS (six inlined lexical raw owners)'
