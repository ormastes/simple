#!/bin/sh
set -eu

module=src/compiler/95.interp/execution/tiered_jit_manager.spl

if rg -q 'rt_jit_call_i64_i64' "$module"; then
    echo "tiered JIT must not retain unused raw authority" >&2
    exit 1
fi

test "$(rg -c '^extern fn rt_(jit_|time_now_seconds)' "$module")" -eq 7
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 7
for symbol in jit_create jit_compile_source jit_call_i64 jit_call_void \
    jit_has_function jit_cleanup time_now_seconds; do
    test "$(rg -c "^extern fn rt_${symbol}\\(" "$module")" -eq 1
    test "$(rg -c "^[[:space:]]+rt_${symbol}\\(" "$module")" -eq 1
done
test "$(rg -c '_tiered_jit_time_now_seconds_raw\(' "$module")" -eq 3
rg -q '^extern fn rt_jit_compile_source\(handle: i64, source: text\) -> text\?$' "$module"
test "$(rg -c 'E-SFFI-017: JIT compile provider returned null' "$module")" -eq 1
for owner in create compile_source call_i64 call_void has_function cleanup; do
    test "$(rg -c "_tiered_jit_${owner}_raw\\(" "$module")" -eq 2
done
