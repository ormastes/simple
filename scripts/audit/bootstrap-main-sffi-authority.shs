#!/bin/sh
# Static lexical-boundary guard for the bootstrap CLI entrypoint.
# This checks source shape only; it does not admit, sign, or verify providers.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/app/cli/bootstrap_main.spl"

test "$(grep -c '^@unsafe(reason: "raw bootstrap argument-vector ABI", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^@unsafe(reason: "raw Rust seed native-build ABI", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^extern fn \(sys_get_args\|rt_native_build\)' "$module")" -eq 2
test "$(grep -c 'unsafe(capabilities: \[ffi\]): sys_get_args()' "$module")" -eq 1
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_native_build(args)' "$module")" -eq 1

echo 'Bootstrap main SFFI authority: PASS declarations=2 lexical_calls=2 direct_call_shape=preserved closure_expansion=absent artifact_admission=absent'
