#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
unix="$root/src/runtime/platform/unix_common.h"
win="$root/src/runtime/platform/platform_win.h"
memory="$root/src/compiler_rust/compiler/src/interpreter_extern/memory.rs"
file_io="$root/src/compiler_rust/compiler/src/interpreter_extern/file_io.rs"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"
loader="$root/src/compiler/99.loader/loader/smf_mmap_native.spl"

symbols='rt_mmap_raw rt_munmap_raw rt_mprotect rt_madvise_raw rt_msync_flags rt_mlock rt_munlock rt_open_fd rt_close_fd'
for symbol in $symbols; do
    grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry"
    grep -q "insert_simple!(\"$symbol\"" "$interpreter"
done

# Invalid signed lengths must not wrap to huge size_t/SIZE_T values.
[ "$(grep -c 'if (!addr || length <= 0) return -1;' "$unix")" -ge 6 ]
[ "$(grep -c 'if (!addr || length <= 0) return -1;' "$win")" -ge 4 ]
grep -q 'if (length <= 0 || offset < 0) return -1;' "$unix"
grep -q 'if (length <= 0 || offset < 0) return -1;' "$win"

# Windows has no madvise equivalent: unsupported is failure, never success.
grep -A3 '^int64_t rt_madvise_raw' "$win" | grep -q 'return -1;'
! grep -A3 '^int64_t rt_madvise_raw' "$win" | grep -q 'return 0;'

for symbol in rt_mmap_raw rt_munmap_raw rt_mprotect rt_madvise_raw rt_msync_flags rt_mlock rt_munlock; do
    grep -q "pub fn $symbol" "$memory"
done
grep -q 'pub fn rt_open_fd' "$file_io"
grep -q 'pub fn rt_close_fd' "$file_io"

# Loader allocations remain RW until their explicit RX transition.
grep -q 'val prot = PROT_READ | PROT_WRITE$' "$loader"
! grep -q 'val prot = PROT_READ | PROT_WRITE | PROT_EXEC' "$loader"

echo "mmap provider contract audit: PASS (9 typed/native+interpreter registrations; invalid lengths fail closed; Windows madvise unsupported; W^X retained)"
