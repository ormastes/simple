#!/bin/sh
# Static ratchet for the high-fanout logger's environment/stderr boundary.
# Verdict harness (.claude/rules/vcs.md): verdict LAST on stdout, exit 0/1/2,
# non-vacuity absolute. NOTE: deliberately `set -u` WITHOUT `set -e` — `grep -c`
# exits 1 on zero matches, and under `-e` that killed this guard silently
# (exit 1, no output) for the whole time it sat RED.
set -u
A_CHECKED=0; A_FAILED=0; A_MSGS=''
_fail() { A_FAILED=$((A_FAILED+1)); A_MSGS="${A_MSGS}${A_MSGS:+; }$1"; }
ck() { # ck <desc> <cmd...>  -- status read into a var on the NEXT line, never via a pipe
    _d=$1; shift
    "$@" >/dev/null 2>&1
    _rc=$?
    A_CHECKED=$((A_CHECKED+1)); [ "$_rc" -eq 0 ] || _fail "$_d"
}
cknot() { # cknot <desc> <cmd...>  -- must FAIL
    _d=$1; shift
    "$@" >/dev/null 2>&1
    _rc=$?
    A_CHECKED=$((A_CHECKED+1)); [ "$_rc" -ne 0 ] || _fail "$_d"
}
ckeq() { # ckeq <desc> <actual> <expected>
    A_CHECKED=$((A_CHECKED+1))
    [ "$2" = "$3" ] || _fail "$1 (expected $3, actual $2)"
}
# grep -c prints 0 and exits 1 on no match; the count is what we want, not the status.
cnt() { grep -c "$1" "$2" 2>/dev/null; }
cnte() { grep -Ec "$1" "$2" 2>/dev/null; }
need_file() { [ -f "$1" ] || { echo "$2: ERROR — nothing was checked (missing $1)"; exit 2; } }
verdict() {
    [ "$A_CHECKED" -gt 0 ] || { echo "$1: ERROR — nothing was checked"; exit 2; }
    [ "$A_FAILED" -eq 0 ] || { echo "$1: FAIL — $A_FAILED of $A_CHECKED assertion(s) failed: $A_MSGS"; exit 1; }
    echo "$1: PASS — $A_CHECKED assertion(s) checked${VERDICT_EXTRA:-}"
    exit 0
}

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
source="$root/src/lib/nogc_sync_mut/log.spl"
L='Logger SFFI authority'
need_file "$source" "$L"

# Only stderr remains a raw provider. The environment read migrated onto the
# owned facade `std.nogc_sync_mut.env.variables.env_get`, which is the stronger
# invariant: the logger no longer declares a raw env extern at all.
ckeq 'raw stderr externs' "$(cnte '^extern fn rt_(stderr_write|stderr_flush)' "$source")" 2
ckeq 'total @unsafe declarations' "$(cnte '^@unsafe\(' "$source")" 2
ck 'stderr write extern annotated' grep -Fq '@unsafe(reason: "raw stderr write ABI", capabilities: [ffi])' "$source"
ck 'stderr flush extern annotated' grep -Fq '@unsafe(reason: "raw stderr flush ABI", capabilities: [ffi])' "$source"
ck 'env read uses owned facade' grep -Fq 'use std.nogc_sync_mut.env.variables.{env_get}' "$source"
cknot 'no raw rt_env_get extern remains' grep -q '^extern fn rt_env_get' "$source"
cknot 'no raw rt_env_* call site remains' grep -q 'rt_env_' "$source"

raw_calls=$(awk '
    /unsafe\(capabilities: \[ffi\]\):/ { pending=1; next }
    pending && /^[[:space:]]+rt_(stderr_write|stderr_flush)/ { count++; pending=0; next }
    pending { pending=0 }
    END { print count + 0 }
' "$source")
ckeq 'lexically scoped raw calls' "$raw_calls" 2

emit_body=$(awk '/^fn _emit\(/ { capture=1 } capture { print } capture && /^fn get_log_level/ { exit }' "$source")
printf '%s\n' "$emit_body" > /tmp/.log_emit_body.$$
ck '_emit writes stderr' grep -Fq 'rt_stderr_write(line +' /tmp/.log_emit_body.$$
ck '_emit flushes stderr' grep -Fq 'rt_stderr_flush()' /tmp/.log_emit_body.$$
rm -f /tmp/.log_emit_body.$$

VERDICT_EXTRA=' (raw_declarations=2 lexical_raw_calls=2 env=owned-facade disabled_log_fast_path=unchanged)'
verdict "$L"
