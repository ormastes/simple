#!/bin/sh
set -eu

module=src/compiler/95.interp/mir_interpreter.spl
facade=src/lib/nogc_sync_mut/io_runtime.spl

if rg -q '^extern fn rt_env_get|rt_env_get\(' "$module"; then
    echo "MIR interpreter startup must use the canonical environment facade" >&2
    exit 1
fi

test "$(rg -c 'env_get_opt\("SIMPLE_(STRICT_INTERP|EXECIR)"\)' "$module")" -eq 2
test "$(rg -c '^extern fn rt_enum_discriminant' "$module")" -eq 1
test "$(rg -c '^[[:space:]]+rt_enum_discriminant\(' "$module")" -eq 1
test "$(rg -c '_mir_interp_enum_discriminant_raw\(' "$module")" -eq 4
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 1
rg -Uq '@always_inline\npub fn env_get_opt\(key: text\) -> text\?:' "$facade"
