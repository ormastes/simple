#!/bin/sh
set -eu

module=src/compiler/90.tools/duplicate_check/detector_files.spl

rg -q '^extern fn rt_path_absolute\(path: text\) -> text\?$' "$module"
test "$(rg -c 'rt_path_absolute\(' "$module")" -eq 2
test "$(rg -c '_detector_path_absolute_raw\(' "$module")" -eq 2
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 1
test "$(rg -c 'if absolute_path == nil or absolute_path == "":' "$module")" -eq 1
test "$(rg -c 'return \[\]' "$module")" -eq 2
test "$(rg -c 'dir_walk_native\(scan_path\)' "$module")" -eq 1
