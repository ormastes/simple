#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
canonical="$root/src/lib/nogc_sync_mut/sffi/cli.spl"
facade="$root/src/lib/nogc_sync_mut/ffi/cli.spl"

if [ "$(grep -c '^[[:space:]]*extern fn ' "$canonical")" -ne 40 ]; then
    echo "canonical CLI declaration inventory changed without contract review" >&2
    exit 1
fi
tagged=$(awk '
    /^@unsafe\(.*capabilities: \[ffi\]\)$/ { previous_is_ffi = 1; next }
    /^[[:space:]]*extern fn / {
        if (previous_is_ffi) tagged++
    }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$canonical")
if [ "$tagged" -ne 40 ]; then
    echo "every canonical CLI declaration must be explicitly unsafe(ffi)" >&2
    exit 1
fi
if grep -n 'extern fn ' "$facade"; then
    echo "CLI FFI compatibility facade must not declare providers" >&2
    exit 1
fi
if ! grep -q '^export use std\.nogc_sync_mut\.sffi\.cli\.\*$' "$facade"; then
    echo "CLI FFI compatibility facade must re-export the canonical owner" >&2
    exit 1
fi
if [ "$(grep -c 'cli_run_sffi_gen(args)' "$facade")" -ne 2 ]; then
    echo "legacy ffi-gen aliases must route to the admitted canonical symbol" >&2
    exit 1
fi
if rg -q 'rt_cli_run_ffi_gen' "$root/src/lib"; then
    echo "unimplemented rt_cli_run_ffi_gen must not be declared by the library" >&2
    exit 1
fi

echo "CLI SFFI owner audit: PASS"
