#!/bin/sh
# Keep each legacy 3D GPU raw ABI in one canonical sffi_* owner. There is no
# provider admission evidence yet, so every remaining raw declaration is unsafe.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
for backend in cuda rocm intel vulkan; do
    owner="$root/src/lib/nogc_sync_mut/gpu/engine3d/sffi_${backend}3d.spl"
    compat="$root/src/lib/nogc_sync_mut/gpu/engine3d/ffi_${backend}3d.spl"
    raw_count=$(grep -c '^extern fn ' "$owner")
    unsafe_count=$(grep -B1 '^extern fn ' "$owner" | grep -c '@unsafe')
    test "$raw_count" -eq 3
    test "$unsafe_count" -eq 3
    test "$(grep -c '^extern fn ' "$compat" || true)" -eq 0
done

echo 'GPU 3D SFFI owner authority: PASS (12 tagged raw declarations; 4 compatibility facades)'
