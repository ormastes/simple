#!/bin/sh
set -eu

owner=src/os/hosted/dedicated_host_posix.spl
symbols='rt_file_mmap_read_bytes rt_file_size rt_mmap_raw rt_mprotect rt_munmap_raw'

test "$(grep -c '^@unsafe(reason: .*capabilities: \[ffi' "$owner")" -eq 5
test "$(grep -c '^@always_inline$' "$owner")" -eq 5

for symbol in $symbols; do
    # Exactly one declaration and one call inside its private inline owner.
    test "$(grep -c "${symbol}(" "$owner")" -eq 2
done

grep -q '^fn _posix_mmap_bytes(path: text) -> Result<\[u8\], text>:$' "$owner"
grep -q 'if value < 0 or value > 255:' "$owner"
grep -q 'return Err("mmap-read-invalid-byte")' "$owner"
grep -q 'if bytes.len() as i64 != expected_size:' "$owner"

echo 'dedicated host POSIX SFFI authority: PASS'
