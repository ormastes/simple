#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
mutex="$root/src/lib/nogc_sync_mut/concurrent/mutex.spl"
rwlock="$root/src/lib/nogc_sync_mut/concurrent/rwlock.spl"

grep -q '^extern fn rt_mutex_unlock(mutex: Any, new_value: Any) -> i64$' "$mutex"
grep -q '^extern fn rt_rwlock_set(rwlock: Any, new_value: Any) -> i64$' "$rwlock"
grep -q '^    fn unlock(new_value: Any) -> i64:$' "$mutex"
grep -q '^    fn set(new_value: Any) -> i64:$' "$rwlock"

for source in "$mutex" "$rwlock"; do
    declarations=$(grep -Ec '^extern fn rt_(mutex|rwlock)_' "$source")
    tagged=$(awk '/^@unsafe\(.*capabilities: \[ffi\]\)$/ { tagged=1; next } /^extern fn rt_(mutex|rwlock)_/ { if (tagged) count++ } { tagged=0 } END { print count + 0 }' "$source")
    test "$declarations" -eq "$tagged"
done

echo 'sync lock SFFI authority: PASS (status ABI and unsafe declarations)'
