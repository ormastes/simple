#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/50.mir/_MirLowering/function_lowering.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

[ "$(grep -Ec '^extern fn rt_enum_discriminant\(' "$module")" -eq 1 ]
[ "$(grep -Ec '^[[:space:]]+rt_enum_discriminant\(' "$module")" -eq 1 ]
[ "$(grep -Ec '^[[:space:]]+rt_env_get\(' "$module")" -eq 1 ]
[ "$(grep -Ec '^fn _sffi_enum_discriminant\(' "$module")" -eq 1 ]
[ "$(grep -Ec '^fn _sffi_env_get\(' "$module")" -eq 1 ]
[ "$(grep -c '^@unsafe(' "$module")" -eq 1 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 2 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 2 ]
[ "$(grep -o '_sffi_enum_discriminant(' "$module" | wc -l)" -eq 27 ]
[ "$(grep -o '_sffi_env_get(' "$module" | wc -l)" -eq 5 ]

for raw in rt_enum_discriminant rt_env_get; do
    grep -q "RuntimeFuncSpec::new(\"$raw\"" "$registry"
    grep -q "insert_simple!(\"$raw\"" "$interpreter"
done

grep -q '(_sffi_env_get("SIMPLE_MIR_RETTYPE_DEBUG") ?? "") == "1"' "$module"
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

# The 26 discriminant probes are existing MIR type/diagnostic operations.
# Authority ownership must not add a second probe, allocation, lookup, or loop.
[ "$(grep -o '_sffi_enum_discriminant(' "$module" | wc -l)" -eq 27 ]

echo "MIR function-lowering SFFI authority audit: PASS (enum and imported env raw calls confined; nullable debug gate decoded; type-lowering probe counts unchanged)"
