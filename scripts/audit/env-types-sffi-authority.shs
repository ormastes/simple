#!/bin/sh
# Ratchet the sync/async environment compatibility SFFI surface.
# Source classification only; annotations do not verify or sign providers.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
types="$root/src/lib/nogc_sync_mut/env/types.spl"
sync_vars="$root/src/lib/nogc_sync_mut/env/variables.spl"
sync_paths="$root/src/lib/nogc_sync_mut/env/paths.spl"
sync_platform="$root/src/lib/nogc_sync_mut/env/platform.spl"
async_vars="$root/src/lib/nogc_async_mut/env/variables.spl"
async_paths="$root/src/lib/nogc_async_mut/env/paths.spl"
async_platform="$root/src/lib/nogc_async_mut/env/platform.spl"

[ "$(grep -c '^extern fn rt_' "$types")" -eq 9 ]
[ "$(grep -c '^@unsafe(' "$types")" -eq 9 ]
grep -q '^extern fn rt_env_get(key: text) -> text?' "$types"
grep -q '^extern fn rt_env_vars() -> \[(text, text)\]?' "$types"
grep -q '^extern fn rt_env_home() -> text?' "$types"
grep -q '^extern fn rt_hostname() -> text?' "$types"

[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$sync_vars")" -eq 4 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$sync_paths")" -eq 1 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$sync_platform")" -eq 4 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$async_vars")" -eq 4 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$async_paths")" -eq 1 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$async_platform")" -eq 3 ]

for module in "$sync_vars" "$async_vars"; do
    grep -q '^fn env_list_checked() -> Result<\[(text, text)\], text>:' "$module"
    grep -q 'legacy environment-list API collapses snapshot allocation failure' "$module"
done

echo 'env types SFFI authority audit: PASS (9/9 raw exports tagged; nullable lookup/snapshot/home/hostname contracts; 17 lexical sync/async owners; checked snapshot APIs; direct calls remain allocation-free)'
