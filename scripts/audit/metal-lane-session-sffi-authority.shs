#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/lib/gc_async_mut/gpu_lane/metal_lane_session.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^extern fn rt_metal_' "$module")" -eq 25 ]
[ "$(grep -c '^@unsafe(reason:' "$module")" -eq 25 ]
[ "$(grep -c '^    @unsafe(reason:' "$module")" -eq 6 ]
call_count=$(perl -ne '
    s/#.*//;
    next if /^extern fn /;
    while (/\brt_metal_[a-z_]+\b/g) { $count++ }
    END { print $count + 0 }
' "$module")
[ "$call_count" -eq 42 ]
[ "$(grep -c '^@always_inline$' "$module" || true)" -eq 0 ]

symbols=$(awk '/^extern fn rt_metal_/{name=$3; sub(/\(.*/, "", name); print name}' "$module")
both=0
one=0
none=0
for symbol in $symbols; do
    providers=0
    grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry" && providers=$((providers + 1))
    grep -q "insert_simple!(\"$symbol\"" "$interpreter" && providers=$((providers + 1))
    case "$providers" in
        2) both=$((both + 1)) ;;
        1) one=$((one + 1)) ;;
        0) none=$((none + 1)) ;;
    esac
done
[ "$both" -eq 20 ]
[ "$one" -eq 5 ]
[ "$none" -eq 0 ]

grep -q '^extern fn rt_metal_is_available() -> bool$' "$module"
grep -q '^extern fn rt_metal_buffer_upload(buffer: i64, data: \[u8\], size: i64) -> bool$' "$module"
grep -q '^extern fn rt_metal_buffer_download(data: \[u8\], buffer: i64, size: i64) -> bool$' "$module"

echo "Metal lane SFFI authority audit: PASS (42 calls/25 symbols; 25 unsafe declarations + 6 narrow unsafe lifecycle/I/O owners; 20 both/5 one/0 no-provider; semantic bool preserved; no forced inlining)"
