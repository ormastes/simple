#!/bin/sh
set -eu

owner=src/app/interpreter/ffi/span_ffi.spl
aggregate=src/app/interpreter/ffi/__init__.spl
provider=src/compiler_rust/compiler/src/interpreter_extern/span_sffi.rs
symbols='rt_span_create rt_span_start rt_span_end rt_span_line rt_span_column rt_span_free'

test "$(grep -c '^@unsafe(reason: .*capabilities: \[ffi\])$' "$owner")" -eq 6

for symbol in $symbols; do
    test "$(grep -c "^extern fn ${symbol}(" "$owner")" -eq 1
    ! grep -q "export .*${symbol}" "$owner"
    ! grep -q "${symbol}" "$aggregate"
    grep -q "pub fn ${symbol}(" "$provider"
done

! rg -q 'rt_span_(create|start|end|line|column|free)' src/app/interpreter \
    --glob '*.spl' --glob '!ffi/span_ffi.spl'

echo 'interpreter span SFFI authority: PASS'
