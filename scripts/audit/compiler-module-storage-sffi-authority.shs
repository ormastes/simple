#!/bin/sh
set -eu

port=src/compiler/85.mdsoc/feature/module_loading/app/module_storage_port.spl
file_adapter=src/compiler/85.mdsoc/adapters/out/file_module_storage.spl
memory_adapter=src/compiler/85.mdsoc/adapters/out/memory_module_storage.spl

if rg -q '^extern fn rt_file_read_text|rt_file_read_text\(' "$file_adapter"; then
    echo "file module storage must use the typed file facade" >&2
    exit 1
fi

rg -q '^    read_source_fn: fn\(text\) -> Result<text, text>$' "$port"
rg -q '^fn _file_read_source\(path: text\) -> Result<text, text>:$' "$file_adapter"
test "$(rg -c 'file_read_result\(path\)' "$file_adapter")" -eq 1
rg -q '^fn _mem_read\(path: text\) -> Result<text, text>:$' "$memory_adapter"
test "$(rg -c 'return Ok\(_mem_sources\[i\]\)' "$memory_adapter")" -eq 1
test "$(rg -c '^    Err\("module source not registered: \{path\}"\)' "$memory_adapter")" -eq 1
