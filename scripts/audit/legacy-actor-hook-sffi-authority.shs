#!/bin/sh
# The legacy compatibility actor hooks must never revive an ABI-incompatible
# raw actor call. Scheduler-owned actors are the pure-Simple migration owner.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
hooks="$root/src/lib/nogc_sync_mut/concurrent/actor_hooks.spl"

test -f "$hooks"
! grep -Eq '^extern fn rt_actor_' "$hooks"
! grep -Eq '^[^#]*rt_actor_' "$hooks"
grep -q 'E-SFFI-ACTOR-LEGACY-ABI' "$hooks"
grep -q 'std.actor.spawn' "$hooks"
grep -q 'scheduler-owned `ActorRef`' "$hooks"

echo 'legacy actor hook SFFI authority: PASS (invalid raw ABI removed)'
