#!/bin/sh
set -eu

module=src/compiler/30.types/type_system/builtin_registry.spl

test "$(rg -c '^extern fn rt_type_registry_(lookup|has)\(' "$module")" -eq 2
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 2
test "$(rg -c '^[[:space:]]+rt_type_registry_lookup\(' "$module")" -eq 1
test "$(rg -c '^[[:space:]]+rt_type_registry_has\(' "$module")" -eq 1
test "$(rg -c '^@always_inline$' "$module")" -ge 2
rg -q '^extern fn rt_type_registry_lookup\(name: text\) -> text\?$' "$module"
rg -q '^extern fn rt_type_registry_has\(name: text\) -> bool$' "$module"
rg -q 'self\.entries\.contains\(name\) or type_registry_has\(name\)' "$module"
