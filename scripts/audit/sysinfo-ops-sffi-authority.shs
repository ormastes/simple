#!/bin/sh
# Ratchet system-information SFFI status/null contracts and direct-call shape.
# Static source evidence only; no provider signature is admitted here.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/lib/nogc_sync_mut/io/sysinfo_ops.spl"

[ "$(grep -c '^extern fn rt_' "$module")" -eq 3 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 3 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 3 ]
[ "$(grep -c '^@unsafe(' "$module")" -eq 6 ]

grep -q '^extern fn rt_hostname() -> text?' "$module"
grep -q '^fn getpid_checked() -> Result<i64, text>:' "$module"
grep -q '^fn hostname_checked() -> Result<text, text>:' "$module"
grep -q '^fn cpu_count_checked() -> Result<i64, text>:' "$module"
grep -q 'if pid <= 0:' "$module"
grep -q 'if value == nil or value == "":' "$module"
grep -q 'if count <= 0:' "$module"

for symbol in rt_getpid rt_hostname rt_thread_available_parallelism; do
    [ "$(grep -c "\\b${symbol}(" "$module")" -eq 2 ]
done

echo 'sysinfo_ops SFFI authority audit: PASS (3 direct raw owners; checked PID/hostname/CPU contracts; legacy sentinel APIs explicitly unsafe; no lookup/allocation on success)'
