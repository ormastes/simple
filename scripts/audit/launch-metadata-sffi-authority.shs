#!/bin/sh
set -eu

module=src/app/startup/launch_meta_check.spl
runtime=src/lib/nogc_sync_mut/io_runtime.spl
shim=src/lib/io_runtime.spl

test "$(rg '^extern fn rt_file_read_(text|bytes)' "$module" | wc -l)" -eq 0
test "$(rg 'rt_file_read_(text|bytes)\(' "$module" | wc -l)" -eq 0
rg -q '^fn _metadata_for_check.*-> Result<LaunchMetadata, text>:' "$module"
rg -q 'metadata read failed' "$module"
rg -q '^pub fn file_read_bytes_result\(path: text\) -> Result<\[u8\], text>:' "$runtime"
rg -q 'file_read_bytes_result' "$shim"

# Each selected input is read once; no existence/read retry is introduced for
# the explicit metadata path or native artifact.
test "$(rg -c 'read_file_text_result\(metadata_path\)' "$module")" -eq 1
test "$(rg -c 'file_read_bytes_result\(path\)' "$module")" -eq 2
