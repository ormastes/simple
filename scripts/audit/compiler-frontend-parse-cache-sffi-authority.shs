#!/bin/sh
set -eu

module=src/compiler/10.frontend/frontend_parse_cache.spl

if rg -q '^extern fn rt_' "$module"; then
    echo "frontend parse cache must not own raw SFFI declarations" >&2
    exit 1
fi
test "$(rg -c 'env_get_opt\(' "$module")" -eq 4
test "$(rg -c 'file_exists\(' "$module")" -eq 2
test "$(rg -c 'file_read_result\(' "$module")" -eq 1
test "$(rg -c 'file_write_exact\(' "$module")" -eq 1
test "$(rg -c 'file_hash_sha256_or_empty\(' "$module")" -eq 1
test "$(rg -c 'dir_create_all\(' "$module")" -eq 1
test "$(rg -c 'getpid\(' "$module")" -eq 1
test "$(rg -c 'file_move_cross_device\(' "$module")" -eq 1
test "$(rg -c 'file_delete\(' "$module")" -eq 1
if rg -q 'file_hash_sha256\(' "$module"; then
    echo "frontend cache hashing must not gain shell fallback" >&2
    exit 1
fi
