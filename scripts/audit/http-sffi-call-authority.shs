#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
facades="
$root/src/lib/nogc_sync_mut/io/http_sffi.spl
$root/src/lib/nogc_sync_mut/io/http_client_core.spl
$root/src/lib/nogc_sync_mut/io/http_client_handles.spl
$root/src/lib/nogc_sync_mut/io/http_get_core.spl
"
compat_facades="
$root/src/app/io/http_sffi.spl
$root/src/app/io/http_ffi.spl
"

for facade in $facades; do
    case "$facade" in
        */http_sffi.spl) declarations=18; scopes=12 ;;
        */http_client_core.spl) declarations=3; scopes=11 ;;
        */http_client_handles.spl) declarations=5; scopes=5 ;;
        */http_get_core.spl) declarations=1; scopes=1 ;;
    esac
    if [ "$(grep -c '^extern fn ' "$facade")" -ne "$declarations" ] ||
       [ "$(grep -c '^@unsafe(.*capabilities: \[ffi\]' "$facade")" -ne "$declarations" ]; then
        echo "HTTP declaration authority inventory changed: $facade" >&2
        exit 1
    fi
    if [ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$facade")" -ne "$scopes" ]; then
        echo "HTTP lexical authority inventory changed: $facade" >&2
        exit 1
    fi

    calls=$(awk '
        !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / {
            line = $0
            while (match(line, /(rt_http_|rt_ws_)[A-Za-z0-9_]*[(]/)) {
                calls += 1
                line = substr(line, RSTART + RLENGTH)
            }
        }
        END { print calls + 0 }
    ' "$facade")
    if [ "$calls" -ne "$scopes" ]; then
        echo "HTTP raw-call inventory changed: $facade" >&2
        exit 1
    fi

    awk '
        function indent(line, copy) {
            copy = line
            sub(/[^ ].*$/, "", copy)
            return length(copy)
        }
        NF && unsafe_indent >= 0 &&
        $0 !~ /unsafe\(capabilities: \[[^]]*ffi[^]]*\]\):$/ && indent($0) <= unsafe_indent {
            unsafe_indent = -1
        }
        /unsafe\(capabilities: \[[^]]*ffi[^]]*\]\):$/ {
            unsafe_indent = indent($0)
            next
        }
        !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / &&
        /(rt_http_|rt_ws_)[A-Za-z0-9_]*[(]/ {
            if (unsafe_indent < 0 || indent($0) <= unsafe_indent) {
                print "HTTP raw call lacks lexical FFI authority: " NR ":" $0 > "/dev/stderr"
                failed = 1
            }
        }
        BEGIN { unsafe_indent = -1 }
        END { if (failed) exit 1 }
    ' "$facade"

    if grep -E '(signature|sha256|dlsym|dlopen|registry_lookup|mutex)' "$facade" >/dev/null; then
        echo "HTTP request facade gained admission or dynamic lookup work: $facade" >&2
        exit 1
    fi
done

for facade in $compat_facades; do
    grep -q '^export use std.nogc_sync_mut.io.http_sffi.{' "$facade"
    ! grep -q '^extern fn ' "$facade"
    ! grep -Eq '(rt_http_|rt_ws_)[A-Za-z0-9_]*[(]' "$facade"
    ! grep -q '^fn ' "$facade"
done

native="$root/src/runtime/runtime_native.c"
rust="$root/src/compiler_rust/compiler/src/interpreter_extern/network/mod.rs"
grep -q 'capacity >= 64 \* 1024 \* 1024' "$native"
grep -q '^int64_t rt_http_get' "$native"
grep -q '^int64_t rt_http_request' "$native"
grep -q '^int64_t rt_http_download' "$native"
grep -q '^pub fn rt_http_get' "$rust"
grep -q '^pub fn rt_http_request' "$rust"

echo "HTTP SFFI authority audit: PASS (4 canonical owners: 27 declarations/29 calls in minimal scopes; 2 app export-only facades; active native response bound retained; incomplete providers remain unsafe/link-fail-closed)"
