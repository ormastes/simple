#!/bin/sh
# Keep ptrace/DWARF raw declarations in the canonical std.sffi.debug owner.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/sffi/debug.spl"

test "$(grep -c '^@unsafe(reason: "raw OS ptrace' "$owner")" -eq 7
test "$(grep -c '^@unsafe(reason: "raw blocking OS ptrace' "$owner")" -eq 1
test "$(grep -c '^extern fn rt_ptrace_' "$owner")" -eq 8

for source in \
    "$root/src/app/debug/native_agent.spl" \
    "$root/src/app/debug/smf_agent.spl" \
    "$root/src/lib/nogc_sync_mut/debug/native_agent.spl" \
    "$root/src/lib/nogc_sync_mut/debug/smf_agent.spl"; do
    grep -q '^use std.sffi.debug.{' "$source"
    test "$(grep -c '^extern fn rt_ptrace_' "$source")" -eq 0
    test "$(grep -c '^extern fn rt_dwarf_' "$source")" -eq 0
done

echo 'debug SFFI owner authority: PASS (ptrace/DWARF declarations retained only in std.sffi.debug)'
