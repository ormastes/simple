#!/bin/sh
# Static lexical-boundary guard for the bootstrap argument probe.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/app/cli/bootstrap_probe_args.spl"

test "$(grep -c '^@unsafe(reason: "raw bootstrap argument-array ABI", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^extern fn rt_get_args() -> \[text\]$' "$module")" -eq 1
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_get_args()' "$module")" -eq 1

echo 'Bootstrap args probe SFFI authority: PASS declarations=1 lexical_calls=1 direct_call_shape=preserved artifact_admission=absent'
