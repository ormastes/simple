#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/apps/sshd/ssh_cipher.spl"

if grep -E '(^extern fn |serial_println|rt_bytes_u8_at|_u8s_hex|format_hex)' "$module" >/dev/null; then
    echo "Pure Simple SSH cipher regained a foreign or diagnostic boundary" >&2
    exit 1
fi

grep -q 'enc_key_s2c.len() != 32 or iv_s2c.len() != GCM_NONCE_LEN' "$module"
grep -q 'packet_length > SSH_GCM_PACKET_BODY_MAX' "$module"
grep -q 'encrypted_with_tag.len() != body.len() + GCM_TAG_LEN' "$module"
grep -q 'enc_key_c2s.len() != 32' "$module"
grep -q 'iv_c2s.len() != GCM_NONCE_LEN' "$module"
grep -q 'not _ssh_gcm_frame_allowed(data)' "$module"
grep -q 'data.len() == 4 + packet_length + GCM_TAG_LEN' "$module"
grep -q 'plaintext.len() != ct_len' "$module"
grep -q 'base_iv.len() != GCM_NONCE_LEN' "$module"

echo "Pure Simple SSH cipher boundary audit: PASS (no SFFI/logging; exact AES key/IV/frame/output contracts)"
