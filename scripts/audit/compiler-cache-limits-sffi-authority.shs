#!/bin/sh
set -eu

module=src/compiler/80.driver/cache/metadata/cache_limits.spl

if rg -q '^extern fn rt_' "$module"; then
    echo "cache limits must use the canonical I/O facade, not own raw SFFI" >&2
    exit 1
fi

rg -q '^use std\.io_runtime\.\{env_get_opt\}$' "$module"
test "$(rg -c 'env_get_opt\("SIMPLE_CACHE_MAX_BYTES"\)' "$module")" -eq 1
