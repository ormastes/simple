#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/apps/sshd/x86_64_sshd_autostart.spl"
header="$root/src/runtime/runtime.h"
provider="$root/src/runtime/runtime_native.c"

if [ "$(grep -c '^extern fn serial_println' "$module")" -ne 1 ] ||
   [ "$(grep -c 'serial_println(' "$module")" -ne 2 ] ||
   [ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -ne 1 ]; then
    echo "SSH autostart serial boundary inventory changed" >&2
    exit 1
fi

grep -q '@unsafe(reason: .*capabilities: \[ffi\])' "$module"
grep -q '^void     serial_println(int64_t value);' "$header"
grep -q '^void serial_println(int64_t value)' "$provider"

echo "SSH autostart SFFI contract audit: PASS (one inline minimal serial wrapper; void provider signature pinned)"
