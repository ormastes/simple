#!/bin/sh
# ROCm has a canonical no-GC I/O owner plus two legacy Engine2D facades. Keep
# their raw declarations explicit until those facades are replaced by one typed
# ABI; source-backed C alone is not signed/provider-admission evidence.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
for owner in \
    "$root/src/lib/nogc_sync_mut/gpu/engine2d/sffi_rocm.spl" \
    "$root/src/lib/nogc_sync_mut/gpu/engine2d/ffi_rocm.spl"; do
    raw_count=$(grep -c '^extern fn \(rt_rocm_\|rt_engine2d_rocm_\)' "$owner")
    unsafe_count=$(grep -B1 '^extern fn \(rt_rocm_\|rt_engine2d_rocm_\)' "$owner" | grep -c '@unsafe')
    test "$unsafe_count" -eq "$raw_count"
done
test "$(grep -c '^extern fn \(rt_rocm_\|rt_engine2d_rocm_\)' "$root/src/lib/nogc_sync_mut/gpu/engine2d/sffi_rocm.spl")" -eq 12
test "$(grep -c '^extern fn \(rt_rocm_\|rt_engine2d_rocm_\)' "$root/src/lib/nogc_sync_mut/gpu/engine2d/ffi_rocm.spl")" -eq 13

echo 'ROCm Engine2D SFFI authority: PASS (25 legacy raw declarations explicitly unsafe)'
