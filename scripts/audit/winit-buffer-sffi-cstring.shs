#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
bridge="$root/src/compiler_rust/compiler/src/interpreter_extern/winit_sffi/winit_sffi_buffer.rs"
failed=0

if grep -n -E 'CString::new\([^;]*\)\.unwrap_or_default\(\)|let Ok\(cpath\) = CString::new' "$bridge"; then
    echo "winit buffer SFFI contains an empty-CString fallback" >&2
    failed=1
fi
if ! grep -q '^unsafe extern "C"' "$bridge"; then
    echo "winit loader declarations must use an unsafe extern block" >&2
    failed=1
fi
if ! grep -q 'contains an embedded NUL' "$bridge"; then
    echo "winit text/path C-string contract is missing" >&2
    failed=1
fi

if [ "$failed" -ne 0 ]; then
    exit 1
fi

echo "winit buffer SFFI C-string audit: PASS"
