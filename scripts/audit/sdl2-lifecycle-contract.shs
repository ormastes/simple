#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
provider="$root/src/runtime/runtime_sdl2.c"
header="$root/src/runtime/runtime.h"
binding="$root/src/lib/nogc_sync_mut/io/window_sffi.spl"
dispatcher="$root/src/compiler_rust/compiler/src/interpreter_extern/sdl2.rs"
compositor="$root/src/os/compositor/hosted_backend_sdl2.spl"
web="$root/src/lib/nogc_sync_mut/web_ui/window.spl"
failed=0

quit_body=$(sed -n '/^bool rt_sdl2_quit/,/^}/p' "$provider")
destroy_body=$(sed -n '/^bool rt_sdl2_destroy_window/,/^}/p' "$provider")
if ! printf '%s\n' "$quit_body" | grep -q 'return false' ||
   ! printf '%s\n' "$quit_body" | grep -q 'return true' ||
   ! printf '%s\n' "$destroy_body" | grep -q 'return false' ||
   ! printf '%s\n' "$destroy_body" | grep -q 'return true'; then
    echo "SDL2 quit/destroy must retain explicit status on every path" >&2
    failed=1
fi
if ! grep -q '^bool     rt_sdl2_quit(void);' "$header" ||
   ! grep -q '^bool     rt_sdl2_destroy_window' "$header" ||
   ! grep -q '("rt_sdl2_quit", Ret::B, "")' "$dispatcher" ||
   ! grep -q '("rt_sdl2_destroy_window", Ret::B, "i")' "$dispatcher"; then
    echo "SDL2 lifecycle C/Rust ABI declarations must agree on status" >&2
    failed=1
fi

for symbol in init quit create_window destroy_window present_rgba; do
    if ! grep -B1 "^extern fn rt_sdl2_$symbol[<(]" "$binding" |
         grep -q '^@unsafe(reason: "raw SDL2 .*sentinel'; then
        echo "rt_sdl2_$symbol must retain its exact lifecycle contract" >&2
        failed=1
    fi
done
for wrapper in window_create_event_loop window_destroy_event_loop window_create window_destroy window_present_rgba; do
    if grep -B1 "^fn $wrapper(" "$binding" | grep -q '^@unsafe'; then
        echo "$wrapper must confine lifecycle FFI authority lexically" >&2
        failed=1
    fi
done
present=$(sed -n '/^fn window_present_rgba/,/^# --- Window Information ---/p' "$binding")
if [ "$(printf '%s\n' "$present" | grep -c 'rt_sdl2_present_rgba' || true)" -ne 1 ] ||
   printf '%s\n' "$present" | grep -Eq 'malloc|hash|lookup|mutex|retry'; then
    echo "checked presentation must remain one direct native call" >&2
    failed=1
fi
if ! grep -q 'rt_sdl2_destroy_window.*-> bool' "$compositor" ||
   grep -q '\brt_sdl2_\(destroy_window\|present_rgba\)\b' "$web"; then
    echo "lifecycle consumers must use status-bearing ownership wrappers" >&2
    failed=1
fi

if [ "$failed" -ne 0 ]; then
    exit 1
fi

echo "SDL2 lifecycle contract audit: PASS"
