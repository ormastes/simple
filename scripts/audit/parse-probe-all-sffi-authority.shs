#!/bin/sh
# Static raw-file-read elimination guard for the all-file parse probe.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/app/test/parse_probe_all.spl"

test "$(grep -c '^extern fn rt_file_read_text' "$module")" -eq 0
test "$(grep -c '^use std.io_runtime.{read_file_text_result}$' "$module")" -eq 1
test "$(grep -c 'read_file_text_result(' "$module")" -eq 2
test "$(grep -c 'case Err(error):' "$module")" -eq 2
test "$(grep -c 'parse_module(src, path)' "$module")" -eq 1

echo 'Parse probe SFFI authority: PASS local_raw_declarations=0 result_lifts=2 parse_calls=1 fabricated_empty_source=absent artifact_admission=absent'
