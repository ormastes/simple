#!/bin/sh
set -eu

module=src/compiler/85.mdsoc/config.spl

test "$(rg -c '^extern fn rt_file_read_text' "$module")" -eq 1
test "$(rg -c '^fn _mdsoc_config_read_raw' "$module")" -eq 1
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 1
rg -q '^extern fn rt_file_read_text\(path: text\) -> text\?$' "$module"
test "$(rg -c 'rt_file_read_text\(' "$module")" -eq 2
test "$(rg -c '_mdsoc_config_read_raw\(path\)' "$module")" -eq 1
