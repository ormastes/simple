#!/bin/sh
# Pin the canonical std.io environment wrapper's remaining foreign authority.
# Static source evidence only; this does not admit or sign the provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/lib/nogc_sync_mut/io/env_ops.spl"

# Lookup is owned by std.io_runtime; this compatibility module must not retain
# a duplicate raw declaration or direct call.
! grep -q '\brt_env_get\b' "$module"
grep -q 'use std.io_runtime.{process_run, env_set as io_env_set, env_get_opt}' "$module"
[ "$(grep -c 'env_get_opt(' "$module")" -eq 3 ]

# The runtime provider returns a nullable tuple array, never a Dict. Keep one
# direct lexical owner so snapshotting adds no conversion allocation or lookup.
[ "$(grep -c '^extern fn rt_env_vars() -> \[(text, text)\]?' "$module")" -eq 1 ]
! grep -q 'rt_env_vars() -> Dict' "$module"
[ "$(grep -c '^@unsafe(' "$module")" -eq 2 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 1 ]
[ "$(grep -c '\brt_env_vars()' "$module")" -eq 2 ]
grep -q '^fn env_vars() -> \[(text, text)\]?:' "$module"

echo 'env_ops SFFI authority audit: PASS (duplicate env lookup removed; nullable tuple-array ABI preserved; one direct snapshot owner; no Dict conversion allocation)'
