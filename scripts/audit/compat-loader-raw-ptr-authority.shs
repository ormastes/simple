#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/99.loader/module_loader_compat.spl"

[ "$(grep -c 'unsafe(capabilities: \[raw_ptr\]):' "$module")" -eq 11 ]
[ "$(grep -o 'native_write_exec_memory(' "$module" | wc -l)" -eq 1 ]
[ "$(grep -o 'native_make_rw(' "$module" | wc -l)" -eq 1 ]
[ "$(grep -o 'native_make_executable(' "$module" | wc -l)" -eq 2 ]
[ "$(grep -o 'native_reloc_write_i32(' "$module" | wc -l)" -eq 4 ]
[ "$(grep -o 'native_reloc_write_i64(' "$module" | wc -l)" -eq 1 ]
[ "$(grep -o 'native_call_function_0(' "$module" | wc -l)" -eq 2 ]

grep -q 'val write_width = if reloc.reloc_type == 1: 8 else: 4' "$module"
grep -q 'reloc.offset > loaded_sym.size - write_width' "$module"
grep -q 'loaded_sym.address > 0x7FFFFFFFFFFFFFFF - reloc.offset' "$module"

echo "Compatibility loader raw-pointer audit: PASS (11 minimal authority blocks; full-width relocation bounds; existing single-pass load retained)"
