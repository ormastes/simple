#!/bin/sh
set -eu

module=src/compiler/00.common/config.spl

test "$(rg -c '^extern fn rt_env_get' "$module")" -eq 1
test "$(rg -c '^fn env_get\(key: text\)' "$module")" -eq 1
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 1
rg -q '^extern fn rt_env_get\(key: text\) -> text\?$' "$module"
test "$(rg -c 'rt_env_get\(' "$module")" -eq 2
test "$(rg -c '@always_inline' "$module")" -eq 1
