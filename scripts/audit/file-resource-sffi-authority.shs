#!/bin/sh
set -eu

module=src/lib/nogc_sync_mut/io/file_ops.spl

test "$(rg -c '^fn _file_(lock|unlock|mmap|munmap|madvise|msync)_raw' "$module")" -eq 6

for symbol in rt_file_lock rt_file_unlock rt_mmap rt_munmap rt_madvise rt_msync; do
    test "$(rg -c "${symbol}\\(" "$module")" -eq 2
done

for api in file_lock file_unlock file_mmap file_munmap file_madvise file_msync; do
    line="$(rg -n "^fn ${api}\\(" "$module" | cut -d: -f1)"
    test -n "$line"
    start=$((line - 1))
    sed -n "${start}p" "$module" | rg -q '^@unsafe\(reason: .*capabilities: \[ffi\]\)$'
done
