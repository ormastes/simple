#!/bin/sh
set -eu

interpreter=src/compiler_rust/compiler/src/interpreter_extern/crypto.rs
native=src/runtime/runtime.c
spec=test/01_unit/lib/common/base_encoding/base64/base64url_crosslang_spec.spl

for entry in base64_encode:1 base64_decode:1 sha1:1 base64url_decode:1 base64url_encode:2; do
    suffix=${entry%%:*}
    arity=${entry##*:}
    name="rt_${suffix}"
    body="$(sed -n "/^pub fn ${name}/,/^}/p" "$interpreter")"
    printf '%s\n' "$body" | rg -q "require_arity\(args, ${arity}, \"${name}\"\)\?;"
done

decode="$(sed -n '/^pub fn rt_base64url_decode/,/^}/p' "$interpreter")"
printf '%s\n' "$decode" | rg -q 'invalid base64url input'
! printf '%s\n' "$decode" | rg -q 'String::from_utf8_lossy|String::new'
encode="$(sed -n '/^pub fn rt_base64url_encode/,/^}/p' "$interpreter")"
printf '%s\n' "$encode" | rg -q 'usize::try_from'
printf '%s\n' "$encode" | rg -q 'exceeds payload length'

c_encode="$(sed -n '/^const char\* rt_base64url_encode/,/^}/p' "$native")"
printf '%s\n' "$c_encode" | rg -q 'SIZE_MAX - 2'
printf '%s\n' "$c_encode" | rg -q 'if \(!out\) return NULL;'
c_decode="$(sed -n '/^const char\* rt_base64url_decode/,/^}/p' "$native")"
printf '%s\n' "$c_decode" | rg -q 'in_len % 4 == 1'
printf '%s\n' "$c_decode" | rg -q 'SPL_FREE\(out\);'
! printf '%s\n' "$c_decode" | rg -q 'if \(a < 0\) a = 0|if \(b < 0\) b = 0'

test "$(rg -c '^@unsafe\(reason: "raw nullable C Base64url' "$spec")" -eq 2
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$spec")" -eq 2
test "$(rg -c '^[[:space:]]+rt_base64url_encode\(' "$spec")" -eq 1
test "$(rg -c '^[[:space:]]+rt_base64url_decode\(' "$spec")" -eq 1

echo "Base64url SFFI audit: PASS (strict arity/length/alphabet; nullable C failures lifted once; one-pass provider loops)"
