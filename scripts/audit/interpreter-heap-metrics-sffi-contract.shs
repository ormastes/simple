#!/bin/sh
set -eu

provider=src/compiler_rust/compiler/src/interpreter_extern/memory.rs
registration=src/compiler_rust/compiler/src/interpreter_extern/mod.rs

for name in rt_heap_registry_count rt_heap_live_bytes \
    rt_heap_aux_live_bytes rt_heap_array_capacity_bytes; do
    body="$(sed -n "/^pub fn ${name}/,/^}/p" "$provider")"
    printf '%s\n' "$body" | rg -q 'if !args.is_empty\(\)'
    printf '%s\n' "$body" | rg -q 'return Err\(CompileError::runtime'
    rg -q "insert_simple!\(\"${name}\"" "$registration"
done

for name in rt_heap_live_bytes_by_kind rt_heap_live_count_by_kind; do
    body="$(sed -n "/^pub fn ${name}/,/^}/p" "$provider")"
    printf '%s\n' "$body" | rg -q 'if args.len\(\) != 1'
    printf '%s\n' "$body" | rg -q 'let kind = args\[0\]\.as_int\(\)\?;'
    ! printf '%s\n' "$body" | rg -q 'return Ok\(Value::Int\(0\)\)'
    rg -q "insert_simple!\(\"${name}\"" "$registration"
done

echo "interpreter heap metrics SFFI contract audit: PASS (exact arity/type; genuine zero retained; no fabricated ABI defaults)"
