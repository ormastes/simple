#!/bin/sh
set -eu

module=src/compiler/50.mir/_MirLowering/function_lowering.spl

test "$(rg -c '^extern fn rt_enum_discriminant\(' "$module")" -eq 1
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 1
test "$(rg -c '^[[:space:]]+rt_enum_discriminant\(' "$module")" -eq 1
test "$(rg -c '_sffi_hir_type_discriminant\(' "$module")" -eq 23
rg -q '^@always_inline$' "$module"
rg -q '^fn _sffi_hir_type_discriminant\(value: Any\) -> i64:$' "$module"
