#!/bin/sh
set -eu

cap=src/compiler/30.types/simd_capabilities.spl
platform=src/compiler/30.types/simd_platform.spl

symbols='cpuid getauxval is_darwin_arm64 sysctlbyname_i32 riscv_read_vlenb riscv_has_v_ext cpu_is_x86_64 cpu_is_aarch64 cpu_is_riscv64 cuda_sm_version'

test "$(rg -c '^extern fn rt_' "$cap")" -eq 10
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$cap")" -eq 10
for symbol in $symbols; do
    test "$(rg -c "^extern fn rt_${symbol}\\(" "$cap")" -eq 1
    test "$(rg -c "^[[:space:]]+rt_${symbol}\\(" "$cap")" -eq 1
done

if rg -q 'rt_file_read_text\(' "$cap" "$platform"; then
    echo "SIMD detection must use the typed one-read file contract" >&2
    exit 1
fi
test "$(rg -c 'file_read_result\(' "$cap")" -eq 1
test "$(rg -c 'file_read_result\(' "$platform")" -eq 1
test "$(rg -c '_sffi_cpuid\(' "$cap")" -eq 4
test "$(rg -c '_sffi_getauxval\(' "$cap")" -eq 3
test "$(rg -c '_sffi_sysctlbyname_i32\(' "$cap")" -eq 3
test "$(rg -c '_sffi_cpu_is_(x86_64|aarch64|riscv64)\(' "$cap")" -eq 6
