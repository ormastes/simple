#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/runtime/simple_core/core_array_ops.spl"

declarations=$(grep -c '^[[:space:]]*extern fn ' "$owner")
if [ "$declarations" -ne 24 ]; then
    echo "simple-core array extern inventory changed without contract review" >&2
    exit 1
fi
tagged=$(awk '
    /^@unsafe\(.*capabilities: \[[^]]*ffi[^]]*\]\)$/ { previous_is_ffi = 1; next }
    /^[[:space:]]*extern fn / {
        if (previous_is_ffi) tagged++
    }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$owner")
if [ "$tagged" -ne "$declarations" ]; then
    echo "every simple-core array extern must be explicitly unsafe(ffi)" >&2
    exit 1
fi
grep -A2 'val items = calloc(actual_cap, 8)' "$owner" | grep -q 'free(array)' || {
    echo "u64 array item-allocation failure must release its header" >&2
    exit 1
}
grep -q 'actual_cap > 1152921504606846975' "$owner" || {
    echo "u64 array capacity multiplication must be overflow-guarded" >&2
    exit 1
}
grep -q 'len_a > 9223372036854775807 - len_b' "$owner" || {
    echo "array concatenation length must be overflow-guarded" >&2
    exit 1
}

echo "simple-core array SFFI contract audit: PASS"
