#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
canonical="$root/src/lib/nogc_sync_mut/sffi/runtime.spl"
facade="$root/src/lib/nogc_sync_mut/ffi/runtime.spl"

if [ "$(grep -c '^[[:space:]]*extern fn ' "$canonical")" -ne 32 ]; then
    echo "canonical runtime SFFI inventory changed without contract review" >&2
    exit 1
fi
if grep -n -E 'extern fn |^[[:space:]]*fn ' "$facade"; then
    echo "runtime FFI compatibility facade duplicates providers or wrappers" >&2
    exit 1
fi
if ! grep -q '^export use std\.nogc_sync_mut\.sffi\.runtime\.\*$' "$facade"; then
    echo "runtime FFI compatibility facade must re-export the canonical owner" >&2
    exit 1
fi

echo "runtime SFFI owner audit: PASS"
