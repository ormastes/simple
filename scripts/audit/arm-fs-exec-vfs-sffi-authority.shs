#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/services/vfs/arm_fs_exec_vfs.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
unbacked="$root/scripts/check/unbacked_extern_baseline.txt"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in rt_arm_array_len_u32 rt_arm_array_get_byte_u32 \
    rt_arm_array_get_u16_le rt_arm_array_get_u32_le \
    rt_arm_array_append_bytes rt_arm_virtio_blk_read_prefix \
    rt_arm_fat32_probe_bpb_from_virtio rt_array_new_with_cap \
    serial_println arm_fs_exec_trace; do
    [ "$(grep -Ec "^extern fn ${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$module")" -eq 1 ]
done

if grep -q 'rt_arm_virtio_blk_read_hello_smf' "$module"; then
    echo "ARM VFS regained its unused hello-SMF boundary" >&2
    exit 1
fi
[ "$(grep -c '^@unsafe(' "$module")" -eq 10 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 10 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 10 ]
for expected in _sffi_arm_array_len_u32:27 \
    _sffi_arm_array_get_byte_u32:2 _sffi_arm_array_get_u16_le:2 \
    _sffi_arm_array_get_u32_le:2 _sffi_arm_array_append_bytes:3 \
    _sffi_arm_virtio_blk_read_prefix:3 \
    _sffi_arm_fat32_probe_bpb_from_virtio:2 \
    _sffi_array_new_with_cap:3 _sffi_serial_println:2 \
    _sffi_arm_fs_exec_trace:61; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done

for raw in rt_arm_array_len_u32 rt_arm_array_get_byte_u32 \
    rt_arm_array_get_u16_le rt_arm_array_get_u32_le \
    rt_arm_array_append_bytes rt_arm_virtio_blk_read_prefix; do
    grep -q "RuntimeFuncSpec::new(\"$raw\"" "$registry"
done
# These target-owned symbols still lack an authoritative provider in src/;
# keep that limitation explicit instead of treating example C stubs as proof.
for raw in arm_fs_exec_trace rt_arm_array_append_bytes \
    rt_arm_fat32_probe_bpb_from_virtio rt_arm_virtio_blk_read_prefix; do
    grep -qx "$raw" "$unbacked"
done

grep -A3 'if init_result.ok:' "$module" | grep -q 'if not _arm_fat32_probe_bpb(dev):'
[ "$(grep -c 'if _sffi_arm_array_append_bytes' "$module")" -eq 2 ]
[ "$(grep -c 'val direct_len = _sffi_arm_array_len_u32(direct)' "$module")" -eq 1 ]
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "ARM fs-exec VFS SFFI authority audit: PASS (raw calls confined; failed BPB/short append stop; unbacked providers remain explicit)"
