#!/bin/sh
# Cache admission may not spread raw filesystem/directory contracts.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/80.driver/cache/gc/admission.spl"

test "$(grep -c '^extern fn rt_' "$module")" -eq 4
tagged=$(awk '/^@unsafe\(.*capabilities: \[ffi\]\)$/ { tagged=1; next }
    /^extern fn rt_/ { if (tagged) count++ }
    { tagged=0 }
    END { print count + 0 }' "$module")
test "$tagged" -eq 4
test "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 4
test "$(grep -Ec '^        rt_' "$module")" -eq 4
grep -q '^use std.nogc_sync_mut.io_runtime.{file_read_nullable}$' "$module"
! grep -q '^extern fn rt_file_read_text' "$module"

echo 'cache admission SFFI authority: PASS (four inlined raw owners; nullable pin reads)'
