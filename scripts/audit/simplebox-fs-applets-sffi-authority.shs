#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/tools/simplebox/simplebox_fs_applets.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^@unsafe(reason: "foreign stdout provider' "$module")" -eq 1 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 1 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 1 ]
[ "$(grep -c '_simplebox_stdout_write(' "$module")" -eq 43 ]
[ "$(grep -Ec '(^|[^_])stdout_write\(' "$module")" -eq 2 ]

providers=0
grep -q 'RuntimeFuncSpec::new("stdout_write"' "$registry" && providers=$((providers + 1))
grep -q 'insert_simple!("stdout_write"' "$interpreter" && providers=$((providers + 1))
[ "$providers" -eq 1 ]

grep -q 'SIMPLEBOX_FILE_BYTES_LIMIT: u64 = 67108864u64' "$module"
grep -q 'SIMPLEBOX_READ_CHUNK_BYTES: u64 = 65536u64' "$module"
grep -q 'return Err("write made invalid progress")' "$module"
grep -q 'return Err("write made no progress")' "$module"

echo "Simplebox filesystem applet SFFI authority audit: PASS (42 stdout writes routed through 1 mandatory-inline lexical owner; 0 both/1 one/0 no-provider; streaming byte/chunk/progress bounds retained)"
