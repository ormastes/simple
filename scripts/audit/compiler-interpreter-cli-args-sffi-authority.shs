#!/bin/sh
set -eu

module=src/compiler/10.frontend/core/interpreter/cli_eval.spl

if rg -q '^extern fn rt_cli_get_args\(' "$module"; then
    echo "interpreter CLI evaluation must not own duplicate argv authority" >&2
    exit 1
fi
rg -q '^use std\.io_runtime\.\{get_args\}$' "$module"
test "$(rg -c 'get_args\(' "$module")" -eq 1
rg -q '^    val all_args = get_args\(\)$' "$module"
rg -q '^    var argv: \[text\] = \[\]$' "$module"
