#!/bin/sh
set -eu

module=src/compiler/10.frontend/frontend.spl

if rg -q '^extern fn rt_env_get\(' "$module"; then
    echo "frontend runner must not own raw environment authority" >&2
    exit 1
fi
rg -q '^var _frontend_phase_trace_state: i64 = -1$' "$module"
rg -q '^@always_inline$' "$module"
test "$(rg -c 'env_get_opt\("SIMPLE_COMPILER_TRACE"\)' "$module")" -eq 1
test "$(rg -c 'frontend_phase_trace_enabled\(' "$module")" -eq 3
test "$(rg -c '_frontend_phase_trace_state' "$module")" -eq 4
