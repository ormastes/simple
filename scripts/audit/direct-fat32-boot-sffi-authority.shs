#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/services/vfs/direct_fat32_boot_reader.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^extern fn ' "$module")" -eq 4 ]
[ "$(grep -c '^@unsafe(reason:' "$module")" -eq 4 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 4 ]

call_count=$(perl -0ne '
    s/""".*?"""//sg; s/#.*//mg; s/^\s*extern fn .*\n//mg;
    while (/\b(?:serial_println|rt_byte_array_new|rt_typed_bytes_u8_push|rt_bytes_u8_at)\s*\(/g) { $n++ }
    END { print $n + 0 }
' "$module")
[ "$call_count" -eq 4 ]

! grep -q '^extern fn rt_text_to_bytes' "$module"
! grep -q '^extern fn rt_array_new_with_cap' "$module"
grep -q 'var out: \[u8\] = _vfs_boot_new_packed_bytes(size as i64)' "$module"
grep -q 'if not _vfs_boot_packed_byte_push(out, byte_value):' "$module"
grep -q 'size > VFS_BOOT_DIRECT_MAX_FILE_BYTES' "$module"
grep -q 'cluster_hops < max_cluster_hops' "$module"
grep -q 'if next_cluster == cycle_anchor:' "$module"

# A malformed extent must not become FAT byte zero/end-of-directory. The typed
# boot-sector error must run before diagnostic byte access.
grep -q 'panic("FAT32 byte offset is outside the validated buffer")' "$module"
short_line=$(grep -n 'return Err("boot-sector-short")' "$module" | head -1 | cut -d: -f1)
debug_line=$(grep -n 'fat32 direct boot len=' "$module" | head -1 | cut -d: -f1)
[ "$short_line" -lt "$debug_line" ]

! grep -q 'RuntimeFuncSpec::new("serial_println"' "$registry"
grep -q 'insert_simple!("serial_println"' "$interpreter"
for symbol in rt_byte_array_new rt_typed_bytes_u8_push rt_bytes_u8_at; do
    grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry"
    grep -q "insert_simple!(\"$symbol\"" "$interpreter"
done

echo "Direct FAT32 boot SFFI authority audit: PASS (27 former calls routed through 4 mandatory-inline owners; packed-byte capacity and checked append retained; OOB byte fabrication removed; traversal/file bounds retained; 3 both/1 interpreter-only providers)"
