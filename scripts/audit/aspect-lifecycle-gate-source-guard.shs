#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

LOCKED_METHOD_RE='^[[:space:]]+((pub|me|static)[[:space:]]+)*fn[[:space:]]+[a-zA-Z0-9_]+_locked[[:space:]]*\('
LOCKED_EXPORT_RE='^export([[:space:]]+.*)?_locked|^[[:space:]]+aspect_execution_context_.*_locked[[:space:]]*,'
DISCARDED_RELEASE_RE='^[[:space:]]*((val[[:space:]]+_.*|_)[[:space:]]*=[[:space:]]*)?self\.release_published_facet_descriptor[[:space:]]*\('

has_locked_method() {
    rg -n "$LOCKED_METHOD_RE" "$1"
}

has_locked_export() {
    rg -n "$LOCKED_EXPORT_RE" "$1"
}

has_discarded_release() {
    rg -n "$DISCARDED_RELEASE_RE" "$1"
}

self_test() {
    tmp_dir="${TMPDIR:-/tmp}/aspect-lifecycle-gate-source-guard.$$"
    mkdir -p "$tmp_dir"
    trap 'rm -rf "$tmp_dir"' EXIT
    method_index=0
    for line in \
        '    fn plain_locked():' \
        '    me fn member_locked ():' \
        '    pub fn public_locked():' \
        '    me static fn mixed_locked():'
    do
        method_index=$((method_index + 1))
        printf '%s\n' "$line" >"$tmp_dir/method-${method_index}.spl"
        has_locked_method "$tmp_dir/method-${method_index}.spl" >/dev/null || {
            echo "STATUS: FAIL lifecycle gate guard missed locked method variant ${method_index}" >&2
            exit 1
        }
    done
    release_index=0
    for line in \
        '_ = self.release_published_facet_descriptor(value)' \
        'val _ = self.release_published_facet_descriptor(value)' \
        'self.release_published_facet_descriptor(value)'
    do
        release_index=$((release_index + 1))
        printf '%s\n' "$line" >"$tmp_dir/release-${release_index}.spl"
        has_discarded_release "$tmp_dir/release-${release_index}.spl" >/dev/null || {
            echo "STATUS: FAIL lifecycle gate guard missed discarded release variant ${release_index}" >&2
            exit 1
        }
    done
    printf '%s\n' \
        'val released = self.release_published_facet_descriptor(value)' \
        'return self.release_published_facet_descriptor(value)' >"$tmp_dir/safe.spl"
    if has_discarded_release "$tmp_dir/safe.spl" >/dev/null; then
        echo "STATUS: FAIL lifecycle gate guard rejected handled release" >&2
        exit 1
    fi
    echo "STATUS: PASS aspect-lifecycle-gate-source-guard self-test"
}

if [ "${1:-}" = "--self-test" ]; then
    self_test
    exit 0
fi
if [ "$#" -ne 0 ]; then
    echo "Usage: sh scripts/audit/aspect-lifecycle-gate-source-guard.shs [--self-test]" >&2
    exit 2
fi

runtime_source="src/app/startup/aspect_application_runtime.spl"
capture_source="src/app/startup/aspect_lifecycle_capture_contract.spl"
lazy_source="src/app/startup/aspect_lazy_activation_transition.spl"
facet_lifecycle_source="src/app/startup/aspect_facet_lifecycle_transition.spl"
unload_source="src/app/startup/aspect_unload_transition.spl"
prepared_transition_source="src/app/startup/aspect_prepared_advice_transition.spl"
pack_transition_source="src/app/startup/aspect_pack_activation_transition.spl"
policy_transition_source="src/app/startup/aspect_application_policy_transition.spl"
prepared_abi_source="src/app/startup/aspect_prepared_advice_compiler_abi.spl"

if has_locked_method "$runtime_source"; then
    echo "FAIL: lifecycle locked helper remains on the exported context method surface" >&2
    exit 1
fi

if has_locked_export "$runtime_source"; then
    echo "FAIL: lifecycle locked helper is exported" >&2
    exit 1
fi

for transition_source in \
    "$lazy_source" \
    "$facet_lifecycle_source" \
    "$unload_source" \
    "$prepared_transition_source" \
    "$pack_transition_source" \
    "$policy_transition_source"
do
    if rg -n '^use .*AspectExecutionContext|aspect_application_runtime|mutex_with_lock' \
        "$transition_source"; then
        echo "FAIL: transition leaf imports runtime context or mutex ownership: ${transition_source}" >&2
        exit 1
    fi
done

for box_name in \
    AspectGenerationTokenBox \
    AspectFacetGenerationLeaseBox \
    AspectFacetQueryBox \
    AspectFacetMethodQueryBox \
    AspectFacetDescriptorBox \
    AspectFacetContractQueryBox \
    AspectActivationInputBox \
    AspectLazyCommitBox
do
    owner_source="$capture_source"
    if [ "$box_name" = "AspectLazyCommitBox" ]; then
        owner_source="$lazy_source"
    fi
    if ! rg -q "^class ${box_name}:" "$owner_source"; then
        echo "FAIL: missing lifecycle mutex capture box: ${box_name}" >&2
        exit 1
    fi
    if ! rg -q "${box_name}[[:space:]]*\(" "$runtime_source"; then
        echo "FAIL: lifecycle mutex capture box is declared but unused: ${box_name}" >&2
        exit 1
    fi
done

preflight_line=$(rg -n 'aspect_execution_context_lazy_preflight_locked\(' "$runtime_source" | head -n 1 | cut -d: -f1)
io_line=$(rg -n 'capsule\.pack_io\.load_exact_route\(' "$runtime_source" | cut -d: -f1)
commit_line=$(rg -n 'aspect_execution_context_lazy_commit_and_acquire_locked\(' "$runtime_source" | head -n 1 | cut -d: -f1)
if [ -z "$preflight_line" ] || [ -z "$io_line" ] || [ -z "$commit_line" ] || \
    [ "$preflight_line" -ge "$io_line" ] || [ "$io_line" -ge "$commit_line" ]; then
    echo "FAIL: lazy activation is not ordered as gated preflight, exact I/O, gated commit" >&2
    exit 1
fi
if [ "$(rg -c 'capsule\.pack_io\.load_exact_route\(' "$runtime_source")" -ne 1 ]; then
    echo "FAIL: lazy activation must have one exact-route I/O call site" >&2
    exit 1
fi
if ! rg -q 'activation_key: text' "$lazy_source" || \
    ! rg -q 'in_flight\.has\(activation_key\)' "$lazy_source" || \
    ! rg -q 'in_flight\[activation_key\] == request\.request_id' "$lazy_source" || \
    ! rg -q 'current_activation_key == capsule\.activation_key' "$lazy_source"; then
    echo "FAIL: lazy reservation ownership is not bound to the exact activation key" >&2
    exit 1
fi
if rg -q 'for key in .*\.in_flight\.keys\(\)' "$lazy_source"; then
    echo "FAIL: lazy reservation ownership/cancel scans request IDs globally" >&2
    exit 1
fi
if rg -n '_ = .*\.complete_failure\(' "$runtime_source" "$lazy_source"; then
    echo "FAIL: lazy owner discards failure-completion notification errors" >&2
    exit 1
fi

if has_discarded_release "$runtime_source"; then
    echo "FAIL: lazy completion discards descriptor release failure" >&2
    exit 1
fi

for transition_call in \
    aspect_published_advice_lookup \
    aspect_published_facet_method_acquire \
    aspect_published_facet_descriptor_acquire \
    aspect_published_facet_descriptor_release \
    aspect_unload_transition
do
    call_line=$(rg -n "val transitioned = ${transition_call}\\(" "$runtime_source" | cut -d: -f1)
    install_line=$(rg -n '(self|context)\.coordinator = transitioned\.coordinator' "$runtime_source" | \
        awk -F: -v call_line="$call_line" '$1 > call_line { print $1; exit }')
    if [ -z "$call_line" ] || [ -z "$install_line" ]; then
        echo "FAIL: mutating transition lacks unconditional coordinator installation: ${transition_call}" >&2
        exit 1
    fi
done

prepare_line=$(rg -n 'aspect_prepared_advice_prepare\(' "$runtime_source" | tail -n 1 | cut -d: -f1)
native_line=$(rg -n 'advice_dispatch_permit_invoke_native\(' "$runtime_source" | tail -n 1 | cut -d: -f1)
finish_line=$(rg -n 'aspect_prepared_advice_finish\(' "$runtime_source" | tail -n 1 | cut -d: -f1)
if [ "$(rg -c 'advice_dispatch_permit_invoke_native\(' "$runtime_source")" -ne 1 ] || \
    [ "$prepare_line" -ge "$native_line" ] || [ "$native_line" -ge "$finish_line" ]; then
    echo "FAIL: prepared native invocation is not the sole unlocked prepare/finish middle phase" >&2
    exit 1
fi

if rg -n 'prepared_advice_dispatch_context_invoke_or_panic_or_panic' \
    src test; then
    echo "FAIL: collided prepared-advice panic ABI symbol" >&2
    exit 1
fi
for prepared_symbol in \
    prepared_advice_dispatch_context_invoke \
    prepared_advice_dispatch_context_invoke_or_panic
do
    if ! rg -q "^fn ${prepared_symbol}\\(" "$prepared_abi_source" || \
        ! rg -q "^export ${prepared_symbol}$" "$prepared_abi_source" || \
        rg -q "^fn ${prepared_symbol}\\(|^export ${prepared_symbol}$" "$runtime_source"; then
        echo "FAIL: prepared-advice ABI symbol owner is unstable: ${prepared_symbol}" >&2
        exit 1
    fi
done
if ! rg -q 'export use app.startup.aspect_prepared_advice_compiler_abi' \
    src/app/startup/__init__.spl; then
    echo "FAIL: startup facade does not re-export prepared-advice ABI leaf" >&2
    exit 1
fi

runtime_lines=$(wc -l < "$runtime_source")
if [ "$runtime_lines" -gt 795 ]; then
    echo "FAIL: aspect application runtime exceeds the 795-line owner budget: ${runtime_lines}" >&2
    exit 1
fi

echo "PASS: aspect lifecycle gate helpers are module-private and aggregate captures are boxed"
