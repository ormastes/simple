#!/bin/sh
set -eu

module=src/compiler/10.frontend/core/interpreter/module_loader_lazy.spl

if rg -q '^extern fn rt_(file_read_text|env_get)\(' "$module"; then
    echo "lazy module loader must not own raw file/environment authority" >&2
    exit 1
fi
rg -q '^use std\.io_runtime\.\{env_get_opt, file_read_result\}$' "$module"
rg -q '^fn _lazy_try_read\(path: text\) -> Result<text, text>:$' "$module"
test "$(rg -c 'file_read_result\(' "$module")" -eq 1
test "$(rg -c 'env_get_opt\(' "$module")" -eq 2
test "$(rg -c '_lazy_try_read\(' "$module")" -eq 4
test "$(rg -c '_lazy_lib_root\(' "$module")" -eq 2
test "$(rg -c '_lazy_lib_root_cache = "@@unset@@"' "$module")" -eq 1
rg -q 'var _lazy_lib_root_cache: text = "@@unset@@"' "$module"
rg -q 'if source == nil:' "$module"
