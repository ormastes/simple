#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/lib/nogc_sync_mut/io/audio_sffi.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^extern fn ' "$module")" -eq 39 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 36 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 15 ]
[ "$(grep -c '^@unsafe(reason: "copyable raw audio' "$module")" -eq 21 ]

# No declaration currently has cross-lane typed/interpreter registration.
symbols=$(sed -n 's/^extern fn \([A-Za-z0-9_]*\)(.*/\1/p' "$module")
for symbol in $symbols; do
    ! grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry"
    ! grep -q "insert_simple!(\"$symbol\"" "$interpreter"
done

# Semantic statuses remain booleans and are not coerced to numeric APIs.
grep -q '^fn audio_set_pitch(sound_handle: i64, pitch: f64) -> bool:' "$module"
grep -q '^fn audio_is_playing(playback: AudioPlayback) -> bool:' "$module"
grep -q '^fn audio_backend_is_real() -> bool:' "$module"

echo "audio SFFI authority audit: PASS (39 raw declarations; 21 unsafe handle/buffer facades + 15 lexical global/status owners; 0 typed/interpreter registrations; mandatory-inline)"
