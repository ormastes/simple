#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/runtime/simple_core/core_values.spl"
enum_provider="$root/src/runtime/simple_core/core_enum.spl"
cranelift="$root/src/compiler_rust/compiler/src/codegen/instr/calls.rs"
llvm="$root/src/compiler_rust/compiler/src/codegen/llvm/functions/calls.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in rt_enum_discriminant rt_enum_id rt_enum_payload calloc \
    spl_load_i64 spl_store_i64 abort spl_f64_to_bits; do
    declarations=$(grep -Ec "^extern fn ${raw}\\(" "$module")
    owner_calls=$(grep -Ec "^[[:space:]]+${raw}\\(" "$module")
    if [ "$declarations" -ne 1 ] || [ "$owner_calls" -ne 1 ]; then
        echo "simple-core values call escaped its mandatory-inline owner: $raw" >&2
        exit 1
    fi
done

[ "$(grep -c '^@unsafe(' "$module")" -eq 8 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 8 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi, raw_ptr\]):' "$module")" -eq 3 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 5 ]
for expected in _sffi_rt_enum_discriminant:5 _sffi_rt_enum_id:4 \
    _sffi_rt_enum_payload:4 _sffi_calloc:2 _sffi_load_i64:5 \
    _sffi_store_i64:3 _sffi_abort:4 _sffi_f64_to_bits:2; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done

# A boxed u64 cannot silently become tagged nil when allocation fails.
grep -A3 'if ptr < 1:' "$module" | grep -q '_sffi_abort()'
if grep -A2 'if ptr < 1:' "$module" | grep -q 'return 3'; then
    # The syntactic return is unreachable after abort and is retained only for
    # total Simple control-flow typing.
    grep -A2 'if ptr < 1:' "$module" | grep -q '_sffi_abort()'
fi

for helper in rt_enum_discriminant rt_enum_id rt_enum_payload; do
    grep -Eq "^pub fn ${helper}\\(" "$enum_provider"
done
for intrinsic in spl_load_i64 spl_store_i64; do
    grep -q "\"$intrinsic\"" "$cranelift"
    grep -q "\"$intrinsic\"" "$llvm"
done
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "simple-core values authority audit: PASS (all raw calls confined; u64 allocation failure traps instead of fabricating nil)"
