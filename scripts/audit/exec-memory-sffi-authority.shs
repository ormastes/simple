#!/bin/sh
set -eu

# The removed exec_memory spec declared an unimplemented RWX/raw-function-
# pointer ABI. Real loader execution uses the canonical smf_mmap_native W^X
# owner. Keep the dead providerless surface absent and the real owner intact.

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
legacy="$root/src/compiler/90.tools/sffi_gen/specs/exec_memory.spl"
owner="$root/src/compiler/99.loader/smf_mmap_native.spl"

[ ! -e "$legacy" ]

if rg -n --glob '*.spl' --glob '!**/vendor/**' \
    'extern fn rt_(alloc_exec_memory|free_exec_memory|write_exec_memory|make_executable|alloc_rw_memory|flush_icache|get_function_pointer|call_function_[012]|is_executable|get_protection|set_protection|exec_memory_(total|count|dump_stats))\b' \
    "$root/src" "$root/test" >/dev/null; then
    echo 'providerless executable-memory SFFI returned' >&2
    exit 1
fi

rg -q '^extern fn rt_mmap_raw\(' "$owner"
rg -q '^extern fn rt_mprotect\(' "$owner"
rg -q '^fn native_alloc_exec_memory\(' "$owner"
rg -q '^fn native_make_executable\(' "$owner"
rg -A8 '^fn native_make_executable\(' "$owner" \
    | rg -q 'PROT_READ \| PROT_EXEC'

for ledger in \
    scripts/check/seed_extern_registry_baseline.txt \
    scripts/check/interpreter_extern_gap_baseline.txt \
    scripts/check/unbacked_extern_baseline.txt \
    scripts/check/raw_sffi_unsafe_baseline.tsv
do
    if rg -q 'exec_memory\.spl|rt_(alloc_exec_memory|alloc_rw_memory|call_function_[012]|exec_memory_(count|dump_stats|total)|flush_icache|free_exec_memory|get_function_pointer|get_protection|is_executable|make_executable|set_protection|write_exec_memory)' "$root/$ledger"; then
        echo "stale executable-memory SFFI ledger entry: $ledger" >&2
        exit 1
    fi
done

echo 'executable-memory SFFI authority: PASS (dead RWX ABI absent; canonical W^X loader owner retained)'
