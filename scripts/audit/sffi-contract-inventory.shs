#!/bin/sh
# Produce the owned Simple extern/SFFI contract ledger.
#
# Columns distinguish runtime backing from boundary safety. A symbol being
# present in a binary is not evidence that its ABI, nullability, ownership, or
# artifact signature has been verified.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
out=${1:-/dev/stdout}
symbols_out=${2:-}
if [ -z "$symbols_out" ] && [ "$out" != "/dev/stdout" ]; then
    symbols_out=${out%.tsv}.symbols.tsv
fi
simple_bin=${SIMPLE_BIN:-$root/bin/release/x86_64-unknown-linux-gnu/simple}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

SIMPLE_BIN=$simple_bin sh "$root/scripts/check/extern-backing-census.shs" \
    "$work/backing.tsv" >/dev/null

export SFFI_ROOT=$root
find "$root/src" "$root/test" -type f -name '*.spl' ! -path '*/vendor/*' -print0 >"$work/files.bin"
xargs -0 -r -n 200 perl -MDigest::SHA=sha256_hex -0ne '
    my $file = $ARGV;
    my @lines = split /\n/, $_, -1;
    for (my $i = 0; $i <= $#lines; $i++) {
        my $line = $lines[$i];
        next if $line =~ /^\s*#/;
        my $symbol = "";
        my $decl_start = $i;
        if ($line =~ /^\s*(?:pub\s+)?(?:unsafe\s+)?extern\s+fn\s+([A-Za-z_]\w*)/) {
            $symbol = $1;
        } elsif ($line =~ /\@extern\s*\(/) {
            my @quoted = ($line =~ /"([A-Za-z_]\w*)"/g);
            next if !@quoted;
            $symbol = $quoted[-1];
            $decl_start++;
            while ($decl_start <= $#lines && $decl_start - $i < 16 &&
                   $lines[$decl_start] !~ /^\s*(?:pub\s+)?(?:unsafe\s+)?fn\s+[A-Za-z_]\w*\s*\(/) {
                $decl_start++;
            }
            next if $decl_start > $#lines || $decl_start - $i >= 16;
        }
        next if $symbol eq "";
        my $declaration = $lines[$decl_start];
        my $depth = ($declaration =~ tr/(//) - ($declaration =~ tr/)//);
        my $end = $decl_start;
        while ($depth > 0 && $end < $#lines && $end - $decl_start < 32) {
            $end++;
            $declaration .= "\n" . $lines[$end];
            $depth += ($lines[$end] =~ tr/(//) - ($lines[$end] =~ tr/)//);
        }
        $declaration =~ s/#.*$//mg;
        $declaration =~ s/\s+/ /g;
        $declaration =~ s/^\s+|\s+$//g;
        my $abi_declaration = $declaration;
        $abi_declaration =~ s/^\s*(?:pub\s+)?(?:unsafe\s+)?(?:extern\s+)?fn\s+[A-Za-z_]\w*\s*//;
        $abi_declaration =~ s/([,(]\s*)(?:mut\s+)?[A-Za-z_]\w*\s*:/$1/g;
        $abi_declaration =~ s/\s*([(),<>\[\]?])\s*/$1/g;
        $abi_declaration =~ s/\s*->\s*/->/g;
        my $signature_hash = sha256_hex($abi_declaration);
        my $start = $i > 6 ? $i - 6 : 0;
        my $context = join("\n", @lines[$start .. $i]);
        my $unsafe = ($declaration =~ /\bunsafe\s+(?:extern\s+)?fn\b/ ||
                      $context =~ /\@unsafe[^\n]*(?:ffi|Ffi)/i) ? "tagged" : "missing";
        my $contract = ($context =~ /\@sffi\b/i) ? "sffi_metadata" :
                       ($declaration =~ /->\s*(?:Result\b|Option\b|[^#\n]*\?)/ ||
                        $symbol =~ /(?:^|_)(?:try|checked)(?:_|$)/) ? "typed_result" :
                       ($context =~ /(?:nonnull|nullability|ownership|status[_ -]out|sentinel)/i) ? "documented" :
                       "missing";
        my $evidence = ($context =~ /(?:evidence|receipt|artifact_sha256|abi_hash|signature_verified)/i)
            ? "declared" : "missing";
        my $state = $unsafe eq "tagged"
            ? ($contract eq "missing" ? "unsafe_contract_missing" : "unsafe_contract_declared")
            : ($contract eq "missing" ? "unsafe_tag_and_contract_missing" : "unsafe_tag_missing");
        $file =~ s/^\Q$ENV{SFFI_ROOT}\E\/// if defined $ENV{SFFI_ROOT};
        print join("\t", $symbol, $signature_hash, $file, $decl_start + 1,
                   $unsafe, $contract, $evidence, $state), "\n";
    }
' <"$work/files.bin" >"$work/contracts-unsorted.tsv"
sort -u "$work/contracts-unsorted.tsv" >"$work/contracts.tsv"

awk -F '\t' 'BEGIN { OFS="\t" }
    NR==FNR { if (FNR > 1) backing[$1]=$2; next }
    { print $1, (backing[$1] ? backing[$1] : "unknown"), $2, $3, $4, $5, $6, $7, $8 }
' "$work/backing.tsv" "$work/contracts.tsv" >"$work/joined.tsv"

{
    printf 'symbol\tbacking\tsignature_sha256\tfile\tline\tunsafe_tag\tcontract\tevidence\tstate\n'
    cat "$work/joined.tsv"
} >"$out"

if [ -n "$symbols_out" ]; then
    awk -F '\t' 'BEGIN { OFS="\t" }
        NR > 1 {
            symbol=$1
            if (!(symbol in backing)) backing[symbol]=$2
            declarations[symbol]++
            signature_key=symbol SUBSEP $3
            if (!(signature_key in seen_signature)) {
                seen_signature[signature_key]=1
                signatures[symbol]++
            }
            if ($6 == "missing") unsafe_missing[symbol]++
            if ($7 == "missing") contract_missing[symbol]++
            if ($8 == "missing") evidence_missing[symbol]++
        }
        END {
            print "symbol", "backing", "declarations", "distinct_signatures", \
                  "unsafe_tag_missing", "contract_missing", "evidence_missing", "state"
            for (symbol in declarations) {
                state = signatures[symbol] > 1 ? "signature_conflict" : \
                    (unsafe_missing[symbol] || contract_missing[symbol] ? "migration_required" : \
                    (evidence_missing[symbol] ? "evidence_required" : "declared_complete"))
                print symbol, backing[symbol], declarations[symbol], signatures[symbol], \
                      unsafe_missing[symbol] + 0, contract_missing[symbol] + 0, \
                      evidence_missing[symbol] + 0, state
            }
        }
    ' "$out" | { IFS= read -r header; printf '%s\n' "$header"; sort; } >"$symbols_out"
fi

awk -F '\t' 'NR > 1 { count[$9]++ } END { for (state in count) print count[state], state }' "$out" \
    | sort -nr >&2
