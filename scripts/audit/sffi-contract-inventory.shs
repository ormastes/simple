#!/bin/sh
# Produce the owned Simple extern/SFFI contract ledger.
#
# Columns distinguish runtime backing from boundary safety. A symbol being
# present in a binary is not evidence that its ABI, nullability, ownership, or
# artifact signature has been verified.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
out=${1:-/dev/stdout}
simple_bin=${SIMPLE_BIN:-$root/bin/release/x86_64-unknown-linux-gnu/simple}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

SIMPLE_BIN=$simple_bin sh "$root/scripts/check/extern-backing-census.shs" \
    "$work/backing.tsv" >/dev/null

export SFFI_ROOT=$root
find "$root/src" "$root/test" -type f -name '*.spl' ! -path '*/vendor/*' -print0 >"$work/files.bin"
xargs -0 -r -n 200 perl -0ne '
    my $file = $ARGV;
    my @lines = split /\n/, $_, -1;
    for (my $i = 0; $i <= $#lines; $i++) {
        my $line = $lines[$i];
        next if $line =~ /^\s*#/;
        my $symbol = "";
        if ($line =~ /^\s*(?:pub\s+)?(?:unsafe\s+)?extern\s+fn\s+([A-Za-z_]\w*)/) {
            $symbol = $1;
        } elsif ($line =~ /\@extern(?:\([^\n]*?"([A-Za-z_]\w*)"[^\n]*\)|\s+fn\s+([A-Za-z_]\w*))/) {
            $symbol = defined($1) ? $1 : $2;
        }
        next if $symbol eq "";
        my $start = $i > 6 ? $i - 6 : 0;
        my $context = join("\n", @lines[$start .. $i]);
        my $unsafe = ($line =~ /\bunsafe\s+extern\b/ ||
                      $context =~ /\@unsafe[^\n]*(?:ffi|Ffi)/i) ? "tagged" : "missing";
        my $contract = ($context =~ /\@sffi\b/i) ? "sffi_metadata" :
                       ($line =~ /->\s*(?:Result\b|Option\b|[^#\n]*\?)/ ||
                        $symbol =~ /(?:^|_)(?:try|checked)(?:_|$)/) ? "typed_result" :
                       ($context =~ /(?:nonnull|nullability|ownership|status[_ -]out|sentinel)/i) ? "documented" :
                       "missing";
        my $evidence = ($context =~ /(?:evidence|receipt|artifact_sha256|abi_hash|signature_verified)/i)
            ? "declared" : "missing";
        my $state = $unsafe eq "tagged"
            ? ($contract eq "missing" ? "unsafe_contract_missing" : "unsafe_contract_declared")
            : ($contract eq "missing" ? "unsafe_tag_and_contract_missing" : "unsafe_tag_missing");
        $file =~ s/^\Q$ENV{SFFI_ROOT}\E\/// if defined $ENV{SFFI_ROOT};
        print join("\t", $symbol, $file, $i + 1, $unsafe, $contract, $evidence, $state), "\n";
    }
' <"$work/files.bin" >"$work/contracts-unsorted.tsv"
sort -u "$work/contracts-unsorted.tsv" >"$work/contracts.tsv"

awk -F '\t' 'BEGIN { OFS="\t" }
    NR==FNR { if (FNR > 1) backing[$1]=$2; next }
    { print $1, (backing[$1] ? backing[$1] : "unknown"), $2, $3, $4, $5, $6, $7 }
' "$work/backing.tsv" "$work/contracts.tsv" >"$work/joined.tsv"

{
    printf 'symbol\tbacking\tfile\tline\tunsafe_tag\tcontract\tevidence\tstate\n'
    cat "$work/joined.tsv"
} >"$out"

awk -F '\t' 'NR > 1 { count[$8]++ } END { for (state in count) print count[state], state }' "$out" \
    | sort -nr >&2
