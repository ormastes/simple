#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
source_file="$root/src/compiler_rust/compiler/src/interpreter_extern/net_tls_client.rs"
failed=0

if grep -n -E '_ => (RuntimeValue::NIL|0)|unwrap_or\((0|false)\)' "$source_file"; then
    echo "TLS client SFFI contains a fabricated argument fallback" >&2
    failed=1
fi
if ! grep -q 'struct RuntimeTextArg' "$source_file" ||
   ! grep -q 'rt_string_free' "$source_file"; then
    echo "TLS client SFFI input/output text must have scoped release ownership" >&2
    failed=1
fi
if ! grep -q 'foreign text contract returned null' "$source_file"; then
    echo "TLS client SFFI must reject null positive-length output" >&2
    failed=1
fi

if [ "$failed" -ne 0 ]; then
    exit 1
fi

echo "TLS client SFFI fail-closed audit: PASS"
