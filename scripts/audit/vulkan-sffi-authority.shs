#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/lib/nogc_sync_mut/io/vulkan_sffi.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^@always_inline$' "$module")" -eq 38 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 5 ]
[ "$(grep -c '^@unsafe(reason: "copyable raw Vulkan' "$module")" -eq 33 ]

symbols='rt_vulkan_alloc_buffer rt_vulkan_api_version rt_vulkan_begin_compute rt_vulkan_bind_buffer rt_vulkan_bind_descriptors rt_vulkan_bind_pipeline rt_vulkan_compile_glsl rt_vulkan_compile_spirv rt_vulkan_compile_spirv_array rt_vulkan_copy_buffer rt_vulkan_copy_from_buffer rt_vulkan_copy_to_buffer rt_vulkan_create_compute_pipeline rt_vulkan_create_descriptor_set rt_vulkan_create_framebuffer rt_vulkan_create_graphics_pipeline rt_vulkan_create_image rt_vulkan_create_render_pass rt_vulkan_create_sampler rt_vulkan_create_swapchain rt_vulkan_destroy_descriptor_set rt_vulkan_destroy_pipeline rt_vulkan_destroy_shader rt_vulkan_device_count rt_vulkan_device_memory rt_vulkan_device_name rt_vulkan_device_type rt_vulkan_dispatch rt_vulkan_end_compute rt_vulkan_free_buffer rt_vulkan_get_device rt_vulkan_get_last_error rt_vulkan_init rt_vulkan_is_available rt_vulkan_push_constants rt_vulkan_select_device rt_vulkan_shutdown rt_vulkan_submit_and_wait rt_vulkan_wait_idle'
both=0
one=0
none=0
for symbol in $symbols; do
    providers=0
    grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry" && providers=$((providers + 1))
    grep -q "insert_simple!(\"$symbol\"" "$interpreter" && providers=$((providers + 1))
    case "$providers" in
        2) both=$((both + 1)) ;;
        1) one=$((one + 1)) ;;
        0) none=$((none + 1)) ;;
    esac
done
[ "$both" -eq 21 ]
[ "$one" -eq 10 ]
[ "$none" -eq 8 ]

grep -q '^fn vulkan_available() -> bool:' "$module"
grep -q '^fn vulkan_init() -> bool:' "$module"
grep -q '^fn vulkan_wait_idle() -> bool:' "$module"

echo "Vulkan SFFI authority audit: PASS (40 calls/39 symbols; 33 unsafe handle/order facades + 5 lexical global owners; 21 both/10 one/8 no-provider; mandatory-inline)"
