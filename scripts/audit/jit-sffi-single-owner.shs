#!/bin/sh
set -eu

compat=src/app/io/jit_ffi.spl
owner=src/app/io/jit_sffi.spl

test "$(wc -l < "$compat")" -le 10
rg -q '^export use app\.io\.jit_sffi\.\*$' "$compat"
test "$(rg '^extern fn rt_(file_read_text|dir_create)' "$compat" | wc -l)" -eq 0
test "$(rg '^extern fn rt_(file_read_text|dir_create)' "$owner" | wc -l)" -eq 0
rg -q '^use std\.io_runtime\.\{file_write, read_file_text_result, file_exists, file_delete\}' "$owner"
rg -q '^use std\.nogc_sync_mut\.io\.dir_ops\.\{dir_create\}' "$owner"
