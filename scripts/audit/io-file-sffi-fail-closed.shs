#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
bridge="$root/src/compiler_rust/compiler/src/interpreter_extern/io_file.rs"
aspect_io="$root/src/compiler/99.loader/aspect_pack_io.spl"
failed=0

if grep -n -E 'and_then\(Value::try_array_bytes\)\.unwrap_or_default\(\)|fn extract_(fd|i64).*-> i64' "$bridge"; then
    echo "file-I/O SFFI contains a fabricated argument fallback" >&2
    failed=1
fi

for file in \
    "$root/src/compiler/99.loader/aspect_pack_io.spl" \
    "$root/src/lib/nogc_sync_mut/io/file.spl"
do
    if ! awk '
        /^[[:space:]]*extern fn rt_io_file_/ {
            if (previous !~ /@unsafe\(/ || previous !~ /capabilities:[[:space:]]*\[[^]]*ffi/) {
                printf "%s:%d:%s\n", FILENAME, FNR, $0
                failed = 1
            }
        }
        { previous = $0 }
        END { exit failed }
    ' "$file"; then
        echo "raw file-I/O declarations must carry explicit ffi unsafe metadata" >&2
        failed=1
    fi
done

if ! awk '
    function indent(line, copy) {
        copy = line
        sub(/[^ ].*$/, "", copy)
        return length(copy)
    }
    /unsafe\(capabilities: \[.*ffi.*\]\):[[:space:]]*$/ {
        unsafe_indent = indent($0)
        inside_unsafe = 1
        next
    }
    inside_unsafe && NF && indent($0) <= unsafe_indent { inside_unsafe = 0 }
    /(rt_io_file_|rt_mmap_raw\(|rt_munmap_raw\(|rt_ptr_read_u8\(|rt_file_size\()/ &&
        !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / && !inside_unsafe {
        print "unscoped aspect-pack I/O call at line " FNR ": " $0 > "/dev/stderr"
        failed = 1
    }
    END { if (failed) exit 1 }
' "$aspect_io"; then
    failed=1
fi

if [ "$(grep -c '^extern fn ' "$aspect_io")" -ne 8 ] ||
   [ "$(grep -c '^@unsafe(.*capabilities: \[.*ffi' "$aspect_io")" -ne 8 ]; then
    echo "all aspect-pack I/O declarations must retain explicit FFI authority" >&2
    failed=1
fi
if grep -Eq '(want_offset|offset) \+ (want_length|length) > fsize' "$aspect_io" ||
   ! grep -q 'want_offset > fsize - want_length' "$aspect_io" ||
   ! grep -q 'offset > fsize - length' "$aspect_io"; then
    echo "aspect-pack EOF validation must remain overflow-safe" >&2
    failed=1
fi

if [ "$failed" -ne 0 ]; then
    exit 1
fi

echo "file-I/O SFFI fail-closed audit: PASS"
