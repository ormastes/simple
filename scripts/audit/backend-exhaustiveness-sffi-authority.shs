#!/bin/sh
# Static lexical-boundary guard for backend exhaustiveness validation.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/70.backend/backend/exhaustiveness_validator.spl"

test "$(grep -c '^@unsafe(reason: "raw backend-validator source-text ABI; result model lacks I/O error state", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^extern fn rt_file_read_text(path: text) -> text$' "$module")" -eq 1
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_file_read_text(path)' "$module")" -eq 1

echo 'Backend exhaustiveness validator SFFI authority: PASS declarations=1 lexical_calls=1 direct_call_shape=preserved artifact_admission=absent'
