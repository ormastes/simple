#!/bin/sh
# The no-GC serial wrapper is the only raw serial owner.  The former app and
# dedicated-hardware copies disagreed with the runtime ABI and exposed
# providerless configuration/availability calls.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/io/serial_sffi.spl"
dedicated="$root/src/lib/nogc_sync_mut/baremetal/transport/dedicated_hw.spl"

test "$(grep -c '^extern fn rt_serial_' "$owner")" -eq 7
test "$(grep -c '^@unsafe(reason: "raw serial' "$owner")" -eq 7
! grep -Eq '^extern fn rt_serial_' "$dedicated"
! grep -Eq 'rt_serial_available' "$dedicated"
test ! -e "$root/src/app/io/serial_ffi.spl"
grep -q 'serial availability is not part of the admitted serial SFFI contract' "$dedicated"

echo 'serial SFFI owner authority: PASS (one raw owner; providerless serial controls absent; provider remains unsafe/unsigned/unverified)'
