#!/bin/sh
set -eu

module=src/compiler/70.backend/linker/msvc.spl

if rg -q '^extern fn rt_' "$module"; then
    echo "MSVC linker must use canonical runtime facades, not own raw SFFI" >&2
    exit 1
fi

rg -q '^use std\.io_runtime\.\{process_run, file_exists, env_get_opt\}$' "$module"
test "$(rg -c 'process_run\("cmd", \["/C", cmd\]\)' "$module")" -eq 1
test "$(rg -c 'env_get_opt\("ProgramFiles\(x86\)"\)' "$module")" -eq 1
test "$(rg -c 'file_exists\(' "$module")" -eq 7
rg -q 'if vswhere == "":' "$module"
if rg -q 'vswhere_paths' "$module"; then
    echo "MSVC discovery must not allocate a temporary candidate-path array" >&2
    exit 1
fi
if rg -q 'rt_(process_run|file_exists|env_get)\(' "$module"; then
    echo "raw runtime call escaped canonical MSVC linker facades" >&2
    exit 1
fi
