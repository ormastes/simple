#!/bin/sh
set -eu

module=src/compiler/50.mir/mir_data.spl

if rg -q '^extern fn rt_env_get\(' "$module"; then
    echo "MIR data must not redeclare raw environment authority" >&2
    exit 1
fi
rg -q '^use std\.io_runtime\.\{env_get_opt\}$' "$module"
test "$(rg -c 'env_get_opt\(' "$module")" -eq 8
if rg -q 'unsafe\(capabilities: \[ffi\]\):' "$module"; then
    echo "MIR data must not retain module-local raw FFI scopes" >&2
    exit 1
fi
test "$(rg -c '_mir_trace_scope_slot' "$module")" -ge 8
