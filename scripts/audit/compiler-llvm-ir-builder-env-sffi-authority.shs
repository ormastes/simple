#!/bin/sh
set -eu

module=src/compiler/70.backend/backend/llvm_ir_builder.spl
facade=src/lib/nogc_sync_mut/io_runtime.spl

if rg -q '^extern fn rt_env_get' "$module"; then
    echo "LLVM IR builder target policy must use the canonical environment facade" >&2
    exit 1
fi

rg -q '^use std\.io_runtime\.\{env_get_opt\}$' "$module"
test "$(rg -c 'env_get_opt\("SIMPLE_NATIVE_BUILD_TARGET"\)' "$module")" -eq 2
test "$(rg -c '^extern fn rt_string_builder_' "$module")" -eq 4
test "$(rg -c '@unsafe\(reason: "raw opaque builder' "$module")" -eq 4
rg -Uq '@always_inline\npub fn env_get_opt\(key: text\) -> text\?:' "$facade"
