#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for suffix in enum_discriminant; do
    raw="rt_$suffix"
    owner="_sffi_$suffix"
    [ "$(grep -Ec "^extern fn ${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^fn ${owner}\\(" "$module")" -eq 1 ]
    grep -q "RuntimeFuncSpec::new(\"$raw\"" "$registry"
    grep -q "insert_simple!(\"$raw\"" "$interpreter"
done

! grep -q '^extern fn rt_env_get' "$module"
grep -q '^use std.io_runtime.{env_get_opt}$' "$module"
grep -q '^[[:space:]]+env_get_opt(key)$' "$module"
! grep -q '^extern fn rt_string_data' "$module"
! grep -q '^extern fn rt_string_len' "$module"
[ "$(grep -c '^@unsafe(' "$module")" -eq 1 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 2 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 1 ]
[ "$(grep -o '_sffi_env_get(' "$module" | wc -l)" -eq 6 ]
[ "$(grep -o '_sffi_enum_discriminant(' "$module" | wc -l)" -eq 17 ]

# Enum probes occur in call/operator lowering. Mandatory inlining preserves
# their exact one-for-one call shape without a second classification pass.
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "MIR switch/operator SFFI authority audit: PASS (enum ABI confined; canonical nullable env; lowering probe counts unchanged)"
