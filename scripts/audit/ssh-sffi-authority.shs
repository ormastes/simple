#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/lib/nogc_sync_mut/io/ssh_sffi.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

raw_count=$(grep -Ec '^extern fn rt_(ssh|sftp)_' "$module")
wrapper_count=$(grep -Ec '^fn (ssh|sftp)_' "$module")
[ "$raw_count" -eq 23 ]
[ "$wrapper_count" -eq 23 ]
[ "$(grep -c '^@unsafe(reason:' "$module")" -eq 46 ]

calls=$(perl -0ne '
    s/""".*?"""//sg; s/#.*//mg; s/^\s*extern fn .*\n//mg;
    while (/\brt_(?:ssh|sftp)_[A-Za-z0-9_]*\s*\(/g) { $n++ }
    END { print $n + 0 }
' "$module")
[ "$calls" -eq 23 ]

symbols=$(sed -n 's/^extern fn \(rt_\(ssh\|sftp\)_[A-Za-z0-9_]*\).*/\1/p' "$module")
for symbol in $symbols; do
    ! grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry"
    ! grep -q "insert_simple!(\"$symbol\"" "$interpreter"
done

# Unsafe exposure only: preserve existing values and avoid adding runtime work.
grep -q 'return SshExecResult(exit_code: -1, stdout: "", stderr: "Invalid session")' "$module"
grep -q 'return SftpFileInfo(size: 0, mode: 0, mtime: 0)' "$module"
grep -q 'return 0' "$module"
! grep -q '^@always_inline$' "$module"
! grep -q 'unsafe(capabilities:' "$module"

echo "SSH/SFTP SFFI authority audit: PASS (23 raw declarations/23 exact wrappers unsafe; 0/23 providers registered; legacy bool/text/tuple/sentinel behavior unchanged; no wrapper/branch/allocation/dispatch added)"
