#!/bin/sh
set -eu

inventory=scripts/audit/sffi-contract-inventory.shs
census=scripts/audit/rt-safety-census.shs
contract=scripts/audit/rt-safety-census-contract.shs
ratchet=scripts/audit/rt-safety-ratchet.shs
baseline=scripts/audit/baselines/rt-safety-census-v1.tsv

rg -q 'provider_id\\tsource_signature_sha256' "$inventory"
rg -q 'scoped_callsite_estimate\\tbacking_first_declaring_file' "$inventory"
rg -q 'admitted\[\$1 SUBSEP \$2 SUBSEP \$3\]' "$inventory"
rg -q 'admitted\[\$1 SUBSEP \$3 SUBSEP \$2\]' "$inventory"
rg -q '\$2 != "missing"' "$inventory"
rg -q 'count == 1 && value != ""' "$inventory"
rg -q 'signed_admitted_declarations' "$inventory"
rg -q 'admitted\[symbol\] < declarations\[symbol\]' "$inventory"
rg -q 'all_declarations_admitted' "$inventory"
rg -q 'partially_admitted' "$inventory"
rg -q 'backing_languages' "$inventory"
rg -q 'SFFI scope stats: scope=%s' "$inventory"
rg -q 'SFFI rt_scope stats: scope=%s' "$inventory"
rg -q 'SFFI raw_scope stats: scope=%s' "$inventory"
rg -q 'SFFI language stats: language=%s' "$inventory"
rg -q 'SFFI rt_language stats: language=%s' "$inventory"
rg -q 'all_declarations_unsafe_tagged' "$inventory"
rg -q 'unsafe_tag_incomplete' "$inventory"
rg -q '\\bcontract\\s\*:' "$inventory"
rg -q '\$1 ~ /\^\(rt_\|spl_\)/' "$inventory"
rg -q '\$6 ~ /\^test\\\//' "$inventory"
rg -q 'source_languages' scripts/check/extern-backing-census.shs
rg -q 'find src/runtime src/os -name' scripts/check/extern-backing-census.shs

rg -q 'provider_id.*source_signature_sha256' "$census"
rg -q 'admitted\[\$1 SUBSEP \$2 SUBSEP \$3\]' "$census"
rg -q 'admitted\[\$1 SUBSEP \$5 SUBSEP \$4\]' "$census"
rg -q 'count == 1 && value != ""' "$census"
rg -q 'unsafe_minimization_status", "not_measured"' "$census"
rg -q 'provider_declared_rows' "$census"
rg -q 'provider_missing_rows' "$census"
rg -q 'provider_identity_variant_symbols' "$census"
rg -q 'scoped_callsite_estimate' "$census"
rg -q 'distinct_symbols_with_scoped_callsites' "$census"
! rg -q 'unsafe_minimized_rows|unsafe_unminimized_rows' "$census"

rg -q 'unsafe_contract_declared_rows' "$contract"
rg -q 'unsafe_minimization_status' "$contract"
rg -q 'provider_declared + provider_missing' "$contract"
rg -q 'check_min unsafe_contract_declared_rows min_unsafe_contract_declared_rows' "$ratchet"
rg -q '^min_unsafe_contract_declared_rows[[:space:]]' "$baseline"

echo "SFFI census admission audit: PASS (provider-scoped join; minimization not fabricated from annotations)"
