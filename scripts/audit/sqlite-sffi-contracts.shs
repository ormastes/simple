#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
native="$root/src/runtime/runtime_sqlite.c"
files="
$root/src/lib/nogc_sync_mut/io/sqlite_sffi.spl
"
facades="
$root/src/app/io/sqlite_sffi.spl
$root/src/app/io/sqlite_ffi.spl
"

for file in $files; do
    declarations=$(grep -c '^[[:space:]]*extern fn rt_sqlite_' "$file")
    if [ "$declarations" -ne 27 ]; then
        echo "SQLite SFFI inventory changed without contract review: $file" >&2
        exit 1
    fi
    tagged=$(awk '
        /^@unsafe\(.*capabilities: \[ffi\]\)$/ { previous_is_ffi = 1; next }
        /^[[:space:]]*extern fn rt_sqlite_/ {
            if (previous_is_ffi) tagged++
        }
        { previous_is_ffi = 0 }
        END { print tagged + 0 }
    ' "$file")
    if [ "$tagged" -ne "$declarations" ]; then
        echo "every SQLite declaration must be explicitly unsafe(ffi): $file" >&2
        exit 1
    fi
done

for facade in $facades; do
    grep -q '^export use std.nogc_sync_mut.io.sqlite_sffi.{' "$facade"
    ! grep -q '^extern fn ' "$facade"
    ! grep -q '\brt_sqlite_[A-Za-z0-9_]*(' "$facade"
    ! grep -q '^fn ' "$facade"
done

if [ "$(grep -c '^static inline int is_heap_handle' "$native")" -ne 1 ]; then
    echo "native SQLite boundary must validate tagged heap handles" >&2
    exit 1
fi
if grep -q 'if (is_nil(\(handle\|conn\|stmt_val\))' "$native"; then
    echo "native SQLite operations must reject non-heap scalar handles" >&2
    exit 1
fi
if grep -q 'rt_sqlite_execute(conn, make_string' "$native"; then
    echo "SQLite transaction control must not allocate temporary runtime strings" >&2
    exit 1
fi
grep -q 'if (!is_heap_handle(handle)) return from_int(0);' "$native" || {
    echo "closing an invalid SQLite handle must not fabricate success" >&2
    exit 1
}

# These ambiguous legacy contracts must remain named until status/out v2
# replaces them in C, Rust-interpreter, and Simple together.
grep -q 'zero conflates done and failure' \
    "$root/src/lib/nogc_sync_mut/io/sqlite_sffi.spl" || {
    echo "SQLite step ambiguity must remain explicit" >&2
    exit 1
}
grep -q 'nullable runtime-owned text return' \
    "$root/src/lib/nogc_sync_mut/io/sqlite_sffi.spl" || {
    echo "SQLite nullable text contract must remain explicit" >&2
    exit 1
}

echo "SQLite SFFI contract audit: PASS"
