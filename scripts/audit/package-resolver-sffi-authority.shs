#!/bin/sh
set -eu

module=src/app/pkg/resolver.spl

test "$(rg '^extern fn rt_file_read_text' "$module" | wc -l)" -eq 0
test "$(rg 'rt_file_read_text\(' "$module" | wc -l)" -eq 0
rg -q '^fn _dependency_manifest_version.*Result<text, text>:' "$module"
test "$(rg -c '_dependency_manifest_version\(dep_manifest_path\)' "$module")" -eq 2

helper="$(sed -n '/^fn _dependency_manifest_version/,/^# Clone or fetch/p' "$module")"
test "$(printf '%s\n' "$helper" | rg 'file_exists\(' | wc -l)" -eq 1
test "$(printf '%s\n' "$helper" | rg 'read_file_text_result\(' | wc -l)" -eq 1
rg -q 'Dependency manifest is empty' "$module"
