#!/bin/sh
set -eu

module=src/compiler/50.mir/mir_lowering_stmts.spl

if rg -q '^extern fn rt_(dict_contains|env_get)\(' "$module"; then
    echo "MIR statement lowering must not retain duplicate dictionary/environment authority" >&2
    exit 1
fi
test "$(rg -c '^extern fn rt_enum_(discriminant|payload)\(' "$module")" -eq 2
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 2
test "$(rg -c '^[[:space:]]+rt_enum_discriminant\(' "$module")" -eq 1
test "$(rg -c '^[[:space:]]+rt_enum_payload\(' "$module")" -eq 1
rg -q '^extern fn rt_enum_payload\(value: HirStmtKind\) -> HirExpr\?$' "$module"
test "$(rg -c '_sffi_hir_stmt_discriminant\(' "$module")" -eq 3
test "$(rg -c '_sffi_hir_stmt_payload\(' "$module")" -eq 2
test "$(rg -c 'env_get_opt\(' "$module")" -eq 2
rg -q 'if expr == nil:' "$module"
