#!/bin/sh
# Report owned C++ rt_*/spl_* ABI definitions and exception-boundary state.
# Source inspection is migration evidence only: it never claims artifact,
# signature, ABI, nullability, ownership, or semantic verification.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
out=${1:-/dev/stdout}

SFFI_CPP_ROOT=$root SFFI_CPP_OUT=$out python3 - <<'PY'
import os
import pathlib
import re

root = pathlib.Path(os.environ["SFFI_CPP_ROOT"])
out = os.environ["SFFI_CPP_OUT"]
definition = re.compile(
    r"(?m)^\s*([^\n;{}]*?)\b((?:rt|spl)_[A-Za-z0-9_]+)\s*"
    r"\(([^;{}]*)\)\s*(noexcept)?\s*\{"
)
pointer_param = re.compile(r"(?:^|,)\s*[^,]*\*\s*([A-Za-z_]\w*)\s*(?:,|$)")

rows = []
for path in sorted((root / "src" / "runtime").rglob("*")):
    if path.suffix not in {".cc", ".cpp", ".cxx"} or "vendor" in path.parts:
        continue
    source = path.read_text(encoding="utf-8", errors="strict")
    for match in definition.finditer(source):
        depth = 1
        cursor = match.end()
        while cursor < len(source) and depth:
            if source[cursor] == "{":
                depth += 1
            elif source[cursor] == "}":
                depth -= 1
            cursor += 1
        body = source[match.end():cursor - 1] if depth == 0 else ""
        params = match.group(3)
        names = pointer_param.findall(params + ",")
        guarded = 0
        for name in names:
            escaped = re.escape(name)
            if re.search(rf"\bif\s*\(\s*!\s*{escaped}\b", body) or re.search(
                rf"\bif\s*\(\s*{escaped}\s*==\s*nullptr\b", body
            ):
                guarded += 1
        has_catch = bool(re.search(r"\bcatch\s*\(", body))
        barrier = "noexcept" if match.group(4) else "catch" if has_catch else "missing"
        rel = path.relative_to(root).as_posix()
        line = source.count("\n", 0, match.start()) + 1
        returns_pointer = "true" if "*" in match.group(1) else "false"
        rows.append((match.group(2), rel, line, returns_pointer, len(names), guarded, barrier,
                     "source_only_unverified"))

with open(out, "w", encoding="utf-8", newline="\n") if out != "/dev/stdout" else os.fdopen(
    os.dup(1), "w", encoding="utf-8", newline="\n"
) as stream:
    stream.write("symbol\tfile\tline\treturns_pointer\tpointer_params\tnull_guarded_pointer_params\texception_barrier\tevidence_state\n")
    for row in rows:
        stream.write("\t".join(map(str, row)) + "\n")

missing = sum(row[6] == "missing" for row in rows)
pointer_rows = sum(row[3] == "true" or row[4] for row in rows)
print(f"cpp_sffi_definitions\t{len(rows)}")
print(f"cpp_sffi_missing_exception_barrier\t{missing}")
print(f"cpp_sffi_pointer_boundary_rows\t{pointer_rows}")
print("cpp_sffi_verified_and_signed\t0")
PY
