#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
canonical="$root/src/lib/nogc_sync_mut/sffi/debug.spl"
facade="$root/src/lib/nogc_sync_mut/ffi/debug.spl"

if [ "$(grep -c '^[[:space:]]*extern fn rt_' "$canonical")" -ne 43 ]; then
    echo "canonical debug declaration inventory changed without contract review" >&2
    exit 1
fi
tagged=$(awk '
    /^@unsafe\(.*capabilities: \[ffi\]\)$/ { previous_is_ffi = 1; next }
    /^[[:space:]]*extern fn rt_/ {
        if (previous_is_ffi) tagged++
    }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$canonical")
if [ "$tagged" -ne 43 ]; then
    echo "every canonical debug declaration must be explicitly unsafe(ffi)" >&2
    exit 1
fi
if grep -n -E 'extern fn rt_|^[[:space:]]*fn ' "$facade"; then
    echo "debug FFI compatibility facade duplicates providers or wrappers" >&2
    exit 1
fi
if ! grep -q '^export use std\.nogc_sync_mut\.sffi\.debug\.\*$' "$facade"; then
    echo "debug FFI compatibility facade must re-export the canonical owner" >&2
    exit 1
fi

echo "debug SFFI owner audit: PASS"
