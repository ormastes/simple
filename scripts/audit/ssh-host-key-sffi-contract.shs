#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/apps/sshd/host_key_loader.spl"

externs=$(grep -c '^extern fn ' "$module")
scopes=$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")
if [ "$externs" -ne 2 ] || [ "$scopes" -ne 2 ]; then
    echo "SSH host-key foreign-boundary inventory changed" >&2
    exit 1
fi

grep -q 'extern fn rt_file_read_bytes(path: text) -> \[u8\]?' "$module"
grep -q 'extern fn rt_bytes_to_text(data: \[u8\]) -> text?' "$module"
grep -q 'nil: return Err("failed to read host key file:' "$module"
grep -q 'failed to decode non-empty bytes' "$module"

if grep -E 'rt_(file_read_bytes|bytes_to_text)\(' "$module" |
    grep -v '^extern fn ' | grep -v '^        rt_' | grep -v '^$' >/dev/null; then
    echo "SSH host-key raw call escaped its minimal wrapper scope" >&2
    exit 1
fi

echo "SSH host-key SFFI contract audit: PASS (nullable read and text-lift failures remain typed)"
