#!/bin/sh
# Static authority guard for the SSH AES-256-GCM tagged v2 carrier.
# Security-adjacent: proves the Simple boundary calls only the tagged v2
# provider, that the legacy untagged entry points stay retired across the
# interpreter and its dispatch table, and that the native provider still
# reports authentication failure rather than silently returning plaintext.
set -u

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
simple="$root/src/os/apps/sshd/ssh_cipher_live.spl"
native="$root/src/compiler_rust/runtime/src/value/aes.rs"
interp="$root/src/compiler_rust/compiler/src/interpreter_extern/simd.rs"
dispatch="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"
codegen="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
symbols="$root/src/compiler_rust/common/src/runtime_symbols.rs"

# --- verdict discipline (.claude/rules/vcs.md): verdict LAST on stdout,
# --- PASS/FAIL/ERROR, exits 0/1/2, non-vacuity absolute. Inlined rather than
# --- sourced: scripts/audit/ is scanned by check-guard-wiring.shs, so a shared
# --- non-guard file in this directory would be mistaken for an unwired guard.
CHECKED=0
FAILURES=""

need_file() {
    if [ ! -f "$1" ]; then
        echo "ERROR — nothing was checked (missing audited file: $1)"
        exit 2
    fi
}

# count <label> <file> <pattern> <expected>
count() {
    _got=$(grep -c "$3" "$2" 2>/dev/null || true)
    [ -n "$_got" ] || _got=0
    CHECKED=$((CHECKED + 1))
    if [ "$_got" -ne "$4" ]; then
        FAILURES="${FAILURES}${FAILURES:+; }$1 in $2: expected $4, got $_got"
    fi
}

# present: at least one match (shape must exist; multiplicity is not pinned).
present() {
    _got=$(grep -c "$3" "$2" 2>/dev/null || true)
    [ -n "$_got" ] || _got=0
    CHECKED=$((CHECKED + 1))
    if [ "$_got" -lt 1 ]; then
        FAILURES="${FAILURES}${FAILURES:+; }$1 in $2: expected at least 1, got $_got"
    fi
}

absent()  { count "$1" "$2" "$3" 0; }

verdict() {
    if [ "$CHECKED" -eq 0 ]; then
        echo "ERROR — nothing was checked ($1: zero assertions evaluated)"
        exit 2
    fi
    if [ -n "$FAILURES" ]; then
        echo "FAIL — $1: $FAILURES"
        exit 1
    fi
    echo "PASS — $CHECKED assertion(s) checked, $1"
    exit 0
}

for f in "$simple" "$native" "$interp" "$dispatch" "$codegen" "$symbols"; do
    need_file "$f"
done

# --- Simple boundary: tagged v2 only, response lifted immediately.
present 'unsafe-annotated v2 provider declaration' "$simple" \
    '^@unsafe(reason: "raw SSH AES-256-GCM packet provider; tagged v2 response is lifted immediately", capabilities: \[ffi\])$'
present 'v2 extern declaration' "$simple" \
    '^extern fn rt_ssh_aes256_gcm_decrypt_packet_v2'
present 'tagged response is lifted (status byte popped)' "$simple" \
    'raw.pop()'
absent 'retired legacy untagged provider call' "$simple" \
    'rt_ssh_aes256_gcm_decrypt_packet('
present 'bounded wire-frame admission before crypto dispatch' "$simple" \
    '_validate_gcm_wire_packet'

# --- Native provider: authenticates, and tags its reply.
present 'native v2 provider' "$native" \
    '^pub unsafe extern "C" fn rt_ssh_aes256_gcm_decrypt_packet_v2'
present 'authentication failure is a distinct outcome' "$native" \
    'SshAesGcmDecryptOutcome::AuthenticationFailed'
present 'success status byte tagged onto the payload' "$native" \
    '^[[:space:]]*payload.push(0x02);$'
present 'tagged payload returned as a runtime array' "$native" \
    '^[[:space:]]*runtime_array_from_bytes(&payload)$'

# --- Interpreter: v2 present, both legacy entry points retired.
present 'interpreter v2 implementation' "$interp" \
    'pub fn rt_ssh_aes256_gcm_decrypt_packet_v2'
absent 'retired legacy interpreter implementation' "$interp" \
    'pub fn rt_ssh_aes256_gcm_decrypt_packet(args'
absent 'retired legacy payload-len interpreter implementation' "$interp" \
    'pub fn rt_ssh_aes256_gcm_decrypt_packet_payload_len(args'
present 'v2 registered in the interpreter dispatch table' "$dispatch" \
    '"rt_ssh_aes256_gcm_decrypt_packet_v2"'
absent 'retired legacy dispatch entry' "$dispatch" \
    '"rt_ssh_aes256_gcm_decrypt_packet",'
absent 'retired legacy payload-len dispatch entry' "$dispatch" \
    '"rt_ssh_aes256_gcm_decrypt_packet_payload_len",'

# --- Codegen + symbol table agree on the v2 ABI.
present 'v2 codegen signature' "$codegen" \
    'RuntimeFuncSpec::new("rt_ssh_aes256_gcm_decrypt_packet_v2", &\[I64, I64, I64, I64\], &\[I64\])'
present 'v2 exported in the runtime symbol table' "$symbols" \
    '"rt_ssh_aes256_gcm_decrypt_packet_v2"'

verdict 'SSH GCM SFFI v2 authority (tagged one-pass carrier; legacy interpreter dispatch removed)'
