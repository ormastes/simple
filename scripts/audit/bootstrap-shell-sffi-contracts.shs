#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/compiler_rust/lib/std/src/shell.spl"

declarations=$(grep -c '^[[:space:]]*extern fn ' "$owner")
if [ "$declarations" -ne 25 ]; then
    echo "bootstrap shell extern inventory changed without contract review" >&2
    exit 1
fi
tagged=$(awk '
    /^@unsafe\(.*capabilities: \[[^]]*ffi[^]]*\]\)$/ { previous_is_ffi = 1; next }
    /^[[:space:]]*extern fn / {
        if (previous_is_ffi) tagged++
    }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$owner")
if [ "$tagged" -ne "$declarations" ]; then
    echo "every bootstrap shell extern must be explicitly unsafe(ffi)" >&2
    exit 1
fi
grep -q '^extern fn rt_env_get(name: text) -> text?$' "$owner" || {
    echo "environment lookup must preserve missing versus empty" >&2
    exit 1
}
grep -A3 'static fn get(name: text, default_value: text = "")' "$owner" \
    | grep -q 'result ?? default_value' || {
    echo "environment default must apply only to absence" >&2
    exit 1
}

echo "bootstrap shell SFFI contract audit: PASS"
