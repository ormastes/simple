#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/runtime/simple_core/core_bdd.spl"
provider="$root/src/runtime/simple_core/core_string.spl"
cranelift="$root/src/compiler_rust/compiler/src/codegen/instr/calls.rs"
llvm="$root/src/compiler_rust/compiler/src/codegen/llvm/functions/calls.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in spl_load_i64 rt_stdout_write rt_println_value rt_raw_i64_to_string; do
    [ "$(grep -Ec "^extern fn ${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -Ec "^[[:space:]]+${raw}\\(" "$module")" -eq 1 ]
done

[ "$(grep -c '^@unsafe(' "$module")" -eq 4 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 4 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi, raw_ptr\]):' "$module")" -eq 1 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 3 ]
for expected in _sffi_load_i64:3 _sffi_stdout_write:9 \
    _sffi_println_value:2 _sffi_raw_i64_to_string:3; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done

for helper in rt_stdout_write rt_println_value rt_raw_i64_to_string; do
    grep -Eq "^pub fn ${helper}\\(" "$provider"
done
grep -q '"spl_load_i64"' "$cranelift"
grep -q '"spl_load_i64"' "$llvm"
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "simple-core BDD authority audit: PASS (all raw calls confined; boolean state and truthiness work unchanged)"
