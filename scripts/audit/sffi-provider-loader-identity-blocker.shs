#!/bin/sh
# Diagnostic-only guard for the unresolved immutable-image provider admission
# requirement. This never emits an admission verdict.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
loader="$root/src/os/smf/provider_loader.spl"
dynlib="$root/src/os/posix/dynlib.spl"

body() {
    name=$1
    sed -n "/^fn $name(/,/^fn /p" "$loader"
}

admission=$(body provider_admit_dynamic_v1)
printf '%s\n' "$admission" | grep -Fq 'provider_artifact_digest_v1(bytes)'
printf '%s\n' "$admission" | grep -Fq 'dynlib_open(request.artifact_path, 2)'

# The existing facade is path-only. A same-handle hash/load operation would be
# required before this diagnostic can become a security/admission gate.
if grep -Eq 'dynlib_open_(fd|handle)|dynlib_hash_open_|dynlib_open_verified_' "$dynlib"; then
    echo 'FAIL: immutable-handle primitive appeared; replace this diagnostic with an exact admission test' >&2
    exit 1
fi

# Session functions must not redo loader admission work. This is source-shape
# evidence only; the separate dynamic ABI marshaller remains outside this
# check and may allocate for its request/result buffers.
for name in provider_session_query_v1 provider_session_invoke_cli_v1; do
    if body "$name" | grep -Eq 'rt_file_|sha256|provider_artifact_digest|dynlib_open|dynlib_symbol|provider_admit_dynamic|sffi-evidence|sffi-contract-inventory'; then
        echo "FAIL: $name contains loader admission work" >&2
        exit 1
    fi
done

echo 'BLOCKED: provider admission is pathname-based; immutable opened-handle hash/load and close-ownership semantics are required before security promotion. Cached session source has no repeated loader-admission operation.'
