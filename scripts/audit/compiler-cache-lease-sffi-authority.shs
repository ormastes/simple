#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/80.driver/cache/lease/lease.spl"

test "$(grep -c '^extern fn rt_' "$module")" -eq 8
tagged=$(awk '/^@unsafe\(.*capabilities: \[ffi\]\)$/ { tagged=1; next }
    /^extern fn rt_/ { if (tagged) count++ }
    { tagged=0 }
    END { print count + 0 }' "$module")
test "$tagged" -eq 8
test "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 8
test "$(grep -Ec '^        rt_' "$module")" -eq 8
! grep -q 'file_read_nullable(.*) ?? ""' "$module"
grep -q 'E-SFFI-CACHE-LEASE-READ' "$module"

echo 'cache lease SFFI authority: PASS (eight inlined raw owners; unreadable leases retained)'
