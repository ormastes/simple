#!/bin/sh
set -eu

module=src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl

if rg -q '^extern fn rt_(dict_contains|env_get)\(' "$module"; then
    echo "MIR method lowering must not retain dead dictionary or duplicate environment authority" >&2
    exit 1
fi
test "$(rg -c '^extern fn rt_enum_discriminant\(' "$module")" -eq 1
test "$(rg -c '^[[:space:]]+rt_enum_discriminant\(' "$module")" -eq 1
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 1
test "$(rg -c '_sffi_method_hir_type_discriminant\(' "$module")" -eq 3
test "$(rg -c 'env_get_opt\(' "$module")" -eq 2
test "$(rg -c 'mir_dict_elem_trace_on\(' "$module")" -eq 4
test "$(rg -c 'mir_conv_log_on\(' "$module")" -eq 6
test "$(rg -c '^var mir_(dict_elem_trace|conv_log)_state: i64 = -1$' "$module")" -eq 2
