#!/bin/sh
# Keep the active OpenGL raw ABI in one no-GC owner and make every foreign
# crossing explicit.  This source guard intentionally proves containment, not
# provider signature, ABI, nullability, or ownership verification.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/io/opengl_sffi.spl"

raw_count=$(grep -c '^extern fn rt_opengl_' "$owner")
unsafe_count=$(grep -B1 '^extern fn rt_opengl_' "$owner" | grep -c '@unsafe')
test "$raw_count" -eq 19
test "$unsafe_count" -eq "$raw_count"
test "$(rg -l '^extern fn rt_opengl_' "$root/src/lib" "$root/src/app" --glob '*.spl' | wc -l)" -eq 1

echo 'OpenGL SFFI owner authority: PASS (19 tagged raw declarations; one owner)'
