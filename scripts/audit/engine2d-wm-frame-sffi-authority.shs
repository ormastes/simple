#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/compositor/engine2d_wm_frame_executor.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^@unsafe(reason: "foreign serial output' "$module")" -eq 1 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 1 ]
[ "$(grep -c '^fn _engine2d_wm_log(msg: text):' "$module")" -eq 1 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 1 ]
[ "$(grep -c '_engine2d_wm_log(' "$module")" -eq 38 ]
[ "$(grep -c 'serial_println(' "$module")" -eq 2 ]

providers=0
grep -q 'RuntimeFuncSpec::new("serial_println"' "$registry" && providers=$((providers + 1))
grep -q 'insert_simple!("serial_println"' "$interpreter" && providers=$((providers + 1))
[ "$providers" -eq 1 ]

grep -q 'val _WM_TRACE: bool = false' "$module"
grep -q 'host_gpu_ivshmem_device_receipt_valid' "$module"
grep -q 'present_argb32_from_mmio' "$module"

echo "Engine2D WM frame SFFI authority audit: PASS (37 serial writes routed through 1 mandatory-inline lexical owner; 0 both/1 one/0 no-provider; receipt/presentation checks retained)"
