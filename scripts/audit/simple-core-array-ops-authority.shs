#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/runtime/simple_core/core_array_ops.spl"
provider="$root/src/runtime/simple_core/core_array.spl"
cranelift="$root/src/compiler_rust/compiler/src/codegen/instr/calls.rs"
llvm="$root/src/compiler_rust/compiler/src/codegen/llvm/functions/calls.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

raw_symbols="malloc calloc realloc free memcpy spl_load_i64 spl_store_i64 spl_load_u8 spl_store_u8 array_ptr array_items array_len_value array_cap array_flags array_is_valid set_array_items set_array_len set_array_cap normalize_index register_array unregister_array rt_array_new rt_array_push"

for raw in $raw_symbols; do
    if [ "$(grep -Ec "(^|[^A-Za-z0-9_])${raw}\\(" "$module")" -ne 2 ]; then
        echo "simple-core array op escaped its mandatory-inline owner: $raw" >&2
        exit 1
    fi
done

[ "$(grep -Ec '(^|[^A-Za-z0-9_])numeric_index\(' "$module")" -eq 1 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 23 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi, raw_ptr\]):' "$module")" -eq 23 ]

for intrinsic in spl_load_i64 spl_store_i64 spl_load_u8 spl_store_u8; do
    grep -q "\"$intrinsic\"" "$cranelift"
    grep -q "\"$intrinsic\"" "$llvm"
done
for helper in array_ptr array_items array_len_value array_cap array_flags array_is_valid set_array_items set_array_len set_array_cap register_array unregister_array; do
    grep -Eq "^(pub )?fn ${helper}\\(" "$provider"
done
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "simple-core array-ops authority audit: PASS (23 used raw operations have mandatory-inline minimal owners; intrinsic and archive providers pinned)"
