#!/bin/sh
set -eu

# Zero-runtime-cost coverage gate for the compiler-owned runtime ABI registry.
# A runtime symbol without a RuntimeFuncSpec is not verified callable metadata;
# new gaps fail this gate instead of silently receiving the legacy fn() anchor.

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
"$root/scripts/audit/sffi-exact-pointer-write-abi.shs"
missing_output=
if [ "${1:-}" = "--missing-output" ]; then
    if [ "$#" -ne 2 ] || [ -z "$2" ]; then
        echo "usage: $0 [--missing-output PATH]" >&2
        exit 2
    fi
    missing_output=$2
elif [ "$#" -ne 0 ]; then
    echo "usage: $0 [--missing-output PATH]" >&2
    exit 2
fi
temp_dir=$(mktemp -d)
trap 'rm -rf "$temp_dir"' EXIT HUP INT TERM

names="$temp_dir/runtime-names"
specs="$temp_dir/runtime-specs"
covered="$temp_dir/covered"
missing="$temp_dir/missing"

awk '
    /pub const RUNTIME_SYMBOL_NAMES/ { inside = 1; next }
    inside && /^[[:space:]]*];/ { exit }
    inside && /^[[:space:]]*"[A-Za-z0-9_.]+",?[[:space:]]*(\/\/.*)?$/ {
        line = $0
        sub(/^[[:space:]]*"/, "", line)
        sub(/".*/, "", line)
        print line
    }
' "$root/src/compiler_rust/common/src/runtime_symbols.rs" | sort -u > "$names"

sed -n 's/.*RuntimeFuncSpec::new("\([^"]*\)".*/\1/p' \
    "$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs" | \
    sort -u > "$specs"

comm -12 "$names" "$specs" > "$covered"
comm -23 "$names" "$specs" > "$missing"

if [ -n "$missing_output" ]; then
    # Publish atomically so readers never observe a partially written ledger.
    output_dir=$(dirname -- "$missing_output")
    output_name=$(basename -- "$missing_output")
    mkdir -p "$output_dir"
    output_temp=$(mktemp "$output_dir/.${output_name}.XXXXXX")
    cp "$missing" "$output_temp"
    mv "$output_temp" "$missing_output"
fi

name_count=$(wc -l < "$names" | tr -d ' ')
spec_count=$(wc -l < "$specs" | tr -d ' ')
covered_count=$(wc -l < "$covered" | tr -d ' ')
missing_count=$(wc -l < "$missing" | tr -d ' ')

# 2026-08-21 baseline. Additions must carry a contract; migrations reduce the
# missing ceiling and raise the covered floor in the same commit.
minimum_covered=1094
maximum_missing=698

failed=0
if [ "$covered_count" -lt "$minimum_covered" ]; then
    echo "runtime SFFI contract coverage regressed: $covered_count < $minimum_covered" >&2
    failed=1
fi
if [ "$missing_count" -gt "$maximum_missing" ]; then
    echo "uncontracted runtime SFFI symbols grew: $missing_count > $maximum_missing" >&2
    echo "new/uncovered symbols:" >&2
    head -20 "$missing" >&2
    failed=1
fi
if [ $((covered_count + missing_count)) -ne "$name_count" ]; then
    echo "runtime SFFI contract census is internally inconsistent" >&2
    failed=1
fi

printf '%s\n' \
    "runtime symbols: $name_count" \
    "compiler ABI specs: $spec_count" \
    "covered runtime symbols: $covered_count" \
    "uncontracted runtime symbols: $missing_count"

if [ "$failed" -ne 0 ]; then
    exit 1
fi

echo "runtime symbol contract coverage: PASS"
