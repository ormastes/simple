#!/bin/sh
set -eu

module=src/compiler/80.driver/driver_api_interpret.spl

test "$(rg -c '^extern fn rt_(file_exists|file_read_text)' "$module")" -eq 2
test "$(rg -c '^fn _interpret_cache_(exists|read)_raw' "$module")" -eq 2
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 2
rg -q '^extern fn rt_file_read_text\(path: text\) -> text\?$' "$module"

for symbol in rt_file_exists rt_file_read_text; do
    test "$(rg -c "${symbol}\\(" "$module")" -eq 2
done

rg -q 'if current_source_raw == nil:' "$module"
test "$(rg -c '_interpret_cache_read_raw\(path\)' "$module")" -eq 1
