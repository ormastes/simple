#!/bin/sh
set -eu

module=src/compiler/10.frontend/core/interpreter/jit.spl

if rg -q '^extern fn ' "$module"; then
    echo "interpreter JIT state must not own raw SFFI authority" >&2
    exit 1
fi
if rg -q '(file_write_exact|file_read_result|file_write|file_read|file_delete|getpid|/tmp/simple_jit)' "$module"; then
    echo "interpreter JIT state must stay in-memory without temp-file or PID I/O" >&2
    exit 1
fi
rg -q '^use compiler\.core\.interpreter\.hashmap\.\{HM_SIZE, hm_hash_text, hm_make_global_buckets\}$' "$module"
rg -q '"memory://simple_jit"' "$module"
test "$(rg -c '_load_state\(' "$module")" -eq 1
