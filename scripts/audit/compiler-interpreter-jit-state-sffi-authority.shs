#!/bin/sh
set -eu

module=src/compiler/10.frontend/core/interpreter/jit.spl

if rg -q '^extern fn rt_(file_write_text|file_read_text|file_delete|getpid)\(' "$module"; then
    echo "interpreter JIT state must not own raw file/PID authority" >&2
    exit 1
fi
rg -q '^use std\.io_runtime\.\{file_write_exact, file_read_result, file_delete, getpid\}$' "$module"
test "$(rg -c 'getpid\(' "$module")" -eq 1
test "$(rg -c 'file_read_result\(' "$module")" -eq 1
test "$(rg -c 'file_write_exact\(' "$module")" -eq 1
test "$(rg -c 'file_delete\(' "$module")" -eq 1
rg -q 'case Err\(_\): ""' "$module"
# Do not hide the existing file-backed call-path cost until a measured,
# concurrency-preserving in-memory design replaces it.
test "$(rg -c '_load_state\(\)' "$module")" -ge 10
