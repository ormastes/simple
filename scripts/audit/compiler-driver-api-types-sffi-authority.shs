#!/bin/sh
set -eu

module=src/compiler/80.driver/driver_api_types.spl

test "$(rg -c '^extern fn rt_' "$module")" -eq 2
test "$(rg -c '^fn _driver_api_runtime_(file_exists|env)_raw' "$module")" -eq 2
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 2
rg -q '^extern fn rt_env_get\(name: text\) -> text\?$' "$module"
for symbol in rt_file_exists rt_env_get; do
    test "$(rg -c "${symbol}\\(" "$module")" -eq 2
done
if rg -q '^extern fn (rt_dir_exists|rt_dir_list|rt_dir_create|rt_path_join|rt_path_parent|rt_process_run|sys_get_args)' "$module"; then
    echo "unused raw driver API authority returned" >&2
    exit 1
fi
test "$(rg -c '_driver_api_runtime_file_exists_raw\(' "$module")" -eq 4
test "$(rg -c '_driver_api_runtime_env_raw\(' "$module")" -eq 2
