#!/bin/sh
# Static lexical-boundary guard for the WM lane-boundary ratchet gate.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/app/check/wm_lane_boundary_check.spl"

test "$(grep -c '^extern fn rt_file_read_text' "$module")" -eq 0
test "$(grep -c '^use std.io_runtime.{read_file_text_result}$' "$module")" -eq 1
test "$(grep -c 'read_file_text_result(path)' "$module")" -eq 2
test "$(grep -c 'case Err(error): return Err("could not read {path}: {error}")' "$module")" -eq 2

echo 'WM lane-boundary SFFI authority: PASS local_raw_declarations=0 result_lifts=2 fabricated_empty_wrapper=absent artifact_admission=absent'
