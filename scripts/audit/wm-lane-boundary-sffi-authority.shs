#!/bin/sh
# Static lexical-boundary guard for the WM lane-boundary ratchet gate.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/app/check/wm_lane_boundary_check.spl"

test "$(grep -c '^@unsafe(reason: "raw file-read ABI; missing/error return cannot be lifted safely without changing gate semantics", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^extern fn rt_file_read_text(path: text) -> text$' "$module")" -eq 1
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_file_read_text(path)' "$module")" -eq 2

echo 'WM lane-boundary SFFI authority: PASS declarations=1 lexical_calls=2 direct_call_shape=preserved fabricated_empty_wrapper=absent artifact_admission=absent'
