#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
canonical="$root/src/lib/nogc_sync_mut/io/rapier2d_sffi.spl"
app_facade="$root/src/app/io/rapier2d_sffi.spl"

if [ "$(grep -c '^[[:space:]]*extern fn rt_rapier2d_' "$canonical")" -ne 48 ]; then
    echo "canonical Rapier2D declaration inventory changed without contract review" >&2
    exit 1
fi
tagged=$(awk '
    /^@unsafe\(.*capabilities: \[ffi\]\)$/ { previous_is_ffi = 1; next }
    /^[[:space:]]*extern fn rt_rapier2d_/ {
        if (previous_is_ffi) tagged++
    }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$canonical")
if [ "$tagged" -ne 48 ]; then
    echo "every canonical Rapier2D declaration must be explicitly unsafe(ffi)" >&2
    exit 1
fi
if grep -n -E 'extern fn rt_|^[[:space:]]*fn |handle != 0' "$app_facade"; then
    echo "application Rapier2D facade duplicates providers, wrappers, or unsafe handle semantics" >&2
    exit 1
fi
if ! grep -q '^export use std\.nogc_sync_mut\.io\.rapier2d_sffi\.\*$' "$app_facade"; then
    echo "application Rapier2D facade must re-export the canonical owner" >&2
    exit 1
fi

echo "Rapier2D SFFI owner audit: PASS"
