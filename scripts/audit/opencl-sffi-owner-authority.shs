#!/bin/sh
# OpenCL's raw ABI is owned only by the no-GC SFFI module.  Source-backed C is
# not signed/admitted evidence, so every raw declaration must remain explicit.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/gpu/engine2d/sffi_opencl.spl"

raw_count=$(grep -c '^extern fn rt_opencl_' "$owner")
unsafe_count=$(grep -B1 '^extern fn rt_opencl_' "$owner" | grep -c '@unsafe')
test "$raw_count" -eq 20
test "$unsafe_count" -eq "$raw_count"
test "$(rg -l '^extern fn rt_opencl_' "$root/src/lib" "$root/src/app" --glob '*.spl' | wc -l)" -eq 1

echo 'OpenCL SFFI owner authority: PASS (20 tagged raw declarations; one owner)'
