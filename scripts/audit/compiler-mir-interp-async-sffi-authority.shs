#!/bin/sh
set -eu

module=src/compiler/95.interp/mir_interp_runtime.spl

test "$(rg -c '^extern fn rt_(actor_spawn|actor_send|actor_recv|thread_yield)' "$module")" -eq 4
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 4
for symbol in actor_spawn actor_send actor_recv thread_yield; do
    test "$(rg -c "^extern fn rt_${symbol}\\(" "$module")" -eq 1
    test "$(rg -c "^[[:space:]]+rt_${symbol}\\(" "$module")" -eq 1
done
test "$(rg -c '_mir_interp_actor_spawn_raw\(' "$module")" -eq 2
test "$(rg -c '_mir_interp_actor_send_raw\(' "$module")" -eq 2
test "$(rg -o '_mir_interp_actor_recv_raw\(' "$module" | wc -l)" -eq 3
test "$(rg -c '_mir_interp_thread_yield_raw\(' "$module")" -eq 2
test "$(rg -c 'if args\.len\(\) > 0: _mir_interp_actor_spawn_raw\(args\[0\]\) else: 0' "$module")" -eq 1
