#!/bin/sh
# Static lexical-boundary guard for the minimal child test runner.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/app/test_runner_new/test_runner_single.spl"

test "$(grep -c '^@unsafe(reason: "raw test-source/coverage text ABI; helper return types cannot carry I/O errors", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^@unsafe(reason: "raw procfs path-resolution ABI", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^extern fn \(rt_file_read_text\|rt_path_absolute\)' "$module")" -eq 2
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_file_read_text' "$module")" -eq 10
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_path_absolute' "$module")" -eq 1

echo 'Child test-runner SFFI authority: PASS declarations=2 lexical_calls=11 direct_call_shape=preserved artifact_admission=absent'
