#!/bin/sh
# Static lexical-boundary guard for dashboard schedule/daemon collection.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/app/llm_dashboard/collectors/schedule_collector.spl"

test "$(grep -c '^@unsafe(reason: "raw schedule/lock-file text ABI; collector results lack an error channel", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^extern fn rt_file_read_text(path: text) -> text$' "$module")" -eq 1
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_file_read_text' "$module")" -eq 2

echo 'Dashboard schedule collector SFFI authority: PASS declarations=1 lexical_calls=2 direct_call_shape=preserved no_false_safe_absence=preserved artifact_admission=absent'
