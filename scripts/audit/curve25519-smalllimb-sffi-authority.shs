#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/crypto/curve25519_smalllimb.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^extern fn ' "$module")" -eq 1 ]
[ "$(grep -c '^@unsafe(reason:' "$module")" -eq 12 ]
[ "$(grep -c 'rt_bytes_u8_at(' "$module")" -eq 2 ]
[ "$(grep -c '^@always_inline$' "$module" || true)" -eq 0 ]
! grep -q 'serial_println' "$module"
! grep -q '_sl_curve_debug' "$module"

grep -q 'RuntimeFuncSpec::new("rt_bytes_u8_at"' "$registry"
grep -q 'insert_simple!("rt_bytes_u8_at"' "$interpreter"

# Preserve the fixed 255-step ladder and radix/carry representation.
grep -q 'var bit_pos: i64 = 254' "$module"
grep -q 'while bit_pos >= 0:' "$module"
grep -q 'val a24_e = _x25519_fe_mul_scalar(e, 121665)' "$module"
grep -q 'val MASK26: u64 = 0x3FFFFFF' "$module"
grep -q 'val MASK25: u64 = 0x1FFFFFF' "$module"

echo "Curve25519 small-limb SFFI authority audit: PASS (1 byte-access call/1 symbol; 1 both/0 one/0 no-provider; 26 serial writes and 9 no-op debug calls removed; fixed ladder/radix arithmetic retained; unchecked 32-byte contracts remain unsafe)"
