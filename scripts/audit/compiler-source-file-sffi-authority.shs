#!/bin/sh
set -eu

module=src/compiler/00.common/driver_source_file.spl

rg -q '^@unsafe\(reason: "raw nullable compiler source read; nil is provider failure", capabilities: \[ffi\]\)$' "$module"
rg -q '^extern fn rt_file_read_text\(path: text\) -> text\?$' "$module"
test "$(rg -c 'rt_file_read_text\(' "$module")" -eq 2
test "$(rg -c '^fn _driver_source_read_raw\(' "$module")" -eq 1
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 1
rg -q 'if raw_content == nil:' "$module"
rg -q 'Source file is empty:' "$module"

# One source read per load; coverage identity reuses the lifted content.
load_body="$(sed -n '/static fn load/,/^fn source_file_authored_path/p' "$module")"
test "$(printf '%s\n' "$load_body" | rg '_driver_source_read_raw\(' | wc -l)" -eq 1
