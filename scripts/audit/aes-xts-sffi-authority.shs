#!/bin/sh
# AES-XTS keeps a direct fixed-shape runtime boundary; do not hide it behind
# generic marshalling, admission lookups, or a slower scalar replacement.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/os/crypto/aes_xts.spl"
provider="$root/src/compiler_rust/runtime/src/value/aes.rs"

declarations=$(grep -Ec '^extern fn rt_(bytes_u8_at|array_new_with_cap|aes_decrypt_block_with_expanded)' "$owner")
test "$declarations" -eq 3 || {
    echo 'AES-XTS SFFI declaration inventory changed without ABI review' >&2
    exit 1
}

tagged=$(awk '
    /^@unsafe\(.*capabilities: \[ffi\]\)$/ { previous_is_ffi = 1; next }
    /^extern fn rt_(bytes_u8_at|array_new_with_cap|aes_decrypt_block_with_expanded)/ {
        if (previous_is_ffi) tagged += 1
    }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$owner")
test "$tagged" -eq "$declarations" || {
    echo 'AES-XTS raw declaration lacks unsafe(ffi)' >&2
    exit 1
}

calls=$(awk '
    !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / {
        line = $0
        while (match(line, /rt_(bytes_u8_at|array_new_with_cap|aes_decrypt_block_with_expanded)[(]/)) {
            calls += 1
            line = substr(line, RSTART + RLENGTH)
        }
    }
    END { print calls + 0 }
' "$owner")
test "$calls" -eq 16 || {
    echo 'AES-XTS raw-call inventory changed without boundary review' >&2
    exit 1
}

awk '
    function indent(line, copy) {
        copy = line
        sub(/[^ ].*$/, "", copy)
        return length(copy)
    }
    NF && unsafe_indent >= 0 &&
    $0 !~ /unsafe\(capabilities: \[ffi\]\):$/ && indent($0) <= unsafe_indent {
        unsafe_indent = -1
    }
    /unsafe\(capabilities: \[ffi\]\):$/ {
        unsafe_indent = indent($0)
        next
    }
    !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / &&
    /rt_(bytes_u8_at|array_new_with_cap|aes_decrypt_block_with_expanded)[(]/ {
        if (unsafe_indent < 0 || indent($0) <= unsafe_indent) {
            print "AES-XTS raw call lacks lexical FFI authority: " NR ":" $0 > "/dev/stderr"
            failed = 1
        }
    }
    BEGIN { unsafe_indent = -1 }
    END { if (failed) exit 1 }
' "$owner"

grep -q 'pub extern "C" fn rt_aes_decrypt_block_with_expanded' "$provider"
if grep -E '^[[:space:]]*(sha256|verify_signature|dlsym|registry_lookup|ffi_call)\(' "$owner" >/dev/null; then
    echo 'AES-XTS operation gained per-call admission or generic dispatch' >&2
    exit 1
fi

echo 'AES-XTS SFFI authority: PASS (3 declarations, 16 lexical raw calls, no per-call admission work)'
