#!/bin/sh
# Static lexical-boundary guard for small scalar-math SFFI owners.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

check_owner() {
    module="$1"
    symbol="$2"
    calls="$3"
    test "$(grep -c '^@unsafe(reason: "raw scalar math ABI", capabilities: \[ffi\])$' "$module")" -eq 1
    test "$(grep -c "^extern fn $symbol" "$module")" -eq 1
    test "$(grep -c "unsafe(capabilities: \[ffi\]): $symbol" "$module")" -eq "$calls"
}

check_owner "$root/src/lib/common/math/noise.spl" rt_math_floor 5
check_owner "$root/src/lib/common/science_math/statistics.spl" rt_math_sqrt 1
check_owner "$root/src/lib/common/science_math/ml_metrics.spl" rt_math_sqrt 1
check_owner "$root/src/lib/common/science_math/linalg.spl" rt_math_sqrt 1
check_owner "$root/src/lib/nogc_sync_mut/database/vector/distance.spl" rt_math_sqrt 2

echo 'Scalar math SFFI authority: PASS declarations=5 lexical_calls=10 direct_call_shape=preserved artifact_admission=absent'
