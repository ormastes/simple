#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
provider="$root/src/runtime/runtime_sdl2.c"
binding="$root/src/lib/nogc_sync_mut/io/window_sffi.spl"
async_binding="$root/src/lib/nogc_async_mut/io/window_sffi.spl"
consumer="$root/src/lib/nogc_sync_mut/web_ui/app.spl"
failed=0

ms_body=$(sed -n '/^int64_t rt_sdl2_get_ticks_ms/,/^}/p' "$provider")
ns_body=$(sed -n '/^int64_t rt_sdl2_get_ticks_ns/,/^}/p' "$provider")
if ! printf '%s\n' "$ms_body" | grep -q 'SDL2_REQUIRE(-1)' ||
   ! printf '%s\n' "$ns_body" | grep -q 'SDL2_REQUIRE(-1)' ||
   ! printf '%s\n' "$ns_body" | grep -q 'g_perf_freq == 0) return -1' ||
   ! printf '%s\n' "$ns_body" | grep -q 'return INT64_MAX'; then
    echo "SDL2 clocks must retain negative failure and signed saturation contracts" >&2
    failed=1
fi
if printf '%s\n%s\n' "$ms_body" "$ns_body" |
   grep -Eq 'malloc|calloc|realloc|pthread_|mutex|SDL_GetError'; then
    echo "SDL2 clock hot paths must remain allocation-, lock-, and error-query-free" >&2
    failed=1
fi

declarations=$(sed -n '/^# --- Time ---/,/^# --- Window State ---/p' "$binding")
if [ "$(printf '%s\n' "$declarations" | grep -c '^extern fn rt_sdl2_get_ticks_' || true)" -ne 2 ] ||
   [ "$(printf '%s\n' "$declarations" | grep -c '^@unsafe(reason: "raw SDL2 provider ABI;' || true)" -ne 2 ]; then
    echo "both SDL2 clock declarations must retain exact failure contracts" >&2
    failed=1
fi
for wrapper in window_ticks_ms window_ticks_ns; do
    if ! grep -q "^fn $wrapper() -> i64?:" "$binding" ||
       grep -B1 "^fn $wrapper" "$binding" | grep -q '^@unsafe' ||
       ! grep -q "$wrapper" "$async_binding"; then
        echo "$wrapper must remain a checked optional wrapper in both facades" >&2
        failed=1
    fi
done
if grep -q 'rt_sdl2_get_ticks_ms' "$consumer" ||
   ! grep -q 'while self.running and now < target:' "$consumer" ||
   [ "$(grep -c 'SDL2 frame clock unavailable' "$consumer" || true)" -ne 3 ]; then
    echo "Web UI frame pacing must stop, not spin or fabricate time, on clock failure" >&2
    failed=1
fi

if [ "$failed" -ne 0 ]; then
    exit 1
fi

echo "SDL2 time contract audit: PASS"
