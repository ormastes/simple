#!/bin/sh
set -eu

module=src/compiler/80.driver/cache/file_stamp.spl

test "$(rg -c '^extern fn rt_file_(exists|size|stat|hash_sha256)' "$module")" -eq 4
test "$(rg -c '^fn _file_stamp_(exists|size|mtime|hash)_raw' "$module")" -eq 4
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 4
rg -q '^extern fn rt_file_hash_sha256\(path: text\) -> text\?$' "$module"

for symbol in rt_file_exists rt_file_size rt_file_stat rt_file_hash_sha256; do
    test "$(rg -c "${symbol}\\(" "$module")" -eq 2
done

rg -q 'if sha_raw == nil:' "$module"
rg -q 'if sha_final_raw == nil:' "$module"
test "$(rg -c 'mtime_.* <= 0' "$module")" -ge 3
test "$(rg -c 'size_.* < 0' "$module")" -ge 2
