#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/io/graphics2d_sffi.spl"
gap="$root/src/compiler_rust/compiler/src/interpreter_extern/capability_gap.rs"
fixture="$root/test/fixture/interpreter_extern/lyon_capability_gap_probe.spl"

if [ "$(grep -c '^extern fn rt_lyon_' "$owner")" -ne 49 ]; then
    echo "Lyon declaration inventory changed without review" >&2
    exit 1
fi
if [ "$(grep -c '^[[:space:]]*@unsafe(.*capabilities: \[.*ffi' "$owner")" -ne 98 ]; then
    echo "Lyon declaration or wrapper authority inventory changed without review" >&2
    exit 1
fi

awk '
    function indent(line, copy) {
        copy = line
        sub(/[^ ].*$/, "", copy)
        return length(copy)
    }
    /^[[:space:]]*@unsafe\(.*capabilities: \[.*ffi.*\]\)$/ {
        next_function_unsafe = 1
        next
    }
    /^[[:space:]]*(static fn|fn|me) / {
        function_indent = indent($0)
        function_unsafe = next_function_unsafe
        next_function_unsafe = 0
        inside_function = 1
        next
    }
    inside_function && NF && indent($0) <= function_indent {
        function_unsafe = 0
        inside_function = 0
    }
    /rt_lyon_[A-Za-z0-9_]+\(/ && !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn/ && !function_unsafe {
        print "unscoped Lyon call at line " FNR ": " $0 > "/dev/stderr"
        failed = 1
    }
    END { if (failed) exit 1 }
' "$owner"

if grep -Eq 'graphics_.*_free\([^)]*\).*' "$owner" &&
   awk '
       /fn graphics_.*_free\(/ { in_free = 1; depth = 0 }
       in_free && /^[^ ]/ && !/fn graphics_.*_free\(/ { in_free = 0 }
       in_free && /^[[:space:]]+true[[:space:]]*$/ { exit 1 }
   ' "$owner"; then
    :
else
    echo "invalid Lyon resource cleanup must not report fabricated success" >&2
    exit 1
fi

grep -q '("rt_lyon_", "rt_lyon")' "$gap"
grep -q 'there is no real native implementation anywhere in this tree' "$gap"
grep -q '@unsafe(.*capabilities: \[ffi\])' "$fixture"
grep -q 'unsafe(capabilities: \[ffi\]):' "$fixture"

echo "Lyon SFFI authority audit: PASS (49 production declarations, 49 raw-calling wrappers, and the negative fixture explicitly unsafe; invalid cleanup fails closed; provider remains a capability gap)"
