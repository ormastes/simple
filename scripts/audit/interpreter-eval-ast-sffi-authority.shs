#!/bin/sh
# Static lexical-boundary guard for the interpreter AST proof-of-concept.
# It proves no artifact admission, signature, or native provider safety.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
binding="$root/src/app/interpreter/ffi/ast_ffi.spl"
consumer="$root/src/app/interpreter/ffi/eval_slice.spl"
provider="$root/src/compiler_rust/compiler/src/interpreter_extern/ast_sffi.rs"

test "$(grep -c '^@unsafe(' "$binding")" -eq 29
test "$(grep -c '^extern fn rt_ast_' "$binding")" -eq 29
grep -q 'pub fn rt_ast_expr_tag' "$provider"
grep -q 'pub fn rt_ast_expr_free' "$provider"

raw_calls=$(awk '
    /unsafe\(capabilities: \[ffi\]\):/ { pending=1; next }
    pending && /^[[:space:]]+rt_ast_/ { count++; pending=0; next }
    pending { pending=0 }
    END { print count + 0 }
' "$consumer")
test "$raw_calls" -eq 14

echo 'Interpreter AST SFFI authority: PASS raw_declarations=29 lexical_raw_calls=14 direct_calls_unchanged=1 artifact_admission=absent'
