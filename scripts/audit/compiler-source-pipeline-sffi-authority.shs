#!/bin/sh
set -eu

module=src/compiler/80.driver/driver_source_pipeline_loading.spl

rg -q '^@unsafe\(reason: "raw nullable bootstrap source read; nil is provider failure", capabilities: \[ffi\]\)$' "$module"
rg -q '^extern fn rt_file_read_text\(path: text\) -> text\?$' "$module"
test "$(rg -c 'rt_file_read_text\(' "$module")" -eq 2
test "$(rg -c '^fn _pipeline_source_read_raw\(' "$module")" -eq 1
rg -q 'if raw_content == nil:' "$module"
rg -q 'source read failed:' "$module"

body="$(sed -n '/me parse_bootstrap_default_file/,/me parse_bootstrap_default_root/p' "$module")"
test "$(printf '%s\n' "$body" | rg '_pipeline_source_read_raw\(' | wc -l)" -eq 1
test "$(printf '%s\n' "$body" | rg 'return false' | wc -l)" -ge 1
