#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
facade="$root/src/os/tls13/_Tls13/context_io.spl"

if [ "$(grep -c '^extern fn ' "$facade")" -ne 48 ] ||
   [ "$(grep -c '^@unsafe(.*capabilities: \[ffi\]' "$facade")" -ne 48 ]; then
    echo "TLS context declaration authority inventory changed" >&2
    exit 1
fi
if [ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$facade")" -ne 17 ]; then
    echo "TLS context lexical authority inventory changed" >&2
    exit 1
fi

calls=$(awk '
    !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / && !/^[[:space:]]*fn / {
        line = $0
        while (match(line, /rt_[A-Za-z0-9_]+[(]/)) {
            calls += 1
            line = substr(line, RSTART + RLENGTH)
        }
    }
    END { print calls + 0 }
' "$facade")
if [ "$calls" -ne 17 ]; then
    echo "TLS context raw-call inventory changed" >&2
    exit 1
fi

awk '
    function indent(line, copy) {
        copy = line
        sub(/[^ ].*$/, "", copy)
        return length(copy)
    }
    NF && unsafe_indent >= 0 &&
    $0 !~ /unsafe\(capabilities: \[[^]]*ffi[^]]*\]\):$/ && indent($0) <= unsafe_indent {
        unsafe_indent = -1
    }
    /unsafe\(capabilities: \[[^]]*ffi[^]]*\]\):$/ {
        unsafe_indent = indent($0)
        next
    }
    !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn / && !/^[[:space:]]*fn / &&
    /rt_[A-Za-z0-9_]+[(]/ {
        if (unsafe_indent < 0 || indent($0) <= unsafe_indent) {
            print "TLS context raw call lacks lexical FFI authority: " NR ":" $0 > "/dev/stderr"
            failed = 1
        }
    }
    BEGIN { unsafe_indent = -1 }
    END { if (failed) exit 1 }
' "$facade"

grep -q 'if max_len == 0 or max_len > _TLS_MAX_RECORD_PAYLOAD:' "$facade"
grep -q 'rt_ipc_recv_bytes(_NETSTACK_PORT, (max_len + 16).to_i64())' "$facade"
grep -q 'if pay_len == 0 or pay_len > _TLS_MAX_RECORD_PAYLOAD:' "$facade"

if grep -E '(sha256_manifest|dlsym|dlopen|registry_lookup|mutex)' "$facade" >/dev/null; then
    echo "TLS transport hot path gained admission or dynamic lookup work" >&2
    exit 1
fi

echo "TLS 1.3 context SFFI contract audit: PASS (48 declarations; 17 calls in minimal scopes; direct receive bounded to 18432 bytes; no admission work in hot path)"
