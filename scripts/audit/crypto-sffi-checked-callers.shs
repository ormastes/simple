#!/bin/sh
set -eu

# Security-sensitive consumers must use Result-bearing crypto wrappers. Legacy
# convenience APIs may remain for compatibility tests, but not on admission or
# handshake paths.

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
builder="$root/src/os/tls13/server_builders.spl"
handshake="$root/src/os/tls13/server_handshake.spl"
declarations="$root/src/lib/nogc_sync_mut/io/signature_sffi.spl"
tls_verify_dir="$root/src/os/tls13/_CertVerify"
failed=0

if ! awk '
    /^[[:space:]]*extern fn rt_.*(sign|verify)/ {
        if (previous !~ /@unsafe\(/ || previous !~ /capabilities:[[:space:]]*\[[^]]*ffi/) {
            printf "%s:%d:%s\n", FILENAME, FNR, $0
            failed = 1
        }
    }
    { previous = $0 }
    END { exit failed }
' "$declarations"; then
    echo "raw crypto declarations must carry explicit ffi unsafe metadata" >&2
    failed=1
fi

if grep -n -E 'extern fn rt_.*(sign|verify)|rt_ed25519_sign\(' "$builder"; then
    echo "TLS CertificateVerify builder calls raw crypto SFFI" >&2
    failed=1
fi
if ! grep -q 'ed25519_sign_pkcs8_checked' "$builder" ||
   ! grep -q 'ecdsa_p256_sign_checked' "$builder"; then
    echo "TLS CertificateVerify builder must use checked signing wrappers" >&2
    failed=1
fi
if ! grep -q 'build_certificate_verify_checked' "$handshake"; then
    echo "TLS server handshake must propagate CertificateVerify signing errors" >&2
    failed=1
fi
if grep -q 'build_certificate_verify(' "$handshake"; then
    echo "TLS server handshake still uses the empty-array compatibility wrapper" >&2
    failed=1
fi
if grep -R -n -E 'rsa_pss_sha(256|384|512)_verify_native' "$tls_verify_dir"; then
    echo "TLS verification paths still use legacy sentinel RSA-PSS wrappers" >&2
    failed=1
fi
if ! grep -R -q 'rsa_pss_sha256_verify_checked' "$tls_verify_dir" ||
   ! grep -R -q 'rsa_pss_sha384_verify_checked' "$tls_verify_dir" ||
   ! grep -R -q 'rsa_pss_sha512_verify_checked' "$tls_verify_dir"; then
    echo "TLS verification paths must use checked RSA-PSS wrappers" >&2
    failed=1
fi

if [ "$failed" -ne 0 ]; then
    exit 1
fi

echo "crypto SFFI checked-caller audit: PASS"
