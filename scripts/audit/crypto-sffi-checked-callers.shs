#!/bin/sh
set -eu

# Security-sensitive consumers must use Result-bearing crypto wrappers. Legacy
# convenience APIs may remain for compatibility tests, but not on admission or
# handshake paths.

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
builder="$root/src/os/tls13/server_builders.spl"
handshake="$root/src/os/tls13/server_handshake.spl"
declarations="$root/src/lib/nogc_sync_mut/io/signature_sffi.spl"
rsa_facade="$root/src/os/crypto/rsa.spl"
jwt="$root/src/lib/common/jwt/sign.spl"
common_p256="$root/src/lib/common/crypto/ecdsa_p256.spl"
os_ed25519="$root/src/os/crypto/ed25519.spl"
app_crypto="$root/src/app/io/crypto_ffi.spl"
canonical_crypto="$root/src/lib/nogc_sync_mut/io/crypto_sffi.spl"
async_crypto="$root/src/lib/nogc_async_mut/io/crypto_sffi.spl"
session_token="$root/src/app/ui.web/session_token.spl"
credential_store="$root/src/lib/nogc_sync_mut/terminal/credential/store.spl"
ws_crypto="$root/src/lib/gc_async_mut/gpu/browser_engine/net/ws_crypto.spl"
ws_client="$root/src/lib/gc_async_mut/gpu/browser_engine/net/websocket_client.spl"
oauth_sync="$root/src/lib/nogc_sync_mut/oauth/utilities.spl"
oauth_nogc_async="$root/src/lib/nogc_async_mut/oauth/utilities.spl"
oauth_gc_async="$root/src/lib/gc_async_mut/oauth/utilities.spl"
oauth_authorize_sync="$root/src/lib/nogc_sync_mut/oauth/authorize.spl"
oauth_authorize_nogc_async="$root/src/lib/nogc_async_mut/oauth/authorize.spl"
oauth_authorize_gc_async="$root/src/lib/gc_async_mut/oauth/authorize.spl"
security_types="$root/src/lib/nogc_sync_mut/security/types.spl"
tls_verify_dir="$root/src/os/tls13/_CertVerify"
failed=0

if ! awk '
    /^[[:space:]]*extern fn rt_.*(sign|verify)/ {
        if (previous !~ /@unsafe\(/ || previous !~ /capabilities:[[:space:]]*\[[^]]*ffi/) {
            printf "%s:%d:%s\n", FILENAME, FNR, $0
            failed = 1
        }
    }
    { previous = $0 }
    END { exit failed }
' "$declarations"; then
    echo "raw crypto declarations must carry explicit ffi unsafe metadata" >&2
    failed=1
fi

if grep -n -E 'extern fn rt_.*(sign|verify)|rt_ed25519_sign\(' "$builder"; then
    echo "TLS CertificateVerify builder calls raw crypto SFFI" >&2
    failed=1
fi
if ! grep -q 'ed25519_sign_pkcs8_checked' "$builder" ||
   ! grep -q 'ecdsa_p256_sign_checked' "$builder"; then
    echo "TLS CertificateVerify builder must use checked signing wrappers" >&2
    failed=1
fi
if ! grep -q 'build_certificate_verify_checked' "$handshake"; then
    echo "TLS server handshake must propagate CertificateVerify signing errors" >&2
    failed=1
fi
if grep -q 'build_certificate_verify(' "$handshake"; then
    echo "TLS server handshake still uses the empty-array compatibility wrapper" >&2
    failed=1
fi
if grep -R -n -E 'rsa_pss_sha(256|384|512)_verify_native' "$tls_verify_dir"; then
    echo "TLS verification paths still use legacy sentinel RSA-PSS wrappers" >&2
    failed=1
fi

if grep -n -E 'extern fn rt_rsa_|rt_rsa_sha(256|512)_(sign|verify)\(' "$rsa_facade"; then
    echo "OS RSA facade must use the checked canonical signature facade" >&2
    failed=1
fi
if ! grep -q 'fn rsa_sha256_sign.*Result<\[u8\], text>' "$rsa_facade" ||
   ! grep -q 'fn rsa_sha512_sign.*Result<\[u8\], text>' "$rsa_facade" ||
   ! grep -q 'fn rsa_sha256_verify.*Result<bool, text>' "$rsa_facade" ||
   ! grep -q 'fn rsa_sha512_verify.*Result<bool, text>' "$rsa_facade"; then
    echo "OS RSA facade must preserve typed signing and verification failures" >&2
    failed=1
fi
if grep -n -E 'rsa_sig_valid\(rsa_sha256_sign|val sig = rsa_sha256_sign\([^?]*$|val valid = rsa_sha256_verify\([^?]*$' "$jwt"; then
    echo "JWT RSA paths must propagate typed signing and verification failures" >&2
    failed=1
fi
if grep -n -E 'extern fn rt_ecdsa_p256_|rt_ecdsa_p256_(sign|verify)_checked\(' "$common_p256"; then
    echo "common P-256 facade must use the canonical checked signature owner" >&2
    failed=1
fi
if grep -n -E 'extern fn rt_ed25519_sign_seed|rt_ed25519_sign_seed\(' "$os_ed25519"; then
    echo "OS Ed25519 facade must use the canonical checked seed-signing owner" >&2
    failed=1
fi
if ! grep -q 'fn ed25519_sign_live.*Result<\[u8\], text>' "$os_ed25519" ||
   ! grep -q 'ed25519_sign_seed_checked' "$os_ed25519"; then
    echo "OS Ed25519 live signing must preserve typed provider failures" >&2
    failed=1
fi
if grep -n -E 'extern fn rt_|^[[:space:]]*fn ' "$app_crypto"; then
    echo "app crypto compatibility module must not duplicate providers or wrappers" >&2
    failed=1
fi
if ! grep -q '^export use std\.nogc_sync_mut\.io\.crypto_sffi\.\*$' "$app_crypto"; then
    echo "app crypto compatibility module must re-export the canonical owner" >&2
    failed=1
fi
if [ "$(grep -c '^[[:space:]]*extern fn rt_' "$canonical_crypto")" -ne 1 ] ||
   ! grep -q 'extern fn rt_random_hex' "$canonical_crypto"; then
    echo "canonical crypto facade may own only the implemented CSPRNG provider" >&2
    failed=1
fi
if grep -n -E 'rt_(hash_|hmac_|password_|encrypt_|decrypt_|generate_key|derive_key|random_bytes)' "$canonical_crypto"; then
    echo "canonical crypto facade advertises unresolved providers" >&2
    failed=1
fi
if ! grep -q 'fn _random_hex_raw' "$canonical_crypto" ||
   ! grep -q 'unsafe(capabilities: \[ffi\])' "$canonical_crypto"; then
    echo "CSPRNG provider call must remain in one minimal lexical unsafe wrapper" >&2
    failed=1
fi
if grep -n -E 'password_|encrypt|decrypt|generate_key|derive_key|random_bytes' "$async_crypto"; then
    echo "async crypto facade re-exports unsupported provider APIs" >&2
    failed=1
fi
if grep -n -E 'extern fn rt_random_hex|rt_random_hex\(' "$session_token"; then
    echo "session tokens must use the canonical checked entropy owner" >&2
    failed=1
fi
if ! grep -q 'random_hex as checked_random_hex' "$session_token"; then
    echo "session-token entropy validation import is missing" >&2
    failed=1
fi
if grep -n -E 'extern fn rt_random_hex|rt_random_hex\(' "$credential_store"; then
    echo "credential storage must use the canonical checked entropy owner" >&2
    failed=1
fi
if [ "$(grep -c 'checked_random_hex(' "$credential_store")" -ne 2 ]; then
    echo "credential salt and IV must each use the checked entropy owner once" >&2
    failed=1
fi
if grep -n -E 'extern fn rt_random_hex|rt_random_hex\(' "$ws_crypto"; then
    echo "WebSocket crypto must use the canonical checked entropy owner" >&2
    failed=1
fi
if ! grep -q 'fn generate_ws_key() -> Result<text>' "$ws_crypto" ||
   ! grep -q 'fn generate_mask_key() -> Result<\[i64\]>' "$ws_crypto"; then
    echo "WebSocket entropy failure must remain typed" >&2
    failed=1
fi
if [ "$(grep -c 'generate_mask_key()?' "$ws_client")" -ne 5 ] ||
   [ "$(grep -c 'generate_ws_key()?' "$ws_client")" -ne 1 ]; then
    echo "WebSocket client must propagate every key/mask entropy failure" >&2
    failed=1
fi
for oauth in "$oauth_sync" "$oauth_nogc_async" "$oauth_gc_async"; do
    if grep -n -E 'extern fn rt_random_hex|rt_random_hex\(|\?\?[[:space:]]*"0"' "$oauth"; then
        echo "OAuth entropy must use the canonical owner without a zero fallback: $oauth" >&2
        failed=1
    fi
    if ! grep -q 'fn random_int.*Result<i64, text>' "$oauth" ||
       ! grep -q 'fn generate_random_string.*Result<text, text>' "$oauth"; then
        echo "OAuth entropy failure must remain typed: $oauth" >&2
        failed=1
    fi
done
if grep -n -E 'extern fn rt_random_hex|rt_random_hex\(|checked_random_hex\(8\)[[:space:]]*\?\?' "$security_types"; then
    echo "security correlation IDs must use checked entropy without fallback" >&2
    failed=1
fi
if ! grep -q 'val rand = checked_random_hex(8)!' "$security_types"; then
    echo "security correlation-ID entropy failure must fail closed" >&2
    failed=1
fi
for oauth_authorize in "$oauth_authorize_sync" "$oauth_authorize_nogc_async" "$oauth_authorize_gc_async"; do
    if ! grep -q 'fn generate_state() -> Result<text, text>' "$oauth_authorize" ||
       ! grep -q 'fn generate_code_verifier() -> Result<text, text>' "$oauth_authorize"; then
        echo "OAuth CSRF/PKCE generators must propagate entropy failure: $oauth_authorize" >&2
        failed=1
    fi
done
if ! grep -R -q 'rsa_pss_sha256_verify_checked' "$tls_verify_dir" ||
   ! grep -R -q 'rsa_pss_sha384_verify_checked' "$tls_verify_dir" ||
   ! grep -R -q 'rsa_pss_sha512_verify_checked' "$tls_verify_dir"; then
    echo "TLS verification paths must use checked RSA-PSS wrappers" >&2
    failed=1
fi

if [ "$failed" -ne 0 ]; then
    exit 1
fi

echo "crypto SFFI checked-caller audit: PASS"
