#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/qemu_runner_part2.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^extern fn ' "$module")" -eq 7 ]
[ "$(grep -c '^@unsafe(reason:' "$module")" -eq 20 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 5 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 5 ]
[ "$(grep -c '_qemu_file_delete(' "$module")" -eq 5 ]
[ "$(grep -c '_qemu_file_write_text(' "$module")" -eq 4 ]
[ "$(grep -c '_qemu_file_read_text(' "$module")" -eq 2 ]
[ "$(grep -c '_qemu_env_get(' "$module")" -eq 11 ]
[ "$(grep -c '_qemu_env_set(' "$module")" -eq 20 ]
[ "$(grep -c 'rt_process_run_timeout(' "$module")" -eq 6 ]

symbols=$(awk '/^extern fn /{name=$3; sub(/\(.*/, "", name); print name}' "$module")
both=0
one=0
none=0
for symbol in $symbols; do
    providers=0
    grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry" && providers=$((providers + 1))
    grep -q "insert_simple!(\"$symbol\"" "$interpreter" && providers=$((providers + 1))
    case "$providers" in
        2) both=$((both + 1)) ;;
        1) one=$((one + 1)) ;;
        0) none=$((none + 1)) ;;
    esac
done
[ "$both" -eq 6 ]
[ "$one" -eq 1 ]
[ "$none" -eq 0 ]

grep -q 'val timeout_ms = _os_build_timeout_ms()' "$module"
grep -q 'rt_process_run_timeout(simple_bin, args, timeout_ms)' "$module"
grep -q 'rt_process_run_timeout(candidate, \["--version"\], 5000)' "$module"

echo "QEMU runner SFFI authority audit: PASS (42 former calls consolidated to 10 direct sites; 5 mandatory-inline env/file owners + 13 direct/transitive process owners; 6 both/1 one/0 no-provider; timeout/process tuple call shape retained)"
