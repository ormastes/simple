#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/compiler_rust/lib/std/src/infra/synchronization.spl"

declarations=$(grep -c '^[[:space:]]*extern fn ' "$owner")
if [ "$declarations" -ne 26 ]; then
    echo "bootstrap synchronization inventory changed without contract review" >&2
    exit 1
fi
tagged=$(awk '
    /^@unsafe\(.*capabilities: \[[^]]*ffi[^]]*\]\)$/ { previous_is_ffi = 1; next }
    /^[[:space:]]*extern fn / {
        if (previous_is_ffi) tagged++
    }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$owner")
if [ "$tagged" -ne "$declarations" ]; then
    echo "every bootstrap synchronization extern must be explicitly unsafe(ffi)" >&2
    exit 1
fi

grep -q '^extern fn rt_mutex_new(value: Any) -> Any$' "$owner" || exit 1
grep -q '^extern fn rt_mutex_unlock(mutex: Any, new_value: Any) -> i64$' "$owner" || exit 1
grep -q '^extern fn rt_rwlock_set(lock: Any, new_value: Any) -> i64$' "$owner" || exit 1
grep -q '^extern fn rt_once_call(once: i64, func: i64)$' "$owner" || exit 1
grep -q '^extern fn rt_once_is_completed(once: i64) -> bool$' "$owner" || exit 1
grep -q '^extern fn rt_thread_local_get(tls: i64) -> Any$' "$owner" || exit 1
if grep -q '^extern fn rt_rwlock_unlock_' "$owner"; then
    echo "bootstrap RwLock must not depend on provider no-op unlock shims" >&2
    exit 1
fi
grep -A5 'fn call(self, func: fn())' "$owner" | grep -q 'func()' || {
    echo "Once.call must not silently skip its initializer" >&2
    exit 1
}

echo "bootstrap synchronization SFFI contract audit: PASS"
