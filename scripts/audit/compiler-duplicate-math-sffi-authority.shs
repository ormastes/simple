#!/bin/sh
set -eu

module=src/compiler/90.tools/duplicate_check/math_utils.spl
features=src/compiler/90.tools/duplicate_check/features.spl

test "$(rg -c '^extern fn rt_math_sqrt' "$module")" -eq 1
test "$(rg -c 'rt_math_sqrt\(' "$module")" -eq 2
test "$(rg -o 'math_sqrt\(' "$module" | wc -l)" -eq 5
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 1
rg -Uq '@always_inline\nfn math_sqrt\(x: f64\) -> f64:' "$module"
test "$(rg -c 'cosine_from_dot_and_magnitudes\(dot_product, math_sqrt\(mag_a\), math_sqrt\(mag_b\)\)' "$module")" -eq 1
if rg -q 'rt_math_sqrt' "$features"; then
    echo "duplicate-check features must use the confined square-root owner" >&2
    exit 1
fi
test "$(rg -c 'math_sqrt\(sum_squares\)' "$features")" -eq 1
test "$(rg -c '^use compiler\.tools\.duplicate_check\.math_utils\.\{math_sqrt, cosine_from_dot_and_magnitudes\}' "$features")" -eq 1
