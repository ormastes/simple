#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/apps/sshd/ssh_session_helpers.spl"

if grep -E '(serial_println|log_raw_println|^extern fn rt_push_byte|^extern fn rt_bytes_|^extern fn rt_tls13_|^extern fn rt_ssh_)' "$module" >/dev/null; then
    echo "SSH helpers regained raw diagnostics or byte/crypto providers" >&2
    exit 1
fi

externs=$(grep -c '^extern fn ' "$module")
scopes=$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")
if [ "$externs" -ne 1 ] || [ "$scopes" -ne 1 ]; then
    echo "SSH helper foreign-boundary inventory changed" >&2
    exit 1
fi

grep -q '^extern fn rt_string_from_byte_array(arr: \[u8\]) -> text$' "$module"
grep -q '^@inline$' "$module"
grep -q '^fn rt_push_byte(arr: \[u8\], byte_val: i64) -> \[u8\]:' "$module"
grep -q '_append_byte(arr, byte_val.to_u8())' "$module"

calls=$(awk '
    !/^[[:space:]]*#/ && !/^[[:space:]]*fn rt_push_byte/ {
        line = $0
        while (match(line, /rt_push_byte[(]/)) {
            calls += 1
            line = substr(line, RSTART + RLENGTH)
        }
    }
    END { print calls + 0 }
' "$module")
if [ "$calls" -ne 28 ]; then
    echo "SSH helper Pure Simple append inventory changed" >&2
    exit 1
fi

grep -q 'if idx >= data.len():' "$module"
grep -q 'data\[idx\]' "$module"
grep -q 'data.slice(start, capped_end)' "$module"
grep -q 'field_len > data.len() - start' "$module"
grep -q 'field_len > 0u64 and field_text.len() == 0' "$module"
grep -q 'return Err("trailing data")' "$module"

echo "SSH helper boundary audit: PASS (byte/access/slice work is Pure Simple; one text lift is scoped and fail-closed)"
