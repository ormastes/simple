#!/bin/sh
set -eu

module=src/app/compile/c_runtime.spl

test "$(rg '^extern fn rt_file_read_text' "$module" | wc -l)" -eq 0
test "$(rg 'rt_file_read_text\(' "$module" | wc -l)" -eq 0
test "$(rg -c 'read_file_text_result\(runtime_path\)' "$module")" -eq 1

body="$(sed -n '/^fn generate_c_runtime/,/^# Parse struct/p' "$module")"
test "$(printf '%s\n' "$body" | rg 'file_exists\(' | wc -l)" -eq 0
rg -q 'C runtime read failed' "$module"
rg -q 'C runtime is empty' "$module"
rg -q 'Using minimal embedded runtime' "$module"
