#!/bin/sh
set -eu

summary=${1:-/tmp/rt-safety-summary.tsv}
declarations=${2:-/tmp/rt-safety-declarations.tsv}
languages=${3:-/tmp/rt-safety-languages.tsv}
families=${4:-/tmp/rt-safety-families.tsv}
scopes=${5:-/tmp/rt-safety-scopes.tsv}

rows=$(awk -F '\t' '$1 == "declaration_rows" { print $2 }' "$summary")
symbols=$(awk -F '\t' '$1 == "distinct_declared_symbols" { print $2 }' "$summary")
scoped_callsites=$(awk -F '\t' '$1 == "scoped_callsite_estimate" { print $2 }' "$summary")
symbols_with_callsites=$(awk -F '\t' '$1 == "distinct_symbols_with_scoped_callsites" { print $2 }' "$summary")
unsafe=$(awk -F '\t' '$1 == "fail_closed_unsafe_rows" { print $2 }' "$summary")
verified=$(awk -F '\t' '$1 == "verified_and_signed_rows" { print $2 }' "$summary")
provider_declared=$(awk -F '\t' '$1 == "provider_declared_rows" { print $2 }' "$summary")
provider_missing=$(awk -F '\t' '$1 == "provider_missing_rows" { print $2 }' "$summary")
contract_declared=$(awk -F '\t' '$1 == "unsafe_contract_declared_rows" { print $2 }' "$summary")
contract_missing=$(awk -F '\t' '$1 == "unsafe_contract_missing_rows" { print $2 }' "$summary")
minimization=$(awk -F '\t' '$1 == "unsafe_minimization_status" { print $2 }' "$summary")
test -n "$rows"
test "$rows" -gt 0
test "$scoped_callsites" -ge 0
test "$symbols_with_callsites" -ge 0
test "$symbols_with_callsites" -le "$symbols"
test "$unsafe" -eq "$((rows - verified))"
test "$rows" -eq "$((provider_declared + provider_missing))"
test "$unsafe" -eq "$((contract_declared + contract_missing))"
test "$minimization" = not_measured
test "$(awk -F '\t' 'NR > 1 && $17 != "unsafe" && $17 != "verified_and_signed" { n++ } END { print n + 0 }' "$declarations")" -eq 0
for language in Simple Rust C C++; do
    awk -F '\t' -v language="$language" '$1 == language && $3 > 0 { found=1 } END { exit !found }' "$languages"
done
family_rows=$(awk -F '\t' 'NR > 1 { total += $2 } END { print total + 0 }' "$families")
test "$family_rows" -eq "$rows"
test "$(awk -F '\t' 'NR > 1 { n++ } END { print n + 0 }' "$families")" -gt 0
scope_rows=$(awk -F '\t' 'NR > 1 { total += $2 } END { print total + 0 }' "$scopes")
test "$scope_rows" -eq "$rows"
test "$(awk -F '\t' 'NR > 1 && $1 == "unknown" { n += $2 } END { print n + 0 }' "$scopes")" -eq 0
for scope in production bootstrap_library test; do
    awk -F '\t' -v scope="$scope" '$1 == scope && $2 > 0 { found=1 } END { exit !found }' "$scopes"
done
test "$(awk -F '\t' 'NR > 1 { total += $9 } END { print total + 0 }' "$families")" -eq "$unsafe"
test "$(awk -F '\t' 'NR > 1 { total += $10 } END { print total + 0 }' "$families")" -eq "$contract_declared"
test "$(awk -F '\t' 'NR > 1 { total += $9 } END { print total + 0 }' "$scopes")" -eq "$unsafe"
test "$(awk -F '\t' 'NR > 1 { total += $10 } END { print total + 0 }' "$scopes")" -eq "$contract_declared"

echo 'rt safety census contract: PASS'
