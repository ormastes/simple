#!/bin/sh
set -eu

summary=${1:-/tmp/rt-safety-summary.tsv}
declarations=${2:-/tmp/rt-safety-declarations.tsv}
languages=${3:-/tmp/rt-safety-languages.tsv}

rows=$(awk -F '\t' '$1 == "declaration_rows" { print $2 }' "$summary")
unsafe=$(awk -F '\t' '$1 == "fail_closed_unsafe_rows" { print $2 }' "$summary")
verified=$(awk -F '\t' '$1 == "verified_and_signed_rows" { print $2 }' "$summary")
test -n "$rows"
test "$rows" -gt 0
test "$unsafe" -eq "$rows"
test "$verified" -eq 0
test "$(awk -F '\t' 'NR > 1 && $12 != "unsafe" { n++ } END { print n + 0 }' "$declarations")" -eq 0
for language in Simple Rust C C++; do
    awk -F '\t' -v language="$language" '$1 == language && $3 > 0 { found=1 } END { exit !found }' "$languages"
done

echo 'rt safety census contract: PASS'
