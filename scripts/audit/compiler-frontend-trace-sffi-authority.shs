#!/bin/sh
set -eu

module=src/compiler/10.frontend/trace_policy.spl
facade=src/lib/nogc_sync_mut/io_runtime.spl

if rg -q '^extern fn rt_env_get|rt_env_get\(' "$module"; then
    echo "frontend trace policy must use the canonical environment facade" >&2
    exit 1
fi

test "$(rg -c 'env_get_opt\("SIMPLE_COMPILER_TRACE"\)' "$module")" -eq 2
test "$(rg -c '^use std\.io_runtime\.\{env_get_opt\}' "$module")" -eq 1
rg -Uq '@always_inline\npub fn env_get_opt\(key: text\) -> text\?:' "$facade"
test "$(rg -c '_frontend_compiler_trace_scope_slot\[0\] != 0' "$module")" -eq 2
