#!/bin/sh
# Static ownership/performance gate for editor LSP and native smoke polling.
# Source shape is not cryptographic artifact admission.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
lsp="$root/src/lib/editor/services/lsp_transport.spl"
bridge="$root/src/lib/nogc_sync_mut/notebook/lsp_bridge.spl"

if grep -Eq '^extern fn rt_process_' "$lsp"; then
    echo 'LSP transport redeclared a raw process SFFI symbol' >&2
    exit 1
fi

grep -Fq 'process_read_stdout_result,' "$lsp"
grep -Fq 'process_is_piped_alive_result, process_close_piped' "$lsp"
grep -Fq 'me receive_result() -> Result<Option<text>, text>:' "$lsp"
test "$(grep -Fc 'process_read_stdout_result(me.pid)' "$lsp")" -eq 1
test "$(grep -Fc 'process_is_piped_alive_result(me.pid)' "$lsp")" -eq 2
grep -Fq 'last_error: text' "$lsp"
grep -Fq 'match self.transport.receive_result():' "$bridge"

if grep -Eq 'dlsym|CString|HashMap|Dictionary|sleep\(|retry' "$lsp"; then
    echo 'LSP transport added lookup, retry, or sleep to its hot path' >&2
    exit 1
fi

for smoke in debug_process_smoke.spl debug_process_launch_smoke.spl; do
    source="$root/src/app/editor/$smoke"
    ! grep -Eq '^extern fn rt_process_' "$source"
    grep -Fq 'match process_read_stdout_result(pid):' "$source"
    grep -Fq 'match process_is_piped_alive_result(pid):' "$source"
    grep -Fq 'if alive: thread_sleep(1)' "$source"
    test "$(grep -Fc 'process_read_stdout_result(pid)' "$source")" -eq 1
done

echo 'Editor LSP process SFFI contract: PASS raw_redeclarations=0 bounded_read_calls=1 idle_sleep_ms=1 explicit_hot_lookup=none admission=unsafe_unsigned'
