integration:
  schema: simple.integration/v1
  name: llm-caret-messaging
  version: 0.1.0
  kind: agent_chat_bridge
  runtime:
    command: caret
    args: [messaging, bridge]
  agents:
    claude:
      hooks: hooks/claude/hooks.json
      transport: local_http_or_unix
    codex:
      hooks: hooks/codex/hooks.json
      app_server: true
      transport: stdio_or_unix
    gemini:
      settings_fragment: hooks/gemini/settings.fragment.json
      transport: local_command
  mcp:
    manifest: mcp/manifest.sdn
  configuration:
    schema: config/schema.sdn
    defaults: config/defaults.sdn
  capabilities:
    room: true
    direct_message: true
    context_injection: true
    task_updates: true
    profiles: true
    receipts: true
  migrations:
    - migrations/001_initial.sdn
  install_policy:
    merge_settings: true
    backup_before_write: true
    record_owned_paths: true
    record_before_after_hashes: true
    preserve_user_entries_on_uninstall: true
    credentials_in_hook_files: false
