{
  "name": "llm-caret-messaging",
  "version": "0.1.0",
  "description": "Canonical LLM Caret rooms, tasks, context, receipts, and artifacts for Gemini CLI.",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "llm-caret-messaging": {
      "command": "caret",
      "args": ["messaging", "mcp"],
      "env": {
        "LLM_CARET_MESSAGING_DB": ".simple/state/llm-caret-messaging.db",
        "LLM_CARET_MESSAGING_IDENTITY": "local-agent",
        "LLM_CARET_MESSAGING_WORKSPACE": "default"
      }
    }
  }
}
