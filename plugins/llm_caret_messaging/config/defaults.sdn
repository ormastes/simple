messaging:
  server:
    listen: "unix://.simple/run/llm-caret-messaging.sock"
    database: .simple/state/llm-caret-messaging.db
    external_http: false
  defaults:
    room_mode: mention
    update_policy: milestones
    previous_messages: 2
    mirror_policy: full
  transports:
    primitive:
      enabled: true
      mirror_policy: full
