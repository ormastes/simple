# Task #145 synthetic-HIR probe.
#
# Drives MirLowering.lower_method_call directly with a synthetic
# HirExprKind.MethodCall whose resolution is MethodResolution.Unresolved,
# in VALUE POSITION (the returned LocalId is consumed), then dumps the MIR
# instructions the lowering emitted plus lowering.errors.len().
#
# Run with cwd = the tree under test:
#   bin/simple run probe145/mir_unresolved_probe.spl

use compiler.hir.hir_types.{SymbolTable, HirType, HirTypeKind}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirCallArg, MethodResolution}
use compiler.mir.mir_data.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.common.diagnostics.span.{Span}

fn sp() -> Span:
    Span.new(0, 0, 1, 1)

fn unit_type() -> HirType:
    HirType(kind: HirTypeKind.Unit, span: sp())

fn mk_expr(k: HirExprKind) -> HirExpr:
    HirExpr(kind: k, has_type_: false, type_: unit_type(), span: sp(), coverage_excluded: false)

fn const_desc(v: MirConstValue) -> text:
    match v:
        case Int(i): "Int({i})"
        case Float(f): "Float({f})"
        case Bool(b): "Bool({b})"
        case Str(s): "Str(\"{s}\")"
        case _: "OtherConst"

fn operand_desc(o: MirOperand) -> text:
    match o.kind:
        case Copy(l): "copy %{l.id}"
        case Move(l): "move %{l.id}"
        case Const(v, _): "const {const_desc(v)}"

fn args_desc(args: [MirOperand]) -> text:
    var s = ""
    var i = 0
    while i < args.len():
        if i > 0:
            s = s + ", "
        s = s + operand_desc(args[i])
        i = i + 1
    s

fn inst_desc(inst: MirInst) -> text:
    match inst.kind:
        case Const(d, v, _): "  %{d.id} = CONST {const_desc(v)}"
        case Call(d, f, a):
            var dst = "(void)"
            if val dd = d:
                dst = "%{dd.id}"
            "  {dst} = CALL {operand_desc(f)} ({args_desc(a)})"
        case Copy(d, s): "  %{d.id} = COPY %{s.id}"
        case Move(d, s): "  %{d.id} = MOVE %{s.id}"
        case Cast(d, o, _): "  %{d.id} = CAST {operand_desc(o)}"
        case Load(d, p): "  %{d.id} = LOAD {operand_desc(p)}"
        case Store(p, v): "  STORE {operand_desc(p)} <- {operand_desc(v)}"
        case Intrinsic(d, n, a):
            var dst2 = "(void)"
            if val dd2 = d:
                dst2 = "%{dd2.id}"
            "  {dst2} = INTRINSIC {n} ({args_desc(a)})"
        case _: "  <other inst>"

fn main():
    print "=== Task #145 synthetic-HIR MIR probe ==="
    var lowering = MirLowering.new(SymbolTable.new())

    # Give the builder a real block to emit into.
    var b0 = lowering.builder
    val entry = b0.new_block(Some("entry"))
    b0.switch_to_block(entry)
    lowering.builder = b0

    # Synthetic receiver: an int literal (always lowerable, carries no symbol
    # so no static/Option/array special case can steal the dispatch).
    val receiver = mk_expr(HirExprKind.IntLit(7, nil))
    val no_args: [HirCallArg] = []

    print "-- calling lower_method_call(7, \"frobnicate_zzz\", [], Unresolved)"
    val result = lowering.lower_method_call(receiver, "frobnicate_zzz", no_args, MethodResolution.Unresolved)

    # VALUE POSITION: consume the returned operand the way real code would
    # (feed it into a downstream instruction instead of discarding it).
    var b1 = lowering.builder
    val consumer = b1.new_temp(MirType.i64())
    b1.emit_copy(consumer, result)
    lowering.builder = b1

    print "-- lower_method_call returned local %{result.id} (consumed by %{consumer.id})"

    val insts = lowering.builder.instructions
    print "-- MIR instructions emitted: {insts.len()}"
    var i = 0
    while i < insts.len():
        print inst_desc(insts[i])
        i = i + 1

    val errs = lowering.errors
    print "-- lowering.errors.len() = {errs.len()}"
    var j = 0
    while j < errs.len():
        print "  err[{j}]: {errs[j].message}"
        j = j + 1

    # Machine-readable verdict lines.
    var saw_rt_panic = false
    var saw_const_zero = false
    var panic_before_const = false
    var k = 0
    while k < insts.len():
        match insts[k].kind:
            case Call(_, f, _):
                match f.kind:
                    case Const(cv, _):
                        match cv:
                            case Str(name):
                                if name == "rt_panic":
                                    saw_rt_panic = true
                                    if not saw_const_zero:
                                        panic_before_const = true
                            case _: ()
                    case _: ()
            case Const(d, cv2, _):
                if d.id == result.id:
                    match cv2:
                        case Int(iv):
                            if iv == 0:
                                saw_const_zero = true
                        case _: ()
            case _: ()
        k = k + 1

    print "VERDICT saw_const0_def_of_result={saw_const_zero} saw_rt_panic={saw_rt_panic} rt_panic_before_const0={panic_before_const} errors={errs.len()}"
