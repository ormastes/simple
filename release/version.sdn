version:
  schema: simple-release-version/1
  product: simple
  semver: 1.0.0-rc.1
  line: 1.0
  channel: rc

compatibility:
  public_api_major: 1
  compiler_abi: 7
  bootstrap_protocol: 4
  package_format: 3
  scv_store_schema: 2
  scv_wire_protocol: 1
  devhub_provider_api: 1
  spipe_skill_api: 1
  release_manifest_schema: 1
  bootstrap_receipt_schema: 1

projections:
  - VERSION
  - src/app/simple.sdn
  - src/lib/simple.sdn
  - src/compiler/simple.sdn
  - src/compiler/00.common/simple.sdn
  - src/compiler_rust/simple.sdn
  - src/compiler_rust/Cargo.toml
  - src/compiler_rust/Cargo.lock
  - src/app/cli/bootstrap_identity.spl
  - src/app/cli/cli_helpers.spl
  - src/app/cli/_CliMain/args_and_os_commands.spl
  - src/app/simple_core/main.spl
  - src/app/simpleos_tool/main.spl
  - tools/mcp-registry/package.json
  - tools/mcp-registry/server.json
  - tools/lsp-mcp-registry/package.json
  - tools/lsp-mcp-registry/server.json
