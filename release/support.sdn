support:
  schema: simple-release-support/2

  # Alpha/beta require the candidate workflow's executable Linux lane. Every
  # other advertised target stays visible and carries an honest non-PASS state.
  alpha:
    - target: x86_64-unknown-linux-gnu
      tier: tier_1
      runner: ubuntu-latest
      required: true
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: x86_64-apple-darwin
      tier: tier_2
      runner: macos-15-intel
      required: false
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: aarch64-apple-darwin
      tier: tier_2
      runner: macos-latest
      required: false
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: x86_64-pc-windows-msvc
      tier: tier_2
      runner: windows-latest
      required: false
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: x86_64-unknown-freebsd
      tier: tier_2
      runner: freebsd-qemu
      required: false
      availability: blocked
      bootstrap: full
      whole_tests: required
    - target: aarch64-unknown-linux-gnu
      tier: experimental
      runner: ubuntu-cross
      required: false
      availability: experimental
      bootstrap: full
      whole_tests: required
    - target: riscv64gc-unknown-linux-gnu
      tier: experimental
      runner: ubuntu-cross
      required: false
      availability: experimental
      bootstrap: full
      whole_tests: required

  beta:
    - target: x86_64-unknown-linux-gnu
      tier: tier_1
      runner: ubuntu-latest
      required: true
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: x86_64-apple-darwin
      tier: tier_2
      runner: macos-15-intel
      required: false
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: aarch64-apple-darwin
      tier: tier_2
      runner: macos-latest
      required: false
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: x86_64-pc-windows-msvc
      tier: tier_2
      runner: windows-latest
      required: false
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: x86_64-unknown-freebsd
      tier: tier_2
      runner: freebsd-qemu
      required: false
      availability: blocked
      bootstrap: full
      whole_tests: required
    - target: aarch64-unknown-linux-gnu
      tier: experimental
      runner: ubuntu-cross
      required: false
      availability: experimental
      bootstrap: full
      whole_tests: required
    - target: riscv64gc-unknown-linux-gnu
      tier: experimental
      runner: ubuntu-cross
      required: false
      availability: experimental
      bootstrap: full
      whole_tests: required

  # RC/stable require every native desktop Tier 1 receipt. The present
  # single-Linux candidate workflow consequently blocks these channels until
  # the macOS and Windows candidate lanes are wired into the receipt aggregate.
  rc:
    - target: x86_64-unknown-linux-gnu
      tier: tier_1
      runner: ubuntu-latest
      required: true
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: x86_64-apple-darwin
      tier: tier_1
      runner: macos-15-intel
      required: true
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: aarch64-apple-darwin
      tier: tier_1
      runner: macos-latest
      required: true
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: x86_64-pc-windows-msvc
      tier: tier_1
      runner: windows-latest
      required: true
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: x86_64-unknown-freebsd
      tier: tier_2
      runner: freebsd-qemu
      required: false
      availability: blocked
      bootstrap: full
      whole_tests: required
    - target: aarch64-unknown-linux-gnu
      tier: experimental
      runner: ubuntu-cross
      required: false
      availability: experimental
      bootstrap: full
      whole_tests: required
    - target: riscv64gc-unknown-linux-gnu
      tier: experimental
      runner: ubuntu-cross
      required: false
      availability: experimental
      bootstrap: full
      whole_tests: required

  stable:
    - target: x86_64-unknown-linux-gnu
      tier: tier_1
      runner: ubuntu-latest
      required: true
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: x86_64-apple-darwin
      tier: tier_1
      runner: macos-15-intel
      required: true
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: aarch64-apple-darwin
      tier: tier_1
      runner: macos-latest
      required: true
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: x86_64-pc-windows-msvc
      tier: tier_1
      runner: windows-latest
      required: true
      availability: supported
      bootstrap: full
      whole_tests: required
    - target: x86_64-unknown-freebsd
      tier: tier_2
      runner: freebsd-qemu
      required: false
      availability: blocked
      bootstrap: full
      whole_tests: required
    - target: aarch64-unknown-linux-gnu
      tier: experimental
      runner: ubuntu-cross
      required: false
      availability: experimental
      bootstrap: full
      whole_tests: required
    - target: riscv64gc-unknown-linux-gnu
      tier: experimental
      runner: ubuntu-cross
      required: false
      availability: experimental
      bootstrap: full
      whole_tests: required
