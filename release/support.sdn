support:
  schema: simple-release-support/1

  beta:
    required:
      - target: x86_64-unknown-linux-gnu
        runner: ubuntu-latest
        bootstrap: full
        whole_tests: required

  rc:
    required:
      - target: x86_64-unknown-linux-gnu
        runner: ubuntu-latest
        bootstrap: full
        whole_tests: required

  stable:
    required:
      - target: x86_64-unknown-linux-gnu
        runner: ubuntu-latest
        bootstrap: full
        whole_tests: required

  experimental:
    required: []
