# Release support policy — which targets a release of each channel must carry.
#
# Read fail-closed by src/app/release/support_policy.spl; `simple release
# support-check` rejects a release whose channel has no required target, and
# `check_single_job_coverage` requires EXACTLY ONE required target per channel
# (one candidate job produces one receipt).
#
# `required: true` refuses qualification without that target's complete receipt.
# RC1 selects the local Windows/MSVC host; this policy is not a PASS receipt.
# Other hosts remain unverified for RC1. RC2 must freeze its own support policy
# before qualification; alpha, beta and stable retain their Linux requirements.
# Every row requires full bootstrap and whole tests, including optional rows.
# The hosted candidate.yml path remains Linux-specific and cannot qualify RC1.
# See doc/07_guide/infra/rc1_windows_support_policy.md for the Windows artifact
# admission and publication integration still required before promotion.
support:
schema: simple-release-support/2

alpha:
- target: x86_64-unknown-linux-gnu
  tier: tier_1
  runner: ubuntu-latest
  required: true
  availability: supported
  bootstrap: full
  whole_tests: required
- target: aarch64-unknown-linux-gnu
  tier: experimental
  runner: self-hosted
  required: false
  availability: experimental
  bootstrap: full
  whole_tests: required

beta:
- target: x86_64-unknown-linux-gnu
  tier: tier_1
  runner: ubuntu-latest
  required: true
  availability: supported
  bootstrap: full
  whole_tests: required
- target: aarch64-unknown-linux-gnu
  tier: experimental
  runner: self-hosted
  required: false
  availability: experimental
  bootstrap: full
  whole_tests: required

rc:
- target: x86_64-pc-windows-msvc
  tier: tier_1
  runner: self-hosted
  required: true
  availability: supported
  bootstrap: full
  whole_tests: required
- target: x86_64-unknown-linux-gnu
  tier: tier_1
  runner: ubuntu-latest
  required: false
  availability: supported
  bootstrap: full
  whole_tests: required
- target: aarch64-unknown-linux-gnu
  tier: experimental
  runner: self-hosted
  required: false
  availability: experimental
  bootstrap: full
  whole_tests: required

stable:
- target: x86_64-unknown-linux-gnu
  tier: tier_1
  runner: ubuntu-latest
  required: true
  availability: supported
  bootstrap: full
  whole_tests: required
- target: aarch64-unknown-linux-gnu
  tier: experimental
  runner: self-hosted
  required: false
  availability: experimental
  bootstrap: full
  whole_tests: required
