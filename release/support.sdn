# Release support policy — which targets a release of each channel must carry.
#
# Read fail-closed by src/app/release/support_policy.spl; `simple release
# support-check` rejects a release whose channel has no required target, and
# `check_single_job_coverage` requires EXACTLY ONE required target per channel
# (one candidate job produces one receipt).
#
# Honesty rule for this file: `required: true` means a release is REFUSED
# without a receipt for that target. Declare a target required only where the
# candidate workflow actually builds and qualifies it. Everything else is
# declared with its real availability so the support matrix reports the truth
# rather than an empty set.
#
# Measured 2026-09-07: .github/workflows/candidate.yml assembles exactly one
# platform, x86_64-unknown-linux-gnu, and release/ carries exactly that one
# artifact directory. aarch64-unknown-linux-gnu has no release artifact and its
# bootstrap does not currently complete on this host (the AOT object-path step
# fails; tracked in doc/08_tracking/bug/), so it is declared experimental, not
# required. Every declared row still states bootstrap: full / whole_tests:
# required -- the reader enforces that on ALL rows: it is the bar a target must
# clear to BE supported, not a claim that it already has. Promoting it to required is a deliberate edit once its bootstrap
# and whole-suite receipts exist.
support:
schema: simple-release-support/2

alpha:
- target: x86_64-unknown-linux-gnu
  tier: tier_1
  runner: ubuntu-latest
  required: true
  availability: supported
  bootstrap: full
  whole_tests: required
- target: aarch64-unknown-linux-gnu
  tier: experimental
  runner: self-hosted
  required: false
  availability: experimental
  bootstrap: full
  whole_tests: required

beta:
- target: x86_64-unknown-linux-gnu
  tier: tier_1
  runner: ubuntu-latest
  required: true
  availability: supported
  bootstrap: full
  whole_tests: required
- target: aarch64-unknown-linux-gnu
  tier: experimental
  runner: self-hosted
  required: false
  availability: experimental
  bootstrap: full
  whole_tests: required

rc:
- target: x86_64-unknown-linux-gnu
  tier: tier_1
  runner: ubuntu-latest
  required: true
  availability: supported
  bootstrap: full
  whole_tests: required
- target: aarch64-unknown-linux-gnu
  tier: experimental
  runner: self-hosted
  required: false
  availability: experimental
  bootstrap: full
  whole_tests: required

stable:
- target: x86_64-unknown-linux-gnu
  tier: tier_1
  runner: ubuntu-latest
  required: true
  availability: supported
  bootstrap: full
  whole_tests: required
- target: aarch64-unknown-linux-gnu
  tier: experimental
  runner: self-hosted
  required: false
  availability: experimental
  bootstrap: full
  whole_tests: required
