use common.kernel_plugin.ids.{KpfId128, KpfDigest256}
use common.kernel_plugin.contracts.{KpfMemoryContractV1, KpfConcurrencyContractV1}

pub enum MdsocppProfile:
    Userland
    MissionCritical
    Kernel
    Driver

pub enum MdsocppClosure:
    Static
    Complete
    Dyn

pub enum MdsocppMigrationKind:
    Exact
    Additive
    Custom

pub enum MdsocppSealStatus:
    Ok
    EmptyComposition
    DuplicateCapsule
    DuplicateFacet
    MissingFacet
    AmbiguousFacet
    DependencyCycle
    CapabilityDenied
    MemoryBudgetExceeded
    ConcurrencyRejected
    DynamicCriticalRejected
    EcsProfileRejected
    MigrationIncompatible
    IdentityMissing

    fn accepted() -> bool: self == MdsocppSealStatus.Ok

pub struct MdsocppFacetOfferV1:
    facet_id: KpfId128

pub struct MdsocppFacetRequirementV1:
    facet_id: KpfId128
    optional: bool

pub struct MdsocppStateMigrationV1:
    state_schema_id: KpfId128
    from_major: u32
    from_minor: u32
    to_major: u32
    to_minor: u32
    kind: MdsocppMigrationKind
    migration_operation_id: KpfId128

pub struct CapsuleDescriptorV1:
    capsule_id: KpfId128
    closure: MdsocppClosure
    provided_facets: [MdsocppFacetOfferV1]
    required_facets: [MdsocppFacetRequirementV1]
    required_capability_bits: u64
    memory: KpfMemoryContractV1
    concurrency: KpfConcurrencyContractV1
    uses_ecs: bool
    state_migrations: [MdsocppStateMigrationV1]

pub struct MdsocppSealPolicyV1:
    profile: MdsocppProfile
    critical: bool
    granted_capability_bits: u64
    memory_budget_bytes: u64
    maximum_concurrent_calls: u32
    generation: u64
    composition_digest: KpfDigest256

pub struct MdsocppFacetBindingV1:
    consumer_slot: u32
    provider_slot: u32
    facet_id: KpfId128

pub struct MdsocppGenerationReceiptV1:
    generation: u64
    composition_digest: KpfDigest256
    capsule_count: u32
    binding_count: u32
    total_memory_bytes: u64
    startup_slots: [u32]
    shutdown_slots: [u32]
    bindings: [MdsocppFacetBindingV1]

pub struct MdsocppSealResultV1:
    status: MdsocppSealStatus
    subject_slot: u32
    receipt: MdsocppGenerationReceiptV1
