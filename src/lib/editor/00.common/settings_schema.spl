# Editor Settings Schema
#
# UI metadata for every configurable editor field, expressed as
# `std.common.config_core` descriptors.
#
# This file used to own a `SettingDescriptor` record that was a strict subset of
# `ConfigFieldDescriptor` (its `setting_type` is that type's `value_type`), plus
# 24 hand-written descriptor literals that restated the key, type and default of
# fields `editor_config_schema()` / `platform_config_schema()` already declared,
# plus verbatim copies of `config_filter_by_category` / `config_filter_by_platform`
# / a descriptor search. All of that is deleted: the descriptors are now DERIVED
# from the loader schemas, so a default exists exactly once, and the filters come
# from the core.

use std.editor.common.config.{editor_config_schema}
use std.editor.common.platform.{platform_config_schema}
use std.common.config_core.schema.{ConfigFieldDescriptor, config_ui_field, config_with_ui}
use std.common.config_core.schema.{config_schema_index, config_filter_by_category}
use std.common.config_core.schema.{config_filter_by_platform, config_search}

# Decorate the loader descriptor for `key` with UI metadata.
#
# When the loader schema does not declare `key` the descriptor is UI-only: it
# describes a setting the settings panel lists but no layer can currently resolve
# (see `.spipe/ide_config_swap/state.md` §5 for the three such keys).
fn _setting(
    base: [ConfigFieldDescriptor],
    key: text,
    value_type: text,
    default_value: text,
    label: text,
    description: text,
    category: text,
    options: [text],
    platform: text
) -> ConfigFieldDescriptor:
    val idx = config_schema_index(base, key)
    if idx < 0:
        return config_ui_field(
            key: key,
            value_type: value_type,
            default_value: default_value,
            label: label,
            description: description,
            category: category,
            enum_options: options,
            platform: platform
        )
    config_with_ui(base[idx], label, description, category, options, platform)

fn editor_settings_schema() -> [ConfigFieldDescriptor]:
    val base = editor_config_schema()
    [
        _setting(base, "theme", "enum", "dark", "Theme", "Color theme for the editor", "Appearance", ["dark", "light", "solarized"], "all"),
        _setting(base, "font_size", "i64", "14", "Font Size", "Editor font size in points", "Appearance", [], "all"),
        _setting(base, "tab_size", "i64", "4", "Tab Size", "Number of spaces per tab stop", "Editor", [], "all"),
        _setting(base, "insert_spaces", "bool", "true", "Insert Spaces", "Insert spaces instead of tab characters", "Editor", [], "all"),
        _setting(base, "word_wrap", "bool", "false", "Word Wrap", "Wrap long lines at viewport edge", "Editor", [], "all"),
        _setting(base, "line_numbers", "bool", "true", "Line Numbers", "Show line numbers in the gutter", "Editor", [], "all"),
        _setting(base, "minimap", "bool", "false", "Minimap", "Show minimap overview of the file", "Appearance", [], "desktop"),
        _setting(base, "auto_save", "bool", "false", "Auto Save", "Automatically save files after changes", "Files", [], "all"),
        _setting(base, "auto_save_delay_ms", "i64", "30000", "Auto Save Delay", "Delay in milliseconds before auto-save triggers", "Files", [], "all"),
        _setting(base, "hover_delay_ms", "i64", "300", "Hover Delay", "Delay in milliseconds before LSP hover requests trigger", "Editor", [], "all"),
        # UI-only: no loader schema declares this key yet.
        _setting(base, "inlay_hint_refresh_delay_ms", "i64", "300", "Inlay Hint Refresh Delay", "Delay in milliseconds before edit-triggered inlay hint refresh requests trigger", "Editor", [], "all")
    ]

# Keybinding rows. The label is the bound command and the description is a
# mechanical rendering of the binding, so both are generated instead of restated.
fn _binding_setting(name: text, key_text: text, command: text) -> ConfigFieldDescriptor:
    config_ui_field(
        key: "bind." + name,
        value_type: "text",
        default_value: key_text,
        label: command,
        description: "Key: " + key_text + " → Command: " + command + " (mode: normal)",
        category: "Keybindings",
        enum_options: [],
        platform: "all"
    )

fn keybinding_settings_schema() -> [ConfigFieldDescriptor]:
    [
        _binding_setting("h", "h", "move-left"),
        _binding_setting("j", "j", "move-down"),
        _binding_setting("k", "k", "move-up"),
        _binding_setting("l", "l", "move-right"),
        _binding_setting("i", "i", "enter-insert"),
        _binding_setting("colon", ":", "enter-command"),
        _binding_setting("q", "q", "quit")
    ]

fn platform_settings_schema() -> [ConfigFieldDescriptor]:
    val base = platform_config_schema()
    [
        _setting(base, "max_open_files", "i64", "256", "Max Open Files", "Maximum number of files open simultaneously", "Platform", [], "all"),
        _setting(base, "max_undo_depth", "i64", "128", "Max Undo Depth", "Maximum number of undo steps retained", "Platform", [], "all"),
        _setting(base, "auto_save_interval_ms", "i64", "30000", "Auto Save Interval", "Interval in milliseconds between auto-save triggers", "Platform", [], "all"),
        _setting(base, "file_watcher_enabled", "bool", "true", "File Watcher", "Watch files for external changes on disk", "Platform", [], "desktop"),
        # UI-only: no loader schema declares these two keys yet.
        _setting(base, "file_watcher_debounce_ms", "i64", "2000", "File Watcher Debounce", "Minimum elapsed milliseconds before polling watched files again", "Platform", [], "desktop"),
        _setting(base, "file_watcher_ignore_globs", "text", ".git,node_modules,.simple-vault-search.cache", "File Watcher Ignore Globs", "Comma-separated file watcher ignore globs applied in addition to safe defaults", "Platform", [], "desktop")
    ]

fn full_settings_schema() -> [ConfigFieldDescriptor]:
    editor_settings_schema() + keybinding_settings_schema() + platform_settings_schema()

fn settings_categories() -> [text]:
    ["Editor", "Appearance", "Files", "Keybindings", "Platform"]

# Thin aliases kept so existing call sites read naturally; the implementations
# live in `std.common.config_core.schema`.
fn settings_filter_by_category(schema: [ConfigFieldDescriptor], category: text) -> [ConfigFieldDescriptor]:
    config_filter_by_category(schema, category)

fn settings_filter_by_platform(schema: [ConfigFieldDescriptor], platform: text) -> [ConfigFieldDescriptor]:
    config_filter_by_platform(schema, platform)

fn settings_search(schema: [ConfigFieldDescriptor], query: text) -> [ConfigFieldDescriptor]:
    config_search(schema, query)
