# Markdown Diagnostics
#
# Lint checks for markdown content: duplicate headings, broken anchor links,
# empty headings, inconsistent list markers, missing alt text, unclosed code
# fences, heading level skips, trailing whitespace, and broken local file links.
#
# NOTE: Checks that walk block structure skip content inside code fences to
# avoid false positives on example code embedded in documents.

use std.common.markdown.{markdown_slugify}
use std.editor.services.diagnostics.{EditorDiagnostic}
use std.editor.services.md_wiki_index.{MdWikiDocument, md_wiki_parse_link_target, md_wiki_target_exists, md_wiki_slug, md_wiki_title_from_path}
use std.common.diagnostics.{DiagnosticV1, DiagnosticBatchV1, BatchStatus, Severity, Span, DiagnosticFix, FixReplacement, FixConfidence, diagnostic_stable_id, LineStartTable}
use std.common.hash.xxh3.{xxh3_128_hex_text}

# Typed Markdown diagnostics ride the shared contract
# (`std.common.diagnostics`): one `DiagnosticV1` per finding with an MD1xxx
# code and a byte `Span` on the exact token; a safe one-token fix travels as
# `DiagnosticFix` with a single `FixReplacement`. Batches are
# `DiagnosticBatchV1` with the shared `BatchStatus` vocabulary.
# Codes (plan 2026-11-12): MD1001 broken local link, MD1002 unknown anchor,
# MD1003 unresolved wiki-link/embed, MD1004 duplicate heading, MD1005
# unclosed fence, MD1006 invalid frontmatter property, MD1101 missing image
# alt, MD1102 orphan document, MD1103 inconsistent heading/list structure,
# MD1104 unsafe/escaping path.

val MD_DIAG_PRODUCER: text = "md-lsp"

# Cross-file facts the caller already owns. `graph_complete` false means the
# workspace index is still being built: graph-derived codes (MD1003, MD1102)
# are withheld and the batch status is PartialRecovery, never a false orphan.
pub struct MdLinkContext:
    existing_files: [text]
    wiki_documents: [MdWikiDocument]
    graph_complete: bool
    has_inbound: bool

# Per-call span context. The lint checks measure columns in CODEPOINTS (text
# `len()`/slicing are codepoint-based); the shared Span wants BYTES, so each
# column is re-measured against its line here, once, at the lift boundary.
struct MdSpanCtx:
    table: LineStartTable
    lines: [text]
    path: text

fn _md_span_ctx(content: text, path: text) -> MdSpanCtx:
    MdSpanCtx(table: LineStartTable.build(content), lines: content.split("\n"), path: path)

fn _md_byte_col(ctx: MdSpanCtx, line: i64, col: i64) -> i64:
    if line < 0 or line >= ctx.lines.len():
        return col
    val text_line: text = ctx.lines[line]
    val cp_len = text_line.len()
    if col >= cp_len:
        val whole_bytes = text_line.byte_len()
        return whole_bytes + (col - cp_len)
    # Bound to a local on purpose: `.byte_len()` on a nested `slice()` result
    # fails in the seed interpreter ("method 'byte_len' not found on value of
    # type str in nested call context", observed 2026-11-12).
    val prefix: text = text_line.slice(0, col)
    prefix.byte_len()

# Codepoint span of a token on one line -> shared Span (1-based line/col,
# byte offsets relative to the document start).
fn _md_span(ctx: MdSpanCtx, line: i64, col: i64, end_col: i64) -> Span:
    val base = ctx.table.line_start(line)
    val bcol = _md_byte_col(ctx, line, col)
    var sp = Span.new(base + bcol, base + _md_byte_col(ctx, line, end_col), line + 1, bcol + 1)
    sp.file = ctx.path
    sp

fn _md_severity(name: text) -> Severity:
    if name == "error":
        return Severity.Error
    if name == "warning":
        return Severity.Warning
    Severity.Info

# Lifts one EditorDiagnostic (byte line/col/end_col) onto the shared type.
fn _md_lift(ctx: MdSpanCtx, d: EditorDiagnostic, code: text) -> DiagnosticV1:
    DiagnosticV1.new(_md_severity(d.severity), code, d.message).with_file(d.path).with_span(_md_span(ctx, d.line, d.col, d.end_col))

fn _md_with_fix(d: DiagnosticV1, path: text, description: text, new_text: text) -> DiagnosticV1:
    val sp = d.span.unwrap()
    var fix = DiagnosticFix.new("md:" + d.code + ":" + sp.start.to_text(), description, FixConfidence.Safe)
    fix.replacements = [FixReplacement.new(path, sp, new_text)]
    d.with_fix(fix)

fn _md_lift_all(ctx: MdSpanCtx, ds: [EditorDiagnostic], code: text) -> [DiagnosticV1]:
    var out: [DiagnosticV1] = []
    for d in ds:
        out.push(_md_lift(ctx, d, code))
    out

fn _md_push_all(dst: [DiagnosticV1], src: [DiagnosticV1]) -> [DiagnosticV1]:
    var out = dst
    for d in src:
        out.push(d)
    out

# Document-local typed checks (no cross-file knowledge needed).
pub fn md_diagnose_typed(content: text, path: text) -> [DiagnosticV1]:
    val ctx = _md_span_ctx(content, path)
    var out: [DiagnosticV1] = []
    out = _md_push_all(out, _md_lift_all(ctx, md_check_broken_heading_links(content, path), "MD1002"))
    out = _md_push_all(out, _md_lift_all(ctx, md_check_duplicate_headings(content, path), "MD1004"))
    out = _md_push_all(out, _md_lift_all(ctx, md_check_empty_headings(content, path), "MD1004"))
    out = _md_push_all(out, _md_lift_all(ctx, md_check_unclosed_code_fences(content, path), "MD1005"))
    out = _md_push_all(out, _md_lift_all(ctx, md_check_frontmatter_property_schema(content, path, []), "MD1006"))
    out = _md_push_all(out, _md_lift_all(ctx, md_check_missing_alt_text(content, path), "MD1101"))
    out = _md_push_all(out, _md_lift_all(ctx, md_check_heading_level_skip(content, path), "MD1103"))
    out = _md_push_all(out, _md_check_list_marker_typed(ctx, content, path))
    # Trailing single space: the safe fix deletes exactly that byte. Two or
    # more trailing spaces are a hard line break and are never reported.
    for d in md_check_trailing_whitespace(content, path):
        out.push(_md_with_fix(_md_lift(ctx, d, "MD1103"), path, "Remove trailing space", ""))
    out

# Full batch: local checks plus link/graph checks against the supplied context.
pub fn md_diagnose_batch(content: text, path: text, version: i64, link_ctx: MdLinkContext) -> DiagnosticBatchV1:
    val ctx = _md_span_ctx(content, path)
    val table = ctx.table
    var rows = md_diagnose_typed(content, path)
    rows = _md_push_all(rows, _md_check_local_links_typed(ctx, content, path, link_ctx.existing_files))
    var batch = DiagnosticBatchV1.new(MD_DIAG_PRODUCER, path, path, version, xxh3_128_hex_text(content), 0)
    if link_ctx.graph_complete:
        rows = _md_push_all(rows, _md_check_wiki_links_typed(ctx, content, path, link_ctx.wiki_documents))
        if not link_ctx.has_inbound:
            val first_len = if table.line_count() > 1 then table.line_start(1) - 1 else: table.byte_len
            rows.push(DiagnosticV1.new(Severity.Info, "MD1102", "Orphan document: no other document links here").with_file(path).with_span(_md_span(ctx, 0, 0, first_len)))
    else:
        batch = batch.with_status(BatchStatus.PartialRecovery, "workspace graph incomplete: MD1003/MD1102 withheld")
    var occurrence = 0
    for r in rows:
        val sp = r.span.unwrap()
        batch = batch.push(diagnostic_stable_id(r.code, path, "byte:" + sp.start.to_text(), occurrence), r)
        occurrence = occurrence + 1
    batch

# Outgoing link targets of a document, for the workspace graph: resolved
# workspace-relative local paths plus "wiki:<slug>" for [[..]] / ![[..]].
# Fenced text is skipped; absolute/escaping targets are not edges.
pub fn md_link_targets(content: text, path: text) -> [text]:
    var out: [text] = []
    for item in _md_diag_find_links_with_positions(content):
        val url = item.url
        if url.starts_with("http://") or url.starts_with("https://") or url.starts_with("#") or url.starts_with("mailto:") or url.len() == 0:
            continue
        val resolved = _md_diag_resolve_relative(path, _md_diag_strip_fragment(url))
        if resolved != "" and not out.contains(resolved):
            out.push(resolved)
    for target in _md_diag_wiki_targets(content):
        val key = "wiki:" + md_wiki_slug(target)
        if not out.contains(key):
            out.push(key)
    out

# The inbound key another document's targets would carry for `path`.
pub fn md_wiki_inbound_key(path: text) -> text:
    "wiki:" + md_wiki_slug(md_wiki_title_from_path(path))

# MD1103 for a mixed list marker, with the safe fix: replace the one marker
# byte with the marker the list started with.
fn _md_check_list_marker_typed(ctx: MdSpanCtx, content: text, path: text) -> [DiagnosticV1]:
    var results: [DiagnosticV1] = []
    if content.len() == 0:
        return results
    val lines = content.split("\n")
    var in_fence = false
    var list_marker = ""
    var i = 0
    while i < lines.len():
        val line = lines[i]
        val trimmed = line.trim()
        if trimmed.starts_with("```"):
            in_fence = not in_fence
            list_marker = ""
            i = i + 1
            continue
        if not in_fence:
            val marker = _md_diag_list_marker(trimmed)
            if marker != "":
                if list_marker == "":
                    list_marker = marker
                elif list_marker != marker:
                    val mcol = _md_diag_indent_width(line)
                    val d = DiagnosticV1.new(Severity.Info, "MD1103", "Inconsistent list marker: \"" + marker + "\" mixed with \"" + list_marker + "\"").with_file(path).with_span(_md_span(ctx, i, mcol, mcol + 1))
                    results.push(_md_with_fix(d, path, "Use the list's first marker", list_marker))
            elif trimmed.len() == 0:
                list_marker = ""
        i = i + 1
    results

# MD1001 (target missing) / MD1104 (target escapes the workspace root) for
# [text](relative/path) links, resolved relative to the document's directory.
fn _md_check_local_links_typed(ctx: MdSpanCtx, content: text, path: text, existing_files: [text]) -> [DiagnosticV1]:
    var results: [DiagnosticV1] = []
    if content.len() == 0:
        return results
    val lines = content.split("\n")
    for item in _md_diag_find_links_with_positions(content):
        val url = item.url
        if url.starts_with("http://") or url.starts_with("https://") or url.starts_with("#") or url.starts_with("mailto:") or url.len() == 0:
            continue
        val local_path = _md_diag_strip_fragment(url)
        var end_col = item.end_col
        if item.line < lines.len() and end_col > lines[item.line].len():
            end_col = lines[item.line].len()
        val sp = _md_span(ctx, item.line, item.col, end_col)
        val resolved = _md_diag_resolve_relative(path, local_path)
        if resolved == "":
            results.push(DiagnosticV1.new(Severity.Error, "MD1104", "Link target escapes the workspace root: \"" + local_path + "\"").with_file(path).with_span(sp))
            continue
        var found = false
        for f in existing_files:
            if f == resolved or f == local_path:
                found = true
                break
        if not found:
            results.push(DiagnosticV1.new(Severity.Warning, "MD1001", "Local link target not found: \"" + local_path + "\"").with_file(path).with_span(sp))
    results

# MD1003 for [[target]] and ![[target]] whose target is not in the supplied
# document set. Fenced text is skipped.
fn _md_check_wiki_links_typed(ctx: MdSpanCtx, content: text, path: text, documents: [MdWikiDocument]) -> [DiagnosticV1]:
    var results: [DiagnosticV1] = []
    val lines = content.split("\n")
    var in_fence = false
    var line_idx = 0
    while line_idx < lines.len():
        val line = lines[line_idx]
        if line.trim().starts_with("```"):
            in_fence = not in_fence
            line_idx = line_idx + 1
            continue
        if not in_fence:
            var col = 0
            while col + 1 < line.len():
                if line.slice(col, col + 2) == "[[":
                    val close = _md_diag_find_text(line, "]]", col + 2)
                    if close < 0:
                        break
                    val is_embed = col > 0 and line[col - 1:col] == "!"
                    val start_col = if is_embed then col - 1 else: col
                    val parsed = md_wiki_parse_link_target(line.slice(col + 2, close))
                    if parsed.0.len() > 0 and not md_wiki_target_exists(documents, parsed.0):
                        val kind = if is_embed then "embed" else: "wiki link"
                        results.push(DiagnosticV1.new(Severity.Warning, "MD1003", "Unresolved " + kind + ": \"" + parsed.0 + "\"").with_file(path).with_span(_md_span(ctx, line_idx, start_col, close + 2)))
                    col = close + 2
                else:
                    col = col + 1
        line_idx = line_idx + 1
    results

# Raw [[target]] / ![[target]] targets outside fences (no resolution).
fn _md_diag_wiki_targets(content: text) -> [text]:
    var out: [text] = []
    var in_fence = false
    for line in content.split("\n"):
        if line.trim().starts_with("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        var col = 0
        while col + 1 < line.len():
            if line.slice(col, col + 2) == "[[":
                val close = _md_diag_find_text(line, "]]", col + 2)
                if close < 0:
                    break
                val parsed = md_wiki_parse_link_target(line.slice(col + 2, close))
                if parsed.0.len() > 0:
                    out.push(parsed.0)
                col = close + 2
            else:
                col = col + 1
    out

fn _md_diag_resolve_relative(doc_path: text, target: text) -> text:
    if target.starts_with("/") or target.starts_with("\\"):
        return ""
    if target.len() >= 2 and target[1:2] == ":":
        return ""
    var segs: [text] = []
    val slash = _md_diag_last_char(doc_path, "/")
    if slash >= 0:
        for s in doc_path.slice(0, slash).split("/"):
            if s.len() > 0:
                segs.push(s)
    for s in target.split("/"):
        if s == "" or s == ".":
            continue
        if s == "..":
            if segs.len() == 0:
                return ""
            segs.pop()
        else:
            segs.push(s)
    segs.join("/")

fn _md_diag_last_char(haystack: text, needle: text) -> i64:
    var i = haystack.len() - 1
    while i >= 0:
        if haystack[i:i + 1] == needle:
            return i
        i = i - 1
    -1

fn _md_diag_find_text(haystack: text, needle: text, start: i64) -> i64:
    var i = start
    while i + needle.len() <= haystack.len():
        if haystack.slice(i, i + needle.len()) == needle:
            return i
        i = i + 1
    -1

fn _md_diag_indent_width(line: text) -> i64:
    var i = 0
    while i < line.len() and (line[i:i + 1] == " " or line[i:i + 1] == "\t"):
        i = i + 1
    i

struct MdPropertySchemaRule:
    key: text
    required: bool
    allowed_values: [text]

# Position of a link/image reference in a document.  A struct rather than a
# 4-tuple: mixed-type 4-tuple element access (.2/.3) returns corrupted values
# in the interpreter (see bug md_diag_tuple_element_corruption).
struct MdDiagLinkRef:
    line: i64
    col: i64
    end_col: i64
    label: text
    url: text

fn md_diagnose(content: text, path: text) -> [EditorDiagnostic]:
    var results: [EditorDiagnostic] = []
    val dup = md_check_duplicate_headings(content, path)
    for d in dup:
        results.push(d)
    val broken = md_check_broken_heading_links(content, path)
    for d in broken:
        results.push(d)
    val empty = md_check_empty_headings(content, path)
    for d in empty:
        results.push(d)
    val markers = md_check_inconsistent_list_markers(content, path)
    for d in markers:
        results.push(d)
    val alt = md_check_missing_alt_text(content, path)
    for d in alt:
        results.push(d)
    val fences = md_check_unclosed_code_fences(content, path)
    for d in fences:
        results.push(d)
    val skip = md_check_heading_level_skip(content, path)
    for d in skip:
        results.push(d)
    val trailing = md_check_trailing_whitespace(content, path)
    for d in trailing:
        results.push(d)
    results

fn md_property_schema_rule(key: text, required: bool, allowed_values: [text]) -> MdPropertySchemaRule:
    MdPropertySchemaRule(key: key, required: required, allowed_values: allowed_values)

fn md_check_frontmatter_property_schema(content: text, path: text, rules: [MdPropertySchemaRule]) -> [EditorDiagnostic]:
    var results: [EditorDiagnostic] = []
    val lines = content.split("\n")
    if lines.len() == 0 or lines[0].trim() != "---":
        for rule in rules:
            if rule.required:
                results.push(EditorDiagnostic(
                    path: path,
                    line: 0,
                    col: 0,
                    end_line: 0,
                    end_col: 0,
                    severity: "warning",
                    message: "Missing required frontmatter property: " + rule.key,
                    source: "markdown-properties"
                ))
        return results
    var keys: [text] = []
    var values: [text] = []
    var prop_lines: [i64] = []
    var i = 1
    while i < lines.len():
        val trimmed = lines[i].trim()
        if trimmed == "---":
            break
        val sep = _md_diag_find_char(trimmed, ":", 0)
        if sep > 0:
            val key = trimmed.slice(0, sep).trim()
            val value = trimmed.slice(sep + 1, trimmed.len()).trim()
            keys.push(key)
            values.push(value)
            prop_lines.push(i)
            if _md_diag_property_seen_before(keys, key, keys.len() - 1):
                results.push(EditorDiagnostic(
                    path: path,
                    line: i,
                    col: 0,
                    end_line: i,
                    end_col: lines[i].len(),
                    severity: "warning",
                    message: "Duplicate frontmatter property: " + key,
                    source: "markdown-properties"
                ))
        i = i + 1
    for rule in rules:
        var found = false
        var j = 0
        while j < keys.len():
            if keys[j] == rule.key:
                found = true
                if rule.required and values[j] == "":
                    results.push(EditorDiagnostic(
                        path: path,
                        line: prop_lines[j],
                        col: 0,
                        end_line: prop_lines[j],
                        end_col: lines[prop_lines[j]].len(),
                        severity: "warning",
                        message: "Frontmatter property requires a value: " + rule.key,
                        source: "markdown-properties"
                    ))
                if rule.allowed_values.len() > 0 and not _md_diag_value_allowed(values[j], rule.allowed_values):
                    results.push(EditorDiagnostic(
                        path: path,
                        line: prop_lines[j],
                        col: 0,
                        end_line: prop_lines[j],
                        end_col: lines[prop_lines[j]].len(),
                        severity: "warning",
                        message: "Invalid frontmatter value for " + rule.key + ": " + values[j],
                        source: "markdown-properties"
                    ))
                break
            j = j + 1
        if not found and rule.required:
            results.push(EditorDiagnostic(
                path: path,
                line: 0,
                col: 0,
                end_line: 0,
                end_col: 0,
                severity: "warning",
                message: "Missing required frontmatter property: " + rule.key,
                source: "markdown-properties"
            ))
    results

fn md_check_duplicate_headings(content: text, path: text) -> [EditorDiagnostic]:
    var results: [EditorDiagnostic] = []
    if content.len() == 0:
        return results
    val lines = content.split("\n")
    val total = lines.len()
    # Collect (level, text, line_number) for all headings outside code fences
    var heading_levels: [i64] = []
    var heading_texts: [text] = []
    var heading_lines: [i64] = []
    var in_fence = false
    var i = 0
    while i < total:
        val line = lines[i]
        val trimmed = line.trim()
        if trimmed.starts_with("```"):
            if in_fence:
                in_fence = false
            else:
                in_fence = true
            i = i + 1
            continue
        if not in_fence:
            val lvl = _md_diag_heading_level(line)
            if lvl > 0:
                val htext = _md_diag_heading_text(line, lvl)
                heading_levels.push(lvl)
                heading_texts.push(htext)
                heading_lines.push(i)
        i = i + 1
    # For each heading, check if an earlier heading has same level and text
    var j = 0
    while j < heading_texts.len():
        val cur_lvl = heading_levels[j]
        val cur_text = heading_texts[j]
        val cur_line = heading_lines[j]
        var k = 0
        while k < j:
            if heading_levels[k] == cur_lvl and heading_texts[k] == cur_text:
                # Exact token: the heading text after "#... ", not the marker.
                var text_col = cur_lvl + 1
                if text_col > lines[cur_line].len():
                    text_col = lines[cur_line].len()
                val d = EditorDiagnostic(
                    path: path,
                    line: cur_line,
                    col: text_col,
                    end_line: cur_line,
                    end_col: lines[cur_line].len(),
                    severity: "warning",
                    message: "Duplicate heading: \"" + cur_text + "\" at level " + cur_lvl.to_text(),
                    source: "markdown"
                )
                results.push(d)
                break
            k = k + 1
        j = j + 1
    results

fn md_check_broken_heading_links(content: text, path: text) -> [EditorDiagnostic]:
    var results: [EditorDiagnostic] = []
    if content.len() == 0:
        return results
    val lines = content.split("\n")
    val total = lines.len()
    # Collect valid heading slugs
    var valid_slugs: [text] = []
    var in_fence = false
    var i = 0
    while i < total:
        val line = lines[i]
        val trimmed = line.trim()
        if trimmed.starts_with("```"):
            if in_fence:
                in_fence = false
            else:
                in_fence = true
            i = i + 1
            continue
        if not in_fence:
            val lvl = _md_diag_heading_level(line)
            if lvl > 0:
                val htext = _md_diag_heading_text(line, lvl)
                val slug = markdown_slugify(htext)
                valid_slugs.push(slug)
        i = i + 1
    # Find all links with # prefix in URL and check against valid slugs
    val link_positions = _md_diag_find_links_with_positions(content)
    var j = 0
    while j < link_positions.len():
        val item = link_positions[j]
        val link_line = item.line
        val link_col = item.col
        val link_url = item.url
        if link_url.starts_with("#"):
            val anchor = link_url.slice(1, link_url.len())
            var found = false
            var k = 0
            while k < valid_slugs.len():
                if valid_slugs[k] == anchor:
                    found = true
                    break
                k = k + 1
            if not found:
                # Exact token span: the parser records the byte after ")".
                var end_col = item.end_col
                if link_line < lines.len():
                    var line_len = lines[link_line].len()
                    if end_col > line_len:
                        end_col = line_len
                var diag_msg = "Broken heading anchor: \"" + link_url + "\" does not match any heading"
                val d = EditorDiagnostic(
                    path: path,
                    line: link_line,
                    col: link_col,
                    end_line: link_line,
                    end_col: end_col,
                    severity: "error",
                    message: diag_msg,
                    source: "markdown"
                )
                results.push(d)
        j = j + 1
    results

fn md_check_empty_headings(content: text, path: text) -> [EditorDiagnostic]:
    var results: [EditorDiagnostic] = []
    if content.len() == 0:
        return results
    val lines = content.split("\n")
    val total = lines.len()
    var in_fence = false
    var i = 0
    while i < total:
        val line = lines[i]
        val trimmed = line.trim()
        if trimmed.starts_with("```"):
            if in_fence:
                in_fence = false
            else:
                in_fence = true
            i = i + 1
            continue
        if not in_fence:
            val lvl = _md_diag_heading_level(line)
            if lvl > 0:
                val htext = _md_diag_heading_text(line, lvl)
                val htrimmed = htext.trim()
                if htrimmed.len() == 0:
                    val d = EditorDiagnostic(
                        path: path,
                        line: i,
                        col: 0,
                        end_line: i,
                        end_col: line.len(),
                        severity: "warning",
                        message: "Empty heading at level " + lvl.to_text(),
                        source: "markdown"
                    )
                    results.push(d)
        i = i + 1
    results

fn md_check_inconsistent_list_markers(content: text, path: text) -> [EditorDiagnostic]:
    var results: [EditorDiagnostic] = []
    if content.len() == 0:
        return results
    val lines = content.split("\n")
    val total = lines.len()
    var in_fence = false
    # Track the first marker seen in the current list block
    var list_marker = ""
    var list_start_line = 0
    var i = 0
    while i < total:
        val line = lines[i]
        val trimmed = line.trim()
        if trimmed.starts_with("```"):
            if in_fence:
                in_fence = false
            else:
                in_fence = true
                list_marker = ""
            i = i + 1
            continue
        if not in_fence:
            val marker = _md_diag_list_marker(trimmed)
            if marker != "":
                if list_marker == "":
                    list_marker = marker
                    list_start_line = i
                elif list_marker != marker:
                    val d = EditorDiagnostic(
                        path: path,
                        line: i,
                        col: 0,
                        end_line: i,
                        end_col: line.len(),
                        severity: "hint",
                        message: "Inconsistent list marker: \"" + marker + "\" mixed with \"" + list_marker + "\" (first used at line " + (list_start_line + 1).to_text() + ")",
                        source: "markdown"
                    )
                    results.push(d)
            else:
                if trimmed.len() == 0:
                    list_marker = ""
        i = i + 1
    results

fn md_check_missing_alt_text(content: text, path: text) -> [EditorDiagnostic]:
    var results: [EditorDiagnostic] = []
    if content.len() == 0:
        return results
    val image_positions = _md_diag_find_images_with_positions(content)
    for item in image_positions:
        var diag_line = item.line
        var diag_col = item.col
        var alt_text = item.label
        var alt_len = alt_text.trim().len()
        if alt_len == 0:
            # Exact token span: the parser records the byte after ")".
            var end_col = item.end_col
            val img_lines = content.split("\n")
            var img_line_count = img_lines.len()
            if diag_line < img_line_count:
                var img_line_text = img_lines[diag_line]
                var img_line_len = img_line_text.len()
                if end_col > img_line_len:
                    end_col = img_line_len
            val d = EditorDiagnostic(
                path: path,
                line: diag_line,
                col: diag_col,
                end_line: diag_line,
                end_col: end_col,
                severity: "info",
                message: "Image is missing alt text",
                source: "markdown"
            )
            results.push(d)
    results

fn md_check_unclosed_code_fences(content: text, path: text) -> [EditorDiagnostic]:
    var results: [EditorDiagnostic] = []
    if content.len() == 0:
        return results
    val lines = content.split("\n")
    val total = lines.len()
    var in_fence = false
    var fence_start_line = 0
    var i = 0
    while i < total:
        val line = lines[i]
        val trimmed = line.trim()
        if trimmed.starts_with("```"):
            if in_fence:
                in_fence = false
            else:
                in_fence = true
                fence_start_line = i
        i = i + 1
    if in_fence:
        # fence_start_line is always < total because we set it during the scan
        val fence_end_col = if fence_start_line < total then lines[fence_start_line].len() else: 0
        val d = EditorDiagnostic(
            path: path,
            line: fence_start_line,
            col: 0,
            end_line: fence_start_line,
            end_col: fence_end_col,
            severity: "error",
            message: "Unclosed code fence starting here",
            source: "markdown"
        )
        results.push(d)
    results

fn md_check_heading_level_skip(content: text, path: text) -> [EditorDiagnostic]:
    var results: [EditorDiagnostic] = []
    if content.len() == 0:
        return results
    val lines = content.split("\n")
    val total = lines.len()
    var in_fence = false
    var prev_level = 0
    var i = 0
    while i < total:
        val line = lines[i]
        val trimmed = line.trim()
        if trimmed.starts_with("```"):
            if in_fence:
                in_fence = false
            else:
                in_fence = true
            i = i + 1
            continue
        if not in_fence:
            val lvl = _md_diag_heading_level(line)
            if lvl > 0:
                if prev_level > 0 and lvl > prev_level + 1:
                    val d = EditorDiagnostic(
                        path: path,
                        line: i,
                        col: 0,
                        end_line: i,
                        end_col: line.len(),
                        severity: "warning",
                        message: "Heading level skip: jumped from h" + prev_level.to_text() + " to h" + lvl.to_text(),
                        source: "markdown"
                    )
                    results.push(d)
                prev_level = lvl
        i = i + 1
    results

fn md_check_trailing_whitespace(content: text, path: text) -> [EditorDiagnostic]:
    # Flag lines that end with exactly 1 trailing space.
    # Lines ending with 2+ trailing spaces are intentional hard line breaks in markdown.
    var results: [EditorDiagnostic] = []
    if content.len() == 0:
        return results
    val lines = content.split("\n")
    val total = lines.len()
    var i = 0
    while i < total:
        val line = lines[i]
        val line_len = line.len()
        if line_len > 0 and line[line_len - 1:line_len - 1 + 1] == " ":
            val trailing = _md_diag_count_trailing_spaces(line)
            if trailing == 1:
                val d = EditorDiagnostic(
                    path: path,
                    line: i,
                    col: line_len - 1,
                    end_line: i,
                    end_col: line_len,
                    severity: "hint",
                    message: "Trailing whitespace",
                    source: "markdown"
                )
                results.push(d)
        i = i + 1
    results

fn md_validate_local_links(content: text, path: text, existing_files: [text]) -> [EditorDiagnostic]:
    var results: [EditorDiagnostic] = []
    if content.len() == 0:
        return results
    val lines = content.split("\n")
    val link_positions = _md_diag_find_links_with_positions(content)
    var i = 0
    while i < link_positions.len():
        val item = link_positions[i]
        val link_line = item.line
        val link_col = item.col
        val link_url = item.url
        # Skip http/https links, anchors, mailto, and empty urls
        val is_external = (
            link_url.starts_with("http://") or
            link_url.starts_with("https://") or
            link_url.starts_with("#") or
            link_url.starts_with("mailto:") or
            link_url.len() == 0
        )
        if not is_external:
            # Strip anchor fragment from local path
            val local_path = _md_diag_strip_fragment(link_url)
            var found = false
            var k = 0
            while k < existing_files.len():
                if existing_files[k] == local_path:
                    found = true
                    break
                k = k + 1
            if not found:
                var link_end_col = item.end_col
                if link_line < lines.len():
                    val llen = lines[link_line].len()
                    if link_end_col > llen:
                        link_end_col = llen
                val d = EditorDiagnostic(
                    path: path,
                    line: link_line,
                    col: link_col,
                    end_line: link_line,
                    end_col: link_end_col,
                    severity: "warning",
                    message: "Local link target not found: \"" + local_path + "\"",
                    source: "markdown"
                )
                results.push(d)
        i = i + 1
    results

# =============================================================================
# Private Helpers
# =============================================================================

fn _md_diag_find_links_with_positions(content: text) -> [MdDiagLinkRef]:
    # Returns line/col/display_text/url for each [text](url) link in content.
    # Does not descend into code fences.
    var results: [MdDiagLinkRef] = []
    val lines = content.split("\n")
    val total = lines.len()
    var in_fence = false
    var line_idx = 0
    while line_idx < total:
        val line = lines[line_idx]
        val trimmed = line.trim()
        if trimmed.starts_with("```"):
            if in_fence:
                in_fence = false
            else:
                in_fence = true
            line_idx = line_idx + 1
            continue
        if not in_fence:
            var col = 0
            val line_len = line.len()
            while col < line_len:
                val ch = line[col:col + 1]
                # Detect image prefix to skip (handled separately)
                var is_image = false
                if col > 0 and line[col - 1:col - 1 + 1] == "!":
                    is_image = true
                if ch == "[" and not is_image:
                    val link_start_col = col
                    # Extract display text
                    var display = ""
                    # Whole-SPAN label extraction (per-byte appends corrupt
                    # multi-byte labels under the interpreter — its Rust
                    # Strings turn mid-codepoint 1-byte slices into U+FFFD).
                    # The span up to the depth-0 "]" includes nested
                    # brackets exactly like the old per-char append did.
                    var j = col + 1
                    var depth = 1
                    val label_start = j
                    while j < line_len and depth > 0:
                        val c = line[j:j + 1]
                        if c == "[":
                            depth = depth + 1
                        elif c == "]":
                            depth = depth - 1
                            if depth == 0:
                                break
                        j = j + 1
                    display = display + line[label_start:j]
                    # j should now point at ']'
                    if j < line_len and line[j:j + 1] == "]":
                        val after_bracket = j + 1
                        if after_bracket < line_len and line[after_bracket:after_bracket + 1] == "(":
                            # Whole-SPAN url extraction (interpreter
                            # per-byte U+FFFD hazard; URLs can be
                            # non-ASCII).
                            var url = ""
                            var k = after_bracket + 1
                            while k < line_len and line[k:k + 1] != ")":
                                k = k + 1
                            url = url + line[after_bracket + 1:k]
                            # Strip optional title from url
                            val url_clean = _md_diag_strip_url_title(url)
                            val entry = MdDiagLinkRef(line: line_idx, col: link_start_col, end_col: k + 1, label: display, url: url_clean)
                            results.push(entry)
                            col = k + 1
                            continue
                col = col + 1
        line_idx = line_idx + 1
    results

fn _md_diag_find_images_with_positions(content: text) -> [MdDiagLinkRef]:
    # Returns line/col/alt_text/url for each ![alt](url) image in content.
    # Does not descend into code fences.
    var results: [MdDiagLinkRef] = []
    val lines = content.split("\n")
    val total = lines.len()
    var in_fence = false
    var line_idx = 0
    while line_idx < total:
        val line = lines[line_idx]
        val trimmed = line.trim()
        if trimmed.starts_with("```"):
            if in_fence:
                in_fence = false
            else:
                in_fence = true
            line_idx = line_idx + 1
            continue
        if not in_fence:
            var col = 0
            val line_len = line.len()
            while col < line_len:
                val ch = line[col:col + 1]
                if ch == "!" and col + 1 < line_len and line[col + 1:col + 1 + 1] == "[":
                    val img_start_col = col
                    # Extract alt text
                    # Whole-SPAN alt-text extraction (same interpreter
                    # per-byte U+FFFD hazard).
                    var alt = ""
                    var j = col + 2
                    while j < line_len and line[j:j + 1] != "]":
                        j = j + 1
                    alt = alt + line[col + 2:j]
                    # j should point at ']'
                    if j < line_len and line[j:j + 1] == "]":
                        val after_bracket = j + 1
                        if after_bracket < line_len and line[after_bracket:after_bracket + 1] == "(":
                            # Whole-SPAN url extraction (interpreter
                            # per-byte U+FFFD hazard; URLs can be
                            # non-ASCII).
                            var url = ""
                            var k = after_bracket + 1
                            while k < line_len and line[k:k + 1] != ")":
                                k = k + 1
                            url = url + line[after_bracket + 1:k]
                            # Inline url title strip: take url up to first space
                            var url_clean = url
                            var ui = 0
                            while ui < url.len() and url[ui:ui + 1] != " ":
                                ui = ui + 1
                            url_clean = url.slice(0, ui).trim()
                            val img_entry = MdDiagLinkRef(line: line_idx, col: img_start_col, end_col: k + 1, label: alt, url: url_clean)
                            results.push(img_entry)
                            col = k + 1
                            continue
                col = col + 1
        line_idx = line_idx + 1
    results

fn _md_diag_heading_level(line: text) -> i64:
    # Returns 1-6 for heading lines, 0 for non-headings.
    var count = 0
    val line_len = line.len()
    while count < line_len and count < 6:
        if line[count:count + 1] == "#":
            count = count + 1
        else:
            break
    if count == 0:
        return 0
    # Must be followed by a space or end of line
    if count < line_len and line[count:count + 1] != " ":
        return 0
    count

fn _md_diag_heading_text(line: text, level: i64) -> text:
    # Returns the text after "### " for a heading line.
    val line_len = line.len()
    var start = level
    # Skip the space after hashes
    if start < line_len and line[start:start + 1] == " ":
        start = start + 1
    if start >= line_len:
        return ""
    line.slice(start, line_len)

fn _md_diag_list_marker(trimmed: text) -> text:
    # Returns "-", "*", or "+" if the trimmed line starts an unordered list item.
    # Returns "" otherwise.
    if trimmed.len() == 0:
        return ""
    val first = trimmed[0:0 + 1]
    if first == "-" or first == "*" or first == "+":
        if trimmed.len() == 1 or trimmed[1:1 + 1] == " ":
            return first
    ""

fn _md_diag_count_trailing_spaces(line: text) -> i64:
    var count = 0
    var i = line.len() - 1
    while i >= 0 and line[i:i + 1] == " ":
        count = count + 1
        i = i - 1
    count

fn _md_diag_strip_url_title(url: text) -> text:
    # Strips optional title like: url "title" or url 'title'
    # Returns just the url portion (up to the first space).
    var i = 0
    val url_len = url.len()
    while i < url_len and url[i:i + 1] != " ":
        i = i + 1
    url.slice(0, i).trim()

fn _md_diag_strip_fragment(url: text) -> text:
    # Returns url with #fragment removed.
    var i = 0
    val url_len = url.len()
    while i < url_len:
        if url[i:i + 1] == "#":
            return url.slice(0, i)
        i = i + 1
    url

fn _md_diag_find_char(haystack: text, needle: text, start: i64) -> i64:
    var i = start
    while i < haystack.len():
        if haystack[i:i + 1] == needle:
            return i
        i = i + 1
    -1

fn _md_diag_property_seen_before(keys: [text], key: text, before: i64) -> bool:
    var i = 0
    while i < before:
        if keys[i] == key:
            return true
        i = i + 1
    false

fn _md_diag_value_allowed(value: text, allowed: [text]) -> bool:
    for item in allowed:
        if value == item:
            return true
    false
