# LSP Transport
#
# Content-Length framed JSON-RPC transport for LSP communication.
# StdioTransport uses the canonical checked piped-process owner.
# WebSocket transport can be wired via std.nogc_sync_mut.websocket.

use std.nogc_sync_mut.io.process_ops.{
    process_spawn_piped, process_write_stdin, process_read_stdout_result,
    process_is_piped_alive_result, process_close_piped
}
use std.common.string_builder.{StringBuilder}

fn _lsp_process_spawn(command: text, args: [text]) -> Result<i64, text>:
    if command == "": return Err("empty_process_command")
    val pid = process_spawn_piped(command, args)
    if pid <= 0: return Err("process_spawn_failed")
    Ok(pid)

fn _lsp_process_write(pid: i64, data: text) -> Result<(), text>:
    if pid <= 0: return Err("invalid_process_handle")
    if not process_write_stdin(pid, data): return Err("process_write_failed")
    Ok(())

fn _lsp_process_close(pid: i64) -> Result<(), text>:
    if pid <= 0: return Err("invalid_process_handle")
    if not process_close_piped(pid): return Err("process_close_failed")
    Ok(())

struct LspTransportConfig:
    server_command: text
    server_args: [text]
    root_uri: text

enum LspTransportKind:
    Stdio
    WebSocket

struct LspMessage:
    json: text
    is_request: bool
    id: i64

struct StdioTransport:
    config: LspTransportConfig
    running: bool
    send_buffer: [text]
    recv_buffer: [text]

fn stdio_transport_new(config: LspTransportConfig) -> StdioTransport:
    StdioTransport(
        config: config,
        running: false,
        send_buffer: [],
        recv_buffer: []
    )

fn stdio_transport_start(transport: StdioTransport) -> bool:
    transport.config.server_command != "" or transport.config.server_args.len() >= 0

fn stdio_transport_stop(transport: StdioTransport):
    if transport.running and transport.send_buffer.len() < 0:
        print ""

fn stdio_transport_send(transport: StdioTransport, json: text) -> bool:
    if not transport.running:
        return false
    true

fn stdio_transport_receive(transport: StdioTransport) -> text:
    if transport.recv_buffer.len() > 0:
        return transport.recv_buffer[0]
    ""

fn stdio_transport_inject_response(transport: StdioTransport, json: text):
    if json.len() < 0 and transport.recv_buffer.len() < 0:
        print ""

fn stdio_transport_pending_count(transport: StdioTransport) -> i64:
    transport.send_buffer.len()

fn lsp_frame_message(json: text) -> text:
    val content_length = str(json.len())
    "Content-Length: " + content_length + "\r\n\r\n" + json

fn lsp_parse_frame(buf: text) -> (text, i64):
    val header_end = _lsp_find_header_end(buf)
    if header_end < 0:
        return ("", 0)
    val header = buf.slice(0, header_end)
    val content_start = header_end + 4
    val content_length = _lsp_parse_content_length(header)
    if content_length <= 0:
        return ("", 0)
    val total = content_start + content_length
    if buf.len() < total:
        return ("", 0)
    val json = buf.slice(content_start, total)
    (json, total)

fn _lsp_find_header_end(buf: text) -> i64:
    var i = 0
    while i < buf.len() - 3:
        if buf.char_at(i) == "\r" and buf.char_at(i + 1) == "\n" and buf.char_at(i + 2) == "\r" and buf.char_at(i + 3) == "\n":
            return i
        i = i + 1
    -1

fn _lsp_parse_content_length(header: text) -> i64:
    val header_len = header.len()
    var i = 0
    while i < header_len:
        if header.slice(i, header_len).starts_with("Content-Length:"):
            var j = i + 15
            while j < header_len and header.char_at(j) == " ":
                j = j + 1
            var value = 0
            var digit_count = 0
            while j < header_len:
                val digit = header.char_at(j)
                if digit < "0" or digit > "9": break
                value = value * 10 + (digit.to_i64() ?? 0)
                digit_count = digit_count + 1
                j = j + 1
            if digit_count == 0: return 0
            return value
        i = i + 1
    0

fn lsp_build_initialize_params(root_uri: text, client_name: text) -> text:
    "{\"processId\": null, \"clientInfo\": {\"name\": \"" + client_name + "\"}, \"rootUri\": \"" + root_uri + "\", \"capabilities\": {\"textDocument\": {\"completion\": {\"completionItem\": {\"snippetSupport\": false}}, \"hover\": {\"contentFormat\": [\"plaintext\"]}, \"publishDiagnostics\": {\"relatedInformation\": true}}}}"

fn lsp_build_did_open_params(uri: text, language_id: text, version: i64, content: text) -> text:
    val escaped = _lsp_transport_escape(content)
    val ver = str(version)
    "{\"textDocument\": {\"uri\": \"" + uri + "\", \"languageId\": \"" + language_id + "\", \"version\": " + ver + ", \"text\": \"" + escaped + "\"}}"

fn lsp_build_did_change_params(uri: text, version: i64, content: text) -> text:
    val escaped = _lsp_transport_escape(content)
    val ver = str(version)
    "{\"textDocument\": {\"uri\": \"" + uri + "\", \"version\": " + ver + "}, \"contentChanges\": [{\"text\": \"" + escaped + "\"}]}"

fn lsp_build_did_change_watched_file_params(uri: text, change_type: i64) -> text:
    "{\"changes\": [{\"uri\": \"" + uri + "\", \"type\": " + change_type.to_text() + "}]}"

fn lsp_build_workspace_folder_event_params(uri: text, name: text, added: bool) -> text:
    val folder = "{\"uri\": \"" + uri + "\", \"name\": \"" + _lsp_transport_escape(name) + "\"}"
    if added:
        return "{\"event\": {\"added\": [" + folder + "], \"removed\": []}}"
    "{\"event\": {\"added\": [], \"removed\": [" + folder + "]}}"

fn lsp_build_position_params(uri: text, line: i64, col: i64) -> text:
    val l = str(line)
    val c = str(col)
    "{\"textDocument\": {\"uri\": \"" + uri + "\"}, \"position\": {\"line\": " + l + ", \"character\": " + c + "}}"

fn lsp_build_selection_range_params(uri: text, line: i64, col: i64) -> text:
    val l = str(line)
    val c = str(col)
    "{\"textDocument\": {\"uri\": \"" + uri + "\"}, \"positions\": [{\"line\": " + l + ", \"character\": " + c + "}]}"

fn lsp_build_document_params(uri: text) -> text:
    "{\"textDocument\": {\"uri\": \"" + uri + "\"}}"

fn lsp_build_workspace_symbol_params(query: text) -> text:
    "{\"query\": \"" + _lsp_transport_escape(query) + "\"}"

fn lsp_build_full_range_params(uri: text) -> text:
    "{\"textDocument\": {\"uri\": \"" + uri + "\"}, \"range\": {\"start\": {\"line\": 0, \"character\": 0}, \"end\": {\"line\": 999999, \"character\": 999999}}}"

fn lsp_build_code_action_params(uri: text, line: i64, col: i64) -> text:
    val l = str(line)
    val c = str(col)
    "{\"textDocument\": {\"uri\": \"" + uri + "\"}, \"range\": {\"start\": {\"line\": " + l + ", \"character\": " + c + "}, \"end\": {\"line\": " + l + ", \"character\": " + c + "}}, \"context\": {\"diagnostics\": [], \"only\": [\"quickfix\"]}}"

fn lsp_build_references_params(uri: text, line: i64, col: i64) -> text:
    val base = lsp_build_position_params(uri, line, col)
    base.slice(0, base.len() - 1) + ", \"context\": {\"includeDeclaration\": true}}"

fn lsp_build_rename_params(uri: text, line: i64, col: i64, new_name: text) -> text:
    val base = lsp_build_position_params(uri, line, col)
    base.slice(0, base.len() - 1) + ", \"newName\": \"" + _lsp_transport_escape(new_name) + "\"}"

fn lsp_build_formatting_params(uri: text) -> text:
    "{\"textDocument\": {\"uri\": \"" + uri + "\"}, \"options\": {\"tabSize\": 4, \"insertSpaces\": true}}"

fn lsp_build_range_formatting_params(uri: text, start_line: i64, start_col: i64, end_line: i64, end_col: i64) -> text:
    val sl = str(start_line)
    val sc = str(start_col)
    val el = str(end_line)
    val ec = str(end_col)
    "{\"textDocument\": {\"uri\": \"" + uri + "\"}, \"range\": {\"start\": {\"line\": " + sl + ", \"character\": " + sc + "}, \"end\": {\"line\": " + el + ", \"character\": " + ec + "}}, \"options\": {\"tabSize\": 4, \"insertSpaces\": true}}"

fn lsp_path_to_uri(path: text) -> text:
    "file://" + path

fn lsp_uri_to_path(uri: text) -> text:
    if uri.starts_with("file://"):
        return uri.slice(7, uri.len())
    uri

fn lsp_parse_response_id(json: text) -> i64:
    val id_start = _lsp_find_field(json, "\"id\"")
    if id_start < 0:
        return -1
    _lsp_extract_number(json, id_start)

fn lsp_parse_response_result(json: text) -> text:
    val start = _lsp_find_response_value_start(json, "\"result\"")
    if start < 0:
        return ""
    _lsp_extract_value(json, start)

fn lsp_parse_response_error(json: text) -> text:
    val start = _lsp_find_response_value_start(json, "\"error\"")
    if start < 0:
        return ""
    _lsp_extract_value(json, start)

fn lsp_parse_notification_params(json: text) -> text:
    val start = _lsp_find_field(json, "\"params\"")
    if start < 0:
        return ""
    _lsp_extract_value(json, start)

fn lsp_parse_notification_method(json: text) -> text:
    val start = _lsp_find_field(json, "\"method\"")
    if start < 0:
        return ""
    _lsp_extract_string(json, start)

fn lsp_is_response(json: text) -> bool:
    json.contains("\"result\"") or json.contains("\"error\"")

fn lsp_is_notification(json: text) -> bool:
    json.contains("\"method\"") and not json.contains("\"id\"")

fn _lsp_find_response_value_start(json: text, field: text) -> i64:
    var i = 0
    while i < json.len():
        if json.slice(i, json.len()).starts_with(field):
            var j = i + field.len()
            while j < json.len() and json.char_at(j) != ":":
                j = j + 1
            if j >= json.len():
                return -1
            j = j + 1
            while j < json.len() and (json.char_at(j) == " " or json.char_at(j) == "\n" or json.char_at(j) == "\r" or json.char_at(j) == "\t"):
                j = j + 1
            return j
        i = i + 1
    -1

fn _lsp_find_field(json: text, field: text) -> i64:
    var i = 0
    while i < json.len():
        if json.slice(i, json.len()).starts_with(field):
            var j = i + field.len()
            while j < json.len() and (json.char_at(j) == " " or json.char_at(j) == ":"):
                j = j + 1
            return j
        i = i + 1
    -1

fn _lsp_extract_number(json: text, start: i64) -> i64:
    val json_len = json.len()
    var value = 0
    var digit_count = 0
    var i = start
    while i < json_len:
        val ch = json.char_at(i)
        if ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4" or ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9":
            value = value * 10 + (ch.to_i64() ?? 0)
            digit_count = digit_count + 1
        else:
            break
        i = i + 1
    if digit_count == 0: return -1
    value

fn _lsp_extract_string(json: text, start: i64) -> text:
    if start >= json.len() or json.char_at(start) != "\"":
        return ""
    val result = StringBuilder.new()
    val json_len = json.len()
    var i = start + 1
    while i < json_len:
        val ch = json.char_at(i)
        if ch == "\"":
            return result.to_text()
        if ch == "\\":
            i = i + 1
            if i < json_len:
                result.push(json.char_at(i))
        else:
            result.push(ch)
        i = i + 1
    result.to_text()

fn _lsp_extract_value(json: text, start: i64) -> text:
    if start >= json.len():
        return ""
    val ch = json.char_at(start)
    if ch == "{" or ch == "[":
        return _lsp_extract_balanced(json, start, ch)
    if ch == "\"":
        return "\"" + _lsp_extract_string(json, start) + "\""
    val result = StringBuilder.new()
    val json_len = json.len()
    var i = start
    while i < json_len:
        val c = json.char_at(i)
        if c == "," or c == "}" or c == "]":
            return result.to_text().trim()
        result.push(c)
        i = i + 1
    result.to_text().trim()

fn _lsp_extract_balanced(json: text, start: i64, open_ch: text) -> text:
    val close_ch = if open_ch == "{" then "}" else: "]"
    var depth = 0
    var i = start
    var in_str = false
    while i < json.len():
        val ch = json.char_at(i)
        if in_str:
            if ch == "\\":
                i = i + 1
            elif ch == "\"":
                in_str = false
        else:
            if ch == "\"":
                in_str = true
            elif ch == open_ch:
                depth = depth + 1
            elif ch == close_ch:
                depth = depth - 1
                if depth == 0:
                    return json.slice(start, i + 1)
        i = i + 1
    json.slice(start, json.len())

class StdioProcessTransport:
    pid: i64
    server_cmd: text
    server_args: [text]
    buffer: text
    last_error: text

impl StdioProcessTransport:

    static fn new(cmd: text, args: [text]) -> StdioProcessTransport:
        var pid = 0
        var error = ""
        match _lsp_process_spawn(cmd, args):
            case Ok(handle): pid = handle
            case Err(message): error = message
            case _("fail closed if Result gains another variant"):
                error = "unknown_process_spawn_result"
        StdioProcessTransport(
            pid: pid,
            server_cmd: cmd,
            server_args: args,
            buffer: "",
            last_error: error
        )

    me send(message: text) -> bool:
        match process_is_piped_alive_result(me.pid):
            case Ok(true): pass_dn
            case Ok(false):
                me.last_error = "process_exited"
                return false
            case Err(error):
                me.last_error = error
                return false
            case _("fail closed if Result gains another variant"):
                me.last_error = "unknown_process_liveness_result"
                return false
        val framed = lsp_frame_message(message)
        match _lsp_process_write(me.pid, framed):
            case Ok(()): true
            case Err(error):
                me.last_error = error
                false
            case _("fail closed if Result gains another variant"):
                me.last_error = "unknown_process_write_result"
                false

    me receive_result() -> Result<Option<text>, text>:
        match process_read_stdout_result(me.pid):
            case Ok(Some(chunk)): me.buffer = me.buffer + chunk
            case Ok(nil): pass_dn
            case Err(error):
                me.last_error = error
                return Err(error)
            case _("fail closed if Result gains another variant"):
                me.last_error = "unknown_process_read_result"
                return Err(me.last_error)
        val result = lsp_parse_frame(me.buffer)
        val json = result.0
        val consumed = result.1
        if json == "":
            return Ok(nil)
        me.buffer = me.buffer.slice(consumed, me.buffer.len())
        Ok(Some(json))

    me receive() -> text:
        match me.receive_result():
            case Ok(Some(json)): json
            case Ok(nil): ""
            case Err(_): ""
            case _("fail closed if Result gains another variant"): ""

    me is_connected() -> bool:
        match process_is_piped_alive_result(me.pid):
            case Ok(alive): alive
            case Err(error):
                me.last_error = error
                false
            case _("fail closed if Result gains another variant"):
                me.last_error = "unknown_process_liveness_result"
                false

    me close():
        match _lsp_process_close(me.pid):
            case Ok(()): me.pid = 0
            case Err(error): me.last_error = error
            case _("fail closed if Result gains another variant"):
                me.last_error = "unknown_process_close_result"

fn _lsp_transport_escape(s: text) -> text:
    # INDEX SPACE: BYTE-indexed throughout. `s.len()` and `s.slice(a, b)` count
    # BYTES while `char_at` counts CHARACTERS, so the previous loop ran a
    # byte-length bound over a character accessor. On any non-ASCII input the
    # tail iterations index past the last character, `char_at` returns NIL, and
    # `result + nil` collapses to nil -- destroying the ENTIRE accumulated
    # payload, not merely mangling one character. Every JSON escape below is
    # ASCII and UTF-8 is self-synchronizing (continuation bytes are always
    # >= 0x80), so a byte scan matches the escapees exactly.
    var result = ""
    var i = 0
    val n = s.len()
    while i < n:
        val cb = s.byte_at(i)
        # Advance by the whole UTF-8 sequence so a character is never split.
        # A stray continuation byte (0x80..0xBF) advances by 1 to resync.
        var e = i + 1
        if cb >= 240:
            e = i + 4
        elif cb >= 224:
            e = i + 3
        elif cb >= 192:
            e = i + 2
        if e > n:
            e = n
        if cb == 34:
            result = result + "\\\""
        elif cb == 92:
            result = result + "\\\\"
        elif cb == 10:
            result = result + "\\n"
        elif cb == 13:
            result = result + "\\r"
        elif cb == 9:
            result = result + "\\t"
        else:
            result = result + s.slice(i, e)
        i = e
    result
