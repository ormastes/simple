# Editor Recovery — lock and WAL replay coordination.

use std.editor.core.session_db.*
use std.io_runtime.{file_read, file_delete, file_exists, getpid}
use std.nogc_sync_mut.daemon_sdk.lock.{try_acquire_daemon_lock, release_daemon_lock, is_daemon_running}

struct RecoveryState:
    needs_recovery: bool
    stale_lock: bool
    lock_path: text
    wal_path: text

class RecoveryManager:
    lock_path: text
    wal_path: text

    static fn new(root: text) -> RecoveryManager:
        RecoveryManager(lock_path: root + "/editor.lock", wal_path: root + "/editor.wal")

    fn check() -> RecoveryState:
        val lock_exists = file_exists(me.lock_path)
        val wal = file_read(me.wal_path) ?? ""
        RecoveryState(needs_recovery: wal != "", stale_lock: lock_exists, lock_path: me.lock_path, wal_path: me.wal_path)

    me acquire_lock() -> bool:
        try_acquire_daemon_lock(me.lock_path) > 0

    me release_lock():
        if not release_daemon_lock(getpid(), me.lock_path) and not is_daemon_running(me.lock_path):
            file_delete(me.lock_path)

    me recover(session_db: SessionDb) -> bool:
        val ok = session_db.checkpoint()
        if ok:
            me.release_lock()
        ok
