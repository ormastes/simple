# Extension Runtime — isolation & security primitives for the extension
# kernel host (lane L6/F3): canonical path containment, default-deny
# permission enforcement, and crash-loop containment for dispatched commands.
#
# Path handling is POSIX-style ('/'), matching the rest of the extension
# kernel (see editor/core/path_text.spl, editor/extensions/roots.spl).
#
# Symlink resolution (lane F3, 2026-07-29): path_canonicalize resolves real
# symlink chains for paths that EXIST on disk, via the already-existing
# `rt_path_absolute` runtime symbol (same symbol used by
# src/app/io/cli_ops.spl's `_cli_resolve_symlink` — see that file's comment:
# "rt_path_absolute is std::fs::canonicalize: it resolves symlink chains and
# makes the path absolute IN-PROCESS"). No new extern was added: rt_path_absolute
# already exists and is wired on every engine —
# src/runtime/runtime_native.c:rt_path_absolute (native, calls libc realpath()),
# src/compiler_rust/.../interpreter_extern/file_io.rs:rt_file_canonicalize
# (interpreter, calls std::fs::canonicalize) — so this needed no bootstrap
# rebuild. For a path that does NOT exist (containment pre-checks routinely
# canonicalize a not-yet-created target), rt_path_absolute's own fallback does
# NOT lexically collapse '..' segments, so path_canonicalize falls back to the
# original LEXICAL normalizer ('.'/'..' collapse, repeated-separator collapse)
# for that case, unchanged from before.
#
# Residual limitation (filed, not faked): on Windows, the native runtime's
# rt_path_absolute fallback uses `_fullpath`, which does not resolve
# symlinks/junctions the way POSIX `realpath()` does — this module's symlink
# resolution is therefore POSIX-real, Windows-lexical-only. There is also an
# inherent TOCTOU window between the existence check and use of the resolved
# path (same class of gap every realpath()-based sandboxing check has); this
# module is a *containment check*, not an atomic open, so that is an accepted
# limitation of this rung of hardening.

use std.editor.extensions.manifest.{ExtensionPermissions}

extern fn rt_path_absolute(path: text) -> text
extern fn rt_file_exists(path: text) -> bool
extern fn rt_dir_exists(path: text) -> bool

# ---- path containment -------------------------------------------------------

fn path_is_absolute(path: text) -> bool:
    path.starts_with("/")

fn _path_pop_last(items: [text]) -> [text]:
    var out: [text] = []
    var i = 0
    while i < items.len() - 1:
        out.push(items[i])
        i = i + 1
    out

# Canonicalize `path` for containment purposes: if it exists on disk, resolve
# it via the real OS resolver (`rt_path_absolute`, symlink-aware — see module
# doc comment); otherwise fall back to pure LEXICAL normalization so
# containment pre-checks against not-yet-created targets keep working.
fn path_canonicalize(path: text) -> text:
    if rt_file_exists(path) or rt_dir_exists(path):
        val resolved = rt_path_absolute(path) ?? ""
        if resolved != "":
            return resolved
    _path_canonicalize_lexical(path)

# Lexically normalize a '/'-separated path: drop empty/'.' segments, resolve
# '..' against the preceding segment when there is one to resolve against,
# collapse repeated separators. Absolute paths stay absolute; '..' above an
# absolute root is dropped (same as most OS path resolvers); '..' above a
# relative path's own root is kept as a leading '..' (nothing to resolve it
# against here). No symlink resolution — used only as the not-on-disk
# fallback for path_canonicalize (see module doc comment).
fn _path_canonicalize_lexical(path: text) -> text:
    val absolute = path_is_absolute(path)
    val raw_segments = path.split("/")
    var stack: [text] = []
    for segment in raw_segments:
        if segment == "" or segment == ".":
            pass_do_nothing
        elif segment == "..":
            if stack.len() > 0 and stack[stack.len() - 1] != "..":
                stack = _path_pop_last(stack)
            elif absolute:
                pass_do_nothing
            else:
                stack.push("..")
        else:
            stack.push(segment)
    val joined = stack.join("/")
    if absolute:
        if joined == "":
            return "/"
        return "/" + joined
    if joined == "":
        return "."
    joined

# Separator-aware containment check on canonicalized paths. Replaces the raw
# `path.starts_with(root)` hazard: "/root-evil" must NOT be reported as
# contained in "/root" just because it shares a string prefix.
fn path_contained_in(child: text, root: text) -> bool:
    val canon_root = path_canonicalize(root)
    val canon_child = path_canonicalize(child)
    if canon_root == "" or canon_root == ".":
        return false
    if canon_child == canon_root:
        return true
    val prefix = if canon_root == "/" then "/" else canon_root + "/"
    canon_child.starts_with(prefix)

# Resolve a manifest-declared resource/entry path against its package root.
# Rejects absolute entry paths outright and rejects any relative entry that
# canonicalizes to a location outside `root` (e.g. "a/../../etc"). Returns
# the canonical absolute path on success.
fn path_resolve_entry(root: text, entry: text) -> Result<text, text>:
    if entry == "":
        return Err("extension entry path is empty")
    if path_is_absolute(entry):
        return Err("extension entry path must be relative, got absolute path: " + entry)
    val canon_root = path_canonicalize(root)
    val resolved = path_canonicalize(canon_root + "/" + entry)
    if not path_contained_in(resolved, canon_root):
        return Err("extension entry path escapes its package root: " + entry)
    Ok(resolved)

# ---- permission enforcement (default-deny) -----------------------------------

fn runtime_permission_value(permissions: ExtensionPermissions, capability: text) -> bool:
    if capability == "workspace_read":
        return permissions.workspace_read
    if capability == "workspace_write":
        return permissions.workspace_write
    if capability == "process_spawn":
        return permissions.process_spawn
    if capability == "network_client":
        return permissions.network_client
    if capability == "secrets":
        return permissions.secrets
    if capability == "native_ffi":
        return permissions.native_ffi
    false  # unknown capability name => default-deny

# Default-deny capability check against a manifest's declared permissions.
# An absent/false permission (including an unrecognized capability name)
# denies with a user-readable diagnostic; only an explicit `true` grants.
fn runtime_check_permission(permissions: ExtensionPermissions, capability: text) -> Result<(), text>:
    if runtime_permission_value(permissions, capability):
        return Ok(())
    Err("permission denied: capability '" + capability + "' is not granted (default-deny)")

# ---- crash-loop containment ---------------------------------------------------

val EXTENSION_CRASH_THRESHOLD = 3

struct ExtensionCrashState:
    extension_name: text
    consecutive_failures: i64
    disabled: bool

fn extension_crash_state_new(name: text) -> ExtensionCrashState:
    ExtensionCrashState(extension_name: name, consecutive_failures: 0, disabled: false)

fn runtime_crash_find(states: [ExtensionCrashState], name: text) -> ExtensionCrashState:
    for s in states:
        if s.extension_name == name:
            return s
    extension_crash_state_new(name)

fn runtime_crash_is_disabled(states: [ExtensionCrashState], name: text) -> bool:
    runtime_crash_find(states, name).disabled

fn runtime_crash_failure_count(states: [ExtensionCrashState], name: text) -> i64:
    runtime_crash_find(states, name).consecutive_failures

# Record a dispatch outcome for `name`. A success resets the counter and
# clears `disabled`; a failure increments the counter and sets `disabled`
# once it reaches EXTENSION_CRASH_THRESHOLD consecutive failures.
fn runtime_crash_record(states: [ExtensionCrashState], name: text, ok: bool) -> [ExtensionCrashState]:
    var out: [ExtensionCrashState] = []
    var found = false
    for s in states:
        if s.extension_name == name:
            found = true
            var updated = s
            if ok:
                updated.consecutive_failures = 0
                updated.disabled = false
            else:
                updated.consecutive_failures = updated.consecutive_failures + 1
                if updated.consecutive_failures >= EXTENSION_CRASH_THRESHOLD:
                    updated.disabled = true
            out.push(updated)
        else:
            out.push(s)
    if not found:
        var fresh = extension_crash_state_new(name)
        if not ok:
            fresh.consecutive_failures = 1
        out.push(fresh)
    out

# Clear crash state for `name` (no-op, safely, if it has none).
fn runtime_crash_reenable(states: [ExtensionCrashState], name: text) -> [ExtensionCrashState]:
    var out: [ExtensionCrashState] = []
    var found = false
    for s in states:
        if s.extension_name == name:
            found = true
            out.push(extension_crash_state_new(name))
        else:
            out.push(s)
    if not found:
        out.push(extension_crash_state_new(name))
    out
