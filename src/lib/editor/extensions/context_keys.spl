# Context keys -- evaluates the `when` clause of a contribution (keybinding,
# view action, status item) against the set of currently-true context keys.
# Grammar: `a || b` of `a && b` of `key` / `!key`; empty clause is true.
# REQ-CARET-EXT-003 (plan 5.1: `when` / context-key validation).

fn _ctx_term(term: text, keys: [text]) -> bool:
    val t = term.trim()
    if t.starts_with("!"):
        return not keys.contains(t.slice(1, t.byte_len()).trim())
    keys.contains(t)

fn _ctx_all(clause: text, keys: [text]) -> bool:
    for term in clause.split("&&"):
        if not _ctx_term(term, keys):
            return false
    true

fn context_when_eval(when: text, keys: [text]) -> bool:
    if when.trim() == "":
        return true
    for clause in when.split("||"):
        if _ctx_all(clause, keys):
            return true
    false

export context_when_eval
