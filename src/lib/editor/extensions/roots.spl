# Editor extension root policy.
#
# Runtime-neutral default extension locations. App adapters inject environment
# values so this policy can be reused by host, SimpleOS, IDE, and examples.
# `discover_extensions` is the one filesystem-touching member: it turns a single
# root into the manifests it contains, for callers that want the manifests
# themselves rather than ExtensionHost's registered-count view.

use std.editor.core.path_text.*
use std.editor.extensions.manifest.{ExtensionManifest}
use std.editor.extensions.manifest_sdn.{extension_manifest_load}
use std.io_runtime.{dir_walk}

fn editor_extension_workspace_roots() -> [text]:
    [
        ".simple/editor/extensions",
        ".vscode/simple-editor/extensions"
    ]

fn editor_extension_user_roots(home: text) -> [text]:
    if home.trim() == "":
        return []
    [
        home + "/.simple/editor/extensions",
        home + "/.simple/extensions"
    ]

fn editor_extension_system_roots() -> [text]:
    [
        "/usr/local/share/simple/editor/extensions",
        "/usr/share/simple/editor/extensions"
    ]

# Walk one scan root and return the manifest of every `extension.sdn` under it.
# Manifests that carry no name are skipped, mirroring ExtensionHost's
# register_manifest guard.
fn discover_extensions(scan_root: text) -> [ExtensionManifest]:
    var found: [ExtensionManifest] = []
    if scan_root.trim() == "":
        return found
    for file in dir_walk(scan_root):
        val parts = file.split("/")
        if parts.len() > 0 and parts[parts.len() - 1] == "extension.sdn":
            val manifest = extension_manifest_load(file)
            if manifest.name != "":
                found.push(manifest)
    found

fn editor_extension_roots_from_inputs(configured_path_list: text, home: text) -> [text]:
    var roots: [text] = []
    for root in editor_extension_workspace_roots():
        roots.push(root)
    for root in editor_split_path_list(configured_path_list):
        roots.push(root)
    for root in editor_extension_user_roots(home):
        roots.push(root)
    for root in editor_extension_system_roots():
        roots.push(root)
    roots
