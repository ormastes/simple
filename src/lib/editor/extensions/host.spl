# Extension Host
#
# Two-phase extension loading: index SDN manifests on startup,
# activate on demand when activation events fire.

use std.editor.extensions.api.*
use std.editor.extensions.manifest.*
use std.editor.extensions.manifest_sdn.{extension_manifest_load}
use std.editor.extensions.registry.{CommandRegistry, EventListenerRegistry, LanguageIndex}
use std.editor.extensions.runtime.{
    ExtensionCrashState, path_contained_in,
    runtime_check_permission, runtime_crash_is_disabled,
    runtime_crash_record, runtime_crash_reenable
}
use std.editor.extensions.builtin.index.{builtin_manifest_providers, builtin_activation_hooks}
use std.editor.extensions.builtin.spl_language.*
use std.editor.extensions.builtin.md_language.*
use std.editor.extensions.builtin.sheets_ext.{sheets_function_double_handler}
use std.editor.core.path_text.*
use std.editor.core.keybinding_manager.{
    KeybindingManager, keybinding_manager_new, keybinding_manager_add_override,
    keybinding_manager_resolve
}
use std.editor.common.keybindings.{KeyBinding}
use std.io_runtime.{dir_walk}

struct ExtensionEntry:
    manifest: ExtensionManifest
    path: text
    active: bool

fn extension_entry_is_active(entry: ExtensionEntry) -> bool:
    entry.active

fn extension_entry_manifest_name(entry: ExtensionEntry) -> text:
    entry.manifest.name

fn extension_entry_matches_activation(entry: ExtensionEntry, event: text) -> bool:
    for activation_event in entry.manifest.activation_events:
        if activation_event == event or activation_event == "*":
            return true
    false

fn _extension_host_is_manifest_path(path: text) -> bool:
    val parts = path.split("/")
    if parts.len() == 0:
        return false
    parts[parts.len() - 1] == "extension.sdn"

class ExtensionHost:
    extensions: [ExtensionEntry]
    command_registry: [ExtensionCommandEntry]
    language_index: LanguageIndex
    debug_adapter_registry: [ExtensionDebugAdapterEntry]
    context_registry: [ExtensionContextEntry]
    event_log: [ExtensionEventRecord]
    invocation_queue: [ExtensionCommandInvocation]
    runtime_policy: ExtensionRuntimePolicy
    runtime_dispatch_log: [ExtensionRuntimeDispatchRecord]
    crash_state: [ExtensionCrashState]
    commands: CommandRegistry
    listeners: EventListenerRegistry
    lifetimes: [ExtensionLifetimeEntry]
    activation_hooks: [ExtensionActivationHookEntry]
    activation_diagnostics: [text]
    keybinding_manager: KeybindingManager
    keybinding_registry: [ExtensionKeybindingEntry]
    custom_editor_registry: [ExtensionCustomEditorEntry]

struct ExtensionCommandEntry:
    extension_name: text
    command: ExtensionCommand

fn extension_command_entry_name(entry: ExtensionCommandEntry) -> text:
    entry.extension_name

fn extension_command_entry_command_id(entry: ExtensionCommandEntry) -> text:
    entry.command.id

# Ownership record for a keybinding contributed by an extension's manifest,
# mirroring ExtensionCommandEntry so `contributes_keybindings` can be reversed
# per-extension on deactivate (KeybindingManager.overrides carries no owner).
struct ExtensionKeybindingEntry:
    extension_name: text
    binding: KeyBinding

# Per-extension registration ownership. Struct (not the ExtensionLifetime
# class): class instances stored inside an array field lose later mutations
# (value-copy semantics), so the host mutates entries by index reassignment.
struct ExtensionLifetimeEntry:
    owner: text
    disposables: [Disposable]

# Activation entrypoint wiring (L6b). One optional hook per extension name,
# run exactly once the first time that extension transitions to active
# (guarded against re-activation across deactivate/activate cycles). Struct,
# not a class, for the same array-field mutation reason as
# ExtensionLifetimeEntry above: the host mutates `ran` by index reassignment.
struct ExtensionActivationHookEntry:
    owner: text
    hook: fn(text) -> Result<text, text>
    ran: bool

struct ExtensionDebugAdapterEntry:
    extension_name: text
    adapter: ExtensionDebugAdapter

# Ownership record for a custom-editor contribution, mirroring
# ExtensionDebugAdapterEntry so `contributes_custom_editors` can be resolved
# by `document_kind` and reversed per-extension on deactivate.
struct ExtensionCustomEditorEntry:
    extension_name: text
    editor: ExtensionCustomEditor

fn extension_debug_adapter_id(entry: ExtensionDebugAdapterEntry) -> text:
    entry.adapter.id

fn extension_debug_adapter_program(entry: ExtensionDebugAdapterEntry) -> text:
    entry.adapter.program

struct ExtensionContextEntry:
    extension_name: text
    context: ExtensionContext

struct ExtensionEventRecord:
    event: text
    payload: text
    delivered_count: i64

struct ExtensionCommandInvocation:
    id: i64
    extension_name: text
    command_id: text
    payload: text
    status: text

fn extension_command_invocation_command_id(invocation: ExtensionCommandInvocation) -> text:
    invocation.command_id

struct ExtensionRuntimePolicy:
    enabled: bool
    allow_external_process: bool
    allowed_roots: [text]

struct ExtensionRuntimeDispatchRecord:
    invocation_id: i64
    extension_name: text
    command_id: text
    main: text
    status: text
    reason: text

impl ExtensionHost:

    static fn new() -> ExtensionHost:
        ExtensionHost(
            extensions: [],
            command_registry: [],
            language_index: LanguageIndex.new(),
            debug_adapter_registry: [],
            context_registry: [],
            event_log: [],
            invocation_queue: [],
            runtime_policy: extension_runtime_policy_default(),
            runtime_dispatch_log: [],
            crash_state: [],
            commands: CommandRegistry.new(),
            listeners: EventListenerRegistry.new(),
            lifetimes: [],
            activation_hooks: [],
            activation_diagnostics: [],
            keybinding_manager: keybinding_manager_new(),
            keybinding_registry: [],
            custom_editor_registry: []
        )

    me index_extension(path: text):
        val manifest = extension_manifest_load(path + "/extension.sdn")
        me.register_manifest(manifest, path)

    me discover_extensions(roots: [text]) -> i64:
        var indexed = 0
        for root in roots:
            val files = dir_walk(root)
            for file in files:
                if _extension_host_is_manifest_path(file):
                    val extension_dir = editor_dirname(file)
                    val before_count = me.extensions.len()
                    me.index_extension(extension_dir)
                    if me.extensions.len() > before_count:
                        indexed = indexed + 1
        indexed

    me register_manifest(manifest: ExtensionManifest, path: text):
        if manifest.name == "":
            return
        var i = 0
        while i < me.extensions.len():
            if me.extensions[i].manifest.name == manifest.name:
                val was_active = me.extensions[i].active
                me._unregister_contributions(manifest.name)
                me.extensions[i] = ExtensionEntry(
                    manifest: manifest,
                    path: path,
                    active: was_active
                )
                if was_active:
                    me._register_context(manifest, path)
                    me._register_contributions(manifest)
                return
            i = i + 1
        me.extensions.push(ExtensionEntry(
            manifest: manifest,
            path: path,
            active: false
        ))

    me activate(name: text) -> bool:
        var i = 0
        while i < me.extensions.len():
            if me.extensions[i].manifest.name == name and not me.extensions[i].active:
                var entry = me.extensions[i]
                entry.active = true
                me.extensions[i] = entry
                me._register_context(entry.manifest, entry.path)
                me._register_contributions(entry.manifest)
                me._run_activation_hook(name)
                return true
            i = i + 1
        false

    me activate_event(event: text) -> i64:
        var activated = 0
        var i = 0
        while i < me.extensions.len():
            val entry = me.extensions[i]
            if not extension_entry_is_active(entry):
                if extension_entry_matches_activation(entry, event):
                    if me.activate(extension_entry_manifest_name(entry)):
                        activated = activated + 1
            i = i + 1
        activated

    me activate_language(language_id: text) -> i64:
        me.activate_event("onLanguage:" + language_id)

    me activate_command(command_id: text) -> i64:
        me.activate_event("onCommand:" + command_id)

    # Record a Disposable under its owning extension's lifetime entry.
    me _lifetime_add(name: text, d: Disposable):
        var i = 0
        while i < me.lifetimes.len():
            if me.lifetimes[i].owner == name:
                var entry = me.lifetimes[i]
                entry.disposables = entry.disposables.push(d)
                me.lifetimes[i] = entry
                return
            i = i + 1
        me.lifetimes.push(ExtensionLifetimeEntry(owner: name, disposables: [d]))

    fn lifetime_disposable_count(name: text) -> i64:
        for entry in me.lifetimes:
            if entry.owner == name:
                return entry.disposables.len()
        0

    # Register (or replace) the activation hook run once when `name` first
    # transitions to active. In-process builtins only today -- worker/
    # external entrypoint execution stays future work (see runtime.spl
    # dispatch seam / .spipe/ide_extension_kernel/state.md).
    me register_activation_hook(name: text, hook: fn(text) -> Result<text, text>):
        var i = 0
        while i < me.activation_hooks.len():
            if me.activation_hooks[i].owner == name:
                me.activation_hooks[i] = ExtensionActivationHookEntry(
                    owner: name, hook: hook, ran: false)
                return
            i = i + 1
        me.activation_hooks.push(ExtensionActivationHookEntry(
            owner: name, hook: hook, ran: false))

    # Runs `name`'s activation hook exactly once (no-op if none registered or
    # it already ran). A hook Err becomes a diagnostic and a recorded
    # crash-state failure instead of propagating -- the host stays
    # functional and the extension stays active.
    me _run_activation_hook(name: text):
        var i = 0
        while i < me.activation_hooks.len():
            if me.activation_hooks[i].owner == name:
                if me.activation_hooks[i].ran:
                    return
                val callback = me.activation_hooks[i].hook
                val result = callback(name)
                var entry = me.activation_hooks[i]
                entry.ran = true
                me.activation_hooks[i] = entry
                match result:
                    case Ok(_):
                        pass_do_nothing
                    case Err(reason):
                        me.activation_diagnostics.push(
                            "activation hook failed for '" + name + "': " + reason)
                        me.crash_state = runtime_crash_record(me.crash_state, name, false)
                return
            i = i + 1

    fn activation_hook_ran(name: text) -> bool:
        for entry in me.activation_hooks:
            if entry.owner == name:
                return entry.ran
        false

    fn activation_diagnostic_count() -> i64:
        me.activation_diagnostics.len()

    fn last_activation_diagnostic() -> text:
        if me.activation_diagnostics.len() == 0:
            return ""
        me.activation_diagnostics[me.activation_diagnostics.len() - 1]

    # Register a typed command handler. The registration is owned by the
    # extension's lifetime and disposed on deactivation. First registration
    # of a command id wins; duplicates are recorded as registry conflicts.
    me register_command_handler(extension_name: text, command_id: text, title: text,
                                handler_fn: fn(text) -> Result<text, text>) -> Disposable:
        val d = me.commands.register(extension_name, command_id, title, handler_fn)
        if d.kind == "command":
            me._lifetime_add(extension_name, d)
        d

    fn command_handler_registered(command_id: text) -> bool:
        me.commands.has(command_id)

    # Lazy activation + real dispatch: "onCommand:<id>" activates the owning
    # extension, then the registered typed handler executes.
    #
    # L6 hooks (runtime.spl): a "worker"-placed extension must hold the
    # process_spawn permission to dispatch at all (default-deny; the other
    # five permissions are declared+checked via runtime_check_permission but
    # not wired into any dispatch seam yet); an extension that has failed its
    # last 3 consecutive dispatches is short-circuited with a fixed error
    # instead of running its handler again (crash-loop containment).
    me dispatch_command(command_id: text, payload: text) -> Result<text, text>:
        me.activate_command(command_id)
        if not me.commands.has(command_id):
            return Err("no handler registered for command '" + command_id + "'")
        val owner = me.commands.owner_of(command_id)
        val entry = me.find_extension(owner)
        if entry.manifest.name != "" and not entry.active:
            return Err("extension not active: " + owner)
        if runtime_crash_is_disabled(me.crash_state, owner):
            return Err("extension disabled after repeated failures: " + owner)
        if entry.manifest.host == "worker":
            match runtime_check_permission(entry.manifest.permissions, "process_spawn"):
                case Err(reason):
                    return Err(reason)
                case Ok(_):
                    pass_do_nothing
        val result = me.commands.run(command_id, payload)
        var dispatch_ok = false
        match result:
            case Ok(_):
                dispatch_ok = true
            case Err(_):
                dispatch_ok = false
        me.crash_state = runtime_crash_record(me.crash_state, owner, dispatch_ok)
        result

    # Clear crash-loop state for `name` so its next dispatch runs normally.
    me runtime_reenable(name: text):
        me.crash_state = runtime_crash_reenable(me.crash_state, name)

    # Register a typed event listener, owned by the extension's lifetime.
    me on_event(extension_name: text, event: text, handler_fn: fn(text)) -> Disposable:
        val d = me.listeners.add(extension_name, event, handler_fn)
        me._lifetime_add(extension_name, d)
        d

    me emit_event(event: text, payload: text) -> i64:
        var delivered = 0
        for entry in me.context_registry:
            if extension_context_is_subscribed(entry.context, event):
                delivered = delivered + 1
        delivered = delivered + me.listeners.deliver(event, payload)
        me.event_log.push(ExtensionEventRecord(
            event: event,
            payload: payload,
            delivered_count: delivered
        ))
        delivered

    me subscribe(extension_name: text, event: text) -> bool:
        var i = 0
        while i < me.context_registry.len():
            if me.context_registry[i].extension_name == extension_name:
                var entry = me.context_registry[i]
                entry.context = extension_context_subscribe(entry.context, event)
                me.context_registry[i] = entry
                return true
            i = i + 1
        false

    me set_workspace_state(extension_name: text, key: text, value: text) -> bool:
        var i = 0
        while i < me.context_registry.len():
            if me.context_registry[i].extension_name == extension_name:
                var entry = me.context_registry[i]
                entry.context = extension_context_set_state(entry.context, key, value)
                me.context_registry[i] = entry
                return true
            i = i + 1
        false

    fn get_workspace_state(extension_name: text, key: text) -> text:
        val ctx = me.find_context(extension_name)
        extension_context_get_state(ctx, key)

    me dispatch_external_command(command_id: text, payload: text) -> ExtensionCommandInvocation:
        me.activate_command(command_id)
        val entry = me.find_command(command_id)
        if entry.command.id == "":
            return ExtensionCommandInvocation(
                id: -1,
                extension_name: "",
                command_id: command_id,
                payload: payload,
                status: "missing"
            )
        val next_id = me.invocation_queue.len()
        val invocation = ExtensionCommandInvocation(
            id: next_id,
            extension_name: entry.extension_name,
            command_id: command_id,
            payload: payload,
            status: "pending-runtime"
        )
        me.invocation_queue.push(invocation)
        invocation

    me set_runtime_policy(policy: ExtensionRuntimePolicy):
        me.runtime_policy = policy

    me drain_invocation_queue() -> i64:
        var drained = 0
        var next_queue: [ExtensionCommandInvocation] = []
        var i = 0
        while i < me.invocation_queue.len():
            var invocation = me.invocation_queue[i]
            if invocation.status == "pending-runtime":
                val record = me._dispatch_runtime_invocation(invocation)
                me.runtime_dispatch_log.push(record)
                invocation.status = record.status
                drained = drained + 1
            next_queue.push(invocation)
            i = i + 1
        me.invocation_queue = next_queue
        drained

    fn runtime_dispatch_count() -> i64:
        me.runtime_dispatch_log.len()

    fn last_runtime_dispatch() -> ExtensionRuntimeDispatchRecord:
        if me.runtime_dispatch_log.len() == 0:
            return ExtensionRuntimeDispatchRecord(
                invocation_id: -1,
                extension_name: "",
                command_id: "",
                main: "",
                status: "none",
                reason: ""
            )
        me.runtime_dispatch_log[me.runtime_dispatch_log.len() - 1]

    fn pending_invocation_count() -> i64:
        me.invocation_queue.len()

    fn last_invocation() -> ExtensionCommandInvocation:
        if me.invocation_queue.len() == 0:
            return ExtensionCommandInvocation(
                id: -1,
                extension_name: "",
                command_id: "",
                payload: "",
                status: "none"
            )
        me.invocation_queue[me.invocation_queue.len() - 1]

    fn _dispatch_runtime_invocation(invocation: ExtensionCommandInvocation) -> ExtensionRuntimeDispatchRecord:
        val entry = me.find_extension(invocation.extension_name)
        if entry.manifest.name == "":
            return ExtensionRuntimeDispatchRecord(
                invocation_id: invocation.id,
                extension_name: invocation.extension_name,
                command_id: invocation.command_id,
                main: "",
                status: "missing-extension",
                reason: "extension not indexed"
            )
        if entry.manifest.main == "":
            return ExtensionRuntimeDispatchRecord(
                invocation_id: invocation.id,
                extension_name: invocation.extension_name,
                command_id: invocation.command_id,
                main: "",
                status: "blocked-runtime",
                reason: "manifest has no main"
            )
        if not me.runtime_policy.enabled:
            return ExtensionRuntimeDispatchRecord(
                invocation_id: invocation.id,
                extension_name: invocation.extension_name,
                command_id: invocation.command_id,
                main: entry.path + "/" + entry.manifest.main,
                status: "blocked-runtime",
                reason: "runtime disabled"
            )
        if not me._runtime_path_allowed(entry.path):
            return ExtensionRuntimeDispatchRecord(
                invocation_id: invocation.id,
                extension_name: invocation.extension_name,
                command_id: invocation.command_id,
                main: entry.path + "/" + entry.manifest.main,
                status: "blocked-runtime",
                reason: "extension root not allowed"
            )
        if not me.runtime_policy.allow_external_process:
            return ExtensionRuntimeDispatchRecord(
                invocation_id: invocation.id,
                extension_name: invocation.extension_name,
                command_id: invocation.command_id,
                main: entry.path + "/" + entry.manifest.main,
                status: "ready-sandbox",
                reason: "sandbox runner required"
            )
        ExtensionRuntimeDispatchRecord(
            invocation_id: invocation.id,
            extension_name: invocation.extension_name,
            command_id: invocation.command_id,
            main: entry.path + "/" + entry.manifest.main,
            status: "ready-external-process",
            reason: "external process runner required"
        )

    fn _runtime_path_allowed(path: text) -> bool:
        if me.runtime_policy.allowed_roots.len() == 0:
            return false
        for root in me.runtime_policy.allowed_roots:
            if root != "" and path_contained_in(path, root):
                return true
        false

    me deactivate(name: text) -> bool:
        var i = 0
        while i < me.extensions.len():
            if me.extensions[i].manifest.name == name and me.extensions[i].active:
                var entry = me.extensions[i]
                entry.active = false
                me.extensions[i] = entry
                me._unregister_contributions(entry.manifest.name)
                me._unregister_context(entry.manifest.name)
                me._dispose_lifetime(entry.manifest.name)
                return true
            i = i + 1
        false

    # Dispose every registration the extension's lifetime owns.
    me _dispose_lifetime(name: text):
        var i = 0
        while i < me.lifetimes.len():
            if me.lifetimes[i].owner == name:
                var entry = me.lifetimes[i]
                for d in entry.disposables:
                    if d.kind == "command":
                        me.commands.dispose(d.id)
                    elif d.kind == "listener":
                        me.listeners.dispose(d.id)
                entry.disposables = []
                me.lifetimes[i] = entry
            i = i + 1
        # safety sweep for registrations that bypassed the lifetime
        me.commands.dispose_owner(name)
        me.listeners.dispose_owner(name)

    fn find_extension(name: text) -> ExtensionEntry:
        for entry in me.extensions:
            if entry.manifest.name == name:
                return entry
        ExtensionEntry(
            manifest: extension_manifest_empty(),
            path: "",
            active: false
        )

    fn is_active(name: text) -> bool:
        val entry = me.find_extension(name)
        entry.active

    fn extension_count() -> i64:
        me.extensions.len()

    fn active_count() -> i64:
        var count = 0
        for entry in me.extensions:
            if entry.active:
                count = count + 1
        count

    fn find_context(name: text) -> ExtensionContext:
        for entry in me.context_registry:
            if entry.extension_name == name:
                return entry.context
        extension_context_new("", "")

    fn event_count() -> i64:
        me.event_log.len()

    fn find_command(command_id: text) -> ExtensionCommandEntry:
        for entry in me.command_registry:
            if entry.command.id == command_id:
                return entry
        ExtensionCommandEntry(
            extension_name: "",
            command: ExtensionCommand(id: "", title: "", category: "")
        )

    fn command_registered(command_id: text) -> bool:
        val entry = me.find_command(command_id)
        entry.command.id != ""

    fn find_language_for_ext(file_ext: text) -> text:
        me.language_index.language_for_file_ext(file_ext)

    fn find_debug_adapter(adapter_id: text) -> ExtensionDebugAdapterEntry:
        for entry in me.debug_adapter_registry:
            if entry.adapter.id == adapter_id:
                return entry
        ExtensionDebugAdapterEntry(
            extension_name: "",
            adapter: ExtensionDebugAdapter(id: "", label: "", program: "")
        )

    fn debug_adapter_registered(adapter_id: text) -> bool:
        val entry = me.find_debug_adapter(adapter_id)
        entry.adapter.id != ""

    # Resolve the custom editor bound to `document_kind` with the highest
    # `priority`. Ties are broken deterministically by registration order
    # (first-registered wins: only a strictly-greater priority replaces the
    # current best). Empty entry (extension_name == "") when none registered.
    fn resolve_custom_editor(document_kind: text) -> ExtensionCustomEditorEntry:
        var best = ExtensionCustomEditorEntry(
            extension_name: "",
            editor: ExtensionCustomEditor(id: "", document_kind: "", priority: 0)
        )
        var found = false
        for entry in me.custom_editor_registry:
            if entry.editor.document_kind == document_kind:
                if not found or entry.editor.priority > best.editor.priority:
                    best = entry
                    found = true
        best

    fn custom_editor_registered(document_kind: text) -> bool:
        me.resolve_custom_editor(document_kind).extension_name != ""

    me _register_contributions(manifest: ExtensionManifest):
        for cmd in manifest.contributes_commands:
            me.command_registry.push(ExtensionCommandEntry(
                extension_name: manifest.name,
                command: cmd
            ))
        for lang in manifest.contributes_languages:
            me.language_index.register(manifest.name, lang.id, lang.extensions)
        for adapter in manifest.contributes_debug_adapters:
            me.debug_adapter_registry.push(ExtensionDebugAdapterEntry(
                extension_name: manifest.name,
                adapter: adapter
            ))
        for kb in manifest.contributes_keybindings:
            val binding = KeyBinding(key: kb.key, command: kb.command, mode: "", args: "")
            me.keybinding_registry.push(ExtensionKeybindingEntry(
                extension_name: manifest.name,
                binding: binding
            ))
            me.keybinding_manager = keybinding_manager_add_override(me.keybinding_manager, binding)
        for editor in manifest.contributes_custom_editors:
            me.custom_editor_registry.push(ExtensionCustomEditorEntry(
                extension_name: manifest.name,
                editor: editor
            ))

    me _register_context(manifest: ExtensionManifest, path: text):
        me._unregister_context(manifest.name)
        var ctx = extension_context_new(path, manifest.name)
        for activation_event in manifest.activation_events:
            ctx = extension_context_subscribe(ctx, activation_event)
        me.context_registry.push(ExtensionContextEntry(
            extension_name: manifest.name,
            context: ctx
        ))

    me _unregister_contributions(name: text):
        var new_cmds: [ExtensionCommandEntry] = []
        for entry in me.command_registry:
            if entry.extension_name != name:
                new_cmds.push(entry)
        me.command_registry = new_cmds
        me.language_index.remove_owner(name)
        var new_adapters: [ExtensionDebugAdapterEntry] = []
        for entry in me.debug_adapter_registry:
            if entry.extension_name != name:
                new_adapters.push(entry)
        me.debug_adapter_registry = new_adapters
        var new_kb: [ExtensionKeybindingEntry] = []
        for entry in me.keybinding_registry:
            if entry.extension_name != name:
                new_kb.push(entry)
        me.keybinding_registry = new_kb
        me._rebuild_keybinding_overrides()
        var new_editors: [ExtensionCustomEditorEntry] = []
        for entry in me.custom_editor_registry:
            if entry.extension_name != name:
                new_editors.push(entry)
        me.custom_editor_registry = new_editors

    # KeybindingManager.overrides has no owner tag, so a per-extension removal
    # rebuilds the override list from the surviving keybinding_registry entries
    # rather than mutating the manager in place.
    me _rebuild_keybinding_overrides():
        var manager = KeybindingManager(config: me.keybinding_manager.config, overrides: [])
        for entry in me.keybinding_registry:
            manager = keybinding_manager_add_override(manager, entry.binding)
        me.keybinding_manager = manager

    fn keybinding_resolve(key: text, mode: text) -> text:
        keybinding_manager_resolve(me.keybinding_manager, key, mode)

    # Like keybinding_resolve, but scoped to keybinding_registry only -- i.e.
    # keys an activated extension actually contributed, never the built-in
    # vim/IDE defaults that live in keybinding_manager.config. Callers use
    # this to decide whether a key belongs to an extension at all before
    # deciding what to do when that extension's command has no handler.
    fn contributed_keybinding_command(key: text, mode: text) -> text:
        for entry in me.keybinding_registry:
            val binding = entry.binding
            if binding.key == key and (binding.mode == mode or binding.mode == ""):
                return binding.command
        ""

    me _unregister_context(name: text):
        var new_contexts: [ExtensionContextEntry] = []
        for entry in me.context_registry:
            if entry.extension_name != name:
                new_contexts.push(entry)
        me.context_registry = new_contexts

fn extension_contribute_highlighting(host: ExtensionHost, language_id: text, line: text) -> text:
    line

fn extension_contribute_completions(host: ExtensionHost, language_id: text, prefix: text) -> [text]:
    if language_id == "simple":
        return extension_simple_keyword_completions(prefix)
    var empty: [text] = []
    empty

fn extension_simple_keyword_completions(prefix: text) -> [text]:
    val keywords = ["fn", "val", "var", "if", "else", "while", "for", "return", "struct", "class", "enum", "use"]
    var result: [text] = []
    for keyword in keywords:
        if prefix == "" or keyword.starts_with(prefix):
            result.push(keyword)
    result

fn extension_runtime_policy_default() -> ExtensionRuntimePolicy:
    ExtensionRuntimePolicy(
        enabled: false,
        allow_external_process: false,
        allowed_roots: []
    )

fn extension_runtime_policy_sandboxed(allowed_roots: [text]) -> ExtensionRuntimePolicy:
    ExtensionRuntimePolicy(
        enabled: true,
        allow_external_process: false,
        allowed_roots: allowed_roots
    )

fn extension_runtime_policy_external_process(allowed_roots: [text]) -> ExtensionRuntimePolicy:
    ExtensionRuntimePolicy(
        enabled: true,
        allow_external_process: true,
        allowed_roots: allowed_roots
    )

# Index every builtin manifest from the registration seam (builtin/index.spl)
# and wire its activation hook, WITHOUT activating anything. This is the
# genuinely lazy construction: the returned host has 0 active extensions, no
# contributed command/language/adapter registered, and no activation hook run
# until a declared activation event fires (`activate_language` /
# `activate_command` / `dispatch_command`).
#
# All 14 builtins are reachable this way: `sheets-function-registry-demo` and
# `slides-layout-registry-demo` declare their own contributed command id
# ("onCommand:sheets.function.double" / "onCommand:slides.layout.titleDiagram")
# as an activation event alongside their original registry-publish event, so
# `activate_command` can reach them (see builtin/sheets_ext.spl,
# builtin/slides_ext.spl).
fn extension_host_with_builtins_indexed() -> ExtensionHost:
    val host = ExtensionHost.new()
    for manifest in builtin_manifest_providers():
        host.register_manifest(manifest, "<builtin>")
    for hook_entry in builtin_activation_hooks():
        host.register_activation_hook(hook_entry.name, hook_entry.hook)
    host

# Builtin host as the app ships it: genuinely lazy, identical to the indexed
# constructor. Formerly this layered an explicit activate-all loop on top
# (every builtin capability could only ever report the terminal `bound`
# state); removed 2026-07-31, see
# doc/08_tracking/bug/builtin_extensions_activate_eagerly_2026-07-30.md.
fn extension_host_with_builtins() -> ExtensionHost:
    extension_host_with_builtins_indexed()

# Builtin host WITH the builtin command handlers attached -- the dispatch half
# of a builtin contribution, which `extension_host_with_builtins()` alone does
# not supply.
#
# These five registrations used to live inside `EditorController.new()`, on a
# host that constructor built for itself. Every other caller of
# `extension_host_with_builtins()` -- notably the IDE capability census in
# app/ide/capabilities.spl -- therefore got a host on which NO contributed
# command was dispatchable, and could never honestly report `bound`. The
# handlers are plain free functions, not closures over controller state, so
# there is nothing controller-specific about registering them here.
#
# sheets joined markdown here 2026-07-31: `sheets.function.double` was already
# backed by a real evaluator (`_double_eval`, published into the sheet function
# registry by builtin/sheets_ext.spl) but had no dispatch handler, so the
# capability could only reach `activatable`. `sheets_function_double_handler`
# evaluates through the same `sheet_function_registry_evaluate` path formula.spl
# uses -- it binds an existing implementation, it does not add a new one.
#
# The remaining manifest-only builtins (spl/graph/slides/writer/...) contribute
# commands but ship no handler yet; their capabilities stay `activatable`, which
# is the truthful reading. Do NOT register a do-nothing handler to move that
# number -- see the "CRITICAL" section of
# doc/08_tracking/bug/builtin_extensions_activate_eagerly_2026-07-30.md.
fn extension_host_with_builtin_handlers() -> ExtensionHost:
    val host = extension_host_with_builtins()
    host.register_command_handler("markdown-language", "markdown.toggle_bold",
        "Markdown: Toggle Bold", md_toggle_bold_handler)
    host.register_command_handler("markdown-language", "markdown.toggle_task",
        "Markdown: Toggle Task", md_toggle_task_handler)
    host.register_command_handler("markdown-language", "markdown.provide_diagnostics",
        "Markdown: Provide Diagnostics", md_language_diagnose_handler)
    host.register_command_handler("markdown-language", "markdown.provide_completions",
        "Markdown: Provide Completions", md_language_complete_handler)
    host.register_command_handler("markdown-language", "markdown.provide_hover",
        "Markdown: Provide Hover", md_language_hover_handler)
    host.register_command_handler("sheets-function-registry-demo", "sheets.function.double",
        "Insert DOUBLE(n)", sheets_function_double_handler)
    host

# ---- shared singleton for process-global registry readers ------------------
#
# sheets/formula.spl (function_registry) and slides/slide.spl + slides_app.spl
# (layout_registry) read their extension-contributed data from process-global
# registries directly, not through a threaded ExtensionHost -- formula.spl is
# a 9.7k-line evaluator called per cell, so threading a typed provider handle
# through its whole call chain was judged out of proportion to this fix (see
# the bug doc's fix-direction #1 "at minimum" alternative). Instead, those
# readers call `extension_host_ensure_command_activated(command_id)` once
# before consulting their registry -- a real onCommand: activation event,
# not activation-at-construction. List-of-one storage mirrors
# function_registry.spl's / layout_registry.spl's own singleton pattern (a
# class instance read back out of an array is not guaranteed to alias the
# stored element).
var _extension_host_singleton: [ExtensionHost] = []
var _extension_host_activated_commands: [text] = []

fn extension_host_singleton() -> ExtensionHost:
    if _extension_host_singleton.len() > 0:
        return _extension_host_singleton[0]
    val host = extension_host_with_builtins_indexed()
    _extension_host_singleton = [host]
    host

# Idempotent per process: activates the extension backing `command_id` at
# most once. Safe to call on every read (per-cell formula eval, per-render UI
# build) -- after the first call it is an O(k) scan of the small
# already-activated-commands list, not a re-scan of every extension.
fn extension_host_ensure_command_activated(command_id: text):
    for done in _extension_host_activated_commands:
        if done == command_id:
            return
    var host = extension_host_singleton()
    host.activate_command(command_id)
    _extension_host_singleton = [host]
    _extension_host_activated_commands = _extension_host_activated_commands.push(command_id)
