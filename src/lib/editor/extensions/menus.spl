# Menu Contribution Registry — typed menu-item descriptors, filtered by
# When-clause context and returned in deterministic order.
#
# Unlike CommandRegistry there is no duplicate-id rejection here: several
# extensions legitimately contribute different items to the same menu, so
# every registration is kept and `items_for` does the narrowing.
#
# Provides: MenuItemDescriptor, MenuRegistry.

use std.editor.extensions.api.{Disposable, WhenPredicate, ContextKeys, when_eval}

struct MenuItemDescriptor:
    menu_id: text
    command_id: text
    title: text
    when: WhenPredicate?
    order: i64

class MenuRegistration:
    descriptor: MenuItemDescriptor
    owner: text
    disposable_id: text

class MenuRegistry:
    entries: [MenuRegistration]
    next_id: i64

    static fn new() -> MenuRegistry:
        MenuRegistry(entries: [], next_id: 0)

    me register(owner: text, descriptor: MenuItemDescriptor) -> Disposable:
        val disposable_id = "menu-" + self.next_id.to_text()
        self.next_id = self.next_id + 1
        self.entries = self.entries.push(MenuRegistration(
            descriptor: descriptor,
            owner: owner,
            disposable_id: disposable_id
        ))
        Disposable(id: disposable_id, kind: "menu-item", owner: owner)

    me dispose(disposable_id: text) -> bool:
        var removed = false
        var kept: [MenuRegistration] = []
        for entry in self.entries:
            if entry.disposable_id == disposable_id:
                removed = true
            else:
                kept.push(entry)
        self.entries = kept
        removed

    me dispose_owner(owner: text) -> i64:
        var removed = 0
        var kept: [MenuRegistration] = []
        for entry in self.entries:
            if entry.owner == owner:
                removed = removed + 1
            else:
                kept.push(entry)
        self.entries = kept
        removed

    # Items contributed to `menu_id` whose `when` predicate (if any)
    # evaluates true against `ctx`, sorted by `order` ascending then by
    # `command_id` (bytewise) as a deterministic tie-break.
    fn items_for(self, menu_id: text, ctx: ContextKeys) -> [MenuItemDescriptor]:
        var matched: [MenuItemDescriptor] = []
        for entry in self.entries:
            if entry.descriptor.menu_id == menu_id:
                val ok = match entry.descriptor.when:
                    case Some(p):
                        when_eval(p, ctx)
                    case None:
                        true
                if ok:
                    matched.push(entry.descriptor)
        _menu_sort(matched)

    fn count(self) -> i64:
        self.entries.len()

# ---- deterministic ordering -------------------------------------------------

fn _menu_sort(items: [MenuItemDescriptor]) -> [MenuItemDescriptor]:
    var out: [MenuItemDescriptor] = []
    for item in items:
        out.push(item)
    var i = 1
    while i < out.len():
        val cur = out[i]
        var j = i - 1
        var moving = true
        while moving and j >= 0:
            if _menu_item_lt(cur, out[j]):
                out[j + 1] = out[j]
                j = j - 1
            else:
                moving = false
        out[j + 1] = cur
        i = i + 1
    out

fn _menu_item_lt(a: MenuItemDescriptor, b: MenuItemDescriptor) -> bool:
    if a.order != b.order:
        return a.order < b.order
    _menu_text_lt(a.command_id, b.command_id)

# Bytewise text comparison -- deliberately not the `<` operator, whose
# native-codegen form compares text by raw pointer (nondeterministic
# ordering); see encode.spl's _sdn_enc_text_lt for the same guard.
fn _menu_text_lt(a: text, b: text) -> bool:
    val ab = a.bytes()
    val bb = b.bytes()
    var i = 0
    while i < ab.len() and i < bb.len():
        val ca = ab[i].to_i64()
        val cb = bb[i].to_i64()
        if ca < cb:
            return true
        if ca > cb:
            return false
        i = i + 1
    ab.len() < bb.len()
