# Built-in Writer Extension
#
# Declares the "simple.rich_document" document kind and the writer.* command
# surface (bold/italic/underline/headings/bullet-list/quote/outline/undo/
# redo/save). The real handlers live on WordApp's CommandRegistry
# (src/app/office/word/word_app.spl) -- this manifest is the typed,
# host-visible declaration of that same writer.* command surface, matching
# md_language_manifest/sheets_ext_manifest's pattern of declaring commands
# the app itself owns and runs.

use std.editor.extensions.manifest.{ExtensionManifest, ExtensionCommand, ExtensionCustomEditor,
    extension_manifest_basic}

fn writer_ext_manifest() -> ExtensionManifest:
    var m = extension_manifest_basic(
        "writer", "1.0.0", "",
        ["onCommand:writer.format_bold", "onCommand:writer.save"],
        [
            ExtensionCommand(id: "writer.format_bold", title: "Writer: Bold", category: "Writer"),
            ExtensionCommand(id: "writer.format_italic", title: "Writer: Italic", category: "Writer"),
            ExtensionCommand(id: "writer.format_underline", title: "Writer: Underline", category: "Writer"),
            ExtensionCommand(id: "writer.format_h1", title: "Writer: Heading 1", category: "Writer"),
            ExtensionCommand(id: "writer.format_h2", title: "Writer: Heading 2", category: "Writer"),
            ExtensionCommand(id: "writer.format_h3", title: "Writer: Heading 3", category: "Writer"),
            ExtensionCommand(id: "writer.format_bullet_list", title: "Writer: Bullet List", category: "Writer"),
            ExtensionCommand(id: "writer.format_quote", title: "Writer: Quote", category: "Writer"),
            ExtensionCommand(id: "writer.toggle_outline", title: "Writer: Toggle Outline", category: "Writer"),
            ExtensionCommand(id: "writer.undo", title: "Writer: Undo", category: "Writer"),
            ExtensionCommand(id: "writer.redo", title: "Writer: Redo", category: "Writer"),
            ExtensionCommand(id: "writer.save", title: "Writer: Save", category: "Writer")
        ],
        []
    )
    m.contributes_custom_editors = [
        ExtensionCustomEditor(id: "writer.rich_document_editor", document_kind: "simple.rich_document", priority: 0)
    ]
    m
