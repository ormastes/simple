# Built-in Slides Extension
#
# Declares the "slides" document kind and demonstrates the slide
# layout_registry extension point (app.office.slides.layout_registry) by
# registering a fixture third-party layout, "title_diagram" (a title
# placeholder plus one large content placeholder), standing in for a real
# third-party extension. Registering it is a separate step
# (`slides_ext_register_builtins`) from the manifest (`slides_ext_manifest`)
# because the extension host does not yet execute extension entry code (see
# .spipe/ide_extension_kernel/state.md "external entrypoint execution not
# wired (L6)") -- callers that want the fixture layout live must call the
# register step explicitly, same as sheets_ext.spl's DOUBLE() fixture.

use std.editor.extensions.manifest.{ExtensionManifest, ExtensionCommand, ExtensionCustomEditor,
    extension_manifest_basic}
use app.office.slides.layout_registry.{SlideLayoutDescriptor, PlaceholderSpec,
    slide_layout_registry_register, slide_layout_registry_has}

fn slides_ext_manifest() -> ExtensionManifest:
    var m = extension_manifest_basic(
        "slides-layout-registry-demo", "1.0.0", "",
        ["onLayoutRegistry:slides"],
        [ExtensionCommand(id: "slides.layout.titleDiagram", title: "Insert Title + Diagram layout", category: "Slides Layouts")],
        []
    )
    m.contributes_custom_editors = [
        ExtensionCustomEditor(id: "slides.canvas", document_kind: "slides", priority: 0)
    ]
    m

fn _title_diagram_descriptor() -> SlideLayoutDescriptor:
    SlideLayoutDescriptor(
        id: "title_diagram",
        display_name: "Title + Diagram",
        placeholders: [
            PlaceholderSpec(kind: "title", default_text: "Title", x: 50, y: 30, width: 860, height: 60),
            PlaceholderSpec(kind: "diagram", default_text: "Diagram goes here", x: 50, y: 110, width: 860, height: 400)
        ]
    )

fn slides_ext_register_builtins() -> bool:
    """Activate the fixture extension: register the "title_diagram" layout
    into the slide layout registry. Idempotent -- returns false (no-op) if
    the id is already registered, same as any other duplicate-registration
    attempt."""
    if slide_layout_registry_has("title_diagram"):
        return false
    slide_layout_registry_register(_title_diagram_descriptor())
