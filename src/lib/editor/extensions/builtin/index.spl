# Builtin Extension Index — the single registration seam for builtin
# extension manifests. One provider line per domain; lanes append exactly
# their own line (plan §S6).

use std.editor.extensions.manifest.{ExtensionManifest}
use std.editor.extensions.builtin.md_language.{md_language_manifest}
use std.editor.extensions.builtin.spl_language.{spl_language_manifest}
use std.editor.extensions.builtin.graph_language.{graph_language_manifest}
use std.editor.extensions.builtin.sheets_ext.{sheets_ext_manifest, sheets_ext_activation_hook}
use std.editor.extensions.builtin.slides_ext.{slides_ext_manifest, slides_ext_activation_hook}
use std.editor.extensions.builtin.writer_ext.{writer_ext_manifest}
use std.editor.extensions.builtin.draw_sdd_ext.{draw_sdd_ext_manifest}
use std.editor.extensions.builtin.designer_ext.{designer_ext_manifest}
use std.editor.extensions.builtin.base_ext.{base_ext_manifest}
use std.editor.extensions.builtin.math_ext.{math_ext_manifest}
use std.editor.extensions.builtin.mail_ext.{mail_ext_manifest}
use std.editor.extensions.builtin.planner_ext.{planner_ext_manifest}
use std.editor.extensions.builtin.agent_dashboard_ext.{agent_dashboard_ext_manifest}
use std.editor.extensions.builtin.db_admin_ext.{db_admin_ext_manifest}

fn builtin_manifest_providers() -> [ExtensionManifest]:
    var out: [ExtensionManifest] = []
    out.push(spl_language_manifest())     # spl
    out.push(md_language_manifest())      # markdown
    out.push(graph_language_manifest())   # graph
    out.push(sheets_ext_manifest())       # sheets
    out.push(slides_ext_manifest())       # slides
    out.push(writer_ext_manifest())       # writer
    out.push(draw_sdd_ext_manifest())     # draw-sdd (F5)
    out.push(designer_ext_manifest())     # designer (F5)
    out.push(base_ext_manifest())         # base (F5)
    out.push(math_ext_manifest())         # math (F5)
    out.push(mail_ext_manifest())         # mail (F5)
    out.push(planner_ext_manifest())      # planner (F5)
    out.push(agent_dashboard_ext_manifest()) # agent-dashboard (F5)
    out.push(db_admin_ext_manifest())     # db-admin (F5)
    out

# Activation hooks (L6b): builtins whose registration is more than a
# manifest -- sheets/slides register a fixture registry entry (DOUBLE(n),
# title_diagram) that used to require a manual, separately-called
# `*_register_builtins()` step. The host now runs these automatically the
# first time each extension activates (ExtensionHost.register_activation_hook
# / activate()). One entry per builtin that needs one; spl/md/graph declare
# no entry code and need none.
struct BuiltinActivationHookEntry:
    name: text
    hook: fn(text) -> Result<text, text>

fn builtin_activation_hooks() -> [BuiltinActivationHookEntry]:
    var out: [BuiltinActivationHookEntry] = []
    out.push(BuiltinActivationHookEntry(name: sheets_ext_manifest().name, hook: sheets_ext_activation_hook))
    out.push(BuiltinActivationHookEntry(name: slides_ext_manifest().name, hook: slides_ext_activation_hook))
    out
