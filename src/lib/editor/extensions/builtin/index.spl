# Builtin Extension Index — the single registration seam for builtin
# extension manifests. One provider line per domain; lanes append exactly
# their own line (plan §S6).

use std.editor.extensions.manifest.{ExtensionManifest}
use std.editor.extensions.builtin.md_language.{md_language_manifest}
use std.editor.extensions.builtin.spl_language.{spl_language_manifest}
use std.editor.extensions.builtin.graph_language.{graph_language_manifest}
use std.editor.extensions.builtin.sheets_ext.{sheets_ext_manifest}
use std.editor.extensions.builtin.slides_ext.{slides_ext_manifest}

fn builtin_manifest_providers() -> [ExtensionManifest]:
    var out: [ExtensionManifest] = []
    out.push(spl_language_manifest())     # spl
    out.push(md_language_manifest())      # markdown
    out.push(graph_language_manifest())   # graph
    out.push(sheets_ext_manifest())       # sheets
    out.push(slides_ext_manifest())       # slides
    out
