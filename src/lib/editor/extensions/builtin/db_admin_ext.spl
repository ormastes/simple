# Built-in Database Admin Extension
#
# Declares the "embedded-db" document kind and the db-admin.* command
# surface. The real state-persistence logic lives on SessionDb (the editor
# session database, src/lib/editor/core/session_db.spl, owner_module of the
# "db-admin" IDE capability, shared with the "base" capability's own
# command surface in base_ext.spl): SessionDb.save_editor_state persists the
# active document/mode/group-count record (line 31),
# SessionDb.load_editor_state reads that record back (line 39), and
# SessionDb.checkpoint flushes the WAL to the portal-db file (line 42). This
# manifest is the typed, host-visible declaration of that command surface,
# matching writer_ext_manifest's pattern of declaring commands the app
# itself owns and runs.

use std.editor.extensions.manifest.{ExtensionManifest, ExtensionCommand, ExtensionLanguage,
    extension_manifest_basic}

fn db_admin_ext_manifest() -> ExtensionManifest:
    extension_manifest_basic(
        "db-admin", "1.0.0", "",
        ["onCommand:db-admin.save_state", "onCommand:db-admin.checkpoint"],
        [
            ExtensionCommand(id: "db-admin.save_state", title: "DB Admin: Save Editor State", category: "DB Admin"),
            ExtensionCommand(id: "db-admin.load_state", title: "DB Admin: Load Editor State", category: "DB Admin"),
            ExtensionCommand(id: "db-admin.checkpoint", title: "DB Admin: Checkpoint", category: "DB Admin")
        ],
        [ExtensionLanguage(id: "embedded-db", extensions: ["simple-db", "portal-db"])]
    )
