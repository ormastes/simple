# Built-in Agent Dashboard Extension
#
# Declares the "mcp" document kind and the agent-dashboard.* command
# surface. The real tool-catalog logic lives on the editor MCP tool registry
# (src/app/editor/mcp_tools.spl, owner_module of the "agent-dashboard" IDE
# capability): editor_mcp_tools() returns the stable catalog of MCP tools
# the editor exposes to agents -- open_file, read_buffer, edit, search,
# diagnostics, goto_definition, and the LSP-backed tools (line 31-52),
# built from the mcp_tool/mcp_tool_with_param constructors (line 17, 24).
# This manifest is the typed, host-visible declaration of that command
# surface, matching writer_ext_manifest's pattern of declaring commands the
# app itself owns and runs.

use std.editor.extensions.manifest.{ExtensionManifest, ExtensionCommand, ExtensionLanguage,
    extension_manifest_basic}

fn agent_dashboard_ext_manifest() -> ExtensionManifest:
    extension_manifest_basic(
        "agent-dashboard", "1.0.0", "",
        ["onCommand:agent-dashboard.list_tools"],
        [
            ExtensionCommand(id: "agent-dashboard.list_tools", title: "Agent Dashboard: List MCP Tools", category: "Agent Dashboard")
        ],
        [ExtensionLanguage(id: "dashboard", extensions: ["agent", "mcp"])]
    )
