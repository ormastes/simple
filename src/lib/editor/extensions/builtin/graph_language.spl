# Built-in SDN Graph Language Extension
#
# Registers compact SDN graph blocks and files with the editor extension host.

use std.editor.extensions.manifest.{ExtensionManifest, ExtensionCommand, ExtensionLanguage,
    extension_manifest_basic}

fn graph_language_manifest() -> ExtensionManifest:
    extension_manifest_basic(
        "sdn-graph-language", "1.0.0", "",
        ["onLanguage:sdn-graph"],
        [
            ExtensionCommand(id: "graph.render", title: "Render SDN Graph", category: "Graph"),
            ExtensionCommand(id: "graph.showCanonical", title: "Show Canonical SDN Graph", category: "Graph")
        ],
        [ExtensionLanguage(id: "sdn-graph", extensions: [".graph.sdn", ".sdngraph"])]
    )

fn graph_language_id() -> text:
    "sdn-graph"

fn graph_language_block_fences() -> [text]:
    ["sdn-graph", "graph"]
