# Built-in Mail Extension
#
# Declares the "message" document kind and the mail.* command surface. The
# real compose/list/read logic lives on MailApp, the three-column mail
# client (src/app/office/mail/mail_app.spl): MailApp.handle_event dispatches
# the "compose" UIEvent.Action into composing=true (line 65-71),
# MailApp.filtered_emails returns the active folder's matching emails (line
# 102), and MailApp.unread_count counts unread mail in the active folder
# (line 120). This manifest is the typed, host-visible declaration of that
# command surface, matching writer_ext_manifest's pattern of declaring
# commands the app itself owns and runs.
#
# NOTE (IDE extension kernel campaign, lane F5): app.ide.capabilities' "mail"
# row used to list owner_module std.hardware.soc_rtl.mailbox -- a GHDL SoC test
# peripheral with no command surface resembling a mail client. This manifest
# always derived its commands from MailApp, the actual office app implementing
# "Mail". The owner_module was corrected to app.office.mail on 2026-07-30, and
# the feature-check row now runs a real probe (app.ide.mail_sanity) instead of
# reporting "manifest-only" -- which is what let the wrong owner survive.

use std.editor.extensions.manifest.{ExtensionManifest, ExtensionCommand, ExtensionLanguage,
    extension_manifest_basic}

fn mail_ext_manifest() -> ExtensionManifest:
    extension_manifest_basic(
        "mail", "1.0.0", "",
        ["onCommand:mail.compose", "onCommand:mail.list_folder"],
        [
            ExtensionCommand(id: "mail.compose", title: "Mail: Compose", category: "Mail"),
            ExtensionCommand(id: "mail.list_folder", title: "Mail: List Folder", category: "Mail"),
            ExtensionCommand(id: "mail.unread_count", title: "Mail: Unread Count", category: "Mail")
        ],
        [ExtensionLanguage(id: "message", extensions: ["folder", "compose"])]
    )
