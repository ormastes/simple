# Built-in Base (embedded-database) Extension
#
# Declares the "database" document kind and the base.* command surface. The
# real save/load/checkpoint logic lives on SessionDb (the editor session
# database, src/lib/editor/core/session_db.spl, owner_module of the "base"
# IDE capability): SessionDb.save_open_tab (persist one open tab, line 24),
# SessionDb.load_tabs (read back persisted tabs, line 35), and
# SessionDb.checkpoint (flush the WAL to the base table file, line 42). This
# manifest is the typed, host-visible declaration of that command surface,
# matching writer_ext_manifest's pattern of declaring commands the app
# itself owns and runs.

use std.editor.extensions.manifest.{ExtensionManifest, ExtensionCommand, ExtensionLanguage,
    extension_manifest_basic}

fn base_ext_manifest() -> ExtensionManifest:
    extension_manifest_basic(
        "base", "1.0.0", "",
        ["onCommand:base.save_tab", "onCommand:base.checkpoint"],
        [
            ExtensionCommand(id: "base.save_tab", title: "Base: Save Open Tab", category: "Base"),
            ExtensionCommand(id: "base.load_tabs", title: "Base: Load Tabs", category: "Base"),
            ExtensionCommand(id: "base.checkpoint", title: "Base: Checkpoint", category: "Base")
        ],
        [ExtensionLanguage(id: "database", extensions: ["table"])]
    )
