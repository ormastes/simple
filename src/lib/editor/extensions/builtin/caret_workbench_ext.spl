# Built-in Caret workbench extension (schema simple.ide.extension/2).
#
# Declares the Caret view container and its views (plan 5.3). Providers are
# only NAMED here (ids); rendering lives in the TUI/GUI shells. The manifest is
# authored as SDN text and decoded by the real manifest decoder, so a decode
# diagnostic is visible to callers (see caret_workbench_ext_load).
#
# Activated only by the `caret` profile through the `onProfile:caret` event
# (app/editor/profile_plan.spl); the `editor` profile and `event:*` never
# match it. Deactivation drops registrations only -- it never stops a session.

use std.editor.extensions.manifest.{ExtensionManifest}
use std.editor.extensions.manifest_sdn.{ExtensionManifestLoad, extension_manifest_decode}

fn caret_workbench_ext_sdn() -> text:
    "extension:\n" +
    "  schema: simple.ide.extension/2\n" +
    "  id: caret.workbench\n" +
    "  display_name: Caret Workbench\n" +
    "  version: 1.0.0\n" +
    "  host: builtin\n" +
    "permissions:\n" +
    "  workspace_read: true\n" +
    "  process_spawn: true\n" +
    "activation:\n" +
    '  events: ["onProfile:caret", "onCommand:caret.agent.quick_switch"]' + "\n" +
    "contributes:\n" +
    '  commands: [{id: "caret.agent.quick_switch", title: "Switch Agent", category: "Caret"}, {id: "caret.agent.next_attention", title: "Next Agent Needing Attention", category: "Caret"}, {id: "trace.refs_current_file", title: "Trace References for Current File", category: "Traceability"}]' + "\n" +
    '  view_containers: [{id: "caret.agents", title: "Agents", location: "activitybar", order: 3}]' + "\n" +
    '  views: [{id: "caret.agent_roster", kind: "tree", container: "caret.agents", provider: "caret.session_roster"}, {id: "caret.attention_inbox", kind: "list", container: "caret.agents", provider: "caret.attention_queue"}, {id: "caret.terminal", kind: "terminal", container: "caret.agents", provider: "caret.active_terminal"}, {id: "caret.composer", kind: "composer", container: "caret.agents", provider: "caret.active_composer"}, {id: "trace.explorer", kind: "tree", container: "caret.agents", provider: "trace.explorer_provider"}]' + "\n"

fn caret_workbench_ext_load() -> ExtensionManifestLoad:
    extension_manifest_decode(caret_workbench_ext_sdn())

fn caret_workbench_ext_manifest() -> ExtensionManifest:
    caret_workbench_ext_load().manifest

export caret_workbench_ext_sdn, caret_workbench_ext_load, caret_workbench_ext_manifest
