# Settings Registry — typed setting descriptors + a values overlay, with
# SDN load/save of the values file.
#
# Conflict policy: first registration wins for a given `key`; later
# duplicates are ignored and recorded in `conflicts` (mirrors
# CommandRegistry in registry.spl). Querying or setting a key that was
# never registered is not an error: it is recorded in `diagnostics` and
# treated as absent ("" effective value / false result).
#
# Provides: SettingDescriptor, SettingValueEntry, SettingsRegistry.

use std.editor.extensions.api.{Disposable}
use std.common.sdn.value.{SdnValue}
use std.common.sdn.parser.{parse}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.io_runtime.{file_read, file_write, file_exists}

# `kind` names the setting's value shape: "bool" | "int" | "text" | "enum".
# (Named `kind`, not `type`, to stay clear of the `type Alias = ...` grammar.)
struct SettingDescriptor:
    key: text
    kind: text
    default: text
    description: text
    enum_values: [text]

class SettingRegistration:
    descriptor: SettingDescriptor
    owner: text
    disposable_id: text

struct SettingValueEntry:
    key: text
    value: text

class SettingsRegistry:
    entries: [SettingRegistration]
    conflicts: [text]
    values: [SettingValueEntry]
    diagnostics: [text]
    next_id: i64

    static fn new() -> SettingsRegistry:
        SettingsRegistry(entries: [], conflicts: [], values: [], diagnostics: [], next_id: 0)

    # First registration for a dot-namespaced key wins.
    me register(owner: text, descriptor: SettingDescriptor) -> Disposable:
        val disposable_id = "set-" + self.next_id.to_text()
        self.next_id = self.next_id + 1
        var i = 0
        while i < self.entries.len():
            if self.entries[i].descriptor.key == descriptor.key:
                self.conflicts = self.conflicts.push(
                    "duplicate setting key '" + descriptor.key + "': kept '" +
                    self.entries[i].owner + "', ignored '" + owner + "'")
                return Disposable(id: disposable_id, kind: "setting-conflict", owner: owner)
            i = i + 1
        self.entries = self.entries.push(SettingRegistration(
            descriptor: descriptor,
            owner: owner,
            disposable_id: disposable_id
        ))
        Disposable(id: disposable_id, kind: "setting", owner: owner)

    fn has(self, key: text) -> bool:
        for entry in self.entries:
            if entry.descriptor.key == key:
                return true
        false

    fn default_of(self, key: text) -> text:
        for entry in self.entries:
            if entry.descriptor.key == key:
                return entry.descriptor.default
        ""

    fn descriptor_kind(self, key: text) -> text:
        for entry in self.entries:
            if entry.descriptor.key == key:
                return entry.descriptor.kind
        ""

    # Effective value = the values overlay entry if set, else the
    # registered default. Querying an unregistered key records a
    # diagnostic and returns "".
    me get_effective(key: text) -> text:
        if not self.has(key):
            self.diagnostics = self.diagnostics.push("unknown setting key '" + key + "'")
            return ""
        var i = 0
        while i < self.values.len():
            if self.values[i].key == key:
                return self.values[i].value
            i = i + 1
        self.default_of(key)

    # Writes into the values overlay. Unregistered keys are rejected (with
    # a diagnostic) rather than silently accepted.
    me set_value(key: text, value: text) -> bool:
        if not self.has(key):
            self.diagnostics = self.diagnostics.push("unknown setting key '" + key + "'")
            return false
        var i = 0
        while i < self.values.len():
            if self.values[i].key == key:
                var vs = self.values
                vs[i] = SettingValueEntry(key: key, value: value)
                self.values = vs
                return true
            i = i + 1
        self.values = self.values.push(SettingValueEntry(key: key, value: value))
        true

    # Removes the values-overlay entry so get_effective falls back to the
    # registered default. Returns false if there was nothing to remove.
    me reset(key: text) -> bool:
        var removed = false
        var kept: [SettingValueEntry] = []
        for entry in self.values:
            if entry.key == key:
                removed = true
            else:
                kept.push(entry)
        self.values = kept
        removed

    me dispose(disposable_id: text) -> bool:
        var removed = false
        var kept: [SettingRegistration] = []
        for entry in self.entries:
            if entry.disposable_id == disposable_id:
                removed = true
            else:
                kept.push(entry)
        self.entries = kept
        removed

    me dispose_owner(owner: text) -> i64:
        var removed = 0
        var kept: [SettingRegistration] = []
        for entry in self.entries:
            if entry.owner == owner:
                removed = removed + 1
            else:
                kept.push(entry)
        self.entries = kept
        removed

    # Stable insertion order.
    fn setting_keys(self) -> [text]:
        var out: [text] = []
        for entry in self.entries:
            out.push(entry.descriptor.key)
        out

    fn count(self) -> i64:
        self.entries.len()

    fn conflict_count(self) -> i64:
        self.conflicts.len()

    fn diagnostic_count(self) -> i64:
        self.diagnostics.len()

    # ---- SDN load/save of the values overlay --------------------------------
    # settings.sdn shape: a flat dict of key -> value (values stored as
    # text; typed accessors above are the interpretation layer).

    me save_values(path: text) -> bool:
        file_write(path, sdn_encode_canonical(_settings_values_to_sdn(self.values)))

    # Replaces the whole values overlay with what's on disk. Returns false
    # (leaving the overlay untouched) if the file is missing or unparsable.
    me load_values(path: text) -> bool:
        if not file_exists(path):
            return false
        match parse(file_read(path)):
            case Ok(v):
                self.values = _settings_values_from_sdn(v)
                true
            case Err(_):
                false

fn _settings_values_to_sdn(values: [SettingValueEntry]) -> SdnValue:
    # Built as one local mutable dict and wrapped once at the end -- per
    # the SdnValue.insert() dead-copy defect, writing through insert() on
    # a value already returned from a constructor silently no-ops.
    var d: Dict<text, SdnValue> = {}
    for entry in values:
        d[entry.key] = SdnValue.String(entry.value)
    SdnValue.Dict(d)

fn _settings_values_from_sdn(v: SdnValue) -> [SettingValueEntry]:
    var out: [SettingValueEntry] = []
    match v.as_dict():
        case Some(d):
            for k in d.keys():
                match d[k].as_str():
                    case Some(s):
                        out.push(SettingValueEntry(key: k, value: s))
                    case None:
                        out.push(SettingValueEntry(key: k, value: d[k].to_text()))
        case None:
            pass_do_nothing
    out
