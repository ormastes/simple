# Keybinding Contribution Registry — chord -> command resolution, gated by
# When-clause context, with last-registered-wins among matching entries.
#
# Unlike CommandRegistry, registering the same chord twice is not rejected
# (that's exactly how one extension can override a base binding, or how two
# extensions can both offer bindings gated by mutually-exclusive `when`
# clauses); `resolve` walks registrations in order and the last
# when-matching one wins, and `conflicts` surfaces chords with more than
# one registration so a shell UI can flag them.
#
# Provides: KeybindingDescriptor, KeybindingRegistry.

use std.editor.extensions.api.{Disposable, WhenPredicate, ContextKeys, when_eval}

struct KeybindingDescriptor:
    key_chord: text
    command_id: text
    when: WhenPredicate?

class KeybindingRegistration:
    descriptor: KeybindingDescriptor
    owner: text
    disposable_id: text

class KeybindingRegistry:
    entries: [KeybindingRegistration]
    next_id: i64

    static fn new() -> KeybindingRegistry:
        KeybindingRegistry(entries: [], next_id: 0)

    me register(owner: text, descriptor: KeybindingDescriptor) -> Disposable:
        val disposable_id = "key-" + self.next_id.to_text()
        self.next_id = self.next_id + 1
        self.entries = self.entries.push(KeybindingRegistration(
            descriptor: descriptor,
            owner: owner,
            disposable_id: disposable_id
        ))
        Disposable(id: disposable_id, kind: "keybinding", owner: owner)

    me dispose(disposable_id: text) -> bool:
        var removed = false
        var kept: [KeybindingRegistration] = []
        for entry in self.entries:
            if entry.disposable_id == disposable_id:
                removed = true
            else:
                kept.push(entry)
        self.entries = kept
        removed

    me dispose_owner(owner: text) -> i64:
        var removed = 0
        var kept: [KeybindingRegistration] = []
        for entry in self.entries:
            if entry.owner == owner:
                removed = removed + 1
            else:
                kept.push(entry)
        self.entries = kept
        removed

    # Last-registered-wins among the entries for `key_chord` whose `when`
    # (if any) matches `ctx`. None if the chord has no matching binding.
    fn resolve(self, key_chord: text, ctx: ContextKeys) -> text?:
        var result: text? = None
        for entry in self.entries:
            if entry.descriptor.key_chord == key_chord:
                val ok = match entry.descriptor.when:
                    case Some(p):
                        when_eval(p, ctx)
                    case None:
                        true
                if ok:
                    result = Some(entry.descriptor.command_id)
        result

    # Chords with more than one registration, regardless of `when` gating
    # (two bindings gated by disjoint `when` clauses are still worth
    # surfacing to a shell UI as a potential conflict).
    fn conflicts(self) -> [text]:
        var chords: [text] = []
        var counts: [i64] = []
        for entry in self.entries:
            var found = false
            var i = 0
            while i < chords.len():
                if chords[i] == entry.descriptor.key_chord:
                    counts[i] = counts[i] + 1
                    found = true
                i = i + 1
            if not found:
                chords.push(entry.descriptor.key_chord)
                counts.push(1)
        var out: [text] = []
        var i = 0
        while i < chords.len():
            if counts[i] > 1:
                out.push(chords[i])
            i = i + 1
        out

    fn count(self) -> i64:
        self.entries.len()
