# Extension Registries — typed command handlers, event listeners, and the
# language/provider index (moved out of the host internals).
#
# Conflict policy: first registration wins; later duplicates are ignored and
# recorded as diagnostics. Ordering is stable (insertion order).
#
# Provides: CommandRegistration, CommandRegistry, EventListenerRegistry,
#           LanguageRegistration, LanguageIndex.

use std.editor.extensions.api.{Disposable}

# ---- typed command registry -------------------------------------------------

class CommandRegistration:
    command_id: text
    owner: text
    title: text
    handler_fn: fn(text) -> Result<text, text>
    disposable_id: text

class CommandRegistry:
    entries: [CommandRegistration]
    conflicts: [text]
    next_id: i64

    static fn new() -> CommandRegistry:
        CommandRegistry(entries: [], conflicts: [], next_id: 0)

    # First registration wins. A duplicate id is NOT stored; it is recorded
    # in `conflicts` and the returned Disposable (kind "command-conflict")
    # disposes nothing.
    me register(owner: text, command_id: text, title: text,
                handler_fn: fn(text) -> Result<text, text>) -> Disposable:
        val disposable_id = "cmd-" + self.next_id.to_text()
        self.next_id = self.next_id + 1
        var i = 0
        while i < self.entries.len():
            if self.entries[i].command_id == command_id:
                self.conflicts = self.conflicts.push(
                    "duplicate command id '" + command_id + "': kept '" +
                    self.entries[i].owner + "', ignored '" + owner + "'")
                return Disposable(id: disposable_id, kind: "command-conflict", owner: owner)
            i = i + 1
        self.entries = self.entries.push(CommandRegistration(
            command_id: command_id,
            owner: owner,
            title: title,
            handler_fn: handler_fn,
            disposable_id: disposable_id
        ))
        Disposable(id: disposable_id, kind: "command", owner: owner)

    fn has(self, command_id: text) -> bool:
        for entry in self.entries:
            if entry.command_id == command_id:
                return true
        false

    fn owner_of(self, command_id: text) -> text:
        for entry in self.entries:
            if entry.command_id == command_id:
                return entry.owner
        ""

    # Execute the registered handler for a command.
    me run(command_id: text, payload: text) -> Result<text, text>:
        for entry in self.entries:
            if entry.command_id == command_id:
                val callback = entry.handler_fn
                return callback(payload)
        Err("no handler registered for command '" + command_id + "'")

    me dispose(disposable_id: text) -> bool:
        var removed = false
        var kept: [CommandRegistration] = []
        for entry in self.entries:
            if entry.disposable_id == disposable_id:
                removed = true
            else:
                kept.push(entry)
        self.entries = kept
        removed

    me dispose_owner(owner: text) -> i64:
        var removed = 0
        var kept: [CommandRegistration] = []
        for entry in self.entries:
            if entry.owner == owner:
                removed = removed + 1
            else:
                kept.push(entry)
        self.entries = kept
        removed

    # Stable insertion order.
    fn command_ids(self) -> [text]:
        var out: [text] = []
        for entry in self.entries:
            out.push(entry.command_id)
        out

    fn count(self) -> i64:
        self.entries.len()

    fn conflict_count(self) -> i64:
        self.conflicts.len()

# ---- typed event listeners --------------------------------------------------

class EventListenerRegistration:
    owner: text
    event: text
    handler_fn: fn(text)
    disposable_id: text

class EventListenerRegistry:
    entries: [EventListenerRegistration]
    next_id: i64

    static fn new() -> EventListenerRegistry:
        EventListenerRegistry(entries: [], next_id: 0)

    me add(owner: text, event: text, handler_fn: fn(text)) -> Disposable:
        val disposable_id = "lsn-" + self.next_id.to_text()
        self.next_id = self.next_id + 1
        self.entries = self.entries.push(EventListenerRegistration(
            owner: owner,
            event: event,
            handler_fn: handler_fn,
            disposable_id: disposable_id
        ))
        Disposable(id: disposable_id, kind: "listener", owner: owner)

    # Invoke every listener registered for `event`; returns how many ran.
    me deliver(event: text, payload: text) -> i64:
        var delivered = 0
        for entry in self.entries:
            if entry.event == event or entry.event == "*":
                val callback = entry.handler_fn
                callback(payload)
                delivered = delivered + 1
        delivered

    me dispose(disposable_id: text) -> bool:
        var removed = false
        var kept: [EventListenerRegistration] = []
        for entry in self.entries:
            if entry.disposable_id == disposable_id:
                removed = true
            else:
                kept.push(entry)
        self.entries = kept
        removed

    me dispose_owner(owner: text) -> i64:
        var removed = 0
        var kept: [EventListenerRegistration] = []
        for entry in self.entries:
            if entry.owner == owner:
                removed = removed + 1
            else:
                kept.push(entry)
        self.entries = kept
        removed

    fn count(self) -> i64:
        self.entries.len()

# ---- language index ---------------------------------------------------------

struct LanguageRegistration:
    owner: text
    language_id: text
    extensions: [text]

class LanguageIndex:
    entries: [LanguageRegistration]

    static fn new() -> LanguageIndex:
        LanguageIndex(entries: [])

    me register(owner: text, language_id: text, extensions: [text]):
        self.entries = self.entries.push(LanguageRegistration(
            owner: owner,
            language_id: language_id,
            extensions: extensions
        ))

    me remove_owner(owner: text) -> i64:
        var removed = 0
        var kept: [LanguageRegistration] = []
        for entry in self.entries:
            if entry.owner == owner:
                removed = removed + 1
            else:
                kept.push(entry)
        self.entries = kept
        removed

    fn language_for_file_ext(self, file_ext: text) -> text:
        for entry in self.entries:
            for ext in entry.extensions:
                if ext == file_ext:
                    return entry.language_id
        ""

    fn count(self) -> i64:
        self.entries.len()
