use std.editor.kernel_plugin.facade.{EditorKpfAdmissionV1, EditorKpfFacadeStatus, EditorKpfFacadeV1}
use std.editor.extensions.manifest.ExtensionManifest

pub fn extension_kpf_admit(facade: EditorKpfFacadeV1,
        manifest: ExtensionManifest) -> EditorKpfAdmissionV1:
    facade.admit(manifest)

pub fn extension_kpf_activate_event(facade: EditorKpfFacadeV1,
        event: text, now_ns: i64) -> i64:
    facade.activate_event(event, now_ns)

pub fn extension_kpf_deactivate(facade: EditorKpfFacadeV1,
        extension_name: text) -> EditorKpfFacadeStatus:
    facade.deactivate(extension_name)
