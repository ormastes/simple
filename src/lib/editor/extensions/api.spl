# Extension API — base types for the editor extension system.
#
# Provides: ExtensionDebugAdapter, ExtensionContext, ExtensionCapability,
#           ExtensionContribution, ExtensionActivationEvent,
#           Disposable, ExtensionLifetime, EditorCancellationToken.

# ---- disposables and lifetime ----------------------------------------------

# Handle for one registration (command handler, event listener, ...).
# `kind` routes disposal back to the owning registry; `owner` is the
# extension name that made the registration.
struct Disposable:
    id: text
    kind: text
    owner: text

# Owns every Disposable an extension created while active. Deactivation
# disposes them all in one sweep.
class ExtensionLifetime:
    owner: text
    disposables: [Disposable]
    disposed: bool

    static fn new(owner: text) -> ExtensionLifetime:
        ExtensionLifetime(owner: owner, disposables: [], disposed: false)

    me add(d: Disposable):
        self.disposables = self.disposables.push(d)
        self.disposed = false

    # Clears the lifetime and returns what was registered so the caller
    # can route each Disposable to its registry for removal.
    me dispose_all() -> [Disposable]:
        val out = self.disposables
        self.disposables = []
        self.disposed = true
        out

    fn count(self) -> i64:
        self.disposables.len()

# Simple cooperative cancellation flag.
#
# Named EditorCancellationToken (not CancellationToken) to avoid colliding
# with std.async.cancellation.CancellationToken: under the interpreter,
# same-named classes in different modules share dispatch, so a `cancel()`/
# `is_cancelled()` pair here previously shadowed the real async token's
# methods and silently no-oped its `is_cancelled()` (see
# doc/08_tracking/bug/ for the repro). This type has no external callers
# today (grepped clean) so the rename is a pure disambiguation.
class EditorCancellationToken:
    cancelled: bool

    static fn new() -> EditorCancellationToken:
        EditorCancellationToken(cancelled: false)

    me cancel():
        self.cancelled = true

    fn is_cancelled(self) -> bool:
        self.cancelled

# ---- legacy context types ---------------------------------------------------

struct ExtensionDebugAdapter:
    id: text
    label: text
    program: text

struct ExtensionContext:
    name: text
    extension_id: text
    storage_path: text
    subscriptions: [text]
    workspace_state_keys: [text]
    workspace_state_values: [text]

fn extension_context_new(storage_path: text, extension_id: text) -> ExtensionContext:
    ExtensionContext(name: extension_id, extension_id: extension_id, storage_path: storage_path, subscriptions: [], workspace_state_keys: [], workspace_state_values: [])

fn extension_context_subscribe(ctx: ExtensionContext, event: text) -> ExtensionContext:
    var subscriptions: [text] = []
    for existing in ctx.subscriptions:
        if existing == event:
            return ctx
        subscriptions.push(existing)
    subscriptions.push(event)
    ExtensionContext(name: ctx.name, extension_id: ctx.extension_id, storage_path: ctx.storage_path, subscriptions: subscriptions, workspace_state_keys: ctx.workspace_state_keys, workspace_state_values: ctx.workspace_state_values)

fn extension_context_is_subscribed(ctx: ExtensionContext, event: text) -> bool:
    for existing in ctx.subscriptions:
        if existing == event or existing == "*":
            return true
    false

fn extension_context_set_state(ctx: ExtensionContext, key: text, value: text) -> ExtensionContext:
    var keys: [text] = []
    var values: [text] = []
    var replaced = false
    var i = 0
    while i < ctx.workspace_state_keys.len():
        keys.push(ctx.workspace_state_keys[i])
        if ctx.workspace_state_keys[i] == key:
            values.push(value)
            replaced = true
        else:
            values.push(ctx.workspace_state_values[i])
        i = i + 1
    if not replaced:
        keys.push(key)
        values.push(value)
    ExtensionContext(name: ctx.name, extension_id: ctx.extension_id, storage_path: ctx.storage_path, subscriptions: ctx.subscriptions, workspace_state_keys: keys, workspace_state_values: values)

fn extension_context_get_state(ctx: ExtensionContext, key: text) -> text:
    var i = 0
    while i < ctx.workspace_state_keys.len():
        if ctx.workspace_state_keys[i] == key:
            return ctx.workspace_state_values[i]
        i = i + 1
    ""

struct ExtensionCapability:
    name: text
    enabled: bool

struct ExtensionContribution:
    kind: text
    id: text
    payload: text

enum ExtensionActivationEvent:
    OnLanguage(language_id: text)
    OnCommand(command_id: text)
    OnFilePattern(pattern: text)
    OnStartup
