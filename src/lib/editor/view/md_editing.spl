# Editor Markdown Editing.
#
# Provides: MdMotionResult, MdTableEdit, MdCommandResult, MdEditorState,
# md_table_*/md_callout_*/md_assist_* helpers, md_commands_dispatch glue.

use std.editor.buffer.buffer.{EditorBuffer}

# Result of a vim-style markdown motion or table cell navigation.
struct MdMotionResult:
    found: bool
    line: i64
    col: i64
    message: text

fn md_motion_none(line: i64, col: i64) -> MdMotionResult:
    MdMotionResult(found: false, line: line, col: col, message: "")

# Result of a markdown table / callout structural edit.
struct MdTableEdit:
    changed: bool
    content: text
    line: i64
    col: i64
    message: text

fn md_table_edit_none(message: text) -> MdTableEdit:
    MdTableEdit(changed: false, content: "", line: 0, col: 0, message: message)

# Per-document markdown command state (visibility flags).
struct MdEditorState:
    preview_visible: bool
    outline_visible: bool

fn md_editor_state_new() -> MdEditorState:
    MdEditorState(preview_visible: false, outline_visible: false)

fn md_editor_state_preview_visible(state: MdEditorState) -> bool:
    state.preview_visible

fn md_editor_state_outline_visible(state: MdEditorState) -> bool:
    state.outline_visible

# Result of dispatching a markdown editor command.
#
# `content` carries a whole-document replacement for the structural line
# commands (delete-line, duplicate-line, move-up, move-down) that cannot be
# expressed as a single-line edit; it is "" for every other command.
struct MdCommandResult:
    status_message: text
    replace_line: text
    insert_text: text
    cursor_delta_line: i64
    cursor_delta_col: i64
    preview_visible: bool
    outline_visible: bool
    content: text

# --- Markdown table query helpers (used by the render path) ---

fn md_table_is_row(line: text) -> bool:
    line.starts_with("|") or line.index_of("|") >= 0 and line.trim_start().starts_with("|")

fn md_table_is_separator_row(line: text) -> bool:
    val t = line.trim()
    if t.len() == 0:
        return false
    var i = 0
    while i < t.len():
        val ch = t[i:i + 1]
        if ch != "|" and ch != "-" and ch != ":" and ch != " ":
            return false
        i = i + 1
    t.index_of("-") >= 0

fn md_table_cell_start_columns(line: text) -> [i64]:
    var starts: [i64] = []
    var i = 0
    while i < line.len():
        if line[i:i + 1] == "|":
            var start = i + 1
            while start < line.len() and line[start:start + 1] == " ":
                start = start + 1
            if start < line.len() and line[start:start + 1] != "|":
                starts.push(start)
        i = i + 1
    starts

fn md_table_column_at(line: text, col: i64) -> i64:
    val starts = md_table_cell_start_columns(line)
    var idx = -1
    var i = 0
    while i < starts.len():
        if col >= starts[i]:
            idx = i
        i = i + 1
    idx

# --- Markdown table edits ---

fn md_table_insert_row_after(content: text, cursor_line: i64) -> MdTableEdit:
    val lines = content.split("\n")
    if cursor_line < 0 or cursor_line >= lines.len() or not md_table_is_row(lines[cursor_line]):
        return md_table_edit_none("no markdown table")
    val cells = _md_table_cells(lines[cursor_line])
    if cells.len() == 0:
        return md_table_edit_none("no markdown table")
    var empty: [text] = []
    var i = 0
    while i < cells.len():
        empty.push("")
        i = i + 1
    var out: [text] = []
    i = 0
    while i < lines.len():
        out.push(lines[i])
        if i == cursor_line:
            out.push(_md_table_build_row(empty, false))
        i = i + 1
    MdTableEdit(changed: true, content: out.join("\n"), line: cursor_line + 1, col: 2, message: "table row inserted")

fn md_table_insert_column_after(content: text, cursor_line: i64, cursor_col: i64) -> MdTableEdit:
    val lines = content.split("\n")
    if cursor_line < 0 or cursor_line >= lines.len() or not md_table_is_row(lines[cursor_line]):
        return md_table_edit_none("no markdown table")
    var column = md_table_column_at(lines[cursor_line], cursor_col)
    if column < 0:
        column = 0
    val insert_at = column + 1
    var out: [text] = []
    var changed = false
    var i = 0
    while i < lines.len():
        if md_table_is_row(lines[i]):
            var cells = _md_table_cells(lines[i])
            if insert_at <= cells.len():
                cells = _md_table_insert_cell(cells, insert_at, if md_table_is_separator_row(lines[i]) then "---" else: "")
                out.push(_md_table_build_row(cells, md_table_is_separator_row(lines[i])))
                changed = true
            else:
                out.push(lines[i])
        else:
            out.push(lines[i])
        i = i + 1
    if not changed:
        return md_table_edit_none("no markdown table")
    val starts = md_table_cell_start_columns(out[cursor_line])
    val next_col = if insert_at >= 0 and insert_at < starts.len() then starts.get(insert_at) else: cursor_col
    MdTableEdit(changed: true, content: out.join("\n"), line: cursor_line, col: next_col, message: "table column inserted")

fn md_table_set_cell(content: text, line: i64, col: i64, value: text) -> MdTableEdit:
    var lines = content.split("\n")
    if line < 0 or line >= lines.len() or not md_table_is_row(lines[line]) or md_table_is_separator_row(lines[line]):
        return md_table_edit_none("no markdown table")
    var cells = _md_table_cells(lines[line])
    if col < 0 or col >= cells.len():
        return md_table_edit_none("table cell out of range")
    cells[col] = value
    lines[line] = _md_table_build_row(cells, false)
    MdTableEdit(changed: true, content: lines.join("\n"), line: line, col: md_table_cell_start_columns(lines[line])[col], message: "table cell updated")

fn md_table_next_cell(content: text, cursor_line: i64, cursor_col: i64) -> MdMotionResult:
    val lines = content.split("\n")
    if cursor_line < 0 or cursor_line >= lines.len() or not md_table_is_row(lines[cursor_line]):
        return MdMotionResult(found: false, line: cursor_line, col: cursor_col, message: "no table cell")
    val starts = md_table_cell_start_columns(lines[cursor_line])
    val current = md_table_column_at(lines[cursor_line], cursor_col)
    if current + 1 < starts.len():
        return MdMotionResult(found: true, line: cursor_line, col: starts[current + 1], message: "table cell next")
    var i = cursor_line + 1
    while i < lines.len():
        if md_table_is_row(lines[i]):
            if not md_table_is_separator_row(lines[i]):
                val next_starts = md_table_cell_start_columns(lines[i])
                if next_starts.len() > 0:
                    return MdMotionResult(found: true, line: i, col: next_starts[0], message: "table cell next")
        elif lines[i].trim() != "":
            return MdMotionResult(found: false, line: cursor_line, col: cursor_col, message: "last table cell")
        i = i + 1
    MdMotionResult(found: false, line: cursor_line, col: cursor_col, message: "last table cell")

fn md_table_prev_cell(content: text, cursor_line: i64, cursor_col: i64) -> MdMotionResult:
    val lines = content.split("\n")
    if cursor_line < 0 or cursor_line >= lines.len() or not md_table_is_row(lines[cursor_line]):
        return MdMotionResult(found: false, line: cursor_line, col: cursor_col, message: "no table cell")
    val starts = md_table_cell_start_columns(lines[cursor_line])
    val current = md_table_column_at(lines[cursor_line], cursor_col)
    if current > 0:
        return MdMotionResult(found: true, line: cursor_line, col: starts[current - 1], message: "table cell previous")
    var i = cursor_line - 1
    while i >= 0:
        if md_table_is_row(lines[i]):
            if not md_table_is_separator_row(lines[i]):
                val prev_starts = md_table_cell_start_columns(lines[i])
                if prev_starts.len() > 0:
                    return MdMotionResult(found: true, line: i, col: prev_starts[prev_starts.len() - 1], message: "table cell previous")
        elif lines[i].trim() != "":
            return MdMotionResult(found: false, line: cursor_line, col: cursor_col, message: "first table cell")
        i = i - 1
    MdMotionResult(found: false, line: cursor_line, col: cursor_col, message: "first table cell")

fn md_table_delete_row(content: text, cursor_line: i64) -> MdTableEdit:
    val lines = content.split("\n")
    if cursor_line < 0 or cursor_line >= lines.len() or not md_table_is_row(lines[cursor_line]):
        return md_table_edit_none("no markdown table")
    if md_table_is_separator_row(lines[cursor_line]):
        return md_table_edit_none("cannot delete the table separator row")
    var out: [text] = []
    var i = 0
    while i < lines.len():
        if i != cursor_line:
            out.push(lines[i])
        i = i + 1
    val next_line = if cursor_line < out.len() then cursor_line else: out.len() - 1
    MdTableEdit(changed: true, content: out.join("\n"), line: next_line, col: 2, message: "table row deleted")

fn md_table_delete_column(content: text, cursor_line: i64, cursor_col: i64) -> MdTableEdit:
    val lines = content.split("\n")
    if cursor_line < 0 or cursor_line >= lines.len() or not md_table_is_row(lines[cursor_line]):
        return md_table_edit_none("no markdown table")
    val column = _md_table_cell_index_at(lines[cursor_line], cursor_col)
    if column < 0:
        return md_table_edit_none("no table column at cursor")
    var out: [text] = []
    var changed = false
    var i = 0
    while i < lines.len():
        if md_table_is_row(lines[i]):
            val cells = _md_table_cells(lines[i])
            if column < cells.len() and cells.len() > 1:
                var kept: [text] = []
                var c = 0
                while c < cells.len():
                    if c != column:
                        kept.push(cells[c])
                    c = c + 1
                out.push(_md_table_build_row(kept, md_table_is_separator_row(lines[i])))
                changed = true
            else:
                out.push(lines[i])
        else:
            out.push(lines[i])
        i = i + 1
    if not changed:
        return md_table_edit_none("no markdown table")
    MdTableEdit(changed: true, content: out.join("\n"), line: cursor_line, col: 2, message: "table column deleted")

# Re-pad every contiguous table block so each column is the width of its widest
# cell. Row count is never changed -- only the padding inside each row.
fn md_table_auto_format(content: text) -> text:
    val lines = content.split("\n")
    var widths: [i64] = []
    var i = 0
    while i < lines.len():
        if md_table_is_row(lines[i]) and not md_table_is_separator_row(lines[i]):
            val cells = _md_table_cells(lines[i])
            var c = 0
            while c < cells.len():
                if c >= widths.len():
                    widths.push(cells[c].len())
                elif cells[c].len() > widths[c]:
                    widths[c] = cells[c].len()
                c = c + 1
        i = i + 1
    if widths.len() == 0:
        return content
    var out: [text] = []
    i = 0
    while i < lines.len():
        if md_table_is_row(lines[i]):
            val cells = _md_table_cells(lines[i])
            val separator = md_table_is_separator_row(lines[i])
            var row = "|"
            var c = 0
            while c < cells.len():
                val width = if c < widths.len() then widths[c] else: cells[c].len()
                val cell = if separator then _md_repeat_text("-", width) else: cells[c]
                row = row + " " + cell + _md_repeat_text(" ", width - cell.len()) + " |"
                c = c + 1
            out.push(row)
        else:
            out.push(lines[i])
        i = i + 1
    out.join("\n")

# Index of the cell containing `col`, counting EMPTY cells too. This is the
# index space of `_md_table_cells`; md_table_column_at uses the render-side
# space, which skips empty cells, so the two are not interchangeable.
fn _md_table_cell_index_at(line: text, col: i64) -> i64:
    var pipes = 0
    var i = 0
    while i < line.len() and i < col:
        if line[i:i + 1] == "|":
            pipes = pipes + 1
        i = i + 1
    pipes - 1

fn _md_repeat_text(unit: text, count: i64) -> text:
    var out = ""
    var i = 0
    while i < count:
        out = out + unit
        i = i + 1
    out

# --- Markdown callout edits ---

fn md_callout_toggle_fold(content: text, cursor_line: i64) -> MdTableEdit:
    var lines = content.split("\n")
    val header = _md_callout_header_line(lines, cursor_line)
    if header < 0:
        return md_table_edit_none("no callout")
    val line = lines[header]
    val marker_end = line.index_of("]")
    if marker_end < 0:
        return md_table_edit_none("no callout")
    val next_idx = marker_end + 1
    var rest_start = next_idx
    var folded = false
    if next_idx < line.len() and (line[next_idx:next_idx + 1] == "-" or line[next_idx:next_idx + 1] == "+"):
        folded = line[next_idx:next_idx + 1] == "-"
        rest_start = next_idx + 1
    val next_marker = if folded then "+" else: "-"
    lines[header] = line.slice(0, marker_end + 1) + next_marker + line.slice(rest_start, line.len())
    MdTableEdit(changed: true, content: lines.join("\n"), line: header, col: 0, message: if folded then "callout unfolded" else: "callout folded")

# Insert text for a new callout of `kind` ("note", "warning", "tip", ...).
fn md_callout_insert(kind: text) -> MdCommandResult:
    val name = if kind.trim() == "" then "note" else: kind.trim()
    val body = "> [!" + name + "]\n> "
    _md_command_result("callout inserted", "", body, 1, 2, false, false)

# Rewrite the callout kind on the callout owning `cursor_line`, preserving any
# fold marker and title text that follow it.
fn md_callout_change_type(content: text, cursor_line: i64, new_kind: text) -> MdTableEdit:
    var lines = content.split("\n")
    val header = _md_callout_header_line(lines, cursor_line)
    if header < 0:
        return md_table_edit_none("no callout")
    val line = lines[header]
    val open = line.index_of("[!")
    val close = line.index_of("]")
    if open < 0 or close < open:
        return md_table_edit_none("no callout")
    val name = if new_kind.trim() == "" then "note" else: new_kind.trim()
    lines[header] = line.slice(0, open) + "[!" + name + "]" + line.slice(close + 1, line.len())
    MdTableEdit(changed: true, content: lines.join("\n"), line: header, col: open + 2, message: "callout type changed")

fn md_vim_toggle_fold_heading(content: text, cursor_line: i64) -> (i64, i64):
    val lines = content.split("\n")
    if cursor_line < 0 or cursor_line >= lines.len():
        return (cursor_line, cursor_line)
    var header = cursor_line
    var level = _md_heading_level(lines[header])
    while header >= 0 and level == 0:
        header = header - 1
        if header >= 0:
            level = _md_heading_level(lines[header])
    if header < 0 or level == 0:
        return (cursor_line, cursor_line)
    var end_line = lines.len() - 1
    var scan = header + 1
    while scan < lines.len():
        val scan_level = _md_heading_level(lines[scan])
        if scan_level > 0 and scan_level <= level:
            end_line = scan - 1
            scan = lines.len()
        else:
            scan = scan + 1
    if end_line <= header:
        return (header, header)
    (header, end_line)

# --- Markdown insert assists ---

fn md_assist_on_enter(current_line: text, cursor_col: i64) -> text:
    val prefix = _md_line_indent(current_line)
    val trimmed = current_line.trim_start()
    if trimmed.starts_with("> "):
        return prefix + "> "
    if trimmed.starts_with("- [ ] ") or trimmed.starts_with("- [x] "):
        return prefix + "- [ ] "
    if trimmed.starts_with("* [ ] ") or trimmed.starts_with("* [x] "):
        return prefix + "* [ ] "
    if trimmed.starts_with("- "):
        return prefix + "- "
    if trimmed.starts_with("* "):
        return prefix + "* "
    val dot = trimmed.index_of(". ")
    if dot > 0:
        val num = _md_parse_i64(trimmed.slice(0, dot), 0)
        if num > 0:
            return prefix + (num + 1).to_text() + ". "
    ""

fn md_assist_on_tab(current_line: text, cursor_col: i64) -> i64:
    val task = current_line.index_of("[")
    if task >= 0 and cursor_col <= task:
        return task + 4
    val starts = md_table_cell_start_columns(current_line)
    var i = 0
    while i < starts.len():
        if starts[i] > cursor_col:
            return starts[i]
        i = i + 1
    -1

fn md_assist_toggle_task(line: text) -> text:
    val open = line.index_of("[ ]")
    if open >= 0:
        return line.slice(0, open) + "[x]" + line.slice(open + 3, line.len())
    val done = line.index_of("[x]")
    if done >= 0:
        return line.slice(0, done) + "[ ]" + line.slice(done + 3, line.len())
    val done_upper = line.index_of("[X]")
    if done_upper >= 0:
        return line.slice(0, done_upper) + "[ ]" + line.slice(done_upper + 3, line.len())
    line

fn md_tasks_set_checked(content: text, checked: bool) -> text:
    val lines = content.split("\n")
    var out: [text] = []
    for line in lines:
        val toggled = md_assist_toggle_task(line)
        if toggled != line:
            val marker = if checked then "[x]" else: "[ ]"
            val idx = toggled.index_of("[")
            out.push(toggled.slice(0, idx) + marker + toggled.slice(idx + 3, toggled.len()))
        else:
            out.push(line)
    out.join("\n")

# --- Buffer content + motion dispatch (used by core controller) ---

fn md_editing_buffer_content(buffer: EditorBuffer) -> text:
    var content = ""
    var i = 0
    while i < buffer.line_count():
        if i > 0:
            content = content + "\n"
        content = content + buffer.line_at(i)
        i = i + 1
    content

fn md_dispatch_motion(prefix: text, key: text, content: text, cursor_line: i64, cursor_col: i64) -> MdMotionResult:
    if prefix == "]" and key == "]":
        return md_vim_next_heading(content, cursor_line)
    if prefix == "[" and key == "[":
        return md_vim_prev_heading(content, cursor_line)
    if prefix == "]" and key == "h":
        return md_vim_next_sibling_heading(content, cursor_line)
    if prefix == "[" and key == "h":
        return md_vim_prev_sibling_heading(content, cursor_line)
    if prefix == "[" and key == "p":
        return md_vim_parent_heading(content, cursor_line)
    if prefix == "]" and key == "l":
        return md_vim_next_link(content, cursor_line, cursor_col)
    if prefix == "[" and key == "l":
        return md_vim_prev_link(content, cursor_line, cursor_col)
    if prefix == "]" and key == "c":
        return md_vim_next_code_block(content, cursor_line)
    if prefix == "[" and key == "c":
        return md_vim_prev_code_block(content, cursor_line)
    if prefix == "g" and key == "g":
        return md_vim_document_start()
    if prefix == "" and key == "G":
        return md_vim_document_end(content)
    if prefix == "" and (key == "w" or key == "W"):
        return md_vim_word_forward(content, cursor_line, cursor_col, key == "W")
    if prefix == "" and (key == "b" or key == "B"):
        return md_vim_word_backward(content, cursor_line, cursor_col, key == "B")
    if prefix == "" and (key == "e" or key == "E"):
        return md_vim_word_end(content, cursor_line, cursor_col, key == "E")
    if prefix == "" and key == "0":
        return md_vim_line_start(content, cursor_line)
    if prefix == "" and key == "$":
        return md_vim_line_end(content, cursor_line)
    if prefix == "" and key == "^":
        return md_vim_line_first_non_blank(content, cursor_line)
    if prefix == "" and key == "}":
        return md_vim_paragraph_forward(content, cursor_line)
    if prefix == "" and key == "{":
        return md_vim_paragraph_backward(content, cursor_line)
    md_motion_none(cursor_line, cursor_col)

# --- Vim line, word and paragraph motions ---

fn md_vim_document_start() -> MdMotionResult:
    MdMotionResult(found: true, line: 0, col: 0, message: "document start")

fn md_vim_document_end(content: text) -> MdMotionResult:
    val lines = content.split("\n")
    val last = if lines.len() > 0 then lines.len() - 1 else: 0
    MdMotionResult(found: true, line: last, col: 0, message: "document end")

fn md_vim_line_start(content: text, cursor_line: i64) -> MdMotionResult:
    val lines = content.split("\n")
    if cursor_line < 0 or cursor_line >= lines.len():
        return md_motion_none(cursor_line, 0)
    MdMotionResult(found: true, line: cursor_line, col: 0, message: "line start")

fn md_vim_line_end(content: text, cursor_line: i64) -> MdMotionResult:
    val lines = content.split("\n")
    if cursor_line < 0 or cursor_line >= lines.len():
        return md_motion_none(cursor_line, 0)
    MdMotionResult(found: true, line: cursor_line, col: lines[cursor_line].len(), message: "line end")

fn md_vim_line_first_non_blank(content: text, cursor_line: i64) -> MdMotionResult:
    val lines = content.split("\n")
    if cursor_line < 0 or cursor_line >= lines.len():
        return md_motion_none(cursor_line, 0)
    val line = lines[cursor_line]
    var col = 0
    while col < line.len() and (line[col:col + 1] == " " or line[col:col + 1] == "\t"):
        col = col + 1
    MdMotionResult(found: true, line: cursor_line, col: col, message: "first non-blank")

fn md_vim_word_forward(content: text, cursor_line: i64, cursor_col: i64, big_word: bool) -> MdMotionResult:
    val lines = content.split("\n")
    if cursor_line < 0 or cursor_line >= lines.len():
        return md_motion_none(cursor_line, cursor_col)
    var line = cursor_line
    var col = cursor_col
    # Leave the word the cursor is inside, then skip the separators after it.
    while col < lines[line].len() and not _md_is_word_separator(lines[line][col:col + 1], big_word):
        col = col + 1
    while true:
        while col < lines[line].len() and _md_is_word_separator(lines[line][col:col + 1], big_word):
            col = col + 1
        if col < lines[line].len():
            return MdMotionResult(found: true, line: line, col: col, message: "word forward")
        if line + 1 >= lines.len():
            return MdMotionResult(found: false, line: cursor_line, col: cursor_col, message: "last word")
        line = line + 1
        col = 0

fn md_vim_word_backward(content: text, cursor_line: i64, cursor_col: i64, big_word: bool) -> MdMotionResult:
    val lines = content.split("\n")
    if cursor_line < 0 or cursor_line >= lines.len():
        return md_motion_none(cursor_line, cursor_col)
    var line = cursor_line
    var col = cursor_col - 1
    while true:
        while col >= 0 and _md_is_word_separator(lines[line][col:col + 1], big_word):
            col = col - 1
        if col >= 0:
            while col > 0 and not _md_is_word_separator(lines[line][col - 1:col], big_word):
                col = col - 1
            return MdMotionResult(found: true, line: line, col: col, message: "word backward")
        if line == 0:
            return MdMotionResult(found: false, line: cursor_line, col: cursor_col, message: "first word")
        line = line - 1
        col = lines[line].len() - 1

fn md_vim_word_end(content: text, cursor_line: i64, cursor_col: i64, big_word: bool) -> MdMotionResult:
    val lines = content.split("\n")
    if cursor_line < 0 or cursor_line >= lines.len():
        return md_motion_none(cursor_line, cursor_col)
    var line = cursor_line
    var col = cursor_col + 1
    while true:
        while col < lines[line].len() and _md_is_word_separator(lines[line][col:col + 1], big_word):
            col = col + 1
        if col < lines[line].len():
            while col + 1 < lines[line].len() and not _md_is_word_separator(lines[line][col + 1:col + 2], big_word):
                col = col + 1
            return MdMotionResult(found: true, line: line, col: col, message: "word end")
        if line + 1 >= lines.len():
            return MdMotionResult(found: false, line: cursor_line, col: cursor_col, message: "last word end")
        line = line + 1
        col = 0

fn md_vim_paragraph_forward(content: text, cursor_line: i64) -> MdMotionResult:
    val lines = content.split("\n")
    var i = cursor_line + 1
    while i < lines.len():
        if lines[i].trim() == "":
            return MdMotionResult(found: true, line: i, col: 0, message: "paragraph forward")
        i = i + 1
    MdMotionResult(found: false, line: cursor_line, col: 0, message: "last paragraph")

fn md_vim_paragraph_backward(content: text, cursor_line: i64) -> MdMotionResult:
    val lines = content.split("\n")
    var i = cursor_line - 1
    while i >= 0:
        if i < lines.len() and lines[i].trim() == "":
            return MdMotionResult(found: true, line: i, col: 0, message: "paragraph backward")
        i = i - 1
    MdMotionResult(found: false, line: cursor_line, col: 0, message: "first paragraph")

# `big_word` selects vim's WORD class: only whitespace separates WORDs, while
# ordinary words are also broken by punctuation.
fn _md_is_word_separator(ch: text, big_word: bool) -> bool:
    if ch == " " or ch == "\t":
        return true
    if big_word:
        return false
    if ch >= "0" and ch <= "9":
        return false
    if ch >= "a" and ch <= "z":
        return false
    if ch >= "A" and ch <= "Z":
        return false
    ch != "_"

# --- Command dispatch glue ---

fn md_commands_dispatch(command_name: text, state: MdEditorState, content: text, cursor_line: i64, cursor_col: i64) -> MdCommandResult:
    var preview = state.preview_visible
    var outline = state.outline_visible
    if command_name == "markdown.togglePreview":
        preview = not preview
    if command_name == "markdown.toggleOutline":
        outline = not outline
    if command_name == "markdown.togglePreview":
        return _md_command_result(if preview then "Preview shown" else: "Preview hidden", "", "", 0, 0, preview, outline)
    if command_name == "markdown.toggleOutline":
        return _md_command_result(if outline then "Outline shown" else: "Outline hidden", "", "", 0, 0, preview, outline)
    if command_name == "markdown.insertTable":
        return _md_command_result("", "", "| Header 1 | Header 2 | Header 3 |\n| --- | --- | --- |\n|  |  |  |", 0, 2, preview, outline)
    if command_name == "markdown.insertLink":
        return _md_command_result("link inserted", "", "[text](url)", 0, 1, preview, outline)
    if command_name == "markdown.insertCodeBlock":
        return _md_command_result("code block inserted", "", "```\n\n```", 1, 0, preview, outline)
    if command_name == "markdown.toggleTask":
        val lines = content.split("\n")
        if cursor_line >= 0 and cursor_line < lines.len():
            val toggled = md_assist_toggle_task(lines[cursor_line])
            if toggled != lines[cursor_line]:
                return _md_command_result("task toggled", toggled, "", 0, 0, preview, outline)
        return _md_command_result("not a task", "", "", 0, 0, preview, outline)
    if command_name == "markdown.documentStats":
        return _md_command_result(_md_document_stats_message(content), "", "", 0, 0, preview, outline)
    val editing = _md_dispatch_editing(command_name, content, cursor_line, cursor_col, preview, outline)
    if editing.status_message != "":
        return editing
    _md_command_result(command_name, "", "", 0, 0, preview, outline)

# Line/inline editing commands. Names are accepted bare ("delete-line") and
# `markdown.`-prefixed ("markdown.delete-line"); an unrecognised name yields an
# empty status_message so md_commands_dispatch can fall through.
fn _md_dispatch_editing(command_name: text, content: text, cursor_line: i64, cursor_col: i64, preview: bool, outline: bool) -> MdCommandResult:
    var name = command_name
    if name.starts_with("markdown."):
        name = name.slice(9, name.len())
    var lines = content.split("\n")
    val in_range = cursor_line >= 0 and cursor_line < lines.len()
    val current = if in_range then lines[cursor_line] else: ""
    if name == "enter":
        val continuation = md_assist_on_enter(current, cursor_col)
        if continuation != "":
            return _md_command_result("list continuation inserted", "", "\n" + continuation, 1, continuation.len(), preview, outline)
        return _md_command_result("newline inserted", "", "\n", 1, 0, preview, outline)
    if name == "tab":
        val target = md_assist_on_tab(current, cursor_col)
        if target >= 0:
            return _md_command_result("tab stop", "", "", 0, target - cursor_col, preview, outline)
        return _md_command_result("indented", "  " + current, "", 0, 2, preview, outline)
    if name == "shift-tab":
        if current.starts_with("  "):
            return _md_command_result("outdented", current.slice(2, current.len()), "", 0, 0 - 2, preview, outline)
        return _md_command_result("already at margin", "", "", 0, 0, preview, outline)
    if name == "delete-line":
        if not in_range:
            return _md_command_result("no line to delete", "", "", 0, 0, preview, outline)
        var kept: [text] = []
        var i = 0
        while i < lines.len():
            if i != cursor_line:
                kept.push(lines[i])
            i = i + 1
        return _md_command_result("line deleted", "", "", 0, 0, preview, outline, kept.join("\n"))
    if name == "duplicate-line":
        if not in_range:
            return _md_command_result("no line to duplicate", "", "", 0, 0, preview, outline)
        var doubled: [text] = []
        var d = 0
        while d < lines.len():
            doubled.push(lines[d])
            if d == cursor_line:
                doubled.push(lines[d])
            d = d + 1
        return _md_command_result("line duplicated", "", "", 1, 0, preview, outline, doubled.join("\n"))
    if name == "move-up":
        if not in_range or cursor_line == 0:
            return _md_command_result("line already at top", "", "", 0, 0, preview, outline)
        val above = lines[cursor_line - 1]
        lines[cursor_line - 1] = current
        lines[cursor_line] = above
        return _md_command_result("line moved up", "", "", -1, 0, preview, outline, lines.join("\n"))
    if name == "move-down":
        if not in_range or cursor_line >= lines.len() - 1:
            return _md_command_result("line already at bottom", "", "", 0, 0, preview, outline)
        val below = lines[cursor_line + 1]
        lines[cursor_line + 1] = current
        lines[cursor_line] = below
        return _md_command_result("line moved down", "", "", 1, 0, preview, outline, lines.join("\n"))
    if name == "heading-toggle":
        if not in_range:
            return _md_command_result("no line to toggle", "", "", 0, 0, preview, outline)
        val level = _md_heading_level(current)
        if level == 0:
            return _md_command_result("heading level 1", "# " + current, "", 0, 2, preview, outline)
        if level >= 6:
            return _md_command_result("heading cleared", current.slice(level + 1, current.len()), "", 0, 0 - (level + 1), preview, outline)
        return _md_command_result("heading level " + (level + 1).to_text(), "#" + current, "", 0, 1, preview, outline)
    if name == "bold":
        return _md_command_result("bold markers inserted", "", "****", 0, 2, preview, outline)
    if name == "italic":
        return _md_command_result("italic markers inserted", "", "**", 0, 1, preview, outline)
    _md_command_result("", "", "", 0, 0, preview, outline)

fn md_command_result_state(result: MdCommandResult) -> MdEditorState:
    MdEditorState(preview_visible: result.preview_visible, outline_visible: result.outline_visible)

fn md_apply_result(buffer: EditorBuffer, result: MdCommandResult):
    if result.content != "":
        buffer.replace_content(result.content)
        if result.cursor_delta_line != 0 or result.cursor_delta_col != 0:
            buffer.move_relative(result.cursor_delta_line, result.cursor_delta_col)
        return
    if result.replace_line != "":
        val row = buffer.cursor_row
        val old_line = buffer.line_at(row)
        buffer.move_to_line_start()
        var i = 0
        while i < old_line.len():
            buffer.delete_at_cursor()
            i = i + 1
        buffer.insert_at_cursor(result.replace_line)
    if result.insert_text != "":
        buffer.insert_at_cursor(result.insert_text)
    if result.cursor_delta_line != 0 or result.cursor_delta_col != 0:
        buffer.move_relative(result.cursor_delta_line, result.cursor_delta_col)

fn _md_command_result(status: text, replace_line: text, insert_text: text, delta_line: i64, delta_col: i64, preview: bool, outline: bool, content: text = "") -> MdCommandResult:
    MdCommandResult(
        status_message: status,
        replace_line: replace_line,
        insert_text: insert_text,
        cursor_delta_line: delta_line,
        cursor_delta_col: delta_col,
        preview_visible: preview,
        outline_visible: outline,
        content: content
    )

fn _md_table_cells(line: text) -> [text]:
    var t = line.trim()
    if t.starts_with("|"):
        t = t.slice(1, t.len())
    if t.ends_with("|"):
        t = t.slice(0, t.len() - 1)
    val raw = t.split("|")
    var cells: [text] = []
    for cell in raw:
        cells.push(cell.trim())
    cells

fn _md_table_build_row(cells: [text], separator: bool) -> text:
    var out = "|"
    var i = 0
    while i < cells.len():
        val cell = if separator then "---" else: cells[i]
        out = out + " " + cell + " |"
        i = i + 1
    out

fn _md_table_insert_cell(cells: [text], index: i64, value: text) -> [text]:
    var out: [text] = []
    var i = 0
    while i < cells.len():
        if i == index:
            out.push(value)
        out.push(cells[i])
        i = i + 1
    if index >= cells.len():
        out.push(value)
    out

fn _md_callout_header_line(lines: [text], cursor_line: i64) -> i64:
    if cursor_line < 0 or cursor_line >= lines.len():
        return -1
    var i = cursor_line
    while i >= 0:
        val trimmed = lines[i].trim_start()
        if trimmed.starts_with("> [!"):
            return i
        if not trimmed.starts_with(">"):
            return -1
        i = i - 1
    -1

fn _md_line_indent(line: text) -> text:
    var out = ""
    var i = 0
    while i < line.len() and line[i:i + 1] == " ":
        out = out + " "
        i = i + 1
    out

fn _md_parse_i64(raw: text, fallback: i64) -> i64:
    var value: i64 = 0
    if raw.len() == 0:
        return fallback
    var i = 0
    while i < raw.len():
        val ch = raw[i:i + 1]
        if ch < "0" or ch > "9":
            return fallback
        value = value * 10 + (raw.char_code_at(i) - "0".char_code_at(0))
        i = i + 1
    value

fn _md_heading_level(line: text) -> i64:
    var level = 0
    while level < line.len() and line[level:level + 1] == "#":
        level = level + 1
    if level > 0 and level < line.len() and line[level:level + 1] == " ":
        return level
    0

fn md_vim_next_heading(content: text, cursor_line: i64) -> MdMotionResult:
    val lines = content.split("\n")
    var i = cursor_line + 1
    while i < lines.len():
        if _md_heading_level(lines[i]) > 0:
            return MdMotionResult(found: true, line: i, col: 0, message: "next heading")
        i = i + 1
    MdMotionResult(found: false, line: cursor_line, col: 0, message: "no next heading")

fn md_vim_prev_heading(content: text, cursor_line: i64) -> MdMotionResult:
    val lines = content.split("\n")
    var i = cursor_line - 1
    while i >= 0:
        if _md_heading_level(lines[i]) > 0:
            return MdMotionResult(found: true, line: i, col: 0, message: "previous heading")
        i = i - 1
    MdMotionResult(found: false, line: cursor_line, col: 0, message: "no previous heading")

fn _md_current_heading_level(lines: [text], cursor_line: i64) -> i64:
    var i = cursor_line
    while i >= 0:
        val level = _md_heading_level(lines[i])
        if level > 0:
            return level
        i = i - 1
    0

fn md_vim_next_sibling_heading(content: text, cursor_line: i64) -> MdMotionResult:
    val lines = content.split("\n")
    val level = _md_current_heading_level(lines, cursor_line)
    if level == 0:
        return md_vim_next_heading(content, cursor_line)
    var i = cursor_line + 1
    while i < lines.len():
        val h = _md_heading_level(lines[i])
        if h == level:
            return MdMotionResult(found: true, line: i, col: 0, message: "next sibling heading")
        if h > 0 and h < level:
            return MdMotionResult(found: false, line: cursor_line, col: 0, message: "no next sibling heading")
        i = i + 1
    MdMotionResult(found: false, line: cursor_line, col: 0, message: "no next sibling heading")

fn md_vim_prev_sibling_heading(content: text, cursor_line: i64) -> MdMotionResult:
    val lines = content.split("\n")
    val level = _md_current_heading_level(lines, cursor_line)
    if level == 0:
        return md_vim_prev_heading(content, cursor_line)
    var i = cursor_line - 1
    while i >= 0:
        val h = _md_heading_level(lines[i])
        if h == level:
            return MdMotionResult(found: true, line: i, col: 0, message: "previous sibling heading")
        if h > 0 and h < level:
            return MdMotionResult(found: false, line: cursor_line, col: 0, message: "no previous sibling heading")
        i = i - 1
    MdMotionResult(found: false, line: cursor_line, col: 0, message: "no previous sibling heading")

fn md_vim_parent_heading(content: text, cursor_line: i64) -> MdMotionResult:
    val lines = content.split("\n")
    val level = _md_current_heading_level(lines, cursor_line)
    var i = cursor_line - 1
    while i >= 0:
        val h = _md_heading_level(lines[i])
        if h > 0 and h < level:
            return MdMotionResult(found: true, line: i, col: 0, message: "parent heading")
        i = i - 1
    MdMotionResult(found: false, line: cursor_line, col: 0, message: "no parent heading")

fn _md_line_has_link(line: text) -> bool:
    line.contains("](") or line.contains("[[")

fn _md_first_link_col(line: text) -> i64:
    val wiki = line.index_of("[[")
    val md = line.index_of("](")
    if wiki >= 0 and (md < 0 or wiki < md):
        return wiki
    if md >= 0:
        var i = md
        while i >= 0:
            if line[i:i + 1] == "[":
                return i
            i = i - 1
        return md
    -1

fn md_vim_next_link(content: text, cursor_line: i64, cursor_col: i64) -> MdMotionResult:
    val lines = content.split("\n")
    var i = cursor_line
    while i < lines.len():
        val col = _md_first_link_col(lines[i])
        if col >= 0 and (i > cursor_line or col > cursor_col):
            return MdMotionResult(found: true, line: i, col: col, message: "next link")
        i = i + 1
    MdMotionResult(found: false, line: cursor_line, col: cursor_col, message: "no next link")

fn md_vim_prev_link(content: text, cursor_line: i64, cursor_col: i64) -> MdMotionResult:
    val lines = content.split("\n")
    var i = cursor_line
    while i >= 0:
        val col = _md_first_link_col(lines[i])
        if col >= 0 and (i < cursor_line or col < cursor_col):
            return MdMotionResult(found: true, line: i, col: col, message: "previous link")
        i = i - 1
    MdMotionResult(found: false, line: cursor_line, col: cursor_col, message: "no previous link")

fn md_vim_next_code_block(content: text, cursor_line: i64) -> MdMotionResult:
    val lines = content.split("\n")
    var i = cursor_line + 1
    while i < lines.len():
        if lines[i].trim_start().starts_with("```"):
            return MdMotionResult(found: true, line: i, col: 0, message: "next code block")
        i = i + 1
    MdMotionResult(found: false, line: cursor_line, col: 0, message: "no next code block")

fn md_vim_prev_code_block(content: text, cursor_line: i64) -> MdMotionResult:
    val lines = content.split("\n")
    var i = cursor_line - 1
    while i >= 0:
        if lines[i].trim_start().starts_with("```"):
            return MdMotionResult(found: true, line: i, col: 0, message: "previous code block")
        i = i - 1
    MdMotionResult(found: false, line: cursor_line, col: 0, message: "no previous code block")

fn md_vim_open_link_under_cursor(content: text, cursor_line: i64, cursor_col: i64) -> text:
    val lines = content.split("\n")
    if cursor_line < 0 or cursor_line >= lines.len():
        return ""
    _md_link_target_at(lines[cursor_line], cursor_col)

fn _md_find_from(line: text, needle: text, start: i64) -> i64:
    """index_of restricted to the suffix beginning at start; -1 when absent."""
    if start < 0 or start > line.len():
        return -1
    val found = line.slice(start, line.len()).index_of(needle)
    if found < 0:
        return -1
    start + found

fn _md_link_target_at(line: text, cursor_col: i64) -> text:
    # A line can carry several links; scan every one of them, not just the
    # first, and return the link the cursor actually sits inside.
    var wiki_start = line.index_of("[[")
    while wiki_start >= 0:
        val wiki_end = _md_find_from(line, "]]", wiki_start + 2)
        if wiki_end < 0:
            break
        if cursor_col >= wiki_start and cursor_col <= wiki_end + 1:
            return line.slice(wiki_start + 2, wiki_end)
        wiki_start = _md_find_from(line, "[[", wiki_end + 2)
    var close_label = line.index_of("](")
    while close_label >= 0:
        var open_label = close_label
        while open_label >= 0 and line[open_label:open_label + 1] != "[":
            open_label = open_label - 1
        var close_target = close_label + 2
        while close_target < line.len() and line[close_target:close_target + 1] != ")":
            close_target = close_target + 1
        if open_label >= 0 and close_target < line.len() and cursor_col >= open_label and cursor_col <= close_target:
            return line.slice(close_label + 2, close_target)
        close_label = _md_find_from(line, "](", close_label + 2)
    ""

fn _md_document_stats_message(content: text) -> text:
    val lines = content.split("\n")
    var words = 0
    for line in lines:
        val trimmed = line.trim()
        val parts = trimmed.split(" ")
        for part in parts:
            if part.trim() != "":
                words = words + 1
    "Lines: " + lines.len().to_text() + " Words: ~" + words.to_text()
