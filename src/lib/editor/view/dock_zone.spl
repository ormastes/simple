# Editor Dock Zone — dock layout, zones, and positions.
#
# Provides: DockZone, DockPosition, DockPanel, DockLayout.

val DOCK_LEFT = 1
val DOCK_RIGHT = 2
val DOCK_BOTTOM = 3

# Panel identity is text; it is distinct from the numeric containing zone.
struct DockPanel:
    id: text
    label: text
    zone: i64
    icon: text
    visible: bool

enum DockPosition:
    Left
    Right
    Bottom
    Top
    Center
    Float

struct DockZone:
    id: i64
    position: DockPosition
    size: i64
    visible: bool

fn dock_zone_new(id: i64, position: DockPosition) -> DockZone:
    DockZone(id: id, position: position, size: 250, visible: true)

fn dock_zone_toggle(zone: DockZone) -> DockZone:
    DockZone(id: zone.id, position: zone.position, size: zone.size, visible: not zone.visible)

# DockZone.size is a pixel extent. Keep pointer hit testing in the same unit as
# layout rather than interpreting the value as a percentage of the viewport.
fn dock_zone_tab_contains(position: DockPosition, size: i64,
                          viewport_w: i64, viewport_h: i64, tab_h: i64,
                          x: i64, y: i64) -> bool:
    if viewport_w <= 0 or viewport_h <= 0 or tab_h <= 0 or size <= 0:
        return false
    var extent = size
    var zone_x = 0
    var zone_y = 0
    var zone_w = viewport_w
    var zone_h = viewport_h
    if position == DockPosition.Left:
        if extent > viewport_w:
            extent = viewport_w
        zone_w = extent
    elif position == DockPosition.Right:
        if extent > viewport_w:
            extent = viewport_w
        zone_x = viewport_w - extent
        zone_w = extent
    elif position == DockPosition.Bottom:
        if extent > viewport_h:
            extent = viewport_h
        zone_y = viewport_h - extent
        zone_h = extent
    else:
        return false
    val safe_tab_h = if tab_h < zone_h then tab_h else: zone_h
    x >= zone_x and x < zone_x + zone_w and y >= zone_y and y < zone_y + safe_tab_h

class DockLayout:
    left: DockZone
    right: DockZone
    bottom: DockZone
    active_right: text
    right_visible: bool
    panels: [DockPanel]
    active_left: text
    active_bottom: text

    static fn new() -> DockLayout:
        DockLayout(
            left: dock_zone_new(1, DockPosition.Left),
            right: dock_zone_new(2, DockPosition.Right),
            bottom: dock_zone_new(3, DockPosition.Bottom),
            active_right: "",
            right_visible: false,
            panels: [],
            active_left: "",
            active_bottom: ""
        )

    fn visible_panels_in(self: DockLayout, zone: i64) -> [DockPanel]:
        var result: [DockPanel] = []
        if zone != DOCK_LEFT and zone != DOCK_RIGHT and zone != DOCK_BOTTOM:
            return result
        for panel in self.panels:
            if panel.zone == zone and panel.visible:
                result.push(panel)
        result

    me add_panel(panel: DockPanel) -> ():
        if panel.id == "" or (panel.zone != DOCK_LEFT and panel.zone != DOCK_RIGHT and panel.zone != DOCK_BOTTOM):
            return
        # Replace in place to retain tab order and same-zone active selection.
        var i = 0
        while i < me.panels.len():
            if me.panels[i].id == panel.id:
                me.panels[i] = panel
                if me.active_left == panel.id and (panel.zone != DOCK_LEFT or not panel.visible):
                    me.active_left = ""
                if me.active_right == panel.id and (panel.zone != DOCK_RIGHT or not panel.visible):
                    me.active_right = ""
                if me.active_bottom == panel.id and (panel.zone != DOCK_BOTTOM or not panel.visible):
                    me.active_bottom = ""
                return
            i = i + 1
        me.panels.push(panel)

    me remove_panel(id: text):
        var remaining: [DockPanel] = []
        for panel in me.panels:
            if panel.id != id:
                remaining.push(panel)
        me.panels = remaining
        if me.active_left == id:
            me.active_left = ""
        if me.active_right == id:
            me.active_right = ""
        if me.active_bottom == id:
            me.active_bottom = ""

    me set_active(zone: i64, id: text):
        for panel in me.panels:
            if panel.id == id and panel.zone == zone and panel.visible:
                if zone == DOCK_LEFT:
                    me.active_left = id
                elif zone == DOCK_RIGHT:
                    me.active_right = id
                    me.right_visible = true
                elif zone == DOCK_BOTTOM:
                    me.active_bottom = id
                return

    me left_width_value() -> i64:
        me.left.size

    me right_width_value() -> i64:
        me.right.size

    me is_right_visible() -> bool:
        me.right.visible

    # --- right-panel switching used by the controller/render layer ---
    me show_right(panel: text):
        me.active_right = panel
        me.right_visible = true

    me hide_right():
        me.right_visible = false

    fn active_right_panel() -> text:
        me.active_right

    me toggle_left() -> DockLayout:
        DockLayout(left: dock_zone_toggle(me.left), right: me.right, bottom: me.bottom,
                   active_right: me.active_right, right_visible: me.right_visible,
                   panels: me.panels, active_left: me.active_left, active_bottom: me.active_bottom)

    me toggle_right() -> DockLayout:
        DockLayout(left: me.left, right: dock_zone_toggle(me.right), bottom: me.bottom,
                   active_right: me.active_right, right_visible: me.right_visible,
                   panels: me.panels, active_left: me.active_left, active_bottom: me.active_bottom)

    me toggle_bottom() -> DockLayout:
        DockLayout(left: me.left, right: me.right, bottom: dock_zone_toggle(me.bottom),
                   active_right: me.active_right, right_visible: me.right_visible,
                   panels: me.panels, active_left: me.active_left, active_bottom: me.active_bottom)
