# Document Text Model
#
# Minimal in-memory text model for a single open document: byte-offset
# replace + snapshot only. No rope, no incremental diffing, no line index --
# depth (large-file performance, multi-cursor-aware edits) arrives with lane
# L1. Part of the S3 document-service skeleton; see
# doc/03_plan/app/ide_extension_kernel/parallel_agent_shared_foundation_plan.md
# section S3.

struct TextDocumentModel:
    content: text

fn text_document_model_new(content: text) -> TextDocumentModel:
    TextDocumentModel(content: content)

fn text_document_model_apply_replace(model: TextDocumentModel, start: i64, end_ex: i64, new_text: text) -> TextDocumentModel:
    """Replace the byte range [start, end_ex) with new_text. Offsets outside
    the current content are clamped rather than erroring."""
    val content = model.content
    val len = content.len()
    var safe_start = start
    if safe_start < 0:
        safe_start = 0
    if safe_start > len:
        safe_start = len
    var safe_end = end_ex
    if safe_end < safe_start:
        safe_end = safe_start
    if safe_end > len:
        safe_end = len
    val before = content.slice(0, safe_start)
    val after = content.slice(safe_end, len)
    TextDocumentModel(content: before + new_text + after)

fn text_document_model_snapshot(model: TextDocumentModel) -> text:
    model.content
