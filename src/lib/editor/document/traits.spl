# Document Service Contracts
#
# Declaration-level contracts other lanes implement against the
# DocumentRegistry skeleton: codecs decode/encode on-disk text, editor
# providers claim a document kind and hand back an editor surface, renderers
# turn model text into a display representation. No default wiring here --
# that is lane depth (L1-L4). Part of the S3 document-service skeleton; see
# doc/03_plan/app/ide_extension_kernel/parallel_agent_shared_foundation_plan.md
# section S3.

trait DocumentCodec:
    """Detects and (de)serializes a document's persisted text form."""

    # Confidence score for handling `uri`/`head` (0 = no match, higher =
    # stronger match). Callers pick the codec with the highest score.
    fn probe(uri: text, head: text) -> i64

    # Decode on-disk content into the in-memory model text.
    fn load(content: text) -> Result<text, text>

    # Encode the in-memory model text back into on-disk content.
    fn save(model_text: text) -> Result<text, text>

trait DocumentEditorProvider:
    """Supplies an editor surface for the documents this provider claims."""

    fn provider_id() -> text
    fn supports(uri: text) -> bool
    fn create_editor(uri: text, content: text) -> text

trait DocumentRenderer:
    """Renders a document model to a display representation."""

    fn renderer_id() -> text
    fn render(model_text: text) -> text

# --- One trivial DocumentCodec implementation, so the trait is exercised ---

class PlainTextCodec:
    _marker: i32

    static fn new() -> PlainTextCodec:
        PlainTextCodec(_marker: 0)

impl DocumentCodec for PlainTextCodec:

    fn probe(uri: text, head: text) -> i64:
        1

    fn load(content: text) -> Result<text, text>:
        Ok(content)

    fn save(model_text: text) -> Result<text, text>:
        Ok(model_text)
