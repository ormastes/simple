# Root unit of the prebuilt stdlib static archive (//std:libsimple_std).
#
# `native-build --emit-archive` on this file compiles the top-level std
# modules it imports into libsimple_std-<semver>-<triple>-<tier>.a, so apps
# link that archive instead of recompiling std. Built only by the opt-in
# `stdlib_static` group (config/build/stdlib_static.sdn); a default build
# never touches it. Plan: doc/05_design/compiler/backend_dynamic_plugin_build_groups.md §2.5.

use std.bitwise_utils
use std.common
use std.compute
use std.crypto
use std.format_utils
use std.hash
use std.io_runtime
use std.log
use std.math
use std.platform
use std.process
use std.string
use std.string_core
use std.text
use std.validation_utils
