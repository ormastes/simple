# Canonical public PTY capability for source-tree builds.
# Raw runtime operations are private to this module.

extern fn rt_pty_open(rows: i32, cols: i32) -> i32
extern fn rt_pty_spawn(handle: i32, program: text) -> i64
extern fn rt_pty_write(handle: i64, data: text) -> bool
extern fn rt_pty_read(handle: i64, timeout_ms: i64) -> text
extern fn rt_pty_close(handle: i64) -> bool
extern fn rt_pty_is_running(handle: i64) -> bool
extern fn rt_pty_resize(handle: i64, rows: i32, cols: i32) -> bool
extern fn rt_pty_hangup(handle: i64) -> bool
# Unix structured launch / literal bytes / exit status (Rust lanes; the C lane
# and Windows refuse with -1 / -2). env entries: "+NAME=VALUE" or "-NAME".
extern fn rt_pty_spawn_exec_v1(handle: i32, program: text, args: [text], cwd: text, env: [text]) -> i64
extern fn rt_pty_write_bytes_v1(handle: i64, data: [u8]) -> i64
extern fn rt_pty_exit_code_v1(handle: i64) -> i64

# HOST-OS DETECTOR CONSOLIDATION (2026-09-14): use the single canonical
# rt_platform_name wrapper (std.sffi.platform), not a locally re-declared
# extern with a differing (nullable) signature. See
# doc/08_tracking/bug/win_host_os_detector_disagreement_2026-09-14.md.
use std.sffi.platform.{platform_name_raw}
use std.sys.pty_input_codec.{pty_input_prefix}
export use std.sys.pty_launch.{PtyLaunchV1, PtyLaunchModeV1, PtyEnvironmentChangeV1}

fn _pty_unix_host() -> bool:
    not platform_name_raw().lower().contains("windows")

fn _pty_env_entries(changes: [PtyEnvironmentChangeV1]) -> Result<[text], text>:
    var entries: [text] = []
    for change in changes:
        match change:
            case PtyEnvironmentChangeV1.Set(name, value):
                if name == "" or name.contains("=") or name.contains("\0") or value.contains("\0"):
                    return Err("invalid PTY environment assignment")
                entries.push("+" + name + "=" + value)
            case PtyEnvironmentChangeV1.Remove(name):
                if name == "" or name.contains("=") or name.contains("\0"):
                    return Err("invalid PTY environment removal")
                entries.push("-" + name)
    Ok(entries)

# Unix structured launch: literal execve of Exec(executable, argv) with argv
# after argv[0], optional cwd and environment changes applied to a copy of the
# parent environment. Shell(command) is the SOSIX default shell's `-c`, the
# POSIX meaning of a shell launch. Never a shell prefix around an Exec.
# The portable Windows ABI cannot carry these fields and refuses explicitly.
pub fn spawn_configured_v1(handle: i32, launch: PtyLaunchV1) -> Result<i64, text>:
    if handle < 0: return Err("invalid pty handle")
    if not _pty_unix_host():
        return Err("structured PTY launch unavailable in this runtime composition")
    var program = ""
    var args: [text] = []
    match launch.mode:
        case PtyLaunchModeV1.Exec(executable, argv):
            program = executable
            args = argv
        case PtyLaunchModeV1.Shell(command):
            program = platform_default_shell()
            args = ["-c", command]
    if program == "" or program.contains("\0"): return Err("invalid PTY executable")
    for arg in args:
        if arg.contains("\0"): return Err("PTY argument contains embedded NUL")
    var directory = ""
    if val cwd = launch.cwd:
        if cwd == "" or cwd.contains("\0"): return Err("invalid PTY working directory")
        directory = cwd
    val entries = _pty_env_entries(launch.environment)?
    val pid = rt_pty_spawn_exec_v1(handle, program, args, directory, entries)
    if pid <= 0: return Err("structured PTY launch failed")
    Ok(pid)

# Startup effect contract, not a polling API: one real PTY is opened and
# closed. Success is availability, not proof a later spawn works.
pub fn configured_launch_probe_v1() -> bool:
    if not _pty_unix_host(): return false
    val handle = open(1, 1)
    if handle < 0: return false
    close(handle)

# Unix writes raw octets to the PTY master; the portable Windows ABI is the
# UTF8-prefix/text path and cannot preserve arbitrary channel octets.
pub fn literal_bytes_supported_v1() -> bool:
    _pty_unix_host()

pub fn write_literal_some_v1(handle: i32, data: [u8]) -> Result<i64, text>:
    if handle < 0: return Err("invalid pty handle")
    if not _pty_unix_host():
        return Err("literal PTY bytes unsupported in this runtime composition")
    val accepted = rt_pty_write_bytes_v1(handle as i64, data)
    if accepted < 0: return Err("literal PTY write failed")
    Ok(accepted)

pub fn open(rows: i32, cols: i32) -> i32:
    if rows <= 0 or cols <= 0:
        return -1
    rt_pty_open(rows, cols)

pub fn exit_code(handle: i32) -> Result<i64, text>:
    if handle < 0: return Err("invalid pty handle")
    if not _pty_unix_host():
        return Err("PTY exit status unavailable in this runtime composition")
    val code = rt_pty_exit_code_v1(handle as i64)
    if code == -1: return Err("PTY child still running")
    if code < 0: return Err("PTY has no child exit status")
    Ok(code)

pub fn spawn(handle: i32, program: text) -> i64:
    if handle < 0 or program == "":
        return -1
    rt_pty_spawn(handle, program)

pub fn write(handle: i32, data: text) -> bool:
    if handle < 0:
        return false
    rt_pty_write(handle as i64, data)

# Legacy portable provider writes synchronously. Native Windows configured
# providers override this surface with byte-preserving nonblocking writes.
# This fallback cannot qualify owner-loop fairness. It accepts only complete
# UTF-8 scalars, retaining an incomplete final scalar for the caller to retry.
pub fn write_some(handle: i32, data: [u8]) -> i64:
    if handle < 0:
        return -1
    val prefix = pty_input_prefix(data)
    if prefix.is_err():
        return -1
    val accepted = prefix.unwrap()
    if accepted.accepted == 0:
        return 0
    if not write(handle, accepted.content):
        return -1
    return accepted.accepted

pub fn input_pending(handle: i32) -> Result<bool, text>:
    if handle < 0:
        return Err("invalid pty handle")
    return Ok(false)

pub fn read(handle: i32, timeout_ms: i32) -> text:
    if handle < 0 or timeout_ms < 0:
        return ""
    rt_pty_read(handle as i64, timeout_ms as i64)

pub fn close(handle: i32) -> bool:
    if handle < 0:
        return false
    rt_pty_close(handle as i64)

pub fn is_running(handle: i32) -> bool:
    if handle < 0:
        return false
    rt_pty_is_running(handle as i64)

# Hangs up the child ahead of its close; close stays the only closer and
# reaper. A teardown of several PTYs hangs them all up first and then closes
# each, so children that ignore SIGHUP share one ~1 s grace period instead of
# paying one each. True when a child was signalled. Needs a runtime with
# rt_pty_hangup (a stale runtime stops with an unresolved-extern error), so
# callers use it only when batching several closes.
pub fn hangup(handle: i32) -> bool:
    if handle < 0:
        return false
    rt_pty_hangup(handle as i64)

var _resize_proven = false
var _resize_refused = false

# Positive probe, not a platform guess: resize one real scratch PTY once per
# process. A lane that cannot resolve its handles (the C lane on Windows) answers
# false. A failed open proves nothing about resize, so it is not remembered.
# A runtime that predates rt_pty_resize stops here with its unresolved-extern
# error, which is also a refusal.
pub fn can_resize() -> bool:
    if _resize_proven:
        return true
    if _resize_refused:
        return false
    val handle = open(2, 2)
    if handle < 0:
        return false
    val resized = resize(handle, 3, 4)
    val _closed = close(handle)
    if resized:
        _resize_proven = true
    else:
        _resize_refused = true
    resized

pub fn resize(handle: i32, rows: i32, cols: i32) -> bool:
    if handle < 0 or rows <= 0 or cols <= 0:
        return false
    rt_pty_resize(handle as i64, rows, cols)

# The legacy close ABI reclaims synchronously; it owns no deferred buffers.
# The native provider overrides this with its cancellation/JobObject sweep.
pub fn cleanup_pending() -> i64:
    0

pub fn platform_default_shell() -> text:
    val platform = platform_name_raw()
    if platform.lower().contains("windows"):
        return "cmd.exe"
    "/bin/sh"
