"""Stable interactive console capability. Select a qualified native provider."""

pub fn open() -> Result<i64, text>:
    Err("interactive console provider unavailable in this runtime composition")

pub fn read(handle: i64, max_bytes: i64) -> Result<text, text>:
    Err("interactive console provider unavailable in this runtime composition")

pub fn size(handle: i64) -> Result<[i64], text>:
    Err("interactive console provider unavailable in this runtime composition")

pub fn write(handle: i64, data: text) -> Result<bool, text>:
    Err("interactive console provider unavailable in this runtime composition")

pub fn close(handle: i64) -> bool: false

pub fn cleanup() -> bool: true

pub fn clipboard_write(handle: i64, data: text) -> Result<bool, text>:
    Err("interactive clipboard provider unavailable in this runtime composition")
