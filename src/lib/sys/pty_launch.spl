# Portable structured PTY launch values. Native pointers never cross this API.
# Select the implementation through the configured std.sys.pty provider.
pub enum PtyLaunchModeV1:
    Exec(executable: text, argv: [text])
    Shell(command: text)

pub enum PtyEnvironmentChangeV1:
    Set(name: text, value: text)
    Remove(name: text)

pub struct PtyLaunchV1:
    mode: PtyLaunchModeV1
    cwd: text?
    environment: [PtyEnvironmentChangeV1]
