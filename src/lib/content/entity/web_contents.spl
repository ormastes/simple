# Web Contents — navigation and document state for a browser tab/frame.
#
# Provides: WebContents.

use std.skia.entity.geometry.{SkRect}
use std.viz.entity.surface_id.{FrameSinkId, LocalSurfaceId, SurfaceId}
use std.blink.entity.paint_artifact.{PaintArtifact}

enum WebContentsState:
    Initializing
    Loading
    Ready
    Error

class WebContents:
    id: i32
    url: text
    title: text
    state: WebContentsState
    error_text: text
    # The visible area this tab paints into.
    viewport: SkRect
    # The compositor surface the tab's main frame submits to. Its sink id is
    # always 1 — the main frame is the first sink a client allocates.
    main_frame_surface: SurfaceId
    # The most recent paint pass result, or None before any paint happened.
    last_paint: PaintArtifact?

    static fn new(id: i32, viewport: SkRect) -> WebContents:
        WebContents(
            id: id,
            url: "",
            title: "",
            state: WebContentsState.Initializing,
            error_text: "",
            viewport: viewport,
            main_frame_surface: SurfaceId(
                frame_sink_id: FrameSinkId(client_id: id, sink_id: 1),
                local_surface_id: LocalSurfaceId(
                    parent_sequence_number: 1,
                    child_sequence_number: 1
                )
            ),
            last_paint: nil
        )

    me set_title(title: text):
        me.title = title

    # Record the artifact produced by the latest paint pass.
    me update_paint(artifact: PaintArtifact):
        me.last_paint = artifact

    me navigate(url: text):
        me.url = url
        me.state = WebContentsState.Loading
        me.title = url

    me on_load_committed(title: text):
        me.title = title
        me.state = WebContentsState.Ready

    me on_load_error(error: text):
        me.error_text = error
        me.state = WebContentsState.Error

    fn is_ready() -> bool:
        match me.state:
            case Ready: true
            case _: false
