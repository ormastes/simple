pub fn generate_rv32_product_wb64_wrapper_vhdl() -> text:
    """Adapt the compiler-emitted RV32IMAC product core to the shared WB64 fabric."""
    return """library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity rv32imac_core_product_wb is
  generic (
    RESET_ADDR : std_logic_vector(63 downto 0) := x"0000000080000000"
  );
  port (
    clk          : in  std_logic;
    rst          : in  std_logic;
    msip_i       : in  std_logic;
    mtip_i       : in  std_logic;
    meip_i       : in  std_logic;
    stip_i       : in  std_logic;
    seip_i       : in  std_logic;
    time_value_i : in  std_logic_vector(63 downto 0);
    wb_adr_o     : out std_logic_vector(63 downto 0);
    wb_dat_o     : out std_logic_vector(63 downto 0);
    wb_dat_i     : in  std_logic_vector(63 downto 0);
    wb_we_o      : out std_logic;
    wb_sel_o     : out std_logic_vector(7 downto 0);
    wb_stb_o     : out std_logic;
    wb_cyc_o     : out std_logic;
    wb_lock_o    : out std_logic;
    wb_ack_i     : in  std_logic;
    wb_err_i     : in  std_logic
  );
end entity rv32imac_core_product_wb;

architecture rtl of rv32imac_core_product_wb is
  type adapter_state_t is (idle, wishbone, respond);
  signal adapter_state    : adapter_state_t := idle;
  signal core_bus_valid   : bit;
  signal core_bus_addr    : unsigned(33 downto 0);
  signal core_bus_size    : unsigned(31 downto 0);
  signal core_bus_write   : bit;
  signal core_bus_wdata   : unsigned(31 downto 0);
  signal core_bus_lock    : bit;
  signal request_ready_b  : bit;
  signal response_valid_b : bit;
  signal response_error_q : bit := '0';
  signal response_data_q  : unsigned(31 downto 0) := (others => '0');
  signal addr_q           : unsigned(33 downto 0) := (others => '0');
  signal size_q           : unsigned(31 downto 0) := (others => '0');
  signal write_q          : bit := '0';
  signal wdata_q          : unsigned(31 downto 0) := (others => '0');
  signal lock_q           : bit := '0';
begin
  request_ready_b  <= '1' when adapter_state = idle else '0';
  response_valid_b <= '1' when adapter_state = respond else '0';
  wb_adr_o         <= std_logic_vector(resize(addr_q, 64));
  wb_we_o          <= to_stdulogic(write_q);
  wb_stb_o         <= '1' when adapter_state = wishbone else '0';
  wb_cyc_o         <= '1' when adapter_state = wishbone else '0';
  wb_lock_o        <= to_stdulogic(lock_q);

  p_lanes: process(all)
    variable lane : natural range 0 to 7;
    variable mask : unsigned(7 downto 0);
  begin
    lane := to_integer(addr_q(2 downto 0));
    mask := (others => '0');
    if size_q = to_unsigned(1, size_q'length) then
      mask(0) := '1';
    elsif size_q = to_unsigned(2, size_q'length) then
      mask(1 downto 0) := "11";
    elsif size_q = to_unsigned(4, size_q'length) then
      mask(3 downto 0) := "1111";
    end if;
    wb_sel_o <= std_logic_vector(shift_left(mask, lane));
    wb_dat_o <= std_logic_vector(shift_left(resize(wdata_q, 64), lane * 8));
  end process;

  p_adapter: process(clk)
    variable lane : natural range 0 to 7;
  begin
    if rising_edge(clk) then
      if rst = '1' then
        adapter_state <= idle;
        addr_q <= (others => '0');
        size_q <= (others => '0');
        write_q <= '0';
        wdata_q <= (others => '0');
        lock_q <= '0';
        response_error_q <= '0';
        response_data_q <= (others => '0');
      else
        case adapter_state is
          when idle =>
            response_error_q <= '0';
            if core_bus_valid = '1' then
              addr_q <= core_bus_addr;
              size_q <= core_bus_size;
              write_q <= core_bus_write;
              wdata_q <= core_bus_wdata;
              lock_q <= core_bus_lock;
              adapter_state <= wishbone;
            end if;
          when wishbone =>
            if wb_ack_i = '1' or wb_err_i = '1' then
              lane := to_integer(addr_q(2 downto 0));
              response_data_q <= resize(shift_right(unsigned(wb_dat_i), lane * 8), 32);
              response_error_q <= to_bit(wb_err_i);
              adapter_state <= respond;
            end if;
          when respond =>
            adapter_state <= idle;
        end case;
      end if;
    end if;
  end process;

  u_product_core: entity work.core32_protected_product_entry
    port map (
      clk => to_bit(clk),
      reset_n => to_bit(not rst),
      reset_vec => unsigned(RESET_ADDR(31 downto 0)),
      msip => to_bit(msip_i),
      mtip => to_bit(mtip_i),
      meip => to_bit(meip_i),
      stip => to_bit(stip_i),
      seip => to_bit(seip_i),
      time_value => signed(time_value_i),
      request_ready => request_ready_b,
      response_valid => response_valid_b,
      response_error => response_error_q,
      response_data => response_data_q,
      bus_valid => core_bus_valid,
      bus_addr => core_bus_addr,
      bus_size => core_bus_size,
      bus_write => core_bus_write,
      bus_wdata => core_bus_wdata,
      bus_is_pte => open,
      bus_atomic => open,
      bus_lock => core_bus_lock,
      rvfi_valid => open,
      rvfi_order => open,
      rvfi_insn => open,
      rvfi_trap => open,
      rvfi_halt => open,
      rvfi_intr => open,
      rvfi_mode => open,
      rvfi_ixl => open,
      rvfi_rs1_addr => open,
      rvfi_rs2_addr => open,
      rvfi_rs1_rdata => open,
      rvfi_rs2_rdata => open,
      rvfi_rd_addr => open,
      rvfi_rd_wdata => open,
      rvfi_pc_rdata => open,
      rvfi_pc_wdata => open,
      rvfi_mem_addr => open,
      rvfi_mem_rmask => open,
      rvfi_mem_wmask => open,
      rvfi_mem_rdata => open,
      rvfi_mem_wdata => open
    );
end architecture rtl;
"""
