# capsule: vhdl.emit.metadata
# FPGA Linux manifest capsule.
#
# The existing manifest model stays in fpga_linux_data for this first,
# compatibility preserving extraction.  This capsule owns JSON sidecar
# serialization, keeping literal key order as an explicit contract.

pub fn fpga_linux_manifest_capsule_name() -> text:
    "fpga_linux_manifest"

pub fn sidecar_json(output_dir: text, lane: text, product_level: text, configuration_profile: text, rv32_luts: i64, rv64_luts: i64, rv32_mhz: i64, rv64_mhz: i64) -> text:
    val isa = if lane == "rv32": "rv32imc_zicsr" else: "rv64im_zicsr"
    val abi = if lane == "rv32": "ilp32" else: "lp64"
    val mmu = if lane == "rv32": "sv32" else: "sv39"
    val luts = if lane == "rv32": rv32_luts else: rv64_luts
    val mhz = if lane == "rv32": rv32_mhz else: rv64_mhz
    val formal_status = "contract-not-ready"
    val formal_reason = "placeholder-core-no-semantic-rvfi"
    val observed_rvfi_ports = 0
    val runner_testbenches = if lane == "rv32": "[{\"file\":\"tb_generated_rv32_linux_handoff.vhd\", \"status\":\"contract-not-ready\"}, {\"file\":\"tb_generated_rv32_boot_info_real_dtb.vhd\", \"status\":\"contract-not-ready\"}]" else: "[{\"file\":\"tb_generated_rv64_boot_info_dtb.vhd\", \"status\":\"contract-not-ready\"}, {\"file\":\"tb_generated_rv64_fw_jump.vhd\", \"status\":\"contract-not-ready\"}, {\"file\":\"tb_generated_rv64_boot_info_real_dtb.vhd\", \"status\":\"contract-not-ready\"}, {\"file\":\"tb_generated_rv64_sv39.vhd\", \"status\":\"contract-not-ready\"}, {\"file\":\"tb_generated_rv64_sv39_fault.vhd\", \"status\":\"contract-not-ready\"}]"
    val core = "simple_{lane}gc_core"
    val observability = "{\"fetch\": false, \"trap\": false, \"halt\": false, \"memoryAccess\": false, \"registerProbes\": false, \"debugProbes\": false, \"proofFailureReports\": true}"
    "{\"schemaVersion\": \"riscv_rtl_debuggability_lint/v1\", \"laneId\": \"{lane}\", \"proofLane\": \"generated_{lane}_linux\", \"xlen\": \"{lane}\", \"generatedFrom\": \"{core}.spl\", \"topModule\": \"{core}\", \"rtlDir\": \"{output_dir}/{lane}/rtl\", \"shellSummary\": \"generated_{lane}_linux shell=none\", \"readiness\": \"contract-not-ready\", \"reason\": \"placeholder-core-no-semantic-rvfi\", \"linuxBootValidated\": false, \"platform\": \"qemu_virt_{lane}\", \"scope\": \"repo-native {isa} generated-core Linux lane\", \"linuxPolicy\": \"repo-native-{lane}-linux\", \"productLevel\": \"{product_level}\", \"configurationProfile\": \"{configuration_profile}\", \"authoritative\": false, \"provenance\": {\"authoritativeRtl\": \"none\", \"contractFiles\": [\"{output_dir}/{lane}/rtl/{core}.spl\", \"{output_dir}/{lane}/rtl/{core}_pkg.vhd\", \"{output_dir}/{lane}/rtl/{core}.vhd\", \"{output_dir}/{lane}/rtl/{core}.debug.json\"], \"auxiliaryVhdl\": \"emitted-text-vhdl\", \"runnerTestbenches\": \"emitted-text-vhdl\", \"pureSimpleAuthoritativeRtl\": false}, \"isa\": \"{isa}\", \"abi\": \"{abi}\", \"mmu\": \"{mmu}\", \"rtlBudget\": {\"maxLuts\": {luts}, \"targetMhz\": {mhz}}, \"formal\": {\"flow\": \"rvfi+sby\", \"gate\": \"placeholder-rejected\", \"status\": \"{formal_status}\", \"reason\": \"{formal_reason}\", \"rvfiPortCount\": 17, \"observedRvfiPortCount\": {observed_rvfi_ports}, \"harness\": \"{output_dir}/{lane}/rtl/{core}_formal.vhd\", \"sby\": \"{output_dir}/{lane}/rtl/{core}.sby\", \"manifest\": \"{output_dir}/{lane}/rtl/{core}_formal.sdn\"}, \"firmwareMode\": \"fw_jump\", \"acceptanceMarkers\": [\"OpenSBI\", \"Linux version\", \"OF: fdt\", \"Freeing unused kernel memory\", \"init started\"], \"observability\": {observability}, \"reportMarkers\": [\"GENERATED_RTL_NOT_IMPLEMENTED\"], \"runnerSuccessMarkers\": {}, \"runnerTestbenches\": {runner_testbenches}, \"sourceMap\": [], \"debugOutputs\": [\"semi_trigger\", \"semi_op\", \"semi_param\", \"debug_pc\"], \"shellServices\": {\"semihost\": false, \"mailbox\": false}}\n"
