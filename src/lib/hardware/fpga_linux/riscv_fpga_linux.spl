# capsule: re-export
# FPGA Linux public compatibility facade.
#
# The implementation follows manifest -> data -> orchestration dependencies.
# The manifest owns board/lane contracts, the data module emits RTL artifacts,
# and orchestration assembles bundles.  Keep this module as the stable import path for hardware clients.

export use std.hardware.fpga_linux.fpga_linux_orchestrator.*
export use std.hardware.fpga_linux.fpga_linux_data.*
export use std.hardware.fpga_linux.fpga_linux_manifest.*

# Stable type-level API imported by hardware clients.
export RiscvFpgaLane, RiscvFpgaLinuxManifest, XilinxBoardProfile
