# Structured exec-core VHDL generator — emits BOTH silicon-lane cores
# (rv32_exec_core.vhd / rv64_exec_core.vhd) byte-identical to the proven
# goldens in examples/09_embedded/fpga_riscv/rtl/, from one shared template
# source parameterized by XlenConfig ("Python-style RTL generation" as a
# structured sectioned generator; see
# doc/01_research/hardware/riscv/python_rtl_generation_survey_2026-07-26.md).
#
# Structurally generated: entity/generic/port sections (typed descriptor
# arrays), constants (XlenConfig + VgCoreGeometry), regs_t/state_t types,
# memory-init impure functions, concurrent assigns, top-level instruction
# decode case arms (opcode table), CSR read-mux cases (CSR table), and all
# dbg_* taps (debug_tap_aspect join points). Irreducible per-core logic
# paragraphs are named section constants in rv32_sections.spl /
# rv64_sections.spl.
#
# Determinism: arrays only, no Dict iteration during emission; two runs are
# byte-identical.

use std.hardware.riscv_common.xlen.XlenConfig
use std.hardware.vhdl_gen.gen_types.*
use std.hardware.vhdl_gen.debug_tap_aspect.{dbg_tap_ports, dbg_tap_signal_lines, dbg_tap_assigns, dbg_tap_process_lines}
use std.hardware.vhdl_gen.rv32_sections.*
use std.hardware.vhdl_gen.rv64_sections.*

fn jl(lines: [text]) -> text:
    lines.join("\n")

fn push_part(parts: [text], lines: [text]) -> [text]:
    if lines.len() == 0:
        parts
    else:
        parts.push(jl(lines))

fn append_ports(dst: [VgPort], src: [VgPort]) -> [VgPort]:
    var out = dst
    var i = 0
    while i < src.len():
        out = out.push(src[i])
        i = i + 1
    out

fn append_assigns(dst: [VgAssign], src: [VgAssign]) -> [VgAssign]:
    var out = dst
    var i = 0
    while i < src.len():
        out = out.push(src[i])
        i = i + 1
    out

# ---------------------------------------------------------------------------
# Geometry (per core) and shared descriptor tables
# ---------------------------------------------------------------------------

fn rv32_geometry() -> VgCoreGeometry:
    VgCoreGeometry(
        entity_name: "rv32_exec_core",
        base_addr: 0x80000000,
        uart_addr: 0x10000000,
        rom_words: 16384,
        data_rom_words: 16384,
        mem_words: 0,
        aligned: false,
        case_indent: 10,
        csr_indent: 20
    )

fn rv64_geometry() -> VgCoreGeometry:
    VgCoreGeometry(
        entity_name: "rv64_exec_core",
        base_addr: 0x80000000,
        uart_addr: 0x10000000,
        rom_words: 0,
        data_rom_words: 0,
        mem_words: 8192,
        aligned: true,
        case_indent: 8,
        csr_indent: 18
    )

fn core_generics() -> [VgGeneric]:
    var g: [VgGeneric] = []
    g = g.push(VgGeneric(name: "CLK_FREQ", ty: "natural", default_val: "100000000"))
    g = g.push(VgGeneric(name: "BAUD_RATE", ty: "natural", default_val: "115200"))
    g

fn core_ports() -> [VgPort]:
    var p: [VgPort] = []
    p = p.push(VgPort(pre_comments: no_lines(), name: "clk", dir: "in", ty: "std_logic", default_val: ""))
    p = p.push(VgPort(pre_comments: no_lines(), name: "rst", dir: "in", ty: "std_logic", default_val: ""))
    p = p.push(VgPort(pre_comments: no_lines(), name: "uart_tx", dir: "out", ty: "std_logic", default_val: ""))
    p

fn addr_const(cfg: XlenConfig, name: text, v: i64) -> VgConst:
    VgConst(
        pre_comments: no_lines(),
        name: name,
        ty: "unsigned(" + (cfg.xlen - 1).to_text() + " downto 0)",
        value: "x\"" + vg_hex(v, cfg.xlen / 4) + "\""
    )

fn nat_const(pre: [text], name: text, value: text) -> VgConst:
    VgConst(pre_comments: pre, name: name, ty: "natural", value: value)

fn rv32_consts(cfg: XlenConfig, geo: VgCoreGeometry) -> [VgConst]:
    var c: [VgConst] = []
    c = c.push(addr_const(cfg, "BASE_ADDR", geo.base_addr))
    c = c.push(addr_const(cfg, "UART_ADDR", geo.uart_addr))
    c = c.push(nat_const(no_lines(), "BAUD_DIV", "CLK_FREQ / BAUD_RATE"))
    var rom_pre: [text] = []
    rom_pre = rom_pre.push("  -- 64KB code ROM (14 bits = 16384 words), increased for full payload")
    c = c.push(nat_const(rom_pre, "ROM_WORDS", geo.rom_words.to_text()))
    c = c.push(nat_const(no_lines(), "DATA_ROM_WORDS", geo.data_rom_words.to_text()))
    c

fn rv64_consts(cfg: XlenConfig, geo: VgCoreGeometry) -> [VgConst]:
    var c: [VgConst] = []
    c = c.push(addr_const(cfg, "BASE_ADDR", geo.base_addr))
    c = c.push(addr_const(cfg, "UART_ADDR", geo.uart_addr))
    c = c.push(nat_const(no_lines(), "BAUD_DIV", "CLK_FREQ / BAUD_RATE"))
    var mem_pre: [text] = []
    mem_pre = mem_pre.push("  -- 64 KB unified memory: 8192 words * 8 bytes. Addresses 0x8000_0000 ..")
    mem_pre = mem_pre.push("  -- 0x8000_FFFF. Instructions are 32-bit, 4-byte aligned; each 64-bit word")
    mem_pre = mem_pre.push("  -- holds two of them (low half at .._0, high half at .._4).")
    c = c.push(nat_const(mem_pre, "MEM_WORDS", geo.mem_words.to_text()))
    c

fn rv32_rom_init_desc() -> VgMemInit:
    VgMemInit(
        fn_name: "init_rom", ret_ty: "rom_t", file_name: "rv32_payload.mem",
        line_var: "line_v", word_var: "word_v", mem_var: "mem_v",
        width: 32, fill_hex: "00000013", fill_comment: "",
        bound_const: "ROM_WORDS", aligned: false
    )

fn rv32_data_rom_init_desc() -> VgMemInit:
    VgMemInit(
        fn_name: "init_data_rom", ret_ty: "data_rom_t", file_name: "rv32_fat32.mem",
        line_var: "line_v", word_var: "word_v", mem_var: "mem_v",
        width: 32, fill_hex: "00000000", fill_comment: "",
        bound_const: "DATA_ROM_WORDS", aligned: false
    )

fn rv64_mem_init_desc() -> VgMemInit:
    VgMemInit(
        fn_name: "init_mem", ret_ty: "mem_t", file_name: "rv64_payload.mem",
        line_var: "ln", word_var: "word", mem_var: "m",
        width: 64, fill_hex: "0000000000000013",
        fill_comment: "  -- nop (addi x0,x0,0)",
        bound_const: "MEM_WORDS", aligned: true
    )

# ---------------------------------------------------------------------------
# CSR tables
# ---------------------------------------------------------------------------

fn base_csr_entries() -> [VgCsr]:
    var e: [VgCsr] = []
    e = e.push(VgCsr(sel: "x\"f11\"", reg: "csr_mhartid", comment: ""))
    e = e.push(VgCsr(sel: "x\"300\"", reg: "csr_mstatus", comment: ""))
    e = e.push(VgCsr(sel: "x\"305\"", reg: "csr_mtvec", comment: ""))
    e = e.push(VgCsr(sel: "x\"304\"", reg: "csr_mie", comment: ""))
    e = e.push(VgCsr(sel: "x\"344\"", reg: "csr_mip", comment: ""))
    e

fn rv64_csr_entries() -> [VgCsr]:
    var e = base_csr_entries()
    e = e.push(VgCsr(sel: "x\"b00\" | x\"c00\"", reg: "csr_mcycle", comment: "  -- mcycle / cycle"))
    e

# ---------------------------------------------------------------------------
# Opcode decode tables
# ---------------------------------------------------------------------------

fn plain_arm(code: text, body: [text]) -> VgArm:
    VgArm(pre_lines: no_lines(), code: code, inline: "", body: body)

fn rv32_system_body(geo: VgCoreGeometry) -> [text]:
    val csr = emit_csr_read_case(geo.csr_indent, base_csr_entries())
    var b = rv32_sys_glue_a()
    b = vg_append(b, csr)
    b = vg_append(b, rv32_sys_glue_b())
    b = vg_append(b, csr)
    b = vg_append(b, rv32_sys_glue_c())
    b = vg_append(b, csr)
    b = vg_append(b, rv32_sys_glue_d())
    b = vg_append(b, csr)
    b = vg_append(b, rv32_sys_glue_e())
    b = vg_append(b, csr)
    b = vg_append(b, rv32_sys_glue_f())
    b = vg_append(b, csr)
    b = vg_append(b, rv32_sys_glue_g())
    b

fn rv32_opcode_arms(geo: VgCoreGeometry) -> [VgArm]:
    var a: [VgArm] = []
    a = a.push(plain_arm("0010011", rv32_arm_op_imm()))
    a = a.push(plain_arm("0110011", rv32_arm_op()))
    a = a.push(plain_arm("0010111", rv32_arm_auipc()))
    a = a.push(plain_arm("0110111", rv32_arm_lui()))
    a = a.push(plain_arm("1101111", rv32_arm_jal()))
    a = a.push(plain_arm("1100111", rv32_arm_jalr()))
    a = a.push(plain_arm("1100011", rv32_arm_branch()))
    a = a.push(plain_arm("0000011", rv32_arm_load()))
    a = a.push(plain_arm("0100011", rv32_arm_store()))
    a = a.push(plain_arm("1110011", rv32_system_body(geo)))
    a = a.push(plain_arm("0101111", rv32_arm_amo()))
    a = a.push(plain_arm("others", rv32_arm_unknown()))
    a

fn rv64_arm_pre(comment: text, first: bool) -> [text]:
    var l: [text] = []
    if not first:
        l = l.push("")
    l = l.push("          " + comment)
    l

fn rv64_commented_arm(comment: text, first: bool, code: text, body: [text]) -> VgArm:
    VgArm(pre_lines: rv64_arm_pre(comment, first), code: code, inline: "", body: body)

fn rv64_system_body(geo: VgCoreGeometry) -> [text]:
    var b = rv64_sys_glue_a()
    b = vg_append(b, emit_csr_read_case(geo.csr_indent, rv64_csr_entries()))
    b = vg_append(b, rv64_sys_glue_b())
    b

fn rv64_opcode_arms(geo: VgCoreGeometry) -> [VgArm]:
    var a: [VgArm] = []
    a = a.push(rv64_commented_arm("-- OP-IMM (I-type ALU)", true, "0010011", rv64_arm_op_imm()))
    a = a.push(rv64_commented_arm("-- OP-IMM-32 (W immediate ALU)", false, "0011011", rv64_arm_op_imm32()))
    a = a.push(rv64_commented_arm("-- OP (R-type ALU + M-extension)", false, "0110011", rv64_arm_op()))
    a = a.push(rv64_commented_arm("-- OP-32 (R-type W ALU + W M-extension)", false, "0111011", rv64_arm_op32()))
    a = a.push(rv64_commented_arm("-- AUIPC", false, "0010111", rv64_arm_auipc()))
    a = a.push(rv64_commented_arm("-- LUI", false, "0110111", rv64_arm_lui()))
    a = a.push(rv64_commented_arm("-- JAL", false, "1101111", rv64_arm_jal()))
    a = a.push(rv64_commented_arm("-- JALR", false, "1100111", rv64_arm_jalr()))
    a = a.push(rv64_commented_arm("-- BRANCH", false, "1100011", rv64_arm_branch()))
    a = a.push(rv64_commented_arm("-- LOAD (deferred one cycle via mem_b / S_LOAD)", false, "0000011", rv64_arm_load()))
    a = a.push(rv64_commented_arm("-- STORE", false, "0100011", rv64_arm_store()))
    a = a.push(rv64_commented_arm("-- SYSTEM (ecall / ebreak / Zicsr reads)", false, "1110011", rv64_system_body(geo)))
    var blank: [text] = []
    blank = blank.push("")
    a = a.push(VgArm(pre_lines: blank, code: "others", inline: "null;", body: no_lines()))
    a

# ---------------------------------------------------------------------------
# Whole-core assembly
# ---------------------------------------------------------------------------

fn generate_rv32(cfg: XlenConfig, mem_prefix: text, debug_taps: bool) -> text:
    val geo = rv32_geometry()
    var parts: [text] = []
    parts = parts.push(jl(emit_library_header()))
    parts = parts.push("")
    val ports = append_ports(core_ports(), dbg_tap_ports(cfg, debug_taps))
    parts = parts.push(jl(emit_entity(geo.entity_name, core_generics(), ports, geo.aligned)))
    parts = parts.push("")
    parts = parts.push("architecture rtl of " + geo.entity_name + " is")
    parts = parts.push(jl(emit_constants(rv32_consts(cfg, geo), geo.aligned)))
    parts = parts.push(emit_regs_type(cfg.xlen))
    parts = parts.push(jl(rv32_type_arrays()))
    parts = parts.push(emit_state_type())
    parts = parts.push(jl(rv32_type_ldkind()))
    parts = parts.push("")
    parts = parts.push(jl(emit_mem_init(rv32_rom_init_desc(), mem_prefix)))
    parts = parts.push("")
    parts = parts.push(jl(emit_mem_init(rv32_data_rom_init_desc(), mem_prefix)))
    parts = parts.push("")
    parts = parts.push(jl(rv32_sig_block_a()))
    parts = push_part(parts, dbg_tap_signal_lines(cfg, debug_taps))
    parts = parts.push("")
    parts = parts.push(jl(rv32_helper_funcs()))
    parts = parts.push("begin")
    var assigns: [VgAssign] = []
    assigns = assigns.push(VgAssign(pre_comments: no_lines(), lhs: "uart_tx", rhs: "uart_tx_q"))
    assigns = append_assigns(assigns, dbg_tap_assigns(cfg, debug_taps))
    parts = parts.push(jl(emit_assigns(assigns, geo.aligned)))
    parts = parts.push("")
    parts = parts.push(jl(rv32_process_head()))
    parts = parts.push(jl(rv32_exec_prelude()))
    parts = parts.push(jl(rv32_rvc_decode()))
    parts = parts.push(jl(emit_decode_case(rv32_opcode_arms(geo), geo.case_indent)))
    parts = parts.push(jl(rv32_post_case()))
    parts = push_part(parts, dbg_tap_process_lines(cfg, debug_taps))
    parts = parts.push(jl(rv32_epilogue()))
    parts.join("\n") + "\n"

fn generate_rv64(cfg: XlenConfig, mem_prefix: text, debug_taps: bool) -> text:
    val geo = rv64_geometry()
    var parts: [text] = []
    parts = parts.push(jl(emit_library_header()))
    parts = parts.push("")
    parts = parts.push(jl(rv64_head_comment()))
    val ports = append_ports(core_ports(), dbg_tap_ports(cfg, debug_taps))
    parts = parts.push(jl(emit_entity(geo.entity_name, core_generics(), ports, geo.aligned)))
    parts = parts.push("")
    parts = parts.push("architecture rtl of " + geo.entity_name + " is")
    parts = parts.push(jl(emit_constants(rv64_consts(cfg, geo), geo.aligned)))
    parts = parts.push(emit_regs_type(cfg.xlen))
    parts = parts.push(jl(rv64_type_mem()))
    parts = parts.push(emit_state_type())
    parts = parts.push(jl(rv64_type_ldkind()))
    parts = parts.push("")
    parts = parts.push(jl(emit_mem_init(rv64_mem_init_desc(), mem_prefix)))
    parts = parts.push("")
    parts = parts.push(jl(rv64_sig_block()))
    parts = push_part(parts, dbg_tap_signal_lines(cfg, debug_taps))
    parts = parts.push("")
    parts = parts.push(jl(rv64_helper_funcs()))
    parts = parts.push("begin")
    var assigns: [VgAssign] = []
    assigns = assigns.push(VgAssign(pre_comments: no_lines(), lhs: "uart_tx", rhs: "uart_tx_q"))
    assigns = append_assigns(assigns, dbg_tap_assigns(cfg, debug_taps))
    parts = parts.push(jl(emit_assigns(assigns, geo.aligned)))
    parts = parts.push("")
    parts = parts.push(jl(rv64_process_head()))
    parts = parts.push(jl(rv64_exec_prelude()))
    parts = parts.push(jl(emit_decode_case(rv64_opcode_arms(geo), geo.case_indent)))
    parts = parts.push(jl(rv64_epilogue()))
    parts.join("\n") + "\n"

# Public entry: one shared template source, parameterized by XlenConfig.
fn generate_exec_core(cfg: XlenConfig, mem_prefix: text, debug_taps: bool) -> text:
    if cfg.is_rv32():
        generate_rv32(cfg, mem_prefix, debug_taps)
    else:
        generate_rv64(cfg, mem_prefix, debug_taps)

fn generate_rv32_exec_core(mem_prefix: text) -> text:
    generate_exec_core(XlenConfig.rv32(), mem_prefix, true)

fn generate_rv64_exec_core(mem_prefix: text) -> text:
    generate_exec_core(XlenConfig.rv64(), mem_prefix, true)
