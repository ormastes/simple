# KV260 DDR boot-testbench generator — ONE templated source parameterized by
# XlenConfig, emitting both members of the XLEN pair byte-identical to the
# goldens in examples/09_embedded/fpga_riscv/rtl/:
#
#   tb_rv32_k26_ddr_boot.vhd   (448 lines)
#   tb_rv64_k26_ddr_boot.vhd   (477 lines)
#
# These two testbenches rehearse the EXACT KV260 bring-up path that was proven
# on real silicon (soc_top_rv*_k26_ddr + axi4_mem_adapter + ctrl_obs_slave,
# transcript recovered over AXI-Lite the same way xsdb recovers it on the
# board), so accuracy is a silicon-lane concern, not a cosmetic one.
#
# Factoring:
#   - Structural (descriptor-driven, shared emitters): entity generics, the
#     constant table, all three signal groups, the memory array types, the
#     init_ram / init_rdisk impure functions incl. .mem file-open paths and
#     the garbage-fill / .bss-zero loops, the DUT generic map + port map, the
#     AXI4 DDR slave's per-bank read/write blocks (XLEN byte lanes and word
#     addresses computed from XlenConfig), and the AXI-Lite counter read-back
#     table in the checker.
#   - Named literal paragraphs (tb_k26_ddr_sections.spl): only irreducible
#     prose and fixed behavioural scaffolding — file headers, generic docs,
#     the lite_read/lite_write procedures, the transcript poll loop and the
#     marker verdict. k26_sh_* paragraphs are shared by BOTH members.
#
# Determinism: arrays only, never a Dict (seed Dict order is nondeterministic
# per process); repeated generation is byte-identical.

use std.hardware.riscv_common.xlen.XlenConfig
use std.hardware.vhdl_gen.gen_types.*
use std.hardware.vhdl_gen.tb_k26_ddr_sections.*

fn k26_join(lines: [text]) -> text:
    lines.join("\n")

# ---------------------------------------------------------------------------
# Descriptor types
# ---------------------------------------------------------------------------

# Testbench-entity generic (the tb entity has generics but NO port clause, so
# emit_entity/emit_entity_spec do not apply).
struct VgTbGeneric:
    pre_comments: [text]
    name: text
    name_w: i64
    ty: text
    default_val: text

# Architecture-declarative constant. Golden pads the name to the widest name
# in the group and puts ":" immediately after the pad (no separating space).
struct VgTbConst:
    pre_comments: [text]
    name: text
    ty: text
    value: text
    trail: text            # trailing comment incl. its leading spaces ("" if none)

# Signal declaration with an explicit, group-local name column width.
struct VgTbSignal:
    name: text
    name_w: i64
    ty: text
    init_val: text         # "" when the signal has no initial value

# One physical line of a port map: N formal=>actual connections, comma-joined.
struct VgConnGroup:
    conns: [text]

# init_ram / init_rdisk descriptor.
struct VgTbMemInit:
    fn_name: text
    ret_ty: text
    bound_const: text
    width: i64
    fill_expr: text        # RHS of `(others => ...)` initialiser
    file_name: text
    use_file_open: bool    # true => runtime file_open with a status check
    lfsr_seed: text        # "" => no garbage-fill block
    garbage_doc: [text]
    shifts: [text]         # xorshift steps, e.g. "shift_left(lfsr, 13)"
    post_load: [text]      # emitted after the read loop (rv64 .bss zeroing)

# AXI-Lite counter read-back entry in the checker's final report.
struct VgTbReportRead:
    addr: text
    label: text

# Everything about a member that is not derivable from XlenConfig alone.
struct VgK26Geometry:
    tb_name: text
    soc_name: text
    ram_words: i64
    ram_words_trail: text
    ram_words_doc: [text]
    rdisk_words: i64
    rdisk_words_trail: text
    clk_freq: i64
    clk_note: text
    ddr_model_note: text   # " (64-bit)" on rv64
    axi_group_note: text   # ", 64-bit data" on rv64
    ram_mem_file: text
    rdisk_mem_file: text

fn k26_geometry(cfg: XlenConfig) -> VgK26Geometry:
    if cfg.is_rv32():
        VgK26Geometry(
            tb_name: "tb_rv32_k26_ddr_boot",
            soc_name: "soc_top_rv32_k26_ddr",
            ram_words: 4194304,
            ram_words_trail: "   -- 16 MiB",
            ram_words_doc: no_lines(),
            rdisk_words: 262144,
            rdisk_words_trail: "    -- 1 MiB",
            clk_freq: 100000000,
            clk_note: "",
            ddr_model_note: "",
            axi_group_note: "",
            ram_mem_file: "rv32_flat.mem",
            rdisk_mem_file: "rv32_ramdisk.mem")
    else:
        VgK26Geometry(
            tb_name: "tb_rv64_k26_ddr_boot",
            soc_name: "soc_top_rv64_k26_ddr",
            ram_words: 10485760,
            ram_words_trail: "",
            ram_words_doc: k26_rv64_ram_words_doc(),
            rdisk_words: 131072,
            rdisk_words_trail: "    -- 1 MiB",
            clk_freq: 50000000,
            clk_note: "  -- 50 MHz, matching G_CLK_FREQ",
            ddr_model_note: " (64-bit)",
            axi_group_note: ", 64-bit data",
            ram_mem_file: "rv64_flat.mem",
            rdisk_mem_file: "rv64_ramdisk.mem")

# ---------------------------------------------------------------------------
# Structural emitters
# ---------------------------------------------------------------------------

fn k26_slv(width: i64) -> text:
    "std_logic_vector(" + (width - 1).to_text() + " downto 0)"

# Testbench entity: generics only, no port clause.
fn emit_tb_entity(name: text, gens: [VgTbGeneric]) -> [text]:
    var l: [text] = []
    l = l.push("entity " + name + " is")
    l = l.push("  generic (")
    var i = 0
    while i < gens.len():
        val g = gens[i]
        l = vg_append(l, g.pre_comments)
        var sep = ""
        if i < gens.len() - 1:
            sep = ";"
        l = l.push("    " + vg_pad(g.name, g.name_w) + ": " + g.ty + " := " + g.default_val + sep)
        i = i + 1
    l = l.push("  );")
    l = l.push("end entity " + name + ";")
    l

fn emit_tb_constants(consts: [VgTbConst]) -> [text]:
    var w = 0
    var i = 0
    while i < consts.len():
        if consts[i].name.len() > w:
            w = consts[i].name.len()
        i = i + 1
    var l: [text] = []
    i = 0
    while i < consts.len():
        val c = consts[i]
        l = vg_append(l, c.pre_comments)
        l = l.push("  constant " + vg_pad(c.name, w) + ": " + c.ty + " := " + c.value + ";" + c.trail)
        i = i + 1
    l

fn emit_tb_signals(sigs: [VgTbSignal]) -> [text]:
    var l: [text] = []
    var i = 0
    while i < sigs.len():
        val s = sigs[i]
        var init_part = ""
        if s.init_val != "":
            init_part = " := " + s.init_val
        l = l.push("  signal " + vg_pad(s.name, s.name_w) + ": " + s.ty + init_part + ";")
        i = i + 1
    l

fn emit_mem_array_type(type_name: text, bound_const: text, width: i64) -> text:
    "  type " + type_name + " is array(0 to " + bound_const + " - 1) of " + k26_slv(width) + ";"

# init_ram / init_rdisk. Both walk a hex .mem file into a word array; init_ram
# additionally owns the optional power-up garbage fill and (rv64) the
# board-step-5b .bss zeroing.
fn emit_tb_mem_init(d: VgTbMemInit, prefix: text) -> [text]:
    var l: [text] = []
    l = l.push("  impure function " + d.fn_name + " return " + d.ret_ty + " is")
    if d.use_file_open:
        l = l.push("    file f : text;")
        l = l.push("    variable fstatus : file_open_status;")
    else:
        l = l.push("    file f : text open read_mode is \"" + prefix + d.file_name + "\";")
    l = l.push("    variable line_v : line;")
    l = l.push("    variable word_v : " + k26_slv(d.width) + ";")
    l = l.push("    variable mem_v : " + d.ret_ty + " := (others => " + d.fill_expr + ");")
    l = l.push("    variable idx : natural := 0;")
    if d.lfsr_seed != "":
        l = l.push("    variable lfsr : unsigned(" + (d.width - 1).to_text() + " downto 0) := " + d.lfsr_seed + ";")
    l = l.push("  begin")
    if d.use_file_open:
        l = l.push("    file_open(fstatus, f, \"" + prefix + d.file_name + "\", read_mode);")
        l = l.push("    if fstatus /= open_ok then return mem_v; end if;")
    if d.lfsr_seed != "":
        l = l.push("    if G_GARBAGE_FILL then")
        l = vg_append(l, d.garbage_doc)
        l = l.push("      for i in 0 to " + d.bound_const + " - 1 loop")
        var s = 0
        while s < d.shifts.len():
            l = l.push("        lfsr := lfsr xor " + d.shifts[s] + ";")
            s = s + 1
        l = l.push("        mem_v(i) := std_logic_vector(lfsr);")
        l = l.push("      end loop;")
        l = l.push("    end if;")
    l = l.push("    while not endfile(f) loop")
    l = l.push("      readline(f, line_v);")
    l = l.push("      hread(line_v, word_v);")
    l = l.push("      if idx < " + d.bound_const + " then mem_v(idx) := word_v; end if;")
    l = l.push("      idx := idx + 1;")
    l = l.push("    end loop;")
    l = vg_append(l, d.post_load)
    if d.use_file_open:
        l = l.push("    file_close(f);")
    l = l.push("    return mem_v;")
    l = l.push("  end function;")
    l

# `if not G_SKIP_BSS_ZERO then <zero BSS_WORDS words at BSS_W0> end if;`
fn emit_bss_zero_block(first_const: text, count_const: text) -> [text]:
    var l: [text] = []
    l = vg_append(l, k26_rv64_bss_zero_doc())
    l = l.push("    if not G_SKIP_BSS_ZERO then")
    l = l.push("      for i in " + first_const + " to " + first_const + " + " + count_const + " - 1 loop")
    l = l.push("        mem_v(i) := (others => '0');")
    l = l.push("      end loop;")
    l = l.push("    end if;")
    l

fn emit_dut_instance(geo: VgK26Geometry, conns: [VgConnGroup]) -> [text]:
    var l: [text] = []
    l = l.push("  dut : entity work." + geo.soc_name)
    l = l.push("    generic map (G_CLK_FREQ => " + geo.clk_freq.to_text() + ", G_BAUD_RATE => 115200,")
    l = l.push("                 G_CORE_BASE => x\"80000000\", G_DDR_BASE => DDR_BASE)")
    l = l.push("    port map (")
    var i = 0
    while i < conns.len():
        var term = ");"
        if i < conns.len() - 1:
            term = ","
        l = l.push("      " + conns[i].conns.join(", ") + term)
        i = i + 1
    l

# One DDR-slave bank in the write path: byte-lane merge of wdata under wstrb.
fn emit_bank_write(offset_expr: text, bound_const: text, arr: text, bpw: i64) -> [text]:
    var l: [text] = []
    l = l.push("                widx := to_integer((" + offset_expr + ") / " + bpw.to_text() + ");")
    l = l.push("                if widx < " + bound_const + " then")
    l = l.push("                  old_w := " + arr + "(widx);")
    l = l.push("                  for b in 0 to " + (bpw - 1).to_text() + " loop")
    l = l.push("                    if wstrb(b) = '1' then")
    l = l.push("                      old_w(8*b+7 downto 8*b) := wdata(8*b+7 downto 8*b);")
    l = l.push("                    end if;")
    l = l.push("                  end loop;")
    l = l.push("                  " + arr + "(widx) := old_w;")
    l = l.push("                end if;")
    l

# One DDR-slave bank in the read path.
fn emit_bank_read(offset_expr: text, bound_const: text, arr: text, bpw: i64) -> [text]:
    var l: [text] = []
    l = l.push("                widx := to_integer((" + offset_expr + ") / " + bpw.to_text() + ");")
    l = l.push("                if widx < " + bound_const + " then rdata <= " + arr + "(widx);")
    l = l.push("                else rdata <= (others => '0'); end if;")
    l

# rdisk-vs-ram selection wrapper shared by both bank paths.
fn emit_bank_select(rdisk_body: [text], ram_body: [text]) -> [text]:
    var l: [text] = []
    l = l.push("              if is_rdisk then")
    l = vg_append(l, rdisk_body)
    l = l.push("              else")
    l = vg_append(l, ram_body)
    l = l.push("              end if;")
    l

fn emit_report_reads(entries: [VgTbReportRead]) -> [text]:
    var l: [text] = []
    var i = 0
    while i < entries.len():
        val e = entries[i]
        l = l.push("    lite_read(x\"" + e.addr + "\", rd);")
        l = l.push("    write(txt, string'(\"" + e.label + "=0x\")); hwrite(txt, rd); writeline(output, txt);")
        i = i + 1
    l

# ---------------------------------------------------------------------------
# Descriptor tables
# ---------------------------------------------------------------------------

fn k26_generics(cfg: XlenConfig) -> [VgTbGeneric]:
    var g: [VgTbGeneric] = []
    if cfg.is_rv32():
        g = g.push(VgTbGeneric(pre_comments: k26_rv32_garbage_generic_doc(),
                               name: "G_GARBAGE_FILL", name_w: 15,
                               ty: "boolean", default_val: "false"))
        g = g.push(VgTbGeneric(pre_comments: no_lines(), name: "G_MARKER",
                               name_w: 15, ty: "string", default_val: "\"TEST PASSED\""))
        g = g.push(VgTbGeneric(pre_comments: no_lines(), name: "G_TRACE_BASE",
                               name_w: 15, ty: "natural", default_val: "0"))
        g = g.push(VgTbGeneric(pre_comments: no_lines(), name: "G_TRACE_BYTES",
                               name_w: 15, ty: "natural", default_val: "0"))
    else:
        g = g.push(VgTbGeneric(pre_comments: k26_rv64_garbage_generic_doc(),
                               name: "G_GARBAGE_FILL", name_w: 15,
                               ty: "boolean", default_val: "false"))
        g = g.push(VgTbGeneric(pre_comments: k26_rv64_skip_bss_generic_doc(),
                               name: "G_SKIP_BSS_ZERO", name_w: 16,
                               ty: "boolean", default_val: "false"))
    g

fn k26_constants(cfg: XlenConfig, geo: VgK26Geometry) -> [VgTbConst]:
    var c: [VgTbConst] = []
    c = c.push(VgTbConst(pre_comments: no_lines(), name: "DDR_BASE",
                         ty: "unsigned(31 downto 0)", value: "x\"10000000\"", trail: ""))
    c = c.push(VgTbConst(pre_comments: no_lines(), name: "RDISK_OFF",
                         ty: "unsigned(31 downto 0)", value: "x\"08000000\"", trail: ""))
    c = c.push(VgTbConst(pre_comments: geo.ram_words_doc, name: "RAM_WORDS",
                         ty: "natural", value: geo.ram_words.to_text(),
                         trail: geo.ram_words_trail))
    c = c.push(VgTbConst(pre_comments: no_lines(), name: "RDISK_WORDS",
                         ty: "natural", value: geo.rdisk_words.to_text(),
                         trail: geo.rdisk_words_trail))
    if cfg.is_rv64():
        # .bss span is expressed in XLEN words: byte offsets / bytes_per_reg.
        c = c.push(VgTbConst(pre_comments: k26_rv64_bss_const_doc(), name: "BSS_W0",
                             ty: "natural",
                             value: "16#205000# / " + cfg.bytes_per_reg.to_text(), trail: ""))
        c = c.push(VgTbConst(pre_comments: no_lines(), name: "BSS_WORDS",
                             ty: "natural",
                             value: "16#01B000# / " + cfg.bytes_per_reg.to_text(), trail: ""))
    c

fn k26_top_signals(cfg: XlenConfig) -> [VgTbSignal]:
    var s: [VgTbSignal] = []
    s = s.push(VgTbSignal(name: "clk", name_w: 6, ty: "std_logic", init_val: "'0'"))
    s = s.push(VgTbSignal(name: "rst_n", name_w: 6, ty: "std_logic", init_val: "'0'"))
    s = s.push(VgTbSignal(name: "uart_tx", name_w: 8, ty: "std_logic", init_val: ""))
    s = s.push(VgTbSignal(name: "done", name_w: 5, ty: "boolean", init_val: "false"))
    if cfg.is_rv32():
        s = s.push(VgTbSignal(name: "trace_reads", name_w: 12, ty: "natural", init_val: "0"))
        s = s.push(VgTbSignal(name: "trace_writes", name_w: 12, ty: "natural", init_val: "0"))
    s

# Full AXI4 channel set between the core master and the DDR model. Data/strobe
# widths follow XLEN; everything else is XLEN-invariant.
fn k26_axi_signals(cfg: XlenConfig) -> [VgTbSignal]:
    val dw = k26_slv(cfg.xlen)
    val sw = k26_slv(cfg.bytes_per_reg)
    var s: [VgTbSignal] = []
    s = s.push(VgTbSignal(name: "awaddr", name_w: 8, ty: k26_slv(32), init_val: ""))
    s = s.push(VgTbSignal(name: "awlen", name_w: 8, ty: k26_slv(8), init_val: ""))
    s = s.push(VgTbSignal(name: "awsize", name_w: 8, ty: k26_slv(3), init_val: ""))
    s = s.push(VgTbSignal(name: "awburst", name_w: 8, ty: k26_slv(2), init_val: ""))
    s = s.push(VgTbSignal(name: "awcache", name_w: 8, ty: k26_slv(4), init_val: ""))
    s = s.push(VgTbSignal(name: "awprot", name_w: 8, ty: k26_slv(3), init_val: ""))
    s = s.push(VgTbSignal(name: "awvalid", name_w: 8, ty: "std_logic", init_val: ""))
    s = s.push(VgTbSignal(name: "awready", name_w: 8, ty: "std_logic", init_val: "'0'"))
    s = s.push(VgTbSignal(name: "wdata", name_w: 8, ty: dw, init_val: ""))
    s = s.push(VgTbSignal(name: "wstrb", name_w: 8, ty: sw, init_val: ""))
    s = s.push(VgTbSignal(name: "wlast", name_w: 8, ty: "std_logic", init_val: ""))
    s = s.push(VgTbSignal(name: "wvalid", name_w: 8, ty: "std_logic", init_val: ""))
    s = s.push(VgTbSignal(name: "wready", name_w: 8, ty: "std_logic", init_val: "'0'"))
    s = s.push(VgTbSignal(name: "bresp", name_w: 8, ty: k26_slv(2), init_val: "\"00\""))
    s = s.push(VgTbSignal(name: "bvalid", name_w: 8, ty: "std_logic", init_val: "'0'"))
    s = s.push(VgTbSignal(name: "bready", name_w: 8, ty: "std_logic", init_val: ""))
    s = s.push(VgTbSignal(name: "araddr", name_w: 8, ty: k26_slv(32), init_val: ""))
    s = s.push(VgTbSignal(name: "arlen", name_w: 8, ty: k26_slv(8), init_val: ""))
    s = s.push(VgTbSignal(name: "arsize", name_w: 8, ty: k26_slv(3), init_val: ""))
    s = s.push(VgTbSignal(name: "arburst", name_w: 8, ty: k26_slv(2), init_val: ""))
    s = s.push(VgTbSignal(name: "arcache", name_w: 8, ty: k26_slv(4), init_val: ""))
    s = s.push(VgTbSignal(name: "arprot", name_w: 8, ty: k26_slv(3), init_val: ""))
    s = s.push(VgTbSignal(name: "arvalid", name_w: 8, ty: "std_logic", init_val: ""))
    s = s.push(VgTbSignal(name: "arready", name_w: 8, ty: "std_logic", init_val: "'0'"))
    s = s.push(VgTbSignal(name: "rdata", name_w: 8, ty: dw, init_val: "(others => '0')"))
    s = s.push(VgTbSignal(name: "rresp", name_w: 8, ty: k26_slv(2), init_val: "\"00\""))
    s = s.push(VgTbSignal(name: "rlast", name_w: 8, ty: "std_logic", init_val: "'0'"))
    s = s.push(VgTbSignal(name: "rvalid", name_w: 8, ty: "std_logic", init_val: "'0'"))
    s = s.push(VgTbSignal(name: "rready", name_w: 8, ty: "std_logic", init_val: ""))
    s

# AXI4-Lite master side of the control/observation slave — always 32-bit.
fn k26_lite_signals() -> [VgTbSignal]:
    var s: [VgTbSignal] = []
    s = s.push(VgTbSignal(name: "l_awaddr", name_w: 10, ty: k26_slv(16), init_val: "(others => '0')"))
    s = s.push(VgTbSignal(name: "l_awvalid", name_w: 10, ty: "std_logic", init_val: "'0'"))
    s = s.push(VgTbSignal(name: "l_awready", name_w: 10, ty: "std_logic", init_val: ""))
    s = s.push(VgTbSignal(name: "l_wdata", name_w: 10, ty: k26_slv(32), init_val: "(others => '0')"))
    s = s.push(VgTbSignal(name: "l_wvalid", name_w: 10, ty: "std_logic", init_val: "'0'"))
    s = s.push(VgTbSignal(name: "l_wready", name_w: 10, ty: "std_logic", init_val: ""))
    s = s.push(VgTbSignal(name: "l_bvalid", name_w: 10, ty: "std_logic", init_val: ""))
    s = s.push(VgTbSignal(name: "l_bready", name_w: 10, ty: "std_logic", init_val: "'0'"))
    s = s.push(VgTbSignal(name: "l_araddr", name_w: 10, ty: k26_slv(16), init_val: "(others => '0')"))
    s = s.push(VgTbSignal(name: "l_arvalid", name_w: 10, ty: "std_logic", init_val: "'0'"))
    s = s.push(VgTbSignal(name: "l_arready", name_w: 10, ty: "std_logic", init_val: ""))
    s = s.push(VgTbSignal(name: "l_rdata", name_w: 10, ty: k26_slv(32), init_val: ""))
    s = s.push(VgTbSignal(name: "l_rvalid", name_w: 10, ty: "std_logic", init_val: ""))
    s = s.push(VgTbSignal(name: "l_rready", name_w: 10, ty: "std_logic", init_val: "'0'"))
    s = s.push(VgTbSignal(name: "l_bresp, l_rresp", name_w: 17, ty: k26_slv(2), init_val: ""))
    s

# DUT port map. The NVMe endpoint exists only on the RV32 K26 top.
fn k26_conn_groups(cfg: XlenConfig) -> [VgConnGroup]:
    var g: [VgConnGroup] = []
    var c: [text] = []
    c = c.push("clk => clk")
    c = c.push("rst_n => rst_n")
    c = c.push("uart_tx => uart_tx")
    g = g.push(VgConnGroup(conns: c))
    g = k26_push_pair(g, "m_axi_hp_awaddr => awaddr", "m_axi_hp_awlen => awlen")
    g = k26_push_pair(g, "m_axi_hp_awsize => awsize", "m_axi_hp_awburst => awburst")
    g = k26_push_pair(g, "m_axi_hp_awcache => awcache", "m_axi_hp_awprot => awprot")
    g = k26_push_pair(g, "m_axi_hp_awvalid => awvalid", "m_axi_hp_awready => awready")
    g = k26_push_pair(g, "m_axi_hp_wdata => wdata", "m_axi_hp_wstrb => wstrb")
    g = k26_push_pair(g, "m_axi_hp_wlast => wlast", "m_axi_hp_wvalid => wvalid")
    g = k26_push_one(g, "m_axi_hp_wready => wready")
    g = k26_push_pair(g, "m_axi_hp_bresp => bresp", "m_axi_hp_bvalid => bvalid")
    g = k26_push_one(g, "m_axi_hp_bready => bready")
    g = k26_push_pair(g, "m_axi_hp_araddr => araddr", "m_axi_hp_arlen => arlen")
    g = k26_push_pair(g, "m_axi_hp_arsize => arsize", "m_axi_hp_arburst => arburst")
    g = k26_push_pair(g, "m_axi_hp_arcache => arcache", "m_axi_hp_arprot => arprot")
    g = k26_push_pair(g, "m_axi_hp_arvalid => arvalid", "m_axi_hp_arready => arready")
    g = k26_push_pair(g, "m_axi_hp_rdata => rdata", "m_axi_hp_rresp => rresp")
    g = k26_push_pair(g, "m_axi_hp_rlast => rlast", "m_axi_hp_rvalid => rvalid")
    g = k26_push_one(g, "m_axi_hp_rready => rready")
    if cfg.is_rv32():
        g = k26_push_pair(g, "m_axi_nvme_dma_awaddr => open", "m_axi_nvme_dma_awlen => open")
        g = k26_push_pair(g, "m_axi_nvme_dma_awsize => open", "m_axi_nvme_dma_awburst => open")
        g = k26_push_pair(g, "m_axi_nvme_dma_awcache => open", "m_axi_nvme_dma_awprot => open")
        g = k26_push_pair(g, "m_axi_nvme_dma_awvalid => open", "m_axi_nvme_dma_awready => '0'")
        g = k26_push_pair(g, "m_axi_nvme_dma_wdata => open", "m_axi_nvme_dma_wstrb => open")
        g = k26_push_pair(g, "m_axi_nvme_dma_wlast => open", "m_axi_nvme_dma_wvalid => open")
        g = k26_push_pair(g, "m_axi_nvme_dma_wready => '0'", "m_axi_nvme_dma_bresp => \"00\"")
        g = k26_push_pair(g, "m_axi_nvme_dma_bvalid => '0'", "m_axi_nvme_dma_bready => open")
        g = k26_push_pair(g, "m_axi_nvme_dma_araddr => open", "m_axi_nvme_dma_arlen => open")
        g = k26_push_pair(g, "m_axi_nvme_dma_arsize => open", "m_axi_nvme_dma_arburst => open")
        g = k26_push_pair(g, "m_axi_nvme_dma_arcache => open", "m_axi_nvme_dma_arprot => open")
        g = k26_push_pair(g, "m_axi_nvme_dma_arvalid => open", "m_axi_nvme_dma_arready => '0'")
        g = k26_push_pair(g, "m_axi_nvme_dma_rdata => (others => '0')", "m_axi_nvme_dma_rresp => \"00\"")
        g = k26_push_pair(g, "m_axi_nvme_dma_rlast => '0'", "m_axi_nvme_dma_rvalid => '0'")
        g = k26_push_pair(g, "m_axi_nvme_dma_rready => open", "nvme_irq => open")
        g = k26_push_pair(g, "s_axi_nvme_awaddr => (others => '0')", "s_axi_nvme_awprot => \"000\"")
        g = k26_push_pair(g, "s_axi_nvme_awvalid => '0'", "s_axi_nvme_awready => open")
        g = k26_push_pair(g, "s_axi_nvme_wdata => (others => '0')", "s_axi_nvme_wstrb => (others => '0')")
        g = k26_push_pair(g, "s_axi_nvme_wvalid => '0'", "s_axi_nvme_wready => open")
        g = k26_push_pair(g, "s_axi_nvme_bresp => open", "s_axi_nvme_bvalid => open")
        g = k26_push_pair(g, "s_axi_nvme_bready => '0'", "s_axi_nvme_araddr => (others => '0')")
        g = k26_push_pair(g, "s_axi_nvme_arprot => \"000\"", "s_axi_nvme_arvalid => '0'")
        g = k26_push_pair(g, "s_axi_nvme_arready => open", "s_axi_nvme_rdata => open")
        g = k26_push_pair(g, "s_axi_nvme_rresp => open", "s_axi_nvme_rvalid => open")
        g = k26_push_one(g, "s_axi_nvme_rready => '0'")
    g = k26_push_pair(g, "s_axi_ctrl_awaddr => l_awaddr", "s_axi_ctrl_awprot => \"000\"")
    g = k26_push_pair(g, "s_axi_ctrl_awvalid => l_awvalid", "s_axi_ctrl_awready => l_awready")
    g = k26_push_pair(g, "s_axi_ctrl_wdata => l_wdata", "s_axi_ctrl_wstrb => \"1111\"")
    g = k26_push_pair(g, "s_axi_ctrl_wvalid => l_wvalid", "s_axi_ctrl_wready => l_wready")
    g = k26_push_pair(g, "s_axi_ctrl_bresp => l_bresp", "s_axi_ctrl_bvalid => l_bvalid")
    g = k26_push_one(g, "s_axi_ctrl_bready => l_bready")
    g = k26_push_pair(g, "s_axi_ctrl_araddr => l_araddr", "s_axi_ctrl_arprot => \"000\"")
    g = k26_push_pair(g, "s_axi_ctrl_arvalid => l_arvalid", "s_axi_ctrl_arready => l_arready")
    g = k26_push_pair(g, "s_axi_ctrl_rdata => l_rdata", "s_axi_ctrl_rresp => l_rresp")
    g = k26_push_pair(g, "s_axi_ctrl_rvalid => l_rvalid", "s_axi_ctrl_rready => l_rready")
    g

fn k26_push_one(g: [VgConnGroup], a: text) -> [VgConnGroup]:
    var c: [text] = []
    c = c.push(a)
    g.push(VgConnGroup(conns: c))

fn k26_push_pair(g: [VgConnGroup], a: text, b: text) -> [VgConnGroup]:
    var c: [text] = []
    c = c.push(a)
    c = c.push(b)
    g.push(VgConnGroup(conns: c))

fn k26_ram_init(cfg: XlenConfig, geo: VgK26Geometry) -> VgTbMemInit:
    var shifts: [text] = []
    shifts = shifts.push("shift_left(lfsr, 13)")
    var post: [text] = []
    var seed = "x\"DEADBEEF\""
    var fill = "x\"00000000\""
    var doc = k26_rv32_garbage_fill_doc()
    if cfg.is_rv32():
        shifts = shifts.push("shift_right(lfsr, 17)")
        shifts = shifts.push("shift_left(lfsr, 5)")
    else:
        shifts = shifts.push("shift_right(lfsr, 7)")
        shifts = shifts.push("shift_left(lfsr, 17)")
        seed = "x\"DEADBEEFCAFEF00D\""
        fill = "(others => '0')"
        doc = k26_rv64_garbage_fill_doc()
        post = emit_bss_zero_block("BSS_W0", "BSS_WORDS")
    VgTbMemInit(fn_name: "init_ram", ret_ty: "ram_t", bound_const: "RAM_WORDS",
                width: cfg.xlen, fill_expr: fill, file_name: geo.ram_mem_file,
                use_file_open: false, lfsr_seed: seed, garbage_doc: doc,
                shifts: shifts, post_load: post)

fn k26_rdisk_init(cfg: XlenConfig, geo: VgK26Geometry) -> VgTbMemInit:
    var fill = "x\"00000000\""
    if cfg.is_rv64():
        fill = "(others => '0')"
    VgTbMemInit(fn_name: "init_rdisk", ret_ty: "rdisk_t", bound_const: "RDISK_WORDS",
                width: cfg.xlen, fill_expr: fill, file_name: geo.rdisk_mem_file,
                use_file_open: true, lfsr_seed: "", garbage_doc: no_lines(),
                shifts: no_lines(), post_load: no_lines())

fn k26_report_reads() -> [VgTbReportRead]:
    var r: [VgTbReportRead] = []
    r = r.push(VgTbReportRead(addr: "0008", label: "K26_FINAL_PC"))
    r = r.push(VgTbReportRead(addr: "001C", label: "K26_AXI_READS"))
    r = r.push(VgTbReportRead(addr: "0020", label: "K26_AXI_WRITES"))
    r

# ---------------------------------------------------------------------------
# Composite sections
# ---------------------------------------------------------------------------

fn k26_file_header(cfg: XlenConfig) -> [text]:
    var l: [text] = []
    if cfg.is_rv32():
        l = vg_append(l, k26_rv32_header_lead())
        l = vg_append(l, k26_sh_header_tail())
    else:
        l = vg_append(l, k26_rv64_header_lead())
        l = vg_append(l, k26_sh_header_tail())
        l = vg_append(l, k26_rv64_header_bss())
    l

fn k26_library_header() -> [text]:
    var l = emit_library_header()
    l = l.push("use std.env.all;")
    l

# Half-period in ns for a 50% duty clock at the DUT's G_CLK_FREQ.
fn k26_clk_driver(geo: VgK26Geometry) -> text:
    val half_ns = 1000000000 / (2 * geo.clk_freq)
    "  clk <= not clk after " + half_ns.to_text() + " ns when not done else '0';" + geo.clk_note

fn k26_ddr_slave_decls(cfg: XlenConfig, geo: VgK26Geometry) -> [text]:
    var l: [text] = []
    l = l.push("  -- ---------------------------------------------------------------------")
    l = l.push("  -- AXI4 DDR slave model" + geo.ddr_model_note + " with varying wait-states.")
    l = l.push("  -- ---------------------------------------------------------------------")
    l = l.push("  ddr_slave : process(clk)")
    l = l.push("    variable wait_n   : natural := 0;")
    l = l.push("    variable phase    : natural := 0;   -- 0 idle, 1 read wait, 2 write wait")
    l = l.push("    variable addr_v   : unsigned(31 downto 0);")
    l = l.push("    variable widx     : natural;")
    l = l.push("    variable is_rdisk : boolean;")
    l = l.push("    variable jitter   : natural := 1;")
    l = l.push("    variable old_w    : " + k26_slv(cfg.xlen) + ";")
    l = l.push("    variable saved_addr : unsigned(31 downto 0);")
    l = l.push("    variable ram   : ram_t := init_ram;")
    l = l.push("    variable rdisk : rdisk_t := init_rdisk;")
    l

fn k26_ddr_slave_process(cfg: XlenConfig, geo: VgK26Geometry) -> [text]:
    val bpw = cfg.bytes_per_reg
    val rdisk_off = "addr_v - (DDR_BASE + RDISK_OFF)"
    val ram_off = "addr_v - DDR_BASE"
    var l: [text] = []
    l = vg_append(l, k26_ddr_slave_decls(cfg, geo))
    l = vg_append(l, k26_sh_ddr_slave_reset(cfg.is_rv32()))
    l = vg_append(l, emit_bank_select(
        emit_bank_write(rdisk_off, "RDISK_WORDS", "rdisk", bpw),
        emit_bank_write(ram_off, "RAM_WORDS", "ram", bpw)))
    l = vg_append(l, k26_sh_ddr_slave_write_finish())
    l = vg_append(l, emit_bank_select(
        emit_bank_read(rdisk_off, "RDISK_WORDS", "rdisk", bpw),
        emit_bank_read(ram_off, "RAM_WORDS", "ram", bpw)))
    l = vg_append(l, k26_sh_ddr_slave_tail())
    l

fn k26_ctrl_process(cfg: XlenConfig) -> [text]:
    var l: [text] = []
    l = vg_append(l, k26_sh_ctrl_decls(cfg.is_rv32()))
    l = vg_append(l, k26_sh_lite_read_proc())
    l = vg_append(l, k26_sh_lite_write_head())
    if cfg.is_rv32():
        l = vg_append(l, k26_rv32_bready_doc())
    else:
        l = vg_append(l, k26_rv64_bready_doc())
    l = vg_append(l, k26_sh_lite_write_tail())
    l = vg_append(l, k26_sh_ctrl_reset_release())
    if cfg.is_rv64():
        l = vg_append(l, k26_rv64_magic_reuse_doc())
    l = vg_append(l, k26_sh_ctrl_bringup())
    l = vg_append(l, k26_sh_ctrl_poll())
    l = vg_append(l, k26_sh_ctrl_verdict(cfg.is_rv32()))
    l = vg_append(l, emit_report_reads(k26_report_reads()))
    l = vg_append(l, k26_sh_ctrl_finish(cfg.is_rv32()))
    l

# ---------------------------------------------------------------------------
# Whole-file assembly
# ---------------------------------------------------------------------------

# Public entry point: emit one member of the KV260 DDR boot-testbench pair.
# `mem_prefix` is prepended to the .mem file names in init_ram / init_rdisk
# ("" reproduces the golden's relative form).
fn generate_tb_k26_ddr_boot(cfg: XlenConfig, mem_prefix: text) -> text:
    val geo = k26_geometry(cfg)
    var parts: [text] = []
    parts = parts.push(k26_join(k26_file_header(cfg)))
    parts = parts.push(k26_join(k26_library_header()))
    parts = parts.push("")
    parts = parts.push(k26_join(emit_tb_entity(geo.tb_name, k26_generics(cfg))))
    parts = parts.push("")
    parts = parts.push("architecture sim of " + geo.tb_name + " is")
    parts = parts.push(k26_join(emit_tb_constants(k26_constants(cfg, geo))))
    parts = parts.push("")
    parts = parts.push(k26_join(emit_tb_signals(k26_top_signals(cfg))))
    parts = parts.push("")
    parts = parts.push("  -- AXI4 (core master -> DDR model)" + geo.axi_group_note)
    parts = parts.push(k26_join(emit_tb_signals(k26_axi_signals(cfg))))
    parts = parts.push("")
    parts = parts.push("  -- AXI4-Lite (testbench master -> control/observation slave)")
    parts = parts.push(k26_join(emit_tb_signals(k26_lite_signals())))
    parts = parts.push("")
    parts = parts.push(emit_mem_array_type("ram_t", "RAM_WORDS", cfg.xlen))
    parts = parts.push(emit_mem_array_type("rdisk_t", "RDISK_WORDS", cfg.xlen))
    parts = parts.push("")
    parts = parts.push(k26_join(emit_tb_mem_init(k26_ram_init(cfg, geo), mem_prefix)))
    parts = parts.push("")
    parts = parts.push(k26_join(emit_tb_mem_init(k26_rdisk_init(cfg, geo), mem_prefix)))
    parts = parts.push("")
    if cfg.is_rv32():
        parts = parts.push(k26_join(k26_rv32_process_var_doc()))
    else:
        parts = parts.push(k26_join(k26_rv64_process_var_doc()))
    parts = parts.push("begin")
    parts = parts.push(k26_clk_driver(geo))
    parts = parts.push("")
    parts = parts.push(k26_join(emit_dut_instance(geo, k26_conn_groups(cfg))))
    parts = parts.push("")
    parts = parts.push(k26_join(k26_ddr_slave_process(cfg, geo)))
    parts = parts.push("")
    parts = parts.push(k26_join(k26_ctrl_process(cfg)))
    parts.join("\n") + "\n"

fn generate_tb_rv32_k26_ddr_boot(mem_prefix: text) -> text:
    generate_tb_k26_ddr_boot(XlenConfig.rv32(), mem_prefix)

fn generate_tb_rv64_k26_ddr_boot(mem_prefix: text) -> text:
    generate_tb_k26_ddr_boot(XlenConfig.rv64(), mem_prefix)
