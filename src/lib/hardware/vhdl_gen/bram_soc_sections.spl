# Named literal sections for rv32_bram_soc — irreducible paragraphs only: the
# file header rationale, the power-of-2 bank-split helper functions, the
# BRAM-init NOTE, the chr8 helper, and the memory/UART/observation process
# glue between the structurally generated tables.
#
# Everything table-shaped (entity, bank constants/types/init functions/signals/
# attributes/processes, address decode chains, register and observation-command
# maps, marker matchers, port maps) is generated in bram_soc_gen.spl.

fn bram_soc_head() -> [text]:
    var l: [text] = []
    l = l.push("-- rv32_bram_soc: SYNTHESIZABLE BRAM-only SoC for the TINY rv32 SimpleOS config.")
    l = l.push("--")
    l = l.push("-- Path A of the KV260 silicon campaign: everything lives in PL fabric — NO DDR,")
    l = l.push("-- NO block design, NO FSBL, NO PS dependency. Pairs the proven synthesizable")
    l = l.push("-- rv32_exec_core_axi (stalled external-memory FSM, same decode/ALU/CSR/M logic")
    l = l.push("-- that difftested clean vs QEMU) with:")
    l = l.push("--")
    l = l.push("--   * main RAM  at 0x80000000 : RAM_WORDS   x32 BRAM, byte-write enables,")
    l = l.push("--                               INIT'd from RAM_INIT_FILE at synthesis time")
    l = l.push("--   * ramdisk   at 0x88000000 : RDISK_WORDS x32 BRAM ROM (read-only FAT32")
    l = l.push("--                               slice), INIT'd from RDISK_INIT_FILE")
    l = l.push("--   * UART capture buffer     : UARTBUF_WORDS x32 BRAM; every byte the kernel")
    l = l.push("--                               stores to the 16550 THR (0x10000000) is packed")
    l = l.push("--                               4-per-word so the whole boot transcript can be")
    l = l.push("--                               read back over JTAG (the KV260 carrier routes")
    l = l.push("--                               the PL UART TX pin to PMOD J2, not to any host")
    l = l.push("--                               tty, so JTAG readout is the observation path).")
    l = l.push("--   * observation port        : synchronous cmd/resp register interface, driven")
    l = l.push("--                               by the BSCANE2 USER4 DR logic in the Vivado top")
    l = l.push("--                               (soc_top_rv32_tiny_bram) or directly by a GHDL")
    l = l.push("--                               testbench (tb_rv32_tiny_bram_soc).")
    l = l.push("--")
    l = l.push("-- The memory slave answers the core's mem_req/mem_rvalid handshake with a")
    l = l.push("-- fixed 3-cycle read pipeline (registered index -> registered BRAM output ->")
    l = l.push("-- registered rdata+rvalid), which the core tolerates by design (it was proven")
    l = l.push("-- against a 1..4-cycle random-latency slave in tb_rv32_simpleos_boot_axi).")
    l = l.push("-- Out-of-range loads return 0 and out-of-range stores are dropped (both still")
    l = l.push("-- ack), matching the behavioral flat core.")
    l = l.push("--")
    l = l.push("-- Observation protocol (one command per obs_cmd_valid pulse):")
    l = l.push("--   obs_cmd(3 downto 0)   = select")
    l = l.push("--     0x0 magic            -> x\"51F0B007\"")
    l = l.push("--     0x1 status           -> pass & fail & running & '0' & version(4) &")
    l = l.push("--                             uart_byte_count(24)")
    l = l.push("--     0x2 debug_pc         -> current core PC")
    l = l.push("--     0x3 uartbuf word     -> uartbuf[obs_cmd(31 downto 16)] (4 transcript")
    l = l.push("--                             bytes, little-endian: byte0 = bits 7..0)")
    l = l.push("--     0x4 debug_ins   0x5 debug_sp   0x6 debug_ra   0x7 cycle counter (live)")
    l = l.push("--     0x8 debug_a0    0x9 mem_rvalid count (bus liveness)")
    l = l.push("--     0xF soft reset       -> when obs_cmd(31 downto 16) = x\"5AFE\": re-run the")
    l = l.push("--                             boot (core reset ~255 cycles, capture cleared)")
    l = l.push("--   obs_resp(31 downto 0) = data, (47 downto 32) = echo of obs_cmd(15 downto 0),")
    l = l.push("--   (63 downto 48) = x\"A55A\" (signature; lets the JTAG host find the bit")
    l = l.push("--   alignment of the response window empirically).")
    l = l.push("-- Response for command N is stable until command N+1 is issued; the JTAG host")
    l = l.push("-- reads it back during the NEXT DR scan (same lag-by-one the proven DMI tunnel")
    l = l.push("-- uses).")
    l

# Power-of-2 bank split rationale + the two elaboration-time helper functions.
fn bram_soc_bank_split_helpers() -> [text]:
    var l: [text] = []
    l = l.push("  -- --------------------------------------------------------------------------")
    l = l.push("  -- Power-of-2 bank split. Vivado pads a non-power-of-2 BRAM depth to the next")
    l = l.push("  -- power of 2 (a 77824-word array elaborated as 131072x32 = 512KB of BRAM),")
    l = l.push("  -- which blows the 144-tile xck26 budget. Splitting each memory into at most")
    l = l.push("  -- three power-of-2 banks makes the mapping exact:")
    l = l.push("  --   51200 words = 32768 + 16384 + 2048   (RAM,   50 BRAM36)")
    l = l.push("  --   77824 words = 65536 + 8192  + 4096   (rdisk, 76 BRAM36)")
    l = l.push("  -- A power-of-2 total (e.g. the GHDL default 131072/262144) degenerates to a")
    l = l.push("  -- single bank. Totals needing more than 3 banks are rejected by an assert.")
    l = l.push("  -- --------------------------------------------------------------------------")
    l = l.push("  function bank_words(total : natural; bank : natural) return natural is")
    l = l.push("    variable remw : natural := total;")
    l = l.push("    variable sz : natural;")
    l = l.push("  begin")
    l = l.push("    for i in 0 to 2 loop")
    l = l.push("      sz := 0;")
    l = l.push("      if remw > 0 then")
    l = l.push("        sz := 1;")
    l = l.push("        while sz * 2 <= remw loop sz := sz * 2; end loop;")
    l = l.push("      end if;")
    l = l.push("      if i = bank then return sz; end if;")
    l = l.push("      remw := remw - sz;")
    l = l.push("    end loop;")
    l = l.push("    return 0;")
    l = l.push("  end function;")
    l = l.push("  function at_least_1(n : natural) return natural is")
    l = l.push("  begin")
    l = l.push("    if n > 0 then return n; end if;")
    l = l.push("    return 1;")
    l = l.push("  end function;")
    l

fn bram_soc_init_note() -> [text]:
    var l: [text] = []
    l = l.push("  -- NOTE: both init files must exist (the GHDL runner and the Vivado build")
    l = l.push("  -- script always generate them). The direct `open read_mode is` form is the")
    l = l.push("  -- UG901-blessed synthesizable BRAM-init pattern. Each bank reads the same")
    l = l.push("  -- file, skipping `skip` leading words and taking `depth` words.")
    l

fn bram_soc_chr8_fn() -> [text]:
    var l: [text] = []
    l = l.push("  function chr8(c : character) return std_logic_vector is")
    l = l.push("  begin")
    l = l.push("    return std_logic_vector(to_unsigned(character'pos(c), 8));")
    l = l.push("  end function;")
    l

fn bram_soc_bank_process_banner() -> [text]:
    var l: [text] = []
    l = l.push("  -- --------------------------------------------------------------------------")
    l = l.push("  -- Memory banks: one process per bank, plain UG901 byte-write-enable /")
    l = l.push("  -- registered-read templates so Vivado infers BRAM exactly.")
    l = l.push("  -- --------------------------------------------------------------------------")
    l

fn bram_soc_slave_banner() -> [text]:
    var l: [text] = []
    l = l.push("  -- --------------------------------------------------------------------------")
    l = l.push("  -- Memory slave FSM: fixed pipeline, one transaction at a time.")
    l = l.push("  -- --------------------------------------------------------------------------")
    l

fn bram_soc_capture_banner() -> [text]:
    var l: [text] = []
    l = l.push("  -- --------------------------------------------------------------------------")
    l = l.push("  -- UART capture + marker matchers.")
    l = l.push("  -- --------------------------------------------------------------------------")
    l

fn bram_soc_obs_banner() -> [text]:
    var l: [text] = []
    l = l.push("  -- --------------------------------------------------------------------------")
    l = l.push("  -- Observation command pipeline: cmd_valid -> (set buffer raddr) -> resp.")
    l = l.push("  -- --------------------------------------------------------------------------")
    l

# Head of the M_IDLE arm: latch the request and compute the RAM-relative
# offset (irreducible address arithmetic).
fn bram_soc_idle_req_head() -> [text]:
    var l: [text] = []
    l = l.push("            if mem_req = '1' then")
    l = l.push("              off := unsigned(mem_addr) - RAM_BASE;")
    l = l.push("              region_q <= R_NONE;")
    l

fn bram_soc_idle_req_tail() -> [text]:
    var l: [text] = []
    l = l.push("              end if;")
    l = l.push("              if mem_we = '1' then")
    l = l.push("                wdata_q <= mem_wdata;")
    l = l.push("                wstrb_q <= mem_wstrb;")
    l = l.push("              end if;")
    l = l.push("              mstate_q <= M_READ;")
    l = l.push("            end if;")
    l

fn bram_soc_resp_tail() -> [text]:
    var l: [text] = []
    l = l.push("            mem_rvalid <= '1';")
    l = l.push("            rvalid_cnt_q <= rvalid_cnt_q + 1;")
    l = l.push("            mstate_q <= M_WAIT;")
    l

fn bram_soc_wait_arm() -> [text]:
    var l: [text] = []
    l = l.push("            if mem_req = '0' then")
    l = l.push("              mstate_q <= M_IDLE;")
    l = l.push("            end if;")
    l

# UART capture process: the head (buffer read port + soft-reset clear) and the
# byte-store paragraph that precedes the generated marker matchers.
fn bram_soc_capture_head() -> [text]:
    var l: [text] = []
    l = l.push("      -- Capture-buffer read port (observation).")
    l = l.push("      ubuf_q <= uartbuf(ubuf_raddr_q);")
    l = l.push("")
    l = l.push("      if rst = '1' or (obs_pend2_q = '1' and obs_cmd_q(3 downto 0) = x\"F\"")
    l = l.push("                       and obs_cmd_q(31 downto 16) = x\"5AFE\") then")
    l = l.push("        uart_count_q <= (others => '0');")
    l = l.push("        pass_idx_q <= 1;")
    l = l.push("        fail_idx_q <= 1;")
    l = l.push("        pass_seen_q <= '0';")
    l = l.push("        fail_seen_q <= '0';")
    l = l.push("      elsif dbg_uart_valid = '1' then")
    l = l.push("        if uart_count_q < to_unsigned(UARTBUF_WORDS * 4, 32) then")
    l = l.push("          lane := to_integer(uart_count_q(1 downto 0));")
    l = l.push("          wi := to_integer(uart_count_q(31 downto 2));")
    l = l.push("          uartbuf(wi)(lane * 8 + 7 downto lane * 8) <= dbg_uart_byte;")
    l = l.push("        end if;")
    l = l.push("        uart_count_q <= uart_count_q + 1;")
    l

# Observation process head: free-running counters, soft-reset countdown, the
# 2-stage pend pipeline and the command latch.
fn bram_soc_obs_head() -> [text]:
    var l: [text] = []
    l = l.push("      cycle_cnt_q <= cycle_cnt_q + 1;")
    l = l.push("      if soft_cnt_q /= 0 then")
    l = l.push("        soft_cnt_q <= soft_cnt_q - 1;")
    l = l.push("      end if;")
    l = l.push("      obs_pend1_q <= '0';")
    l = l.push("      obs_pend2_q <= obs_pend1_q;")
    l = l.push("      if rst = '1' then")
    l = l.push("        obs_pend1_q <= '0';")
    l = l.push("        obs_pend2_q <= '0';")
    l = l.push("        soft_cnt_q <= (others => '0');")
    l = l.push("      elsif obs_cmd_valid = '1' then")
    l = l.push("        obs_cmd_q <= obs_cmd;")
    l = l.push("        obs_pend1_q <= '1';")
    l = l.push("        bidx := to_integer(unsigned(obs_cmd(31 downto 16)));")
    l = l.push("        if bidx < UARTBUF_WORDS then")
    l = l.push("          ubuf_raddr_q <= bidx;")
    l = l.push("        else")
    l = l.push("          ubuf_raddr_q <= 0;")
    l = l.push("        end if;")
    l = l.push("      elsif obs_pend2_q = '1' then")
    l = l.push("        -- ubuf_q now holds uartbuf[ubuf_raddr_q] (two clks after raddr set).")
    l = l.push("        obs_resp_q(63 downto 48) <= x\"A55A\";")
    l = l.push("        obs_resp_q(47 downto 32) <= obs_cmd_q(15 downto 0);")
    l

# The 0x1 status word and the 0xF soft-reset arm bodies.
fn bram_soc_obs_status_body() -> [text]:
    var l: [text] = []
    l = l.push("            pass_seen_q & fail_seen_q & (not core_rst) & '0' & x\"1\"")
    l = l.push("            & std_logic_vector(uart_count_q(23 downto 0));")
    l

fn bram_soc_obs_softreset_body() -> [text]:
    var l: [text] = []
    l = l.push("            obs_resp_q(31 downto 0) <= x\"0000F1F1\";")
    l = l.push("            if obs_cmd_q(31 downto 16) = x\"5AFE\" then")
    l = l.push("              soft_cnt_q <= (others => '1');")
    l = l.push("            end if;")
    l
