# VHDL Generation Module
#
# Pure-Simple structured VHDL generator for the silicon-lane RISC-V exec
# cores (rv32/rv64, plus the flat/axi sibling variants), byte-identical to
# the proven goldens in examples/09_embedded/fpga_riscv/rtl/. One shared
# template source parameterized by XlenConfig; dbg_* taps emitted by an AOP
# debug aspect.

export gen_types, debug_tap_aspect, rv32_sections, rv64_sections, exec_core_gen
export rv32_variant_sections, rv64_variant_sections, exec_core_variant_gen
export tb_product_types, tb_product_sections, tb_product_gen
